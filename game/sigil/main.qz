## SIGIL v0.4 — D.4.5 final polish. Closes the SIGIL D.4.x phase:
## VICTORY / DEFEAT overlays render as centered Dark-Souls-style
## banners (mirroring brogue-tribute's `build_outcome_plane`), input
## locks to SPACE / q on overlay, and SPACE advances through three
## encounters (Goblin → Orc → Boss). Player HP carries over with a
## small heal between fights; mana refills, log clears, hand resets.
## Top-of-hand row displays Deck / Discard counters that tick up as
## cards are played — visual element only, no shuffling sim. A small
## one-tick "(played)" annotation dims the card slot when its card
## fires, then resolves on the next tick. Defeating the boss shows a
## "You complete the dungeon" final overlay; SPACE quits.
##
## Earlier phases preserved: D.4.3 octant runes, D.4.4 dynamic glow
## (selected card's rune + border breathe between base02 and the
## card's glow color via a triangle wave on the 100ms tick pump,
## cycle ≈ 1.6s).

import std/tui/cell as cl
import std/tui/plane as pl
import std/tui/render as rd
import std/tui/blend as bl
import std/tui/theme as th
import std/tui/runtime as tui
import std/tui/octant as oct
import std/terminal
import string
import * from std/vec
import random
import time

# =============================================================================
# Layout constants
# =============================================================================

def W():        Int = 80
def H():        Int = 24
def CARD_W():   Int = 14
def CARD_H():   Int = 7
def NUM_CARDS(): Int = 5
def HAND_OY():  Int = 17
def HAND_OX():  Int = 4
def CARD_GAP(): Int = 1

# Top region (rows 0-15) — mostly the dungeon room.
def TOP_H():    Int = 17

# Dungeon room geometry — centered horizontally in the top region.
def ROOM_W():   Int = 30
def ROOM_H():   Int = 10
def ROOM_OX():  Int = 6      # (W - ROOM_W) / 2 plus a left bias
def ROOM_OY():  Int = 2      # under the player-status row

# Combat log: last N entries kept; render last 3.
def LOG_CAP():     Int = 8
def LOG_RENDER():  Int = 3
def LOG_OY():      Int = 13   # rows 13/14/15

# =============================================================================
# Card data
# =============================================================================

struct Card
  name:        String
  cost:        Int
  damage:      Int
  block:       Int
  heal:        Int
  rune_pixels: Vec<Bool>
  glow_color:  Int
end

# Each rune is a 6×6 row-major Vec<Bool> (36 pixels). Built from a
# 6-character-per-row String literal where '.' = off and any other
# char = on. Lets us write the sigils as readable ASCII art and avoid
# 36-line push chains.
def rune_from_strs(rows: Vec<String>): Vec<Bool>
  var v = vec_new<Bool>()
  var ry = 0
  while ry < 6
    var row = rows[ry]
    var rx = 0
    while rx < 6
      var ch = str_byte_at(row, rx)
      if ch == '.'
        v.push(false)
      else
        v.push(true)
      end
      rx += 1
    end
    ry += 1
  end
  return v
end

# Strike — chevron pointing right. Horizontal arrow with a clear tip.
def rune_strike(): Vec<Bool>
  var rows = vec_new<String>()
  rows.push("...X..")
  rows.push("....X.")
  rows.push("XXXXXX")
  rows.push("XXXXXX")
  rows.push("....X.")
  rows.push("...X..")
  return rune_from_strs(rows)
end

# Defend — shield outline with vertical bar + rounded bottom.
def rune_defend(): Vec<Bool>
  var rows = vec_new<String>()
  rows.push(".XXXX.")
  rows.push("X.XX.X")
  rows.push("X.XX.X")
  rows.push("X.XX.X")
  rows.push(".XXXX.")
  rows.push("..XX..")
  return rune_from_strs(rows)
end

