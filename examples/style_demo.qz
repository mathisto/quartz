## Style API Demo — Showcases Quartz's terminal styling capabilities.
##
## Run: ./self-hosted/bin/quartz --no-cache -I std -I . examples/style_demo.qz > /tmp/style_demo.ll && \
##      llc -filetype=obj /tmp/style_demo.ll -o /tmp/style_demo.o && \
##      clang /tmp/style_demo.o -o /tmp/style_demo -lm -lpthread && /tmp/style_demo

import std/style
import std/terminal
import std/colors

def main(): Int
  width = term_get_width()
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Header
  # ═══════════════════════════════════════════════════════════════
  header = Style.new().bold().fg(Cyan()).underline()
  puts(header.render_at("  Quartz Style API Demo  ", 16777216))
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 1: Text Attributes
  # ═══════════════════════════════════════════════════════════════
  section("Text Attributes")
  show("bold",          Style.new().bold())
  show("dim",           Style.new().dim())
  show("italic",        Style.new().italic())
  show("underline",     Style.new().underline())
  show("strikethrough", Style.new().strikethrough())
  show("inverse",       Style.new().inverse())
  show("bold+italic",   Style.new().bold().italic())
  show("bold+underline", Style.new().bold().underline())
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 2: ANSI 16 Colors
  # ═══════════════════════════════════════════════════════════════
  section("ANSI 16 Foreground Colors")
  var sb = sb_new()
  sb.append("  ")
  sb.append(Style.new().fg(Black()).render_at("Black ", 16))
  sb.append(Style.new().fg(Red()).render_at("Red ", 16))
  sb.append(Style.new().fg(Green()).render_at("Green ", 16))
  sb.append(Style.new().fg(Yellow()).render_at("Yellow ", 16))
  sb.append(Style.new().fg(Blue()).render_at("Blue ", 16))
  sb.append(Style.new().fg(Magenta()).render_at("Magenta ", 16))
  sb.append(Style.new().fg(Cyan()).render_at("Cyan ", 16))
  sb.append(Style.new().fg(White()).render_at("White", 16))
  puts(sb.to_string())

  var sb2 = sb_new()
  sb2.append("  ")
  sb2.append(Style.new().fg(BrightBlack()).render_at("BrightBlack ", 16))
  sb2.append(Style.new().fg(BrightRed()).render_at("BrightRed ", 16))
  sb2.append(Style.new().fg(BrightGreen()).render_at("BrightGreen ", 16))
  sb2.append(Style.new().fg(BrightYellow()).render_at("BrightYellow ", 16))
  sb2.append(Style.new().fg(BrightBlue()).render_at("BrightBlue ", 16))
  sb2.append(Style.new().fg(BrightMagenta()).render_at("BrightMagenta ", 16))
  sb2.append(Style.new().fg(BrightCyan()).render_at("BrightCyan ", 16))
  sb2.append(Style.new().fg(BrightWhite()).render_at("BrightWhite", 16))
  puts(sb2.to_string())
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 3: Background Colors
  # ═══════════════════════════════════════════════════════════════
  section("Background Colors")
  var sb3 = sb_new()
  sb3.append("  ")
  sb3.append(Style.new().bg(Red()).fg(White()).bold().render_at(" Error ", 16))
  sb3.append(" ")
  sb3.append(Style.new().bg(Green()).fg(Black()).bold().render_at(" Success ", 16))
  sb3.append(" ")
  sb3.append(Style.new().bg(Yellow()).fg(Black()).bold().render_at(" Warning ", 16))
  sb3.append(" ")
  sb3.append(Style.new().bg(Blue()).fg(White()).bold().render_at(" Info ", 16))
  sb3.append(" ")
  sb3.append(Style.new().bg(Magenta()).fg(White()).bold().render_at(" Debug ", 16))
  puts(sb3.to_string())
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 4: RGB Truecolor
  # ═══════════════════════════════════════════════════════════════
  section("RGB Truecolor Gradient")
  var grad = sb_new()
  grad.append("  ")
  for i in 0..32
    var r = i * 8
    var g = 0
    var b = 255 - i * 8
    grad.append(Style.new().fg(rgb_color(r, g, b)).render_at("█", 16777216))
  end
  grad.append(" ")
  for i in 0..32
    var r = 255
    var g = i * 8
    var b = 0
    grad.append(Style.new().fg(rgb_color(r, g, b)).render_at("█", 16777216))
  end
  puts(grad.to_string())

  var grad2 = sb_new()
  grad2.append("  ")
  for i in 0..32
    var r = 0
    var g = i * 8
    var b = 0
    grad2.append(Style.new().fg(rgb_color(r, g, b)).render_at("█", 16777216))
  end
  grad2.append(" ")
  for i in 0..32
    var g = 255 - i * 4
    grad2.append(Style.new().fg(rgb_color(g, g, g)).render_at("█", 16777216))
  end
  puts(grad2.to_string())
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 5: Hex Colors
  # ═══════════════════════════════════════════════════════════════
  section("Hex Color Codes")
  var sb5 = sb_new()
  sb5.append("  ")
  sb5.append(Style.new().fg(hex_color("#FF6B6B")).render_at("#FF6B6B ", 16777216))
  sb5.append(Style.new().fg(hex_color("#4ECDC4")).render_at("#4ECDC4 ", 16777216))
  sb5.append(Style.new().fg(hex_color("#45B7D1")).render_at("#45B7D1 ", 16777216))
  sb5.append(Style.new().fg(hex_color("#96CEB4")).render_at("#96CEB4 ", 16777216))
  sb5.append(Style.new().fg(hex_color("#FFEAA7")).render_at("#FFEAA7 ", 16777216))
  sb5.append(Style.new().fg(hex_color("#DDA0DD")).render_at("#DDA0DD ", 16777216))
  sb5.append(Style.new().fg(hex_color("#FF8C00")).render_at("#FF8C00", 16777216))
  puts(sb5.to_string())
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 6: Semantic Presets
  # ═══════════════════════════════════════════════════════════════
  section("Semantic Style Presets")
  puts("  #{Style.error().render_at("error: ", 16)}something went wrong")
  puts("  #{Style.success().render_at("success: ", 16)}operation completed")
  puts("  #{Style.warning().render_at("warning: ", 16)}deprecated function used")
  puts("  #{Style.info().render_at("info: ", 16)}processing 42 items...")
  puts("  #{Style.muted().render_at("debug: ", 16)}internal state dump")
  puts("  #{Style.heading().render_at("Section Title", 16)}")
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 7: Immutable Chaining Demo
  # ═══════════════════════════════════════════════════════════════
  section("Immutable Builder Chaining")
  base = Style.new().bold()
  error_style = base.fg(Red())
  ok_style = base.fg(Green())
  warn_style = base.fg(Yellow()).italic()
  puts("  base:  #{base.render_at("just bold", 16)}")
  puts("  error: #{error_style.render_at("bold + red", 16)}")
  puts("  ok:    #{ok_style.render_at("bold + green", 16)}")
  puts("  warn:  #{warn_style.render_at("bold + yellow + italic", 16)}")
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 8: Color Degradation
  # ═══════════════════════════════════════════════════════════════
  section("Automatic Color Degradation")
  rainbow = Style.new().fg(rgb_color(255, 100, 50)).bold()
  puts("  Truecolor (16M): #{rainbow.render_at("Hello Quartz!", 16777216)}")
  puts("  256-color:       #{rainbow.render_at("Hello Quartz!", 256)}")
  puts("  16-color:        #{rainbow.render_at("Hello Quartz!", 16)}")
  puts("  No color:        #{rainbow.render_at("Hello Quartz!", 0)}")
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Section 9: Terminal Capabilities
  # ═══════════════════════════════════════════════════════════════
  section("Terminal Capabilities (Detected)")
  puts("  stdout is TTY:      #{term_is_tty_stdout()}")
  puts("  color depth:        #{term_color_depth()}")
  puts("  supports Unicode:   #{term_supports_unicode()}")
  puts("  terminal width:     #{term_get_width()} columns")
  puts("")

  # ═══════════════════════════════════════════════════════════════
  # Footer
  # ═══════════════════════════════════════════════════════════════
  puts(Style.muted().render_at("  Powered by std/style.qz — Lipgloss-inspired composable styling for Quartz", 16))
  puts("")

  return 0
end

## Print a section header
def section(title: String): Void
  puts("  #{Style.new().bold().fg(White()).render_at(title, 16)}")
  puts("  #{Style.muted().render_at("─────────────────────────────────────────", 16)}")
end

## Show a style example with label
def show(label: String, s: Style): Void
  padded = str_pad_right(label, 16, " ")
  puts("  #{Style.muted().render_at(padded, 16)} #{s.render_at("The quick brown fox jumps over the lazy dog", 16)}")
end
