##! Bare Metal — Aspirational freestanding "Hello from nothing" example
##!
##! Demonstrates: What a QEMU freestanding Quartz program would look like.
##!
##! STATUS: ASPIRATIONAL — This example cannot compile today.
##! It documents the design goal for bare-metal Quartz targeting QEMU.
##!
##! What would be needed to make this work:
##!   1. A `--target freestanding` or `--target aarch64-none` compiler flag
##!      that suppresses stdlib linking and emits a raw binary
##!   2. A linker script to place code at the correct QEMU entry point
##!      (e.g., 0x40000000 for QEMU virt machine)
##!   3. Volatile memory write intrinsics: volatile_store(addr, val)
##!      to write to memory-mapped I/O (UART at 0x09000000 on QEMU virt)
##!   4. No heap allocation (alloc/free), no string operations, no Vec —
##!      only raw integer arithmetic and volatile writes
##!   5. A custom _start entry point instead of main() that the
##!      compiler recognizes for freestanding targets
##!
##! To run with QEMU (if this worked):
##!   quartz --target aarch64-none bare_metal.qz > bare_metal.ll
##!   llc -march=aarch64 -filetype=obj bare_metal.ll -o bare_metal.o
##!   aarch64-elf-ld -T linker.ld bare_metal.o -o bare_metal.elf
##!   qemu-system-aarch64 -M virt -cpu cortex-a53 -nographic \
##!     -kernel bare_metal.elf

## UART0 base address on QEMU virt machine (PL011)
## This is where we'd write characters to see them on the serial console.
# UART0 = 0x09000000

## In a freestanding environment, we'd write directly to the UART
## data register using volatile stores. Each byte written appears
## on the QEMU serial console.
##
## def uart_putc(c: Int): Void
##   volatile_store_byte(UART0, c)
## end
##
## def uart_puts(s: String): Void
##   # With no stdlib, we'd need raw pointer arithmetic:
##   # var i = 0
##   # while i < length
##   #   uart_putc(ptr_read_byte(data_ptr, i))
##   #   i = i + 1
##   # end
## end

## The entry point for a freestanding binary.
## No argc/argv, no return value expected — just run and halt.
##
## def _start(): Void
##   # Write "Hello from nothing!\n" one character at a time
##   uart_putc(72)   # H
##   uart_putc(101)  # e
##   uart_putc(108)  # l
##   uart_putc(108)  # l
##   uart_putc(111)  # o
##   uart_putc(32)   #
##   uart_putc(102)  # f
##   uart_putc(114)  # r
##   uart_putc(111)  # o
##   uart_putc(109)  # m
##   uart_putc(32)   #
##   uart_putc(110)  # n
##   uart_putc(111)  # o
##   uart_putc(116)  # t
##   uart_putc(104)  # h
##   uart_putc(105)  # i
##   uart_putc(110)  # n
##   uart_putc(103)  # g
##   uart_putc(33)   # !
##   uart_putc(10)   # \n
##
##   # Halt: infinite loop (no OS to return to)
##   while true
##   end
## end

## ==========================================================================
## For now, this is a normal Quartz program that simulates what bare-metal
## output would look like, using the regular stdlib puts function.
## ==========================================================================

def main(): Int
  puts("=== Bare Metal (simulated) ===")
  puts("")
  puts("If this were running on QEMU bare metal:")
  puts("  - Target: aarch64-none (QEMU virt machine)")
  puts("  - UART: PL011 at 0x09000000")
  puts("  - No OS, no stdlib, no heap")
  puts("  - Output via volatile_store to UART data register")
  puts("")
  puts("Hello from nothing!")
  puts("")
  puts("What's needed to make this real:")
  puts("  1. --target freestanding compiler flag")
  puts("  2. volatile_store_byte(addr, val) intrinsic")
  puts("  3. Linker script for QEMU virt entry point")
  puts("  4. _start entry point (no main/argc/argv)")
  puts("  5. Cross-compilation: llc -march=aarch64")
  return 0
end
