## examples/http_effects.qz — canonical "HTTP via effects" demo.
##
## Operation Piezoelectric Effects, Phase 6.1.e — the user-facing
## payoff of the 6.1 epic. Three things this file shows:
##
##   1. The 5-line hello world (block DSL).
##   2. Test-time mocking of the filesystem via the `FileIo` effect:
##      a real HTTP server that serves "/index.html" from an in-memory
##      table, no real files involved.
##   3. Test-time capture of every access-log line via the `Log`
##      effect: outer `with Log { emit: cap } do -> http_serve(...)`
##      sees every request/response arrow that with_logging emits,
##      regardless of how deep the wrapping goes.
##
## The point of the demo is that mocking, capturing, and overriding
## are first-class language features — not a separate testing
## framework, not DI containers, not monkey-patching globals. Effects
## ARE dependency injection.
##
## Run the live server:
##   quartz examples/http_effects.qz | llc -filetype=obj -o /tmp/he.o
##   clang /tmp/he.o -o /tmp/he -lm -lpthread -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto
##   /tmp/he
##   curl http://localhost:8080/
##   curl http://localhost:8080/index.html
##
## The `main` here is the live demo. The `_demo_unit_test` function
## below shows the testing pattern — call it from a spec to run an
## entire HTTP flow through mocked I/O with no port binding.

import std/net/http_server
import std/file_io
import std/log

# =============================================================================
# Hello world — 5 lines (block DSL)
# =============================================================================
#
#   def main(): Int
#     http_serve(8080) do ->
#       route_get("/", req: Request -> text_response("Hello, Quartz!"))
#     end
#   end

# =============================================================================
# Demo handler — uses with_static + with_logging on top of routing.
# =============================================================================

def hello(req: Request): Response
  return text_response("Hello, Quartz!")
end

def about(req: Request): Response
  return html_response("<h1>About</h1><p>Powered by algebraic effects.</p>")
end

def fallback(req: Request): Response
  return not_found()
end

def static_handler(req: Request): Response
  return _static_handle_request("/", "/var/www/quartz", fallback, req)
end

# `pipeline_handler` is the per-request entry point: routes first, fall
# through to static-file serving, then 404. with_logging adds the
# request/response arrows around the whole stack.
def pipeline_handler(req: Request): Response
  if req.path == "/"
    return hello(req)
  end
  if req.path == "/about"
    return about(req)
  end
  return static_handler(req)
end

def main(): Int
  var wrapped = with_logging(pipeline_handler)
  http_serve_supervised(http_server_config(8080), wrapped)
  return 0
end

# =============================================================================
# Test-time mocking — the design memo's "killer demo."
# =============================================================================
#
# A spec calls `_demo_unit_test()` and asserts on the return value.
# No port bind, no real filesystem read, no stderr noise. The handler
# logic is exercised end-to-end through the same effect substrate the
# live server uses.
#
# This function is reachable but not called from main; it exists so
# spec/qspec/phase_6_1e_middleware_effects_spec.qz (and any future
# user-written tests) can demonstrate the pattern.

def fixture_exists(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  if path == "/var/www/quartz/index.html"
    return 1
  end
  return 0
end

def fixture_read(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  if path == "/var/www/quartz/index.html"
    return as_int("<h1>FIXTURE INDEX</h1>")
  end
  return as_int("")
end

def captured_log_handler(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("[TEST-LOG] " + msg)
  return 0
end

def _demo_unit_test(): Int
  var req = Request {
    method: "GET", path: "/index.html",
    query_string: "", body: "",
    raw_path: "/index.html",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  with FileIo { fio_read: fixture_read, fio_exists: fixture_exists } do ->
    with Log { emit: captured_log_handler } do ->
      var wrapped = with_logging(pipeline_handler)
      var resp = wrapped(req)
      puts("body: " + resp.body)
    end
  end
  return 0
end
