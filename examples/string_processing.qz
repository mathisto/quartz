##! String Processing - String ops, interpolation, StringBuilder
##!
##! Demonstrates: string UFCS methods, interpolation, StringBuilder,
##! for..in iteration, pattern matching, and text manipulation.

def count_char(s: String, target: Int): Int
  var count = 0
  for c in s
    if c == target
      count += 1
    end
  end
  return count
end

def str_reverse(s: String): String
  var sb = sb_new()
  var i = s.size() - 1
  while i >= 0
    sb.append_char(s.char_at(i))
    i -= 1
  end
  result = sb.to_string()
  sb.free()
  return result
end

def is_palindrome(s: String): Bool
  len = s.size()
  var i = 0
  while i < len / 2
    if s.char_at(i) != s.char_at(len - 1 - i)
      return false
    end
    i += 1
  end
  return true
end

def str_repeat(s: String, n: Int): String
  var sb = sb_new()
  for i in 0..n
    sb.append(s)
  end
  result = sb.to_string()
  sb.free()
  return result
end

def check_palindrome(word: String): Void
  if is_palindrome(word)
    puts("  #{word} -> palindrome")
  else
    puts("  #{word} -> not palindrome")
  end
end

def main(): Int
  puts("=== String Processing ===")
  puts("")
  name = "Quartz"
  puts("name = #{name}, length = #{name.size()}")
  puts("")
  text = "Hello, World!"
  puts("slice [0:5] = #{text.slice(0, 5)}")
  puts("slice [7:12] = #{text.slice(7, 12)}")
  puts("")
  csv = "alice,bob,charlie"
  puts("find(',') = #{csv.find(",").unwrap_or(-1)}")
  parts = csv.split(",")
  puts("split yields #{parts.size} parts")
  puts("")
  puts("Palindromes:")
  check_palindrome("racecar")
  check_palindrome("hello")
  check_palindrome("madam")
  puts("")
  var sb = sb_new()
  sb.append("The answer is ")
  sb.append_int(42)
  sb.append_char(33)
  puts("StringBuilder: #{sb.to_string()}")
  sb.free()
  puts("")
  puts("'banana' has #{count_char("banana", 97)} a's")
  puts("reverse(#{name}) = #{str_reverse(name)}")
  puts("repeat('ha', 3) = #{str_repeat("ha", 3)}")
  vec_free(parts)
  return 0
end
