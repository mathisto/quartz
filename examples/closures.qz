##! Closures - First-class functions, lambdas, HOFs (map/filter/reduce)
##!
##! Demonstrates: arrow lambdas, closure capture by value,
##! higher-order functions, function values, currying, UFCS.

def apply(f: Fn(Int): Int, x: Int): Int = f(x)
def apply_twice(f: Fn(Int): Int, x: Int): Int = f(f(x))

## Named functions can be passed as values.
def double(x: Int): Int = x * 2
def increment(x: Int): Int = x + 1

## Closures capture variables by value at creation time.
def make_adder(n: Int): Fn(Int): Int
  return (x: Int) -> x + n
end

def make_multiplier(n: Int): Fn(Int): Int
  return (x: Int) -> x * n
end

## Map: apply f to each element, return new vector.
def my_map(v: Vec<Int>, f: Fn(Int): Int): Vec<Int>
  var result = vec_new()
  for i in 0..v.size
    result.push(f(v[i]))
  end
  return result
end

## Filter: keep elements where predicate is true.
def my_filter(v: Vec<Int>, pred: Fn(Int): Bool): Vec<Int>
  var result = vec_new()
  for i in 0..v.size
    val = v[i]
    if pred(val)
      result.push(val)
    end
  end
  return result
end

## Reduce: fold elements with accumulator.
def my_reduce(v: Vec<Int>, init: Int, f: Fn(Int, Int): Int): Int
  var acc = init
  for i in 0..v.size
    acc = f(acc, v[i])
  end
  return acc
end

def print_vec(label: String, v: Vec<Int>): Void
  print("  #{label}: [")
  for i in 0..v.size
    if i > 0
      print(", ")
    end
    print("#{v[i]}")
  end
  puts("]")
end

def main(): Int
  puts("=== Closures & HOFs ===")
  puts("")
  puts("Named functions as values:")
  puts("  apply(double, 21) = #{apply(double, 21)}")
  puts("  apply_twice(double, 3) = #{apply_twice(double, 3)}")
  puts("")
  puts("Closures:")
  add5 = make_adder(5)
  triple = make_multiplier(3)
  puts("  add5(7) = #{add5(7)}")
  puts("  triple(14) = #{triple(14)}")
  puts("")
  puts("Capture by value (not reference):")
  var x = 100
  get_x = make_adder(0)
  captured = apply(make_adder(x), 0)
  x = 999
  puts("  captured 100, mutated to 999: #{captured}")
  puts("")
  puts("HOFs:")
  var numbers = vec_new()
  for i in 1..11
    numbers.push(i)
  end
  print_vec("numbers", numbers)
  doubled = my_map(numbers, (n: Int) -> n * 2)
  print_vec("map(*2)", doubled)
  evens = my_filter(numbers, (n: Int) -> n % 2 == 0)
  print_vec("filter(even)", evens)
  total = my_reduce(numbers, 0, (acc: Int, n: Int) -> acc + n)
  puts("  reduce(+) = #{total}")
  vec_free(numbers)
  vec_free(doubled)
  vec_free(evens)
  return 0
end
