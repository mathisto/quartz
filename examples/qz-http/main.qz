import std/net/http_server

def main(): Int
  http_serve(8080) do ->
    route_get("/", req: Request -> html_response("<h1>Welcome!</h1>"))
    route_get("/about", req: Request -> text_response("About page"))
    route_get("/hello/:name", req: Request -> {
      var name = route_param("/hello/:name", req.path, "name")
      text_response("Hello, " + name + "!")
    })
    route_get("/api/status", req: Request -> json_response("{\"status\": \"ok\", \"server\": \"Quartz\"}"))
    route_post("/echo", req: Request -> text_response("You sent: " + req.body))
  end
  return 0
end
