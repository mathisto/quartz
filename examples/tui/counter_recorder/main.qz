# TUI v0.1 recorder-hook verification dogfood.
#
# Same shape as examples/tui/counter — but attaches a counting
# recorder via program_with_recorder. On clean exit, prints the
# observed message count to stderr in the form `recorded:N`.
#
# This is the design-doc acceptance check for "Recorder hook fires
# once per dispatched message, including synthetic Quit." Pipe a
# known input sequence and assert the recorded count matches the
# number of dispatched messages.
#
# Verification:
#   echo -n 'q' | /tmp/counter_recorder 2>/tmp/rec.stderr
#   grep -q 'recorded:2' /tmp/rec.stderr   # 'q' Key + synthetic Quit = 2

import std/tui/runtime as tui
import std/terminal

struct State
  count: Int
end

enum AppMsg
  Noop
end

# Module-level counter — incremented by the recorder once per dispatched
# message. The recorder is pure-by-contract from the framework's view
# (returns Void), but it can side-effect into module state for tooling
# like this; the design doc explicitly permits this.
var _msgs_recorded = 0

def my_recorder(msg: tui::FrameMsg<AppMsg>): Void
  _msgs_recorded = _msgs_recorded + 1
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      # Any printable 'q' triggers quit too — keeps the verification
      # path orthogonal to terminal escape parsing.
      if k.code == 'q'
        return (s, tui::Cmd::Quit)
      end
      return (State { count: s.count + 1 }, tui::Cmd::None)
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String =
  "Count: #{s.count}\r\n[recorder demo · q or Ctrl-C to quit]\r\n"

def main(): Int
  var p = tui::program_new(State { count: 0 }, update, view)
  var p2 = tui::program_with_recorder(p, my_recorder)
  var rc = tui::program_run(p2)
  eputs("recorded:#{_msgs_recorded}")
  return rc
end
