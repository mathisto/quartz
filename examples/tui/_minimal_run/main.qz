# Minimal interactive proof-of-life for std/tui/runtime program_run
# (TUI v0.1 commit 2/3). Underscore-prefixed dir marks this as the
# bring-up smoke, NOT the canonical counter dogfood — that ships in
# commit 3/3 at examples/tui/counter/main.qz.
#
# Three live keys + one panic key:
#
#   j           count + 1
#   k           count - 1
#   q           Cmd::Quit (clean shutdown)
#   Ctrl-C      Cmd::Quit (clean shutdown — confirmed not auto-intercepted)
#   b           throw("boom from update") — exercises crash-safe
#               raw-mode restoration. Terminal must be sane on exit.
#
# Acceptance: keypresses dispatch through update, view renders,
# clean-quit returns the user to a usable shell, panic-quit ALSO
# returns the user to a usable shell (with the boom message printed
# to stderr and exit 66 from the runtime-blessed default Throws
# handler).

import std/tui/runtime as tui
import std/terminal

struct State
  count: Int
end

# AppMsg has no live producers in v0.1 (no Cmd::Run, no external send).
# Stub variant exists because every Quartz enum needs at least one.
enum AppMsg
  Noop
end

def my_update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) => match k.code
      'j' => return (State { count: s.count + 1 }, tui::Cmd::None)
      'k' => return (State { count: s.count - 1 }, tui::Cmd::None)
      'q' => return (s, tui::Cmd::Quit)
      'b' =>
        throw("boom from update")
        return (s, tui::Cmd::None)
      _ =>
        if k.code == terminal::KEY_CTRL_C()
          return (s, tui::Cmd::Quit)
        end
        return (s, tui::Cmd::None)
    end
    _ => return (s, tui::Cmd::None)
  end
end

def my_view(s: State): String =
  "Count: #{s.count}\r\n[j/k change · q quit · Ctrl-C quit · b panic]\r\n"

def main(): Int
  return tui::program_run(tui::program_new(State { count: 0 }, my_update, my_view))
end
