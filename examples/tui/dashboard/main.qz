# Live dashboard demo — exercises the v0.5 TUI surface end-to-end.
#
# Three tabs, each cycled with Tab / Shift-Tab (or 1/2/3 for jump-to):
#
#   Clock — wall-clock time, ticking once per second via Cmd::Every.
#   Term  — live terminal dimensions, recomputed on FrameMsg::Resize.
#   About — static help-style content; demonstrates the muted style.
#
# What this sample validates:
#
#   - Phase 7 (SIGWINCH) — resize the terminal; the Term tab's
#     dimensions update within 100ms of the resize event.
#   - Phase 9 (Tabs)     — the strip at the top renders the three
#     labelled tabs with active-bold-inverse + plain-inactive shape.
#   - Cmd::Every         — the clock ticks autonomously without any
#     user keypress.
#   - status_bar         — pinned footer with active-tab hint and
#     quit binding.
#   - help_modal         — `?` opens a keymap overlay.
#
# Run:
#
#   ./self-hosted/bin/quartz examples/tui/dashboard/main.qz > /tmp/d.ll
#   /opt/homebrew/opt/llvm/bin/llc -filetype=obj /tmp/d.ll -o /tmp/d.o
#   clang /tmp/d.o -o /tmp/dashboard -lm -lpthread
#   /tmp/dashboard
#
# Keys: Tab cycles forward, Shift-Tab cycles back, 1/2/3 jump-to,
#       ? toggles help, q quits, Ctrl-C emergency exit.

import std/tui/runtime as tui
import std/tui/widgets/tabs as tb
import std/tui/widgets/status_bar as sb
import std/tui/widgets/overlay as ov
import std/tui/help as hp
import std/tui/layout as ly
import std/terminal
import std/time
import style

# A tiny payload type so the Tabs<T> shape has something concrete to
# parameterise. We don't actually use the payload — the active index
# drives the view. Keeping it as `Int` is the lightest binding.
def TAB_CLOCK(): Int = 0
def TAB_TERM():  Int = 1
def TAB_ABOUT(): Int = 2

enum AppMsg
  Tick
end

struct State
  tabs:           tb::Tabs<Int>
  epoch_ms:       Int
  cols:           Int
  rows:           Int
  help_visible:   Bool
end

# Build the canonical three-tab strip. Stays the same across the run;
# only the active index changes.
def make_tabs(): tb::Tabs<Int>
  var items = vec_new<tb::TabItem<Int>>()
  var t: tb::Tabs<Int> = tb::tabs_new(items)
  t = tb::tabs_append(t, "Clock", TAB_CLOCK())
  t = tb::tabs_append(t, "Term",  TAB_TERM())
  t = tb::tabs_append(t, "About", TAB_ABOUT())
  return t
end

def initial_state(): State
  return State {
    tabs:         make_tabs(),
    epoch_ms:     time_epoch_ms(),
    cols:         terminal::term_get_width(),
    rows:         terminal::term_get_height(),
    help_visible: false
  }
end

# ----- Cmd::Every-driven tick -----

def _tick_thunk(): tui::FrameMsg<AppMsg> = tui::FrameMsg::App(AppMsg::Tick)

def _every_second(): tui::Cmd<AppMsg>
  return tui::Cmd::Every(1000, _tick_thunk)
end

# ----- Update -----

def _set_active(s: State, idx: Int): State
  return State {
    tabs:         tb::tabs_with_active(s.tabs, idx),
    epoch_ms:     s.epoch_ms,
    cols:         s.cols,
    rows:         s.rows,
    help_visible: s.help_visible
  }
end

def _toggle_help(s: State): State
  return State {
    tabs:         s.tabs,
    epoch_ms:     s.epoch_ms,
    cols:         s.cols,
    rows:         s.rows,
    help_visible: not s.help_visible
  }
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::App(_am) =>
      ## Cmd::Every Tick — refresh the wall clock.
      return (State {
        tabs:         s.tabs,
        epoch_ms:     time_epoch_ms(),
        cols:         s.cols,
        rows:         s.rows,
        help_visible: s.help_visible
      }, tui::Cmd::None)
    tui::FrameMsg::Resize(c, r) =>
      ## Phase 7 SIGWINCH delivery — refresh stored dimensions.
      return (State {
        tabs:         s.tabs,
        epoch_ms:     s.epoch_ms,
        cols:         c,
        rows:         r,
        help_visible: s.help_visible
      }, tui::Cmd::None)
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      if k.code == 113  # 'q'
        return (s, tui::Cmd::Quit)
      end
      if k.code == 63   # '?'
        return (_toggle_help(s), tui::Cmd::None)
      end
      if s.help_visible
        return (s, tui::Cmd::None)
      end
      ## Tabs handle ←/→ / h / l / 1..3. We delegate then unpack.
      var triple = tb::tabs_update(s.tabs, msg)
      var next_tabs = triple.0
      return (State {
        tabs:         next_tabs,
        epoch_ms:     s.epoch_ms,
        cols:         s.cols,
        rows:         s.rows,
        help_visible: s.help_visible
      }, tui::Cmd::None)
    _ => return (s, tui::Cmd::None)
  end
end

# ----- Views -----

def _view_clock(s: State): String
  var seconds = s.epoch_ms / 1000
  var hh = (seconds / 3600) % 24
  var mm = (seconds / 60) % 60
  var ss = seconds % 60
  var hh_s = _pad2(hh)
  var mm_s = _pad2(mm)
  var ss_s = _pad2(ss)
  var clock = hh_s + ":" + mm_s + ":" + ss_s
  return Style.heading().render("UTC " + clock) + "\n\n  epoch_ms = " + s.epoch_ms.to_s()
end

def _pad2(n: Int): String
  if n < 10
    return "0" + n.to_s()
  end
  return n.to_s()
end

def _view_term(s: State): String
  var dim_line = Style.heading().render("terminal dimensions")
  var live = "  cols = " + s.cols.to_s() + "    rows = " + s.rows.to_s()
  var hint = Style.muted().render("(resize the window — these update within ~100ms)")
  var lines = vec_new<String>()
  lines.push(dim_line)
  lines.push("")
  lines.push(live)
  lines.push("")
  lines.push(hint)
  return ly::join_vertical(lines)
end

def _view_about(): String
  var head = Style.heading().render("dashboard")
  var lines = vec_new<String>()
  lines.push(head)
  lines.push("")
  lines.push("Live demo of the Quartz TUI v0.5 surface:")
  lines.push("")
  lines.push("  - Tabs widget          (Phase 9)")
  lines.push("  - SIGWINCH resize      (Phase 7)")
  lines.push("  - Cmd::Every ticking   (v0.2)")
  lines.push("  - status_bar           (Phase 5)")
  lines.push("  - help_modal           (Phase 6)")
  lines.push("")
  lines.push(Style.muted().render("Source: examples/tui/dashboard/main.qz"))
  return ly::join_vertical(lines)
end

def _view_active(s: State): String
  var idx = tb::tabs_active_index(s.tabs)
  if idx == TAB_CLOCK()
    return _view_clock(s)
  end
  if idx == TAB_TERM()
    return _view_term(s)
  end
  return _view_about()
end

def _help_overlay(): ov::Overlay
  var nav = hp::keymap_append(hp::keymap_new("Navigation"),
    "Tab",  "next tab")
  nav = hp::keymap_append(nav, "←/→",   "cycle tabs")
  nav = hp::keymap_append(nav, "1..3",  "jump to tab")
  var any = hp::keymap_append(hp::keymap_new("Anywhere"), "?", "toggle help")
  any = hp::keymap_append(any, "Q",      "quit")
  any = hp::keymap_append(any, "Ctrl-C", "emergency quit")
  var maps = vec_new<hp::KeyMap>()
  maps.push(nav)
  maps.push(any)
  return hp::help_modal(maps)
end

def _status_bar_view(s: State): String
  var idx = tb::tabs_active_index(s.tabs)
  var tab_name = "Clock"
  if idx == TAB_TERM()
    tab_name = "Term"
  end
  if idx == TAB_ABOUT()
    tab_name = "About"
  end
  var muted = Style.muted()
  var bar = sb::status_bar_with_segments(sb::status_bar_new(), [
    sb::status_segment_with_style(sb::status_segment_left("» " + tab_name), muted),
    sb::status_segment_with_style(sb::status_segment_center("Tab/←→/1-3 navigate"), muted),
    sb::status_segment_with_style(sb::status_segment_right("[?] help · [Q] quit"), muted)
  ])
  return sb::status_bar_view(bar, _inner_width(s))
end

def _inner_width(s: State): Int
  var w = s.cols - 2
  if w < 40
    return 40
  end
  if w > 70
    return 70
  end
  return w
end

def view(s: State): String
  var w = _inner_width(s)
  var strip = tb::tabs_view(s.tabs)
  var body = _view_active(s)
  var bordered = ly::border_with(
    ly::pad_uniform(ly::align_left(body, w - 2), 1),
    ly::BORDER_ROUNDED())
  var bar = _status_bar_view(s)
  var lines = vec_new<String>()
  lines.push(strip)
  lines.push(bordered)
  lines.push(bar)
  var base = ly::join_vertical(lines)
  if s.help_visible
    return ov::overlay_compose(base, _help_overlay())
  end
  return base
end

def main(): Int
  var p = tui::program_new(initial_state(), update, view)
  p = tui::program_with_init(p, _every_second())
  return tui::program_run(p)
end
