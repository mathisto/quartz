## TUI v0.3.2 List demo — 50-card scrollable browser.
##
## A faux deckbuilder card list — 50 hand-rolled cards, navigate with
## ↑↓, jump with Home/End, page with Ctrl-B/Ctrl-F, Enter to "play"
## (the played-history list logs which cards you committed to).
## Ctrl-C quits.
##
## Exercises List<String> with show delegate, scrollbar, wrap_around,
## Highlighted preview pattern, Selected commit pattern.
##
## v0.3.3 step 12 (2026-05-05) closed the last layer — `cards` lives as
## `List<String>` directly and `Selected(card)` binds card:String. No
## Int handles, no `as_type`, no `as_string` recovery anywhere.

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/list as ls

struct State
  cards:   List<String>
  played:  Vec<String>
  status:  String
end

enum AppMsg
  Noop
end

def show_card(s: String): String = s

def make_cards(): Vec<String>
  var v = vec_new<String>()
  v.push("Strike — deal 6 damage")
  v.push("Defend — gain 5 block")
  v.push("Bash — deal 8 damage, apply 2 vulnerable")
  v.push("Iron Wave — deal 5 damage and gain 5 block")
  v.push("Cleave — deal 8 damage to ALL enemies")
  v.push("Anger — deal 6 damage. Add a copy to discard")
  v.push("Body Slam — deal damage equal to your block")
  v.push("Heavy Blade — deal 14 damage")
  v.push("Pommel Strike — deal 9 damage. Draw 1 card")
  v.push("Shrug It Off — gain 8 block. Draw 1 card")
  v.push("True Grit — gain 7 block")
  v.push("Twin Strike — deal 5 damage twice")
  v.push("Warcry — draw 1 card. Put a card from hand on top of deck")
  v.push("Wild Strike — deal 12 damage. Shuffle a wound into draw pile")
  v.push("Battle Trance — draw 3 cards")
  v.push("Bloodletting — lose 3 HP. Gain 2 energy")
  v.push("Burning Pact — exhaust a card. Draw 2 cards")
  v.push("Carnage — ethereal. Deal 20 damage")
  v.push("Combust — at end of turn, lose 1 HP and deal 5 damage to all enemies")
  v.push("Disarm — apply 2 weak. Exhaust")
  v.push("Dropkick — deal 5 damage. If vulnerable, +1 energy and draw 1")
  v.push("Dual Wield — make a copy of an attack or power")
  v.push("Entrench — double your block")
  v.push("Evolve — when drawing a status, draw 1 card")
  v.push("Feel No Pain — when exhausting, gain 3 block")
  v.push("Flame Barrier — gain 12 block. Reflect 4 melee damage")
  v.push("Ghostly Armor — ethereal. Gain 10 block")
  v.push("Hemokinesis — lose 2 HP. Deal 15 damage")
  v.push("Infernal Blade — add a random attack to hand. It costs 0 this turn")
  v.push("Inflame — gain 2 strength")
  v.push("Intimidate — apply 1 weak to ALL enemies. Exhaust")
  v.push("Limit Break — double your strength. Exhaust")
  v.push("Metallicize — at end of turn, gain 3 block")
  v.push("Power Through — add 2 wounds to hand. Gain 15 block")
  v.push("Pummel — deal 2 damage four times. Exhaust")
  v.push("Rage — whenever you play an attack, gain 3 block")
  v.push("Rampage — deal 8 damage. Permanently increase by 5")
  v.push("Reaper — deal 4 damage. Heal HP equal to unblocked damage. Exhaust")
  v.push("Reckless Charge — deal 7 damage. Shuffle a dazed into draw pile")
  v.push("Rupture — gain 1 strength when losing HP from a card")
  v.push("Searing Blow — deal 12 damage. Upgradeable infinitely")
  v.push("Second Wind — exhaust all non-attack cards. Gain 5 block per exhaust")
  v.push("Seeing Red — gain 2 energy. Exhaust")
  v.push("Sentinel — gain 5 block. If exhausted, gain 2 energy")
  v.push("Sever Soul — exhaust all non-attacks. Deal 16 damage")
  v.push("Shockwave — apply 3 weak and 3 vulnerable to ALL enemies. Exhaust")
  v.push("Spot Weakness — gain 3 strength if enemy intends attack")
  v.push("Sword Boomerang — deal 3 damage to a random enemy 3 times")
  v.push("Whirlwind — deal X damage to ALL enemies X times")
  v.push("Berserk — gain 2 vulnerable. At start of turn gain 1 energy")
  return v
end

def _clone_played(src: Vec<String>): Vec<String>
  var out = vec_new<String>()
  var i = 0
  while i < src.size
    out.push(src[i])
    i = i + 1
  end
  return out
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      var triple = ls::list_update(s.cards, msg)
      var next = triple.0
      var ev = triple.2
      match ev
        Selected(card) =>
          var new_played = _clone_played(s.played)
          new_played.push(card)
          return (State {
            cards: next, played: new_played,
            status: "played: #{card}"
          }, tui::Cmd::None)
        Highlighted(_) =>
          return (State { cards: next, played: s.played, status: "" }, tui::Cmd::None)
        _ =>
          return (State { cards: next, played: s.played, status: s.status }, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  var bordered = ly::border_with(ls::list_view(s.cards, true), ly::BORDER_ROUNDED())
  var played_count = s.played.size
  var idx_str = "—"
  match ls::list_selected_index(s.cards)
    Some(i) =>
      var n = i + 1
      idx_str = "#{n}/#{ls::list_size(s.cards)}"
    None =>
      idx_str = "—"
  end
  var status_line = "card #{idx_str}  ·  played #{played_count}  ·  #{s.status}"
  var help = "[↑↓ navigate · Home/End jump · Ctrl-B/F page · Enter play · Ctrl-C quit]"
  var parts = vec_new<String>()
  parts.push(bordered)
  parts.push(status_line)
  parts.push(help)
  return ly::join_vertical(parts) + "\n"
end

def main(): Int
  var cards = ls::list_new(make_cards(), ls::item_delegate_simple(show_card))
  cards = ls::list_with_size(cards, 70, 12)
  cards = ls::list_with_scrollbar(cards, true)
  cards = ls::list_with_wrap_around(cards, true)

  var initial = State { cards: cards, played: vec_new<String>(), status: "" }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
