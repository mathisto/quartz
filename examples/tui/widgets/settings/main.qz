## TUI v0.3.3 Settings demo — Form composer end-to-end.
##
## Three fields:
##   - Character name (Required)
##   - Random seed   (Numeric)
##   - Max enemies   (IntRange 1..50)
##
## Tab cycles focus, Enter advances or submits, Esc cancels.
## Submit transitions Form state to Submitted and renders a
## confirmation panel; Cancel transitions to Cancelled and shows the
## cancel-confirmation. Ctrl-C is the runtime-level quit.
##
## Compare to v0.3.2's save_screen example:
##   - save_screen hand-rolled Tab/Enter routing in the parent's
##     update — ~50 lines of dispatch.
##   - settings delegates all of that to form_update — ~10 lines.
##
## v0.3.3 step 11 (2026-05-04) closed
## CONCRETE_GENERIC_AT_NON_GENERIC_STRUCT_FIELD, so `form` lives as
## `form::Form` directly — no Int-handle ceremony, no `as_type` recovery.

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/form as form
import std/tui/widgets/text_input as ti

struct State
  form: form::Form
end

enum AppMsg
  Noop
end

def make_initial_form(): form::Form
  var f = form::form_new()
  f = form::form_with_field(f, "name", "Character name",
    ti::text_input_with_placeholder(ti::text_input_new(), "e.g. Eldric"))
  f = form::form_with_field(f, "seed", "Random seed",
    ti::text_input_with_placeholder(ti::text_input_new(), "any integer"))
  f = form::form_with_field(f, "max_enemies", "Max enemies (1-50)",
    ti::text_input_with_placeholder(ti::text_input_new(), "1..50"))
  f = form::form_with_validator(f, "name", form::Validator::Required)
  f = form::form_with_validator(f, "seed", form::Validator::Numeric)
  f = form::form_with_validator(f, "max_enemies", form::Validator::IntRange(1, 50))
  return form::form_set_size(f, 50, 0)
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      var triple = form::form_update<AppMsg>(s.form, msg)
      var next_form = triple.0
      var ev = triple.2
      # On Submitted or Cancelled, the runtime keeps polling; the form
      # absorbs further keys and returns Idle. The example just renders
      # the terminal-state panel from view.
      return (State { form: next_form }, tui::Cmd::None)
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  match form::form_state(s.form)
    FormState::Submitted =>
      var msg = "✓ Settings saved!\n"
      msg = msg + "  name: " + form::form_get(s.form, "name") + "\n"
      msg = msg + "  seed: " + form::form_get(s.form, "seed") + "\n"
      msg = msg + "  max_enemies: " + form::form_get(s.form, "max_enemies") + "\n"
      msg = msg + "\n[Ctrl-C to exit]\n"
      return msg
    FormState::Cancelled =>
      return "✗ Settings cancelled.\n\n[Ctrl-C to exit]\n"
    _ =>
      var form_view = form::form_view(s.form, true)
      var help = "[Tab cycle · Enter advance/submit · Esc cancel · Ctrl-C quit]"
      var parts = vec_new<String>()
      parts.push("Game Settings")
      parts.push("")
      parts.push(form_view)
      parts.push("")
      parts.push(help)
      return ly::join_vertical(parts) + "\n"
  end
end

def main(): Int
  var initial = State { form: make_initial_form() }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
