## TUI v0.3.2 Save-Screen demo — TextInput + List + FocusRing.
##
## Two-widget composite proving the v0.3.2 trio composes cleanly:
##   - TextInput for the new save name (top)
##   - List of existing saves (middle) — selecting one prefills the name
##   - FocusRing rotates focus between them via Tab / Shift-Tab
##
## Press Enter on the focused TextInput to "save" (logs to stdout-on-quit).
## Press Enter on the focused List to prefill TextInput from the chosen item.
## Ctrl-C quits.
##
## v0.3.3 step 12 (2026-05-05) closed the last layer — all three widget
## handles live with their real types AND the ListEvent payload binds at
## its concrete type. No Int handles, no `as_type`, no `as_string`
## anywhere — pure surface syntax end-to-end.

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/focus as fr
import std/tui/widgets/text_input as ti
import std/tui/widgets/list as ls

# Focus ids — one variant per focusable child.
enum SaveFocus
  NameInput
  SaveList
end

extend SaveFocus with Eq
  def op_eq(self, other: Self): Bool
    match self
      NameInput => return other is NameInput
      SaveList  => return other is SaveList
    end
  end
end

struct State
  input:  ti::TextInput
  saves:  ls::List<String>
  focus:  fr::FocusRing<SaveFocus>
  status: String
end

enum AppMsg
  Noop
end

def show_save(s: String): String = s

def make_initial_saves(): Vec<String>
  var v = vec_new<String>()
  v.push("ironclad-2025-04-12")
  v.push("silent-2025-04-09")
  v.push("defect-2025-04-03")
  v.push("watcher-2025-03-28")
  return v
end

def make_focus_ring(): fr::FocusRing<SaveFocus>
  var ids = vec_new<SaveFocus>()
  ids.push(SaveFocus::NameInput)
  ids.push(SaveFocus::SaveList)
  return fr::focus_ring_with_initial(ids, SaveFocus::NameInput)
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      # Tab cycles focus.
      if k.code == terminal::KEY_TAB()
        return (State {
          input: s.input, saves: s.saves,
          focus: fr::focus_ring_next(s.focus),
          status: ""
        }, tui::Cmd::None)
      end
      # Route keys to focused widget.
      match fr::focus_ring_current(s.focus)
        Some(NameInput) =>
          var triple = ti::text_input_update(s.input, msg)
          var next_input = triple.0
          var ev = triple.2
          if ev is Submitted
            var name = ti::text_input_value(next_input)
            return (State {
              input: ti::text_input_clear(next_input),
              saves: s.saves, focus: s.focus,
              status: "✓ saved as: #{name}"
            }, tui::Cmd::None)
          end
          return (State {
            input: next_input, saves: s.saves,
            focus: s.focus, status: s.status
          }, tui::Cmd::None)
        Some(SaveList) =>
          var triple = ls::list_update(s.saves, msg)
          var next_list = triple.0
          var ev = triple.2
          match ev
            Selected(item) =>
              var prefilled = ti::text_input_set_value_unchecked(s.input, item)
              return (State {
                input: prefilled, saves: next_list,
                focus: s.focus,
                status: "prefilled — Tab to name input, Enter to save"
              }, tui::Cmd::None)
            _ =>
              return (State {
                input: s.input, saves: next_list,
                focus: s.focus, status: s.status
              }, tui::Cmd::None)
          end
        None =>
          return (s, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  var name_focused = fr::focus_ring_is_focused(s.focus, SaveFocus::NameInput)
  var list_focused = fr::focus_ring_is_focused(s.focus, SaveFocus::SaveList)

  var input_view = ti::text_input_view(s.input, name_focused)
  var input_box = ly::border_with(ly::pad_horizontal(input_view, 1), ly::BORDER_ROUNDED())
  var list_box = ly::border_with(ls::list_view(s.saves, list_focused), ly::BORDER_ROUNDED())

  var help = "[Tab cycle focus · Enter on input = save · Enter on list = prefill · Ctrl-C quit]"
  var parts = vec_new<String>()
  parts.push(input_box)
  parts.push(list_box)
  parts.push(s.status)
  parts.push(help)
  return ly::join_vertical(parts) + "\n"
end

def main(): Int
  var name_input = ti::text_input_with_prompt(
    ti::text_input_with_placeholder(ti::text_input_new(), "your save name…"),
    "save: "
  )

  var saves_list = ls::list_with_size(
    ls::list_with_wrap_around(
      ls::list_new(make_initial_saves(), ls::item_delegate_simple(show_save)),
      true
    ),
    50, 5
  )

  var initial = State {
    input: name_input,
    saves: saves_list,
    focus: make_focus_ring(),
    status: ""
  }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
