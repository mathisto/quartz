## TUI v0.3.2 Viewport demo — combat-log-style streaming append.
##
## Press any printable key to append a "log entry" (the codepoint
## you pressed, framed with a counter). With follow_tail on, new
## entries auto-scroll into view. Up / Down / Ctrl-F / Ctrl-B /
## Home / End scroll without disengaging tail-follow (manual scroll
## up holds, scroll back to bottom re-engages).
##
## Ctrl-L clears the log. Ctrl-C quits.

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/viewport as vp

struct State
  log:    vp::Viewport
  count:  Int
end

enum AppMsg
  Noop
end

def is_log_key(code: Int): Bool
  if code == terminal::KEY_CTRL_C()
    return false
  end
  if code == terminal::KEY_CTRL_L()
    return false
  end
  if code == terminal::KEY_UP()
    return false
  end
  if code == terminal::KEY_DOWN()
    return false
  end
  if code == terminal::KEY_HOME()
    return false
  end
  if code == terminal::KEY_END()
    return false
  end
  if code == terminal::KEY_CTRL_F()
    return false
  end
  if code == terminal::KEY_CTRL_B()
    return false
  end
  if code < 0x20
    return false
  end
  return true
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      if k.code == terminal::KEY_CTRL_L()
        return (State { log: vp::viewport_clear(s.log), count: 0 }, tui::Cmd::None)
      end
      if is_log_key(k.code)
        var ch = str_from_codepoint(k.code)
        var n = s.count + 1
        var line = "[##{n}] you pressed '#{ch}'"
        return (State {
          log: vp::viewport_append_line(s.log, line),
          count: n
        }, tui::Cmd::None)
      end
      # Scroll keys — forward to viewport
      var triple = vp::viewport_update(s.log, msg)
      return (State { log: triple.0, count: s.count }, triple.1)
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  var bordered = ly::border_with(vp::viewport_view(s.log, true), ly::BORDER_ROUNDED())
  var pct = vp::viewport_scroll_percent(s.log)
  var status = "scroll: #{pct}%  ·  entries: #{s.count}"
  var help = "[Press keys to log · ↑↓ Ctrl-F Ctrl-B Home End scroll · Ctrl-L clear · Ctrl-C quit]"
  var parts = vec_new()
  parts.push(bordered)
  parts.push(status)
  parts.push(help)
  return ly::join_vertical(parts) + "\n"
end

def main(): Int
  var log = vp::viewport_new()
  log = vp::viewport_with_size(log, 60, 10)
  log = vp::viewport_with_follow_tail(log, true)
  log = vp::viewport_with_scrollbar(log, true)
  log = vp::viewport_set_content(log, "press any key to append entries to this log...")

  var initial = State { log: log, count: 0 }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
