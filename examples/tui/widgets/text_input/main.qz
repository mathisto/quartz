## TUI v0.3.2 TextInput demo — keys-only echo widget.
##
## Exercises the TextInput widget end-to-end:
##   - typing inserts at the cursor
##   - Backspace / Delete edit the value
##   - Left / Right / Home / End move the cursor
##   - Ctrl-W deletes the word before the cursor
##   - Ctrl-U clears from cursor to start
##   - Enter submits (with a min-3-character validator on OnSubmit)
##   - Ctrl-C quits cleanly
##
## The view shows: the input on top, validation status (when last_error
## populated), and a help line beneath. Submitted values are appended to
## a small history list below.
##
## Run:
##   ./self-hosted/bin/quartz -I std examples/tui/widgets/text_input/main.qz > /tmp/d.ll
##   /opt/homebrew/opt/llvm/bin/llc -filetype=obj /tmp/d.ll -o /tmp/d.o
##   clang /tmp/d.o -o /tmp/text_input_demo -lm -lpthread
##   /tmp/text_input_demo

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/text_input as ti

struct State
  input:   ti::TextInput
  history: Vec<String>     # submitted values, newest last
end

enum AppMsg
  Noop
end

# Validator: at least 3 codepoints.
def name_validator(v: String): Option<String>
  if v.size < 3
    return Option::Some("name must be at least 3 characters")
  end
  return Option::None
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      var triple = ti::text_input_update(s.input, msg)
      var next_input = triple.0
      var ev = triple.2
      if ev is Submitted
        var v = ti::text_input_value(next_input)
        var new_history = vec_new<String>()
        var i = 0
        while i < s.history.size
          new_history.push(s.history[i])
          i = i + 1
        end
        new_history.push(v)
        return (State {
          input: ti::text_input_clear(next_input),
          history: new_history
        }, tui::Cmd::None)
      end
      return (State { input: next_input, history: s.history }, tui::Cmd::None)
    _ => return (s, tui::Cmd::None)
  end
end

def render_history(history: Vec<String>): String
  if history.size == 0
    return "(history empty)"
  end
  var sb = sb_new()
  sb_append(sb, "Submitted:")
  var i = 0
  while i < history.size
    sb_append(sb, "\n  ")
    var n = i + 1
    sb_append(sb, "#{n}. #{history[i]}")
    i = i + 1
  end
  return sb_to_string(sb)
end

def view(s: State): String
  var input_box = ly::border_with(
    ly::pad_horizontal(ti::text_input_view(s.input, true), 1),
    ly::BORDER_ROUNDED()
  )

  var status = ""
  match ti::text_input_last_error(s.input)
    Some(msg) => status = "✗ " + msg
    None      => status = " "
  end

  var history = render_history(s.history)
  var help = "[Type, Enter to submit (min 3 chars) · Ctrl-W word-del · Ctrl-U line-del · Ctrl-C quit]"

  return ly::join_vertical(vec_of_4(input_box, status, history, help)) + "\n"
end

def vec_of_4(a: String, b: String, c: String, d: String): Vec<String>
  var v = vec_new<String>()
  v.push(a)
  v.push(b)
  v.push(c)
  v.push(d)
  return v
end

def main(): Int
  var initial_input = ti::text_input_with_validator(
    ti::text_input_with_prompt(
      ti::text_input_with_placeholder(ti::text_input_new(), "your name…"),
      "Name: "
    ),
    name_validator
  )
  initial_input = ti::text_input_with_validate_on(initial_input, ti::ValidateOn::OnSubmit)

  var initial = State {
    input:   initial_input,
    history: vec_new()
  }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
