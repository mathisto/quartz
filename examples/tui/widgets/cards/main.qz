## TUI v0.3.3 step 2 — Card-style multi-row List delegate demo.
##
## A 12-card deckbuilder card browser where each card occupies 3 rows:
## name on row 0, summary on row 1, cost gutter on row 2. The list
## window shows 4 cards at a time (12 rows / 3 per card). Navigate
## with ↑↓, jump with Home/End, page with Ctrl-B/Ctrl-F, Enter to
## "play" (commits to the played list). Ctrl-C quits.
##
## v0.3.3 step 12 (2026-05-05) closed the last layer —
## tc_parse_type now stamps user-enum ptypes with the inner struct's
## name, and match-arm pattern binding recovers struct identity via
## that stamp. No `as_type` recovery anywhere — `cards: List<Card>`,
## `Selected(card)` binds card:Card, `card.name` resolves directly.

import std/tui/runtime as tui
import std/terminal
import std/tui/layout as ly
import std/tui/widgets/list as ls

struct Card
  name:    String
  cost:    Int
  summary: String
end

struct State
  cards:  List<Card>
  played: Vec<String>
  status: String
end

enum AppMsg
  Noop
end

## 3-row card render: name | indented summary | cost.
def show_card(c: Card): String
  return c.name + "\n  " + c.summary + "\n  cost: " + c.cost.to_s()
end

def make_cards(): Vec<Card>
  var v = vec_new<Card>()
  v.push(Card { name: "Strike",       cost: 1, summary: "Deal 6 damage." })
  v.push(Card { name: "Defend",       cost: 1, summary: "Gain 5 block." })
  v.push(Card { name: "Bash",         cost: 2, summary: "Deal 8 damage. Apply 2 vulnerable." })
  v.push(Card { name: "Iron Wave",    cost: 1, summary: "Deal 5 damage and gain 5 block." })
  v.push(Card { name: "Cleave",       cost: 1, summary: "Deal 8 damage to ALL enemies." })
  v.push(Card { name: "Heavy Blade",  cost: 2, summary: "Deal 14 damage." })
  v.push(Card { name: "Shrug It Off", cost: 1, summary: "Gain 8 block. Draw 1 card." })
  v.push(Card { name: "True Grit",    cost: 1, summary: "Gain 7 block." })
  v.push(Card { name: "Twin Strike",  cost: 1, summary: "Deal 5 damage twice." })
  v.push(Card { name: "Carnage",      cost: 2, summary: "Ethereal. Deal 20 damage." })
  v.push(Card { name: "Inflame",      cost: 1, summary: "Gain 2 strength." })
  v.push(Card { name: "Limit Break",  cost: 1, summary: "Double your strength. Exhaust." })
  return v
end

def _clone_played(src: Vec<String>): Vec<String>
  var out = vec_new<String>()
  var i = 0
  while i < src.size
    out.push(src[i])
    i = i + 1
  end
  return out
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      var triple = ls::list_update(s.cards, msg)
      var next = triple.0
      var ev = triple.2
      match ev
        Selected(card) =>
          var new_played = _clone_played(s.played)
          new_played.push(card.name)
          return (State {
            cards: next, played: new_played,
            status: "played: " + card.name
          }, tui::Cmd::None)
        Highlighted(_) =>
          return (State { cards: next, played: s.played, status: "" }, tui::Cmd::None)
        _ =>
          return (State { cards: next, played: s.played, status: s.status }, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  var bordered = ly::border_with(ls::list_view(s.cards, true), ly::BORDER_ROUNDED())
  var played_count = s.played.size
  var idx_str = "—"
  match ls::list_selected_index(s.cards)
    Some(i) =>
      var n = i + 1
      idx_str = "#{n}/#{ls::list_size(s.cards)}"
    None =>
      idx_str = "—"
  end
  var status_line = "card #{idx_str}  ·  played #{played_count}  ·  #{s.status}"
  var help = "[↑↓ navigate · Home/End jump · Ctrl-B/F page · Enter play · Ctrl-C quit]"
  var parts = vec_new<String>()
  parts.push(bordered)
  parts.push(status_line)
  parts.push(help)
  return ly::join_vertical(parts) + "\n"
end

def main(): Int
  var cards = ls::list_new(make_cards(), ls::item_delegate_card(show_card, 3))
  cards = ls::list_with_size(cards, 60, 12)   # 12 rows / 3 per card = 4 visible cards
  cards = ls::list_with_scrollbar(cards, true)
  cards = ls::list_with_wrap_around(cards, true)

  var initial = State { cards: cards, played: vec_new<String>(), status: "" }
  var p = tui::program_new(initial, update, view)
  return tui::program_run(p)
end
