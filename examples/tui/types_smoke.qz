# Smoke test for std/tui/runtime data types (v0.1 commit 1 of 3).
#
# Exercises the design-doc friction predictions one at a time so they
# either resolve as findings or surface as compiler bugs to file:
#
#   1. Module aliasing for type position — `tui::FrameMsg<M>`, `tui::Cmd<M>`.
#   2. Module aliasing for variant construction — `tui::Cmd::None`,
#      `tui::Cmd::Quit`, `tui::FrameMsg::App(am)`.
#   3. Module aliasing for variant patterns in match arms.
#   4. Generic enum with closure-typed variant — `tui::Cmd::Run(thunk)`.
#      Highest-information first-touch site per the design memo.
#   5. Tuple return from Fn-typed param — `update: Fn(M, S): (S, C)`.
#   6. Generic struct with Fn-typed fields — `Program<S, M>`.
#
# Returns 0 on success; nonzero exit indicates a regression and which
# branch we fell through to.
#
# v0.1 dogfood proper (counter app) ships in commit 3 once `program_run`
# lands.

import std/tui/runtime as tui

struct State
  count: Int
end

enum AppMsg
  Inc
end

# Closure thunk: tests Cmd::Run's `Fn(): FrameMsg<M>` variant payload.
def make_inc_msg(): tui::FrameMsg<AppMsg>
  return tui::FrameMsg::App(AppMsg::Inc)
end

# Tests tuple return from Fn-typed param + Maranget on aliased generic
# enum (the catch-all is a deliberate workaround for the pre-existing
# user-defined-generic-enum exhaustiveness bug — that fix is a separate
# session).
def my_update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Quit => return (s, tui::Cmd::Quit)
    _ => return (s, tui::Cmd::None)
  end
end

def my_view(s: State): String = "smoke"

def main(): Int
  # 1. Generic struct with Fn fields, default no-op recorder.
  var p = tui::program_new(State { count: 0 }, my_update, my_view)

  # 2. Generic enum + closure-typed variant payload.
  var run_cmd: tui::Cmd<AppMsg> = tui::Cmd::Run(make_inc_msg)

  # 3. Generic enum + bare no-payload variant.
  var none_cmd: tui::Cmd<AppMsg> = tui::Cmd::None

  # 4. Aliased pattern match. Catch-all (`_`) is required because Maranget
  #    exhaustiveness on user-defined generic enums is broken (separate
  #    pre-existing bug, see TUI_RUNTIME.md friction checklist).
  match run_cmd
    tui::Cmd::Run(thunk) => 0
    _ => return 1
  end

  match none_cmd
    tui::Cmd::None => 0
    _ => return 2
  end

  # 5. Use the closure variant by extracting and calling the thunk.
  match run_cmd
    tui::Cmd::Run(thunk) =>
      var msg = thunk()
      match msg
        tui::FrameMsg::App(am) => return 0
        _ => return 3
      end
    _ => return 4
  end
end
