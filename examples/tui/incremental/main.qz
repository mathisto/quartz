# TUI v0.2 incremental dogfood — keys-only idle game.
#
# Validates the v0.2 surface end-to-end:
#
#   - `Cmd::Every` driving a periodic Tick (auto-cookie-production).
#   - `Program.init` field bootstrapping the Tick clock at startup.
#   - `Cmd::After` on the upgrade-purchase path (delayed status-clear).
#   - Scope-aware teardown: Ctrl-C cancels pump + Tick + After
#     goroutines within ~50ms, no leaks across program_run boundary.
#
# Run:
#
#   rm -rf .quartz-cache
#   ./self-hosted/bin/quartz -I std -I std/tui examples/tui/incremental/main.qz > /tmp/i.ll
#   /opt/homebrew/opt/llvm/bin/llc -filetype=obj /tmp/i.ll -o /tmp/i.o
#   clang /tmp/i.o -o /tmp/incremental -lm -lpthread
#   /tmp/incremental
#
# Inside: ↑ buys an upgrade (doubles per-tick yield) when you can afford
# it; cookies tick up automatically. Ctrl-C quits. Terminal restored.

import std/tui/runtime as tui
import std/tui/layout as ly
import std/terminal

struct State
  cookies:    Int
  multiplier: Int      # cookies per tick
  status:     String   # transient message, cleared via Cmd::After
end

enum AppMsg
  Tick
  ClearStatus
end

# Tick interval — 250ms. Frequent enough to feel alive, slow enough
# to be a calm idle-game beat rather than a scrolling stutter.
def TICK_MS(): Int = 250

# Auto-clear delay for purchase status messages.
def STATUS_CLEAR_MS(): Int = 1500

# Cost formula for the next upgrade — exponential so the first few are
# cheap and the late game requires patience. Mirrors Cookie Clicker's
# `floor(base * multiplier^purchases)` shape with base=10, growth=4x.
def upgrade_cost(mult: Int): Int = 10 * mult

def tick_thunk(): tui::FrameMsg<AppMsg> =
  tui::FrameMsg::App(AppMsg::Tick)

def clear_status_thunk(): tui::FrameMsg<AppMsg> =
  tui::FrameMsg::App(AppMsg::ClearStatus)

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_UP()
        var cost = upgrade_cost(s.multiplier)
        if s.cookies >= cost
          var next = State {
            cookies: s.cookies - cost,
            multiplier: s.multiplier * 2,
            status: "🍪 upgrade purchased — yield doubled"
          }
          return (next, tui::Cmd::After(STATUS_CLEAR_MS(), clear_status_thunk))
        end
        var notify = State {
          cookies: s.cookies,
          multiplier: s.multiplier,
          status: "✗ need #{cost} cookies — keep waiting"
        }
        return (notify, tui::Cmd::After(STATUS_CLEAR_MS(), clear_status_thunk))
      end
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      return (s, tui::Cmd::None)
    tui::FrameMsg::App(am) =>
      match am
        AppMsg::Tick =>
          var next = State {
            cookies: s.cookies + s.multiplier,
            multiplier: s.multiplier,
            status: s.status
          }
          return (next, tui::Cmd::None)
        AppMsg::ClearStatus =>
          var cleared = State {
            cookies: s.cookies,
            multiplier: s.multiplier,
            status: ""
          }
          return (cleared, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String
  # HUD panel — stats in a rounded box. Padded 1 cell horizontally
  # so content doesn't kiss the border. Note: layout uses bare \n;
  # the runtime translates to \r\n at write time (v0.3 L.0).
  var hud_body = ly::pad_horizontal(
    "Cookies: #{s.cookies}\nYield: #{s.multiplier}/tick\nNext upgrade: #{upgrade_cost(s.multiplier)}",
    1
  )
  var hud = ly::border_with(hud_body, ly::BORDER_ROUNDED())

  # Status panel — only rendered when there's a transient message.
  # Joined horizontally next to the HUD when present. Shows the
  # join_horizontal API working with two multi-line bordered blocks
  # of different heights.
  var top = hud
  if str_byte_len(s.status) > 0
    var status_panel = ly::border_with(
      ly::pad_horizontal(s.status, 1),
      ly::BORDER_ROUNDED()
    )
    var parts = vec_new()
    parts.push(hud)
    parts.push("  ")          # 2-col gutter between panels
    parts.push(status_panel)
    top = ly::join_horizontal(parts)
  end

  # Plain string concat for the help line — using join_vertical here
  # would left-align the panel rows to the help's width and trail
  # whitespace past the border. The panel-stacking case above is
  # where join_vertical is the right tool (keeps the column rectangle
  # uniform); here we just want a separator line under the panels.
  var help = "[↑ buy upgrade · Ctrl-C quit]"
  return top + "\n" + help + "\n"
end

def main(): Int
  var initial = State {
    cookies: 0,
    multiplier: 1,
    status: ""
  }
  var p = tui::program_new(initial, update, view)
  p = tui::program_with_init(p, tui::Cmd::Every(TICK_MS(), tick_thunk))
  return tui::program_run(p)
end
