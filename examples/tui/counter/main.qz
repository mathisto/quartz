# TUI v0.1 canonical counter dogfood.
#
# This is the "if writing this feels bad, the design is wrong" reference
# (docs/design/TUI_RUNTIME.md) — the smallest non-trivial TEA app that
# exercises the full v0.1 surface: pure update with nested message
# matching, view as a single endless-def String, two paths to mutate
# state (raw arrow keys via Key, semantic-app messages via App), clean
# Ctrl-C quit.
#
# Run:
#
#   ./self-hosted/bin/quartz -I std -I std/tui examples/tui/counter/main.qz > /tmp/c.ll
#   /opt/homebrew/opt/llvm/bin/llc -filetype=obj /tmp/c.ll -o /tmp/c.o
#   clang /tmp/c.o -o /tmp/counter -lm -lpthread
#   /tmp/counter
#
# Inside: ↑/↓ change count, Ctrl-C to quit. Terminal restored on exit.

import std/tui/runtime as tui
import std/terminal

struct State
  count: Int
end

enum AppMsg
  Inc
  Dec
end

def update(msg: tui::FrameMsg<AppMsg>, s: State): (State, tui::Cmd<AppMsg>)
  match msg
    tui::FrameMsg::Key(k) =>
      if k.code == terminal::KEY_UP()
        return (State { count: s.count + 1 }, tui::Cmd::None)
      end
      if k.code == terminal::KEY_DOWN()
        return (State { count: s.count - 1 }, tui::Cmd::None)
      end
      if k.code == terminal::KEY_CTRL_C()
        return (s, tui::Cmd::Quit)
      end
      return (s, tui::Cmd::None)
    tui::FrameMsg::App(am) =>
      match am
        AppMsg::Inc => return (State { count: s.count + 1 }, tui::Cmd::None)
        AppMsg::Dec => return (State { count: s.count - 1 }, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def view(s: State): String =
  "Count: #{s.count}\r\n[↑/↓ to change · Ctrl-C to quit]\r\n"

def main(): Int
  return tui::program_run(tui::program_new(State { count: 0 }, update, view))
end
