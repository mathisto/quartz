##! Collections - Vec, HashMap, Set, and iteration patterns
##!
##! Demonstrates: Vec operations, HashMap, Set, UFCS methods,
##! sorting, and common collection idioms.

def print_vec(label: String, v: Vec<Int>): Void
  print("  #{label}: [")
  for i in 0..v.size
    if i > 0
      print(", ")
    end
    val = v.get(i)
    print("#{val}")
  end
  puts("]")
end

## Bubble sort in-place.
def sort_vec(v: Vec<Int>): Void
  n = v.size
  var i = 0
  while i < n
    var j = 0
    while j < n - i - 1
      a = v.get(j)
      b = v.get(j + 1)
      if a > b
        v.set(j, b)
        v.set(j + 1, a)
      end
      j += 1
    end
    i += 1
  end
end

def main(): Int
  puts("=== Collections ===")
  puts("")
  puts("Vectors:")
  v = vec_new()
  v.push(10)
  v.push(30)
  v.push(20)
  v.push(50)
  v.push(40)
  print_vec("original", v)
  sort_vec(v)
  print_vec("sorted", v)
  puts("  size=#{v.size}")
  puts("")
  puts("Array literal:")
  arr = [5, 3, 1, 4, 2]
  sort_vec(arr)
  print_vec("sorted", arr)
  puts("")
  puts("Map:")
  m = map_new()
  m.set("alice", 95)
  m.set("bob", 87)
  m.set("charlie", 92)
  alice_score = m.get("alice")
  has_charlie = m.has("charlie")
  has_eve = m.has("eve")
  puts("  alice=#{alice_score}")
  puts("  has charlie=#{has_charlie}")
  puts("  has eve=#{has_eve}")
  puts("  size=#{m.size}")
  m.delete("bob")
  puts("  after delete bob: size=#{m.size}")
  puts("")
  puts("Sets:")
  s = set_new()
  s.add(10)
  s.add(20)
  s.add(30)
  s.add(20)
  puts("  added 10,20,30,20 -> size=#{s.size}")
  puts("  has(20)=#{s.has(20)}")
  puts("  has(99)=#{s.has(99)}")
  s.delete(20)
  puts("  delete(20) -> size=#{s.size}")
  vec_free(v)
  map_free(m)
  return 0
end
