# Phase 5e+++ — std/net/tcp high-level API on Windows
#
# Proves that std/net/tcp's ergonomic API (tcp_listen / tcp_connect /
# tcp_accept / tcp_close) compiles and links on Windows after the
# cross-platform refactor — the call sites that used to be POSIX-only
# (close/fcntl/get_errno) now dispatch through std/ffi/socket's
# socket_close / socket_set_nonblock / socket_last_error helpers, which
# @cfg internally to Windows's closesocket / ioctlsocket / WSAGetLastError.
#
# Cross-compile from Darwin:
#   SRC=examples/windows/tcp_listen_smoke.qz ./self-hosted/bin/quake xbuild:windows
#
# Run on Windows:
#   C:\tmp>tcp_listen_smoke.exe
#
# Expected output (native macOS/Linux AND Windows):
#   tcp_listen_smoke: starting
#   tcp_listen_smoke: listening on port <ephemeral>
#   tcp_listen_smoke: closed
#   tcp_listen_smoke: done
#
# Compared to socket_smoke (raw FFI) and tcp_echo_smoke (raw FFI + 2-process
# transport), this one drives the HIGH-LEVEL Quartz API end-to-end —
# valuable because it's how real Quartz programs (and the http_server
# stack on top) use sockets.

import * from std/net/tcp

def main(): Int
  puts("tcp_listen_smoke: starting")
  match tcp_listen(0)
    ListenResult::Err(e) => {
      puts("tcp_listen_smoke: listen FAILED")
      return 1
    }
    ListenResult::Ok(server) => {
      puts("tcp_listen_smoke: listening on port #{server.port}")
      tcp_close_listener(server)
      puts("tcp_listen_smoke: closed")
    }
  end
  puts("tcp_listen_smoke: done")
  return 0
end
