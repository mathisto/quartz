# Phase 5e+++++ — cross-platform tcp_connect_timeout on Windows
#
# Drives tcp_connect_timeout (formerly POSIX-only) via the new cross-
# platform helpers: socket_set_nonblock / socket_wait_one / socket_set_blocking
# / socket_last_error / POLLOUT — all dispatching internally via @cfg.
#
# Cross-compile from Darwin:
#   SRC=examples/windows/tcp_connect_timeout_smoke.qz \
#     ./self-hosted/bin/quake xbuild:windows
#
# Run on Windows (no network needed — TEST-NET is unreachable by design):
#   C:\tmp>tcp_connect_timeout_smoke.exe
#
# Expected (any host):
#   tcp_connect_timeout_smoke: starting
#   tcp_connect_timeout_smoke: connecting to TEST-NET 192.0.2.1:65530 (timeout 500ms)
#   tcp_connect_timeout_smoke: err (expected): Connection timed out
#   tcp_connect_timeout_smoke: done
#
# What this exercises on Windows:
#   - socket() → connect() with non-blocking flag set via ioctlsocket(FIONBIO)
#   - The connect returns WSAEWOULDBLOCK (10035), matched against EWOULDBLOCK
#     alias on Windows (= 10035)
#   - WSAPoll on WSAPOLLFD (16 bytes, SOCKET fd at offset 0, events at 8)
#     blocks for the 500ms window
#   - Timeout returns wait_result=0 → "Connection timed out" branch
#   - closesocket() on cleanup

import * from std/net/tcp

def main(): Int
  puts("tcp_connect_timeout_smoke: starting")
  puts("tcp_connect_timeout_smoke: connecting to TEST-NET 192.0.2.1:65530 (timeout 500ms)")
  match tcp_connect_timeout("192.0.2.1", 65530, 500)
    TcpResult::Err(e) => {
      puts("tcp_connect_timeout_smoke: err (expected): #{e.message}")
    }
    TcpResult::Ok(s) => {
      puts("tcp_connect_timeout_smoke: connected UNEXPECTEDLY — test invalid")
      tcp_close(s)
      return 1
    }
  end
  puts("tcp_connect_timeout_smoke: done")
  return 0
end
