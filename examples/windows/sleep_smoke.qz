## Phase 5c acceptance probe — Quartz `sched_sleep` on Windows IOCP.
##
## Spawns a worker that sleeps three times in quick succession, then `await`s
## the result. End-to-end this exercises:
##  - __qz_sched_register_timer Windows branch: deadline_ns push into
##    @__qz_timer_heap under heap.mutex; sentinel side-table set;
##    __qz_sched_wake_poller() nudges GQCSEx to re-pick its timeout
##  - __qz_sched_io_poller drain loop: __qz_timer_heap_drain_one pops
##    expired roots; __qz_task_timer_take clears the side-table; the
##    re-enqueue path is identical to the POSIX kqueue/timerfd path
##  - __qz_timer_heap_next_expiry_ms feeds GQCSEx's DWORD wait timeout
##  - Sift-up + sift-down (concurrent sleeps in pop_count=3 order)
##  - Total elapsed time is at least 30 ms (3 × 10 ms sleeps).
##
## On native macOS/Linux: identical visible output (POSIX kqueue/timerfd
## path takes the original branch; @__qz_timer_heap stays zeroed). On
## Windows .exe: same expected output, with the timer-heap branch active.

import * from time

def worker(): Int
  puts("worker: start")
  sched_sleep(10)
  puts("worker: tick 1")
  sched_sleep(10)
  puts("worker: tick 2")
  sched_sleep(10)
  puts("worker: tick 3")
  return 0
end

def main(): Int
  var t0 = time_mono_ns()
  var w = go worker()
  await w
  var elapsed_ns = time_mono_ns() - t0
  var elapsed_ms = elapsed_ns / 1000000
  if elapsed_ms >= 28
    puts("main: elapsed ok (>= 28 ms)")
  else
    puts("main: elapsed TOO SHORT")
  end
  puts("main: joined")
  return 0
end
