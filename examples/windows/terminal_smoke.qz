# TUI host on Windows — std/terminal.qz Win32 console backend
#
# Proves that std/terminal.qz's public surface compiles and links on
# Windows after the Win32-console backend landed (raw mode via
# Get/SetConsoleMode, terminal dimensions via
# GetConsoleScreenBufferInfo, non-blocking peek via
# PeekConsoleInputW + ReadConsoleInputW). The POSIX termios path
# previously made this module fail to link on Windows; the
# @cfg-gated Windows branches in std/terminal.qz unblock TUI apps
# (paperclips-tui, hyperdrive-tui, future).
#
# Cross-compile from Darwin:
#   SRC=examples/windows/terminal_smoke.qz ./self-hosted/bin/quake xbuild:windows
#
# Run on Windows (under Windows Terminal or any conhost ≥ Win10 1809):
#   C:\tmp>terminal_smoke.exe
#
# Expected output:
#   terminal_smoke: starting
#   terminal_smoke: tty=<0|1>
#   terminal_smoke: width=<cols> height=<rows>
#   terminal_smoke: color_depth=<0|16|256|16777216>
#   terminal_smoke: unicode=<0|1>
#   terminal_smoke: entered raw mode
#   terminal_smoke: exited raw mode
#   terminal_smoke: done
#
# The smoke does NOT block on input — running it under CI / redirected
# stdin (`echo | terminal_smoke.exe`) finishes immediately. Interactive
# verification (a real keystroke) is left to a paired
# `terminal_smoke_interactive.exe` in a follow-up.

import * from std/terminal

def main(): Int
  puts("terminal_smoke: starting")

  var is_tty_int = 0
  if term_is_tty()
    is_tty_int = 1
  end
  puts("terminal_smoke: tty=#{is_tty_int}")

  var w = term_get_width()
  var h = term_get_height()
  puts("terminal_smoke: width=#{w} height=#{h}")

  var cd = term_color_depth()
  puts("terminal_smoke: color_depth=#{cd}")

  var uc_int = 0
  if term_supports_unicode()
    uc_int = 1
  end
  puts("terminal_smoke: unicode=#{uc_int}")

  # Raw mode only makes sense on a real TTY. Under redirected stdin
  # (the CI / smoke shape), GetConsoleMode on the stdin handle would
  # return 0 because the handle is a pipe/file, not a console — the
  # impl returns 0 in that case. Treat 0 as expected under redirect.
  if term_is_tty()
    var rc = term_enter_raw_mode()
    puts("terminal_smoke: entered raw mode rc=#{rc}")
    term_exit_raw_mode()
    puts("terminal_smoke: exited raw mode")
  end

  puts("terminal_smoke: done")
  return 0
end
