# Phase 5e++++ — async TCP on Windows (compile-only smoke)
#
# Proves the FULL async TCP stack compiles for Windows: std/net/tcp's
# high-level API + the `go fn()` scheduler + async_tcp_accept + io_suspend
# integrating with the AFD.SYS substrate from Phase 5e.
#
# Why compile-only? Verifying end-to-end on a Windows host requires a
# second cmd window with a client (could use tcp_echo_smoke.exe as the
# client). This probe's value is link-surface verification: if every
# expected symbol from BOTH the ws2_32 user FFI AND the AFD.SYS
# scheduler substrate lands in one binary, the async-TCP-on-Windows
# story is wired end-to-end.
#
# Cross-compile from Darwin:
#   SRC=examples/windows/tcp_serve_smoke.qz ./self-hosted/bin/quake xbuild:windows
#
# Inspect imports — expect BOTH sets:
#   ws2_32.dll: WSAStartup + socket + bind + listen + setsockopt +
#               closesocket + ioctlsocket + accept + recv + WSAIoctl
#   ntdll.dll:  NtCreateFile + NtDeviceIoControlFile + NtClose
#   kernel32.dll: CreateIoCompletionPort + GetQueuedCompletionStatusEx +
#                 PostQueuedCompletionStatus +
#                 SetFileCompletionNotificationModes + CreateThread +
#                 WaitForSingleObject
#
# Native macOS or Linux: same code path, exercises the kqueue/epoll
# scheduler. Can be runtime-confirmed by spawning tcp_echo_smoke as a
# client against this server.

import * from std/net/tcp
import * from std/ffi/socket

# Per-connection handler. Reads one byte from the non-blocking client
# fd via async_tcp_read; suspends via io_suspend → __qz_sched_register_io
# → (Linux: epoll_ctl / macOS: kevent / Windows: AFD.SYS IOCTL_AFD_POLL)
# until the byte is readable; then echoes it back and closes.
def echo_one(client_fd: Int): Int
  var buf = mem_alloc(1)
  var n = async_tcp_read(client_fd, buf, 1)
  if n == 1
    async_tcp_write(client_fd, buf, 1)
  end
  qz_free(buf)
  socket_close(client_fd)
  return 0
end

def main(): Int
  puts("tcp_serve_smoke: starting")
  # tcp_serve installs sched_init + sched_spawn around a tcp_listen.
  # Each accepted fd is set non-blocking and the handler runs as a
  # go fn() worker — so io_suspend inside echo_one parks the task on
  # the AFD.SYS substrate (Windows) / kqueue (macOS) / epoll (Linux).
  var rc = tcp_serve(0, echo_one)
  puts("tcp_serve_smoke: returned rc=#{rc}")
  return rc
end
