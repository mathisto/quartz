# diagnostics.qz — exercises every Windows-specific runtime helper that
# landed in Phase 4 (commit 4f7204b5). The same source compiles+runs on
# macOS / Linux / Windows; on Windows it routes through:
#
#   - GetFileAttributesEx           (qz_file_size + qz_file_mtime)
#   - QueryPerformanceCounter       (__qz_time_mono_ns)
#   - BCryptGenRandom               (qz_crypto_rand_int)
#   - K32GetProcessMemoryInfo       (__qz_mem_peak_rss)
#
# Cross-build from Darwin:
#   cd <repo> && ./self-hosted/bin/quartz \
#     --target=x86_64-pc-windows-gnu examples/windows/diagnostics.qz \
#     > examples/windows/diagnostics.ll
#   llc examples/windows/diagnostics.ll -filetype=obj -o examples/windows/diagnostics.o
#   zig cc -target x86_64-windows-gnu examples/windows/diagnostics.o \
#     -o examples/windows/diagnostics.exe -lbcrypt
#
# Or simply:
#   quake xbuild:windows  # produces tmp/xbuild-windows/hello.exe (smaller demo)
#
# This program is the "ground truth" hand-off probe: if any of the five
# Phase-4 helpers misbehaves on a real Windows machine, the corresponding
# line in the output will read wrong (negative size, wildly-wrong mtime,
# zero peak RSS, deterministic-looking random, monotonically-decreasing
# clock). All four checks below are unit-tests-in-output for the helpers.

import * from std/random

def main(): Int
  puts("Quartz on Windows — Phase 4 helper diagnostics")
  puts("==============================================")
  puts("")

  # ---------------------------------------------------------------------------
  # 1. GetFileAttributesEx → qz_file_size / qz_file_mtime
  # ---------------------------------------------------------------------------
  # The path here is the source we compiled from — at runtime it's only
  # meaningful if the user runs the .exe from a checkout that still has the
  # file in the same location. If the file isn't there (running from an
  # arbitrary cwd on a Windows host), both calls return -1, which is itself
  # the diagnostic — confirms the API was wired, just couldn't resolve.
  var self_src = "examples/windows/diagnostics.qz"
  var sz = file_size(self_src)
  var mt = file_mtime(self_src)
  puts("[1] file metadata (GetFileAttributesEx on Windows)")
  puts("    path  : #{self_src}")
  if sz >= 0
    puts("    size  : #{sz.to_s()} bytes")
  else
    puts("    size  : -1 (file not at this relative path — re-run from checkout)")
  end
  if mt >= 0
    puts("    mtime : #{mt.to_s()} (unix epoch seconds)")
  else
    puts("    mtime : -1 (file not at this relative path — re-run from checkout)")
  end
  puts("")

  # ---------------------------------------------------------------------------
  # 2. QueryPerformanceCounter → time_mono_ns
  # ---------------------------------------------------------------------------
  # Two reads back-to-back: the second must be ≥ first (monotonic), and
  # the delta is non-negative. The print also lets the user eyeball whether
  # the absolute scale is plausibly nanoseconds (10-12 digits for a
  # recently-booted system).
  var t0 = time_mono_ns()
  # A bit of busywork to ensure t1 > t0 by a measurable margin
  var sum = 0
  var i = 0
  while i < 100000
    sum = sum + i
    i = i + 1
  end
  var t1 = time_mono_ns()
  var delta = t1 - t0
  puts("[2] monotonic clock (QueryPerformanceCounter on Windows)")
  puts("    t0    : #{t0.to_s()} ns")
  puts("    t1    : #{t1.to_s()} ns")
  puts("    delta : #{delta.to_s()} ns over a 100k-iter loop (sum=#{sum.to_s()})")
  if delta < 0
    puts("    !! delta is NEGATIVE — clock is not monotonic (BUG)")
  end
  puts("")

  # ---------------------------------------------------------------------------
  # 3. BCryptGenRandom → crypto_rand_int (via the seeded RNG default path)
  # ---------------------------------------------------------------------------
  # Pull three crypto-random Ints. They must differ from each other and
  # from any deterministic stand-in (e.g. 0, 1, -1). Pre-Phase-4 the
  # underlying qz_crypto_rand_int trapped via @abort on Windows — reaching
  # this line at all is the smoke test.
  var r0 = crypto_rand_int()
  var r1 = crypto_rand_int()
  var r2 = crypto_rand_int()
  puts("[3] crypto-secure random (BCryptGenRandom on Windows)")
  puts("    r0    : #{r0.to_s()}")
  puts("    r1    : #{r1.to_s()}")
  puts("    r2    : #{r2.to_s()}")
  if r0 == r1 or r1 == r2 or r0 == r2
    puts("    !! at least two reads collided — entropy is degenerate (BUG)")
  end
  puts("")

  # ---------------------------------------------------------------------------
  # 4. K32GetProcessMemoryInfo → mem_peak_rss
  # ---------------------------------------------------------------------------
  # The exact value is platform-dependent (Windows reports working-set in
  # bytes; Linux/getrusage on Linux reports KB; macOS bytes). The check
  # here is just "non-zero on Windows" — pre-Phase-4 the helper returned 0
  # unconditionally, so any positive number is the smoke test.
  var rss = mem_peak_rss()
  puts("[4] peak resident set size (K32GetProcessMemoryInfo on Windows)")
  puts("    rss   : #{rss.to_s()} (raw — platform-specific units)")
  if rss == 0
    puts("    note  : 0 on macOS/Linux is harmless; on Windows it would")
    puts("            indicate the helper failed and we'd want to investigate.")
  end
  puts("")

  puts("All four helpers reached without trap — Phase 4 acceptance ✓")
  return 0
end
