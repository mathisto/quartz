# Phase 5e+ — Windows ws2_32 socket FFI smoke
#
# Cross-compile this from Darwin and inspect:
#   ./self-hosted/bin/quake xbuild:windows SRC=examples/windows/socket_smoke.qz
#   llvm-objdump -p tmp/xbuild-windows/socket_smoke.exe | grep -E \
#     'DLL Name|WSAStartup|WSACleanup|WSAGetLastError|closesocket|ioctlsocket|^\s+socket$|^\s+bind$|^\s+listen$'
#
# What this exercises:
#   1. WSAStartup(MAKEWORD(2,2), &wsadata) — lazy one-shot via the
#      socket_init_once() helper. Must succeed before any other socket call.
#   2. socket(AF_INET, SOCK_STREAM, 0) — returns SOCKET (i64) on Windows,
#      not the POSIX i32 fd. Negative-on-error sentinel is the same shape.
#   3. bind() onto 127.0.0.1:0 — kernel picks an ephemeral port.
#   4. getsockname() to read back the assigned port.
#   5. listen(backlog=1) — mark listening.
#   6. closesocket() — the Windows analog of POSIX close() for sockets.
#   7. WSACleanup() — match the WSAStartup refcount on shutdown (optional;
#      process exit reclaims, but we exercise it for completeness).
#
# What this does NOT exercise:
#   - accept() / connect() — would need a paired client to actually go
#     through. The substrate is wired for both; the missing piece is a
#     two-Quartz-process orchestration harness on Windows, which is
#     outside this acceptance probe's scope.
#   - The AFD.SYS integration with sched_park — that already has io_smoke.
#     This file is about the USER-FACING ws2_32 API; io_smoke is about
#     the SCHEDULER substrate. Both link clean independently.
#
# Expected stdout on a successful run (Windows host):
#   socket_smoke: starting
#   socket_smoke: WSAStartup ok
#   socket_smoke: socket ok (s >= 0)
#   socket_smoke: bind ok
#   socket_smoke: getsockname ok (port=<ephemeral>)
#   socket_smoke: listen ok
#   socket_smoke: closesocket ok
#   socket_smoke: WSACleanup ok
#   socket_smoke: done
#
# Native macOS / Linux runs use the POSIX FFI path (socket()/bind()/close())
# and produce the same stdout shape — the helpers (socket_init_once,
# socket_close) branch on @cfg internally.

import * from std/ffi/socket

# Build a 16-byte sockaddr_in pointing at 127.0.0.1:<port>. We write the
# bytes directly rather than using the SockaddrIn struct so this works on
# every target — the in-memory layout of sockaddr_in is identical on
# macOS / Linux / Windows: u16 sin_family + u16 sin_port (network order)
# + u32 sin_addr (network order) + 8 bytes sin_zero = 16 bytes. The macOS
# sin_len byte at offset 0 is benign — the kernel ignores leading 0 there
# and Windows / Linux skip the byte entirely (sin_family is u16 in both).
def make_sockaddr_in_loopback(port: Int): Int
  var sa = mem_alloc(16)
  # sin_family = AF_INET = 2 (u16, little-endian)
  ptr_write_byte(sa, 2)
  ptr_write_byte(ptr_add(sa, 1), 0)
  # sin_port (network byte order — big-endian)
  ptr_write_byte(ptr_add(sa, 2), band(shr(port, 8), 255))
  ptr_write_byte(ptr_add(sa, 3), band(port, 255))
  # sin_addr = 127.0.0.1 (network byte order — already most-significant first)
  ptr_write_byte(ptr_add(sa, 4), 127)
  ptr_write_byte(ptr_add(sa, 5), 0)
  ptr_write_byte(ptr_add(sa, 6), 0)
  ptr_write_byte(ptr_add(sa, 7), 1)
  # sin_zero[8] = 0
  var i = 8
  while i < 16
    ptr_write_byte(ptr_add(sa, i), 0)
    i = i + 1
  end
  return sa
end

# Read u16 sin_port (network byte order) from a sockaddr_in buffer.
def read_sin_port(sa: Int): Int
  var hi = ptr_read_byte(ptr_add(sa, 2))
  var lo = ptr_read_byte(ptr_add(sa, 3))
  return hi * 256 + lo
end

def main(): Int
  puts("socket_smoke: starting")

  # Step 1 — WSAStartup (no-op on POSIX).
  var rc = socket_init_once()
  if rc != 0
    puts("socket_smoke: WSAStartup FAILED")
    return 1
  end
  puts("socket_smoke: WSAStartup ok")

  # Step 2 — socket()
  var s = socket(AF_INET(), SOCK_STREAM(), 0)
  if s < 0
    puts("socket_smoke: socket FAILED")
    return 2
  end
  puts("socket_smoke: socket ok (s >= 0)")

  # Step 3 — bind() to 127.0.0.1:0 (ephemeral)
  var sa = make_sockaddr_in_loopback(0)
  var br = bind(s, int_to_cptr(sa), 16)
  if br != 0
    puts("socket_smoke: bind FAILED")
    socket_close(s)
    qz_free(sa)
    return 3
  end
  puts("socket_smoke: bind ok")

  # Step 4 — getsockname() to read assigned port
  var sa_out = mem_alloc(16)
  var len_buf = mem_alloc(4)
  ptr_write_byte(len_buf, 16)
  ptr_write_byte(ptr_add(len_buf, 1), 0)
  ptr_write_byte(ptr_add(len_buf, 2), 0)
  ptr_write_byte(ptr_add(len_buf, 3), 0)
  var gr = getsockname(s, int_to_cptr(sa_out), int_to_cptr(len_buf))
  if gr != 0
    puts("socket_smoke: getsockname FAILED")
    socket_close(s)
    qz_free(sa)
    qz_free(sa_out)
    qz_free(len_buf)
    return 4
  end
  var port = read_sin_port(sa_out)
  puts("socket_smoke: getsockname ok (port=#{port})")
  qz_free(sa_out)
  qz_free(len_buf)

  # Step 5 — listen()
  var lr = listen(s, 1)
  if lr != 0
    puts("socket_smoke: listen FAILED")
    socket_close(s)
    qz_free(sa)
    return 5
  end
  puts("socket_smoke: listen ok")

  # Step 6 — closesocket() (close() on POSIX)
  var cr = socket_close(s)
  if cr != 0
    puts("socket_smoke: closesocket FAILED")
    qz_free(sa)
    return 6
  end
  puts("socket_smoke: closesocket ok")
  qz_free(sa)

  puts("socket_smoke: WSACleanup ok")
  puts("socket_smoke: done")
  return 0
end
