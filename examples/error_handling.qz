##! Error Handling - Option, Result, and match-based error handling
##!
##! Demonstrates: custom Option/Result enums, match-based error handling,
##! composing fallible operations, unwrap-with-default.

enum Opt
  Some(value: Int)
  None
end

enum Res
  Ok(value: Int)
  Err(msg: String)
end

def safe_div(a: Int, b: Int): Opt
  if b == 0
    return Opt::None
  end
  return Opt::Some(a / b)
end

def opt_or(opt: Opt, fallback: Int): Int
  match opt
    Opt::Some(v) => v
    Opt::None => fallback
  end
end

def parse_int_str(s: String): Res
  if str_size(s) == 0
    return Res::Err("empty")
  end
  var result = 0
  for i in 0..str_size(s)
    c = str_char_at(s, i)
    if c < 48 or c > 57
      return Res::Err("invalid char")
    end
    result = result * 10 + (c - 48)
  end
  return Res::Ok(result)
end

def validate(n: Int, lo: Int, hi: Int): Res
  if n < lo
    return Res::Err("too small")
  end
  if n > hi
    return Res::Err("too large")
  end
  return Res::Ok(n)
end

def parse_validate(s: String, lo: Int, hi: Int): Res
  match parse_int_str(s)
    Res::Ok(n) => validate(n, lo, hi)
    Res::Err(e) => Res::Err("parse: #{e}")
  end
end

def show_res(r: Res): String
  match r
    Res::Ok(v) => "Ok(#{v})"
    Res::Err(e) => "Err(#{e})"
  end
end

def show_opt(o: Opt): String
  match o
    Opt::Some(v) => "Some(#{v})"
    Opt::None => "None"
  end
end

def main(): Int
  puts("=== Error Handling ===")
  puts("10/3 = #{show_opt(safe_div(10, 3))}")
  puts("10/0 = #{show_opt(safe_div(10, 0))}")
  puts("or(10/3,-1) = #{opt_or(safe_div(10, 3), -1)}")
  puts("or(10/0,-1) = #{opt_or(safe_div(10, 0), -1)}")
  puts("")
  r1 = show_res(parse_int_str("42"))
  r2 = show_res(parse_int_str("abc"))
  r3 = show_res(parse_int_str(""))
  puts("parse('42') = #{r1}")
  puts("parse('abc') = #{r2}")
  puts("parse('') = #{r3}")
  puts("")
  v1 = show_res(parse_validate("5", 1, 10))
  v2 = show_res(parse_validate("42", 1, 10))
  v3 = show_res(parse_validate("abc", 1, 10))
  puts("validate('5',1..10) = #{v1}")
  puts("validate('42',1..10) = #{v2}")
  puts("validate('abc',1..10) = #{v3}")
  puts("")
  match parse_validate("7", 1, 10)
    Res::Ok(n) => puts("Success: #{n}")
    Res::Err(e) => puts("Failure: #{e}")
  end
  match parse_validate("999", 1, 10)
    Res::Ok(n) => puts("Success: #{n}")
    Res::Err(e) => puts("Failure: #{e}")
  end
  return 0
end
