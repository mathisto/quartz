##! Brainfuck Interpreter — Quartz Compiler Smoke Test
##!
##! PURPOSE: Validates compiler correctness beyond fixpoint self-consistency.
##! A subtly broken compiler can produce byte-identical IR that recompiles
##! itself perfectly — but generates wrong code for real programs. This
##! interpreter exercises 35+ language features across the full compiler
##! pipeline (lexer → parser → typecheck → MIR → codegen).
##!
##! This program is compiled and run after every `quake guard` to catch
##! semantic regressions that fixpoint cannot detect.
##!
##! FEATURE MANIFEST (what this file exercises):
##!
##!   Definitions:  endless def, default arguments, block functions
##!   Types:        struct, enum w/payloads, tuples, Vec, Map, StringBuilder
##!   OOP:          impl blocks, @field shorthand, struct literal construction
##!   Control:      match (char literal arms + enum payload arms + wildcard),
##!                 if/elsif/else, while, for..in (range + Vec), break,
##!                 unless, postfix guard (if + unless)
##!   Functions:    UFCS method calls, first-class functions (arrow lambda),
##!                 trailing blocks (do..end), implicit `it` parameter
##!   Sugar:        compound assignment (+=, -=), string interpolation,
##!                 list comprehension, defer (LIFO cleanup), Option predicates (.some?/.none?),
##!                 negative indexing, numeric underscore literals
##!   Collections:  Vec (create/push/pop/index/size/free), Map (create/set/
##!                 get/free), StringBuilder (new/append_char/to_string/free)
##!   HOF:          .each(), .reduce() with do..end block
##!   Options:      .unwrap(), .empty? predicate
##!   Memory:       manual resource management via defer
##!
##! FEATURES NOT COVERED HERE (see examples/expr_eval.qz):
##!   generics, traits, bounded generics, closures capturing outer state,
##!   extend blocks, @derive, @value structs, type aliases, newtypes,
##!   generators/yield, regex, pipeline operator, multi-clause functions,
##!   const/static_assert, macros ($try/$assert), labeled loops, spread,
##!   map comprehensions, named arguments, bitwise operators, or-patterns,
##!   range patterns, pattern binding in conditionals, safe navigation (?.)

## ──────────────────────────────────────────────────────────────────────
## FEATURE: Enum with payloads (two variants, different arity)
## Exercises: enum definition, multi-field payloads, variant constructors
## Pipeline:  parser (enum syntax) → typecheck (payload types) →
##            MIR (tag+payload layout) → codegen (tagged union IR)
## ──────────────────────────────────────────────────────────────────────

enum BfResult
  Pass(name: String, steps: Int)
  Fail(msg: String)
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: Struct definition, struct literal construction
## Exercises: struct with multiple typed fields, field access via dot syntax
## Pipeline:  parser (struct syntax) → typecheck (field registry) →
##            codegen (malloc + field offset stores)
## ──────────────────────────────────────────────────────────────────────

struct TestCase
  name: String
  program: String
  expected: String
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: impl block, @field shorthand, endless def (single-expression)
## Exercises: impl method dispatch, @field → self.field rewrite,
##            single-expression function body, string interpolation in
##            endless def
## Pipeline:  parser (impl block) → typecheck (self param injection,
##            @field desugar) → codegen (mangled method name)
## ──────────────────────────────────────────────────────────────────────

extend TestCase
  def describe(): String
    return "Test: #{@name}"
  end
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: match expression on integers (char literal arms), unless,
##           defer (resource cleanup), for..in range, Vec push/pop,
##           Option .unwrap(), .empty? predicate, string interpolation,
##           UFCS method calls, wildcard match arm
## Exercises: match codegen (jump table or if-chain), character literal
##            constants, unless (inverted if), defer registration + LIFO
##            execution, range iteration desugaring, Vec UFCS rewrite,
##            Option tag check + payload extract
## Pipeline:  parser (match/unless/defer/for..in) → typecheck (arm types,
##            Option tracking) → MIR (match lowering, defer blocks) →
##            codegen (branch/phi, defer cleanup emission)
## ──────────────────────────────────────────────────────────────────────

## Build a bidirectional jump table mapping '[' ↔ ']' positions.
## Uses a stack-based bracket-pairing algorithm.
def build_jump_table(program: String): Int
  var table = map_new()
  var stack = vec_new()

  ## FEATURE: defer — vec_free runs at function exit regardless of path.
  ## Validates LIFO defer ordering + cleanup on normal return.
  defer vec_free(stack)

  ## FEATURE: for..in range iteration (0..N exclusive upper bound)
  for i in 0..program.size()
    ch = str_char_at(program, i)

    ## FEATURE: match on integer values using character literal arms.
    ## Character literals ('['  ']') compile to their ASCII integer codes.
    ## The wildcard arm (_) ignores all non-bracket characters.
    match ch
      '[' => {
        ## FEATURE: UFCS — stack.push(i) rewrites to vec_push(stack, i)
        stack.push(i)
      }
      ']' => {
        ## FEATURE: unless — inverted conditional (executes when false)
        ## FEATURE: .empty? — predicate method (? suffix) on Vec
        unless stack.empty?
          ## FEATURE: Option .unwrap() — extract value from Some(x)
          open_pos = stack.pop().unwrap()
          ## FEATURE: string interpolation — "#{expr}" in map keys
          table.set("#{open_pos}", i)
          table.set("#{i}", open_pos)
        end
      }
      _ => {}
    end
  end

  return table
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: default arguments, list comprehension, defer (multiple),
##           while loop, match decoder (7 char arms + wildcard),
##           compound assignment (+=, -=), break + postfix guard,
##           numeric underscore literal, tuple return type + construction,
##           Map .get() + Option unwrap, StringBuilder append_char/
##           to_string/free, const + var bindings
## Exercises: default arg insertion at call site, list comprehension
##            desugar (vec_new + loop + push), multiple defers in LIFO,
##            while codegen, match on 8 arms, compound assignment desugar,
##            break from while + postfix guard parse, underscore in numeric
##            literal (lexer), tuple type + value construction + return
## Pipeline:  All phases exercised — this is the interpreter core
## ──────────────────────────────────────────────────────────────────────

## Run a brainfuck program and return (output_string, step_count).
##
## Commands: > < + - . [ ]
##   >  Move tape pointer right      <  Move tape pointer left
##   +  Increment cell at pointer     -  Decrement cell at pointer
##   .  Output cell as ASCII char
##   [  Jump past matching ] if cell is 0
##   ]  Jump back to matching [ if cell nonzero
def bf_run(program: String, tape_size: Int = 30000): (String, Int)
  ## FEATURE: postfix guard (unless) — early return for empty program.
  ## Also exercises tuple construction in return value.
  if program.size() == 0
    return ("", 0)
  end

  ## FEATURE: list comprehension — creates Vec<Int> of tape_size zeros.
  ## Desugars to: vec_new() + for _ in 0..tape_size: push(0).
  var tape = [0 for _i in 0..tape_size]
  jump_table = build_jump_table(program)
  var sb = sb_new()

  ## FEATURE: const bindings — immutable by default, no `var` keyword
  prog_len = program.size()

  ## FEATURE: var bindings — mutable, requires explicit `var`
  var ptr = 0
  var pc = 0
  var steps = 0

  ## FEATURE: defer (multiple) — resources freed in LIFO order at exit.
  ## Even if we break early, tape and jump_table are cleaned up.
  defer vec_free(tape)
  defer map_free(jump_table)

  ## FEATURE: while loop — the main fetch-decode-execute cycle
  while pc < prog_len
    ## FEATURE: break + postfix guard + numeric underscore literal
    ## Safety limit prevents runaway programs. 1_000_000 uses underscore
    ## separators for readability (lexer strips them).
    break if steps > 1_000_000

    ch = str_char_at(program, pc)

    ## FEATURE: compound assignment — steps += 1 desugars to steps = steps + 1
    steps += 1

    ## FEATURE: match expression — the core instruction decoder.
    ## 7 character literal arms + wildcard. Each character literal ('>', '<',
    ## etc.) compiles to its ASCII integer code. The match dispatches on the
    ## integer value of ch.
    match ch
      '>' => {
        ## FEATURE: compound assignment on var binding
        ptr += 1
      }
      '<' => {
        ptr -= 1
      }
      '+' => {
        ## FEATURE: Vec index read + write (tape[ptr])
        tape[ptr] = tape[ptr] + 1
      }
      '-' => {
        tape[ptr] = tape[ptr] - 1
      }
      '.' => {
        ## FEATURE: StringBuilder.append_char via UFCS
        sb.append_char(tape[ptr])
      }
      '[' => {
        if tape[ptr] == 0
          ## FEATURE: map_get returns Option<Int> → .unwrap() extracts value
          ## FEATURE: string interpolation for map key ("#{pc}")
          pc = map_get(jump_table, "#{pc}").unwrap()
        end
      }
      ']' => {
        if tape[ptr] != 0
          pc = map_get(jump_table, "#{pc}").unwrap()
        end
      }
      _ => {}
    end

    pc += 1
  end

  ## FEATURE: StringBuilder.to_string via UFCS — copies buffer to String
  output = sb.to_string()
  sb.free()

  ## FEATURE: tuple construction — return two values as (String, Int)
  return (output, steps)
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: Endless def (zero-arg, single-expression functions)
## Exercises: def NAME = EXPR syntax (no parens, no return type annotation),
##            string literal return, type inference on return
## Pipeline:  parser (endless def) → typecheck (infer String return) →
##            codegen (direct string constant return)
## ──────────────────────────────────────────────────────────────────────

## Each test program as a zero-arg endless def. Callers use program_name().
def hello_program(): String = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."
def a_program(): String = "++++++++[>++++++++<-]>+."
def add_program(): String = "+++>+++++[<+>-]<++++++++++++++++++++++++++++++++++++++++++++++++."
def digits_program(): String = "++++++++++++++++++++++++++++++++++++++++++++++++.+.+.+.+.+.+.+.+.+."

## ──────────────────────────────────────────────────────────────────────
## FEATURES: Tuple destructuring, struct field access (dot syntax),
##           enum variant construction with payloads, string equality (==)
## Exercises: var (a, b) = tuple_expr destructuring, tc.field access on
##            struct parameter, BfResult::Pass/Fail construction,
##            string == desugars to str_eq (content comparison)
## Pipeline:  parser (tuple destructure) → typecheck (field resolution,
##            enum variant payload types) → MIR (tuple element extract) →
##            codegen (GEP for tuple fields, str_eq call)
## ──────────────────────────────────────────────────────────────────────

## Run a brainfuck program and compare output to expected result.
def run_test(tc: TestCase): BfResult
  ## FEATURE: tuple destructuring — bind both elements of the (String, Int) pair
  var (output, steps) = bf_run(tc.program)

  ## FEATURE: string equality — == on strings does content comparison (str_eq)
  ## FEATURE: struct field access — tc.expected reads the field
  if output == tc.expected
    ## FEATURE: enum variant construction with multiple payloads
    return BfResult::Pass(tc.name, steps)
  end

  ## FEATURE: string interpolation (multiple #{} in one string)
  return BfResult::Fail("#{tc.name}: expected '#{tc.expected}', got '#{output}'")
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: Array literal (with struct literals), for..in on Vec (not
##           range), impl method call (tc.describe()), match on enum with
##           payloads (multi-arm + multi-field destructure), .each() with
##           implicit `it`, .reduce() with do..end trailing block,
##           negative indexing (v[-1]), Option predicates (.some?/.none?) on enum variant,
##           postfix guard (return N if COND)
## Exercises: array literal → Vec construction, for..in Vec iteration
##            (vs range), UFCS dispatch to impl method, enum match with
##            payload destructuring, implicit `it` rewrite, do..end block
##            parse, negative literal index rewrite, `is` variant tag check,
##            postfix guard codegen
## Pipeline:  All phases — this ties everything together
## ──────────────────────────────────────────────────────────────────────

def main(): Int
  puts("=== Brainfuck Interpreter ===")
  puts("=== Quartz Compiler Smoke Test ===")
  puts("")

  ## FEATURE: array literal containing struct literal construction.
  ## Creates Vec<TestCase> from [...] syntax. Each element is a TestCase
  ## struct literal with named fields.
  tests = [
    TestCase { name: "Hello World", program: hello_program(), expected: "Hello World!\n" },
    TestCase { name: "Print A", program: a_program(), expected: "A" },
    TestCase { name: "3 + 5", program: add_program(), expected: "8" },
    TestCase { name: "Digits 0-9", program: digits_program(), expected: "0123456789" }
  ]

  var passed = 0
  var failed = 0
  var step_counts = vec_new()
  var last_result = BfResult::Pass("none", 0)

  ## FEATURE: for..in on Vec — iterates elements (not range indices).
  ## tc binds to each TestCase struct in the array.
  for tc in tests
    ## FEATURE: impl method call — tc.describe() dispatches to TestCase$describe(tc)
    puts("  #{tc.describe()}")

    last_result = run_test(tc)

    ## FEATURE: match on enum with payload destructuring.
    ## Pass(name, steps) destructures the two-field payload.
    ## Fail(msg) destructures the single-field payload.
    ## Unqualified variant names (no BfResult:: prefix) in match arms.
    match last_result
      Pass(name, steps) => {
        puts("    PASS (#{steps} steps)")
        step_counts.push(steps)
        passed += 1
      }
      Fail(msg) => {
        puts("    FAIL: #{msg}")
        failed += 1
      }
    end
  end

  puts("")

  ## FEATURE: .each() with implicit `it` parameter in trailing block.
  ## The curly-brace block { ... } gets an implicit `it` binding for
  ## each element. Exercises: HOF dispatch, trailing block parse,
  ## implicit parameter injection.
  puts("  Step counts:")
  step_counts.each() { puts("    #{it}") }

  ## FEATURE: .reduce() with do..end trailing block and explicit params.
  ## do..end is the multi-line block form (vs { } for single-line).
  ## Exercises: HOF with accumulator, do..end block parse, arrow params.
  total = step_counts.reduce(0) do acc, x ->
    acc + x
  end
  puts("  Total: #{total} steps across all tests")

  ## FEATURE: negative indexing — v[-1] rewrites to v[v.size + (-1)]
  ## at compile time. Only literal negative indices are supported.
  last_steps = step_counts[-1]
  puts("  Last test: #{last_steps} steps")

  puts("")
  puts("  #{passed} passed, #{failed} failed")

  ## FEATURE: Option predicate methods (.some? / .none?)
  ## .some? and .none? are predicate methods (? suffix) that rewrite
  ## via UFCS to is_some() / is_none(). Exercises: predicate method
  ## naming convention, UFCS rewrite, Option variant checking.
  ## We use the jump table from a dummy run to demonstrate map_get returning Option.
  var probe_map = map_new()
  probe_map.set("key", 1)
  if probe_map.get("missing").none?
    puts("  (Option predicate: .none? correctly detected missing key)")
  end
  if probe_map.get("key").some?
    puts("  (Option predicate: .some? correctly detected present key)")
  end
  map_free(probe_map)

  ## FEATURE: match on enum variant — final result check.
  ## Exercises unqualified variant name + wildcard arm on custom enum.
  match last_result
    Fail(_) => { return 1 }
    _ => {}
  end
  return 0
end
