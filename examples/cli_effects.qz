## examples/cli_effects.qz — CLI tool driven by State<ArgCursor> +
## Reader<Config> + Log.
##
## Operation Piezoelectric Effects, Phase 2, Milestone P2.d pilot.
##
## Demonstrates the Phase 2 effect lineup applied to a real sub-feature:
## argv processing. Instead of threading a `cursor` integer and a `config`
## struct through every parser helper's parameter list, we install one
## `Reader<Config>` frame with the resolved config and one
## `State<Int>` frame with the current argv index; helpers read/write
## through `ask()` / `get()` / `set()` without any param threading. Log is
## the ambient progress-trace channel and respects the config's verbosity
## level via a user-installed handler.
##
## Run:
##   ./examples/cli_effects --verbose sum 3 4 5          # → "total: 12"
##   ./examples/cli_effects sum 10 20                    # → "total: 30"
##   ./examples/cli_effects --help                       # → usage blurb
##
## The pilot ships ONE parser-combinator primitive (`consume_int`) built
## on the State<ArgCursor> effect. Production quake/argparse could reuse
## the same shape: each `consume_X` helper pulls from the cursor and
## advances. Errors propagate via a Bail effect (skipped here for scope;
## Reader + State + Log exercises enough of Phase 2).

import std/state
import std/reader
import std/log

## Verbosity-level sentinel values. 0 = silent, 1 = normal, 2 = debug.
const VERBOSE_SILENT = 0
const VERBOSE_NORMAL = 1
const VERBOSE_DEBUG = 2

## Log handler that gates output on ambient verbosity. When the program
## runs under `with Log { emit: gated_log_handler } do …`, every
## `log::info(...)` call hits this handler; the handler in turn reads the
## Reader<Config>'s verbosity level to decide whether to print.
def gated_log_handler(op: Int, argc: Int, argv: Int): Int can Reader
  if ask() >= VERBOSE_DEBUG
    puts(as_string(load(argv, 0)))
  end
  return 0
end

## Advance the cursor by 1 and return the previous index. Reads +
## mutates State<Int>. Used as the core atom of all `consume_*` helpers.
def advance_cursor(): Int can State
  var i = get()
  set(i + 1)
  return i
end

## Convenience: peek the current index without advancing.
def cursor(): Int can State = get()

## Consume the next positional arg as an Int. For this pilot we assume
## all positional args after flags are valid integers; a real CLI would
## surface parse errors via a Bail or Throws handler. Argv is captured
## in a module-level var set by main() — Phase 2 doesn't introduce
## `import`-level globals through effects.
var argv_cache: Vec<String> = vec_new<String>()

def consume_int(): Int can State, Log
  var i = advance_cursor()
  if i >= argv_cache.size
    log::info("consume_int: off-end at #{i}")
    return 0
  end
  var s = argv_cache[i]
  log::info("consume_int[#{i}]: #{s}")
  return s.to_i()
end

## Return true if the cursor still has arguments to consume.
def has_more(): Int can State
  return 1 if cursor() < argv_cache.size
  return 0
end

## "sum" subcommand body: consume ints until EOF, return the total. All
## cursor movement goes through consume_int; the caller is purely
## declarative about "I want an Int per step."
def run_sum(): Int can State, Reader, Log
  log::info("subcommand: sum")
  var total = 0
  while has_more() == 1
    total = total + consume_int()
  end
  return total
end

## Dispatch on the subcommand name. Reads the cursor to pick up the
## command token, then delegates. Returns the result.
def run_dispatch(): Int can State, Reader, Log
  var cmd_i = advance_cursor()
  if cmd_i >= argv_cache.size
    puts("usage: cli_effects [--verbose] <command> <args...>")
    puts("commands: sum")
    return 1
  end
  var cmd = argv_cache[cmd_i]
  if cmd.eq("sum")
    var total = run_sum()
    puts("total: #{total}")
    return 0
  end
  if cmd.eq("--help")
    puts("usage: cli_effects [--verbose] <command> <args...>")
    puts("commands: sum — compute the sum of all remaining int args")
    puts("flags:    --verbose  enable progress log output")
    return 0
  end
  puts("unknown command: #{cmd}")
  return 1
end

## Pre-pass: strip flag arguments off the front of argv, returning the
## resolved verbosity level. Rewrites argv_cache to contain only the
## positional tail (command + its args). Keeps State<Int> dedicated to
## positional-arg cursoring, so the parser logic doesn't need to skip
## flags mid-stream.
def resolve_flags(raw: Vec<String>): Int
  var verbosity = VERBOSE_NORMAL
  var positionals = vec_new<String>()
  var i = 0
  while i < raw.size
    var a = raw[i]
    if a.eq("--verbose") or a.eq("-v")
      verbosity = VERBOSE_DEBUG
    elsif a.eq("--silent") or a.eq("-s")
      verbosity = VERBOSE_SILENT
    else
      positionals.push(a)
    end
    i = i + 1
  end
  argv_cache = positionals
  return verbosity
end

def main(): Int
  # Skip argv(0) (the binary name) before collecting into the cache.
  var raw = vec_new<String>()
  var n = argc()
  var i = 1
  while i < n
    raw.push(argv(i))
    i = i + 1
  end
  var verbosity = resolve_flags(raw)

  # Install all three effect frames in one comma-list and dispatch. The
  # Log handler reads Reader<Int>'s verbosity to gate output; State<Int>
  # holds the cursor at 0 to start. run_dispatch's `can State, Reader,
  # Log` row is covered by all three enclosing with-frames.
  var rc = with Log { emit: gated_log_handler }, Reader(verbosity), State(0) do ->
    run_dispatch()
  end
  return rc
end
