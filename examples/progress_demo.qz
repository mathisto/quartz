## progress_demo.qz — Showcase the std/progress API.
##
## Run with:
##   ./self-hosted/bin/quartz -I . -I std examples/progress_demo.qz \
##     | llc -filetype=obj -o /tmp/pd.o && \
##     clang /tmp/pd.o -o /tmp/pd -lm -lpthread && /tmp/pd
##
## Try the JSON output mode:
##   QZ_PROGRESS=json /tmp/pd 2>&1 1>/dev/null
##
## Try the dumb (CI) mode:
##   QZ_PROGRESS=dumb /tmp/pd

import * from progress
import * from time
import * from style

def header(text: String): Void
  puts("")
  puts(Style.heading().render(text))
  puts("")
end

def main(): Int
  header("Quartz progress library — live demo")

  # ---------------------------------------------------------------------------
  # 1. Indeterminate spinner — ora-style one-liner
  # ---------------------------------------------------------------------------
  puts("1. Indeterminate spinner (Spinner_start)")
  var sp = Spinner_start("Connecting to remote host")
  var i = 0
  while i < 25
    sp.render()
    time_sleep_ms(60)
    i += 1
  end
  sp.finish_with("connected")

  # ---------------------------------------------------------------------------
  # 2. Determinate progress with a template — same shape as the bar lib
  #    everyone knows, but no parser DSL to learn at the API level
  # ---------------------------------------------------------------------------
  puts("")
  puts("2. Determinate bar via template")
  var pb = Progress.new(200)
    .label("downloading")
    .template("{spinner.cyan} {label} [{bar:30.cyan}] {pos}/{len} {percent} {eta}")
  pb.start()
  var k = 0
  while k < 200
    pb.inc(1)
    time_sleep_ms(8)
    k += 1
  end
  pb.finish_with("done")

  # ---------------------------------------------------------------------------
  # 3. Spring physics — set pos in big jumps, watch the bar catch up smoothly
  # ---------------------------------------------------------------------------
  puts("")
  puts("3. Spring physics (jumpy pos, smooth bar)")
  var pb2 = Progress.new(100)
    .label("smoothing")
    .template("{spinner.magenta} {label} [{bar:40.magenta}] {percent}")
  pb2.start()
  pb2.set(25)
  var s = 0
  while s < 30
    pb2.render()
    time_sleep_ms(40)
    s += 1
  end
  pb2.set(75)
  s = 0
  while s < 30
    pb2.render()
    time_sleep_ms(40)
    s += 1
  end
  pb2.finish()

  # ---------------------------------------------------------------------------
  # 4. Cornucopia of named spinner styles
  # ---------------------------------------------------------------------------
  puts("")
  puts("4. Spinner cornucopia (named styles)")
  show_named_spinner("dots")
  show_named_spinner("line")
  show_named_spinner("arrow")
  show_named_spinner("bouncing_bar")
  show_named_spinner("circle")
  show_named_spinner("moon")
  show_named_spinner("earth")
  show_named_spinner("aesthetic")
  show_named_spinner("triangle")

  # ---------------------------------------------------------------------------
  # 5. Presets
  # ---------------------------------------------------------------------------
  puts("")
  puts("5. Preset: Progress.download(file_size)")
  var dl = Progress.download(1048576).label("file.tar.gz")
  dl.start()
  var n = 0
  while n < 1048576
    dl.inc(32768)
    time_sleep_ms(15)
    n += 32768
  end
  dl.finish_with("downloaded")

  # ---------------------------------------------------------------------------
  # 6. Failure path
  # ---------------------------------------------------------------------------
  puts("")
  puts("6. Failure transition")
  var fp = Spinner_start("Verifying signature")
  var f = 0
  while f < 15
    fp.render()
    time_sleep_ms(60)
    f += 1
  end
  fp.fail_with("signature mismatch")

  puts("")
  puts(Style.success().render("Demo complete."))
  return 0
end

def show_named_spinner(name: String): Void
  var p = Progress.spinner_only()
    .label(name)
    .columns(_cornucopia_cols(name))
  p.start()
  var i = 0
  while i < 18
    p.render()
    time_sleep_ms(80)
    i += 1
  end
  p.finish_with("ok")
end

def _cornucopia_cols(name: String): Vec<Col>
  var v = vec_new<Col>()
  v.push(Col.spinner_named(name).cyan())
  v.push(Col.text("  "))
  v.push(Col.label())
  return v
end
