##! SIMD Dot Product — Vectorized dot product using F32x4 SIMD intrinsics
##!
##! Demonstrates: F32x4 SIMD registers, vectorized arithmetic,
##! f32_vec storage, SIMD load/store, horizontal sum, UFCS.
##!
##! The dot product of two vectors [a0,a1,...,an] . [b0,b1,...,bn] is:
##!   a0*b0 + a1*b1 + ... + an*bn
##!
##! Using SIMD, we process 4 elements at a time:
##!   1. Load 4 floats from each vector into SIMD registers
##!   2. Multiply element-wise (4 multiplies in one instruction)
##!   3. Accumulate partial sums
##!   4. Horizontal sum at the end

## Build an f32_vec with n elements: [1.0, 2.0, ..., n.0]
def make_vec(n: Int): Int
  var v = f32_vec_new()
  for i in 0..n
    v.push(to_f64(i + 1))
  end
  return v
end

## Build an f32_vec with n copies of the same value
def make_vec_fill(n: Int, val: F64): Int
  var v = f32_vec_new()
  for i in 0..n
    v.push(val)
  end
  return v
end

## Scalar dot product (reference implementation)
def dot_scalar(a: Int, b: Int, n: Int): F64
  var sum = 0.0
  for i in 0..n
    sum = sum + f32_vec_get(a, i) * f32_vec_get(b, i)
  end
  return sum
end

## SIMD dot product — processes 4 elements per iteration
## For vectors whose length is a multiple of 4.
def dot_simd(a: Int, b: Int, n: Int): F64
  var acc = simd_f32x4_splat(0.0)
  var i = 0

  # Main SIMD loop: process 4 elements at a time
  while i + 4 <= n
    va = simd_f32x4_load(a, i)
    vb = simd_f32x4_load(b, i)
    prod = simd_f32x4_mul(va, vb)
    acc = simd_f32x4_add(acc, prod)
    i = i + 4
  end

  # Horizontal sum of the 4 accumulator lanes
  var result = simd_f32x4_sum(acc)

  # Handle remaining elements (tail loop)
  while i < n
    result = result + f32_vec_get(a, i) * f32_vec_get(b, i)
    i = i + 1
  end

  return result
end

def main(): Int
  puts("=== SIMD Dot Product ===")
  puts("")

  # Example 1: Simple 4-element dot product
  # [1, 2, 3, 4] . [5, 6, 7, 8] = 5 + 12 + 21 + 32 = 70
  puts("1. Four-element dot product:")
  a = make_vec(4)
  var b = f32_vec_new()
  b.push(5.0)
  b.push(6.0)
  b.push(7.0)
  b.push(8.0)
  result = dot_simd(a, b, 4)
  puts("   [1,2,3,4] . [5,6,7,8] = #{to_int(result)}")

  # Example 2: Unit vector dot product
  # [1, 0, 0, 0] . [0, 1, 0, 0] = 0 (orthogonal)
  puts("")
  puts("2. Orthogonal unit vectors:")
  var u1 = f32_vec_new()
  u1.push(1.0)
  u1.push(0.0)
  u1.push(0.0)
  u1.push(0.0)
  var u2 = f32_vec_new()
  u2.push(0.0)
  u2.push(1.0)
  u2.push(0.0)
  u2.push(0.0)
  result2 = dot_simd(u1, u2, 4)
  puts("   [1,0,0,0] . [0,1,0,0] = #{to_int(result2)}")

  # Example 3: Self dot product = squared magnitude
  # [3, 4, 0, 0] . [3, 4, 0, 0] = 9 + 16 = 25
  puts("")
  puts("3. Self dot product (squared magnitude):")
  var v = f32_vec_new()
  v.push(3.0)
  v.push(4.0)
  v.push(0.0)
  v.push(0.0)
  result3 = dot_simd(v, v, 4)
  puts("   [3,4,0,0] . [3,4,0,0] = #{to_int(result3)}")
  puts("   (magnitude = 5)")

  # Example 4: Scalar vs SIMD comparison on larger vector
  puts("")
  puts("4. Scalar vs SIMD (8-element vectors):")
  big_a = make_vec(8)
  big_b = make_vec_fill(8, 2.0)
  scalar = dot_scalar(big_a, big_b, 8)
  simd = dot_simd(big_a, big_b, 8)
  puts("   scalar: #{to_int(scalar)}")
  puts("   simd:   #{to_int(simd)}")
  puts("   match: #{to_int(scalar) == to_int(simd)}")

  return 0
end
