##! Linear Types - Defer, arenas, and scope-based resource management
##!
##! Demonstrates: defer for RAII-style cleanup, arena allocation,
##! manual resource management patterns, LIFO cleanup order.

struct FileHandle
  fd: Int
  path: String
end

def file_open(path: String): FileHandle
  puts("  [open] #{path}")
  return FileHandle { fd: 42, path: path }
end

def file_close(f: FileHandle): Void
  puts("  [close] #{f.path}")
end

## Defer guarantees cleanup even on early return.
def process_file(path: String): Int
  f = file_open(path)
  defer file_close(f)
  content = "contents of #{f.path}"
  puts("  read: #{content}")
  return str_size(content)
end

## Multiple defers run in LIFO order.
def multi_defer_demo(): Void
  puts("  entering")
  defer puts("  [defer 1] first registered, last to run")
  defer puts("  [defer 2] second registered")
  defer puts("  [defer 3] last registered, first to run")
  puts("  working...")
end

## Arena: allocate many blocks, free all at once.
def arena_demo(): Void
  a = arena_new()
  p1 = arena_alloc(a, 64)
  p2 = arena_alloc(a, 128)
  store(p1, 0, 42)
  val = load(p1, 0)
  puts("  arena: wrote 42, read #{val}")
  arena_reset(a)
  puts("  arena reset (memory reusable)")
  arena_destroy(a)
  puts("  arena destroyed")
end

struct Resource
  name: String
  id: Int
end

def acquire(name: String, id: Int): Resource
  puts("  [acquire] #{name} ##{id}")
  return Resource { name: name, id: id }
end

def release(r: Resource): Void
  puts("  [release] #{r.name} ##{r.id}")
end

def main(): Int
  puts("=== Resource Management ===")
  puts("")
  puts("1. Defer cleanup:")
  n = process_file("data.txt")
  puts("  bytes: #{n}")
  puts("")
  puts("2. LIFO defers:")
  multi_defer_demo()
  puts("")
  puts("3. Manual acquire/release:")
  r1 = acquire("db", 1)
  r2 = acquire("conn", 2)
  release(r2)
  release(r1)
  puts("")
  puts("4. Arena allocation:")
  arena_demo()
  return 0
end
