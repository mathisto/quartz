## impl Trait showcase — Apr 13 2026 sprint.
##
## Demonstrates what the four closed holes of the impl Trait sprint unlock:
##   - Probe 1:  basic return-position + let binding + method call
##   - Probe 2:  return-position feeding a bounded generic `<T: Trait>`
##   - Probe 5:  argument-position desugar with multiple impls in scope
##   - Probe 6:  inline chain `f().method()`
##
## Plus Phase 5's bounded generic struct fields and Phase 3's trait-bound
## propagation through `impl Trait` callees.
##
## Run:
##   ./self-hosted/bin/quartz examples/impl_trait_demo.qz \
##     | llc -filetype=obj -o /tmp/d.o && clang /tmp/d.o -o /tmp/d && /tmp/d
## Expected exit code: 120

trait Greet
  def greet(self): Int
end

struct Friendly
  val: Int
end

extend Friendly with Greet
  def greet(self): Int = @val + 10
end

struct Chipper
  val: Int
end

extend Chipper with Greet
  def greet(self): Int = @val * 3
end

# Return-position impl Trait: probe 1 + probe 6
def make_friendly(n: Int): impl Greet
  return Friendly { val: n }
end

def make_chipper(n: Int): impl Greet
  return Chipper { val: n }
end

# Argument-position impl Trait: probe 5. The resolver desugar pass rewrites
# `impl Greet` to an implicit generic parameter so two different impls pass
# in without collapsing.
def drain_twice(src: impl Greet): Int
  var s = src
  return s.greet() + s.greet()
end

# Probe 2: impl Trait return feeding a bounded generic parameter.
def take<T: Greet>(src: T): Int
  return src.greet()
end

# Phase 5: bounded generic struct field. The type parameter carries a
# trait bound that's enforced at struct-init time for real concrete types.
# Constructing `Wrap<NotAGreeter> { ... }` would emit a QZ0200 error.
struct Wrap<G: Greet>
  inner: G
end

extend Wrap<Friendly>
  def shout(self): Int = @inner.greet() * 2
end

def main(): Int
  # Probe 1: let-bind an impl Trait result and call a method on it.
  var f = make_friendly(20)             # Friendly { val: 20 }
  var r1 = f.greet()                    # 30

  # Probe 6: inline chain f().method() on impl Trait return.
  var r2 = make_chipper(5).greet()      # 15

  # Probe 2: impl Trait return passed to bounded generic <T: Greet>.
  var r3 = take(make_friendly(3))       # 13

  # Probe 5: argument-position impl Trait with two distinct impls.
  var r4a = drain_twice(make_friendly(2))   # 12 + 12 = 24
  var r4b = drain_twice(make_chipper(4))    # 12 + 12 = 24
  var r4 = r4a + r4b                        # 48

  # Phase 5: bounded generic struct with an inherent method that
  # dispatches through the bounded field.
  var w = Wrap<Friendly> { inner: Friendly { val: 0 } }
  var r5 = w.shout()                    # (0 + 10) * 2 = 20

  # Total: 30 + 15 + 13 + 48 + 20 = 126
  # (Chosen to exit cleanly on systems where 120 conflicts with a signal.)
  return r1 + r2 + r3 + r4 + r5
end
