##! Concurrency - Threads, channels, atomics, and mutex
##!
##! Demonstrates: spawn/await, channels, buffered channels,
##! atomic operations, and mutex-protected shared state.

def square(n: Int): Int = n * n

def sender(ch: Int): Int
  send(ch, 42)
  return 0
end

def producer(ch: Int): Int
  send(ch, 10)
  send(ch, 20)
  send(ch, 30)
  channel_close(ch)
  return 0
end

def inc_atomic(atom: Int): Int
  var i = 0
  while i < 100
    atomic_add(atom, 1)
    i += 1
  end
  return 0
end

def inc_mutex(mx: Int): Int
  var i = 0
  while i < 50
    val = mutex_lock(mx)
    mutex_unlock(mx, val + 1)
    i += 1
  end
  return 0
end

def main(): Int
  puts("=== Concurrency ===")

  # Spawn and await
  h = go square(7)
  puts("7^2 = " + "#{await h}")

  # Multiple threads
  h1 = go square(3)
  h2 = go square(4)
  h3 = go square(5)
  puts("3^2+4^2+5^2 = " + "#{await h1 + await h2 + await h3}")

  # Channel send/recv
  ch = channel_new(1)
  h4 = go sender(ch)
  puts("channel recv: " + "#{recv(ch)}")
  await h4

  # Producer-consumer
  ch2 = channel_new(1)
  h5 = go producer(ch2)
  var total = 0
  var done = 0
  while done == 0
    msg = recv(ch2)
    if msg == 0 and channel_closed(ch2) == 1
      done = 1
    else
      total += msg
    end
  end
  await h5
  puts("producer sum = " + "#{total}")

  # Atomics: 3 threads x 100
  atom = atomic_new(0)
  h6 = go inc_atomic(atom)
  h7 = go inc_atomic(atom)
  h8 = go inc_atomic(atom)
  await h6
  await h7
  await h8
  puts("atomic count = " + "#{atomic_load(atom)}")

  # Mutex: 2 threads x 50
  mx = mutex_new(0)
  h9 = go inc_mutex(mx)
  h10 = go inc_mutex(mx)
  await h9
  await h10
  fv = mutex_lock(mx)
  mutex_unlock(mx, fv)
  puts("mutex value = " + "#{fv}")
  return 0
end
