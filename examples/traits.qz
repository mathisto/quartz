##! Traits - Quartz's hybrid Open UFCS + Traits system
##!
##! Demonstrates: trait definitions, abstract methods, default methods,
##! Self type, impl blocks, bounded generics, open UFCS, operator dispatch.

import * from traits

# ============================================================================
# 1. Traits with abstract + default methods
# ============================================================================

## A trait with one abstract method and one default
trait Describable
  def describe(self): String
  def label(self): String = "item"
end

struct Point
  x: Int
  y: Int
end

extend Point with Describable
  def describe(self): String = "(#{@x}, #{@y})"
  # label() inherited as default: returns "item"
end

struct Circle
  x: Int
  y: Int
  radius: Int
end

extend Circle with Describable
  def describe(self): String = "circle at (#{@x}, #{@y}) r=#{@radius}"
  def label(self): String = "shape"  # override default
end

# ============================================================================
# 2. Eq trait with operator dispatch (== and !=)
# ============================================================================

extend Point with Eq
  def op_eq(self, other: Self): Bool
    return @x == other.x and @y == other.y
  end
  # op_ne inherited from default: not op_eq(self, other)
end

# ============================================================================
# 3. Self type and arithmetic trait
# ============================================================================

extend Point with Add
  def op_add(self, other: Self): Self
    return Point { x: @x + other.x, y: @y + other.y }
  end
end

# ============================================================================
# 4. Bounded generics — dispatch through trait bounds
# ============================================================================

## Works for any type that implements Describable
def print_described<T: Describable>(item: T): Void
  puts("  [#{item.label()}] #{item.describe()}")
end

## Works for any type with Eq
def are_equal<T: Eq>(a: T, b: T): Bool
  return a.op_eq(b)
end

# ============================================================================
# 5. Open UFCS — any function callable as method
# ============================================================================

## Free function with Point as first param
def manhattan(p: Point): Int = abs(p.x) + abs(p.y)

## Free function with Int as first param
def double(n: Int): Int = n * 2

# ============================================================================
# 6. Show trait (from std/traits.qz) for string representation
# ============================================================================

extend Point with Show
  def show(self): String = "Point(#{@x}, #{@y})"
end

extend Circle with Show
  def show(self): String = "Circle(#{@x}, #{@y}, r=#{@radius})"
end

def display<T: Show>(item: T): Void
  puts("  #{item.show()}")
end

# ============================================================================
# Main
# ============================================================================

def main(): Int
  puts("=== Quartz Traits ===")
  puts("")

  # Describable trait
  puts("1. Trait methods:")
  p = Point { x: 3, y: 4 }
  c = Circle { x: 0, y: 0, radius: 5 }
  print_described(p)
  print_described(c)
  puts("")

  # Eq via operator dispatch
  puts("2. Operator dispatch (Eq trait):")
  p2 = Point { x: 3, y: 4 }
  p3 = Point { x: 1, y: 2 }
  puts("  (3,4) == (3,4): #{p.op_eq(p2)}")
  puts("  (3,4) == (1,2): #{p.op_eq(p3)}")
  puts("  (3,4) != (1,2): #{p.op_ne(p3)}")
  puts("")

  # Add trait
  puts("3. Arithmetic trait (Add):")
  sum = p + p3
  puts("  (3,4) + (1,2) = (#{sum.x}, #{sum.y})")
  puts("")

  # Bounded generics
  puts("4. Bounded generics:")
  puts("  are_equal(p, p2) = #{are_equal(p, p2)}")
  puts("  are_equal(p, p3) = #{are_equal(p, p3)}")
  puts("")

  # Open UFCS
  puts("5. Open UFCS:")
  puts("  p.manhattan() = #{p.manhattan()}")
  puts("  5.double() = #{5.double()}")
  puts("  5.double().double() = #{5.double().double()}")
  puts("")

  # Show trait
  puts("6. Show trait:")
  display(p)
  display(c)

  return 0
end
