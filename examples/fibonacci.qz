##! Fibonacci - Recursive, iterative, and memoized approaches
##!
##! Demonstrates: recursion, while loops, for..in, mutable variables,
##! compound assignment, vectors, endless def, pattern matching, UFCS.

## Recursive Fibonacci (simple but exponential time).
def fib_recursive(n: Int): Int
  match n
    0 => 0
    1 => 1
    _ => fib_recursive(n - 1) + fib_recursive(n - 2)
  end
end

## Iterative Fibonacci (linear time).
def fib_iterative(n: Int): Int
  if n <= 1
    return n
  end
  var a = 0
  var b = 1
  var i = 2
  while i <= n
    var temp = a + b
    a = b
    b = temp
    i += 1
  end
  return b
end

## Memoized Fibonacci using a vector cache.
def fib_memo(n: Int, cache: Vec<Int>): Int
  cached = cache[n]
  if cached >= 0
    return cached
  end
  result = fib_memo(n - 1, cache) + fib_memo(n - 2, cache)
  cache[n] = result
  return result
end

## Initialize memoization cache.
def make_cache(n: Int): Vec<Int>
  var cache = vec_new()
  cache.push(0)
  cache.push(1)
  for i in 2..n + 1
    cache.push(-1)
  end
  return cache
end

def main(): Int
  puts("=== Fibonacci ===")
  puts("")
  puts("Recursive (0..9):")
  for i in 0..10
    puts("  fib(#{i}) = #{fib_recursive(i)}")
  end
  puts("")
  puts("Iterative (0..14):")
  for i in 0..15
    puts("  fib(#{i}) = #{fib_iterative(i)}")
  end
  puts("")
  puts("Memoized (0..19):")
  var cache = make_cache(20)
  for i in 0..20
    puts("  fib(#{i}) = #{fib_memo(i, cache)}")
  end
  vec_free(cache)
  return 0
end
