##! Hello World — Basic I/O in Quartz
##!
##! Demonstrates: puts, print, print_int, string interpolation,
##! auto-to_s in #{}, and basic variable bindings.

## Greet someone by name.
def greet(name: String): Void
  puts("Hello, #{name}!")
end

## Print a separator line.
def separator(): Void
  puts("---")
end

## Show different output functions.
def show_output(): Void
  # puts prints with a trailing newline
  puts("1. puts adds a newline")

  # print does NOT add a newline
  print("2. print ")
  print("stays on ")
  puts("one line")

  # print_int prints an integer with a newline
  print("3. The answer is: ")
  print_int(42)

  # String interpolation with #{}
  language = "Quartz"
  version = 5
  puts("4. #{language} v#{version} is great")
end

## Build a greeting string using interpolation.
def build_greeting(first: String, last: String): String
  return "Welcome, #{first} #{last}"
end

def main(): Int
  # Immutable bindings (const by default)
  greeting = "world"
  greet(greeting)
  separator()

  show_output()
  separator()

  # String concatenation with +
  msg = "Quartz" + " is " + "self-hosted"
  puts(msg)

  # Building strings
  welcome = build_greeting("Ada", "Lovelace")
  puts(welcome)
  separator()

  # Mutable variable with var
  var count = 0
  count += 1
  count += 1
  count += 1
  puts("Count: #{count}")

  puts("Goodbye!")
  return 0
end
