## CHIP-8 emulator test harness — drives examples/chip8/chip8.qz through
## a battery of small hand-assembled programs and reports PASS/FAIL for
## each. Phase 2 verification: is the decoder right, do the 35 opcodes
## behave, does DRW + font produce the expected pixel pattern?
##
## Run: quartz examples/chip8/chip8.qz examples/chip8/test_chip8.qz > out.ll
##      (or a small wrapper that concatenates — see bottom of this file)
##
## These tests run under the LLVM backend. Phase 3 will re-run a subset
## under wasmtime to verify the WASM path behaves identically.

import chip8

var g_passed = 0
var g_failed = 0

def _expect_eq(label: String, actual: Int, expected: Int): Void
  if actual == expected
    g_passed += 1
    puts("  PASS  #{label}: #{actual}")
  else
    g_failed += 1
    puts("  FAIL  #{label}: got #{actual}, expected #{expected}")
  end
end

def _write_op(addr: Int, op: Int): Void
  # Big-endian 16-bit write.
  chip8::chip8_ram_write(addr, (op >> 8) & 0xFF)
  chip8::chip8_ram_write(addr + 1, op & 0xFF)
end

# ---------------------------------------------------------------------------
# Individual opcode tests
# ---------------------------------------------------------------------------

def test_ld_imm(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6042)  # V0 = 0x42
  chip8::chip8_step()
  _expect_eq("6xkk (LD V0, 0x42)", chip8::chip8_v(0), 0x42)
  _expect_eq("6xkk advances PC by 2", chip8::chip8_pc(), 0x202)
end

def test_add_imm(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6010)  # V0 = 0x10
  _write_op(0x202, 0x700A)  # V0 += 0x0A
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("7xkk (V0 = 0x10 + 0x0A)", chip8::chip8_v(0), 0x1A)
end

def test_add_imm_wrap(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x60F0)  # V0 = 0xF0
  _write_op(0x202, 0x7020)  # V0 += 0x20 → wraps to 0x10
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("7xkk wraps at 256", chip8::chip8_v(0), 0x10)
end

def test_jp(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x1234)
  chip8::chip8_step()
  _expect_eq("1nnn (JP 0x234)", chip8::chip8_pc(), 0x234)
end

def test_call_ret(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x2300)  # CALL 0x300
  _write_op(0x300, 0x00EE)  # RET
  chip8::chip8_step()
  _expect_eq("2nnn pushes return + jumps", chip8::chip8_pc(), 0x300)
  chip8::chip8_step()
  _expect_eq("00EE (RET) restores PC", chip8::chip8_pc(), 0x202)
end

def test_skip_eq(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6005)  # V0 = 5
  _write_op(0x202, 0x3005)  # SE V0, 5 — should skip
  _write_op(0x204, 0x1300)  # JP 0x300 (skipped)
  _write_op(0x206, 0x6111)  # V1 = 0x11 (reached)
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("3xkk (SE) skipped 0x204", chip8::chip8_pc(), 0x206)
  chip8::chip8_step()
  _expect_eq("V1 after skip", chip8::chip8_v(1), 0x11)
end

def test_skip_ne(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6005)  # V0 = 5
  _write_op(0x202, 0x4005)  # SNE V0, 5 — V0 == 5, so don't skip
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("4xkk no-skip when equal", chip8::chip8_pc(), 0x204)
end

def test_arith_or_and_xor(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x60F0)  # V0 = 0xF0
  _write_op(0x202, 0x610F)  # V1 = 0x0F
  _write_op(0x204, 0x8011)  # V0 |= V1  → 0xFF
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy1 (OR) V0 = 0xF0 | 0x0F", chip8::chip8_v(0), 0xFF)

  chip8::chip8_init()
  _write_op(0x200, 0x60F0)  # V0 = 0xF0
  _write_op(0x202, 0x61AA)  # V1 = 0xAA
  _write_op(0x204, 0x8012)  # V0 &= V1 → 0xA0
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy2 (AND) V0 = 0xF0 & 0xAA", chip8::chip8_v(0), 0xA0)

  chip8::chip8_init()
  _write_op(0x200, 0x60F0)
  _write_op(0x202, 0x610F)
  _write_op(0x204, 0x8013)  # V0 ^= V1 → 0xFF
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy3 (XOR) V0 = 0xF0 ^ 0x0F", chip8::chip8_v(0), 0xFF)
end

def test_arith_add_carry(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6080)  # V0 = 128
  _write_op(0x202, 0x61C0)  # V1 = 192
  _write_op(0x204, 0x8014)  # V0 += V1, VF = carry
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy4 sum mod 256", chip8::chip8_v(0), 64)
  _expect_eq("8xy4 carry → VF = 1", chip8::chip8_v(0xF), 1)
end

def test_arith_sub_borrow(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6005)  # V0 = 5
  _write_op(0x202, 0x610A)  # V1 = 10 (so V0 - V1 underflows)
  _write_op(0x204, 0x8015)  # V0 -= V1, VF = NOT borrow
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy5 V0 = 5 - 10 mod 256", chip8::chip8_v(0), 251)
  _expect_eq("8xy5 borrow → VF = 0", chip8::chip8_v(0xF), 0)
end

def test_shift(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6081)  # V0 = 0b1000_0001
  _write_op(0x202, 0x8006)  # V0 >>= 1, VF = LSB
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xy6 (SHR) V0 = 0x40", chip8::chip8_v(0), 0x40)
  _expect_eq("8xy6 VF = old LSB", chip8::chip8_v(0xF), 1)

  chip8::chip8_init()
  _write_op(0x200, 0x6081)
  _write_op(0x202, 0x800E)  # V0 <<= 1, VF = MSB
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("8xyE (SHL) V0 = 0x02", chip8::chip8_v(0), 0x02)
  _expect_eq("8xyE VF = old MSB", chip8::chip8_v(0xF), 1)
end

def test_ld_i_imm(): Void
  chip8::chip8_init()
  _write_op(0x200, 0xA345)  # I = 0x345
  chip8::chip8_step()
  # Peek I via a follow-up Fx55 / Fx29 trick, but easier: drop a DRW
  # that reads RAM[I] and check the display. Instead, directly use a
  # chained Fx55/Fx65 pair to prove I landed.
  _write_op(0x202, 0x6099)  # V0 = 0x99
  _write_op(0x204, 0xF055)  # RAM[I] = V0
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("Annn landed (Fx55 spilled V0 to I=0x345)", chip8::chip8_ram_read(0x345), 0x99)
end

def test_font_draw(): Void
  chip8::chip8_init()
  # Set I to font glyph "0", then draw 5 bytes at (0, 0).
  _write_op(0x200, 0x6000)  # V0 = 0 (glyph index)
  _write_op(0x202, 0xF029)  # I = font[V0]
  _write_op(0x204, 0x6100)  # V1 = 0 (x)
  _write_op(0x206, 0x6200)  # V2 = 0 (y)
  _write_op(0x208, 0xD125)  # DRW V1, V2, 5
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  # Glyph "0" is 0xF0 0x90 0x90 0x90 0xF0. Top row (y=0): 4 pixels
  # lit at cols 0..3 (0xF0 = 11110000).
  _expect_eq("glyph 0 row 0 col 0 on", chip8::chip8_display_read(0), 1)
  _expect_eq("glyph 0 row 0 col 1 on", chip8::chip8_display_read(1), 1)
  _expect_eq("glyph 0 row 0 col 2 on", chip8::chip8_display_read(2), 1)
  _expect_eq("glyph 0 row 0 col 3 on", chip8::chip8_display_read(3), 1)
  _expect_eq("glyph 0 row 0 col 4 off", chip8::chip8_display_read(4), 0)
  # Row 1 at y=1 → display offset 64: 0x90 = 10010000.
  _expect_eq("glyph 0 row 1 col 0 on",  chip8::chip8_display_read(64), 1)
  _expect_eq("glyph 0 row 1 col 1 off", chip8::chip8_display_read(65), 0)
  _expect_eq("glyph 0 row 1 col 3 on",  chip8::chip8_display_read(67), 1)
  _expect_eq("VF = 0 (no collision)", chip8::chip8_v(0xF), 0)
end

def test_bcd(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x60DC)  # V0 = 220
  _write_op(0x202, 0xA400)  # I = 0x400
  _write_op(0x204, 0xF033)  # BCD V0 at I
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("BCD hundreds", chip8::chip8_ram_read(0x400), 2)
  _expect_eq("BCD tens",     chip8::chip8_ram_read(0x401), 2)
  _expect_eq("BCD ones",     chip8::chip8_ram_read(0x402), 0)
end

def test_skip_key(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6005)  # V0 = 5
  _write_op(0x202, 0xE09E)  # SKP V0 (skip if key 5 is down)
  _write_op(0x204, 0x6111)  # V1 = 0x11 (reached if not skipped)
  _write_op(0x206, 0x6122)  # V1 = 0x22 (reached if skipped)
  chip8::chip8_key_set(5, 1)
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("Ex9E skipped when key down", chip8::chip8_pc(), 0x206)
end

def test_timer_tick(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x603C)  # V0 = 60
  _write_op(0x202, 0xF015)  # delay_timer = V0
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("Fx15 sets delay timer", chip8::chip8_delay(), 60)
  chip8::chip8_tick_timers()
  chip8::chip8_tick_timers()
  chip8::chip8_tick_timers()
  _expect_eq("timer decrements", chip8::chip8_delay(), 57)
end

# ---------------------------------------------------------------------------
# Integration test — the smallest CHIP-8 demo ROM: an infinite loop
# that draws font "0" over and over. Verifies the decoder + DRW work
# at multi-instruction scale.
# ---------------------------------------------------------------------------

def test_step_frame_draws(): Void
  chip8::chip8_init()
  _write_op(0x200, 0x6000)  # V0 = 0
  _write_op(0x202, 0xF029)  # I = font[0]
  _write_op(0x204, 0x6100)  # V1 = 0
  _write_op(0x206, 0x6200)  # V2 = 0
  _write_op(0x208, 0xD125)  # DRW
  _write_op(0x20A, 0x1208)  # JP 0x208  (re-draw in place — 2nd draw XORs display back to zero)
  # Run 5 instructions (one warmup + one draw), then check display.
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  chip8::chip8_step()
  _expect_eq("after 1st DRW, pixel (0,0) is on", chip8::chip8_display_read(0), 1)
  # Advance into the loop: JP → DRW → display XORs back off.
  chip8::chip8_step()  # JP 0x208
  chip8::chip8_step()  # DRW again
  _expect_eq("after 2nd DRW, pixel (0,0) back off", chip8::chip8_display_read(0), 0)
  _expect_eq("collision flag set", chip8::chip8_v(0xF), 1)
end

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main(): Int
  puts("=== CHIP-8 emulator smoke tests ===")
  test_ld_imm()
  test_add_imm()
  test_add_imm_wrap()
  test_jp()
  test_call_ret()
  test_skip_eq()
  test_skip_ne()
  test_arith_or_and_xor()
  test_arith_add_carry()
  test_arith_sub_borrow()
  test_shift()
  test_ld_i_imm()
  test_font_draw()
  test_bcd()
  test_skip_key()
  test_timer_tick()
  test_step_frame_draws()
  puts("")
  puts("=== Result: #{g_passed} passed, #{g_failed} failed ===")
  if g_failed > 0
    return 1
  end
  return 0
end
