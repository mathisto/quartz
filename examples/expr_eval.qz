##! Expression Evaluator — Quartz Compiler Smoke Test (Part 2)
##!
##! Complements examples/brainfuck.qz by exercising language features
##! that don't fit naturally into a brainfuck interpreter.
##!
##! FEATURE MANIFEST:
##!   Type system: generics, traits, bounded generics,
##!                @value structs, type aliases
##!   Functions:   multi-clause with guards, closures capturing state,
##!                extend blocks (impl Int), pipeline operator (|>),
##!                named/default arguments
##!   Control:     or-patterns in match, labeled loops (break :label),
##!                pattern binding (if Some(v) = expr)
##!   Expressions: block expressions (do..end), bitwise operators,
##!                spread operator, const/static_assert, $assert macro,
##!                $try macro, map comprehension
##!
##! COMBINED COVERAGE (brainfuck.qz + expr_eval.qz):
##!   Together these two programs exercise 50+ distinct language features
##!   across the full compiler pipeline.

## ──────────────────────────────────────────────────────────────────────
## FEATURE: const declarations + static_assert (compile-time evaluation)
## Exercises: const eval at compile time, static_assert aborts compile
##            if condition is false. Pipeline: parser (const/static_assert
##            syntax) -> mir_const_eval -> codegen (elided at runtime)
## ──────────────────────────────────────────────────────────────────────

## Note: we avoid `import traits` here because examples/traits.qz
## shadows std/traits.qz when compiling from this directory.
## Instead, @derive(Eq) is tested via a manual op_eq to avoid the dependency.

const MAX_DEPTH = 64
const ADD_PREC = 1
const MUL_PREC = 2
static_assert(MAX_DEPTH > 0, "MAX_DEPTH must be positive")
static_assert(MUL_PREC > ADD_PREC, "multiplication must bind tighter than addition")

## ──────────────────────────────────────────────────────────────────────
## FEATURE: type alias (transparent compile-time synonym)
## Exercises: type alias registration, alias resolution in annotations.
##            Env is just Int at runtime (a Map handle).
## ──────────────────────────────────────────────────────────────────────

type Env = Int

## ──────────────────────────────────────────────────────────────────────
## FEATURES: enum (simple, no payloads), or-patterns in match
## Exercises: enum variant tag codegen, or-pattern desugaring in match
## ──────────────────────────────────────────────────────────────────────

enum OpKind
  Add
  Sub
  Mul
  Div
  Mod
  BitAnd
  BitOr
  BitXor
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: enum with recursive payloads (AST nodes)
## Exercises: enum variant construction with multiple fields, recursive
##            enum types (Expr contains Expr), tag+payload layout
## ──────────────────────────────────────────────────────────────────────

enum Expr
  Num(value: Int)
  BinOp(op: OpKind, left: Expr, right: Expr)
  Neg(inner: Expr)
  Var(name: String)
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: @value struct (stack-allocated, register-decomposed)
## Exercises: @value attribute, stack alloca (not heap malloc), field
##            access on stack struct, parameter decomposition
## ──────────────────────────────────────────────────────────────────────

@value
struct Pos
  line: Int
  col: Int
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: Struct definition, manual field-by-field equality
## Exercises: struct with multiple fields, function comparing struct fields,
##            logical AND in field comparison
## ──────────────────────────────────────────────────────────────────────

struct Token
  kind: Int
  value: Int
end

## Manual equality (replaces @derive(Eq) which needs import traits)
def token_eq(a: Token, b: Token): Bool
  return a.kind == b.kind and a.value == b.value
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: trait definition + impl for custom type
## Exercises: trait method registration, impl block for enum,
##            method dispatch via UFCS on trait impl
## ──────────────────────────────────────────────────────────────────────

trait Describable
  def describe(self): String
end

extend OpKind with Describable
  def describe(self): String
    match self
      Add => { return "+" }
      Sub => { return "-" }
      Mul => { return "*" }
      Div => { return "/" }
      Mod => { return "%" }
      BitAnd => { return "&" }
      BitOr => { return "|" }
      BitXor => { return "^" }
    end
    return "?"
  end
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: bounded generics (def func<T: Trait>(x: T))
## Exercises: generic type parameter with trait bound, monomorphization
##            of bounded generic, trait method dispatch through bound
## ──────────────────────────────────────────────────────────────────────

def show_desc<T: Describable>(x: T): String
  return x.describe()
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: multi-clause functions, guards (when keyword)
## Exercises: clause merging (multiple def with same name), integer
##            literal patterns in param position, guard condition eval
## ──────────────────────────────────────────────────────────────────────

def fib(0): Int = 0
def fib(1): Int = 1
def fib(n: Int): Int = fib(n - 1) + fib(n - 2)

def classify(n: Int): String when n < 0 = "negative"
def classify(n: Int): String when n == 0 = "zero"
def classify(n: Int): String = "positive"

## ──────────────────────────────────────────────────────────────────────
## FEATURE: extend block (impl for primitive type)
## Exercises: adding methods to Int, self keyword in extension,
##            UFCS dispatch to extension methods, method chaining
## ──────────────────────────────────────────────────────────────────────

extend Int
  def abs_val(): Int
    if self < 0
      return 0 - self
    end
    return self
  end
  def clamp(lo: Int, hi: Int): Int
    if self < lo
      return lo
    end
    if self > hi
      return hi
    end
    return self
  end
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: or-patterns in match, bitwise operators
## Exercises: | syntax in match arms (multiple patterns per arm),
##            & | ^ operators compiling to LLVM and/or/xor
## ──────────────────────────────────────────────────────────────────────

def op_is_additive(op: OpKind): Bool
  ## FEATURE: or-pattern — Add | Sub matches either variant
  match op
    Add | Sub => { return true }
    _ => { return false }
  end
end

def eval_op(op: OpKind, left: Int, right: Int): Int
  match op
    Add => { return left + right }
    Sub => { return left - right }
    Mul => { return left * right }
    Div => { return left / right }
    Mod => { return left % right }
    ## FEATURE: bitwise operators (&, |, ^)
    BitAnd => { return left & right }
    BitOr => { return left | right }
    BitXor => { return left ^ right }
  end
  return 0
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: recursive match on enum, pattern binding (if Some(v) = expr),
##           $assert macro, default arguments
## Exercises: multi-level enum match with payload destructuring,
##            Option pattern binding in if condition, $assert expansion,
##            default arg on depth parameter
## ──────────────────────────────────────────────────────────────────────

def eval_expr(expr: Expr, env: Env, depth: Int = 0): Int
  ## FEATURE: $assert macro — panics if condition fails
  $assert(depth < MAX_DEPTH)

  match expr
    Num(v) => { return v }
    Neg(inner) => { return 0 - eval_expr(inner, env, depth + 1) }
    BinOp(op, left, right) => {
      l = eval_expr(left, env, depth + 1)
      r = eval_expr(right, env, depth + 1)
      return eval_op(op, l, r)
    }
    Var(name) => {
      ## FEATURE: pattern binding — if Some(v) = option_expr
      if Some(v) = map_get(env, name)
        return v
      end
      puts("  ERROR: undefined variable '#{name}'")
      return 0
    }
  end
  return 0
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: $try macro (early return on None/Err)
## Exercises: $try expansion — extract payload or early-return Option
## ──────────────────────────────────────────────────────────────────────

def add_vars(env: Env, k1: String, k2: String): Option<Int>
  v1 = try map_get(env, k1)
  v2 = try map_get(env, k2)
  return Option::Some(v1 + v2)
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: pipeline operator (|>)
## Exercises: |> parse and desugar (prepends left as first arg)
## ──────────────────────────────────────────────────────────────────────

def pipe_double(n: Int): Int = n * 2
def pipe_add(n: Int, offset: Int): Int = n + offset

## ──────────────────────────────────────────────────────────────────────
## FEATURE: labeled loops (:label for ... break :label)
## Exercises: label registration, break-to-label across nested loops
## ──────────────────────────────────────────────────────────────────────

def find_pair(nums: Vec<Int>, target: Int): Int
  :outer for i in 0..nums.size
    for j in 0..nums.size
      if i != j and nums[i] + nums[j] == target
        break :outer
      end
    end
  end
  return target
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: block expression (do..end as value-producing expression)
## Exercises: do..end block parse in expression position, last
##            expression becomes block value
## ──────────────────────────────────────────────────────────────────────

def compute_block(): Int
  result = do
    var acc = 0
    for i in 0..10
      acc += i
    end
    acc
  end
  return result
end

## ──────────────────────────────────────────────────────────────────────
## FEATURE: spread operator ([...a, ...b])
## Exercises: spread desugar (creates new Vec, copies elements)
## ──────────────────────────────────────────────────────────────────────

def merge_vecs(a: Vec<Int>, b: Vec<Int>): Vec<Int>
  return [...a, ...b]
end

## ──────────────────────────────────────────────────────────────────────
## FEATURES: closures (capturing outer state), arrow lambda syntax
## Exercises: closure creation (tagged pointer), capture-by-value,
##            arrow syntax parse, runtime closure call
## ──────────────────────────────────────────────────────────────────────

def make_adder(base: Int): Fn(Int): Int
  return n: Int -> n + base
end

## ──────────────────────────────────────────────────────────────────────
## Main — ties everything together
## ──────────────────────────────────────────────────────────────────────

def main(): Int
  puts("=== Expression Evaluator ===")
  puts("=== Quartz Compiler Smoke Test (Part 2) ===")
  puts("")

  var passed = 0
  var total = 0

  ## --- const + static_assert ---
  puts("  const/static_assert:")
  total += 1
  if MAX_DEPTH == 64 and ADD_PREC == 1 and MUL_PREC == 2
    puts("    PASS: compile-time constants")
    passed += 1
  end

  ## --- type alias ---
  puts("  type alias:")
  total += 1
  var env: Env = map_new()
  map_set(env, "x", 10)
  map_set(env, "y", 20)
  puts("    PASS: Env type alias")
  passed += 1

  ## --- @value struct ---
  puts("  @value struct:")
  total += 1
  var p = Pos { line: 1, col: 5 }
  if p.line == 1 and p.col == 5
    puts("    PASS: Pos { #{p.line}, #{p.col} }")
    passed += 1
  end

  ## --- struct equality ---
  puts("  struct equality:")
  total += 1
  t1 = Token { kind: 1, value: 42 }
  t2 = Token { kind: 1, value: 42 }
  t3 = Token { kind: 2, value: 99 }
  if token_eq(t1, t2) and not token_eq(t1, t3)
    puts("    PASS: manual struct equality")
    passed += 1
  end

  ## --- trait + bounded generics ---
  puts("  trait + bounded generics:")
  total += 1
  desc = show_desc(OpKind::Add)
  if desc == "+"
    puts("    PASS: show_desc<Describable>(Add) = '#{desc}'")
    passed += 1
  end

  ## --- multi-clause functions ---
  puts("  multi-clause functions:")
  total += 1
  if fib(0) == 0 and fib(1) == 1 and fib(10) == 55
    puts("    PASS: fib(10) = 55")
    passed += 1
  end
  total += 1
  if classify(0 - 5) == "negative" and classify(0) == "zero" and classify(7) == "positive"
    puts("    PASS: classify with guards")
    passed += 1
  end

  ## --- extend block ---
  puts("  extend block (impl Int):")
  total += 1
  neg = 0 - 42
  if neg.abs_val() == 42 and 150.clamp(0, 100) == 100
    puts("    PASS: abs_val + clamp")
    passed += 1
  end

  ## --- expression evaluation (bitwise + pattern binding) ---
  puts("  expression evaluation:")
  total += 1
  expr1 = Expr::BinOp(OpKind::Add, Expr::Num(3), Expr::BinOp(OpKind::Mul, Expr::Num(5), Expr::Num(2)))
  if eval_expr(expr1, env) == 13
    puts("    PASS: 3 + 5*2 = 13")
    passed += 1
  end

  total += 1
  expr2 = Expr::BinOp(OpKind::Add, Expr::Var("x"), Expr::Var("y"))
  if eval_expr(expr2, env) == 30
    puts("    PASS: x+y = 30 (env lookup)")
    passed += 1
  end

  total += 1
  expr3 = Expr::BinOp(OpKind::BitAnd, Expr::Num(255), Expr::Num(15))
  if eval_expr(expr3, env) == 15
    puts("    PASS: 0xFF & 0x0F = 15 (bitwise)")
    passed += 1
  end

  total += 1
  expr4 = Expr::Neg(Expr::Num(42))
  if eval_expr(expr4, env) == (0 - 42)
    puts("    PASS: -(42) = -42")
    passed += 1
  end

  ## --- $try macro ---
  puts("  $try macro:")
  total += 1
  result_opt = add_vars(env, "x", "y")
  match result_opt
    Some(v) => {
      if v == 30
        puts("    PASS: $try(x) + $try(y) = 30")
        passed += 1
      end
    }
    None => { puts("    FAIL: $try returned None") }
  end

  ## --- pipeline ---
  puts("  pipeline operator:")
  total += 1
  piped = 5 |> pipe_double |> pipe_add(3)
  if piped == 13
    puts("    PASS: 5 |> double |> add(3) = 13")
    passed += 1
  end

  ## --- or-patterns ---
  puts("  or-patterns:")
  total += 1
  if op_is_additive(OpKind::Add) and op_is_additive(OpKind::Sub) and not op_is_additive(OpKind::Mul)
    puts("    PASS: Add|Sub additive, Mul not")
    passed += 1
  end

  ## --- labeled loops ---
  puts("  labeled loops:")
  total += 1
  nums = [1, 4, 7, 11, 13]
  val = find_pair(nums, 18)
  if val == 18
    puts("    PASS: find_pair with :outer break")
    passed += 1
  end

  ## --- block expression ---
  puts("  block expression:")
  total += 1
  bval = compute_block()
  if bval == 45
    puts("    PASS: do..end = 45 (sum 0..9)")
    passed += 1
  end

  ## --- spread ---
  puts("  spread operator:")
  total += 1
  a = [1, 2, 3]
  b = [4, 5]
  merged = merge_vecs(a, b)
  if merged.size == 5 and merged[0] == 1 and merged[-1] == 5
    puts("    PASS: [...a, ...b] size=5")
    passed += 1
  end

  ## --- closure ---
  puts("  closure (capture):")
  total += 1
  add5 = make_adder(5)
  if add5(10) == 15
    puts("    PASS: make_adder(5)(10) = 15")
    passed += 1
  end

  ## --- $assert ---
  puts("  $assert macro:")
  total += 1
  $assert(1 + 1 == 2)
  $assert(MAX_DEPTH == 64)
  puts("    PASS: assertions hold")
  passed += 1

  ## --- pattern binding ---
  puts("  pattern binding:")
  total += 1
  opt = map_get(env, "x")
  if Some(v) = opt
    if v == 10
      puts("    PASS: if Some(v)=opt => v=#{v}")
      passed += 1
    end
  end

  ## --- named arguments ---
  puts("  named/default arguments:")
  total += 1
  r = eval_expr(Expr::Num(99), env, depth: 5)
  if r == 99
    puts("    PASS: eval(Num(99), depth: 5) = 99")
    passed += 1
  end

  puts("")
  puts("  #{passed}/#{total} passed")
  map_free(env)

  if passed < total
    return 1
  end
  return 0
end
