##! JSON Parser - Tokenizer and type classifier for JSON
##!
##! Demonstrates: const declarations, while loops, for-in loops,
##! string character-level processing (str_char_at, str_len, str_eq),
##! Vec operations, StringBuilder, compound assignment, break/continue,
##! pattern matching via if-chains, and multi-function composition.
##!
##! Tokenizes JSON into a stream of typed tokens (strings, numbers,
##! booleans, null, punctuation), then classifies the top-level value.

## JSON token types
const TOK_LBRACE = 1
const TOK_RBRACE = 2
const TOK_LBRACKET = 3
const TOK_RBRACKET = 4
const TOK_COLON = 5
const TOK_COMMA = 6
const TOK_STRING = 7
const TOK_NUMBER = 8
const TOK_TRUE = 9
const TOK_FALSE = 10
const TOK_NULL = 11

## Check if character is a digit ('0'-'9')
def is_digit(ch: Int): Int
  if ch >= '0' and ch <= '9'
    return 1
  end
  return 0
end

## Check if character is whitespace
def is_ws(ch: Int): Int
  if ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r'
    return 1
  end
  return 0
end

## Tokenize a JSON string.
## Returns two parallel Vecs: token_types (Int) and token_values (String).
## Both are stored in a single Vec as [types_vec, values_vec].
def json_tokenize(src: String): Int
  var types = vec_new<Int>()
  var values = vec_new<String>()
  var pos = 0
  len = str_size(src)

  while pos < len
    ch = str_char_at(src, pos)

    ## Skip whitespace
    if is_ws(ch)
      pos += 1
      continue
    end

    ## Structural tokens
    if ch == '{'
      types.push(TOK_LBRACE)
      values.push("{")
      pos += 1
      continue
    end
    if ch == '}'
      types.push(TOK_RBRACE)
      values.push("}")
      pos += 1
      continue
    end
    if ch == '['
      types.push(TOK_LBRACKET)
      values.push("[")
      pos += 1
      continue
    end
    if ch == ']'
      types.push(TOK_RBRACKET)
      values.push("]")
      pos += 1
      continue
    end
    if ch == ':'
      types.push(TOK_COLON)
      values.push(":")
      pos += 1
      continue
    end
    if ch == ','
      types.push(TOK_COMMA)
      values.push(",")
      pos += 1
      continue
    end

    ## String literal: "..."
    if ch == '"'
      var sb = sb_new()
      pos += 1
      while pos < len
        c = str_char_at(src, pos)
        if c == '"'
          pos += 1
          break
        end
        if c == '\\' and pos + 1 < len
          ## Escape sequence
          pos += 1
          esc = str_char_at(src, pos)
          if esc == 'n'
            sb.append_char('\n')
          elsif esc == 't'
            sb.append_char('\t')
          elsif esc == '"'
            sb.append_char('"')
          elsif esc == '\\'
            sb.append_char('\\')
          else
            sb.append_char(esc)
          end
        else
          sb.append_char(c)
        end
        pos += 1
      end
      types.push(TOK_STRING)
      values.push(sb.to_string())
      sb.free()
      continue
    end

    ## Number (possibly negative)
    var neg_start = 0
    if ch == '-' and pos + 1 < len
      if is_digit(str_char_at(src, pos + 1))
        neg_start = 1
      end
    end
    if is_digit(ch) or neg_start
      var sb = sb_new()
      if ch == '-'
        sb.append_char('-')
        pos += 1
      end
      while pos < len and is_digit(str_char_at(src, pos))
        sb.append_char(str_char_at(src, pos))
        pos += 1
      end
      types.push(TOK_NUMBER)
      values.push(sb.to_string())
      sb.free()
      continue
    end

    ## Keywords: true (starts with 't')
    if ch == 't' and pos + 3 < len
      types.push(TOK_TRUE)
      values.push("true")
      pos += 4
      continue
    end

    ## false (starts with 'f')
    if ch == 'f' and pos + 4 < len
      types.push(TOK_FALSE)
      values.push("false")
      pos += 5
      continue
    end

    ## null (starts with 'n')
    if ch == 'n' and pos + 3 < len
      types.push(TOK_NULL)
      values.push("null")
      pos += 4
      continue
    end

    ## Unknown — skip
    pos += 1
  end

  ## Return as pair: (types, values) tuple
  return (types, values)
end

## Get token type name
def tok_type_name(t: Int): String
  if t == TOK_LBRACE
    return "{"
  elsif t == TOK_RBRACE
    return "}"
  elsif t == TOK_LBRACKET
    return "["
  elsif t == TOK_RBRACKET
    return "]"
  elsif t == TOK_COLON
    return ":"
  elsif t == TOK_COMMA
    return ","
  elsif t == TOK_STRING
    return "string"
  elsif t == TOK_NUMBER
    return "number"
  elsif t == TOK_TRUE
    return "true"
  elsif t == TOK_FALSE
    return "false"
  elsif t == TOK_NULL
    return "null"
  end
  return "?"
end

## Classify the top-level JSON value from the first token
def classify_json(first_type: Int): String
  if first_type == TOK_LBRACE
    return "object"
  elsif first_type == TOK_LBRACKET
    return "array"
  elsif first_type == TOK_STRING
    return "string"
  elsif first_type == TOK_NUMBER
    return "number"
  elsif first_type == TOK_TRUE or first_type == TOK_FALSE
    return "boolean"
  elsif first_type == TOK_NULL
    return "null"
  end
  return "unknown"
end

## Count elements in a top-level array or object (shallow, not recursive).
## Counts commas at depth 0 and adds 1(unless empty).
def count_elements(types: Int): Int
  count = vec_size(types)
  if count <= 2
    return 0
  end
  first = vec_get(types, 0)
  if first == TOK_LBRACE or first == TOK_LBRACKET
    var depth = 0
    var elements = 0
    for i in 0..count
      t = vec_get(types, i)
      if t == TOK_LBRACE or t == TOK_LBRACKET
        depth += 1
      elsif t == TOK_RBRACE or t == TOK_RBRACKET
        depth -= 1
      elsif t == TOK_COMMA and depth == 1
        elements += 1
      end
    end
    return elements + 1
  end
  return 1
end

## Demo: tokenize and analyze a JSON input
def demo(label: String, input: String): Void
  puts("  " + label + ":")
  puts("    Input:  " + input)

  var (types, values) = json_tokenize(input)
  count = vec_size(types)

  puts("    Tokens: #{count}")

  if count > 0
    first_type = vec_get(types, 0)
    puts("    Type:   " + classify_json(first_type))
  end

  ## Show token stream
  var sb = sb_new()
  sb.append("    Stream: ")
  for i in 0..count
    if i > 0
      sb.append(" ")
    end
    t = vec_get(types, i)
    if t == TOK_STRING
      sb.append("\"")
      sb.append(vec_get(values, i))
      sb.append("\"")
    elsif t == TOK_NUMBER
      sb.append(vec_get(values, i))
    else
      sb.append(tok_type_name(t))
    end
  end
  puts(sb.to_string())
  sb.free()

  elems = count_elements(types)
  if elems > 0
    puts("    Elements: #{elems}")
  end

  vec_free(types)
  vec_free(values)
  puts("")
end

def main(): Int
  puts("=== JSON Parser ===")
  puts("")

  ## Simple values
  puts("Simple values:")
  demo("null", "null")
  demo("true", "true")
  demo("number", "42")
  demo("negative", "-17")
  demo("string", "\"hello world\"")

  ## Arrays
  puts("Arrays:")
  demo("empty", "[]")
  demo("ints", "[1, 2, 3]")
  demo("mixed", "[1, \"two\", true, null]")

  ## Objects
  puts("Objects:")
  demo("empty", "{}")
  demo("simple", "{\"name\": \"Quartz\", \"version\": 1}")
  demo("nested", "{\"point\": {\"x\": 10, \"y\": 20}}")

  ## Stress
  puts("Larger JSON:")
  large = "{\"users\": [{\"id\": 1, \"name\": \"Alice\"}, {\"id\": 2, \"name\": \"Bob\"}], \"count\": 2}"
  demo("users", large)

  return 0
end
