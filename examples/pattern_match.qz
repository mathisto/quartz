##! Pattern Matching - Enums, Option, wildcards, and exhaustiveness
##!
##! Demonstrates: enum definition, payloads, match expressions,
##! wildcards, exhaustive matching, multi-statement arms.

enum Color
  Red
  Green
  Blue
end

enum Shape
  Circle(radius: Int)
  Rectangle(width: Int, height: Int)
  Point
end

## Approximate area of a shape.
def shape_area(s: Shape): Int
  match s
    Circle(r) => r * r * 3
    Rectangle(w, h) => w * h
    Point => 0
  end
end

def shape_name(s: Shape): String
  match s
    Circle(r) => "circle"
    Rectangle(w, h) => "rectangle"
    Point => "point"
  end
end

## Exhaustive color matching.
def color_code(c: Color): Int
  match c
    Red => 31
    Green => 32
    Blue => 34
  end
end

## Integer matching requires a wildcard.
def describe_number(n: Int): String
  match n
    0 => "zero"
    1 => "one"
    _ => "many"
  end
end

## Option-style safe division.
enum MaybeInt
  Just(value: Int)
  Nothing
end

def safe_divide(a: Int, b: Int): MaybeInt
  if b == 0
    return MaybeInt::Nothing
  end
  return MaybeInt::Just(a / b)
end

def main(): Int
  puts("=== Pattern Matching ===")
  puts("")
  puts("Colors: Red=#{color_code(Color::Red)}, Green=#{color_code(Color::Green)}, Blue=#{color_code(Color::Blue)}")
  puts("")
  puts("Shapes:")
  puts("  circle area = #{shape_area(Shape::Circle(5))}")
  puts("  rect area   = #{shape_area(Shape::Rectangle(4, 6))}")
  puts("  point area  = #{shape_area(Shape::Point)}")
  puts("")
  puts("Safe division:")
  match safe_divide(10, 3)
    Just(v) => puts("  10/3 = #{v}")
    Nothing => puts("  10/3 = undefined")
  end
  match safe_divide(10, 0)
    Just(v) => puts("  10/0 = #{v}")
    Nothing => puts("  10/0 = undefined (div by zero)")
  end
  return 0
end
