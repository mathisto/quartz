##! FFI Demo - Calling C functions from Quartz
##!
##! Demonstrates: extern "C" declarations, CPtr operations,
##! string interop, pointer arithmetic, and memory management.

extern "C" def strlen(s: CPtr): Int
extern "C" def memset(ptr: CPtr, c: Int, n: Int): CPtr
extern "C" def memcpy(dst: CPtr, src: CPtr, n: Int): CPtr

def main(): Int
  puts("=== FFI Demo ===")
  puts("")

  # 1. String interop
  puts("1. String interop:")
  qz_str = "Hello from Quartz!"
  cstr = string_to_cstr(qz_str)
  puts("  strlen = #{strlen(cstr)}")
  roundtrip = cstr_to_string(cstr)
  puts("  roundtrip match = #{qz_str == roundtrip}")
  puts("")

  # 2. Buffer fill with memset
  puts("2. memset fill:")
  buf = qz_malloc(8)
  memset(buf, 65, 8)
  var sb = sb_new()
  for i in 0..8
    sb.append_char(ptr_read_byte(ptr_add(buf, i)))
  end
  puts("  filled: #{sb.to_string()}")
  sb.free()
  qz_free(buf)
  puts("")

  # 3. Pointer arithmetic - build string byte by byte
  puts("3. Pointer arithmetic:")
  buf2 = qz_malloc(6)
  ptr_write_byte(buf2, 72)
  ptr_write_byte(ptr_add(buf2, 1), 101)
  ptr_write_byte(ptr_add(buf2, 2), 108)
  ptr_write_byte(ptr_add(buf2, 3), 108)
  ptr_write_byte(ptr_add(buf2, 4), 111)
  ptr_write_byte(ptr_add(buf2, 5), 0)
  puts("  built: #{cstr_to_string(buf2)}")
  qz_free(buf2)
  puts("")

  # 4. memcpy between buffers
  puts("4. memcpy:")
  src = qz_malloc(8)
  dst = qz_malloc(8)
  for i in 0..8
    ptr_write_byte(ptr_add(src, i), 48 + i)
  end
  memcpy(dst, src, 8)
  var sb2 = sb_new()
  for i in 0..8
    sb2.append_char(ptr_read_byte(ptr_add(dst, i)))
  end
  puts("  copied: #{sb2.to_string()}")
  sb2.free()
  qz_free(src)
  qz_free(dst)
  puts("")

  # 5. Pointer/Int conversion
  puts("5. Ptr/Int conversion:")
  buf3 = qz_malloc(8)
  ptr_write_byte(buf3, 42)
  addr = cptr_to_int(buf3)
  recovered = int_to_cptr(addr)
  puts("  read via roundtrip: #{ptr_read_byte(recovered)}")
  qz_free(buf3)
  return 0
end
