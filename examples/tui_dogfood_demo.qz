## Demo for TUI.DOGFOOD Phase 1 + 2 + 3a — sub-cell widgets.
##
## Run:
##   ./self-hosted/bin/quartz examples/tui_dogfood_demo.qz | \
##     opt -passes='internalize,globaldce' --internalize-public-api-list=main -S | \
##     llc -filetype=obj -o /tmp/d.o && clang /tmp/d.o -o /tmp/d -lm -lpthread && /tmp/d

import std/tui/widgets/progress as pg
import std/tui/widgets/spinner as sp
import * from progress

def main(): Int
  puts("")
  puts("══════════════════════════════════════════════════════════════")
  puts("  Phase 1 — eighth-block progress bar (8× sub-cell precision)")
  puts("══════════════════════════════════════════════════════════════")
  puts("")
  puts("  Same widget, walking 0/16 → 16/16 over a 2-cell-wide bar.")
  puts("  Watch the leading edge advance one eighth-block at a time:")
  puts("")

  var i = 0
  while i <= 16
    var p = pg::progress_bar_with_size(pg::progress_bar_new(i, 16), 2)
    puts("    " + pg::progress_bar_view(p))
    i = i + 1
  end

  puts("")
  puts("  And on a 30-cell bar (qspec uses width=30):")
  puts("")
  var pcts = vec_new<Int>()
  pcts.push(13); pcts.push(27); pcts.push(50); pcts.push(63); pcts.push(78); pcts.push(91); pcts.push(100)
  for pct in pcts
    var p2 = pg::progress_bar_with_size(pg::progress_bar_new(pct, 100), 30)
    puts("    " + pg::progress_bar_view(p2))
  end

  puts("")
  puts("══════════════════════════════════════════════════════════════")
  puts("  Phase 2 — octant spinner frames (Unicode 17 sub-cell)")
  puts("══════════════════════════════════════════════════════════════")
  puts("")

  puts("  Rotor (default for spinner_new — 8 frames, sub-pixel rotates")
  puts("  clockwise around the cell perimeter):")
  puts("")
  var rotor = sp::spinner_octant_rotor()
  var ri = 0
  var rotor_line = "    "
  while ri < rotor.size
    rotor_line = rotor_line + rotor[ri] + "  "
    ri = ri + 1
  end
  puts(rotor_line)

  puts("")
  puts("  Pulse (4 frames, ping-pong empty → mid → full → mid):")
  puts("")
  var pulse = sp::spinner_octant_pulse()
  var pi = 0
  var pulse_line = "    "
  while pi < pulse.size
    pulse_line = pulse_line + pulse[pi] + "  "
    pi = pi + 1
  end
  puts(pulse_line)

  puts("")
  puts("  Scan (4 frames, scan line top → bottom):")
  puts("")
  var scan = sp::spinner_octant_scan()
  var si = 0
  var scan_line = "    "
  while si < scan.size
    scan_line = scan_line + scan[si] + "  "
    si = si + 1
  end
  puts(scan_line)

  puts("")
  puts("══════════════════════════════════════════════════════════════")
  puts("  Phase 3a — qspec / Progress eighth-block retrofit")
  puts("══════════════════════════════════════════════════════════════")
  puts("")
  puts("  std/progress.qz's progress_bar_string (used by qspec progress")
  puts("  mode + Progress task reporter) now also uses eighth-block")
  puts("  precision. Same input would have rendered chunky █░ before:")
  puts("")
  var i2 = 0
  while i2 <= 16
    puts("    " + progress_bar_string(i2, 16, 10))
    i2 = i2 + 2
  end

  puts("")
  return 0
end
