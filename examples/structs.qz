##! Structs - Definition, field access, impl blocks, methods
##!
##! Demonstrates: struct definition, struct literals, field access,
##! impl blocks with self, associated functions, method chaining, UFCS.

struct Point
  x: Int
  y: Int
end

extend Point
  def manhattan(): Int = @x + @y
  def scale(factor: Int): Point
    return Point { x: @x * factor, y: @y * factor }
  end
  def translate(dx: Int, dy: Int): Point
    return Point { x: @x + dx, y: @y + dy }
  end
end

def Point.origin(): Point = Point { x: 0, y: 0 }

struct Rect
  origin: Point
  sz: Point
end

extend Rect
  def area(): Int = @sz.x * @sz.y
end

## A stack backed by a vector.
struct Stack
  data: Vec<Int>
end

def Stack.new(): Stack = Stack { data: vec_new() }

extend Stack
  def push(val: Int): Void = @data.push(val)
  def pop(): Int = @data.pop()
  def peek(): Int = @data[@data.size - 1]
  def stack_size(): Int = @data.size
end

def main(): Int
  puts("=== Structs & Methods ===")
  puts("")
  p = Point { x: 3, y: 4 }
  puts("p = (#{p.x}, #{p.y})")
  puts("manhattan = #{p.manhattan()}")
  puts("")
  q = Point.origin().translate(5, 10).scale(2)
  puts("origin -> translate(5,10) -> scale(2)")
  puts("= (#{q.x}, #{q.y})")
  puts("")
  r = Rect {
    origin: Point { x: 10, y: 20 },
    sz: Point { x: 30, y: 40 }
  }
  puts("rect area = #{r.area()}")
  puts("")
  puts("Stack:")
  var s = Stack.new()
  s.push(10)
  s.push(20)
  s.push(30)
  puts("  pushed 10, 20, 30")
  puts("  size = #{s.stack_size()}")
  puts("  peek = #{s.peek()}")
  popped = s.pop()
  puts("  pop = #{popped}")
  puts("  size after pop = #{s.stack_size()}")
  vec_free(s.data)
  return 0
end
