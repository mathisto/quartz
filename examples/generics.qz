##! Generics - Generic functions, Vec operations, and type parameters
##!
##! Demonstrates: generic functions, type parameters, Vec operations,
##! generic enums, reusable data structures, UFCS.

def identity<T>(x: T): T = x

struct Pair
  first: Int
  second: Int
end

def make_pair(a: Int, b: Int): Pair = Pair { first: a, second: b }
def swap_pair(p: Pair): Pair = Pair { first: p.second, second: p.first }

def max_of(a: Int, b: Int): Int
  if a > b
    return a
  end
  return b
end

def min_of(a: Int, b: Int): Int
  if a < b
    return a
  end
  return b
end

def clamp(x: Int, lo: Int, hi: Int): Int = max_of(lo, min_of(x, hi))

## Build a range vector [start, stop).
def make_range(start: Int, stop: Int): Vec<Int>
  var v = vec_new()
  for i in start..stop
    v.push(i)
  end
  return v
end

def vec_sum(v: Vec<Int>): Int
  var total = 0
  for i in 0..v.size
    total += v[i]
  end
  return total
end

def vec_max(v: Vec<Int>): Int
  var best = v[0]
  for i in 1..v.size
    if v[i] > best
      best = v[i]
    end
  end
  return best
end

## A generic-style Option.
enum Maybe
  Some(value: Int)
  Nothing
end

def vec_get_safe(v: Vec<Int>, idx: Int): Maybe
  if idx < 0 or idx >= v.size
    return Maybe::Nothing
  end
  return Maybe::Some(v[idx])
end

def main(): Int
  puts("=== Generics & Vectors ===")
  puts("")
  puts("identity(42) = #{identity(42)}")
  p = make_pair(10, 20)
  q = swap_pair(p)
  puts("pair (10,20) swapped = (#{q.first},#{q.second})")
  puts("clamp(15, 0, 10) = #{clamp(15, 0, 10)}")
  puts("")
  numbers = make_range(1, 11)
  puts("range(1,11): #{numbers.size} elements")
  puts("  sum = #{vec_sum(numbers)}")
  puts("  max = #{vec_max(numbers)}")
  match vec_get_safe(numbers, 0)
    Some(v) => puts("  [0] = #{v}")
    Nothing => puts("  [0] out of bounds")
  end
  match vec_get_safe(numbers, 99)
    Some(v) => puts("  [99] = #{v}")
    Nothing => puts("  [99] out of bounds")
  end
  vec_free(numbers)
  return 0
end
