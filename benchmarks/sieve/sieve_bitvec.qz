# Sieve of Eratosthenes using bit-packed storage (inlined ops)
# Each element uses 1 bit: 10M elements = 1.25 MB (fits in L2 cache!)
# All bit operations manually inlined for zero function-call overhead
#
# Uses intrinsics: alloc, load, store, band, bxor, shl, shr

def main(): Int
  n = 10000000
  # Allocate n/64 words (each word = 64 bits)
  nwords = shr(n + 63, 6)
  ptr = alloc(nwords)
  
  # Initialize all bits to 1
  for i in 0..nwords
    store(ptr, i, -1)
  end
  
  # Clear bit 0 and bit 1
  w0 = load(ptr, 0)
  store(ptr, 0, band(w0, bxor(3, -1)))
  
  # Sieve — inner loop has zero function calls
  var i = 2
  while i * i < n
    # Inline bit_get(i)
    wi = shr(i, 6)
    bi = band(i, 63)
    if band(shr(load(ptr, wi), bi), 1) == 1
      var j = i * i
      while j < n
        # Inline bit_clear(j)
        wj = shr(j, 6)
        bj = band(j, 63)
        word = load(ptr, wj)
        store(ptr, wj, band(word, bxor(shl(1, bj), -1)))
        j += i
      end
    end
    i += 1
  end
  
  # Count primes — inline bit_get
  var count = 0
  for k in 0..n
    wk = shr(k, 6)
    bk = band(k, 63)
    if band(shr(load(ptr, wk), bk), 1) == 1
      count += 1
    end
  end
  puts(str_from_int(count))
  return 0
end
