# Sieve of Eratosthenes — Vec<U8> with vec_new_filled (Memory Model V2)
# 10M elements × 1 byte = 10 MB, initialized in one memset call
# Equivalent to C: char *sieve = malloc(n); memset(sieve, 1, n);

def main(): Int
  var n = 10000000
  var sieve = vec_new_filled<U8>(n, 1)
  sieve[0] = 0
  sieve[1] = 0
  var i = 2
  while i * i < n
    if sieve[i] == 1
      var j = i * i
      while j < n
        sieve[j] = 0
        j += i
      end
    end
    i += 1
  end
  var count = 0
  for k in 0..n
    if sieve[k] == 1
      count += 1
    end
  end
  puts(str_from_int(count))
  return 0
end
