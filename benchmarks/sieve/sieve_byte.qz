# Sieve of Eratosthenes using byte-level memory (same as C)
# Uses qz_malloc + ptr_read_byte/ptr_write_byte for 1 byte per element
# 10M elements = 10 MB (same as C's char array)
# Inner loop is a single ptr_write_byte — identical to C's sieve[j] = 0

def main(): Int
  n = 10000000
  # qz_malloc allocates raw bytes (unlike alloc which does n*8)
  ptr = qz_malloc(n)
  
  # memset: initialize all bytes to 1
  # Use word-level stores for speed: each i64 = 8 bytes of 0x01
  ones = 72340172838076673
  nwords = shr(n, 3)
  var wi = 0
  while wi < nwords
    # Store 8 bytes at once at byte offset wi*8
    wptr = ptr + shl(wi, 3)
    # Cast to i64* and store
    store(wptr, 0, ones)
    wi += 1
  end
  
  # Clear 0 and 1 (not prime)
  ptr_write_byte(ptr, 0)
  ptr_write_byte(ptr + 1, 0)
  
  # Sieve
  var i = 2
  while i * i < n
    if ptr_read_byte(ptr + i) == 1
      var j = i * i
      while j < n
        ptr_write_byte(ptr + j, 0)
        j += i
      end
    end
    i += 1
  end
  
  # Count primes
  var count = 0
  for k in 0..n
    if ptr_read_byte(ptr + k) == 1
      count += 1
    end
  end
  puts(str_from_int(count))
  qz_free(ptr)
  return 0
end
