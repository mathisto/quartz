def main(): Int
  n = 200
  var a = vec_new<Int>()
  var b = vec_new<Int>()
  var c = vec_new<Int>()
  for i in 0..n
    for j in 0..n
      a.push(i + j)
      b.push(i * j)
      c.push(0)
    end
  end
  for i in 0..n
    for j in 0..n
      var sum = 0
      for k in 0..n
        sum += vec_get_unchecked(a, i * n + k) * vec_get_unchecked(b, k * n + j)
      end
      vec_set_unchecked(c, i * n + j, sum)
    end
  end
  puts(str_from_int(vec_get_unchecked(c, 0)))
  return 0
end
