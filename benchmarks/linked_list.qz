# Linked list benchmark — insert/traverse/delete with pointer-based nodes
# Node layout: [next_ptr (offset 0), value (offset 8)]
# Tests: pointer manipulation, sequential access patterns, deallocation

NUM_NODES = 100000
TRAVERSE_ROUNDS = 5

def node_new(val: Int, next: Int): Int
  ptr = alloc(16)
  store(ptr, 0, next)
  store(ptr, 8, val)
  return ptr
end

def node_next(ptr: Int): Int = load(ptr, 0)
def node_val(ptr: Int): Int = load(ptr, 8)
def node_set_next(ptr: Int, next: Int): Void = store(ptr, 0, next)

def main(): Int
  # Phase 1: Build linked list by prepending
  var head = 0
  var i = 0
  while i < NUM_NODES
    head = node_new(i, head)
    i = i + 1
  end

  # Phase 2: Traverse and sum TRAVERSE_ROUNDS times
  var total = 0
  var round = 0
  while round < TRAVERSE_ROUNDS
    var curr = head
    while curr != 0
      total = total + node_val(curr)
      curr = node_next(curr)
    end
    round = round + 1
  end

  # Phase 3: Count nodes
  var count = 0
  var curr = head
  while curr != 0
    count = count + 1
    curr = node_next(curr)
  end

  # Phase 4: Delete every other node (and free the deleted node)
  var prev = head
  curr = node_next(head)
  var deleted = 0
  while curr != 0
    var next = node_next(curr)
    # Skip this node (delete it) and free its memory
    node_set_next(prev, next)
    qz_free(curr)
    deleted = deleted + 1
    # Move to next pair
    if next != 0
      prev = next
      curr = node_next(next)
    else
      curr = 0
    end
  end

  # Phase 5: Count remaining nodes
  var remaining = 0
  curr = head
  while curr != 0
    remaining = remaining + 1
    curr = node_next(curr)
  end

  puts("Nodes: " + str_from_int(count))
  puts("Sum (x" + str_from_int(TRAVERSE_ROUNDS) + "): " + str_from_int(total))
  puts("Deleted: " + str_from_int(deleted))
  puts("Remaining: " + str_from_int(remaining))

  # Phase 6: Free remaining nodes
  curr = head
  while curr != 0
    var next = node_next(curr)
    qz_free(curr)
    curr = next
  end

  return 0
end
