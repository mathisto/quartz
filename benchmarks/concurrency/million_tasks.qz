# Million-Task Benchmark — Quartz M:N Scheduler
#
# Spawns 1,000,000 concurrent tasks on the work-stealing scheduler.
# Each task receives a message, increments it, sends the result back.
# Verifies correctness (sum check) and measures performance.
#
# This benchmark proves Erlang/Go-level scalability:
# - 1M lightweight tasks on ~10 OS threads
# - ~500 MB peak RSS (~500 bytes per task)
# - Lock-free Chase-Lev work-stealing deques
# - Park/wake channel suspension (no fd-per-channel)

def worker(inbox: Int, done: Int): Void
  var val = recv(inbox)
  send(done, val + 1)
end

def main(): Int
  var n = 1000000

  puts("=== Quartz Million-Task Benchmark ===")
  puts("Tasks: #{n.to_s()}")
  puts("")

  var rss_before = mem_current_rss()
  var t0 = time_mono_ns()

  # Phase 1: Spawn 1M tasks
  var inboxes = vec_new()
  var done_ch = channel_new_unbounded()
  var i = 0
  while i < n
    var inbox = channel_new(1)
    inboxes.push(inbox)
    go worker(inbox, done_ch)
    i += 1
  end

  var t_spawn = time_mono_ns()
  var rss_spawned = mem_current_rss()

  # Phase 2: Send a message to each task
  i = 0
  while i < n
    send(inboxes[i], i)
    i += 1
  end

  var t_send = time_mono_ns()

  # Phase 3: Collect all responses
  var total = 0
  i = 0
  while i < n
    var val = recv(done_ch)
    total = total + val
    i += 1
  end

  var t_recv = time_mono_ns()
  sched_shutdown()
  var t_end = time_mono_ns()

  # Metrics
  var spawn_ns = t_spawn - t0
  var send_ns = t_send - t_spawn
  var recv_ns = t_recv - t_send
  var total_ns = t_end - t0
  var spawn_rate = n * 1000000000 / spawn_ns
  var msg_rate = n * 2 * 1000000000 / (send_ns + recv_ns)
  var mem_delta = rss_spawned - rss_before
  var mem_per_task = mem_delta / n
  var peak_rss = mem_peak_rss()

  # Verify
  var expected = n * (n + 1) / 2
  var ok = total == expected

  puts("--- Results ---")
  puts("Spawn:")
  puts("  Time:      #{(spawn_ns / 1000000).to_s()} ms")
  puts("  Rate:      #{spawn_rate.to_s()} tasks/sec")
  puts("  Per task:  #{(spawn_ns / n).to_s()} ns")
  puts("Send:")
  puts("  Time:      #{(send_ns / 1000000).to_s()} ms")
  puts("Recv:")
  puts("  Time:      #{(recv_ns / 1000000).to_s()} ms")
  puts("Messages:")
  puts("  Total:     #{(n * 2).to_s()}")
  puts("  Rate:      #{msg_rate.to_s()} msgs/sec")
  puts("Memory:")
  puts("  RSS delta: #{(mem_delta / 1048576).to_s()} MB")
  puts("  Per task:  #{mem_per_task.to_s()} bytes")
  puts("  Peak RSS:  #{(peak_rss / 1048576).to_s()} MB")
  puts("Total:")
  puts("  Wall time: #{(total_ns / 1000000).to_s()} ms")
  puts("")

  if ok
    puts("Verified: sum correct")
  else
    puts("ERROR: expected #{expected.to_s()}, got #{total.to_s()}")
    return 1
  end

  puts("")
  puts("BENCH:million_tasks:tasks:#{n.to_s()}")
  puts("BENCH:million_tasks:spawn_rate:#{spawn_rate.to_s()}")
  puts("BENCH:million_tasks:msg_rate:#{msg_rate.to_s()}")
  puts("BENCH:million_tasks:mem_per_task:#{mem_per_task.to_s()}")
  puts("BENCH:million_tasks:peak_rss_mb:#{(peak_rss / 1048576).to_s()}")
  puts("BENCH:million_tasks:wall_ms:#{(total_ns / 1000000).to_s()}")
  return 0
end
