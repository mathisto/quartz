# Concurrency Benchmark: Work-Stealing Throughput
# Measures: tasks/sec when main floods global queue, workers steal

def worker(done: Int): Void
  send(done, 1)
end

def main(): Int
  var n = 100000
  var done_ch = channel_new_unbounded()
  var start = time_mono_ns()
  var i = 0
  while i < n
    go worker(done_ch)
    i += 1
  end
  i = 0
  while i < n
    recv(done_ch)
    i += 1
  end
  var elapsed = time_mono_ns() - start
  sched_shutdown()
  var rate = n * 1000000000 / elapsed
  puts("BENCH:steal_throughput:tasks_per_sec:#{rate}")
  puts("BENCH:steal_throughput:elapsed_ns:#{elapsed}")
  return 0
end
