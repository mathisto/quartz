# Concurrency Benchmark: Fan-out / Fan-in
# Measures: throughput of work distributed across 8 workers
# Workload: 100K items split evenly across workers, each does compute

def worker(start: Int, count: Int): Int
  var sum = 0
  for i in start..(start + count)
    sum = sum + i
  end
  return sum
end

def main(): Int
  var n = 100000
  var num_workers = 8
  var items_per_worker = n / num_workers
  sched_init(0)

  var start = time_mono_ns()

  # Fan out: spawn workers with their slice of work
  var tasks = vec_new()
  for i in 0..num_workers
    var base = i * items_per_worker
    var t = async worker(base, items_per_worker)
    sched_spawn(t)
    vec_push(tasks, t)
  end

  # Fan in: collect results
  var total = 0
  for i in 0..num_workers
    total = total + await tasks[i]
  end

  var elapsed = time_mono_ns() - start
  sched_shutdown()

  var rate = n * 1000000000 / elapsed
  puts("BENCH:fanout_fanin:items_per_sec:#{rate}")
  puts("BENCH:fanout_fanin:elapsed_ns:#{elapsed}")
  puts("BENCH:fanout_fanin:total_items:#{n}")
  return 0
end
