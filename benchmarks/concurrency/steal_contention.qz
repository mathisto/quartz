# Steal Contention Benchmark — Adversarial Scheduler Test
#
# All workers idle, single producer floods 1M tasks from the main thread.
# Workers must steal from the global queue and from each other.
#
# What this tests:
# - Global queue → local deque distribution efficiency
# - Steal-half amortization (multiple tasks per steal CAS)
# - Worker ramp-up latency (idle → busy transition)
#
# With steal-half, workers should grab chunks of work per steal,
# reducing CAS contention vs single-task steals.

def contention_worker(done: Int): Void
  # Minimal work — the point is to measure scheduling overhead
  send(done, 1)
end

def main(): Int
  var n = 100000

  puts("=== Steal Contention Benchmark ===")
  puts("Tasks: #{n.to_s()}")
  puts("Pattern: single-producer flood → idle workers steal")
  puts("")

  var done_ch = channel_new_unbounded()
  var t0 = time_mono_ns()

  # Flood all tasks from main thread (NOT a worker)
  # All tasks go to global queue, workers must dequeue/steal
  var i = 0
  while i < n
    go contention_worker(done_ch)
    i += 1
  end

  var t_spawned = time_mono_ns()

  # Collect all completions
  var count = 0
  i = 0
  while i < n
    recv(done_ch)
    count += 1
    i += 1
  end

  var t_done = time_mono_ns()
  sched_shutdown()

  var spawn_ms = (t_spawned - t0) / 1000000
  var drain_ms = (t_done - t_spawned) / 1000000
  var total_ms = (t_done - t0) / 1000000
  var throughput = n * 1000000000 / (t_done - t0)

  puts("--- Results ---")
  puts("Spawn (main→global): #{spawn_ms.to_s()} ms")
  puts("Drain (steal+exec):  #{drain_ms.to_s()} ms")
  puts("Total:               #{total_ms.to_s()} ms")
  puts("Throughput:          #{throughput.to_s()} tasks/sec")
  puts("Completed:           #{count.to_s()}")
  puts("")

  if count == n
    puts("Verified: all tasks completed")
  else
    puts("ERROR: expected #{n.to_s()} completions, got #{count.to_s()}")
    return 1
  end

  puts("")
  puts("BENCH:steal_contention:tasks:#{n.to_s()}")
  puts("BENCH:steal_contention:throughput:#{throughput.to_s()}")
  puts("BENCH:steal_contention:spawn_ms:#{spawn_ms.to_s()}")
  puts("BENCH:steal_contention:drain_ms:#{drain_ms.to_s()}")
  return 0
end
