# Concurrency Benchmark: Mixed Workload (Scheduler Fairness)
# Measures: throughput with mixed compute-bound and sleep tasks
# Workload: 80 compute tasks + 20 sleep tasks, all must complete

def compute_task(iters: Int): Int
  var sum = 0
  for i in 0..iters
    sum = sum + i
  end
  return sum
end

def sleep_task(ms: Int): Int
  sleep_ms(ms)
  return 1
end

def main(): Int
  var num_compute = 80
  var num_sleep = 20
  var compute_iters = 10000
  var sleep_ms_val = 1
  sched_init(0)

  var start = time_mono_ns()

  var tasks = vec_new()

  # Spawn compute tasks
  for i in 0..num_compute
    var t = async compute_task(compute_iters)
    sched_spawn(t)
    vec_push(tasks, t)
  end

  # Spawn sleep tasks
  for i in 0..num_sleep
    var t = async sleep_task(sleep_ms_val)
    sched_spawn(t)
    vec_push(tasks, t)
  end

  # Await all
  var total = num_compute + num_sleep
  var completed = 0
  for i in 0..total
    await tasks[i]
    completed = completed + 1
  end

  var elapsed = time_mono_ns() - start
  sched_shutdown()

  var rate = completed * 1000000000 / elapsed
  puts("BENCH:mixed_workload:tasks_per_sec:#{rate}")
  puts("BENCH:mixed_workload:elapsed_ns:#{elapsed}")
  puts("BENCH:mixed_workload:completed:#{completed}")
  return 0
end
