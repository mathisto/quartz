# Concurrency Benchmark: Contention (Atomic Increment)
# Measures: atomic operations per second under contention
# Workload: 8 tasks, each doing 125K atomic increments on shared counter

def increment_worker(counter_ptr: Int, iters: Int): Int
  for i in 0..iters
    atomic_add(counter_ptr, 1)
  end
  return iters
end

def main(): Int
  var num_tasks = 8
  var total_iters = 1000000
  var iters_per_task = total_iters / num_tasks
  sched_init(0)

  var counter_ptr = alloc(8)
  atomic_store(counter_ptr, 0)

  var start = time_mono_ns()

  # Spawn workers
  var tasks = vec_new()
  for i in 0..num_tasks
    var t = async increment_worker(counter_ptr, iters_per_task)
    sched_spawn(t)
    vec_push(tasks, t)
  end

  # Await all
  var total = 0
  for i in 0..num_tasks
    total = total + await tasks[i]
  end

  var elapsed = time_mono_ns() - start
  var final_count = atomic_load(counter_ptr)
  sched_shutdown()
  qz_free(counter_ptr)

  var rate = total * 1000000000 / elapsed
  puts("BENCH:contention:ops_per_sec:#{rate}")
  puts("BENCH:contention:elapsed_ns:#{elapsed}")
  puts("BENCH:contention:total_ops:#{final_count}")
  return 0
end
