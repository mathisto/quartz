# Concurrency Benchmark: Memory Efficiency
# Measures: bytes per task at 100K scale

def noop(): Int = 0

def main(): Int
  var n = 100000
  sched_init(0)
  var rss_before = mem_current_rss()
  var tasks = vec_new()
  var i = 0
  while i < n
    var t = async noop()
    sched_spawn(t)
    vec_push(tasks, t)
    i += 1
  end
  var rss_after = mem_current_rss()
  i = 0
  while i < n
    await tasks[i]
    i += 1
  end
  sched_shutdown()
  var delta = rss_after - rss_before
  if delta < 0
    delta = 0
  end
  var bytes_per_task = delta / n
  puts("BENCH:memory_efficiency:bytes_per_task:#{bytes_per_task}")
  puts("BENCH:memory_efficiency:total_bytes:#{delta}")
  puts("BENCH:memory_efficiency:tasks:#{n}")
  return 0
end
