# Queue Overflow Cascade Benchmark — Adversarial Scheduler Test
#
# Spawns tasks in a cascading pattern from main thread to trigger
# deque overflow + move-half. Each batch fills the deque past 256.
#
# What this tests:
# - Move-half overflow path (CAS top + batch global enqueue)
# - Global queue capacity under burst
# - Correctness: no lost tasks despite overflow

def cascade_worker(done: Int, id: Int): Void
  send(done, id + 1)
end

def main(): Int
  var total_tasks = 100000

  puts("=== Queue Overflow Cascade Benchmark ===")
  puts("Total tasks: #{total_tasks.to_s()}")
  puts("Deque capacity: 256 (overflow triggers move-half)")
  puts("Expected move-half ops: ~#{(total_tasks / 128).to_s()}")
  puts("")

  var done_ch = channel_new_unbounded()
  var t0 = time_mono_ns()

  # Spawn all tasks — will overflow local deque repeatedly
  var i = 0
  while i < total_tasks
    go cascade_worker(done_ch, i)
    i += 1
  end

  var t_spawned = time_mono_ns()

  # Collect results
  var sum = 0
  i = 0
  while i < total_tasks
    var val = recv(done_ch)
    sum = sum + val
    i += 1
  end

  var t_done = time_mono_ns()
  sched_shutdown()

  var spawn_ms = (t_spawned - t0) / 1000000
  var total_ms = (t_done - t0) / 1000000
  var throughput = total_tasks * 1000000000 / (t_done - t0)
  var expected = total_tasks * (total_tasks + 1) / 2

  puts("--- Results ---")
  puts("Spawn time:     #{spawn_ms.to_s()} ms")
  puts("Total time:     #{total_ms.to_s()} ms")
  puts("Throughput:     #{throughput.to_s()} tasks/sec")
  puts("Sum:            #{sum.to_s()}")
  puts("")

  if sum == expected
    puts("Verified: all #{total_tasks.to_s()} tasks completed (no tasks lost in overflow)")
  else
    puts("ERROR: expected #{expected.to_s()}, got #{sum.to_s()}")
    return 1
  end

  puts("")
  puts("BENCH:overflow_cascade:total_tasks:#{total_tasks.to_s()}")
  puts("BENCH:overflow_cascade:throughput:#{throughput.to_s()}")
  puts("BENCH:overflow_cascade:wall_ms:#{total_ms.to_s()}")
  return 0
end
