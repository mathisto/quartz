# Concurrency Benchmark: Task Spawn Rate
# Measures: tasks created per second
# Workload: spawn 100K tasks that return immediately

def noop(): Int = 0

def main(): Int
  var n = 100000
  sched_init(0)
  var start = time_mono_ns()

  # Spawn all tasks
  var tasks = vec_new()
  for i in 0..n
    var t = async noop()
    sched_spawn(t)
    vec_push(tasks, t)
  end

  # Await all
  for i in 0..n
    await tasks[i]
  end

  var elapsed = time_mono_ns() - start
  sched_shutdown()

  var rate = n * 1000000000 / elapsed
  puts("BENCH:spawn_rate:tasks_per_sec:#{rate}")
  puts("BENCH:spawn_rate:elapsed_ns:#{elapsed}")
  puts("BENCH:spawn_rate:total_tasks:#{n}")
  return 0
end
