# Priority Starvation Benchmark — Adversarial Scheduler Test
#
# Spawns 1K CRITICAL tasks and 100K NORMAL tasks simultaneously.
# Measures whether CRITICAL tasks complete promptly under heavy load.
#
# What this tests:
# - Priority queue dequeue ordering (CRITICAL checked first)
# - CRITICAL latency under heavy NORMAL pressure
# - Whether the 4-level priority system (CRITICAL/HIGH/NORMAL/LOW)
#   actually prevents starvation
#
# Failure mode: if CRITICAL p99 latency is comparable to NORMAL average,
# the priority system isn't working.

def critical_task(done: Int, id: Int, t_base: Int): Void
  var lat = time_mono_ns() - t_base
  send(done, lat)
end

def normal_task(done: Int): Void
  # Do a tiny bit of work to create scheduling pressure
  var x = 0
  var i = 0
  while i < 100
    x = x + i
    i += 1
  end
  send(done, x)
end

def main(): Int
  var n_critical = 100
  var n_normal = 10000

  puts("=== Priority Starvation Benchmark ===")
  puts("CRITICAL tasks: #{n_critical.to_s()}")
  puts("NORMAL tasks:   #{n_normal.to_s()}")
  puts("")

  var crit_done = channel_new_unbounded()
  var norm_done = channel_new_unbounded()

  # Spawn NORMAL tasks first (fill the queues)
  var t0 = time_mono_ns()
  var i = 0
  while i < n_normal
    go normal_task(norm_done)
    i += 1
  end

  var t_normal_spawned = time_mono_ns()

  # Now spawn CRITICAL tasks — they should be prioritized
  var t_crit_base = time_mono_ns()
  i = 0
  while i < n_critical
    go_priority(3, critical_task, crit_done, i, t_crit_base)
    i += 1
  end

  var t_crit_spawned = time_mono_ns()

  # Collect CRITICAL latencies
  var crit_latencies = vec_new()
  i = 0
  while i < n_critical
    var lat = recv(crit_done)
    crit_latencies.push(lat)
    i += 1
  end

  var t_crit_done = time_mono_ns()

  # Drain NORMAL tasks
  i = 0
  while i < n_normal
    recv(norm_done)
    i += 1
  end

  var t_all_done = time_mono_ns()
  sched_shutdown()

  # Sort CRITICAL latencies for percentiles
  vec_sort(crit_latencies)

  var cp50 = crit_latencies[n_critical / 2]
  var cp99 = crit_latencies[n_critical * 99 / 100]
  var cp999 = crit_latencies[n_critical * 999 / 1000]
  var cmin = crit_latencies[0]
  var cmax = crit_latencies[n_critical - 1]

  var crit_ms = (t_crit_done - t_crit_spawned) / 1000000
  var total_ms = (t_all_done - t0) / 1000000
  var normal_ms = (t_all_done - t0) / 1000000

  puts("--- Results ---")
  puts("CRITICAL completion: #{crit_ms.to_s()} ms")
  puts("Total (all tasks):  #{total_ms.to_s()} ms")
  puts("")
  puts("CRITICAL latency (ns from spawn):")
  puts("  min:   #{cmin.to_s()}")
  puts("  p50:   #{cp50.to_s()}")
  puts("  p99:   #{cp99.to_s()}")
  puts("  p999:  #{cp999.to_s()}")
  puts("  max:   #{cmax.to_s()}")
  puts("")

  # Check: CRITICAL should complete much faster than total
  var crit_pct = 0
  if total_ms > 0
    crit_pct = crit_ms * 100 / total_ms
  end
  puts("CRITICAL done at #{crit_pct.to_s()}% of total time")

  if crit_pct < 50
    puts("OK: CRITICAL tasks prioritized (completed in first half)")
  else
    puts("WARNING: CRITICAL tasks not effectively prioritized")
  end

  puts("")
  puts("BENCH:priority_starvation:critical:#{n_critical.to_s()}")
  puts("BENCH:priority_starvation:normal:#{n_normal.to_s()}")
  puts("BENCH:priority_starvation:crit_p50_ns:#{cp50.to_s()}")
  puts("BENCH:priority_starvation:crit_p99_ns:#{cp99.to_s()}")
  puts("BENCH:priority_starvation:crit_ms:#{crit_ms.to_s()}")
  puts("BENCH:priority_starvation:total_ms:#{total_ms.to_s()}")
  puts("BENCH:priority_starvation:crit_pct:#{crit_pct.to_s()}")
  return 0
end
