# Thundering Herd Benchmark — Adversarial Scheduler Test
#
# 10K tasks parked on recv. A single goroutine sends 10K messages at once.
# Measures how fast the scheduler wakes and dispatches all parked tasks.
#
# What this tests:
# - condvar broadcast efficiency (move-half uses pthread_cond_broadcast)
# - global→local task distribution under burst wake
# - work-stealing fairness across workers
#
# Failure mode: if p99 wake latency is >10x p50, the scheduler has a
# thundering herd problem and needs per-worker futex parking (Go's approach).

def herd_worker(inbox: Int, done: Int, timer_base: Int): Void
  # Park on recv — this task sleeps until a message arrives
  var val = recv(inbox)
  # Record wake time relative to base
  var wake_time = time_mono_ns() - timer_base
  send(done, wake_time)
end

def main(): Int
  var n = 10000

  puts("=== Thundering Herd Benchmark ===")
  puts("Parked tasks: #{n.to_s()}")
  puts("")

  # Phase 1: Spawn N tasks, all park on recv
  var inboxes = vec_new()
  var done_ch = channel_new_unbounded()
  var t_base = time_mono_ns()

  var i = 0
  while i < n
    var inbox = channel_new(1)
    inboxes.push(inbox)
    go herd_worker(inbox, done_ch, t_base)
    i += 1
  end

  # Wait for all tasks to park (give them time to reach recv)
  sched_yield()
  sched_yield()
  sched_yield()

  var t0 = time_mono_ns()

  # Phase 2: Burst-send — wake ALL tasks as fast as possible
  i = 0
  while i < n
    send(inboxes[i], 1)
    i += 1
  end

  var t_send = time_mono_ns()

  # Phase 3: Collect wake times
  var latencies = vec_new()
  i = 0
  while i < n
    var lat = recv(done_ch)
    latencies.push(lat)
    i += 1
  end

  var t_done = time_mono_ns()
  sched_shutdown()

  # Sort latencies for percentile calculation
  vec_sort(latencies)

  # Compute percentiles
  var p50_idx = n / 2
  var p99_idx = n * 99 / 100
  var p999_idx = n * 999 / 1000
  var p50 = latencies[p50_idx]
  var p99 = latencies[p99_idx]
  var p999 = latencies[p999_idx]
  var p_min = latencies[0]
  var p_max = latencies[n - 1]

  var send_ms = (t_send - t0) / 1000000
  var total_ms = (t_done - t0) / 1000000
  var wake_rate = n * 1000000000 / (t_done - t0)

  puts("--- Results ---")
  puts("Send burst:    #{send_ms.to_s()} ms")
  puts("Total wake:    #{total_ms.to_s()} ms")
  puts("Wake rate:     #{wake_rate.to_s()} tasks/sec")
  puts("")
  puts("Wake latency (ns from burst start):")
  puts("  min:   #{p_min.to_s()}")
  puts("  p50:   #{p50.to_s()}")
  puts("  p99:   #{p99.to_s()}")
  puts("  p999:  #{p999.to_s()}")
  puts("  max:   #{p_max.to_s()}")
  puts("")

  # Check for thundering herd degradation
  var ratio = 0
  if p50 > 0
    ratio = p99 / p50
  end
  puts("p99/p50 ratio: #{ratio.to_s()}x")

  if ratio > 10
    puts("WARNING: >10x p99 degradation — thundering herd detected")
  else
    puts("OK: wake latency distribution acceptable")
  end

  puts("")
  puts("BENCH:thundering_herd:tasks:#{n.to_s()}")
  puts("BENCH:thundering_herd:wake_rate:#{wake_rate.to_s()}")
  puts("BENCH:thundering_herd:p50_ns:#{p50.to_s()}")
  puts("BENCH:thundering_herd:p99_ns:#{p99.to_s()}")
  puts("BENCH:thundering_herd:p999_ns:#{p999.to_s()}")
  puts("BENCH:thundering_herd:p99_p50_ratio:#{ratio.to_s()}")
  return 0
end
