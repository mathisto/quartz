# ABA Race Stress Benchmark — Adversarial Scheduler Test
#
# Rapid concurrent push/pop/steal interleaving for Chase-Lev correctness.
# Spawns 400K tasks from the main thread while workers are actively
# stealing and executing. Each task carries a unique ID; final sum
# verification catches any lost, duplicated, or corrupted tasks.
#
# What this tests:
# - Chase-Lev deque ABA safety (CAS on top prevents stale reads)
# - Steal-half correctness (N tasks claimed atomically, no partial overlap)
# - Move-half correctness (batch transfer to global doesn't lose tasks)
# - Concurrent push+steal on the same deque
#
# This is a correctness test first, performance test second.
# Any lost or duplicated task means a race condition in the deque.

def aba_task(done: Int, id: Int): Void
  send(done, id)
end

def run_round(total: Int): Int
  var done_ch = channel_new_unbounded()

  # Spawn all tasks — creates massive concurrent push+steal pressure
  var i = 0
  while i < total
    go aba_task(done_ch, i)
    i += 1
  end

  # Collect all results
  var sum = 0
  i = 0
  while i < total
    var val = recv(done_ch)
    sum = sum + val
    i += 1
  end
  sched_shutdown()
  return sum
end

def main(): Int
  var total = 400000

  puts("=== ABA Race Stress Benchmark ===")
  puts("Total tasks per round: #{total.to_s()}")
  puts("Pattern: concurrent push+steal interleaving")
  puts("")

  # Expected sum: sum of 0..total-1
  var expected = total * (total - 1) / 2

  var t0 = time_mono_ns()
  var sum = run_round(total)
  var t_done = time_mono_ns()

  var total_ms = (t_done - t0) / 1000000
  var throughput = total * 1000000000 / (t_done - t0)

  puts("--- Round 1 ---")
  puts("Total time:    #{total_ms.to_s()} ms")
  puts("Throughput:    #{throughput.to_s()} tasks/sec")
  puts("Grand total:   #{sum.to_s()}")
  puts("Expected:      #{expected.to_s()}")
  puts("")

  var all_ok = 1
  if sum == expected
    puts("Round 1: VERIFIED")
  else
    var diff = sum - expected
    puts("Round 1: RACE CONDITION (diff=#{diff.to_s()})")
    all_ok = 0
  end

  # Run 2 more rounds for confidence
  puts("")
  puts("Running 2 additional verification rounds...")
  var round = 2
  while round <= 3
    var rsum = run_round(total)
    if rsum != expected
      puts("  Round #{round.to_s()}: FAIL (got #{rsum.to_s()})")
      all_ok = 0
    else
      puts("  Round #{round.to_s()}: OK")
    end
    round += 1
  end

  puts("")
  if all_ok == 1
    puts("All rounds passed — Chase-Lev deque is ABA-safe")
    puts("Chase-Lev + steal-half + move-half: CORRECT")
  else
    puts("RACE CONDITION DETECTED")
    return 1
  end

  puts("")
  puts("BENCH:aba_race:total_tasks:#{total.to_s()}")
  puts("BENCH:aba_race:throughput:#{throughput.to_s()}")
  puts("BENCH:aba_race:wall_ms:#{total_ms.to_s()}")
  puts("BENCH:aba_race:verified:#{all_ok.to_s()}")
  return 0
end
