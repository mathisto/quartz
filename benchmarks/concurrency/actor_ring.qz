# Actor Scale Benchmark — M:N Scheduler Stress Test
#
# Spawns N tasks on the M:N scheduler, each communicating via channels.
# Measures: spawn rate, message throughput, memory per task.
#
# This demonstrates the same capability as Erlang's ring benchmark
# but uses go + channels directly (the primitives actors compile to).
#
# Usage:
#   ./actor_ring              # Default: 10K tasks
#   ./actor_ring 100000       # 100K tasks

def worker(inbox: Int, done: Int): Void
  # Each worker: receive a value, increment it, send to done channel
  var val = recv(inbox)
  send(done, val + 1)
end

def main(): Int
  # Default: 4000 tasks (scheduler queue supports up to 1M, but each task
  # with its own channel needs a notify fd, limited by OS fd limit ~10K).
  # Path to millions: replace fd-per-channel io_suspend with scheduler
  # park/wake mechanism (channel-level wait queues, no fd needed).
  # Current tested limit: 5000 concurrent tasks with individual channels.
  # Bottleneck above 5K: scheduler global queue mutex contention when
  # thousands of tasks wake simultaneously. Path to millions: work-stealing
  # scheduler with lock-free queues (Go/Tokio approach).
  var n = 5000

  puts("=== M:N Scheduler Scale Benchmark ===")
  puts("Tasks: #{n.to_s()}")
  puts("")

  var rss_before = mem_current_rss()

  # Phase 1: Spawn N tasks, each with its own inbox
  var spawn_start = time_mono_ns()
  var inboxes = vec_new()
  var done_ch = channel_new_unbounded()

  var i = 0
  while i < n
    var inbox = channel_new(1)
    inboxes.push(inbox)
    go worker(inbox, done_ch)
    i += 1
  end

  var spawn_elapsed = time_mono_ns() - spawn_start
  var rss_spawned = mem_current_rss()

  # Phase 2: Send a message to each task
  var send_start = time_mono_ns()
  i = 0
  while i < n
    send(inboxes[i], i)
    i += 1
  end
  var send_elapsed = time_mono_ns() - send_start

  # Phase 3: Collect all responses
  var recv_start = time_mono_ns()
  var total = 0
  i = 0
  while i < n
    var val = recv(done_ch)
    total = total + val
    i += 1
  end
  var recv_elapsed = time_mono_ns() - recv_start

  sched_shutdown()

  var total_elapsed = spawn_elapsed + send_elapsed + recv_elapsed

  # Calculate metrics
  var spawn_rate = 0
  if spawn_elapsed > 0
    spawn_rate = n * 1000000000 / spawn_elapsed
  end
  var msg_rate = 0
  if total_elapsed > 0
    msg_rate = n * 2 * 1000000000 / total_elapsed
  end
  var mem_per_task = 0
  if n > 0
    mem_per_task = (rss_spawned - rss_before) / n
  end

  # Verify correctness: sum of (i+1) for i in 0..n = n*(n+1)/2
  var expected = n * (n + 1) / 2
  if total != expected
    puts("ERROR: expected #{expected.to_s()}, got #{total.to_s()}")
    return 1
  end

  # Report
  puts("--- Results ---")
  puts("Spawn:")
  puts("  Total:     #{(spawn_elapsed / 1000000).to_s()} ms")
  puts("  Per task:  #{(spawn_elapsed / n).to_s()} ns")
  puts("  Rate:      #{spawn_rate.to_s()} tasks/sec")
  puts("Send:")
  puts("  Total:     #{(send_elapsed / 1000000).to_s()} ms")
  puts("Recv:")
  puts("  Total:     #{(recv_elapsed / 1000000).to_s()} ms")
  puts("Messages:")
  puts("  Total:     #{(n * 2).to_s()} (#{n.to_s()} send + #{n.to_s()} reply)")
  puts("  Rate:      #{msg_rate.to_s()} msgs/sec")
  puts("Memory:")
  puts("  RSS delta: #{((rss_spawned - rss_before) / 1024).to_s()} KB")
  puts("  Per task:  #{mem_per_task.to_s()} bytes")
  puts("  Peak RSS:  #{(mem_peak_rss() / 1048576).to_s()} MB")
  puts("")
  puts("Verified: #{total.to_s()} == #{expected.to_s()} ✓")
  puts("")
  puts("BENCH:actor_scale:tasks:#{n.to_s()}")
  puts("BENCH:actor_scale:spawn_rate:#{spawn_rate.to_s()}")
  puts("BENCH:actor_scale:msg_rate:#{msg_rate.to_s()}")
  puts("BENCH:actor_scale:mem_per_task:#{mem_per_task.to_s()}")
  puts("BENCH:actor_scale:peak_rss_mb:#{(mem_peak_rss() / 1048576).to_s()}")
  puts("BENCH:actor_scale:spawn_ns:#{spawn_elapsed.to_s()}")
  puts("BENCH:actor_scale:total_ns:#{total_elapsed.to_s()}")
  return 0
end
