# Pathological Work Distribution Benchmark — Adversarial Scheduler Test
#
# One worker gets ALL the work — a single go task spawns 100K children.
# The other workers must steal from that one worker's local deque.
#
# What this tests:
# - Steal-half efficiency: workers should grab chunks, not one-at-a-time
# - Single-producer multi-consumer scaling
# - Whether the scheduler balances work from a hot spot
#
# With steal-half, idle workers should each grab ~50% of the overloaded
# worker's deque per steal, rapidly balancing the load.

def hot_spawner(n: Int, done: Int): Void
  # This runs on a single worker — spawns all children from one deque
  var ch = channel_new_unbounded()
  var i = 0
  while i < n
    go pathological_child(ch, i)
    i += 1
  end
  # Collect all results
  var sum = 0
  i = 0
  while i < n
    var val = recv(ch)
    sum = sum + val
    i += 1
  end
  send(done, sum)
end

def pathological_child(done: Int, id: Int): Void
  # Small computation — tests scheduling, not computation
  send(done, id + 1)
end

def main(): Int
  var n = 100000

  puts("=== Pathological Distribution Benchmark ===")
  puts("Tasks: #{n.to_s()} (all spawned by one worker)")
  puts("Pattern: single hot-spot → steal rebalancing")
  puts("")

  var done_ch = channel_new(1)
  var t0 = time_mono_ns()

  # Single go launches all work — one worker is the bottleneck
  go hot_spawner(n, done_ch)

  var sum = recv(done_ch)

  var t_done = time_mono_ns()
  sched_shutdown()

  var total_ms = (t_done - t0) / 1000000
  var throughput = n * 1000000000 / (t_done - t0)
  var expected = n * (n + 1) / 2

  puts("--- Results ---")
  puts("Total time:    #{total_ms.to_s()} ms")
  puts("Throughput:    #{throughput.to_s()} tasks/sec")
  puts("Sum:           #{sum.to_s()}")
  puts("")

  if sum == expected
    puts("Verified: all tasks completed correctly")
  else
    puts("ERROR: expected #{expected.to_s()}, got #{sum.to_s()}")
    return 1
  end

  puts("")
  puts("BENCH:pathological:tasks:#{n.to_s()}")
  puts("BENCH:pathological:throughput:#{throughput.to_s()}")
  puts("BENCH:pathological:wall_ms:#{total_ms.to_s()}")
  return 0
end
