# Concurrency Benchmark: Wake Burst (Thundering Herd)
# Measures: wakeups/sec when all tasks wake simultaneously

def herd_worker(inbox: Int, done: Int): Void
  recv(inbox)
  send(done, 1)
end

def main(): Int
  var n = 10000
  var inboxes = vec_new()
  var done_ch = channel_new_unbounded()
  var i = 0
  while i < n
    var inbox = channel_new(1)
    vec_push(inboxes, inbox)
    go herd_worker(inbox, done_ch)
    i += 1
  end
  sched_yield()
  sched_yield()
  sched_yield()
  var t0 = time_mono_ns()
  i = 0
  while i < n
    send(inboxes[i], 1)
    i += 1
  end
  i = 0
  while i < n
    recv(done_ch)
    i += 1
  end
  var elapsed = time_mono_ns() - t0
  sched_shutdown()
  var rate = n * 1000000000 / elapsed
  puts("BENCH:wake_burst:wakes_per_sec:#{rate}")
  puts("BENCH:wake_burst:elapsed_ns:#{elapsed}")
  return 0
end
