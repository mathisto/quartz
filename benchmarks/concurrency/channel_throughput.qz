# Concurrency Benchmark: Channel Throughput
# Measures: messages per second through a buffered channel
# Workload: 1M integers through buffered channel (1024)

def producer(ch: Int, count: Int): Int
  for i in 0..count
    send(ch, i)
  end
  channel_close(ch)
  return 0
end

def consumer(ch: Int): Int
  var sum = 0
  for await val in ch
    sum = sum + val
  end
  return sum
end

def main(): Int
  var n = 10000
  sched_init(0)
  var ch = channel_new(1024)
  var start = time_mono_ns()

  var prod = async producer(ch, n)
  sched_spawn(prod)
  var cons = async consumer(ch)
  sched_spawn(cons)

  await prod
  var sum = await cons
  var elapsed = time_mono_ns() - start
  sched_shutdown()

  var rate = n * 1000000000 / elapsed
  puts("BENCH:channel_throughput:msgs_per_sec:#{rate}")
  puts("BENCH:channel_throughput:elapsed_ns:#{elapsed}")
  puts("BENCH:channel_throughput:total_msgs:#{n}")
  return 0
end
