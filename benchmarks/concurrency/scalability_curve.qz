# Concurrency Benchmark: Scalability Curve
# Measures: spawn rate at 1K/10K/100K/1M, reports efficiency ratio

def noop(): Int = 0

def spawn_and_wait(n: Int): Int
  var tasks = vec_new()
  var start = time_mono_ns()
  var i = 0
  while i < n
    var t = async noop()
    sched_spawn(t)
    vec_push(tasks, t)
    i += 1
  end
  i = 0
  while i < n
    await tasks[i]
    i += 1
  end
  var elapsed = time_mono_ns() - start
  return n * 1000000000 / elapsed
end

def main(): Int
  sched_init(0)
  var rate_1k = spawn_and_wait(1000)
  var rate_10k = spawn_and_wait(10000)
  var rate_100k = spawn_and_wait(100000)
  var rate_1m = spawn_and_wait(1000000)
  sched_shutdown()
  var efficiency = 0
  if rate_1k > 0
    efficiency = rate_1m * 1000 / rate_1k
  end
  puts("BENCH:scalability_curve:efficiency_x1000:#{efficiency}")
  puts("BENCH:scalability_curve:rate_1k:#{rate_1k}")
  puts("BENCH:scalability_curve:rate_10k:#{rate_10k}")
  puts("BENCH:scalability_curve:rate_100k:#{rate_100k}")
  puts("BENCH:scalability_curve:rate_1m:#{rate_1m}")
  return 0
end
