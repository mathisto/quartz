# Struct-heavy benchmark
# Tests struct allocation, field access, function passing, and nested structs.
# All types are i64 in Quartz's existential model.

NUM_POINTS = 100000
ITERATIONS = 50

@value
struct Point3D
  x: Int
  y: Int
  z: Int
end

@value
struct BoundingBox
  min_x: Int
  min_y: Int
  min_z: Int
  max_x: Int
  max_y: Int
  max_z: Int
end

def point_new(x: Int, y: Int, z: Int): Point3D
  return Point3D { x: x, y: y, z: z }
end

def point_dist_sq(a: Point3D, b: Point3D): Int
  var dx = a.x - b.x
  var dy = a.y - b.y
  var dz = a.z - b.z
  return dx * dx + dy * dy + dz * dz
end

def point_add(a: Point3D, b: Point3D): Point3D
  return Point3D { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
end

def point_scale(p: Point3D, s: Int): Point3D
  return Point3D { x: p.x * s, y: p.y * s, z: p.z * s }
end

def bbox_new(): BoundingBox
  return BoundingBox {
    min_x: 999999999, min_y: 999999999, min_z: 999999999,
    max_x: -999999999, max_y: -999999999, max_z: -999999999
  }
end

def bbox_include(bb: BoundingBox, p: Point3D): BoundingBox
  var nx = bb.min_x
  var ny = bb.min_y
  var nz = bb.min_z
  var xx = bb.max_x
  var xy = bb.max_y
  var xz = bb.max_z
  if p.x < nx
    nx = p.x
  end
  if p.y < ny
    ny = p.y
  end
  if p.z < nz
    nz = p.z
  end
  if p.x > xx
    xx = p.x
  end
  if p.y > xy
    xy = p.y
  end
  if p.z > xz
    xz = p.z
  end
  return BoundingBox { min_x: nx, min_y: ny, min_z: nz, max_x: xx, max_y: xy, max_z: xz }
end

def bbox_volume(bb: BoundingBox): Int
  return (bb.max_x - bb.min_x) * (bb.max_y - bb.min_y) * (bb.max_z - bb.min_z)
end

def main(): Int
  var points = vec_new<Point3D>()

  # Allocate points with deterministic pseudo-random coordinates
  var seed = 42
  for i in 0..NUM_POINTS
    seed = (seed * 1103515245 + 12345) % 2147483648
    var x = seed % 10000
    seed = (seed * 1103515245 + 12345) % 2147483648
    var y = seed % 10000
    seed = (seed * 1103515245 + 12345) % 2147483648
    var z = seed % 10000
    var p = point_new(x, y, z)
    points.push(p)
  end

  var total_dist = 0
  var total_vol = 0

  for iter in 0..ITERATIONS
    # Sum pairwise distances (strided to keep O(n))
    var dist_sum = 0
    for i in 0..(NUM_POINTS - 1)
      var a = points[i]
      var b = points[i + 1]
      dist_sum = dist_sum + point_dist_sq(a, b)
    end
    total_dist = total_dist + dist_sum

    # Compute bounding box over all points
    var bb = bbox_new()
    for i in 0..NUM_POINTS
      var p = points[i]
      bb = bbox_include(bb, p)
    end
    total_vol = total_vol + bbox_volume(bb)

    # Transform points: shift + scale
    var offset = point_new(iter, iter * 2, iter * 3)
    for i in 0..NUM_POINTS
      var p = points[i]
      var shifted = point_add(p, offset)
      points.set(i, shifted)
    end
  end

  puts("dist_sum: " + str_from_int(total_dist))
  puts("vol_sum:  " + str_from_int(total_vol))
  return 0
end
