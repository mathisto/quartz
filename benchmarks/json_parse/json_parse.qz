# JSON parsing benchmark
# Tests string processing and hashmap performance
# Parses a JSON-like structure manually (no std/json dependency for benchmark purity)

def skip_whitespace(s: String, pos: Int): Int
  var i = pos
  while i < str_byte_len(s)
    var c = str_byte_at(s,i)
    if c != ' ' and c != '\n' and c != '\r' and c != '\t'
      return i
    end
    i = i + 1
  end
  return i
end

def skip_string(s: String, pos: Int): Int
  # Skip past a JSON string starting at opening '"', return position after closing '"'
  var i = pos + 1  # skip opening "
  while i < str_byte_len(s)
    var c = str_byte_at(s,i)
    if c == '"'  # closing "
      return i + 1
    end
    if c == '\\'  # backslash
      i = i + 1
    end
    i = i + 1
  end
  return i
end

def skip_number(s: String, pos: Int): Int
  # Skip past a JSON number, return position after last digit
  var i = pos
  if i < str_byte_len(s) and str_byte_at(s,i) == '-'
    i = i + 1
  end
  while i < str_byte_len(s)
    var c = str_byte_at(s,i)
    if c >= '0' and c <= '9'
      i = i + 1
    else
      break
    end
  end
  return i
end

# Count how many JSON values we can parse from a string
def count_values(s: String): Int
  var count = 0
  var i = 0
  var len = str_byte_len(s)
  while i < len
    i = skip_whitespace(s, i)
    if i >= len
      break
    end
    var c = str_byte_at(s,i)
    if c == '"'  # string
      i = skip_string(s, i)
      count = count + 1
    elsif c >= '0' and c <= '9' or c == '-'  # number
      i = skip_number(s, i)
      count = count + 1
    elsif c == 't' or c == 'f'  # true/false
      if c == 't'
        i = i + 4
      else
        i = i + 5
      end
      count = count + 1
    elsif c == 'n'  # null
      i = i + 4
      count = count + 1
    else
      i = i + 1  # skip structural chars: { } [ ] , :
    end
  end
  return count
end

def generate_json(n: Int): String
  var sb = sb_new()
  sb.append("[")
  for i in 0..n
    if i > 0
      sb.append(",")
    end
    sb.append("{\"id\":")
    sb.append(i.to_s())
    sb.append(",\"name\":\"item_")
    sb.append(i.to_s())
    sb.append("\",\"value\":")
    sb.append((i * 17 + 42).to_s())
    sb.append(",\"active\":")
    if i % 3 == 0
      sb.append("true")
    else
      sb.append("false")
    end
    sb.append("}")
  end
  sb.append("]")
  var result = sb.to_string()
  sb_free(sb)
  return result
end

def main(): Int
  var n = 100000
  var json = generate_json(n)
  puts("Generated JSON: " + str_from_int(str_byte_len(json)) + " bytes")

  # Parse 10 times for benchmarking
  var total = 0
  for i in 0..10
    total = total + count_values(json)
  end
  puts("Total values parsed: " + str_from_int(total))
  return 0
end
