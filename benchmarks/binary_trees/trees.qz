# Binary tree node: [left, right, value] at WORD offsets 0, 1, 2.
# store/load index in i64 words (getelementptr i64), so a 24-byte node
# (3 words) uses offsets 0/1/2. mem_alloc(24) allocates 24 BYTES via the
# heap allocator (the old `alloc` builtin was removed).
def tree_new(val: Int): Int
  ptr = mem_alloc(24)
  store(ptr, 0, 0)
  store(ptr, 1, 0)
  store(ptr, 2, val)
  return ptr
end

def tree_build(depth: Int): Int
  if depth == 0
    return tree_new(0)
  end
  node = tree_new(0)
  store(node, 0, tree_build(depth - 1))
  store(node, 1, tree_build(depth - 1))
  return node
end

def tree_check(node: Int): Int
  if node == 0
    return 0
  end
  left = load(node, 0)
  right = load(node, 1)
  if left == 0
    return 1
  end
  return 1 + tree_check(left) + tree_check(right)
end

def main(): Int
  max_depth = 15
  var total = 0
  for d in 0..max_depth
    tree = tree_build(d)
    total += tree_check(tree)
  end
  puts(str_from_int(total))
  return 0
end
