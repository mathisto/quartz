# Binary tree benchmark using arena allocator
# Same algorithm as trees.qz but uses arena_alloc + arena_reset
# for O(1) bulk deallocation (Zig's strategy for 0.5x C)
#
# Node layout: [left, right, value] at word offsets 0, 1, 2
# arena_alloc allocates raw bytes, so 3 * 8 = 24 bytes per node

def tree_build(arena: Int, depth: Int): Int
  node = arena_alloc(arena, 24)
  store(node, 2, 0)
  if depth == 0
    store(node, 0, 0)
    store(node, 1, 0)
    return node
  end
  store(node, 0, tree_build(arena, depth - 1))
  store(node, 1, tree_build(arena, depth - 1))
  return node
end

def tree_check(node: Int): Int
  if node == 0
    return 0
  end
  left = load(node, 0)
  right = load(node, 1)
  if left == 0
    return 1
  end
  return 1 + tree_check(left) + tree_check(right)
end

def main(): Int
  max_depth = 15
  var total = 0
  arena = arena_new()
  for d in 0..max_depth
    arena_reset(arena)
    tree = tree_build(arena, d)
    total += tree_check(tree)
  end
  arena_destroy(arena)
  puts(str_from_int(total))
  return 0
end
