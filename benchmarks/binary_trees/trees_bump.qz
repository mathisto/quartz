# Binary tree benchmark using branchless bump allocator
# Same algorithm as trees.qz but uses bump_alloc + bump_reset
# Zero branches per allocation, zero deallocation cost
#
# Node layout: [left, right, value] at word offsets 0, 1, 2
# bump_alloc allocates raw bytes: 3 * 8 = 24 bytes per node
# Depth 15 needs 2^16 - 1 = 65535 nodes * 24 bytes = 1,572,840 bytes

def tree_build(bump: Int, depth: Int): Int
  node = bump_alloc(bump, 24)
  store(node, 2, 0)
  if depth == 0
    store(node, 0, 0)
    store(node, 1, 0)
    return node
  end
  store(node, 0, tree_build(bump, depth - 1))
  store(node, 1, tree_build(bump, depth - 1))
  return node
end

def tree_check(node: Int): Int
  if node == 0
    return 0
  end
  left = load(node, 0)
  right = load(node, 1)
  if left == 0
    return 1
  end
  return 1 + tree_check(left) + tree_check(right)
end

def main(): Int
  max_depth = 15
  var total = 0
  # Pre-allocate 2MB — fits all trees with room to spare
  bump = bump_new(2097152)
  for d in 0..max_depth
    bump_reset(bump)
    tree = tree_build(bump, d)
    total += tree_check(tree)
  end
  bump_free(bump)
  puts(str_from_int(total))
  return 0
end
