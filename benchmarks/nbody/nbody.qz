# N-body simulation benchmark
# Tests struct field access performance and floating-point-like arithmetic
# Uses integer arithmetic scaled by 1000 to simulate fixed-point math
# (Quartz uses i64 everywhere, so we approximate double with scaled ints)

SOLAR_MASS = 39478  # 4 * PI^2 * 1000
DAYS_PER_YEAR = 365
DT = 1  # timestep
NUM_BODIES = 5
NUM_STEPS = 500000

# Body state stored in parallel vectors (SoA layout)
# Each body has: x, y, z, vx, vy, vz, mass
var bx = vec_new<Int>()
var by = vec_new<Int>()
var bz = vec_new<Int>()
var bvx = vec_new<Int>()
var bvy = vec_new<Int>()
var bvz = vec_new<Int>()
var bmass = vec_new<Int>()

def init_bodies(): Void
  # Sun
  bx.push(0); by.push(0); bz.push(0)
  bvx.push(0); bvy.push(0); bvz.push(0)
  bmass.push(SOLAR_MASS)
  
  # Jupiter (scaled by 1000)
  bx.push(4841); by.push(-1160); bz.push(-103)
  bvx.push(606); bvy.push(2811); bvz.push(-25)
  bmass.push(37694)  # 0.000954... * SOLAR_MASS * 1000
  
  # Saturn
  bx.push(8343); by.push(4124); bz.push(-403)
  bvx.push(-876); bvy.push(1826); bvz.push(8)
  bmass.push(11286)
  
  # Uranus
  bx.push(12894); by.push(-15111); bz.push(-223)
  bvx.push(1082); bvy.push(868); bvz.push(-10)
  bmass.push(1723)
  
  # Neptune
  bx.push(15379); by.push(-25919); bz.push(179)
  bvx.push(979); bvy.push(594); bvz.push(-24)
  bmass.push(2033)
end

def advance(n: Int): Void
  for step in 0..n
    # Update velocities (all pairs)
    for i in 0..NUM_BODIES
      var ix = bx[i]
      var iy = by[i]
      var iz = bz[i]
      var im = bmass[i]
      for j in (i + 1)..NUM_BODIES
        var dx = ix - bx[j]
        var dy = iy - by[j]
        var dz = iz - bz[j]
        var dist_sq = dx * dx + dy * dy + dz * dz
        if dist_sq < 1
          dist_sq = 1
        end
        # Approximate 1/dist^3 with integer math
        # Using iterative approximation: mag ≈ DT / dist^3
        var dist = isqrt(dist_sq)
        if dist < 1
          dist = 1
        end
        var dist_cubed = dist * dist * dist
        if dist_cubed < 1
          dist_cubed = 1
        end
        var mag = DT * 1000 / dist_cubed
        
        var jm = bmass[j]
        bvx.set(i, bvx[i] - dx * jm * mag / 1000000)
        bvy.set(i, bvy[i] - dy * jm * mag / 1000000)
        bvz.set(i, bvz[i] - dz * jm * mag / 1000000)
        bvx.set(j, bvx[j] + dx * im * mag / 1000000)
        bvy.set(j, bvy[j] + dy * im * mag / 1000000)
        bvz.set(j, bvz[j] + dz * im * mag / 1000000)
      end
    end
    
    # Update positions
    for i in 0..NUM_BODIES
      bx.set(i, bx[i] + bvx[i] * DT / 1000)
      by.set(i, by[i] + bvy[i] * DT / 1000)
      bz.set(i, bz[i] + bvz[i] * DT / 1000)
    end
  end
end

# Integer square root (Newton's method)
def isqrt(n: Int): Int
  if n <= 0
    return 0
  end
  var x = n
  var y = (x + 1) / 2
  while y < x
    x = y
    y = (x + n / x) / 2
  end
  return x
end

def energy(): Int
  var e = 0
  for i in 0..NUM_BODIES
    # Kinetic energy: 0.5 * m * v^2
    var vx = bvx[i]
    var vy = bvy[i]
    var vz = bvz[i]
    e = e + bmass[i] * (vx * vx + vy * vy + vz * vz) / (2 * 1000000)
    
    # Potential energy: -m1 * m2 / dist
    for j in (i + 1)..NUM_BODIES
      var dx = bx[i] - bx[j]
      var dy = by[i] - by[j]
      var dz = bz[i] - bz[j]
      var dist = isqrt(dx * dx + dy * dy + dz * dz)
      if dist < 1
        dist = 1
      end
      e = e - bmass[i] * bmass[j] / (dist * 1000)
    end
  end
  return e
end

def main(): Int
  init_bodies()
  var e0 = energy()
  puts("Energy before: " + str_from_int(e0))
  advance(NUM_STEPS)
  var e1 = energy()
  puts("Energy after:  " + str_from_int(e1))
  return 0
end
