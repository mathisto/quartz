# Map benchmark — stress test insert/lookup/delete at scale
# Tests: map allocation, string hashing, collision handling, resize

NUM_KEYS = 100000
LOOKUP_ROUNDS = 3

def main(): Int
  var m = map_new<String, Int>()

  # Phase 1: Insert NUM_KEYS entries
  var i = 0
  while i < NUM_KEYS
    var key = str_from_int(i)
    map_set(m, key, i * 7)
    i = i + 1
  end

  # Phase 2: Lookup all keys LOOKUP_ROUNDS times
  var total = 0
  var round = 0
  while round < LOOKUP_ROUNDS
    i = 0
    while i < NUM_KEYS
      var key = str_from_int(i)
      total = total + __map_get_raw(m, key)
      i = i + 1
    end
    round = round + 1
  end

  # Phase 3: Delete half the keys
  i = 0
  while i < NUM_KEYS
    if i % 2 == 0
      var key = str_from_int(i)
      map_delete(m, key)
    end
    i = i + 1
  end

  # Phase 4: Verify remaining keys still accessible
  var remaining = 0
  i = 1
  while i < NUM_KEYS
    var key = str_from_int(i)
    if map_has(m, key) != 0
      remaining = remaining + 1
    end
    i = i + 2
  end

  map_free(m)

  puts("Inserted: " + str_from_int(NUM_KEYS))
  puts("Lookup total: " + str_from_int(total))
  puts("Remaining after delete: " + str_from_int(remaining))
  return 0
end
