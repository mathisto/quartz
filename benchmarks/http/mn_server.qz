# Quartz HTTP M:N scheduler benchmark server
# Uses http_serve_concurrent (M:N green threads, async I/O per connection)
# Responds to all requests with "Hello, World!" (plain text)

import std/net/http_server

def handler(req: Request): Response
  return text_response("Hello, World!")
end

def main(): Int
  puts("Listening on port 18083 (M:N concurrent)")
  return http_serve_concurrent(18083, handler)
end
