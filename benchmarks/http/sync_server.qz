# Quartz HTTP sync benchmark server
# Uses http_serve (blocking accept loop, one connection at a time)
# Responds to all requests with "Hello, World!" (plain text)

import std/net/http_server

def handler(req: Request): Response
  return text_response("Hello, World!")
end

def main(): Int
  puts("Listening on port 18080 (sync)")
  return http_serve(18080, handler)
end
