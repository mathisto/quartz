# Quartz HTTP JSON benchmark server
# Minimal blocking server for benchmarking
# Responds to all requests with {"message":"Hello, World!"} (JSON)

import std/ffi/socket
import std/ffi/event

# Fixed response — pre-built for zero allocation in hot path
var RESPONSE = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 27\r\nConnection: close\r\n\r\n{\"message\":\"Hello, World!\"}"

def main(): Int
  var server_fd = socket(AF_INET(), SOCK_STREAM(), 0)
  if server_fd < 0
    puts("Failed to create socket")
    return 1
  end

  var optval = malloc(4)
  ptr_write_i32(optval, 1)
  setsockopt(server_fd, SOL_SOCKET(), SO_REUSEADDR(), optval, 4)
  free(optval)

  var net_port = htons(18082)
  var addr = SockaddrIn { sin_len: 16, sin_family: 2, sin_port: net_port, sin_addr: 0, sin_zero: 0 }
  var bind_result = bind(server_fd, addr, 16)
  if bind_result < 0
    puts("Failed to bind")
    return 1
  end

  var listen_result = listen(server_fd, 128)
  if listen_result < 0
    puts("Failed to listen")
    return 1
  end

  puts("Listening on port 18082")

  while true
    var client_fd = accept(server_fd, int_to_cptr(0), int_to_cptr(0))
    if client_fd >= 0
      handle_client(client_fd)
    end
  end

  var _c = close(server_fd)
  return 0
end

def send_str(fd: Int, s: String): Int
  var len = str_byte_len(s)
  var ptr = str_to_ptr(s)
  sendto(fd, ptr, len, 0, int_to_cptr(0), 0)
end

def handle_client(fd: Int): Void
  # Read request (drain enough data to proceed)
  var buf = malloc(4096)
  var _n = read(fd, buf, 4096)
  free(buf)

  # Write response and close
  var _w = send_str(fd, RESPONSE)
  var _c = close(fd)
end
