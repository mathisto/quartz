# Quartz HTTP M:N scheduler + keepalive benchmark server
# Uses http_serve_opts (M:N green threads, HTTP keepalive, load shedding)
# Responds to all requests with "Hello, World!" (plain text)

import std/net/http_server

def handler(req: Request): Response
  return text_response("Hello, World!")
end

def main(): Int
  var config = http_server_config(18084)
  puts("Listening on port 18084 (M:N keepalive)")
  return http_serve_opts(config, handler)
end
