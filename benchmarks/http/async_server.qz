# Quartz HTTP async benchmark server
# Uses http_serve_async (kqueue event loop, single-thread multiplexed I/O)
# Responds to all requests with "Hello, World!" (plain text)

import std/net/http_server

def handler(req: Request): Response
  return text_response("Hello, World!")
end

def main(): Int
  puts("Listening on port 18082 (async)")
  return http_serve_async(18082, handler)
end
