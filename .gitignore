self-hosted/quartz.qz.save

# Generated by `quake baremetal:bake_assets` from site/dist/. Regenerate
# locally; never commit — it's megabytes of hex-escaped asset bytes that
# would balloon the repo and churn on every Astro build.
tools/baremetal/site_assets.qz

# Per-machine compiled demo binaries — rebuild from sources via the
# usual quartz → llc → clang pipeline.
game/*/bin/

# build:separate scratch output
.quartz-sep/
