  task("mlkem:acvp", "Close-gate: NIST ACVP FIPS 203 final KAT vectors") do ->
    # NET.3b.5 close-gate. Runs four hand-picked KATs from
    # usnistgov/ACVP-Server/gen-val/json-files/ML-KEM-{keyGen,encapDecap}-FIPS203:
    #   - KeyGen tcId=26 — (d, z) → expected (ek, dk)
    #   - Encaps tcId=26 — (ek, m) → expected (c, k)
    #   - Decaps tcId=89 — valid (dk, c) → expected k
    #   - Decaps tcId=86 — modified ciphertext, expected K̄ from J(z ∥ c)
    # FIPS 203 FINAL — not the IPD targeted by C2SP/CCTV. C2SP/CCTV's 10K
    # accumulated fingerprint targets IPD (pre-final, no k-byte in G), so
    # it is NOT a valid close-gate for a final-standard impl. The ACVP
    # vectors are the canonical NIST FIPS 203 final reference.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v clang > /dev/null 2>&1") != 0
      fail("clang not on PATH — required for the LLVM toolchain")
    end

    var spec = "spec/qz/mlkem_acvp_smoke.qz"
    if exists(spec) == 0
      fail("Missing #{spec}")
    end
    mkdir_p("tmp/mlkem-acvp")
    var ll = "tmp/mlkem-acvp/acvp.ll"
    var obj = "tmp/mlkem-acvp/acvp.o"
    var bin = "tmp/mlkem-acvp/acvp"

    step("Compile spec to IR") do ->
      var include_flags = qz_include_flags()
      if sh_maybe("#{compiler} #{include_flags} #{spec} > #{ll} 2>tmp/mlkem-acvp/compile.err") != 0
        eputs(read_file("tmp/mlkem-acvp/compile.err"))
        fail("Quartz compile failed")
      end
    end

    step("Dead-strip unused IR (internalize + globaldce)") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/mlkem-acvp/acvp.dce.ll"
      if sh_maybe("opt -passes='internalize,globaldce' --internalize-public-api-list=main #{ll} -S -o #{ll_dce} 2>tmp/mlkem-acvp/opt.err") != 0
        eputs(read_file("tmp/mlkem-acvp/opt.err"))
        fail("opt dead-strip failed")
      end
    end

    step("Assemble IR to object") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/mlkem-acvp/acvp.dce.ll"
      if sh_maybe("llc -filetype=obj #{ll_dce} -o #{obj} 2>tmp/mlkem-acvp/llc.err") != 0
