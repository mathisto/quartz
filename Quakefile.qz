        fail("llc failed")
      end
    end

    step("Link") do ->
      var dead_strip = _crypto_dead_strip_flag()
      if sh_maybe("clang #{obj} -o #{bin} -lm -lpthread #{dead_strip} 2>tmp/mlkem-acvp/link.err") != 0
        eputs(read_file("tmp/mlkem-acvp/link.err"))
        fail("link failed")
      end
