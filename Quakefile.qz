  task("tls_record:smoke", "End-to-end smoke: TLS 1.3 record layer + transcript hash (RFC 8446 §5)") do ->
    # NET.5c.2 verification. Stdlib-only: pure-Quartz TLSCiphertext wire
    # format (5-byte header + AEAD payload + per-direction sequence counter
    # + nonce-iv-XOR construction), AEAD dispatch via cipher suite, plus
    # incremental transcript hash (SHA-256 + SHA-384) with clone-on-digest
    # so derive_secret callsites don't consume the running hash. Covers
    # all 3 v1 suites (AES-128-GCM-SHA256, AES-256-GCM-SHA384,
    # ChaCha20-Poly1305-SHA256), sequence-counter increments, AEAD tamper
    # rejection (ciphertext / tag / AAD), max-plaintext boundary, transcript
    # snapshot-doesn't-consume + clone independence. 52 checks total.
    # Same compile/link/run pipeline as sha2:smoke.
    var compiler = compiler_path()
