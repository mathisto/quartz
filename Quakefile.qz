  task("tls_handshake:smoke", "End-to-end smoke: TLS 1.3 handshake message codec (RFC 8446 §4)") do ->
    # NET.5c.1 verification. Stdlib-only: pure-Quartz wire codec for the TLS
    # 1.3 Handshake protocol — ClientHello, ServerHello, EncryptedExtensions,
    # Certificate, CertificateVerify, Finished — plus the extension wire
    # format inside CH/SH/EE (server_name, supported_versions, supported_groups,
    # signature_algorithms, key_share, ALPN), plus Alert. Encode + decode
    # round-trip for every supported message type with deterministic byte
    # patterns; wire primitives (BE uXX, length open/close); RFC-cited
    # constant sanity (cipher suite IDs, named groups, sig schemes,
    # extension types, version numbers). 103 checks total. Same compile/
    # link/run pipeline as x509:smoke.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v clang > /dev/null 2>&1") != 0
      fail("clang not on PATH — required for the LLVM toolchain")
    end

    var spec = "spec/qz/tls_handshake_smoke.qz"
    if exists(spec) == 0
      fail("Missing #{spec}")
    end
    mkdir_p("tmp/tls-handshake-smoke")
    var ll = "tmp/tls-handshake-smoke/smoke.ll"
    var obj = "tmp/tls-handshake-smoke/smoke.o"
    var bin = "tmp/tls-handshake-smoke/smoke"

