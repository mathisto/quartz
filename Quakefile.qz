##! # Quartz Project Quakefile
##!
##! Build automation for the Quartz compiler project.
##! Run `quake --list` to see available tasks.

import * from quake
import * from progress
import * from process
import time
import * from std/net/tcp
import std/ffi/socket
import * from persistent_worker_protocol
import content_hash
import io/file

# =============================================================================
# Subprocess + --progress event consumer
# =============================================================================
# Drives a Live multi-progress UI from a child process that emits NDJSON
# progress events on stderr (e.g. `quartz --progress`). Reads the merged
# stream (stdout + stderr) line-by-line via pipe_open, advances a Progress
# bar on each {"event":"phase",...} line, and finalizes on done/EOF.

## Extract a string value from a single-line NDJSON object.
## Returns "" if the key isn't present. No real JSON parser — just locates
## `"key":"...` and reads until the closing quote.
def _qjson_get_string(line: String, key: String): String
  var needle = "\"" + key + "\":\""
  var n = str_byte_len(line)
  var k = str_byte_len(needle)
  var i = 0
  while i + k < n
    var ok = 1
    var j = 0
    while j < k
      if str_byte_at(line, i + j) != str_byte_at(needle, j)
        ok = 0
        break
      end
      j += 1
    end
    if ok == 1
      var v_start = i + k
      var v_end = v_start
      while v_end < n and str_byte_at(line, v_end) != '"'
        v_end += 1
      end
      return str_byte_slice(line, v_start, v_end)
    end
    i += 1
  end
  return ""
end

## Format an elapsed-millisecond duration as a short human string.
def _qf_fmt_elapsed(ms: Int): String
  if ms < 1000
    return ms.to_s() + "ms"
  end
  var s = ms / 1000
  var ds = (ms % 1000) / 100
  return s.to_s() + "." + ds.to_s() + "s"
end

## Run an action as one phase of a Live multi-progress pipeline.
## Adds a per-phase Progress to the Live, runs the action, marks the
## bar finished, and logs a completed-phase line above the live region.
## Shows the action's elapsed time in the log.
##
## Uses `Progress.spinner_only()` (no bar column) because each phase is a
## single atomic step — a 0/1 bar conveys no information. The spinner +
## label + ticking elapsed time tells the user the phase is alive; the
## global bar at the top tracks overall pipeline progress.
def live_phase(live: Live, label: String, action: Fn(): Void): Void
  var bar = Progress.spinner_only().label(label)
  live.add(bar)
  bar.start()
  live.tick()
  var start_ms = time_mono_ms()
  action()
  var elapsed = time_mono_ms() - start_ms
  bar.finish()
  live.log("  #{color_green("✓")} #{label}  #{color_dim("(" + _qf_fmt_elapsed(elapsed) + ")")}")
  live.tick()
end

## Active bar for the in-flight sh_with_progress call. The sh_stream_lines_async
## callback uses a free-function signature (no env capture), so we thread the
## bar through this module-level slot. Quakefile only ever drives one
## sh_with_progress at a time. (When this helper is lifted into std/quake.qz
## and we want concurrent compiles, this becomes a per-call closure context.)
var _qf_swp_bar: Vec<Progress> = vec_new<Progress>()

def _qf_on_phase_line(line: String): Void
  if _qf_swp_bar.size == 0
    return
  end
  if str_byte_len(line) == 0
    return
  end
  if str_byte_at(line, 0) != '{'
    return
  end
  if str_contains(line, "\"event\":\"phase\"") != 1
    return
  end
  # Typed annotation REQUIRED — without it, Quartz typechecker mis-resolves
  # bar.task and method dispatch (Vec element type lost on indexed access,
  # quirk #5). Method receivers must come from a typed local.
  var bar: Progress = _qf_swp_bar[0]
  bar.inc(1)
  var phase_name = _qjson_get_string(line, "phase")
  if str_byte_len(phase_name) > 0
    bar.msg(phase_name)
  end
end

## Run a shell command, consuming `--progress` NDJSON events from its
## stderr stream. Drives a Live UI showing the current phase and a
## synthetic progress bar over the expected phase count.
##
## Internally spawns the pipe consumer as a `go`-task so the read loop
## yields cooperatively to the M:N scheduler via `io_suspend` (see
## std/process.qz `sh_stream_lines_async`). The Live idle hook keeps the
## spinner animating while the child runs; concurrent sh_with_progress
## calls in different tasks would run truly in parallel.
##
## The command's stderr is captured via the pipe (NDJSON consumer), while
## its stdout is redirected to stdout_path. The redirect ordering matters:
## `cmd 2>&1 1>file` makes stderr inherit the pipe BEFORE stdout is
## redirected to the file, leaving stderr on the pipe.
##
## label: shown as the global header label
## expected_phases: total phase count for the bar (e.g. 8 for the compiler)
## cmd: command to run, MUST NOT contain its own redirections
## stdout_path: file to receive the command's stdout (use "" for /dev/null)
##
## Returns the child's exit code.
def sh_with_progress(label: String, expected_phases: Int, cmd: String, stdout_path: String): Int
  var live = Live.new()
    .with_global(label, expected_phases)
    .max_active(1)
    .start()
  var bar = Progress.new(expected_phases).label(label)
  live.add(bar)
  bar.start()

  var dest = stdout_path
  if str_byte_len(dest) == 0
    dest = "/dev/null"
  end
  var full = "#{cmd} 2>&1 1>#{dest}"

  # Publish the bar for _qf_on_phase_line, then run the async stream
  # consumer via go + await so the read loop yields to the scheduler.
  _qf_swp_bar.push(bar)
  var task = go sh_stream_lines_async(full, _qf_on_phase_line)
  var exit_code = await task
  _qf_swp_bar = vec_new<Progress>()

  if exit_code == 0
    bar.finish()
  else
    bar.fail("exit #{exit_code}")
  end
  live.finish()
  return exit_code
end

# =============================================================================
# Configuration
# =============================================================================

def compiler_path(): String = "self-hosted/bin/quartz"
def std_path(): String = "std"

# =============================================================================
# Tasks
# =============================================================================

def main(): Int
  # ---- Default ----

  var default_deps = vec_new<String>()
  default_deps.push("format_check")
  task_alias("default", default_deps)

  # ---- Version ----

  task("version", "Show current version") do ->
    var ver = read_file("VERSION")
    puts("Quartz v#{str_trim(ver)}")
  end

  # ---- Clean ----

  task("clean", "Remove build artifacts") do ->
    step("Removing tmp/") do ->
      rm_rf("tmp")
    end
    step("Removing stale .ll and .o files") do ->
      var ll_files = glob("*.ll")
      var ll_count = ll_files.size
      for i in 0..ll_count
        rm(ll_files[i])
      end
      var o_files = glob("*.o")
      var o_count = o_files.size
      for i in 0..o_count
        rm(o_files[i])
      end
    end
    step("Removing stale binaries") do ->
      rm("stage1")
      rm("stage2")
      rm("lint")
    end
  end

  # ---- Format ----

  task("format", "Format all .qz source files") do ->
    # SAFETY GUARD (epic/formatter-2026-06-18, Step 0): the real `quartz --format`
    # is not shipped yet. The previous body shelled out to `--format` and wrote its
    # output (CLI help text) over every .qz — it corrupted 1417 files on 2026-06-10.
    # Refuse to run until M3.1 wires this task to the real CST-based formatter.
    fail("`quake format` is disabled: the formatter is not shipped yet (see epic/formatter-2026-06-18, M3.1). It previously overwrote .qz files with CLI help text. Do NOT re-enable without the safety net (D5/D6).")
  end

  # ---- Format Check ----

  task("format_check", "Check formatting (CI)") do ->
    # SAFETY GUARD (epic/formatter-2026-06-18, Step 0): paired with `format` above.
    # `--format` is unimplemented, so this check compared every file against CLI
    # help text and then told the user to run the corrupting `format` task. Disabled
    # until M3.1 wires both tasks to the real CST-based formatter.
    fail("`quake format_check` is disabled: the formatter is not shipped yet (see epic/formatter-2026-06-18, M3.1).")
  end

  # ---- Lint ----

  task("lint", "Run linter on all .qz source files") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler}")
    end
    var files = glob("**/*.qz")
    var count = files.size
    var pb = Progress.new(count)
      .label("lint")
      .template("{spinner.cyan} {label} [{bar:30.cyan}] {pos}/{len} {msg.dim}")
    pb.start()
    var error_count = 0
    var file_count = 0
    var lint_failures = vec_new<String>()
    for i in 0..count
      var file = files[i]
      pb.msg(file)
      if str_starts_with(file, "tmp/") == 1
        # skip build artifacts
      else
        file_count = file_count + 1
        var cmd = "#{compiler} lint #{file} 2>&1"
        var output = sh_capture(cmd)
        if str_byte_len(output) > 0
          if str_contains(output, "error") == 1 or str_contains(output, "warning") == 1
            lint_failures.push("#{color_yellow(file)}:\n#{output}")
            error_count = error_count + 1
          end
        end
      end
      pb.inc(1)
    end
    if error_count > 0
      pb.fail("#{error_count} files with issues")
      var lf = 0
      while lf < lint_failures.size
        eputs(lint_failures[lf])
        lf = lf + 1
      end
      fail("#{error_count} file(s) have lint issues")
    else
      pb.finish_with("all #{file_count} files clean")
    end
  end

  # ---- Bench ----

  task("bench", "Run benchmarks (full, 10 iterations)") do ->
    sh("./bin/bench --compare")
  end

  task("bench_quick", "Run benchmarks (quick — 5 iterations)") do ->
    sh("./bin/bench --quick --compare")
  end

  task("bench_precise", "Run benchmarks (precise — 30 iterations)") do ->
    sh("./bin/bench --precise --compare")
  end

  task("bench_conc", "Run concurrency benchmarks (Quartz vs Go)") do ->
    sh("./bin/bench --conc")
  end

  task("bench_compile", "Compile all benchmark pairs (Quartz + C)") do ->
    sh("bash benchmarks/run.sh --compile-only")
  end

  # ---- RSS measurement (per-phase, gating decisions) ----

  task("bench_rss", "Measure per-phase RSS of HEAD compiler on style_demo (3 runs, captures benchmarks/rss/style_demo_head.csv)") do ->
    _compile_qz_tool("tools/measure_rss.qz", "/tmp/_quake_measure_rss")
    step("Run RSS measurement") do ->
      sh_maybe("mkdir -p benchmarks/rss")
      var result = sh_maybe("/tmp/_quake_measure_rss --binary self-hosted/bin/quartz --workload examples/style_demo.qz --runs 3 --include-flags \"-I std -I .\" --emit-csv benchmarks/rss/style_demo_head.csv")
      if result != 0
        fail("measure_rss failed")
      end
    end
  end

  task("bench_rss_diff", "Diff HEAD compiler against benchmarks/rss/style_demo_pre_a2_p1.csv baseline") do ->
    _compile_qz_tool("tools/measure_rss.qz", "/tmp/_quake_measure_rss")
    step("Run RSS diff") do ->
      var result = sh_maybe("/tmp/_quake_measure_rss --binary self-hosted/bin/quartz --workload examples/style_demo.qz --runs 3 --include-flags \"-I std -I .\" --baseline benchmarks/rss/style_demo_pre_a2_p1.csv")
      if result != 0
        fail("measure_rss diff failed")
      end
    end
  end

  # ---- Scheduler Benchmarks (P21+) ----

  task("sched_bench", "Run scheduler benchmarks with history tracking (10 iters)") do ->
    _compile_qz_tool("tools/sched_bench.qz", "/tmp/_quake_sched_bench")
    _compile_qz_tool("tools/bench_history.qz", "/tmp/_quake_bench_history")
    step("Run benchmarks") do ->
      var result = sh_maybe("/tmp/_quake_sched_bench 2>/dev/null > /tmp/_sched_bench_output.txt")
      if result != 0
        fail("sched_bench failed")
      end
    end
    step("Record results") do ->
      var result = sh_maybe("/tmp/_quake_bench_history --record /tmp/_sched_bench_output.txt")
      if result != 0
        fail("bench_history detected regression")
      end
    end
  end

  task("sched_bench_quick", "Quick scheduler benchmarks (5 iterations)") do ->
    _compile_qz_tool("tools/sched_bench.qz", "/tmp/_quake_sched_bench")
    _compile_qz_tool("tools/bench_history.qz", "/tmp/_quake_bench_history")
    step("Run benchmarks") do ->
      var result = sh_maybe("/tmp/_quake_sched_bench --quick 2>/dev/null > /tmp/_sched_bench_output.txt")
      if result != 0
        fail("sched_bench failed")
      end
    end
    step("Record results") do ->
      var result = sh_maybe("/tmp/_quake_bench_history --record /tmp/_sched_bench_output.txt")
      if result != 0
        fail("bench_history detected regression")
      end
    end
  end

  task("sched_bench_precise", "Precise scheduler benchmarks (30 iterations)") do ->
    _compile_qz_tool("tools/sched_bench.qz", "/tmp/_quake_sched_bench")
    _compile_qz_tool("tools/bench_history.qz", "/tmp/_quake_bench_history")
    step("Run benchmarks") do ->
      var result = sh_maybe("/tmp/_quake_sched_bench --precise 2>/dev/null > /tmp/_sched_bench_output.txt")
      if result != 0
        fail("sched_bench failed")
      end
    end
    step("Record results") do ->
      var result = sh_maybe("/tmp/_quake_bench_history --record /tmp/_sched_bench_output.txt")
      if result != 0
        fail("bench_history detected regression")
      end
    end
  end

  # ---- Statistical bench framework (C.8) ----

  task("bench:compare", "Compare two BENCHJSON-formatted JSONL files (BASELINE=<path> CURRENT=<path>)") do ->
    var baseline = env_get("BASELINE")
    var current = env_get("CURRENT")
    if str_byte_len(baseline) == 0
      fail("BASELINE=<path> required")
    end
    if str_byte_len(current) == 0
      fail("CURRENT=<path> required")
    end
    _compile_qz_tool("tools/bench_compare.qz", "/tmp/_quake_bench_compare")
    step("Compare") do ->
      ## bench_compare exits 1 on regression — surface that to caller.
      var rc = sh_maybe("/tmp/_quake_bench_compare #{baseline} #{current}")
      if rc != 0
        fail("regression detected")
      end
    end
  end

  task("sched_history", "Show scheduler benchmark history") do ->
    _compile_qz_tool("tools/bench_history.qz", "/tmp/_quake_bench_history")
    sh("/tmp/_quake_bench_history --show 10")
  end

  task("sched_compare", "Compare Quartz vs Go vs Erlang/OTP scheduler performance") do ->
    sh("./benchmarks/concurrency/compare_runtimes.sh")
  end

  task("sched_trend", "Show performance trend for a scenario (SCENARIO=spawn_rate)") do ->
    _compile_qz_tool("tools/bench_history.qz", "/tmp/_quake_bench_history")
    var scenario = env_get("SCENARIO")
    if str_byte_len(scenario) == 0
      scenario = "spawn_rate"
    end
    sh("/tmp/_quake_bench_history --trend #{scenario}")
  end

  # ---- Test ----

  task("test:clear_cache", "Clear IR compilation cache") do ->
    rm_rf("tmp/ir_cache")
    puts("IR cache cleared")
  end
  # ---- Build ----

  task("build", "Build Quartz compiler (self-hosted, debug)") do ->
    build_compiler(0)
  end

  task("build:release", "Build Quartz compiler (release, -O2)") do ->
    build_compiler(1)
  end

  task("build:separate", "Build compiler via separate compilation (per-module .ll → parallel llc → link)") do ->
    build_compiler_separate()
  end

  # ---- WASM Direct Backend ----

  task("build:wasm", "Compile a .qz file to WASM (FILE=program.qz)") do ->
    var file = env_get("FILE")
    if str_byte_len(file) == 0
      fail("Usage: FILE=program.qz quake build:wasm")
    end
    var out = str_replace(file, ".qz", ".wasm")
    var cmd = "#{compiler_path()} --backend wasm --no-cache -I . -I #{std_path()} #{file} -o #{out}"
    step("Compiling to WASM") do ->
      sh(cmd)
    end
  end

  task("test:wasm", "Run WASM backend end-to-end tests") do ->
    env("FILE", "spec/qspec/wasm_backend_spec.qz")
    run_qspec_file()
  end

  task("playground", "Start the Quartz browser playground (localhost:8080)") do ->
    step("Starting playground server") do ->
      sh("node playground/serve.js")
    end
  end

  # ---- Fixpoint ----

  task("fixpoint", "Validate fixpoint (gen1 == gen2 byte-identical)") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler}")
    end
    var include_flags = qz_include_flags()
    var source = "self-hosted/quartz.qz"
    mkdir_p("tmp")

    puts(color_bold("=== Self-Hosted Fixpoint Validation ==="))

    # Gen1: current compiler compiles source
    step("Gen0 → Gen1 (compile source)") do ->
      var cmd = "#{compiler} --no-opt --no-cache #{include_flags} #{source} > tmp/gen1.ll 2>tmp/gen1.err"
      sh(cmd)
    end
    var gen1_funcs = sh_capture("grep '^define' tmp/gen1.ll | wc -l")
    var gen1_count = as_int(str_trim(gen1_funcs))
    puts("  #{gen1_count} functions")
    if gen1_count < 1400
      fail("Too few functions (#{gen1_count}), expected 1400+")
    end

    # Build gen1 binary
    step("Build Gen1 binary") do ->
      if sh_buffered("llc -filetype=obj tmp/gen1.ll -o tmp/gen1.o", "llc-gen1") != 0
        fail("llc-gen1 failed")
      end
      if sh_buffered("#{_linker()} -g #{_stack_flag()} tmp/gen1.o -o tmp/gen1#{_mimalloc_flags()}", "link-gen1") != 0
        fail("link-gen1 failed")
      end
    end

    # Gen2: gen1 binary compiles same source
    step("Gen1 → Gen2 (self-compile)") do ->
      var cmd = "./tmp/gen1 --no-opt --no-cache #{include_flags} #{source} > tmp/gen2.ll 2>tmp/gen2.err"
      sh(cmd)
    end
    var gen2_funcs = sh_capture("grep '^define' tmp/gen2.ll | wc -l")
    var gen2_count = as_int(str_trim(gen2_funcs))
    puts("  #{gen2_count} functions")

    # Compare
    var diff_result = sh_maybe("diff -q tmp/gen1.ll tmp/gen2.ll > /dev/null 2>&1")
    if diff_result == 0
      puts("")
      puts(color_bold(color_green("Fixpoint verified! (#{gen1_count} functions)")))
    else
      puts("")
      sh_maybe("diff tmp/gen1.ll tmp/gen2.ll | head -20")
      fail("Fixpoint FAILED — gen1.ll != gen2.ll")
    end

    # Cleanup
    rm("tmp/gen1.ll")
    rm("tmp/gen1.o")
    rm("tmp/gen1")
    rm("tmp/gen1.err")
    rm("tmp/gen2.ll")
    rm("tmp/gen2.err")

    # CACHE-RO QZMOD SMOKE: fixpoint (gen1==gen2) is structurally blind to
    # the qzmod/cache path. Exercise it explicitly so a cache-contamination
    # regression (dropped wildcard/alias module symbol) is caught here.
    cache_ro_smoke()
  end

  # ---- Cache-RO qzmod smoke (standalone) ----

  task("cache_smoke", "Cache-RO qzmod contamination smoke (prewarm + --cache-ro + llc)") do ->
    puts(color_bold("=== Cache-RO qzmod Smoke ==="))
    cache_ro_smoke()
  end

  # ---- Validate ----

  var validate_deps = vec_new<String>()
  validate_deps.push("fixpoint")
  task_dep("validate", "Full validation (fixpoint + bench)", validate_deps) do ->
    puts("")
    puts(color_bold("=== Quick Benchmark ==="))
    sh("./bin/bench --quick --compare")
    puts(color_green("All validation passed"))
  end

  # ---- QSpec ----

  task("qspec", "Run QSpec test suite (native Quartz tests)") do ->
    run_qspec()
  end

  task("qspec_fast", "Run QSpec skipping slow tests (no network/TLS/spawn)") do ->
    env("QSPEC_FAST", "1")
    run_qspec()
  end

  task("qspec_slow", "Run only the quarantined slow-lane specs (known hangs)") do ->
    env("QSPEC_SLOW", "1")
    run_qspec()
  end

  task("qspec_file", "Run a single QSpec file (FILE=spec/qspec/foo_spec.qz)") do ->
    run_qspec_file()
  end

  task("qspec_runner_test", "Run focused QSpec runner outcome and manifest fixtures") do ->
    _qspec_test_unique_run_dirs()
    sh("bash tools/qspec_runner_test.sh")
  end

  task("qspec_discovery_contract_test", "Run exact QSpec discovery identity contract fixtures") do ->
    _qspec_discovery_contract_test()
    sh("ruby tools/qspec_discovery_contract_test.rb")
  end

  task("guard:protocol_test", "Run transactional guard protocol fixtures") do ->
    sh("ruby tools/quartz_guard_test.rb")
  end

  var test_deps = vec_new<String>()
  test_deps.push("qspec")
  test_deps.push("format_check")
  task_alias("test", test_deps)

  # ---- Snapshots ----

  task("snapshots", "Run IR snapshot tests") do ->
    run_snapshots(0)
  end

  task("snapshots:update", "Update IR snapshots") do ->
    run_snapshots(1)
  end

  task("ufcs:check", "Verify UFCS dispatch snapshot matches source") do ->
    var rc = sh_maybe("./tools/check_ufcs_snapshot.sh")
    if rc != 0
      fail("UFCS dispatch snapshot is stale — run 'quake ufcs:update' to regenerate")
    end
  end

  task("ufcs:update", "Regenerate spec/snapshots/ufcs_dispatch.txt from source") do ->
    var rc = sh_maybe("./tools/check_ufcs_snapshot.sh --regenerate")
    if rc != 0
      fail("Failed to regenerate UFCS snapshot")
    end
  end

  task("smoke", "Run compiler smoke tests (brainfuck + expr_eval)") do ->
    var rc = sh_maybe("./tools/smoke_test.sh")
    if rc != 0
      fail("Smoke tests failed — see output above")
    end
  end

  task("smoke:update", "Update expr_eval smoke baseline (after MULTI-CLAUSE-1 fix)") do ->
    var rc = sh_maybe("./tools/smoke_test.sh --update")
    if rc != 0
      fail("Failed to update smoke baseline")
    end
  end

  # ---- Fuzz Testing ----

  task("fuzz", "Run grammar-guided fuzzer (100 programs)") do ->
    step("Compile fuzzer") do ->
      var compiler = compiler_path()
      var fuzz_ll = "/tmp/_quake_fuzz.ll"
      var result = sh_maybe("#{compiler} -I std -I . tools/fuzz.qz > #{fuzz_ll} 2>/dev/null")
      if result != 0
        fail("Failed to compile fuzzer")
      end
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var llc_r = sh_maybe("llc -filetype=obj #{fuzz_ll} -o /tmp/_quake_fuzz.o 2>/dev/null")
      if llc_r != 0
        fail("llc failed on fuzzer")
      end
      var clang_r = sh_maybe("#{_linker()} /tmp/_quake_fuzz.o -o /tmp/_quake_fuzz 2>/dev/null")
      if clang_r != 0
        fail("linker failed on fuzzer")
      end
    end
    step("Run fuzzer (100 programs)") do ->
      env("QUARTZ_COMPILER", compiler_path())
      env("QUARTZ_STD", std_path())
      var seed = str_from_int(time.time_epoch_ms())
      var result = sh_maybe("/tmp/_quake_fuzz --count 100 --seed #{seed}")
      if result != 0
        fail("Fuzzer found issues")
      end
    end
  end

  task("fuzz_long", "Run fuzzer for extended session (1000 programs, depth 12)") do ->
    step("Compile fuzzer") do ->
      var compiler = compiler_path()
      var fuzz_ll = "/tmp/_quake_fuzz.ll"
      var result = sh_maybe("#{compiler} -I std -I . tools/fuzz.qz > #{fuzz_ll} 2>/dev/null")
      if result != 0
        fail("Failed to compile fuzzer")
      end
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var _llc_r = sh_maybe("llc -filetype=obj #{fuzz_ll} -o /tmp/_quake_fuzz.o 2>/dev/null")
      var _link_r = sh_maybe("#{_linker()} /tmp/_quake_fuzz.o -o /tmp/_quake_fuzz 2>/dev/null")
    end
    step("Run fuzzer (1000 programs, depth 12)") do ->
      env("QUARTZ_COMPILER", compiler_path())
      env("QUARTZ_STD", std_path())
      var seed = str_from_int(time.time_epoch_ms())
      mkdir_p("/tmp/fuzz_crashes")
      var result = sh_maybe("/tmp/_quake_fuzz --count 1000 --depth 12 --seed #{seed} --save-crashes /tmp/fuzz_crashes --shrink")
      if result != 0
        fail("Fuzzer found issues — see /tmp/fuzz_crashes/")
      end
    end
  end

  task("fuzz_differential", "Differential test against previous compiler version") do ->
    step("Compile fuzzer") do ->
      var compiler = compiler_path()
      var fuzz_ll = "/tmp/_quake_fuzz.ll"
      var result = sh_maybe("#{compiler} -I std -I . tools/fuzz.qz > #{fuzz_ll} 2>/dev/null")
      if result != 0
        fail("Failed to compile fuzzer")
      end
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var _llc_r = sh_maybe("llc -filetype=obj #{fuzz_ll} -o /tmp/_quake_fuzz.o 2>/dev/null")
      var _link_r = sh_maybe("#{_linker()} /tmp/_quake_fuzz.o -o /tmp/_quake_fuzz 2>/dev/null")
    end
    step("Run differential test") do ->
      var alt = env_get("FUZZ_ALT_COMPILER")
      if str_byte_len(alt) == 0
        fail("Set FUZZ_ALT_COMPILER=path/to/previous/binary")
      end
      env("QUARTZ_COMPILER", compiler_path())
      env("QUARTZ_STD", std_path())
      var seed = str_from_int(time.time_epoch_ms())
      var result = sh_maybe("/tmp/_quake_fuzz --count 100 --seed #{seed} --differential #{alt}")
      if result != 0
        fail("Differential test found regressions")
      end
    end
  end

  # ---- Install ----

  task("install", "Install current build as versioned binary") do ->
    var ver = str_trim(read_file("VERSION"))
    var src = "self-hosted/bin/quartz"
    var dest = "self-hosted/bin/quartz-v#{ver}"
    cp(src, dest)
    puts("Installed: #{dest}")
  end

  # ---- Release ----

  task("release", "Release a new version (set QUAKE_VERSION=X.Y.Z)") do ->
    var new_ver = env_get("QUAKE_VERSION")
    if str_byte_len(new_ver) == 0
      fail("Usage: QUAKE_VERSION=X.Y.Z quake release")
    end
    var old_ver = str_trim(read_file("VERSION"))

    step("Archive current binary") do ->
      var old_bin = "self-hosted/bin/quartz-v#{old_ver}"
      if exists(old_bin) == 0
        cp("self-hosted/bin/quartz", old_bin)
        puts("  Archived: #{old_bin}")
      end
    end

    step("Update VERSION") do ->
      var _w = write_file("VERSION", "#{new_ver}\n")
    end

    step("Build #{new_ver}") do ->
      build_compiler(0)
    end

    step("Git commit + tag") do ->
      sh("git add VERSION self-hosted/bin/")
      sh("git commit -m 'Release v#{new_ver}'")
      sh("git tag v#{new_ver}")
    end

    puts("")
    puts(color_green("Released v#{new_ver}"))
    puts("   Run 'git push && git push --tags' to publish")
  end
