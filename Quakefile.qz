    puts(color_green("dudect:canary: green"))
  end

  task("dudect:smoke", "Validate in-tree CT primitives via dudect (ct_eq_bytes, ct_select_int, _f51_cswap, _sc_reduce_64, mlkem_decaps, aes_encrypt_block, aes_gcm_encrypt)") do ->
    # NET.4.2 (subtle + curve25519 + _f51_cswap) and NET.4 follow-ups
    # (TweetNaCl _sc_reduce_64; mlkem768_decaps FO implicit-reject path),
    # plus NET.5a.3 (aes_encrypt_block AES-128/256 key-class;
    # aes_gcm_encrypt key-class + plaintext-class). Runs dudect_assert_ct
    # against each; max|t| < 5.0 (Reparaz et al.'s "weak leak" floor) is
    # the gate. Regression gate for future refactors of
    # std/core/crypto/{subtle,curve25519,ed25519,mlkem,aes,aes_gcm}.qz.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v clang > /dev/null 2>&1") != 0
      fail("clang not on PATH — required for the LLVM toolchain")
    end

    var spec = "spec/qz/dudect_smoke.qz"
    if exists(spec) == 0
      fail("Missing #{spec}")
    end
    mkdir_p("tmp/dudect-smoke")
    var ll = "tmp/dudect-smoke/smoke.ll"
    var obj = "tmp/dudect-smoke/smoke.o"
    var bin = "tmp/dudect-smoke/smoke"

    step("Compile spec to IR") do ->
      var include_flags = qz_include_flags()
      if sh_maybe("#{compiler} #{include_flags} #{spec} > #{ll} 2>tmp/dudect-smoke/compile.err") != 0
        eputs(read_file("tmp/dudect-smoke/compile.err"))
        fail("Quartz compile failed")
      end
    end

    step("Dead-strip unused IR (internalize + globaldce)") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/dudect-smoke/smoke.dce.ll"
      if sh_maybe("opt -passes='internalize,globaldce' --internalize-public-api-list=main #{ll} -S -o #{ll_dce} 2>tmp/dudect-smoke/opt.err") != 0
        eputs(read_file("tmp/dudect-smoke/opt.err"))
        fail("opt dead-strip failed")
      end
    end

    step("Assemble IR to object") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/dudect-smoke/smoke.dce.ll"
      if sh_maybe("llc -filetype=obj #{ll_dce} -o #{obj} 2>tmp/dudect-smoke/llc.err") != 0
        eputs(read_file("tmp/dudect-smoke/llc.err"))
        fail("llc failed")
      end
    end

    step("Link") do ->
      var dead_strip = _crypto_dead_strip_flag()
      if sh_maybe("clang #{obj} -o #{bin} -lm -lpthread #{dead_strip} 2>tmp/dudect-smoke/link.err") != 0
        eputs(read_file("tmp/dudect-smoke/link.err"))
        fail("link failed")
      end
    end

    step("Run smoke") do ->
      if sh_maybe("./#{bin}") != 0
        fail("dudect smoke exit non-zero — see output above")
      end
    end

    puts(color_green("dudect:smoke: green"))
  end

  task("wg:smoke", "End-to-end smoke: WireGuard handshake driver loopback") do ->
    # NET.1 Phase 2, Step 2.16 verification. Compiles spec/qz/wg_smoke.qz and
    # exercises the std/net/wireguard/{peer,session,handshake}.qz layer
    # end-to-end through the now-fully-native crypto stack: initiator +
    # responder loopback handshake, transport-key derivation, AEAD round-trip
    # under the derived keys, plus negative paths (MAC1 tamper, receiver_index
    # mismatch, type-byte mismatch). Asserts exit 0.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v clang > /dev/null 2>&1") != 0
      fail("clang not on PATH — required for the LLVM toolchain")
    end

    var spec = "spec/qz/wg_smoke.qz"
    if exists(spec) == 0
      fail("Missing #{spec}")
    end
    mkdir_p("tmp/wg-smoke")
    var ll = "tmp/wg-smoke/smoke.ll"
    var obj = "tmp/wg-smoke/smoke.o"
    var bin = "tmp/wg-smoke/smoke"

    step("Compile spec to IR") do ->
      var include_flags = qz_include_flags()
      if sh_maybe("#{compiler} #{include_flags} #{spec} > #{ll} 2>tmp/wg-smoke/compile.err") != 0
        eputs(read_file("tmp/wg-smoke/compile.err"))
        fail("Quartz compile failed")
      end
    end

    step("Dead-strip unused IR (internalize + globaldce)") do ->
      # The Quartz compiler emits every function from imported modules as
      # external linkage, so unreachable code (e.g. `rng_new_hw`'s x86
      # rdrand/rdseed intrinsics) sits in the IR even when no spec callsite
      # touches it. On aarch64 hosts that's a hard llc failure: "Cannot
      # select: intrinsic %llvm.x86.rdrand.64". Internalize-then-globaldce
      # before llc strips the unreachable graph cleanly. Filed as a
      # compiler-side TODO — the right long-term fix is signature-level
      # dead-strip during IR emission.
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/wg-smoke/smoke.dce.ll"
      if sh_maybe("opt -passes='internalize,globaldce' --internalize-public-api-list=main #{ll} -S -o #{ll_dce} 2>tmp/wg-smoke/opt.err") != 0
        eputs(read_file("tmp/wg-smoke/opt.err"))
        fail("opt dead-strip failed")
      end
    end

    step("Assemble IR to object") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      var ll_dce = "tmp/wg-smoke/smoke.dce.ll"
      if sh_maybe("llc -filetype=obj #{ll_dce} -o #{obj} 2>tmp/wg-smoke/llc.err") != 0
        eputs(read_file("tmp/wg-smoke/llc.err"))
        fail("llc failed")
      end
    end

    step("Link") do ->
      var dead_strip = _crypto_dead_strip_flag()
      if sh_maybe("clang #{obj} -o #{bin} -lm -lpthread #{dead_strip} 2>tmp/wg-smoke/link.err") != 0
        eputs(read_file("tmp/wg-smoke/link.err"))
        fail("link failed")
      end
    end

    step("Run smoke test") do ->
      if sh_maybe("./#{bin}") != 0
        fail("smoke test exit non-zero — see output above")
      end
    end

    puts(color_green("wg:smoke: green"))
  end

  task("baremetal:verify_x86_64", "Verify Quake Multiboot2 linker-script passthrough (x86_64 ld.lld -T script.ld)") do ->
    # SYS.5 twin of baremetal:verify. Mirrors the aarch64 smoke flow but
    # exercises x86_64 + Multiboot2: assembles a 32-bit boot stub with a
    # Multiboot2 header, links it with tools/baremetal/x86_64-multiboot.ld,
    # verifies the ELF is x86-64, entry sits at 0x100020 (past the 24-byte
    # multiboot header), and the .multiboot section carries the magic
    # 0xe85250d6 in little-endian. Does not attempt to boot in QEMU — that
    # is KERN.1 territory, once the 32→64 long-mode transition is written.
    mkdir_p("tmp/baremetal")
    var asm_source = "tools/baremetal/smoke_x86.s"
    var linker_script = "tools/baremetal/x86_64-multiboot.ld"
    var obj_path = "tmp/baremetal/smoke_x86.o"
    var elf_path = "tmp/baremetal/smoke_x86.elf"

    if exists(asm_source) == 0
      fail("Missing #{asm_source}")
    end
    if exists(linker_script) == 0
      fail("Missing #{linker_script}")
    end

    step("Assembling #{asm_source}") do ->
      if assemble(asm_source, obj_path, "x86_64-unknown-none", "") != 0
        fail("assemble failed on #{asm_source}")
      end
    end

    step("Linking with #{linker_script}") do ->
      var objs = vec_new<String>()
      objs.push(obj_path)
      if link_baremetal(objs, elf_path, linker_script, "") != 0
        fail("link_baremetal failed")
      end
    end

    step("Verifying ELF") do ->
      if exists(elf_path) == 0
        fail("No ELF produced at #{elf_path}")
      end
      var readelf_bin = "llvm-readelf"
      if sh_maybe("#{readelf_bin} --version > /dev/null 2>&1") != 0
        readelf_bin = "readelf"
      end
      var header = sh_capture("#{readelf_bin} -h #{elf_path}")
      if str_contains(header, "X86-64") == 0
        eputs(header)
        fail("Machine type X86-64 not found — target triple not applied")
      end
      # Entry point must sit past the 24-byte Multiboot2 header (at 0x100018)
      # — linker pads to 16 so _start lands at 0x100020.
      if str_contains(header, "0x100020") == 0
        eputs(header)
        fail("Entry point 0x100020 not found — linker script not applied")
      end
      # .multiboot section must exist and hold the magic `d6 50 52 e8`
      # (little-endian 0xe85250d6). Use objdump to dump the section.
      var objdump_bin = "llvm-objdump"
      if sh_maybe("#{objdump_bin} --version > /dev/null 2>&1") != 0
        objdump_bin = "objdump"
      end
      var sections = sh_capture("#{objdump_bin} -h #{elf_path}")
      if str_contains(sections, ".multiboot") == 0
        eputs(sections)
        fail("No .multiboot section — linker script did not place the boot header")
      end
      var mb_dump = sh_capture("#{objdump_bin} -s -j .multiboot #{elf_path}")
      if str_contains(mb_dump, "d65052e8") == 0
        eputs(mb_dump)
        fail("Multiboot2 magic 0xe85250d6 (little-endian d6 50 52 e8) missing from .multiboot section")
      end
      puts(color_green("  ELF valid: x86-64, entry 0x100020, Multiboot2 header present and correctly laid out."))
    end

    step("Cleanup") do ->
      rm(obj_path)
      rm(elf_path)
    end
  end

  task("xbuild:windows", "Cross-compile a .qz file from Darwin → .exe (Phase 1+4+5a Windows target acceptance; SRC=path/to.qz to override the default hello.qz)") do ->
    # End-to-end verification that the Windows cross-compile pipeline works:
    # Quartz IR → llc PE/COFF → zig cc → PE32+ console .exe. Eli's use-case
    # path on a Darwin or Linux host. Pre-flights zig + llc, then runs the
    # canonical four-step pipeline documented in
    # docs/design/QUARTZ_WINDOWS_TARGET.md. Validates the artifact is a
    # PE32+ binary (magic + machine type) and prints the DLL imports so
    # the user can see at a glance that bcrypt / kernel32 resolved.
    #
    # Default source is examples/windows/hello.qz (the smallest acceptance
    # probe). Override via SRC= to build any other probe — same pipeline:
    #   SRC=examples/windows/diagnostics.qz  → Phase-4 helper diagnostics
    #     (runs every Windows-specific runtime helper at startup so a
    #     broken helper surfaces immediately rather than at first usage).
    #   SRC=examples/windows/go_smoke.qz     → Phase-5a scheduler smoke
    #     (spawns + awaits a goroutine; mechanical link verification that
    #     pthread→Win32 shims + worker-pool init linked clean. Runtime
    #     correctness needs a Windows host.)
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link (bundles mingw-w64 + lld-link).\n   Install via `brew install zig`, `apt install zig`, or https://ziglang.org/download/")
    end

    var src = env_get("SRC")
    if str_byte_len(src) == 0
      src = "examples/windows/hello.qz"
    end
    if exists(src) == 0
      fail("Missing #{src}")
    end
    # Derive output stem from the source basename (strip ".qz")
    var stem = basename_no_ext(src, ".qz")
    mkdir_p("tmp/xbuild-windows")
    var ll  = "tmp/xbuild-windows/#{stem}.ll"
    var obj = "tmp/xbuild-windows/#{stem}.o"
    var exe = "tmp/xbuild-windows/#{stem}.exe"
    var target = "x86_64-pc-windows-gnu"
    var zig_target = "x86_64-windows-gnu"

    step("Compile #{src} → Windows IR") do ->
      if sh_maybe("#{compiler} --target=#{target} #{src} > #{ll} 2>tmp/xbuild-windows/compile.err") != 0
        eputs(read_file("tmp/xbuild-windows/compile.err"))
        fail("Quartz compile failed (target=#{target})")
      end
    end

    step("Lower IR → PE/COFF .obj (llc)") do ->
      var current_path = env_get("PATH")
      env("PATH", "#{_llvm_path_prefix()}#{current_path}")
      if sh_maybe("llc -filetype=obj #{ll} -o #{obj} 2>tmp/xbuild-windows/llc.err") != 0
        eputs(read_file("tmp/xbuild-windows/llc.err"))
        fail("llc failed")
      end
    end

    step("Link → #{stem}.exe (zig cc -target #{zig_target} -lbcrypt -lntdll -lws2_32)") do ->
      # -lbcrypt: BCryptGenRandom (Phase 4 — qz_crypto_rand_int)
      # -lntdll: NtCreateFile / NtDeviceIoControlFile / NtCancelIoFileEx /
      #          NtClose (Phase 5e — AFD.SYS substrate)
      # -lws2_32: WSAIoctl (Phase 5e — SIO_BASE_HANDLE LSP unwrap)
      if sh_maybe("zig cc -target #{zig_target} #{obj} -o #{exe} -lbcrypt -lntdll -lws2_32 2>tmp/xbuild-windows/link.err") != 0
        eputs(read_file("tmp/xbuild-windows/link.err"))
        fail("zig cc link failed")
      end
    end

    step("Verify PE32+ artifact") do ->
      if exists(exe) == 0
        fail("No .exe produced at #{exe}")
      end
      var magic = sh_capture("file #{exe}")
      if str_contains(magic, "PE32+") == 0
        eputs(magic)
        fail("Artifact is not PE32+ — file(1) says: #{magic}")
      end
      if str_contains(magic, "x86-64") == 0
        eputs(magic)
        fail("Artifact is not x86-64 — file(1) says: #{magic}")
      end
      puts(color_green("  PE32+ x86-64 console executable verified"))
    end

    step("Inspect imports") do ->
      var objdump_bin = "llvm-objdump"
      if sh_maybe("#{objdump_bin} --version > /dev/null 2>&1") != 0
        objdump_bin = "objdump"
      end
      var imports = sh_capture("#{objdump_bin} -p #{exe} 2>/dev/null | grep 'DLL Name'")
      if str_byte_len(imports) > 0
        puts(imports)
      end
    end

    puts(color_green("xbuild:windows: green — #{exe}"))
  end

  task("xbuild:phase5", "Phase-5 full-substrate acceptance probe — verifies go_smoke.exe imports every 5a/5b/5d/5e symbol (5c is timer-heap, no new imports)") do ->
    # The Phase 5 single-command acceptance gate. Compiles go_smoke.qz with
    # the SCHEDULER substrate emitted (uses_scheduler=1 via the `go fn()` +
    # `await` in main), then inspects the resulting .exe for the canonical
    # set of imports that prove every sub-phase landed:
    #
    #   5a — pthread→Win32 (CreateThread, WaitForSingleObject, SRWLock, …)
    #   5b — IOCP triad (CreateIoCompletionPort, GetQueuedCompletionStatusEx,
    #        PostQueuedCompletionStatus)
    #   5c — software timer heap (no new imports — pure-Quartz state machine)
    #   5d — process-exit (RegisterWaitForSingleObject)
    #   5e — AFD.SYS substrate (NtCreateFile, NtDeviceIoControlFile, NtClose,
    #        SetFileCompletionNotificationModes, WSAIoctl)
    #
    # If any of these are missing, the corresponding sub-phase regressed.
    # We shell out to a fresh quake invocation (rather than re-entering the
    # task graph) so the SRC env-var propagation is unambiguous.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/go_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/go_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/go_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/go_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify Phase-5 imports in #{exe}") do ->
      # The canonical Phase-5 import set. If any is missing, regression.
      var expected = vec_new<String>()
      expected.push("CreateThread")
      expected.push("WaitForSingleObject")
      expected.push("CreateIoCompletionPort")
      expected.push("GetQueuedCompletionStatusEx")
      expected.push("PostQueuedCompletionStatus")
      expected.push("RegisterWaitForSingleObject")
      expected.push("NtCreateFile")
      expected.push("NtDeviceIoControlFile")
      expected.push("NtClose")
      expected.push("NtCancelIoFileEx")
      expected.push("SetFileCompletionNotificationModes")
      expected.push("WSAIoctl")
      # Phase 5e+ DX — pthread_setname_np shim wires SetThreadDescription
      # via MultiByteToWideChar (UTF-8 → UTF-16). Both pulled into every
      # Windows binary that uses go fn() because the worker pool's setup
      # path calls pthread_setname_np per worker thread.
      expected.push("SetThreadDescription")
      expected.push("MultiByteToWideChar")
      # Phase 5e+ DX — SetConsoleCtrlHandler installed in sched_init for
      # Ctrl+Break task-dump (POSIX SIGUSR1 equivalent).
      expected.push("SetConsoleCtrlHandler")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:phase5: MISSING imports —#{missing}"))
        fail("Phase 5 substrate regression — re-run quake guard and check codegen_runtime.qz")
      end
      puts(color_green("  all #{expected.size} Phase-5 imports present"))
    end
    puts(color_green("xbuild:phase5: green — Phase 5 substrate intact"))
  end

  task("xbuild:ws2", "ws2_32 user-facing socket FFI acceptance probe — verifies socket_smoke.exe links against ws2_32.dll with the canonical user API symbols") do ->
    # Sibling of xbuild:phase5: that one covers the SCHEDULER substrate
    # (sched_init → IOCP → AFD.SYS → poller); THIS one covers the
    # USER-FACING ws2_32 surface (WSAStartup + socket / bind / listen /
    # getsockname / closesocket from std/ffi/socket.qz's Windows block).
    # Both substrates landed at the same time; both deserve a one-command
    # green-or-named-symbol gate.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/socket_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/socket_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/socket_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/socket_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify ws2_32 user-API imports in #{exe}") do ->
      # The canonical ws2_32 user-facing import set. If any is missing,
      # std/ffi/socket.qz's @cfg(os: "windows") block regressed.
      var expected = vec_new<String>()
      expected.push("WSAStartup")
      expected.push("socket")
      expected.push("bind")
      expected.push("listen")
      expected.push("getsockname")
      expected.push("closesocket")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:ws2: MISSING imports —#{missing}"))
        fail("ws2_32 user FFI regression — re-run quake guard and check std/ffi/socket.qz Windows block")
      end
      puts(color_green("  all #{expected.size} ws2_32 user-API imports present"))
    end
    puts(color_green("xbuild:ws2: green — ws2_32 user FFI intact"))
  end

  task("xbuild:tcp_echo", "Two-process TCP echo acceptance — verifies tcp_echo_smoke.exe imports the FULL ws2_32 client+server surface (socket+bind+listen+accept on the server side; socket+connect+send+recv on the client side; closesocket on both)") do ->
    # The big-brother gate of xbuild:ws2. socket_smoke.exe exercises the
    # SETUP half of ws2_32 (WSAStartup + socket + bind + listen +
    # getsockname + closesocket); tcp_echo_smoke.exe additionally drives
    # the TRANSPORT half (accept + connect + send + recv + setsockopt +
    # WSAGetLastError). Built from one source file with server/client modes
    # dispatched by argv — runs as a pair of cmd windows on the Windows
    # host. See examples/windows/tcp_echo_smoke.qz header for the user
    # invocation. This task only verifies the link surface; runtime
    # confirmation needs two terminals on a Windows machine.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/tcp_echo_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/tcp_echo_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/tcp_echo_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/tcp_echo_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify ws2_32 transport-surface imports in #{exe}") do ->
      # Full client+server import set. Misses indicate either the smoke
      # stopped calling the helper OR std/ffi/socket.qz's @cfg(os: "windows")
      # block regressed for that symbol.
      var expected = vec_new<String>()
      expected.push("WSAStartup")
      expected.push("WSAGetLastError")
      expected.push("socket")
      expected.push("bind")
      expected.push("listen")
      expected.push("accept")
      expected.push("connect")
      expected.push("send")
      expected.push("recv")
      expected.push("setsockopt")
      expected.push("closesocket")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:tcp_echo: MISSING imports —#{missing}"))
        fail("ws2_32 transport surface regression — re-run quake guard and check std/ffi/socket.qz Windows block")
      end
      puts(color_green("  all #{expected.size} ws2_32 transport-API imports present"))
    end
    puts(color_green("xbuild:tcp_echo: green — ws2_32 client+server surface intact"))
  end

  task("xbuild:tcp_listen", "std/net/tcp high-level API — verifies tcp_listen_smoke.exe (uses tcp_listen → tcp_close_listener via std/net/tcp) imports the WSAStartup + socket + bind + listen + getsockname + closesocket set from ws2_32.dll. Proves the cross-platform tcp.qz refactor compiles+links on Windows.") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/tcp_listen_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/tcp_listen_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/tcp_listen_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/tcp_listen_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify std/net/tcp surface imports in #{exe}") do ->
      var expected = vec_new<String>()
      expected.push("WSAStartup")
      expected.push("socket")
      expected.push("bind")
      expected.push("listen")
      expected.push("getsockname")
      expected.push("setsockopt")
      expected.push("closesocket")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:tcp_listen: MISSING imports —#{missing}"))
        fail("std/net/tcp cross-platform surface regression — check std/net/tcp.qz @cfg gating")
      end
      puts(color_green("  all #{expected.size} std/net/tcp-via-ws2_32 imports present"))
    end
    puts(color_green("xbuild:tcp_listen: green — std/net/tcp Windows path intact"))
  end

  task("xbuild:tcp_serve", "End-to-end async TCP-on-Windows acceptance — verifies tcp_serve_smoke.exe links ALL THREE substrate layers in one binary: ws2_32 user FFI + AFD.SYS scheduler substrate (Phase 5e) + IOCP / threading (Phase 5a/b/d). Driving stack: go fn() + tcp_serve → async_tcp_accept → io_suspend → __qz_sched_register_io → IOCTL_AFD_POLL → IOCP completion → re-enqueue.") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/tcp_serve_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/tcp_serve_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/tcp_serve_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/tcp_serve_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify all-three-layers imports in #{exe}") do ->
      # ws2_32 (user FFI), ntdll (AFD), kernel32 (IOCP+threading).
      # The full async-TCP-on-Windows substrate fits in one binary.
      var expected = vec_new<String>()
      # ws2_32 user FFI layer
      expected.push("WSAStartup")
      expected.push("WSAGetLastError")
      expected.push("socket")
      expected.push("bind")
      expected.push("listen")
      expected.push("accept")
      expected.push("recv")
      expected.push("send")
      expected.push("setsockopt")
      expected.push("ioctlsocket")
      expected.push("closesocket")
      # Phase 5e AFD.SYS scheduler substrate
      expected.push("NtCreateFile")
      expected.push("NtDeviceIoControlFile")
      expected.push("NtClose")
      expected.push("SetFileCompletionNotificationModes")
      expected.push("WSAIoctl")
      # Phase 5e+ — NtCancelIoFileEx is referenced by __qz_sched_wake's
      # wk_io_cancel and wk_tc_io_cancel branches (Windows-only). Every
      # binary that uses go fn() pulls it in.
      expected.push("NtCancelIoFileEx")
      # Phase 5a/b/d IOCP + threading machinery
      expected.push("CreateIoCompletionPort")
      expected.push("GetQueuedCompletionStatusEx")
      expected.push("PostQueuedCompletionStatus")
      expected.push("RegisterWaitForSingleObject")
      expected.push("CreateThread")
      expected.push("WaitForSingleObject")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:tcp_serve: MISSING imports —#{missing}"))
        fail("async-TCP-on-Windows substrate regression — full chain broken somewhere")
      end
      puts(color_green("  all #{expected.size} substrate symbols present (ws2_32 + AFD + IOCP)"))
    end
    puts(color_green("xbuild:tcp_serve: green — full async-TCP-on-Windows substrate intact"))
  end

  task("xbuild:tcp_timeout", "Cross-platform tcp_connect_timeout — verifies tcp_connect_timeout_smoke.exe imports the non-blocking-connect-with-timeout surface (ioctlsocket + WSAPoll + connect + getsockopt(SO_ERROR) + WSAGetLastError). Drives the new socket_wait_one helper that abstracts poll vs WSAPoll for a single fd.") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/tcp_connect_timeout_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/tcp_connect_timeout_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/tcp_connect_timeout_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/tcp_connect_timeout_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify connect-with-timeout surface in #{exe}") do ->
      var expected = vec_new<String>()
      expected.push("WSAStartup")
      expected.push("WSAGetLastError")
      expected.push("WSAPoll")
      expected.push("socket")
      expected.push("connect")
      expected.push("ioctlsocket")
      expected.push("getsockopt")
      expected.push("inet_pton")
      expected.push("closesocket")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:tcp_timeout: MISSING imports —#{missing}"))
        fail("Cross-platform tcp_connect_timeout regression — check std/ffi/socket.qz socket_wait_one/socket_set_blocking and std/net/tcp.qz tcp_connect_timeout")
      end
      puts(color_green("  all #{expected.size} connect-timeout substrate symbols present"))
    end
    puts(color_green("xbuild:tcp_timeout: green — cross-platform tcp_connect_timeout intact"))
  end

  task("xbuild:terminal", "TUI host on Windows — verifies terminal_smoke.exe imports the Win32 console surface (GetStdHandle, Get/SetConsoleMode, GetConsoleScreenBufferInfo, PeekConsoleInputW, ReadConsoleInputW, Sleep) from kernel32.dll. Proves std/terminal.qz's Win32-console backend compiles and links on Windows — the std/terminal module previously failed to link on Windows because of POSIX-only termios + ioctl + fcntl references. Unblocks TUI consumers (paperclips-tui, hyperdrive-tui, future) on Windows.") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required for cross-link")
    end
    if sh_maybe("command -v llvm-objdump > /dev/null 2>&1") != 0
      fail("llvm-objdump not on PATH — required for import inspection")
    end
    step("Cross-compile examples/windows/terminal_smoke.qz") do ->
      if sh_maybe("SRC=examples/windows/terminal_smoke.qz ./self-hosted/bin/quake xbuild:windows > /dev/null 2>&1") != 0
        fail("Inner xbuild:windows failed — re-run with SRC=examples/windows/terminal_smoke.qz ./self-hosted/bin/quake xbuild:windows for output")
      end
    end
    var exe = "tmp/xbuild-windows/terminal_smoke.exe"
    if exists(exe) == 0
      fail("xbuild:windows produced no #{exe}")
    end
    step("Verify Win32 console surface imports in #{exe}") do ->
      # The seven kernel32 console functions that the Win32 backend
      # leans on: handle resolution + raw-mode toggle + viewport size
      # + non-blocking peek + drain + millisecond sleep.
      var expected = vec_new<String>()
      expected.push("GetStdHandle")
      expected.push("GetConsoleMode")
      expected.push("SetConsoleMode")
      expected.push("GetConsoleScreenBufferInfo")
      expected.push("PeekConsoleInputW")
      expected.push("ReadConsoleInputW")
      expected.push("Sleep")
      var imports = sh_capture("llvm-objdump -p #{exe} 2>/dev/null")
      var missing = ""
      var i = 0
      while i < expected.size
        var sym = expected.get(i)
        if str_contains(imports, sym) == 0
          missing = missing + " " + sym
        end
        i = i + 1
      end
      if str_byte_len(missing) > 0
        eputs(color_red("xbuild:terminal: MISSING imports —#{missing}"))
        fail("Win32 console substrate regression — check std/ffi/termios.qz Windows section + std/terminal.qz @cfg(os: \"windows\") branches")
      end
      puts(color_green("  all #{expected.size} Win32 console substrate symbols present"))
    end
    puts(color_green("xbuild:terminal: green — std/terminal.qz Windows path intact"))
  end

  task("xbuild:hyperdrive", "Cross-compile examples/hyperbouba/hyperdrive.exe from Darwin (Phase 3 acceptance — the eli hand-off artifact)") do ->
    # Phase 3 hand-off one-liner. Drives examples/hyperbouba/Makefile's
    # `make windows` target, which invokes the quartz → llc → zig cc
    # pipeline three times (the windowed runtime IR + tigr.c +
    # device_tigr_shim.c + device_audio_shim.c) and links into a single
    # PE32+ console hyperdrive.exe. The Makefile owns the C-side cross-link
    # so this task's job is pre-flight + invoke + verify + summarize, not
    # re-pipeline.
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler} — run 'quake build' first")
    end
    if sh_maybe("command -v zig > /dev/null 2>&1") != 0
      fail("zig not on PATH — required by examples/hyperbouba/Makefile for the\n   Windows cross-link. Install via `brew install zig`, `apt install zig`,\n   or https://ziglang.org/download/")
    end
    var hb_dir = "examples/hyperbouba"
    if exists("#{hb_dir}/Makefile") == 0
      fail("Missing #{hb_dir}/Makefile")
    end

    step("make windows (in #{hb_dir})") do ->
      # The Makefile already echoes each subprocess; just delegate.
      if sh_maybe("make -C #{hb_dir} windows") != 0
        fail("make windows failed — see output above")
      end
    end

    var exe = "#{hb_dir}/build/hyperdrive.exe"
    step("Verify PE32+ artifact") do ->
      if exists(exe) == 0
        fail("No .exe produced at #{exe}")
      end
      var magic = sh_capture("file #{exe}")
      if str_contains(magic, "PE32+") == 0
        eputs(magic)
        fail("Artifact is not PE32+ — file(1) says: #{magic}")
      end
      if str_contains(magic, "x86-64") == 0
        eputs(magic)
        fail("Artifact is not x86-64 — file(1) says: #{magic}")
      end
      puts(color_green("  PE32+ x86-64 console executable verified"))
    end

    step("Inspect imports") do ->
      var objdump_bin = "llvm-objdump"
      if sh_maybe("#{objdump_bin} --version > /dev/null 2>&1") != 0
        objdump_bin = "objdump"
      end
      var imports = sh_capture("#{objdump_bin} -p #{exe} 2>/dev/null | grep 'DLL Name'")
      if str_byte_len(imports) > 0
        puts(imports)
      end
    end

    var sz_str = sh_capture("ls -l #{exe} | awk '{print $5}'")
    puts(color_green("xbuild:hyperdrive: green — #{exe} (#{sz_str} bytes)"))
    puts(color_dim("   Copy to Windows: scp #{exe} eli@windows-box:."))
    puts(color_dim("   Run:             .\\hyperdrive.exe examples\\hello.hb"))
  end

  return quake_main()
end

# =============================================================================
# Build Helper
# =============================================================================

## Track whether a Live UI is currently active. Nested Live regions
## would garble the cursor-up rewrites, so build_compiler skips its own
## sh_with_progress call and falls back to plain step() when this is set.
var _g_in_live_ui = 0

def build_compiler(release: Int): Void
  var compiler = compiler_path()
  if exists(compiler) == 0
    fail("Compiler not found at #{compiler}\n   Recover: git checkout HEAD~1 -- self-hosted/bin/quartz")
  end

  var source = "self-hosted/quartz.qz"
  var include_flags = qz_include_flags()
  var ir_path = "tmp/build.ll"
  mkdir_p("tmp")

  # Determine mode
  var debug_flag = ""
  var mode = "release"
  if release == 0
    debug_flag = " --debug"
    mode = "debug"
  end

  # Step 1: Compile to LLVM IR — uses --progress to drive a Live UI
  # showing per-phase advancement (init/lex/parse/resolve/typecheck/mir/codegen).
  # Falls back to a plain `sh` invocation if the Live UI is silenced
  # (non-TTY) or if we're already inside a parent Live region.
  if progress_auto_mode() == PROGRESS_MODE_TTY() and _g_in_live_ui == 0
    var cmd = "#{compiler} --progress --no-opt --no-cache#{debug_flag} #{include_flags} #{source}"
    var rc = sh_with_progress("Compiling (#{mode})", 8, cmd, ir_path)
    if rc != 0
      fail("Compile failed (exit #{rc})")
    end
  else
    # IMPORTANT: when nested inside a parent Live region, we MUST NOT call
    # step() — its eprint/eputs writes displace the parent's tracked cursor
    # position and cause the parent region to render duplicate frames as
    # the cursor-up rewrites land on the wrong lines.
    var cmd = "#{compiler} --no-opt --no-cache#{debug_flag} #{include_flags} #{source} > #{ir_path} 2>tmp/build.err"
    if _g_in_live_ui == 1
      sh(cmd)
    else
      step("Compiling (#{mode})") do ->
        sh(cmd)
      end
    end
  end

  # Validate function count
  var func_count_str = sh_capture("grep '^define' #{ir_path} | wc -l")
  var func_count = as_int(str_trim(func_count_str))
  if func_count < 1400
    fail("Too few functions (#{func_count}), expected 1400+")
  end

  # Step 2: Optimize (always — A.4 always-inline) + assemble → object file.
  # When nested in a Live UI, append llc/opt stderr (debug-info verifier
  # warnings) to tmp/build.err so they don't land on the terminal and
  # displace the parent Live's cursor tracking.
  #
  # A.4: every build mode now runs `opt --passes=always-inline` so the
  # `@__qz_alloc` / `@__qz_dealloc` linkonce_odr wrappers (and any other
  # `alwaysinline`-tagged helpers) fold into call sites. Without this,
  # the wrappers stay as out-of-line calls — costing ~5ns/alloc and
  # defeating the routing-off "zero overhead" claim. Release mode chains
  # `mergefunc` after for monomorph dedup.
  if _g_in_live_ui == 1
    if release == 1
      if sh_buffered("opt --passes=always-inline,mergefunc #{ir_path} -o tmp/build_opt.ll -S", "opt-build") != 0
        fail("opt-build failed")
      end
      if sh_buffered("llc -O2 -filetype=obj tmp/build_opt.ll -o tmp/build.o", "llc-build-opt") != 0
        fail("llc-build-opt failed")
      end
      rm("tmp/build_opt.ll")
    else
      if sh_buffered("opt --passes=always-inline #{ir_path} -o tmp/build_opt.ll -S", "opt-build-debug") != 0
        fail("opt-build-debug failed")
      end
      if sh_buffered("llc -filetype=obj tmp/build_opt.ll -o tmp/build.o", "llc-build") != 0
        fail("llc-build failed")
      end
      rm("tmp/build_opt.ll")
    end
  else
    step("Assembling (#{func_count} functions)") do ->
      if release == 1
        # A.4: always-inline first, then mergefunc for monomorph dedup
        sh("opt --passes=always-inline,mergefunc #{ir_path} -o tmp/build_opt.ll -S")
        sh("llc -O2 -filetype=obj tmp/build_opt.ll -o tmp/build.o")
        rm("tmp/build_opt.ll")
      else
        # A.4: always-inline so `@__qz_alloc` / `@__qz_dealloc` wrappers fold
        sh("opt --passes=always-inline #{ir_path} -o tmp/build_opt.ll -S")
        sh("llc -filetype=obj tmp/build_opt.ll -o tmp/build.o")
        rm("tmp/build_opt.ll")
      end
    end
  end

  # Step 3: Link — same stderr-redirect treatment when nested
  if _g_in_live_ui == 1
    if release == 1
      if sh_buffered("#{_linker()} #{_stack_flag()} tmp/build.o -o self-hosted/bin/quartz-new#{_mimalloc_flags()}", "link-build-release") != 0
        fail("link-build-release failed")
      end
    else
      if sh_buffered("#{_linker()} -g #{_stack_flag()} tmp/build.o -o self-hosted/bin/quartz-new#{_mimalloc_flags()}", "link-build-debug") != 0
        fail("link-build-debug failed")
      end
    end
  else
    step("Linking") do ->
      if release == 1
        sh("#{_linker()} #{_stack_flag()} tmp/build.o -o self-hosted/bin/quartz-new#{_mimalloc_flags()}")
      else
        sh("#{_linker()} -g #{_stack_flag()} tmp/build.o -o self-hosted/bin/quartz-new#{_mimalloc_flags()}")
      end
    end
  end

  # Replace binary
  mv("self-hosted/bin/quartz-new", "self-hosted/bin/quartz")
  _maybe_codesign("self-hosted/bin/quartz")

  # Cleanup
  rm(ir_path)
  rm("tmp/build.o")
  rm("tmp/build.err")

  # Clear module cache (silent when nested inside a Live region — the puts()
  # would land in the middle of the parent's render frame).
  if exists(".quartz-cache/manifest") == 1
    rm_rf(".quartz-cache")
    if _g_in_live_ui == 0
      puts("Cleared .quartz-cache (compiler binary changed)")
    end
  end

  if _g_in_live_ui == 0
    puts(color_green("Built: self-hosted/bin/quartz (#{mode} mode, #{func_count} functions)"))
  end
end

def build_compiler_separate(): Void
  var compiler = compiler_path()
  if exists(compiler) == 0
    fail("Compiler not found at #{compiler}\n   Recover: git checkout HEAD~1 -- self-hosted/bin/quartz")
  end

  var source = "self-hosted/quartz.qz"
  var include_flags = qz_include_flags()
  var sep_dir = "tmp/sep"
  mkdir_p(sep_dir)

  # Step 1: Compile with --separate → per-module .ll files
  step("Compiling (separate)") do ->
    var cmd = "#{compiler} --separate --no-opt --no-cache --debug #{include_flags} #{source} 2>#{sep_dir}/manifest.txt"
    sh(cmd)
  end

  # Read manifest (list of .ll paths, one per line)
  var manifest = read_file("#{sep_dir}/manifest.txt")
  var lines = str_split(manifest, "\n")

  # Build list of .ll files (skip warning lines)
  var ll_files = vec_new<String>()
  var li = 0
  while li < lines.size
    var ll = lines[li]
    if str_byte_len(ll) > 0 and str_byte_find(ll, ".ll") >= 0
      ll_files.push(ll)
    end
    li = li + 1
  end

  # Step 2: llc each .ll → .o (with caching: skip if .ll unchanged)
  # Build assemble script, checking hashes to skip unchanged modules
  var cmds = ""
  var cached = 0
  var recompiled = 0
  var ai = 0
  while ai < ll_files.size
    var ll = ll_files[ai]
    var obj = str_replace(ll, ".ll", ".o")
    var hash_file = "#{ll}.hash"
    var new_hash = _file_hash(ll)
    var old_hash = ""
    if exists(hash_file) == 1
      old_hash = str_trim(read_file(hash_file))
    end
    if new_hash.eq(old_hash) and exists(obj) == 1
      cached = cached + 1
    else
      cmds = "#{cmds}llc -filetype=obj #{ll} -o #{obj} && echo '#{new_hash}' > #{hash_file} &\n"
      recompiled = recompiled + 1
    end
    ai = ai + 1
  end

  if recompiled > 0
    step("Assembling (#{recompiled}/#{ll_files.size} modules, #{cached} cached)") do ->
      cmds = "#{cmds}wait\n"
      write_file("#{sep_dir}/assemble.sh", cmds)
      sh("sh #{sep_dir}/assemble.sh")
    end
  else
    puts(color_green("  All #{cached} modules cached, skipping llc"))
  end

  # Step 3: Link all .o files
  step("Linking") do ->
    var obj_files = ""
    var oi = 0
    while oi < ll_files.size
      var obj = str_replace(ll_files[oi], ".ll", ".o")
      obj_files = "#{obj_files} #{obj}"
      oi = oi + 1
    end
    sh("#{_linker()} -g #{_stack_flag()}#{obj_files} -o self-hosted/bin/quartz-new#{_mimalloc_flags()}")
  end

  # Replace binary
  mv("self-hosted/bin/quartz-new", "self-hosted/bin/quartz")
  _maybe_codesign("self-hosted/bin/quartz")

  # Clear incremental cache (but preserve sep/ for .o caching)
  if exists(".quartz-cache/manifest") == 1
    sh_maybe("rm -f .quartz-cache/manifest .quartz-cache/string_pool.dat 2>/dev/null")
    sh_maybe("rm -rf .quartz-cache/fragments 2>/dev/null")
    puts("Cleared incremental cache (compiler binary changed)")
  end

  puts(color_green("Built: self-hosted/bin/quartz (separate, #{ll_files.size} modules)"))
end

def qz_include_flags(): String
  return "-I self-hosted/frontend -I self-hosted/middle -I self-hosted/backend -I self-hosted/error -I self-hosted/shared -I tools -I std"
end

## Include flags for compiling a qspec file (broader than the compiler's own
## flags — specs pull in `std/*`, the repo root, and qspec fixtures).
def qz_spec_include_flags(): String
  return "-I std -I . -I self-hosted -I self-hosted/shared -I self-hosted/frontend -I self-hosted/middle -I self-hosted/backend -I spec/qspec/fixtures"
end

## CACHE-RO QZMOD SMOKE (2026-06-02) — guard/fixpoint blind-spot closer.
##
## `quake fixpoint`/`guard` verify only the `--no-cache --no-opt` IR
## (gen1 == gen2). That path NEVER exercises the qzmod per-module MIR/type
## cache the resolver+codegen consume under `--cache-dir`/`--cache-ro` — the
## exact path that produced the float-Phase-2 blocker (qzmod cache ignored
## `--cache-dir`, dropping wildcard/alias modules → `llc: use of undefined
## value '@terminal$KEY_DELETE'` / `@time$time_epoch_ms`).
##
## This step prewarms a SMALL targeted cache (just the qspec framework's
## transitive module set — terminal/socket/tls/tcp/time/style/colors) and
## `--cache-ro`-compiles a couple of representative specs that exercise the
## wildcard-import + same-source-alias surface, then `llc -filetype=obj`'s
## each. `llc` is the only trustworthy dangling-symbol oracle: any call to a
## never-emitted module function fails here. A non-zero llc → guard rejects.
##
## Returns 0 on success, 1 on the first
## contamination (a dropped wildcard/alias module symbol). NEVER aborts and
## NEVER restores a binary — the caller owns that. The failing tool's stderr
## (QZ04xx / `llc: use of undefined value …`) is streamed inline as the
## load-bearing diagnostic.
##
## NOTE: callers must abort via `fail_typed(BuildError::CommandFailed(...))`
## (the path `sh` uses), NOT `fail(...)`/`AssertionFailed` — that variant
## currently crashes the throw machinery when run from the compiled Quakefile
## (filed: AssertionFailed-throw segfault).
def cache_ro_smoke_run(): Int can Exec
  var compiler = compiler_path()
  if exists(compiler) == 0
    return 1
  end
  var inc = qz_spec_include_flags()
  var cache = "tmp/cache_smoke"
  mkdir_p("tmp")
  sh_maybe("rm -rf #{cache}")
  var pathpfx = _llvm_path_prefix()

  # Prewarm: one writable compile fully warms each transitively-imported
  # module's .qzmod (the encoder ships ALL of a module's decls, not a subset).
  if sh_maybe("#{compiler} --cache-dir #{cache} #{inc} spec/qspec/_qspec_prewarm.qz > /dev/null") != 0
    puts(color_red("cache-ro smoke: prewarm compile failed:"))
    sh_maybe("#{compiler} --cache-dir #{cache} #{inc} spec/qspec/_qspec_prewarm.qz > /dev/null 2>&1 | head -8 1>&2")
    sh_maybe("rm -rf #{cache}")
    return 1
  end

  # Representative specs: network_timeout_spec exercises the `std/time`
  # same-source-alias path (direct `import std/time` + transitive via
  # `progress`) plus tcp/tls/socket wildcard modules; https_spec is the
  # twin TLS surface. Both were the live failures the float fix surfaced.
  var specs = vec_new<String>()
  specs.push("spec/qspec/network_timeout_spec.qz")
  specs.push("spec/qspec/https_spec.qz")

  var rc = 0
  for si in 0..specs.size
    var spec = specs[si]
    if rc == 0 and exists(spec) == 1
      var ll = "tmp/cache_smoke.ll"
      var obj = "tmp/cache_smoke.o"
      if sh_maybe("#{compiler} --cache-dir #{cache} --cache-ro #{inc} #{spec} > #{ll}") != 0
        puts(color_red("cache-ro smoke: --cache-ro compile of #{spec} failed:"))
        sh_maybe("#{compiler} --cache-dir #{cache} --cache-ro #{inc} #{spec} > /dev/null 2>&1 | head -8 1>&2")
        rc = 1
      else
        # llc is the dangling-symbol oracle — a call to a dropped module
        # function (e.g. @time$time_epoch_ms) fails ONLY here.
        if sh_maybe("PATH=#{pathpfx}$PATH llc -filetype=obj #{ll} -o #{obj}") != 0
          puts(color_red("cache-ro smoke: llc rejected IR from #{spec} — qzmod cache contamination (dropped module symbol). llc says:"))
          sh_maybe("PATH=#{pathpfx}$PATH llc -filetype=obj #{ll} -o /dev/null 2>&1 | head -5 1>&2")
          rc = 1
        end
      end
      rm(ll)
      sh_maybe("rm -f #{obj}")
    end
  end

  sh_maybe("rm -rf #{cache}")
  return rc
end

## Standalone / fixpoint entry: run the smoke, abort cleanly on contamination
## via the stable CommandFailed throw path.
def cache_ro_smoke(): Int can Exec
  puts("  cache-ro qzmod smoke (prewarm + --cache-ro + llc)...")
  if cache_ro_smoke_run() != 0
    fail_typed(BuildError::CommandFailed("cache-ro qzmod smoke FAILED — qzmod cache contamination (see diagnostic above)", 1))
  end
  puts(color_green("  cache-ro qzmod smoke PASSED (no dropped module symbols)"))
  return 0
end

## Warm-cache dependency-invalidation smoke (vec-of-struct field fidelity).
## Guards the resolver dep-edge-hoist fix (`4c0ed164`): the SECOND wildcard-
## importer of a struct-bearing module must re-compile when that dependency's
## struct layout changes (cold-build -> edit-dep-layout -> warm-rebuild -> run).
## Fixpoint is structurally blind to this — it compares only `--no-cache` IR —
## and it can NOT live in qspec (qspec/subprocess always compiles `--no-cache`,
## so it never exercises warm-cache invalidation). Shells out to the canonical
## bash smoke driving the freshly-built compiler. Returns 0 = pass, 1 = fail.
def vecstruct_cache_smoke_run(): Int can Exec
  var compiler = compiler_path()
  if exists(compiler) == 0
    return 1
  end
  var script = "tools/cache_invalidation_vecstruct_smoke.sh"
  if exists(script) == 0
    puts(color_red("vecstruct cache smoke: script missing at #{script}"))
    return 1
  end
  var pathpfx = _llvm_path_prefix()
  # llc resolves through the LLVM path prefix; CC = the system linker (homebrew
  # clang can hang on LLVM 21+ per `_linker()`); QUARTZ = the binary under test.
  return sh_maybe("PATH=#{pathpfx}$PATH LLC=llc CC=#{_linker()} QUARTZ=#{compiler} #{script}")
end

# Compile a Quartz tool source file to a native binary
def _compile_qz_tool(source: String, output: String): Void
  var compiler = compiler_path()
  var ll_path = output + ".ll"
  var obj_path = output + ".o"
  step("Compile #{source}") do ->
    if sh_buffered("#{compiler} --no-cache -I std -I . #{source} > #{ll_path}", "compile-tool") != 0
      fail("Failed to compile #{source}")
    end
  end
  step("Assemble #{source}") do ->
    var current_path = env_get("PATH")
    env("PATH", "#{_llvm_path_prefix()}#{current_path}")
    if sh_buffered("llc -filetype=obj #{ll_path} -o #{obj_path}", "llc-tool") != 0
      fail("llc failed on #{source}")
    end
  end
  step("Link #{source}") do ->
    if sh_buffered(_linker() + " " + _stack_flag() + " " + obj_path + " -o " + output + _mimalloc_flags(), "link-tool") != 0
      fail("linker failed on #{source}")
    end
  end
end

# Cross-platform linker stack size flag
# macOS ld64 supports -stack_size; Linux ld uses -z stacksize (optional, default usually sufficient)
@cfg(os: "macos")
def _stack_flag(): String = "-Wl,-stack_size,0x2000000"

# TODO: Verify on Linux — may need -Wl,-z,stacksize=33554432 for large programs
@cfg(os: "linux")
def _stack_flag(): String = ""

# Windows uses lld-link's /STACK reservation; for v1 leave empty (default is
# usually sufficient). See QUARTZ_WINDOWS_TARGET.md §Path A Phase 1.
@cfg(os: "windows")
def _stack_flag(): String = ""

# Cross-platform OpenSSL library search path
@cfg(os: "macos")
def _openssl_flags(): String = " -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto"

# TODO: Verify on Linux — system OpenSSL is usually on the default search path
@cfg(os: "linux")
def _openssl_flags(): String = " -lssl -lcrypto"

# Windows v1: empty — OpenSSL isn't on the Phase 1 path (crypto Windows port
# is filed forward; see QUARTZ_WINDOWS_TARGET.md §Filed-forward).
@cfg(os: "windows")
def _openssl_flags(): String = ""

# Cross-platform mimalloc allocator — reduces RSS 30-50% for allocation-heavy workloads.
# macOS: NOT linked. mimalloc on Apple Silicon hits a dyld TLS-slot bootstrap race
# (mimalloc#343) where ImageLoader calls malloc before tpidr_el0 points at a valid TCB,
# causing SIGSEGV at process init. This cost a week of debugging in April 2026. The
# performance loss on macOS self-compile is acceptable; catastrophic bootstrap failure
# is not. See docs/BOOTSTRAP_RECOVERY.md §"The macOS mimalloc/IOAccelerator collision".
@cfg(os: "macos")
def _mimalloc_flags(): String = ""

@cfg(os: "linux")
def _mimalloc_flags(): String = " -lmimalloc"

# Windows v1: no mimalloc (Phase 4 work — Windows malloc behaviour is
# different enough that the perf calibration would need redoing).
@cfg(os: "windows")
def _mimalloc_flags(): String = ""

# Cross-platform LLVM PATH prefix
# macOS: Homebrew installs LLVM outside default PATH
@cfg(os: "macos")
def _llvm_path_prefix(): String = "/opt/homebrew/opt/llvm/bin:"

@cfg(os: "linux")
def _llvm_path_prefix(): String = ""

# Windows v1: assume llc/clang on PATH (or shipped via zig cc).
@cfg(os: "windows")
def _llvm_path_prefix(): String = ""

# Cross-platform linker command
# macOS: use system clang for linking (Homebrew LLVM clang can hang on LLVM 21+)
# Linux: use clang from PATH (versioned symlinks set up in CI)
# Windows: zig cc drives lld-link with mingw-w64 import libs bundled
#   (matches QUARTZ_WINDOWS_TARGET.md §Decision-points recommendation).
@cfg(os: "macos")
def _linker(): String = "/usr/bin/clang"

@cfg(os: "linux")
def _linker(): String = "clang"

@cfg(os: "windows")
def _linker(): String = "zig cc"

# Cross-platform codesign — macOS requires ad-hoc signing, Linux does not,
# Windows .exe doesn't need signing for local execution (Authenticode is
# a separate signed-by-MS distribution concern, not a build-time gate).
@cfg(os: "macos")
def _maybe_codesign(path: String): Void
  var _r = sh_maybe("codesign -s - #{path} 2>/dev/null")
end

@cfg(os: "linux")
def _maybe_codesign(path: String): Void
  return
end

@cfg(os: "windows")
def _maybe_codesign(path: String): Void
  return
end

# Cross-platform file hashing — macOS uses md5, Linux uses md5sum.
# Windows: certutil ships in every Windows install; the awk trims to a
# bare 32-hex hash (certutil's output is "Filename" on its own line, then
# the hex on its own line, then "CertUtil: -hashfile command completed").
@cfg(os: "macos")
def _file_hash(path: String): String = str_trim(sh_capture("md5 -q #{path}"))

@cfg(os: "linux")
def _file_hash(path: String): String = str_trim(sh_capture("md5sum #{path} | cut -d' ' -f1"))

@cfg(os: "windows")
def _file_hash(path: String): String = str_trim(sh_capture("certutil -hashfile #{path} MD5 | findstr /v \":\""))

# Cross-platform linker dead-strip flag for the crypto:smoke task. macOS
# ld64 uses -dead_strip; Linux ld/lld use --gc-sections (paired with
# -ffunction-sections at compile time); Windows lld-link accepts the GNU
# flag through zig cc.
@cfg(os: "macos")
def _crypto_dead_strip_flag(): String = "-Wl,-dead_strip"

@cfg(os: "linux")
def _crypto_dead_strip_flag(): String = "-Wl,--gc-sections"

@cfg(os: "windows")
def _crypto_dead_strip_flag(): String = "-Wl,--gc-sections"

# =============================================================================
# QSpec Runner
# =============================================================================

# Outcome codes for SpecResult. Stable across the runner so the worker
# pool and the (legacy) serial path produce identical aggregation.
def OUTCOME_PASSED(): Int    = 0
def OUTCOME_SKIPPED(): Int   = 1
def OUTCOME_FAILED(): Int    = 2
def OUTCOME_CANCELLED(): Int = 3

## SpecCtx — read-only per-suite state shared by every spec run.
## Built once in run_qspec from env vars + compiler discovery, then
## passed by value into _qspec_run_one. Safe to share across worker
## goroutines: no field is mutated after construction.
struct SpecCtx
  compiler: String
  session_id: String
  lli: String
  timeout_str: String
  compile_timeout_str: String
  tool_timeout_str: String
  fast_mode: Bool
  # INC.2 — cache flags for the per-spec compile. Either "--no-cache"
  # or run-owned --cache-dir flags once the suite has pre-warmed its
  # single-writer, read-only-for-workers `.qzmod` cache.
  cache_flags: String
  result_dir: String
  run_dir: String
  cancel_path: String
  selected_paths: Vec<String>
  selected_hashes: Vec<String>
end

struct QSpecSupervisorStatus
  valid: Bool
  stage: String
  deadline_ms: Int
  spawn_error: String
  exit_code: Int
  signal: Int
  timed_out: Bool
  term_sent: Bool
  kill_sent: Bool
  elapsed_ms: Int
  orphan: Bool
  cancelled: Bool
end

## SpecResult — what _qspec_run_one returns. Both the serial path and
## (Phase 1+) the worker pool consume these via a uniform aggregation
## loop on the main thread. `reason` and `captured` are only meaningful
## when outcome == OUTCOME_FAILED.
@repr(C)
struct SpecResult
  name: String
  outcome: Int
  reason: String
  captured: String
  file_time_ms: Int
  execution_mode: String
  exit_code: Int
  signal: Int
  timed_out: Bool
  orphan: Bool
  metrics_valid: Bool
  cases: Int
  passed: Int
  case_failures: Int
  framework_failures: Int
  pending: Int
  skipped: Int
  assertions: Int
  case_duration_us: Int
  selected_source_hash: String
end

struct QSpecMetrics
  present: Bool
  valid: Bool
  error: String
  cases: Int
  passed: Int
  case_failures: Int
  framework_failures: Int
  pending: Int
  skipped: Int
  assertions: Int
  duration_us: Int
end

struct QSpecFeatureRequest
  present: Bool
  valid: Bool
  feature: String
  error: String
end

def _qspec_empty_metrics(): QSpecMetrics
  return QSpecMetrics { present: false, valid: false, error: "missing qspec result record", cases: -1, passed: -1, case_failures: -1, framework_failures: -1, pending: -1, skipped: -1, assertions: -1, duration_us: -1 }
end

def _qspec_result(name: String, outcome: Int, reason: String, captured: String, started_ms: Int, mode: String, exit_code: Int, signal: Int, timed_out: Bool, orphan: Bool, metrics: QSpecMetrics): SpecResult
  return SpecResult {
    name: name, outcome: outcome, reason: reason, captured: captured,
    file_time_ms: time.time_epoch_ms() - started_ms, execution_mode: mode,
    exit_code: exit_code, signal: signal, timed_out: timed_out, orphan: orphan, metrics_valid: metrics.valid,
    cases: metrics.cases, passed: metrics.passed,
    case_failures: metrics.case_failures, framework_failures: metrics.framework_failures,
    pending: metrics.pending, skipped: metrics.skipped,
    assertions: metrics.assertions, case_duration_us: metrics.duration_us,
    selected_source_hash: "",
  }
end

def _qspec_json_int(line: String, key: String): Int
  var needle = "\"" + key + "\":"
  var pos = str_find(line, needle).unwrap_or(-1)
  if pos < 0
    return -1
  end
  var start = pos + str_byte_len(needle)
  var finish = start
  while finish < str_byte_len(line)
    var ch = str_byte_at(line, finish)
    if ch < '0' or ch > '9'
      break
    end
    finish += 1
  end
  if finish == start
    return -1
  end
  if finish - start > 12
    return -1
  end
  return str_to_int(str_byte_slice(line, start, finish))
end

def _qspec_json_string_value(line: String, key: String): String
  var needle = "\"" + key + "\":\""
  var pos = str_find(line, needle).unwrap_or(-1)
  if pos < 0
    return ""
  end
  var start = pos + str_byte_len(needle)
  var finish = start
  while finish < str_byte_len(line) and str_byte_at(line, finish) != '"'
    finish += 1
  end
  if finish == start or finish >= str_byte_len(line)
    return ""
  end
  return str_byte_slice(line, start, finish)
end

struct QSpecBoundedResult
  valid: Bool
  content: String
end

def _qspec_read_result_bounded(path: String): QSpecBoundedResult
  if file_exists(path) == 0 or not _qspec_shell_safe_path(path)
    return QSpecBoundedResult { valid: false, content: "" }
  end
  var snapshot = "#{path}.bounded"
  rm(snapshot)
  var root = path_dir(path_dir(path))
  var status = posix_spawn_wait("ruby tools/qspec_supervise.rb --bounded-snapshot #{path} #{snapshot} #{root} 4194304")
  if status != 0 or file_exists(snapshot) == 0
    rm(snapshot)
    return QSpecBoundedResult { valid: false, content: "" }
  end
  var content = read_file(snapshot)
  rm(snapshot)
  return QSpecBoundedResult { valid: true, content: content }
end

def _qspec_read_metrics(path: String, run_id: String, file_id: String, token: String): QSpecMetrics
  var empty = _qspec_empty_metrics()
  if file_exists(path) == 0
    return empty
  end
  var bounded_result = _qspec_read_result_bounded(path)
  if not bounded_result.valid
    empty.present = true
    empty.error = "qspec result file exceeds 4194304 byte limit"
    return empty
  end
  var lines = str_split(bounded_result.content, "\n")
  var found = ""
  var count = 0
  var legacy = 0
  var exclusions = 0
  var malformed_line = false
  for i in 0..lines.size
    var line = lines[i]
    if str_byte_len(line) == 0
      continue
    elsif str_trim(line) != line
      malformed_line = true
    elsif str_starts_with(line, "QSPEC_RESULT_V3 ")
      found = lines[i]
      count += 1
    elsif str_starts_with(line, "QSPEC_RESULT_V2 ")
      legacy += 1
    elsif str_starts_with(line, "QSPEC_EXCLUSION_V1 ")
      exclusions += 1
    elsif str_starts_with(line, "QSS2\t") or str_starts_with(line, "QSI1\t") or str_starts_with(line, "QSE1\t") or line == "QSO1\t4096"
      continue
    else
      malformed_line = true
    end
  end
  if legacy > 0
    empty.present = true
    if count > 0
      empty.error = "mixed qspec result schemas"
    else
      empty.error = "unsupported qspec result schema"
    end
    return empty
  end
  if malformed_line
    empty.present = true
    empty.error = "malformed qspec protocol line"
    return empty
  end
  if count > 1
    empty.present = true
    empty.error = "duplicate qspec metrics"
    return empty
  end
  if exclusions > 1 or (count > 0 and exclusions > 0)
    empty.present = true
    empty.error = "duplicate or mixed qspec result records"
    return empty
  end
  if count == 0
    return empty
  end
  var schema = _qspec_json_int(found, "schema")
  var authority = _qspec_json_string_value(found, "authority")
  var cases = _qspec_json_int(found, "cases")
  var passed = _qspec_json_int(found, "passed")
  var case_failures = _qspec_json_int(found, "case_failures")
  var framework_failures = _qspec_json_int(found, "framework_failures")
  var pending = _qspec_json_int(found, "pending")
  var skipped = _qspec_json_int(found, "skipped")
  var assertions = _qspec_json_int(found, "assertions")
  var duration_us = _qspec_json_int(found, "duration_us")
  var canonical = "QSPEC_RESULT_V3 {\"schema\":#{schema},\"authority\":\"#{authority}\",\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"#{token}\",\"cases\":#{cases},\"passed\":#{passed},\"case_failures\":#{case_failures},\"framework_failures\":#{framework_failures},\"pending\":#{pending},\"skipped\":#{skipped},\"assertions\":#{assertions},\"duration_us\":#{duration_us}}"
  var bounded = cases >= 0 and cases <= 1000000 and passed >= 0 and passed <= 1000000 and case_failures >= 0 and case_failures <= 1000000 and framework_failures >= 0 and framework_failures <= 1000000 and pending >= 0 and pending <= 1000000 and skipped >= 0 and skipped <= 1000000 and assertions >= 0 and assertions <= 1000000000 and duration_us >= 0 and duration_us <= 86400000000
  var arithmetic = cases == passed + case_failures + pending + skipped
  if schema != 3 or authority != "test_reported" or found != canonical or not bounded or not arithmetic
    empty.present = true
    empty.error = "malformed qspec metrics"
    return empty
  end
  return QSpecMetrics { present: true, valid: true, error: "", cases: cases, passed: passed, case_failures: case_failures, framework_failures: framework_failures, pending: pending, skipped: skipped, assertions: assertions, duration_us: duration_us }
end


def _qspec_read_feature_request(path: String, run_id: String, file_id: String, token: String): QSpecFeatureRequest
  var empty = QSpecFeatureRequest { present: false, valid: false, feature: "", error: "missing feature exclusion request" }
  if file_exists(path) == 0
    return empty
  end
  var bounded_result = _qspec_read_result_bounded(path)
  if not bounded_result.valid
    return QSpecFeatureRequest { present: true, valid: false, feature: "", error: "qspec result file exceeds 4194304 byte limit" }
  end
  var lines = str_split(bounded_result.content, "\n")
  var found = ""
  var count = 0
  var other_records = 0
  var malformed_line = false
  for i in 0..lines.size
    var line = lines[i]
    if str_byte_len(line) == 0
      continue
    elsif str_trim(line) != line
      malformed_line = true
    elsif str_starts_with(line, "QSPEC_EXCLUSION_V1 ")
      found = line
      count += 1
    elsif str_starts_with(line, "QSPEC_RESULT_")
      other_records += 1
    elsif str_starts_with(line, "QSS2\t") or str_starts_with(line, "QSI1\t") or str_starts_with(line, "QSE1\t") or line == "QSO1\t4096"
      continue
    else
      malformed_line = true
    end
  end
  if malformed_line
    return QSpecFeatureRequest { present: true, valid: false, feature: "", error: "malformed qspec protocol line" }
  end
  if count == 0
    return empty
  end
  if count != 1 or other_records > 0
    return QSpecFeatureRequest { present: true, valid: false, feature: "", error: "duplicate or mixed qspec result records" }
  end
  var schema = _qspec_json_int(found, "schema")
  var feature = _qspec_json_string_value(found, "feature")
  var canonical = "QSPEC_EXCLUSION_V1 {\"schema\":#{schema},\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"#{token}\",\"feature\":\"#{feature}\"}"
  if schema != 1 or str_byte_len(feature) == 0 or found != canonical or not _qspec_shell_safe_path(feature)
    return QSpecFeatureRequest { present: true, valid: false, feature: feature, error: "malformed feature exclusion request" }
  end
  return QSpecFeatureRequest { present: true, valid: true, feature: feature, error: "" }
end

def _qspec_shell_safe_path(path: String): Bool
  if str_byte_len(path) == 0
    return false
  end
  for i in 0..str_byte_len(path)
    var ch = str_byte_at(path, i)
    var safe = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-' or ch == '.' or ch == '/'
    if not safe
      return false
    end
  end
  return true
end

def _qspec_result_token(run_id: String, file_id: String): String
  return "#{run_id}_#{file_id}_qspec_v3"
end

def _qspec_prepare_result_file(path: String, run_dir: String): Void
  if posix_spawn_wait("ruby tools/qspec_supervise.rb --secure-file #{path} #{run_dir}") != 0
    fail("Could not securely create QSpec result file: #{path}")
  end
end

def _qspec_protocol_field(out: StringBuilder, value: String): Void
  out.append("#{str_byte_len(value)}\n")
  out.append(value)
  out.append("\n")
end

def _qspec_empty_supervisor(stage: String, error: String): QSpecSupervisorStatus
  return QSpecSupervisorStatus { valid: false, stage: stage, deadline_ms: 0, spawn_error: error, exit_code: -1, signal: 0, timed_out: false, term_sent: false, kill_sent: false, elapsed_ms: 0, orphan: true, cancelled: false }
end

def _qspec_canonical_unsigned(raw: String, max_value: Int): Bool
  if not _qspec_is_decimal(raw, 16) or (str_byte_len(raw) > 1 and str_byte_at(raw, 0) == '0')
    return false
  end
  var value = str_to_int(raw)
  return value >= 0 and value <= max_value
end

def _qspec_canonical_exit(raw: String): Bool
  if raw == "-1"
    return true
  end
  return _qspec_canonical_unsigned(raw, 255)
end

def _qspec_supervisor_parts_legal(parts: Vec<String>, expected_stage: String): Bool
  if parts.size != 13 or parts[0] != "QSS2" or parts[1] != expected_stage or parts[12] != "trusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown"
    return false
  end
  if not _qspec_canonical_unsigned(parts[2], 3600000) or str_to_int(parts[2]) < 1 or not _qspec_canonical_exit(parts[4]) or not _qspec_canonical_unsigned(parts[5], 64) or not _qspec_canonical_unsigned(parts[9], 3615000)
    return false
  end
  if (parts[6] != "0" and parts[6] != "1") or (parts[7] != "0" and parts[7] != "1") or (parts[8] != "0" and parts[8] != "1") or (parts[10] != "0" and parts[10] != "1") or (parts[11] != "0" and parts[11] != "1")
    return false
  end
  var exit_code = str_to_int(parts[4]); var sig = str_to_int(parts[5])
  var timed_out = parts[6] == "1"; var term_sent = parts[7] == "1"; var kill_sent = parts[8] == "1"; var orphan = parts[10] == "1"; var cancelled = parts[11] == "1"
  var refused_before_spawn = cancelled and exit_code == -1 and sig == 0 and str_byte_len(parts[3]) > 0 and not term_sent and not kill_sent and not orphan
  var indeterminate_unowned = cancelled and orphan and exit_code == -1 and sig == 0 and str_starts_with(parts[3], "indeterminate:") and not term_sent and not kill_sent
  var legal = not (exit_code >= 0 and sig > 0) and not (timed_out and cancelled) and not (timed_out and (exit_code >= 0 or sig > 0)) and not (cancelled and (exit_code >= 0 or sig > 0)) and (not timed_out or term_sent) and (not cancelled or term_sent or refused_before_spawn or indeterminate_unowned) and (not kill_sent or term_sent) and (not orphan or kill_sent or indeterminate_unowned)
  if str_byte_len(parts[3]) == 0 and exit_code == -1 and sig == 0 and not timed_out and not cancelled
    legal = false
  end
  return legal
end

def _qspec_read_supervisor(path: String, expected_stage: String): QSpecSupervisorStatus
  if file_exists(path) == 0
    return _qspec_empty_supervisor(expected_stage, "missing supervisor status")
  end
  var parts = str_split(str_trim(read_file(path)), "\t")
  if not _qspec_supervisor_parts_legal(parts, expected_stage)
    return _qspec_empty_supervisor(expected_stage, "malformed supervisor status")
  end
  var exit_code = str_to_int(parts[4]); var sig = str_to_int(parts[5])
  var timed_out = parts[6] == "1"; var term_sent = parts[7] == "1"; var kill_sent = parts[8] == "1"; var orphan = parts[10] == "1"; var cancelled = parts[11] == "1"
  return QSpecSupervisorStatus {
    valid: true, stage: parts[1], deadline_ms: str_to_int(parts[2]), spawn_error: parts[3],
    exit_code: exit_code, signal: sig, timed_out: timed_out,
    term_sent: term_sent, kill_sent: kill_sent, elapsed_ms: str_to_int(parts[9]),
    orphan: orphan, cancelled: cancelled,
  }
end

def _qspec_malformed_status(stage: String, mode: String): String
  if mode == "numeric"
    return "QSS2\t#{stage}\t01\t\t0\t0\t0\t0\t0\t1\t0\t0\ttrusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown\n"
  elsif mode == "boolean"
    return "QSS2\t#{stage}\t1000\t\t0\t0\t2\t0\t0\t1\t0\t0\ttrusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown\n"
  elsif mode == "bounds"
    return "QSS2\t#{stage}\t1000\t\t999\t0\t0\t0\t0\t1\t0\t0\ttrusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown\n"
  elsif mode == "combination"
    return "QSS2\t#{stage}\t1000\t\t0\t9\t0\t0\t0\t1\t0\t0\ttrusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown\n"
  elsif mode == "sentinel"
    return "QSS2\t#{stage}\t1000\t\t0\t0\t0\t0\t0\t1\t0\t0\twrong-owner\n"
  end
  return "QSS2\t#{stage}\t1000\n"
end

def _qspec_supervised(stage: String, timeout: String, argv: Vec<String>, env_keys: Vec<String>, env_values: Vec<String>, stdout_path: String, stderr_path: String, merge_stderr: Bool, work_dir: String, cancel_path: String, record_path: String): QSpecSupervisorStatus
  var command_path = "#{work_dir}/#{stage}.request"
  var status_path = "#{work_dir}/#{stage}.status"
  var out = sb_new()
  out.append("QSP2\n")
  _qspec_protocol_field(out, stage)
  _qspec_protocol_field(out, "#{str_to_int(timeout) * 1000}")
  # A running spec may itself own a nested supervisor whose child is in a
  # separate process group. Give that supervisor enough time to TERM/KILL/reap
  # its group before the outer supervisor escalates.
  _qspec_protocol_field(out, "3000")
  _qspec_protocol_field(out, "")
  _qspec_protocol_field(out, stdout_path)
  _qspec_protocol_field(out, stderr_path)
  if merge_stderr
    _qspec_protocol_field(out, "1")
  else
    _qspec_protocol_field(out, "0")
  end
  _qspec_protocol_field(out, cancel_path)
  _qspec_protocol_field(out, path_dir(cancel_path))
  out.append("#{argv.size}\n")
  for i in 0..argv.size
    _qspec_protocol_field(out, argv[i])
  end
  out.append("#{env_keys.size}\n")
  for i in 0..env_keys.size
    _qspec_protocol_field(out, env_keys[i])
    _qspec_protocol_field(out, env_values[i])
  end
  if posix_spawn_wait("ruby tools/qspec_supervise.rb --secure-file #{command_path} #{path_dir(cancel_path)}") != 0
    return _qspec_empty_supervisor(stage, "could not securely create supervisor request")
  end
  write_file(command_path, out.to_string())
  var raw = posix_spawn_wait("ruby tools/qspec_supervise.rb #{command_path} #{status_path}")
  var malformed = env_get("QSPEC_RUNNER_TEST_STATUS")
  if env_get("QSPEC_RUNNER_TEST") == "1" and str_byte_len(malformed) > 0 and env_get("QSPEC_RUNNER_TEST_STAGE") == stage
    write_file(status_path, _qspec_malformed_status(stage, malformed))
  end
  var status = _qspec_read_supervisor(status_path, stage)
  if raw != 0 and not status.valid
    status.spawn_error = "supervisor status publication failed"
  end
  if str_byte_len(record_path) > 0 and status.valid
    file.file_append(record_path, str_trim(read_file(status_path)) + "\n")
  end
  rm(command_path)
  rm(status_path)
  return status
end

def _qspec_stage_argv(stage: String, argv: Vec<String>): Vec<String>
  if env_get("QSPEC_RUNNER_TEST") != "1" or env_get("QSPEC_RUNNER_TEST_STAGE") != stage
    return argv
  end
  var mode = env_get("QSPEC_RUNNER_TEST_MODE")
  var replacement = vec_new<String>()
  replacement.push("ruby")
  replacement.push("-e")
  if mode == "hang"
    replacement.push("Signal.trap('TERM', 'IGNORE'); spawn('ruby', '-e', \"Signal.trap('TERM', 'IGNORE'); sleep 30\"); sleep 30")
  elsif mode == "crash"
    replacement.push("Process.kill('SEGV', Process.pid)")
  elsif mode == "fail"
    replacement.push("exit 23")
  elsif mode == "exit124"
    replacement.push("exit 124")
  elsif mode == "exit130"
    replacement.push("exit 130")
  elsif mode == "exit137"
    replacement.push("exit 137")
  elsif mode == "signal2"
    replacement.push("Process.kill('INT', Process.pid)")
  elsif mode == "signal9"
    replacement.push("Process.kill('KILL', Process.pid)")
  elsif mode == "spawn-failure"
    replacement = vec_new<String>()
    replacement.push("#{env_get("QSPEC_RUNNER_TEST_MISSING")}/missing")
  else
    return argv
  end
  return replacement
end

@cfg(os: "macos")
def _qspec_link_argv(obj_path: String, bin_path: String, needs_regex: Int, needs_tls: Int): Vec<String>
  var argv = vec_new<String>(); argv.push("/usr/bin/clang"); argv.push(obj_path)
  if needs_regex == 1 and file_exists("lib/libquartz_regex.a") == 1
    argv.push("lib/libquartz_regex.a"); argv.push("-lpcre2-8"); argv.push("-L/opt/homebrew/opt/pcre2/lib")
  end
  if needs_tls == 1
    argv.push("-L/opt/homebrew/opt/openssl@3/lib"); argv.push("-lssl"); argv.push("-lcrypto")
  end
  argv.push("-o"); argv.push(bin_path)
  return argv
end

@cfg(os: "linux")
def _qspec_link_argv(obj_path: String, bin_path: String, needs_regex: Int, needs_tls: Int): Vec<String>
  var argv = vec_new<String>(); argv.push("clang"); argv.push(obj_path)
  if needs_regex == 1 and file_exists("lib/libquartz_regex.a") == 1
    argv.push("lib/libquartz_regex.a"); argv.push("-lpcre2-8")
  end
  if needs_tls == 1
    argv.push("-lssl"); argv.push("-lcrypto")
  end
  argv.push("-o"); argv.push(bin_path)
  return argv
end

@cfg(os: "windows")
def _qspec_link_argv(obj_path: String, bin_path: String, needs_regex: Int, needs_tls: Int): Vec<String>
  var argv = vec_new<String>(); argv.push("zig"); argv.push("cc"); argv.push(obj_path); argv.push("-o"); argv.push(bin_path)
  return argv
end

@cfg(os: "macos")
def _qspec_codesign_argv(bin_path: String): Vec<String>
  var argv = vec_new<String>(); argv.push("codesign"); argv.push("-s"); argv.push("-"); argv.push(bin_path); return argv
end

@cfg(os: "linux")
def _qspec_codesign_argv(bin_path: String): Vec<String> = vec_new<String>()

@cfg(os: "windows")
def _qspec_codesign_argv(bin_path: String): Vec<String> = vec_new<String>()

def _qspec_feature_exclusion_reason(name: String, feature: String): String
  if feature == "wasm" and (name == "wasm_core_spec" or name == "wasm_data_spec" or name == "wasm_extended_spec" or name == "wasm_hof_spec")
    return "wasm backend feature is not enabled in the default compiler"
  end
  if env_get("QSPEC_RUNNER_TEST") == "1" and feature == "wasm" and name == "feature_exclusion"
    return "runner fixture requested its registered wasm exclusion"
  end
  return ""
end

## Run one QSpec file end-to-end (compile → run → decode → cleanup).
## Returns a SpecResult; never mutates external state. Side effects are
## confined to the run-owned work/<name> directory, which is unique per
## (session, name) tuple and removed by defer on every return path.
##
## All subprocess invocations go through `posix_spawn_wait` (mutex-free
## relative to libc system(3)), which is what makes parallel execution
## actually parallel — see fec636a9.
##
## `worker_handle` (Phase 5.0c) is `as_int(PersistentWorker)` when
## QSPEC_DAEMON=1 mode is active, 0 otherwise. Non-zero swaps the
## compile step from a fresh `posix_spawn_wait("quartz ...")` to a TCP
## round-trip against the worker's pre-warmed process.
def _qspec_selected_hash(ctx: SpecCtx, spec_file: String): String
  for i in 0..ctx.selected_paths.size
    if ctx.selected_paths[i] == spec_file
      return ctx.selected_hashes[i]
    end
  end
  return ""
end

def _qspec_run_one(spec_file: String, ctx: SpecCtx, worker_handle: Int): SpecResult
  var result = _qspec_run_one_inner(spec_file, ctx, worker_handle)
  result.selected_source_hash = _qspec_selected_hash(ctx, spec_file)
  return result
end

def _qspec_run_one_inner(spec_file: String, ctx: SpecCtx, worker_handle: Int): SpecResult
  var name = basename_no_ext(spec_file, ".qz")
  if not _qspec_shell_safe_path(spec_file) or not _qspec_shell_safe_path(name)
    return _qspec_result(name, OUTCOME_FAILED(), "unsafe spec path", "", time.time_epoch_ms(), "selection", -1, 0, false, false, _qspec_empty_metrics())
  end
  var work_dir = "#{ctx.run_dir}/work/#{name}"
  mkdir_p(work_dir)
  defer rm_rf(work_dir)
  var ir_path = "#{work_dir}/spec.ll"
  var err_path = "#{work_dir}/spec.err"
  var out_path = "#{work_dir}/spec.out"
  var obj_path = "#{work_dir}/spec.o"
  var bin_path = "#{work_dir}/spec.bin"
  var result_path = "#{ctx.result_dir}/#{name}.result"
  var result_token = _qspec_result_token(ctx.session_id, name)
  _qspec_prepare_result_file(result_path, ctx.run_dir)

  var file_start = time.time_epoch_ms()

  # Step 1: Compile. Daemon-mode (worker_handle != 0) routes through a
  # pre-warmed `quartz --persistent-worker` subprocess via TCP; serial
  # mode spawns a fresh compiler per spec.
  var compile_status = _qspec_empty_supervisor("compile", "daemon compile has no supervisor record")
  if worker_handle != 0
    var worker: PersistentWorker = as_type<PersistentWorker>(worker_handle)
    var resp = _pw_compile(worker, spec_file, ir_path, err_path)
    if resp.exit_code < 0
      var dead_cap = _qspec_capture_show(err_path, name)
      rm(ir_path)
      rm(err_path)
      return _qspec_result(name, OUTCOME_FAILED(), "worker died (mid-compile)", dead_cap, file_start, "compile", compile_status.exit_code, compile_status.signal, false, compile_status.orphan, _qspec_empty_metrics())
    end
    compile_status = QSpecSupervisorStatus { valid: true, stage: "compile", deadline_ms: 0, spawn_error: "", exit_code: resp.exit_code, signal: 0, timed_out: false, term_sent: false, kill_sent: false, elapsed_ms: resp.duration_ms, orphan: false, cancelled: false }
  else
    var compile_argv = vec_new<String>()
    compile_argv.push(ctx.compiler)
    if ctx.cache_flags == "--no-cache"
      compile_argv.push("--no-cache")
    else
      compile_argv.push("--cache-dir"); compile_argv.push("#{ctx.run_dir}/cache"); compile_argv.push("--cache-ro")
    end
    var includes = vec_new<String>()
    includes.push("std"); includes.push("."); includes.push("self-hosted"); includes.push("self-hosted/shared"); includes.push("self-hosted/frontend"); includes.push("self-hosted/middle"); includes.push("self-hosted/backend"); includes.push("spec/qspec/fixtures")
    for ci in 0..includes.size
      compile_argv.push("-I"); compile_argv.push(includes[ci])
    end
    compile_argv.push(spec_file)
    compile_status = _qspec_supervised("compile", ctx.compile_timeout_str, _qspec_stage_argv("compile", compile_argv), vec_new<String>(), vec_new<String>(), ir_path, err_path, false, work_dir, ctx.cancel_path, result_path)
  end

  if compile_status.valid and compile_status.cancelled
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_CANCELLED(), "", "", file_start, "compile", compile_status.exit_code, compile_status.signal, false, compile_status.orphan, _qspec_empty_metrics())
  elsif compile_status.valid and compile_status.timed_out
    var cap = _qspec_capture_show(err_path, name)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_FAILED(), "COMPILE TIMEOUT (>#{ctx.compile_timeout_str}s)", cap, file_start, "compile", compile_status.exit_code, compile_status.signal, true, compile_status.orphan, _qspec_empty_metrics())
  elsif (not compile_status.valid) or str_byte_len(compile_status.spawn_error) > 0 or compile_status.orphan
    return _qspec_result(name, OUTCOME_FAILED(), "compile supervisor failure: #{compile_status.spawn_error}", "", file_start, "compile", compile_status.exit_code, compile_status.signal, false, compile_status.orphan, _qspec_empty_metrics())
  elsif compile_status.signal != 0 or compile_status.exit_code != 0
    var cap2 = _qspec_capture_show(err_path, name)
    var reason = _qspec_compile_reason(compile_status.exit_code, compile_status.signal)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_FAILED(), reason, cap2, file_start, "compile", compile_status.exit_code, compile_status.signal, false, compile_status.orphan, _qspec_empty_metrics())
  end

  # Step 2: Read IR (used for fast-mode skip + library/native detection)
  var ir_content = read_file(ir_path)

  if ctx.fast_mode and _qspec_is_slow(ir_content)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_SKIPPED(), "fast-mode exclusion", "", file_start, "excluded", 0, 0, false, false, _qspec_empty_metrics())
  end

  var needs_native = 0
  if str_contains(ir_content, "@__qz_sched_init(") == 1
    needs_native = 1
  end
  if str_contains(ir_content, "regex_find_all_pattern") == 1
    needs_native = 1
  end
  if str_contains(ir_content, "regex_split_pattern") == 1
    needs_native = 1
  end
  if str_contains(ir_content, "regex_capture_pattern") == 1
    needs_native = 1
  end
  if str_contains(ir_content, "regex_count_pattern") == 1
    needs_native = 1
  end
  if str_contains(ir_content, "SSL_CTX_new") == 1
    needs_native = 1
  end
  if env_get("QSPEC_RUNNER_TEST") == "1"
    var test_stage = env_get("QSPEC_RUNNER_TEST_STAGE")
    if test_stage == "lli"
      needs_native = 0
    elsif test_stage == "llc" or test_stage == "link" or test_stage == "native-run"
      needs_native = 1
    end
  end

  # Step 3a: lli fast path (skips llc + clang, ~0.44s faster per file)
  if str_byte_len(ctx.lli) > 0 and needs_native == 0
    var lli_argv = vec_new<String>(); lli_argv.push(ctx.lli); lli_argv.push(ir_path)
    var result_env_keys = vec_new<String>(); var result_env_values = vec_new<String>()
    result_env_keys.push("QSPEC_RESULT_PATH"); result_env_values.push(result_path)
    result_env_keys.push("QSPEC_RESULT_RUN_ID"); result_env_values.push(ctx.session_id)
    result_env_keys.push("QSPEC_RESULT_FILE_ID"); result_env_values.push(name)
    result_env_keys.push("QSPEC_RESULT_TOKEN"); result_env_values.push(result_token)
    result_env_keys.push("QSPEC_SUB_ROOT"); result_env_values.push("#{work_dir}/nested")
    result_env_keys.push("QSPEC_CANCEL_PATH"); result_env_values.push(ctx.cancel_path)
    var lli_status = _qspec_supervised("lli", ctx.timeout_str, _qspec_stage_argv("lli", lli_argv), result_env_keys, result_env_values, out_path, "", true, work_dir, ctx.cancel_path, result_path)
    var lli_exit = lli_status.exit_code
    var lli_sig = lli_status.signal

    var lli_outcome = OUTCOME_PASSED()
    var lli_reason = ""
    var lli_cap = ""
    if not lli_status.valid or str_byte_len(lli_status.spawn_error) > 0 or lli_status.orphan
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "lli supervisor failure: #{lli_status.spawn_error}"
    elsif lli_status.cancelled
      lli_outcome = OUTCOME_CANCELLED()
    elsif lli_status.timed_out
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "TIMEOUT (>#{ctx.timeout_str}s)"
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_exit == 0 and lli_sig == 0
      lli_outcome = OUTCOME_PASSED()
    elsif lli_sig == 11
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "SIGSEGV"
      lli_cap = _qspec_capture_show(out_path, name)
    else
      lli_outcome = OUTCOME_FAILED()
      if lli_sig != 0
        lli_reason = "signal #{lli_sig}"
      else
        lli_reason = "exit #{lli_exit}"
      end
      lli_cap = _qspec_capture_show(out_path, name)
    end
    var lli_metrics = _qspec_read_metrics(result_path, ctx.session_id, name, result_token)
    var lli_feature = _qspec_read_feature_request(result_path, ctx.session_id, name, result_token)
    var lli_timeout = lli_status.timed_out
    var feature_reason = ""
    if lli_feature.valid
      feature_reason = _qspec_feature_exclusion_reason(name, lli_feature.feature)
    end
    var lli_mode = "lli"
    if lli_feature.present and not lli_feature.valid
      lli_outcome = OUTCOME_FAILED()
      lli_reason = lli_feature.error
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_feature.valid and str_byte_len(feature_reason) == 0
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "unregistered feature exclusion: #{lli_feature.feature}"
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_feature.valid and (lli_exit != 0 or lli_sig != 0)
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "feature exclusion/exit mismatch"
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_feature.valid and str_byte_len(feature_reason) > 0 and lli_exit == 0 and lli_sig == 0
      lli_outcome = OUTCOME_SKIPPED()
      lli_reason = feature_reason
      lli_mode = "lli"
    elsif lli_sig == 0 and lli_exit < 128 and not lli_timeout and not lli_metrics.valid
      lli_outcome = OUTCOME_FAILED()
      lli_reason = lli_metrics.error
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_metrics.valid and lli_metrics.cases == 0
      lli_outcome = OUTCOME_FAILED()
      lli_reason = "zero-case spec"
      lli_cap = _qspec_capture_show(out_path, name)
    elsif lli_metrics.valid and lli_sig == 0 and lli_exit < 128 and not lli_timeout
      var metrics_failed = lli_metrics.case_failures > 0 or lli_metrics.framework_failures > 0
      if (lli_exit == 0 and metrics_failed) or (lli_exit != 0 and not metrics_failed)
        lli_outcome = OUTCOME_FAILED()
        lli_reason = "qspec result/exit mismatch"
        lli_cap = _qspec_capture_show(out_path, name)
      end
    end
    rm(out_path)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, lli_outcome, lli_reason, lli_cap, file_start, lli_mode, lli_status.exit_code, lli_status.signal, lli_timeout, lli_status.orphan, lli_metrics)
  end

  # Step 3b: native fallback (llc → link → run). `-O0` — a spec binary
  # needs correct, not optimized, machine code; O0 codegen is ~3x faster.
  var llc_argv = vec_new<String>(); llc_argv.push("llc"); llc_argv.push("-O0"); llc_argv.push("-filetype=obj"); llc_argv.push(ir_path); llc_argv.push("-o"); llc_argv.push(obj_path)
  var llc_status = _qspec_supervised("llc", ctx.tool_timeout_str, _qspec_stage_argv("llc", llc_argv), vec_new<String>(), vec_new<String>(), "", err_path, false, work_dir, ctx.cancel_path, result_path)
  var llc_exit = llc_status.exit_code
  var llc_sig = llc_status.signal
  if llc_status.cancelled
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_CANCELLED(), "", "", file_start, "llc", llc_exit, llc_sig, false, llc_status.orphan, _qspec_empty_metrics())
  elsif llc_status.timed_out
    var llc_timeout_cap = _qspec_capture_show(err_path, name)
    return _qspec_result(name, OUTCOME_FAILED(), "LLC TIMEOUT (>#{ctx.tool_timeout_str}s)", llc_timeout_cap, file_start, "llc", llc_exit, llc_sig, true, llc_status.orphan, _qspec_empty_metrics())
  elsif not llc_status.valid or str_byte_len(llc_status.spawn_error) > 0 or llc_status.orphan
    return _qspec_result(name, OUTCOME_FAILED(), "llc supervisor failure: #{llc_status.spawn_error}", "", file_start, "llc", llc_exit, 0, false, llc_status.orphan, _qspec_empty_metrics())
  elsif llc_exit != 0 or llc_sig != 0
    var llc_cap = _qspec_capture_show(err_path, name)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_FAILED(), "llc error", llc_cap, file_start, "llc", llc_exit, llc_sig, false, llc_status.orphan, _qspec_empty_metrics())
  end

  var needs_regex = 0
  if str_contains(ir_content, "regex_find_all_pattern") == 1
    needs_regex = 1
  end
  if str_contains(ir_content, "regex_split_pattern") == 1
    needs_regex = 1
  end
  if str_contains(ir_content, "regex_capture_pattern") == 1
    needs_regex = 1
  end
  if str_contains(ir_content, "regex_capture_named_pattern") == 1
    needs_regex = 1
  end
  if str_contains(ir_content, "regex_count_pattern") == 1
    needs_regex = 1
  end

  # Match any `@SSL_`, `@ERR_`, or `@OPENSSL_` declaration — covers the
  # whole libssl/libcrypto surface.
  var needs_tls = 0
  if str_contains(ir_content, "@SSL_") == 1
    needs_tls = 1
  end
  if str_contains(ir_content, "@ERR_") == 1
    needs_tls = 1
  end
  if str_contains(ir_content, "@OPENSSL_") == 1
    needs_tls = 1
  end

  var link_status = _qspec_supervised("link", ctx.tool_timeout_str, _qspec_stage_argv("link", _qspec_link_argv(obj_path, bin_path, needs_regex, needs_tls)), vec_new<String>(), vec_new<String>(), "", err_path, false, work_dir, ctx.cancel_path, result_path)
  var link_exit = link_status.exit_code
  var link_sig = link_status.signal
  if link_status.cancelled
    rm(obj_path)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_CANCELLED(), "", "", file_start, "link", link_exit, link_sig, false, link_status.orphan, _qspec_empty_metrics())
  elsif link_status.timed_out
    return _qspec_result(name, OUTCOME_FAILED(), "LINK TIMEOUT (>#{ctx.tool_timeout_str}s)", "", file_start, "link", link_exit, link_sig, true, link_status.orphan, _qspec_empty_metrics())
  elsif not link_status.valid or str_byte_len(link_status.spawn_error) > 0 or link_status.orphan
    return _qspec_result(name, OUTCOME_FAILED(), "link supervisor failure: #{link_status.spawn_error}", "", file_start, "link", link_exit, 0, false, link_status.orphan, _qspec_empty_metrics())
  elsif link_exit != 0 or link_sig != 0
    rm(obj_path)
    rm(ir_path)
    rm(err_path)
    return _qspec_result(name, OUTCOME_FAILED(), "link error", "", file_start, "link", link_exit, link_sig, false, link_status.orphan, _qspec_empty_metrics())
  end

  # Codesign on macOS (no-op on Linux)
  var sign_argv = _qspec_codesign_argv(bin_path)
  if sign_argv.size > 0
    var sign_status = _qspec_supervised("codesign", ctx.tool_timeout_str, sign_argv, vec_new<String>(), vec_new<String>(), "", err_path, false, work_dir, ctx.cancel_path, result_path)
    if not sign_status.valid or str_byte_len(sign_status.spawn_error) > 0 or sign_status.exit_code != 0 or sign_status.signal != 0 or sign_status.timed_out or sign_status.orphan
      return _qspec_result(name, OUTCOME_FAILED(), "codesign failure", "", file_start, "codesign", sign_status.exit_code, sign_status.signal, sign_status.timed_out, sign_status.orphan, _qspec_empty_metrics())
    end
  end

  # Step 4: run the test binary
  var run_argv = vec_new<String>(); run_argv.push(bin_path)
  var run_env_keys = vec_new<String>(); var run_env_values = vec_new<String>()
  run_env_keys.push("QSPEC_RESULT_PATH"); run_env_values.push(result_path)
  run_env_keys.push("QSPEC_RESULT_RUN_ID"); run_env_values.push(ctx.session_id)
  run_env_keys.push("QSPEC_RESULT_FILE_ID"); run_env_values.push(name)
  run_env_keys.push("QSPEC_RESULT_TOKEN"); run_env_values.push(result_token)
  run_env_keys.push("QSPEC_SUB_ROOT"); run_env_values.push("#{work_dir}/nested")
  run_env_keys.push("QSPEC_CANCEL_PATH"); run_env_values.push(ctx.cancel_path)
  var run_status = _qspec_supervised("native-run", ctx.timeout_str, _qspec_stage_argv("native-run", run_argv), run_env_keys, run_env_values, out_path, "", true, work_dir, ctx.cancel_path, result_path)

  var exit_code = run_status.exit_code
  var raw_sig = run_status.signal

  var outcome = OUTCOME_PASSED()
  var reason2 = ""
  var captured2 = ""
  if not run_status.valid or str_byte_len(run_status.spawn_error) > 0 or run_status.orphan
    outcome = OUTCOME_FAILED()
    reason2 = "run supervisor failure: #{run_status.spawn_error}"
  elsif run_status.cancelled
    outcome = OUTCOME_CANCELLED()
  elsif run_status.timed_out
    outcome = OUTCOME_FAILED()
    reason2 = "TIMEOUT (>#{ctx.timeout_str}s)"
    captured2 = _qspec_capture_show(out_path, name)
  elsif exit_code == 0 and raw_sig == 0
    outcome = OUTCOME_PASSED()
  elsif raw_sig == 11
    outcome = OUTCOME_FAILED()
    reason2 = "SIGSEGV"
    captured2 = _qspec_capture_show(out_path, name)
  else
    outcome = OUTCOME_FAILED()
    if raw_sig != 0
      reason2 = "signal #{raw_sig}"
    else
      reason2 = "exit #{exit_code}"
    end
    captured2 = _qspec_capture_show(out_path, name)
  end

  var run_metrics = _qspec_read_metrics(result_path, ctx.session_id, name, result_token)
  var run_feature = _qspec_read_feature_request(result_path, ctx.session_id, name, result_token)
  var run_timeout = run_status.timed_out
  var feature_reason2 = ""
  if run_feature.valid
    feature_reason2 = _qspec_feature_exclusion_reason(name, run_feature.feature)
  end
  var run_mode = "native-run"
  if run_feature.present and not run_feature.valid
    outcome = OUTCOME_FAILED()
    reason2 = run_feature.error
    captured2 = _qspec_capture_show(out_path, name)
  elsif run_feature.valid and str_byte_len(feature_reason2) == 0
    outcome = OUTCOME_FAILED()
    reason2 = "unregistered feature exclusion: #{run_feature.feature}"
    captured2 = _qspec_capture_show(out_path, name)
  elsif run_feature.valid and (exit_code != 0 or raw_sig != 0)
    outcome = OUTCOME_FAILED()
    reason2 = "feature exclusion/exit mismatch"
    captured2 = _qspec_capture_show(out_path, name)
  elsif run_feature.valid and str_byte_len(feature_reason2) > 0 and exit_code == 0 and raw_sig == 0
    outcome = OUTCOME_SKIPPED()
    reason2 = feature_reason2
    run_mode = "native-run"
  elsif raw_sig == 0 and exit_code < 128 and not run_timeout and not run_metrics.valid
    outcome = OUTCOME_FAILED()
    reason2 = run_metrics.error
    captured2 = _qspec_capture_show(out_path, name)
  elsif run_metrics.valid and run_metrics.cases == 0
    outcome = OUTCOME_FAILED()
    reason2 = "zero-case spec"
    captured2 = _qspec_capture_show(out_path, name)
  elsif run_metrics.valid and raw_sig == 0 and exit_code < 128 and not run_timeout
    var metrics_failed2 = run_metrics.case_failures > 0 or run_metrics.framework_failures > 0
      if (exit_code == 0 and metrics_failed2) or (exit_code != 0 and not metrics_failed2)
      outcome = OUTCOME_FAILED()
      reason2 = "qspec result/exit mismatch"
      captured2 = _qspec_capture_show(out_path, name)
    end
  end

  rm(bin_path)
  rm(out_path)
  rm(obj_path)
  rm(ir_path)
  rm(err_path)
  return _qspec_result(name, outcome, reason2, captured2, file_start, run_mode, run_status.exit_code, run_status.signal, run_timeout, run_status.orphan, run_metrics)
end

## RetryOutcome — result of the serial retry pass. `recovered` are specs
## that failed initially but passed when re-run alone. Recoveries remain gate
## failures; the `still_failed_*` arrays identify persistent failures.
struct RetryRecord
  name: String
  outcome: String
  reason: String
  captured: String
  attempts: Int
  duration_ms: Int
  signal: Int
  timed_out: Bool
end

struct RetryOutcome
  recovered: Vec<String>
  still_failed_names: Vec<String>
  still_failed_reasons: Vec<String>
  still_failed_captured: Vec<String>
  records: Vec<RetryRecord>
end

def _qspec_path_for_name(name: String): String
  if env_get("QSPEC_RUNNER_TEST") == "1" and _qspec_fixture_allowed(name)
    return "spec/qspec/runner_fixtures/#{name}.qz"
  end
  return "spec/qspec/#{name}.qz"
end

def _qspec_fixture_allowed(name: String): Bool
  return name == "pass" or name == "nested" or name == "nested_concurrent" or name == "subresult_constructor" or name == "recovery" or name == "zero" or name == "missing_metrics" or name == "malformed_metrics" or name == "forged_stdout" or name == "forged_report" or name == "mixed_schema" or name == "legacy_v2" or name == "oversized_result" or name == "impossible_arithmetic" or name == "duplicate_record" or name == "persistent_failure" or name == "crash" or name == "feature_exclusion" or name == "fast_exclusion" or name == "arbitrary_exclusion" or name == "quarantine" or name == "exit_mismatch" or name == "spoofed_record" or name == "source_mutating" or name == "leading_whitespace" or name == "trailing_whitespace" or name == "embedded_marker" or name == "hidden_v2" or name == "unknown_protocol" or name == "malformed_protocol_line"
end

## Serial retry pass — the contention-hardening core.
##
## The parallel pool oversubscribes the host toolchain: N workers each
## spawn nested llc/clang/test-binary processes, and multi-file specs
## (those using qspec/subprocess) fork their OWN compiler+linker children.
## Under that load a normally-sub-second spec can spuriously hit a run
## TIMEOUT, or a transient clang/link/spawn can fail — a false negative
## that has nothing to do with the code under test. The failing set
## rotates run-to-run, the signature of contention rather than a real bug.
##
## Re-running each failed spec SERIALLY (no pool, one process at a time,
## worker_handle=0 so a fresh compiler is used — the daemon pool is already
## down by now) reproduces a clean single-process environment. A spec that
## passes here is a diagnostic recovery; one that still fails is persistent.
## Neither observation rewrites the initial gating result.
##
## Mirrors Bazel --flaky_test_attempts / pytest-rerunfailures, but the
## retry runs in a contention-free environment instead of just trying
## again under the same load. `max_attempts` serial tries per spec
## (default 2; a single transient on the retry itself is rare but the
## second attempt covers it). The arrays are parallel and 1:1 with the
## input failed_* arrays.
def _qspec_retry_failed(failed_names: Vec<String>, failed_reasons: Vec<String>, failed_captured: Vec<String>, ctx: SpecCtx, max_attempts: Int): RetryOutcome
  var recovered = vec_new<String>()
  var sf_names = vec_new<String>()
  var sf_reasons = vec_new<String>()
  var sf_captured = vec_new<String>()
  var records = vec_new<RetryRecord>()
  # Clean-room ctx for the retry: force `--no-cache` so the re-run is also
  # immune to qzmod cross-spec contamination (the documented
  # CACHE_DIR_CROSS_SPEC_IR_CONTAMINATION residual), not just process
  # contention — exactly the manual `quartz --no-cache` triage. And a tighter
  # run timeout: contention victims finish in 1–3 s and the slowest legit
  # native spec is ~14 s, so 60 s is ample to confirm a pass, while capping a
  # genuine hang at 60 s instead of the suite's full 300 s. QSPEC_RETRY_TIMEOUT
  # overrides.
  var retry_timeout = _qspec_bounded_decimal(env_get("QSPEC_RETRY_TIMEOUT"), "60", 1, 3600, "QSPEC_RETRY_TIMEOUT")
  var rctx = SpecCtx {
    compiler: ctx.compiler,
    session_id: ctx.session_id,
    lli: ctx.lli,
    timeout_str: retry_timeout,
    compile_timeout_str: ctx.compile_timeout_str,
    tool_timeout_str: ctx.tool_timeout_str,
    fast_mode: ctx.fast_mode,
    cache_flags: "--no-cache",
    result_dir: ctx.result_dir,
    run_dir: ctx.run_dir,
    cancel_path: ctx.cancel_path,
    selected_paths: ctx.selected_paths,
    selected_hashes: ctx.selected_hashes,
  }
  var i = 0
  while i < failed_names.size
    var name = failed_names[i]
    # Every main-lane spec comes from glob("spec/qspec/*_spec.qz"), so the
    # path round-trips from the basename deterministically.
    var spec_file = _qspec_path_for_name(name)
    var passed_on_retry = false
    var give_up = false
    var last_reason = failed_reasons[i]
    var last_captured = failed_captured[i]
    var attempt = 0
    var retry_duration = 0
    var retry_signal = 0
    var retry_timed_out = false
    while attempt < max_attempts and not passed_on_retry and not give_up
      var r = _qspec_run_one(spec_file, rctx, 0)
      retry_duration += r.file_time_ms
      retry_signal = r.signal
      retry_timed_out = r.timed_out
      if r.outcome == OUTCOME_PASSED()
        passed_on_retry = true
      elsif r.outcome == OUTCOME_CANCELLED()
        give_up = true
      else
        last_reason = r.reason
        last_captured = r.captured
        # A hang/timeout won't un-hang on a re-run in the same clean room —
        # stop here rather than burn another full retry_timeout proving it.
        # Transient link/spawn/exit failures still get the extra attempt.
        if str_contains(r.reason, "TIMEOUT") == 1
          give_up = true
        end
      end
      attempt = attempt + 1
    end
    if passed_on_retry
      recovered.push(name)
      records.push(RetryRecord { name: name, outcome: "passed", reason: "", captured: "", attempts: attempt, duration_ms: retry_duration, signal: retry_signal, timed_out: retry_timed_out })
    else
      sf_names.push(name)
      sf_reasons.push(last_reason)
      sf_captured.push(last_captured)
      records.push(RetryRecord { name: name, outcome: "failed", reason: last_reason, captured: last_captured, attempts: attempt, duration_ms: retry_duration, signal: retry_signal, timed_out: retry_timed_out })
    end
    i = i + 1
  end
  return RetryOutcome { recovered: recovered, still_failed_names: sf_names, still_failed_reasons: sf_reasons, still_failed_captured: sf_captured, records: records }
end

def _qspec_sort_strings(values: Vec<String>): Vec<String>
  var sorted = vec_new<String>()
  var used = vec_new<Int>()
  for i in 0..values.size
    used.push(0)
  end
  for rank in 0..values.size
    var best = -1
    for i in 0..values.size
      if used[i] == 0 and (best < 0 or _qspec_string_less(values[i], values[best]))
        best = i
      end
    end
    if best >= 0
      used.set(best, 1)
      sorted.push(values[best])
    end
  end
  return sorted
end

def _qspec_string_less(a: String, b: String): Bool
  var limit = str_byte_len(a)
  if str_byte_len(b) < limit
    limit = str_byte_len(b)
  end
  for i in 0..limit
    var ac = str_byte_at(a, i)
    var bc = str_byte_at(b, i)
    if ac < bc
      return true
    elsif ac > bc
      return false
    end
  end
  return str_byte_len(a) < str_byte_len(b)
end

def _qspec_json_escape(s: String): String
  var out = sb_new()
  for i in 0..str_byte_len(s)
    var ch = str_byte_at(s, i)
    if ch == 34
      out.append("\\\"")
    elsif ch == 92
      out.append("\\\\")
    elsif ch == 10
      out.append("\\n")
    elsif ch == 13
      out.append("\\r")
    elsif ch == 9
      out.append("\\t")
    elsif ch >= 32
      out.append(str_byte_slice(s, i, i + 1))
    end
  end
  return out.to_string()
end

def _qspec_json_string_array(values: Vec<String>): String
  var sorted = _qspec_sort_strings(values)
  var out = sb_new()
  out.append("[")
  for i in 0..sorted.size
    if i > 0
      out.append(",")
    end
    out.append("\"")
    out.append(_qspec_json_escape(sorted[i]))
    out.append("\"")
  end
  out.append("]")
  return out.to_string()
end

def _qspec_supervision_json(path: String): String
  var records = vec_new<String>()
  if file_exists(path) == 1
    var bounded_result = _qspec_read_result_bounded(path)
    if not bounded_result.valid
      return "[]"
    end
    var lines = str_split(bounded_result.content, "\n")
    for i in 0..lines.size
      if str_starts_with(lines[i], "QSS2\t")
        records.push(lines[i])
      end
    end
  end
  return _qspec_json_string_array(records)
end

struct QSpecNestedSupervision
  issued: Int
  recorded: Int
  signals: Int
  timeouts: Int
  orphans: Int
  cancelled: Int
  spawn_failures: Int
  missing: Int
  duplicate_ids: Int
  unexpected: Int
  malformed: Int
  evidence_mismatch: Int
  overflow: Int
end

def _qspec_find_string(values: Vec<String>, target: String): Int
  for i in 0..values.size
    if values[i] == target
      return i
    end
  end
  return -1
end

def _qspec_nested_supervision(path: String): QSpecNestedSupervision
  var issued_ids = vec_new<String>()
  var issued_stages = vec_new<String>()
  var issued_lookup = map_new<String, Int>()
  var completed_ids = vec_new<String>()
  var completed_lookup = map_new<String, Int>()
  var qss_records = vec_new<String>()
  var completed_qss = vec_new<String>()
  var signals = 0
  var timeouts = 0
  var orphans = 0
  var cancelled = 0
  var spawn_failures = 0
  var duplicate_ids = 0
  var unexpected = 0
  var malformed = 0
  var overflow = 0
  if file_exists(path) == 1
    var bounded_result = _qspec_read_result_bounded(path)
    if not bounded_result.valid
      malformed += 1
      return QSpecNestedSupervision { issued: 0, recorded: 0, signals: 0, timeouts: 0, orphans: 0, cancelled: 0, spawn_failures: 0, missing: 0, duplicate_ids: 0, unexpected: 0, malformed: malformed, evidence_mismatch: 0, overflow: 0 }
    end
    var lines = str_split(bounded_result.content, "\n")
    for i in 0..lines.size
      var parts = str_split(lines[i], "\t")
      if parts.size > 0 and parts[0] == "QSI1"
        if parts.size != 3 or not str_starts_with(parts[2], "nested-") or not _qspec_shell_safe_path(parts[1])
          malformed += 1
        elsif issued_lookup.has(parts[1]) == 1
          duplicate_ids += 1
        else
          issued_lookup.set(parts[1], issued_ids.size)
          issued_ids.push(parts[1])
          issued_stages.push(parts[2])
        end
      elsif parts.size > 0 and parts[0] == "QSO1"
        if parts.size == 2 and parts[1] == "4096" and overflow == 0
          overflow = 1
        else
          malformed += 1
        end
      elsif parts.size > 0 and parts[0] == "QSE1"
        if parts.size != 15
          malformed += 1
        else
          var issued_idx = issued_lookup.get(parts[1]).unwrap_or(-1)
          var completed_record = str_byte_slice(lines[i], str_byte_len("QSE1\t" + parts[1] + "\t"), str_byte_len(lines[i]))
          var completed_parts = str_split(completed_record, "\t")
          if parts[2] != "QSS2" or not str_starts_with(parts[3], "nested-") or not _qspec_shell_safe_path(parts[1]) or (issued_idx >= 0 and issued_stages[issued_idx] != parts[3]) or not _qspec_supervisor_parts_legal(completed_parts, parts[3])
            malformed += 1
          elsif completed_lookup.has(parts[1]) == 1
            duplicate_ids += 1
          else
            var exit_ok = _qspec_canonical_exit(parts[6])
            var signal_ok = _qspec_canonical_unsigned(parts[7], 64)
            var deadline_ok = _qspec_canonical_unsigned(parts[4], 3600000) and str_to_int(parts[4]) > 0
            var elapsed_ok = _qspec_canonical_unsigned(parts[11], 3615000)
            var bools_ok = (parts[8] == "0" or parts[8] == "1") and (parts[9] == "0" or parts[9] == "1") and (parts[10] == "0" or parts[10] == "1") and (parts[12] == "0" or parts[12] == "1") and (parts[13] == "0" or parts[13] == "1")
            if not exit_ok or not signal_ok or not deadline_ok or not elapsed_ok or not bools_ok or parts[14] != "trusted-test-no-setsid:qsc3-pgid-anchor:detached-unknown"
              malformed += 1
            else
              completed_lookup.set(parts[1], completed_ids.size)
              completed_ids.push(parts[1])
              completed_qss.push(completed_record)
              if str_to_int(parts[7]) > 0
                signals += 1
              end
              if parts[8] == "1"
                timeouts += 1
              end
              if parts[12] == "1"
                orphans += 1
              end
              if parts[13] == "1"
                cancelled += 1
              end
              if str_byte_len(parts[5]) > 0 and parts[13] == "0"
                spawn_failures += 1
              end
            end
          end
        end
      elsif parts.size > 0 and parts[0] == "QSS2"
        if parts.size < 2 or not _qspec_supervisor_parts_legal(parts, parts[1])
          malformed += 1
        elsif str_starts_with(parts[1], "nested-")
          qss_records.push(lines[i])
        end
      elsif str_starts_with(lines[i], "QSI") or str_starts_with(lines[i], "QSE") or str_starts_with(lines[i], "QSS") or str_starts_with(lines[i], "QSO")
        malformed += 1
      elsif str_byte_len(lines[i]) > 0 and not str_starts_with(lines[i], "QSPEC_RESULT_V3 ") and not str_starts_with(lines[i], "QSPEC_EXCLUSION_V1 ")
        malformed += 1
      end
    end
  end
  var missing = 0
  for i in 0..issued_ids.size
    if completed_lookup.has(issued_ids[i]) == 0
      missing += 1
    end
  end
  for i in 0..completed_ids.size
    if issued_lookup.has(completed_ids[i]) == 0
      unexpected += 1
    end
  end
  var evidence_mismatch = 0
  if qss_records.size != completed_qss.size
    evidence_mismatch = 1
  else
    var qss_counts = map_new<String, Int>()
    for i in 0..qss_records.size
      qss_counts.set(qss_records[i], qss_counts.get(qss_records[i]).unwrap_or(0) + 1)
    end
    for i in 0..completed_qss.size
      var count = qss_counts.get(completed_qss[i]).unwrap_or(0)
      if count < 1
        evidence_mismatch = 1
      else
        qss_counts.set(completed_qss[i], count - 1)
      end
    end
  end
  return QSpecNestedSupervision {
    issued: issued_ids.size, recorded: completed_ids.size,
    signals: signals, timeouts: timeouts, orphans: orphans,
    cancelled: cancelled, spawn_failures: spawn_failures,
    missing: missing, duplicate_ids: duplicate_ids, unexpected: unexpected,
    malformed: malformed, evidence_mismatch: evidence_mismatch,
    overflow: overflow,
  }
end

def _qspec_discovery_manifest_path(): String = "tools/spec/qspec-main-identities.txt"
def _qspec_discovery_manifest_sha256(): String = "21fb2c2a22b1d2ad87bf3d3ad3059b0d544f29074aea9dbb36c751706279ccd1"

struct QSpecDiscoveryContract
  matches: Bool
  digest_matches: Bool
  filesystem_matches: Bool
  actual_sha256: String
  preflight_error: String
  expected: Vec<String>
  observed: Vec<String>
  missing: Vec<String>
  added: Vec<String>
  invalid: Vec<String>
  duplicates: Vec<String>
end

def _qspec_discovery_contains(values: Vec<String>, value: String): Bool
  for i in 0..values.size
    if values[i] == value
      return true
    end
  end
  return false
end

def _qspec_discovery_canonical(path: String): Bool
  if path == "spec/qspec/_stress_large_program_spec.qz"
    return true
  end
  if not str_starts_with(path, "spec/qspec/") or not str_ends_with(path, "_spec.qz")
    return false
  end
  var filename = str_byte_slice(path, str_byte_len("spec/qspec/"), str_byte_len(path))
  if path != "spec/qspec/#{filename}" or str_byte_len(filename) <= str_byte_len("_spec.qz")
    return false
  end
  for i in 0..str_byte_len(filename)
    var ch = str_byte_at(filename, i)
    var portable = (ch >= 'A' and ch <= 'Z') or (ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == '-' or ch == '.'
    if not portable
      return false
    end
    if i == 0 and not ((ch >= 'A' and ch <= 'Z') or (ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9'))
      return false
    end
    if ch == '.' and i != str_byte_len(filename) - 3
      return false
    end
  end
  return true
end

def _qspec_discovery_contract_from_snapshot(selected: Vec<String>, content: String, actual_sha256: String, filesystem_matches: Bool, preflight_error: String): QSpecDiscoveryContract
  var expected = vec_new<String>()
  var observed = vec_new<String>()
  var missing = vec_new<String>()
  var added = vec_new<String>()
  var invalid = vec_new<String>()
  var duplicates = vec_new<String>()
  var digest_matches = actual_sha256 == _qspec_discovery_manifest_sha256()
  var lines = str_split(content, "\n")
  for i in 0..lines.size
    if str_byte_len(lines[i]) > 0
      expected.push(lines[i])
    end
  end
  for i in 0..selected.size
    var path = selected[i]
    if not _qspec_discovery_canonical(path)
      invalid.push(path)
    elsif _qspec_discovery_contains(observed, path)
      duplicates.push(path)
    else
      observed.push(path)
    end
  end
  expected = _qspec_sort_strings(expected)
  observed = _qspec_sort_strings(observed)
  for i in 0..expected.size
    if not _qspec_discovery_contains(observed, expected[i])
      missing.push(expected[i])
    end
  end
  for i in 0..observed.size
    if not _qspec_discovery_contains(expected, observed[i])
      added.push(observed[i])
    end
  end
  var matches = digest_matches and filesystem_matches and str_byte_len(preflight_error) == 0 and expected.size == 903 and selected.size == expected.size and missing.size == 0 and added.size == 0 and invalid.size == 0 and duplicates.size == 0
  return QSpecDiscoveryContract { matches: matches, digest_matches: digest_matches, filesystem_matches: filesystem_matches, actual_sha256: actual_sha256, preflight_error: preflight_error, expected: expected, observed: observed, missing: missing, added: added, invalid: invalid, duplicates: duplicates }
end

def _qspec_discovery_contract(selected: Vec<String>): QSpecDiscoveryContract
  var content = read_file(_qspec_discovery_manifest_path())
  return _qspec_discovery_contract_from_snapshot(selected, content, _qspec_discovery_manifest_sha256(), true, "")
end

def _qspec_discovery_preflight(selected: Vec<String>, run_dir: String): QSpecDiscoveryContract
  var selected_path = "#{run_dir}/discovery-selected.txt"
  var snapshot_path = "#{run_dir}/discovery-manifest.snapshot"
  var status_path = "#{run_dir}/discovery-status.txt"
  var selected_content = ""
  for i in 0..selected.size
    selected_content = selected_content + selected[i] + "\n"
  end
  write_file(selected_path, selected_content)
  var command = "ruby tools/qspec_discovery_contract.rb check --source #{_qspec_discovery_manifest_path()} --source-sha256 #{_qspec_discovery_manifest_sha256()} --selected #{selected_path} --snapshot #{snapshot_path} --status #{status_path} --expected-count 903 --repository ."
  var helper_status = posix_spawn_wait(command)
  if file_exists(snapshot_path) == 0 or file_exists(status_path) == 0
    return _qspec_discovery_contract_from_snapshot(selected, "", "", false, "discovery helper failed without a result")
  end
  var fields = str_split(str_trim(read_file(status_path)), "\t")
  if fields.size != 4
    return _qspec_discovery_contract_from_snapshot(selected, read_file(snapshot_path), "", false, "malformed discovery helper result")
  end
  var error = fields[3]
  if error == "-"
    error = ""
  end
  if helper_status != 0
    if str_byte_len(error) > 0
      error = error + "; discovery helper process failed"
    else
      error = "discovery helper process failed"
    end
  end
  return _qspec_discovery_contract_from_snapshot(selected, read_file(snapshot_path), fields[0], fields[2] == "1", error)
end

def _qspec_discovery_diagnostics(contract: QSpecDiscoveryContract): Void
  if contract.matches
    return
  end
  eputs("qspec discovery identity contract mismatch: expected=#{contract.expected.size} observed=#{contract.observed.size} digest_ok=#{contract.digest_matches} filesystem_ok=#{contract.filesystem_matches}")
  if not contract.digest_matches
    eputs("  manifest SHA-256: #{contract.actual_sha256}")
  end
  if str_byte_len(contract.preflight_error) > 0
    eputs("  preflight: #{contract.preflight_error}")
  end
  if contract.missing.size > 0
    eputs("  missing: #{_qspec_json_string_array(contract.missing)}")
  end
  if contract.added.size > 0
    eputs("  added: #{_qspec_json_string_array(contract.added)}")
  end
  if contract.invalid.size > 0
    eputs("  non-canonical: #{_qspec_json_string_array(contract.invalid)}")
  end
  if contract.duplicates.size > 0
    eputs("  duplicate: #{_qspec_json_string_array(contract.duplicates)}")
  end
end

def _qspec_discovery_contract_test(): Void
  var canonical = _qspec_discovery_contract(vec_new<String>()).expected
  var exact = _qspec_discovery_contract(canonical)
  if canonical.size != 903 or not exact.matches
    _qspec_discovery_diagnostics(exact)
    fail("exact canonical discovery set did not pass")
  end
  var replacement = vec_new<String>()
  for i in 1..canonical.size
    replacement.push(canonical[i])
  end
  replacement.push("spec/qspec/unrelated_replacement_spec.qz")
  var replaced = _qspec_discovery_contract(replacement)
  if replaced.matches or replaced.missing.size != 1 or replaced.added.size != 1
    fail("same-count remove/add replacement did not fail exactly")
  end
  var duplicate = vec_new<String>()
  duplicate.push(canonical[0])
  for i in 1..canonical.size
    duplicate.push(canonical[i])
  end
  duplicate.set(1, canonical[0])
  if _qspec_discovery_contract(duplicate).matches or _qspec_discovery_contract(duplicate).duplicates.size != 1
    fail("duplicate discovery identity did not fail")
  end
  var normalized = vec_new<String>()
  for i in 0..canonical.size
    normalized.push(canonical[i])
  end
  normalized.set(0, "spec/qspec/./abi_classify_spec.qz")
  if _qspec_discovery_contract(normalized).matches or _qspec_discovery_contract(normalized).invalid.size != 1
    fail("non-canonical path spelling did not fail")
  end
  var controls = vec_new<String>()
  controls.push("spec/qspec/bad\nname_spec.qz")
  controls.push("spec/qspec/bad\\name_spec.qz")
  controls.push("spec/qspec/.hidden_spec.qz")
  controls.push("spec/qspec/_other_spec.qz")
  controls.push("spec/qspec/sub/name_spec.qz")
  for ci in 0..controls.size
    if _qspec_discovery_canonical(controls[ci])
      fail("nonportable discovery identity passed validation")
    end
  end
  if not _qspec_discovery_canonical("spec/qspec/_stress_large_program_spec.qz")
    fail("frozen leading-underscore discovery identity was rejected")
  end
  var wasm = vec_new<String>()
  wasm.push("spec/qspec/wasm_core_spec.qz")
  wasm.push("spec/qspec/wasm_data_spec.qz")
  wasm.push("spec/qspec/wasm_extended_spec.qz")
  wasm.push("spec/qspec/wasm_hof_spec.qz")
  for i in 0..wasm.size
    if not _qspec_discovery_contains(canonical, wasm[i])
      fail("registered WASM exclusion absent from discovery identities: #{wasm[i]}")
    end
  end
  puts("qspec exact discovery identity fixtures: PASS")
end

def _qspec_json_bool(value: Bool): String
  if value
    return "true"
  end
  return "false"
end

def _qspec_outcome_name(outcome: Int): String
  if outcome == OUTCOME_PASSED()
    return "passed"
  elsif outcome == OUTCOME_SKIPPED()
    return "skipped"
  elsif outcome == OUTCOME_CANCELLED()
    return "cancelled"
  end
  return "failed"
end

def _qspec_find_result(results: Vec<SpecResult>, name: String): Int
  for i in 0..results.size
    if results[i].name == name
      return i
    end
  end
  return -1
end

def _qspec_selected_source_path(selected: Vec<String>, name: String): String
  for i in 0..selected.size
    if basename_no_ext(selected[i], ".qz") == name
      return selected[i]
    end
  end
  return ""
end

def _qspec_selected_source_hash(selected: Vec<String>, selected_hashes: Vec<String>, name: String): String
  for i in 0..selected.size
    if basename_no_ext(selected[i], ".qz") == name
      return selected_hashes[i]
    end
  end
  return ""
end

def _qspec_find_retry(records: Vec<RetryRecord>, name: String): Int
  for i in 0..records.size
    if records[i].name == name
      return i
    end
  end
  return -1
end

struct ManifestPublish
  path: String
  error: String
  gate_failed: Bool
end

def _qspec_exclusions_json(files: Vec<String>, reasons: Vec<String>): String
  var out = sb_new()
  out.append("[")
  var names = _qspec_sort_strings(files)
  for i in 0..names.size
    if i > 0
      out.append(",")
    end
    var reason = "excluded"
    for j in 0..files.size
      if files[j] == names[i]
        reason = reasons[j]
      end
    end
    out.append("{\"file\":\"#{_qspec_json_escape(names[i])}\",\"reason\":\"#{_qspec_json_escape(reason)}\"}")
  end
  out.append("]")
  return out.to_string()
end

def _qspec_retained_preflight(path: String, session_id: String): String
  if str_byte_len(path) == 0
    return ""
  end
  if file_exists(path) == 1
    return "retained manifest path already exists"
  end
  if not _qspec_shell_safe_path(path)
    return "retained manifest path contains unsupported characters"
  end
  if file_exists(path_dir(path)) == 0
    return "retained manifest parent does not exist"
  end
  if file_exists("#{path}.tmp.#{session_id}") == 1
    return "retained manifest temporary path already exists"
  end
  return ""
end

def _qspec_atomic_publish(path: String, content: String, session_id: String): String
  var tmp = "#{path}.tmp.#{session_id}"
  if file_exists(path) == 1
    return "manifest destination already exists"
  end
  if file_exists(tmp) == 1
    return "manifest temporary path conflict"
  end
  write_file(tmp, content)
  if file_exists(tmp) == 0 or read_file(tmp) != content
    rm(tmp)
    return "manifest temporary write failed"
  end
  if rename(tmp, path) != 0
    rm(tmp)
    return "manifest atomic rename failed"
  end
  return ""
end

def _qspec_atomic_publish_retained(path: String, content: String, session_id: String): String
  var tmp = "#{path}.tmp.#{session_id}"
  if file_exists(path) == 1 or file_exists(tmp) == 1
    return "retained manifest path conflict"
  end
  write_file(tmp, content)
  if file_exists(tmp) == 0 or read_file(tmp) != content
    rm(tmp)
    return "retained manifest temporary write failed"
  end
  var move_result = posix_spawn_wait("mv -n #{tmp} #{path}")
  if move_result != 0 or file_exists(tmp) == 1
    rm(tmp)
    return "retained manifest path conflict"
  end
  return ""
end

def _qspec_write_manifest(session_id: String, selected: Vec<String>, selected_hashes: Vec<String>, excluded: Vec<String>, excluded_reasons: Vec<String>, quarantined: Vec<String>, quarantine_selected: Vec<String>, quarantine_excluded: Vec<String>, results: Vec<SpecResult>, retries: Vec<RetryRecord>, workers: Int, cache_flags: String, suite_ms: Int, user_cancelled: Bool, compiler: String, lli: String, discovery: QSpecDiscoveryContract): ManifestPublish
  var selected_names = vec_new<String>()
  for i in 0..selected.size
    selected_names.push(basename_no_ext(selected[i], ".qz"))
  end
  selected_names = _qspec_sort_strings(selected_names)
  var skipped_names = vec_new<String>()
  var initial_failed = 0
  var recovered = 0
  var persistent = 0
  var zero_case = 0
  var cases = 0
  var passed_cases = 0
  var failed_cases = 0
  var framework_failures = 0
  var pending = 0
  var skipped_cases = 0
  var assertions = 0
  var nested_signals = 0
  var nested_timeouts = 0
  var nested_orphans = 0
  var nested_cancelled = 0
  var nested_spawn_failures = 0
  var nested_issued = 0
  var nested_recorded = 0
  var nested_reconciliation_errors = 0
  var nested_overflows = 0
  for i in 0..results.size
    var r = results[i]
    if r.outcome == OUTCOME_SKIPPED()
      skipped_names.push(r.name)
    elsif r.outcome == OUTCOME_FAILED()
      initial_failed += 1
      var ri = _qspec_find_retry(retries, r.name)
      if ri >= 0 and retries[ri].outcome == "passed"
        recovered += 1
      else
        persistent += 1
      end
    end
    if r.metrics_valid
      cases += r.cases
      passed_cases += r.passed
      failed_cases += r.case_failures
      framework_failures += r.framework_failures
      pending += r.pending
      skipped_cases += r.skipped
      assertions += r.assertions
      if r.cases == 0
        zero_case += 1
      end
    end
    var stage_path = "tmp/qspec-runs/#{session_id}/results/#{r.name}.result"
    var nested = _qspec_nested_supervision(stage_path)
    nested_signals += nested.signals
    nested_timeouts += nested.timeouts
    nested_orphans += nested.orphans
    nested_cancelled += nested.cancelled
    nested_spawn_failures += nested.spawn_failures
    nested_issued += nested.issued
    nested_recorded += nested.recorded
    nested_overflows += nested.overflow
    nested_reconciliation_errors += nested.missing + nested.duplicate_ids + nested.unexpected + nested.malformed + nested.evidence_mismatch + nested.overflow
  end

  var retained = env_get("QSPEC_MANIFEST")
  var publication_error = _qspec_retained_preflight(retained, session_id)
  var discovery_enforced = env_get("QSPEC_RUNNER_TEST") != "1" and env_get("QSPEC_SLOW") != "1" and str_byte_len(env_get("QSPEC_PATTERN")) == 0
  var discovery_matches = discovery.matches
  if discovery_enforced and not discovery_matches
    _qspec_discovery_diagnostics(discovery)
  end
  var gate_failed = initial_failed > 0 or user_cancelled or selected.size == 0 or results.size != selected.size or str_byte_len(publication_error) > 0 or (discovery_enforced and not discovery_matches) or nested_signals > 0 or nested_timeouts > 0 or nested_orphans > 0 or nested_cancelled > 0 or nested_spawn_failures > 0 or nested_reconciliation_errors > 0

  var out = sb_new()
  out.append("{\"schema\":\"quartz.qspec.run/v3\",\"evidence_contract\":{\"parent_observed\":\"raw parent and supervisor facts only\",\"test_reported\":\"validated trusted-test self-report; arbitrary test code shares the inherited result-file authority\",\"runner_evaluated\":\"combined gate classification; depends on test_reported where explicitly marked\"},\"run_id\":\"")
  out.append(_qspec_json_escape(session_id))
  out.append("\",\"gate_result\":\"")
  if gate_failed
    out.append("failed")
  else
    out.append("passed")
  end
  out.append("\",\"duration_ms\":#{suite_ms},\"worker_count\":#{workers},\"worker_mode\":\"")
  if env_get("QSPEC_DAEMON") == "1"
    out.append("persistent")
  else
    out.append("process")
  end
  out.append("\",\"cache_mode\":\"")
  if cache_flags == "not-started"
    out.append("not-started")
  elsif cache_flags == "--no-cache"
    out.append("disabled")
  else
    out.append("prewarm-read-only")
  end
  out.append("\",\"publication_error\":")
  if str_byte_len(publication_error) > 0
    out.append("\"#{_qspec_json_escape(publication_error)}\"")
  else
    out.append("null")
  end
  out.append(",\"selection\":{\"selected\":")
  out.append(_qspec_json_string_array(selected_names))
  out.append(",\"expected_discovery\":{\"enforced\":#{_qspec_json_bool(discovery_enforced)},\"contract\":\"#{_qspec_discovery_manifest_path()}\",\"sha256\":\"#{_qspec_discovery_manifest_sha256()}\",\"actual_sha256\":\"#{_qspec_json_escape(discovery.actual_sha256)}\",\"digest_matches\":#{_qspec_json_bool(discovery.digest_matches)},\"filesystem_matches\":#{_qspec_json_bool(discovery.filesystem_matches)},\"preflight_error\":\"#{_qspec_json_escape(discovery.preflight_error)}\",\"expected_files\":#{discovery.expected.size},\"observed_files\":#{selected.size},\"missing\":")
  out.append(_qspec_json_string_array(discovery.missing))
  out.append(",\"added\":")
  out.append(_qspec_json_string_array(discovery.added))
  out.append(",\"non_canonical\":")
  out.append(_qspec_json_string_array(discovery.invalid))
  out.append(",\"duplicates\":")
  out.append(_qspec_json_string_array(discovery.duplicates))
  out.append(",\"matches\":#{_qspec_json_bool(discovery_matches)}}")
  out.append(",\"skipped\":")
  out.append(_qspec_json_string_array(skipped_names))
  out.append(",\"excluded\":")
  out.append(_qspec_exclusions_json(excluded, excluded_reasons))
  out.append(",\"quarantine_inventory\":")
  out.append(_qspec_json_string_array(quarantined))
  out.append(",\"quarantine_selected\":")
  out.append(_qspec_json_string_array(quarantine_selected))
  out.append(",\"quarantine_excluded\":")
  out.append(_qspec_json_string_array(quarantine_excluded))
  out.append("},\"totals\":{\"parent_observed\":{\"selected_files\":#{selected.size},\"configured_quarantines\":#{quarantined.size}},\"test_reported\":{\"pending_cases\":#{pending},\"zero_case_files\":#{zero_case},\"cases\":#{cases},\"passed_cases\":#{passed_cases},\"failed_cases\":#{failed_cases},\"framework_failures\":#{framework_failures},\"skipped_cases\":#{skipped_cases},\"assertions\":#{assertions},\"shared_protocol\":{\"nested_stages_issued\":#{nested_issued},\"nested_stages_recorded\":#{nested_recorded},\"nested_stage_signals\":#{nested_signals},\"nested_stage_timeouts\":#{nested_timeouts},\"nested_stage_orphans\":#{nested_orphans},\"nested_stage_cancelled\":#{nested_cancelled},\"nested_stage_spawn_failures\":#{nested_spawn_failures},\"nested_stage_overflows\":#{nested_overflows},\"nested_stage_reconciliation_errors\":#{nested_reconciliation_errors}}},\"runner_evaluated\":{\"initial_failures\":#{initial_failed},\"recoveries\":#{recovered},\"persistent_failures\":#{persistent}}},\"files\":[")
  for i in 0..selected_names.size
    if i > 0
      out.append(",")
    end
    var name = selected_names[i]
    var idx = _qspec_find_result(results, name)
    var source_path = _qspec_selected_source_path(selected, name)
    var source_hash = _qspec_selected_source_hash(selected, selected_hashes, name)
    out.append("{\"file\":\"")
    out.append(_qspec_json_escape(name))
    if idx < 0
      out.append("\",\"parent_observed\":{\"selection\":{\"source_path\":\"#{source_path}\",\"selected_pre_execution_content_hash\":\"#{source_hash}\"},\"compiler\":{\"path\":\"#{_qspec_json_escape(compiler)}\"},\"toolchain\":{\"lli\":\"#{_qspec_json_escape(lli)}\",\"llc\":\"llc\",\"linker\":\"platform-default\"},\"stage_status\":{\"stage\":\"none\",\"exit_code\":-1,\"signal\":0,\"timed_out\":false,\"orphan\":false},\"output\":\"\",\"duration_ms\":0},\"test_reported\":{\"metrics\":null,\"shared_protocol\":{\"supervision\":[],\"summary\":{\"nested_issued\":0,\"nested_recorded\":0,\"nested_signals\":0,\"nested_timeouts\":0,\"nested_orphans\":0,\"nested_cancelled\":0,\"nested_spawn_failures\":0,\"nested_overflows\":0,\"nested_reconciliation_errors\":0}}},\"runner_evaluated\":{\"depends_on_test_reported\":false,\"initial_result\":\"unrun\",\"final_result\":\"unrun\",\"reason\":\"missing result\",\"retry_result\":null}}")
    else
      var r = results[idx]
      source_hash = r.selected_source_hash
      var retry_idx = _qspec_find_retry(retries, name)
      var final_result = _qspec_outcome_name(r.outcome)
      if r.outcome == OUTCOME_FAILED() and retry_idx >= 0
        if retries[retry_idx].outcome == "passed"
          final_result = "recovered"
        else
          final_result = "persistent_failure"
        end
      end
      out.append("\",\"parent_observed\":{\"selection\":{\"source_path\":\"#{source_path}\",\"selected_pre_execution_content_hash\":\"#{source_hash}\"},\"compiler\":{\"path\":\"#{_qspec_json_escape(compiler)}\"},\"toolchain\":{\"lli\":\"#{_qspec_json_escape(lli)}\",\"llc\":\"llc\",\"linker\":\"platform-default\"},\"stage_status\":")
      if r.execution_mode == "excluded"
        out.append("null")
      else
        out.append("{\"stage\":\"#{r.execution_mode}\",\"exit_code\":#{r.exit_code},\"signal\":#{r.signal},\"timed_out\":#{_qspec_json_bool(r.timed_out)},\"orphan\":#{_qspec_json_bool(r.orphan)}}")
      end
      out.append(",\"output\":\"#{_qspec_json_escape(r.captured)}\",\"duration_ms\":#{r.file_time_ms}},\"test_reported\":{\"metrics\":")
      var stage_path = "tmp/qspec-runs/#{session_id}/results/#{name}.result"
      var nested_summary = _qspec_nested_supervision(stage_path)
      var nested_errors = nested_summary.missing + nested_summary.duplicate_ids + nested_summary.unexpected + nested_summary.malformed + nested_summary.evidence_mismatch + nested_summary.overflow
      if r.metrics_valid
        out.append("{\"authority\":\"test_reported\",\"cases\":#{r.cases},\"passed\":#{r.passed},\"case_failures\":#{r.case_failures},\"framework_failures\":#{r.framework_failures},\"pending\":#{r.pending},\"skipped\":#{r.skipped},\"assertions\":#{r.assertions},\"duration_us\":#{r.case_duration_us}}")
      else
        out.append("null")
      end
      var depends_on_test_reported = r.execution_mode == "lli" or r.execution_mode == "native-run"
      out.append(",\"shared_protocol\":{\"supervision\":#{_qspec_supervision_json(stage_path)},\"summary\":{\"nested_issued\":#{nested_summary.issued},\"nested_recorded\":#{nested_summary.recorded},\"nested_signals\":#{nested_summary.signals},\"nested_timeouts\":#{nested_summary.timeouts},\"nested_orphans\":#{nested_summary.orphans},\"nested_cancelled\":#{nested_summary.cancelled},\"nested_spawn_failures\":#{nested_summary.spawn_failures},\"nested_overflows\":#{nested_summary.overflow},\"nested_reconciliation_errors\":#{nested_errors}}}},\"runner_evaluated\":{\"depends_on_test_reported\":#{_qspec_json_bool(depends_on_test_reported)},\"initial_result\":\"#{_qspec_outcome_name(r.outcome)}\",\"final_result\":\"#{final_result}\",\"reason\":\"#{_qspec_json_escape(r.reason)}\",\"retry_result\":")
      if retry_idx >= 0
        var rr = retries[retry_idx]
        out.append("{\"result\":\"#{rr.outcome}\",\"attempts\":#{rr.attempts},\"reason\":\"#{_qspec_json_escape(rr.reason)}\",\"output\":\"#{_qspec_json_escape(rr.captured)}\",\"signal\":#{rr.signal},\"timed_out\":#{_qspec_json_bool(rr.timed_out)},\"duration_ms\":#{rr.duration_ms}}")
      else
        out.append("null")
      end
      out.append("}}")
    end
  end
  out.append("]}\n")
  var content = out.to_string()
  var run_dir = "tmp/qspec-runs/#{session_id}"
  var run_path = "#{run_dir}/manifest.json"
  var run_error = _qspec_atomic_publish(run_path, content, session_id)
  if str_byte_len(run_error) > 0
    return ManifestPublish { path: run_path, error: run_error, gate_failed: true }
  end
  if str_byte_len(retained) > 0 and str_byte_len(publication_error) == 0
    var retained_error = _qspec_atomic_publish_retained(retained, content, session_id)
    if str_byte_len(retained_error) > 0
      return ManifestPublish { path: run_path, error: retained_error, gate_failed: true }
    end
    return ManifestPublish { path: retained, error: "", gate_failed: gate_failed }
  end
  return ManifestPublish { path: run_path, error: publication_error, gate_failed: gate_failed }
end

## Choose the worker count. Honours QSPEC_WORKERS env override; otherwise
## probes `nproc` (Linux, cgroup-aware in modern coreutils) then
## `sysctl -n hw.ncpu` (macOS), capping at 16 per design D2 to prevent
## pathological spawning on huge machines.
def _qspec_worker_count(): Int
  var override = env_get("QSPEC_WORKERS")
  if str_byte_len(override) > 0
    var bounded = _qspec_bounded_decimal(override, "1", 1, 64, "QSPEC_WORKERS")
    return str_to_int(bounded)
  end
  var s = sh_capture("nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 8")
  var c = str_to_int(str_trim(s))
  if c <= 0
    c = 8
  end
  if c > 16
    c = 16
  end
  # Memory cap: never run more concurrent compiles than free RAM supports.
  # ~3 GiB/worker covers an outer compile AND (for inner-compile specs) its
  # grandchild compile. macOS: vm_stat pages*pagesize; Linux: /proc/meminfo.
  var mem_cmd = "vm_stat 2>/dev/null | awk -v ps=$(sysctl -n hw.pagesize 2>/dev/null || echo 16384) '/free/{f=$3}/inactive/{i=$3}/speculative/{s=$3}END{printf \"%d\", (f+i+s)*ps/1073741824}' 2>/dev/null || awk '/MemAvailable/{printf \"%d\", $2/1048576}' /proc/meminfo 2>/dev/null || echo 48"
  var free_gib = str_to_int(str_trim(sh_capture(mem_cmd)))
  var mem_cap = free_gib / 3
  if mem_cap < 1
    mem_cap = 1
  end
  if mem_cap < c
    c = mem_cap
  end
  return c
end

def _qspec_bounded_decimal(value: String, fallback: String, min: Int, max: Int, label: String): String
  if str_byte_len(value) == 0
    return fallback
  end
  if str_byte_len(value) > 9
    fail("#{label} must be a decimal integer between #{min} and #{max}")
  end
  for i in 0..str_byte_len(value)
    var ch = str_byte_at(value, i)
    if ch < '0' or ch > '9'
      fail("#{label} must be a decimal integer between #{min} and #{max}")
    end
  end
  var parsed = str_to_int(value)
  if parsed < min or parsed > max
    fail("#{label} must be a decimal integer between #{min} and #{max}")
  end
  return value
end

struct QSpecRunOwnership
  id: String
  run_dir: String
  result_dir: String
end

def _qspec_allocate_run(): QSpecRunOwnership
  mkdir_p("tmp/qspec-runs")
  var run_dir = str_trim(sh_capture("mktemp -d tmp/qspec-runs/run.XXXXXXXX"))
  if not str_starts_with(run_dir, "tmp/qspec-runs/run.") or not _qspec_shell_safe_path(run_dir) or file_exists(run_dir) == 0
    fail("Could not atomically allocate a unique QSpec run directory")
  end
  var result_dir = "#{run_dir}/results"
  mkdir(result_dir)
  if posix_spawn_wait("chmod 700 #{run_dir} #{result_dir}") != 0
    fail("Could not secure QSpec run directory: #{run_dir}")
  end
  return QSpecRunOwnership { id: path_basename(run_dir), run_dir: run_dir, result_dir: result_dir }
end

def _qspec_test_unique_run_dirs(): Void
  var seen = vec_new<String>()
  var dirs = vec_new<String>()
  for i in 0..32
    var owned = _qspec_allocate_run()
    for j in 0..seen.size
      if seen[j] == owned.id
        fail("QSpec run ownership collision: #{owned.id}")
      end
    end
    seen.push(owned.id)
    dirs.push(owned.run_dir)
  end
  for i in 0..dirs.size
    rm_rf(dirs[i])
  end
end

## Worker goroutine body. Pulls spec_file pointers off `work_ch`, runs
## each through `_qspec_run_one`, sends the SpecResult through `result_ch`.
## A zero recv from `work_ch` is the "no more work" sentinel — the
## dispatcher pushes one per worker after enqueuing all real specs.
## Workers also short-circuit on `cancel_flag` set so a SIGINT-killed
## sibling spec drains the pool quickly.
##
## `worker_handle` (Phase 5.0c) is `as_int(PersistentWorker)` when
## QSPEC_DAEMON=1 mode is active, 0 otherwise — threaded through to
## _qspec_run_one which swaps the compile step accordingly.
def _qspec_worker(work_ch: Int, result_ch: Int, cancel_flag: Int, ctx: SpecCtx, worker_handle: Int): Int
  while true
    if atomic_load(cancel_flag) == 1
      return 0
    end
    var raw = recv(work_ch)
    if raw == 0
      return 0
    end
    var spec_file: String = as_type<String>(raw)
    var result = _qspec_run_one(spec_file, ctx, worker_handle)
    if result.outcome == OUTCOME_CANCELLED()
      var _was_set = atomic_cas(cancel_flag, 0, 1)
    end
    send(result_ch, as_int(result))
  end
  return 0
end

## Dispatcher goroutine body. Pushes every spec_file pointer into
## `work_ch`, then pushes one zero-sentinel per worker so they exit
## cleanly. work_ch is sized at total_files + num_workers so neither
## phase blocks; this avoids the deadlock where a cancelled-then-
## drained pool leaves a producer wedged on send.
def _qspec_dispatch(work_ch: Int, spec_files: Vec<String>, num_workers: Int, cancel_flag: Int): Int
  var i = 0
  while i < spec_files.size and atomic_load(cancel_flag) == 0
    send(work_ch, as_int(spec_files[i]))
    i = i + 1
  end
  var s = 0
  while s < num_workers
    send(work_ch, 0)
    s = s + 1
  end
  return 0
end

## INC.2 — pre-warm a run-owned shared `.qzmod` cache before workers run.
##
## Compiles `spec/qspec/_qspec_prewarm.qz` (the qspec framework, which
## every spec imports) ONCE, single-threaded, with a WRITABLE cache at
## `<run_dir>/cache`. That populates a complete `.qzmod` for the
## framework and its transitive stdlib deps. The workers then compile
## each spec with `--cache-ro` against that dir — pure reads, so no two
## workers ever race on a cache write, and each spec skips re-parsing /
## re-typechecking / re-MIR-lowering the shared modules.
##
## Returns the cache flags `_qspec_run_one` threads into every per-spec
## compile: "--cache-dir <run_dir>/cache --cache-ro" on success, or
## "--no-cache" if pre-warm is opted out, the pre-warm file is missing,
## or the pre-warm compile fails.
##
## DEFAULT ON since 2026-05-21. INC.2.0 (the `Throws.throw` → `load ptr
## %throw` cache-codegen bug that originally gated this) landed
## 2026-05-15; subsequent qzmod / INC.1 / INC.2 work brought full-suite
## prewarm to 789/802 passing in 272s. The only prewarm-induced spec
## failure (`repl_spec`'s local `strip_ansi` colliding with
## `colors$strip_ansi` re-exported via `import * from qspec`) was fixed
## at the spec by renaming. The deeper qzmod-shadowing issue is filed
## as `docs/bugs/QZMOD_INJECT_IGNORES_CONSUMER_SHADOW.md`. Set
## QSPEC_PREWARM=0 to opt out (falls back to the old `--no-cache`
## per-spec path).
def _qspec_prewarm_cache(compiler: String, run_dir: String, compile_timeout: String): String
  if env_get("QSPEC_PREWARM") == "0"
    return "--no-cache"
  end
  var prewarm_src = "spec/qspec/_qspec_prewarm.qz"
  if exists(prewarm_src) == 0
    eputs(color_dim("qspec: #{prewarm_src} missing — specs compile --no-cache"))
    return "--no-cache"
  end
  var cache_dir = "#{run_dir}/cache"
  mkdir(cache_dir)
  var prewarm_err = "#{run_dir}/prewarm.err"
  var pw_argv = vec_new<String>(); pw_argv.push(compiler); pw_argv.push("--cache-dir"); pw_argv.push(cache_dir)
  var includes = vec_new<String>(); includes.push("std"); includes.push("."); includes.push("self-hosted"); includes.push("self-hosted/shared"); includes.push("self-hosted/frontend"); includes.push("self-hosted/middle"); includes.push("self-hosted/backend"); includes.push("spec/qspec/fixtures")
  for i in 0..includes.size
    pw_argv.push("-I"); pw_argv.push(includes[i])
  end
  pw_argv.push(prewarm_src)
  var t0 = time.time_epoch_ms()
  var status = _qspec_supervised("prewarm-compile", compile_timeout, pw_argv, vec_new<String>(), vec_new<String>(), "/dev/null", prewarm_err, false, run_dir, "#{run_dir}/cancel", "")
  var dt = time.time_epoch_ms() - t0
  if not status.valid or str_byte_len(status.spawn_error) > 0 or status.exit_code != 0 or status.signal != 0 or status.timed_out or status.orphan
    eputs(color_dim("qspec: pre-warm failed — specs compile --no-cache; see #{prewarm_err}"))
    return "--no-cache"
  end
  eputs(color_dim("qspec: pre-warmed run cache #{cache_dir} in #{dt}ms — specs compile --cache-ro"))
  return "--cache-dir #{cache_dir} --cache-ro"
end

def run_qspec(): Void
  var compiler = compiler_path()
  if exists(compiler) == 0
    fail("QSpec requires compiler at #{compiler}. Run 'quake build' first.")
  end

  var suite_start = time.time_epoch_ms()
  var ownership = _qspec_allocate_run()
  var session_id = ownership.id
  var run_dir = ownership.run_dir
  var result_dir = ownership.result_dir
  defer rm_rf(run_dir)

  # Optional QSPEC_PATTERN env var: glob substring filter for selecting
  # a subset of spec files. Useful for running just the colors/style/
  # progress specs without firing the entire 410-file suite.
  var pattern = env_get("QSPEC_PATTERN")
  # Slow lane (QSPEC_SLOW=1): run ONLY the quarantined specs. Default
  # lane: run everything EXCEPT them. See _qspec_quarantined_names.
  var slow_lane = env_get("QSPEC_SLOW") == "1"
  var globbed = glob("spec/qspec/*_spec.qz")
  var fixture = env_get("QSPEC_RUNNER_FIXTURE")
  var rejected_fixture = ""
  if env_get("QSPEC_RUNNER_TEST") == "1" and env_get("QSPEC_RUNNER_TEST_TWO") == "1"
    globbed = vec_new<String>()
    globbed.push("spec/qspec/runner_fixtures/pass.qz")
    globbed.push("spec/qspec/runner_fixtures/nested.qz")
  elsif str_byte_len(fixture) > 0
    globbed = vec_new<String>()
    if env_get("QSPEC_RUNNER_TEST") == "1" and _qspec_fixture_allowed(fixture)
      globbed.push("spec/qspec/runner_fixtures/#{fixture}.qz")
    else
      rejected_fixture = fixture
    end
  end
  var spec_files = vec_new<String>()
  var excluded_files = vec_new<String>()
  var excluded_reasons = vec_new<String>()
  var quarantine_selected = vec_new<String>()
  var quarantine_excluded = vec_new<String>()
  if str_byte_len(rejected_fixture) > 0
    excluded_files.push(rejected_fixture)
    excluded_reasons.push("runner fixture selector rejected by strict allowlist")
  end
  for gi in 0..globbed.size
    var f = globbed[gi]
    var keep = true
    var exclusion_reason = ""
    if str_byte_len(pattern) > 0 and str_contains(f, pattern) == 0
      keep = false
      exclusion_reason = "does not match QSPEC_PATTERN"
    end
    if _qspec_is_quarantined(f) != slow_lane
      keep = false
      if slow_lane
        exclusion_reason = "not configured for quarantine lane"
      else
        exclusion_reason = "configured quarantine excluded from main lane"
      end
    end
    if keep
      spec_files.push(f)
      if _qspec_is_quarantined(f)
        quarantine_selected.push(basename_no_ext(f, ".qz"))
      end
    else
      excluded_files.push(basename_no_ext(f, ".qz"))
      excluded_reasons.push(exclusion_reason)
      if _qspec_is_quarantined(f)
        quarantine_excluded.push(basename_no_ext(f, ".qz"))
      end
    end
  end
  # Production discovery is a preflight gate. The helper reads and hashes the
  # expected manifest once, then validates each selected filesystem object before
  # any source hash, prewarm, compile, or test process can start.
  var discovery = _qspec_discovery_contract(spec_files)
  if env_get("QSPEC_RUNNER_TEST") != "1"
    discovery = _qspec_discovery_preflight(spec_files, run_dir)
  end
  var discovery_enforced = env_get("QSPEC_RUNNER_TEST") != "1" and env_get("QSPEC_SLOW") != "1" and str_byte_len(pattern) == 0
  var discovery_preflight_failed = not discovery.filesystem_matches or str_byte_len(discovery.preflight_error) > 0 or (discovery_enforced and not discovery.matches)
  if discovery_preflight_failed
    _qspec_discovery_diagnostics(discovery)
    var preflight_results = vec_new<SpecResult>()
    var preflight_retries = vec_new<RetryRecord>()
    var preflight_hashes = vec_new<String>()
    for phi in 0..spec_files.size
      preflight_hashes.push("")
    end
    var preflight_manifest = _qspec_write_manifest(session_id, spec_files, preflight_hashes, excluded_files, excluded_reasons, _qspec_quarantined_names(), quarantine_selected, quarantine_excluded, preflight_results, preflight_retries, 0, "not-started", time.time_epoch_ms() - suite_start, false, compiler, "", discovery)
    eputs(color_dim("Manifest: #{preflight_manifest.path}"))
    rm_rf(run_dir)
    exit(1)
  end
  # Longest-processing-time scheduling — order specs by the previous
  # run's duration so a slow spec never lands last and stretches the
  # parallel tail. First run (no cache) keeps glob order.
  spec_files = _qspec_order_by_duration(spec_files, _qspec_load_durations())
  # This identifies the exact selected bytes before prewarm, compilation, or
  # test execution. It is not a claim that compilation uses an immutable copy.
  var selected_hashes = vec_new<String>()
  for shi in 0..spec_files.size
    selected_hashes.push(content_hash::content_hash_file(spec_files[shi]))
  end
  var total_files = spec_files.size
  if total_files == 0
    var empty_results = vec_new<SpecResult>()
    var empty_retries = vec_new<RetryRecord>()
    var empty_manifest = _qspec_write_manifest(session_id, spec_files, selected_hashes, excluded_files, excluded_reasons, _qspec_quarantined_names(), quarantine_selected, quarantine_excluded, empty_results, empty_retries, 0, "not-started", 0, false, compiler, "", discovery)
    eputs("No QSpec files selected in spec/qspec/")
    eputs(color_dim("Manifest: #{empty_manifest.path}"))
    rm_rf(run_dir)
    exit(1)
  end
  if slow_lane
    eputs(color_dim("slow lane: #{total_files} quarantined spec(s)"))
  else
    eputs(color_dim("main lane: #{_qspec_quarantined_names().size} spec(s) quarantined — run 'quake qspec_slow' for those"))
  end

  # Set PATH to include LLVM (Homebrew on macOS, system on Linux)
  var current_path = env_get("PATH")
  env("PATH", "#{_llvm_path_prefix()}#{current_path}")

  # Set env vars for subprocess testing (assert_compile_error etc.)
  env("QUARTZ_COMPILER", compiler)
  env("QUARTZ_STD", "std")
  env("QUARTZ_FIXTURES", "spec/qspec/fixtures")

  # Find lli for JIT execution (faster than llc+clang)
  var lli = find_lli()
  env("QUARTZ_LLI", lli)

  # Every stage is bounded. A disabled watchdog cannot safely own descendants.
  var timeout_str = _qspec_bounded_decimal(env_get("QSPEC_TIMEOUT"), "300", 1, 3600, "QSPEC_TIMEOUT")

  # Compile timeout (separate, defaults to 60s — compilation is slower than execution)
  var compile_timeout_str = _qspec_bounded_decimal(env_get("QSPEC_COMPILE_TIMEOUT"), "120", 1, 3600, "QSPEC_COMPILE_TIMEOUT")
  var tool_timeout_str = _qspec_bounded_decimal(env_get("QSPEC_TOOL_TIMEOUT"), "60", 1, 3600, "QSPEC_TOOL_TIMEOUT")

  # Fast mode: skip slow tests (network/TLS/spawn)
  var fast_mode = env_get("QSPEC_FAST") == "1"

  var passed = 0
  var skipped = 0
  var failed_names = vec_new<String>()
  var failed_reasons = vec_new<String>()
  var file_times = vec_new<Int>()
  var file_names = vec_new<String>()
  # Captured failure outputs, dumped after the Live region finalizes.
  # Kept 1:1 with failed_names (push even when empty) so the serial retry
  # pass can reconcile per-spec captures by index.
  var failed_captured = vec_new<String>()
  var initial_results = vec_new<SpecResult>()

  # Ctrl+C cancellation: libc system(3) blocks SIGINT in the parent until
  # the child exits, so a Ctrl+C reaches both parent and child but the
  # parent's signal is queued and not delivered until system() returns.
  # The child dies with SIGINT (raw_sig == 2 or exit_code == 130) and the
  # runner would naively continue to the next spec — meaning the user has
  # to press Ctrl+C once per spec to cancel a 787-spec run. Detect a
  # SIGINT-killed child here, set this flag, break the loop on the next
  # iteration. One Ctrl+C cancels the whole run.
  var user_cancelled = false

  # Worker pool: N goroutines pull spec_files off work_ch, run each through
  # _qspec_run_one, push the SpecResult to result_ch. Main thread (here)
  # drives Live UI + result aggregation. work_ch sized at total_files +
  # num_workers so neither dispatcher nor workers ever block on send.
  var num_workers = _qspec_worker_count()
  # Phase 5.0c (opt-in): daemon mode keeps N persistent-worker
  # subprocesses alive for the whole suite, each via a `go
  # posix_spawn_wait(...)` future whose pthread is held until the
  # worker exits at shutdown. So we need >= 2*N+2 pthreads in the
  # goroutine pool: N for the long-blocked _pw_spawn waiters, N for
  # the active _qspec_worker goroutines doing TCP round-trips +
  # llc/link/run, plus dispatcher + main slop. Without this the
  # scheduler deadlocks — _qspec_worker goroutines can't acquire a
  # pthread because all N are held by _pw_spawn waiters.
  var use_daemon = env_get("QSPEC_DAEMON") == "1"
  if use_daemon
    sched_init(num_workers * 2 + 2)
  else
    sched_init(num_workers)
  end

  # INC.2 — pre-warm the shared `.qzmod` cache (single-threaded) before
  # the worker pool starts. Printed before the Live UI takes the screen.
  var qspec_cache_flags = _qspec_prewarm_cache(compiler, run_dir, compile_timeout_str)

  # Live multi-progress UI: global header + up to num_workers active rows.
  # Per-spec bars are added on the main thread as results arrive (already-
  # finished form), so the global counter advances on each completion.
  var live = Live.new()
    .with_global("qspec", total_files)
    .max_active(num_workers)
    .start()
  var ui_is_tty = progress_auto_mode() == PROGRESS_MODE_TTY()

  # Build the read-only SpecCtx once; every worker shares it by value.
  var ctx = SpecCtx {
    compiler: compiler,
    session_id: session_id,
    lli: lli,
    timeout_str: timeout_str,
    compile_timeout_str: compile_timeout_str,
    tool_timeout_str: tool_timeout_str,
    fast_mode: fast_mode,
    cache_flags: qspec_cache_flags,
    result_dir: result_dir,
    run_dir: run_dir,
    cancel_path: "#{run_dir}/cancel",
    selected_paths: spec_files,
    selected_hashes: selected_hashes,
  }

  var work_ch = channel_new(total_files + num_workers)
  var result_ch = channel_new_unbounded()
  var cancel_flag = atomic_new(0)

  # Phase 5.0c (opt-in): if QSPEC_DAEMON=1, build a persistent-worker pool
  # so each spec-runner goroutine reuses a pre-warmed compiler subprocess
  # instead of fork+exec'ing a fresh one per spec. Pool stays alive for
  # the whole suite; shut down cleanly after results drain. The
  # use_daemon flag was set earlier (before sched_init) to size the
  # goroutine pthread pool.
  var pool = PoolHandle { listener: tcp_listener(0, 0), workers: vec_new<PersistentWorker>() }
  if use_daemon
    pool = _pw_pool_start(num_workers, compiler)
  end

  # Spawn workers
  var handles = vec_new<Int>()
  var w = 0
  while w < num_workers
    var worker_handle = 0
    if use_daemon
      worker_handle = as_int(pool.workers[w])
    end
    handles.push(go _qspec_worker(work_ch, result_ch, cancel_flag, ctx, worker_handle))
    w = w + 1
  end

  # Spawn dispatcher (own goroutine so main can immediately enter recv loop)
  var dispatcher = go _qspec_dispatch(work_ch, spec_files, num_workers, cancel_flag)

  # Receive results until total_files seen or cancellation propagated
  var received = 0
  while received < total_files
    var raw = recv(result_ch)
    var result: SpecResult = as_type<SpecResult>(raw)
    initial_results.push(result)

    var bar = Progress.spinner_only().label(result.name)
    live.add(bar)
    bar.start()

    if result.outcome == OUTCOME_PASSED()
      passed = passed + 1
      bar.finish()
      if ui_is_tty == false
        var ms_str = result.file_time_ms.to_s()
        live.log("  #{color_green("✓")} #{result.name}  #{color_dim("(" + ms_str + "ms)")}")
      end
    elsif result.outcome == OUTCOME_SKIPPED()
      skipped = skipped + 1
      bar.finish()
    elsif result.outcome == OUTCOME_CANCELLED()
      user_cancelled = true
      write_file(ctx.cancel_path, "cancel\n")
      var _was_set = atomic_cas(cancel_flag, 0, 1)
      bar.finish()
    else
      failed_names.push(result.name)
      failed_reasons.push(result.reason)
      failed_captured.push(result.captured)
      bar.fail(result.reason)
      live.log("  #{color_red("✗")} #{result.name}  #{color_dim(result.reason)}")
    end

    file_times.push(result.file_time_ms)
    file_names.push(result.name)
    received = received + 1
    live.tick()

    if user_cancelled
      break
    end
  end

  # Drain workers + dispatcher. With cancel_flag set, workers exit on
  # next recv (sentinel or short-circuit). Dispatcher's sentinel-push
  # phase is non-blocking thanks to work_ch's generous capacity.
  var hi = 0
  while hi < handles.size
    var _r = await handles[hi]
    hi = hi + 1
  end
  var _d = await dispatcher
  channel_free(work_ch)
  channel_free(result_ch)

  if use_daemon
    _pw_pool_shutdown(pool)
  end

  live.finish()

  if user_cancelled
    eputs("")
    eputs(color_yellow("⏹  Cancelled by Ctrl+C — partial run."))
    eputs("")
  end

  # --- Serial retry pass (contention hardening) ---
  # Re-run every parallel-pool failure alone for diagnosis. Initial failures
  # remain authoritative even when a serial observation passes.
  # See _qspec_retry_failed. QSPEC_NO_RETRY=1 disables; QSPEC_RETRY=N sets
  # the max serial attempts per spec (default 2). Skipped on Ctrl+C so a
  # cancelled run doesn't grind through a serial re-run.
  var recovered_names = vec_new<String>()
  var retry_records = vec_new<RetryRecord>()
  var initial_failed_count = failed_names.size
  var retry_disabled = env_get("QSPEC_NO_RETRY") == "1"
  if failed_names.size > 0 and (not user_cancelled) and (not retry_disabled)
    var max_attempts = 2
    var retry_env = env_get("QSPEC_RETRY")
    if str_byte_len(retry_env) > 0
      max_attempts = str_to_int(_qspec_bounded_decimal(retry_env, "2", 1, 10, "QSPEC_RETRY"))
    end
    eputs("")
    eputs(color_dim("Retrying #{failed_names.size} failed spec(s) serially (contention check)…"))
    var ro = _qspec_retry_failed(failed_names, failed_reasons, failed_captured, ctx, max_attempts)
    recovered_names = ro.recovered
    retry_records = ro.records
    # Retry captures improve diagnostics, but the immutable initial outcome
    # remains authoritative for the gate and pass count.
    failed_names = ro.still_failed_names
    failed_reasons = ro.still_failed_reasons
    failed_captured = ro.still_failed_captured
    var rri = 0
    while rri < recovered_names.size
      eputs("  #{color_yellow("recovered, still red")} #{recovered_names[rri]} #{color_dim("(passed on diagnostic serial retry)")}")
      rri = rri + 1
    end
  end

  # Dump captured failure outputs for specs that REMAIN failed after the
  # retry pass (so they don't get clobbered by the diff-redraw cursor moves).
  var di = 0
  while di < failed_captured.size
    var captured = failed_captured[di]
    if str_byte_len(captured) > 0
      eputs(captured)
    end
    di = di + 1
  end

  var suite_end = time.time_epoch_ms()
  var total_ms = suite_end - suite_start

  eputs("")
  eputs("")

  # Summary
  var failed_count = failed_names.size
  var total_secs = total_ms / 1000
  var total_frac = total_ms % 1000 / 10
  var summary = "QSpec"
  if fast_mode and str_byte_len(lli) > 0
    summary = "QSpec (fast, lli)"
  elsif fast_mode
    summary = "QSpec (fast)"
  elsif str_byte_len(lli) > 0
    summary = "QSpec (lli)"
  end
  summary = "#{summary}: #{passed}/#{total_files} initially passed"
  if skipped > 0
    summary = "#{summary}, #{skipped} skipped (slow)"
  end
  summary = "#{summary} (#{total_secs}.#{_qspec_pad2(total_frac)}s)"
  eputs(summary)

  var pending_cases = 0
  var zero_case_files = 0
  var skipped_cases = 0
  for sri in 0..initial_results.size
    if initial_results[sri].metrics_valid
      pending_cases += initial_results[sri].pending
      skipped_cases += initial_results[sri].skipped
      if initial_results[sri].cases == 0
        zero_case_files += 1
      end
    end
  end
  eputs("Outcomes: #{initial_failed_count} initial failure(s), #{recovered_names.size} recovery/recoveries, #{failed_count} persistent failure(s), #{_qspec_quarantined_names().size} quarantined, #{pending_cases} pending case(s), #{skipped_cases} skipped case(s), #{zero_case_files} zero-case file(s)")

  if recovered_names.size > 0
    eputs(color_yellow("#{recovered_names.size} spec(s) recovered on diagnostic serial retry; initial failures keep the gate red:"))
    var rci = 0
    while rci < recovered_names.size
      eputs(color_dim("  #{recovered_names[rci]}"))
      rci = rci + 1
    end
  end

  if failed_count > 0
    eputs("")
    eputs(color_red("Failures:"))
    for i in 0..failed_count
      eputs("  #{failed_names[i]}: #{failed_reasons[i]}")
    end
    eputs("")
  end

  # Slowest files
  _qspec_print_slowest(file_names, file_times, 10)

  # Persist per-spec durations so the next run can schedule longest-first.
  _qspec_save_durations(file_names, file_times)

  var quarantine_names = _qspec_quarantined_names()
  var manifest = _qspec_write_manifest(session_id, spec_files, selected_hashes, excluded_files, excluded_reasons, quarantine_names, quarantine_selected, quarantine_excluded, initial_results, retry_records, num_workers, qspec_cache_flags, total_ms, user_cancelled, compiler, lli, discovery)
  eputs(color_dim("Manifest: #{manifest.path}"))
  if str_byte_len(manifest.error) > 0
    eputs(color_red("Manifest publication: #{manifest.error}"))
  end

  rm_rf(run_dir)
  if manifest.gate_failed
    exit(1)
  else
    eputs(color_green("All QSpec files green!"))
  end
end

# =============================================================================
# QSpec Helpers
# =============================================================================

## Build descriptive compile failure reason from exit code and signal.
def _qspec_compile_reason(exit_code: Int, sig: Int): String
  if sig == 11
    return "compiler SIGSEGV"
  end
  if sig != 0
    return "compiler signal #{sig}"
  end
  return "compile error (exit #{exit_code})"
end

def _qspec_pad2(n: Int): String
  if n < 10
    return "0#{n}"
  end
  return "#{n}"
end

def _qspec_pad3(n: Int): String
  if n < 10
    return "00#{n}"
  elsif n < 100
    return "0#{n}"
  end
  return "#{n}"
end

## Per-spec runtime cache — names[i] ran in times[i] ms last suite run.
## Drives longest-processing-time scheduling (_qspec_order_by_duration).
struct DurationCache
  names: Vec<String>
  times: Vec<Int>
end

def _qspec_durations_path(): String
  var override = env_get("QSPEC_DURATIONS_PATH")
  if env_get("QSPEC_RUNNER_TEST") == "1" and str_byte_len(override) > 0
    return override
  end
  return "tmp/qspec_durations.tsv"
end

def _qspec_duration_value(raw: String): Int
  if str_byte_len(raw) == 0 or str_byte_len(raw) > 12
    return -1
  end
  for i in 0..str_byte_len(raw)
    var ch = str_byte_at(raw, i)
    if ch < '0' or ch > '9'
      return -1
    end
  end
  var value = str_to_int(raw)
  if value < 0 or value > 86400000
    return -1
  end
  return value
end

def _qspec_is_decimal(raw: String, max_len: Int): Bool
  if str_byte_len(raw) == 0 or str_byte_len(raw) > max_len
    return false
  end
  for i in 0..str_byte_len(raw)
    var ch = str_byte_at(raw, i)
    if ch < '0' or ch > '9'
      return false
    end
  end
  return true
end

## Load the previous run's per-spec durations. Missing file → empty
## cache (first run schedules in glob order).
def _qspec_load_durations(): DurationCache
  var names = vec_new<String>()
  var times = vec_new<Int>()
  var path = _qspec_durations_path()
  if file_exists(path) == 1
    var lines = str_split(read_file(path), "\n")
    for i in 0..lines.size
      var parts = str_split(lines[i], "\t")
      if parts.size == 2 and _qspec_shell_safe_path(parts[0])
        var value = _qspec_duration_value(parts[1])
        if value >= 0
          names.push(parts[0])
          times.push(value)
        end
      end
    end
  end
  return DurationCache { names: names, times: times }
end

def _qspec_duration_lock(path: String): String
  var lock = "#{path}.lock"
  var owner_pid = str_trim(sh_capture("ps -o ppid= -p $$"))
  var owner_started = time.time_epoch_ms()
  var owner_process_start = str_trim(sh_capture("ps -o lstart= -p #{owner_pid}"))
  var owner_token = "#{owner_pid}_#{owner_started}_qspec_duration"
  var owner_record = "#{owner_pid}\t#{owner_started}\t#{owner_token}\t#{owner_process_start}\n"
  var stale_after = 30000
  var attempts = 500
  if env_get("QSPEC_RUNNER_TEST") == "1"
    var stale_override = _qspec_duration_value(env_get("QSPEC_DURATION_LOCK_STALE_MS"))
    if stale_override >= 100
      stale_after = stale_override
    end
    var attempts_override = _qspec_duration_value(env_get("QSPEC_DURATION_LOCK_ATTEMPTS"))
    if attempts_override >= 1 and attempts_override <= 500
      attempts = attempts_override
    end
  end
  for attempt in 0..attempts
    if mkdir(lock) == 0
      write_file("#{lock}/owner", owner_record)
      return lock
    end
    var owner_path = "#{lock}/owner"
    if file_exists(owner_path) == 1
      var parts = str_split(str_trim(read_file(owner_path)), "\t")
      if parts.size == 4 and _qspec_is_decimal(parts[0], 10) and _qspec_is_decimal(parts[1], 16) and str_to_int(parts[0]) > 0 and str_to_int(parts[1]) > 0 and str_byte_len(parts[2]) > 0 and str_byte_len(parts[3]) > 0
        var age = time.time_epoch_ms() - str_to_int(parts[1])
        var owner_alive = posix_spawn_wait("kill -0 #{parts[0]} 2>/dev/null") == 0
        var same_process = owner_alive and str_trim(sh_capture("ps -o lstart= -p #{parts[0]}")) == parts[3]
        if age >= stale_after and not same_process
          var stale = "#{lock}.stale.#{owner_pid}.#{owner_started}"
          if rename(lock, stale) == 0
            rm_rf(stale)
          end
        end
      end
    end
    sleep_ms(10)
  end
  return ""
end

def _qspec_release_duration_lock(lock: String): Void
  var owner = "#{lock}/owner"
  if file_exists(owner) == 0
    return
  end
  var parts = str_split(str_trim(read_file(owner)), "\t")
  var current_pid = str_trim(sh_capture("ps -o ppid= -p $$"))
  if parts.size != 4 or parts[0] != current_pid or str_trim(sh_capture("ps -o lstart= -p #{current_pid}")) != parts[3]
    return
  end
  var release = "#{lock}.release.#{parts[2]}"
  if rename(lock, release) == 0
    rm_rf(release)
  end
end

## Merge and atomically persist this run's per-spec durations. The mkdir lock
## serializes read-merge-write so concurrent focused runs retain distinct keys.
def _qspec_save_durations(names: Vec<String>, times: Vec<Int>): Void
  var path = _qspec_durations_path()
  var lock = _qspec_duration_lock(path)
  if str_byte_len(lock) == 0
    eputs(color_yellow("qspec: duration history lock timed out; history not updated"))
    return
  end
  defer _qspec_release_duration_lock(lock)
  var merged = _qspec_load_durations()
  if env_get("QSPEC_RUNNER_TEST") == "1"
    var hold = _qspec_duration_value(env_get("QSPEC_DURATION_LOCK_HOLD_MS"))
    if hold > 0 and hold <= 1000
      sleep_ms(hold)
    end
  end
  for i in 0..names.size
    var found = false
    for j in 0..merged.names.size
      if merged.names[j] == names[i]
        merged.times.set(j, times[i])
        found = true
      end
    end
    if not found
      merged.names.push(names[i])
      merged.times.push(times[i])
    end
  end
  var sorted_names = _qspec_sort_strings(merged.names)
  var sb = sb_new()
  for i in 0..sorted_names.size
    var value = 0
    for j in 0..merged.names.size
      if merged.names[j] == sorted_names[i]
        value = merged.times[j]
      end
    end
    sb_append(sb, sorted_names[i])
    sb_append(sb, "\t")
    sb_append(sb, str_from_int(value))
    sb_append(sb, "\n")
  end
  mkdir_p(path_dir(path))
  var tmp = "#{path}.tmp"
  rm(tmp)
  write_file(tmp, sb_to_string(sb))
  var publish_error = rename(tmp, path)
  if publish_error != 0
    rm(tmp)
    eputs(color_yellow("qspec: duration history atomic publication failed"))
  end
end

## Reorder spec_files longest-first (LPT scheduling): a slow spec must
## not land last and serialize the parallel tail. Specs with no recorded
## duration sort to the front — an unknown spec might be slow, and a slow
## spec at the front costs nothing while one at the tail costs the suite.
def _qspec_order_by_duration(spec_files: Vec<String>, cache: DurationCache): Vec<String>
  var count = spec_files.size
  var keys = vec_new<Int>()
  for i in 0..count
    var nm = basename_no_ext(spec_files[i], ".qz")
    var key = 2147483647
    for j in 0..cache.names.size
      if cache.names[j] == nm
        key = cache.times[j]
      end
    end
    keys.push(key)
  end
  var used = vec_new<Int>()
  for i in 0..count
    used.push(0)
  end
  var ordered = vec_new<String>()
  for rank in 0..count
    var max_key = -1
    var max_idx = -1
    for i in 0..count
      if used[i] == 0 and keys[i] > max_key
        max_key = keys[i]
        max_idx = i
      end
    end
    used.set(max_idx, 1)
    ordered.push(spec_files[max_idx])
  end
  return ordered
end

## Show first 20 lines of a file on stderr (for failure diagnostics).
def _qspec_show_output(path: String, name: String): Void
  if file_exists(path) == 0
    return
  end
  var output = sh_capture("head -20 #{path} 2>/dev/null")
  if str_byte_len(output) > 0
    eputs("")
    eputs(color_dim("    --- #{name} ---"))
    eputs(output)
  end
end

## Capture the same content _qspec_show_output would print, but as a string
## so callers can defer printing until after a Live region has been finalized.
def _qspec_capture_show(path: String, name: String): String
  if file_exists(path) == 0
    return ""
  end
  if not _qspec_shell_safe_path(path)
    return ""
  end
  var size = file_size(path)
  var output = sh_capture("head -c 16384 #{path} 2>/dev/null")
  if size > 16384
    output += "\n[output truncated at 16384 bytes]\n"
  end
  if str_byte_len(output) == 0
    return ""
  end
  var sb = sb_new()
  sb.append("\n")
  sb.append(color_dim("    --- #{name} ---"))
  sb.append("\n")
  sb.append(output)
  return sb.to_string()
end

## Check if IR contains markers for slow tests (network, TLS, spawn).
def _qspec_is_slow(ir_content: String): Bool
  if str_contains(ir_content, "SSL_CTX_new") == 1
    return true
  end
  if str_contains(ir_content, "httpbin") == 1
    return true
  end
  if str_contains(ir_content, "@qz_spawn") == 1
    return true
  end
  if str_contains(ir_content, "@__qz_sched_init") == 1
    return true
  end
  return false
end

## Slow-lane quarantine (R2, 2026-05-15). Each of these specs hangs or
## times out (>300s) in the suite — a hanging test is broken signal
## regardless of cause, so it must not gate the main lane. `quake qspec`
## excludes them; `quake qspec_slow` (QSPEC_SLOW=1) runs only them.
## Root-causing each hang is tracked separately under INC.1 R-plan.
def _qspec_quarantined_names(): Vec<String>
  var q = vec_new<String>()
  if env_get("QSPEC_RUNNER_TEST") == "1"
    q.push("quarantine")
  end
  q.push("actor_spec")
  q.push("actor_supervisor_spec")
  q.push("backpressure_spec")
  q.push("barrier_spec")
  q.push("broadcast_channel_spec")
  q.push("buffered_net_spec")
  q.push("https_spec")
  q.push("macro_hygiene_spec")
  q.push("tls_spec")
  return q
end

def _qspec_is_quarantined(spec_file: String): Bool
  var name = basename_no_ext(spec_file, ".qz")
  var q = _qspec_quarantined_names()
  for i in 0..q.size
    if q[i] == name
      return true
    end
  end
  return false
end

## Print the N slowest test files by execution time.
def _qspec_print_slowest(names: Vec<String>, times: Vec<Int>, n: Int): Void
  var count = names.size
  if count == 0
    return
  end
  var used = vec_new<Int>()
  for i in 0..count
    used.push(0)
  end
  var show = n
  if show > count
    show = count
  end
  eputs(color_dim("Slowest files:"))
  for rank in 0..show
    var max_time = -1
    var max_idx = -1
    for i in 0..count
      if used[i] == 0 and times[i] > max_time
        max_time = times[i]
        max_idx = i
      end
    end
    if max_idx >= 0
      used.set(max_idx, 1)
      var secs = max_time / 1000
      var ms = max_time % 1000
      eputs("  #{secs}.#{_qspec_pad3(ms)}s  #{names[max_idx]}")
    end
  end
end

# =============================================================================
# QSpec — Persistent-Worker Daemon Mode (Phase 5.0c, opt-in via QSPEC_DAEMON=1)
# =============================================================================
#
# **Status (2026-05-11): infrastructure only — no speedup yet.** This
# block ships the TCP/pool/dispatch plumbing as prerequisite for Phase
# 5.0f (frozen-stdlib base + per-request isolation). Without 5.0f,
# the persistent worker hard-crashes (SIGSEGV/SIGABRT) on its 4th
# compile request — the fsc-trap from docs/design/QUARTZD.md D5
# empirically reproduced 2026-05-11 with a single-worker smoke that
# 3 compiles green, 4th = no stderr, signal kill.
#
# So QSPEC_DAEMON=1 today is for protocol-path validation only.
# Subsets with <= num_workers * 3 specs run; full suites crash at
# request 4 per worker. Once 5.0f lands, this same runner code
# unlocks the projected 600s → 60s improvement without further
# Quakefile changes — the worker fix is invisible to the runner.
#
# When QSPEC_DAEMON=1, run_qspec swaps the per-spec posix_spawn compile
# step for a TCP round-trip to a pre-warmed `quartz --persistent-worker`
# subprocess. Each spec-runner goroutine owns one worker for the entire
# suite (1:1 pairing, no rebalancing), so dispatch can stay strictly
# serial per worker — matching the v0 limits in docs/design/QUARTZD.md.
# llc / link / run stages remain as posix_spawn invocations on the
# runner side; only `quartz --no-cache ... > ir` is replaced.
#
# Read first: docs/design/QUARTZD.md (D1 + D2 — single-client direct
# spawn over TCP loopback, no separate quartzd binary).
#
# v0 limits acknowledged here:
#   - Workers don't recycle (no stdlib-SHA hash check, no request-count
#     threshold). Phase 5.2 adds this. With Phase 5.0f's frozen base,
#     recycling becomes optional rather than mandatory.
#   - No in-flight cancel preemption — SIGINT relies on terminal pgroup
#     propagation killing the worker, which surfaces as TCP EOF in the
#     runner's _pw_compile.
#   - State accumulates across requests inside each worker (compiler
#     globals, cache_open, dep_graph). Phase 5.0f adds the frozen-stdlib
#     base refactor that closes the fsc-trap risk.
#   - Recycle hack alternative measured (K=3 per worker, ~50 LOC):
#     5s worker-warmup / 3 specs = 1.7s/spec overhead, vs serial's
#     ~50ms fork+exec. Daemon-with-recycle is SLOWER than serial.
#     Skipped — recycle isn't a speedup; it's just stability theater.

## A handle to a live persistent worker process. Each spec-runner
## goroutine owns one for the entire suite duration. Field mutation
## happens on the next_request_id counter only.
@repr(C)
struct PersistentWorker
  stream: TcpStream
  worker_handle: Int      # await-able from `go _pw_spawn(...)`
  worker_id: Int          # 0..N-1
  next_request_id: Int    # bumped per request
end

## The pool's collected state plus its TCP listener. Listener kept open
## past pool start so a future respawn path can reuse the same port
## (deferred — v0 doesn't respawn).
struct PoolHandle
  listener: TcpListener
  workers: Vec<PersistentWorker>
end

## Read exactly N bytes from a TCP stream. Binary-safe — uses raw
## socket_recv into a malloc'd buffer, then materializes a Quartz
## string via cptr_to_string_with_len so embedded NUL bytes in length
## prefixes survive. Returns "" on EOF or socket error.
##
## Sister implementation lives in self-hosted/quartz.qz's _pworker_*
## and spec/qz/persistent_worker_ping_smoke.qz — three copies because
## std/net/tcp's tcp_read/tcp_write truncate at NUL (see
## feedback_tcp_read_write_truncate_at_nul). When B.8 phase 5/6
## rewrites tcp.qz to be binary-safe, collapse all three into one.
def _pw_read_exact(stream: TcpStream, n: Int): String
  if n <= 0
    return ""
  end
  var buf = qz_malloc(n)
  if buf == 0
    return ""
  end
  var got = 0
  while got < n
    var bytes = socket::socket_recv(stream.fd, buf + got, n - got, 0)
    if bytes <= 0
      mem_free(buf)
      return ""
    end
    got = got + bytes
  end
  var s = cptr_to_string_with_len(buf, n)
  mem_free(buf)
  return s
end

## Read one length-prefixed frame. Returns the FULL frame (4-byte
## prefix + body) so callers hand it directly to decode_response.
## Returns "" on EOF / partial frame.
def _pw_read_frame(stream: TcpStream): String
  var prefix = _pw_read_exact(stream, 4)
  if str_byte_len(prefix) != 4
    return ""
  end
  var body_len = read_frame_length(prefix)
  if body_len < 0
    return ""
  end
  if body_len == 0
    return prefix
  end
  var body = _pw_read_exact(stream, body_len)
  if str_byte_len(body) != body_len
    return ""
  end
  return prefix + body
end

## Binary-safe write — bypasses tcp_write's strdup-truncation.
def _pw_write_all(stream: TcpStream, data: String): Int
  var total = str_byte_len(data)
  if total == 0
    return 0
  end
  var ptr = str_to_ptr(data)
  var sent = 0
  while sent < total
    var n = socket::socket_send(stream.fd, ptr + sent, total - sent, 0)
    if n < 0
      return -1
    end
    sent = sent + n
  end
  return sent
end

## Spawn one worker subprocess. Run inside a goroutine so the main
## thread can simultaneously enter tcp_accept(). 2>/dev/null mutes
## worker startup noise; per-request stderr capture happens via the
## stderr_path field on each WorkRequest.
def _pw_spawn(compiler: String, port: Int): Int
  var cmd = "#{compiler} --persistent-worker --connect-port=#{port.to_s()} 2>/dev/null"
  return posix_spawn_wait(cmd)
end

## Build a pool of N persistent workers connected back over TCP loopback.
## Spawns are issued in goroutines so all N can race-connect; main accepts
## them in arrival order. Workers are interchangeable so order doesn't
## matter; we just zip accepted streams with the goroutine handles by
## index.
def _pw_pool_start(num_workers: Int, compiler: String): PoolHandle
  var listen_result = tcp_listen(0)
  match listen_result
    ListenResult::Err(e) => {
      fail("persistent-worker pool: tcp_listen failed: #{e.message}")
    }
    ListenResult::Ok(listener) => {
      var port = listener.port

      var handles = vec_new<Int>()
      var i = 0
      while i < num_workers
        handles.push(go _pw_spawn(compiler, port))
        i = i + 1
      end

      var workers = vec_new<PersistentWorker>()
      var w = 0
      while w < num_workers
        var accept_result = tcp_accept(listener)
        match accept_result
          AcceptResult::Err(e) => {
            fail("persistent-worker pool: tcp_accept failed at worker #{w}: #{e.message}")
          }
          AcceptResult::Ok(stream) => {
            workers.push(PersistentWorker {
              stream: stream,
              worker_handle: handles[w],
              worker_id: w,
              next_request_id: 1,
            })
          }
        end
        w = w + 1
      end

      return PoolHandle { listener: listener, workers: workers }
    }
  end
  # unreachable — both match arms either return or fail
  return PoolHandle { listener: tcp_listener(0, 0), workers: vec_new<PersistentWorker>() }
end

## Drain the pool cleanly. Done in two phases to avoid a pairing-induced
## deadlock: `accept[i]` is paired with `handles[i]` by INDEX, not by
## which subprocess actually connected to which stream — TCP accept
## returns connections in arrival order, but `go _pw_spawn(...)` futures
## complete when THEIR spawned process exits. If we send-shutdown-then-
## await per worker in a single loop, await on workers[0].handle can
## block waiting for the process whose stream is workers[K].stream
## (K != 0), which we haven't shut down yet → deadlock.
##
## Two-phase fix: first send REQ_SHUTDOWN to every stream + drain acks +
## close every stream; THEN await every handle. Both phases are
## monotone in the "alive workers" set so neither blocks indefinitely.
def _pw_pool_shutdown(pool: PoolHandle): Void
  var n = pool.workers.size
  var i = 0
  while i < n
    var w = pool.workers[i]
    var req = WorkRequest {
      request_id: w.next_request_id,
      kind: REQ_SHUTDOWN(),
      argv: vec_new<String>(),
      cwd: "",
      path_env: "",
      stderr_path: "",
    }
    var encoded = encode_request(req)
    var _wn = _pw_write_all(w.stream, encoded)
    var _frame = _pw_read_frame(w.stream)
    var _close = tcp_close(w.stream)
    i = i + 1
  end
  var j = 0
  while j < n
    var w2 = pool.workers[j]
    var _wait = await w2.worker_handle
    j = j + 1
  end
  var _wl = tcp_close_listener(pool.listener)
end

## Build the argv vector the persistent worker expects for a compile
## request. Mirrors the `compile_base` shell command in _qspec_run_one
## minus the redirects (worker handles stderr via stderr_path; ir goes
## to --ir-output PATH instead of stdout).
def _pw_build_compile_argv(spec_file: String, ir_path: String): Vec<String>
  var argv = vec_new<String>()
  argv.push("--no-cache")
  argv.push("-I"); argv.push("std")
  argv.push("-I"); argv.push(".")
  argv.push("-I"); argv.push("self-hosted/shared")
  argv.push("-I"); argv.push("self-hosted/frontend")
  argv.push("-I"); argv.push("self-hosted/middle")
  argv.push("-I"); argv.push("self-hosted/backend")
  argv.push("-I"); argv.push("spec/qspec/fixtures")
  argv.push(spec_file)
  argv.push("--ir-output"); argv.push(ir_path)
  return argv
end

## Send a compile request to `worker` and read the response. Bumps
## worker.next_request_id. Returns the decoded WorkResponse; on
## TCP-level failure (worker died mid-request — e.g. terminal SIGINT
## hit the worker pgroup) returns a synthetic error response with
## exit_code=-1 so the caller can distinguish worker death from
## compile failure.
def _pw_compile(worker: PersistentWorker, spec_file: String, ir_path: String, err_path: String): WorkResponse
  var req = WorkRequest {
    request_id: worker.next_request_id,
    kind: REQ_COMPILE(),
    argv: _pw_build_compile_argv(spec_file, ir_path),
    cwd: "",
    path_env: "",
    stderr_path: err_path,
  }
  worker.next_request_id = worker.next_request_id + 1

  var encoded = encode_request(req)
  var written = _pw_write_all(worker.stream, encoded)
  if written < 0
    return _pw_dead_response(req.request_id, "worker write failed (worker died?)")
  end

  var frame = _pw_read_frame(worker.stream)
  if str_byte_len(frame) == 0
    return _pw_dead_response(req.request_id, "worker read returned EOF (worker died?)")
  end
  var dec = decode_response(frame)
  if dec.ok == false
    return _pw_dead_response(req.request_id, "worker response decode failed: #{dec.error_msg}")
  end
  return dec.response
end

def _pw_dead_response(request_id: Int, msg: String): WorkResponse
  return WorkResponse {
    request_id: request_id,
    status: RESP_ERROR(),
    exit_code: -1,
    stdout: "",
    stderr: msg,
    stderr_path: "",
    ir_path: "",
    duration_ms: 0,
  }
end

# =============================================================================
# QSpec Single-File Runner
# =============================================================================

## Run a single QSpec file with full diagnostics.
## Usage: quake qspec_file FILE=spec/qspec/foo_spec.qz
def run_qspec_file(): Void
  var spec_file = env_get("FILE")
  if str_byte_len(spec_file) == 0
    fail("Usage: quake qspec_file FILE=spec/qspec/foo_spec.qz")
  end

  var compiler = compiler_path()
  if exists(compiler) == 0
    fail("Compiler not found at #{compiler}")
  end

  # Set PATH to include LLVM (Homebrew on macOS, system on Linux)
  var current_path = env_get("PATH")
  env("PATH", "#{_llvm_path_prefix()}#{current_path}")
  env("QUARTZ_COMPILER", compiler)
  env("QUARTZ_STD", "std")
  env("QUARTZ_FIXTURES", "spec/qspec/fixtures")
  var lli = find_lli()
  env("QUARTZ_LLI", lli)

  var ownership = _qspec_allocate_run()
  defer rm_rf(ownership.run_dir)
  var timeout_str = _qspec_bounded_decimal(env_get("QSPEC_TIMEOUT"), "300", 1, 3600, "QSPEC_TIMEOUT")
  var compile_timeout_str = _qspec_bounded_decimal(env_get("QSPEC_COMPILE_TIMEOUT"), "120", 1, 3600, "QSPEC_COMPILE_TIMEOUT")
  var tool_timeout_str = _qspec_bounded_decimal(env_get("QSPEC_TOOL_TIMEOUT"), "60", 1, 3600, "QSPEC_TOOL_TIMEOUT")
  var selected_paths = vec_new<String>()
  selected_paths.push(spec_file)
  var selected_hashes = vec_new<String>()
  selected_hashes.push(content_hash::content_hash_file(spec_file))
  var ctx = SpecCtx {
    compiler: compiler,
    session_id: ownership.id,
    lli: lli,
    timeout_str: timeout_str,
    compile_timeout_str: compile_timeout_str,
    tool_timeout_str: tool_timeout_str,
    fast_mode: false,
    cache_flags: "--no-cache",
    result_dir: ownership.result_dir,
    run_dir: ownership.run_dir,
    cancel_path: "#{ownership.run_dir}/cancel",
    selected_paths: selected_paths,
    selected_hashes: selected_hashes,
  }
  var result = _qspec_run_one(spec_file, ctx, 0)
  puts("")
  if result.outcome == OUTCOME_PASSED() or result.outcome == OUTCOME_SKIPPED()
    puts("#{color_green("PASS")} (#{result.file_time_ms}ms, #{result.execution_mode})")
  else
    puts("#{color_red("FAIL")} (#{result.file_time_ms}ms, #{result.execution_mode}): #{result.reason}")
    if str_byte_len(result.captured) > 0
      eputs(result.captured)
    end
    rm_rf(ownership.run_dir)
    exit(1)
  end
  rm_rf(ownership.run_dir)
end

def find_lli(): String
  # Try common LLVM paths (Homebrew on macOS, system on Linux)
  var paths = vec_new<String>()
  paths.push("/opt/homebrew/opt/llvm/bin/lli")
  paths.push("/opt/homebrew/opt/llvm@20/bin/lli")
  paths.push("/usr/bin/lli")
  paths.push("/usr/lib/llvm-20/bin/lli")
  paths.push("/usr/lib/llvm-19/bin/lli")
  paths.push("/usr/lib/llvm-18/bin/lli")

  var count = paths.size
  for i in 0..count
    if file_exists(paths[i]) == 1
      return paths[i]
    end
  end

  # Try which
  var handle = pipe_open("which lli 2>/dev/null", "r")
  if handle != 0
    var path = fread(handle, 4096)
    pipe_close(handle)
    if str_byte_len(path) > 1
      return str_byte_slice(path, 0, str_byte_len(path) - 1)
    end
  end

  return ""
end

# =============================================================================
# Snapshot Runner
# =============================================================================

def run_snapshots(update_mode: Int): Void
  var compiler = compiler_path()
  if exists(compiler) == 0
    fail("Compiler not found at #{compiler}")
  end

  var snapshot_dir = "spec/snapshots"
  mkdir_p(snapshot_dir)
  mkdir_p("#{snapshot_dir}/sources")

  var sources = vec_new<String>()
  sources.push("spec/snapshots/sources/hello.qz")
  sources.push("spec/snapshots/sources/fibonacci.qz")
  sources.push("spec/snapshots/sources/array_ops.qz")

  var failures = 0
  var count = sources.size
  for i in 0..count
    var src = sources[i]
    if exists(src) == 0
      # skip missing
    else
      var name = basename_no_ext(src, ".qz")
      var snapshot = "#{snapshot_dir}/#{name}.ll"
      # --no-cache for determinism: warm .quartz-cache emits "(incremental)"
      # fragments with a different inline-helper set, making the snapshot test
      # nondeterministic. Snapshots are cold whole-program IR.
      var actual = sh_capture("#{compiler} --no-cache #{src} 2>&1")

      if update_mode == 1
        var _w = write_file(snapshot, actual)
        puts("Updated: #{snapshot}")
      else
        if exists(snapshot) == 0
          puts("NEW: #{name} — no snapshot yet (run quake snapshots:update)")
        else
          var expected = read_file(snapshot)
          if actual == expected
            puts(color_green("PASS: #{name}"))
          else
            puts(color_red("FAIL: #{name} — IR differs from snapshot"))
            failures = failures + 1
          end
        end
      end
    end
  end

  if failures > 0
    fail("#{failures} snapshot(s) failed")
  end
end

def basename_no_ext(path: String, ext: String): String
  # Get the basename first
  var base = path
  var last_slash = -1
  var plen = str_byte_len(path)
  for i in 0..plen
    if str_byte_at(path, i) == '/'
      last_slash = i
    end
  end
  if last_slash >= 0
    base = str_byte_slice(path, last_slash + 1, plen)
  end
  # Strip extension
  var blen = str_byte_len(base)
  var elen = str_byte_len(ext)
  if blen > elen
    var suffix = str_byte_slice(base, blen - elen, blen)
    if suffix == ext
      return str_byte_slice(base, 0, blen - elen)
    end
  end
  return base
end
