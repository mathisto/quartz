  task("repl", "Start interactive Quartz REPL") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("REPL requires compiler at #{compiler}. Run 'quake build' first.")
    end
    # Use integrated REPL subcommand (replaces tools/repl.qz)
    var r = sh_maybe("#{compiler} repl")
  end

  # ---- Marketing Site ----

  task("site:dev", "Build and run marketing site server natively") do ->
    var compiler = compiler_path()
    mkdir_p("tmp")
    step("Compiling site/server.qz") do ->
      sh("#{compiler} --no-opt -I . site/server.qz > tmp/site.ll 2>tmp/site.err")
    end
    step("Assembling") do ->
      sh("llc -filetype=obj tmp/site.ll -o tmp/site.o")
    end
    step("Linking") do ->
      sh("/usr/bin/clang tmp/site.o -o site/server -Wl,-stack_size,0x2000000 -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto")
    end
    puts("Starting server on http://localhost:8080")
    var r = sh_maybe("cd site && ./server")
  end

  task("site:build", "Cross-compile marketing site for Linux x86_64") do ->
    var compiler = compiler_path()
    mkdir_p("tmp")
    step("Cross-compiling site/server.qz → site/server.ll") do ->
      sh("#{compiler} --no-cache --no-opt --target x86_64-unknown-linux-gnu -I . site/server.qz > site/server.ll.raw 2>tmp/site.err")
    end
    step("Deduplicating IR declarations") do ->
      sh("perl -ne 'print unless /^declare / && $seen{$_}++' site/server.ll.raw > site/server.ll && rm site/server.ll.raw")
    end
    puts(color_green("Built: site/server.ll"))
  end

  task("site:docker", "Build Docker image for marketing site") do ->
    var compiler = compiler_path()
    mkdir_p("tmp")
    step("Cross-compiling site/server.qz → site/server.ll") do ->
      sh("#{compiler} --no-cache --no-opt --target x86_64-unknown-linux-gnu -I . site/server.qz > site/server.ll.raw 2>tmp/site.err")
    end
    step("Deduplicating IR declarations") do ->
      sh("perl -ne 'print unless /^declare / && $seen{$_}++' site/server.ll.raw > site/server.ll && rm site/server.ll.raw")
    end
    step("Building Docker image") do ->
      sh("docker build -t quartz-site -f site/Dockerfile .")
    end
    puts(color_green("Image built: quartz-site"))
    puts("Run with: docker run -p 8080:8080 quartz-site")
  end

  # ---- Documentation ----

  task("docs", "Generate API documentation") do ->
    var compiler = compiler_path()
    if exists(compiler) == 0
      fail("Compiler not found at #{compiler}")
    end
    mkdir_p("tmp")
    step("Compiling doc generator") do ->
      sh("#{compiler} -I self-hosted/frontend -I self-hosted/shared -I std tools/doc.qz 2>/dev/null > tmp/_doc.ll")
    end
    step("Linking doc generator") do ->
      sh("llc -filetype=obj tmp/_doc.ll -o tmp/_doc.o && clang tmp/_doc.o -o tmp/_doc -lm")
    end
    step("Generating documentation") do ->
      sh("tmp/_doc --src std --output docs/api")
