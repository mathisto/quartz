##! # Type Checker Registry
##!
##! Type, function, struct, enum, trait, and impl registries
##! for the Quartz type checker.

import typecheck_util
import typecheck_diag
import compiler_types
import node_constants
import type_constants
import string_intern
import diagnostic
import ast
import qzmod_load
import qzmod_emit
import qzmod_format
import mir
import dep_graph
import content_hash
import * from str_compat
import std/diag
import std/intern

# Module-level parallel intern ID vectors for accelerated name lookups.
# Populated alongside Vec<String> name vectors in tc_register_* functions.
# Enables O(1) integer comparison instead of O(n) string comparison in
# tc_lookup_struct/enum/function_return exact-match paths.
var g_struct_name_ids = vec_new()
var g_enum_name_ids = vec_new()
var g_func_name_ids = vec_new()
var g_trait_name_ids = vec_new()
var g_impl_trait_name_ids = vec_new()
var g_impl_for_type_ids = vec_new()

var _g_suffix_cache_ptr = 0

## Build "$name" suffix. Used for fallback function lookups.
##
## Caching disabled — same use-after-free pattern as `string_intern::mangle`.
## See that function and ROADMAP entry "string_intern::mangle dedup cache"
## for the rationale and the planned world-class fix.
def _cached_suffix(tc: TypecheckState, name: String): String = "$#{name}"

## Phase 5.5 · P5.5.c Pass 2b: registry-side intern dispatch via the
## prelude-installed default `Intern` handler.
##
## All `tc_register_*` and `tc_lookup_*` sites in this module call
## `intern(name)` / `resolve(id)` directly. The Pass 2a prelude
## install (`@__qz_default_intern_handler` registered in `@main`)
## catches these performs, and blessed-relaxation lets the typecheck
## skip the explicit `can Intern` annotation. Outer callers wrapping
## `compile()` with `with Intern { intern: my_mock } do -> ... end`
## now override the registry's interning end-to-end (per the
## standard H-delegate top-down scan); the per-site body-wraps that
## previously shadowed those overrides are gone.
##
## Migration history: P5.5.a introduced the `_tc_intern` /
## `_tc_resolve` helpers per-site (necessary because the pre-Pass-2a
## bootstrap compiler didn't yet know about Intern blessed-relaxation
## or emit the prelude install). P5.5.c Pass 2a added both the
## blessed relaxation (`0e3d1d4c`) AND the prelude install
## (`2d7eadbb`); Pass 2b drops the helpers now that the runtime is
## in place. Effect-stack overflow asymmetry (`a6f174ae`) had to be
## fixed first because nested registry calls reached depth 33 during
## self-compile, exceeding the previous 32-cap.

## Reset all interned name ID vectors.
## Called at the start of each typecheck run to clear stale state.
##
## Persistent-worker note: every global freed by `tc_registry_free_intern_ids`
## must be re-bound here. Skipping a global leaves a dangling pointer that
## the next compile's `vec_free` will treat as a double-free — the
## fsc-trap that crashes long-lived workers (see docs/design/QUARTZD.md D5).
def tc_registry_reset_intern_ids(): Void
  g_struct_name_ids = vec_new()
  g_enum_name_ids = vec_new()
  g_func_name_ids = vec_new()
  g_trait_name_ids = vec_new()
  g_impl_trait_name_ids = vec_new()
  g_impl_for_type_ids = vec_new()
  g_send_checking = vec_new<String>()
  g_sync_checking = vec_new<String>()
end

## Free all interned name ID vectors.
## Called during tc_free to release lookup acceleration memory.
def tc_registry_free_intern_ids(): Void
  vec_free(g_struct_name_ids)
  vec_free(g_enum_name_ids)
  vec_free(g_func_name_ids)
  vec_free(g_trait_name_ids)
  vec_free(g_impl_trait_name_ids)
  vec_free(g_impl_for_type_ids)
  vec_free(g_send_checking)
  vec_free(g_sync_checking)
end


# ============================================================================
# Function Registry
# ============================================================================

## Register a function signature.
##
## Parameters:
##   tc             - Type checker context
##   name           - Function name
##   param_types    - Vector of parameter type kinds
##   return_type    - Return type kind
##   required_count - Number of required parameters (without defaults)
def tc_register_function(tc: TypecheckState, name: String, param_types: Vec<Int>, return_type: Int, required_count: Int): Void
  var func_names = tc.registry.func_names
  var func_param_types = tc.registry.func_param_types
  var func_return_types = tc.registry.func_return_types
  var func_required_counts = tc.registry.func_required_counts
  var func_return_annotations = tc.registry.func_return_annotations

  func_names.push(name)
  g_func_name_ids.push(intern(name))
  func_param_types.push(param_types)
  func_return_types.push(return_type)
  func_required_counts.push(required_count)
  func_return_annotations.push("")
  # Push empty Fn annotations for builtin/non-annotated functions
  tc.registry.func_param_fn_annotations.push(vec_new())
  # Push empty trait constraint data (overwritten by tc_register_function_signature_named)
  tc.registry.func_type_params.push("")
  tc.registry.func_type_param_bounds.push("")
  tc.registry.func_param_annotations.push("")
  # Push empty named arg data (overwritten by tc_register_function_signature_named)
  tc.registry.func_param_names.push("")
  tc.registry.func_ast_stores.push(0)
  tc.registry.func_ast_handles.push(0)
  # Push no borrow summary (None = no summary, overwritten by tc_generate_borrow_summary)
  tc.registry.func_borrow_summaries.push(Option::None)
  # Effect row default: -1 = untracked. Overwritten by tc_set_func_effect_row
  # at function-signature time when a `can` clause is present.
  tc.registry.func_effect_row_idx.push(-1)
  # P3.F.2: Generalized row-vars default to empty — only functions with
  # lowercase type-params (F.1) have entries here; populated by
  # tc_set_func_generalized_ervs after the signature's env is built.
  tc.registry.func_generalized_ervs.push(vec_new())
end

## P4.D.4b: Update a function's registered return type by index. Used by
## tc_function to swap the bare TYPE_STRUCT sentinel that `impl Trait`
## annotations parse to for a richer ptype (e.g. Stream<T, body_row>) once
## the body row has been finalized. Out-of-range indices are silently
## ignored so callers can pass `cur_func_idx_b7` without a guard.
def tc_set_func_return_type(tc: TypecheckState, func_idx: Int, type_id: Int): Void
  if func_idx < 0 or func_idx >= tc.registry.func_return_types.size
    return
  end
  tc.registry.func_return_types[func_idx] = type_id
end

## Look up a function's return type.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: Return type kind, or type_constants$TYPE_ERROR if not found
def tc_lookup_function_return(tc: TypecheckState, name: String): Int
  var func_names = tc.registry.func_names
  var func_return_types = tc.registry.func_return_types

  var count = func_names.size
  # Last-wins scan: local functions registered after imports shadow them
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      return func_return_types[i]
    end
    i -= 1
  end

  # Fallback: search for function ending with $name (internal module call)
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          return func_return_types[i]
        end
      end
    end
  end

  return type_constants::TYPE_ERROR
end

## Phase 4D.6: Look up a function's return type annotation string by registry index.
## Returns the annotation (e.g., "impl Iterator<Int>") or "" if idx is out-of-range.
## Used by `_tc_current_func_is_generator` to replace the legacy `tc.reserved[0]`
## generator-context cache.
def tc_get_func_return_annotation(tc: TypecheckState, func_idx: Int): String
  if func_idx < 0 or func_idx >= tc.registry.func_return_annotations.size
    return ""
  end
  return tc.registry.func_return_annotations[func_idx]
end

## Look up a function's return type annotation string.
## Returns the annotation (e.g., "TypecheckState") or "" if not found.
def tc_lookup_function_return_annotation(tc: TypecheckState, name: String): String
  var func_names = tc.registry.func_names
  var func_return_annotations = tc.registry.func_return_annotations

  var count = func_names.size
  # Last-wins scan: local functions registered after imports shadow them
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      var ann = func_return_annotations[i]
      if str_byte_len(ann) > 0
        return ann
      end
      return ""
    end
    i -= 1
  end

  # Fallback: search for function ending with $name
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          var ann = func_return_annotations[i]
          if str_byte_len(ann) > 0
            return ann
          end
          return ""
        end
      end
    end
  end

  return ""
end

## Look up a function's parameter types.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: Some(vector of param types), or None if not found
def tc_lookup_function_params(tc: TypecheckState, name: String): Option<Vec<Int>>
  var func_names = tc.registry.func_names
  var func_param_types = tc.registry.func_param_types

  var count = func_names.size
  # Last-wins scan: local functions registered after imports shadow them
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      return Option::Some(func_param_types[i])
    end
    i -= 1
  end

  # Fallback: search for function ending with $name (internal module call)
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          return Option::Some(func_param_types[i])
        end
      end
    end
  end

  return Option::None
end

## Get number of parameters for a function.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: Parameter count, or -1 if not found
def tc_function_param_count(tc: TypecheckState, name: String): Int
  var params = tc_lookup_function_params(tc, name)
  return -1 if params.is_none()
  return params.unwrap().size
end

## Look up Fn annotations for a function's parameters.
## Returns a Vec<Int> of annotations (0 for non-Fn params, as_int(string) for Fn params).
## Returns 0 if function not found.
def tc_lookup_function_param_fn_ann(tc: TypecheckState, name: String): Int
  var func_names = tc.registry.func_names
  var fn_anns = tc.registry.func_param_fn_annotations
  var count = func_names.size
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      return fn_anns[i]
    end
    i -= 1
  end
  # Fallback: search for function ending with $name
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          return fn_anns[i]
        end
      end
    end
  end
  return 0
end

## Get number of required parameters for a function.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: Required parameter count, or -1 if not found
def tc_function_required_count(tc: TypecheckState, name: String): Int
  var func_names = tc.registry.func_names
  var func_required_counts = tc.registry.func_required_counts
  
  var count = func_names.size
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      return func_required_counts[i]
    end
    i -= 1
  end

  return -1
end

## Find an arity overload of a function that matches the given argument count.
## Scans all registered functions for one with the same name whose arity range
## includes arg_count. Returns the index in tc.registry.func_names, or -1 if none found.
def tc_find_matching_overload(tc: TypecheckState, name: String, arg_count: Int): Int
  var func_names = tc.registry.func_names
  var func_param_types = tc.registry.func_param_types
  var func_required_counts = tc.registry.func_required_counts

  var count = func_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_func_name_ids[i] == name_id
      var pc = tc_overload_param_count(func_param_types, i)
      var rc = func_required_counts[i]
      if rc < 0
        rc = pc
      end
      if arg_count >= rc and arg_count <= pc
        return i
      end
    end
  end

  # Fallback: suffix match for module-prefixed calls
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          var pc = tc_overload_param_count(func_param_types, i)
          var rc = func_required_counts[i]
          if rc < 0
            rc = pc
          end
          if arg_count >= rc and arg_count <= pc
            return i
          end
        end
      end
    end
  end

  return -1
end

def tc_overload_param_count(func_param_types: Vec<Vec<Int>>, idx: Int): Int
  var params = func_param_types[idx]
  if params == 0
    return 0
  end
  return params.size
end

# ============================================================================
# Struct Registry
# ============================================================================

## Register a struct definition.
##
## Parameters:
##   tc          - Type checker context
##   name        - Struct name
##   field_names - Vector of field name strings
##   field_types - Vector of field type kinds
def tc_register_struct(tc: TypecheckState, name: String, field_names: Vec<String>, field_types: Vec<Int>, type_params: String, field_annotations: Vec<String>, is_linear: Int, field_defaults: Vec<Int>): Void
  var struct_names = tc.registry.struct_names
  var struct_field_names = tc.registry.struct_field_names
  var struct_field_types = tc.registry.struct_field_types
  var struct_type_params = tc.registry.struct_type_params
  var struct_field_annotations = tc.registry.struct_field_annotations

  struct_names.push(name)
  g_struct_name_ids.push(intern(name))
  struct_field_names.push(field_names)
  struct_field_types.push(field_types)
  struct_type_params.push(type_params)
  struct_field_annotations.push(field_annotations)
  tc.registry.struct_is_linear.push(is_linear)
  # V3 (§14.12.5) — @value flag defaults to 0; tc_mark_struct_value (called from
  # tc_register_struct_def with the AST is_value flag) overwrites it for genuine
  # `@value` structs. Keeping this a post-registration setter (mirroring
  # tc_mark_struct_binary_dsl) avoids touching tc_register_struct's signature and
  # its qzmod/test callers.
  tc.registry.struct_is_value.push(0)
  # R1.1 (PF3 Family-3 opt-out) — @repr(C) flag defaults to 0; tc_mark_struct_repr_c
  # (called from tc_register_struct_def with the AST repr_c flag) overwrites it for
  # genuine `@repr(C)` structs. Same post-registration-setter idiom as struct_is_value.
  tc.registry.struct_repr_c.push(0)
  tc.registry.struct_field_defaults.push(field_defaults)
  # Binary DSL parallels default to 0/0; overridden by
  # tc_mark_struct_binary_dsl for binary blocks and packed structs.
  tc.registry.struct_dsl_kind.push(0)
  tc.registry.struct_dsl_backing.push(0)
  # P4.D.1: Row-var parallels default to empty; overridden by
  # tc_set_struct_row_vars when tc_register_struct_def detects
  # lowercase-first type-param names.
  tc.registry.struct_row_var_names.push(vec_new<String>())
  tc.registry.struct_row_var_ids.push(vec_new<Int>())
end

## Phase 1.4.c.2.b — overwrite a struct's body fields after the slot was
## allocated empty. Used by qzmod inject's pre-register pass: the slot is
## pushed name-only so `tc_lookup_struct(name)` resolves to a stable
## consumer-local struct_idx during `qzmod_build_ptype_remap`'s
## TYPE_VEC/SLICE/SLICE_MUT arg2 rewrite; then this helper fills in the
## decoded body. Out-of-range indices are silent no-ops (Principle #6).
def tc_update_struct_fields(tc: TypecheckState, struct_idx: Int, field_names: Vec<String>, field_types: Vec<Int>, type_params: String, field_annotations: Vec<String>, is_linear: Int): Void
  if struct_idx < 0 or struct_idx >= tc.registry.struct_names.size
    return
  end
  tc.registry.struct_field_names[struct_idx] = field_names
  tc.registry.struct_field_types[struct_idx] = field_types
  tc.registry.struct_type_params[struct_idx] = type_params
  tc.registry.struct_field_annotations[struct_idx] = field_annotations
  tc.registry.struct_is_linear[struct_idx] = is_linear
end

## Phase 1.4.c.2.b — overwrite an enum's body after the slot was allocated
## empty. Mirror of `tc_update_struct_fields` for enum injection.
##
## `variant_payloads` is `Vec<Vec<Int>>` (outer per-variant, inner per
## payload type id). `variant_field_annotations` is also a 3-D shape
## under the registry slot: `Vec<Vec<String>>` per enum (outer per
## variant, inner per payload-field annotation). Producer ships these
## via the matching 3-D encoder (`_qzmod_emit_anns_3d`) and loader
## (`_qzmod_load_anns_3d`); writing them back here restores the shape
## `tc_bind_pattern_variables` expects.
def tc_update_enum_variants(tc: TypecheckState, enum_idx: Int, variant_names: Vec<String>, variant_payloads: Vec<Vec<Int>>, type_params: String, variant_field_annotations: Vec<Vec<String>>): Void
  if enum_idx < 0 or enum_idx >= tc.registry.enum_names.size
    return
  end
  tc.registry.enum_variant_names[enum_idx] = variant_names
  tc.registry.enum_variant_payloads[enum_idx] = variant_payloads
  tc.registry.enum_type_params[enum_idx] = type_params
  tc.registry.enum_variant_field_annotations[enum_idx] = variant_field_annotations
end

## P4.D.1: Override the row-var name + erv lists for a registered struct.
## Called by tc_register_struct_def after collecting lowercase-first type
## params. Mirrors tc_set_trait_generalized_ervs (P3.F.3a).
def tc_set_struct_row_vars(tc: TypecheckState, struct_idx: Int, names: Vec<String>, ids: Vec<Int>): Void
  if struct_idx < 0 or struct_idx >= tc.registry.struct_row_var_names.size
    return
  end
  tc.registry.struct_row_var_names[struct_idx] = names
  var copy = vec_new<Int>()
  for i in 0..ids.size
    copy.push(ids[i])
  end
  tc.registry.struct_row_var_ids[struct_idx] = copy
end

## P4.D.1: Read the row-var ids declared on a struct's generic params.
## Returns an empty vec for structs with no row-var params. Future
## struct-method body checks load these into tc.func_row_var_* via the
## same protocol used by trait method bodies.
def tc_struct_row_var_ids(tc: TypecheckState, struct_idx: Int): Vec<Int>
  if struct_idx < 0 or struct_idx >= tc.registry.struct_row_var_ids.size
    return vec_new<Int>()
  end
  return tc.registry.struct_row_var_ids[struct_idx]
end

## P4.D.1: Read the row-var names declared on a struct's generic params.
def tc_struct_row_var_names(tc: TypecheckState, struct_idx: Int): Vec<String>
  if struct_idx < 0 or struct_idx >= tc.registry.struct_row_var_names.size
    return vec_new<String>()
  end
  return tc.registry.struct_row_var_names[struct_idx]
end

## P4.D.1: Look up the kind of a struct generic param by name.
##   0 = type variable, 1 = row variable, -1 = name is not a param of this struct.
## Used by future struct-method body checks (4D.2) and call-site
## instantiation. Row-var lookup wins over the comma-separated type-param
## string match — `struct Stream<T, e>` reports kind=1 for "e".
def tc_struct_type_param_kind(tc: TypecheckState, struct_idx: Int, name: String): Int
  if struct_idx < 0 or struct_idx >= tc.registry.struct_row_var_names.size
    return -1
  end
  var row_names = tc.registry.struct_row_var_names[struct_idx]
  for i in 0..row_names.size
    if row_names[i] == name
      return 1
    end
  end
  var tp_str = tc.registry.struct_type_params[struct_idx]
  if str_byte_len(tp_str) == 0
    return -1
  end
  var parts = str_split(tp_str, ",")
  for j in 0..parts.size
    var part = parts[j]
    # Trim whitespace from str_split result. tc_is_type_param strips
    # spaces from the input csv before comparing; we match the same
    # contract here so callers don't need to pre-clean.
    var trimmed = part
    while str_byte_len(trimmed) > 0 and str_byte_at(trimmed, 0) == ' '
      trimmed = str_byte_slice(trimmed, 1, str_byte_len(trimmed))
    end
    while str_byte_len(trimmed) > 0 and str_byte_at(trimmed, str_byte_len(trimmed) - 1) == ' '
      trimmed = str_byte_slice(trimmed, 0, str_byte_len(trimmed) - 1)
    end
    if trimmed == name
      return 0
    end
  end
  return -1
end

## Tag an already-registered struct as a Binary DSL type.
## kind: 1 = binary block, 2 = packed struct(uN)
## backing: backing width for packed struct, 0 for binary block
def tc_mark_struct_binary_dsl(tc: TypecheckState, name: String, kind: Int, backing: Int): Void
  var struct_names = tc.registry.struct_names
  var count = struct_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_struct_name_ids[i] == name_id
      tc.registry.struct_dsl_kind[i] = kind
      tc.registry.struct_dsl_backing[i] = backing
      return
    end
  end
end

## V3 (§14.12.5) — record that a struct was declared `@value`. Called from
## tc_register_struct_def with the AST is_value flag. Mirror of
## tc_mark_struct_binary_dsl: a post-registration overwrite of the parallel
## struct_is_value vector (which tc_register_struct pushes as 0). The
## typecheck-layer equivalent of mir entry.is_value, so the QZ0221
## erased-@value-boundary diagnostic can key on a type id.
def tc_mark_struct_value(tc: TypecheckState, name: String, is_value: Int): Void
  return if is_value == 0
  var struct_names = tc.registry.struct_names
  var count = struct_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_struct_name_ids[i] == name_id
      tc.registry.struct_is_value[i] = is_value
      return
    end
  end
end

## R1.1 (PF3 Family-3 opt-out) — record that a struct was declared `@repr(C)`.
## Called from tc_register_struct_def with the AST repr_c flag. Mirror of
## tc_mark_struct_value: a post-registration overwrite of the parallel
## struct_repr_c vector (pushed as 0 by tc_register_struct). Read by the QZ0221
## erased-boundary diagnostic to positively exclude known-Boxed `@repr(C)` structs
## from the conservative flip-eligibility over-approximation.
def tc_mark_struct_repr_c(tc: TypecheckState, name: String, repr_c: Int): Void
  return if repr_c == 0
  var struct_names = tc.registry.struct_names
  var count = struct_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_struct_name_ids[i] == name_id
      tc.registry.struct_repr_c[i] = repr_c
      return
    end
  end
end

## R1.1 — 1 iff `t` resolves to a registered `@repr(C)` struct nominal type id.
## Companion exclusion for tc_is_value_layout_struct_type. Conservative: a
## non-struct / unresolved / out-of-range idx returns 0.
def tc_is_repr_c_struct_type(tc: TypecheckState, t: Int): Int
  var idx = typecheck::tc_struct_idx_from_type(t)
  if idx < 0 or idx >= tc.registry.struct_repr_c.size
    return 0
  end
  return tc.registry.struct_repr_c[idx]
end

## V3 (§14.12.5) — 1 iff `t` is a registered `@value` struct nominal type id.
## Conservative: a non-struct, an unresolved/generic type, or a plain struct all
## return 0. Single seam the QZ0221 erased-boundary diagnostic consults.
def tc_is_value_struct_type(tc: TypecheckState, t: Int): Int
  var idx = typecheck::tc_struct_idx_from_type(t)
  if idx < 0 or idx >= tc.registry.struct_is_value.size
    return 0
  end
  return tc.registry.struct_is_value[idx]
end

## V3 (§14.12.5) — 1 iff `name` is a registered `@value` struct (by nominal name).
## Companion to tc_is_value_struct_type for the common case where tc_expr collapses
## a local's type to bare TYPE_STRUCT (7) instead of the nominal STRUCT_TYPE_BASE+idx
## — the QZ0221 check recovers the struct name via tc_scope_lookup_struct_name and
## keys on it here. Empty name (non-struct binding) returns 0.
def tc_is_value_struct_name(tc: TypecheckState, name: String): Int
  return 0 if str_byte_len(name) == 0
  var count = tc.registry.struct_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_struct_name_ids[i] == name_id
      return 0 if i >= tc.registry.struct_is_value.size
      return tc.registry.struct_is_value[i]
    end
  end
  return 0
end

## F4b (§14.11.11 / f4-steps §3) — 1 iff a struct of type id `t` is value-LAYOUT
## for the purpose of the QZ0221 erased-boundary diagnostic. This GENERALIZES the
## QZ0221 keying from `is_value` (the `@value` marker) to ALSO cover plain structs
## that flip to value-layout once the F4 gate is live.
##
## Two clauses:
##   (1) `@value` structs — value-layout unconditionally (the original QZ0221 key).
##   (2) F4 gate LIVE + a concrete plain struct — once `mir_default_struct_value_live`
##       flips, an eligible plain struct becomes inline (≤16B = 1-2 registers) or
##       COW-refcounted (>16B); routing it through a conversion bridge (as_int/...)
##       truncates the inline payload or drops the refcount → UAF. Same hazard as a
##       `@value` struct, so the diagnostic must fire here too.
##
## SINGLE SOURCE OF TRUTH for the gate: this reads `mir::mir_default_struct_value_live()`
## DIRECTLY (typecheck_registry already imports `mir`), so there is NO parallel gate
## to drift out of lockstep with the backend (the §guard-drift hazard). The mir
## eligibility predicate (`mir_default_struct_value_eligible`) needs a populated
## MirContext that does not exist at typecheck time, so it cannot be consulted here;
## instead this CONSERVATIVELY over-approximates — it treats EVERY concrete plain
## struct as flip-eligible. Per §14.12.5 the diagnostic is forbid-don't-box with
## false-error OK / false-accept forbidden: over-firing on a struct that the backend
## would actually keep Boxed (recursive / @repr(C) / firewall-mixed) is the SAFE
## direction; the forbidden direction (letting a flipped struct cross the bridge
## unflagged) can never happen. Over-approximating also means this helper needs no
## second copy of the eligibility logic that could silently diverge from mir's.
##
## INERT at gate-0: `mir_default_struct_value_live()==0` short-circuits clause (2)
## ⇒ this returns exactly `is_value` ⇒ QZ0221 behavior is byte-identical to history.
## F4b — gate accessor so callers outside `typecheck_registry` (which can't import
## the backend `mir` module without a cycle) can read the F4 flip gate through the
## single backend source. Returns `mir_default_struct_value_live()` verbatim (0 at
## the committed state). Used by the QZ0221 outer guard in typecheck_expr_handlers.
def tc_default_struct_value_live(): Int
  return mir::mir_default_struct_value_live()
end

# Name-keyed sanctioned IR/arena handle predicate (single source for the QZ0221
# value-layout exclusion). MirBlock / AstStorage are structural ambient handles
# (block label pointers, the AST arena) whose `0` is a deliberate null-sentinel and
# whose identity is the bare i64 by ABI design — they NEVER flip to value-layout, so
# routing them through a conversion bridge is sanctioned, not an erased-value hazard.
# Lives here (not typecheck_helpers, which would cycle into this module) so the
# value-layout predicates can consult it; tc_n3_is_sanctioned_handle_type delegates.
def tc_is_sanctioned_handle_name(name: String): Bool
  return true if name == "mir$MirBlock"
  return true if name == "ast$AstStorage"
  return true if name == "MirBlock"
  return true if name == "AstStorage"
  return false
end

def tc_is_value_layout_struct_type(tc: TypecheckState, t: Int): Int
  return 1 if tc_is_value_struct_type(tc, t) == 1
  return 0 if mir::mir_default_struct_value_live() == 0
  # R1.1 (PF3 Family-3 opt-out): `@repr(C)` structs are positively known-Boxed
  # (mir_default_struct_value_eligible returns 0 on entry.repr_c==1), so they NEVER
  # flip to value-layout. Excluding them here is a true-negative, not a false-accept
  # — it narrows the conservative over-approximation without crossing the forbidden
  # direction (a flipped struct crossing the bridge unflagged can still never happen).
  return 0 if tc_is_repr_c_struct_type(tc, t) == 1
  # F4 gate live: a concrete (non-generic) registered struct id is flip-eligible.
  var idx = typecheck::tc_struct_idx_from_type(t)
  return 0 if idx < 0 or idx >= tc.registry.struct_names.size
  # Sanctioned ambient IR/arena handles (MirBlock/AstStorage) never flip — the bare
  # i64 IS their value (label pointer / arena handle), no inline payload to truncate.
  return 0 if tc_is_sanctioned_handle_name(tc.registry.struct_names[idx])
  return 1
end

## F4b — name-keyed companion to `tc_is_value_layout_struct_type`, for the QZ0221
## fallback path where `tc_expr` collapsed a local's type to bare `TYPE_STRUCT (7)`
## and the struct name was recovered via `tc_scope_lookup_struct_name`. Same two
## clauses, same single-gate-source, same conservative over-approximation. Empty
## name (non-struct binding) returns 0.
def tc_is_value_layout_struct_name(tc: TypecheckState, name: String): Int
  return 0 if str_byte_len(name) == 0
  return 1 if tc_is_value_struct_name(tc, name) == 1
  return 0 if mir::mir_default_struct_value_live() == 0
  # Sanctioned ambient IR/arena handles (MirBlock/AstStorage) never flip — same
  # exclusion as tc_is_value_layout_struct_type, name-keyed.
  return 0 if tc_is_sanctioned_handle_name(name)
  # F4 gate live: a registered struct name is flip-eligible, UNLESS it is `@repr(C)`
  # (R1.1 PF3 Family-3 opt-out — positively known-Boxed, never flips). Same
  # narrowing as tc_is_value_layout_struct_type, name-keyed.
  var count = tc.registry.struct_names.size
  var name_id = intern(name)
  for i in 0..count
    if g_struct_name_ids[i] == name_id
      return 0 if i < tc.registry.struct_repr_c.size and tc.registry.struct_repr_c[i] == 1
      return 1
    end
  end
  return 0
end

## Look up the binary-DSL kind of a registered struct.
## Returns 0 for normal structs, 1 for binary blocks, 2 for packed structs.
def tc_struct_dsl_kind(tc: TypecheckState, name: String): Int
  match tc_lookup_struct(tc, name)
    Found(idx) => return tc.registry.struct_dsl_kind[idx]
    NotFound => return 0
  end
end

## Look up the backing width of a packed struct (0 if not a packed struct).
def tc_struct_dsl_backing(tc: TypecheckState, name: String): Int
  match tc_lookup_struct(tc, name)
    Found(idx) => return tc.registry.struct_dsl_backing[idx]
    NotFound => return 0
  end
end

## Look up a struct by name.
##
## Parameters:
##   tc   - Type checker context
##   name - Struct name
##
## Returns: Found(index) or NotFound
def tc_lookup_struct(tc: TypecheckState, name: String): LookupResult
  var struct_names = tc.registry.struct_names

  var count = struct_names.size
  # Exact match first — use interned ID for O(1) comparison
  var name_id = intern(name)
  for i in 0..count
    return LookupResult::Found(i) if g_struct_name_ids[i] == name_id
  end

  # Fallback: search for a struct ending with $name (imported struct)
  # This handles code within a module referencing its own structs by raw name
  # while the struct is registered with a module prefix (e.g., "ast$AstStorage")
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var struct_name = struct_names[i]
    var name_len = str_byte_len(struct_name)
    if name_len >= suffix_len
      if struct_name.ends_with(suffix)
        # Skip private names (contain $$)
        if not struct_name.contains("$$")
          return LookupResult::Found(i)
        end
      end
    end
  end

  return LookupResult::NotFound
end

## Look up a binding's linear state by name. Returns 0 (Free), 1 (Live), or 2 (Consumed).
def tc_lookup_linear_state(tc: TypecheckState, name: String): Int
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_linear_states = tc.safety.binding_linear_states
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        return binding_linear_states[i]
      end
    end
    i -= 1
  end
  return 0
end

## Check if a struct is declared linear.
def tc_struct_is_linear(tc: TypecheckState, name: String): Int
  match tc_lookup_struct(tc, name)
    Found(idx) => return tc.registry.struct_is_linear[idx]
    NotFound => return 0
  end
  return 0
end

## Check if a union type contains any linear struct member (v5.25).
## If any member is linear, the entire union is considered linear.
def tc_union_has_linear_member(tc: TypecheckState, type_id: TypeId): Int
  return 0 if tc_is_union_type(type_id) == false
  var members = tc_union_members(tc, type_id)
  for i in 0..members.size
    var member_name = members[i]
    var trimmed = str_trim(member_name)
    if tc_struct_is_linear(tc, trimmed)
      return 1
    end
  end
  return 0
end

## Check if a struct type has a Drop impl.
def tc_struct_has_drop(tc: TypecheckState, struct_name: String): Int
  var idx = tc_lookup_impl(tc, "Drop", struct_name)
  if idx >= 0
    return 1
  end
  return 0
end

## Mark a binding as linear (state=Live).
def tc_mark_binding_linear(tc: TypecheckState, name: String, struct_name: String): Void
  var binding_names = tc.scope.binding_names
  var binding_linear_states = tc.safety.binding_linear_states
  var binding_linear_structs = tc.safety.binding_linear_structs
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(name)
      binding_linear_states[i] = 1
      binding_linear_structs[i] = struct_name
      return
    end
    i -= 1
  end
end

## Consume a linear binding (mark as Consumed). Reports QZ1202 on double consume.
def tc_consume_linear(tc: TypecheckState, name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_linear_states = tc.safety.binding_linear_states
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        if binding_linear_states[i] == 2
          error("QZ1202: Linear value '#{name}' consumed twice", line, col)
        end
        if binding_linear_states[i] == 1
          binding_linear_states[i] = 2
        end
        return
      end
    end
    i -= 1
  end
end

## Check that a linear binding is still live. Reports QZ1203 on use-after-move.
def tc_check_linear_live(tc: TypecheckState, name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_linear_states = tc.safety.binding_linear_states
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        if binding_linear_states[i] == 2
          error("QZ1203: Use of consumed linear value '#{name}'", line, col)
        end
        return
      end
    end
    i -= 1
  end
end

## Check linear bindings at scope exit. Reports QZ1201 for unconsumed values without Drop.
def tc_check_linear_scope_exit(tc: TypecheckState, depth: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_linear_states = tc.safety.binding_linear_states
  var binding_linear_structs = tc.safety.binding_linear_structs
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_depths[i] == depth
      if binding_linear_states[i] == 1
        var struct_name = binding_linear_structs[i]
        if tc_struct_has_drop(tc, struct_name) == 0
          var bname = binding_names[i]
          error("QZ1201: Linear value '#{bname}' of type #{struct_name} not consumed", 0, 0)
        end
      end
    end
    i -= 1
  end
end

## Snapshot linear states for control flow analysis.
def tc_snapshot_linear_states(tc: TypecheckState): Vec<Int>
  var binding_linear_states = tc.safety.binding_linear_states
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var snapshot = vec_new()
  for i in 0..binding_count
    snapshot.push(binding_linear_states[i])
  end
  return snapshot
end

## Restore linear states from snapshot.
def tc_restore_linear_states(tc: TypecheckState, snapshot: Vec<Int>): Void
  var binding_linear_states = tc.safety.binding_linear_states
  var count = snapshot.size
  for i in 0..count
    binding_linear_states[i] = snapshot[i]
  end
end

## SURF.FLOW Phase 1 — snapshot the narrow side table. The table is a pure
## append-only stack within a branch, so the snapshot is just the live row
## count; restore truncates back to it. Mirrors the linear-state snapshot
## discipline so it threads through the same if-handler branch points.
def tc_snapshot_narrow(tc: TypecheckState): Int
  return typecheck_util::tc_narrow_count(tc)
end

## Restore the narrow side table to a previously snapshotted row count,
## dropping every refinement pushed since. Guarantees a then-branch narrowing
## cannot leak past the `if`.
def tc_restore_narrow(tc: TypecheckState, snapshot: Int): Void
  var ncv = tc.scope.narrow_count
  ncv[0] = snapshot
end

## Check that two sets of linear states agree after if/else branches.
def tc_check_linear_branch_agreement(tc: TypecheckState, states_a: Vec<Int>, states_b: Vec<Int>, line: Int, col: Int): Void can Diag
  var binding_linear_states = tc.safety.binding_linear_states
  var binding_names = tc.scope.binding_names
  var count = states_a.size
  if states_b.size < count
    count = states_b.size
  end
  for i in 0..count
    if binding_linear_states[i] == 0
      # Free binding, skip
    else
      if states_a[i] != states_b[i]
        var bname = binding_names[i]
        error("QZ1207: All branches must consume '#{bname}' consistently", line, col)
      end
    end
  end
end

## Get field type for a struct.
##
## Parameters:
##   tc           - Type checker context
##   struct_index - Index from tc_lookup_struct
##   field_name   - Name of field to find
##
## Returns: Field type kind, or type_constants$TYPE_ERROR if not found
def tc_struct_field_type(tc: TypecheckState, struct_index: Int, field_name: String): Int
  var struct_field_names = tc.registry.struct_field_names
  var struct_field_types = tc.registry.struct_field_types
  
  var field_names = struct_field_names[struct_index]
  var field_types = struct_field_types[struct_index]
  
  var count = vec_size(field_names)
  for i in 0..count
    var name = field_names[i]
    return field_types[i] if name == field_name
  end

  return type_constants::TYPE_ERROR
end

# ============================================================================
# Enum Registry
# ============================================================================

## Register an enum definition.
##
## Parameters:
##   tc            - Type checker context
##   name          - Enum name
##   variant_names - Vector of variant name strings
##   variant_payloads - Vector of payload type vectors (empty vec if no payload)
def tc_register_enum(tc: TypecheckState, name: String, variant_names: Vec<String>, variant_payloads: Vec<Int>, type_params: String, variant_field_annotations: Vec<String>): Void
  var enum_names = tc.registry.enum_names
  var enum_variant_names = tc.registry.enum_variant_names
  var enum_variant_payloads = tc.registry.enum_variant_payloads
  var enum_type_params = tc.registry.enum_type_params
  var enum_variant_field_annotations = tc.registry.enum_variant_field_annotations
  
  enum_names.push(name)
  g_enum_name_ids.push(intern(name))
  enum_variant_names.push(variant_names)
  enum_variant_payloads.push(variant_payloads)
  enum_type_params.push(type_params)
  enum_variant_field_annotations.push(variant_field_annotations)
end

## Look up an enum by name.
##
## Parameters:
##   tc   - Type checker context
##   name - Enum name
##
## Returns: Found(index) or NotFound
def tc_lookup_enum(tc: TypecheckState, name: String): LookupResult
  var enum_names = tc.registry.enum_names

  var count = enum_names.size
  # Exact match first — use interned ID for O(1) comparison
  var name_id = intern(name)
  for i in 0..count
    return LookupResult::Found(i) if g_enum_name_ids[i] == name_id
  end

  # Fallback: search for an enum ending with $name (imported enum)
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var enum_name = enum_names[i]
    var name_len = str_byte_len(enum_name)
    if name_len >= suffix_len
      if enum_name.ends_with(suffix)
        # Skip private names (contain $$)
        if not enum_name.contains("$$")
          return LookupResult::Found(i)
        end
      end
    end
  end

  return LookupResult::NotFound
end

## Check if enum has a variant.
##
## Parameters:
##   tc          - Type checker context
##   enum_index  - Index from tc_lookup_enum
##   variant_name - Name of variant to find
##
## Returns: 1 if exists, 0 otherwise
def tc_enum_has_variant(tc: TypecheckState, enum_index: Int, variant_name: String): Int
  var enum_variant_names = tc.registry.enum_variant_names
  var variant_names = enum_variant_names[enum_index]

  if any?(variant_names, v: String -> v == variant_name)
    return 1
  end

  return 0
end

## Get variant count for an enum.
##
## Parameters:
##   tc         - Type checker context
##   enum_index - Index from tc_lookup_enum
##
## Returns: Number of variants
def tc_enum_variant_count(tc: TypecheckState, enum_index: Int): Int
  var enum_variant_names = tc.registry.enum_variant_names
  var variant_names = enum_variant_names[enum_index]
  return vec_size(variant_names)
end

## Get expected payload count for a specific enum variant.
##
## Parameters:
##   tc           - Type checker context
##   enum_name    - Enum name string
##   variant_name - Variant name string
##
## Returns: expected payload count, or -1 if enum/variant not found
def tc_enum_variant_payload_count(tc: TypecheckState, enum_name: String, variant_name: String): Int
  var enum_lookup = tc_lookup_enum(tc, enum_name)
  var enum_idx = match enum_lookup
    Found(v) => v
    NotFound => -1
  end
  if enum_idx < 0
    return -1
  end
  var variant_names = tc.registry.enum_variant_names[enum_idx]
  var variant_count = vec_size(variant_names)
  for vi in 0..variant_count
    if variant_names[vi] == variant_name
      var enum_payloads = tc.registry.enum_variant_payloads[enum_idx]
      var variant_payloads = enum_payloads[vi]
      return vec_size(variant_payloads)
    end
  end
  return -1
end

# ============================================================================
# Trait Registry - slots 28-30
# ============================================================================

## Register a trait in the type checker.
##
## Parameters:
##   tc           - Type checker context
##   name         - Trait name
##   method_names - Vector of method name strings (as Int pointers)
##   method_sigs  - Vector of method signatures (each is vector of [param_types_vec, return_type])
##   defaults     - Vector of flags (1 = has default body, 0 = abstract) per method
##   super_traits - "+"-separated super-trait names
##   type_params  - Comma-separated type parameter names (e.g., "T" or "K,V")
def tc_register_trait(tc: TypecheckState, name: String, method_names: Vec<String>, method_sigs: Vec<Int>, defaults: Vec<Int>, super_traits: String, type_params: String): Void
  var trait_names = tc.registry.trait_names
  var trait_method_names = tc.registry.trait_method_names
  var trait_method_sigs = tc.registry.trait_method_sigs
  var trait_method_defaults = tc.registry.trait_method_defaults

  trait_names.push(name)
  g_trait_name_ids.push(intern(name))
  trait_method_names.push(method_names)
  trait_method_sigs.push(method_sigs)
  trait_method_defaults.push(defaults)
  tc.registry.trait_super_traits.push(super_traits)
  tc.registry.trait_type_params.push(type_params)
  # P3.F.3: row-tracking slots default to empty. tc_register_trait_def fills
  # these via tc_set_trait_method_effect_rows / tc_set_trait_generalized_ervs
  # when it sees `can` clauses on the trait's methods. Builtins registered
  # via tc_register_trait (Drop, Iterator, AsyncIterator, Send, Sync) leave
  # these defaults — their method rows are untracked until reconsidered.
  var empty_rows = vec_new()
  for _erv_i in 0..method_names.size
    empty_rows.push(-1)
  end
  tc.registry.trait_method_effect_rows.push(empty_rows)
  tc.registry.trait_generalized_ervs.push(vec_new())
end

## P3.F.3: Set the per-method effect rows for an already-registered trait.
## Called by tc_register_trait_def after walking each method's `can` clause
## through the trait-scoped row-var env. rows is parallel to the trait's
## method_names vec; each entry is -1 (no row) or a valid row_id.
def tc_set_trait_method_effect_rows(tc: TypecheckState, trait_idx: Int, rows: Vec<Int>): Void
  if trait_idx < 0 or trait_idx >= tc.registry.trait_method_effect_rows.size
    return
  end
  tc.registry.trait_method_effect_rows[trait_idx] = rows
end

## P3.F.3: Set the generalized ervs for an already-registered trait.
def tc_set_trait_generalized_ervs(tc: TypecheckState, trait_idx: Int, ervs: Vec<Int>): Void
  if trait_idx < 0 or trait_idx >= tc.registry.trait_generalized_ervs.size
    return
  end
  var copy = vec_new()
  for i in 0..ervs.size
    copy.push(ervs[i])
  end
  tc.registry.trait_generalized_ervs[trait_idx] = copy
end

## P3.F.3: Get the row_id for a specific trait method.
## Returns -1 if the trait or method is out of range, or the method has no
## declared `can` row.
def tc_get_trait_method_effect_row(tc: TypecheckState, trait_idx: Int, method_idx: Int): Int
  if trait_idx < 0 or trait_idx >= tc.registry.trait_method_effect_rows.size
    return -1
  end
  var method_rows = tc.registry.trait_method_effect_rows[trait_idx]
  if method_idx < 0 or method_idx >= method_rows.size
    return -1
  end
  return method_rows[method_idx]
end

## P3.F.3: Get the generalized ervs for a trait (the row-vars declared
## as lowercase type-params).
def tc_get_trait_generalized_ervs(tc: TypecheckState, trait_idx: Int): Vec<Int>
  if trait_idx < 0 or trait_idx >= tc.registry.trait_generalized_ervs.size
    return vec_new()
  end
  return tc.registry.trait_generalized_ervs[trait_idx]
end

## P3.F.6: Compute the callee labels missing from the caller, for use in
## error messages. Returns a comma-separated list of label NAMES (not
## intern IDs), suitable for a user-facing fix suggestion:
##   "add `Async, Throws` to the `can` clause"
## Returns an empty string if nothing is missing (unusual — the caller
## only asks after a subsumption failure, but defensive).
def tc_row_missing_labels_str(tc: TypecheckState, caller_row: Int, callee_row: Int): String
  if callee_row < 0
    return ""
  end
  var callee_w = tc_row_walk(tc, callee_row)
  var caller_w = caller_row
  if caller_row >= 0
    caller_w = tc_row_walk(tc, caller_row)
  end
  var callee_labels = tc_row_get_labels(tc, callee_w)
  var caller_labels = vec_new()
  if caller_row >= 0
    caller_labels = tc_row_get_labels(tc, caller_w)
  end
  var missing = _tc_row_ms_subtract(callee_labels, caller_labels)
  var out = ""
  for i in 0..missing.size
    var nm = resolve(missing[i])
    if str_byte_len(out) == 0
      out = nm
    else
      out = "#{out}, #{nm}"
    end
  end
  return out
end

## Look up a trait by name.
##
## Parameters:
##   tc   - Type checker context
##   name - Trait name
##
## Returns: Found(index) or NotFound
def tc_lookup_trait(tc: TypecheckState, name: String): LookupResult
  var trait_names = tc.registry.trait_names

  # Strip generic args: "Container<Int>" -> "Container"
  var base_name = name
  var lt_pos = __char_index(name, '<')
  if lt_pos >= 0
    base_name = str_byte_slice(name, 0, lt_pos)
  end

  var count = trait_names.size
  # Exact match first (try both full name and base name) — use interned IDs
  var name_id = intern(name)
  var base_id = intern(base_name)
  for i in 0..count
    if g_trait_name_ids[i] == name_id
      return LookupResult::Found(i)
    end
    if g_trait_name_ids[i] == base_id
      return LookupResult::Found(i)
    end
  end

  # Fallback: search for trait ending with $name or $base_name (imported trait)
  var suffix = "$#{base_name}"
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var trait_name = trait_names[i]
    var name_len = str_byte_len(trait_name)
    if name_len >= suffix_len
      if trait_name.ends_with(suffix)
        # Skip private traits (contain $$)
        if not trait_name.contains("$$")
          return LookupResult::Found(i)
        end
      end
    end
  end

  return LookupResult::NotFound
end

## Get method count for a trait.
##
## Parameters:
##   tc          - Type checker context
##   trait_index - Index from tc_lookup_trait
##
## Returns: Number of methods in the trait
def tc_trait_method_count(tc: TypecheckState, trait_index: Int): Int
  var trait_method_names = tc.registry.trait_method_names
  var method_names = trait_method_names[trait_index]
  return vec_size(method_names)
end

## Check if trait has a method.
##
## Parameters:
##   tc          - Type checker context
##   trait_index - Index from tc_lookup_trait
##   method_name - Name of method to find
##
## Returns: 1 if exists, 0 otherwise
def tc_trait_has_method(tc: TypecheckState, trait_index: Int, method_name: String): Int
  var trait_method_names = tc.registry.trait_method_names
  var method_names = trait_method_names[trait_index]
  
  if any?(method_names, m: String -> m == method_name)
    return 1
  end

  return 0
end

# ============================================================================
# Impl Registry - slots 31-33
# ============================================================================

## Register an impl block in the type checker.
##
## Parameters:
##   tc           - Type checker context
##   trait_name   - Name of trait being implemented
##   for_type     - Name of type the trait is implemented for
##   method_names - Vector of method name strings (as Int pointers)
def tc_register_impl(tc: TypecheckState, trait_name: String, for_type: String, method_names: Vec<String>): Void
  var impl_trait_names = tc.registry.impl_trait_names
  var impl_for_types = tc.registry.impl_for_types
  var impl_method_names = tc.registry.impl_method_names

  # Idempotent: skip if this trait+type pair is already registered
  # (the resolver and typecheck may both register the same impl block)
  var trait_id = intern(trait_name)
  var type_id = intern(for_type)
  var existing_count = impl_trait_names.size
  var i = 0
  while i < existing_count
    if g_impl_trait_name_ids[i] == trait_id and g_impl_for_type_ids[i] == type_id
      return
    end
    i += 1
  end

  impl_trait_names.push(trait_name)
  g_impl_trait_name_ids.push(trait_id)
  impl_for_types.push(for_type)
  g_impl_for_type_ids.push(type_id)
  impl_method_names.push(method_names)
end

## Register a negative impl block: `impl !Trait for Type end`.
## Idempotent — skips duplicates of the same (trait, type) pair.
def tc_register_neg_impl(tc: TypecheckState, trait_name: String, for_type: String): Void
  var neg_traits = tc.registry.neg_impl_trait_names
  var neg_types = tc.registry.neg_impl_for_types
  var n = neg_traits.size
  var i = 0
  while i < n
    if neg_traits[i].eq(trait_name) and neg_types[i].eq(for_type)
      return
    end
    i += 1
  end
  neg_traits.push(trait_name)
  neg_types.push(for_type)
end

## Look up a negative impl by trait name and concrete type.
## Returns the registry index, or -1 if no negative impl exists.
## Generic types: matches by base name (strip `<...>`) on both sides so that
## `impl !Send for X` rejects `X<Int>`, and `impl !Send for X<T>` rejects `X`.
def tc_lookup_neg_impl(tc: TypecheckState, trait_name: String, for_type: String): Int
  var neg_traits = tc.registry.neg_impl_trait_names
  var neg_types = tc.registry.neg_impl_for_types
  var n = neg_traits.size
  if n == 0
    return -1
  end
  var for_base = for_type
  var req_lt = __char_index(for_type, '<')
  if req_lt > 0
    for_base = str_byte_slice(for_type, 0, req_lt)
  end
  var i = 0
  while i < n
    if neg_traits[i].eq(trait_name)
      var nt = neg_types[i]
      return i if nt.eq(for_type)
      var nt_base = nt
      var nt_lt = __char_index(nt, '<')
      if nt_lt > 0
        nt_base = str_byte_slice(nt, 0, nt_lt)
      end
      return i if nt_base.eq(for_base)
    end
    i += 1
  end
  return -1
end

## Look up an impl by trait name and for_type.
##
## Parameters:
##   tc         - Type checker context
##   trait_name - Trait name
##   for_type   - Type name
##
## Returns: Index in impl registry, or -1 if not found
def tc_lookup_impl(tc: TypecheckState, trait_name: String, for_type: String): Int
  var impl_trait_names = tc.registry.impl_trait_names
  var impl_for_types = tc.registry.impl_for_types

  # Strip generics off the requested for_type so lookups by base name
  # (e.g. "MapDoubler") match impls registered under a parameterized form
  # (e.g. "MapDoubler<T>" or "MapDoubler<Int>").
  var for_type_base = for_type
  var req_lt = __char_index(for_type, '<')
  if req_lt > 0
    for_type_base = str_byte_slice(for_type, 0, req_lt)
  end

  var count = impl_trait_names.size
  for i in 0..count
    var impl_trait = impl_trait_names[i]
    var impl_type = impl_for_types[i]
    # Extract the impl's base struct name too
    var impl_type_base = impl_type
    var imp_lt = __char_index(impl_type, '<')
    if imp_lt > 0
      impl_type_base = str_byte_slice(impl_type, 0, imp_lt)
    end
    if impl_trait.eq(trait_name)
      return i if impl_type.eq(for_type)
      # Also match base-name form: `impl X for Foo<T>` satisfies a bound
      # check against `Foo`. Generic impls are monomorphized per call site
      # so the bound is valid.
      return i if impl_type_base.eq(for_type_base)
    else
      # Match generic impl: "Iterator<Int>" matches bound "Iterator"
      var lt_pos = __char_index(impl_trait, '<')
      if lt_pos > 0
        var base_trait = str_byte_slice(impl_trait, 0, lt_pos)
        if base_trait.eq(trait_name)
          return i if impl_type.eq(for_type)
          return i if impl_type_base.eq(for_type_base)
        end
      end
    end
  end

  return -1
end

## Get method names for an impl block.
##
## Parameters:
##   tc         - Type checker context
##   impl_index - Index from tc_lookup_impl
##
## Returns: Vector of method name strings (as Int pointers)
def tc_impl_method_names(tc: TypecheckState, impl_index: Int): Vec<String>
  var impl_method_names = tc.registry.impl_method_names
  return impl_method_names[impl_index]
end

# ============================================================================
# Trait Constraint Validation
# ============================================================================

## Look up a function's index in the function registry.
## Returns index in tc.registry.func_names, or -1 if not found.
def tc_lookup_function_index(tc: TypecheckState, name: String): Int
  var func_names = tc.registry.func_names
  var count = func_names.size
  var name_id = intern(name)
  var i = count - 1
  while i >= 0
    if g_func_name_ids[i] == name_id
      return i
    end
    i -= 1
  end
  # Fallback: suffix match for module-prefixed calls
  var suffix = _cached_suffix(tc, name)
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var func_name = func_names[i]
    var name_len = str_byte_len(func_name)
    if name_len >= suffix_len
      if func_name.ends_with(suffix)
        # Skip private functions (contain $$)
        if not func_name.contains("$$")
          return i
        end
      end
    end
  end
  return -1
end

## Look up a function's borrow summary by name.
## Returns Some(BorrowSummary), or None if no summary exists.
def tc_lookup_borrow_summary(tc: TypecheckState, name: String): Option<typecheck_util::BorrowSummary>
  var idx = tc_lookup_function_index(tc, name)
  if idx >= 0 and idx < tc.registry.func_borrow_summaries.size
    return tc.registry.func_borrow_summaries[idx]
  end
  return Option::None
end

## Check if a type has an impl for a trait.
## Returns 1 if impl exists, 0 otherwise.
##
## Send/Sync auto-traits: when the bound is `Send` or `Sync` and no explicit
## `impl Send for T` / `impl Sync for T` exists, fall through to the
## structural field-recursive helpers `tc_type_is_send` / `tc_type_is_sync`.
## These helpers already implement coinductive cycle detection via the
## `g_send_checking` / `g_sync_checking` visited stacks, so recursive types
## like `struct Node { next: Option<Box<Node>> }` correctly prove Send/Sync
## by structural induction — matching rustc's auto-trait solver and
## Swift's Sendable derivation.
##
## See RFC 0458 for the "structural, not nominal" design rationale and
## docs/ROADMAP.md IMPL-TRAIT-SEND-AUTO for the original bug report.
def tc_check_trait_bound(tc: TypecheckState, trait_name: String, concrete_type: String): Int
  # Opaque `impl Trait<T>` value trivially implements trait Trait<T> (or the
  # base Trait without generic args). This is what the `impl Trait<T>`
  # annotation on a function return promises. Needed because async
  # generators don't register a concrete impl-return type (body has no
  # NODE_RETURN — tc_register_impl_return is skipped at typecheck_walk.qz:3903),
  # so `var x = make_iter()` binds x with the literal opaque type string
  # "impl AsyncIterator<Int>" (or the stripped form "impl AsyncIterator").
  # Match both shapes against the bound's trait name.
  if str_byte_len(concrete_type) > 5 and concrete_type.starts_with("impl ")
    var _opaque = str_byte_slice(concrete_type, 5, str_byte_len(concrete_type))
    if _opaque == trait_name
      return 1
    end
    var _op_lt = __char_index(_opaque, '<')
    if _op_lt > 0
      var _op_base = str_byte_slice(_opaque, 0, _op_lt)
      if _op_base == trait_name
        return 1
      end
    end
    # Bound carries generics, opaque name doesn't (because var-let stripped
    # them) — match base-to-base as a last resort. Example: concrete
    # "impl AsyncIterator" satisfies bound "AsyncIterator<Int>".
    var _tn_lt = __char_index(trait_name, '<')
    if _tn_lt > 0
      var _tn_base = str_byte_slice(trait_name, 0, _tn_lt)
      if _opaque == _tn_base
        return 1
      end
    end
  end

  # Negative impl always wins for Send/Sync bounds.
  if trait_name.eq("Send") or trait_name.eq("Sync")
    if str_byte_len(concrete_type) > 0
      if tc_lookup_neg_impl(tc, trait_name, concrete_type) >= 0
        return 0
      end
    end
  end
  if tc_lookup_impl(tc, trait_name, concrete_type) >= 0
    return 1
  end
  # Send/Sync fallthrough: structural auto-derivation.
  if trait_name.eq("Send") or trait_name.eq("Sync")
    if str_byte_len(concrete_type) > 0
      # Resolve the concrete type name to a type kind. Structs/enums go
      # through the normal struct lookup; anything else is a primitive
      # that tc_type_is_send handles via its type_id switch.
      var resolved_kind = typecheck::tc_parse_type(tc, concrete_type)
      if trait_name.eq("Send")
        if tc_type_is_send(tc, resolved_kind, concrete_type) == 1
          return 1
        end
      else
        if tc_type_is_sync(tc, resolved_kind, concrete_type) == 1
          return 1
        end
      end
    end
  end
  return 0
end

## Get the type param bounds string for a function at the given index.
def tc_function_type_param_bounds(tc: TypecheckState, idx: Int): String
  var bounds = tc.registry.func_type_param_bounds
  if idx >= 0 and idx < bounds.size
    return bounds[idx]
  end
  return ""
end

## Get the type params string for a function at the given index.
def tc_function_type_params_str(tc: TypecheckState, idx: Int): String
  var params = tc.registry.func_type_params
  if idx >= 0 and idx < params.size
    return params[idx]
  end
  return ""
end

## Get the param annotations string for a function at the given index.
def tc_function_param_annotations(tc: TypecheckState, idx: Int): String
  var anns = tc.registry.func_param_annotations
  if idx >= 0 and idx < anns.size
    return anns[idx]
  end
  return ""
end

## Get the param names string for a function at the given index.
def tc_function_param_names(tc: TypecheckState, idx: Int): String
  var names = tc.registry.func_param_names
  if idx >= 0 and idx < names.size
    return names[idx]
  end
  return ""
end

## Diagnostics (A3): reconstruct a human-readable signature for an arity
## error, e.g. `add is defined as add(a: Int, b: Int)`. Zips the parallel
## comma-separated param-name and param-annotation strings the registry
## already keeps (`func_param_names` / `func_param_annotations`). Returns
## "" when the function isn't found or has no recorded params, so callers
## can skip emitting the note. Params with a missing annotation render the
## bare name (no `: Type`). Pure formatting — only ever runs on an already
## recorded arity error, so it is gate-1-inert.
def tc_build_signature_note(tc: TypecheckState, func_name: String): String
  var fidx = tc_lookup_function_index(tc, func_name)
  return "" if fidx < 0
  var names_str = tc_function_param_names(tc, fidx)
  var anns_str = tc_function_param_annotations(tc, fidx)
  var name_list = str_split(names_str, ",")
  var ann_list = str_split(anns_str, ",")
  var n = name_list.size
  return "" if n == 0
  var sig = "#{func_name}("
  for pi in 0..n
    if pi > 0
      sig += ", "
    end
    var pname = str_trim(as_string(name_list[pi]))
    var pann = ""
    if pi < ann_list.size
      pann = str_trim(as_string(ann_list[pi]))
    end
    if str_byte_len(pname) == 0
      # Defensive: an empty name slot — fall back to a positional marker
      # rather than emitting a dangling `: Type`.
      pname = "_"
    end
    if str_byte_len(pann) > 0
      sig += "#{pname}: #{pann}"
    else
      sig += pname
    end
  end
  sig += ")"
  return "#{func_name} is defined as #{sig}"
end

## R2.3 arg-type soundness — true iff param `param_idx` of `func_name` is an
## ERASED GENERIC: its declared annotation is one of the function's own type
## parameters (e.g. `def boxit<T>(x: T)` — param 0's annotation is `T`, a type
## var). Generic params register as bare TYPE_INT in func_param_types (existential
## erasure), so the scalar arg check can't tell them from real Int params by
## TypeId alone — it must consult the raw annotation + type-param list here, or it
## false-flags `boxit("hi")` (String into an erased-T slot). Also treats a bare
## `Any`-annotated param as generic (unconstrained). Returns false for a normal
## concrete param or when the function isn't found / has no type params.
def tc_param_is_erased_generic(tc: TypecheckState, func_name: String, param_idx: Int): Bool
  var fidx = tc_lookup_function_index(tc, func_name)
  return false if fidx < 0
  var anns = tc_function_param_annotations(tc, fidx)
  return false if str_byte_len(anns) == 0
  var ann_list = str_split(anns, ",")
  return false if param_idx < 0 or param_idx >= ann_list.size
  var pann = as_string(ann_list[param_idx])
  # Trim surrounding whitespace.
  pann = str_trim(pann)
  return false if str_byte_len(pann) == 0
  # `Any` is the unconstrained top type — permit unconditionally.
  return true if pann.eq("Any")
  # A type param may be written bare (`T`) or as a generic head whose base is a
  # type param (`T` never has `<`, but be defensive). Strip any generic tail.
  var lt = __char_index(pann, '<')
  if lt > 0
    pann = str_byte_slice(pann, 0, lt)
  end
  var tps = tc_function_type_params_str(tc, fidx)
  return false if str_byte_len(tps) == 0
  var tp_list = str_split(tps, ",")
  for ti in 0..tp_list.size
    var tp = str_trim(as_string(tp_list[ti]))
    # A type-param entry may carry a bound (`T:Show`) — compare the head only.
    var colon = __char_index(tp, ':')
    if colon > 0
      tp = str_byte_slice(tp, 0, colon)
    end
    if str_byte_len(tp) > 0 and pann.eq(tp)
      return true
    end
  end
  return false
end

## Get the AST store and handle for a function at the given index.
## Returns Some([ast_store, ast_handle]) or None if not found.
def tc_function_ast_info(tc: TypecheckState, idx: Int): Option<Vec<Int>>
  var stores = tc.registry.func_ast_stores
  if idx >= 0 and idx < stores.size
    if stores[idx] != 0
      return Option::Some([stores[idx], tc.registry.func_ast_handles[idx]])
    end
  end
  return Option::None
end

## Validate trait bounds at a call site.
## bounds_str format: "T:Addable" or "T:Eq+Ord,U:Show"
## param_anns format: "T,Int,String" (comma-separated param type annotations)
## For each bounded type param, finds the corresponding argument's concrete type
## and checks that the required trait impl exists.
def tc_validate_trait_bounds(tc: TypecheckState, func_name: String, func_idx: Int, args: Vec<Int>, ast_storage: ast::AstStorage, line: Int, col: Int): Void can Diag
  var bounds_str = tc_function_type_param_bounds(tc, func_idx)
  if str_byte_len(bounds_str) == 0
    return
  end
  var param_anns = tc_function_param_annotations(tc, func_idx)
  var arg_count = args.size

  # Parse bounds: "T:Addable,U:Ord" -> iterate over each bound entry
  var b_start = 0
  var b_i = 0
  while b_i <= str_byte_len(bounds_str)
    var is_sep = 0
    if b_i == str_byte_len(bounds_str)
      is_sep = 1
    elsif str_byte_at(bounds_str, b_i) == ','
      # ',' separator between bound entries
      is_sep = 1
    end
    if is_sep == 1 and b_i > b_start
      var bound_entry = str_byte_slice(bounds_str, b_start, b_i)
      # Parse "T:Addable+Printable" -> param_name="T", traits="Addable+Printable"
      var colon_pos = __char_index(bound_entry, ':')
      if colon_pos > 0
        var param_name = str_byte_slice(bound_entry, 0, colon_pos)
        var traits_str = str_byte_slice(bound_entry, colon_pos + 1, str_byte_len(bound_entry))

        # Find which argument position has this type param as its annotation
        var concrete_type = ""
        var ann_start = 0
        var ann_idx = 0
        var ann_i = 0
        while ann_i <= str_byte_len(param_anns)
          var ann_sep = 0
          if ann_i == str_byte_len(param_anns)
            ann_sep = 1
          elsif str_byte_at(param_anns, ann_i) == ','
            ann_sep = 1
          end
          if ann_sep == 1
            var ann_val = str_byte_slice(param_anns, ann_start, ann_i)
            if ann_val.eq(param_name) and ann_idx < arg_count
              # This param position matches the type param — get concrete type from arg
              var arg_node = args[ann_idx]
              var arg_kind = ast::ast_get_kind(ast_storage, arg_node)
              if arg_kind == node_constants::NODE_IDENT
                var arg_var_name = ast::ast_get_str1(ast_storage, arg_node)
                concrete_type = typecheck_util::tc_scope_lookup_struct_name(tc, arg_var_name)
              elsif arg_kind == node_constants::NODE_STRUCT_INIT
                concrete_type = ast::ast_get_str1(ast_storage, arg_node)
              elsif arg_kind == node_constants::NODE_CALL
                # Direct call expression — resolve through the callee's return
                # annotation. For an `impl Trait` return, look up the concrete
                # type in the registry so bound checking sees the real struct.
                var call_callee = ast::ast_get_left(ast_storage, arg_node)
                if ast::ast_get_kind(ast_storage, call_callee) == node_constants::NODE_IDENT
                  var call_name = ast::ast_get_str1(ast_storage, call_callee)
                  var call_ret = tc_lookup_function_return_annotation(tc, call_name)
                  if str_byte_len(call_ret) > 5 and call_ret.starts_with("impl ")
                    var impl_conc = tc_lookup_impl_return(tc, call_name)
                    if str_byte_len(impl_conc) > 0
                      concrete_type = impl_conc
                    end
                  elsif str_byte_len(call_ret) > 0
                    concrete_type = call_ret
                  end
                end
              end
              break
            end
            ann_start = ann_i + 1
            ann_idx += 1
          end
          ann_i += 1
        end

        # If we found a concrete type, check each trait bound
        if str_byte_len(concrete_type) > 0
          # Parse traits: "Addable+Printable" -> check each
          var t_start = 0
          var t_i = 0
          while t_i <= str_byte_len(traits_str)
            var t_sep = 0
            if t_i == str_byte_len(traits_str)
              t_sep = 1
            elsif str_byte_at(traits_str, t_i) == '+'
              # '+' separator between traits
              t_sep = 1
            end
            if t_sep == 1 and t_i > t_start
              var trait_name = str_byte_slice(traits_str, t_start, t_i)
              # Strip generic args off the trait name for impl lookup:
              # a bound like `Iter<Int>` maps to the `Iter` impl registry,
              # matching what tc_validate_struct_type_args already does.
              # Full variance / type-arg matching happens inside
              # tc_lookup_impl on exact-string compare, which still succeeds
              # when both bound and impl carry the same generic args.
              var tn_full = trait_name
              var tn_lt = __char_index(trait_name, '<')
              var tn_base = trait_name
              if tn_lt > 0
                tn_base = str_byte_slice(trait_name, 0, tn_lt)
              end
              var ok = tc_check_trait_bound(tc, tn_full, concrete_type)
              if ok == 0 and tn_lt > 0
                ok = tc_check_trait_bound(tc, tn_base, concrete_type)
              end
              if ok == 0
                var err_msg = "Type '#{concrete_type}' does not implement trait '#{trait_name}' required by function '#{func_name}'"
                error(err_msg, line, col)
              end
              t_start = t_i + 1
            end
            t_i += 1
          end
        end
      end
      b_start = b_i + 1
    end
    b_i += 1
  end
end

# ============================================================================
# "Did You Mean?" Suggestion Helpers
# ============================================================================

## Get all binding names in scope for "did you mean?" suggestions.
##
## Parameters:
##   tc - Type checker context
##
## Returns: Vector of name strings (as Int pointers)
def tc_all_binding_names(tc: TypecheckState): Vec<String> = tc.scope.binding_names

## Get all function names for "did you mean?" suggestions.
##
## Parameters:
##   tc - Type checker context
##
## Returns: Vector of name strings (as Int pointers)
def tc_all_func_names(tc: TypecheckState): Vec<String> = tc.registry.func_names

## Get all struct names for "did you mean?" suggestions.
##
## Parameters:
##   tc - Type checker context
##
## Returns: Vector of name strings (as Int pointers)
def tc_all_struct_names(tc: TypecheckState): Vec<String> = tc.registry.struct_names

## Get all enum names for "did you mean?" suggestions.
##
## Parameters:
##   tc - Type checker context
##
## Returns: Vector of name strings (as Int pointers)
def tc_all_enum_names(tc: TypecheckState): Vec<String> = tc.registry.enum_names

## Get field names for a struct (by index) for "did you mean?" suggestions.
##
## Parameters:
##   tc         - Type checker context
##   struct_idx - Index of struct in registry
##
## Returns: Vector of field name strings (as Int pointers)
def tc_struct_field_names(tc: TypecheckState, struct_idx: Int): Vec<String>
  var struct_field_names = tc.registry.struct_field_names
  return struct_field_names[struct_idx]
end

## Get the field type-id vector for a struct. Used by cross-module code
## that needs to iterate fields by index (e.g., hashability checks).
def tc_struct_field_types_vec(tc: TypecheckState, struct_idx: Int): Vec<Int>
  return tc.registry.struct_field_types[struct_idx]
end

## Get variant names for an enum (by index) for "did you mean?" suggestions.
##
## Parameters:
##   tc       - Type checker context
##   enum_idx - Index of enum in registry
##
## Returns: Vector of variant name strings (as Int pointers)
def tc_enum_variant_names(tc: TypecheckState, enum_idx: Int): Vec<String>
  var enum_variant_names = tc.registry.enum_variant_names
  return enum_variant_names[enum_idx]
end

## Get all builtin names for "did you mean?" suggestions.
##
## Parameters:
##   tc - Type checker context
##
## Returns: Vector of name strings (from map_keys)
def tc_all_builtin_names(tc: TypecheckState): Vec<String>
  var builtins = tc.builtins
  return builtins.keys
end

## Build suggestion message if a close match is found.
## Uses Damerau-Levenshtein distance from typeenv.be.
##
## Parameters:
##   name       - The unknown/misspelled name
##   candidates - Vector of candidate name strings
##
## Returns: " Did you mean 'X'?" or empty string if no match
def tc_suggest(name: String, candidates: Vec<String>): String
  match_result = typeenv::find_best_match(name, candidates)
  return " Did you mean '#{match_result}'?" if str_byte_len(match_result) > 0
  return ""
end

## Format a suggestion message from candidates using explicit count.
## Uses find_best_match_with_count to only check valid entries.
##
## Parameters:
##   name       - The unknown/misspelled name
##   candidates - Vector of candidate name strings
##   count      - Number of valid entries in candidates
##
## Returns: " Did you mean 'X'?" or empty string if no match
def tc_suggest_with_count(name: String, candidates: Vec<String>, count: Int): String
  match_result = typeenv::find_best_match_with_count(name, candidates, count)
  return " Did you mean '#{match_result}'?" if str_byte_len(match_result) > 0
  return ""
end

## Build combined suggestion from bindings, builtins, and functions.
##
## Parameters:
##   tc   - Type checker context
##   name - The unknown identifier
##
## Returns: Suggestion string or empty
def tc_suggest_identifier(tc: TypecheckState, name: String): String
  # Hallucination hint (#5): `mut` is the Rust mutable-binding keyword; Quartz uses
  # `var`. `mut` is not a token, so `mut x = 5` lexes `mut` as an undefined variable.
  # Emit a tailored hint before the similarity search. Gate-1-inert: no `mut`
  # identifier appears in self-hosted/*.qz, so this never fires on the self-compile
  # set (and QZ0403 does not fire on a clean build at all).
  if str_eq(name, "mut")
    return " `mut` is not a Quartz keyword; use `var x = 5` for a mutable binding."
  end

  # Guard: skip very short names (1 char) — too many false matches
  return "" if str_byte_len(name) < 2

  # Prefix-match strategy: find candidates where the first max(2, str_byte_len(name)/2)
  # chars match and length differs by at most 3. Fully inlined to avoid
  # adding new functions that may trigger codegen issues.
  var min_prefix = str_byte_len(name) / 2
  if min_prefix < 2
    min_prefix = 2
  end
  var best = ""
  var best_score = 0

  # Search scope bindings
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  if binding_count > 0
    var all_bindings = tc.scope.binding_names
    var cap = binding_count
    if cap > 500
      cap = 500
    end
    for bi in 0..cap
      var candidate = all_bindings[bi]
      if str_byte_len(candidate) > 0 and candidate != name
        # Inline score: check length diff, then prefix match
        var len_diff = str_byte_len(name) - str_byte_len(candidate)
        if len_diff < 0
          len_diff = 0 - len_diff
        end
        if len_diff <= 3
          var prefix_len = 0
          var min_len = str_byte_len(name)
          if str_byte_len(candidate) < min_len
            min_len = str_byte_len(candidate)
          end
          for pi in 0..min_len
            var a = str_byte_at(name, pi)
            var b = str_byte_at(candidate, pi)
            if a >= 65 and a <= 90
              a += 32
            end
            if b >= 65 and b <= 90
              b += 32
            end
            if a != b
              break
            end
            prefix_len += 1
          end
          if prefix_len >= min_prefix
            var score = prefix_len * 10 + (10 - len_diff)
            if score > best_score
              best_score = score
              best = candidate
            end
          end
        end
      end
    end
  end

  # Search user-defined functions
  var func_names = tc_all_func_names(tc)
  var fn_count = func_names.size
  if fn_count > 0
    var fn_cap = fn_count
    if fn_cap > 1000
      fn_cap = 1000
    end
    for fi in 0..fn_cap
      var candidate = func_names[fi]
      if str_byte_len(candidate) > 0 and candidate != name
        var len_diff = str_byte_len(name) - str_byte_len(candidate)
        if len_diff < 0
          len_diff = 0 - len_diff
        end
        if len_diff <= 3
          var prefix_len = 0
          var min_len = str_byte_len(name)
          if str_byte_len(candidate) < min_len
            min_len = str_byte_len(candidate)
          end
          for pi in 0..min_len
            var a = str_byte_at(name, pi)
            var b = str_byte_at(candidate, pi)
            if a >= 65 and a <= 90
              a += 32
            end
            if b >= 65 and b <= 90
              b += 32
            end
            if a != b
              break
            end
            prefix_len += 1
          end
          if prefix_len >= min_prefix
            var score = prefix_len * 10 + (10 - len_diff)
            if score > best_score
              best_score = score
              best = candidate
            end
          end
        end
      end
    end
  end

  return " Did you mean '#{best}'?" if str_byte_len(best) > 0

  # Fallback: prefix match found nothing (e.g. transposition/substitution
  # typos like `vaildate`→`validate` share no long prefix). Route through the
  # Damerau-Levenshtein matcher over the combined candidate set. Reuses the
  # shared helper (typeenv::find_best_match) — same idiom as tc_suggest/
  # tc_suggest_type — so transposition/substitution typos get a suggestion too.
  var candidates = vec_new<String>()
  var bcount = typecheck_util::tc_get_binding_count(tc)
  if bcount > 0
    var bnames = tc.scope.binding_names
    var bcap = bcount
    if bcap > 500
      bcap = 500
    end
    for bj in 0..bcap
      var bn = bnames[bj]
      if str_byte_len(bn) > 0 and bn != name
        candidates.push(bn)
      end
    end
  end
  var fnames = tc_all_func_names(tc)
  var fcount = fnames.size
  var fcap = fcount
  if fcap > 1000
    fcap = 1000
  end
  for fj in 0..fcap
    var fn = fnames[fj]
    if str_byte_len(fn) > 0 and fn != name
      candidates.push(fn)
    end
  end
  var fallback = typeenv::find_best_match(name, candidates)
  return " Did you mean '#{fallback}'?" if str_byte_len(fallback) > 0
  return ""
end

## Build suggestion for misspelled type annotations.
## Searches struct names, enum names, and built-in type names.
def tc_suggest_type(tc: TypecheckState, name: String): String
  # Try struct names
  var suggestion = tc_suggest(name, tc_all_struct_names(tc))
  return suggestion if str_byte_len(suggestion) > 0

  # Try enum names
  suggestion = tc_suggest(name, tc_all_enum_names(tc))
  return suggestion if str_byte_len(suggestion) > 0

  # Try common built-in type names
  var builtins = vec_new<String>()
  builtins.push("Int")
  builtins.push("Bool")
  builtins.push("String")
  builtins.push("Void")
  builtins.push("Char")
  builtins.push("Symbol")
  builtins.push("Regex")
  builtins.push("CInt")
  builtins.push("CChar")
  builtins.push("CPtr")
  builtins.push("CSize")
  builtins.push("CFloat")
  builtins.push("CDouble")
  builtins.push("F64")
  builtins.push("F32")
  builtins.push("Vec")
  builtins.push("Map")
  builtins.push("Option")
  builtins.push("Result")
  builtins.push("Array")
  suggestion = tc_suggest(name, builtins)
  return suggestion
end

## Build a "did you mean?" suggestion for an unknown method on a receiver type.
## Unlike tc_suggest_identifier (which searches scope bindings + free functions
## and would surface the internal mangled `Type$method` name), this scopes the
## candidate set to the RECEIVER type's actual methods: the impl-block methods
## registered for that type plus any `Type$method` UFCS free functions, reported
## under their clean method name (`magnitude`, not `P$magnitude`).
##
## Parameters:
##   tc            - Type checker context
##   receiver_type - Name of the receiver type (may be generic, e.g. "Foo<Int>")
##   name          - The unknown/misspelled method name
##
## Returns: " Did you mean 'X'?" or empty string if nothing is close.
def tc_suggest_method(tc: TypecheckState, receiver_type: String, name: String): String
  return "" if str_byte_len(name) < 2
  return "" if str_byte_len(receiver_type) < 1

  # Strip generics off the receiver so "Foo<Int>" matches impls registered
  # under "Foo" or "Foo<T>" (mirrors tc_lookup_impl's base-name matching).
  var recv_base = receiver_type
  var recv_lt = __char_index(receiver_type, '<')
  if recv_lt > 0
    recv_base = str_byte_slice(receiver_type, 0, recv_lt)
  end

  var candidates = vec_new<String>()

  # (1) Impl-block methods registered for this type (parallel vectors).
  var impl_for_types = tc.registry.impl_for_types
  var impl_method_names = tc.registry.impl_method_names
  var impl_count = impl_for_types.size
  for ii in 0..impl_count
    var impl_type = impl_for_types[ii]
    var impl_type_base = impl_type
    var imp_lt = __char_index(impl_type, '<')
    if imp_lt > 0
      impl_type_base = str_byte_slice(impl_type, 0, imp_lt)
    end
    if impl_type.eq(receiver_type) or impl_type_base.eq(recv_base)
      var methods = impl_method_names[ii]
      var mcount = methods.size
      for mi in 0..mcount
        var mname = methods[mi]
        if str_byte_len(mname) > 0 and mname != name
          candidates.push(mname)
        end
      end
    end
  end

  # (2) `Type$method` UFCS free functions: strip the "<base>$" prefix so the
  # suggestion is the clean method name.
  var prefix = "#{recv_base}$"
  var prefix_len = str_byte_len(prefix)
  var fnames = tc_all_func_names(tc)
  var fcount = fnames.size
  var fcap = fcount
  if fcap > 1000
    fcap = 1000
  end
  for fi in 0..fcap
    var fn = fnames[fi]
    if str_byte_len(fn) > prefix_len and fn.starts_with(prefix)
      var bare = str_byte_slice(fn, prefix_len, str_byte_len(fn))
      if str_byte_len(bare) > 0 and bare != name
        candidates.push(bare)
      end
    end
  end

  var match_result = typeenv::find_best_match(name, candidates)
  return " Did you mean '#{match_result}'?" if str_byte_len(match_result) > 0
  return ""
end

# ============================================================================
# Union Type Helpers
# ============================================================================

## Split a type annotation on top-level '|' characters.
## Respects <> nesting depth so "Vec<Int | String>" is NOT split.
## Returns a Vec of trimmed part strings. If no top-level '|' found, returns
## a single-element vec with the original annotation.
##
## @param annotation - Type annotation string (e.g. "Int | String | Bool")
## @returns Vec<String> of parts (e.g. ["Int", "String", "Bool"])
def tc_split_type_union(annotation: String): Vec<String>
  var parts = vec_new<String>()
  var depth = 0
  var start = 0
  var i = 0
  var len = str_byte_len(annotation)
  while i < len
    var ch = str_byte_at(annotation, i)
    if ch == '<'
      # '<'
      depth += 1
    end
    if ch == '>'
      # '>'
      depth -= 1
    end
    if ch == '|' and depth == 0
      # '|' at top level
      var part = str_trim(str_byte_slice(annotation, start, i))
      if str_byte_len(part) > 0
        parts.push(part)
      end
      start = i + 1
    end
    i += 1
  end
  # Last segment
  var last_part = str_trim(str_byte_slice(annotation, start, len))
  if str_byte_len(last_part) > 0
    parts.push(last_part)
  end
  return parts
end

## Register a union type from a list of member annotation strings.
## Each member is parsed via tc_parse_type. The union is interned (if the same
## member set was already registered, the same type ID is returned).
##
## @param tc    - Type checker state
## @param parts - Vec of member type annotation strings
## @returns Type ID: type_constants$TYPE_UNION_BASE + index
def tc_register_union(tc: TypecheckState, parts: Vec<String>): Int
  # Build canonical member string (sorted, pipe-separated)
  # For now, keep original order — canonicalization in Phase 2
  var member_str = ""
  for j in 0..parts.size
    if j > 0
      member_str = "#{member_str}|"
    end
    member_str = "#{member_str}#{parts[j]}"
  end

  # Check if this union was already registered (interning)
  var existing = tc.registry.union_member_strings
  for k in 0..existing.size
    if existing[k] == member_str
      return type_constants::TYPE_UNION_BASE + k
    end
  end

  # Register new union
  tc.registry.union_member_strings.push(member_str)
  tc.registry.union_type_names.push("")
  return type_constants::TYPE_UNION_BASE + tc.registry.union_member_strings.size - 1
end

## Split a type annotation on '&' at top-level (respect <>{} nesting depth).
## Returns a Vec of trimmed member strings. If no '&' found, returns a single-element Vec.
## Phase 8F: intersection type parsing.
def tc_split_type_intersection(annotation: String): Vec<String>
  var parts = vec_new<String>()
  var depth = 0
  var start = 0
  var i = 0
  var len = str_byte_len(annotation)
  while i < len
    var ch = str_byte_at(annotation, i)
    if ch == '<' or ch == '{'
      # '<' or '{'
      depth += 1
    end
    if ch == '>' or ch == '}'
      # '>' or '}'
      depth -= 1
    end
    if ch == '&' and depth == 0
      # '&' at top level
      var part = str_trim(str_byte_slice(annotation, start, i))
      if str_byte_len(part) > 0
        parts.push(part)
      end
      start = i + 1
    end
    i += 1
  end
  # Last segment
  var last_part = str_trim(str_byte_slice(annotation, start, len))
  if str_byte_len(last_part) > 0
    parts.push(last_part)
  end
  return parts
end

## Check if a type ID is a registered record type.
def tc_is_record_type(type_id: TypeId): Int = type_id >= type_constants::TYPE_RECORD_BASE and type_id < type_constants::TYPE_RECORD_BASE + 1000

## Get field names for a registered record type.
def tc_record_field_names(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_RECORD_BASE
  return tc.registry.record_field_names[idx]
end

## Get field types for a registered record type.
def tc_record_field_types(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_RECORD_BASE
  return tc.registry.record_field_types[idx]
end

## Parsed record annotation: parallel field-name / field-type-name vectors.
## `names[i]` is the i-th field's name; `types[i]` is its type annotation string.
## Replaces the prior positional `Vec<Int>` `[names_handle, types_handle]` tuple
## (which erased both `Vec<String>` handles through `as_int`) — N3.1 step-4 §11.35.
struct RecordFields
  names: Vec<String>
  types: Vec<String>
end

## Parse record annotation "{ x: Int, y: String }" into field names and types.
def tc_parse_record_fields(annotation: String): RecordFields
  var names = vec_new<String>()
  var types = vec_new<String>()
  # Strip "{ " prefix and " }" suffix
  var inner = annotation
  if inner.starts_with("{ ")
    inner = str_byte_slice(inner, 2, str_byte_len(inner))
  end
  if inner.ends_with(" }")
    inner = str_byte_slice(inner, 0, str_byte_len(inner) - 2)
  end
  # Split on ", " respecting <> nesting
  var depth = 0
  var start = 0
  for i in 0..str_byte_len(inner)
    var ch = str_byte_at(inner, i)
    if ch == '<'
      depth += 1
    end
    if ch == '>'
      depth -= 1
    end
    if ch == ',' and depth == 0
      # ',' at top level
      var field_str = str_trim(str_byte_slice(inner, start, i))
      if str_byte_len(field_str) > 0
        var colon_pos = __str_index(field_str, ": ")
        if colon_pos > 0
          names.push(str_byte_slice(field_str, 0, colon_pos))
          types.push(str_trim(str_byte_slice(field_str, colon_pos + 2, str_byte_len(field_str))))
        end
      end
      start = i + 1
    end
  end
  # Last field
  var last = str_trim(str_byte_slice(inner, start, str_byte_len(inner)))
  if str_byte_len(last) > 0
    var colon_pos = __str_index(last, ": ")
    if colon_pos > 0
      names.push(str_byte_slice(last, 0, colon_pos))
      types.push(str_trim(str_byte_slice(last, colon_pos + 2, str_byte_len(last))))
    end
  end
  return RecordFields { names: names, types: types }
end

## Register a record type. Interns by canonical signature.
## Returns type_constants$TYPE_RECORD_BASE + index.
def tc_register_record(tc: TypecheckState, field_names: Vec<String>, field_types: Vec<String>): Int
  # Build canonical signature for interning: "a:Int,b:String"
  var sig = ""
  for j in 0..field_names.size
    if j > 0
      sig += ","
    end
    sig += "#{field_names[j]}:#{field_types[j]}"
  end
  # Check for existing record with same signature
  for k in 0..tc.registry.record_signatures.size
    if tc.registry.record_signatures[k] == sig
      return type_constants::TYPE_RECORD_BASE + k
    end
  end
  # Register new record type
  tc.registry.record_signatures.push(sig)
  tc.registry.record_field_names.push(field_names)
  tc.registry.record_field_types.push(field_types)
  tc.registry.record_row_vars.push(0)
  # ROW Phase 2: Resolve field type strings to type IDs
  var field_ids = vec_new()
  for fi in 0..field_types.size
    field_ids.push(tc_parse_type(tc, field_types[fi]))
  end
  tc.registry.record_field_type_ids.push(field_ids)
  return type_constants::TYPE_RECORD_BASE + tc.registry.record_signatures.size - 1
end

## Register an open record type (with row variable).
## Same as tc_register_record but assigns a fresh row variable.
## Always creates a new entry (open records are not interned — each has a unique row var).
def tc_register_open_record(tc: TypecheckState, field_names: Vec<String>, field_types: Vec<String>): Int
  var sig = ""
  for j in 0..field_names.size
    if j > 0
      sig += ","
    end
    sig += "#{field_names[j]}:#{field_types[j]}"
  end
  # Open records always get a fresh entry (unique row variable)
  tc.registry.record_signatures.push(sig)
  tc.registry.record_field_names.push(field_names)
  tc.registry.record_field_types.push(field_types)
  tc.registry.record_row_vars.push(typecheck_util::tc_rv_fresh(tc))
  # ROW Phase 2: Resolve field type strings to type IDs
  var field_ids = vec_new()
  for fi in 0..field_types.size
    field_ids.push(tc_parse_type(tc, field_types[fi]))
  end
  tc.registry.record_field_type_ids.push(field_ids)
  return type_constants::TYPE_RECORD_BASE + tc.registry.record_signatures.size - 1
end

## Register a record type from pre-computed field type IDs.
## Always creates a fresh entry (used by substitution to avoid re-resolving).
def tc_register_record_with_ids(tc: TypecheckState, field_names: Vec<String>, field_types: Vec<String>, field_type_ids: Vec<Int>, row_var: Int): Int
  var sig = ""
  for j in 0..field_names.size
    if j > 0
      sig += ","
    end
    sig += "#{field_names[j]}:#{field_types[j]}"
  end
  tc.registry.record_signatures.push(sig)
  tc.registry.record_field_names.push(field_names)
  tc.registry.record_field_types.push(field_types)
  tc.registry.record_row_vars.push(row_var)
  tc.registry.record_field_type_ids.push(field_type_ids)
  return type_constants::TYPE_RECORD_BASE + tc.registry.record_signatures.size - 1
end

## Get resolved field type IDs for a registered record type.
def tc_record_field_type_ids(tc: TypecheckState, type_id: TypeId): Vec<Int>
  var idx = type_id - type_constants::TYPE_RECORD_BASE
  return tc.registry.record_field_type_ids[idx]
end

## Look up the type of a field in a record annotation string.
## annotation: record annotation like "{ x: Int, y: String }" or "{ x: Int | .. }"
## field_name: the field to look up
## Returns the resolved type ID, or TYPE_ERROR with error if field not found.
def tc_record_field_type(tc: TypecheckState, annotation: String, field_name: String, line: Int, col: Int): Int can Diag
  # Handle intersection annotations: "{ x: Int } & { y: Int }"
  # Split on " & " and search all parts
  var ann = annotation
  # Check for intersection — starts with "{ " and contains " & "
  if ann.contains(" & ")
    var parts = tc_split_type_intersection(ann)
    for pi in 0..parts.size
      var part = parts[pi]
      if part.starts_with("{ ")
        var result = tc_record_field_type_in_single(tc, part, field_name)
        if result != type_constants::TYPE_ERROR
          return result
        end
      end
    end
    # Field not found in any intersection part
    var isect_suggestion = tc_suggest(field_name, tc_record_field_names_of(annotation))
    error("Record type #{annotation} has no field '#{field_name}'#{isect_suggestion}", line, col)
    return type_constants::TYPE_ERROR
  end
  # Single record annotation
  var result = tc_record_field_type_in_single(tc, ann, field_name)
  if result != type_constants::TYPE_ERROR
    return result
  end
  var rec_suggestion = tc_suggest(field_name, tc_record_field_names_of(annotation))
  error("Record type #{annotation} has no field '#{field_name}'#{rec_suggestion}", line, col)
  return type_constants::TYPE_ERROR
end

## Collect the field names declared in a record annotation string
## (e.g. "{ x: Int, y: String }" → ["x", "y"]). Handles intersection
## annotations by unioning field names across all "{ ... }" parts. Used to
## power a field-name "did you mean?" suggestion on record field errors.
def tc_record_field_names_of(annotation: String): Vec<String>
  var out = vec_new<String>()
  var ann = annotation
  if ann.contains(" & ")
    var parts = tc_split_type_intersection(ann)
    for pi in 0..parts.size
      var part = parts[pi]
      if part.starts_with("{ ")
        var clean = part
        if clean.ends_with("| .. }")
          clean = str_byte_slice(clean, 0, str_byte_len(clean) - 6)
          clean = "#{str_trim(clean)} }"
        end
        var parsed = tc_parse_record_fields(clean)
        var names = parsed.names
        for ni in 0..vec_size(names)
          out.push(names[ni])
        end
      end
    end
    return out
  end
  var clean_ann = ann
  if clean_ann.ends_with("| .. }")
    clean_ann = str_byte_slice(clean_ann, 0, str_byte_len(clean_ann) - 6)
    clean_ann = "#{str_trim(clean_ann)} }"
  end
  var single = tc_parse_record_fields(clean_ann)
  var single_names = single.names
  for si in 0..vec_size(single_names)
    out.push(single_names[si])
  end
  return out
end

## Look up field type in a single record annotation (no intersection splitting).
def tc_record_field_type_in_single(tc: TypecheckState, annotation: String, field_name: String): Int
  # Strip "| .." suffix if present (open record)
  var clean_ann = annotation
  if clean_ann.ends_with("| .. }")
    clean_ann = str_byte_slice(clean_ann, 0, str_byte_len(clean_ann) - 6)
    clean_ann = "#{str_trim(clean_ann)} }"
  end
  var parsed = tc_parse_record_fields(clean_ann)
  var field_names = parsed.names
  var field_types = parsed.types
  for i in 0..vec_size(field_names)
    if field_names[i].eq(field_name)
      return tc_parse_type(tc, field_types[i])
    end
  end
  return type_constants::TYPE_ERROR
end

## Check if a type annotation string names a concrete primitive type.
## Concrete primitives are types that cannot structurally overlap.
## Returns true for Int, String, Bool, Void, F64, F32, I8..U32, etc.
def tc_is_primitive_annotation(annotation: String): Bool
  return true if annotation == "Int"
  return true if annotation == "String"
  return true if annotation == "Bool"
  return true if annotation == "Void"
  return true if annotation == "F64"
  return true if annotation == "F32"
  return true if annotation == "I8"
  return true if annotation == "I16"
  return true if annotation == "I32"
  return true if annotation == "U8"
  return true if annotation == "U16"
  return true if annotation == "U32"
  return true if annotation == "I64"
  return true if annotation == "U64"
  return true if annotation == "CInt"
  return true if annotation == "CChar"
  return true if annotation == "CPtr"
  return true if annotation == "CSize"
  return true if annotation == "Char"
  return true if annotation == "Symbol"
  return true if annotation == "Regex"
  return false
end

## Detect impossible intersection: if two distinct concrete primitives
## appear in the parts list, no value can inhabit the intersection.
## E.g. Int & String is impossible. Int & Int is fine (idempotent).
## Returns true if the intersection is uninhabitable.
def tc_is_impossible_intersection(parts: Vec<String>): Bool
  # Collect distinct primitive annotations
  var prims = vec_new<String>()
  for i in 0..parts.size
    var p = str_trim(parts[i])
    if tc_is_primitive_annotation(p)
      # Check if already in prims list
      var found = false
      var j = 0
      while j < prims.size
        if prims[j] == p
          found = true
        end
        j += 1
      end
      if found == false
        prims.push(p)
      end
    end
  end
  # If 2+ distinct primitives, impossible
  return prims.size >= 2
end

## Sort a Vec<String> alphabetically in-place (insertion sort).
## Used to canonicalize intersection parts so A & B == B & A.
def tc_sort_string_vec(parts: Vec<String>): Void
  var n = parts.size
  for i in 1..n
    var key = parts[i]
    var j = i - 1
    while j >= 0 and parts[j] > key
      parts[j + 1] = parts[j]
      j -= 1
    end
    parts[j + 1] = key
  end
end

## Get the human-readable display name for a registered intersection type.
## Returns "A & B" for the member parts.
def tc_intersection_display_name(tc: TypecheckState, type_id: TypeId): String
  var parts = tc_intersection_members(tc, type_id)
  if parts.size == 0
    return "Intersection"
  end
  var result = parts[0]
  for i in 1..parts.size
    result += " & #{parts[i]}"
  end
  return result
end

## Get the human-readable display name for a registered union type.
## Returns "A | B" for the member parts (mirrors tc_intersection_display_name).
def tc_union_display_name(tc: TypecheckState, type_id: TypeId): String
  var parts = tc_union_members(tc, type_id)
  if parts.size == 0
    return "Union"
  end
  var result = parts[0]
  for i in 1..parts.size
    result += " | #{parts[i]}"
  end
  return result
end

## Get the human-readable display name for a registered record type.
## Returns "{ x: Int, y: String }" for closed records, "{ x: Int | .. }" for open records.
def tc_record_display_name(tc: TypecheckState, type_id: TypeId): String
  var idx = type_id - type_constants::TYPE_RECORD_BASE
  var names = tc.registry.record_field_names[idx]
  var types = tc.registry.record_field_types[idx]
  var row_var = tc.registry.record_row_vars[idx]
  if names.size == 0
    if row_var != 0
      return "{ | .. }"
    end
    return "{}"
  end
  var result = "{ #{names[0]}: #{types[0]}"
  for i in 1..names.size
    result += ", #{names[i]}: #{types[i]}"
  end
  if row_var != 0
    result += " | .."
  end
  result += " }"
  return result
end

## Register an intersection type from a list of member annotation strings.
## If all parts are record types, merges their fields into a single record.
## Otherwise registers as TYPE_INTERSECTION_BASE + index with interning.
## Sorts parts alphabetically for canonical interning (A & B == B & A).
## Detects impossible intersections (e.g. Int & String) and returns TYPE_NEVER.
## Phase U.9: intersection type completion.
def tc_register_intersection(tc: TypecheckState, parts: Vec<String>): Int can Diag
  # Trim all parts
  var trimmed = vec_new<String>()
  var j = 0
  while j < parts.size
    trimmed.push(str_trim(parts[j]))
    j += 1
  end

  # Flatten idempotent: remove duplicates
  var deduped = vec_new<String>()
  j = 0
  while j < trimmed.size
    var dup = false
    for k in 0..deduped.size
      if deduped[k] == trimmed[j]
        dup = true
      end
    end
    if dup == false
      deduped.push(trimmed[j])
    end
    j += 1
  end

  # Single part after dedup: just return that type
  if deduped.size == 1
    return tc_parse_type(tc, deduped[0])
  end

  # Detect impossible intersections (incompatible primitives)
  if tc_is_impossible_intersection(deduped)
    var d = diagnostic::diag_new_simple(diagnostic::DIAG_ERROR, "QZ0150", "impossible intersection type — no value can satisfy all members")
    diagnostic::diag_emit(d)
    return type_constants::TYPE_NEVER
  end

  # Separate parts into record parts and non-record parts (U.9.7: mixed intersection)
  var record_parts = vec_new<String>()
  var non_record_parts = vec_new<String>()
  j = 0
  while j < deduped.size
    if deduped[j].starts_with("{ ")
      record_parts.push(deduped[j])
    else
      non_record_parts.push(deduped[j])
    end
    j += 1
  end

  # If ALL parts are records, merge and return a pure record type (existing behavior)
  if non_record_parts.size == 0 and record_parts.size > 0
    var merged_names = vec_new()
    var merged_types = vec_new()
    j = 0
    while j < record_parts.size
      var parsed = tc_parse_record_fields(record_parts[j])
      var field_names = parsed.names
      var field_types = parsed.types
      for k in 0..vec_size(field_names)
        var name = field_names[k]
        var type_str = field_types[k]
        # Check for duplicate field name
        var found = 0
        var m = 0
        while m < merged_names.size
          if as_string(merged_names[m]).eq(name)
            found = 1
            # Conflict detection: same name, different type
            if not as_string(merged_types[m]).eq(type_str)
              error("QZ0151: Intersection type has conflicting field '#{name}': '#{as_string(merged_types[m])}' vs '#{type_str}'", 0, 0)
            end
          end
          m += 1
        end
        if found == 0
          merged_names.push(as_int(name))
          merged_types.push(as_int(type_str))
        end
      end
      j += 1
    end
    return tc_register_record(tc, merged_names, merged_types)
  end

  # Mixed or pure non-record intersection
  # If we have record parts, merge them and store the merged fields
  var merged_rec_names = vec_new<String>()
  var merged_rec_types = vec_new<String>()
  if record_parts.size > 0
    j = 0
    while j < record_parts.size
      var parsed = tc_parse_record_fields(record_parts[j])
      var field_names = parsed.names
      var field_types = parsed.types
      for k in 0..vec_size(field_names)
        var name = field_names[k]
        var type_str = field_types[k]
        var found = 0
        var m = 0
        while m < merged_rec_names.size
          if merged_rec_names[m].eq(name)
            found = 1
            if not merged_rec_types[m].eq(type_str)
              error("QZ0151: Intersection type has conflicting field '#{name}': '#{merged_rec_types[m]}' vs '#{type_str}'", 0, 0)
            end
          end
          m += 1
        end
        if found == 0
          merged_rec_names.push(name)
          merged_rec_types.push(type_str)
        end
      end
      j += 1
    end
  end

  # Sort non-record parts for canonical form, then register
  tc_sort_string_vec(non_record_parts)

  # Build canonical member string: record signature (if any) + sorted non-record parts
  var all_parts = vec_new<String>()
  if merged_rec_names.size > 0
    # Build canonical record signature for the merged fields
    var rec_sig = "{ "
    j = 0
    while j < merged_rec_names.size
      if j > 0
        rec_sig += ", "
      end
      rec_sig += "#{merged_rec_names[j]}: #{merged_rec_types[j]}"
      j += 1
    end
    rec_sig += " }"
    all_parts.push(rec_sig)
  end
  j = 0
  while j < non_record_parts.size
    all_parts.push(non_record_parts[j])
    j += 1
  end

  var member_str = ""
  j = 0
  while j < all_parts.size
    if j > 0
      member_str = "#{member_str}&"
    end
    member_str = "#{member_str}#{all_parts[j]}"
    j += 1
  end

  # Check if this intersection was already registered (interning)
  var existing = tc.registry.intersection_member_strings
  for k in 0..existing.size
    if existing[k].eq(member_str)
      return type_constants::TYPE_INTERSECTION_BASE + k
    end
  end

  # Register new intersection with merged record fields
  tc.registry.intersection_member_strings.push(member_str)
  tc.registry.intersection_record_fields.push(merged_rec_names)
  tc.registry.intersection_record_types.push(merged_rec_types)
  return type_constants::TYPE_INTERSECTION_BASE + tc.registry.intersection_member_strings.size - 1
end

## Width/depth structural subtyping between two registered record types.
## Convention mirrors tc_types_match(tc, t1=required/expected, t2=provided/actual):
## the PROVIDED record (t2) must supply every field the REQUIRED record (t1)
## needs (width: extra provided fields OK); shared field types are covariant
## (depth: provided_field <: required_field). Leijen scoped labels — duplicate
## labels allowed, resolve to the FIRST occurrence on each side.
def tc_record_types_match(tc: TypecheckState, t1: TypeId, t2: TypeId): Int
  var req_names = tc_record_field_names(tc, t1)
  var req_tids = tc_record_field_type_ids(tc, t1)
  var prov_names = tc_record_field_names(tc, t2)
  var prov_tids = tc_record_field_type_ids(tc, t2)
  for i in 0..req_names.size
    var found = 0
    var k = 0
    while k < prov_names.size and found == 0
      if prov_names[k] == req_names[i]
        # First occurrence wins (scoped labels). Depth: provided <: required.
        # GAP-record-depth-accepts (3b): use the DISTINGUISHING field comparator
        # tc_elem_type_matches — its tight int group (Int/Bool/I*/U*/C*/Symbol —
        # NOT String) rejects `Int` required vs `String` provided, which the
        # i64-permissive tc_types_match wrongly accepted (both are i64 handles).
        # Its record/union branches recurse structurally so covariant depth on
        # record-typed fields still works; TYPE_UNKNOWN/TYPE_ERROR stay permissive.
        # Convention: tc_elem_type_matches(tc, actual=provided, expected=required).
        if tc_elem_type_matches(tc, prov_tids[k], req_tids[i])
          found = 1
        else
          return 0
        end
      end
      k += 1
    end
    if found == 0
      return 0
    end
  end
  return 1
end

## E1 diagnostics: explain WHY a provided record/struct fails to satisfy a
## required record type (width/depth subtyping). Mirrors the accept/reject logic
## of `tc_record_types_match` / `tc_struct_satisfies_record` exactly — it does
## NOT change any decision, it only reconstructs the first offending field so the
## caller can render a specific message instead of a bare "type mismatch".
##
## `required` MUST be a registered record type. `provided` may be a record type
## or a nominal struct id. Returns "" when no specific field-level reason can be
## given (e.g. provided is a bare TYPE_STRUCT with no field list, or the two are
## not a record/struct pair) — the caller then keeps its generic message.
def tc_record_mismatch_reason(tc: TypecheckState, required: TypeId, provided: TypeId): String
  if tc_is_record_type(required) == false
    return ""
  end
  var req_names = tc_record_field_names(tc, required)
  var req_tids = tc_record_field_type_ids(tc, required)

  # Resolve the provided side's field lists (record or nominal struct).
  var prov_names = vec_new<String>()
  var prov_tids = vec_new<Int>()
  if tc_is_record_type(provided)
    prov_names = tc_record_field_names(tc, provided)
    prov_tids = tc_record_field_type_ids(tc, provided)
  else
    var si = typecheck::tc_struct_idx_from_type(provided)
    if si < 0
      # Bare TYPE_STRUCT or unrelated type — no field list to inspect.
      return ""
    end
    prov_names = tc_struct_field_names(tc, si)
    prov_tids = tc_struct_field_types_vec(tc, si)
  end

  for i in 0..req_names.size
    var fname = req_names[i]
    var found = 0
    var depth_ok = 0
    var k = 0
    while k < prov_names.size and found == 0
      if prov_names[k] == fname
        found = 1
        # GAP-record-depth-accepts (3b): mirror the ENFORCEMENT comparator used by
        # tc_struct_satisfies_record / tc_record_types_match so this diagnostic
        # reaches the depth-wording branch exactly when the check rejects. The
        # i64-permissive tc_types_match would set depth_ok=1 for Int-vs-String and
        # suppress the specific field-type message. Convention: (actual=provided,
        # expected=required).
        if typecheck::tc_elem_type_matches(tc, prov_tids[k], req_tids[i])
          depth_ok = 1
        else
          var want = typecheck::tc_type_name_full(tc, req_tids[i])
          var got = typecheck::tc_type_name_full(tc, prov_tids[k])
          return "field '#{fname}' has type '#{got}', expected '#{want}'"
        end
      end
      k += 1
    end
    if found == 0
      return "missing field '#{fname}'"
    end
  end
  return ""
end

## Does a concrete/nominal struct (struct_tid) satisfy a record requirement
## (record_tid)? Width/depth subtyping: the struct must supply every field the
## record needs, with covariant field types. Bare TYPE_STRUCT (no registry idx)
## carries no field list → stays permissive (caller handles that case).
def tc_struct_satisfies_record(tc: TypecheckState, struct_tid: TypeId, record_tid: TypeId): Int
  var si = typecheck::tc_struct_idx_from_type(struct_tid)
  if si < 0
    return 1
  end
  var s_names = tc_struct_field_names(tc, si)
  var s_tids = tc_struct_field_types_vec(tc, si)
  var req_names = tc_record_field_names(tc, record_tid)
  var req_tids = tc_record_field_type_ids(tc, record_tid)
  for i in 0..req_names.size
    var found = 0
    var k = 0
    while k < s_names.size and found == 0
      if s_names[k] == req_names[i]
        # GAP-record-depth-accepts (3b): distinguishing field comparator — see
        # tc_record_types_match. Rejects wrong-primitive fields (Int req vs String
        # provided); recurses for record/union-typed fields (covariant depth);
        # unclassifiable (UNKNOWN/ERROR) stays permissive.
        # Convention: tc_elem_type_matches(tc, actual=provided struct field, expected=required).
        if tc_elem_type_matches(tc, s_tids[k], req_tids[i])
          found = 1
        else
          return 0
        end
      end
      k += 1
    end
    if found == 0
      return 0
    end
  end
  return 1
end

## Does a record (record_tid) satisfy a concrete/nominal struct slot
## (struct_tid)? The record must supply every field the struct declares, with
## covariant field types. Bare TYPE_STRUCT (no idx) → permissive.
def tc_record_satisfies_struct(tc: TypecheckState, record_tid: TypeId, struct_tid: TypeId): Int
  var si = typecheck::tc_struct_idx_from_type(struct_tid)
  if si < 0
    return 1
  end
  var s_names = tc_struct_field_names(tc, si)
  var s_tids = tc_struct_field_types_vec(tc, si)
  var prov_names = tc_record_field_names(tc, record_tid)
  var prov_tids = tc_record_field_type_ids(tc, record_tid)
  for i in 0..s_names.size
    var found = 0
    var k = 0
    while k < prov_names.size and found == 0
      if prov_names[k] == s_names[i]
        # GAP-record-depth-accepts (3b): distinguishing field comparator — see
        # tc_record_types_match. Rejects wrong-primitive fields; recurses for
        # record/union-typed fields (covariant depth); UNKNOWN/ERROR stays permissive.
        # Convention: tc_elem_type_matches(tc, actual=provided record field, expected=required struct field).
        if tc_elem_type_matches(tc, prov_tids[k], s_tids[i])
          found = 1
        else
          return 0
        end
      end
      k += 1
    end
    if found == 0
      return 0
    end
  end
  return 1
end

## Get the member type annotation strings for a union type ID.
## @param tc      - Type checker state
## @param type_id - A type_constants$TYPE_UNION_BASE + index type ID
## @returns Vec<String> of member annotation strings
def tc_union_members(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_UNION_BASE
  if idx < 0 or idx >= tc.registry.union_member_strings.size
    var empty = vec_new<String>()
    return empty
  end
  return tc_split_type_union(tc.registry.union_member_strings[idx])
end

## Get the member type IDs for a union type ID (resolves each member).
## @param tc      - Type checker state
## @param type_id - A type_constants$TYPE_UNION_BASE + index type ID
## @returns Vec<Int> of resolved member type IDs
def tc_union_member_types(tc: TypecheckState, type_id: TypeId): Vec<Int>
  var parts = tc_union_members(tc, type_id)
  var types = vec_new()
  for i in 0..parts.size
    types.push(tc_parse_type(tc, parts[i]))
  end
  return types
end

## Check if a type ID represents a union type (2000..2999 range only).
def tc_is_union_type(type_id: TypeId): Bool = type_id >= type_constants::TYPE_UNION_BASE and type_id < type_constants::TYPE_RECORD_BASE

## Does this union type list `Nil` as an explicit member? (B.15c arg-site)
##
## A union like `Int | Nil` is the union-world spelling of "nullable", so a
## bare `nil` literal is a legitimate inhabitant and must NOT trip the QZ0213
## nil-literal wall. The check keys off the surface member spelling ("Nil"),
## which `tc_register_union` preserves verbatim in `union_member_strings` — so
## it is exact: a real `Int` member is spelled "Int", never "Nil". Returns 0
## for non-unions and for unions without a `Nil` member.
def tc_union_contains_nil(tc: TypecheckState, type_id: TypeId): Int
  return 0 if tc_is_union_type(type_id) == false
  var members = tc_union_members(tc, type_id)
  for i in 0..members.size
    if str_trim(members[i]) == "Nil"
      return 1
    end
  end
  return 0
end

# ============================================================================
# Intersection Type Helpers (Phase U.9)
# ============================================================================

## Check if a type ID represents a registered intersection type (4000+ range).
def tc_is_intersection_type(type_id: TypeId): Bool = type_id >= type_constants::TYPE_INTERSECTION_BASE and type_id < type_constants::TYPE_INTERSECTION_BASE + 1000

## Get the member annotation strings for a registered intersection type ID.
## @param tc      - Type checker state
## @param type_id - A TYPE_INTERSECTION_BASE + index type ID  
## @returns Vec<String> of member annotation strings (e.g. ["Eq", "Ord"])
def tc_intersection_members(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_INTERSECTION_BASE
  if idx < 0 or idx >= tc.registry.intersection_member_strings.size
    var empty = vec_new<String>()
    return empty
  end
  return tc_split_type_intersection(tc.registry.intersection_member_strings[idx])
end

## Get the resolved member type IDs for a registered intersection type.
## @param tc      - Type checker state
## @param type_id - A TYPE_INTERSECTION_BASE + index type ID
## @returns Vec<Int> of resolved member type IDs
def tc_intersection_member_types(tc: TypecheckState, type_id: TypeId): Vec<Int>
  var parts = tc_intersection_members(tc, type_id)
  var types = vec_new()
  for i in 0..parts.size
    types.push(tc_parse_type(tc, parts[i]))
  end
  return types
end

## Get the merged record field names for a compound intersection type (U.9.7).
## Returns empty Vec if the intersection has no record component.
def tc_intersection_record_field_names(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_INTERSECTION_BASE
  if idx < 0 or idx >= tc.registry.intersection_record_fields.size
    var empty = vec_new<String>()
    return empty
  end
  return tc.registry.intersection_record_fields[idx]
end

## Get the merged record field types for a compound intersection type (U.9.7).
## Returns empty Vec if the intersection has no record component.
def tc_intersection_record_field_types(tc: TypecheckState, type_id: TypeId): Vec<String>
  var idx = type_id - type_constants::TYPE_INTERSECTION_BASE
  if idx < 0 or idx >= tc.registry.intersection_record_types.size
    var empty = vec_new<String>()
    return empty
  end
  return tc.registry.intersection_record_types[idx]
end

# ============================================================================
# Move Semantics
# ============================================================================

## Check if a type needs move tracking (linear struct OR has Drop impl, and NOT Copy).
## Returns 1 if the type participates in move semantics, 0 otherwise.
def tc_type_needs_move_tracking(tc: TypecheckState, struct_name: String): Int
  return 0 if str_byte_len(struct_name) == 0
  # Copy types are never move-tracked
  return 0 if tc_type_is_copy(tc, struct_name)
  # Linear structs are already tracked by the linear system
  if tc_struct_is_linear(tc, struct_name)
    return 1
  end
  # Structs with Drop impl need move tracking
  if tc_struct_has_drop(tc, struct_name)
    return 1
  end
  return 0
end

## Check if a type is registered as Copy.
def tc_type_is_copy(tc: TypecheckState, struct_name: String): Int
  var copy_types = tc.safety.copy_types
  for i in 0..copy_types.size
    if copy_types[i] == struct_name
      return 1
    end
  end
  return 0
end

## Register a type as implementing Copy (dedup).
def tc_register_copy_type(tc: TypecheckState, struct_name: String): Void
  return if tc_type_is_copy(tc, struct_name)
  tc.safety.copy_types.push(struct_name)
end

## Mark a binding as moveable (state=Live) for move tracking.
def tc_mark_binding_moveable(tc: TypecheckState, name: String, type_name: String): Void
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(name)
      tc.safety.move_states[i] = 1
      tc.safety.move_types[i] = type_name
      return
    end
    i -= 1
  end
end

## Build QZ1212 error message.
def tc_move_error_msg(name: String, prev_target: String, prev_line: Int): String = "QZ1212: Use of moved value '#{name}' (moved to '#{prev_target}' at line #{prev_line})"

## Move a value from src to target. Sets src state to Moved (2).
## Reports QZ1212 if src was already moved.
def tc_move_value(tc: TypecheckState, src: String, target: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(src)
        var state = tc.safety.move_states[i]
        if state == 0
          return
        end
        if state == 2
          var prev_target = tc.safety.move_targets[i]
          var prev_line = tc.safety.move_lines[i]
          error(tc_move_error_msg(src, prev_target, prev_line), line, col)
          return
        end
        # Cannot move a borrowed value
        if tc.safety.binding_borrow_states[i] != 0
          var borrow_line = tc.safety.binding_borrow_lines[i]
          error("QZ1212: Cannot move '#{src}' while it is borrowed (borrow created at line #{borrow_line})", line, col)
          return
        end
        tc.safety.move_states[i] = 2
        tc.safety.move_targets[i] = target
        tc.safety.move_lines[i] = line
        tc.safety.move_cols[i] = col
        return
      end
    end
    i -= 1
  end
end

## Check that a binding has not been moved. Reports QZ1212 if moved.
def tc_check_not_moved(tc: TypecheckState, name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        if tc.safety.move_states[i] == 2
          var prev_target = tc.safety.move_targets[i]
          var prev_line = tc.safety.move_lines[i]
          error(tc_move_error_msg(name, prev_target, prev_line), line, col)
        end
        return
      end
    end
    i -= 1
  end
end

## Move a value on function call or return. Checks state and marks as moved.
## Skips non-tracked bindings (state == 0).
def tc_move_on_call(tc: TypecheckState, name: String, callee: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        var state = tc.safety.move_states[i]
        if state == 0
          return
        end
        if state == 2
          var prev_target = tc.safety.move_targets[i]
          var prev_line = tc.safety.move_lines[i]
          error(tc_move_error_msg(name, prev_target, prev_line), line, col)
          return
        end
        # Cannot move a borrowed value
        if tc.safety.binding_borrow_states[i] != 0
          var borrow_line = tc.safety.binding_borrow_lines[i]
          error("QZ1212: Cannot move '#{name}' while it is borrowed (borrow created at line #{borrow_line})", line, col)
          return
        end
        tc.safety.move_states[i] = 2
        tc.safety.move_targets[i] = callee
        tc.safety.move_lines[i] = line
        tc.safety.move_cols[i] = col
        return
      end
    end
    i -= 1
  end
end

## Snapshot move states for control flow analysis.
def tc_snapshot_move_states(tc: TypecheckState): Vec<Int>
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var snapshot = vec_new()
  for i in 0..binding_count
    snapshot.push(tc.safety.move_states[i])
  end
  return snapshot
end

## Restore move states from snapshot.
def tc_restore_move_states(tc: TypecheckState, snapshot: Vec<Int>): Void
  var count = snapshot.size
  for i in 0..count
    tc.safety.move_states[i] = snapshot[i]
  end
end

## Merge move states from two branches. Reports QZ1214 for inconsistencies.
def tc_merge_move_states(tc: TypecheckState, states_a: Vec<Int>, states_b: Vec<Int>, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var count = states_a.size
  if states_b.size < count
    count = states_b.size
  end
  for i in 0..count
    var sa = states_a[i]
    var sb = states_b[i]
    if sa == 0 and sb == 0
      # Both free — skip
    elsif sa == sb
      # Both agree — keep that state
      tc.safety.move_states[i] = sa
    else
      # Disagreement — one moved, other not
      if sa != 0 or sb != 0
        # At least one is tracked
        if sa == 2 or sb == 2
          var bname = binding_names[i]
          var bmsg = "QZ1214: Value '#{bname}' is moved in one branch but not the other"
          error(bmsg, line, col)
          # Conservative: mark as moved
          tc.safety.move_states[i] = 2
        end
      end
    end
  end
end

# ============================================================================
# Partial Move Tracking (S2.P)
# ============================================================================

## Check if a specific field has been partially moved from a binding.
## Returns 1 if the field is in the moved-fields list, 0 otherwise.
def tc_is_field_moved(tc: TypecheckState, binding_index: Int, field_name: String): Int
  var fields_str = tc.safety.partial_moved_fields[binding_index]
  if str_byte_len(fields_str) == 0
    return 0
  end
  # Check comma-separated list for exact field name match
  var start = 0
  var len = str_byte_len(fields_str)
  var i = 0
  while i <= len
    var at_end = i == len
    var is_comma = false
    if at_end == false
      is_comma = str_byte_at(fields_str, i) == ','
    end
    if is_comma or at_end
      var part = str_byte_slice(fields_str, start, i)
      if part == field_name
        return 1
      end
      start = i + 1
    end
    i += 1
  end
  return 0
end

## Does reading `<struct_name>.<field_name>` move the field?
##
## Copy-type fields (Int/Bool/Float/String/... and any registered Copy or
## non-Drop/non-linear struct) are *copied* by a read, not moved. Only a field
## whose own type needs move tracking (a nested Drop/linear struct) is partially
## moved when read. Gate partial-move recording on this so idiomatic Drop bodies
## that read a primitive field into a call (`str_from_int(self.x)`) are not
## rejected with a bogus QZ1216 (D6 gap fix, 2026-07-05).
def tc_field_read_moves(tc: TypecheckState, struct_name: String, field_name: String): Int
  match tc_lookup_struct(tc, struct_name)
    Found(si) =>
      var field_ann = tc_struct_field_annotation(tc, si, field_name)
      # Empty annotation → unknown field type; conservatively fall back to the
      # legacy behavior (treat as move) to avoid changing unrelated code paths.
      return 1 if str_byte_len(field_ann) == 0
      return tc_type_needs_move_tracking(tc, field_ann)
    NotFound => return 1
  end
  return 1
end

## Record a partial move of a specific field from a binding.
## Appends the field to the comma-separated moved-fields list.
def tc_partial_move_field(tc: TypecheckState, binding_name: String, field_name: String, target: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(binding_name)
      # Check if field was already moved
      if tc_is_field_moved(tc, i, field_name)
        var prev_targets = tc.safety.partial_move_targets[i]
        var prev_lines = tc.safety.partial_move_lines[i]
        error("QZ1216: Use of moved field '#{binding_name}.#{field_name}' (moved at line #{prev_lines})", line, col)
        return
      end
      # Append to moved fields
      var fields = tc.safety.partial_moved_fields[i]
      if str_byte_len(fields) > 0
        tc.safety.partial_moved_fields[i] = "#{fields},#{field_name}"
        tc.safety.partial_move_targets[i] = "#{tc.safety.partial_move_targets[i]},#{target}"
        tc.safety.partial_move_lines[i] = "#{tc.safety.partial_move_lines[i]},#{line.to_s()}"
      else
        tc.safety.partial_moved_fields[i] = field_name
        tc.safety.partial_move_targets[i] = target
        tc.safety.partial_move_lines[i] = line.to_s()
      end
      return
    end
    i -= 1
  end
end

## Check that a specific field has not been partially moved.
## Reports QZ1216 if the field was moved.
def tc_check_field_not_moved(tc: TypecheckState, binding_name: String, field_name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(binding_name)
      if tc_is_field_moved(tc, i, field_name)
        var prev_lines = tc.safety.partial_move_lines[i]
        error("QZ1216: Use of moved field '#{binding_name}.#{field_name}' (moved at line #{prev_lines})", line, col)
      end
      return
    end
    i -= 1
  end
end

## Clear a specific field from the partial-move tracking for a binding.
## Called when a field is re-initialized (e.g., r.x = new_value after move of r.x).
def tc_clear_partial_move_field(tc: TypecheckState, binding_name: String, field_name: String): Void
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(binding_name)
      if tc_is_field_moved(tc, i, field_name) == 0
        return
      end
      # Rebuild the comma-separated lists without this field
      var old_fields = tc.safety.partial_moved_fields[i]
      var old_targets = tc.safety.partial_move_targets[i]
      var old_lines = tc.safety.partial_move_lines[i]
      var new_fields = ""
      var new_targets = ""
      var new_lines = ""
      # Parse all three lists in sync
      var f_start = 0
      var t_start = 0
      var l_start = 0
      var f_pos = 0
      var t_pos = 0
      var l_pos = 0
      while f_pos <= str_byte_len(old_fields)
        var f_at_end = f_pos == str_byte_len(old_fields)
        var f_is_comma = false
        if f_at_end == false
          f_is_comma = str_byte_at(old_fields, f_pos) == ','
        end
        if f_is_comma or f_at_end
          var f_part = str_byte_slice(old_fields, f_start, f_pos)
          # Advance target position to matching comma
          while t_pos < str_byte_len(old_targets)
            if str_byte_at(old_targets, t_pos) == ','
              break
            end
            t_pos += 1
          end
          var t_part = str_byte_slice(old_targets, t_start, t_pos)
          t_pos += 1
          t_start = t_pos
          # Advance line position to matching comma
          while l_pos < str_byte_len(old_lines)
            if str_byte_at(old_lines, l_pos) == ','
              break
            end
            l_pos += 1
          end
          var l_part = str_byte_slice(old_lines, l_start, l_pos)
          l_pos += 1
          l_start = l_pos
          # Keep this entry only if it's not the field we're clearing
          if f_part != field_name
            if str_byte_len(new_fields) > 0
              new_fields += ",#{f_part}"
              new_targets += ",#{t_part}"
              new_lines += ",#{l_part}"
            else
              new_fields = f_part
              new_targets = t_part
              new_lines = l_part
            end
          end
          f_start = f_pos + 1
        end
        f_pos += 1
      end
      tc.safety.partial_moved_fields[i] = new_fields
      tc.safety.partial_move_targets[i] = new_targets
      tc.safety.partial_move_lines[i] = new_lines
      return
    end
    i -= 1
  end
end

## Check that no fields have been partially moved from a binding.
## Use this before whole-struct operations (pass by value, return, etc.).
## Reports QZ1216 if any fields have been moved.
def tc_check_not_partially_moved(tc: TypecheckState, binding_name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i].eq(binding_name)
      var fields = tc.safety.partial_moved_fields[i]
      if str_byte_len(fields) > 0
        error("QZ1216: Cannot use '#{binding_name}' because field(s) #{fields} have been moved out", line, col)
      end
      return
    end
    i -= 1
  end
end

## Snapshot partial move states for control flow analysis.
def tc_snapshot_partial_moves(tc: TypecheckState): Vec<String>
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var snapshot = vec_new<String>()
  for i in 0..binding_count
    snapshot.push(tc.safety.partial_moved_fields[i])
  end
  return snapshot
end

## Restore partial move states from snapshot.
def tc_restore_partial_moves(tc: TypecheckState, snapshot: Vec<String>): Void
  var count = snapshot.size
  for i in 0..count
    tc.safety.partial_moved_fields[i] = snapshot[i]
  end
end

## Merge partial move states from two branches.
## If a field is moved in either branch, it must be moved in both.
def tc_merge_partial_moves(tc: TypecheckState, states_a: Vec<String>, states_b: Vec<String>, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var count = states_a.size
  if states_b.size < count
    count = states_b.size
  end
  for i in 0..count
    var fa = states_a[i]
    var fb = states_b[i]
    if str_byte_len(fa) == 0 and str_byte_len(fb) == 0
      # No partial moves in either branch
      tc.safety.partial_moved_fields[i] = ""
    elsif fa == fb
      # Same fields moved in both branches
      tc.safety.partial_moved_fields[i] = fa
    else
      # Disagreement — conservative: merge both
      if str_byte_len(fa) > 0 and str_byte_len(fb) > 0
        # Both have moves but different fields
        var bname = binding_names[i]
        error("QZ1216: Partial moves of '#{bname}' disagree between branches (then: #{fa}, else: #{fb})", line, col)
        tc.safety.partial_moved_fields[i] = "#{fa},#{fb}"
      elsif str_byte_len(fa) > 0
        var bname = binding_names[i]
        error("QZ1216: Field(s) #{fa} of '#{bname}' moved in one branch but not the other", line, col)
        tc.safety.partial_moved_fields[i] = fa
      else
        var bname = binding_names[i]
        error("QZ1216: Field(s) #{fb} of '#{bname}' moved in one branch but not the other", line, col)
        tc.safety.partial_moved_fields[i] = fb
      end
    end
  end
end

# ============================================================================
# Function Type Registry
# ============================================================================

## Register a function type signature and return its ID.
## Deduplicates: if an identical annotation already exists, returns existing ID.
def tc_register_fn_type(tc: TypecheckState, annotation: String, param_count: Int, return_type: Int): Int
  var count = tc.registry.fn_type_annotations.size
  for i in 0..count
    if tc.registry.fn_type_annotations[i] == annotation
      return i
    end
  end
  tc.registry.fn_type_annotations.push(annotation)
  tc.registry.fn_type_param_counts.push(param_count)
  tc.registry.fn_type_return_types.push(return_type)
  tc.registry.fn_type_param_types.push(vec_new())
  tc.registry.fn_type_effect_bounds.push(0)
  tc.registry.fn_type_can_row_idx.push(-1)
  return count
end

## P3.F.2: Record the generalized ervs for a function whose signature just
## finished being walked. The ervs are copied (not moved) so the caller may
## drop its own vec. Idempotent per func_idx — latest call wins.
def tc_set_func_generalized_ervs(tc: TypecheckState, func_idx: Int, ervs: Vec<Int>): Void
  if func_idx < 0 or func_idx >= tc.registry.func_generalized_ervs.size
    return
  end
  var copy = vec_new()
  for i in 0..ervs.size
    copy.push(ervs[i])
  end
  tc.registry.func_generalized_ervs[func_idx] = copy
end

## P3.F.2: Read the generalized ervs for a function. Returns an empty vec
## for functions that declared no row-var type-params.
def tc_get_func_generalized_ervs(tc: TypecheckState, func_idx: Int): Vec<Int>
  if func_idx < 0 or func_idx >= tc.registry.func_generalized_ervs.size
    return vec_new()
  end
  return tc.registry.func_generalized_ervs[func_idx]
end

## P3.F.2: Instantiate a callee row at a call site by substituting each
## generalized erv with a fresh erv. Returns a new row_id with the same
## labels but a tail that's a fresh variable (if the callee's tail was
## one of the generalized ervs). If the tail is NOT generalized, returns
## the row unchanged. This keeps each call of a polymorphic function
## independent — two call sites can bind the same row-var to different
## concrete rows without clashing.
def tc_row_instantiate_for_call(tc: TypecheckState, row_id: Int, generalized_ervs: Vec<Int>): Int
  if row_id < 0
    return row_id
  end
  if generalized_ervs.size == 0
    return row_id
  end
  # Read the ORIGINAL tail — do NOT walk. Once a previous call site has
  # bound the generalized erv, walking would follow the binding into a
  # concrete row and we'd miss the need to instantiate. The point of
  # instantiation is precisely to give each call its own fresh erv.
  var tail = tc_row_get_tail(tc, row_id)
  if tail <= 0
    return row_id
  end
  var is_generalized = false
  for i in 0..generalized_ervs.size
    if generalized_ervs[i] == tail
      is_generalized = true
    end
  end
  if is_generalized == false
    return row_id
  end
  var labels = tc_row_get_labels(tc, row_id)
  var labels_copy = vec_new()
  for i in 0..labels.size
    labels_copy.push(labels[i])
  end
  var fresh_tail = typecheck_util::tc_erv_fresh(tc)
  return tc_row_new(tc, labels_copy, fresh_tail)
end

## P3.F.2: Attach a `can` row to a registered fn type. Idempotent —
## overwriting with the same row_id is fine; two callers registering the
## same fn-annotation with different row tails will be distinguished by
## the annotation itself (tail names survive normalization).
def tc_fn_type_set_can_row(tc: TypecheckState, fn_type_id: Int, row_id: Int): Void
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_can_row_idx.size
    return
  end
  tc.registry.fn_type_can_row_idx[fn_type_id] = row_id
end

## P3.F.2: Read the `can` row attached to a fn type.
## Returns -1 if no row was attached (untracked / pure Fn in old sense).
def tc_fn_type_get_can_row(tc: TypecheckState, fn_type_id: Int): Int
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_can_row_idx.size
    return -1
  end
  return tc.registry.fn_type_can_row_idx[fn_type_id]
end

## Get the param count of a registered fn type.
def tc_fn_type_param_count(tc: TypecheckState, fn_type_id: Int): Int
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_param_counts.size
    return 0
  end
  return tc.registry.fn_type_param_counts[fn_type_id]
end

## Get the return type of a registered fn type.
def tc_fn_type_return_type(tc: TypecheckState, fn_type_id: Int): Int
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_return_types.size
    return type_constants::TYPE_INT
  end
  return tc.registry.fn_type_return_types[fn_type_id]
end

## Get the full annotation string of a registered fn type.
def tc_fn_type_annotation(tc: TypecheckState, fn_type_id: Int): String
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_annotations.size
    return ""
  end
  return tc.registry.fn_type_annotations[fn_type_id]
end

## Get the Nth param type of a registered fn type (T3c.1 Phase 3).
## Returns TYPE_ERROR if out of range.
def tc_fn_type_param_type_at(tc: TypecheckState, fn_type_id: Int, n: Int): Int
  if fn_type_id < 0 or fn_type_id >= tc.registry.fn_type_param_types.size
    return type_constants::TYPE_ERROR
  end
  var params = tc.registry.fn_type_param_types[fn_type_id]
  if n < 0 or n >= params.size
    return type_constants::TYPE_ERROR
  end
  return params[n]
end

## Register a fn type directly from resolved type IDs (T3c.1 Phase 3).
## Used by tc_tv_substitute to create fn types during instantiation.
## Returns the ptype ID for the function type.
def tc_make_fn_type_from_types(tc: TypecheckState, param_types: Vec<Int>, return_type: Int): Int
  var param_count = param_types.size
  # Build synthetic annotation for dedup
  var ann = "Fn("
  for i in 0..param_count
    if i > 0
      ann = "#{ann}, "
    end
    ann = "#{ann}#{typecheck_util::tc_tv_type_name(tc, param_types[i])}"
  end
  ann = "#{ann}): #{typecheck_util::tc_tv_type_name(tc, return_type)}"
  # Don't dedup synthetic annotations containing type vars — they may resolve differently
  var fn_id = tc.registry.fn_type_annotations.size
  tc.registry.fn_type_annotations.push(ann)
  tc.registry.fn_type_param_counts.push(param_count)
  tc.registry.fn_type_return_types.push(return_type)
  tc.registry.fn_type_param_types.push(param_types)
  tc.registry.fn_type_effect_bounds.push(0)
  return typecheck::tc_make_ptype(tc, type_constants::TYPE_FUNCTION, fn_id, 0)
end

# ============================================================================
# impl Trait Return Type Registry
# ============================================================================

## Register a function's impl Trait return type with its resolved concrete type.
def tc_register_impl_return(tc: TypecheckState, func_name: String, concrete_type: String, trait_name: String): Void
  tc.registry.impl_return_func_names.push(func_name)
  tc.registry.impl_return_concrete_types.push(concrete_type)
  tc.registry.impl_return_trait_names.push(trait_name)
end

## Look up the concrete type for a function returning impl Trait.
## Returns the concrete type string, or "" if not found.
def tc_lookup_impl_return(tc: TypecheckState, func_name: String): String
  var names = tc.registry.impl_return_func_names
  var count = names.size
  for i in 0..count
    if names[i].eq(func_name)
      return tc.registry.impl_return_concrete_types[i]
    end
  end
  # Fallback: suffix match for cross-module calls
  var suffix = "$#{func_name}"
  for i in 0..count
    if str_ends_with(names[i], suffix)
      return tc.registry.impl_return_concrete_types[i]
    end
  end
  return ""
end

## Check if a function has an impl Trait return type.
def tc_is_impl_return(tc: TypecheckState, func_name: String): Bool
  var concrete = tc_lookup_impl_return(tc, func_name)
  return str_byte_len(concrete) > 0
end

## Phase 7: build the opaque marker for an impl Trait function return.
## Returns "impl <Trait>@<func_name>" when the function is registered as
## returning impl Trait, or "" otherwise. The exact-match key is preferred;
## a suffix-match fallback handles cross-module resolution the same way
## tc_lookup_impl_return does.
def tc_lookup_impl_return_opaque(tc: TypecheckState, func_name: String): String
  var names = tc.registry.impl_return_func_names
  var count = names.size
  for i in 0..count
    if names[i].eq(func_name)
      var trait_name = tc.registry.impl_return_trait_names[i]
      var canonical = names[i]
      return "impl #{trait_name}@#{canonical}"
    end
  end
  var suffix = "$#{func_name}"
  for i in 0..count
    if str_ends_with(names[i], suffix)
      var trait_name = tc.registry.impl_return_trait_names[i]
      var canonical = names[i]
      return "impl #{trait_name}@#{canonical}"
    end
  end
  return ""
end

## Phase 7: classify a string as an opaque marker.
def tc_is_opaque_marker(s: String): Bool
  return false if str_byte_len(s) < 5
  return s.starts_with("impl ")
end

# ============================================================================
# Send/Sync Type Classification (T3.1)
# ============================================================================

# Cycle guard for recursive Send/Sync checks on structs/enums.
var g_send_checking = vec_new<String>()
var g_sync_checking = vec_new<String>()

## Check if a type is Send (safe to transfer to another thread).
##
## Classification:
## - Primitives (Int, Bool, F64, Symbol, String): Send
## - Concurrency types (AtomicInt, Mutex, Channel): Send
## - Vec, Map, Set, StringBuilder: Send
## - CPtr: NOT Send
## - Structs/Enums: Send if all fields/payloads are Send
## - Explicit `impl Send for T` overrides default
##
## Parameters:
##   tc          - Type checker context
##   type_id     - Type kind constant
##   struct_name - Struct/enum name (for structural checks)
##
## Returns: 1 if Send, 0 if not Send
def tc_type_is_send(tc: TypecheckState, type_id: Int, struct_name: String): Int
  # Negative impl wins first — `impl !Send for X` always rejects, even
  # when a positive impl or structural analysis would otherwise allow.
  if str_byte_len(struct_name) > 0
    if tc_lookup_neg_impl(tc, "Send", struct_name) >= 0
      return 0
    end
  end
  # Explicit impl wins
  if str_byte_len(struct_name) > 0
    if tc_lookup_impl(tc, "Send", struct_name) >= 0
      return 1
    end
  end

  # Primitives: always Send
  if type_id == type_constants::TYPE_INT
    return 1
  end
  if type_id == type_constants::TYPE_BOOL
    return 1
  end
  if type_id == type_constants::TYPE_STRING
    return 1
  end
  if type_id == type_constants::TYPE_F64
    return 1
  end
  if type_id == type_constants::TYPE_SYMBOL
    return 1
  end
  if type_id == type_constants::TYPE_VOID
    return 1
  end
  if type_id == type_constants::TYPE_F32
    return 1
  end
  if type_id == type_constants::TYPE_I8
    return 1
  end
  if type_id == type_constants::TYPE_I16
    return 1
  end
  if type_id == type_constants::TYPE_I32
    return 1
  end
  if type_id == type_constants::TYPE_U8
    return 1
  end
  if type_id == type_constants::TYPE_U16
    return 1
  end
  if type_id == type_constants::TYPE_U32
    return 1
  end
  if type_id == type_constants::TYPE_RANGE
    return 1
  end

  # Concurrency types: Send (internally synchronized or designed for transfer)
  if type_id == type_constants::TYPE_ATOMIC
    return 1
  end
  if type_id == type_constants::TYPE_MUTEX
    return 1
  end
  if type_id == type_constants::TYPE_CHANNEL
    return 1
  end
  # Channel<T> ptype — Send if T is Send
  if typecheck::tc_is_ptype(type_id)
    if typecheck::tc_base_kind(tc, type_id) == type_constants::TYPE_CHANNEL
      var chan_arg = typecheck::tc_ptype_arg1(tc, type_id)
      # Protocol type args are always Send (compile-time only). Bound the range
      # (PROTOCOL_BASE..+1000) so per-struct nominal ids (STRUCT_TYPE_BASE=7000+,
      # B.15d/N3.1 step-4a) are NOT misread as protocols — they fall through to
      # the real Send check below.
      if chan_arg >= type_constants::PROTOCOL_BASE and chan_arg < type_constants::PROTOCOL_BASE + 1000
        return 1
      end
      return tc_type_is_send(tc, chan_arg, "")
    end
  end

  # Containers: Send (heap data, safe to transfer ownership)
  if type_id == type_constants::TYPE_VEC
    return 1
  end
  if type_id == type_constants::TYPE_MAP
    return 1
  end
  if type_id == type_constants::TYPE_SET
    return 1
  end
  if type_id == type_constants::TYPE_STRINGBUILDER
    return 1
  end

  # Option/Result: Send if wrapped type is Send (existential model — assume yes)
  if type_id == type_constants::TYPE_OPTION
    return 1
  end
  if type_id == type_constants::TYPE_RESULT
    return 1
  end

  # CPtr: NOT Send — raw pointer with unknown semantics
  if type_id == type_constants::TYPE_CPTR
    return 0
  end
  if type_id == type_constants::TYPE_PTR
    return 0
  end

  # Function type: Send (function pointers are safe to transfer)
  if type_id == type_constants::TYPE_FUNCTION
    return 1
  end

  # Struct: Send if all fields are Send
  if typecheck::tc_is_struct_type(type_id)
    if str_byte_len(struct_name) > 0
      # Cycle guard
      if any?(g_send_checking, s: String -> s == struct_name)
        return 1
      end
      g_send_checking.push(struct_name)
      var sr = tc_lookup_struct(tc, struct_name)
      var si = match sr
        Found(v) => v
        NotFound => -1
      end
      if si >= 0
        var field_names = tc.registry.struct_field_names[si]
        var field_annotations = tc.registry.struct_field_annotations[si]
        var field_types = tc.registry.struct_field_types[si]
        var fcount = field_names.size
        for fi in 0..fcount
          var fann = field_annotations[fi]
          var ftype = field_types[fi]
          var fsname = ""
          if typecheck::tc_is_struct_type(ftype) or ftype == type_constants::TYPE_ENUM
            fsname = fann
          end
          if tc_type_is_send(tc, ftype, fsname) == 0
            vec_pop(g_send_checking)
            return 0
          end
        end
      end
      vec_pop(g_send_checking)
    end
    return 1
  end

  # Enum: Send if all variant payloads are Send
  if type_id == type_constants::TYPE_ENUM
    if str_byte_len(struct_name) > 0
      if any?(g_send_checking, s: String -> s == struct_name)
        return 1
      end
      g_send_checking.push(struct_name)
      var er = tc_lookup_enum(tc, struct_name)
      var ei = match er
        Found(v) => v
        NotFound => -1
      end
      if ei >= 0
        var variant_anns = tc.registry.enum_variant_field_annotations[ei]
        var vcount = variant_anns.size
        for vi in 0..vcount
          var vann = variant_anns[vi]
          if str_byte_len(vann) > 0
            var vtype = typecheck::tc_parse_type(tc, vann)
            var vsname = ""
            if typecheck::tc_is_struct_type(vtype) or vtype == type_constants::TYPE_ENUM
              vsname = vann
            end
            if tc_type_is_send(tc, vtype, vsname) == 0
              vec_pop(g_send_checking)
              return 0
            end
          end
        end
      end
      vec_pop(g_send_checking)
    end
    return 1
  end

  # Default: assume Send for unknown types
  return 1
end

## Check if a type is Sync (safe to share across threads simultaneously).
##
## Classification:
## - Primitives (Int, Bool, F64, Symbol, String): Sync
## - Concurrency types (AtomicInt, Mutex, Channel): Sync
## - Vec, Map, Set, StringBuilder: NOT Sync (mutable heap, not thread-safe)
## - CPtr: NOT Sync
## - Structs/Enums: Sync if all fields/payloads are Sync
## - Explicit `impl Sync for T` overrides default
##
## Parameters:
##   tc          - Type checker context
##   type_id     - Type kind constant
##   struct_name - Struct/enum name (for structural checks)
##
## Returns: 1 if Sync, 0 if not Sync
def tc_type_is_sync(tc: TypecheckState, type_id: Int, struct_name: String): Int
  # Negative impl wins first — `impl !Sync for X` always rejects.
  if str_byte_len(struct_name) > 0
    if tc_lookup_neg_impl(tc, "Sync", struct_name) >= 0
      return 0
    end
  end
  # Explicit impl wins
  if str_byte_len(struct_name) > 0
    if tc_lookup_impl(tc, "Sync", struct_name) >= 0
      return 1
    end
  end

  # Primitives: always Sync (immutable values)
  if type_id == type_constants::TYPE_INT
    return 1
  end
  if type_id == type_constants::TYPE_BOOL
    return 1
  end
  if type_id == type_constants::TYPE_STRING
    return 1
  end
  if type_id == type_constants::TYPE_F64
    return 1
  end
  if type_id == type_constants::TYPE_SYMBOL
    return 1
  end
  if type_id == type_constants::TYPE_VOID
    return 1
  end
  if type_id == type_constants::TYPE_F32
    return 1
  end
  if type_id == type_constants::TYPE_I8
    return 1
  end
  if type_id == type_constants::TYPE_I16
    return 1
  end
  if type_id == type_constants::TYPE_I32
    return 1
  end
  if type_id == type_constants::TYPE_U8
    return 1
  end
  if type_id == type_constants::TYPE_U16
    return 1
  end
  if type_id == type_constants::TYPE_U32
    return 1
  end
  if type_id == type_constants::TYPE_RANGE
    return 1
  end

  # Concurrency types: Sync (designed for concurrent access)
  if type_id == type_constants::TYPE_ATOMIC
    return 1
  end
  if type_id == type_constants::TYPE_MUTEX
    return 1
  end
  if type_id == type_constants::TYPE_CHANNEL
    return 1
  end
  # Channel<T> ptype — always Sync (internal synchronization via mutex)
  if typecheck::tc_is_ptype(type_id)
    if typecheck::tc_base_kind(tc, type_id) == type_constants::TYPE_CHANNEL
      return 1
    end
  end

  # Mutable containers: NOT Sync (not thread-safe)
  if type_id == type_constants::TYPE_VEC
    return 0
  end
  if type_id == type_constants::TYPE_MAP
    return 0
  end
  if type_id == type_constants::TYPE_SET
    return 0
  end
  if type_id == type_constants::TYPE_STRINGBUILDER
    return 0
  end

  # PSQ-6 / Sched effect, Phase C.5 (2026-04-30): ptype Sync handling.
  # `Vec<T>` / `Map<K,V>` / `Set<T>` / `StringBuilder` aren't bare base
  # types — they're ptype indices via tc_make_ptype, so the bare-base
  # checks above don't fire. Reject them here. `Option<T>` / `Result<T,E>`
  # walk inner types structurally — the prior "always Sync" rule was
  # too permissive (an `Option<Vec<T>>` global is functionally `Vec<T>`
  # under the foreign-thread rule).
  if typecheck::tc_is_ptype(type_id)
    var pt_base = typecheck::tc_base_kind(tc, type_id)
    if pt_base == type_constants::TYPE_VEC
      return 0
    end
    if pt_base == type_constants::TYPE_MAP
      return 0
    end
    if pt_base == type_constants::TYPE_SET
      return 0
    end
    if pt_base == type_constants::TYPE_STRINGBUILDER
      return 0
    end
    if pt_base == type_constants::TYPE_OPTION
      var pt_inner = typecheck::tc_ptype_arg1(tc, type_id)
      return tc_type_is_sync(tc, pt_inner, "")
    end
    if pt_base == type_constants::TYPE_RESULT
      var pt_inner1 = typecheck::tc_ptype_arg1(tc, type_id)
      var pt_inner2 = typecheck::tc_ptype_arg2(tc, type_id)
      var pt_s1 = tc_type_is_sync(tc, pt_inner1, "")
      if pt_s1 == 0
        return 0
      end
      return tc_type_is_sync(tc, pt_inner2, "")
    end
  end

  # Bare Option/Result (existential, no inner type info): assume Sync.
  if type_id == type_constants::TYPE_OPTION
    return 1
  end
  if type_id == type_constants::TYPE_RESULT
    return 1
  end

  # CPtr: NOT Sync — raw pointer with unknown semantics
  if type_id == type_constants::TYPE_CPTR
    return 0
  end
  if type_id == type_constants::TYPE_PTR
    return 0
  end

  # Function type: Sync (function pointers are immutable)
  if type_id == type_constants::TYPE_FUNCTION
    return 1
  end

  # Struct: Sync if all fields are Sync
  if typecheck::tc_is_struct_type(type_id)
    if str_byte_len(struct_name) > 0
      if any?(g_sync_checking, s: String -> s == struct_name)
        return 1
      end
      g_sync_checking.push(struct_name)
      var sr = tc_lookup_struct(tc, struct_name)
      var si = match sr
        Found(v) => v
        NotFound => -1
      end
      if si >= 0
        var field_names = tc.registry.struct_field_names[si]
        var field_annotations = tc.registry.struct_field_annotations[si]
        var field_types = tc.registry.struct_field_types[si]
        var fcount = field_names.size
        for fi in 0..fcount
          var fann = field_annotations[fi]
          var ftype = field_types[fi]
          var fsname = ""
          if typecheck::tc_is_struct_type(ftype) or ftype == type_constants::TYPE_ENUM
            fsname = fann
          end
          if tc_type_is_sync(tc, ftype, fsname) == 0
            vec_pop(g_sync_checking)
            return 0
          end
        end
      end
      vec_pop(g_sync_checking)
    end
    return 1
  end

  # Enum: Sync if all variant payloads are Sync
  if type_id == type_constants::TYPE_ENUM
    if str_byte_len(struct_name) > 0
      if any?(g_sync_checking, s: String -> s == struct_name)
        return 1
      end
      g_sync_checking.push(struct_name)
      var er = tc_lookup_enum(tc, struct_name)
      var ei = match er
        Found(v) => v
        NotFound => -1
      end
      if ei >= 0
        var variant_anns = tc.registry.enum_variant_field_annotations[ei]
        var vcount = variant_anns.size
        for vi in 0..vcount
          var vann = variant_anns[vi]
          if str_byte_len(vann) > 0
            var vtype = typecheck::tc_parse_type(tc, vann)
            var vsname = ""
            if typecheck::tc_is_struct_type(vtype) or vtype == type_constants::TYPE_ENUM
              vsname = vann
            end
            if tc_type_is_sync(tc, vtype, vsname) == 0
              vec_pop(g_sync_checking)
              return 0
            end
          end
        end
      end
      vec_pop(g_sync_checking)
    end
    return 1
  end

  # Default: assume Sync for unknown types
  return 1
end

## Force-move a binding for spawn safety (Send-but-not-Sync types).
## Unlike tc_move_on_call which skips non-linear types (state==0),
## this unconditionally marks the binding as consumed to prevent aliasing.
##
## Parameters:
##   tc   - Type checker context
##   name - Variable name to force-move
##   line - Source line for error reporting
##   col  - Source column for error reporting
def tc_force_move_for_spawn(tc: TypecheckState, name: String, line: Int, col: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var current_depth = typecheck_util::tc_get_depth(tc)
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    var bound_depth = binding_depths[i]
    if bound_depth <= current_depth
      if binding_names[i].eq(name)
        var state = tc.safety.move_states[i]
        if state == 2
          # Already consumed (e.g. by lambda capture in tc_expr_lambda).
          # Existing move tracking will catch subsequent use — no double error.
          return
        end
        # Cannot move a borrowed value
        if tc.safety.binding_borrow_states[i] != 0
          var borrow_line = tc.safety.binding_borrow_lines[i]
          error("QZ1212: Cannot move '#{name}' while it is borrowed (borrow created at line #{borrow_line})", line, col)
          return
        end
        # Force-move: set to consumed regardless of current move_state
        tc.safety.move_states[i] = 2
        tc.safety.move_targets[i] = "<spawn>"
        tc.safety.move_lines[i] = line
        tc.safety.move_cols[i] = col
        return
      end
    end
    i -= 1
  end
end

# ============================================================================
# Protocol Registry (Session Types)
# ============================================================================

## Register a new protocol definition. Returns the protocol index.
## Builds a DFA from the sequential step list (linear chain: state 0 → 1 → ... → N).
def tc_register_protocol(tc: TypecheckState, name: String, type_params: String, step_kinds: Vec<Int>, step_types: Vec<Int>): Int
  var idx = tc.protocol_names.size
  tc.protocol_names.push(name)
  tc.protocol_type_params.push(type_params)
  tc.protocol_step_kinds.push(step_kinds)
  tc.protocol_step_types.push(step_types)
  tc.protocol_step_type_annotations.push(vec_new<String>())
  # Build DFA: linear chain for sequential protocols
  # States: 0, 1, ..., N where N = step count (accept state)
  var n = step_kinds.size
  var transitions = vec_new()
  for s in 0..n
    # Transition: [from_state, kind, type, to_state]
    transitions.push(s)
    transitions.push(step_kinds[s])
    transitions.push(step_types[s])
    transitions.push(s + 1)
  end
  tc.protocol_dfa_state_count.push(n + 1)
  tc.protocol_dfa_transitions.push(transitions)
  tc.protocol_dfa_accept.push(n)
  return idx
end

## Register a protocol with pre-built DFA (for choice/loop protocols).
def tc_register_protocol_dfa(tc: TypecheckState, name: String, type_params: String, step_kinds: Vec<Int>, step_types: Vec<Int>, dfa_state_count: Int, dfa_transitions: Vec<Int>, dfa_accept: Int): Int
  var idx = tc.protocol_names.size
  tc.protocol_names.push(name)
  tc.protocol_type_params.push(type_params)
  tc.protocol_step_kinds.push(step_kinds)
  tc.protocol_step_types.push(step_types)
  tc.protocol_step_type_annotations.push(vec_new<String>())
  tc.protocol_dfa_state_count.push(dfa_state_count)
  tc.protocol_dfa_transitions.push(dfa_transitions)
  tc.protocol_dfa_accept.push(dfa_accept)
  return idx
end

## Look up a protocol by name. Returns index or -1.
def tc_lookup_protocol(tc: TypecheckState, name: String): Int
  for i in 0..tc.protocol_names.size
    if tc.protocol_names[i] == name
      return i
    end
  end
  return -1
end

## Get the number of steps in a protocol.
def tc_protocol_step_count(tc: TypecheckState, proto_idx: Int): Int
  return tc.protocol_step_kinds[proto_idx].size
end

## Get the step kind at a given position (1=SEND, 2=RECV, 0=END).
def tc_protocol_step_kind_at(tc: TypecheckState, proto_idx: Int, step_idx: Int): Int
  if step_idx >= tc.protocol_step_kinds[proto_idx].size
    return 0
  end
  return tc.protocol_step_kinds[proto_idx][step_idx]
end

## Get the step type at a given position.
def tc_protocol_step_type_at(tc: TypecheckState, proto_idx: Int, step_idx: Int): Int
  if step_idx >= tc.protocol_step_types[proto_idx].size
    return 0
  end
  return tc.protocol_step_types[proto_idx][step_idx]
end

## Get the expected step type annotation for a given DFA state (for generic protocols).
## Returns the raw annotation string (e.g., "T") or "" if not a generic protocol.
def tc_protocol_step_type_annotation_at(tc: TypecheckState, proto_idx: Int, step_idx: Int): String
  if proto_idx < tc.protocol_step_type_annotations.size
    var anns = tc.protocol_step_type_annotations[proto_idx]
    if step_idx < anns.size
      return anns[step_idx]
    end
  end
  return ""
end

## Resolve a protocol step type with generic substitution.
## Given a step's raw annotation (e.g., "T"), the protocol's type params ("T"),
## and the binding's type args ("Int"), substitutes T→Int and resolves.
## Returns the resolved type ID, or 0 if no substitution needed.
def tc_protocol_resolve_step_type(tc: TypecheckState, proto_idx: Int, step_ann: String, type_args: String): Int
  if str_byte_len(step_ann) == 0 or str_byte_len(type_args) == 0
    return 0
  end
  var type_params = tc.protocol_type_params[proto_idx]
  if str_byte_len(type_params) == 0
    return 0
  end
  # Simple case: single type param (e.g., "T" → "Int")
  # If step_ann matches type_param, substitute with type_arg
  if step_ann == type_params
    return typecheck::tc_parse_type(tc, type_args)
  end
  # Multi-param case: split both by comma and match positionally
  # (e.g., type_params="Req,Resp", type_args="Int,String", step_ann="Req" → "Int")
  var param_idx = 0
  var p_start = 0
  for p_i in 0..str_byte_len(type_params)
    if str_byte_at(type_params, p_i) == ','
      var param = str_byte_slice(type_params, p_start, p_i)
      if str_trim(param) == step_ann
        # Find the corresponding type arg at the same position
        var arg_idx = 0
        var a_start = 0
        for a_i in 0..str_byte_len(type_args)
          if str_byte_at(type_args, a_i) == ','
            if arg_idx == param_idx
              return typecheck::tc_parse_type(tc, str_trim(str_byte_slice(type_args, a_start, a_i)))
            end
            arg_idx += 1
            a_start = a_i + 1
          end
        end
        if arg_idx == param_idx
          return typecheck::tc_parse_type(tc, str_trim(str_byte_slice(type_args, a_start, str_byte_len(type_args))))
        end
      end
      param_idx += 1
      p_start = p_i + 1
    end
  end
  # Check last param segment
  var last_param = str_trim(str_byte_slice(type_params, p_start, str_byte_len(type_params)))
  if last_param == step_ann
    # Find corresponding arg
    var arg_idx = 0
    var a_start = 0
    for a_i in 0..str_byte_len(type_args)
      if str_byte_at(type_args, a_i) == ','
        arg_idx += 1
        a_start = a_i + 1
      end
    end
    return typecheck::tc_parse_type(tc, str_trim(str_byte_slice(type_args, a_start, str_byte_len(type_args))))
  end
  return 0
end

## Get the protocol name.
def tc_protocol_name(tc: TypecheckState, proto_idx: Int): String
  return tc.protocol_names[proto_idx]
end

## Get the DFA accept state for a protocol.
def tc_protocol_dfa_accept_state(tc: TypecheckState, proto_idx: Int): Int
  return tc.protocol_dfa_accept[proto_idx]
end

## Find the transition from the current DFA state matching a given kind.
## Returns the next state, or -1 if no matching transition.
## Also returns the expected kind via output parameter semantics (first matching transition kind).
def tc_protocol_dfa_transition(tc: TypecheckState, proto_idx: Int, current_state: Int, kind: Int): Int
  var transitions = tc.protocol_dfa_transitions[proto_idx]
  var t = 0
  while t < transitions.size
    var src_state = transitions[t]
    var tk = transitions[t + 1]
    var next = transitions[t + 3]
    if src_state == current_state and tk == kind
      return next
    end
    t += 4
  end
  return -1
end

## Get the expected kind(s) from the current DFA state.
## Returns the kind of the first outgoing transition, or 0 (END) if at accept state.
def tc_protocol_dfa_expected_kind(tc: TypecheckState, proto_idx: Int, current_state: Int): Int
  var transitions = tc.protocol_dfa_transitions[proto_idx]
  var t = 0
  while t < transitions.size
    if transitions[t] == current_state
      return transitions[t + 1]
    end
    t += 4
  end
  return 0
end

## Check if a DFA state has multiple outgoing transitions (choice point).
def tc_protocol_dfa_is_choice(tc: TypecheckState, proto_idx: Int, current_state: Int): Int
  var transitions = tc.protocol_dfa_transitions[proto_idx]
  var count = 0
  var t = 0
  while t < transitions.size
    if transitions[t] == current_state
      count += 1
      if count > 1
        return 1
      end
    end
    t += 4
  end
  return 0
end

## Mark a binding as having a protocol at DFA start state (state 0).
## type_args: comma-separated type arguments (e.g., "Int" or "Int,String"), "" for non-generic.
def tc_mark_binding_protocol(tc: TypecheckState, name: String, proto_idx: Int): Void
  tc_mark_binding_protocol_with_args(tc, name, proto_idx, "")
end

## Mark a binding as having a protocol with type arguments.
def tc_mark_binding_protocol_with_args(tc: TypecheckState, name: String, proto_idx: Int, type_args: String): Void
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i] == name
      if i < tc.safety.binding_protocol_ids.size
        tc.safety.binding_protocol_ids[i] = proto_idx
        tc.safety.binding_protocol_states[i] = 0
        if i < tc.safety.binding_protocol_type_args.size
          tc.safety.binding_protocol_type_args[i] = type_args
        end
      end
      return
    end
    i -= 1
  end
end

## Advance a binding's protocol DFA state using the actual operation kind.
## Returns the new DFA state, or -1 if no valid transition (protocol violation).
def tc_advance_protocol(tc: TypecheckState, name: String, line: Int, col: Int): Int
  return tc_advance_protocol_with_kind(tc, name, 0, line, col)
end

## Advance with explicit operation kind (1=SEND, 2=RECV). 0=auto (use DFA expected).
def tc_advance_protocol_with_kind(tc: TypecheckState, name: String, op_kind: Int, line: Int, col: Int): Int
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i] == name
      if i < tc.safety.binding_protocol_ids.size
        var proto_idx = tc.safety.binding_protocol_ids[i]
        if proto_idx >= 0
          var current = tc.safety.binding_protocol_states[i]
          var accept = tc_protocol_dfa_accept_state(tc, proto_idx)
          # At accept state: only return -1 if there are NO outgoing transitions
          # (true completion). For loops, the accept state has transitions (loop body).
          if current == accept
            var has_outgoing = tc_protocol_dfa_expected_kind(tc, proto_idx, current)
            if has_outgoing == 0
              return -1
            end
          end
          # Use explicit kind if provided, otherwise use DFA expected
          var kind = op_kind
          if kind == 0
            kind = tc_protocol_dfa_expected_kind(tc, proto_idx, current)
          end
          var next = tc_protocol_dfa_transition(tc, proto_idx, current, kind)
          if next >= 0
            tc.safety.binding_protocol_states[i] = next
            return next
          end
        end
      end
      return -1
    end
    i -= 1
  end
  return -1
end

## Get the current expected protocol step kind for a binding.
## Returns: 1=SEND, 2=RECV, -1=none, 0=END, 3=CHOICE (multiple options).
## Uses the DFA to look up outgoing transitions from the current state.
def tc_get_binding_protocol_kind(tc: TypecheckState, name: String): Int
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i] == name
      if i < tc.safety.binding_protocol_ids.size
        var proto_idx = tc.safety.binding_protocol_ids[i]
        if proto_idx >= 0
          var current = tc.safety.binding_protocol_states[i]
          # Check if this is a choice point (multiple outgoing transitions)
          if tc_protocol_dfa_is_choice(tc, proto_idx, current) == 1
            return 3
          end
          return tc_protocol_dfa_expected_kind(tc, proto_idx, current)
        end
      end
      return -1
    end
    i -= 1
  end
  return -1
end

## Get the type args for a binding's protocol ("" if not generic).
def tc_get_binding_protocol_type_args(tc: TypecheckState, name: String): String
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i] == name
      if i < tc.safety.binding_protocol_type_args.size
        return tc.safety.binding_protocol_type_args[i]
      end
      return ""
    end
    i -= 1
  end
  return ""
end

## Get the protocol index for a binding (-1 if not a protocol channel).
def tc_get_binding_protocol_idx(tc: TypecheckState, name: String): Int
  var binding_names = tc.scope.binding_names
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_names[i] == name
      if i < tc.safety.binding_protocol_ids.size
        return tc.safety.binding_protocol_ids[i]
      end
      return -1
    end
    i -= 1
  end
  return -1
end

## Check that all protocol channels at a given scope depth are at the accept state.
## Emits QZ1401 for incomplete protocols.
def tc_check_protocol_scope_exit(tc: TypecheckState, depth: Int): Void can Diag
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = binding_count - 1
  while i >= 0
    if binding_depths[i] == depth
      if i < tc.safety.binding_protocol_ids.size
        var proto_idx = tc.safety.binding_protocol_ids[i]
        if proto_idx >= 0
          var current = tc.safety.binding_protocol_states[i]
          var accept = tc_protocol_dfa_accept_state(tc, proto_idx)
          if current != accept
            var pname = tc_protocol_name(tc, proto_idx)
            var step_kind = tc_protocol_dfa_expected_kind(tc, proto_idx, current)
            var step_label = "send"
            if step_kind == 2
              step_label = "recv"
            end
            error("QZ1401: Protocol channel '#{binding_names[i]}' not fully consumed — protocol '#{pname}' at DFA state #{to_str(current)} (expected: #{step_label})", 0, 0)
          end
        end
      end
    end
    i -= 1
  end
end

# ============================================================================
# Protocol State Snapshot/Restore (for branch agreement in choice/if)
# ============================================================================

## Snapshot all protocol states for bindings at or above the given depth.
## Returns a Vec of [binding_index, dfa_state] pairs (flat).
def tc_snapshot_protocol_states(tc: TypecheckState, depth: Int): Vec<Int>
  var snapshot = vec_new()
  var binding_names = tc.scope.binding_names
  var binding_depths = tc.scope.binding_depths
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var i = 0
  while i < binding_count
    if binding_depths[i] >= depth
      if i < tc.safety.binding_protocol_ids.size
        if tc.safety.binding_protocol_ids[i] >= 0
          snapshot.push(i)
          snapshot.push(tc.safety.binding_protocol_states[i])
        end
      end
    end
    i += 1
  end
  return snapshot
end

## Restore protocol states from a snapshot.
def tc_restore_protocol_states(tc: TypecheckState, snapshot: Vec<Int>): Void
  var j = 0
  while j < snapshot.size
    var idx = snapshot[j]
    var state = snapshot[j + 1]
    tc.safety.binding_protocol_states[idx] = state
    j += 2
  end
end

## Check that two protocol state snapshots agree (all bindings at same DFA state).
## Returns 1 if they agree, 0 if any binding is at a different state.
def tc_check_protocol_branch_agreement(snap_a: Vec<Int>, snap_b: Vec<Int>): Int
  if snap_a.size != snap_b.size
    return 0
  end
  var j = 0
  while j < snap_a.size
    if snap_a[j] != snap_b[j]
      return 0
    end
    if snap_a[j + 1] != snap_b[j + 1]
      return 0
    end
    j += 2
  end
  return 1
end

# ============================================================================
# Effect Rows + Effect Declarations (Operation Piezoelectric Effects, B.1)
# ============================================================================
#
# Pure storage layer. Semantics layered on top in B.4-B.7. See
# docs/handoff/piezo-milestone-b-overnight.md §2 for design rationale.

## Allocate a new effect row.
## - labels: list of effect-label intern IDs (may be empty for `can`).
## - tail_var: -1 = closed (empty tail), else type-var ID for an open tail.
## Returns: row ID (index into row_label_lists / row_tail_vars).
def tc_row_new(tc: TypecheckState, labels: Vec<Int>, tail_var: Int): Int
  var row_id = tc.registry.row_label_lists.size
  tc.registry.row_label_lists.push(labels)
  tc.registry.row_tail_vars.push(tail_var)
  return row_id
end

## Read the label list of a row by ID. Returns the underlying Vec — caller
## must not mutate. Returns an empty Vec if row_id is out of range.
def tc_row_get_labels(tc: TypecheckState, row_id: Int): Vec<Int>
  if row_id < 0
    return vec_new()
  end
  if row_id >= tc.registry.row_label_lists.size
    return vec_new()
  end
  return tc.registry.row_label_lists[row_id]
end

## Read the tail variable of a row. Returns -1 if row_id is out of range
## or the row is closed.
def tc_row_get_tail(tc: TypecheckState, row_id: Int): Int
  if row_id < 0
    return -1
  end
  if row_id >= tc.registry.row_tail_vars.size
    return -1
  end
  return tc.registry.row_tail_vars[row_id]
end

## Walk a row through its tail's erv bindings to a canonical form.
## Returns a row_id whose tail is either -1 (closed) or an UNBOUND erv.
## Allocates new rows when flattening is needed; no-op when the input is
## already canonical.
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.4).
def tc_row_walk(tc: TypecheckState, row_id: Int): Int
  if row_id < 0
    return row_id
  end
  if row_id >= tc.registry.row_label_lists.size
    return row_id
  end
  var tail = tc_row_get_tail(tc, row_id)
  if tail <= 0
    return row_id
  end
  var bound_to = typecheck_util::tc_erv_resolve(tc, tail)
  if bound_to < 0
    return row_id
  end
  var bound_walked = tc_row_walk(tc, bound_to)
  var current_labels = tc_row_get_labels(tc, row_id)
  var bound_labels = tc_row_get_labels(tc, bound_walked)
  var bound_tail = tc_row_get_tail(tc, bound_walked)
  var combined = vec_new()
  for i in 0..current_labels.size
    combined.push(current_labels[i])
  end
  for i in 0..bound_labels.size
    combined.push(bound_labels[i])
  end
  return tc_row_new(tc, combined, bound_tail)
end

## Multiset subtract: return elements of `a` not matched in `b`, with
## multiplicity. `b` is treated destructively via a local `used` bitmask
## — the input Vecs are not mutated. Used by tc_row_unify.
def _tc_row_ms_subtract(a: Vec<Int>, b: Vec<Int>): Vec<Int>
  var b_used = vec_new()
  for i in 0..b.size
    b_used.push(0)
  end
  var result = vec_new()
  for i in 0..a.size
    var matched = 0
    var j = 0
    while j < b.size
      if b_used[j] == 0 and b[j] == a[i]
        b_used[j] = 1
        matched = 1
        break
    end
      j = j + 1
    end
    if matched == 0
      result.push(a[i])
    end
  end
  return result
end

## Rémy-style row unification, Model B (allows duplicate labels per
## Leijen 2014). Returns true on success, false on failure. Mutates
## the erv binding table when tails need to unify; no-op on invalid
## row_ids.
##
## Algorithm:
## - Walk both rows through tail bindings to canonical form.
## - If the walked rows alias the same row_id, success.
## - Compute l1_only = labels(r1) \ labels(r2) and l2_only symmetrically,
##   as multisets (duplicate labels count separately per Model B).
## - If both closed: succeed iff both `only` sets are empty.
## - If r1 closed, r2 open: l2_only must be empty (r1 exhaustive);
##   bind r2's tail to a closed row carrying l1_only.
## - If r2 closed, r1 open: symmetric.
## - If both open with the same tail var: succeed iff both `only` sets
##   are empty (occurs — extending ρ to contain itself is rejected).
## - If both open with different tail vars: allocate a fresh shared
##   tail; bind r1's tail → (l2_only | fresh), r2's tail → (l1_only | fresh).
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.4).
def tc_row_unify(tc: TypecheckState, r1: Int, r2: Int): Bool
  var w1 = tc_row_walk(tc, r1)
  var w2 = tc_row_walk(tc, r2)
  if w1 == w2
    return true
  end
  var labels1 = tc_row_get_labels(tc, w1)
  var labels2 = tc_row_get_labels(tc, w2)
  var tail1 = tc_row_get_tail(tc, w1)
  var tail2 = tc_row_get_tail(tc, w2)
  var l1_only = _tc_row_ms_subtract(labels1, labels2)
  var l2_only = _tc_row_ms_subtract(labels2, labels1)

  # Same tail var: occurs guard — can only succeed when nothing extra.
  if tail1 > 0 and tail2 > 0 and tail1 == tail2
    if l1_only.size > 0
      return false
    end
    if l2_only.size > 0
      return false
    end
    return true
  end

  # Both closed.
  if tail1 <= 0 and tail2 <= 0
    if l1_only.size > 0
      return false
    end
    if l2_only.size > 0
      return false
    end
    return true
  end

  # r1 closed, r2 open.
  if tail1 <= 0
    if l2_only.size > 0
      return false
    end
    var new_row_c = tc_row_new(tc, l1_only, -1)
    typecheck_util::tc_erv_bind(tc, tail2, new_row_c)
    return true
  end

  # r2 closed, r1 open.
  if tail2 <= 0
    if l1_only.size > 0
      return false
    end
    var new_row_c2 = tc_row_new(tc, l2_only, -1)
    typecheck_util::tc_erv_bind(tc, tail1, new_row_c2)
    return true
  end

  # Both open with distinct tails.
  var fresh_tail = typecheck_util::tc_erv_fresh(tc)
  var new_row_1 = tc_row_new(tc, l2_only, fresh_tail)
  var new_row_2 = tc_row_new(tc, l1_only, fresh_tail)
  typecheck_util::tc_erv_bind(tc, tail1, new_row_1)
  typecheck_util::tc_erv_bind(tc, tail2, new_row_2)
  return true
end

## Register an effect declaration. Op metadata is stored flat across all
## effects; this call appends `op_names.size` entries to the per-op vecs.
##
## - name: effect declaration name (e.g. "Throws").
## - op_names: ordered list of operation names declared in this effect.
## - op_kinds: ordered kind tags (0=value, 1=function default, 2=operation).
## - op_param_types: per-op param type ID lists.
## - op_return_types: per-op return type IDs.
##
## Returns: effect index (into effect_decl_names).
##
## Caller is responsible for matching vec sizes (op_names, op_kinds,
## op_param_types, op_return_types must all be equal length).
def tc_register_effect_decl(tc: TypecheckState, name: String, op_names: Vec<String>, op_kinds: Vec<Int>, op_param_types: Vec<Vec<Int>>, op_return_types: Vec<Int>): Int
  var eidx = tc.registry.effect_decl_names.size
  var op_start = tc.registry.effect_decl_op_names.size
  var op_count = op_names.size
  tc.registry.effect_decl_names.push(name)
  tc.registry.effect_decl_op_starts.push(op_start)
  tc.registry.effect_decl_op_counts.push(op_count)
  var i = 0
  while i < op_count
    tc.registry.effect_decl_op_names.push(op_names[i])
    tc.registry.effect_decl_op_kinds.push(op_kinds[i])
    tc.registry.effect_decl_op_param_types.push(op_param_types[i])
    tc.registry.effect_decl_op_return_types.push(op_return_types[i])
    i += 1
  end
  return eidx
end

## Look up an effect declaration by name. Returns -1 if not found.
def tc_lookup_effect_decl(tc: TypecheckState, name: String): Int
  var n = tc.registry.effect_decl_names.size
  var i = 0
  while i < n
    if tc.registry.effect_decl_names[i] == name
      return i
    end
    i += 1
  end
  return -1
end

## Number of operations declared in the i-th effect.
## Returns 0 if eidx is out of range.
def tc_effect_decl_op_count(tc: TypecheckState, eidx: Int): Int
  if eidx < 0
    return 0
  end
  if eidx >= tc.registry.effect_decl_op_counts.size
    return 0
  end
  return tc.registry.effect_decl_op_counts[eidx]
end

## Name of the oidx-th operation of the eidx-th effect.
## Returns "" on out-of-range access.
def tc_effect_decl_op_name(tc: TypecheckState, eidx: Int, oidx: Int): String
  if eidx < 0
    return ""
  end
  if eidx >= tc.registry.effect_decl_op_counts.size
    return ""
  end
  var oc = tc.registry.effect_decl_op_counts[eidx]
  if oidx < 0
    return ""
  end
  if oidx >= oc
    return ""
  end
  var os = tc.registry.effect_decl_op_starts[eidx]
  return tc.registry.effect_decl_op_names[os + oidx]
end

## Return the declared name of effect `eidx`, or "" if out-of-range.
## Thin accessor over the parallel registry tables.
def tc_effect_decl_name(tc: TypecheckState, eidx: Int): String
  if eidx < 0
    return ""
  end
  if eidx >= tc.registry.effect_decl_names.size
    return ""
  end
  return tc.registry.effect_decl_names[eidx]
end

## Reverse lookup: given an operation name, return the index of the
## effect that declares it, or -1 if no registered effect has an op of
## this name. First-match wins (effects are registered in declaration
## order, so an earlier effect declaring the same op name shadows
## later ones — practically rare, worth knowing if diagnosing).
##
## Operation Piezoelectric Effects, C.3. Used by tc_expr_call's op-call
## detection path.
def tc_lookup_effect_op(tc: TypecheckState, op_name: String): Int
  var eff_count = tc.registry.effect_decl_names.size
  var e = 0
  while e < eff_count
    var oc = tc.registry.effect_decl_op_counts[e]
    var os = tc.registry.effect_decl_op_starts[e]
    var i = 0
    while i < oc
      if tc.registry.effect_decl_op_names[os + i] == op_name
        return e
      end
      i += 1
    end
    e += 1
  end
  return -1
end

## Return the declared return type of the op named `op_name` within
## effect `eidx`. Returns TYPE_VOID if the op isn't found.
##
## Operation Piezoelectric Effects, C.3.
def tc_effect_decl_op_return_type_by_name(tc: TypecheckState, eidx: Int, op_name: String): Int
  if eidx < 0
    return type_constants::TYPE_VOID
  end
  if eidx >= tc.registry.effect_decl_op_counts.size
    return type_constants::TYPE_VOID
  end
  var oc = tc.registry.effect_decl_op_counts[eidx]
  var os = tc.registry.effect_decl_op_starts[eidx]
  var i = 0
  while i < oc
    if tc.registry.effect_decl_op_names[os + i] == op_name
      return tc.registry.effect_decl_op_return_types[os + i]
    end
    i += 1
  end
  return type_constants::TYPE_VOID
end

## Kind tag of the named operation within effect `eidx`.
## Returns -1 if `eidx` is invalid or the op isn't found.
## Mirrors tc_effect_decl_op_return_type_by_name — used by tc_expr_call's
## C.3 path (Piezo F.3b) to stamp the classified kind onto NODE_CALL so
## MIR/codegen can branch on kind=2 ("operation" / unwind) vs 0/1 (tail).
def tc_effect_decl_op_kind_by_name(tc: TypecheckState, eidx: Int, op_name: String): Int
  if eidx < 0
    return -1
  end
  if eidx >= tc.registry.effect_decl_op_counts.size
    return -1
  end
  var oc = tc.registry.effect_decl_op_counts[eidx]
  var os = tc.registry.effect_decl_op_starts[eidx]
  var i = 0
  while i < oc
    if tc.registry.effect_decl_op_names[os + i] == op_name
      return tc.registry.effect_decl_op_kinds[os + i]
    end
    i += 1
  end
  return -1
end

## Kind tag of the oidx-th operation of the eidx-th effect.
## Returns -1 on out-of-range access.
def tc_effect_decl_op_kind(tc: TypecheckState, eidx: Int, oidx: Int): Int
  if eidx < 0
    return -1
  end
  if eidx >= tc.registry.effect_decl_op_counts.size
    return -1
  end
  var oc = tc.registry.effect_decl_op_counts[eidx]
  if oidx < 0
    return -1
  end
  if oidx >= oc
    return -1
  end
  var os = tc.registry.effect_decl_op_starts[eidx]
  return tc.registry.effect_decl_op_kinds[os + oidx]
end

## Walk every NODE_CALL in `s` and (re-)mark op-call annotations when the
## callee names a registered effect op. Idempotent: callsites already
## marked by body-TC's C.3 block are skipped via `ast_is_op_call`. UFCS
## calls are skipped to mirror tc_expr_call's gate (mir_lower handles
## those via its UFCS rewrite path).
##
## Why this exists. The AST cache (build_cache.qz cache_save/load_ast)
## persists `kinds, ops, lefts, rights, str1s, str2s, …` but does NOT
## persist the op_call_effect_names / op_call_op_names / op_call_kinds
## side-tables. Under --cache-ro and the incremental-skip path, body-TC
## is skipped for unchanged modules whose AST is loaded from cache
## without the annotations. mir_lower's `ast_is_op_call` then returns 0
## and the call falls through to indirect-call: `throw(...)` ends up as
## `load i64, ptr %throw` (undefined). Same trap for any blessed effect
## op (`throw`, `intern`, `resolve`, `cache_op_*`, `prof_*`, FileIo, …).
def tc_remark_op_calls_in_module(tc: TypecheckState, s: ast::AstStorage): Void
  var nc = ast::ast_node_count(s)
  for i in 0..nc
    if ast::ast_get_kind(s, i) != 9  # NODE_CALL
      continue
    end
    if ast::ast_call_is_ufcs(s, i) == 1
      continue
    end
    if ast::ast_is_op_call(s, i) == 1
      continue
    end
    var callee = ast::ast_get_left(s, i)
    if callee == 0
      continue
    end
    if ast::ast_get_kind(s, callee) != 6  # NODE_IDENT
      continue
    end
    var fn_name = ast::ast_get_str1(s, callee)
    if str_byte_len(fn_name) == 0
      continue
    end
    var eff_idx = tc_lookup_effect_op(tc, fn_name)
    if eff_idx < 0
      continue
    end
    var eff_name = tc_effect_decl_name(tc, eff_idx)
    ast::ast_mark_op_call(s, i, eff_name, fn_name)
    var op_kind = tc_effect_decl_op_kind_by_name(tc, eff_idx, fn_name)
    if op_kind >= 0
      ast::ast_mark_op_call_kind(s, i, op_kind)
    end
  end
end

## Asymmetric row subsumption — checks that `callee_row` can be safely
## called from a context whose effect row is `caller_row`. Returns true
## on success, false on failure. Mutates erv bindings to extend caller's
## tail when callee carries labels caller doesn't yet have.
##
## Per Leijen 2014 evidence-passing: the callee's effect row must be a
## sub-row (multiset subset, allowing tail-extension) of the caller's
## row. Differs from `tc_row_unify` which is symmetric.
##
## - Both closed: callee labels must be a multiset subset of caller's.
## - Caller open + callee labels not in caller: extend caller's tail with
##   the missing labels (and a fresh shared continuation).
## - Callee open: bind callee's tail to a row that points at caller's
##   continuation, so further extension stays consistent.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.6).
def tc_row_subsume(tc: TypecheckState, caller_row: Int, callee_row: Int): Bool
  var caller_w = tc_row_walk(tc, caller_row)
  var callee_w = tc_row_walk(tc, callee_row)
  var caller_labels = tc_row_get_labels(tc, caller_w)
  var caller_tail = tc_row_get_tail(tc, caller_w)
  var callee_labels = tc_row_get_labels(tc, callee_w)
  var callee_tail = tc_row_get_tail(tc, callee_w)

  # Labels in callee that aren't matched 1-for-1 in caller's labels.
  var unmatched = _tc_row_ms_subtract(callee_labels, caller_labels)

  if unmatched.size > 0
    # Callee carries effects caller didn't declare. Caller can absorb
    # them only if its tail is open.
    if caller_tail <= 0
      return false
    end
    var fresh = typecheck_util::tc_erv_fresh(tc)
    var ext = tc_row_new(tc, unmatched, fresh)
    typecheck_util::tc_erv_bind(tc, caller_tail, ext)
    if callee_tail > 0
      var empty_l = vec_new()
      var ct_bind = tc_row_new(tc, empty_l, fresh)
      typecheck_util::tc_erv_bind(tc, callee_tail, ct_bind)
    end
    return true
  end

  # All of callee's labels are matched. If callee has an open tail, bind
  # it to caller's continuation so extension stays consistent across the
  # call boundary.
  if callee_tail > 0
    if caller_tail > 0
      var empty_l2 = vec_new()
      var ct2_bind = tc_row_new(tc, empty_l2, caller_tail)
      typecheck_util::tc_erv_bind(tc, callee_tail, ct2_bind)
    else
      var empty_l3 = vec_new()
      var closed_bind = tc_row_new(tc, empty_l3, -1)
      typecheck_util::tc_erv_bind(tc, callee_tail, closed_bind)
    end
  end
  return true
end

## Handler-aware variant of tc_row_subsume (Piezo C.2).
##
## Callee labels present on `tc.scope.handler_effect_stack` are removed
## from the subsumption requirement before the check runs — the
## enclosing `with ClaimedEffect do -> ... end` block handles them, so
## the caller does not need to declare them in its `can` row. If the
## stack is empty, this behaves exactly like `tc_row_subsume`.
##
## Side-effects: the narrowed view allocates a new transient callee row
## whose labels exclude the handled subset; the original row is
## preserved. Tail binding still uses the original callee_row to keep
## cross-call-boundary continuation semantics consistent.
def tc_row_subsume_with_handlers(tc: TypecheckState, caller_row: Int, callee_row: Int): Bool
  # Fast path: empty stack → delegate to B.6's subsume unchanged.
  if tc.scope.handler_effect_stack.size == 0
    return tc_row_subsume(tc, caller_row, callee_row)
  end
  var caller_w = tc_row_walk(tc, caller_row)
  var callee_w = tc_row_walk(tc, callee_row)
  var caller_labels = tc_row_get_labels(tc, caller_w)
  var caller_tail = tc_row_get_tail(tc, caller_w)
  var callee_labels = tc_row_get_labels(tc, callee_w)
  var callee_tail = tc_row_get_tail(tc, callee_w)

  # Filter callee labels: drop any present on the handler-effect stack.
  var visible_callee_labels = vec_new()
  var i = 0
  while i < callee_labels.size
    var lbl = callee_labels[i]
    if not typecheck_util::tc_handler_effect_contains(lbl)
      visible_callee_labels.push(lbl)
    end
    i += 1
  end

  var unmatched = _tc_row_ms_subtract(visible_callee_labels, caller_labels)
  if unmatched.size > 0
    if caller_tail <= 0
      return false
    end
    var fresh = typecheck_util::tc_erv_fresh(tc)
    var ext = tc_row_new(tc, unmatched, fresh)
    typecheck_util::tc_erv_bind(tc, caller_tail, ext)
    if callee_tail > 0
      var empty_l = vec_new()
      var ct_bind = tc_row_new(tc, empty_l, fresh)
      typecheck_util::tc_erv_bind(tc, callee_tail, ct_bind)
    end
    return true
  end

  if callee_tail > 0
    if caller_tail > 0
      var empty_l2 = vec_new()
      var ct2_bind = tc_row_new(tc, empty_l2, caller_tail)
      typecheck_util::tc_erv_bind(tc, callee_tail, ct2_bind)
    else
      var empty_l3 = vec_new()
      var closed_bind = tc_row_new(tc, empty_l3, -1)
      typecheck_util::tc_erv_bind(tc, callee_tail, closed_bind)
    end
  end
  return true
end

## Embedded test runner for tc_row_subsume — exercised by the
## `--test-row-subsume` CLI flag and B.6 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.6).
def tc_run_subsume_tests(): Void
  var tc = tc_new()
  var L = string_intern::intern_id(tc.interner, "L")
  var M = string_intern::intern_id(tc.interner, "M")

  # 1. caller [L] calls callee [L] — both closed, multiset equal. OK.
  var lbl_a1 = vec_new()
  lbl_a1.push(L)
  var lbl_a2 = vec_new()
  lbl_a2.push(L)
  var caller_a = tc_row_new(tc, lbl_a1, -1)
  var callee_a = tc_row_new(tc, lbl_a2, -1)
  _row_subsume_report("caller_L_calls_callee_L", true, tc_row_subsume(tc, caller_a, callee_a))

  # 2. caller [L, M] calls callee [L] — closed subset. OK.
  var lbl_b1 = vec_new()
  lbl_b1.push(L)
  lbl_b1.push(M)
  var lbl_b2 = vec_new()
  lbl_b2.push(L)
  var caller_b = tc_row_new(tc, lbl_b1, -1)
  var callee_b = tc_row_new(tc, lbl_b2, -1)
  _row_subsume_report("caller_LM_calls_callee_L_subset", true, tc_row_subsume(tc, caller_b, callee_b))

  # 3. caller [L] calls callee [L, M] — closed caller, callee has extra M.
  #    FAIL: caller can't accept new labels.
  var lbl_c1 = vec_new()
  lbl_c1.push(L)
  var lbl_c2 = vec_new()
  lbl_c2.push(L)
  lbl_c2.push(M)
  var caller_c = tc_row_new(tc, lbl_c1, -1)
  var callee_c = tc_row_new(tc, lbl_c2, -1)
  _row_subsume_report("caller_L_calls_callee_LM_FAIL", false, tc_row_subsume(tc, caller_c, callee_c))

  # 4. caller [] (bare can = closed empty) calls callee [L]. FAIL.
  var lbl_d1 = vec_new()
  var lbl_d2 = vec_new()
  lbl_d2.push(L)
  var caller_d = tc_row_new(tc, lbl_d1, -1)
  var callee_d = tc_row_new(tc, lbl_d2, -1)
  _row_subsume_report("caller_empty_calls_callee_L_FAIL", false, tc_row_subsume(tc, caller_d, callee_d))

  # 5. Caller untracked is represented as "no caller row" — the call-site
  #    integration in B.7 short-circuits before reaching tc_row_subsume.
  #    Document that here by simulating: caller open with empty labels,
  #    callee [L] closed. Caller's tail absorbs L. OK.
  var lbl_e1 = vec_new()
  var rho_e = typecheck_util::tc_erv_fresh(tc)
  var caller_e = tc_row_new(tc, lbl_e1, rho_e)
  var lbl_e2 = vec_new()
  lbl_e2.push(L)
  var callee_e = tc_row_new(tc, lbl_e2, -1)
  _row_subsume_report("caller_open_calls_callee_L", true, tc_row_subsume(tc, caller_e, callee_e))

  # 6. caller [L | ρ] calls callee [L, M] (closed). Caller's tail extends
  #    with M. OK.
  var lbl_f1 = vec_new()
  lbl_f1.push(L)
  var rho_f = typecheck_util::tc_erv_fresh(tc)
  var caller_f = tc_row_new(tc, lbl_f1, rho_f)
  var lbl_f2 = vec_new()
  lbl_f2.push(L)
  lbl_f2.push(M)
  var callee_f = tc_row_new(tc, lbl_f2, -1)
  _row_subsume_report("caller_L_open_calls_callee_LM_extends", true, tc_row_subsume(tc, caller_f, callee_f))
end

## Helper: emit one ROW_SUBSUME line to stderr.
def _row_subsume_report(slug: String, expected: Bool, actual: Bool): Void
  var ok = "FAIL"
  if expected == actual
    ok = "PASS"
  end
  eprint("ROW_SUBSUME #{slug}: #{ok}\n")
end

## Substitute one effect-row variable in a row with a replacement row.
##
## Walks the row's tail chain; when an unbound erv equal to `var_id` is
## reached, the replacement row's labels are appended and its tail
## adopted. Returns a new row_id (no in-place mutation of the input).
##
## - No-op (returns input row_id unchanged) when var_id never appears in
##   the chain.
## - When the row's labels list is non-empty, those labels are preserved
##   in the substituted row; only the tail is rewritten.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.5).
def tc_row_substitute(tc: TypecheckState, row_id: Int, var_id: Int, replacement: Int): Int
  if row_id < 0
    return row_id
  end
  if row_id >= tc.registry.row_label_lists.size
    return row_id
  end
  if var_id <= 0
    return row_id
  end
  var labels = tc_row_get_labels(tc, row_id)
  var tail = tc_row_get_tail(tc, row_id)
  if tail == var_id
    var rep_labels = tc_row_get_labels(tc, replacement)
    var rep_tail = tc_row_get_tail(tc, replacement)
    var combined = vec_new()
    for i in 0..labels.size
      combined.push(labels[i])
    end
    for i in 0..rep_labels.size
      combined.push(rep_labels[i])
    end
    return tc_row_new(tc, combined, rep_tail)
  end
  if tail <= 0
    return row_id
  end
  var bound = typecheck_util::tc_erv_resolve(tc, tail)
  if bound < 0
    return row_id
  end
  var sub_bound = tc_row_substitute(tc, bound, var_id, replacement)
  if sub_bound == bound
    return row_id
  end
  var sub_labels = tc_row_get_labels(tc, sub_bound)
  var sub_tail = tc_row_get_tail(tc, sub_bound)
  var merged = vec_new()
  for i in 0..labels.size
    merged.push(labels[i])
  end
  for i in 0..sub_labels.size
    merged.push(sub_labels[i])
  end
  return tc_row_new(tc, merged, sub_tail)
end

## Returns true if `var_id` appears anywhere in the row's tail chain.
## A row whose tail is `var_id` directly counts as containing it. The
## chain is followed through erv bindings.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.5).
def tc_row_occurs_check(tc: TypecheckState, row_id: Int, var_id: Int): Bool
  if row_id < 0
    return false
  end
  if row_id >= tc.registry.row_label_lists.size
    return false
  end
  if var_id <= 0
    return false
  end
  var tail = tc_row_get_tail(tc, row_id)
  if tail == var_id
    return true
  end
  if tail <= 0
    return false
  end
  var bound = typecheck_util::tc_erv_resolve(tc, tail)
  if bound < 0
    return false
  end
  return tc_row_occurs_check(tc, bound, var_id)
end

## Embedded test runner for tc_row_substitute / tc_row_occurs_check —
## exercised by the `--test-row-subst` CLI flag and B.5 acceptance spec.
## Prints `ROW_SUBST <slug>: PASS|FAIL` to stderr per case.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.5).
def tc_run_subst_tests(): Void
  var tc = tc_new()
  var L = string_intern::intern_id(tc.interner, "L")
  var M = string_intern::intern_id(tc.interner, "M")

  # 1. subst no-op when var_id not present in the row.
  var lbl_a = vec_new()
  lbl_a.push(L)
  var row_a = tc_row_new(tc, lbl_a, -1)
  var unrelated = typecheck_util::tc_erv_fresh(tc)
  var rep_a_lbl = vec_new()
  rep_a_lbl.push(M)
  var rep_a = tc_row_new(tc, rep_a_lbl, -1)
  var out_a = tc_row_substitute(tc, row_a, unrelated, rep_a)
  var out_a_labels = tc_row_get_labels(tc, out_a)
  var out_a_tail = tc_row_get_tail(tc, out_a)
  var ok_a = false
  if out_a_labels.size == 1 and out_a_labels[0] == L and out_a_tail == -1
    ok_a = true
  end
  _row_subst_report("noop_when_var_absent", true, ok_a)

  # 2. subst replaces tail directly.
  var lbl_b = vec_new()
  lbl_b.push(L)
  var rho_b = typecheck_util::tc_erv_fresh(tc)
  var row_b = tc_row_new(tc, lbl_b, rho_b)
  var rep_b_lbl = vec_new()
  rep_b_lbl.push(M)
  var rep_b = tc_row_new(tc, rep_b_lbl, -1)
  var out_b = tc_row_substitute(tc, row_b, rho_b, rep_b)
  var out_b_labels = tc_row_get_labels(tc, out_b)
  var out_b_tail = tc_row_get_tail(tc, out_b)
  var ok_b = false
  if out_b_labels.size == 2 and out_b_tail == -1
    if (out_b_labels[0] == L and out_b_labels[1] == M)
      ok_b = true
    end
  end
  _row_subst_report("subst_replaces_tail", true, ok_b)

  # 3. subst into nested row var (tail is bound to another row whose
  #    tail is the target var).
  var inner_lbl = vec_new()
  inner_lbl.push(M)
  var inner_rho = typecheck_util::tc_erv_fresh(tc)
  var inner_row = tc_row_new(tc, inner_lbl, inner_rho)
  var outer_rho = typecheck_util::tc_erv_fresh(tc)
  var outer_lbl = vec_new()
  outer_lbl.push(L)
  var outer_row = tc_row_new(tc, outer_lbl, outer_rho)
  typecheck_util::tc_erv_bind(tc, outer_rho, inner_row)
  # Now substitute inner_rho with a closed empty row.
  var rep_c_lbl = vec_new()
  var rep_c = tc_row_new(tc, rep_c_lbl, -1)
  var out_c = tc_row_substitute(tc, outer_row, inner_rho, rep_c)
  var out_c_labels = tc_row_get_labels(tc, out_c)
  var out_c_tail = tc_row_get_tail(tc, out_c)
  var ok_c = false
  # Should contain {L, M} after flattening, closed.
  if out_c_labels.size == 2 and out_c_tail == -1
    if (out_c_labels[0] == L and out_c_labels[1] == M) or (out_c_labels[0] == M and out_c_labels[1] == L)
      ok_c = true
    end
  end
  _row_subst_report("subst_nested_row_var", true, ok_c)

  # 4. occurs check detects direct cycle: row [L | ρ] contains ρ.
  var lbl_d = vec_new()
  lbl_d.push(L)
  var rho_d = typecheck_util::tc_erv_fresh(tc)
  var row_d = tc_row_new(tc, lbl_d, rho_d)
  _row_subst_report("occurs_direct_tail", true, tc_row_occurs_check(tc, row_d, rho_d))
end

## Helper: emit one ROW_SUBST line to stderr.
def _row_subst_report(slug: String, expected: Bool, actual: Bool): Void
  var ok = "FAIL"
  if expected == actual
    ok = "PASS"
  end
  eprint("ROW_SUBST #{slug}: #{ok}\n")
end

## Embedded test runner for tc_row_unify — exercised by the
## `--test-row-unify` CLI flag and B.4 acceptance spec. Prints
## one stable line per case to stderr in the format:
##
##     ROW_UNIFY <slug>: PASS|FAIL
##
## Cases are constructed inside a fresh TypecheckState so prior typecheck
## state cannot leak into the row registry. The label intern IDs ("L",
## "M", ...) are minted into that fresh interner.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.4).
def tc_run_unify_tests(): Void
  var tc = tc_new()
  var L = string_intern::intern_id(tc.interner, "L")
  var M = string_intern::intern_id(tc.interner, "M")

  # 1. empty unifies with empty (closed)
  var empty1 = vec_new()
  var empty2 = vec_new()
  var r1_a = tc_row_new(tc, empty1, -1)
  var r2_a = tc_row_new(tc, empty2, -1)
  _row_unify_report("empty_eq_empty", true, tc_row_unify(tc, r1_a, r2_a))

  # 2. [L] = [L] (closed)
  var labels_l_a = vec_new()
  labels_l_a.push(L)
  var labels_l_b = vec_new()
  labels_l_b.push(L)
  var r1_b = tc_row_new(tc, labels_l_a, -1)
  var r2_b = tc_row_new(tc, labels_l_b, -1)
  _row_unify_report("L_eq_L", true, tc_row_unify(tc, r1_b, r2_b))

  # 3. [L] ≠ [M] (closed)
  var labels_l_c = vec_new()
  labels_l_c.push(L)
  var labels_m_c = vec_new()
  labels_m_c.push(M)
  var r1_c = tc_row_new(tc, labels_l_c, -1)
  var r2_c = tc_row_new(tc, labels_m_c, -1)
  _row_unify_report("L_neq_M_closed", false, tc_row_unify(tc, r1_c, r2_c))

  # 4. [L | ρ] with [L, M] (closed) — ρ binds to [M], succeeds.
  var labels_l_d = vec_new()
  labels_l_d.push(L)
  var labels_lm_d = vec_new()
  labels_lm_d.push(L)
  labels_lm_d.push(M)
  var rho_d = typecheck_util::tc_erv_fresh(tc)
  var r1_d = tc_row_new(tc, labels_l_d, rho_d)
  var r2_d = tc_row_new(tc, labels_lm_d, -1)
  _row_unify_report("L_open_eq_LM_closed", true, tc_row_unify(tc, r1_d, r2_d))

  # 5. [L, M] with [M, L] (order-insensitive multiset)
  var labels_lm_e = vec_new()
  labels_lm_e.push(L)
  labels_lm_e.push(M)
  var labels_ml_e = vec_new()
  labels_ml_e.push(M)
  labels_ml_e.push(L)
  var r1_e = tc_row_new(tc, labels_lm_e, -1)
  var r2_e = tc_row_new(tc, labels_ml_e, -1)
  _row_unify_report("LM_eq_ML_unordered", true, tc_row_unify(tc, r1_e, r2_e))

  # 6. [L, L] with [L, L] (Model B — duplicates allowed)
  var labels_ll_f = vec_new()
  labels_ll_f.push(L)
  labels_ll_f.push(L)
  var labels_ll_f2 = vec_new()
  labels_ll_f2.push(L)
  labels_ll_f2.push(L)
  var r1_f = tc_row_new(tc, labels_ll_f, -1)
  var r2_f = tc_row_new(tc, labels_ll_f2, -1)
  _row_unify_report("LL_eq_LL_dup_allowed", true, tc_row_unify(tc, r1_f, r2_f))

  # 7. [L | ρ1] with [L | ρ2] (binds tails together)
  var labels_l_g = vec_new()
  labels_l_g.push(L)
  var labels_l_g2 = vec_new()
  labels_l_g2.push(L)
  var rho1_g = typecheck_util::tc_erv_fresh(tc)
  var rho2_g = typecheck_util::tc_erv_fresh(tc)
  var r1_g = tc_row_new(tc, labels_l_g, rho1_g)
  var r2_g = tc_row_new(tc, labels_l_g2, rho2_g)
  _row_unify_report("L_rho1_eq_L_rho2", true, tc_row_unify(tc, r1_g, r2_g))

  # 8. occurs check rejects [L | ρ] = ρ (where ρ is the ROW [] | ρ_self)
  var labels_l_h = vec_new()
  labels_l_h.push(L)
  var rho_h = typecheck_util::tc_erv_fresh(tc)
  var r1_h = tc_row_new(tc, labels_l_h, rho_h)
  var labels_empty_h = vec_new()
  var r2_h = tc_row_new(tc, labels_empty_h, rho_h)
  _row_unify_report("occurs_L_rho_eq_rho", false, tc_row_unify(tc, r1_h, r2_h))
end

## Helper: emit one ROW_UNIFY line to stderr.
def _row_unify_report(slug: String, expected: Bool, actual: Bool): Void
  var ok = "FAIL"
  if expected == actual
    ok = "PASS"
  end
  eprint("ROW_UNIFY #{slug}: #{ok}\n")
end

## Print one EFFECT_ROW line per registered function to stderr.
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.3).
## Used by `--dump-effect-rows` to expose registry state for QSpec
## subprocess tests; format is intentionally stable + greppable:
##
##     EFFECT_ROW fn=<name> row=<id> labels=<csv> tail=<name>
##
## row = -1 means the function is "untracked" (no `can` clause). Otherwise
## row indexes into TcRegistry.row_label_lists / row_tail_vars.
def tc_dump_effect_rows(tc: TypecheckState): Void
  var n = tc.registry.func_names.size
  for i in 0..n
    var fname = tc.registry.func_names[i]
    var row_id = tc.registry.func_effect_row_idx[i]
    var labels_str = ""
    var tail_str = ""
    if row_id >= 0
      var labels_vec = tc_row_get_labels(tc, row_id)
      var lc = labels_vec.size
      for li in 0..lc
        if li > 0
          labels_str = labels_str + ","
        end
        labels_str = labels_str + string_intern::intern_resolve_int(tc.interner, labels_vec[li])
      end
      var tail_erv = tc_row_get_tail(tc, row_id)
      if tail_erv > 0
        # Tail slot now holds an effect-row variable ID (B.4) — render as
        # `ρ<id>` so the dump is stable across renames of the source-level
        # tail variable name (which is no longer round-tripped post-B.4).
        tail_str = "ρ" + str_from_int(tail_erv)
      end
    end
    eprint("EFFECT_ROW fn=#{fname} row=#{row_id} labels=#{labels_str} tail=#{tail_str}\n")
  end
end

## Print one EFFECT_DECL line per (effect, op) pair to stderr.
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.7).
## Format intentionally stable + greppable for QSpec subprocess tests:
##
##     EFFECT_DECL effect=<name> op=<op_name> kind=<0|1|2>
##
## Kind classification:
##   0 = value    (zero params, eval-once — C.7)
##   1 = function (has params, computes — C.7)
##   2 = operation (resumable — body calls `resume`; F.2 classifier.
##                  Codegen-level continuation threading is F.3 scope.)
##
## If one effect declares no ops, nothing is printed for it — the
## pair-shaped dump is only meaningful when at least one op exists.
def tc_dump_effect_decls(tc: TypecheckState): Void
  var eff_count = tc.registry.effect_decl_names.size
  for ei in 0..eff_count
    var eff_name = tc.registry.effect_decl_names[ei]
    var oc = tc.registry.effect_decl_op_counts[ei]
    var os = tc.registry.effect_decl_op_starts[ei]
    for oi in 0..oc
      var op_name = tc.registry.effect_decl_op_names[os + oi]
      var op_kind = tc.registry.effect_decl_op_kinds[os + oi]
      eprint("EFFECT_DECL effect=#{eff_name} op=#{op_name} kind=#{op_kind}\n")
    end
  end
end

## Set the effect row ID for the func_idx-th registered function.
## No-op if func_idx is out of range. Used by B.3 once `can`-row data
## reaches the registration site.
def tc_set_func_effect_row(tc: TypecheckState, func_idx: Int, row_id: Int): Void
  if func_idx < 0
    return
  end
  if func_idx >= tc.registry.func_effect_row_idx.size
    return
  end
  tc.registry.func_effect_row_idx[func_idx] = row_id
end

## Get the effect row ID for the func_idx-th registered function.
## Returns -1 (untracked) on out-of-range access.
def tc_get_func_effect_row(tc: TypecheckState, func_idx: Int): Int
  if func_idx < 0
    return -1
  end
  if func_idx >= tc.registry.func_effect_row_idx.size
    return -1
  end
  return tc.registry.func_effect_row_idx[func_idx]
end

## Returns 1 if the function at `func_idx` declares the named effect in
## its `can` row, else 0. PSQ-6 / Sched effect, Phase C.1 (2026-04-30).
##
## Used by tc_function to decide whether to set `tc.in_sched_min_depth`
## before walking the body. The label name is interned via `tc.interner`
## (the same interner used by `tc_attach_func_effect_row` so IDs match).
def tc_func_has_effect(tc: TypecheckState, func_idx: Int, effect_name: String): Int
  var row_id = tc_get_func_effect_row(tc, func_idx)
  if row_id < 0
    return 0
  end
  var labels = tc_row_get_labels(tc, row_id)
  var target_id = string_intern::intern_id(tc.interner, effect_name)
  for li in 0..labels.size
    if labels[li] == target_id
      return 1
    end
  end
  return 0
end

# ============================================================================
# .qzmod emit (Phase 1.4.e — producer side wired into compile())
# ============================================================================
#
# `tc_emit_qzmod_modules` is the producer side of the .qzmod cache pipeline.
# Called by `compile()` after typecheck succeeds (post-Phase-4.5, pre-tc_free).
# Walks the dep graph and, for each imported module, partitions `all_funcs`
# by ast_store, builds a `QzmodEmitInput` view sourced from `tc.registry`,
# then calls `qzmod_emit_module` to write the section files + header.
#
# Phase 1.4.a contract: sig/field blobs hold producer-global type IDs
# verbatim; the TYPES section ships the FULL `tc.ptype_*` arena (with
# per-ptype identity in `types_names.bin` from 1.4.b.1). Decoder
# (Phase 1.4.b) walks TYPES to build a remap; inject (Phase 1.4.c)
# consumes that remap when rewriting blob type IDs.
#
# Failure modes silent (Principle #6 — advisory cache). A missing ast_store
# or empty output_dir is a per-module no-op; never aborts a compile.
#
# Dep-iface-hash propagation across compiles is a Phase 1.4.f+ concern
# (today both producer and consumer see empty strings → vacuous match;
# compiler-hash + source-hash + output_hash recompute carry invalidation
# in the meantime).
def tc_emit_qzmod_modules(
  tc: TypecheckState,
  all_funcs: Vec<ResolverEntry>,
  mir_prog: MirProgram,
  project_root: String,
  target: String,
  debug_mode: Int,
  no_opt: Int,
  overflow_check: Int,
  exclusivity_check: Int,
  recompile_set: Vec<String>,
  is_incremental: Int
): Void
  var compiler_hash = qzmod_format::qzmod_compiler_hash()
  var flags_str = qzmod_format::qzmod_canonical_flags(target, debug_mode, no_opt, overflow_check, exclusivity_check)
  var flags_hash = content_hash::content_hash(flags_str)

  var mod_names = dep_graph::depgraph_get_all_names()
  for mi in 0..mod_names.size
    var module_name = mod_names[mi]
    # __main__ is owned by compile()'s Tier 0/1/2 LLVM IR cache layer.
    # .qzmod is for imported modules only.
    if not str_eq(module_name, "__main__")
      # INC.1.10: on incremental warm runs, skip re-emit for modules not
      # in recompile_set. `tc.registry.fn_type_annotations` is a process-
      # global Vec accumulated across all AST-walked modules. Cold walks
      # every module so the registry is fully populated; warm walks only
      # recompile_set so the registry is partial. Re-emitting an unchanged
      # module with the partial registry shrinks its `fn_type_annotations.bin`
      # below the indexes referenced by its own TYPES section — the next
      # warm run's inject then reads garbage / hits the bounds-miss path
      # and falls back to advisory-miss. Skipping unchanged modules keeps
      # their cold-emitted .qzmod intact across warm runs.
      var should_emit = 1
      if is_incremental == 1
        should_emit = 0
        for ri in 0..recompile_set.size
          if str_eq(recompile_set[ri], module_name)
            should_emit = 1
          end
        end
      end
      if should_emit == 1
        _tc_emit_qzmod_one(tc, all_funcs, mir_prog, module_name, project_root, compiler_hash, flags_hash)
      end
    end
  end
end

## Emit one module's `.qzmod` directory. Private helper for
## `tc_emit_qzmod_modules`; extracted to keep the per-module logic
## readable.
def _tc_emit_qzmod_one(
  tc: TypecheckState,
  all_funcs: Vec<ResolverEntry>,
  mir_prog: MirProgram,
  module_name: String,
  project_root: String,
  compiler_hash: String,
  flags_hash: String
): Void
  var this_ast_store = dep_graph::depgraph_get_ast_store(module_name)
  if this_ast_store == 0
    # Module never had its AST store registered (parse failed, etc).
    return
  end

  var input = qzmod_emit::qzmod_input_new(module_name)

  # Walk all_funcs once, filtered by ast_store. Each matching entry
  # dispatches by tag to pull the parallel registry data into the
  # per-section view vecs.
  for ei in 0..all_funcs.size
    var entry = all_funcs[ei]
    if entry.ast_store == this_ast_store
      _tc_emit_qzmod_push_entry(tc, entry, input)
    end
  end

  # INC.1.2 — populate `input.mir_funcs` with every MirFunc this module
  # produced. Filter is `origin_module == module_name` (set at MIR
  # lowering — see `mir_lower.qz:4181` user fns and
  # `mir_lower_expr_handlers.qz:478` lambdas / `:867` iter-closures).
  # Synthetic functions (async ctors, actor proxies, `__qz_module_init`,
  # specialization bodies) leave `origin_module = ""` and are not shipped
  # — the consumer re-derives them via call-graph analysis after .qzmod
  # load. Bounded generics are skipped at the producer (mir_lower.qz:5183);
  # they never enter `mir_prog.functions`, so no special-case needed.
  #
  # The shipped order is the producer's `mir_prog.functions` order. The
  # consumer reads names from `mir_bodies_name.bin` (parallel to offsets);
  # no need to align with `funcs_name.bin` since lambdas have synthetic
  # names not present there.
  var mir_funcs = mir::mir_get_functions(mir_prog)
  for mfi in 0..mir_funcs.size
    var handle = mir_funcs[mfi]
    if str_eq(handle.mir_func_get_origin_module(), module_name)
      input.mir_funcs.push(handle)
    end
  end

  # TYPES section — closure-bounded ptype ship (Phase 1.4.c.2.a).
  # Walks input blob type IDs to collect seed producer ptype indices,
  # closes over arg1/arg2, and ships only the closure subset with both
  # the shipped arg1/arg2 fields AND the input blob type IDs rewritten
  # to compact shipped indices. Avoids leaking ptypes from non-local
  # modules into this module's .qzmod TYPES — the prerequisite for
  # activating tc_inject_qzmod in compile() without colliding with
  # AST-path ptype creation in non-cached modules. See feedback memo
  # `feedback_qzmod_1_4_c_1_full_arena_ptype_collision.md`.
  _tc_emit_qzmod_close_types(tc, input)

  # Phase 1.4.b.1: fn_type registry — annotation strings indexed by
  # producer fn_id. Consumer re-interns by annotation via
  # `tc_register_fn_type` so TYPE_FUNCTION ptypes round-trip identity.
  for fi in 0..tc.registry.fn_type_annotations.size
    input.fn_type_annotations.push(tc.registry.fn_type_annotations[fi])
  end

  # Dep table — mirror the resolver probe's `depgraph_get_deps` order so
  # the consumer's positional `_qzmod_strvec_eq` validates cleanly.
  var dep_names = dep_graph::depgraph_get_deps(module_name)
  var dep_iface_hashes = vec_new<String>()
  for di in 0..dep_names.size
    dep_iface_hashes.push(dep_graph::depgraph_get_interface_hash(dep_names[di]))
  end

  var source_hash = dep_graph::depgraph_get_content_hash(module_name)

  # Bug A.2 — empty-artifact guard. When all input sections are empty
  # (no funcs / structs / enums / etc. matched this module's ast_store,
  # and no MirFuncs had origin_module == module_name), emitting an
  # artifact creates an empty directory whose loader-side `header.txt
  # absent` miss is the same outcome as having no artifact at all —
  # except the empty dir tricks the resolver-side qzmod probe at a few
  # corners. Skip the emit entirely so the directory never appears, and
  # the consumer cleanly falls back to source-compile via the resolver
  # probe's `header.txt absent` miss path. Common case: dep_graph aliases
  # ("terminal" + "std/terminal") for the same source — only the
  # canonical alias matches.
  var has_content = input.func_names.size + input.struct_names.size +
    input.enum_names.size + input.trait_names.size +
    input.impl_trait_names.size + input.type_alias_names.size +
    input.newtype_names.size + input.effect_decl_names.size +
    input.const_names.size + input.global_names.size +
    input.mir_funcs.size
  if has_content == 0
    return
  end

  var output_dir = qzmod_format::qzmod_module_dir(project_root, compiler_hash, module_name)
  var _hash = qzmod_emit::qzmod_emit_module(
    input, source_hash, flags_hash, dep_names, dep_iface_hashes, output_dir
  )
end

## Push one ResolverEntry's registry data into the QzmodEmitInput view.
## Tag-dispatched lookup of the matching `tc.registry.*` slot.
##
## Phase 1.4.e scope: funcs, structs, enums, traits, type aliases,
## newtypes, effect decls, consts/globals (names-only per Phase 1.1
## view contract). Impls and extern_fn deliberately skipped — impls
## need cross-module name attribution that Phase 1.4.c will revisit;
## extern_fn has no body to cache.
def _tc_emit_qzmod_push_entry(tc: TypecheckState, entry: ResolverEntry, input: QzmodEmitInput): Void
  var tag = entry.tag
  if tag == 0  # RESOLVE_TAG_FUNC
    var fidx = tc_lookup_function_index(tc, entry.name)
    if fidx >= 0
      input.func_names.push(entry.name)
      input.func_param_types.push(tc.registry.func_param_types[fidx])
      input.func_return_types.push(tc.registry.func_return_types[fidx])
      input.func_required_counts.push(tc.registry.func_required_counts[fidx])

      # Phase 1.4.c.3 — effect row (parallel push).
      # state encoding: 0 = untracked, 1 = closed, 2 = open.
      # Labels resolve through `string_intern::intern_resolve_int` so
      # the consumer can re-intern via `string_intern::intern_id` on
      # its own interner. The tail's erv id isn't shippable (producer-
      # local); state==2 signals "consumer allocates a fresh tail".
      var row_id_fe = tc_get_func_effect_row(tc, fidx)
      var state_fe = 0
      var labels_out_fe = vec_new<String>()
      if row_id_fe >= 0
        var tail_fe = tc_row_get_tail(tc, row_id_fe)
        if tail_fe >= 0
          state_fe = 2
        else
          state_fe = 1
        end
        var label_ids_fe = tc_row_get_labels(tc, row_id_fe)
        for li_fe in 0..label_ids_fe.size
          labels_out_fe.push(string_intern::intern_resolve_int(tc.interner, label_ids_fe[li_fe]))
        end
      end
      input.func_effect_state.push(state_fe)
      input.func_effect_labels.push(labels_out_fe)

      # Phase 1.4.c.3 — string annotations (parallel push). These
      # round-trip the AST-path's `tc_register_function_signature_named`
      # writes so the consumer's UFCS dispatch + generic instantiation
      # finds the same struct/enum names + type-param strings.
      var _ret_ann = ""
      if fidx < tc.registry.func_return_annotations.size
        _ret_ann = tc.registry.func_return_annotations[fidx]
      end
      var _param_ann = ""
      if fidx < tc.registry.func_param_annotations.size
        _param_ann = tc.registry.func_param_annotations[fidx]
      end
      var _param_names = ""
      if fidx < tc.registry.func_param_names.size
        _param_names = tc.registry.func_param_names[fidx]
      end
      var _tp = ""
      if fidx < tc.registry.func_type_params.size
        _tp = tc.registry.func_type_params[fidx]
      end
      var _tpb = ""
      if fidx < tc.registry.func_type_param_bounds.size
        _tpb = tc.registry.func_type_param_bounds[fidx]
      end
      input.func_return_annotations.push(_ret_ann)
      input.func_param_annotations.push(_param_ann)
      input.func_param_names.push(_param_names)
      input.func_type_params.push(_tp)
      input.func_type_param_bounds.push(_tpb)

      # Fn-typed param annotations — Vec<Int> per func, each Int is
      # `as_int(annotation_string)` (or 0 for non-Fn params). Stored
      # as a flat strvec with per-func [start, count] for round-trip;
      # `as_int_to_str` recovers the string from the i64. Empty
      # string for non-Fn slots so the position indexing survives.
      var _fn_anns_vec = vec_new<Int>()
      if fidx < tc.registry.func_param_fn_annotations.size
        _fn_anns_vec = tc.registry.func_param_fn_annotations[fidx]
      end
      input.func_param_fn_anns_starts.push(input.func_param_fn_anns.size)
      input.func_param_fn_anns_counts.push(_fn_anns_vec.size)
      for _i in 0.._fn_anns_vec.size
        var _raw = _fn_anns_vec[_i]
        var _s = ""
        if _raw != 0
          _s = as_string(_raw)
        end
        input.func_param_fn_anns.push(_s)
      end
    end
  elsif tag == 4  # RESOLVE_TAG_STRUCT_DEF
    var sres = tc_lookup_struct(tc, entry.name)
    if sres.is_found() == 1
      var sidx = sres.unwrap()
      input.struct_names.push(entry.name)
      input.struct_field_names.push(tc.registry.struct_field_names[sidx])
      input.struct_field_types.push(tc.registry.struct_field_types[sidx])
      var is_linear = 0
      if sidx < tc.registry.struct_is_linear.size
        is_linear = tc.registry.struct_is_linear[sidx]
      end
      input.struct_is_linear.push(is_linear)
      # Phase 1.4.c.0: parallel generic / annotation data.
      var stp = ""
      if sidx < tc.registry.struct_type_params.size
        stp = tc.registry.struct_type_params[sidx]
      end
      input.struct_type_params.push(stp)
      var sfa = vec_new<String>()
      if sidx < tc.registry.struct_field_annotations.size
        sfa = tc.registry.struct_field_annotations[sidx]
      end
      input.struct_field_annotations.push(sfa)
    end
  elsif tag == 5  # RESOLVE_TAG_ENUM_DEF
    var eres = tc_lookup_enum(tc, entry.name)
    if eres.is_found() == 1
      var eidx = eres.unwrap()
      input.enum_names.push(entry.name)
      input.enum_variant_names.push(tc.registry.enum_variant_names[eidx])
      input.enum_variant_payloads.push(tc.registry.enum_variant_payloads[eidx])
      # Phase 1.4.c.0: parallel generic / annotation data.
      var etp = ""
      if eidx < tc.registry.enum_type_params.size
        etp = tc.registry.enum_type_params[eidx]
      end
      input.enum_type_params.push(etp)
      var eva = vec_new<String>()
      if eidx < tc.registry.enum_variant_field_annotations.size
        eva = tc.registry.enum_variant_field_annotations[eidx]
      end
      input.enum_variant_field_annotations.push(eva)
    end
  elsif tag == 6  # RESOLVE_TAG_TYPE_ALIAS
    var ai = _tc_find_string(tc.registry.type_alias_names, entry.name)
    if ai >= 0
      input.type_alias_names.push(entry.name)
      input.type_alias_types.push(tc.registry.type_alias_types[ai])
    end
  elsif tag == 7  # RESOLVE_TAG_NEWTYPE_DEF
    var ni = _tc_find_string(tc.registry.newtype_names, entry.name)
    if ni >= 0
      input.newtype_names.push(entry.name)
      input.newtype_wrapped_types.push(tc.registry.newtype_wrapped_types[ni])
      # INC.1.9 — ship the producer-global newtype type ID
      # (TYPE_NEWTYPE_BASE + producer_global_idx). Consumer uses this to
      # key a producer→consumer remap for func sigs that reference
      # newtype param types.
      var nt_id = 0
      if ni < tc.registry.newtype_type_ids.size
        nt_id = tc.registry.newtype_type_ids[ni]
      end
      input.newtype_type_ids.push(nt_id)
      # STRICT_NEWTYPES_QZMOD — ship the per-newtype `@strict` flag so a
      # `Secret<T>` declared here keeps its strictness when injected
      # cross-module from the qzmod cache.
      var nt_strict = 0
      if ni < tc.registry.newtype_strict_flags.size
        nt_strict = tc.registry.newtype_strict_flags[ni]
      end
      input.newtype_strict_flags.push(nt_strict)
    end
  elsif tag == 8  # RESOLVE_TAG_TRAIT_DEF
    var tres = tc_lookup_trait(tc, entry.name)
    if tres.is_found() == 1
      var tidx = tres.unwrap()
      input.trait_names.push(entry.name)
      input.trait_method_names.push(tc.registry.trait_method_names[tidx])
      input.trait_method_sigs.push(tc.registry.trait_method_sigs[tidx])
      input.trait_method_defaults.push(tc.registry.trait_method_defaults[tidx])
      # Phase 1.4.c.0: parallel generic / super-trait data.
      var ttp = ""
      if tidx < tc.registry.trait_type_params.size
        ttp = tc.registry.trait_type_params[tidx]
      end
      input.trait_type_params.push(ttp)
      var tst = ""
      if tidx < tc.registry.trait_super_traits.size
        tst = tc.registry.trait_super_traits[tidx]
      end
      input.trait_super_traits.push(tst)
    end
  elsif tag == 9  # RESOLVE_TAG_IMPL_BLOCK
    # The resolver tags impl blocks with `entry.name = for_type` (resolver.qz:1412).
    # Trait name lives on the AST node — read directly. Negative impls
    # (`impl !Trait for Type`) are short-circuited by tc_register_impl_block
    # and never land in `impl_trait_names`; we skip them here via the
    # ast_get_int_val == 1 check.
    var trait_name = ast::ast_get_str1(entry.ast_store, entry.node_id)
    var for_type = ast::ast_get_str2(entry.ast_store, entry.node_id)
    var is_neg = ast::ast_get_int_val(entry.ast_store, entry.node_id)
    if str_byte_len(trait_name) > 0 and str_byte_len(for_type) > 0 and is_neg == 0
      input.impl_trait_names.push(trait_name)
      input.impl_for_types.push(for_type)
    end
  elsif tag == 15  # RESOLVE_TAG_EFFECT_DECL
    var efi = _tc_find_string(tc.registry.effect_decl_names, entry.name)
    if efi >= 0
      var op_start_local = input.effect_decl_op_names.size
      var op_start_src = tc.registry.effect_decl_op_starts[efi]
      var op_count = tc.registry.effect_decl_op_counts[efi]
      input.effect_decl_names.push(entry.name)
      input.effect_decl_op_starts.push(op_start_local)
      input.effect_decl_op_counts.push(op_count)
      for oi in 0..op_count
        var src_slot = op_start_src + oi
        input.effect_decl_op_names.push(tc.registry.effect_decl_op_names[src_slot])
        input.effect_decl_op_kinds.push(tc.registry.effect_decl_op_kinds[src_slot])
        input.effect_decl_op_return_types.push(tc.registry.effect_decl_op_return_types[src_slot])
        input.effect_decl_op_param_types.push(tc.registry.effect_decl_op_param_types[src_slot])
      end
    end
  elsif tag == 1  # RESOLVE_TAG_GLOBAL_VAR
    input.global_names.push(entry.name)
  elsif tag == 2  # RESOLVE_TAG_CONST_DECL
    input.const_names.push(entry.name)
  end
  # Other tags (BINARY_BLOCK, PACKED_STRUCT, IMPL_BLOCK, EXTERN_FN,
  # ACTOR_DEF, ...) deliberately skipped in Phase 1.4.e — they're
  # revisited as Phase 1.4.c tightens the inject side and we learn
  # what consumers need to resolve.
end

## Linear search for `s` in a Vec<String>. Returns the matching index or
## -1 if absent. Used for tag-dispatched lookups of type aliases /
## newtypes / effect decls, where the registry lacks a dedicated lookup
## helper.
def _tc_find_string(v: Vec<String>, s: String): Int
  for i in 0..v.size
    if str_eq(v[i], s)
      return i
    end
  end
  return -1
end

# ============================================================================
# Closure-bounded ptype ship (Phase 1.4.c.2.a)
# ============================================================================
#
# `_tc_emit_qzmod_close_types` computes the transitive closure of producer
# ptype indices reachable from this module's blob type IDs, then ships
# only those slots — with arg1/arg2 and the input blob type IDs rewritten
# to compact shipped indices. The consumer's `qzmod_build_ptype_remap`
# walks TYPES in shipped order (preserving topo order from producer's
# ascending-index iteration) and the existing inject blob remap path
# (`_qzmod_inject_remap_blob_id`) consumes the compact indices transparently.
#
# Encoding rule on arg1/arg2 + blob type IDs:
#   - 0..1000              primitive / well-known     pass through
#   - 1000..PTYPE_BASE     derived base (newtype etc) pass through (advisory miss on load)
#   - PTYPE_BASE+i         ptype reference            rewrite via map[i]
#
# TYPE_FUNCTION's arg1 is a producer fn_id (separate registry shipped via
# `fn_type_annotations`), NOT a type ID — skipped in both closure walk
# and rewrite. arg2 for TYPE_FUNCTION is currently always 0.
#
# For TYPE_VEC/TYPE_SLICE/TYPE_SLICE_MUT, arg2 is the container's
# struct_idx (< 1000) — passes through verbatim, matching current
# semantics. For Stream ptypes, arg2 is body_row+1 (small int) — same
# passthrough. Consumer-side dedup via `tc_ptype_set_name` matching is
# unchanged.

def _tc_emit_qzmod_close_types(tc: TypecheckState, input: QzmodEmitInput): Void
  var ptype_count = tc.ptype_bases.size
  var needed = vec_new<Int>()
  for _i in 0..ptype_count
    needed.push(0)
  end

  _qzmod_close_mark_seeds(input, needed, ptype_count)
  _qzmod_close_fixpoint(tc, needed, ptype_count)

  # Build the producer_idx → shipped_idx map. Ascending producer-index
  # iteration preserves the topological-sort invariant the consumer's
  # remap walker depends on.
  var pmap = vec_new<Int>()
  for _i in 0..ptype_count
    pmap.push(-1)
  end
  var shipped_producer_idx = vec_new<Int>()
  for pi in 0..ptype_count
    if needed[pi] == 1
      pmap[pi] = shipped_producer_idx.size
      shipped_producer_idx.push(pi)
    end
  end

  # Ship the closure subset, rewriting arg1/arg2.
  for si in 0..shipped_producer_idx.size
    var pi = shipped_producer_idx[si]
    var base = tc.ptype_bases[pi]
    var a1 = 0
    if pi < tc.ptype_arg1s.size
      a1 = tc.ptype_arg1s[pi]
    end
    var a2 = 0
    if pi < tc.ptype_arg2s.size
      a2 = tc.ptype_arg2s[pi]
    end
    var ra1 = a1
    if base != type_constants::TYPE_FUNCTION
      ra1 = _qzmod_close_rewrite_id(a1, pmap)
    end
    var ra2 = _qzmod_close_rewrite_id(a2, pmap)
    input.ptype_bases.push(base)
    input.ptype_arg1s.push(ra1)
    input.ptype_arg2s.push(ra2)
    var name = ""
    if pi < tc.ptype_names.size
      name = tc.ptype_names[pi]
    end
    input.ptype_names.push(name)
  end

  # Rewrite all blob type IDs in-place.
  _qzmod_close_rewrite_blobs(input, pmap)

  # D3 — ship the structural signature of every union / record VALUE type id
  # this module's blobs reference (band TYPE_UNION_BASE..TYPE_RECORD_BASE+1000).
  # Post-termification these are constructible values that can cross a module
  # boundary; without the signature the consumer can only advisory-miss the
  # band id. Signatures round-trip by structural string (union member list /
  # record field list), which the consumer re-interns in its own registry —
  # exactly like newtype wrapped-type strings (INC.1.9). Runs AFTER the ptype
  # rewrite because it scans the (unchanged) band ids in the blobs, which the
  # ptype rewrite leaves verbatim (band ids are < PTYPE_BASE).
  _tc_emit_qzmod_collect_union_record_sigs(tc, input)
end

## D3 — collect the union / record band ids referenced by this module's
## blobs and push their structural signatures into the emit view. Band ids
## in the blobs are producer-global and pass through the ptype rewrite
## untouched (they are < PTYPE_BASE), so scanning the post-rewrite blobs is
## correct. De-duplicated per band id so each signature ships once.
def _tc_emit_qzmod_collect_union_record_sigs(tc: TypecheckState, input: QzmodEmitInput): Void
  var union_seen = vec_new<Int>()
  var record_seen = vec_new<Int>()

  # Struct fields.
  for si in 0..input.struct_field_types.size
    var fts = input.struct_field_types[si]
    for j in 0..fts.size
      _tc_emit_qzmod_mark_union_record(tc, fts[j], input, union_seen, record_seen)
    end
  end
  # Enum variant payloads.
  for ei in 0..input.enum_variant_payloads.size
    var vps = input.enum_variant_payloads[ei]
    for vi in 0..vps.size
      var ps = vps[vi]
      for j in 0..ps.size
        _tc_emit_qzmod_mark_union_record(tc, ps[j], input, union_seen, record_seen)
      end
    end
  end
  # Func param + return types.
  for fi in 0..input.func_param_types.size
    var pts = input.func_param_types[fi]
    for j in 0..pts.size
      _tc_emit_qzmod_mark_union_record(tc, pts[j], input, union_seen, record_seen)
    end
  end
  for fi in 0..input.func_return_types.size
    _tc_emit_qzmod_mark_union_record(tc, input.func_return_types[fi], input, union_seen, record_seen)
  end
  # Effect op return + param types.
  for ki in 0..input.effect_decl_op_return_types.size
    _tc_emit_qzmod_mark_union_record(tc, input.effect_decl_op_return_types[ki], input, union_seen, record_seen)
  end
  for ki in 0..input.effect_decl_op_param_types.size
    var ps = input.effect_decl_op_param_types[ki]
    for j in 0..ps.size
      _tc_emit_qzmod_mark_union_record(tc, ps[j], input, union_seen, record_seen)
    end
  end
  # D3-container — nested band ids: a union / record type id can live inside a
  # ptype arg slot (Vec<Int|String> stores the Int|String union band id in
  # arg1; Map<K, {record}> stores the record band id in arg2). input.ptype_arg1s
  # / arg2s were populated by _tc_emit_qzmod_close_types (the shipped-closure
  # loop) BEFORE this collector runs (same fn body, this call is after it), so
  # the arg slots are live. Band ids are < PTYPE_BASE so the ptype-rewrite left
  # them verbatim (mirrors the blob-scan invariant). The marker no-ops on
  # non-band ids (primitives, struct_idx tags, PTYPE ids), so scanning both
  # slots unconditionally is safe and de-dups against the blob-found set.
  for pi in 0..input.ptype_arg1s.size
    _tc_emit_qzmod_mark_union_record(tc, input.ptype_arg1s[pi], input, union_seen, record_seen)
  end
  for pi in 0..input.ptype_arg2s.size
    _tc_emit_qzmod_mark_union_record(tc, input.ptype_arg2s[pi], input, union_seen, record_seen)
  end
end

## D3 — if `tid` is a union / record band id not yet shipped, push its
## structural signature into the emit view and record it as seen.
def _tc_emit_qzmod_mark_union_record(
  tc: TypecheckState,
  tid: Int,
  input: QzmodEmitInput,
  union_seen: Vec<Int>,
  record_seen: Vec<Int>
): Void
  # Union band: TYPE_UNION_BASE .. TYPE_RECORD_BASE.
  if tid >= type_constants::TYPE_UNION_BASE and tid < type_constants::TYPE_RECORD_BASE
    if _tc_vec_int_contains(union_seen, tid) == 0
      union_seen.push(tid)
      var uidx = tid - type_constants::TYPE_UNION_BASE
      var members = ""
      if uidx >= 0 and uidx < tc.registry.union_member_strings.size
        members = tc.registry.union_member_strings[uidx]
      end
      input.union_sig_ids.push(tid)
      input.union_sig_members.push(members)
    end
    return
  end
  # Record band: TYPE_RECORD_BASE .. TYPE_RECORD_BASE+1000. Intersection ids
  # (TYPE_INTERSECTION_BASE=4000+) are intentionally NOT shipped — an all-
  # record intersection is already merged into a plain TYPE_RECORD id at
  # registration (D1), so it rides this record path; a mixed / bound-only
  # intersection is not a constructible value and stays advisory-miss.
  if tid >= type_constants::TYPE_RECORD_BASE and tid < type_constants::TYPE_RECORD_BASE + 1000
    if _tc_vec_int_contains(record_seen, tid) == 0
      record_seen.push(tid)
      var ridx = tid - type_constants::TYPE_RECORD_BASE
      var fnames = vec_new<String>()
      var ftypes = vec_new<String>()
      if ridx >= 0 and ridx < tc.registry.record_field_names.size
        fnames = tc.registry.record_field_names[ridx]
      end
      if ridx >= 0 and ridx < tc.registry.record_field_types.size
        ftypes = tc.registry.record_field_types[ridx]
      end
      input.record_sig_ids.push(tid)
      input.record_sig_field_names.push(fnames)
      input.record_sig_field_types.push(ftypes)
    end
    return
  end
end

## D3 — linear membership test over a Vec<Int> (seen-set dedup).
def _tc_vec_int_contains(v: Vec<Int>, x: Int): Int
  for i in 0..v.size
    if v[i] == x
      return 1
    end
  end
  return 0
end

## Mark every producer ptype index referenced by this module's blob
## type IDs (func sigs / struct fields / enum payloads / effect ops).
## Bounds-checks against the producer's full ptype arena (`ptype_count`)
## — out-of-range IDs are silently skipped (caller treats as advisory
## miss path through the unchanged loader behavior).
def _qzmod_close_mark_seeds(input: QzmodEmitInput, needed: Vec<Int>, ptype_count: Int): Void
  for fi in 0..input.func_param_types.size
    var pts = input.func_param_types[fi]
    for j in 0..pts.size
      _qzmod_close_mark_one(pts[j], needed, ptype_count)
    end
  end
  for fi in 0..input.func_return_types.size
    _qzmod_close_mark_one(input.func_return_types[fi], needed, ptype_count)
  end
  for si in 0..input.struct_field_types.size
    var fts = input.struct_field_types[si]
    for j in 0..fts.size
      _qzmod_close_mark_one(fts[j], needed, ptype_count)
    end
  end
  for ei in 0..input.enum_variant_payloads.size
    var vps = input.enum_variant_payloads[ei]
    for vi in 0..vps.size
      var ps = vps[vi]
      for j in 0..ps.size
        _qzmod_close_mark_one(ps[j], needed, ptype_count)
      end
    end
  end
  for ki in 0..input.effect_decl_op_return_types.size
    _qzmod_close_mark_one(input.effect_decl_op_return_types[ki], needed, ptype_count)
  end
  for ki in 0..input.effect_decl_op_param_types.size
    var ps = input.effect_decl_op_param_types[ki]
    for j in 0..ps.size
      _qzmod_close_mark_one(ps[j], needed, ptype_count)
    end
  end
end

def _qzmod_close_mark_one(tid: Int, needed: Vec<Int>, ptype_count: Int): Void
  if tid >= type_constants::PTYPE_BASE
    var idx = tid - type_constants::PTYPE_BASE
    if idx >= 0 and idx < ptype_count
      needed[idx] = 1
    end
  end
end

## Walk arg1/arg2 of every needed ptype, marking transitively reachable
## producer ptype indices. Iterates to fixpoint. TYPE_FUNCTION's arg1
## is a producer fn_id — not a type ID — so it's skipped here.
def _qzmod_close_fixpoint(tc: TypecheckState, needed: Vec<Int>, ptype_count: Int): Void
  var changed = 1
  while changed == 1
    changed = 0
    for i in 0..ptype_count
      if needed[i] == 1
        var base = tc.ptype_bases[i]
        var a1 = 0
        if i < tc.ptype_arg1s.size
          a1 = tc.ptype_arg1s[i]
        end
        var a2 = 0
        if i < tc.ptype_arg2s.size
          a2 = tc.ptype_arg2s[i]
        end
        if base != type_constants::TYPE_FUNCTION
          if a1 >= type_constants::PTYPE_BASE
            var idx = a1 - type_constants::PTYPE_BASE
            if idx >= 0 and idx < ptype_count and needed[idx] == 0
              needed[idx] = 1
              changed = 1
            end
          end
        end
        if a2 >= type_constants::PTYPE_BASE
          var idx = a2 - type_constants::PTYPE_BASE
          if idx >= 0 and idx < ptype_count and needed[idx] == 0
            needed[idx] = 1
            changed = 1
          end
        end
      end
    end
  end
end

## Rewrite one type ID through `pmap` (producer ptype idx → shipped idx).
## Non-ptype IDs (primitives, struct_idx-shaped derived bases) pass
## through verbatim — matching the legacy load semantics.
def _qzmod_close_rewrite_id(tid: Int, pmap: Vec<Int>): Int
  if tid < type_constants::PTYPE_BASE
    return tid
  end
  var idx = tid - type_constants::PTYPE_BASE
  if idx < 0 or idx >= pmap.size
    return tid
  end
  var shipped = pmap[idx]
  if shipped < 0
    return tid
  end
  return type_constants::PTYPE_BASE + shipped
end

## Rewrite every blob type ID slot in `input` through `pmap` so the
## .qzmod's STRUCTS / ENUMS / FUNCS / EFFECT_DECLS sections reference
## the compact shipped TYPES indices instead of producer-global ones.
def _qzmod_close_rewrite_blobs(input: QzmodEmitInput, pmap: Vec<Int>): Void
  for si in 0..input.struct_field_types.size
    var fts = input.struct_field_types[si]
    for j in 0..fts.size
      fts[j] = _qzmod_close_rewrite_id(fts[j], pmap)
    end
  end
  for ei in 0..input.enum_variant_payloads.size
    var vps = input.enum_variant_payloads[ei]
    for vi in 0..vps.size
      var ps = vps[vi]
      for j in 0..ps.size
        ps[j] = _qzmod_close_rewrite_id(ps[j], pmap)
      end
    end
  end
  for fi in 0..input.func_param_types.size
    var pts = input.func_param_types[fi]
    for j in 0..pts.size
      pts[j] = _qzmod_close_rewrite_id(pts[j], pmap)
    end
  end
  for fi in 0..input.func_return_types.size
    input.func_return_types[fi] = _qzmod_close_rewrite_id(input.func_return_types[fi], pmap)
  end
  for ki in 0..input.effect_decl_op_return_types.size
    input.effect_decl_op_return_types[ki] = _qzmod_close_rewrite_id(input.effect_decl_op_return_types[ki], pmap)
  end
  for ki in 0..input.effect_decl_op_param_types.size
    var ps = input.effect_decl_op_param_types[ki]
    for j in 0..ps.size
      ps[j] = _qzmod_close_rewrite_id(ps[j], pmap)
    end
  end
end

