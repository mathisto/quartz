##! # Type Checker Walking Logic
##!
##! Core AST walking: tc_expr dispatcher, tc_stmt, tc_function,
##! tc_program orchestration, and tc_check_program.
##!
##! Handler functions and helpers are in focused submodules:
##! - typecheck_helpers: Pure validation (binary, unary, let, assign, etc.)
##! - typecheck_generics: Type parameter inference, struct init, enum access
##! - typecheck_match: Pattern matching, variable binding, exhaustiveness
##! - typecheck_concurrency: Send/Sync, spawn, await, select
##! - typecheck_capture: Closure capture collection
##! - typecheck_expr_handlers: tc_expr_call, tc_expr_match, etc.
##!
##! @see typecheck Core infrastructure and registration
##! @since 5.25.0

import typecheck
import typeenv
import ast
import diagnostic
import typecheck_util
import typecheck_diag
import typecheck_builtins
import typecheck_registry
import typecheck_helpers
import typecheck_generics
import typecheck_match
import typecheck_concurrency
import typecheck_capture
import typecheck_expr_handlers
import liveness
import exclusivity
import compiler_types
import string_intern
import node_constants
import type_constants
import std/diag
import * from str_compat

## Bounded DFS over an effect-op body looking for a call to `resume`.
##
## Operation Piezoelectric Effects, Milestone F (chunk F.2). A hit
## upgrades the enclosing op's kind to 2 ("operation" / resumable).
##
## Conservative by design: matches any NODE_CALL whose callee is a
## NODE_IDENT named "resume", anywhere in the body subtree (including
## nested blocks, ifs, matches, lambdas). A user shadowing `resume` as
## an ordinary variable inside an op body will also upgrade the kind,
## which is harmless for the classifier alone — codegen (F.3 scope)
## decides what a kind=2 op does differently at dispatch time.
##
## Detect the canonical endless-def body shape that stays kind=2:
## the parser emits `def foo(...) = resume(x)` as NODE_BLOCK wrapping a
## single NODE_RETURN whose expression is a NODE_CALL to `resume`. Any
## body not matching this exact shape that contains a resume call is
## classified kind=3 (non-tail resume — continuation-preserving) in
## tc_register_effect_decl_node below.
##
## The check is intentionally strict: it returns true ONLY for the
## endless-def-with-bare-resume pattern. Multi-statement bodies, nested
## expression bodies (e.g. `= resume(0) + 1`), and conditional bodies
## (e.g. `= if cond then resume(0) else resume(1) end`) all fail this
## check and fall through to kind=3.
##
## That's the right conservative stance for P3.0b: we only know today's
## ops (Throws.throw, ParseError.parse_error) are kind=2 unwind-style.
## A richer tail-position analysis can promote more shapes back to
## kind=2 if kind=3 machinery turns out to be a real perf hit on
## abort-flavored handlers — so far evidence says no.
def tc_body_is_endless_def_tail_resume(ast_storage: ast::AstStorage, body: AstNodeId): Bool
  if body <= 0
    return false
  end
  if ast::ast_get_kind(ast_storage, body) != node_constants::NODE_BLOCK
    return false
  end
  var stmts = ast::ast_get_children(ast_storage, body)
  if stmts == 0
    return false
  end
  if stmts.size != 1
    return false
  end
  var ret_node = stmts[0]
  if ast::ast_get_kind(ast_storage, ret_node) != node_constants::NODE_RETURN
    return false
  end
  var ret_expr = ast::ast_get_left(ast_storage, ret_node)
  if ret_expr <= 0
    return false
  end
  if ast::ast_get_kind(ast_storage, ret_expr) != node_constants::NODE_CALL
    return false
  end
  var callee = ast::ast_get_left(ast_storage, ret_expr)
  if callee <= 0
    return false
  end
  if ast::ast_get_kind(ast_storage, callee) != node_constants::NODE_IDENT
    return false
  end
  if ast::ast_get_str1(ast_storage, callee) != "resume"
    return false
  end
  return true
end

## P3.A: detect the `= operation` marker on an effect op decl.
##
## The memo §2.4 gives users an explicit knob to force operation-kind
## classification when the body shape alone can't express intent:
## abstract (body-less) ops and function-shaped defaults both default
## to kind=0/1 today, but some effects (Async.await/spawn/suspend,
## Ndet.choose) are *semantically* operation-kind — handlers need to
## capture the caller's continuation. Without this marker we'd have
## to name-match specific effects (PD2 violation) or widen the classifier
## past recognition.
##
## Marker shape is the endless-def body `= operation` — parses as
## NODE_BLOCK[NODE_RETURN[NODE_IDENT("operation")]]. The identifier is
## never resolved (effect op bodies aren't typechecked/lowered — the
## runtime invokes default handlers emitted by codegen_runtime, not the
## declared body), so "operation" remains a classifier-only sentinel.
##
## Collision risk: zero inside effect blocks (trait/effect bodies are
## reserved for op decls). A user function named `operation` at top
## level is unaffected — this helper only runs on effect op bodies.
def tc_body_is_operation_marker(ast_storage: ast::AstStorage, body: AstNodeId): Bool
  if body <= 0
    return false
  end
  if ast::ast_get_kind(ast_storage, body) != node_constants::NODE_BLOCK
    return false
  end
  var stmts = ast::ast_get_children(ast_storage, body)
  if stmts == 0
    return false
  end
  if stmts.size != 1
    return false
  end
  var ret_node = stmts[0]
  if ast::ast_get_kind(ast_storage, ret_node) != node_constants::NODE_RETURN
    return false
  end
  var ret_expr = ast::ast_get_left(ast_storage, ret_node)
  if ret_expr <= 0
    return false
  end
  if ast::ast_get_kind(ast_storage, ret_expr) != node_constants::NODE_IDENT
    return false
  end
  if ast::ast_get_str1(ast_storage, ret_expr) != "operation"
    return false
  end
  return true
end

## Depth-bounded at 128 to avoid stack-blow on pathological shapes;
## real op bodies are tens of nodes deep, not hundreds.
def tc_body_has_resume_call(ast_storage: ast::AstStorage, node: AstNodeId, depth: Int): Bool
  if node <= 0
    return false
  end
  if depth > 128
    return false
  end
  var kind = ast::ast_get_kind(ast_storage, node)
  if kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(ast_storage, node)
    if callee > 0
      var callee_kind = ast::ast_get_kind(ast_storage, callee)
      if callee_kind == node_constants::NODE_IDENT
        if ast::ast_get_str1(ast_storage, callee) == "resume"
          return true
        end
      end
    end
  end
  var left = ast::ast_get_left(ast_storage, node)
  if left > 0
    if tc_body_has_resume_call(ast_storage, left, depth + 1)
      return true
    end
  end
  var right = ast::ast_get_right(ast_storage, node)
  if right > 0
    if tc_body_has_resume_call(ast_storage, right, depth + 1)
      return true
    end
  end
  var children = ast::ast_get_children(ast_storage, node)
  if children != 0
    var cn = children.size
    for ci in 0..cn
      if tc_body_has_resume_call(ast_storage, children[ci], depth + 1)
        return true
      end
    end
  end
  return false
end

## Register a single NODE_EFFECT_DECL into the typecheck registry.
##
## Operation Piezoelectric Effects, Milestone B (extracted D.7) — the
## body used to live inline in Phase 1.4 of `tc_program`; it was lifted
## so the same logic can run earlier from `quartz.qz` Phase 4.0d for
## imported effect decls (like `std/log`'s `Log`), before the main
## compilation unit's typecheck phases reach them.
##
## Duplicate names fire QZ0612. Op kind classification:
##   kind 0 — zero-param op, body absent or does not call `resume` (C.7).
##   kind 1 — has params, body absent or does not call `resume` (C.7).
##   kind 2 — body (retained by parser) calls `resume`; F.2 classifier.
##            Codegen-level continuation threading is F.3 scope.
def tc_register_effect_decl_node(tc: TypecheckState, ast_storage: ast::AstStorage, eff_node: AstNodeId): Void
  var eff_name = ast::ast_get_str1(ast_storage, eff_node)
  var existing = typecheck_registry::tc_lookup_effect_decl(tc, eff_name)
  if existing >= 0
    var dup_line = ast::ast_get_line(ast_storage, eff_node)
    var dup_col = ast::ast_get_col(ast_storage, eff_node)
    with Diag {
      error: typecheck_diag::tc_diag_error_handler,
      warn: typecheck_diag::tc_diag_warn_handler
    } do ->
      error("QZ0612: Duplicate effect declaration: '#{eff_name}'", dup_line, dup_col)
    end
    return
  end
  var ops = ast::ast_get_children(ast_storage, eff_node)
  var op_names = vec_new<String>()
  var op_kinds = vec_new()
  var op_param_types = vec_new()
  var op_return_types = vec_new()
  if ops != 0
    var op_count = ops.size
    for oi in 0..op_count
      var op_node = ops[oi]
      var op_name = ast::ast_get_str1(ast_storage, op_node)
      var op_ret_ann = ast::ast_get_str2(ast_storage, op_node)
      var op_ret_type = type_constants::TYPE_VOID
      if str_byte_len(op_ret_ann) > 0
        op_ret_type = typecheck::tc_parse_type(tc, op_ret_ann)
      end
      var params = ast::ast_get_left(ast_storage, op_node)
      var ptypes = vec_new()
      if params != 0
        var pcount = params.size
        for pi in 0..pcount
          var pn = params[pi]
          var pann = ast::ast_get_str2(ast_storage, pn)
          if str_byte_len(pann) > 0
            ptypes.push(typecheck::tc_parse_type(tc, pann))
          else
            ptypes.push(type_constants::TYPE_INT)
          end
        end
      end
      var op_kind = 1
      if ptypes.size == 0
        op_kind = 0
      end
      var body_node = ast::ast_get_right(ast_storage, op_node)
      if body_node > 0
        if tc_body_is_operation_marker(ast_storage, body_node)
          # P3.A: explicit `= operation` marker forces kind=3 (CPS).
          # Used by abstract ops (Async.await/spawn/suspend/yield) that
          # need operation-kind dispatch without a body that `tc_body_has_
          # resume_call` can detect. Marker takes precedence — it's the
          # user's explicit annotation per memo §2.4.
          op_kind = 3
        elsif tc_body_has_resume_call(ast_storage, body_node, 0)
          # P3.0b: split kind=2 (tail resume — unwind/abort) from kind=3
          # (non-tail resume — continuation-preserving). Endless-def
          # `= resume(x)` produces NODE_BLOCK[NODE_RETURN[NODE_CALL(resume)]]
          # — strictly this shape → kind=2. Anything else with resume → kind=3.
          # Existing Throws.throw / ParseError.parse_error stay kind=2 by
          # construction (their `= resume(0)` bodies match the pattern).
          if tc_body_is_endless_def_tail_resume(ast_storage, body_node)
            op_kind = 2
          else
            op_kind = 3
          end
        end
      end
      op_names.push(op_name)
      op_kinds.push(op_kind)
      op_param_types.push(ptypes)
      op_return_types.push(op_ret_type)
    end
  end
  typecheck_registry::tc_register_effect_decl(tc, eff_name, op_names, op_kinds, op_param_types, op_return_types)
end

## Returns: true if no type errors, false otherwise
def tc_program(tc: TypecheckState, ast_storage: ast::AstStorage, program: AstNodeId): Bool can Diag
  # Get program items (functions, structs, enums, global lets)
  var items = ast::ast_get_children(ast_storage, program)

  # Phase 0: Check for duplicate struct/enum definitions in the AST
  # This runs before registration to catch true duplicates (same name, different AST nodes)
  # without false-positiving on the Phase 4.0a + tc_program double-registration.
  var item_count_p0 = items.size
  for i_p0 in 0..item_count_p0
    var item_p0 = items[i_p0]
    var kind_p0 = ast::ast_get_kind(ast_storage, item_p0)
    var is_type_def_p0 = 0
    if kind_p0 == node_constants::NODE_STRUCT_DEF
      is_type_def_p0 = 1
    end
    if kind_p0 == node_constants::NODE_ENUM_DEF
      is_type_def_p0 = 1
    end
    if is_type_def_p0 == 1
      var name_p0 = ast::ast_get_str1(ast_storage, item_p0)
      # Only check local (non-imported) definitions
      if not str_contains(name_p0, "$")
        for j_p0 in 0..i_p0
          var other_p0 = items[j_p0]
          var other_kind_p0 = ast::ast_get_kind(ast_storage, other_p0)
          if other_kind_p0 == kind_p0
            var other_name_p0 = ast::ast_get_str1(ast_storage, other_p0)
            if other_name_p0 == name_p0
              var dup_line = ast::ast_get_line(ast_storage, item_p0)
              var dup_col = ast::ast_get_col(ast_storage, item_p0)
              var type_kind_str = "struct"
              if kind_p0 == node_constants::NODE_ENUM_DEF
                type_kind_str = "enum"
              end
              error("Duplicate #{type_kind_str} definition: '#{name_p0}'", dup_line, dup_col)
            end
          end
        end
      end
    end
  end

  # Phase 1: Register struct, enum, and type alias definitions
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_STRUCT_DEF
      typecheck::tc_register_struct_def(tc, ast_storage, item)
    elsif kind == node_constants::NODE_ENUM_DEF
      typecheck::tc_register_enum_def(tc, ast_storage, item)
    elsif kind == node_constants::NODE_TYPE_ALIAS
      typecheck::tc_register_type_alias_def(tc, ast_storage, item)
    elsif kind == node_constants::NODE_NEWTYPE_DEF
      typecheck::tc_register_newtype_def(tc, ast_storage, item)
    end
  })
  
  # Phase 1.1: Validate type aliases (after all aliases registered)
  var item_count = items.size
  for vi in 0..item_count
    var vitem = items[vi]
    var vkind = ast::ast_get_kind(ast_storage, vitem)
    if vkind == node_constants::NODE_TYPE_ALIAS
      typecheck::tc_validate_type_alias(tc, ast_storage, vitem)
    end
  end

  # Phase 1.15: Validate binary {} blocks and packed struct(uN) definitions.
  # Enforces BINARY_DSL.md rules: QZ0950 (total bits multiple of 8),
  # QZ0951 (packed struct width match), QZ0952 (multi-byte alignment).
  for bi in 0..item_count
    var bitem = items[bi]
    var bkind = ast::ast_get_kind(ast_storage, bitem)
    if bkind == node_constants::NODE_BINARY_BLOCK
      typecheck::tc_validate_binary_block(ast_storage, bitem)
    elsif bkind == node_constants::NODE_PACKED_STRUCT
      typecheck::tc_validate_packed_struct(ast_storage, bitem)
    end
  end

  # Phase 1.4: Register effect declarations (Operation Piezoelectric
  # Effects, Milestone B). For each NODE_EFFECT_DECL in root's items,
  # delegate to `tc_register_effect_decl_node`. Duplicate effect names
  # emit QZ0612 — same-name effect in one compilation unit is rejected
  # because the registry is keyed by name. Cross-module effect decls
  # (D.7) register earlier via quartz.qz Phase 4.0d, so by the time
  # we reach here the imported-module decls are already present and
  # this pass handles only locally-declared effects. Local effects
  # that clash with an imported one still surface QZ0612 via the
  # helper's existing check.
  var item_count_p14 = items.size
  for i_p14 in 0..item_count_p14
    var item_p14 = items[i_p14]
    var kind_p14 = ast::ast_get_kind(ast_storage, item_p14)
    if kind_p14 == node_constants::NODE_EFFECT_DECL
      tc_register_effect_decl_node(tc, ast_storage, item_p14)
    end
  end

  # Phase 1.5: Register trait definitions (before impls, after types)
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_TRAIT_DEF
      typecheck::tc_register_trait_def(tc, ast_storage, item)
    end
  })

  # Phase 1.55: Register built-in marker traits (Send, Sync)
  var marker_empty_names = vec_new<String>()
  var marker_empty_sigs = vec_new()
  var marker_empty_defaults = vec_new()
  typecheck_registry::tc_register_trait(tc, "Send", marker_empty_names, marker_empty_sigs, marker_empty_defaults, "", "")
  typecheck_registry::tc_register_trait(tc, "Sync", marker_empty_names, marker_empty_sigs, marker_empty_defaults, "", "")

  # Phase 1.6: Register impl blocks (after traits, before functions)
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_IMPL_BLOCK
      typecheck::tc_register_impl_block(tc, ast_storage, item)
    end
  })
  
  # Phase 1.65: Coherence — detect duplicate impl blocks (same trait + same type)
  var impl_count_165 = items.size
  for i_165 in 0..impl_count_165
    var kind_165 = ast::ast_get_kind(ast_storage, items[i_165])
    if kind_165 == node_constants::NODE_IMPL_BLOCK
      var trait_165 = ast::ast_get_str1(ast_storage, items[i_165])
      var type_165 = ast::ast_get_str2(ast_storage, items[i_165])
      if str_byte_len(trait_165) > 0
        for j_165 in 0..i_165
          if ast::ast_get_kind(ast_storage, items[j_165]) == node_constants::NODE_IMPL_BLOCK
            var other_trait = ast::ast_get_str1(ast_storage, items[j_165])
            var other_type = ast::ast_get_str2(ast_storage, items[j_165])
            if trait_165 == other_trait and type_165 == other_type
              # Only error if these are different AST nodes (not same node seen twice)
              if items[i_165] != items[j_165]
                var dup_line = ast::ast_get_line(ast_storage, items[i_165])
                var dup_col = ast::ast_get_col(ast_storage, items[i_165])
                error("Conflicting impl: trait '#{trait_165}' already implemented for '#{type_165}'", dup_line, dup_col)
              end
            end
          end
        end
      end
    end
  end

  # Phase 1.7: Verify impl completeness
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_IMPL_BLOCK
      typecheck::tc_verify_impl_completeness(tc, ast_storage, item)
    end
  })
  
  # Phase 1.9: Check for duplicate function definitions (same name + same arity)
  tc_check_duplicate_functions(tc, ast_storage, items)

  # Phase 2: Register function signatures and protocol definitions
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_FUNCTION
      typecheck::tc_register_function_signature(tc, ast_storage, item)
    end
    if kind == node_constants::NODE_EXTERN_FN
      typecheck::tc_register_extern_fn_signature(tc, ast_storage, item)
    end
    if kind == node_constants::NODE_PROTOCOL_DEF
      # Register protocol: extract steps from children
      var proto_name = ast::ast_get_str1(ast_storage, item)
      var proto_type_params = ast::ast_get_str2(ast_storage, item)
      var step_nodes = ast::ast_get_children(ast_storage, item)
      var step_kinds = vec_new()
      var step_types = vec_new()
      var step_type_anns = vec_new<String>()
      var has_dfa_nodes = 0
      if step_nodes != 0
        for si in 0..step_nodes.size
          var step_node = step_nodes[si]
          var step_kind = ast::ast_get_kind(ast_storage, step_node)
          if step_kind == node_constants::NODE_PROTOCOL_CHOICE or step_kind == node_constants::NODE_PROTOCOL_LOOP
            has_dfa_nodes = 1
          end
          if step_kind == node_constants::NODE_PROTOCOL_STEP
            var sk = ast::ast_get_int_val(ast_storage, step_node)
            var st = ast::ast_get_str1(ast_storage, step_node)
            step_kinds.push(sk)
            step_types.push(typecheck::tc_parse_type(tc, st))
            step_type_anns.push(st)
          end
        end
      end
      # Register protocol — tc_register_protocol builds linear DFA automatically.
      # Choice/loop nodes in the AST are silently ignored for step_kinds/step_types
      # (which only contain NODE_PROTOCOL_STEP entries), but the DFA is built
      # from ALL nodes including choice/loop.
      if has_dfa_nodes == 0
        typecheck_registry::tc_register_protocol(tc, proto_name, proto_type_params, step_kinds, step_types)
        # Store raw annotations for generic protocols (for type substitution at check time)
        if str_byte_len(proto_type_params) > 0
          var pidx = tc.protocol_names.size - 1
          tc.protocol_step_type_annotations[pidx] = step_type_anns
        end
      else
        # Build DFA from scratch for choice/loop protocols
        var dfa_trans = vec_new()
        var cur_st = 0
        if step_nodes != 0
          var si2 = 0
          while si2 < step_nodes.size
            var sn = step_nodes[si2]
            var nk = ast::ast_get_kind(ast_storage, sn)
            if nk == node_constants::NODE_PROTOCOL_STEP
              # Sequential step in a mixed protocol (alongside choice/loop)
              var mix_k = ast::ast_get_int_val(ast_storage, sn)
              var mix_t = ast::ast_get_str1(ast_storage, sn)
              var mix_tid = typecheck::tc_parse_type(tc, mix_t)
              dfa_trans.push(cur_st)
              dfa_trans.push(mix_k)
              dfa_trans.push(mix_tid)
              dfa_trans.push(cur_st + 1)
              cur_st += 1
            elsif nk == node_constants::NODE_PROTOCOL_CHOICE
              var ch_branches = ast::ast_get_children(ast_storage, sn)
              var ch_nbranches = ast::ast_get_int_val(ast_storage, sn)
              # Validate determinism: each branch must start with a distinct operation kind
              var ch_seen_kinds = vec_new()
              for ch_vi in 0..ch_nbranches
                var ch_vsteps = ch_branches[ch_vi]
                if vec_size(ch_vsteps) > 0
                  var ch_vn = vec_get(ch_vsteps, 0)
                  var ch_vk = ast::ast_get_int_val(ast_storage, ch_vn)
                  for ch_si in 0..ch_seen_kinds.size
                    if ch_seen_kinds[ch_si] == ch_vk
                      var kind_label = "send"
                      if ch_vk == 2
                        kind_label = "recv"
                      end
                      error("QZ1404: Ambiguous choice in protocol '#{proto_name}' — multiple branches start with '#{kind_label}'. Each branch must begin with a distinct operation for deterministic dispatch.", 0, 0)
                    end
                  end
                  ch_seen_kinds.push(ch_vk)
                end
              end
              var ch_start = cur_st
              var ch_branch_ends = vec_new()
              var ch_next = cur_st + 1
              for ch_bi in 0..ch_nbranches
                var ch_bsteps = ch_branches[ch_bi]
                var ch_bsz = vec_size(ch_bsteps)
                var ch_br_st = ch_next
                if ch_bsz > 0
                  # First step: transition from choice start
                  var ch_fn = vec_get(ch_bsteps, 0)
                  var ch_fk = ast::ast_get_int_val(ast_storage, ch_fn)
                  var ch_ft = ast::ast_get_str1(ast_storage, ch_fn)
                  var ch_ftid = typecheck::tc_parse_type(tc, ch_ft)
                  dfa_trans.push(ch_start)
                  dfa_trans.push(ch_fk)
                  dfa_trans.push(ch_ftid)
                  dfa_trans.push(ch_br_st)
                  # Remaining steps in this branch
                  for ch_bsi in 1..ch_bsz
                    var ch_bn = vec_get(ch_bsteps, ch_bsi)
                    var ch_bk = ast::ast_get_int_val(ast_storage, ch_bn)
                    var ch_bt = ast::ast_get_str1(ast_storage, ch_bn)
                    var ch_btid = typecheck::tc_parse_type(tc, ch_bt)
                    dfa_trans.push(ch_br_st)
                    dfa_trans.push(ch_bk)
                    dfa_trans.push(ch_btid)
                    dfa_trans.push(ch_br_st + 1)
                    ch_br_st += 1
                  end
                  ch_branch_ends.push(ch_br_st)
                  ch_next = ch_br_st + 1
                end
              end
              # Join: rewrite branch end targets to point to join state
              var ch_join = ch_next
              for ch_t in 0..vec_size(dfa_trans) / 4
                var ch_tidx = ch_t * 4 + 3
                var ch_tgt = vec_get(dfa_trans, ch_tidx)
                for ch_bei in 0..vec_size(ch_branch_ends)
                  if ch_tgt == vec_get(ch_branch_ends, ch_bei)
                    vec_set(dfa_trans, ch_tidx, ch_join)
                  end
                end
              end
              cur_st = ch_join
            elsif nk == node_constants::NODE_PROTOCOL_LOOP
              # Loop DFA: body transitions cycle back to loop_start.
              # loop_start is BOTH a continuation point and a valid exit point.
              # After building the loop, cur_st resets to lp_start so that the
              # accept state (or subsequent steps) connect to the loop entry.
              var lp_steps = ast::ast_get_children(ast_storage, sn)
              var lp_start = cur_st
              var lp_sz = vec_size(lp_steps)
              if lp_sz > 0
                for lp_i in 0..lp_sz
                  var lp_n = vec_get(lp_steps, lp_i)
                  var lp_k = ast::ast_get_int_val(ast_storage, lp_n)
                  var lp_t = ast::ast_get_str1(ast_storage, lp_n)
                  var lp_tid = typecheck::tc_parse_type(tc, lp_t)
                  var lp_next = cur_st + 1
                  if lp_i == lp_sz - 1
                    # Last step loops back to start
                    lp_next = lp_start
                  end
                  dfa_trans.push(cur_st)
                  dfa_trans.push(lp_k)
                  dfa_trans.push(lp_tid)
                  dfa_trans.push(lp_next)
                  if lp_i < lp_sz - 1
                    cur_st += 1
                  end
                end
              end
              # Reset cur_st to loop start — the loop entry is the exit point
              cur_st = lp_start
            end
            si2 += 1
          end
        end
        # Validate DFA determinism: no state should have two transitions with same kind
        var dfa_sz = vec_size(dfa_trans)
        var dt_i = 0
        while dt_i < dfa_sz
          var dt_state = vec_get(dfa_trans, dt_i)
          var dt_kind = vec_get(dfa_trans, dt_i + 1)
          var dt_j = dt_i + 4
          while dt_j < dfa_sz
            if vec_get(dfa_trans, dt_j) == dt_state and vec_get(dfa_trans, dt_j + 1) == dt_kind
              var kind_label = "send"
              if dt_kind == 2
                kind_label = "recv"
              end
              error("QZ1404: Ambiguous protocol '#{proto_name}' — state #{to_str(dt_state)} has multiple '#{kind_label}' transitions. Each state must have at most one transition per operation kind.", 0, 0)
            end
            dt_j += 4
          end
          dt_i += 4
        end
        # Register protocol with pre-built DFA
        typecheck_registry::tc_register_protocol_dfa(tc, proto_name, proto_type_params, step_kinds, step_types, cur_st + 1, dfa_trans, cur_st)
      end
    end
  })
  
  # Phase 3: Type check global let bindings and global vars
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_LET
      tc_stmt(tc, ast_storage, item)
    elsif kind == node_constants::NODE_GLOBAL_VAR
      tc_stmt(tc, ast_storage, item)
    elsif kind == node_constants::NODE_CONST_DECL
      tc_stmt(tc, ast_storage, item)
    elsif kind == node_constants::NODE_STATIC_ASSERT
      tc_stmt(tc, ast_storage, item)
    end
  })
  
  # Note: Function body type checking is now handled by compile() in be.be
  # which iterates over all_funcs (including imported modules) and calls
  # tc_function for each. This avoids duplicate type checking.
  
  # Phase 4: Type check function bodies
  each(items, item: Int -> {
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_FUNCTION
      tc_function(tc, ast_storage, item)
    end
  })
  
  return typecheck_util::tc_has_errors(tc) == false
end

## Check for duplicate function definitions in a program's top-level items.
## Two functions with the same name and same parameter count are duplicates.
## Only checks user-defined functions (node_constants$NODE_FUNCTION), not builtins.
def tc_check_duplicate_functions(tc: TypecheckState, ast_storage: ast::AstStorage, items: Int): Void
  var func_items = vec_new()
  var item_count = vec_size(items)
  for i in 0..item_count
    var item = items[i]
    if ast::ast_get_kind(ast_storage, item) == node_constants::NODE_FUNCTION
      func_items.push(item)
    end
  end
  var fcount = func_items.size
  for i in 0..fcount
    var fi = func_items[i]
    var fname = ast::ast_get_str1(ast_storage, fi)
    var fparams = ast::ast_get_left(ast_storage, fi)
    var fpc = vec_size(fparams)
    for j in 0..i
      var fj = func_items[j]
      var gname = ast::ast_get_str1(ast_storage, fj)
      if fname == gname
        var gparams = ast::ast_get_left(ast_storage, fj)
        var gpc = vec_size(gparams)
        if fpc == gpc
          var dup_line = ast::ast_get_line(ast_storage, fi)
          var dup_col = ast::ast_get_col(ast_storage, fi)
          var msg = "duplicate function definition: '#{fname}' with #{fpc} parameter(s) already defined"
          with Diag {
            error: typecheck_diag::tc_diag_error_handler,
            warn: typecheck_diag::tc_diag_warn_handler
          } do ->
            error(msg, dup_line, dup_col)
          end
        end
      end
    end
  end
end

## Handler-claim detection helper for NODE_WITH typecheck.
##
## When `with H do -> body end` is typechecked, we inspect H's syntactic
## shape to see whether it's "claiming" an effect by name. Current
## convention (Piezo C.2, pre-evidence-vtable): a bare PascalCase
## NODE_IDENT whose name matches a registered effect declaration is a
## claim — the effect is pushed onto the handler-effect stack while the
## body is typechecked, so callees whose rows include that effect no
## longer require the enclosing function to declare it in `can`.
##
## Return codes:
##   0 — no claim detected; caller should tc_expr the handler normally.
##       No pop needed.
##   1 — valid claim pushed onto stack; caller should SKIP tc_expr of
##       the handler (since bare `Throws` is not a value binding).
##       Paired pop required via tc_with_handler_end(tc, 1).
##   2 — QZ0613 fired: handler looks like an effect claim but no decl
##       named it is registered. Caller should SKIP tc_expr to avoid
##       cascading "undefined identifier" noise. No pop needed.
##
## Operation Piezoelectric Effects, C.2.
def tc_with_handler_begin(tc: TypecheckState, ast_storage: ast::AstStorage, handler_node: Int, line: Int, col: Int): Int
  return 0 if handler_node < 0
  var kind = ast::ast_get_kind(ast_storage, handler_node)
  # D.5 extends the recognized handler shapes: NODE_IDENT (bare effect
  # claim, null handler installs default) and NODE_STRUCT_INIT (record-
  # literal handler like `Throws { throw: my_handler }`, which carries
  # the user's handler fn references in its field values). Both shapes
  # pull the claimed effect name from str1.
  # Phase 2 P2.a: NODE_CALL shape `with State(42) do ... end` — callee is
  # the effect name (NODE_IDENT), arg[0] is the initial-state expression.
  # Typecheck the init expression but skip the synthetic call resolution
  # (the effect name is not a normal function or struct).
  if kind != node_constants::NODE_IDENT and kind != node_constants::NODE_STRUCT_INIT and kind != node_constants::NODE_CALL
    return 0
  end
  var name = ""
  if kind == node_constants::NODE_CALL
    var call_callee = ast::ast_get_left(ast_storage, handler_node)
    if call_callee < 0 or ast::ast_get_kind(ast_storage, call_callee) != node_constants::NODE_IDENT
      return 0
    end
    name = ast::ast_get_str1(ast_storage, call_callee)
  else
    name = ast::ast_get_str1(ast_storage, handler_node)
  end
  return 0 if str_byte_len(name) == 0
  var first_ch = name.byte_at(0)
  # Only PascalCase names are interpreted as effect claims; anything
  # lowercase falls through to ordinary typecheck as a scope lookup.
  if first_ch < 65 or first_ch > 90
    return 0
  end
  # B.0c — `with EffectName.method(args) do ... end` parses as a NODE_CALL
  # whose callee is a single IDENT named `EffectName$method` (parser
  # squashes field access on PascalCase idents into one qualified name).
  # Recognize this shape: split on `$`, look up the prefix as an effect
  # claim, keep the suffix for mir_lower's method-dispatch routing.
  var lookup_name = name
  var dollar_idx = -1
  var _scan_i = 0
  while _scan_i < str_byte_len(name)
    if name.byte_at(_scan_i) == 36
      dollar_idx = _scan_i
      _scan_i = str_byte_len(name)
    else
      _scan_i = _scan_i + 1
    end
  end
  if dollar_idx > 0
    lookup_name = str_byte_slice(name, 0, dollar_idx)
  end
  # B.2 — `with TestAlloc do ... end` is a bare-IDENT alias for an Alloc
  # install backed by a singleton test arena (see mir_lower's bare-IDENT
  # branch). Treat it as an Alloc claim at typecheck so body code with
  # `can Alloc` rows is satisfied without a separate effect decl. Only
  # rewrite when this is a bare IDENT (no `$`-method); a hypothetical
  # `TestAlloc.method` form should fail QZ0613 cleanly.
  if dollar_idx < 0 and lookup_name.eq("TestAlloc")
    lookup_name = "Alloc"
  end
  var eff_idx = typecheck_registry::tc_lookup_effect_decl(tc, lookup_name)
  if eff_idx >= 0
    var effect_id = string_intern::intern_id(tc.interner, lookup_name)
    typecheck_util::tc_handler_effect_push(effect_id)
    # D.5: for struct-init handlers, also typecheck each field value as a
    # normal expression so unresolved handler function names surface as
    # errors (QZ0xxx) before mir_lower sees them. The handler record
    # doesn't bind to the body's scope — it's consumed at install time.
    if kind == node_constants::NODE_STRUCT_INIT
      var handler_fields = ast::ast_get_children(ast_storage, handler_node)
      var hi = 0
      while hi < handler_fields.size
        var fv = handler_fields[hi]
        if fv >= 0
          tc_expr(tc, ast_storage, fv)
        end
        hi = hi + 1
      end
    end
    # Phase 2 P2.a: for `with State(42) do ... end`, typecheck the init
    # argument so unresolved identifiers / type errors in the initial-state
    # expression surface before MIR-lower. We deliberately do NOT recurse
    # into the callee ident (it's the effect name, not a value binding).
    if kind == node_constants::NODE_CALL
      var call_args = ast::ast_get_children(ast_storage, handler_node)
      if call_args != 0
        var ci = 0
        while ci < call_args.size
          var cv = call_args[ci]
          if cv >= 0
            tc_expr(tc, ast_storage, cv)
          end
          ci = ci + 1
        end
      end
    end
    return 1
  end
  # PascalCase but no effect decl — if it DOES resolve to a scope
  # binding (some user-defined type-ish value, e.g. a struct name that
  # somehow reached expression position), let tc_expr handle it.
  var sb_type = typecheck_util::tc_scope_lookup(tc, name)
  if sb_type != type_constants::TYPE_ERROR
    return 0
  end
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
    error("QZ0613: handler expression '#{name}' looks like an effect claim, but no effect decl named '#{lookup_name}' is registered", line, col)
  end
  return 2
end

## Paired end-hook for tc_with_handler_begin. Pops the stack only when
## begin returned 1 (a valid claim was actually pushed).
def tc_with_handler_end(tc: TypecheckState, ret: Int): Void
  if ret == 1
    typecheck_util::tc_handler_effect_pop()
  end
end

## B.8 Phase 3 — Scoped resource dispatch.
##
## Called from the NODE_WITH dispatcher AFTER `tc_with_handler_begin`
## returns 0 (handler is not an effect claim) AND after the handler has
## been typechecked as a value expression. Looks up `impl Scoped for T`
## where T is the handler's struct type; on hit, binds the user-supplied
## bound-param to `acquire`'s return type in the current scope.
##
## Caller MUST have already done `tc_enter_scope()` so the binding scope
## is properly bracketed. Caller does the matching `tc_exit_scope()` once
## the body has been typechecked.
##
## Parameters:
##   handler_type — type id returned by tc_expr on the handler expression
##   bound_param  — NODE_PARAM AST handle (from ast_with_bound_param)
##
## Return codes:
##   0 — handler is not a Scoped impl, or no struct name could be resolved.
##       QZ0614 emitted; caller's scope pushed/popped is harmless (binding
##       wasn't installed).
##   1 — Scoped impl found and bound param installed in scope.
##
## Phase 3 minimum: assumes acquire returns a single value bound to the
## param; does NOT yet handle Scoped<R> generic substitution (open
## question #1 in the design memo). Until Phase 5+ generalizes, all
## Scoped impls return Int per existential-types policy — guard structs
## that wrap concrete types are erased to Int at the IR level.
##
## Phase 4: on a successful Scoped resolution, stamp the resolved struct
## name onto the with_node so MIR-lower can dispatch to the Scoped
## acquire/release sequence without redoing the impl lookup. Reads
## back via `ast_with_scoped_struct(s, with_node)`.
def tc_with_scoped_bind(tc: TypecheckState, ast_storage: ast::AstStorage, with_node: Int, handler_node: Int, handler_type: Int, bound_param: Int, line: Int, col: Int): Int
  # If the handler already typechecked as TYPE_ERROR (undefined name,
  # earlier QZ0xxx), suppress the cascading QZ0614 to keep diagnostics
  # tidy — the upstream error already told the user what's wrong.
  if handler_type == type_constants::TYPE_ERROR
    return 0
  end
  # Resolve handler's struct name. Quartz stores struct names in three
  # places depending on the handler shape: parametric struct ptypes
  # (`Mutex<Int>`) carry the name on the ptype; bare TYPE_STRUCT
  # collapses the name into the AST and re-discovery requires walking
  # the handler node itself. Try ptype first (most precise), then fall
  # back on AST-level lookup for non-parametric structs.
  var struct_name = ""
  if typecheck::tc_is_ptype(handler_type)
    var base = typecheck::tc_base_kind(tc, handler_type)
    if base == type_constants::TYPE_STRUCT
      struct_name = typecheck::tc_ptype_name(tc, handler_type)
    end
  end
  if str_byte_len(struct_name) == 0 and typecheck::tc_is_struct_type(handler_type)
    var hn_kind = ast::ast_get_kind(ast_storage, handler_node)
    if hn_kind == node_constants::NODE_IDENT
      var hn_name = ast::ast_get_str1(ast_storage, handler_node)
      struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, hn_name)
    elsif hn_kind == node_constants::NODE_STRUCT_INIT
      struct_name = ast::ast_get_str1(ast_storage, handler_node)
    elsif hn_kind == node_constants::NODE_FIELD_ACCESS
      # B.8 Phase 4a — paren-elided method call (`m.lock` auto-calls
      # `Mutex$lock(m)`). Resolve the receiver's struct type so we can
      # look up the mangled method's return annotation. The annotation
      # string is the bound value's struct name (e.g. "MutexGuard"),
      # which is what we want for the impl Scoped lookup.
      var fa_recv = ast::ast_get_left(ast_storage, handler_node)
      var fa_method = ast::ast_get_str1(ast_storage, handler_node)
      if fa_recv >= 0 and str_byte_len(fa_method) > 0
        var fa_recv_kind = ast::ast_get_kind(ast_storage, fa_recv)
        var fa_recv_struct = ""
        if fa_recv_kind == node_constants::NODE_IDENT
          fa_recv_struct = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, fa_recv))
        elsif fa_recv_kind == node_constants::NODE_STRUCT_INIT
          fa_recv_struct = ast::ast_get_str1(ast_storage, fa_recv)
        end
        if str_byte_len(fa_recv_struct) > 0
          var fa_mangled = string_intern::mangle(fa_recv_struct, fa_method)
          struct_name = typecheck_registry::tc_lookup_function_return_annotation(tc, fa_mangled)
        end
      end
    elsif hn_kind == node_constants::NODE_CALL
      # B.8 Phase 4a — explicit method call returning a Scoped guard.
      # callee is either NODE_IDENT (free function `mutex_guard(h)`) or
      # NODE_FIELD_ACCESS (`m.lock()`). Look up the resolved function's
      # return annotation string, same shape as the FIELD_ACCESS branch.
      var call_callee = ast::ast_get_left(ast_storage, handler_node)
      if call_callee >= 0
        var call_callee_kind = ast::ast_get_kind(ast_storage, call_callee)
        var call_fn_name = ""
        if call_callee_kind == node_constants::NODE_IDENT
          call_fn_name = ast::ast_get_str1(ast_storage, call_callee)
        elsif call_callee_kind == node_constants::NODE_FIELD_ACCESS
          var cm_recv = ast::ast_get_left(ast_storage, call_callee)
          var cm_method = ast::ast_get_str1(ast_storage, call_callee)
          if cm_recv >= 0 and str_byte_len(cm_method) > 0
            var cm_recv_kind = ast::ast_get_kind(ast_storage, cm_recv)
            var cm_recv_struct = ""
            if cm_recv_kind == node_constants::NODE_IDENT
              cm_recv_struct = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, cm_recv))
            elsif cm_recv_kind == node_constants::NODE_STRUCT_INIT
              cm_recv_struct = ast::ast_get_str1(ast_storage, cm_recv)
            end
            if str_byte_len(cm_recv_struct) > 0
              call_fn_name = string_intern::mangle(cm_recv_struct, cm_method)
            end
          end
        end
        if str_byte_len(call_fn_name) > 0
          struct_name = typecheck_registry::tc_lookup_function_return_annotation(tc, call_fn_name)
        end
      end
    end
  end
  if str_byte_len(struct_name) == 0
    with Diag {
      error: typecheck_diag::tc_diag_error_handler,
      warn: typecheck_diag::tc_diag_warn_handler
    } do ->
      error("QZ0614: handler in `with X do x -> ... end` must be a value of a struct type that implements `Scoped`; got non-struct value", line, col)
    end
    return 0
  end
  var impl_idx = typecheck_registry::tc_lookup_impl(tc, "Scoped", struct_name)
  if impl_idx < 0
    with Diag {
      error: typecheck_diag::tc_diag_error_handler,
      warn: typecheck_diag::tc_diag_warn_handler
    } do ->
      error("QZ0614: `#{struct_name}` does not implement `Scoped`; cannot bind a parameter in `with #{struct_name} do x -> ... end`", line, col)
    end
    return 0
  end
  # Look up the impl's `acquire` method. Methods are mangled as
  # `<struct>$<method>`. tc_lookup_function_return walks the registry
  # in last-wins order and returns the registered return type, falling
  # back to suffix-match for module-prefixed registrations.
  var acquire_fn = string_intern::mangle(struct_name, "acquire")
  var acquire_ret_type = typecheck_registry::tc_lookup_function_return(tc, acquire_fn)
  if acquire_ret_type == type_constants::TYPE_ERROR
    with Diag {
      error: typecheck_diag::tc_diag_error_handler,
      warn: typecheck_diag::tc_diag_warn_handler
    } do ->
      error("QZ0614: `impl Scoped for #{struct_name}` is missing the required `acquire(self): R` method", line, col)
    end
    return 0
  end
  # Derive the bound value's struct name (if any) so method dispatch on
  # the bound parameter works inside the body. acquire's return type may
  # be a primitive (Int, String) or a struct ptype — the latter carries
  # its struct name on the ptype.
  var bound_struct_name = ""
  if typecheck::tc_is_ptype(acquire_ret_type)
    var rbase = typecheck::tc_base_kind(tc, acquire_ret_type)
    if rbase == type_constants::TYPE_STRUCT
      bound_struct_name = typecheck::tc_ptype_name(tc, acquire_ret_type)
    end
  end
  # Bind the user-supplied parameter into the current scope. Caller
  # already pushed a fresh scope so this binding is body-local.
  #
  # Phase 6.5: bound param is implicitly `var`. Reassignments inside the
  # body propagate to release(self, v) — the MIR lowering takes the
  # alloca's address and the natural-exit / throw / wrap-drain release
  # sites all load the CURRENT slot value before calling release. This
  # makes Mutex<Int>-as-heap-pointer-slot patterns (e.g. progress.qz's
  # `_g_live_actives_mtx`) expressible as `with m.lock do v -> ... v =
  # new_v ... end`. For Scoped impls where the body never reassigns v
  # (File, Channel, Tcp, etc.), there is no observable difference.
  var pname = ast::ast_get_str1(ast_storage, bound_param)
  typecheck_util::tc_scope_bind(tc, pname, acquire_ret_type, 1, bound_struct_name)
  # Phase 4: stamp the resolved struct name onto the NODE_WITH so MIR-
  # lower can dispatch to the Scoped sequence. MIR reads via
  # ast_with_scoped_struct; legacy effect-handler with-blocks return ""
  # from that getter and stay on the existing path.
  ast::ast_with_set_scoped_struct(ast_storage, with_node, struct_name)
  return 1
end

## Phase 4D.6: Returns 0 (not in generator), 1 (sync `impl Iterator<T>`),
## or 2 (async `impl AsyncIterator<T>` OR row-poly `impl Iterator<T> can Async`).
## Reads the current function's return type annotation directly from the registry,
## replacing the legacy `tc.reserved[0]` cache. Detection logic mirrors `tc_function`
## (lines around 4040): explicit `AsyncIterator` prefix → 2; `Iterator` prefix
## → 1, but flipped to 2 if the impl-Trait annotation carries a `can Async` suffix
## (4D.3's row-poly form). Helper exists at module scope so NODE_RETURN/NODE_YIELD
## handlers can consult it without re-doing the string parsing.
def _tc_current_func_is_generator(tc: TypecheckState): Int
  var func_idx = typecheck_util::tc_get_current_func_idx(tc)
  if func_idx < 0
    return 0
  end
  var ann = typecheck_registry::tc_get_func_return_annotation(tc, func_idx)
  if str_byte_len(ann) < 5
    return 0
  end
  if str_byte_slice(ann, 0, 5) != "impl "
    return 0
  end
  var trait_name = str_byte_slice(ann, 5, str_byte_len(ann))
  # Explicit `impl AsyncIterator<T>` → async generator.
  if str_byte_len(trait_name) >= 13
    if trait_name.starts_with("AsyncIterator")
      return 2
    end
  end
  # `impl Iterator<T>` → sync generator. 4D.3 row-poly form
  # `impl Iterator<T> can Async` flips it to async generator.
  if str_byte_len(trait_name) >= 8
    if trait_name.starts_with("Iterator")
      var can_idx = typecheck::_tc_find_last_can_marker(trait_name)
      if can_idx >= 0
        var can_suffix = str_byte_slice(trait_name, can_idx + 4, str_byte_len(trait_name)).trim()
        var pipe_idx = __char_index(can_suffix, '|')
        var label_part = can_suffix
        if pipe_idx >= 0
          label_part = str_byte_slice(can_suffix, 0, pipe_idx).trim()
        end
        if label_part == "Async"
          return 2
        end
      end
      return 1
    end
  end
  return 0
end

## Phase 4 Path B (4.B.2): decide whether `yield v` is in scope at the
## current typecheck position. Two channels count as "in scope" post-4D.6
## (channel 1 — the `tc.reserved[0]` cache — was retired; the implicit
## Yield push at tc_function's body entry covers the same set of generator-
## body positions, so channel 2 subsumes it):
##
##   1. Handler-effect stack contains `Yield`: set by an explicit
##      `with Yield { yield: h } do -> ... end` (4.B.4's Stream.next
##      install), or by tc_function's implicit push when entering a
##      generator body.
##   2. Enclosing function's effect row declares `can Yield`: enables
##      modular yield helpers (`def emit_pair(a, b): Void can Yield<Int>`
##      callable from within a generator body).
def _tc_p4b_yield_in_scope(tc: TypecheckState): Bool
  var yield_id = string_intern::intern_id(tc.interner, "Yield")
  return true if typecheck_util::tc_handler_effect_contains(yield_id)
  var caller_idx = typecheck_util::tc_get_current_func_idx(tc)
  if caller_idx >= 0
    var caller_row = typecheck_registry::tc_get_func_effect_row(tc, caller_idx)
    if caller_row >= 0
      var labels = typecheck_registry::tc_row_get_labels(tc, caller_row)
      var li = 0
      while li < labels.size
        if labels[li] == yield_id
          return true
        end
        li = li + 1
      end
    end
  end
  return false
end

## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Expression node handle
##
## Returns: Type kind of the expression
def tc_expr(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Int
  # Note: node >= 0 is valid. Use < 0 to check for missing nodes (sentinel -1)
  if node < 0
    return type_constants::TYPE_ERROR
  end

  # 5.1.C body-wrap: install Diag handler for the entire body. Inner
  # error(...) calls route via the bridge to typecheck_util::tc_error
  # on the active TypecheckState (set in compile() via tc_diag_set).
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->

  var node_kind = ast::ast_get_kind(ast_storage, node)
  var line = ast::ast_get_line(ast_storage, node)
  var col = ast::ast_get_col(ast_storage, node)
  var result = type_constants::TYPE_VOID

  # Literals
  if node_kind == node_constants::NODE_INT_LIT
    result = type_constants::TYPE_INT
  elsif node_kind == node_constants::NODE_NIL_LIT
    result = type_constants::TYPE_INT
  elsif node_kind == node_constants::NODE_BOOL_LIT
    result = type_constants::TYPE_BOOL
  elsif node_kind == node_constants::NODE_STRING_LIT
    result = type_constants::TYPE_STRING
  elsif node_kind == node_constants::NODE_SYMBOL_LIT
    result = type_constants::TYPE_SYMBOL
  elsif node_kind == node_constants::NODE_REGEX_LIT
    result = type_constants::TYPE_REGEX
  elsif node_kind == node_constants::NODE_FLOAT_LIT
    result = type_constants::TYPE_F64
  elsif node_kind == node_constants::NODE_INLINE_C
    # @c("code") always returns Int
    result = type_constants::TYPE_INT
  
  # Identifier
  elsif node_kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(ast_storage, node)
    # Arena safety: check for use-after-invalidation
    typecheck::tc_arena_check_use(tc, name, line, col)
    # Check linear live (QZ1203: use after move)
    typecheck_registry::tc_check_linear_live(tc, name, line, col)
    # Check move semantics (QZ1212: use of moved value)
    typecheck_registry::tc_check_not_moved(tc, name, line, col)
    # Check partial moves (QZ1216: field(s) moved out of struct)
    # Skip when inside field access — per-field check in tc_expr_field_access handles it
    if tc.safety.field_access_depth == 0
      typecheck_registry::tc_check_not_partially_moved(tc, name, line, col)
    end
    # Scope-set-aware lookup per Flatt POPL 2016. Falls back to legacy
    # behavior when both ref and all candidates have empty scope sets
    # (the common non-macro case). Macro hygiene retrofit · P3.c.
    result = typecheck_util::tc_scope_lookup_at(tc, name, ast_storage, node)
    # SURF.FLOW Phase 1 — flow-narrowing consult. If a refinement for `name` is
    # active at the current depth (pushed by the if-handler before walking a
    # presence-guard then-branch), this read sees the inner T, not Option<T>.
    # Done in ONE place so every read site (call args, operators, field access)
    # observes the narrowed type uniformly. We also stamp the read NODE_IDENT's
    # int_val to 1 (a plain ident never uses int_val) so MIR lowering extracts
    # the Option payload at exactly — and only — this proven-safe read site.
    # SURF.FLOW Phase 1 additivity fix: a read whose `op` field is 1 is the
    # direct operand of force-unwrap / `$unwrap` (see expand_builtin_unwrap).
    # Suppress narrowing here so the unwrap performs its single payload extract
    # over the still-Option-typed operand. Narrowing every OTHER read of `name`
    # remains in effect, so bare narrowed reads keep Phase 1 behavior and the
    # additive guarantee (FLOW_NARROWING §3.3 rule 5) holds for `opt!`.
    var nr_is_unwrap_operand = ast::ast_get_op(ast_storage, node) == 1
    if result != type_constants::TYPE_ERROR and nr_is_unwrap_operand == false
      var narrowed = typecheck_util::tc_narrow_lookup(tc, name)
      if narrowed != type_constants::TYPE_ERROR
        # SURF.FLOW — narrowed read: type is the inner `T`. int_val encodes the MIR
        # payload-extract decision: 1 = extract, 2 = "pinned NO-extract" (a consuming
        # chokepoint determined this read flows whole into a wide Option/Result slot
        # — see tc_unstamp_narrowed_into_wide). The typechecker walks a value
        # subexpression more than once (per-module + compile() all_funcs passes, plus
        # block-as-expression re-walks); a read pinned to 2 must NOT be re-stamped to
        # 1 on a later walk, else a scalar would be stored into an Option word and a
        # later match/unwrap dereferences garbage → SIGSEGV (tui_form/tui_focus_ring).
        # So: only stamp the extract when not pinned. The TYPE is still the inner T
        # (the read genuinely typechecks as T); pinning only governs MIR extraction.
        result = narrowed
        if ast::ast_get_int_val(ast_storage, node) != 2
          ast::ast_set_int_val(ast_storage, node, 1)
        end
      end
    end
    # Resolve type variables — if the binding has a type var that was later
    # constrained (e.g., by a function call or operator), return the resolved type
    if typecheck_util::tc_tv_is_var(result) == 1
      result = typecheck_util::tc_tv_resolve(tc, result)
    end
    # T3c.1 Phase 3: Instantiate polymorphic bindings
    if result != type_constants::TYPE_ERROR
      var inst_bidx = typecheck_util::tc_lookup_binding_index(tc, name)
      if inst_bidx >= 0 and inst_bidx < tc.scope.binding_schemes.size
        var inst_scheme = tc.scope.binding_schemes[inst_bidx]
        if inst_scheme.size > 0
          result = typecheck_util::tc_instantiate(tc, result, inst_scheme)
        end
      end
    end
    if result == type_constants::TYPE_ERROR
      result = typecheck_builtins::tc_lookup_builtin(tc, name)
    end
    # Try function registry — functions are registered by raw name, not in scope.
    # §14.7 item 2 (5a): a bare reference to a top-level `def` used as a VALUE
    # (not called) must carry its concrete `Fn(...): R` signature, not the
    # signatureless scalar `TYPE_FUNCTION`. Synthesize a signature-carrying Fn
    # ptype from the registry's param + return types (mirroring the lambda /
    # `Fn(...)`-annotation builder at typecheck.qz:1633-1657). With a real
    # signature attached, `tc_fn_type_id(result) >= 0` and the existing
    # `option_some(...)` payload refinement + `.unwrap()` narrowing recover a
    # callable. Fall back to bare `TYPE_FUNCTION` only when the param list can't
    # be resolved (keeps behavior unchanged for that corner).
    if result == type_constants::TYPE_ERROR
      var fn_ret = typecheck_registry::tc_lookup_function_return(tc, name)
      if fn_ret != type_constants::TYPE_ERROR
        var fn_params_opt = typecheck_registry::tc_lookup_function_params(tc, name)
        if fn_params_opt is Some
          # Copy the registry's param vec — tc_make_fn_type_from_types stores the
          # passed vec by reference into fn_type_param_types, and the source vec is
          # the function registry's own func_param_types[i]; don't alias them.
          var fn_src_params = fn_params_opt.unwrap()
          var fn_params = vec_new()
          for _fp_i in 0..fn_src_params.size
            fn_params.push(fn_src_params[_fp_i])
          end
          result = typecheck_registry::tc_make_fn_type_from_types(tc, fn_params, fn_ret)
        else
          result = type_constants::TYPE_FUNCTION
        end
      end
    end
    if result == type_constants::TYPE_ERROR
      # Check if name is an uppercase type name (for Type.method() associated function calls)
      var first_ch = str_byte_at(name, 0)
      if first_ch >= 65 and first_ch <= 90
        var struct_result = typecheck_registry::tc_lookup_struct(tc, name)
        if struct_result.is_found()
          result = type_constants::TYPE_INT
        else
          var enum_result = typecheck_registry::tc_lookup_enum(tc, name)
          if enum_result.is_found()
            result = type_constants::TYPE_INT
          end
        end
      end
      if result == type_constants::TYPE_ERROR
        var suggestion = typecheck_registry::tc_suggest_identifier(tc, name)
        error("Undefined variable: #{name}#{suggestion}", line, col)
        result = type_constants::TYPE_ERROR
      end
    end
    # NLL: Release borrow at last use of binding
    if result != type_constants::TYPE_ERROR
      typecheck::tc_try_release_borrow_at_last_use(tc, name, line, col)
    end

    # PSQ-6 / Sched effect, Phase C.3 (2026-04-30): inside a `can Sched`
    # function body, reading a captured/global non-Sync binding is QZ1408.
    # Capture-vs-local detection: the binding's `binding_depths[idx]` is
    # the scope depth at bind time. `tc.in_sched_min_depth` is the depth
    # right after entering the Sched function's body scope. Bindings at
    # depths < in_sched_min_depth are non-local (captures or globals).
    # Function pointers (TYPE_FUNCTION) are immutable — exempt.
    if tc.in_sched_min_depth > 0 and result != type_constants::TYPE_ERROR
      if result != type_constants::TYPE_FUNCTION
        var sc_idx = typecheck_util::tc_lookup_binding_index(tc, name)
        if sc_idx >= 0
          var sc_bd = tc.scope.binding_depths[sc_idx]
          if sc_bd < tc.in_sched_min_depth
            # Phase A.5b item 3 (2026-05-01): @thread_local globals are
            # per-thread storage — skip the Sync check entirely.
            if not tc.thread_local_globals.has(name)
              var sc_struct = tc.scope.binding_struct_names[sc_idx]
              if typecheck_registry::tc_type_is_sync(tc, result, sc_struct) == 0
                error("QZ1408: '#{name}' read inside a 'can Sched' body is not Sync (foreign-thread read on a mutable binding); wrap in Mutex<T>, use an Atomic*, or move to per-thread storage", line, col)
              end
            end
          end
        end
      end
    end

  # Binary operators
  elsif node_kind == node_constants::NODE_BINARY
    var left_node = ast::ast_get_left(ast_storage, node)
    var right_node = ast::ast_get_right(ast_storage, node)
    var op = ast::ast_get_op(ast_storage, node)
    
    var left_type = tc_expr(tc, ast_storage, left_node)
    var right_type = tc_expr(tc, ast_storage, right_node)

    # Check for operator overloading on struct types
    var overload_result = typecheck_expr_handlers::tc_check_op_overload(tc, ast_storage, node, left_node, left_type, op)

    if overload_result > 0
      result = overload_result
    else
      # Infer binary operator types - simplified (no HOF inference for now)
      var op_str = match op
        0 => "+"
        1 => "-"
        2 => "*"
        3 => "/"
        4 => "%"
        7 => "=="
        8 => "!="
        9 => "<"
        10 => "<="
        11 => ">"
        12 => ">="
        14 => "and"
        15 => "or"
        21 => ".."
        22 => "??"
        23 => "..."
        16 => "&"
        17 => "|"
        18 => "^"
        19 => "<<"
        20 => ">>"
        25 => "=~"
        26 => "!~"
        _ => ""
      end

      # Shovel operator: << on collection types becomes push/add/append/send
      # Tag the node via str2 for MIR lowering; type check proceeds normally
      if op == 19
        if left_type == type_constants::TYPE_VEC or (typecheck::tc_is_ptype(left_type) and typecheck::tc_base_kind(tc, left_type) == type_constants::TYPE_VEC)
          ast::ast_set_str2(ast_storage, node, "shovel_vec_push")
        elsif left_type == type_constants::TYPE_SET or (typecheck::tc_is_ptype(left_type) and typecheck::tc_base_kind(tc, left_type) == type_constants::TYPE_SET)
          ast::ast_set_str2(ast_storage, node, "shovel_set_add")
        elsif left_type == type_constants::TYPE_STRINGBUILDER
          ast::ast_set_str2(ast_storage, node, "shovel_sb_append")
        elsif left_type == type_constants::TYPE_CHANNEL or (typecheck::tc_is_ptype(left_type) and typecheck::tc_base_kind(tc, left_type) == type_constants::TYPE_CHANNEL)
          ast::ast_set_str2(ast_storage, node, "shovel_send")
        end
      end
      # T3c.1 Phase 2: Resolve/constrain type variables before binary check
      var resolved_left = typecheck_helpers::tc_resolve_binary_operand(tc, left_type, op_str)
      var resolved_right = typecheck_helpers::tc_resolve_binary_operand(tc, right_type, op_str)

      # String + non-String auto-coercion: wrap the non-String side in to_str()
      if op == 0
        var left_is_str = resolved_left == type_constants::TYPE_STRING
        var right_is_str = resolved_right == type_constants::TYPE_STRING
        if left_is_str and not right_is_str and resolved_right != type_constants::TYPE_ERROR
          var coerce_fn = "to_str"
          if resolved_right == type_constants::TYPE_F64 or resolved_right == type_constants::TYPE_F32
            coerce_fn = "f64_to_str"
          elsif resolved_right == type_constants::TYPE_BOOL
            coerce_fn = "bool_to_str"
          end
          var ts_ident = ast::ast_ident(ast_storage, coerce_fn, line, col)
          var ts_call = ast::ast_call(ast_storage, ts_ident, [right_node], line, col)
          ast::ast_set_right(ast_storage, node, ts_call)
          tc_expr(tc, ast_storage, ts_call)
          resolved_right = type_constants::TYPE_STRING
        elsif right_is_str and not left_is_str and resolved_left != type_constants::TYPE_ERROR
          var coerce_fn = "to_str"
          if resolved_left == type_constants::TYPE_F64 or resolved_left == type_constants::TYPE_F32
            coerce_fn = "f64_to_str"
          elsif resolved_left == type_constants::TYPE_BOOL
            coerce_fn = "bool_to_str"
          end
          var ts_ident = ast::ast_ident(ast_storage, coerce_fn, line, col)
          var ts_call = ast::ast_call(ast_storage, ts_ident, [left_node], line, col)
          ast::ast_set_left(ast_storage, node, ts_call)
          tc_expr(tc, ast_storage, ts_call)
          resolved_left = type_constants::TYPE_STRING
        end
      end

      # STRICT_NEWTYPES — reject relational ops and bit-shifts on strict-newtype
      # operands. Equality/ordering on Secret<T> leaks bits via the icmp; shifts
      # by a secret amount on x86/ARM leak through the BSR/BSF path. Arithmetic
      # (+/-/*/etc.) on like-typed strict newtypes is permitted via tc_types_match
      # exact-id equality (Secret<Int> + Secret<Int> typechecks).
      with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        if op == 7 or op == 8 or op == 9 or op == 10 or op == 11 or op == 12
          if typecheck::tc_is_strict_newtype(tc, left_type) or typecheck::tc_is_strict_newtype(tc, right_type)
            error("Operator '#{op_str}' on strict-newtype value leaks its bits via control flow. Use a constant-time helper from `std/core/crypto/subtle` (ct_eq_byte / ct_eq_bytes / ct_less_u32).", line, col)
            result = type_constants::TYPE_ERROR
          end
        end
        if op == 19 or op == 20
          if typecheck::tc_is_strict_newtype(tc, left_type) or typecheck::tc_is_strict_newtype(tc, right_type)
            error("Shift operator '#{op_str}' on a strict-newtype operand can leak bits via the variable-shift micro-op path. Unwrap (`as_type<Int>(s)`) and re-wrap at the boundary — arithmetic stays inside the strict newtype.", line, col)
            result = type_constants::TYPE_ERROR
          end
        end
      end

      result = with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_helpers::tc_check_binary(op_str, resolved_left, resolved_right, line, col)
      end
    end

  # Unary operators
  elsif node_kind == node_constants::NODE_UNARY
    var operand_node = ast::ast_get_left(ast_storage, node)
    var op = ast::ast_get_op(ast_storage, node)
    
    var operand_type = tc_expr(tc, ast_storage, operand_node)
    
    var op_str = match op
      13 => "not"
      14 => "-"
      18 => "~"
      _ => ""
    end
    
    result = with Diag {
      error: typecheck_diag::tc_diag_error_handler
    } do ->
      typecheck_helpers::tc_check_unary(op_str, operand_type, line, col)
    end
  
  # Function call
  elsif node_kind == node_constants::NODE_CALL
    result = typecheck_expr_handlers::tc_expr_call(tc, ast_storage, node, line, col)

  # Array literal
  elsif node_kind == node_constants::NODE_ARRAY
    var elements = ast::ast_get_children(ast_storage, node)

    for ei in 0..elements.size
      var elem = elements[ei]
      if ast::ast_get_kind(ast_storage, elem) == node_constants::NODE_SPREAD
        tc_expr(tc, ast_storage, ast::ast_get_left(ast_storage, elem))
      else
        tc_expr(tc, ast_storage, elem)
      end
    end

    result = type_constants::TYPE_ARRAY

  # Set literal
  elsif node_kind == node_constants::NODE_SET_LITERAL
    var elements = ast::ast_get_children(ast_storage, node)

    each(elements, elem: Int -> tc_expr(tc, ast_storage, elem))

    result = type_constants::TYPE_INT

  # Tuple literal
  elsif node_kind == node_constants::NODE_TUPLE_LITERAL
    var elements = ast::ast_get_children(ast_storage, node)
    var elem_types = vec_new()
    for ei in 0..elements.size
      var et = tc_expr(tc, ast_storage, elements[ei])
      elem_types.push(et)
    end
    result = typecheck_util::tc_make_tuple_type(tc, elem_types)

  # List comprehension: [expr for x in iter if cond]
  # NODE_LIST_COMP = 46 - returns Int (vec_new handle)
  elsif node_kind == node_constants::NODE_LIST_COMP
    var expr_node = ast::ast_get_left(ast_storage, node)
    var var_name = ast::ast_get_str1(ast_storage, node)
    var iter_node = ast::ast_get_right(ast_storage, node)
    var cond_node = ast::ast_get_extra(ast_storage, node)

    # Type check the iterable
    tc_expr(tc, ast_storage, iter_node)

    # Type check step expression if present
    var lc_step_node = ast::ast_get_int_val(ast_storage, node)
    if lc_step_node > 0
      tc_expr(tc, ast_storage, lc_step_node)
    end

    # Bind the loop variable in a new scope
    typecheck_util::tc_enter_scope()
    typecheck_util::tc_scope_bind(tc, var_name, type_constants::TYPE_INT, 0, "")

    # Snapshot borrow + move states before comprehension body (like for/while loops)
    var lc_borrow_snapshot = typecheck::tc_snapshot_borrow_states(tc)
    var lc_move_snapshot = typecheck_registry::tc_snapshot_move_states(tc)

    # Type check the expression body
    tc_expr(tc, ast_storage, expr_node)

    # Type check the condition if present
    if cond_node > 0
      tc_expr(tc, ast_storage, cond_node)
    end

    # Check for moves inside comprehension body (same pattern as NODE_FOR/NODE_WHILE)
    var lc_binding_count = typecheck_util::tc_get_binding_count(tc)
    for lci in 0..lc_binding_count
      if lci < lc_move_snapshot.size
        if lc_move_snapshot[lci] == 1 and tc.safety.move_states[lci] == 2
          var lc_name = tc.scope.binding_names[lci]
          var lc_target = tc.safety.move_targets[lci]
          var lc_line = tc.safety.move_lines[lci]
          error("QZ1212: Value '#{lc_name}' is moved inside list comprehension body (moved to '#{lc_target}' at line #{lc_line})", line, col)
        end
      end
    end

    # Restore borrow states
    typecheck::tc_restore_borrow_states(tc, lc_borrow_snapshot)

    typecheck::tc_exit_scope(tc)

    # FIX.6 Phase 4: Return TYPE_VEC so UFCS dispatch works on list comp results
    result = type_constants::TYPE_VEC
  
  # Array indexing
  elsif node_kind == node_constants::NODE_INDEX
    result = typecheck_expr_handlers::tc_expr_index(tc, ast_storage, node, line, col)

  # Struct initialization
  elsif node_kind == node_constants::NODE_STRUCT_INIT
    result = typecheck_expr_handlers::tc_expr_struct_init(tc, ast_storage, node, line, col)
  
  # Field access
  elsif node_kind == node_constants::NODE_FIELD_ACCESS
    result = typecheck_expr_handlers::tc_expr_field_access(tc, ast_storage, node, line, col)

  # Enum variant access
  elsif node_kind == node_constants::NODE_ENUM_ACCESS
    var enum_name = ast::ast_get_str1(ast_storage, node)
    var variant_name = ast::ast_get_str2(ast_storage, node)
    var payloads = ast::ast_get_children(ast_storage, node)

    # Tier 4 #24 Phase 4b §2.3: Slice<T>::EMPTY / SliceMut<T>::EMPTY resolves
    # to a zero-initialized 16-byte slice header. Intercept here so we don't
    # go through the enum-variant path (Slice isn't a user enum).
    if variant_name == "EMPTY"
      if enum_name == "Slice"
        result = typecheck::tc_make_ptype(tc, type_constants::TYPE_SLICE, 0, 0)
        return result
      end
      if enum_name == "SliceMut"
        result = typecheck::tc_make_ptype(tc, type_constants::TYPE_SLICE_MUT, 0, 0)
        return result
      end
    end

    # Type check payload arguments
    var actual_payload_count = 0
    if payloads > 0
      each(payloads, payload: Int -> tc_expr(tc, ast_storage, payload))
      actual_payload_count = vec_size(payloads)
      # Move semantics: consume moveable payload arguments
      for ea_i in 0..actual_payload_count
        var ea_payload = payloads[ea_i]
        var ea_kind = ast::ast_get_kind(ast_storage, ea_payload)
        if ea_kind == node_constants::NODE_IDENT
          var ea_name = ast::ast_get_str1(ast_storage, ea_payload)
          var ea_callee = "#{enum_name}::#{variant_name}"
          typecheck_registry::tc_move_on_call(tc, ea_name, ea_callee, line, col)
        end
      end
    end

    # Validate payload argument count against enum definition
    var expected_payload_count = typecheck_registry::tc_enum_variant_payload_count(tc, enum_name, variant_name)
    if expected_payload_count >= 0 and actual_payload_count != expected_payload_count
      error("Enum variant #{enum_name}::#{variant_name} expects #{str_from_int(expected_payload_count)} argument(s), got #{str_from_int(actual_payload_count)}", line, col)
      result = type_constants::TYPE_ERROR
    else
      result = with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_generics::tc_check_enum_access(tc, enum_name, variant_name, line, col)
      end

      # Item 2 (enum-access payload carry): `tc_check_enum_access` returns the
      # BARE base (TYPE_OPTION/TYPE_RESULT) for every Some/Ok/Err, erasing the
      # payload — so a mismatched element (`Vec<Option<String>>.push(
      # Option::Some(42))`) was WRONGLY accepted via the comparator's bare-base
      # escape hatch. There are NO result_ok/result_err builtins; Result is built
      # ONLY here, so this single carry covers all variants. Mirror item 10's
      # `option_some` intrinsic carry: refine to a concrete ptype when the single
      # payload is a nominally-resolvable concrete type (tc_option_some_carries_
      # payload — excludes bare aggregate bases, type-vars, VOID/UNKNOWN/ERROR,
      # which keeps struct-literal payloads loose for the niche-read path and
      # leaves dataless None / multi-payload variants untouched). The sibling
      # type-arg slot is TYPE_UNKNOWN (the Err arg of Ok, the Ok arg of Err) —
      # tc_elem_type_matches waves UNKNOWN through so `Result<Int,String> =
      # Result::Ok(5)` accepts while `Result::Ok("s")` (tight Int-vs-String)
      # still rejects. tc_make_ptype interns, so the refined id equals an
      # annotation-parsed `Option<Int>` / `Result<Int, _>`.
      if actual_payload_count == 1 and (result == type_constants::TYPE_OPTION or result == type_constants::TYPE_RESULT)
        var ea_payload_t = tc_expr(tc, ast_storage, payloads[0])
        if typecheck_expr_handlers::tc_option_some_carries_payload(tc, ea_payload_t)
          if result == type_constants::TYPE_OPTION
            result = typecheck::tc_make_ptype(tc, type_constants::TYPE_OPTION, ea_payload_t, type_constants::TYPE_UNKNOWN)
          elsif variant_name == "Err"
            result = typecheck::tc_make_ptype(tc, type_constants::TYPE_RESULT, type_constants::TYPE_UNKNOWN, ea_payload_t)
          else
            result = typecheck::tc_make_ptype(tc, type_constants::TYPE_RESULT, ea_payload_t, type_constants::TYPE_UNKNOWN)
          end
        end
      end
    end

  # Projected data-borrow `&mut p.f` / `&p.f` / `&mut a[i]` (WS4 Step 0).
  # A borrow of a projected place has the TYPE of that place (a `&mut` borrow is
  # a mutable borrow of it). We type the operand place expression directly; the
  # per-field / index exclusivity precision lives in exclusivity.qz, which reads
  # NODE_BORROW's operand to build a projected Place. Base-name move/borrow-state
  # tracking (QZ1205/QZ1208 keyed on a binding index) applies to bare-ident
  # borrows via NODE_FUNC_REF; a projected place is not a single binding, so we
  # do not re-run that binding-index machinery here.
  elsif node_kind == node_constants::NODE_BORROW
    var borrow_operand = ast::ast_get_left(ast_storage, node)
    result = tc_expr(tc, ast_storage, borrow_operand)

  # Function reference
  elsif node_kind == node_constants::NODE_FUNC_REF
    var func_name = ast::ast_get_str1(ast_storage, node)
    var is_mut_borrow = ast::ast_get_int_val(ast_storage, node)

    var fn_type = typecheck_util::tc_scope_lookup(tc, func_name)
    if fn_type == type_constants::TYPE_ERROR
      fn_type = typecheck_builtins::tc_lookup_builtin(tc, func_name)
    end

    if fn_type == type_constants::TYPE_ERROR
      # Not a scope binding or builtin — check function registry
      var fn_ret = typecheck_registry::tc_lookup_function_return(tc, func_name)
      if fn_ret != type_constants::TYPE_ERROR
        result = type_constants::TYPE_FUNCTION
      else
        error("Undefined function: #{func_name}", line, col)
        result = type_constants::TYPE_ERROR
      end
    else
      # Check if this is a borrow (&var) rather than function ref
      var lin_state = typecheck_registry::tc_lookup_linear_state(tc, func_name)
      if lin_state > 0
        # Borrow of linear value — check liveness, don't consume
        if lin_state == 2
          error("QZ1204: Cannot borrow consumed value '#{func_name}'", line, col)
        end
        result = fn_type
      else
        # Check function registry for actual functions
        var fn_ret = typecheck_registry::tc_lookup_function_return(tc, func_name)
        if fn_ret != type_constants::TYPE_ERROR
          result = type_constants::TYPE_FUNCTION
        else
          # This is a borrow expression — apply borrow checking
          var bidx = typecheck_util::tc_lookup_binding_index(tc, func_name)
          # Cannot borrow a moved value
          if bidx >= 0 and tc.safety.move_states[bidx] == 2
            var borrow_prev_target = tc.safety.move_targets[bidx]
            var borrow_prev_line = tc.safety.move_lines[bidx]
            error("QZ1212: Cannot borrow moved value '#{func_name}' (moved to '#{borrow_prev_target}' at line #{borrow_prev_line})", line, col)
          end
          # Cannot borrow a partially-moved value
          if bidx >= 0 and tc.safety.partial_moved_fields[bidx].size > 0
            var pm_fields = tc.safety.partial_moved_fields[bidx]
            error("QZ1216: Cannot borrow '#{func_name}' — field(s) #{pm_fields} have been moved out", line, col)
          end
          if bidx >= 0 and is_mut_borrow == 1
            # SURF.FLOW Phase 2 — a mutable borrow `&mut x` hands out a capability
            # to reassign through the alias, so the narrowing proof is no longer
            # guaranteed live. Invalidate any active narrowing on the borrowed
            # name (conservative: const narrowings are immune anyway since const
            # can't be mut-borrowed — QZ1208 fires above).
            typecheck_util::tc_narrow_invalidate(tc, func_name)
            # Idempotent re-evaluation guard: the type checker walks call
            # arguments multiple times, so the same `&mut x` node is evaluated
            # repeatedly. Re-applying its borrow would self-conflict (QZ1205)
            # against the borrow it already created. Skip if this exact borrow
            # (binding + source position) is already active this statement; a
            # borrow of the same binding at a DIFFERENT position is a genuine
            # second borrow and still flows through the checks below.
            if typecheck_util::tc_temp_borrow_has(bidx, line, col) == 0
              if tc.scope.binding_mutables[bidx] == 0
                error("QZ1208: Cannot create mutable borrow of immutable binding '#{func_name}'", line, col)
              end
              if tc.safety.binding_borrow_states[bidx] == 2
                error("QZ1205: Cannot create exclusive borrow \xe2\x80\x94 '#{func_name}' is already mutably borrowed", line, col)
              end
              if tc.safety.binding_shared_borrow_counts[bidx] > 0
                error("QZ1206: Conflicting borrows \xe2\x80\x94 '#{func_name}' has active shared borrows", line, col)
              end
              tc.safety.binding_borrow_states[bidx] = 2
              # Track as a temporary borrow; released at statement end unless this
              # borrow gets bound to a live holder (var r = &mut x).
              typecheck_util::tc_temp_borrow_push(bidx, 1, line, col)
            end
          elsif bidx >= 0 and is_mut_borrow == 0
            if typecheck_util::tc_temp_borrow_has(bidx, line, col) == 0
              if tc.safety.binding_borrow_states[bidx] == 2
                error("QZ1206: Conflicting borrows \xe2\x80\x94 '#{func_name}' is already mutably borrowed", line, col)
              end
              if tc.safety.binding_borrow_states[bidx] == 0
                tc.safety.binding_borrow_states[bidx] = 1
              end
              tc.safety.binding_shared_borrow_counts[bidx] = tc.safety.binding_shared_borrow_counts[bidx] + 1
              typecheck_util::tc_temp_borrow_push(bidx, 0, line, col)
            end
          end
          result = fn_type
        end
      end
    end

  # Lambda expression
  elsif node_kind == node_constants::NODE_LAMBDA
    result = typecheck_expr_handlers::tc_expr_lambda(tc, ast_storage, node, line, col)
  
  # If expression
  elsif node_kind == node_constants::NODE_IF
    var cond_node = ast::ast_get_left(ast_storage, node)
    var then_node = ast::ast_get_right(ast_storage, node)
    var else_node = ast::ast_get_extra(ast_storage, node)
    var eif_int_val = ast::ast_get_int_val(ast_storage, node)

    if eif_int_val == 1
      # Pattern binding expression: `if PATTERN = EXPR then v else 0 end`
      var eif_pb_pattern = ast::ast_get_op(ast_storage, node)
      var eif_pb_subject = tc_expr(tc, ast_storage, cond_node)

      var eif_pb_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
      var eif_pb_partial_snap = typecheck_registry::tc_snapshot_partial_moves(tc)
      var eif_pb_linear_snap = typecheck_registry::tc_snapshot_linear_states(tc)

      typecheck_util::tc_enter_scope()
      typecheck_match::tc_bind_if_pattern(tc, ast_storage, eif_pb_pattern, eif_pb_subject, line, col)
      var eif_pb_then_type = type_constants::TYPE_VOID
      if then_node >= 0
        eif_pb_then_type = tc_expr(tc, ast_storage, then_node)
      end
      typecheck::tc_exit_scope(tc)

      var eif_pb_then_moves = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, eif_pb_move_snap)
      var eif_pb_then_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, eif_pb_partial_snap)
      var eif_pb_then_linears = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, eif_pb_linear_snap)

      if else_node >= 0
        var eif_pb_else_type = tc_expr(tc, ast_storage, else_node)
        var eif_pb_else_moves = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, eif_pb_then_moves, eif_pb_else_moves, line, col)
        var eif_pb_else_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, eif_pb_then_partials, eif_pb_else_partials, line, col)
        var eif_pb_else_linears = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, eif_pb_then_linears, eif_pb_else_linears, line, col)
      else
        typecheck_registry::tc_restore_linear_states(tc, eif_pb_then_linears)
        typecheck_registry::tc_merge_move_states(tc, eif_pb_then_moves, eif_pb_move_snap, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, eif_pb_then_partials, eif_pb_partial_snap, line, col)
      end

      result = eif_pb_then_type

    # Is-with-bindings expression: `if val is Some(x) then x else 0 end`
    elsif cond_node >= 0 and ast::ast_get_kind(ast_storage, cond_node) == node_constants::NODE_IS_CHECK and ast::ast_get_bound_names(ast_storage, cond_node) > 0
      # Type-check subject
      var isb_subject_node = ast::ast_get_left(ast_storage, cond_node)
      var isb_subject_type = tc_expr(tc, ast_storage, isb_subject_node)
      var isb_variant_name = ast::ast_get_str1(ast_storage, cond_node)
      var isb_bound_names = ast::ast_get_bound_names(ast_storage, cond_node)

      # Resolve enum name from subject's struct_name in scope
      var isb_enum_name = ""
      if isb_subject_node >= 0 and ast::ast_get_kind(ast_storage, isb_subject_node) == node_constants::NODE_IDENT
        isb_enum_name = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, isb_subject_node))
      end

      var isb_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
      var isb_partial_snap = typecheck_registry::tc_snapshot_partial_moves(tc)
      var isb_linear_snap = typecheck_registry::tc_snapshot_linear_states(tc)

      # Enter scope, bind pattern variables, type-check then-body
      typecheck_util::tc_enter_scope()
      typecheck_match::tc_bind_pattern_variables(tc, isb_bound_names, isb_subject_type, isb_enum_name, isb_variant_name, line, col)
      var isb_then_type = type_constants::TYPE_VOID
      if then_node >= 0
        isb_then_type = tc_expr(tc, ast_storage, then_node)
      end
      typecheck::tc_exit_scope(tc)

      var isb_then_moves = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, isb_move_snap)
      var isb_then_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, isb_partial_snap)
      var isb_then_linears = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, isb_linear_snap)

      if else_node >= 0
        var isb_else_type = tc_expr(tc, ast_storage, else_node)
        var isb_else_moves = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, isb_then_moves, isb_else_moves, line, col)
        var isb_else_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, isb_then_partials, isb_else_partials, line, col)
        var isb_else_linears = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, isb_then_linears, isb_else_linears, line, col)
      else
        typecheck_registry::tc_restore_linear_states(tc, isb_then_linears)
        typecheck_registry::tc_merge_move_states(tc, isb_then_moves, isb_move_snap, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, isb_then_partials, isb_partial_snap, line, col)
      end

      result = isb_then_type

    else
      var cond_type = tc_expr(tc, ast_storage, cond_node)
      typecheck_helpers::tc_check_condition(tc, cond_type, "if", line, col)

      # Snapshot move/linear/partial/protocol states before branches
      var eif_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
      var eif_partial_snap = typecheck_registry::tc_snapshot_partial_moves(tc)
      var eif_linear_snap = typecheck_registry::tc_snapshot_linear_states(tc)
      var eif_proto_snap = typecheck_registry::tc_snapshot_protocol_states(tc, 0)

      var then_type = type_constants::TYPE_VOID
      # Note: node >= 0 because node handle 0 is valid (first AST node)
      # Parser uses -1 as sentinel for "no else clause"
      if then_node >= 0
        then_type = tc_expr(tc, ast_storage, then_node)
      end

      # Save then-branch states and restore for else
      var eif_then_moves = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, eif_move_snap)
      var eif_then_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, eif_partial_snap)
      var eif_then_linears = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, eif_linear_snap)
      var eif_then_protos = typecheck_registry::tc_snapshot_protocol_states(tc, 0)
      typecheck_registry::tc_restore_protocol_states(tc, eif_proto_snap)

      var else_type = type_constants::TYPE_VOID
      if else_node >= 0
        else_type = tc_expr(tc, ast_storage, else_node)
        # Merge then + else move states
        var eif_else_moves = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, eif_then_moves, eif_else_moves, line, col)
        var eif_else_partials = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, eif_then_partials, eif_else_partials, line, col)
        var eif_else_linears = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, eif_then_linears, eif_else_linears, line, col)
        # Protocol branch agreement: both branches must advance protocols identically
        var eif_else_protos = typecheck_registry::tc_snapshot_protocol_states(tc, 0)
        if typecheck_registry::tc_check_protocol_branch_agreement(eif_then_protos, eif_else_protos) == 0
          error("QZ1405: Protocol state mismatch between if/else branches — both branches must advance protocol channels to the same state", line, col)
        end

        # T3c.1 Phase 2: Unify branch types.
        # If either is a type variable, bind it. If both are concrete and
        # different, unify to check compatibility (but don't error for
        # non-primitive mismatches due to existential type model).
        if typecheck_util::tc_tv_is_var(then_type) == 1
          typecheck_util::tc_tv_unify(tc, then_type, else_type)
        elsif typecheck_util::tc_tv_is_var(else_type) == 1
          typecheck_util::tc_tv_unify(tc, else_type, then_type)
        end

        # QZ0168 (Phase 7): cross-origin opaque type unification. If both
        # branches return values whose display type is an opaque marker, and
        # the markers are different (different origin functions), they are
        # incompatible even when the underlying concrete struct happens to
        # match.
        var qz168_then_disp = typecheck_generics::tc_infer_expr_display_annotation(tc, ast_storage, then_node)
        var qz168_else_disp = typecheck_generics::tc_infer_expr_display_annotation(tc, ast_storage, else_node)
        if typecheck_registry::tc_is_opaque_marker(qz168_then_disp) and typecheck_registry::tc_is_opaque_marker(qz168_else_disp)
          if not qz168_then_disp.eq(qz168_else_disp)
            error("QZ0168: incompatible opaque types `#{qz168_then_disp}` and `#{qz168_else_disp}`. Two functions returning `impl Trait` produce distinct opaque identities even when the underlying concrete types match. Hoist the shared concrete type explicitly if you need unification.", line, col)
          end
        end
      else
        # No else — merge then-branch with original (else = no change)
        typecheck_registry::tc_restore_linear_states(tc, eif_then_linears)
        typecheck_registry::tc_merge_move_states(tc, eif_then_moves, eif_move_snap, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, eif_then_partials, eif_partial_snap, line, col)
        # No else: if then-branch advanced protocol, that's a mismatch
        # (else implicitly leaves protocol unchanged = original state)
        if typecheck_registry::tc_check_protocol_branch_agreement(eif_then_protos, eif_proto_snap) == 0
          error("QZ1405: Protocol state mismatch — if-branch advances protocol but no else-branch (both paths must agree)", line, col)
        end
      end

      # Return resolved then-type (may have been unified with else-type)
      result = typecheck_util::tc_tv_resolve(tc, then_type)
    end

  # Match expression
  elsif node_kind == node_constants::NODE_MATCH
    result = typecheck_expr_handlers::tc_expr_match(tc, ast_storage, node, line, col)

  # Map literal
  elsif node_kind == node_constants::NODE_MAP_LIT
    var entries = ast::ast_get_children(ast_storage, node)
    if entries > 0
      each(entries, entry: Int -> tc_expr(tc, ast_storage, entry))
    end
    result = type_constants::TYPE_MAP

  # Map comprehension {key => val for var in iter if cond} -> Map<K,V>
  elsif node_kind == node_constants::NODE_MAP_COMP
    var mc_key = ast::ast_get_left(ast_storage, node)
    var mc_val = ast::ast_get_right(ast_storage, node)
    var mc_var_name = ast::ast_get_str1(ast_storage, node)
    var mc_iter = ast::ast_get_extra(ast_storage, node)
    var mc_children = ast::ast_get_children(ast_storage, node)
    if mc_iter >= 0
      tc_expr(tc, ast_storage, mc_iter)
    end
    typecheck_util::tc_enter_scope()
    typecheck_util::tc_scope_bind(tc, mc_var_name, type_constants::TYPE_INT, 0, "")
    var mc_key_type = type_constants::TYPE_INT
    var mc_val_type = type_constants::TYPE_INT
    if mc_key >= 0
      mc_key_type = tc_expr(tc, ast_storage, mc_key)
    end
    if mc_val >= 0
      mc_val_type = tc_expr(tc, ast_storage, mc_val)
    end
    if mc_children > 0
      each(mc_children, mc_c: Int -> tc_expr(tc, ast_storage, mc_c))
    end
    typecheck::tc_exit_scope(tc)
    result = typecheck::tc_make_ptype(tc, type_constants::TYPE_MAP, mc_key_type, mc_val_type)
  
  # Try expression (Result type) - also handles UFCS predicate rewriting
  elsif node_kind == node_constants::NODE_TRY_EXPR
    result = typecheck_expr_handlers::tc_expr_try(tc, ast_storage, node, line, col)

  # Try-catch expression: try body catch pattern handler
  elsif node_kind == node_constants::NODE_TRY_CATCH
    var body_node = ast::ast_get_left(ast_storage, node)
    var pattern_node = ast::ast_get_extra(ast_storage, node)
    var handler_node = ast::ast_get_right(ast_storage, node)
    # Move semantics: snapshot before try body (branches are mutually exclusive)
    var try_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
    tc_expr(tc, ast_storage, body_node)
    var try_body_moves = typecheck_registry::tc_snapshot_move_states(tc)
    # Restore to pre-try state before checking catch handler
    typecheck_registry::tc_restore_move_states(tc, try_move_snap)
    # Bind pattern variable in scope for handler
    if pattern_node > 0
      var pat_kind = ast::ast_get_kind(ast_storage, pattern_node)
      if pat_kind == node_constants::NODE_IDENT
        var bind_name = ast::ast_get_str1(ast_storage, pattern_node)
        if bind_name != "_"
          typecheck_util::tc_scope_bind(tc, bind_name, type_constants::TYPE_INT, 0, "")
        end
      elsif pat_kind == node_constants::NODE_ENUM_ACCESS
        var bound_names = ast::ast_get_bound_names(ast_storage, pattern_node)
        typecheck_match::tc_bind_pattern_variables(tc, bound_names, type_constants::TYPE_INT, "", "", line, col)
      end
    end
    tc_expr(tc, ast_storage, handler_node)
    var catch_handler_moves = typecheck_registry::tc_snapshot_move_states(tc)
    # Merge move states from try body and catch handler (like if/else)
    typecheck_registry::tc_merge_move_states(tc, try_body_moves, catch_handler_moves, line, col)
    result = type_constants::TYPE_INT

  # Binary DSL .with { field = expr; ... } immutable update (STEP 5).
  # Receiver must be a registered packed struct; each override field
  # must exist on that struct. Phase 1.5 STEP 4: strict validation.
  elsif node_kind == node_constants::NODE_BINARY_WITH
    var bw_base = ast::ast_get_left(ast_storage, node)
    var bw_base_type = tc_expr(tc, ast_storage, bw_base)
    var bw_children = ast::ast_get_children(ast_storage, node)
    # Resolve the receiver struct name via inferred annotation. Generic
    # types (e.g. Option<Int>) fail the lookup; they're caught silently
    # here — the subsequent codegen will surface structural issues.
    var bw_rcv_name = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, bw_base)
    var bw_rcv_valid = 0
    var bw_rcv_idx = -1
    if str_byte_len(bw_rcv_name) > 0
      match typecheck_registry::tc_lookup_struct(tc, bw_rcv_name)
        Found(_bw_idx) => {
          var bw_kind = typecheck_registry::tc_struct_dsl_kind(tc, bw_rcv_name)
          if bw_kind == 2
            bw_rcv_valid = 1
            bw_rcv_idx = _bw_idx
          else
            error("QZ0958: `.with { }` requires a packed struct receiver, but '#{bw_rcv_name}' is not `packed struct(uN)`", line, col)
          end
        }
        NotFound => {}
      end
    end
    if bw_children != 0
      for bw_i in 0..bw_children.size
        var bw_entry = bw_children[bw_i]
        var bw_val = ast::ast_get_left(ast_storage, bw_entry)
        tc_expr(tc, ast_storage, bw_val)
        if bw_rcv_valid == 1 and bw_rcv_idx >= 0
          var bw_fld = ast::ast_get_str1(ast_storage, bw_entry)
          if str_byte_len(bw_fld) > 0
            var bw_fields = typecheck_registry::tc_struct_field_names(tc, bw_rcv_idx)
            var bw_found = 0
            for bw_fi in 0..bw_fields.size
              if bw_fields[bw_fi].eq(bw_fld)
                bw_found = 1
              end
            end
            if bw_found == 0
              error("QZ0959: `.with { }` field '#{bw_fld}' does not exist on packed struct '#{bw_rcv_name}'", line, col)
            end
          end
        end
      end
    end
    result = bw_base_type

  # Typed bitcast: `expr as TypeName` — Binary DSL STEP 3.
  # Phase 1.5 STEP 4 strictness (design decision #12):
  #   `as u<N>` requires a packed-struct source whose backing width == N.
  #   `as StructName` requires StructName to be a packed struct and the
  #   source to evaluate to Int. `as Int` stays lenient (identity-ish).
  elsif node_kind == node_constants::NODE_TYPE_CAST
    var cast_src = ast::ast_get_left(ast_storage, node)
    var cast_src_type = tc_expr(tc, ast_storage, cast_src)
    var cast_target = ast::ast_get_str1(ast_storage, node)
    var target_width = 0
    if cast_target.eq("u8")
      target_width = 8
    elsif cast_target.eq("u16")
      target_width = 16
    elsif cast_target.eq("u32")
      target_width = 32
    elsif cast_target.eq("u64")
      target_width = 64
    end
    if target_width > 0
      # Target is a backing integer — source must be packed struct with matching width.
      var src_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, cast_src)
      if str_byte_len(src_ann) > 0
        match typecheck_registry::tc_lookup_struct(tc, src_ann)
          Found(_src_idx) => {
            var src_kind = typecheck_registry::tc_struct_dsl_kind(tc, src_ann)
            if src_kind != 2
              error("QZ0954: `as #{cast_target}` requires a packed struct source, but '#{src_ann}' is not `packed struct(uN)`", line, col)
            else
              var src_backing = typecheck_registry::tc_struct_dsl_backing(tc, src_ann)
              if src_backing != target_width
                error("QZ0955: `as #{cast_target}` — backing width mismatch: '#{src_ann}' is packed struct(u#{src_backing.to_s()}), not u#{target_width.to_s()}", line, col)
              end
            end
          }
          NotFound => {}
        end
      end
      result = type_constants::TYPE_INT
    elsif cast_target.eq("Int")
      result = type_constants::TYPE_INT
    else
      var cast_sres = typecheck_registry::tc_lookup_struct(tc, cast_target)
      if cast_sres.is_found()
        var target_kind = typecheck_registry::tc_struct_dsl_kind(tc, cast_target)
        if target_kind != 2
          error("QZ0956: `as #{cast_target}` — target must be a packed struct, but '#{cast_target}' is not `packed struct(uN)`", line, col)
        else
          if cast_src_type != type_constants::TYPE_INT
            error("QZ0957: `as #{cast_target}` requires an integer source", line, col)
          end
        end
        result = type_constants::TYPE_STRUCT
      else
        error("`as #{cast_target}` — unknown type; target must be a packed struct or its backing integer (u8/u16/u32/u64)", line, col)
        result = type_constants::TYPE_ERROR
      end
    end

  # Safe field access: u?.field - unwraps Option and accesses field
  # Returns Option<FieldType> (or just the inner value when combined with ??)
  elsif node_kind == node_constants::NODE_SAFE_FIELD_ACCESS
    var object_node = ast::ast_get_left(ast_storage, node)
    var field_name = ast::ast_get_str1(ast_storage, node)
    
    # Type check the base object (should be Option<Struct>)
    var object_type = tc_expr(tc, ast_storage, object_node)
    
    # In existential type system, Option<T> is just type_constants$TYPE_OPTION - we can't verify
    # the inner type statically. The field access will be validated at MIR lowering
    # when the actual struct layout is known.
    var sn_base_type = typecheck::tc_base_kind(tc, object_type)
    if sn_base_type != type_constants::TYPE_OPTION
      error("Safe navigation (?.) requires an Option type", line, col)
      result = type_constants::TYPE_ERROR
    else
      # Validate field name against inner struct type when recoverable from annotation
      var sn_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, object_node)
      if str_byte_len(sn_ann) > 7 and sn_ann.starts_with("Option<")
        var sn_inner = str_byte_slice(sn_ann, 7, str_byte_len(sn_ann) - 1)
        # Strip generic args from inner type: "User<Int>" -> "User"
        var sn_lt = __char_index(sn_inner, '<')
        if sn_lt > 0
          sn_inner = str_byte_slice(sn_inner, 0, sn_lt)
        end
        var sn_result = typecheck_registry::tc_lookup_struct(tc, sn_inner)
        if sn_result.is_found()
          var sn_idx = sn_result.unwrap()
          var sn_field_ann = typecheck::tc_struct_field_annotation(tc, sn_idx, field_name)
          if str_byte_len(sn_field_ann) == 0
            error("Unknown field '#{field_name}' on struct '#{sn_inner}' in safe navigation", line, col)
            result = type_constants::TYPE_ERROR
          else
            result = type_constants::TYPE_OPTION
          end
        else
          result = type_constants::TYPE_OPTION
        end
      else
        result = type_constants::TYPE_OPTION
      end
    end
  
  # Interpolated string
  elsif node_kind == node_constants::NODE_INTERP_STRING
    var parts = ast::ast_get_children(ast_storage, node)
    if parts > 0
      var part_count = parts.size
      var ip = 0
      while ip < part_count
        var ipart = parts[ip]
        var ipart_type = tc_expr(tc, ast_storage, ipart)
        # QZ0211: parser wraps each `#{expr}` in `to_str(expr)`.
        # Without this guard, `#{opt}` formats the heap-box pointer.
        # Detect the parser-emitted `to_str(inner)` wrap and reject
        # Option<T> / Result<T,E> inners — runtime sees only an i64,
        # so the box address gets printed as a 13-15 digit decimal.
        if ipart >= 0 and ast::ast_get_kind(ast_storage, ipart) == node_constants::NODE_CALL
          var ip_callee = ast::ast_get_left(ast_storage, ipart)
          if ip_callee >= 0 and ast::ast_get_kind(ast_storage, ip_callee) == node_constants::NODE_IDENT and ast::ast_get_str1(ast_storage, ip_callee) == "to_str"
            var ip_args = ast::ast_get_children(ast_storage, ipart)
            if ip_args != 0 and ip_args.size == 1
              var ip_inner = ip_args[0]
              var ip_inner_type = tc_expr(tc, ast_storage, ip_inner)
              var ip_base = typecheck::tc_base_kind(tc, ip_inner_type)
              if ip_base == type_constants::TYPE_OPTION
                var ip_full = typecheck::tc_type_name_full(tc, ip_inner_type)
                error("QZ0211: Cannot interpolate #{ip_full} directly — runtime would print the heap-box address. Unwrap with `.unwrap_or(default)`, pattern-match (`match opt; Some(v) => ...; None => ...; end`), or test with `.is_some?`/`is None`.", line, col)
              elsif ip_base == type_constants::TYPE_RESULT
                var ip_full2 = typecheck::tc_type_name_full(tc, ip_inner_type)
                error("QZ0211: Cannot interpolate #{ip_full2} directly — runtime would print the heap-box address. Unwrap with `.unwrap_or(default)`, pattern-match (`match res; Ok(v) => ...; Err(e) => ...; end`), or test with `.is_ok?`/`is Err`.", line, col)
              end
            end
          end
        end
        ip += 1
      end
    end
    result = type_constants::TYPE_STRING
  
  # Alloc expression: @heap expr or @arena_name expr
  elsif node_kind == 20  # node_constants$NODE_ALLOC_EXPR (C-aligned)
    var expr_node = ast::ast_get_left(ast_storage, node)
    var expr_type = tc_expr(tc, ast_storage, expr_node)
    
    # Result type is the same as the allocated expression's type
    # (arrays stay arrays, structs stay structs - we return a handle/pointer at runtime)
    result = expr_type
  
  # With-block as expression (Piezo C.1 + C.2): `with H do -> body end`.
  # C.2 inspects H's syntactic shape — a bare PascalCase NODE_IDENT
  # matching a registered effect decl is treated as an "effect claim"
  # and pushed onto the handler-effect stack for the duration of the
  # body's typecheck. tc_expr_call subsumption consults this stack to
  # allow callees whose rows include the handled effect even when the
  # enclosing function's `can` row does not. QZ0613 fires when the
  # handler looks like an effect claim but references no registered
  # effect decl. Non-claim handlers (lowercase idents, calls, literals)
  # are typechecked normally and do not narrow.
  elsif node_kind == node_constants::NODE_WITH
    var with_handler_node = ast::ast_get_left(ast_storage, node)
    var with_body_node = ast::ast_get_right(ast_storage, node)
    # B.8 Phase 3: bound-param NODE_PARAM handle (-1 = no binding).
    var with_bound = ast::ast_with_bound_param(ast_storage, node)
    var _with_claim = 0
    var _with_scope_pushed = 0
    if with_handler_node >= 0
      # B.8 Phase 4a: bound-param forms are unambiguously Scoped — skip
      # the effect-claim dispatcher entirely (which fires QZ0613 on any
      # PascalCase handler name not registered as an effect, including
      # `m.lock` shapes that parser-squashed into NODE_CALL+`Mutex$lock`).
      if with_bound != -1
        var _with_ht = tc_expr(tc, ast_storage, with_handler_node)
        typecheck_util::tc_enter_scope()
        _with_scope_pushed = 1
        tc_with_scoped_bind(tc, ast_storage, node, with_handler_node, _with_ht, with_bound, line, col)
      else
        _with_claim = tc_with_handler_begin(tc, ast_storage, with_handler_node, line, col)
        if _with_claim == 0
          tc_expr(tc, ast_storage, with_handler_node)
        end
      end
    end
    if with_body_node >= 0
      result = tc_expr(tc, ast_storage, with_body_node)
    else
      result = type_constants::TYPE_VOID
    end
    if _with_scope_pushed == 1
      typecheck::tc_exit_scope(tc)
    end
    tc_with_handler_end(tc, _with_claim)

  # Block as expression - type check all statements and return type of last
  elsif node_kind == node_constants::NODE_BLOCK
    typecheck_util::tc_enter_scope()
    var stmts = ast::ast_get_children(ast_storage, node)
    var count = stmts.size
    var last_type = type_constants::TYPE_VOID
    var i = 0
    while i < count
      var stmt = stmts[i]
      if i == count - 1
        # Last statement: extract type WITHOUT double-evaluating
        var stmt_kind = ast::ast_get_kind(ast_storage, stmt)
        if stmt_kind == node_constants::NODE_EXPR_STMT
          # Process via tc_expr on inner to get type (skip tc_stmt to avoid double-eval)
          var inner_expr = ast::ast_get_left(ast_storage, stmt)
          if inner_expr >= 0
            last_type = tc_expr(tc, ast_storage, inner_expr)
          end
        elsif stmt_kind == node_constants::NODE_RETURN
          tc_stmt(tc, ast_storage, stmt)
          last_type = type_constants::TYPE_NEVER
        elsif stmt_kind == node_constants::NODE_IF
          # Process if-expression through tc_expr to get actual branch type
          last_type = tc_expr(tc, ast_storage, stmt)
        elsif stmt_kind == node_constants::NODE_MATCH
          # Process match-expression through tc_expr to get actual arm type
          last_type = tc_expr(tc, ast_storage, stmt)
        elsif stmt_kind == node_constants::NODE_WHILE
          # Process loop-expression through tc_expr to get break value type
          last_type = tc_expr(tc, ast_storage, stmt)
        else
          # Bare expression or statement — process and extract type
          tc_stmt(tc, ast_storage, stmt)
          last_type = tc_expr(tc, ast_storage, stmt)
        end
      else
        tc_stmt(tc, ast_storage, stmt)
      end
      i += 1
    end
    typecheck::tc_exit_scope(tc)
    result = last_type
  
  # Loop/while as expression — type from break VALUE expressions.
  # Returns TYPE_VOID for regular loops, the break value type for loop-as-expression.
  elsif node_kind == node_constants::NODE_WHILE
    var wh_body = ast::ast_get_right(ast_storage, node)
    result = typecheck_expr_handlers::tc_find_break_value_type(tc, ast_storage, wh_body)

  elsif node_kind == node_constants::NODE_RETURN
    # Return statements in expression context (e.g. match arm bodies)
    # Type as Never (bottom type) since they diverge.
    # Full return type validation happens in tc_stmt.
    var value_node = ast::ast_get_left(ast_storage, node)
    if value_node >= 0
      tc_expr(tc, ast_storage, value_node)
      # SURF.FLOW Phase 2 soundness — `return narrowed_opt` into an Option/Result
      # return slot must not payload-extract; retract the stamp post-walk.
      tc_unstamp_narrowed_into_wide(tc, ast_storage, value_node, typecheck_util::tc_narrow_expect_base_of_type(tc, typecheck_util::tc_get_return_type(tc)))
    end
    result = type_constants::TYPE_NEVER
  
  # yield expr — generator suspend point
  elsif node_kind == node_constants::NODE_YIELD
    var value_node = ast::ast_get_left(ast_storage, node)
    if value_node >= 0
      tc_expr(tc, ast_storage, value_node)
    end
    # 4.B.2: `yield` is valid if Yield is in scope via any of the three
    # channels enumerated in `_tc_p4b_yield_in_scope`. The QZ0170 message
    # remains until 4.B.7 unifies this with the standard QZ0611 effect-op
    # resolution path.
    if not _tc_p4b_yield_in_scope(tc)
      error("QZ0170: 'yield' can only be used inside a generator function (return type must be 'impl Iterator<T>' or 'impl AsyncIterator<T>') or a function declaring `can Yield`", line, col)
    end
    result = type_constants::TYPE_VOID

  # async func(args) — creates Future<T>
  elsif node_kind == node_constants::NODE_ASYNC_CALL
    var inner = ast::ast_get_left(ast_storage, node)
    if inner >= 0
      var inner_kind = ast::ast_get_kind(ast_storage, inner)
      if inner_kind != node_constants::NODE_CALL
        error("QZ0173: 'async' must be followed by a function call", line, col)
      end
      tc_expr(tc, ast_storage, inner)
    else
      error("QZ0173: 'async' must be followed by a function call", line, col)
    end
    result = type_constants::TYPE_INT

  # go func(args) — spawn lightweight task on M:N scheduler
  elsif node_kind == node_constants::NODE_GO
    var inner = ast::ast_get_left(ast_storage, node)
    if inner >= 0
      var inner_kind = ast::ast_get_kind(ast_storage, inner)
      if inner_kind != node_constants::NODE_CALL
        error("QZ0174: 'go' must be followed by a function call", line, col)
      end
      tc_expr(tc, ast_storage, inner)
      # T3.2: Enforce Send/Sync safety on go calls with lambda/closure callees
      if inner_kind == node_constants::NODE_CALL
        var callee = ast::ast_get_left(ast_storage, inner)
        if callee >= 0
          var callee_kind = ast::ast_get_kind(ast_storage, callee)
          if callee_kind == node_constants::NODE_LAMBDA
            with Diag {
              error: typecheck_diag::tc_diag_error_handler
            } do ->
              typecheck_concurrency::tc_check_spawn_safety(tc, ast_storage, callee, line, col)
            end
          elsif callee_kind == node_constants::NODE_IDENT
            var callee_name = ast::ast_get_str1(ast_storage, callee)
            var callee_type = typecheck_util::tc_scope_lookup(tc, callee_name)
            # If callee resolves to a local binding (not TYPE_ERROR), it's a
            # closure or function variable — reject with QZ1302.
            # Named top-level functions aren't in scope, so they return TYPE_ERROR.
            if callee_type != type_constants::TYPE_ERROR
              with Diag {
                error: typecheck_diag::tc_diag_error_handler
              } do ->
                typecheck_concurrency::tc_error_go_closure(callee_name, line, col)
              end
            else
              # A.5c Phase 2 (QZ1409, 2026-05-02): named top-level callee.
              # Args evaluate in the caller's thread; their results cross
              # the worker boundary at spawn. Each must be Send.
              with Diag {
                error: typecheck_diag::tc_diag_error_handler
              } do ->
                typecheck_concurrency::tc_check_go_args_send(tc, ast_storage, inner, line, col)
              end
            end
          end
        end
      end
    else
      error("QZ0174: 'go' must be followed by a function call", line, col)
    end
    result = type_constants::TYPE_INT

  # await handle — wait for task completion, returns T from Task<T>
  elsif node_kind == node_constants::NODE_AWAIT
    var handle_node = ast::ast_get_left(ast_storage, node)
    var task_type = type_constants::TYPE_INT
    if handle_node >= 0
      task_type = tc_expr(tc, ast_storage, handle_node)
    end
    result = typecheck_concurrency::tc_check_await(tc, task_type, 0, 0)

    # Record that this function depends on the `Async` effect. Mirrors
    # the op-call row-widening path in `tc_call_expr_handler`: callers
    # with an explicit `can` row get widened (subsume extends an open
    # tail; closed rows absorb Async silently since the default handler
    # installed by P3.B covers it like Throws/Log). Callers with no row
    # are left alone — Async's default handler handles them at runtime.
    var _await_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
    if _await_caller_idx >= 0
      var _await_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _await_caller_idx)
      if _await_caller_row >= 0
        var _await_async_intern = string_intern::intern_id(tc.interner, "Async")
        var _await_labels = vec_new()
        _await_labels.push(_await_async_intern)
        var _await_synth_row = typecheck_registry::tc_row_new(tc, _await_labels, -1)
        typecheck_registry::tc_row_subsume(tc, _await_caller_row, _await_synth_row)
      end
    end

  # select { case <pat> = <Selectable> => body ... default => body }
  # — C.13 Phase 3+4a: dispatch via the Selectable trait. Op-kind=5
  # arms (user-defined Selectables) get the trait-impl lookup + struct
  # name stamp here. Op-kind=0/1/3/4 (Phase 2 parser de-sugar fast-paths)
  # walk children for resolver/capture coverage and bind their patterns
  # but do not consult the trait registry. Default arm (op_kind=2) just
  # walks the body.
  elsif node_kind == node_constants::NODE_SELECT
    var sel_arms = ast::ast_get_children(ast_storage, node)
    if sel_arms != 0
      var sa_count = sel_arms.size
      for sa_i in 0..sa_count
        var sa_arm = sel_arms[sa_i]
        var sa_op = ast::ast_get_op(ast_storage, sa_arm)
        var sa_left = ast::ast_get_left(ast_storage, sa_arm)
        var sa_body = ast::ast_get_right(ast_storage, sa_arm)
        var sa_binding = ast::ast_get_str1(ast_storage, sa_arm)
        var sa_line = ast::ast_get_line(ast_storage, sa_arm)
        var sa_col = ast::ast_get_col(ast_storage, sa_arm)

        typecheck_util::tc_enter_scope()

        if sa_op == 5
          # User-defined Selectable: typecheck the expression, resolve
          # its struct name, look up the impl, stamp the struct name on
          # the arm. Bind the pattern with R erased to Int (per the R
          # erasure note in std/selectable.qz; mirrors Scoped<R>).
          var sa_sel_type = type_constants::TYPE_VOID
          if sa_left >= 0
            sa_sel_type = tc_expr(tc, ast_storage, sa_left)
          end
          var sa_struct_name = ""
          if typecheck::tc_is_ptype(sa_sel_type)
            var sa_base = typecheck::tc_base_kind(tc, sa_sel_type)
            if sa_base == type_constants::TYPE_STRUCT
              sa_struct_name = typecheck::tc_ptype_name(tc, sa_sel_type)
            end
          end
          if str_byte_len(sa_struct_name) == 0 and typecheck::tc_is_struct_type(sa_sel_type)
            var sl_kind = ast::ast_get_kind(ast_storage, sa_left)
            if sl_kind == node_constants::NODE_IDENT
              var sl_name = ast::ast_get_str1(ast_storage, sa_left)
              sa_struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, sl_name)
            elsif sl_kind == node_constants::NODE_STRUCT_INIT
              sa_struct_name = ast::ast_get_str1(ast_storage, sa_left)
            elsif sl_kind == node_constants::NODE_CALL
              # Most common shape: `recvable(ch)`. Resolve the callee's
              # registered return-type annotation (e.g. "RecvSelectable").
              var sl_callee = ast::ast_get_left(ast_storage, sa_left)
              if sl_callee >= 0
                var sl_callee_kind = ast::ast_get_kind(ast_storage, sl_callee)
                if sl_callee_kind == node_constants::NODE_IDENT
                  var sl_fn_name = ast::ast_get_str1(ast_storage, sl_callee)
                  sa_struct_name = typecheck_registry::tc_lookup_function_return_annotation(tc, sl_fn_name)
                end
              end
            end
          end
          if str_byte_len(sa_struct_name) == 0
            error("QZ0626: select case expression must be a value of a struct type that implements `Selectable`; got non-struct value", sa_line, sa_col)
          else
            # Strip generics ("RecvSelectable<Int>" → "RecvSelectable")
            # so the impl lookup matches `extend RecvSelectable with
            # Selectable<Int>`-style registrations.
            var sn_lt_idx = __char_index(sa_struct_name, '<')
            if sn_lt_idx > 0
              sa_struct_name = str_byte_slice(sa_struct_name, 0, sn_lt_idx)
            end
            var sa_impl = typecheck_registry::tc_lookup_impl(tc, "Selectable", sa_struct_name)
            if sa_impl < 0
              error("QZ0626: `#{sa_struct_name}` does not implement `Selectable`; cannot use it in a `case` arm", sa_line, sa_col)
            else
              ast::ast_select_arm_set_struct(ast_storage, sa_arm, sa_struct_name)
              if str_byte_len(sa_binding) > 0
                typecheck_util::tc_scope_bind(tc, sa_binding, type_constants::TYPE_INT, 0, "")
              end
            end
          end
        elsif sa_op == 0
          # Legacy recv(ch) — walk channel expression for resolver/capture
          # coverage; bind recv's payload as Int (channel element erased).
          if sa_left >= 0
            tc_expr(tc, ast_storage, sa_left)
          end
          if str_byte_len(sa_binding) > 0
            typecheck_util::tc_scope_bind(tc, sa_binding, type_constants::TYPE_INT, 0, "")
          end
        elsif sa_op == 1
          # Legacy send(ch, payload) — walk both subexpressions.
          if sa_left >= 0
            tc_expr(tc, ast_storage, sa_left)
          end
          var sa_send_payload = ast::ast_get_extra(ast_storage, sa_arm)
          if sa_send_payload > 0
            tc_expr(tc, ast_storage, sa_send_payload)
          end
        elsif sa_op == 3
          # Legacy await — walk handle, bind to Int.
          if sa_left >= 0
            tc_expr(tc, ast_storage, sa_left)
          end
          if str_byte_len(sa_binding) > 0
            typecheck_util::tc_scope_bind(tc, sa_binding, type_constants::TYPE_INT, 0, "")
          end
        elsif sa_op == 4
          # Legacy timeout(ms) — walk ms expression.
          if sa_left >= 0
            tc_expr(tc, ast_storage, sa_left)
          end
        end
        # All arm shapes (including default, op_kind=2) walk the body.
        if sa_body >= 0
          tc_expr(tc, ast_storage, sa_body)
        end
        typecheck::tc_exit_scope(tc)
      end
    end
    result = type_constants::TYPE_VOID

  # task_group |g| ... end — structured concurrency block
  elsif node_kind == node_constants::NODE_TASK_GROUP
    var binding_name = ast::ast_get_str1(ast_storage, node)
    typecheck_util::tc_enter_scope()
    typecheck_util::tc_scope_bind(tc, binding_name, type_constants::TYPE_TASK_GROUP, 0, "")
    var body = ast::ast_get_left(ast_storage, node)
    var last_type = type_constants::TYPE_VOID
    if body >= 0
      var body_kind = ast::ast_get_kind(ast_storage, body)
      if body_kind == node_constants::NODE_BLOCK
        var block_children = ast::ast_get_children(ast_storage, body)
        var child_count = block_children.size
        for i in 0..child_count
          var child = block_children[i]
          if i == child_count - 1
            var child_kind = ast::ast_get_kind(ast_storage, child)
            if child_kind == node_constants::NODE_EXPR_STMT
              var inner = ast::ast_get_left(ast_storage, child)
              last_type = tc_expr(tc, ast_storage, inner)
            else
              tc_stmt(tc, ast_storage, child)
            end
          else
            tc_stmt(tc, ast_storage, child)
          end
        end
      else
        last_type = tc_expr(tc, ast_storage, body)
      end
    end
    typecheck::tc_exit_scope(tc)
    result = last_type

  # expr is VariantName — boolean pattern check
  elsif node_kind == node_constants::NODE_IS_CHECK
    var subject = ast::ast_get_left(ast_storage, node)
    if subject >= 0
      tc_expr(tc, ast_storage, subject)
    end
    # IS_PREDICATE_CROSS_ENUM_TAG_COLLISION: validate that the named variant
    # belongs to the subject's static enum. Without this, MIR lower searches
    # the global enum registry for any enum carrying a variant by that name,
    # which silently picks the wrong enum when two enums share a variant
    # name — comparing tag values across unrelated enums (and SIGSEGV-ing
    # when the registries disagree on payload shape, sister bug
    # `is_none_non_option_segfault`).
    var ic_variant_name = ast::ast_get_str1(ast_storage, node)
    if subject >= 0 and str_byte_len(ic_variant_name) > 0
      # Recover the subject's enum name. For NODE_IDENT subjects with a
      # struct/generic-enum type the binding carries struct_name; for bare
      # TYPE_ENUM let-bindings the let-handler stores the user's annotation
      # in type_ann instead. Consult both so `var c: Cmd = Cmd::Wait` (bare
      # enum) and `var c: Cmd<Int> = Cmd::Run(...)` (generic enum ptype)
      # both resolve. Other subject shapes (field access, calls, tuple `.N`)
      # don't currently feed enum identity into scope — fall through to the
      # legacy registry-wide lookup so we don't regress those callers.
      var ic_enum_name = ""
      if ast::ast_get_kind(ast_storage, subject) == node_constants::NODE_IDENT
        var ic_subject_name = ast::ast_get_str1(ast_storage, subject)
        ic_enum_name = typecheck_util::tc_scope_lookup_struct_name(tc, ic_subject_name)
        if str_byte_len(ic_enum_name) == 0
          ic_enum_name = typecheck_util::tc_scope_lookup_annotation(tc, ic_subject_name)
        end
      end
      if str_byte_len(ic_enum_name) > 0
        # Strip generic args ("Cmd<M>" → "Cmd") for registry lookup.
        var ic_lt_pos = __char_index(ic_enum_name, '<')
        if ic_lt_pos > 0
          ic_enum_name = str_byte_slice(ic_enum_name, 0, ic_lt_pos)
        end
        var ic_enum_lookup = typecheck_registry::tc_lookup_enum(tc, ic_enum_name)
        var ic_enum_idx = match ic_enum_lookup
          Found(v) => v
          NotFound => -1
        end
        if ic_enum_idx >= 0
          if typecheck_registry::tc_enum_has_variant(tc, ic_enum_idx, ic_variant_name) == 0
            error("QZ0231: '#{ic_variant_name}' is not a variant of enum '#{ic_enum_name}'. The `is` predicate must name a variant of the subject's static enum type. If you meant a variant of a different enum, use a `match` arm with the qualified name instead.", line, col)
          end
        end
      end
    end
    result = type_constants::TYPE_BOOL

  else
    # Unknown node type
    result = type_constants::TYPE_VOID
  end

  result
  end  # close 5.1.C body-wrap
end

# ============================================================================
# Statement Type Checking - Main Walker
# ============================================================================

## Check if a type is a simple primitive suitable for annotation cross-checking.

## B.15d/N3.1 step-4 — item 5a: array/vector-element structural audit.
## NODE_ARRAY has no top-down expected element type (element types are inferred
## bottom-up), so the audit fires only at a TYPED BOUNDARY where a Vec<BoxedElem>
## slot meets a NODE_ARRAY literal — the caller supplies `declared_elem_type`.
## For each element whose tc_expr resolves to bare TYPE_INT flowing into a
## forbidden boxed element slot (and not an explicit Int|Nil union), emit the
## warn-only structural QZ0215. The whole loop is guarded by the caller so the
## extra tc_expr work only runs when the audit can actually fire.
def tc_n3_audit_array_elems(tc: TypecheckState, ast_storage: ast::AstStorage, array_node: AstNodeId, declared_elem_type: Int, slot_name: String, line: Int, col: Int): Void can Diag
  return if typecheck_helpers::tc_n3_wall_warn_enabled() == false
  return if typecheck_helpers::tc_n3_file_exempt(tc)
  return if typecheck_helpers::tc_nil_forbidden_type(tc, declared_elem_type) == 0
  return if typecheck_registry::tc_union_contains_nil(tc, declared_elem_type) == 1
  var elems = ast::ast_get_children(ast_storage, array_node)
  return if elems == 0
  var n = vec_size(elems)
  for ai in 0..n
    var elem = elems[ai]
    if tc_expr(tc, ast_storage, elem) == type_constants::TYPE_INT
      typecheck_helpers::tc_n3_wall_emit_struct_int_into_boxed(tc, slot_name, line, col)
    end
  end
end

## Type check a statement node.
## Handles ALL statement node types with full error checking.
##
## Wrapper: snapshots the temporary-borrow list on entry and releases any temp
## (argument-position) borrows created while checking this statement on exit, so
## `&mut`/`&` passed to a call (e.g. `inc(&mut c)`) does not leak a persistent
## borrow that later trips QZ1205/QZ1206/QZ1209/QZ1212. The snapshot makes this
## correct under statement nesting (each nested tc_stmt releases only its own
## range). See tc_temp_borrow_release_from in typecheck_util.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Statement node handle
def tc_stmt(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  var _tb_start = typecheck_util::tc_temp_borrow_count()
  _tc_stmt_body(tc, ast_storage, node)
  typecheck_util::tc_temp_borrow_release_from(tc, _tb_start)
end

## SURF.FLOW Phase 3 — RAW guard extractor. Reads the RAW (pre-typecheck) `if`
## condition and identifies a single-variant guard on a bare-identifier subject,
## generalized from Option-only to Option + Result + arbitrary user enums. Writes
## three results into `out` (a 4-slot Vec, indices stored as i64):
##   out[0] = subject NODE_IDENT handle, or -1 if not a recognized guard
##   out[1] = THEN-branch proven variant NAME (interned String as i64), "" if none
##   out[2] = ELSE-branch proven variant NAME (binary enums only), "" if none
##   out[3] = enum base hint: TYPE_OPTION / TYPE_RESULT / -1 (user `is Variant`)
## The variant names are resolved against the subject's static enum type. Recognized
## RAW shapes (the condition is read BEFORE tc_expr mutates it in place):
##   `x.some?`/`x.none?`/`x.ok?`/`x.err?`  → NODE_FIELD_ACCESS(ident, "<pred>?")
##   `x.is_some()`/.is_none()/.is_ok()/.is_err() → NODE_CALL(NODE_FIELD_ACCESS(ident,"is_*"))
##   `x is Variant`                         → NODE_IS_CHECK(ident, "Variant", no binds)
## Also tolerates already-desugared NODE_CALL(option_is_some|is_some|is_ok|is_err,
## [ident]) and the NODE_BINARY(==0)-wrapped negative form, so it is robust to either
## ordering of typecheck. For a POSITIVE binary guard, then=present-variant /
## else=absent-variant; for a NEGATIVE binary guard the roles swap. A 3+-variant user
## `is Variant` narrows the THEN-branch only (else could be any remaining variant) —
## out[2] is "" for those. Result then-narrows BOTH arms (Err carries an E payload).
## A2 helper — is `n` the bare `None` Option sentinel? Two shapes reach the
## classifier: a NODE_ENUM_ACCESS with variant "None" (once the reference has been
## resolved to an enum access) or a plain NODE_IDENT named "None" (the CST lowers a
## bare `None` expression to `ast_ident("None")`, cst_lower.qz:6608). Either proves
## the RHS is the None constructor. Kept deliberately narrow: only the literal
## spelling "None" — no `Some`, no user variants — so `== None` is the sole
## equality form that partitions an Option Some|None here.
def tc_node_is_none_sentinel(ast_storage: ast::AstStorage, n: AstNodeId): Int
  return 0 if n < 0
  var nk = ast::ast_get_kind(ast_storage, n)
  if nk == node_constants::NODE_ENUM_ACCESS
    return 0 if ast::ast_get_variant(ast_storage, n) != "None"
    # `Option::None` carries enum_name "Option"; a bare/unqualified `None` (if it
    # ever reaches here resolved) carries "". Reject a same-named variant of an
    # unrelated user enum (`MyEnum::None`) — only the Option sentinel narrows.
    var en = ast::ast_get_enum_name(ast_storage, n)
    return 1 if en == "Option" or str_byte_len(en) == 0
    return 0
  end
  if nk == node_constants::NODE_IDENT
    return 1 if ast::ast_get_str1(ast_storage, n) == "None"
    return 0
  end
  return 0
end

## SURF.FLOW B1 — cheap, side-effect-free structural pre-filter for the alias probe.
## Returns 1 only when `init_node` is shaped like a narrowing guard whose SUBJECT is a
## bare IDENT (`x.some?`/`.none?`/`.ok?`/`.err?`, `x.is_some()`/… UFCS, `x is Variant`,
## or a free-fn `is_some(x)`/… call). Everything else (a `.unwrap()` call, a map_get, an
## arithmetic RHS, …) returns 0 so the classifier probe never runs on it. This keeps the
## NODE_LET probe from re-touching arbitrary init expressions, which is both faster and
## avoids any incidental re-resolution the full classifier could trigger on a non-guard
## init. Pure AST-shape inspection — no tc_expr, no state mutation.
def tc_b1_init_is_guard_shaped(ast_storage: ast::AstStorage, init_node: AstNodeId): Bool
  return false if init_node < 0
  var k = ast::ast_get_kind(ast_storage, init_node)
  # `x is Variant`
  if k == node_constants::NODE_IS_CHECK
    var isc_subj = ast::ast_get_left(ast_storage, init_node)
    return false if isc_subj < 0
    return ast::ast_get_kind(ast_storage, isc_subj) == node_constants::NODE_IDENT
  end
  # `x.some?` / `.none?` / `.ok?` / `.err?`  (field-access predicate)
  if k == node_constants::NODE_FIELD_ACCESS
    var fa_subj = ast::ast_get_left(ast_storage, init_node)
    return false if fa_subj < 0
    return false if ast::ast_get_kind(ast_storage, fa_subj) != node_constants::NODE_IDENT
    var fa_field = ast::ast_get_str1(ast_storage, init_node)
    return fa_field == "some?" or fa_field == "none?" or fa_field == "ok?" or fa_field == "err?"
  end
  # `is_some(x)` free-fn OR `x.is_some()` UFCS  (predicate call)
  if k == node_constants::NODE_CALL
    var callee = ast::ast_get_left(ast_storage, init_node)
    return false if callee < 0
    var callee_k = ast::ast_get_kind(ast_storage, callee)
    if callee_k == node_constants::NODE_IDENT
      var cn = ast::ast_get_str1(ast_storage, callee)
      return cn == "option_is_some" or cn == "is_some" or cn == "is_none" or cn == "is_ok" or cn == "is_err"
    elsif callee_k == node_constants::NODE_FIELD_ACCESS
      var uf = ast::ast_get_str1(ast_storage, callee)
      return uf == "is_some" or uf == "is_none" or uf == "is_ok" or uf == "is_err"
    end
    return false
  end
  # `x == None` / `x != None` and desugared `pred(x) == 0` binary predicates
  if k == node_constants::NODE_BINARY
    var bop = ast::ast_get_op(ast_storage, init_node)
    return bop == 7 or bop == 8
  end
  return false
end

def tc_narrow_guard_classify_v3(tc: TypecheckState, ast_storage: ast::AstStorage, cond_node: AstNodeId, out: Vec): Void
  vec_set(out, 0, -1)
  vec_set(out, 1, as_int(""))
  vec_set(out, 2, as_int(""))
  vec_set(out, 3, -1)
  return if cond_node < 0
  var ck = ast::ast_get_kind(ast_storage, cond_node)

  # Resolve a raw `(subject_node, predicate_token)` from the condition. Tokens:
  #   "some"/"none"/"ok"/"err"  (binary Option/Result predicates)
  #   "is:<Variant>"            (arbitrary `x is Variant`)
  var subj = -1
  var token = ""

  # A1 — general negation `not (x is T)` / `!pred`. A logical negation is a
  # NODE_UNARY (node_constants::NODE_UNARY = 7) with op 13 (OpNot) whose operand is
  # the inner condition. The complement of a SOUND guard is sound: classify the inner
  # operand, then SWAP its then/else fact strings (out[1] ⇄ out[2]) while keeping the
  # subject (out[0]) and base (out[3]). THEN-only inner (out[2]="") ⇒ ELSE-only after
  # the swap (out[1]="") — sound, since the negated-true branch can't narrow a 3+-way
  # or union member but the negated-false/else branch narrows to that member. Purely
  # additive: we never invent narrowing the inner classify didn't already produce.
  if ck == node_constants::NODE_UNARY and ast::ast_get_op(ast_storage, cond_node) == 13
    var not_operand = ast::ast_get_left(ast_storage, cond_node)
    return if not_operand < 0
    var inner = vec_new()
    inner.push(-1)
    inner.push(as_int(""))
    inner.push(as_int(""))
    inner.push(-1)
    tc_narrow_guard_classify_v3(tc, ast_storage, not_operand, inner)
    var inner_subj = as_int(inner[0])
    return if inner_subj < 0
    # Swap then ⇄ else (the fact strings are already int-encoded in the inner slots —
    # copy the encoded ints across, swapped); keep subject + base.
    vec_set(out, 0, inner_subj)
    vec_set(out, 1, inner[2])
    vec_set(out, 2, inner[1])
    vec_set(out, 3, inner[3])
    return
  end

  if ck == node_constants::NODE_IS_CHECK
    var ic_bn = ast::ast_get_bound_names(ast_storage, cond_node)
    return if ic_bn > 0
    var ic_variant = ast::ast_get_str1(ast_storage, cond_node)
    var ic_subj = ast::ast_get_left(ast_storage, cond_node)
    return if ic_subj < 0
    # GAP-B2-nonident-narrow — an `is Member` subject may be a bare IDENT (today's
    # path) OR a stable access path (field-access `s.u` / const-index `v[0]`) whose
    # STATIC type is a union. tc_access_path_key returns "" for anything else (a
    # variable-index, a call result, …), so those still bail out unchanged.
    var ic_sk = ast::ast_get_kind(ast_storage, ic_subj)
    if ic_sk != node_constants::NODE_IDENT
      return if str_byte_len(typecheck_util::tc_access_path_key(ast_storage, ic_subj)) == 0
    end
    subj = ic_subj
    token = "is:#{ic_variant}"
  elsif ck == node_constants::NODE_FIELD_ACCESS
    var fa_subj = ast::ast_get_left(ast_storage, cond_node)
    return if fa_subj < 0
    return if ast::ast_get_kind(ast_storage, fa_subj) != node_constants::NODE_IDENT
    var fa_field = ast::ast_get_str1(ast_storage, cond_node)
    if fa_field == "some?"
      subj = fa_subj
      token = "some"
    elsif fa_field == "none?"
      subj = fa_subj
      token = "none"
    elsif fa_field == "ok?"
      subj = fa_subj
      token = "ok"
    elsif fa_field == "err?"
      subj = fa_subj
      token = "err"
    else
      return
    end
  elsif ck == node_constants::NODE_BINARY
    # `none?` / `err?` already desugared to NODE_BINARY(left=<pred>(x), op == 0).
    var bin_op = ast::ast_get_op(ast_storage, cond_node)

    # A2 — equality guard against the `None` sentinel. `x == None` / `None == x`
    # (OP_EQ = 7) and `x != None` / `None != x` (OP_NE = 8). `!=` is a DISTINCT
    # binary op here (OP_NE = 8), NOT `not (==)`, so A1's negation branch does not
    # compose for it — both orders of both ops are handled directly below. A bare
    # `None` lowers to NODE_ENUM_ACCESS with variant "None" (post-resolution) or a
    # NODE_IDENT named "None" (pre-resolution / structural) — accept either shape.
    # The subject side must be an IDENT whose declared type resolves to Option.
    # `== None` ⇒ true-branch is None (token "none": then="", else="Some"); `!= None`
    # ⇒ true-branch is Some (token "some": then="Some", else=""). Both reuse the
    # binary-Option token machinery below (:2865-2876) verbatim — no new variant
    # emit. Sound anywhere: comparing an Option against None partitions it Some|None.
    if bin_op == 7 or bin_op == 8
      var eq_l = ast::ast_get_left(ast_storage, cond_node)
      var eq_r = ast::ast_get_right(ast_storage, cond_node)
      if eq_l >= 0 and eq_r >= 0
        var eq_subj = -1
        if tc_node_is_none_sentinel(ast_storage, eq_r) == 1
          eq_subj = eq_l
        elsif tc_node_is_none_sentinel(ast_storage, eq_l) == 1
          eq_subj = eq_r
        end
        if eq_subj >= 0 and ast::ast_get_kind(ast_storage, eq_subj) == node_constants::NODE_IDENT
          # `== None` true ⇒ None ⇒ token "none"; `!= None` true ⇒ Some ⇒ "some".
          # The base-resolution tail (:2865+) confirms subj's decl is TYPE_OPTION
          # before emitting facts, so a `== None` on a non-Option subject bails.
          subj = eq_subj
          if bin_op == 7
            token = "none"
          else
            token = "some"
          end
        end
      end
    end

    # Fall through to the base resolution when A2 matched a None sentinel; only the
    # desugared `pred(x) == 0` (OP_EQ = 7) shape drives the free-fn predicate path.
    if str_byte_len(token) == 0
      return if bin_op != 7
      var bin_left = ast::ast_get_left(ast_storage, cond_node)
      return if bin_left < 0
      return if ast::ast_get_kind(ast_storage, bin_left) != node_constants::NODE_CALL
      var bl_callee = ast::ast_get_left(ast_storage, bin_left)
      return if bl_callee < 0
      return if ast::ast_get_kind(ast_storage, bl_callee) != node_constants::NODE_IDENT
      var bl_cn = ast::ast_get_str1(ast_storage, bl_callee)
      var bl_children = ast::ast_get_children(ast_storage, bin_left)
      return if bl_children.size != 1
      var bl_arg0 = bl_children[0]
      return if bl_arg0 < 0
      return if ast::ast_get_kind(ast_storage, bl_arg0) != node_constants::NODE_IDENT
      if bl_cn == "option_is_some" or bl_cn == "is_some"
        subj = bl_arg0
        token = "none"
      elsif bl_cn == "is_ok"
        subj = bl_arg0
        token = "err"
      elsif bl_cn == "is_err"
        subj = bl_arg0
        token = "ok"
      else
        return
      end
    end
  elsif ck == node_constants::NODE_CALL
    var callee = ast::ast_get_left(ast_storage, cond_node)
    return if callee < 0
    var callee_k = ast::ast_get_kind(ast_storage, callee)
    if callee_k == node_constants::NODE_IDENT
      var cn = ast::ast_get_str1(ast_storage, callee)
      var children = ast::ast_get_children(ast_storage, cond_node)
      return if children.size != 1
      var arg0 = children[0]
      return if arg0 < 0
      return if ast::ast_get_kind(ast_storage, arg0) != node_constants::NODE_IDENT
      if cn == "option_is_some" or cn == "is_some"
        subj = arg0
        token = "some"
      elsif cn == "is_none"
        subj = arg0
        token = "none"
      elsif cn == "is_ok"
        subj = arg0
        token = "ok"
      elsif cn == "is_err"
        subj = arg0
        token = "err"
      else
        return
      end
    elsif callee_k == node_constants::NODE_FIELD_ACCESS
      var ufcs_field = ast::ast_get_str1(ast_storage, callee)
      var ufcs_subj = ast::ast_get_left(ast_storage, callee)
      return if ufcs_subj < 0
      return if ast::ast_get_kind(ast_storage, ufcs_subj) != node_constants::NODE_IDENT
      if ufcs_field == "is_some"
        subj = ufcs_subj
        token = "some"
      elsif ufcs_field == "is_none"
        subj = ufcs_subj
        token = "none"
      elsif ufcs_field == "is_ok"
        subj = ufcs_subj
        token = "ok"
      elsif ufcs_field == "is_err"
        subj = ufcs_subj
        token = "err"
      else
        return
      end
    else
      return
    end
  elsif ck == node_constants::NODE_IDENT
    # SURF.FLOW B1 — aliased-condition narrowing. `if c` where `c` is a CONST local
    # bound to a narrowing-guard boolean (`c = x.some?`). Resolve `c` -> its stored
    # guard cond-node and recurse the classifier on THAT, so every downstream consumer
    # (then-facts, guard-style else, or-chain else, subject-key derivation) sees exactly
    # what the direct `if x.some?` would have produced. B1 invents no new narrowing — it
    # only reroutes to an existing one. Double const gate (§2.3/§2.4): the alias `c` must
    # be const AND the narrowed subject must be const. One-hop: the recursion runs once
    # on the stored guard; the NODE_LET handler never records an alias whose init is a
    # bare IDENT, so `c = d; if c` cannot chain (loop-safe by construction).
    var b1_alias_name = ast::ast_get_str1(ast_storage, cond_node)
    return if str_byte_len(b1_alias_name) == 0
    # Gate 1 (redundant with the record-time const check, but guards a same-spelled
    # `var` rebound in an inner scope): the alias binding must be const.
    return if typecheck_util::tc_scope_lookup_mutable(tc, b1_alias_name) != 0
    var b1_guard_node = typecheck_util::tc_alias_guard_lookup(tc, b1_alias_name)
    return if b1_guard_node < 0
    # Recurse on the stored guard cond-node; fills `out` in place.
    tc_narrow_guard_classify_v3(tc, ast_storage, b1_guard_node, out)
    var b1_subj = as_int(out[0])
    return if b1_subj < 0
    # Gate 2 (§2.4 subject stability): only narrow through the alias when the narrowed
    # subject is a CONST binding. A var subject could be reassigned to a different
    # variant between the alias bind and the use while `c` stays true → unsound. A var
    # subject refuses the alias narrowing (user falls back to `if x.some?` directly,
    # which re-runs the subject's live var-invalidation). Reset `out` to the no-narrow
    # sentinel on refusal so no stale fact leaks to the caller.
    if ast::ast_get_kind(ast_storage, b1_subj) == node_constants::NODE_IDENT
      var b1_subj_name = ast::ast_get_str1(ast_storage, b1_subj)
      if typecheck_util::tc_scope_lookup_mutable(tc, b1_subj_name) != 0
        vec_set(out, 0, -1)
        vec_set(out, 1, as_int(""))
        vec_set(out, 2, as_int(""))
        vec_set(out, 3, -1)
        return
      end
    end
    return
  else
    return
  end

  return if subj < 0 or str_byte_len(token) == 0

  # Resolve then/else variant names from the token + the subject's enum type.
  # GAP-B2-nonident-narrow — for a bare IDENT the declared type comes from the
  # binding table (today's path); for a field-access / const-index subject it comes
  # from the subject expression's static type. A non-ident subject is ONLY narrowable
  # for the union `is Member` case (below), so its decl must be a union type — any
  # other decl bails out (base stays TYPE_ERROR ⇒ the Option/Result/enum arms skip).
  var subj_kind = ast::ast_get_kind(ast_storage, subj)
  var decl = type_constants::TYPE_ERROR
  if subj_kind == node_constants::NODE_IDENT
    var subj_name = ast::ast_get_str1(ast_storage, subj)
    var bidx = typecheck_util::tc_lookup_binding_index(tc, subj_name)
    return if bidx < 0
    decl = tc.scope.binding_types[bidx]
  else
    decl = tc_expr(tc, ast_storage, subj)
    return if not typecheck_registry::tc_is_union_type(decl)
  end
  var base = typecheck_util::tc_narrow_decl_base(tc, decl)

  if token == "some"
    return if base != type_constants::TYPE_OPTION
    vec_set(out, 0, subj)
    vec_set(out, 1, as_int("Some"))
    vec_set(out, 2, as_int(""))      # None has no payload — no else-narrow
    vec_set(out, 3, type_constants::TYPE_OPTION)
  elsif token == "none"
    return if base != type_constants::TYPE_OPTION
    vec_set(out, 0, subj)
    vec_set(out, 1, as_int(""))      # then ⇒ None, no payload
    vec_set(out, 2, as_int("Some"))  # else ⇒ Some (binary enum)
    vec_set(out, 3, type_constants::TYPE_OPTION)
  elsif token == "ok"
    return if base != type_constants::TYPE_RESULT
    vec_set(out, 0, subj)
    vec_set(out, 1, as_int("Ok"))
    vec_set(out, 2, as_int("Err"))   # binary enum: else ⇒ Err (E payload)
    vec_set(out, 3, type_constants::TYPE_RESULT)
  elsif token == "err"
    return if base != type_constants::TYPE_RESULT
    vec_set(out, 0, subj)
    vec_set(out, 1, as_int("Err"))   # then ⇒ Err (E payload IS readable)
    vec_set(out, 2, as_int("Ok"))    # else ⇒ Ok (T payload)
    vec_set(out, 3, type_constants::TYPE_RESULT)
  elsif str_starts_with(token, "is:")
    var variant = str_byte_slice(token, 3, str_byte_len(token))
    # R2.1 (B2) — union `x is Member` narrowing. A union value is the runtime
    # tagged `{tag@0, payload@1}` cell (B1); `is Member` proves the tag and the
    # THEN branch reads the member. Structural (arm-string), not nominal, so it
    # resolves the arm by matching the trimmed member spelling — no enum registry.
    # THEN-only (out[2]="") for soundness parity with 3+-variant enums: a 2-member
    # union must not else-narrow through this leaf. Keyed on tc_is_union_type ⇒
    # the compiler's own sources use no union `is`-guard ⇒ gate-0-inert.
    if typecheck_registry::tc_is_union_type(decl)
      var u_members = typecheck_registry::tc_union_members(tc, decl)
      var u_matched = 0
      for _um in 0..u_members.size
        if str_trim(u_members[_um]) == str_trim(variant)
          u_matched = 1
        end
      end
      if u_matched == 1
        vec_set(out, 0, subj)
        vec_set(out, 1, as_int(variant))
        vec_set(out, 2, as_int(""))
        vec_set(out, 3, -1)
      end
      return
    end
    # Built-in Option/Result via `is Variant` reuse the binary-enum paths above.
    if base == type_constants::TYPE_OPTION
      if variant == "Some"
        vec_set(out, 0, subj)
        vec_set(out, 1, as_int("Some"))
        vec_set(out, 2, as_int(""))
        vec_set(out, 3, type_constants::TYPE_OPTION)
      elsif variant == "None"
        vec_set(out, 0, subj)
        vec_set(out, 1, as_int(""))
        vec_set(out, 2, as_int("Some"))
        vec_set(out, 3, type_constants::TYPE_OPTION)
      end
      return
    elsif base == type_constants::TYPE_RESULT
      if variant == "Ok"
        vec_set(out, 0, subj)
        vec_set(out, 1, as_int("Ok"))
        vec_set(out, 2, as_int("Err"))
        vec_set(out, 3, type_constants::TYPE_RESULT)
      elsif variant == "Err"
        vec_set(out, 0, subj)
        vec_set(out, 1, as_int("Err"))
        vec_set(out, 2, as_int("Ok"))
        vec_set(out, 3, type_constants::TYPE_RESULT)
      end
      return
    end
    # Arbitrary user enum: resolve the enum from the binding's struct_name, confirm
    # the variant exists, and decide else-narrow by variant count (binary ⇒ else
    # narrows to the OTHER variant; 3+ ⇒ THEN-only, sound per FLOW_NARROWING §3.3).
    # Enum narrowing is IDENT-only (non-ident subjects bailed at the union check
    # above), so the binding name is the subject ident's spelling.
    var enum_subj_name = ast::ast_get_str1(ast_storage, subj)
    var enum_name = typecheck_util::tc_scope_lookup_struct_name(tc, enum_subj_name)
    return if str_byte_len(enum_name) == 0
    var enum_lr = typecheck_registry::tc_lookup_enum(tc, enum_name)
    var enum_idx = match enum_lr
      Found(v) => v
      NotFound => -1
    end
    return if enum_idx < 0
    return if typecheck_registry::tc_enum_has_variant(tc, enum_idx, variant) == 0
    vec_set(out, 0, subj)
    vec_set(out, 1, as_int(variant))
    vec_set(out, 3, -1)
    # Else-narrow ONLY when the enum is binary (exactly 2 variants).
    var vcount = typecheck_registry::tc_enum_variant_count(tc, enum_idx)
    if vcount == 2
      var vnames = typecheck_registry::tc_enum_variant_names(tc, enum_idx)
      var other = ""
      for _vi in 0..vnames.size
        if vnames[_vi] != variant
          other = vnames[_vi]
        end
      end
      vec_set(out, 2, as_int(other))
    else
      vec_set(out, 2, as_int(""))
    end
  end
end

## SURF.FLOW Phase 3 — narrow the named binding `name` to the SINGLE payload of the
## named `variant` (inner type), at scope depth `narrow_depth`, IF the binding is a
## sound subject. Generalized from Option-`Some`-only to ANY enum variant that has
## exactly one payload field:
##   - Option<T>.Some  → T
##   - Result<T,E>.Ok  → T ; Result<T,E>.Err → E
##   - user enum variant with 1 payload → resolved via tc_resolve_variant_type
## A 0-payload variant (None / dataless user variant) is NOT narrowed (nothing to
## read) → returns 0. A multi-payload variant is NOT narrowed (a bare read can't be
## one of several payloads) → returns 0. The subject may be const OR var (var
## protected by invalidate-on-reassign + closure-barrier). The narrow side-table is
## variant-agnostic at READ time (only inner_type matters for the type), but we store
## `variant_idx` for completeness. Returns 1 if a refinement was pushed, else 0.
def tc_try_narrow_variant(tc: TypecheckState, ast_storage: ast::AstStorage, name: String, variant: String, narrow_depth: Int): Int
  return tc_try_narrow_variant_keyed(tc, ast_storage, name, -1, variant, narrow_depth)
end

## GAP-B2-nonident-narrow — access-path-keyed variant narrowing. `key` is the
## stable narrowing key (tc_access_path_key); `subj_node` is the subject AST node
## (-1 for the legacy bare-name caller). For a bare IDENT subject the decl type is
## resolved from the binding table by `key` (== the name) — byte-identical to the
## pre-GAP path. For a NON-ident subject (field-access / const-index) we resolve
## the decl from the subject expression's static type and support ONLY the union
## member case (the only narrowing that carries a self-describing runtime tag cell);
## a non-ident Option/Result/enum subject is not narrowed here (returns 0).
def tc_try_narrow_variant_keyed(tc: TypecheckState, ast_storage: ast::AstStorage, key: String, subj_node: AstNodeId, variant: String, narrow_depth: Int): Int
  return 0 if str_byte_len(variant) == 0
  var name = key
  var decl_type = type_constants::TYPE_ERROR
  var subj_is_ident = 1
  if subj_node >= 0
    subj_is_ident = 0
  end
  if subj_is_ident == 1
    var bidx0 = typecheck_util::tc_lookup_binding_index(tc, name)
    return 0 if bidx0 < 0
    decl_type = tc.scope.binding_types[bidx0]
  else
    # Non-ident subject: resolve the field/element's static type. Only unions are
    # narrowable via an access-path key.
    decl_type = tc_expr(tc, ast_storage, subj_node)
    return 0 if not typecheck_registry::tc_is_union_type(decl_type)
    var um2_members = typecheck_registry::tc_union_members(tc, decl_type)
    var um2_str = ""
    var um2_idx = -1
    for _un2 in 0..um2_members.size
      if str_trim(um2_members[_un2]) == str_trim(variant)
        um2_str = str_trim(um2_members[_un2])
        um2_idx = _un2
      end
    end
    return 0 if um2_idx < 0
    var inner2 = typecheck::tc_parse_type(tc, um2_str)
    return 0 if inner2 == type_constants::TYPE_ERROR
    var inner2_struct = ""
    if inner2 >= type_constants::PTYPE_BASE
      inner2_struct = typecheck::tc_ptype_name(tc, inner2)
    end
    typecheck_util::tc_narrow_add(tc, name, um2_idx, inner2, inner2_struct, narrow_depth)
    return 1
  end
  # Option/Result subjects are always ptypes; a bare user enum may be the scalar
  # TYPE_ENUM id (no type args) OR a ptype(TYPE_ENUM, ...). Only require ptype for
  # the Option/Result branches — compute base defensively for both shapes.
  var is_pt = typecheck::tc_is_ptype(decl_type)
  var base = decl_type
  if is_pt
    base = typecheck::tc_ptype_base(tc, decl_type)
  end

  var inner_type = type_constants::TYPE_ERROR
  var variant_idx = 0

  if base == type_constants::TYPE_OPTION
    return 0 if is_pt == false
    return 0 if variant != "Some"
    inner_type = as_int(typecheck::tc_ptype_arg1(tc, decl_type))
    variant_idx = 0
  elsif base == type_constants::TYPE_RESULT
    return 0 if is_pt == false
    if variant == "Ok"
      inner_type = as_int(typecheck::tc_ptype_arg1(tc, decl_type))
      variant_idx = 0
    elsif variant == "Err"
      inner_type = as_int(typecheck::tc_ptype_arg2(tc, decl_type))
      variant_idx = 1
    else
      return 0
    end
  elsif typecheck_registry::tc_is_union_type(decl_type)
    # R2.1 (B2) — union member narrowing: the proven arm's inner type is the
    # member's parsed annotation. Find the member whose trimmed spelling matches
    # `variant`; parse it to a type id and push the refinement so a narrowed read
    # of `name` in the THEN branch resolves to the member type (and the IDENT
    # handler stamps int_val=1, driving the offset-1 payload load at read time).
    var um_members = typecheck_registry::tc_union_members(tc, decl_type)
    var um_str = ""
    var um_idx = -1
    for _un in 0..um_members.size
      if str_trim(um_members[_un]) == str_trim(variant)
        um_str = str_trim(um_members[_un])
        um_idx = _un
      end
    end
    return 0 if um_idx < 0
    inner_type = typecheck::tc_parse_type(tc, um_str)
    variant_idx = um_idx
  else
    # Arbitrary user enum: resolve via the registry. The variant must have exactly
    # ONE payload field; resolve that field's concrete type against the subject's
    # (possibly-generic) declared type, the same machinery the match arm uses.
    var enum_name = typecheck_util::tc_scope_lookup_struct_name(tc, name)
    return 0 if str_byte_len(enum_name) == 0
    var enum_lr = typecheck_registry::tc_lookup_enum(tc, enum_name)
    var enum_idx = match enum_lr
      Found(v) => v
      NotFound => -1
    end
    return 0 if enum_idx < 0
    # Find the variant index.
    var vnames = typecheck_registry::tc_enum_variant_names(tc, enum_idx)
    var vidx = -1
    for _ui in 0..vnames.size
      if vnames[_ui] == variant
        vidx = _ui
      end
    end
    return 0 if vidx < 0
    # Single-payload requirement.
    return 0 if typecheck_registry::tc_enum_variant_payload_count(tc, enum_name, variant) != 1
    # Resolve the single field's annotation against the subject's generic args.
    var all_anns_raw = as_int(tc.registry.enum_variant_field_annotations[enum_idx])
    return 0 if vec_size(all_anns_raw) <= vidx
    var v_anns = all_anns_raw[vidx]
    return 0 if vec_size(v_anns) != 1
    var ann_str = as_string(v_anns[0])
    return 0 if str_byte_len(ann_str) == 0
    var tparams = tc.registry.enum_type_params[enum_idx]
    inner_type = as_int(typecheck_match::tc_resolve_variant_type(tc, ann_str, tparams, decl_type))
    variant_idx = vidx
  end

  return 0 if inner_type == type_constants::TYPE_ERROR

  # Inner struct name for downstream field access (best-effort; "" is fine).
  var inner_struct = ""
  if inner_type >= type_constants::PTYPE_BASE
    inner_struct = typecheck::tc_ptype_name(tc, inner_type)
  end

  typecheck_util::tc_narrow_add(tc, name, variant_idx, inner_type, inner_struct, narrow_depth)
  return 1
end

## SURF.FLOW Phase 3 — apply ALL then-branch narrowing facts for an `if` condition,
## including `and`-chains. For `a and b` (NODE_BINARY OP_AND), BOTH conjuncts hold in
## the then-branch, so recurse and union the facts (`if a.some? and b.some?` narrows
## both a and b). For a leaf guard, classify via v3 and narrow the proven THEN
## variant. De Morgan: the ELSE of an `and` proves nothing about either conjunct, so
## this is THEN-facts only (the caller handles else/guard-style for the single-guard
## case). Bounded recursion over the `and`-spine; non-guard leaves are simply skipped
## (additive — no narrowing, today's behavior). `_v3_out` is a reusable 4-slot scratch.
def tc_narrow_apply_then_facts(tc: TypecheckState, ast_storage: ast::AstStorage, cond_node: AstNodeId, depth: Int): Void
  return if cond_node < 0
  var ck = ast::ast_get_kind(ast_storage, cond_node)
  if ck == node_constants::NODE_BINARY and ast::ast_get_op(ast_storage, cond_node) == 14  # OP_AND
    tc_narrow_apply_then_facts(tc, ast_storage, ast::ast_get_left(ast_storage, cond_node), depth)
    tc_narrow_apply_then_facts(tc, ast_storage, ast::ast_get_right(ast_storage, cond_node), depth)
    return
  end
  var v3 = vec_new()
  v3.push(-1)
  v3.push(as_int(""))
  v3.push(as_int(""))
  v3.push(-1)
  tc_narrow_guard_classify_v3(tc, ast_storage, cond_node, v3)
  var subj = as_int(v3[0])
  return if subj < 0
  var then_variant = as_string(v3[1])
  return if str_byte_len(then_variant) == 0
  # GAP-B2-nonident-narrow — key on the access path (ident → "name", field → "b.f",
  # const-index → "b[n]") so field/element subjects narrow under the same table.
  var tf_key = typecheck_util::tc_access_path_key(ast_storage, subj)
  return if str_byte_len(tf_key) == 0
  var tf_node = -1
  if ast::ast_get_kind(ast_storage, subj) != node_constants::NODE_IDENT
    tf_node = subj
  end
  tc_try_narrow_variant_keyed(tc, ast_storage, tf_key, tf_node, then_variant, depth)
end

## SURF.FLOW A5 — apply ELSE-branch narrowing facts for an `or`-chain `if` condition.
## De Morgan dual of tc_narrow_apply_then_facts: for `a or b` (NODE_BINARY OP_OR), the
## ELSE branch proves `not (a or b)` = `not a and not b`, so BOTH operands hold their
## FALSE-fact (`if a.some? or b.some? ... else <both a,b narrow to None>`). Recurse over
## the OP_OR spine and, for each leaf, classify via v3 and narrow the proven ELSE variant
## (v3 slot out[2], the else_variant). SOUNDNESS: this is applied ONLY in the else region,
## never the then region — the THEN of an `or` proves only that AT LEAST ONE disjunct
## holds (not which), so narrowing any THEN operand would be UNSOUND (and-chain else is
## symmetrically un-narrowed). A leaf whose guard has NO else-fact (3+-variant `is V`,
## THEN-only union member, or a negative Option guard whose else has no payload) yields
## an empty else_variant → contributes NO narrowing for that operand (skipped, never
## crashes). Additive: non-guard leaves are simply skipped. `_v3_out` is a fresh 4-slot
## scratch per leaf.
def tc_narrow_apply_orchain_else_facts(tc: TypecheckState, ast_storage: ast::AstStorage, cond_node: AstNodeId, depth: Int): Void
  return if cond_node < 0
  var ck = ast::ast_get_kind(ast_storage, cond_node)
  if ck == node_constants::NODE_BINARY and ast::ast_get_op(ast_storage, cond_node) == 15  # OP_OR
    tc_narrow_apply_orchain_else_facts(tc, ast_storage, ast::ast_get_left(ast_storage, cond_node), depth)
    tc_narrow_apply_orchain_else_facts(tc, ast_storage, ast::ast_get_right(ast_storage, cond_node), depth)
    return
  end
  var v3 = vec_new()
  v3.push(-1)
  v3.push(as_int(""))
  v3.push(as_int(""))
  v3.push(-1)
  tc_narrow_guard_classify_v3(tc, ast_storage, cond_node, v3)
  var subj = as_int(v3[0])
  return if subj < 0
  var else_variant = as_string(v3[2])
  return if str_byte_len(else_variant) == 0
  var ef_key = typecheck_util::tc_access_path_key(ast_storage, subj)
  return if str_byte_len(ef_key) == 0
  var ef_node = -1
  if ast::ast_get_kind(ast_storage, subj) != node_constants::NODE_IDENT
    ef_node = subj
  end
  tc_try_narrow_variant_keyed(tc, ast_storage, ef_key, ef_node, else_variant, depth)
end

## SURF.FLOW Phase 2 SOUNDNESS — retract a narrowed read's payload-extract stamp
## when its value flows whole into a wide Option/Result slot.
##
## A narrowed bare-ident read carries int_val=1 (set in the identifier handler) so
## MIR extracts the inner `T` payload. That is a REPRESENTATION change, not a
## subtype: `Option<T>` (niche/boxed word) and `T` (scalar) are laid out
## differently and Quartz has no subtyping. When such a read is the WHOLE value of
## a return / struct-field-init / assignment / let whose destination type is
## `Option<...>`/`Result<...>`, extracting would store a scalar where an Option word
## is required → a later match/unwrap dereferences garbage → SIGSEGV (the tui_form /
## tui_focus_ring regression). This helper, called AFTER the value subexpression is
## walked at each such chokepoint, PINS the stamp to 2 ("narrowed, MIR no-extract")
## on a bare narrowed ident whose OWN declared base equals the destination base, so
## the wide Option/Result word round-trips intact (the user falls back to today's
## unwrap/bind — purely additive, sound, FLOW_NARROWING §3.3 rule 5). The pin is
## stable across the typechecker's multiple walks of a value (per-module pass +
## compile() all_funcs pass + block-as-expression re-walks): the identifier handler
## refuses to overwrite a pinned (2) read back to extract (1).
def tc_unstamp_narrowed_into_wide(tc: TypecheckState, ast_storage: ast::AstStorage, value_node: AstNodeId, dest_base: Int): Void
  return if dest_base == type_constants::TYPE_ERROR
  return if value_node < 0
  return if ast::ast_get_kind(ast_storage, value_node) != node_constants::NODE_IDENT
  var name = ast::ast_get_str1(ast_storage, value_node)
  # Only relevant when this name is actually narrowed here (a refinement is active).
  return if typecheck_util::tc_narrow_lookup(tc, name) == type_constants::TYPE_ERROR
  var bidx = typecheck_util::tc_lookup_binding_index(tc, name)
  return if bidx < 0
  var decl = tc.scope.binding_types[bidx]
  if typecheck_util::tc_narrow_decl_base(tc, decl) == dest_base
    # PIN to 2 = "narrowed type, but MIR must NOT extract" — survives re-walks
    # because the identifier handler refuses to overwrite a pinned (2) stamp.
    ast::ast_set_int_val(ast_storage, value_node, 2)
  end
end

## SURF.FLOW Phase 2 — divergence predicate for guard-style early-exit.
## Returns 1 only when control flow DEFINITELY leaves the enclosing scope at the
## end of `node` (so statements after the `if` are reached only when the guard was
## false). Conservative by construction: when unsure, returns 0 (no else-fact
## injected, user keeps today's behavior). Recognized diverging forms:
##   - `return` / `break` / `continue`
##   - a bare `panic(...)` / `throw(...)` call (NODE_EXPR_STMT wrapping NODE_CALL).
##     `panic`/`throw` are matched by NAME because `throw` is an algebraic effect
##     op whose declared return type is NOT `Never` (it unwinds regardless).
##   - A3: a call to a function whose DECLARED return type is `Never` (the bottom
##     type) — e.g. a user `def loop_forever(): Never`. Such a call can never fall
##     through, so control after the guard is only reached on the false path.
##   - a NODE_BLOCK whose LAST statement diverges
##   - B4-b1: a NODE_MATCH that is TOTAL (int_val==1 stamp from
##     tc_check_exhaustiveness — no fall-through) AND all of whose arm bodies
##     diverge. Both conditions are required for soundness: a non-total match
##     can fall through, and a total match with even one non-diverging arm
##     yields a value on that path.
## A NODE_IF only diverges if BOTH then and else diverge — but to stay strictly
## conservative we do NOT recurse into nested ifs here (returns 0), which
## never injects an unsound fact.
def tc_stmt_diverges(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Int
  return 0 if node < 0
  var k = ast::ast_get_kind(ast_storage, node)
  if k == node_constants::NODE_RETURN
    return 1
  elsif k == node_constants::NODE_BREAK
    return 1
  elsif k == node_constants::NODE_CONTINUE
    return 1
  elsif k == node_constants::NODE_EXPR_STMT
    var es_expr = ast::ast_get_left(ast_storage, node)
    return tc_stmt_diverges(tc, ast_storage, es_expr)
  elsif k == node_constants::NODE_CALL
    var c_callee = ast::ast_get_left(ast_storage, node)
    return 0 if c_callee < 0
    return 0 if ast::ast_get_kind(ast_storage, c_callee) != node_constants::NODE_IDENT
    var c_name = ast::ast_get_str1(ast_storage, c_callee)
    # Bare `panic(...)` / `throw(...)` — both unwind unconditionally.
    if c_name == "panic" or c_name == "throw"
      return 1
    end
    # A3: a call to a `Never`-returning function diverges (bottom type).
    if typecheck_registry::tc_lookup_function_return(tc, c_name) == type_constants::TYPE_NEVER
      return 1
    end
    return 0
  elsif k == node_constants::NODE_BLOCK
    var stmts = ast::ast_get_children(ast_storage, node)
    return 0 if stmts.size == 0
    var last = stmts[stmts.size - 1]
    return tc_stmt_diverges(tc, ast_storage, last)
  elsif k == node_constants::NODE_MATCH
    # B4-b1 — a match diverges iff (a) it is TOTAL (no fall-through) AND (b)
    # EVERY arm body diverges. (a) is the int_val==1 stamp set once by
    # tc_check_exhaustiveness (Maranget witness == -1). Without the stamp the
    # match might fall through, so it cannot be assumed to diverge → return 0.
    return 0 if ast::ast_get_int_val(ast_storage, node) != 1
    var m_arms = ast::ast_get_children(ast_storage, node)
    return 0 if m_arms.size == 0
    for m_i in 0..m_arms.size
      var m_arm = m_arms[m_i]
      # Arm body is the arm node's RHS; it may be wrapped in NODE_EXPR_STMT
      # (mirrors tc_expr_match at typecheck_expr_handlers.qz:1200-1208).
      var m_body = ast::ast_get_right(ast_storage, m_arm)
      return 0 if m_body < 0
      if ast::ast_get_kind(ast_storage, m_body) == node_constants::NODE_EXPR_STMT
        var m_inner = ast::ast_get_left(ast_storage, m_body)
        if m_inner >= 0
          m_body = m_inner
        end
      end
      return 0 if tc_stmt_diverges(tc, ast_storage, m_body) == 0
    end
    return 1
  end
  return 0
end

def _tc_stmt_body(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  # Note: node >= 0 is valid. Use < 0 to check for missing nodes (sentinel -1)
  return if node < 0

  # 5.1.B body-wrap: install Diag handler for the entire body. Inner
  # error(...) calls route via the bridge to typecheck_util::tc_error
  # on the active TypecheckState (set in compile() via tc_diag_set).
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->

  var node_kind = ast::ast_get_kind(ast_storage, node)
  var line = ast::ast_get_line(ast_storage, node)
  var col = ast::ast_get_col(ast_storage, node)
  # Let binding
  # Note: init_node >= 0 because node handle 0 is valid (first AST node)
  # Let bindings always have initializers (parser requires them)
  # NOTE: ast_let stores value in slot 7 (left), not slot 8 (right)
  if node_kind == node_constants::NODE_LET
    var var_name = ast::ast_get_str1(ast_storage, node)
    var init_node = ast::ast_get_left(ast_storage, node)
    var is_mutable = ast::ast_get_int_val(ast_storage, node)
    
    # Note: init_node >= 0 because node handle 0 is valid (first AST node)
    # Level-based generalization: enter a new level for the let-binding body
    typecheck_util::tc_tv_enter_level()

    # BIDIR_LAMBDA_INFERENCE_DOES_NOT_FLOW_FROM_LET_ANNOTATION (2026-05-21):
    # mirror the FIX.6 Phase 2 bidir-inject at the call site
    # (typecheck_expr_handlers.qz:3167+) for the let-binding case.
    # When the RHS is a NODE_LAMBDA and the LHS carries a `Fn(...)` annotation
    # (or an alias to one — `_tc_is_fn_ann` resolves transparently post the
    # 2026-05-21 HB-DOG.3(b)+(c) close-out), inject expected param types into
    # lambda params lacking their own `str2`. Without this, the lambda's
    # params default to fresh tv-vars → existentially erase to Int → a
    # `b + d` body where `b: String, d: String` typechecks as `Int + Int`
    # (pointer add) and runtime returns a garbage integer cast back to the
    # declared String return — UB / empty-string symptom, not a type error.
    var pre_let_ann = ast::ast_get_str2(ast_storage, node)
    if str_byte_len(pre_let_ann) > 0
      if ast::ast_get_kind(ast_storage, init_node) == node_constants::NODE_LAMBDA
        if typecheck::_tc_is_fn_ann(tc, pre_let_ann)
          var pre_lam_params = ast::ast_get_left(ast_storage, init_node)
          if pre_lam_params > 0
            var pre_lam_pc = vec_size(pre_lam_params)
            for pre_lp_i in 0..pre_lam_pc
              var pre_lp_node = pre_lam_params[pre_lp_i]
              var pre_lp_existing = ast::ast_get_str2(ast_storage, pre_lp_node)
              if str_byte_len(pre_lp_existing) == 0
                var pre_exp_param_str = typecheck::tc_fn_annotation_nth_param_str(tc, pre_let_ann, pre_lp_i)
                if str_byte_len(pre_exp_param_str) > 0
                  ast::ast_set_str2(ast_storage, pre_lp_node, pre_exp_param_str)
                end
              end
            end
          end
        end
      end
    end

    # SURF.FLOW Phase 2 soundness — compute the destination base for a `let`/`var`.
    # An explicit Option/Result annotation is a wide destination. NOTE: `x = e`
    # reassignment desugars to NODE_LET (see CLAUDE memory "vo=e is NODE_LET-reassign"),
    # so for a name that is ALREADY bound (no fresh annotation) the destination is
    # the existing binding's declared type — consult it so `sink = narrowed_opt`
    # is retracted too.
    var let_ann_for_expect = ast::ast_get_str2(ast_storage, node)
    var let_expect_base = type_constants::TYPE_ERROR
    if str_byte_len(let_ann_for_expect) > 0
      let_expect_base = typecheck_util::tc_narrow_expect_base_of_annotation(tc, let_ann_for_expect)
    else
      var let_existing_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
      if let_existing_bidx >= 0
        var let_existing_type = tc.scope.binding_types[let_existing_bidx]
        let_expect_base = typecheck_util::tc_narrow_expect_base_of_type(tc, let_existing_type)
      end
    end
    var init_type = tc_expr(tc, ast_storage, init_node)
    # Retract a narrowed-read stamp when the init value flows whole into a wide slot.
    tc_unstamp_narrowed_into_wide(tc, ast_storage, init_node, let_expect_base)

    # SURF.FLOW B1 — record a CONST alias to a narrowing guard. When a const local
    # binds directly to a recognized guard boolean (`c = x.some?`), stash `c -> the
    # guard's cond-node` so a later `if c` re-classifies against the stored guard and
    # narrows `x` exactly as `if x.some?` would (§2.2). Const-only (§2.3 gate 1): a
    # `var c` could be reassigned to a stale boolean between bind and use, so it is
    # never recorded. Probe-classify AFTER tc_expr so the subject's type is resolved;
    # a hit is `probe[0] >= 0`. One-hop only: an init that is itself a bare IDENT is
    # not recorded as an alias-to-an-alias (the classifier's IDENT arm guards loops).
    if is_mutable == 0 and init_node >= 0
      if tc_b1_init_is_guard_shaped(ast_storage, init_node)
        var b1_probe = vec_new()
        b1_probe.push(-1)
        b1_probe.push(as_int(""))
        b1_probe.push(as_int(""))
        b1_probe.push(-1)
        tc_narrow_guard_classify_v3(tc, ast_storage, init_node, b1_probe)
        if as_int(b1_probe[0]) >= 0
          typecheck_util::tc_alias_add(tc, var_name, init_node, typecheck_util::tc_get_depth(tc))
        end
      end
    end

    # If tc_expr couldn't determine type, assign a fresh type variable.
    # The type variable will be constrained by later usage (function calls,
    # operators, annotations) via unification. Falls back to old inference
    # engine only if type variable remains unconstrained.
    if init_type == type_constants::TYPE_ERROR
      # Only tag as QZ0204 candidate when init is a function call (likely undefined fn).
      # Other sources of TYPE_ERROR (regex =~?, operators) are handled by codegen.
      var init_kind_qz = ast::ast_get_kind(ast_storage, init_node)
      if init_kind_qz == node_constants::NODE_CALL
        init_type = typecheck_util::tc_tv_fresh_with_origin(tc, line, col, "QZ0204_let #{var_name}")
      else
        init_type = typecheck_util::tc_tv_fresh_with_origin(tc, line, col, "let #{var_name}")
      end
    end

    # Check for explicit type annotation (e.g., var v: Vec<String> = vec_new())
    # The annotation CONSTRAINS the inferred type via unification, then overrides
    # the binding type (for ptype refinement — Vec<String> is richer than Vec).
    var let_type_ann = ast::ast_get_str2(ast_storage, node)
    if str_byte_len(let_type_ann) > 0
      var annotated_type = typecheck::tc_parse_type(tc, let_type_ann)
      if annotated_type != type_constants::TYPE_ERROR
        # QZ0213 (B.15c) — nil-literal wall. A syntactic `nil` flowing into a
        # heap/reference-typed slot is forbidden; `nil` is not a typed value
        # (use Option<T> + None, or keep CPtr at an FFI boundary). Fires before
        # the simple-prim cross-check so the diagnostic is uniform across String,
        # struct, Vec, Option, …. Keys off the NodeNilLit operand, so the
        # existential bare-Int gap (tc_expr → TYPE_INT for boxed values) cannot
        # cause a false positive — a bare `0`/Int-var is a different node kind.
        if ast::ast_get_kind(ast_storage, init_node) == node_constants::NODE_NIL_LIT
          # A union with an explicit `Nil` member (`Int | Nil`) admits `nil`.
          if typecheck_helpers::tc_nil_forbidden_type(tc, annotated_type) == 1 and typecheck_registry::tc_union_contains_nil(tc, annotated_type) == 0
            error("`nil` is not a value here (variable type `#{let_type_ann}`). Use `Option<#{let_type_ann}>` and `None`, or — at an FFI boundary — keep it as `CPtr`. (QZ0213)", line, col)
          end
        end
        # QZ0214 (N3.1 audit) — bare int-literal bound to a boxed slot (the
        # existential `0`-sentinel). Default-off WARNING (QZ_N3_AUDIT) for the
        # migration worklist; no behavior/IR change. See the return site above.
        if ast::ast_get_kind(ast_storage, init_node) == node_constants::NODE_INT_LIT
          if typecheck_helpers::tc_nil_forbidden_type(tc, annotated_type) == 1 and typecheck_registry::tc_union_contains_nil(tc, annotated_type) == 0
            if typecheck_helpers::tc_n3_wall_warn_enabled()
              if typecheck_helpers::tc_n3_wall_is_error(tc)
                error("QZ0214: bare int-literal bound to boxed slot `#{let_type_ann}` — the existential 0-sentinel is forbidden here; use `Option<#{let_type_ann}>` + `None`, or a real value", line, col)
              else
                warn("QZ0214 (N3.1 audit): bare int-literal bound to boxed slot `#{let_type_ann}` — existential 0-sentinel; migrate to Option<#{let_type_ann}>+None or a real value", line, col)
              end
            end
          end
        # QZ0215 (N3.1 step-4 audit) — the Int-VARIABLE / erased-boxed-value case:
        # an init expression whose resolved type is bare TYPE_INT bound into a
        # boxed slot, but the init is NOT a literal (QZ0214) nor `nil` (QZ0213).
        # Under the existential model tc_expr returns TYPE_INT for genuine boxed
        # values too, so a hit is EITHER a real Int-var sentinel OR an
        # erased-boxed value that de-existentialization must give a real type.
        # Both are the de-existentialization worklist. Default-off WARNING; no
        # behavior/IR change. The full bare-Int wall (step 4) will narrow the
        # tc_is_i64_type coercion so these become hard errors / type correctly.
        elsif ast::ast_get_kind(ast_storage, init_node) != node_constants::NODE_NIL_LIT
          if init_type == type_constants::TYPE_INT
            if typecheck_helpers::tc_nil_forbidden_type(tc, annotated_type) == 1 and typecheck_registry::tc_union_contains_nil(tc, annotated_type) == 0
              if typecheck_helpers::tc_n3_wall_warn_enabled() and typecheck_helpers::tc_n3_file_exempt(tc) == false
                if typecheck_helpers::tc_n3_wall_is_error(tc)
                  error("QZ0215: Int-typed value bound to boxed slot `#{let_type_ann}` — the existential erased-value/Int-var sentinel is forbidden here; de-existentialize the source or migrate to `Option<#{let_type_ann}>`", line, col)
                else
                  warn("QZ0215 (N3.1 step-4 audit): Int-typed value bound to boxed slot `#{let_type_ann}` — existential erased-value/Int-var sentinel; de-existentialize or migrate to Option", line, col)
                end
              end
            end
          end
        end
        # QZ0215 (N3.1 step-4 structural audit) — array/vector-element case.
        # `var v: Vec<BoxedElem> = [ ... ]`: the NODE_ARRAY literal has no
        # top-down element type, so the typed boundary is HERE (the annotated
        # Vec<...> slot). Extract the declared element type from the annotated
        # ptype and audit each element for a bare Int landing in a forbidden
        # boxed element slot. Warn-only (structural flip switch is off).
        if ast::ast_get_kind(ast_storage, init_node) == node_constants::NODE_ARRAY
          if typecheck::tc_is_ptype(annotated_type)
            if typecheck::tc_base_kind(tc, annotated_type) == type_constants::TYPE_VEC
              var arr_elem_t = typecheck::tc_ptype_arg1(tc, annotated_type)
              if arr_elem_t != 0
                tc_n3_audit_array_elems(tc, ast_storage, init_node, arr_elem_t, "#{let_type_ann} element", line, col)
              end
            end
          end
        end
        # Cross-newtype rejection: var b: OtherId = a (where a: TestId)
        if typecheck::tc_is_newtype(annotated_type) and typecheck::tc_is_newtype(init_type)
          if init_type != annotated_type
            error("Type mismatch: cannot assign #{let_type_ann} from a different newtype", line, col)
          end
        end
        # STRICT_NEWTYPES — strict newtype on either side refuses implicit
        # construction / unwrap at the let-position. `var s: Secret<Int> = 42`
        # and `var v: Int = secret_val` both raise here. Crossing the boundary
        # requires the `as_type<T>(v)` builtin — see
        # docs/design/STRICT_NEWTYPES_DESIGN.md. Type variables (still unbound
        # from generic instantiation) are skipped — they unify in the next
        # block below.
        #
        # Same-base bare↔ptype is permitted via tc_types_match (which
        # routes through the STRICT_NEWTYPES_GENERIC_BINDING block in
        # typecheck.qz). This is what makes
        # `var s: Secret<Int> = secret_wrap(p)` typecheck even when the
        # call's return type resolves to bare `Secret` rather than the
        # full ptype-form `Secret<Int>`.
        if typecheck_util::tc_tv_is_var(init_type) == 0
          if typecheck::tc_is_strict_newtype(tc, annotated_type) or typecheck::tc_is_strict_newtype(tc, init_type)
            if typecheck::tc_types_match(tc, init_type, annotated_type) == false
              error("Type mismatch: cannot implicitly convert across strict-newtype boundary (expected '#{let_type_ann}'). Use as_type<T>(v) to cross.", line, col)
            end
          end
        end
        # T3c.1 Phase 2: Cross-check annotation against inferred type.
        # If init_type is a type variable, the annotation constrains it.
        # If both are concrete primitives, verify they're compatible.
        if typecheck_util::tc_tv_is_var(init_type) == 1
          # Type variable — annotation constrains it
          typecheck_util::tc_tv_bind(tc, init_type, annotated_type)
        elsif init_type > 0 and init_type != type_constants::TYPE_ERROR
          # Cross-check for primitive-to-primitive mismatches only.
          # The existential type model means struct/enum values flow as TYPE_INT,
          # so we can only reliably cross-check between distinct primitive types
          # (Int vs String, Bool vs Int, etc.). Struct/enum/container annotations
          # are richer than what tc_expr infers and should override, not conflict.
          var init_is_simple_prim = typecheck_helpers::tc_is_simple_primitive(init_type)
          var ann_is_simple_prim = typecheck_helpers::tc_is_simple_primitive(annotated_type)
          if init_is_simple_prim == 1 and ann_is_simple_prim == 1
            if typecheck_util::tc_tv_unify(tc, init_type, annotated_type) == 0
              error("Type annotation '#{let_type_ann}' conflicts with inferred type '#{typecheck_util::tc_tv_type_name(tc, init_type)}'", line, col)
            end
          end
        end
        # Use annotated type — it may be a ptype with richer info
        init_type = annotated_type
      else
        # Unknown type annotation — emit error unless it's a type param in scope
        var lta_suggestion = typecheck_registry::tc_suggest_type(tc, let_type_ann)
        error("Unknown type '#{let_type_ann}'#{lta_suggestion}", line, col)
      end
    end

    # Check if variable already exists ANYWHERE in scope (C bootstrap compatibility)
    # If it exists, treat LET as reassignment rather than new definition.
    #
    # A.17: lexical-scoping correction. Module-level globals are bound at
    # depth 0 (tc_program Phase 3 runs no tc_enter_scope); every function
    # body and block is at depth >= 1 (tc_function calls tc_enter_scope
    # before binding params/locals). A `var x = ...` *declaration* inside a
    # function whose name only matches a depth-0 global MUST introduce a
    # fresh function-local that *shadows* the global — not silently
    # retarget the module global. Without this, the global's
    # type/annotation leaks into the function body (e.g. a user
    # `var result = 0` shadowing a stdlib `unique()`'s local
    # `var result = vec_new<Int>()`, breaking UFCS receiver-type
    # resolution → QZ0401 "Undefined function: push").
    #
    # Gated on `is_mutable == 1`: only the `var` keyword form is an
    # unambiguous declaration. The bare `x = e` form (is_mutable == 0)
    # is also parsed as NODE_LET but is a reassignment when `x` already
    # exists — including reassignment of a module global from inside a
    # function body (the compiler's own `_cur_* = saved_*` pattern). That
    # path must keep finding the global.
    var existing_type = typecheck_util::tc_scope_lookup(tc, var_name)
    if existing_type != type_constants::TYPE_ERROR and is_mutable == 1
      var existing_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
      if existing_bidx >= 0
        var existing_depth = tc.scope.binding_depths[existing_bidx]
        if existing_depth == 0 and typecheck_util::tc_get_depth(tc) > 0
          # Innermost match is a module global; this `var` is a new local.
          existing_type = type_constants::TYPE_ERROR
        end
      end
    end
    if existing_type != type_constants::TYPE_ERROR
      # Variable exists - this is a reassignment, check mutability only
      # Note: C bootstrap does NOT check type match on reassignment - it allows
      # dynamic retyping. This matches that behavior for parity.
      typecheck::tc_check_mutation_while_borrowed(tc, var_name, line, col)
      typecheck::tc_release_old_borrow(tc, var_name)
      # Reset move state on reassignment — re-initialized values are live again
      var reinit_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
      if reinit_bidx >= 0
        if tc.safety.move_states[reinit_bidx] == 2
          tc.safety.move_states[reinit_bidx] = 1
          tc.safety.move_targets[reinit_bidx] = ""
          tc.safety.move_lines[reinit_bidx] = 0
          tc.safety.move_cols[reinit_bidx] = 0
        end
        # Clear partial move state
        tc.safety.partial_moved_fields[reinit_bidx] = ""
        tc.safety.partial_move_targets[reinit_bidx] = ""
      end
      var existing_mutable = typecheck_util::tc_scope_lookup_mutable(tc, var_name)
      if existing_mutable == 0
        error("Cannot assign to immutable variable: #{var_name}", line, col)
      end
      # WS2.1 reassignment RHS scalar soundness (QZ0201) — a bare `x = e` where
      # `x` already exists is parsed as NODE_LET and lands HERE, NOT in the
      # NODE_ASSIGN handler. The C-bootstrap-parity comment above deliberately
      # skips a full type-match check (dynamic retyping), which let
      # `var x: Int = 5; x = "hi"` and `var s: String = "a"; s = 42` silently
      # miscompile (ptr-bits / SIGSEGV). Reuse R2.3's narrow predicate to flag
      # ONLY definite String↔numeric / Int↔Float mismatches; every handle/
      # newtype/struct/Bool pun (the retyping the parity note protects) is
      # still permitted.
      var ra_rk = ast::ast_get_kind(ast_storage, init_node)
      if typecheck::tc_assign_scalar_mismatch(tc, existing_type, init_type, ra_rk == node_constants::NODE_INT_LIT, ra_rk == node_constants::NODE_STRING_LIT, ra_rk == node_constants::NODE_FLOAT_LIT) == 1
        error("Type mismatch in assignment to '#{var_name}': expected '#{typecheck::tc_type_name_full(tc, existing_type)}' but got '#{typecheck::tc_type_name_full(tc, init_type)}' — String and numeric (or Int and Float) need an explicit conversion (QZ0201)", line, col)
      end
      # SURF.FLOW Phase 2 — soundness invalidation. A bare `x = e` reassignment of
      # an existing var is parsed as NODE_LET (this branch), NOT NODE_ASSIGN. The
      # reassigned value could be None, so any active narrowing on `x` is now
      # stale: drop it. (NODE_ASSIGN and NODE_COMPOUND_ASSIGN have mirror hooks.)
      typecheck_util::tc_narrow_invalidate(tc, var_name)
      # Arena tracking on reassignment: track @arena, arena_alloc, pool_alloc, or alias
      var reassign_init_kind = ast::ast_get_kind(ast_storage, init_node)
      if reassign_init_kind == 20  # NODE_ALLOC_EXPR
        var ra_alloc_target = ast::ast_get_str1(ast_storage, init_node)
        if ra_alloc_target != "heap"
          typecheck::tc_arena_track_alloc(tc, var_name, ra_alloc_target, line)
        end
      elsif reassign_init_kind == node_constants::NODE_CALL
        var ra_callee = ast::ast_get_left(ast_storage, init_node)
        if ra_callee >= 0
          if ast::ast_get_kind(ast_storage, ra_callee) == node_constants::NODE_IDENT
            var ra_callee_name = ast::ast_get_str1(ast_storage, ra_callee)
            if ra_callee_name == "arena_alloc"
              var ra_arena_args = ast::ast_get_children(ast_storage, init_node)
              var ra_arena_name = "arena"
              if ra_arena_args.size > 0
                var ra_arena_arg = ra_arena_args[0]
                if ast::ast_get_kind(ast_storage, ra_arena_arg) == node_constants::NODE_IDENT
                  ra_arena_name = ast::ast_get_str1(ast_storage, ra_arena_arg)
                end
              end
              typecheck::tc_arena_track_alloc(tc, var_name, ra_arena_name, line)
            elsif ra_callee_name == "pool_alloc"
              var ra_pool_args = ast::ast_get_children(ast_storage, init_node)
              var ra_pool_name = "pool"
              if ra_pool_args.size > 0
                var ra_pool_arg = ra_pool_args[0]
                if ast::ast_get_kind(ast_storage, ra_pool_arg) == node_constants::NODE_IDENT
                  ra_pool_name = ast::ast_get_str1(ast_storage, ra_pool_arg)
                end
              end
              typecheck::tc_arena_track_alloc(tc, var_name, ra_pool_name, line)
            end
          end
        end
      elsif reassign_init_kind == node_constants::NODE_IDENT
        var ra_src_alias = ast::ast_get_str1(ast_storage, init_node)
        typecheck::tc_arena_propagate_alias(tc, var_name, ra_src_alias, line)
      end

      # T3c.2 Phase 3: consume pending return borrow on reassignment
      if typecheck_util::tc_pending_borrow_get().size == 2
        var prb_ra_src = as_string(typecheck_util::tc_pending_borrow_get()[0])
        var prb_ra_kind = typecheck_util::tc_pending_borrow_get()[1]
        var prb_ra_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
        if prb_ra_bidx >= 0
          tc.safety.binding_borrow_sources[prb_ra_bidx] = prb_ra_src
          tc.safety.binding_is_mut_borrows[prb_ra_bidx] = prb_ra_kind - 1
          tc.safety.binding_borrow_lines[prb_ra_bidx] = line
          tc.safety.binding_borrow_cols[prb_ra_bidx] = col
        end
        typecheck_util::tc_pending_borrow_clear()
      end

      # Record borrow source on reassignment (mirrors new-binding logic at 6757-6778)
      if reassign_init_kind == node_constants::NODE_FUNC_REF
        var ra_borrow_src = ast::ast_get_str1(ast_storage, init_node)
        var ra_borrow_is_mut = ast::ast_get_int_val(ast_storage, init_node)
        var ra_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
        if ra_bidx >= 0
          tc.safety.binding_borrow_sources[ra_bidx] = ra_borrow_src
          tc.safety.binding_is_mut_borrows[ra_bidx] = ra_borrow_is_mut
          tc.safety.binding_borrow_lines[ra_bidx] = line
          tc.safety.binding_borrow_cols[ra_bidx] = col
          # Multi-level: propagate borrow chain (QZ1217)
          typecheck::tc_propagate_borrow_chain(tc, ra_borrow_src, ra_borrow_is_mut)
          # QZ1218: depth check — source must outlive holder
          var ra_src_bidx = typecheck_util::tc_lookup_binding_index(tc, ra_borrow_src)
          if ra_src_bidx >= 0
            var ra_src_depth = tc.scope.binding_depths[ra_src_bidx]
            var ra_holder_depth = tc.scope.binding_depths[ra_bidx]
            if ra_src_depth > ra_holder_depth
              error("QZ1218: Borrow of '#{ra_borrow_src}' would outlive its source (source is in a deeper scope)", line, col)
            end
          end
        end
      end
    else
      # New variable - create binding
      var param_count = -1
      # For struct types, track the struct name for trait method resolution.
      # Also enter this branch for parameterized types (PTYPE ≥ PTYPE_BASE)
      # whose base kind is TYPE_STRUCT — otherwise generic function returns
      # like `Foo<I>` would skip the struct-name tracking and downstream
      # UFCS dispatch would never resolve `foo.method()`. Enums are handled
      # separately elsewhere and fall through to their own match-validation
      # path, so we deliberately do NOT widen the branch for TYPE_ENUM.
      var struct_name = ""
      var type_ann = ""
      # Phase 7: opacity display marker. For most bindings this stays "" and
      # the binder defaults the display slot to the dispatch annotation. For
      # `impl Trait` return-typed bindings we set it to the opaque marker
      # ("impl <Trait>@<func>") so source-level type matching sees the
      # opaque identity, not the resolved concrete struct.
      var display_type = ""
      var init_base_kind_struct = init_type
      if init_type >= type_constants::PTYPE_BASE
        init_base_kind_struct = typecheck::tc_base_kind(tc, init_type)
      end
      if typecheck::tc_is_struct_type(init_type) or init_base_kind_struct == type_constants::TYPE_STRUCT
        # Try to get struct name from constructor call or explicit type annotation
        var init_kind = ast::ast_get_kind(ast_storage, init_node)
        if init_kind == node_constants::NODE_CALL
          # Try struct constructor first: Point(1, 2)
          var callee = ast::ast_get_left(ast_storage, init_node)
          if ast::ast_get_kind(ast_storage, callee) == node_constants::NODE_IDENT
            var callee_name = ast::ast_get_str1(ast_storage, callee)
            # Check if callee is a known struct name (constructor call)
            if typecheck_registry::tc_lookup_struct(tc, callee_name).is_found()
              struct_name = callee_name
            else
              # Not a constructor — look up function's return type annotation
              var ret_ann = typecheck_registry::tc_lookup_function_return_annotation(tc, callee_name)
              # Resolve impl Trait return to concrete type for UFCS dispatch.
              # Phase 7: also stamp the binding's display_type with the opaque
              # marker so source-level matching treats the value as opaque.
              if str_byte_len(ret_ann) > 5 and ret_ann.starts_with("impl ")
                var impl_concrete = typecheck_registry::tc_lookup_impl_return(tc, callee_name)
                if str_byte_len(impl_concrete) > 0
                  ret_ann = impl_concrete
                  var opaque_mk = typecheck_registry::tc_lookup_impl_return_opaque(tc, callee_name)
                  if str_byte_len(opaque_mk) > 0
                    display_type = opaque_mk
                  end
                end
              end
              if str_byte_len(ret_ann) > 0
                # If callee is generic, prefer the substituted return annotation
                # (e.g. `Box<String>`) over the raw `Box<I>` from the registry.
                # Without this, `var b = box_new<String>(...)` stores the leaked
                # `Box<I>` as b's scope annotation; a downstream call that takes
                # `b: Box<I_outer>` then unifies `Box<I_outer>` vs `Box<I>` and
                # binds `I_outer := "I"` (the literal type-param name), erasing
                # the type arg through every consumer of the result.
                var _gen_func_idx = typecheck_registry::tc_lookup_function_index(tc, callee_name)
                if _gen_func_idx >= 0
                  var _gen_tp_str = typecheck_registry::tc_function_type_params_str(tc, _gen_func_idx)
                  if str_byte_len(_gen_tp_str) > 0
                    var _gen_subst = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, init_node)
                    if str_byte_len(_gen_subst) > 0
                      ret_ann = _gen_subst
                    end
                  end
                end
                # Strip generic args if present (e.g., "Foo<T>" -> "Foo")
                var lt_pos = __char_index(ret_ann, '<')
                if lt_pos > 0
                  struct_name = str_byte_slice(ret_ann, 0, lt_pos)
                  type_ann = ret_ann
                else
                  struct_name = ret_ann
                end
              else
                # Check for as_type<T>(val) — the type_arg IS the struct name
                if callee_name == "as_type"
                  var call_type_arg = ast::ast_get_type_arg(ast_storage, init_node)
                  if str_byte_len(call_type_arg) > 0
                    if typecheck_registry::tc_lookup_struct(tc, call_type_arg).is_found()
                      struct_name = call_type_arg
                    end
                  end
                end
                # Fallback: check call node str2 for ptype-annotated struct name
                # (set by vec_get/vec_pop/vec_get_unchecked on Vec<Struct>)
                if str_byte_len(struct_name) == 0
                  var call_str2 = ast::ast_get_str2(ast_storage, init_node)
                  if str_byte_len(call_str2) > 0
                    if typecheck_registry::tc_lookup_struct(tc, call_str2).is_found()
                      struct_name = call_str2
                    end
                  end
                end
              end
            end
          end
          # R1.6: chained generic-unwrap binding. When the call is a bare-`T`-
          # returning generic (`m.get(k).unwrap()` → return annotation "T"),
          # `struct_name` resolves to the literal type-param name, NOT a
          # registered struct — `h.field` would then fail `QZ0301: Unknown
          # struct: T`. Two recoveries, in priority order:
          #   1. The call node's str2 — stamped with the recovered payload's
          #      concrete struct name by tc_expr_call's chained-unwrap fix
          #      (typecheck_expr_handlers.qz ~4394, the same channel vec_get
          #      uses). Covers the UN-annotated case `c = m.get(k).unwrap()`.
          #   2. An EXPLICIT binding annotation that names a registered struct
          #      (`h: Point = ...`) — the ground truth the user wrote.
          # Together they make both forms resolve the binding to the value type.
          if str_byte_len(struct_name) > 0
            if typecheck_registry::tc_lookup_struct(tc, struct_name).is_found() == false
              var _r16_call_str2 = ast::ast_get_str2(ast_storage, init_node)
              if str_byte_len(_r16_call_str2) > 0 and typecheck_registry::tc_lookup_struct(tc, _r16_call_str2).is_found()
                struct_name = _r16_call_str2
              elsif str_byte_len(let_type_ann) > 0
                var _r16_ann_base = let_type_ann
                var _r16_lt = __char_index(let_type_ann, '<')
                if _r16_lt > 0
                  _r16_ann_base = str_byte_slice(let_type_ann, 0, _r16_lt)
                end
                if typecheck_registry::tc_lookup_struct(tc, _r16_ann_base).is_found()
                  struct_name = _r16_ann_base
                  type_ann = let_type_ann
                end
              end
            end
          end
        elsif init_kind == node_constants::NODE_STRUCT_INIT
          # Struct literal: User { age: 30 } - struct name is in str1
          struct_name = ast::ast_get_str1(ast_storage, init_node)
          # For generic structs, read type args from str2 (e.g., "Int" from Box<Int> { ... })
          var init_type_args = ast::ast_get_str2(ast_storage, init_node)
          if str_byte_len(init_type_args) > 0
            type_ann = "#{struct_name}<#{init_type_args}>"
          end
        elsif init_kind == 20  # node_constants$NODE_ALLOC_EXPR (@heap StructInit)
          # Look through @heap to the inner expression for struct name
          var inner = ast::ast_get_left(ast_storage, init_node)
          var inner_kind = ast::ast_get_kind(ast_storage, inner)
          if inner_kind == node_constants::NODE_STRUCT_INIT
            struct_name = ast::ast_get_str1(ast_storage, inner)
            var inner_type_args = ast::ast_get_str2(ast_storage, inner)
            if str_byte_len(inner_type_args) > 0
              type_ann = "#{struct_name}<#{inner_type_args}>"
            end
          end
        elsif init_kind == node_constants::NODE_IDENT
          # Variable assignment: var b = a — look up source's struct name and type annotation
          var src_name = ast::ast_get_str1(ast_storage, init_node)
          struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, src_name)
          type_ann = typecheck_util::tc_scope_lookup_annotation(tc, src_name)
          # Phase 7: propagate the source binding's opaque display marker.
          var src_disp = typecheck_util::tc_scope_lookup_display_type(tc, src_name)
          if str_byte_len(src_disp) > 0 and typecheck_registry::tc_is_opaque_marker(src_disp)
            display_type = src_disp
          end
        elsif init_kind == node_constants::NODE_INDEX
          # Index expression: var p = v[i] — struct name annotated in str2 by tc_expr_index
          var idx_str2 = ast::ast_get_str2(ast_storage, init_node)
          if str_byte_len(idx_str2) > 0
            if typecheck_registry::tc_lookup_struct(tc, idx_str2).is_found()
              struct_name = idx_str2
            end
          end
        elsif init_kind == node_constants::NODE_BINARY
          # Binary op: c = a + b — struct name annotated in str2 by tc_check_op_overload
          var bin_str2 = ast::ast_get_str2(ast_storage, init_node)
          if str_byte_len(bin_str2) > 0
            if typecheck_registry::tc_lookup_struct(tc, bin_str2).is_found()
              struct_name = bin_str2
            end
          end
        elsif init_kind == node_constants::NODE_FIELD_ACCESS
          # `var t = h.current` — propagate struct identity from the field's
          # registered annotation. Without this, struct_name stays "" and a
          # subsequent `t.method` falls through B.6 paren-elision's
          # empty-struct branch and mis-dispatches to any in-scope free
          # function with the same name (e.g. trait Error's `def kind(self)`
          # auto-imported via `import * from error`). Closes
          # STRUCT_FIELD_LOCAL_COPY_METHOD_DISPATCH (2026-05-08).
          var fa_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, init_node)
          if str_byte_len(fa_ann) > 0
            var fa_lt = __char_index(fa_ann, '<')
            var fa_base = fa_ann
            if fa_lt > 0
              fa_base = str_byte_slice(fa_ann, 0, fa_lt)
            end
            if typecheck_registry::tc_lookup_struct(tc, fa_base).is_found()
              struct_name = fa_base
              type_ann = fa_ann
            end
          end
        elsif init_kind == node_constants::NODE_LAMBDA
          var params = ast::ast_get_left(ast_storage, init_node)
          if params > 0
            param_count = vec_size(params)
          else
            param_count = 0
          end
        end
      else
        var init_kind = ast::ast_get_kind(ast_storage, init_node)
        if init_kind == node_constants::NODE_LAMBDA
          var params = ast::ast_get_left(ast_storage, init_node)
          if params > 0
            param_count = vec_size(params)
          else
            param_count = 0
          end
        end
      end

      # NARROW_VEC_GOROUTINE_RETURN_CORRUPTION fix (option C side-channel):
      # `var v = await go f()` / `var v = async f()` / `var v = go f()`
      # — Future<T> is type-erased to TYPE_INT at the typechecker, so the LET
      # binding loses the inner callee's return-type annotation. Without that
      # annotation, `v[i]` for narrow Vec<Bool> falls back to 8-byte stride
      # reads (corrupting elements past slot 2), and `p.size` for a struct
      # field named `size` mis-resolves as vec_size(p). The fix:
      #
      # 1. NODE_GO / NODE_ASYNC_CALL initializer — look up the inner CALL's
      #    callee return annotation directly. This handles `var fut = go f()`
      #    where the binding stands in for the Future itself (the awaited
      #    result type still flows through fut → await fut).
      # 2. NODE_AWAIT initializer — handle two shapes:
      #    a. Direct: `var v = await go f()` — handle_node is NODE_GO/_CALL.
      #    b. Indirect: `var v = await fut` — handle_node is NODE_IDENT;
      #       inherit struct_name/type_ann from fut's binding (set by step 1).
      #
      # Runtime type stays TYPE_INT — only the side-channel metadata changes.
      # Mirrors the parsing pattern used in the NODE_IDENT handling above for
      # function-call initializers (see lines ~2289-2311).
      if str_byte_len(struct_name) == 0 and str_byte_len(type_ann) == 0
        var fix_init_kind = ast::ast_get_kind(ast_storage, init_node)
        # _resolve_callee_ret returns inner CALL node's callee return annotation,
        # or "" if the path doesn't match.
        var fix_inner_call_node = -1
        if fix_init_kind == node_constants::NODE_GO or fix_init_kind == node_constants::NODE_ASYNC_CALL
          # Direct go/async: init_node.left is the inner NODE_CALL.
          fix_inner_call_node = ast::ast_get_left(ast_storage, init_node)
        elsif fix_init_kind == node_constants::NODE_AWAIT
          # await: init_node.left is the awaited expression.
          var fix_awaited = ast::ast_get_left(ast_storage, init_node)
          if fix_awaited >= 0
            var fix_awaited_kind = ast::ast_get_kind(ast_storage, fix_awaited)
            if fix_awaited_kind == node_constants::NODE_GO or fix_awaited_kind == node_constants::NODE_ASYNC_CALL
              # Direct: `var v = await go f()` — peel one more layer.
              fix_inner_call_node = ast::ast_get_left(ast_storage, fix_awaited)
            elsif fix_awaited_kind == node_constants::NODE_IDENT
              # Indirect: `var v = await fut` — inherit from fut's binding.
              var fut_name = ast::ast_get_str1(ast_storage, fix_awaited)
              struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, fut_name)
              type_ann = typecheck_util::tc_scope_lookup_annotation(tc, fut_name)
            end
          end
        end
        # Resolve the inner CALL's callee return annotation if we found a path
        # that points to one (cases 1 and 2a above).
        if fix_inner_call_node >= 0
          if ast::ast_get_kind(ast_storage, fix_inner_call_node) == node_constants::NODE_CALL
            var fix_inner_callee = ast::ast_get_left(ast_storage, fix_inner_call_node)
            if fix_inner_callee >= 0
              if ast::ast_get_kind(ast_storage, fix_inner_callee) == node_constants::NODE_IDENT
                var fix_callee_name = ast::ast_get_str1(ast_storage, fix_inner_callee)
                var fix_ret_ann = typecheck_registry::tc_lookup_function_return_annotation(tc, fix_callee_name)
                if str_byte_len(fix_ret_ann) > 0
                  # Parse base name (e.g., "Vec<Bool>" -> "Vec", "Pair" -> "Pair").
                  var fix_lt_pos = __char_index(fix_ret_ann, '<')
                  var fix_base = fix_ret_ann
                  if fix_lt_pos > 0
                    fix_base = str_byte_slice(fix_ret_ann, 0, fix_lt_pos)
                  end
                  # Only set struct_name if the base is a USER-registered struct.
                  # Builtin containers (Vec/Map/Set/String/...) must NOT be set
                  # as struct_name — that would route v[i] / v.method() through
                  # impl-method dispatch for non-existent Vec impls. For builtins
                  # we still set type_ann so .size / for-in / vec-elem-typed
                  # codegen paths can recover the container shape.
                  if typecheck_registry::tc_lookup_struct(tc, fix_base).is_found()
                    struct_name = fix_base
                    if fix_lt_pos > 0
                      type_ann = fix_ret_ann
                    end
                  else
                    # Builtin container (Vec<T>, Map<K,V>, etc.): set type_ann
                    # only. Leaves struct_name empty so dispatch falls through
                    # to the existing builtin handler paths.
                    if fix_lt_pos > 0
                      type_ann = fix_ret_ann
                    end
                  end
                end
              end
            end
          end
        end
        # Write the recovered annotation back to the LET AST node's str2 so
        # MIR-level handlers (mir_ctx_mark_vec_elem_type, mir_ctx_mark_map_key_type,
        # mir_ctx_mark_struct_var) pick it up. Without this back-stamp,
        # narrow-element Vec<T> awaits codegen with wrong stride (i64 instead
        # of i8 etc), corrupting elements past the first cache line. Only
        # back-stamp when the parser left str2 empty — never overwrite an
        # explicit user annotation (`var v: T = ...`). Applies to all the
        # branches above (direct go/async, await go/async, await IDENT).
        if str_byte_len(let_type_ann) == 0 and str_byte_len(type_ann) > 0
          ast::ast_set_str2(ast_storage, node, type_ann)
        end
      end

      # Ptype annotation: when init_type is a parameterized type (Vec<Int>, Map<K,V>, etc.)
      # reconstruct type_ann so downstream UFCS dispatch and .size can recover the container type.
      if str_byte_len(type_ann) == 0 and init_type >= type_constants::PTYPE_BASE
        # For generic struct ptypes, resolve the actual struct name from the init expression
        # rather than using tc_type_name_full which produces "Struct<Int>" instead of "GBox<Int>"
        var ptype_base = typecheck::tc_base_kind(tc, init_type)
        if ptype_base == type_constants::TYPE_STRUCT or ptype_base == type_constants::TYPE_ENUM
          type_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, init_node)
          if str_byte_len(type_ann) > 0 and str_byte_len(struct_name) == 0
            var lt_pos = __char_index(type_ann, '<')
            if lt_pos > 0
              struct_name = str_byte_slice(type_ann, 0, lt_pos)
            else
              struct_name = type_ann
            end
          end
        end
        if str_byte_len(type_ann) == 0
          type_ann = typecheck::tc_type_name_full(tc, init_type)
        end
      end

      # Array/list-comp annotation: infer container type from initializer expression
      # when no ptype is available (e.g., `words = ["hello", "world"]`, `big = [x for x in arr]`)
      if str_byte_len(type_ann) == 0
        var init_kind_ann = ast::ast_get_kind(ast_storage, init_node)
        if init_kind_ann == node_constants::NODE_ARRAY or init_kind_ann == node_constants::NODE_LIST_COMP
          type_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, init_node)
        end
      end

      # R2.3 — effect-op struct-return field-type propagation. When the init is
      # an effect-op call whose return type is a nominal struct id (e.g. `var r =
      # exec(cmd, opts)` where `exec: ... -> ExecResult`), none of the callee-name
      # derivations above fire: the op name (`exec`) is neither a registered
      # struct nor a registered function, so `struct_name` stayed "". Recover the
      # name directly from `init_type`'s nominal struct id. Without this, `r.stderr`
      # falls to the GLOBAL field-name table → mis-typed as Int → the arg-type
      # check (and the QZ0215 audit) false-flag a genuine String field. General
      # over any path that yields a nominal struct id with no derived name.
      if str_byte_len(struct_name) == 0
        var r23_sidx = typecheck::tc_struct_idx_from_type(init_type)
        if r23_sidx >= 0 and r23_sidx < tc.registry.struct_names.size
          struct_name = tc.registry.struct_names[r23_sidx]
        end
      end


      # Never bind with type_constants$TYPE_ERROR — it conflicts with tc_scope_lookup's "not found" sentinel.
      # Fall back to type_constants$TYPE_INT (everything is i64 at runtime).
      if init_type == type_constants::TYPE_ERROR
        init_type = type_constants::TYPE_INT
      end
      # PSQ-6 / Sched effect, Phase A.5b item 1 (2026-05-01): when the user
      # writes `var f: Fn(...): T can E = ...` the can clause carries the
      # row information that the call-site QZ1408 check needs to read. The
      # canonical type-name reconstruction above strips it, so override
      # type_ann with the user's literal annotation when it's a Fn type.
      # HB-DOG.3(c) close-out: also accept aliased Fn types so the user's
      # `var f: Mapper = ...` (where `type Mapper = Fn(...)`) is preserved.
      if str_byte_len(let_type_ann) >= 3 and typecheck::_tc_is_fn_ann(tc, let_type_ann)
        type_ann = let_type_ann
      end
      # Generalization (INFER_TYPE_PARAM_MAPPING_WRAPPED_PARAMS, 2026-05-04):
      # the init-driven `type_ann` derivation paths above often produce a bare
      # struct/enum name (`FrameMsg`) when the user wrote a richer annotation
      # with type args (`tui::FrameMsg<SpecMsg>`). Without the type args,
      # downstream inference of generic call sites that take this binding as
      # an arg can't bind the corresponding type param. Trust the user's
      # explicit annotation when it carries angle brackets the derived form
      # is missing.
      if str_byte_len(let_type_ann) > 0 and __char_index(let_type_ann, '<') > 0
        if str_byte_len(type_ann) == 0 or __char_index(type_ann, '<') < 0
          type_ann = let_type_ann
        end
      end
      # Phase 7: opacity — default the display marker to the dispatch annotation
      # so source-level type matching has something to compare against.
      if str_byte_len(display_type) == 0
        display_type = type_ann
      end
      # QZ0167: reject explicit annotation that names the concrete behind an
      # opaque return. The user can drop the annotation entirely (`var x = f()`)
      # and inference will pick up the dispatch type.
      if typecheck_registry::tc_is_opaque_marker(display_type) and str_byte_len(let_type_ann) > 0
        if not typecheck_registry::tc_is_opaque_marker(let_type_ann)
          error("QZ0167: cannot assign opaque type `#{display_type}` to explicit type `#{let_type_ann}`. Drop the annotation: `var #{var_name} = ...`", line, col)
        end
      end
      # IS_PREDICATE_CROSS_ENUM_TAG_COLLISION: capture the enum name on bare
      # TYPE_ENUM bindings with an explicit annotation (`var c: Cmd = ...`).
      # Without this, `tc_scope_lookup_struct_name(c)` returns "" and the
      # `is X` predicate at typecheck and MIR-lower time can't validate that
      # X belongs to Cmd — falls back to a global variant search that picks
      # the wrong enum on same-named variants. The struct-typed init paths
      # above already capture this; enums need their own path.
      if str_byte_len(struct_name) == 0 and str_byte_len(let_type_ann) > 0
        var ic_init_base_for_enum = init_type
        if init_type >= type_constants::PTYPE_BASE
          ic_init_base_for_enum = typecheck::tc_base_kind(tc, init_type)
        end
        if init_type == type_constants::TYPE_ENUM or ic_init_base_for_enum == type_constants::TYPE_ENUM
          var ic_let_base = let_type_ann
          var ic_let_lt = __char_index(ic_let_base, '<')
          if ic_let_lt > 0
            ic_let_base = str_byte_slice(ic_let_base, 0, ic_let_lt)
          end
          # Only stamp if it actually resolves to a registered enum — guards
          # against confused annotations leaking through.
          if typecheck_registry::tc_lookup_enum(tc, ic_let_base).is_found()
            struct_name = ic_let_base
          end
        end
      end
      # IS_PRED_VEC_ELEM_NO_ENUM_NAME (2026-05-07): no-annotation enum
      # bindings whose init carries the element enum identity in a
      # side-channel slot — extend the explicit-annotation path above.
      # Currently covers `var msg = vec[i]` over Vec<Enum>: tc_expr_index
      # stamps the index node's str2 with the element's struct/enum name,
      # and we lift it onto the binding when init resolves to TYPE_ENUM.
      # Without this, downstream `binding is Variant` falls back to a
      # global variant search and picks the wrong enum on same-named-
      # variant collisions (sister to the explicit-annotation case above).
      if str_byte_len(struct_name) == 0
        var ie_init_base_for_enum = init_type
        if init_type >= type_constants::PTYPE_BASE
          ie_init_base_for_enum = typecheck::tc_base_kind(tc, init_type)
        end
        if init_type == type_constants::TYPE_ENUM or ie_init_base_for_enum == type_constants::TYPE_ENUM
          var ie_init_kind = ast::ast_get_kind(ast_storage, init_node)
          if ie_init_kind == node_constants::NODE_INDEX
            var ie_idx_str2 = ast::ast_get_str2(ast_storage, init_node)
            if str_byte_len(ie_idx_str2) > 0
              if typecheck_registry::tc_lookup_enum(tc, ie_idx_str2).is_found()
                struct_name = ie_idx_str2
              end
            end
          end
        end
      end
      # F4 (item 9f) — back-stamp a value-layout `Vec<S>` annotation onto the LET
      # AST node's str2 so the MIR LET handler (`let_type_ann.starts_with("Vec<")`
      # → mir_ctx_mark_vec_elem_type) registers the binding's element type. The
      # element-preserving HOFs (filter/take/drop/sorted/reversed) are typed bare
      # TYPE_VEC at registration; item 9f's tc_expr_call refinement rebuilds the
      # result as a `Vec<S>` ptype (when the source element is value-layout), and
      # the ptype/array back-stamp paths above derived `type_ann = "Vec<S>"` into
      # the SCOPE binding — but the LET NODE's str2 (the slot MIR actually reads)
      # is only written for the go/async paths (~3762). Without writing it here,
      # `hi = v.filter{…}` reaches MIR with an empty str2 → `hi`'s element type is
      # never registered → `hi[i].field` falls to the untyped-i64 path and SKIPS
      # the cow +1 / narrow typed-GEP. Mirror the go/async back-stamp: only when
      # the parser left str2 empty (never overwrite a user `var v: T =`) AND the
      # derived `type_ann` is a `Vec<S>` of a VALUE-LAYOUT element. Reference /
      # scalar `Vec<T>` keep their empty str2 (byte-identical), and the predicate
      # is gate-0-dead (zero @value Vec bindings in the compiler's own source).
      if str_byte_len(let_type_ann) == 0 and type_ann.starts_with("Vec<")
        var f9f_elem = typecheck::tc_extract_element_type(type_ann)
        if str_byte_len(f9f_elem) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, f9f_elem) == 1
          ast::ast_set_str2(ast_storage, node, type_ann)
        end
      end
      # F4 (item 9b-find) — back-stamp a value-layout `Option<S>` annotation onto the
      # LET node's str2 so the MIR LET handler (`let_type_ann.starts_with("Option<")`
      # → mir_ctx_mark_struct_var) registers `r`'s var-type as `Option<S>`. find's
      # tc_expr_call refinement (typecheck_expr_handlers) rebuilds the result as an
      # `Option<S>` ptype (when the source element is value-layout) and the ptype
      # back-stamp above derived `type_ann = "Option<S>"` into the SCOPE binding — but
      # the LET NODE's str2 (the slot MIR reads to track the var-type) is only written
      # for the go/async paths (~3762). Without writing it here, `r = v.find{…}`
      # reaches MIR with an empty str2 → `r`'s type is never tracked as Option<S> →
      # `mir_option_subject_is_inline_value(r.unwrap())` is false → the item-23 inline
      # unwrap never fires and `r.some?`/`r.unwrap()` mis-read. Mirror the 9f Vec
      # back-stamp: only when the parser left str2 empty (never overwrite a user
      # `var r: T =`) AND the derived `type_ann` is an `Option<S>` of a VALUE-LAYOUT
      # element. Reference / scalar `Option<T>` bindings keep their empty str2
      # (byte-identical), and the predicate is gate-0-dead (zero @value Option<S> find
      # bindings in the compiler's own source).
      if str_byte_len(let_type_ann) == 0 and type_ann.starts_with("Option<")
        var f9b_pl = typecheck::tc_extract_element_type(type_ann)
        if str_byte_len(f9b_pl) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, f9b_pl) == 1
          ast::ast_set_str2(ast_storage, node, type_ann)
        end
      end
      # F4 (item 50) — back-stamp a value-layout struct annotation `S` onto the LET
      # node's str2 so the MIR LET handler (`let_ann_for_struct` registered-struct
      # match → mir_ctx_mark_struct_var) tracks `f = v.first()` / `l = v.last()` as
      # struct-typed S. first/last's tc_expr_call refinement (typecheck_expr_handlers)
      # rebuilds the result as the bare element struct S (when the source element is
      # value-layout), and the struct-ptype back-stamp above derived `type_ann = "S"`
      # into the SCOPE binding — but the LET NODE's str2 (the slot MIR reads to track
      # the var-type) is only written for the go/async paths (~3762). Without writing
      # it here, `f = v.first()` reaches MIR with an empty str2 → `f`'s struct type is
      # never tracked → `f.field` falls to the GLOBAL untyped-i64 field path (no
      # value-layout offset) → mis-read. Mirror the 9f/9b back-stamps: only when the
      # parser left str2 empty (never overwrite a user `var f: T =`) AND the derived
      # `type_ann` names a VALUE-LAYOUT struct. Reference / scalar bindings keep their
      # empty str2 (byte-identical), and the predicate is gate-0-dead (zero @value
      # first/last bindings in the compiler's own source).
      if str_byte_len(let_type_ann) == 0 and str_byte_len(type_ann) > 0 and not type_ann.starts_with("Vec<") and not type_ann.starts_with("Option<") and __char_index(type_ann, '<') < 0
        if typecheck_registry::tc_is_value_layout_struct_name(tc, type_ann) == 1
          ast::ast_set_str2(ast_storage, node, type_ann)
        end
      end
      typecheck_util::tc_scope_bind_full_with_display(tc, var_name, init_type, is_mutable, param_count, struct_name, type_ann, display_type)
      # Macro hygiene (P3.c): propagate the LET node's scope set onto the
      # fresh binding. For NODE_LETs born outside any macro expansion this
      # is 0 (empty set), a no-op. For bodies cloned during `$macro(...)`
      # expansion, the expander stamped the scope set in P3.b; this line
      # is what makes the resolver's "largest subset" rule pick the body
      # binding over a caller-scope binding with the same name.
      typecheck_util::tc_scope_set_last_binding_scope(tc, ast::ast_get_scope_set(ast_storage, node))

      # Register pending map_new init: if RHS is a `map_new()` call, record the
      # init AST node so that a later constraining map_set/map_insert can stamp
      # this node's str2 with the inferred key type. Without this, the map_new
      # codegen would always allocate the string-key layout — and a subsequent
      # int-key set on it would crash with a layout mismatch.
      var pending_init_kind = ast::ast_get_kind(ast_storage, init_node)
      if pending_init_kind == node_constants::NODE_CALL
        var pending_callee = ast::ast_get_left(ast_storage, init_node)
        if ast::ast_get_kind(ast_storage, pending_callee) == node_constants::NODE_IDENT
          if ast::ast_get_str1(ast_storage, pending_callee) == "map_new"
            tc.pending_map_new_vars.push(var_name)
            tc.pending_map_new_nodes.push(init_node)
          end
          # WS1 — same for set_new: record so a later constraining set_add with a
          # value-layout struct element can back-stamp the layout annotation.
          if ast::ast_get_str1(ast_storage, pending_callee) == "set_new"
            tc.pending_set_new_vars.push(var_name)
            tc.pending_set_new_nodes.push(init_node)
          end
        end
      end

      # Level-based generalization: exit the level before generalizing
      typecheck_util::tc_tv_exit_level()

      # T3c.1 Phase 3: Let-polymorphism — generalize const bindings
      if is_mutable == 0
        var let_scheme = typecheck_util::tc_generalize(tc, init_type)
        if let_scheme.size > 0
          var let_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
          if let_bidx >= 0 and let_bidx < tc.scope.binding_schemes.size
            tc.scope.binding_schemes[let_bidx] = let_scheme
          end
        end
      end

      # FIX.6 Phase 1: Register pending ptype for bare container types.
      # When vec_new()/map_new()/set_new()/deque_new() is called without type params,
      # the init_type is a bare container type (no ptype). Register a pending ptype so
      # deferred UFCS (Phase 3) can detect unresolved containers.
      if init_type == type_constants::TYPE_VEC and str_byte_len(type_ann) == 0
        typecheck_util::tc_register_pending_ptype(tc, var_name, type_constants::TYPE_VEC, 0, 0)
      elsif init_type == type_constants::TYPE_MAP and str_byte_len(type_ann) == 0
        typecheck_util::tc_register_pending_ptype(tc, var_name, type_constants::TYPE_MAP, 0, 0)
      elsif init_type == type_constants::TYPE_SET and str_byte_len(type_ann) == 0
        typecheck_util::tc_register_pending_ptype(tc, var_name, type_constants::TYPE_SET, 0, 0)
      elsif init_type == type_constants::TYPE_CHANNEL and str_byte_len(type_ann) == 0
        typecheck_util::tc_register_pending_ptype(tc, var_name, type_constants::TYPE_CHANNEL, 0, 0)
      end

      # Borrow tracking: if init is &var or &mut var, record borrow source
      var init_kind_b = ast::ast_get_kind(ast_storage, init_node)
      if init_kind_b == node_constants::NODE_FUNC_REF
        var borrow_src_name = ast::ast_get_str1(ast_storage, init_node)
        var borrow_is_mut = ast::ast_get_int_val(ast_storage, init_node)
        var new_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
        if new_bidx >= 0
          tc.safety.binding_borrow_sources[new_bidx] = borrow_src_name
          tc.safety.binding_is_mut_borrows[new_bidx] = borrow_is_mut
          tc.safety.binding_borrow_lines[new_bidx] = line
          tc.safety.binding_borrow_cols[new_bidx] = col
          # Multi-level borrow: propagate protection up the borrow chain (QZ1217)
          typecheck::tc_propagate_borrow_chain(tc, borrow_src_name, borrow_is_mut)
          # Lifetime check (QZ1218): ensure source lives at least as long as borrow holder
          var src_bidx = typecheck_util::tc_lookup_binding_index(tc, borrow_src_name)
          if src_bidx >= 0
            var src_depth = tc.scope.binding_depths[src_bidx]
            var holder_depth = tc.scope.binding_depths[new_bidx]
            if src_depth > holder_depth
              error("QZ1218: Borrow of '#{borrow_src_name}' would outlive its source (source is in a deeper scope)", line, col)
            end
          end
        end
      end

      # T3c.2 Phase 3: If a call returned a value that borrows from a param,
      # record the borrow chain on the new binding.
      if typecheck_util::tc_pending_borrow_get().size == 2
        var prb_src = as_string(typecheck_util::tc_pending_borrow_get()[0])
        var prb_kind = typecheck_util::tc_pending_borrow_get()[1]
        var prb_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
        if prb_bidx >= 0
          tc.safety.binding_borrow_sources[prb_bidx] = prb_src
          tc.safety.binding_is_mut_borrows[prb_bidx] = prb_kind - 1
          tc.safety.binding_borrow_lines[prb_bidx] = line
          tc.safety.binding_borrow_cols[prb_bidx] = col
        end
        typecheck_util::tc_pending_borrow_clear()
      end

      # Arena safety tracking: track @arena_name allocations
      var init_kind_a = ast::ast_get_kind(ast_storage, init_node)
      if init_kind_a == 20  # node_constants$NODE_ALLOC_EXPR
        var alloc_target = ast::ast_get_str1(ast_storage, init_node)
        if alloc_target != "heap"
          typecheck::tc_arena_track_alloc(tc, var_name, alloc_target, line)
        end
      elsif init_kind_a == node_constants::NODE_CALL
        var callee_a = ast::ast_get_left(ast_storage, init_node)
        if ast::ast_get_kind(ast_storage, callee_a) == node_constants::NODE_IDENT
          var callee_name_a = ast::ast_get_str1(ast_storage, callee_a)
          if callee_name_a == "pool_alloc"
            var pool_args = ast::ast_get_children(ast_storage, init_node)
            var pool_name = "pool"
            if pool_args.size > 0
              var pool_arg = pool_args[0]
              if ast::ast_get_kind(ast_storage, pool_arg) == node_constants::NODE_IDENT
                pool_name = ast::ast_get_str1(ast_storage, pool_arg)
              end
            end
            typecheck::tc_arena_track_alloc(tc, var_name, pool_name, line)
          elsif callee_name_a == "arena_alloc"
            var arena_args = ast::ast_get_children(ast_storage, init_node)
            var arena_name = "arena"
            if arena_args.size > 0
              var arena_arg = arena_args[0]
              if ast::ast_get_kind(ast_storage, arena_arg) == node_constants::NODE_IDENT
                arena_name = ast::ast_get_str1(ast_storage, arena_arg)
              end
            end
            typecheck::tc_arena_track_alloc(tc, var_name, arena_name, line)
          end
        end
      end

      # Arena alias propagation: if init is an identifier tracked as arena-allocated,
      # propagate tracking to the new variable
      var init_kind_ap = ast::ast_get_kind(ast_storage, init_node)
      if init_kind_ap == node_constants::NODE_IDENT
        var src_alias_name = ast::ast_get_str1(ast_storage, init_node)
        typecheck::tc_arena_propagate_alias(tc, var_name, src_alias_name, line)
      end

      # Linear type tracking: mark binding as linear if init is a linear struct
      if typecheck::tc_is_struct_type(init_type)
        if str_byte_len(struct_name) > 0
          if typecheck_registry::tc_struct_is_linear(tc, struct_name)
            typecheck_registry::tc_mark_binding_linear(tc, var_name, struct_name)
            # Move semantics: if init is an identifier, consume the source
            var init_kind = ast::ast_get_kind(ast_storage, init_node)
            if init_kind == node_constants::NODE_IDENT
              var src_name = ast::ast_get_str1(ast_storage, init_node)
              typecheck_registry::tc_consume_linear(tc, src_name, line, col)
            end
          end
        end
      end

      # Protocol tracking: if the type is Channel<Protocol>, mark the binding
      if init_type == type_constants::TYPE_CHANNEL or (typecheck::tc_is_ptype(init_type) and typecheck::tc_base_kind(tc, init_type) == type_constants::TYPE_CHANNEL)
        if typecheck::tc_is_ptype(init_type)
          var chan_inner = typecheck::tc_ptype_arg1(tc, init_type)
          if chan_inner >= type_constants::PROTOCOL_BASE and chan_inner < type_constants::PROTOCOL_BASE + 1000
            var proto_idx = chan_inner - type_constants::PROTOCOL_BASE
            # Extract type args from annotation if generic protocol (e.g., Channel<Echo<Int>>)
            var proto_type_args = ""
            if str_byte_len(let_type_ann) > 0
              # Parse "Channel<Echo<Int>>" → inner "Echo<Int>" → extract args from "Echo<Int>"
              var chan_open = __char_index(let_type_ann, '<')
              if chan_open > 0
                var chan_inner_str = str_byte_slice(let_type_ann, chan_open + 1, str_byte_len(let_type_ann) - 1)
                # Check if inner has type args: "Echo<Int>" → args = "Int"
                var inner_open = __char_index(chan_inner_str, '<')
                if inner_open > 0
                  proto_type_args = str_byte_slice(chan_inner_str, inner_open + 1, str_byte_len(chan_inner_str) - 1)
                end
              end
            end
            typecheck_registry::tc_mark_binding_protocol_with_args(tc, var_name, proto_idx, proto_type_args)
          end
        end
      end

      # Move semantics: mark binding as moveable if type has Drop (not linear, not Copy)
      if typecheck::tc_is_struct_type(init_type)
        if str_byte_len(struct_name) > 0
          if typecheck_registry::tc_struct_is_linear(tc, struct_name) == 0
            if typecheck_registry::tc_type_needs_move_tracking(tc, struct_name)
              typecheck_registry::tc_mark_binding_moveable(tc, var_name, struct_name)
              # If init is an identifier, move from source
              var init_kind_m = ast::ast_get_kind(ast_storage, init_node)
              if init_kind_m == node_constants::NODE_IDENT
                var src_name_m = ast::ast_get_str1(ast_storage, init_node)
                typecheck_registry::tc_move_value(tc, src_name_m, var_name, line, col)
              elsif init_kind_m == node_constants::NODE_FIELD_ACCESS
                # Partial move: var y = r.x moves field x from r
                var pm_base = ast::ast_get_left(ast_storage, init_node)
                if ast::ast_get_kind(ast_storage, pm_base) == node_constants::NODE_IDENT
                  var pm_base_name = ast::ast_get_str1(ast_storage, pm_base)
                  var pm_field_name = ast::ast_get_str1(ast_storage, init_node)
                  typecheck_registry::tc_partial_move_field(tc, pm_base_name, pm_field_name, var_name, line, col)
                end
              end
            end
          end
        end
      end

      # Partial move for let-binding from field of a Drop struct
      # Handles: var x = r.field where r's type has Drop but field type is not a struct
      # The above check only fires when init_type == TYPE_STRUCT, missing primitive fields
      if init_type != type_constants::TYPE_STRUCT
        var init_kind_pm = ast::ast_get_kind(ast_storage, init_node)
        if init_kind_pm == node_constants::NODE_FIELD_ACCESS
          var pm_base2 = ast::ast_get_left(ast_storage, init_node)
          if ast::ast_get_kind(ast_storage, pm_base2) == node_constants::NODE_IDENT
            var pm_base_name2 = ast::ast_get_str1(ast_storage, pm_base2)
            var pm_struct_name2 = typecheck_util::tc_scope_lookup_struct_name(tc, pm_base_name2)
            if str_byte_len(pm_struct_name2) > 0
              if typecheck_registry::tc_type_needs_move_tracking(tc, pm_struct_name2)
                var pm_field_name2 = ast::ast_get_str1(ast_storage, init_node)
                # Copy-type fields are copied by the read, not moved. Only mark a
                # partial move when the FIELD's own type needs move tracking.
                if typecheck_registry::tc_field_read_moves(tc, pm_struct_name2, pm_field_name2) == 1
                  typecheck_registry::tc_partial_move_field(tc, pm_base_name2, pm_field_name2, var_name, line, col)
                end
              end
            end
          end
        end
      end
    end

  # Global variable (node_constants$NODE_GLOBAL_VAR = 42)
  # Same as let binding but for module-level var/const declarations
  elsif node_kind == node_constants::NODE_GLOBAL_VAR
    var var_name = ast::ast_get_str1(ast_storage, node)
    var init_node = ast::ast_get_right(ast_storage, node)
    var is_mutable = ast::ast_get_int_val(ast_storage, node)
    # PSQ-6 / Sched effect, Phase A.5b item 3 (2026-05-01): `@thread_local`
    # flag lives in the op slot (set by ast_global_var). TLS bindings are
    # per-thread by definition, so the Sync check at QZ1408 must skip
    # them. Record the name in tc.thread_local_globals for lookup at the
    # NODE_IDENT emission site.
    var is_thread_local = ast::ast_get_op(ast_storage, node)
    if is_thread_local == 1
      tc.thread_local_globals.set(var_name, 1)
    end

    # Note: init_node >= 0 because node handle 0 is valid (first AST node)
    # Global vars always have initializers (parser requires them)
    var init_type = tc_expr(tc, ast_storage, init_node)
    
    # If tc_expr couldn't determine type, assign a fresh type variable
    if init_type == type_constants::TYPE_ERROR
      init_type = typecheck_util::tc_tv_fresh_with_origin(tc, line, col, "global #{var_name}")
    end

    # Check if variable already exists at current scope
    if typecheck_util::tc_scope_has_at_current(tc, var_name)
      error("Global variable already defined: #{var_name}", line, col)
    else
      # Bind global variable in scope, with param count if it's a lambda
      var param_count = -1
      var struct_name = ""
      var type_ann = ""
      var init_kind = ast::ast_get_kind(ast_storage, init_node)
      if typecheck::tc_is_struct_type(init_type)
        if init_kind == node_constants::NODE_CALL
          var callee = ast::ast_get_left(ast_storage, init_node)
          if ast::ast_get_kind(ast_storage, callee) == node_constants::NODE_IDENT
            struct_name = ast::ast_get_str1(ast_storage, callee)
          end
        end
      end
      if init_kind == node_constants::NODE_LAMBDA
        var params = ast::ast_get_left(ast_storage, init_node)
        if params > 0
          param_count = vec_size(params)
        else
          param_count = 0
        end
      end
      # Ptype annotation: reconstruct type_ann for parameterized types (Vec<Int>, etc.)
      if str_byte_len(type_ann) == 0 and init_type >= type_constants::PTYPE_BASE
        type_ann = typecheck::tc_type_name_full(tc, init_type)
      end
      typecheck_util::tc_scope_bind_full(tc, var_name, init_type, is_mutable, param_count, struct_name, type_ann)
    end
  
  # Const declaration (node_constants$NODE_CONST_DECL = 69)
  # Like global var but always immutable
  elsif node_kind == node_constants::NODE_CONST_DECL
    var var_name = ast::ast_get_str1(ast_storage, node)
    var init_node = ast::ast_get_right(ast_storage, node)
    var init_type = tc_expr(tc, ast_storage, init_node)
    
    if init_type == type_constants::TYPE_ERROR
      init_type = typecheck_util::tc_tv_fresh_with_origin(tc, line, col, "const #{var_name}")
    end

    if typecheck_util::tc_scope_has_at_current(tc, var_name)
      error("Constant already defined: #{var_name}", line, col)
    else
      typecheck_util::tc_scope_bind_with_params(tc, var_name, init_type, 0, -1, "")
    end
  
  # Static assert (node_constants$NODE_STATIC_ASSERT = 70)
  # Type-check the condition expression; actual evaluation is in MIR
  elsif node_kind == node_constants::NODE_STATIC_ASSERT
    var cond_node = ast::ast_get_left(ast_storage, node)
    var cond_type = tc_expr(tc, ast_storage, cond_node)
    # Condition should be a boolean/integer expression
  
  # Tuple destructuring: var (a, b) = expr
  elsif node_kind == node_constants::NODE_LET_DESTRUCTURE
    var init_node = ast::ast_get_left(ast_storage, node)
    var is_mutable = ast::ast_get_int_val(ast_storage, node)
    var names_str = ast::ast_get_str1(ast_storage, node)
    var init_type = tc_expr(tc, ast_storage, init_node)
    # Split names by comma
    var names = str_split(names_str, ",")
    var arity = names.size
    # Validate init is a tuple with matching arity
    var init_base = typecheck::tc_base_kind(tc, init_type)
    if init_base == type_constants::TYPE_TUPLE
      var tuple_arity = typecheck::tc_ptype_arg1(tc, init_type)
      if tuple_arity != arity
        error("Destructuring pattern has #{str_from_int(arity)} bindings but tuple has #{str_from_int(tuple_arity)} elements", line, col)
      end
      # Bind each name with its element type. The 5th arg (struct_name)
      # is mandatory: omitting it leaves binding_struct_names[i] holding
      # uninitialized memory, which mx_resolve_enum_name later feeds to
      # str_byte_len when the tuple-bound name is the subject of a `match`
      # on an enum — yielding a SIGSEGV with no diagnostic.
      for di in 0..arity
        var dname = names[di]
        var elem_type = typecheck_util::tc_tuple_elem_type(tc, init_type, di)
        typecheck_util::tc_scope_bind(tc, dname, elem_type, is_mutable, "")
      end
    else
      # Not a tuple — bind all as Int (fallback for untyped tuples)
      for di in 0..arity
        var dname = names[di]
        typecheck_util::tc_scope_bind(tc, dname, type_constants::TYPE_INT, is_mutable, "")
      end
    end

  # Struct destructuring: Point { x, y } = expr / var { x, y } = expr
  elsif node_kind == node_constants::NODE_STRUCT_DESTRUCTURE
    var init_node = ast::ast_get_left(ast_storage, node)
    var is_mutable = ast::ast_get_int_val(ast_storage, node)
    var type_name = ast::ast_get_str1(ast_storage, node)
    var field_specs = ast::ast_get_str2(ast_storage, node)
    var has_rest = ast::ast_get_op(ast_storage, node)

    # Pattern context (match arm) — skip binding, handled by match lowering
    if is_mutable < 0
      # Type-check init if present (for-in desugar has init)
      if init_node > 0
        tc_expr(tc, ast_storage, init_node)
      end
    else
      # Statement context: type-check the init expression
      var init_type = tc_expr(tc, ast_storage, init_node)

      # Resolve struct type: from explicit name or from init expression type
      var resolved_name = type_name
      if str_byte_len(resolved_name) == 0
        # Infer from init expression
        var init_kind = ast::ast_get_kind(ast_storage, init_node)
        if init_kind == node_constants::NODE_STRUCT_INIT
          resolved_name = ast::ast_get_str1(ast_storage, init_node)
        elsif init_kind == node_constants::NODE_IDENT
          resolved_name = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, init_node))
        elsif init_kind == node_constants::NODE_CALL
          # Infer from function return type — use type annotation tracking
          var call_name = ast::ast_get_str1(ast_storage, init_node)
          resolved_name = typecheck_util::tc_scope_lookup_struct_name(tc, call_name)
          if str_byte_len(resolved_name) == 0
            # Try to get from the function's return type annotation
            resolved_name = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, init_node)
          end
        end
        if str_byte_len(resolved_name) == 0
          error("Cannot infer struct type for destructuring — provide explicit type name", line, col)
        end
      end

      # Look up struct definition
      var lookup = typecheck_registry::tc_lookup_struct(tc, resolved_name)
      if lookup.is_found()
        var struct_index = lookup.unwrap()
        var reg_field_names = tc.registry.struct_field_names[struct_index]
        var reg_field_types = tc.registry.struct_field_types[struct_index]
        var reg_field_count = reg_field_names.size

        # Parse field specs
        var specs = str_split(field_specs, ",")
        var spec_count = specs.size

        # Exhaustiveness check: without .., all fields must be named
        if has_rest == 0 and spec_count != reg_field_count
          error("Struct destructuring covers #{str_from_int(spec_count)} fields but '#{resolved_name}' has #{str_from_int(reg_field_count)} — use '..' to ignore remaining", line, col)
        end

        # Bind each field
        for fi in 0..spec_count
          var spec = specs[fi]
          var field_name = spec
          var bind_name = spec
          # Check for renaming: "field:alias"
          var colon_pos = __char_index(spec, ':')
          if colon_pos >= 0
            field_name = str_byte_slice(spec, 0, colon_pos)
            bind_name = str_byte_slice(spec, colon_pos + 1, str_byte_len(spec))
          end
          # Find field in struct
          var found_idx = -1
          for ri in 0..reg_field_count
            if reg_field_names[ri] == field_name
              found_idx = ri
            end
          end
          if found_idx < 0
            var field_names_vec = vec_new<String>()
            for fni in 0..reg_field_count
              field_names_vec.push(reg_field_names[fni])
            end
            var df_suggestion = typecheck_registry::tc_suggest(field_name, field_names_vec)
            error("Struct '#{resolved_name}' has no field '#{field_name}'#{df_suggestion}", line, col)
            typecheck_util::tc_scope_bind(tc, bind_name, type_constants::TYPE_INT, is_mutable, "")
          else
            var field_type = reg_field_types[found_idx]
            # Look up field annotation to get struct name for struct-typed fields
            var field_ann = typecheck::tc_struct_field_annotation(tc, struct_index, field_name)
            typecheck_util::tc_scope_bind(tc, bind_name, field_type, is_mutable, field_ann)
          end
        end
      else
        var ds_suggestion = typecheck_registry::tc_suggest(resolved_name, typecheck_registry::tc_all_struct_names(tc))
        error("Unknown struct type '#{resolved_name}' in destructuring#{ds_suggestion}", line, col)
        # Fallback: bind all as Int
        var specs = str_split(field_specs, ",")
        for fi in 0..specs.size
          var spec = specs[fi]
          var bind_name = spec
          var colon_pos = __char_index(spec, ':')
          if colon_pos >= 0
            bind_name = str_byte_slice(spec, colon_pos + 1, str_byte_len(spec))
          end
          typecheck_util::tc_scope_bind(tc, bind_name, type_constants::TYPE_INT, is_mutable, "")
        end
      end
    end

  # Vec destructuring: [a, b, ..rest] = expr
  elsif node_kind == node_constants::NODE_VEC_DESTRUCTURE
    var init_node = ast::ast_get_left(ast_storage, node)
    var is_mutable = ast::ast_get_int_val(ast_storage, node)
    var elem_names_str = ast::ast_get_str1(ast_storage, node)
    var rest_name = ast::ast_get_str2(ast_storage, node)
    var has_rest = ast::ast_get_op(ast_storage, node)

    if is_mutable < 0
      # Pattern context — skip
      if init_node > 0
        tc_expr(tc, ast_storage, init_node)
      end
    else
      var init_type = tc_expr(tc, ast_storage, init_node)

      # Bind each element as TYPE_INT (existential: all Vec elements are Int at runtime)
      var elems = str_split(elem_names_str, ",")
      for ei in 0..elems.size
        var ename = elems[ei]
        if str_byte_len(ename) > 0
          typecheck_util::tc_scope_bind(tc, ename, type_constants::TYPE_INT, is_mutable, "")
        end
      end

      # Bind rest as Vec type if present
      if has_rest == 1 and str_byte_len(rest_name) > 0
        typecheck_util::tc_scope_bind_full(tc, rest_name, type_constants::TYPE_INT, is_mutable, -1, "", "Vec<Int>")
      end
    end

  # Assignment - ASSIGN stores value in slot 7 (left), not slot 8 (right)
  elsif node_kind == node_constants::NODE_ASSIGN
    var var_name = ast::ast_get_str1(ast_storage, node)
    var value_node = ast::ast_get_left(ast_storage, node)
    
    var target_type = typecheck_util::tc_scope_lookup(tc, var_name)
    var is_mutable = typecheck_util::tc_scope_lookup_mutable(tc, var_name)

    if target_type == type_constants::TYPE_ERROR
      error("Undefined variable: #{var_name}", line, col)
    else
      typecheck::tc_check_mutation_while_borrowed(tc, var_name, line, col)
      typecheck::tc_release_old_borrow(tc, var_name)
      # Reset move state on reassignment — re-initialized values are live again
      # (mirrors NODE_LET reassignment path at ~6941)
      var as_reinit_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
      if as_reinit_bidx >= 0
        if tc.safety.move_states[as_reinit_bidx] == 2
          tc.safety.move_states[as_reinit_bidx] = 1
          tc.safety.move_targets[as_reinit_bidx] = ""
          tc.safety.move_lines[as_reinit_bidx] = 0
          tc.safety.move_cols[as_reinit_bidx] = 0
        end
        tc.safety.partial_moved_fields[as_reinit_bidx] = ""
        tc.safety.partial_move_targets[as_reinit_bidx] = ""
      end
      if is_mutable == 0
        error("Cannot assign to immutable variable: #{var_name}", line, col)
      end

      var value_type = tc_expr(tc, ast_storage, value_node)
      # SURF.FLOW Phase 2 soundness — assigning a narrowed Option read into an
      # Option/Result-typed target slot must NOT extract the payload (would store a
      # scalar into an Option word). Retract the stamp post-walk from the target type.
      tc_unstamp_narrowed_into_wide(tc, ast_storage, value_node, typecheck_util::tc_narrow_expect_base_of_type(tc, target_type))

      # SURF.FLOW Phase 2 — soundness invalidation. A reassignment of a narrowed
      # `var` makes the guard's proof stale (the new value could be None), so drop
      # any active refinement for this name. Done unconditionally on assign; a
      # no-op for non-narrowed names. const names can't reach here (QZ0106 above).
      typecheck_util::tc_narrow_invalidate(tc, var_name)

      if typecheck::tc_types_match(tc, target_type, value_type) == false
        error("Type mismatch in assignment: expected #{typecheck::tc_type_name_full(tc, target_type)} but got #{typecheck::tc_type_name_full(tc, value_type)}", line, col)
      # WS2.1 assign-side scalar soundness (QZ0201) — `tc_types_match` above is
      # defeated by the i64-equivalence short-circuit (tc_is_i64_type folds
      # TYPE_STRING into the i64 class), so `x: Int; x = "hi"` and the reverse
      # slip through as a silent miscompile / SIGSEGV. Reuse R2.3's narrow
      # predicate (String↔numeric + Int↔Float ONLY; every handle/newtype/struct/
      # Bool pun is permitted) to flag the definite scalar mismatches.
      else
        var as_rk = ast::ast_get_kind(ast_storage, value_node)
        if typecheck::tc_assign_scalar_mismatch(tc, target_type, value_type, as_rk == node_constants::NODE_INT_LIT, as_rk == node_constants::NODE_STRING_LIT, as_rk == node_constants::NODE_FLOAT_LIT) == 1
          error("Type mismatch in assignment to '#{var_name}': expected '#{typecheck::tc_type_name_full(tc, target_type)}' but got '#{typecheck::tc_type_name_full(tc, value_type)}' — String and numeric (or Int and Float) need an explicit conversion (QZ0201)", line, col)
        end
      end

      # Arena tracking on assignment: track @arena, arena_alloc, pool_alloc, or alias
      var assign_val_kind = ast::ast_get_kind(ast_storage, value_node)
      if assign_val_kind == 20  # NODE_ALLOC_EXPR
        var assign_alloc_target = ast::ast_get_str1(ast_storage, value_node)
        if assign_alloc_target != "heap"
          typecheck::tc_arena_track_alloc(tc, var_name, assign_alloc_target, line)
        end
      elsif assign_val_kind == node_constants::NODE_CALL
        var assign_callee = ast::ast_get_left(ast_storage, value_node)
        if assign_callee >= 0
          var assign_callee_kind = ast::ast_get_kind(ast_storage, assign_callee)
          if assign_callee_kind == node_constants::NODE_IDENT
            var assign_callee_name = ast::ast_get_str1(ast_storage, assign_callee)
            if assign_callee_name == "arena_alloc"
              var assign_arena_args = ast::ast_get_children(ast_storage, value_node)
              var assign_arena_name = "arena"
              if assign_arena_args.size > 0
                var assign_arena_arg = assign_arena_args[0]
                if ast::ast_get_kind(ast_storage, assign_arena_arg) == node_constants::NODE_IDENT
                  assign_arena_name = ast::ast_get_str1(ast_storage, assign_arena_arg)
                end
              end
              typecheck::tc_arena_track_alloc(tc, var_name, assign_arena_name, line)
            elsif assign_callee_name == "pool_alloc"
              var assign_pool_args = ast::ast_get_children(ast_storage, value_node)
              var assign_pool_name = "pool"
              if assign_pool_args.size > 0
                var assign_pool_arg = assign_pool_args[0]
                if ast::ast_get_kind(ast_storage, assign_pool_arg) == node_constants::NODE_IDENT
                  assign_pool_name = ast::ast_get_str1(ast_storage, assign_pool_arg)
                end
              end
              typecheck::tc_arena_track_alloc(tc, var_name, assign_pool_name, line)
            end
          end
        end
      elsif assign_val_kind == node_constants::NODE_IDENT
        var assign_src_name = ast::ast_get_str1(ast_storage, value_node)
        typecheck::tc_arena_propagate_alias(tc, var_name, assign_src_name, line)
      end

      # Record borrow source on assignment (mirrors NODE_LET reassignment path)
      if assign_val_kind == node_constants::NODE_FUNC_REF
        var as_borrow_src = ast::ast_get_str1(ast_storage, value_node)
        var as_borrow_is_mut = ast::ast_get_int_val(ast_storage, value_node)
        var as_bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
        if as_bidx >= 0
          tc.safety.binding_borrow_sources[as_bidx] = as_borrow_src
          tc.safety.binding_is_mut_borrows[as_bidx] = as_borrow_is_mut
          tc.safety.binding_borrow_lines[as_bidx] = line
          tc.safety.binding_borrow_cols[as_bidx] = col
          typecheck::tc_propagate_borrow_chain(tc, as_borrow_src, as_borrow_is_mut)
          # QZ1218: depth check
          var as_src_bidx = typecheck_util::tc_lookup_binding_index(tc, as_borrow_src)
          if as_src_bidx >= 0
            var as_src_depth = tc.scope.binding_depths[as_src_bidx]
            var as_holder_depth = tc.scope.binding_depths[as_bidx]
            if as_src_depth > as_holder_depth
              error("QZ1218: Borrow of '#{as_borrow_src}' would outlive its source (source is in a deeper scope)", line, col)
            end
          end
        end
      end
    end

  # Index assignment
  elsif node_kind == node_constants::NODE_INDEX_ASSIGN
    var array_node = ast::ast_get_left(ast_storage, node)
    var index_node = ast::ast_get_right(ast_storage, node)
    var value_node = ast::ast_get_extra(ast_storage, node)

    # QZ1210 (index-store escape): pre-read borrow source of the stored value
    # BEFORE tc_expr (which triggers NLL last-use release), mirroring the
    # NODE_RETURN sink. Depth-1 only: value_node must be a NODE_IDENT naming a
    # borrow-local. See NODE_RETURN handler for the same pattern.
    var pre_ia_borrow_src = 0
    var pre_ia_borrow_line = 0
    var pre_ia_borrow_name = ""
    if ast::ast_get_kind(ast_storage, value_node) == node_constants::NODE_IDENT
      pre_ia_borrow_name = ast::ast_get_str1(ast_storage, value_node)
      var pre_ia_bidx = typecheck_util::tc_lookup_binding_index(tc, pre_ia_borrow_name)
      if pre_ia_bidx >= 0
        pre_ia_borrow_src = tc.safety.binding_borrow_sources[pre_ia_bidx]
        pre_ia_borrow_line = tc.safety.binding_borrow_lines[pre_ia_bidx]
      end
    end

    var ia_array_type = tc_expr(tc, ast_storage, array_node)
    tc_expr(tc, ast_storage, index_node)
    tc_expr(tc, ast_storage, value_node)

    # QZ1210 (index-store escape): a borrow-local escapes via `a[i] = r`.
    # Uses pre_ia_borrow_src captured BEFORE NLL release.
    if pre_ia_borrow_src != 0
      var ia_src_name = as_string(pre_ia_borrow_src)
      var ia_src_bidx = typecheck_util::tc_lookup_binding_index(tc, ia_src_name)
      if ia_src_bidx >= 0
        if pre_ia_borrow_line > 0
          error("QZ1210: Cannot store '#{pre_ia_borrow_name}' via index assignment — it holds a borrow of local variable '#{ia_src_name}' (borrow created at line #{pre_ia_borrow_line})", line, col)
        else
          error("QZ1210: Cannot store '#{pre_ia_borrow_name}' via index assignment — it holds a borrow of local variable '#{ia_src_name}'", line, col)
        end
      end
    end

    # QZ1209: Check mutation-while-borrowed for index assign target
    var ia_obj_kind = ast::ast_get_kind(ast_storage, array_node)
    if ia_obj_kind == node_constants::NODE_IDENT
      var ia_var_name = ast::ast_get_str1(ast_storage, array_node)
      typecheck::tc_check_mutation_while_borrowed(tc, ia_var_name, line, col)
    end

    # Custom index assign dispatch: if subject is a struct with $set method,
    # rewrite node_constants$NODE_INDEX_ASSIGN → node_constants$NODE_CALL(Type$set, [obj, key, val])
    var ia_struct_name = ""
    if ia_obj_kind == node_constants::NODE_IDENT
      var ia_var_name2 = ast::ast_get_str1(ast_storage, array_node)
      ia_struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, ia_var_name2)
    end
    if str_byte_len(ia_struct_name) > 0
      var ia_dollar = __char_index(ia_struct_name, '$')
      var ia_base = ia_struct_name
      if ia_dollar >= 0
        ia_base = str_byte_slice(ia_struct_name, ia_dollar + 1, str_byte_len(ia_struct_name))
      end
      var ia_mangled = typecheck_expr_handlers::tc_mangle(tc, ia_base, "set")
      var set_type = typecheck_builtins::tc_lookup_builtin(tc, ia_mangled)
      if set_type == type_constants::TYPE_ERROR
        set_type = typecheck_registry::tc_lookup_function_return(tc, ia_mangled)
      end
      if set_type != type_constants::TYPE_ERROR
        # Rewrite node_constants$NODE_INDEX_ASSIGN → node_constants$NODE_CALL(Type$set, [obj, key, val])
        var ia_args = vec_new()
        ia_args.push(array_node)
        ia_args.push(index_node)
        ia_args.push(value_node)
        var ia_callee = ast::ast_ident(ast_storage, ia_mangled, line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, ia_callee)
        ast::ast_set_right(ast_storage, node, 0)
        ast::ast_set_children(ast_storage, node, ia_args)
      end
    else
      var ia_base_type = typecheck::tc_base_kind(tc, ia_array_type)
      if ia_base_type == type_constants::TYPE_MAP
        # Rewrite m[key] = val → map_set(m, key, val)
        var hm_args = vec_new()
        hm_args.push(array_node)
        hm_args.push(index_node)
        hm_args.push(value_node)
        var hm_callee = ast::ast_ident(ast_storage, "map_set", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, hm_callee)
        ast::ast_set_right(ast_storage, node, 0)
        ast::ast_set_children(ast_storage, node, hm_args)
      end
    end
    # Annotate Vec element type for width-aware codegen (mem-v2)
    # Runs unconditionally — after struct/map dispatch
    if typecheck::tc_is_ptype(ia_array_type)
      var ia_base_k = typecheck::tc_base_kind(tc, ia_array_type)
      if ia_base_k == type_constants::TYPE_VEC
        var ia_elem_t = typecheck::tc_ptype_arg1(tc, ia_array_type)
        var ia_elem_name = typecheck::tc_type_name(ia_elem_t)
        ast::ast_set_str2(ast_storage, node, ia_elem_name)
      end
    end
  
  # Field assignment
  elsif node_kind == node_constants::NODE_FIELD_ASSIGN
    var object_node = ast::ast_get_left(ast_storage, node)
    var value_node = ast::ast_get_right(ast_storage, node)

    # QZ1209: Check mutation-while-borrowed for field assign target
    if ast::ast_get_kind(ast_storage, object_node) == node_constants::NODE_IDENT
      var fa_var_name = ast::ast_get_str1(ast_storage, object_node)
      typecheck::tc_check_mutation_while_borrowed(tc, fa_var_name, line, col)
    end

    # QZ1210 (field-store escape): pre-read borrow source of the stored value
    # BEFORE tc_expr (which triggers NLL last-use release), mirroring the
    # NODE_RETURN sink. Depth-1 only: the stored value must be a NODE_IDENT
    # naming a borrow-local. NB: for NODE_FIELD_ASSIGN the stored VALUE is in
    # the `extra` slot (ast_field_assign: left=obj, str1=field, extra=value;
    # `right` is 0), so read it from `extra` — NOT the handler's `value_node`
    # (which reads `right`; that the field-store RHS is thereby never
    # typechecked is a separate pre-existing bug, filed). Matches how
    # NODE_INDEX_ASSIGN sources its stored value from `extra`.
    var pre_fa_val = ast::ast_get_extra(ast_storage, node)
    var pre_fa_borrow_src = 0
    var pre_fa_borrow_line = 0
    var pre_fa_borrow_name = ""
    if ast::ast_get_kind(ast_storage, pre_fa_val) == node_constants::NODE_IDENT
      pre_fa_borrow_name = ast::ast_get_str1(ast_storage, pre_fa_val)
      var pre_fa_bidx = typecheck_util::tc_lookup_binding_index(tc, pre_fa_borrow_name)
      if pre_fa_bidx >= 0
        pre_fa_borrow_src = tc.safety.binding_borrow_sources[pre_fa_bidx]
        pre_fa_borrow_line = tc.safety.binding_borrow_lines[pre_fa_bidx]
      end
    end

    # Suppress whole-struct partial-move check on base (same as field access reads)
    tc.safety.field_access_depth += 1
    tc_expr(tc, ast_storage, object_node)
    tc.safety.field_access_depth -= 1
    tc_expr(tc, ast_storage, value_node)

    # QZ1210 (field-store escape): a borrow-local escapes via `b.p = r`.
    # Uses pre_fa_borrow_src captured BEFORE NLL release.
    if pre_fa_borrow_src != 0
      var fa_src_name = as_string(pre_fa_borrow_src)
      var fa_src_bidx = typecheck_util::tc_lookup_binding_index(tc, fa_src_name)
      if fa_src_bidx >= 0
        if pre_fa_borrow_line > 0
          error("QZ1210: Cannot store '#{pre_fa_borrow_name}' via field assignment — it holds a borrow of local variable '#{fa_src_name}' (borrow created at line #{pre_fa_borrow_line})", line, col)
        else
          error("QZ1210: Cannot store '#{pre_fa_borrow_name}' via field assignment — it holds a borrow of local variable '#{fa_src_name}'", line, col)
        end
      end
    end

    # Clear partial move when field is re-initialized (r.x = new_value)
    if ast::ast_get_kind(ast_storage, object_node) == node_constants::NODE_IDENT
      var fa_base_name = ast::ast_get_str1(ast_storage, object_node)
      var fa_field_name = ast::ast_get_str1(ast_storage, node)
      var fa_struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, fa_base_name)
      if str_byte_len(fa_struct_name) > 0
        if typecheck_registry::tc_type_needs_move_tracking(tc, fa_struct_name)
          typecheck_registry::tc_clear_partial_move_field(tc, fa_base_name, fa_field_name)
        end
      end
    end

    # WS2.1 field-store RHS scalar soundness (QZ0201) — struct construction
    # (`P { x: "s" }`) is checked at init (QZ0200) but the STORE `p.x = "s"`
    # was never type-checked (the handler tc_expr's the empty `right` slot; the
    # real RHS lives in `extra`). That asymmetry let `Int←String` print ptr
    # bits, `String←Int` SIGSEGV, and `F64←Int` print i64-bits-as-float. Resolve
    # the field's declared type the same way the field-READ handler does
    # (tc_resolve_expr_struct_name → tc_struct_field_type) and flag a definite
    # String↔numeric / Int↔Float mismatch with R2.3's narrow predicate. Every
    # handle/newtype/struct/Bool pun is permitted; a NODE_INDEX_ASSIGN-style
    # `a.b.c = v` chain resolves the leaf field off its parent field-access node.
    var fa_rhs_node = ast::ast_get_extra(ast_storage, node)
    var fa_check_field = ast::ast_get_str1(ast_storage, node)
    var fa_owner_struct = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, object_node)
    if str_byte_len(fa_owner_struct) > 0
      var fa_owner_struct_base = typecheck::strip_borrow_prefix(fa_owner_struct)
      var fa_struct_lookup = typecheck_registry::tc_lookup_struct(tc, fa_owner_struct_base)
      var fa_struct_idx = match fa_struct_lookup
        LookupResult::Found(v) => v
        LookupResult::NotFound => -1
      end
      if fa_struct_idx >= 0
        var fa_decl_type = typecheck_registry::tc_struct_field_type(tc, fa_struct_idx, fa_check_field)
        if fa_decl_type != type_constants::TYPE_ERROR
          var fa_rhs_type = tc_expr(tc, ast_storage, fa_rhs_node)
          var fa_rk = ast::ast_get_kind(ast_storage, fa_rhs_node)
          if typecheck::tc_assign_scalar_mismatch(tc, fa_decl_type, fa_rhs_type, fa_rk == node_constants::NODE_INT_LIT, fa_rk == node_constants::NODE_STRING_LIT, fa_rk == node_constants::NODE_FLOAT_LIT) == 1
            error("Type mismatch storing to field '#{fa_check_field}': expected '#{typecheck::tc_type_name_full(tc, fa_decl_type)}' but got '#{typecheck::tc_type_name_full(tc, fa_rhs_type)}' — String and numeric (or Int and Float) need an explicit conversion (QZ0201)", line, col)
          end
        end
      end
    end
  
  # Compound assignment (+=, -=, etc.)
  elsif node_kind == node_constants::NODE_COMPOUND_ASSIGN
    var var_name = ast::ast_get_str1(ast_storage, node)
    var value_node = ast::ast_get_right(ast_storage, node)
    
    var target_type = typecheck_util::tc_scope_lookup(tc, var_name)
    var is_mutable = typecheck_util::tc_scope_lookup_mutable(tc, var_name)
    
    if target_type == type_constants::TYPE_ERROR
      error("Undefined variable: #{var_name}", line, col)
    else
      typecheck::tc_check_mutation_while_borrowed(tc, var_name, line, col)
      if is_mutable == 0
        error("Cannot assign to immutable variable: #{var_name}", line, col)
      end

      # SURF.FLOW Phase 2 — compound-assign mutates the binding; invalidate any
      # active narrowing on it (same soundness rule as plain NODE_ASSIGN).
      typecheck_util::tc_narrow_invalidate(tc, var_name)

      var ca_value_type = tc_expr(tc, ast_storage, value_node)
      # WS2.1 compound-assign RHS scalar soundness (QZ0201) — `x += rhs` did no
      # RHS type check. Same narrow assign-side predicate: flag definite
      # String↔numeric / Int↔Float mismatches (with the erased-container carve-out)
      # (`s += "x"` and `n += 1` stay valid; `s += 1` / `n += "x"` are rejected).
      var ca_rk = ast::ast_get_kind(ast_storage, value_node)
      if typecheck::tc_assign_scalar_mismatch(tc, target_type, ca_value_type, ca_rk == node_constants::NODE_INT_LIT, ca_rk == node_constants::NODE_STRING_LIT, ca_rk == node_constants::NODE_FLOAT_LIT) == 1
        error("Type mismatch in compound assignment to '#{var_name}': expected '#{typecheck::tc_type_name_full(tc, target_type)}' but got '#{typecheck::tc_type_name_full(tc, ca_value_type)}' — String and numeric (or Int and Float) need an explicit conversion (QZ0201)", line, col)
      end
    end

  # Return statement
  # Note: value_node >= 0 because node handle 0 is valid (first AST node)
  # A return with no value uses -1 as sentinel (see parser)
  elsif node_kind == node_constants::NODE_RETURN
    # RETURN stores value in slot 7 (left), not slot 8 (right)
    var value_node = ast::ast_get_left(ast_storage, node)

    # 4.B.2: moved QZ0172 below so it fires only when the returned
    # expression produces a NON-Void value. The parser synthesizes an
    # implicit `return <last_expr>` for any def-body whose last
    # statement is a NODE_EXPR_STMT (parser.qz:6404). For a generator
    # body ending in a call to a Void-returning helper (e.g. an
    # `emit_pair(a, b): Void can Yield<Int>` modular yield helper under
    # Path B), the synthesized `return emit_pair(...)` is semantically
    # "call helper, then terminate generator" — legitimate. QZ0172
    # should fire only if the user actually wrote `return X` with a
    # concrete X that would produce a value.

    var return_type = type_constants::TYPE_VOID
    # Pre-read borrow source BEFORE tc_expr (which triggers NLL last-use release)
    var pre_ret_borrow_src = 0
    var pre_ret_borrow_line = 0
    if value_node >= 0
      var pre_ret_kind = ast::ast_get_kind(ast_storage, value_node)
      if pre_ret_kind == node_constants::NODE_IDENT
        var pre_ret_name = ast::ast_get_str1(ast_storage, value_node)
        var pre_ret_bidx = typecheck_util::tc_lookup_binding_index(tc, pre_ret_name)
        if pre_ret_bidx >= 0
          pre_ret_borrow_src = tc.safety.binding_borrow_sources[pre_ret_bidx]
          pre_ret_borrow_line = tc.safety.binding_borrow_lines[pre_ret_bidx]
        end
      end
    end
    if value_node >= 0
      return_type = tc_expr(tc, ast_storage, value_node)
      # SURF.FLOW Phase 2 soundness — if the function returns Option/Result, a
      # narrowed `return opt` must NOT payload-extract into the wide return slot;
      # retract the stamp post-walk.
      tc_unstamp_narrowed_into_wide(tc, ast_storage, value_node, typecheck_util::tc_narrow_expect_base_of_type(tc, typecheck_util::tc_get_return_type(tc)))
      # QZ0172: return-with-value in generator/async generator — use 'yield' instead.
      # 4.B.2: only fires when the returned expression produces a non-Void value.
      # See comment at top of NODE_RETURN handler for rationale.
      # Phase 4D.6: read directly from the current func's return-type annotation.
      if _tc_current_func_is_generator(tc) != 0 and return_type != type_constants::TYPE_VOID
        error("QZ0172: 'return <value>' is not allowed in a generator function — use 'yield' to produce values, or bare 'return' to stop the generator", line, col)
      end
      # QZ1210: Cannot return borrow of local variable
      var ret_val_kind = ast::ast_get_kind(ast_storage, value_node)
      if ret_val_kind == node_constants::NODE_FUNC_REF
        var borrow_var = ast::ast_get_str1(ast_storage, value_node)
        var borrow_bidx = typecheck_util::tc_lookup_binding_index(tc, borrow_var)
        if borrow_bidx >= 0
          error("QZ1210: Cannot return borrow of local variable '#{borrow_var}'", line, col)
        end
      end
      # QZ1210 (cross-fn): Cannot return binding that holds borrow of local
      # Uses pre_ret_borrow_src captured BEFORE NLL release
      if pre_ret_borrow_src != 0
        var ret_src_name = as_string(pre_ret_borrow_src)
        var ret_src_bidx = typecheck_util::tc_lookup_binding_index(tc, ret_src_name)
        if ret_src_bidx >= 0
          var ret_borrow_name = ast::ast_get_str1(ast_storage, value_node)
          if pre_ret_borrow_line > 0
            error("QZ1210: Cannot return '#{ret_borrow_name}' — it holds a borrow of local variable '#{ret_src_name}' (borrow created at line #{pre_ret_borrow_line})", line, col)
          else
            error("QZ1210: Cannot return '#{ret_borrow_name}' — it holds a borrow of local variable '#{ret_src_name}'", line, col)
          end
        end
      end
      # Linear: consume returned linear value
      var ret_kind = ast::ast_get_kind(ast_storage, value_node)
      if ret_kind == node_constants::NODE_IDENT
        var ret_name = ast::ast_get_str1(ast_storage, value_node)
        var ret_lin = typecheck_registry::tc_lookup_linear_state(tc, ret_name)
        if ret_lin == 1
          typecheck_registry::tc_consume_linear(tc, ret_name, line, col)
        end
        # Move semantics: consume moveable value on return
        typecheck_registry::tc_move_on_call(tc, ret_name, "<return>", line, col)
      end
    end

    # Arena escape analysis: error if returning a scoped-arena allocation
    if value_node >= 0
      var ret_kind_a = ast::ast_get_kind(ast_storage, value_node)
      if ret_kind_a == node_constants::NODE_IDENT
        var ret_var_name = ast::ast_get_str1(ast_storage, value_node)
        var scoped_arena = typecheck::tc_arena_is_scoped(tc, ret_var_name)
        if str_byte_len(scoped_arena) > 0
          error("QZ1402: arena-allocated value '#{ret_var_name}' escapes arena '#{scoped_arena}' scope", line, col)
        end
      end
    end

    # Skip return type check for bare return in generators (generators' declared
    # return type is impl Iterator<T>, not Void — bare return just stops iteration).
    # 4.B.2: also skip when the returned value has type Void inside a generator —
    # the parser synthesizes `return <last_expr>` for any def-body ending in a
    # NODE_EXPR_STMT; under Path B generator bodies legitimately end in
    # Void-returning modular-helper calls (e.g. `emit_pair(a, b)`).
    var _in_gen = _tc_current_func_is_generator(tc) != 0
    var _skip_ret_check = false
    if _in_gen
      if value_node < 0
        _skip_ret_check = true
      elsif return_type == type_constants::TYPE_VOID
        _skip_ret_check = true
      end
    end
    if not _skip_ret_check
      # GAP-struct-init-erasure (3a, WIDTH): a struct literal returned into a
      # record slot arrives here as bare TYPE_STRUCT (struct-init erases its
      # nominal id). Recover the nominal id from the value node so the record
      # width check in tc_check_return actually runs. No-op unless the returned
      # value is a bare-7 struct literal AND the declared return type is a record
      # (gate-0-inert: compiler source has no such return).
      var _ret_expected = typecheck_util::tc_get_return_type(tc)
      var _ret_checked = typecheck_helpers::tc_promote_struct_init_for_record(tc, ast_storage, value_node, return_type, _ret_expected)
      # R2.4: variable-of-struct return — a struct-typed VARIABLE returned into a
      # record slot is also bare-7 (nominal id in binding_struct_names, not the
      # TypeId). If the literal promote did not fire, recover the nominal id from
      # the binding name so the same width check runs.
      if _ret_checked == return_type
        _ret_checked = typecheck_helpers::tc_promote_struct_ident_for_record(tc, ast_storage, value_node, return_type, _ret_expected)
      end
      with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_helpers::tc_check_return(tc, _ret_checked, line, col)
      end
    end

    # Strict literal type mismatch: string literal returned from Int/Bool function
    # or int literal returned from String function. This catches clear programmer errors
    # while avoiding false positives from type inference gaps in the existential model.
    if value_node >= 0
      var expected_ret = typecheck_util::tc_get_return_type(tc)
      if expected_ret != type_constants::TYPE_VOID and expected_ret != type_constants::TYPE_ERROR
        var value_kind = ast::ast_get_kind(ast_storage, value_node)
        if value_kind == node_constants::NODE_STRING_LIT
          if expected_ret == type_constants::TYPE_INT or expected_ret == type_constants::TYPE_BOOL
            error("Return type mismatch: expected #{typecheck::tc_type_name(expected_ret)} but got String", line, col)
          end
        elsif value_kind == node_constants::NODE_INT_LIT
          if expected_ret == type_constants::TYPE_STRING
            error("Return type mismatch: expected #{typecheck::tc_type_name(expected_ret)} but got Int", line, col)
          end
          # QZ0214 (N3.1 audit) — bare int-literal (the existential `0`-as-boxed
          # sentinel) returned into a heap/reference slot. Today this compiles via
          # the i64 coercion (tc_is_i64_type); the full bare-Int wall will forbid
          # it. Default-off WARNING (gated on QZ_N3_AUDIT) to enumerate the
          # migration worklist without changing behavior or IR. Reuses the
          # nil-wall predicate + union-Nil carve-out.
          if typecheck_helpers::tc_nil_forbidden_type(tc, expected_ret) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_ret) == 0
            if typecheck_helpers::tc_n3_wall_warn_enabled()
              if typecheck_helpers::tc_n3_wall_is_error(tc)
                error("QZ0214: bare int-literal returned into boxed slot `#{typecheck::tc_type_name(expected_ret)}` — the existential 0-sentinel is forbidden here; return `Option<T>` + `None`, or a real value", line, col)
              else
                warn("QZ0214 (N3.1 audit): bare int-literal returned into boxed slot `#{typecheck::tc_type_name(expected_ret)}` — existential 0-sentinel; migrate to Option<T>+None or a real value", line, col)
              end
            end
          end
        elsif value_kind == node_constants::NODE_NIL_LIT
          # QZ0213 (B.15c) — nil-literal wall on return. `return nil` from a
          # heap/reference-returning fn is forbidden; `nil` is not a typed value
          # (use Option<T> + None, or keep CPtr at an FFI boundary). Keyed off
          # NodeNilLit, so the existential bare-Int gap can't false-fire.
          # A union with an explicit `Nil` member (`Int | Nil`) admits `nil`.
          if typecheck_helpers::tc_nil_forbidden_type(tc, expected_ret) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_ret) == 0
            error("`nil` is not a value here (return type `#{typecheck::tc_type_name(expected_ret)}`). Return `Option<#{typecheck::tc_type_name(expected_ret)}>` and `None`, or — at an FFI boundary — keep it as `CPtr`. (QZ0213)", line, col)
          end
        else
          # QZ0215 (N3.1 step-4 audit) — the Int-VARIABLE / erased-boxed-value
          # case on return: a non-literal, non-nil return expression whose
          # resolved type is bare TYPE_INT while the declared return slot is
          # boxed. Under the existential model this is EITHER a real Int-var
          # sentinel OR an erased-boxed value de-existentialization must give a
          # real type — both belong on the step-4 worklist. Default-off WARNING.
          if typecheck_helpers::tc_n3_wall_warn_enabled() and typecheck_helpers::tc_n3_file_exempt(tc) == false
            if typecheck_helpers::tc_nil_forbidden_type(tc, expected_ret) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_ret) == 0
              var ret_val_ty = tc_expr(tc, ast_storage, value_node)
              if ret_val_ty == type_constants::TYPE_INT
                if typecheck_helpers::tc_n3_wall_is_error(tc)
                  error("QZ0215: Int-typed value returned into boxed slot `#{typecheck::tc_type_name(expected_ret)}` — the existential erased-value/Int-var sentinel is forbidden here; de-existentialize the source or return `Option<T>`", line, col)
                else
                  warn("QZ0215 (N3.1 step-4 audit): Int-typed value returned into boxed slot `#{typecheck::tc_type_name(expected_ret)}` — existential erased-value/Int-var sentinel; de-existentialize or migrate to Option", line, col)
                end
              end
            end
          end
        end
      end
    end

  # Yield statement — generator suspend point
  elsif node_kind == node_constants::NODE_YIELD
    var value_node = ast::ast_get_left(ast_storage, node)
    if value_node >= 0
      tc_expr(tc, ast_storage, value_node)
    end
    # 4.B.2: see expression-position NODE_YIELD above for the three
    # channels that count as "Yield in scope."
    if not _tc_p4b_yield_in_scope(tc)
      error("QZ0170: 'yield' can only be used inside a generator function (return type must be 'impl Iterator<T>' or 'impl AsyncIterator<T>') or a function declaring `can Yield`", line, col)
    end

  # Async call — treat as expression statement (result discarded or assigned)
  elsif node_kind == node_constants::NODE_ASYNC_CALL
    tc_expr(tc, ast_storage, node)

  # Go call — treat as expression statement
  elsif node_kind == node_constants::NODE_GO
    tc_expr(tc, ast_storage, node)

  # If statement
  # Note: node >= 0 because node handle 0 is valid (first AST node)
  # Parser uses -1 as sentinel for "no else clause"
  elsif node_kind == node_constants::NODE_IF
    var cond_node = ast::ast_get_left(ast_storage, node)
    var then_node = ast::ast_get_right(ast_storage, node)
    var else_node = ast::ast_get_extra(ast_storage, node)
    var if_int_val = ast::ast_get_int_val(ast_storage, node)

    if if_int_val == 1
      # Pattern binding: `if PATTERN = EXPR`
      var pb_pattern_node = ast::ast_get_op(ast_storage, node)
      var pb_subject_type = tc_expr(tc, ast_storage, cond_node)

      var pb_linear_snap = typecheck_registry::tc_snapshot_linear_states(tc)
      var pb_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
      var pb_partial_snap = typecheck_registry::tc_snapshot_partial_moves(tc)

      # Enter scope, bind pattern variables, type-check then-block
      typecheck_util::tc_enter_scope()
      typecheck_match::tc_bind_if_pattern(tc, ast_storage, pb_pattern_node, pb_subject_type, line, col)

      # SURF.FLOW Phase 2 / A4 — refutable-bind subject narrowing. `if Var(v) = x`
      # binds `v : T` (above via tc_bind_if_pattern) AND additively proves `x : Var`,
      # so a bare read of `x` in the then-branch reads as the proven variant's inner
      # payload too. Generalized from Option/Some-only to ANY single-payload variant:
      # Option `Some`, Result `Ok`/`Err`, and single-payload user-enum variants — all
      # routed through tc_try_narrow_variant, which resolves the variant against the
      # subject's declared type and refuses to narrow (returns 0) if the variant is
      # not valid for that type or has no single payload. The subject must be a bare
      # identifier (stable access-path key == its name). Narrowing is at the entered-
      # scope depth → dropped on tc_exit_scope below, so it never leaks past the `if`.
      if cond_node >= 0 and ast::ast_get_kind(ast_storage, cond_node) == node_constants::NODE_IDENT
        if pb_pattern_node >= 0 and ast::ast_get_kind(ast_storage, pb_pattern_node) == node_constants::NODE_ENUM_ACCESS
          var pb_variant = ast::ast_get_str2(ast_storage, pb_pattern_node)
          if str_byte_len(pb_variant) > 0
            tc_try_narrow_variant(tc, ast_storage, ast::ast_get_str1(ast_storage, cond_node), pb_variant, typecheck_util::tc_get_depth(tc))
          end
        end
      end

      if then_node >= 0
        tc_stmt(tc, ast_storage, then_node)
      end
      typecheck::tc_exit_scope(tc)

      var pb_then_linear = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, pb_linear_snap)
      var pb_then_move = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, pb_move_snap)
      var pb_then_partial = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, pb_partial_snap)

      if else_node >= 0
        tc_stmt(tc, ast_storage, else_node)
        var pb_else_linear = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, pb_then_linear, pb_else_linear, line, col)
        var pb_else_move = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, pb_then_move, pb_else_move, line, col)
        var pb_else_partial = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, pb_then_partial, pb_else_partial, line, col)
      else
        typecheck_registry::tc_restore_linear_states(tc, pb_then_linear)
        typecheck_registry::tc_merge_move_states(tc, pb_then_move, pb_move_snap, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, pb_then_partial, pb_partial_snap, line, col)
      end

    # Is-with-bindings statement: `if val is Some(x) ... end`
    elsif cond_node >= 0 and ast::ast_get_kind(ast_storage, cond_node) == node_constants::NODE_IS_CHECK and ast::ast_get_bound_names(ast_storage, cond_node) > 0
      # Type-check subject
      var isb_subject_node = ast::ast_get_left(ast_storage, cond_node)
      var isb_subject_type = tc_expr(tc, ast_storage, isb_subject_node)
      var isb_variant_name = ast::ast_get_str1(ast_storage, cond_node)
      var isb_bound_names = ast::ast_get_bound_names(ast_storage, cond_node)

      # Resolve enum name from subject's struct_name in scope
      var isb_enum_name = ""
      if isb_subject_node >= 0 and ast::ast_get_kind(ast_storage, isb_subject_node) == node_constants::NODE_IDENT
        isb_enum_name = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, isb_subject_node))
      end

      var isb_linear_snap = typecheck_registry::tc_snapshot_linear_states(tc)
      var isb_move_snap = typecheck_registry::tc_snapshot_move_states(tc)
      var isb_partial_snap = typecheck_registry::tc_snapshot_partial_moves(tc)

      # Enter scope, bind pattern variables, type-check then-block
      typecheck_util::tc_enter_scope()
      typecheck_match::tc_bind_pattern_variables(tc, isb_bound_names, isb_subject_type, isb_enum_name, isb_variant_name, line, col)
      if then_node >= 0
        tc_stmt(tc, ast_storage, then_node)
      end
      typecheck::tc_exit_scope(tc)

      var isb_then_linear = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, isb_linear_snap)
      var isb_then_move = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, isb_move_snap)
      var isb_then_partial = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, isb_partial_snap)

      if else_node >= 0
        tc_stmt(tc, ast_storage, else_node)
        var isb_else_linear = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, isb_then_linear, isb_else_linear, line, col)
        var isb_else_move = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, isb_then_move, isb_else_move, line, col)
        var isb_else_partial = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, isb_then_partial, isb_else_partial, line, col)
      else
        typecheck_registry::tc_restore_linear_states(tc, isb_then_linear)
        typecheck_registry::tc_merge_move_states(tc, isb_then_move, isb_move_snap, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, isb_then_partial, isb_partial_snap, line, col)
      end

    else
      # SURF.FLOW Phase 3 — classify the guard from the RAW condition AST before
      # tc_expr mutates it (`.some?`→option_is_some(...), `.ok?`→is_ok(...), UFCS).
      # The v3 classifier resolves the THEN-branch and ELSE-branch proven variant
      # names for Option / Result / arbitrary user enums against the subject's static
      # type. A 3+-variant `is Variant` yields a THEN variant but NO else variant
      # (sound — else could be any remaining variant). The single-guard classify is
      # used for else-narrow + guard-style; THEN-facts (incl. `and`-chains) are
      # applied separately via tc_narrow_apply_then_facts.
      var nv3 = vec_new()
      nv3.push(-1)
      nv3.push(as_int(""))
      nv3.push(as_int(""))
      nv3.push(-1)
      tc_narrow_guard_classify_v3(tc, ast_storage, cond_node, nv3)
      var narrow_subj = as_int(nv3[0])
      var narrow_then_variant = as_string(nv3[1])
      var narrow_else_variant = as_string(nv3[2])

      var cond_type = tc_expr(tc, ast_storage, cond_node)
      typecheck_helpers::tc_check_condition(tc, cond_type, "if", line, col)

      # Snapshot linear states before branches
      var linear_snapshot = typecheck_registry::tc_snapshot_linear_states(tc)
      # Snapshot move states before branches
      var move_snapshot = typecheck_registry::tc_snapshot_move_states(tc)
      # Snapshot partial move states before branches
      var partial_move_snapshot = typecheck_registry::tc_snapshot_partial_moves(tc)

      # SURF.FLOW — flow-narrowing. Snapshot the narrow side table, push then-branch
      # refinements (handling `and`-chains: `if a.some? and b.some?` narrows both)
      # so reads of each narrowed subject resolve to its inner payload inside the
      # then-branch, then restore so it cannot leak past `end` or into the else.
      # Narrows const AND var (var protected by invalidate-on-reassign + closure
      # barrier). For Result `err?`/`is Err` the THEN variant IS Err (its E payload
      # is readable); for a NEGATIVE Option guard (`none?`) the THEN variant is ""
      # (None has no payload — apply_then_facts is a no-op for it).
      var narrow_snapshot = typecheck_registry::tc_snapshot_narrow(tc)
      tc_narrow_apply_then_facts(tc, ast_storage, cond_node, typecheck_util::tc_get_depth(tc))

      if then_node >= 0
        tc_stmt(tc, ast_storage, then_node)
      end

      typecheck_registry::tc_restore_narrow(tc, narrow_snapshot)

      # SURF.FLOW Phase 2/3 — guard-style early-exit. When a SINGLE guard's
      # then-branch DEFINITELY diverges (return / break / continue / panic / throw),
      # control reaches the statements AFTER the `if` only when the guard was FALSE —
      # i.e. the subject is the ELSE variant. Inject `subject ⇒ else_variant` into the
      # ENCLOSING scope (current depth) so reads after the `if` see the inner payload.
      # Only fires when an ELSE variant exists (binary enums) and it carries a payload.
      # Computed here, APPLIED after all snapshot restores below so it survives. Note:
      # `and`-chain conditions never classify as a single-guard subject (narrow_subj < 0
      # for them), so guard-style does not over-narrow a conjunction.
      var guard_style_subj_name = ""
      var guard_style_variant = ""
      var guard_style_depth = typecheck_util::tc_get_depth(tc)
      if narrow_subj >= 0 and str_byte_len(narrow_else_variant) > 0 and then_node >= 0
        if tc_stmt_diverges(tc, ast_storage, then_node) == 1
          guard_style_subj_name = ast::ast_get_str1(ast_storage, narrow_subj)
          guard_style_variant = narrow_else_variant
        end
      end

      # Save then-branch states and restore for else
      var then_states = typecheck_registry::tc_snapshot_linear_states(tc)
      typecheck_registry::tc_restore_linear_states(tc, linear_snapshot)
      var then_move_states = typecheck_registry::tc_snapshot_move_states(tc)
      typecheck_registry::tc_restore_move_states(tc, move_snapshot)
      var then_partial_moves = typecheck_registry::tc_snapshot_partial_moves(tc)
      typecheck_registry::tc_restore_partial_moves(tc, partial_move_snapshot)

      if else_node >= 0
        # SURF.FLOW Phase 3 — else-narrowing for binary enums (Option / Result /
        # 2-variant user enum). The else proves the subject is the OTHER variant; if
        # that variant carries a single payload, narrow it for the else-branch only.
        # For a 3+-variant `is Variant`, narrow_else_variant is "" → no else-narrow
        # (else could be any remaining variant — unsound to narrow).
        var else_narrow_snapshot = typecheck_registry::tc_snapshot_narrow(tc)
        if narrow_subj >= 0 and str_byte_len(narrow_else_variant) > 0
          var en_key = typecheck_util::tc_access_path_key(ast_storage, narrow_subj)
          if str_byte_len(en_key) > 0
            var en_node = -1
            if ast::ast_get_kind(ast_storage, narrow_subj) != node_constants::NODE_IDENT
              en_node = narrow_subj
            end
            tc_try_narrow_variant_keyed(tc, ast_storage, en_key, en_node, narrow_else_variant, typecheck_util::tc_get_depth(tc))
          end
        end

        # SURF.FLOW A5 — `or`-chain ELSE-narrowing (De Morgan dual of the and-chain
        # THEN-narrowing). For `if a.some? or b.some? ... else`, the else proves NEITHER
        # disjunct holds, so EACH operand narrows to its ELSE-fact (both a,b → None). An
        # OR-chain condition classifies as narrow_subj < 0 (the v3 classifier handles only
        # single guards + the THEN path only walks OP_AND), so this is the ONLY narrowing
        # for an OR-chain — the THEN region deliberately narrows NOTHING (only one disjunct
        # need hold — unsound to narrow either in the THEN).
        if cond_node >= 0 and ast::ast_get_kind(ast_storage, cond_node) == node_constants::NODE_BINARY and ast::ast_get_op(ast_storage, cond_node) == 15
          tc_narrow_apply_orchain_else_facts(tc, ast_storage, cond_node, typecheck_util::tc_get_depth(tc))
        end

        tc_stmt(tc, ast_storage, else_node)

        typecheck_registry::tc_restore_narrow(tc, else_narrow_snapshot)
        # Check branch agreement
        var else_states = typecheck_registry::tc_snapshot_linear_states(tc)
        typecheck_registry::tc_check_linear_branch_agreement(tc, then_states, else_states, line, col)
        # Check move branch agreement
        var else_move_states = typecheck_registry::tc_snapshot_move_states(tc)
        typecheck_registry::tc_merge_move_states(tc, then_move_states, else_move_states, line, col)
        # Check partial move branch agreement
        var else_partial_moves = typecheck_registry::tc_snapshot_partial_moves(tc)
        typecheck_registry::tc_merge_partial_moves(tc, then_partial_moves, else_partial_moves, line, col)
      else
        # No else — check linear agreement between then-branch and implicit no-op else.
        # If then-branch consumes a linear value but the no-else path doesn't, QZ1207.
        typecheck_registry::tc_check_linear_branch_agreement(tc, then_states, linear_snapshot, line, col)
        typecheck_registry::tc_restore_linear_states(tc, then_states)
        typecheck_registry::tc_merge_move_states(tc, then_move_states, move_snapshot, line, col)
        typecheck_registry::tc_merge_partial_moves(tc, then_partial_moves, partial_move_snapshot, line, col)
      end

      # SURF.FLOW Phase 2/3 — apply the guard-style post-if fact AFTER both branches
      # and all snapshot restores, so it persists into the enclosing scope for the
      # statements following the `if`. tc_narrow_clear_at_depth on enclosing-scope
      # exit drops it; a later reassignment of the subject drops it via the
      # NODE_ASSIGN invalidation hook.
      if str_byte_len(guard_style_subj_name) > 0
        tc_try_narrow_variant(tc, ast_storage, guard_style_subj_name, guard_style_variant, guard_style_depth)
      end
    end

  # While loop
  # Note: node >= 0 because node handle 0 is valid (first AST node)
  elsif node_kind == node_constants::NODE_WHILE
    var cond_node = ast::ast_get_left(ast_storage, node)
    var body_node = ast::ast_get_right(ast_storage, node)

    # Track labeled loop
    var while_label = ast::ast_get_str1(ast_storage, node)
    if str_byte_len(while_label) > 0
      if typecheck_util::tc_has_loop_label(tc, while_label)
        error("Duplicate loop label :#{while_label}", line, col)
      end
      tc.loop_labels.push(while_label)
    end

    # SURF.FLOW B2 — while loop-BODY narrowing (Phase 4, bounded). The `while`
    # condition is re-evaluated at the top of EVERY iteration, so when the body
    # executes the condition was JUST proven TRUE — the then-fact holds at body-TOP,
    # identical to an `if`-then. The THEN-facts are applied around the body walk via
    # tc_narrow_apply_then_facts (below, after tc_expr) — exactly the mechanism and
    # ordering the if-handler uses. Only the THEN-facts are applied (and only around
    # the body):
    # a `while`'s after-loop state is NOT the negation (a `break` exits with the
    # subject possibly still the then-variant; normal exit only means the LAST
    # condition eval was false), so we deliberately do NOT narrow after the loop and
    # do NOT apply else-facts. Body-only is the sound, bounded scope.
    #
    # Mid-body mutation of the subject (reassign / `&mut x` / `&mut self` method from
    # S1) fires the existing invalidation hooks DURING the body walk below, correctly
    # dropping a body-top fact mid-body — the same behavior as the if-then body.
    var wn_narrow_snapshot = typecheck_registry::tc_snapshot_narrow(tc)

    var cond_type = tc_expr(tc, ast_storage, cond_node)
    typecheck_helpers::tc_check_condition(tc, cond_type, "while", line, col)

    # Snapshot borrow states before loop body — borrows created inside
    # the loop don't persist across iterations or after the loop
    var loop_borrow_snapshot = typecheck::tc_snapshot_borrow_states(tc)
    # Snapshot move states — moves inside loops must be detected
    var loop_move_snapshot = typecheck_registry::tc_snapshot_move_states(tc)

    # SURF.FLOW B2 — apply the condition's THEN-facts (incl. `and`-chains:
    # `while a.some? and b.some?` narrows both) for the body walk only. The
    # snapshot above brackets the body; the restore below drops every body-top
    # fact so nothing leaks past `end` or into the after-loop statements. This runs
    # AFTER tc_expr (which desugars `.some?`→option_is_some(...) etc.) exactly as the
    # if-handler does — tc_narrow_apply_then_facts re-classifies cond_node internally
    # via tc_narrow_guard_classify_v3, which recognizes both the surface predicate
    # methods and the desugared call/UFCS forms.
    tc_narrow_apply_then_facts(tc, ast_storage, cond_node, typecheck_util::tc_get_depth(tc))

    if body_node >= 0
      tc_stmt(tc, ast_storage, body_node)
    end

    # SURF.FLOW B2 — restore the narrow side table: body-top facts are body-only,
    # never leaking past the loop. No after-loop narrow, no else-facts (see above).
    typecheck_registry::tc_restore_narrow(tc, wn_narrow_snapshot)

    # Check for moves inside loop body — if a value goes Live→Moved in one
    # iteration, the second iteration would be use-after-move
    var loop_binding_count = typecheck_util::tc_get_binding_count(tc)
    for lmi in 0..loop_binding_count
      if lmi < loop_move_snapshot.size
        if loop_move_snapshot[lmi] == 1 and tc.safety.move_states[lmi] == 2
          var lm_name = tc.scope.binding_names[lmi]
          var lm_target = tc.safety.move_targets[lmi]
          var lm_line = tc.safety.move_lines[lmi]
          error("QZ1212: Value '#{lm_name}' is moved inside loop body (moved to '#{lm_target}' at line #{lm_line})", line, col)
        end
      end
    end

    # Restore borrow states — borrows created inside loop body are scoped to it
    typecheck::tc_restore_borrow_states(tc, loop_borrow_snapshot)

    # Pop label
    if str_byte_len(while_label) > 0
      typecheck_util::tc_pop_loop_label(tc, while_label)
    end

  # For loop
  # Note: node >= 0 because node handle 0 is valid (first AST node)
  elsif node_kind == node_constants::NODE_FOR
    var iter_name = ast::ast_get_str1(ast_storage, node)
    var range_node = ast::ast_get_left(ast_storage, node)
    var body_node = ast::ast_get_right(ast_storage, node)

    # Track labeled loop (for-loop label is in str2)
    var for_label = ast::ast_get_str2(ast_storage, node)
    if str_byte_len(for_label) > 0
      if typecheck_util::tc_has_loop_label(tc, for_label)
        error("Duplicate loop label :#{for_label}", line, col)
      end
      tc.loop_labels.push(for_label)
    end

    typecheck_util::tc_enter_scope()

    # Type check range/iterator FIRST so we can bind the loop variable with
    # the correct element type (key type for Map<K,V>, elem type for Vec<T>).
    # The range expression must not reference the iter variable — for-loop
    # semantics evaluate the range before the first iteration.
    var for_iter_var_type = type_constants::TYPE_INT
    if range_node >= 0
      var iter_type = tc_expr(tc, ast_storage, range_node)
      # Derive iter variable type from container ptype.
      if typecheck::tc_is_ptype(iter_type)
        var for_base = typecheck::tc_ptype_base(tc, iter_type)
        if for_base == type_constants::TYPE_MAP
          # `for k in map` — k gets the map's key type
          for_iter_var_type = typecheck::tc_ptype_arg1(tc, iter_type)
        elsif for_base == type_constants::TYPE_VEC or for_base == type_constants::TYPE_ARRAY
          # `for x in vec` — x gets the element type
          for_iter_var_type = typecheck::tc_ptype_arg1(tc, iter_type)
        elsif for_base == type_constants::TYPE_SLICE or for_base == type_constants::TYPE_SLICE_MUT
          # Tier 4 #24 Phase 4: `for x in slice` — x gets the element type.
          for_iter_var_type = typecheck::tc_ptype_arg1(tc, iter_type)
          # Tier 4 #24 Phase 4b §2.2: Slice<Byte> iteration uses byte-stride
          # reads. Store TYPE_BYTE as the MIR dispatch key so the lowering
          # side picks byte_slice_get over slice_get.
          if for_iter_var_type == type_constants::TYPE_BYTE
            for_base = type_constants::TYPE_BYTE
            for_iter_var_type = type_constants::TYPE_INT
          end
        end
        # P4.D.4d: Stream<T, body_row> for-in row widening. When the iter
        # source's static type is a synthesized Stream ptype with
        # body_row >= 0, subsume body_row into the caller's effect row.
        # Replaces the F.3c annotation-string prefix scan (deleted in
        # this phase) with a type-driven check that covers ALL iter
        # source kinds via tc_expr's resolved type — including the
        # NODE_CALL form `for v in my_async_gen()` that F.3c missed.
        #
        # Detection runs BEFORE iter_type collapses to for_base. for_base
        # for Stream is TYPE_STRUCT, which falls through the branches
        # above without binding for_iter_var_type — that's left to the
        # existing custom-iteration path that wires Stream.next.
        if typecheck::tc_is_stream_ptype(tc, iter_type)
          var _4d4d_recv_row = typecheck::tc_stream_ptype_row(tc, iter_type)
          if _4d4d_recv_row >= 0
            var _4d4d_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
            if _4d4d_caller_idx >= 0
              var _4d4d_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _4d4d_caller_idx)
              if _4d4d_caller_row >= 0
                if not typecheck_registry::tc_row_subsume_with_handlers(tc, _4d4d_caller_row, _4d4d_recv_row)
                  var _4d4d_missing = typecheck_registry::tc_row_missing_labels_str(tc, _4d4d_caller_row, _4d4d_recv_row)
                  if str_byte_len(_4d4d_missing) > 0
                    error("QZ0610: `for v in <Stream<T, e>>` requires effects not in caller's `can` clause: #{_4d4d_missing}. Add `can #{_4d4d_missing}` (or merge into the existing `can` row) to the caller.", line, col)
                  else
                    error("QZ0610: `for v in <Stream<T, e>>` effect row is incompatible with caller's `can` clause", line, col)
                  end
                end
              end
            end
          end
        end
        iter_type = for_base
      end
      # Store base type for MIR dispatch (normalized, not a ptype).
      ast::ast_set_extra(ast_storage, node, iter_type)
    end

    # Bind iterator variable as mutable (FOR loop modifies it each iteration).
    # Bound AFTER range typecheck so the correct element/key type is used.
    # Generic type params (e.g. T in `def f<T>(items: Vec<T>) ; for x in items`)
    # surface here as TYPE_ERROR because `tc_parse_type("T")` returns the
    # error sentinel for bare type names with no in-scope alias. Mirror the
    # fallback `tc_function` already does for parameter binding (lines around
    # 3992-3997) so the loop variable binding is visible to scope lookup
    # (TYPE_ERROR is also the "not found" sentinel — binding x with
    # TYPE_ERROR type makes a subsequent lookup of x fall through to
    # "Undefined variable: x" even though x technically IS bound).
    if for_iter_var_type == type_constants::TYPE_ERROR
      for_iter_var_type = type_constants::TYPE_INT
    end
    # item 1a — when the loop variable is a struct (e.g. `for k in map` over a
    # Map<Struct, V>, or `for p in vec` over a Vec<Struct>), register its struct
    # NAME annotation, not just the type id. Downstream key-type inference
    # (tc_resolve_expr_struct_name → tc_scope_lookup_struct_name) reads this
    # annotation to route `m.get(k)` on a value-layout struct key to the custom
    # map runtime; without it the struct loop var resolves to "" and the call
    # falls to the String-key path (qz_str_hash on a struct pointer → segfault).
    # Empty for non-struct element types ⇒ byte-identical to the prior "" bind.
    var for_iter_struct_ann = ""
    if typecheck::tc_is_struct_type(for_iter_var_type)
      for_iter_struct_ann = typecheck::tc_type_name_full(tc, for_iter_var_type)
    end
    typecheck_util::tc_scope_bind(tc, iter_name, for_iter_var_type, 1, for_iter_struct_ann)

    # Type check step expression if present
    var for_step_node = ast::ast_get_int_val(ast_storage, node)
    if for_step_node > 0
      tc_expr(tc, ast_storage, for_step_node)
      # Check for literal zero step (compile error)
      var step_kind = ast::ast_get_kind(ast_storage, for_step_node)
      if step_kind == node_constants::NODE_INT_LIT
        if ast::ast_get_int_val(ast_storage, for_step_node) == 0
          error("Step value cannot be zero", line, col)
        end
      end
    end

    # Snapshot borrow states before loop body — borrows created inside
    # the loop don't persist across iterations or after the loop
    var for_borrow_snapshot = typecheck::tc_snapshot_borrow_states(tc)
    # Snapshot move states — moves inside for loops must be detected
    var for_move_snapshot = typecheck_registry::tc_snapshot_move_states(tc)

    # Type check body
    if body_node >= 0
      tc_stmt(tc, ast_storage, body_node)
    end

    # Check for moves inside for loop body — if a value goes Live→Moved in one
    # iteration, the second iteration would be use-after-move
    var for_binding_count = typecheck_util::tc_get_binding_count(tc)
    for fmi in 0..for_binding_count
      if fmi < for_move_snapshot.size
        if for_move_snapshot[fmi] == 1 and tc.safety.move_states[fmi] == 2
          var fm_name = tc.scope.binding_names[fmi]
          var fm_target = tc.safety.move_targets[fmi]
          var fm_line = tc.safety.move_lines[fmi]
          error("QZ1212: Value '#{fm_name}' is moved inside loop body (moved to '#{fm_target}' at line #{fm_line})", line, col)
        end
      end
    end

    # Restore borrow states — borrows created inside loop body are scoped to it
    typecheck::tc_restore_borrow_states(tc, for_borrow_snapshot)

    typecheck::tc_exit_scope(tc)

    # Pop label
    if str_byte_len(for_label) > 0
      typecheck_util::tc_pop_loop_label(tc, for_label)
    end

  # For-await loop: for await x in channel
  elsif node_kind == node_constants::NODE_FOR_AWAIT
    var fa_var = ast::ast_get_str1(ast_storage, node)
    var fa_ch_node = ast::ast_get_left(ast_storage, node)
    var fa_body_node = ast::ast_get_right(ast_storage, node)

    typecheck_util::tc_enter_scope()
    # Bind iterator variable as mutable
    typecheck_util::tc_scope_bind(tc, fa_var, type_constants::TYPE_INT, 1, "")
    # Type check channel expression
    if fa_ch_node >= 0
      tc_expr(tc, ast_storage, fa_ch_node)
    end
    # Type check body
    if fa_body_node >= 0
      tc_stmt(tc, ast_storage, fa_body_node)
    end
    typecheck::tc_exit_scope(tc)

  # Block
  elsif node_kind == node_constants::NODE_BLOCK
    var stmts = ast::ast_get_children(ast_storage, node)

    typecheck_util::tc_enter_scope()

    each(stmts, stmt: Int -> tc_stmt(tc, ast_storage, stmt))

    typecheck::tc_exit_scope(tc)

  # With-block as statement (Piezo C.1 + C.2): same claim-detection /
  # push / pop logic as the expression form above, but forwards the
  # body to tc_stmt. B.8 Phase 3 mirrors the Scoped dispatch from the
  # expression branch.
  elsif node_kind == node_constants::NODE_WITH
    var with_handler_s = ast::ast_get_left(ast_storage, node)
    var with_body_s = ast::ast_get_right(ast_storage, node)
    var with_bound_s = ast::ast_with_bound_param(ast_storage, node)
    var _with_claim_s = 0
    var _with_scope_pushed_s = 0
    if with_handler_s >= 0
      # B.8 Phase 4a — see expr-position mirror for full rationale.
      if with_bound_s != -1
        var _with_ht_s = tc_expr(tc, ast_storage, with_handler_s)
        typecheck_util::tc_enter_scope()
        _with_scope_pushed_s = 1
        tc_with_scoped_bind(tc, ast_storage, node, with_handler_s, _with_ht_s, with_bound_s, line, col)
      else
        _with_claim_s = tc_with_handler_begin(tc, ast_storage, with_handler_s, line, col)
        if _with_claim_s == 0
          tc_expr(tc, ast_storage, with_handler_s)
        end
      end
    end
    if with_body_s >= 0
      tc_stmt(tc, ast_storage, with_body_s)
    end
    if _with_scope_pushed_s == 1
      typecheck::tc_exit_scope(tc)
    end
    tc_with_handler_end(tc, _with_claim_s)
  
  # Arena block: arena name do...end
  elsif node_kind == 62  # node_constants$NODE_ARENA_BLOCK
    var arena_name = ast::ast_get_str1(ast_storage, node)
    var stmts = ast::ast_get_children(ast_storage, node)
    
    typecheck_util::tc_enter_scope()
    # Bind the arena name as a variable in scope
    typecheck_util::tc_scope_bind(tc, arena_name, type_constants::TYPE_INT, 0, "")
    # Push arena scope for escape analysis
    typecheck::tc_arena_push_scope(tc, arena_name)
    
    each(stmts, stmt: Int -> tc_stmt(tc, ast_storage, stmt))
    
    typecheck::tc_arena_pop_scope(tc)
    # Auto-invalidate scoped arena after block exits
    # Use last statement's line + 1 so allocations inside the block are correctly
    # detected as pre-invalidation (alloc_line < inv_line)
    var arena_end_line = line + 1
    if vec_size(stmts) > 0
      arena_end_line = ast::ast_get_line(ast_storage, stmts[vec_size(stmts) - 1]) + 1
    end
    typecheck::tc_arena_invalidate(tc, arena_name, arena_end_line)
    typecheck::tc_exit_scope(tc)
  
  # Expression statement
  # Note: expr >= 0 because node handle 0 is valid (first AST node)
  elsif node_kind == node_constants::NODE_EXPR_STMT
    var expr = ast::ast_get_left(ast_storage, node)
    if expr >= 0
      tc_expr(tc, ast_storage, expr)
    end
  
  # Break/Continue
  elsif node_kind == node_constants::NODE_BREAK
    var break_label = ast::ast_get_str1(ast_storage, node)
    if str_byte_len(break_label) > 0
      if typecheck_util::tc_has_loop_label(tc, break_label) == false
        error("Undefined loop label :#{break_label}", line, col)
      end
    end
    return
  elsif node_kind == node_constants::NODE_CONTINUE
    var cont_label = ast::ast_get_str1(ast_storage, node)
    if str_byte_len(cont_label) > 0
      if typecheck_util::tc_has_loop_label(tc, cont_label) == false
        error("Undefined loop label :#{cont_label}", line, col)
      end
    end
    return
  
  # Defer
  elsif node_kind == node_constants::NODE_DEFER
    # Type check the deferred body. Body may be an expression (bare call),
    # a statement (assignment, compound assign, field/index assign), or a
    # block (defer do ... end). tc_stmt dispatches all three uniformly.
    var body = ast::ast_get_left(ast_storage, node)
    if body >= 0
      tc_stmt(tc, ast_storage, body)
    end
  
  else
    # Try to type check as expression
    tc_expr(tc, ast_storage, node)
  end
  end  # close 5.1.B body-wrap
end

# ============================================================================
# Function Type Checking
# ============================================================================

## Type check a function definition.
## Handles parameter binding and body type checking with inference.
##
## Collect concrete type annotation from the return expression(s) in a function body.
## For endless-def (non-block body), infers from the body expression directly.
## For block bodies, scans NODE_RETURN nodes and infers from their expressions.
## Returns the concrete type string, or "" if not inferable.
## Emits QZ0161 if conflicting concrete types are found (same-type constraint).
## Recursively collect return type annotations from all branches of a body.
## Updates concrete with the first found annotation; errors on conflict.
def tc_collect_impl_returns(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, concrete: String, func_name: String): String
  var result = concrete
  var kind = ast::ast_get_kind(ast_storage, node)
  if kind == node_constants::NODE_RETURN
    var ret_expr = ast::ast_get_left(ast_storage, node)
    if ret_expr >= 0
      var ret_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, ret_expr)
      if str_byte_len(ret_ann) > 0
        if str_byte_len(result) > 0 and not result.eq(ret_ann)
          with Diag {
            error: typecheck_diag::tc_diag_error_handler,
            warn: typecheck_diag::tc_diag_warn_handler
          } do ->
            error("QZ0161: impl return type conflict — '#{result}' vs '#{ret_ann}' in '#{func_name}'", 0, 0)
          end
        end
        result = ret_ann
      end
    end
  elsif kind == node_constants::NODE_BLOCK or kind == node_constants::NODE_IF or kind == node_constants::NODE_MATCH
    # Recurse into block children, if/else branches, match arms
    var children = ast::ast_get_children(ast_storage, node)
    if children != 0
      for ci in 0..children.size
        result = tc_collect_impl_returns(tc, ast_storage, children[ci], result, func_name)
      end
    end
    # Also recurse into left/right children (if-then, if-else, etc.)
    var left = ast::ast_get_left(ast_storage, node)
    if left >= 0
      result = tc_collect_impl_returns(tc, ast_storage, left, result, func_name)
    end
    var right = ast::ast_get_right(ast_storage, node)
    if right >= 0
      result = tc_collect_impl_returns(tc, ast_storage, right, result, func_name)
    end
  elsif kind == node_constants::NODE_MATCH_ARM
    # Match arm: check body (right child)
    var arm_body = ast::ast_get_right(ast_storage, node)
    if arm_body >= 0
      result = tc_collect_impl_returns(tc, ast_storage, arm_body, result, func_name)
    end
  end
  return result
end

def tc_infer_impl_concrete_type(tc: TypecheckState, ast_storage: ast::AstStorage, body: AstNodeId, func_name: String): String
  return "" if body < 0
  var body_kind = ast::ast_get_kind(ast_storage, body)

  # Endless-def (non-block body): single expression IS the return value
  if body_kind != node_constants::NODE_BLOCK
    return typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, body)
  end

  # Block body: recursively scan for NODE_RETURN in all branches
  var concrete = ""
  concrete = tc_collect_impl_returns(tc, ast_storage, body, concrete, func_name)
  return concrete
end

## QZ0163 helper: detect a self-recursive call inside a function body.
## Walks the AST looking for NODE_CALL whose callee is NODE_IDENT with
## str1 == func_name. Returns true on first match.
##
## This is the simplest possible cycle detector — it catches direct
## self-recursion inside a function returning `impl Trait`. Deeper mutual
## recursion (f -> g -> f) is not detected here; that path is filed as a
## follow-up in IMPL-TRAIT-DESIGN §4.7. Direct self-recursion is the
## overwhelmingly common case (it's what Rust used to forbid before TAIT)
## and is what the QZ0163 help message asks the user to fix.
##
## Walker structure mirrors `liveness::liveness_walk`: dispatches on node
## kind so leaf nodes (literals, idents) early-return without descending
## into stale left/right slots, and only valid children are recursed into.
## A bounds check on `ast_node_count` keeps the walk safe against any
## stale pointers in the AST.
def tc_body_contains_self_call(ast_storage: ast::AstStorage, node: AstNodeId, func_name: String): Bool
  return false if node < 0
  return false if node >= ast::ast_node_count(ast_storage)
  var kind = ast::ast_get_kind(ast_storage, node)

  # Leaf nodes — no children of interest.
  return false if kind == node_constants::NODE_INT_LIT
  return false if kind == node_constants::NODE_BOOL_LIT
  return false if kind == node_constants::NODE_NIL_LIT
  return false if kind == node_constants::NODE_STRING_LIT
  return false if kind == node_constants::NODE_SYMBOL_LIT
  return false if kind == node_constants::NODE_FLOAT_LIT
  return false if kind == node_constants::NODE_REGEX_LIT
  return false if kind == node_constants::NODE_WILDCARD
  return false if kind == node_constants::NODE_IDENT

  # Match the call we're looking for.
  if kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(ast_storage, node)
    if callee > 0
      var callee_kind = ast::ast_get_kind(ast_storage, callee)
      if callee_kind == node_constants::NODE_IDENT
        var callee_name = ast::ast_get_str1(ast_storage, callee)
        if callee_name.eq(func_name)
          return true
        end
      end
    end
    # Walk arguments — they live in children.
    var args = ast::ast_get_children(ast_storage, node)
    if args != 0
      for ai in 0..args.size
        return true if tc_body_contains_self_call(ast_storage, args[ai], func_name)
      end
    end
    return false
  end

  # Block / program-style: walk children sequentially.
  if kind == node_constants::NODE_BLOCK
    var stmts = ast::ast_get_children(ast_storage, node)
    if stmts != 0
      for si in 0..stmts.size
        return true if tc_body_contains_self_call(ast_storage, stmts[si], func_name)
      end
    end
    return false
  end

  # Return statement: walk the returned expression.
  if kind == node_constants::NODE_RETURN
    var ret_expr = ast::ast_get_left(ast_storage, node)
    if ret_expr >= 0
      return tc_body_contains_self_call(ast_storage, ret_expr, func_name)
    end
    return false
  end

  # If/match: walk left, right, and arms.
  if kind == node_constants::NODE_IF or kind == node_constants::NODE_MATCH
    var left = ast::ast_get_left(ast_storage, node)
    if left >= 0
      return true if tc_body_contains_self_call(ast_storage, left, func_name)
    end
    var right = ast::ast_get_right(ast_storage, node)
    if right >= 0
      return true if tc_body_contains_self_call(ast_storage, right, func_name)
    end
    var arms = ast::ast_get_children(ast_storage, node)
    if arms != 0
      for mi in 0..arms.size
        return true if tc_body_contains_self_call(ast_storage, arms[mi], func_name)
      end
    end
    return false
  end

  # Match arm: body is in right.
  if kind == node_constants::NODE_MATCH_ARM
    var arm_body = ast::ast_get_right(ast_storage, node)
    if arm_body >= 0
      return tc_body_contains_self_call(ast_storage, arm_body, func_name)
    end
    return false
  end

  # Let / let-destructure: walk init expression in left.
  if kind == node_constants::NODE_LET or kind == node_constants::NODE_LET_DESTRUCTURE
    var init = ast::ast_get_left(ast_storage, node)
    if init >= 0
      return tc_body_contains_self_call(ast_storage, init, func_name)
    end
    return false
  end

  # Assignment: walk RHS (right).
  if kind == node_constants::NODE_ASSIGN
    var rhs = ast::ast_get_right(ast_storage, node)
    if rhs >= 0
      return tc_body_contains_self_call(ast_storage, rhs, func_name)
    end
    return false
  end

  # While/for: walk left (cond/iter) and right (body).
  if kind == node_constants::NODE_WHILE or kind == node_constants::NODE_FOR
    var w_left = ast::ast_get_left(ast_storage, node)
    if w_left >= 0
      return true if tc_body_contains_self_call(ast_storage, w_left, func_name)
    end
    var w_right = ast::ast_get_right(ast_storage, node)
    if w_right >= 0
      return true if tc_body_contains_self_call(ast_storage, w_right, func_name)
    end
    return false
  end

  # Expression statement wrapper: descend into the wrapped expression.
  if kind == node_constants::NODE_EXPR_STMT
    var inner = ast::ast_get_left(ast_storage, node)
    if inner >= 0
      return tc_body_contains_self_call(ast_storage, inner, func_name)
    end
    return false
  end

  # Binary/unary/field-access/index expressions: walk left + right + children.
  # This is the catch-all for expression nodes we don't handle specially.
  var dl = ast::ast_get_left(ast_storage, node)
  if dl > 0
    return true if tc_body_contains_self_call(ast_storage, dl, func_name)
  end
  var dr = ast::ast_get_right(ast_storage, node)
  if dr > 0
    return true if tc_body_contains_self_call(ast_storage, dr, func_name)
  end
  var dc = ast::ast_get_children(ast_storage, node)
  if dc != 0
    for di in 0..dc.size
      return true if tc_body_contains_self_call(ast_storage, dc[di], func_name)
    end
  end
  return false
end

## Recursively check if an AST subtree contains any NODE_RETURN.
## Used by the missing-return validator to find returns inside nested
## blocks (arena blocks, loops, if/match, etc.) — not just top-level.
## Check if a function body has an explicit return or an implicit return
## via last-expression-as-value (match, if, expression as last statement).
def tc_body_has_return_path(ast_storage: ast::AstStorage, body: AstNodeId): Bool
  return false if body < 0
  var body_kind = ast::ast_get_kind(ast_storage, body)
  # Direct return node
  return true if body_kind == node_constants::NODE_RETURN
  # Non-block body = single expression = implicit return
  if body_kind != node_constants::NODE_BLOCK
    return true
  end
  # Block body: scan direct children
  var stmts = ast::ast_get_children(ast_storage, body)
  if stmts <= 0
    return false
  end
  var count = stmts.size
  if count == 0
    return false
  end
  # Check if any direct child is a return statement
  for ri in 0..count
    var stmt_kind = ast::ast_get_kind(ast_storage, stmts[ri])
    if stmt_kind == node_constants::NODE_RETURN
      return true
    end
  end
  # Check if the last statement could be an implicit return:
  # match, if, expression statement, or any compound block that might return
  var last_kind = ast::ast_get_kind(ast_storage, stmts[count - 1])
  # Match/if as last statement = implicit return via last-expression-as-value
  if last_kind == node_constants::NODE_MATCH or last_kind == node_constants::NODE_IF
    return true
  end
  # Expression statement as last = implicit return (NODE_EXPR_STMT wraps expressions)
  if last_kind == node_constants::NODE_EXPR_STMT
    return true
  end
  # Arena block, do-block, or nested block as last statement
  if last_kind == node_constants::NODE_ARENA_BLOCK or last_kind == node_constants::NODE_BLOCK
    return true
  end
  # Any compound statement that could contain a return
  if last_kind == node_constants::NODE_WHILE or last_kind == node_constants::NODE_FOR
    return true
  end
  # Call expression as last statement (e.g., arena do ... end)
  if last_kind == node_constants::NODE_CALL
    return true
  end
  return false
end

## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   func        - Function node handle
## item-20 Phase 7 / WS4-b2 — QZ0407 enforcement predicate. DIRECT-ONLY twin of
## backend `mir_body_assigns_self_field`: returns 1 iff the body contains a DIRECT
## store `self.field = …` (a NODE_FIELD_ASSIGN whose object/`ast_get_left` is a
## NODE_IDENT named `self`). The TRANSITIVE UFCS-self-rooted-call arm of the backend
## predicate is DELIBERATELY OMITTED here — enforcement keys on direct field
## mutation only (design option A), so read-only forwarders like `Queue.first()` →
## `self.peek()` (transitive-only) do NOT trip QZ0407. Note `@field = value`
## desugars to `self.field = value` (NODE_FIELD_ASSIGN, IDENT "self") in CST-lower,
## so this predicate naturally counts both `self.field=` and `@field=` — intended.
## Whole-tree work-queue walk with the same handle-bounding as the backend twin
## (a 0 `children` slot is NOT a node-handle vec; reject handles outside
## [1, node_count) before touching storage). This is a DIAGNOSTIC-ONLY walk (no
## codegen), so it cannot change IR — it only rejects previously-accepted source.
def tc_body_assigns_self_field_directly(s: ast::AstStorage, root: Int): Int
  if root <= 0
    return 0
  end
  var node_count = ast::ast_node_count(s)
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    if node <= 0 or node >= node_count
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    if kind == node_constants::NODE_FIELD_ASSIGN
      var obj = ast::ast_get_left(s, node)
      if obj > 0 and obj < node_count
        if ast::ast_get_kind(s, obj) == node_constants::NODE_IDENT
          if ast::ast_get_str1(s, obj).eq("self")
            return 1
          end
        end
      end
    end
    # Traverse children — only when the raw slot is a real vec handle (non-zero).
    var children_raw = ast::ast_get_children_raw(s, node)
    if children_raw > 0
      var children = ast::ast_get_children(s, node)
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0 and child < node_count
          queue.push(child)
        end
      end
    end
    var left = ast::ast_get_left(s, node)
    if left > 0 and left < node_count
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0 and right < node_count
      queue.push(right)
    end
    var extra = ast::ast_get_extra(s, node)
    if extra > 0 and extra < node_count
      queue.push(extra)
    end
  end
  return 0
end

def tc_function(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId): Void can Diag
  return if func == 0

  var node_kind = ast::ast_get_kind(ast_storage, func)
  return if node_kind != node_constants::NODE_FUNCTION

  # Reset type inference state for this function scope
  typecheck_util::tc_tv_reset(tc)
  typecheck_util::tc_clear_pending_ptypes(tc)

  # WS1 — clear pending set_new back-stamp entries at each function boundary so a
  # receiver name reused across functions (e.g. `var s = set_new()` in several
  # helpers) can never cross-stamp: a set_new is only ever back-stamped by a
  # struct-element set_add in the SAME function. Without this a struct set_add in
  # one function would stamp a same-named Int-Set's set_new in another → the
  # Int-Set allocates the struct (hashmap) layout and set_add(int) crashes.
  vec_clear(tc.pending_set_new_vars)
  vec_clear(tc.pending_set_new_nodes)
  # WS3 — set element-type tracking for algebra is likewise function-scoped.
  vec_clear(tc.set_struct_elem_vars)
  vec_clear(tc.set_struct_elem_types)

  # Reset arena safety tracking for this function scope
  typecheck::tc_arena_reset(tc)

  # NLL: Set liveness context for this function
  liveness::liveness_set_current_function(func)

  var func_name = ast::ast_get_str1(ast_storage, func)
  var params = ast::ast_get_left(ast_storage, func)
  var body = ast::ast_get_right(ast_storage, func)
  var return_type_ann = ast::ast_get_str2(ast_storage, func)

  # Parse return type
  var return_type = type_constants::TYPE_VOID
  if str_byte_len(return_type_ann) > 0
    return_type = typecheck::tc_parse_type(tc, return_type_ann)
  end

  # Set current function return type
  typecheck_util::tc_set_return_type(tc, return_type)

  # B.7: stash the registry index of this function so that tc_expr_call
  # can subsume callee rows against the caller's own row. -1 falls
  # through (no row check at this call site).
  var cur_func_idx_b7 = typecheck_registry::tc_lookup_function_index(tc, func_name)
  typecheck_util::tc_set_current_func_idx(tc, cur_func_idx_b7)

  # Enter function scope
  typecheck_util::tc_enter_scope()

  # Bind parameters
  if params > 0
    var param_count = vec_size(params)
    for i in 0..param_count
      var param = params[i]
      var param_name = ast::ast_get_str1(ast_storage, param)
      var param_type_ann = ast::ast_get_str2(ast_storage, param)

      var param_type = type_constants::TYPE_INT
      var param_struct_name = ""
      if str_byte_len(param_type_ann) > 0
        param_type = typecheck::tc_parse_type(tc, param_type_ann)
        # Generic type params (e.g. T) resolve to type_constants$TYPE_ERROR.
        # Fall back to type_constants$TYPE_INT so the binding is visible in scope lookup
        # (type_constants$TYPE_ERROR is also the "not found" sentinel).
        if param_type == type_constants::TYPE_ERROR
          param_type = type_constants::TYPE_INT
        end
        # If it's a struct or enum type, store the type name
        if typecheck::tc_is_struct_type(param_type)
          # Strip leading & or &mut for borrow types
          param_struct_name = typecheck::strip_borrow_prefix(param_type_ann)
        elsif param_type == type_constants::TYPE_ENUM
          param_struct_name = param_type_ann
        end
      end

      if typecheck::tc_type_is_function(tc, param_type)
        # Resolve type alias to get actual Fn(...) annotation for arity extraction
        var fn_ann = param_type_ann
        var fn_aliased = typecheck::tc_lookup_type_alias(tc, fn_ann)
        if str_byte_len(fn_aliased) > 0
          fn_ann = fn_aliased
        end
        var fn_pc = typecheck::tc_fn_annotation_param_count(tc, fn_ann)
        typecheck_util::tc_scope_bind_full(tc, param_name, type_constants::TYPE_FUNCTION, 1, fn_pc, "", fn_ann)
      else
        typecheck_util::tc_scope_bind_full(tc, param_name, param_type, 1, -1, param_struct_name, param_type_ann)
      end
    end
  end

  # QZ0407 (item-20 Phase 7 / WS4-b2) — a method that mutates `self` directly must
  # declare a `&mut self` receiver. Mirrors the QZ0406 hard-error precedent
  # (typecheck_expr_handlers.qz:3447) but sited on the method DEFINITION here in
  # tc_function, which is the anchor a later alias/exclusivity checker grows onto.
  #
  # Fires as a HARD ERROR iff ALL THREE hold:
  #   1. EXPLICIT `self` receiver — params[0] is named exactly "self". An
  #      IMPLICIT-self `extend` method (`def set(key, value)` using `@field`/
  #      `self.field` with NO `self` param token) is EXEMPT: it has no receiver
  #      token to annotate, so enforcing it needs an out-of-scope ABI change.
  #   2. DIRECTLY mutates self — the body has a direct `self.field = …` (or the
  #      `@field = …` that desugars to it). Transitive-only forwarders do NOT
  #      qualify (direct-only predicate, transitive arm removed).
  #   3. Does NOT declare `&mut self` — ast_param_receiver_borrow(params[0]) != 2
  #      (bare `self` = 0 or `&self` = 1). `&mut self` = 2 is the correct form.
  if params > 0 and vec_size(params) > 0
    var _p0 = params[0]
    if ast::ast_get_str1(ast_storage, _p0).eq("self")
      if ast::ast_param_receiver_borrow(ast_storage, _p0) != 2
        if tc_body_assigns_self_field_directly(ast_storage, body) == 1
          typecheck_diag::tc_diag_error_at(ast_storage, func, "QZ0407: method `#{func_name}` mutates `self` but does not declare a `&mut self` receiver (change `self` to `&mut self`)")
        end
      end
    end
  end

  # WS4 (Law of Exclusivity) — static access-path exclusivity (QZ0408) + the
  # non-escape rule (QZ0409) for second-class borrows. Warning-mode, diagnostic-
  # only (reads the AST, emits warnings, never rewrites) so the default build is
  # gate-0 byte-identical. Sited right after the QZ0407 block — the designated
  # anchor a later alias/exclusivity checker grows onto.
  exclusivity::excl_check_function(ast_storage, func, tc)

  # Detect impl Trait return type for concrete type inference after body TC
  var is_impl_return = false
  var impl_trait_name = ""
  if str_byte_len(return_type_ann) > 5 and return_type_ann.starts_with("impl ")
    is_impl_return = true
    impl_trait_name = str_byte_slice(return_type_ann, 5, str_byte_len(return_type_ann))
  end

  # Phase 4D.6: detect generator return-type for the implicit Yield/Async push
  # below. Previously this also wrote to `tc.reserved[0]` so QZ0170/QZ0172
  # checks could read "am I in a generator?" — that cache is gone; readers now
  # consult `_tc_current_func_is_generator(tc)` which queries the registry's
  # return-type annotation directly.
  var is_generator = false
  var is_async_generator = false
  if is_impl_return
    var async_iter_prefix = "AsyncIterator"
    var iter_prefix = "Iterator"
    if str_byte_len(impl_trait_name) >= str_byte_len(async_iter_prefix)
      if impl_trait_name.starts_with(async_iter_prefix)
        is_generator = true
        is_async_generator = true
      end
    end
    if not is_generator
      if str_byte_len(impl_trait_name) >= str_byte_len(iter_prefix)
        if impl_trait_name.starts_with(iter_prefix)
          is_generator = true
        end
      end
    end
    # Phase 4D.3: row-poly async-generator detection. The user-facing form
    # `def gen(): impl Iterator<T> can Async` widens callers by Async via
    # the function's effect row, not by syntactic AsyncIterator. The row was
    # populated by tc_attach_func_effect_row at signature time; we read it
    # here and treat the function as an async generator (handler-stack
    # Async push, MIR async-gen lowering, F.3c widening for callers).
    # `impl AsyncIterator<T>` remains the explicit form for source compat.
    # Phase 4D.3: row-poly async-generator detection. The user-facing form
    # `def gen(): impl Iterator<T> can Async` widens callers by Async via
    # the impl-Trait return-type's `can` suffix. The parser captures that
    # suffix as part of impl_trait_name (parser.qz:622-638) — the
    # function-level `can` clause never fires because the parser already
    # consumed the TOK_CAN. Read the suffix here and treat the function as
    # an async generator (handler-stack Async push, MIR async-gen lowering,
    # F.3c widening for callers).
    # `impl AsyncIterator<T>` remains the explicit form for source compat.
    if is_generator and is_async_generator == false
      var _4d3_can_idx = typecheck::_tc_find_last_can_marker(impl_trait_name)
      if _4d3_can_idx >= 0
        var _4d3_can_suffix = str_byte_slice(impl_trait_name, _4d3_can_idx + 4, str_byte_len(impl_trait_name)).trim()
        var _4d3_pipe = __char_index(_4d3_can_suffix, '|')
        var _4d3_label_part = _4d3_can_suffix
        if _4d3_pipe >= 0
          _4d3_label_part = str_byte_slice(_4d3_can_suffix, 0, _4d3_pipe).trim()
        end
        if _4d3_label_part == "Async"
          is_async_generator = true
        end
      end
    end
  end

  # Phase 4 Path B (4.B.2): implicitly install Yield (and Async for async
  # generators) on the handler-effect stack while typechecking the body.
  # This models the `with Yield { ... } do -> <body> end` that 4.B.4's
  # Stream.next() installs at iteration time — the body is written as
  # if always under a Yield handler. Payoff: a body can call a modular
  # helper `def emit_pair(...) can Yield<Int>` because `can Yield` on the
  # helper subsumes against the handler stack, not against the generator's
  # own row (which stays clean per the F.3c consumer-widens convention).
  var _p4b_gen_pushes = 0
  if is_generator
    var _p4b_yield_id = string_intern::intern_id(tc.interner, "Yield")
    typecheck_util::tc_handler_effect_push(_p4b_yield_id)
    _p4b_gen_pushes = _p4b_gen_pushes + 1
    if is_async_generator
      var _p4b_async_id = string_intern::intern_id(tc.interner, "Async")
      typecheck_util::tc_handler_effect_push(_p4b_async_id)
      _p4b_gen_pushes = _p4b_gen_pushes + 1
    end
  end

  # PSQ-6 / Sched effect, Phase C.2 (2026-04-30): if this function's
  # row carries `Sched`, set tc.in_sched_min_depth to the current scope
  # depth. The body-walk's NODE_IDENT branch consults this to fire
  # QZ1408 on captured/global non-Sync reads. Save+restore handles
  # nested tc_function (lambdas, helpers walked under outer body).
  var saved_sched_min_depth = tc.in_sched_min_depth
  if cur_func_idx_b7 >= 0
    if typecheck_registry::tc_func_has_effect(tc, cur_func_idx_b7, "Sched") == 1
      tc.in_sched_min_depth = typecheck_util::tc_get_depth(tc)
    else
      # Reset for non-Sched function — lambda nested inside Sched body
      # walks its own body without the check (their captures escape via
      # a separate mechanism the user owns; see Phase C limits in
      # docs/handoff/sched-effect-thread-safety-kickoff.md).
      tc.in_sched_min_depth = 0
    end
  else
    tc.in_sched_min_depth = 0
  end

  # Type check function body
  # Note: body >= 0 because node handle 0 is valid (first AST node)
  if body >= 0
    tc_stmt(tc, ast_storage, body)
  end

  tc.in_sched_min_depth = saved_sched_min_depth

  # Pair the implicit pushes.
  while _p4b_gen_pushes > 0
    typecheck_util::tc_handler_effect_pop()
    _p4b_gen_pushes = _p4b_gen_pushes - 1
  end

  # impl Trait return type: infer concrete type, verify trait impl, register
  if is_impl_return and body >= 0
    # QZ0163: detect direct self-recursion inside an impl Trait function.
    # This is the well-known Rust restriction: opaque return-type inference
    # diverges if the function calls itself, because the inferred type would
    # depend on itself. Skip generators — `yield` recursion is a separate
    # concept. The fix is to name the concrete return type explicitly.
    if is_generator == false
      if tc_body_contains_self_call(ast_storage, body, func_name)
        error("QZ0163: recursive impl Trait inference in '#{func_name}' — name the concrete return type explicitly", 0, 0)
      end
    end
    var concrete_type = tc_infer_impl_concrete_type(tc, ast_storage, body, func_name)
    # 4.B.2: the parser synthesizes `return <last_expr>` for any def-body
    # whose last statement is a NODE_EXPR_STMT (parser.qz:6404). A generator
    # body ending in a call to a Void-returning helper produces a synthetic
    # `return emit_pair(...)` whose type is Void — that's semantically
    # "call helper, terminate generator", not an actual iterable type.
    # tc_collect_impl_returns picks up Void as the concrete type, which
    # then fails QZ0162 against Iterator<Int>. Strip Void inferred for
    # generators: the real concrete type is the synthesized __GenState_*
    # struct built by mir_lower_generator.
    if is_generator and concrete_type == "Void"
      concrete_type = ""
    end
    # QZ0165: empty concrete inference for a non-generator impl Trait function.
    # Generators legitimately have no NODE_RETURN (they use yield), so skip
    # them. Otherwise, an empty result means the body has no return statements
    # the inferencer could read — e.g. `def f(): impl Iter = panic("todo")` or
    # a body that only `panic`s / loops. We can't infer the concrete type, so
    # the function cannot be type-checked or monomorphized.
    if str_byte_len(concrete_type) == 0 and is_generator == false
      error("QZ0165: cannot infer concrete type for impl Trait return in '#{func_name}' — body has no return statements with an inferable type. Add an explicit `return ConcreteType { ... }` or replace the impl Trait return with a named type.", 0, 0)
    end
    if str_byte_len(concrete_type) > 0
      # Strip generic args from trait name for impl lookup: "Iterator<Int>" -> "Iterator"
      var impl_lt = __char_index(impl_trait_name, '<')
      var impl_base = impl_trait_name
      if impl_lt > 0
        impl_base = str_byte_slice(impl_trait_name, 0, impl_lt)
      end
      # Verify concrete type implements the declared trait
      var impl_lookup = typecheck_registry::tc_lookup_impl(tc, impl_base, concrete_type)
      if impl_lookup < 0
        # Also check with full trait name (e.g., "Iterator<Int>")
        impl_lookup = typecheck_registry::tc_lookup_impl(tc, impl_trait_name, concrete_type)
      end
      if impl_lookup < 0
        # A6: thread the function node's real line/col so the diagnostic has a
        # `-->` source pointer (previously emitted at 0,0 — no location at all).
        error("QZ0162: '#{concrete_type}' does not implement '#{impl_trait_name}'", ast::ast_get_line(ast_storage, func), ast::ast_get_col(ast_storage, func))
      end
      typecheck_registry::tc_register_impl_return(tc, func_name, concrete_type, impl_trait_name)
      # Phase 1 fix: stamp the function AST node's str2 with the concrete type so
      # downstream MIR lowering (which reads ast_get_str2 directly) sees the concrete
      # struct name instead of the literal "impl Trait" annotation. This prevents
      # the whitespace-in-symbol bug (probe 2). Opacity enforcement (Phase 7) stays
      # in the typechecker's separate func_return_annotations registry path.
      ast::ast_set_str2(ast_storage, func, concrete_type)
    end
  end

  # Phase 4D.3: row-poly async-generator stamp. When the user writes
  # `def gen(): impl Iterator<T> can Async`, the row-based detection above
  # set is_async_generator. Rewrite str2 to the equivalent
  # `impl AsyncIterator<T>` form so MIR's prefix dispatch
  # (`mir_lower_function_with_name` → `mir_lower_generator_effect`, the
  # unified sync+async ctor lowering post-4D.5c.5) and F.3c's syntactic
  # widen (typecheck_walk.qz:3424) both fire identically to the explicit
  # AsyncIterator form. The original `can Async` is redundant — the row
  # was already attached at signature time.
  if is_async_generator and str_byte_len(impl_trait_name) >= 9
    if impl_trait_name.starts_with("Iterator<")
      var _4d3_stamp = "AsyncIterator#{str_byte_slice(impl_trait_name, 8, str_byte_len(impl_trait_name))}"
      var _4d3_can_idx = typecheck::_tc_find_last_can_marker(_4d3_stamp)
      if _4d3_can_idx >= 0
        _4d3_stamp = str_byte_slice(_4d3_stamp, 0, _4d3_can_idx)
      end
      ast::ast_set_str2(ast_storage, func, "impl #{_4d3_stamp}")
    end
  end

  # Phase 4D.4b: synthesize Stream<T, body_row> ptype as the function's
  # registered return type. Generators (sync and async) constructively
  # return a Stream-shaped value; the body row carries the effect labels
  # callers should widen by when they call `.next()`. Today this is
  # SUBSTRATE-ONLY — the consumer wiring (Stream.next call-site row
  # binding + F.3c folding) lands in 4D.4c. Without consumer wiring the
  # synthesized ptype is queryable via tc_get_func_return_type but does
  # not yet drive caller widening; F.3c at typecheck_walk.qz:3411 stays
  # load-bearing for `for v in src`-of-async-iterator. Mirrors the 4D.1
  # pattern (substrate first, value-flow consumption later).
  #
  # Encoding: TYPE_STRUCT ptype with name="Stream", arg1=T, arg2=row+1.
  # `tc_synth_stream_ptype` interns; `tc_set_func_return_type` mutates
  # the registry's func_return_types slot. Pre-synthesis this slot held
  # bare TYPE_STRUCT (line 1177 of typecheck.qz returns TYPE_STRUCT for
  # any `impl Trait<...>` annotation); the upgrade preserves the base
  # kind (still TYPE_STRUCT under tc_base_kind) so existing UFCS
  # dispatch (typecheck_expr_handlers.qz:2578-2632) is unaffected.
  if is_generator and str_byte_len(impl_trait_name) > 0
    # Strip a trailing ` can ROW` from impl_trait_name before extracting T.
    # `impl_trait_name` survives the 4D.3 str2 rewrite at line 4196 because
    # the rewrite only mutates the AST node's str2; the local string here
    # still carries the original `... can Async` suffix when the user wrote
    # the row-poly form. Strip it cleanly so T extraction sees "Iterator<T>".
    var _4d4b_base = impl_trait_name
    var _4d4b_can_idx = typecheck::_tc_find_last_can_marker(_4d4b_base)
    if _4d4b_can_idx >= 0
      _4d4b_base = str_byte_slice(_4d4b_base, 0, _4d4b_can_idx)
    end
    # _4d4b_base is now "Iterator<T>" or "AsyncIterator<T>"; extract T.
    var _4d4b_lt2 = __char_index(_4d4b_base, '<')
    if _4d4b_lt2 > 0 and str_byte_at(_4d4b_base, str_byte_len(_4d4b_base) - 1) == '>'
      var _4d4b_t_str = str_byte_slice(_4d4b_base, _4d4b_lt2 + 1, str_byte_len(_4d4b_base) - 1).trim()
      if str_byte_len(_4d4b_t_str) > 0
        var _4d4b_t = typecheck::tc_parse_type(tc, _4d4b_t_str)
        if _4d4b_t == type_constants::TYPE_ERROR
          _4d4b_t = type_constants::TYPE_INT
        end
        # body_row source order:
        # 1. Function-level `can` clause via tc_get_func_effect_row (rare —
        #    the parser steers `impl Trait can ROW` through ps_parse_type's
        #    consume-as-annotation path, NOT through the function-level can).
        # 2. The `can` suffix on impl_trait_name itself (the row-poly form
        #    `def gen(): impl Iterator<T> can Async`).
        # 3. Implicit Async for the explicit `impl AsyncIterator<T>` form
        #    (is_async_generator true via the syntactic prefix check at
        #    line 4051) — async generators conceptually perform Async even
        #    though their author didn't declare it on the trait.
        var _4d4b_row = typecheck_registry::tc_get_func_effect_row(tc, cur_func_idx_b7)
        if _4d4b_row < 0
          # Try the impl-Trait `can` suffix.
          if _4d4b_can_idx >= 0
            var _4d4b_can_suffix = str_byte_slice(impl_trait_name, _4d4b_can_idx + 4, str_byte_len(impl_trait_name)).trim()
            var _4d4b_pipe = __char_index(_4d4b_can_suffix, '|')
            var _4d4b_lbl = _4d4b_can_suffix
            if _4d4b_pipe >= 0
              _4d4b_lbl = str_byte_slice(_4d4b_can_suffix, 0, _4d4b_pipe).trim()
            end
            if str_byte_len(_4d4b_lbl) > 0
              var _4d4b_lbl_id = string_intern::intern_id(tc.interner, _4d4b_lbl)
              var _4d4b_lbls = vec_new()
              _4d4b_lbls.push(_4d4b_lbl_id)
              _4d4b_row = typecheck_registry::tc_row_new(tc, _4d4b_lbls, -1)
            end
          end
        end
        if _4d4b_row < 0 and is_async_generator
          # Explicit `impl AsyncIterator<T>` — implicit Async row.
          var _4d4b_async_id = string_intern::intern_id(tc.interner, "Async")
          var _4d4b_async_lbls = vec_new()
          _4d4b_async_lbls.push(_4d4b_async_id)
          _4d4b_row = typecheck_registry::tc_row_new(tc, _4d4b_async_lbls, -1)
        end
        var _4d4b_ptype = typecheck::tc_synth_stream_ptype(tc, _4d4b_t, _4d4b_row)
        typecheck_registry::tc_set_func_return_type(tc, cur_func_idx_b7, _4d4b_ptype)
      end
    end
  end

  # Missing return check: if function declares a non-Void return type
  # but has no return statement anywhere in the body, emit an error.
  # Skip for typecheck$main() which may use implicit exit code.
  # Skip for generator functions (they use yield, not return).
  # Uses recursive scan to find returns inside any nested block structure
  # (arena blocks, if/match, loops, etc.).
  if return_type != type_constants::TYPE_VOID and return_type != type_constants::TYPE_ERROR
    if func_name != "main" and is_generator == false
      if body >= 0
        var has_return = tc_body_has_return_path(ast_storage, body)
        if has_return == false
          var func_line = ast::ast_get_line(ast_storage, func)
          var func_col = ast::ast_get_col(ast_storage, func)
          error("Function '#{func_name}' declares return type #{typecheck::tc_type_name(return_type)} but has no return statement", func_line, func_col)
        end
      end
    end
  end

  # QZ0204: Detect unconstrained type variables in function body
  typecheck_util::tc_check_unconstrained_type_vars(tc)

  # Refine interprocedural borrow summary with body analysis results (T3c.2 Phase 2)
  typecheck::tc_refine_borrow_summary(tc, func_name, params, body, ast_storage)

  # Resolve any remaining pending ptypes at function exit
  # Unresolved type vars default to TYPE_INT (existential erasure — everything is i64)
  typecheck_util::tc_clear_pending_ptypes(tc)

  # Exit function scope
  typecheck::tc_exit_scope(tc)

  # Reset return type
  typecheck_util::tc_set_return_type(tc, type_constants::TYPE_VOID)
end

# ============================================================================
# Main Entry Point
# ============================================================================

## Type check a program.
## Implements the 4-pass algorithm from C bootstrap:
## 1. Register all struct/enum definitions
## 2. Register all function signatures
## 3. Type check global let bindings
## 4. Type check function bodies
##
## Parameters:
##   tc - Type checker context
##
## Returns: true if no errors
def tc_check_program(tc: TypecheckState): Bool
  # The actual implementation would:
  # Pass 1: Walk all struct/enum defs and register them
  # Pass 2: Walk all function defs and register signatures
  # Pass 3: Walk global lets and typecheck + bind
  # Pass 4: Walk function bodies and typecheck
  
  # This requires AST access, which the standalone typecheck module
  # doesn't have. Integration with the full compiler pipeline will
  # call tc_register_struct, tc_register_enum, tc_register_function,
  # and the statement/expression checkers directly.
  
  return typecheck_util::tc_has_errors(tc) == false
end
