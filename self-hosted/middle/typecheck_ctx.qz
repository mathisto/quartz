##! # Typecheck Context Bridge
##!
##! Routes the `State<TcCtx>` algebraic effect (declared in `std/state.qz`)
##! to the ambient TypecheckState. The bridge mirrors `typecheck_diag.qz`'s
##! single-slot strategy: `tc_ctx_set(tc)` is called once at the top of
##! `compile()`, and the slot stays live for the remainder of the pass.
##!
##! Operation Piezoelectric Effects, Phase 5.2 (compiler dogfooding —
##! State<TcCtx> on scope-stack push/pop).
##!
##! ## Why a bridge and not naked `with State(tc) do -> ...`
##!
##! Installing `with State(as_int(tc))` at the top of `tc_program` would
##! force every function on the tc_program → tc_function → tc_stmt →
##! tc_expr → … call chain to propagate `can State` through its effect
##! row — a fan-out on the order of ~100 signature edits. The Phase 5.1
##! Diagnostics migration proved that a body-wrap strategy (the function
##! installs a handler over its own body so its caller sees no `can ...`
##! in the signature) is a viable incremental path. This bridge plays
##! the same role for State: leaf helpers body-wrap themselves with
##! `with State(as_int(tc_ctx_get())) do -> … end`, fetch tc via the
##! effect's `get()`, and expose no effect row upward.
##!
##! ## When to use direct tc vs. the effect path
##!
##! - Direct tc param — existing code that takes `tc: TypecheckState`
##!   explicitly. No migration cost for callers.
##! - `with State(as_int(tc_ctx_get())) do -> …` + `as_type<TypecheckState>(get())`
##!   — leaf helpers that want to dogfood the effect machinery. Proves
##!   State<S> evidence-slot compilation on a real compiler payload.
##!
##! ## Slot lifecycle
##!
##! `tc_ctx_set(tc)` runs once at the top of each compile pass (called
##! from `quartz.qz::compile()` right after `tc_new()`). The slot stays
##! live until a subsequent compile pass overwrites it. Callers never
##! need to clear — the next compile overwrites.

import typecheck_util
import * from str_compat

## Single-slot home for the active TypecheckState. Vec form (not a scalar)
## because Quartz top-level vars need an initial value, and Vec<T>'s
## `vec_new<T>()` is the cheap any-typed default.
var __tc_ctx_active: Vec<TypecheckState> = vec_new<TypecheckState>()

## Set the active typecheck context. Idempotent — repeated calls just
## overwrite the slot. Call once at the top of each compile pass.
def tc_ctx_set(tc: TypecheckState): Void
  if __tc_ctx_active.size == 0
    __tc_ctx_active.push(tc)
  else
    __tc_ctx_active[0] = tc
  end
end

## Clear the active typecheck context. Optional — call between compile
## passes if you want the empty-slot breadcrumb to fire on stale reads.
def tc_ctx_clear(): Void
  if __tc_ctx_active.size > 0
    var _t = __tc_ctx_active.pop()
  end
end

## Fetch the active TypecheckState. Called by leaf helpers that want to
## install `with State(as_int(tc_ctx_get())) do -> … end` before
## performing State operations. If the slot is empty (nobody called
## `tc_ctx_set` yet), writes a stderr breadcrumb and returns the empty
## slot's default — downstream consumers MUST check `tc_ctx_is_active`
## if they cannot guarantee compile() was entered.
def tc_ctx_get(): TypecheckState
  if __tc_ctx_active.size == 0
    eputs("[tc_ctx] tc_ctx_get fired with no active TC; returning default")
  end
  return __tc_ctx_active[0]
end

## Return 1 if a TC is currently installed, 0 otherwise. Used by
## defensive callers that might fire before compile() sets up the slot
## (e.g., test harnesses).
def tc_ctx_is_active(): Int
  return __tc_ctx_active.size
end
