##! # Type Environment
##!
##! Tracks variable types and scopes during type checking.
##!
##! @see typecheck
##! @since 1.0.0

# Type Environment - Scoped Symbol Table for Type Checking
#
# Uses a typed struct for compile-time safety (Phase 5.6.2 refactoring).
# All functions take TypeEnv struct as first parameter.
#
# Fields:
#   binding_names, binding_types, binding_depths, binding_mutables - variable bindings
#   struct_names, struct_types - struct definitions
#   enum_names, enum_types - enum definitions
#   func_names, func_types - function signatures
#   scope_stack - binding counts at scope entry
#   depth, return_type, binding_limit - metadata

## Environment for type checking.
struct TypeEnv
  ## Variable names in scope
  binding_names: Vec<String>
  ## Types of variables
  binding_types: Vec<Int>
  ## Scope levels/depths
  binding_depths: Vec<Int>
  ## Variable mutability flags
  binding_mutables: Vec<Int>
  ## Struct definition names
  struct_names: Vec<String>
  ## Struct definition types
  struct_types: Vec<Int>
  ## Enum definition names
  enum_names: Vec<String>
  ## Enum definition types
  enum_types: Vec<Int>
  ## Function names
  func_names: Vec<String>
  ## Function types
  func_types: Vec<Int>
  ## Stack of scope binding counts
  scope_stack: Vec<Int>
  ## Current scope depth
  depth: Int
  ## Current function return type
  return_type: Int
  ## Binding limit for current scope
  binding_limit: Int
end

# Create a new type environment
def typeenv_new(): TypeEnv
  return TypeEnv {
    binding_names: vec_new<String>(),
    binding_types: vec_new(),
    binding_depths: vec_new(),
    binding_mutables: vec_new(),
    struct_names: vec_new<String>(),
    struct_types: vec_new(),
    enum_names: vec_new<String>(),
    enum_types: vec_new(),
    func_names: vec_new<String>(),
    func_types: vec_new(),
    scope_stack: vec_new(),
    depth: 0,
    return_type: 0,
    binding_limit: 0
  }
end

# Get current scope depth
def typeenv_depth(env: TypeEnv): Int = env.depth

# Set current scope depth
def typeenv_set_depth(env: TypeEnv, depth: Int): Void
  env.depth = depth
end

# Get current function's return type
def typeenv_return_type(env: TypeEnv): Int = env.return_type

# Set current function's return type
def typeenv_set_return_type(env: TypeEnv, ret_type: Int): Void
  env.return_type = ret_type
end

# Get binding limit (for scope management)
def typeenv_binding_limit(env: TypeEnv): Int = env.binding_limit

# Set binding limit
def typeenv_set_binding_limit(env: TypeEnv, limit: Int): Void
  env.binding_limit = limit
end

# Enter a new scope
def typeenv_push_scope(env: TypeEnv): Void
  env.depth = env.depth + 1
  
  # Save current binding count on scope stack
  names = env.binding_names
  scope_stack = env.scope_stack
  scope_stack.push(names.size)
end

# Exit current scope (logically removes bindings at current depth)
def typeenv_pop_scope(env: TypeEnv): Void
  if env.depth > 0
    scope_stack = env.scope_stack
    stack_len = scope_stack.size
    
    if stack_len > 0
      # Get the binding count when we entered this scope
      prev_count = scope_stack[stack_len - 1]
      
      # Set binding limit so lookups ignore newer bindings
      # We can't pop from scope_stack, so we track limit in metadata
      env.binding_limit = prev_count
    end
    
    env.depth = env.depth - 1
  end
end

# Get effective binding count (respects scope limit)
def typeenv_effective_binding_count(env: TypeEnv): Int
  names = env.binding_names
  actual_len = names.size
  limit = env.binding_limit
  
  # If limit is 0, no limit is set - use actual length
  # Otherwise, use the limit if it's less than actual
  if limit > 0
    if limit < actual_len
      return limit
    end
  end
  return actual_len
end

# Bind a variable in current scope
def typeenv_bind(env: TypeEnv, name: String, typ: Int, is_mutable: Int): Void
  names = env.binding_names
  types = env.binding_types
  depths = env.binding_depths
  mutables = env.binding_mutables
  depth = env.depth

  names.push(name)
  types.push(typ)
  depths.push(depth)
  mutables.push(is_mutable)

  # Clear binding limit since we're adding new bindings
  env.binding_limit = 0
end

# Lookup variable type (returns 0 if not found)
def typeenv_lookup(env: TypeEnv, name: String): Int
  names = env.binding_names
  types = env.binding_types
  effective_count = typeenv_effective_binding_count(env)

  # Search from end (most recent binding first)
  var i = effective_count - 1
  while i >= 0
    if names[i].eq(name)
      return types[i]
    end
    i -= 1
  end

  return 0  # Not found
end

# Check if variable is mutable (returns -1 if not found)
def typeenv_is_mutable(env: TypeEnv, name: String): Int
  names = env.binding_names
  mutables = env.binding_mutables
  effective_count = typeenv_effective_binding_count(env)

  # Search from end
  var i = effective_count - 1
  while i >= 0
    if names[i].eq(name)
      return mutables[i]
    end
    i -= 1
  end

  return -1  # Not found
end

# Check if variable exists in current scope (for redefinition check)
def typeenv_defined_in_scope(env: TypeEnv, name: String): Int
  names = env.binding_names
  depths = env.binding_depths
  depth = env.depth
  effective_count = typeenv_effective_binding_count(env)

  var i = effective_count - 1
  while i >= 0
    binding_depth = depths[i]
    if binding_depth < depth
      # Reached outer scope, not found in current
      return 0
    end
    if names[i].eq(name)
      return 1
    end
    i -= 1
  end

  return 0
end

# Register a struct definition
def typeenv_register_struct(env: TypeEnv, name: String, typ: Int): Void
  names = env.struct_names
  types = env.struct_types
  names.push(name)
  types.push(typ)
end

# Lookup struct type by name
def typeenv_lookup_struct(env: TypeEnv, name: String): Int
  names = env.struct_names
  types = env.struct_types

  var len = names.size
  for i in 0..len
    if names[i].eq(name)
      return types[i]
    end
  end

  return 0  # Not found
end

# Register an enum definition
def typeenv_register_enum(env: TypeEnv, name: String, typ: Int): Void
  names = env.enum_names
  types = env.enum_types
  names.push(name)
  types.push(typ)
end

# Lookup enum type by name
def typeenv_lookup_enum(env: TypeEnv, name: String): Int
  names = env.enum_names
  types = env.enum_types

  var len = names.size
  for i in 0..len
    if names[i].eq(name)
      return types[i]
    end
  end

  return 0  # Not found
end

# Register a function signature
def typeenv_register_func(env: TypeEnv, name: String, typ: Int): Void
  names = env.func_names
  types = env.func_types
  names.push(name)
  types.push(typ)
end

# Lookup function type by name
def typeenv_lookup_func(env: TypeEnv, name: String): Int
  names = env.func_names
  types = env.func_types

  var len = names.size
  for i in 0..len
    if names[i].eq(name)
      return types[i]
    end
  end

  return 0  # Not found
end

# Get all variable names (for "did you mean" suggestions)
def typeenv_all_var_names(env: TypeEnv): Vec<String> = env.binding_names

# Get all function names
def typeenv_all_func_names(env: TypeEnv): Vec<String> = env.func_names

# Get all struct names
def typeenv_all_struct_names(env: TypeEnv): Vec<String> = env.struct_names

# Get all enum names
def typeenv_all_enum_names(env: TypeEnv): Vec<String> = env.enum_names

## Compute Damerau-Levenshtein distance between two strings.
## This edit distance counts insertions, deletions, substitutions,
## and transpositions of adjacent characters.
##
## Parameters:
##   a - First string
##   b - Second string
##
## Returns: Edit distance (0 = identical, higher = more different)
def edit_distance(a: String, b: String): Int
  len_a = str_byte_len(a)
  len_b = str_byte_len(b)
  
  # Handle empty strings
  return len_b if len_a == 0
  return len_a if len_b == 0
  
  # Use 3-row approach for O(n) space with transposition support
  # prev2 = d[i-2], prev1 = d[i-1], curr = d[i]
  prev2 = vec_new()
  prev1 = vec_new()
  curr = vec_new()
  
  # Initialize vectors
  for j in 0..(len_b + 1)
    prev2.push(0)
    prev1.push(j)
    curr.push(0)
  end
  
  # Fill the matrix
  for i in 1..(len_a + 1)
    curr[0] = i
    
    for j in 1..(len_b + 1)
      char_a = str_byte_at(a, i - 1)
      char_b = str_byte_at(b, j - 1)
      
      # Case-insensitive comparison
      var char_a_lower = char_a
      if char_a >= 65
        if char_a <= 90
          char_a_lower = char_a + 32
        end
      end
      var char_b_lower = char_b
      if char_b >= 65
        if char_b <= 90
          char_b_lower = char_b + 32
        end
      end
      
      var cost = 1
      if char_a_lower == char_b_lower
        cost = 0
      end
      
      # Standard Levenshtein: min of delete, insert, substitute
      del = prev1[j] + 1
      ins = curr[j - 1] + 1
      sub = prev1[j - 1] + cost
      
      var min_val = del
      if ins < min_val
        min_val = ins
      end
      if sub < min_val
        min_val = sub
      end
      
      # Damerau extension: check for transposition
      if i > 1
        if j > 1
          prev_char_a = str_byte_at(a, i - 2)
          prev_char_b = str_byte_at(b, j - 2)
          
          # Case-insensitive for transposition check
          var prev_a_lower = prev_char_a
          if prev_char_a >= 65
            if prev_char_a <= 90
              prev_a_lower = prev_char_a + 32
            end
          end
          var prev_b_lower = prev_char_b
          if prev_char_b >= 65
            if prev_char_b <= 90
              prev_b_lower = prev_char_b + 32
            end
          end
          
          # If a[i-1] == b[j-2] and a[i-2] == b[j-1], it's a transposition
          if char_a_lower == prev_b_lower
            if prev_a_lower == char_b_lower
              trans = prev2[j - 2] + cost
              if trans < min_val
                min_val = trans
              end
            end
          end
        end
      end
      
      curr[j] = min_val
    end
    
    # Rotate rows: prev2 <- prev1 <- curr
    for k in 0..(len_b + 1)
      prev2[k] = prev1[k]
      prev1[k] = curr[k]
    end
  end
  
  result = prev1[len_b]
  
  prev2.free
  prev1.free
  curr.free
  
  return result
end

## Find the best matching name from a list of candidates.
## Uses Damerau-Levenshtein distance with a threshold based on name length.
##
## Parameters:
##   name       - The misspelled/unknown name to match
##   candidates - Vector of candidate name strings (as Int pointers)
##
## Returns: Best matching name string, or empty string if no good match
def find_best_match(name: String, candidates: Vec<String>): String
  var name_len = str_byte_len(name)

  # Defensive: if candidates is nil or invalid, return empty
  return "" if candidates == 0

  # Threshold: allow 1 edit for short names, name_len/3 for longer
  var threshold = 1
  if name_len >= 3
    threshold = name_len / 3
  end

  var best_match = ""
  var best_distance = threshold + 1

  var candidate_count = candidates.size
  # Defensive: sanity check the count
  return "" if candidate_count < 0 or candidate_count > 100000

  for i in 0..candidate_count
    candidate = candidates[i]
    # Skip empty strings
    continue if str_byte_len(candidate) == 0
    dist = edit_distance(name, candidate)

    if dist < best_distance
      best_distance = dist
      best_match = candidate
    end

    # Prefix matching: if name is a prefix of candidate (or vice versa) and len >= 2
    if name_len >= 2 and str_byte_len(candidate) >= 2
      if str_byte_len(candidate) > name_len
        if candidate.starts_with(name)
          if best_distance > 1
            best_distance = 1
            best_match = candidate
          end
        end
      elsif name_len > str_byte_len(candidate)
        if name.starts_with(candidate)
          if best_distance > 1
            best_distance = 1
            best_match = candidate
          end
        end
      end
    end
  end

  return best_match
end

## Find the best matching name from a vector of candidates using an explicit count.
## This variant uses the provided count instead of vec_size() to handle vectors
## where the valid entries are tracked separately (e.g., tc binding_names uses binding_count).
##
## Parameters:
##   name       - The misspelled/unknown name to match
##   candidates - Vector of candidate name strings (as Int pointers)
##   count      - Number of valid entries to consider (may be < vec_size)
##
## Returns: Best matching name string, or empty string if no good match
def find_best_match_with_count(name: String, candidates: Int, count: Int): String
  var name_len = str_byte_len(name)
  
  # Defensive: if candidates is nil or invalid, return empty
  return "" if candidates == 0
  
  # Threshold: allow 1 edit for short names, name_len/3 for longer
  var threshold = 1
  if name_len >= 3
    threshold = name_len / 3
  end
  
  var best_match = ""
  var best_distance = threshold + 1
  
  # Defensive: sanity check the count
  return "" if count < 0 or count > 100000
  
  for i in 0..count
    var ptr = candidates[i]
    # Skip nil pointers to avoid crash on garbage data
    continue if ptr == 0
    candidate = as_string(ptr)
    dist = edit_distance(name, candidate)
    
    if dist < best_distance
      best_distance = dist
      best_match = candidate
    end
  end
  
  return best_match
end

## Find best match for a variable name in the type environment.
##
## Parameters:
##   env  - Type environment
##   name - Unknown variable name
##
## Returns: Best matching variable name, or empty string
def typeenv_suggest_var(env: TypeEnv, name: String): String = find_best_match(name, typeenv_all_var_names(env))

## Find best match for a function name in the type environment.
##
## Parameters:
##   env  - Type environment
##   name - Unknown function name
##
## Returns: Best matching function name, or empty string
def typeenv_suggest_func(env: TypeEnv, name: String): String = find_best_match(name, typeenv_all_func_names(env))

## Find best match for a struct name in the type environment.
##
## Parameters:
##   env  - Type environment
##   name - Unknown struct name
##
## Returns: Best matching struct name, or empty string
def typeenv_suggest_struct(env: TypeEnv, name: String): String = find_best_match(name, typeenv_all_struct_names(env))

## Find best match for an enum name in the type environment.
##
## Parameters:
##   env  - Type environment
##   name - Unknown enum name
##
## Returns: Best matching enum name, or empty string
def typeenv_suggest_enum(env: TypeEnv, name: String): String = find_best_match(name, typeenv_all_enum_names(env))

# Count bindings (for debugging)
def typeenv_binding_count(env: TypeEnv): Int = typeenv_effective_binding_count(env)

# Test the type environment
def main(): Int
  puts("Testing typeenv...")
  
  env = typeenv_new()
  
  # Test scope depth
  if typeenv_depth(env) != 0
    puts("FAIL: initial depth should be 0")
    return 1
  end
  
  # Test push/pop scope
  typeenv_push_scope(env)
  if typeenv_depth(env) != 1
    puts("FAIL: depth should be 1 after push")
    return 1
  end
  
  # Test binding
  typeenv_bind(env, "x", 42, 0)  # x: type 42, immutable
  if typeenv_lookup(env, "x") != 42
    puts("FAIL: lookup x should return 42")
    return 1
  end
  
  if typeenv_is_mutable(env, "x") != 0
    puts("FAIL: x should be immutable")
    return 1
  end
  
  # Test mutable binding
  typeenv_bind(env, "y", 99, 1)  # y: type 99, mutable
  if typeenv_is_mutable(env, "y") != 1
    puts("FAIL: y should be mutable")
    return 1
  end
  
  # Test defined_in_scope
  if typeenv_defined_in_scope(env, "x") != 1
    puts("FAIL: x should be defined in scope")
    return 1
  end
  
  if typeenv_defined_in_scope(env, "z") != 0
    puts("FAIL: z should not be defined")
    return 1
  end
  
  # Test nested scope
  typeenv_push_scope(env)
  typeenv_bind(env, "inner", 100, 0)
  
  if typeenv_lookup(env, "inner") != 100
    puts("FAIL: lookup inner should return 100")
    return 1
  end
  
  # Can still see outer scope
  if typeenv_lookup(env, "x") != 42
    puts("FAIL: should still see x from outer scope")
    return 1
  end
  
  # Pop inner scope
  typeenv_pop_scope(env)
  
  # inner should be gone
  if typeenv_lookup(env, "inner") != 0
    puts("FAIL: inner should be gone after pop")
    return 1
  end
  
  # x should still be there
  if typeenv_lookup(env, "x") != 42
    puts("FAIL: x should still exist after pop")
    return 1
  end
  
  # Test struct registration
  typeenv_register_struct(env, "Point", 200)
  if typeenv_lookup_struct(env, "Point") != 200
    puts("FAIL: Point struct lookup failed")
    return 1
  end
  
  # Test function registration
  typeenv_register_func(env, "add", 300)
  if typeenv_lookup_func(env, "add") != 300
    puts("FAIL: add function lookup failed")
    return 1
  end
  
  # Test Damerau-Levenshtein edit distance
  # Identical strings
  if edit_distance("hello", "hello") != 0
    puts("FAIL: identical strings should have distance 0")
    return 1
  end
  
  # Single insertion
  if edit_distance("hello", "helo") != 1
    puts("FAIL: single deletion should have distance 1")
    return 1
  end
  
  # Single substitution
  if edit_distance("hello", "hallo") != 1
    puts("FAIL: single substitution should have distance 1")
    return 1
  end
  
  # Transposition (Damerau extension)
  if edit_distance("hello", "hlelo") != 1
    puts("FAIL: transposition should have distance 1")
    return 1
  end
  
  # Case insensitive
  if edit_distance("Hello", "hello") != 0
    puts("FAIL: case should be ignored")
    return 1
  end
  
  # Empty strings
  if edit_distance("", "abc") != 3
    puts("FAIL: empty to abc should be 3")
    return 1
  end
  if edit_distance("abc", "") != 3
    puts("FAIL: abc to empty should be 3")
    return 1
  end
  
  # Common typos
  if edit_distance("teh", "the") != 1
    puts("FAIL: teh->the transposition should be 1")
    return 1
  end
  
  # Test find_best_match
  candidates = vec_new<String>()
  candidates.push("name")
  candidates.push("value")
  candidates.push("count")
  
  # Should find "name" for "nme" (1 deletion)
  match1 = find_best_match("nme", candidates)
  if match1 != "name"
    puts("FAIL: nme should match name")
    return 1
  end
  
  # Should find "value" for "vlue" (1 deletion)
  match2 = find_best_match("vlue", candidates)
  if match2 != "value"
    puts("FAIL: vlue should match value")
    return 1
  end
  
  # Should find "count" for "cuont" (transposition)
  match3 = find_best_match("cuont", candidates)
  if match3 != "count"
    puts("FAIL: cuont should match count")
    return 1
  end
  
  # No good match for completely different word
  match4 = find_best_match("xyz", candidates)
  if match4 != ""
    puts("FAIL: xyz should have no match")
    return 1
  end
  
  candidates.free
  
  # Test typeenv suggestion functions
  env2 = typeenv_new()
  typeenv_bind(env2, "username", 1, 0)
  typeenv_bind(env2, "password", 2, 0)
  typeenv_register_func(env2, "validate", 100)
  typeenv_register_struct(env2, "User", 200)
  
  # Should suggest "username" for "usernme"
  suggestion = typeenv_suggest_var(env2, "usernme")
  if suggestion != "username"
    puts("FAIL: usernme should suggest username")
    return 1
  end
  
  # Should suggest "validate" for "vaildate" (transposition)
  suggestion2 = typeenv_suggest_func(env2, "vaildate")
  if suggestion2 != "validate"
    puts("FAIL: vaildate should suggest validate")
    return 1
  end
  
  puts("All typeenv tests passed!")
  return 0
end
