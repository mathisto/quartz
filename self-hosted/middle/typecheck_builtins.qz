  tc_register_builtin(tc, "vec_shrink_to_fit", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_capacity", type_constants::TYPE_INT)
  tc_register_builtin(tc, "vec_truncate", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_dedup", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_retain", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_extend", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_contains", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "vec_index_of", type_constants::TYPE_OPTION)  # v5.26: returns Option<Int>
  tc_register_builtin(tc, "vec_insert", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_delete", type_constants::TYPE_INT)
  tc_register_builtin(tc, "vec_join", type_constants::TYPE_STRING)
