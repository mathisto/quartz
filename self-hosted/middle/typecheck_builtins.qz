##! # Type Checker Builtins
##!
##! Builtin function registration for the Quartz type checker.

import typecheck_util
import typecheck_registry
import compiler_types
import type_constants
import * from str_compat

# ============================================================================
# Builtin Registry
# ============================================================================

## Register a builtin function.
## Uses Map<String,Int> for O(1) lookup instead of O(n) linear search.
##
## Parameters:
##   tc          - Type checker context
##   name        - Function name
##   return_type - Return type kind
def tc_register_builtin(tc: TypecheckState, name: String, return_type: Int): Void
  var builtins = tc.builtins
  builtins.set(name, return_type)
end

## Look up a builtin function's return type.
## Uses Map<String,Int> for O(1) lookup.
## Note: map_get returns 0 for not-found, so we must use map_has first.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: Return type kind, or type_constants$TYPE_ERROR if not a builtin
def tc_lookup_builtin(tc: TypecheckState, name: String): Int
  var builtins = tc.builtins
  return type_constants::TYPE_ERROR if not builtins.has(name)
  return __map_get_raw(builtins, name)
end

## Register a builtin function with explicit arity bounds.
## Use this for builtins with optional parameters.
##
## Parameters:
##   tc          - Type checker context
##   name        - Function name
##   return_type - Return type kind
##   min_arity   - Minimum number of arguments required
##   max_arity   - Maximum number of arguments accepted
def tc_register_builtin_with_arity(tc: TypecheckState, name: String, return_type: Int, min_arity: Int, max_arity: Int): Void
  tc_register_builtin(tc, name, return_type)
  tc.builtin_min_arity.set(name, min_arity)
  tc.builtin_max_arity.set(name, max_arity)
end

## Look up a builtin function's minimum arity.
## Returns -1 if not a builtin with explicit arity.
def tc_lookup_builtin_min_arity(tc: TypecheckState, name: String): Int
  return -1 if not tc.builtin_min_arity.has(name)
  return __map_get_raw(tc.builtin_min_arity, name)
end

## Look up a builtin function's maximum arity.
## Returns -1 if not a builtin with explicit arity.
def tc_lookup_builtin_max_arity(tc: TypecheckState, name: String): Int
  return -1 if not tc.builtin_max_arity.has(name)
  return __map_get_raw(tc.builtin_max_arity, name)
end

## Register a builtin function whose first-argument callback must declare
## a specific effect in its `can` row. PSQ-6 / Sched effect, 2026-04-30.
##
## Example:
##   tc_register_builtin_with_callback_effect(tc, "sched_idle_hook_set",
##                                            type_constants::TYPE_VOID, "Sched")
##
## At each call site, the typechecker looks up the passed callback's
## effect row and fires QZ1408 if `Sched` is absent. See design memo
## docs/design/SCHED_EFFECT_THREAD_SAFETY.md.
def tc_register_builtin_with_callback_effect(tc: TypecheckState, name: String, return_type: Int, callback_effect: String): Void
  tc_register_builtin(tc, name, return_type)
  tc.builtin_callback_effect.set(name, callback_effect)
end

## Look up a builtin function's required callback effect.
## Returns "" if no requirement is registered.
def tc_lookup_builtin_callback_effect(tc: TypecheckState, name: String): String
  return "" if not tc.builtin_callback_effect.has(name)
  return as_string(__map_get_raw(tc.builtin_callback_effect, name))
end

## Get the lowercase type alias name for a type.
## Used for type-prefixed UFCS: push(v, x) -> vec_push(v, x) when v: Vec
##
## Parameters:
##   tc        - Type checker context
##   type_kind - The type kind (e.g., type_constants$TYPE_VEC, type_constants$TYPE_STRING, etc.)
##
## Returns: The lowercase type alias (e.g., "vec", "string", "hashmap"), or "" if unknown
def tc_get_type_alias(tc: TypecheckState, type_kind: TypeId): String
  var kind = tc_base_kind(tc, type_kind)
  return "vec" if kind == type_constants::TYPE_VEC or kind == type_constants::TYPE_ARRAY
  return "str" if kind == type_constants::TYPE_STRING
  return "hashmap" if kind == type_constants::TYPE_MAP
  return "int" if kind == type_constants::TYPE_INT
  return "bool" if kind == type_constants::TYPE_BOOL
  return "regex" if kind == type_constants::TYPE_REGEX
  return "ptr" if kind == type_constants::TYPE_PTR
  return "range" if kind == type_constants::TYPE_RANGE
  return "arena" if kind == type_constants::TYPE_ARENA
  return "pool" if kind == type_constants::TYPE_POOL
  return "arena_pool" if kind == type_constants::TYPE_ARENAPOOL
  return ""
end

## Check if a name is a builtin function.
##
## Parameters:
##   tc   - Type checker context
##   name - Function name
##
## Returns: 1 if builtin, 0 otherwise
def tc_is_builtin(tc: TypecheckState, name: String): Int
  var result = tc_lookup_builtin(tc, name)
  return 0 if result == type_constants::TYPE_ERROR
  return 1
end

## Initialize all builtin functions.
## Registers 60+ functions matching bootstrap/src/typecheck.c.
##
## Parameters:
##   tc - Type checker context
def tc_init_builtins(tc: TypecheckState): Void
  # Output functions - puts/eputs accept optional Bool for newline control
  tc_register_builtin_with_arity(tc, "puts", type_constants::TYPE_VOID, 1, 2)
  tc_register_builtin_with_arity(tc, "eputs", type_constants::TYPE_VOID, 1, 2)
  tc_register_builtin(tc, "print", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "eprint", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "print_int", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "eprint_int", type_constants::TYPE_VOID)
  
  # String functions
  tc_register_builtin(tc, "str_size", type_constants::TYPE_INT)
  # str_codepoint_at(s, byte_idx): decode codepoint at byte offset. O(1).
  tc_register_builtin(tc, "str_codepoint_at", type_constants::TYPE_INT)
  # str_codepoint_byte_len(s, byte_idx): UTF-8 stride (1/2/3/4). O(1).
  tc_register_builtin(tc, "str_codepoint_byte_len", type_constants::TYPE_INT)
  # str_codepoint_nth(s, cp_idx): n-th codepoint. O(n) walk. Used by `s[i]`.
  tc_register_builtin(tc, "str_codepoint_nth", type_constants::TYPE_INT)
  # str_char_at: transitional alias for str_codepoint_nth. Existing
  # consumers in std/string + frontend/str_test will migrate in a
  # follow-up commit; the alias keeps the bootstrap chain happy
  # (gen1 needs to compile sources that the OLD binary already
  # accepts via this name). Remove after migration sweep.
  tc_register_builtin(tc, "str_char_at", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_from_codepoint", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_concat", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_slice", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_find", type_constants::TYPE_OPTION)  # v5.26: returns Option<Int>
  tc_register_builtin(tc, "str_contains", type_constants::TYPE_BOOL)  # v5.7: returns Bool (1 if found, 0 if not)
  tc_register_builtin(tc, "str_split", type_constants::TYPE_INT)  # Returns array handle
  tc_register_builtin(tc, "str_from_int", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_from_char", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_eq", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "str_cmp", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_hash", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_to_int", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_to_f64", type_constants::TYPE_F64)
  tc_register_builtin(tc, "bool_to_str", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_starts_with", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "str_ends_with", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "str_downcase", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_upcase", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_trim", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_replace", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_reverse", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_repeat", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_count", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_join", type_constants::TYPE_STRING)  # (Vec, String) -> String
  tc_register_builtin(tc, "str_is_empty", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "str_substr", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_trim_left", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_trim_right", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_pad_left", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_pad_right", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_chars", type_constants::TYPE_INT)

  # Byte-level string intrinsics (FIX.2 Unicode Awareness)
  tc_register_builtin(tc, "str_byte_len", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_byte_size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_byte_at", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_byte_slice", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_bytes", type_constants::TYPE_INT)
  tc_register_builtin(tc, "str_from_bytes", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "str_byte_find", type_constants::TYPE_OPTION)
  tc_register_builtin(tc, "str_is_valid_utf8", type_constants::TYPE_BOOL)

  # String UFCS method aliases (Type$method -> intrinsic)
  tc_register_builtin(tc, "String$cmp", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$find", type_constants::TYPE_OPTION)  # v5.26: returns Option<Int>
  tc_register_builtin(tc, "String$char_at", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$eq", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "String$concat", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$slice", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$split", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$starts_with", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "String$ends_with", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "String$contains", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "String$downcase", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$upcase", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$trim", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$replace", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$to_f", type_constants::TYPE_F64)
  tc_register_builtin(tc, "String$hash", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$reverse", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$repeat", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$count", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$join", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$is_empty", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "String$substr", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$trim_left", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$trim_right", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$pad_left", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$pad_right", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$chars", type_constants::TYPE_INT)

  # String byte-level UFCS methods
  tc_register_builtin(tc, "String$byte_at", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$byte_slice", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "String$byte_len", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$byte_size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "String$byte_find", type_constants::TYPE_OPTION)
  tc_register_builtin(tc, "String$bytes", type_constants::TYPE_INT)

  # Control flow
  tc_register_builtin(tc, "exit", type_constants::TYPE_NEVER)
  tc_register_builtin(tc, "assert", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "panic", type_constants::TYPE_NEVER)
  tc_register_builtin(tc, "unreachable", type_constants::TYPE_NEVER)
  tc_register_builtin(tc, "expect", type_constants::TYPE_INT)
  
  # Array functions (return handles as Int)
  tc_register_builtin(tc, "arr_size", type_constants::TYPE_INT)
  
  # Character classification
  tc_register_builtin(tc, "is_digit", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "is_alpha", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "is_alnum", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "is_whitespace", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "is_upper", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "is_lower", type_constants::TYPE_BOOL)

  # Random number generation (Phase 1d)
  tc_register_builtin(tc, "rand_seed", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "rand_int", type_constants::TYPE_INT)
  tc_register_builtin(tc, "rand_range", type_constants::TYPE_INT)
  tc_register_builtin(tc, "rand_float", type_constants::TYPE_F64)
  tc_register_builtin(tc, "crypto_rand_int", type_constants::TYPE_INT)

  # Memory (low-level)
  tc_register_builtin(tc, "mem_forget", type_constants::TYPE_VOID)  # Fn(Int) -> Void (suppress drop)
  tc_register_builtin(tc, "mem_alloc", type_constants::TYPE_INT)
  tc_register_builtin(tc, "load", type_constants::TYPE_INT)
  tc_register_builtin(tc, "store", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "ptr_add", type_constants::TYPE_INT)  # ptr + bytes -> ptr
  tc_register_builtin(tc, "ptr_is_null", type_constants::TYPE_BOOL)  # CPtr -> Bool (1 if null)
  tc_register_builtin(tc, "addr_of", type_constants::TYPE_INT)  # &var -> CPtr
  tc_register_builtin(tc, "ptr_cast", type_constants::TYPE_INT) # CPtr<A> -> CPtr<B>
  ## addressof() removed — use addr_of()

  # Async I/O suspension
  tc_register_builtin(tc, "io_suspend", type_constants::TYPE_INT)  # (fd: Int) -> Int
  tc_register_builtin(tc, "io_suspend_timeout", type_constants::TYPE_INT)  # (fd: Int, timeout_ms: Int, events: Int) -> Int
  tc_register_builtin(tc, "proc_suspend", type_constants::TYPE_INT) # (pid: Int) -> Int — suspend until child exits (pidfd/EVFILT_PROC)
  tc_register_builtin(tc, "future_poll", type_constants::TYPE_INT)  # (frame: Int) -> Int

  # Internal TLS helpers for io_suspend_timeout (used by MIR lowering)
  tc_register_builtin(tc, "io_set_pending_timeout", type_constants::TYPE_VOID)  # (timeout_ms: Int) -> Void
  tc_register_builtin(tc, "io_set_pending_events", type_constants::TYPE_VOID)   # (events: Int) -> Void
  tc_register_builtin(tc, "io_set_pending_sleep", type_constants::TYPE_VOID)    # (timeout_ms: Int) -> Void
  tc_register_builtin(tc, "io_set_pending_proc", type_constants::TYPE_VOID)     # (val: Int) -> Void — set proc-flag TLS

  # M:N Scheduler
  tc_register_builtin(tc, "sched_init", type_constants::TYPE_VOID)       # (num_workers: Int) -> Void
  # PSQ-6 / Sched effect (2026-04-30): callback runs on the I/O poller
  # pthread, so its body must be Sync-safe. The `Sched` requirement is
  # checked at the call site (QZ1408 in typecheck_expr_handlers.qz);
  # the body-walk Sync check fires in Phase C.
  tc_register_builtin_with_callback_effect(tc, "sched_idle_hook_set", type_constants::TYPE_VOID, "Sched")  # (fn: Fn(): Void can Sched) -> Void
  tc_register_builtin(tc, "sched_idle_hook_clear", type_constants::TYPE_VOID) # () -> Void
  tc_register_builtin(tc, "sched_spawn", type_constants::TYPE_VOID)      # (task_frame: Int) -> Void
  tc_register_builtin(tc, "sched_spawn_priority", type_constants::TYPE_VOID) # (task_frame: Int, level: Int) -> Void
  tc_register_builtin(tc, "sched_shutdown", type_constants::TYPE_VOID)   # () -> Void
  tc_register_builtin(tc, "sched_shutdown_graceful", type_constants::TYPE_INT) # (timeout_ms: Int) -> Int (0=clean, 1=timeout)
  tc_register_builtin(tc, "sched_shutdown_on_signal", type_constants::TYPE_VOID) # () -> Void (install SIGTERM/SIGINT handlers)
  tc_register_builtin(tc, "sched_shutdown_requested", type_constants::TYPE_INT) # () -> Bool (1 if signal received)
  tc_register_builtin(tc, "sched_yield", type_constants::TYPE_VOID)      # () -> Void
  tc_register_builtin(tc, "sched_sleep", type_constants::TYPE_VOID)      # (timeout_ms: Int) -> Void
  tc_register_builtin(tc, "sched_register_io", type_constants::TYPE_VOID) # (fd: Int, task: Int) -> Void
  tc_register_builtin(tc, "sched_register_proc", type_constants::TYPE_VOID) # (pid: Int, task: Int) -> Void — pidfd/EVFILT_PROC child exit
  tc_register_builtin(tc, "sched_set_max_tasks", type_constants::TYPE_VOID) # (n: Int) -> Void
  tc_register_builtin(tc, "sched_task_count", type_constants::TYPE_INT)    # () -> Int
  tc_register_builtin(tc, "sched_queue_depth", type_constants::TYPE_INT)  # () -> Int
  tc_register_builtin(tc, "sched_worker_count", type_constants::TYPE_INT) # () -> Int
  tc_register_builtin(tc, "sched_active_tasks", type_constants::TYPE_INT) # () -> Int — current active task count (atomic)
  tc_register_builtin(tc, "sched_tasks_completed", type_constants::TYPE_INT) # () -> Int — monotonic completed counter (atomic)
  tc_register_builtin(tc, "sched_worker_busy_ns", type_constants::TYPE_INT) # (wid: Int) -> Int — cumulative busy nanoseconds
  tc_register_builtin(tc, "sched_enable_tracing", type_constants::TYPE_VOID) # (enabled: Int) -> Void
  tc_register_builtin(tc, "sched_read_traces", type_constants::TYPE_INT)     # (max: Int) -> Vec<Int>
  tc_register_builtin(tc, "sched_park", type_constants::TYPE_VOID)           # () -> Void — park current task
  tc_register_builtin(tc, "sched_wake", type_constants::TYPE_VOID)           # (task_frame: Int) -> Void — wake parked task
  tc_register_builtin(tc, "sched_set_park_pending", type_constants::TYPE_VOID) # () -> Void — internal: set TLS park flag
  # 4D.5c.1: park-encoding consumer-side bridge. Lowered specially in
  # mir_lower_expr_handlers: inside async ($poll body, _gen_active >= 2),
  # emits a state-machine suspend point that returns the rv arg directly
  # (so a park encoding flows up through the outer $poll). Outside, calls
  # sched_yield. Used by Stream.next() to propagate park-rv from its
  # inner $poll without losing fd-park wakeup semantics.
  tc_register_builtin(tc, "__qz_async_park_propagate", type_constants::TYPE_VOID) # (rv: Int) -> Void
  tc_register_builtin(tc, "task_frame", type_constants::TYPE_INT)            # () -> Int — current task frame pointer
  tc_register_builtin(tc, "fuel_check", type_constants::TYPE_VOID)          # () -> Void — preemptive reduction check

  # Async Mutex (scheduler-aware, non-blocking)
  tc_register_builtin(tc, "async_mutex_new", type_constants::TYPE_INT)       # (initial_value: Int) -> Int
  tc_register_builtin(tc, "async_mutex_lock", type_constants::TYPE_INT)      # (mtx: Int) -> Int (returns value)
  tc_register_builtin(tc, "async_mutex_unlock", type_constants::TYPE_VOID)   # (mtx: Int, new_value: Int) -> Void
  tc_register_builtin(tc, "async_mutex_try_lock", type_constants::TYPE_INT)  # (mtx: Int) -> Int (0=fail, 1=success)
  tc_register_builtin(tc, "async_mutex_get", type_constants::TYPE_INT)       # (mtx: Int) -> Int (read value)
  tc_register_builtin(tc, "async_mutex_set", type_constants::TYPE_VOID)      # (mtx: Int, value: Int) -> Void
  tc_register_builtin(tc, "async_mutex_free", type_constants::TYPE_VOID)     # (mtx: Int) -> Void

  # Async RwLock (scheduler-aware, non-blocking reader/writer lock)
  tc_register_builtin(tc, "async_rwlock_new", type_constants::TYPE_INT)          # (initial_value: Int) -> Int
  tc_register_builtin(tc, "async_rwlock_read", type_constants::TYPE_INT)         # (rw: Int) -> Int (returns value)
  tc_register_builtin(tc, "async_rwlock_read_unlock", type_constants::TYPE_VOID) # (rw: Int) -> Void
  tc_register_builtin(tc, "async_rwlock_write", type_constants::TYPE_INT)        # (rw: Int) -> Int (returns value)
  tc_register_builtin(tc, "async_rwlock_write_unlock", type_constants::TYPE_VOID) # (rw: Int, new_value: Int) -> Void
  tc_register_builtin(tc, "async_rwlock_get", type_constants::TYPE_INT)          # (rw: Int) -> Int
  tc_register_builtin(tc, "async_rwlock_free", type_constants::TYPE_VOID)        # (rw: Int) -> Void

  # Monotonic clock
  tc_register_builtin(tc, "time_mono_ns", type_constants::TYPE_INT)  # () -> Int (nanoseconds)

  # Memory profiling
  tc_register_builtin(tc, "mem_peak_rss", type_constants::TYPE_INT)  # () -> Int (bytes, peak RSS)
  tc_register_builtin(tc, "mem_current_rss", type_constants::TYPE_INT)  # () -> Int (bytes, current RSS)
  tc_register_builtin(tc, "mem_release", type_constants::TYPE_INT)  # () -> Int (bytes released to OS)

  tc_register_builtin(tc, "band", type_constants::TYPE_INT)  # bitwise AND
  tc_register_builtin(tc, "shr", type_constants::TYPE_INT)   # shift right
  tc_register_builtin(tc, "shl", type_constants::TYPE_INT)   # shift left

  # String <-> Pointer conversion
  tc_register_builtin(tc, "str_from_ptr", type_constants::TYPE_STRING)  # (CPtr, Int) -> String
  tc_register_builtin(tc, "str_to_ptr", type_constants::TYPE_INT)  # String -> CPtr

  # FFI / C interop
  tc_register_builtin(tc, "string_to_cstr", type_constants::TYPE_INT)  # String -> CPtr
  tc_register_builtin(tc, "cstr_to_string", type_constants::TYPE_STRING)  # CPtr -> String
  tc_register_builtin(tc, "cptr_to_string_with_len", type_constants::TYPE_STRING)  # (CPtr, Int) -> String
  tc_register_builtin(tc, "cptr_to_int", type_constants::TYPE_INT)  # CPtr -> Int
  tc_register_builtin(tc, "int_to_cptr", type_constants::TYPE_INT)  # Int -> CPtr
  tc_register_builtin(tc, "ptr_read_byte", type_constants::TYPE_INT)  # CPtr -> Int
  tc_register_builtin(tc, "ptr_write_byte", type_constants::TYPE_VOID)  # (CPtr, Int) -> Void
  tc_register_builtin(tc, "qz_malloc", type_constants::TYPE_INT)  # Int -> CPtr
  tc_register_builtin(tc, "qz_free", type_constants::TYPE_VOID)  # CPtr -> Void
  tc_register_builtin_with_arity(tc, "ptr_alloc", type_constants::TYPE_INT, 1, 1)  # Int -> Ptr
  tc_register_builtin_with_arity(tc, "ptr_read", type_constants::TYPE_INT, 1, 1)  # Ptr -> Int
  tc_register_builtin_with_arity(tc, "ptr_write", type_constants::TYPE_VOID, 2, 2)  # (Ptr, Int) -> Void
  tc_register_builtin_with_arity(tc, "volatile_load", type_constants::TYPE_INT, 2, 2)  # (Ptr, Int) -> Int
  tc_register_builtin_with_arity(tc, "volatile_store", type_constants::TYPE_VOID, 3, 3)  # (Ptr, Int, Int) -> Void
  # K8.4 atomic primitives. Backing: x86 LOCK CMPXCHG / aligned MOV.
  # All three operate on 8-byte aligned U64 slots — the Spinlock /
  # ready-queue use cases. seq_cst ordering at the LLVM IR level for
  # K8.MVP simplicity (refines later when contention profiles motivate
  # weaker orderings).
  tc_register_builtin_with_arity(tc, "atomic_load_u64", type_constants::TYPE_INT, 1, 1)  # (Ptr) -> Int
  tc_register_builtin_with_arity(tc, "atomic_store_u64", type_constants::TYPE_VOID, 2, 2)  # (Ptr, Int) -> Void
  tc_register_builtin_with_arity(tc, "atomic_cas_u64", type_constants::TYPE_BOOL, 3, 3)  # (Ptr, Int, Int) -> Bool
  # C1 (value-types-finish §14.12.8) — COW refcount atomics. Operate on the
  # refcount word at offset 0 of a COW buffer (the buffer handle is an i64).
  # cow_rc_inc: atomicrmw add 1 seq_cst (return ignored). cow_rc_dec: atomicrmw
  # sub 1 seq_cst, returns the PRIOR refcount (caller tests ==1 ⇒ free). INERT
  # until C2 (nothing calls them yet); see docs/sagas/.../cow-abi.md §5 C1.
  tc_register_builtin_with_arity(tc, "cow_rc_inc", type_constants::TYPE_VOID, 1, 1)  # (buf: Int) -> Void
  tc_register_builtin_with_arity(tc, "cow_rc_dec", type_constants::TYPE_INT, 1, 1)   # (buf: Int) -> Int (prior refcount)
  tc_register_builtin(tc, "field_offset", type_constants::TYPE_INT)  # String -> Int
  
  # File I/O
  tc_register_builtin(tc, "read_file", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "write_file", type_constants::TYPE_INT)
  tc_register_builtin(tc, "file_exists", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "open_file", type_constants::TYPE_INT)
  tc_register_builtin(tc, "close_file", type_constants::TYPE_INT)
  tc_register_builtin(tc, "fwrite", type_constants::TYPE_INT)
  tc_register_builtin(tc, "fread", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "read_line", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "readline", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "read_stdin", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "file_read_line", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "file_write_line", type_constants::TYPE_INT)
  tc_register_builtin(tc, "pipe_open", type_constants::TYPE_INT)
  tc_register_builtin(tc, "pipe_close", type_constants::TYPE_INT)

  # Output capture (stdout redirection for testing)
  tc_register_builtin(tc, "capture_output_start", type_constants::TYPE_INT)
  tc_register_builtin(tc, "capture_output_end", type_constants::TYPE_STRING)

  # Stderr redirection to a file (used by `quartz --persistent-worker` to
  # capture per-request compile diagnostics into a runner-named path).
  tc_register_builtin(tc, "qz_redirect_stderr_to_file", type_constants::TYPE_INT)
  tc_register_builtin(tc, "qz_restore_stderr", type_constants::TYPE_INT)

  # Binary Vec I/O (fast binary serialization for Vec<Int> and Vec<String>)
  tc_register_builtin(tc, "vec_save", type_constants::TYPE_INT)       # Fn(Vec<Int>, String) -> Int
  tc_register_builtin(tc, "vec_load", type_constants::TYPE_VEC)       # Fn(String) -> Vec<Int>
  tc_register_builtin(tc, "strvec_save", type_constants::TYPE_INT)    # Fn(Vec<String>, String) -> Int
  tc_register_builtin(tc, "strvec_load", type_constants::TYPE_VEC)    # Fn(String) -> Vec<String>

  # Environment
  tc_register_builtin(tc, "getenv", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "argc", type_constants::TYPE_INT)
  tc_register_builtin(tc, "argv", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "system", type_constants::TYPE_INT)
  # posix_spawn_wait(cmd: String): Int — like system() but uses posix_spawnp
  # instead of fork+exec, bypassing libc system()'s process-wide mutex (which
  # serializes all system() calls on macOS + glibc). Returns the same raw
  # wait-status format as system() so existing exit_code/sig decoders work
  # unchanged. Designed for the parallel qspec runner where worker goroutines
  # must spawn child processes concurrently.
  tc_register_builtin(tc, "posix_spawn_wait", type_constants::TYPE_INT)


  # Vector (dynamic array) functions
  tc_register_builtin(tc, "vec_new", type_constants::TYPE_VEC)
  tc_register_builtin(tc, "vec_new_filled", type_constants::TYPE_VEC)
  tc_register_builtin(tc, "vec_push", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_pop", type_constants::TYPE_OPTION)  # v5.26: returns Option<T>
  tc_register_builtin(tc, "__vec_pop_raw_sentinel", type_constants::TYPE_INT)  # internal: raw niche word (Some=ptr, None=0)
  tc_register_builtin(tc, "vec_get", type_constants::TYPE_INT)
  tc_register_builtin(tc, "vec_set", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_get_unchecked", type_constants::TYPE_INT)
  tc_register_builtin(tc, "vec_set_unchecked", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "vec_size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "vec_free", type_constants::TYPE_VOID)
