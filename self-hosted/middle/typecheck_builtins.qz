  # Slice builtins (Tier 4 #24 Phase 2)
  # slice(v, a, b) returns Slice<T>; element type is recovered from v at
  # the call site (see typecheck_expr_handlers.qz slice() return path).
  tc_register_builtin(tc, "slice", type_constants::TYPE_SLICE)
  tc_register_builtin(tc, "slice_get", type_constants::TYPE_INT)
  tc_register_builtin(tc, "slice_size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "slice_set", type_constants::TYPE_VOID)
  # subslice(s, a, b) — sub-slicing of an existing Slice<T>. Reads source
  # slice's 24-byte header layout (vs. slice() which reads Vec layout).
  # MIR dispatches between slice/subslice based on base node's inferred type.
  tc_register_builtin(tc, "subslice", type_constants::TYPE_SLICE)

  # Byte-slice bridge (Tier 4 #24 Phase 4b §2.2)
  # str_as_byte_slice(s) returns Slice<Byte>; byte_slice_get uses 1-byte
  # stride + zext. Return type is retyped to ptype Slice<Byte> at the call
  # site (see typecheck_expr_handlers.qz).
  tc_register_builtin(tc, "str_as_byte_slice", type_constants::TYPE_SLICE)
  tc_register_builtin(tc, "byte_slice_get", type_constants::TYPE_INT)

  # Slice::EMPTY / SliceMut::EMPTY compile-time constant (Tier 4 #24 Phase 4b §2.3)
  # Returns a 16-byte zero-initialized slice header {0, 0}. Zero-alloc.
  tc_register_builtin(tc, "slice_empty", type_constants::TYPE_SLICE)

