  tc_register_builtin(tc, "arena_pool_capacity", type_constants::TYPE_INT)

  # Phase E.7 — implicit per-worker arena pool primitives.
  # `__qz_arena_pool_take`: pop top (LIFO) of TLS pool, return handle or 0.
  # `__qz_arena_pool_give`: push to TLS pool, return 1 if accepted or 0 if cap reached.
  # Wrapped by stdlib helpers `arena_acquire` / `arena_release` (added in a
  # follow-up commit, after the binary at HEAD knows about these registrations).
  tc_register_builtin(tc, "__qz_arena_pool_take", type_constants::TYPE_INT)
  tc_register_builtin(tc, "__qz_arena_pool_give", type_constants::TYPE_INT)
  
  # Type coercion (for existential types)
  # as_string works on both Int->String and String->String (no-op)
  tc_register_builtin(tc, "as_string", type_constants::TYPE_STRING)
  tc_register_builtin(tc, "as_int", type_constants::TYPE_INT)
  # as_f64: bit-faithful Int->F64 reinterpret (NOT a numeric conversion —
  # the inverse of `as_int` on a float). An F64 value is internally its
  # i64 bit pattern, so this is an identity at the IR level. Use it to
  # reassemble a double from raw IEEE-754 bits; `to_f64` is sitofp and
  # would produce a different value.
  tc_register_builtin(tc, "as_f64", type_constants::TYPE_F64)
  # as_vec: identity coercion to recover a Vec<T> from a raw Int handle.
  # Used by arena_promote_vec_ref's elem_kind=3 path to call
  # arena_promote_vec_value on a per-element nested-Vec slot value.
  tc_register_builtin(tc, "as_vec", type_constants::TYPE_VEC)
  # Generic type erasure/recovery (identity at runtime - all types are i64)
  tc_register_builtin(tc, "as_int_generic", type_constants::TYPE_INT)
  tc_register_builtin(tc, "as_type", type_constants::TYPE_INT)
  
  # Function pointer casting (for storing/calling lambdas in collections)
  tc_register_builtin(tc, "fn_to_int", type_constants::TYPE_INT)
  tc_register_builtin(tc, "call_fn", type_constants::TYPE_INT)
  
  # Parallel iteration intrinsics
  tc_register_builtin(tc, "parallel_reduce", type_constants::TYPE_INT)  # Returns accumulated value
  
  # ============================================================================
  # Enumerable Intrinsics
  # ============================================================================
  
  # Higher-order functions on arrays
  tc_register_builtin(tc, "each", type_constants::TYPE_VOID)  # Fn(Array, Fn(T)->Void) -> Void
  tc_register_builtin(tc, "map", type_constants::TYPE_VEC)    # Fn(Array, Fn(T)->U) -> Vec
  tc_register_builtin(tc, "filter", type_constants::TYPE_VEC) # Fn(Array, Fn(T)->Bool) -> Vec
  tc_register_builtin(tc, "reduce", type_constants::TYPE_INT) # Fn(Array, Init, Fn(Acc,T)->Acc) -> Acc
  
  # Quantifier predicates
  tc_register_builtin(tc, "any?", type_constants::TYPE_BOOL)  # Fn(Array, Fn(T)->Bool) -> Bool
  tc_register_builtin(tc, "all?", type_constants::TYPE_BOOL)  # Fn(Array, Fn(T)->Bool) -> Bool
  
  # Search and access
  tc_register_builtin(tc, "find", type_constants::TYPE_INT)   # Fn(Array, Fn(T)->Bool) -> T (0 if not found)
  tc_register_builtin(tc, "first", type_constants::TYPE_INT)  # Fn(Array) -> T
  tc_register_builtin(tc, "last", type_constants::TYPE_INT)   # Fn(Array) -> T
  
  # Slice operations
  tc_register_builtin(tc, "take", type_constants::TYPE_VEC)   # Fn(Array, N) -> Vec
  tc_register_builtin(tc, "drop", type_constants::TYPE_VEC)   # Fn(Array, N) -> Vec
  
  # Aggregation
  tc_register_builtin(tc, "count", type_constants::TYPE_INT)   # Fn(Array, Fn(T)->Bool) -> Int
  tc_register_builtin(tc, "sum", type_constants::TYPE_INT)     # Fn(Array) -> Int
  tc_register_builtin(tc, "product", type_constants::TYPE_INT) # Fn(Array) -> Int
  tc_register_builtin(tc, "min", type_constants::TYPE_INT)     # Fn(Array) -> Int
  tc_register_builtin(tc, "max", type_constants::TYPE_INT)     # Fn(Array) -> Int
  
  # Atomics (for thread-safe enumerable operations)
  # Optional last Int arg for memory ordering: 0=relaxed, 2=acquire, 3=release, 4=acq_rel, 5=seq_cst (default)
  tc_register_builtin(tc, "atomic_new", type_constants::TYPE_ATOMIC)   # Fn(Int) -> AtomicInt
  tc_register_builtin(tc, "atomic_load", type_constants::TYPE_INT)  # Fn(AtomicInt, ordering?: Int) -> Int
  tc_register_builtin(tc, "atomic_store", type_constants::TYPE_VOID) # Fn(AtomicInt, Int, ordering?: Int) -> Void
  tc_register_builtin(tc, "atomic_add", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old)
  tc_register_builtin(tc, "atomic_sub", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old)
  tc_register_builtin(tc, "atomic_exchange", type_constants::TYPE_INT) # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old, sets new)
  tc_register_builtin(tc, "atomic_and", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old)
  tc_register_builtin(tc, "atomic_or", type_constants::TYPE_INT)    # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old)
  tc_register_builtin(tc, "atomic_xor", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (returns old)
  tc_register_builtin(tc, "atomic_min", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (signed min, returns old)
  tc_register_builtin(tc, "atomic_max", type_constants::TYPE_INT)   # Fn(AtomicInt, Int, ordering?: Int) -> Int (signed max, returns old)
  tc_register_builtin(tc, "atomic_cas", type_constants::TYPE_BOOL)  # Fn(AtomicInt, Expected, New, ordering?: Int) -> Bool
  tc_register_builtin(tc, "fence", type_constants::TYPE_VOID)       # Fn(ordering: Int) -> Void
  tc_register_builtin(tc, "compiler_fence", type_constants::TYPE_VOID) # Fn(ordering: Int) -> Void
  tc_register_builtin(tc, "signal_on_flag", type_constants::TYPE_VOID) # Fn(Int, AtomicInt) -> Void — registers signal handler that sets flag

  # SYS.1 item 7 — x86 segment-based TLS. LLVM emits segment-prefixed
  # loads/stores for pointers in addrspace(256) = gs and addrspace(257) = fs.
  # Kernels use gs for per-CPU variables; userspace TLS uses fs.
  tc_register_builtin(tc, "tls_read_gs", type_constants::TYPE_INT)  # Fn(offset: Int) -> Int (reads i64 from %gs:offset)
  tc_register_builtin(tc, "tls_read_fs", type_constants::TYPE_INT)  # Fn(offset: Int) -> Int (reads i64 from %fs:offset)
  tc_register_builtin(tc, "tls_write_gs", type_constants::TYPE_VOID) # Fn(offset: Int, val: Int) -> Void (writes i64 to %gs:offset)
  tc_register_builtin(tc, "tls_write_fs", type_constants::TYPE_VOID) # Fn(offset: Int, val: Int) -> Void (writes i64 to %fs:offset)
  # arm64 tpidr registers — el1 kernel per-CPU base, el0 userspace TLS base.
  tc_register_builtin(tc, "tls_read_tpidr_el1", type_constants::TYPE_INT)   # Fn() -> Int (mrs x, tpidr_el1)
  tc_register_builtin(tc, "tls_read_tpidr_el0", type_constants::TYPE_INT)   # Fn() -> Int (mrs x, tpidr_el0)
  tc_register_builtin(tc, "tls_write_tpidr_el1", type_constants::TYPE_VOID) # Fn(val: Int) -> Void (msr tpidr_el1, x)
  tc_register_builtin(tc, "tls_write_tpidr_el0", type_constants::TYPE_VOID) # Fn(val: Int) -> Void (msr tpidr_el0, x)

  # x86 port-I/O intrinsics — legacy I/O-port-space access via `outb`/`inb`/etc.
  # Kernels need these for devices that sit in the I/O port address space
  # rather than MMIO: legacy serial (COM1=0x3F8), PIC (0x20/0xA0), PIT (0x40),
  # CMOS/RTC (0x70/0x71), keyboard (0x60/0x64). Compiler-emitted inline asm
  # marked `sideeffect` so LLVM doesn't CSE / DCE.
  tc_register_builtin(tc, "port_out8", type_constants::TYPE_VOID)   # Fn(port: Int, val: Int) -> Void (outb)
  tc_register_builtin(tc, "port_out16", type_constants::TYPE_VOID)  # Fn(port: Int, val: Int) -> Void (outw)
  tc_register_builtin(tc, "port_out32", type_constants::TYPE_VOID)  # Fn(port: Int, val: Int) -> Void (outl)
  tc_register_builtin(tc, "port_in8", type_constants::TYPE_INT)     # Fn(port: Int) -> Int (inb, zext to i64)
  tc_register_builtin(tc, "port_in16", type_constants::TYPE_INT)    # Fn(port: Int) -> Int (inw, zext to i64)
  tc_register_builtin(tc, "port_in32", type_constants::TYPE_INT)    # Fn(port: Int) -> Int (inl, zext to i64)

  # x86 Model-Specific Register (MSR) access — 64-bit kernel-privileged
  # registers indexed by ECX. Needed for IA32_APIC_BASE (0x1B),
  # IA32_EFER (0xC0000080), IA32_GS_BASE (0xC0000101), IA32_KERNEL_GS_BASE
  # (0xC0000102), SYSCALL (STAR/LSTAR/FMASK), perf counters, etc.
  # wrmsr/rdmsr hard-require ECX/EDX:EAX register allocation, so they
  # can't be expressed via the generic `@c` ABI's =r/r constraints.
  tc_register_builtin(tc, "wrmsr", type_constants::TYPE_VOID)       # Fn(msr: Int, val: Int) -> Void
  tc_register_builtin(tc, "rdmsr", type_constants::TYPE_INT)        # Fn(msr: Int) -> Int

  # Memory management
  tc_register_builtin(tc, "mem_free", type_constants::TYPE_VOID)

  # Channel operations
  tc_register_builtin_with_arity(tc, "channel_new", type_constants::TYPE_CHANNEL, 1, 1)              # (cap: Int) -> Channel
  tc_register_builtin_with_arity(tc, "channel_new_unbounded", type_constants::TYPE_CHANNEL, 0, 0)    # () -> Channel
  tc_register_builtin(tc, "channel_close", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "channel_closed", type_constants::TYPE_BOOL)
  # C.14.4 — actor exit clean-marker sidecar. mark_clean writes to the
  # sidecar before channel_close in the auto-generated stop / cascade-stop
  # paths; check_clean is the supervisor watcher's read-and-consume that
  # distinguishes clean self-stop from crash for Transient restart semantics.
  tc_register_builtin(tc, "actor_mark_clean", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "actor_check_clean", type_constants::TYPE_INT)
  # C.14.7 — running-actor inbox accessor. Reads TLS
  # `@__qz_current_actor_inbox` written by the auto-generated poll loop on
  # entry. `std/actor.qz::actor_die(reason)` calls `channel_close(actor_self_inbox())`
  # WITHOUT calling actor_mark_clean first, so the supervisor sees EXIT_CRASH
  # (the only Quartz code path that produces it). `__actor_set_self_inbox`
  # is compiler-internal — emitted by MIR, not part of the user surface.
  tc_register_builtin(tc, "actor_self_inbox", type_constants::TYPE_INT)
  tc_register_builtin(tc, "__actor_set_self_inbox", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "channel_size", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_capacity", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_is_full", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "channel_is_empty", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "go_priority", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_pressure", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_remaining", type_constants::TYPE_INT)
  tc_register_builtin(tc, "try_send_pressure", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_set_high_water", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "channel_get_high_water", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_notify_fd", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_notify_write_fd", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_send_notify_fd", type_constants::TYPE_INT)
  tc_register_builtin(tc, "channel_park_recv", type_constants::TYPE_INT)  # Fn(ch, frame) -> Int: 0=parked, 1=retry
  # Channel `send`/`recv` collide with libc `send(s, buf, len, flags)` /
  # `recv(s, buf, len, flags)` on Windows (ws2_32). Register explicit arity
  # bounds so the typechecker's arity-aware call dispatch (Path A,
  # 2026-05-23) can route 2-arg `send(ch, val)` to the channel intrinsic
  # while leaving 4-arg `send(sock, buf, len, flags)` to fall through to
  # the user extern. See feedback_channel_send_vs_ws2_send_name_clash.md.
  tc_register_builtin_with_arity(tc, "send", type_constants::TYPE_VOID, 2, 2)
  tc_register_builtin_with_arity(tc, "recv", type_constants::TYPE_INT, 1, 1)
  tc_register_builtin(tc, "recv_timeout", type_constants::TYPE_INT)
  tc_register_builtin(tc, "try_send", type_constants::TYPE_INT)  # 0=full, 1=ok, 2=ok+at_hwm
  tc_register_builtin(tc, "try_recv", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "try_recv_or_closed", type_constants::TYPE_INT)

  # Channel UFCS method aliases
  tc_register_builtin(tc, "Channel$close", type_constants::TYPE_VOID)       # ch.close() -> channel_close(ch)
  tc_register_builtin(tc, "Channel$closed", type_constants::TYPE_BOOL)       # ch.closed() -> channel_closed(ch)
  tc_register_builtin(tc, "Channel$size", type_constants::TYPE_INT)         # ch.size() -> channel_size(ch)
  tc_register_builtin(tc, "Channel$send", type_constants::TYPE_VOID)        # ch.send(v) -> send(ch, v)
  tc_register_builtin(tc, "Channel$recv", type_constants::TYPE_INT)         # ch.recv() -> recv(ch)
  tc_register_builtin(tc, "Channel$recv_timeout", type_constants::TYPE_INT) # ch.recv_timeout(ms) -> recv_timeout(ch, ms)
  tc_register_builtin(tc, "Channel$try_send", type_constants::TYPE_INT)     # ch.try_send(v) -> try_send(ch, v) — 0=full, 1=ok, 2=ok+at_hwm
  tc_register_builtin(tc, "Channel$try_recv", type_constants::TYPE_BOOL)     # ch.try_recv() -> try_recv(ch)

  # Mutex operations — arities enforced so wrong-arity calls fail at TC, not codegen crash.
  tc_register_builtin_with_arity(tc, "mutex_new", type_constants::TYPE_INT, 1, 1)          # (init_val: Int) -> Mutex
  tc_register_builtin_with_arity(tc, "mutex_lock", type_constants::TYPE_INT, 1, 1)         # (mtx: Int) -> Int (protected value)
  tc_register_builtin_with_arity(tc, "mutex_unlock", type_constants::TYPE_VOID, 2, 2)      # (mtx: Int, new_val: Int) -> Void
  tc_register_builtin_with_arity(tc, "mutex_try_lock", type_constants::TYPE_BOOL, 1, 1)    # (mtx: Int) -> Int

  # Mutex UFCS method aliases.
  # `Mutex$lock` deliberately omitted — the stdlib `extend Mutex` now defines
  # `def lock(self): MutexGuard` for the with-block Scoped API. Re-registering
  # it as a 1-arg builtin returning Int makes the typechecker emit a 1-arg
  # `@mutex$Mutex$lock(m)` call, while codegen emits the user-defined
  # extend-method body with the 2-param (ghost+self) ABI — the arity mismatch
  # leaves `self` reading register x1's stale value and SIGSEGVs on deref.
  tc_register_builtin_with_arity(tc, "Mutex$unlock", type_constants::TYPE_VOID, 2, 2)      # m.unlock(v) -> mutex_unlock(m, v)
  tc_register_builtin_with_arity(tc, "Mutex$try_lock", type_constants::TYPE_BOOL, 1, 1)    # m.try_lock() -> mutex_try_lock(m)

  # atomic_compare_exchange: returns OLD value (Int). atomic_cas returns success flag (Bool). Both needed.
  tc_register_builtin(tc, "atomic_compare_exchange", type_constants::TYPE_INT)

  # AtomicInt UFCS method aliases
  tc_register_builtin(tc, "AtomicInt$load", type_constants::TYPE_INT)       # a.load() -> atomic_load(a)
  tc_register_builtin(tc, "AtomicInt$store", type_constants::TYPE_VOID)     # a.store(v) -> atomic_store(a, v)
  tc_register_builtin(tc, "AtomicInt$add", type_constants::TYPE_INT)        # a.add(v) -> atomic_add(a, v)
  tc_register_builtin(tc, "AtomicInt$sub", type_constants::TYPE_INT)        # a.sub(v) -> atomic_sub(a, v)
  tc_register_builtin(tc, "AtomicInt$exchange", type_constants::TYPE_INT)   # a.exchange(v) -> atomic_exchange(a, v)
  tc_register_builtin(tc, "AtomicInt$xor", type_constants::TYPE_INT)        # a.xor(v) -> atomic_xor(a, v)
  tc_register_builtin(tc, "AtomicInt$cas", type_constants::TYPE_BOOL)       # a.cas(exp, new) -> atomic_cas(a, exp, new)

  # Structured concurrency (task_group)
  tc_register_builtin(tc, "task_pool_get", type_constants::TYPE_INT)
  tc_register_builtin(tc, "task_group_new", type_constants::TYPE_INT)
  tc_register_builtin(tc, "task_group_await_all", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "task_group_destroy", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "is_cancelled", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "taskgroup_spawn", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "taskgroup_collect", type_constants::TYPE_INT)
  tc_register_builtin(tc, "taskgroup_cancel", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "TaskGroup$spawn", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "TaskGroup$collect", type_constants::TYPE_INT)
  tc_register_builtin(tc, "TaskGroup$cancel", type_constants::TYPE_VOID)

  # Task tree intrinsic (CONC.10)
  tc_register_builtin(tc, "sched_task_tree", type_constants::TYPE_VOID)  # Fn() -> Void — print task tree to stderr

   # Bit manipulation intrinsics
   tc_register_builtin(tc, "popcount", type_constants::TYPE_INT)   # Fn(Int) -> Int — count set bits
   tc_register_builtin(tc, "clz", type_constants::TYPE_INT)        # Fn(Int) -> Int — count leading zeros
   tc_register_builtin(tc, "ctz", type_constants::TYPE_INT)        # Fn(Int) -> Int — count trailing zeros
   tc_register_builtin(tc, "bswap", type_constants::TYPE_INT)      # Fn(Int) -> Int — byte swap
   tc_register_builtin(tc, "rotl", type_constants::TYPE_INT)       # Fn(Int, Int) -> Int — rotate left
   tc_register_builtin(tc, "rotr", type_constants::TYPE_INT)       # Fn(Int, Int) -> Int — rotate right

   # Wide-multiply / carry-chain intrinsics (NET.1 Phase 1, Step 1.4).
   # Six split intrinsics rather than three tuple-returning ones — see
   # docs/design/CRYPTO_STDLIB_DESIGN.md decision log 2026-05-08.
   tc_register_builtin(tc, "widening_mul_lo", type_constants::TYPE_INT)         # Fn(Int, Int) -> Int — low 64 bits of u64 × u64
   tc_register_builtin(tc, "widening_mul_hi", type_constants::TYPE_INT)         # Fn(Int, Int) -> Int — high 64 bits of u64 × u64
   tc_register_builtin(tc, "carrying_add_sum", type_constants::TYPE_INT)        # Fn(Int, Int, Int) -> Int — (a + b + c) mod 2^64
   tc_register_builtin(tc, "carrying_add_carry", type_constants::TYPE_INT)      # Fn(Int, Int, Int) -> Int — overflow flag (0 or 1)
   tc_register_builtin(tc, "borrowing_sub_diff", type_constants::TYPE_INT)      # Fn(Int, Int, Int) -> Int — (a − b − c) mod 2^64
   tc_register_builtin(tc, "borrowing_sub_borrow", type_constants::TYPE_INT)    # Fn(Int, Int, Int) -> Int — borrow flag (0 or 1)

   # x86 hardware-RNG intrinsics (NET.1 Phase 1, Step 2.5). Both return Int
   # with the success flag in bit 63 (high) and 63 bits of randomness in
   # bits 0..62 (RDRAND/RDSEED's low 63 bits). x86_64-only; calling on
   # other architectures emits IR referencing @llvm.x86.* which the linker
   # will reject at build time. See docs/design/WIREGUARD_UNIKERNEL_DESIGN.md
   # "Entropy source for the unikernel" for the design rationale.
   tc_register_builtin(tc, "rdrand_64", type_constants::TYPE_INT)               # Fn() -> Int — RDRAND (Ivy Bridge+)
   tc_register_builtin(tc, "rdseed_64", type_constants::TYPE_INT)               # Fn() -> Int — RDSEED (Broadwell+)

   # Regex intrinsics
   tc_register_builtin(tc, "regex_replace", type_constants::TYPE_STRING)      # Fn(String, String, String) -> String
   tc_register_builtin(tc, "regex_replace_all", type_constants::TYPE_STRING)  # Fn(String, String, String) -> String
   tc_register_builtin(tc, "regex_split", type_constants::TYPE_VEC)           # Fn(String, String) -> Vec<String>
   tc_register_builtin(tc, "regex_count", type_constants::TYPE_INT)           # Fn(String, String) -> Int
   tc_register_builtin(tc, "regex_matches", type_constants::TYPE_INT)         # Fn(String, String) -> Int (match count, PCRE2)
   tc_register_builtin(tc, "regex_find_all", type_constants::TYPE_VEC)        # Fn(String, String) -> Vec<String> (all matches, PCRE2)
   tc_register_builtin(tc, "regex_match_start", type_constants::TYPE_OPTION)   # v5.26: Fn(String, String) -> Option<Int>
   tc_register_builtin(tc, "regex_match_end", type_constants::TYPE_OPTION)     # v5.26: Fn(String, String) -> Option<Int>
   tc_register_builtin(tc, "regex_capture_named", type_constants::TYPE_STRING) # Fn(String, String, String) -> String

   # Collection transformation intrinsics
  tc_register_builtin(tc, "enumerate", type_constants::TYPE_INT)   # Fn(Array) -> Array<Pair>
  tc_register_builtin(tc, "flatten", type_constants::TYPE_VEC)     # Fn(Array<Array>) -> Vec
  tc_register_builtin(tc, "partition", type_constants::TYPE_INT)   # Fn(Array, Fn) -> Pair<Array, Array>
  tc_register_builtin(tc, "reversed", type_constants::TYPE_VEC)    # Fn(Array) -> Vec (canonical copy form)
  tc_register_builtin(tc, "sorted", type_constants::TYPE_VEC)      # Fn(Array) -> Vec (canonical copy form)
  tc_register_builtin(tc, "vec_sort", type_constants::TYPE_VOID)   # Fn(Vec) -> Void (in-place sort ascending)
  tc_register_builtin(tc, "vec_sort_by", type_constants::TYPE_VOID) # Fn(Vec, Fn) -> Void (in-place sort with cmp)
  tc_register_builtin(tc, "mkdir", type_constants::TYPE_INT)        # Fn(String) -> Int
  tc_register_builtin(tc, "rmdir", type_constants::TYPE_INT)        # Fn(String) -> Int (POSIX rmdir)
  tc_register_builtin(tc, "getcwd", type_constants::TYPE_STRING)    # Fn() -> String (current working directory)
  tc_register_builtin(tc, "chdir", type_constants::TYPE_INT)        # Fn(String) -> Int (0 on success, -1 on error)
  tc_register_builtin(tc, "setenv", type_constants::TYPE_INT)       # Fn(String, String) -> Int (0 on success)
  tc_register_builtin(tc, "rename", type_constants::TYPE_INT)       # Fn(String, String) -> Int (0 on success)
  tc_register_builtin(tc, "file_delete", type_constants::TYPE_INT)  # Fn(String) -> Int
  tc_register_builtin(tc, "file_size", type_constants::TYPE_INT)    # Fn(String) -> Int
  tc_register_builtin(tc, "file_mtime", type_constants::TYPE_INT)   # Fn(String) -> Int (epoch seconds, -1 on error)
  tc_register_builtin(tc, "readdir", type_constants::TYPE_INT)      # Fn(String) -> Vec<String>
  tc_register_builtin(tc, "path_join", type_constants::TYPE_STRING) # Fn(String, String) -> String
  tc_register_builtin(tc, "path_ext", type_constants::TYPE_STRING)  # Fn(String) -> String
  tc_register_builtin(tc, "path_dir", type_constants::TYPE_STRING)  # Fn(String) -> String
  tc_register_builtin(tc, "path_basename", type_constants::TYPE_STRING) # Fn(String) -> String
  tc_register_builtin(tc, "unique", type_constants::TYPE_VEC)      # Fn(Array) -> Vec
  tc_register_builtin(tc, "zip", type_constants::TYPE_INT)         # Fn(Array, Array) -> Array<Pair>
  
  # Timing intrinsics
  tc_register_builtin(tc, "sleep_ms", type_constants::TYPE_VOID)   # Fn(Int) -> Void
  
  # Float conversion intrinsics (Phase 5)
  tc_register_builtin(tc, "to_int", type_constants::TYPE_INT)    # Fn(F64) -> Int (fptosi)
  tc_register_builtin(tc, "to_f64", type_constants::TYPE_F64)    # Fn(Int) -> F64 (sitofp)
  tc_register_builtin(tc, "to_f32", type_constants::TYPE_F32)    # Fn(Int) -> F32 (sitofp + fptrunc)
  tc_register_builtin(tc, "f64_to_f32", type_constants::TYPE_F32) # Fn(F64) -> F32 (fptrunc) — MIR-internal truncation wrap

  # Narrow integer type conversions (Phase 5: Sized Storage)
  tc_register_builtin(tc, "to_i8", type_constants::TYPE_I8)
  tc_register_builtin(tc, "to_i16", type_constants::TYPE_I16)
  tc_register_builtin(tc, "to_i32", type_constants::TYPE_I32)
  tc_register_builtin(tc, "to_u8", type_constants::TYPE_U8)
  tc_register_builtin(tc, "to_u16", type_constants::TYPE_U16)
  tc_register_builtin(tc, "to_u32", type_constants::TYPE_U32)
  tc_register_builtin(tc, "to_u64", type_constants::TYPE_INT)  # U64 same width as Int

  # NonZero constructors/accessor (B.10 §14 N2) — all runtime IDENTITIES (a
  # NonZero IS its i64 value), lowered inline in mir_lower_call; no codegen.
  # nonzero_new returns Option<NonZero> (bare TYPE_OPTION here; the niche reads
  # the "Option<NonZero>" annotation string, and the payload binds NonZero from
  # the lvalue annotation). nonzero_new_unchecked mints a NonZero from any Int
  # (the explicit-unsafe escape, like Rust's new_unchecked); nonzero_get unwraps.
  tc_register_builtin(tc, "nonzero_new", type_constants::TYPE_OPTION)           # Fn(Int) -> Option<NonZero>
  tc_register_builtin(tc, "nonzero_new_unchecked", type_constants::TYPE_NONZERO) # Fn(Int) -> NonZero
  tc_register_builtin(tc, "nonzero_get", type_constants::TYPE_INT)              # Fn(NonZero) -> Int

  # Register built-in Option enum: Option<T> = Some(T) | None
  var opt_variant_names = vec_new<String>()
  opt_variant_names.push("Some")
  opt_variant_names.push("None")
  var opt_some_payloads = vec_new()
  opt_some_payloads.push(type_constants::TYPE_INT)
  var opt_none_payloads = vec_new()
  var opt_variant_payloads = vec_new()
  opt_variant_payloads.push(opt_some_payloads)
  opt_variant_payloads.push(opt_none_payloads)
  var opt_some_anns = vec_new<String>()
  opt_some_anns.push("T")
  var opt_none_anns = vec_new<String>()
  var opt_variant_anns = vec_new()
  opt_variant_anns.push(opt_some_anns)
  opt_variant_anns.push(opt_none_anns)
  typecheck_registry::tc_register_enum(tc, "Option", opt_variant_names, opt_variant_payloads, "T", opt_variant_anns)

  # Register built-in Result enum: Result<T, E> = Ok(T) | Err(E)
  var res_variant_names = vec_new<String>()
  res_variant_names.push("Ok")
  res_variant_names.push("Err")
  var res_ok_payloads = vec_new()
  res_ok_payloads.push(type_constants::TYPE_INT)
  var res_err_payloads = vec_new()
  res_err_payloads.push(type_constants::TYPE_INT)
  var res_variant_payloads = vec_new()
  res_variant_payloads.push(res_ok_payloads)
  res_variant_payloads.push(res_err_payloads)
  var res_ok_anns = vec_new<String>()
  res_ok_anns.push("T")
  var res_err_anns = vec_new<String>()
  res_err_anns.push("E")
  var res_variant_anns = vec_new()
  res_variant_anns.push(res_ok_anns)
  res_variant_anns.push(res_err_anns)
  typecheck_registry::tc_register_enum(tc, "Result", res_variant_names, res_variant_payloads, "T, E", res_variant_anns)

  # Resource cleanup — arities enforced (see PSQ-8)
  tc_register_builtin_with_arity(tc, "channel_free", type_constants::TYPE_VOID, 1, 1)   # (ch: Channel) -> Void
  tc_register_builtin_with_arity(tc, "Channel$free", type_constants::TYPE_VOID, 1, 1)
  tc_register_builtin_with_arity(tc, "mutex_free", type_constants::TYPE_VOID, 1, 1)     # (mtx: Int) -> Void
  tc_register_builtin_with_arity(tc, "Mutex$free", type_constants::TYPE_VOID, 1, 1)

  # RWLock operations — arities enforced (see PSQ-8)
  tc_register_builtin_with_arity(tc, "rwlock_new", type_constants::TYPE_INT, 1, 1)                # (init_val: Int) -> RWLock
  tc_register_builtin_with_arity(tc, "rwlock_read", type_constants::TYPE_INT, 1, 1)               # (rw: Int) -> Int
  tc_register_builtin_with_arity(tc, "rwlock_read_unlock", type_constants::TYPE_VOID, 1, 1)       # (rw: Int) -> Void
  tc_register_builtin_with_arity(tc, "rwlock_try_read", type_constants::TYPE_INT, 1, 1)           # (rw: Int) -> Int (-1 on failure)
  tc_register_builtin_with_arity(tc, "rwlock_write", type_constants::TYPE_INT, 1, 1)              # (rw: Int) -> Int
  tc_register_builtin_with_arity(tc, "rwlock_write_unlock", type_constants::TYPE_VOID, 2, 2)      # (rw: Int, new_val: Int) -> Void
  tc_register_builtin_with_arity(tc, "rwlock_try_write", type_constants::TYPE_INT, 1, 1)          # (rw: Int) -> Int (-1 on failure)
  tc_register_builtin_with_arity(tc, "rwlock_free", type_constants::TYPE_VOID, 1, 1)              # (rw: Int) -> Void
  tc_register_builtin_with_arity(tc, "RWLock$read", type_constants::TYPE_INT, 1, 1)
  tc_register_builtin_with_arity(tc, "RWLock$read_unlock", type_constants::TYPE_VOID, 1, 1)
  tc_register_builtin_with_arity(tc, "RWLock$try_read", type_constants::TYPE_INT, 1, 1)
  tc_register_builtin_with_arity(tc, "RWLock$write", type_constants::TYPE_INT, 1, 1)
  tc_register_builtin_with_arity(tc, "RWLock$write_unlock", type_constants::TYPE_VOID, 2, 2)
  tc_register_builtin_with_arity(tc, "RWLock$try_write", type_constants::TYPE_INT, 1, 1)
  tc_register_builtin_with_arity(tc, "RWLock$free", type_constants::TYPE_VOID, 1, 1)

  # WaitGroup operations
  tc_register_builtin(tc, "waitgroup_new", type_constants::TYPE_INT)
  tc_register_builtin(tc, "waitgroup_done", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "waitgroup_wait", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "waitgroup_free", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "WaitGroup$done", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "WaitGroup$wait", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "WaitGroup$free", type_constants::TYPE_VOID)

  # OnceCell operations
  tc_register_builtin(tc, "oncecell_new", type_constants::TYPE_INT)
  tc_register_builtin(tc, "oncecell_get_or_init", type_constants::TYPE_INT)
  tc_register_builtin(tc, "oncecell_get", type_constants::TYPE_INT)
  tc_register_builtin(tc, "oncecell_free", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "OnceCell$get_or_init", type_constants::TYPE_INT)
  tc_register_builtin(tc, "OnceCell$get", type_constants::TYPE_INT)
  tc_register_builtin(tc, "OnceCell$free", type_constants::TYPE_VOID)

  # Deadline cancel token
  tc_register_builtin(tc, "cancel_token_with_deadline", type_constants::TYPE_INT)

  # Cancel token builtins (structured concurrency)
  tc_register_builtin(tc, "cancel_token_new", type_constants::TYPE_INT)
  tc_register_builtin(tc, "cancel_token_cancel", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "cancel_token_is_cancelled", type_constants::TYPE_BOOL)
  tc_register_builtin(tc, "cancel_token_free", type_constants::TYPE_VOID)

  # Completion notification builtins
  tc_register_builtin(tc, "completion_watch", type_constants::TYPE_INT)
  tc_register_builtin(tc, "completion_unwatch", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "completion_watch_multi", type_constants::TYPE_INT)
  tc_register_builtin(tc, "completion_unwatch_all", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "completion_block", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "fd_close", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "sched_is_active", type_constants::TYPE_INT)

  # Task-local storage builtins
  tc_register_builtin(tc, "task_id", type_constants::TYPE_INT)
  tc_register_builtin(tc, "task_self", type_constants::TYPE_INT)  # () -> Int — current task frame pointer
  tc_register_builtin(tc, "task_id_next", type_constants::TYPE_INT)
  # C.13 Phase 5: generic resource-waiter register/unregister — used by every
  # Selectable.register_waker. Target is a kind-tagged i64 key.
  tc_register_builtin(tc, "waiter_register", type_constants::TYPE_VOID)   # (target: Int, waiter: Int) -> Void
  tc_register_builtin(tc, "waiter_unregister", type_constants::TYPE_VOID) # (target: Int, waiter: Int) -> Void
  tc_register_builtin(tc, "set_current_frame", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "task_local_set", type_constants::TYPE_VOID)
  tc_register_builtin(tc, "task_local_get", type_constants::TYPE_INT)

  # B.7 Phase 4a: per-thread current Scope handle accessors. Read/write
  # the canonical compiler-emitted TLS @__qz_current_scope_handle that
  # std/sync/composition/scope.qz uses for current_scope() + scope_with's push/pop.
  tc_register_builtin(tc, "current_scope_load", type_constants::TYPE_INT)   # () -> Int
  tc_register_builtin(tc, "current_scope_store", type_constants::TYPE_VOID) # (Int) -> Void

  # B.7 Phase 4d: deadline timer hookup. Spawns a background pthread that
  # sleeps until `abs_ns` then calls `_scope_fire_deadline_exceeded(scope)`
  # to proactively cancel the scope. Required so descendants observe the
  # cancellation walk even when nothing polls the parent — and so Phase 4e's
  # blocking-primitive wake-on-cancel has a deterministic firing point.
  tc_register_builtin(tc, "scope_register_deadline", type_constants::TYPE_VOID) # (scope: Int, abs_ns: Int) -> Void

  # Colorless concurrency: join() waits for a task handle to complete.
  # Equivalent to 'await' but without the keyword — part of the colorless API.
  tc_register_builtin(tc, "join", type_constants::TYPE_INT)

  # Register Drop trait for linear types
  var drop_methods = vec_new<String>()
  drop_methods.push("drop")
  var drop_param_types = vec_new()
  drop_param_types.push(type_constants::TYPE_INT)
  var drop_sig = [drop_param_types, type_constants::TYPE_VOID]
  var drop_sigs = vec_new()
  drop_sigs.push(drop_sig)
  var drop_defaults = vec_new()
  drop_defaults.push(0)
  typecheck_registry::tc_register_trait(tc, "Drop", drop_methods, drop_sigs, drop_defaults, "", "")

  # Register Iterator<T> trait for sync generators
  var iter_methods = vec_new<String>()
  iter_methods.push("next")
  var iter_param_types = vec_new()
  iter_param_types.push(type_constants::TYPE_INT)
  var iter_sig = [iter_param_types, type_constants::TYPE_INT]
  var iter_sigs = vec_new()
  iter_sigs.push(iter_sig)
  var iter_defaults = vec_new()
  iter_defaults.push(0)
  typecheck_registry::tc_register_trait(tc, "Iterator", iter_methods, iter_sigs, iter_defaults, "", "T")

  # Register AsyncIterator<T> trait for async generators
  var aiter_methods = vec_new<String>()
  aiter_methods.push("next")
  var aiter_param_types = vec_new()
  aiter_param_types.push(type_constants::TYPE_INT)
  var aiter_sig = [aiter_param_types, type_constants::TYPE_INT]
  var aiter_sigs = vec_new()
  aiter_sigs.push(aiter_sig)
  var aiter_defaults = vec_new()
  aiter_defaults.push(0)
  typecheck_registry::tc_register_trait(tc, "AsyncIterator", aiter_methods, aiter_sigs, aiter_defaults, "", "T")
end
