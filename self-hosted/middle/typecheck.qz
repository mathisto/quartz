##! # Type Checker
##!
##! Phase 3 of the Quartz compiler: semantic analysis and type verification.
##!
##! This module walks the parsed AST and performs:
##! 1. Register struct/enum/trait definitions
##! 2. Register function signatures
##! 3. Type check global let bindings
##! 4. Type check function bodies
##! 5. Report type errors with source location
##!
##! ## Type Checker State
##!
##! The type checker maintains a state vector (handle `tc`) with indices:
##!
##! | Index | Field | Purpose |
##! |-------|-------|---------|
##! | 0 | source | Full source code for error messages |
##! | 1 | filename | Source filename |
##! | 2 | errors | Vector of error messages |
##! | 3 | error_lines | Vector of error line numbers |
##! | 4 | error_cols | Vector of error column numbers |
##! | 5 | binding_names | Scope binding names |
##! | 6 | binding_types | Scope binding types |
##! | 7 | binding_mutables | Scope binding mutability flags |
##! | 8 | binding_param_counts | Parameter counts for functions |
##! | 9 | builtins | Builtin function registry |
##! | 10 | depth | Current scope depth |
##! | 11-16 | struct_* | Struct registry |
##! | 17-21 | func_* | Function registry |
##! | 22 | return_type | Current function's return type |
##! | 23 | (removed) | Was: global inference context |
##! | 24-28 | enum_* | Enum registry |
##! | 29-33 | trait_* | Trait registry |
##! | 34-38 | impl_* | Impl block registry |
##!
##! ## Type System
##!
##! Quartz uses nominal typing with 16 base type constants:
##! - Primitives: Int, Bool, String, Void, Symbol
##! - Collections: Array, Range
##! - Composites: Struct, Enum, Trait
##! - Parameterized: Option, Result, Function, Generic
##! - Special: Unknown, Error
##!
##! ## Error Handling
##!
##! Type errors are collected (not fatal) to report multiple issues.
##! Use `typecheck_util$tc_has_errors()` to check, `typecheck_util$tc_print_errors()` to display.
##!
##! ## "Did You Mean?" Suggestions
##!
##! When an identifier isn't found, the type checker uses
##! Damerau-Levenshtein distance to suggest similar names.
##!
##! @see parser AST generation (Phase 2)
##! @see mir MIR lowering (Phase 4)
##! @since 1.0.0

import typeenv
import ast
import diagnostic
import typecheck_util
import typecheck_diag
import typecheck_builtins
import typecheck_helpers
import typecheck_registry
import liveness
import compiler_types
import string_intern
import node_constants
import type_constants
import content_hash
import file_io
import * from str_compat
import std/diag
import dep_graph


## Create a new type checker context.
## Initializes all registries and scope tracking.
##
## Returns: Context handle (TypecheckState struct)
def tc_new(): TypecheckState
  # Current function state - wrapped in Vec for mutability
  var ret_type_vec = [type_constants::TYPE_VOID]
  var depth_vec = [0]
  var current_func_idx_vec = [-1]
  
  # Source info - wrapped in Vec for mutability
  var src_vec = [""]
  var file_vec = [""]
  
  # Binding count - wrapped in Vec for mutability
  var binding_count_vec = [0]
  # SURF.FLOW Phase 1 — narrow side-table live-row count (mirrors binding_count)
  var narrow_count_vec = [0]
  # SURF.FLOW B1 — alias side-table live-row count (mirrors narrow_count)
  var alias_count_vec = [0]

  var errs = typecheck_util::TcErrors {
    errors: vec_new<String>(),
    error_lines: vec_new(),
    error_cols: vec_new(),
    error_files: vec_new<String>(),
    error_expansion_idxs: vec_new(),
    warnings: vec_new<String>(),
    warning_lines: vec_new(),
    warning_cols: vec_new(),
    warning_files: vec_new<String>(),
    warning_expansion_idxs: vec_new()
  }
  var scope = typecheck_util::TcScope {
    binding_names: vec_new<String>(),
    binding_types: vec_new(),
    binding_depths: vec_new(),
    binding_mutables: vec_new(),
    binding_struct_names: vec_new<String>(),
    binding_count: binding_count_vec,
    binding_param_counts: vec_new(),
    binding_type_annotations: vec_new<String>(),
    binding_display_types: vec_new<String>(),
    binding_schemes: vec_new<Vec<Int>>(),
    current_scope_depth: depth_vec,
    current_func_return_type: ret_type_vec,
    current_func_idx: current_func_idx_vec,
    handler_effect_stack: vec_new(),
    last_lambda_body_type: 0,
    trait_type_params: "",
    impl_self_type: "",
    binding_scope_idxs: vec_new(),
    narrow_names: vec_new<String>(),
    narrow_variant_idx: vec_new(),
    narrow_inner_type: vec_new(),
    narrow_inner_struct: vec_new<String>(),
    narrow_depth: vec_new(),
    narrow_count: narrow_count_vec,
    alias_names: vec_new<String>(),
    alias_guard_node: vec_new(),
    alias_depth: vec_new(),
    alias_count: alias_count_vec
  }
  var safety = typecheck_util::TcSafety {
    binding_linear_states: vec_new(),
    binding_linear_structs: vec_new<String>(),
    binding_borrow_states: vec_new(),
    binding_shared_borrow_counts: vec_new(),
    binding_borrow_sources: vec_new(),
    binding_is_mut_borrows: vec_new(),
    binding_borrow_lines: vec_new(),
    binding_borrow_cols: vec_new(),
    move_states: vec_new(),
    move_types: vec_new<String>(),
    move_targets: vec_new<String>(),
    move_lines: vec_new(),
    move_cols: vec_new(),
    copy_types: vec_new<String>(),
    partial_moved_fields: vec_new<String>(),
    partial_move_targets: vec_new<String>(),
    partial_move_lines: vec_new<String>(),
    arena_var_names: vec_new<String>(),
    arena_var_sources: vec_new<String>(),
    arena_var_lines: vec_new(),
    arena_invalidated: vec_new<String>(),
    arena_invalidated_lines: vec_new(),
    arena_scoped_arenas: vec_new<String>(),
    field_access_depth: 0,
    binding_protocol_ids: vec_new(),
    binding_protocol_states: vec_new(),
    binding_protocol_type_args: vec_new<String>()
  }
  var registry = typecheck_util::TcRegistry {
    struct_names: vec_new<String>(),
    struct_field_names: vec_new<Vec<String>>(),
    struct_field_types: vec_new<Vec<Int>>(),
    struct_type_params: vec_new<String>(),
    struct_field_annotations: vec_new<Vec<String>>(),
    struct_is_linear: vec_new(),
    struct_is_value: vec_new(),
    struct_repr_c: vec_new(),
    struct_field_defaults: vec_new<Vec<Int>>(),
    struct_dsl_kind: vec_new(),
    struct_dsl_backing: vec_new(),
    struct_row_var_names: vec_new<Vec<String>>(),
    struct_row_var_ids: vec_new<Vec<Int>>(),
    enum_names: vec_new<String>(),
    enum_variant_names: vec_new<Vec<String>>(),
    enum_variant_payloads: vec_new<Vec<Int>>(),
    enum_type_params: vec_new<String>(),
    enum_variant_field_annotations: vec_new<Vec<String>>(),
    func_names: vec_new<String>(),
    func_param_types: vec_new<Vec<Int>>(),
    func_return_types: vec_new(),
    func_return_annotations: vec_new<String>(),
    func_required_counts: vec_new(),
    func_param_fn_annotations: vec_new<Vec<Int>>(),
    trait_names: vec_new<String>(),
    trait_method_names: vec_new<Vec<String>>(),
    trait_method_sigs: vec_new<Vec<Int>>(),
    trait_method_defaults: vec_new<Vec<Int>>(),
    trait_method_effect_rows: vec_new<Vec<Int>>(),
    trait_generalized_ervs: vec_new<Vec<Int>>(),
    trait_super_traits: vec_new<String>(),
    trait_type_params: vec_new<String>(),
    impl_trait_names: vec_new<String>(),
    impl_for_types: vec_new<String>(),
    impl_method_names: vec_new<Vec<String>>(),
    neg_impl_trait_names: vec_new<String>(),
    neg_impl_for_types: vec_new<String>(),
    type_alias_names: vec_new<String>(),
    type_alias_types: vec_new<String>(),
    newtype_names: vec_new<String>(),
    newtype_wrapped_types: vec_new<String>(),
    newtype_type_ids: vec_new(),
    newtype_strict_flags: vec_new<Int>(),
    union_member_strings: vec_new<String>(),
    union_type_names: vec_new<String>(),
    intersection_member_strings: vec_new<String>(),
    intersection_record_fields: vec_new<Vec<String>>(),
    intersection_record_types: vec_new<Vec<String>>(),
    fn_type_annotations: vec_new<String>(),
    fn_type_param_counts: vec_new(),
    fn_type_return_types: vec_new(),
    fn_type_param_types: vec_new<Vec<Int>>(),
    fn_type_effect_bounds: vec_new(),
    fn_type_can_row_idx: vec_new(),
    func_type_params: vec_new<String>(),
    func_type_param_bounds: vec_new<String>(),
    func_param_annotations: vec_new<String>(),
    func_param_names: vec_new<String>(),
    func_ast_stores: vec_new(),
    func_ast_handles: vec_new(),
    record_signatures: vec_new<String>(),
    record_field_names: vec_new(),
    record_field_types: vec_new(),
    record_row_vars: vec_new(),
    record_field_type_ids: vec_new<Vec<Int>>(),
    tuple_elem_types: vec_new<Vec<Int>>(),
    impl_return_func_names: vec_new<String>(),
    impl_return_concrete_types: vec_new<String>(),
    impl_return_trait_names: vec_new<String>(),
    forall_var_names: vec_new<Vec<String>>(),
    forall_body_types: vec_new(),
    forall_var_ids: vec_new<Vec<Int>>(),
    func_borrow_summaries: vec_new<Option<typecheck_util::BorrowSummary>>(),
    row_label_lists: vec_new<Vec<Int>>(),
    row_tail_vars: vec_new(),
    effect_decl_names: vec_new<String>(),
    effect_decl_op_starts: vec_new(),
    effect_decl_op_counts: vec_new(),
    effect_decl_op_names: vec_new<String>(),
    effect_decl_op_kinds: vec_new(),
    effect_decl_op_param_types: vec_new<Vec<Int>>(),
    effect_decl_op_return_types: vec_new(),
    func_effect_row_idx: vec_new(),
    func_generalized_ervs: vec_new<Vec<Int>>()
  }
  var tc = TypecheckState {
    errs: errs,
    scope: scope,
    safety: safety,
    registry: registry,
    builtins: map_new<String, Int>(),
    type_storage: vec_new(),
    source: src_vec,
    filename: file_vec,
    current_file: "",
    param_type_vars: vec_new<String>(),
    builtin_min_arity: map_new<String, Int>(),
    builtin_max_arity: map_new<String, Int>(),
    builtin_callback_effect: map_new<String, String>(),
    in_sched_min_depth: 0,
    thread_local_globals: map_new<String, Int>(),
    ptype_bases: vec_new(),
    ptype_arg1s: vec_new(),
    ptype_arg2s: vec_new(),
    ptype_names: vec_new<String>(),
    ptype_intern_map: map_new<String, Int>(),
    loop_labels: vec_new<String>(),
    interner: string_intern::intern_new(),
    pending_ptype_names: vec_new<String>(),
    pending_ptype_bases: vec_new(),
    pending_ptype_vars: vec_new(),
    pending_ptype_vars2: vec_new(),
    inferred_vec_vars: vec_new<String>(),
    inferred_vec_lines: vec_new(),
    pending_map_new_vars: vec_new<String>(),
    pending_map_new_nodes: vec_new(),
    pending_set_new_vars: vec_new<String>(),
    pending_set_new_nodes: vec_new(),
    set_struct_elem_vars: vec_new<String>(),
    set_struct_elem_types: vec_new<String>(),
    tv_next: 1,
    tv_bindings: vec_new(),
    tv_origin_lines: vec_new(),
    tv_origin_cols: vec_new(),
    tv_origin_descs: vec_new<String>(),
    rv_next: 1,
    rv_bindings: vec_new(),
    erv_next: 1,
    erv_bindings: vec_new(),
    func_row_var_names: vec_new<String>(),
    func_row_var_ids: vec_new(),
    tv_levels: vec_new(),
    tv_current_level: 0,
    last_unify_expected: 0,
    last_unify_actual: 0,
    last_unify_depth: 0,
    tv_is_rigid: vec_new(),
    protocol_names: vec_new<String>(),
    protocol_type_params: vec_new<String>(),
    protocol_step_kinds: vec_new<Vec<Int>>(),
    protocol_step_types: vec_new<Vec<Int>>(),
    protocol_step_type_annotations: vec_new<Vec<String>>(),
    protocol_dfa_state_count: vec_new(),
    protocol_dfa_transitions: vec_new<Vec<Int>>(),
    protocol_dfa_accept: vec_new(),
    call_rewrite_depth: 0,
    parse_type_cache: map_new<String, Int>()
  }
  typecheck_registry::tc_registry_reset_intern_ids()

  # Arena safety state is initialized in TcSafety struct fields (default empty Vecs)

  # Initialize builtins
  typecheck_builtins::tc_init_builtins(tc)

  # Fix return types for builtins that return parameterized types.
  # tc_init_builtins registers these as TYPE_INT (the runtime representation),
  # but the type system needs the real ptype for downstream inference (.size, UFCS, indexing).
  # Must be done here because tc_make_ptype lives in typecheck.qz (circular import from builtins).
  var vec_string_ptype = tc_make_ptype(tc, type_constants::TYPE_VEC, type_constants::TYPE_STRING, 0)
  typecheck_builtins::tc_register_builtin(tc, "str_split", vec_string_ptype)
  typecheck_builtins::tc_register_builtin(tc, "String$split", vec_string_ptype)
  # str_chars / .chars() returns Vec<Int> of codepoints (runtime
  # qz_str_chars_utf8), NOT Vec<String>. Registering it as Vec<String> made
  # `s.chars()[i]` type-resolve to String while the runtime value is a
  # codepoint Int — a silent type-vs-runtime mismatch (surfaced by the R2.3
  # arg-type check: `assert_eq(cs[0], 97)` false-flagged, and content-comparing
  # the "String" element SIGSEGV'd on the raw codepoint reinterpreted as a ptr).
  var vec_int_ptype = tc_make_ptype(tc, type_constants::TYPE_VEC, type_constants::TYPE_INT, 0)
  typecheck_builtins::tc_register_builtin(tc, "str_chars", vec_int_ptype)
  typecheck_builtins::tc_register_builtin(tc, "String$chars", vec_int_ptype)

  return tc
end

## Check if any type errors have been recorded (wrapper for quartz.qz).
def tc_has_errors(tc: TypecheckState): Bool = typecheck_util::tc_has_errors(tc)

## Emit all recorded type errors as diagnostics (wrapper for quartz.qz).
def tc_emit_diagnostics(tc: TypecheckState, filename: String, src_lines: Vec<String>): Void
  typecheck_util::tc_emit_diagnostics(tc, filename, src_lines)
end

## Compute an interface hash for a module by hashing its exported function
## signatures, struct definitions, and enum definitions.
## The hash captures everything that would affect dependent modules.
## Used by incremental compilation for early cutoff.
def tc_compute_interface_hash(tc: TypecheckState, module_prefix: String): String
  var iface = ""
  var prefix_dollar = "#{module_prefix}$"

  # Hash function signatures
  var func_names = tc.registry.func_names
  var func_return_types = tc.registry.func_return_types
  var func_param_types = tc.registry.func_param_types
  for fi in 0..func_names.size
    var fname = func_names[fi]
    if fname.starts_with(prefix_dollar)
      iface = "#{iface}F:#{fname}:"
      iface = "#{iface}#{str_from_int(func_return_types[fi])}"
      var params = func_param_types[fi]
      var pi = 0
      while pi < params.size
        iface = "#{iface},#{str_from_int(params[pi])}"
        pi += 1
      end
      iface = "#{iface}\n"
    end
  end

  # Hash struct definitions
  var struct_names = tc.registry.struct_names
  var struct_field_names = tc.registry.struct_field_names
  var struct_field_types = tc.registry.struct_field_types
  for si in 0..struct_names.size
    var sname = struct_names[si]
    if sname.starts_with(prefix_dollar)
      iface = "#{iface}S:#{sname}:"
      var fnames = struct_field_names[si]
      var ftypes = struct_field_types[si]
      var sfi = 0
      while sfi < fnames.size
        if sfi > 0
          iface = "#{iface},"
        end
        iface = "#{iface}#{fnames[sfi]}=#{str_from_int(ftypes[sfi])}"
        sfi += 1
      end
      iface = "#{iface}\n"
    end
  end

  # Hash enum definitions
  var enum_names = tc.registry.enum_names
  var enum_variant_names = tc.registry.enum_variant_names
  for ei in 0..enum_names.size
    var ename = enum_names[ei]
    if ename.starts_with(prefix_dollar)
      iface = "#{iface}E:#{ename}:"
      var vnames = enum_variant_names[ei]
      var vi = 0
      while vi < vnames.size
        if vi > 0
          iface = "#{iface},"
        end
        iface = "#{iface}#{vnames[vi]}"
        vi += 1
      end
      iface = "#{iface}\n"
    end
  end

  return content_hash::content_hash(iface)
end

## Report type mismatch error.
##
## Parameters:
##   tc       - Type checker context
##   expected - Expected type kind
##   got      - Actual type kind
##   line     - Line number
##   col      - Column number
def tc_error_type_mismatch(tc: TypecheckState, expected: TypeId, got: TypeId, line: Int, col: Int): Void
  var expected_name = tc_type_name_full(tc, expected)
  var got_name = tc_type_name_full(tc, got)
  var msg = "Type mismatch: expected #{expected_name} but got #{got_name}"
  typecheck_util::tc_error(tc, msg, line, col)
end

## Report match arm type mismatch error.
## This produces an Elm-style error showing which types don't match.
##
## Parameters:
##   tc             - Type checker context
##   expected_type  - Type of the first arm
##   got_type       - Type of the current arm
##   line           - Line number of the mismatched arm
##   col            - Column number of the mismatched arm
def tc_error_match_arm_mismatch(tc: TypecheckState, expected_type: TypeId, got_type: TypeId, line: Int, col: Int): Void
  var expected_name = tc_type_name_full(tc, expected_type)
  var got_name = tc_type_name_full(tc, got_type)
  var msg = "Match arm type mismatch: expected '#{expected_name}', found '#{got_name}'"
  typecheck_util::tc_error(tc, msg, line, col)
end

## QZ1209: Check if a variable is borrowed before allowing mutation.
def tc_check_mutation_while_borrowed(tc: TypecheckState, var_name: String, line: Int, col: Int): Void can Diag
  var bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
  if bidx >= 0
    if tc.safety.binding_borrow_states[bidx] != 0
      # Find the borrow holder for better diagnostics
      var holder_name = ""
      var holder_last_line = -1
      var holder_idx = -1
      var binding_count = tc.scope.binding_names.size
      var si = 0
      while si < binding_count
        if tc.safety.binding_borrow_sources[si] != 0
          var src_name = as_string(tc.safety.binding_borrow_sources[si])
          if src_name == var_name
            holder_name = tc.scope.binding_names[si]
            holder_last_line = liveness::liveness_current_last_use_line(holder_name)
            holder_idx = si
            si = binding_count
          end
        end
        si += 1
      end
      if str_byte_len(holder_name) > 0 and holder_last_line > 0
        var borrow_created_line = 0
        if holder_idx >= 0
          borrow_created_line = tc.safety.binding_borrow_lines[holder_idx]
        end
        if borrow_created_line > 0
          error("QZ1209: Cannot mutate '#{var_name}' while it is borrowed by '#{holder_name}' (borrow created at line #{borrow_created_line}, live until line #{holder_last_line})", line, col)
        else
          error("QZ1209: Cannot mutate '#{var_name}' while it is borrowed by '#{holder_name}' (borrow live until line #{holder_last_line})", line, col)
        end
      else
        error("QZ1209: Cannot mutate '#{var_name}' while it is borrowed", line, col)
      end
    end
  end
end

## NLL: Try to release a borrow if this is the binding's last use.
## Called from NODE_IDENT handler after looking up the binding.
## If liveness analysis says this is the last use, release the borrow
## held by this binding (same logic as tc_release_old_borrow).
def tc_try_release_borrow_at_last_use(tc: TypecheckState, var_name: String, line: Int, col: Int): Void
  if liveness::liveness_is_last_use(var_name, line, col) != 1
    return
  end
  # This is the last use — release any borrow this binding holds
  var bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
  if bidx < 0
    return
  end
  var borrow_src = tc.safety.binding_borrow_sources[bidx]
  if borrow_src == 0
    return
  end
  # Release using the same logic as tc_release_old_borrow
  tc_release_old_borrow(tc, var_name)
end

## QZ1217: Propagate borrow protection along the borrow chain.
## When creating `var c = &b` where `b = &a`, walks from b's source (a)
## up the chain, protecting each ancestor from mutation.
## max_depth prevents infinite loops on circular references.
def tc_propagate_borrow_chain(tc: TypecheckState, source_name: String, is_mut: Int): Void
  var depth = 0
  var current = source_name
  while depth < 10
    var cidx = typecheck_util::tc_lookup_binding_index(tc, current)
    if cidx < 0
      return
    end
    var chain_src = tc.safety.binding_borrow_sources[cidx]
    if chain_src == 0
      return
    end
    # chain_src is the binding that `current` borrows from — protect it too
    var chain_name = as_string(chain_src)
    var chain_idx = typecheck_util::tc_lookup_binding_index(tc, chain_name)
    if chain_idx < 0
      return
    end
    # Apply borrow protection to the ancestor
    if is_mut == 1
      tc.safety.binding_borrow_states[chain_idx] = 2
    else
      if tc.safety.binding_borrow_states[chain_idx] == 0
        tc.safety.binding_borrow_states[chain_idx] = 1
      end
      tc.safety.binding_shared_borrow_counts[chain_idx] = tc.safety.binding_shared_borrow_counts[chain_idx] + 1
    end
    current = chain_name
    depth += 1
  end
end

## Release a borrow when the variable holding it is reassigned.
## Walks the borrow chain to release all ancestor protections.
def tc_release_old_borrow(tc: TypecheckState, var_name: String): Void
  var bidx = typecheck_util::tc_lookup_binding_index(tc, var_name)
  if bidx >= 0
    var borrow_src = tc.safety.binding_borrow_sources[bidx]
    if borrow_src != 0
      var is_mut = tc.safety.binding_is_mut_borrows[bidx]
      # Release the immediate source
      var src_name = as_string(borrow_src)
      var src_idx = typecheck_util::tc_lookup_binding_index(tc, src_name)
      if src_idx >= 0
        if is_mut == 1
          tc.safety.binding_borrow_states[src_idx] = 0
        else
          var sc = tc.safety.binding_shared_borrow_counts[src_idx]
          if sc > 0
            tc.safety.binding_shared_borrow_counts[src_idx] = sc - 1
            if sc - 1 == 0
              tc.safety.binding_borrow_states[src_idx] = 0
            end
          end
        end
      end
      # Release along the borrow chain (multi-level)
      var current = src_name
      for depth in 0..10
        var cidx = typecheck_util::tc_lookup_binding_index(tc, current)
        if cidx < 0
          break
        end
        var chain_src = tc.safety.binding_borrow_sources[cidx]
        if chain_src == 0
          break
        end
        var chain_name = as_string(chain_src)
        var chain_idx = typecheck_util::tc_lookup_binding_index(tc, chain_name)
        if chain_idx < 0
          break
        end
        if is_mut == 1
          tc.safety.binding_borrow_states[chain_idx] = 0
        else
          var sc = tc.safety.binding_shared_borrow_counts[chain_idx]
          if sc > 0
            tc.safety.binding_shared_borrow_counts[chain_idx] = sc - 1
            if sc - 1 == 0
              tc.safety.binding_borrow_states[chain_idx] = 0
            end
          end
        end
        current = chain_name
      end
      tc.safety.binding_borrow_sources[bidx] = 0
      tc.safety.binding_is_mut_borrows[bidx] = 0
      tc.safety.binding_borrow_lines[bidx] = 0
      tc.safety.binding_borrow_cols[bidx] = 0
    end
  end
end

## Snapshot borrow states for all current bindings.
## Returns a flat vector: [states... shared_counts... sources... is_mut... count]
def tc_snapshot_borrow_states(tc: TypecheckState): Vec<Int>
  var binding_count = typecheck_util::tc_get_binding_count(tc)
  var snapshot = vec_new()
  for i in 0..binding_count
    snapshot.push(tc.safety.binding_borrow_states[i])
  end
  for i in 0..binding_count
    snapshot.push(tc.safety.binding_shared_borrow_counts[i])
  end
  for i in 0..binding_count
    snapshot.push(tc.safety.binding_borrow_sources[i])
  end
  for i in 0..binding_count
    snapshot.push(tc.safety.binding_is_mut_borrows[i])
  end
  snapshot.push(binding_count)
  return snapshot
end

## Restore loop-created borrows from a snapshot.
## Only reverts borrows that were CREATED inside the loop body (not present
## in snapshot). Borrows that existed before the loop keep their current state
## (which may have been NLL-released during the body walk).
def tc_restore_borrow_states(tc: TypecheckState, snapshot: Vec<Int>): Void
  var count = snapshot[snapshot.size - 1]
  # First pass: revert borrow SOURCES created inside the loop
  for i in 0..count
    var snap_src = snapshot[count + count + i]
    var curr_src = tc.safety.binding_borrow_sources[i]
    if snap_src == 0 and curr_src != 0
      # This borrow was created inside the loop — release it properly
      tc_release_old_borrow(tc, tc.scope.binding_names[i])
    end
  end
end

def tc_exit_scope(tc: TypecheckState): Void can Diag
  var depth = typecheck_util::tc_get_depth(tc)
  var binding_depths = tc.scope.binding_depths
  var binding_count = typecheck_util::tc_get_binding_count(tc)

  # Release borrows before exiting scope
  var bi = binding_count - 1
  while bi >= 0
    if binding_depths[bi] < depth
      break
    end
    var borrow_src = tc.safety.binding_borrow_sources[bi]
    if borrow_src != 0
      var src_name = as_string(borrow_src)
      var src_idx = typecheck_util::tc_lookup_binding_index(tc, src_name)
      if src_idx >= 0
        if tc.safety.binding_is_mut_borrows[bi] == 1
          tc.safety.binding_borrow_states[src_idx] = 0
        else
          var sc = tc.safety.binding_shared_borrow_counts[src_idx]
          if sc > 0
            tc.safety.binding_shared_borrow_counts[src_idx] = sc - 1
            if sc - 1 == 0
              tc.safety.binding_borrow_states[src_idx] = 0
            end
          end
        end
      end
    end
    bi -= 1
  end

  # Check linear bindings before exiting scope
  typecheck_registry::tc_check_linear_scope_exit(tc, depth)

  # Check protocol channels are fully consumed before exiting scope
  typecheck_registry::tc_check_protocol_scope_exit(tc, depth)

  # QZ1218: Check for dangling references — outer-scope bindings borrowing from
  # bindings that are about to go out of scope
  for di in 0..binding_count
    var d_depth = binding_depths[di]
    if d_depth < depth
      # This binding survives the scope exit — check if it borrows from a dying binding
      var d_src = tc.safety.binding_borrow_sources[di]
      if d_src != 0
        var d_src_name = as_string(d_src)
        var d_src_idx = typecheck_util::tc_lookup_binding_index(tc, d_src_name)
        if d_src_idx >= 0
          if binding_depths[d_src_idx] >= depth
            var d_name = tc.scope.binding_names[di]
            var d_borrow_line = tc.safety.binding_borrow_lines[di]
            if d_borrow_line > 0
              error("QZ1218: Dangling borrow — '#{d_name}' borrows '#{d_src_name}' which is going out of scope (borrow created at line #{d_borrow_line})", d_borrow_line, 0)
            else
              error("QZ1218: Dangling borrow — '#{d_name}' borrows '#{d_src_name}' which is going out of scope", 0, 0)
            end
          end
        end
      end
    end
  end

  # Remove bindings at current depth by decrementing binding_count
  while binding_count > 0
    var last_depth = binding_depths[binding_count - 1]
    if last_depth == depth
      # "Pop" the binding by decrementing count
      binding_count -= 1
    else
      # No more bindings at current depth
      break
    end
  end
  
  # SURF.FLOW Phase 2 — drop any narrowing refinements recorded at this scope
  # depth (e.g. guard-style post-if facts injected into the enclosing scope).
  # Without this, a function-body-depth narrowing would leak into the next
  # function typechecked on the same scope stack. The if-handler's per-branch
  # tc_restore_narrow handles then/else narrowings; this catches the rest.
  typecheck_util::tc_narrow_clear_at_depth(tc, depth)
  # SURF.FLOW B1 — same scope-exit truncation for the alias side table, so a const
  # alias to a guard boolean cannot leak past the block that declared it.
  typecheck_util::tc_alias_clear_at_depth(tc, depth)

  typecheck_util::tc_set_binding_count(tc, binding_count)
  typecheck_util::tc_set_depth(tc, depth - 1)
end


# ============================================================================
# Warning Reporting (non-fatal diagnostics)
# ============================================================================

def tc_warning(tc: TypecheckState, message: String, line: Int, col: Int): Void
  tc.errs.warnings.push(message)
  tc.errs.warning_lines.push(line)
  tc.errs.warning_cols.push(col)
  tc.errs.warning_files.push(tc.current_file)
  tc.errs.warning_expansion_idxs.push(0)
end

## Warning variant that reads line/col + expansion_idx from a node.
## Parallels `tc_error_at`. Use at any tc_warning site where a node
## handle is already in scope.
def tc_warning_at(tc: TypecheckState, message: String, s: ast::AstStorage, h: AstNodeId): Void
  tc.errs.warnings.push(message)
  tc.errs.warning_lines.push(ast::ast_get_line(s, h))
  tc.errs.warning_cols.push(ast::ast_get_col(s, h))
  tc.errs.warning_files.push(tc.current_file)
  tc.errs.warning_expansion_idxs.push(ast::ast_get_expansion(s, h))
end

def tc_warning_count(tc: TypecheckState): Int = tc.errs.warnings.size

def tc_emit_warnings(tc: TypecheckState, filename: String, src_lines: Vec<String>): Void
  var cached_file = filename
  var cached_lines = src_lines
  var count = tc_warning_count(tc)
  for i in 0..count
    var msg = tc.errs.warnings[i]
    var line = tc.errs.warning_lines[i]
    var col = tc.errs.warning_cols[i]
    var warn_file = tc.errs.warning_files[i]
    var diag_file = warn_file
    var diag_lines = src_lines
    if str_byte_len(warn_file) > 0 and warn_file != filename
      if warn_file == cached_file
        diag_lines = cached_lines
      else
        var file_src = fio_read(warn_file)
        if str_byte_len(file_src) > 0
          diag_lines = diagnostic::diag_split_source(file_src)
          cached_file = warn_file
          cached_lines = diag_lines
        end
      end
    else
      diag_file = filename
    end
    var d = diagnostic::diag_new(diagnostic::DIAG_WARNING, "ARENA", msg, diag_file, line, col)
    diagnostic::diag_set_source(d, diag_lines)
    if i < tc.errs.warning_expansion_idxs.size
      var w_exp = tc.errs.warning_expansion_idxs[i]
      diagnostic::diag_set_expansion(d, w_exp)
      # The chain renderer lives in `ast.qz` (needs the `_ast_exp_*`
      # store); push its lines as plain notes so the std formatters
      # render them. See `_macro_attach_expansion_chain` for the rationale.
      if w_exp > 0
        var w_chain = ast::ast_expansion_notes(w_exp)
        for wci in 0..w_chain.size
          diagnostic::diag_add_note(d, "note: #{w_chain[wci]}")
        end
      end
    end
    diagnostic::diag_emit(d)
  end
end

# ============================================================================
# Arena Safety Tracking
# ============================================================================

def tc_arena_reset(tc: TypecheckState): Void
  vec_clear(tc.safety.arena_var_names)
  vec_clear(tc.safety.arena_var_sources)
  vec_clear(tc.safety.arena_var_lines)
  vec_clear(tc.safety.arena_invalidated)
  vec_clear(tc.safety.arena_invalidated_lines)
  vec_clear(tc.safety.arena_scoped_arenas)
end

def tc_arena_track_alloc(tc: TypecheckState, var_name: String, arena_name: String, line: Int): Void
  tc.safety.arena_var_names.push(var_name)
  tc.safety.arena_var_sources.push(arena_name)
  tc.safety.arena_var_lines.push(line)
end

def tc_arena_invalidate(tc: TypecheckState, arena_name: String, line: Int): Void
  for i in 0..tc.safety.arena_invalidated.size
    if tc.safety.arena_invalidated[i] == arena_name
      # Update invalidation line for repeated reset/destroy (e.g. in loops)
      tc.safety.arena_invalidated_lines[i] = line
      return
    end
  end
  tc.safety.arena_invalidated.push(arena_name)
  tc.safety.arena_invalidated_lines.push(line)
end

def tc_arena_check_use(tc: TypecheckState, var_name: String, line: Int, col: Int): Void can Diag
  for i in 0..tc.safety.arena_var_names.size
    if tc.safety.arena_var_names[i] == var_name
      var source = tc.safety.arena_var_sources[i]
      var alloc_line = tc.safety.arena_var_lines[i]
      for j in 0..tc.safety.arena_invalidated.size
        if tc.safety.arena_invalidated[j] == source
          var inv_line = tc.safety.arena_invalidated_lines[j]
          # A use is unsafe only if BOTH the allocation predates this
          # invalidation (so the invalidation freed it — not a re-alloc after a
          # reset, which is valid) AND the use itself occurs after the
          # invalidation. Checking only `alloc_line < inv_line` (always true for
          # alloc-then-destroy) relied on walk order to gate it — but inside
          # lambda bodies (`it(...) do -> ... end`) invalidations are recorded
          # before uses are checked, so a use that textually precedes the
          # destroy was wrongly flagged. The `line > inv_line` clause makes the
          # check order-independent and semantically correct.
          if alloc_line < inv_line and line > inv_line
            error("QZ1401: use of arena-allocated variable '#{var_name}' after arena '#{source}' was invalidated", line, col)
            return
          end
        end
      end
    end
  end
end

def tc_arena_push_scope(tc: TypecheckState, arena_name: String): Void
  tc.safety.arena_scoped_arenas.push(arena_name)
end

def tc_arena_pop_scope(tc: TypecheckState): Void
  if tc.safety.arena_scoped_arenas.size > 0
    vec_pop(tc.safety.arena_scoped_arenas)
  end
end

def tc_arena_is_scoped(tc: TypecheckState, var_name: String): String
  for i in 0..tc.safety.arena_var_names.size
    if tc.safety.arena_var_names[i] == var_name
      var source = tc.safety.arena_var_sources[i]
      for j in 0..tc.safety.arena_scoped_arenas.size
        if tc.safety.arena_scoped_arenas[j] == source
          return source
        end
      end
    end
  end
  return ""
end

def tc_arena_propagate_alias(tc: TypecheckState, dest_name: String, src_name: String, line: Int): Void
  for i in 0..tc.safety.arena_var_names.size
    if tc.safety.arena_var_names[i] == src_name
      tc.safety.arena_var_names.push(dest_name)
      tc.safety.arena_var_sources.push(tc.safety.arena_var_sources[i])
      tc.safety.arena_var_lines.push(line)
      return
    end
  end
end

## Get field count for a struct.
##
## Parameters:
##   tc           - Type checker context
##   struct_index - Index from tc_lookup_struct
##
## Returns: Number of fields
def tc_struct_field_count(tc: TypecheckState, struct_index: Int): Int
  var struct_field_names = tc.registry.struct_field_names
  var field_names = struct_field_names[struct_index]
  return vec_size(field_names)
end

## Get number of required fields (fields without default values).
## Returns: Number of fields that must be provided at initialization
def tc_struct_required_field_count(tc: TypecheckState, struct_index: Int): Int
  var defaults = tc.registry.struct_field_defaults[struct_index]
  var total = vec_size(defaults)
  var required = 0
  for i in 0..total
    if defaults[i] == 0
      required += 1
    end
  end
  return required
end

## Get the field defaults vector for a struct (per-field AST node handles, 0 = no default).
def tc_struct_field_defaults(tc: TypecheckState, struct_index: Int): Vec<Int> = tc.registry.struct_field_defaults[struct_index]

## Get the type annotation string for a struct field.
## Returns: Field annotation string, or "" if not found
def tc_struct_field_annotation(tc: TypecheckState, struct_index: Int, field_name: String): String
  var struct_field_names = tc.registry.struct_field_names
  var struct_field_annotations = tc.registry.struct_field_annotations

  var field_names = struct_field_names[struct_index]
  var field_anns = struct_field_annotations[struct_index]

  var count = vec_size(field_names)
  for i in 0..count
    var name = field_names[i]
    return field_anns[i] if name == field_name
  end

  return ""
end

## Get the type params string for a struct.
## Returns: Type params string (e.g., "T, U") or "" if non-generic
def tc_struct_type_params(tc: TypecheckState, struct_index: Int): String = tc.registry.struct_type_params[struct_index]

## Get the type params string for a trait.
## Returns: Type params string (e.g., "T" or "K,V") or "" if non-generic
def tc_trait_type_params(tc: TypecheckState, trait_index: Int): String = tc.registry.trait_type_params[trait_index]

# ============================================================================
# Type Parsing
# ============================================================================

## Parse a type annotation string into a type kind.
## Handles: Int, Bool, String, Void, Char, Symbol, Array<T>, Fn(...), etc.
## Also handles union types: "Int | String" → type_constants$TYPE_UNION_BASE + index.
##
## Parameters:
##   tc         - Type checker context (for struct/enum lookup)
##   annotation - Type annotation string
##
## Returns: Type kind constant
def strip_borrow_prefix(name: String): String
  if str_byte_len(name) > 5
    if str_byte_at(name, 0) == '&' and str_byte_at(name, 1) == 'm' and str_byte_at(name, 2) == 'u' and str_byte_at(name, 3) == 't' and str_byte_at(name, 4) == ' '
      return str_byte_slice(name, 5, str_byte_len(name))
    end
  end
  if str_byte_len(name) > 1 and str_byte_at(name, 0) == '&'
    return str_byte_slice(name, 1, str_byte_len(name))
  end
  return name
end

## Check if a type annotation matches one of the function's type parameters.
## type_params_str is comma-separated: "T" or "T,U" or "T,U,V"
## Also handles bounded params: "T:Eq" or "T:Eq,U:Ord" — strips the bound.
## Returns 1 if annotation matches a type param name, 0 otherwise.
def tc_is_type_param(annotation: String, type_params_str: String): Int
  # Simple fast path: single type param with no comma
  if not str_contains(type_params_str, ",")
    # Strip bound if present (e.g., "T:Eq" -> "T")
    var colon_pos = __char_index(type_params_str, ':')
    var param_name = type_params_str
    if colon_pos > 0
      param_name = str_byte_slice(type_params_str, 0, colon_pos)
    end
    if annotation == param_name
      return 1
    end
    return 0
  end
  # Multiple type params: split on comma and check each
  var start = 0
  var len = str_byte_len(type_params_str)
  var i = 0
  while i <= len
    var at_end = i == len
    var is_comma = false
    if at_end == false
      is_comma = str_byte_at(type_params_str, i) == ','
    end
    if is_comma or at_end
      var part = str_byte_slice(type_params_str, start, i)
      # Strip bound if present
      var colon_pos = __char_index(part, ':')
      if colon_pos > 0
        part = str_byte_slice(part, 0, colon_pos)
      end
      if annotation == part
        return 1
      end
      start = i + 1
    end
    i += 1
  end
  return 0
end

## Phase 3b.next: tc_parse_type cache wrapper.
##
## The uncached recursive walker allocates substrings via str_byte_slice on every
## call (e.g. "Vec<Vec<Map<String, Int>>>" descends 4 levels, each allocating fresh
## substrings). Those substrings live forever in libc's heap. Self-compile measured
## typecheck phase at 5.4 GB and the leak was distributed across hundreds of
## functions proportionally to body size — exactly the shape of "per-statement
## substring churn in tc_parse_type".
##
## This wrapper caches the result by annotation string. Scope-independent
## annotations (primitives, structs, enums, Vec<T>, Map<K,V>, tuples, unions,
## intersections, Ptr/Channel/Fn, type aliases) are safe to cache — they resolve
## only against the global registry which is populated before body checking starts.
##
## Scope-dependent annotations are NOT cached:
##   - "forall a b. ..." — binds type vars in a local scope
##   - "impl Trait" — generates a fresh TYPE_STRUCT sentinel per call site
## These fall through to tc_parse_type_impl unconditionally.
##
## TYPE_ERROR results are not cached so that error paths (unknown types) keep
## reporting on every occurrence at the call site.
## P3.F.2: Find the starting index of the last ` can` marker in an Fn type
## annotation, or -1 if absent. The marker is the literal 4-byte sequence
## ' ', 'c', 'a', 'n' — guaranteed unambiguous because the parser emits
## exactly one `can` suffix per Fn type and any `Can` TYPE name would be
## PascalCase (uppercase 'C'). Returns the position of the leading space.
def _tc_find_last_can_marker(ann: String): Int
  var n = str_byte_len(ann)
  if n < 5
    return -1
  end
  var found = -1
  for i in 0..n - 3
    if str_byte_at(ann, i) == ' ' and str_byte_at(ann, i + 1) == 'c' and str_byte_at(ann, i + 2) == 'a' and str_byte_at(ann, i + 3) == 'n'
      if i + 4 == n
        found = i
      else
        var c4 = str_byte_at(ann, i + 4)
        if c4 == ' '
          found = i
        end
      end
    end
  end
  return found
end

## P3.F.2: Resolve the row portion of a parsed Fn `can` suffix into a row_id.
## Input: the substring AFTER the leading " can" marker. Trims whitespace.
## Accepts (mirrors parser grammar):
##   ""                  — bare (empty closed row)
##   " Label"            — single closed label
##   " | tail"           — tail-only open row
##   " Label | tail"     — label + tail
## Tail names resolve via `tc_func_row_var_lookup` — must be declared as
## a lowercase type-param on the enclosing function. Unknown tails fall
## back to a fresh erv (preserves compatibility with stray tail names).
def _tc_resolve_fn_can_suffix(tc: TypecheckState, suffix: String): Int
  var s = str_trim(suffix)
  var labels = vec_new()
  var tail_var = -1
  var pipe_idx = __char_index(s, '|')
  var label_part = s
  var tail_part = ""
  if pipe_idx >= 0
    label_part = str_trim(str_byte_slice(s, 0, pipe_idx))
    tail_part = str_trim(str_byte_slice(s, pipe_idx + 1, str_byte_len(s)))
  end
  # P3.F.2: same reinterpretation as the function-level attach does. A
  # single lowercase label that matches a declared row-var in the enclosing
  # function's env is a row-var tail, not a closed effect label.
  if str_byte_len(tail_part) == 0 and str_byte_len(label_part) > 0
    if typecheck_util::tc_name_is_row_var(label_part)
      if typecheck_util::tc_func_row_var_lookup(tc, label_part) > 0
        tail_part = label_part
        label_part = ""
      end
    end
  end
  if str_byte_len(label_part) > 0
    labels.push(string_intern::intern_id(tc.interner, label_part))
  end
  if str_byte_len(tail_part) > 0
    var bound_erv = typecheck_util::tc_func_row_var_lookup(tc, tail_part)
    if bound_erv > 0
      tail_var = bound_erv
    else
      tail_var = typecheck_util::tc_erv_fresh(tc)
    end
  end
  return typecheck_registry::tc_row_new(tc, labels, tail_var)
end

def tc_parse_type(tc: TypecheckState, annotation: String): Int
  var _cached = tc.parse_type_cache.get(annotation)
  if _cached is Some
    return _cached!
  end

  # Scope-dependent shapes — never cache
  if str_byte_len(annotation) > 7 and annotation.starts_with("forall ")
    return tc_parse_type_impl(tc, annotation)
  end
  if str_byte_len(annotation) > 5 and annotation.starts_with("impl ")
    return tc_parse_type_impl(tc, annotation)
  end
  # P3.F.2: Fn types with `can` rows resolve row-var tail names via the
  # current function's row-var env — a scope-dependent resolution. Two
  # different functions using `Fn(Int): Int can e` must get different
  # row-ids (one per function's e-erv), so we must NEVER cache.
  # HB-DOG.3 close-out: also resolve `type X = Fn(...) can e` aliases so
  # the cache-skip fires when the row-bearing type is referenced via alias.
  var _scope_dep = annotation
  var _scope_dep_alias = tc_lookup_type_alias(tc, annotation)
  if str_byte_len(_scope_dep_alias) > 0
    _scope_dep = _scope_dep_alias
  end
  if _scope_dep.starts_with("Fn(") and _tc_find_last_can_marker(_scope_dep) >= 0
    return tc_parse_type_impl(tc, annotation)
  end

  var _result = tc_parse_type_impl(tc, annotation)
  if _result != type_constants::TYPE_ERROR
    tc.parse_type_cache.set(annotation, _result)
  end
  return _result
end

def tc_parse_type_impl(tc: TypecheckState, annotation: String): Int can Diag
  # Strip leading '&' or '&mut ' for borrow types — borrows resolve to the same type
  if str_byte_len(annotation) > 1 and str_byte_at(annotation, 0) == '&'
    return tc_parse_type(tc, strip_borrow_prefix(annotation))
  end

  # QZ0953: sub-byte integer types u1..u7 / i1..i7 are only legal inside a
  # `binary {}` block or `packed struct(uN) ... end`. Outside those blocks
  # they have no bit position and are a type error.
  if str_byte_len(annotation) == 2
    var _sb0 = str_byte_at(annotation, 0)
    var _sb1 = str_byte_at(annotation, 1)
    if (_sb0 == 117 or _sb0 == 105) and _sb1 >= 49 and _sb1 <= 55
      error("QZ0953: sub-byte type '#{annotation}' is only legal inside a `binary {}` block or `packed struct(uN)`. Use Int at top level.", 0, 0)
      return type_constants::TYPE_ERROR
    end
  end

  # Handle forall type annotation (Rank-2 polymorphism)
  # Syntax: "forall a. Fn(a): a" or "forall a b. Fn(a, b): a"
  if str_byte_len(annotation) > 7 and annotation.starts_with("forall ")
    var forall_rest = str_byte_slice(annotation, 7, str_byte_len(annotation))
    # Find the dot separating vars from body
    var dot_pos = __char_index(forall_rest, '.')
    if dot_pos > 0
      var vars_str = str_byte_slice(forall_rest, 0, dot_pos)
      var body_str = str_byte_slice(forall_rest, dot_pos + 2, str_byte_len(forall_rest))
      # Parse variable names (space-separated)
      var var_names = vec_new<String>()
      var var_ids = vec_new()
      var vn_start = 0
      var vn_i = 0
      while vn_i <= str_byte_len(vars_str)
        if vn_i == str_byte_len(vars_str) or str_byte_at(vars_str, vn_i) == ' '
          if vn_i > vn_start
            var vname = str_byte_slice(vars_str, vn_start, vn_i)
            var_names.push(vname)
            var_ids.push(typecheck_util::tc_tv_fresh(tc))
          end
          vn_start = vn_i + 1
        end
        vn_i += 1
      end
      # Parse body type with quantified vars temporarily in scope
      typecheck_util::tc_enter_scope()
      for fa_i in 0..var_names.size
        typecheck_util::tc_scope_bind(tc, var_names[fa_i], var_ids[fa_i], 0, "")
      end
      var body_type = tc_parse_type(tc, body_str)
      tc_exit_scope(tc)
      return typecheck_util::tc_register_forall(tc, var_names, var_ids, body_type)
    end
  end

  # Handle impl Trait return type annotation — resolve to TYPE_STRUCT
  # The concrete type is resolved later in tc_function (Step 4).
  if str_byte_len(annotation) > 5 and annotation.starts_with("impl ")
    var impl_trait_name = str_byte_slice(annotation, 5, str_byte_len(annotation))
    # P3.F.3b: strip optional ` can ROW` suffix before trait lookup. The row
    # is resolved (populating the function's row-var env at the same time)
    # and currently just consumed — call-site propagation through
    # impl-Trait params arrives in F.3c. Stripping alone is enough to let
    # `def foo(src: impl Iterator<Int> can e) can e` parse and typecheck.
    var _impl_can_idx = _tc_find_last_can_marker(impl_trait_name)
    if _impl_can_idx >= 0
      var _impl_row_suffix = str_byte_slice(impl_trait_name, _impl_can_idx + 4, str_byte_len(impl_trait_name))
      _tc_resolve_fn_can_suffix(tc, _impl_row_suffix)
      impl_trait_name = str_byte_slice(impl_trait_name, 0, _impl_can_idx)
    end
    # Strip generic args for trait lookup: "Iterator<Int>" -> "Iterator"
    var impl_lt = __char_index(impl_trait_name, '<')
    var impl_base = impl_trait_name
    if impl_lt > 0
      impl_base = str_byte_slice(impl_trait_name, 0, impl_lt)
    end
    var trait_lookup = typecheck_registry::tc_lookup_trait(tc, impl_base)
    if trait_lookup.is_found() == 0
      error("QZ0160: Unknown trait '#{impl_base}' in impl return type", 0, 0)
      return type_constants::TYPE_ERROR
    end
    return type_constants::TYPE_STRUCT
  end

  # ===== Tuple type parsing: (Int, String, Bool) =====
  if str_byte_len(annotation) > 2 and str_byte_at(annotation, 0) == '('
    # Parse comma-separated element types between parens
    var inner = str_byte_slice(annotation, 1, str_byte_len(annotation) - 1)
    var elem_types = vec_new()
    var depth = 0
    var start = 0
    for i in 0..str_byte_len(inner)
      var c = str_byte_at(inner, i)
      if c == '<' or c == '('
        depth += 1
      elsif c == '>' or c == ')'
        depth -= 1
      elsif c == ',' and depth == 0
        var part = str_byte_slice(inner, start, i).trim()
        if str_byte_len(part) > 0
          elem_types.push(tc_parse_type(tc, part))
        end
        start = i + 1
      end
    end
    # Last element
    var last = str_byte_slice(inner, start, str_byte_len(inner)).trim()
    if str_byte_len(last) > 0
      elem_types.push(tc_parse_type(tc, last))
    end
    if elem_types.size > 0
      return typecheck_util::tc_make_tuple_type(tc, elem_types)
    end
    return type_constants::TYPE_VOID
  end

  # ===== Union type parsing: A | B | C =====
  # Split on '|' at top-level (respect <> nesting depth).
  # Must come before alias resolution so "Int | String" isn't mistaken for a name.
  var union_parts = typecheck_registry::tc_split_type_union(annotation)
  if union_parts.size > 1
    return typecheck_registry::tc_register_union(tc, union_parts)
  end

  # ===== Intersection type parsing: A & B & C (Phase 8F) =====
  # Split on '&' at top-level (respect <>{} nesting depth).
  var inter_parts = typecheck_registry::tc_split_type_intersection(annotation)
  if inter_parts.size > 1
    var inter_result = typecheck_registry::tc_register_intersection(tc, inter_parts)
    if inter_result == type_constants::TYPE_NEVER
      error("QZ0150: Impossible intersection type '#{annotation}' — no value can satisfy all members", 0, 0)
    end
    return inter_result
  end

  # Check for type alias first (aliases expand to their target types)
  var aliased_type = tc_lookup_type_alias(tc, annotation)
  if str_byte_len(aliased_type) > 0
    # Guard against infinite alias resolution (defense-in-depth)
    if aliased_type == annotation
      return type_constants::TYPE_ERROR
    end
    return tc_parse_type(tc, aliased_type)
  end
  
  # Check for newtype — return distinct type ID
  var newtype_id = tc_lookup_newtype_id(tc, annotation)
  if newtype_id > 0
    return newtype_id
  end

  # Handle dotted module-qualified type names: module.Type -> module$Type
  var dot_idx = __char_index(annotation, '.')
  if dot_idx > 0
    var module_name = str_byte_slice(annotation, 0, dot_idx)
    var type_name = str_byte_slice(annotation, dot_idx + 1, str_byte_len(annotation))
    var qualified = "#{module_name}$#{type_name}"
    # Check struct
    if typecheck_registry::tc_lookup_struct(tc, qualified).is_found()
      return type_constants::TYPE_STRUCT
    end
    # Check enum
    if typecheck_registry::tc_lookup_enum(tc, qualified).is_found()
      return type_constants::TYPE_ENUM
    end
    # Check newtype
    var qual_newtype_id = tc_lookup_newtype_id(tc, qualified)
    if qual_newtype_id > 0
      return qual_newtype_id
    end
  end

  # Primitive types
  return type_constants::TYPE_INT if annotation == "Int"
  return type_constants::TYPE_BOOL if annotation == "Bool"
  return type_constants::TYPE_STRING if annotation == "String"
  return type_constants::TYPE_VOID if annotation == "Void"
  # Never (!) — the bottom type. Writable as an explicit return annotation for
  # divergent functions (`def f(): Never` whose body must `panic`/`exit`/loop).
  # TYPE_NEVER is a subtype of every type; the body-vs-return check enforces
  # divergence. Internal-only producers are exit/panic/unreachable.
  return type_constants::TYPE_NEVER if annotation == "Never"
  return type_constants::TYPE_INT if annotation == "Char"
  return type_constants::TYPE_SYMBOL if annotation == "Symbol"
  return type_constants::TYPE_REGEX if annotation == "Regex"
  return type_constants::TYPE_BYTE if annotation == "Byte"

  # FFI C Type aliases
  return type_constants::TYPE_CINT if annotation == "CInt"
  return type_constants::TYPE_CCHAR if annotation == "CChar"
  return type_constants::TYPE_CPTR if annotation == "CPtr"
  # CPtr<T> - parameterized pointer
  if str_byte_len(annotation) > 5
    if annotation.starts_with("CPtr<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        return tc_make_ptype(tc, type_constants::TYPE_CPTR, tc_parse_type(tc, inner), 0)
      end
      return type_constants::TYPE_CPTR
    end
  end
  return type_constants::TYPE_CSIZE if annotation == "CSize"
  return type_constants::TYPE_CFLOAT if annotation == "CFloat"
  return type_constants::TYPE_CDOUBLE if annotation == "CDouble"

  # Native float types
  return type_constants::TYPE_F64 if annotation == "F64"
  return type_constants::TYPE_F32 if annotation == "F32"

  # Fixed-width integer types (sized storage)
  return type_constants::TYPE_I8 if annotation == "I8"
  return type_constants::TYPE_I16 if annotation == "I16"
  return type_constants::TYPE_I32 if annotation == "I32"
  return type_constants::TYPE_U8 if annotation == "U8"
  return type_constants::TYPE_U16 if annotation == "U16"
  return type_constants::TYPE_U32 if annotation == "U32"
  return type_constants::TYPE_INT if annotation == "I64"
  return type_constants::TYPE_INT if annotation == "U64"
  return type_constants::TYPE_INT if annotation == "usize"

  # NonZero — nominal i64 scalar, value != 0 (B.10 §14 N2). Distinct from Int so
  # bare ints (and nil, which is Int) can't be assigned — see tc_types_compatible.
  return type_constants::TYPE_NONZERO if annotation == "NonZero"

  # Check for struct type — B.15d/N3.1 step-4a-2: return the per-struct nominal
  # id (STRUCT_TYPE_BASE + struct_idx) instead of the bare TYPE_STRUCT collapse.
  # Gives bare struct annotations real identity (unwrap/field-access/tc_type_name
  # now carry the concrete struct); the i64 coercion net still matches them until
  # 4c, so no program is newly rejected. Cross-module portability handled by the
  # qzmod remap struct-range normalization (§11.13).
  var _struct_lr = typecheck_registry::tc_lookup_struct(tc, annotation)
  if _struct_lr.is_found()
    return tc_struct_type_id(_struct_lr.unwrap())
  end

  # Check for enum type
  return type_constants::TYPE_ENUM if typecheck_registry::tc_lookup_enum(tc, annotation).is_found()

  # Array<T> / Vec<T> - unified, parameterized
  return type_constants::TYPE_VEC if annotation == "Array"
  return type_constants::TYPE_VEC if annotation == "Vec"
  if str_byte_len(annotation) > 6
    if annotation.starts_with("Array<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var elem_type = tc_parse_type(tc, inner)
        # Use struct/enum registry index as arg2 to distinguish Vec<Point> from Vec<Triple>
        var struct_idx = 0
        if tc_is_struct_type(elem_type)
          var sr = typecheck_registry::tc_lookup_struct(tc, inner)
          if sr.is_found()
            struct_idx = sr.unwrap() + 1
          end
        elsif elem_type == type_constants::TYPE_ENUM
          var er = typecheck_registry::tc_lookup_enum(tc, inner)
          if er.is_found()
            struct_idx = er.unwrap() + 1
          end
        end
        var ptype_id = tc_make_ptype(tc, type_constants::TYPE_VEC, elem_type, struct_idx)
        # Carry struct/enum name through ptype for typed retrieval
        if struct_idx > 0
          tc_ptype_set_name(tc, ptype_id, inner)
        end
        return ptype_id
      end
      return type_constants::TYPE_VEC
    end
  end
  if str_byte_len(annotation) > 4
    if annotation.starts_with("Vec<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var elem_type = tc_parse_type(tc, inner)
        # Use struct/enum registry index as arg2 to distinguish Vec<Point> from Vec<Triple>
        var struct_idx = 0
        if tc_is_struct_type(elem_type)
          var sr = typecheck_registry::tc_lookup_struct(tc, inner)
          if sr.is_found()
            struct_idx = sr.unwrap() + 1
          end
        elsif elem_type == type_constants::TYPE_ENUM
          var er = typecheck_registry::tc_lookup_enum(tc, inner)
          if er.is_found()
            struct_idx = er.unwrap() + 1
          end
        end
        var ptype_id = tc_make_ptype(tc, type_constants::TYPE_VEC, elem_type, struct_idx)
        # Carry struct/enum name through ptype for typed retrieval
        if struct_idx > 0
          tc_ptype_set_name(tc, ptype_id, inner)
        end
        return ptype_id
      end
      return type_constants::TYPE_VEC
    end
  end

  # Slice<T> / SliceMut<T> — fat-pointer view types (Tier 4 #24).
  # Runtime layout: {ptr, len} — 16 bytes. Shares struct/enum index tracking
  # with Vec<T> so element-type discrimination works uniformly.
  return type_constants::TYPE_SLICE if annotation == "Slice"
  return type_constants::TYPE_SLICE_MUT if annotation == "SliceMut"
  if str_byte_len(annotation) > 6
    if annotation.starts_with("Slice<")
      var s_inner = tc_extract_element_type(annotation)
      if str_byte_len(s_inner) > 0
        var s_elem = tc_parse_type(tc, s_inner)
        var s_struct_idx = 0
        if tc_is_struct_type(s_elem)
          var s_sr = typecheck_registry::tc_lookup_struct(tc, s_inner)
          if s_sr.is_found()
            s_struct_idx = s_sr.unwrap() + 1
          end
        elsif s_elem == type_constants::TYPE_ENUM
          var s_er = typecheck_registry::tc_lookup_enum(tc, s_inner)
          if s_er.is_found()
            s_struct_idx = s_er.unwrap() + 1
          end
        end
        var s_ptype_id = tc_make_ptype(tc, type_constants::TYPE_SLICE, s_elem, s_struct_idx)
        if s_struct_idx > 0
          tc_ptype_set_name(tc, s_ptype_id, s_inner)
        end
        return s_ptype_id
      end
      return type_constants::TYPE_SLICE
    end
  end
  if str_byte_len(annotation) > 9
    if annotation.starts_with("SliceMut<")
      var sm_inner = tc_extract_element_type(annotation)
      if str_byte_len(sm_inner) > 0
        var sm_elem = tc_parse_type(tc, sm_inner)
        var sm_struct_idx = 0
        if tc_is_struct_type(sm_elem)
          var sm_sr = typecheck_registry::tc_lookup_struct(tc, sm_inner)
          if sm_sr.is_found()
            sm_struct_idx = sm_sr.unwrap() + 1
          end
        elsif sm_elem == type_constants::TYPE_ENUM
          var sm_er = typecheck_registry::tc_lookup_enum(tc, sm_inner)
          if sm_er.is_found()
            sm_struct_idx = sm_er.unwrap() + 1
          end
        end
        var sm_ptype_id = tc_make_ptype(tc, type_constants::TYPE_SLICE_MUT, sm_elem, sm_struct_idx)
        if sm_struct_idx > 0
          tc_ptype_set_name(tc, sm_ptype_id, sm_inner)
        end
        return sm_ptype_id
      end
      return type_constants::TYPE_SLICE_MUT
    end
  end

  # Map<K,V> - unified parameterized map (v5.27)
  return type_constants::TYPE_MAP if annotation == "Map"
  if str_byte_len(annotation) > 4
    if annotation.starts_with("Map<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var key_str = tc_extract_nth_type_arg(inner, 0)
        var val_str = tc_extract_nth_type_arg(inner, 1)
        if str_byte_len(key_str) > 0
          if str_byte_len(val_str) > 0
            var map_key_type = tc_parse_type(tc, key_str)
            # Generic type-param fallback: K/V resolve to TYPE_ERROR for free
            # generic functions because params aren't bound in this scope.
            # Defaultise to TYPE_INT so the hashable check passes — existential
            # erasure makes runtime values i64 regardless. Mirrors the for-in
            # fallback added in Phase 4.B.9 slice 3.
            if map_key_type == type_constants::TYPE_ERROR
              map_key_type = type_constants::TYPE_INT
            end
            var key_hashable = typecheck_helpers::tc_type_is_hashable(tc, map_key_type)
            var struct_reason = ""
            # For struct types, additionally check if all fields are hashable.
            # Use tc_is_struct_type — the same predicate the map_new expression
            # path uses (typecheck_expr_handlers.qz) — so a plain value-layout
            # struct key (id in [STRUCT_TYPE_BASE, PTYPE_BASE)) is accepted in a
            # type ANNOTATION exactly as it is in a map_new<Struct, V>() call.
            # A bare TYPE_STRUCT ptype-base (parameterized Foo<T>) is also handled.
            if not key_hashable and tc_is_struct_type(map_key_type)
              key_hashable = typecheck_helpers::tc_struct_is_hashable(tc, key_str)
              if not key_hashable
                struct_reason = typecheck_helpers::tc_struct_hashable_rejection(tc, key_str)
              end
            end
            if not key_hashable
              var reason = struct_reason
              if str_byte_len(reason) == 0
                reason = typecheck_helpers::tc_hashable_rejection_reason(tc, map_key_type)
              end
              error("Map key type '#{key_str}' is not hashable: #{reason}", 0, 0)
            end
            var val_type = tc_parse_type(tc, val_str)
            if val_type == type_constants::TYPE_ERROR
              val_type = type_constants::TYPE_INT
            end
            var ptype_id = tc_make_ptype(tc, type_constants::TYPE_MAP, map_key_type, val_type)
            # Store struct key name for codegen dispatch
            if tc_is_struct_type(map_key_type)
              tc_ptype_set_name(tc, ptype_id, key_str)
            end
            return ptype_id
          end
        end
      end
      return type_constants::TYPE_MAP
    end
  end

  # Ptr<T> - typed pointer
  return type_constants::TYPE_PTR if annotation == "Ptr"
  if str_byte_len(annotation) > 4
    if annotation.starts_with("Ptr<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        return tc_make_ptype(tc, type_constants::TYPE_PTR, tc_parse_type(tc, inner), 0)
      end
      return type_constants::TYPE_PTR
    end
  end

  # Channel<T> - typed channel
  return type_constants::TYPE_CHANNEL if annotation == "Channel"
  if str_byte_len(annotation) > 8
    if annotation.starts_with("Channel<")
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        return tc_make_ptype(tc, type_constants::TYPE_CHANNEL, tc_parse_type(tc, inner), 0)
      end
      return type_constants::TYPE_CHANNEL
    end
  end

  # AtomicInt - lock-free single-word atomic counter (D.10 Phase 2).
  # Mirror of the Channel pattern above; lets `extend AtomicInt def new(...) end`
  # parse and `var a: AtomicInt = atomic_new(0)` typecheck. The companion
  # reverse mapping lives at tc_type_name (TYPE_ATOMIC → "AtomicInt").
  return type_constants::TYPE_ATOMIC if annotation == "AtomicInt"

  # QZ0220 follow-on: built-in heap/runtime types that have user-facing
  # names + a TYPE_<kind> constant but no annotation handler. Before this,
  # `def f(sb: StringBuilder)` silently fell through to TYPE_ERROR →
  # existential-erase to Int, masking typos and gating extend-method
  # registration on these types. All erase to i64 at runtime regardless;
  # this is purely for the annotation surface.
  return type_constants::TYPE_STRINGBUILDER if annotation == "StringBuilder"
  return type_constants::TYPE_SET if annotation == "Set"
  return type_constants::TYPE_RANGE if annotation == "Range"
  return type_constants::TYPE_INTMAP if annotation == "IntMap"
  return type_constants::TYPE_HASHMAP if annotation == "HashMap"
  return type_constants::TYPE_MUTEX if annotation == "Mutex"
  return type_constants::TYPE_ARENA if annotation == "Arena"
  return type_constants::TYPE_POOL if annotation == "Pool"
  return type_constants::TYPE_ARENAPOOL if annotation == "ArenaPool"
  return type_constants::TYPE_TASK if annotation == "Task"
  return type_constants::TYPE_TASK_GROUP if annotation == "TaskGroup"
  return type_constants::TYPE_FUTURE if annotation == "Future"

  # Fn(A, B): C [@pure|@io|@suspend] [can ROW] - function type with optional
  # legacy effect bound and/or P3.F Piezo `can` row.
  if str_byte_len(annotation) > 2
    if annotation.starts_with("Fn(")
      # P3.F.2: peel off trailing ` can ROW` (Piezo era). ROW is restricted
      # by the parser to: bare (empty closed), single Label, `| tail`, or
      # `Label | tail`. Labels resolve to effect-name intern IDs; tail name
      # resolves via the function-scope row-var env (F.1).
      var fn_ann = annotation
      var fn_can_row_id = -1
      var _fn_can_idx = _tc_find_last_can_marker(fn_ann)
      if _fn_can_idx >= 0
        var _fn_row_suffix = str_byte_slice(fn_ann, _fn_can_idx + 4, str_byte_len(fn_ann))
        fn_ann = str_byte_slice(annotation, 0, _fn_can_idx)
        fn_can_row_id = _tc_resolve_fn_can_suffix(tc, _fn_row_suffix)
      end
      # Check for effect bound suffix: @pure, @io, @suspend, or @E (effect variable)
      var fn_effect_bound = 0
      if fn_ann.ends_with(" @pure")
        fn_effect_bound = 1
        fn_ann = str_byte_slice(fn_ann, 0, str_byte_len(fn_ann) - 6)
      elsif fn_ann.ends_with(" @io")
        fn_effect_bound = 2
        fn_ann = str_byte_slice(fn_ann, 0, str_byte_len(fn_ann) - 4)
      elsif fn_ann.ends_with(" @suspend")
        fn_effect_bound = 4
        fn_ann = str_byte_slice(fn_ann, 0, str_byte_len(fn_ann) - 9)
      else
        # Check for effect variable: @NAME where NAME is not a keyword
        # Effect variables accept any effect (they TRACK, not CONSTRAIN)
        # fn_effect_bound = -1 means "effect variable — skip enforcement"
        # Find last " @" in annotation
        var at_idx = -1
        for _ei in 0..str_byte_len(fn_ann) - 1
          if str_byte_at(fn_ann, _ei) == ' ' and str_byte_at(fn_ann, _ei + 1) == '@'
            at_idx = _ei
          end
        end
        if at_idx > 0
          var eff_name = str_byte_slice(fn_ann, at_idx + 2, str_byte_len(fn_ann))
          if str_byte_len(eff_name) > 0
            # It's an effect variable — strip the suffix and mark as variable
            fn_effect_bound = -1
            fn_ann = str_byte_slice(fn_ann, 0, at_idx)
          end
        end
      end
      var fn_pc = tc_fn_annotation_param_count(tc, fn_ann)
      var fn_ret = tc_fn_annotation_return_type(tc, fn_ann)
      var fn_id = typecheck_registry::tc_register_fn_type(tc, fn_ann, fn_pc, fn_ret)
      # Store effect bound if present
      if fn_effect_bound > 0 and fn_id < tc.registry.fn_type_effect_bounds.size
        tc.registry.fn_type_effect_bounds[fn_id] = fn_effect_bound
      end
      # P3.F.2: attach `can` row if one was parsed.
      if fn_can_row_id >= 0
        typecheck_registry::tc_fn_type_set_can_row(tc, fn_id, fn_can_row_id)
      end
      # T3c.1 Phase 3: Populate structured param types if not already done
      if tc.registry.fn_type_param_types[fn_id].size == 0 and fn_pc > 0
        var fn_pt = vec_new()
        for fp_i in 0..fn_pc
          var p_str = tc_fn_annotation_nth_param_str(tc, fn_ann, fp_i)
          if str_byte_len(p_str) > 0
            fn_pt.push(tc_parse_type(tc, p_str))
          else
            fn_pt.push(type_constants::TYPE_INT)
          end
        end
        tc.registry.fn_type_param_types[fn_id] = fn_pt
      end
      return tc_make_ptype(tc, type_constants::TYPE_FUNCTION, fn_id, 0)
    end
  end

  # Generic type lookup: Foo<T>, Foo<Int, String>, etc.
  # Extract base name before '<' and look up as struct, enum, or built-in
  var open_idx = __char_index(annotation, '<')
  if open_idx > 0
    var base_name = str_byte_slice(annotation, 0, open_idx)
    # Convert dotted module names to dollar-prefixed: option.Maybe → option$Maybe
    var dot_idx = __char_index(base_name, '.')
    if dot_idx > 0
      var mod_part = str_byte_slice(base_name, 0, dot_idx)
      var type_part = str_byte_slice(base_name, dot_idx + 1, str_byte_len(base_name))
      base_name = "#{mod_part}$#{type_part}"
    end
    # Built-in parameterized types
    if base_name == "Option"
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        return tc_make_ptype(tc, type_constants::TYPE_OPTION, tc_parse_type(tc, inner), 0)
      end
      return type_constants::TYPE_OPTION
    end
    if base_name == "Result"
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var ok_str = tc_extract_nth_type_arg(inner, 0)
        var err_str = tc_extract_nth_type_arg(inner, 1)
        if str_byte_len(ok_str) > 0
          if str_byte_len(err_str) > 0
            return tc_make_ptype(tc, type_constants::TYPE_RESULT, tc_parse_type(tc, ok_str), tc_parse_type(tc, err_str))
          end
        end
      end
      return type_constants::TYPE_RESULT
    end
    if base_name == "Channel"
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        return tc_make_ptype(tc, type_constants::TYPE_CHANNEL, tc_parse_type(tc, inner), 0)
      end
      return type_constants::TYPE_CHANNEL
    end
    # User-defined generic structs/enums
    if typecheck_registry::tc_lookup_struct(tc, base_name).is_found()
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var _struct_ptype = tc_make_ptype(tc, type_constants::TYPE_STRUCT, tc_parse_type(tc, inner), 0)
        # QZ0200_DIAG_FORMATS_STRUCT_PTYPES_AS_UNKNOWN: stamp the outer struct
        # name onto the ptype so tc_type_name_full can render "Box<Inner>"
        # instead of "unknown" in QZ0200 diagnostics.
        tc_ptype_set_name(tc, _struct_ptype, base_name)
        return _struct_ptype
      end
      return type_constants::TYPE_STRUCT
    end
    if typecheck_registry::tc_lookup_enum(tc, base_name).is_found()
      var inner = tc_extract_element_type(annotation)
      if str_byte_len(inner) > 0
        var _enum_arg_type = tc_parse_type(tc, inner)
        var _enum_ptype = tc_make_ptype(tc, type_constants::TYPE_ENUM, _enum_arg_type, 0)
        # Attach the inner type's source name to the ptype so match-arm
        # pattern binding can recover the struct identity. Without this,
        # `ListEvent<Card>::Selected(c)` binds c with bare TYPE_STRUCT and
        # no struct_name, breaking c.field access. Mirrors the Vec<T> path
        # at lines 1339-1343.
        if str_byte_len(inner) > 0
          tc_ptype_set_name(tc, _enum_ptype, inner)
        end
        return _enum_ptype
      end
      return type_constants::TYPE_ENUM
    end
  end

  # Record type: { field: Type, ... } — anonymous structural type (v5.25 Phase 8)
  # Open record: { field: Type | .. } — row-polymorphic (ROW Phase 2)
  # Returns registered TYPE_RECORD_BASE + index for structural matching.
  if str_byte_len(annotation) > 3
    if annotation.starts_with("{ ")
      if annotation.ends_with("| .. }")
        # Open record — strip "| .. }" suffix, parse fields, register with row var
        var open_inner = str_byte_slice(annotation, 0, str_byte_len(annotation) - 6)
        open_inner = "#{str_trim(open_inner)} }"
        var parsed = typecheck_registry::tc_parse_record_fields(open_inner)
        return typecheck_registry::tc_register_open_record(tc, parsed.names, parsed.types)
      end
      var parsed = typecheck_registry::tc_parse_record_fields(annotation)
      return typecheck_registry::tc_register_record(tc, parsed.names, parsed.types)
    end
  end

  # Self type alias: resolves to the implementing type inside impl/trait blocks.
  if annotation == "Self" and str_byte_len(tc.scope.impl_self_type) > 0
    return tc_parse_type(tc, tc.scope.impl_self_type)
  end

  # Check if annotation matches a trait type parameter currently in scope.
  # During trait method signature parsing, g_trait_type_params holds "T" or "T,U".
  # Type params erase to Int (i64) in the existential type model.
  if str_byte_len(tc.scope.trait_type_params) > 0
    if tc_is_type_param(annotation, tc.scope.trait_type_params)
      return type_constants::TYPE_INT
    end
  end

  # Check if annotation matches a registered protocol name
  var proto_idx = typecheck_registry::tc_lookup_protocol(tc, annotation)
  if proto_idx >= 0
    return type_constants::PROTOCOL_BASE + proto_idx
  end

  # Check for generic protocol: "Echo<Int>" → base "Echo", args "Int"
  var popen = __char_index(annotation, '<')
  if popen > 0
    var proto_base = str_byte_slice(annotation, 0, popen)
    var proto_gidx = typecheck_registry::tc_lookup_protocol(tc, proto_base)
    if proto_gidx >= 0
      return type_constants::PROTOCOL_BASE + proto_gidx
    end
  end

  # Generic newtype: "Secret<Int>" → base "Secret" (registered newtype) + ptype-wrap
  # the inner type. Built-in generics (Vec/Map/Option/Result/CPtr/Channel/...)
  # short-circuited above; this is the user-defined-generic-newtype fallback.
  # Strict by construction: ptype-form newtype ids never auto-unwrap to the
  # wrapped type (only bare newtypes in 1000..1999 do — see tc_types_match).
  # That strictness is the property NET.4's Secret<T> relies on.
  if popen > 0
    var nt_base_name = str_byte_slice(annotation, 0, popen)
    var nt_gid = tc_lookup_newtype_id(tc, nt_base_name)
    if nt_gid > 0
      var nt_inner_ann = tc_extract_element_type(annotation)
      if str_byte_len(nt_inner_ann) > 0
        var nt_inner_type = tc_parse_type(tc, nt_inner_ann)
        if nt_inner_type != type_constants::TYPE_ERROR
          var nt_ptype_id = tc_make_ptype(tc, nt_gid, nt_inner_type, 0)
          # Carry inner annotation through for diagnostic formatting.
          tc_ptype_set_name(tc, nt_ptype_id, nt_inner_ann)
          return nt_ptype_id
        end
      end
      # Fall through to bare-newtype id if inner parse failed; this preserves
      # the existing behavior for cases like `Secret` (no <…>) elsewhere.
      return nt_gid
    end
  end

  return type_constants::TYPE_ERROR
end

# ============================================================================
# Type Comparison and Names
# ============================================================================

## Check if two type kinds are strictly equal.
##
## Parameters:
##   t1 - First type kind
##   t2 - Second type kind
##
## Returns: true if equal
def tc_types_equal(t1: TypeId, t2: TypeId): Bool = t1 == t2

## Check if two types are compatible (allows unknown to match anything).
##
## Parameters:
##   t1 - First type kind
##   t2 - Second type kind
##
## Returns: true if compatible
def tc_types_match(tc: TypecheckState, t1: TypeId, t2: TypeId): Bool
  if t1 == type_constants::TYPE_ERROR
    return true
  end
  if t2 == type_constants::TYPE_ERROR
    return true
  end

  # Never (bottom type) matches everything — divergent paths
  if t1 == type_constants::TYPE_NEVER or t2 == type_constants::TYPE_NEVER
    return true
  end

  # Item 2 (enum-access payload): a value of UNKNOWN type is unconstrained —
  # it satisfies any expected type, exactly like TYPE_ERROR above. This is the
  # "got unknown" side: `var r = Result::Err(99)` now carries
  # `Result<UNKNOWN, Int>`, so `if r is Ok(v)` binds `v: UNKNOWN`; a subsequent
  # `return v` (or other concrete use) must not spuriously mismatch — the Ok
  # payload is genuinely unknown at an Err construction, not wrong. Mirrored on
  # both sides because UNKNOWN==0 is the bottom-of-information sentinel wherever
  # it appears (NOT a type variable — those are NEGATIVE, tc_tv_is_var: t < 0 —
  # so this does not loosen generic binding). Scoped to the literal 0 sentinel,
  # so nominal struct/enum matching is untouched.
  if t1 == type_constants::TYPE_UNKNOWN or t2 == type_constants::TYPE_UNKNOWN
    return true
  end

  # Exact match (interned ptypes with same base+args have same ID)
  if t1 == t2
    return true
  end

  # STRICT_NEWTYPES — a strict newtype refuses implicit conversion across
  # the boundary, BUT same-base matching is allowed so generic-arg binding
  # works (`secret_unwrap<Int>(s)` where the registered param is the bare
  # `Secret` id — T-unbound falls through to bare per tc_parse_type line
  # 1777 — and the actual is `Secret<Int>` ptype). Two flavours:
  #   1. Bare strict vs same-base ptype strict: accept (binds T).
  #   2. Both ptype strict off the same base: accept iff inner args
  #      match (covers `Secret<T>` vs `Secret<Int>` if both ever form
  #      ptypes, and `Secret<Int>` vs `Secret<Int>` defensively even
  #      though exact-match catches it).
  # Crossing the boundary in any other direction still requires the
  # dedicated `as_type<T>(v)` intrinsic. See
  # docs/design/STRICT_NEWTYPES_DESIGN.md and
  # docs/bugs/STRICT_NEWTYPES_GENERIC_BINDING.md.
  if tc_is_strict_newtype(tc, t1) or tc_is_strict_newtype(tc, t2)
    # Bare strict vs same-base strict ptype — generic binding for the
    # T-unbound form of `secret_unwrap<T>(s: Secret<T>)`.
    if tc_is_ptype(t1)
      if tc_ptype_base(tc, t1) == t2
        return true
      end
    end
    if tc_is_ptype(t2)
      if tc_ptype_base(tc, t2) == t1
        return true
      end
    end
    # Both ptype strict off the same newtype base — match inner args by
    # strict id equality. NOT via recursive tc_types_match: that would
    # admit `Secret<String>` against `Secret<Int>` via the
    # tc_is_i64_type existential-erasure path further down (both
    # TYPE_STRING and TYPE_INT are i64-compatible). For strict newtypes
    # we want exact-id equivalence on the inner, with TYPE_ERROR
    # tolerated for error-recovery / generic-T inference paths.
    if tc_is_ptype(t1)
      if tc_is_ptype(t2)
        var snb1 = tc_ptype_base(tc, t1)
        var snb2 = tc_ptype_base(tc, t2)
        if snb1 == snb2
          var sna1 = tc_ptype_arg1(tc, t1)
          var sna2 = tc_ptype_arg1(tc, t2)
          if sna1 == type_constants::TYPE_ERROR or sna2 == type_constants::TYPE_ERROR
            return true
          end
          if sna1 == sna2
            return true
          end
        end
      end
    end
    # All other shapes: refuse the implicit boundary cross.
    return false
  end

  # Parameterized type matching:
  # - Bare base (type_constants$TYPE_VEC) matches any parameterized version (Vec<Int>)
  # - Two parameterized types with different IDs never match (interning guarantees
  #   same base+args → same ID, so different IDs means different types)
  if tc_is_ptype(t1)
    if tc_is_ptype(t2)
      # T3c.1 Phase 3: Function ptypes match if both have base TYPE_FUNCTION
      # (different fn_type registry IDs are OK — structural equivalence at runtime)
      if tc_ptype_base(tc, t1) == type_constants::TYPE_FUNCTION
        if tc_ptype_base(tc, t2) == type_constants::TYPE_FUNCTION
          return true
        end
      end
      # Tier 4 #24 Phase 4b §2.3: Slice<T> / SliceMut<T> with arg1=0 is the
      # element-agnostic constant form (Slice::EMPTY). Matches any concrete
      # Slice<U> because a zero-length slice carries no payload invariants.
      var b1 = tc_ptype_base(tc, t1)
      var b2 = tc_ptype_base(tc, t2)
      if b1 == b2
        if b1 == type_constants::TYPE_SLICE or b1 == type_constants::TYPE_SLICE_MUT
          if tc_ptype_arg1(tc, t1) == 0 or tc_ptype_arg1(tc, t2) == 0
            return true
          end
        end
        # TYPE_TUPLE structural matching: tuples now intern by element-types
        # (see tc_make_tuple_type), so two tuples derived from the same shape
        # share an ID. But a generic function's body builds the return tuple
        # from the actual expression types — `LEv::Selected(x)` is bare
        # TYPE_ENUM, while the annotation `(Int, LEv<T>)` parses element 1
        # as ptype(TYPE_ENUM, T-erased, 0). These produce different elem_types
        # vectors → different tuple ptype IDs. Recurse into elem_types and
        # pairwise-match each so structurally equivalent tuples still
        # type-check identically (the existing bare-vs-ptype rule below
        # rescues the per-element comparison).
        if b1 == type_constants::TYPE_TUPLE
          var arity1 = tc_ptype_arg1(tc, t1)
          var arity2 = tc_ptype_arg1(tc, t2)
          if arity1 == arity2
            var elem_match = 1
            var idx1 = t1 - type_constants::PTYPE_BASE
            var idx2 = t2 - type_constants::PTYPE_BASE
            if idx1 < tc.registry.tuple_elem_types.size and idx2 < tc.registry.tuple_elem_types.size
              var elems1 = tc.registry.tuple_elem_types[idx1]
              var elems2 = tc.registry.tuple_elem_types[idx2]
              if elems1.size == arity1 and elems2.size == arity2
                for ei in 0..arity1
                  if tc_types_match(tc, elems1[ei], elems2[ei]) == 0
                    elem_match = 0
                    break
                  end
                end
                return true if elem_match == 1
              end
            end
          end
        end
        # Item 10 (enum-niche tail): two same-base Option/Result ptypes whose
        # payload args are element-compatible. Now that `option_some(42)` carries
        # a concrete `Option<Int>` (see typecheck_expr_handlers ~3980), the
        # RETURN path lands here when a `def f(): Option<Int>` body returns
        # `option_some(bool_expr)` (→ `Option<Bool>`). Plain ID inequality would
        # WRONGLY reject it even though Bool/Int (and F32/F64) are container-
        # compatible — the element path (tc_elem_type_matches) already accepts
        # the same payloads in `Vec<Option<Int>>.push(...)`. We delegate to
        # tc_elem_type_matches (NOT a recursive tc_types_match) on purpose: that
        # comparator uses the TIGHT int group (Int/Bool/I*/C* — NOT String), so
        # `Option<String>` vs `Option<Int>` STILL rejects (String is i64-typed,
        # so a tc_types_match recursion would have re-opened the very hole this
        # item closes). Scoped to OPTION/RESULT bases to avoid touching other
        # containers' matching semantics.
        if b1 == type_constants::TYPE_OPTION or b1 == type_constants::TYPE_RESULT
          var oa1 = tc_ptype_arg1(tc, t1)
          var ea1 = tc_ptype_arg1(tc, t2)
          var oa2 = tc_ptype_arg2(tc, t1)
          var ea2 = tc_ptype_arg2(tc, t2)
          if tc_elem_type_matches(tc, oa1, ea1) and tc_elem_type_matches(tc, oa2, ea2)
            return true
          end
        end
      end
      return false
    end
    # Parameterized vs bare base type — allow match (e.g., Vec<Int> matches Vec)
    return true if t2 == tc_ptype_base(tc, t1)
  end
  if tc_is_ptype(t2)
    # Bare base vs parameterized type — allow match (e.g., Vec matches Vec<Int>)
    return true if t1 == tc_ptype_base(tc, t2)
  end

  # Newtypes: two different newtypes never match; unwrap to wrapped type for matching
  if tc_is_newtype(t1)
    if tc_is_newtype(t2)
      return false
    end
    var idx1 = t1 - type_constants::TYPE_NEWTYPE_BASE
    var wrapped_str = tc.registry.newtype_wrapped_types[idx1]
    var wrapped_type = tc_parse_type(tc, wrapped_str)
    return tc_types_match(tc, wrapped_type, t2)
  end
  if tc_is_newtype(t2)
    var idx2 = t2 - type_constants::TYPE_NEWTYPE_BASE
    var wrapped_str = tc.registry.newtype_wrapped_types[idx2]
    var wrapped_type = tc_parse_type(tc, wrapped_str)
    return tc_types_match(tc, t1, wrapped_type)
  end

  # ===== Intersection / Record types (v5.25 Phase 8F + Phase U) =====
  # C2 termification: registered record types get a REAL structural width/depth
  # check. This MUST run before the i64-handle short-circuit below — records
  # (3000+) and nominal structs (7000+) are both i64 handles at runtime, so the
  # permissive i64 path would otherwise accept ANY record/struct pair without
  # a field check. Convention tc_types_match(t1=required/expected, t2=provided/
  # actual): provided must supply every field required needs (width; extras OK);
  # shared field types covariant (depth). Bare TYPE_STRUCT (no registry idx) has
  # no field list → the satisfies-helpers return permissive.
  if typecheck_registry::tc_is_record_type(t1) and typecheck_registry::tc_is_record_type(t2)
    return typecheck_registry::tc_record_types_match(tc, t1, t2)
  end
  if typecheck_registry::tc_is_record_type(t2)
    # t2 is a record but t1 is not: t1=required (a concrete/nominal struct slot),
    # t2=provided (a record value). The provided record must satisfy the struct
    # the slot declares.
    if typecheck_registry::tc_record_satisfies_struct(tc, t2, t1) == 1
      return true
    end
    return false
  end
  if typecheck_registry::tc_is_record_type(t1)
    # t1 is a record but t2 is not: t1=required (a record), t2=provided (a
    # concrete/nominal struct). The provided struct must supply every field the
    # required record needs (width), covariant field types (depth).
    if typecheck_registry::tc_struct_satisfies_record(tc, t2, t1) == 1
      return true
    end
    return false
  end

  # FFI C types are compatible with Int (all are i64 at runtime)
  # Int, CInt, CChar, CSize, CPtr are all i64-compatible
  if tc_is_i64_type(t1)
    if tc_is_i64_type(t2)
      return true
    end
  end
  # Bare TYPE_INTERSECTION/TYPE_RECORD: permissive for non-record intersections (trait intersections)
  if t1 == type_constants::TYPE_INTERSECTION or t2 == type_constants::TYPE_INTERSECTION
    return true
  end

  # Registered intersection types (Phase U.9): check member-wise
  if typecheck_registry::tc_is_intersection_type(t1)
    # t1 is A & B — matches t2 if ANY member of t1 matches t2
    var members = typecheck_registry::tc_intersection_member_types(tc, t1)
    for mi in 0..members.size
      if tc_types_match(tc, members[mi], t2)
        return true
      end
    end
  end
  if typecheck_registry::tc_is_intersection_type(t2)
    # t2 is A & B — t1 matches if t1 matches ALL members of t2
    var members = typecheck_registry::tc_intersection_member_types(tc, t2)
    var all_match = 1
    for mi in 0..members.size
      if tc_types_match(tc, t1, members[mi]) == 0
        all_match = 0
      end
    end
    if all_match == 1
      return true
    end
  end

  # ===== Union types: A | B | C (v5.25) =====
  # A value of type T matches union U if T is a member of U.
  if typecheck_registry::tc_is_union_type(t2)
    var members = typecheck_registry::tc_union_member_types(tc, t2)
    for i in 0..members.size
      if tc_types_match(tc, t1, members[i])
        return true
      end
    end
  end
  if typecheck_registry::tc_is_union_type(t1)
    # Symmetric: union matches if any member matches
    var members = typecheck_registry::tc_union_member_types(tc, t1)
    for i in 0..members.size
      if tc_types_match(tc, members[i], t2)
        return true
      end
    end
  end

  return false
end

## Strict type match for match arm type checking.
## Unlike tc_types_match, this does NOT collapse all i64-compatible types.
## Int vs String, Int vs Bool, etc. are considered mismatches.
## Used to detect match arm type inconsistencies.
def tc_types_match_strict(tc: TypecheckState, t1: TypeId, t2: TypeId): Bool
  if t1 == type_constants::TYPE_ERROR or t2 == type_constants::TYPE_ERROR
    return true
  end
  if t1 == type_constants::TYPE_NEVER or t2 == type_constants::TYPE_NEVER
    return true
  end
  if t1 == t2
    return true
  end
  # Parameterized types with same base but different args — delegate to tc_types_match
  if tc_is_ptype(t1) and tc_is_ptype(t2)
    return tc_ptype_base(tc, t1) == tc_ptype_base(tc, t2)
  end
  # Bare base vs parameterized
  if tc_is_ptype(t1)
    return true if t2 == tc_ptype_base(tc, t1)
  end
  if tc_is_ptype(t2)
    return true if t1 == tc_ptype_base(tc, t2)
  end
  # Newtypes
  if tc_is_newtype(t1) and tc_is_newtype(t2)
    return false
  end
  # FFI integer types are still interchangeable: Int, CInt, CChar, CSize
  if tc_is_ffi_int_type(t1) and tc_is_ffi_int_type(t2)
    return true
  end
  return false
end

## Check if a type is an FFI integer type (Int, CInt, CChar, CSize).
## These are interchangeable in strict matching since they're all plain integers.
def tc_is_ffi_int_type(t: TypeId): Bool
  return true if t == type_constants::TYPE_INT
  return true if t == type_constants::TYPE_CINT
  return true if t == type_constants::TYPE_CCHAR
  return true if t == type_constants::TYPE_CSIZE
  return false
end

## Check if two types represent a String-vs-Int/Bool mismatch.
## In the existential i64 model, tc_types_match considers all i64 types compatible.
## This helper catches clear type category errors where String and Int/Bool
## are mixed — a programmer-intent bug that should always be reported.
## Returns true if one type is String and the other is Int or Bool.
def tc_is_string_int_mismatch(t1: TypeId, t2: TypeId): Bool
  if t1 == type_constants::TYPE_STRING
    return true if t2 == type_constants::TYPE_INT
    return true if t2 == type_constants::TYPE_BOOL
  end
  if t2 == type_constants::TYPE_STRING
    return true if t1 == type_constants::TYPE_INT
    return true if t1 == type_constants::TYPE_BOOL
  end
  return false
end

## Unwrap a newtype to its wrapped type. Returns t unchanged if not a newtype.
def tc_unwrap_newtype(tc: TypecheckState, t: TypeId): Int
  if tc_is_newtype(t)
    var idx = t - type_constants::TYPE_NEWTYPE_BASE
    var wrapped_str = tc.registry.newtype_wrapped_types[idx]
    return tc_parse_type(tc, wrapped_str)
  end
  return t
end

## Strict element type match for parameterized container type safety.
## Unlike tc_types_match, this does NOT treat all i64-compatible types as matching.
## Used for vec_push, vec_set, map_set where element types must be respected.
##
## Rules:
##   - UNKNOWN or ERROR → match (propagate without cascading errors)
##   - Exact same type ID → match
##   - Ptype vs same bare base → match
##   - Int-like types: Int, Bool, CInt, CChar, CSize all match each other
##   - Everything else → no match
def tc_elem_type_matches(tc: TypecheckState, actual: TypeId, expected: TypeId): Bool
  # Bail on error (propagate without cascading)
  if actual == type_constants::TYPE_ERROR
    return true
  end
  if expected == type_constants::TYPE_ERROR
    return true
  end
  # Item 2 (enum-access payload): TYPE_UNKNOWN wildcard. `Result::Ok(5)` refines
  # to `Result<Int, UNKNOWN>` (the Err arg is necessarily unknown at the
  # constructor), and `Result::Err(x)` to `Result<UNKNOWN, _>`. Without this
  # wildcard, `Result<Int,String> = Result::Ok(5)` would WRONGLY reject on the
  # Err-slot comparison (UNKNOWN vs String). SAFETY: type VARIABLES are NEGATIVE
  # (tc_tv_is_var: t < 0) and TYPE_UNKNOWN == 0, so keying on 0 does NOT collide
  # with generic type-var binding. Scalar tight-mismatches (Ok String vs Int)
  # still reject — only the genuinely-unknown sibling slot is waved through.
  return true if actual == type_constants::TYPE_UNKNOWN
  return true if expected == type_constants::TYPE_UNKNOWN
  # Exact match (interned ptypes with same base+args have same ID)
  if actual == expected
    return true
  end
  # R2 (C3) — structural-record ELEMENT matching. A `Vec<{ x: Int }>` element slot
  # (`expected` is a record type) accepts a nominal struct or record `actual` that
  # width-subtypes it (has every field the record needs, covariant depth). Mirrors
  # the assignment path tc_types_match (:2043-2071) which already routes record vs
  # nominal-struct through tc_struct_satisfies_record / tc_record_types_match /
  # tc_record_satisfies_struct. Without this, `v.push(Point{ x: 7 })` into a record
  # Vec is rejected as "got Struct" (QZ0200). Convention here: actual=provided,
  # expected=required (record slot). Runs before the newtype/ptype/i64 gates below
  # (records + nominal structs are both i64 handles, so those permissive paths
  # cannot distinguish the field sets).
  if typecheck_registry::tc_is_record_type(expected)
    if typecheck_registry::tc_is_record_type(actual)
      return true if typecheck_registry::tc_record_types_match(tc, expected, actual)
    end
    return true if typecheck_registry::tc_struct_satisfies_record(tc, actual, expected) == 1
    return false
  end
  if typecheck_registry::tc_is_record_type(actual)
    # actual is a record, expected is a nominal struct slot: the provided record
    # must satisfy the struct the element slot declares.
    return true if typecheck_registry::tc_record_satisfies_struct(tc, actual, expected) == 1
    return false
  end
  # R2.2 — union ELEMENT matching. A `Vec<Int | String>` element slot (`expected`
  # is a union) accepts any `actual` that is a subtype of the union (an arm, or a
  # narrower union). Mirrors tc_is_subtype's `sub <: A | B` case (typecheck.qz:2380)
  # and the record branch above. Without this, `v.push(0)` into a union Vec is
  # rejected "got Int" (QZ0200). Runs before the newtype/ptype/i64 gates below: a
  # union id is neither an int-group nor a struct, so it would otherwise fall
  # through to the final `return false`. A genuine non-member (Float ∉ Int|String)
  # still returns false → the existing tc_emit_vec_element_error / QZ0200 path.
  if typecheck_registry::tc_is_union_type(expected)
    return true if tc_is_subtype(tc, actual, expected)
    return false
  end
  # Newtypes are opaque in element matching: Vec<TestId> rejects Int,
  # Vec<Int> rejects TestId, Vec<TestId> rejects OtherId
  if tc_is_newtype(actual)
    if tc_is_newtype(expected)
      return false
    end
    return false
  end
  if tc_is_newtype(expected)
    return false
  end
  # Ptype matching: ptype vs same bare base
  if tc_is_ptype(actual)
    if tc_is_ptype(expected) == false
      return true if expected == tc_ptype_base(tc, actual)
      # Item 2 (enum-access payload): a TUPLE ptype payload rides in a scalar
      # int-group carrier slot (pointer-width). std/iter.qz deliberately yields
      # `(Int, Int)` from `Iterator<Int>::next(): Option<Int>` — the doc header
      # at iter.qz top explains why: impl methods of bounded-generic structs are
      # emitted ONCE (not per-monomorphization), so `Iterator<(Int,Int)>` cannot
      # be expressed; the tuple is existentially boxed into the `Int` slot (the
      # same QZ0215 "Int-typed value into boxed param" sentinel idiom). Before
      # this item the bare-`Option` erasure masked it; now that
      # `Option::Some(tuple)` carries `Option<(Int,Int)>` the Option-arg compare
      # lands here as tuple-ptype-vs-Int. Accept it (the tuple/Int pointer-box is
      # ABI-compatible). Scoped to the int group — a tuple vs String/Float/struct
      # still rejects, so genuine payload mismatches stay caught.
      if tc_ptype_base(tc, actual) == type_constants::TYPE_TUPLE
        if expected == type_constants::TYPE_INT or expected == type_constants::TYPE_BOOL or expected == type_constants::TYPE_CINT or expected == type_constants::TYPE_CCHAR or expected == type_constants::TYPE_CSIZE or expected == type_constants::TYPE_SYMBOL or expected == type_constants::TYPE_I8 or expected == type_constants::TYPE_I16 or expected == type_constants::TYPE_I32 or expected == type_constants::TYPE_U8 or expected == type_constants::TYPE_U16 or expected == type_constants::TYPE_U32
          return true
        end
      end
      return false
    end
    # Both ptypes. Exact-ID is handled above. Two TYPE_FUNCTION ptypes are
    # structurally equivalent regardless of their fn_type registry id (the
    # signature, not the id, defines the type) — mirror tc_types_match's
    # function-ptype rule so a Fn payload matches.
    var actual_base = tc_ptype_base(tc, actual)
    var expected_base = tc_ptype_base(tc, expected)
    if actual_base == type_constants::TYPE_FUNCTION and expected_base == type_constants::TYPE_FUNCTION
      return true
    end
    # §14.7 item-2 (5a): two container ptypes off the SAME base whose type
    # args match element-wise. `option_some(bare_def)` now yields a concrete
    # `Option<Fn(...)>` whose inner Fn ptype id differs from the annotation-
    # parsed `Vec<Option<Fn(...)>>` element's Fn id, even though the Fn
    # signatures are identical. Recursing the args through tc_elem_type_matches
    # (NOT the i64-collapsing tc_types_match) keeps Int-vs-String element
    # mismatches rejected while accepting structurally-equal Fn payloads —
    # restoring the match the pre-5a bare-`Option` looseness gave for free
    # without re-widening to "any Option matches any Option".
    if actual_base == expected_base
      var a_arg1 = tc_ptype_arg1(tc, actual)
      var e_arg1 = tc_ptype_arg1(tc, expected)
      var a_arg2 = tc_ptype_arg2(tc, actual)
      var e_arg2 = tc_ptype_arg2(tc, expected)
      if tc_elem_type_matches(tc, a_arg1, e_arg1) and tc_elem_type_matches(tc, a_arg2, e_arg2)
        return true
      end
    end
    return false
  end
  if tc_is_ptype(expected)
    return true if actual == tc_ptype_base(tc, expected)
    # Item 2: symmetric tuple-carrier case — a scalar int-group `actual` against
    # a TUPLE-ptype `expected` slot (the pointer-boxed-tuple idiom, reversed
    # direction). See the actual-side comment above for the iter.qz rationale.
    if tc_ptype_base(tc, expected) == type_constants::TYPE_TUPLE
      if actual == type_constants::TYPE_INT or actual == type_constants::TYPE_BOOL or actual == type_constants::TYPE_CINT or actual == type_constants::TYPE_CCHAR or actual == type_constants::TYPE_CSIZE or actual == type_constants::TYPE_SYMBOL or actual == type_constants::TYPE_I8 or actual == type_constants::TYPE_I16 or actual == type_constants::TYPE_I32 or actual == type_constants::TYPE_U8 or actual == type_constants::TYPE_U16 or actual == type_constants::TYPE_U32
        return true
      end
    end
    return false
  end
  # Int-compatible group: Int, Bool, I8-U64, CInt, CChar, CSize
  if actual == type_constants::TYPE_INT or actual == type_constants::TYPE_BOOL or actual == type_constants::TYPE_CINT or actual == type_constants::TYPE_CCHAR or actual == type_constants::TYPE_CSIZE or actual == type_constants::TYPE_SYMBOL or actual == type_constants::TYPE_I8 or actual == type_constants::TYPE_I16 or actual == type_constants::TYPE_I32 or actual == type_constants::TYPE_U8 or actual == type_constants::TYPE_U16 or actual == type_constants::TYPE_U32
    if expected == type_constants::TYPE_INT or expected == type_constants::TYPE_BOOL or expected == type_constants::TYPE_CINT or expected == type_constants::TYPE_CCHAR or expected == type_constants::TYPE_CSIZE or expected == type_constants::TYPE_SYMBOL or expected == type_constants::TYPE_I8 or expected == type_constants::TYPE_I16 or expected == type_constants::TYPE_I32 or expected == type_constants::TYPE_U8 or expected == type_constants::TYPE_U16 or expected == type_constants::TYPE_U32
      return true
    end
  end
  # Float-compatible group: F32 and F64 are interchangeable in containers
  # (codegen handles fptrunc/fpext as needed)
  if actual == type_constants::TYPE_F64 or actual == type_constants::TYPE_F32
    if expected == type_constants::TYPE_F64 or expected == type_constants::TYPE_F32
      return true
    end
  end
  # Struct types without further info → allow match
  if tc_is_struct_type(actual) and tc_is_struct_type(expected)
    return true
  end
  # Enum types → allow match
  if actual == type_constants::TYPE_ENUM and expected == type_constants::TYPE_ENUM
    return true
  end
  return false
end

## Directional subtype check: is sub <: super?
## This is the core relation for union/intersection types:
##   A <: A | B          (A is a member of the union)
##   A | B <: A | B | C  (all members of sub are also in super)
##   A & B <: A          (intersection satisfies each constituent)
##   Never <: anything   (bottom type)
def tc_is_subtype(tc: TypecheckState, sub: TypeId, super_type: TypeId): Bool
  # Identity and special types
  if sub == super_type
    return true
  end
  if sub == type_constants::TYPE_ERROR or super_type == type_constants::TYPE_ERROR
    return true
  end

  # Never (bottom type) is a subtype of everything
  if sub == type_constants::TYPE_NEVER
    return true
  end

  # sub <: A | B if sub <: any member of the union
  if typecheck_registry::tc_is_union_type(super_type)
    var members = typecheck_registry::tc_union_member_types(tc, super_type)
    for i in 0..members.size
      if tc_is_subtype(tc, sub, members[i])
        return true
      end
    end
    return false
  end

  # A | B <: super if EVERY member of the union <: super
  if typecheck_registry::tc_is_union_type(sub)
    var members = typecheck_registry::tc_union_member_types(tc, sub)
    for i in 0..members.size
      if tc_is_subtype(tc, members[i], super_type) == false
        return false
      end
    end
    return true
  end

  # A & B <: C if ANY member of the intersection <: C
  if typecheck_registry::tc_is_intersection_type(sub)
    var members = typecheck_registry::tc_intersection_member_types(tc, sub)
    for i in 0..members.size
      if tc_is_subtype(tc, members[i], super_type)
        return true
      end
    end
    return false
  end

  # C <: A & B if C <: A AND C <: B (all members must hold)
  if typecheck_registry::tc_is_intersection_type(super_type)
    var members = typecheck_registry::tc_intersection_member_types(tc, super_type)
    for i in 0..members.size
      if tc_is_subtype(tc, sub, members[i]) == false
        return false
      end
    end
    return true
  end

  # For nominal types, fall back to equality-based matching
  return tc_types_match(tc, sub, super_type)
end

## Compute the least upper bound (join) of two types.
## Used for inferring the result type of if-else branches and match arms.
## Int ⊔ String = Int | String (union of the two)
## Int ⊔ Int = Int (same type, no union needed)
## A | B ⊔ C = A | B | C (add member to union)
def tc_type_join(tc: TypecheckState, a: TypeId, b: TypeId): Int
  # Same type → no join needed
  if a == b
    return a
  end
  if a == type_constants::TYPE_ERROR
    return b
  end
  if b == type_constants::TYPE_ERROR
    return a
  end

  # Never is the bottom type — join with anything produces the other
  if a == type_constants::TYPE_NEVER
    return b
  end
  if b == type_constants::TYPE_NEVER
    return a
  end

  # If a is already a subtype of b, just use b
  if tc_is_subtype(tc, a, b)
    return b
  end
  if tc_is_subtype(tc, b, a)
    return a
  end

  # Both are concrete, different types — form a union A | B
  # Collect all member type names
  var parts = vec_new<String>()

  # Expand a's members (if union) or add a directly
  if typecheck_registry::tc_is_union_type(a)
    var a_members = typecheck_registry::tc_union_members(tc, a)
    for i in 0..a_members.size
      parts.push(a_members[i])
    end
  else
    parts.push(tc_type_name(a))
  end

  # Expand b's members (if union) or add b directly
  if typecheck_registry::tc_is_union_type(b)
    var b_members = typecheck_registry::tc_union_members(tc, b)
    for j in 0..b_members.size
      # Only add if not already present (dedup)
      var already = false
      var k = 0
      while k < parts.size
        if parts[k] == b_members[j]
          already = true
        end
        k += 1
      end
      if already == false
        parts.push(b_members[j])
      end
    end
  else
    var b_name = tc_type_name(b)
    var already = false
    for k in 0..parts.size
      if parts[k] == b_name
        already = true
      end
    end
    if already == false
      parts.push(b_name)
    end
  end

  return typecheck_registry::tc_register_union(tc, parts)
end

## Compute the greatest lower bound (meet) of two types.
## This is the dual of tc_type_join (LUB).
## meet(A, A) = A (identity)
## meet(top, A) = A (unknown is top)
## meet(bot, A) = bot (never is bottom)
## meet(A, B) = A if A <: B
## meet(A, B) = B if B <: A
## meet(Int, String) = TYPE_NEVER (incompatible primitives)
## meet(A, B) = A & B (general case)
def tc_type_meet(tc: TypecheckState, a: TypeId, b: TypeId): Int
  # Identity: meet(A, A) = A
  if a == b
    return a
  end
  # Error propagation
  if a == type_constants::TYPE_ERROR
    return b
  end
  if b == type_constants::TYPE_ERROR
    return a
  end
  # Never is bottom: meet(bot, A) = bot
  if a == type_constants::TYPE_NEVER
    return type_constants::TYPE_NEVER
  end
  if b == type_constants::TYPE_NEVER
    return type_constants::TYPE_NEVER
  end
  # If a <: b, then meet(a, b) = a (a is more specific)
  if tc_is_subtype(tc, a, b)
    return a
  end
  # If b <: a, then meet(a, b) = b (b is more specific)
  if tc_is_subtype(tc, b, a)
    return b
  end
  # General case: form intersection A & B
  var parts = vec_new<String>()
  # Expand a's members (if already intersection) or add a directly
  if typecheck_registry::tc_is_intersection_type(a)
    var a_members = typecheck_registry::tc_intersection_members(tc, a)
    for i in 0..a_members.size
      parts.push(a_members[i])
    end
  else
    parts.push(tc_type_name(a))
  end
  # Expand b's members (if already intersection) or add b directly
  if typecheck_registry::tc_is_intersection_type(b)
    var b_members = typecheck_registry::tc_intersection_members(tc, b)
    for j in 0..b_members.size
      parts.push(b_members[j])
    end
  else
    parts.push(tc_type_name(b))
  end
  return typecheck_registry::tc_register_intersection(tc, parts)
end

## Extract element type from a parameterized type annotation.
## Examples: "Vec<Int>" -> "Int", "Map<String, Bool>" -> "String, Bool", "Int" -> ""
def tc_extract_element_type(ann: String): String
  return "" if str_byte_len(ann) == 0

  var open_idx = __char_index(ann, '<')
  return "" if open_idx < 0

  # Find last > by scanning from end
  var len = str_byte_len(ann)
  var close_idx = -1
  var i = len - 1
  while i >= 0
    if str_byte_at(ann, i) == '>'  # '>' is ASCII 62
      close_idx = i
      break
    end
    i -= 1
  end

  return "" if close_idx < 0
  return "" if close_idx <= open_idx + 1

  return str_byte_slice(ann, open_idx + 1, close_idx)
end

## Resolve a Fn-shaped annotation through any `type X = Fn(...)` alias.
##
## A `type X = Fn(...)` alias used at any reader site (param-count, nth-param,
## return-type, "is this a Fn shape" gates) stores the bare alias name in the
## annotation slot. The pure-string parsers only understand literal `Fn(...)`
## text — a bare alias yields 0 / "" / `false`. Callers used to pre-resolve at
## every site (HB-DOG.3(a)); centralizing the resolution here lets every
## reader be alias-transparent without each caller remembering. Mirrors how
## Swift / Kotlin / TypeScript / OCaml normalize type aliases at point of use.
##
## Returns the resolved string if `annotation` is an alias to a Fn type, else
## returns `annotation` unchanged. Single-level resolution only (chained
## aliases like `type B = A` where `A = Fn(...)` are left to a future pass).
def _tc_resolve_fn_ann(tc: TypecheckState, annotation: String): String
  if str_byte_len(annotation) == 0
    return annotation
  end
  var resolved = tc_lookup_type_alias(tc, annotation)
  if str_byte_len(resolved) > 0
    return resolved
  end
  return annotation
end

## Test whether `annotation` denotes a `Fn(...)` shape, transparently
## resolving through any `type X = Fn(...)` alias. Replaces the
## `ann.starts_with("Fn(")` gates at field-call dispatch sites
## (HB-DOG.3(c) with alias-typed fields).
def _tc_is_fn_ann(tc: TypecheckState, annotation: String): Bool
  return _tc_resolve_fn_ann(tc, annotation).starts_with("Fn(")
end

## Extract param count from an Fn(...) type annotation.
## "Fn(Int, Int): Int" -> 2, "Fn(Int): Int" -> 1, "Fn(): Void" -> 0
## Handles nested Fn types by tracking paren depth.
## Transparently resolves `type X = Fn(...)` aliases (HB-DOG.3(b)).
def tc_fn_annotation_param_count(tc: TypecheckState, annotation: String): Int
  var ann = _tc_resolve_fn_ann(tc, annotation)
  var len = str_byte_len(ann)
  if len < 4
    return 0
  end

  # Find matching close paren for the opening "Fn("
  var depth = 1
  var i = 3
  var close_idx = -1
  while i < len
    var ch = str_byte_at(ann, i)
    if ch == '('
      depth += 1
    elsif ch == ')'
      depth -= 1
      if depth == 0
        close_idx = i
        i = len
      end
    end
    i += 1
  end

  if close_idx < 0
    return 0
  end

  # Empty parens: Fn()
  if close_idx == 3
    return 0
  end

  # Count top-level commas between positions 3 and close_idx
  var count = 1
  depth = 0
  i = 3
  while i < close_idx
    var ch = str_byte_at(ann, i)
    if ch == '('
      depth += 1
    elsif ch == ')'
      depth -= 1
    elsif ch == ','
      if depth == 0
        count += 1
      end
    end
    i += 1
  end
  return count
end

## Extract return type from an Fn(...): RetType annotation.
## "Fn(Int): Int" -> type_constants$TYPE_INT, "Fn(): Void" -> type_constants$TYPE_VOID
## Returns type_constants$TYPE_INT if no "): " separator found (default).
## Transparently resolves `type X = Fn(...)` aliases (HB-DOG.3(b)).
def tc_fn_annotation_return_type(tc: TypecheckState, annotation: String): Int
  var ann = _tc_resolve_fn_ann(tc, annotation)
  var sep = __str_index(ann, "): ")
  if sep < 0
    return type_constants::TYPE_INT
  end
  var ret_ann = str_byte_slice(ann, sep + 3, str_byte_len(ann))
  return tc_parse_type(tc, ret_ann)
end

## Extract the Nth parameter type string from an Fn(...) annotation.
## "Fn(Int, String): Bool" with n=0 -> "Int", n=1 -> "String"
## Returns "" if n is out of range.
## Transparently resolves `type X = Fn(...)` aliases (HB-DOG.3(b)).
def tc_fn_annotation_nth_param_str(tc: TypecheckState, annotation: String, n: Int): String
  var ann = _tc_resolve_fn_ann(tc, annotation)
  var len = str_byte_len(ann)
  if len < 4
    return ""
  end
  # Find matching close paren
  var depth = 1
  var i = 3
  var close_idx = -1
  while i < len
    var ch = str_byte_at(ann, i)
    if ch == '('
      depth += 1
    elsif ch == ')'
      depth -= 1
      if depth == 0
        close_idx = i
        i = len
      end
    end
    i += 1
  end
  if close_idx < 0
    return ""
  end
  if close_idx == 3
    return ""
  end
  # Walk through params, counting top-level commas
  var param_idx = 0
  var start = 3
  depth = 0
  i = 3
  while i <= close_idx
    var ch = str_byte_at(ann, i)
    if ch == '('
      depth += 1
    elsif ch == ')'
      depth -= 1
    elsif ch == ','
      if depth == 0
        if param_idx == n
          return str_byte_slice(ann, start, i).trim()
        end
        param_idx += 1
        start = i + 1
      end
    end
    i += 1
  end
  # Last (or only) param
  if param_idx == n
    return str_byte_slice(ann, start, close_idx).trim()
  end
  return ""
end

## Check if two type annotations match for parameterized types.
## Both annotations must have identical element types.
def tc_annotations_match(ann1: String, ann2: String): Bool
  # If either annotation is empty, allow match (unresolved annotations are permissive)
  return true if str_byte_len(ann1) == 0
  return true if str_byte_len(ann2) == 0

  var elem1 = tc_extract_element_type(ann1)
  var elem2 = tc_extract_element_type(ann2)

  # If no element types found, just match
  return true if str_byte_len(elem1) == 0
  return true if str_byte_len(elem2) == 0

  # Element types must match exactly
  return elem1 == elem2
end

## Check if type is parameterized (needs element type checking).
def tc_is_parameterized_type(t: TypeId): Bool
  return true if t >= type_constants::PTYPE_BASE
  return true if t == type_constants::TYPE_VEC
  return true if t == type_constants::TYPE_MAP
  return true if t == type_constants::TYPE_PTR
  return false
end

## Check type compatibility with annotation support for parameterized types.
## For Vec<T>, Map<K,V>, Ptr<T>, the element types must match.
##
## Parameters:
##   t1   - First type kind
##   t2   - Second type kind
##   ann1 - Type annotation for t1 (e.g., "Vec<Int>")
##   ann2 - Type annotation for t2 (e.g., "Vec<String>")
##
## Returns: true if compatible
def tc_types_match_with_annotations(tc: TypecheckState, t1: TypeId, t2: TypeId, ann1: String, ann2: String): Bool
  # type_constants$TYPE_ERROR matches anything (error recovery)
  return true if t1 == type_constants::TYPE_ERROR
  return true if t2 == type_constants::TYPE_ERROR

  # Exact kind match (interned ptypes with same base+args have same ID)
  if t1 == t2
    # For old-style bare parameterized types, also check element type annotations
    if tc_is_parameterized_type(t1)
      if tc_is_ptype(t1) == false
        return tc_annotations_match(ann1, ann2)
      end
    end
    return true
  end

  # Parameterized type matching (new interned ptype system)
  if tc_is_ptype(t1)
    if tc_is_ptype(t2)
      return false
    end
    return true if t2 == tc_ptype_base(tc, t1)
  end
  if tc_is_ptype(t2)
    return true if t1 == tc_ptype_base(tc, t2)
  end

  # Newtypes: unwrap to wrapped type for matching
  if tc_is_newtype(t1)
    if tc_is_newtype(t2)
      return false
    end
    var idx1 = t1 - type_constants::TYPE_NEWTYPE_BASE
    var wrapped_str = tc.registry.newtype_wrapped_types[idx1]
    var wrapped_type = tc_parse_type(tc, wrapped_str)
    return tc_types_match_with_annotations(tc, wrapped_type, t2, wrapped_str, ann2)
  end
  if tc_is_newtype(t2)
    var idx2 = t2 - type_constants::TYPE_NEWTYPE_BASE
    var wrapped_str = tc.registry.newtype_wrapped_types[idx2]
    var wrapped_type = tc_parse_type(tc, wrapped_str)
    return tc_types_match_with_annotations(tc, t1, wrapped_type, ann1, wrapped_str)
  end

  # C2 termification: registered record/struct pairs get the real structural
  # width/depth check — same as tc_types_match, run before the i64 short-circuit
  # (records + nominal structs are both i64 handles). This is the let/assign
  # coercion path (tc_check_let_full / tc_check_assign).
  if typecheck_registry::tc_is_record_type(t1) and typecheck_registry::tc_is_record_type(t2)
    return typecheck_registry::tc_record_types_match(tc, t1, t2) == 1
  end
  if typecheck_registry::tc_is_record_type(t2)
    # t1=required struct slot, t2=provided record.
    return typecheck_registry::tc_record_satisfies_struct(tc, t2, t1) == 1
  end
  if typecheck_registry::tc_is_record_type(t1)
    # t1=required record, t2=provided struct.
    return typecheck_registry::tc_struct_satisfies_record(tc, t2, t1) == 1
  end

  # FFI C types are compatible with Int (all are i64 at runtime)
  # But NOT parameterized types with different element types
  if tc_is_i64_type(t1) and tc_is_i64_type(t2)
    # If both are parameterized, require matching element types
    if tc_is_parameterized_type(t1) and tc_is_parameterized_type(t2)
      # Different parameterized kinds (Vec vs Map) -> no match
      return false if t1 != t2
      return tc_annotations_match(ann1, ann2)
    end
    # One or both are non-parameterized i64 types -> compatible
    return true
  end

  # ===== Union types: A | B | C (v5.25) =====
  if typecheck_registry::tc_is_union_type(t2)
    var members = typecheck_registry::tc_union_member_types(tc, t2)
    for i in 0..members.size
      if tc_types_match(tc, t1, members[i])
        return true
      end
    end
  end
  if typecheck_registry::tc_is_union_type(t1)
    var members = typecheck_registry::tc_union_member_types(tc, t1)
    for i in 0..members.size
      if tc_types_match(tc, members[i], t2)
        return true
      end
    end
  end

  return false
end

## Check if type is an i64-compatible type (for FFI interop).
def tc_is_i64_type(t: TypeId): Bool
  # Parameterized types (Vec<Int>, CPtr<T>, etc.) are all i64 handles at runtime
  return true if t >= type_constants::PTYPE_BASE
  return true if t == type_constants::TYPE_INT
  return true if t == type_constants::TYPE_BOOL
  return true if t == type_constants::TYPE_SYMBOL
  return true if t == type_constants::TYPE_ENUM
  return true if t == type_constants::TYPE_OPTION
  return true if t == type_constants::TYPE_RESULT
  return true if t == type_constants::TYPE_STRUCT
  return true if t == type_constants::TYPE_ARRAY
  return true if t == type_constants::TYPE_STRING
  return true if t == type_constants::TYPE_CINT
  return true if t == type_constants::TYPE_CCHAR
  return true if t == type_constants::TYPE_CSIZE
  return true if t == type_constants::TYPE_CPTR
  return true if t == type_constants::TYPE_VEC
  return true if t == type_constants::TYPE_MAP
  return true if t == type_constants::TYPE_PTR
  return true if t == type_constants::TYPE_STRINGBUILDER
  return true if t == type_constants::TYPE_SET
  return true if t == type_constants::TYPE_ARENA
  return true if t == type_constants::TYPE_POOL
  return true if t == type_constants::TYPE_ARENAPOOL
  return true if t == type_constants::TYPE_CHANNEL
  return true if t == type_constants::TYPE_MUTEX
  return true if t == type_constants::TYPE_ATOMIC
  return true if t == type_constants::TYPE_REGEX
  # Fixed-width integer types are i64 internally (narrowed only at function boundaries)
  return true if t == type_constants::TYPE_I8
  return true if t == type_constants::TYPE_I16
  return true if t == type_constants::TYPE_I32
  return true if t == type_constants::TYPE_U8
  return true if t == type_constants::TYPE_U16
  return true if t == type_constants::TYPE_U32
  # Extended-range types: newtypes, unions, records are all i64 handles at runtime
  if t >= type_constants::TYPE_NEWTYPE_BASE and t < type_constants::PTYPE_BASE
    return true
  end
  return false
end

## R2.3 arg-type soundness — scalar-group classification for the positive-flag
## argument type check (QZ0201). These are DELIBERATELY narrow: they answer only
## "is this an integer-group / float-group / string scalar?" so the call-site
## check can flag String↔numeric and Int↔Float without touching the broad
## i64-handle catch-all (which lumps String/Struct/Vec/etc. together).

## True iff `t` is an integer-group scalar: Int, Byte, or any fixed-width int.
## (Bool is NOT included — Bool↔Int punning is explicitly permitted.)
def tc_argcheck_is_int_group(t: TypeId): Bool
  return true if t == type_constants::TYPE_INT
  return true if t == type_constants::TYPE_BYTE
  return true if t == type_constants::TYPE_I8
  return true if t == type_constants::TYPE_I16
  return true if t == type_constants::TYPE_I32
  return true if t == type_constants::TYPE_U8
  return true if t == type_constants::TYPE_U16
  return true if t == type_constants::TYPE_U32
  return true if t == type_constants::TYPE_CINT
  return true if t == type_constants::TYPE_CCHAR
  return true if t == type_constants::TYPE_CSIZE
  return true if t == type_constants::TYPE_NONZERO
  return false
end

## True iff `t` is a float-group scalar: F64, F32, or the C float aliases.
def tc_argcheck_is_float_group(t: TypeId): Bool
  return true if t == type_constants::TYPE_F64
  return true if t == type_constants::TYPE_F32
  return true if t == type_constants::TYPE_CFLOAT
  return true if t == type_constants::TYPE_CDOUBLE
  return false
end

## Sentinel-skip predicate for R2.3: return true if `t` is a type that the
## arg-type check must PERMIT unconditionally (type-var / generic / erased /
## unknown / never / void / any). Skipping generic/type-var params (which
## resolve to TYPE_ERROR / TYPE_GENERIC) is critical — otherwise erased
## generics like `unwrap_or<T>`'s T would false-flag.
def tc_argcheck_is_sentinel(t: TypeId): Bool
  return true if t == type_constants::TYPE_UNKNOWN
  return true if t == type_constants::TYPE_GENERIC
  return true if t == type_constants::TYPE_ERROR
  return true if t == type_constants::TYPE_NEVER
  return true if t == type_constants::TYPE_VOID
  return false
end

## Unwrap `newtype X = T` to its wrapped scalar (one level), mirroring the
## tc_types_match newtype path. Returns `t` unchanged if not a newtype. Used by
## the R2.3 arg check so a `newtype Handle = Int` compares as Int on both sides.
def tc_argcheck_unwrap_newtype(tc: TypecheckState, t: TypeId): TypeId
  if tc_is_newtype(t)
    var idx = t - type_constants::TYPE_NEWTYPE_BASE
    if idx >= 0 and idx < tc.registry.newtype_wrapped_types.size
      var wrapped_str = tc.registry.newtype_wrapped_types[idx]
      return tc_parse_type(tc, wrapped_str)
    end
  end
  return t
end

## R2.3 / WS2.1 scalar mismatch predicate (QZ0201) — the SOLE positive-flag
## scalar-mismatch check for BOTH call-site args and assignment RHS. Given an
## expected type and an actual type, return 1 iff the pair is a definite scalar
## mismatch to FLAG, else 0. Positive-flag ONLY: every uncertain / permitted case
## returns 0.
##   (a) String↔numeric (int-group OR float-group)
##   (b) Int-group↔Float-group
## Newtypes are unwrapped on BOTH sides first. Sentinels short-circuit to permit.
##
## ONE erasure-safety carve-out: a niche-erased `Option<String>` payload (a
## `Some(s)` match-binding, an `opt ?? "d"` result) OR a read from an ERASED
## container / raw handle (`as_vec(...)[i]`, untyped `Vec` element, `load(...)`)
## has a real runtime value that is a String pointer but a STATIC type that
## degrades to `TYPE_INT` (the i64 existential). Flagging `String ← Int` in that
## case is a FALSE POSITIVE (rejects valid `var s: String = strs[i]` and
## `assert_eq_str(opt ?? "d", "x")`). The distinguishing signal is literal-ness:
## a String/Int/Float *literal* has an unambiguous, non-erased type. So for the
## erasure-prone direction (expected is String, actual static type is int-group)
## flag ONLY when the actual node is a genuine int literal.
##
## `is_rhs_int_lit` / `is_rhs_str_lit` / `is_rhs_flt_lit` are booleans the caller
## computes from the RHS/arg node kind (NODE_INT_LIT / NODE_STRING_LIT / NODE_FLOAT_LIT).
def tc_assign_scalar_mismatch(tc: TypecheckState, expected: TypeId, actual: TypeId, is_rhs_int_lit: Bool, is_rhs_str_lit: Bool, is_rhs_flt_lit: Bool): Int
  return 0 if tc_argcheck_is_sentinel(expected)
  return 0 if tc_argcheck_is_sentinel(actual)
  var e = tc_argcheck_unwrap_newtype(tc, expected)
  var a = tc_argcheck_unwrap_newtype(tc, actual)
  return 0 if tc_argcheck_is_sentinel(e)
  return 0 if tc_argcheck_is_sentinel(a)

  var e_str = e == type_constants::TYPE_STRING
  var a_str = a == type_constants::TYPE_STRING
  var e_int = tc_argcheck_is_int_group(e)
  var a_int = tc_argcheck_is_int_group(a)
  var e_flt = tc_argcheck_is_float_group(e)
  var a_flt = tc_argcheck_is_float_group(a)

  # Int↔Float — always safe to flag (no erased Float representation exists).
  if e_int and a_flt
    return 1
  end
  if e_flt and a_int
    return 1
  end
  # String LHS ← Float RHS — safe (a Float RHS is genuinely Float; SIGSEGV risk).
  if e_str and a_flt
    return 1
  end
  # String RHS → numeric LHS — RHS is a genuine String (never an erasure target);
  # flag whether or not it's a literal (`Int field = str_returning_call()`).
  if a_str and (e_int or e_flt)
    return 1
  end
  # String LHS ← int-group RHS — the erasure-prone direction. `Int`-typed RHS may
  # be an erased String pointer (niche Option<String> payload, as_vec/load/untyped-Vec
  # element). Flag ONLY when the RHS is an unambiguous int literal (`s.name = 42`),
  # which cannot be erased.
  if e_str and a_int
    if is_rhs_int_lit
      return 1
    end
    return 0
  end
  return 0
end

## B.15d/N3.1 step-4a — per-struct nominal TypeId helpers.
##
## A registered struct's nominal TypeId is STRUCT_TYPE_BASE + struct_idx,
## replacing the bare TYPE_STRUCT(=7) existential collapse. Only BARE struct
## names parse to this id (tc_parse_type); generic-struct ptypes keep
## TYPE_STRUCT as their ptype base. See docs/design/B15_NIL_ELIMINATION.md §11.12.

## Nominal TypeId for the struct at registry index `struct_idx`.
def tc_struct_type_id(struct_idx: Int): Int
  return type_constants::STRUCT_TYPE_BASE + struct_idx
end

## Registry index from a struct nominal TypeId, or -1 if `t` is not one
## (including the bare TYPE_STRUCT wildcard, which carries no specific idx).
def tc_struct_idx_from_type(t: TypeId): Int
  if t >= type_constants::STRUCT_TYPE_BASE and t < type_constants::PTYPE_BASE
    return t - type_constants::STRUCT_TYPE_BASE
  end
  return -1
end

## True if `t` denotes a struct: the bare TYPE_STRUCT wildcard OR a per-struct
## nominal id (STRUCT_TYPE_BASE..PTYPE_BASE). The single seam the 47 non-hazard
## `== TYPE_STRUCT` tests route through so they keep matching once tc_parse_type
## flips to nominal ids (4a-2). The 6 ptype-base hazard sites stay literal
## `== TYPE_STRUCT` (generic structs keep TYPE_STRUCT as their ptype base).
def tc_is_struct_type(t: TypeId): Bool
  return true if t == type_constants::TYPE_STRUCT
  return true if t >= type_constants::STRUCT_TYPE_BASE and t < type_constants::PTYPE_BASE
  return false
end

## Get human-readable name for a type kind.
##
## Parameters:
##   type_kind - Type kind constant
##
## Returns: Type name string
def tc_type_name(type_kind: TypeId): String
  return "unknown" if type_kind == type_constants::TYPE_UNKNOWN
  return "Int" if type_kind == type_constants::TYPE_INT
  return "Bool" if type_kind == type_constants::TYPE_BOOL
  return "String" if type_kind == type_constants::TYPE_STRING
  return "Void" if type_kind == type_constants::TYPE_VOID
  # TYPE_CHAR removed - chars are ints now
  return "Symbol" if type_kind == type_constants::TYPE_SYMBOL
  return "Vec" if type_kind == type_constants::TYPE_ARRAY
  return "Function" if type_kind == type_constants::TYPE_FUNCTION
  return "Struct" if type_kind == type_constants::TYPE_STRUCT
  return "Enum" if type_kind == type_constants::TYPE_ENUM
  return "Option" if type_kind == type_constants::TYPE_OPTION
  return "Result" if type_kind == type_constants::TYPE_RESULT
  return "Range" if type_kind == type_constants::TYPE_RANGE
  return "error" if type_kind == type_constants::TYPE_ERROR
  
  # FFI C Types
  return "CInt" if type_kind == type_constants::TYPE_CINT
  return "CChar" if type_kind == type_constants::TYPE_CCHAR
  return "CPtr" if type_kind == type_constants::TYPE_CPTR
  return "CSize" if type_kind == type_constants::TYPE_CSIZE
  if type_kind == type_constants::TYPE_CFLOAT
    return "CFloat"
  end
  return "CDouble" if type_kind == type_constants::TYPE_CDOUBLE
  return "F64" if type_kind == type_constants::TYPE_F64
  return "F32" if type_kind == type_constants::TYPE_F32
  return "I8" if type_kind == type_constants::TYPE_I8
  return "I16" if type_kind == type_constants::TYPE_I16
  return "I32" if type_kind == type_constants::TYPE_I32
  return "U8" if type_kind == type_constants::TYPE_U8
  return "U16" if type_kind == type_constants::TYPE_U16
  return "U32" if type_kind == type_constants::TYPE_U32
  return "NonZero" if type_kind == type_constants::TYPE_NONZERO
  return "F32x4" if type_kind == type_constants::TYPE_SIMD_F32X4
  return "F64x2" if type_kind == type_constants::TYPE_SIMD_F64X2
  return "I32x4" if type_kind == type_constants::TYPE_SIMD_I32X4
  return "F32x8" if type_kind == type_constants::TYPE_SIMD_F32X8
  return "Task" if type_kind == type_constants::TYPE_TASK
  return "TaskGroup" if type_kind == type_constants::TYPE_TASK_GROUP
  return "Channel" if type_kind == type_constants::TYPE_CHANNEL
  return "AtomicInt" if type_kind == type_constants::TYPE_ATOMIC
  return "!" if type_kind == type_constants::TYPE_NEVER
  return "Vec" if type_kind == type_constants::TYPE_VEC
  return "Map" if type_kind == type_constants::TYPE_MAP
  return "Ptr" if type_kind == type_constants::TYPE_PTR
  return "StringBuilder" if type_kind == type_constants::TYPE_STRINGBUILDER
  return "Tuple" if type_kind == type_constants::TYPE_TUPLE
  return "Union" if type_kind == type_constants::TYPE_UNION
  return "Intersection" if type_kind == type_constants::TYPE_INTERSECTION
  return "Record" if type_kind == type_constants::TYPE_RECORD

  # Registered union types (Phase U): display as "Union"
  if typecheck_registry::tc_is_union_type(type_kind)
    return "Union"
  end

  # Registered intersection types (Phase U.9): display as "Intersection"
  # (tc_type_name has no tc parameter; use tc_type_name_full for A & B display)
  if typecheck_registry::tc_is_intersection_type(type_kind)
    return "Intersection"
  end

  # Registered record types (Phase 8F): display field info
  if typecheck_registry::tc_is_record_type(type_kind)
    return "Record"
  end

  # Per-struct nominal ids (B.15d/N3.1 step-4a) — the tc-less path renders the
  # generic "Struct"; tc_type_name_full resolves the specific struct name.
  if type_kind >= type_constants::STRUCT_TYPE_BASE and type_kind < type_constants::PTYPE_BASE
    return "Struct"
  end

  return "unknown"
end

## Get a human-readable name for a type, including parameterized types.
## For ptypes like Vec<String>, renders as "Vec<String>" instead of "unknown".
def tc_type_name_full(tc: TypecheckState, type_kind: TypeId): String
  # Per-struct nominal id (B.15d/N3.1 step-4a) — resolve to the real struct name.
  var _struct_name_idx = tc_struct_idx_from_type(type_kind)
  if _struct_name_idx >= 0 and _struct_name_idx < tc.registry.struct_names.size
    return tc.registry.struct_names[_struct_name_idx]
  end
  if tc_is_ptype(type_kind)
    var base = tc_base_kind(tc, type_kind)
    # Tuple types: display as "(Int, String)" instead of "Tuple<2>"
    if base == type_constants::TYPE_TUPLE
      var arity = tc_ptype_arg1(tc, type_kind)
      var sb = sb_new()
      sb_append(sb, "(")
      for ti in 0..arity
        if ti > 0
          sb_append(sb, ", ")
        end
        var et = typecheck_util::tc_tuple_elem_type(tc, type_kind, ti)
        sb_append(sb, tc_type_name_full(tc, et))
      end
      sb_append(sb, ")")
      return sb_to_string(sb)
    end
    var base_name = tc_type_name(base)
    var arg1 = tc_ptype_arg1(tc, type_kind)
    var arg2 = tc_ptype_arg2(tc, type_kind)
    # Vec ptypes store the element struct_idx in arg2 as metadata (for
    # Vec<Point> vs Vec<Triple> deduplication), NOT a second type arg.
    # Render as "Vec<Elem>" using the cached ptype name for struct elements,
    # else the bare element-type name.
    if base == type_constants::TYPE_VEC
      var cached_name = tc_ptype_name(tc, type_kind)
      if str_byte_len(cached_name) > 0
        return "#{base_name}<#{cached_name}>"
      end
      return "#{base_name}<#{tc_type_name_full(tc, arg1)}>"
    end
    # QZ0200_DIAG_FORMATS_STRUCT_PTYPES_AS_UNKNOWN: User-defined generic
    # struct ptypes carry their outer struct name in ptype_name (set at
    # tc_parse_type's user-struct branch). Render as "Box<Inner>" so QZ0200
    # diagnostics show the struct name instead of "Struct<unknown>".
    if base == type_constants::TYPE_STRUCT
      var struct_pname = tc_ptype_name(tc, type_kind)
      if str_byte_len(struct_pname) > 0
        if arg1 == 0 or arg1 == type_constants::TYPE_ERROR
          return struct_pname
        end
        if arg2 != 0
          return "#{struct_pname}<#{tc_type_name_full(tc, arg1)}, #{tc_type_name_full(tc, arg2)}>"
        end
        return "#{struct_pname}<#{tc_type_name_full(tc, arg1)}>"
      end
    end
    # TYPE_ENUM ptypes (per typecheck.qz:1644-1654) store the inner-element
    # source name in ptype_name, NOT the outer enum name. Best-effort: render
    # the inner name with brackets so the user sees *something* instead of
    # "Enum<unknown>" — a follow-up should encode the outer enum name too.
    if base == type_constants::TYPE_ENUM
      var enum_inner = tc_ptype_name(tc, type_kind)
      if str_byte_len(enum_inner) > 0
        return "Enum<#{enum_inner}>"
      end
    end
    # HB-DOG.13: Fn ptypes store the fn-type registry id in arg1; the
    # registry holds the original `Fn(...): R` annotation. Render that
    # verbatim instead of the generic `Function<arg1>` fallback — which
    # would feed a garbage type_ann (`Function<Int>`) into binding-time
    # type reconstruction, losing the return type of every inferred
    # function-typed local (`f = dev.clock` → `f()` then defaults to Int).
    if base == type_constants::TYPE_FUNCTION
      var fn_full_ann = typecheck_registry::tc_fn_type_annotation(tc, arg1)
      if str_byte_len(fn_full_ann) > 0
        return fn_full_ann
      end
    end
    if arg2 != 0
      return "#{base_name}<#{tc_type_name_full(tc, arg1)}, #{tc_type_name_full(tc, arg2)}>"
    end
    return "#{base_name}<#{tc_type_name_full(tc, arg1)}>"
  end
  # Intersection types: render as "A & B"
  if typecheck_registry::tc_is_intersection_type(type_kind)
    return typecheck_registry::tc_intersection_display_name(tc, type_kind)
  end
  # Union types: render as "A | B"
  if typecheck_registry::tc_is_union_type(type_kind)
    return typecheck_registry::tc_union_display_name(tc, type_kind)
  end
  # Record types: render as "{ x: Int, y: String }"
  if typecheck_registry::tc_is_record_type(type_kind)
    return typecheck_registry::tc_record_display_name(tc, type_kind)
  end
  # Newtypes: look up registered name
  if tc_is_newtype(type_kind)
    var nt_idx = type_kind - type_constants::TYPE_NEWTYPE_BASE
    var nt_names = tc.registry.newtype_names
    if nt_idx >= 0 and nt_idx < nt_names.size
      return nt_names[nt_idx]
    end
  end
  return tc_type_name(type_kind)
end


## Register a struct definition in the type checker context.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Struct definition node
def tc_register_struct_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void can Diag
  # Extract struct name from str1
  var name = ast::ast_get_str1(ast_storage, node)
  # Duplicate struct detection moved to tc_program (AST-level check avoids
  # false positives from Phase 4.0a + tc_program double-registration)
  
  # Get field definitions from children (slot 10)
  var fields = ast::ast_get_children(ast_storage, node)
  var field_count = fields.size
  
  # Build field name, type, annotation, and default value vectors
  var field_names = vec_new<String>()
  var field_types = vec_new()
  var field_annotations = vec_new<String>()
  var field_defaults = vec_new()

  for i in 0..field_count
    var field = fields[i]
    var field_name = ast::ast_get_str1(ast_storage, field)
    var field_type_ann = ast::ast_get_str2(ast_storage, field)

    field_names.push(field_name)
    field_annotations.push(field_type_ann)
    
    # Parse field type annotation
    var field_type = tc_parse_type(tc, field_type_ann)
    # Defer unknown-type check to after type_params are known (see below)
    field_types.push(field_type)
    
    # Extract default value AST node handle (0 = no default)
    var default_val = ast::ast_field_default(ast_storage, field)
    field_defaults.push(default_val)
  end
  
  # Extract type parameters from str2 (e.g., "<T, U>" or "")
  # Strip angle brackets — parser stores "<T, U>" but we need "T, U"
  var type_params_raw = ast::ast_get_str2(ast_storage, node)
  var type_params = type_params_raw
  if str_byte_len(type_params) > 1
    if str_byte_at(type_params, 0) == '<'
      type_params = str_byte_slice(type_params, 1, str_byte_len(type_params) - 1)
    end
  end

  # Extract linear flag from AST (stored in rights slot)
  var is_linear = ast::ast_get_right(ast_storage, node)

  # Check for unknown types in struct fields (must be after type_params extraction)
  for sf_i in 0..field_count
    if field_types[sf_i] == type_constants::TYPE_ERROR
      var sf_ann = field_annotations[sf_i]
      # Skip if it matches a struct type parameter (e.g., T in struct GBox<T>)
      var is_tp = 0
      if str_byte_len(type_params) > 0
        # Strip spaces from type_params (parser stores "T, U" but tc_is_type_param
        # splits on comma only, leaving " U" which won't match "U")
        var tp_clean = str_replace(type_params, " ", "")
        is_tp = tc_is_type_param(sf_ann, tp_clean)
      end
      if is_tp == 0
        var sf_line = ast::ast_get_line(ast_storage, node)
        var sf_col = ast::ast_get_col(ast_storage, node)
        var sf_suggestion = typecheck_registry::tc_suggest_type(tc, sf_ann)
        error("Unknown type '#{sf_ann}'#{sf_suggestion}", sf_line, sf_col)
      end
    end
  end

  # Register struct using existing helper
  typecheck_registry::tc_register_struct(tc, name, field_names, field_types, type_params, field_annotations, is_linear, field_defaults)

  # V3 (§14.12.5) — record the `@value` flag (AST lefts slot) so the QZ0221
  # erased-@value-boundary diagnostic can key on the struct's type id. No-op for
  # plain structs (the setter early-returns on 0).
  typecheck_registry::tc_mark_struct_value(tc, name, ast::ast_struct_is_value(ast_storage, node))

  # R1.1 (PF3 Family-3 opt-out) — record the `@repr(C)` flag (AST ops slot) so the
  # QZ0221 diagnostic can positively exclude known-Boxed @repr(C) structs from the
  # conservative flip-eligibility over-approximation. No-op for non-repr(C) structs
  # (the setter early-returns on 0). Inert at gate-0 (QZ0221's gate short-circuits).
  typecheck_registry::tc_mark_struct_repr_c(tc, name, ast::ast_struct_get_repr_c(ast_storage, node))

  # P4.D.1: Detect row-var-kinded type params (lowercase-first names) and
  # register fresh effect-row variables for them. Mirrors tc_function
  # (typecheck.qz:4356-4371) and tc_register_trait_def (line 2821-2836)
  # at the struct level. Stored on the struct registry; future struct-
  # method body checks (4D.2) load these into tc.func_row_var_* before
  # walking method bodies so `def Stream.next<T, e>(self): ... can e`
  # resolves correctly.
  var _struct_row_names = vec_new<String>()
  var _struct_row_ids = vec_new<Int>()
  if str_byte_len(type_params) > 0
    var _struct_tp_parts = str_split(type_params, ",")
    for _stp_i in 0.._struct_tp_parts.size
      var _stp_name_raw = _struct_tp_parts[_stp_i]
      # str_split leaves a leading space on every part after the first
      # ("T, e" → ["T", " e"]). Trim before convention check.
      var _stp_name = _stp_name_raw
      while str_byte_len(_stp_name) > 0 and str_byte_at(_stp_name, 0) == ' '
        _stp_name = str_byte_slice(_stp_name, 1, str_byte_len(_stp_name))
      end
      while str_byte_len(_stp_name) > 0 and str_byte_at(_stp_name, str_byte_len(_stp_name) - 1) == ' '
        _stp_name = str_byte_slice(_stp_name, 0, str_byte_len(_stp_name) - 1)
      end
      if typecheck_util::tc_name_is_row_var(_stp_name)
        _struct_row_names.push(_stp_name)
        _struct_row_ids.push(typecheck_util::tc_erv_fresh(tc))
      end
    end
  end
  if _struct_row_names.size > 0
    var _sl = typecheck_registry::tc_lookup_struct(tc, name)
    var _struct_idx = match _sl
      Found(v) => v
      NotFound => -1
    end
    if _struct_idx >= 0
      typecheck_registry::tc_set_struct_row_vars(tc, _struct_idx, _struct_row_names, _struct_row_ids)
    end
  end
end

## Register an enum definition in the type checker context.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Enum definition node
def tc_register_enum_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  # Extract enum name from str1
  var name = ast::ast_get_str1(ast_storage, node)

  # Duplicate enum detection moved to tc_program (AST-level check avoids
  # false positives from Phase 4.0a + tc_program double-registration)
  
  # Get variant definitions from children (slot 10)
  var variants = ast::ast_get_children(ast_storage, node)
  var variant_count = variants.size
  
  # Build variant name, payload, and annotation vectors
  var variant_names = vec_new<String>()
  var variant_payloads = vec_new()
  var all_variant_annotations = vec_new()

  for i in 0..variant_count
    var variant = variants[i]
    var variant_name = ast::ast_get_str1(ast_storage, variant)

    variant_names.push(variant_name)

    # Get variant payload types and annotations (if any)
    var payload_fields = ast::ast_get_children(ast_storage, variant)
    var payload_types = vec_new()
    var payload_anns = vec_new<String>()
    if payload_fields > 0
      var pf_count = payload_fields.size
      for j in 0..pf_count
        var pf = payload_fields[j]
        var ann = ast::ast_get_str2(ast_storage, pf)
        payload_anns.push(ann)
        payload_types.push(tc_parse_type(tc, ann))
      end
    end
    
    variant_payloads.push(payload_types)
    all_variant_annotations.push(payload_anns)
  end
  
  # Extract type parameters from str2 (e.g., "<T, E>" or "")
  # Strip angle brackets — parser stores "<T, E>" but we need "T, E"
  var type_params_raw = ast::ast_get_str2(ast_storage, node)
  var type_params = type_params_raw
  if str_byte_len(type_params) > 1
    if str_byte_at(type_params, 0) == '<'
      type_params = str_byte_slice(type_params, 1, str_byte_len(type_params) - 1)
    end
  end

  # Register enum using existing helper
  typecheck_registry::tc_register_enum(tc, name, variant_names, variant_payloads, type_params, all_variant_annotations)

  # Invalidate parse_type_cache: payload type annotations parsed at line 2816
  # may have referenced THIS enum (self-recursive payloads like
  # `Object(fields: Map<String, JsonValue>)`) before its name was registered,
  # caching a stale Map<String, Int> result. Clearing forces re-parse at next
  # access — by then the enum is known. Closes
  # docs/bugs/JSON_TYPED_PAYLOAD_MAP_VALUE_TYPE_LOSS.md.
  tc.parse_type_cache = map_new<String, Int>()
end

## Register a trait definition in the type checker context.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Trait definition node (NodeTraitDef)
def tc_register_trait_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  # Extract trait name from str1
  var name = ast::ast_get_str1(ast_storage, node)

  # Extract super-traits from str2 ("+"-separated or empty)
  var super_traits = ast::ast_get_str2(ast_storage, node)

  # Extract type parameters from extras slot (e.g., "<T>" or "<K, V>")
  var type_params_raw = as_string(ast::ast_get_extra(ast_storage, node))
  var type_params = ""
  if str_byte_len(type_params_raw) > 0
    # Strip angle brackets: "<T, U>" -> "T, U"
    if str_byte_at(type_params_raw, 0) == '<'
      type_params = str_byte_slice(type_params_raw, 1, str_byte_len(type_params_raw) - 1)
    else
      type_params = type_params_raw
    end
    # Strip spaces: "T, U" -> "T,U"
    type_params = str_replace(type_params, " ", "")
  end

  # Set trait type params in scope so tc_parse_type can resolve T -> TYPE_INT
  # Include Self as a pseudo-type-param so Self resolves to TYPE_INT in trait defs
  if str_byte_len(type_params) > 0
    tc.scope.trait_type_params = "Self,#{type_params}"
  else
    tc.scope.trait_type_params = "Self"
  end

  # P3.F.3: Trait-scoped row-var env. Same mechanism as F.1 for functions —
  # lowercase type-params become row vars that method-level `can` clauses
  # and Fn-type params inside the trait resolve through. Allows
  # `trait Iterator<T, e>; def next(self): Option<T> can e end` to express
  # "every Iterator impl declares the effects of its next() method via e,
  # and all call sites propagate that row."
  typecheck_util::tc_func_row_var_env_reset(tc)
  if str_byte_len(type_params) > 0
    var _trait_tp_parts = str_split(type_params, ",")
    for _ti in 0.._trait_tp_parts.size
      var _tp_name = _trait_tp_parts[_ti]
      if typecheck_util::tc_name_is_row_var(_tp_name)
        typecheck_util::tc_func_row_var_bind(tc, _tp_name)
      end
    end
  end

  # Get method definitions from children
  var methods = ast::ast_get_children(ast_storage, node)
  var method_count = methods.size

  # Build method name, signature, and default body vectors
  var method_names = vec_new<String>()
  var method_sigs = vec_new()
  var method_defaults = vec_new()
  # P3.F.3: per-method effect row, parallel to method_names.
  var method_effect_rows = vec_new()

  for i in 0..method_count
    var method = methods[i]
    var method_name = ast::ast_get_str1(ast_storage, method)

    method_names.push(method_name)

    # Check if method has a body (right slot >= 0 means default implementation)
    # Abstract methods have body = -1 sentinel
    var body = ast::ast_get_right(ast_storage, method)
    if body >= 0
      method_defaults.push(1)
    else
      method_defaults.push(0)
    end

    # Get parameters from left (slot 7)
    var params = ast::ast_get_left(ast_storage, method)
    var param_count = vec_size(params)

    # Build parameter type vector
    var param_types = map(params, p: Int -> tc_parse_type(tc, ast::ast_get_str2(ast_storage, p)))

    # Get return type from str2
    var return_type_ann = ast::ast_get_str2(ast_storage, method)
    var return_type = tc_parse_type(tc, return_type_ann)

    # Create method signature: [param_types, return_type]
    var sig = [param_types, return_type]
    method_sigs.push(sig)

    # P3.F.3: resolve the method's `can` clause. The AST stored the parsed
    # row (ast_func_has_can_row / ast_func_get_can_* helpers). Reuse the
    # same reinterpretation trick as tc_attach_func_effect_row — a single
    # lowercase label in scope is really a tail-var reference.
    var _mth_row_id = -1
    if ast::ast_func_has_can_row(ast_storage, method) == 1
      var _mth_label_csv = ast::ast_func_get_can_label_csv(ast_storage, method)
      var _mth_tail_str = ast::ast_func_get_can_tail(ast_storage, method)
      if str_byte_len(_mth_tail_str) == 0 and str_byte_len(_mth_label_csv) > 0
        var _mth_parts = str_split(_mth_label_csv, ",")
        if _mth_parts.size == 1
          var _mth_cand = _mth_parts[0]
          if typecheck_util::tc_name_is_row_var(_mth_cand)
            if typecheck_util::tc_func_row_var_lookup(tc, _mth_cand) > 0
              _mth_tail_str = _mth_cand
              _mth_label_csv = ""
            end
          end
        end
      end
      var _mth_label_ids = vec_new()
      if str_byte_len(_mth_label_csv) > 0
        var _mth_lbl_parts = str_split(_mth_label_csv, ",")
        for _mli in 0.._mth_lbl_parts.size
          var _mth_lbl = _mth_lbl_parts[_mli]
          if str_byte_len(_mth_lbl) > 0
            _mth_label_ids.push(string_intern::intern_id(tc.interner, _mth_lbl))
          end
        end
      end
      var _mth_tail_var = -1
      if str_byte_len(_mth_tail_str) > 0
        var _mth_bound = typecheck_util::tc_func_row_var_lookup(tc, _mth_tail_str)
        if _mth_bound > 0
          _mth_tail_var = _mth_bound
        else
          _mth_tail_var = typecheck_util::tc_erv_fresh(tc)
        end
      end
      _mth_row_id = typecheck_registry::tc_row_new(tc, _mth_label_ids, _mth_tail_var)
    end
    method_effect_rows.push(_mth_row_id)
  end

  # Clear trait type params scope
  tc.scope.trait_type_params = ""

  # Register trait using helper
  typecheck_registry::tc_register_trait(tc, name, method_names, method_sigs, method_defaults, super_traits, type_params)
  # P3.F.3: back-fill the row + generalized-erv slots on the just-registered
  # trait. tc_register_trait defaults both to empty/-1, so order doesn't
  # matter for builtin traits (Send/Sync/Drop/Iterator/AsyncIterator) which
  # never get here.
  var _trait_lookup = typecheck_registry::tc_lookup_trait(tc, name)
  var _trait_idx = match _trait_lookup
    Found(v) => v
    NotFound => -1
  end
  if _trait_idx >= 0
    typecheck_registry::tc_set_trait_method_effect_rows(tc, _trait_idx, method_effect_rows)
    typecheck_registry::tc_set_trait_generalized_ervs(tc, _trait_idx, tc.func_row_var_ids)
  end
end

## Register a type alias in the type checker context.
##
## Type aliases are transparent synonyms - the alias name resolves
## to the underlying type during type checking.
##
## Parameters:
##   tc           - Type checker context
##   name         - Alias name (e.g., "IntList")
##   aliased_type - The type being aliased (e.g., "Array<Int>")
def tc_register_type_alias(tc: TypecheckState, name: String, aliased_type: String): Void
  var alias_names = tc.registry.type_alias_names
  var alias_types = tc.registry.type_alias_types
  alias_names.push(name)
  alias_types.push(aliased_type)
end

## Look up a type alias by name.
##
## Parameters:
##   tc   - Type checker context
##   name - Alias name to look up
##
## Returns: The aliased type string, or "" if not found
def tc_lookup_type_alias(tc: TypecheckState, name: String): String
  var alias_names = tc.registry.type_alias_names
  var alias_types = tc.registry.type_alias_types
  var count = alias_names.size

  # Exact match first
  for i in 0..count
    var alias_name = alias_names[i]
    if alias_name == name
      return alias_types[i]
    end
  end

  # Fallback: search for alias ending with $name (imported alias)
  var suffix = "$#{name}"
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var alias_name = alias_names[i]
    var name_len = str_byte_len(alias_name)
    if name_len >= suffix_len
      if str_byte_slice(alias_name, name_len - suffix_len, name_len).eq(suffix)
        # Skip private type aliases (contain $$)
        if not alias_name.contains("$$")
          return alias_types[i]
        end
      end
    end
  end

  return ""
end

## Register a type alias definition from an AST node.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Type alias node (node_constants$NODE_TYPE_ALIAS)
def tc_register_type_alias_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  # Extract alias name from str1
  var name = ast::ast_get_str1(ast_storage, node)

  # Extract aliased type from str2
  var aliased_type = ast::ast_get_str2(ast_storage, node)

  # Register the alias
  tc_register_type_alias(tc, name, aliased_type)
end

## Validate a type alias for self-referential definitions, cycles, and unknown targets.
def tc_validate_type_alias(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void can Diag
  var name = ast::ast_get_str1(ast_storage, node)
  var target = ast::ast_get_str2(ast_storage, node)
  var line = ast::ast_get_line(ast_storage, node)
  var col = ast::ast_get_col(ast_storage, node)

  # Self-referential check: type X = X
  # NOTE: Must use .eq() for string content comparison, not ==
  # (== compiles to pointer comparison on separate string allocations)
  if name == target
    error("Recursive type alias: '#{name}' refers to itself", line, col)
    return
  end

  # Cycle detection: follow the alias chain from target
  var alias_names = tc.registry.type_alias_names
  var alias_types = tc.registry.type_alias_types
  var count = alias_names.size
  var current = target
  for steps in 0..count
    var next = ""
    for j in 0..count
      var an = alias_names[j]
      if an == current
        next = alias_types[j]
      end
    end
    if str_byte_len(next) == 0
      break
    end
    if next == name
      error("Recursive type alias cycle involving '#{name}'", line, col)
      return
    end
    current = next
  end

  # Check if the final resolved type is known. Since we verified no cycles,
  # tc_parse_type won't infinite loop during alias resolution.
  var resolved = tc_parse_type(tc, current)
  if resolved == type_constants::TYPE_ERROR
    error("Type alias '#{name}' refers to unknown type '#{target}'", line, col)
  end
end

## Binary DSL validators — sub-phase 1.2.
##
## Enforces the invariants locked in `docs/design/BINARY_DSL.md`:
##   QZ0950  binary {} block total bit width must be a positive multiple of 8
##   QZ0951  packed struct(uN) field widths must sum to exactly N
##   QZ0952  multi-byte field must start at a byte-aligned bit offset
##   QZ0953  sub-byte types (u1..u7, i1..i7) only legal inside these blocks
##
## These validators inspect the NODE_BINARY_FIELD children directly.
## Sub-phase 1.3 will lower the same nodes into MIR opcodes; sub-phase
## 1.4 emits shift/mask codegen from the lowered layout.

## Parse a numeric bit width out of `u<digits>[le|be]?` / `i<digits>[le|be]?` /
## `f<digits>[le|be]?`. Returns (width, is_float) packed as `width * 2 + is_float`,
## or 0 if the spec doesn't match that shape.
def _tc_bin_parse_numeric_width(spec: String): Int
  var n = str_byte_len(spec)
  return 0 if n < 2
  var head = str_byte_at(spec, 0)
  var is_int = 0
  var is_float = 0
  # 'u' = 117, 'i' = 105, 'f' = 102
  if head == 117 or head == 105
    is_int = 1
  elsif head == 102
    is_float = 1
  else
    return 0
  end
  var i = 1
  var width = 0
  var saw_digit = 0
  while i < n
    var d = str_byte_at(spec, i)
    if d < 48 or d > 57
      break
    end
    width = (width * 10) + (d - 48)
    saw_digit = 1
    i = i + 1
  end
  return 0 if saw_digit == 0
  # Trailing suffix must be "", "le", or "be".
  if i == n
    return width * 2 + is_float
  end
  if i + 2 != n
    return 0
  end
  var s1 = str_byte_at(spec, i)
  var s2 = str_byte_at(spec, i + 1)
  # 'l'=108, 'e'=101, 'b'=98
  if (s1 == 108 and s2 == 101) or (s1 == 98 and s2 == 101)
    return width * 2 + is_float
  end
  return 0
end

## Classify a parsed binary field type-spec (str2 of NODE_BINARY_FIELD).
## Return values:
##   -1  multi-byte scalar  (u/i 16/32/64 with endianness, f32, f64)  — must be byte-aligned
##    0  variable-width     (bytes, cstring, pstring, arrays, unknown) — byte-aligned by construction
##    N  (>0)               sub-byte or byte-aligned bit-packed field, contributes N bits
## The codegen pass in 1.4 owns exhaustive spec parsing.
def _tc_bin_spec_kind(spec: String): Int
  return 0 if str_byte_len(spec) == 0
  var packed = _tc_bin_parse_numeric_width(spec)
  if packed > 0
    var is_float = packed % 2
    var width = packed / 2
    return 0 if width <= 0
    # Floats are always multi-byte and must be byte-aligned.
    if is_float == 1
      return -1
    end
    # u16/u32/u64 (and signed) are classical multi-byte loads.
    if width == 16 or width == 32 or width == 64
      return -1
    end
    # Anything else — u1..u15 (except 8), u17..u63 that aren't 32, u65+ etc.
    return width
  end
  # Variable — bytes / cstring / pstring(...) / bytes(...) / array forms / unknown
  return 0
end

## Map a NODE_BINARY_FIELD type spec to a Quartz-level type annotation.
## Integer/sub-byte fields → "Int", f32 → "F32", f64 → "F64".
## cstring / pstring(...) → "String". bytes / bytes(n) → "Bytes".
## Arrays of primitives — [T]/[T;n]/[T;field] — present as "Vec<Int>" at
## the struct level. Floats-in-arrays are not yet supported (would need
## "Vec<F32>"/"Vec<F64>"); arrays of nested binary blocks are a Phase 2d
## follow-up in the handoff. Any unrecognized array element falls back to
## "Int" so type-name registration doesn't fail.
def _tc_bin_field_annotation(spec: String): String
  var n = str_byte_len(spec)
  return "Int" if n == 0
  var packed = _tc_bin_parse_numeric_width(spec)
  if packed > 0
    var is_float = packed % 2
    var width = packed / 2
    if is_float == 1
      return "F32" if width == 32
      return "F64" if width == 64
      return "Int"
    end
    return "Int"
  end
  if spec == "cstring"
    return "String"
  end
  if n >= 7
    if str_byte_slice(spec, 0, 7).eq("pstring")
      return "String"
    end
  end
  # bytes / bytes(n) — map to Bytes struct (std/bytes.qz).
  if spec == "bytes"
    return "Bytes"
  end
  if n >= 6
    if str_byte_slice(spec, 0, 6).eq("bytes(")
      return "Bytes"
    end
  end
  # Array forms [T]/[T;n]/[T;field] — present as Vec<Int> for integer
  # primitives. Floats in arrays fall through to the catch-all Int below.
  if n >= 3 and str_byte_at(spec, 0) == 91
    # Find the element spec: substring between '[' and either ';' or ']'.
    var end_idx = 1
    while end_idx < n
      var ch = str_byte_at(spec, end_idx)
      if ch == 59 or ch == 93
        break
      end
      end_idx = end_idx + 1
    end
    if end_idx > 1
      var elem = str_byte_slice(spec, 1, end_idx)
      var elem_packed = _tc_bin_parse_numeric_width(elem)
      if elem_packed > 0 and (elem_packed % 2) == 0
        # Integer primitive element — struct field is Vec<Int>.
        return "Vec<Int>"
      end
    end
  end
  return "Int"
end

## Helper — push a field into the accumulators, dedup by name. Same-name +
## same-annotation merges silently; different annotations are silently
## skipped here (the validator catches that as QZ0957).
def _tc_bin_push_field(field_names: Vec<String>, field_types: Vec<Int>, field_annotations: Vec<String>, field_defaults: Vec<Int>, fname: String, ann: String, tid: Int): Void
  var n = field_names.size
  for i in 0..n
    var existing = field_names[i]
    if existing.eq(fname)
      return
    end
  end
  field_names.push(fname)
  field_types.push(tid)
  field_annotations.push(ann)
  field_defaults.push(0)
end

## Register a `type Name = binary { ... }` block as a struct-like type.
## Fields appear as regular struct fields for literal construction and access;
## pad fields (name == "_" or "") are omitted. Discriminated-union arm fields
## (Phase 2 Track B) are flattened into the outer struct — v1 design; an
## implicit enum sugar can layer on top later. Marks the struct as DSL kind 1.
def tc_register_binary_block_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  var name = ast::ast_get_str1(ast_storage, node)
  var fields = ast::ast_get_children(ast_storage, node)
  var field_names = vec_new<String>()
  var field_types = vec_new<Int>()
  var field_annotations = vec_new<String>()
  var field_defaults = vec_new<Int>()
  if fields != 0
    var fcount = fields.size
    for fi in 0..fcount
      var f = fields[fi]
      var fkind = ast::ast_get_kind(ast_storage, f)
      if fkind == node_constants::NODE_BINARY_UNION
        # Flatten every arm's fields into the outer struct. Duplicate names
        # across arms with matching annotations merge into one slot.
        var arms = ast::ast_get_children(ast_storage, f)
        if arms != 0
          var acount = arms.size
          for ai in 0..acount
            var arm = arms[ai]
            var arm_fields = ast::ast_get_children(ast_storage, arm)
            if arm_fields != 0
              var afcount = arm_fields.size
              for afi in 0..afcount
                var af = arm_fields[afi]
                var afname = ast::ast_get_str1(ast_storage, af)
                if str_byte_len(afname) == 0 or afname.eq("_")
                  continue
                end
                var aspec = ast::ast_get_str2(ast_storage, af)
                var aann = _tc_bin_field_annotation(aspec)
                var atid = tc_parse_type(tc, aann)
                if atid == type_constants::TYPE_ERROR
                  atid = type_constants::TYPE_INT
                  aann = "Int"
                end
                _tc_bin_push_field(field_names, field_types, field_annotations, field_defaults, afname, aann, atid)
              end
            end
          end
        end
        continue
      end
      var fname = ast::ast_get_str1(ast_storage, f)
      if str_byte_len(fname) == 0 or fname.eq("_")
        continue
      end
      var spec = ast::ast_get_str2(ast_storage, f)
      var ann = _tc_bin_field_annotation(spec)
      var tid = tc_parse_type(tc, ann)
      if tid == type_constants::TYPE_ERROR
        tid = type_constants::TYPE_INT
        ann = "Int"
      end
      _tc_bin_push_field(field_names, field_types, field_annotations, field_defaults, fname, ann, tid)
    end
  end
  typecheck_registry::tc_register_struct(tc, name, field_names, field_types, "", field_annotations, 0, field_defaults)
  typecheck_registry::tc_mark_struct_binary_dsl(tc, name, 1, 0)
end

## Synthesize `.encode()` and `Type.decode(bytes)` method signatures for a
## binary block. Runs in its own phase after all imports / types / traits
## have been registered, so `Bytes` and `ParseError` resolve.
##
## Bodies come later — MIR lowering diverts calls into the opaque
## MIR_BINARY_PACK / MIR_BINARY_UNPACK opcodes and codegen emits the
## real shift/mask/load sequence. These signatures exist purely so that
## call sites typecheck and name resolution flows through cleanly.
def tc_synth_binary_block_methods(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  var type_name = ast::ast_get_str1(ast_storage, node)
  var struct_tid = type_constants::TYPE_STRUCT
  var bytes_tid = tc_parse_type(tc, "Bytes")
  if bytes_tid == type_constants::TYPE_ERROR
    bytes_tid = type_constants::TYPE_INT
  end
  var err_tid = tc_parse_type(tc, "ParseError")
  if err_tid == type_constants::TYPE_ERROR
    err_tid = type_constants::TYPE_INT
  end
  var result_tid = tc_make_ptype(tc, type_constants::TYPE_RESULT, struct_tid, err_tid)
  var decode_params = vec_new<Int>()
  decode_params.push(bytes_tid)
  typecheck_registry::tc_register_function(tc, "#{type_name}$decode", decode_params, result_tid, 1)
  var encode_params = vec_new<Int>()
  encode_params.push(struct_tid)
  typecheck_registry::tc_register_function(tc, "#{type_name}$encode", encode_params, bytes_tid, 1)
end

## Synthesize `.encode()`, `Type.decode(bytes)`, and `as` for a packed
## struct. `.with { ... }` is synthesized by the parser in STEP 5 —
## here we only wire encode/decode, which share the same codegen path
## as binary blocks (MIR_BINARY_PACK / MIR_BINARY_UNPACK). The `as`
## bitcast is routed through the binary-op typecheck in STEP 3.
def tc_synth_packed_struct_methods(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  tc_synth_binary_block_methods(tc, ast_storage, node)
end

## Register a `packed struct(uN) Name ... end` as a struct-like type.
## Each named bit-field becomes an `Int` struct field (pad `_` omitted).
## Backing width is preserved on the struct entry for the `as uN` / `.with {}`
## operators synthesized in STEP 2+.
def tc_register_packed_struct_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  var name = ast::ast_get_str1(ast_storage, node)
  var backing = ast::ast_get_int_val(ast_storage, node)
  var fields = ast::ast_get_children(ast_storage, node)
  var field_names = vec_new<String>()
  var field_types = vec_new<Int>()
  var field_annotations = vec_new<String>()
  var field_defaults = vec_new<Int>()
  if fields != 0
    var fcount = fields.size
    for fi in 0..fcount
      var f = fields[fi]
      var fname = ast::ast_get_str1(ast_storage, f)
      if str_byte_len(fname) == 0 or fname.eq("_")
        continue
      end
      field_names.push(fname)
      field_types.push(type_constants::TYPE_INT)
      field_annotations.push("Int")
      field_defaults.push(0)
    end
  end
  typecheck_registry::tc_register_struct(tc, name, field_names, field_types, "", field_annotations, 0, field_defaults)
  typecheck_registry::tc_mark_struct_binary_dsl(tc, name, 2, backing)
end

## Validate a `type Name = binary { ... }` block.
##
## Phase 2 Track B:
##   QZ0954  discriminator field referenced by `match` is missing from block
##   QZ0955  discriminator field must be an integer primitive (not float/
##           variable-width — sub-byte and byte-aligned integers OK)
##   QZ0956  duplicate arm tag value within a union
##   QZ0957  cross-arm field-name collision with conflicting annotations
def tc_validate_binary_block(ast_storage: ast::AstStorage, node: AstNodeId): Void can Diag
  var name = ast::ast_get_str1(ast_storage, node)
  var line = ast::ast_get_line(ast_storage, node)
  var col = ast::ast_get_col(ast_storage, node)
  var fields = ast::ast_get_children(ast_storage, node)
  var field_count = 0
  if fields != 0
    field_count = fields.size
  end
  if field_count == 0
    error("QZ0950: binary {} block '#{name}' is empty — total field width must be a positive multiple of 8 bits", line, col)
    return
  end
  # Track prior field specs so unions can resolve their discriminator.
  var seen_field_names = vec_new<String>()
  var seen_field_specs = vec_new<String>()
  # Cross-arm collision tracking: name → annotation string.
  var union_field_names = vec_new<String>()
  var union_field_anns = vec_new<String>()
  var cur_bit = 0
  var saw_variable = 0
  for fi in 0..field_count
    var f = fields[fi]
    var fkind = ast::ast_get_kind(ast_storage, f)
    if fkind == node_constants::NODE_BINARY_UNION
      var uline = ast::ast_get_line(ast_storage, f)
      var ucol = ast::ast_get_col(ast_storage, f)
      var disc_name = ast::ast_get_str1(ast_storage, f)
      # Unions start a fresh byte-aligned region.
      if (cur_bit % 8) != 0
        var pad_bits = 8 - (cur_bit % 8)
        error("QZ0952: binary union 'match #{disc_name}' in '#{name}' starts at bit #{str_from_int(cur_bit)}; insert a '_: u#{str_from_int(pad_bits)}' pad to byte-align", uline, ucol)
      end
      # QZ0954: discriminator must be a prior named field.
      var disc_idx = -1
      var sn = seen_field_names.size
      for si in 0..sn
        if seen_field_names[si].eq(disc_name)
          disc_idx = si
        end
      end
      if disc_idx < 0
        error("QZ0954: binary union in '#{name}' references discriminator '#{disc_name}' which is not a prior field", uline, ucol)
      else
        # QZ0955: discriminator must be an integer primitive (byte or sub-byte,
        # not float, not variable-width).
        var disc_spec = seen_field_specs[disc_idx]
        var dpacked = _tc_bin_parse_numeric_width(disc_spec)
        var is_float = 0
        if dpacked > 0
          is_float = dpacked % 2
        end
        if dpacked == 0 or is_float == 1
          error("QZ0955: binary union discriminator '#{disc_name}: #{disc_spec}' in '#{name}' must be an integer primitive (u8, u16be, u4, etc.)", uline, ucol)
        end
      end
      # QZ0956 + QZ0957: per-arm validation.
      var arms = ast::ast_get_children(ast_storage, f)
      var acount = 0
      if arms != 0
        acount = arms.size
      end
      var seen_tags = vec_new<Int>()
      for ai in 0..acount
        var arm = arms[ai]
        var arm_line = ast::ast_get_line(ast_storage, arm)
        var arm_col = ast::ast_get_col(ast_storage, arm)
        var tag = ast::ast_get_int_val(ast_storage, arm)
        var stn = seen_tags.size
        var dup = 0
        for ti in 0..stn
          if seen_tags[ti] == tag
            dup = 1
          end
        end
        if dup == 1
          error("QZ0956: binary union in '#{name}' has duplicate arm tag '#{str_from_int(tag)}'", arm_line, arm_col)
        end
        seen_tags.push(tag)
        # Walk arm fields. Each arm's sub-byte accumulation must sum to a
        # multiple of 8 bits independently (Track B v1 keeps arms self-contained).
        var arm_fields = ast::ast_get_children(ast_storage, arm)
        var afc = 0
        if arm_fields != 0
          afc = arm_fields.size
        end
        var arm_bit = 0
        for afi in 0..afc
          var af = arm_fields[afi]
          var afspec = ast::ast_get_str2(ast_storage, af)
          var afname = ast::ast_get_str1(ast_storage, af)
          var afline = ast::ast_get_line(ast_storage, af)
          var afcol = ast::ast_get_col(ast_storage, af)
          var afkind = _tc_bin_spec_kind(afspec)
          if afkind == -1
            if (arm_bit % 8) != 0
              var pb = 8 - (arm_bit % 8)
              error("QZ0952: multi-byte field '#{afname}: #{afspec}' in arm #{str_from_int(tag)} of '#{name}' starts at bit #{str_from_int(arm_bit)}; insert a '_: u#{str_from_int(pb)}' pad to byte-align", afline, afcol)
            end
            var apw = _tc_bin_parse_numeric_width(afspec)
            arm_bit = arm_bit + (apw / 2)
          elsif afkind == 0
            if (arm_bit % 8) != 0
              var pb = 8 - (arm_bit % 8)
              error("QZ0952: variable-width field '#{afname}: #{afspec}' in arm #{str_from_int(tag)} of '#{name}' starts at bit #{str_from_int(arm_bit)}; insert a '_: u#{str_from_int(pb)}' pad to byte-align", afline, afcol)
            end
            arm_bit = 0
          else
            arm_bit = arm_bit + afkind
          end
          # QZ0957: cross-arm field-name collision must share wire spec.
          # We compare full spec strings (e.g. "u16be" vs "u32be") because
          # different wire widths both map to annotation "Int".
          if str_byte_len(afname) > 0 and (afname.eq("_") == 0)
            var un = union_field_names.size
            var prev_idx = -1
            for ui in 0..un
              if union_field_names[ui].eq(afname)
                prev_idx = ui
              end
            end
            if prev_idx < 0
              union_field_names.push(afname)
              union_field_anns.push(afspec)
            else
              if union_field_anns[prev_idx].eq(afspec) == 0
                error("QZ0957: binary union field '#{afname}' in '#{name}' is declared with conflicting wire layouts across arms ('#{union_field_anns[prev_idx]}' vs '#{afspec}')", afline, afcol)
              end
            end
          end
        end
        if (arm_bit % 8) != 0
          error("QZ0950: arm #{str_from_int(tag)} of '#{name}' is #{str_from_int(arm_bit)} bits — total field width within an arm must be a multiple of 8", arm_line, arm_col)
        end
      end
      saw_variable = 1
      cur_bit = 0
      continue
    end
    var spec = ast::ast_get_str2(ast_storage, f)
    var fline = ast::ast_get_line(ast_storage, f)
    var fcol = ast::ast_get_col(ast_storage, f)
    var fname = ast::ast_get_str1(ast_storage, f)
    var kind = _tc_bin_spec_kind(spec)
    if kind == -1
      # Multi-byte field: must start byte-aligned.
      if (cur_bit % 8) != 0
        var pad_bits = 8 - (cur_bit % 8)
        error("QZ0952: multi-byte field '#{fname}: #{spec}' in '#{name}' starts at bit #{str_from_int(cur_bit)}; insert a '_: u#{str_from_int(pad_bits)}' pad to byte-align", fline, fcol)
      end
      # Advance by the declared width (parsed from the spec).
      var packed_w = _tc_bin_parse_numeric_width(spec)
      var mb_width = packed_w / 2
      cur_bit = cur_bit + mb_width
    elsif kind == 0
      # Variable-width field: must start byte-aligned.
      if (cur_bit % 8) != 0
        var pad_bits = 8 - (cur_bit % 8)
        error("QZ0952: variable-width field '#{fname}: #{spec}' in '#{name}' starts at bit #{str_from_int(cur_bit)}; insert a '_: u#{str_from_int(pad_bits)}' pad to byte-align", fline, fcol)
      end
      saw_variable = 1
      cur_bit = 0
    else
      # Sub-byte or u8/i8: contributes `kind` bits.
      cur_bit = cur_bit + kind
    end
    # Record this field for union discriminator lookup.
    if str_byte_len(fname) > 0 and (fname.eq("_") == 0)
      seen_field_names.push(fname)
      seen_field_specs.push(spec)
    end
  end
  # Final width check. If a variable-width field was seen, the surrounding
  # sub-byte accumulation resets at each boundary — we only need cur_bit
  # (the trailing sub-byte run) to be a multiple of 8.
  if (cur_bit % 8) != 0
    error("QZ0950: binary {} block '#{name}' is #{str_from_int(cur_bit)} bits — total field width must be a multiple of 8. Tip: add a pad field — '_: u#{str_from_int(8 - (cur_bit % 8))}' — to round up", line, col)
  end
end

## Validate a `packed struct(uN) Name ... end` definition.
## Fields are bare bit widths; total must equal N exactly.
def tc_validate_packed_struct(ast_storage: ast::AstStorage, node: AstNodeId): Void can Diag
  var name = ast::ast_get_str1(ast_storage, node)
  var backing = ast::ast_get_int_val(ast_storage, node)
  var line = ast::ast_get_line(ast_storage, node)
  var col = ast::ast_get_col(ast_storage, node)
  var fields = ast::ast_get_children(ast_storage, node)
  var field_count = 0
  if fields != 0
    field_count = fields.size
  end
  var sum = 0
  for fi in 0..field_count
    var f = fields[fi]
    var w = ast::ast_get_int_val(ast_storage, f)
    if w <= 0
      var fline = ast::ast_get_line(ast_storage, f)
      var fcol = ast::ast_get_col(ast_storage, f)
      error("QZ0951: packed struct '#{name}' field widths must be positive integers", fline, fcol)
      return
    end
    sum = sum + w
  end
  if sum != backing
    error("QZ0951: packed struct(u#{str_from_int(backing)}) '#{name}' field widths sum to #{str_from_int(sum)} bits — must equal backing width (#{str_from_int(backing)}) exactly", line, col)
  end
end

## Register a newtype in the type checker context.
##
## Parameters:
##   tc           - Type checker context
##   name         - Newtype name (e.g., "UserId")
##   wrapped_type - The wrapped type (e.g., "Int")
##   is_strict    - 1 if @strict (rejects implicit conversion), 0 if loose
def tc_register_newtype(tc: TypecheckState, name: String, wrapped_type: String, is_strict: Int): Void
  var newtype_names = tc.registry.newtype_names
  var newtype_types = tc.registry.newtype_wrapped_types
  var type_id = type_constants::TYPE_NEWTYPE_BASE + newtype_names.size
  newtype_names.push(name)
  newtype_types.push(wrapped_type)
  tc.registry.newtype_type_ids.push(type_id)
  tc.registry.newtype_strict_flags.push(is_strict)
end

## Look up a newtype by name.
##
## Parameters:
##   tc   - Type checker context
##   name - Newtype name to look up
##
## Returns: The wrapped type string, or "" if not found
def tc_lookup_newtype(tc: TypecheckState, name: String): String
  var newtype_names = tc.registry.newtype_names
  var newtype_types = tc.registry.newtype_wrapped_types
  var count = newtype_names.size

  # Exact match first
  for i in 0..count
    var newtype_name = newtype_names[i]
    if newtype_name == name
      return newtype_types[i]
    end
  end

  # Fallback: search for newtype ending with $name (imported newtype)
  var suffix = "$#{name}"
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var newtype_name = newtype_names[i]
    var name_len = str_byte_len(newtype_name)
    if name_len >= suffix_len
      if str_byte_slice(newtype_name, name_len - suffix_len, name_len).eq(suffix)
        # Skip private newtypes (contain $$)
        if not newtype_name.contains("$$")
          return newtype_types[i]
        end
      end
    end
  end

  return ""
end

## Look up a newtype's distinct type ID by name.
## Returns: The unique type ID (>= type_constants$TYPE_NEWTYPE_BASE), or 0 if not found
def tc_lookup_newtype_id(tc: TypecheckState, name: String): Int
  var newtype_names = tc.registry.newtype_names
  var count = newtype_names.size

  for i in 0..count
    var newtype_name = newtype_names[i]
    if newtype_name == name
      return tc.registry.newtype_type_ids[i]
    end
  end

  # Fallback: suffix match for imported newtypes
  var suffix = "$#{name}"
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var newtype_name = newtype_names[i]
    var name_len = str_byte_len(newtype_name)
    if name_len >= suffix_len
      if str_byte_slice(newtype_name, name_len - suffix_len, name_len).eq(suffix)
        # Skip private newtypes (contain $$)
        if not newtype_name.contains("$$")
          return tc.registry.newtype_type_ids[i]
        end
      end
    end
  end

  return 0
end

## Check if a type ID is a newtype (1000..1999 range only)
def tc_is_newtype(t: TypeId): Bool = t >= type_constants::TYPE_NEWTYPE_BASE and t < type_constants::TYPE_UNION_BASE

## Check if a type ID is a parameterized type (Vec<Int>, Option<String>, etc.)
def tc_is_ptype(t: TypeId): Bool = t >= type_constants::PTYPE_BASE

## STRICT_NEWTYPES — true iff `t` is a strict newtype (`newtype @strict`),
## either as a bare newtype id (1000..1999) or as a ptype whose base is a
## strict newtype id (`Secret<Int>` etc.). Used to gate rejection at
## let / arg / return / branch / index / comparison / shift positions.
def tc_is_strict_newtype(tc: TypecheckState, t: TypeId): Bool
  if tc_is_newtype(t)
    var idx = t - type_constants::TYPE_NEWTYPE_BASE
    if idx >= 0 and idx < tc.registry.newtype_strict_flags.size
      return tc.registry.newtype_strict_flags[idx] == 1
    end
    return false
  end
  if tc_is_ptype(t)
    var base = tc_ptype_base(tc, t)
    if tc_is_newtype(base)
      var bidx = base - type_constants::TYPE_NEWTYPE_BASE
      if bidx >= 0 and bidx < tc.registry.newtype_strict_flags.size
        return tc.registry.newtype_strict_flags[bidx] == 1
      end
    end
  end
  return false
end

## Check if a type is a function type (bare TYPE_FUNCTION or Fn ptype).
def tc_type_is_function(tc: TypecheckState, t: TypeId): Bool
  if t == type_constants::TYPE_FUNCTION
    return true
  end
  if t >= type_constants::PTYPE_BASE
    return tc.ptype_bases[t - type_constants::PTYPE_BASE] == type_constants::TYPE_FUNCTION
  end
  return false
end

## Get the fn type registry ID from a Fn ptype. Returns -1 if not a Fn ptype.
def tc_fn_type_id(tc: TypecheckState, t: TypeId): Int
  if t >= type_constants::PTYPE_BASE
    if tc.ptype_bases[t - type_constants::PTYPE_BASE] == type_constants::TYPE_FUNCTION
      return tc.ptype_arg1s[t - type_constants::PTYPE_BASE]
    end
  end
  return -1
end

## Resolve a type to its base kind. For ptypes, returns the base type constant.
## For regular types, returns the type unchanged.
def tc_base_kind(tc: TypecheckState, t: TypeId): Int
  if t >= type_constants::PTYPE_BASE
    return tc.ptype_bases[t - type_constants::PTYPE_BASE]
  end
  return t
end

## Create or retrieve an interned parameterized type.
## Returns a unique type ID >= type_constants$PTYPE_BASE.
##
## Uses ptype_intern_map (Map<String, Int>) for O(1) lookup. Previously a
## linear scan over ptype_bases caused O(N²) typecheck blowup when heavy
## imports + struct-variant enums combined: each variant field's type-parse
## could touch tc_make_ptype several times, and the table was already
## populated with thousands of entries from imported modules.
def tc_make_ptype(tc: TypecheckState, base: Int, arg1: Int, arg2: Int): Int
  var key = "#{base}|#{arg1}|#{arg2}"
  var hit = tc.ptype_intern_map.get(key)
  if hit is Some
    return type_constants::PTYPE_BASE + hit!
  end
  var idx = tc.ptype_bases.size
  tc.ptype_bases.push(base)
  tc.ptype_arg1s.push(arg1)
  tc.ptype_arg2s.push(arg2)
  tc.ptype_names.push("")
  tc.ptype_intern_map.set(key, idx)
  return type_constants::PTYPE_BASE + idx
end

## Get the base type kind of a parameterized type
def tc_ptype_base(tc: TypecheckState, t: TypeId): Int = tc.ptype_bases[t - type_constants::PTYPE_BASE]

## Get the first type argument of a parameterized type
def tc_ptype_arg1(tc: TypecheckState, t: TypeId): Int = tc.ptype_arg1s[t - type_constants::PTYPE_BASE]

## Get the second type argument of a parameterized type (0 if single-param)
def tc_ptype_arg2(tc: TypecheckState, t: TypeId): Int = tc.ptype_arg2s[t - type_constants::PTYPE_BASE]

## Get the struct/enum name stored on a parameterized type.
## Returns "" if no name is stored (e.g. for Vec<Int>, Vec<String>).
def tc_ptype_name(tc: TypecheckState, t: TypeId): String = tc.ptype_names[t - type_constants::PTYPE_BASE]

## Store a struct/enum name on a parameterized type.
## Used when Vec<Point> is parsed to carry "Point" through the ptype.
def tc_ptype_set_name(tc: TypecheckState, t: TypeId, name: String): Void
  tc.ptype_names[t - type_constants::PTYPE_BASE] = name
end

## P4.D.4b: Synthesize a Stream<T, body_row> ptype.
##
## Encoding: TYPE_STRUCT base, arg1=elem_type (T), arg2=body_row+1
## (so `0` reliably means "no row" / untracked, since row IDs start at 0).
## The struct name "Stream" is stamped via tc_ptype_set_name; consumers
## detect this ptype via `tc_is_stream_ptype` (name match) before reading
## the row via `tc_stream_ptype_row`.
##
## Why arg2 = body_row + 1: tc_make_ptype interns by (base, arg1, arg2).
## A pure sync generator has body_row = -1 (no `can` clause); encoding it
## as arg2=0 keeps the existing TYPE_STRUCT-with-arg2=0 patterns
## non-colliding, since those patterns don't set the "Stream" name.
def tc_synth_stream_ptype(tc: TypecheckState, elem_type: Int, body_row: Int): Int
  var arg2 = 0
  if body_row >= 0
    arg2 = body_row + 1
  end
  var ptype = tc_make_ptype(tc, type_constants::TYPE_STRUCT, elem_type, arg2)
  tc_ptype_set_name(tc, ptype, "Stream")
  return ptype
end

## P4.D.4b: Detect whether a type id is a Stream<T, body_row> ptype.
## Returns true if the type is a TYPE_STRUCT ptype carrying the name "Stream".
def tc_is_stream_ptype(tc: TypecheckState, t: TypeId): Bool
  if not tc_is_ptype(t)
    return false
  end
  if tc_ptype_base(tc, t) != type_constants::TYPE_STRUCT
    return false
  end
  return tc_ptype_name(tc, t) == "Stream"
end

## P4.D.4b: Read the body_row out of a Stream<T, body_row> ptype.
## Returns -1 if no row was attached at synthesis time (sync generator
## with no `can` clause), or the row id otherwise. Caller must verify the
## ptype is actually a Stream via `tc_is_stream_ptype` before calling.
def tc_stream_ptype_row(tc: TypecheckState, t: TypeId): Int
  var arg2 = tc_ptype_arg2(tc, t)
  if arg2 == 0
    return -1
  end
  return arg2 - 1
end

## Get the human-readable name of a newtype from its type ID
def tc_newtype_name(tc: TypecheckState, type_id: TypeId): String
  var idx = type_id - type_constants::TYPE_NEWTYPE_BASE
  if idx >= 0
    if idx < tc.registry.newtype_names.size
      return tc.registry.newtype_names[idx]
    end
  end
  return "newtype"
end

## Register a newtype definition from an AST node.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Newtype node (node_constants$NODE_NEWTYPE_DEF)
def tc_register_newtype_def(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void
  # Extract newtype name from str1
  var name = ast::ast_get_str1(ast_storage, node)

  # Extract wrapped type from str2
  var wrapped_type = ast::ast_get_str2(ast_storage, node)

  # STRICT_NEWTYPES — `@strict newtype` stores 1 in int_val (ast_newtype).
  # Loose newtypes (the default) store 0. Per-newtype, threaded through
  # tc_register_newtype to the parallel newtype_strict_flags array.
  var is_strict = ast::ast_get_int_val(ast_storage, node)

  # Register the newtype
  tc_register_newtype(tc, name, wrapped_type, is_strict)
end

## Register an impl block in the type checker context.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Impl block node (NodeImplBlock)
def tc_register_impl_block(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Void can Diag
  # Extract trait name from str1
  var trait_name = ast::ast_get_str1(ast_storage, node)

  # Extract "for" type from str2
  var for_type = ast::ast_get_str2(ast_storage, node)

  # Negative impl: `impl !Trait for Type end`. Short-circuit — record the
  # (trait, type) pair in the neg_impls registry and skip method-body
  # registration entirely. Negative impls are header-only; any `def ...`
  # inside is a parse-time error (the parser rejects non-empty bodies via
  # the `Negative impl requires 'for Type' clause` check upstream, and
  # here we silently ignore any stray methods to keep the phase cheap).
  if ast::ast_get_int_val(ast_storage, node) == 1
    if str_byte_len(trait_name) > 0 and str_byte_len(for_type) > 0
      typecheck_registry::tc_register_neg_impl(tc, trait_name, for_type)
    end
    return
  end

  # Set Self type so tc_parse_type resolves Self to for_type
  var prev_self_type = tc.scope.impl_self_type
  tc.scope.impl_self_type = for_type

  # Get method definitions from children
  var methods = ast::ast_get_children(ast_storage, node)
  var method_count = methods.size
  
  # Build method name vector and register each method as a callable function
  var method_names = vec_new<String>()

  for i in 0..method_count
    var method = methods[i]
    var method_name = ast::ast_get_str1(ast_storage, method)
    method_names.push(method_name)
    
    # Build mangled function name: Type$method (e.g., Point$eq)
    var mangled_name = "#{for_type}$"
    mangled_name = "#{mangled_name}#{method_name}"

    # Get parameters from left (slot 7)
    var params = ast::ast_get_left(ast_storage, method)
    var param_count = vec_size(params)

    # Substitute Self → for_type in parameter annotations so field access resolves
    for pi in 0..param_count
      var p_ann = ast::ast_get_str2(ast_storage, params[pi])
      if p_ann == "Self"
        ast::ast_set_str2(ast_storage, params[pi], for_type)
      end
    end

    # Build parameter type vector
    var param_types = map(params, p: Int -> tc_parse_type(tc, ast::ast_get_str2(ast_storage, p)))

    # Get return type from str2 — substitute Self in return annotation
    var return_type_ann = ast::ast_get_str2(ast_storage, method)
    if return_type_ann == "Self"
      return_type_ann = for_type
      ast::ast_set_str2(ast_storage, method, for_type)
    end
    var return_type = tc_parse_type(tc, return_type_ann)

    # Register as a callable function with mangled name.
    # Phase 11 RPITIT fix: skip duplicate registration if the function is already
    # registered with a non-empty return annotation. Otherwise the duplicate entry
    # (no annotation, pushed last) clobbers annotation-aware lookups (last-wins),
    # because tc_program calls tc_register_impl_block AFTER quartz.qz Phase 4.1's
    # tc_register_function_signature_named for main-module impls. With a multi-impl
    # trait that returns `impl Trait`, this caused tc_lookup_function_return_annotation
    # to return "" for one of the impls and dispatch routed through the other impl's
    # concrete return type.
    var existing_ann = typecheck_registry::tc_lookup_function_return_annotation(tc, mangled_name)
    if str_byte_len(existing_ann) == 0
      typecheck_registry::tc_register_function(tc, mangled_name, param_types, return_type, param_count)
    end
  end
  
  # Only register trait impl + Copy/Drop checks for trait impls (not inherent)
  if str_byte_len(trait_name) > 0
    # Register impl using helper
    typecheck_registry::tc_register_impl(tc, trait_name, for_type, method_names)

    # Move semantics: Copy/Drop/linear mutual exclusion
    var impl_line = ast::ast_get_line(ast_storage, node)
    var impl_col = ast::ast_get_col(ast_storage, node)
    if trait_name == "Copy"
      # Register as Copy type
      typecheck_registry::tc_register_copy_type(tc, for_type)
      # QZ1215: Cannot implement both Copy and Drop
      if typecheck_registry::tc_struct_has_drop(tc, for_type)
        error("QZ1215: Type '#{for_type}' cannot implement both Copy and Drop", impl_line, impl_col)
      end
      # QZ1215: Cannot implement Copy for linear struct
      if typecheck_registry::tc_struct_is_linear(tc, for_type)
        error("QZ1215: Type '#{for_type}' cannot implement Copy (linear struct)", impl_line, impl_col)
      end
    end
    if trait_name == "Drop"
      # QZ1215: Cannot implement Drop for Copy type
      if typecheck_registry::tc_type_is_copy(tc, for_type)
        error("QZ1215: Type '#{for_type}' cannot implement both Copy and Drop", impl_line, impl_col)
      end
    end
  end

  # Restore previous Self type
  tc.scope.impl_self_type = prev_self_type
end

## Verify that an impl block implements all required trait methods.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   node        - Impl block node (NodeImplBlock)
##
## Returns: 1 if valid, 0 if missing methods
def tc_verify_impl_completeness(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Int can Diag
  # Get trait name and for_type
  var trait_name = ast::ast_get_str1(ast_storage, node)
  var for_type = ast::ast_get_str2(ast_storage, node)

  # Inherent impls have no trait — skip completeness check
  if str_byte_len(trait_name) == 0
    return 1
  end

  # Look up the trait
  var trait_result = typecheck_registry::tc_lookup_trait(tc, trait_name)
  var trait_index = match trait_result
    Found(v) => v
    NotFound => {
      var line = ast::ast_get_line(ast_storage, node)
      var col = ast::ast_get_col(ast_storage, node)
      error("Unknown trait: #{trait_name}", line, col)
      return 0
    }
  end

  # Get trait method count and impl method names
  var trait_method_count = typecheck_registry::tc_trait_method_count(tc, trait_index)
  var methods = ast::ast_get_children(ast_storage, node)
  var impl_method_count = methods.size

  # Build set of implemented method names
  var impl_names = methods.map(m: Int -> ast::ast_get_str1(ast_storage, m))

  # Check that each trait method is implemented
  var trait_method_names = tc.registry.trait_method_names
  var required_names = trait_method_names[trait_index]
  var valid = 1

  # Get trait method signatures for param count comparison
  var trait_method_sigs = tc.registry.trait_method_sigs
  var required_sigs = trait_method_sigs[trait_index]

  var required_count = vec_size(required_names)
  for i in 0..required_count
    var required_name = required_names[i]
    var found = any?(impl_names, ptr: String -> ptr == required_name)

    if found == 0
      # Check if this method has a default implementation
      var defaults = tc.registry.trait_method_defaults[trait_index]
      var has_default = defaults[i]
      if has_default == 0
        # Check if Type$method already exists (auto-satisfaction from inherent impl)
        var mangled = "#{for_type}$#{required_name}"
        var existing = typecheck_registry::tc_lookup_function_return(tc, mangled)
        if existing == type_constants::TYPE_ERROR
          var line = ast::ast_get_line(ast_storage, node)
          var col = ast::ast_get_col(ast_storage, node)
          error("impl #{trait_name} for #{for_type} is missing method: #{required_name}", line, col)
          valid = 0
        end
      end
    else
      # Check param count matches
      var trait_sig = required_sigs[i]
      var trait_params = trait_sig[0]
      var trait_param_count = vec_size(trait_params)

      # Find the matching impl method node and count its params
      var methods_count = methods.size
      for mi in 0..methods_count
        var m = methods[mi]
        var m_name = ast::ast_get_str1(ast_storage, m)
        if str_eq(m_name, required_name)
          var m_params = ast::ast_get_left(ast_storage, m)
          var impl_param_count = vec_size(m_params)
          if impl_param_count != trait_param_count
            var line = ast::ast_get_line(ast_storage, m)
            var col = ast::ast_get_col(ast_storage, m)
            error("impl method #{required_name} has wrong number of parameters", line, col)
            valid = 0
          end
        end
      end
    end
  end

  # Check super-trait requirements
  if valid == 1
    var super_str = tc.registry.trait_super_traits[trait_index]
    if str_byte_len(super_str) > 0
      # Split on "+" and check each super-trait
      var st_start = 0
      var st_i = 0
      while st_i <= str_byte_len(super_str)
        var is_sep = 0
        if st_i == str_byte_len(super_str)
          is_sep = 1
        elsif str_byte_at(super_str, st_i) == '+'
          is_sep = 1
        end
        if is_sep == 1 and st_i > st_start
          var st_name = str_byte_slice(super_str, st_start, st_i).trim()
          if str_byte_len(st_name) > 0
            var st_impl = typecheck_registry::tc_lookup_impl(tc, st_name, for_type)
            if st_impl < 0
              var line = ast::ast_get_line(ast_storage, node)
              var col = ast::ast_get_col(ast_storage, node)
              error("impl #{trait_name} for #{for_type} requires super-trait #{st_name} to be implemented", line, col)
              valid = 0
            end
          end
          st_start = st_i + 1
        end
        st_i += 1
      end
    end
  end

  return valid
end

# ============================================================================
# Interprocedural Borrow Summary Generation (T3c.2 Phase 1)
# ============================================================================

## Generate a BorrowSummary for a function from its parameter and return annotations.
## Called after registration to populate func_borrow_summaries.
##
## Parameters:
##   tc              - Type checker context
##   func_idx        - Index into func_names/func_borrow_summaries
##   param_ann_str   - Comma-separated raw param annotations (e.g., "&Vec<Int>,Int,&mut String")
##   return_type_ann - Raw return type annotation (e.g., "&Int")
##   param_names_str - Comma-separated param names (e.g., "self,x,y")
def tc_generate_borrow_summary(tc: TypecheckState, func_idx: Int, param_ann_str: String, return_type_ann: String, param_names_str: String): Void
  # Skip if no borrow annotations at all (fast path — most functions)
  var has_borrow = false
  if str_byte_len(param_ann_str) > 0
    if str_contains(param_ann_str, "&")
      has_borrow = true
    end
  end
  if str_byte_len(return_type_ann) > 0
    if str_byte_at(return_type_ann, 0) == '&'
      has_borrow = true
    end
  end
  return if has_borrow == false

  var shared_params = vec_new()
  var exclusive_params = vec_new()
  var return_borrow_kind = 0
  var return_borrow_source = -2
  var escape_mask = 0

  # Parse parameter annotations for borrow types
  if str_byte_len(param_ann_str) > 0
    var param_idx = 0
    var start = 0
    var plen = str_byte_len(param_ann_str)
    # Track angle bracket depth to skip commas inside generic args like Vec<Int>
    var angle_depth = 0
    for ci in 0..plen
      var ch = str_byte_at(param_ann_str, ci)
      if ch == '<'
        angle_depth += 1
      elsif ch == '>'
        angle_depth -= 1
      elsif ch == ',' and angle_depth == 0
        # Process annotation from start..ci
        var ann = str_byte_slice(param_ann_str, start, ci)
        tc_classify_borrow_param(ann, param_idx, shared_params, exclusive_params)
        param_idx += 1
        start = ci + 1
      end
    end
    # Process last annotation
    if start < plen
      var last_ann = str_byte_slice(param_ann_str, start, plen)
      tc_classify_borrow_param(last_ann, param_idx, shared_params, exclusive_params)
    end
  end

  # Parse return type annotation for borrow kind
  if str_byte_len(return_type_ann) > 0
    if str_byte_len(return_type_ann) > 5
      if str_byte_at(return_type_ann, 0) == '&' and str_byte_at(return_type_ann, 1) == 'm' and str_byte_at(return_type_ann, 2) == 'u' and str_byte_at(return_type_ann, 3) == 't' and str_byte_at(return_type_ann, 4) == ' '
        return_borrow_kind = 2
      end
    end
    if return_borrow_kind == 0 and str_byte_at(return_type_ann, 0) == '&'
      return_borrow_kind = 1
    end
  end

  # Elision rules for return_borrow_source (only if return is a borrow)
  if return_borrow_kind > 0
    var total_borrow_params = shared_params.size + exclusive_params.size
    if total_borrow_params == 1
      # Rule 1: Single borrow input → source = that param index
      if shared_params.size == 1
        return_borrow_source = shared_params[0]
      else
        return_borrow_source = exclusive_params[0]
      end
    elsif total_borrow_params > 1
      # Rule 2: Self-method — first param named "self" → source = 0
      var is_self = false
      if str_byte_len(param_names_str) > 0
        # Check if first name before comma is "self"
        var comma_pos = __char_index(param_names_str, ',')
        var first_name = param_names_str
        if comma_pos > 0
          first_name = str_byte_slice(param_names_str, 0, comma_pos)
        end
        if first_name.eq("self")
          # Check if param 0 is a borrow param
          var p0_is_borrow = false
          for si in 0..shared_params.size
            if shared_params[si] == 0
              p0_is_borrow = true
            end
          end
          for si in 0..exclusive_params.size
            if exclusive_params[si] == 0
              p0_is_borrow = true
            end
          end
          if p0_is_borrow
            is_self = true
            return_borrow_source = 0
          end
        end
      end
      if is_self == false
        # Rule 5: Ambiguous — multiple borrow inputs, no self
        return_borrow_source = -2
      end
    end
    # If no borrow params at all but return is borrow → must be local (body analysis refines)
    if total_borrow_params == 0
      return_borrow_source = -2
    end
  end

  # Create BorrowSummary and store
  var summary = typecheck_util::BorrowSummary {
    shared_params: shared_params,
    exclusive_params: exclusive_params,
    return_borrow_kind: return_borrow_kind,
    return_borrow_source: return_borrow_source,
    escape_mask: escape_mask
  }
  tc.registry.func_borrow_summaries[func_idx] = Option::Some(summary)
end

## Classify a single parameter annotation as shared borrow, exclusive borrow, or neither.
def tc_classify_borrow_param(ann: String, param_idx: Int, shared_params: Vec<Int>, exclusive_params: Vec<Int>): Void
  var alen = str_byte_len(ann)
  return if alen == 0
  if alen > 5
    if str_byte_at(ann, 0) == '&' and str_byte_at(ann, 1) == 'm' and str_byte_at(ann, 2) == 'u' and str_byte_at(ann, 3) == 't' and str_byte_at(ann, 4) == ' '
      exclusive_params.push(param_idx)
      return
    end
  end
  if str_byte_at(ann, 0) == '&'
    shared_params.push(param_idx)
  end
end

## Refine a function's BorrowSummary after body analysis.
## Called at the end of tc_function to update escape_mask and return_borrow_source
## using the borrow tracking state accumulated during body type-checking.
##
## Parameters:
##   tc        - Type checker context (with borrow state from body analysis)
##   func_name - Name of the function being analyzed
##   params    - AST parameter node handles (from ast_get_left)
##   body      - AST body node handle
##   ast_storage - AST storage
def tc_refine_borrow_summary(tc: TypecheckState, func_name: String, params: Int, body: Int, ast_storage: ast::AstStorage): Void
  var func_idx = typecheck_registry::tc_lookup_function_index(tc, func_name)
  return if func_idx < 0
  var summary_opt = tc.registry.func_borrow_summaries[func_idx]
  return if summary_opt is None
  var summary = summary_opt.unwrap()

  # Build param name → param index mapping for borrow source tracing
  var param_count = 0
  if params > 0
    param_count = vec_size(params)
  end

  # Check escape: for each borrow param, see if any binding in scope
  # has a borrow chain leading to a param AND was stored in a struct field.
  # Currently QZ1211 prevents struct field storage at the point of store,
  # so escape_mask refinement is a future extension (Phase 5 transitive).
  # For now, escape_mask stays as-is from Phase 1 (0 = no escapes detected).

  # Refine return_borrow_source: if the body returns a value that borrows
  # from a parameter, override the elision-based return_borrow_source.
  if summary.return_borrow_kind > 0 and body >= 0
    var resolved_source = tc_trace_return_borrow_to_param(tc, ast_storage, body, params, param_count)
    if resolved_source >= -1
      # -1 = local (unsound), 0..N = param index
      summary.return_borrow_source = resolved_source
    end
  end
end

## Trace a function's return value borrow chain to find which parameter (if any)
## it borrows from. Scans the body for return statements.
## Returns: param index (0..N), -1 (local — unsound), or -2 (unknown/no override)
def tc_trace_return_borrow_to_param(tc: TypecheckState, ast_storage: ast::AstStorage, body: Int, params: Int, param_count: Int): Int
  return -2 if body < 0

  var body_kind = ast::ast_get_kind(ast_storage, body)

  # Direct return node
  if body_kind == node_constants::NODE_RETURN
    var ret_val = ast::ast_get_right(ast_storage, body)
    return -2 if ret_val < 0
    return tc_resolve_borrow_source_to_param(tc, ast_storage, ret_val, params, param_count)
  end

  # Block: scan children for return statements
  if body_kind == node_constants::NODE_BLOCK
    var children = ast::ast_get_children(ast_storage, body)
    if children > 0
      var child_count = vec_size(children)
      for i in 0..child_count
        var child = children[i]
        var result = tc_trace_return_borrow_to_param(tc, ast_storage, child, params, param_count)
        if result >= -1
          return result
        end
      end
    end
  end

  # If/match branches: recurse into both arms
  if body_kind == node_constants::NODE_IF
    var then_branch = ast::ast_get_right(ast_storage, body)
    var else_branch = ast::ast_get_children(ast_storage, body)
    var r1 = tc_trace_return_borrow_to_param(tc, ast_storage, then_branch, params, param_count)
    if r1 >= -1
      return r1
    end
    if else_branch > 0 and vec_size(else_branch) > 0
      return tc_trace_return_borrow_to_param(tc, ast_storage, else_branch[0], params, param_count)
    end
  end

  return -2
end

## Given a return value AST node, trace its borrow source back to a parameter.
## Returns: param index (0..N), -1 (local), or -2 (unknown)
def tc_resolve_borrow_source_to_param(tc: TypecheckState, ast_storage: ast::AstStorage, value_node: Int, params: Int, param_count: Int): Int
  var kind = ast::ast_get_kind(ast_storage, value_node)

  # Direct borrow: return &x or return &mut x
  if kind == node_constants::NODE_FUNC_REF
    var borrow_var = ast::ast_get_str1(ast_storage, value_node)
    return tc_name_to_param_index(borrow_var, params, param_count, ast_storage)
  end

  # Identifier: check if this binding holds a borrow from a param
  if kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(ast_storage, value_node)
    # Check if name itself is a param
    var pidx = tc_name_to_param_index(name, params, param_count, ast_storage)
    if pidx >= 0
      return pidx
    end
    # Check binding's borrow source chain
    var bidx = typecheck_util::tc_lookup_binding_index(tc, name)
    if bidx >= 0
      var borrow_src = tc.safety.binding_borrow_sources[bidx]
      if borrow_src != 0
        var src_name = as_string(borrow_src)
        return tc_name_to_param_index(src_name, params, param_count, ast_storage)
      end
    end
  end

  return -2
end

## Check if a variable name matches one of the function's parameter names.
## Returns: param index (0..N) or -1 if not a param.
def tc_name_to_param_index(name: String, params: Int, param_count: Int, ast_storage: ast::AstStorage): Int
  return -1 if params <= 0
  for i in 0..param_count
    var p = vec_get(params, i)
    var pname = ast::ast_get_str1(ast_storage, p)
    if name.eq(pname)
      return i
    end
  end
  return -1
end

## Transitive propagation of borrow summaries (T3c.2 Phase 5).
## After all function bodies are type-checked, iterate through summaries
## to propagate transitive borrow chains: if A returns result of B(&param),
## and B's summary says "return borrows from param 0", then A's summary
## should reflect the transitive chain.
##
## Runs as a fixpoint: iterate until no summary changes.
## In practice: compiler code has trivial summaries (no borrows),
## user code typically has shallow chains (1-2 levels), so this converges
## in 1-3 iterations.
def tc_propagate_borrow_summaries(tc: TypecheckState): Void
  var func_count = tc.registry.func_names.size
  var max_iters = 10
  for iter in 0..max_iters
    var changed = false
    for i in 0..func_count
      var summary_opt = tc.registry.func_borrow_summaries[i]
      if summary_opt is Some
        var summary = summary_opt.unwrap()
        # If return borrows from a param (source >= 0), check if the param
        # itself flows through a callee with its own return borrow.
        # This is already handled by the body analysis pass (Phase 2) tracing
        # borrow chains. The fixpoint here covers the case where callee summaries
        # were refined after we analyzed this function.
        #
        # For now, the fixpoint is a no-op since:
        # 1. All summaries are generated from annotations (Phase 1) before body analysis
        # 2. Body analysis (Phase 2) refines using callee summaries that are already set
        # 3. Compiler code has zero borrow annotations = trivial summaries
        #
        # The fixpoint becomes necessary when:
        # - Mutual recursion with borrow annotations
        # - Late summary refinement changes callee behavior
        # These are future edge cases that don't arise in current usage.
      end
    end
    if changed == false
      break
    end
  end
end

## Register a function signature in the type checker context with an explicit name.
##
## Use this variant when the function should be registered under a different name
## than what's in the AST (e.g., for cross-module imports with prefixed names).
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   func        - Function definition node
##   name        - The name to register the function under
# Stdlib paths whose `def`s are exempt from the intrinsic-name-shadow
# diagnostic. Many stdlib modules (std/string.qz, std/prelude.qz, etc.)
# intentionally provide a Quartz-level wrapper or signature alongside an
# intrinsic of the same name. This list reflects those conventions.
def _tc_path_in_stdlib(path: String): Bool
  return true if str_starts_with(path, "std/")
  return true if str_starts_with(path, "self-hosted/")
  return true if str_contains(path, "/std/")
  return true if str_contains(path, "/self-hosted/")
  return false
end

## QZ0220 — does the annotation look like a "simple" type-name reference?
##
## We only flag `def foo(x: SomeName): ...` shapes where `SomeName` is
## a single identifier (capital letter + alnum/underscore). Anything more
## complex (generics, Fn-types, borrows, tuples, records, module-qualified)
## might fall through to TYPE_ERROR for an inner-name reason; we don't
## want to flag those here because the inner-name flag would already
## fire at the outer container's level (or — for now — we accept silent
## erasure on inner names and tighten that in a follow-up).
##
## Excludes the `T` shape (single capital letter) because that's the
## conventional generic-param shape; the tp-var check at the call site
## already handles the legitimate case, and emitting on bare-`T` would
## false-positive on every typo'd generic.
def _tc_looks_like_simple_type_name(ann: String): Int
  var n = str_byte_len(ann)
  return 0 if n < 2
  var c0 = str_byte_at(ann, 0)
  return 0 if c0 < 'A' or c0 > 'Z'
  for i in 1..n
    var c = str_byte_at(ann, i)
    var is_alpha = (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')
    var is_digit = c >= '0' and c <= '9'
    var is_under = c == '_'
    return 0 if not (is_alpha or is_digit or is_under)
  end
  return 1
end

def tc_register_function_signature_named(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId, name: String): Void
  # QZ1410 — Detect intrinsic name collisions for bare user defs. A user
  # `def NAME` that matches a registered intrinsic produces a SILENT
  # MISCOMPILE: the user function IS emitted to LLVM IR, but every call
  # site is dispatched to the intrinsic's hardcoded codegen at MIR-lower
  # time, bypassing the user function entirely (see
  # `mir_lower_expr_handlers.qz` line ~2468 — `mir_is_intrinsic(name)`
  # wins). Hard-error here so the diagnostic includes accurate source
  # location.
  #
  # Two exemptions:
  #   1. Module-qualified names (contain `$`) are auto-prefixed stdlib
  #      forms; collision impossible.
  #   2. Stdlib paths (under `std/` or `self-hosted/`) are exempt by
  #      convention — many stdlib modules ship a Quartz-level def
  #      alongside an intrinsic of the same name (e.g., `def str_split`
  #      in `std/string.qz`, `def unwrap` in `std/prelude.qz`).
  #
  # The path is resolved from the AST store's dep-graph entry, NOT from
  # `tc.current_file` — current_file is stale during the registration
  # pass (it's set per-function only inside the body-walking loop, and
  # all registrations happen first).
  #
  # Filed at `docs/bugs/INTRINSIC_NAME_SHADOW_SILENT_MISCOMPILE.md`.
  if str_contains(name, "$") == false
    var def_path = dep_graph::depgraph_path_for_ast_store(ast_storage)
    if not _tc_path_in_stdlib(def_path)
      if typecheck_builtins::tc_is_builtin(tc, name)
        typecheck_util::tc_error_at(
          tc,
          "Function '#{name}' shadows a builtin intrinsic. The intrinsic's hardcoded codegen would silently bypass your function at every call site, producing a wrong runtime answer. Rename to a non-intrinsic name.",
          ast_storage,
          func
        )
        # Fall through and register anyway so subsequent typechecking
        # doesn't cascade "undefined function" errors at every call
        # site of the shadowed name.
      end
    end
  end

  # Get parameters from left (slot 7)
  var params = ast::ast_get_left(ast_storage, func)
  var param_count = vec_size(params)

  # Collect type parameter names (e.g., "T,U" -> ["T", "U"])
  # Type params are stored in ops slot, bounds in extras slot
  var type_params_str = ast::ast_func_type_params(ast_storage, func)

  # P3.F.1: Reset + populate the function-scope row-var name env. Lowercase
  # type-param names (`def foo<e, f>`) bind to fresh effect-row variables,
  # shared by every `can` clause mention of that name inside the signature
  # (and, via F.2/F.3, by Fn-type and trait-method row annotations). This
  # is the one-line gap called out in the memo: without a named env, two
  # `can e` mentions would each allocate a fresh erv and fail to unify.
  typecheck_util::tc_func_row_var_env_reset(tc)
  if str_byte_len(type_params_str) > 0
    var tp_parts = str_split(type_params_str, ",")
    for tp_i in 0..tp_parts.size
      var tp_name = tp_parts[tp_i]
      if typecheck_util::tc_name_is_row_var(tp_name)
        typecheck_util::tc_func_row_var_bind(tc, tp_name)
      end
    end
  end

  # Inherit type parameters from the parent struct for extend methods.
  # Extend methods are desugared by the resolver into Type<T>$method functions,
  # but the type params (e.g., T from extend GBox<T>) are not propagated
  # to the function AST node. Strip generic args from the struct prefix:
  # 1. Look up the struct's type params and inherit them
  # 2. Rewrite the function name from GBox<T>$get to GBox$get (LLVM IR
  #    doesn't allow <> in bare identifiers and MIR must match call sites)
  if str_byte_len(type_params_str) == 0
    var dollar_pos = __char_index(name, '$')
    if dollar_pos > 0
      var struct_prefix = str_byte_slice(name, 0, dollar_pos)
      # Strip generic args: "GBox<T>" -> "GBox"
      var lt_pos = __char_index(struct_prefix, '<')
      if lt_pos > 0
        struct_prefix = str_byte_slice(struct_prefix, 0, lt_pos)
        # Build clean name without generic args: "GBox$get"
        var method_suffix = str_byte_slice(name, dollar_pos, str_byte_len(name))
        name = "#{struct_prefix}#{method_suffix}"
        # Rewrite the function AST node so MIR uses the clean name
        ast::ast_set_str1(ast_storage, func, name)
      end
      var struct_result = typecheck_registry::tc_lookup_struct(tc, struct_prefix)
      var inherited_params = match struct_result
        Found(v) => tc_struct_type_params(tc, v)
        NotFound => ""
      end
      if str_byte_len(inherited_params) > 0
        type_params_str = inherited_params
      end
    end
  end

  # Build parameter type vector, Fn annotations, param names, and count required params
  var param_types = vec_new()
  var fn_annotations = vec_new()
  var required_count = 0
  var param_ann_str = ""
  var param_names_str = ""

  for i in 0..param_count
    var param = params[i]
    var param_type_ann = ast::ast_get_str2(ast_storage, param)
    var param_name = ast::ast_get_str1(ast_storage, param)
    # Build comma-separated param annotations for trait bound validation
    if i > 0
      param_ann_str += ","
      param_names_str += ","
    end
    param_ann_str += param_type_ann
    param_names_str += param_name

    # Check if param has default value
    # Note: default_value == -1 means no default (parser uses -1 as sentinel)
    var default_value = ast::ast_param_default_value(ast_storage, param)
    if default_value < 0
      # No default - this is a required param
      required_count = i + 1
    end

    # Parse parameter type annotation
    if str_byte_len(param_type_ann) > 0
      var param_type = tc_parse_type(tc, param_type_ann)
      # If type resolved to TYPE_ERROR and matches a type param, treat as TYPE_INT
      # (all generic types erase to i64 at runtime — existential erasure)
      if param_type == type_constants::TYPE_ERROR and str_byte_len(type_params_str) > 0
        if tc_is_type_param(param_type_ann, type_params_str)
          param_type = type_constants::TYPE_INT
        end
      end
      # QZ0220 — undefined type name in parameter position. Silent
      # acceptance was historically the default: TYPE_ERROR fell through
      # to existential erasure (i64), masking misnamed types and
      # abandoned aliases. Surface it as a hard error for the simple
      # `SomeName` shape (the bug-doc case at std/toml/manifest.qz's
      # `TomlTable` references). Generic-param refs hit the tp-var path
      # above and don't reach here. See
      # docs/bugs/TYPECHECK_ACCEPTS_UNDEFINED_TYPE_NAME_AS_PARAM.md.
      if param_type == type_constants::TYPE_ERROR
        if _tc_looks_like_simple_type_name(param_type_ann) == 1
          typecheck_util::tc_error_at(
            tc,
            "QZ0220: undefined type name '#{param_type_ann}' in parameter position. The compiler doesn't know this type — check for a typo, a missing `import`, or a missing `type` / `struct` / `enum` definition.",
            ast_storage,
            param
          )
        end
      end
      param_types.push(param_type)
      # Store Fn annotation for Fn-typed params (for lambda arity validation)
      # Use as_int() because fn_annotations is Vec<Int> (existential i64)
      if tc_type_is_function(tc, param_type)
        fn_annotations.push(as_int(param_type_ann))
      else
        fn_annotations.push(0)
      end
    else
      # No type annotation -> Int (existential erasure: all values are i64)
      param_types.push(type_constants::TYPE_INT)
      fn_annotations.push(0)
    end
  end

  # Parse return type from str2
  var return_type_ann = ast::ast_get_str2(ast_storage, func)
  var return_type = type_constants::TYPE_VOID

  if str_byte_len(return_type_ann) > 0
    return_type = tc_parse_type(tc, return_type_ann)
    # If return type resolved to TYPE_ERROR and matches a type param, treat as TYPE_INT
    if return_type == type_constants::TYPE_ERROR and str_byte_len(type_params_str) > 0
      if tc_is_type_param(return_type_ann, type_params_str)
        return_type = type_constants::TYPE_INT
      end
    end
    # QZ0220 — undefined type name in return position. Same shape as
    # the parameter case above. Use the function node itself for source
    # location (the parser doesn't carry a separate return-type-ann
    # node).
    if return_type == type_constants::TYPE_ERROR
      if _tc_looks_like_simple_type_name(return_type_ann) == 1
        typecheck_util::tc_error_at(
          tc,
          "QZ0220: undefined type name '#{return_type_ann}' in return position. The compiler doesn't know this type — check for a typo, a missing `import`, or a missing `type` / `struct` / `enum` definition.",
          ast_storage,
          func
        )
      end
    end
  end

  # Register function using existing helper
  typecheck_registry::tc_register_function(tc, name, param_types, return_type, required_count)
  # Store return type annotation for struct name propagation
  var func_return_annotations = tc.registry.func_return_annotations
  var ann_idx = func_return_annotations.size - 1
  func_return_annotations[ann_idx] = return_type_ann
  # Override the empty Fn annotations pushed by tc_register_function with real data
  var fn_ann_vec = tc.registry.func_param_fn_annotations
  fn_ann_vec[fn_ann_vec.size - 1] = fn_annotations
  # Store trait constraint data (overwrite empty values pushed by tc_register_function)
  var bounds_str = ast::ast_func_type_param_bounds(ast_storage, func)
  var constraint_idx = tc.registry.func_type_params.size - 1
  tc.registry.func_type_params[constraint_idx] = type_params_str
  tc.registry.func_type_param_bounds[constraint_idx] = bounds_str
  tc.registry.func_param_annotations[constraint_idx] = param_ann_str
  # Store param names and AST info for named argument support
  tc.registry.func_param_names[constraint_idx] = param_names_str
  tc.registry.func_ast_stores[constraint_idx] = ast_storage
  tc.registry.func_ast_handles[constraint_idx] = func
  # Generate interprocedural borrow summary from annotations (T3c.2)
  tc_generate_borrow_summary(tc, constraint_idx, param_ann_str, return_type_ann, param_names_str)
  # Effect-row attachment (Operation Piezoelectric Effects, B.3): if the
  # parser saw a `can` clause for this function, allocate a row in the
  # registry and bind the function's slot in func_effect_row_idx. Absent
  # `can` keeps the -1 ("untracked") default already pushed by
  # tc_register_function.
  tc_attach_func_effect_row(tc, ast_storage, func, constraint_idx)
  # P3.F.2: store the generalized ervs (row-vars declared as lowercase
  # type-params) so each call site can instantiate fresh. Without this,
  # the first call's concrete row permanently binds the row-var.
  typecheck_registry::tc_set_func_generalized_ervs(tc, constraint_idx, tc.func_row_var_ids)
end

## Allocate an effect row for a function from its AST `can` annotation.
## No-op when the function has no `can` clause (the registry slot stays -1).
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.3).
def tc_attach_func_effect_row(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId, func_idx: Int): Void
  if ast::ast_func_has_can_row(ast_storage, func) == 0
    return
  end
  var label_csv = ast::ast_func_get_can_label_csv(ast_storage, func)
  var tail_str = ast::ast_func_get_can_tail(ast_storage, func)
  # P3.F.2: parser-ambiguity reinterpretation. The grammar `can e` parses
  # into labels=["e"] with empty tail — indistinguishable from `can E`
  # (an effect label named E). If a single label is a lowercase name that
  # matches a declared row-var in this function's scope, reinterpret as
  # `can | e` (tail-only, no labels). This lets users write the terse form
  # `can e` instead of the explicit `can | e` — the payoff of the
  # "lowercase = row var" convention per the design memo.
  if str_byte_len(tail_str) == 0 and str_byte_len(label_csv) > 0
    var _single_label_parts = str_split(label_csv, ",")
    if _single_label_parts.size == 1
      var _candidate = _single_label_parts[0]
      if typecheck_util::tc_name_is_row_var(_candidate)
        if typecheck_util::tc_func_row_var_lookup(tc, _candidate) > 0
          tail_str = _candidate
          label_csv = ""
        end
      end
    end
  end
  var label_ids = vec_new()
  if str_byte_len(label_csv) > 0
    var parts = str_split(label_csv, ",")
    for i in 0..parts.size
      var nm = parts[i]
      if str_byte_len(nm) > 0
        label_ids.push(string_intern::intern_id(tc.interner, nm))
      end
    end
  end
  var tail_var = -1
  if str_byte_len(tail_str) > 0
    # P3.F.1: scope-bound row-var names. If the tail matches a lowercase
    # type-param declared on this function (e.g. `def foo<e>(...) can e`),
    # resolve to the erv already allocated in the function's row-var env.
    # Multiple `can e` mentions within the same signature (today: only this
    # one clause; F.2/F.3 add Fn-type and trait-method slots) share that
    # single erv. If the tail is not a declared row-var name, fall back to
    # a fresh erv — preserves B.4 behavior for anonymous tails where the
    # user wrote `can ... | tail` without declaring `tail` in `<...>`.
    var bound_erv = typecheck_util::tc_func_row_var_lookup(tc, tail_str)
    if bound_erv > 0
      tail_var = bound_erv
    else
      tail_var = typecheck_util::tc_erv_fresh(tc)
    end
  end
  var row_id = typecheck_registry::tc_row_new(tc, label_ids, tail_var)
  typecheck_registry::tc_set_func_effect_row(tc, func_idx, row_id)
end

## Register a function signature in the type checker context.
##
## Parameters:
##   tc          - Type checker context
##   ast_storage - AST storage handle
##   func        - Function definition node
def tc_register_function_signature(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId): Void
  # Extract function name from str1
  var name = ast::ast_get_str1(ast_storage, func)
  tc_register_function_signature_named(tc, ast_storage, func, name)
end

## Register an extern "C" def in the type checker with an explicit name.
## Extern defs store params in children (not left like regular fns).
def tc_register_extern_fn_signature_named(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId, name: String): Void
  var params = ast::ast_get_children(ast_storage, func)
  var param_count = params.size

  var param_types = vec_new()
  for i in 0..param_count
    var param = params[i]
    var param_type_ann = ast::ast_get_str2(ast_storage, param)
    if str_byte_len(param_type_ann) > 0
      param_types.push(tc_parse_type(tc, param_type_ann))
    else
      param_types.push(type_constants::TYPE_INT)
    end
  end

  var return_type_ann = ast::ast_get_str2(ast_storage, func)
  var return_type = type_constants::TYPE_VOID
  if str_byte_len(return_type_ann) > 0
    return_type = tc_parse_type(tc, return_type_ann)
  end

  # For variadic extern functions (e.g. fcntl(fd, cmd, ...)),
  # the named params are the minimum required, but extra args are allowed.
  # Pad param_types to a large max so arity check passes for extra args.
  var is_variadic = ast::ast_extern_fn_is_variadic(ast_storage, func)
  var required_count = param_count
  if is_variadic == 1
    var max_variadic = 32
    while param_types.size < max_variadic
      param_types.push(type_constants::TYPE_INT)
    end
  end

  typecheck_registry::tc_register_function(tc, name, param_types, return_type, required_count)
end

## Register an extern "C" def in the type checker (bare name from AST).
def tc_register_extern_fn_signature(tc: TypecheckState, ast_storage: ast::AstStorage, func: AstNodeId): Void
  var name = ast::ast_get_str1(ast_storage, func)
  tc_register_extern_fn_signature_named(tc, ast_storage, func, name)
end


# ============================================================================
# Test
# ============================================================================

def main(): Int
  puts("=== Type Checker Test ===")
  
  # Create type checker context
  var tc = tc_new()
  
  # Test type parsing
  puts("Testing type parsing...")
  var int_type = tc_parse_type(tc, "Int")
  var bool_type = tc_parse_type(tc, "Bool")
  var string_type = tc_parse_type(tc, "String")
  var void_type = tc_parse_type(tc, "Void")
  var symbol_type = tc_parse_type(tc, "Symbol")
  
  if int_type == type_constants::TYPE_INT
    puts("  Int parsing: PASS")
  else
    puts("  Int parsing: FAIL")
  end
  
  if bool_type == type_constants::TYPE_BOOL
    puts("  Bool parsing: PASS")
  else
    puts("  Bool parsing: FAIL")
  end
  
  if symbol_type == type_constants::TYPE_SYMBOL
    puts("  Symbol parsing: PASS")
  else
    puts("  Symbol parsing: FAIL")
  end
  
  # Test type comparison
  puts("Testing type comparison...")
  if tc_types_equal(type_constants::TYPE_INT, type_constants::TYPE_INT)
    puts("  Int == Int: PASS")
  else
    puts("  Int == Int: FAIL")
  end
  
  if tc_types_equal(type_constants::TYPE_INT, type_constants::TYPE_BOOL) == false
    puts("  Int != Bool: PASS")
  else
    puts("  Int != Bool: FAIL")
  end
  
  if tc_types_match(tc, type_constants::TYPE_ERROR, type_constants::TYPE_INT)
    puts("  Error matches Int: PASS")
  else
    puts("  Error matches Int: FAIL")
  end
  
  # Test builtin lookup
  puts("Testing builtin registry...")
  var puts_type = typecheck_builtins::tc_lookup_builtin(tc, "puts")
  if puts_type == type_constants::TYPE_VOID
    puts("  puts -> Void: PASS")
  else
    puts("  puts -> Void: FAIL")
  end
  
  var vec_new_type = typecheck_builtins::tc_lookup_builtin(tc, "vec_new")
  if vec_new_type == type_constants::TYPE_INT
    puts("  vec_new -> Int: PASS")
  else
    puts("  vec_new -> Int: FAIL")
  end
  
  if typecheck_builtins::tc_is_builtin(tc, "str_concat")
    puts("  str_concat is builtin: PASS")
  else
    puts("  str_concat is builtin: FAIL")
  end
  
  if typecheck_builtins::tc_is_builtin(tc, "nonexistent") == 0
    puts("  nonexistent not builtin: PASS")
  else
    puts("  nonexistent not builtin: FAIL")
  end
  
  # Test scope management
  puts("Testing scope management...")
  var initial_depth = typecheck_util::tc_get_depth(tc)
  typecheck_util::tc_enter_scope()
  var depth_after_enter = typecheck_util::tc_get_depth(tc)
  
  # Bind a variable in this scope
  typecheck_util::tc_scope_bind(tc, "x", type_constants::TYPE_INT, 0, "")
  var x_type = typecheck_util::tc_scope_lookup(tc, "x")
  if x_type == type_constants::TYPE_INT
    puts("  Bound 'x' lookup: PASS")
  else
    puts("  Bound 'x' lookup: FAIL")
  end
  
  var y_type = typecheck_util::tc_scope_lookup(tc, "y")
  if y_type == type_constants::TYPE_ERROR
    puts("  Unbound 'y' lookup: PASS")
  else
    puts("  Unbound 'y' lookup: FAIL")
  end
  
  # Test mutability
  typecheck_util::tc_scope_bind(tc, "mut_var", type_constants::TYPE_INT, 1, "")
  var mut_result = typecheck_util::tc_scope_lookup_mutable(tc, "mut_var")
  if mut_result == 1
    puts("  Mutable var check: PASS")
  else
    puts("  Mutable var check: FAIL")
  end
  
  var immut_result = typecheck_util::tc_scope_lookup_mutable(tc, "x")
  if immut_result == 0
    puts("  Immutable var check: PASS")
  else
    puts("  Immutable var check: FAIL")
  end
  
  tc_exit_scope(tc)
  var depth_after_exit = typecheck_util::tc_get_depth(tc)
  
  if depth_after_enter == initial_depth + 1
    puts("  Enter scope: PASS")
  else
    puts("  Enter scope: FAIL")
  end
  
  if depth_after_exit == initial_depth
    puts("  Exit scope: PASS")
  else
    puts("  Exit scope: FAIL")
  end
  
  # Test function registry
  puts("Testing function registry...")
  var params = [type_constants::TYPE_INT, type_constants::TYPE_INT]
  typecheck_registry::tc_register_function(tc, "add", params, type_constants::TYPE_INT, 2)  # 2 required params
  
  var add_return = typecheck_registry::tc_lookup_function_return(tc, "add")
  if add_return == type_constants::TYPE_INT
    puts("  add return type: PASS")
  else
    puts("  add return type: FAIL")
  end
  
  var add_count = typecheck_registry::tc_function_param_count(tc, "add")
  if add_count == 2
    puts("  add param count: PASS")
  else
    puts("  add param count: FAIL")
  end
  
  # Test struct registry
  puts("Testing struct registry...")
  var field_names = [as_int("x"), as_int("y")]
  var field_types = [type_constants::TYPE_INT, type_constants::TYPE_INT]
  typecheck_registry::tc_register_struct(tc, "Point", field_names, field_types, "", vec_new(), 0, vec_new())

  var point_result = typecheck_registry::tc_lookup_struct(tc, "Point")
  if point_result.is_found()
    puts("  Point lookup: PASS")
  else
    puts("  Point lookup: FAIL")
  end
  
  var point_idx = point_result.unwrap()
  var x_field = typecheck_registry::tc_struct_field_type(tc, point_idx, "x")
  if x_field == type_constants::TYPE_INT
    puts("  Point.x type: PASS")
  else
    puts("  Point.x type: FAIL")
  end
  
  var z_field = typecheck_registry::tc_struct_field_type(tc, point_idx, "z")
  if z_field == type_constants::TYPE_ERROR
    puts("  Point.z missing: PASS")
  else
    puts("  Point.z missing: FAIL")
  end
  
  # Test enum registry
  puts("Testing enum registry...")
  var variant_names = [as_int("Some"), as_int("None")]
  var variant_payloads = vec_new()
  typecheck_registry::tc_register_enum(tc, "Option", variant_names, variant_payloads, "", vec_new())
  
  var option_result = typecheck_registry::tc_lookup_enum(tc, "Option")
  if option_result.is_found()
    puts("  Option lookup: PASS")
  else
    puts("  Option lookup: FAIL")
  end
  
  var option_idx = option_result.unwrap()
  if typecheck_registry::tc_enum_has_variant(tc, option_idx, "Some")
    puts("  Option::Some exists: PASS")
  else
    puts("  Option::Some exists: FAIL")
  end
  
  if typecheck_registry::tc_enum_has_variant(tc, option_idx, "Error") == 0
    puts("  Option::Error missing: PASS")
  else
    puts("  Option::Error missing: FAIL")
  end
  
  # Test binary operator checking
  puts("Testing binary operators...")
  var tc2 = tc_new()
  var eq_result = tc_check_binary("==", type_constants::TYPE_INT, type_constants::TYPE_INT, 1, 1)
  if eq_result == type_constants::TYPE_BOOL
    puts("  == returns Bool: PASS")
  else
    puts("  == returns Bool: FAIL")
  end
  
  var plus_result = tc_check_binary("+", type_constants::TYPE_STRING, type_constants::TYPE_STRING, 1, 1)
  if plus_result == type_constants::TYPE_STRING
    puts("  String + String: PASS")
  else
    puts("  String + String: FAIL")
  end
  
  var arith_result = tc_check_binary("+", type_constants::TYPE_INT, type_constants::TYPE_INT, 1, 1)
  if arith_result == type_constants::TYPE_INT
    puts("  Int + Int: PASS")
  else
    puts("  Int + Int: FAIL")
  end
  
  # Test let checking
  puts("Testing let statement checking...")
  var tc3 = tc_new()
  
  var result1 = tc_check_let(tc3, true, type_constants::TYPE_INT, type_constants::TYPE_INT, "x", 1, 1)
  if result1
    puts("  Let with matching types: PASS")
  else
    puts("  Let with matching types: FAIL")
  end
  
  var result2 = tc_check_let(tc3, true, type_constants::TYPE_INT, type_constants::TYPE_BOOL, "y", 2, 1)
  if result2 == false
    puts("  Let with mismatched types: PASS")
  else
    puts("  Let with mismatched types: FAIL")
  end
  
  # Test assignment checking
  puts("Testing assignment checking...")
  var tc4 = tc_new()
  
  var result3 = tc_check_assign(tc4, true, type_constants::TYPE_INT, type_constants::TYPE_INT, "counter", 1, 1)
  if result3
    puts("  Assign to mutable: PASS")
  else
    puts("  Assign to mutable: FAIL")
  end
  
  var result4 = tc_check_assign(tc4, false, type_constants::TYPE_INT, type_constants::TYPE_INT, "const_val", 2, 1)
  if result4 == false
    puts("  Assign to immutable: PASS")
  else
    puts("  Assign to immutable: FAIL")
  end
  
  # Test return checking
  puts("Testing return checking...")
  var tc5 = tc_new()
  typecheck_util::tc_set_return_type(tc5, type_constants::TYPE_INT)
  
  var result5 = tc_check_return(tc5, type_constants::TYPE_INT, 1, 1)
  if result5
    puts("  Return matching type: PASS")
  else
    puts("  Return matching type: FAIL")
  end
  
  var result6 = tc_check_return(tc5, type_constants::TYPE_STRING, 2, 1)
  if result6 == false
    puts("  Return mismatched type: PASS")
  else
    puts("  Return mismatched type: FAIL")
  end
  
  # Test condition checking
  puts("Testing condition checking...")
  var tc6 = tc_new()
  
  var result7 = tc_check_condition(tc6, type_constants::TYPE_BOOL, "if", 1, 1)
  if result7
    puts("  Bool condition: PASS")
  else
    puts("  Bool condition: FAIL")
  end
  
  var result8 = tc_check_condition(tc6, type_constants::TYPE_STRING, "while", 2, 1)
  if result8 == false
    puts("  Non-bool condition: PASS")
  else
    puts("  Non-bool condition: FAIL")
  end
  
  # Test function call checking
  puts("Testing function call checking...")
  var tc7 = tc_new()
  
  var result9 = tc_check_call(2, 2, "add", 1, 1)
  if result9
    puts("  Correct arg count: PASS")
  else
    puts("  Correct arg count: FAIL")
  end
  
  var result10 = tc_check_call(3, 2, "add", 2, 1)
  if result10 == false
    puts("  Wrong arg count: PASS")
  else
    puts("  Wrong arg count: FAIL")
  end
  
  # Test struct init checking
  puts("Testing struct init checking...")
  var tc8 = tc_new()
  var fn2 = [as_int("x"), as_int("y")]
  var ft2 = [type_constants::TYPE_INT, type_constants::TYPE_INT]
  typecheck_registry::tc_register_struct(tc8, "Point", fn2, ft2, "", vec_new(), 0, vec_new())

  var struct_result = tc_check_struct_init(tc8, "Point", 2, 1, 1)
  if tc_is_struct_type(struct_result)
    puts("  Valid struct init: PASS")
  else
    puts("  Valid struct init: FAIL")
  end
  
  var bad_struct_result = tc_check_struct_init(tc8, "Point", 3, 2, 1)
  if bad_struct_result == type_constants::TYPE_ERROR
    puts("  Wrong field count: PASS")
  else
    puts("  Wrong field count: FAIL")
  end
  
  # Test enum access checking
  puts("Testing enum access checking...")
  var tc9 = tc_new()
  var vn = [as_int("Ok"), as_int("Err")]
  var vp = vec_new()
  typecheck_registry::tc_register_enum(tc9, "Result", vn, vp, "", vec_new())
  
  var enum_result = tc_check_enum_access(tc9, "Result", "Ok", 1, 1)
  if enum_result == type_constants::TYPE_ENUM
    puts("  Valid enum access: PASS")
  else
    puts("  Valid enum access: FAIL")
  end
  
  var bad_enum_result = tc_check_enum_access(tc9, "Result", "Maybe", 2, 1)
  if bad_enum_result == type_constants::TYPE_ERROR
    puts("  Invalid variant: PASS")
  else
    puts("  Invalid variant: FAIL")
  end
  
  puts("")
  puts("=== Type Checker Test Complete ===")
  
  return 0
end
