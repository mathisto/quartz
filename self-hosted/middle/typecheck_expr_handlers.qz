##! # Type Checker Expression Handlers
##!
##! Handler functions dispatched from tc_expr for complex expression types.
##! These functions call back into tc_expr for recursive type checking.
##!
##! @see typecheck_walk Main AST walking module (tc_expr dispatcher)

import typecheck
import typecheck_util
import typecheck_diag
import typecheck_builtins
import typecheck_registry
import typecheck_helpers
import typecheck_generics
import typecheck_match
import typecheck_capture
import typecheck_concurrency
import typecheck_walk
import ast
import liveness
import diagnostic
import resolver
import node_constants
import type_constants
import string_intern
import compiler_types
import std/diag
import * from str_compat

# ============================================================================
# Mangled Name Cache (delegates to string_intern::mangle)
# ============================================================================

def tc_mangle(tc: TypecheckState, prefix: String, suffix: String): String
  return string_intern::mangle(prefix, suffix)
end

# ============================================================================
# Expression Type Checking - Handler Functions
# ============================================================================

def tc_check_op_overload(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, left_node: AstNodeId, left_type: TypeId, op: Int): Int
  if left_type != type_constants::TYPE_STRUCT
    return 0
  end
  var struct_name = ""
  var left_kind = ast::ast_get_kind(ast_storage, left_node)
  if left_kind == node_constants::NODE_IDENT
    var ident_name = ast::ast_get_str1(ast_storage, left_node)
    struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, ident_name)
  elsif left_kind == node_constants::NODE_STRUCT_INIT
    struct_name = ast::ast_get_str1(ast_storage, left_node)
  elsif left_kind == node_constants::NODE_BINARY
    struct_name = ast::ast_get_str2(ast_storage, left_node)
  end
  if str_byte_len(struct_name) == 0
    return 0
  end
  var op_method = match op
    0 => "op_add"
    1 => "op_sub"
    2 => "op_mul"
    3 => "op_div"
    4 => "op_mod"
    7 => "op_eq"
    8 => "op_ne"
    9 => "op_lt"
    10 => "op_le"
    11 => "op_gt"
    12 => "op_ge"
    _ => ""
  end
  if str_byte_len(op_method) == 0
    return 0
  end
  var mangled = tc_mangle(tc, struct_name, op_method)
  var fn_type = typecheck_registry::tc_lookup_function_return(tc, mangled)
  if fn_type != type_constants::TYPE_ERROR and fn_type > 0
    ast::ast_set_str2(ast_storage, node, struct_name)
    if op >= 7 and op <= 12
      return type_constants::TYPE_BOOL
    end
    return type_constants::TYPE_STRUCT
  end
  return 0
end

## Type-check a NODE_STRUCT_INIT expression (struct literal construction).
## Extracted from tc_expr to reduce function size.
def tc_expr_struct_init(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
  var struct_name = ast::ast_get_str1(ast_storage, node)
  var field_inits = ast::ast_get_children(ast_storage, node)
  var field_names_for_spread = ast::ast_get_struct_init_field_names(ast_storage, node)

  # C.1 — struct update syntax: `Struct { ...base, k: v }` desugar.
  # Parser stored the spread-base AST handle in the `lefts` slot. If
  # present, fetch the struct's registered field list and synthesize
  # `field: base.field` nodes for every field NOT explicitly provided.
  # Explicit overrides take precedence; unknown fields fall through to
  # the existing field-name validation.
  var spread_base = ast::ast_get_left(ast_storage, node)
  if spread_base != 0
    var spread_lookup = typecheck_registry::tc_lookup_struct(tc, struct_name)
    var spread_idx = match spread_lookup
      Found(v) => v
      NotFound => -1
    end
    if spread_idx >= 0
      var registry_fields = typecheck_registry::tc_struct_field_names(tc, spread_idx)
      var registry_field_count = vec_size(registry_fields)
      for ru_i in 0..registry_field_count
        var reg_name = as_string(registry_fields[ru_i])
        var already_set = 0
        var explicit_count = vec_size(field_names_for_spread)
        for ru_j in 0..explicit_count
          var existing = as_string(field_names_for_spread[ru_j])
          if existing.eq(reg_name)
            already_set = 1
          end
        end
        if already_set == 0
          var fa_node = ast::ast_field_access(ast_storage, spread_base, reg_name, line, col)
          field_names_for_spread.push(reg_name)
          field_inits.push(fa_node)
        end
      end
    end
    # Idempotent: clear the spread slot so later phases don't re-expand.
    ast::ast_set_left(ast_storage, node, 0)
  end

  var field_count = field_inits.size

  # Resolve type alias: e.g., IntBox → Box<Int>
  var alias_lookup = typecheck_registry::tc_lookup_struct(tc, struct_name)
  if alias_lookup.is_found() == false
    var aliased = typecheck::tc_lookup_type_alias(tc, struct_name)
    if str_byte_len(aliased) > 0
      var lt_pos = __char_index(aliased, '<')
      if lt_pos > 0
        struct_name = str_byte_slice(aliased, 0, lt_pos)
        var args = str_byte_slice(aliased, lt_pos + 1, str_byte_len(aliased) - 1)
        ast::ast_set_str1(ast_storage, node, struct_name)
        ast::ast_set_str2(ast_storage, node, args)
      else
        struct_name = aliased
        ast::ast_set_str1(ast_storage, node, struct_name)
      end
    end
  end

  # QZ1211: Pre-read borrow sources BEFORE tc_expr (which triggers NLL release)
  var field_borrow_srcs = vec_new()
  for si_pre in 0..field_count
    var si_pre_field = field_inits[si_pre]
    var si_pre_kind = ast::ast_get_kind(ast_storage, si_pre_field)
    if si_pre_kind == node_constants::NODE_IDENT
      var si_pre_name = ast::ast_get_str1(ast_storage, si_pre_field)
      var si_pre_bidx = typecheck_util::tc_lookup_binding_index(tc, si_pre_name)
      if si_pre_bidx >= 0
        field_borrow_srcs.push(tc.safety.binding_borrow_sources[si_pre_bidx])
      else
        field_borrow_srcs.push(0)
      end
    else
      field_borrow_srcs.push(0)
    end
  end

  # SURF.FLOW Phase 2 soundness — resolve the struct's registered field names so a
  # field value that flows whole into an `Option<...>`/`Result<...>` field slot can
  # have its narrowed-read payload-extract stamp RETRACTED (a narrowed read stored
  # into a wide Option field would put a scalar where an Option word is expected →
  # SIGSEGV; the tui_form/tui_focus_ring regression). Best-effort: TYPE_ERROR base
  # if the struct/field can't be resolved → leave narrowing (the common inner-T use).
  var si_struct_lookup = typecheck_registry::tc_lookup_struct(tc, struct_name)
  var si_struct_idx = match si_struct_lookup
    Found(v) => v
    NotFound => -1
  end
  var si_init_field_names = ast::ast_get_struct_init_field_names(ast_storage, node)

  # Type check all field values and collect their types
  var field_types = vec_new()
  for i in 0..field_count
    var ft = typecheck_walk::tc_expr(tc, ast_storage, field_inits[i])
    # Retract a narrowed-read stamp on a bare-ident field value whose destination
    # field type is wide Option/Result. Runs post-walk → order-independent.
    var si_field_expect = type_constants::TYPE_ERROR
    if si_struct_idx >= 0 and i < si_init_field_names.size
      var si_fname = as_string(si_init_field_names[i])
      var si_ann = typecheck::tc_struct_field_annotation(tc, si_struct_idx, si_fname)
      if str_byte_len(si_ann) > 0
        si_field_expect = typecheck_util::tc_narrow_expect_base_of_annotation(tc, si_ann)
      end
    end
    typecheck_walk::tc_unstamp_narrowed_into_wide(tc, ast_storage, field_inits[i], si_field_expect)
    field_types.push(ft)
  end

  # QZ1211: Check for borrow escape into struct fields
  # Move semantics: consume moveable args passed as struct field values
  for si_i in 0..field_count
    var si_field = field_inits[si_i]
    var si_field_kind = ast::ast_get_kind(ast_storage, si_field)
    if si_field_kind == node_constants::NODE_FUNC_REF
      var escaped_name = ast::ast_get_str1(ast_storage, si_field)
      error("QZ1211: Cannot store borrow of '#{escaped_name}' in struct field — borrow may outlive source", line, col)
    elsif si_field_kind == node_constants::NODE_IDENT
      # Indirect borrow: uses pre-captured borrow source (before NLL release)
      if field_borrow_srcs[si_i] != 0
        var field_var = ast::ast_get_str1(ast_storage, si_field)
        var bsrc = as_string(field_borrow_srcs[si_i])
        error("QZ1211: Cannot store borrow in struct field — '#{field_var}' holds a borrow of '#{bsrc}'", line, col)
      end
      # Move consumption: struct init consumes owned values
      var si_ident_name = ast::ast_get_str1(ast_storage, si_field)
      typecheck_registry::tc_move_on_call(tc, si_ident_name, struct_name, line, col)
    end
  end

  result = with Diag {
    error: typecheck_diag::tc_diag_error_handler
  } do ->
    typecheck_generics::tc_check_struct_init(tc, struct_name, field_count, line, col)
  end

  # Check field types and names if struct init count was valid
  if result != type_constants::TYPE_ERROR
    var field_names_vec = ast::ast_get_struct_init_field_names(ast_storage, node)
    var type_args = ast::ast_get_str2(ast_storage, node)

    # Infer type args from field values when no explicit type args
    var has_type_args = false
    if str_byte_len(type_args) > 0
      has_type_args = true
    end
    if has_type_args == false
      var struct_result = typecheck_registry::tc_lookup_struct(tc, struct_name)
      var struct_idx = match struct_result
        Found(v) => v
        NotFound => -1
      end
      if struct_idx >= 0
        var params = typecheck::tc_struct_type_params(tc, struct_idx)
        if str_byte_len(params) > 0
          type_args = typecheck_generics::tc_infer_struct_type_args(tc, ast_storage, struct_idx, params, field_names_vec, field_types, field_inits)
          if str_byte_len(type_args) > 0
            ast::ast_set_str2(ast_storage, node, type_args)
          end
        end
      end
    end

    with Diag {
      error: typecheck_diag::tc_diag_error_handler
    } do ->
      typecheck_generics::tc_check_struct_init_field_types(tc, struct_name, type_args, field_names_vec, field_types, line, col)
    end

    # BOUNDED-STRUCT-FIELD-HANG fix: validate trait bounds on struct type
    # params. When a struct is declared as `struct W<C: Counter>`, the concrete
    # type supplied for `C` must implement `Counter`. Before this check, the
    # parser couldn't even parse the bound; now we enforce it at init time.
    var sb_struct_result = typecheck_registry::tc_lookup_struct(tc, struct_name)
    var sb_struct_idx = match sb_struct_result
      Found(v) => v
      NotFound => -1
    end
    if sb_struct_idx >= 0
      var sb_params = typecheck::tc_struct_type_params(tc, sb_struct_idx)
      if str_byte_len(sb_params) > 0
        with Diag {
          error: typecheck_diag::tc_diag_error_handler
        } do ->
          typecheck_generics::tc_check_struct_type_param_bounds(tc, struct_name, sb_params, type_args, line, col)
        end
      end
    end

    # Strict literal type mismatch for struct fields:
    # string literal in Int field or int literal in String field
    var struct_result2 = typecheck_registry::tc_lookup_struct(tc, struct_name)
    var struct_idx2 = match struct_result2
      Found(v) => v
      NotFound => -1
    end
    if struct_idx2 >= 0
      for fli in 0..field_count
        var fl_kind = ast::ast_get_kind(ast_storage, field_inits[fli])
        if fl_kind == node_constants::NODE_STRING_LIT or fl_kind == node_constants::NODE_INT_LIT
          var fl_name = as_string(field_names_vec[fli])
          var fl_expected = typecheck_registry::tc_struct_field_type(tc, struct_idx2, fl_name)
          if fl_kind == node_constants::NODE_STRING_LIT
            if fl_expected == type_constants::TYPE_INT or fl_expected == type_constants::TYPE_BOOL
              error("Field #{fl_name}: expected #{typecheck::tc_type_name(fl_expected)}, got String", line, col)
            end
          elsif fl_kind == node_constants::NODE_INT_LIT
            if fl_expected == type_constants::TYPE_STRING
              error("Field #{fl_name}: expected #{typecheck::tc_type_name(fl_expected)}, got Int", line, col)
            end
          end
        end
      end
    end
  end
  result
  end  # close body-wrap
end

## Type-check a NODE_LAMBDA expression (closure/lambda definition).
## Extracted from tc_expr to reduce function size.
def tc_expr_lambda(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  var params = ast::ast_get_left(ast_storage, node)
  var body = ast::ast_get_right(ast_storage, node)

  # Build param names vec for capture collection
  var param_names = vec_new()
  if params > 0
    param_names = params.map(p: Int -> as_int(ast::ast_get_str1(ast_storage, p)))
  end

  # Collect captures BEFORE entering lambda scope (while outer scope is active)
  var captures = typecheck_capture::tc_collect_captures(tc, ast_storage, node, param_names)

  # SURF.FLOW Phase 2 — closure-capture barrier. A `var` captured by this lambda
  # could be reassigned through the closure (or the closure called re-entrantly),
  # so any active narrowing on a captured MUTABLE binding is no longer provably
  # live: invalidate it. const captures stay narrowed (const can't be reassigned).
  for cap_b in 0..captures.size
    var cap_bn = as_string(captures[cap_b])
    if typecheck_util::tc_scope_lookup_mutable(tc, cap_bn) != 0
      typecheck_util::tc_narrow_invalidate(tc, cap_bn)
    end
  end

  # Move semantics: captured moveable bindings are consumed by the lambda
  for cap_i in 0..captures.size
    var cap_name = captures[cap_i]
    typecheck_registry::tc_move_on_call(tc, cap_name, "<lambda>", line, col)
  end

  # Store captures in AST extra slot
  ast::ast_set_extra(ast_storage, node, captures)

  typecheck_util::tc_enter_scope()

  # Save outer function's return type before processing lambda body
  var saved_return_type = typecheck_util::tc_get_return_type(tc)
  # Lambda bodies don't have an explicit return type declaration,
  # so we set Void (unset sentinel) — return type inferred from last expr
  typecheck_util::tc_set_return_type(tc, type_constants::TYPE_VOID)

  # Bind parameters
  if params > 0
    var param_count = vec_size(params)
    for i in 0..param_count
      var param = params[i]
      var param_name = ast::ast_get_str1(ast_storage, param)
      var param_type_ann = ast::ast_get_str2(ast_storage, param)

      var param_type = type_constants::TYPE_INT
      var param_struct_name = ""
      if str_byte_len(param_type_ann) > 0
        param_type = typecheck::tc_parse_type(tc, param_type_ann)
        # Generic type params (e.g. T) resolve to type_constants$TYPE_ERROR.
        # Fall back to type_constants$TYPE_INT so the binding is visible in scope lookup
        # (type_constants$TYPE_ERROR is also the "not found" sentinel).
        if param_type == type_constants::TYPE_ERROR
          param_type = type_constants::TYPE_INT
        end
        # If it's a struct or enum type, store the type name
        if typecheck::tc_is_struct_type(param_type)
          param_struct_name = param_type_ann
        elsif param_type == type_constants::TYPE_ENUM
          param_struct_name = param_type_ann
        end
      else
        # T3c.1 Phase 3: No annotation — assign fresh type variable for polymorphism
        param_type = typecheck_util::tc_tv_fresh_with_origin(tc, line, col, "lambda param #{param_name}")
      end

      if typecheck::tc_type_is_function(tc, param_type)
        # Resolve type alias to get actual Fn(...) annotation for arity extraction
        var fn_ann = param_type_ann
        var fn_aliased = typecheck::tc_lookup_type_alias(tc, fn_ann)
        if str_byte_len(fn_aliased) > 0
          fn_ann = fn_aliased
        end
        var fn_pc = typecheck::tc_fn_annotation_param_count(tc, fn_ann)
        typecheck_util::tc_scope_bind_full(tc, param_name, type_constants::TYPE_FUNCTION, 1, fn_pc, "", fn_ann)
      else
        typecheck_util::tc_scope_bind_full(tc, param_name, param_type, 1, -1, param_struct_name, param_type_ann)
      end
    end
  end

  # Type check body
  # Note: body >= 0 because node handle 0 is valid (first AST node)
  if body >= 0
    tc.scope.last_lambda_body_type = typecheck_walk::tc_expr(tc, ast_storage, body)
  end

  # Restore outer function's return type
  typecheck_util::tc_set_return_type(tc, saved_return_type)

  # T3c.1 Phase 3: Build structured function ptype from lambda param types + body type
  var lam_body_type = tc.scope.last_lambda_body_type
  var lam_param_types = vec_new()
  if params > 0
    var lam_pc = vec_size(params)
    for lp_i in 0..lam_pc
      var lp_param = params[lp_i]
      var lp_name = ast::ast_get_str1(ast_storage, lp_param)
      var lp_type = typecheck_util::tc_scope_lookup(tc, lp_name)
      # Resolve type variable if it was constrained (by operator, call, etc.)
      if typecheck_util::tc_tv_is_var(lp_type) == 1
        lp_type = typecheck_util::tc_tv_resolve(tc, lp_type)
      end
      lam_param_types.push(lp_type)
    end
  end

  typecheck::tc_exit_scope(tc)

  # If we have param type info, create a structured function ptype
  if lam_param_types.size > 0 or lam_body_type != type_constants::TYPE_VOID
    var lam_ret = lam_body_type
    if lam_ret == type_constants::TYPE_VOID or lam_ret == 0
      lam_ret = type_constants::TYPE_INT
    end
    result = typecheck_registry::tc_make_fn_type_from_types(tc, lam_param_types, lam_ret)
  else
    result = type_constants::TYPE_FUNCTION
  end
  return result
end

## Type-check a NODE_INDEX expression (array/map/string indexing).
## Extracted from tc_expr to reduce function size.
def tc_expr_index(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  var array_node = ast::ast_get_left(ast_storage, node)
  var index_node = ast::ast_get_right(ast_storage, node)

  var array_type = typecheck_walk::tc_expr(tc, ast_storage, array_node)
  var index_type = typecheck_walk::tc_expr(tc, ast_storage, index_node)

  # GAP-B2-nonident-narrow — flow-narrowed element read `v[0]`. If a refinement for
  # this element's access path (`v[0]`) is active (pushed by `if v[0] is Member`),
  # the read sees the inner member type; stamp int_val=1 so MIR wraps the element
  # load in mir_emit_narrowed_read (payload@1 of the union cell). We consult BEFORE
  # the container-dispatch rewrite (which would turn NODE_INDEX into a get-call) so
  # the node stays NODE_INDEX and the MIR NODE_INDEX handler applies the recovery.
  # Only const-index paths get a key (tc_access_path_key) ⇒ additive, gate-0-inert.
  var ix_np_key = typecheck_util::tc_access_path_key(ast_storage, node)
  if str_byte_len(ix_np_key) > 0
    var ix_narrowed = typecheck_util::tc_narrow_lookup(tc, ix_np_key)
    if ix_narrowed != type_constants::TYPE_ERROR
      if ast::ast_get_int_val(ast_storage, node) != 2
        ast::ast_set_int_val(ast_storage, node, 1)
      end
      return ix_narrowed
    end
  end

  # STRICT_NEWTYPES — indexing by a strict-newtype value would leak its bits
  # via the addressed memory access pattern (cache-timing). Reject. Unwrap
  # explicitly at the boundary. See docs/design/STRICT_NEWTYPES_DESIGN.md.
  if typecheck::tc_is_strict_newtype(tc, index_type)
    with Diag {
      error: typecheck_diag::tc_diag_error_handler
    } do ->
      error("Cannot index by a strict-newtype value — leaks bits via memory-access timing. Unwrap (`as_type<Int>(s)`) and use the raw int, or restructure the access to be position-independent.", line, col)
    end
    return type_constants::TYPE_ERROR
  end

  # Custom index dispatch: if subject is a struct with $get method,
  # rewrite node_constants$NODE_INDEX → node_constants$NODE_CALL(Type$get, [obj, key])
  var struct_name = ""
  var obj_kind = ast::ast_get_kind(ast_storage, array_node)
  if obj_kind == node_constants::NODE_IDENT
    var var_name = ast::ast_get_str1(ast_storage, array_node)
    struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, var_name)
  end
  if str_byte_len(struct_name) > 0
    # Strip module prefix (e.g. "mod$MyType" → "MyType")
    var dollar_pos = __char_index(struct_name, '$')
    var base_name = struct_name
    if dollar_pos >= 0
      base_name = str_byte_slice(struct_name, dollar_pos + 1, str_byte_len(struct_name))
    end
    var mangled = tc_mangle(tc, base_name, "get")
    var get_type = typecheck_builtins::tc_lookup_builtin(tc, mangled)
    if get_type == type_constants::TYPE_ERROR
      get_type = typecheck_registry::tc_lookup_function_return(tc, mangled)
    end
    if get_type == type_constants::TYPE_ERROR
      # Fallback: check for op_index (Index trait)
      var idx_mangled = tc_mangle(tc, base_name, "op_index")
      var idx_type = typecheck_registry::tc_lookup_function_return(tc, idx_mangled)
      if idx_type > 0 and idx_type != type_constants::TYPE_ERROR
        get_type = idx_type
        mangled = idx_mangled
      end
    end
    if get_type != type_constants::TYPE_ERROR
      # Rewrite node_constants$NODE_INDEX → node_constants$NODE_CALL(Type$get, [obj, key])
      var args = vec_new()
      args.push(array_node)
      args.push(index_node)
      var callee = ast::ast_ident(ast_storage, mangled, line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_right(ast_storage, node, 0)
      ast::ast_set_children(ast_storage, node, args)
      result = get_type
    else
      result = with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_helpers::tc_check_index(tc, array_type, index_type, line, col)
      end
    end
  else
    var base_array_type = typecheck::tc_base_kind(tc, array_type)
    if base_array_type == type_constants::TYPE_STRING
      if index_type == type_constants::TYPE_RANGE
        # s[a..b] — codepoint-range substring. Leave the node as NODE_INDEX so
        # the MIR range-index path (mir_lower.qz) lowers it to `str_slice`
        # (codepoint range [a, b)) via the String-base dispatch. Every other
        # collection arm (Vec/Slice) does the same — the range subscript is
        # handled in MIR, not rewritten here. Result is a fresh String.
        result = type_constants::TYPE_STRING
      else
        # Rewrite s[i] → str_codepoint_nth(s, i) — n-th codepoint, O(n) walk.
        # Codepoint-indexed semantics matches Python/Ruby `s[i]` UX. For
        # byte-offset access use str_byte_at; for byte-offset codepoint
        # decode (sequential walking) use str_codepoint_at + str_codepoint_byte_len.
        var sc_args = vec_new()
        sc_args.push(array_node)
        sc_args.push(index_node)
        var sc_callee = ast::ast_ident(ast_storage, "str_codepoint_nth", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, sc_callee)
        ast::ast_set_right(ast_storage, node, 0)
        ast::ast_set_children(ast_storage, node, sc_args)
        result = type_constants::TYPE_INT
      end
    elsif base_array_type == type_constants::TYPE_MAP
      # Rewrite m[key] → map_fetch(m, key) — panics if key not found.
      # Use m.get(key) for safe Option<V> access.
      var hm_args = vec_new()
      hm_args.push(array_node)
      hm_args.push(index_node)
      var hm_callee = ast::ast_ident(ast_storage, "map_fetch", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, hm_callee)
      ast::ast_set_right(ast_storage, node, 0)
      ast::ast_set_children(ast_storage, node, hm_args)
      # Propagate value type through parameterized Map
      if typecheck::tc_is_ptype(array_type)
        result = typecheck::tc_ptype_arg2(tc, array_type)
      else
        result = type_constants::TYPE_INT
      end
    elsif base_array_type == type_constants::TYPE_SLICE or base_array_type == type_constants::TYPE_SLICE_MUT
      # Tier 4 #24 Phase 4b §2.4: s[i] — scalar index rewrites to slice_get.
      # Slice<Byte> routes to byte_slice_get (1-byte stride + zext).
      if index_type == type_constants::TYPE_RANGE
        # Nested slice: s[a..b] — preserve Slice<T> type. MIR detects the
        # Slice base and emits `subslice` (24-byte → 24-byte) instead of
        # `slice` (32-byte Vec → 24-byte slice).
        result = array_type
      else
        var sl_elem = 0
        if typecheck::tc_is_ptype(array_type)
          sl_elem = typecheck::tc_ptype_arg1(tc, array_type)
        end
        var get_fn = "slice_get"
        if sl_elem == type_constants::TYPE_BYTE
          get_fn = "byte_slice_get"
        end
        var sc_args = vec_new()
        sc_args.push(array_node)
        sc_args.push(index_node)
        var sc_callee = ast::ast_ident(ast_storage, get_fn, line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, sc_callee)
        ast::ast_set_right(ast_storage, node, 0)
        ast::ast_set_children(ast_storage, node, sc_args)
        if sl_elem > 0 and sl_elem != type_constants::TYPE_BYTE
          result = sl_elem
        else
          result = type_constants::TYPE_INT
        end
      end
    else
      result = with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_helpers::tc_check_index(tc, array_type, index_type, line, col)
      end
      # Annotate Vec element type for width-aware codegen (mem-v2)
      var _si_elem_t = 0
      var _si_elem_name = ""
      if typecheck::tc_is_ptype(array_type)
        if base_array_type == type_constants::TYPE_VEC
          _si_elem_t = typecheck::tc_ptype_arg1(tc, array_type)
          _si_elem_name = typecheck::tc_type_name(_si_elem_t)
          # For struct/enum elements, use the actual name from ptype (not generic "Struct")
          if typecheck::tc_is_struct_type(_si_elem_t) or _si_elem_t == type_constants::TYPE_ENUM
            var ptype_sname = typecheck::tc_ptype_name(tc, array_type)
            if str_byte_len(ptype_sname) > 0
              _si_elem_name = ptype_sname
              # Return the struct/enum type (not Int) for typed access
              result = _si_elem_t
            end
          end
          # R2 (C3) — a `Vec<{ x: Int }>` element read `v[i]`: tc_type_name yields a
          # non-annotation placeholder for a record type-id, but MIR's index seam needs
          # the `{ x: Int }` field-annotation spelling to canonicalize to C1's @value
          # record struct + take the inline value-layout read stride. tc_tv_type_name
          # renders a closed record as `{ x: Int }`. Also return the record type so `e`
          # binds as the record (typed field access). GATE-0-INERT: no compiler Vec has
          # a record element.
          if typecheck_registry::tc_is_record_type(_si_elem_t)
            var si_rec_ann = typecheck_util::tc_tv_type_name(tc, _si_elem_t)
            if str_byte_len(si_rec_ann) > 0 and str_byte_at(si_rec_ann, 0) == 123
              _si_elem_name = si_rec_ann
              result = _si_elem_t
            end
          end
          ast::ast_set_str2(ast_storage, node, _si_elem_name)
        end
      end
      # Tier 4 #24 Phase 4b §2.4: v[a..b] now produces Slice<T>, not Vec<T>.
      # Zero-copy 16-byte header; mir_lower switches emit from vec_slice to
      # slice. Applied even for bare TYPE_VEC (no ptype) so the type
      # propagates into `s = v[..]` bindings and downstream UFCS picks the
      # slice dispatch.
      if index_type == type_constants::TYPE_RANGE
        if base_array_type == type_constants::TYPE_VEC or base_array_type == type_constants::TYPE_ARRAY
          result = typecheck::tc_make_ptype(tc, type_constants::TYPE_SLICE, _si_elem_t, 0)
          if typecheck::tc_is_struct_type(_si_elem_t) or _si_elem_t == type_constants::TYPE_ENUM
            if str_byte_len(_si_elem_name) > 0
              typecheck::tc_ptype_set_name(tc, result, _si_elem_name)
            end
          end
        end
      end
    end
  end
  return result
end

## Type-check a NODE_TRY_EXPR expression (try-unwrap, UFCS predicates).
## Extracted from tc_expr to reduce function size.
def tc_expr_try(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  var expr = ast::ast_get_left(ast_storage, node)
  var expr_kind = ast::ast_get_kind(ast_storage, expr)

  # Check for UFCS predicate pattern: v.empty?
  if expr_kind == node_constants::NODE_FIELD_ACCESS
    var object_node = ast::ast_get_left(ast_storage, expr)
    var field_name = ast::ast_get_str1(ast_storage, expr)
    var object_type = typecheck::tc_base_kind(tc, typecheck_walk::tc_expr(tc, ast_storage, object_node))

    # Check for "empty" predicate
    if field_name == "empty"
      var size_func = ""

      if object_type == type_constants::TYPE_STRING
        size_func = "str_size"
      elsif object_type == type_constants::TYPE_VEC or object_type == type_constants::TYPE_ARRAY
        size_func = "vec_size"
      elsif object_type == type_constants::TYPE_MAP
        size_func = "map_size"
      elsif object_type == type_constants::TYPE_SET
        size_func = "set_size"
      end

      if str_byte_len(size_func) > 0
        # Rewrite v.empty? to (vec_size(v) == 0)
        # 1. Create args vector with the object
        var args = [object_node]

        # 2. Create function call node: vec_size(v)
        var callee = ast::ast_ident(ast_storage, size_func, line, col)
        var call_node = ast::ast_call(ast_storage, callee, args, line, col)

        # 3. Create literal 0 node
        var zero_node = ast::ast_int_lit(ast_storage, 0, line, col)

        # 4. Rewrite node to binary comparison: (call == 0)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
        ast::ast_set_left(ast_storage, node, call_node)
        ast::ast_set_right(ast_storage, node, zero_node)
        ast::ast_set_op(ast_storage, node, 7)

        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        # Not a builtin type with .empty? - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Check for "nil" predicate (for pointer types)
    elsif field_name == "nil"
      if object_type == type_constants::TYPE_PTR
        # Build nil literal
        var nil_node = ast::ast_nil_lit(ast_storage, line, col)

        # Rewrite to (obj == nil)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
        ast::ast_set_left(ast_storage, node, object_node)
        ast::ast_set_right(ast_storage, node, nil_node)
        ast::ast_set_str1(ast_storage, node, "==")

        result = type_constants::TYPE_BOOL
      else
        # Not a pointer type - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Check for "some" predicate (for Option types) - v5.8.5
    # Rewrite opt.some? to option_is_some(opt) intrinsic call
    elsif field_name == "some"
      if object_type == type_constants::TYPE_OPTION
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "option_is_some", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        # Not an Option type - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Check for "none" predicate (for Option types) - v5.8.5
    # Rewrite opt.none? to (not option_is_some(opt))
    elsif field_name == "none"
      if object_type == type_constants::TYPE_OPTION
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "option_is_some", line, col)
        var call_node = ast::ast_call(ast_storage, callee, args, line, col)
        var zero_node = ast::ast_int_lit(ast_storage, 0, line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
        ast::ast_set_left(ast_storage, node, call_node)
        ast::ast_set_right(ast_storage, node, zero_node)
        ast::ast_set_op(ast_storage, node, 7)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        # Not an Option type - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Check for "ok" predicate (for Result types) - v5.8.4
    # Rewrite res.ok? to is_ok(res) function call
    elsif field_name == "ok"
      if object_type == type_constants::TYPE_RESULT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_ok", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        # Not a Result type - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Check for "err" predicate (for Result types) - v5.8.4
    # Rewrite res.err? to is_err(res) function call
    elsif field_name == "err"
      if object_type == type_constants::TYPE_RESULT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_err", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        # Not a Result type - fall back to regular try-unwrap
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    # Char predicates on Int type (v5.8.4)
    # Rewrites c.digit? to is_digit(c), c.alpha? to is_alpha(c), etc.
    elsif field_name == "digit"
      if object_type == type_constants::TYPE_INT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_digit", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    elsif field_name == "alpha"
      if object_type == type_constants::TYPE_INT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_alpha", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    elsif field_name == "alnum"
      if object_type == type_constants::TYPE_INT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_alnum", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end

    elsif field_name == "whitespace"
      if object_type == type_constants::TYPE_INT
        var args = [object_node]
        var callee = ast::ast_ident(ast_storage, "is_whitespace", line, col)
        ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
        ast::ast_set_left(ast_storage, node, callee)
        ast::ast_set_children(ast_storage, node, args)
        result = typecheck_walk::tc_expr(tc, ast_storage, node)
      else
        typecheck_walk::tc_expr(tc, ast_storage, expr)
        result = type_constants::TYPE_INT
      end
    else
      # Unknown predicate - fall back to regular try-unwrap
      typecheck_walk::tc_expr(tc, ast_storage, expr)
      result = type_constants::TYPE_INT
    end
  else
    # Regular try-unwrap: yield the payload type T of the Result<T,E> / Option<T>.
    # The inner expr carries a proper ptype (e.g. json_parse -> Result<JsonValue,_>);
    # read its arg1 back out rather than collapsing to Int. Mirrors the payload
    # extraction the match typechecker already does (typecheck_match.qz:699-719).
    var inner_t = typecheck_walk::tc_expr(tc, ast_storage, expr)
    # SURF.FLOW Phase 3 soundness — `try parsed` extracts the Ok/Some payload from
    # the WHOLE Result/Option word. A narrowed bare-ident operand (`if parsed is Err
    # return end; try parsed`) carries the int_val=1 payload-extract stamp; letting it
    # pre-extract makes `try` double-extract a scalar as the enum word → garbage →
    # SIGSEGV (persistent_worker_protocol decode_request/decode_response). The try
    # operand is a wide-slot consuming context exactly like a let/return/call-arg, so
    # pin the stamp off. `inner_t` is the NARROWED inner type here (the ident handler
    # already refined the read), so derive the wide destination base from the
    # operand's own DECLARED binding type — by construction `try` consumes the whole
    # declared Option/Result word, so its declared base IS the destination base, and
    # the pin's same-base round-trip condition holds. Inert for non-narrowed operands
    # (FLOW_NARROWING §3.3).
    if ast::ast_get_kind(ast_storage, expr) == node_constants::NODE_IDENT
      var try_opnd_name = ast::ast_get_str1(ast_storage, expr)
      var try_opnd_bidx = typecheck_util::tc_lookup_binding_index(tc, try_opnd_name)
      if try_opnd_bidx >= 0
        var try_opnd_decl = tc.scope.binding_types[try_opnd_bidx]
        typecheck_walk::tc_unstamp_narrowed_into_wide(tc, ast_storage, expr, typecheck_util::tc_narrow_expect_base_of_type(tc, try_opnd_decl))
      end
    end
    if inner_t >= type_constants::PTYPE_BASE
      var base = typecheck::tc_ptype_base(tc, inner_t)
      if base == type_constants::TYPE_OPTION or base == type_constants::TYPE_RESULT
        result = typecheck::tc_ptype_arg1(tc, inner_t)
      else
        result = type_constants::TYPE_INT
      end
    else
      # Bare TYPE_RESULT / TYPE_OPTION with no recorded type args — payload was
      # genuinely erased upstream; keep the Int sentinel (matches the bare-scalar
      # corner in typecheck_match.qz:656-665).
      result = type_constants::TYPE_INT
    end
  end
  return result
end

## Type-check a NODE_MATCH expression (pattern matching).
## Extracted from tc_expr to reduce function size.
def tc_expr_match(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
  var subject_node = ast::ast_get_left(ast_storage, node)
  var arms = ast::ast_get_children(ast_storage, node)
  var subject_type = typecheck_walk::tc_expr(tc, ast_storage, subject_node)
  var arm_count = arms.size
  result = typecheck_match::tc_check_match(subject_type, arm_count, line, col)

  # STRICT_NEWTYPES — matching on a strict-newtype subject leaks its bits
  # via control flow exactly like an if/while condition. Reject. Same audit
  # path as tc_check_condition. See docs/design/STRICT_NEWTYPES_DESIGN.md.
  if typecheck::tc_is_strict_newtype(tc, subject_type)
    error("Cannot match on a strict-newtype value — would leak its bits via control flow. Unwrap first (e.g. `as_type<Int>(s)`), or compare via a constant-time helper from `std/core/crypto/subtle`.", line, col)
    result = type_constants::TYPE_ERROR
  end

  # Resolve the subject's enum name for unqualified variant patterns.
  # When subject_type == TYPE_ENUM, it doesn't carry which specific enum.
  # Derive it from the subject expression so `Ok(data)` resolves against
  # the correct enum (e.g., ReadResult) instead of the first-registered one.
  var match_enum_name = ""
  if subject_type == type_constants::TYPE_ENUM
    var subj_kind = ast::ast_get_kind(ast_storage, subject_node)
    if subj_kind == node_constants::NODE_CALL
      var subj_callee = ast::ast_get_left(ast_storage, subject_node)
      if subj_callee >= 0 and ast::ast_get_kind(ast_storage, subj_callee) == node_constants::NODE_IDENT
        var subj_fn_name = ast::ast_get_str1(ast_storage, subj_callee)
        match_enum_name = typecheck_registry::tc_lookup_function_return_annotation(tc, subj_fn_name)
      end
    elsif subj_kind == node_constants::NODE_IDENT
      var subj_var_name = ast::ast_get_str1(ast_storage, subject_node)
      match_enum_name = typecheck_util::tc_scope_lookup_annotation(tc, subj_var_name)
    end
  end

  # Move semantics: consume moveable match subject
  if ast::ast_get_kind(ast_storage, subject_node) == node_constants::NODE_IDENT
    var match_subj_name = ast::ast_get_str1(ast_storage, subject_node)
    typecheck_registry::tc_move_on_call(tc, match_subj_name, "<match>", line, col)
  end

  # Snapshot move/partial/linear states AFTER subject consumption, BEFORE arms.
  # Each arm is mutually exclusive — they must all start from the same baseline.
  var match_move_snapshot = typecheck_registry::tc_snapshot_move_states(tc)
  var match_partial_snapshot = typecheck_registry::tc_snapshot_partial_moves(tc)
  var match_linear_snapshot = typecheck_registry::tc_snapshot_linear_states(tc)

  # N-way merge tracking: for each binding, track whether ANY arm moved it
  # and whether ALL arms moved it. Used after all arms to detect QZ1214.
  var match_binding_count = typecheck_util::tc_get_binding_count(tc)
  var any_arm_moved = vec_new()
  var all_arms_moved = vec_new()
  for mi in 0..match_binding_count
    any_arm_moved.push(0)
    all_arms_moved.push(1)
  end

  # Track first arm body location for related span in type mismatch errors
  var first_arm_line = 0
  var first_arm_col = 0

  # Type check each arm
  for i in 0..arm_count
    var arm = arms[i]

    # Restore move/partial/linear states so each arm starts from same baseline
    typecheck_registry::tc_restore_move_states(tc, match_move_snapshot)
    typecheck_registry::tc_restore_partial_moves(tc, match_partial_snapshot)
    typecheck_registry::tc_restore_linear_states(tc, match_linear_snapshot)

    typecheck_util::tc_enter_scope()

    # Get pattern and bind variables
    # Note: node >= 0 because node handle 0 is valid (first AST node)
    var pattern = ast::ast_get_left(ast_storage, arm)
    if pattern >= 0
      var pattern_kind = ast::ast_get_kind(ast_storage, pattern)
      if pattern_kind == node_constants::NODE_ENUM_ACCESS
        # Extract bound names and enum/variant info from pattern
        var bound_names = ast::ast_get_extra(ast_storage, pattern)
        var pat_enum_name = ast::ast_get_str1(ast_storage, pattern)
        var pat_variant_name = ast::ast_get_str2(ast_storage, pattern)
        # For unqualified variants (empty enum name), use the subject-derived
        # enum name so `Ok(data)` resolves against the correct enum (e.g.,
        # ReadResult::Ok(String)) instead of the first-registered one.
        if str_byte_len(pat_enum_name) == 0 and str_byte_len(match_enum_name) > 0
          pat_enum_name = match_enum_name
        end
        # Validate the variant actually exists in the target enum — catches
        # typos like `match x; NotAReal(v) => ... end` that otherwise silently
        # compile to invalid IR (UNKNOWN-VARIANT-MATCH).
        var patv_line = ast::ast_get_line(ast_storage, pattern)
        var patv_col = ast::ast_get_col(ast_storage, pattern)
        if str_byte_len(pat_variant_name) > 0
          var patv_resolved = pat_enum_name
          if str_byte_len(patv_resolved) == 0
            # Truly unqualified (no subject hint): scan for any enum with this variant.
            var patv_all = typecheck_registry::tc_all_enum_names(tc)
            for patv_i in 0..patv_all.size
              var patv_cand = patv_all[patv_i]
              var patv_lookup = typecheck_registry::tc_lookup_enum(tc, patv_cand)
              var patv_idx = match patv_lookup
                Found(v) => v
                NotFound => -1
              end
              if patv_idx >= 0 and typecheck_registry::tc_enum_has_variant(tc, patv_idx, pat_variant_name) == 1
                patv_resolved = patv_cand
                break
              end
            end
          end
          if str_byte_len(patv_resolved) == 0
            error("QZ0210: Unknown variant '#{pat_variant_name}' — no enum in scope has this variant", patv_line, patv_col)
          else
            var patv_enum_lookup = typecheck_registry::tc_lookup_enum(tc, patv_resolved)
            var patv_enum_idx = match patv_enum_lookup
              Found(v) => v
              NotFound => -1
            end
            if patv_enum_idx >= 0 and typecheck_registry::tc_enum_has_variant(tc, patv_enum_idx, pat_variant_name) == 0
              error("QZ0210: '#{pat_variant_name}' is not a variant of enum '#{patv_resolved}'", patv_line, patv_col)
            end
          end
        end
        # Pass subject_type + enum/variant names for generic type resolution
        typecheck_match::tc_bind_pattern_variables(tc, bound_names, subject_type, pat_enum_name, pat_variant_name, line, col)
        # enum-niche tail item 6 — also bind any nested inner-payload names
        # (`Outer(Inner::V(x)) => ... x ...`) so `x` resolves in the arm body.
        typecheck_match::tc_bind_nested_subpatterns(tc, ast_storage, pattern, subject_type, line, col)
      elsif pattern_kind == node_constants::NODE_WILDCARD
        # Wildcard with binding name (e.g. "n if n > 5 =>")
        var bind_name = ast::ast_get_str1(ast_storage, arm)
        if str_byte_len(bind_name) > 0
          typecheck_util::tc_scope_bind(tc, bind_name, subject_type, 0, "")
        end
      elsif pattern_kind == node_constants::NODE_IDENT
        # Bare ident pattern — either a payloadless enum variant (e.g. `None`,
        # `Red`) or a capture binding (e.g. `n => use n`). Convention:
        # PascalCase idents are variant patterns; lowercase idents are
        # captures. This matches how MIR lowering decides
        # (mir_lower_expr_handlers.qz:3103-3123) and lets us reject typos
        # like `AlsoFake` that would otherwise silently capture-bind and
        # emit invalid IR (UNKNOWN-VARIANT-MATCH).
        var ident_name = ast::ast_get_str1(ast_storage, pattern)
        var bi_line = ast::ast_get_line(ast_storage, pattern)
        var bi_col = ast::ast_get_col(ast_storage, pattern)
        var bi_is_variantlike = 0
        if str_byte_len(ident_name) > 0
          var bi_first_char = str_byte_at(ident_name, 0)
          if bi_first_char >= 'A' and bi_first_char <= 'Z'
            bi_is_variantlike = 1
          end
        end
        if bi_is_variantlike == 1
          # PascalCase: must be a variant of some enum. Validate it's a
          # variant of the subject's enum if the subject is a known enum.
          var bi_containing_enum = ""
          var bi_all = typecheck_registry::tc_all_enum_names(tc)
          for bi_i in 0..bi_all.size
            var bi_cand = bi_all[bi_i]
            var bi_lookup = typecheck_registry::tc_lookup_enum(tc, bi_cand)
            var bi_idx = match bi_lookup
              Found(v) => v
              NotFound => -1
            end
            if bi_idx >= 0 and typecheck_registry::tc_enum_has_variant(tc, bi_idx, ident_name) == 1
              bi_containing_enum = bi_cand
              break
            end
          end
          if str_byte_len(bi_containing_enum) == 0
            error("QZ0210: Unknown variant '#{ident_name}' — no enum in scope has this variant", bi_line, bi_col)
          elsif str_byte_len(match_enum_name) > 0
            # Match_enum_name and bi_containing_enum can arrive with or
            # without a `module$` prefix. Treat them as matching if either
            # is a suffix of the other (after the `$`).
            var bi_men = match_enum_name
            var bi_ce = bi_containing_enum
            var bi_same = 0
            if bi_men == bi_ce
              bi_same = 1
            elsif bi_men.ends_with("$#{bi_ce}")
              bi_same = 1
            elsif bi_ce.ends_with("$#{bi_men}")
              bi_same = 1
            end
            if bi_same == 0
              error("QZ0210: '#{ident_name}' is not a variant of enum '#{match_enum_name}' (found in '#{bi_containing_enum}')", bi_line, bi_col)
            end
          end
          # No capture binding for payloadless variants.
        else
          # Lowercase ident — capture binding.
          typecheck_util::tc_scope_bind(tc, ident_name, subject_type, 0, "")
        end
      elsif pattern_kind == node_constants::NODE_STRUCT_DESTRUCTURE
        # Struct pattern in match arm: { x, y } or Type { x, y }
        var sd_type_name = ast::ast_get_str1(ast_storage, pattern)
        var sd_field_specs = ast::ast_get_str2(ast_storage, pattern)
        var sd_has_rest = ast::ast_get_op(ast_storage, pattern)
        # Resolve struct type from explicit name or subject type
        var sd_resolved = sd_type_name
        if str_byte_len(sd_resolved) == 0
          # Infer from match subject
          if ast::ast_get_kind(ast_storage, subject_node) == node_constants::NODE_IDENT
            sd_resolved = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, subject_node))
          end
        end
        if str_byte_len(sd_resolved) > 0
          var sd_lookup = typecheck_registry::tc_lookup_struct(tc, sd_resolved)
          if sd_lookup.is_found()
            var sd_si = sd_lookup.unwrap()
            var sd_fnames = tc.registry.struct_field_names[sd_si]
            var sd_ftypes = tc.registry.struct_field_types[sd_si]
            var sd_fcount = sd_fnames.size
            var sd_specs = str_split(sd_field_specs, ",")
            for sd_fi in 0..sd_specs.size
              var sd_spec = sd_specs[sd_fi]
              var sd_fname = sd_spec
              var sd_bname = sd_spec
              var sd_cp = __char_index(sd_spec, ':')
              if sd_cp >= 0
                sd_fname = str_byte_slice(sd_spec, 0, sd_cp)
                sd_bname = str_byte_slice(sd_spec, sd_cp + 1, str_byte_len(sd_spec))
              end
              var sd_fidx = -1
              for sd_ri in 0..sd_fcount
                if sd_fnames[sd_ri] == sd_fname
                  sd_fidx = sd_ri
                end
              end
              if sd_fidx >= 0
                var sd_ftype = sd_ftypes[sd_fidx]
                var sd_fann = typecheck::tc_struct_field_annotation(tc, sd_si, sd_fname)
                typecheck_util::tc_scope_bind(tc, sd_bname, sd_ftype, 0, sd_fann)
              else
                typecheck_util::tc_scope_bind(tc, sd_bname, type_constants::TYPE_INT, 0, "")
              end
            end
          end
        end
      elsif pattern_kind == node_constants::NODE_VEC_DESTRUCTURE
        # Vec pattern in match arm: [a, b, ..rest]
        var vd_elems_str = ast::ast_get_str1(ast_storage, pattern)
        var vd_rest = ast::ast_get_str2(ast_storage, pattern)
        var vd_has_rest = ast::ast_get_op(ast_storage, pattern)
        var vd_elems = str_split(vd_elems_str, ",")
        for vd_ei in 0..vd_elems.size
          var vd_ename = vd_elems[vd_ei]
          if str_byte_len(vd_ename) > 0
            typecheck_util::tc_scope_bind(tc, vd_ename, type_constants::TYPE_INT, 0, "")
          end
        end
        if vd_has_rest == 1 and str_byte_len(vd_rest) > 0
          typecheck_util::tc_scope_bind(tc, vd_rest, type_constants::TYPE_INT, 0, "")
        end
      elsif pattern_kind == node_constants::NODE_OR_PATTERN
        # Or-pattern: pat1 | pat2 | pat3 — bind from first sub-pattern with bindings
        var or_pats = ast::ast_get_children(ast_storage, pattern)
        if or_pats != 0
          var or_cnt = vec_size(or_pats)
          for opi in 0..or_cnt
            var sub_pat = or_pats[opi]
            var sub_kind = ast::ast_get_kind(ast_storage, sub_pat)
            if sub_kind == node_constants::NODE_STRUCT_DESTRUCTURE or sub_kind == node_constants::NODE_VEC_DESTRUCTURE
              error("Or-patterns do not support struct/vec destructuring", line, col)
            end
            # Bind from first enum access sub-pattern
            if sub_kind == node_constants::NODE_ENUM_ACCESS and opi == 0
              var op_bound = ast::ast_get_extra(ast_storage, sub_pat)
              var op_enum = ast::ast_get_str1(ast_storage, sub_pat)
              var op_variant = ast::ast_get_str2(ast_storage, sub_pat)
              if op_bound > 0
                typecheck_match::tc_bind_pattern_variables(tc, op_bound, subject_type, op_enum, op_variant, line, col)
              end
            end
            # Bare ident sub-pattern in first position — bind to subject type
            if sub_kind == node_constants::NODE_IDENT and opi == 0
              var op_name = ast::ast_get_str1(ast_storage, sub_pat)
              # Don't bind enum variant names, only capture variables
              var op_enum_check = ""
              if op_name != "_"
                op_enum_check = typecheck_util::tc_scope_lookup_struct_name(tc, op_name)
              end
              if str_byte_len(op_enum_check) == 0 and op_name != "_"
                typecheck_util::tc_scope_bind(tc, op_name, subject_type, 0, "")
              end
            end
          end
        end
      end
    end

    # Typecheck guard expression if present
    var guard_node = ast::ast_get_extra(ast_storage, arm)
    if guard_node > 0
      typecheck_walk::tc_expr(tc, ast_storage, guard_node)
    end

    # Type check arm body
    var body = ast::ast_get_right(ast_storage, arm)
    if body >= 0
      # Unwrap EXPR_STMT wrapper if present (match arm bodies may be wrapped)
      if ast::ast_get_kind(ast_storage, body) == node_constants::NODE_EXPR_STMT
        var inner = ast::ast_get_left(ast_storage, body)
        if inner >= 0
          body = inner
        end
      end
      var body_type = typecheck_walk::tc_expr(tc, ast_storage, body)
      if i == 0
        result = body_type
        first_arm_line = ast::ast_get_line(ast_storage, body)
        first_arm_col = ast::ast_get_col(ast_storage, body)
      else
        # Check that all arms have consistent types
        if result != type_constants::TYPE_ERROR
          if body_type != type_constants::TYPE_ERROR
            # Never type (!) is the bottom type — compatible with anything
            if body_type == type_constants::TYPE_NEVER
              # Diverging arm: keep existing result type
            elsif result == type_constants::TYPE_NEVER
              # Previous arms diverged, adopt this arm's type
              result = body_type
            elsif typecheck::tc_types_match_strict(tc, result, body_type) == false
              # Get body location for error message
              var body_line = ast::ast_get_line(ast_storage, body)
              var body_col = ast::ast_get_col(ast_storage, body)
              # Build enhanced error message with first arm line reference
              var expected_name = typecheck::tc_type_name_full(tc, result)
              var got_name = typecheck::tc_type_name_full(tc, body_type)
              var mismatch_msg = "Match arm type mismatch: expected '#{expected_name}', found '#{got_name}'"
              if first_arm_line > 0
                mismatch_msg += " (first arm at line #{first_arm_line})"
              end
              error(mismatch_msg, body_line, body_col)
              result = type_constants::TYPE_ERROR
            end
          end
        end
      end
    end

    typecheck::tc_exit_scope(tc)

    # After arm: update N-way merge tracking for move states.
    # Only check bindings that existed before the match (arm-local bindings
    # were created by tc_enter_scope and removed by tc_exit_scope).
    for bi in 0..match_binding_count
      if tc.safety.move_states[bi] == 2 and match_move_snapshot[bi] != 2
        # This arm moved the binding (wasn't already moved before match)
        any_arm_moved[bi] = 1
      else
        if match_move_snapshot[bi] == 1
          # Binding was Live and this arm did NOT move it
          all_arms_moved[bi] = 0
        end
      end
    end
  end

  # Final N-way merge of move states across all match arms.
  for bi in 0..match_binding_count
    if match_move_snapshot[bi] == 0
      # Not tracked — keep as-is
    elsif match_move_snapshot[bi] == 2
      # Already moved before match — stays moved
      tc.safety.move_states[bi] = 2
    elsif any_arm_moved[bi] == 1 and all_arms_moved[bi] == 0
      # Inconsistent: moved in some arms but not all — QZ1214
      var bname = tc.scope.binding_names[bi]
      error("QZ1214: Value '#{bname}' is moved in some match arms but not others", line, col)
      tc.safety.move_states[bi] = 2
    elsif all_arms_moved[bi] == 1 and any_arm_moved[bi] == 1
      # Consistently moved in ALL arms
      tc.safety.move_states[bi] = 2
    else
      # No arm moved it — restore to pre-match state
      tc.safety.move_states[bi] = match_move_snapshot[bi]
    end
  end

  # Exhaustiveness checking (after all arms processed)
  typecheck_match::tc_check_exhaustiveness(tc, ast_storage, node, subject_type, line, col)
  result
  end  # close body-wrap
end

## Type-check a NODE_FIELD_ACCESS expression (field access, predicates, .size).
## Extracted from tc_expr to reduce function size.
def tc_expr_field_access(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
  var object_node = ast::ast_get_left(ast_storage, node)
  var field_name = ast::ast_get_str1(ast_storage, node)

  tc.safety.field_access_depth += 1
  var object_type_full = typecheck_walk::tc_expr(tc, ast_storage, object_node)
  var object_type = typecheck::tc_base_kind(tc, object_type_full)
  tc.safety.field_access_depth -= 1

  # Annotation fallback: when object_type is TYPE_INT, recover actual container type
  # from the binding's type annotation. Fixes .size/.push() on globals, indexed exprs, etc.
  if object_type == type_constants::TYPE_INT
    var fb_ann = ""
    if ast::ast_get_kind(ast_storage, object_node) == node_constants::NODE_IDENT
      fb_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, object_node))
    end
    if str_byte_len(fb_ann) == 0
      fb_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, object_node)
    end
    if str_byte_len(fb_ann) > 0
      object_type = typecheck_generics::tc_annotation_to_container_type(fb_ann)
    end
  end

  # Partial move check: error if this field was already moved
  if ast::ast_get_kind(ast_storage, object_node) == node_constants::NODE_IDENT
    var pm_obj_name = ast::ast_get_str1(ast_storage, object_node)
    typecheck_registry::tc_check_field_not_moved(tc, pm_obj_name, field_name, line, col)
  end

  # Tuple positional access: t.0, t.1, ...
  var fn_first = str_byte_at(field_name, 0)
  if fn_first >= 48 and fn_first <= 57
    # If object is a tuple ptype, return the correct element type. Use the
    # uncollapsed `object_type_full` for the lookup — `object_type` is the
    # base-kind collapse (TYPE_TUPLE), which would lose the per-element
    # type info stored on the ptype slot.
    if object_type_full >= type_constants::PTYPE_BASE
      var obj_base = typecheck::tc_base_kind(tc, object_type_full)
      if obj_base == type_constants::TYPE_TUPLE
        var tuple_index = field_name.to_i()
        result = typecheck_util::tc_tuple_elem_type(tc, object_type_full, tuple_index)
      else
        result = type_constants::TYPE_INT
      end
    else
      result = type_constants::TYPE_INT
    end
  # Handle .size/.length for builtin types - rewrite to function call
  elsif field_name == "size"
    var func_name = ""

    if object_type == type_constants::TYPE_STRING
      func_name = "str_size"
    elsif object_type == type_constants::TYPE_VEC or object_type == type_constants::TYPE_ARRAY
      func_name = "vec_size"
    elsif object_type == type_constants::TYPE_MAP
      func_name = "map_size"
    elsif object_type == type_constants::TYPE_SET
      func_name = "set_size"
    elsif object_type == type_constants::TYPE_SLICE or object_type == type_constants::TYPE_SLICE_MUT
      func_name = "slice_size"
    end

    if str_byte_len(func_name) > 0
      # Rewrite field access to function call: node.size -> func_name(node)
      # 1. Create args vector with the object
      var args = [object_node]

      # 2. Create identifier node for the function
      var callee = ast::ast_ident(ast_storage, func_name, line, col)

      # 3. Rewrite the node in-place
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)

      result = type_constants::TYPE_INT
    else
      # Not a builtin type with .size - fall through to struct field access
      var struct_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, object_node)
      var field_type_args = ""
      # Infer full type annotation to extract generic type args
      var full_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, object_node)
      if str_byte_len(full_ann) > 0
        var lt_pos = __char_index(full_ann, '<')
        if lt_pos >= 0
          field_type_args = str_byte_slice(full_ann, lt_pos + 1, str_byte_len(full_ann) - 1)
        end
      end

      if str_byte_len(struct_name) == 0
        if object_type == type_constants::TYPE_INT or object_type == type_constants::TYPE_VOID
          # Int-typed value with .size — most likely an untyped Vec handle.
          # Rewrite to vec_size() to avoid silent wrong-offset field access.
          var vs_args = [object_node]
          var vs_callee = ast::ast_ident(ast_storage, "vec_size", line, col)
          ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
          ast::ast_set_left(ast_storage, node, vs_callee)
          ast::ast_set_children(ast_storage, node, vs_args)
        end
        result = type_constants::TYPE_INT
      else
        result = with Diag {
          error: typecheck_diag::tc_diag_error_handler
        } do ->
          typecheck_generics::tc_check_field_access(tc, struct_name, field_name, line, col, field_type_args)
        end
      end
    end
  # v5.12.27: Handle predicates with ? suffix (empty?, some?, none?, ok?, err?, etc.)
  elsif field_name == "empty?"
    var size_func = ""

    if object_type == type_constants::TYPE_STRING
      size_func = "str_size"
    elsif object_type == type_constants::TYPE_VEC or object_type == type_constants::TYPE_ARRAY
      size_func = "vec_size"
    elsif object_type == type_constants::TYPE_MAP
      size_func = "map_size"
    elsif object_type == type_constants::TYPE_SET
      size_func = "set_size"
    elsif object_type == type_constants::TYPE_SLICE or object_type == type_constants::TYPE_SLICE_MUT
      size_func = "slice_size"
    end

    if str_byte_len(size_func) > 0
      # Rewrite v.empty? to (size_func(v) == 0)
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, size_func, line, col)
      var call_node = ast::ast_call(ast_storage, callee, args, line, col)
      var zero_node = ast::ast_int_lit(ast_storage, 0, line, col)

      ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
      ast::ast_set_left(ast_storage, node, call_node)
      ast::ast_set_right(ast_storage, node, zero_node)
      ast::ast_set_op(ast_storage, node, 7)

      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Type has no property 'empty?'", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "some?"
    if object_type == type_constants::TYPE_OPTION
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "option_is_some", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Option types have 'some?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "none?"
    if object_type == type_constants::TYPE_OPTION
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "option_is_some", line, col)
      var call_node = ast::ast_call(ast_storage, callee, args, line, col)
      var zero_node = ast::ast_int_lit(ast_storage, 0, line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
      ast::ast_set_left(ast_storage, node, call_node)
      ast::ast_set_right(ast_storage, node, zero_node)
      ast::ast_set_op(ast_storage, node, 7)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Option types have 'none?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "ok?"
    if object_type == type_constants::TYPE_RESULT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_ok", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Result types have 'ok?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "err?"
    if object_type == type_constants::TYPE_RESULT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_err", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Result types have 'err?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "digit?"
    if object_type == type_constants::TYPE_INT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_digit", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Int types have 'digit?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "alpha?"
    if object_type == type_constants::TYPE_INT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_alpha", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Int types have 'alpha?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "alnum?"
    if object_type == type_constants::TYPE_INT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_alnum", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Int types have 'alnum?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "whitespace?"
    if object_type == type_constants::TYPE_INT
      var args = [object_node]
      var callee = ast::ast_ident(ast_storage, "is_whitespace", line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, callee)
      ast::ast_set_children(ast_storage, node, args)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    else
      error("Only Int types have 'whitespace?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  elsif field_name == "nil?"
    if object_type == type_constants::TYPE_PTR
      var nil_node = ast::ast_nil_lit(ast_storage, line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_BINARY)
      ast::ast_set_left(ast_storage, node, object_node)
      ast::ast_set_right(ast_storage, node, nil_node)
      ast::ast_set_str1(ast_storage, node, "==")
      result = type_constants::TYPE_BOOL
    else
      error("Only pointer types have 'nil?' predicate", line, col)
      result = type_constants::TYPE_ERROR
    end

  else
    # Regular field access (not .size/.length and not a predicate)
    var struct_name = ""
    var field_type_args = ""
    # Use recursive resolver to handle chained field access (a.b.c)
    struct_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, object_node)
    # Infer full type annotation to extract generic type args
    var full_ann2 = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, object_node)
    if str_byte_len(full_ann2) > 0
      var lt_pos = __char_index(full_ann2, '<')
      if lt_pos >= 0
        field_type_args = str_byte_slice(full_ann2, lt_pos + 1, str_byte_len(full_ann2) - 1)
      end
    end

    # B.6: dot-method paren elision.
    # `obj.method` (no parens) rewrites to `method(obj)` when `method` is a
    # zero-arg method on obj's type or a free function whose first arg matches
    # obj's type (open UFCS). Field-vs-method precedence: when both exist with
    # the same name, the field wins (this branch is reached only for missing
    # fields). If no callable target exists, fall through to the existing
    # field-access path so the user gets the helpful "no field 'X'" error.
    var b6_can_elide = 0
    if str_byte_len(struct_name) > 0
      if str_byte_at(struct_name, 0) != '{'
        # Struct receiver: peek field existence first (field-wins precedence)
        var b6_struct_result = typecheck_registry::tc_lookup_struct(tc, struct_name)
        if b6_struct_result.is_found()
          var b6_struct_idx = b6_struct_result.unwrap()
          var b6_field_type = typecheck_registry::tc_struct_field_type(tc, b6_struct_idx, field_name)
          if b6_field_type == type_constants::TYPE_ERROR
            # No field — try impl method via Type$method mangle
            var b6_mangled = tc_mangle(tc, struct_name, field_name)
            var b6_mangled_type = typecheck_util::tc_scope_lookup(tc, b6_mangled)
            if b6_mangled_type == type_constants::TYPE_ERROR
              b6_mangled_type = typecheck_registry::tc_lookup_function_return(tc, b6_mangled)
            end
            if b6_mangled_type != type_constants::TYPE_ERROR
              b6_can_elide = 1
            else
              # Fall back to open UFCS (free function whose first arg matches)
              var b6_open_type = typecheck_registry::tc_lookup_function_return(tc, field_name)
              if b6_open_type != type_constants::TYPE_ERROR
                b6_can_elide = 1
              end
            end
          end
        end
      end
    else
      # Non-struct receiver (TYPE_INT, TYPE_VEC handle, etc.): try open UFCS
      var b6_open_type = typecheck_registry::tc_lookup_function_return(tc, field_name)
      if b6_open_type != type_constants::TYPE_ERROR
        b6_can_elide = 1
      end
      # Builtin-container UFCS method (m.keys, s.members, sb.to_string, n.to_s, …):
      # recognized via the shared canonical table so paren-less `recv.method`
      # elides to `recv.method()` and types through tc_expr_call's dispatch —
      # B.6 spec parity (`obj.m` ≡ `obj.m()`). Without this these fell through to
      # the lenient QZ0603 offset-0 fallback and mistyped as TYPE_INT (miscompile).
      if b6_can_elide == 0
        if str_byte_len(tc_container_ufcs_canonical(object_type, field_name)) > 0
          b6_can_elide = 1
        end
      end
    end

    if b6_can_elide == 1
      # Rewrite NODE_FIELD_ACCESS → NODE_CALL([obj]) is_ufcs=1 and re-typecheck.
      # tc_expr_call handles all downstream dispatch (impl method mangling,
      # builtin UFCS rewrites, direct-call resolution).
      var b6_args = [object_node]
      var b6_callee = ast::ast_ident(ast_storage, field_name, line, col)
      ast::ast_set_kind(ast_storage, node, node_constants::NODE_CALL)
      ast::ast_set_left(ast_storage, node, b6_callee)
      ast::ast_set_children(ast_storage, node, b6_args)
      ast::ast_call_set_is_ufcs(ast_storage, node, 1)
      result = typecheck_walk::tc_expr(tc, ast_storage, node)
    elsif str_byte_len(struct_name) == 0
      # Non-struct types: don't report as struct field access error.
      # These are likely method calls on builtin types (Vec, StringBuilder, etc.)
      # that aren't handled by UFCS above. Accept them silently.
      result = type_constants::TYPE_INT
    elsif str_byte_at(struct_name, 0) == '{'
      # Record type annotation (e.g., "{ x: Int }") — resolve per-field type
      result = typecheck_registry::tc_record_field_type(tc, struct_name, field_name, line, col)
    else
      result = with Diag {
        error: typecheck_diag::tc_diag_error_handler
      } do ->
        typecheck_generics::tc_check_field_access(tc, struct_name, field_name, line, col, field_type_args)
      end
    end
  end
  # GAP-B2-nonident-narrow — flow-narrowed field-access read. If a refinement for
  # this field's access path (`s.u`) is active at the current depth (pushed by the
  # if-handler for `if s.u is Member`), the THEN-branch read sees the inner member
  # type, and we stamp the read node's int_val to 1 so MIR wraps the field load in
  # mir_emit_narrowed_read (payload@1 of the tagged union cell). Mirrors the IDENT
  # narrowed-read consult (typecheck_walk.qz NODE_IDENT). Only fires for a stable
  # access-path key ⇒ additive; gate-0-inert (no compiler source narrows a field).
  var fa_np_key = typecheck_util::tc_access_path_key(ast_storage, node)
  if str_byte_len(fa_np_key) > 0
    var fa_narrowed = typecheck_util::tc_narrow_lookup(tc, fa_np_key)
    if fa_narrowed != type_constants::TYPE_ERROR
      result = fa_narrowed
      if ast::ast_get_int_val(ast_storage, node) != 2
        ast::ast_set_int_val(ast_storage, node, 1)
      end
    end
  end
  result
  end  # close body-wrap
end

## R1.6: should a chained `.unwrap()` recover its bare-`T` return from the
## receiver's `Option<T>` / `Result<T,E>` payload type? True iff the payload is a
## CONCRETE, meaningful type whose recovery is sound: a struct/enum nominal, a
## parameterized ptype (nested generic / nominal-carrying), or a fully-signatured
## Fn (the original 5a callability case). Excludes bare type-variables (still
## open), TYPE_ERROR, and bare scalars — for those the receiver carried no usable
## payload type, so leaving `result` at its prior value is the safe choice (a
## genuine `Option<Int>` chained-unwrap already resolves to Int via the builtin
## registry; recovering a spurious `0`-payload would risk regressing it).
def tc_chained_unwrap_payload_recoverable(tc: TypecheckState, payload: Int): Bool
  return false if payload == type_constants::TYPE_ERROR
  return false if typecheck_util::tc_tv_is_var(payload) == 1
  # Per-struct nominal id (STRUCT_TYPE_BASE..PTYPE_BASE): the R1.6 case.
  return true if typecheck::tc_struct_idx_from_type(payload) >= 0
  return true if typecheck::tc_fn_type_id(tc, payload) >= 0
  return false
end

## R1.6: resolve the human-readable struct/enum name of a recovered chained-
## unwrap payload, so the call node can be stamped (str2) for let-binding
## struct-name propagation — the same channel vec_get uses (set_str2 → the
## NODE_LET NODE_CALL `call_str2` fallback). Returns "" when the payload is not
## a nominal struct/enum (scalars/Fn don't need name propagation). Prefers the
## ptype's carried name, falling back to the type-kind name for a bare struct id.
def tc_chained_unwrap_payload_struct_name(tc: TypecheckState, payload: Int): String
  # Per-struct nominal id (STRUCT_TYPE_BASE..PTYPE_BASE): resolve via the registry.
  var _sidx = typecheck::tc_struct_idx_from_type(payload)
  if _sidx >= 0 and _sidx < tc.registry.struct_names.size
    var _sn = tc.registry.struct_names[_sidx]
    return _sn if str_byte_len(_sn) > 0
  end
  # Struct ptype (generic struct instance): the outer name is on the ptype.
  if typecheck::tc_is_ptype(payload)
    var pn = typecheck::tc_ptype_name(tc, payload)
    if str_byte_len(pn) > 0
      return pn if typecheck_registry::tc_lookup_struct(tc, pn).is_found()
    end
  end
  return ""
end

## A.43 Phase 3 (let-polymorphism): resolve the return type of a call to an
## UNANNOTATED, fn-typed local binding (a let/var-bound lambda such as
## `id = x -> x`) by unifying the call's argument types against the lambda's
## structured parameter type vars. A generalized (const) binding is instantiated
## first so each call site gets fresh vars — true let-polymorphism: `id(42)` and
## `id("hello")` don't conflict. A `var` binding carries no scheme (value
## restriction → monomorphic), so the first call fixes its param vars.
##
## Without this the call walked its args but never propagated their types into
## the lambda's param vars, so an unconstrained return var (`x -> x`) stayed free
## and any `a = id(42)` landed as QZ0204 "ambiguous type". Returns TYPE_INT when
## the binding has no structured fn type (bare TYPE_FUNCTION) — the prior fallback.
def tc_call_local_fn_return(tc: TypecheckState, sb_type: Int, scheme: Vec<Int>, arg_types: Vec<Int>): Int
  var fn_t = sb_type
  if scheme.size > 0
    fn_t = typecheck_util::tc_instantiate(tc, sb_type, scheme)
  end
  var fn_id = typecheck::tc_fn_type_id(tc, fn_t)
  if fn_id < 0
    return type_constants::TYPE_INT
  end
  var pcount = typecheck_registry::tc_fn_type_param_count(tc, fn_id)
  var n = arg_types.size
  if n > pcount
    n = pcount
  end
  for i in 0..n
    var ptv = typecheck_util::tc_tv_resolve(tc, typecheck_registry::tc_fn_type_param_type_at(tc, fn_id, i))
    # Only bind an unconstrained param var to a concrete arg type. A param that
    # is already concrete (constrained lambda, e.g. `x -> x + 1`) keeps its type;
    # an arg that is itself an unresolved var leaves the param open.
    if typecheck_util::tc_tv_is_var(ptv) == 1
      var at = typecheck_util::tc_tv_resolve(tc, arg_types[i])
      if typecheck_util::tc_tv_is_var(at) == 0 and at != type_constants::TYPE_ERROR
        if typecheck_util::tc_tv_occurs_in(tc, ptv, at) == 0
          typecheck_util::tc_tv_bind(tc, ptv, at)
        end
      end
    end
  end
  return typecheck_util::tc_tv_resolve(tc, typecheck_registry::tc_fn_type_return_type(tc, fn_id))
end

## Canonical-intrinsic mapping for builtin-receiver UFCS methods.
## Single source of truth for `recv.method(...)` → intrinsic rewrites, shared by
## tc_expr_call's container dispatch (the paren-ful path) AND tc_expr_field_access's
## B.6 paren-elision gate (the paren-less path). Keyed on the receiver's BASE kind
## so `m.keys` and `m.keys()` resolve identically (B.6 spec: `obj.m` ≡ `obj.m()`).
## Returns "" when `method` is not a recognized builtin method for `base_type` —
## the caller then leaves func_name unchanged (no rewrite) / declines to elide.
def tc_container_ufcs_canonical(base_type: Int, method: String): String
  if base_type == type_constants::TYPE_STRING
    return match method
      "cmp" => "str_cmp"
      "find" => "str_find"
      "char_at" => "str_codepoint_nth"
      "eq" => "str_eq"
      "concat" => "str_concat"
      "slice" => "str_slice"
      "split" => "str_split"
      "starts_with" => "str_starts_with"
      "ends_with" => "str_ends_with"
      "contains" => "str_contains"
      "downcase" => "str_downcase"
      "upcase" => "str_upcase"
      "trim" => "str_trim"
      "replace" => "str_replace"
      "to_i" => "str_to_int"
      "to_f" => "str_to_f64"
      "hash" => "str_hash"
      "reverse" => "str_reverse"
      "repeat" => "str_repeat"
      "count" => "str_count"
      "size" => "str_size"
      "join" => "str_join"
      "is_empty" => "str_is_empty"
      "substr" => "str_substr"
      "trim_left" => "str_trim_left"
      "trim_right" => "str_trim_right"
      "pad_left" => "str_pad_left"
      "pad_right" => "str_pad_right"
      "chars" => "str_chars"
      "byte_at" => "str_byte_at"
      "byte_slice" => "str_byte_slice"
      "byte_len" => "str_byte_size"
      "byte_size" => "str_byte_size"
      "byte_find" => "str_byte_find"
      "bytes" => "str_bytes"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_VEC
    return match method
      "push" => "vec_push"
      "pop" => "vec_pop"
      "clear" => "vec_clear"
      "free" => "vec_free"
      "get" => "vec_get"
      "set" => "vec_set"
      "slice" => "slice"
      "get_unchecked" => "vec_get_unchecked"
      "set_unchecked" => "vec_set_unchecked"
      "contains" => "vec_contains"
      "index_of" => "vec_index_of"
      "insert" => "vec_insert"
      "delete" => "vec_delete"
      "join" => "vec_join"
      "reverse" => "vec_reverse"
      "sort" => "vec_sort"
      "sort_by" => "vec_sort_by"
      "size" => "vec_size"
      "shrink_to_fit" => "vec_shrink_to_fit"
      "capacity" => "vec_capacity"
      "truncate" => "vec_truncate"
      "dedup" => "vec_dedup"
      "retain" => "vec_retain"
      "extend" => "vec_extend"
      "clone" => "vec_clone"
      "map" => "map"
      "filter" => "filter"
      "reduce" => "reduce"
      "each" => "each"
      "find" => "find"
      "count" => "count"
      "any?" => "any?"
      "all?" => "all?"
      "sorted" => "sorted"
      "reversed" => "reversed"
      "first" => "first"
      "last" => "last"
      "take" => "take"
      "drop" => "drop"
      "sum" => "sum"
      "product" => "product"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_SLICE or base_type == type_constants::TYPE_SLICE_MUT
    return match method
      "size" => "slice_size"
      "len" => "slice_size"
      "get" => "slice_get"
      "set" => "slice_set"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_MAP
    return match method
      "has" => "map_has"
      "delete" => "map_delete"
      "keys" => "map_keys"
      "values" => "map_values"
      "clear" => "map_clear"
      "get" => "map_get"
      "set" => "map_set"
      "insert" => "map_insert"
      "free" => "map_free"
      "size" => "map_size"
      "contains" => "map_has"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_STRINGBUILDER
    return match method
      "size" => "sb_size"
      "append" => "sb_append"
      "append_int" => "sb_append_int"
      "append_char" => "sb_append_char"
      "clear" => "sb_clear"
      "free" => "sb_free"
      "to_string" => "sb_to_string"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_SET
    return match method
      "add" => "set_add"
      "delete" => "set_delete"
      "has" => "set_has"
      "clear" => "set_clear"
      "members" => "set_members"
      "size" => "set_size"
      "free" => "set_free"
      "union" => "set_union"
      "intersection" => "set_intersection"
      "difference" => "set_difference"
      "is_subset" => "set_is_subset"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_RANGE
    return match method
      "size" => "range_size"
      "contains" => "range_contains"
      "start" => "range_start"
      "end" => "range_end"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_INT
    return match method
      "to_s" => "str_from_int"
      "to_f64" => "to_f64"
      "to_f32" => "to_f32"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_F64
    return match method
      "to_i" => "to_int"
      "to_s" => "f64_to_str"
      "sqrt" => "f64_sqrt"
      "sin" => "f64_sin"
      "cos" => "f64_cos"
      "floor" => "f64_floor"
      "ceil" => "f64_ceil"
      "round" => "f64_round"
      "abs" => "f64_abs"
      "log" => "f64_log"
      "exp" => "f64_exp"
      "pow" => "f64_pow"
      "min" => "f64_min"
      "max" => "f64_max"
      "atan2" => "f64_atan2"
      "tan" => "f64_tan"
      "asin" => "f64_asin"
      "acos" => "f64_acos"
      "atan" => "f64_atan"
      "log2" => "f64_log2"
      "log10" => "f64_log10"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_TASK_GROUP
    return match method
      "spawn" => "taskgroup_spawn"
      "collect" => "taskgroup_collect"
      "cancel" => "taskgroup_cancel"
      _ => ""
    end
  end
  if base_type == type_constants::TYPE_CHANNEL
    return match method
      "close" => "channel_close"
      "closed" => "channel_closed"
      "size" => "channel_size"
      "send" => "send"
      "recv" => "recv"
      "recv_timeout" => "recv_timeout"
      "try_send" => "try_send"
      "try_recv" => "try_recv"
      _ => ""
    end
  end
  return ""
end

## SURF.FLOW S1 — does the user-defined method `method_name` on receiver type
## `struct_name` declare a `&mut self` receiver? A `&mut self` method can flip the
## receiver's Option/union cell to a different variant in place, so a narrowing
## proof established BEFORE such a call is no longer guaranteed live afterwards
## (audit §3, the one real invalidation hole). We resolve the method's registered
## definition and read param 0's receiver-borrow marker
## (`ast_param_receiver_borrow == 2` ⇒ `&mut self`; 0=bare `self`, 1=`&self`).
##
## PRECISION: returns true ONLY for `&mut self`. A value-`self` or `&self` (shared)
## method cannot mutate the receiver's cell, so narrowing must SURVIVE it — over-
## invalidating there would needlessly drop the compiler's heavy `x.is_some()` /
## `x.unwrap()`-in-narrowed-block usage and OVER-REJECT. Returns false whenever the
## method / its def node / param 0 cannot be positively resolved (additive: falls
## back to today's no-invalidation behavior on an unresolvable receiver).
def tc_method_receiver_is_mut_self(tc: TypecheckState, ast_storage: ast::AstStorage, struct_name: String, method_name: String): Bool
  return false if str_byte_len(struct_name) == 0
  return false if str_byte_len(method_name) == 0
  # Bare receiver type name (strip any `<...>` generic args) for the mangle.
  var lookup_name = struct_name
  var lt = __char_index(lookup_name, '<')
  if lt > 0
    lookup_name = str_byte_slice(lookup_name, 0, lt)
  end
  # Impl/extend methods register as a func-alias `Type$method` → canonical
  # `module$Type$method`. Resolve the canonical registered symbol; fall back to
  # the bare `Type$method` mangle if no alias was recorded.
  var mangled = tc_mangle(tc, lookup_name, method_name)
  var canonical = compiler_types::ct_func_alias_lookup(mangled)
  if str_byte_len(canonical) == 0
    canonical = mangled
  end
  var fidx = typecheck_registry::tc_lookup_function_index(tc, canonical)
  if fidx < 0
    return false
  end
  var ast_info = typecheck_registry::tc_function_ast_info(tc, fidx)
  var info_vec = match ast_info
    Some(v) => v
    None => vec_new()
  end
  return false if info_vec.size < 2
  var def_store: ast::AstStorage = as_type<ast::AstStorage>(info_vec[0])
  var def_node = info_vec[1]
  return false if as_int(def_store) == 0
  return false if def_node < 0
  var def_params = ast::ast_get_left(def_store, def_node)
  return false if vec_size(def_params) == 0
  var p0 = def_params[0]
  # Must be an EXPLICIT `self` receiver carrying the `&mut self` marker (2).
  return false if ast::ast_get_str1(def_store, p0).eq("self") == 0
  return ast::ast_param_receiver_borrow(def_store, p0) == 2
end

## Type-check a NODE_CALL expression (function/method call).
## Extracted from tc_expr to reduce function size.
def tc_expr_call(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, line: Int, col: Int): Int
  var result = type_constants::TYPE_VOID
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
  # Get callee (the node being called) - IDENT nodes store name in str1
  var callee_node = ast::ast_get_left(ast_storage, node)

  # Handle indirect call through Fn-typed field access (e.g., obj.callback(args)).
  # This case arises when a prior tc_expr pass rewrote the callee from IDENT to
  # FIELD_ACCESS. Type-check args and return the Fn field's return type directly.
  if ast::ast_get_kind(ast_storage, callee_node) == node_constants::NODE_FIELD_ACCESS
    var fa_obj = ast::ast_get_left(ast_storage, callee_node)
    var fa_field = ast::ast_get_str1(ast_storage, callee_node)
    var fa_obj_type = typecheck_walk::tc_expr(tc, ast_storage, fa_obj)
    var fa_args = ast::ast_get_children(ast_storage, node)
    each(fa_args, fa_a: Int -> typecheck_walk::tc_expr(tc, ast_storage, fa_a))
    # Look up the field's Fn annotation to get the return type
    if typecheck::tc_is_struct_type(fa_obj_type)
      var fa_obj_kind = ast::ast_get_kind(ast_storage, fa_obj)
      if fa_obj_kind == node_constants::NODE_IDENT
        var fa_sname = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, fa_obj))
        if str_byte_len(fa_sname) > 0
          var fa_sr = typecheck_registry::tc_lookup_struct(tc, fa_sname)
          var fa_si = match fa_sr
            Found(v) => v
            NotFound => -1
          end
          if fa_si >= 0
            var fa_ann = typecheck::tc_struct_field_annotation(tc, fa_si, fa_field)
            # HB-DOG.3(c): resolve aliases so a field typed by
            # `type X = Fn(...)` is recognized as a Fn shape.
            if typecheck::_tc_is_fn_ann(tc, fa_ann)
              return typecheck::tc_fn_annotation_return_type(tc, fa_ann)
            end
          end
        end
      end
    end
    return type_constants::TYPE_INT
  end

  # Handle direct lambda call: (-> body)() or (x -> expr)(val)
  # The callee is NODE_LAMBDA — typecheck it and its args, return void.
  if ast::ast_get_kind(ast_storage, callee_node) == node_constants::NODE_LAMBDA
    typecheck_walk::tc_expr(tc, ast_storage, callee_node)
    var lc_args = ast::ast_get_children(ast_storage, node)
    for lci in 0..lc_args.size
      typecheck_walk::tc_expr(tc, ast_storage, lc_args[lci])
    end
    return type_constants::TYPE_INT
  end

  # Handle call-of-call: callee is itself a NODE_CALL whose result is callable
  # (e.g. `make_adder(100)(5)`, `f.unwrap()(5)`). Type the inner call; if its
  # result carries a full Fn signature (tc_fn_type_id >= 0), this is a genuine
  # indirect call — type the args and return the Fn's return type. The
  # tc_fn_type_id gate mirrors the option_some payload-refinement guard
  # (~3978/4300): only a fully-signatured Fn result is treated as callable, so a
  # non-callable call result (e.g. `option_some(42).unwrap()(5)` — Int) falls
  # through to the existing error path rather than over-firing.
  if ast::ast_get_kind(ast_storage, callee_node) == node_constants::NODE_CALL
    var ic_inner_t = typecheck_walk::tc_expr(tc, ast_storage, callee_node)
    var ic_fn_id = typecheck::tc_fn_type_id(tc, ic_inner_t)
    if ic_fn_id >= 0
      var ic_args = ast::ast_get_children(ast_storage, node)
      for ici in 0..ic_args.size
        typecheck_walk::tc_expr(tc, ast_storage, ic_args[ici])
      end
      return typecheck_util::tc_tv_resolve(tc, typecheck_registry::tc_fn_type_return_type(tc, ic_fn_id))
    end
  end

  var func_name = ast::ast_get_str1(ast_storage, callee_node)

  # Guard against empty func_name from non-IDENT callees
  if str_byte_len(func_name) == 0
    func_name = ""
  end

  # Calls to the scheduler/io intrinsics that semantically perform the
  # Async effect widen the caller's effect row with `Async`. Mirrors the
  # NODE_AWAIT row-widening path. Today's list: io_suspend,
  # io_suspend_timeout, sched_yield, sched_sleep, proc_suspend — all
  # suspendable-leaf intrinsics whose callers are $poll-lowered and
  # whose runtime dispatch now routes through perform(Async, suspend).
  var _async_op = false
  if func_name == "io_suspend"
    _async_op = true
  elsif func_name == "io_suspend_timeout"
    _async_op = true
  elsif func_name == "sched_yield"
    _async_op = true
  elsif func_name == "sched_sleep"
    _async_op = true
  elsif func_name == "proc_suspend"
    _async_op = true
  end
  if _async_op
    var _async_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
    if _async_caller_idx >= 0
      var _async_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _async_caller_idx)
      if _async_caller_row >= 0
        var _async_intern = string_intern::intern_id(tc.interner, "Async")
        var _async_labels = vec_new()
        _async_labels.push(_async_intern)
        var _async_synth_row = typecheck_registry::tc_row_new(tc, _async_labels, -1)
        typecheck_registry::tc_row_subsume(tc, _async_caller_row, _async_synth_row)
      end
    end
  end

  # Phase 4D.4c: Stream<T, body_row> receiver-row propagation. When a
  # UFCS method is called on a `var s` whose static type is a synthesized
  # Stream<T, body_row> ptype (4D.4b at tc_function), widen the caller's
  # effect row by body_row directly. This is the type-driven analog of
  # F.3c's syntactic AsyncIterator-prefix scan at typecheck_walk.qz:3411 —
  # the widening source is the receiver's ptype rather than its annotation
  # string. F.3c stays load-bearing for the `for v in src`-of-async-iter
  # case (NODE_IDENT iter source in for-in typecheck) until 4D.4d folds
  # for-in widening through the same path.
  #
  # Scope: ALL UFCS method calls on Stream-typed receivers — not just
  # Stream.next. Future Stream combinators (map, filter, take, ...) all
  # legitimately want this widening. The body_row=-1 case (sync generators
  # with no `can` clause) skips silently — no labels to propagate.
  #
  # Receiver detection is limited to NODE_IDENT today (the common
  # `var s = my_async_gen(); s.next()` pattern). Chained NODE_CALL
  # receivers (`my_async_gen().next()`) need recursive tc_expr to read
  # the type and aren't covered here yet — F.3c picks them up via the
  # str2 annotation path, and the chained pattern is rare for generators.
  var _4d4c_is_ufcs = ast::ast_call_is_ufcs(ast_storage, node)
  if str_byte_len(func_name) > 0 and _4d4c_is_ufcs == 1
    var _4d4c_args = ast::ast_get_children(ast_storage, node)
    if _4d4c_args != 0 and _4d4c_args.size > 0
      var _4d4c_recv_node = _4d4c_args[0]
      if ast::ast_get_kind(ast_storage, _4d4c_recv_node) == node_constants::NODE_IDENT
        var _4d4c_recv_name = ast::ast_get_str1(ast_storage, _4d4c_recv_node)
        var _4d4c_recv_type = typecheck_util::tc_scope_lookup(tc, _4d4c_recv_name)
        if typecheck::tc_is_stream_ptype(tc, _4d4c_recv_type)
          var _4d4c_recv_row = typecheck::tc_stream_ptype_row(tc, _4d4c_recv_type)
          if _4d4c_recv_row >= 0
            var _4d4c_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
            if _4d4c_caller_idx >= 0
              var _4d4c_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _4d4c_caller_idx)
              if _4d4c_caller_row >= 0
                if not typecheck_registry::tc_row_subsume_with_handlers(tc, _4d4c_caller_row, _4d4c_recv_row)
                  var _4d4c_missing = typecheck_registry::tc_row_missing_labels_str(tc, _4d4c_caller_row, _4d4c_recv_row)
                  if str_byte_len(_4d4c_missing) > 0
                    error("QZ0610: '#{func_name}' on Stream<T, e> requires effects not in caller's `can` clause: #{_4d4c_missing}. Add `can #{_4d4c_missing}` (or merge into the existing `can` row) to the caller.", line, col)
                  else
                    error("QZ0610: Stream<T, e>.#{func_name} effect row is incompatible with caller's `can` clause", line, col)
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  # Operation Piezoelectric Effects, F.3a: `resume(v)` sugar.
  # `resume(v)` inside any function body is early-return sugar — lowers
  # to `return v` at MIR. For tail-position kind=1-style handlers this
  # is the common-case shape ("tail-resume" per memo §2.2). Non-tail
  # resume (real continuation reification) is F.3c; F.3a's single-value
  # return semantics give the caller `v` as the op's result, matching
  # D.5b's handler return ABI.
  if func_name == "resume"
    var _res_args = ast::ast_get_children(ast_storage, node)
    if _res_args != 0
      var _res_argc = _res_args.size
      for _res_ai in 0.._res_argc
        typecheck_walk::tc_expr(tc, ast_storage, _res_args[_res_ai])
      end
    end
    return type_constants::TYPE_NEVER
  end

  # Operation Piezoelectric Effects, C.3: effect-op call detection.
  # BEFORE the B.7 regular row-subsumption path, check whether
  # `func_name` is the name of an operation declared by some registered
  # effect. If it is, treat the call as an op invocation: the op's
  # effect label must be present in the caller's `can` row OR on the
  # handler-effect stack (pushed by an enclosing `with` block). If
  # neither covers it, fire QZ0611. Op detection takes precedence
  # over regular function dispatch ("ops are primary"); in the zero-user
  # project this is the simpler semantic — users avoid collisions by
  # renaming any regular function that shares a name with a declared op.
  #
  # Phase 2 P2.a: skip effect-op detection for UFCS dot-calls (is_ufcs==1).
  # A call like `map.get(k)` lexes as NODE_CALL with the "get" ident but
  # is fundamentally a method dispatch on `map`, not a perform of the
  # State effect's `get` op. Effect ops are bare calls only — UFCS
  # receivers never originate them, and Map/Vec/String collections
  # historically use `get`/`set` method names which now collide with
  # State<S>'s op names. UFCS rewrite further down (~line 2040) retargets
  # these to `map_get`/`vec_set`/etc. before dispatch, so detection must
  # run before rewrite but after the UFCS filter.
  var _c3_is_ufcs_call = ast::ast_call_is_ufcs(ast_storage, node)
  if str_byte_len(func_name) > 0 and _c3_is_ufcs_call == 0
    var _c3_eff_idx = typecheck_registry::tc_lookup_effect_op(tc, func_name)
    if _c3_eff_idx >= 0
      var _c3_eff_name = typecheck_registry::tc_effect_decl_name(tc, _c3_eff_idx)
      var _c3_eff_intern = string_intern::intern_id(tc.interner, _c3_eff_name)
      # C.4: annotate the NODE_CALL so mir_lower can route to
      # MIR_PERFORM_OP without re-running effect lookup. The annotation
      # is load-bearing for lowering — do it here, before any of the
      # coverage / error paths short-circuit, so even QZ0611 call sites
      # carry the marker (lets codegen keep IR well-formed for the
      # compile-failure test harness).
      ast::ast_mark_op_call(ast_storage, node, _c3_eff_name, func_name)
      # Piezo F.3b: stamp kind so MIR can route kind=2 ("operation" /
      # unwind) through a different runtime path than kind=0/1 (tail).
      var _c3_op_kind = typecheck_registry::tc_effect_decl_op_kind_by_name(tc, _c3_eff_idx, func_name)
      if _c3_op_kind >= 0
        ast::ast_mark_op_call_kind(ast_storage, node, _c3_op_kind)
      end
      # D.4 relaxation: blessed effects have a runtime-installed default
      # handler at main entry, so bare op calls to them are always
      # covered by the default chain. Matches the runtime's blessed set
      # (see cg_emit_effect_main_prelude in codegen_runtime.qz).
      # P5.4.e adds FileIo to the blessed set — its four flat ops
      # (fio_read/fio_write/fio_exists/fio_list_dir) dispatch through
      # `@__qz_default_fileio_handler` when no user `with FileIo` wrap
      # is in scope.
      # P5.5.c adds Intern to the blessed set — its two ops
      # (intern/resolve) dispatch through `@intern$intern_default_handler`
      # (Quartz-defined, forwards to `string_intern::intern_global()`)
      # when no user `with Intern` wrap is in scope. Two-pass fixpoint:
      # this relaxation addition is Pass 1 (current binary keeps typing
      # via in-scope body-wraps; new binary knows Intern is blessed);
      # Pass 2 drops the body-wraps + adds the main-prelude install.
      # A.3.a adds Alloc to the blessed set — its two ops
      # (alloc/dealloc) dispatch through `@__qz_default_alloc_handler`
      # (inline LLVM IR in codegen_runtime.qz, forwards to @malloc/@free)
      # when no user `with Alloc` wrap is in scope. Two-pass fixpoint:
      # this relaxation addition is Pass 1 (gen2 build), the prelude
      # install in cg_emit_effect_main_prelude is Pass 2 (gen3 sees both).
      # Compiler source itself never calls user-visible alloc()/dealloc()
      # ops (it uses mem_alloc/mem_free intrinsics directly), so the new
      # rule never fires for self-compile typechecking.
      # A.3 (post-audit) adds Cache to the blessed set — its 6 ops
      # (cache_op_lookup/store/save_pool/load_pool/save_ast/load_ast)
      # dispatch through `@cache$cache_default_handler` (Quartz-defined,
      # forwards to `build_cache::cache_*`) when no user `with Cache`
      # wrap is in scope. Same two-pass dance as Intern: this relaxation
      # ships in Pass 1 (gen0 has no Cache calls in compiler source, so
      # the rule never fires during gen0→gen1 self-compile typecheck);
      # Pass 2 migrates the single quartz.qz:504 callsite, and gen1 (which
      # has the relaxation) accepts the new call cleanly.
      # A.6 adds Profile to the blessed set — its 4 ops (prof_phase /
      # prof_span_begin / prof_span_end / prof_sample) dispatch through
      # `@profile$profile_default_handler` (Quartz-defined, gate-and-emit
      # on `_profile_human_enabled` / `_profile_ndjson_enabled` flags)
      # when no user `with Profile` wrap is in scope. Two-pass dance
      # identical to Cache: Pass 1 ships the relaxation here + the
      # mechanism; Pass 2 migrates the first mem_report site.
      var _c3_covered = typecheck_util::tc_handler_effect_contains(_c3_eff_intern)
      if not _c3_covered
        if _c3_eff_name.eq("Throws") or _c3_eff_name.eq("Log") or _c3_eff_name.eq("FileIo") or _c3_eff_name.eq("Intern") or _c3_eff_name.eq("Alloc") or _c3_eff_name.eq("Cache") or _c3_eff_name.eq("Profile") or _c3_eff_name.eq("Random")
          _c3_covered = true
        end
      end
      if not _c3_covered
        var _c3_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
        if _c3_caller_idx >= 0
          var _c3_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _c3_caller_idx)
          if _c3_caller_row >= 0
            # Synthesize a closed single-label callee row and run B.6 subsume
            # (handler-independent here — we already checked the stack above).
            # This path also handles open-tailed callers: their tail gets
            # extended to absorb the op's effect label, matching "widen
            # caller's row with the op's label" per handoff C.3 bullets.
            var _c3_labels = vec_new()
            _c3_labels.push(_c3_eff_intern)
            var _c3_synth_row = typecheck_registry::tc_row_new(tc, _c3_labels, -1)
            if typecheck_registry::tc_row_subsume(tc, _c3_caller_row, _c3_synth_row)
              _c3_covered = true
            end
          end
          # caller_row == -1 (untracked func, e.g. `def main(): Int = throw(...)`):
          # C.6 will install default main handlers for blessed effects; until
          # then, an untracked caller calling an op with no handler stack
          # coverage is still unhandled. Emit QZ0611 conservatively.
        end
        # No current_func_idx (top-level) AND no stack: QZ0611.
      end
      if not _c3_covered
        error("QZ0611: effect op '#{func_name}' (from effect '#{_c3_eff_name}') is not covered by caller's `can` row or any enclosing `with` handler", line, col)
      end
      # Typecheck args so any errors inside arg exprs still surface.
      var _c3_args = ast::ast_get_children(ast_storage, node)
      if _c3_args != 0
        for _c3_ai in 0.._c3_args.size
          typecheck_walk::tc_expr(tc, ast_storage, _c3_args[_c3_ai])
        end
      end
      return typecheck_registry::tc_effect_decl_op_return_type_by_name(tc, _c3_eff_idx, func_name)
    end
  end

  # Operation Piezoelectric Effects, B.7 + C.2: row subsumption check.
  # When both caller (current function being typechecked) AND callee
  # have non-untracked effect rows, callee's row must be a sub-row of
  # caller's effective row. "Effective row" = caller's labels UNION
  # any effect labels currently on the handler-effect stack (pushed
  # by enclosing `with ClaimedEffect do -> ... end` blocks). This is
  # C.2's narrowing: a callee effect that would otherwise trigger
  # QZ0610 is accepted if the handler stack covers it. Builtins /
  # unresolved callees / untracked sides short-circuit because
  # tc_lookup_function_index returns -1, which keeps the row lookup
  # at -1.
  if str_byte_len(func_name) > 0
    var _b7_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
    if _b7_caller_idx >= 0
      var _b7_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _b7_caller_idx)
      if _b7_caller_row >= 0
        var _b7_callee_idx = typecheck_registry::tc_lookup_function_index(tc, func_name)
        if _b7_callee_idx >= 0
          var _b7_callee_row = typecheck_registry::tc_get_func_effect_row(tc, _b7_callee_idx)
          if _b7_callee_row >= 0
            # P3.F.2: instantiate the callee's generalized row-vars with
            # fresh ervs so two calls of a polymorphic function can bind
            # the row-var to different concrete rows (pure + async).
            var _b7_callee_ervs = typecheck_registry::tc_get_func_generalized_ervs(tc, _b7_callee_idx)
            var _b7_callee_inst = typecheck_registry::tc_row_instantiate_for_call(tc, _b7_callee_row, _b7_callee_ervs)
            if not typecheck_registry::tc_row_subsume_with_handlers(tc, _b7_caller_row, _b7_callee_inst)
              # P3.F.6: concrete fix suggestion — list the labels the caller
              # is missing. Much friendlier than the pre-F.6 generic message
              # that only hinted at "effects... the caller does not declare."
              var _b7_missing = typecheck_registry::tc_row_missing_labels_str(tc, _b7_caller_row, _b7_callee_inst)
              if str_byte_len(_b7_missing) > 0
                error("QZ0610: '#{func_name}' performs effects not in caller's `can` clause: #{_b7_missing}. Add `can #{_b7_missing}` (or merge into the existing `can` row) to the caller.", line, col)
              else
                error("QZ0610: effect signature of '#{func_name}' is incompatible with caller's `can` clause", line, col)
              end
            end
          end
        end
      end
    end
  end

  # Indirect call through a scope-bound Fn-typed variable (parameter or local).
  # A local name MUST shadow any top-level function with the same name —
  # otherwise e.g. prelude's `result_and_then(f: Fn(T): Result<U,E>)` calls `f(v)`
  # and the registry lookup resolves to a user-level `def f(n: Int): Int` instead
  # of the parameter. Only applies when the callee is a plain NODE_IDENT.
  if ast::ast_get_kind(ast_storage, callee_node) == node_constants::NODE_IDENT
    if str_byte_len(func_name) > 0
      var sb_type = typecheck_util::tc_scope_lookup(tc, func_name)
      if sb_type != type_constants::TYPE_ERROR and typecheck::tc_type_is_function(tc, sb_type)
        var sb_args = ast::ast_get_children(ast_storage, node)
        var sb_arg_types = vec_new<Int>()
        for sb_ai in 0..sb_args.size
          sb_arg_types.push(typecheck_walk::tc_expr(tc, ast_storage, sb_args[sb_ai]))
        end
        # P3.F.2: if the callback's Fn annotation carries a `can` row,
        # widen the caller's row by it. Scope-binding stores Fn params as
        # bare TYPE_FUNCTION (not ptype), so we recover the `can` suffix
        # directly from the stored annotation. Resolution runs against the
        # current function's row-var env — same scope that resolved the
        # tail when the signature was first parsed, so named tails (e.g.
        # `| e`) unify correctly through the same erv.
        var sb_ann = typecheck_util::tc_scope_lookup_annotation(tc, func_name)
        # HB-DOG.3(c): resolve `type X = Fn(...)` aliases so `can` row
        # extraction works for aliased bindings too.
        var sb_ann_resolved = typecheck::_tc_resolve_fn_ann(tc, sb_ann)
        if str_byte_len(sb_ann_resolved) > 0 and sb_ann_resolved.starts_with("Fn(")
          var _sb_can_idx = typecheck::_tc_find_last_can_marker(sb_ann_resolved)
          if _sb_can_idx >= 0
            var _sb_row_suffix = str_byte_slice(sb_ann_resolved, _sb_can_idx + 4, str_byte_len(sb_ann_resolved))
            var sb_fn_row = typecheck::_tc_resolve_fn_can_suffix(tc, _sb_row_suffix)
            if sb_fn_row >= 0
              var _fn_caller_idx = typecheck_util::tc_get_current_func_idx(tc)
              if _fn_caller_idx >= 0
                var _fn_caller_row = typecheck_registry::tc_get_func_effect_row(tc, _fn_caller_idx)
                if _fn_caller_row >= 0
                  if not typecheck_registry::tc_row_subsume_with_handlers(tc, _fn_caller_row, sb_fn_row)
                    # P3.F.6: concrete fix for the indirect-call (callback) path.
                    var _fn_missing = typecheck_registry::tc_row_missing_labels_str(tc, _fn_caller_row, sb_fn_row)
                    if str_byte_len(_fn_missing) > 0
                      error("QZ0610: callback '#{func_name}' performs effects not in caller's `can` clause: #{_fn_missing}. Add `can #{_fn_missing}` to the caller (or pass a callback whose declared effects match).", line, col)
                    else
                      error("QZ0610: callback '#{func_name}' effect signature is incompatible with caller's `can` clause", line, col)
                    end
                  end
                end
              end
            end
          end
        end
        # A real user annotation (`var t: Fn(Int): Int = f`) is authoritative
        # AND cache-independent — its return-type string resolves the same way
        # regardless of the `--cache-ro` qzmod state. Prefer it. A bound
        # lambda's SYNTHETIC annotation ("Fn(t0): t0", built by
        # tc_make_fn_type_from_types) yields an unresolved return (TYPE_ERROR or
        # a type var), which falls through to the structured path below.
        if str_byte_len(sb_ann) > 0
          var sb_ann_ret = typecheck::tc_fn_annotation_return_type(tc, sb_ann)
          if sb_ann_ret != type_constants::TYPE_ERROR and typecheck_util::tc_tv_is_var(sb_ann_ret) == 0
            return sb_ann_ret
          end
        end
        # A.43 Phase 3: an unannotated bound lambda (`id = x -> x`) carries a
        # STRUCTURED fn type (fn_id >= 0) whose synthetic annotation can't
        # resolve. Unify the call's args against the structured params and take
        # the resolved return; instantiate a generalized (const) binding for
        # let-polymorphism. (Annotated Fn *params* bind as a bare TYPE_FUNCTION,
        # fn_id == -1, and never reach here — they returned above.)
        if typecheck::tc_fn_type_id(tc, sb_type) >= 0
          var sb_scheme = vec_new<Int>()
          var sb_bidx = typecheck_util::tc_lookup_binding_index(tc, func_name)
          if sb_bidx >= 0 and sb_bidx < tc.scope.binding_schemes.size
            sb_scheme = tc.scope.binding_schemes[sb_bidx]
          end
          return tc_call_local_fn_return(tc, sb_type, sb_scheme, sb_arg_types)
        end
        return type_constants::TYPE_INT
      end
    end
  end

  var args = ast::ast_get_children(ast_storage, node)
  var arg_count = args.size

  # V3 (§14.12.5) — erased-@value-boundary wall. A `@value` struct routed through
  # a conversion bridge (as_int/as_string/as_type/as_vec/as_int_generic) is erased
  # to a bare 8-byte handle, silently losing value identity (inline truncation) or
  # COW refcount ownership (UAF). Forbid, don't box. INERT at gate-0: the leading
  # tc_value_semantics_live()==1 short-circuits before any arg is walked, so the
  # committed build does ZERO extra work and never fires (the compiler uses no
  # @value structs). Conservative direction (§14.12.5 / RFC §5 floor): only fires
  # on an argument we can POSITIVELY identify as a `@value` struct type — a generic
  # or unresolved arg returns 0 from tc_is_value_struct_type and is left alone, so
  # no blanket over-rejection of unrelated generics.
  # F4b (§14.11.11 / f4-steps §3) — QZ0221 GENERALIZES to flipped plain structs.
  # The outer guard fires when EITHER value semantics is live (@value structs) OR
  # the F4 gate is live (eligible plain structs become value-layout). The inner hit
  # checks route through tc_is_value_layout_struct_{type,name}, which read the F4
  # gate DIRECTLY from mir (single source, no parallel-gate drift) and return
  # exactly `is_value` at gate-0 — so this whole block is byte-identical to the
  # original @value-only behavior in the committed (F4-gate-0) state.
  if (typecheck_helpers::tc_value_semantics_live() == 1 or typecheck_registry::tc_default_struct_value_live() == 1) and typecheck_helpers::tc_n3_is_bridge_name(func_name)
    for _v3i in 0..arg_count
      var _v3_arg = args[_v3i]
      var _v3_arg_ty = typecheck_walk::tc_expr(tc, ast_storage, _v3_arg)
      # Positively identify a value-LAYOUT struct (an @value struct, or a flipped
      # plain struct when the F4 gate is live) flowing into the erased word
      # boundary, two ways: (1) the arg's resolved type is the nominal
      # STRUCT_TYPE_BASE+idx; (2) tc_expr collapsed a local var to bare
      # TYPE_STRUCT (7) — recover the nominal via the binding's struct name.
      # Conservative: a non-struct, generic, or unresolved arg matches neither and
      # is left alone (no over-rejection of plain generics).
      var _v3_hit = typecheck_registry::tc_is_value_layout_struct_type(tc, _v3_arg_ty) == 1
      var _v3_name = ""
      if _v3_hit
        _v3_name = typecheck::tc_type_name(_v3_arg_ty)
      elsif _v3_arg_ty == type_constants::TYPE_STRUCT and ast::ast_get_kind(ast_storage, _v3_arg) == node_constants::NODE_IDENT
        var _v3_sname = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, _v3_arg))
        if typecheck_registry::tc_is_value_layout_struct_name(tc, _v3_sname) == 1
          _v3_hit = true
          _v3_name = _v3_sname
        end
      end
      if _v3_hit
        var _v3_line = ast::ast_get_line(ast_storage, _v3_arg)
        var _v3_col = ast::ast_get_col(ast_storage, _v3_arg)
        typecheck_helpers::tc_v3_emit_erased_value_boundary(tc, func_name, _v3_name, _v3_line, _v3_col)
      end
    end
  end

  # Phase 3b.next.2: on-demand cache for tc_expr(args[0]).
  #
  # The UFCS resolution path walks args[0] up to 4 times per call (lines that
  # were 1721, 2147, 2582, 2801 in the uncached version). For a deep method
  # chain `a.b().c().d()`, this compounds exponentially — the leaf gets
  # processed 4^(depth-1) times, each walk allocating small amounts that
  # libc never returns to the OS. Direct cause of the ~87 KB/call leak.
  #
  # The cache resolves the first-arg type once per tc_expr_call invocation
  # and reuses it. Any path that MUTATES the first arg's type (via
  # tc_try_resolve_*) must invalidate with tc_call_invalidate_first_arg_cache.
  var _fa_cache_computed = 0
  var _fa_cache_type = 0

  # Arena safety: detect invalidation calls
  var is_invalidation = 0
  if func_name == "arena_reset"
    is_invalidation = 1
  elsif func_name == "arena_destroy"
    is_invalidation = 1
  elsif func_name == "pool_destroy"
    is_invalidation = 1
  end
  if is_invalidation == 1
    if arg_count >= 1
      var inv_arg = args[0]
      if ast::ast_get_kind(ast_storage, inv_arg) == node_constants::NODE_IDENT
        var inv_name = ast::ast_get_str1(ast_storage, inv_arg)
        typecheck::tc_arena_invalidate(tc, inv_name, line)
      end
    end
  end

  # Special handling for typed allocators: arena_alloc<T>(arena)
  var type_arg = ast::ast_get_type_arg(ast_storage, node)
  if func_name == "arena_alloc"
    if str_byte_len(type_arg) > 0
      # Typed allocator - takes 1 arg (arena), returns Ptr<T>
      if arg_count != 1
        error("arena_alloc<#{type_arg}> expects 1 argument (arena)", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check the arena argument
      var arena_arg = args[0]
      var arena_type = typecheck_walk::tc_expr(tc, ast_storage, arena_arg)
      # Return Ptr<T>: resolve T and wrap in a TYPE_PTR ptype so `.field`/method
      # access on the result is checked against T (soundness — R1.4).
      var aa_resolved = typecheck::tc_parse_type(tc, type_arg)
      return typecheck::tc_make_ptype(tc, type_constants::TYPE_PTR, aa_resolved, 0)
    end
  end

  # Type-safe pointer read: ptr_read<T>(ptr) -> T
  if func_name == "ptr_read"
    if str_byte_len(type_arg) > 0
      if arg_count != 1
        error("ptr_read<#{type_arg}> expects 1 argument (ptr)", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check the pointer argument
      var ptr_arg = args[0]
      var ptr_type = typecheck_walk::tc_expr(tc, ast_storage, ptr_arg)
      # Return T: resolve the type argument so `.field`/method access on the
      # read value is checked (soundness — R1.4). Mirrors as_type<T>.
      return typecheck::tc_parse_type(tc, type_arg)
    end
  end

  # Type-safe pointer write: ptr_write<T>(ptr, value) -> Void
  if func_name == "ptr_write"
    if str_byte_len(type_arg) > 0
      if arg_count != 2
        error("ptr_write<#{type_arg}> expects 2 arguments (ptr, value)", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check both arguments
      var ptr_arg = args[0]
      var val_arg = args[1]
      var ptr_type = typecheck_walk::tc_expr(tc, ast_storage, ptr_arg)
      var val_type = typecheck_walk::tc_expr(tc, ast_storage, val_arg)
      return type_constants::TYPE_VOID
    end
  end

  # Volatile load: volatile_load<T>(ptr) -> T
  if func_name == "volatile_load"
    if str_byte_len(type_arg) > 0
      if arg_count != 1
        error("volatile_load<#{type_arg}> expects 1 argument (ptr)", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check the pointer argument
      var ptr_arg = args[0]
      var ptr_type = typecheck_walk::tc_expr(tc, ast_storage, ptr_arg)
      # Return T: resolve the type argument so `.field`/method access on the
      # loaded value is checked (soundness — R1.4). Mirrors as_type<T>.
      return typecheck::tc_parse_type(tc, type_arg)
    end
  end

  # Volatile store: volatile_store<T>(ptr, value) -> Void
  if func_name == "volatile_store"
    if str_byte_len(type_arg) > 0
      if arg_count != 2
        error("volatile_store<#{type_arg}> expects 2 arguments (ptr, value)", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check both arguments
      var ptr_arg = args[0]
      var val_arg = args[1]
      var ptr_type = typecheck_walk::tc_expr(tc, ast_storage, ptr_arg)
      var val_type = typecheck_walk::tc_expr(tc, ast_storage, val_arg)
      return type_constants::TYPE_VOID
    end
  end

  # as_type<T>(val) returns T — typed cast for existential i64 values
  if func_name == "as_type"
    if str_byte_len(type_arg) > 0
      if arg_count != 1
        error("as_type<#{type_arg}> expects 1 argument", line, col)
        return type_constants::TYPE_ERROR
      end
      # Type check the argument
      typecheck_walk::tc_expr(tc, ast_storage, args[0])
      # Resolve the type arg — if it's a known struct, return type_constants$TYPE_STRUCT
      var resolved = typecheck::tc_parse_type(tc, type_arg)
      return resolved
    end
  end

  # vec_new<T>() returns Vec<T> ptype when type arg is provided
  # vec_new() without type arg returns TYPE_VEC with pending ptype inference
  if func_name == "vec_new"
    if str_byte_len(type_arg) > 0
      if arg_count != 0
        error("vec_new<T> expects 0 arguments, got #{arg_count}", line, col)
        return type_constants::TYPE_ERROR
      end
      var elem_type = typecheck::tc_parse_type(tc, type_arg)
      # Use struct/enum registry index as arg2 to distinguish Vec<Point> from Vec<Triple>
      var struct_idx = 0
      if typecheck::tc_is_struct_type(elem_type)
        var sr = typecheck_registry::tc_lookup_struct(tc, type_arg)
        if sr.is_found()
          struct_idx = sr.unwrap() + 1
        end
      elsif elem_type == type_constants::TYPE_ENUM
        var er = typecheck_registry::tc_lookup_enum(tc, type_arg)
        if er.is_found()
          struct_idx = er.unwrap() + 1
        end
      end
      var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, elem_type, struct_idx)
      if struct_idx > 0
        typecheck::tc_ptype_set_name(tc, ptype_id, type_arg)
      end
      return ptype_id
    else
      # No type arg — return TYPE_VEC so UFCS dispatch works for .push/.size etc.
      # Element type will be inferred from first constraining use (e.g., .push(42))
      return type_constants::TYPE_VEC
    end
  end

  # vec_new_filled<T>(count, fill_value) returns Vec<T> ptype when type arg is provided
  if func_name == "vec_new_filled"
    if str_byte_len(type_arg) > 0
      if arg_count != 2
        error("vec_new_filled<T> expects 2 arguments (count, fill_value), got #{arg_count}", line, col)
        return type_constants::TYPE_ERROR
      end
      var elem_type = typecheck::tc_parse_type(tc, type_arg)
      var struct_idx = 0
      if typecheck::tc_is_struct_type(elem_type)
        var sr = typecheck_registry::tc_lookup_struct(tc, type_arg)
        if sr.is_found()
          struct_idx = sr.unwrap() + 1
        end
      elsif elem_type == type_constants::TYPE_ENUM
        var er = typecheck_registry::tc_lookup_enum(tc, type_arg)
        if er.is_found()
          struct_idx = er.unwrap() + 1
        end
      end
      var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, elem_type, struct_idx)
      if struct_idx > 0
        typecheck::tc_ptype_set_name(tc, ptype_id, type_arg)
      end
      return ptype_id
    end
  end

  # array_new<T, N>() requires type + const size
  if func_name == "array_new"
    if str_byte_len(type_arg) > 0
      if not str_contains(type_arg, ",")
        error("array_new requires two type parameters: array_new<T, N>(), got array_new<#{type_arg}>()", line, col)
        return type_constants::TYPE_ERROR
      end
      if arg_count != 0
        error("array_new<T, N> expects 0 arguments, got #{arg_count}", line, col)
        return type_constants::TYPE_ERROR
      end
      return type_constants::TYPE_INT
    end
  end

  # channel_new<T>(capacity) returns Channel<T> ptype when type arg is provided
  # channel_new(capacity) without type arg returns TYPE_CHANNEL with pending ptype inference
  if func_name == "channel_new"
    if str_byte_len(type_arg) > 0
      if arg_count != 1
        error("channel_new<T> expects 1 argument (capacity), got #{arg_count}", line, col)
        return type_constants::TYPE_ERROR
      end
      typecheck_walk::tc_expr(tc, ast_storage, args[0])
      var elem_type = typecheck::tc_parse_type(tc, type_arg)
      return typecheck::tc_make_ptype(tc, type_constants::TYPE_CHANNEL, elem_type, 0)
    end
  end

  # map_new<K,V>() — unified Map constructor (v5.27)
  if func_name == "map_new"
    if str_byte_len(type_arg) > 0
      if not str_contains(type_arg, ",")
        error("map_new requires two type parameters: map_new<K, V>(), got map_new<#{type_arg}>()", line, col)
        return type_constants::TYPE_ERROR
      end
      if arg_count != 0
        error("map_new<K,V> expects 0 arguments, got #{arg_count}", line, col)
        return type_constants::TYPE_ERROR
      end
      var key_str = typecheck_generics::tc_extract_nth_type_arg(type_arg, 0)
      var val_str = typecheck_generics::tc_extract_nth_type_arg(type_arg, 1)
      if str_byte_len(key_str) > 0
        if str_byte_len(val_str) > 0
          var key_type = typecheck::tc_parse_type(tc, key_str)
          var val_type = typecheck::tc_parse_type(tc, val_str)
          var key_hashable = typecheck_helpers::tc_type_is_hashable(tc, key_type)
          var struct_reason = ""
          if not key_hashable and typecheck::tc_is_struct_type(key_type)
            key_hashable = typecheck_helpers::tc_struct_is_hashable(tc, key_str)
            if not key_hashable
              struct_reason = typecheck_helpers::tc_struct_hashable_rejection(tc, key_str)
            end
          end
          if not key_hashable
            var reason = struct_reason
            if str_byte_len(reason) == 0
              reason = typecheck_helpers::tc_hashable_rejection_reason(tc, key_type)
            end
            error("Map key type '#{key_str}' is not hashable: #{reason}", line, col)
            return type_constants::TYPE_ERROR
          end
          var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_MAP, key_type, val_type)
          if typecheck::tc_is_struct_type(key_type)
            typecheck::tc_ptype_set_name(tc, ptype_id, key_str)
          end
          return ptype_id
        end
      end
    end
    for i in 0..arg_count
      typecheck_walk::tc_expr(tc, ast_storage, args[i])
    end
    return type_constants::TYPE_MAP
  end

  # Direct-call form: map_set(m, k, v) etc. UFCS form (m.set(k, v)) is annotated
  # later in the UFCS rewrite block.
  #
  # Annotation strategy: type-check the key argument directly. This is the most
  # reliable signal — receiver-based inference is fragile when `map_new()` is
  # used bare (no parameterized type yet) or when the binding update from a
  # prior `map_set` hasn't propagated. The key arg's type is concrete and
  # always available at the call site.
  var _is_map_call = (str_starts_with(func_name, "map_") and func_name != "map_new") or func_name == "__map_get_raw"
  # Sets reuse the same key-type annotation channel: `set_add(s, v)` /
  # `set_has(s, v)` / `set_delete(s, v)` carry the element type at args[1],
  # which the WASM backend uses to dispatch to intmap_* vs hashmap_*. Without
  # this annotation Set<Int> silently routes to string-keyed hashmap and
  # str_hash dereferences the int as a pointer (out-of-bounds memory fault).
  var _is_set_call = str_starts_with(func_name, "set_") and func_name != "set_new"
  if _is_map_call or _is_set_call
    if arg_count >= 2
      # Primary annotation: type-check the key arg directly. Most reliable signal.
      var key_arg_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
      if key_arg_type == type_constants::TYPE_INT
        ast::ast_set_str2(ast_storage, node, "Int")
      elsif typecheck::tc_is_struct_type(key_arg_type)
        var struct_key_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[1])
        if str_byte_len(struct_key_name) > 0
          ast::ast_set_str2(ast_storage, node, struct_key_name)
          # WS1 — back-stamp the originating set_new() init node so its codegen
          # allocates the struct-compatible (string-hashmap) layout that the
          # value-compare set_add/has/delete path operates on. Map-key sets use
          # a value arg too, but only set_* calls have a set_new to back-stamp.
          if _is_set_call
            tc_backstamp_set_new_struct_elem(tc, ast_storage, args[0], struct_key_name)
            # WS3 — record the receiver var's element struct type so a later
            # union/intersection/difference/is_subset on it can recover the element
            # type (Set is unparameterized ⇒ no static Set<T> to read).
            tc_record_set_struct_elem(tc, ast_storage, args[0], struct_key_name)
          end
        end
      end
      # WS3 — set ALGEBRA (union/intersection/difference/is_subset) takes another
      # SET as args[1], not an element, so the args[1] check above never stamps the
      # element type. `Set` is unparameterized (no `Set<T>` to read), so recover the
      # element struct type from the per-function side-table populated by the
      # receiver's earlier struct set_adds; stamp it so codegen routes struct-set
      # algebra to the value-compare @qz_set_custom_* helpers. Int/String sets never
      # populate the table ⇒ no stamp ⇒ the default identity @qz_set_* path
      # (byte-identical: the default algebra path ignores _elem_type).
      if _is_set_call
        if func_name == "set_union" or func_name == "set_intersection" or func_name == "set_difference" or func_name == "set_is_subset"
          var _alg_elem = tc_lookup_set_struct_elem(tc, ast_storage, args[0])
          if str_byte_len(_alg_elem) > 0
            ast::ast_set_str2(ast_storage, node, _alg_elem)
          end
        end
      end
      if _is_map_call
        # Then update the receiver binding via K/V inference (fires on
        # map_set/map_insert only) so subsequent references know the type AND
        # back-stamp the original map_new() init node for layout selection.
        tc_try_resolve_map_key_value_types(tc, ast_storage, node, args[0], func_name, args, arg_count)
      end
    elsif arg_count > 0
      # 1-arg form (map_size, map_clear, map_keys, map_values, map_free):
      # no key arg to inspect, fall back to receiver-based inference.
      # Same helper works for sets — it reads ptype.arg1 which is the
      # element type for Set<T> and the key type for Map<K, V>.
      tc_annotate_map_key_type(tc, ast_storage, node, args[0], 0)
    end
  end

  # Trait method resolution: For calls with arguments where name doesn't contain $,
  # try Type$method mangled name first if first arg is a struct
  var is_cross_module = str_contains(func_name, "$")
  var mangled_name = ""
  if arg_count > 0
    if is_cross_module == false
      var first_arg = args[0]
      # Get the first argument - if it's an identifier, look up its struct name
      var first_arg_kind = ast::ast_get_kind(ast_storage, first_arg)
      if first_arg_kind == node_constants::NODE_IDENT
        var arg_name = ast::ast_get_str1(ast_storage, first_arg)
        var arg_type = typecheck_util::tc_scope_lookup(tc, arg_name)
        if typecheck::tc_is_struct_type(arg_type)
          var struct_name = typecheck_util::tc_scope_lookup_struct_name(tc, arg_name)
          if str_byte_len(struct_name) > 0
            # Build mangled name: Type$method
            mangled_name = tc_mangle(tc, struct_name, func_name)
            # Try looking up the mangled name
            var mangled_type = typecheck_util::tc_scope_lookup(tc, mangled_name)
            if mangled_type == type_constants::TYPE_ERROR
              mangled_type = typecheck_registry::tc_lookup_function_return(tc, mangled_name)
            end
            if mangled_type != type_constants::TYPE_ERROR
              # Found mangled name - use it
              func_name = mangled_name
              ast::ast_set_str1(ast_storage, callee_node, mangled_name)
              is_cross_module = true  # Skip further undefined error
            end
          end
        end
      end
    end
  end

  # UFCS method resolution for built-in types (String, Map)
  # When s.find(sub) is called, is_ufcs is 1, func_name is "find", args are [s, sub]
  # Build Type$method (e.g., String$find), look it up, and rewrite to canonical intrinsic
  var is_ufcs = ast::ast_call_is_ufcs(ast_storage, node)
  if is_ufcs == 1 and arg_count > 0
    var first_arg = args[0]
    if _fa_cache_computed == 0
      _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, first_arg)
      _fa_cache_computed = 1
    end
    var first_arg_full_type = _fa_cache_type
    var first_arg_type = typecheck::tc_base_kind(tc, first_arg_full_type)

    # SURF.FLOW S1 — invalidate flow-narrowing on a `&mut self` method call.
    # `recv.foo(...)` where `foo` takes `&mut self` can flip `recv`'s Option/union
    # cell to a different variant IN PLACE, so any narrowing proof on `recv` must
    # be dropped here (mirrors the `&mut x` hook at typecheck_walk.qz:1698 — the
    # receiver is a bare read, not a syntactic `&mut x` node, so it never reaches
    # that hook). Keyed on the receiver's SAME access-path key the narrow fact was
    # stored under. PRECISION: only for a `&mut self` receiver (mutating) — a
    # value-`self` / `&self` (shared) method cannot mutate the cell, so narrowing
    # SURVIVES it (over-invalidating there would drop `x.is_some()` / `x.unwrap()`
    # in narrowed blocks → over-reject). Additive: no-op on an unresolvable
    # receiver struct name or a non-`&mut self` method.
    var s1_recv_key = typecheck_util::tc_access_path_key(ast_storage, first_arg)
    if str_byte_len(s1_recv_key) > 0
      var s1_recv_sname = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, first_arg)
      if str_byte_len(s1_recv_sname) > 0
        if tc_method_receiver_is_mut_self(tc, ast_storage, s1_recv_sname, func_name)
          # Drop narrowing on the receiver AND any access path rooted at it — a
          # `&mut self` call can flip an interior field/element cell (`self.opt`),
          # not just the receiver's own cell.
          typecheck_util::tc_narrow_invalidate_rooted(tc, s1_recv_key)
        end
      end
    end

    # Annotation fallback: when first_arg_type is TYPE_INT, recover actual container type
    # from the binding's type annotation. Fixes UFCS methods on globals, closure params, etc.
    if first_arg_type == type_constants::TYPE_INT
      var fb_ann = ""
      if ast::ast_get_kind(ast_storage, first_arg) == node_constants::NODE_IDENT
        fb_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, first_arg))
      end
      if str_byte_len(fb_ann) == 0
        fb_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, first_arg)
      end
      if str_byte_len(fb_ann) > 0
        first_arg_type = typecheck_generics::tc_annotation_to_container_type(fb_ann)
      end
    end
    # F4 (item 9e) — a literal-built Vec receiver (`v = [S{..}, ..]`) types to bare
    # TYPE_ARRAY (the array literal's result), so UFCS dispatch (.map/.filter/.each)
    # never enters the TYPE_VEC arm below and the HOF lambda-param element-name stamp
    # is missed → the closure body reads VALUE-LAYOUT element fields FLAT (no cow +1 /
    # typed GEP) → garbage. The binding carries a `Vec<S>` ANNOTATION (the LET
    # back-stamp). Normalize TYPE_ARRAY → TYPE_VEC ONLY when the element is a
    # value-layout struct, so reference / scalar array-literal receivers keep their
    # EXACT current dispatch path (byte-identical) and ONLY @value-element literals —
    # gate-0-absent — are re-routed into the value-aware HOF stamp. The TYPE_VEC arm's
    # own stamp is additionally value-layout-gated, so this is doubly inert at gate 0.
    if first_arg_type == type_constants::TYPE_ARRAY
      if ast::ast_get_kind(ast_storage, first_arg) == node_constants::NODE_IDENT
        var aa_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, first_arg))
        if str_byte_len(aa_ann) == 0
          aa_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, first_arg)
        end
        if str_byte_len(aa_ann) > 0 and aa_ann.starts_with("Vec<")
          var aa_elem = typecheck::tc_extract_element_type(aa_ann)
          if str_byte_len(aa_elem) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, aa_elem) == 1
            first_arg_type = type_constants::TYPE_VEC
          end
        end
      end
    end

    var type_name = ""
    var canonical_intrinsic = ""

    if first_arg_type == type_constants::TYPE_STRING
      type_name = "String"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_STRING, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_VEC
      # Vec UFCS method rewrites (Phase 5.7: Clearable)
      type_name = "Vec"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_VEC, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
        # Annotate with element type for width-aware codegen (mem-v2)
        if typecheck::tc_is_ptype(first_arg_full_type)
          var ufcs_elem_t = typecheck::tc_ptype_arg1(tc, first_arg_full_type)
          var ufcs_elem_name = typecheck::tc_type_name(ufcs_elem_t)
          # For struct/enum element types, tc_type_name returns "Struct"/"Enum"
          # — get the actual name from the ptype to enable @value codegen
          if typecheck::tc_is_struct_type(ufcs_elem_t) or ufcs_elem_t == type_constants::TYPE_ENUM
            var pt_name = typecheck::tc_ptype_name(tc, first_arg_full_type)
            if str_byte_len(pt_name) > 0
              ufcs_elem_name = pt_name
            end
          end
          # R2 (C3) — a structural-record `Vec<{ x: Int }>` element: tc_type_name
          # returns a non-annotation placeholder for a record type-id, but MIR's
          # canonicalization seam (mir_lower_expr_handlers `_vec_elem_type`) needs the
          # `{ x: Int }` field-annotation spelling to recognize + register C1's @value
          # record struct. tc_tv_type_name renders a closed record exactly as
          # `{ x: Int }` (open records add ` | ..`, which are not canonicalizable — leave
          # those to the placeholder). GATE-0-INERT: no compiler Vec has a record element.
          if typecheck_registry::tc_is_record_type(ufcs_elem_t)
            var rec_ann = typecheck_util::tc_tv_type_name(tc, ufcs_elem_t)
            if str_byte_len(rec_ann) > 0 and str_byte_at(rec_ann, 0) == 123
              ufcs_elem_name = rec_ann
            end
          end
          ast::ast_set_str2(ast_storage, node, ufcs_elem_name)
          # F4 item-9 — backfill the element struct name into the HOF lambda's
          # ELEMENT param str2 so MIR can mark it struct-typed. An implicit-`it` /
          # unannotated closure (`v.each { it.a }`, `v.map(e -> e.b)`) over a
          # value-layout `Vec<S>` is otherwise typed by a free type var that never
          # carries the struct name to MIR, so the body reads fields FLAT (offset
          # 0..N) instead of through S's value-layout layout (cow buffer word f+1
          # / inline @value) — garbage / SIGSEGV for >1-word @value elements. A
          # named-fn callee (`v.map(sum3)`) already works because its `p: S` param
          # carries the type. This gives the inline closure the same info. Only the
          # ELEMENT-receiving param is filled (reduce's element is param[1] after
          # acc; the rest take it as param[0]) and only when unannotated. INERT for
          # scalar Vec<Int> elements (only struct/enum element names are written).
          tc_hof_backfill_lambda_elem_type(tc, ast_storage, func_name, ufcs_elem_name, ufcs_elem_t, args, arg_count)
        else
          # F4 (item 9e) — HOF over a literal-built Vec of value-layout elements.
          # A `v = [S{..}, ..]` binding carries a `Vec<S>` ANNOTATION (the LET
          # back-stamp via tc_infer_expr_type_annotation) but `first_arg_full_type`
          # stays bare TYPE_VEC (no ptype) because the array literal types to
          # TYPE_ARRAY. The ptype branch above is therefore skipped, so a
          # `.map`/`.filter`/`.each` lambda param never gets the element struct
          # name and its `param.field` body read goes FLAT (no cow +1 / typed GEP)
          # → garbage for >16B cow / narrow @value elements. Recover the element
          # struct name from the receiver IDENT's annotation and, when it is a
          # value-layout struct, stamp the SAME HOF metadata the ptype branch does
          # (call-node str2 + lambda element param). This stamps ONLY the HOF
          # element-name side-channel — it does NOT change the binding type, so the
          # index-stride / direct-read paths are untouched (those are handled by
          # the MIR vec_elem_types registration). GATED on a value-layout struct
          # element ⇒ reference structs / `Vec<Int>` literals are unaffected, and
          # gate-0-dead (no @value Vec literals in the compiler's own source).
          var _h9e_done = 0
          if ast::ast_get_kind(ast_storage, first_arg) == node_constants::NODE_IDENT
            var _h9e_recv = ast::ast_get_str1(ast_storage, first_arg)
            var _h9e_ann = typecheck_util::tc_scope_lookup_annotation(tc, _h9e_recv)
            if str_byte_len(_h9e_ann) > 0 and _h9e_ann.starts_with("Vec<")
              var _h9e_elem = typecheck::tc_extract_element_type(_h9e_ann)
              if str_byte_len(_h9e_elem) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, _h9e_elem) == 1
                var _h9e_elem_t = typecheck::tc_parse_type(tc, _h9e_elem)
                if _h9e_elem_t != type_constants::TYPE_ERROR
                  ast::ast_set_str2(ast_storage, node, _h9e_elem)
                  tc_hof_backfill_lambda_elem_type(tc, ast_storage, func_name, _h9e_elem, _h9e_elem_t, args, arg_count)
                  _h9e_done = 1
                end
              end
            end
          end
          # FIX.6 Phase 1: Infer element type from constraining UFCS methods
          # When receiver is bare TYPE_VEC (no ptype), resolve from value argument
          if _h9e_done == 0
            tc_try_resolve_vec_element_type(tc, ast_storage, node, first_arg, func_name, args, arg_count)
          end
        end
      end
    elsif first_arg_type == type_constants::TYPE_SLICE or first_arg_type == type_constants::TYPE_SLICE_MUT
      # Slice<T> / SliceMut<T> UFCS method rewrites (Tier 4 #24 Phase 2).
      # set/set_unchecked are only valid for SliceMut; flagged below.
      type_name = "Slice"
      # Tier 4 #24 Phase 4b §2.2: Slice<Byte> uses byte-stride intrinsics.
      var slice_elem_t = 0
      if typecheck::tc_is_ptype(first_arg_full_type)
        slice_elem_t = typecheck::tc_ptype_arg1(tc, first_arg_full_type)
      end
      var is_byte_slice = slice_elem_t == type_constants::TYPE_BYTE
      canonical_intrinsic = tc_container_ufcs_canonical(first_arg_type, func_name)
      # Retarget .get to byte-stride variant for Slice<Byte>.
      if is_byte_slice and canonical_intrinsic == "slice_get"
        canonical_intrinsic = "byte_slice_get"
      end
      if str_byte_len(canonical_intrinsic) > 0
        if canonical_intrinsic == "slice_set" and first_arg_type == type_constants::TYPE_SLICE
          error("QZ1210: cannot call '.set' on Slice<T> — use SliceMut<T> for mutable slice access", 0, 0)
        end
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_MAP
      type_name = "Map"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_MAP, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
        # Map K/V inference: when receiver is bare TYPE_MAP (no ptype),
        # resolve K and V from a constraining map_set/map_insert call so
        # subsequent references know the type.
        if not typecheck::tc_is_ptype(first_arg_full_type)
          tc_try_resolve_map_key_value_types(tc, ast_storage, node, first_arg, func_name, args, arg_count)
          # tc_try_resolve_* may have promoted the binding's type; must re-walk.
          first_arg_full_type = typecheck_walk::tc_expr(tc, ast_storage, first_arg)
          _fa_cache_type = first_arg_full_type
          _fa_cache_computed = 1
        end
        # Annotation: prefer typing the key arg directly (most reliable signal).
        # Receiver-based inference is the fallback for 1-arg calls.
        if func_name != "map_new"
          if arg_count >= 2
            var ufcs_key_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
            if ufcs_key_type == type_constants::TYPE_INT
              ast::ast_set_str2(ast_storage, node, "Int")
            elsif typecheck::tc_is_struct_type(ufcs_key_type)
              var ufcs_struct_key_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[1])
              if str_byte_len(ufcs_struct_key_name) > 0
                ast::ast_set_str2(ast_storage, node, ufcs_struct_key_name)
              end
            end
          else
            tc_annotate_map_key_type(tc, ast_storage, node, first_arg, first_arg_full_type)
          end
        end
      end
    elsif first_arg_type == type_constants::TYPE_STRINGBUILDER
      type_name = "StringBuilder"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_STRINGBUILDER, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_SET
      type_name = "Set"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_SET, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
        # Annotate slot2 with the element type so the WASM backend can
        # route Set<Int> ops through intmap_* (multiplicative i64 hash)
        # rather than the default hashmap_* (str_hash, dereferences key).
        # Mirrors the map_* UFCS annotation block above.
        if canonical_intrinsic != "set_new"
          if arg_count >= 2
            var ufcs_set_elem_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
            if ufcs_set_elem_type == type_constants::TYPE_INT
              ast::ast_set_str2(ast_storage, node, "Int")
            elsif typecheck::tc_is_struct_type(ufcs_set_elem_type)
              var ufcs_set_struct_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[1])
              if str_byte_len(ufcs_set_struct_name) > 0
                ast::ast_set_str2(ast_storage, node, ufcs_set_struct_name)
              end
            end
          else
            tc_annotate_map_key_type(tc, ast_storage, node, first_arg, first_arg_full_type)
          end
        end
      end
    elsif first_arg_type == type_constants::TYPE_RANGE
      type_name = "Range"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_RANGE, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_INT
      type_name = "Int"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_INT, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_F64
      type_name = "F64"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_F64, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_TASK_GROUP
      type_name = "TaskGroup"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_TASK_GROUP, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_CHANNEL or (typecheck::tc_is_ptype(first_arg_type) and typecheck::tc_base_kind(tc, first_arg_type) == type_constants::TYPE_CHANNEL)
      type_name = "Channel"
      canonical_intrinsic = tc_container_ufcs_canonical(type_constants::TYPE_CHANNEL, func_name)
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
      # Infer Channel<T> from first send/try_send on bare Channel (no ptype)
      if first_arg_type == type_constants::TYPE_CHANNEL and not typecheck::tc_is_ptype(first_arg_type)
        if func_name == "send" or func_name == "try_send"
          if arg_count >= 2
            if ast::ast_get_kind(ast_storage, first_arg) == node_constants::NODE_IDENT
              var chan_name = ast::ast_get_str1(ast_storage, first_arg)
              var existing_ann = typecheck_util::tc_scope_lookup_annotation(tc, chan_name)
              if str_byte_len(existing_ann) == 0 or __char_index(existing_ann, '<') < 0
                var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                if val_type != type_constants::TYPE_ERROR
                  var elem_name = typecheck::tc_type_name(val_type)
                  var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_CHANNEL, val_type, 0)
                  var bidx = typecheck_util::tc_lookup_binding_index(tc, chan_name)
                  if bidx >= 0
                    tc.scope.binding_types[bidx] = ptype_id
                    tc.scope.binding_type_annotations[bidx] = "Channel<#{elem_name}>"
                  end
                  typecheck_util::tc_resolve_pending_ptype(tc, chan_name)
                end
              end
            end
          end
        end
      end
    elsif first_arg_type == type_constants::TYPE_ATOMIC
      type_name = "AtomicInt"
      canonical_intrinsic = match func_name
        "load" => "atomic_load"
        "store" => "atomic_store"
        "add" => "atomic_add"
        "sub" => "atomic_sub"
        "exchange" => "atomic_exchange"
        "xor" => "atomic_xor"
        "cas" => "atomic_cas"
        _ => ""
      end
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_MUTEX
      type_name = "Mutex"
      # `lock` deliberately omitted — `extend Mutex { def lock(self): MutexGuard }`
      # in stdlib supersedes the legacy `m.lock() -> mutex_lock(m) -> Int` rewrite.
      # Rewriting here would emit a 1-arg call to `@mutex$Mutex$lock`, but the
      # extend-method ABI emits the function def with a ghost+self 2-param
      # signature — the arity mismatch crashes at runtime. Let `lock` fall
      # through to general struct-method dispatch so call/def agree.
      canonical_intrinsic = match func_name
        "unlock" => "mutex_unlock"
        "try_lock" => "mutex_try_lock"
        _ => ""
      end
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_OPTION
      type_name = "Option"
      canonical_intrinsic = match func_name
        "unwrap" => "unwrap"
        "unwrap_or" => "unwrap_or"
        "is_some" => "is_some"
        "is_none" => "is_none"
        "map" => "option_map"
        "and_then" => "option_and_then"
        _ => ""
      end
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    elsif first_arg_type == type_constants::TYPE_RESULT
      type_name = "Result"
      canonical_intrinsic = match func_name
        "unwrap" => "unwrap_ok"
        "unwrap_err" => "unwrap_err"
        "unwrap_or" => "unwrap_or_ok"
        "is_ok" => "is_ok"
        "is_err" => "is_err"
        "map" => "result_map"
        "and_then" => "result_and_then"
        _ => ""
      end
      if str_byte_len(canonical_intrinsic) > 0
        func_name = canonical_intrinsic
        ast::ast_set_str1(ast_storage, callee_node, canonical_intrinsic)
      end
    end

    # Tier 4 #24 Phase 4b §2.5: UFCS-mutation borrow-check.
    # After the UFCS ladder rewrote v.push(X) → vec_push(v, X), check whether
    # the canonical name mutates its receiver. If the receiver is a binding
    # that's currently borrowed (e.g., by a live Slice), raise QZ1209.
    if str_byte_len(canonical_intrinsic) > 0
      var mu_is_mut = match canonical_intrinsic
        "vec_push" => true
        "vec_pop" => true
        "vec_clear" => true
        "vec_free" => true
        "vec_set" => true
        "vec_set_unchecked" => true
        "vec_insert" => true
        "vec_delete" => true
        "vec_reverse" => true
        "vec_sort" => true
        "vec_sort_by" => true
        "vec_shrink_to_fit" => true
        "vec_truncate" => true
        "vec_dedup" => true
        "vec_retain" => true
        "vec_extend" => true
        "map_set" => true
        "map_insert" => true
        "map_delete" => true
        "map_clear" => true
        "map_free" => true
        _ => false
      end
      if mu_is_mut
        var mu_recv = args[0]
        if ast::ast_get_kind(ast_storage, mu_recv) == node_constants::NODE_IDENT
          var mu_name = ast::ast_get_str1(ast_storage, mu_recv)
          typecheck::tc_check_mutation_while_borrowed(tc, mu_name, line, col)
        end
      end
    end
  end

  # Look up function type. Priority: scope > builtin > registry. When a
  # builtin intrinsic and a user-defined extern/function share a name
  # (e.g., channel `send(ch, val)` vs ws2_32 `extern "C" def send(s, buf,
  # len, flags)` on Windows), dispatch is arity-aware: the builtin only
  # defers to the registry when (a) the builtin has explicit arity bounds,
  # (b) arg_count doesn't fall within those bounds, AND (c) the registry
  # has a competing entry. Otherwise the builtin wins, preserving the
  # familiar "requires at least N" arity diagnostic for cases like
  # `channel_new()` where no competing extern exists.
  # Path A — see feedback_channel_send_vs_ws2_send_name_clash.md.
  var fn_type = typecheck_util::tc_scope_lookup(tc, func_name)
  var _fn_type_from_builtin = 0
  if fn_type == type_constants::TYPE_ERROR
    var _b_type = typecheck_builtins::tc_lookup_builtin(tc, func_name)
    if _b_type != type_constants::TYPE_ERROR
      var _b_min = typecheck_builtins::tc_lookup_builtin_min_arity(tc, func_name)
      var _b_max = typecheck_builtins::tc_lookup_builtin_max_arity(tc, func_name)
      var _b_arity_ok = 1
      if _b_min >= 0 and _b_max >= 0
        if arg_count < _b_min or arg_count > _b_max
          _b_arity_ok = 0
        end
      end
      var _reg_has_entry = typecheck_registry::tc_function_param_count(tc, func_name) >= 0
      if _b_arity_ok == 1 or _reg_has_entry == false
        fn_type = _b_type
        _fn_type_from_builtin = 1
      end
    end
  end
  if fn_type == type_constants::TYPE_ERROR
    # Check user-defined functions registry
    fn_type = typecheck_registry::tc_lookup_function_return(tc, func_name)
  end



  # Type-prefixed UFCS: if function not found and first arg has a type alias,
  # try {type_alias}_{method_name}. For example:
  # push(v, x) where v: Vec -> try vec_push(v, x)
  if fn_type == type_constants::TYPE_ERROR and arg_count > 0
    var first_arg = args[0]
    if _fa_cache_computed == 0
      _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, first_arg)
      _fa_cache_computed = 1
    end
    var first_arg_type = _fa_cache_type
    var type_alias = typecheck_builtins::tc_get_type_alias(tc, first_arg_type)
    if str_byte_len(type_alias) > 0
      # Build prefixed name: type_alias + "_" + func_name
      # tc_get_type_alias already returns lowercase (e.g., "vec", "str")
      var prefixed_name = "#{type_alias}_#{func_name}"
      var prefixed_type = typecheck_builtins::tc_lookup_builtin(tc, prefixed_name)
      if prefixed_type == type_constants::TYPE_ERROR
        prefixed_type = typecheck_registry::tc_lookup_function_return(tc, prefixed_name)
      end
      if prefixed_type != type_constants::TYPE_ERROR
        fn_type = prefixed_type
        func_name = prefixed_name
        # Rewrite the AST to use the prefixed name
        ast::ast_set_str1(ast_storage, callee_node, prefixed_name)
      end
    end
  end

  # Generic UFCS: if function not found OR call is UFCS, try TypeName$func_name
  # (e.g., result.is_found() -> LookupResult$is_found(result))
  # Also handles custom extend methods on primitive types (Int, Bool, String)
  # For UFCS calls, struct-specific methods override builtins (e.g., Point$sum over sum)
  var ufcs_receiver_type = ""  # Track receiver type for better error messages
  if (fn_type == type_constants::TYPE_ERROR or is_ufcs == 1) and arg_count > 0
    var first_arg2 = args[0]
    if _fa_cache_computed == 0
      _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, first_arg2)
      _fa_cache_computed = 1
    end
    var first_type2_raw = _fa_cache_type
    # GENERIC-IMPL-ON-GENERIC-STRUCT-MONO: resolve parameterized types (PTYPE)
    # to their base kind so UFCS dispatch on e.g. `l: Lift<Base>` (stored as a
    # PTYPE) still hits the struct/enum branch below. Before this, PTYPEs fell
    # through and the callee kept the bare method name, which downstream
    # codegen then dispatched to the wrong type.
    var first_type2 = typecheck::tc_base_kind(tc, first_type2_raw)
    var struct_name2 = ""
    if typecheck::tc_is_struct_type(first_type2) or first_type2 == type_constants::TYPE_ENUM
      var first_kind2 = ast::ast_get_kind(ast_storage, first_arg2)
      if first_kind2 == node_constants::NODE_IDENT
        var var_name2 = ast::ast_get_str1(ast_storage, first_arg2)
        struct_name2 = typecheck_util::tc_scope_lookup_struct_name(tc, var_name2)
      elsif first_kind2 == node_constants::NODE_FIELD_ACCESS
        # Resolve struct name through field access chain (e.g., frame.payload → Bytes)
        struct_name2 = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, first_arg2)
      else
        # General fallback for call results, conditionals, etc.
        # Enables impl methods on chained calls: Style.new().bold()
        struct_name2 = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, first_arg2)
      end
    elsif first_type2 == type_constants::TYPE_INT
      # For TYPE_INT receivers, try to recover the actual struct name from annotation.
      # This handles single-field structs (like Bytes wrapping Vec<Int>) that are
      # existentially typed as Int but have impl methods.
      var _ufcs_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, first_arg2)
      if str_byte_len(_ufcs_ann) > 0
        # Check if the annotation names a struct with an impl method for func_name
        var _ufcs_mangled = tc_mangle(tc, _ufcs_ann, func_name)
        var _ufcs_type = typecheck_builtins::tc_lookup_builtin(tc, _ufcs_mangled)
        if _ufcs_type == type_constants::TYPE_ERROR
          _ufcs_type = typecheck_registry::tc_lookup_function_return(tc, _ufcs_mangled)
        end
        if _ufcs_type != type_constants::TYPE_ERROR
          struct_name2 = _ufcs_ann
        else
          struct_name2 = "Int"
        end
      else
        struct_name2 = "Int"
      end
    elsif first_type2 == type_constants::TYPE_BOOL
      struct_name2 = "Bool"
    elsif first_type2 == type_constants::TYPE_STRING
      struct_name2 = "String"
    end
    if str_byte_len(struct_name2) > 0
      # Only save receiver type for user-defined types (not primitives from untyped params)
      if typecheck::tc_is_struct_type(first_type2) or first_type2 == type_constants::TYPE_ENUM
        ufcs_receiver_type = struct_name2
      end
      var dollar_pos = __char_index(struct_name2, '$')
      if dollar_pos >= 0
        struct_name2 = str_byte_slice(struct_name2, dollar_pos + 1, str_byte_len(struct_name2))
      end
      # Strip generic params: "Vec<Int>" → "Vec" for method lookup
      var lt_pos = __char_index(struct_name2, '<')
      if lt_pos > 0
        struct_name2 = str_byte_slice(struct_name2, 0, lt_pos)
      end
      var mangled2 = tc_mangle(tc, struct_name2, func_name)
      var mangled_type = typecheck_builtins::tc_lookup_builtin(tc, mangled2)
      if mangled_type == type_constants::TYPE_ERROR
        mangled_type = typecheck_registry::tc_lookup_function_return(tc, mangled2)
      end
      if mangled_type != type_constants::TYPE_ERROR
        fn_type = mangled_type
        func_name = mangled2
        ast::ast_set_str1(ast_storage, callee_node, mangled2)
      end
    end
  end

  # Item 2d: hard type error (QZ0406) for Option/Result-exclusive methods on a
  # non-Option/Result receiver. Names like `unwrap`/`is_some`/`unwrap_or` are
  # only meaningful on Option<T>/Result<T,E>. On any other receiver they used to
  # be silently accepted: `unwrap`/`unwrap_or`/`expect` fall through to the
  # registered TYPE_INT builtin, and `is_some`/`is_none`/`is_ok`/`is_err`/
  # `unwrap_err` fall through to the generic stdlib free function via open UFCS
  # (line ~3388). Either way the receiver's word 0 is then read as an Option
  # niche / boxed payload → garbage ("unwrap on None") or SIGSEGV (e.g. a
  # Vec<Int> element read as a pointer). Reject at typecheck instead.
  #
  # Fires ONLY when ALL hold: dot-call syntax; the name is in the exclusive set;
  # no struct-method rewrite won (a winning `Struct$method` mangles `$` into
  # func_name at line ~3277); the receiver resolves to a CONCRETE type name that
  # is provably neither Option nor Result; and no user-defined UFCS/impl/extend
  # method of that name exists on the receiver type. This is deliberately
  # conservative: `tc_base_kind` alone is NOT a reliable Option/Result signal
  # (an Option/Result value frequently presents as a bare TYPE_ENUM), so the
  # decision is driven by the receiver's resolved type-annotation NAME, and the
  # gate stays silent whenever the receiver name can't be pinned down — that
  # preserves the exact prior behavior for anything ambiguous (no valid program
  # is newly rejected). `map`/`and_then` are excluded — shared with Vec/HOF.
  if is_ufcs == 1 and arg_count > 0 and __char_index(func_name, '$') < 0
    var _2d_excl = match func_name
      "unwrap" => true
      "unwrap_or" => true
      "unwrap_err" => true
      "expect" => true
      "is_some" => true
      "is_none" => true
      "is_ok" => true
      "is_err" => true
      _ => false
    end
    if _2d_excl
      if _fa_cache_computed == 0
        _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        _fa_cache_computed = 1
      end
      var _2d_recv_kind = typecheck::tc_base_kind(tc, _fa_cache_type)
      # Inline-call receiver fast-skip: when the receiver is itself a call whose
      # callee is a function/builtin REGISTERED to return Option/Result (e.g.
      # `stack.pop()` → vec_pop:Option, `map_get(...)` → Option), the receiver IS
      # an Option/Result even though its computed type frequently collapses to
      # the unwrapped inner kind (TYPE_INT) when the container's element type is
      # unresolved — precisely brainfuck's `stack.pop().unwrap()` /
      # `map_get(jump_table, k).unwrap()`. The registered return type is the same
      # single-source-of-truth signal the legitimate `.unwrap()` builtin path
      # rides on, so the gate must honor it and stay silent. Uses the callee's
      # (post-UFCS-rewrite) name — the inner call was already type-checked by the
      # tc_expr(args[0]) above, so any `push`→`vec_pop` rewrite has landed.
      var _2d_recv_is_opt_res_call = false
      if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_CALL
        var _2d_inner_callee = ast::ast_get_left(ast_storage, args[0])
        if ast::ast_get_kind(ast_storage, _2d_inner_callee) == node_constants::NODE_IDENT
          var _2d_inner_name = ast::ast_get_str1(ast_storage, _2d_inner_callee)
          if str_byte_len(_2d_inner_name) > 0
            var _2d_inner_ret = typecheck_builtins::tc_lookup_builtin(tc, _2d_inner_name)
            if _2d_inner_ret == type_constants::TYPE_ERROR
              _2d_inner_ret = typecheck_registry::tc_lookup_function_return(tc, _2d_inner_name)
            end
            var _2d_inner_base = typecheck::tc_base_kind(tc, _2d_inner_ret)
            if _2d_inner_base == type_constants::TYPE_OPTION or _2d_inner_base == type_constants::TYPE_RESULT
              _2d_recv_is_opt_res_call = true
            end
          end
        end
      end
      # base_kind fast-skip: an already-canonical Option/Result ptype.
      if _2d_recv_kind != type_constants::TYPE_OPTION and _2d_recv_kind != type_constants::TYPE_RESULT and _2d_recv_is_opt_res_call == false
        # Resolve the receiver's concrete type NAME (annotation-first — it is the
        # only reliable Option/Result discriminator; base_kind loses it).
        var _2d_recv_name = ""
        if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_IDENT
          _2d_recv_name = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, args[0]))
          if str_byte_len(_2d_recv_name) == 0
            _2d_recv_name = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, args[0]))
          end
        end
        if str_byte_len(_2d_recv_name) == 0
          _2d_recv_name = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, args[0])
        end
        if str_byte_len(_2d_recv_name) == 0
          _2d_recv_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[0])
        end
        # Name-resolution fallback for receivers that carry no annotation (e.g. a
        # bare `x = 5` Int literal). ONLY for base kinds that can NEVER be an
        # Option/Result — deliberately excluding TYPE_ENUM and bare TYPE_STRUCT,
        # which an Option/Result value can collapse into (keeping those in the
        # conservative "unresolved ⇒ skip" bucket so no valid program breaks).
        if str_byte_len(_2d_recv_name) == 0
          if _2d_recv_kind == type_constants::TYPE_INT
            _2d_recv_name = "Int"
          elsif _2d_recv_kind == type_constants::TYPE_BOOL
            _2d_recv_name = "Bool"
          elsif _2d_recv_kind == type_constants::TYPE_F64
            _2d_recv_name = "F64"
          elsif _2d_recv_kind == type_constants::TYPE_STRING
            _2d_recv_name = "String"
          elsif _2d_recv_kind == type_constants::TYPE_BYTE
            _2d_recv_name = "Byte"
          elsif _2d_recv_kind == type_constants::TYPE_VEC
            _2d_recv_name = "Vec"
          elsif _2d_recv_kind == type_constants::TYPE_MAP
            _2d_recv_name = "Map"
          elsif _2d_recv_kind == type_constants::TYPE_SET
            _2d_recv_name = "Set"
          elsif _2d_recv_kind == type_constants::TYPE_SLICE
            _2d_recv_name = "Slice"
          elsif _2d_recv_kind == type_constants::TYPE_SLICE_MUT
            _2d_recv_name = "SliceMut"
          elsif _2d_recv_kind == type_constants::TYPE_STRINGBUILDER
            _2d_recv_name = "StringBuilder"
          elsif _2d_recv_kind == type_constants::TYPE_CHANNEL
            _2d_recv_name = "Channel"
          elsif _2d_recv_kind == type_constants::TYPE_RANGE
            _2d_recv_name = "Range"
          end
        end
        # Strip a leading `Module$` qualifier ONLY when it precedes the type
        # head (i.e. the `$` comes before any `<`). A `$` that appears inside
        # `Option<mod$Inner>` is the INNER type's module qualifier and must be
        # left intact — stripping it would corrupt the name and defeat the
        # Option/Result check below.
        var _2d_bare = _2d_recv_name
        var _2d_dp = __char_index(_2d_bare, '$')
        var _2d_lt0 = __char_index(_2d_bare, '<')
        if _2d_dp >= 0 and (_2d_lt0 < 0 or _2d_dp < _2d_lt0)
          _2d_bare = str_byte_slice(_2d_bare, _2d_dp + 1, str_byte_len(_2d_bare))
        end
        # NEVER error on Option/Result — recognize them by name even when the
        # value's base kind collapsed to a bare enum (the byte-identical guard).
        var _2d_is_opt_res = _2d_bare == "Option" or _2d_bare == "Result" or _2d_bare.starts_with("Option<") or _2d_bare.starts_with("Result<")
        # Only proceed when we have POSITIVE, concrete evidence of the receiver
        # type. An empty/unresolvable name preserves the prior fallthrough.
        if str_byte_len(_2d_bare) > 0 and _2d_is_opt_res == false
          # Bare type name for the user-method mangle (strip `<...>`).
          var _2d_lookup_name = _2d_bare
          var _2d_lt = __char_index(_2d_lookup_name, '<')
          if _2d_lt > 0
            _2d_lookup_name = str_byte_slice(_2d_lookup_name, 0, _2d_lt)
          end
          var _2d_has_user_method = false
          var _2d_mangled = tc_mangle(tc, _2d_lookup_name, func_name)
          # An impl/extend method on the receiver's type is registered as a
          # func-alias ("Type$method" → "module$Type$method") by the resolver;
          # a plain UFCS free function or a same-name builtin registers under
          # the mangled/return-type registries. Any of these means a genuine
          # user-defined method exists and must take priority over this gate.
          if str_byte_len(compiler_types::ct_func_alias_lookup(_2d_mangled)) > 0
            _2d_has_user_method = true
          elsif typecheck_builtins::tc_lookup_builtin(tc, _2d_mangled) != type_constants::TYPE_ERROR
            _2d_has_user_method = true
          elsif typecheck_registry::tc_lookup_function_return(tc, _2d_mangled) != type_constants::TYPE_ERROR
            _2d_has_user_method = true
          end
          if _2d_has_user_method == false
            typecheck_diag::tc_diag_error_at(ast_storage, callee_node, "QZ0406: `.#{func_name}()` is only valid on Option or Result, not `#{_2d_bare}`")
            return type_constants::TYPE_ERROR
          end
        end
      end
    end
  end

  # Fn-field call detection: if UFCS failed and first arg's struct has a
  # Fn-typed field matching func_name, rewrite as field-access indirect call.
  # obj.f(args) was desugared to CALL(IDENT("f"), [obj, args...]).
  # Rewrite to: CALL(FIELD_ACCESS(obj, "f"), [args...]) so MIR can emit indirect call.
  # Look up struct name directly from first arg (self-contained).
  # IMPORTANT: return immediately after rewrite — tc_expr may be called again
  # on this node, and the rewritten AST needs the FIELD_ACCESS handler above.
  if fn_type == type_constants::TYPE_ERROR and is_ufcs == 1 and arg_count > 0
    var fn_recv = args[0]
    if _fa_cache_computed == 0
      _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, fn_recv)
      _fa_cache_computed = 1
    end
    var fn_recv_type = _fa_cache_type
    if typecheck::tc_is_struct_type(fn_recv_type)
      var fn_recv_kind = ast::ast_get_kind(ast_storage, fn_recv)
      if fn_recv_kind == node_constants::NODE_IDENT
        var fn_recv_sname = typecheck_util::tc_scope_lookup_struct_name(tc, ast::ast_get_str1(ast_storage, fn_recv))
        if str_byte_len(fn_recv_sname) > 0
          ufcs_receiver_type = fn_recv_sname
          var fn_field_struct_result = typecheck_registry::tc_lookup_struct(tc, fn_recv_sname)
          var fn_field_idx = match fn_field_struct_result
            Found(v) => v
            NotFound => -1
          end
          if fn_field_idx >= 0
            var fn_field_ann = typecheck::tc_struct_field_annotation(tc, fn_field_idx, func_name)
            # HB-DOG.3(c): resolve aliases so a struct field typed by
            # `type X = Fn(...)` parses as a Fn-call site too. Without this,
            # `obj.field(args)` falls through to method lookup and errors
            # with "Type 'Struct' has no method 'field'".
            if typecheck::_tc_is_fn_ann(tc, fn_field_ann)
              # Fn-typed field found — get return type from annotation
              var fn_field_ret = typecheck::tc_fn_annotation_return_type(tc, fn_field_ann)
              # Type check the actual arguments (skip first arg which is the receiver)
              for fi in 1..arg_count
                typecheck_walk::tc_expr(tc, ast_storage, args[fi])
              end
              # Rewrite AST: change callee from IDENT to FIELD_ACCESS on receiver
              var receiver_node = args[0]
              var fa_node = ast::ast_field_access(ast_storage, receiver_node, func_name, line, col)
              ast::ast_set_left(ast_storage, node, fa_node)
              # Remove receiver from args, keep only actual call arguments
              var new_args = vec_new()
              for ni in 1..arg_count
                new_args.push(args[ni])
              end
              ast::ast_set_children(ast_storage, node, new_args)
              # Return immediately — the rewritten AST will be handled by
              # the FIELD_ACCESS callee handler at the top if tc_expr re-enters.
              return fn_field_ret
            end
          end
        end
      end
    end
  end

  # Fallback: parser treats Uppercase.method() as associated function (Name$method),
  # but if Name is actually a bound variable (not a type), rewrite as UFCS.
  # Also: if Name is a module name (not a variable), it's a module-qualified call —
  # don't confuse it with UFCS on a variable that happens to share the module name.
  if fn_type == type_constants::TYPE_ERROR and is_ufcs == 0
    var dollar_idx = __char_index(func_name, '$')
    if dollar_idx > 0
      var prefix = str_byte_slice(func_name, 0, dollar_idx)
      var method = str_byte_slice(func_name, dollar_idx + 1, str_byte_len(func_name))
      var prefix_type = typecheck_util::tc_scope_lookup(tc, prefix)
      if prefix_type != type_constants::TYPE_ERROR
        # prefix is a bound variable — rewrite as UFCS and recurse
        ast::ast_set_str1(ast_storage, callee_node, method)
        var recv_node = ast::ast_ident(ast_storage, prefix, line, col)
        var new_args = vec_new()
        new_args.push(recv_node)
        for ufcs_i in 0..arg_count
          new_args.push(args[ufcs_i])
        end
        ast::ast_set_children(ast_storage, node, new_args)
        ast::ast_call_set_is_ufcs(ast_storage, node, 1)
        # CMP-PARSER-FAIL-FAST: cap UFCS rewrite recursion at 32. Legitimate
        # rewrites are 1-3 levels; anything deeper is a method-resolution
        # loop (typically triggered by an unresolved name like `it` falling
        # into open UFCS lookup repeatedly). Without this cap the typechecker
        # would consume 18+ GB of RAM before being killed.
        if tc.call_rewrite_depth > 32
          error("QZ0205: method resolution exceeded recursion depth 32 while rewriting '#{func_name}' (likely an unresolved identifier in a UFCS chain — please file as a bug if the call looks legitimate)", line, col)
          return type_constants::TYPE_ERROR
        end
        tc.call_rewrite_depth = tc.call_rewrite_depth + 1
        var rec_result = tc_expr_call(tc, ast_storage, node, line, col)
        tc.call_rewrite_depth = tc.call_rewrite_depth - 1
        return rec_result
      end
      # If prefix is a module name (not a variable), this is a module-qualified call.
      # The function wasn't found in the module — report that specifically.
      if resolver::resolve_is_module_name(prefix)
        error("Module '#{prefix}' has no function '#{method}'", line, col)
        return type_constants::TYPE_ERROR
      end
    end
  end

  # Open UFCS: any function f(x, ...) callable as x.f(...)
  # This is the last-resort fallback — builtin UFCS, Type$method, and Fn-field
  # all take precedence. Only fires for dot-call syntax (is_ufcs == 1).
  if fn_type == type_constants::TYPE_ERROR and is_ufcs == 1
    var open_type = typecheck_registry::tc_lookup_function_return(tc, func_name)
    if open_type == type_constants::TYPE_ERROR
      open_type = typecheck_builtins::tc_lookup_builtin(tc, func_name)
    end
    if open_type != type_constants::TYPE_ERROR
      fn_type = open_type
    end
  end

  if fn_type == type_constants::TYPE_ERROR
    var suggestion = typecheck_registry::tc_suggest_identifier(tc, func_name)
    if is_ufcs == 1 and str_byte_len(ufcs_receiver_type) > 0
      # Prefer a receiver-type-scoped method suggestion (clean method name)
      # over the generic-identifier one (which would surface the internal
      # mangled `Type$method` form). Fall back to `suggestion` when no method
      # on the receiver type is a close match.
      var method_suggestion = typecheck_registry::tc_suggest_method(tc, ufcs_receiver_type, func_name)
      if str_byte_len(method_suggestion) > 0
        suggestion = method_suggestion
      end
      typecheck_diag::tc_diag_error_at(ast_storage, callee_node, "Type '#{ufcs_receiver_type}' has no method '#{func_name}'#{suggestion}")
    else
      typecheck_diag::tc_diag_error_at(ast_storage, callee_node, "Undefined function: #{func_name}#{suggestion}")
    end
    result = type_constants::TYPE_ERROR
  else
    # Check argument count (with default args support). Mirror the
    # builtin-vs-registry priority from the type lookup above: when the
    # builtin won the type, take arity from the builtin too. Without this,
    # the registry's arity shadows even though the builtin's type already
    # won, surfacing as a spurious QZ0200 on a name like `send`. Path A —
    # see feedback_channel_send_vs_ws2_send_name_clash.md.
    var param_count = -1
    var required_count = -1
    if _fn_type_from_builtin == 1
      var _bp_min = typecheck_builtins::tc_lookup_builtin_min_arity(tc, func_name)
      var _bp_max = typecheck_builtins::tc_lookup_builtin_max_arity(tc, func_name)
      if _bp_min >= 0 and _bp_max >= 0
        required_count = _bp_min
        param_count = _bp_max
      end
      # else: builtin without explicit arity — leave (-1, -1) and let the
      # fall-through below skip the count check (existing behavior).
    else
      param_count = typecheck_registry::tc_function_param_count(tc, func_name)
      required_count = typecheck_registry::tc_function_required_count(tc, func_name)
    end

    if param_count < 0
      # Not a named function - check if it's a lambda variable
      var binding_param_count = typecheck_util::tc_scope_lookup_param_count(tc, func_name)
      if binding_param_count >= 0
        # It's a lambda variable - use its param count
        param_count = binding_param_count
        required_count = binding_param_count
      else
        # Builtin - check for explicit arity bounds
        var builtin_min = typecheck_builtins::tc_lookup_builtin_min_arity(tc, func_name)
        var builtin_max = typecheck_builtins::tc_lookup_builtin_max_arity(tc, func_name)
        if builtin_min >= 0 and builtin_max >= 0
          # Has explicit arity - use it
          required_count = builtin_min
          param_count = builtin_max
        else
          # No named function, no lambda, no builtin arity — check if this is
          # a non-callable scope binding (e.g. x = 5; x(42))
          if typecheck::tc_type_is_function(tc, fn_type) == false
            var nf_fn_ret = typecheck_registry::tc_lookup_function_return(tc, func_name)
            var nf_builtin = typecheck_builtins::tc_lookup_builtin(tc, func_name)
            if nf_fn_ret == type_constants::TYPE_ERROR and nf_builtin == type_constants::TYPE_ERROR
              error("Cannot call '#{func_name}': not a function", line, col)
              result = type_constants::TYPE_ERROR
            end
          end
          # No explicit arity - skip count check
          param_count = arg_count
          required_count = arg_count
        end
      end
    end

    if required_count < 0
      # No required_count found, all params are required
      required_count = param_count
    end

    # === Named argument reordering ===
    var call_arg_names_raw = ast::ast_call_get_arg_names(ast_storage, node)
    if call_arg_names_raw != 0 and param_count > 0
      var func_idx = typecheck_registry::tc_lookup_function_index(tc, func_name)
      var param_names_str = ""
      if func_idx >= 0
        param_names_str = typecheck_registry::tc_function_param_names(tc, func_idx)
      end
      if str_byte_len(param_names_str) == 0
        error("Named arguments not supported for '#{func_name}'", line, col)
        result = type_constants::TYPE_ERROR
      else
        var param_names = str_split(param_names_str, ",")
        var na_count = vec_size(call_arg_names_raw)

        # Count positional args (leading "" entries in arg_names)
        var positional_count = 0
        var found_named = 0
        for na_i in 0..na_count
          var na_name = call_arg_names_raw[na_i]
          if found_named == 0 and str_byte_len(as_string(na_name)) == 0
            positional_count = na_i + 1
          else
            found_named = 1
          end
        end

        # Build reordered children: size = param_count
        var reordered = vec_new()
        var filled = vec_new()
        var default_mask = 0
        for ri in 0..param_count
          reordered.push(0)
          filled.push(0)
        end

        # Fill positional args into slots 0..positional_count
        for pi in 0..positional_count
          if pi < param_count
            reordered[pi] = args[pi]
            filled[pi] = 1
          end
        end

        # Fill named args
        var na_error = 0
        for ni in positional_count..na_count
          var na_name = as_string(call_arg_names_raw[ni])
          var param_idx = -1
          for pni in 0..param_count
            if as_string(param_names[pni]).eq(na_name)
              param_idx = pni
            end
          end
          if param_idx < 0
            error("Unknown parameter name '#{na_name}' in call to '#{func_name}'", line, col)
            na_error = 1
          elsif filled[param_idx] == 1
            if param_idx < positional_count
              error("Parameter '#{na_name}' already filled by positional argument in call to '#{func_name}'", line, col)
            else
              error("Duplicate named argument '#{na_name}' in call to '#{func_name}'", line, col)
            end
            na_error = 1
          else
            reordered[param_idx] = args[ni]
            filled[param_idx] = 1
          end
        end

        # Check unfilled slots — must have defaults
        if na_error == 0
          var func_ast_info = typecheck_registry::tc_function_ast_info(tc, func_idx)
          for ci in 0..param_count
            if filled[ci] == 0
              if func_ast_info.is_some()
                var fai = func_ast_info.unwrap()
                var f_ast_store: ast::AstStorage = as_type<ast::AstStorage>(fai[0])
                var f_handle = fai[1]
                var f_params = ast::ast_get_left(f_ast_store, f_handle)
                var f_param = f_params[ci]
                var f_default = ast::ast_param_default_value(f_ast_store, f_param)
                if f_default >= 0
                  default_mask = default_mask | (1 << ci)
                else
                  var missing_name = as_string(param_names[ci])
                  error("Missing required argument '#{missing_name}' in call to '#{func_name}'", line, col)
                  na_error = 1
                end
              else
                var missing_name = as_string(param_names[ci])
                error("Missing required argument '#{missing_name}' in call to '#{func_name}'", line, col)
                na_error = 1
              end
            end
          end
        end

        if na_error == 0
          # Replace children with reordered args
          ast::ast_set_children(ast_storage, node, reordered)
          ast::ast_call_set_arg_names(ast_storage, node, 0)
          if default_mask != 0
            ast::ast_call_set_default_mask(ast_storage, node, default_mask)
          end
          args = reordered
          arg_count = param_count
        end
      end
    end

    # Arity overload resolution: if arg_count doesn't match this overload,
    # try to find another overload of the same function with matching arity
    var arity_ok = 1
    if arg_count < required_count or arg_count > param_count
      var overload_idx = typecheck_registry::tc_find_matching_overload(tc, func_name, arg_count)
      if overload_idx >= 0
        # Found a matching overload - update param_count and required_count
        param_count = typecheck_registry::tc_overload_param_count(tc.registry.func_param_types, overload_idx)
        var ov_rc = tc.registry.func_required_counts[overload_idx]
        if ov_rc < 0
          required_count = param_count
        else
          required_count = ov_rc
        end
      else
        # Extend/impl static method called without the implicit `self`
        # receiver — the registry injected a leading `self` the static
        # callsite omits (e.g. Box$make(42) where the registry counts
        # self+x but the call passes only x). Accept by dropping one param.
        #
        # This adjustment MUST be gated on the function's first registered
        # param actually being `self`. The `$` is also present in every
        # module-qualified call (`module$func`), so the old condition
        # (`__char_index(func_name, '$') > 0`) silently accepted any
        # cross-module call short by exactly one arg, leaving the trailing
        # parameter slot uninitialized → runtime SIGSEGV (A.40 —
        # qzmod_load_spec called the 6-param qzmod_load_module with 5 args).
        var self_omitted = 0
        if arg_count == required_count - 1 and __char_index(func_name, '$') > 0
          var arity_fi = typecheck_registry::tc_lookup_function_index(tc, func_name)
          if arity_fi >= 0
            var arity_pnames = typecheck_registry::tc_function_param_names(tc, arity_fi)
            if arity_pnames == "self" or arity_pnames.starts_with("self,")
              self_omitted = 1
            end
          end
        end
        if self_omitted == 1
          arity_ok = 1
          required_count -= 1
          param_count -= 1
        else
          arity_ok = 0
        end
      end
    end

    if arity_ok == 0 and arg_count < required_count
      # A3: for a fixed-arity function (no optional/default params) say
      # "requires N arguments" — "at least N" is misleading and implies
      # variadic/default params. Reserve "at least" for the genuine
      # optional-param case (required_count < param_count). Append the
      # reconstructed signature as a `|SIG|`-delimited note tail; the
      # central diagnostic loop (typecheck_util::tc_emit_diagnostics)
      # splits it into a real `= note:`.
      var arity_sig = typecheck_registry::tc_build_signature_note(tc, func_name)
      var arity_word = "at least "
      if required_count == param_count
        arity_word = ""
      end
      var arity_msg = "Function #{func_name} requires #{arity_word}#{required_count} arguments, got #{arg_count}"
      if str_byte_len(arity_sig) > 0
        arity_msg += " |SIG|#{arity_sig}"
      end
      error(arity_msg, line, col)
      result = type_constants::TYPE_ERROR
    elsif arity_ok == 0 and arg_count > param_count
      var arity_sig2 = typecheck_registry::tc_build_signature_note(tc, func_name)
      var arity_msg2 = "Function #{func_name} accepts at most #{param_count} arguments, got #{arg_count}"
      if str_byte_len(arity_sig2) > 0
        arity_msg2 += " |SIG|#{arity_sig2}"
      end
      error(arity_msg2, line, col)
      result = type_constants::TYPE_ERROR
    else
      # FIX.6 Phase 2: Bidirectional closure parameter inference
      # Before TC'ing args, inject expected param types into lambda AST nodes.
      # This enables `items.map(x -> x * 2)` without requiring `x: Int`.
      var fn_anns_pre = typecheck_registry::tc_lookup_function_param_fn_ann(tc, func_name)
      if fn_anns_pre != 0
        var fn_anns_pre_len = vec_size(fn_anns_pre)
        for pre_ai in 0..arg_count
          if pre_ai < fn_anns_pre_len
            var pre_fn_val = vec_get(fn_anns_pre, pre_ai)
            if pre_fn_val != 0
              var pre_fn_ann = as_string(pre_fn_val)
              if str_byte_len(pre_fn_ann) > 0
                var pre_arg = args[pre_ai]
                if ast::ast_get_kind(ast_storage, pre_arg) == node_constants::NODE_LAMBDA
                  var lam_params = ast::ast_get_left(ast_storage, pre_arg)
                  if lam_params > 0
                    var lam_pc = vec_size(lam_params)
                    for lpi in 0..lam_pc
                      var lp_node = lam_params[lpi]
                      var lp_existing = ast::ast_get_str2(ast_storage, lp_node)
                      if str_byte_len(lp_existing) == 0
                        # No annotation — infer from expected Fn type.
                        # HB-DOG.3(b): the helper transparently resolves
                        # `type X = Fn(...)` aliases, so bidir inference now
                        # fires for alias-typed callee params (e.g.
                        # `def apply(f: Mapper, ...)` where `type Mapper = Fn(Int): Int`).
                        var exp_param_str = typecheck::tc_fn_annotation_nth_param_str(tc, pre_fn_ann, lpi)
                        if str_byte_len(exp_param_str) > 0
                          ast::ast_set_str2(ast_storage, lp_node, exp_param_str)
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end

      # Route to_str(f64/f32) to the f64_to_str free function (Dragon4
      # shortest-round-trip formatter in std/fmt/float). Covers `to_str(f)`,
      # `#{f}` (interpolation desugars to to_str), and `puts(f)` (the puts
      # coercion below wraps in to_str, which then reaches here). Concat-
      # coercion and `f.to_s()` already route to f64_to_str via mir.
      if func_name == "to_str" and arg_count == 1
        var f2s_arg_type = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        if f2s_arg_type == type_constants::TYPE_F64 or f2s_arg_type == type_constants::TYPE_F32
          ast::ast_set_str1(ast_storage, callee_node, "f64_to_str")
          func_name = "f64_to_str"
        end
      end

      # Auto-coerce puts/eputs arguments to String via to_str()
      if (func_name == "puts" or func_name == "eputs") and arg_count >= 1
        var puts_arg = args[0]
        var puts_arg_type = typecheck_walk::tc_expr(tc, ast_storage, puts_arg)
        var puts_base = typecheck::tc_base_kind(tc, puts_arg_type)
        # QZ0211: same trap as `#{opt}` interpolation — `puts(opt)` would
        # auto-coerce via to_str() and print the heap-box address.
        if puts_base == type_constants::TYPE_OPTION
          var puts_full = typecheck::tc_type_name_full(tc, puts_arg_type)
          error("QZ0211: Cannot puts(#{puts_full}) directly — runtime would print the heap-box address. Unwrap with `.unwrap_or(default)`, pattern-match, or interpolate the unwrapped value.", line, col)
        elsif puts_base == type_constants::TYPE_RESULT
          var puts_full2 = typecheck::tc_type_name_full(tc, puts_arg_type)
          error("QZ0211: Cannot puts(#{puts_full2}) directly — runtime would print the heap-box address. Unwrap with `.unwrap_or(default)`, pattern-match, or interpolate the unwrapped value.", line, col)
        end
        if puts_base != type_constants::TYPE_STRING
          # Wrap arg with to_str() call — same mechanism as string interpolation
          var ts_ident = ast::ast_ident(ast_storage, "to_str", line, col)
          var ts_args = [puts_arg]
          var ts_call = ast::ast_call(ast_storage, ts_ident, ts_args, line, col)
          args[0] = ts_call
          ast::ast_set_children(ast_storage, node, args)
          typecheck_walk::tc_expr(tc, ast_storage, ts_call)
        end
        # Type-check remaining args (e.g., newline flag)
        for pa_i in 1..arg_count
          typecheck_walk::tc_expr(tc, ast_storage, args[pa_i])
        end
      else
      # PSQ-6 / Sched effect (2026-04-30): when a builtin requires its
      # first-arg callback to declare `can <Effect>` (today: `Sched`) and
      # the caller passed an inline NODE_LAMBDA, the call-site IDENT check
      # at line ~3290 doesn't apply. Walk the lambda body under the same
      # Sync discipline that named `can Sched` functions get in tc_function:
      # set tc.in_sched_min_depth one above the call's scope so captures
      # and globals trip QZ1408 from inside the lambda body. Save+restore
      # handles re-entry from a parent that's already in a Sched frame.
      var saved_sched_min_depth_lam = tc.in_sched_min_depth
      var cb_eff_lam = typecheck_builtins::tc_lookup_builtin_callback_effect(tc, func_name)
      if str_byte_len(cb_eff_lam) > 0 and arg_count > 0
        if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_LAMBDA
          tc.in_sched_min_depth = typecheck_util::tc_get_depth(tc) + 1
        end
      end
      # Type check arguments (skip default-mask positions — those are sentinels)
      var tc_default_mask = ast::ast_call_get_default_mask(ast_storage, node)
      for tc_ai in 0..arg_count
        if tc_default_mask == 0 or ((tc_default_mask >> tc_ai) & 1) == 0
          typecheck_walk::tc_expr(tc, ast_storage, args[tc_ai])
        end
      end
      tc.in_sched_min_depth = saved_sched_min_depth_lam
      end

      # Release ephemeral borrows — summary-aware (T3c.2 Phase 3)
      # Look up callee's borrow summary to decide which borrows to release.
      var callee_summary_opt = typecheck_registry::tc_lookup_borrow_summary(tc, func_name)
      var callee_escape_mask = 0
      var callee_return_src = -2
      var callee_return_kind = 0
      if callee_summary_opt is Some
        var callee_summary = callee_summary_opt.unwrap()
        callee_escape_mask = callee_summary.escape_mask
        callee_return_src = callee_summary.return_borrow_source
        callee_return_kind = callee_summary.return_borrow_kind
      end

      # Clear any stale pending return borrow
      typecheck_util::tc_pending_borrow_clear()

      for ri in 0..arg_count
        var rarg = args[ri]
        if ast::ast_get_kind(ast_storage, rarg) == node_constants::NODE_FUNC_REF
          var bname = ast::ast_get_str1(ast_storage, rarg)
          var bm = ast::ast_get_int_val(ast_storage, rarg)
          var bidx = typecheck_util::tc_lookup_binding_index(tc, bname)
          if bidx >= 0
            # Check if this param's borrow escapes (summary-aware)
            var escapes = false
            if callee_escape_mask != 0
              if (callee_escape_mask >> ri) & 1 == 1
                escapes = true
              end
            end

            if escapes
              # QZ1220: Borrow escapes — keep active, don't release
              error("QZ1220: Borrow of '#{bname}' escapes through '#{func_name}'", line, col)
            else
              # Safe — release borrow (same as current ephemeral release)
              if bm == 1
                tc.safety.binding_borrow_states[bidx] = 0
              else
                var sc = tc.safety.binding_shared_borrow_counts[bidx]
                if sc > 0
                  tc.safety.binding_shared_borrow_counts[bidx] = sc - 1
                  if sc - 1 == 0
                    tc.safety.binding_borrow_states[bidx] = 0
                  end
                end
              end
            end

            # Set pending return borrow if return borrows from this param
            if callee_return_kind > 0 and callee_return_src == ri
              typecheck_util::tc_pending_borrow_clear()
              typecheck_util::tc_pending_borrow_set(as_int(bname), callee_return_kind)
            end
          end
        end
      end

      # Validate lambda arity against expected Fn type
      var fn_anns_raw = typecheck_registry::tc_lookup_function_param_fn_ann(tc, func_name)
      if fn_anns_raw != 0
        var fn_anns_len = vec_size(fn_anns_raw)
        for ai in 0..arg_count
          if ai < fn_anns_len
            var fn_ann_val = vec_get(fn_anns_raw, ai)
            if fn_ann_val != 0
              var fn_ann = as_string(fn_ann_val)
              if str_byte_len(fn_ann) > 0
                # This parameter expects a Fn type — check if arg is a lambda
                var arg_node2 = args[ai]
                var arg_kind2 = ast::ast_get_kind(ast_storage, arg_node2)
                if arg_kind2 == node_constants::NODE_LAMBDA
                  var lambda_params = ast::ast_get_left(ast_storage, arg_node2)
                  var lambda_pc = 0
                  if lambda_params > 0
                    lambda_pc = vec_size(lambda_params)
                  end
                  # HB-DOG.3(a): the parameter may be typed by a `type X =
                  # Fn(...)` alias. tc_fn_annotation_param_count only
                  # understands literal `Fn(...)` strings — a bare alias
                  # name yields 0, mis-reporting "expects 0". Resolve the
                  # alias first (mirrors the lambda-param-bind path above).
                  var fn_aliased = typecheck::tc_lookup_type_alias(tc, fn_ann)
                  if str_byte_len(fn_aliased) > 0
                    fn_ann = fn_aliased
                  end
                  var expected_pc = typecheck::tc_fn_annotation_param_count(tc, fn_ann)
                  if lambda_pc != expected_pc
                    var arg_line = ast::ast_get_line(ast_storage, arg_node2)
                    var arg_col = ast::ast_get_col(ast_storage, arg_node2)
                    error("Lambda has #{lambda_pc} parameter(s) but #{fn_ann} expects #{expected_pc}", arg_line, arg_col)
                    result = type_constants::TYPE_ERROR
                  else
                    # Validate lambda parameter types against expected Fn param types
                    if lambda_params > 0
                      for pi in 0..lambda_pc
                        var lp = lambda_params[pi]
                        var lp_ann = ast::ast_get_str2(ast_storage, lp)
                        if str_byte_len(lp_ann) > 0
                          var lp_type = typecheck::tc_parse_type(tc, lp_ann)
                          var exp_str = typecheck::tc_fn_annotation_nth_param_str(tc, fn_ann, pi)
                          if str_byte_len(exp_str) > 0
                            var exp_type = typecheck::tc_parse_type(tc, exp_str)
                            # Skip check when expected type is a type variable (T, U, etc.)
                            # — resolves to TYPE_ERROR, which should unify with any concrete type
                            if exp_type != type_constants::TYPE_ERROR
                              if lp_type != exp_type
                                var pl = ast::ast_get_line(ast_storage, arg_node2)
                                var pc2 = ast::ast_get_col(ast_storage, arg_node2)
                                error("Lambda parameter type mismatch: expected #{exp_str} but got #{lp_ann}", pl, pc2)
                                result = type_constants::TYPE_ERROR
                              end
                            end
                          end
                        end
                      end
                    end
                    # Validate lambda return type against expected Fn return type
                    # Skip when expected is Void (any body is fine) or Never/Unknown
                    var exp_ret = typecheck::tc_fn_annotation_return_type(tc, fn_ann)
                    var lbt = tc.scope.last_lambda_body_type
                    if exp_ret > 0 and exp_ret != type_constants::TYPE_VOID and exp_ret != type_constants::TYPE_ERROR and exp_ret != type_constants::TYPE_NEVER
                      if lbt > 0 and lbt != type_constants::TYPE_ERROR and lbt != type_constants::TYPE_NEVER and lbt != type_constants::TYPE_VOID
                        if lbt != exp_ret
                          var rl = ast::ast_get_line(ast_storage, arg_node2)
                          var rc = ast::ast_get_col(ast_storage, arg_node2)
                          error("Lambda return type mismatch: expected #{typecheck::tc_type_name_full(tc, exp_ret)} but got #{typecheck::tc_type_name_full(tc, lbt)}", rl, rc)
                          result = type_constants::TYPE_ERROR
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end

      # Effect bound enforcement (CONC.9): check function args against Fn type effect bounds
      if fn_anns_raw != 0
        var eb_anns_len = vec_size(fn_anns_raw)
        for ebi in 0..arg_count
          if ebi < eb_anns_len
            var eb_ann_val = vec_get(fn_anns_raw, ebi)
            if eb_ann_val != 0
              var eb_ann = as_string(eb_ann_val)
              # Check if this parameter has an effect bound
              if eb_ann.ends_with(" @pure")
                # Parameter requires @pure — check if argument function has @pure annotation
                var eb_arg = args[ebi]
                var eb_kind = ast::ast_get_kind(ast_storage, eb_arg)
                if eb_kind == node_constants::NODE_IDENT
                  var eb_name = ast::ast_get_str1(ast_storage, eb_arg)
                  # Look up function's effect annotation
                  var eb_fidx = typecheck_registry::tc_lookup_function_index(tc, eb_name)
                  if eb_fidx >= 0
                    var eb_func_node = tc.registry.func_ast_handles[eb_fidx]
                    var eb_func_store: ast::AstStorage = as_type<ast::AstStorage>(tc.registry.func_ast_stores[eb_fidx])
                    if as_int(eb_func_store) != 0 and eb_func_node >= 0
                      var eb_eff = ast::ast_func_get_effect_annotation(eb_func_store, eb_func_node)
                      # 256 = EFFECT_ANNOTATED_PURE
                      if (eb_eff & 256) == 0
                        var eb_line = ast::ast_get_line(ast_storage, eb_arg)
                        var eb_col = ast::ast_get_col(ast_storage, eb_arg)
                        error("QZ1406: Function '#{eb_name}' passed to @pure parameter but is not annotated @pure", eb_line, eb_col)
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end

      # PSQ-6 / Sched effect (2026-04-30): builtins like `sched_idle_hook_set`
      # register a "first-arg callback must declare `can <Effect>`"
      # requirement via `tc_register_builtin_with_callback_effect`. When the
      # caller passes a NODE_IDENT, look up the target's effect row and
      # emit QZ1408 if the required label is absent. NODE_LAMBDA is handled
      # via `tc.in_sched_min_depth` body-walk earlier; here we cover named
      # functions AND Fn-typed locals (Phase A.5b item 1, 2026-05-01) — the
      # binding's type annotation carries the `can` clause when written as
      # `var f: Fn(): Void can Sched = ...`.
      var cb_eff = typecheck_builtins::tc_lookup_builtin_callback_effect(tc, func_name)
      if str_byte_len(cb_eff) > 0 and arg_count > 0
        var cb_arg = args[0]
        var cb_kind = ast::ast_get_kind(ast_storage, cb_arg)
        if cb_kind == node_constants::NODE_IDENT
          var cb_name = ast::ast_get_str1(ast_storage, cb_arg)
          var cb_fidx = typecheck_registry::tc_lookup_function_index(tc, cb_name)
          var cb_handled = 0
          if cb_fidx >= 0
            var cb_row = typecheck_registry::tc_get_func_effect_row(tc, cb_fidx)
            var cb_has_eff = 0
            if cb_row >= 0
              var cb_labels = typecheck_registry::tc_row_get_labels(tc, cb_row)
              var cb_target_id = string_intern::intern_id(tc.interner, cb_eff)
              for cb_li in 0..cb_labels.size
                if cb_labels[cb_li] == cb_target_id
                  cb_has_eff = 1
                end
              end
            end
            if cb_has_eff == 0
              var cb_line = ast::ast_get_line(ast_storage, cb_arg)
              var cb_col = ast::ast_get_col(ast_storage, cb_arg)
              error("QZ1408: function '#{cb_name}' passed to '#{func_name}' must declare 'can #{cb_eff}'; foreign-thread callback context — see std/sched.qz", cb_line, cb_col)
            end
            cb_handled = 1
          end
          # Fn-typed local fallback: if the name didn't resolve to a function
          # in the registry, it may be a `var f: Fn(...): T can <E> = ...`
          # binding. The parser stores the full type string (including the
          # `can` suffix) as the binding's type annotation. Read it and
          # check the can clause.
          if cb_handled == 0
            var cb_ann_raw = typecheck_util::tc_scope_lookup_annotation(tc, cb_name)
            # HB-DOG.3(c): resolve `type X = Fn(...)` aliases so callback-
            # effect checking works for aliased Fn-typed bindings too.
            var cb_ann = typecheck::_tc_resolve_fn_ann(tc, cb_ann_raw)
            if str_byte_len(cb_ann) >= 3 and cb_ann.starts_with("Fn(")
              var cb_can_idx = typecheck::_tc_find_last_can_marker(cb_ann)
              var cb_local_has_eff = 0
              if cb_can_idx >= 0
                # Substring after the " can" marker (4 bytes).
                var cb_suffix = str_trim(str_byte_slice(cb_ann, cb_can_idx + 4, str_byte_len(cb_ann)))
                # Single-label and tail-only forms supported by the parser
                # (parser.qz:798-816). For "Label | tail" the label is what
                # matters for the bound effect; tail-only means the row is
                # open and the binding satisfies any required label.
                var cb_pipe = __char_index(cb_suffix, '|')
                var cb_label_part = cb_suffix
                var cb_tail_part = ""
                if cb_pipe >= 0
                  cb_label_part = str_trim(str_byte_slice(cb_suffix, 0, cb_pipe))
                  cb_tail_part = str_trim(str_byte_slice(cb_suffix, cb_pipe + 1, str_byte_len(cb_suffix)))
                end
                if str_byte_len(cb_label_part) > 0 and cb_label_part == cb_eff
                  cb_local_has_eff = 1
                end
                # Tail-only open row (no closed label) — caller's row could
                # be any effect set, so accept conservatively. Closed empty
                # row (`can` with nothing after) does NOT satisfy the bound.
                if cb_local_has_eff == 0 and str_byte_len(cb_label_part) == 0 and str_byte_len(cb_tail_part) > 0
                  cb_local_has_eff = 1
                end
              end
              if cb_local_has_eff == 0
                var cb_line2 = ast::ast_get_line(ast_storage, cb_arg)
                var cb_col2 = ast::ast_get_col(ast_storage, cb_arg)
                error("QZ1408: Fn-typed local '#{cb_name}' passed to '#{func_name}' must declare 'can #{cb_eff}' in its type annotation; foreign-thread callback context — see std/sched.qz", cb_line2, cb_col2)
              end
            end
          end
        end
      end

      # Tier 4 #24 Phase 4b §2.1: Vec<T> → Slice<T> auto-coerce at call sites.
      # When a function declares `s: Slice<T>` and the caller passes a Vec<T>,
      # rewrite the arg in-place to `slice(arg, 0, -1)`. Re-typechecking the new
      # slice() call fires the Phase 3 borrow registration automatically.
      var ac_expected_params_opt = typecheck_registry::tc_lookup_function_params(tc, func_name)
      if ac_expected_params_opt.is_some()
        var ac_expected_params = ac_expected_params_opt.unwrap()
        var ac_ep_len = vec_size(ac_expected_params)
        for ac_ni in 0..arg_count
          if ac_ni < ac_ep_len
            var ac_expected_t = vec_get(ac_expected_params, ac_ni)
            var ac_expected_base = typecheck::tc_base_kind(tc, ac_expected_t)
            if ac_expected_base == type_constants::TYPE_SLICE or ac_expected_base == type_constants::TYPE_SLICE_MUT
              var ac_arg_nd = args[ac_ni]
              var ac_actual_t = typecheck_walk::tc_expr(tc, ast_storage, ac_arg_nd)
              var ac_actual_base = typecheck::tc_base_kind(tc, ac_actual_t)
              # Tier 4 #24 Phase 4b §2.2: String → Slice<Byte> auto-coerce.
              # When caller passes String and fn expects Slice<Byte>, wrap
              # the arg in str_as_byte_slice(arg) — zero-copy byte view.
              if ac_actual_base == type_constants::TYPE_STRING
                var ac_exp_bye = 0
                if typecheck::tc_is_ptype(ac_expected_t)
                  ac_exp_bye = typecheck::tc_ptype_arg1(tc, ac_expected_t)
                end
                if ac_exp_bye == type_constants::TYPE_BYTE
                  var ac_bs_line = ast::ast_get_line(ast_storage, ac_arg_nd)
                  var ac_bs_col = ast::ast_get_col(ast_storage, ac_arg_nd)
                  var ac_bs_args = vec_new()
                  ac_bs_args.push(ac_arg_nd)
                  var ac_bs_ident = ast::ast_ident(ast_storage, "str_as_byte_slice", ac_bs_line, ac_bs_col)
                  var ac_bs_call = ast::ast_call(ast_storage, ac_bs_ident, ac_bs_args, ac_bs_line, ac_bs_col)
                  args[ac_ni] = ac_bs_call
                  ast::ast_set_children(ast_storage, node, args)
                  typecheck_walk::tc_expr(tc, ast_storage, ac_bs_call)
                end
              end
              if ac_actual_base == type_constants::TYPE_VEC
                var ac_exp_elem = 0
                if typecheck::tc_is_ptype(ac_expected_t)
                  ac_exp_elem = typecheck::tc_ptype_arg1(tc, ac_expected_t)
                end
                var ac_act_elem = 0
                if typecheck::tc_is_ptype(ac_actual_t)
                  ac_act_elem = typecheck::tc_ptype_arg1(tc, ac_actual_t)
                end
                # Permit coercion when element types match, or when either side
                # is unparameterized (bare TYPE_VEC with 0 elem, or Slice<T> where
                # T hasn't resolved yet).
                var ac_elem_ok = false
                if ac_exp_elem == ac_act_elem
                  ac_elem_ok = true
                end
                if ac_exp_elem == 0 or ac_act_elem == 0
                  ac_elem_ok = true
                end
                if ac_elem_ok
                  var ac_line = ast::ast_get_line(ast_storage, ac_arg_nd)
                  var ac_col = ast::ast_get_col(ast_storage, ac_arg_nd)
                  # Synthesize end = vec_size(arg). Reuses arg_nd as the vec_size
                  # argument — idempotent for plain IDENT receivers.
                  var ac_vs_args = vec_new()
                  ac_vs_args.push(ac_arg_nd)
                  var ac_vs_ident = ast::ast_ident(ast_storage, "vec_size", ac_line, ac_col)
                  var ac_vs_call = ast::ast_call(ast_storage, ac_vs_ident, ac_vs_args, ac_line, ac_col)
                  var ac_zero = ast::ast_int_lit(ast_storage, 0, ac_line, ac_col)
                  var ac_sargs = vec_new()
                  ac_sargs.push(ac_arg_nd)
                  ac_sargs.push(ac_zero)
                  ac_sargs.push(ac_vs_call)
                  var ac_sident = ast::ast_ident(ast_storage, "slice", ac_line, ac_col)
                  var ac_scall = ast::ast_call(ast_storage, ac_sident, ac_sargs, ac_line, ac_col)
                  args[ac_ni] = ac_scall
                  ast::ast_set_children(ast_storage, node, args)
                  typecheck_walk::tc_expr(tc, ast_storage, ac_scall)
                end
              end
            end
          end
        end
      end

      # Newtype argument validation: check arg types against expected param types.
      # Fires for bare newtypes (existing behavior) AND for any strict-newtype
      # (STRICT_NEWTYPES) regardless of form — bare or ptype. Strict ptype-form
      # newtypes like `Secret<Int>` need this branch to reject `takes_secret(42)`
      # where the caller passed a raw Int; tc_types_match would otherwise be
      # bypassed by the existential-erasure scalar-flow path.
      #
      # STRICT_NEWTYPE_UNWRAP_AT_ARG (2026-05-22): also fires symmetrically when
      # the ACTUAL arg is a strict newtype but the expected param is the wrapped
      # type. Closes `takes_int(some_secret_int_value)` — without this branch the
      # implicit Secret<Int> → Int direction sneaks past the entry condition
      # (which previously only inspected expected_t). Docs:
      # docs/bugs/STRICT_NEWTYPE_UNWRAP_AT_ARG_NOT_REJECTED.md.
      var expected_params_opt = typecheck_registry::tc_lookup_function_params(tc, func_name)
      if expected_params_opt.is_some()
        var expected_params = expected_params_opt.unwrap()
        var ep_len = vec_size(expected_params)
        # QZ0213 (B.15c arg-site) — nil-literal wall on call arguments. Mirror
        # the let/return sites: a syntactic `nil` flowing into a heap/reference
        # parameter is forbidden (`nil` is not a typed value — use Option<T> +
        # None, or keep CPtr at an FFI boundary). Skip default-mask positions
        # (gap sentinels, not user-written args) exactly like the tc_expr loop.
        # Keyed off NodeNilLit so the existential bare-Int gap can't false-fire.
        var argnil_default_mask = ast::ast_call_get_default_mask(ast_storage, node)
        for ni in 0..arg_count
          if ni < ep_len
            var expected_t = vec_get(expected_params, ni)
            # SURF.FLOW Phase 3 soundness — a narrowed bare-ident argument whose
            # value flows WHOLE into a wide Option/Result parameter slot must NOT
            # payload-extract (the callee — e.g. `unwrap_ok(r)` — expects the
            # whole enum word and does its own extraction; a pre-extract here is a
            # double-extract → garbage pointer → SIGSEGV). Same wide-slot pin the
            # let/return/struct-field/assign chokepoints apply, now extended to
            # call arguments. tc_unstamp_narrowed_into_wide only fires on a bare
            # narrowed ident whose OWN declared base equals the param's base, so
            # it is inert for every other arg (purely additive, FLOW_NARROWING §3.3).
            typecheck_walk::tc_unstamp_narrowed_into_wide(tc, ast_storage, args[ni], typecheck_util::tc_narrow_expect_base_of_type(tc, expected_t))
            # GAP-3a-rest (arg-pass, WIDTH+DEPTH): a struct literal passed into a
            # record param arrives as bare TYPE_STRUCT (struct-init erases its
            # nominal id → tc_struct_idx_from_type == -1 → tc_struct_satisfies_record
            # permissively accepts). Recover the nominal id from the arg node so the
            # real record subtyping check runs. Mirrors the return seam
            # (typecheck_walk.qz tc_promote_struct_init_for_record + tc_check_return).
            # No-op unless the arg is a resolvable bare-7 struct literal AND the param
            # is a record; gate-0-inert (compiler/stdlib have zero record params).
            if typecheck_registry::tc_is_record_type(expected_t)
              var rap_arg_ty = typecheck_walk::tc_expr(tc, ast_storage, args[ni])
              var rap_promoted = typecheck_helpers::tc_promote_struct_init_for_record(tc, ast_storage, args[ni], rap_arg_ty, expected_t)
              # R2.4: variable-of-struct arg — a struct-typed VARIABLE arg is also
              # bare-7 (nominal id in binding_struct_names). If the literal promote
              # did not fire, recover the nominal id from the binding name.
              if rap_promoted == rap_arg_ty
                rap_promoted = typecheck_helpers::tc_promote_struct_ident_for_record(tc, ast_storage, args[ni], rap_arg_ty, expected_t)
              end
              # Fire ONLY when promotion recovered a nominal id (arg is a resolvable
              # struct literal into a record). Any unrecoverable / non-struct-init /
              # already-nominal arg leaves rap_promoted == rap_arg_ty → permissive.
              if rap_promoted != rap_arg_ty
                if typecheck_registry::tc_struct_satisfies_record(tc, rap_promoted, expected_t) == 0
                  var rap_line = ast::ast_get_line(ast_storage, args[ni])
                  var rap_col = ast::ast_get_col(ast_storage, args[ni])
                  var rap_exp = typecheck::tc_type_name_full(tc, expected_t)
                  var rap_reason = typecheck_registry::tc_record_mismatch_reason(tc, expected_t, rap_promoted)
                  error("QZ0200: argument struct does not satisfy '#{rap_exp}' — #{rap_reason}", rap_line, rap_col)
                  result = type_constants::TYPE_ERROR
                end
              end
            end
            var argnil_masked = argnil_default_mask != 0 and ((argnil_default_mask >> ni) & 1) == 1
            if argnil_masked == false and ast::ast_get_kind(ast_storage, args[ni]) == node_constants::NODE_NIL_LIT
              # A union with an explicit `Nil` member (`Int | Nil`) is the
              # union-world spelling of nullable — `nil` is a legal inhabitant
              # there, so it is not walled.
              if typecheck_helpers::tc_nil_forbidden_type(tc, expected_t) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_t) == 0
                var argnil_line = ast::ast_get_line(ast_storage, args[ni])
                var argnil_col = ast::ast_get_col(ast_storage, args[ni])
                error("`nil` is not a value here (parameter type `#{typecheck::tc_type_name(expected_t)}`). Use `Option<#{typecheck::tc_type_name(expected_t)}>` and `None`, or — at an FFI boundary — keep it as `CPtr`. (QZ0213)", argnil_line, argnil_col)
              end
            end
            # QZ0214 (N3.1 audit) — bare int-literal passed into a boxed param
            # (the existential `0`-sentinel). Default-off WARNING (QZ_N3_AUDIT)
            # for the migration worklist; no behavior/IR change.
            if argnil_masked == false and ast::ast_get_kind(ast_storage, args[ni]) == node_constants::NODE_INT_LIT
              if typecheck_helpers::tc_nil_forbidden_type(tc, expected_t) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_t) == 0
                if typecheck_helpers::tc_n3_wall_warn_enabled()
                  if typecheck_helpers::tc_n3_wall_is_error(tc)
                    error("QZ0214: bare int-literal passed into boxed param `#{typecheck::tc_type_name(expected_t)}` — the existential 0-sentinel is forbidden here; use `Option<T>` + `None`, or a real value", ast::ast_get_line(ast_storage, args[ni]), ast::ast_get_col(ast_storage, args[ni]))
                  else
                    warn("QZ0214 (N3.1 audit): bare int-literal passed into boxed param `#{typecheck::tc_type_name(expected_t)}` — existential 0-sentinel; migrate to Option<T>+None or a real value", ast::ast_get_line(ast_storage, args[ni]), ast::ast_get_col(ast_storage, args[ni]))
                  end
                end
              end
            end
            # QZ0215 (N3.1 step-4 audit) — the Int-VARIABLE / erased-boxed-value
            # case at the call-arg position: a non-literal, non-nil argument whose
            # resolved type is bare TYPE_INT passed into a boxed parameter. Under
            # the existential model this is EITHER a real Int-var sentinel OR an
            # erased-boxed value de-existentialization must give a real type —
            # both go on the step-4 worklist. Default-off WARNING (env-gated so
            # the extra tc_expr never runs in production); no behavior/IR change.
            if argnil_masked == false and typecheck_helpers::tc_n3_wall_warn_enabled() and typecheck_helpers::tc_n3_is_bridge_name(func_name) == false and typecheck_helpers::tc_n3_file_exempt(tc) == false
              var arg_kind_215 = ast::ast_get_kind(ast_storage, args[ni])
              if arg_kind_215 != node_constants::NODE_INT_LIT and arg_kind_215 != node_constants::NODE_NIL_LIT
                if typecheck_helpers::tc_nil_forbidden_type(tc, expected_t) == 1 and typecheck_registry::tc_union_contains_nil(tc, expected_t) == 0
                  var arg_ty_215 = typecheck_walk::tc_expr(tc, ast_storage, args[ni])
                  if arg_ty_215 == type_constants::TYPE_INT
                    if typecheck_helpers::tc_n3_wall_is_error(tc)
                      error("QZ0215: Int-typed value passed into boxed param `#{typecheck::tc_type_name(expected_t)}` — the existential erased-value/Int-var sentinel is forbidden here; de-existentialize the source or pass `Option<T>`", ast::ast_get_line(ast_storage, args[ni]), ast::ast_get_col(ast_storage, args[ni]))
                    else
                      warn("QZ0215 (N3.1 step-4 audit): Int-typed value passed into boxed param `#{typecheck::tc_type_name(expected_t)}` — existential erased-value/Int-var sentinel; de-existentialize or migrate to Option", ast::ast_get_line(ast_storage, args[ni]), ast::ast_get_col(ast_storage, args[ni]))
                    end
                  end
                end
              end
            end
            # R2.3 arg-type soundness — positive-flag scalar mismatch (QZ0201).
            # User-function call sites previously did NOT type-check most args, so
            # `add("hello", 3)` (String→Int) and `add(3, 3.0)` (Int→Float) compiled
            # silently. This flags ONLY definite String↔numeric and Int↔Float
            # mismatches (see tc_assign_scalar_mismatch): sentinels / type-vars /
            # erased generics permit, newtypes unwrap on both sides, and every
            # non-scalar pun (Int↔handle, Bool↔Int, nominal↔nominal) is permitted.
            # Skip default-mask positions (gap sentinels) as the tc_expr loop does.
            #
            # NICHE-ERASURE CARVE-OUT (mirrors 5cff669a's assign-side fix): a
            # niche-erased `Option<String>` payload — `Some(s)` match-binding or
            # an `opt ?? "d"` result — is ABI-compatible with String but statically
            # typed `TYPE_INT` by the typechecker. Flagging `String_param ←
            # Int_arg` there is a FALSE POSITIVE. Route through
            # tc_assign_scalar_mismatch, which flags that erasure-prone direction
            # ONLY when the arg is a genuine int literal (which can't be an erased
            # String payload); every other definite scalar mismatch — String↔numeric
            # with a String/literal side, and Int↔Float (no erased Float exists) —
            # is still flagged unconditionally, so `add("hello", 3)` still errors.
            if argnil_masked == false and typecheck_registry::tc_param_is_erased_generic(tc, func_name, ni) == false
              var r23_actual_t = typecheck_walk::tc_expr(tc, ast_storage, args[ni])
              var r23_rk = ast::ast_get_kind(ast_storage, args[ni])
              if typecheck::tc_assign_scalar_mismatch(tc, expected_t, r23_actual_t, r23_rk == node_constants::NODE_INT_LIT, r23_rk == node_constants::NODE_STRING_LIT, r23_rk == node_constants::NODE_FLOAT_LIT) == 1
                var r23_line = ast::ast_get_line(ast_storage, args[ni])
                var r23_col = ast::ast_get_col(ast_storage, args[ni])
                var r23_exp = typecheck::tc_type_name_full(tc, expected_t)
                var r23_act = typecheck::tc_type_name_full(tc, r23_actual_t)
                error("Type mismatch: argument #{ni + 1} of '#{func_name}' expected '#{r23_exp}' but got '#{r23_act}' — Int and Float need an explicit conversion (QZ0201)", r23_line, r23_col)
                result = type_constants::TYPE_ERROR
              end
            end
            if typecheck::tc_is_newtype(expected_t) or typecheck::tc_is_strict_newtype(tc, expected_t)
              var arg_nd = args[ni]
              var actual_t = typecheck_walk::tc_expr(tc, ast_storage, arg_nd)
              if typecheck::tc_types_match(tc, actual_t, expected_t) == false
                var nt_line = ast::ast_get_line(ast_storage, arg_nd)
                var nt_col = ast::ast_get_col(ast_storage, arg_nd)
                var expected_name = typecheck::tc_type_name_full(tc, expected_t)
                var actual_name = typecheck::tc_type_name_full(tc, actual_t)
                error("Type mismatch: expected '#{expected_name}', got '#{actual_name}'", nt_line, nt_col)
                result = type_constants::TYPE_ERROR
              end
            else
              # STRICT_NEWTYPE_UNWRAP_AT_ARG — asymmetric direction. Expected is
              # loose (e.g. raw `Int`); if the caller passed a strict newtype
              # value, reject the implicit unwrap. The expected-side branch
              # above doesn't run, but the scalar-flow path would otherwise
              # admit `Secret<Int>` where `Int` is expected.
              var u_arg_nd = args[ni]
              var u_actual_t = typecheck_walk::tc_expr(tc, ast_storage, u_arg_nd)
              if typecheck::tc_is_strict_newtype(tc, u_actual_t)
                if typecheck::tc_types_match(tc, u_actual_t, expected_t) == false
                  var u_line = ast::ast_get_line(ast_storage, u_arg_nd)
                  var u_col = ast::ast_get_col(ast_storage, u_arg_nd)
                  var u_expected_name = typecheck::tc_type_name_full(tc, expected_t)
                  var u_actual_name = typecheck::tc_type_name_full(tc, u_actual_t)
                  error("Type mismatch: expected '#{u_expected_name}', got '#{u_actual_name}'", u_line, u_col)
                  result = type_constants::TYPE_ERROR
                end
              end
            end
          end
        end
      end

      # Validate trait bounds at call site
      var tb_func_idx = typecheck_registry::tc_lookup_function_index(tc, func_name)
      if tb_func_idx >= 0
        typecheck_registry::tc_validate_trait_bounds(tc, func_name, tb_func_idx, args, ast_storage, line, col)
      end

      # Get return type
      result = typecheck_registry::tc_lookup_function_return(tc, func_name)
      if result == type_constants::TYPE_ERROR
        result = typecheck_builtins::tc_lookup_builtin(tc, func_name)
      end
      # A.45 ii (L1) — a DIRECT `vec_get(v, i)` / `vec_get_unchecked(v, i)` call is
      # registered as bare TYPE_INT, erasing the element type. When `v` carries a
      # tracked element ptype (`Vec<SomeStruct>`), refine the result to the ELEMENT
      # type, exactly as index syntax `v[i]` does (tc_expr_index → tc_ptype_arg1).
      # Without this, `vec_get(v, i).field` has no tracked struct receiver and the
      # MIR field-offset resolution falls to the GLOBAL field-name table, picking
      # the wrong offset on a cross-struct field-name collision ⇒ heap corruption.
      # Conservative/additive: Vec<Int> refines to Int (== the prior value); a bare
      # TYPE_VEC receiver with no ptype (untyped vec_new, or a cross-function
      # module-global) keeps TYPE_INT unchanged — that erased L2 case is out of
      # scope.
      if (func_name == "vec_get" or func_name == "vec_get_unchecked") and result == type_constants::TYPE_INT and arg_count >= 1
        var vg_recv_t = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        if typecheck::tc_base_kind(tc, vg_recv_t) == type_constants::TYPE_VEC and typecheck::tc_is_ptype(vg_recv_t)
          var vg_elem_t = typecheck::tc_ptype_arg1(tc, vg_recv_t)
          if vg_elem_t > 0 and vg_elem_t != type_constants::TYPE_ERROR
            result = vg_elem_t
          end
        end
      end
      # F4 (item 9b-find) — `v.find { pred }` is registered as bare TYPE_INT with a
      # `0` NOT-FOUND SENTINEL (an existential bare-T return). For a VALUE-LAYOUT
      # `@value` element S, item 23 made `Option<@value-S>` fully consumable
      # (`Some(found)` inlines S's fields into the niche box; `.unwrap()` returns
      # `&box[word1]`), so find can return a REAL `Option<S>` instead of the lossy
      # sentinel. Refine the result from bare TYPE_INT to the `Option<S>` ptype when
      # the SOURCE element is a value-layout struct, so `r = v.find{…}` types `r` as
      # `Option<S>` → the LET back-stamp (typecheck_walk) writes str2="Option<S>" →
      # the MIR LET handler marks `r`'s var-type → `r.some?`/`r.unwrap().field`
      # resolve as a real Option (the codegen find handler builds the agreeing box).
      # The source element name comes from the receiver ptype (push / vec_new source)
      # or, for a literal-built source typing to bare TYPE_ARRAY, from the receiver
      # IDENT's `Vec<S>` annotation. GATED on a value-layout struct element ⇒
      # reference structs / `Vec<Int>` keep the EXACT bare TYPE_INT sentinel result
      # (byte-identical), and gate-0-dead (the compiler's own `.find` calls — which
      # rely on the sentinel ABI — are over non-`@value` Vecs ⇒ this never fires).
      if func_name == "find" and result == type_constants::TYPE_INT and arg_count >= 1
        var fd_elem_name = ""
        var fd_recv_t = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        if typecheck::tc_base_kind(tc, fd_recv_t) == type_constants::TYPE_VEC and typecheck::tc_is_ptype(fd_recv_t)
          fd_elem_name = typecheck::tc_ptype_name(tc, fd_recv_t)
        end
        if str_byte_len(fd_elem_name) == 0
          if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_IDENT
            var fd_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, args[0]))
            if str_byte_len(fd_ann) > 0 and fd_ann.starts_with("Vec<")
              fd_elem_name = typecheck::tc_extract_element_type(fd_ann)
            end
          end
        end

        if str_byte_len(fd_elem_name) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, fd_elem_name) == 1
          # Parse the `Option<S>` annotation string directly so the refined ptype is
          # IDENTICAL (interned) to the one an explicit `r: Option<S>` annotation
          # yields — the form item-23's inline-unwrap intercept already handles. (A
          # hand-built `tc_make_ptype(TYPE_OPTION, elem, struct_idx)` would mis-place
          # struct_idx as a SECOND type arg → `Option<S, …>`, breaking payload
          # recovery.)
          var fd_opt = typecheck::tc_parse_type(tc, "Option<#{fd_elem_name}>")
          if fd_opt != type_constants::TYPE_ERROR
            result = fd_opt
          end
        end
      end
      # F4 (item 50) — `v.first()` / `v.last()` are registered as bare TYPE_INT
      # (hardcoded `Vec<Int>`). Over a VALUE-LAYOUT `@value` element S they return
      # the element WORD as an Int; a consumer `.field` then `inttoptr`s that inline
      # value as a struct pointer → SEGV (a reference-struct Vec works by luck: the
      # word IS a pointer). Refine the result from bare TYPE_INT to the concrete
      # element struct type S (NOT Option — first/last panic-on-empty, like vec_get,
      # returning T directly). The codegen first/last handler then reads the element
      # interior BY ADDRESS for inline value-layout elements (mirroring vec_get), and
      # the LET back-stamp (typecheck_walk) writes str2=S so the MIR LET handler marks
      # the binding struct-typed → `f.field` resolves against S's layout. The source
      # element name comes from the receiver ptype or, for a literal-built source
      # typing bare TYPE_ARRAY, the receiver IDENT's `Vec<S>` annotation. GATED on a
      # value-layout struct element ⇒ reference structs / `Vec<Int>` keep the EXACT
      # bare TYPE_INT result (byte-identical), and gate-0-dead (the compiler's own
      # first/last calls are over non-`@value` Vecs ⇒ this never fires).
      if (func_name == "first" or func_name == "last") and result == type_constants::TYPE_INT and arg_count >= 1
        var fl_elem_name = ""
        var fl_recv_t = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        if typecheck::tc_base_kind(tc, fl_recv_t) == type_constants::TYPE_VEC and typecheck::tc_is_ptype(fl_recv_t)
          fl_elem_name = typecheck::tc_ptype_name(tc, fl_recv_t)
        end
        if str_byte_len(fl_elem_name) == 0
          if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_IDENT
            var fl_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, args[0]))
            if str_byte_len(fl_ann) > 0 and fl_ann.starts_with("Vec<")
              fl_elem_name = typecheck::tc_extract_element_type(fl_ann)
            end
          end
        end

        if str_byte_len(fl_elem_name) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, fl_elem_name) == 1
          var fl_elem_t = typecheck::tc_parse_type(tc, fl_elem_name)
          if fl_elem_t != type_constants::TYPE_ERROR
            result = fl_elem_t
          end
        end
      end
      # F4 (item 9f) — element-preserving HOFs (filter/take/drop/sorted/reversed)
      # are registered as the bare TYPE_VEC, ERASING the element type. So a
      # `hi = v.filter { it.a > 0 }` BINDING types to bare Vec, the LET back-stamp
      # never produces a `Vec<S>` annotation, and the MIR LET handler never
      # registers `hi`'s element type. A later `hi[i].field` then has no tracked
      # struct receiver → falls to the GLOBAL untyped-i64 field path, which SKIPS
      # the cow +1 refcount-shift (>16B @value) / typed-GEP byte-pack (narrow
      # @value) → every field read one word low / mis-packed (push- AND
      # literal-built sources alike; 9b laid the result vec out correctly, 9e
      # fixed the literal SOURCE, this fixes the result BINDING). Fix: when the
      # SOURCE element is a value-layout struct, refine the result from bare
      # TYPE_VEC to the SAME `Vec<S>` ptype the receiver carries — the result of
      # these HOFs preserves the element type. That makes `init_type` a ptype, so
      # the existing LET ptype back-stamp emits `Vec<S>` and MIR registers the
      # binding's element type (→ index / for-in / nested-HOF reads route to the
      # value layout). The receiver element name comes from its ptype (push /
      # vec_new source) or, for a literal-built source whose receiver types to
      # bare TYPE_ARRAY, from the receiver IDENT's `Vec<S>` annotation (the 9e
      # back-stamp). GATED on a value-layout struct element ⇒ reference structs /
      # `Vec<Int>` keep the EXACT bare TYPE_VEC result (byte-identical), and
      # gate-0-dead (the compiler has zero @value Vec HOFs).
      if result == type_constants::TYPE_VEC and arg_count >= 1
        if func_name == "filter" or func_name == "take" or func_name == "drop" or func_name == "sorted" or func_name == "reversed"
          var hr_elem_name = ""
          var hr_recv_t = typecheck_walk::tc_expr(tc, ast_storage, args[0])
          if typecheck::tc_base_kind(tc, hr_recv_t) == type_constants::TYPE_VEC and typecheck::tc_is_ptype(hr_recv_t)
            hr_elem_name = typecheck::tc_ptype_name(tc, hr_recv_t)
          end
          if str_byte_len(hr_elem_name) == 0
            if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_IDENT
              var hr_ann = typecheck_util::tc_scope_lookup_annotation(tc, ast::ast_get_str1(ast_storage, args[0]))
              if str_byte_len(hr_ann) > 0 and hr_ann.starts_with("Vec<")
                hr_elem_name = typecheck::tc_extract_element_type(hr_ann)
              end
            end
          end
          if str_byte_len(hr_elem_name) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, hr_elem_name) == 1
            var hr_elem_t = typecheck::tc_parse_type(tc, hr_elem_name)
            if hr_elem_t != type_constants::TYPE_ERROR
              var hr_struct_idx = 0
              var hr_sr = typecheck_registry::tc_lookup_struct(tc, hr_elem_name)
              if hr_sr.is_found()
                hr_struct_idx = hr_sr.unwrap() + 1
              end
              var hr_ptype = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, hr_elem_t, hr_struct_idx)
              if hr_struct_idx > 0
                typecheck::tc_ptype_set_name(tc, hr_ptype, hr_elem_name)
              end
              result = hr_ptype
            end
          end
        end
        # F4 (item 9g) — `map` with a TRANSFORMING closure. Unlike the
        # element-preserving HOFs above, `map`'s result element type is the
        # CLOSURE's RETURN type, not the source element type — so the 9f
        # source-element refinement deliberately skips map. When the closure
        # returns a value-layout struct `RetTy`, refine map's bare TYPE_VEC
        # result to `Vec<RetTy>` so the LET back-stamp (typecheck_walk 9f) and
        # the MIR `Vec<` registration carry the binding's element provenance →
        # `m[i].field` / `for x in m` route through the cow +1 / narrow typed-GEP
        # layout instead of the untyped-i64 path. Covers a named-fn arg
        # (`v.map(bump)`), an arrow (`s -> bump(s)`), and an inline `{…it…}`
        # whose return type is inferred. GATED on a value-layout RetTy ⇒
        # reference-layout / `Vec<Int>` map binds keep the EXACT bare TYPE_VEC
        # result (byte-identical), and gate-0-dead (zero @value Vec.map callsites
        # in the compiler's own source).
        if func_name == "map"
          var mr_ret_name = tc_map_closure_return_struct_name(tc, ast_storage, args, arg_count)
          if str_byte_len(mr_ret_name) > 0 and typecheck_registry::tc_is_value_layout_struct_name(tc, mr_ret_name) == 1
            var mr_elem_t = typecheck::tc_parse_type(tc, mr_ret_name)
            if mr_elem_t != type_constants::TYPE_ERROR
              var mr_struct_idx = 0
              var mr_sr = typecheck_registry::tc_lookup_struct(tc, mr_ret_name)
              if mr_sr.is_found()
                mr_struct_idx = mr_sr.unwrap() + 1
              end
              var mr_ptype = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, mr_elem_t, mr_struct_idx)
              if mr_struct_idx > 0
                typecheck::tc_ptype_set_name(tc, mr_ptype, mr_ret_name)
              end
              result = mr_ptype
            end
          end
        end
      end
      # B.10 §14 N3.2 follow-up #2 — `option_some(x)` is registered as the bare
      # `TYPE_OPTION`, ERASING the payload type. For an UN-annotated local
      # `var f = option_some(closure)` that erasure means `f.unwrap()` narrows to
      # nothing callable (QZ0200 "not a function"). Mirror the `nonzero_new`
      # precedent (49d76070): carry the CONCRETE payload through as `Option<P>`,
      # where P is the argument's inferred type, so `.unwrap()`'s payload
      # narrowing recovers P and the recovered closure is callable. Pre-existing,
      # representation-independent inference fix (no niche dependency).
      #
      # Restricted to SIGNATURE-CARRYING Fn-ptype payloads on purpose. Two
      # reasons: (1) callability — only a Fn payload with its `Fn(...): R`
      # signature lets `.unwrap()` narrow back to a callable; bare `TYPE_FUNCTION`
      # (a signature-less named-`def` reference) carries no signature, so refining
      # it to `Option<Function>` neither restores callability NOR matches a
      # concrete `Option<Fn(...)>` element/return slot — it would REGRESS
      # `Vec<Option<Fn(...)>>.push(option_some(bare_def))` and stdlib returns that
      # rely on the bare-`Option` looseness. (2) Refining every payload to a
      # concrete `Option<P>` would similarly tighten numeric matching
      # (`def f(): Option<Int>` returning `option_some(bool_expr)`). The Fn-ptype
      # gate (tc_fn_type_id >= 0) sidesteps both: a signatured closure never
      # participates in that looseness.
      if func_name == "option_some" and result == type_constants::TYPE_OPTION and arg_count >= 1
        var os_arg_t = typecheck_walk::tc_expr(tc, ast_storage, args[0])
        # Item 10 (enum-niche tail): carry the CONCRETE payload (scalar, nominal
        # struct, container, or Fn ptype) so `option_some(42)` yields `Option<Int>`
        # instead of the bare `Option`. Without this the element comparator's
        # bare-vs-ptype escape (tc_elem_type_matches: `actual == tc_ptype_base(
        # expected)`) wrongly accepts `option_some(42)` into a `Vec<Option<String>>`
        # — the payload was erased upstream so the mismatch was invisible. The
        # comparator itself is correct: a concrete `Option<Int>` IS rejected vs
        # `Option<String>` (5a verified this for Fn payloads).
        #
        # `tc_option_some_carries_payload` decides whether `os_arg_t` is a
        # nominally-resolvable concrete type worth refining (see its definition for
        # the full guard rationale). The critical exclusion is BARE aggregate-base
        # constants (`TYPE_STRUCT`/`TYPE_ENUM`/`TYPE_OPTION`/...) — wrapping the
        # existential-collapse `TYPE_STRUCT`(=7) yields an `Option<Struct>` whose
        # inner "Struct" has no nominal identity, which the un-annotated-local
        # niche read path (6.3c) then fails to resolve (`Unknown struct: Struct`).
        # For those payloads the bare `Option` + MIR-side payload recovery is the
        # correct mechanism, so we leave the result loose.
        # `tc_make_ptype` interns, so the refined result equals an annotation-
        # parsed `Option<Int>`; the prior Fn-only gate is subsumed (a Fn ptype is
        # id >= PTYPE_BASE, which passes).
        if tc_option_some_carries_payload(tc, os_arg_t)
          result = typecheck::tc_make_ptype(tc, type_constants::TYPE_OPTION, os_arg_t, 0)
        end
      end
      # Fn-typed variable: extract return type from annotation. (A bound-lambda
      # local with a structured fn type is resolved earlier via the indirect
      # Fn-typed-call path — A.43; this annotation path serves bare-TYPE_FUNCTION
      # Fn params that carry a real annotation.)
      if result == type_constants::TYPE_ERROR and typecheck::tc_type_is_function(tc, fn_type)
        var fn_ann = typecheck_util::tc_scope_lookup_annotation(tc, func_name)
        if str_byte_len(fn_ann) > 0
          result = typecheck::tc_fn_annotation_return_type(tc, fn_ann)
        end
      end

      # Concrete generic instantiation at the call site. When a generic
      # function returns a generic shape (e.g. `def make_g<T>(): G<T>`),
      # the registered return TypeId carries a TYPE_ERROR inner arg
      # because tc_parse_type only recognises trait-level type params, not
      # function-level ones. Concrete annotations like `G<String>` at
      # return-type, struct-field, or var positions then never match the
      # call's TypeId — surfacing as QZ0200 "expected unknown but got
      # unknown" mismatches at every annotated consumer.
      #
      # Two sources of concrete type args:
      #   1. Explicit at the call site: `make_g<String>()` — node carries
      #      the type arg string directly.
      #   2. Inferred from argument types: `make_g(seed)` where seed: T
      #      tells inference that T = type_of(seed). The inference path
      #      already implemented in tc_infer_expr_type_annotation walks
      #      the args and substitutes; we just plumb its output back into
      #      the call's TypeId via tc_parse_type.
      if str_byte_len(func_name) > 0
        var _ci_func_idx = typecheck_registry::tc_lookup_function_index(tc, func_name)
        if _ci_func_idx >= 0
          var _ci_func_tp = typecheck_registry::tc_function_type_params_str(tc, _ci_func_idx)
          if str_byte_len(_ci_func_tp) > 0
            var _ci_ret_ann = typecheck_registry::tc_lookup_function_return_annotation(tc, func_name)
            if str_byte_len(_ci_ret_ann) > 0
              var _ci_call_type_arg = ast::ast_get_type_arg(ast_storage, node)
              var _ci_concrete = _ci_call_type_arg
              if str_byte_len(_ci_concrete) == 0
                # Inference-only call site — derive concrete args from the
                # call's argument types using the same mapper that's already
                # used for inferred annotations elsewhere. Uses the resolved
                # func_idx directly so module-qualified calls work; going
                # through tc_infer_expr_type_annotation would re-resolve the
                # callee from the AST and miss them.
                var _ci_param_anns = typecheck_registry::tc_function_param_annotations(tc, _ci_func_idx)
                var _ci_args_vec = ast::ast_get_children(ast_storage, node)
                if _ci_args_vec != 0
                  _ci_concrete = typecheck_generics::tc_infer_type_param_mapping(tc, ast_storage, _ci_func_tp, _ci_param_anns, _ci_args_vec)
                end
              end
              var _ci_subst = ""
              if str_byte_len(_ci_concrete) > 0
                _ci_subst = typecheck_generics::tc_substitute_annotation(_ci_ret_ann, _ci_func_tp, _ci_concrete)
              end
              if str_byte_len(_ci_subst) > 0 and _ci_subst != _ci_ret_ann
                var _ci_resolved = typecheck::tc_parse_type(tc, _ci_subst)
                if _ci_resolved != type_constants::TYPE_ERROR
                  result = _ci_resolved
                end
              end
            end
          end
        end
      end

      # Tier 4 #24 Phase 4b §2.2: str_as_byte_slice returns Slice<Byte>.
      # Retype the bare TYPE_SLICE from the builtin registry to a proper
      # ptype carrying TYPE_BYTE — the stride tag that downstream UFCS and
      # iteration paths key off to choose byte_slice_get vs slice_get.
      if func_name == "str_as_byte_slice"
        result = typecheck::tc_make_ptype(tc, type_constants::TYPE_SLICE, type_constants::TYPE_BYTE, 0)
      end

      # Propagate element types through parameterized container builtins
      # e.g., vec_get(v, i) where v: Vec<String> → returns String, not Int
      if result != type_constants::TYPE_ERROR
        if result != type_constants::TYPE_ERROR
          if arg_count > 0
            if _fa_cache_computed == 0
              _fa_cache_type = typecheck_walk::tc_expr(tc, ast_storage, args[0])
              _fa_cache_computed = 1
            end
            var recv_type = _fa_cache_type
            if typecheck::tc_is_ptype(recv_type)
              var recv_base = typecheck::tc_base_kind(tc, recv_type)
              if recv_base == type_constants::TYPE_VEC
                if func_name == "vec_get"
                  var elem = typecheck::tc_ptype_arg1(tc, recv_type)
                  # F32 is a storage type; all float arithmetic uses F64,
                  # so promote vec_get return to F64 (codegen does fpext)
                  if elem == type_constants::TYPE_F32
                    result = type_constants::TYPE_F64
                  else
                    result = elem
                  end
                  # Annotate call node with struct/enum name for let binding propagation
                  if typecheck::tc_is_struct_type(elem) or elem == type_constants::TYPE_ENUM
                    var ptype_sname = typecheck::tc_ptype_name(tc, recv_type)
                    if str_byte_len(ptype_sname) > 0
                      ast::ast_set_str2(ast_storage, node, ptype_sname)
                    end
                  end
                end
                if func_name == "vec_pop"
                  var elem2 = typecheck::tc_ptype_arg1(tc, recv_type)
                  if elem2 == type_constants::TYPE_F32
                    result = type_constants::TYPE_F64
                  else
                    result = elem2
                  end
                  if typecheck::tc_is_struct_type(elem2) or elem2 == type_constants::TYPE_ENUM
                    var ptype_sname2 = typecheck::tc_ptype_name(tc, recv_type)
                    if str_byte_len(ptype_sname2) > 0
                      ast::ast_set_str2(ast_storage, node, ptype_sname2)
                    end
                  end
                end
                if func_name == "vec_get_unchecked"
                  var elem3 = typecheck::tc_ptype_arg1(tc, recv_type)
                  if elem3 == type_constants::TYPE_F32
                    result = type_constants::TYPE_F64
                  else
                    result = elem3
                  end
                  if typecheck::tc_is_struct_type(elem3) or elem3 == type_constants::TYPE_ENUM
                    var ptype_sname3 = typecheck::tc_ptype_name(tc, recv_type)
                    if str_byte_len(ptype_sname3) > 0
                      ast::ast_set_str2(ast_storage, node, ptype_sname3)
                    end
                  end
                end
                if func_name == "slice"
                  # Tier 4 #24 Phase 3: slice(v, a, b) returns Slice<T>, not Vec<T>.
                  # Preserve struct/enum tracking for wide-element Vecs.
                  var s_elem = typecheck::tc_ptype_arg1(tc, recv_type)
                  var s_arg2 = typecheck::tc_ptype_arg2(tc, recv_type)
                  result = typecheck::tc_make_ptype(tc, type_constants::TYPE_SLICE, s_elem, s_arg2)
                  if s_arg2 > 0
                    var s_pt_name = typecheck::tc_ptype_name(tc, recv_type)
                    if str_byte_len(s_pt_name) > 0
                      typecheck::tc_ptype_set_name(tc, result, s_pt_name)
                    end
                  end
                  # Borrow the source Vec: mark as shared-borrowed and publish
                  # a pending return-borrow so the enclosing `var s = slice(...)`
                  # binding links back to the source. This is what lets QZ1209
                  # fire when the user mutates the Vec while the slice is live.
                  var s_arg = args[0]
                  if ast::ast_get_kind(ast_storage, s_arg) == node_constants::NODE_IDENT
                    var s_name = ast::ast_get_str1(ast_storage, s_arg)
                    var s_bidx = typecheck_util::tc_lookup_binding_index(tc, s_name)
                    if s_bidx >= 0
                      if tc.safety.binding_borrow_states[s_bidx] == 2
                        error("QZ1206: Conflicting borrows — '#{s_name}' is already mutably borrowed", line, col)
                      else
                        if tc.safety.binding_borrow_states[s_bidx] == 0
                          tc.safety.binding_borrow_states[s_bidx] = 1
                        end
                        tc.safety.binding_shared_borrow_counts[s_bidx] = tc.safety.binding_shared_borrow_counts[s_bidx] + 1
                      end
                      typecheck_util::tc_pending_borrow_clear()
                      typecheck_util::tc_pending_borrow_set(as_int(s_name), 1)
                    end
                  end
                end
              end
              if recv_base == type_constants::TYPE_MAP
                if func_name == "map_get"
                  var val_type = typecheck::tc_ptype_arg2(tc, recv_type)
                  result = typecheck::tc_make_ptype(tc, type_constants::TYPE_OPTION, val_type, 0)
                end
                if func_name == "map_keys"
                  result = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, typecheck::tc_ptype_arg1(tc, recv_type), 0)
                end
                if func_name == "map_values"
                  result = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, typecheck::tc_ptype_arg2(tc, recv_type), 0)
                end
              end

              # Element type checking for container write operations
              # vec_push(v, val) where v: Vec<T> — check val matches T
              if recv_base == type_constants::TYPE_VEC
                if func_name == "vec_push"
                  if arg_count >= 2
                    var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                    var elem_type = typecheck::tc_ptype_arg1(tc, recv_type)
                    # GAP-3a-rest (element-store, WIDTH+DEPTH): a struct literal
                    # pushed into a record-element Vec arrives as bare TYPE_STRUCT
                    # (struct-init erases its nominal id → tc_struct_satisfies_record
                    # permissively accepts via the si<0 fall-through). Recover the
                    # nominal id from args[1] so the real record subtyping check runs,
                    # and emit a dedicated QZ0200 with the field-name reason (the
                    # generic tc_emit_vec_element_error is shape-level only). Mirrors
                    # the call-arg seam (item 1). No-op unless elem is a record AND
                    # the value is a resolvable bare-7 struct literal; gate-0-inert
                    # (compiler/stdlib have zero record-element Vecs).
                    var vp_promoted = typecheck_helpers::tc_promote_struct_init_for_record(tc, ast_storage, args[1], val_type, elem_type)
                    # R2.4: variable-of-struct pushed element — a struct-typed
                    # VARIABLE is bare-7 (nominal id in binding_struct_names). If
                    # the literal promote did not fire, recover from the binding.
                    if vp_promoted == val_type
                      vp_promoted = typecheck_helpers::tc_promote_struct_ident_for_record(tc, ast_storage, args[1], val_type, elem_type)
                    end
                    if vp_promoted != val_type
                      # Promotion recovered a nominal id → run the record check with
                      # the field-name diagnostic instead of the generic vec-element
                      # error. Fires ONLY for a struct literal into a record element.
                      if typecheck_registry::tc_struct_satisfies_record(tc, vp_promoted, elem_type) == 0
                        var vp_line = ast::ast_get_line(ast_storage, args[1])
                        var vp_col = ast::ast_get_col(ast_storage, args[1])
                        var vp_exp = typecheck::tc_type_name_full(tc, elem_type)
                        var vp_reason = typecheck_registry::tc_record_mismatch_reason(tc, elem_type, vp_promoted)
                        error("QZ0200: pushed struct does not satisfy '#{vp_exp}' — #{vp_reason}", vp_line, vp_col)
                        result = type_constants::TYPE_ERROR
                      end
                    else
                      if typecheck::tc_elem_type_matches(tc, val_type, elem_type) == false
                        tc_emit_vec_element_error(tc, ast_storage, args[0], "vec_push", elem_type, val_type, recv_type, line, col)
                      end
                    end
                  end
                end
                if func_name == "vec_set"
                  if arg_count >= 3
                    var val_type2 = typecheck_walk::tc_expr(tc, ast_storage, args[2])
                    var elem_type2 = typecheck::tc_ptype_arg1(tc, recv_type)
                    # GAP-3a-rest (element-store, WIDTH+DEPTH): same recovery as
                    # vec_push above, on the args[2] value node. Emit the field-name
                    # QZ0200 for a struct literal into a record element; otherwise
                    # keep the existing generic vec-element check. Gate-0-inert.
                    var vs_promoted = typecheck_helpers::tc_promote_struct_init_for_record(tc, ast_storage, args[2], val_type2, elem_type2)
                    # R2.4: variable-of-struct assigned element — recover the
                    # nominal id from the binding name if the literal promote missed.
                    if vs_promoted == val_type2
                      vs_promoted = typecheck_helpers::tc_promote_struct_ident_for_record(tc, ast_storage, args[2], val_type2, elem_type2)
                    end
                    if vs_promoted != val_type2
                      if typecheck_registry::tc_struct_satisfies_record(tc, vs_promoted, elem_type2) == 0
                        var vs_line = ast::ast_get_line(ast_storage, args[2])
                        var vs_col = ast::ast_get_col(ast_storage, args[2])
                        var vs_exp = typecheck::tc_type_name_full(tc, elem_type2)
                        var vs_reason = typecheck_registry::tc_record_mismatch_reason(tc, elem_type2, vs_promoted)
                        error("QZ0200: assigned struct does not satisfy '#{vs_exp}' — #{vs_reason}", vs_line, vs_col)
                        result = type_constants::TYPE_ERROR
                      end
                    else
                      if typecheck::tc_elem_type_matches(tc, val_type2, elem_type2) == false
                        tc_emit_vec_element_error(tc, ast_storage, args[0], "vec_set", elem_type2, val_type2, recv_type, line, col)
                      end
                    end
                  end
                end
              end

              # Map element type checking
              if recv_base == type_constants::TYPE_MAP
                var expected_key_type = typecheck::tc_ptype_arg1(tc, recv_type)
                var expected_val_type = typecheck::tc_ptype_arg2(tc, recv_type)
                if func_name == "map_set"
                  if arg_count >= 3
                    var key_type3 = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                    var val_type3 = typecheck_walk::tc_expr(tc, ast_storage, args[2])
                    if typecheck::tc_elem_type_matches(tc, key_type3, expected_key_type) == false
                      error("map_set: expected key type #{typecheck::tc_type_name_full(tc, expected_key_type)}, got #{typecheck::tc_type_name_full(tc, key_type3)}", line, col)
                    end
                    if typecheck::tc_elem_type_matches(tc, val_type3, expected_val_type) == false
                      error("map_set: expected value type #{typecheck::tc_type_name_full(tc, expected_val_type)}, got #{typecheck::tc_type_name_full(tc, val_type3)}", line, col)
                    end
                  end
                end
                if func_name == "map_get"
                  if arg_count >= 2
                    var key_type4 = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                    if typecheck::tc_elem_type_matches(tc, key_type4, expected_key_type) == false
                      error("map_get: expected key type #{typecheck::tc_type_name_full(tc, expected_key_type)}, got #{typecheck::tc_type_name_full(tc, key_type4)}", line, col)
                    end
                  end
                end
                if func_name == "map_has"
                  if arg_count >= 2
                    var key_type5 = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                    if typecheck::tc_elem_type_matches(tc, key_type5, expected_key_type) == false
                      error("map_has: expected key type #{typecheck::tc_type_name_full(tc, expected_key_type)}, got #{typecheck::tc_type_name_full(tc, key_type5)}", line, col)
                    end
                  end
                end
                if func_name == "map_delete"
                  if arg_count >= 2
                    var key_type6 = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                    if typecheck::tc_elem_type_matches(tc, key_type6, expected_key_type) == false
                      error("map_delete: expected key type #{typecheck::tc_type_name_full(tc, expected_key_type)}, got #{typecheck::tc_type_name_full(tc, key_type6)}", line, col)
                    end
                  end
                end
              end

              # Channel<T> element type propagation + checking
              if recv_base == type_constants::TYPE_CHANNEL
                var chan_elem = typecheck::tc_ptype_arg1(tc, recv_type)
                # If the element type is a protocol, skip element type checking
                # (protocol channels use protocol step types instead)
                var is_protocol_chan = chan_elem >= type_constants::PROTOCOL_BASE and chan_elem < type_constants::PROTOCOL_BASE + 1000
                if is_protocol_chan == false
                  # recv(ch) on Channel<T> returns T
                  if func_name == "recv" or func_name == "Channel$recv"
                    result = chan_elem
                  end
                  if func_name == "try_recv" or func_name == "Channel$try_recv"
                    result = chan_elem
                  end
                  if func_name == "recv_timeout"
                    result = chan_elem
                  end
                  # send(ch, val) on Channel<T> — check val matches T
                  if func_name == "send" or func_name == "Channel$send"
                    if arg_count >= 2
                      var send_val_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                      if typecheck::tc_elem_type_matches(tc, send_val_type, chan_elem) == false
                        error("send: expected element type #{typecheck::tc_type_name_full(tc, chan_elem)}, got #{typecheck::tc_type_name_full(tc, send_val_type)}", line, col)
                      end
                    end
                  end
                  if func_name == "try_send" or func_name == "Channel$try_send"
                    if arg_count >= 2
                      var try_send_val = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                      if typecheck::tc_elem_type_matches(tc, try_send_val, chan_elem) == false
                        error("try_send: expected element type #{typecheck::tc_type_name_full(tc, chan_elem)}, got #{typecheck::tc_type_name_full(tc, try_send_val)}", line, col)
                      end
                    end
                  end
                end
              end

              # §14.7 item 2 (5a) + R1.6: chained `m.get(k).unwrap()` / `opt_some(x).unwrap()`
              # — when the `.unwrap()` receiver is a CALL expression (not a bound
              # var) the bound-var payload-tracking path doesn't run, so the
              # Option's payload type was lost: `unwrap`'s bare-`T` return fell
              # back to Int and a struct payload surfaced as `Unknown struct: T`
              # (QZ0301) + a spurious QZ0215 when bound to a typed slot. Recover
              # the payload type directly from the receiver ptype here, mirroring
              # the Vec/Channel element-propagation above. The typecheck-layer
              # analog of A.45's MIR-side `mir_bind_bare_param_return` fix: bind
              # the bare-`T` unwrap return from the concrete generic receiver.
              # (5a originally scoped this to Fn payloads only; R1.6 widens it to
              # any concrete payload — struct, enum, nominal ptype, scalar — since
              # the struct/Int chained-unwrap flows did NOT resolve correctly
              # through other paths, contrary to the prior comment.)
              if recv_base == type_constants::TYPE_OPTION
                if func_name == "unwrap" or func_name == "unwrap_or"
                  var opt_payload = typecheck::tc_ptype_arg1(tc, recv_type)
                  if tc_chained_unwrap_payload_recoverable(tc, opt_payload)
                    result = opt_payload
                    var opt_sname = tc_chained_unwrap_payload_struct_name(tc, opt_payload)
                    if str_byte_len(opt_sname) > 0
                      ast::ast_set_str2(ast_storage, node, opt_sname)
                    end
                  end
                end
              end
              if recv_base == type_constants::TYPE_RESULT
                if func_name == "unwrap_ok" or func_name == "unwrap_or_ok"
                  var res_payload = typecheck::tc_ptype_arg1(tc, recv_type)
                  if tc_chained_unwrap_payload_recoverable(tc, res_payload)
                    result = res_payload
                    var res_sname = tc_chained_unwrap_payload_struct_name(tc, res_payload)
                    if str_byte_len(res_sname) > 0
                      ast::ast_set_str2(ast_storage, node, res_sname)
                    end
                  end
                end
              end

              # Protocol state checking: verify send/recv matches expected protocol step
              # Only check for actual protocol operations (send/recv), not metadata (close, closed, size)
              if arg_count > 0
                var is_protocol_op = func_name == "send" or func_name == "Channel$send" or func_name == "try_send" or func_name == "Channel$try_send" or func_name == "recv" or func_name == "Channel$recv" or func_name == "try_recv" or func_name == "Channel$try_recv" or func_name == "recv_timeout"
                if is_protocol_op
                var recv_arg = args[0]
                if ast::ast_get_kind(ast_storage, recv_arg) == node_constants::NODE_IDENT
                  var chan_name = ast::ast_get_str1(ast_storage, recv_arg)
                  var proto_kind = typecheck_registry::tc_get_binding_protocol_kind(tc, chan_name)
                  if proto_kind == 0
                    # Protocol is complete (PROTO_STEP_END) — channel used after completion
                    var pi = typecheck_registry::tc_get_binding_protocol_idx(tc, chan_name)
                    var pn = typecheck_registry::tc_protocol_name(tc, pi)
                    error("QZ1403: Use of completed protocol channel '#{chan_name}' — protocol '#{pn}' was fully consumed", line, col)
                  elsif proto_kind > 0
                    # This binding has a protocol — check operation matches
                    var is_send_op = func_name == "send" or func_name == "Channel$send" or func_name == "try_send" or func_name == "Channel$try_send"
                    var is_recv_op = func_name == "recv" or func_name == "Channel$recv" or func_name == "try_recv" or func_name == "Channel$try_recv" or func_name == "recv_timeout"
                    # proto_kind: 1=SEND, 2=RECV, 3=CHOICE (multiple options)
                    if proto_kind == 3
                      # Choice point: both send and recv are valid, advance with actual op kind
                      if is_send_op
                        typecheck_registry::tc_advance_protocol_with_kind(tc, chan_name, typecheck_util::PROTO_STEP_SEND, line, col)
                      elsif is_recv_op
                        typecheck_registry::tc_advance_protocol_with_kind(tc, chan_name, typecheck_util::PROTO_STEP_RECV, line, col)
                      end
                    elsif is_send_op and proto_kind != typecheck_util::PROTO_STEP_SEND
                      var pi = typecheck_registry::tc_get_binding_protocol_idx(tc, chan_name)
                      var pn = typecheck_registry::tc_protocol_name(tc, pi)
                      error("QZ1402: Protocol violation on '#{chan_name}' — expected recv (protocol '#{pn}') but got send", line, col)
                    elsif is_recv_op and proto_kind != typecheck_util::PROTO_STEP_RECV
                      var pi = typecheck_registry::tc_get_binding_protocol_idx(tc, chan_name)
                      var pn = typecheck_registry::tc_protocol_name(tc, pi)
                      error("QZ1402: Protocol violation on '#{chan_name}' — expected send (protocol '#{pn}') but got recv", line, col)
                    else
                      # Operation matches expected step — advance protocol state
                      # Generic protocol type checking: verify value type matches step type
                      var pi2 = typecheck_registry::tc_get_binding_protocol_idx(tc, chan_name)
                      if pi2 >= 0 and is_send_op and arg_count >= 2
                        var type_args = typecheck_registry::tc_get_binding_protocol_type_args(tc, chan_name)
                        if str_byte_len(type_args) > 0
                          # Get the current DFA state's step index (position in step_type_annotations)
                          # For linear protocols: state == step index
                          var cur_state = tc.safety.binding_protocol_states[0]
                          # Find binding index
                          var bc = typecheck_util::tc_get_binding_count(tc)
                          var bi = bc - 1
                          while bi >= 0
                            if tc.scope.binding_names[bi] == chan_name
                              cur_state = tc.safety.binding_protocol_states[bi]
                              break
                            end
                            bi -= 1
                          end
                          var step_ann = typecheck_registry::tc_protocol_step_type_annotation_at(tc, pi2, cur_state)
                          if str_byte_len(step_ann) > 0
                            var expected_type = typecheck_registry::tc_protocol_resolve_step_type(tc, pi2, step_ann, type_args)
                            if expected_type > 0
                              var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                              if val_type != expected_type and expected_type != type_constants::TYPE_ERROR
                                var pn2 = typecheck_registry::tc_protocol_name(tc, pi2)
                                error("QZ1407: Protocol type mismatch on '#{chan_name}' — protocol '#{pn2}' expects #{typecheck::tc_type_name_full(tc, expected_type)} but got #{typecheck::tc_type_name_full(tc, val_type)}", line, col)
                              end
                            end
                          end
                        end
                      end
                      if is_send_op
                        typecheck_registry::tc_advance_protocol_with_kind(tc, chan_name, typecheck_util::PROTO_STEP_SEND, line, col)
                      elsif is_recv_op
                        typecheck_registry::tc_advance_protocol_with_kind(tc, chan_name, typecheck_util::PROTO_STEP_RECV, line, col)
                      end
                    end
                  end
                end
              end
              end  # is_protocol_op
            end
            # Channel<T> inference for bare Channel on direct send/try_send.
            # UFCS inference (ch.send) runs in the is_ufcs section above.
            # This handles direct send(ch, val) where ch is bare TYPE_CHANNEL.
            if recv_type == type_constants::TYPE_CHANNEL
              if func_name == "send" or func_name == "try_send"
                if arg_count >= 2
                  if ast::ast_get_kind(ast_storage, args[0]) == node_constants::NODE_IDENT
                    var di_name = ast::ast_get_str1(ast_storage, args[0])
                    var di_ann = typecheck_util::tc_scope_lookup_annotation(tc, di_name)
                    if str_byte_len(di_ann) == 0 or __char_index(di_ann, '<') < 0
                      var di_val_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
                      if di_val_type != type_constants::TYPE_ERROR
                        var di_elem = typecheck::tc_type_name(di_val_type)
                        var di_ptype = typecheck::tc_make_ptype(tc, type_constants::TYPE_CHANNEL, di_val_type, 0)
                        var di_bidx = typecheck_util::tc_lookup_binding_index(tc, di_name)
                        if di_bidx >= 0
                          tc.scope.binding_types[di_bidx] = di_ptype
                          tc.scope.binding_type_annotations[di_bidx] = "Channel<#{di_elem}>"
                        end
                        typecheck_util::tc_resolve_pending_ptype(tc, di_name)
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  # Linear consumption: consume linear args passed by value (not by borrow)
  if arg_count > 0
    for i in 0..arg_count
      var arg = args[i]
      var arg_kind = ast::ast_get_kind(ast_storage, arg)
      if arg_kind == node_constants::NODE_IDENT
        var arg_name = ast::ast_get_str1(ast_storage, arg)
        var arg_lin_state = typecheck_registry::tc_lookup_linear_state(tc, arg_name)
        if arg_lin_state == 1
          typecheck_registry::tc_consume_linear(tc, arg_name, line, col)
        end
      end
    end
  end

  # Move semantics: consume moveable args passed by value (not by borrow)
  if arg_count > 0
    for i in 0..arg_count
      var arg = args[i]
      var arg_kind = ast::ast_get_kind(ast_storage, arg)
      if arg_kind == node_constants::NODE_IDENT
        var arg_name = ast::ast_get_str1(ast_storage, arg)
        typecheck_registry::tc_move_on_call(tc, arg_name, func_name, line, col)
      elsif arg_kind == node_constants::NODE_FIELD_ACCESS
        # Partial move: consume(r.x) moves field x from r
        var fa_base = ast::ast_get_left(ast_storage, arg)
        if ast::ast_get_kind(ast_storage, fa_base) == node_constants::NODE_IDENT
          var fa_base_name = ast::ast_get_str1(ast_storage, fa_base)
          var fa_field_name = ast::ast_get_str1(ast_storage, arg)
          var fa_struct = typecheck_util::tc_scope_lookup_struct_name(tc, fa_base_name)
          if str_byte_len(fa_struct) > 0
            if typecheck_registry::tc_type_needs_move_tracking(tc, fa_struct)
              # Copy-type fields (Int/Bool/Float/String/... ) are copied by the
              # read, not moved — only mark a partial move when the FIELD's own
              # type needs move tracking (nested Drop/linear struct). Fixes bogus
              # QZ1216 on `str_from_int(self.x)` in a Drop body.
              if typecheck_registry::tc_field_read_moves(tc, fa_struct, fa_field_name) == 1
                typecheck_registry::tc_partial_move_field(tc, fa_base_name, fa_field_name, func_name, line, col)
              end
            end
          end
        end
      end
    end
  end

  # Release inline borrows after call returns
  if arg_count > 0
    for i in 0..arg_count
      var arg = args[i]
      var arg_kind = ast::ast_get_kind(ast_storage, arg)
      if arg_kind == node_constants::NODE_FUNC_REF
        var borrow_name = ast::ast_get_str1(ast_storage, arg)
        var borrow_is_mut = ast::ast_get_int_val(ast_storage, arg)
        var src_idx = typecheck_util::tc_lookup_binding_index(tc, borrow_name)
        if src_idx >= 0
          if borrow_is_mut == 1
            tc.safety.binding_borrow_states[src_idx] = 0
          else
            var sbc = tc.safety.binding_shared_borrow_counts[src_idx]
            if sbc > 0
              tc.safety.binding_shared_borrow_counts[src_idx] = sbc - 1
              if sbc - 1 == 0 and tc.safety.binding_borrow_states[src_idx] == 1
                tc.safety.binding_borrow_states[src_idx] = 0
              end
            end
          end
        end
      end
    end
  end

  # T3.1: Send/Sync enforcement for taskgroup_spawn
  if func_name == "taskgroup_spawn"
    # taskgroup_spawn(group, closure) — closure is arg index 1
    if arg_count >= 2
      var tgs_arg = args[1]
      if ast::ast_get_kind(ast_storage, tgs_arg) == node_constants::NODE_LAMBDA
        with Diag {
          error: typecheck_diag::tc_diag_error_handler
        } do ->
          typecheck_concurrency::tc_check_spawn_safety(tc, ast_storage, tgs_arg, line, col)
        end
      end
    end
  end

  result
  end  # close body-wrap
end

## Scan AST subtree for NODE_BREAK with value expressions.
## Returns the type of the first break value found, or TYPE_VOID if none.
def tc_find_break_value_type(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId): Int
  # Memory-safety guard: this is a generic AST walker that recurses into
  # left/right/extra/children of every node. `extra` is overloaded — for some
  # kinds (e.g. NODE_ENUM_ACCESS, where extra holds the bound_names Vec) it is
  # a heap handle, not a child node id. Validate the id is in range before any
  # `ast_get_*` indexing; every recursive call re-enters through this guard,
  # so a non-node value (a pointer, an out-of-range int) is safely ignored.
  if node < 0 or node >= ast::ast_node_count(ast_storage)
    return type_constants::TYPE_VOID
  end
  var kind = ast::ast_get_kind(ast_storage, node)
  if kind == node_constants::NODE_BREAK
    var val_node = ast::ast_get_left(ast_storage, node)
    if val_node > 0
      return type_constants::TYPE_INT
    end
    return type_constants::TYPE_VOID
  end
  # Don't recurse into nested loops — their breaks target the inner loop
  if kind == node_constants::NODE_WHILE or kind == node_constants::NODE_FOR
    return type_constants::TYPE_VOID
  end
  # Recurse into children
  var children = ast::ast_get_children(ast_storage, node)
  if children != 0
    for i in 0..children.size
      var child_type = tc_find_break_value_type(tc, ast_storage, children[i])
      if child_type != type_constants::TYPE_VOID
        return child_type
      end
    end
  end
  # Also check left, right, extra branches
  var left = ast::ast_get_left(ast_storage, node)
  if left > 0
    var lt = tc_find_break_value_type(tc, ast_storage, left)
    if lt != type_constants::TYPE_VOID
      return lt
    end
  end
  var right = ast::ast_get_right(ast_storage, node)
  if right > 0
    var rt = tc_find_break_value_type(tc, ast_storage, right)
    if rt != type_constants::TYPE_VOID
      return rt
    end
  end
  var extra = ast::ast_get_extra(ast_storage, node)
  if extra > 0
    var et = tc_find_break_value_type(tc, ast_storage, extra)
    if et != type_constants::TYPE_VOID
      return et
    end
  end
  return type_constants::TYPE_VOID
end

# ============================================================================
# FIX.6: Type Inference — Element Type Resolution
# ============================================================================

## Emit a Vec element type mismatch error.
## Uses QZ0203 if the element type was inferred, otherwise the standard error message.
def tc_emit_vec_element_error(tc: TypecheckState, ast_storage: ast::AstStorage, first_arg: AstNodeId, op_name: String, elem_type: Int, val_type: Int, recv_type: Int, line: Int, col: Int): Void
  with Diag {
    error: typecheck_diag::tc_diag_error_handler,
    warn: typecheck_diag::tc_diag_warn_handler
  } do ->
  var recv_name = ""
  if ast::ast_get_kind(ast_storage, first_arg) == node_constants::NODE_IDENT
    recv_name = ast::ast_get_str1(ast_storage, first_arg)
  end

  # Check if this Vec binding's element type was inferred (not explicit)
  var was_inferred = false
  var inferred_line = 0
  if str_byte_len(recv_name) > 0
    var i = tc.inferred_vec_vars.size - 1
    while i >= 0
      if tc.inferred_vec_vars[i] == recv_name
        was_inferred = true
        inferred_line = tc.inferred_vec_lines[i]
        break
      end
      i -= 1
    end
  end

  var elem_name = typecheck::tc_type_name_full(tc, elem_type)
  var val_name = typecheck::tc_type_name_full(tc, val_type)
  if was_inferred and str_byte_len(recv_name) > 0
    error("QZ0203: Type inference conflict for '#{recv_name}': element type is #{elem_name} but got #{val_name} (inferred as Vec<#{elem_name}> at line #{inferred_line})", line, col)
  else
    error("#{op_name}: expected element type #{elem_name} (from #{typecheck::tc_type_name_full(tc, recv_type)}), got #{val_name}", line, col)
  end
  end  # close body-wrap
end

## Check for type conflicts when pushing to a Vec whose element type was already inferred.
## Emits QZ0203 if the new value's type doesn't match the existing element type.
def tc_check_vec_element_conflict(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, recv_name: String, existing_ann: String, func_name: String, args: Vec<Int>, arg_count: Int, is_set: Bool, is_insert: Bool): Void
  # Determine which argument carries the element type
  var val_arg_idx = 1
  if is_set or is_insert
    val_arg_idx = 2
  end
  return if val_arg_idx >= arg_count

  # Type check the value argument
  var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[val_arg_idx])
  return if val_type == type_constants::TYPE_ERROR or val_type == type_constants::TYPE_ERROR

  # Extract existing element type name from annotation "Vec<Int>" → "Int"
  var lt_idx = __char_index(existing_ann, '<')
  return if lt_idx < 0
  var gt_idx = __char_index(existing_ann, '>')
  return if gt_idx <= lt_idx
  var existing_elem_name = str_byte_slice(existing_ann, lt_idx + 1, gt_idx)

  # Get name of the new value's type
  var new_elem_name = ""
  if typecheck::tc_is_ptype(val_type)
    new_elem_name = typecheck::tc_type_name_full(tc, val_type)
  elsif typecheck::tc_is_struct_type(val_type)
    new_elem_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[val_arg_idx])
  elsif val_type == type_constants::TYPE_ENUM
    new_elem_name = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, args[val_arg_idx])
  else
    new_elem_name = typecheck::tc_type_name(val_type)
  end
  return if str_byte_len(new_elem_name) == 0

  # Compare: if different, emit QZ0203
  if existing_elem_name != new_elem_name
    var line = ast::ast_get_line(ast_storage, node)
    var col = ast::ast_get_col(ast_storage, node)
    var msg = "QZ0203: Type inference conflict for '#{recv_name}': element type is #{existing_elem_name} but got #{new_elem_name}"
    with Diag {
      error: typecheck_diag::tc_diag_error_handler,
      warn: typecheck_diag::tc_diag_warn_handler
    } do ->
      error(msg, line, col)
    end
  end
end

## F4 item-9 — backfill the Vec element struct name into a higher-order
## intrinsic's lambda-argument ELEMENT param str2, so MIR (mir_lower_lambda)
## can register the param struct-typed and the closure body resolves
## `param.field` through the element's value-layout layout (cow buffer word f+1
## / inline @value typed GEP) instead of FLAT offsets. The named-fn callee form
## already works (`p: S` carries the type); this gives inline-closure HOFs the
## same. Only fills an EMPTY annotation on the element-receiving param: for
## reduce the element is param[1] (after the accumulator); for each / map /
## filter / find / count / any? / all? it is param[0]. INERT for scalar element
## types — `elem_name` is only a struct/enum name here (the caller writes it only
## for tc_is_struct_type / TYPE_ENUM elements).
def tc_hof_backfill_lambda_elem_type(tc: TypecheckState, ast_storage: ast::AstStorage, func_name: String, elem_name: String, elem_type: TypeId, args: Vec<Int>, arg_count: Int): Void
  return if str_byte_len(elem_name) == 0
  # Only nominal struct/enum element types carry a value-layout layout that the
  # closure body must respect; scalars read as a single i64 word (no shift).
  return if not (typecheck::tc_is_struct_type(elem_type) or elem_type == type_constants::TYPE_ENUM)
  # Which arg is the lambda, and which lambda param receives the element.
  var lam_arg_idx = -1
  var elem_param_idx = 0
  if func_name == "each" or func_name == "map" or func_name == "filter" or func_name == "find" or func_name == "count" or func_name == "any?" or func_name == "all?"
    lam_arg_idx = 1
    elem_param_idx = 0
  elsif func_name == "reduce"
    lam_arg_idx = 2
    elem_param_idx = 1
  else
    return
  end
  return if lam_arg_idx >= arg_count
  var lam_node = args[lam_arg_idx]
  return if ast::ast_get_kind(ast_storage, lam_node) != node_constants::NODE_LAMBDA
  var lam_params = ast::ast_get_left(ast_storage, lam_node)
  return if lam_params <= 0
  return if elem_param_idx >= vec_size(lam_params)
  var ep_node = lam_params[elem_param_idx]
  var ep_existing = ast::ast_get_str2(ast_storage, ep_node)
  return if str_byte_len(ep_existing) > 0
  ast::ast_set_str2(ast_storage, ep_node, elem_name)
end

## F4 (item 9g) — recover the STRUCT NAME of a `map` closure's RETURN type.
## Unlike the element-PRESERVING HOFs (filter/take/…), `map`'s result element
## type is the CLOSURE's return type, NOT the source element type. The closure
## arg is `args[1]`. Two recovery routes, in order:
##   (1) an inline NODE_LAMBDA (or any expression) typechecks to a Fn ptype whose
##       registered return type → `tc_type_name_full` resolves the struct name
##       (covers `s -> bump(s)` and `{ transform(it) }`, incl. inferred bodies).
##   (2) a bare NODE_IDENT naming a function (`v.map(bump)`): take its declared
##       return-type ANNOTATION directly (the Fn-ptype round-trip can lose the
##       per-struct nominal id for a top-level fn IDENT).
## Returns the struct name (e.g. "T") or "" when not a nominal struct return.
## GATE-0-INERT: the caller gates the result on `tc_is_value_layout_struct_name`,
## so a reference-layout / scalar return name produces no refinement.
def tc_map_closure_return_struct_name(tc: TypecheckState, ast_storage: ast::AstStorage, args: Vec<Int>, arg_count: Int): String
  return "" if arg_count < 2
  var lam_node = args[1]
  # Route (1): typecheck the closure to a Fn ptype, read its return type.
  # Works for a named-fn / typed-arrow whose return carries the per-struct
  # nominal id (e.g. `def bump(s): Tee` → `tc_type_name_full` = "Tee").
  var lam_t = typecheck_walk::tc_expr(tc, ast_storage, lam_node)
  var fn_id = typecheck::tc_fn_type_id(tc, lam_t)
  if fn_id >= 0
    var ret_t = typecheck_util::tc_tv_resolve(tc, typecheck_registry::tc_fn_type_return_type(tc, fn_id))
    if typecheck::tc_is_struct_type(ret_t)
      var nm = typecheck::tc_type_name_full(tc, ret_t)
      # tc_type_name_full yields the bare "Struct" sentinel when the return
      # type is the generic TYPE_STRUCT (no nominal id) — that's not usable.
      if str_byte_len(nm) > 0 and nm != "Struct" and not nm.starts_with("Vec<")
        return nm
      end
    end
  end
  # Route (1b): inline lambda whose return type lost its nominal id (an
  # un-annotated `s -> Tee { … }` body types to the generic TYPE_STRUCT
  # sentinel). Recover the struct name from the lambda BODY expression (a
  # struct-construction literal / call) directly.
  if ast::ast_get_kind(ast_storage, lam_node) == node_constants::NODE_LAMBDA
    var lam_body = ast::ast_get_right(ast_storage, lam_node)
    if lam_body >= 0
      var body_nm = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, lam_body)
      if str_byte_len(body_nm) > 0 and not body_nm.starts_with("Vec<")
        return body_nm
      end
    end
  end
  # Route (2): bare fn IDENT — use its declared return annotation.
  if ast::ast_get_kind(ast_storage, lam_node) == node_constants::NODE_IDENT
    var fn_name = ast::ast_get_str1(ast_storage, lam_node)
    var ann = typecheck_registry::tc_lookup_function_return_annotation(tc, fn_name)
    if str_byte_len(ann) > 0 and not ann.starts_with("Vec<") and __char_index(ann, '<') < 0
      if typecheck_registry::tc_lookup_struct(tc, ann).is_found()
        return ann
      end
    end
  end
  return ""
end

## Try to resolve a Vec's element type from a constraining UFCS method call.
## When vec_push/vec_set/vec_insert is called on a bare TYPE_VEC (no ptype),
## infer the element type from the value argument and create a real ptype.
def tc_try_resolve_vec_element_type(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, first_arg: AstNodeId, func_name: String, args: Vec<Int>, arg_count: Int): Void
  # Only resolve for constraining methods that carry element type info
  var is_push = func_name == "vec_push"
  var is_set = func_name == "vec_set"
  var is_insert = func_name == "vec_insert"
  return if not is_push and not is_set and not is_insert

  # Receiver must be an identifier (so we can update the binding)
  return if ast::ast_get_kind(ast_storage, first_arg) != node_constants::NODE_IDENT
  var recv_name = ast::ast_get_str1(ast_storage, first_arg)

  # Check receiver doesn't already have a ptype (annotation would be non-empty with '<')
  var existing_ann = typecheck_util::tc_scope_lookup_annotation(tc, recv_name)
  if str_byte_len(existing_ann) > 0
    if __char_index(existing_ann, '<') >= 0
      # Vec already has an inferred element type — check for conflicts
      tc_check_vec_element_conflict(tc, ast_storage, node, recv_name, existing_ann, func_name, args, arg_count, is_set, is_insert)
      return
    end
  end

  # Determine which argument carries the element type
  var val_arg_idx = 1
  if is_set or is_insert
    val_arg_idx = 2
  end
  return if val_arg_idx >= arg_count

  # Type check the value argument to determine element type
  var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[val_arg_idx])
  # Don't infer from TYPE_ERROR or TYPE_ERROR
  return if val_type == type_constants::TYPE_ERROR or val_type == type_constants::TYPE_ERROR

  # Create ptype Vec<T> from the value's type
  var elem_type = val_type
  var struct_idx = 0
  var elem_name = ""

  if typecheck::tc_is_ptype(val_type)
    elem_type = val_type
    elem_name = typecheck::tc_type_name_full(tc, val_type)
  elsif typecheck::tc_is_struct_type(val_type)
    # Get struct name from the value expression
    elem_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[val_arg_idx])
    if str_byte_len(elem_name) > 0
      var sr = typecheck_registry::tc_lookup_struct(tc, elem_name)
      if sr.is_found()
        struct_idx = sr.unwrap() + 1
      end
    end
  elsif val_type == type_constants::TYPE_ENUM
    var val_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, args[val_arg_idx])
    if str_byte_len(val_ann) > 0
      elem_name = val_ann
      var er = typecheck_registry::tc_lookup_enum(tc, val_ann)
      if er.is_found()
        struct_idx = er.unwrap() + 1
      end
    end
  else
    elem_name = typecheck::tc_type_name(val_type)
  end

  # Create the ptype
  var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, elem_type, struct_idx)
  if struct_idx > 0
    typecheck::tc_ptype_set_name(tc, ptype_id, elem_name)
  end

  # Construct annotation string
  var type_ann = "Vec<#{elem_name}>"

  # Update the binding's type and annotation
  var bidx = typecheck_util::tc_lookup_binding_index(tc, recv_name)
  if bidx >= 0
    tc.scope.binding_types[bidx] = ptype_id
    tc.scope.binding_type_annotations[bidx] = type_ann
  end

  # FIX.6 Phase 1: Resolve pending ptype now that element type is known
  typecheck_util::tc_resolve_pending_ptype(tc, recv_name)

  # Record that this Vec binding's element type was inferred (not explicit)
  var infer_line = ast::ast_get_line(ast_storage, node)
  tc.inferred_vec_vars.push(recv_name)
  tc.inferred_vec_lines.push(infer_line)

  # Annotate the call node with element type for width-aware codegen
  if str_byte_len(elem_name) > 0
    ast::ast_set_str2(ast_storage, node, elem_name)
  end
end

## Try to resolve a Map's key and value types from a constraining UFCS method call.
## When map_set/map_insert is called on a bare TYPE_MAP (no ptype),
## infer K and V from the key and value arguments and create a real ptype.
## Mirrors tc_try_resolve_vec_element_type but for two type parameters.
##
## Per Prime Directive 12: V is NOT defaulted to TYPE_INT for "compat". If only
## reads (map_get/has/delete) are seen and never a write, the binding stays bare
## and the use site reports an inference error — same as Vec.
## Annotate a map_* call node with its key type so cg_intrinsic_map can
## dispatch to the correct key-type-specialized handler via MIR slot2.
## Pass first_arg_type=0 to look it up via tc_expr; otherwise pass the
## already-computed type to avoid re-evaluation.
##   Int keys     -> "Int"
##   Struct keys  -> struct name
##   String keys  -> no annotation (default = string-key path)
## Falls back to parsing the receiver's annotation string when the type
## isn't a ptype yet (e.g., bare TYPE_MAP from an explicit Map<...> binding).
def tc_annotate_map_key_type(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, first_arg: AstNodeId, first_arg_type: Int): Void
  var arg_type = first_arg_type
  if arg_type == 0
    arg_type = typecheck_walk::tc_expr(tc, ast_storage, first_arg)
  end
  if typecheck::tc_is_ptype(arg_type)
    var key_type = typecheck::tc_ptype_arg1(tc, arg_type)
    if key_type == type_constants::TYPE_INT
      ast::ast_set_str2(ast_storage, node, "Int")
      return
    end
    if typecheck::tc_is_struct_type(key_type)
      ast::ast_set_str2(ast_storage, node, typecheck::tc_ptype_name(tc, arg_type))
      return
    end
    return
  end
  # Fallback: parse the receiver's binding annotation, e.g. "Map<Int, Int>".
  if ast::ast_get_kind(ast_storage, first_arg) != node_constants::NODE_IDENT
    return
  end
  var recv_name = ast::ast_get_str1(ast_storage, first_arg)
  var ann = typecheck_util::tc_scope_lookup_annotation(tc, recv_name)
  if str_byte_len(ann) == 0
    return
  end
  var lt = __char_index(ann, '<')
  if lt < 0
    return
  end
  var inner_start = lt + 1
  var comma = __char_index(str_byte_slice(ann, inner_start, str_byte_len(ann)), ',')
  if comma < 0
    return
  end
  var key_str = str_byte_slice(ann, inner_start, inner_start + comma)
  # Trim trailing whitespace
  while str_byte_len(key_str) > 0 and str_byte_at(key_str, str_byte_len(key_str) - 1) == ' '
    key_str = str_byte_slice(key_str, 0, str_byte_len(key_str) - 1)
  end
  if str_byte_len(key_str) == 0
    return
  end
  if key_str == "Int"
    ast::ast_set_str2(ast_storage, node, "Int")
    return
  end
  if key_str == "String"
    return
  end
  # Anything else (struct/enum name) is treated as a struct-key annotation.
  ast::ast_set_str2(ast_storage, node, key_str)
end

## WS1 — back-stamp the `set_new()` init node for the given set receiver with a
## value-layout struct element name, so set_new's codegen allocates the layout
## that qz_map_custom_* (value-compare add/has/delete) operates on. One-shot per
## receiver: the element type is locked in after the first constraining set_add.
## WS3 — record `recv`'s element struct type in the per-function side-table so a
## later set algebra op on `recv` can recover it. Keyed on the receiver var NAME
## (last write wins; a set only ever holds one element type). No-op for a non-ident
## receiver.
def tc_record_set_struct_elem(tc: TypecheckState, ast_storage: ast::AstStorage, recv: AstNodeId, struct_name: String): Void
  return if ast::ast_get_kind(ast_storage, recv) != node_constants::NODE_IDENT
  var recv_name = ast::ast_get_str1(ast_storage, recv)
  # De-dup: update in place if already recorded (avoid unbounded growth on repeated adds).
  var i = 0
  while i < tc.set_struct_elem_vars.size
    if tc.set_struct_elem_vars[i] == recv_name
      tc.set_struct_elem_types[i] = struct_name
      return
    end
    i += 1
  end
  tc.set_struct_elem_vars.push(recv_name)
  tc.set_struct_elem_types.push(struct_name)
end

## WS3 — look up the element struct type recorded for `recv`. Returns "" if `recv`
## is not an ident or was never a struct set_add target in this function.
def tc_lookup_set_struct_elem(tc: TypecheckState, ast_storage: ast::AstStorage, recv: AstNodeId): String
  return "" if ast::ast_get_kind(ast_storage, recv) != node_constants::NODE_IDENT
  var recv_name = ast::ast_get_str1(ast_storage, recv)
  var i = 0
  while i < tc.set_struct_elem_vars.size
    if tc.set_struct_elem_vars[i] == recv_name
      return tc.set_struct_elem_types[i]
    end
    i += 1
  end
  return ""
end

def tc_backstamp_set_new_struct_elem(tc: TypecheckState, ast_storage: ast::AstStorage, recv: AstNodeId, struct_name: String): Void
  return if ast::ast_get_kind(ast_storage, recv) != node_constants::NODE_IDENT
  var recv_name = ast::ast_get_str1(ast_storage, recv)
  var psn_idx = tc.pending_set_new_vars.size - 1
  while psn_idx >= 0
    if tc.pending_set_new_vars[psn_idx] == recv_name
      var pending_init_node = tc.pending_set_new_nodes[psn_idx]
      ast::ast_set_str2(ast_storage, pending_init_node, struct_name)
      var psn_last = tc.pending_set_new_vars.size - 1
      if psn_idx != psn_last
        tc.pending_set_new_vars[psn_idx] = tc.pending_set_new_vars[psn_last]
        tc.pending_set_new_nodes[psn_idx] = tc.pending_set_new_nodes[psn_last]
      end
      vec_pop(tc.pending_set_new_vars)
      vec_pop(tc.pending_set_new_nodes)
      return
    end
    psn_idx -= 1
  end
end

def tc_try_resolve_map_key_value_types(tc: TypecheckState, ast_storage: ast::AstStorage, node: AstNodeId, first_arg: AstNodeId, func_name: String, args: Vec<Int>, arg_count: Int): Void
  # Only resolve from constraining writes that carry both K and V
  var is_set = func_name == "map_set"
  var is_insert = func_name == "map_insert"
  return if not is_set and not is_insert

  # Receiver must be an identifier so we can update its binding
  return if ast::ast_get_kind(ast_storage, first_arg) != node_constants::NODE_IDENT
  var recv_name = ast::ast_get_str1(ast_storage, first_arg)

  # If receiver already has a parameterized annotation, do nothing
  var existing_ann = typecheck_util::tc_scope_lookup_annotation(tc, recv_name)
  if str_byte_len(existing_ann) > 0
    if __char_index(existing_ann, '<') >= 0
      return
    end
  end

  return if arg_count < 3

  # Type-check key and value arguments to determine K and V
  var key_type = typecheck_walk::tc_expr(tc, ast_storage, args[1])
  var val_type = typecheck_walk::tc_expr(tc, ast_storage, args[2])
  return if key_type == type_constants::TYPE_ERROR
  return if val_type == type_constants::TYPE_ERROR

  # Build human-readable names for the annotation string
  var key_name = ""
  if typecheck::tc_is_ptype(key_type)
    key_name = typecheck::tc_type_name_full(tc, key_type)
  elsif typecheck::tc_is_struct_type(key_type)
    key_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[1])
    if str_byte_len(key_name) == 0
      key_name = typecheck::tc_type_name(key_type)
    end
  elsif key_type == type_constants::TYPE_ENUM
    var k_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, args[1])
    if str_byte_len(k_ann) > 0
      key_name = k_ann
    else
      key_name = typecheck::tc_type_name(key_type)
    end
  else
    key_name = typecheck::tc_type_name(key_type)
  end

  var val_name = ""
  if typecheck::tc_is_ptype(val_type)
    val_name = typecheck::tc_type_name_full(tc, val_type)
  elsif typecheck::tc_is_struct_type(val_type)
    val_name = typecheck_generics::tc_resolve_expr_struct_name(tc, ast_storage, args[2])
    if str_byte_len(val_name) == 0
      val_name = typecheck::tc_type_name(val_type)
    end
  elsif val_type == type_constants::TYPE_ENUM
    var v_ann = typecheck_generics::tc_infer_expr_type_annotation(tc, ast_storage, args[2])
    if str_byte_len(v_ann) > 0
      val_name = v_ann
    else
      val_name = typecheck::tc_type_name(val_type)
    end
  else
    val_name = typecheck::tc_type_name(val_type)
  end

  # Create the Map<K, V> ptype
  var ptype_id = typecheck::tc_make_ptype(tc, type_constants::TYPE_MAP, key_type, val_type)

  # Annotation string for downstream tools and error messages
  var type_ann = "Map<#{key_name}, #{val_name}>"

  # Update the binding
  var bidx = typecheck_util::tc_lookup_binding_index(tc, recv_name)
  if bidx >= 0
    tc.scope.binding_types[bidx] = ptype_id
    tc.scope.binding_type_annotations[bidx] = type_ann
  end

  # Resolve any pending ptype now that K and V are known
  typecheck_util::tc_resolve_pending_ptype(tc, recv_name)

  # Critical fix: back-stamp the original `map_new()` init call's type_arg
  # with "K,V" so the codegen for map_new selects the correct memory layout
  # (string-key vs int-key vs struct-key). Without this, fresh `map_new()`
  # always allocates the string-key layout and a subsequent intmap_set on
  # it crashes with a layout mismatch (the "B1" SIGSEGV).
  #
  # We write the full "K,V" form (not just "K") because tc_expr_call's
  # map_new branch validates `str_contains(type_arg, ",")` and errors on
  # single-type forms. The MIR lowering at mir_lower_stmt_handlers.qz:204+
  # already knows how to parse "K,V" out of the type_arg.
  var pmn_idx = tc.pending_map_new_vars.size - 1
  while pmn_idx >= 0
    if tc.pending_map_new_vars[pmn_idx] == recv_name
      var pending_init_node = tc.pending_map_new_nodes[pmn_idx]
      ast::ast_set_str2(ast_storage, pending_init_node, "#{key_name},#{val_name}")
      # One-shot: pop the entry so we don't re-stamp on every subsequent
      # map_set in the same scope (the type is locked in after the first).
      var pmn_last = tc.pending_map_new_vars.size - 1
      if pmn_idx != pmn_last
        tc.pending_map_new_vars[pmn_idx] = tc.pending_map_new_vars[pmn_last]
        tc.pending_map_new_nodes[pmn_idx] = tc.pending_map_new_nodes[pmn_last]
      end
      vec_pop(tc.pending_map_new_vars)
      vec_pop(tc.pending_map_new_nodes)
      return
    end
    pmn_idx -= 1
  end
end

## Item 10 (enum-niche tail): should `option_some(arg)`'s typecheck result carry
## `arg`'s concrete type as a refined `Option<P>`, or stay the loose bare `Option`?
##
## Carry the payload ONLY for nominally-resolvable concrete types:
##   - scalars/primitives (Int, Bool, String, Symbol, floats, fixed-width ints,
##     C types) — the actual hole this item closes (`option_some(42)` →
##     `Option<Int>` so a mismatched push into `Vec<Option<String>>` rejects);
##   - newtypes (1000..6999), nominal structs (7000..99999), and any ptype
##     (>= PTYPE_BASE: Fn ptypes [the 5a case], `Vec<T>`, nominal generic
##     structs) — all carry a resolvable nominal identity.
##
## Do NOT carry the BARE aggregate-base constants (the existential-collapse
## placeholders): TYPE_STRUCT, TYPE_ENUM, TYPE_OPTION, TYPE_RESULT, TYPE_ARRAY,
## TYPE_FUNCTION, TYPE_GENERIC, TYPE_NEVER. A struct LITERAL arg
## (`option_some(User{..})`) resolves through tc_expr to the bare TYPE_STRUCT(=7),
## not its nominal 7000+ id; wrapping it gives `Option<Struct>` whose inner
## "Struct" cannot be resolved by the un-annotated-local niche READ path (6.3c)
## → `error[QZ0301]: Unknown struct: Struct` on otherwise-valid code. For these
## payloads the bare `Option` + MIR-side payload recovery is the correct
## mechanism, so we keep the result loose. Bare TYPE_FUNCTION (a signature-less
## named-`def` reference) is likewise excluded — only signatured Fn PTYPES refine.
##
## Also skip TYPE_ERROR (no error cascade), unbound type variables (generic
## `option_some(t)` stays loose so callers bind T), TYPE_VOID, and TYPE_UNKNOWN.
def tc_option_some_carries_payload(tc: TypecheckState, t: Int): Bool
  return false if t == type_constants::TYPE_ERROR
  return false if t == type_constants::TYPE_VOID
  return false if t == type_constants::TYPE_UNKNOWN
  return false if typecheck_util::tc_tv_is_var(t) == 1
  # Bare aggregate-base placeholders with no nominal identity once wrapped.
  return false if t == type_constants::TYPE_STRUCT
  return false if t == type_constants::TYPE_ENUM
  return false if t == type_constants::TYPE_OPTION
  return false if t == type_constants::TYPE_RESULT
  return false if t == type_constants::TYPE_ARRAY
  return false if t == type_constants::TYPE_FUNCTION
  return false if t == type_constants::TYPE_GENERIC
  return false if t == type_constants::TYPE_NEVER
  return true
end
