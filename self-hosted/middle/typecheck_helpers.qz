##! # Type Checker Helpers
##!
##! Pure validation helpers for expressions, statements, and calls.
##! These are leaf functions that do not call tc_expr or tc_stmt.
##!
##! @see typecheck_walk Main AST walking module

import typecheck
import typecheck_util
import typecheck_builtins
import typecheck_registry
import ast
import compiler_types
import node_constants
import type_constants
import std/diag
import * from str_compat

# ============================================================================
# Expression Type Checking
# ============================================================================

## Infer type of a literal node.
##
## Parameters:
##   node_kind - AST node kind constant
##
## Returns: Type kind for the literal
def tc_infer_literal(node_kind: Int): Int
  return type_constants::TYPE_INT if node_kind == node_constants::NODE_INT_LIT
  return type_constants::TYPE_INT if node_kind == node_constants::NODE_NIL_LIT
  return type_constants::TYPE_BOOL if node_kind == node_constants::NODE_BOOL_LIT
  return type_constants::TYPE_STRING if node_kind == node_constants::NODE_STRING_LIT
  # NODE_CHAR_LIT removed - chars are ints at parse time
  return type_constants::TYPE_SYMBOL if node_kind == node_constants::NODE_SYMBOL_LIT
  return type_constants::TYPE_F64 if node_kind == node_constants::NODE_FLOAT_LIT
  return type_constants::TYPE_ERROR
end

## Check if node kind is a literal.
##
## Parameters:
##   node_kind - AST node kind constant
##
## Returns: true if literal
def tc_is_literal(node_kind: Int): Bool
  return true if node_kind == node_constants::NODE_INT_LIT
  return true if node_kind == node_constants::NODE_BOOL_LIT
  return true if node_kind == node_constants::NODE_STRING_LIT
  # NODE_CHAR_LIT removed - chars are ints at parse time
  return true if node_kind == node_constants::NODE_SYMBOL_LIT
  return true if node_kind == node_constants::NODE_FLOAT_LIT
  return false
end

## Check binary expression types.
## Verifies operands are compatible with the operator.
##
## Parameters:
##   tc        - Type checker context
##   op        - Operator string ("+", "-", "==", etc.)
##   left_type - Type of left operand
##   right_type - Type of right operand
##   line      - Source line for errors
##   col       - Source column for errors
##
## Returns: Result type of the expression
## Resolve and constrain type variables for binary operators.
## Returns the resolved type, binding the variable if the operator constrains it.
def tc_resolve_binary_operand(tc: TypecheckState, t: Int, op: String): Int
  var resolved = t
  if typecheck_util::tc_tv_is_var(resolved) == 1
    resolved = typecheck_util::tc_tv_resolve(tc, resolved)
  end
  # Still a type variable after resolution — constrain based on operator
  if typecheck_util::tc_tv_is_var(resolved) == 1
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
      typecheck_util::tc_tv_bind(tc, resolved, type_constants::TYPE_INT)
      return type_constants::TYPE_INT
    end
    if op == "and" or op == "or"
      typecheck_util::tc_tv_bind(tc, resolved, type_constants::TYPE_BOOL)
      return type_constants::TYPE_BOOL
    end
    if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
      typecheck_util::tc_tv_bind(tc, resolved, type_constants::TYPE_INT)
      return type_constants::TYPE_INT
    end
    if op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>"
      typecheck_util::tc_tv_bind(tc, resolved, type_constants::TYPE_INT)
      return type_constants::TYPE_INT
    end
  end
  return resolved
end

def tc_check_binary(op: String, left_type: TypeId, right_type: TypeId, line: Int, col: Int): Int can Diag
  # Comparison operators return Bool
  return type_constants::TYPE_BOOL if op == "=="
  return type_constants::TYPE_BOOL if op == "!="
  return type_constants::TYPE_BOOL if op == "<"
  return type_constants::TYPE_BOOL if op == ">"
  return type_constants::TYPE_BOOL if op == "<="
  return type_constants::TYPE_BOOL if op == ">="

  # Regex match operators: (String, Regex) -> Bool
  if op == "=~"
    if left_type != type_constants::TYPE_STRING
      error("Left operand of '=~' must be String", line, col)
    end
    if right_type != type_constants::TYPE_REGEX
      error("Right operand of '=~' must be Regex", line, col)
    end
    return type_constants::TYPE_BOOL
  end
  if op == "!~"
    if left_type != type_constants::TYPE_STRING
      error("Left operand of '!~' must be String", line, col)
    end
    if right_type != type_constants::TYPE_REGEX
      error("Right operand of '!~' must be Regex", line, col)
    end
    return type_constants::TYPE_BOOL
  end

  # Logical operators - allow Int for truthy semantics (C bootstrap compatibility)
  if op == "and"
    if left_type != type_constants::TYPE_BOOL and left_type != type_constants::TYPE_INT
      error("Left operand of 'and' must be Bool or Int", line, col)
    end
    if right_type != type_constants::TYPE_BOOL and right_type != type_constants::TYPE_INT
      error("Right operand of 'and' must be Bool or Int", line, col)
    end
    return type_constants::TYPE_BOOL
  end
  if op == "or"
    if left_type != type_constants::TYPE_BOOL and left_type != type_constants::TYPE_INT
      error("Left operand of 'or' must be Bool or Int", line, col)
    end
    if right_type != type_constants::TYPE_BOOL and right_type != type_constants::TYPE_INT
      error("Right operand of 'or' must be Bool or Int", line, col)
    end
    return type_constants::TYPE_BOOL
  end

  # String concatenation: String + String -> String (handled below in arithmetic block)

  # F64 arithmetic operators — both operands must be F64
  if left_type == type_constants::TYPE_F64 or right_type == type_constants::TYPE_F64
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
      if left_type != type_constants::TYPE_F64
        error("Left operand must be F64 when right is F64 (no implicit coercion)", line, col)
      end
      if right_type != type_constants::TYPE_F64
        error("Right operand must be F64 when left is F64 (no implicit coercion)", line, col)
      end
      return type_constants::TYPE_F64
    end
  end

  # F32 arithmetic operators — both operands must be F32
  if left_type == type_constants::TYPE_F32 or right_type == type_constants::TYPE_F32
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
      if left_type != type_constants::TYPE_F32
        error("Type mismatch in binary operation: F32 vs #{typecheck::tc_type_name(left_type)}", line, col)
      end
      if right_type != type_constants::TYPE_F32
        error("Type mismatch in binary operation: F32 vs #{typecheck::tc_type_name(right_type)}", line, col)
      end
      return type_constants::TYPE_F32
    end
  end

  # Arithmetic operators - reject String operands in numeric context.
  # Note: + is excluded (String + non-String auto-coerces via to_str in typecheck_walk)
  # and * is excluded (String * Int → str_repeat).
  if op == "-" or op == "/" or op == "%"
    if left_type == type_constants::TYPE_STRING or right_type == type_constants::TYPE_STRING
      error("can't do math with a String -- need an Int", line, col)
      return type_constants::TYPE_ERROR
    end
    if left_type == type_constants::TYPE_VOID
      error("Left operand of '#{op}' must be Int", line, col)
      return type_constants::TYPE_ERROR
    end
    if right_type == type_constants::TYPE_VOID
      error("Right operand of '#{op}' must be Int", line, col)
      return type_constants::TYPE_ERROR
    end
  end
  if op == "+"
    if left_type == type_constants::TYPE_STRING and right_type == type_constants::TYPE_STRING
      return type_constants::TYPE_STRING
    end
    return type_constants::TYPE_INT
  end
  return type_constants::TYPE_INT if op == "-"
  if op == "*"
    if left_type == type_constants::TYPE_STRING and right_type == type_constants::TYPE_INT
      return type_constants::TYPE_STRING
    end
    if left_type == type_constants::TYPE_INT and right_type == type_constants::TYPE_STRING
      return type_constants::TYPE_STRING
    end
    return type_constants::TYPE_INT
  end
  return type_constants::TYPE_INT if op == "/"
  return type_constants::TYPE_INT if op == "%"

  # Range operators
  return type_constants::TYPE_RANGE if op == ".."
  return type_constants::TYPE_RANGE if op == "..."

  # Nil coalescing `opt ?? default` yields the DEFAULT operand's concrete type
  # (payload-type de-erasure Phase 0): the result is whatever the default provides,
  # which must be payload-compatible. Returning the concrete `right_type` (instead of
  # the old blanket TYPE_INT existential erasure) lets `opt ?? "s"` type as String, not
  # a machine int — a prerequisite for removing the R2.3/field-store literal-narrowing
  # carve-out once all payload producers are de-erased. Returns TYPE_INT in exactly the
  # old cases (int/erased default), so it can only tighten, never regress. The compiler
  # itself never uses the `??` operator, so this is gate-1-inert (fixpoint byte-identical).
  return right_type if op == "??"

  # Bitwise operators - all take and return Int
  return type_constants::TYPE_INT if op == "&"
  return type_constants::TYPE_INT if op == "|"
  return type_constants::TYPE_INT if op == "^"
  return type_constants::TYPE_INT if op == "<<"
  return type_constants::TYPE_INT if op == ">>"

  return type_constants::TYPE_ERROR
end

## Check unary expression types.
##
## Parameters:
##   tc           - Type checker context
##   op           - Operator string ("not", "-")
##   operand_type - Type of operand
##   line         - Source line for errors
##   col          - Source column for errors
##
## Returns: Result type of the expression
def tc_check_unary(op: String, operand_type: TypeId, line: Int, col: Int): Int can Diag
  if op == "not"
    error("Operand of 'not' must be Bool", line, col) if operand_type != type_constants::TYPE_BOOL
    return type_constants::TYPE_BOOL
  end
  if op == "-"
    if operand_type == type_constants::TYPE_F64
      return type_constants::TYPE_F64
    end
    if operand_type == type_constants::TYPE_F32
      return type_constants::TYPE_F32
    end
    error("Operand of unary '-' must be Int, F64, or F32", line, col) if operand_type != type_constants::TYPE_INT
    return type_constants::TYPE_INT
  end
  if op == "~"
    error("Operand of '~' must be Int", line, col) if operand_type != type_constants::TYPE_INT
    return type_constants::TYPE_INT
  end
  return type_constants::TYPE_ERROR
end

# ============================================================================
# Statement Type Checking
# ============================================================================

## Check a let statement.
## Verifies initializer type matches declared type (if any).
##
## Parameters:
##   tc            - Type checker context
##   has_type_ann  - Whether type annotation was provided
##   declared_type - Declared type kind (if annotated)
##   init_type     - Inferred type of initializer
##   var_name      - Variable name being bound
##   line          - Source line for errors
##   col           - Source column for errors
##
## Returns: true if valid
def tc_check_let(tc: TypecheckState, has_type_ann: Bool, declared_type: TypeId, init_type: TypeId, var_name: String, line: Int, col: Int): Bool can Diag = tc_check_let_full(tc, has_type_ann, declared_type, init_type, var_name, "", "", line, col)

## Check a let binding with full type annotation support.
## For parameterized types (Vec<T>, HashMap<K,V>), the annotations are compared.
def tc_check_let_full(tc: TypecheckState, has_type_ann: Bool, declared_type: TypeId, init_type: TypeId, var_name: String, declared_ann: String, init_ann: String, line: Int, col: Int): Bool can Diag
  if has_type_ann
    if typecheck::tc_types_match_with_annotations(tc, declared_type, init_type, declared_ann, init_ann) == false
      error("Type mismatch: expected #{typecheck::tc_type_name_full(tc, declared_type)} but got #{typecheck::tc_type_name_full(tc, init_type)}", line, col)
      return false
    end
  end
  return true
end

## Check an assignment statement.
## Verifies target is mutable and value type matches.
##
## Parameters:
##   tc          - Type checker context
##   is_mutable  - Whether target is mutable
##   target_type - Type of assignment target
##   value_type  - Type of value being assigned
##   target_name - Variable name being assigned
##   line        - Source line for errors
##   col         - Source column for errors
##
## Returns: true if valid
def tc_check_assign(tc: TypecheckState, is_mutable: Bool, target_type: TypeId, value_type: TypeId, target_name: String, line: Int, col: Int): Bool can Diag
  if is_mutable == false
    error("Cannot assign to immutable variable: #{target_name}", line, col)
    return false
  end

  # Look up target's type annotation for parameterized type checking
  var target_ann = typecheck_util::tc_scope_lookup_annotation(tc, target_name)
  # Value annotation would need to be passed from caller (future enhancement)
  var value_ann = ""

  if typecheck::tc_types_match_with_annotations(tc, target_type, value_type, target_ann, value_ann) == false
    error("Type mismatch in assignment: expected #{typecheck::tc_type_name_full(tc, target_type)} but got #{typecheck::tc_type_name_full(tc, value_type)}", line, col)
    return false
  end
  return true
end

## Recover the NOMINAL struct type id for a struct-literal value node whose
## typechecked result was erased to bare TYPE_STRUCT (=7).
##
## GAP-struct-init-erasure (item 3a, WIDTH): `tc_check_struct_init` returns bare
## TYPE_STRUCT, discarding the struct's nominal identity even though the idx is
## in-hand. The record-subtyping seam (`tc_struct_satisfies_record` /
## `tc_record_mismatch_reason`) then can't width-check a struct literal flowing
## into a record slot, because `tc_struct_idx_from_type(7) == -1` → permissive
## fall-through. This helper re-derives the nominal id AT the seam, from the
## NODE_STRUCT_INIT node itself (the same name-recovery pattern used at
## typecheck_expr_handlers.qz:51 / :2436), so a real width check can run.
##
## Surgical + conservative:
##   - Fires ONLY when `bare_type` is exactly bare TYPE_STRUCT AND the target
##     `expected` is a record type AND `value_node` is a NODE_STRUCT_INIT whose
##     struct name resolves in the registry.
##   - In every other case (already nominal, non-struct-init value, unknown
##     struct, non-record target) returns `bare_type` UNCHANGED — so no valid
##     case is newly rejected and unrecoverable ids keep CURRENT behavior.
##   - Gate-0-inert: the compiler/stdlib carry zero struct-literal-into-record
##     constructs, so `expected` is never a record for self-host returns → this
##     never fires during self-compile, and struct-init's own return type stays
##     bare-7 everywhere else.
def tc_promote_struct_init_for_record(tc: TypecheckState, ast_storage: ast::AstStorage, value_node: AstNodeId, bare_type: TypeId, expected: TypeId): TypeId
  # Only intervene for a bare-7 struct literal flowing into a record slot.
  return bare_type if bare_type != type_constants::TYPE_STRUCT
  return bare_type if typecheck_registry::tc_is_record_type(expected) == false
  return bare_type if value_node < 0
  if ast::ast_get_kind(ast_storage, value_node) != node_constants::NODE_STRUCT_INIT
    return bare_type
  end
  var struct_name = ast::ast_get_str1(ast_storage, value_node)
  var lookup = typecheck_registry::tc_lookup_struct(tc, struct_name)
  var struct_idx = match lookup
    typecheck_util::LookupResult::Found(v) => v
    typecheck_util::LookupResult::NotFound => -1
  end
  return bare_type if struct_idx < 0
  return typecheck::tc_struct_type_id(struct_idx)
end

## Sibling of tc_promote_struct_init_for_record for the VARIABLE case: a
## struct-typed binding read (`var b = Narrow{...}; ... b ...`) resolves to bare
## TYPE_STRUCT — its nominal identity lives in `binding_struct_names`, not the
## TypeId. When such an ident flows into a record slot, recover the nominal id
## from the binding's struct name (via tc_scope_lookup_struct_name) so a real
## tc_struct_satisfies_record width check can run.
##
## Pure + conservative — returns `bare_type` UNCHANGED in every non-fire case:
##   - not a bare-7 struct value, or
##   - target `expected` is not a record, or
##   - value node is not a NODE_IDENT, or
##   - the binding has no struct-name string, or the name is unregistered.
## Gate-0-inert: compiler/stdlib carry zero record params/returns/element-Vecs,
## so `expected` is never a record for self-host callsites → never fires during
## self-compile (byte-identical fixpoint). Sibling to the struct-init helper;
## kept separate because the node kind (NODE_IDENT vs NODE_STRUCT_INIT) and the
## name source (binding_struct_names vs node str1) differ.
def tc_promote_struct_ident_for_record(tc: TypecheckState, ast_storage: ast::AstStorage, value_node: AstNodeId, bare_type: TypeId, expected: TypeId): TypeId
  # Only intervene for a bare-7 struct variable flowing into a record slot.
  return bare_type if bare_type != type_constants::TYPE_STRUCT
  return bare_type if typecheck_registry::tc_is_record_type(expected) == false
  return bare_type if value_node < 0
  if ast::ast_get_kind(ast_storage, value_node) != node_constants::NODE_IDENT
    return bare_type
  end
  var vname = ast::ast_get_str1(ast_storage, value_node)
  var sname = typecheck_util::tc_scope_lookup_struct_name(tc, vname)
  return bare_type if str_byte_len(sname) == 0
  var lookup = typecheck_registry::tc_lookup_struct(tc, sname)
  var struct_idx = match lookup
    typecheck_util::LookupResult::Found(v) => v
    typecheck_util::LookupResult::NotFound => -1
  end
  return bare_type if struct_idx < 0
  return typecheck::tc_struct_type_id(struct_idx)
end

## Check a return statement.
## Verifies return value matches function's declared return type.
##
## Parameters:
##   tc          - Type checker context
##   return_type - Type of the returned expression
##   line        - Source line for errors
##   col         - Source column for errors
##
## Returns: true if valid
def tc_check_return(tc: TypecheckState, return_type: TypeId, line: Int, col: Int): Bool can Diag
  var expected = typecheck_util::tc_get_return_type(tc)

  # C bootstrap compatibility: don't check if return_type is an error
  # This allows propagation of type errors without cascading errors
  return true if return_type == type_constants::TYPE_ERROR

  # Skip check if expected return type is unset (Void = default)
  return true if expected == type_constants::TYPE_VOID

  if typecheck::tc_types_match(tc, expected, return_type) == false
    var exp_name = typecheck::tc_type_name_full(tc, expected)
    var got_name = typecheck::tc_type_name_full(tc, return_type)
    # E1: when the expected type is a record, name the offending field so the
    # user sees WHICH field is missing / mistyped, not just a shape diff.
    var reason = typecheck_registry::tc_record_mismatch_reason(tc, expected, return_type)
    if str_byte_len(reason) > 0
      error("Return type mismatch: record '#{got_name}' does not satisfy '#{exp_name}' — #{reason}", line, col)
    else
      error("Return type mismatch: expected #{exp_name} but got #{got_name}", line, col)
    end
    return false
  end
  return true
end

## Check a condition expression.
## Verifies condition is Bool (or Int for C compatibility).
##
## Parameters:
##   tc        - Type checker context
##   cond_type - Type of the condition expression
##   stmt_kind - "if" or "while" for error message
##   line      - Source line for errors
##   col       - Source column for errors
##
## Returns: true if valid
def tc_check_condition(tc: TypecheckState, cond_type: TypeId, stmt_kind: String, line: Int, col: Int): Bool can Diag
  # STRICT_NEWTYPES — branching on a strict newtype value would expose its
  # bits to the program counter. Reject. The user must explicitly unwrap
  # via `as_type<T>(secret_val)` (or the wrapper `secret_unwrap`); the
  # callsite is then greppable as the audit boundary. See
  # docs/design/STRICT_NEWTYPES_DESIGN.md.
  if typecheck::tc_is_strict_newtype(tc, cond_type)
    error("Cannot use a strict-newtype value as a #{stmt_kind} condition — would leak its bits via control flow. Unwrap first (e.g. `as_type<Int>(s)`), or compare via a constant-time helper from `std/core/crypto/subtle`.", line, col)
    return false
  end
  # Truthy/falsy: any other type allowed in conditions
  # 0, false, nil = falsy; everything else = truthy
  # At runtime, all types are i64, so icmp ne 0 works universally
  return true
end

# ============================================================================
# Function Call Checking
# ============================================================================

## Check a function call.
## Verifies function exists, argument count matches, and types match.
##
## Parameters:
##   tc        - Type checker context
##   arg_count - Number of arguments provided
##   param_count - Number of parameters expected
##   func_name - Name of function being called
##   line      - Source line for errors
##   col       - Source column for errors
##
## Returns: true if valid
def tc_check_call(arg_count: Int, param_count: Int, func_name: String, line: Int, col: Int): Bool can Diag
  if arg_count != param_count
    error("Wrong number of arguments for #{func_name}: expected #{param_count} but got #{arg_count}", line, col)
    return false
  end
  return true
end

## Resolve return type for a function call.
## Checks builtins first, then user-defined functions.
##
## Parameters:
##   tc        - Type checker context
##   func_name - Name of function being called
##
## Returns: Return type kind, or type_constants$TYPE_ERROR if not found
def tc_resolve_call_type(tc: TypecheckState, func_name: String): Int
  # Check builtins first
  var builtin_type = typecheck_builtins::tc_lookup_builtin(tc, func_name)
  return builtin_type if builtin_type != type_constants::TYPE_ERROR

  # Check user functions
  var func_return = typecheck_registry::tc_lookup_function_return(tc, func_name)
  return func_return
end

# ============================================================================
# Index and Field Access
# ============================================================================

## Check index expression.
## Verifies array type and integer index.
##
## Parameters:
##   tc         - Type checker context
##   array_type - Type of the array expression
##   index_type - Type of the index expression
##   line       - Source line for errors
##   col        - Source column for errors
##
## Returns: Element type
def tc_check_index(tc: TypecheckState, array_type: TypeId, index_type: TypeId, line: Int, col: Int): Int can Diag
  # Resolve type if it's a bound type variable (tc_tv_* system)
  var resolved_array_type = typecheck::tc_base_kind(tc, array_type)
  if typecheck_util::tc_tv_is_var(array_type) == 1
    resolved_array_type = typecheck::tc_base_kind(tc, typecheck_util::tc_tv_resolve(tc, array_type))
  end

  # Check index type: allow Int and Range (for slicing)
  if index_type == type_constants::TYPE_RANGE
    # Slice: v[start..end] returns same collection type
    return resolved_array_type
  end
  var effective_index_type = typecheck::tc_unwrap_newtype(tc, index_type)
  if effective_index_type != type_constants::TYPE_INT
    if effective_index_type != type_constants::TYPE_ERROR
      error("Array index must be Int", line, col)
      return type_constants::TYPE_ERROR
    end
  end

  # If still a type variable after resolution, infer Vec<'elem>
  if typecheck_util::tc_tv_is_var(resolved_array_type) == 1
    # Create fresh type variable for element type
    var elem_var = typecheck_util::tc_tv_fresh(tc)
    # Create Vec<'elem> parameterized type
    var vec_of_elem = typecheck::tc_make_ptype(tc, type_constants::TYPE_VEC, elem_var, 0)
    # Unify: array_type = Vec<'elem>
    var unified = typecheck_util::tc_tv_unify(tc, resolved_array_type, vec_of_elem)
    if unified == 0
      error("Cannot unify type with Array", line, col)
      return type_constants::TYPE_ERROR
    end
    return elem_var
  end

  # Check it's actually an array-like type
  # Allow: type_constants$TYPE_ARRAY (array literal), type_constants$TYPE_INT (raw handle), type_constants$TYPE_VEC, type_constants$TYPE_HASHMAP
  # Bare type_constants$TYPE_ARRAY (non-parameterized array literal) - return Int elements
  # This handles `var arr = [1,2,3]; arr[0]` before parameterized types are tracked
  return type_constants::TYPE_INT if resolved_array_type == type_constants::TYPE_ARRAY

  # Raw Int/HashMap return Int elements
  return type_constants::TYPE_INT if resolved_array_type == type_constants::TYPE_INT or resolved_array_type == type_constants::TYPE_HASHMAP

  # Vec: check if parameterized (Vec<T>) to return element type T
  if resolved_array_type == type_constants::TYPE_VEC
    if typecheck::tc_is_ptype(array_type)
      var elem_type = typecheck::tc_ptype_arg1(tc, array_type)
      if elem_type != 0
        return elem_type
      end
    end
    return type_constants::TYPE_INT
  end

  # For parameterized types, check element type via ptype system
  if typecheck::tc_is_ptype(array_type)
    var elem_type = typecheck::tc_ptype_arg1(tc, array_type)
    if elem_type != 0
      return elem_type
    end
  end

  # Unknown type - not indexable
  error("Cannot index non-array type", line, col)
  return type_constants::TYPE_ERROR
end

## Returns 1 for Int, Bool, String, F64, Void — types where tc_expr's return
## value reliably reflects the actual value type. Returns 0 for struct, enum,
## function, container types, etc. where the existential model means tc_expr
## may return TYPE_INT for struct values.
def tc_is_simple_primitive(t: Int): Int
  return 1 if t == type_constants::TYPE_INT
  return 1 if t == type_constants::TYPE_BOOL
  return 1 if t == type_constants::TYPE_STRING
  return 1 if t == type_constants::TYPE_F64
  return 1 if t == type_constants::TYPE_VOID
  # NonZero (B.10 §14 N2) — counts as a simple primitive so the let-binding
  # cross-check (typecheck_walk.qz) fires `tc_tv_unify(init, NonZero)`, which
  # rejects any distinct concrete init type. This is the nominal wall that keeps
  # a bare Int (including `0`/`nil`, both Int) out of a NonZero slot — the ONLY
  # producers are `nonzero_new` (checked) / `nonzero_new_unchecked` (explicit).
  # Without it, `let nz: NonZero = 0` would mint a zero NonZero that misreads as
  # `None`. `Option<NonZero>` lets are unaffected (a ptype, not simple → skipped).
  return 1 if t == type_constants::TYPE_NONZERO
  return 0
end

## QZ0213 (B.15c, nil-literal wall) — returns 1 if a bare `nil` literal must
## NOT flow into a slot of type `t`. `nil` is only legitimate as a C-NULL
## pointer (FFI) or the integer `0`; flowing it into a heap/reference type
## (String, struct, enum, Option, Vec, …) is the billion-dollar mistake
## B.15 closes — use `Option<T>` + `None` instead.
##
## This is the *nil-literal* subset of the eventual bare-`Int` wall: it keys
## off the syntactic `NodeNilLit` operand at the call site, so the existential
## "tc_expr returns TYPE_INT for boxed values" gap (see tc_is_simple_primitive)
## does NOT cause false positives — a bare `0`/`Int`-variable is a different
## node kind and is left for the N3-era de-existentialized wall. See
## docs/design/B15_NIL_ELIMINATION.md §7.
##
## Forbidden = heap/reference types. Allowed (return 0) = scalars, the C FFI
## types (incl. CPtr null — the sanctioned FFI sentinel), fixed-width ints,
## Int-handle types, type variables, and the error/unknown sentinels.
## B.15d/N3.1 step-4 — the bare-Int wall phase control (single point of truth).
##
## The wall has three phases (Dart/C#/Kotlin staged-nullable playbook):
##   Phase 1 (2026-06-11, NOW): always-on WARNING. Every build surfaces the
##     QZ0214/QZ0215 bare-Int→boxed worklist; the build stays green. This
##     replaces the prior QZ_N3_AUDIT env gate (the worklist is now permanently
##     visible, driving the incremental Option<T> migration).
##   Phase 2: drain the worklist (genuine existential-0 sentinels → Option<T>,
##     positional tuples → structs, remaining handles → real types).
##   Phase 3: flip warn→error (the irreversible bare-Int wall) once the count
##     reaches ~0 and the exemptions (forced-Int tuples, sanctioned handles)
##     are in place.
## Flipping a phase is a one-line change here, not a sweep across 6 call sites.
def tc_n3_wall_warn_enabled(): Bool = true

## V3 (§14.12.5) — typecheck-layer mirror of mir_value_semantics_live(). The
## QZ0221 erased-@value-boundary diagnostic is INERT until the value-semantics
## flip: while value semantics is dead (gate-0), erasing a `@value` struct to a
## word is a no-op (the compiler uses ZERO @value structs), so the diagnostic
## MUST NOT fire — committed gate-0 behavior is byte-identical and no existing
## spec newly errors. typecheck (middle) cannot import the backend mir module, so
## this is a parallel gate; flip it to 1 in lockstep with mir_value_semantics_live
## at V4. Returns 1 (V4-flipped, commit 5ba5ced8) but is gate-0-INERT: zero @value
## structs exist and the F4 plain-struct gate mir_default_struct_value_live() stays
## 0, so no QZ0221 fires and committed gate-0 behavior is byte-identical.
def tc_value_semantics_live(): Int
  return 1
end

## B.15d/N3.1 step-4 — Phase 3a: the QZ0214 wall FLIP (warn → ERROR).
## When enabled, a bare int-literal (the existential `0`-sentinel) flowing into
## a boxed slot is a hard ERROR, not a warning — scoped COMPILER-MODULES-FIRST
## (`self-hosted/*`, see tc_n3_wall_is_error). The compiler's QZ0214 worklist is
## drained to 0 (§11.44), so this is a pure RATCHET: it has zero effect on the
## current build and simply makes it impossible to (re)introduce a literal-`0`→
## boxed sentinel in a compiler module. `std/` + user code stay on the WARNING
## until their own worklists drain. QZ0215 (the Int-VARIABLE → boxed case) stays
## warn-only until the typecheck_registry `Vec<Vec<String>>` cascade lands
## (§11.44 Phase 3b) — flip it by widening tc_n3_wall_is_error's callers there.
def tc_n3_wall_error_enabled(): Bool = true

## True iff the QZ0214 wall should emit a hard ERROR at this site: the flip is on
## AND the current file is a compiler module (`self-hosted/*`). The single seam
## the 3 QZ0214 audit sites (let / return / call-arg) consult. Keeping `std/` and
## user code on the warning is the Dart/Kotlin/C# leaf-first migration: error the
## drained core first, widen scope as the rest drains.
def tc_n3_wall_is_error(tc: TypecheckState): Bool
  return false if tc_n3_wall_error_enabled() == false
  return str_contains(tc.current_file, "self-hosted/")
end

## B.15d/N3.1 step-4 — item 5a: the STRUCTURAL wall flip switch.
## A SEPARATE leaf-first switch for the two NEW structural-audit positions —
## struct-field initializers and array/vector-element literals. These sites
## landed warn-only AFTER the let/return/call-arg trio was already flipped for
## compiler modules (tc_n3_wall_is_error). The structural worklist has now been
## metered and drained to 0 fires in compiler modules (item 5b), so item 5c
## FLIPS this switch to mirror tc_n3_wall_is_error: a hard ERROR in `self-hosted/`
## files, a WARNING in `std/` + user code. Pure RATCHET — the self-build fires
## the structural audit 0 times, so erroring in compiler modules has zero effect
## on the guard fixpoint and simply makes reintroducing a bare-Int structural
## sentinel impossible in a compiler module.
def tc_n3_wall_structural_is_error(tc: TypecheckState): Bool
  return tc_n3_wall_is_error(tc)
end

## B.15d/N3.1 step-4 — item 5a: shared QZ0215 emit for the structural sites.
## Mirrors the exact error()/warn() call shape of the existing QZ0215 let-site
## (typecheck_walk.qz). Keyed on the structural flip switch above (warn-only for
## now). `slot_name` identifies the field or array slot the bare-Int landed in.
def tc_n3_wall_emit_struct_int_into_boxed(tc: TypecheckState, slot_name: String, line: Int, col: Int): Void can Diag
  if tc_n3_wall_structural_is_error(tc)
    error("QZ0215: Int-typed value into boxed slot `#{slot_name}` — the existential erased-value/Int-var sentinel is forbidden here; de-existentialize the source or migrate to `Option<...>`", line, col)
  else
    warn("QZ0215 (N3.1 step-4 structural audit): Int-typed value into boxed slot `#{slot_name}` — existential erased-value/Int-var sentinel; de-existentialize or migrate to Option", line, col)
  end
end

## B.15d/N3.1 step-4 — Phase-3 exemption policy (§11.24 finding 2 / §11.27).
## The effect-handler existential ABI is the language's DELIBERATE i64 transport:
## as_int/as_string/as_vec/as_type/as_int_generic read a raw i64 back out of a
## boxed slot (single source of truth: intrinsic_registry.qz, INTRINSIC_CAT_CONVERSION).
## Feeding a `Vec<Int>` element into one of these bridges is the SANCTIONED read,
## not an erased-value sentinel — so the bare-Int wall must not flag the bridge's
## own arguments. Returns true iff `name` is one of the five conversion bridges.
def tc_n3_is_bridge_name(name: String): Bool
  return true if name == "as_int"
  return true if name == "as_int_generic"
  return true if name == "as_string"
  return true if name == "as_type"
  return true if name == "as_vec"
  return false
end

## V3 (§14.12.5) — emit the QZ0221 erased-@value-boundary diagnostic. A `@value`
## struct is either inline (≤16B = 1-2 registers) or, post-COW, a refcounted heap
## pointer; the conversion bridges (as_int/as_string/as_type/as_vec/as_int_generic
## — single source of truth: tc_n3_is_bridge_name, the INTRINSIC_CAT_CONVERSION
## set) are an identity bit-reinterpret assuming a single 8-byte i64 handle
## (cg_intrinsic_core.qz). Routing a `@value` value through one either TRUNCATES
## the inline payload or LOSES the COW refcount ownership (→ UAF/double-free) — and
## boxing it instead would reintroduce the existential indirection value types
## exist to kill. So this is a hard ERROR, not a box (§14.12.5: forbid, don't box;
## false-error OK, false-accept forbidden). INERT until tc_value_semantics_live()
## (the gate-0 committed state never fires it; the compiler uses zero @value
## structs so even live it has no effect on self-compile). `bridge` names the
## erasing intrinsic; `vty` the @value type.
def tc_v3_emit_erased_value_boundary(tc: TypecheckState, bridge: String, vname: String, line: Int, col: Int): Void can Diag
  var nm = vname
  nm = "value-layout struct" if str_byte_len(nm) == 0
  error("QZ0221: value-layout struct `#{nm}` cannot be erased through `#{bridge}` — the bridge reinterprets its argument as a bare 8-byte handle, which truncates an inline value or drops the copy-on-write refcount (use-after-free). Value identity would be silently lost and indirection reintroduced; boxing is forbidden. Keep the value type or restructure to avoid the erased boundary.", line, col)
end

## Categorical file exemption: `std/` and `shared/` are ~97% sanctioned effect-ABI
## transport (cluster-E analysis), and the Phase-3 warn->error flip excludes them
## outright. Suppress the QZ0215 audit there so the meter reflects only the
## compiler-module SENTINEL/TUPLE remainder the flip must actually force.
def tc_n3_file_exempt(tc: TypecheckState): Bool
  var f = tc.current_file
  return true if str_contains(f, "std/")
  return true if str_contains(f, "shared/")
  return false
end

## B.15d/N3.1 step-4 — sanctioned compiler IR/arena HANDLE struct types.
##
## A handful of compiler-internal structs are used as opaque i64 handles whose
## ZERO value is a *structural* sentinel, not a value-niche collision:
##   - `MirBlock`  — a MIR control-flow block. `0` is the deliberate null-block:
##       an unset branch target (`mir_new_block` defaults branch_true/false to
##       0), a "labeled loop not found, use the ambient target" miss, an async
##       resume target that is "no resume". These flow as bare `Int`/`Vec<Int>`
##       handles on the lowering hot path; the genuinely-correct encoding is
##       `Option<MirBlock>`, but it is a deliberate ambient-handle corner the
##       flip does NOT force (per §11.22 reframe).
##   - `AstStorage` — the AST arena handle. `compiler_types.qz` cannot `import
##       ast` (module cycle), so the arena crosses module boundaries as a bare
##       i64 (named `AstStore` newtype where possible). It is never legitimately
##       null in practice; reads come from known-good storage vectors.
##
## These are the compiler's "platform types" (Kotlin `T!` / CPtr-null analog):
## a sanctioned trust-boundary where i64↔handle transport is the deliberate ABI.
## The boxed-pointer `None`-niche flip is about boxed VALUE types where `0`
## collides with a real payload; an IR control-flow / arena handle has no such
## payload, so `0` stays a legal structural sentinel and bare-`Int`/`nil` into
## one of these slots is exempt from the QZ0213/4/5 wall (and, post-flip, from
## the narrowed bare-Int→Struct coercion error). Keyed on the nominal struct
## name — in a user program these names are undefined, so no false exemption.
def tc_n3_is_sanctioned_handle_type(tc: TypecheckState, t: Int): Bool
  var idx = typecheck::tc_struct_idx_from_type(t)
  if idx < 0 or idx >= tc.registry.struct_names.size
    return false
  end
  # Nominal struct names are stored module-mangled (`mir$MirBlock`,
  # `ast$AstStorage`); the bare names are a defensive fallback. Single source of
  # truth shared with the QZ0221 value-layout exclusion in typecheck_registry.
  var n = tc.registry.struct_names[idx]
  return typecheck_registry::tc_is_sanctioned_handle_name(n)
end

def tc_nil_forbidden_type(tc: TypecheckState, t: Int): Int
  # B.15d/N3.1 step-4 — sanctioned IR/arena handle structs admit a null/Int
  # value by design (structural zero-sentinel, no value-niche). Exempt from the
  # whole nil/bare-Int wall. Single point so the audit AND the post-flip coercion
  # narrowing both see it. See tc_n3_is_sanctioned_handle_type.
  return 0 if tc_n3_is_sanctioned_handle_type(tc, t)
  # Heap/reference base types where nil-as-null is forbidden.
  return 1 if t == type_constants::TYPE_STRING
  return 1 if t == type_constants::TYPE_FUNCTION
  return 1 if t == type_constants::TYPE_STRUCT
  # B.15d/N3.1 step-4a — per-struct nominal ids (STRUCT_TYPE_BASE+idx) are
  # heap/reference types too; without this the nil/bare-Int wall (QZ0213/4/5)
  # would let nil flow into a nominally-typed struct slot post-flip.
  return 1 if t >= type_constants::STRUCT_TYPE_BASE and t < type_constants::PTYPE_BASE
  return 1 if t == type_constants::TYPE_ENUM
  return 1 if t == type_constants::TYPE_OPTION
  return 1 if t == type_constants::TYPE_RESULT
  return 1 if t == type_constants::TYPE_REGEX
  return 1 if t == type_constants::TYPE_VEC
  return 1 if t == type_constants::TYPE_MAP
  return 1 if t == type_constants::TYPE_SET
  return 1 if t == type_constants::TYPE_INTMAP
  return 1 if t == type_constants::TYPE_TUPLE
  return 1 if t == type_constants::TYPE_FUTURE
  # B.15d/N3.1 step-4c — newtypes (1000..1999) classify by their WRAPPED type,
  # NOT by the range. An Int-backed newtype (AstNodeId, MirReg, MirLabel,
  # InternId, TypeId) is an i64 index/handle whose representation is unchanged
  # by the value-layout flip — a bare Int / nil flowing into it is just an
  # integer, never the billion-dollar mistake. A reference-backed newtype
  # (`newtype Email = String`) inherits its wrapped type's nil-forbiddenness.
  # This is the predicate's own contract (Int-handle types → 0); the prior
  # blanket `return 1` over 1000..4999 FALSE-flagged ~4809 AstNodeId-class
  # call sites in the QZ0215 audit. Unions/records/intersections and all
  # parameterized instances stay forbidden (compound/reference).
  if typecheck::tc_is_newtype(t)
    var nidx = t - type_constants::TYPE_NEWTYPE_BASE
    if nidx >= 0 and nidx < tc.registry.newtype_wrapped_types.size
      var wrapped = typecheck::tc_parse_type(tc, tc.registry.newtype_wrapped_types[nidx])
      if wrapped != t
        return tc_nil_forbidden_type(tc, wrapped)
      end
    end
    return 0
  end
  # Registered user unions / records / intersections (2000–4999) and all
  # parameterized instances (Vec<T>, Option<T>, user Struct<…> ≥ 100000).
  return 1 if t >= type_constants::TYPE_UNION_BASE and t < type_constants::TYPE_FORALL_BASE
  return 1 if t >= type_constants::PTYPE_BASE
  return 0
end

# ============================================================================
# Hashability Checks (Map<K, V> key validation)
# ============================================================================

## Returns true if `t` is a valid hash-map key type.
##
## A type is hashable iff:
##   - it is a primitive with a stable bit-pattern AND total equality
##     (Int, String, Bool, Symbol, the C integer types, U8/U16/U32, I8/I16/I32)
##   - it is an enum (variant tag is the hash key)
##   - it is a struct (delegated to `tc_struct_is_hashable` by the caller)
##
## Floating-point types (F32, F64, CFloat, CDouble) are NOT hashable:
##   - IEEE 754 NaN != NaN breaks lookup reflexivity (insert then get by the
##     same value misses).
##   - +0.0 and -0.0 are equal but have different bit patterns, so any
##     hash-by-bits scheme violates the hash/equals invariant.
## Users who need float-keyed associations can wrap the float in a struct
## with custom equality, or use a sorted-map structure with a total order.
##
## Mutable containers (Vec, Map, Set, IntMap), function values, and the
## never type are NOT hashable.
##
## Used by `tc_parse_type` when validating `Map<K, V>` annotations to reject
## bad key types early. The companion `tc_hashable_rejection_reason` produces
## a human-readable diagnostic for the failing case.
def tc_type_is_hashable(tc: TypecheckState, t: Int): Bool
  return true if t == type_constants::TYPE_INT
  return true if t == type_constants::TYPE_STRING
  return true if t == type_constants::TYPE_BOOL
  return true if t == type_constants::TYPE_SYMBOL
  return true if t == type_constants::TYPE_CINT
  return true if t == type_constants::TYPE_CCHAR
  return true if t == type_constants::TYPE_CSIZE
  return true if t == type_constants::TYPE_I8
  return true if t == type_constants::TYPE_I16
  return true if t == type_constants::TYPE_I32
  return true if t == type_constants::TYPE_U8
  return true if t == type_constants::TYPE_U16
  return true if t == type_constants::TYPE_U32
  return true if t == type_constants::TYPE_ENUM
  return false if t == type_constants::TYPE_F64
  return false if t == type_constants::TYPE_F32
  return false if t == type_constants::TYPE_CFLOAT
  return false if t == type_constants::TYPE_CDOUBLE
  return false if t == type_constants::TYPE_VEC
  return false if t == type_constants::TYPE_MAP
  return false if t == type_constants::TYPE_SET
  return false if t == type_constants::TYPE_INTMAP
  return false if t == type_constants::TYPE_NEVER
  return false if t == type_constants::TYPE_VOID
  return false
end

## Returns a human-readable reason why type `t` is not hashable.
##
## Used in error messages to explain Map<K, V> key validation failures.
def tc_hashable_rejection_reason(tc: TypecheckState, t: Int): String
  return "F64 is not hashable (IEEE 754 NaN != NaN and -0.0 == +0.0 violate hash invariants)" if t == type_constants::TYPE_F64
  return "F32 is not hashable (IEEE 754 NaN != NaN and -0.0 == +0.0 violate hash invariants)" if t == type_constants::TYPE_F32
  return "CFloat is not hashable (IEEE 754 semantics violate hash invariants)" if t == type_constants::TYPE_CFLOAT
  return "CDouble is not hashable (IEEE 754 semantics violate hash invariants)" if t == type_constants::TYPE_CDOUBLE
  return "Vec<T> is mutable and cannot be a Map key" if t == type_constants::TYPE_VEC
  return "Map<K, V> is mutable and cannot be a Map key" if t == type_constants::TYPE_MAP
  return "Set<T> is mutable and cannot be a Map key" if t == type_constants::TYPE_SET
  return "IntMap is mutable and cannot be a Map key" if t == type_constants::TYPE_INTMAP
  return "Never (!) cannot be a Map key" if t == type_constants::TYPE_NEVER
  return "Void cannot be a Map key" if t == type_constants::TYPE_VOID
  return "type is not hashable (mutable, compound, or unknown kind)"
end

## Returns true if struct `name` exists and every field is itself hashable.
##
## Walks the registered field types for the struct and delegates to
## `tc_type_is_hashable` on each. An unknown struct is reported as hashable
## so that forward references and alias resolution still succeed; the real
## struct lookup will fail elsewhere with a better diagnostic if the name
## truly doesn't exist.
def tc_struct_is_hashable(tc: TypecheckState, name: String): Bool
  var lookup = typecheck_registry::tc_lookup_struct(tc, name)
  var struct_idx = match lookup
    typecheck_util::LookupResult::Found(v) => v
    typecheck_util::LookupResult::NotFound => return true
  end
  var field_types = typecheck_registry::tc_struct_field_types_vec(tc, struct_idx)
  var fcount = vec_size(field_types)
  for fi in 0..fcount
    var fty = field_types[fi]
    return false if not tc_type_is_hashable(tc, fty)
  end
  return true
end

## Returns a diagnostic explaining which struct field made it unhashable.
## Returns an empty string if the struct is hashable or not found.
def tc_struct_hashable_rejection(tc: TypecheckState, name: String): String
  var lookup = typecheck_registry::tc_lookup_struct(tc, name)
  var struct_idx = match lookup
    typecheck_util::LookupResult::Found(v) => v
    typecheck_util::LookupResult::NotFound => return ""
  end
  var field_names = typecheck_registry::tc_struct_field_names(tc, struct_idx)
  var field_types = typecheck_registry::tc_struct_field_types_vec(tc, struct_idx)
  var fcount = vec_size(field_types)
  for fi in 0..fcount
    var fty = field_types[fi]
    if not tc_type_is_hashable(tc, fty)
      var fname = field_names[fi]
      var fty_reason = tc_hashable_rejection_reason(tc, fty)
      return "field '#{fname}' is not hashable: #{fty_reason}"
    end
  end
  return ""
end
