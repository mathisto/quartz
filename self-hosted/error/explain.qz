  return explain_QZ7201() if code == "QZ7201"
  return explain_QZ7202() if code == "QZ7202"
  return explain_QZ7203() if code == "QZ7203"
  return explain_QZ7204() if code == "QZ7204"
  return explain_QZ7205() if code == "QZ7205"
  return explain_QZ7301() if code == "QZ7301"
  return explain_QZ7302() if code == "QZ7302"
  return explain_QZ7303() if code == "QZ7303"
  return explain_QZ7401() if code == "QZ7401"
  return explain_QZ7402() if code == "QZ7402"
  return explain_QZ7403() if code == "QZ7403"
  return explain_QZ7501() if code == "QZ7501"
  return explain_QZ7502() if code == "QZ7502"
  return "Unknown error code: #{code}\n\nUse a code like QZ0201, QZ0401, QZ1205, QZ7004, etc.\nRun 'quartz --help' for more information.\n"
end

## ========================================================================
## Lint rule explanations (QZ7xxx)
## ========================================================================

def explain_QZ7000(): String = "## QZ7000: Missing End Keyword\n\nA block-opening keyword (def, if, while, for, struct, enum, match) does\nnot have a corresponding 'end'.\n\nExample:\n\n  def greet(): Void\n    puts(\"hello\")\n  # missing 'end' here\n\nFix: Add the missing 'end' keyword.\n"

def explain_QZ7001(): String = "## QZ7001: Function Naming Convention\n\nFunction names should use snake_case.\n\nExample:\n\n  def myFunction(): Int = 42  # warning: should be my_function\n\nFix: Rename to snake_case: def my_function(): Int = 42\n"

def explain_QZ7002(): String = "## QZ7002: Type Naming Convention\n\nStruct, enum, and trait names should use PascalCase.\n\nExample:\n\n  struct my_point  # warning: should be MyPoint\n    x: Int\n  end\n\nFix: Rename to PascalCase: struct MyPoint\n"

def explain_QZ7003(): String = "## QZ7003: Constant Naming Convention\n\nTop-level constants should use SCREAMING_SNAKE_CASE.\n\nExample:\n\n  const maxRetries = 3  # warning: should be MAX_RETRIES\n\nFix: Rename to SCREAMING_SNAKE_CASE: const MAX_RETRIES = 3\n"

def explain_QZ7004(): String = "## QZ7004: Unused Variable\n\nA variable is declared but never referenced in its scope.\n\nExample:\n\n  def main(): Int\n    var x = 42  # warning: unused variable 'x'\n    return 0\n  end\n\nFix: Remove the variable, or prefix with '_' to indicate it's intentionally unused:\n\n  var _x = 42  # no warning\n\nConfigure: disable QZ7004 in .quartzlint\n"

def explain_QZ7101(): String = "## QZ7101: Redundant Boolean Comparison\n\nComparing a boolean expression to true/false is redundant.\n\nExample:\n\n  if x == true    # redundant\n  if x == false   # use 'not x'\n  if x != true    # use 'not x'\n  if x != false   # redundant\n\nFix: Use the boolean directly:\n\n  if x            # instead of x == true\n  if not x        # instead of x == false\n"

def explain_QZ7102(): String = "## QZ7102: Use Unless\n\n'if not' can be replaced with 'unless' for readability.\n\nExample:\n\n  if not valid    # use: unless valid\n    handle_error()\n  end\n\nFix: unless valid\n"

def explain_QZ7103(): String = "## QZ7103: Use Compound Assignment\n\n'x = x + 1' can be written as 'x += 1'.\n\nExample:\n\n  count = count + 1  # use: count += 1\n  total = total - n  # use: total -= n\n\nFix: Use compound assignment operators: +=, -=, *=\n"

def explain_QZ7104(): String = "## QZ7104: Use .size\n\nQuartz uses .size for collection length, not .len or .length.\n\nExample:\n\n  items.len()     # use: items.size\n  items.length()  # use: items.size\n\nFix: Replace with .size\n"

def explain_QZ7105(): String = "## QZ7105: Use Endless Def\n\nA function with a single return statement can use the endless def form.\n\nExample:\n\n  def double(x: Int): Int  # can be: def double(x: Int): Int = x * 2\n    return x * 2\n  end\n\nFix: def double(x: Int): Int = x * 2\n"

def explain_QZ7106(): String = "## QZ7106: Trailing Whitespace\n\nLine has trailing spaces or tabs.\n\nFix: Remove trailing whitespace. Run 'quartz fmt' to auto-format.\n"

def explain_QZ7201(): String = "## QZ7201: Done-Flag Loop\n\nA 'var done = 0' / 'while done == 0' pattern should use 'loop' + 'break'.\n\nExample:\n\n  var done = 0\n  while done == 0  # use: loop ... break ... end\n    if condition\n      done = 1\n    end\n  end\n\nFix: loop\n  if condition\n    break\n  end\nend\n"

def explain_QZ7202(): String = "## QZ7202: Deep Nesting\n\nCode is nested more than 4 levels deep (configurable via nesting_depth).\n\nFix: Extract inner logic into helper functions, or use guard clauses.\n\nConfigure: nesting_depth 6 in .quartzlint\n"

def explain_QZ7203(): String = "## QZ7203: Variable Shadowing\n\nAn inner scope declares a variable with the same name as an outer binding.\n\nExample:\n\n  def foo(x: Int): Int\n    if true\n      var x = 2  # warning: shadows parameter 'x'\n      return x\n    end\n    return x\n  end\n\nFix: Use a different name for the inner variable.\n"

def explain_QZ7204(): String = "## QZ7204: Redundant Return\n\nA block function with a single 'return' statement can use endless def.\n\nExample:\n\n  def answer(): Int\n    return 42\n  end\n\nFix: def answer(): Int = 42\n"

def explain_QZ7205(): String = "## QZ7205: If/Elsif Chain — Use Match\n\nThree or more if/elsif branches comparing the same variable should use match.\n\nExample:\n\n  if x == 1\n    ...\n  elsif x == 2\n    ...\n  elsif x == 3\n    ...\n  end\n\nFix:\n\n  match x\n    1 => ...\n    2 => ...\n    3 => ...\n  end\n\nConfigure: chain_length 4 in .quartzlint\n"

def explain_QZ7301(): String = "## QZ7301: Unreachable Code\n\nCode after return, break, or continue will never execute.\n\nExample:\n\n  return 0\n  puts(\"unreachable\")  # warning\n\nFix: Remove the unreachable code.\n"

def explain_QZ7302(): String = "## QZ7302: Empty Match Arm\n\nA match arm has no body, which is likely a mistake.\n\nExample:\n\n  match x\n    1 => \n    2 => handle()\n  end\n\nFix: Add body to the match arm, or remove it.\n"

def explain_QZ7303(): String = "## QZ7303: Missing Else Branch\n\nAn if without else is in tail position of a function that returns a value,\nor is used as a value in a let binding. The missing else means the\nexpression may produce nil on one path.\n\nExample:\n\n  def classify(x: Int): String\n    if x > 0\n      return \"positive\"\n    end  # warning: what if x <= 0?\n  end\n\nFix: Add an else branch to handle all cases:\n\n  def classify(x: Int): String\n    if x > 0\n      return \"positive\"\n    else\n      return \"non-positive\"\n    end\n  end\n"

def explain_QZ7401(): String = "## QZ7401: Unused Parameter\n\nA function parameter is never referenced in the body.\n\nExample:\n\n  def foo(x: Int, y: Int): Int  # 'y' unused\n    return x\n  end\n\nFix: Remove the parameter, or prefix with '_':\n\n  def foo(x: Int, _y: Int): Int = x\n"

def explain_QZ7402(): String = "## QZ7402: Empty Block Body\n\nAn if, while, or for block has an empty body.\n\nExample:\n\n  if condition\n  end  # warning: empty body\n\nFix: Add body statements, or remove the block.\n"

def explain_QZ7403(): String = "## QZ7403: Constant Condition\n\nAn if or while condition is a literal boolean.\n\n'while true' should use 'loop'. 'if true/false' is dead code.\n\nExample:\n\n  while true    # use: loop ... break ... end\n    break\n  end\n\n  if false      # dead code\n    unreachable()\n  end\n"

def explain_QZ7501(): String = "## QZ7501: Duplicate Import\n\nThe same module is imported more than once.\n\nExample:\n\n  import foo\n  import foo  # warning: duplicate\n\nFix: Remove the duplicate import.\n"

def explain_QZ7502(): String = "## QZ7502: Wildcard Import\n\nWildcard imports ('import * from X') pull all names into scope.\nPrefer explicit imports for clarity.\n\nException: 'import * from qspec' is conventional in test files.\n\nFix: Use explicit imports: import X, then X::function_name()\n"
