##! # Error Module
##!
##! Unified error handling for all Quartz compiler phases.
##!
##! This module provides:
##! - `Loc` struct for source locations with filename
##! - `ErrorKind` enum categorizing all error types
##! - `CompileError` struct combining kind, location, and message
##! - Formatting and printing utilities
##!
##! ## Error Categories
##!
##! | Phase | ErrorKind | Examples |
##! |-------|-----------|----------|
##! | Lexer | UnexpectedChar, UnterminatedString | Invalid character, unclosed quote |
##! | Parser | UnexpectedToken, ExpectedToken | Missing `end`, wrong syntax |
##! | Type | TypeMismatch, UndefinedVariable | Wrong type, unknown name |
##!
##! ## Usage Pattern
##!
##! ```be
##! loc = loc_new(10, 5, "main.be")
##! err = error_new(ErrorKind::TypeMismatch, loc, "expected Int, got String")
##! error_print(err)  # => main.be:10:5: error: expected Int, got String
##! ```
##!
##! @see typecheck Type error generation
##! @see parser Parse error generation
##! @since 1.0.0

## Source location with file, line, and column.
##
## Used for error messages to pinpoint exact error location.
struct Loc
  line: Int       ##^ 1-based line number
  col: Int        ##^ 1-based column number
  filename: String ##^ Source filename
end

## Creates a new source location.
##
## @param line 1-based line number
## @param col 1-based column number
## @param filename Source file name
## @returns New Loc struct
def loc_new(line: Int, col: Int, filename: String): Loc
  var loc = Loc { line: 0, col: 0, filename: "" }
  loc.line = line
  loc.col = col
  loc.filename = filename
  return loc
end

## Formattable trait for types that can produce a display string.
##
## Dogfooding: validates trait definition + impl compilation
## through the C bootstrap compiler.
##
## @since Phase 0 dogfooding
trait Formattable
  def format(self): String = "<unknown>"
end

## Loc implements Formattable for "file:line:col" display.
##
## @since Phase 0 dogfooding
extend Loc with Formattable
  def format(self): String = "#{self.filename}:#{self.line}:#{self.col}"
end

## Formats a location as "file:line:col".
##
## @param loc The source location
## @returns Formatted string (e.g., "main.be:10:5")
def loc_format(loc: Loc): String = loc.format()

## Compiler error categories.
##
## Grouped by compiler phase for structured error handling.
enum ErrorKind
  # Lexer errors
  UnexpectedChar
  UnterminatedString
  UnterminatedChar
  InvalidEscape
  
  # Parser errors (Phase 2)
  UnexpectedToken
  ExpectedToken
  
  # Type errors (Phase 3)
  TypeMismatch
  UndefinedVariable
  UndefinedFunction
  UndefinedType
end

## Compiler error with full context.
##
## Combines error category, source location, and human-readable message.
## Can be formatted for display with error_format.
struct CompileError
  kind: ErrorKind    ##^ Error category
  loc: Loc           ##^ Source location
  message: String    ##^ Human-readable error message
end

## Creates a new compile error.
##
## @param kind The error category
## @param loc Source location where error occurred
## @param message Human-readable error description
## @returns New CompileError struct
## @example
##   err = error_new(ErrorKind::TypeMismatch, loc, "expected Int, got String")
def error_new(kind: ErrorKind, loc: Loc, message: String): CompileError
  var err = CompileError { kind: ErrorKind::UnexpectedChar, loc: loc, message: "" }
  err.kind = kind
  err.message = message
  return err
end

## Creates a lexer error at the given location.
##
## Convenience wrapper for lexer error reporting.
##
## @param loc Source location of the error
## @param message Error description
## @returns CompileError with UnexpectedChar kind
def lexer_error(loc: Loc, message: String): CompileError = error_new(ErrorKind::UnexpectedChar, loc, message)

## CompileError implements Formattable for "file:line:col: error: message" display.
##
## Uses Loc.format() via trait dispatch to format the location part.
##
## @since Phase 0 dogfooding
extend CompileError with Formattable
  def format(self): String = "#{loc_format(self.loc)}: error: #{self.message}"
end

## Formats an error for display.
##
## Produces format: "file:line:col: error: message"
## Delegates to Formattable trait impl.
##
## @param err The compile error to format
## @returns Formatted error string
def error_format(err: CompileError): String = err.format()

## Prints an error to stderr.
##
## Uses Formattable trait dispatch via .format() method.
##
## @param err The compile error to print
def error_print(err: CompileError): Void
  puts(err.format())
end

# ===========================================================================
# Compiler Error Handling Patterns
# ===========================================================================
#
# The Quartz compiler uses three complementary error handling strategies:
#
# ## 1. Error Aggregation (Primary Pattern)
#
# Errors are printed immediately and phases track `had_error` flags.
# This allows multi-error reporting (show all errors, not just first).
#
#   Used by: parser, typecheck, MIR lowering
#   Check with: ps_get_had_error(), tc_has_errors()
#   Pattern:
#     tc_error(tc, node, "type mismatch")  # prints and sets flag
#     # ... continue checking other nodes ...
#     if tc_has_errors(tc)
#       return 1  # signal failure to caller
#     end
#
# ## 2. Sentinel Values (Legacy Pattern)
#
# Functions return special values to indicate failure:
#   - `0` for "false", "nil", or "not matched" (common)
#   - `-1` for "not found" in lookup functions
#   - `< 0` for type variables (negative IDs are type vars)
#
# This pattern is used throughout the compiler for:
#   - Type lookups: type_idx < 0 means not found
#   - AST nodes: node < 0 means missing optional node
#   - Block termination: mir_block_get_term_kind(block) < 0
#
# **Convention**: Use `< 0` checks, not `== -1`, for consistency.
#
# ## 3. Result Types (For Recoverable Operations)
#
# Use Result<T, E> or LookupResult when callers need to handle failure
# explicitly with pattern matching:
#
#   - try-catch expressions: Result<T, E> with ? operator
#   - New lookup functions: LookupResult enum
#   - File I/O: Result with error details
#
# ## Guidelines for New Code
#
# | Scenario | Pattern to Use |
# |----------|----------------|
# | Parsing error, continue after | Error aggregation (print + flag) |
# | Type error, continue after | Error aggregation (print + flag) |
# | Lookup, caller handles missing | LookupResult enum |
# | Recoverable failure, propagate | Result<T, CompileError> |
# | Boolean check | Return 0/1 |
#
# ## LookupResult Pattern
#
# For new functions that need to distinguish "found value" from "not found":
#
#   match lookup_something(name)
#     Found(value) => # use value
#     NotFound => # handle missing
#   end

## Result of a lookup operation.
##
## Replaces the -1 sentinel pattern for "not found" cases.
## Use when a function needs to distinguish "found value" from "not found".
##
## @since 2.6.0
enum LookupResult
  Found(value: Int)  ##^ Successfully found, contains the value
  NotFound           ##^ Key/name not in the lookup table
end

## Extend LookupResult with method-call syntax.
##
## Dogfooding: validates extend block compilation through the C bootstrap.
## Converts free functions to methods: result.is_found(), result.unwrap(), etc.
##
## @since Phase 0 dogfooding
extend LookupResult
  ## Checks if a lookup succeeded.
  ## @returns 1 if Found, 0 if NotFound
  def is_found(): Int
    match self
      Found(_) => return 1
      NotFound => return 0
    end
  end

  ## Unwraps a Found result, panics on NotFound.
  ## @returns The found value
  ## @panics If result is NotFound
  def unwrap(): Int
    match self
      Found(v) => return v
      NotFound =>
        puts("panic: unwrap called on NotFound")
        return 0
    end
  end

  ## Unwraps a Found result or returns a fallback value.
  ## @param fallback Value to return if NotFound
  ## @returns The found value or fallback
  def unwrap_or(fallback: Int): Int
    match self
      Found(v) => return v
      NotFound => return fallback
    end
  end
end

## Creates a Found result.
##
## @param value The found value
## @returns Found containing the value
def lookup_found(value: Int): LookupResult = LookupResult::Found(value)

## Creates a NotFound result.
##
## @returns NotFound
def lookup_not_found(): LookupResult = LookupResult::NotFound


