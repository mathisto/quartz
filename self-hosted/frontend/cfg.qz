##! # Conditional Compilation (@cfg) Support
##!
##! Evaluates `@cfg(os:/arch:/pointer_width:/target_feature:/feature:)`
##! conditions and tracks the cross-compilation target + user feature flags.
##!
##! Relocated out of the (now-deleted) recursive-descent `parser.qz` during the
##! CST cutover finale (Phase B.2): these are the only non-grammar helpers the
##! legacy parser module still hosted. Bodies are byte-identical to their former
##! home; only the module/qualifier changed.

# ===========================================================================
# Feature flags
# ===========================================================================

## Feature flags for @cfg(feature: "name") conditional compilation.
## Set via --feature CLI flag before compilation begins.
var _g_cfg_features = vec_new<String>()

## Add a feature flag for conditional compilation.
def cfg_add_feature(name: String): Void
  _g_cfg_features.push(name)
end

## Check if a feature flag is set.
def _cfg_has_feature(name: String): Int
  for i in 0.._g_cfg_features.size
    if _g_cfg_features[i] == name
      return 1
    end
  end
  return 0
end

# ===========================================================================
# Host platform queries
# ===========================================================================

## Return the target OS as a string constant.
## The bootstrap compiler evaluates the @cfg and includes only the matching one.
@cfg(os: "macos")
def cfg_get_os(): String = "macos"

@cfg(os: "linux")
def cfg_get_os(): String = "linux"

@cfg(os: "windows")
def cfg_get_os(): String = "windows"

@cfg(os: "freebsd")
def cfg_get_os(): String = "freebsd"

## Return the target arch as a string constant.
@cfg(arch: "aarch64")
def cfg_get_arch(): String = "aarch64"

@cfg(arch: "x86_64")
def cfg_get_arch(): String = "x86_64"

## Check if a target feature is available on the current platform.
@cfg(arch: "aarch64")
def cfg_has_target_feature(feature: String): Int
  # aarch64 always has neon
  if feature == "neon"
    return 1
  end
  return 0
end

@cfg(arch: "x86_64")
def cfg_has_target_feature(feature: String): Int
  # SSE and SSE2 are mandatory on x86_64
  if feature == "sse"
    return 1
  end
  if feature == "sse2"
    return 1
  end
  return 0
end

# ===========================================================================
# Target-triple derivation
# ===========================================================================

## Derive OS from a target triple string.
##
## ORDER MATTERS. The "windows" check MUST precede the "gnu" check, because
## mingw-w64 targets (x86_64-pc-windows-gnu, aarch64-pc-windows-gnu) contain
## BOTH substrings — "gnu" denotes the ABI flavor, not the OS. Same logic
## for "msvc" (Windows-only ABI; we accept it as a distinct token below the
## generic "windows" check). Tokens that are unambiguous markers for a
## single OS go first; ambiguous fallback tokens (bare "gnu" → linux-gnu,
## bare "musl" → linux-musl) go last.
def cfg_os_from_target(target: String): String
  if str_contains(target, "macos")
    return "macos"
  end
  if str_contains(target, "darwin")
    return "macos"
  end
  if str_contains(target, "apple")
    return "macos"
  end
  if str_contains(target, "windows")
    return "windows"
  end
  if str_contains(target, "linux")
    return "linux"
  end
  if str_contains(target, "wasi")
    return "wasi"
  end
  if str_contains(target, "wasm")
    return "wasi"
  end
  if str_contains(target, "freebsd")
    return "freebsd"
  end
  # Ambiguous-but-Linux-by-convention fallback tokens. These match LAST so
  # mingw-w64 (windows-gnu) and windows-msvc triples are classified above.
  if str_contains(target, "gnu")
    return "linux"
  end
  if str_contains(target, "musl")
    return "linux"
  end
  return "unknown"
end

## Derive arch from the prefix of a target triple (before first '-').
def cfg_arch_from_target(target: String): String
  if str_starts_with(target, "aarch64")
    return "aarch64"
  end
  if str_starts_with(target, "x86_64")
    return "x86_64"
  end
  if str_starts_with(target, "wasm32")
    return "wasm32"
  end
  if str_starts_with(target, "wasm64")
    return "wasm64"
  end
  if str_starts_with(target, "riscv64")
    return "riscv64"
  end
  if str_starts_with(target, "arm")
    return "arm"
  end
  return "unknown"
end

# ===========================================================================
# Condition evaluation
# ===========================================================================

## Evaluate a @cfg condition key/value pair.
## When target is non-empty, derives OS/arch from the target triple
## instead of using the host platform.
def cfg_evaluate_condition(key: String, value: String, target: String): Int
  if key == "os"
    if str_byte_len(target) > 0
      return cfg_os_from_target(target) == value
    end
    return cfg_get_os() == value
  end
  if key == "arch"
    if str_byte_len(target) > 0
      return cfg_arch_from_target(target) == value
    end
    return cfg_get_arch() == value
  end
  if key == "pointer_width"
    if str_byte_len(target) > 0
      if str_starts_with(target, "wasm32")
        return "32" == value
      end
    end
    return "64" == value
  end
  if key == "target_feature"
    return cfg_has_target_feature(value)
  end
  if key == "feature"
    return _cfg_has_feature(value)
  end
  return 0
end
