##! # AST Printer
##!
##! Utility to print AST structure for debugging.
##!
##! @see ast
##! @since 1.0.0

import ast
import node_constants

def print_indent(depth: Int): Void
  for i in 0..depth
    puts("  ")
  end
end

def ast_print(s: Int, node: Int): Void
  puts("=== Surface AST ===")
  ast_print_node(s, node, 0)
end

def ast_print_node(s: Int, node: Int, depth: Int): Void
  var kind = ast::ast_get_kind(s, node)

  if kind == node_constants::NODE_INT_LIT
    print_indent(depth)
    puts("INT_LIT ")
    print_int(ast::ast_get_int_val(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_BOOL_LIT
    print_indent(depth)
    puts("BOOL_LIT ")
    if ast::ast_get_int_val(s, node) == 1
      puts("true")
    else
      puts("false")
    end
    puts("\n")
    return
  end

  if kind == node_constants::NODE_NIL_LIT
    print_indent(depth)
    puts("NIL_LIT\n")
    return
  end

  if kind == node_constants::NODE_STRING_LIT
    print_indent(depth)
    puts("STRING_LIT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_SYMBOL_LIT
    print_indent(depth)
    puts("SYMBOL_LIT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_IDENT
    print_indent(depth)
    puts("IDENT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_UNARY
    print_indent(depth)
    puts("UNARY op=")
    print_int(ast::ast_get_op(s, node))
    puts("\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_BINARY
    print_indent(depth)
    puts("BINARY op=")
    print_int(ast::ast_get_op(s, node))
    puts("\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_CALL
    print_indent(depth)
    puts("CALL\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    var args = ast::ast_get_children(s, node)
    if args != 0
      var len = args.size
      for i in 0..len
        ast_print_node(s, args[i], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_SPREAD
    print_indent(depth)
    puts("SPREAD\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_ARRAY
    print_indent(depth)
    puts("ARRAY\n")
    var elems = ast::ast_get_children(s, node)
    if elems != 0
      var len = elems.size
      for i in 0..len
        ast_print_node(s, elems[i], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_INDEX
    print_indent(depth)
    puts("INDEX\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_STRUCT_INIT
    print_indent(depth)
    puts("STRUCT_INIT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_FIELD_ACCESS
    print_indent(depth)
    puts("FIELD_ACCESS .")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_LAMBDA
    print_indent(depth)
    puts("LAMBDA\n")
    # Body is in right slot
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_IF
    print_indent(depth)
    if ast::ast_get_int_val(s, node) == 1
      puts("IF_PATTERN\n")
      ast_print_node(s, ast::ast_get_op(s, node), depth + 1)
    else
      puts("IF\n")
    end
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    var else_branch = ast::ast_get_extra(s, node)
    if else_branch != 0
      ast_print_node(s, else_branch, depth + 1)
    end
    return
  end

  if kind == node_constants::NODE_WHILE
    print_indent(depth)
    puts("WHILE\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_LET
    print_indent(depth)
    puts("LET ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    var init = ast::ast_get_left(s, node)
    if init != 0
      ast_print_node(s, init, depth + 1)
    end
    return
  end

  if kind == node_constants::NODE_ASSIGN
    print_indent(depth)
    puts("ASSIGN\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_EXPR_STMT
    print_indent(depth)
    puts("EXPR_STMT\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_BREAK
    print_indent(depth)
    puts("BREAK\n")
    return
  end

  if kind == node_constants::NODE_CONTINUE
    print_indent(depth)
    puts("CONTINUE\n")
    return
  end

  if kind == node_constants::NODE_BLOCK
    print_indent(depth)
    var stmts = ast::ast_get_children(s, node)
    var stmt_count = 0
    if stmts != 0
      stmt_count = stmts.size
    end
    puts("BLOCK (")
    print_int(stmt_count)
    puts(" stmts)\n")
    if stmts != 0
      for i in 0..stmt_count
        ast_print_node(s, stmts[i], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_TRY_EXPR
    print_indent(depth)
    puts("TRY_EXPR\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_RETURN
    print_indent(depth)
    puts("RETURN\n")
    var expr = ast::ast_get_left(s, node)
    if expr != 0
      ast_print_node(s, expr, depth + 1)
    end
    return
  end

  if kind == node_constants::NODE_PARAM
    print_indent(depth)
    puts("PARAM ")
    puts(ast::ast_get_str1(s, node))
    puts(": ")
    puts(ast::ast_get_str2(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_FUNCTION
    print_indent(depth)
    puts("FUNCTION ")
    puts(ast::ast_get_str1(s, node))
    # params are in left slot
    var params = ast::ast_get_left(s, node)
    var param_count = 0
    if params != 0
      param_count = params.size
    end
    puts(" (")
    print_int(param_count)
    puts(" params)\n")
    # Print params
    if params != 0
      for i in 0..param_count
        ast_print_node(s, params[i], depth + 1)
      end
    end
    # body is in right slot
    var body = ast::ast_get_right(s, node)
    if body != 0
      ast_print_node(s, body, depth + 1)
    end
    return
  end

  if kind == node_constants::NODE_PROGRAM
    var items = ast::ast_get_children(s, node)
    var item_count = 0
    if items != 0
      item_count = items.size
    end
    print_indent(depth)
    puts("PROGRAM (")
    print_int(item_count)
    puts(" declarations)\n")
    if items != 0
      for i in 0..item_count
        ast_print_node(s, items[i], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_STRUCT_DEF
    print_indent(depth)
    puts("STRUCT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_FIELD_DEF
    print_indent(depth)
    puts("FIELD ")
    puts(ast::ast_get_str1(s, node))
    puts(": ")
    puts(ast::ast_get_str2(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_ENUM_DEF
    print_indent(depth)
    puts("ENUM ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_ENUM_ACCESS
    print_indent(depth)
    puts("ENUM_ACCESS ")
    puts(ast::ast_get_str1(s, node))
    puts("::")
    puts(ast::ast_get_str2(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_MATCH
    print_indent(depth)
    puts("MATCH\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    var arms = ast::ast_get_children(s, node)
    if arms != 0
      var len = arms.size
      for i in 0..len
        ast_print_node(s, arms[i], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_MATCH_ARM
    print_indent(depth)
    puts("MATCH_ARM\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_WILDCARD
    print_indent(depth)
    puts("WILDCARD\n")
    return
  end

  if kind == node_constants::NODE_OR_PATTERN
    print_indent(depth)
    puts("OR_PATTERN\n")
    var or_pats = ast::ast_get_children(s, node)
    if or_pats != 0
      var or_count = vec_size(or_pats)
      for oi in 0..or_count
        ast_print_node(s, or_pats[oi], depth + 1)
      end
    end
    return
  end

  if kind == node_constants::NODE_FOR
    print_indent(depth)
    puts("FOR ")
    puts(ast::ast_get_str1(s, node))
    var for_step = ast::ast_get_int_val(s, node)
    if for_step > 0
      puts(" STEP")
    end
    puts("\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    if for_step > 0
      ast_print_node(s, for_step, depth + 1)
    end
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_IMPORT
    print_indent(depth)
    puts("IMPORT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_VARIANT_DEF
    print_indent(depth)
    puts("VARIANT ")
    puts(ast::ast_get_str1(s, node))
    puts("\n")
    return
  end

  if kind == node_constants::NODE_CONST_DECL
    print_indent(depth)
    puts("CONST ")
    puts(ast::ast_get_str1(s, node))
    puts(" = ")
    puts("\n")
    ast_print_node(s, ast::ast_get_right(s, node), depth + 1)
    return
  end

  if kind == node_constants::NODE_STATIC_ASSERT
    print_indent(depth)
    puts("STATIC_ASSERT ")
    puts(ast::ast_get_str2(s, node))
    puts("\n")
    ast_print_node(s, ast::ast_get_left(s, node), depth + 1)
    return
  end

  # Unknown
  print_indent(depth)
  puts("UNKNOWN kind=")
  print_int(kind)
  puts("\n")
end
