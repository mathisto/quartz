##! # Lexer Tests
##!
##! Unit tests for the lexer module.
##!
##! @see lexer
##! @since 1.0.0

# Self-hosted lexer test - simplified version
# Tests the lexer with a hardcoded source string

def main(): Int
  source = "def main(): Int\n  x = 42\n  return x\nend\n"
  
  var line = 1
  var col = 1
  len = str_byte_len(source)
  
  for pos in 0..len
    c = source.byte_at(pos)
    
    # Skip whitespace (except newlines)
    if c == ' ' or c == '\t'
      col += 1
      pos += 1
      continue
    end
    
    # Handle newlines
    if c == '\n'
      puts(line.to_s(), false)
      puts(":", false)
      puts(col.to_s(), false)
      puts(" NEWLINE")
      line += 1
      col = 1
      pos += 1
      continue
    end
    
    # Handle identifiers and keywords
    if is_alpha(c)
      start_col = col
      var word = ""
      while pos < len
        break if not is_alnum(source.byte_at(pos))
        word = "#{word}#{str_from_char(source.byte_at(pos))}"
        pos += 1
        col += 1
      end
      
      puts(line.to_s(), false)
      puts(":", false)
      puts(start_col.to_s(), false)
      puts(" ", false)
      
      # Check for keywords
      if word == "def"
        puts("DEF")
      elsif word == "end"
        puts("END")
      elsif word == "return"
        puts("RETURN")
      elsif word == "if"
        puts("IF")
      elsif word == "else"
        puts("ELSE")
      elsif word == "while"
        puts("WHILE")
      elsif word == "true"
        puts("TRUE")
      elsif word == "false"
        puts("FALSE")
      elsif word == "var"
        puts("VAR")
      elsif word == "and"
        puts("AND")
      elsif word == "or"
        puts("OR")
      elsif word == "not"
        puts("NOT")
      else
        puts("IDENT ", false)
        puts(word)
      end
      continue
    end
    
    # Handle numbers
    if is_digit(c)
      start_col = col
      var num = ""
      while pos < len
        break if not is_digit(source.byte_at(pos))
        num = "#{num}#{str_from_char(source.byte_at(pos))}"
        pos += 1
        col += 1
        end
      end
      
      puts(line.to_s(), false)
      puts(":", false)
      puts(start_col.to_s(), false)
      puts(" INT ", false)
      puts(num)
      continue
    end
    
    # Handle single-character tokens
    start_col = col
    puts(line.to_s(), false)
    puts(":", false)
    puts(start_col.to_s(), false)
    puts(" ", false)
    
    if c == '('
      puts("LPAREN")
    elsif c == ')'
      puts("RPAREN")
    elsif c == ':'
      puts("COLON")
    elsif c == '='
      puts("ASSIGN")
    elsif c == '+'
      puts("PLUS")
    elsif c == '-'
      puts("MINUS")
    elsif c == '*'
      puts("STAR")
    elsif c == '/'
      puts("SLASH")
    else
      puts("UNKNOWN ", false)
      puts(c.to_s())
    end
    
    pos += 1
    col += 1
  end
  
  puts(line.to_s(), false)
  puts(":", false)
  puts(col.to_s(), false)
  puts(" EOF")
  
  return 0
end

def is_alpha(c: Int): Bool = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'

def is_digit(c: Int): Bool = c >= '0' and c <= '9'

def is_alnum(c: Int): Bool = is_alpha(c) or is_digit(c)

def str_eq(a: String, b: String): Bool
  if str_byte_len(a) != str_byte_len(b)
    return false
  end
  var len = str_byte_len(a)
  for i in 0..len
    if a.byte_at(i) != b.byte_at(i)
      return false
    end
  end
  return true
end


