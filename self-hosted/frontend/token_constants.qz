##! # Token Constants
##!
##! Token type constants.
##!
##! @see lexer
##! @since 1.0.0

# token_constants.qz - Token type constants
# MUST match the TokenType enum in quartz-bootstrap/src/lexer.h
#
# Single source of truth for token type values.
# Used by both lexer.qz and parser.qz.

## End of file token.
const TOK_EOF = 0
## Newline token.
const TOK_NEWLINE = 1
## Identifier token.
const TOK_IDENT = 2
## Integer literal token.
const TOK_INT = 3
## Character literal token.
const TOK_CHAR = 4
## String literal token.
const TOK_STRING = 5
## Symbol literal token.
const TOK_SYMBOL = 6
## Regex literal token.
const TOK_REGEX = 7
## 'def' keyword token.
const TOK_DEF = 9
## 'end' keyword token.
const TOK_END = 10
## 'if' keyword token.
const TOK_IF = 11
## 'unless' keyword token.
const TOK_UNLESS = 12
## 'else' keyword token.
const TOK_ELSE = 13
## 'while' keyword token.
const TOK_WHILE = 14
## 'do' keyword token.
const TOK_DO = 15
## 'return' keyword token.
const TOK_RETURN = 16
## 'and' operator token.
const TOK_AND = 17
## 'or' operator token.
const TOK_OR = 18
## 'true' literal token.
const TOK_TRUE = 19
## 'false' literal token.
const TOK_FALSE = 20
## 'let' keyword token.
const TOK_LET = 21
## 'var' keyword token.
const TOK_VAR = 22
## 'not' operator token.
const TOK_NOT = 23
## 'elsif' keyword token.
const TOK_ELSIF = 24
## 'break' keyword token.
const TOK_BREAK = 25
## 'continue' keyword token.
const TOK_CONTINUE = 26
## 'for' keyword token.
const TOK_FOR = 27
## 'in' keyword token.
const TOK_IN = 28
## '..' range token.
const TOK_DOTDOT = 29
## 'struct' keyword token.
const TOK_STRUCT = 30
## 'enum' keyword token.
const TOK_ENUM = 31
## '.' token.
const TOK_DOT = 32
## 'match' keyword token.
const TOK_MATCH = 33
## 'when' keyword token.
const TOK_WHEN = 34
## 'then' keyword token.
const TOK_THEN = 35
## '=>' token.
const TOK_FAT_ARROW = 36
## '_' token.
const TOK_UNDERSCORE = 37
## 'import' keyword token.
const TOK_IMPORT = 38
## 'from' keyword token.
const TOK_FROM = 39
## 'as' keyword token.
const TOK_AS = 40
## 'private' keyword token.
const TOK_PRIVATE = 41
## 'public' keyword token.
const TOK_PUBLIC = 42
## 'trait' keyword token.
const TOK_TRAIT = 43
## 'impl' keyword token.
const TOK_IMPL = 44
## 'where' keyword token.
const TOK_WHERE = 45
## 'extern' keyword token.
const TOK_EXTERN = 46
## 'await' keyword token.
const TOK_AWAIT = 48
## 'select' keyword token.
const TOK_SELECT = 49
## 'defer' keyword token.
const TOK_DEFER = 51
## 'arena' keyword token.
const TOK_ARENA = 52
## 'try' keyword token.
const TOK_TRY = 53
## 'catch' keyword token.
const TOK_CATCH = 54
## 'type' keyword token.
const TOK_TYPE = 55
## '+' token.
const TOK_PLUS = 56
## '-' token.
const TOK_MINUS = 57
## '*' token.
const TOK_STAR = 58
## '/' token.
const TOK_SLASH = 59
## '%' token.
const TOK_PERCENT = 60
## '+=' token.
const TOK_PLUS_EQ = 61
## '-=' token.
const TOK_MINUS_EQ = 62
## '*=' token.
const TOK_STAR_EQ = 63
## '/=' token.
const TOK_SLASH_EQ = 64
## '%=' token.
const TOK_PERCENT_EQ = 65
## '^=' token.
const TOK_CARET_EQ = 66
## '==' token.
const TOK_EQ = 67
## '!=' token.
const TOK_NE = 68
## '=~' token (match op).
const TOK_MATCH_OP = 69
## '!~' token (no match op).
const TOK_NOMATCH_OP = 70
## '?=' token (match capture).
const TOK_MATCH_CAPTURE = 71
## '<' token.
const TOK_LT = 72
## '>' token.
const TOK_GT = 73
## '<=' token.
const TOK_LE = 74
## '>=' token.
const TOK_GE = 75
## '&' token.
const TOK_AMP = 76
## '|' token.
const TOK_PIPE = 77
## '|>' token.
const TOK_PIPE_GT = 78
## '^' token.
const TOK_CARET = 79
## '~' token.
const TOK_TILDE = 80
## '<<' token.
const TOK_LSHIFT = 81
## '>>' token.
const TOK_RSHIFT = 82
## '?' token.
const TOK_QUESTION = 83
## '??' token.
const TOK_QUESTION_QUESTION = 84
## '?.' token.
const TOK_QUESTION_DOT = 85
## '=' token.
const TOK_ASSIGN = 86
## ':' token.
const TOK_COLON = 87
## '::' token.
const TOK_DOUBLE_COLON = 88
## ',' token.
const TOK_COMMA = 89
## '(' token.
const TOK_LPAREN = 90
## ')' token.
const TOK_RPAREN = 91
## '[' token.
const TOK_LBRACKET = 92
## ']' token.
const TOK_RBRACKET = 93
## '{' token.
const TOK_LBRACE = 94
## '}' token.
const TOK_RBRACE = 95
## '$' token.
const TOK_DOLLAR = 96
## '@' token.
const TOK_AT = 97
## Doc comment token.
const TOK_DOC_COMMENT = 98
## Module doc comment token.
const TOK_DOC_MODULE = 99
## Inline doc comment token.
const TOK_DOC_INLINE = 100
## '->' token.
const TOK_ARROW = 101
## Error token.
const TOK_ERROR = 102
## 'newtype' keyword token.
const TOK_NEWTYPE = 103
## 'nil' literal token.
const TOK_NIL = 104
## '!' token.
const TOK_BANG = 105
## 'extend' keyword token.
const TOK_EXTEND = 106
## '...' token.
const TOK_DOTDOTDOT = 107
## Float literal token.
const TOK_FLOAT_LIT = 108
## 'const' keyword token.
const TOK_CONST = 109
## 'task_group' keyword token.
const TOK_TASK_GROUP = 110
## 'loop' keyword token.
const TOK_LOOP = 111
## 'macro' keyword token.
const TOK_MACRO = 112
## 'quote' keyword token.
const TOK_QUOTE = 113
## 'unquote' keyword token.
const TOK_UNQUOTE = 114
## 'unquote_each' keyword token.
const TOK_UNQUOTE_EACH = 115
## 'cimport' keyword token.
const TOK_CIMPORT = 116
## 'yield' keyword token.
const TOK_YIELD = 117
## 'async' keyword token — async call-site annotation.
const TOK_ASYNC = 118
## 'go' keyword token — lightweight task spawn via M:N scheduler.
const TOK_GO = 119
## '&=' bitwise AND assignment.
const TOK_AMP_EQ = 120
## '|=' bitwise OR assignment.
const TOK_PIPE_EQ = 121
## '<<=' left shift assignment.
const TOK_SHL_EQ = 122
## '>>=' right shift assignment.
const TOK_SHR_EQ = 123
## Regular comment (# to end of line). Preserved for formatter, skipped by parser.
const TOK_COMMENT = 124
## 'actor' keyword token — language-level actor definition.
const TOK_ACTOR = 125
## 'is' keyword token — enum variant check operator.
const TOK_IS = 126

## Opening '"' of an interpolated string (split token).
const TOK_STRING_START = 127
## Literal text segment within an interpolated string (unescaped).
const TOK_STRING_PART = 128
## The '#{' marker that begins an interpolation expression.
const TOK_INTERP_START = 129
## Closing '}' of an interpolation expression.
const TOK_INTERP_END = 130
## Closing '"' of an interpolated string (split token).
const TOK_STRING_END = 131

# Algebraic-effects surface syntax (Operation Piezoelectric Effects, Phase 1).
# TOK_TRY and TOK_CATCH exist earlier in this file and are reused.

## 'can' keyword — effect-row suffix on function signatures.
const TOK_CAN = 132
## 'effect' keyword — effect declaration block opener.
const TOK_EFFECT = 133
## 'with' keyword — handler installation: `with H do -> body end`.
const TOK_WITH = 134
## 'handle' keyword — reserved. Not yet wired into the lexer keyword table
## (see ROADMAP: ~45 identifier collision sites need rename first). Adding
## the constant now so MIR/codegen milestones can reference it uniformly.
const TOK_HANDLE = 135
## 'reify' keyword — effect-to-Result reifier: `reify { expr }`.
const TOK_REIFY = 136
## 'throw' keyword — operation-kind throw inside handler bodies.
const TOK_THROW = 137
## 'resume' keyword — explicit continuation invocation in operation-kind ops.
const TOK_RESUME = 138
## 'without' keyword — negative-trait opt-out in `extend Type without Trait`
## (replaces the old `impl !Trait for Type`). P3.F 8a.
const TOK_WITHOUT = 139
