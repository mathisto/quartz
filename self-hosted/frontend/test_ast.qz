##! # AST Tests
##!
##! Unit tests for AST construction.
##!
##! @see ast
##! @since 1.0.0

import ast

def main(): Int
  var s = ast::ast_new_storage()
  
  var int_node = ast::ast_int_lit(s, 42, 1, 1)
  var str_node = ast::ast_string_lit(s, "hello", 2, 1)
  var ident = ast::ast_ident(s, "foo", 3, 1)
  
  puts("Created AST nodes:")
  print_int(ast::ast_get_kind(s, int_node))
  print_int(ast::ast_get_int_val(s, int_node))
  print_int(ast::ast_get_kind(s, str_node))
  print_int(ast::ast_get_kind(s, ident))
  
  puts("Test passed!")
  return 0
end
