##! # Token Module
##!
##! Defines core token types and structures for the Quartz lexer.
##!
##! This module provides:
##! - `Loc` struct for source locations (line/column)
##! - `TokenType` enum with all 60+ token varieties
##! - `Token` struct combining type, lexeme, and location
##! - Helper functions for token creation and formatting
##!
##! ## Design Note
##!
##! Token order in `TokenType` matches the C bootstrap compiler's
##! `lexer.h` for guaranteed compatibility and IR parity.
##!
##! @see lexer Tokenization of source code
##! @see parser Consumption of token streams
##! @since 1.0.0

## Source location for error messages and debugging.
##
## Represents a position in source code as line and column numbers.
## Both values are 1-based (first line is 1, first column is 1).
##
## @example
##   loc = loc_new(10, 5)  # Line 10, column 5
struct Loc
  line: Int  ##^ 1-based line number
  col: Int   ##^ 1-based column number
end

## Creates a new source location.
##
## @param line The 1-based line number
## @param col The 1-based column number
## @returns A new Loc struct with the given position
## @example
##   error_loc = loc_new(42, 13)
def loc_new(line: Int, col: Int): Loc
  var loc = Loc { line: 0, col: 0 }
  loc.line = line
  loc.col = col
  return loc
end

## All token types in the Quartz programming language.
##
## Organized into logical categories:
## - **Special**: EOF, newlines, errors
## - **Literals**: identifiers, numbers, strings, symbols
## - **Keywords**: 27 reserved words (def, if, while, struct, etc.)
## - **Operators**: arithmetic, comparison, logical, bitwise
## - **Punctuation**: colons, dots, arrows, question marks
## - **Delimiters**: parentheses, brackets, braces
##
## Order matches `bootstrap/src/lexer.h` for IR parity.
enum TokenType
  # Special
  Eof
  Newline
  Error
  
  # Literals
  Ident
  Int
  Float
  Char
  String

  # Keywords
  Def
  End
  If
  Else
  Elsif
  While
  Return
  And
  Or
  Not
  True
  False
  Let
  Var
  Break
  Continue
  For
  In
  Struct
  Enum
  Match
  When
  Then
  Import
  From
  As
  Private
  Public
  
  # Operators
  Plus
  Minus
  Star
  Slash
  Percent
  PlusEq
  MinusEq
  StarEq
  SlashEq
  PercentEq
  
  # Comparison
  Eq
  Ne
  Lt
  Gt
  Le
  Ge
  
  # Bitwise
  Amp
  Pipe
  Caret
  Tilde
  Lshift
  Rshift
  
  # Punctuation
  Assign
  Colon
  DoubleColon
  Comma
  Dot
  DotDot
  FatArrow
  Question
  Underscore
  
  # Delimiters
  Lparen
  Rparen
  Lbracket
  Rbracket
  Lbrace
  Rbrace

  # Split interpolation tokens
  StringStart
  StringPart
  InterpStart
  InterpEnd
  StringEnd
end

## A token from lexical analysis.
##
## Combines the token type, its raw text (lexeme), and source location.
## This is the primary data structure passed from lexer to parser.
##
## @example
##   tok = token_new(TokenType::Int, "42", loc_new(1, 1))
##   puts(tok.lexeme)  #=> "42"
struct Token
  kind: TokenType   ##^ The kind of token (keyword, operator, literal, etc.)
  lexeme: String    ##^ Raw source text that produced this token
  loc: Loc          ##^ Source position (line, column)
end

## Creates a new token with the given kind, lexeme, and location.
##
## @param kind The token type from TokenType enum
## @param lexeme The raw source text of the token
## @param loc The source location where the token appears
## @returns A new Token struct
## @example
##   tok = token_new(TokenType::Ident, "main", loc_new(1, 5))
def token_new(kind: TokenType, lexeme: String, loc: Loc): Token
  var tok = Token { kind: TokenType::Eof, lexeme: "", loc: loc }
  tok.kind = kind
  tok.lexeme = lexeme
  return tok
end

## Extend TokenType with method-call syntax.
##
## Dogfooding: validates extend block on enum types.
## Converts free functions to methods: tt.name(), tt.has_lexeme()
##
## @since Phase 0 dogfooding
extend TokenType
  ## Returns the display name of this token type.
  ## @returns Uppercase string name (e.g., "IDENT", "PLUS", "DEF")
  def name(): String
    match self
      TokenType::Eof => return "EOF"
      TokenType::Newline => return "NEWLINE"
      TokenType::Error => return "ERROR"
      TokenType::Ident => return "IDENT"
      TokenType::Int => return "INT"
      TokenType::Float => return "FLOAT"
      TokenType::Char => return "CHAR"
      TokenType::String => return "STRING"
      TokenType::Def => return "DEF"
      TokenType::End => return "END"
      TokenType::If => return "IF"
      TokenType::Else => return "ELSE"
      TokenType::Elsif => return "ELSIF"
      TokenType::While => return "WHILE"
      TokenType::Return => return "RETURN"
      TokenType::And => return "AND"
      TokenType::Or => return "OR"
      TokenType::Not => return "NOT"
      TokenType::True => return "TRUE"
      TokenType::False => return "FALSE"
      TokenType::Let => return "LET"
      TokenType::Var => return "VAR"
      TokenType::Break => return "BREAK"
      TokenType::Continue => return "CONTINUE"
      TokenType::For => return "FOR"
      TokenType::In => return "IN"
      TokenType::Struct => return "STRUCT"
      TokenType::Enum => return "ENUM"
      TokenType::Match => return "MATCH"
      TokenType::When => return "WHEN"
      TokenType::Then => return "THEN"
      TokenType::Import => return "IMPORT"
      TokenType::From => return "FROM"
      TokenType::As => return "AS"
      TokenType::Private => return "PRIVATE"
      TokenType::Public => return "PUBLIC"
      TokenType::Plus => return "PLUS"
      TokenType::Minus => return "MINUS"
      TokenType::Star => return "STAR"
      TokenType::Slash => return "SLASH"
      TokenType::Percent => return "PERCENT"
      TokenType::PlusEq => return "PLUS_EQ"
      TokenType::MinusEq => return "MINUS_EQ"
      TokenType::StarEq => return "STAR_EQ"
      TokenType::SlashEq => return "SLASH_EQ"
      TokenType::PercentEq => return "PERCENT_EQ"
      TokenType::Eq => return "EQ"
      TokenType::Ne => return "NE"
      TokenType::Lt => return "LT"
      TokenType::Gt => return "GT"
      TokenType::Le => return "LE"
      TokenType::Ge => return "GE"
      TokenType::Amp => return "AMP"
      TokenType::Pipe => return "PIPE"
      TokenType::Caret => return "CARET"
      TokenType::Tilde => return "TILDE"
      TokenType::Lshift => return "LSHIFT"
      TokenType::Rshift => return "RSHIFT"
      TokenType::Assign => return "ASSIGN"
      TokenType::Colon => return "COLON"
      TokenType::DoubleColon => return "DOUBLE_COLON"
      TokenType::Comma => return "COMMA"
      TokenType::Dot => return "DOT"
      TokenType::DotDot => return "DOTDOT"
      TokenType::FatArrow => return "FAT_ARROW"
      TokenType::Question => return "QUESTION"
      TokenType::Underscore => return "UNDERSCORE"
      TokenType::Lparen => return "LPAREN"
      TokenType::Rparen => return "RPAREN"
      TokenType::Lbracket => return "LBRACKET"
      TokenType::Rbracket => return "RBRACKET"
      TokenType::Lbrace => return "LBRACE"
      TokenType::Rbrace => return "RBRACE"
      TokenType::StringStart => return "STRING_START"
      TokenType::StringPart => return "STRING_PART"
      TokenType::InterpStart => return "INTERP_START"
      TokenType::InterpEnd => return "INTERP_END"
      TokenType::StringEnd => return "STRING_END"
    end
    return "UNKNOWN"
  end

  ## Checks if this token type has a meaningful lexeme to display.
  ## @returns true if lexeme should be displayed, false otherwise
  def has_lexeme(): Bool
    match self
      TokenType::Ident => return true
      TokenType::Int => return true
      TokenType::Float => return true
      TokenType::Char => return true
      TokenType::String => return true
      TokenType::StringPart => return true
      _ => return false
    end
  end
end

## Extend Token with method-call syntax.
##
## Dogfooding: validates extend block on struct types.
## Converts token_format free function to .format() method.
##
## @since Phase 0 dogfooding
extend Token
  ## Formats this token for display.
  ## Format: `line:col TYPE [lexeme]`
  ## @returns Formatted string representation
  def format(): String
    var tt_name = self.kind.name()
    if self.kind.has_lexeme()
      return "#{self.loc.line}:#{self.loc.col} #{tt_name} #{self.lexeme}"
    end
    return "#{self.loc.line}:#{self.loc.col} #{tt_name}"
  end
end


