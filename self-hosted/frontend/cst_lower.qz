##! # CST → AST Lowering — Formatter M1.3c (first increment)
##!
##! Lowers a lossless `cst::CstStorage` green tree into a semantic
##! `ast::AstStorage` tree by dispatching over `CstNodeKind` and REUSING the
##! existing `ast_*` constructors. Reusing the constructors guarantees the AST
##! slot layout is identical-by-construction to what `parser.qz`'s recursive-descent
##! web produces, so lowering reduces to handing each constructor the right lowered
##! children + scalars. (A legacy↔CST structural-equivalence differential drove this
##! bring-up; it was retired once CST became the sole parser.)
##!
##! ## This increment (M1.3c-2, first slice)
##! A COMPILING, always-safe lowering covering a handful of expression /
##! statement / definition families end-to-end — enough to lower a small real
##! program and MATCH the legacy parser's fingerprint on a fixture. Breadth is
##! NOT the goal yet. Every unhandled `CstNodeKind` degrades to a VISIBLE
##! placeholder ident (`__UNLOWERED_<kindnum>`) so the tree stays valid and the
##! mismatch surfaces in the fingerprint diff — it NEVER crashes and never
##! indexes a non-handle.
##!
##! ## CST source shape (the input side)
##! `cst_parser` is a lossless TOKEN TREE: a node's `children` Vec interleaves
##! `CST_TOKEN` leaves (kind 1 — keywords / names / operators / punctuation,
##! lexeme in str1) with structured sub-nodes (operands / params / body).
##! Lowering each kind = pick the meaningful STRUCTURED children + read token
##! lexemes where a name/scalar is needed, then call the matching `ast_*`
##! constructor. Surface discriminants live in `op` (CstOp), `str1`/`str2`.
##!
##! @see docs/conductor/M1.3c-lowering-spec.md  The per-kind slot map.
##! @since 5.12.21-alpha (formatter epic)

import cst
import ast
import node_constants
import cfg
import cst_parser
import lexer
import string_intern
import diagnostic

# ===========================================================================
# Rejection diagnostics
# ===========================================================================

## Emit a hard parse-level rejection from the CST lowering path. The legacy
## parser (parser.qz ps_error) accumulates these during parsing; the CST path
## lowers AFTER parsing, so it raises the same class of rejection here by
## emitting a DIAG_ERROR. quartz.qz bails when diag_error_count() > 0 after
## lowering, matching the legacy "had_error" gate. `msg` mirrors the legacy
## ps_error string verbatim so spec stderr assertions match byte-for-byte.
def cl_reject(msg: String, line: Int, col: Int): Void
  var d = diagnostic::diag_new_simple(diagnostic::DIAG_ERROR, "QZ0101", msg)
  diagnostic::diag_emit(d)
end

## True (1) iff `lex` is a reserved keyword that cannot legally appear as an
## identifier at a binding site. The CST stores token leaves as lexeme strings
## only (no token type), so this matches by lexeme against the SAME keyword set
## as parser.qz's `_ps_is_reserved_ident_token`. Drives the QZ0530 reject at
## var/param/for-var/match-binding positions. Keep in sync with parser.qz:440.
def cl_is_reserved_ident_lexeme(lex: String): Int
  return 1 if str_eq(lex, "def")
  return 1 if str_eq(lex, "end")
  return 1 if str_eq(lex, "if")
  return 1 if str_eq(lex, "unless")
  return 1 if str_eq(lex, "else")
  return 1 if str_eq(lex, "elsif")
  return 1 if str_eq(lex, "while")
  return 1 if str_eq(lex, "do")
  return 1 if str_eq(lex, "return")
  return 1 if str_eq(lex, "and")
  return 1 if str_eq(lex, "or")
  return 1 if str_eq(lex, "not")
  return 1 if str_eq(lex, "true")
  return 1 if str_eq(lex, "false")
  return 1 if str_eq(lex, "let")
  return 1 if str_eq(lex, "var")
  return 1 if str_eq(lex, "break")
  return 1 if str_eq(lex, "continue")
  return 1 if str_eq(lex, "for")
  return 1 if str_eq(lex, "in")
  return 1 if str_eq(lex, "struct")
  return 1 if str_eq(lex, "enum")
  return 1 if str_eq(lex, "match")
  return 1 if str_eq(lex, "when")
  return 1 if str_eq(lex, "then")
  return 1 if str_eq(lex, "import")
  return 1 if str_eq(lex, "trait")
  return 1 if str_eq(lex, "impl")
  return 1 if str_eq(lex, "extern")
  return 1 if str_eq(lex, "await")
  return 1 if str_eq(lex, "defer")
  return 1 if str_eq(lex, "arena")
  return 1 if str_eq(lex, "try")
  return 1 if str_eq(lex, "catch")
  return 1 if str_eq(lex, "nil")
  return 1 if str_eq(lex, "is")
  return 1 if str_eq(lex, "async")
  return 1 if str_eq(lex, "go")
  return 1 if str_eq(lex, "const")
  return 1 if str_eq(lex, "newtype")
  return 1 if str_eq(lex, "type")
  return 1 if str_eq(lex, "extend")
  return 1 if str_eq(lex, "loop")
  return 1 if str_eq(lex, "macro")
  return 1 if str_eq(lex, "yield")
  return 1 if str_eq(lex, "actor")
  return 1 if str_eq(lex, "can")
  return 1 if str_eq(lex, "effect")
  return 1 if str_eq(lex, "with")
  return 1 if str_eq(lex, "reify")
  return 1 if str_eq(lex, "from")
  return 1 if str_eq(lex, "as")
  return 1 if str_eq(lex, "where")
  return 1 if str_eq(lex, "private")
  return 1 if str_eq(lex, "public")
  return 0
end

## Emit the QZ0530 reserved-keyword-at-binding-site diagnostic if `lex` is a
## reserved keyword. Mirrors parser.qz's ps_expect_binding_name message verbatim
## so spec stderr assertions match. `context` names the binding position.
def cl_check_binding_name(lex: String, context: String, line: Int, col: Int): Void
  if cl_is_reserved_ident_lexeme(lex) == 1
    cl_reject("QZ0530: '#{lex}' is a reserved keyword and cannot be used as an identifier in #{context}", line, col)
  end
end

# ===========================================================================
# Backbone child-iteration helpers
# ===========================================================================

## True if CST node `h` is a verbatim CST_TOKEN leaf (kind 1).
def cl_is_token(cs: cst::CstStorage, h: Int): Int
  if cst::cst_get_kind(cs, h) == 1
    return 1
  end
  return 0
end

## Returns the handle of the i-th STRUCTURED (non-token) child of `h`, or 0 if
## there are fewer than `i+1` structured children. Skips CST_TOKEN leaves.
def cl_structured_child(cs: cst::CstStorage, h: Int, i: Int): Int
  var n = cst::cst_child_count(cs, h)
  var seen = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      if seen == i
        return c
      end
      seen = seen + 1
    end
    j = j + 1
  end
  return 0
end

## Number of STRUCTURED (non-token) children of `h`.
def cl_structured_count(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var seen = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      seen = seen + 1
    end
    j = j + 1
  end
  return seen
end

## True (1) iff `h` has any STRUCTURED (non-token) child at an index strictly
## greater than `after_idx`. Used by the CST_PROGRAM loop to detect whether a
## cfg-dropped top-level decl is the FINAL item (legacy emits an int_lit(0)
## placeholder only when the cfg-false decl is at EOF).
def cl_has_structured_after(cs: cst::CstStorage, h: Int, after_idx: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = after_idx + 1
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      return 1
    end
    j = j + 1
  end
  return 0
end

## Returns the handle of the i-th child of `h` whose CstNodeKind == `kind`, or
## 0 if none. Used to locate e.g. the CST_PARAM_LIST inside a function header.
def cl_child_of_kind(cs: cst::CstStorage, h: Int, kind: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == kind
      return c
    end
    j = j + 1
  end
  return 0
end

## Lexeme of the first CST_TOKEN child of `h` (empty string if none). Literal /
## ident CST nodes hold their single source token as their only child.
def cl_first_token_lexeme(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      return cst::cst_get_str1(cs, c)
    end
    j = j + 1
  end
  return ""
end

## Handle of the first CST_TOKEN child of `h` (0 if none). Companion to
## cl_first_token_lexeme for callers that need the token's byte span, not just
## its lexeme (e.g. discriminating a string-literal param from an ident param).
def cl_first_token_handle(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      return c
    end
    j = j + 1
  end
  return 0
end

## True (1) iff token `t` is a string-literal token. The lexer STRIPS the
## surrounding quotes from a TOK_STRING lexeme, so a string token's source span
## is strictly wider than its lexeme byte length (covers the two quote bytes),
## whereas an ident/keyword token's span equals its lexeme. Mirrors the
## span-vs-lexeme test in cl_lower_literal_pattern (line ~6517).
def cl_token_is_string(cs: cst::CstStorage, t: Int): Int
  if t == 0
    return 0
  end
  var lex = cst::cst_get_str1(cs, t)
  if str_byte_len(lex) > 0 and str_byte_at(lex, 0) == 34
    return 1
  end
  if (cst::cst_get_byte_end(cs, t) - cst::cst_get_byte_start(cs, t)) > str_byte_len(lex)
    return 1
  end
  return 0
end

## Variant-name lexeme of a CST_IS_EXPR (kind 67). Children are
## `[subject, is_kw, variant_tok, ...]`; the variant name is the first token
## child whose lexeme is not `is` (the subject is a structured child, skipped).
def cl_is_variant_name(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "is") == 0
        return lex
      end
    end
    j = j + 1
  end
  return ""
end

## Collects the is-binding names of a CST_IS_EXPR (kind 67) bind form
## `x is Variant(a, b, _)`. The payload was captured via cps_capture_balanced,
## so the binding tokens live as TOKEN children between the `(` and `)` leaves.
## Each IDENT / `_` token contributes one entry; commas/parens are skipped.
## Mirrors legacy parser.qz:3656-3689, which pushes `as_int(lexeme)` per binding.
## We intern through the shared global interner (cl_intern_lex) so the raw
## pointer the fingerprinter emits via fp_ids matches the legacy path. Returns a
## Vec of as_int(canonical-String), or 0 when there is no `(` payload (the
## no-bind form, which legacy leaves as int-0 → fp_ids `{}`).
def cl_is_bound_names(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  # Find the opening `(`; before it there is no binding payload.
  var open = 0 - 1
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "(") == 1
      open = j
      j = n
    else
      j = j + 1
    end
  end
  if open < 0
    return 0
  end
  var bn = vec_new()
  var k2 = open + 1
  while k2 < n
    var c2 = cst::cst_get_child(cs, h, k2)
    if cl_is_token(cs, c2) == 1
      var lex = cst::cst_get_str1(cs, c2)
      if str_eq(lex, ")") == 1
        k2 = n
      elsif str_eq(lex, ",") == 0 and str_eq(lex, "(") == 0
        bn.push(as_int(cl_intern_lex(lex)))
        k2 = k2 + 1
      else
        k2 = k2 + 1
      end
    else
      k2 = k2 + 1
    end
  end
  return as_int(bn)
end

## Macro name of a CST_MACRO_CALL (kind 40): the first non-`$` token lexeme.
## cps_parse_dollar captures `[$ tok, name tok, (CST_ARG_LIST)?]`; the name is
## the `$`-less identifier/keyword (`try`, `unwrap`, `assert`, `debug`). Returns
## "" when there is no name token (e.g. a bare `$` — never lowered here).
def cl_macro_name(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "$") == 0
        return lex
      end
    end
    j = j + 1
  end
  return ""
end

## Builds the catch-pattern AST of a CST_TRY_CATCH (kind 74), mirroring the legacy
## catch grammar (parser.qz:5298-5337): `_` → ast_wildcard; bare `Ident` →
## ast_ident(name); `Ident(binds)` → ast_enum_access("", name, bound_names, 0).
## The pattern tokens live BETWEEN the `catch` token and the handler — `catch`,
## then either a `_` leaf or a head-ident leaf (legacy reads ONE ident; `::`-path
## heads are beyond legacy's catch grammar and would legacy-fail upstream), then
## an optional balanced `(a, b)` binding payload (also token leaves). pat line/col
## = the head/`_` token's position. Returns 0 if no pattern was captured.
## Returns the single handler EXPRESSION CST handle of a block-form try-catch
## handler `blk` (a CST_BLOCK), or 0 when the block is not reducible to a single
## expression (zero statements, more than one statement, or a non-expr-statement).
## Legacy ps_parse_try_catch parses the handler as one ps_parse_expr, so only a
## CST_BLOCK holding exactly one CST_EXPR_STMT(44) maps to a legacy handler.
def cl_try_block_handler_expr(cs: cst::CstStorage, blk: Int): Int
  if cl_structured_count(cs, blk) != 1
    return 0
  end
  var stmt = cl_structured_child(cs, blk, 0)
  if stmt == 0 or cst::cst_get_kind(cs, stmt) != 44  # CST_EXPR_STMT
    return 0
  end
  # A plain expr-statement carries the expression as its sole structured child; a
  # keyword-prefixed form (go/async/await) carries a leading keyword token. Reject
  # the keyword forms (cl_first_token_lexeme would be go/async/await) — they are
  # not bare handler expressions in the legacy grammar.
  var kw = cl_first_token_lexeme(cs, stmt)
  if str_eq(kw, "go") or str_eq(kw, "async") or str_eq(kw, "await")
    return 0
  end
  return cl_structured_child(cs, stmt, 0)
end

def cl_lower_catch_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var n = cst::cst_child_count(cs, h)
  # Locate the `catch` token; the pattern starts immediately after it.
  var ci = 0 - 1
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "catch") == 1
      ci = j
      j = n
    else
      j = j + 1
    end
  end
  if ci < 0
    return 0
  end
  # First pattern token after `catch`.
  var k2 = ci + 1
  var head = 0
  while k2 < n
    var c2 = cst::cst_get_child(cs, h, k2)
    if cl_is_token(cs, c2) == 1
      head = c2
      k2 = n
    else
      k2 = k2 + 1
    end
  end
  if head == 0
    return 0
  end
  var pat_line = cst::cst_get_line(cs, head)
  var pat_col = cst::cst_get_col(cs, head)
  var head_lex = cst::cst_get_str1(cs, head)
  if str_eq(head_lex, "_") == 1
    return ast::ast_wildcard(a, pat_line, pat_col)
  end
  # Collect any binding payload `(a, b)` token leaves following the head.
  var bn = vec_new()
  var has_paren = 0
  # Scan children: once past the head token, gather `(` ... `)` ident/`_` leaves
  # until the `)` or the structured handler/block child.
  var idx = 0
  var found_head = 0
  while idx < n
    var cc = cst::cst_get_child(cs, h, idx)
    if cc == head
      found_head = 1
      idx = idx + 1
    elsif found_head == 1 and cl_is_token(cs, cc) == 1
      var lx = cst::cst_get_str1(cs, cc)
      if str_eq(lx, "(") == 1
        has_paren = 1
        idx = idx + 1
      elsif str_eq(lx, ")") == 1
        idx = n
      elsif has_paren == 1 and str_eq(lx, ",") == 0
        bn.push(as_int(cl_intern_lex(lx)))
        idx = idx + 1
      else
        idx = idx + 1
      end
    elsif found_head == 1 and cl_is_token(cs, cc) == 0
      # reached the structured handler/block — pattern is done
      idx = n
    else
      idx = idx + 1
    end
  end
  if has_paren == 1
    return ast::ast_enum_access(a, "", head_lex, as_int(bn), 0, pat_line, pat_col)
  end
  return ast::ast_ident(a, head_lex, pat_line, pat_col)
end

# ===========================================================================
# Operator mapping: CstOp → AST OpKind
# ===========================================================================

## Maps a CstOp discriminant (cst.qz: CST_OP_*) to the op code parser.qz ACTUALLY
## stores in the AST `op` slot. CRITICAL: parser.qz does NOT use the `enum OpKind`
## declaration order for the AST op codes — it uses a HISTORIC numbering with gaps
## (verified against ps_parse_term/shift/bitand/bitxor/bitor/comparison/equality/
## and/or + ps_parse_unary):
##   +0  -1  *2  /3  %4   ==7  !=8  <9  >11  <=10  >=12
##   and14  or15  &16  |17  ^18  <<19  >>20
##   (unary)  not13  neg14  bitnot18
## The `enum OpKind` in ast.qz (OpEq=5, OpLt=7, …) is STALE w.r.t. these stored
## codes; the fingerprinter emits `ast_get_op` RAW, so we must reproduce these
## exact integers, not the enum positions.
## Compound-assignment CstOps (22..26) map to their BASE binary op (not in this
## increment's families, but provided for completeness). Range CstOps (27..29)
## are NOT handled here (CST_RANGE lowers via its own arm). Unknown → 0.
def cst_op_to_ast_op(cst_op: Int): Int
  if cst_op == 1  # CST_OP_ADD
    return 0
  end
  if cst_op == 2  # CST_OP_SUB
    return 1
  end
  if cst_op == 3  # CST_OP_MUL
    return 2
  end
  if cst_op == 4  # CST_OP_DIV
    return 3
  end
  if cst_op == 5  # CST_OP_MOD
    return 4
  end
  if cst_op == 6  # CST_OP_EQ
    return 7
  end
  if cst_op == 7  # CST_OP_NE
    return 8
  end
  if cst_op == 8  # CST_OP_LT
    return 9
  end
  if cst_op == 9  # CST_OP_LE
    return 10
  end
  if cst_op == 10  # CST_OP_GT
    return 11
  end
  if cst_op == 11  # CST_OP_GE
    return 12
  end
  if cst_op == 12  # CST_OP_AND
    return 14
  end
  if cst_op == 13  # CST_OP_OR
    return 15
  end
  if cst_op == 14  # CST_OP_NOT (unary)
    return 13
  end
  if cst_op == 15  # CST_OP_NEG (unary)
    return 14
  end
  if cst_op == 16  # CST_OP_BITAND
    return 16
  end
  if cst_op == 17  # CST_OP_BITOR
    return 17
  end
  if cst_op == 18  # CST_OP_BITXOR
    return 18
  end
  if cst_op == 19  # CST_OP_BITNOT (unary)
    return 18
  end
  if cst_op == 20  # CST_OP_SHL
    return 19
  end
  if cst_op == 21  # CST_OP_SHR
    return 20
  end
  # Compound-assign → base binary op.
  if cst_op == 22  # CST_OP_ADD_ASSIGN → OpAdd
    return 0
  end
  if cst_op == 23  # CST_OP_SUB_ASSIGN → OpSub
    return 1
  end
  if cst_op == 24  # CST_OP_MUL_ASSIGN → OpMul
    return 2
  end
  if cst_op == 25  # CST_OP_DIV_ASSIGN → OpDiv
    return 3
  end
  if cst_op == 26  # CST_OP_MOD_ASSIGN → OpMod
    return 4
  end
  return 0
end

# ===========================================================================
# Type rendering: CST type node → normalized AST type string
# ===========================================================================

## Renders a CST type node (CST_TYPE_REF, kind 103, a bag of source tokens) to
## the normalized string the AST expects, reproducing `parser.qz`'s
## `ps_parse_type` for the SIMPLE cases:
##   - named type:      `Int`         → "Int"
##   - qualified `::`:  `Result::Ok`  → "Result$Ok"   (legacy maps :: to $)
##   - dotted:          `mod.Type`    → "mod.Type"
##   - generic:         `Vec<Int>`    → "Vec<Int>", `Map<K, V>` → "Map<K, V>"
## EXOTIC forms (impl X, &mut Y, record `{..}`, fn-types `Fn(..)`, `can` rows,
## unions/intersections) are NOT reproduced faithfully here — they emit a
## best-effort space-joined token rendering and are a KNOWN GAP for this
## increment (will diverge in the fingerprint, which is the intended signal).
def cst_type_string(cs: cst::CstStorage, type_node: Int): String
  if type_node == 0
    return ""
  end
  if cst::cst_get_kind(cs, type_node) != 103  # not a CST_TYPE_REF: best-effort
    return cl_first_token_lexeme(cs, type_node)
  end
  # Collect the token-leaf lexemes in order, recursing into any structured
  # children (nested CST_TYPE_REF, e.g. a `: ReturnType` tail), then render.
  var toks = vec_new()
  cl_collect_type_tokens(cs, type_node, toks)
  return cl_render_type_from_tokens(toks)
end

## Flattens a CST_TYPE_REF's token leaves into `toks` (a Vec<String>), recursing
## into structured children so a nested `: Ret` tail contributes its tokens too.
def cl_collect_type_tokens(cs: cst::CstStorage, n: Int, toks: Vec): Void
  var cnt = cst::cst_child_count(cs, n)
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, n, j)
    if cl_is_token(cs, c) == 1
      toks.push(cst::cst_get_str1(cs, c))
    else
      cl_collect_type_tokens(cs, c, toks)
    end
    j = j + 1
  end
end

## Renders a flat list of type-token lexemes into the normalized string
## `parser.qz`'s `ps_parse_type` produces, for the COMMON cases:
##   - named:      `Int`              → "Int"
##   - borrow:     `&` `Int`          → "&Int";  `&` `mut` `T` → "&mut T"
##   - qualified:  `A` `::` `B`       → "A$B"
##   - dotted:     `mod` `.` `Type`   → "mod.Type"
##   - generic:    `Vec` `<` `Int` `>`→ "Vec<Int>"; commas render ", "; `>>` stays
##   - optional:   `Int` `?`          → "Option<Int>"   (T? sugar → Option<T>)
## KNOWN GAP (best-effort space-join, may diverge — flagged): record `{..}`,
## tuple `(..)`, `Fn(..)`-types, `impl`/`dyn` prefixes, `can` rows, union/`&`-
## intersection operators. These are space-join concatenations here, which will
## NOT byte-match parser.qz's spacing for those exotic forms.
def cl_render_type_from_tokens(toks: Vec): String
  var n = toks.size
  if n == 0
    return ""
  end
  # Leading borrow markers: `&` / `&mut`.
  var prefix = ""
  var i = 0
  if i < n and str_eq(toks[i], "&")
    i = i + 1
    if i < n and str_eq(toks[i], "mut")
      i = i + 1
      prefix = "&mut "
    else
      prefix = "&"
    end
  end
  # Trailing `?` → Option<...> wrap (operates on the base sans the `?`).
  var has_opt = 0
  var end_i = n
  if end_i > i and str_eq(toks[end_i - 1], "?")
    has_opt = 1
    end_i = end_i - 1
  end
  # Render the base tokens [i, end_i).
  #
  # Fn-type structural normalization (matches ps_parse_type parser.qz:810-878):
  #   - The Fn-return colon renders `": "` (parser.qz:837) — a `:` that
  #     immediately follows a `)` is a Fn-return colon (the only place a `:`
  #     follows a `)` in a type string). This handles NESTED Fn-types
  #     (`Fn(Fn(): Int): Int`) correctly regardless of paren depth, since each
  #     inner return colon also directly follows its own `)`.
  #   - The trailing `can` effect-row (parser.qz:860-878) renders in the
  #     SPACE form ` can [Label] [| tail]` (NOT the brace fingerprint form).
  #     `can` → `" can"`; a `|` inside the can-row → `" | "`; the label/tail
  #     idents follow with the surrounding spaces already emitted.
  var out = ""
  var j = i
  while j < end_i
    var lex = toks[j]
    if str_eq(lex, ",")
      out = out + ", "
    elsif str_eq(lex, "::")
      out = out + "$"
    elsif str_eq(lex, "{")
      # Record-type open brace `{ x: Int, y: String }` (parser.qz:725 `"{ "`).
      out = out + "{ "
    elsif str_eq(lex, "}")
      # Record-type close brace (parser.qz:763 `" }"`).
      out = out + " }"
    elsif str_eq(lex, ":")
      # Colon in a type string is always a separator with a single trailing
      # space: a record field colon (`x: Int`, parser.qz:732) OR an Fn-return
      # colon (`): Ret`, parser.qz:837). Both render `": "`.
      out = out + ": "
    elsif str_eq(lex, "can")
      # Effect-row keyword on an Fn/impl type, rendered in the SPACE form
      # ` can [Label] [| tail]` (parser.qz:860-878). Consume the can-row as a
      # block so the label/tail idents get the legacy leading spaces.
      out = out + " can"
      j = j + 1
      # Optional single closed label ident → ` Label`.
      if j < end_i and str_eq(toks[j], "|") == 0
        out = out + " " + toks[j]
        j = j + 1
      end
      # Optional ` | tail` open-row tail.
      if j < end_i and str_eq(toks[j], "|")
        j = j + 1
        if j < end_i
          out = out + " | " + toks[j]
          j = j + 1
        else
          out = out + " |"
        end
      end
      # Loop's trailing `j = j + 1` would over-advance; compensate.
      j = j - 1
    elsif str_eq(lex, "@")
      # Fn-type effect bound `@pure` / `@io` / `@E` (parser.qz:842-849 renders
      # `" @#{eff_name}"`): a SPACE precedes the `@`, and the following effect-
      # name IDENT token concatenates directly (no space after `@`). `@` is its
      # own TOK_AT leaf; the name arrives as the next loop token.
      out = out + " @"
    elsif str_eq(lex, "impl") or str_eq(lex, "dyn")
      # `impl`/`dyn` existential/trait-object prefix: single space after the
      # keyword (parser.qz:700/702 `impl #{trait_type}`). `dyn` is reserved
      # (QZ0166) but renders with the same spacing for forward-compat.
      out = out + lex + " "
    elsif str_eq(lex, "|")
      # Union `A | B` (parser.qz:938) and open-record `| ..` (parser.qz:756/768)
      # both render the pipe as ` | `. (Can-row `|` is consumed by the `can`
      # block above, so this only fires for top-level union/open-record pipes.)
      out = out + " | "
    elsif str_eq(lex, "&")
      # Intersection `A & B` (parser.qz:941/771): ` & `. (A leading borrow
      # `&`/`&mut` is consumed before the loop, so this is always intersection.)
      out = out + " & "
    else
      out = out + lex
    end
    j = j + 1
  end
  if has_opt == 1
    return "#{prefix}Option<#{out}>"
  end
  return "#{prefix}#{out}"
end

# ===========================================================================
# Param-list lowering
# ===========================================================================

## True iff a CST_PARAM (kind 86) is a PATTERN param of a multi-clause function
## def — `def factorial(0)`, `def bool_desc(true)`, `def wild(_)`, `def add(0, m)`.
## Mirrors parser.qz:ps_is_param_pattern, which inspects the FIRST token's TYPE.
## The CST stores only lexemes (no token type), so we discriminate by lexeme:
##   - `_`                       → wildcard pattern
##   - `true` / `false`         → bool-literal pattern (both are keywords, so they
##                                 can never be a binding name → no ambiguity)
##   - all-digit lexeme         → int-literal pattern (not a legal ident → unambiguous)
##   - leading `-` then digits  → negative-int-literal pattern
## A pattern param NEVER carries a `:` type annotation (legacy parses it via
## ps_parse_pattern_param, which reads no type). KNOWN GAP: string-literal and
## uppercase-variant patterns (`def greet("hi")`, `def f(Some(v))`) are NOT
## detectable here — the CST flattens a TOK_STRING token to its unquoted lexeme
## (indistinguishable from a bare ident param) and cps_parse_param does not
## structure variant patterns; recovering them requires a cst_parser change so
## those clauses still mis-lower as ordinary params (tracked: M1.3c assert/string).
def cl_param_is_pattern(cs: cst::CstStorage, ph: Int): Int
  var cnt = cst::cst_child_count(cs, ph)
  # A type annotation (`name : Type`) means this is a normal binding param.
  var has_colon = 0
  var first_lex = ""
  var second_lex = ""
  var seen = 0
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, ph, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, ":")
        has_colon = 1
      end
      if seen == 0
        first_lex = lex
      elsif seen == 1
        second_lex = lex
      end
      seen = seen + 1
    end
    j = j + 1
  end
  if has_colon == 1
    return 0
  end
  if str_eq(first_lex, "_")
    return 1
  end
  if str_eq(first_lex, "true") or str_eq(first_lex, "false")
    return 1
  end
  if cl_lex_is_all_digits(first_lex) == 1
    return 1
  end
  if str_eq(first_lex, "-") and cl_lex_is_all_digits(second_lex) == 1
    return 1
  end
  # String-literal pattern param (`def greet("hello")`). The lexer strips the
  # quotes, so the lexeme alone is indistinguishable from a bare ident param;
  # discriminate by the first token's source span (quotes make it wider). Legacy
  # ps_is_param_pattern returns 1 for TOK_STRING.
  if cl_token_is_string(cs, cl_first_token_handle(cs, ph)) == 1
    return 1
  end
  return 0
end

## True iff `lex` is a non-empty all-digit run (a plain decimal int literal). Used
## to discriminate an int-literal pattern param from a binding-name param.
def cl_lex_is_all_digits(lex: String): Int
  var n = str_byte_len(lex)
  if n == 0
    return 0
  end
  var i = 0
  while i < n
    var b = str_byte_at(lex, i)
    if b < '0' or b > '9'
      return 0
    end
    i = i + 1
  end
  return 1
end

## Lowers a pattern param (multi-clause def, e.g. `def factorial(0)`) to an
## ast_param with the synthetic name `_cp<idx>` and the lowered pattern attached
## via ast_param_set_pattern. Reproduces parser.qz:ps_parse_pattern_param byte for
## byte: synth_name = "_cp#{idx}", type "", pattern = ps_parse_pattern's result.
## The pattern is rebuilt from the CST_PARAM's flat token leaves (int/bool/wildcard
## /negative-int — the forms cl_param_is_pattern detects).
def cl_lower_pattern_param(cs: cst::CstStorage, ph: Int, idx: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, ph)
  var col = cst::cst_get_col(cs, ph)
  var first_lex = cl_first_token_lexeme(cs, ph)
  var pat = 0
  if str_eq(first_lex, "_")
    pat = ast::ast_wildcard(a, line, col)
  elsif str_eq(first_lex, "true")
    pat = ast::ast_bool_lit(a, 1, line, col)
  elsif str_eq(first_lex, "false")
    pat = ast::ast_bool_lit(a, 0, line, col)
  elsif str_eq(first_lex, "-")
    # Negative-int pattern: `-` then the digit token. Second token lexeme.
    var neg_lex = cl_nth_token_lexeme(cs, ph, 1)
    pat = ast::ast_int_lit(a, 0 - lexer::ps_parse_int_value(neg_lex), line, col)
  elsif cl_token_is_string(cs, cl_first_token_handle(cs, ph)) == 1
    # String-literal pattern (`def greet("hello")`). The lexer already stripped
    # the quotes, so `first_lex` is the bare content — exactly what legacy's
    # ps_parse_pattern feeds to ast_string_lit (TOK_STRING arm).
    pat = ast::ast_string_lit(a, first_lex, line, col)
  else
    pat = ast::ast_int_lit(a, lexer::ps_parse_int_value(first_lex), line, col)
  end
  var synth_name = "_cp#{idx}"
  # -1 = "no default" sentinel (matches legacy parser.qz:6525); a pattern param
  # is always required, so it must count toward required_count (typecheck.qz:5089).
  var param = ast::ast_param(a, synth_name, "", 0, -1, line, col)
  ast::ast_param_set_pattern(a, param, pat)
  return param
end

## Lexeme of the n-th (0-based) TOKEN leaf of `h`, or "" if fewer than n+1 exist.
def cl_nth_token_lexeme(cs: cst::CstStorage, h: Int, n: Int): String
  var cnt = cst::cst_child_count(cs, h)
  var seen = 0
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if seen == n
        return cst::cst_get_str1(cs, c)
      end
      seen = seen + 1
    end
    j = j + 1
  end
  return ""
end

## Lowers a CST_PARAM (kind 86, a token bag like `name : Type [= default]`) to an
## ast_param. Extracts the param NAME (first ident-ish token before a `:`), the
## type STRING (the CST_TYPE_REF structured child, or tokens after `:`), and
## leaves is_variadic=0 / default=0 for this increment (KNOWN GAP: defaults,
## `&`/`&mut`, `self`, variadic `...` are not yet modeled; pattern params are
## detected in cl_lower_param_list and routed to cl_lower_pattern_param).
def cl_lower_param(cs: cst::CstStorage, ph: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, ph)
  var col = cst::cst_get_col(cs, ph)
  # CST_PARAM is a flat token bag `name : Type...` (NOT a CST_TYPE_REF). The
  # NAME is the first token before the `:`; the TYPE is the normalized join of
  # every token AFTER the `:` (plus any structured CST_TYPE_REF/nested children).
  var name = ""
  var cnt = cst::cst_child_count(cs, ph)
  var j = 0
  var seen_colon = 0
  var seen_eq = 0
  var type_toks = vec_new()
  # item-20 Phase 7 (WS4-a) — leading borrow-marker prefix on a receiver param:
  # `&self` / `&mut self`. Mirrors the type-position scan in
  # cl_render_type_from_tokens:613-624. We CONSUME the `&` (and optional `mut`)
  # token leaves so the name-extraction loop below binds NAME to the following
  # token (`self`) exactly as the bare-`self` case — the borrow ABI predicate
  # requires params[0]=="self". recv_borrow ∈ {0=bare, 1=&self, 2=&mut self}.
  var recv_borrow = 0
  # Peek the first TOKEN leaf; if it is `&`, this is a borrow receiver.
  if cst::cst_child_count(cs, ph) > 0
    var pk = 0
    while pk < cnt
      var pc = cst::cst_get_child(cs, ph, pk)
      if cl_is_token(cs, pc) == 1
        if str_eq(cst::cst_get_str1(cs, pc), "&")
          recv_borrow = 1
          j = pk + 1
          # Optional `mut` immediately after `&` → mutable borrow.
          var mk = pk + 1
          while mk < cnt
            var mc = cst::cst_get_child(cs, ph, mk)
            if cl_is_token(cs, mc) == 1
              if str_eq(cst::cst_get_str1(cs, mc), "mut")
                recv_borrow = 2
                j = mk + 1
              end
              mk = cnt
            else
              mk = mk + 1
            end
          end
        end
        pk = cnt
      else
        pk = pk + 1
      end
    end
  end
  # -1 is the "no default" sentinel (0 is a valid AST node handle). Legacy
  # ps_parse_param (parser.qz:6560) uses -1 so typecheck.qz:5089's
  # `default_value < 0` correctly counts params without defaults as REQUIRED.
  # Initializing to 0 made every CST-lowered param look defaulted, so
  # required_count stayed 0 and under-arity calls silently compiled.
  var default_node = -1
  while j < cnt
    var c = cst::cst_get_child(cs, ph, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, ":") and seen_colon == 0 and seen_eq == 0
        seen_colon = 1
      elsif str_eq(lex, "=")
        seen_eq = 1
      elsif seen_eq == 1
        # default value tokens — captured via the structured child below
      elsif seen_colon == 0 and str_byte_len(name) == 0
        name = lex
      elsif seen_colon == 1
        type_toks.push(lex)
      end
    else
      # Structured child: the default expr (after `=`) or a nested type ref
      # (after `:`). Flatten type-ref leaves into the type-token list; lower the
      # default expr to a real AST node so it lands in ast_param's default slot.
      # default_node starts at the -1 "no default" sentinel; `< 0` = not yet set.
      if seen_eq == 1 and default_node < 0
        default_node = cst_lower_node(cs, c, a)
      elsif seen_colon == 1 and seen_eq == 0
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  cl_check_binding_name(name, "function parameter", line, col)
  var type_ann = cl_render_type_from_tokens(type_toks)
  var param = ast::ast_param(a, name, type_ann, 0, default_node, line, col)
  # item-20 Phase 7 (WS4-a) — carry the explicit receiver-borrow marker onto the
  # param. 0 (bare / non-receiver) is the constructor default, so this only
  # writes for the `&self` / `&mut self` receiver forms; byte-identical otherwise.
  if recv_borrow != 0
    ast::ast_param_set_receiver_borrow(a, param, recv_borrow)
  end
  return param
end

## Lowers a CST_PARAM_LIST (kind 87) to a Vec<Int> of lowered ast_param handles
## (insertion order). Token leaves (parens, commas) are skipped.
def cl_lower_param_list(cs: cst::CstStorage, plist: Int, a: ast::AstStorage): Vec
  var params = vec_new()
  if plist == 0
    return params
  end
  var cnt = cst::cst_child_count(cs, plist)
  var j = 0
  # `param_idx` counts EVERY param (pattern or binding), matching parser.qz's
  # running index so pattern params get the legacy `_cp<idx>` synthetic name.
  var param_idx = 0
  while j < cnt
    var c = cst::cst_get_child(cs, plist, j)
    if cst::cst_get_kind(cs, c) == 86  # CST_PARAM
      if cl_param_is_pattern(cs, c) == 1
        params.push(cl_lower_pattern_param(cs, c, param_idx, a))
      else
        params.push(cl_lower_param(cs, c, a))
      end
      param_idx = param_idx + 1
    end
    j = j + 1
  end
  return params
end

# ===========================================================================
# Function lowering (CST_FUNCTION_BLOCK / CST_FUNCTION_ENDLESS)
# ===========================================================================

## Lowers a function definition. CST children (per cst_parser):
##   [def_kw, name_tok, (dot,seg)*, <generic toks>, param_list_node,
##    (colon, ret_ty_node)?, <can/where toks>, (eq, body_expr) | body_block end]
## We scan by ROLE: name = the token right before the CST_PARAM_LIST; params =
## the CST_PARAM_LIST child; return type = the CST_TYPE_REF appearing AFTER the
## param list (the `: RetType` segment); body = the trailing structured node
## (CST_BLOCK for block form, or the body expr for endless form).
## is_private=0, type_params/bounds="" for this increment (KNOWN GAP: generics,
## visibility, can-rows, guards, dotted/operator names are not yet modeled).
## Extract the def-header effect row (`can [Label, ...] [| tail]`) from the
## function node's flat token-leaf children and attach it to the AST fn node,
## reproducing parser.qz's ps_parse_can_row / ps_parse_effect_label byte-for-byte.
##
## The CST captures the can clause as flat TOKEN leaves on the function node:
## the `can` keyword leaf, then ident leaves (labels) — each possibly followed
## by a `<...>` generic-arg run that is SKIPPED (only the bare label name is
## recorded, mirroring ps_parse_effect_label) — separated by `,`, then an
## optional `|` followed by a tail-var ident. Bare `can` (no labels/pipe) is the
## explicitly-empty closed row and still sets the present flag → `:can{|}`.
##
## `start_idx` is the first child index to scan from (just past the param list).
## True iff an inline `can` clause token leaf appears among the header children
## from `start_idx` onward (before any `where`/`when`/`=` or structured child).
## Mirrors the detection cl_attach_can_row uses to locate the `can` keyword.
def cl_header_has_inline_can(cs: cst::CstStorage, h: Int, start_idx: Int): Int
  var cnt = cst::cst_child_count(cs, h)
  var ci = start_idx
  while ci < cnt
    var c = cst::cst_get_child(cs, h, ci)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "can")
      return 1
    end
    ci = ci + 1
  end
  return 0
end

## SURF.2 where-clause lowering. The header token leaves captured by
## cps_capture_sig_clauses include a standalone `where` keyword followed by its
## comma-separated constraint items:
##   where T: Trait1 + Trait2, U: Trait3, e
## Each item is either a trait bound `Ident: Bound[+Bound...]` (merged into the
## SAME `type_param_bounds` string the inline `<...>` form feeds, so
## tc_validate_trait_bounds enforces it identically) or a bare `Ident` effect-row
## variable (hoisted `can e`). Mirrors parser.qz:6330-6378 byte-for-byte.
##
## Returns the trait-bound additions as a comma-joined string (empty if none);
## pushes each effect-row variable name into `evars_out`. The mutual-exclusion
## reject (inline `can` AND a where effect-var) is raised by the caller, which
## knows whether an inline `can` is present.
def cl_collect_where_clause(cs: cst::CstStorage, h: Int, start_idx: Int, evars_out: Vec): String
  var cnt = cst::cst_child_count(cs, h)
  # Locate the standalone `where` keyword leaf (NOT a `where` nested inside a
  # `can`/`when` run — those are stopped at by cl_attach_can_row; here we scan
  # the whole header run and key on the lexeme, which is reserved TOK_WHERE).
  var wi = start_idx
  var where_idx = 0 - 1
  while wi < cnt
    var c = cst::cst_get_child(cs, h, wi)
    # Skip structured children (the return-type CST_TYPE_REF sits between the
    # param list and the where-clause token leaves). Only token leaves can be
    # the `where` keyword.
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "where")
      where_idx = wi
      wi = cnt
    else
      wi = wi + 1
    end
  end
  if where_idx < 0
    return ""
  end
  var bounds_add = ""
  var k = where_idx + 1
  while k < cnt
    var c = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c) == 0
      k = cnt
    else
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "=") or str_eq(lex, "when") or str_eq(lex, "can")
        k = cnt
      elsif str_eq(lex, ",")
        k = k + 1
      else
        # An item head ident. Peek the next token leaf for a `:`.
        var item = lex
        k = k + 1
        var has_colon = 0
        if k < cnt
          var nc = cst::cst_get_child(cs, h, k)
          if cl_is_token(cs, nc) == 1 and str_eq(cst::cst_get_str1(cs, nc), ":")
            has_colon = 1
          end
        end
        if has_colon == 1
          k = k + 1  # consume `:`
          # Bound run: Trait1 [+ Trait2 ...]. Each bound name may carry generic
          # args `Iter<Int>` — capture angle-balanced, mirroring
          # ps_parse_trait_bound_name's ", " / tight spacing.
          var bres = vec_new()
          k = cl_render_bound_name(cs, h, k, cnt, bres)
          var bounds = ""
          if bres.size > 0
            bounds = bres[0]
          end
          while k < cnt
            var pc = cst::cst_get_child(cs, h, k)
            if cl_is_token(cs, pc) == 1 and str_eq(cst::cst_get_str1(cs, pc), "+")
              k = k + 1
              var bres2 = vec_new()
              k = cl_render_bound_name(cs, h, k, cnt, bres2)
              if bres2.size > 0
                bounds = "#{bounds}+#{bres2[0]}"
              end
            else
              break
            end
          end
          var entry = "#{item}:#{bounds}"
          if str_byte_len(bounds_add) > 0
            bounds_add = "#{bounds_add},#{entry}"
          else
            bounds_add = entry
          end
        else
          # Bare ident = effect-row variable.
          evars_out.push(item)
        end
      end
    end
  end
  return bounds_add
end

def cl_attach_can_row(cs: cst::CstStorage, h: Int, start_idx: Int, fnode: Int, a: ast::AstStorage): Void
  var cnt = cst::cst_child_count(cs, h)
  # Locate the `can` keyword token leaf. `can` is a reserved keyword (TOK_CAN),
  # so its lexeme cannot collide with a user identifier leaf.
  var ci = start_idx
  var can_idx = 0 - 1
  while ci < cnt
    var c = cst::cst_get_child(cs, h, ci)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "can")
      can_idx = ci
      ci = cnt
    else
      ci = ci + 1
    end
  end
  if can_idx < 0
    return
  end

  # A `can` clause is present: collect labels + optional tail, stopping at the
  # first non-clause token (a `where`/`when` keyword) or any structured child
  # (the body / return-type node).
  var labels = vec_new<String>()
  var tail = ""
  var seen_pipe = 0
  var k = can_idx + 1
  while k < cnt
    var c = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c) == 0
      k = cnt
    else
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "where") or str_eq(lex, "when") or str_eq(lex, "=")
        # `where`/`when` start a sibling clause; `=` is the endless-form body
        # marker (cps_capture_sig_clauses stops the clause at TOK_ASSIGN, which
        # is then pushed as a separate child). None belong to the effect row.
        k = cnt
      elsif str_eq(lex, ",")
        k = k + 1
      elsif str_eq(lex, "|")
        seen_pipe = 1
        k = k + 1
      elsif seen_pipe == 1
        # First ident after `|` is the tail variable.
        tail = lex
        k = cnt
      else
        # Effect label. Record the bare name, then skip a trailing `<...>`
        # generic-arg run (angle-depth aware, RSHIFT `>>` closes two), exactly
        # as ps_parse_effect_label does.
        labels.push(lex)
        k = k + 1
        if k < cnt
          var nxt = cst::cst_get_child(cs, h, k)
          if cl_is_token(cs, nxt) == 1 and str_eq(cst::cst_get_str1(cs, nxt), "<")
            k = k + 1
            var depth = 1
            while depth > 0 and k < cnt
              var t = cst::cst_get_child(cs, h, k)
              if cl_is_token(cs, t) == 1
                var tl = cst::cst_get_str1(cs, t)
                if str_eq(tl, "<")
                  depth = depth + 1
                elsif str_eq(tl, ">")
                  depth = depth - 1
                elsif str_eq(tl, ">>")
                  depth = depth - 2
                end
                k = k + 1
              else
                depth = 0
              end
            end
          end
        end
      end
    end
  end
  ast::ast_func_set_can_row(a, fnode, labels, tail)
end

def cl_lower_function(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var cnt = cst::cst_child_count(cs, h)

  # Locate the param-list child index.
  var plist = 0
  var plist_idx = 0 - 1
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 87  # CST_PARAM_LIST
      plist = c
      plist_idx = j
      break
    end
    j = j + 1
  end

  # Generic clause: cps_parse_function captures `<T, U:Bound>` as FLAT token
  # leaves between the name token and the param list (cps_parse_type_args_verbatim).
  # Find the index of the first top-level `<` among the header children. That `<`
  # marks (a) where the name scan must stop — the def name is the ident BEFORE the
  # `<`, NOT the `>` close-angle — and (b) the start of the tparam token run.
  var gen_lt_idx = 0 - 1
  if plist_idx > 0
    var g = 0
    while g < plist_idx
      var gc = cst::cst_get_child(cs, h, g)
      if cl_is_token(cs, gc) == 1 and str_eq(cst::cst_get_str1(cs, gc), "<") == 1
        gen_lt_idx = g
        g = plist_idx
      else
        g = g + 1
      end
    end
  end

  # Name = the last TOKEN leaf before the param list (handles `def name(`,
  # and for dotted `Type.method` the segment immediately before `(`). For a
  # generic def the name precedes the `<...>` clause, so cap the backward scan
  # at the generic `<` when present.
  # The `def Type.method(` associated-fn form legacy-mangles to `Type$method`
  # (parser.qz:6181-6188): scan forward from `def` collecting the header ident
  # leaves; a `.` separator between two idents joins with `$`. A plain `def name(`
  # yields the single ident. Stop at the param list (or the generic `<` clause).
  var name = ""
  var name_scan_end = plist_idx
  if gen_lt_idx >= 0
    name_scan_end = gen_lt_idx
  end
  if name_scan_end < 0
    name_scan_end = cnt
  end
  var nk = 0
  while nk < name_scan_end
    var nc = cst::cst_get_child(cs, h, nk)
    if cl_is_token(cs, nc) == 1
      var nlex = cst::cst_get_str1(cs, nc)
      if str_eq(nlex, "def") == 0 and str_eq(nlex, ".") == 0
        if str_eq(name, "") == 1
          name = nlex
        else
          name = "#{name}$#{nlex}"
        end
      end
    end
    nk = nk + 1
  end

  # Type-params + bounds in legacy's DEF-HEADER format (parser.qz:6191-6239):
  #   type_params       = bare comma-joined names, NO brackets/spaces/bounds
  #                       (`T`, `T,U`, `T,N`).
  #   type_param_bounds = ONLY bounded params, `name:Bound[+Bound2]`, comma-joined
  #                       (`T:Eq`, `T:Eq+Ord,U:Show`). Empty when no param is bounded.
  # This is DISTINCT from cl_render_type_params (the struct/enum `<T, U>` form).
  var dh = vec_new()
  var dhp = vec_new()
  cl_render_def_type_params(cs, h, gen_lt_idx, plist_idx, dh, dhp)
  var type_params = str_join(dh, ",")
  var type_param_bounds = str_join(dhp, ",")

  # SURF.2 where-clause: standalone `where T: Show, e` constraints are captured
  # as flat header token leaves after the param list. Merge trait bounds into
  # type_param_bounds (so tc_validate_trait_bounds enforces QZ0200 identically to
  # the inline `<T: Show>` form) and collect effect-row variables for the can-row.
  var where_scan_start = 0
  if plist_idx >= 0
    where_scan_start = plist_idx + 1
  end
  var where_evars = vec_new()
  var where_bounds = cl_collect_where_clause(cs, h, where_scan_start, where_evars)
  if str_byte_len(where_bounds) > 0
    if str_byte_len(type_param_bounds) > 0
      type_param_bounds = "#{type_param_bounds},#{where_bounds}"
    else
      type_param_bounds = where_bounds
    end
  end

  var params = cl_lower_param_list(cs, plist, a)

  # Return type = the CST_TYPE_REF structured child appearing AFTER the param
  # list (the `: RetType` segment). Scan forward from plist_idx. An ABSENT
  # return-type annotation defaults to "Void" (parser.qz:6291/6740 init the
  # local `return_type = "Void"` and only overwrite it when a `:` annotation
  # is present), so a bare `def f()` fingerprints as `:"Void"`, not `:""`.
  var return_type = "Void"
  if plist_idx >= 0
    var ri = plist_idx + 1
    while ri < cnt
      var c = cst::cst_get_child(cs, h, ri)
      if cst::cst_get_kind(cs, c) == 103  # CST_TYPE_REF
        return_type = cst_type_string(cs, c)
        ri = cnt
      else
        ri = ri + 1
      end
    end
  end

  # Body = the LAST structured child that is not the param list and not the
  # return-type node. For block form it is a CST_BLOCK; for endless it is the
  # body expression node.
  var body = 0
  var bi = cnt - 1
  while bi >= 0
    var c = cst::cst_get_child(cs, h, bi)
    if cl_is_token(cs, c) == 0
      var ck = cst::cst_get_kind(cs, c)
      if ck != 87 and ck != 103 and ck != 66  # not param-list, not return-type, not when-guard
        body = c
        bi = 0 - 1
      else
        bi = bi - 1
      end
    else
      bi = bi - 1
    end
  end

  # Multi-clause guard (`def f(n) when n < 0 = ...`): a CST_WHEN_GUARD(66) child
  # captured by cps_capture_sig_clauses holds `when <expr>`. The recursive-descent
  # path (parser.qz:6380-6384) allocates the guard expression's AST handle BEFORE
  # parsing the body. So the guard MUST be lowered BEFORE the body here to match
  # that handle-allocation order. Default -1 (no guard) matches the absent-guard
  # case.
  var guard_node = 0
  var gi = 0
  while gi < cnt
    var gc = cst::cst_get_child(cs, h, gi)
    if cst::cst_get_kind(cs, gc) == 66  # CST_WHEN_GUARD
      guard_node = gc
      gi = cnt
    else
      gi = gi + 1
    end
  end
  var guard_handle = 0 - 1
  if guard_node != 0
    var gexpr = cl_when_guard_expr(cs, guard_node)
    if gexpr != 0
      guard_handle = cst_lower_node(cs, gexpr, a)
    end
  end

  var fk = cst::cst_get_kind(cs, h)
  var body_ast = 0
  if fk == 84  # CST_FUNCTION_ENDLESS: body = expr; legacy wraps it as
    # `block { return expr }`. Mirror that so the AST shape matches.
    var expr_ast = 0
    if body != 0
      expr_ast = cst_lower_node(cs, body, a)
    end
    var ret = ast::ast_return(a, expr_ast, line, col)
    var stmts = vec_new()
    stmts.push(ret)
    body_ast = ast::ast_block(a, as_int(stmts), line, col)
  else  # CST_FUNCTION_BLOCK: lower the block, then apply the legacy implicit-
    # return rewrite (last NODE_EXPR_STMT → NODE_RETURN of its inner expr).
    if body != 0
      body_ast = cst_lower_node(cs, body, a)
      cl_apply_implicit_return(a, body_ast)
    end
  end

  var fnode = ast::ast_function(a, name, as_int(params), return_type, body_ast, is_private, type_params, type_param_bounds, line, col)
  if guard_handle >= 0
    ast::ast_func_set_guard(a, fnode, guard_handle)
  end
  # Def-header effect row (`can [Label, ...] [| tail]`): captured as flat token
  # leaves after the param list. Attach it to the fn node so the fingerprint's
  # `:can{...}` segment matches legacy. Effect-free defs carry no can leaf → the
  # helper is a no-op (no present flag), matching the absent-can-clause form.
  var can_scan_start = 0
  if plist_idx >= 0
    can_scan_start = plist_idx + 1
  end
  cl_attach_can_row(cs, h, can_scan_start, fnode, a)
  # SURF.2 effect-row variable from the where clause. A bare `Ident` (no colon)
  # in the where clause is the effect-row variable — equivalent to hoisting an
  # inline `can e`. It feeds the SAME can-row. An inline `can` AND a where
  # effect-var are mutually exclusive (parser.qz:6364): reject if both present.
  if where_evars.size > 0
    if cl_header_has_inline_can(cs, h, can_scan_start) == 1
      cl_reject("Effect row given both inline (`can`) and in `where` clause; use only one", line, col)
    else
      ast::ast_func_set_can_row(a, fnode, where_evars, "")
    end
  end
  return fnode
end

## Mirrors parser.qz's implicit-return rewrite: if the LAST statement of a
## function body block is a NODE_EXPR_STMT, replace it in place with a
## NODE_RETURN wrapping its inner expression (so a trailing bare expression
## becomes the function's return value). No-op for empty blocks or when the last
## statement is already a return / other statement.
def cl_apply_implicit_return(a: ast::AstStorage, body_block: Int): Void
  if body_block == 0
    return
  end
  if ast::ast_get_kind(a, body_block) != node_constants::NODE_BLOCK
    return
  end
  var stmts = ast::ast_get_children(a, body_block)
  if stmts == 0
    return
  end
  var n = stmts.size
  if n == 0
    return
  end
  var last_idx = n - 1
  var last_stmt = stmts[last_idx]
  if ast::ast_get_kind(a, last_stmt) == node_constants::NODE_EXPR_STMT
    var expr = ast::ast_get_left(a, last_stmt)
    var sl = ast::ast_get_line(a, last_stmt)
    var sc = ast::ast_get_col(a, last_stmt)
    var ret = ast::ast_return(a, expr, sl, sc)
    stmts[last_idx] = ret
  end
end

## Lambda-block implicit-return rewrite (parser.qz:2875-2893). UNLIKE the
## function-body rewrite (cl_apply_implicit_return), the trailing do/curly block
## lambda ALSO wraps a trailing NODE_IF / NODE_MATCH in a NODE_RETURN (the whole
## statement, not its inner expr). Reproduces parser.qz exactly: EXPR_STMT →
## unwrap inner + return; IF / MATCH → wrap the stmt in return; else leave. The
## return uses the LAST STATEMENT's own line/col.
def cl_apply_lambda_implicit_return(a: ast::AstStorage, body_block: Int): Void
  if body_block == 0
    return
  end
  if ast::ast_get_kind(a, body_block) != node_constants::NODE_BLOCK
    return
  end
  var stmts = ast::ast_get_children(a, body_block)
  if stmts == 0
    return
  end
  var n = stmts.size
  if n == 0
    return
  end
  var last_idx = n - 1
  var last_stmt = stmts[last_idx]
  var last_kind = ast::ast_get_kind(a, last_stmt)
  var sl = ast::ast_get_line(a, last_stmt)
  var sc = ast::ast_get_col(a, last_stmt)
  if last_kind == node_constants::NODE_EXPR_STMT
    var expr = ast::ast_get_left(a, last_stmt)
    var ret = ast::ast_return(a, expr, sl, sc)
    stmts[last_idx] = ret
  elsif last_kind == node_constants::NODE_IF
    var ret2 = ast::ast_return(a, last_stmt, sl, sc)
    stmts[last_idx] = ret2
  elsif last_kind == node_constants::NODE_MATCH
    var ret3 = ast::ast_return(a, last_stmt, sl, sc)
    stmts[last_idx] = ret3
  end
end

# ===========================================================================
# Trailing block-arg fold (R6.1) — `call(args) do -> body end` / `{ ... }`
# ===========================================================================
#
# Legacy `ps_parse_do_end_block_if_present` (parser.qz:2737-2901) absorbs a
# trailing `do…end` / `{…}` block onto a just-built call by constructing
# `ast_lambda(params, "", ast_block(stmts), …)` and PUSHING it as the call's
# LAST positional arg (`args.push(lambda)`, parser.qz:2898). There is no
# dedicated slot and no flag — the block lambda is simply the last element of the
# call's arg Vec (Swift trailing-closure representation). The CST captures the
# block losslessly: after `[callee, CST_ARG_LIST(119)]`, the call node carries
# `do`/`{` (TOKEN), header tokens, CST_BLOCK(43), `end`/`}` (TOKEN) directly as
# children (cst_parser.qz:1268-1296). This fold reproduces the legacy AST.

## True iff `lex` is the `do` or `{` trailing-block marker token lexeme.
def cl_is_block_marker(lex: String): Int
  if str_eq(lex, "do")
    return 1
  end
  if str_eq(lex, "{")
    return 1
  end
  return 0
end

## Parses the header TOKEN leaves between the `do`/`{` marker (at child index
## `marker_idx`) and the CST_BLOCK(43) body into a params Vec<Int>, mirroring
## parser.qz:2796-2853. `is_curly` selects the curly-only implicit-`it` rules.
## Header forms:
##   `->`                       → zero params (explicit nullary)
##   `x ->` / `x: T, y ->`      → one ast_param per ident
##   headerless curly `{ … }`   → synthesize a single implicit `it` param
##   `do <nl> it <operand> end` → synthesize `it` (operand-use only; excludes
##                                `it(` / `it.` / `it[` / `it ->` / `it,` / `it:`)
def cl_lower_do_header(cs: cst::CstStorage, h: Int, marker_idx: Int, is_curly: Int, dl: Int, dc: Int, a: ast::AstStorage): Vec
  var params = vec_new()
  var n = cst::cst_child_count(cs, h)
  # Collect the header TOKEN lexemes between the marker and the CST_BLOCK(43).
  var has_arrow = 0
  var hdr = vec_new<String>()
  var j = marker_idx + 1
  var stop = 0
  while j < n and stop == 0
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "->")
        has_arrow = 1
      end
      hdr.push(lex)
    else
      # First structured child after the marker = the CST_BLOCK body.
      stop = 1
    end
    j = j + 1
  end

  if has_arrow == 1
    # Explicit header. Walk `ident [: type tokens] [, ident …] ->`.
    var hn = hdr.size
    var i = 0
    while i < hn
      var tk = hdr[i]
      if str_eq(tk, "->")
        i = hn
      elsif str_eq(tk, ",")
        i = i + 1
      else
        # `tk` is a param name. Gather an optional `: <type tokens>`.
        var pname = tk
        var ptype = ""
        i = i + 1
        if i < hn and str_eq(hdr[i], ":")
          i = i + 1
          var ttoks = vec_new<String>()
          while i < hn and str_eq(hdr[i], ",") == 0 and str_eq(hdr[i], "->") == 0
            ttoks.push(hdr[i])
            i = i + 1
          end
          ptype = cl_render_type_from_tokens(ttoks)
        end
        var param = ast::ast_param(a, pname, ptype, 0, 0, dl, dc)
        params.push(param)
      end
    end
    return params
  end

  # No `->` header. Only the curly form synthesizes an implicit `it`; a do-block
  # without `->` falls to the implicit-it operand scan below.
  if is_curly == 1
    var it_p = ast::ast_param(a, "it", "", 0, 0, dl, dc)
    params.push(it_p)
    return params
  end

  # `do <newline> it <operand> end`: legacy treats `it` as an implicit param ONLY
  # when it is used as an OPERAND (parser.qz:2832-2853). That decision needs the
  # lowered body (the first statement's expr shape), which isn't available here.
  # It is applied by cl_maybe_inject_implicit_it AFTER the body is lowered, at
  # each do-block fold site. Leave params empty here.
  return params
end

## Post-lowering implicit-`it` injection for a headerless `do … end` block lambda.
## Mirrors parser.qz:2832-2853: when the block had no `->` header (params empty)
## and its FIRST statement uses `it` as an OPERAND, synthesize a single implicit
## `it` param. The legacy token-level exclusions (`it(` call, `it.` field/method,
## `it[` index — and the lambda-header forms `it ->`/`it,`/`it:`, impossible in a
## bodied expr) map onto the lowered first-stmt expr shape:
##   include: bare `it` ident, or any expr whose LEFTMOST operand bottoms out at
##            `it` (e.g. `it * 3`, `it % 2 == 0`, `it == 2`).
##   exclude: NODE_CALL on `it`, NODE_FIELD_ACCESS rooted at `it`, NODE_INDEX on `it`.
## `params` is mutated in place (the implicit `it` is appended) and returned.
def cl_maybe_inject_implicit_it(a: ast::AstStorage, params: Vec, body_block: Int, dl: Int, dc: Int): Vec
  if params.size != 0
    return params
  end
  if body_block == 0
    return params
  end
  if ast::ast_get_kind(a, body_block) != node_constants::NODE_BLOCK
    return params
  end
  var stmts = ast::ast_get_children(a, body_block)
  if stmts == 0
    return params
  end
  if stmts.size == 0
    return params
  end
  var first = stmts[0]
  # cl_apply_lambda_implicit_return may already have rewritten the last (here,
  # first) EXPR_STMT into a NODE_RETURN; unwrap either carrier to reach the expr.
  var fk = ast::ast_get_kind(a, first)
  var expr = 0
  if fk == node_constants::NODE_EXPR_STMT
    expr = ast::ast_get_left(a, first)
  elsif fk == node_constants::NODE_RETURN
    expr = ast::ast_get_left(a, first)
  else
    return params
  end
  if cl_expr_left_operand_is_it(a, expr) == 1
    var it_p = ast::ast_param(a, "it", "", 0, 0, dl, dc)
    params.push(it_p)
  end
  return params
end

## True iff `expr`'s LEFTMOST operand is the bare identifier `it`, applying the
## legacy operand-only exclusions: a CALL on `it`, a FIELD_ACCESS rooted at `it`,
## or an INDEX on `it` are NOT implicit-it (they consume `it` as receiver/callee).
def cl_expr_left_operand_is_it(a: ast::AstStorage, expr: Int): Int
  if expr == 0
    return 0
  end
  var k = ast::ast_get_kind(a, expr)
  if k == node_constants::NODE_IDENT
    if str_eq(ast::ast_get_str1(a, expr), "it") == 1
      return 1
    end
    return 0
  end
  # `it(...)` / `it.x` / `it.foo()` / `it[i]` — `it` is consumed as callee /
  # receiver / array, NOT as a bare operand. Exclude.
  if k == node_constants::NODE_CALL
    return 0
  end
  if k == node_constants::NODE_FIELD_ACCESS
    return 0
  end
  if k == node_constants::NODE_INDEX
    return 0
  end
  # Binary / unary expr: recurse on the leftmost operand (`it * 3`, `it % 2 == 0`).
  if k == node_constants::NODE_BINARY
    return cl_expr_left_operand_is_it(a, ast::ast_get_left(a, expr))
  end
  if k == node_constants::NODE_UNARY
    return cl_expr_left_operand_is_it(a, ast::ast_get_left(a, expr))
  end
  return 0
end

## Detects a trailing `do…end` / `{…}` block on a CALL / METHOD_CALL node `h`
## and, if present, folds the lowered block lambda onto `args` as its LAST
## element — reproducing parser.qz:2895-2898 (`args.push(lambda)`). No-op when no
## marker token is present. Curly and do forms share this path.
def cl_fold_trailing_block(cs: cst::CstStorage, h: Int, args: Vec, a: ast::AstStorage): Void
  var n = cst::cst_child_count(cs, h)
  # Find the `do`/`{` marker TOKEN child and its line/col.
  var marker_idx = 0 - 1
  var is_curly = 0
  var dl = 0
  var dc = 0
  var j = 0
  while j < n and marker_idx == 0 - 1
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if cl_is_block_marker(lex) == 1
        marker_idx = j
        dl = cst::cst_get_line(cs, c)
        dc = cst::cst_get_col(cs, c)
        if str_eq(lex, "{")
          is_curly = 1
        end
      end
    end
    j = j + 1
  end
  if marker_idx == 0 - 1
    return
  end

  # The body is the first structured CST_BLOCK(43) child AFTER the marker.
  var body_cst = 0
  var k = marker_idx + 1
  while k < n and body_cst == 0
    var c2 = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c2) == 0 and cst::cst_get_kind(cs, c2) == 43
      body_cst = c2
    end
    k = k + 1
  end
  if body_cst == 0
    return
  end

  var params = cl_lower_do_header(cs, h, marker_idx, is_curly, dl, dc, a)
  var body_block = cl_lower_block(cs, body_cst, a)
  cl_apply_lambda_implicit_return(a, body_block)
  # Headerless `do … end` (not curly) injects implicit `it` post-lowering when the
  # body's first stmt uses `it` as an operand (parser.qz:2832-2853).
  if is_curly == 0
    params = cl_maybe_inject_implicit_it(a, params, body_block, dl, dc)
  end
  var lambda = ast::ast_lambda(a, as_int(params), "", body_block, dl, dc)
  args.push(lambda)
end

## True (1) iff the trailing-block marker token on `h` is a curly `{` (vs. `do`).
## Mirrors the marker scan in cl_fold_trailing_block but reports the marker shape.
## Used to gate the `.with { ... }` binary-update form, which legacy accepts ONLY
## with a curly block (parser.qz:2933 `ps_check(TOK_LBRACE)`).
def cl_trailing_block_is_curly(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if cl_is_block_marker(lex) == 1
        return 1 if str_eq(lex, "{")
        return 0
      end
    end
    j = j + 1
  end
  return 0
end

## Collects the `field = expr` entries of a `.with { ... }` trailing curly block on
## `h` into a vec of NODE_ASSIGN nodes (str1=field_name, left=value) — exactly the
## children shape ast_binary_with expects and typecheck_walk reads (QZ0959). The
## block body is the first structured CST_BLOCK(43) child after the `{` marker;
## each statement is a CST_ASSIGN(49) `field = value`, lowered the same way the
## CST_ASSIGN case does (ast_assign by ident target). Mirrors legacy parser.qz's
## per-entry `ast_assign(wf_name, ps_parse_expr())` loop (parser.qz:2937-2955).
def cl_collect_with_entries(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Vec
  var entries = vec_new()
  var n = cst::cst_child_count(cs, h)
  # Find the curly marker, then the first CST_BLOCK(43) body after it.
  var marker_idx = 0 - 1
  var j = 0
  while j < n and marker_idx == 0 - 1
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and cl_is_block_marker(cst::cst_get_str1(cs, c)) == 1
      marker_idx = j
    end
    j = j + 1
  end
  return entries if marker_idx == 0 - 1
  var body = 0
  var k = marker_idx + 1
  while k < n and body == 0
    var c2 = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c2) == 0 and cst::cst_get_kind(cs, c2) == 43
      body = c2
    end
    k = k + 1
  end
  return entries if body == 0
  var bn = cst::cst_child_count(cs, body)
  var bi = 0
  while bi < bn
    var st = cst::cst_get_child(cs, body, bi)
    if cl_is_token(cs, st) == 0
      var sl = cst::cst_get_line(cs, st)
      var sc = cst::cst_get_col(cs, st)
      var fld = ""
      var val = 0
      var stk = cst::cst_get_kind(cs, st)
      # Each `field = value` entry parses at statement position as a
      # CST_CONST_BINDING(54) (`name = e`); a CST_ASSIGN(49) is also accepted
      # defensively. Both carry the field name as the lhs CST_IDENT and the value
      # as the RHS — pull both, mirroring the legacy per-entry
      # `ast_assign(wf_name, ps_parse_expr())` (parser.qz:2937-2955).
      if stk == 54 or stk == 49
        var lhs = cl_structured_child(cs, st, 0)
        if lhs != 0
          fld = cl_first_token_lexeme(cs, lhs)
        end
        # Value = first structured child after the lhs, skipping a CST_TYPE_REF(103)
        # type annotation if present (matches CST_CONST_BINDING value extraction).
        var sidx = 1
        var v = cl_structured_child(cs, st, sidx)
        while v != 0 and cst::cst_get_kind(cs, v) == 103
          sidx = sidx + 1
          v = cl_structured_child(cs, st, sidx)
        end
        if v != 0
          val = cst_lower_node(cs, v, a)
        end
      end
      entries.push(ast::ast_assign(a, fld, val, sl, sc))
    end
    bi = bi + 1
  end
  return entries
end

## True (1) iff any direct CST_TOKEN child of `h` has lexeme `lex`. Used to
## discriminate a set comprehension (carries a `for` token) from a plain set
## literal, both sharing CST_SET_LIT(30).
def cl_has_token_lexeme(cs: cst::CstStorage, h: Int, lex: String): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), lex) == 1
      return 1
    end
    j = j + 1
  end
  return 0
end

## Lowers the KEY of a CST_MAP_ENTRY(32). An `ident:` shorthand key is a bare
## ident TOKEN child (legacy converts to a string literal); every other key is a
## structured expr (symbol / string-lit / arbitrary expr). The entry's structured
## children are [key?, val] — when the key is a token, the sole structured child
## is the value, so we read the key from the FIRST token child preceding the
## separator. Mirrors parser.qz's `ident:`→ast_string_lit conversion.
def cl_lower_map_key(cs: cst::CstStorage, ent: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, ent)
  var col = cst::cst_get_col(cs, ent)
  # A structured first child IS the key expr (string-lit, symbol, expr). If the
  # first child is a TOKEN (the `ident:` shorthand), lower it to a string literal.
  var n = cst::cst_child_count(cs, ent)
  if n > 0
    var c0 = cst::cst_get_child(cs, ent, 0)
    if cl_is_token(cs, c0) == 1
      return ast::ast_string_lit(a, cst::cst_get_str1(cs, c0), line, col)
    end
    return cst_lower_node(cs, c0, a)
  end
  return ast::ast_int_lit(a, 0, line, col)
end

## Lowers the VALUE of a CST_MAP_ENTRY(32): the LAST structured child.
def cl_lower_map_val(cs: cst::CstStorage, ent: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, ent)
  var col = cst::cst_get_col(cs, ent)
  var n = cst::cst_child_count(cs, ent)
  var last_struct = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, ent, j)
    if cl_is_token(cs, c) == 0
      last_struct = c
    end
    j = j + 1
  end
  if last_struct != 0
    return cst_lower_node(cs, last_struct, a)
  end
  return ast::ast_int_lit(a, 0, line, col)
end

## Reads a comprehension tail `for VAR in ITER [step EXPR] [if COND]` from the
## structured/token children of `h` (a CST_SET_LIT-as-set-comp or CST_MAP_COMP).
## `iter_struct_idx` is the structured-child index of the iterable (set: elem=0 →
## iter=1; map: key=0, val=1 → iter=2). Returns a 4-slot result vec
## [var_name(String via intern), iterable-ast, step-ast(0 none), cond-ast(0 none)]
## — but since Quartz vecs are homogeneous Int here, we instead set out-params via
## the dedicated extractors below. To keep one code path, this returns the AST
## iterable and writes the rest through the helper's locals; callers re-extract.
def cl_comp_var_name(cs: cst::CstStorage, h: Int): String
  # The loop var is the FIRST ident TOKEN immediately after the `for` token.
  var n = cst::cst_child_count(cs, h)
  var saw_for = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if saw_for == 1
        return lex
      end
      if str_eq(lex, "for")
        saw_for = 1
      end
    end
    j = j + 1
  end
  return ""
end

## Lowers a set comprehension carried on CST_SET_LIT(30): children (source order)
## `{`, elem-expr, `for`, VAR, `in`, iter-expr, [`step`, step-expr], [`if`,
## cond-expr], `}`. Structured children: elem=0, iter=1, then optional step/cond
## exprs discriminated by their preceding `step`/`if` keyword token. Mirrors
## legacy ast_set_comp (+ int_val=step).
def cl_lower_set_comp(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var sc_elem = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var sc_iter = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
  var sc_var = cl_comp_var_name(cs, h)
  var sc_step = 0
  var sc_cond = 0
  var n = cst::cst_child_count(cs, h)
  var pending = 0  # 1=next struct child is step, 2=is cond
  # Gate `step` on having seen `in`: a loop var named `step` (`{ x for step in
  # 0..n }`) sits before `in` and would otherwise wrongly arm the step clause,
  # capturing the iterator as the step expr (see cl_lower_for null-iter defect).
  var seen_in = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "in")
        seen_in = 1
      elsif seen_in == 1 and str_eq(lex, "step")
        pending = 1
      elsif seen_in == 1 and str_eq(lex, "if")
        pending = 2
      end
    else
      if pending == 1
        sc_step = cst_lower_node(cs, c, a)
        pending = 0
      elsif pending == 2
        sc_cond = cst_lower_node(cs, c, a)
        pending = 0
      end
    end
    j = j + 1
  end
  var node = ast::ast_set_comp(a, sc_elem, sc_var, sc_iter, sc_cond, line, col)
  if sc_step > 0
    ast::ast_set_int_val(a, node, sc_step)
  end
  return node
end

## Lowers a map comprehension CST_MAP_COMP(38): children `{`, key-expr, `=>`,
## val-expr, `for`, VAR, `in`, iter-expr, [`step`, step-expr], [`if`, cond-expr],
## `}`. Structured children: key=0, val=1, iter=2, then optional step/cond.
## Mirrors legacy ast_map_comp (+ int_val=step).
def cl_lower_map_comp(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var mc_key = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var mc_val = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
  var mc_iter = cst_lower_node(cs, cl_structured_child(cs, h, 2), a)
  var mc_var = cl_comp_var_name(cs, h)
  var mc_step = 0
  var mc_cond = 0
  var n = cst::cst_child_count(cs, h)
  var pending = 0
  # Gate `step` on `in` (see cl_lower_for / cl_lower_set_comp): a var named `step`
  # sits before `in` and must not arm the step clause.
  var seen_in = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "in")
        seen_in = 1
      elsif seen_in == 1 and str_eq(lex, "step")
        pending = 1
      elsif seen_in == 1 and str_eq(lex, "if")
        pending = 2
      end
    else
      if pending == 1
        mc_step = cst_lower_node(cs, c, a)
        pending = 0
      elsif pending == 2
        mc_cond = cst_lower_node(cs, c, a)
        pending = 0
      end
    end
    j = j + 1
  end
  var node = ast::ast_map_comp(a, mc_key, mc_val, mc_var, mc_iter, mc_cond, line, col)
  if mc_step > 0
    ast::ast_set_int_val(a, node, mc_step)
  end
  return node
end

## Standalone arrow-lambda EXPRESSION (CST_LAMBDA_ARROW, kind 36), forms 1 & 3.
## Legacy `ps_parse_arrow_lambda` (parser.qz:2512) builds these as
## `ast_lambda(params, "", body, …)` where — for an EXPRESSION body (the non-`{`
## branch, parser.qz:2647) — the body is the bare expr (`ps_parse_expr` then
## `ps_store_node`), NOT wrapped in a block and NOT given implicit-return. So no
## `cl_apply_lambda_implicit_return` here. The body is always the LAST structured
## child of the kind-36 node. CST child layouts (cst_parser.qz:451-538):
##   Form 1  `-> body`          [arrow_TOK, body]            (1 structured child)
##   Form 3  `x -> body`        [pname_TOK, arrow_TOK, body] (1 structured child)
##   Form 3t `x: T -> body`     [pname, :, type(103), arrow, body] (2 structured)
##   Form 2  `(…) -> body`      [grp(17), arrow_TOK, body]   (2 structured, 1st=17)
## Form 2 (parenthesized params) is captured VERBATIM by cst_parser and needs a
## param structural pass — DEFERRED here: returns 0 so the dispatch falls back to
## the `__UNLOWERED_36` placeholder (no crash, no mis-lower).
## Parses Form-2 arrow-lambda params from a CST_PAREN(17) group captured VERBATIM
## by cps_capture_balanced_after_open. The group's children are the literal `(`,
## the param tokens, then the matching `)` (nested `(`/`[`/`{` are structured
## groups). Each param is `name [: type]`, comma-separated; an empty `()` yields
## zero params. Mirrors ps_parse_arrow_lambda (parser.qz:2522-2558): name = IDENT,
## type (if `:`) is the verbatim token run up to the top-level `,`/`)`, normalized
## by the same cl_render_type_from_tokens the rest of cst_lower uses. Depth-aware
## (generic `<>` AND paren `()`) so an Fn-type param doesn't split/close early.
def cl_lower_arrow_paren_params(cs: cst::CstStorage, grp: Int, a: ast::AstStorage, params: Vec, line: Int, col: Int): Void
  var n = cst::cst_child_count(cs, grp)
  var started = 0   # have we consumed the opening `(`?
  var fname = ""
  var seen_colon = 0
  var have_param = 0
  var type_toks = vec_new()
  var gdepth = 0
  var pdepth = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, grp, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if started == 0
        if str_eq(lex, "(")
          started = 1
        end
      else
        if str_eq(lex, ")") and gdepth == 0 and pdepth == 0
          if have_param == 1
            params.push(ast::ast_param(a, fname, cl_render_type_from_tokens(type_toks), 0, 0, line, col))
            have_param = 0
          end
          started = 0
        elsif str_eq(lex, ",") and gdepth == 0 and pdepth == 0
          if have_param == 1
            params.push(ast::ast_param(a, fname, cl_render_type_from_tokens(type_toks), 0, 0, line, col))
          end
          fname = ""
          seen_colon = 0
          type_toks = vec_new()
          have_param = 0
        elsif str_eq(lex, ":") and seen_colon == 0
          seen_colon = 1
        elsif seen_colon == 0
          fname = lex
          have_param = 1
        else
          if str_eq(lex, "<")
            gdepth = gdepth + 1
          elsif str_eq(lex, ">")
            gdepth = gdepth - 1
          elsif str_eq(lex, ">>")
            gdepth = gdepth - 2
          elsif str_eq(lex, "(")
            pdepth = pdepth + 1
          elsif str_eq(lex, ")")
            pdepth = pdepth - 1
          end
          type_toks.push(lex)
        end
      end
    else
      if started == 1 and seen_colon == 1
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
end

## Lowers the no-paren typed-param prefix of a CST_LAMBDA_ARROW
## (`name: Type [, name: Type ...] ->`) into AST params. Walks `h`'s children up
## to the `->` token, grouping each `name : type` into one param. Mirrors the
## token-walk of cl_lower_arrow_paren_params but bounded by `->` instead of `)`
## and with no opening `(` (parser.qz:2560-2590).
def cl_lower_arrow_bare_params(cs: cst::CstStorage, h: Int, a: ast::AstStorage, params: Vec, line: Int, col: Int): Void
  var n = cst::cst_child_count(cs, h)
  var fname = ""
  var seen_colon = 0
  var have_param = 0
  var type_toks = vec_new()
  var gdepth = 0
  var pdepth = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "->") and gdepth == 0 and pdepth == 0
        if have_param == 1
          params.push(ast::ast_param(a, fname, cl_render_type_from_tokens(type_toks), 0, 0, line, col))
          have_param = 0
        end
        return
      elsif str_eq(lex, ",") and gdepth == 0 and pdepth == 0
        if have_param == 1
          params.push(ast::ast_param(a, fname, cl_render_type_from_tokens(type_toks), 0, 0, line, col))
        end
        fname = ""
        seen_colon = 0
        type_toks = vec_new()
        have_param = 0
      elsif str_eq(lex, ":") and seen_colon == 0
        seen_colon = 1
      elsif seen_colon == 0
        fname = lex
        have_param = 1
      else
        if str_eq(lex, "<")
          gdepth = gdepth + 1
        elsif str_eq(lex, ">")
          gdepth = gdepth - 1
        elsif str_eq(lex, ">>")
          gdepth = gdepth - 2
        elsif str_eq(lex, "(")
          pdepth = pdepth + 1
        elsif str_eq(lex, ")")
          pdepth = pdepth - 1
        end
        type_toks.push(lex)
      end
    else
      if seen_colon == 1
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  # No `->` token found (defensive): flush any pending param.
  if have_param == 1
    params.push(ast::ast_param(a, fname, cl_render_type_from_tokens(type_toks), 0, 0, line, col))
  end
end

def cl_lower_arrow_lambda(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var sc = cl_structured_count(cs, h)
  if sc == 0
    return 0
  end
  # Body is the last structured child.
  var body_cst = cl_structured_child(cs, h, sc - 1)
  var first_struct = cl_structured_child(cs, h, 0)
  var params = vec_new()
  if sc == 1
    # Form 1 (`-> body`) or Form 3 bare (`x -> body`). Discriminate by whether a
    # non-`->` token precedes the body: form 3 carries a param-name ident token,
    # form 1 carries only the `->` token.
    var pname = ""
    var n = cst::cst_child_count(cs, h)
    var j = 0
    while j < n
      var c = cst::cst_get_child(cs, h, j)
      if cl_is_token(cs, c) == 1
        var lex = cst::cst_get_str1(cs, c)
        if str_eq(lex, "->") == 0 and str_eq(pname, "") == 1
          pname = lex
        end
      end
      j = j + 1
    end
    if str_eq(pname, "") == 0
      var p1 = ast::ast_param(a, pname, "", 0, 0, line, col)
      params.push(p1)
    end
  else
    # sc == 2: Form 2 (parenthesized params, first structured child = CST_PAREN
    # 17) → DEFER; or Form 3 typed (`x: T -> body`, first structured child =
    # CST_TYPE_REF 103, param name = first token, type = rendered type node).
    if cst::cst_get_kind(cs, first_struct) == 17
      cl_lower_arrow_paren_params(cs, first_struct, a, params, line, col)
      var pbody = cst_lower_node(cs, body_cst, a)
      if cst::cst_get_kind(cs, body_cst) == 43
        cl_apply_lambda_implicit_return(a, pbody)
      end
      return ast::ast_lambda(a, as_int(params), "", pbody, line, col)
    end
    # No-paren typed form `name: Type [, name: Type ...] -> body`. parser.qz
    # collects EVERY `, name: type` pair into one param list (parser.qz:2573-2587),
    # so walk the lambda's children up to the `->` token, building one param per
    # `name : type` group. Single-param is just the degenerate one-group case.
    cl_lower_arrow_bare_params(cs, h, a, params, line, col)
  end
  # A `{ … }` body (now a CST_BLOCK(43)) lowers to a NODE_BLOCK and takes the
  # lambda implicit-return rewrite (last EXPR_STMT/IF/MATCH → NODE_RETURN), exactly
  # as legacy ps_parse_arrow_lambda (parser.qz:2611-2631). A non-`{` body stays a
  # bare expression with no return (the unchanged path).
  var body = cst_lower_node(cs, body_cst, a)
  if cst::cst_get_kind(cs, body_cst) == 43
    cl_apply_lambda_implicit_return(a, body)
  end
  return ast::ast_lambda(a, as_int(params), "", body, line, col)
end

## Lowers a `do … end` block carried directly by `h` (the `do` marker token +
## CST_BLOCK(43) body are children of `h`) to a NODE_LAMBDA. `apply_return`
## controls implicit-return on the last statement: the standalone-do-block path
## (parser.qz:2683-2698) applies it, but the statement-level `go do` path
## (ps_parse_go, parser.qz:4575-4583) builds the body block raw with NO implicit
## return. Returns the lambda handle (0 if no block found).
def cl_lower_carrier_do_lambda(cs: cst::CstStorage, h: Int, apply_return: Int, a: ast::AstStorage): Int
  var n = cst::cst_child_count(cs, h)
  var marker_idx = 0 - 1
  var dl = 0
  var dc = 0
  var j = 0
  while j < n and marker_idx == 0 - 1
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and cl_is_block_marker(cst::cst_get_str1(cs, c)) == 1
      marker_idx = j
      dl = cst::cst_get_line(cs, c)
      dc = cst::cst_get_col(cs, c)
    end
    j = j + 1
  end
  if marker_idx == 0 - 1
    return 0
  end
  var body_cst = 0
  var k = marker_idx + 1
  while k < n and body_cst == 0
    var c2 = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c2) == 0 and cst::cst_get_kind(cs, c2) == 43
      body_cst = c2
    end
    k = k + 1
  end
  if body_cst == 0
    return 0
  end
  var params = cl_lower_do_header(cs, h, marker_idx, 0, dl, dc, a)
  var body_block = cl_lower_block(cs, body_cst, a)
  if apply_return == 1
    cl_apply_lambda_implicit_return(a, body_block)
    # The standalone do-end-block path (parser.qz:2683 via ps_parse_do_end_block_
    # if_present) runs the implicit-`it` operand scan; the raw `go do` path
    # (apply_return == 0) does not. Mirror that gating.
    params = cl_maybe_inject_implicit_it(a, params, body_block, dl, dc)
  end
  return ast::ast_lambda(a, as_int(params), "", body_block, dl, dc)
end

## Lowers a `go`/`async`/`await` carrier shape to its AST node. Shared by the
## RHS-position carrier (CST_AWAIT 42, e.g. `var h = go f()`) and the bare
## statement carrier (CST_EXPR_STMT 44, e.g. `go f()`), which carry identical
## children: `[kw, operand]` OR (go/async only) `[kw, do, <header>, CST_BLOCK(43),
## end]`. `first` is the keyword lexeme; `at_stmt` = 1 when the carrier is a bare
## statement (kind 44), 0 when in RHS/expression position (kind 42). The flag only
## affects do-block implicit-return (statement `go do` uses ps_parse_go, which
## does NOT apply implicit return; every other path goes through a standalone
## block, which does).
##   await e          → ast_await                      (legacy parser.qz:1393)
##   async e          → ast_async_call                 (legacy parser.qz:1372)
##   go e             → ast_go_call (lambda operand → wrapped in zero-arg call)
##                                                      (legacy parser.qz:1385)
##   go do…end        → go(ast_call(lambda([],"",body), []))  (parser.qz:4581)
##   async do…end     → async(lambda([],"",body))             (parser.qz:1372)
def cl_lower_go_async_carrier(cs: cst::CstStorage, h: Int, first: String, at_stmt: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  if str_eq(first, "await")
    var aw_handle = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    return ast::ast_await(a, aw_handle, line, col)
  end
  # Block form `go do … end` / `async do … end`: the carrier node itself holds
  # the `do` marker + CST_BLOCK(43) body. The do-block lowers to a zero-param
  # lambda. `go` wraps the lambda in a zero-arg call (ps_parse_go forces
  # `go (lambda)()`, parser.qz:4581-4586; the RHS NODE_LAMBDA check does the same,
  # parser.qz:1386). `async` does NOT wrap (parser.qz:1372/4560 leave the lambda
  # bare → `async (lambda)`). Implicit-return on the lambda body is suppressed
  # only for statement-level `go` (ps_parse_go builds the body raw).
  var has_block = 0
  var bj = 0
  var bn = cst::cst_child_count(cs, h)
  while bj < bn
    var bc = cst::cst_get_child(cs, h, bj)
    if cl_is_token(cs, bc) == 0 and cst::cst_get_kind(cs, bc) == 43
      has_block = 1
    end
    bj = bj + 1
  end
  if has_block == 1
    var apply_return = 1
    if at_stmt == 1 and str_eq(first, "go")
      apply_return = 0
    end
    var lam = cl_lower_carrier_do_lambda(cs, h, apply_return, a)
    if str_eq(first, "async")
      return ast::ast_async_call(a, lam, line, col)
    end
    var inner_call = ast::ast_call(a, lam, as_int(vec_new()), line, col)
    return ast::ast_go_call(a, inner_call, line, col)
  end
  # Operand form `go e` / `async e`. The operand is the sole structured child.
  # For `go` only, a bare lambda operand is auto-wrapped in a zero-arg call so
  # downstream sees `go (lambda)()` (parser.qz:1386). `async` does NOT wrap
  # (parser.qz:1372 has no lambda check).
  var operand = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  if str_eq(first, "async")
    return ast::ast_async_call(a, operand, line, col)
  end
  if ast::ast_get_kind(a, operand) == 19  # NODE_LAMBDA
    operand = ast::ast_call(a, operand, as_int(vec_new()), line, col)
  end
  return ast::ast_go_call(a, operand, line, col)
end

# ===========================================================================
# Call lowering
# ===========================================================================

## Lowers a CST_ARG_LIST (kind 119) to a Vec<Int> of lowered argument exprs.
## Structured children are the args (token leaves = parens/commas are skipped).
## A named-argument carrier CST_FIELD_INIT (28, `name: value`) is unwrapped to
## its VALUE expr here (legacy stores positional/named args uniformly in the
## args vec; the name list rides the call node's `op` slot — see `cl_arg_names`).
def cl_lower_arg_list(cs: cst::CstStorage, alist: Int, a: ast::AstStorage): Vec
  var args = vec_new()
  if alist == 0
    return args
  end
  var cnt = cst::cst_child_count(cs, alist)
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, alist, j)
    if cl_is_token(cs, c) == 0
      if cst::cst_get_kind(cs, c) == 28  # CST_FIELD_INIT: [name_tok, colon_tok, value_node]
        args.push(cst_lower_node(cs, cl_structured_child(cs, c, 0), a))
      else
        args.push(cst_lower_node(cs, c, a))
      end
    end
    j = j + 1
  end
  return args
end

## Builds the call-site arg-name list parallel to `cl_lower_arg_list`'s args:
## one entry per positional/named arg — `""` for positional, the interned name
## lexeme for a CST_FIELD_INIT named arg. Returns 0 if NO arg is named (legacy
## leaves the call's `op` slot at 0 in that case — parser.qz:3326-3367 only calls
## `ast_call_set_arg_names` when `has_named`). Otherwise returns a Vec<String>
## (as Int) suitable for `ast_call_set_arg_names`. Mirrors parser.qz exactly:
## the typed-arrow-lambda exclusion was already applied by cps_parse_call_arg,
## so any CST_FIELD_INIT child here IS a genuine named arg.
def cl_arg_names(cs: cst::CstStorage, alist: Int): Int
  if alist == 0
    return 0
  end
  var names = vec_new<String>()
  var has_named = 0
  var cnt = cst::cst_child_count(cs, alist)
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, alist, j)
    if cl_is_token(cs, c) == 0
      if cst::cst_get_kind(cs, c) == 28  # CST_FIELD_INIT: first token leaf = arg name
        names.push(cl_intern_lex(cl_first_token_lexeme(cs, c)))
        has_named = 1
      else
        names.push("")
      end
    end
    j = j + 1
  end
  if has_named == 0
    return 0
  end
  return as_int(names)
end

# ===========================================================================
# Import lowering (CST_IMPORT 111, optionally wrapped in CST_VISIBILITY 102)
# ===========================================================================

## Interns `lex` into the SHARED global interner and resolves it back to the
## canonical String object, so `as_int(.)` of it matches the value parser.qz
## obtains from `ps_lexeme_at` (which also resolves through the global interner).
## This is the load-bearing identity for symbol/alias Vec<Int> equivalence: the
## fingerprinter emits those raw, and a raw-pointer match only holds when both
## paths produce the SAME interned String object for the same content.
def cl_intern_lex(lex: String): String
  var g = string_intern::intern_global()
  var id = string_intern::intern_id(g, lex)
  return string_intern::intern_resolve_int(g, id)
end

# ===========================================================================
# Import-alias table (Increment C) — module-alias drop in `alias::Type::Variant`
# ===========================================================================
#
# Legacy `parser.qz` records every `import X [as Y]` module-alias into the
# parser-state field `import_aliases: Vec<String>` (parser.qz:94):
#   - `import a/b as c`  → pushes the alias lexeme `c`        (parser.qz:7734)
#   - bare `import a/b`  → pushes the path BASENAME `b`        (parser.qz:7744)
# `from m import T as U` renames DO NOT feed this table (they go to the AST
# extras slot for selective re-export, parser.qz:7810) — so this table is
# module-aliases ONLY. `import * from m` / `from m import *` add nothing.
#
# Consumption (parser.qz:2026-2040): inside a `name::...` ident-path, the alias
# is DROPPED iff ALL of: (1) `name` is in the alias set, (2) the segment after
# the first `::` is uppercase (a Type), (3) there is a further `::` after it
# (the 3-segment `alias::Type::Variant` shape). On a drop, the alias falls away
# and the path resolves as `Type::Variant` → NODE_ENUM_ACCESS(name="Type",
# variant="Variant"). Any other shape (2-seg, lowercase 2nd seg, no 3rd `::`)
# keeps the `$`-mangled form. We replicate exactly that.
#
# The table is whole-program and read-only during lowering: a flat,
# insertion-ordered Vec<String> built once at the CST_PROGRAM root and consulted
# by the path-lowering arms. (Determinism: insertion-ordered flat Vec, no map.)

var _cl_import_aliases = vec_new<String>()

# Cross-compilation target triple for `@cfg(os:/arch:/...)` evaluation. Mirrors
# legacy `ParserState.target` (parser.qz:69) — set by the driver before lowering
# so `cl_cfg_decorator_skips` resolves os/arch against the `--target` flag rather
# than the host (empty = host). Without this, a `@cfg(os:"windows")` decl was
# wrongly DROPPED under a windows cross-target (intrinsic_extern_arity G-fix).
var _cl_cfg_target = ""

## Sets the cross-compile target for cfg evaluation. Call before cst_lower.
def cl_set_cfg_target(target: String): Void
  _cl_cfg_target = target
end

## True iff `name` is a registered module-import alias for the current program.
def cl_is_import_alias(name: String): Int
  var i = 0
  while i < _cl_import_aliases.size
    if str_eq(_cl_import_aliases[i], name)
      return 1
    end
    i = i + 1
  end
  return 0
end

## Push the module-alias contributed by ONE CST_IMPORT (kind 111) token run, if
## any. Mirrors parser.qz's `import_aliases.push` sites: `import a/b as c` pushes
## `c`; bare `import a/b` pushes the basename `b`. `import * from m` and the
## `from m import ...` forms contribute NOTHING (handled by returning early).
def cl_collect_one_import_alias(cs: cst::CstStorage, h: Int): Void
  var cnt = cst::cst_child_count(cs, h)
  var toks = vec_new<String>()
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      toks.push(cst::cst_get_str1(cs, c))
    end
    j = j + 1
  end
  var nt = toks.size
  if nt == 0
    return
  end
  # `from ...` selective/wildcard imports contribute no module-alias.
  if str_eq(toks[0], "from")
    return
  end
  var ti = 1
  # `import * from m` — wildcard, no module-alias.
  if ti < nt and str_eq(toks[ti], "*")
    return
  end
  # `import a/b [as c]` — walk the slash path to its basename, then check `as`.
  var basename = ""
  if ti < nt
    basename = toks[ti]
    ti = ti + 1
  end
  while ti + 1 < nt and str_eq(toks[ti], "/")
    basename = toks[ti + 1]
    ti = ti + 2
  end
  if ti + 1 < nt and str_eq(toks[ti], "as")
    # `import a/b as c` → alias is `c`.
    _cl_import_aliases.push(toks[ti + 1])
  else
    # bare `import a/b` → implicit alias is the path basename.
    _cl_import_aliases.push(basename)
  end
end

## Reset and rebuild the whole-program alias table from a CST_PROGRAM root's
## direct children. CST_IMPORT (111) may be wrapped in CST_VISIBILITY (102:
## `pub import ...`); unwrap one level. Insertion-ordered (program order).
def cl_collect_import_aliases(cs: cst::CstStorage, root: Int): Void
  _cl_import_aliases = vec_new<String>()
  var cnt = cst::cst_child_count(cs, root)
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, root, j)
    var ck = cst::cst_get_kind(cs, c)
    if ck == 111
      cl_collect_one_import_alias(cs, c)
    end
    if ck == 102  # CST_VISIBILITY wrapper — unwrap one structured level
      var inner = cl_structured_child(cs, c, 0)
      if inner != 0 and cst::cst_get_kind(cs, inner) == 111
        cl_collect_one_import_alias(cs, inner)
      end
    end
    j = j + 1
  end
end

## Lowers a CST_IMPORT (kind 111) — a flat verbatim token run — to ast_import,
## reproducing parser.qz's four surface forms:
##   import a/b            → module="a/b", alias="",  symbols=0, wildcard=0
##   import a/b as c       → module="a/b", alias="c", symbols=0, wildcard=0
##   import * from m       → module="m",   alias="",  symbols=0, wildcard=1
##   from m import x, y     → module="m",   symbols=[x,y], aliases=[x,y]
##   from m import a as b   → module="m",   symbols=[a], aliases=[b]
## `is_pub` is applied by the caller (CST_VISIBILITY wrapper). Module-name path
## normalization joins `seg/seg` exactly as parser.qz (`#{path}/` + `#{seg}`).
def cl_lower_import(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var cnt = cst::cst_child_count(cs, h)

  # Collect the verbatim token lexemes in order (every child is a CST_TOKEN).
  var toks = vec_new()
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      toks.push(cst::cst_get_str1(cs, c))
    end
    j = j + 1
  end
  var nt = toks.size
  if nt == 0
    return ast::ast_import(a, "", "", 0, 0, line, col)
  end

  # Hallucination hint (#6): `::` is not a Quartz import-path separator — Rust/Swift
  # users reach for `import a::b`, but Quartz uses `/` (`import a/b`). Detect a `::`
  # token anywhere in the import run and reject with an actionable hint instead of
  # the misleading downstream "cannot find module: a". Gate-1-inert: no import in
  # self-hosted/*.qz uses `::` (all use `/`), so this branch never fires on the
  # self-compile set.
  var dci = 0
  while dci < nt
    if str_eq(toks[dci], "::")
      cl_reject("import paths use '/' not '::' (e.g. `import a/b`)", line, col)
      return ast::ast_import(a, "", "", 0, 0, line, col)
    end
    dci = dci + 1
  end

  var kw = toks[0]  # "import" or "from"

  if str_eq(kw, "from")
    # from <module-path> import <symbols | *>
    var ti = 1
    var module_name = ""
    if ti < nt
      module_name = toks[ti]
      ti = ti + 1
    end
    # hierarchical path: from foo/bar import ...
    while ti + 1 < nt and str_eq(toks[ti], "/")
      module_name = "#{module_name}/"
      module_name = "#{module_name}#{toks[ti + 1]}"
      ti = ti + 2
    end
    # skip the `import` keyword
    if ti < nt and str_eq(toks[ti], "import")
      ti = ti + 1
    end
    # wildcard?
    if ti < nt and str_eq(toks[ti], "*")
      return ast::ast_import(a, module_name, "", 0, 1, line, col)
    end
    # selective: symbol list with optional `as` renames.
    var symbols = vec_new()
    var aliases = vec_new()
    while ti < nt
      var nm = toks[ti]
      ti = ti + 1
      symbols.push(as_int(cl_intern_lex(nm)))
      if ti < nt and str_eq(toks[ti], "as")
        ti = ti + 1
        if ti < nt
          aliases.push(as_int(cl_intern_lex(toks[ti])))
          ti = ti + 1
        else
          aliases.push(as_int(cl_intern_lex(nm)))
        end
      else
        aliases.push(as_int(cl_intern_lex(nm)))
      end
      # skip a separating comma
      if ti < nt and str_eq(toks[ti], ",")
        ti = ti + 1
      end
    end
    var imp = ast::ast_import(a, module_name, "", as_int(symbols), 0, line, col)
    ast::ast_import_set_aliases(a, imp, as_int(aliases))
    return imp
  end

  # `import ...`
  var ti = 1
  # import * from m
  if ti < nt and str_eq(toks[ti], "*")
    ti = ti + 1
    var module_name = ""
    if ti < nt and str_eq(toks[ti], "from")
      ti = ti + 1
    end
    if ti < nt
      module_name = toks[ti]
      ti = ti + 1
    end
    while ti + 1 < nt and str_eq(toks[ti], "/")
      module_name = "#{module_name}/"
      module_name = "#{module_name}#{toks[ti + 1]}"
      ti = ti + 2
    end
    return ast::ast_import(a, module_name, "", 0, 1, line, col)
  end

  # import a/b [as c]
  var path = ""
  if ti < nt
    path = toks[ti]
    ti = ti + 1
  end
  while ti + 1 < nt and str_eq(toks[ti], "/")
    path = "#{path}/"
    path = "#{path}#{toks[ti + 1]}"
    ti = ti + 2
  end
  var alias = ""
  if ti + 1 < nt and str_eq(toks[ti], "as")
    alias = toks[ti + 1]
    ti = ti + 2
  end
  return ast::ast_import(a, path, alias, 0, 0, line, col)
end

# ===========================================================================
# Method-call lowering (CST_METHOD_CALL 22)
# ===========================================================================

## Lowers a CST_METHOD_CALL (`recv.m(args)` / `recv?.m(args)` / `recv$func(args)`)
## to the ast_call shape parser.qz produces (parser.qz:2958-3006):
##   - method name = the token after `.`/`?.`/`$`.
##   - If the receiver is a bare ident whose first byte is A..Z (a Type), this is
##     an ASSOCIATED-FUNCTION call: callee = ident("Type$method"), the receiver
##     is NOT prepended to args, and is_ufcs is NOT set.
##   - Otherwise UFCS: callee = ident(method), args = [recv] ++ actual_args, and
##     is_ufcs = 1.
## KNOWN GAP: named args inside method calls, and trailing do/brace block lambdas
## attached to a method call, are not modeled (defer — rare in this position).
def cl_lower_method_call(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)

  # Structured children: [recv, (arg_list)?]. recv is structured child 0.
  var recv_node = cl_structured_child(cs, h, 0)
  var recv_ast = cst_lower_node(cs, recv_node, a)

  # Method name = the token leaf that is not `.`/`?.`/`$` (the segment after the
  # accessor). It is the LAST non-accessor token leaf before the arg list.
  var method = ""
  var cnt = cst::cst_child_count(cs, h)
  var j = 0
  var mc_stop = 0
  while j < cnt and mc_stop == 0
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      # A trailing `do`/`{` block marker (R6.1) ends the method-name region —
      # its header/body/`end` tokens are NOT part of the method name.
      if cl_is_block_marker(lex) == 1
        mc_stop = 1
      elsif str_eq(lex, ".") == 0 and str_eq(lex, "?.") == 0 and str_eq(lex, "$") == 0
        method = lex
      end
    end
    j = j + 1
  end

  var alist = cl_child_of_kind(cs, h, 119)  # CST_ARG_LIST (absent for `recv$f`)
  var actual_args = cl_lower_arg_list(cs, alist, a)

  # Associated-function detection: receiver is a bare CST_IDENT starting A..Z.
  var is_assoc = 0
  if recv_node != 0 and cst::cst_get_kind(cs, recv_node) == 15
    var rname = cl_first_token_lexeme(cs, recv_node)
    var fc = str_byte_at(rname, 0)
    if fc >= 'A' and fc <= 'Z'
      is_assoc = 1
    end
  end

  var args = vec_new()
  var callee_name = method
  if is_assoc == 1
    var rname2 = cl_first_token_lexeme(cs, recv_node)
    callee_name = "#{rname2}$#{method}"
  else
    args.push(recv_ast)
  end
  var na = actual_args.size
  var ai = 0
  while ai < na
    args.push(actual_args[ai])
    ai = ai + 1
  end

  # R6.1: fold a trailing `do…end` / `{…}` block as the last positional arg
  # (`xs.each do x -> … end`, `obj.method { … }`). parser.qz:2895-2898.
  cl_fold_trailing_block(cs, h, args, a)

  var callee = ast::ast_ident(a, callee_name, line, col)
  var call = ast::ast_call(a, callee, as_int(args), line, col)
  if is_assoc == 0
    ast::ast_call_set_is_ufcs(a, call, 1)
  end
  return call
end

# ===========================================================================
# Struct-init lowering (CST_STRUCT_INIT 26)
# ===========================================================================

## Reconstructs the generic struct-init `type_args` string from a CST_TYPE_ARG_LIST
## (kind 105) whose token children are `[inner_recv, <, arg_toks…, >]`. Mirrors
## parser.qz:2140-2180 EXACTLY: outer `<`/`>` are delimiters (dropped); a comma
## becomes ", "; a `>>` that closes the run contributes one inner ">"; all other
## tokens are concatenated with no separator. `GSPair<Int, String>` → "Int, String";
## `Box<Vec<Int>>` → "Vec<Int>".
def cl_render_struct_type_args(cs: cst::CstStorage, tal: Int): String
  var out = ""
  var depth = 0
  var started = 0
  var n = cst::cst_child_count(cs, tal)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, tal, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "<")
        depth = depth + 1
        if started == 0
          # The outer opening `<` — a delimiter, dropped.
          started = 1
        else
          out = "#{out}<"
        end
      elsif str_eq(lex, ">")
        depth = depth - 1
        if depth > 0
          out = "#{out}>"
        end
      elsif str_eq(lex, ">>")
        depth = depth - 2
        # The `>>` closes two levels; the inner `>` is contributed when it leaves
        # a still-open level (parser.qz adds one ">" on the closing `>>`).
        if depth >= 0
          out = "#{out}>"
        end
      elsif str_eq(lex, ",")
        out = "#{out}, "
      else
        out = "#{out}#{lex}"
      end
    end
    j = j + 1
  end
  return out
end

## Drops a leading `alias ::` module-alias prefix from one turbofish type-arg's
## token list, mirroring parser.qz's `ps_tf_drop_alias_prefix` (parser.qz:632-668)
## which legacy applies BEFORE each top-level ps_parse_type in a turbofish list.
## Drops iff ALL of: arg_toks[0] is an IDENT that is lowercase/`_`-led (only
## modules/aliases qualify), arg_toks[1] is `::`, AND arg_toks[0] is a registered
## import alias. On a hit, `mir::MirFunc` → renders bare `MirFunc`. This is LOCAL
## to the turbofish renderer — plain annotations keep the `$`-join (parser.qz:803).
def cl_tf_strip_alias_prefix(arg_toks: Vec): Vec
  if arg_toks.size < 2
    return arg_toks
  end
  var head = arg_toks[0]
  if str_eq(arg_toks[1], "::") == 0
    return arg_toks
  end
  # Only lowercase/`_`-led idents can be module/alias qualifiers.
  var fc = str_byte_at(head, 0)
  var is_lower = 0
  if fc >= 'a' and fc <= 'z'
    is_lower = 1
  end
  if fc == '_'
    is_lower = 1
  end
  if is_lower == 0
    return arg_toks
  end
  # Is `head` a registered import alias? Scan the table directly with str_eq
  # (the untyped-Vec element can't be passed to the String-typed
  # cl_is_import_alias without tripping the existential-erasure guard).
  var is_alias = 0
  var ai = 0
  while ai < _cl_import_aliases.size
    if str_eq(_cl_import_aliases[ai], head) == 1
      is_alias = 1
      break
    end
    ai = ai + 1
  end
  if is_alias == 0
    return arg_toks
  end
  # Hit: drop the leading `alias ::` pair.
  var stripped = vec_new()
  var k = 2
  while k < arg_toks.size
    stripped.push(arg_toks[k])
    k = k + 1
  end
  return stripped
end

## Renders the type-arg STRING for a turbofish CALL (`name<T, U>(...)`) from a
## CST_TYPE_ARG_LIST (105) node, matching parser.qz:3238-3308's `type_arg`
## (comma-joined per-arg ps_parse_type). Unlike cl_render_struct_type_args, CALL
## turbofish applies the full ps_parse_type normalization (`::`→`$`, trailing
## `?`→Option, `&`/`&mut` prefixes) per top-level argument via
## cl_render_type_from_tokens. The 105 children are `[receiver, <, toks..., >]`
## where the outer `<` and closing `>`/`>>` delimit the list; a top-level comma
## (depth 1) splits arguments. A `>>` that closes the OUTER level also closes one
## INNER nested generic — we contribute that inner `>` as a token to the current
## arg before terminating (parser.qz adds one `>` on the closing `>>`).
def cl_render_call_type_args(cs: cst::CstStorage, tal: Int): String
  var out = ""
  var depth_lvl = 0
  var started = 0
  var first_arg = 1
  var arg_toks = vec_new()
  var n = cst::cst_child_count(cs, tal)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, tal, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "<")
        depth_lvl = depth_lvl + 1
        if started == 0
          # Outer opening `<` — a delimiter, dropped.
          started = 1
        else
          arg_toks.push("<")
        end
      elsif str_eq(lex, ">")
        depth_lvl = depth_lvl - 1
        if depth_lvl > 0
          arg_toks.push(">")
        end
      elsif str_eq(lex, ">>")
        depth_lvl = depth_lvl - 2
        # `>>` closes TWO levels: one inner generic (whose `>` must render) plus
        # one outer level. When the OUTER level was the delimiter (depth lands at
        # 0) the inner `>` is still contributed; only a `>>` that drops BELOW 0
        # would have no inner level to close (impossible for balanced input).
        if depth_lvl >= 0
          arg_toks.push(">")
        end
      elsif str_eq(lex, ",") and depth_lvl == 1
        # Top-level argument separator: flush the accumulated arg.
        if first_arg == 0
          out = "#{out}, "
        end
        out = "#{out}#{cl_render_type_from_tokens(cl_tf_strip_alias_prefix(arg_toks))}"
        first_arg = 0
        arg_toks = vec_new()
      else
        arg_toks.push(lex)
      end
    end
    j = j + 1
  end
  # Flush the final argument (if any tokens were collected).
  if arg_toks.size > 0
    if first_arg == 0
      out = "#{out}, "
    end
    out = "#{out}#{cl_render_type_from_tokens(cl_tf_strip_alias_prefix(arg_toks))}"
  end
  return out
end

## Lowers a CST_STRUCT_INIT (kind 26) to parser.qz's ast_struct_init /
## ast_struct_init_generic (parser.qz:2264-2331, 2182-2256). Structured children:
## `[receiver, CST_FIELD_LIST]` — the receiver is a CST_IDENT (plain) or a
## CST_TYPE_ARG_LIST wrapping `ident<Args>` (generic). The field list holds
## CST_FIELD_INIT (28) `name: value` entries (parallel field_names + value vecs)
## and at most one CST_STRUCT_SPREAD (27) `...base` set into the node's `left`.

## Struct-init type name from a receiver node: a plain CST_IDENT yields its
## lexeme, a qualified CST_PATH (`mod::Type`) yields the legacy `$`-joined
## `mod$Type` (parser.qz:3045 `qualified_name`). A bare `cl_first_token_lexeme`
## on a CST_PATH returns the `::` separator token, so path receivers must route
## through cl_path_joined_name.
def cl_struct_init_name(cs: cst::CstStorage, recv: Int): String
  if recv != 0 and cst::cst_get_kind(cs, recv) == 16  # CST_PATH → $-joined name
    return cl_path_joined_name(cs, recv)
  end
  return cl_first_token_lexeme(cs, recv)
end

def cl_lower_struct_init(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)

  var recv = cl_structured_child(cs, h, 0)
  var name = ""
  var type_args = ""
  var is_generic = 0
  if recv != 0 and cst::cst_get_kind(cs, recv) == 105  # CST_TYPE_ARG_LIST → generic
    is_generic = 1
    var inner = cl_structured_child(cs, recv, 0)
    name = cl_struct_init_name(cs, inner)
    type_args = cl_render_struct_type_args(cs, recv)
  else
    name = cl_struct_init_name(cs, recv)
  end

  var flist = cl_child_of_kind(cs, h, 121)  # CST_FIELD_LIST
  var field_names = vec_new()
  var values = vec_new()
  var spread_base = 0
  if flist != 0
    var n = cst::cst_child_count(cs, flist)
    var j = 0
    while j < n
      var c = cst::cst_get_child(cs, flist, j)
      var ck = cst::cst_get_kind(cs, c)
      if ck == 28  # CST_FIELD_INIT: [name_tok, colon_tok, value_node]
        var vnode = cl_structured_child(cs, c, 0)
        # A value-less field (`Type { x, y }` destructure-shorthand) is not a
        # struct-init field — skip it (such files are struct-DESTRUCTUREs handled
        # by a different arm; keeping field_names/values parallel here is moot).
        if vnode != 0
          field_names.push(as_int(cl_intern_lex(cl_first_token_lexeme(cs, c))))
          values.push(cst_lower_node(cs, vnode, a))
        end
      elsif ck == 27  # CST_STRUCT_SPREAD: [..., inner_expr]
        # At most one `...base` is legal (legacy parser.qz:2199/2279/3062).
        if spread_base != 0
          cl_reject("Multiple spreads in struct literal — at most one '...base' allowed", cst::cst_get_line(cs, c), cst::cst_get_col(cs, c))
        end
        var sinner = cl_structured_child(cs, c, 0)
        spread_base = cst_lower_node(cs, sinner, a)
      end
      j = j + 1
    end
  end

  var node = 0
  if is_generic == 1
    node = ast::ast_struct_init_generic(a, name, type_args, as_int(values), as_int(field_names), line, col)
  else
    node = ast::ast_struct_init(a, name, as_int(values), as_int(field_names), line, col)
  end
  if spread_base != 0
    ast::ast_set_left(a, node, spread_base)
  end
  return node
end

# ===========================================================================
# Range / compound-assign / cast lowering (CST_RANGE 20, CST_COMPOUND_ASSIGN 50,
# CST_CAST 125)
# ===========================================================================

## Lowers a CST_RANGE (kind 20, children `[left, op_tok, right]`) to an
## `ast_binary` carrying the range op code parser.qz stores (parser.qz:3803-3814):
## `..` (CstOp 27) → op 21 (exclusive); `...` (CstOp 29) / `..=` (CstOp 28) →
## op 23 (inclusive). AST has no NODE_RANGE — ranges are binary ops the MIR
## desugars.
def cl_lower_range(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Operands are located RELATIVE to the op token (`..`/`...`), the node's only
  # token child: left = structured child before it, right = after it. A standalone
  # range always has both; an index-slice may omit one — parser.qz fills the gap
  # with int_lit(0) (missing start) / int_lit(-1) (missing end → "to size").
  var n = cst::cst_child_count(cs, h)
  var op_idx = -1
  var left_h = 0
  var right_h = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if op_idx < 0
        op_idx = j
      end
    else
      if op_idx < 0
        left_h = c
      elsif right_h == 0
        right_h = c
      end
    end
    j = j + 1
  end
  var disc = cst::cst_get_op(cs, h)
  var op = 21  # OP_RANGE (exclusive `..`)
  if disc == 28 or disc == 29
    op = 23  # OP_RANGE_INCLUSIVE (`..=` / `...`)
  end
  var l = 0
  if left_h != 0
    l = cst_lower_node(cs, left_h, a)
  else
    l = ast::ast_int_lit(a, 0, line, col)
  end
  var r = 0
  if right_h != 0
    r = cst_lower_node(cs, right_h, a)
  else
    r = ast::ast_int_lit(a, -1, line, col)
  end
  return ast::ast_binary(a, l, op, r, line, col)
end

## Maps a compound-assignment operator lexeme to its BASE binary op code.
## Arithmetic ops carry a CstOp disc, but the bitwise forms (`^= &= |= <<= >>=`)
## are stored with disc 0 (cst_parser: "round-trips via token"), so the lexeme is
## the single source of truth. Mirrors parser.qz:5714-5743.
def cl_compound_base_op(lex: String): Int
  if str_eq(lex, "+=")
    return 0   # OP_ADD
  end
  if str_eq(lex, "-=")
    return 1   # OP_SUB
  end
  if str_eq(lex, "*=")
    return 2   # OP_MUL
  end
  if str_eq(lex, "/=")
    return 3   # OP_DIV
  end
  if str_eq(lex, "%=")
    return 4   # OP_MOD
  end
  if str_eq(lex, "^=")
    return 18  # OP_BIT_XOR
  end
  if str_eq(lex, "&=")
    return 16  # OP_BIT_AND
  end
  if str_eq(lex, "|=")
    return 17  # OP_BIT_OR
  end
  if str_eq(lex, "<<=")
    return 19  # OP_SHL
  end
  if str_eq(lex, ">>=")
    return 20  # OP_SHR
  end
  return 0
end

## Lowers a CST_COMPOUND_ASSIGN (kind 50, children `[lhs, op_tok, rhs]`).
## parser.qz emits NO NODE_COMPOUND_ASSIGN — it desugars at parse time
## (parser.qz:5746-5769) into `lhs = lhs OP rhs`, where the assignment node is
## chosen by the lvalue kind: field-access → ast_field_assign, index →
## ast_index_assign, else → ast_assign. The binary's left is the WHOLE lvalue
## node (matching legacy), so `obj.f` / `v[i]` appear both in the binary and as
## the assign target's base.
def cl_lower_compound_assign(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var lhs = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var rhs = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
  var base_op = cl_compound_base_op(cl_first_token_lexeme(cs, h))
  var binary = ast::ast_binary(a, lhs, base_op, rhs, line, col)
  var lk = ast::ast_get_kind(a, lhs)
  if lk == node_constants::NODE_FIELD_ACCESS
    return ast::ast_field_assign(a, ast::ast_get_left(a, lhs), ast::ast_get_str1(a, lhs), binary, line, col)
  end
  if lk == node_constants::NODE_INDEX
    return ast::ast_index_assign(a, ast::ast_get_left(a, lhs), ast::ast_get_right(a, lhs), binary, line, col)
  end
  # Default: identifier lvalue → ast_assign by name.
  return ast::ast_assign(a, ast::ast_get_str1(a, lhs), binary, line, col)
end

## Lowers a CST_CAST (kind 125, children `[recv, as_kw, type_node]`) to
## `ast_type_cast(base, target_type_string)` (parser.qz postfix `as`). The target
## type is rendered via cst_type_string (exact for simple/generic/qualified/`T?`
## types; exotic forms are the known type-string gap).
def cl_lower_cast(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var base = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var tystr = cst_type_string(cs, cl_structured_child(cs, h, 1))
  return ast::ast_type_cast(a, base, tystr, line, col)
end

## Lowers a CST_PAREN (kind 17). Reproduces parser.qz:1500-1531:
##   ()        → ast_int_lit(0)   (unit value)
##   (e)       → lower(e)         (grouping; AST has no paren node)
##   (a, b…)   → ast_tuple_literal([a, b, …])
##   (e,)      → ast_tuple_literal([e])   (a trailing comma makes a 1-tuple)
## A comma token among the children is the tuple discriminant (distinguishes
## `(e)` from `(e,)`, which have the same single structured child).
def cl_lower_paren(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var has_comma = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), ",")
      has_comma = 1
    end
    j = j + 1
  end
  var nexpr = cl_structured_count(cs, h)
  if has_comma == 0
    if nexpr == 0
      return ast::ast_int_lit(a, 0, line, col)  # unit ()
    end
    return cst_lower_node(cs, cl_structured_child(cs, h, 0), a)  # grouping — drop parens
  end
  var elems = vec_new()
  var i = 0
  while i < nexpr
    elems.push(cst_lower_node(cs, cl_structured_child(cs, h, i), a))
    i = i + 1
  end
  return ast::ast_tuple_literal(a, as_int(elems), line, col)
end

# ===========================================================================
# Interpolated-string lowering (CST_INTERP_STRING 8)
# ===========================================================================

## Lowers a CST_INTERP_STRING (kind 8) to parser.qz's encoding (parser.qz:
## 1247-1289). The CST children are: opening `"` token, STRING_PART token leaves,
## CST_INTERP_EXPR (10) holes, closing `"` token. Each non-empty PART becomes
## `ast_string_lit(text)`; each hole becomes `to_str(<lowered inner expr>)`
## (`ast_call(ident("to_str"), [expr])`). Then:
##   parts==0 → ast_string_lit("");  parts==1 → that single part;  else interp_string.
## The first and last TOKEN-leaf children are the `"` delimiters (skipped); CST
## token leaves carry no token-type, so position discriminates them from PARTs.
def cl_lower_interp_string(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var cnt = cst::cst_child_count(cs, h)

  # Find first/last token-leaf indices (the `"` delimiters).
  var first_tok = 0 - 1
  var last_tok = 0 - 1
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if first_tok < 0
        first_tok = j
      end
      last_tok = j
    end
    j = j + 1
  end

  var parts = vec_new()
  j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      # Skip the opening/closing `"` delimiter token leaves; the rest are
      # STRING_PART literal chunks.
      if j != first_tok and j != last_tok
        var lit = cst::cst_get_str1(cs, c)
        if str_byte_len(lit) > 0
          parts.push(ast::ast_string_lit(a, lit, line, col))
        end
      end
    else
      if cst::cst_get_kind(cs, c) == 10  # CST_INTERP_EXPR hole
        var inner = cl_structured_child(cs, c, 0)
        var iast = 0
        if inner != 0
          iast = cst_lower_node(cs, inner, a)
        end
        var to_str_ident = ast::ast_ident(a, "to_str", line, col)
        var ts_args = vec_new()
        ts_args.push(iast)
        var ts_call = ast::ast_call(a, to_str_ident, as_int(ts_args), line, col)
        parts.push(ts_call)
      end
    end
    j = j + 1
  end

  var np = parts.size
  if np == 0
    return ast::ast_string_lit(a, "", line, col)
  end
  if np == 1
    return parts[0]
  end
  return ast::ast_interp_string(a, as_int(parts), line, col)
end

# ===========================================================================
# Statement-block lowering
# ===========================================================================

## A do-block EXPRESSION node (`result = do … end`, cst_parser.qz:603-613) is a
## CST_BLOCK(43) whose FIRST child is a `do` TOKEN leaf, followed by optional
## header tokens (`->` / `x: T, y ->`), then a single nested CST_BLOCK(43) body.
## A plain statement-sequence block (from cps_parse_block_until) has NO token
## leaves. This predicate fires only for the do-block-expression carrier.
def cl_block_is_do_expr(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  if n == 0
    return 0
  end
  var first = cst::cst_get_child(cs, h, 0)
  if cl_is_token(cs, first) == 1 and str_eq(cst::cst_get_str1(cs, first), "do")
    return 1
  end
  return 0
end

## Lowers a do-block EXPRESSION (`do … end` in value position) mirroring legacy
## parser.qz:ps_parse_standalone_block_body (2640-2702): a header (`->` or
## `ident` followed by `->`/`,`/`:`) makes it a NODE_LAMBDA (with the last-stmt
## implicit-return rewrite); a bare nullary-no-arrow `do … end` is a plain
## NODE_BLOCK of the body statements (NO implicit `it`, NO double wrap, NO
## implicit return). The header `it`-synthesis of `cl_lower_do_header` is
## deliberately NOT used here — the standalone form never synthesizes `it`.
def cl_lower_do_block_expr(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var n = cst::cst_child_count(cs, h)
  # The `do` marker is child 0; collect header TOKEN lexemes until the body block.
  var hdr = vec_new<String>()
  var body_cst = 0
  var j = 1
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      hdr.push(cst::cst_get_str1(cs, c))
    elsif cst::cst_get_kind(cs, c) == 43 and body_cst == 0
      body_cst = c
    end
    j = j + 1
  end
  # Legacy has_arrow gate: leading `->`, OR a leading IDENT followed by
  # `->`/`,`/`:` (parser.qz:2647-2668). Header lexemes hold no `:`/`,` for a bare
  # block, so a present `->` (anywhere in the header run) signals the lambda form.
  var has_arrow = 0
  var hi = 0
  while hi < hdr.size
    if str_eq(hdr[hi], "->")
      has_arrow = 1
    end
    hi = hi + 1
  end
  if has_arrow == 1
    var params = cl_lower_do_header(cs, h, 0, 0, line, col, a)
    var lam_body = cl_lower_block(cs, body_cst, a)
    cl_apply_lambda_implicit_return(a, lam_body)
    return ast::ast_lambda(a, as_int(params), "", lam_body, line, col)
  end
  # Nullary bare do-block: flatten to a single ast_block of the body statements.
  if body_cst == 0
    return ast::ast_block(a, as_int(vec_new()), line, col)
  end
  return cl_lower_block(cs, body_cst, a)
end

## Lowers a CST_BLOCK (kind 43) to ast_block. All structured children are
## statements; there are no delimiter tokens inside a block.
## Lowers a CST_ARENA_BLOCK (117) `arena name do … end` to NODE_ARENA_BLOCK (62).
## Mirrors parser.qz:5855-5895 `ast_arena_block(name, body_stmts, …)`: the body is
## a flat VEC of lowered statements (stored directly in `children`, NOT wrapped in
## an ast_block — typecheck_walk.qz:5278 reads `ast_get_children` as the stmt vec).
## CST children: [arena_kw, name_tok, do_kw, <CST_BLOCK body>, end_kw]. The arena
## name is the SECOND token child (first ident after `arena`); the body is the sole
## structured child.
def cl_lower_arena(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Arena name: the first token leaf after the `arena` keyword.
  var arena_name = ""
  var cnt = cst::cst_child_count(cs, h)
  var seen_kw = 0
  var i = 0
  while i < cnt and str_byte_len(arena_name) == 0
    var c = cst::cst_get_child(cs, h, i)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_kw == 0 and str_eq(lex, "arena")
        seen_kw = 1
      elsif seen_kw == 1 and str_eq(lex, "do") == 0
        arena_name = lex
      end
    end
    i = i + 1
  end
  # Body: the sole structured child (the CST_BLOCK). Flatten its statements into a
  # vec (NOT an ast_block — the arena node stores the raw stmt list).
  var stmts = vec_new()
  var body = cl_structured_child(cs, h, 0)
  if body != 0
    var bn = cst::cst_child_count(cs, body)
    var j = 0
    while j < bn
      var bc = cst::cst_get_child(cs, body, j)
      if cl_is_token(cs, bc) == 0
        stmts.push(cst_lower_node(cs, bc, a))
      end
      j = j + 1
    end
  end
  return ast::ast_arena_block(a, arena_name, as_int(stmts), line, col)
end

def cl_lower_block(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var stmts = vec_new()
  var cnt = cst::cst_child_count(cs, h)
  var j = 0
  while j < cnt
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      # Statement-position `select` is a NODE_SELECT VALUE that legacy wraps in
      # NODE_EXPR_STMT (ps_parse_select returns from the expression parser, then
      # ps_parse_assign_or_call wraps it — parser.qz:1425/5773). cst_parser does
      # NOT emit a CST_EXPR_STMT(44) carrier around a statement-position select
      # (cps_parse_stmt:TOK_SELECT returns the bare CST_SELECT, unlike `with`), so
      # apply the wrap here — exactly at statement position, leaving value-position
      # selects (lowered via cst_lower_node from a binding RHS / arg) bare.
      # `task_group` (73) shares this: cps_parse_stmt returns the bare CST kind
      # for both, and legacy wraps each statement-position block-expr in EXPR_STMT.
      if cst::cst_get_kind(cs, c) == 71 or cst::cst_get_kind(cs, c) == 73
        var sel_line = cst::cst_get_line(cs, c)
        var sel_col = cst::cst_get_col(cs, c)
        var sel_ast = cst_lower_node(cs, c, a)
        stmts.push(ast::ast_expr_stmt(a, sel_ast, sel_line, sel_col))
      else
        stmts.push(cst_lower_node(cs, c, a))
      end
    end
    j = j + 1
  end
  return ast::ast_block(a, as_int(stmts), line, col)
end

# ===========================================================================
# Definition-header scanning (struct / enum / trait / impl / extend)
# ===========================================================================
# `cps_parse_block_def` lays out these kinds as:
#   [kw_tok, <header tokens incl. generic `<..>` and balanced groups>,
#    CST_BLOCK members, end_tok]
# The header tokens carry the name, generics, supertraits, and the impl/extend
# `for_type`/`with Trait` clause — all as ordered CST_TOKEN leaves (generics are
# individual `<`,`T`,`,`,`>` leaves; balanced `(`/`[` groups are structured).

## Collects the header CST_TOKEN lexemes of a block-def node (everything between
## the leading keyword and the CST_BLOCK body / end), in source order. Balanced
## structured groups in the header are skipped (rare for these forms).
def cl_def_header_tokens(cs: cst::CstStorage, h: Int): Vec
  var toks = vec_new()
  var n = cst::cst_child_count(cs, h)
  var j = 1  # skip the leading keyword token
  # A `linear` contextual struct-modifier may sit at child 0, BEFORE the
  # `struct` keyword (cps_parse_block_def_x). When present, skip both so the
  # struct NAME (not the keyword) lands as the first header token.
  if n > 1 and cl_is_token(cs, cst::cst_get_child(cs, h, 0)) == 1
    var lead = cst::cst_get_str1(cs, cst::cst_get_child(cs, h, 0))
    if str_eq(lead, "linear") == 1
      j = 2
    end
  end
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 43  # CST_BLOCK body — header ends here
      j = n
    elsif cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "{") == 1
      # Brace-body opener `{` (cps_parse_block_def_x brace form) — the header
      # ends here, exactly as it does at the CST_BLOCK body for `end` form.
      j = n
    else
      if cl_is_token(cs, c) == 1
        toks.push(cst::cst_get_str1(cs, c))
      end
      j = j + 1
    end
  end
  return toks
end

## Renders a DEF-HEADER generic clause (the flat `< T : Bound , U >` token leaves
## that cps_parse_function pushes between the name and the param list) into the
## two SEPARATE strings parser.qz's `ps_parse_function` builds (parser.qz:6191-6239):
##   `names_out`  ← each bare param name, in order (no brackets/bounds), so the
##                  caller joins them with "," → `type_params` (`T`, `T,U`, `T,N`).
##   `bounds_out` ← `name:Bound[+Bound2]` for each BOUNDED param only, so the
##                  caller joins with "," → `type_param_bounds`. Multi-arg generic
##                  bounds (`Iter<Int>`, `Map<K, V>`) render with ", " between args,
##                  matching ps_parse_trait_bound_name's spacing.
## No-op (leaves both vecs empty) when `gen_lt_idx < 0` (non-generic def).
def cl_render_def_type_params(cs: cst::CstStorage, h: Int, gen_lt_idx: Int, plist_idx: Int, names_out: Vec, bounds_out: Vec): Void
  if gen_lt_idx < 0
    return
  end
  # Walk the header token leaves from the `<` up to (not including) the param list.
  # We only consult tokens (the verbatim `<...>` run is flat token leaves).
  var i = gen_lt_idx + 1  # skip the opening `<`
  while i < plist_idx
    var c = cst::cst_get_child(cs, h, i)
    if cl_is_token(cs, c) == 0
      i = i + 1
    else
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, ">") == 1 or str_eq(lex, ">>") == 1
        # Close of the (top-level) generic clause.
        return
      elsif str_eq(lex, ",") == 1
        i = i + 1
      else
        # `lex` is a type-param name. Record it.
        names_out.push(lex)
        var pname = lex
        i = i + 1
        # Optional bound: `: Bound[+Bound2...]`.
        var nxt = cl_header_next_token(cs, h, i, plist_idx)
        if nxt >= 0 and str_eq(cst::cst_get_str1(cs, cst::cst_get_child(cs, h, nxt)), ":") == 1
          i = nxt + 1
          var bres = vec_new()
          i = cl_render_bound_name(cs, h, i, plist_idx, bres)
          var bstr = "#{pname}:#{bres[0]}"
          # Additional `+ Bound` chains.
          var more = cl_header_next_token(cs, h, i, plist_idx)
          while more >= 0 and str_eq(cst::cst_get_str1(cs, cst::cst_get_child(cs, h, more)), "+") == 1
            i = more + 1
            var bres2 = vec_new()
            i = cl_render_bound_name(cs, h, i, plist_idx, bres2)
            bstr = "#{bstr}+#{bres2[0]}"
            more = cl_header_next_token(cs, h, i, plist_idx)
          end
          bounds_out.push(bstr)
        end
      end
    end
  end
end

## Index of the next TOKEN-leaf child at or after `i` (and before `plist_idx`), or
## -1 if none. Skips any structured children (the verbatim run is flat, but stay safe).
def cl_header_next_token(cs: cst::CstStorage, h: Int, i: Int, plist_idx: Int): Int
  var j = i
  while j < plist_idx
    if cl_is_token(cs, cst::cst_get_child(cs, h, j)) == 1
      return j
    end
    j = j + 1
  end
  return 0 - 1
end

## Renders ONE trait-bound name beginning at token index `i` into `out[0]`,
## mirroring ps_parse_trait_bound_name: a bare ident, optionally followed by a
## `< arg, arg >` generic-arg run (commas → ", ", everything else tight). Returns
## the index just PAST the consumed bound tokens.
def cl_render_bound_name(cs: cst::CstStorage, h: Int, i: Int, plist_idx: Int, out: Vec): Int
  var start = cl_header_next_token(cs, h, i, plist_idx)
  if start < 0
    out.push("")
    return i
  end
  var name = cst::cst_get_str1(cs, cst::cst_get_child(cs, h, start))
  var j = start + 1
  var nxt = cl_header_next_token(cs, h, j, plist_idx)
  if nxt >= 0 and str_eq(cst::cst_get_str1(cs, cst::cst_get_child(cs, h, nxt)), "<") == 1
    # Generic args on the bound: `Iter<Int>`, `Map<K, V>`.
    name = "#{name}<"
    var depth = 1
    var k = nxt + 1
    while k < plist_idx and depth > 0
      if cl_is_token(cs, cst::cst_get_child(cs, h, k)) == 0
        k = k + 1
      else
        var t = cst::cst_get_str1(cs, cst::cst_get_child(cs, h, k))
        if str_eq(t, "<") == 1
          depth = depth + 1
          name = "#{name}<"
        elsif str_eq(t, ">") == 1
          depth = depth - 1
          if depth == 0
            name = "#{name}>"
          else
            name = "#{name}>"
          end
        elsif str_eq(t, ">>") == 1
          depth = depth - 2
          name = "#{name}>"
        elsif str_eq(t, ",") == 1
          name = "#{name}, "
        else
          name = "#{name}#{t}"
        end
        k = k + 1
      end
    end
    out.push(name)
    return k
  end
  out.push(name)
  return j
end

## Renders a `< T, U:Bound >` generic token run starting at `toks[start]` (which
## must be "<") into the parser.qz `ps_parse_optional_type_params` string form:
##   `<T>`, `<T, U>`, `<T:Trait+Trait2>`. Commas render ", "; `:`/`+` are kept
## tight (matching ps_parse_trait_bound_name's spacing). Returns "" if toks[start]
## is not "<". On return, advances nothing (caller scans by position).
def cl_render_type_params(toks: Vec, start: Int): String
  var n = toks.size
  if start >= n or str_eq(toks[start], "<") == 0
    return ""
  end
  var out = "<"
  var depth = 0
  var j = start
  while j < n
    var lex = toks[j]
    if str_eq(lex, "<")
      depth = depth + 1
      if depth > 1
        out = "#{out}<"
      end
    elsif str_eq(lex, ">")
      depth = depth - 1
      if depth <= 0
        return "#{out}>"
      end
      out = "#{out}>"
    elsif str_eq(lex, ">>")
      depth = depth - 2
      if depth <= 0
        return "#{out}>"
      end
      out = "#{out}>>"
    elsif str_eq(lex, ",")
      out = "#{out}, "
    else
      out = "#{out}#{lex}"
    end
    j = j + 1
  end
  return "#{out}>"
end

## Index in `toks` of the first "<" at top level (the start of the generic clause),
## or -1 if none.
def cl_find_generic_start(toks: Vec): Int
  var n = toks.size
  var j = 0
  while j < n
    if str_eq(toks[j], "<")
      return j
    end
    j = j + 1
  end
  return 0 - 1
end

## Lowers the CST_BLOCK member-list of a block-def to a Vec<Int> of lowered
## member handles, applying `member_lower` per structured member (skipping any
## stray token leaves the parser pushed on stuck-recovery).
## True (1) iff a CST_FIELD_DEF member line is actually a `@cfg(...)` member
## decorator (first token `@`, followed by a `cfg` token) rather than a real
## field. cps_parse_member_line captures the decorator line as a field-def token
## bag `@ cfg ( … )`, so it must be recognized and consumed, not emitted.
def cl_field_is_cfg_decorator(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var first_at = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if first_at == 0
        if str_eq(lex, "@")
          first_at = 1
        else
          return 0
        end
      elsif str_eq(lex, "cfg")
        return 1
      end
    end
    j = j + 1
  end
  return 0
end

def cl_lower_struct_fields(cs: cst::CstStorage, members_block: Int, a: ast::AstStorage): Vec
  var out = vec_new()
  if members_block == 0
    return out
  end
  var n = cst::cst_child_count(cs, members_block)
  var skip_next = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, members_block, j)
    if cst::cst_get_kind(cs, c) == 89  # CST_FIELD_DEF (member-line carrier)
      if cl_field_is_cfg_decorator(cs, c) == 1
        # Member-position `@cfg(...)`: drop the decorator line; if the condition
        # is FALSE, also drop the FOLLOWING field (legacy member-cfg, host-
        # evaluated — same cl_cfg_decorator_skips path as the top-level cfg-drop).
        if cl_cfg_decorator_skips(cs, c) == 1
          skip_next = 1
        end
      elsif skip_next == 1
        skip_next = 0
      else
        out.push(cl_lower_field_def(cs, c, a))
      end
    end
    j = j + 1
  end
  return out
end

## Lowers a CST_FIELD_DEF member-line (`name : Type [= default]`) — a flat token
## bag — to an ast_field_def. Mirrors ps_parse_field_def: name before `:`, type =
## the normalized join after `:` up to an `=`. KNOWN GAP: field DEFAULT values
## (`field: T = expr`) are NOT reconstructed — `cps_parse_member_line` flattens
## the entire default expression into raw token leaves (balanced groups inlined),
## so the default is not available as a structured node to lower. Reconstructing
## arbitrary default exprs needs a cst_parser change (capture the default as a
## structured expr child); fields with defaults will DIFF in the fingerprint
## (legacy carries the default in the field's `left` slot).
def cl_lower_field_def(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var name = ""
  var seen_colon = 0
  var seen_eq = 0
  var type_toks = vec_new()
  var default_node = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, ":") and seen_colon == 0 and seen_eq == 0
        seen_colon = 1
      elsif str_eq(lex, "=")
        seen_eq = 1
      elsif seen_eq == 1
        # default value tokens — not reconstructed (KNOWN GAP)
      elsif seen_colon == 0
        if str_byte_len(name) == 0
          name = lex
        end
      else
        type_toks.push(lex)
      end
    else
      if seen_eq == 1 and default_node == 0
        default_node = cst_lower_node(cs, c, a)
      elsif seen_colon == 1 and seen_eq == 0
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  var type_ann = cl_render_type_from_tokens(type_toks)
  return ast::ast_field_def(a, name, type_ann, default_node, line, col)
end

## Lowers a CST_STRUCT_DEF (88). Header: name token, optional generics. is_private
## is set by an enclosing CST_VISIBILITY wrapper (handled at the dispatch site,
## which re-enters with a private flag). Decorator-carried flags (repr_c/packed/
## is_value via @repr(C)/@packed/@value) are handled by the decorator-aware
## callers; the `linear struct` contextual keyword is detected HERE (leading
## token child). is_private and the four flag bits are passed in.
def cl_lower_struct(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int, repr_c: Int, packed: Int, is_linear: Int, is_value: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # `linear struct` contextual keyword sits at child 0 (before the `struct`
  # keyword). Route it to is_linear, OR-ing with any decorator/attr-supplied
  # value so both spelling paths agree. (`@value`→is_value flows through the
  # passed-in flag; there is no bare `value struct` keyword.)
  var lin = is_linear
  var val = is_value
  if cst::cst_child_count(cs, h) > 1 and cl_is_token(cs, cst::cst_get_child(cs, h, 0)) == 1
    var lead = cst::cst_get_str1(cs, cst::cst_get_child(cs, h, 0))
    if str_eq(lead, "linear") == 1
      lin = 1
    end
  end
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  var type_params = ""
  var gi = cl_find_generic_start(toks)
  if gi >= 0
    type_params = cl_render_type_params(toks, gi)
  end
  var members = cl_child_of_kind(cs, h, 43)  # CST_BLOCK body
  var fields = cl_lower_struct_fields(cs, members, a)
  return ast::ast_struct_def(a, name, as_int(fields), type_params, is_private, repr_c, packed, lin, val, line, col)
end

## Lowers a CST_ENUM_DEF (90). Variants live in the CST_BLOCK as CST_FIELD_DEF
## token-bag carriers (`Name` or `Name(field: T, ...)`). Each lowers to an
## ast_variant_def with its payload fields parsed from the balanced `(...)` group.
def cl_lower_enum(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  var type_params = ""
  var gi = cl_find_generic_start(toks)
  if gi >= 0
    type_params = cl_render_type_params(toks, gi)
  end
  var members = cl_child_of_kind(cs, h, 43)
  var variants = vec_new()
  if members != 0
    var n = cst::cst_child_count(cs, members)
    var j = 0
    while j < n
      var c = cst::cst_get_child(cs, members, j)
      if cst::cst_get_kind(cs, c) == 89  # CST_FIELD_DEF carrier = a variant line
        variants.push(cl_lower_variant(cs, c, a))
      end
      j = j + 1
    end
  end
  return ast::ast_enum_def(a, name, as_int(variants), type_params, is_private, line, col)
end

## Lowers a variant member-line (CST_FIELD_DEF carrier). `cps_capture_balanced`
## FLATTENS a payload `(field: T, ...)` into the carrier's direct token children
## (`Name ( field : T , ... )`), NOT a nested group. So: NAME = first token;
## payload fields = the `field : Type` runs between the flat `(` and `)` tokens.
## Mirrors ps_parse_variant_def: each is an ast_field_def `name: Type`.
def cl_lower_variant(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var fields = vec_new()
  var name = ""
  var in_payload = 0
  var fname = ""
  var seen_colon = 0
  var have_field = 0
  var type_toks = vec_new()
  var gdepth = 0  # generic `<...>` depth — top-level commas (gdepth 0) separate fields
  var pdepth = 0  # paren `(...)` depth — a `)`/`,` inside an Fn-type (`Fn(): T`)
                  # field type must NOT close/split the variant payload
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if in_payload == 0
        if str_eq(lex, "(")
          in_payload = 1
        elsif str_byte_len(name) == 0
          name = lex
        end
      else
        if str_eq(lex, ")") and gdepth == 0 and pdepth == 0
          if have_field == 1
            fields.push(ast::ast_field_def(a, fname, cl_render_type_from_tokens(type_toks), 0, line, col))
            have_field = 0
          end
          in_payload = 0
        elsif str_eq(lex, ",") and gdepth == 0 and pdepth == 0
          if have_field == 1
            fields.push(ast::ast_field_def(a, fname, cl_render_type_from_tokens(type_toks), 0, line, col))
          end
          fname = ""
          seen_colon = 0
          type_toks = vec_new()
          have_field = 0
        elsif str_eq(lex, ":") and seen_colon == 0
          seen_colon = 1
        elsif seen_colon == 0
          fname = lex
          have_field = 1
        else
          if str_eq(lex, "<")
            gdepth = gdepth + 1
          elsif str_eq(lex, ">")
            gdepth = gdepth - 1
          elsif str_eq(lex, ">>")
            gdepth = gdepth - 2
          elsif str_eq(lex, "(")
            pdepth = pdepth + 1
          elsif str_eq(lex, ")")
            pdepth = pdepth - 1
          end
          type_toks.push(lex)
        end
      end
    else
      if in_payload == 1 and seen_colon == 1
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  return ast::ast_variant_def(a, name, as_int(fields), line, col)
end

## Lowers the methods (CST_FUNCTION_BLOCK/ENDLESS) of a block-def's CST_BLOCK to a
## Vec<Int> of lowered ast_function handles. Non-function members are skipped.
def cl_lower_methods(cs: cst::CstStorage, members_block: Int, a: ast::AstStorage): Vec
  var out = vec_new()
  if members_block == 0
    return out
  end
  var n = cst::cst_child_count(cs, members_block)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, members_block, j)
    var ck = cst::cst_get_kind(cs, c)
    if ck == 83 or ck == 84  # CST_FUNCTION_BLOCK / CST_FUNCTION_ENDLESS
      out.push(cl_lower_function(cs, c, a, 0))
    end
    j = j + 1
  end
  return out
end

## Lowers a CST_TRAIT_DEF (92). Header: name, optional generics, optional
## supertraits `: A + B`. Mirrors ps_parse_trait's supertraits string (joined
## with `+`). Methods are the CST_BLOCK's function members.
def cl_lower_trait(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  var nt = toks.size
  var gi = cl_find_generic_start(toks)
  var type_params = ""
  if gi >= 0
    type_params = cl_render_type_params(toks, gi)
  end
  # Supertraits: a `:` after the name/generics, then `Ident (+ Ident)*`.
  var supertraits = ""
  var ci = 1
  # Skip a generic clause if present (find the `>` that closes it).
  if gi == 1
    var depth = 0
    var k = 1
    while k < nt
      if str_eq(toks[k], "<")
        depth = depth + 1
      elsif str_eq(toks[k], ">")
        depth = depth - 1
        if depth <= 0
          ci = k + 1
          k = nt
        end
      elsif str_eq(toks[k], ">>")
        depth = depth - 2
        if depth <= 0
          ci = k + 1
          k = nt
        end
      end
      k = k + 1
    end
  end
  if ci < nt and str_eq(toks[ci], ":")
    ci = ci + 1
    var first = 1
    while ci < nt
      var lex = toks[ci]
      if str_eq(lex, "+")
        # separator
      else
        if first == 0
          supertraits = "#{supertraits}+"
        end
        supertraits = "#{supertraits}#{lex}"
        first = 0
      end
      ci = ci + 1
    end
  end
  var members = cl_child_of_kind(cs, h, 43)
  var methods = cl_lower_methods(cs, members, a)
  return ast::ast_trait_def(a, name, supertraits, type_params, as_int(methods), is_private, line, col)
end

## Renders the type-name string of a protocol step's CST_TYPE_REF (103) child,
## mirroring legacy ps_parse_type → the String stored in NODE_PROTOCOL_STEP.str1.
def cl_protocol_step_type(cs: cst::CstStorage, type_node: Int): String
  var toks = vec_new()
  cl_collect_type_tokens(cs, type_node, toks)
  return cl_render_type_from_tokens(toks)
end

## Walks the step-sequence children of `parent` (the CST_TRAIT_DEF carrier for a
## protocol, or a CST_BLOCK for a loop / choice body) and lowers each step into
## `out` (a Vec<Int> of NODE_PROTOCOL_STEP / _CHOICE / _LOOP handles). Mirrors
## ps_parse_protocol_def's body grammar (parser.qz:4624-4717). Header tokens
## (protocol keyword, name, generic `<...>` run) and the trailing `end` are not
## step keywords, so they are skipped. `send`/`recv` consume the next structured
## CST_TYPE_REF child; `loop`/`choice` consume the next CST_BLOCK child.
def cl_lower_protocol_steps(cs: cst::CstStorage, parent: Int, a: ast::AstStorage, out: Vec): Void
  var n = cst::cst_child_count(cs, parent)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, parent, j)
    var line = cst::cst_get_line(cs, c)
    var col = cst::cst_get_col(cs, c)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "send") or str_eq(lex, "recv")
        var step_kind = 1
        if str_eq(lex, "recv")
          step_kind = 2
        end
        # Type is the next STRUCTURED child (CST_TYPE_REF).
        var ty = cl_next_structured_after(cs, parent, j)
        var tystr = ""
        if ty != 0
          tystr = cl_protocol_step_type(cs, ty)
        end
        out.push(ast::ast_protocol_step(a, step_kind, tystr, line, col))
      elsif str_eq(lex, "loop")
        var lblk = cl_next_block_after(cs, parent, j)
        var lsteps = vec_new()
        if lblk != 0
          cl_lower_protocol_steps(cs, lblk, a, lsteps)
        end
        out.push(ast::ast_protocol_loop(a, as_int(lsteps), line, col))
      elsif str_eq(lex, "choice")
        var cblk = cl_next_block_after(cs, parent, j)
        var branches = vec_new()
        if cblk != 0
          cl_lower_protocol_choice_branches(cs, cblk, a, branches)
        end
        out.push(ast::ast_protocol_choice(a, as_int(branches), branches.size, line, col))
      end
    end
    j = j + 1
  end
end

## Splits a choice CST_BLOCK's step-sequence into branches on `or` separator
## tokens (mirrors ps_parse_protocol_def's choice grammar, parser.qz:4678-4710).
## Each branch is a Vec<Int> of NODE_PROTOCOL_STEP handles, pushed into `branches`
## (a Vec<Vec<Int>>). A final branch is always emitted even when empty/last.
def cl_lower_protocol_choice_branches(cs: cst::CstStorage, blk: Int, a: ast::AstStorage, branches: Vec): Void
  var n = cst::cst_child_count(cs, blk)
  var cur = vec_new()
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, blk, j)
    var line = cst::cst_get_line(cs, c)
    var col = cst::cst_get_col(cs, c)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "or")
        branches.push(cur)
        cur = vec_new()
      elsif str_eq(lex, "send") or str_eq(lex, "recv")
        var step_kind = 1
        if str_eq(lex, "recv")
          step_kind = 2
        end
        var ty = cl_next_structured_after(cs, blk, j)
        var tystr = ""
        if ty != 0
          tystr = cl_protocol_step_type(cs, ty)
        end
        cur.push(ast::ast_protocol_step(a, step_kind, tystr, line, col))
      end
    end
    j = j + 1
  end
  branches.push(cur)
end

## Returns the first STRUCTURED (non-token) child of `parent` at an index strictly
## greater than `idx`, or 0 if none.
def cl_next_structured_after(cs: cst::CstStorage, parent: Int, idx: Int): Int
  var n = cst::cst_child_count(cs, parent)
  var j = idx + 1
  while j < n
    var c = cst::cst_get_child(cs, parent, j)
    if cl_is_token(cs, c) == 0
      return c
    end
    j = j + 1
  end
  return 0
end

## Returns the first CST_BLOCK(43) child of `parent` at an index strictly greater
## than `idx`, or 0 if none.
def cl_next_block_after(cs: cst::CstStorage, parent: Int, idx: Int): Int
  var n = cst::cst_child_count(cs, parent)
  var j = idx + 1
  while j < n
    var c = cst::cst_get_child(cs, parent, j)
    if cst::cst_get_kind(cs, c) == 43
      return c
    end
    j = j + 1
  end
  return 0
end

## Lowers a `protocol Name [<T>] <steps> end` decl (carried as CST_TRAIT_DEF kind
## 92 with a leading `protocol` keyword) to NODE_PROTOCOL_DEF. Mirrors
## ps_parse_protocol_def (parser.qz:4597). Header: name token, optional generic
## clause; body is a step-sequence (send/recv/loop/choice).
def cl_lower_protocol(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  # Protocol type_params are BARE comma-joined names (no `<>` brackets), matching
  # ps_parse_protocol_def's `str_join(tp_parts, ",")` (parser.qz:4619) — distinct
  # from the bracketed struct/enum `<T, U>` form rendered by cl_render_type_params.
  var type_params = ""
  var gi = cl_find_generic_start(toks)
  if gi >= 0
    var tp_parts = vec_new()
    var nt = toks.size
    var ti = gi + 1
    while ti < nt and str_eq(toks[ti], ">") == 0 and str_eq(toks[ti], ">>") == 0
      if str_eq(toks[ti], ",") == 0
        tp_parts.push(toks[ti])
      end
      ti = ti + 1
    end
    type_params = str_join(tp_parts, ",")
  end
  var steps = vec_new()
  cl_lower_protocol_steps(cs, h, a, steps)
  return ast::ast_protocol_def(a, name, type_params, as_int(steps), is_private, line, col)
end

## Classifies a SINGLE flat default-token lexeme into its AST literal, mirroring
## the legacy primary-expr literal lowering (parser.qz). Returns 0 when the token
## is not a self-contained literal (idents, calls, anything that would need a full
## expr parse), so the caller leaves the default unreconstructed rather than mis-
## lowering. Conservative on purpose: only integer / bool / nil are reconstructed
## (the only literal default shapes the corpus exercises); string/char/float
## lexeme decoding is left as a gap to avoid quote/escape mismatches with legacy.
def cl_literal_token_to_ast(lex: String, a: ast::AstStorage, line: Int, col: Int): Int
  if str_eq(lex, "true")
    return ast::ast_bool_lit(a, 1, line, col)
  end
  if str_eq(lex, "false")
    return ast::ast_bool_lit(a, 0, line, col)
  end
  if str_eq(lex, "nil")
    return ast::ast_nil_lit(a, line, col)
  end
  # Integer literal: a non-empty all-digit run (allowing `_` group separators and
  # a `0x`/`0b`/`0o` radix prefix). ps_parse_int_value handles the radix/underscore
  # decoding exactly as legacy does. Anything else (ident, operator) → not a lit.
  var n = str_byte_len(lex)
  if n == 0
    return 0
  end
  var b0 = str_byte_at(lex, 0)
  if b0 < '0' or b0 > '9'
    return 0
  end
  var i = 0
  var ok = 1
  while i < n
    var b = str_byte_at(lex, i)
    var is_dig = b >= '0' and b <= '9'
    var is_hex = (b >= 'a' and b <= 'f') or (b >= 'A' and b <= 'F')
    var is_rad = b == 'x' or b == 'X' or b == 'b' or b == 'B' or b == 'o' or b == 'O'
    if is_dig == 0 and is_hex == 0 and is_rad == 0 and b != '_'
      ok = 0
      i = n
    else
      i = i + 1
    end
  end
  if ok == 0
    return 0
  end
  return ast::ast_int_lit(a, lexer::ps_parse_int_value(lex), line, col)
end

## Lowers a state field of an actor body: a CST_FIELD_DEF carrier whose tokens
## are `var name : Type [= default]`. Mirrors ps_parse_actor's per-field path
## (parser.qz:7442-7456): strip the leading `var`, then `name : Type [= expr]`
## like cl_lower_field_def. The default is only reconstructed when it is a single
## structured/literal token (same limitation as cl_lower_field_def).
def cl_lower_actor_field(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var name = ""
  var seen_var = 0
  var seen_colon = 0
  var seen_eq = 0
  var type_toks = vec_new()
  var default_node = 0
  var default_toks = vec_new()
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "var") and seen_var == 0 and str_byte_len(name) == 0
        seen_var = 1
      elsif str_eq(lex, ":") and seen_colon == 0 and seen_eq == 0
        seen_colon = 1
      elsif str_eq(lex, "=")
        seen_eq = 1
      elsif seen_eq == 1
        default_toks.push(lex)
      elsif seen_colon == 0
        if str_byte_len(name) == 0
          name = lex
        end
      else
        type_toks.push(lex)
      end
    else
      if seen_eq == 1 and default_node == 0
        default_node = cst_lower_node(cs, c, a)
      elsif seen_colon == 1 and seen_eq == 0
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  # Reconstruct a SINGLE-token literal default (`= 0`, `= true`, ...). Multi-token
  # or compound defaults remain unreconstructed (KNOWN GAP — needs a structured
  # default child from cps_parse_member_line).
  if default_node == 0 and default_toks.size == 1
    default_node = cl_literal_token_to_ast(default_toks[0], a, line, col)
  end
  var type_ann = cl_render_type_from_tokens(type_toks)
  return ast::ast_field_def(a, name, type_ann, default_node, line, col)
end

## Lowers a CST_ACTOR_DEF (95): `actor Name [<T>] <state fields + methods> end`.
## Mirrors ps_parse_actor (parser.qz:7419). Children are the state fields
## (`var name: Type [= default]` → NODE_FIELD_DEF) and methods (`def ...` →
## NODE_FUNCTION) in SOURCE ORDER, so the member block is walked in order rather
## than filtered per-kind. Header: name token, optional generic clause.
def cl_lower_actor(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_private: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  var type_params = ""
  var gi = cl_find_generic_start(toks)
  if gi >= 0
    type_params = cl_render_type_params(toks, gi)
  end
  var members = cl_child_of_kind(cs, h, 43)
  var children = vec_new()
  if members != 0
    var n = cst::cst_child_count(cs, members)
    var j = 0
    while j < n
      var c = cst::cst_get_child(cs, members, j)
      var ck = cst::cst_get_kind(cs, c)
      if ck == 83 or ck == 84  # CST_FUNCTION_BLOCK / CST_FUNCTION_ENDLESS — method
        children.push(cl_lower_function(cs, c, a, 0))
      elsif ck == 89  # CST_FIELD_DEF carrier — `var name: Type [= default]`
        children.push(cl_lower_actor_field(cs, c, a))
      end
      j = j + 1
    end
  end
  return ast::ast_actor_def(a, name, as_int(children), type_params, is_private, line, col)
end

## Lowers an `effect Name [<T>] <op defs> end` decl (carried as CST_TRAIT_DEF
## kind 92 with a leading `effect` keyword) to NODE_EFFECT_DECL. Ops are the
## function members of the body block (same lowering as trait methods). Mirrors
## ps_parse_effect_decl: ast_effect_decl(name, ops). type_params are skipped (not
## fingerprinted for effect decls).
def cl_lower_effect(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var name = ""
  if toks.size > 0
    name = toks[0]
  end
  var members = cl_child_of_kind(cs, h, 43)
  var ops = cl_lower_methods(cs, members, a)
  return ast::ast_effect_decl(a, name, as_int(ops), line, col)
end

## Lowers a CST_IMPL_BLOCK (93) / CST_EXTEND_BLOCK (94). The legacy parser builds
## BOTH `impl`-keyword and `extend`-keyword forms as NODE_IMPL_BLOCK (see
## ps_parse_extend / ps_parse_impl): `extend Type [with Trait]` → ast_impl_block
## with trait_name = the `with`-clause trait (or "" for inherent). Header tokens:
## optional generics, the for_type (a type token run), optional `with`/`without`
## Trait clause. type_params = the generic clause; for_type = the type after the
## generics up to a `with`/`without`; trait_name = the trait after `with`.
def cl_lower_impl(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_def_header_tokens(cs, h)
  var nt = toks.size
  var type_params = ""
  var ci = 0
  if nt > 0 and str_eq(toks[0], "<")
    type_params = cl_render_type_params(toks, 0)
    # advance ci past the generic clause
    var depth = 0
    var k = 0
    while k < nt
      if str_eq(toks[k], "<")
        depth = depth + 1
      elsif str_eq(toks[k], ">")
        depth = depth - 1
        if depth <= 0
          ci = k + 1
          k = nt
        end
      elsif str_eq(toks[k], ">>")
        depth = depth - 2
        if depth <= 0
          ci = k + 1
          k = nt
        end
      end
      k = k + 1
    end
  end
  # for_type tokens until `with`/`without`; trait_name after `with`/`without`.
  var ftoks = vec_new()
  var trait_name = ""
  var in_trait = 0
  var ttoks = vec_new()
  while ci < nt
    var lex = toks[ci]
    if str_eq(lex, "with") or str_eq(lex, "without")
      in_trait = 1
    elsif in_trait == 1
      ttoks.push(lex)
    else
      ftoks.push(lex)
    end
    ci = ci + 1
  end
  var for_type = cl_render_type_from_tokens(ftoks)
  if ttoks.size > 0
    trait_name = cl_render_type_from_tokens(ttoks)
  end
  var members = cl_child_of_kind(cs, h, 43)
  var methods = cl_lower_methods(cs, members, a)
  return ast::ast_impl_block(a, trait_name, for_type, type_params, as_int(methods), line, col)
end

## Lowers a CST_EXTERN_FN (113): `extern "C" def name(params): Ret [...]`. Bodyless
## form → ast_extern_fn. Header tokens: ABI string, `def`/`var`, name; params in a
## CST_PARAM_LIST; return type after `:`; variadic `...` as a trailing token.
## Bodied forms (`extern "C" def f(...): T = expr` endless, or `extern "x86-
## interrupt" def isr(...) <block> end`) lower to a NODE_FUNCTION carrying the
## cconv flag, matching ps_parse_extern_fn — the body is captured as a structured
## CST child by cps_parse_extern (the endless expr / the CST_BLOCK), so it lowers
## directly via cst_lower_node.
## Lowers a CST_MACRO_DEF (kind 124) → NODE_MACRO_DEF (parser.qz
## ps_parse_macro_def / ast::ast_macro_def). cst_parser children:
##   `[macro_kw, name_tok, (paramtoks via cps_capture_balanced), do_kw,
##    <body CST_BLOCK>, end_kw]`.
## The param list is a FLAT token run between `(` and `)` (cps_capture_balanced).
## Legacy walks param tokens building one ident node per param (frag_type stored
## in the ident's op slot; default FRAG_EXPR=0) and tracks the variadic `name...`
## form (is_variadic=1, variadic_param=name, NO ident node pushed). Mirror that
## state machine. The body is a single string-template (or quote) statement
## inside the CST_BLOCK — legacy stores the BARE string-lit / quote node (NOT a
## block), so we lower the block's first structured child directly.
def cl_lower_macro_def(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var n = cst::cst_child_count(cs, h)
  var name = ""
  var got_name = 0
  var params = vec_new()
  var is_variadic = 0
  var variadic_param = ""
  # Walk the flat header tokens. Phase 0 = before the param `(`; phase 1 = inside
  # the param list; phase 2 = after the closing `)` (the `do` keyword onward).
  var phase = 0
  var pname = ""           # pending param name awaiting `:frag` / `...` / `,` / `)`
  var phave = 0            # 1 iff pname holds an un-flushed param name
  var pfrag = 0            # fragment specifier of the pending param (FRAG_EXPR=0)
  var seen_colon = 0       # 1 iff the next IDENT is a fragment specifier name
  var variadic_err = 0     # 1 iff a param followed the variadic `...` (rejected)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if phase == 0
        # First token is `macro`; the next IDENT is the name; `(` opens params.
        if str_eq(lex, "(") == 1
          phase = 1
        elsif got_name == 0 and str_eq(lex, "macro") == 0
          name = lex
          got_name = 1
        end
      elsif phase == 1
        if str_eq(lex, ")") == 1
          # Flush a trailing pending param (no comma after the last one).
          if phave == 1
            var pn = ast::ast_ident(a, pname, line, col)
            ast::ast_set_op(a, pn, pfrag)
            params.push(pn)
            phave = 0
          end
          phase = 2
        elsif str_eq(lex, ",") == 1
          if phave == 1
            var pn2 = ast::ast_ident(a, pname, line, col)
            ast::ast_set_op(a, pn2, pfrag)
            params.push(pn2)
            phave = 0
          end
          seen_colon = 0
        elsif str_eq(lex, ":") == 1
          seen_colon = 1
        elsif str_eq(lex, "...") == 1
          # Variadic suffix: the pending name becomes the variadic param and is
          # NOT pushed as an ident (legacy: ast_macro_def variadic_param slot).
          is_variadic = 1
          variadic_param = pname
          phave = 0
        elsif seen_colon == 1
          # Fragment specifier name: expr/ident/type/block/tt → 0/1/2/3/4.
          if str_eq(lex, "ident") == 1
            pfrag = 1
          elsif str_eq(lex, "type") == 1
            pfrag = 2
          elsif str_eq(lex, "block") == 1
            pfrag = 3
          elsif str_eq(lex, "tt") == 1
            pfrag = 4
          else
            pfrag = 0
          end
          seen_colon = 0
        else
          # A param name IDENT. Flush any prior un-flushed name (defensive; the
          # comma branch normally handles separation).
          if phave == 1
            var pn3 = ast::ast_ident(a, pname, line, col)
            ast::ast_set_op(a, pn3, pfrag)
            params.push(pn3)
          end
          # Variadic must be last (legacy parser.qz:8056-8061): a param name
          # appearing AFTER the variadic `...` is rejected.
          if is_variadic == 1
            variadic_err = 1
          end
          pname = lex
          pfrag = 0
          phave = 1
        end
      end
    end
    j = j + 1
  end
  # Variadic-last rejection (legacy parser.qz:8060 "variadic parameter must be
  # last"). The QZ0101 string mirrors legacy ps_error verbatim so spec stderr
  # assertions (`assert_compile_error(..., "ariadic")`) match.
  if variadic_err == 1
    cl_reject("variadic parameter must be last", line, col)
  end
  # Body: the single string-template / quote statement inside the CST_BLOCK.
  # Lower the block's first structured child directly (legacy stores the bare
  # node, never an ast_block wrapper).
  var body_blk = cl_structured_child(cs, h, 0)
  var body = 0
  if body_blk != 0
    var inner = cl_structured_child(cs, body_blk, 0)
    # cps_parse_block_until wraps the template statement in a CST_EXPR_STMT (44)
    # carrier; legacy stores the BARE string-lit / quote node, so unwrap to the
    # carrier's sole structured child before lowering.
    if inner != 0 and cst::cst_get_kind(cs, inner) == 44
      inner = cl_structured_child(cs, inner, 0)
    end
    if inner != 0
      body = cst_lower_node(cs, inner, a)
    end
  end
  return ast::ast_macro_def(a, name, as_int(params), body, is_variadic, variadic_param, line, col)
end

## Returns 1 iff this CST_EXTERN_FN node is actually an `extern var name: Type`
## declaration: the first significant token child after the `extern` keyword is
## `var`. Mirrors the legacy disambiguation at parser.qz:8952.
def cl_extern_is_var(cs: cst::CstStorage, h: Int, n: Int): Int
  var j = 0
  var seen_extern = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "extern")
        seen_extern = 1
      elsif seen_extern == 1
        if str_eq(lex, "var")
          return 1
        end
        return 0
      end
    end
    j = j + 1
  end
  return 0
end

## Lowers `extern var name: Type` to NODE_EXTERN_VAR (external global), mirroring
## ps_parse_extern_var (parser.qz:6863). Flat token run is `extern` `var` `name`
## `:` <type-tokens / type-nodes>.
def cl_lower_extern_var(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var n = cst::cst_child_count(cs, h)
  var name = ""
  var seen_var = 0
  var seen_colon = 0
  var got_name = 0
  var type_toks = vec_new()
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "extern")
        # skip
      elsif str_eq(lex, "var") and seen_var == 0
        seen_var = 1
      elsif str_eq(lex, ":") and seen_colon == 0
        seen_colon = 1
      elsif seen_colon == 1
        type_toks.push(lex)
      elsif got_name == 0
        name = lex
        got_name = 1
      end
    else
      if seen_colon == 1
        cl_collect_type_tokens(cs, c, type_toks)
      end
    end
    j = j + 1
  end
  var type_ann = "Int"
  if type_toks.size > 0
    type_ann = cl_render_type_from_tokens(type_toks)
  end
  return ast::ast_extern_var(a, name, type_ann, line, col)
end

def cl_lower_extern_fn(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var n = cst::cst_child_count(cs, h)
  # `extern var name: Type` (external global) — disambiguated by the legacy
  # parser at parser.qz:8952 (TOK_VAR after extern routes to ps_parse_extern_var,
  # which produces NODE_EXTERN_VAR, NOT a NODE_FUNCTION). `cps_parse_extern`
  # captures it as the same flat token run: `extern` `var` `name` `:` <type>.
  # Detect the `var` second-token and lower to ast_extern_var so the form is not
  # mistaken for a (cconv-less) extern fn and wrongly rejected at QZ0101.
  if cl_extern_is_var(cs, h, n) == 1
    return cl_lower_extern_var(cs, h, a, line, col)
  end
  # `cps_parse_extern` captures the signature as a FLAT token run (params via
  # cps_capture_balanced → `(` inner `)` all direct token children). A body, if
  # present, is a trailing `=` expr or a CST_BLOCK — those are the NODE_FUNCTION
  # case (KNOWN GAP); the bodyless form has no CST_BLOCK / `=` body child.
  # Parse phases by walking the flat tokens.
  var convention = "C"
  var got_conv = 0
  var name = ""
  var seen_def = 0
  var phase = 0  # 0=pre-params, 1=in-params, 2=post-params (return/variadic)
  var paren_depth = 0
  var params = vec_new()
  var pname = ""
  var pseen_colon = 0
  var ptype_toks = vec_new()
  var phave = 0
  var ret_toks = vec_new()
  var ret_seen_colon = 0
  var is_variadic = 0
  var has_body = 0
  var endless_body = 0   # `= expr` form (vs CST_BLOCK form)
  var body_node = 0      # the structured body child (expr for endless, CST_BLOCK)
  var gdepth = 0  # generic `<...>` depth within a param type
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "=")
        has_body = 1
        endless_body = 1
        # The endless body expr is the next structured child after `=`.
        var bj = j + 1
        while bj < n
          var bc = cst::cst_get_child(cs, h, bj)
          if cl_is_token(cs, bc) == 0
            body_node = bc
            bj = n
          else
            bj = bj + 1
          end
        end
        j = n
      elsif phase == 0
        if str_eq(lex, "extern")
          # skip
        elsif str_eq(lex, "def") or str_eq(lex, "fn")
          seen_def = 1
        elsif str_eq(lex, "var")
          seen_def = 1
        elsif str_eq(lex, "(")
          phase = 1
          paren_depth = 1
        elsif seen_def == 0 and got_conv == 0
          # ABI string lexeme (e.g. C) — the token right after extern
          convention = lex
          got_conv = 1
        elsif seen_def == 1
          name = lex  # function name (last ident before `(`)
        end
      elsif phase == 1
        if str_eq(lex, "(")
          paren_depth = paren_depth + 1
        elsif str_eq(lex, ")")
          paren_depth = paren_depth - 1
          if paren_depth == 0
            if phave == 1
              params.push(ast::ast_param(a, pname, cl_render_type_from_tokens(ptype_toks), 0, 0, line, col))
              phave = 0
            end
            phase = 2
          end
        elsif str_eq(lex, "...")
          is_variadic = 1
        elsif str_eq(lex, ",") and gdepth == 0
          if phave == 1
            params.push(ast::ast_param(a, pname, cl_render_type_from_tokens(ptype_toks), 0, 0, line, col))
          end
          pname = ""
          pseen_colon = 0
          ptype_toks = vec_new()
          phave = 0
        elsif str_eq(lex, ":") and pseen_colon == 0
          pseen_colon = 1
        elsif pseen_colon == 0
          pname = lex
          phave = 1
        else
          if str_eq(lex, "<")
            gdepth = gdepth + 1
          elsif str_eq(lex, ">")
            gdepth = gdepth - 1
          elsif str_eq(lex, ">>")
            gdepth = gdepth - 2
          end
          ptype_toks.push(lex)
        end
      else  # phase 2: return type after `:`, variadic `...`
        if str_eq(lex, "...")
          is_variadic = 1
        elsif str_eq(lex, "can") or str_eq(lex, "where") or str_eq(lex, "when")
          # End of the return type — a `can` effect row (or where/when clause)
          # begins. Stop collecting return-type tokens (the can-row is attached
          # separately from the flat token leaves by cl_attach_can_row). The
          # loop CONTINUES so the trailing `=`/CST_BLOCK body is still located.
          ret_seen_colon = 0 - 1
        elsif str_eq(lex, ":") and ret_seen_colon == 0
          ret_seen_colon = 1
        elsif ret_seen_colon == 1
          ret_toks.push(lex)
        end
      end
    else
      var ck = cst::cst_get_kind(cs, c)
      if ck == 43  # CST_BLOCK body → NODE_FUNCTION form
        has_body = 1
        body_node = c
        j = n
      elsif phase == 1 and pseen_colon == 1
        cl_collect_type_tokens(cs, c, ptype_toks)
      elsif phase == 2 and ret_seen_colon == 1
        cl_collect_type_tokens(cs, c, ret_toks)
      end
    end
    j = j + 1
  end
  var return_type = "Void"
  if ret_toks.size > 0
    return_type = cl_render_type_from_tokens(ret_toks)
  end

  # ---- Rejections the legacy parser (ps_parse_extern_fn) raises but the CST
  # ---- lowering path otherwise drops (G1 Cause A). Mirror each ps_error
  # ---- message verbatim so spec stderr assertions match. ----
  # 1. Missing calling-convention string (`extern def ...` with no "C").
  if got_conv == 0
    cl_reject("error: extern requires calling convention string (e.g. extern \"C\" def ...)", line, col)
  end
  # 2. Variadic with no fixed parameters before `...`.
  if is_variadic == 1 and params.size == 0
    cl_reject("error: variadic extern function must have at least one fixed parameter before '...'", line, col)
  end
  # Detect a `can` effect-row token on the extern signature.
  var has_can = 0
  var ck = 0
  while ck < n
    var cct = cst::cst_get_child(cs, h, ck)
    if cl_is_token(cs, cct) == 1 and str_eq(cst::cst_get_str1(cs, cct), "can")
      has_can = 1
      ck = n
    else
      ck = ck + 1
    end
  end
  if has_body == 1
    # 3. extern-with-body requires a recognized cconv.
    if str_eq(convention, "C") == 0 and str_eq(convention, "x86-interrupt") == 0 and str_eq(convention, "preserve_all") == 0 and str_eq(convention, "preserve_most") == 0
      cl_reject("error: extern with body requires \"C\", \"x86-interrupt\", \"preserve_all\", or \"preserve_most\" calling convention", line, col)
    end
    # 4. extern-with-body cannot be variadic.
    if is_variadic == 1
      cl_reject("error: extern def with body cannot be variadic (use a bodyless declaration for variadic functions)", line, col)
    end
    # 5. x86-interrupt with body must return Void.
    if str_eq(convention, "x86-interrupt") and str_eq(return_type, "Void") == 0
      cl_reject("error: extern \"x86-interrupt\" def must return Void", line, col)
    end
  else
    # 6. Bodyless x86-interrupt is rejected — an ISR is a definition.
    if str_eq(convention, "x86-interrupt")
      cl_reject("error: extern \"x86-interrupt\" def requires a body (interrupt handlers are definitions, not declarations)", line, col)
    end
    # 7. Bodyless extern cannot carry a `can` clause (no body to constrain).
    if has_can == 1
      cl_reject("error: bodyless extern declarations cannot carry a `can` clause (no body to constrain)", line, col)
    end
  end

  if has_body == 1
    # extern-with-body lowers to a NODE_FUNCTION marked with the cconv flag
    # (parser.qz ps_parse_extern_fn:6779-6837). Two body shapes:
    #   endless `= expr` → block { return expr }   (mirrors cl_lower_function 84)
    #   block <stmts> end → lower block + implicit-return rewrite (mirror 83)
    # The cconv flag lives in a side table (effect_annotations) that the AST-
    # equivalence fingerprint does NOT read, so it is invisible to the corpus
    # check; it is set anyway for downstream correctness.
    var body_ast = 0
    if endless_body == 1
      var expr_ast = 0
      if body_node != 0
        expr_ast = cst_lower_node(cs, body_node, a)
      end
      var ret = ast::ast_return(a, expr_ast, line, col)
      var stmts = vec_new()
      stmts.push(ret)
      body_ast = ast::ast_block(a, as_int(stmts), line, col)
    else
      if body_node != 0
        body_ast = cst_lower_node(cs, body_node, a)
        cl_apply_implicit_return(a, body_ast)
      end
    end
    var fnode = ast::ast_function(a, name, as_int(params), return_type, body_ast, 0, "", "", line, col)
    if str_eq(convention, "C")
      ast::ast_func_set_cconv_c(a, fnode)
    elsif str_eq(convention, "x86-interrupt")
      ast::ast_func_set_cconv_x86_intr(a, fnode)
    elsif str_eq(convention, "preserve_all")
      ast::ast_func_set_cconv_preserve_all(a, fnode)
    elsif str_eq(convention, "preserve_most")
      ast::ast_func_set_cconv_preserve_most(a, fnode)
    end
    # A bodied extern may carry a `can <labels> [| tail]` effect row after the
    # return type (parser.qz:6751/6833) — captured as flat token leaves on the
    # extern node. Only the with-body path attaches it (bodyless rejects `can`).
    cl_attach_can_row(cs, h, 0, fnode, a)
    return fnode
  end
  return ast::ast_extern_fn(a, name, convention, as_int(params), return_type, is_variadic, line, col)
end

## Lowers a CST_DECORATOR (101): `@name[(args)]+ <decorated item>`. The children
## are the `@`/name/balanced-arg token leaves followed by the decorated item (the
## sole structured non-token child that is NOT a balanced arg group). For STRUCTs
## the decorators carry fingerprinted flag bits: `@repr(C)`→repr_c, `@packed`→
## packed, `@value`→is_value. `@derive(..)`/`@align(N)` and function decorators
## (`@noinline`/`@weak`/`@export`/`@ct`) do NOT affect the scalars the
## gate compares for the wrapped node, so they are ignored and the inner item is
## lowered with its own machinery. `@naked` IS reproduced (sets the NODE_FUNCTION
## naked flag via ast_func_set_naked → children[node]=1, matching legacy nk1).
## KNOWN GAP: other function-targeting flag side-tables (noinline/weak/...) are not.
## CstNodeKind discriminants for declaration-position decorated items. When the
## CST_DECORATOR's structured child is one of these, it is a DECL-position
## decorator (`@derive`/`@repr`/... on a struct/def/...); otherwise it is an
## EXPRESSION-position decorator (`@field`/`@heap`/`@c`) whose structured child
## (if any) is the lowered operand/arg.
def cl_dec_child_is_decl(ik: Int): Int
  # def / const-def / struct / enum / trait / impl / extend / actor
  if ik == 83 or ik == 84 or ik == 85 or ik == 88 or ik == 90 or ik == 92 or ik == 93 or ik == 94 or ik == 95
    return 1
  end
  # type/newtype carrier (89) / const-decl (98) / visibility (102) / extern (113)
  # / c-import (116) / macro-def (124)
  if ik == 89 or ik == 98 or ik == 102 or ik == 113 or ik == 116 or ik == 124
    return 1
  end
  # var/const module binding (53/54) and import (111): targets of the
  # declaration-position decorators `@thread_local`/`@cfg`. Legacy parser.qz
  # threads these through the same attribute block as the def/struct forms
  # (cfg → unwrap-to-inner; thread_local var → global_var is_thread_local=1).
  if ik == 53 or ik == 54 or ik == 111
    return 1
  end
  return 0
end

## Name token lexeme of an expression-position `@name ...` decorator: the token
## leaf immediately following the `@` leaf. Empty string if absent.
def cl_dec_name_lexeme(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var saw_at = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if saw_at == 1
        return lex
      end
      if str_eq(lex, "@")
        saw_at = 1
      end
    end
    j = j + 1
  end
  return ""
end

## True (1) iff this `@...` decorator node carries a `(` LPAREN token child —
## the parser's inline-C shape (`@c("code")`) pushes the LPAREN leaf, whereas a
## bare field shorthand (`@c`) or an alloc operand (`@c expr`) does NOT. This is
## the EXACT discriminator cps_parse_at_expr uses (inline-C branch is gated on
## `str_eq(name,"c") and cps_cur_type == TOK_LPAREN`); the lowering must mirror
## it so a field literally named `c` (`struct{... c: Int}` accessed via `@c`)
## lowers to FIELD_ACCESS(self, "c"), not an empty INLINE_C(""). Without this a
## bare `@c` field read mis-lowered to `@c("")` → an uninitialized inline-asm
## register, silently reading garbage for the `c` field.
def cl_dec_has_lparen_child(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if str_eq(cst::cst_get_str1(cs, c), "(")
        return 1
      end
    end
    j = j + 1
  end
  return 0
end

## Lowers an EXPRESSION-position `@name ...` decorator into the AST node legacy
## parser.qz produces. Three shapes (see cps_parse_at_expr):
##   `@c("code"[, arg]*)` → INLINE_C(code, [args])         (kind 54)
##   `@name EXPR`         → ALLOC_EXPR(name, EXPR)          (kind 20)
##   `@field`            → FIELD_ACCESS(self, field)       (kind 15)
def cl_lower_decorator_expr(cs: cst::CstStorage, h: Int, a: ast::AstStorage, module_scope: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var name = cl_dec_name_lexeme(cs, h)
  # --- Inline C: `@c("code"[, arg]*)` ------------------------------------
  # Structured children are [code_expr, arg_expr*]; code lowers to a STRING_LIT
  # whose str1 is the decoded code text legacy stores directly on INLINE_C.
  if str_eq(name, "c") and cl_dec_has_lparen_child(cs, h) == 1
    var sc = cl_structured_count(cs, h)
    var code = ""
    var c_args = vec_new()
    var ci = 0
    while ci < sc
      var child = cl_structured_child(cs, h, ci)
      var lowered = cst_lower_node_ctx(cs, child, a, module_scope)
      if ci == 0
        code = ast::ast_get_str1(a, lowered)
      else
        c_args.push(lowered)
      end
      ci = ci + 1
    end
    return ast::ast_inline_c_with_args(a, code, 0 + c_args, line, col)
  end
  # --- Allocation: `@name EXPR` ------------------------------------------
  var operand = cl_structured_child(cs, h, 0)
  if operand != 0
    var expr = cst_lower_node_ctx(cs, operand, a, module_scope)
    return ast::ast_alloc_expr(a, name, expr, line, col)
  end
  # --- Bare field access: `@field` → self.field --------------------------
  var self_node = ast::ast_ident(a, "self", line, col)
  return ast::ast_field_access(a, self_node, name, line, col)
end

## Collects the lexemes of the token leaves inside the FIRST `@cfg(...)` group of
## a CST_DECORATOR. Returns a Vec<String> of the tokens strictly between the `(`
## and its matching `)` (e.g. ["feature", ":", "\"egraph\""] for
## `@cfg(feature: "egraph")`, ["all", ":", "os", ":", "\"macos\"", ",", "arch",
## ":", "\"aarch64\""] for the `all:` form). Empty Vec if there is no `@cfg`.
## String tokens keep their surrounding quotes — exactly the raw interned lexeme
## legacy ps_current_lexeme returns — so cfg_evaluate_condition sees an identical
## value string on both the legacy and CST paths.
def cl_cfg_arg_tokens(cs: cst::CstStorage, h: Int): Vec<String>
  var out = vec_new<String>()
  var n = cst::cst_child_count(cs, h)
  var saw_cfg = 0
  var depth = 0
  var capturing = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if capturing == 1
        if str_eq(lex, "(")
          depth = depth + 1
          out.push(lex)
        elsif str_eq(lex, ")")
          depth = depth - 1
          if depth == 0
            return out
          end
          out.push(lex)
        else
          out.push(lex)
        end
      elsif saw_cfg == 1 and str_eq(lex, "(")
        capturing = 1
        depth = 1
      elsif str_eq(lex, "cfg")
        saw_cfg = 1
      end
    end
    j = j + 1
  end
  return out
end

## True (1) iff this CST_DECORATOR carries a `@cfg(...)` whose condition evaluates
## FALSE under the empty target (the equiv tool's legacy path uses target=""), so
## the decorated declaration must be DROPPED from the program. Evaluation delegates
## to cfg::cfg_evaluate_condition (shared os/arch/feature logic) and to the
## module-global feature set (empty for the gate). Handles the bare `key: "val"`,
## `not: key: "val"`, `any: ...`, and `all: ...` forms. Non-cfg decorators → 0.
def cl_cfg_decorator_skips(cs: cst::CstStorage, h: Int): Int
  var toks = cl_cfg_arg_tokens(cs, h)
  if toks.size == 0
    return 0
  end
  var first = toks[0]
  if str_eq(first, "not")
    # not: <key> : <"val"> → skip iff the inner condition is TRUE.
    var nkey = toks[2]
    var nval = toks[4]
    if cfg::cfg_evaluate_condition(nkey, nval, _cl_cfg_target) == 1
      return 1
    end
    return 0
  end
  if str_eq(first, "any")
    # any: (<key> : <"val">)(, ...)* → skip iff NONE match.
    var any_match = 0
    var i = 2
    while i + 2 <= toks.size
      var akey = toks[i]
      var aval = toks[i + 2]
      if cfg::cfg_evaluate_condition(akey, aval, _cl_cfg_target) == 1
        any_match = 1
      end
      i = i + 3
      if i < toks.size and str_eq(toks[i], ",")
        i = i + 1
      end
    end
    if any_match == 0
      return 1
    end
    return 0
  end
  if str_eq(first, "all")
    # all: (<key> : <"val">)(, ...)* → skip iff ANY fails.
    var all_match = 1
    var i = 2
    while i + 2 <= toks.size
      var akey = toks[i]
      var aval = toks[i + 2]
      if cfg::cfg_evaluate_condition(akey, aval, _cl_cfg_target) == 0
        all_match = 0
      end
      i = i + 3
      if i < toks.size and str_eq(toks[i], ",")
        i = i + 1
      end
    end
    if all_match == 0
      return 1
    end
    return 0
  end
  # Bare `key : "val"` → skip iff the condition is FALSE.
  var key = toks[0]
  var val = toks[2]
  if cfg::cfg_evaluate_condition(key, val, _cl_cfg_target) == 0
    return 1
  end
  return 0
end

def cl_lower_decorator(cs: cst::CstStorage, h: Int, a: ast::AstStorage, module_scope: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Expression-position `@name ...` (`@field` / `@heap EXPR` / `@c(...)`): the
  # structured child (if any) is an operand/arg expression, NOT a declaration.
  # Discriminate by the LAST structured child's kind — a decl kind routes to the
  # decl-decorator machinery below; anything else is an expression decorator.
  var sn = cst::cst_child_count(cs, h)
  var last_struct = 0
  var sm = sn - 1
  while sm >= 0
    var sc = cst::cst_get_child(cs, h, sm)
    if cl_is_token(cs, sc) == 0
      last_struct = sc
      sm = 0 - 1
    else
      sm = sm - 1
    end
  end
  var is_decl_dec = 0
  if last_struct != 0
    if cl_dec_child_is_decl(cst::cst_get_kind(cs, last_struct)) == 1
      is_decl_dec = 1
    end
  end
  if is_decl_dec == 0
    return cl_lower_decorator_expr(cs, h, a, module_scope)
  end
  # Collect decorator names (the token leaf following each `@`).
  var repr_c = 0
  var packed = 0
  var is_value = 0
  var attr_thread_local = 0
  var attr_strict = 0
  var attr_naked = 0
  # Function flag bits (ast_func_set_*). The CST decorator path previously
  # dropped these for `@pure def f` etc. (the "KNOWN GAP" noted below) —
  # surfaced as QZ1406.
  var attr_noinline = 0
  var attr_weak = 0
  var attr_panic_handler = 0
  var attr_export = 0
  var attr_ct = 0
  var effect_ann = 0
  # @align(N) on a struct. struct_align>0 records
  # the value via ast_struct_set_align; align_seen distinguishes a validated
  # @align from "no @align" so the misuse + value checks fire correctly.
  var struct_align = 0
  var align_seen = 0
  # @derive(Trait, ...) on a struct.
  # The comma-joined trait list is stored in the struct node's doc slot as
  # `@derive:<list>`; expand_derive_annotations (derive.qz) keys off that prefix
  # to synthesize the `extend Type with <Trait>` impls. Dropping it here is why
  # `Type$op_eq` came back Undefined.
  var derive_str = ""
  # derive_phase: 0=idle, 1=saw `derive` awaiting `(`, 2=inside `(` awaiting
  # trait ident or `)`, 3=saw trait awaiting `,` or `)`.
  var derive_phase = 0
  var n = cst::cst_child_count(cs, h)
  var expect_name = 0
  # align_phase: 0=idle, 1=saw `align` awaiting `(`, 2=inside `(` awaiting int/`)`,
  # 3=saw int awaiting `)`.
  var align_phase = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if derive_phase == 1
        # Expect `(` directly after `derive`.
        if str_eq(lex, "(")
          derive_phase = 2
        else
          cl_reject("Expected '(' after derive", line, col)
          derive_phase = 0
        end
      elsif derive_phase == 2
        # Awaiting a trait ident (or `)` for the empty `@derive()`).
        if str_eq(lex, ")")
          cl_reject("@derive() requires trait names", line, col)
          derive_phase = 0
        else
          if str_byte_len(derive_str) > 0
            derive_str = str_concat(derive_str, str_concat(",", lex))
          else
            derive_str = lex
          end
          derive_phase = 3
        end
      elsif derive_phase == 3
        # After a trait: `,` → expect another, `)` → done.
        if str_eq(lex, ",")
          derive_phase = 2
        elsif str_eq(lex, ")")
          derive_phase = 0
        else
          cl_reject("Expected ')' after derive list", line, col)
          derive_phase = 0
        end
      elsif align_phase == 1
        # Expect `(` directly after `align`.
        if str_eq(lex, "(")
          align_phase = 2
        else
          align_phase = 0
        end
      elsif align_phase == 2
        if str_eq(lex, ")")
          # `@align()` — no integer literal.
          cl_reject("@align() requires an integer literal (e.g. @align(64))", line, col)
          align_phase = 0
        else
          var av = str_to_int(lex)
          if av <= 0
            cl_reject("@align() value must be positive", line, col)
          elsif av & (av - 1) != 0
            cl_reject("@align() value must be a power of 2 (1, 2, 4, 8, 16, ...)", line, col)
          end
          struct_align = av
          align_seen = 1
          align_phase = 3
        end
      elsif align_phase == 3
        # Consume the closing `)`.
        align_phase = 0
      elsif str_eq(lex, "@")
        expect_name = 1
      elsif expect_name == 1
        expect_name = 0
        if str_eq(lex, "repr")
          repr_c = 1
        elsif str_eq(lex, "packed")
          packed = 1
        elsif str_eq(lex, "value")
          is_value = 1
        elsif str_eq(lex, "thread_local")
          attr_thread_local = 1
        elsif str_eq(lex, "strict")
          attr_strict = 1
        elsif str_eq(lex, "naked")
          attr_naked = 1
        elsif str_eq(lex, "noinline")
          attr_noinline = 1
        elsif str_eq(lex, "weak")
          attr_weak = 1
        elsif str_eq(lex, "panic_handler")
          attr_panic_handler = 1
        elsif str_eq(lex, "export")
          attr_export = 1
        elsif str_eq(lex, "ct")
          attr_ct = 1
        elsif str_eq(lex, "align")
          align_phase = 1
        elsif str_eq(lex, "derive")
          derive_phase = 1
        elsif str_eq(lex, "pure")
          effect_ann = effect_ann | 256  # EFFECT_ANNOTATED_PURE
        elsif str_eq(lex, "io")
          effect_ann = effect_ann | 1  # EFFECT_IO
        elsif str_eq(lex, "suspend")
          effect_ann = effect_ann | 2  # EFFECT_SUSPEND
        elsif str_eq(lex, "no_preempt")
          effect_ann = effect_ann | 1024  # ATTR_NO_PREEMPT
        end
      end
    end
    j = j + 1
  end
  # Decorated item = the LAST structured child (the recursive decl).
  var item = 0
  var m = n - 1
  while m >= 0
    var c = cst::cst_get_child(cs, h, m)
    if cl_is_token(cs, c) == 0
      item = c
      m = 0 - 1
    else
      m = m - 1
    end
  end
  if item == 0
    return ast::ast_ident(a, "__UNLOWERED_101", line, col)
  end
  var ik = cst::cst_get_kind(cs, item)
  # Unwrap a visibility wrapper to reach the definition + carry is_private.
  var is_priv = 0
  if ik == 102  # CST_VISIBILITY
    var marker = cl_first_token_lexeme(cs, item)
    if str_eq(marker, "priv")
      is_priv = 1
    end
    var inner = 0
    var im = cst::cst_child_count(cs, item) - 1
    while im >= 0
      var ic = cst::cst_get_child(cs, item, im)
      if cl_is_token(cs, ic) == 0
        inner = ic
        im = 0 - 1
      else
        im = im - 1
      end
    end
    if inner != 0
      item = inner
      ik = cst::cst_get_kind(cs, item)
    end
  end
  if ik == 88  # struct — apply the flag bits
    # Function-only attributes on a struct are misuse (legacy parser.qz:8733-8748).
    if attr_weak == 1
      cl_reject("@weak can only be applied to function definitions", line, col)
    end
    if attr_panic_handler == 1
      cl_reject("@panic_handler can only be applied to function definitions", line, col)
    end
    if attr_export == 1
      cl_reject("@export can only be applied to function definitions", line, col)
    end
    if attr_ct == 1
      cl_reject("@ct can only be applied to function definitions", line, col)
    end
    if attr_strict == 1
      cl_reject("@strict can only be applied to newtype declarations", line, col)
    end
    var snode = cl_lower_struct(cs, item, a, is_priv, repr_c, packed, 0, is_value)
    if align_seen == 1 and struct_align > 0
      ast::ast_struct_set_align(a, snode, struct_align)
    end
    # @derive(...) → stamp the doc slot legacy synthesis (derive.qz) keys off
    # (parser.qz:8749-8751: `@derive:<comma-list>`).
    if str_byte_len(derive_str) > 0
      ast::ast_set_doc(a, snode, str_concat("@derive:", derive_str))
    end
    return snode
  end
  if ik == 90  # enum
    if attr_weak == 1
      cl_reject("@weak can only be applied to function definitions", line, col)
    end
    if attr_panic_handler == 1
      cl_reject("@panic_handler can only be applied to function definitions", line, col)
    end
    if attr_export == 1
      cl_reject("@export can only be applied to function definitions", line, col)
    end
    if struct_align > 0
      cl_reject("@align can only be applied to struct definitions", line, col)
    end
    if attr_ct == 1
      cl_reject("@ct can only be applied to function definitions", line, col)
    end
    if attr_strict == 1
      cl_reject("@strict can only be applied to newtype declarations", line, col)
    end
    return cl_lower_enum(cs, item, a, is_priv)
  end
  if ik == 92  # trait
    if struct_align > 0
      cl_reject("@align can only be applied to struct definitions", line, col)
    end
    return cl_lower_trait(cs, item, a, is_priv)
  end
  if ik == 95  # actor
    return cl_lower_actor(cs, item, a, is_priv)
  end
  # `@thread_local var X = e` → NODE_GLOBAL_VAR with is_thread_local=1 (legacy:
  # ps_parse_global_var(ps, 1)). The inner item is a CST_VAR_DECL (53) at module
  # scope; route it through cl_lower_global with the thread-local flag set rather
  # than the default is_thread_local=0 generic recursion would produce.
  if attr_thread_local == 1 and ik == 53 and module_scope == 1
    return cl_lower_global(cs, item, a, 1, 1)
  end
  # `@strict newtype Name<T> = Wrapped` → NODE_NEWTYPE_DEF with is_strict=1
  # (legacy: attr_strict_newtype → ps_parse_newtype(ps, _, 1), parser.qz:8666).
  # The inner item is the top-level type/newtype carrier (CST_FIELD_DEF kind 89);
  # route it with the strict flag rather than the default is_strict=0 recursion.
  # Top-level type-alias / newtype carrier (CST_FIELD_DEF kind 89). Function-only
  # attributes here are misuse (legacy parser.qz:8746 @ct → newtype rejection).
  if ik == 89
    if attr_ct == 1
      cl_reject("@ct can only be applied to function definitions", line, col)
    end
    if attr_strict == 1
      return cl_lower_type_alias_or_newtype(cs, item, a, 1)
    end
  end
  # Function decorators (`@naked`/`@noinline`/`@weak`/`@panic_handler`/`@export`/
  # `@ct`/`@pure`/`@io`/`@suspend`/`@no_preempt`) → NODE_FUNCTION with the matching
  # flag bits set (legacy: parser.qz:8770-8790 ast_func_set_*). The inner item is a
  # CST_FUNCTION_BLOCK(83) / CST_FUNCTION_ENDLESS(84). Lower it (carrying is_priv)
  # and stamp every flag rather than letting the default recursion drop them
  # (previously a KNOWN GAP — `@pure` loss surfaced as QZ1406 under flag-ON).
  if ik == 83 or ik == 84
    # Struct-only attributes on a function are misuse (legacy parser.qz:8762-8766).
    if repr_c == 1 or packed == 1
      cl_reject("@packed/@repr(C) can only be applied to struct definitions", line, col)
    end
    if struct_align > 0
      cl_reject("@align can only be applied to struct definitions", line, col)
    end
    var fn = cl_lower_function(cs, item, a, is_priv)
    if attr_naked == 1
      ast::ast_func_set_naked(a, fn)
    end
    if attr_noinline == 1
      ast::ast_func_set_noinline(a, fn)
    end
    if attr_weak == 1
      ast::ast_func_set_weak(a, fn)
    end
    if attr_panic_handler == 1
      ast::ast_func_set_panic_handler(a, fn)
    end
    if attr_export == 1
      ast::ast_func_set_export(a, fn)
    end
    if attr_ct == 1
      ast::ast_func_set_ct(a, fn)
    end
    if effect_ann != 0
      ast::ast_func_set_effect_annotation(a, fn, effect_ann)
    end
    return fn
  end
  # Any other decorated item (def / impl / extend / import / ...): decorators
  # here either affect only side-tables the gate doesn't compare or are unwrap-only
  # (`@cfg(...)` defers condition evaluation past parse time, keeping the inner
  # decl). Lower the inner item with its own machinery.
  return cst_lower_node_ctx(cs, item, a, module_scope)
end

## Classifies a CST_FOR_IN pattern (the token run between `for` and `in`) as a
## destructure: 1 = struct (`{ … }` / `Type { … }`), 2 = vec (`[ … ]`), 0 = plain
## var. Mirrors ps_parse_for_labeled's destructure branches (parser.qz:4216/4244/
## 4275): a leading `{` or `[`, or an UPPERCASE-headed ident immediately followed
## by `{`.
def cl_for_pattern_destr_kind(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var seen_for = 0
  var first_after = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "for")
        seen_for = 1
      elsif str_eq(lex, "in")
        return 0
      elsif seen_for == 1
        if first_after == 0
          if str_eq(lex, "{")
            return 1
          elsif str_eq(lex, "[")
            return 2
          end
          # A leading ident — struct destructure iff UPPERCASE and next is `{`.
          var fc = str_byte_at(lex, 0)
          if fc >= 'A' and fc <= 'Z'
            first_after = 1
          else
            return 0
          end
        else
          if str_eq(lex, "{")
            return 1
          end
          return 0
        end
      end
    end
    j = j + 1
  end
  return 0
end

## The body CST_BLOCK (43) and iter expr of a CST_FOR_IN — shared by the plain
## and destructure paths. Returns the body handle (or 0).
def cl_for_body_block(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) == 43
      return c
    end
    j = j + 1
  end
  return 0
end

## The iter expr (first structured non-body child) of a CST_FOR_IN.
def cl_for_iter_node(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) != 43
      return c
    end
    j = j + 1
  end
  return 0
end

## Lowers a CST_FOR_IN (62) to ast_for. CST children:
##   [(label)?, for_kw, <pattern tokens>, in_kw, iter_expr, (step_kw, step)?,
##    body_block, end_kw]
## Mirrors the SIMPLE ps_parse_for_labeled path: var_name = the single pattern
## token; iter = the expr after `in`; body = the body block; `step EXPR` is stored
## as the for-node int_val (parser.qz:4337). DESTRUCTURE patterns (`for Type { x, y } in items` /
## `for [a, b] in items`) desugar to `for __for_destr in items` with the
## destructure prepended to the body, reproducing parser.qz:4216-4290.
def cl_lower_for(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Destructure-pattern for-in: desugar to `for __for_destr in items` with the
  # destructure node prepended to the body block (parser.qz:4216-4290; the temp
  # var is "__for_destr", init = the temp ident, is_mut=0).
  var dk = cl_for_pattern_destr_kind(cs, h)
  if dk != 0
    var iter_n = cl_for_iter_node(cs, h)
    var body_n = cl_for_body_block(cs, h)
    var iter_a = 0
    if iter_n != 0
      iter_a = cst_lower_node(cs, iter_n, a)
    end
    var temp_name = "__for_destr"
    var temp_ident = ast::ast_ident(a, temp_name, line, col)
    var destr_node = 0
    if dk == 1
      destr_node = cl_struct_destr_from_tokens(cs, h, temp_ident, 0, line, col, a)
    else
      destr_node = cl_vec_destr_from_tokens(cs, h, temp_ident, 0, line, col, a)
    end
    # Lower the body block normally, then prepend the destructure node to its
    # children (legacy parser.qz:4226-4239 builds a fresh block from
    # [destr] + ast_get_children(body)). Reusing cl_lower_block guarantees the
    # body statements encode identically (incl. the select/task_group wrapping).
    var stmts = vec_new()
    stmts.push(destr_node)
    if body_n != 0
      var lowered_body = cl_lower_block(cs, body_n, a)
      var bch = ast::ast_get_children(a, lowered_body)
      if bch != 0
        var bk = 0
        while bk < bch.size
          stmts.push(bch[bk])
          bk = bk + 1
        end
      end
    end
    var new_body = ast::ast_block(a, as_int(stmts), line, col)
    return ast::ast_for(a, temp_name, iter_a, new_body, cl_loop_label(cs, h), line, col)
  end
  # var_name = the token between `for` and `in`. A leading `await` (the
  # `for await v in chan` async-iterator form) is the TOK_AWAIT keyword (reserved,
  # never a var name) → consume it, set is_await, and the NEXT token is the var.
  var var_name = ""
  var is_await = 0
  var n = cst::cst_child_count(cs, h)
  var seen_for = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "for")
        seen_for = 1
      elsif str_eq(lex, "in")
        j = n
      elsif seen_for == 1 and is_await == 0 and str_byte_len(var_name) == 0 and str_eq(lex, "await")
        is_await = 1
      elsif seen_for == 1 and str_byte_len(var_name) == 0
        var_name = lex
      end
    end
    j = j + 1
  end
  if is_await == 0
    cl_check_binding_name(var_name, "for-loop variable", line, col)
  end
  # iter = the first structured child that is NOT the body block; body = the
  # CST_BLOCK child. Structured children in order: [iter_expr, (step)?, body].
  # The optional `step EXPR` clause (parser.qz:4321-4339) is the structured child
  # immediately following the `step` contextual-keyword token; it must be
  # discriminated from iter by that preceding token (same as the comprehension
  # lowerings, cl_lower_set_comp), then stored as the for-node's int_val so the
  # MIR for-desugar honors the stride. Without this the step is silently dropped
  # and the loop iterates by 1 (cst_lower KNOWN GAP, fixed here).
  var iter_node = 0
  var body_node = 0
  var step_node = 0
  var step_pending = 0  # 1 = next structured child is the step expr
  # Only the `step` contextual keyword AFTER `in` starts the step clause. The loop
  # VARIABLE sits between `for` and `in` and may itself be named `step`
  # (`for step in 0..n`); scanning for a bare `"step"` token from j=0 would treat
  # that var as the keyword, capture the iterator as the step node, and leave
  # iter_node null → a null-Vec-header iteration segfault (mir_lower_stmt_handlers
  # → lower_vec_iteration). Gate on seen_in so the var-name region is skipped.
  var seen_in = 0
  j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var stx = cst::cst_get_str1(cs, c)
      if str_eq(stx, "in")
        seen_in = 1
      elsif seen_in == 1 and str_eq(stx, "step")
        step_pending = 1
      end
    else
      if cst::cst_get_kind(cs, c) == 43  # CST_BLOCK body
        body_node = c
      elsif step_pending == 1
        step_node = c
        step_pending = 0
      elsif iter_node == 0
        iter_node = c
      end
    end
    j = j + 1
  end
  var iter_ast = 0
  if iter_node != 0
    iter_ast = cst_lower_node(cs, iter_node, a)
  end
  var body_ast = 0
  if body_node != 0
    body_ast = cl_lower_block(cs, body_node, a)
  end
  # `for await v in chan` → NODE_FOR_AWAIT (legacy parser.qz:4303-4312:
  # ast_for_await(var, channel, body)); plain `for v in iter` → NODE_FOR.
  if is_await == 1
    return ast::ast_for_await(a, var_name, iter_ast, body_ast, line, col)
  end
  var for_node = ast::ast_for(a, var_name, iter_ast, body_ast, cl_loop_label(cs, h), line, col)
  if step_node != 0
    var step_ast = cst_lower_node(cs, step_node, a)
    if step_ast > 0
      ast::ast_set_int_val(a, for_node, step_ast)
    end
  end
  return for_node
end

## Flattens ALL token-leaf lexemes of a member-line carrier `h` (CST_FIELD_DEF,
## kind 89) into a flat Vec<String> IN ORDER, recursing into any structured
## children (balanced `()`/`[]`/`{}` groups captured by cps_capture_balanced).
## Generic `<...>` clauses are already flat token leaves on the member line
## (cps_parse_member_line pushes cps_parse_type_args_verbatim directly onto the
## node), so they need no special recursion. Mirrors cl_collect_type_tokens.
def cl_member_line_tokens(cs: cst::CstStorage, h: Int): Vec
  var toks = vec_new()
  cl_collect_type_tokens(cs, h, toks)
  return toks
end

## Lowers a top-level `type Name<T> = Aliased` / `newtype Name<T> = Wrapped`
## member line (CST_FIELD_DEF, kind 89) to NODE_TYPE_ALIAS / NODE_NEWTYPE_DEF.
## Mirrors ps_parse_type_alias (parser.qz:6893) and ps_parse_newtype (7260).
##   toks = [kw, name, <generic toks...>, =, <type toks...>]
## name = toks[1]; type_params = cl_render_type_params over the `<...>` run;
## the type string = cl_render_type_from_tokens over the tokens after `=`.
## DEFERRED (returns placeholder, reported): `type Foo = binary { ... }` (the
## binary-DSL contextual keyword — legacy builds NODE_BINARY_BLOCK, not an
## alias), and unexpected leading keywords. is_strict is passed in by the caller:
## the `@strict` modifier is a SEPARATE CST_DECORATOR (kind 101) wrapping the
## member line (the kind-89 token bag never carries `strict`), so cl_lower_decorator
## detects @strict and calls this with is_strict=1 for a newtype; the bare
## top-level dispatch passes 0.
# ===========================================================================
# Binary-DSL `type Foo = binary { ... }` lowering — Stage 1
# ===========================================================================
#
# The CST captures the whole member line as a flat token bag (kind 89). The
# `binary { ... }` body is a balanced group flattened in-order by
# cl_collect_type_tokens; delimiter tokens (`{ } [ ] ( ) : , => match end`) are
# preserved as token leaves, but `;`/newlines are TRIVIA and ABSENT. So this
# mini-parser drives off STRUCTURAL cues (delimiters + lexeme shape), mirroring
# parser.qz's ps_parse_binary_* family but with NO token types and NO newlines.
#
# Spec-string format reproduced EXACTLY as ps_parse_binary_type_spec emits it
# (`u4`, `u16be`, `bytes`, `bytes(16)`, `pstring(u8)`, `[u8]`, `[u8;16]`,
# `[u8;qdcount]`) so tc_parse_type / _tc_bin_field_annotation resolve identically.
#
# STAGE 1 LIMITS: computed `= expr` fields are DEFERRED (stage 2) — the field is
# lowered WITHOUT the computed expr (still typechecks; encode override is the
# only lost behavior). packed struct / `as`-bitcast / `.with{}` are separate
# surfaces, handled elsewhere.

## Bit width of a primitive binary type spec, or 0 if variable/unknown.
## Ported verbatim from parser.qz:_bin_prim_bit_width (the legacy fn lives in
## parser.qz; duplicating the tiny width table here avoids a back-edge import
## and keeps the CST path self-contained).
def cl_bin_prim_bit_width(spec: String): Int
  var n = str_byte_len(spec)
  return 0 if n < 2
  var head = str_byte_at(spec, 0)
  # 'u' = 117, 'i' = 105, 'f' = 102
  if head != 117 and head != 105 and head != 102
    return 0
  end
  var i = 1
  var width = 0
  var saw_digit = 0
  while i < n
    var d = str_byte_at(spec, i)
    if d < 48 or d > 57
      break
    end
    width = (width * 10) + (d - 48)
    saw_digit = 1
    i = i + 1
  end
  return 0 if saw_digit == 0
  if i == n
    return width
  end
  if i + 2 != n
    return 0
  end
  var s1 = str_byte_at(spec, i)
  var s2 = str_byte_at(spec, i + 1)
  # 'l'=108, 'e'=101, 'b'=98 ; accept "le" / "be"
  if (s1 == 108 and s2 == 101) or (s1 == 98 and s2 == 101)
    return width
  end
  return 0
end

## Lower a flat slice of expression-token lexemes (toks[lo .. hi), exclusive hi)
## into an AST expression node IN STORAGE `a`, returning its handle (or 0 if the
## slice is empty / unparseable).
##
## STAGE 2b — computed `= expr` binary fields and computed array counts. The CST
## captured the `binary { ... }` member line as a FLAT token bag (no token types,
## no newlines), so the `= expr` run is just lexeme strings. To rebuild the same
## AST, we render the slice back to a source string (single-space-joined — the
## lexer is whitespace-insensitive for the arithmetic / `self.field` / call
## grammar these exprs use, so no tokens merge or split vs. the original), then
## parse + lower it through the CST pipeline: full-fidelity lex → CstParser →
## `cps_parse_expr` (the CST expression entry, == cps_parse_pipe) → lower the
## resulting CST expression subtree into the CALLER's storage `a` via
## `cst_lower_node` (the same per-node dispatcher `cst_lower` uses for whole
## programs). The returned handle is valid in `a` and identical in shape to what
## the rest of the binary-block lowering produces, so the field's `extra`-slot
## node drives encode-time override exactly as before. This keeps the binary-DSL
## computed-expr path entirely on the CST grammar — no legacy `ps_parse_expr`.
##
## KNOWN GAP: string-literal tokens flatten to their UNQUOTED lexeme in the bag
## (cl_collect_type_tokens), so a computed expr containing a string literal would
## mis-lex. Computed binary fields use constants / arithmetic / self.* / calls
## (no string literals), so this does not arise for the covered grammar.
def cl_lower_token_slice_expr(toks: Vec, lo: Int, hi: Int, a: ast::AstStorage): Int
  if hi <= lo
    return 0
  end
  # Render the slice to a single-space-joined source string.
  var src = ""
  var k = lo
  while k < hi
    if k > lo
      src = src + " "
    end
    src = src + toks[k]
    k = k + 1
  end
  # Full-fidelity lex (CST mode) + CstParser, mirroring cst_parse_source's setup
  # but parsing a SINGLE expression (cps_parse_expr) rather than a program.
  var interner = string_intern::intern_global()
  lexer::lexer_set_full_fidelity(1)
  var lex_result = lexer::lexer_tokenize(src, interner)
  lexer::lexer_set_full_fidelity(0)
  var p = cst_parser::cps_new(lex_result, src)
  var cst_expr = cst_parser::cps_parse_expr(p)
  if cst_expr == 0
    return 0
  end
  # Lower the CST expression subtree into the CALLER's AST storage `a`, using the
  # same per-node dispatcher cst_lower drives whole programs with. p.store holds
  # the CST arena cps_parse_expr built the node in.
  return cst_lower_node(p.store, cst_expr, a)
end

## Parse a binary type-spec starting at toks[*pos] (a Vec cursor via index ref
## emulated by returning [spec, next_pos] packed: we return spec via out-vec).
## Quartz has no out-params here, so this returns the serialized spec string and
## writes the next cursor index into cur (a 1-element Vec<Int>). Mirrors
## ps_parse_binary_type_spec. Accepts: `ident`, `ident(arg)`, `[T]`, `[T;N]`,
## `[T;field]`. Array element recurses.
def cl_bin_parse_type_spec(toks: Vec, start: Int, nt: Int, cur: Vec): String
  var i = start
  # Array form: `[` elem [count] `]`  (the `;` separator is trivia, absent).
  if i < nt and str_eq(toks[i], "[")
    i = i + 1
    var inner_cur = vec_new()
    inner_cur.push(i)
    var elem = cl_bin_parse_type_spec(toks, i, nt, inner_cur)
    i = inner_cur[0]
    var spec = "[" + elem
    # Optional count: an INT literal or a field-name IDENT immediately before `]`.
    if i < nt and str_eq(toks[i], "]") == 0
      var cnt_lex = ""
      cnt_lex = toks[i]
      spec = spec + ";" + cnt_lex
      i = i + 1
    end
    # Consume the closing `]`.
    if i < nt and str_eq(toks[i], "]")
      i = i + 1
    end
    cur.push(0)
    cur[0] = i
    return spec + "]"
  end
  # Scalar / parameterized form: `head` optionally `( arg )`.
  if i >= nt
    cur.push(0)
    cur[0] = i
    return ""
  end
  var head = ""
  head = toks[i]
  i = i + 1
  if i < nt and str_eq(toks[i], "(")
    i = i + 1
    var arg = ""
    if i < nt and str_eq(toks[i], ")") == 0
      arg = toks[i]
      i = i + 1
    end
    if i < nt and str_eq(toks[i], ")")
      i = i + 1
    end
    cur.push(0)
    cur[0] = i
    return head + "(" + arg + ")"
  end
  cur.push(0)
  cur[0] = i
  return head
end

## Parse one `name : typespec` field at toks[start]. Writes next cursor into cur
## (1-elem Vec). Returns the NODE_BINARY_FIELD handle, or 0 on malformed input.
## Mirrors ps_parse_binary_block_field. Computed `= expr` (stage 2) is SKIPPED:
## if a trailing `=` follows the spec, the expression tokens are consumed and
## discarded so the cursor still lands on the next field boundary.
def cl_bin_parse_field(toks: Vec, start: Int, nt: Int, a: ast::AstStorage, cur: Vec, line: Int, col: Int): Int
  var i = start
  if i >= nt
    cur.push(0)
    cur[0] = i
    return 0
  end
  # Field name: IDENT or `_` wildcard pad.
  var fname = ""
  fname = toks[i]
  i = i + 1
  # Expect `:`.
  if i < nt and str_eq(toks[i], ":")
    i = i + 1
  else
    cur.push(0)
    cur[0] = i
    return 0
  end
  var spec_cur = vec_new()
  spec_cur.push(i)
  var spec = cl_bin_parse_type_spec(toks, i, nt, spec_cur)
  i = spec_cur[0]
  var width = cl_bin_prim_bit_width(spec)
  var field = ast::ast_binary_field(a, fname, spec, width, line, col)
  # STAGE 2b: computed `= <expr>` — lower the expr-token run into the field's
  # `extra` slot (mirrors parser.qz ps_parse_binary_block_field's
  # `ast_set_extra(s, field, ps_parse_expr(ps))`), so encode-time override fires.
  # Scan the run up to the next field boundary, then lower the captured slice.
  # A boundary at top depth is: a `,`, a closing `}` (end of block/arm), or a
  # `name :` lookahead (the start of the next field). Brackets/parens nest.
  if i < nt and str_eq(toks[i], "=")
    i = i + 1
    var expr_lo = i
    var expr_hi = nt
    var depth = 0
    var done = 0
    while i < nt and done == 0
      var lex = toks[i]
      if str_eq(lex, "(") or str_eq(lex, "[") or str_eq(lex, "{")
        depth = depth + 1
        i = i + 1
      elsif str_eq(lex, ")") or str_eq(lex, "]")
        depth = depth - 1
        i = i + 1
      elsif str_eq(lex, "}") and depth <= 0
        # Stop AT the `}` (caller consumes it).
        expr_hi = i
        done = 1
      elsif str_eq(lex, "}")
        depth = depth - 1
        i = i + 1
      elsif str_eq(lex, ",") and depth <= 0
        # Stop AT the comma for the slice, then consume it; next field follows.
        expr_hi = i
        i = i + 1
        done = 1
      elsif depth <= 0 and i + 1 < nt and str_eq(toks[i + 1], ":")
        # `name :` lookahead — stop BEFORE the next field name.
        expr_hi = i
        done = 1
      else
        i = i + 1
      end
    end
    var compute_expr = cl_lower_token_slice_expr(toks, expr_lo, expr_hi, a)
    if compute_expr != 0
      ast::ast_set_extra(a, field, compute_expr)
    end
  end
  cur.push(0)
  cur[0] = i
  return field
end

## Parse a `match disc <arms> end` discriminated union at toks[start]. Writes
## next cursor into cur. Mirrors ps_parse_binary_union. Each arm: `INT => { ... }`.
def cl_bin_parse_union(toks: Vec, start: Int, nt: Int, a: ast::AstStorage, cur: Vec, line: Int, col: Int): Int
  var i = start
  # Consume `match`.
  i = i + 1
  if i >= nt
    cur.push(0)
    cur[0] = i
    return 0
  end
  var disc = ""
  disc = toks[i]
  i = i + 1
  var arms = vec_new()
  while i < nt and str_eq(toks[i], "end") == 0
    var arm_line = line
    var arm_col = col
    # Tag (INT) `=>` `{` fields `}`.
    var tag_lex = ""
    tag_lex = toks[i]
    # The tag must be an integer literal (mirrors ps_parse_binary_union's
    # TOK_INT check). A non-digit first byte means a non-literal tag.
    var t0 = str_byte_at(tag_lex, 0)
    if str_byte_len(tag_lex) == 0 or t0 < 48 or t0 > 57
      cl_reject("Expected integer literal as discriminator arm tag", arm_line, arm_col)
    end
    var tag = lexer::ps_parse_int_value(tag_lex)
    i = i + 1
    # Consume `=>`.
    if i < nt and str_eq(toks[i], "=>")
      i = i + 1
    else
      cl_reject("Expected '=>' after arm tag in binary union", arm_line, arm_col)
    end
    # Consume `{`.
    if i < nt and str_eq(toks[i], "{")
      i = i + 1
    end
    var arm_fields = vec_new()
    while i < nt and str_eq(toks[i], "}") == 0
      if str_eq(toks[i], ",")
        i = i + 1
        continue
      end
      var fcur = vec_new()
      fcur.push(i)
      var f = cl_bin_parse_field(toks, i, nt, a, fcur, arm_line, arm_col)
      var ni = fcur[0]
      if f == 0 or ni <= i
        i = nt
      else
        arm_fields.push(f)
        i = ni
      end
    end
    # Consume `}`.
    if i < nt and str_eq(toks[i], "}")
      i = i + 1
    end
    arms.push(ast::ast_binary_union_arm(a, tag, arm_fields, arm_line, arm_col))
  end
  # Consume `end`.
  if i < nt and str_eq(toks[i], "end")
    i = i + 1
  end
  cur.push(0)
  cur[0] = i
  return ast::ast_binary_union(a, disc, arms, line, col)
end

## Lower a CST_PACKED_STRUCT (129) — `packed struct(uN) Name <fields> end` —
## to NODE_PACKED_STRUCT (kind 94), mirroring parser.qz's ps_parse_packed_struct.
## Header child layout (cps_parse_block_def_x with lead_tok=`packed`):
##   child0 = `packed`, child1 = `struct`, then the balanced `( uN )` group as
##   three token leaves, then the NAME ident, then the CST_BLOCK (kind 43) body.
## Backing width = N from the `uN` lexeme inside the parens (8/16/32/64). Each
## body member is a CST_FIELD_DEF (89) token bag `name : <int>` (or `_ : <int>`):
## NODE_BINARY_FIELD with type-spec `u<width>` and bit_width = the integer — byte-
## identical to ps_parse_packed_struct so the existing typecheck/mir/codegen fire.
def cl_lower_packed_struct(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Walk header token leaves (skip `packed` + `struct`); find the backing-width
  # `uN` lexeme (first ident inside the parens) and the struct NAME (the ident
  # that follows the closing `)`). Delimiter tokens `( )` are skipped.
  var backing_width = 0
  var name = ""
  var n = cst::cst_child_count(cs, h)
  var seen_struct = 0
  var in_parens = 0
  var got_backing = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 43  # CST_BLOCK body — header ends
      j = n
    else
      if cl_is_token(cs, c) == 1
        var lex = cst::cst_get_str1(cs, c)
        if seen_struct == 0 and str_eq(lex, "struct")
          seen_struct = 1
        elsif str_eq(lex, "(")
          in_parens = 1
        elsif str_eq(lex, ")")
          in_parens = 0
        elsif in_parens == 1 and got_backing == 0
          got_backing = 1
          if str_eq(lex, "u8")
            backing_width = 8
          elsif str_eq(lex, "u16")
            backing_width = 16
          elsif str_eq(lex, "u32")
            backing_width = 32
          elsif str_eq(lex, "u64")
            backing_width = 64
          else
            cl_reject("packed struct backing type must be u8, u16, u32, or u64", line, col)
          end
        elsif seen_struct == 1 and in_parens == 0 and got_backing == 1 and str_byte_len(name) == 0
          name = lex
        end
      end
      j = j + 1
    end
  end
  # Fields: each member line is `name : <int>` (or `_ : <int>`). Build a
  # NODE_BINARY_FIELD with spec `u<int>` and bit_width = the integer.
  var fields = vec_new()
  var members = cl_child_of_kind(cs, h, 43)  # CST_BLOCK body
  if members != 0
    var mn = cst::cst_child_count(cs, members)
    var mj = 0
    while mj < mn
      var mc = cst::cst_get_child(cs, members, mj)
      if cst::cst_get_kind(cs, mc) == 89  # CST_FIELD_DEF member-line carrier
        var f = cl_lower_packed_field(cs, mc, a)
        if f != 0
          fields.push(f)
        end
      end
      mj = mj + 1
    end
  end
  var node = ast::ast_packed_struct(a, name, backing_width, as_int(fields), line, col)
  return node
end

## Lowers one packed-struct field member line (`name : <int>` or `_ : <int>`) to a
## NODE_BINARY_FIELD. Mirrors ps_parse_packed_struct's per-field build:
## ast_binary_field(name, "u<wtxt>", str_to_int(wtxt)). Returns 0 on malformed.
def cl_lower_packed_field(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var name = ""
  var seen_colon = 0
  var wtxt = ""
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, ":") and seen_colon == 0
        seen_colon = 1
      elsif seen_colon == 0
        if str_byte_len(name) == 0
          name = lex
        end
      elsif str_byte_len(wtxt) == 0
        wtxt = lex
      end
    end
    j = j + 1
  end
  # Width must be a bare integer literal (mirrors ps_parse_packed_struct's
  # TOK_INT gate — a non-digit lexeme like `u4` is rejected at lower-time).
  if str_byte_len(name) == 0 or str_byte_len(wtxt) == 0 or cl_lex_is_all_digits(wtxt) == 0
    cl_reject("Packed struct fields take a bare bit-width integer (e.g. `pin_mode: 2`)", line, col)
    return 0
  end
  var width = str_to_int(wtxt)
  return ast::ast_binary_field(a, name, "u" + wtxt, width, line, col)
end

## Lower `type Foo = binary { ... }` (stage 1). toks is the full member-line
## token bag; body_start is the index of the `{` (toks[eq_idx+2] points at `{`
## because toks[eq_idx+1] == "binary"). Builds NODE_BINARY_BLOCK (kind 93) with
## NODE_BINARY_FIELD / NODE_BINARY_UNION children, mirroring
## ps_parse_binary_block_body. Doc comment (if any) carried from the carrier node.
def cl_lower_binary_block(cs: cst::CstStorage, h: Int, a: ast::AstStorage, alias_name: String, toks: Vec, body_start: Int, nt: Int, line: Int, col: Int): Int
  var i = body_start
  # Consume the opening `{`.
  if i < nt and str_eq(toks[i], "{")
    i = i + 1
  end
  var fields = vec_new()
  var saw_close = 0
  var bailed = 0
  while i < nt and bailed == 0
    if str_eq(toks[i], "}")
      saw_close = 1
      i = nt
    else
      var lex = toks[i]
      # Separator commas between fields.
      if str_eq(lex, ",")
        i = i + 1
      elsif str_eq(lex, "match")
        # Discriminated union: `match IDENT ... end`.
        var ucur = vec_new()
        ucur.push(i)
        var u = cl_bin_parse_union(toks, i, nt, a, ucur, line, col)
        var ui = ucur[0]
        if u == 0 or ui <= i
          bailed = 1
        else
          fields.push(u)
          i = ui
        end
      else
        var fcur = vec_new()
        fcur.push(i)
        var f = cl_bin_parse_field(toks, i, nt, a, fcur, line, col)
        var ni = fcur[0]
        if f == 0 or ni <= i
          # Malformed / no progress — bail so we don't loop forever.
          bailed = 1
        else
          fields.push(f)
          i = ni
        end
      end
    end
  end
  # Mirror ps_parse_binary_block_body's `ps_expect(TOK_RBRACE)`: a body whose
  # balanced capture ran to EOF without a closing `}` is an unclosed block.
  if saw_close == 0
    cl_reject("Expected '}' to close binary block", line, col)
  end
  var node = ast::ast_binary_block(a, alias_name, fields, line, col)
  var doc = cst::cst_get_doc(cs, h)
  if str_byte_len(doc) > 0
    ast::ast_set_doc(a, node, doc)
  end
  return node
end

def cl_lower_type_alias_or_newtype(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_strict: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var toks = cl_member_line_tokens(cs, h)
  var nt = toks.size
  if nt < 2
    return ast::ast_ident(a, "__UNLOWERED_89", line, col)
  end
  var kw_lex = ""
  kw_lex = toks[0]
  var is_newtype = 0
  if str_eq(kw_lex, "type")
    is_newtype = 0
  elsif str_eq(kw_lex, "newtype")
    is_newtype = 1
  else
    # Unexpected member-line shape at top level — keep the placeholder.
    return ast::ast_ident(a, "__UNLOWERED_89", line, col)
  end
  var alias_name = ""
  alias_name = toks[1]
  # type_params: a `<...>` generic clause immediately after the name (toks[2]).
  var type_params = ""
  var eq_idx = 0 - 1
  if nt > 2 and str_eq(toks[2], "<")
    type_params = cl_render_type_params(toks, 2)
  end
  # Find the top-level `=` (skipping any `=` nested inside the generic clause —
  # none occur in practice, but scan at depth 0 to be safe).
  var depth = 0
  var j = 2
  while j < nt
    var lex = ""
    lex = toks[j]
    if str_eq(lex, "<")
      depth = depth + 1
    elsif str_eq(lex, ">")
      depth = depth - 1
    elsif str_eq(lex, ">>")
      depth = depth - 2
    elsif str_eq(lex, "=") and depth <= 0
      eq_idx = j
      j = nt
    end
    j = j + 1
  end
  if eq_idx < 0
    return ast::ast_ident(a, "__UNLOWERED_89", line, col)
  end
  # Binary-DSL form: `type Foo = binary { ... }` (parser.qz:6911). Stage 1 —
  # fields + widths + arrays + unions. Computed `= expr` fields are stage 2.
  if eq_idx + 1 < nt and str_eq(toks[eq_idx + 1], "binary")
    return cl_lower_binary_block(cs, h, a, alias_name, toks, eq_idx + 2, nt, line, col)
  end
  # Type tokens are everything after the `=`.
  var ty_toks = vec_new()
  var k = eq_idx + 1
  while k < nt
    ty_toks.push(toks[k])
    k = k + 1
  end
  var ty_str = cl_render_type_from_tokens(ty_toks)
  if is_newtype == 1
    return ast::ast_newtype(a, alias_name, ty_str, type_params, is_strict, line, col)
  end
  return ast::ast_type_alias(a, alias_name, ty_str, type_params, line, col)
end

## Lowers a CST_CONST_DECL (98) — `const NAME = expr` — to a NODE_CONST_DECL.
## Children (cps_parse: TOK_CONST dispatch): `[const tok, NAME tok, = tok,
## init expr-node]`. NAME = the first IDENT token leaf after `const`; the init
## is the sole structured (non-token) child, lowered via cst_lower_node so any
## expression form (literal, call, binary op, ident, ...) reconstructs exactly.
## Mirrors ps_parse_const_decl (parser.qz:7894) → ast_const_decl(name, init).
def cl_lower_const_decl(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var name = ""
  var seen_const = 0
  var init_node = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_const == 0 and str_eq(lex, "const")
        seen_const = 1
      elsif str_byte_len(name) == 0 and str_eq(lex, "=") == 0
        name = lex
      end
    else
      # The structured RHS expression child.
      if init_node == 0
        init_node = cst_lower_node(cs, c, a)
      end
    end
    j = j + 1
  end
  return ast::ast_const_decl(a, name, init_node, line, col)
end

# ===========================================================================
# Qualified-path (CST_PATH, kind 16) lowering — Increment A
# ===========================================================================
#
# Legacy `parser.qz` resolves `a::b` syntactically at parse time (no path AST
# node). It emits one of:
#   - lowercase/underscore RHS (`mod::func`)  → `$`-joined ident "mod$func"
#   - uppercase RHS, no trailing call (`Color::Red`) → ast_enum_access
# CST_PATH children are `[ base_node(structured), "::"(token), seg(token) ]`;
# `a::b::c` NESTS (base is itself a CST_PATH). The trailing `(args)` of
# `Color::Red(x)` is NOT a CST_PATH child (the CST_CALL wraps it) — call
# absorption is Increment B and is NOT handled here.

## The RHS segment lexeme of a CST_PATH: the last token child (the token after
## `::`). The first token child is `::` itself; the base is a structured child.
def cl_path_seg_lexeme(cs: cst::CstStorage, h: Int): String
  var lex = ""
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var l = cst::cst_get_str1(cs, c)
      if str_eq(l, "::") == 0
        lex = l
      end
    end
    j = j + 1
  end
  return lex
end

## Collect the ordered `$`-join name of a CST_PATH base+RHS chain. Walks the
## nested-CST_PATH base inward (structured child 0). For `a::b::c` returns
## "a$b$c"; for a 2-segment `a::b` returns "a$b". The deepest base is a
## CST_IDENT whose lexeme is the head.
def cl_path_joined_name(cs: cst::CstStorage, h: Int): String
  var seg = cl_path_seg_lexeme(cs, h)
  var base = cl_structured_child(cs, h, 0)
  if base == 0
    return seg
  end
  var bk = cst::cst_get_kind(cs, base)
  if bk == 16  # nested CST_PATH
    return "#{cl_path_joined_name(cs, base)}$#{seg}"
  end
  # base is a CST_IDENT (or other leaf-bearing structured node) — its lexeme is
  # the head segment.
  return "#{cl_first_token_lexeme(cs, base)}$#{seg}"
end

## First byte (after an optional leading `_`) is in 'a'..'z' or '_' → treated as
## a method/module path RHS by legacy (parser.qz:2064-2073). Mirrors the legacy
## lowercase/underscore discriminator on the RHS segment.
def cl_path_rhs_is_lower(rhs: String): Int
  var fc = str_byte_at(rhs, 0)
  if fc >= 'a'
    if fc <= 'z'
      return 1
    end
  end
  if fc == '_'
    return 1
  end
  return 0
end

## Compose (name, variant) for an uppercase-RHS path's enum_access. The variant
## is the final RHS seg; the name is all preceding segments `$`-joined. Walks the
## nested base chain. For `Color::Red` → name="Color", variant="Red"; for
## `A::B::C` → name="A$B", variant="C". (Increment A: NO alias-drop.)
def cl_path_enum_name(cs: cst::CstStorage, h: Int): String
  var base = cl_structured_child(cs, h, 0)
  if base == 0
    return ""
  end
  var bk = cst::cst_get_kind(cs, base)
  if bk == 16  # nested CST_PATH: name = its full $-joined name
    return cl_path_joined_name(cs, base)
  end
  # base is the head CST_IDENT
  return cl_first_token_lexeme(cs, base)
end

## The HEAD-segment lexeme of a CST_PATH chain: the deepest base ident, reached
## by descending structured-child 0 through any nested CST_PATHs. For
## `alias::Type::Variant` returns "alias"; for `Color::Red` returns "Color".
def cl_path_head_lexeme(cs: cst::CstStorage, h: Int): String
  var base = cl_structured_child(cs, h, 0)
  if base == 0
    return cl_path_seg_lexeme(cs, h)
  end
  if cst::cst_get_kind(cs, base) == 16  # nested CST_PATH
    return cl_path_head_lexeme(cs, base)
  end
  return cl_first_token_lexeme(cs, base)
end

## First byte of `s` is an uppercase 'A'..'Z'.
def cl_seg_is_upper(s: String): Int
  var fc = str_byte_at(s, 0)
  if fc >= 'A'
    if fc <= 'Z'
      return 1
    end
  end
  return 0
end

## True iff this CST_PATH is the legacy alias-drop shape `alias::Type::Variant`:
## the HEAD segment is a registered import alias, AND the path has exactly the
## 3-segment chain (outer base is a nested CST_PATH whose own base is the head
## ident), AND the MIDDLE segment (the inner path's RHS) is uppercase. Mirrors
## parser.qz:2035 `_is_alias && _peek_is_upper && _peek2_is_dcolon`.
def cl_path_is_alias_drop(cs: cst::CstStorage, h: Int): Int
  var base = cl_structured_child(cs, h, 0)
  if base == 0
    return 0
  end
  if cst::cst_get_kind(cs, base) != 16  # outer base must itself be a CST_PATH
    return 0
  end
  # `base` is the inner `alias::Type` path. Its own base must be the head ident
  # (NOT another nested path) for the exactly-3-segment shape.
  var inner_base = cl_structured_child(cs, base, 0)
  if inner_base == 0
    return 0
  end
  if cst::cst_get_kind(cs, inner_base) == 16  # 4+ segments — not the drop shape
    return 0
  end
  var head = cl_first_token_lexeme(cs, inner_base)
  if cl_is_import_alias(head) == 0
    return 0
  end
  # Middle segment (inner path's RHS, the `Type`) must be uppercase.
  var middle = cl_path_seg_lexeme(cs, base)
  return cl_seg_is_upper(middle)
end

## Enum-access `name` for an uppercase-RHS path, applying Increment C alias-drop.
## On the `alias::Type::Variant` shape the alias is DROPPED, so name = the middle
## `Type` segment (the inner path's RHS) alone. Otherwise falls back to the
## `$`-joined chain (Increment A behavior).
def cl_path_enum_name_aliased(cs: cst::CstStorage, h: Int): String
  if cl_path_is_alias_drop(cs, h) == 1
    var base = cl_structured_child(cs, h, 0)
    return cl_path_seg_lexeme(cs, base)  # the `Type` segment, alias dropped
  end
  return cl_path_enum_name(cs, h)
end

## `$`-joined ident for a lowercase-RHS path, applying Increment C alias-drop.
## On the `alias::Type::method` shape (3-seg, uppercase middle, alias head, but a
## LOWERCASE final RHS so it lowers to a `$`-ident not enum_access) legacy drops
## the alias and joins `Type$method` (parser.qz:2035 drop → 2075 `$`-join).
## Otherwise falls back to the full `$`-joined chain (Increment A behavior).
def cl_path_joined_name_aliased(cs: cst::CstStorage, h: Int): String
  if cl_path_is_alias_drop(cs, h) == 1
    var base = cl_structured_child(cs, h, 0)
    # Inner `alias::Type` path → drop `alias`, keep `Type`; then `$`-join the
    # outer RHS (the lowercase final segment) onto it.
    return "#{cl_path_seg_lexeme(cs, base)}$#{cl_path_seg_lexeme(cs, h)}"
  end
  return cl_path_joined_name(cs, h)
end

## Lowers a CST_PATH (kind 16). Increment A: lowercase RHS → `$`-joined ident;
## uppercase RHS (bare, no call) → ast_enum_access with bound_names=int 0 and an
## empty payload Vec. Call-absorption (`Color::Red(x)`) is handled in the
## CST_CALL arm (Increment B) — NOT here.
def cl_lower_path(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var rhs = cl_path_seg_lexeme(cs, h)
  if cl_path_rhs_is_lower(rhs) == 1
    # Lowercase/underscore RHS → "head$..$rhs" ident, matching legacy's $-join.
    # Increment C: `_aliased` drops a leading `alias::` on `alias::Type::method`.
    return ast::ast_ident(a, cl_path_joined_name_aliased(cs, h), line, col)
  end
  # Uppercase RHS. The enum-access-vs-`$`-ident choice keys on the HEAD segment's
  # case, mirroring legacy parser.qz exactly:
  #
  #   - 3-seg alias-drop shape (`alias::Type::Variant`, head is a registered
  #     import alias) → enum_access with the alias dropped (Increment C). Legacy:
  #     parser.qz:2035 drops the alias, then 2058 sees `Type::Variant` → enum.
  #   - LOWERCASE head, NOT the alias-drop shape (`mir::MIR_FUNC_REF`,
  #     `terminal::KEY_CTRL`, `abi_classify::ABI_COERCE`) → module-qualified
  #     CONSTANT, NOT an enum. Legacy: the lowercase-head path enters the
  #     `_dc_is_lower` block (parser.qz:1984) and, failing the alias-drop guard,
  #     `$`-joins ALL segments (parser.qz:2041-2053) → a plain IDENT, never
  #     enum_access. This is the qualified-const fix: Increment A keyed only on
  #     the RHS case and wrongly emitted enum_access for these.
  #   - UPPERCASE head (`Color::Red`, `Option::Some`) → genuine enum variant
  #     access. Legacy: skips the `_dc_is_lower` block, hits 2058 → enum.
  if cl_path_is_alias_drop(cs, h) == 0
    if cl_seg_is_upper(cl_path_head_lexeme(cs, h)) == 0
      # Lowercase head, no alias-drop → module-qualified const → `$`-join ident.
      return ast::ast_ident(a, cl_path_joined_name(cs, h), line, col)
    end
  end
  # Uppercase head, OR alias-drop shape → enum_access. bound_names = int 0
  # (renders `{}`); payloads = empty Vec (no args in Increment A). Increment C:
  # `cl_path_enum_name_aliased` drops a leading `alias::` for the 3-seg shape.
  var name = cl_path_enum_name_aliased(cs, h)
  return ast::ast_enum_access(a, name, rhs, 0, as_int(vec_new()), line, col)
end

# ===========================================================================
# Dispatch
# ===========================================================================

## Lowers a top-level declaration `c` carrying a visibility flag. `is_private`=1
## comes from either a standalone `private` section keyword (CST_PROGRAM loop) or
## a `priv <decl>` per-item prefix (CST_VISIBILITY wrapper). Legacy threads
## is_private into exactly these constructors (parser.qz ps_parse_decl):
## function (def, kinds 83/84), struct (88), enum (90), trait (92), actor (95).
## const/import/type-alias/newtype do NOT carry is_private in legacy → they fall
## through to the generic module-scope dispatch. Insertion-ordered (no reordering).
def cl_lower_toplevel_item(cs: cst::CstStorage, c: Int, a: ast::AstStorage, is_private: Int): Int
  if is_private == 0
    return cst_lower_node_ctx(cs, c, a, 1)  # module scope; common fast path
  end
  var k = cst::cst_get_kind(cs, c)
  if k == 83 or k == 84  # function (block / endless)
    return cl_lower_function(cs, c, a, 1)
  end
  if k == 88  # struct
    return cl_lower_struct(cs, c, a, 1, 0, 0, 0, 0)
  end
  if k == 90  # enum
    return cl_lower_enum(cs, c, a, 1)
  end
  if k == 92  # trait carrier (plain `trait` / `protocol` take is_private)
    var kw0 = cl_first_token_lexeme(cs, c)
    if str_eq(kw0, "trait")
      return cl_lower_trait(cs, c, a, 1)
    end
    if str_eq(kw0, "protocol")
      return cl_lower_protocol(cs, c, a, 1)
    end
    return cst_lower_node_ctx(cs, c, a, 1)
  end
  if k == 95  # actor
    return cl_lower_actor(cs, c, a, 1)
  end
  # const / import / type-alias / newtype / impl / extend / extern: legacy does
  # not thread is_private into these — lower with the generic module-scope path.
  return cst_lower_node_ctx(cs, c, a, 1)
end

## Lowers CST node `root` (in store `cs`) into AstStorage `a`, returning the AST
## root handle. Entry point used by the equivalence gate.
def cst_lower(cs: cst::CstStorage, root: Int, a: ast::AstStorage): Int
  return cst_lower_node_ctx(cs, root, a, 0)
end

## Recursive per-node lowering dispatched on CstNodeKind. Module-scope detection
## (top-level bindings → NODE_GLOBAL_VAR) is threaded via cst_lower_node_ctx; this
## wrapper defaults to non-module (body) scope.
def cst_lower_node(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  return cst_lower_node_ctx(cs, h, a, 0)
end

## Like cst_lower_node, but `module_scope`=1 when `h` is a direct child of
## CST_PROGRAM (so a `var`/const binding lowers to NODE_GLOBAL_VAR, not NODE_LET).
def cst_lower_node_ctx(cs: cst::CstStorage, h: Int, a: ast::AstStorage, module_scope: Int): Int
  if h == 0
    return 0
  end
  var k = cst::cst_get_kind(cs, h)
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)

  # --- Program root (118) ------------------------------------------------
  if k == 118  # CST_PROGRAM
    # Increment C: pre-scan imports to build the module-alias table BEFORE
    # walking items, so any `alias::Type::Variant` path (at any depth) can drop
    # its alias. Whole-program, read-only thereafter.
    cl_collect_import_aliases(cs, h)
    var items = vec_new()
    var cnt = cst::cst_child_count(cs, h)
    # `private` section state: legacy flips ps_in_private_section on a standalone
    # `private` keyword and threads is_private=1 into every SUBSEQUENT top-level
    # decl. cst_parser emits the standalone `private` as a bare CST_VISIBILITY
    # (102) marker (token child only, no structured inner). Mirror the state
    # machine: drop the marker (no AST node), then carry the flag forward.
    var in_private = 0
    var j = 0
    while j < cnt
      var c = cst::cst_get_child(cs, h, j)
      if cl_is_token(cs, c) == 0  # skip the trailing EOF token leaf
        # Standalone `private` section marker: bare CST_VISIBILITY with no
        # structured inner child. Flip state, emit nothing (matches legacy: the
        # `private` keyword produces no AST node).
        if cst::cst_get_kind(cs, c) == 102 and cl_structured_count(cs, c) == 0
          var marker = cl_first_token_lexeme(cs, c)
          if str_eq(marker, "private")
            in_private = 1
          end
          j = j + 1
        # `@cfg(...)`-false top-level decl: legacy parser.qz evaluates the cfg
        # condition at PARSE TIME and emits NO node for a false condition
        # (ps_skip_cfg_definition), EXCEPT when the skipped decl is the FINAL
        # top-level item — then legacy's cfg_skip branch hits `ps_at_end` and
        # returns an int_lit(0) placeholder (parser.qz ~8728). Mirror both: drop
        # the item, but if nothing structured follows, emit the int_lit(0).
        elsif cst::cst_get_kind(cs, c) == 101 and cl_cfg_decorator_skips(cs, c) == 1
          if cl_has_structured_after(cs, h, j) == 0
            items.push(ast::ast_int_lit(a, 0, line, col))
          end
          j = j + 1
        else
          items.push(cl_lower_toplevel_item(cs, c, a, in_private))  # module scope
          j = j + 1
        end
      else
        j = j + 1
      end
    end
    return ast::ast_program(a, as_int(items), line, col)
  end

  # --- Definitions: struct / enum / trait / impl / extend ----------------
  if k == 88  # CST_STRUCT_DEF (undecorated; flags 0)
    return cl_lower_struct(cs, h, a, 0, 0, 0, 0, 0)
  end
  if k == 129  # CST_PACKED_STRUCT (`packed struct(uN) Name ... end`)
    return cl_lower_packed_struct(cs, h, a)
  end
  if k == 90  # CST_ENUM_DEF
    return cl_lower_enum(cs, h, a, 0)
  end
  if k == 92  # CST_TRAIT_DEF carrier — shared by `trait` / `effect` / `protocol`
    var kw0 = cl_first_token_lexeme(cs, h)
    if str_eq(kw0, "effect")
      return cl_lower_effect(cs, h, a)
    end
    if str_eq(kw0, "protocol")
      # protocol bodies are a step-sequence (not function members) — distinct
      # grammar (NODE_PROTOCOL_DEF + send/recv/loop/choice steps).
      return cl_lower_protocol(cs, h, a, 0)
    end
    return cl_lower_trait(cs, h, a, 0)
  end
  if k == 93 or k == 94  # CST_IMPL_BLOCK / CST_EXTEND_BLOCK → NODE_IMPL_BLOCK
    return cl_lower_impl(cs, h, a)
  end
  if k == 95  # CST_ACTOR_DEF
    return cl_lower_actor(cs, h, a, 0)
  end

  # --- Decorator-wrapped definition (101) --------------------------------
  if k == 101  # CST_DECORATOR: [@name(...)+ , decorated_item]
    return cl_lower_decorator(cs, h, a, module_scope)
  end

  # --- Extern fn (113) ---------------------------------------------------
  if k == 113  # CST_EXTERN_FN (bodyless declaration form)
    return cl_lower_extern_fn(cs, h, a)
  end

  # --- Macro def (124) ---------------------------------------------------
  if k == 124  # CST_MACRO_DEF — `macro name(params) do <template> end`
    return cl_lower_macro_def(cs, h, a)
  end

  # --- Top-level type-alias / newtype member line (89) -------------------
  # `type Name = T` / `newtype Name = T` reach the top-level dispatch as a
  # CST_FIELD_DEF carrier (cps_parse_member_line); struct/enum FIELD members of
  # the same kind are lowered inside cl_lower_struct/_fields, NOT here.
  if k == 89  # CST_FIELD_DEF (top-level type/newtype form)
    return cl_lower_type_alias_or_newtype(cs, h, a, 0)
  end

  # --- Top-level const declaration (98) ----------------------------------
  if k == 98  # CST_CONST_DECL (`const NAME = expr`)
    return cl_lower_const_decl(cs, h, a)
  end

  # --- For-in (62) -------------------------------------------------------
  if k == 62  # CST_FOR_IN
    return cl_lower_for(cs, h, a)
  end

  # --- Functions (83 block / 84 endless) ---------------------------------
  if k == 83 or k == 84
    return cl_lower_function(cs, h, a, 0)
  end

  # --- Const def (85) — `const def f(...)` compile-time function ----------
  # CST_CONST_DEF carries child[0] = `const` token, child[1] = the structured
  # CST_FUNCTION_BLOCK/ENDLESS (cst_parser.qz:4546-4553). Legacy parser.qz
  # (ps_parse_const_decl, 7901-7904) hands a `const def` straight to
  # ps_parse_function(ps, 2): the const-ness is encoded in the is_private slot
  # as the tri-state value 2 (0=public, 1=private, 2=const), unconditionally —
  # even inside a `priv` section. So lower the inner function node with is_private=2.
  if k == 85  # CST_CONST_DEF
    var inner = 0
    var ci = 0
    var n = cst::cst_child_count(cs, h)
    while ci < n
      var c = cst::cst_get_child(cs, h, ci)
      if cl_is_token(cs, c) == 0
        var kk = cst::cst_get_kind(cs, c)
        if kk == 83 or kk == 84
          inner = c
          ci = n
        else
          ci = ci + 1
        end
      else
        ci = ci + 1
      end
    end
    if inner != 0
      return cl_lower_function(cs, inner, a, 2)
    end
    return ast::ast_ident(a, "__UNLOWERED_85", line, col)
  end

  # --- Block (43) --------------------------------------------------------
  if k == 43  # CST_BLOCK
    # A do-block EXPRESSION carrier (`result = do … end`) flattens to a single
    # NODE_BLOCK / NODE_LAMBDA (legacy ps_parse_standalone_block_body); a plain
    # statement-sequence block lowers each structured child as a statement.
    if cl_block_is_do_expr(cs, h) == 1
      return cl_lower_do_block_expr(cs, h, a)
    end
    return cl_lower_block(cs, h, a)
  end

  # --- Literals ----------------------------------------------------------
  if k == 3  # CST_INT_LIT
    var lex = cl_first_token_lexeme(cs, h)
    return ast::ast_int_lit(a, lexer::ps_parse_int_value(lex), line, col)
  end
  if k == 4  # CST_FLOAT_LIT
    return ast::ast_float_lit(a, cl_first_token_lexeme(cs, h), line, col)
  end
  if k == 5  # CST_BOOL_LIT
    var lex = cl_first_token_lexeme(cs, h)
    var v = 0
    if str_eq(lex, "true")
      v = 1
    end
    return ast::ast_bool_lit(a, v, line, col)
  end
  if k == 6  # CST_NIL_LIT
    return ast::ast_nil_lit(a, line, col)
  end
  if k == 7  # CST_STRING_LIT
    return ast::ast_string_lit(a, cl_first_token_lexeme(cs, h), line, col)
  end
  if k == 11  # CST_CHAR_LIT — legacy (parser.qz:1186-1216) folds a char literal
    # to its int code point (NODE_INT_LIT). Decode the lexeme via the shared
    # escape-table helper so the fingerprint matches legacy byte-for-byte.
    return ast::ast_int_lit(a, cl_decode_char_lexeme(cl_first_token_lexeme(cs, h)), line, col)
  end
  if k == 12  # CST_SYMBOL_LIT
    return ast::ast_symbol_lit(a, cl_first_token_lexeme(cs, h), line, col)
  end
  if k == 13  # CST_REGEX_LIT — `~r"pattern"`. The TOK_REGEX lexeme is already the
    # bare pattern text (the lexer strips the `~r"…"` wrapper), so the token
    # leaf's str1 matches what parser.qz:1312-1317 hands ast_regex_lit.
    return ast::ast_regex_lit(a, cl_first_token_lexeme(cs, h), line, col)
  end
  if k == 15  # CST_IDENT
    return ast::ast_ident(a, cl_first_token_lexeme(cs, h), line, col)
  end

  # --- Qualified path (16): a::b / Color::Red ----------------------------
  if k == 16  # CST_PATH
    return cl_lower_path(cs, h, a, line, col)
  end

  # --- Paren: drop, lower inner (17) -------------------------------------
  if k == 17  # CST_PAREN: () unit / (e) grouping / (a, b) | (e,) tuple
    return cl_lower_paren(cs, h, a)
  end

  # --- Binary (19) / Unary (18) ------------------------------------------
  if k == 19  # CST_BINARY: children = [left, op_tok, right]
    var l = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var r = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
    # Nil-coalesce `??` and pipe `|>` are both built by cst_parser as CST_BINARY
    # with op discriminant 0 (CST_OP_NONE) — the operator TOKEN lexeme (child 1)
    # is the only signal. Legacy lowers `a ?? b` to ast_binary(op 22 =
    # OP_NIL_COALESCE) (parser.qz:3792-3800); cst_op_to_ast_op(0) would wrongly
    # yield op 0. Resolve `??` by lexeme here.
    var bop = cst_op_to_ast_op(cst::cst_get_op(cs, h))
    if cst::cst_get_op(cs, h) == 0
      var optok = cst::cst_get_child(cs, h, 1)
      if cl_is_token(cs, optok) == 1 and str_eq(cst::cst_get_str1(cs, optok), "??") == 1
        bop = 22  # OP_NIL_COALESCE
      end
      # Regex match operators: cst_parser builds `a =~ b` / `a !~ b` / `a =~? b`
      # as disc-0 CST_BINARY (cst_parser.qz:2512-2515; "no dedicated CstOp;
      # round-trips via token"). Legacy maps the op TOKEN to dedicated AST op
      # codes (parser.qz:3702-3707): `=~` → 25, `!~` → 26, `=~?` → 24. Without
      # this, cst_op_to_ast_op(0) yields op 0 (OP_ADD) and the match miscompiles.
      if cl_is_token(cs, optok) == 1 and str_eq(cst::cst_get_str1(cs, optok), "=~") == 1
        bop = 25  # OP_MATCH
      end
      if cl_is_token(cs, optok) == 1 and str_eq(cst::cst_get_str1(cs, optok), "!~") == 1
        bop = 26  # OP_NOMATCH
      end
      if cl_is_token(cs, optok) == 1 and str_eq(cst::cst_get_str1(cs, optok), "=~?") == 1
        bop = 24  # OP_MATCH_CAPTURE
      end
      # Pipe `a |> f` / `a |> f(args)`: cst_parser also builds this as a disc-0
      # CST_BINARY (lexeme `|>` is the only signal). Legacy DESUGARS it — it is
      # NOT an ast_binary (parser.qz:3768-3789). `a |> f(args)` prepends the lhs
      # to the call's existing args (reusing the NODE_CALL); `a |> f` (any
      # non-call rhs) wraps as a plain ast_call(f, [a]) (is_ufcs=0).
      if cl_is_token(cs, optok) == 1 and str_eq(cst::cst_get_str1(cs, optok), "|>") == 1
        if ast::ast_get_kind(a, r) == 9
          var pipe_args = vec_new()
          pipe_args.push(l)
          var existing = ast::ast_get_children(a, r)
          for pa_i in 0..existing.size
            pipe_args.push(existing[pa_i])
          end
          ast::ast_set_children(a, r, pipe_args)
          return r
        end
        var pa = vec_new()
        pa.push(l)
        return ast::ast_call(a, r, as_int(pa), line, col)
      end
    end
    return ast::ast_binary(a, l, bop, r, line, col)
  end
  if k == 18  # CST_UNARY: prefix [op_tok, operand]; postfix force-unwrap [operand, !]
    var operand = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    # Postfix `expr!` force-unwrap: cst_parser builds it as a CST_UNARY whose
    # FIRST child is the structured operand and last child is the `!` token
    # (every prefix form — `!`/`not`/`-`/`~` — pushes the op token FIRST and sets
    # the op slot). Legacy lowers `expr!` to the $unwrap macro expansion, NOT a
    # unary op: parser.qz:3392-3398 → ast_macro_call("unwrap", [expr]).
    if cl_is_token(cs, cst::cst_get_child(cs, h, 0)) == 0
      var uw_args = vec_new()
      uw_args.push(operand)
      return ast::ast_macro_call(a, "unwrap", as_int(uw_args), line, col)
    end
    return ast::ast_unary(a, cst_op_to_ast_op(cst::cst_get_op(cs, h)), operand, line, col)
  end

  # --- Func-ref / borrow (33) --------------------------------------------
  # `&name` / `&mut name` (parser.qz:3410-3429 ast_func_ref(name, is_mut)).
  # Children: `[amp_tok, (mut_tok)?, operand]`. is_mut is 1 iff a `mut` token
  # leaf is present; the name is the operand's sole ident lexeme (legacy only
  # accepts a bare ident after `&`). The operand is structured child 0.
  if k == 33  # CST_FUNC_REF
    var fr_is_mut = 0
    var fci = 0
    var fcn = cst::cst_child_count(cs, h)
    while fci < fcn
      var fc = cst::cst_get_child(cs, h, fci)
      if cl_is_token(cs, fc) == 1 and str_eq(cst::cst_get_str1(cs, fc), "mut") == 1
        fr_is_mut = 1
      end
      fci = fci + 1
    end
    var fr_operand = cl_structured_child(cs, h, 0)
    # WS4 Step 0 — PROJECTED borrow. When the operand is a field-access
    # (`&mut p.f`) or an index (`&mut a[i]`), the base-only NODE_FUNC_REF (which
    # keeps only the first token's lexeme) would DROP the projection. Instead
    # recursively lower the operand place and wrap it in a dedicated NODE_BORROW
    # that carries the full projection subtree, so the exclusivity checker can
    # reason about disjoint fields / IndexDyn. Bare-ident operands are UNCHANGED:
    # they still lower to NODE_FUNC_REF byte-identically (gate-0-inert — no
    # first-party code uses `&mut p.f`/`&mut a[i]` today).
    var fr_ok = cst::cst_get_kind(cs, fr_operand)
    if fr_ok == 23 or fr_ok == 24 or fr_ok == 25  # CST_FIELD_ACCESS / CST_SAFE_FIELD_ACCESS / CST_INDEX
      var fr_place = cst_lower_node(cs, fr_operand, a)
      return ast::ast_borrow(a, fr_place, fr_is_mut, line, col)
    end
    var fr_name = cl_first_token_lexeme(cs, fr_operand)
    return ast::ast_func_ref(a, fr_name, fr_is_mut, line, col)
  end

  # --- Call (21) ---------------------------------------------------------
  if k == 21  # CST_CALL: children = [callee, arg_list]
    var callee_node = cl_structured_child(cs, h, 0)
    var alist = cl_child_of_kind(cs, h, 119)  # CST_ARG_LIST
    # static_assert(cond, "msg") → dedicated NODE_STATIC_ASSERT(70), NOT a plain
    # ast_call. Legacy parser.qz:ps_parse_static_assert (8094-8104) lowers ONLY the
    # condition expr to an AST node and reads the message lexeme DIRECTLY off the
    # string token (NO message AST node is allocated). Handle this BEFORE lowering
    # the arg list so we don't allocate a stray NODE_STRING_LIT for the message —
    # that extra node desynchronizes raw-handle fingerprint fields (e.g. a fn
    # guard `:gd<N>`) for every later node. The callee must be the bare CST_IDENT
    # lexeme "static_assert" with exactly two structured args.
    if callee_node != 0 and cst::cst_get_kind(cs, callee_node) == 15
      if cl_first_token_lexeme(cs, callee_node) == "static_assert" and alist != 0 and cl_structured_child(cs, alist, 1) != 0 and cl_structured_child(cs, alist, 2) == 0
        var sa_cond = cst_lower_node(cs, cl_structured_child(cs, alist, 0), a)
        var sa_msg = cl_first_token_lexeme(cs, cl_structured_child(cs, alist, 1))
        return ast::ast_static_assert(a, sa_cond, sa_msg, line, col)
      end
    end
    var args = cl_lower_arg_list(cs, alist, a)
    # R6.1: fold a trailing `do…end` / `{…}` block as the call's last arg
    # (parser.qz:2895-2898). Done up front so the lambda rides along into
    # whichever return fires (ast_call / turbofish / enum-access) — a single
    # placement matching legacy's `args.push` onto the call's children.
    cl_fold_trailing_block(cs, h, args, a)
    if callee_node != 0 and cst::cst_get_kind(cs, callee_node) == 105
      # Turbofish call `name<T>(...)` / `recv.method<T>(...)`: the callee child is
      # a CST_TYPE_ARG_LIST whose child[0] is the real callee (ident or
      # field-access). Legacy builds ast_call_with_type_arg on that callee — it
      # treats a turbofish method call as a TYPED call on the field-access, NOT
      # UFCS, so do not prepend the receiver.
      var tf_callee = cst_lower_node(cs, cl_structured_child(cs, callee_node, 0), a)
      var type_arg = cl_render_call_type_args(cs, callee_node)
      return ast::ast_call_with_type_arg(a, tf_callee, type_arg, as_int(args), line, col)
    end
    # Increment B — enum_access call-absorption. `Color::Red(x)` parses as
    # CST_CALL[ callee=CST_PATH(uppercase RHS), arg_list ]. Legacy folds the
    # trailing `(args)` INTO the enum_access payload (parser.qz:2100-2121): one
    # ast_enum_access(name, variant, 0, args), NOT ast_call(enum_access, args).
    # Only an uppercase-RHS path callee absorbs; a lowercase-RHS path
    # (`mod::func(x)`) lowers its callee to ast_ident("mod$func") and falls
    # through to the ordinary ast_call below.
    if callee_node != 0 and cst::cst_get_kind(cs, callee_node) == 16  # CST_PATH
      var path_rhs = cl_path_seg_lexeme(cs, callee_node)
      if cl_path_rhs_is_lower(path_rhs) == 0
        # Uppercase RHS — but the enum-vs-const choice still keys on the HEAD
        # case (same discriminator as cl_lower_path). Only the enum shape
        # absorbs the trailing call into the payload:
        #   - alias-drop shape (`alias::Type::Variant(args)`) → enum_access.
        #   - UPPERCASE head (`Color::Red(x)`) → enum_access (Increment B).
        #   - LOWERCASE head, no alias-drop (`terminal::KEY_TAB()`) → a
        #     module-qualified zero-arg const accessor, NOT an enum: legacy
        #     `$`-joins to `terminal$KEY_TAB` ident then wraps the ordinary
        #     ast_call. Fall through to the plain ast_call below.
        var absorb = 0
        if cl_path_is_alias_drop(cs, callee_node) == 1
          absorb = 1
        elsif cl_seg_is_upper(cl_path_head_lexeme(cs, callee_node)) == 1
          absorb = 1
        end
        if absorb == 1
          # enum_access. bound_names = int 0 (renders `{}`); payloads = the
          # already-lowered call args Vec (reuse, don't re-lower). Increment C:
          # alias-drop on the 3-seg `alias::Type::Variant(args)` shape.
          var ea_name = cl_path_enum_name_aliased(cs, callee_node)
          return ast::ast_enum_access(a, ea_name, path_rhs, 0, as_int(args), line, col)
        end
      end
    end
    var callee = cst_lower_node(cs, callee_node, a)
    var plain_call = ast::ast_call(a, callee, as_int(args), line, col)
    # Call-site named arguments (`f(name: v, ...)`): thread the parallel name
    # list onto the call's `op` slot, exactly as legacy parser.qz:3365-3366 does
    # (only when at least one arg is named — cl_arg_names returns 0 otherwise).
    var an = cl_arg_names(cs, alist)
    if an != 0
      ast::ast_call_set_arg_names(a, plain_call, an)
    end
    return plain_call
  end

  # --- Method call (22) --------------------------------------------------
  if k == 22  # CST_METHOD_CALL: recv.m(args) → UFCS / assoc-fn ast_call
    return cl_lower_method_call(cs, h, a)
  end

  # --- Struct init (26) --------------------------------------------------
  if k == 26  # CST_STRUCT_INIT: Type { f: v } / Type<Args> { f: v } / { ...base, f: v }
    return cl_lower_struct_init(cs, h, a)
  end

  # --- Range (20) / compound-assign (50) / cast (125) --------------------
  if k == 20  # CST_RANGE: a..b / a...b → ast_binary(op 21/23)
    return cl_lower_range(cs, h, a)
  end
  if k == 50  # CST_COMPOUND_ASSIGN: lhs OP= rhs → desugared assign + binary
    return cl_lower_compound_assign(cs, h, a)
  end
  if k == 125  # CST_CAST: expr as Type → ast_type_cast
    return cl_lower_cast(cs, h, a)
  end

  # --- Field assign (52) / index assign (51) -----------------------------
  # cps_parse_rhs_value / cps_parse_stmt classify `lhs = rhs` by lhs kind:
  # field-access → 52, index → 51. Children = [lhs, =, rhs]; structured
  # children are [lhs, rhs]. Lower the lhs to its AST form (NODE_FIELD_ACCESS
  # / NODE_INDEX), then pull obj/field or array/index out of it — exactly the
  # extraction cl_lower_compound_assign uses, so field-name interning matches.
  if k == 52  # CST_FIELD_ASSIGN: obj.field = value
    var fa_lhs = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var fa_val = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
    return ast::ast_field_assign(a, ast::ast_get_left(a, fa_lhs), ast::ast_get_str1(a, fa_lhs), fa_val, line, col)
  end
  if k == 51  # CST_INDEX_ASSIGN: array[index] = value
    var ia_lhs = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var ia_val = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
    return ast::ast_index_assign(a, ast::ast_get_left(a, ia_lhs), ast::ast_get_right(a, ia_lhs), ia_val, line, col)
  end

  # --- Await / go / async carrier (42) -----------------------------------
  # cst_parser allocs kind 42 (RHS position) for THREE surface forms,
  # discriminated by the leading keyword: `await e`, `go e`/`async e`, and
  # `go do … end`. See cl_lower_go_async_carrier. The bare-statement form lands
  # on CST_EXPR_STMT (44) instead (cps_parse_kw_optexpr). The `for await`
  # async-iterator form lowers to NODE_FOR_AWAIT (86) but is parsed as a CST_FOR
  # shape (cps_parse_for), NOT this carrier — handled directly in cl_lower_for
  # (the leading-`await` discriminator), not here.
  if k == 42  # CST_AWAIT
    var aw_first = cl_first_token_lexeme(cs, h)
    if str_eq(aw_first, "await") or str_eq(aw_first, "go") or str_eq(aw_first, "async")
      return cl_lower_go_async_carrier(cs, h, aw_first, 0, a)
    end
    return ast::ast_ident(a, "__UNLOWERED_42", line, col)
  end

  # --- Try-prefix propagation (41) ---------------------------------------
  # `try <expr>` (no `catch`) — the Result-propagation prefix. cst_parser
  # captures CST_TRY_EXPR(41) with children = [try_kw_token, expr_node]; if a
  # `catch` followed it would have been re-kinded to CST_TRY_CATCH(74) instead,
  # so a bare 41 is always the prefix-only form. Legacy parser.qz:5288 emits
  # `ast_try_expr(s, body, line, col)` (NODE_TRY_EXPR=17, body in `left`); we
  # mirror that exactly: lower the single structured child and wrap it.
  if k == 41  # CST_TRY_EXPR
    var try_body = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    return ast::ast_try_expr(a, try_body, line, col)
  end

  # --- Quote / unquote macro template forms (126/127/128) ----------------
  # `quote do <stmts> end` — macro template body. Legacy ps_parse_quote_block
  # parses the body statements into an ast_block then wraps in ast_quote
  # (NODE_QUOTE, body in `left`). cst_parser captures CST_QUOTE(126) with the
  # body as a structured CST_BLOCK(43) child; lower it via cl_lower_block (which
  # reproduces legacy's per-statement ps_parse_stmt → ast_block) then wrap.
  if k == 126  # CST_QUOTE
    var q_blk = cl_structured_child(cs, h, 0)
    var q_body = 0
    if q_blk != 0
      q_body = cl_lower_block(cs, q_blk, a)
    else
      q_body = ast::ast_block(a, as_int(vec_new()), line, col)
    end
    return ast::ast_quote(a, q_body, line, col)
  end
  # `unquote(expr)` — splice a macro argument. Legacy ps_parse_unquote_expr emits
  # ast_unquote(expr) (NODE_UNQUOTE, expr in `left`). The single structured child
  # is the inner expression.
  if k == 127  # CST_UNQUOTE
    var uq_inner = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    return ast::ast_unquote(a, uq_inner, line, col)
  end
  # `unquote_each(param, "sep")` — variadic splice. Legacy ps_parse_unquote_each_expr
  # builds ast_unquote_each(param_ident, separator_lexeme, body=0). cst_parser
  # captures children = [unquote_each, (, param IDENT, comma, sep STRING, )].
  # Extract the param name from the first IDENT token and the separator from the
  # STRING token; mirror legacy by wrapping the param in an ast_ident.
  if k == 128  # CST_UNQUOTE_EACH
    var ue_param = ""
    var ue_sep = ""
    var ue_cnt = cst::cst_child_count(cs, h)
    var ue_j = 0
    var ue_seen_ident = 0
    while ue_j < ue_cnt
      var ue_c = cst::cst_get_child(cs, h, ue_j)
      if cl_is_token(cs, ue_c) == 1
        var ue_lex = cst::cst_get_str1(cs, ue_c)
        var ue_kind = cst::cst_get_kind(cs, ue_c)
        # Skip the leading `unquote_each` keyword and the `(`/`,`/`)` punctuation.
        if str_eq(ue_lex, "unquote_each") == 0 and str_eq(ue_lex, "(") == 0 and str_eq(ue_lex, ")") == 0 and str_eq(ue_lex, ",") == 0
          if ue_seen_ident == 0
            ue_param = ue_lex
            ue_seen_ident = 1
          else
            ue_sep = ue_lex
          end
        end
      end
      ue_j = ue_j + 1
    end
    var ue_ident = ast::ast_ident(a, ue_param, line, col)
    return ast::ast_unquote_each(a, ue_ident, ue_sep, 0, line, col)
  end

  # --- Arrow lambda (36) -------------------------------------------------
  # Standalone arrow-lambda EXPRESSION: `-> body` (form 1) and `x -> body` /
  # `x: T -> body` (form 3). Form 2 (`(…) -> body`, parenthesized params) is
  # deferred — cl_lower_arrow_lambda returns 0 for it, falling through to the
  # __UNLOWERED_36 placeholder below.
  if k == 36  # CST_LAMBDA_ARROW
    var lam36 = cl_lower_arrow_lambda(cs, h, a)
    if lam36 != 0
      return lam36
    end
    return ast::ast_ident(a, "__UNLOWERED_36", line, col)
  end

  # --- Is-check (67) -----------------------------------------------------
  # `x is Variant` / `x is Variant(binds)` (legacy parser.qz:3649-3692).
  # Children = [subject, is_kw, variant_tok, ...balanced (binds)...]. The
  # no-bind form lowers to ast_is_check with bound_names=0 (fp_ids renders 0 as
  # `{}`, matching legacy's int-0 default). The bind form (`is Some(v)`) lowers
  # with bound_names = Vec of as_int(interned binding name) — see
  # cl_is_bound_names, mirroring legacy's `bn.push(as_int(lexeme))`.
  if k == 67  # CST_IS_EXPR
    var is_subject = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var is_variant = cl_is_variant_name(cs, h)
    var is_bn = cl_is_bound_names(cs, h)
    return ast::ast_is_check(a, is_subject, is_variant, is_bn, line, col)
  end

  # --- Macro call (40) ---------------------------------------------------
  # `$name(args...)` — `$try`, `$unwrap`, `$assert`, `$debug` (legacy
  # parser.qz:1925-1962 → ast_macro_call(name, args)). cps_parse_dollar captures
  # `[$ tok, name tok, CST_ARG_LIST(119)]`; the macro name is the `$`-less
  # lexeme (cl_macro_name) and the args are the lowered CST_ARG_LIST children.
  # Mirrors the postfix `expr!` precedent (ast_macro_call(a, "unwrap", …) at the
  # unary arm) for the args-vec + as_int convention. Capture vars (`$0`..`$9`)
  # are never reached here in legacy-passing files — legacy errors on a non-IDENT
  # name — so a digit name (no arg list) is left __UNLOWERED_40 rather than
  # synthesizing a spurious macro call.
  if k == 40  # CST_MACRO_CALL
    var mc_name = cl_macro_name(cs, h)
    var mc_alist = cl_child_of_kind(cs, h, 119)  # CST_ARG_LIST
    if str_byte_len(mc_name) > 0 and mc_alist != 0
      var mc_args = cl_lower_arg_list(cs, mc_alist, a)
      return ast::ast_macro_call(a, mc_name, as_int(mc_args), line, col)
    end
    return ast::ast_ident(a, "__UNLOWERED_40", line, col)
  end

  # --- Try-catch (74) ----------------------------------------------------
  # `try <body> catch <pat> <handler> [end]` (legacy parser.qz:5269-5350 →
  # ast_try_catch(body, pattern, handler), NODE_TRY_CATCH=63: body in `left`,
  # pattern in `extra`, handler in `right`). The bare prefix `try <expr>` (no
  # catch) is CST_TRY_EXPR(41), handled above. cps_parse_try captures structured
  # children [body, handler]; the catch pattern is token leaves (cl_lower_catch_
  # pattern). Legacy parses the handler as a SINGLE expression (ps_parse_expr),
  # so a CST_BLOCK(43) handler (multi-line block form) has no legacy equivalent —
  # leave it __UNLOWERED_74 (such files legacy-fail or diverge regardless).
  if k == 74  # CST_TRY_CATCH
    var tc_body = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var tc_handler_node = cl_structured_child(cs, h, 1)
    if tc_handler_node == 0
      return ast::ast_ident(a, "__UNLOWERED_74", line, col)
    end
    # Block-form handler `catch Pat \n <stmts> end`: cps_parse_try captures the
    # handler as a CST_BLOCK(43) (cps_parse_block_until). Legacy ps_parse_try_catch
    # (parser.qz:5340) parses the handler as a SINGLE expression (ps_parse_expr),
    # so the only block shape it can represent is exactly one expression statement.
    # Reduce that to its inner expr (legacy handler = the bare expr). Multi-statement
    # or non-expr handler blocks have no legacy equivalent → leave __UNLOWERED_74.
    if cst::cst_get_kind(cs, tc_handler_node) == 43
      var inner = cl_try_block_handler_expr(cs, tc_handler_node)
      if inner == 0
        return ast::ast_ident(a, "__UNLOWERED_74", line, col)
      end
      tc_handler_node = inner
    end
    var tc_pattern = cl_lower_catch_pattern(cs, h, a)
    var tc_handler = cst_lower_node(cs, tc_handler_node, a)
    return ast::ast_try_catch(a, tc_body, tc_pattern, tc_handler, line, col)
  end

  # --- Interpolated string (8) -------------------------------------------
  if k == 8  # CST_INTERP_STRING
    return cl_lower_interp_string(cs, h, a)
  end

  # --- Import (111) / visibility-wrapped import (102) --------------------
  if k == 111  # CST_IMPORT
    return cl_lower_import(cs, h, a)
  end
  # --- C import (116) ----------------------------------------------------
  # `cimport "header.h"` — @cImport convenience decl (parser.qz:7814-7825 →
  # ast_c_import(header_name)). The header NAME is the legacy string-token lexeme
  # (already unquoted by the lexer). cps_parse_c_import captures children
  # `[cimport_kw, CST_STRING_LIT(7)]`; the string-lit's sole token leaf carries the
  # unquoted header lexeme. Mirrors ps_parse_c_import: header from the string lit.
  if k == 116  # CST_C_IMPORT
    var ci_hdr = cl_structured_child(cs, h, 0)
    var ci_name = ""
    if ci_hdr != 0
      ci_name = cl_first_token_lexeme(cs, ci_hdr)
    end
    return ast::ast_c_import(a, ci_name, line, col)
  end
  if k == 102  # CST_VISIBILITY: `pub import ...` / `pub <decl>` / `priv <decl>`
    var inner = cl_structured_child(cs, h, 0)
    var marker = cl_first_token_lexeme(cs, h)
    if inner != 0 and cst::cst_get_kind(cs, inner) == 111  # wrapped import
      var imp = cl_lower_import(cs, inner, a)
      if str_eq(marker, "pub")
        ast::ast_import_set_pub(a, imp, 1)
      end
      return imp
    end
    # `priv <decl>` → is_private=1 on the wrapped definition. `pub <decl>` on a
    # non-import is a no-op for the fingerprinted scalars (visibility lives in
    # is_private; pub defs have is_private=0). Route the wrapped item through the
    # shared top-level dispatch so EVERY private-capable kind (def, struct, enum,
    # trait, actor) carries the flag identically to the standalone `private`
    # section path — no per-kind drift.
    var is_priv = 0
    if str_eq(marker, "priv")
      is_priv = 1
    end
    if inner != 0
      return cl_lower_toplevel_item(cs, inner, a, is_priv)
    end
    return ast::ast_ident(a, "__UNLOWERED_102", line, col)
  end

  # --- Field access (23 / 24) -------------------------------------------
  if k == 23 or k == 24  # CST_FIELD_ACCESS / CST_SAFE_FIELD_ACCESS
    # children = [recv, dot_tok, name_tok]; the field name is the last token.
    # G5/G9: a paren-FREE method call with a trailing block — `v.map { it*2 }`,
    # `xs.each do x -> … end` — parses as a CST_FIELD_ACCESS whose extra children
    # are the block marker (`{`/`do`), header, CST_BLOCK body and closer (`}`/end).
    # Lower it the same way cl_lower_method_call does: a zero-arg UFCS call with
    # the trailing block folded as the lambda last arg (legacy parser.qz:3008).
    if cl_node_has_trailing_block(cs, h) == 1
      # Binary DSL `value.with { field = expr, ... }` immutable update (STEP 5):
      # `.with` + a CURLY trailing block is NOT a UFCS method call — it builds a
      # NODE_BINARY_WITH(base=receiver, children=[NODE_ASSIGN...]) gated by
      # typecheck to a packed-struct receiver (QZ0958/QZ0959). Mirrors legacy
      # parser.qz:2933-2958. A `do…end` block on `with` (no legacy form) still
      # falls through to the ordinary trailing-block UFCS fold below.
      if str_eq(cl_field_name(cs, h), "with") == 1 and cl_trailing_block_is_curly(cs, h) == 1
        var wbase = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
        var wentries = cl_collect_with_entries(cs, h, a)
        return ast::ast_binary_with(a, wbase, as_int(wentries), line, col)
      end
      var recv_b = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
      var field_b = cl_field_name(cs, h)  # stops at the block marker (see below)
      var args_b = vec_new()
      args_b.push(recv_b)
      cl_fold_trailing_block(cs, h, args_b, a)
      var callee_b = ast::ast_ident(a, field_b, line, col)
      var call_b = ast::ast_call(a, callee_b, as_int(args_b), line, col)
      ast::ast_call_set_is_ufcs(a, call_b, 1)
      return call_b
    end
    var recv = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var field = cl_field_name(cs, h)
    if k == 24
      return ast::ast_safe_field_access(a, recv, field, line, col)
    end
    return ast::ast_field_access(a, recv, field, line, col)
  end

  # --- Index (25) --------------------------------------------------------
  if k == 25  # CST_INDEX: children = [base, [, index..., ]]
    var base = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var idx = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
    return ast::ast_index(a, base, idx, line, col)
  end

  # --- Array literal (29) ------------------------------------------------
  if k == 29  # CST_ARRAY_LIT
    # Structured form: children = [CST_ELEM_LIST(120)] whose structured children
    # are the elements (full exprs / CST_STRUCT_SPREAD 27). Comprehension forms
    # fall back to a verbatim token bag (no CST_ELEM_LIST, no structured
    # children) → empty NODE_ARRAY, matching the prior all-verbatim path.
    var elems = vec_new()
    var elist = cl_child_of_kind(cs, h, 120)  # CST_ELEM_LIST
    var container = h
    if elist != 0
      container = elist
    end
    var cnt = cst::cst_child_count(cs, container)
    var j = 0
    while j < cnt
      var c = cst::cst_get_child(cs, container, j)
      if cl_is_token(cs, c) == 0
        var ck = cst::cst_get_kind(cs, c)
        if ck == 27  # CST_STRUCT_SPREAD reused for `...expr` array spread
          var sinner = cst_lower_node(cs, cl_structured_child(cs, c, 0), a)
          elems.push(ast::ast_spread(a, sinner, cst::cst_get_line(cs, c), cst::cst_get_col(cs, c)))
        else
          elems.push(cst_lower_node(cs, c, a))
        end
      end
      j = j + 1
    end
    return ast::ast_array(a, as_int(elems), line, col)
  end

  # --- Brace lambda (34) -------------------------------------------------
  # Standalone curly-block / brace lambda `{ [header ->] <stmts> }`. The CST
  # carries `{`(child 0, marker) + optional header tokens + a CST_BLOCK(43) body
  # + `}`. Lowered exactly like a trailing curly block (cl_fold_trailing_block):
  # curly form synthesizes an implicit `it` when headerless. Mirrors legacy
  # ps_parse_standalone_curly_block / the `{ it … }` implicit-it lambda.
  if k == 34  # CST_LAMBDA_BRACE
    # A standalone curly `{ … }` in expression position is one of THREE legacy
    # forms (parser.qz): (a) explicit lambda `{ [x[: T]…] -> body }`; (b)
    # implicit-`it` lambda `{ it <op> … }` (parser.qz:1676-1703 — single bare
    # expr whose leftmost operand is `it`); (c) a BLOCK EXPRESSION `{ var…/if…/
    # for…/stmts; lastval }` (ps_parse_standalone_curly_block → ast_block when
    # nullary-no-arrow, parser.qz:2678-2681). The prior code unconditionally
    # built a lambda, miscompiling form (c) into a closure value. Gate exactly
    # like legacy: a present `->` header → explicit lambda; otherwise lower the
    # body and try implicit-`it` injection — if `it` was injected it is form
    # (b) (lambda), else it is form (c) (a plain block expression).
    var bl_body = cl_child_of_kind(cs, h, 43)  # CST_BLOCK
    var bl_has_arrow = cl_has_token_lexeme(cs, h, "->")
    var bl_block = 0
    if bl_body != 0
      bl_block = cl_lower_block(cs, bl_body, a)
    else
      bl_block = ast::ast_block(a, as_int(vec_new()), line, col)
    end
    if bl_has_arrow == 1
      # (a) explicit lambda: header params + last-stmt implicit return.
      var bl_params = cl_lower_do_header(cs, h, 0, 1, line, col, a)
      cl_apply_lambda_implicit_return(a, bl_block)
      return ast::ast_lambda(a, as_int(bl_params), "", bl_block, line, col)
    end
    # No `->`: distinguish implicit-`it` lambda (b) from block expression (c).
    # cl_maybe_inject_implicit_it appends an `it` param iff the body's first
    # statement uses `it` as its leftmost operand (mirrors parser.qz:1686-1701).
    var bl_iparams = cl_maybe_inject_implicit_it(a, vec_new(), bl_block, line, col)
    if bl_iparams.size > 0
      cl_apply_lambda_implicit_return(a, bl_block)
      return ast::ast_lambda(a, as_int(bl_iparams), "", bl_block, line, col)
    end
    # (c) Plain block expression: the body block IS the value (NO lambda wrap,
    # NO implicit return — last expr is the block's value, parser.qz:2680).
    return bl_block
  end

  # --- Set literal / set comprehension (30) ------------------------------
  # CST_SET_LIT carries `{` + element exprs (+ separating `,` tokens), OR — when a
  # `for` token is present — a set comprehension `{ expr for VAR in ITER [step e]
  # [if c] }` (cps_finish_set_literal reuses kind 30 as the comprehension
  # carrier). Discriminate by a present `for` token. Mirrors legacy
  # ast_set_literal / ast_set_comp.
  if k == 30  # CST_SET_LIT
    if cl_has_token_lexeme(cs, h, "for") == 1
      return cl_lower_set_comp(cs, h, a, line, col)
    end
    var set_elems = vec_new()
    var se_n = cst::cst_child_count(cs, h)
    var se_j = 0
    while se_j < se_n
      var se_c = cst::cst_get_child(cs, h, se_j)
      if cl_is_token(cs, se_c) == 0
        set_elems.push(cst_lower_node(cs, se_c, a))
      end
      se_j = se_j + 1
    end
    return ast::ast_set_literal(a, as_int(set_elems), line, col)
  end

  # --- Map literal (31) --------------------------------------------------
  # CST_MAP_LIT carries `{` + CST_MAP_ENTRY(32) children (+ separating `,`
  # tokens). Each entry is [key, sep(`=>`/`:`), val]; an `ident:` shorthand key is
  # a bare ident TOKEN (→ string literal), all other keys are structured exprs.
  # Mirrors legacy ast_map_lit(keys, values).
  if k == 31  # CST_MAP_LIT
    var mkeys = vec_new()
    var mvals = vec_new()
    var ml_n = cst::cst_child_count(cs, h)
    var ml_j = 0
    while ml_j < ml_n
      var ml_c = cst::cst_get_child(cs, h, ml_j)
      if cl_is_token(cs, ml_c) == 0 and cst::cst_get_kind(cs, ml_c) == 32  # CST_MAP_ENTRY
        mkeys.push(cl_lower_map_key(cs, ml_c, a))
        mvals.push(cl_lower_map_val(cs, ml_c, a))
      end
      ml_j = ml_j + 1
    end
    return ast::ast_map_lit(a, as_int(mkeys), as_int(mvals), line, col)
  end

  # --- Map comprehension (38) --------------------------------------------
  # CST_MAP_COMP carries `{` + key-expr + `=>` + val-expr + `for VAR in ITER
  # [step e] [if c]` + `}`. Mirrors legacy ast_map_comp.
  if k == 38  # CST_MAP_COMP
    return cl_lower_map_comp(cs, h, a, line, col)
  end

  # --- List comprehension (37) -------------------------------------------
  if k == 37  # CST_LIST_COMP
    # Children (source order): [, elem-expr, for, VAR(ident), in, iterable-expr,
    # [step, step-expr], [if, cond-expr], ].  Structured children: elem=0,
    # iterable=1; optional step/cond exprs follow and are discriminated by the
    # `step`/`if` keyword token that immediately precedes each one. var_name is
    # the ident token right after the `for` keyword. Mirrors legacy
    # ast_list_comp (left=elem, str1=var, right=iter, extra=cond, int_val=step).
    var lc_elem = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var lc_iter = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
    var lc_var = ""
    var lc_step = 0
    var lc_cond = 0
    var lc_n = cst::cst_child_count(cs, h)
    var lc_j = 0
    var saw_for = 0       # next ident token after `for` is the loop var
    var pending = 0       # 0=none, 1=next structured child is step, 2=is cond
    while lc_j < lc_n
      var lc_c = cst::cst_get_child(cs, h, lc_j)
      if cl_is_token(cs, lc_c) == 1
        var lc_lex = cst::cst_get_str1(cs, lc_c)
        if saw_for == 1 and str_eq(lc_var, "")
          lc_var = lc_lex
          saw_for = 0
        elsif str_eq(lc_lex, "for")
          saw_for = 1
        elsif str_eq(lc_lex, "step")
          pending = 1
        elsif str_eq(lc_lex, "if")
          pending = 2
        end
      else
        if pending == 1
          lc_step = cst_lower_node(cs, lc_c, a)
          pending = 0
        elsif pending == 2
          lc_cond = cst_lower_node(cs, lc_c, a)
          pending = 0
        end
      end
      lc_j = lc_j + 1
    end
    var lc_node = ast::ast_list_comp(a, lc_elem, lc_var, lc_iter, lc_cond, line, col)
    if lc_step > 0
      ast::ast_set_int_val(a, lc_node, lc_step)
    end
    return lc_node
  end

  # --- Statements --------------------------------------------------------
  if k == 45  # CST_RETURN: children = [return_kw, (expr)?]
    # Bare `return` must lower to ast_return(-1): legacy ps_parse_return
    # (parser.qz:4512) uses -1 as the no-value sentinel, which the
    # typechecker reads as "valueless return" (typecheck_walk.qz:4598).
    # Defaulting to 0 here mis-reads AST node 0 as a real return value →
    # spurious QZ0172 ('return <value>' in generator) and cascade.
    var v = cl_structured_child(cs, h, 0)
    var vast = 0 - 1
    if v != 0
      vast = cst_lower_node(cs, v, a)
    end
    return ast::ast_return(a, vast, line, col)
  end
  if k == 44  # CST_EXPR_STMT
    # Two producers (cst_parser.qz): a plain expr statement carries just the
    # expression as its sole structured child; a keyword-prefixed statement
    # (`go f()` / `async f()` / `await e`, via cps_parse_kw_optexpr) carries the
    # keyword token first + an operand/do-block. Discriminate by the leading
    # token: for go/async/await build the carrier node, then wrap in expr_stmt.
    var es_first = cl_first_token_lexeme(cs, h)
    if str_eq(es_first, "go") or str_eq(es_first, "async")
      # Statement-level go/async are NOT wrapped in NODE_EXPR_STMT — legacy
      # ps_parse_go/async are intercepted in ps_parse_stmt (parser.qz:5900-5901)
      # and return the carrier node directly into the block.
      return cl_lower_go_async_carrier(cs, h, es_first, 1, a)
    end
    if str_eq(es_first, "await")
      # Statement-level await is NOT intercepted: it falls to
      # ps_parse_assign_or_call, which wraps the bare expr in NODE_EXPR_STMT
      # (parser.qz:5773). So `await e` as a statement IS wrapped.
      var aw_carrier = cl_lower_go_async_carrier(cs, h, es_first, 1, a)
      return ast::ast_expr_stmt(a, aw_carrier, line, col)
    end
    var e = cl_structured_child(cs, h, 0)
    var east = 0
    if e != 0
      east = cst_lower_node(cs, e, a)
    end
    # static_assert is a STATEMENT-level form in legacy (ps_parse_static_assert is
    # dispatched in ps_parse_stmt and returns NODE_STATIC_ASSERT(70) directly into
    # the item list — never wrapped in NODE_EXPR_STMT). cst_parser parses it as a
    # CST_CALL inside a CST_EXPR_STMT, so unwrap: if the inner lowered to a
    # NODE_STATIC_ASSERT, return it bare.
    if east != 0 and ast::ast_get_kind(a, east) == node_constants::NODE_STATIC_ASSERT
      return east
    end
    return ast::ast_expr_stmt(a, east, line, col)
  end
  # --- Defer (68) --------------------------------------------------------
  # `defer <stmt>` (single statement) or `defer do … end` (multi-statement
  # block). Legacy ps_parse_stmt (parser.qz:5945-5965) builds NODE_DEFER with
  # the operand in `left`: the block form passes a NODE_BLOCK (from
  # ps_parse_block), the single-stmt form passes the statement node directly
  # (ps_parse_assign_or_call, which wraps a bare call as NODE_EXPR_STMT). The
  # CST mirrors this: block form children = [defer_kw, do_kw, CST_BLOCK(43),
  # end_kw]; stmt form children = [defer_kw, stmt]. Lower the sole structured
  # child — a CST_BLOCK via cl_lower_block, anything else via cst_lower_node
  # (which applies the NODE_EXPR_STMT wrap for bare calls).
  if k == 68  # CST_DEFER
    var df_child = cl_structured_child(cs, h, 0)
    var df_body = 0
    if df_child != 0
      if cst::cst_get_kind(cs, df_child) == 43  # CST_BLOCK (defer do … end)
        df_body = cl_lower_block(cs, df_child, a)
      else
        df_body = cst_lower_node(cs, df_child, a)
      end
    end
    return ast::ast_defer(a, df_body, line, col)
  end

  if k == 46  # CST_BREAK
    # CST children: [break_kw, (:label tok)?, (value expr)?]. Legacy: label and
    # value are mutually exclusive (parser.qz:5915) — labeled break has no value,
    # valued break has no label. label → str1; break value → left slot.
    var brk_label = cl_break_label(cs, h)
    var brk_node = ast::ast_break(a, brk_label, line, col)
    if str_byte_len(brk_label) == 0
      var brk_val = cl_break_value(cs, h, a)
      if brk_val != 0
        ast::ast_set_left(a, brk_node, brk_val)
      end
    end
    return brk_node
  end
  if k == 47  # CST_CONTINUE
    # CST children: [continue_kw, (:label tok)?]. label → str1.
    return ast::ast_continue(a, cl_break_label(cs, h), line, col)
  end

  # --- Bindings ----------------------------------------------------------
  # At module scope a binding is a NODE_GLOBAL_VAR: `var x = e` → mutable global
  # (is_mutable=1), bare `x = e` (CST_CONST_BINDING) → immutable global
  # (is_mutable=0). Inside a function/block body they stay NODE_LET.
  if k == 54  # CST_CONST_BINDING: [ident, (colon type)?, (=, rhs)?]
    if module_scope == 1
      return cl_lower_global(cs, h, a, 0, 0)
    end
    return cl_lower_binding(cs, h, a, 0)  # ast_let is_mut=0
  end
  if k == 53  # CST_VAR_DECL: `var x [: T] = e`
    if module_scope == 1
      return cl_lower_global(cs, h, a, 1, 0)
    end
    return cl_lower_binding(cs, h, a, 1)  # ast_let is_mut=1
  end

  # --- Assignment (49) ---------------------------------------------------
  if k == 49  # CST_ASSIGN: children = [lhs, =, rhs]; target is the lhs ident name.
    var lhs = cl_structured_child(cs, h, 0)
    var rhs = cl_structured_child(cs, h, 1)
    # Statement-level destructure binds `Type { x, y } = e` / `[a, b] = e`
    # (parser.qz:5980/5989, is_mut=0). The CST parses the lhs as a struct-init /
    # array-lit expression; reinterpret it as a destructure pattern.
    if cl_assign_lhs_is_struct_destr(cs, lhs) == 1
      return cl_struct_destr_assign(cs, lhs, rhs, a, 0, line, col)
    end
    if cl_assign_lhs_is_vec_destr(cs, lhs) == 1
      return cl_vec_destr_assign(cs, lhs, rhs, a, 0, line, col)
    end
    var target = ""
    if lhs != 0 and cst::cst_get_kind(cs, lhs) == 15  # CST_IDENT
      target = cl_first_token_lexeme(cs, lhs)
    end
    var vast = 0
    if rhs != 0
      vast = cst_lower_node(cs, rhs, a)
    end
    return ast::ast_assign(a, target, vast, line, col)
  end

  # --- Control flow ------------------------------------------------------
  if k == 55  # CST_IF (plain, no pattern)
    return cl_lower_if(cs, h, a)
  end
  if k == 60  # CST_WHILE
    return cl_lower_while(cs, h, a)
  end
  if k == 63  # CST_LOOP — `[:label] loop body end` → ast_while(true, body, label)
    # Legacy desugars loop → while true (parser.qz:4187-4205). CST children:
    # [(:label tok)?, loop_kw, <body CST_BLOCK>, end_kw]. body = first structured
    # child; label = a leading token that is not `loop`/`end` (cl_loop_label).
    var lbody63 = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
    var lcond63 = ast::ast_bool_lit(a, 1, line, col)
    return ast::ast_while(a, lcond63, lbody63, cl_loop_label(cs, h), line, col)
  end
  if k == 64  # CST_MATCH
    return cl_lower_match(cs, h, a)
  end
  if k == 66  # CST_WHEN_GUARD — postfix statement modifier (`<stmt> if|unless cond`)
    return cl_lower_postfix_guard(cs, h, a)
  end
  if k == 69  # CST_WITH_BLOCK — `with H[, H2…] do [-> | v ->] … end`
    return cl_lower_with(cs, h, a)
  end
  if k == 71  # CST_SELECT — `select (case .. | default ..)* end`
    return cl_lower_select(cs, h, a)
  end
  if k == 73  # CST_TASK_GROUP — `task_group |g| body end`
    return cl_lower_task_group(cs, h, a)
  end
  if k == 48  # CST_YIELD — `yield [expr]` → NODE_YIELD (parser.qz:4531-4552)
    var yval = 0
    var yn = cst::cst_child_count(cs, h)
    var yi = 0
    while yi < yn
      var yc = cst::cst_get_child(cs, h, yi)
      if cl_is_token(cs, yc) == 0
        yval = cst_lower_node(cs, yc, a)
        yi = yn
      end
      yi = yi + 1
    end
    return ast::ast_yield(a, yval, line, col)
  end
  # CST_REIFY (123) — `reify { expr }`. Legacy ps_parse_reify (parser.qz) parses
  # the brace body as one ps_parse_expr and RETURNS IT DIRECTLY: reify is
  # transparent at the AST level (parse-only Milestone A; no reify node exists).
  # cps_parse_reify captured [reify_kw, {, expr, }] — the single structured child
  # is the inner expr. Lower it and return it bare, dropping the reify wrapper.
  if k == 123  # CST_REIFY
    return cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  end
  if k == 117  # CST_ARENA_BLOCK — `arena name do … end`
    return cl_lower_arena(cs, h, a)
  end

  # --- Unhandled: visible placeholder (NEVER crash) ----------------------
  return ast::ast_ident(a, "__UNLOWERED_#{k}", line, col)
end

## Field name of a CST_FIELD_ACCESS / CST_SAFE_FIELD_ACCESS: the LAST token leaf
## (the segment after the `.`). Stops at a trailing `do`/`{` block marker (G5/G9)
## so a paren-free trailing-block method call (`v.map { … }`) does not over-read
## the block's `}`/`end`/header tokens as the field name.
def cl_field_name(cs: cst::CstStorage, h: Int): String
  var cnt = cst::cst_child_count(cs, h)
  var name = ""
  var j = 0
  var stop = 0
  while j < cnt and stop == 0
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if cl_is_block_marker(lex) == 1
        stop = 1
      elsif str_eq(lex, ".") == 0 and str_eq(lex, "?.") == 0
        name = lex
      end
    end
    j = j + 1
  end
  return name
end

## True (1) iff this node carries a trailing `do`/`{` block marker token child —
## i.e. a paren-free trailing-block method call lowered through the field-access
## path (G5/G9). Mirrors the marker scan in cl_fold_trailing_block.
def cl_node_has_trailing_block(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and cl_is_block_marker(cst::cst_get_str1(cs, c)) == 1
      return 1
    end
    j = j + 1
  end
  return 0
end

## True (1) iff the FIRST token after `var` on a CST_VAR_DECL is `(` — i.e. the
## binding target is a tuple destructure `var (a, b, c) = e` (cps_parse_var_decl
## captures the `(...)` as balanced tokens via cps_capture_balanced).
def cl_var_target_starts_paren(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var seen_var = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "var")
        seen_var = 1
      elsif seen_var == 1
        if str_eq(lex, "(")
          return 1
        end
        return 0
      end
    end
    j = j + 1
  end
  return 0
end

## Collects the comma-joined ident names of a `(a, b, c)` tuple-destructure target
## captured as balanced tokens on the node (idents between the first `(` and its
## matching `)`), reproducing legacy sb_to_string(sb): comma-separated, NO spaces,
## `_` placeholders kept verbatim (parser.qz:4457).
def cl_collect_destructure_names(cs: cst::CstStorage, h: Int): String
  var names = ""
  var n = cst::cst_child_count(cs, h)
  var depth = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "(")
        depth = depth + 1
      elsif str_eq(lex, ")")
        depth = depth - 1
        if depth == 0
          j = n
        end
      elsif str_eq(lex, ",")
        # separator — skip
      elsif depth >= 1
        if str_byte_len(names) > 0
          names = "#{names},#{lex}"
        else
          names = lex
        end
      end
    end
    j = j + 1
  end
  return names
end

## Classifies a CST_VAR_DECL binding target by its first post-`var` token:
##   1 = struct destructure (`var { x, y } = e` or `var Type { x, y } = e`)
##   2 = vec destructure    (`var [a, b] = e`)
##   0 = plain name / other.
## A leading Type ident only counts as a struct destructure if a `{` follows it
## (mirroring parser.qz:ps_parse_let's `Point { … }` branch). A leading `(` is
## the tuple case handled separately by cl_var_target_starts_paren.
def cl_var_destr_target_kind(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var seen_var = 0
  var first_after_var = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "var")
        seen_var = 1
      elsif seen_var == 1
        if first_after_var == 0
          if str_eq(lex, "{")
            return 1
          elsif str_eq(lex, "[")
            return 2
          end
          # A leading Type ident — struct destructure iff the next token is `{`.
          first_after_var = 1
        else
          if str_eq(lex, "{")
            return 1
          end
          return 0
        end
      end
    end
    j = j + 1
  end
  return 0
end

## The init expression (rhs after `=`) of a destructure binding: the LAST
## structured child that is not the CST_TYPE_REF (103) annotation. Lowered.
def cl_destr_bind_init(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var cnt = cst::cst_child_count(cs, h)
  var bi = cnt - 1
  while bi >= 0
    var dc = cst::cst_get_child(cs, h, bi)
    if cl_is_token(cs, dc) == 0 and cst::cst_get_kind(cs, dc) != 103
      return cst_lower_node(cs, dc, a)
    end
    bi = bi - 1
  end
  return 0
end

## Builds an ast_struct_destructure from the FLAT token children of a node whose
## token run contains a struct-destructure target (`{ x, y }` / `Type { x, y }`).
## Used by both the var-decl bind path (CST_VAR_DECL) and the for-in desugar
## (CST_FOR_IN pattern tokens). Reproduces parser.qz:ps_parse_struct_destr_fields
## EXACTLY: type_name = the leading ident before `{` (or "" for anonymous),
## field_specs = field idents joined by `,` with NO spaces (a rename renders
## `field:alias`), a `..` sets has_rest and is NOT added to the string. The caller
## supplies init (the rhs handle, or the for-in temp ident) and is_mut.
def cl_struct_destr_from_tokens(cs: cst::CstStorage, h: Int, init: Int, is_mut: Int, line: Int, col: Int, a: ast::AstStorage): Int
  var type_name = ""
  var field_specs = ""
  var has_rest = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  var seen_lbrace = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_lbrace == 0
        if str_eq(lex, "{") == 1
          seen_lbrace = 1
        elsif str_eq(lex, "var") == 0 and str_eq(lex, "for") == 0
          # The leading type ident (skip the `var`/`for` keywords). The token
          # immediately before `{` is the type name (anonymous `{ … }` → "").
          type_name = lex
        end
      else
        if str_eq(lex, "}") == 1
          j = n
        elsif str_eq(lex, "..") == 1
          has_rest = 1
        elsif str_eq(lex, ",") == 1
          # separator — skip
        elsif str_eq(lex, ":") == 1
          # separator between field and alias — skip
        else
          var spec = lex
          if j + 1 < n
            var nxt = cst::cst_get_child(cs, h, j + 1)
            if cl_is_token(cs, nxt) == 1 and str_eq(cst::cst_get_str1(cs, nxt), ":") == 1
              var al = cst::cst_get_child(cs, h, j + 2)
              spec = "#{lex}:#{cst::cst_get_str1(cs, al)}"
              j = j + 2
            end
          end
          if str_byte_len(field_specs) > 0
            field_specs = "#{field_specs},#{spec}"
          else
            field_specs = spec
          end
        end
      end
    end
    j = j + 1
  end
  return ast::ast_struct_destructure(a, type_name, field_specs, init, is_mut, has_rest, line, col)
end

## Builds an ast_vec_destructure from the FLAT token children of a node whose
## token run contains a vec-destructure target (`[a, b]` / `[head, ..tail]`).
## Used by both the var-decl bind path and the for-in desugar. Reproduces
## parser.qz:ps_parse_vec_destr_elems EXACTLY: elem_names = element idents joined
## by `,`, rest_name = the ident after `..` (or "" if none), has_rest=1 if a `..`
## appeared. The caller supplies init and is_mut.
def cl_vec_destr_from_tokens(cs: cst::CstStorage, h: Int, init: Int, is_mut: Int, line: Int, col: Int, a: ast::AstStorage): Int
  var elem_names = ""
  var rest_name = ""
  var has_rest = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  var seen_lbracket = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_lbracket == 0
        if str_eq(lex, "[") == 1
          seen_lbracket = 1
        end
      else
        if str_eq(lex, "]") == 1
          j = n
        elsif str_eq(lex, ",") == 1
          # separator — skip
        elsif str_eq(lex, "..") == 1
          has_rest = 1
          if j + 1 < n
            var nxt = cst::cst_get_child(cs, h, j + 1)
            if cl_is_token(cs, nxt) == 1
              var nlex = cst::cst_get_str1(cs, nxt)
              if str_eq(nlex, "]") == 0
                rest_name = nlex
                j = j + 1
              end
            end
          end
        else
          if str_byte_len(elem_names) > 0
            elem_names = "#{elem_names},#{lex}"
          else
            elem_names = lex
          end
        end
      end
    end
    j = j + 1
  end
  return ast::ast_vec_destructure(a, elem_names, rest_name, init, is_mut, has_rest, line, col)
end

## True (1) iff a CST_ASSIGN lhs is a struct-DESTRUCTURE target `Type { x, y }`
## rather than a real assignment. Legacy (parser.qz:5980) only treats an
## uppercase-headed `Type {` as a statement-level destructure; the CST parses
## such a target as a CST_STRUCT_INIT (26) with a CST_IDENT receiver. (A bare
## `obj.field = e` / `x = e` lhs is a field-access/ident, never a struct-init.)
def cl_assign_lhs_is_struct_destr(cs: cst::CstStorage, lhs: Int): Int
  if lhs == 0
    return 0
  end
  if cst::cst_get_kind(cs, lhs) != 26  # not CST_STRUCT_INIT
    return 0
  end
  var recv = cl_structured_child(cs, lhs, 0)
  if recv == 0 or cst::cst_get_kind(cs, recv) != 15  # receiver must be a plain ident
    return 0
  end
  var nm = cl_first_token_lexeme(cs, recv)
  if str_byte_len(nm) == 0
    return 0
  end
  var fc = str_byte_at(nm, 0)
  if fc >= 'A' and fc <= 'Z'
    return 1
  end
  return 0
end

## True (1) iff a CST_ASSIGN lhs is a vec-DESTRUCTURE target `[a, b]` /
## `[head, ..tail]`. Legacy (parser.qz:5989) treats a `[` followed by an ident or
## `..` as a statement-level destructure. The CST parses such a target as a
## CST_ARRAY_LIT (29) — STRUCTURED (CST_ELEM_LIST 120 of idents) for `[a, b]`, or
## a verbatim token bag for the `..`-rest forms. A genuine array-literal rhs in
## lhs position can't occur (lhs of `=` is an assignment target).
def cl_assign_lhs_is_vec_destr(cs: cst::CstStorage, lhs: Int): Int
  if lhs == 0
    return 0
  end
  if cst::cst_get_kind(cs, lhs) != 29  # not CST_ARRAY_LIT
    return 0
  end
  # Structured form: a CST_ELEM_LIST whose structured children are all idents.
  var elist = cl_child_of_kind(cs, lhs, 120)
  if elist != 0
    var sc = cl_structured_count(cs, elist)
    if sc == 0
      return 0
    end
    var i = 0
    while i < sc
      if cst::cst_get_kind(cs, cl_structured_child(cs, elist, i)) != 15
        return 0
      end
      i = i + 1
    end
    return 1
  end
  # Verbatim (`..`-rest) form: a flat token bag — destructure iff the first
  # in-bracket token is an ident or `..`.
  var n = cst::cst_child_count(cs, lhs)
  var j = 0
  var seen_lb = 0
  while j < n
    var c = cst::cst_get_child(cs, lhs, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_lb == 0
        if str_eq(lex, "[")
          seen_lb = 1
        end
      else
        if str_eq(lex, "..") == 1
          return 1
        end
        if str_eq(lex, "]") == 1
          return 0
        end
        # A bare ident first element → destructure; anything else → not.
        if cst::cst_get_kind(cs, c) == 1
          return 1
        end
        return 0
      end
    end
    j = j + 1
  end
  return 0
end

## Builds an ast_struct_destructure from a CST_STRUCT_INIT (26) lhs of a
## statement-level destructure assign (`Type { x, y: alias, .. } = e`). Mirrors
## parser.qz:ps_parse_struct_destr_fields: type_name = the receiver ident,
## field_specs = field idents joined by `,` (a `name: ident` rename renders
## `field:alias`), `..` → has_rest. The CST shape is CST_STRUCT_INIT[receiver,
## CST_FIELD_LIST(121)] with CST_FIELD_INIT(28) entries: a value-less entry is a
## bare field, a `name:value` entry is a rename (value is a CST_IDENT), and a
## `..` entry is the rest marker. init = the lowered rhs; is_mut as given.
def cl_struct_destr_assign(cs: cst::CstStorage, lhs: Int, rhs: Int, a: ast::AstStorage, is_mut: Int, line: Int, col: Int): Int
  var recv = cl_structured_child(cs, lhs, 0)
  var type_name = cl_first_token_lexeme(cs, recv)
  var field_specs = ""
  var has_rest = 0
  var flist = cl_child_of_kind(cs, lhs, 121)
  if flist != 0
    var n = cst::cst_child_count(cs, flist)
    var j = 0
    while j < n
      var c = cst::cst_get_child(cs, flist, j)
      if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) == 28  # CST_FIELD_INIT
        var fname = cl_first_token_lexeme(cs, c)
        if str_eq(fname, "..") == 1
          has_rest = 1
        else
          var spec = fname
          var vnode = cl_structured_child(cs, c, 0)  # rename value (CST_IDENT)
          if vnode != 0
            spec = "#{fname}:#{cl_first_token_lexeme(cs, vnode)}"
          end
          if str_byte_len(field_specs) > 0
            field_specs = "#{field_specs},#{spec}"
          else
            field_specs = spec
          end
        end
      end
      j = j + 1
    end
  end
  var init = 0
  if rhs != 0
    init = cst_lower_node(cs, rhs, a)
  end
  return ast::ast_struct_destructure(a, type_name, field_specs, init, is_mut, has_rest, line, col)
end

## Builds an ast_vec_destructure from a CST_ARRAY_LIT (29) lhs of a
## statement-level destructure assign (`[a, b] = e` / `[head, ..tail] = e`).
## Handles BOTH the structured (CST_ELEM_LIST 120 of idents) and the verbatim
## token-bag (`..`-rest) forms by scanning the lhs's token leaves — `[`, element
## idents (`,`-separated), an optional `..` with optional rest ident, `]`.
## Mirrors parser.qz:ps_parse_vec_destr_elems. init = the lowered rhs.
def cl_vec_destr_assign(cs: cst::CstStorage, lhs: Int, rhs: Int, a: ast::AstStorage, is_mut: Int, line: Int, col: Int): Int
  var elem_names = ""
  var rest_name = ""
  var has_rest = 0
  # Structured form: read idents from the CST_ELEM_LIST.
  var elist = cl_child_of_kind(cs, lhs, 120)
  if elist != 0
    var sc = cl_structured_count(cs, elist)
    var i = 0
    while i < sc
      var el = cl_structured_child(cs, elist, i)
      var lex = cl_first_token_lexeme(cs, el)
      if str_byte_len(elem_names) > 0
        elem_names = "#{elem_names},#{lex}"
      else
        elem_names = lex
      end
      i = i + 1
    end
  else
    # Verbatim token-bag form (the `..`-rest cases). Scan the bracket tokens.
    var n = cst::cst_child_count(cs, lhs)
    var j = 0
    var seen_lb = 0
    while j < n
      var c = cst::cst_get_child(cs, lhs, j)
      if cl_is_token(cs, c) == 1
        var lex = cst::cst_get_str1(cs, c)
        if seen_lb == 0
          if str_eq(lex, "[") == 1
            seen_lb = 1
          end
        else
          if str_eq(lex, "]") == 1
            j = n
          elsif str_eq(lex, ",") == 1
            # separator — skip
          elsif str_eq(lex, "..") == 1
            has_rest = 1
            if j + 1 < n
              var nxt = cst::cst_get_child(cs, lhs, j + 1)
              if cl_is_token(cs, nxt) == 1 and str_eq(cst::cst_get_str1(cs, nxt), "]") == 0
                rest_name = cst::cst_get_str1(cs, nxt)
                j = j + 1
              end
            end
          else
            if str_byte_len(elem_names) > 0
              elem_names = "#{elem_names},#{lex}"
            else
              elem_names = lex
            end
          end
        end
      end
      j = j + 1
    end
  end
  var init = 0
  if rhs != 0
    init = cst_lower_node(cs, rhs, a)
  end
  return ast::ast_vec_destructure(a, elem_names, rest_name, init, is_mut, has_rest, line, col)
end

## Lowers a const-binding / var-decl to ast_let (or ast_let_destructure for a
## tuple-destructure `var (a, b, c) = e`, or ast_struct_destructure /
## ast_vec_destructure for `var { x, y } = e` / `var [a, b] = e`). The NAME is
## the first token leaf (or first ident structured child); the VALUE is the last
## structured child (the rhs after `=`); the TYPE annotation is the CST_TYPE_REF
## child if present.
def cl_lower_binding(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_mut: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var cnt = cst::cst_child_count(cs, h)
  var kind = cst::cst_get_kind(cs, h)

  # Type annotation: CST_TYPE_REF child if present (`x: T = e` / `var x: T = e`).
  var tref = cl_child_of_kind(cs, h, 103)
  var type_ann = ""
  if tref != 0
    type_ann = cst_type_string(cs, tref)
  end

  var name = ""
  var value = 0

  if kind == 54  # CST_CONST_BINDING: [CST_IDENT(name), (: type)?, =, rhs]
    # Name = lexeme of the lhs CST_IDENT (structured child 0).
    var lhs = cl_structured_child(cs, h, 0)
    if lhs != 0
      name = cl_first_token_lexeme(cs, lhs)
    end
    # Value = the FIRST structured child after the lhs that is not the type node
    # (i.e. structured child 1, skipping a CST_TYPE_REF if it sits there).
    var sidx = 1
    var v = cl_structured_child(cs, h, sidx)
    while v != 0 and cst::cst_get_kind(cs, v) == 103
      sidx = sidx + 1
      v = cl_structured_child(cs, h, sidx)
    end
    value = v
  else  # CST_VAR_DECL: [var, name_tok, (: type)?, =, rhs]
    # Tuple let-destructure `var (a, b, c) = e` → ast_let_destructure (the
    # `(...)` target is captured as balanced tokens; parser.qz:4457).
    if cl_var_target_starts_paren(cs, h) == 1
      var dnames = cl_collect_destructure_names(cs, h)
      var dval = 0
      var dbi = cnt - 1
      while dbi >= 0
        var dc = cst::cst_get_child(cs, h, dbi)
        if cl_is_token(cs, dc) == 0 and cst::cst_get_kind(cs, dc) != 103
          dval = dc
          dbi = 0 - 1
        else
          dbi = dbi - 1
        end
      end
      var dvast = 0
      if dval != 0
        dvast = cst_lower_node(cs, dval, a)
      end
      return ast::ast_let_destructure(a, dnames, dvast, is_mut, line, col)
    end
    # Struct `var { x, y } = e` / `var Type { x, y } = e` and vec `var [a, b] = e`
    # destructure binds (target captured as balanced tokens; parser.qz:4459/4471).
    var dkind = cl_var_destr_target_kind(cs, h)
    if dkind == 1
      return cl_struct_destr_from_tokens(cs, h, cl_destr_bind_init(cs, h, a), is_mut, line, col, a)
    elsif dkind == 2
      return cl_vec_destr_from_tokens(cs, h, cl_destr_bind_init(cs, h, a), is_mut, line, col, a)
    end
    # Name = first token leaf after `var` that is not `:`/`=`.
    var j = 0
    var seen_var = 0
    while j < cnt and str_byte_len(name) == 0
      var c = cst::cst_get_child(cs, h, j)
      if cl_is_token(cs, c) == 1
        var lex = cst::cst_get_str1(cs, c)
        if str_eq(lex, "var")
          seen_var = 1
        elsif seen_var == 1 and str_eq(lex, ":") == 0 and str_eq(lex, "=") == 0
          name = lex
        end
      end
      j = j + 1
    end
    cl_check_binding_name(name, "var binding", line, col)
    # Value = the LAST structured child that is not the type node.
    var bi = cnt - 1
    while bi >= 0
      var c = cst::cst_get_child(cs, h, bi)
      if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) != 103
        value = c
        bi = 0 - 1
      else
        bi = bi - 1
      end
    end
  end

  var vast = 0
  if value != 0
    vast = cst_lower_node(cs, value, a)
  end
  return ast::ast_let(a, name, type_ann, vast, is_mut, line, col)
end

## Lowers the PATTERN of a refutable-bind `if`/`elsif` (the cond-position child
## before the top-level `=`) to the enum_access AST node legacy builds via
## ps_parse_pattern. The CST stores the pattern as a CST_CALL (21) parsed in
## expression position — `Some(v)` / `HObj(keys, _)` (unqualified, callee
## CST_IDENT 15) or `Option::Some(p)` (qualified, callee CST_PATH 16). This
## reproduces cl_lower_variant_pattern / parser.qz:_ps_parse_pattern_arg EXACTLY:
##   - Unqualified callee → name="", variant=callee ident.
##   - Qualified callee   → name=all-but-last `::` segs ($-joined), variant=last.
##   - Each arg ident → bound_name=lexeme + ast_ident; `_` → bound_name="_" +
##     ast_wildcard. bound_names/sub_pats pushed RAW / as_int, as in the match-arm
##     path. A no-paren pattern (bare `Variant`/path, no CST_CALL) lowers to a
##     plain expr (ast_ident/path), matching legacy's `ast_ident` fallthrough —
##     no corpus file exercises this corner.
def cl_lower_if_pattern(cs: cst::CstStorage, pat: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, pat)
  var col = cst::cst_get_col(cs, pat)
  if cst::cst_get_kind(cs, pat) != 21  # not a CST_CALL → bare `_` / variant / ident
    # Bare `_` is a wildcard pattern (`if _ = e` — parser.qz:5445 TOK_UNDERSCORE
    # → ast_wildcard), NOT an ident. Any other bare token (binding ident, bare
    # variant/path) lowers as its plain expr, matching legacy's `ast_ident`.
    if cst::cst_get_kind(cs, pat) == 15 and str_eq(cl_first_token_lexeme(cs, pat), "_")
      return ast::ast_wildcard(a, line, col)
    end
    return cst_lower_node(cs, pat, a)
  end
  var callee = cl_structured_child(cs, pat, 0)
  var name = ""
  var variant = ""
  if cst::cst_get_kind(cs, callee) == 16  # CST_PATH: qualified Enum::Variant
    name = cl_path_enum_name(cs, callee)
    variant = cl_path_seg_lexeme(cs, callee)
  else  # CST_IDENT: unqualified Variant
    variant = cl_first_token_lexeme(cs, callee)
  end
  # Payload args live in the CST_ARG_LIST (119); each structured arg is a
  # CST_IDENT — `_` → wildcard, any other ident → a binding.
  var bound_names = vec_new()
  var sub_pats = vec_new()
  var alist = cl_child_of_kind(cs, pat, 119)
  if alist != 0
    var sc = cl_structured_count(cs, alist)
    var i = 0
    while i < sc
      var arg = cl_structured_child(cs, alist, i)
      var aline = cst::cst_get_line(cs, arg)
      var acol = cst::cst_get_col(cs, arg)
      var lex = cl_first_token_lexeme(cs, arg)
      if str_eq(lex, "_")
        bound_names.push(as_int(cl_intern_lex("_")))
        sub_pats.push(as_int(ast::ast_wildcard(a, aline, acol)))
      else
        bound_names.push(as_int(cl_intern_lex(lex)))
        sub_pats.push(as_int(ast::ast_ident(a, lex, aline, acol)))
      end
      i = i + 1
    end
  end
  return ast::ast_enum_access(a, name, variant, as_int(bound_names), as_int(sub_pats), line, col)
end

## Builds the ast_if for a refutable-bind `if`/`elsif` (CST_IF 55 / CST_ELSIF_CLAUSE
## 58 whose children carry a top-level `=`). Structured layout: child 0 = PATTERN,
## child 1 = scrutinee (RHS after `=`), the CST_BLOCK 43 = then-body. Reproduces
## parser.qz:ps_parse_if 4044-4048: cond = scrutinee, then int_val=1 + op=pattern
## marks the node as a pattern-if. `else_b` is supplied by the caller (the outer
## if vs an elsif clause build their else-tail from different parent contexts).
def cl_lower_if_refutable(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int, else_b: Int): Int
  var pat_node = cl_structured_child(cs, h, 0)
  # then = first CST_BLOCK; scrutinee = first structured non-block child after the
  # pattern (structured index 1), skipping any elsif/else clause nodes.
  var scrut_node = 0
  var then_node = 0
  var n = cst::cst_child_count(cs, h)
  var seen_struct = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      var ck = cst::cst_get_kind(cs, c)
      if ck == 43  # CST_BLOCK
        if then_node == 0
          then_node = c
        end
      elsif ck == 58 or ck == 59  # elsif / else clause — not the scrutinee
      else
        if seen_struct == 1 and scrut_node == 0
          scrut_node = c  # structured index 1 = the RHS scrutinee
        end
        seen_struct = seen_struct + 1
      end
    end
    j = j + 1
  end
  var pattern = cl_lower_if_pattern(cs, pat_node, a)
  var cond = cst_lower_node(cs, scrut_node, a)
  var then_b = cst_lower_node(cs, then_node, a)
  var result = ast::ast_if(a, cond, then_b, else_b, line, col)
  ast::ast_set_int_val(a, result, 1)
  ast::ast_set_op(a, result, pattern)
  return result
end

## Lowers a CST_IF (kind 55) to ast_if, building the legacy nested-if chain for
## `elsif`/`else if`: `if c1 t1 elsif c2 t2 else e` → If(c1,t1, If(c2,t2, e)).
## CST_IF children: [if_kw, (let_kw)?, cond, (=,rhs)?, (then)?, body_block,
##   (CST_ELSIF_CLAUSE 58)*, (CST_ELSE_CLAUSE 59)?, end_kw]. The plain form is
## cond = first structured child, then = the first CST_BLOCK. Refutable-bind form
## (`if Some(v)=e`): structured child 0 is the PATTERN, the structured child after
## the `=` is the scrutinee/cond; the resulting ast_if carries int_val=1 + op=pattern
## (parser.qz:4044-4048).
def cl_lower_if(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Refutable-bind / if-let form (a `let` or top-level `=` token present).
  if cl_if_has_pattern(cs, h) == 1
    var if_else_b = cl_lower_if_tail(cs, h, a, 0)
    return cl_lower_if_refutable(cs, h, a, line, col, if_else_b)
  end
  # cond = first structured child; then = first CST_BLOCK child.
  var cond_node = 0
  var then_node = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      var ck = cst::cst_get_kind(cs, c)
      if ck == 43  # CST_BLOCK
        if then_node == 0
          then_node = c
        end
      elsif ck == 58 or ck == 59  # elsif / else clause — handled below
      elsif cond_node == 0
        cond_node = c
      end
    end
    j = j + 1
  end
  var cond = cst_lower_node(cs, cond_node, a)
  # Block `unless cond ... end` desugars to `if (not cond) ... end`: the legacy
  # parser (parser.qz:ps_parse_unless) wraps the condition in OpNot (13) before
  # building the ast_if. The cst_parser stores `if`/`unless` as the first token
  # child of CST_IF, so detect `unless` and replicate the negation here.
  if str_eq(cl_first_token_lexeme(cs, h), "unless") == 1
    cond = ast::ast_unary(a, 13, cond, line, col)  # OpNot
  end
  var then_b = cst_lower_node(cs, then_node, a)
  # Build the else chain from the elsif/else clauses, right-to-left.
  var else_b = cl_lower_if_tail(cs, h, a, 0)
  return ast::ast_if(a, cond, then_b, else_b, line, col)
end

## True if a CST_IF/CST_ELSIF_CLAUSE has a `let` keyword or a top-level `=`
## (refutable bind) before its body block — a pattern form (KNOWN GAP).
def cl_if_has_pattern(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 43  # reached body — stop
      return 0
    end
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "let") or str_eq(lex, "=")
        return 1
      end
    end
    j = j + 1
  end
  return 0
end

## Builds the else-branch AST for a CST_IF/CST_ELSIF_CLAUSE: the next
## CST_ELSIF_CLAUSE (58) → a nested ast_if, else the CST_ELSE_CLAUSE (59) body
## block, else 0 (no else). `from` skips already-consumed clauses (always 0 for
## the outer call; clauses are scanned in order).
def cl_lower_if_tail(cs: cst::CstStorage, h: Int, a: ast::AstStorage, start_at: Int): Int
  var n = cst::cst_child_count(cs, h)
  # Find the first elsif/else clause.
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    var ck = cst::cst_get_kind(cs, c)
    if ck == 58  # CST_ELSIF_CLAUSE → nested ast_if
      return cl_lower_elsif_clause(cs, h, j, a)
    end
    if ck == 59  # CST_ELSE_CLAUSE → its body block
      var body = cl_child_of_kind(cs, c, 43)
      if body != 0
        return cl_lower_block(cs, body, a)
      end
      return 0
    end
    j = j + 1
  end
  return 0
end

## Lowers the CST_ELSIF_CLAUSE at child index `idx` of parent `h` to a nested
## ast_if whose else-branch is the REMAINING elsif/else clauses after `idx`.
def cl_lower_elsif_clause(cs: cst::CstStorage, h: Int, idx: Int, a: ast::AstStorage): Int
  var clause = cst::cst_get_child(cs, h, idx)
  var line = cst::cst_get_line(cs, clause)
  var col = cst::cst_get_col(cs, clause)
  if cl_if_has_pattern(cs, clause) == 1
    # Refutable-bind elsif: scrutinee/pattern live IN the clause; the else-tail
    # is the remaining clauses after idx in the PARENT.
    var elsif_else_b = cl_lower_if_tail_after(cs, h, idx, a)
    return cl_lower_if_refutable(cs, clause, a, line, col, elsif_else_b)
  end
  # cond = first structured child of the clause; then = its CST_BLOCK.
  var cond_node = 0
  var then_node = 0
  var cn = cst::cst_child_count(cs, clause)
  var j = 0
  while j < cn
    var c = cst::cst_get_child(cs, clause, j)
    if cl_is_token(cs, c) == 0
      if cst::cst_get_kind(cs, c) == 43
        if then_node == 0
          then_node = c
        end
      elsif cond_node == 0
        cond_node = c
      end
    end
    j = j + 1
  end
  var cond = cst_lower_node(cs, cond_node, a)
  var then_b = cst_lower_node(cs, then_node, a)
  # else = the next clause after idx (scan parent from idx+1).
  var else_b = cl_lower_if_tail_after(cs, h, idx, a)
  return ast::ast_if(a, cond, then_b, else_b, line, col)
end

## Like cl_lower_if_tail but only considers clauses AFTER parent child index
## `after` (used to walk the elsif chain forward).
def cl_lower_if_tail_after(cs: cst::CstStorage, h: Int, after: Int, a: ast::AstStorage): Int
  var n = cst::cst_child_count(cs, h)
  var j = after + 1
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    var ck = cst::cst_get_kind(cs, c)
    if ck == 58
      return cl_lower_elsif_clause(cs, h, j, a)
    end
    if ck == 59
      var body = cl_child_of_kind(cs, c, 43)
      if body != 0
        return cl_lower_block(cs, body, a)
      end
      return 0
    end
    j = j + 1
  end
  return 0
end

## Lowers a module-scope binding (CST_VAR_DECL / CST_CONST_BINDING) to
## NODE_GLOBAL_VAR. is_mutable: 1 for `var`, 0 for a bare `name = e` const.
## is_thread_local: 1 only via the `@thread_local var` decorator path (legacy
## ps_parse_global_var(ps, 1)); 0 for an undecorated module binding. The type
## annotation (str2) is NOT fingerprinted, so it is left at default. Scalars the
## gate compares: int_val=is_mutable, op=is_thread_local, s1=name, right=init.
def cl_lower_global(cs: cst::CstStorage, h: Int, a: ast::AstStorage, is_mutable: Int, is_thread_local: Int): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var kind = cst::cst_get_kind(cs, h)
  var name = ""
  var value = 0
  if kind == 54  # CST_CONST_BINDING: [CST_IDENT(name), (: type)?, =, rhs]
    var lhs = cl_structured_child(cs, h, 0)
    if lhs != 0
      name = cl_first_token_lexeme(cs, lhs)
    end
    var sidx = 1
    var v = cl_structured_child(cs, h, sidx)
    while v != 0 and cst::cst_get_kind(cs, v) == 103  # skip a CST_TYPE_REF
      sidx = sidx + 1
      v = cl_structured_child(cs, h, sidx)
    end
    value = v
  else  # CST_VAR_DECL: [var, name_tok, (: type)?, =, rhs]
    var cnt = cst::cst_child_count(cs, h)
    var j = 0
    var seen_var = 0
    while j < cnt and str_byte_len(name) == 0
      var c = cst::cst_get_child(cs, h, j)
      if cl_is_token(cs, c) == 1
        var lex = cst::cst_get_str1(cs, c)
        if str_eq(lex, "var")
          seen_var = 1
        elsif seen_var == 1 and str_eq(lex, ":") == 0 and str_eq(lex, "=") == 0
          name = lex
        end
      end
      j = j + 1
    end
    cl_check_binding_name(name, "var binding", line, col)
    var bi = cnt - 1
    while bi >= 0
      var c = cst::cst_get_child(cs, h, bi)
      if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) != 103
        value = c
        bi = 0 - 1
      else
        bi = bi - 1
      end
    end
  end
  var vast = 0
  if value != 0
    vast = cst_lower_node(cs, value, a)
  end
  var gnode = ast::ast_global_var(a, name, vast, is_mutable, is_thread_local, line, col)
  # Type annotation → str2, matching legacy ps_parse_global_var (parser.qz:7870-7874).
  # Only the `var name: T = e` form carries an annotation; ps_parse_global_const
  # (the CST_CONST_BINDING / bare `name = e` path) never sets str2, so leave it at
  # default there. MIR PASS 0.6 reads this str2 into the global-type registry —
  # without it, `mir_is_string_container_access` can't resolve a global container's
  # element type, so interpolation holes off a global Vec<String> keep a redundant
  # `to_str` wrap instead of taking the inline sb_append fast path (the flag-ON vs
  # flag-OFF IR divergence in examples/cli_effects.qz's argv_cache).
  if kind == 53  # CST_VAR_DECL
    var tref = cl_child_of_kind(cs, h, 103)
    if tref != 0
      var type_ann = cst_type_string(cs, tref)
      if str_byte_len(type_ann) > 0
        ast::ast_set_str2(a, gnode, type_ann)
      end
    end
  end
  return gnode
end

## Lowers a CST_WHILE (kind 60) to ast_while. CST children:
##   [(:label tok)?, while_kw, cond_expr, <body block>, end_kw]
## Labeled loops (`:label while …`) thread the symbol leaf in as the loop node's
## first child (cst_parser cps_parse_while). The label = a leading token whose
## lexeme is not `while`/`end`; its raw lexeme (including the leading `:`) goes to
## ast_while's label slot, matching legacy ps_parse_while_labeled (str1).
def cl_lower_while(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var cond = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var body = cst_lower_node(cs, cl_structured_child(cs, h, 1), a)
  return ast::ast_while(a, cond, body, cl_loop_label(cs, h), line, col)
end

## Extracts the loop label from a labeled-loop CST node (CST_WHILE/CST_FOR_IN/
## CST_LOOP). The label is the leading token leaf whose lexeme is not the loop
## keyword (`while`/`for`/`loop`), the `in` separator, the `await` modifier, or
## the closing `end`. Returns "" when unlabeled. The raw lexeme (with leading
## `:`) is preserved verbatim, mirroring legacy ps_current_lexeme.
def cl_loop_label(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var i = 0
  while i < n
    var c = cst::cst_get_child(cs, h, i)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "while") or str_eq(lex, "for") or str_eq(lex, "loop")
        return ""
      elsif str_eq(lex, "in") == 0 and str_eq(lex, "await") == 0 and str_eq(lex, "end") == 0
        return lex
      end
    end
    i = i + 1
  end
  return ""
end

## Extracts the optional `:label` from a CST_BREAK/CST_CONTINUE node. The label
## is the leading token leaf that is not the `break`/`continue` keyword. Returns
## "" when absent. Raw lexeme (with leading `:`) preserved, matching legacy
## ps_current_lexeme (parser.qz:5909/5938).
def cl_break_label(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var i = 0
  while i < n
    var c = cst::cst_get_child(cs, h, i)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "break") == 0 and str_eq(lex, "continue") == 0
        return lex
      end
    end
    i = i + 1
  end
  return ""
end

## Lowers the optional break VALUE expression of a CST_BREAK node — the first
## structured (non-token) child. Returns 0 when absent. Legacy stores it in the
## break node's left slot (parser.qz:5922), and only when unlabeled.
def cl_break_value(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var n = cst::cst_child_count(cs, h)
  var i = 0
  while i < n
    var c = cst::cst_get_child(cs, h, i)
    if cl_is_token(cs, c) == 0
      return cst_lower_node(cs, c, a)
    end
    i = i + 1
  end
  return 0
end

# ===========================================================================
# With-block (CST_WITH_BLOCK 69) — `with H[, H2…] do [-> | v -> | v: T ->] … end`
# ===========================================================================
# Mirrors parser.qz:ps_parse_handler_block byte-for-byte. The cst_parser now
# parses the handler expression(s) STRUCTURALLY (a structured child per handler;
# comma-separated handlers each a child) and captures the optional do-header
# bound param (`do v ->` / `do v: T ->`) as TOKEN children between the `do` token
# and the CST_BLOCK body. Legacy builds a NESTED NODE_WITH chain: the FIRST
# handler ends up OUTERMOST, the LAST handler innermost (body directly inside it).
# The optional bound param attaches to the innermost with (only the single-handler
# form can carry it; legacy rejects `do v ->` with a comma-list).
#
# Allocation order matches legacy exactly so the fingerprinted bound-param HANDLE
# (`NODE_WITH.extra`) aligns: lower handler(s) → build bound param → lower body
# block → build the ast_with chain last.

## Extracts the do-header bound-param NODE_PARAM handle from the TOKEN children
## between the `do` token and the CST_BLOCK(43) body, or -1 when the header is
## `do ->` (no param) / `do` (none). Forms: `v ->`, `v: T ->`. Uses the with-block
## line/col (`wl`/`wc`) for the param node, matching ps_parse_handler_block which
## passes the with's `line`/`col` to ast_param.
def cl_with_bound_param(cs: cst::CstStorage, h: Int, wl: Int, wc: Int, a: ast::AstStorage): Int
  var n = cst::cst_child_count(cs, h)
  # Find the `do` token index.
  var do_idx = 0 - 1
  var j = 0
  while j < n and do_idx == 0 - 1
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "do")
      do_idx = j
    end
    j = j + 1
  end
  if do_idx == 0 - 1
    return 0 - 1
  end
  # Collect header TOKEN lexemes between `do` and the CST_BLOCK body.
  var hdr = vec_new<String>()
  var k = do_idx + 1
  var stop = 0
  while k < n and stop == 0
    var c2 = cst::cst_get_child(cs, h, k)
    if cl_is_token(cs, c2) == 1
      hdr.push(cst::cst_get_str1(cs, c2))
    else
      stop = 1  # the CST_BLOCK body — header ends here
    end
    k = k + 1
  end
  # `->` only (or empty) → no bound param.
  var hn = hdr.size
  if hn == 0
    return 0 - 1
  end
  if hn == 1 and str_eq(hdr[0], "->")
    return 0 - 1
  end
  # `v ->` or `v: T ->`. First token is the param name; an optional `: <type>`
  # follows up to the `->`.
  var pname = hdr[0]
  var ptype = ""
  if hn >= 2 and str_eq(hdr[1], ":")
    var ttoks = vec_new<String>()
    var i = 2
    while i < hn and str_eq(hdr[i], "->") == 0
      ttoks.push(hdr[i])
      i = i + 1
    end
    ptype = cl_render_type_from_tokens(ttoks)
  end
  return ast::ast_param(a, pname, ptype, 0, 0, wl, wc)
end

## Lowers a CST_WITH_BLOCK (69) to the legacy nested NODE_WITH chain.
def cl_lower_with(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Structured children: handler exprs in order, then the CST_BLOCK(43) body last.
  var handlers = vec_new()
  var body_cst = 0
  var sc = cl_structured_count(cs, h)
  var si = 0
  while si < sc
    var child = cl_structured_child(cs, h, si)
    if cst::cst_get_kind(cs, child) == 43  # CST_BLOCK body
      body_cst = child
    else
      handlers.push(cst_lower_node(cs, child, a))  # handler expr — lower in source order
    end
    si = si + 1
  end
  # Bound param (allocated AFTER handlers, BEFORE body — matches ps_parse_handler_block).
  var bound_param = cl_with_bound_param(cs, h, line, col, a)
  # Body block (a real CST_BLOCK; allocate its stmts + block before the with nodes).
  var body_block = 0
  if body_cst != 0
    body_block = cl_lower_block(cs, body_cst, a)
  else
    body_block = ast::ast_block(a, as_int(vec_new()), line, col)
  end
  # Build the nested chain in reverse: last handler innermost, first outermost.
  var result = body_block
  var hcount = handlers.size
  var idx = hcount - 1
  while idx >= 0
    result = ast::ast_with(a, handlers[idx], result, line, col)
    if idx == hcount - 1 and bound_param != 0 - 1
      ast::ast_with_set_bound_param(a, result, bound_param)
    end
    idx = idx - 1
  end
  return result
end

# ===========================================================================
# Select (C.13 unified): `select (case <bind|_> = <Selectable> => body |
#                                  default => body)* end`
# ===========================================================================
# cst_parser builds CST_SELECT(71) = [select_kw, CST_SELECT_ARM(72)*, end_kw].
# Each CST_SELECT_ARM(72) holds, in source order: the `case`/`default` keyword
# token, then for `case`: the binding token (a bare name or `_`), the `=` token,
# the Selectable expression (a structured child), the `=>` token, and the body
# CST_BLOCK(43); `default` arms carry only `default`, `=>`, body.
#
# Mirrors parser.qz ps_parse_select / ps_parse_select_arm. Legacy parses the
# Selectable to AST then de-sugars by inspecting the resulting AST kind:
#   op_kind 0=recv, 1=send, 2=default, 3=await, 4=timeout, 5=Selectable.
# We lower the Selectable CST node to AST FIRST, then run the identical kind
# inspection over the lowered AST — so the de-sugar decision is byte-equivalent.

## Lowers a CST_SELECT(71) → ast_select. Each CST_SELECT_ARM(72) child becomes a
## NODE_SELECT_ARM via cl_lower_select_arm; non-arm leaves (the kw/end tokens) are
## skipped. Arm order is preserved (legacy pushes in parse order).
## Lowers a CST_TASK_GROUP(73) — `task_group |g| body end` — to NODE_TASK_GROUP.
## Mirrors parser.qz:ps_parse_task_group (1401-1421): binding_name = the IDENT
## between the two `|` header tokens; body = ast_block of the body statements (NO
## implicit-return rewrite). The body CST_BLOCK is the lone structured child.
def cl_lower_task_group(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Binding: the token between the first and second `|` in the header.
  var binding = ""
  var n = cst::cst_child_count(cs, h)
  var seen_pipe = 0
  var done_pipes = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if done_pipes == 0 and cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "|")
        if seen_pipe == 1
          done_pipes = 1
        else
          seen_pipe = 1
        end
      elsif seen_pipe == 1 and str_byte_len(binding) == 0
        binding = lex
      end
    end
    j = j + 1
  end
  # Body: the lone structured child (the CST_BLOCK), lowered via cl_lower_block.
  var body = 0
  var m = 0
  while m < n
    var c = cst::cst_get_child(cs, h, m)
    if cl_is_token(cs, c) == 0
      body = cst_lower_node(cs, c, a)
      m = n
    end
    m = m + 1
  end
  return ast::ast_task_group(a, binding, body, line, col)
end

def cl_lower_select(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var arms = vec_new()
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 72  # CST_SELECT_ARM
      arms.push(cl_lower_select_arm(cs, c, a))
    end
    j = j + 1
  end
  return ast::ast_select(a, as_int(arms), line, col)
end

## Lowers one CST_SELECT_ARM(72) → NODE_SELECT_ARM. Reproduces
## parser.qz:ps_parse_select_arm's de-sugar: `default` → op_kind 2; otherwise the
## Selectable is lowered and its AST kind decides op_kind (await/recv/send/timeout
## fast-paths, else op_kind 5 with the raw expr in the channel slot).
def cl_lower_select_arm(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var kw = cl_first_token_lexeme(cs, h)
  # default => body  (op_kind 2; channel 0, binding "")
  if str_eq(kw, "default") == 1
    var body_d = cl_lower_select_arm_body(cs, h, a, line, col)
    return ast::ast_select_arm(a, 2, 0, "", body_d, line, col)
  end
  # case <binding|_> = <Selectable> => body.
  # Binding: the FIRST token after `case` that is a name or `_`. `_` (TOK_UNDERSCORE)
  # contributes the empty binding, matching legacy. The Selectable is the lone
  # structured child that is NOT the body CST_BLOCK(43).
  var binding = cl_select_arm_binding(cs, h)
  var sel_cst = cl_select_arm_selectable(cs, h)
  var body = cl_lower_select_arm_body(cs, h, a, line, col)
  var selectable = 0
  if sel_cst != 0
    selectable = cst_lower_node(cs, sel_cst, a)
  end
  # De-sugar by lowered-AST kind (mirrors parser.qz exactly).
  if selectable != 0
    var ek = ast::ast_get_kind(a, selectable)
    if ek == node_constants::NODE_AWAIT
      var await_handle = ast::ast_get_left(a, selectable)
      return ast::ast_select_arm(a, 3, await_handle, binding, body, line, col)
    end
    if ek == node_constants::NODE_CALL
      var callee = ast::ast_get_left(a, selectable)
      if ast::ast_get_kind(a, callee) == node_constants::NODE_IDENT
        var callee_name = ast::ast_get_str1(a, callee)
        var call_args = ast::ast_get_children(a, selectable)
        var argc = 0
        if as_int(call_args) != 0
          argc = call_args.size
        end
        if str_eq(callee_name, "recv") == 1 and argc == 1
          return ast::ast_select_arm(a, 0, call_args[0], binding, body, line, col)
        end
        if str_eq(callee_name, "send") == 1 and argc == 2
          var arm = ast::ast_select_arm(a, 1, call_args[0], "", body, line, col)
          ast::ast_set_extra(a, arm, call_args[1])
          return arm
        end
        if str_eq(callee_name, "timeout") == 1 and argc == 1
          return ast::ast_select_arm(a, 4, call_args[0], "", body, line, col)
        end
      end
    end
  end
  # Phase 3+4a: any other expr → Selectable trait dispatch (op_kind 5), raw expr
  # stashed in the channel slot (typecheck resolves the impl + stamps str2).
  return ast::ast_select_arm(a, 5, selectable, binding, body, line, col)
end

## Binding name of a `case` select arm: the first token after `case` that is an
## identifier (or "" for `_`/none). The CST arm's tokens are, in order,
## `case`, then the binding, then `=`, `=>`. We scan for the first ident-or-`_`
## token after the leading `case`; `_` lexes to "" so we return "" for wildcard.
def cl_select_arm_binding(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var seen_case = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_case == 0
        seen_case = 1
      elsif str_eq(lex, "=") == 1 or str_eq(lex, "=>") == 1
        return ""
      elsif str_eq(lex, "_") == 1
        return ""
      else
        return lex
      end
    end
    j = j + 1
  end
  return ""
end

## The Selectable expression CST node of a `case` arm: the lone structured child
## that is NOT the body CST_BLOCK(43).
def cl_select_arm_selectable(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0 and cst::cst_get_kind(cs, c) != 43
      return c
    end
    j = j + 1
  end
  return 0
end

## Body of a select arm: the CST_BLOCK(43) child lowered via cl_lower_block (an
## empty block when none). Legacy bodies are always blocks here
## (ps_parse_block_until_end_or_arm always returns a NODE_BLOCK), so unlike match
## arms we never unwrap a lone statement.
def cl_lower_select_arm_body(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var blk = cl_child_of_kind(cs, h, 43)  # CST_BLOCK
  if blk == 0
    return ast::ast_block(a, as_int(vec_new()), line, col)
  end
  return cl_lower_block(cs, blk, a)
end

# ===========================================================================
# Postfix statement modifier (`<stmt> if|unless cond`) — CST_WHEN_GUARD(66)
# ===========================================================================
# cst_parser wraps a statement with a trailing same-line `if`/`unless`/`while`
# in a CST_WHEN_GUARD(66): children = [stmt, kw_tok, cond]. Legacy
# parser.qz:ps_maybe_wrap_postfix_guard lowers `if`/`unless` to a plain
# NODE_IF whose then-branch is a single-statement block (no else); `unless`
# additionally negates the condition with OpNot (13). Legacy has NO postfix
# `while` modifier — that form (absent from the corpus) stays a placeholder.

## Lowers a CST_WHEN_GUARD(66) statement modifier to a NODE_IF, mirroring
## parser.qz:5781-5823 byte-for-byte.
def cl_lower_postfix_guard(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var kw = cl_first_token_lexeme(cs, h)
  # Only `if`/`unless` are legacy statement modifiers; anything else is unmodeled.
  if str_eq(kw, "if") == 0 and str_eq(kw, "unless") == 0
    return ast::ast_ident(a, "__UNLOWERED_66", line, col)
  end
  var stmt_node = cl_structured_child(cs, h, 0)
  var cond_node = cl_structured_child(cs, h, 1)
  var stmt = cst_lower_node(cs, stmt_node, a)
  # Use the wrapped statement's source position for the synthesized if/block,
  # matching legacy (line/col read from the stmt node, not the guard keyword).
  var sline = ast::ast_get_line(a, stmt)
  var scol = ast::ast_get_col(a, stmt)
  var cond = cst_lower_node(cs, cond_node, a)
  if str_eq(kw, "unless") == 1
    cond = ast::ast_unary(a, 13, cond, sline, scol)  # OpNot
  end
  var then_stmts = vec_new()
  then_stmts.push(stmt)
  var then_block = ast::ast_block(a, as_int(then_stmts), sline, scol)
  return ast::ast_if(a, cond, then_block, 0 - 1, sline, scol)
end

# ===========================================================================
# Match (M1.3c-2 STAGE M-0): `match e ... end`
# ===========================================================================
# CST_MATCH (64) children = [match_kw, subject_expr, CST_MATCH_ARM*, end_kw].
# Each CST_MATCH_ARM (65) child carries, in order: an optional `when` token, the
# pattern (a structured CST_PAT_* node in the M-0 simple case, else verbatim
# tokens), a `=>` token, and the body (a CST_BLOCK for the do/bare forms, or
# verbatim braces for the `{ }` form). Subject + simple patterns + do/bare bodies
# lower to a real ast_match; non-simple arms keep a placeholder pattern so the
# arm still emits (the file stays DIFF but the tree is valid).

## Lowers a CST_MATCH (64) node to ast_match.
def cl_lower_match(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # The subject is the first structured child (the expr after the `match` kw).
  var subj = cst_lower_node(cs, cl_structured_child(cs, h, 0), a)
  var arms = vec_new()
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 65  # CST_MATCH_ARM
      arms.push(cl_lower_match_arm(cs, c, a))
    end
    j = j + 1
  end
  return ast::ast_match(a, subj, as_int(arms), line, col)
end

## Lowers a CST_MATCH_ARM (65). Pattern = the structured CST_PAT_* child if the
## arm was structured (M-0), else a `__UNLOWERED_matpat` placeholder (verbatim
## fallback). Guard = -1 (M-0 has no guards). Body mirrors legacy ps_parse_match_arm:
## the do-form is always a block; the bare-form unwraps a single statement (legacy
## only wraps in ast_block when >1 statement); the brace `{ }` form is verbatim in
## the CST and lowers to a placeholder (deferred).
def cl_lower_match_arm(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  # Guard (M-3): a CST_WHEN_GUARD(66) child holds `if <expr>`. Determine its
  # presence up-front because it changes how a bare-binding pattern lowers
  # (legacy parser.qz:4950-4964 — a NODE_IDENT pattern WITH a guard becomes a
  # wildcard, with the binding name moved onto the arm's str1 slot).
  var guard_ast = 0 - 1
  var has_guard = 0
  var guard_node = cl_match_arm_guard(cs, h)
  if guard_node != 0
    has_guard = 1
    var gexpr = cl_when_guard_expr(cs, guard_node)
    if gexpr != 0
      guard_ast = cst_lower_node(cs, gexpr, a)
    end
  end
  # Pattern: a structured CST_PAT_* child (kinds 75..82) if present.
  var pat_node = cl_match_arm_pattern(cs, h)
  var pattern_ast = 0
  var binding_name = ""
  if pat_node != 0
    if has_guard == 1 and cst::cst_get_kind(cs, pat_node) == 76  # CST_PAT_BINDING + guard
      binding_name = cl_first_token_lexeme(cs, pat_node)
      pattern_ast = ast::ast_wildcard(a, line, col)
    else
      pattern_ast = cl_lower_pattern(cs, pat_node, a)
    end
  else
    pattern_ast = ast::ast_ident(a, "__UNLOWERED_matpat", line, col)
  end
  # Body: the CST_BLOCK(43) child. Three shapes, distinguished by the arm's direct
  # token children: do-form (`do` token → always block), brace-form (`{` token →
  # always block, M-4), and bare-form (no `do`/`{` → unwrap a single statement).
  # Legacy parser.qz:4843-4856/4857-4870 emit `ast_block(stmts)` UNCONDITIONALLY
  # for both `{ }` and `do ... end`, whereas the bare run unwraps a lone statement.
  var has_do = cl_match_arm_has_do(cs, h)
  var has_brace = cl_match_arm_has_brace(cs, h)
  var blk = cl_child_of_kind(cs, h, 43)  # CST_BLOCK
  var body_ast = 0
  if blk == 0
    # No structured block child — the body stayed verbatim (a fallback capture).
    body_ast = ast::ast_ident(a, "__UNLOWERED_matbody", line, col)
  elsif has_do == 1 or has_brace == 1
    body_ast = cl_lower_block(cs, blk, a)
  else
    # Bare form: legacy emits the single statement directly when there is exactly
    # one; only wraps in a block when multiple statements follow.
    if cl_structured_count(cs, blk) == 1
      body_ast = cst_lower_node(cs, cl_structured_child(cs, blk, 0), a)
    else
      body_ast = cl_lower_block(cs, blk, a)
    end
  end
  var arm = ast::ast_match_arm(a, pattern_ast, guard_ast, body_ast, line, col)
  # Bare-binding-with-guard: stash the moved binding name on the arm str1 slot
  # (legacy parser.qz:4962-4964).
  if str_byte_len(binding_name) > 0
    ast::ast_set_str1(a, arm, binding_name)
  end
  return arm
end

## Finds the CST_WHEN_GUARD(66) child of a CST_MATCH_ARM (the `if <expr>` guard),
## or 0 if the arm has no guard. The guard wrapper is distinct from the pattern
## children (kinds 75..82), so a simple kind scan disambiguates.
def cl_match_arm_guard(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cst::cst_get_kind(cs, c) == 66
      return c
    end
    j = j + 1
  end
  return 0
end

## Returns the structured guard-expression child of a CST_WHEN_GUARD(66) match-arm
## guard (the first non-token child after the `if` keyword), or 0 if none.
def cl_when_guard_expr(cs: cst::CstStorage, g: Int): Int
  var n = cst::cst_child_count(cs, g)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, g, j)
    if cl_is_token(cs, c) == 0
      return c
    end
    j = j + 1
  end
  return 0
end

## Finds the structured pattern child of a CST_MATCH_ARM (a CST_PAT_* node, kinds
## 75..82), or 0 if the arm pattern stayed verbatim.
def cl_match_arm_pattern(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    var ck = cst::cst_get_kind(cs, c)
    if ck >= 75 and ck <= 82
      return c
    end
    j = j + 1
  end
  return 0
end

## True (1) if the arm has a `do` token child (do-block body form).
def cl_match_arm_has_do(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "do")
      return 1
    end
    j = j + 1
  end
  return 0
end

## True (1) if the arm has a `{` token child (M-4 brace-block body form). The
## brace `{ }` body lowers to `ast_block` unconditionally (legacy
## parser.qz:4843-4856), distinguishing it from the bare form that unwraps a
## single statement.
def cl_match_arm_has_brace(cs: cst::CstStorage, h: Int): Int
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1 and str_eq(cst::cst_get_str1(cs, c), "{")
      return 1
    end
    j = j + 1
  end
  return 0
end

## Lowers a CST_PAT_* node to its legacy AST pattern form. Mirrors
## parser.qz:ps_parse_pattern for the M-0 simple cases.
def cl_lower_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage): Int
  var line = cst::cst_get_line(cs, h)
  var col = cst::cst_get_col(cs, h)
  var k = cst::cst_get_kind(cs, h)
  if k == 75  # CST_PAT_WILDCARD
    return ast::ast_wildcard(a, line, col)
  end
  if k == 76  # CST_PAT_BINDING
    return ast::ast_ident(a, cl_first_token_lexeme(cs, h), line, col)
  end
  if k == 77  # CST_PAT_LITERAL
    return cl_lower_literal_pattern(cs, h, a, line, col)
  end
  if k == 78  # CST_PAT_VARIANT
    return cl_lower_variant_pattern(cs, h, a, line, col)
  end
  if k == 80  # CST_PAT_STRUCT
    return cl_lower_struct_pattern(cs, h, a, line, col)
  end
  if k == 79  # CST_PAT_TUPLE (vec destructure)
    return cl_lower_vec_pattern(cs, h, a, line, col)
  end
  if k == 81  # CST_PAT_OR
    return cl_lower_or_pattern(cs, h, a, line, col)
  end
  if k == 82  # CST_PAT_RANGE
    return cl_lower_range_pattern(cs, h, a, line, col)
  end
  return ast::ast_ident(a, "__UNLOWERED_pat#{k}", line, col)
end

## Lowers a CST_PAT_OR (81) → ast_or_pattern. The structured children are the
## alternative pattern nodes (the interleaved `|` token leaves are skipped);
## each is lowered via cl_lower_pattern and its handle pushed (raw, matching the
## ps_store_node idiom used by parser.qz:4792-4798) into the patterns Vec.
def cl_lower_or_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var pats = vec_new()
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 0
      pats.push(cl_lower_pattern(cs, c, a))
    end
    j = j + 1
  end
  return ast::ast_or_pattern(a, as_int(pats), line, col)
end

## Lowers a CST_PAT_RANGE (82) → ast_binary(left, OP_RANGE|OP_RANGE_INCLUSIVE,
## right). Children are [left_lit_pat, range_op_token, right_pat]. The op token
## lexeme picks the op code: `..` → 21 (OP_RANGE, exclusive), `...` → 23
## (OP_RANGE_INCLUSIVE) — the same mapping cl_lower_range uses (parser.qz:5491-5494).
def cl_lower_range_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var n = cst::cst_child_count(cs, h)
  var left_h = 0
  var right_h = 0
  var op = 21  # OP_RANGE (exclusive `..`)
  var seen_op = 0
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if str_eq(cst::cst_get_str1(cs, c), "...")
        op = 23  # OP_RANGE_INCLUSIVE
      end
      seen_op = 1
    else
      if seen_op == 0
        left_h = c
      else
        right_h = c
      end
    end
    j = j + 1
  end
  var l = cl_lower_pattern(cs, left_h, a)
  var r = cl_lower_pattern(cs, right_h, a)
  return ast::ast_binary(a, l, op, r, line, col)
end

## Lowers a CST_PAT_VARIANT (78) to ast_enum_access, reproducing
## parser.qz:ps_parse_pattern's enum-pattern handling EXACTLY:
##   - The `::`-chain over the leading TOKEN children forms the enum `name` and
##     `variant`. First ident → name; first `::IDENT` → variant; each additional
##     `::IDENT` rolls the current variant into the name (`name$variant`) and
##     sets the new ident as variant (parser.qz:5571-5585). Unqualified
##     `Variant(...)` (no `::`) → name="", variant=ident (parser.qz:5613-5631).
##   - The structured children are the payload sub-patterns. Two parallel Vecs are
##     built per `_ps_parse_pattern_arg` (parser.qz:5363-5438): `bound_names` and
##     `sub_pats`. For a binding sub-arg push `as_int(cl_intern_lex(<ident>))` /
##     the ast_ident; for `_` push `as_int(cl_intern_lex("_"))` / ast_wildcard;
##     for a nested variant or literal push `as_int(cl_intern_lex("_"))` (the
##     binding slot is a placeholder) / the recursively-lowered sub-pattern node.
##     bound_names is pushed RAW (as_int of the interned-String handle, matching
##     the struct-init field-name idiom); sub_pats wraps each node handle in as_int.
def cl_lower_variant_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  # Build the enum name + variant from the leading `::`-chain token leaves.
  var name = ""
  var variant = ""
  var seg_count = 0  # number of IDENT segments seen so far
  var n = cst::cst_child_count(cs, h)
  var j = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if str_eq(lex, "::") == 0 and str_eq(lex, "(") == 0 and str_eq(lex, ")") == 0 and str_eq(lex, ",") == 0
        # An IDENT segment of the path.
        if seg_count == 0
          name = lex
        elsif seg_count == 1
          variant = lex
        else
          name = "#{name}$#{variant}"
          variant = lex
        end
        seg_count = seg_count + 1
      end
    end
    j = j + 1
  end
  # Unqualified `Variant(...)` form: a single IDENT segment with no `::` → the
  # ident is the variant and the enum name is empty (parser.qz:5613-5631).
  if seg_count == 1
    variant = name
    name = ""
  end

  # Payload: walk structured sub-pattern children building the parallel Vecs.
  var bound_names = vec_new()
  var sub_pats = vec_new()
  var sc = cl_structured_count(cs, h)
  var i = 0
  while i < sc
    var sub = cl_structured_child(cs, h, i)
    var sk = cst::cst_get_kind(cs, sub)
    # bound_names key: a binding sub-arg binds its own lexeme; every other shape
    # (`_`, nested variant, literal) records the placeholder "_".
    var key = "_"
    if sk == 76  # CST_PAT_BINDING
      key = cl_first_token_lexeme(cs, sub)
      cl_check_binding_name(key, "match pattern binding", line, col)
    end
    bound_names.push(as_int(cl_intern_lex(key)))
    sub_pats.push(as_int(cl_lower_pattern(cs, sub, a)))
    i = i + 1
  end

  return ast::ast_enum_access(a, name, variant, as_int(bound_names), as_int(sub_pats), line, col)
end

## Lowers a CST_PAT_STRUCT (80) → ast_struct_destructure, reproducing
## parser.qz:ps_parse_struct_destr_fields EXACTLY. The TOKEN children are, in
## order: an optional leading type IDENT, the `{`, then the field tokens
## (`field`, optional `: alias`, `,` separators, an optional trailing `..`), then
## `}`. type_name = the leading ident before `{` (or "" for a bare `{…}`).
## field_specs = the field idents joined by `,` with NO spaces; a rename renders
## `field:alias`; a `..` sets has_rest=1 and is NOT added to the string. In a
## pattern context init=0 and is_mut=-1.
def cl_lower_struct_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var type_name = ""
  var field_specs = ""
  var has_rest = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  var seen_lbrace = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_lbrace == 0
        if str_eq(lex, "{") == 1
          seen_lbrace = 1
        else
          # The leading type ident.
          type_name = lex
        end
      else
        if str_eq(lex, "}") == 1
          j = n
        elsif str_eq(lex, "..") == 1
          has_rest = 1
        elsif str_eq(lex, ",") == 1
          # separator — skip
        elsif str_eq(lex, ":") == 1
          # separator between field and alias — skip
        else
          # A field ident. Peek the next token: if it's `:` this is a rename.
          var spec = lex
          if j + 1 < n
            var nxt = cst::cst_get_child(cs, h, j + 1)
            if cl_is_token(cs, nxt) == 1 and str_eq(cst::cst_get_str1(cs, nxt), ":") == 1
              var al = cst::cst_get_child(cs, h, j + 2)
              spec = "#{lex}:#{cst::cst_get_str1(cs, al)}"
              j = j + 2
            end
          end
          if str_byte_len(field_specs) > 0
            field_specs = "#{field_specs},#{spec}"
          else
            field_specs = spec
          end
        end
      end
    end
    j = j + 1
  end
  return ast::ast_struct_destructure(a, type_name, field_specs, 0, -1, has_rest, line, col)
end

## Lowers a CST_PAT_TUPLE (79, vec destructure) → ast_vec_destructure, reproducing
## parser.qz:ps_parse_vec_destr_elems EXACTLY. The TOKEN children are: the `[`,
## the element idents (`,`-separated), an optional trailing `..` with an optional
## rest ident, then `]`. elem_names = the element idents joined by `,` with NO
## spaces; rest_name = the ident after `..` (or "" if `..` had no name or no rest);
## has_rest=1 if a `..` appeared. init=0, is_mut=-1 in pattern context.
def cl_lower_vec_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  var elem_names = ""
  var rest_name = ""
  var has_rest = 0
  var n = cst::cst_child_count(cs, h)
  var j = 0
  var seen_lbracket = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      var lex = cst::cst_get_str1(cs, c)
      if seen_lbracket == 0
        if str_eq(lex, "[") == 1
          seen_lbracket = 1
        end
      else
        if str_eq(lex, "]") == 1
          j = n
        elsif str_eq(lex, ",") == 1
          # separator — skip
        elsif str_eq(lex, "..") == 1
          has_rest = 1
          # Optional rest binding name follows.
          if j + 1 < n
            var nxt = cst::cst_get_child(cs, h, j + 1)
            if cl_is_token(cs, nxt) == 1
              var nlex = cst::cst_get_str1(cs, nxt)
              if str_eq(nlex, "]") == 0
                rest_name = nlex
                j = j + 1
              end
            end
          end
        else
          # An element ident.
          if str_byte_len(elem_names) > 0
            elem_names = "#{elem_names},#{lex}"
          else
            elem_names = lex
          end
        end
      end
    end
    j = j + 1
  end
  return ast::ast_vec_destructure(a, elem_names, rest_name, 0, -1, has_rest, line, col)
end

## Lowers a CST_PAT_LITERAL (77) by inspecting its token child(ren). Mirrors the
## literal arms of ps_parse_pattern exactly (bool/int/float/string/regex/symbol,
## char→int code point, and `-N`→negative int).
def cl_lower_literal_pattern(cs: cst::CstStorage, h: Int, a: ast::AstStorage, line: Int, col: Int): Int
  # Negative-int form: two token children `-` then INT.
  if cl_pattern_is_negative_int(cs, h) == 1
    var nlex = cl_pattern_second_token_lexeme(cs, h)
    return ast::ast_int_lit(a, 0 - lexer::ps_parse_int_value(nlex), line, col)
  end
  var lex = cl_first_token_lexeme(cs, h)
  var b0 = 0
  if str_byte_len(lex) > 0
    b0 = str_byte_at(lex, 0)
  end
  # Regex pattern FIRST (before the string/span check): a regex literal pattern
  # `~r"..."` (TOK_REGEX) has its `~r"` + `"` wrapper STRIPPED by the lexer
  # (lexer.qz:1838-1841), so its lexeme is the bare pattern but its source span
  # covers the 4 wrapper bytes (`~r"` = 3, closing `"` = 1). A plain string
  # `"..."` strips only the 2 quote bytes. Discriminate by wrapper width: a
  # span exactly 4 wider than the lexeme is a regex literal, which must lower to
  # NODE_REGEX_LIT (parser.qz:5512-5515) — NOT to a string lit via the broader
  # span check below. Without this, `~r"^[0-9]+$"` in a match arm mis-lowers to
  # a string pattern and the regex-arm match miscompiles.
  if (cst::cst_get_byte_end(cs, h) - cst::cst_get_byte_start(cs, h)) == str_byte_len(lex) + 4
    return ast::ast_regex_lit(a, lex, line, col)
  end
  # String literal FIRST (before the bool-keyword checks): the lexer STRIPS the
  # surrounding quotes (and unescapes) from a TOK_STRING lexeme — so a string
  # pattern `"true"` / `"false"` carries the bare lexeme `true` / `false` that
  # would otherwise collide with the bool-keyword checks below and mis-lower to
  # NODE_BOOL_LIT. Detect a string by the source span: a string token's span
  # covers the original `"..."` (>= lexeme bytes + the two quotes), whereas every
  # other CST_PAT_LITERAL keeps its source form verbatim (span == lexeme length).
  # The legacy `b0 == 34` test is kept for any path that retains a leading quote.
  if b0 == 34 or (cst::cst_get_byte_end(cs, h) - cst::cst_get_byte_start(cs, h)) > str_byte_len(lex)
    return ast::ast_string_lit(a, lex, line, col)
  end
  if str_eq(lex, "true")
    return ast::ast_bool_lit(a, 1, line, col)
  end
  if str_eq(lex, "false")
    return ast::ast_bool_lit(a, 0, line, col)
  end
  # Char literal: lexeme starts with `'` → decode to int code point.
  if b0 == 39
    return ast::ast_int_lit(a, cl_decode_char_lexeme(lex), line, col)
  end
  # Symbol literal: lexeme starts with `:`.
  if b0 == 58
    return ast::ast_symbol_lit(a, lex, line, col)
  end
  # Regex literal: lexeme starts with `/`.
  if b0 == 47
    return ast::ast_regex_lit(a, lex, line, col)
  end
  # Float literal: lexeme contains a `.` (and is otherwise numeric).
  if cl_lexeme_is_float(lex) == 1
    return ast::ast_float_lit(a, lex, line, col)
  end
  # Int literal (default numeric).
  return ast::ast_int_lit(a, lexer::ps_parse_int_value(lex), line, col)
end

## True (1) if a CST_PAT_LITERAL holds a `-` token followed by an INT token.
def cl_pattern_is_negative_int(cs: cst::CstStorage, h: Int): Int
  var first_lex = cl_first_token_lexeme(cs, h)
  if str_eq(first_lex, "-")
    return 1
  end
  return 0
end

## Lexeme of the SECOND token child of a node (empty if fewer than two).
def cl_pattern_second_token_lexeme(cs: cst::CstStorage, h: Int): String
  var n = cst::cst_child_count(cs, h)
  var j = 0
  var seen = 0
  while j < n
    var c = cst::cst_get_child(cs, h, j)
    if cl_is_token(cs, c) == 1
      if seen == 1
        return cst::cst_get_str1(cs, c)
      end
      seen = seen + 1
    end
    j = j + 1
  end
  return ""
end

## Decodes a char-literal lexeme (`'A'`, `'\n'`, …) to its int code point,
## mirroring parser.qz:5519-5544.
def cl_decode_char_lexeme(lex: String): Int
  var n = str_byte_len(lex)
  if n == 3
    return str_byte_at(lex, 1)
  end
  if n == 4
    var esc_c = str_byte_at(lex, 2)
    if esc_c == 'n'
      return '\n'
    end
    if esc_c == 't'
      return '\t'
    end
    if esc_c == 'r'
      return '\r'
    end
    if esc_c == '0'
      return 0
    end
    if esc_c == '\\'
      return '\\'
    end
    if esc_c == 39
      return 39
    end
    return esc_c
  end
  return 0
end

## True (1) if `lex` is a float literal (contains a `.`, first byte a digit).
def cl_lexeme_is_float(lex: String): Int
  var n = str_byte_len(lex)
  if n == 0
    return 0
  end
  var b0 = str_byte_at(lex, 0)
  if b0 < '0' or b0 > '9'
    return 0
  end
  var j = 0
  while j < n
    if str_byte_at(lex, j) == '.'
      return 1
    end
    j = j + 1
  end
  return 0
end
