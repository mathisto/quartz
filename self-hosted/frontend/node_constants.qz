##! # Node Constants
##!
##! AST node kind constants.
##!
##! @see ast
##! @since 1.0.0

# node_constants.qz - Single source of truth for AST node kind values
# MUST match the NodeType enum in quartz-bootstrap/src/ast.h
#
# Used by: resolver.qz, quartz.qz (and eventually typecheck.qz, mir.qz, etc.)
# Mirrors: token_constants.qz pattern for token type values

# === Expressions ===
## Integer literal node.
const NODE_INT_LIT = 0
## Boolean literal node.
const NODE_BOOL_LIT = 1
## Nil literal node.
const NODE_NIL_LIT = 2
## String literal node.
const NODE_STRING_LIT = 3
## Symbol literal node.
const NODE_SYMBOL_LIT = 4
## Regex literal node.
const NODE_REGEX_LIT = 5
## Identifier node.
const NODE_IDENT = 6
## Unary operation node.
const NODE_UNARY = 7
## Binary operation node.
const NODE_BINARY = 8
## Function call node.
const NODE_CALL = 9
## Array literal node.
const NODE_ARRAY = 10
## Set literal node.
const NODE_SET_LITERAL = 11
## Map literal node.
const NODE_MAP_LIT = 12
## Index access node.
const NODE_INDEX = 13
## Struct initialization node.
const NODE_STRUCT_INIT = 14
## Field access node.
const NODE_FIELD_ACCESS = 15
## Safe field access node.
const NODE_SAFE_FIELD_ACCESS = 16
## Try expression node (?).
const NODE_TRY_EXPR = 17
## Function reference node (&func).
const NODE_FUNC_REF = 18
## Lambda function node.
const NODE_LAMBDA = 19
## Allocation expression node (@arena).
const NODE_ALLOC_EXPR = 20
## Capture variable node ($1, $2).
const NODE_CAPTURE_VAR = 21

# === Statements ===
## Return statement node.
const NODE_RETURN = 22
## If statement node.
const NODE_IF = 23
## While loop node.
const NODE_WHILE = 24
## Let binding node.
const NODE_LET = 25
## Assignment node.
const NODE_ASSIGN = 26
## Index assignment node.
const NODE_INDEX_ASSIGN = 27
## Field assignment node.
const NODE_FIELD_ASSIGN = 28
## Expression statement node.
const NODE_EXPR_STMT = 29
## Break statement node.
const NODE_BREAK = 30
## Continue statement node.
const NODE_CONTINUE = 31

# === Structure ===
## Block node.
const NODE_BLOCK = 32
## Function parameter node.
const NODE_PARAM = 33
## Function definition node.
const NODE_FUNCTION = 34
## Program root node.
const NODE_PROGRAM = 35
## Struct definition node.
const NODE_STRUCT_DEF = 36
## Field definition node.
const NODE_FIELD_DEF = 37
## Enum definition node.
const NODE_ENUM_DEF = 38
## Enum access node.
const NODE_ENUM_ACCESS = 39
## Match expression node.
const NODE_MATCH = 40
## Match arm node.
const NODE_MATCH_ARM = 41
## Wildcard pattern node.
const NODE_WILDCARD = 42

# === Surface Syntax ===
## Interpolated string node.
const NODE_INTERP_STRING = 43
## For loop node.
const NODE_FOR = 44
## Compound assignment node (+=).
const NODE_COMPOUND_ASSIGN = 45
## List comprehension node.
const NODE_LIST_COMP = 46
## Map comprehension node.
const NODE_MAP_COMP = 47
## Set comprehension node.
const NODE_SET_COMP = 48

# === Module System ===
## Import statement node.
const NODE_IMPORT = 48

# === Global Variables ===
## Global variable definition node.
const NODE_GLOBAL_VAR = 49

# === Trait System ===
## Trait definition node.
const NODE_TRAIT_DEF = 50
## Implementation block node.
const NODE_IMPL_BLOCK = 51
## Extend block node.
const NODE_EXTEND_BLOCK = 52

# === FFI ===
## External function declaration node.
const NODE_EXTERN_FN = 53
## External variable declaration node.
const NODE_EXTERN_VAR = 76
## Inline C code node.
const NODE_INLINE_C = 54
## C header include node.
const NODE_C_INCLUDE = 55
## C import node.
const NODE_C_IMPORT = 56

# === Concurrency ===
## Await expression node.
const NODE_AWAIT = 58
## Select statement node.
const NODE_SELECT = 59
## Select arm node.
const NODE_SELECT_ARM = 60

# === Memory Management ===
## Defer statement node.
const NODE_DEFER = 61
## Arena block node.
const NODE_ARENA_BLOCK = 62

# === Error Handling ===
## Try-catch block node.
const NODE_TRY_CATCH = 63

# === Type Aliases ===
## Type alias definition node.
const NODE_TYPE_ALIAS = 64
## Newtype definition node.
const NODE_NEWTYPE_DEF = 65

# === Quartz-only Extensions (66+) ===
## Variant definition node.
const NODE_VARIANT_DEF = 66
## Macro call node.
const NODE_MACRO_CALL = 67
## Float literal node.
const NODE_FLOAT_LIT = 68
## Constant declaration node.
const NODE_CONST_DECL = 69
## Static assertion node.
const NODE_STATIC_ASSERT = 70
## Task group expression node.
const NODE_TASK_GROUP = 71
## Macro definition node.
const NODE_MACRO_DEF = 72
## Quote block node.
const NODE_QUOTE = 73
## Unquote expression node.
const NODE_UNQUOTE = 74
## Unquote-each expression node.
const NODE_UNQUOTE_EACH = 75

# === Tuples ===
## Tuple literal expression node: (a, b, c).
const NODE_TUPLE_LITERAL = 77
## Let destructuring node: var (a, b) = expr.
const NODE_LET_DESTRUCTURE = 78

# === Destructuring ===
## Struct destructuring node: Point { x, y } = expr / var { x, y } = expr.
## str1=type_name, str2=field_specs (comma-sep "x,y" or "x:px,y:py"), int_val=is_mut, left=init, op=has_rest, extra=0.
## In match/for-in pattern context: left=0 (subject implicit), int_val=-1.
const NODE_STRUCT_DESTRUCTURE = 79
## Vec destructuring node: [a, b, ..rest] = expr.
## str1=elem_names (comma-sep), str2=rest_name ("" if none), int_val=is_mut, left=init, op=has_rest.
## In match/for-in pattern context: left=0 (subject implicit), int_val=-1.
const NODE_VEC_DESTRUCTURE = 80
## Or-pattern node: pat1 | pat2 | pat3
## children=sub-patterns
const NODE_OR_PATTERN = 81
## Spread operator node: ...expr in array literals
## left=inner expression (the vec being spread), all other fields=0
const NODE_SPREAD = 82
## Yield expression node: yield expr
## left=value expression, all other fields=0
const NODE_YIELD = 83
## Async call expression: async func(args)
## left=inner call expression (NODE_CALL)
const NODE_ASYNC_CALL = 84

## Go expression: go func(args) — spawn lightweight task on M:N scheduler
## left=inner call expression (NODE_CALL)
const NODE_GO = 85

## For-await loop: for await x in channel — async iterator over channel
## str1=binding name, left=channel expression, right=body block
const NODE_FOR_AWAIT = 86

## Protocol definition: protocol ReqResp<Req, Resp> ... end
## str1=name, str2=type_params, children=steps (NODE_PROTOCOL_STEP nodes)
const NODE_PROTOCOL_DEF = 87

## Protocol step: send Type / recv Type
## int_val=step kind (1=send, 2=recv), str1=type name
const NODE_PROTOCOL_STEP = 88

## Protocol choice: choice ... or ... end
## children=branches (each branch is a list of NODE_PROTOCOL_STEP nodes)
const NODE_PROTOCOL_CHOICE = 89

## Protocol loop: loop ... end
## children=body steps (NODE_PROTOCOL_STEP nodes)
const NODE_PROTOCOL_LOOP = 90

## Actor definition: actor Name ... end
## str1=name, str2=type_params, int_val=is_private
## children=mix of NODE_FIELD_DEF (state vars) and NODE_FUNCTION (methods)
const NODE_ACTOR_DEF = 91

## Is-check binding pattern: `if expr is VariantName(binding)`
## Boolean tag check that can also bind variant fields. Used by typecheck_walk
## for narrowing and by mir_lower for codegen.
## str1=variant_name, children=[expr, ...binding_idents]
const NODE_IS_CHECK = 92

## Binary DSL block: `type Foo = binary { field: type, ... }`
## Top-level declaration describing how to serialize/deserialize a byte stream.
## str1=type_name, children=Vec<NODE_BINARY_FIELD>
const NODE_BINARY_BLOCK = 93

## Packed struct: `packed struct(uN) Name ... end`
## Register-layout type backed by an integer of width N.
## str1=type_name, int_val=backing_width (8/16/32/64), children=Vec<NODE_BINARY_FIELD>
const NODE_PACKED_STRUCT = 94

## Binary/packed field: `name: type` or `name: bitwidth`
## Child of NODE_BINARY_BLOCK or NODE_PACKED_STRUCT.
## str1=field_name ("" or "_" for pad), str2=type_spec, int_val=bit_width (0 = variable/unknown)
const NODE_BINARY_FIELD = 95

## Binary packed-struct immutable update: `value.with { field = expr; ... }`
## STEP 5 of Binary DSL Phase 1.4. Children are NODE_ASSIGN-shaped entries
## (str1=field_name, left=value expression). left slot of this node is the
## receiver expression (value being derived from).
const NODE_BINARY_WITH = 96

## Typed bitcast: `expr as TypeName` — STEP 3 of Binary DSL Phase 1.4.
## left = source expression, str1 = target type name (e.g. "u32", "GpioModer").
## Strictly a bitcast between a packed struct and its backing integer.
## Any other source/target pair is a typecheck error.
const NODE_TYPE_CAST = 97

## Binary DSL discriminated union: `match <discriminator> <arms> end` inside a
## `binary {}` block — Phase 2 Track B. str1 = discriminator field name.
## children = Vec<NODE_BINARY_UNION_ARM>. Must appear after the discriminator
## field in the binary block's child list. Parent is always NODE_BINARY_BLOCK.
const NODE_BINARY_UNION = 98

## One arm of a discriminated union. int_val = tag integer value,
## children = Vec<NODE_BINARY_FIELD> (may be empty). Parent is NODE_BINARY_UNION.
const NODE_BINARY_UNION_ARM = 99

## Effect declaration: `effect Name<T> ... end` — Operation Piezoelectric
## Effects, Phase 1, Milestone B. str1 = effect name, children = Vec<Int>
## of NODE_FUNCTION handles (one per declared op signature). Type params
## are currently consumed and discarded (no generics on effect decls in B).
const NODE_EFFECT_DECL = 100

## Handler installation block: `with Handler do -> body end` — Operation
## Piezoelectric Effects, Phase 1, Milestone C. left = handler expression
## (any expression whose value is a handler struct), right = body
## NODE_BLOCK. Milestone C.1 captures the handler; C.2 uses it for row
## narrowing; C.4 lowers it to MIR_HANDLE_INSTALL/UNINSTALL. For C.1 the
## semantics still body-forward like a plain block — only the AST shape
## changes.
const NODE_WITH = 101

## Projected data-borrow `&mut p.f` / `&mut a[i]` / `&p.f` — WS4 Step 0.
## Unlike NODE_FUNC_REF (18) which double-serves function-references and
## BASE-only borrows and stores only str1=name, NODE_BORROW carries the FULL
## lowered operand place-expression (NODE_FIELD_ACCESS / NODE_INDEX subtree) in
## `left`, and int_val=is_mut. A bare-ident borrow still lowers to NODE_FUNC_REF
## (byte-identical); only PROJECTED operands become NODE_BORROW. This lets the
## exclusivity checker reason about `p.f` vs `p.g` (disjoint) and `a[i]`
## (IndexDyn) instead of collapsing to the base.
const NODE_BORROW = 102

# ============================================================================
# Resolver Tags - used in all_funcs entries [ast_store, node_handle, name, tag]
# ============================================================================
# These tag values identify the type of definition collected by the resolver.
# Used by resolver.qz (resolve_collect_funcs) and quartz.qz (compile pipeline).

## Resolved function tag.
const RESOLVE_TAG_FUNC = 0
## Resolved global variable tag.
const RESOLVE_TAG_GLOBAL_VAR = 1
## Resolved constant declaration tag.
const RESOLVE_TAG_CONST_DECL = 2
## Resolved static assertion tag.
const RESOLVE_TAG_STATIC_ASSERT = 3
## Resolved struct definition tag.
const RESOLVE_TAG_STRUCT_DEF = 4
## Resolved enum definition tag.
const RESOLVE_TAG_ENUM_DEF = 5
## Resolved type alias tag.
const RESOLVE_TAG_TYPE_ALIAS = 6
## Resolved newtype definition tag.
const RESOLVE_TAG_NEWTYPE_DEF = 7
## Resolved trait definition tag.
const RESOLVE_TAG_TRAIT_DEF = 8
## Resolved implementation block tag.
const RESOLVE_TAG_IMPL_BLOCK = 9
## Resolved actor definition tag.
const RESOLVE_TAG_ACTOR_DEF = 12

## Resolved binary-DSL block tag.
## `type Name = binary { ... }` — gets registered as a struct-like type
## so `TypeName { field: ... }` literals and `.field` access work, with
## synthesized `.encode()` / `Type.decode(bytes)` methods added in STEP 2.
const RESOLVE_TAG_BINARY_BLOCK = 13

## Resolved packed-struct tag.
## `packed struct(uN) Name ... end` — register-layout type backed by an
## integer of width N. Registered as a struct-like type; `as uN` bitcast
## and `.with { ... }` immutable update synthesized in STEP 2.
const RESOLVE_TAG_PACKED_STRUCT = 14
