## Creates an arena block node: `arena name do ... end`
## @param s AstStorage struct
## @param name Arena name identifier
## @param stmts Body statements vector
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_arena_block(s: AstStorage, name: String, stmts: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(62)  # NODE_ARENA_BLOCK = 62
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(stmts)
  s.docs.push(0)
  return h
end

