## Create a defer statement node.
##
## The deferred expression will be executed on function exit.
## Parameters:
##   s    - AST storage
##   expr - Expression to defer (typically a function call)
##   line - Line number
##   col  - Column number
##
## Returns: Node handle
def ast_defer(s: AstStorage, expr: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(61)  # NODE_DEFER = 61
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)     # int_val
  s.str1s.push(0)     # str1
  s.str2s.push(0)     # str2
  s.ops.push(0)     # op
  s.lefts.push(expr)  # left = deferred expression
  s.rights.push(0)     # right
  s.extras.push(0)     # extra
  s.children.push(0)    # children
  s.docs.push(0)    # doc
  return h
end

# ============================================================================
# AST Accessor Helpers - Reduce Repetitive Pattern Access
# ============================================================================

## Get node metadata (kind, line, col) in one call.
## Returns: Vec with [kind, line, col]
def ast_get_metadata(s: AstStorage, node: AstNodeId): Int
  var kind = ast_get_kind(s, node)
  var line = ast_get_line(s, node)
  var col = ast_get_col(s, node)
  return [kind, line, col]
end

## Extract binary operator data (left, right, op) in one call.
## Returns: Vec with [left, right, op]
def ast_extract_binary(s: AstStorage, node: AstNodeId): Int
  var left = ast_get_left(s, node)
  var right = ast_get_right(s, node)
  var op = ast_get_op(s, node)
  return [left, right, op]
end

## Extract call data (callee, args) in one call.
## Returns: Vec with [callee, args]
def ast_extract_call(s: AstStorage, node: AstNodeId): Int
  var callee = ast_get_left(s, node)
  var args = ast_get_children(s, node)
  return [callee, args]
end

## Extract let binding data (name, init, is_mutable) in one call.
## Returns: Vec with [name, init, is_mutable]
def ast_extract_let(s: AstStorage, node: AstNodeId): Int
  var name = ast_get_str1(s, node)
  var init_node = ast_get_left(s, node)
  var is_mutable = ast_get_int_val(s, node)
  return [as_int(name), init_node, is_mutable]
end

## Extract assign data (target, value) in one call.
## Returns: Vec with [target, value]
def ast_extract_assign(s: AstStorage, node: AstNodeId): Int
  var target = ast_get_str1(s, node)
  var value = ast_get_left(s, node)
  return [as_int(target), value]
end

## Extract struct init data (struct_name, fields, field_names) in one call.
## Returns: Vec with [struct_name, fields, field_names]
def ast_extract_struct_init(s: AstStorage, node: AstNodeId): Int
  var struct_name = ast_get_str1(s, node)
  var fields = ast_get_children(s, node)
  var field_names = ast_get_struct_init_field_names(s, node)
  return [as_int(struct_name), fields, field_names]
end

## Extract match arm data (pattern, body) in one call.
## Returns: Vec with [pattern, body]
def ast_extract_match_arm(s: AstStorage, node: AstNodeId): Int
  var pattern = ast_get_left(s, node)
  var body = ast_get_right(s, node)
  return [pattern, body]
end

## Extract function data (name, params, return_type, body) in one call.
## Returns: Vec with [name, params, return_type, body]
def ast_extract_function(s: AstStorage, node: AstNodeId): Int
  var name = ast_get_str1(s, node)
  var params = ast_get_left(s, node)
  var return_type = ast_get_str2(s, node)
  var body = ast_get_right(s, node)
  return [as_int(name), params, as_int(return_type), body]
end

## ============================================================================
## Concurrency AST Nodes
## ============================================================================

## Create an await expression node.
##
## Waits for a spawned task to complete and returns its result.
##
## Params:
## - s: AST storage
## - handle: The task handle from a spawn expression
## - line, col: Source location
##
## Returns: Node handle
def ast_await(s: AstStorage, handle: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(58)  # NODE_AWAIT = 58
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)       # int_val
  s.str1s.push(0)       # str1
  s.str2s.push(0)       # str2
  s.ops.push(0)       # op
  s.lefts.push(handle)  # left: task handle expression
  s.rights.push(0)       # right
  s.extras.push(0)       # extra
  s.children.push(0)      # children
  s.docs.push(0)      # doc
  return h
end

## Create a yield expression node.
##
## Yields a value from a generator function (impl Iterator<T>).
##
## Params:
## - s: AST storage
## - value: The expression to yield
## - line, col: Source location
##
## Returns: Node handle
def ast_yield(s: AstStorage, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(83)  # NODE_YIELD = 83
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(value)  # left: yielded value
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create an async call node: async func(args).
## left: inner call expression (NODE_CALL)
def ast_async_call(s: AstStorage, inner_call: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(84)  # NODE_ASYNC_CALL = 84
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(inner_call)  # left: inner call expression
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a go expression node: go func(args)
## Desugars to: async func(args) → sched_spawn → return handle
def ast_go_call(s: AstStorage, inner_call: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(85)  # NODE_GO = 85
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(inner_call)  # left: inner call expression
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a protocol definition node.
## str1=name, str2=type_params, children=steps, int_val=is_private
def ast_protocol_def(s: AstStorage, name: String, type_params: String, steps: Int, is_private: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(87)  # NODE_PROTOCOL_DEF = 87
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_private)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_params)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(steps)
  s.docs.push(0)
  return h
end

## Create a protocol step node.
## int_val=step kind (1=send, 2=recv), str1=type name
def ast_protocol_step(s: AstStorage, step_kind: Int, type_name: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(88)  # NODE_PROTOCOL_STEP = 88
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(step_kind)
  ast_intern_push_str1(s, type_name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a protocol choice node: choice ... or ... end
## int_val=number of branches, children=flat list of branch step vecs
## Each branch is a vec handle containing NODE_PROTOCOL_STEP nodes.
def ast_protocol_choice(s: AstStorage, branches: Int, num_branches: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(89)  # NODE_PROTOCOL_CHOICE = 89
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(num_branches)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(branches)
  s.docs.push(0)
  return h
end

## Create a protocol loop node: loop ... end
## children=body steps (NODE_PROTOCOL_STEP nodes)
def ast_protocol_loop(s: AstStorage, body_steps: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(90)  # NODE_PROTOCOL_LOOP = 90
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(body_steps)
  s.docs.push(0)
  return h
end

## Create a select statement node.
##
## Waits on multiple channel operations. First ready arm executes.
##
## Params:
## - s: AST storage
## - arms: Vector of NodeSelectArm handles
## - line, col: Source location
##
## Returns: Node handle
def ast_select(s: AstStorage, arms: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(59)  # NODE_SELECT = 59
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)     # int_val
  s.str1s.push(0)     # str1
  s.str2s.push(0)     # str2
  s.ops.push(0)     # op
  s.lefts.push(0)     # left
  s.rights.push(0)     # right
  s.extras.push(0)     # extra
  s.children.push(arms) # children: select arms
  s.docs.push(0)    # doc
  return h
end

## Create a select arm node.
##
## Represents one arm in a select statement (C.13 unified syntax —
## written `case <pat> = <expr> => body` and `default => body`; the
## parser de-sugars the legacy callee names into op-kind tags so MIR
## keeps the existing per-op-kind dispatch).
##
## - recv(ch) as x => body  (op_kind = 0)
## - send(ch, v) => body    (op_kind = 1)
## - default => body        (op_kind = 2)
## - await(task) as x => body (op_kind = 3)
## - timeout(ms) => body    (op_kind = 4)
##
## Params:
## - s: AST storage
## - op_kind: 0=recv, 1=send, 2=default, 3=await, 4=timeout
## - channel: Channel/task/timeout-ms expression (0 for default)
## - binding: Binding name for recv/await, "" for send/default/timeout
## - body: Body block to execute
## - line, col: Source location
##
## Returns: Node handle
def ast_select_arm(s: AstStorage, op_kind: Int, channel: Int, binding: String, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(60)  # NODE_SELECT_ARM = 60
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)               # int_val
  ast_intern_push_str1(s, binding) # str1: binding name or ""
  s.str2s.push(0)               # str2: Phase 3+4a — Selectable impl struct name (op_kind=5)
  s.ops.push(op_kind)         # op: 0=recv, 1=send, 2=default, 3=await, 4=timeout, 5=Selectable
  s.lefts.push(channel)         # left: channel expression / Selectable expression (op_kind=5)
  s.rights.push(body)            # right: body block
  s.extras.push(0)               # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## C.13 Phase 3: get the resolved Selectable-impl struct name stamped on
## a NODE_SELECT_ARM by typecheck (`tc_check_select_node`), or "" when
## the arm is not a user-defined Selectable (op_kind != 5). Stored in
## str2 — mirrors the `ast_with_scoped_struct` pattern on NODE_WITH.
def ast_select_arm_struct(s: AstStorage, h: AstNodeId): String = ast_get_str2(s, h)

## C.13 Phase 3: stamp the resolved Selectable impl's struct name onto a
## NODE_SELECT_ARM. Called from `tc_check_select_node` once the impl
## lookup confirms a `Selectable` impl exists for the selectable
## expression's struct type.
def ast_select_arm_set_struct(s: AstStorage, h: AstNodeId, name: String): Void
  ast_set_str2(s, h, name)
end

## ast_macro_call() - Create a macro call node
##
## Represents $name(args...) syntax for built-in macros.
## After macro expansion, these are replaced by their expansions.
##
## @param s AstStorage struct
## @param name Macro name string (e.g., "try", "unwrap")
## @param args Vector of argument handles
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_macro_call(s: AstStorage, name: String, args: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(67)  # NODE_MACRO_CALL = 67
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  ast_intern_push_str1(s, name)   # str1: macro name
  s.str2s.push(0)              # str2
  s.ops.push(0)              # op
  s.lefts.push(0)              # left
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(args)          # children: macro arguments
  s.docs.push(0)             # doc
  return h
end

## Create a macro definition node.
def ast_macro_def(s: AstStorage, name: String, params: Int, body: Int, is_variadic: Int, variadic_param: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(72)  # NODE_MACRO_DEF = 72
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_variadic)    # int_val: 1 if variadic
  ast_intern_push_str1(s, name)              # str1: macro name
  ast_intern_push_str2(s, variadic_param)    # str2: variadic param name
  s.ops.push(0)                   # op
  s.lefts.push(body)              # left: body node (string template or quote)
  s.rights.push(0)                # right
  s.extras.push(0)                # extra
  s.children.push(params)         # children: param name nodes
  s.docs.push(0)                 # doc
  return h
end

## Create a quote block node.
def ast_quote(s: AstStorage, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(73)  # NODE_QUOTE = 73
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(body)              # left: quoted body
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create an unquote expression node.
def ast_unquote(s: AstStorage, expr: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(74)  # NODE_UNQUOTE = 74
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(expr)              # left: expression to splice
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create an unquote_each expression node.
def ast_unquote_each(s: AstStorage, list_expr: Int, binding: String, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(75)  # NODE_UNQUOTE_EACH = 75
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, binding)           # str1: loop variable name
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(list_expr)         # left: list expression
  s.rights.push(body)             # right: template body
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create an allocation expression node.
##
## Heap allocation: @heap expr
## Arena allocation: @arena_name expr
##
## Params:
## - s: AST storage
## - target: Allocation target ("heap" or arena name)
## - expr: Expression to allocate
## - line, col: Source location
##
## Returns: Node handle
def ast_alloc_expr(s: AstStorage, target: String, expr: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(20)  # NODE_ALLOC_EXPR = 20
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  ast_intern_push_str1(s, target) # str1: allocation target
  s.str2s.push(0)              # str2
  s.ops.push(0)              # op
  s.lefts.push(expr)           # left: expression to allocate
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## Create a const declaration node.
##
## Syntax: const NAME = expr
##
## Compile-time constant declaration. The initializer must be
## const-evaluable (literals, arithmetic, references to other consts).
##
## Params:
## - s: AST storage
## - name: Constant name
## - init: Initializer expression handle
## - line: Source line number
## - col: Source column number
##
## Returns: Node handle
def ast_const_decl(s: AstStorage, name: String, init: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(69)  # NODE_CONST_DECL = 69
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val: evaluated value (filled by MIR)
  ast_intern_push_str1(s, name)  # str1: constant name
  s.str2s.push(0)              # str2
  s.ops.push(0)              # op
  s.lefts.push(0)              # left
  s.rights.push(init)           # right: initializer expression
  s.extras.push(0)              # extra: is_evaluated flag
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## Create a static_assert node.
##
## Syntax: static_assert(condition, "message")
##
## Compile-time assertion. Condition must be const-evaluable.
## If false, compilation fails with the given message.
##
## Params:
## - s: AST storage
## - condition: Condition expression handle
## - message: Error message string
## - line: Source line number
## - col: Source column number
##
## Returns: Node handle
def ast_static_assert(s: AstStorage, condition: Int, message: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(70)  # NODE_STATIC_ASSERT = 70
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  s.str1s.push(0)              # str1
  ast_intern_push_str2(s, message)  # str2: error message
  s.ops.push(0)              # op
  s.lefts.push(condition)      # left: condition expression
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

def ast_task_group(s: AstStorage, binding_name: String, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(71)  # NODE_TASK_GROUP = 71
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)                    # int_val
  ast_intern_push_str1(s, binding_name)    # str1: binding name
  s.str2s.push(0)                       # str2
  s.ops.push(0)                         # op
  s.lefts.push(body)                    # left: body block
  s.rights.push(0)                      # right
  s.extras.push(0)                      # extra
  s.children.push(0)                    # children
  s.docs.push(0)                        # doc
  return h
end

def ast_tuple_literal(s: AstStorage, elements: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(77)  # NODE_TUPLE_LITERAL = 77
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(elements)
  s.docs.push(0)
  return h
end

# Let destructuring: var (a, b) = expr
# str1 = comma-separated binding names: "a,b,c"
# left = init expression
# int_val = is_mutable (0 or 1)
def ast_let_destructure(s: AstStorage, names: String, init: Int, is_mut: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(78)  # NODE_LET_DESTRUCTURE = 78
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  s.str1s.push(string_intern::intern_id(s.interner, names))
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(init)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Struct destructuring: Point { x, y } = expr / var { x, y } = expr.
## type_name: struct type name (e.g. "Point"), or "" for inferred type.
## field_specs: comma-separated field bindings (e.g. "x,y" or "x:px,y:py").
## init: initializer expression handle (0 in pattern context).
## is_mut: 0=immutable, 1=mutable, -1=pattern context (match/for-in).
## has_rest: 1 if `..` present, 0 otherwise.
def ast_struct_destructure(s: AstStorage, type_name: String, field_specs: String, init: Int, is_mut: Int, has_rest: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(79)  # NODE_STRUCT_DESTRUCTURE
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  ast_intern_push_str1(s, type_name)
  ast_intern_push_str2(s, field_specs)
  s.ops.push(has_rest)
  s.lefts.push(init)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Vec destructuring: [a, b, ..rest] = expr.
## elem_names: comma-separated element bindings (e.g. "first,second").
## rest_name: rest binding name (e.g. "rest"), or "" if `..` with no name or no rest.
## init: initializer expression handle (0 in pattern context).
## is_mut: 0=immutable, 1=mutable, -1=pattern context (match/for-in).
## has_rest: 1 if `..` present, 0 otherwise.
def ast_vec_destructure(s: AstStorage, elem_names: String, rest_name: String, init: Int, is_mut: Int, has_rest: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(80)  # NODE_VEC_DESTRUCTURE
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  ast_intern_push_str1(s, elem_names)
  ast_intern_push_str2(s, rest_name)
  s.ops.push(has_rest)
  s.lefts.push(init)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Or-pattern node: pat1 | pat2 | pat3.
## children stores the Vec of sub-pattern handles.
def ast_or_pattern(s: AstStorage, patterns: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(81)  # NODE_OR_PATTERN
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(patterns)
  s.docs.push(0)
  return h
end

# =============================================================================
# Macro Expansion Provenance — schema for Tier 2 #8b-followup
# =============================================================================
#
# Every AST node knows where it came from in source (lines[h], cols[h]).
# Nodes synthesized by macro expansion also need to know which macro
# synthesized them, where that macro was defined, and where it was called —
# so diagnostics can render `note: in expansion of macro X (defined at Y:L:C)`
# and scope-set hygiene can stamp per-expansion scopes on identifiers.
#
# Storage layout:
# - `AstStorage.expansion_idx[h]` is sparse, lazily extended. 0 (default) =
#   node came straight from user source. Non-zero N = 1-based index into
#   the module-level `_ast_exp_*` parallel vecs, where record (N-1) holds:
#     * macro_name          — the `$macro_name` that produced this node
#     * def_line, def_col   — location of the `macro` keyword in the defn
#     * call_line, call_col — location of the invocation that fired this
#     * parent              — 0 for outer-most expansion, else prior 1-based idx
#
# `ast_expansion_reset()` clears all records and is called at the top of
# `compile()` in `quartz.qz` so multi-invocation drivers (LSP, tests) don't
# leak records across runs. Same pattern as `diag_reset_error_count()`.
#
# Phase 1 (this commit) ships the schema + APIs only — macro_expand.qz is
# not yet wired to populate them. Phase 2 will render them in diagnostics;
# Phase 3 will consume them for scope-set hygiene.

var _ast_exp_macro_names = vec_new<String>()
var _ast_exp_def_lines = vec_new<Int>()
var _ast_exp_def_cols = vec_new<Int>()
var _ast_exp_call_lines = vec_new<Int>()
var _ast_exp_call_cols = vec_new<Int>()
var _ast_exp_parents = vec_new<Int>()

## Reset the expansion-record store. Called by `compile()` at entry.
def ast_expansion_reset(): Void
  _ast_exp_macro_names = vec_new<String>()
  _ast_exp_def_lines = vec_new<Int>()
  _ast_exp_def_cols = vec_new<Int>()
  _ast_exp_call_lines = vec_new<Int>()
  _ast_exp_call_cols = vec_new<Int>()
  _ast_exp_parents = vec_new<Int>()
end

## Push a new expansion record. Returns its 1-based index (0 is reserved
## for "no expansion"). `parent_idx` is the 1-based index of the enclosing
## expansion (for `$outer` calls `$inner` nesting), or 0 for top-level.
def ast_expansion_push(macro_name: String, def_line: Int, def_col: Int, call_line: Int, call_col: Int, parent_idx: Int): Int
  var new_idx = _ast_exp_macro_names.size + 1
  _ast_exp_macro_names.push(macro_name)
  _ast_exp_def_lines.push(def_line)
  _ast_exp_def_cols.push(def_col)
  _ast_exp_call_lines.push(call_line)
  _ast_exp_call_cols.push(call_col)
  _ast_exp_parents.push(parent_idx)
  return new_idx
end

## Number of recorded expansions. Exposed for tests and `--explain-cache`.
def ast_expansion_count(): Int = _ast_exp_macro_names.size

def ast_expansion_macro_name(idx: Int): String
  if idx <= 0 or idx > _ast_exp_macro_names.size
    return ""
  end
  return _ast_exp_macro_names[idx - 1]
end

def ast_expansion_def_line(idx: Int): Int
  if idx <= 0 or idx > _ast_exp_def_lines.size
    return 0
  end
  return _ast_exp_def_lines[idx - 1]
end

def ast_expansion_def_col(idx: Int): Int
  if idx <= 0 or idx > _ast_exp_def_cols.size
    return 0
  end
  return _ast_exp_def_cols[idx - 1]
end

def ast_expansion_call_line(idx: Int): Int
  if idx <= 0 or idx > _ast_exp_call_lines.size
    return 0
  end
  return _ast_exp_call_lines[idx - 1]
end

def ast_expansion_call_col(idx: Int): Int
  if idx <= 0 or idx > _ast_exp_call_cols.size
    return 0
  end
  return _ast_exp_call_cols[idx - 1]
end

def ast_expansion_parent(idx: Int): Int
  if idx <= 0 or idx > _ast_exp_parents.size
    return 0
  end
  return _ast_exp_parents[idx - 1]
end

## Walk the expansion-record parent chain starting at `idx` and return a
## list of `note:`-ready strings — innermost first. Each reads
## `in expansion of macro '$X' (defined at L:C), called at L:C`. A zero
## or out-of-range idx yields the empty vec.
##
## Lives here (not in `std/diagnostic.qz`) because the chain walk needs
## the `_ast_exp_*` store — a compiler-side structure the std-tier
## diagnostic module has no dependency on. A.16.1 lifted `diagnostic.qz`
## to `std/` and stripped its AST-dependent renderer; the compiler-side
## producers (`macro_expand`, `typecheck`) call this helper and push the
## results as plain `diag_add_note` lines, which the std formatters
## already render.
def ast_expansion_notes(idx: Int): Vec<String>
  var notes = vec_new<String>()
  var cur = idx
  while cur > 0
    var name = ast_expansion_macro_name(cur)
    var dl = ast_expansion_def_line(cur)
    var dc = ast_expansion_def_col(cur)
    var cl = ast_expansion_call_line(cur)
    var cc = ast_expansion_call_col(cur)
    var loc = ""
    if dl > 0
      loc = " (defined at #{to_str(dl)}:#{to_str(dc)})"
    else
      loc = " (built-in)"
    end
    notes.push("in expansion of macro '$#{name}'#{loc}, called at #{to_str(cl)}:#{to_str(cc)}")
    cur = ast_expansion_parent(cur)
  end
  return notes
end

## Mark a node as born from expansion record `idx`. Sparse / lazy-extend
## pattern mirrors `ast_func_set_cconv_c` — no node constructor changes.
def ast_set_expansion(s: AstStorage, h: AstNodeId, idx: Int): Void
  if h < 0
    return
  end
  var sh = 0 + h
  while s.expansion_idx.size <= sh
    s.expansion_idx.push(0)
  end
  s.expansion_idx[sh] = idx
end

## Get the 1-based expansion-record index for node `h`. Returns 0 when
## the node came from user source (never expanded) or when the sparse
## vec hasn't been extended to cover `h` yet.
def ast_get_expansion(s: AstStorage, h: AstNodeId): Int
  if h < 0
    return 0
  end
  var sh = 0 + h
  if sh >= s.expansion_idx.size
    return 0
  end
  return s.expansion_idx[sh]
end

# ============================================================================
# Macro-hygiene scope-set store (Tier 2 #8b-followup Phase 3 — schema only)
# ============================================================================
#
# Flatt POPL 2016 "Binding as Sets of Scopes" adapts cleanly onto Quartz's
# AstStorage arena. A scope is a fresh small integer allocated per macro
# expansion call; a scope set is a sorted `Vec<Int>` of such integers. Every
# identifier (reference AND binder) carries a scope_set_idx pointing into
# the intern table below. The resolver (P3.c) picks the binding whose scope
# set is the largest subset of the reference's scope set — that gives you
# hygienic shadowing without surgery on the rest of the name-resolution
# pipeline.
#
# Storage shape, parallel to the expansion-record store:
#
# - `_ast_scope_counter` — monotonic fresh-scope allocator. One integer per
#   distinct "expansion identity" (call-site scope, definition-site scope).
#   Resets per compile() invocation.
# - `_ast_scope_sets` — intern table, Vec<Vec<Int>>. Each entry is a SORTED
#   deduped list of scope integers. Entry 0 is the empty set (reserved),
#   so scope_set_idx == 0 universally means "no scopes stamped, i.e. user
#   source." Resetting drops all entries and re-pushes `[]` so idx 0 stays
#   valid across invocations.
#
# Interning is linear-scan. This is the P3-MVP approach: subset-testing
# dominates lookup cost, not interning, and the corpus is small (one set
# per AST node). If it shows up in profiles later, swap to a hash-cons with
# identity-equal keys — the API surface doesn't change.
#
# P3.a (this commit) ships schema + APIs only. The expander (P3.b) will
# populate AstStorage.scope_set_idx; the resolver (P3.c) will consume it.

var _ast_scope_counter = 1
var _ast_scope_sets = vec_new<Vec<Int>>()

# Sparse side-table: `_ast_caller_flag[h] == 1` means "this node's
# scope_set_idx was stamped by the `$caller(name)` escape hatch — leave
# it alone." Used by the macro expander's post-stamp loop (P3.d) so that
# when the caller's scope set legitimately IS 0 (empty set — the case of
# `$caller` used at top level), the post-stamp doesn't overwrite it with
# the current expansion's def-site scope. For non-caller nodes we just
# rely on `scope_set_idx != 0` as the "already stamped" guard, but 0 is
# ambiguous between "unstamped" and "stamped empty" so we need this flag.
var _ast_caller_flag = vec_new<Int>()

## Reset the scope-set store. Called by `compile()` at entry alongside
## `ast_expansion_reset()` so the counter restarts at 1 and the intern
## table is re-seeded with entry 0 = empty set.
def ast_scope_reset(): Void
  _ast_scope_counter = 1
  _ast_scope_sets = vec_new<Vec<Int>>()
  ## Entry 0: empty set. Reserved. `ast_scope_set_empty()` returns 0, and
  ## the sparse AstStorage.scope_set_idx defaults to 0 for all nodes that
  ## predate P3.b's stamping.
  _ast_scope_sets.push(vec_new<Int>())
  _ast_caller_flag = vec_new<Int>()
end

## Mark node `h` as emitted by the `$caller(name)` escape hatch. The
## macro expander's post-stamp loop consults this to avoid overwriting
## the caller-scope stamp. Sparse; auto-extends.
def ast_set_caller_flag(h: AstNodeId, v: Int): Void
  if h < 0
    return
  end
  var sh = 0 + h
  while _ast_caller_flag.size <= sh
    _ast_caller_flag.push(0)
  end
  _ast_caller_flag[sh] = v
end

## Read the caller-escape flag for node `h`. Returns 0 for any node not
## explicitly marked, 1 for `$caller(...)`-emitted idents.
def ast_get_caller_flag(h: AstNodeId): Int
  if h < 0
    return 0
  end
  var sh = 0 + h
  if sh >= _ast_caller_flag.size
    return 0
  end
  return _ast_caller_flag[sh]
end

## Allocate a fresh scope integer. Each macro expansion mints one per
## "scope identity" (one call-site scope, one def-site scope per call —
## the expander manages the pairing). Returns a positive integer; 0 is
## NOT a valid scope id (it's only a scope-SET sentinel).
def ast_scope_fresh(): Int
  var s = _ast_scope_counter
  _ast_scope_counter += 1
  return s
end

## The canonical empty scope set. Always returns 0.
def ast_scope_set_empty(): Int = 0

## Number of scopes in the scope set at `set_idx`. Returns 0 for the empty
## set (idx 0) or any out-of-range idx.
def ast_scope_set_len(set_idx: Int): Int
  if set_idx < 0 or set_idx >= _ast_scope_sets.size
    return 0
  end
  return _ast_scope_sets[set_idx].size
end

## Get the `i`-th member of the scope set at `set_idx` (sets are sorted,
## so iteration is deterministic). Returns 0 on out-of-range.
def ast_scope_set_get(set_idx: Int, i: Int): Int
  if set_idx < 0 or set_idx >= _ast_scope_sets.size
    return 0
  end
  var members = _ast_scope_sets[set_idx]
  if i < 0 or i >= members.size
    return 0
  end
  return members[i]
end

## Membership test: does scope set `set_idx` contain `scope`? Linear scan;
## sorted order lets us short-circuit on overshoot. The intern table enforces
## the sorted invariant, so `_ast_scope_sets[set_idx]` is always sorted.
def ast_scope_set_contains(set_idx: Int, scope: Int): Bool
  if set_idx <= 0 or set_idx >= _ast_scope_sets.size
    return false
  end
  var members = _ast_scope_sets[set_idx]
  var i = 0
  while i < members.size
    var m = members[i]
    return true if m == scope
    return false if m > scope
    i += 1
  end
  return false
end

## Subset test: is every scope in set `a` also in set `b`? Core of the
## Flatt resolver rule — a binding is a candidate only when its scope set
## is a subset of the reference's scope set. Linear merge over sorted vecs.
def ast_scope_set_is_subset(a: Int, b: Int): Bool
  return true if a == b
  if a <= 0
    return true
  end
  if a >= _ast_scope_sets.size or b < 0 or b >= _ast_scope_sets.size
    return false
  end
  var am = _ast_scope_sets[a]
  var bm = _ast_scope_sets[b]
  return true if am.size == 0
  return false if am.size > bm.size
  var i = 0
  var j = 0
  while i < am.size
    var av = am[i]
    var found = false
    while j < bm.size
      var bv = bm[j]
      if bv == av
        found = true
        j += 1
        break
      end
      if bv > av
        break
      end
      j += 1
    end
    return false if not found
    i += 1
  end
  return true
end

## Intern a sorted member list into the scope-set table and return its idx.
## Assumes `members` is already sorted ascending and deduplicated — callers
## use this via `ast_scope_set_add` which guarantees both. Linear scan looks
## for an existing entry with byte-identical contents.
def _ast_scope_set_intern_sorted(members: Vec<Int>): Int
  return 0 if members.size == 0
  var n = _ast_scope_sets.size
  var i = 0
  while i < n
    var existing = _ast_scope_sets[i]
    if existing.size == members.size
      var same = true
      var k = 0
      while k < existing.size
        if existing[k] != members[k]
          same = false
          break
        end
        k += 1
      end
      return i if same
    end
    i += 1
  end
  var copy = vec_new<Int>()
  var p = 0
  while p < members.size
    copy.push(members[p])
    p += 1
  end
  _ast_scope_sets.push(copy)
  return n
end

## Add a single scope to set `set_idx`, returning the scope_set_idx of the
## resulting set. Idempotent: if `scope` is already a member, returns
## `set_idx` unchanged.
def ast_scope_set_add(set_idx: Int, scope: Int): Int
  if scope <= 0
    return set_idx
  end
  return set_idx if ast_scope_set_contains(set_idx, scope)
  var members = vec_new<Int>()
  var base_size = ast_scope_set_len(set_idx)
  var inserted = false
  var i = 0
  while i < base_size
    var m = ast_scope_set_get(set_idx, i)
    if not inserted and m > scope
      members.push(scope)
      inserted = true
    end
    members.push(m)
    i += 1
  end
  if not inserted
    members.push(scope)
  end
  return _ast_scope_set_intern_sorted(members)
end

## Remove a single scope from set `set_idx`, returning the scope_set_idx of
## the resulting set. Idempotent: if `scope` is not a member, returns
## `set_idx` unchanged. Used by the P3.d escape hatch (`caller!(name)` —
## strip the def-site scope so the ident resolves against the caller).
def ast_scope_set_remove(set_idx: Int, scope: Int): Int
  return set_idx if not ast_scope_set_contains(set_idx, scope)
  var members = vec_new<Int>()
  var base_size = ast_scope_set_len(set_idx)
  var i = 0
  while i < base_size
    var m = ast_scope_set_get(set_idx, i)
    if m != scope
      members.push(m)
    end
    i += 1
  end
  return _ast_scope_set_intern_sorted(members)
end

## Total number of distinct scope sets interned (diagnostics / `--explain-cache`).
def ast_scope_set_count(): Int = _ast_scope_sets.size

## Mark node `h` as carrying scope set `set_idx`. Sparse-vec pattern mirrors
## `ast_set_expansion` — no node constructor changes required.
def ast_set_scope_set(s: AstStorage, h: AstNodeId, set_idx: Int): Void
  if h < 0
    return
  end
  var sh = 0 + h
  while s.scope_set_idx.size <= sh
    s.scope_set_idx.push(0)
  end
  s.scope_set_idx[sh] = set_idx
end

## Get node `h`'s scope-set idx. Returns 0 (the empty set) for any node
## whose scope_set_idx hasn't been explicitly stamped — which is the
## correct default: user-source identifiers live in the empty scope set
## and see every binding whose scope set is ⊆ ∅, i.e. also the empty set.
def ast_get_scope_set(s: AstStorage, h: AstNodeId): Int
  if h < 0
    return 0
  end
  var sh = 0 + h
  if sh >= s.scope_set_idx.size
    return 0
  end
  return s.scope_set_idx[sh]
end
