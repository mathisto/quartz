def ast_safe_field_access(s: AstStorage, base: Int, field: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(16)  # NODE_SAFE_FIELD_ACCESS = 16
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, field)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(base)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
