def ast_param(s: AstStorage, name: String, type_ann: String, is_variadic: Int, default_value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(33)  # NODE_PARAM = 33
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_variadic)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_ann)
  s.ops.push(default_value)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

def ast_function(s: AstStorage, name: String, params: Int, return_type: String, body: Int, is_private: Int, type_params: String, type_param_bounds: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(34)  # NODE_FUNCTION = 34
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_private)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, return_type)
  s.ops.push(as_int(type_params))
  s.lefts.push(params)
  s.rights.push(body)
  s.extras.push(as_int(type_param_bounds))
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Get function type parameters (e.g., "T,U" from "<T: Eq, U: Ord>")
def ast_func_type_params(s: AstStorage, node: AstNodeId): String = as_string(s.ops[node])

## Get function type parameter bounds (e.g., "T:Eq,U:Ord")
def ast_func_type_param_bounds(s: AstStorage, node: AstNodeId): String = as_string(s.extras[node])

## Mark function as @naked (no prologue/epilogue)
def ast_func_set_naked(s: AstStorage, node: AstNodeId): Void
  s.children[node] = 1
end

## Check if function is @naked
## Returns 1 only when children[h] == 1 (not guard-encoded values >= 2)
def ast_func_is_naked(s: AstStorage, node: AstNodeId): Int
  if s.children[node] == 1
    return 1
  end
  return 0
end

## Attach an effect-row annotation to a function node.
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.3).
##
## - labels: list of effect-label NAMES (post-resolve, no generic args).
##   May be empty when the source is a bare `can` clause.
## - tail: tail-variable identifier, or "" for a closed row.
##
## Stores in three sparse parallel side-tables. Lazily extended so callers
## need not know the high-water-mark node handle.
def ast_func_set_can_row(s: AstStorage, node: AstNodeId, labels: Vec<String>, tail: String): Void
  var idx = 0 + node
  while s.func_can_present.size <= idx
    s.func_can_present.push(0)
    s.func_can_label_strs.push("")
    s.func_can_tail_strs.push("")
  end
  s.func_can_present[idx] = 1
  var csv = ""
  var n = labels.size
  for i in 0..n
    if i > 0
      csv = csv + ","
    end
    csv = csv + labels[i]
  end
  s.func_can_label_strs[idx] = csv
  s.func_can_tail_strs[idx] = tail
end

## Returns 1 if a `can` clause was attached to this function, else 0.
def ast_func_has_can_row(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.func_can_present.size
    return s.func_can_present[idx]
  end
  return 0
end

## Returns the comma-joined CSV of effect-label names for this function.
## Empty string means either no `can` clause OR a `can` with no labels —
## use ast_func_has_can_row to disambiguate.
def ast_func_get_can_label_csv(s: AstStorage, node: AstNodeId): String
  var idx = 0 + node
  if idx < s.func_can_label_strs.size
    return s.func_can_label_strs[idx]
  end
  return ""
end

## Returns the tail-variable identifier ("" = closed row).
def ast_func_get_can_tail(s: AstStorage, node: AstNodeId): String
  var idx = 0 + node
  if idx < s.func_can_tail_strs.size
    return s.func_can_tail_strs[idx]
  end
  return ""
end

## Mark a NODE_CALL as an effect-op invocation discovered by the
## typechecker's C.3 op-detection block. `effect_name` is the effect
## that declares this op; `op_name` is redundant today (equals callee's
## str1) but stored alongside so mir_lower and codegen need not reach
## back into the NODE_CALL subtree.
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.4).
def ast_mark_op_call(s: AstStorage, node: AstNodeId, effect_name: String, op_name: String): Void
  var idx = 0 + node
  while s.op_call_effect_names.size <= idx
    s.op_call_effect_names.push("")
    s.op_call_op_names.push("")
  end
  while s.op_call_kinds.size <= idx
    s.op_call_kinds.push(1)
  end
  s.op_call_effect_names[idx] = effect_name
  s.op_call_op_names[idx] = op_name
end

## Record the classified kind for an already-marked op call. Piezo F.3b.
## Kind values mirror the typecheck registry's effect_decl_op_kinds:
##   0  zero-param op, no resume (value kind per memo §2.1)
##   1  has params, no resume / tail-only resume (function kind §2.2)
##   2  body calls resume / operation kind (§2.3) — unwinds via longjmp
def ast_mark_op_call_kind(s: AstStorage, node: AstNodeId, k: Int): Void
  var idx = 0 + node
  while s.op_call_kinds.size <= idx
    s.op_call_kinds.push(1)
  end
  s.op_call_kinds[idx] = k
end

## Returns the classified op-call kind; default 1 (tail) for unset entries.
def ast_op_call_kind(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.op_call_kinds.size
    return s.op_call_kinds[idx]
  end
  return 1
end

## Returns 1 if this NODE_CALL was marked as an effect-op call (C.4).
def ast_is_op_call(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.op_call_effect_names.size
    if str_byte_len(s.op_call_effect_names[idx]) > 0
      return 1
    end
  end
  return 0
end

## Returns the effect name of an op-call annotation ("" if unmarked).
def ast_op_call_effect_name(s: AstStorage, node: AstNodeId): String
  var idx = 0 + node
  if idx < s.op_call_effect_names.size
    return s.op_call_effect_names[idx]
  end
  return ""
end

## Returns the op name of an op-call annotation ("" if unmarked).
def ast_op_call_op_name(s: AstStorage, node: AstNodeId): String
  var idx = 0 + node
  if idx < s.op_call_op_names.size
    return s.op_call_op_names[idx]
  end
  return ""
end

## Mark function as extern "C" def with body (C calling convention).
## Uses effect_annotations bit 2048 to piggy-back on the existing parallel
## side-table (same pattern as @no_preempt at bit 1024).
def ast_func_set_cconv_c(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 2048
end

## Check if function uses C calling convention (extern "C" def with body).
def ast_func_is_cconv_c(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 2048 > 0
      return 1
    end
  end
  return 0
end

## Mark function as @weak — emit with LLVM weak linkage so a
## non-weak definition at link time overrides it. Used for kernel
## stubs (panic_handler, scheduler hooks, allocator slots) and any
## "default can be replaced" pattern. Bit 4096 of effect_annotations.
def ast_func_set_weak(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 4096
end

## Check if function is marked @weak.
def ast_func_is_weak(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 4096 > 0
      return 1
    end
  end
  return 0
end

## Mark function as @panic_handler — the program's single panic
## handler. At every prelude panic site, the compiler emits a direct
## call to this function instead of the libc write/longjmp/exit path.
## Used by kernel / unikernel / embedded builds. Bit 8192.
def ast_func_set_panic_handler(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 8192
end

## Check if function is the @panic_handler.
def ast_func_is_panic_handler(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 8192 > 0
      return 1
    end
  end
  return 0
end

## Mark function as using the `x86-interrupt` calling convention.
## LLVM emits `define x86_intrcc void @...` — the backend adds the
## interrupt prologue/epilogue (`iret` on exit, pointer argument is
## the hardware-pushed interrupt stack frame). Used exclusively for
## kernel interrupt service routines in IDT entries. Bit 16384.
def ast_func_set_cconv_x86_intr(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 16384
end

## Check if function uses x86-interrupt calling convention.
def ast_func_is_cconv_x86_intr(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 16384 > 0
      return 1
    end
  end
  return 0
end

## Mark function as using LLVM `preserve_allcc` calling convention.
## The callee is responsible for saving/restoring almost all registers
## across the call. Useful for slow-path helpers invoked from fast
## paths where the caller doesn't want its register state disturbed.
## Prior art: Swift runtime, GHC's STG-invoke path. Bit 32768.
def ast_func_set_cconv_preserve_all(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 32768
end

## Check if function uses preserve_all calling convention.
def ast_func_is_cconv_preserve_all(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 32768 > 0
      return 1
    end
  end
  return 0
end

## Mark function as using LLVM `preserve_mostcc` calling convention.
## Similar to preserve_all but spares the most-used argument registers
## from the save list, so "most" callee-saved is a slight misnomer —
## in practice the ABI saves nearly everything except the first few
## argument regs. Used by trap / fault / interrupt-entry trampolines
## that do arg setup and tail-call into a normal-cconv handler.
## Bit 65536.
def ast_func_set_cconv_preserve_most(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 65536
end

## Check if function uses preserve_most calling convention.
def ast_func_is_cconv_preserve_most(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 65536 > 0
      return 1
    end
  end
  return 0
end

## Mark function as @export — expose under its source name in the
## WASM backend's export section so the host environment (JS, wasmtime)
## can call it directly. No effect on LLVM backend (all top-level defs
## already have external linkage there). Bit 131072.
def ast_func_set_export(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 131072
end

## Check if function is marked @export.
def ast_func_is_export(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 131072 > 0
      return 1
    end
  end
  return 0
end

## Mark function as @noinline — emit with the LLVM `noinline` function
## attribute so the optimizer never inlines call sites. Used for: secure
## scrub helpers (zeroize) where defense-in-depth against future optimizer
## changes is wanted; benchmark harnesses where the timer must not be
## folded into the measured body; boundary functions for stable backtraces.
## Note: `volatile` IR primitives carry their own no-DCE guarantee independent
## of inlining, so @noinline on a volatile-only function is belt-and-suspenders,
## not load-bearing. Bit 262144.
def ast_func_set_noinline(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 262144
end

## Check if function is marked @noinline.
def ast_func_is_noinline(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 262144 > 0
      return 1
    end
  end
  return 0
end

## Mark function as @ct — constant-time contract. The Layer 3 MIR taint pass
## (`self-hosted/middle/ct_taint.qz`, NET.4 Layer 3) treats this function as a
## CT region: every Secret<T>-typed parameter is a taint source, and the pass
## rejects branches / array indices / comparisons / variable shifts whose
## operand is taint-derived. Outside `@ct`, the typecheck-time strict-newtype
## rejections (Layer 1) are the only enforcement. Bit 524288.
def ast_func_set_ct(s: AstStorage, h: AstNodeId): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = s.effect_annotations[idx] | 524288
end

## Check if function is marked @ct.
def ast_func_is_ct(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 524288 > 0
      return 1
    end
  end
  return 0
end

## Gets the guard expression handle for a function (multi-clause defs).
## children[h] encoding: 0=none, 1=@naked, >=2 → guard handle = children[h] - 2
## @returns Guard expression handle, or -1 if no guard
def ast_func_get_guard(s: AstStorage, h: AstNodeId): Int
  if s.children[h] >= 2
    return s.children[h] - 2
  end
  return -1
end

## Sets the guard expression handle for a function (multi-clause defs).
## @param guard Guard expression handle
def ast_func_set_guard(s: AstStorage, h: AstNodeId, guard: Int): Void
  s.children[h] = guard + 2
end

## Get the effect annotation bitset for a function node.
## Returns 0 if no effect annotation was specified (infer effects).
def ast_func_get_effect_annotation(s: AstStorage, h: AstNodeId): Int
  var idx = 0 + h
  if idx < s.effect_annotations.size
    return s.effect_annotations[idx]
  end
  return 0
end

## Set the effect annotation bitset for a function node.
## Called by the parser when @pure, @io, or @suspend annotations are present.
## Lazily extends the Vec to accommodate the node handle.
def ast_func_set_effect_annotation(s: AstStorage, h: AstNodeId, effects: Int): Void
  var idx = 0 + h
  while s.effect_annotations.size <= idx
    s.effect_annotations.push(0)
  end
  s.effect_annotations[idx] = effects
end

## Check if function has @no_preempt attribute (bit 1024 in effect_annotations).
def ast_func_is_no_preempt(s: AstStorage, h: AstNodeId): Int
  var idx = 0 + h
  if idx < s.effect_annotations.size
    if s.effect_annotations[idx] & 1024 > 0
      return 1
    end
  end
  return 0
end

def ast_struct_def(s: AstStorage, name: String, fields: Int, type_params: String, is_private: Int, repr_c: Int, packed: Int, is_linear: Int, is_value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(36)  # NODE_STRUCT_DEF = 36
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_private)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_params)
  s.ops.push(repr_c)
  s.lefts.push(is_value)
  s.rights.push(is_linear)
  s.extras.push(packed)
  s.children.push(fields)
  s.docs.push(0)
  return h
end

## Get repr_c flag from struct_def (stored in ops slot)
def ast_struct_get_repr_c(s: AstStorage, node: AstNodeId): Int = s.ops[node]

## Get is_value flag from struct_def (stored in lefts slot)
def ast_struct_is_value(s: AstStorage, node: AstNodeId): Int = s.lefts[node]

## SYS.1 item 4 — struct-level alignment registry. Parallel to the
## AST node handle array; index = struct node handle, value = requested
## alignment in bytes (0 = no explicit alignment). Separate from
## effect_annotations because structs need an arbitrary integer value,
## not a bitset, and because the per-node slots are already claimed
## (ops, lefts, rights, extras, children, docs).
var _g_ast_struct_aligns = vec_new<Int>()

## Mark a struct as requesting @align(N) alignment. N must be a power
## of 2 ≥ 1; parser validates at source. Affects non-escaped @value
## struct allocas at codegen time; heap-allocated structs are
## unchanged (malloc gives 16-byte alignment regardless).
def ast_struct_set_align(s: AstStorage, h: AstNodeId, align: Int): Void
  var idx = 0 + h
  while _g_ast_struct_aligns.size <= idx
    _g_ast_struct_aligns.push(0)
  end
  _g_ast_struct_aligns[idx] = align
end

## Get the requested alignment of a struct, or 0 if none.
def ast_struct_get_align(s: AstStorage, node: AstNodeId): Int
  var idx = 0 + node
  if idx < _g_ast_struct_aligns.size
    return _g_ast_struct_aligns[idx]
  end
  return 0
end

def ast_field_def(s: AstStorage, name: String, type_ann: String, default_value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(37)  # NODE_FIELD_DEF = 37
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_ann)
  s.ops.push(0)
  s.lefts.push(default_value)  # left: default value expression (0 = none)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Get field default value expression (0 = no default)
def ast_field_default(s: AstStorage, node: AstNodeId): Int = s.lefts[node]

## Create a NODE_BINARY_BLOCK: `type Name = binary { ... }`
## name     - type name
## fields   - Vec of NODE_BINARY_FIELD handles
def ast_binary_block(s: AstStorage, name: String, fields: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(93)  # NODE_BINARY_BLOCK = 93
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, "")
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(fields)
  s.docs.push(0)
  return h
end

## Create a NODE_PACKED_STRUCT: `packed struct(uN) Name ... end`
## name            - type name
## backing_width   - integer width (8 / 16 / 32 / 64)
## fields          - Vec of NODE_BINARY_FIELD handles
def ast_packed_struct(s: AstStorage, name: String, backing_width: Int, fields: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(94)  # NODE_PACKED_STRUCT = 94
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(backing_width)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, "")
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(fields)
  s.docs.push(0)
  return h
end

## Create a NODE_BINARY_WITH: `value.with { field = expr; ... }` immutable
## update on a packed struct (Binary DSL STEP 5).
## base     - receiver expression (left slot)
## children - vec of NODE_ASSIGN nodes (str1=field_name, left=value)
def ast_binary_with(s: AstStorage, base: Int, children: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(96)  # NODE_BINARY_WITH = 96
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(base)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(children)
  s.docs.push(0)
  return h
end

## Create a NODE_TYPE_CAST: `expr as TypeName` — Binary DSL STEP 3 bitcast
## between a packed struct and its backing integer.
## base        - source expression (left slot)
## target_type - target type name string (str1)
def ast_type_cast(s: AstStorage, base: Int, target_type: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(97)  # NODE_TYPE_CAST = 97
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, target_type)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(base)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a NODE_BINARY_FIELD: a field inside `binary {}` or `packed struct(uN)`.
## name       - field name ("_" for anonymous pad)
## type_spec  - serialized type descriptor (e.g. "u4", "u16be", "[Entry;count]")
## bit_width  - bit width when statically known (0 if variable)
def ast_binary_field(s: AstStorage, name: String, type_spec: String, bit_width: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(95)  # NODE_BINARY_FIELD = 95
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(bit_width)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_spec)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a NODE_BINARY_UNION: `match <discriminator> ... end` inside a binary
## block. Phase 2 Track B. discriminator = prior field name (str1).
## arms = Vec<NODE_BINARY_UNION_ARM>.
def ast_binary_union(s: AstStorage, discriminator: String, arms: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(98)  # NODE_BINARY_UNION = 98
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, discriminator)
  ast_intern_push_str2(s, "")
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(arms)
  s.docs.push(0)
  return h
end

## Create a NODE_BINARY_UNION_ARM: one arm of a discriminated union. tag_value
## is the literal integer discriminant; fields = Vec<NODE_BINARY_FIELD>.
def ast_binary_union_arm(s: AstStorage, tag_value: Int, fields: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(99)  # NODE_BINARY_UNION_ARM = 99
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(tag_value)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(fields)
  s.docs.push(0)
  return h
end

def ast_actor_def(s: AstStorage, name: String, children: Int, type_params: String, is_private: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(91)  # NODE_ACTOR_DEF = 91
  s.lines.push(line)
