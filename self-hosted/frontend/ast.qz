# ast_enum_access: Enum::Variant or pattern with bindings
# - enum_name: The enum type name
# - variant: The variant name  
# - bound_names: Vector of string pointers for pattern bindings (when Some(x) -> x is bound)
# - payloads: Vector of AST handles for construction expressions (Option::Some(expr))
def ast_enum_access(s: AstStorage, enum_name: String, variant: String, bound_names: Int, payloads: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(39)  # NODE_ENUM_ACCESS = 39
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, enum_name)
  ast_intern_push_str2(s, variant)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(bound_names)
  s.children.push(payloads)
  s.docs.push(0)
  return h
end

# Is-check expression: expr is VariantName or expr is VariantName(bindings)
# left = subject expression handle
# str1 = variant name (e.g. "Some", "Err")
# extras = bound_names Vec (0 for simple check, Vec of as_int(name) for bindings)
def ast_is_check(s: AstStorage, subject: Int, variant_name: String, bound_names: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(92)  # NODE_IS_CHECK = 92
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, variant_name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(subject)
  s.rights.push(0)
  s.extras.push(bound_names)
  s.children.push(0)
  s.docs.push(0)
  return h
end

# Get bound_names vector for enum_access pattern matching
def ast_get_bound_names(s: AstStorage, h: AstNodeId): Vec = as_vec(s.extras[h])

# Get enum name for enum_access (slot 4)
def ast_get_enum_name(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.str1s[h])

# Get variant name for enum_access (slot 5)
def ast_get_variant(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.str2s[h])

# Get payloads vector for enum_access constructor (slot 10)
def ast_get_payloads(s: AstStorage, h: AstNodeId): Vec = as_vec(s.children[h])

# Get keys vector for map literal (slot 9)
def ast_get_map_keys(s: AstStorage, h: AstNodeId): Vec = as_vec(s.extras[h])

# Get values vector for map literal (slot 10)
def ast_get_map_values(s: AstStorage, h: AstNodeId): Vec = as_vec(s.children[h])

def ast_struct_init(s: AstStorage, struct_name: String, fields: Int, field_names: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(14)  # NODE_STRUCT_INIT = 14
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, struct_name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(field_names)  # Store field_names Vec handle
  s.children.push(fields)
  s.docs.push(0)
  return h
end

