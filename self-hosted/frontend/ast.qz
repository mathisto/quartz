def ast_variant_def(s: AstStorage, name: String, fields: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(66)  # NODE_VARIANT_DEF = 66 (Quartz extension)
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(fields)
  s.docs.push(0)
  return h
end

## Create an import declaration node.
## 
## Parameters:
##   s          - AST storage
##   module_name - Module path string
##   alias      - Alias name (empty string if none)
##   symbols    - Vector of imported symbol names (0 if none)
##   is_wildcard - 1 for 'from X import *', 0 otherwise
##   line       - Line number
##   col        - Column number
##
## Returns: Node handle
def ast_import(s: AstStorage, module_name: String, alias: String, symbols: Int, is_wildcard: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(48)  # NODE_IMPORT = 48
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_wildcard)           # int_val: wildcard flag
  ast_intern_push_str1(s, module_name)   # str1: module name
  ast_intern_push_str2(s, alias)         # str2: alias
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)            # rights: is_pub flag (0 or 1)
  s.extras.push(0)
  s.children.push(symbols)              # children: imported symbols
  s.docs.push(0)
  return h
end

def ast_import_set_pub(s: AstStorage, h: AstNodeId, is_pub: Int): Void
  s.rights.set_unchecked(h, is_pub)
end

def ast_import_is_pub(s: AstStorage, h: AstNodeId): Int = s.rights[h]

## Attach the parallel aliases vec for `from X import a as b, c as d` renames.
## `aliases` is a Vec<Int> of interned lexemes, same length as symbols.
## When an entry has no `as` rename, aliases[i] equals symbols[i].
## Stored in the AST's extras slot (default 0 = "no renames, use symbols as-is").
def ast_import_set_aliases(s: AstStorage, h: AstNodeId, aliases: Int): Void
  s.extras.set_unchecked(h, aliases)
end

## Returns the aliases vec for a selective `from X import a as b, ...` node,
## or 0 when no aliases were attached (non-selective imports, pre-V3 ASTs).
def ast_import_get_aliases(s: AstStorage, h: AstNodeId): Vec<Int> = as_vec(s.extras[h])

## Create a C import node: cimport "header.h"
def ast_c_import(s: AstStorage, header: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(56)  # NODE_C_IMPORT = 56
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, header)        # str1: header name
  ast_intern_push_str2(s, "")            # str2: unused
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a global variable declaration node.
## 
## Parameters:
##   s         - AST storage
##   name      - Variable name
##   init      - Initial value expression node
##   is_mutable - 1 for var (mutable), 0 for const (immutable)
##   line      - Line number
##   col       - Column number
##
## Returns: Node handle
def ast_global_var(s: AstStorage, name: String, init: Int, is_mutable: Int, is_thread_local: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(49)  # NODE_GLOBAL_VAR = 49
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mutable)  # int_val: mutability flag
  ast_intern_push_str1(s, name)  # str1: variable name
  s.str2s.push(0)  # str2
  s.ops.push(is_thread_local)  # op: thread-local flag
  s.lefts.push(0)  # left
  s.rights.push(init)  # right: initializer expression
  s.extras.push(0)  # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## Create a try-catch expression node.
##
## Syntax: try expr catch pattern handler end
##
## Evaluates body (must return Result<T, E>). On Ok(v), returns v.
## On Err(e), matches pattern and evaluates handler.
##
## Params:
## - s: AST storage
## - body: Expression to try (must return Result<T, E>)
## - pattern: Error pattern (ident, enum_access, or wildcard)
## - handler: Handler expression for error case
## - line, col: Source location
##
## Returns: Node handle
def ast_try_catch(s: AstStorage, body: Int, pattern: Int, handler: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(63)  # NODE_TRY_CATCH = 63
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)       # int_val
  s.str1s.push(0)       # str1
  s.str2s.push(0)       # str2
  s.ops.push(0)       # op
  s.lefts.push(body)    # left: body expression
  s.rights.push(handler) # right: handler expression
  s.extras.push(pattern) # extra: pattern
  s.children.push(0)      # children
  s.docs.push(0)      # doc
  return h
end

## Create a trait definition node (v5.0).
## 
## Parameters:
##   s           - AST storage
##   name        - Trait name
##   supertraits - Supertrait names ("+"-separated string or empty)
##   type_params - Type parameters (comma-separated string or empty)
##   methods     - Method signature nodes (vector of function nodes)
##   is_private  - 1 if in private section, 0 otherwise
##   line        - Line number
##   col         - Column number
##
## Returns: Node handle
## Create an effect declaration node (Operation Piezoelectric Effects, Milestone B).
##
## - s    : AST storage
## - name : effect name (e.g. "Throws")
## - ops  : Vec<Int> of NODE_FUNCTION handles for declared op signatures
## - line, col : source location
##
## str1 = effect name, children = ops vec.
def ast_effect_decl(s: AstStorage, name: String, ops: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(100)  # NODE_EFFECT_DECL = 100
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(ops)
  s.docs.push(0)
  return h
end

## Create a handler-install block node: `with HANDLER do -> BODY end`
## (Operation Piezoelectric Effects, Phase 1, Milestone C.1).
##
## - s            : AST storage
## - handler_node : node handle of the handler expression
## - body_node    : node handle of the body NODE_BLOCK
## - line, col    : source location
##
## left = handler expr, right = body block. C.1 only retains the shape;
## typecheck + MIR walkers forward to the body (handler is syntactically
## validated and ignored at runtime). C.2 uses left for row narrowing;
## C.4 lowers NODE_WITH to MIR_HANDLE_INSTALL + body + MIR_HANDLE_UNINSTALL.
##
## B.8 Phase 2: extras carries the optional bound-param NODE_PARAM handle
## for `with X do x -> body end` Scoped-resource forms. -1 = no binding
## (the legacy `with H do -> body end` and `with H do body end` shapes).
## Set via ast_with_set_bound_param after construction; read via
## ast_with_bound_param.
def ast_with(s: AstStorage, handler_node: Int, body_node: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(101)  # NODE_WITH = 101
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(handler_node)
  s.rights.push(body_node)
  s.extras.push(-1)  # B.8 Phase 2: bound-param sentinel = none
  s.children.push(0)
  s.docs.push(0)
  return h
end

## B.8 Phase 2: get the bound-param NODE_PARAM handle for a NODE_WITH,
## or -1 if the with-block was written without `do x ->` binding.
def ast_with_bound_param(s: AstStorage, h: AstNodeId): Int = ast_get_extra(s, h)

## B.8 Phase 2: attach a bound-param NODE_PARAM to a NODE_WITH. Called
## by the parser after ast_with returns when the surface form is
## `with X do x -> body end` or `with X do x: T -> body end`.
def ast_with_set_bound_param(s: AstStorage, h: AstNodeId, param_node: Int): Void
  ast_set_extra(s, h, param_node)
end

## B.8 Phase 4: get the resolved Scoped-impl struct name stamped on a
## NODE_WITH by typecheck (`tc_with_scoped_bind`), or empty when the
## with-block is not a Scoped form. Stored in str2 because str1 is
## already in use by NODE_WITH for effect-claim names elsewhere; str2
## was unused for this kind. MIR-lower reads this to decide between
## the legacy effect-handler path and the Scoped acquire/release path.
def ast_with_scoped_struct(s: AstStorage, h: AstNodeId): String = ast_get_str2(s, h)

## B.8 Phase 4: stamp the resolved Scoped impl's struct name onto a
## NODE_WITH. Called from `tc_with_scoped_bind` once the impl lookup
## confirms a Scoped impl exists for the handler's struct type.
def ast_with_set_scoped_struct(s: AstStorage, h: AstNodeId, name: String): Void
  ast_set_str2(s, h, name)
end

def ast_trait_def(s: AstStorage, name: String, supertraits: String, type_params: String, methods: Int, is_private: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(50)  # NODE_TRAIT_DEF = 50
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_private)           # int_val: private flag
  ast_intern_push_str1(s, name)          # str1: trait name
  ast_intern_push_str2(s, supertraits)   # str2: supertraits
  s.ops.push(0)                     # op
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(as_int(type_params))   # extra: type parameters as string
  s.children.push(methods)              # children: method signatures
  s.docs.push(0)                    # doc
  return h
end

## Create an impl block node (v5.0).
## 
## Parameters:
##   s           - AST storage
##   trait_name  - Trait being implemented
##   for_type    - Type implementing the trait
##   type_params - Type parameters for generic impl (string or empty)
##   methods     - Method implementation nodes (vector of function nodes)
##   line        - Line number
##   col         - Column number
##
## Returns: Node handle
def ast_impl_block(s: AstStorage, trait_name: String, for_type: String, type_params: String, methods: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(51)  # NODE_IMPL_BLOCK = 51
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)                     # int_val
  ast_intern_push_str1(s, trait_name)    # str1: trait name
  ast_intern_push_str2(s, for_type)      # str2: implementing type
  s.ops.push(0)                     # op
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(as_int(type_params))   # extra: type parameters
  s.children.push(methods)              # children: method implementations
  s.docs.push(0)                    # doc
  return h
end

## Create an extend block node for type extensions
## extend Int { def double(): Int = self * 2 }
## Returns: Node handle
def ast_extend_block(s: AstStorage, for_type: String, type_params: String, methods: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(52)  # NODE_EXTEND_BLOCK = 52
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)                     # int_val
  ast_intern_push_str1(s, for_type)      # str1: type being extended
  s.str2s.push(0)                     # str2: unused
  s.ops.push(0)                     # op
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(as_int(type_params))   # extra: type parameters
  s.children.push(methods)              # children: extension methods
  s.docs.push(0)                    # doc
  return h
end

## Create an extern function declaration node (FFI)
##
## - s: AST storage
## - name: External function name (e.g., "strlen")
## - convention: Calling convention ("C")
## - params: Vector of parameter nodes
## - return_type: Return type string
## - line, col: Source location
##
## Returns: Node handle
def ast_extern_fn(s: AstStorage, name: String, convention: String, params: Int, return_type: String, is_variadic: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(53)  # NODE_EXTERN_FN = 53
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_variadic)             # int_val: variadic flag
  ast_intern_push_str1(s, name)          # str1: function name
  ast_intern_push_str2(s, return_type)   # str2: return type
  s.ops.push(as_int(convention))    # op: calling convention
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(0)                     # extra
  s.children.push(params)               # children: parameters
  s.docs.push(0)                    # doc
  return h
end

## Create an extern variable declaration node (FFI)
##
## - s: AST storage
## - name: External variable name (e.g., "UART_BASE")
## - type_ann: Type annotation string (e.g., "Int")
## - line, col: Source location
##
## Returns: Node handle
def ast_extern_var(s: AstStorage, name: String, type_ann: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(76)  # NODE_EXTERN_VAR = 76
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  ast_intern_push_str1(s, name)   # str1: variable name
  ast_intern_push_str2(s, type_ann)  # str2: type annotation
  s.ops.push(0)              # op
  s.lefts.push(0)              # left
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## ast_extern_fn_is_variadic - Check if extern function is variadic
##
## @param s AST storage
## @param h Node handle
## @returns 1 if variadic, 0 otherwise
def ast_extern_fn_is_variadic(s: AstStorage, h: AstNodeId): Int = s.int_vals[h]

## ast_inline_c - Create inline C/asm escape hatch node
##
## @c("code") embeds raw C/asm code as LLVM inline assembly.
## Returns Int type.
##
## Params:
## - s: AST state
## - code: The C/asm code string
## - line, col: Source location
##
## Returns: Node handle
def ast_inline_c(s: AstStorage, code: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(54)  # NODE_INLINE_C = 54
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  ast_intern_push_str1(s, code)   # str1: code
  s.str2s.push(0)              # str2
  s.ops.push(0)              # op
  s.lefts.push(0)              # left
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(0)             # children
  s.docs.push(0)             # doc
  return h
end

## ast_inline_c_with_args - Create inline C/asm node with variable bindings
##
## @c("code", var1, var2) embeds raw C/asm code with input operands.
## Variables are accessible as $1, $2, etc. in the asm code.
## $0 is the output register.
##
## Params:
## - s: AST state
## - code: The C/asm code string
## - args: Vector of expression nodes for input operands
## - line, col: Source location
##
## Returns: Node handle
def ast_inline_c_with_args(s: AstStorage, code: String, args: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(54)  # NODE_INLINE_C = 54
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)              # int_val
  ast_intern_push_str1(s, code)   # str1: code
  s.str2s.push(0)              # str2
  s.ops.push(0)              # op
  s.lefts.push(0)              # left
  s.rights.push(0)              # right
  s.extras.push(0)              # extra
  s.children.push(args)          # children: args vector
  s.docs.push(0)             # doc
  return h
end

## Create a type alias node.
##
## Syntax: type Name<T> = ExistingType<T>
##
## Parameters:
##   s            - AST storage
##   name         - Alias name
##   aliased_type - The existing type being aliased (string)
##   type_params  - Type parameters as string (e.g., "<T, U>" or "")
##   line         - Line number
##   col          - Column number
##
## Returns: Node handle
def ast_type_alias(s: AstStorage, name: String, aliased_type: String, type_params: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(64)  # NODE_TYPE_ALIAS = 64
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)                     # int_val
  ast_intern_push_str1(s, name)          # str1: alias name
  ast_intern_push_str2(s, aliased_type)  # str2: aliased type
  s.ops.push(0)                     # op
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(as_int(type_params))   # extra: type parameters
  s.children.push(0)                    # children
  s.docs.push(0)                    # doc
  return h
end

##
## ast_newtype() - Create a newtype definition AST node
##
## Newtypes create distinct types that are NOT interchangeable with the wrapped type.
## Example: newtype UserId = Int
##   - UserId and Int are different types
##   - Compile-time safety, zero runtime cost
##
## Parameters:
##   s             - AST storage
##   name          - Newtype name
##   wrapped_type  - The wrapped type (string)
##   type_params   - Type parameters as string (e.g., "<T>" or "")
##   line          - Line number
##   col           - Column number
##
## Returns: Node handle
def ast_newtype(s: AstStorage, name: String, wrapped_type: String, type_params: String, is_strict: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(65)  # NODE_NEWTYPE_DEF = 65
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_strict)             # int_val: 1 iff @strict newtype (STRICT_NEWTYPES)
  ast_intern_push_str1(s, name)          # str1: newtype name
  ast_intern_push_str2(s, wrapped_type)  # str2: wrapped type
  s.ops.push(0)                     # op
  s.lefts.push(0)                     # left
  s.rights.push(0)                     # right
  s.extras.push(as_int(type_params))   # extra: type parameters
  s.children.push(0)                    # children
  s.docs.push(0)                    # doc
  return h
end

def ast_program(s: AstStorage, items: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(35)  # NODE_PROGRAM = 35
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(items)
  s.docs.push(0)
  return h
end

def ast_wildcard(s: AstStorage, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(42)  # NODE_WILDCARD = 42
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

def ast_try_expr(s: AstStorage, expr: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(17)  # NODE_TRY_EXPR = 17
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(expr)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
