  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(children)
  s.docs.push(0)
  return h
end

def ast_enum_def(s: AstStorage, name: String, variants: Int, type_params: String, is_private: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(38)  # NODE_ENUM_DEF = 38
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_private)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_params)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(variants)
  s.docs.push(0)
