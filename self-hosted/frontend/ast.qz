def ast_expr_stmt(s: AstStorage, expr: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(29)  # NODE_EXPR_STMT = 29
  s.lines.push(line)
  s.cols.push(col)
