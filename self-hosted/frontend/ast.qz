# For-await loop: for await x in channel — async iterator over channel
# Layout: str1=binding_name, left=channel_expr, right=body
def ast_for_await(s: AstStorage, var_name: String, channel: Int, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(86)  # NODE_FOR_AWAIT = 86
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, var_name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(channel)
  s.rights.push(body)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

# List comprehension: [expr for var in iter if cond]
# Layout: left=expr, str1=var_name, right=iter, extra=cond (0 if no condition)
def ast_list_comp(s: AstStorage, expr: Int, var_name: String, iterable: Int, condition: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(46)           # NODE_LIST_COMP = 46
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)           # int_vals
  ast_intern_push_str1(s, var_name)  # str1 = var_name
  s.str2s.push(0)           # str2
  s.ops.push(0)           # ops
  s.lefts.push(expr)        # left = expression
  s.rights.push(iterable)    # right = iterable
  s.extras.push(condition)   # extra = condition (0 if none)
  s.children.push(0)          # children
  s.docs.push(0)          # docs
  return h
end

# Set comprehension: {expr for var in iter if cond}
# Layout: left=expr, right=iterable, str1=var_name, extra=condition (0 if none)
def ast_set_comp(s: AstStorage, expr: Int, var_name: String, iterable: Int, condition: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(48)           # NODE_SET_COMP = 48
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)           # int_vals
  ast_intern_push_str1(s, var_name)  # str1 = var_name
  s.str2s.push(0)           # str2
  s.ops.push(0)           # ops
  s.lefts.push(expr)        # left = expression
  s.rights.push(iterable)    # right = iterable
  s.extras.push(condition)   # extra = condition (0 if none)
  s.children.push(0)          # children
  s.docs.push(0)          # docs
  return h
end

# Map comprehension: {key_expr => val_expr for var in iter if cond}
# Layout: left=key_expr, right=val_expr, str1=var_name, extra=iter, children[0]=cond (0 if none)
def ast_map_comp(s: AstStorage, key_expr: Int, val_expr: Int, var_name: String, iterable: Int, condition: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(47)           # NODE_MAP_COMP = 47
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)           # int_vals
  ast_intern_push_str1(s, var_name)  # str1 = var_name
  s.str2s.push(0)           # str2
  s.ops.push(0)           # ops
  s.lefts.push(key_expr)    # left = key expression
  s.rights.push(val_expr)    # right = value expression
  s.extras.push(iterable)    # extra = iterable
  # Store condition in a children vec
  var cond_vec = vec_new()
  if condition != 0
    cond_vec.push(condition)
  end
  s.children.push(as_int_generic(cond_vec))   # children = [cond] or []
  s.docs.push(0)          # docs
  return h
end

def ast_match(s: AstStorage, expr: Int, arms: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(40)  # NODE_MATCH = 40
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(expr)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(arms)
  s.docs.push(0)
  return h
end

def ast_match_arm(s: AstStorage, pattern: Int, guard: Int, body: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(41)  # NODE_MATCH_ARM = 41
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(pattern)
  s.rights.push(body)
  s.extras.push(guard)
  s.children.push(0)
  s.docs.push(0)
  return h
end

def ast_let(s: AstStorage, name: String, type_ann: String, value: Int, is_mut: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(25)  # NODE_LET = 25
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  ast_intern_push_str1(s, name)
  ast_intern_push_str2(s, type_ann)
  s.ops.push(0)
  s.lefts.push(value)      # FIX: Store value in slot 7 (left)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Create a regex literal node (NODE_REGEX_LIT = 5).
## Stores the regex pattern in str1 slot.
## @param s AST storage
## @param pattern Regex pattern string
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_regex_lit(s: AstStorage, pattern: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(5)  # NODE_REGEX_LIT = 5
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, pattern)  # str1 = pattern
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

def ast_assign(s: AstStorage, target: String, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(26)  # NODE_ASSIGN = 26
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, target)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(value)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

# Creates an index assignment node: arr[idx] = val
# NODE_INDEX_ASSIGN = 27 (C-aligned)
# left = array, right = index, extra = value
def ast_index_assign(s: AstStorage, array: Int, index: Int, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(27)  # NODE_INDEX_ASSIGN = 27
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(array)   # left = array
  s.rights.push(index)   # right = index
  s.extras.push(value)   # extra = value
  s.children.push(0)
  s.docs.push(0)
  return h
end

# Creates a field assignment node: obj.field = val
# NODE_FIELD_ASSIGN = 28 (C-aligned)
# left = object, str1 = field name, extra = value
def ast_field_assign(s: AstStorage, obj: Int, field: String, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(28)  # NODE_FIELD_ASSIGN = 28
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, field)  # field name
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(obj)    # left = object
  s.rights.push(0)
  s.extras.push(value)  # extra = value
  s.children.push(0)
  s.docs.push(0)
  return h
end

