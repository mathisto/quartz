##! # Abstract Syntax Tree
##!
##! Arena-style AST storage using parallel arrays for memory efficiency
##! and cross-module Int handle compatibility.
##!
##! ## Architecture
##!
##! Instead of structs with pointers, the AST uses a storage vector
##! containing 12 parallel arrays indexed by node handle:
##!
##! | Index | Field | Purpose |
##! |-------|-------|---------|
##! | 0 | kinds | NodeKind enum value |
##! | 1 | lines | Source line number |
##! | 2 | cols | Source column number |
##! | 3 | int_vals | Integer values (for literals) |
##! | 4 | str1s | Primary string (name, lexeme) |
##! | 5 | str2s | Secondary string (type annotation) |
##! | 6 | ops | Operator kind for binary/unary |
##! | 7 | lefts | Left child handle |
##! | 8 | rights | Right child handle |
##! | 9 | extras | Extra data (flags, metadata) |
##! | 10 | children | Vector of child handles |
##! | 11 | docs | Docstring content |
##!
##! ## Node Handle Model
##!
##! Every AST node is identified by an integer handle (its index).
##! Constructor functions return the handle; accessor functions take
##! storage + handle to retrieve fields.
##!
##! ## Fixpoint Invariant
##!
##! NodeKind order MUST match C bootstrap's NodeType (bootstrap/src/ast.h).
##! Modifying this order breaks fixpoint verification.
##!
##! @see parser Creates AST nodes during parsing
##! @see typecheck Annotates AST with type information
##! @see mir Transforms AST to MIR
##! @since 1.0.0

import string_intern

import compiler_types

## Operator types for binary and unary expressions.
##
## Used by ast_binary and ast_unary nodes.
## Order matters for codegen mapping.
enum OpKind
  OpAdd
  OpSub
  OpMul
  OpDiv
  OpMod
  OpEq
  OpNe
  OpLt
  OpLe
  OpGt
  OpGe
  OpAnd
  OpOr
  OpNot
  OpNeg
  OpBitAnd
  OpBitOr
  OpBitXor
  OpBitNot
  OpShl
  OpShr
end

## Node kinds for all AST node types.
##
## **FIXPOINT CRITICAL**: Order MUST match C bootstrap's NodeType
## in `quartz-bootstrap/src/ast.h` lines 80-170.
##
## @see quartz-bootstrap/src/ast.h Canonical C definition
enum NodeKind
  # === Expressions (0-21) ===
  NodeIntLit          # 0  - 42
  NodeBoolLit         # 1  - true, false
  NodeNilLit          # 2  - nil
  NodeStringLit       # 3  - "hello"
  NodeSymbolLit       # 4  - :ok, :not_found
  NodeRegexLit        # 5  - ~r"pattern"
  NodeIdent           # 6  - foo (variable reference)
  NodeUnary           # 7  - -x
  NodeBinary          # 8  - a + b
  NodeCall            # 9  - foo(a, b)
  NodeArray           # 10 - [1, 2, 3] array literal
  NodeSetLiteral      # 11 - {1, 2, 3} set literal
  NodeMapLit          # 12 - {a: 1, b: 2} or {:a => 1} map literal
  NodeIndex           # 13 - arr[i] array indexing
  NodeStructInit      # 14 - Point { x: 1, y: 2 }
  NodeFieldAccess     # 15 - p.x
  NodeSafeFieldAccess # 16 - x?.field - safe navigation
  NodeTryExpr         # 17 - expr? - early return on Err/None
  NodeFuncRef         # 18 - &func - reference to function
  NodeLambda          # 19 - x: Int -> x * 2 - anonymous function
  NodeAllocExpr       # 20 - @heap [1,2,3] or @arena [1,2,3]
  NodeCaptureVar      # 21 - $0-$9 - regex capture variable

  # === Statements (22-31) ===
  NodeReturn          # 22 - return expr
  NodeIf              # 23 - if cond ... else ... end
  NodeWhile           # 24 - while cond ... end
  NodeLet             # 25 - let x = expr
  NodeAssign          # 26 - x = expr
  NodeIndexAssign     # 27 - arr[i] = expr
  NodeFieldAssign     # 28 - p.x = expr
  NodeExprStmt        # 29 - expr; (expression as statement)
  NodeBreak           # 30 - break - exit loop
  NodeContinue        # 31 - continue - next iteration

  # === Structure (32-42) ===
  NodeBlock           # 32 - { stmt; stmt; ... }
  NodeParam           # 33 - Parameter in function definition
  NodeFunction        # 34 - def foo(...) ... end
  NodeProgram         # 35 - Root: list of functions
  NodeStructDef       # 36 - struct Point x: Int y: Int end
  NodeFieldDef        # 37 - Field in struct definition
  NodeEnumDef         # 38 - enum Color Red Green Blue end
  NodeEnumAccess      # 39 - Color::Red
  NodeMatch           # 40 - match expr ... end
  NodeMatchArm        # 41 - Pattern => expr
  NodeWildcard        # 42 - _ (matches anything)

  # === Surface Syntax (43-47) - desugared in MIR ===
  NodeInterpString    # 43 - "Hello, #{name}!"
  NodeFor             # 44 - for i in 0..10
  NodeCompoundAssign  # 45 - x += 1
  NodeListComp        # 46 - [x*2 for x in arr]
  NodeMapComp         # 47 - {k => v for x in iter}

  # === Module System (48-49) ===
  NodeImport          # 48 - import foo, from foo import bar
  NodeGlobalVar       # 49 - var g = expr at module level

  # === Trait System (50-52) ===
  NodeTraitDef        # 50 - trait Foo def method(self) end
  NodeImplBlock       # 51 - impl Trait for Type def ... end
  NodeExtendBlock     # 52 - extend Type { methods }

  # === FFI (53-56) ===
  NodeExternFn        # 53 - extern "C" fn strlen(s: CPtr): CSize
  NodeInlineC         # 54 - @c("code")
  NodeCInclude        # 55 - @cInclude("header.h")
  NodeCImport         # 56 - @cImport(@cInclude(...))

  # === Concurrency (58-60) ===
  NodeAwait           # 58 - await handle
  NodeSelect          # 59 - select { channel_arms }
  NodeSelectArm       # 60 - recv/send/default arm in select

  # === Memory Management (61-62) ===
  NodeDefer           # 61 - defer expr
  NodeArenaBlock      # 62 - arena name do ... end

  # === Error Handling (63) ===
  NodeTryCatch        # 63 - try expr catch pattern handler

  # === Type Aliases (64-65) ===
  NodeTypeAlias       # 64 - type Name = ExistingType
  NodeNewtypeDef      # 65 - newtype Name = Type

  # === Quartz-only Extensions (66+) - NOT in C bootstrap ===
  NodeVariantDef      # 66 - Enum variant definition (Quartz-only)

  # === Macro System (67) ===
  NodeMacroCall       # 67 - $try(), $unwrap(), $assert(), $debug()

  # === Float Literals (68) ===
  NodeFloatLit        # 68 - Float literal (e.g. 3.14, 1.5e3)

  # === Const Evaluation (69-70) ===
  NodeConstDecl       # 69 - const NAME = expr
  NodeStaticAssert    # 70 - static_assert(cond, "msg")

  # === Structured Concurrency (71) ===
  NodeTaskGroup       # 71 - task_group |g| ... end
end

## Typed AST storage arena with 12 parallel vectors for node fields.
##
## This struct documents the layout of the AST storage. At runtime,
## storage is passed as Int (existential type) and accessed via indices:
##
## | Index | Field     | Purpose                          |
## |-------|-----------|----------------------------------|
## | 0     | kinds     | NodeKind enum values             |
## | 1     | lines     | Source line numbers              |
## | 2     | cols      | Source column numbers            |
## | 3     | int_vals  | Integer values (for literals)    |
## | 4     | str1s     | Primary strings (names, lexemes) |
## | 5     | str2s     | Secondary strings (type annots)  |
## | 6     | ops       | Operator kinds (binary/unary)    |
## | 7     | lefts     | Left child handles               |
## | 8     | rights    | Right child handles              |
## | 9     | extras    | Extra data (flags, metadata)     |
## | 10    | children  | Vectors of child handles         |
## | 11    | docs      | Docstring content                |
##
## @since 5.10.0
@repr(C)
struct AstStorage
  ## NodeKind enum values
  kinds: Vec<Int>
  ## Source line numbers
  lines: Vec<Int>
  ## Source column numbers
  cols: Vec<Int>
  ## Integer values (for literals)
  int_vals: Vec<Int>
  ## Primary strings (interned IDs — resolve via interner)
  str1s: Vec<Int>
  ## Secondary strings (interned IDs — resolve via interner)
  str2s: Vec<Int>
  ## Operator kinds (binary/unary)
  ops: Vec<Int>
  ## Left child handles
  lefts: Vec<Int>
  ## Right child handles
  rights: Vec<Int>
  ## Extra data (flags, metadata)
  extras: Vec<Int>
  ## Vectors of child handles
  children: Vec<Int>
  ## Docstring content (interned IDs — resolve via interner)
  docs: Vec<Int>
  ## String interner for deduplication
  interner: StringInterner
  ## Effect annotations for function nodes (sparse, lazily extended).
  ## Index = node handle, value = effect bitset (0 = no annotation).
  effect_annotations: Vec<Int>
  ## Effect-row presence flag per NODE_FUNCTION (sparse, lazily extended).
  ## 0 = no `can` clause (untracked), 1 = `can` clause was parsed.
  ## Operation Piezoelectric Effects, Milestone B chunk B.3.
  func_can_present: Vec<Int>
  ## Effect-row labels per NODE_FUNCTION as comma-joined NAME strings
  ## (sparse). "" when func_can_present is 0 OR `can` had no labels.
  func_can_label_strs: Vec<String>
  ## Effect-row tail var name per NODE_FUNCTION (sparse).
  ## "" = closed tail (no `| var`), else the tail variable's identifier.
  func_can_tail_strs: Vec<String>
  ## Effect-op call annotation per NODE_CALL (sparse). Non-empty string
  ## names the effect whose op this call invokes; empty = regular call.
  ## Populated by tc_expr_call's C.3 block once an op is detected, so
  ## mir_lower can route to MIR_PERFORM_OP without re-running effect
  ## lookup (mir_lower has no access to tc). Parallel string holds the
  ## op name from the same call site (= ast_get_str1(callee)).
  ## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.4).
  op_call_effect_names: Vec<String>
  op_call_op_names: Vec<String>
  ## Per-NODE_CALL kind classification for op calls, populated alongside
  ## op_call_effect_names / op_call_op_names. 0/1 = tail-resume (memo
  ## §2.2 function kind), 2 = unwind (memo §2.3 operation kind). Piezo
  ## F.3b: codegen reads this to decide whether MIR_PERFORM_OP should
  ## pass kind=2 to the runtime (longjmp back to enclosing with-block
  ## after the handler returns) or kind=1 (normal return). Unset entries
  ## default to 1, matching F.3a's tail-resume fallback.
  op_call_kinds: Vec<Int>
  ## Macro-expansion provenance per node (sparse, lazily extended).
  ## 0 = node came from user source; else 1-based index into the
  ## module-level expansion-record store (`_ast_exp_*` vecs) where
  ## (macro_name, def line/col, call-site line/col, parent_idx) lives.
  ## Parent indices form a linked list so deeply nested expansions
  ## (macro A calls macro B) reconstruct the full stack.
  ##
  ## Macro hygiene retrofit (Tier 2 #8b-followup) Phase 1 — schema only.
  ## P2 renders these as `note: in expansion of X (defined at Y:L:C)`
  ## in diagnostics; P3 consumes them for scope-set hygiene.
  expansion_idx: Vec<Int>
  ## Macro hygiene: scope-set index per node (sparse, lazily extended).
  ## 0 = empty scope set (default for nodes born from user source — they
  ## see all bindings whose scope sets are subsets of ∅, i.e. also empty).
  ## Non-zero = 1-based index into `_ast_scope_sets` (the intern table of
  ## sorted `Vec<Int>` scope lists). Populated by the expander in P3.b:
  ## body-local idents get the def-site scope stamped; unquoted-argument
  ## idents keep the caller's scope set (pass-through). The resolver in
  ## P3.c consults this via Flatt's "largest subset" rule.
  ## Macro hygiene retrofit (Tier 2 #8b-followup) Phase 3 — schema only.
  scope_set_idx: Vec<Int>
  ## Stable per-compile identity (PF3-P1). Assigned from a deterministic
  ## monotonic counter in `ast_new_storage` and the build-cache loader.
  ## Used as the cross-module registry key so an `AstStorage` can survive a
  ## `Vec<Int>` boundary (the build-cache effect-op return) without erasing
  ## the COW value-struct pointer to an i64. The consumer recovers the real
  ## struct via `build_cache::cache_lookup_ast_by_id(id)`.
  id: Int
end

## Creates a new AST storage arena.
##
## Allocates 12 parallel vectors for node fields. All node
## constructor functions add entries to these vectors.
##
## @returns AstStorage struct with 12 parallel vectors
## @example
##   var storage = ast_new_storage()
##   var root = ast_program(storage, children, 1, 1)
# PF3-P1 — deterministic per-compile monotonic id counter for AstStorage.
# Fresh process per compile → starts at 1, assigned in deterministic
# allocation order, so fixpoint (gen1 == gen2) holds. 1-based so that id 0 is
# reserved as "null/none" — the build-cache effect-op return uses 0 in its
# `miss` sentinel and the resolver gates a cache hit on `result[0] != 0`.
var _g_ast_storage_id_counter = 1

def ast_next_storage_id(): Int
  var id = _g_ast_storage_id_counter
  _g_ast_storage_id_counter = _g_ast_storage_id_counter + 1
  return id
end

def ast_new_storage(): AstStorage
  var s = AstStorage {
    kinds: vec_new(),
    lines: vec_new(),
    cols: vec_new(),
    int_vals: vec_new(),
    str1s: vec_new(),
    str2s: vec_new(),
    ops: vec_new(),
    lefts: vec_new(),
    rights: vec_new(),
    extras: vec_new(),
    children: vec_new(),
    docs: vec_new(),
    interner: string_intern::intern_global(),
    effect_annotations: vec_new(),
    func_can_present: vec_new(),
    func_can_label_strs: vec_new<String>(),
    func_can_tail_strs: vec_new<String>(),
    op_call_effect_names: vec_new<String>(),
    op_call_op_names: vec_new<String>(),
    op_call_kinds: vec_new(),
    expansion_idx: vec_new(),
    scope_set_idx: vec_new(),
    id: ast_next_storage_id()
  }
  ## Reserve handle 0 as null sentinel.
  ## Throughout the codebase, handle 0 means "no node" (null).
  ## Without this, the first real node gets handle 0 and is
  ## indistinguishable from null, causing resolver/typecheck bugs
  ## when zero-param functions have a callee IDENT as the first node.
  s.kinds.push(0)
  s.lines.push(0)
  s.cols.push(0)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return s
end

## Gets the total number of nodes in the AST storage.
## @param s AstStorage struct
## @returns Number of nodes
def ast_node_count(s: AstStorage): Int = s.kinds.size

## Gets the NodeKind of a node.
## @param s AstStorage struct
## @param h Node handle
## @returns NodeKind enum value
def ast_get_kind(s: AstStorage, h: AstNodeId): Int
  if h < 0
    return 0
  end
  return s.kinds[h]
end

## Sets the NodeKind of a node.
## Used for rewriting nodes during typechecking (e.g., .size -> string_len call).
## @param s AstStorage struct
## @param h Node handle
## @param kind New NodeKind value
def ast_set_kind(s: AstStorage, h: AstNodeId, kind: Int): Void
  s.kinds[h] = kind
end

## Gets the source line number of a node.
## @param s AstStorage struct
## @param h Node handle
## @returns 1-based line number
def ast_get_line(s: AstStorage, h: AstNodeId): Int = s.lines[h]

## Gets the source column number of a node.
## @param s AstStorage struct
## @param h Node handle
## @returns 1-based column number
def ast_get_col(s: AstStorage, h: AstNodeId): Int = s.cols[h]

## Gets the integer value of a node (for int literals).
## @param s AstStorage struct
## @param h Node handle
## @returns Integer value stored in the node
def ast_get_int_val(s: AstStorage, h: AstNodeId): Int = s.int_vals[h]

## Gets the primary string field (name, lexeme).
## @param s AstStorage struct
## @param h Node handle
## @returns String value (resolved from intern ID)
def ast_get_str1(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.str1s[h])

## Sets the primary string field.
## @param s AstStorage struct
## @param h Node handle
## @param val New string value
def ast_set_str1(s: AstStorage, h: AstNodeId, val: String): Void
  s.str1s[h] = string_intern::intern_id(s.interner, val)
end

## Gets the secondary string field (type annotation).
## @param s AstStorage struct
## @param h Node handle
## @returns String value (resolved from intern ID)
def ast_get_str2(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.str2s[h])

## Sets the secondary string field (type annotation).
## Used for writing inferred type args back to struct init nodes.
def ast_set_str2(s: AstStorage, h: AstNodeId, val: String): Void
  s.str2s[h] = string_intern::intern_id(s.interner, val)
end

## Gets the operator kind (for binary/unary nodes).
## @param s AstStorage struct
## @param h Node handle
## @returns OpKind enum value
def ast_get_op(s: AstStorage, h: AstNodeId): Int = s.ops[h]
def ast_set_op(s: AstStorage, h: AstNodeId, op: Int): Void = s.ops.set_unchecked(h, op)

## Gets the left child handle.
## @param s AstStorage struct
## @param h Node handle
## @returns Child node handle
def ast_get_left(s: AstStorage, h: AstNodeId): Int = s.lefts[h]

## Sets the left child handle.
## Used for rewriting nodes during typechecking.
## @param s AstStorage struct
## @param h Node handle
## @param child New child node handle
def ast_set_left(s: AstStorage, h: AstNodeId, child: Int): Void
  s.lefts[h] = child
end

## Gets the right child handle.
## @param s AstStorage struct
## @param h Node handle
## @returns Child node handle
def ast_get_right(s: AstStorage, h: AstNodeId): Int = s.rights[h]

## Sets the right child handle.
## @param s AstStorage struct
## @param h Node handle
## @param child New child node handle
def ast_set_right(s: AstStorage, h: AstNodeId, child: Int): Void
  s.rights[h] = child
end

## Gets the extra field (flags, metadata).
## @param s AstStorage struct
## @param h Node handle
## @returns Extra data value
def ast_get_extra(s: AstStorage, h: AstNodeId): Int = s.extras[h]

## Sets the int_val field.
## @param s AstStorage struct
## @param h Node handle
## @param val New int_val value
def ast_set_int_val(s: AstStorage, h: AstNodeId, val: Int): Void
  s.int_vals[h] = val
end

## Sets the extra field.
## @param s AstStorage struct
## @param h Node handle
## @param val New extra value
def ast_set_extra(s: AstStorage, h: AstNodeId, val: Int): Void
  s.extras[h] = val
end

## Gets the children vector handle.
## @param s AstStorage struct
## @param h Node handle
## @returns Vector of child node handles
def ast_get_children(s: AstStorage, h: AstNodeId): Vec = as_vec(s.children[h])

## Raw children-slot handle for a node (the Int stored in `s.children[h]`, which is
## 0 for childless nodes — `ast_get_children` would `as_vec(0)` it into a junk vec).
## A generic whole-tree walker must check this is non-zero before treating the slot
## as a real Vec, so a 0 slot is never reinterpreted as node handles.
def ast_get_children_raw(s: AstStorage, h: AstNodeId): Int = s.children[h]

## Sets the children vector for a node.
## @param s AstStorage struct
## @param h Node handle  
## @param children New children vector handle
def ast_set_children(s: AstStorage, h: AstNodeId, children: Vec): Void
  s.children[h] = children
end

## Inserts a node at the start of a program's children.
## Used for injecting prelude import.
## @param s AstStorage struct
## @param h Program node handle
## @param child Node to insert at index 0
def ast_program_insert_first(s: AstStorage, h: AstNodeId, child: Int): Void
  var children = ast_get_children(s, h)
  var count = children.size
  # Shift all existing items right by 1
  var new_children = vec_new()
  new_children.push(child)
  for i in 0..count
    new_children.push(children[i])
  end
  ast_set_children(s, h, new_children)
end

## Gets the docstring for a node.
## @param s AstStorage struct
## @param h Node handle
## @returns Documentation string or empty
def ast_get_doc(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.docs[h])

## Sets the docstring for a node.
## @param s AstStorage struct
## @param h Node handle
## @param doc Documentation string
def ast_set_doc(s: AstStorage, h: AstNodeId, doc: String): Void
  s.docs[h] = string_intern::intern_id(s.interner, doc)
end

## Pushes an interned string into str1s.
def ast_intern_push_str1(s: AstStorage, val: String): Void
  s.str1s.push(string_intern::intern_id(s.interner, val))
end

## Pushes an interned string into str2s.
def ast_intern_push_str2(s: AstStorage, val: String): Void
  s.str2s.push(string_intern::intern_id(s.interner, val))
end

## Pushes an interned string into docs.
def ast_intern_push_doc(s: AstStorage, val: String): Void
  s.docs.push(string_intern::intern_id(s.interner, val))
end

## Gets the default value handle for a parameter node.
## @param s AstStorage struct
## @param h Parameter node handle
## @returns Default value expression handle, or 0 if none
def ast_param_default_value(s: AstStorage, h: AstNodeId): Int = s.ops[h]

## Checks if a parameter is variadic.
## @param s AstStorage struct
## @param h Parameter node handle
## @returns 1 if variadic, 0 otherwise
def ast_param_is_variadic(s: AstStorage, h: AstNodeId): Int = s.int_vals[h]

## Gets the pattern handle for a parameter node (multi-clause defs).
## @param s AstStorage struct
## @param h Parameter node handle
## @returns Pattern AST handle, or 0 if no pattern
def ast_param_get_pattern(s: AstStorage, h: AstNodeId): Int = s.lefts[h]

## Sets the pattern handle for a parameter node (multi-clause defs).
## @param s AstStorage struct
## @param h Parameter node handle
## @param pat Pattern AST handle
def ast_param_set_pattern(s: AstStorage, h: AstNodeId, pat: Int): Void
  s.lefts[h] = pat
end

## Receiver-borrow marker for a `self` param (item-20 Phase 7 / WS4-a). Encodes
## the explicit borrow convention on a method's receiver param, in the otherwise-
## unused `rights` slot of a NODE_PARAM (params never carry a right child):
##   0 = bare `self` (or a non-self param) — legacy / inferred behavior
##   1 = `&self`      (explicit read-borrow — desugars to bare `self`, no flag)
##   2 = `&mut self`  (explicit mutable borrow — SETS mutates_self_field)
## Defaults to 0 for every param (the constructor pushes 0 into `rights`), so
## bare-`self` and non-receiver params are unchanged (byte-identical at gate 0).
def ast_param_set_receiver_borrow(s: AstStorage, h: AstNodeId, kind: Int): Void
  s.rights[h] = kind
end

## Reads the receiver-borrow marker (0=bare, 1=&self, 2=&mut self). See setter.
def ast_param_receiver_borrow(s: AstStorage, h: AstNodeId): Int = s.rights[h]

# ---------------------------------------------------------------------------
# Literal Constructors
# ---------------------------------------------------------------------------

## Creates an integer literal node.
## @param s AstStorage struct
## @param value The integer value
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_int_lit(s: AstStorage, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(0)
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(value)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a float literal node.
## Stores the float string in str1s since the compiler runs on i64-only
## and cannot convert float values at compile time.
## @param s AstStorage struct
## @param text The float literal string (e.g. "3.14", "1.5e3")
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_float_lit(s: AstStorage, text: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(68)  # NODE_FLOAT_LIT = 68
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, text)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a boolean literal node.
## @param s AstStorage struct
## @param value 1 for true, 0 for false
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_bool_lit(s: AstStorage, value: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(1)
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(value)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a nil literal node.
## @param s AstStorage struct
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_nil_lit(s: AstStorage, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(2)  # NODE_NIL_LIT = 2
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a string literal node.
## @param s AstStorage struct
## @param value The string content (with quotes stripped)
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_string_lit(s: AstStorage, value: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(3)  # NODE_STRING_LIT = 3
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, value)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a symbol literal node.
## Symbols are atomic values like `:ok`, `:error`.
## @param s AstStorage struct
## @param name Symbol name (without leading colon)
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_symbol_lit(s: AstStorage, name: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(4)  # NODE_SYMBOL_LIT = 4
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates an identifier node.
## Used for variable references and names.
## @param s AstStorage struct
## @param name Identifier text
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_ident(s: AstStorage, name: String, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(6)  # NODE_IDENT = 6
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a function reference node.
## Used for first-class function references with `&func` syntax.
## @param s AstStorage struct
## @param name Function name to reference
## @param line Source line
## @param col Source column
## @returns Node handle
# NodeFuncRef = 18 - function reference (&funcname syntax)
# Stores function name the same way as NodeIdent (in str1/slot 4)
def ast_func_ref(s: AstStorage, name: String, is_mut: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(18)  # NODE_FUNC_REF = 18
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  ast_intern_push_str1(s, name)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(0)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a projected data-borrow node `&mut p.f` / `&p.f` / `&mut a[i]`.
## Unlike ast_func_ref (which collapses the operand to a bare name string),
## this carries the FULLY-LOWERED operand place-expression (NODE_FIELD_ACCESS /
## NODE_INDEX subtree) in `left`, so the exclusivity checker can reason about
## the projected place. int_val = is_mut (1 for `&mut`, 0 for `&`).
## @param s AstStorage struct
## @param operand Fully-lowered operand place node (field access / index)
## @param is_mut 1 iff `&mut`, else 0
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_borrow(s: AstStorage, operand: Int, is_mut: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(102)  # NODE_BORROW = 102
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(is_mut)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(0)
  s.lefts.push(operand)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a binary expression node.
## Used for all two-operand expressions (+, -, ==, etc.).
## @param s AstStorage struct
## @param left Left operand handle
## @param op OpKind value
## @param right Right operand handle
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_binary(s: AstStorage, left: Int, op: Int, right: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(8)  # NODE_BINARY = 8
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(op)
  s.lefts.push(left)
  s.rights.push(right)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a unary expression node.
## Used for single-operand expressions (-, !, ~).
## @param s AstStorage struct
## @param op OpKind value
## @param operand Operand handle
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_unary(s: AstStorage, op: Int, operand: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(7)  # NODE_UNARY = 7
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)
  s.ops.push(op)
  s.lefts.push(operand)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(0)
  s.docs.push(0)
  return h
end

## Creates a function call node.
## @param s AstStorage struct
## @param callee Expression to call (identifier or expression)
## @param args Vector of argument handles
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_call(s: AstStorage, callee: Int, args: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(9)  # NODE_CALL = 9
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  s.str2s.push(0)  # str2 / type_arg for typed calls
  s.ops.push(0)
  s.lefts.push(callee)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(args)
  s.docs.push(0)
  return h
end

## ast_call_with_type_arg() - Create a typed function call node
## 
## For typed intrinsics like arena_alloc<Point>(arena)
##
## @param s AstStorage struct
## @param callee Expression to call (identifier or expression)
## @param type_arg Type argument string (e.g., "Point")
## @param args Vector of argument handles
## @param line Source line
## @param col Source column
## @returns Node handle
def ast_call_with_type_arg(s: AstStorage, callee: Int, type_arg: String, args: Int, line: Int, col: Int): Int
  var h = 0 + s.kinds.size
  s.kinds.push(9)  # NODE_CALL = 9
  s.lines.push(line)
  s.cols.push(col)
  s.int_vals.push(0)
  s.str1s.push(0)
  ast_intern_push_str2(s, type_arg)  # str2 stores type_arg for typed calls
  s.ops.push(0)
  s.lefts.push(callee)
  s.rights.push(0)
  s.extras.push(0)
  s.children.push(args)
  s.docs.push(0)
  return h
end

## ast_get_type_arg() - Get type argument for a typed call
## 
## Returns empty string if no type argument
def ast_get_type_arg(s: AstStorage, h: AstNodeId): String = string_intern::intern_resolve_int(s.interner, s.str2s[h])

## ast_call_set_is_ufcs() - Mark a call as coming from UFCS syntax
##
## Used to distinguish module.function(args) from legitimate calls
## where first arg happens to match a module name.
## Stores value in extras field (0 = not UFCS, nonzero = UFCS)
def ast_call_set_is_ufcs(s: AstStorage, h: AstNodeId, val: Int): Void
  ast_set_extra(s, h, val)
end

## ast_call_is_ufcs() - Check if call came from UFCS syntax
def ast_call_is_ufcs(s: AstStorage, h: AstNodeId): Int = ast_get_extra(s, h)

## ast_call_set_arg_names() - Store named argument names for a call node
## names is a Vec<String> handle (as Int), 0 if no named args.
## Each entry: "" for positional, "param_name" for named.
def ast_call_set_arg_names(s: AstStorage, h: AstNodeId, names: Int): Void
  s.ops[h] = names
end

## ast_call_get_arg_names() - Get named argument names for a call node
## Returns Vec<String> handle (as Int), 0 if no named args.
def ast_call_get_arg_names(s: AstStorage, h: AstNodeId): Int = s.ops[h]

## ast_call_set_default_mask() - Store bitmask of parameter slots that need defaults
## Bit i = 1 means param i should use its default value (named arg gap).
def ast_call_set_default_mask(s: AstStorage, h: AstNodeId, mask: Int): Void
  s.rights[h] = mask
end

## ast_call_get_default_mask() - Get bitmask of parameter slots needing defaults
def ast_call_get_default_mask(s: AstStorage, h: AstNodeId): Int = s.rights[h]

