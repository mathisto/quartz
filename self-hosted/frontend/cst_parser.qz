##! # CST Parser + Verbatim Round-Trip Oracle — Formatter M1.3 (part 1)
##!
##! Builds a **lossless** Concrete Syntax Tree (`cst.qz`) directly from the
##! full-fidelity token stream (`lexer.qz` with `lexer_set_full_fidelity(1)`),
##! and the verbatim CST→source serializer that is the losslessness *oracle*.
##!
##! ## Why this is a SEPARATE driver (not threaded into parser.qz)
##!
##! FORMATTER.md's ideal is "instrument the one grammar" — thread CST emission
##! through the same recursion that builds the AST. That requires running the
##! lexer in full-fidelity mode *during the AST parse*, which injects
##! `TOK_COMMENT` (and the already-present `TOK_NEWLINE`/doc tokens) into the
##! stream. The existing ~7K-line AST parser has **zero** `TOK_COMMENT`
##! handling (verified: no occurrence of `TOK_COMMENT` in parser.qz) and only
##! skips trivia at the call sites that invoke `ps_skip_newlines`. Flipping
##! full-fidelity on for the AST parse would therefore perturb the AST at every
##! token-consumer that does not skip comments — an AST regression, which is the
##! INVIOLABLE constraint we must not cross.
##!
##! So M1.3-part1 builds the CST as a **distinct, additive output** (the design
##! calls the CST a second producer, D1/§3) over its own full-fidelity token
##! stream. The AST parser is touched by ZERO lines; the AST and the entire
##! pipeline are provably byte-identical (fixpoint gen1==gen2 + qspec). The
##! deeper "CST→AST lowering so the AST comes FROM the CST" is the follow-up
##! step; this commit lands the lossless-CST infrastructure + oracle + a
##! meaningful core of the grammar, gated by byte-for-byte round-trip.
##!
##! ## Trivia capture (Roslyn EOL rule) at the single chokepoint
##!
##! `cps_advance` is the ONE place tokens are consumed. Before it returns the
##! next significant token, it drains the run of trivia tokens
##! (`TOK_NEWLINE`, `TOK_COMMENT`, `TOK_DOC_*`) that precede it into a pending
##! buffer, classifying each as a trivia record (kind + byte span). The Roslyn
##! end-of-line rule decides attachment: a comment on the *same line* as the
##! just-consumed token is that token's **trailing** trivia; everything from the
##! first newline onward (own-line comments, blank-line runs) becomes the
##! **leading** trivia of the next significant token. Blank-line runs are
##! coalesced into a single `TRIVIA_BLANK_LINES` record spanning the run (the
##! M2 printer collapses to <=1 line; this layer only stores).
##!
##! ## The oracle: `cst_to_source_verbatim`
##!
##! Walks the whole CST, gathers every `CST_TOKEN` leaf span and every attached
##! trivia-record span into a flat list, sorts by byte_start, and emits
##! `source[min_start .. max_end]`. Because every significant token and every
##! trivia run is represented somewhere in the tree with a correct half-open
##! byte span, and the inter-span gaps are exactly the original horizontal
##! whitespace, slicing the original source from the first to the last covered
##! byte reproduces the input byte-for-byte. Attachment (leading vs trailing) is
##! what M2 consumes; the oracle only needs presence + correct spans.
##!
##! @see cst.qz CstStorage arena + node/trivia kinds (M1.2)
##! @see lexer.qz Full-fidelity mode + per-token byte offsets (M1.1)
##! @see docs/design/FORMATTER.md D1, §3, §5 tension #1
##! @since 5.12.21-alpha (formatter epic)

import cst
import lexer
import token_constants
import string_intern

# ===========================================================================
# CST parser state
# ===========================================================================

## State for the CST parse over a full-fidelity token stream. Parallel token
## vectors come straight from `LexerResult`; `pending` is the trivia buffer
## drained at the chokepoint. `had_error` flips on the first unexpected token
## (the parser then falls back to a verbatim token-run so losslessness holds
## even for not-yet-structured grammar).
struct CstParser
  types: Vec<Int>          # token types
  lexemes: Vec<Int>        # interned lexeme ids
  lines: Vec<Int>          # 1-based token lines
  cols: Vec<Int>           # 1-based token cols
  byte_starts: Vec<Int>    # per-token byte start (half-open)
  byte_ends: Vec<Int>      # per-token byte end (exclusive)
  count: Int               # total token count
  pos: Int                 # current index into the token vectors
  store: cst::CstStorage   # the CST arena being built
  interner: string_intern::StringInterner
  source: String           # original source bytes (for the oracle)
  pending: Vec<Int>        # pending leading-trivia record handles (drained at advance)
  prev_line: Int           # line of the most-recently-consumed significant token
  prev_handle: Int         # handle of the most-recently-built CST_TOKEN leaf
  had_error: Int
  first_err_pos: Int       # token index where the first fallback fired (-1 = none)
  first_err_type: Int      # token type at the first fallback (diagnostic)
  first_err_line: Int      # 1-based source line of the first fallback (diagnostic)
  first_err_msg: String    # specific diagnostic message for the first error (empty = use the generic "CST parse error"). Carries the legacy QZ0530 text so spec stderr assertions match.
  err_msgs: Vec<String>    # ALL recorded error messages, in source order (empty msg = generic "CST parse error"). Enables multi-error recovery reporting (legacy parser.qz recovers + reports every syntax error; quartz.qz emits each of these).
  err_lines: Vec<Int>      # parallel to err_msgs: 1-based source line of each error.
  in_private_section: Int  # 1 after a `private` section keyword is consumed; a SECOND `private` is a per-file error (parser.qz:8403).
  suppress_trailing_block: Int  # When 1, cps_parse_postfix does NOT absorb a trailing `do…end` / `{…}` block as a lambda arg. Set while parsing the handler expr in `with H do … end` so the `do`/handler-map isn't stolen (mirrors parser.qz's ParserState.suppress_trailing_block).
end

## Builds a CstParser from a full-fidelity LexerResult + the original source.
def cps_new(lex: lexer::LexerResult, source: String): CstParser
  return CstParser {
    types: lex.get_types(),
    lexemes: lex.get_lexemes(),
    lines: lex.get_lines(),
    cols: lex.get_cols(),
    byte_starts: lex.get_byte_starts(),
    byte_ends: lex.get_byte_ends(),
    count: lex.token_count(),
    pos: 0,
    store: cst::cst_new_storage(),
    interner: lex.get_interner(),
    source: source,
    pending: vec_new(),
    prev_line: 0,
    prev_handle: 0,
    had_error: 0,
    first_err_pos: -1,
    first_err_type: 0,
    first_err_line: 0,
    first_err_msg: "",
    err_msgs: vec_new(),
    err_lines: vec_new(),
    in_private_section: 0,
    suppress_trailing_block: 0
  }
end

## Records a fallback (had_error) site for diagnostics. The FIRST site populates
## the legacy first_err_* fields (kept for callers that read them); EVERY site is
## additionally appended to err_msgs/err_lines so quartz.qz can report every
## syntax error in one pass (legacy parser.qz recovers + reports all errors). An
## empty `msg` means "use the generic CST parse error text" for that entry.
def cps_note_error_at(p: CstParser, msg: String): Void
  p.had_error = 1
  if p.first_err_pos == -1
    p.first_err_pos = p.pos
    p.first_err_type = cps_raw_type(p)
    p.first_err_line = cps_raw_line(p)
    p.first_err_msg = msg
  end
  p.err_msgs.push(msg)
  p.err_lines.push(cps_raw_line(p))
end

## Records the first fallback (had_error) site for diagnostics, generic message.
def cps_note_error(p: CstParser): Void
  cps_note_error_at(p, "")
end

## Like cps_note_error, but records a SPECIFIC diagnostic message that quartz.qz
## surfaces instead of the generic "CST parse error". Used for the QZ0530
## reserved-keyword-at-binding-site rejects so the spec stderr assertions match
## the legacy text. First message wins for first_err_msg; every message is
## additionally recorded for multi-error reporting.
def cps_note_error_msg(p: CstParser, msg: String): Void
  cps_note_error_at(p, msg)
end

## True (1) iff the token type is a reserved keyword that cannot legally appear
## as an identifier at a binding site. Mirrors parser.qz's
## `_ps_is_reserved_ident_token` (parser.qz:440) keyword set exactly.
def cps_is_reserved_ident_token(tt: Int): Int
  return 1 if tt == token_constants::TOK_DEF
  return 1 if tt == token_constants::TOK_END
  return 1 if tt == token_constants::TOK_IF
  return 1 if tt == token_constants::TOK_UNLESS
  return 1 if tt == token_constants::TOK_ELSE
  return 1 if tt == token_constants::TOK_ELSIF
  return 1 if tt == token_constants::TOK_WHILE
  return 1 if tt == token_constants::TOK_DO
  return 1 if tt == token_constants::TOK_RETURN
  return 1 if tt == token_constants::TOK_AND
  return 1 if tt == token_constants::TOK_OR
  return 1 if tt == token_constants::TOK_NOT
  return 1 if tt == token_constants::TOK_TRUE
  return 1 if tt == token_constants::TOK_FALSE
  return 1 if tt == token_constants::TOK_LET
  return 1 if tt == token_constants::TOK_VAR
  return 1 if tt == token_constants::TOK_BREAK
  return 1 if tt == token_constants::TOK_CONTINUE
  return 1 if tt == token_constants::TOK_FOR
  return 1 if tt == token_constants::TOK_IN
  return 1 if tt == token_constants::TOK_STRUCT
  return 1 if tt == token_constants::TOK_ENUM
  return 1 if tt == token_constants::TOK_MATCH
  return 1 if tt == token_constants::TOK_WHEN
  return 1 if tt == token_constants::TOK_THEN
  return 1 if tt == token_constants::TOK_IMPORT
  return 1 if tt == token_constants::TOK_TRAIT
  return 1 if tt == token_constants::TOK_IMPL
  return 1 if tt == token_constants::TOK_EXTERN
  return 1 if tt == token_constants::TOK_AWAIT
  return 1 if tt == token_constants::TOK_DEFER
  return 1 if tt == token_constants::TOK_ARENA
  return 1 if tt == token_constants::TOK_TRY
  return 1 if tt == token_constants::TOK_CATCH
  return 1 if tt == token_constants::TOK_NIL
  return 1 if tt == token_constants::TOK_IS
  return 1 if tt == token_constants::TOK_ASYNC
  return 1 if tt == token_constants::TOK_GO
  return 1 if tt == token_constants::TOK_CONST
  return 1 if tt == token_constants::TOK_NEWTYPE
  return 1 if tt == token_constants::TOK_TYPE
  return 1 if tt == token_constants::TOK_EXTEND
  return 1 if tt == token_constants::TOK_LOOP
  return 1 if tt == token_constants::TOK_MACRO
  return 1 if tt == token_constants::TOK_YIELD
  return 1 if tt == token_constants::TOK_ACTOR
  return 1 if tt == token_constants::TOK_CAN
  return 1 if tt == token_constants::TOK_EFFECT
  return 1 if tt == token_constants::TOK_WITH
  return 1 if tt == token_constants::TOK_REIFY
  return 1 if tt == token_constants::TOK_FROM
  return 1 if tt == token_constants::TOK_AS
  return 1 if tt == token_constants::TOK_WHERE
  return 1 if tt == token_constants::TOK_PRIVATE
  return 1 if tt == token_constants::TOK_PUBLIC
  return 0
end

## If the current token is a reserved keyword at a binding site, record the
## QZ0530 diagnostic (mirroring ps_expect_binding_name's message verbatim) and
## return 1. The caller still consumes the token losslessly. `context` names the
## binding position. Returns 0 when the current token is a legal identifier.
def cps_check_binding_name(p: CstParser, context: String): Int
  var tt = cps_cur_type(p)
  if cps_is_reserved_ident_token(tt) == 1
    var kw = cps_raw_lexeme(p)
    cps_note_error_msg(p, "QZ0530: '#{kw}' is a reserved keyword and cannot be used as an identifier in #{context}")
    return 1
  end
  return 0
end

# ---------------------------------------------------------------------------
# Token-classification helpers
# ---------------------------------------------------------------------------

## True (1) iff `name` is a recognized top-level attribute. Mirrors the legacy
## attribute dispatch chain (parser.qz:8560-8703); any name outside this set is
## rejected with "Unknown attribute". `c` is excluded — `@c(...)` is the inline-C
## EXPRESSION decorator, never a top-level definition attribute.
def cps_is_known_attribute(name: String): Int
  return 1 if str_eq(name, "cfg")
  return 1 if str_eq(name, "repr")
  return 1 if str_eq(name, "packed")
  return 1 if str_eq(name, "align")
  return 1 if str_eq(name, "naked")
  return 1 if str_eq(name, "noinline")
  return 1 if str_eq(name, "weak")
  return 1 if str_eq(name, "panic_handler")
  return 1 if str_eq(name, "export")
  return 1 if str_eq(name, "no_preempt")
  return 1 if str_eq(name, "pure")
  return 1 if str_eq(name, "io")
  return 1 if str_eq(name, "suspend")
  return 1 if str_eq(name, "thread_local")
  return 1 if str_eq(name, "strict")
  return 1 if str_eq(name, "ct")
  return 1 if str_eq(name, "value")
  return 1 if str_eq(name, "derive")
  return 0
end

## Is this token a trivia token (skipped by the AST path; preserved by the CST)?
def cps_is_trivia_type(tt: Int): Int
  if tt == token_constants::TOK_NEWLINE
    return 1
  end
  if tt == token_constants::TOK_COMMENT
    return 1
  end
  if tt == token_constants::TOK_DOC_COMMENT
    return 1
  end
  if tt == token_constants::TOK_DOC_MODULE
    return 1
  end
  if tt == token_constants::TOK_DOC_INLINE
    return 1
  end
  return 0
end

## Map a trivia token type → CstTriviaKind.
def cps_trivia_kind_of(tt: Int): Int
  if tt == token_constants::TOK_COMMENT
    return 1   # TRIVIA_LINE_COMMENT
  end
  if tt == token_constants::TOK_DOC_COMMENT
    return 2   # TRIVIA_DOC_COMMENT
  end
  if tt == token_constants::TOK_DOC_MODULE
    return 3   # TRIVIA_DOC_MODULE
  end
  if tt == token_constants::TOK_DOC_INLINE
    return 4   # TRIVIA_DOC_INLINE
  end
  return 6     # TRIVIA_NEWLINE (single line break)
end

# ---------------------------------------------------------------------------
# Raw (trivia-agnostic) token access at the current cursor
# ---------------------------------------------------------------------------

def cps_raw_type(p: CstParser): Int
  if p.pos >= p.count
    return token_constants::TOK_EOF
  end
  return p.types[p.pos]
end

def cps_raw_byte_start(p: CstParser): Int
  if p.pos >= p.count
    return str_byte_len(p.source)
  end
  return p.byte_starts[p.pos]
end

def cps_raw_byte_end(p: CstParser): Int
  if p.pos >= p.count
    return str_byte_len(p.source)
  end
  return p.byte_ends[p.pos]
end

def cps_raw_line(p: CstParser): Int
  if p.pos >= p.count
    return 0
  end
  return p.lines[p.pos]
end

def cps_raw_col(p: CstParser): Int
  if p.pos >= p.count
    return 0
  end
  return p.cols[p.pos]
end

def cps_raw_lexeme(p: CstParser): String
  if p.pos >= p.count
    return ""
  end
  return string_intern::intern_resolve_int(p.interner, p.lexemes[p.pos])
end

# ===========================================================================
# Trivia capture at the chokepoint (Roslyn EOL rule)
# ===========================================================================

## Drains the run of trivia tokens at the cursor, attaching each per the Roslyn
## end-of-line rule:
##   - a comment on the SAME line as the previously-consumed significant token
##     (i.e. before any newline has been seen) becomes that token's TRAILING
##     trivia;
##   - everything from the first newline onward — own-line comments, blank-line
##     runs — accumulates into `pending` to become the NEXT significant token's
##     LEADING trivia.
##
## Blank-line runs (>=2 consecutive newlines) are coalesced into ONE
## TRIVIA_BLANK_LINES record spanning the whole run; a single newline becomes a
## TRIVIA_NEWLINE record. Both are preserved so the oracle reproduces them
## verbatim; the M2 printer is what collapses runs.
def cps_drain_trivia(p: CstParser): Void
  var s = p.store
  var seen_newline = 0
  while true
    var tt = cps_raw_type(p)
    if cps_is_trivia_type(tt) == 0
      break
    end

    if tt == token_constants::TOK_NEWLINE
      # Coalesce a run of consecutive newlines into one record. A single
      # newline → TRIVIA_NEWLINE; two or more → TRIVIA_BLANK_LINES.
      var run_start = cps_raw_byte_start(p)
      var run_end = cps_raw_byte_end(p)
      var nl_count = 1
      p.pos = p.pos + 1
      while cps_raw_type(p) == token_constants::TOK_NEWLINE
        run_end = cps_raw_byte_end(p)
        nl_count = nl_count + 1
        p.pos = p.pos + 1
      end
      var nl_kind = 6  # TRIVIA_NEWLINE
      if nl_count >= 2
        nl_kind = 5    # TRIVIA_BLANK_LINES
      end
      var nl_triv = cst::cst_alloc_trivia(s, nl_kind, run_start, run_end)
      # Newlines always belong to the NEXT token's leading run.
      p.pending.push(nl_triv)
      seen_newline = 1
    else
      # A comment / doc-comment.
      var c_kind = cps_trivia_kind_of(tt)
      var c_start = cps_raw_byte_start(p)
      var c_end = cps_raw_byte_end(p)
      var c_triv = cst::cst_alloc_trivia(s, c_kind, c_start, c_end)
      if seen_newline == 0 and p.prev_handle != 0
        # Same line as the previous significant token → its TRAILING trivia.
        cst::cst_attach_trailing_trivia(s, p.prev_handle, c_triv)
      else
        # Own-line comment → leading trivia of the next significant token.
        p.pending.push(c_triv)
      end
      p.pos = p.pos + 1
    end
  end
end

## Attaches all currently-pending leading trivia to the given node and clears
## the pending buffer.
def cps_flush_pending_to(p: CstParser, h: Int): Void
  var s = p.store
  var n = p.pending.size
  var i = 0
  while i < n
    cst::cst_attach_leading_trivia(s, h, p.pending[i])
    i = i + 1
  end
  p.pending = vec_new()
end

# ===========================================================================
# Significant-token cursor (skips + captures trivia at the chokepoint)
# ===========================================================================

## Positions the cursor at the next SIGNIFICANT token, draining intervening
## trivia. After this returns, `cps_raw_*` describe the significant token (or
## EOF). This is the single chokepoint.
def cps_sync(p: CstParser): Void
  cps_drain_trivia(p)
end

## Current significant token type (after syncing past trivia).
def cps_cur_type(p: CstParser): Int
  cps_sync(p)
  return cps_raw_type(p)
end

## True if the cursor is at EOF (after syncing past trivia).
def cps_at_end(p: CstParser): Int
  if cps_cur_type(p) == token_constants::TOK_EOF
    return 1
  end
  return 0
end

## Consumes the current significant token, builds a CST_TOKEN leaf for it,
## flushes pending leading trivia onto that leaf, and returns its handle. This
## is THE advance chokepoint — every significant token flows through here.
def cps_advance_token(p: CstParser): Int
  cps_sync(p)
  var s = p.store
  var tt = cps_raw_type(p)
  var lex = cps_raw_lexeme(p)
  var bs = cps_raw_byte_start(p)
  var be = cps_raw_byte_end(p)
  var ln = cps_raw_line(p)
  var cl = cps_raw_col(p)
  var leaf = cst::cst_token(s, lex, bs, be, ln, cl)
  cps_flush_pending_to(p, leaf)
  # Track for the Roslyn same-line trailing rule.
  p.prev_line = ln
  p.prev_handle = leaf
  if tt != token_constants::TOK_EOF
    p.pos = p.pos + 1
  end
  return leaf
end

## Maps a token type to the surface glyph/keyword the legacy parser quotes in its
## "Expected 'X'" diagnostics (parser.qz threads a per-callsite message into
## ps_expect; the CST path has no such thread, so it synthesizes the common cases
## here). Returns "" for token types whose legacy text isn't a fixed glyph — the
## caller then falls back to the generic "CST parse error".
def cps_expected_token_text(tt: Int): String
  return ")" if tt == token_constants::TOK_RPAREN
  return "(" if tt == token_constants::TOK_LPAREN
  return "}" if tt == token_constants::TOK_RBRACE
  return "{" if tt == token_constants::TOK_LBRACE
  return "]" if tt == token_constants::TOK_RBRACKET
  return "[" if tt == token_constants::TOK_LBRACKET
  return "end" if tt == token_constants::TOK_END
  return "," if tt == token_constants::TOK_COMMA
  return ":" if tt == token_constants::TOK_COLON
  return ">" if tt == token_constants::TOK_GT
  return "=>" if tt == token_constants::TOK_FAT_ARROW
  return "|" if tt == token_constants::TOK_PIPE
  return ""
end

## Like cps_advance_token but verifies the token type first; on mismatch records
## a specific "Expected 'X'" diagnostic (mirroring the legacy ps_expect text so
## spec stderr assertions match) and sets had_error. When the expected token has
## no fixed surface glyph, the message stays empty and quartz.qz falls back to the
## generic "CST parse error". The caller's verbatim fallback keeps losslessness.
def cps_expect(p: CstParser, expected: Int): Int
  if cps_cur_type(p) != expected
    var glyph = cps_expected_token_text(expected)
    if str_byte_len(glyph) > 0
      cps_note_error_msg(p, "Expected '#{glyph}'")
    else
      cps_note_error(p)
    end
  end
  return cps_advance_token(p)
end

# ===========================================================================
# Span bookkeeping
# ===========================================================================

## Sets node `h`'s byte span to cover [start_handle's start, end_handle's end].
## Handles of 0 are ignored.
def cps_span_from_to(p: CstParser, h: Int, first: Int, last: Int): Void
  var s = p.store
  if first != 0
    cst::cst_set_byte_start(s, h, cst::cst_get_byte_start(s, first))
  end
  if last != 0
    cst::cst_set_byte_end(s, h, cst::cst_get_byte_end(s, last))
  end
end

## Allocates a structured node of `kind`, span initially empty (filled later).
def cps_node(p: CstParser, kind: Int): Int
  cps_sync(p)
  return cst::cst_alloc(p.store, kind, cps_raw_byte_start(p), cps_raw_byte_start(p), cps_raw_line(p), cps_raw_col(p))
end

# ===========================================================================
# Expression grammar (covered core)
#   precedence: or < and < equality < comparison < term(+,-) < factor(*,/,%)
#               < unary < postfix(call/.field/[index]) < primary
# ===========================================================================

## Parses a primary expression: literal / ident / parenthesized expr.
def cps_parse_primary(p: CstParser): Int
  var s = p.store
  var tt = cps_cur_type(p)

  if tt == token_constants::TOK_INT
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 3, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_INT_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_FLOAT_LIT
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 4, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_FLOAT_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_STRING
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 7, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_STRING_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_TRUE or tt == token_constants::TOK_FALSE
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 5, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_BOOL_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_NIL
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 6, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_NIL_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  # Float / char / symbol / regex / capture-var / nil-already-handled literals.
  if tt == token_constants::TOK_FLOAT_LIT
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 4, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_FLOAT_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_CHAR
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 11, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_CHAR_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_SYMBOL
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 12, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_SYMBOL_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_REGEX
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 13, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_REGEX_LIT
    cst::cst_push_child(s, n, h)
    return n
  end
  if tt == token_constants::TOK_UNDERSCORE
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 15, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_IDENT (wildcard as ident leaf)
    cst::cst_push_child(s, n, h)
    return n
  end

  # Split-token interpolated string: STRING_START (PART | INTERP_START expr INTERP_END)* STRING_END
  if tt == token_constants::TOK_STRING_START
    return cps_parse_interp_string(p)
  end

  # Zero-param arrow lambda `-> body` (no params before the arrow). Common as a
  # call argument: `it(name, -> run(name, prop))`, `go(-> worker())`. The arrow
  # opens the lambda directly; the body is a single expression.
  if tt == token_constants::TOK_ARROW
    var arrow = cps_advance_token(p)  # ->
    var lam = cst::cst_alloc(s, 36, 0, 0, cst::cst_get_line(s, arrow), cst::cst_get_col(s, arrow))  # CST_LAMBDA_ARROW
    cst::cst_push_child(s, lam, arrow)
    var body = cps_parse_lambda_body(p)
    cst::cst_push_child(s, lam, body)
    cps_span_from_to(p, lam, arrow, body)
    return lam
  end

  if tt == token_constants::TOK_LPAREN
    # Arrow-lambda params `(x: T, y) -> body`: keep the `(...)` VERBATIM (the
    # params are not expressions; the lambda arm consumes them) — decided by a
    # lookahead for a trailing `->`.
    if cps_scan_paren_arrow(p) == 1
      var lp0 = cps_advance_token(p)  # (
      var grp0 = cst::cst_alloc(s, 17, 0, 0, cst::cst_get_line(s, lp0), cst::cst_get_col(s, lp0))  # CST_PAREN (lambda params, verbatim)
      cst::cst_push_child(s, grp0, lp0)
      var rp0 = cps_capture_balanced_after_open(p, grp0, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
      cps_span_from_to(p, grp0, lp0, rp0)
      var lam = cst::cst_alloc(s, 36, 0, 0, cst::cst_get_line(s, lp0), cst::cst_get_col(s, lp0))  # CST_LAMBDA_ARROW
      cst::cst_push_child(s, lam, grp0)
      var arrow = cps_advance_token(p)
      cst::cst_push_child(s, lam, arrow)
      var body = cps_parse_lambda_body(p)
      cst::cst_push_child(s, lam, body)
      cps_span_from_to(p, lam, lp0, body)
      return lam
    end
    # Grouping `(e)`, unit `()`, or tuple `(a, b)` / `(e,)`: parse the contents as
    # comma-separated expressions STRUCTURALLY. cst_lower drops a lone group's
    # parens, maps a comma-bearing list to a tuple, and an empty `()` to unit.
    var lp = cps_advance_token(p)  # (
    var grp = cst::cst_alloc(s, 17, 0, 0, cst::cst_get_line(s, lp), cst::cst_get_col(s, lp))  # CST_PAREN
    cst::cst_push_child(s, grp, lp)
    var trailing = 0
    if cps_cur_type(p) != token_constants::TOK_RPAREN
      while true
        var e = cps_parse_expr(p)
        cst::cst_push_child(s, grp, e)
        trailing = 0
        if cps_cur_type(p) == token_constants::TOK_COMMA
          var comma = cps_advance_token(p)
          cst::cst_push_child(s, grp, comma)
          trailing = 1
          if cps_cur_type(p) == token_constants::TOK_RPAREN
            break
          end
        else
          break
        end
      end
    end
    var rp = cps_expect(p, token_constants::TOK_RPAREN)  # )
    cst::cst_push_child(s, grp, rp)
    cst::cst_set_trailing_comma(s, grp, trailing)
    cps_span_from_to(p, grp, lp, rp)
    return grp
  end
  # Arrow lambda with a SINGLE bare param: `x -> body`. Detect ident followed by
  # `->` at primary position.
  if tt == token_constants::TOK_IDENT and cps_peek_next_significant_type(p) == token_constants::TOK_ARROW
    var pname = cps_advance_token(p)
    var arrow = cps_advance_token(p)
    var lam = cst::cst_alloc(s, 36, 0, 0, cst::cst_get_line(s, pname), cst::cst_get_col(s, pname))  # CST_LAMBDA_ARROW
    cst::cst_push_child(s, lam, pname)
    cst::cst_push_child(s, lam, arrow)
    var body = cps_parse_lambda_body(p)
    cst::cst_push_child(s, lam, body)
    cps_span_from_to(p, lam, pname, body)
    return lam
  end
  # Single typed-param arrow lambda `name: Type -> body` (no parens) — common as
  # a call argument (`each(xs, x: T -> ...)`). Detect ident `:` then a type that
  # ends with `->`. We capture name + `:` + type, then arrow + body.
  if tt == token_constants::TOK_IDENT and cps_peek_next_significant_type(p) == token_constants::TOK_COLON and cps_scan_typed_arrow_lambda(p) == 1
    var lam = cps_node(p, 36)  # CST_LAMBDA_ARROW
    var pn = cps_advance_token(p)   # param name
    cst::cst_push_child(s, lam, pn)
    var colon = cps_advance_token(p)  # :
    cst::cst_push_child(s, lam, colon)
    var ty = cps_parse_type(p)        # param type (stops before `->` or `,`)
    cst::cst_push_child(s, lam, ty)
    # Additional comma-separated typed params: `acc: Int, x: Int -> body`.
    # parser.qz's ps_parse_arrow_lambda (parser.qz:2573-2587) collects every
    # `, name : type` pair into ONE param list before the `->`; mirror that here
    # so the no-paren form is a single multi-param lambda, not curried singles.
    while cps_cur_type(p) == token_constants::TOK_COMMA
      var comma = cps_advance_token(p)  # ,
      cst::cst_push_child(s, lam, comma)
      var pn2 = cps_advance_token(p)    # param name
      cst::cst_push_child(s, lam, pn2)
      if cps_cur_type(p) == token_constants::TOK_COLON
        var colon2 = cps_advance_token(p)  # :
        cst::cst_push_child(s, lam, colon2)
        var ty2 = cps_parse_type(p)        # param type
        cst::cst_push_child(s, lam, ty2)
      end
    end
    var arrow = cps_advance_token(p)  # ->
    cst::cst_push_child(s, lam, arrow)
    var body = cps_parse_lambda_body(p)
    cst::cst_push_child(s, lam, body)
    cps_span_from_to(p, lam, pn, body)
    return lam
  end
  # Plain identifier (after the arrow-lambda detections above).
  if tt == token_constants::TOK_IDENT
    var h = cps_advance_token(p)
    var n = cst::cst_alloc(s, 15, cst::cst_get_byte_start(s, h), cst::cst_get_byte_end(s, h), cst::cst_get_line(s, h), cst::cst_get_col(s, h))  # CST_IDENT
    cst::cst_push_child(s, n, h)
    return n
  end
  # `try expr` / `try expr catch ... end` in expression position.
  if tt == token_constants::TOK_TRY
    return cps_parse_try(p)
  end
  # `task_group |g| ... end` / `select ... end` in expression position.
  if tt == token_constants::TOK_TASK_GROUP
    return cps_parse_block_keyword(p, 73)  # CST_TASK_GROUP
  end
  # `reify { expr }` — effect-to-Result reifier (piezo). Body parsed STRUCTURALLY
  # (single expr child) so cst_lower can drop the transparent reify wrapper and
  # return the lowered inner expr, matching legacy ps_parse_reify's direct return.
  if tt == token_constants::TOK_REIFY
    return cps_parse_reify(p)  # CST_REIFY
  end
  if tt == token_constants::TOK_SELECT
    return cps_parse_select(p)  # CST_SELECT (structured case/default arms)
  end
  # `with Handler ... do -> ... end` in expression position (RHS of a binding).
  if tt == token_constants::TOK_WITH
    return cps_parse_with(p)
  end
  # `match <e> ... end` in expression position (RHS of a binding / arg).
  if tt == token_constants::TOK_MATCH
    return cps_parse_match(p)
  end
  # `if <e> ... end` / `unless` as an expression (Quartz if-expression).
  if tt == token_constants::TOK_IF or tt == token_constants::TOK_UNLESS
    return cps_parse_if(p)
  end
  # `loop ... break VALUE ... end` as an expression (RHS of a binding). Legacy
  # parses `loop` in primary position (parser.qz:1540) so `var x = loop … break
  # v … end` yields the break value; the CST primary path was missing it, so the
  # form failed flag-ON. Unlabeled here — a `:label loop` is statement-only.
  if tt == token_constants::TOK_LOOP
    return cps_parse_loop(p, 0)
  end
  # Concurrency expression prefixes: `go f()`, `async ...`, `spawn ...`. Also the
  # block form `go do [-> | x ->] ... end` (RHS of a binding / argument).
  if tt == token_constants::TOK_GO or tt == token_constants::TOK_ASYNC
    var gk = cps_advance_token(p)
    var n = cst::cst_alloc(s, 42, 0, 0, cst::cst_get_line(s, gk), cst::cst_get_col(s, gk))  # CST_AWAIT carrier
    cst::cst_push_child(s, n, gk)
    if cps_cur_type(p) == token_constants::TOK_DO
      var dokw = cps_advance_token(p)
      cst::cst_push_child(s, n, dokw)
      cps_capture_do_header(p, n)
      var gbody = cps_parse_block_until(p)
      cst::cst_push_child(s, n, gbody)
      var gend = cps_expect(p, token_constants::TOK_END)
      cst::cst_push_child(s, n, gend)
      cps_span_from_to(p, n, gk, gend)
      return n
    end
    var operand = cps_parse_unary(p)
    cst::cst_push_child(s, n, operand)
    cps_span_from_to(p, n, gk, operand)
    return n
  end
  # `do … end` block expression in value position (`result = do … end`). The last
  # expression in the block is the block's value; the `do`/header/body/`end`
  # tokens are captured under a CST_BLOCK (kind 43 = "a brace/`do…end` statement
  # sequence").
  if tt == token_constants::TOK_DO
    var dok = cps_advance_token(p)  # do
    var dn = cst::cst_alloc(s, 43, 0, 0, cst::cst_get_line(s, dok), cst::cst_get_col(s, dok))  # CST_BLOCK (do…end carrier)
    cst::cst_push_child(s, dn, dok)
    cps_capture_do_header(p, dn)
    var dbody = cps_parse_block_until(p)
    cst::cst_push_child(s, dn, dbody)
    var dend = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, dn, dend)
    cps_span_from_to(p, dn, dok, dend)
    return dn
  end
  # `~expr` bitwise-not unary (TILDE).
  if tt == token_constants::TOK_TILDE
    var op = cps_advance_token(p)
    var operand = cps_parse_unary(p)
    var n = cst::cst_alloc(s, 18, 0, 0, cst::cst_get_line(s, op), cst::cst_get_col(s, op))  # CST_UNARY
    cst::cst_set_op(s, n, 19)  # CST_OP_BITNOT
    cst::cst_push_child(s, n, op)
    cst::cst_push_child(s, n, operand)
    cps_span_from_to(p, n, op, operand)
    return n
  end
  # Array / collection literal `[ ... ]`. The plain comma-separated form is
  # parsed STRUCTURALLY (CST_ARRAY_LIT wrapping a CST_ELEM_LIST of structured
  # element exprs / `...spread`s) so cst_lower reproduces parser.qz's NODE_ARRAY
  # children. List/comprehension forms (`[expr for x in xs]`) fall back to a
  # balanced verbatim capture — lossless, no error — which lowers to an empty
  # NODE_ARRAY exactly as before (M2.2 will structure them).
  if tt == token_constants::TOK_LBRACKET
    return cps_parse_array_lit(p)
  end
  # Brace group `{ ... }`: standalone curly-block / brace lambda, or map / set
  # literal / comprehension. Dispatched STRUCTURALLY (cps_parse_brace_group)
  # mirroring legacy precedence so each form lowers to its AST instead of leaking
  # the prior all-verbatim `__UNLOWERED_30` placeholder.
  if tt == token_constants::TOK_LBRACE
    return cps_parse_brace_group(p)
  end
  # Macro / try sigil `$name(...)` or `$0..$9` capture-var.
  if tt == token_constants::TOK_DOLLAR
    return cps_parse_dollar(p)
  end
  # Attribute / decorator / inline-C sigil in expression position `@name(...)`.
  if tt == token_constants::TOK_AT
    return cps_parse_at_expr(p)
  end
  # Function reference `&name` / borrow `&expr` / mutable borrow `&mut name`.
  # Legacy (parser.qz:3410-3429) consumes an optional `mut` keyword immediately
  # after `&` (the is_mut flag) BEFORE the operand; without this the operand
  # parse swallows `mut` as a bare ident and strands the real name as a separate
  # statement. The `mut` keyword (if present) is pushed as a child leaf so the
  # CST stays lossless; cst_lower discriminates it by lexeme.
  if tt == token_constants::TOK_AMP
    var amp = cps_advance_token(p)
    var mut_tok = 0
    if cps_cur_type(p) == token_constants::TOK_IDENT and str_eq(cps_raw_lexeme(p), "mut") == 1
      mut_tok = cps_advance_token(p)
    end
    var operand = cps_parse_unary(p)
    var n = cst::cst_alloc(s, 33, 0, 0, cst::cst_get_line(s, amp), cst::cst_get_col(s, amp))  # CST_FUNC_REF
    cst::cst_push_child(s, n, amp)
    if mut_tok != 0
      cst::cst_push_child(s, n, mut_tok)
    end
    cst::cst_push_child(s, n, operand)
    cps_span_from_to(p, n, amp, operand)
    return n
  end
  # `await expr`.
  if tt == token_constants::TOK_AWAIT
    var aw = cps_advance_token(p)
    var operand = cps_parse_unary(p)
    var n = cst::cst_alloc(s, 42, 0, 0, cst::cst_get_line(s, aw), cst::cst_get_col(s, aw))  # CST_AWAIT
    cst::cst_push_child(s, n, aw)
    cst::cst_push_child(s, n, operand)
    cps_span_from_to(p, n, aw, operand)
    return n
  end
  # `quote do <stmts> end` — macro template body (parser.qz ps_parse_quote_block).
  # Children: `quote` tok, `do` tok, a CST_BLOCK of structured statements (so a
  # nested `unquote(...)` parses through cps_parse_primary), `end` tok. cst_lower's
  # cl_lower_quote wraps the lowered block in ast_quote.
  if tt == token_constants::TOK_QUOTE
    return cps_parse_quote(p)
  end
  # `unquote(expr)` — splice a macro argument inside a quote block (parser.qz
  # ps_parse_unquote_expr). Children: `unquote` tok, `(` tok, structured expr, `)`.
  if tt == token_constants::TOK_UNQUOTE
    var uq = cps_advance_token(p)  # unquote
    var n = cst::cst_alloc(s, 127, 0, 0, cst::cst_get_line(s, uq), cst::cst_get_col(s, uq))  # CST_UNQUOTE
    cst::cst_push_child(s, n, uq)
    var lp = cps_expect(p, token_constants::TOK_LPAREN)
    cst::cst_push_child(s, n, lp)
    var inner = cps_parse_expr(p)
    cst::cst_push_child(s, n, inner)
    var rp = cps_expect(p, token_constants::TOK_RPAREN)
    cst::cst_push_child(s, n, rp)
    cps_span_from_to(p, n, uq, rp)
    return n
  end
  # `unquote_each(param, "sep")` — splice variadic args joined by a separator
  # (parser.qz ps_parse_unquote_each_expr). Children: `unquote_each` tok, `(` tok,
  # param IDENT, `,` tok, separator STRING, `)` tok. cst_lower extracts the param
  # name and separator lexeme.
  if tt == token_constants::TOK_UNQUOTE_EACH
    var uek = cps_advance_token(p)  # unquote_each
    var n = cst::cst_alloc(s, 128, 0, 0, cst::cst_get_line(s, uek), cst::cst_get_col(s, uek))  # CST_UNQUOTE_EACH
    cst::cst_push_child(s, n, uek)
    var lp = cps_expect(p, token_constants::TOK_LPAREN)
    cst::cst_push_child(s, n, lp)
    var param = cps_advance_token(p)  # param name (IDENT)
    cst::cst_push_child(s, n, param)
    var comma = cps_expect(p, token_constants::TOK_COMMA)
    cst::cst_push_child(s, n, comma)
    var sep = cps_advance_token(p)  # separator STRING leaf
    cst::cst_push_child(s, n, sep)
    var rp = cps_expect(p, token_constants::TOK_RPAREN)
    cst::cst_push_child(s, n, rp)
    cps_span_from_to(p, n, uek, rp)
    return n
  end

  # A binary operator in expression position is a misplaced multi-line
  # continuation (`a` newline `^ b` — the operator must END the previous line).
  # parser.qz:1905 rejects with QZ0103; mirror that specific text instead of the
  # generic fallback so the leading-operator case is a clear diagnostic.
  if cps_is_misplaced_binary_op(cps_cur_type(p)) == 1
    var op_lex = cps_raw_lexeme(p)
    # #7: a leading `*` immediately followed by an identifier (`y = *x`) is a
    # Rust/C pointer dereference, not a misplaced line-continuation. Quartz has
    # no dereference operator, so append a targeted note. Gated tightly on
    # (op is `*`) AND (next significant token is an identifier); every other
    # misplaced operator — and a bare/trailing `*` — keeps the unchanged base
    # QZ0103 message. Infix `*` (`a * b`) never reaches this primary-parser
    # fallthrough (the left operand is already parsed), so this only fires on a
    # true expression-start `*`. Inert: QZ0103 fires only on a malformed
    # expression-start, which never occurs in the clean self-hosted source.
    if cps_cur_type(p) == token_constants::TOK_STAR and cps_peek_next_significant_type(p) == token_constants::TOK_IDENT
      cps_note_error_msg(p, "QZ0103: binary operator '#{op_lex}' cannot start an expression — for a multi-line expression, put the operator at the END of the previous line (`a #{op_lex}` then a newline then `b`), not the start of the continuation line\nnote: Quartz has no dereference operator; use CPtr + FFI (ptr_read)")
      return cps_advance_token(p)
    end
    cps_note_error_msg(p, "QZ0103: binary operator '#{op_lex}' cannot start an expression — for a multi-line expression, put the operator at the END of the previous line (`a #{op_lex}` then a newline then `b`), not the start of the continuation line")
    return cps_advance_token(p)
  end

  # Unknown primary — emit a verbatim token leaf so losslessness holds.
  cps_note_error(p)
  return cps_advance_token(p)
end

## True (1) iff the token type is a binary operator that cannot start an
## expression. Mirrors parser.qz:1138 `_ps_is_misplaced_binary_op`.
def cps_is_misplaced_binary_op(tt: Int): Int
  return 1 if tt == token_constants::TOK_CARET
  return 1 if tt == token_constants::TOK_STAR
  return 1 if tt == token_constants::TOK_SLASH
  return 1 if tt == token_constants::TOK_PERCENT
  return 1 if tt == token_constants::TOK_PLUS
  return 1 if tt == token_constants::TOK_PIPE
  return 1 if tt == token_constants::TOK_PIPE_GT
  return 1 if tt == token_constants::TOK_EQ
  return 1 if tt == token_constants::TOK_NE
  return 1 if tt == token_constants::TOK_LT
  return 1 if tt == token_constants::TOK_GT
  return 1 if tt == token_constants::TOK_LE
  return 1 if tt == token_constants::TOK_GE
  return 1 if tt == token_constants::TOK_LSHIFT
  return 1 if tt == token_constants::TOK_RSHIFT
  return 1 if tt == token_constants::TOK_AND
  return 1 if tt == token_constants::TOK_OR
  return 0
end

## Parses a split-token interpolated string into CST_INTERP_STRING. Literal
## chunks become CST_INTERP_PART leaves; `#{ expr }` holes become CST_INTERP_EXPR
## wrapping the parsed expression. Every START/PART/INTERP_START/INTERP_END/END
## token is captured as a leaf so the original bytes round-trip exactly.
def cps_parse_interp_string(p: CstParser): Int
  var s = p.store
  var start = cps_advance_token(p)  # STRING_START
  var node = cst::cst_alloc(s, 8, 0, 0, cst::cst_get_line(s, start), cst::cst_get_col(s, start))  # CST_INTERP_STRING
  cst::cst_push_child(s, node, start)
  var last = start
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_STRING_END or tt == token_constants::TOK_EOF
      break
    end
    if tt == token_constants::TOK_STRING_PART
      var part = cps_advance_token(p)
      cst::cst_push_child(s, node, part)
      last = part
    elsif tt == token_constants::TOK_INTERP_START
      var istart = cps_advance_token(p)  # #{
      var hole = cst::cst_alloc(s, 10, 0, 0, cst::cst_get_line(s, istart), cst::cst_get_col(s, istart))  # CST_INTERP_EXPR
      cst::cst_push_child(s, hole, istart)
      if cps_cur_type(p) != token_constants::TOK_INTERP_END
        var e = cps_parse_expr(p)
        cst::cst_push_child(s, hole, e)
      end
      if cps_cur_type(p) == token_constants::TOK_INTERP_END
        var iend = cps_advance_token(p)
        cst::cst_push_child(s, hole, iend)
        cps_span_from_to(p, hole, istart, iend)
      else
        cps_span_from_to(p, hole, istart, istart)
      end
      cst::cst_push_child(s, node, hole)
      last = hole
    else
      break
    end
  end
  if cps_cur_type(p) == token_constants::TOK_STRING_END
    var send = cps_advance_token(p)
    cst::cst_push_child(s, node, send)
    last = send
  end
  cps_span_from_to(p, node, start, last)
  return node
end

## `$name(...)` macro call / `$try(...)` / `$0`..`$9` capture var. We capture the
## `$` and the following name; if a `(` follows, an argument list. Lossless.
def cps_parse_dollar(p: CstParser): Int
  var s = p.store
  var dollar = cps_advance_token(p)  # $
  var node = cst::cst_alloc(s, 40, 0, 0, cst::cst_get_line(s, dollar), cst::cst_get_col(s, dollar))  # CST_MACRO_CALL
  cst::cst_push_child(s, node, dollar)
  var last = dollar
  # Name token (ident or digit) on the SAME line as the sigil — `$try`, `$0`.
  # `try` lexes as the keyword TOK_TRY (not TOK_IDENT); capture it (and any
  # keyword-as-name) so the lowered macro call is named and reaches the QZ0503
  # retirement hint instead of an unnamed `__UNLOWERED_40`.
  if (cps_cur_type(p) == token_constants::TOK_IDENT or cps_cur_type(p) == token_constants::TOK_INT or cps_cur_type(p) == token_constants::TOK_TRY) and cps_raw_line(p) == cst::cst_get_line(s, dollar)
    var name = cps_advance_token(p)
    cst::cst_push_child(s, node, name)
    last = name
  end
  if cps_cur_type(p) == token_constants::TOK_LPAREN
    var args = cps_parse_arg_list(p)
    cst::cst_push_child(s, node, args)
    last = args
  end
  cps_span_from_to(p, node, dollar, last)
  return node
end

## `@name ...` attribute / inline-C / alloc / field-access in expression position.
## Captures the `@`, the name, then disambiguates (matching legacy parser.qz's
## expr-position `@` handling) into three shapes, all carried on CST_DECORATOR(101):
##
##   1. `@c("code"[, args...])`  — inline C/asm escape hatch. The `(` is captured
##      as a leaf, the code STRING leaf is captured, and each comma-separated arg
##      is parsed as a STRUCTURED expression child (lowered to INLINE_C args).
##   2. `@name EXPR`             — allocation (`@heap p`, `@arena_name [..]`). The
##      operand is a STRUCTURED postfix expression child (lowered to ALLOC_EXPR).
##      Recognized when a primary-starting token follows on the same line with a
##      whitespace gap after the name (legacy: any non-special `@name` outside an
##      extend method, or any special alloc name).
##   3. bare `@field`           — implicit-self field access inside extend methods
##      (`@_data`, `@count`). No operand consumed; any adjacent postfix (`[i]`,
##      `.m`, `(args)`) is applied by the outer postfix parser on the lowered
##      `self.field`. This is the default when no alloc operand / inline-C follows.
##
## Lossless: every captured token (incl. inline-C `(`/`,`/`)`) is a leaf; the
## structured operand/arg children round-trip via their own token leaves.
def cps_parse_at_expr(p: CstParser): Int
  var s = p.store
  var at = cps_advance_token(p)  # @
  var node = cst::cst_alloc(s, 101, 0, 0, cst::cst_get_line(s, at), cst::cst_get_col(s, at))  # CST_DECORATOR
  cst::cst_push_child(s, node, at)
  var last = at
  # The name MUST be an ident (or keyword usable as a name) on the SAME line as
  # `@`. Never consume a block terminator / newline-separated token.
  var name_lex = ""
  var name_byte_end = 0 - 1
  if cps_cur_type(p) == token_constants::TOK_IDENT and cps_raw_line(p) == cst::cst_get_line(s, at)
    name_lex = cps_raw_lexeme(p)
    name_byte_end = cps_raw_byte_end(p)
    var name = cps_advance_token(p)
    cst::cst_push_child(s, node, name)
    last = name
  else
    # `@` not followed by an identifier on the same line (e.g. `@@@`, `@ +`).
    # Legacy (parser.qz:1328-1330) rejects this with "Expected identifier after
    # '@'"; without the reject the empty-name decorator mis-lowers to bare `self`
    # (FIELD_ACCESS(self, "")) and surfaces as a spurious QZ0403.
    cps_note_error_msg(p, "Expected identifier after '@'")
    cps_span_from_to(p, node, at, last)
    return node
  end
  # --- Inline C: `@c("code"[, expr]*)` -----------------------------------
  if str_eq(name_lex, "c") and cps_cur_type(p) == token_constants::TOK_LPAREN
    var lp = cps_advance_token(p)  # (
    cst::cst_push_child(s, node, lp)
    last = lp
    # code literal (a STRING or interp-string leaf/node).
    if cps_cur_type(p) != token_constants::TOK_RPAREN and cps_at_end(p) == 0
      var code = cps_parse_expr(p)
      cst::cst_push_child(s, node, code)
      last = code
    end
    while cps_cur_type(p) == token_constants::TOK_COMMA
      var comma = cps_advance_token(p)
      cst::cst_push_child(s, node, comma)
      var arg = cps_parse_expr(p)
      cst::cst_push_child(s, node, arg)
      last = arg
    end
    if cps_cur_type(p) == token_constants::TOK_RPAREN
      var rp = cps_advance_token(p)
      cst::cst_push_child(s, node, rp)
      last = rp
    end
    cps_span_from_to(p, node, at, last)
    return node
  end
  # --- Allocation: `@name EXPR` (`@heap p`, `@arena_name [..]`) -----------
  # An alloc operand is a primary-starting token on the SAME line as the name,
  # separated from the name by whitespace (byte gap). An ADJACENT `(`/`[`/`.`
  # is a postfix on the field-access form (case 3), so it is NOT an operand.
  if name_byte_end >= 0 and cps_starts_alloc_operand(p, name_byte_end, cst::cst_get_line(s, at)) == 1
    var operand = cps_parse_postfix(p)
    cst::cst_push_child(s, node, operand)
    last = operand
    cps_span_from_to(p, node, at, last)
    return node
  end
  # --- Bare field access (`@field`) --------------------------------------
  cps_span_from_to(p, node, at, last)
  return node
end

## True when the current token begins an allocation operand for `@name EXPR`:
## a primary-starting token (`ident`/literal/`[`/`{`/`(`), on the SAME line as the
## `@` (`name_line`), with a whitespace gap after the decorator name
## (`name_byte_end < cur.byte_start`). The same-line requirement avoids grabbing
## the next statement (`while i < @_size` ↵ `var idx ...`) as an operand; the gap
## requirement keeps adjacent postfix (`@_data[i]`, `@field.m`, `@f(x)`) as
## field-access postfix rather than an alloc operand.
def cps_starts_alloc_operand(p: CstParser, name_byte_end: Int, name_line: Int): Int
  # cps_cur_type syncs past trivia FIRST so cps_raw_line/byte read the real next
  # significant token (not an intervening newline whose line is still name_line).
  var tt = cps_cur_type(p)
  if cps_raw_line(p) != name_line
    return 0
  end
  var starts = 0
  if tt == token_constants::TOK_IDENT or tt == token_constants::TOK_INT or tt == token_constants::TOK_FLOAT_LIT or tt == token_constants::TOK_STRING or tt == token_constants::TOK_STRING_START or tt == token_constants::TOK_TRUE or tt == token_constants::TOK_FALSE or tt == token_constants::TOK_LBRACKET or tt == token_constants::TOK_LBRACE or tt == token_constants::TOK_LPAREN
    starts = 1
  end
  if starts == 0
    return 0
  end
  # whitespace gap: operand token starts strictly after the name's last byte.
  if cps_raw_byte_start(p) <= name_byte_end
    return 0
  end
  return 1
end

## Parses a balanced delimited group `open ... close` of `kind`, capturing every
## token as a child leaf (recursively balanced on nested same/other delimiters).
## Never sets had_error: any token sequence is captured losslessly. Used for
## collection / brace literals whose fine internal structure M2.2 will refine.
def cps_parse_balanced_group(p: CstParser, kind: Int, open: Int, close: Int): Int
  var s = p.store
  var node = cps_node(p, kind)
  var openh = cps_advance_token(p)  # open delimiter
  cst::cst_push_child(s, node, openh)
  var last = cps_capture_balanced_after_open(p, node, open, close)
  cps_span_from_to(p, node, openh, last)
  return node
end

## Captures a balanced run starting AT the open delimiter (which is consumed
## here), pushing all tokens (including the matching close) as children of
## `parent`. Returns the handle of the last token consumed (the close delim).
def cps_capture_balanced(p: CstParser, parent: Int, open: Int, close: Int): Int
  var openh = cps_advance_token(p)  # open
  cst::cst_push_child(p.store, parent, openh)
  return cps_capture_balanced_after_open(p, parent, open, close)
end

## Captures tokens after an already-consumed open delimiter up to and including
## the matching close, pushing each as a child of `parent`, recursing on nested
## `(`/`[`/`{`. Returns the last token (the close). Lossless; never errors.
def cps_capture_balanced_after_open(p: CstParser, parent: Int, open: Int, close: Int): Int
  var s = p.store
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_EOF
      break
    end
    if tt == close
      var ch = cps_advance_token(p)
      cst::cst_push_child(s, parent, ch)
      last = ch
      break
    end
    if tt == token_constants::TOK_LPAREN
      last = cps_capture_balanced(p, parent, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LBRACKET
      last = cps_capture_balanced(p, parent, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    elsif tt == token_constants::TOK_LBRACE
      last = cps_capture_balanced(p, parent, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    else
      var tok = cps_advance_token(p)
      cst::cst_push_child(s, parent, tok)
      last = tok
    end
  end
  return last
end

## Lookahead: is the `<` at the cursor the start of a generic-call turbofish
## `<TypeArgs>(` (as opposed to a comparison)? Scans the raw token stream from
## the current position WITHOUT consuming, tracking angle-bracket depth (a `>>`
## token closes two levels). Returns 1 iff the first token after `<` is an IDENT
## and the matching close is immediately followed by `(`. Mirrors parser.qz's
## turbofish gate (first type-arg must be an IDENT).
def cps_is_turbofish(p: CstParser): Int
  var i = p.pos
  # Skip leading trivia to the `<`.
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_LT
    return 0
  end
  i = i + 1
  # First token after `<` (skip trivia) must be an IDENT.
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_IDENT
    return 0
  end
  var depth = 1
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LT
      depth = depth + 1
    elsif tt == token_constants::TOK_GT
      depth = depth - 1
    elsif tt == token_constants::TOK_RSHIFT
      depth = depth - 2
    elsif tt == token_constants::TOK_LBRACE or tt == token_constants::TOK_EOF or tt == token_constants::TOK_NEWLINE
      return 0
    end
    if depth <= 0
      # Found the matching close at index i. Next significant token must be `(`.
      var j = i + 1
      while j < p.count and cps_is_trivia_type(p.types[j]) == 1
        j = j + 1
      end
      if j < p.count and p.types[j] == token_constants::TOK_LPAREN
        return 1
      end
      return 0
    end
    i = i + 1
  end
  return 0
end

## True if the `<` at the cursor begins a GENERIC STRUCT-INIT type-arg list —
## `Type<Args> { fields }` (`GSPair<Int, String> { first: 42, second: "x" }`).
## Mirrors `cps_is_turbofish` but the matching `>` must be followed by `{` (not
## `(`) and the receiver `node` must be a PascalCase ident/path (Quartz type
## convention, matching parser.qz's `_gen_is_pascal` gate). Distinguishing this
## from a `<` comparison: a comparison's RHS would not be a balanced `<…>` closed
## immediately before a `{` on a PascalCase receiver.
def cps_is_generic_struct_init(p: CstParser, node: Int): Int
  var s = p.store
  var k = cst::cst_get_kind(s, node)
  if k != 15 and k != 16  # CST_IDENT / CST_PATH
    return 0
  end
  # Receiver tail must be PascalCase (skip a leading `_`).
  if p.prev_handle == 0
    return 0
  end
  var lex = cst::cst_get_str1(s, p.prev_handle)
  var idx = 0
  if str_byte_len(lex) > 0 and lex.str_byte_at(0) == '_'
    idx = 1
  end
  if idx >= str_byte_len(lex)
    return 0
  end
  var fb = lex.str_byte_at(idx)
  if fb < 'A' or fb > 'Z'
    return 0
  end
  # Scan the balanced `<…>` exactly as cps_is_turbofish does, then require `{`.
  var i = p.pos
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_LT
    return 0
  end
  i = i + 1
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_IDENT
    return 0
  end
  var depth = 1
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LT
      depth = depth + 1
    elsif tt == token_constants::TOK_GT
      depth = depth - 1
    elsif tt == token_constants::TOK_RSHIFT
      depth = depth - 2
    elsif tt == token_constants::TOK_LBRACE or tt == token_constants::TOK_EOF or tt == token_constants::TOK_NEWLINE
      return 0
    end
    if depth <= 0
      var j = i + 1
      while j < p.count and cps_is_trivia_type(p.types[j]) == 1
        j = j + 1
      end
      if j < p.count and p.types[j] == token_constants::TOK_LBRACE
        return 1
      end
      return 0
    end
    i = i + 1
  end
  return 0
end

## True if the `{` at the cursor is a struct-init literal for the receiver
## `node`: the receiver must be an ident or path, the receiver's name must begin
## with an uppercase letter (Quartz type/variant convention), and the `{` must
## be on the SAME source line as the receiver's end. This is the canonical
## `Type { field: val }` / `mod::Type { ... }` surface; it deliberately excludes
## `x { ... }` (lowercase) and a `{` that opens on a later line.
def cps_is_struct_init_here(p: CstParser, node: Int): Int
  var s = p.store
  var k = cst::cst_get_kind(s, node)
  if k != 15 and k != 16  # CST_IDENT / CST_PATH
    return 0
  end
  # `{` must be on the same line as the receiver's last token (struct literals are
  # written `Type {` on one line). Use p.prev_handle (the receiver tail token).
  if p.prev_handle == 0
    return 0
  end
  if cps_raw_line(p) != cst::cst_get_line(s, p.prev_handle)
    return 0
  end
  # The receiver's TAIL segment must be PascalCase (skip a leading `_`). The tail
  # token is the most-recently-consumed token before the `{`.
  var lex = cst::cst_get_str1(s, p.prev_handle)
  if str_byte_len(lex) == 0
    return 0
  end
  var idx = 0
  if lex.str_byte_at(0) == '_'
    idx = 1
  end
  if idx >= str_byte_len(lex)
    return 0
  end
  var b = lex.str_byte_at(idx)
  if b >= 'A' and b <= 'Z'
    return 1
  end
  return 0
end

## True if `node`'s kind can take a trailing `do ... end` block lambda — calls,
## method calls, plain idents, paths, field accesses (callable surfaces). Excludes
## literals/ranges/etc. so a `do` after e.g. a string literal is not misattached.
def cps_node_takes_trailing_block(p: CstParser, node: Int): Int
  var k = cst::cst_get_kind(p.store, node)
  if k == 21  # CST_CALL
    return 1
  end
  if k == 22  # CST_METHOD_CALL
    return 1
  end
  if k == 15  # CST_IDENT
    return 1
  end
  if k == 16  # CST_PATH
    return 1
  end
  if k == 23  # CST_FIELD_ACCESS
    return 1
  end
  return 0
end

## `try <expr>` (Result-propagation prefix) or `try <expr> catch <pat> <body>
## end` (block form). Captures the `try` keyword + expression; if `catch`
## follows, captures the catch clause tokens + body + `end`.
def cps_parse_try(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # try
  var node = cst::cst_alloc(s, 41, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_TRY_EXPR
  cst::cst_push_child(s, node, kw)
  var e = cps_parse_expr(p)
  cst::cst_push_child(s, node, e)
  var last = e
  if cps_cur_type(p) == token_constants::TOK_CATCH
    cst::cst_set_kind(s, node, 74)  # CST_TRY_CATCH
    var ck = cps_advance_token(p)  # catch
    cst::cst_push_child(s, node, ck)
    # Catch pattern: `_` | Ident [`::`seg]* [`(` bindings `)`]  (mirrors parser.qz's
    # catch-pattern grammar). Parsed precisely so the handler that follows on the
    # SAME line (inline form) is not swallowed as pattern tokens.
    if cps_cur_type(p) == token_constants::TOK_UNDERSCORE
      var u = cps_advance_token(p)
      cst::cst_push_child(s, node, u)
    elsif cps_cur_type(p) != token_constants::TOK_END and cps_at_end(p) == 0
      var pn = cps_advance_token(p)  # pattern head (variant / binding name)
      cst::cst_push_child(s, node, pn)
      while cps_cur_type(p) == token_constants::TOK_DOUBLE_COLON
        var cc = cps_advance_token(p)
        cst::cst_push_child(s, node, cc)
        var seg = cps_advance_token(p)
        cst::cst_push_child(s, node, seg)
      end
      if cps_cur_type(p) == token_constants::TOK_LPAREN
        cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
      end
    end
    # Handler. parser.qz parses a single handler EXPRESSION then an OPTIONAL `end`.
    # Inline form (`try E catch Pat E`, no newline before the handler) → expression
    # handler + optional `end`. Block form (handler/body begins on a new line) →
    # statement block + required `end` (preserves the existing multi-stmt form).
    if cps_cur_type(p) != token_constants::TOK_END and cps_at_end(p) == 0 and cps_newline_before_cur(p) == 0
      var handler = cps_parse_expr(p)
      cst::cst_push_child(s, node, handler)
      last = handler
      if cps_cur_type(p) == token_constants::TOK_END
        var endkw = cps_advance_token(p)  # optional `end`
        cst::cst_push_child(s, node, endkw)
        last = endkw
      end
    else
      var body = cps_parse_block_until(p)
      cst::cst_push_child(s, node, body)
      var endkw = cps_expect(p, token_constants::TOK_END)
      cst::cst_push_child(s, node, endkw)
      last = endkw
    end
  end
  cps_span_from_to(p, node, kw, last)
  return node
end

## `reify { expr }` — effect-to-Result reifier (Operation Piezoelectric Effects,
## Milestone A). Legacy `ps_parse_reify` (parser.qz) parses the brace body as ONE
## `ps_parse_expr` and returns that inner expression DIRECTLY — there is no reify
## AST node; it is transparent at the AST level and exists in the CST only for
## losslessness. So we capture the `reify` keyword + `{` + a STRUCTURED expr child
## (via cps_parse_expr) + `}`. The braces/keyword tokens round-trip the source;
## cst_lower's CST_REIFY arm drops the wrapper and returns the lowered inner expr.
## Inner newlines (multi-line `reify {\n e\n }`) drain into the surrounding tokens'
## pending trivia automatically, so no explicit newline handling is needed here.
def cps_parse_reify(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # reify
  var node = cst::cst_alloc(s, 123, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_REIFY
  cst::cst_push_child(s, node, kw)
  var lb = cps_expect(p, token_constants::TOK_LBRACE)  # {
  cst::cst_push_child(s, node, lb)
  var e = cps_parse_expr(p)
  cst::cst_push_child(s, node, e)
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, node, rb)
  cps_span_from_to(p, node, kw, rb)
  return node
end

## Lookahead from `ident :` to decide whether this is a single typed-param arrow
## lambda `name: Type -> body`. Scans raw tokens, tracking paren/bracket/angle
## depth; returns 1 iff a top-level `->` is reached before a top-level `,`, `)`,
## `}`, `]`, `=>`, `=`, or a NEWLINE. (Distinguishes from a `key: val` map entry
## and a `name: Type = default` binding.)
def cps_scan_typed_arrow_lambda(p: CstParser): Int
  var i = p.pos
  # current ident
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  i = i + 1  # past ident
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_COLON
    return 0
  end
  i = i + 1  # past colon
  var pd = 0
  var bd = 0
  var ad = 0
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LPAREN
      pd = pd + 1
    elsif tt == token_constants::TOK_RPAREN
      if pd == 0
        return 0
      end
      pd = pd - 1
    elsif tt == token_constants::TOK_LBRACKET
      bd = bd + 1
    elsif tt == token_constants::TOK_RBRACKET
      if bd == 0
        return 0
      end
      bd = bd - 1
    elsif tt == token_constants::TOK_LT
      ad = ad + 1
    elsif tt == token_constants::TOK_GT
      if ad > 0
        ad = ad - 1
      end
    elsif pd == 0 and bd == 0 and ad == 0
      if tt == token_constants::TOK_ARROW
        return 1
      end
      # parser.qz's ps_is_arrow_lambda_start scans PAST top-level commas to find
      # the `->` (multi-param typed lambda `acc: Int, x: Int -> body`), so COMMA
      # is NOT a terminator here. Keep ASSIGN/FAT_ARROW/NEWLINE/RBRACE/EOF.
      if tt == token_constants::TOK_ASSIGN or tt == token_constants::TOK_FAT_ARROW or tt == token_constants::TOK_NEWLINE or tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_EOF
        return 0
      end
    end
    i = i + 1
  end
  return 0
end

## Lookahead from a `(` at the cursor: scans to its MATCHING `)` (paren-depth
## aware) and returns 1 iff the next significant token is `->` — i.e. the parens
## are an arrow-lambda parameter list (`(x: T, y) -> body`), not a grouping/tuple
## `(e)` / `(a, b)`. A tuple/group is never followed by `->`, so this cleanly
## disambiguates which paren forms to parse structurally vs keep as verbatim
## lambda params.
def cps_scan_paren_arrow(p: CstParser): Int
  var i = p.pos
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_LPAREN
    return 0
  end
  var depth = 0
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LPAREN
      depth = depth + 1
    elsif tt == token_constants::TOK_RPAREN
      depth = depth - 1
      if depth == 0
        var j = i + 1
        while j < p.count and cps_is_trivia_type(p.types[j]) == 1
          j = j + 1
        end
        if j < p.count and p.types[j] == token_constants::TOK_ARROW
          return 1
        end
        return 0
      end
    elsif tt == token_constants::TOK_EOF
      return 0
    end
    i = i + 1
  end
  return 0
end

## Parses postfix chains: calls `f(args)`, field access `r.field`, method calls
## `r.method(args)`, and indexing `r[idx]`.
def cps_parse_postfix(p: CstParser): Int
  var s = p.store
  var node = cps_parse_primary(p)
  while true
    var tt = cps_cur_type(p)
    # Same-line gate for newline-sensitive postfix ops. parser.qz only chains
    # `.`/`?.` across newlines; `[` and `(` do NOT cross a line (a `[`/`(` that
    # starts a new line is a fresh array/vec-destructure statement or a standalone
    # parenthesized expr, NOT a postfix index/call on the previous line). Since
    # cst_parser drains NEWLINEs as trivia, we recover that boundary explicitly.
    var same_line = 0
    if p.prev_handle != 0 and cps_raw_line(p) == cst::cst_get_line(s, p.prev_handle)
      same_line = 1
    end
    if tt == token_constants::TOK_LT and cps_is_turbofish(p) == 1
      # Generic call type-args `name<T, U>(...)`. Capture the balanced `<...>`
      # verbatim onto a wrapper, then the following `(` becomes the call.
      var tf = cst::cst_alloc(s, 105, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_TYPE_ARG_LIST
      cst::cst_push_child(s, tf, node)
      var lastta = cps_parse_type_args_verbatim(p, tf)
      cps_span_from_to(p, tf, node, lastta)
      node = tf
    elsif tt == token_constants::TOK_LT and cps_is_generic_struct_init(p, node) == 1
      # Generic struct-init `Type<Args> { fields }` (`GSPair<Int, String> { ... }`).
      # Wrap the receiver in a CST_TYPE_ARG_LIST carrying `<Args>` verbatim, then
      # wrap that in a CST_STRUCT_INIT carrying the balanced `{ fields }`. Matches
      # parser.qz's ast_struct_init_generic (PascalCase + type-args + `{`).
      var gtf = cst::cst_alloc(s, 105, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_TYPE_ARG_LIST
      cst::cst_push_child(s, gtf, node)
      var glastta = cps_parse_type_args_verbatim(p, gtf)
      cps_span_from_to(p, gtf, node, glastta)
      var gsi = cst::cst_alloc(s, 26, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_STRUCT_INIT
      cst::cst_push_child(s, gsi, gtf)
      var gflist = cps_parse_field_list(p)
      cst::cst_push_child(s, gsi, gflist)
      cps_span_from_to(p, gsi, node, gflist)
      node = gsi
    elsif tt == token_constants::TOK_LPAREN
      # call(args)
      var arglist = cps_parse_arg_list(p)
      var call = cst::cst_alloc(s, 21, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_CALL
      cst::cst_push_child(s, call, node)
      cst::cst_push_child(s, call, arglist)
      cps_span_from_to(p, call, node, arglist)
      node = call
    elsif tt == token_constants::TOK_DOT or tt == token_constants::TOK_QUESTION_DOT
      var dot = cps_advance_token(p)  # . or ?.
      var name = cps_advance_token(p)  # field/method name (ident or keyword-as-method)
      if cps_cur_type(p) == token_constants::TOK_LPAREN
        # method call
        var arglist = cps_parse_arg_list(p)
        var mc = cst::cst_alloc(s, 22, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_METHOD_CALL
        cst::cst_push_child(s, mc, node)
        cst::cst_push_child(s, mc, dot)
        cst::cst_push_child(s, mc, name)
        cst::cst_push_child(s, mc, arglist)
        cps_span_from_to(p, mc, node, arglist)
        node = mc
      else
        var fkind = 23  # CST_FIELD_ACCESS
        if tt == token_constants::TOK_QUESTION_DOT
          fkind = 24   # CST_SAFE_FIELD_ACCESS
        end
        var fa = cst::cst_alloc(s, fkind, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))
        cst::cst_push_child(s, fa, node)
        cst::cst_push_child(s, fa, dot)
        cst::cst_push_child(s, fa, name)
        cps_span_from_to(p, fa, node, name)
        node = fa
      end
    elsif tt == token_constants::TOK_DOUBLE_COLON
      # qualified path: a::b / Result::Ok / module::Type::method
      var colon = cps_advance_token(p)  # ::
      var seg = cps_advance_token(p)    # segment (ident / variant / keyword)
      var path = cst::cst_alloc(s, 16, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_PATH
      cst::cst_push_child(s, path, node)
      cst::cst_push_child(s, path, colon)
      cst::cst_push_child(s, path, seg)
      cps_span_from_to(p, path, node, seg)
      node = path
    elsif tt == token_constants::TOK_LBRACKET and same_line == 1
      # index / slice — parse the body STRUCTURALLY (v[i], v[a..b], v[..b],
      # v[a..], v[..]) so cst_lower can reproduce parser.qz's NODE_INDEX with the
      # range-slice sentinels. Lossless (every token is a leaf).
      var ix = cst::cst_alloc(s, 25, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_INDEX
      cst::cst_push_child(s, ix, node)
      var lb = cps_advance_token(p)  # [
      cst::cst_push_child(s, ix, lb)
      cps_parse_index_body(p, ix)
      var rb = cps_expect(p, token_constants::TOK_RBRACKET)  # ]
      cst::cst_push_child(s, ix, rb)
      cps_span_from_to(p, ix, node, rb)
      node = ix
    elsif tt == token_constants::TOK_LBRACE and cps_is_struct_init_here(p, node) == 1
      # Struct-init `Type { field: val, ... }`. Only when the `{` is on the same
      # line as a PascalCase ident/path receiver (the canonical struct-literal
      # surface) — avoids grabbing a brace block that belongs to a control form.
      var si = cst::cst_alloc(s, 26, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_STRUCT_INIT
      cst::cst_push_child(s, si, node)
      var flist = cps_parse_field_list(p)
      cst::cst_push_child(s, si, flist)
      cps_span_from_to(p, si, node, flist)
      node = si
    elsif tt == token_constants::TOK_LBRACE and cps_is_with_field_access(p, node) == 1
      # Binary DSL `value.with { field = expr, ... }` immutable update (STEP 5):
      # `.with` followed by a curly block is NOT a trailing-block lambda — it is a
      # comma-separated field-override list (`{ a = 1, b = 2 }`). The generic
      # trailing-curly-block-lambda branch below parses NEWLINE-separated statements
      # and chokes on the comma (QZ0101), so intercept here and parse the entries
      # tolerating commas. The shape (`{` token, CST_BLOCK body of CST_CONST_BINDING
      # entries, `}` token attached to the field-access node) matches what cst_lower
      # reads in cl_collect_with_entries. Mirrors legacy parser.qz:2933-2958.
      var wlb = cps_advance_token(p)  # {
      cst::cst_push_child(s, node, wlb)
      var wbody = cps_parse_with_entry_block(p)
      cst::cst_push_child(s, node, wbody)
      var wrb = cps_expect(p, token_constants::TOK_RBRACE)  # }
      cst::cst_push_child(s, node, wrb)
      cps_span_from_to(p, node, node, wrb)
    elsif tt == token_constants::TOK_LBRACE and p.suppress_trailing_block == 0 and cps_node_takes_trailing_block(p, node) == 1 and p.prev_handle != 0 and cps_raw_line(p) == cst::cst_get_line(s, p.prev_handle)
      # Trailing curly-brace block lambda `{ [params ->] body }` passed to the
      # call (`apply(21) { x -> x*2 }`, `items.any? { it == 2 }`). In trailing
      # position a `{` is ALWAYS a lambda body — set/map literals only appear in
      # primary position — matching parser.qz's ps_parse_do_end_block_if_present.
      # The `{` must be on the receiver's line (legacy keeps NEWLINE tokens, so it
      # only absorbs a same-line block). A headerless body is an implicit-`it`
      # lambda; M1.3c lowers explicit-header / implicit-`it` forms accordingly.
      # The struct-init branch above already claimed PascalCase `Type {` literals.
      var lb = cps_advance_token(p)  # {
      cst::cst_push_child(s, node, lb)
      cps_capture_do_header(p, node)   # optional `-> | x -> | x, y -> | x: T ->`
      var cbody = cps_parse_curly_block_body(p)
      cst::cst_push_child(s, node, cbody)
      var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
      cst::cst_push_child(s, node, rb)
      cps_span_from_to(p, node, node, rb)
    elsif tt == token_constants::TOK_DO and p.suppress_trailing_block == 0 and cps_node_takes_trailing_block(p, node) == 1
      # Trailing `do [-> | x ->] ... end` block lambda passed to the call
      # (`xs.each do x -> ... end`, `describe(name) do -> ... end`). Attach the
      # block tokens to the existing call node so the whole thing round-trips.
      var dokw = cps_advance_token(p)  # do
      cst::cst_push_child(s, node, dokw)
      cps_capture_do_header(p, node)
      var body = cps_parse_block_until(p)
      cst::cst_push_child(s, node, body)
      var endkw = cps_expect(p, token_constants::TOK_END)
      cst::cst_push_child(s, node, endkw)
      cps_span_from_to(p, node, node, endkw)
    elsif tt == token_constants::TOK_BANG
      # Postfix force-unwrap `expr!` — wrap as CST_UNARY (op preserved by token).
      var bang = cps_advance_token(p)
      var uw = cst::cst_alloc(s, 18, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_UNARY (postfix)
      cst::cst_push_child(s, uw, node)
      cst::cst_push_child(s, uw, bang)
      cps_span_from_to(p, uw, node, bang)
      node = uw
    elsif tt == token_constants::TOK_AS
      # Postfix typed cast `expr as Type` (parser.qz parses `as` in the postfix
      # chain). Wrap the receiver in a CST_CAST carrying `as` + the target type.
      var askw = cps_advance_token(p)  # as
      var cast = cst::cst_alloc(s, 125, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_CAST
      cst::cst_push_child(s, cast, node)
      cst::cst_push_child(s, cast, askw)
      var cty = cps_parse_type(p)  # target type
      cst::cst_push_child(s, cast, cty)
      cps_span_from_to(p, cast, node, cty)
      node = cast
    elsif tt == token_constants::TOK_DOLLAR and same_line == 1
      # UFCS call sugar `recv$func(args)` — capture `$`, name, and arg list.
      # SAME-LINE gate: parser.qz has NO postfix `$` operator — `recv$func` is
      # lexed as one mangled identifier, so a leading `$` token always starts a
      # fresh `$macro(...)` primary on the NEXT statement. Only glue `$` onto the
      # receiver when it shares the receiver's line; otherwise `break` so
      # `x = 5` ⏎ `$assert(...)` parses as two statements, not `5$assert(...)`.
      var dollar = cps_advance_token(p)  # $
      var fname = cps_advance_token(p)   # function name
      var mc = cst::cst_alloc(s, 22, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_METHOD_CALL
      cst::cst_push_child(s, mc, node)
      cst::cst_push_child(s, mc, dollar)
      cst::cst_push_child(s, mc, fname)
      var lastd = fname
      if cps_cur_type(p) == token_constants::TOK_LPAREN
        var arglist = cps_parse_arg_list(p)
        cst::cst_push_child(s, mc, arglist)
        lastd = arglist
      end
      cps_span_from_to(p, mc, node, lastd)
      node = mc
    else
      break
    end
  end
  return node
end

## Parses one call argument: a NAMED argument `name: value` (the keyword-argument
## surface, `f(x, depth: 5)`) or a plain positional expression. A named argument
## is `IDENT COLON <expr>` that is NOT a typed-arrow lambda (`x: T -> body`),
## mirroring parser.qz's `IDENT COLON && !is_arrow_lambda_start` gate. The named
## arg is wrapped in a CST_FIELD_INIT carrier (name + `:` + value — the same
## `name: value` shape) so the printer can render `name: value`; positional args
## pass through unchanged.
def cps_parse_call_arg(p: CstParser): Int
  var s = p.store
  if cps_cur_type(p) == token_constants::TOK_IDENT and cps_peek_next_significant_type(p) == token_constants::TOK_COLON and cps_scan_typed_arrow_lambda(p) == 0
    var node = cps_node(p, 28)  # CST_FIELD_INIT (`name: value`)
    var name = cps_advance_token(p)  # arg name
    cst::cst_push_child(s, node, name)
    var colon = cps_advance_token(p)  # :
    cst::cst_push_child(s, node, colon)
    var val = cps_parse_expr(p)
    cst::cst_push_child(s, node, val)
    cps_span_from_to(p, node, name, val)
    return node
  end
  return cps_parse_expr(p)
end

## Parses a parenthesized comma-separated argument list `(a, b, c[,])`,
## returning a CST_ARG_LIST node with the trailing-comma flag set per D4.
def cps_parse_arg_list(p: CstParser): Int
  var s = p.store
  var lp = cps_expect(p, token_constants::TOK_LPAREN)  # (
  var alist = cst::cst_alloc(s, 119, 0, 0, cst::cst_get_line(s, lp), cst::cst_get_col(s, lp))  # CST_ARG_LIST
  cst::cst_push_child(s, alist, lp)
  var trailing = 0
  if cps_cur_type(p) != token_constants::TOK_RPAREN
    while true
      var arg = cps_parse_call_arg(p)
      cst::cst_push_child(s, alist, arg)
      trailing = 0
      if cps_cur_type(p) == token_constants::TOK_COMMA
        var comma = cps_advance_token(p)
        cst::cst_push_child(s, alist, comma)
        trailing = 1
        if cps_cur_type(p) == token_constants::TOK_RPAREN
          break
        end
      else
        break
      end
    end
  end
  var rp = cps_expect(p, token_constants::TOK_RPAREN)  # )
  cst::cst_push_child(s, alist, rp)
  cst::cst_set_trailing_comma(s, alist, trailing)
  cps_span_from_to(p, alist, lp, rp)
  return alist
end

## Parses a struct-init body `{ name: val, ..., ...spread }` into a structured
## CST_FIELD_LIST (121) — the input side of cst_lower's struct-init arm. Children
## are `[`{`, field_init|spread, comma?, ...,`}`]`; the trailing-comma bit (D4) is
## set on the list node. Mirrors `cps_parse_arg_list`; NEWLINEs inside the body
## are trivia (drained at the chokepoint), so multi-line literals work for free.
## Every consumed token becomes a CST_TOKEN leaf, so the verbatim oracle still
## reproduces the source byte-for-byte. Replaces the prior `cps_capture_balanced`
## verbatim capture that left no structured field children to lower.
def cps_parse_field_list(p: CstParser): Int
  var s = p.store
  var lb = cps_expect(p, token_constants::TOK_LBRACE)  # {
  var flist = cst::cst_alloc(s, 121, cst::cst_get_byte_start(s, lb), cst::cst_get_byte_start(s, lb), cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_FIELD_LIST
  cst::cst_push_child(s, flist, lb)
  var trailing = 0
  if cps_cur_type(p) != token_constants::TOK_RBRACE
    while true
      var entry = cps_parse_field_init(p)
      cst::cst_push_child(s, flist, entry)
      trailing = 0
      if cps_cur_type(p) == token_constants::TOK_COMMA
        var comma = cps_advance_token(p)
        cst::cst_push_child(s, flist, comma)
        trailing = 1
        if cps_cur_type(p) == token_constants::TOK_RBRACE
          break
        end
      else
        break
      end
    end
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, flist, rb)
  cst::cst_set_trailing_comma(s, flist, trailing)
  cps_span_from_to(p, flist, lb, rb)
  return flist
end

## Parses one struct-init entry: a `...expr` update-spread (CST_STRUCT_SPREAD 27)
## or a `name: value` field (CST_FIELD_INIT 28). The field-name slot accepts
## reserved keywords (matching parser.qz's `with Async { await: h }` handler-map
## rule). The value is a full expression; CST_FIELD_INIT children are
## `[name_tok, colon_tok, value_node]` so cst_lower reads name = first token,
## value = sole structured child.
def cps_parse_field_init(p: CstParser): Int
  var s = p.store
  if cps_cur_type(p) == token_constants::TOK_DOTDOTDOT
    var dots = cps_advance_token(p)
    var sp = cst::cst_alloc(s, 27, cst::cst_get_byte_start(s, dots), cst::cst_get_byte_start(s, dots), cst::cst_get_line(s, dots), cst::cst_get_col(s, dots))  # CST_STRUCT_SPREAD
    cst::cst_push_child(s, sp, dots)
    var inner = cps_parse_expr(p)
    cst::cst_push_child(s, sp, inner)
    cps_span_from_to(p, sp, dots, inner)
    return sp
  end
  # Field-name slot accepts TOK_IDENT or a reserved keyword used as an identifier
  # (`with Async { await: h }` handler-map rule, parser.qz:2222-2233), AND `..`
  # (TOK_DOTDOT) — the rest marker of a struct-DESTRUCTURE pattern that shares the
  # `Type { … }` surface (`Point3D { x, .. } = e`). cst_lower's
  # cl_struct_destr_assign reads a CST_FIELD_INIT whose first token is `..` as the
  # rest sentinel. A non-ident, non-`..` token (e.g. an integer literal `42:`) is
  # misuse — record the legacy "Expected field name" diagnostic. We still capture
  # the token (lossless, advancing to avoid the PIEZO_AWAIT-class hang) so
  # downstream lowering keeps its shape; the recorded error fails the compile.
  var _fn_tt = cps_cur_type(p)
  if _fn_tt != token_constants::TOK_IDENT and cps_is_reserved_ident_token(_fn_tt) == 0 and _fn_tt != token_constants::TOK_DOTDOT
    cps_note_error_msg(p, "Expected field name")
  end
  var name = cps_advance_token(p)  # field name (ident / reserved-as-ident)
  var fi = cst::cst_alloc(s, 28, cst::cst_get_byte_start(s, name), cst::cst_get_byte_start(s, name), cst::cst_get_line(s, name), cst::cst_get_col(s, name))  # CST_FIELD_INIT
  cst::cst_push_child(s, fi, name)
  var last = name
  # `name: value` is the struct-init field. A bare `name` (no `:`) is the
  # field-shorthand of a struct-DESTRUCTURE pattern (`Point { x, y } = e`) that
  # shares this `Type { … }` surface — valid source, NOT an error. Keep it
  # structured (name-only field-init); cst_lower routes destructure patterns
  # elsewhere and ignores value-less entries here.
  if cps_cur_type(p) == token_constants::TOK_COLON
    var colon = cps_advance_token(p)
    cst::cst_push_child(s, fi, colon)
    var value = cps_parse_expr(p)
    cst::cst_push_child(s, fi, value)
    last = value
  end
  cps_span_from_to(p, fi, name, last)
  return fi
end

## Scans the raw token stream from the cursor (positioned AT the array's `[`) to
## decide whether the bracket group is NON-structural — a list/comprehension
## `[expr for x in …]` OR an array DESTRUCTURE pattern with a leading-`..` rest
## (`[head, ..tail]`, `[first, ..]`) — rather than a plain comma-separated
## literal. Returns, before the matching `]`: 2 iff a top-level (bracket-depth-1)
## `for` is seen (genuine comprehension — the caller STRUCTURES it into a
## CST_LIST_COMP via cps_parse_list_comp); 1 iff a `..` (TOK_DOTDOT) appears in
## element-START position (right after `[` or after a depth-1 comma) with no
## comprehension `for` — a bare-range array `[a..b]` the caller keeps as a
## balanced verbatim capture (lossless, no error) preserving the prior
## all-verbatim behavior; 0 otherwise (plain structural literal). An INFIX
## range `a..b` (DOTDOT not in element-start position) is a valid element expr
## and does NOT trigger fallback. Mirrors the non-consuming lookahead style of
## `cps_is_turbofish`. Nested `[…]`/`(…)`/`{…}` raise depth so an inner form does
## not fool the outer scan.
def cps_array_is_comprehension(p: CstParser): Int
  var i = p.pos
  # Skip leading trivia to the `[`.
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_LBRACKET
    return 0
  end
  i = i + 1
  var depth = 1
  var at_elem_start = 1  # next depth-1 significant token begins an element
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_EOF
      return 0
    elsif tt == token_constants::TOK_LBRACKET or tt == token_constants::TOK_LPAREN or tt == token_constants::TOK_LBRACE
      depth = depth + 1
      at_elem_start = 0
    elsif tt == token_constants::TOK_RBRACKET or tt == token_constants::TOK_RPAREN or tt == token_constants::TOK_RBRACE
      depth = depth - 1
      if depth <= 0
        return 0
      end
    elsif tt == token_constants::TOK_FOR and depth == 1
      return 2
    elsif tt == token_constants::TOK_DOTDOT and depth == 1 and at_elem_start == 1
      return 1
    elsif tt == token_constants::TOK_COMMA and depth == 1
      at_elem_start = 1
    elsif cps_is_trivia_type(tt) == 0
      at_elem_start = 0
    end
    i = i + 1
  end
  return 0
end

## Reads the interned lexeme at an arbitrary raw token index (for non-consuming
## lookahead). Returns "" out of range. Mirrors cps_raw_lexeme but at index `i`.
def cps_lexeme_at(p: CstParser, i: Int): String
  if i < 0 or i >= p.count
    return ""
  end
  return string_intern::intern_resolve_int(p.interner, p.lexemes[i])
end

## Classifies a `{ … }` brace group at the cursor (positioned AT the `{`) into one
## of: 0 = literal/comprehension (map or set — disambiguated structurally during
## parse); 1 = standalone curly-block / lambda. Mirrors parser.qz:1456-1492's
## `is_block` fingerprint, applied BEFORE the literal disambiguation (legacy runs
## the standalone-block check first): `{` immediately followed by `->`, `var`,
## `if`, `while`, `for`, `match`, `return`, `ident ->`, or `ident =`. PLUS the
## `{ it <non-header> }` implicit-it lambda (parser.qz:1686-1703): a leading `it`
## whose successor is NOT lambda-header punctuation (`->`/`,`/`:`) — those forms
## flow through the standalone/explicit-lambda path, while a bare `it` operand
## (`{ it * 2 }`) is an implicit-it lambda. Non-consuming raw lookahead.
def cps_brace_is_block(p: CstParser): Int
  var i = p.pos
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count or p.types[i] != token_constants::TOK_LBRACE
    return 0
  end
  i = i + 1
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    i = i + 1
  end
  if i >= p.count
    return 0
  end
  var t0 = p.types[i]
  if t0 == token_constants::TOK_ARROW or t0 == token_constants::TOK_VAR or t0 == token_constants::TOK_IF or t0 == token_constants::TOK_WHILE or t0 == token_constants::TOK_FOR or t0 == token_constants::TOK_MATCH or t0 == token_constants::TOK_RETURN
    return 1
  end
  if t0 == token_constants::TOK_IDENT
    # Successor (skipping trivia) decides ident-led forms.
    var j = i + 1
    while j < p.count and cps_is_trivia_type(p.types[j]) == 1
      j = j + 1
    end
    var t1 = 0 - 1
    if j < p.count
      t1 = p.types[j]
    end
    if t1 == token_constants::TOK_ARROW or t1 == token_constants::TOK_ASSIGN
      return 1
    end
    # Implicit-it lambda `{ it <op> … }`: leading `it` not used as a lambda
    # header (`->`/`,`/`:`). A `{ it: T -> }` / `{ it -> }` / `{ it, y -> }`
    # explicit header is a block too, so the only `it` that is NOT a block here
    # is one followed by `:` (map shorthand `{ it: 1 }`) — but `it:` is map, and
    # any other successor (operator, `}`, etc.) makes it an implicit-it lambda.
    if str_eq(cps_lexeme_at(p, i), "it") == 1
      if t1 != token_constants::TOK_COLON
        return 1
      end
    end
  end
  return 0
end

## Parses a brace group `{ … }` in PRIMARY-expression position. Dispatches per
## legacy precedence (parser.qz:1456-1888): standalone curly-block / lambda first
## (CST_LAMBDA_BRACE 34), then the literal/comprehension family. Replaces the
## prior all-verbatim balanced capture so set/map literals and comprehensions
## lower structurally instead of leaking `__UNLOWERED_30`.
def cps_parse_brace_group(p: CstParser): Int
  if cps_brace_is_block(p) == 1
    return cps_parse_brace_lambda(p)
  end
  return cps_parse_collection_literal(p)
end

## Parses a standalone curly-block / brace lambda `{ [header ->] <stmts> }` into a
## CST_LAMBDA_BRACE(34) carrying `{`, optional header tokens (via the shared
## cps_capture_do_header), a CST_BLOCK body, and `}`. This is the SAME shape the
## postfix trailing-block path attaches to a call (cst_parser.qz:1417-1423), so
## cst_lower lowers it via the existing cl_lower_do_header + cl_lower_block (curly
## form → implicit `it` when headerless). Mirrors parser.qz's
## ps_parse_standalone_curly_block + the `{ it … }` implicit-it lambda.
def cps_parse_brace_lambda(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 34)  # CST_LAMBDA_BRACE
  var lb = cps_expect(p, token_constants::TOK_LBRACE)  # {
  cst::cst_push_child(s, node, lb)
  cps_capture_do_header(p, node)  # optional `-> | x -> | x: T -> | x, y ->`
  var body = cps_parse_curly_block_body(p)
  cst::cst_push_child(s, node, body)
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, node, rb)
  cps_span_from_to(p, node, lb, rb)
  return node
end

## Parses a map / set literal or comprehension `{ … }` STRUCTURALLY, mirroring
## legacy parser.qz:1628-1888. Disambiguation (after the standalone-block check
## already ruled out lambdas):
##   - empty `{}`                         → CST_MAP_LIT(31), no entries
##   - `:sym =>` / `"str":` / `"str" =>`   → map (first entry forces is_map)
##   - `ident :` shorthand                 → map (key = string of ident)
##   - first expr then `=>`                → map; then `,`-list or `for` (map-comp)
##   - first expr then `for`               → set-comp (CST_SET_LIT 30 + for-clause)
##   - otherwise                           → set literal (CST_SET_LIT 30)
## Entries are kept as structured exprs; the `:`/`=>`/`,`/`for`/`in`/`step`/`if`
## tokens are preserved as leaves so the oracle round-trips and cst_lower reads
## the structured slots positionally. Map literals use CST_MAP_ENTRY(32) children
## (key-expr, `=>`/`:` tok, val-expr); map-comp uses CST_MAP_COMP(38); set-comp
## reuses CST_SET_LIT(30) but carries a `for` token (cst_lower discriminates).
def cps_parse_collection_literal(p: CstParser): Int
  var s = p.store
  var lb = cps_expect(p, token_constants::TOK_LBRACE)  # {
  # Empty `{}` → empty map literal (legacy parser.qz:1635-1638).
  if cps_cur_type(p) == token_constants::TOK_RBRACE
    var node = cst::cst_alloc(s, 31, 0, 0, cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_MAP_LIT
    cst::cst_push_child(s, node, lb)
    var rb0 = cps_advance_token(p)  # }
    cst::cst_push_child(s, node, rb0)
    cps_span_from_to(p, node, lb, rb0)
    return node
  end
  # Determine first-entry shape. `is_map` mirrors legacy; `first_key` is parsed
  # as a full expr (TOK_SYMBOL / TOK_STRING / ident / any expr all handled by
  # cps_parse_primary), with the shorthand `ident :` / `"str" :` keys converted
  # to a string-literal expr exactly as legacy does.
  var is_map = 0
  var first_key = 0
  var sep_tok = 0           # the `=>` / `:` separator token of the first entry
  var t0 = cps_cur_type(p)
  if t0 == token_constants::TOK_IDENT and cps_peek_next_significant_type(p) == token_constants::TOK_COLON
    # Shorthand `ident: val` → key is the ident's text as a string literal.
    is_map = 1
    var idtok = cps_advance_token(p)  # ident (kept as the key leaf)
    first_key = idtok
    sep_tok = cps_advance_token(p)    # :
  elsif t0 == token_constants::TOK_STRING and (cps_peek_next_significant_type(p) == token_constants::TOK_COLON or cps_peek_next_significant_type(p) == token_constants::TOK_FAT_ARROW)
    is_map = 1
    first_key = cps_parse_expr(p)     # string literal expr
    sep_tok = cps_advance_token(p)    # : or =>
  else
    first_key = cps_parse_expr(p)
    if cps_cur_type(p) == token_constants::TOK_FAT_ARROW
      is_map = 1
      sep_tok = cps_advance_token(p)  # =>
    end
  end
  if is_map == 1
    return cps_finish_map_literal(p, lb, first_key, sep_tok)
  end
  return cps_finish_set_literal(p, lb, first_key)
end

## Finishes a map literal / map comprehension after the first key + separator are
## consumed. `first_key` is the key expr (or, for `ident:` shorthand, the ident
## TOKEN leaf — cst_lower converts it to a string literal); `sep_tok` is the
## consumed `=>`/`:` separator (pushed for losslessness). Mirrors parser.qz:1733-1834.
def cps_finish_map_literal(p: CstParser, lb: Int, first_key: Int, sep_tok: Int): Int
  var s = p.store
  var first_val = cps_parse_expr(p)
  # Map comprehension `{ k => v for x in it [step e] [if c] }` (parser.qz:1738).
  if cps_cur_type(p) == token_constants::TOK_FOR
    var mc = cst::cst_alloc(s, 38, 0, 0, cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_MAP_COMP
    cst::cst_push_child(s, mc, lb)
    cst::cst_push_child(s, mc, first_key)
    cst::cst_push_child(s, mc, sep_tok)
    cst::cst_push_child(s, mc, first_val)
    cps_capture_comp_clause(p, mc)
    var rbm = cps_expect(p, token_constants::TOK_RBRACE)  # }
    cst::cst_push_child(s, mc, rbm)
    cps_span_from_to(p, mc, lb, rbm)
    return mc
  end
  # Regular map literal: a CST_MAP_LIT(31) of CST_MAP_ENTRY(32) children.
  var node = cst::cst_alloc(s, 31, 0, 0, cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_MAP_LIT
  cst::cst_push_child(s, node, lb)
  var e0 = cps_make_map_entry(p, first_key, sep_tok, first_val)
  cst::cst_push_child(s, node, e0)
  while cps_cur_type(p) == token_constants::TOK_COMMA
    var comma = cps_advance_token(p)  # ,
    cst::cst_push_child(s, node, comma)
    if cps_cur_type(p) == token_constants::TOK_RBRACE
      break
    end
    var ent = cps_parse_map_entry(p)
    cst::cst_push_child(s, node, ent)
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, node, rb)
  cps_span_from_to(p, node, lb, rb)
  return node
end

## Builds a CST_MAP_ENTRY(32) from an already-parsed key/sep/val triple.
def cps_make_map_entry(p: CstParser, key: Int, sep: Int, val: Int): Int
  var s = p.store
  var ent = cst::cst_alloc(s, 32, 0, 0, cst::cst_get_line(s, key), cst::cst_get_col(s, key))  # CST_MAP_ENTRY
  cst::cst_push_child(s, ent, key)
  cst::cst_push_child(s, ent, sep)
  cst::cst_push_child(s, ent, val)
  cps_span_from_to(p, ent, key, val)
  return ent
end

## Parses ONE subsequent map entry `key (=>|:) val` (parser.qz:1788-1829). The key
## is a symbol / string / `ident:` shorthand / expr; for shorthand the ident leaf
## is the key (cst_lower converts to a string literal), else the parsed key expr.
def cps_parse_map_entry(p: CstParser): Int
  var s = p.store
  var key = 0
  var sep = 0
  var t = cps_cur_type(p)
  if t == token_constants::TOK_IDENT and cps_peek_next_significant_type(p) == token_constants::TOK_COLON
    key = cps_advance_token(p)   # ident → string key
    sep = cps_advance_token(p)   # :
  elsif t == token_constants::TOK_STRING and (cps_peek_next_significant_type(p) == token_constants::TOK_COLON or cps_peek_next_significant_type(p) == token_constants::TOK_FAT_ARROW)
    key = cps_parse_expr(p)      # string literal expr
    sep = cps_advance_token(p)   # : or =>
  else
    key = cps_parse_expr(p)
    sep = cps_expect(p, token_constants::TOK_FAT_ARROW)  # =>
  end
  var val = cps_parse_expr(p)
  return cps_make_map_entry(p, key, sep, val)
end

## Finishes a set literal / set comprehension after the first element is parsed.
## Mirrors parser.qz:1836-1887. Set-comp reuses CST_SET_LIT(30) but carries the
## `for … in …` clause tokens; cst_lower discriminates by a present `for` token.
def cps_finish_set_literal(p: CstParser, lb: Int, first_elem: Int): Int
  var s = p.store
  # Set comprehension `{ expr for x in it [step e] [if c] }` (parser.qz:1837).
  if cps_cur_type(p) == token_constants::TOK_FOR
    var sc = cst::cst_alloc(s, 30, 0, 0, cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_SET_LIT (comprehension carrier)
    cst::cst_push_child(s, sc, lb)
    cst::cst_push_child(s, sc, first_elem)
    cps_capture_comp_clause(p, sc)
    var rbc = cps_expect(p, token_constants::TOK_RBRACE)  # }
    cst::cst_push_child(s, sc, rbc)
    cps_span_from_to(p, sc, lb, rbc)
    return sc
  end
  var node = cst::cst_alloc(s, 30, 0, 0, cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_SET_LIT
  cst::cst_push_child(s, node, lb)
  cst::cst_push_child(s, node, first_elem)
  while cps_cur_type(p) == token_constants::TOK_COMMA
    var comma = cps_advance_token(p)  # ,
    cst::cst_push_child(s, node, comma)
    if cps_cur_type(p) == token_constants::TOK_RBRACE
      break
    end
    var elem = cps_parse_expr(p)
    cst::cst_push_child(s, node, elem)
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, node, rb)
  cps_span_from_to(p, node, lb, rb)
  return node
end

## Captures a comprehension tail `for VAR in ITER [step EXPR] [if COND]` onto
## `parent`, pushing each token leaf + structured expr in source order (shared by
## set-comp and map-comp). Mirrors parser.qz:1739-1764 / 1837-1862. cst_lower
## reads VAR (ident after `for`), ITER (expr after `in`), and the optional
## `step`/`if` exprs discriminated by their preceding keyword token.
def cps_capture_comp_clause(p: CstParser, parent: Int): Void
  var s = p.store
  var forkw = cps_expect(p, token_constants::TOK_FOR)  # for
  cst::cst_push_child(s, parent, forkw)
  var varn = cps_advance_token(p)  # VAR ident
  cst::cst_push_child(s, parent, varn)
  var inkw = cps_expect(p, token_constants::TOK_IN)  # in
  cst::cst_push_child(s, parent, inkw)
  var iter = cps_parse_expr(p)
  cst::cst_push_child(s, parent, iter)
  if cps_cur_type(p) == token_constants::TOK_IDENT and str_eq(cps_raw_lexeme(p), "step") == 1
    var stepkw = cps_advance_token(p)
    cst::cst_push_child(s, parent, stepkw)
    var stepe = cps_parse_expr(p)
    cst::cst_push_child(s, parent, stepe)
  end
  if cps_cur_type(p) == token_constants::TOK_IF
    var ifkw = cps_advance_token(p)
    cst::cst_push_child(s, parent, ifkw)
    var cond = cps_parse_expr(p)
    cst::cst_push_child(s, parent, cond)
  end
end

## Parses an array / collection literal `[ a, b, c[,] ]` STRUCTURALLY into a
## CST_ARRAY_LIT (29) whose sole structured child is a CST_ELEM_LIST (120) of
## element nodes — each a full expression or a `...spread` (CST_STRUCT_SPREAD 27,
## shared with struct-init since the shape `[dots, inner]` is identical). The
## empty `[]` yields a CST_ELEM_LIST with no element children → cst_lower emits
## an empty NODE_ARRAY, matching legacy. Comprehension forms (`[expr for …]`)
## are NOT handled here — the primary-expr caller routes them to a balanced
## verbatim capture (lossless, no error) that lowers to an empty NODE_ARRAY just
## as the prior all-verbatim path did. Mirrors `cps_parse_arg_list`; NEWLINEs in
## the body are trivia, so multi-line literals work for free, and every consumed
## token becomes a CST_TOKEN leaf so the verbatim oracle round-trips byte-exact.
def cps_parse_array_lit(p: CstParser): Int
  var compkind = cps_array_is_comprehension(p)
  if compkind == 2  # genuine `[expr for x in xs …]` — structure it (CST_LIST_COMP 37).
    return cps_parse_list_comp(p)
  end
  if compkind == 1  # bare-range array `[a..b]` — keep verbatim (lossless, empty NODE_ARRAY).
    return cps_parse_balanced_group(p, 29, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
  end
  var s = p.store
  var arr = cps_node(p, 29)  # CST_ARRAY_LIT
  var lb = cps_expect(p, token_constants::TOK_LBRACKET)  # [
  var elist = cst::cst_alloc(s, 120, cst::cst_get_byte_start(s, lb), cst::cst_get_byte_start(s, lb), cst::cst_get_line(s, lb), cst::cst_get_col(s, lb))  # CST_ELEM_LIST
  cst::cst_push_child(s, elist, lb)
  var trailing = 0
  if cps_cur_type(p) != token_constants::TOK_RBRACKET
    while true
      var elem = cps_parse_array_elem(p)
      cst::cst_push_child(s, elist, elem)
      trailing = 0
      if cps_cur_type(p) == token_constants::TOK_COMMA
        var comma = cps_advance_token(p)
        cst::cst_push_child(s, elist, comma)
        trailing = 1
        if cps_cur_type(p) == token_constants::TOK_RBRACKET
          break
        end
      else
        break
      end
    end
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACKET)  # ]
  cst::cst_push_child(s, elist, rb)
  cst::cst_set_trailing_comma(s, elist, trailing)
  cps_span_from_to(p, elist, lb, rb)
  cst::cst_push_child(s, arr, elist)
  cps_span_from_to(p, arr, lb, rb)
  return arr
end

## Parses a list comprehension `[elem for VAR in ITER [step STEP] [if COND]]`
## STRUCTURALLY into a CST_LIST_COMP (37). Children, in source order:
##   `[`, elem-expr, `for`, VAR(ident tok), `in`, iterable-expr,
##   [`step`(ident tok), step-expr], [`if`, cond-expr], `]`.
## Every token is preserved as a CST_TOKEN leaf so the verbatim oracle round-trips
## byte-exact; cst_lower reads the structured children positionally (elem=0,
## iterable=1) and discriminates the optional step/cond exprs by the preceding
## `step`/`if` token. Mirrors legacy parser.qz:1562-1599 (single var, optional
## `step` then optional `if`, in that order). The caller has already confirmed a
## depth-1 `for` via cps_array_is_comprehension == 2.
def cps_parse_list_comp(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 37)  # CST_LIST_COMP
  var lb = cps_expect(p, token_constants::TOK_LBRACKET)  # [
  cst::cst_push_child(s, node, lb)
  var elem = cps_parse_expr(p)
  cst::cst_push_child(s, node, elem)
  var forkw = cps_expect(p, token_constants::TOK_FOR)  # for
  cst::cst_push_child(s, node, forkw)
  var varn = cps_advance_token(p)  # VAR ident
  cst::cst_push_child(s, node, varn)
  var inkw = cps_expect(p, token_constants::TOK_IN)  # in
  cst::cst_push_child(s, node, inkw)
  var iter = cps_parse_expr(p)
  cst::cst_push_child(s, node, iter)
  # Optional `step <expr>` (contextual keyword `step`).
  if cps_cur_type(p) == token_constants::TOK_IDENT and str_eq(cps_raw_lexeme(p), "step")
    var stepkw = cps_advance_token(p)
    cst::cst_push_child(s, node, stepkw)
    var stepe = cps_parse_expr(p)
    cst::cst_push_child(s, node, stepe)
  end
  # Optional `if <cond>` filter.
  if cps_cur_type(p) == token_constants::TOK_IF
    var ifkw = cps_advance_token(p)
    cst::cst_push_child(s, node, ifkw)
    var cond = cps_parse_expr(p)
    cst::cst_push_child(s, node, cond)
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACKET)  # ]
  cst::cst_push_child(s, node, rb)
  cps_span_from_to(p, node, lb, rb)
  return node
end

## Parses one array element: a `...expr` spread (CST_STRUCT_SPREAD 27, children
## `[dots_tok, inner_expr]` — cst_lower's array arm reads inner as the sole
## structured child and wraps it in NODE_SPREAD) or a plain full expression.
## Mirrors parser.qz's element loop (ast_spread on TOK_DOTDOTDOT, else
## ps_parse_expr).
def cps_parse_array_elem(p: CstParser): Int
  var s = p.store
  if cps_cur_type(p) == token_constants::TOK_DOTDOTDOT
    var dots = cps_advance_token(p)
    var sp = cst::cst_alloc(s, 27, cst::cst_get_byte_start(s, dots), cst::cst_get_byte_start(s, dots), cst::cst_get_line(s, dots), cst::cst_get_col(s, dots))  # CST_STRUCT_SPREAD
    cst::cst_push_child(s, sp, dots)
    var inner = cps_parse_expr(p)
    cst::cst_push_child(s, sp, inner)
    cps_span_from_to(p, sp, dots, inner)
    return sp
  end
  return cps_parse_expr(p)
end

## Parses the body of an index/slice `[…]` (the `[` already consumed; the caller
## consumes the `]`). Pushes ONE structured index-content child onto `ix`:
##   v[i]        → the index expr (a non-range expr, via cps_parse_or)
##   v[a..b]     → CST_RANGE [a, op, b]
##   v[a..]      → CST_RANGE [a, op]        (right absent → cst_lower fills -1)
##   v[..b]      → CST_RANGE [op, b]        (left absent  → cst_lower fills 0)
##   v[..]       → CST_RANGE [op]           (both absent  → 0 .. -1)
## Mirrors parser.qz:3145-3212 (uses the cps_parse_or precedence — NOT the full
## expr — so a top-level `..` is detected here, not swallowed by the range rule).
## Op disc: `..`→27 (CST_OP_RANGE_EXCL), `...`→29 (CST_OP_RANGE_DOTS).
def cps_parse_index_body(p: CstParser, ix: Int): Void
  var s = p.store
  var tt = cps_cur_type(p)
  # Leading-range slice: [..] / [..b] / [...b]
  if tt == token_constants::TOK_DOTDOT or tt == token_constants::TOK_DOTDOTDOT
    var rng = cst::cst_alloc(s, 20, 0, 0, cps_raw_line(p), cps_raw_col(p))  # CST_RANGE
    var disc = 27
    if tt == token_constants::TOK_DOTDOTDOT
      disc = 29
    end
    cst::cst_set_op(s, rng, disc)
    var op = cps_advance_token(p)  # .. / ...
    cst::cst_push_child(s, rng, op)
    var last = op
    if cps_cur_type(p) != token_constants::TOK_RBRACKET
      var endex = cps_parse_or(p)
      cst::cst_push_child(s, rng, endex)
      last = endex
    end
    cps_span_from_to(p, rng, op, last)
    cst::cst_push_child(s, ix, rng)
    return
  end
  # Start operand present (parse WITHOUT the range rule so `..` stays visible).
  var start = cps_parse_or(p)
  var ntt = cps_cur_type(p)
  if ntt == token_constants::TOK_DOTDOT or ntt == token_constants::TOK_DOTDOTDOT
    # [a..b] / [a..] / [a...b]
    var rng = cst::cst_alloc(s, 20, 0, 0, cst::cst_get_line(s, start), cst::cst_get_col(s, start))  # CST_RANGE
    var disc = 27
    if ntt == token_constants::TOK_DOTDOTDOT
      disc = 29
    end
    cst::cst_set_op(s, rng, disc)
    cst::cst_push_child(s, rng, start)
    var op = cps_advance_token(p)  # .. / ...
    cst::cst_push_child(s, rng, op)
    var last = op
    if cps_cur_type(p) != token_constants::TOK_RBRACKET
      var endex = cps_parse_or(p)
      cst::cst_push_child(s, rng, endex)
      last = endex
    end
    cps_span_from_to(p, rng, start, last)
    cst::cst_push_child(s, ix, rng)
    return
  end
  # Plain index [expr].
  cst::cst_push_child(s, ix, start)
end

## Parses a prefix unary op (`-x`, `not x`, `!x`).
def cps_parse_unary(p: CstParser): Int
  var s = p.store
  var tt = cps_cur_type(p)
  if tt == token_constants::TOK_MINUS or tt == token_constants::TOK_NOT or tt == token_constants::TOK_BANG
    var op = cps_advance_token(p)
    var operand = cps_parse_unary(p)
    var un = cst::cst_alloc(s, 18, 0, 0, cst::cst_get_line(s, op), cst::cst_get_col(s, op))  # CST_UNARY
    var opdisc = 14  # CST_OP_NOT
    if tt == token_constants::TOK_MINUS
      opdisc = 15    # CST_OP_NEG
    end
    cst::cst_set_op(s, un, opdisc)
    cst::cst_push_child(s, un, op)
    cst::cst_push_child(s, un, operand)
    cps_span_from_to(p, un, op, operand)
    return un
  end
  return cps_parse_postfix(p)
end

## Builds a CST_BINARY node wrapping `left OP right` with op discriminant.
def cps_make_binary(p: CstParser, left: Int, optok: Int, opdisc: Int, right: Int): Int
  var s = p.store
  var bin = cst::cst_alloc(s, 19, 0, 0, cst::cst_get_line(s, left), cst::cst_get_col(s, left))  # CST_BINARY
  cst::cst_set_op(s, bin, opdisc)
  cst::cst_push_child(s, bin, left)
  cst::cst_push_child(s, bin, optok)
  cst::cst_push_child(s, bin, right)
  cps_span_from_to(p, bin, left, right)
  return bin
end

## factor: * / %
def cps_parse_factor(p: CstParser): Int
  var node = cps_parse_unary(p)
  while true
    var tt = cps_cur_type(p)
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_STAR
      var op = cps_advance_token(p)
      var r = cps_parse_unary(p)
      node = cps_make_binary(p, node, op, 3, r)   # CST_OP_MUL
    elsif tt == token_constants::TOK_SLASH
      var op = cps_advance_token(p)
      var r = cps_parse_unary(p)
      node = cps_make_binary(p, node, op, 4, r)   # CST_OP_DIV
    elsif tt == token_constants::TOK_PERCENT
      var op = cps_advance_token(p)
      var r = cps_parse_unary(p)
      node = cps_make_binary(p, node, op, 5, r)   # CST_OP_MOD
    else
      break
    end
  end
  return node
end

## term: + -
## True iff a NEWLINE trivia token immediately precedes the current significant
## token (i.e. the current token leads a new line). Scans the raw trivia gap
## backward from the cursor to the previous significant token. Robust to
## multi-line tokens (triple-quoted strings): it asks "was there a newline
## between the two tokens", not "are their recorded line numbers equal" — so a
## trailing operator on the closing-`"""` line is NOT treated as leading.
def cps_newline_before_cur(p: CstParser): Int
  cps_sync(p)
  var i = p.pos - 1
  while i >= 0
    var tt = p.types[i]
    if tt == token_constants::TOK_NEWLINE
      return 1
    end
    if cps_is_trivia_type(tt) == 0
      return 0
    end
    i = i - 1
  end
  return 0
end

def cps_parse_term(p: CstParser): Int
  var node = cps_parse_factor(p)
  while true
    var tt = cps_cur_type(p)
    # `+`/`-` continue an expression only when NOT leading a new line. A `-`/`+`
    # that begins a fresh line starts a new statement (unary minus / negative-
    # literal pattern), matching parser.qz where the intervening NEWLINE token
    # blocks the infix operator. Trailing-operator continuation (`a +` ⏎ `b`) is
    # unaffected (the operator sits on the left operand's line, no newline before
    # it). Without this, a match arm body `return 1` ⏎ `-42 => …` mis-parses as
    # `return (1 - 42)`.
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_PLUS
      var op = cps_advance_token(p)
      var r = cps_parse_factor(p)
      node = cps_make_binary(p, node, op, 1, r)   # CST_OP_ADD
    elsif tt == token_constants::TOK_MINUS
      var op = cps_advance_token(p)
      var r = cps_parse_factor(p)
      node = cps_make_binary(p, node, op, 2, r)   # CST_OP_SUB
    else
      break
    end
  end
  return node
end

## shift: << >>
def cps_parse_shift(p: CstParser): Int
  var node = cps_parse_term(p)
  while true
    var tt = cps_cur_type(p)
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_LSHIFT
      var op = cps_advance_token(p)
      var r = cps_parse_term(p)
      node = cps_make_binary(p, node, op, 20, r)   # CST_OP_SHL
    elsif tt == token_constants::TOK_RSHIFT
      var op = cps_advance_token(p)
      var r = cps_parse_term(p)
      node = cps_make_binary(p, node, op, 21, r)   # CST_OP_SHR
    else
      break
    end
  end
  return node
end

## bitand: &
def cps_parse_bitand(p: CstParser): Int
  var node = cps_parse_shift(p)
  while cps_cur_type(p) == token_constants::TOK_AMP and cps_newline_before_cur(p) == 0
    var op = cps_advance_token(p)
    var r = cps_parse_shift(p)
    node = cps_make_binary(p, node, op, 16, r)     # CST_OP_BITAND
  end
  return node
end

## bitxor: ^
def cps_parse_bitxor(p: CstParser): Int
  var node = cps_parse_bitand(p)
  while cps_cur_type(p) == token_constants::TOK_CARET and cps_newline_before_cur(p) == 0
    var op = cps_advance_token(p)
    var r = cps_parse_bitand(p)
    node = cps_make_binary(p, node, op, 18, r)     # CST_OP_BITXOR
  end
  return node
end

## bitor: |   (pattern alternation `|` only appears inside match arms, parsed
## separately, so a top-level `|` between expressions is bitwise-or)
def cps_parse_bitor(p: CstParser): Int
  var node = cps_parse_bitxor(p)
  while cps_cur_type(p) == token_constants::TOK_PIPE and cps_newline_before_cur(p) == 0
    var op = cps_advance_token(p)
    var r = cps_parse_bitxor(p)
    node = cps_make_binary(p, node, op, 17, r)     # CST_OP_BITOR
  end
  return node
end

## comparison: < <= > >=
def cps_parse_comparison(p: CstParser): Int
  var node = cps_parse_bitor(p)
  while true
    var tt = cps_cur_type(p)
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_LT
      var op = cps_advance_token(p)
      var r = cps_parse_bitor(p)
      node = cps_make_binary(p, node, op, 8, r)   # CST_OP_LT
    elsif tt == token_constants::TOK_LE
      var op = cps_advance_token(p)
      var r = cps_parse_bitor(p)
      node = cps_make_binary(p, node, op, 9, r)   # CST_OP_LE
    elsif tt == token_constants::TOK_GT
      var op = cps_advance_token(p)
      var r = cps_parse_bitor(p)
      node = cps_make_binary(p, node, op, 10, r)  # CST_OP_GT
    elsif tt == token_constants::TOK_GE
      var op = cps_advance_token(p)
      var r = cps_parse_bitor(p)
      node = cps_make_binary(p, node, op, 11, r)  # CST_OP_GE
    else
      break
    end
  end
  return node
end

## equality: == != =~ !~ and the `is` variant test (`x is Variant[(binds)]`).
def cps_parse_equality(p: CstParser): Int
  var s = p.store
  var node = cps_parse_comparison(p)
  while true
    var tt = cps_cur_type(p)
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_IS
      var iskw = cps_advance_token(p)  # is
      var ise = cst::cst_alloc(s, 67, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_IS_EXPR
      cst::cst_push_child(s, ise, node)
      cst::cst_push_child(s, ise, iskw)
      var last = iskw
      # Variant name token.
      if cps_cur_type(p) == token_constants::TOK_IDENT
        var vn = cps_advance_token(p)
        cst::cst_push_child(s, ise, vn)
        last = vn
      end
      # Optional binding payload `(a, b)`.
      if cps_cur_type(p) == token_constants::TOK_LPAREN
        last = cps_capture_balanced(p, ise, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
      end
      cps_span_from_to(p, ise, node, last)
      node = ise
    elsif tt == token_constants::TOK_EQ
      var op = cps_advance_token(p)
      var r = cps_parse_comparison(p)
      node = cps_make_binary(p, node, op, 6, r)   # CST_OP_EQ
    elsif tt == token_constants::TOK_NE
      var op = cps_advance_token(p)
      var r = cps_parse_comparison(p)
      node = cps_make_binary(p, node, op, 7, r)   # CST_OP_NE
    elsif tt == token_constants::TOK_MATCH_OP or tt == token_constants::TOK_NOMATCH_OP or tt == token_constants::TOK_MATCH_CAPTURE
      var op = cps_advance_token(p)
      var r = cps_parse_comparison(p)
      node = cps_make_binary(p, node, op, 0, r)   # regex match ops (no dedicated CstOp; round-trips via token)
    else
      break
    end
  end
  return node
end

## and
def cps_parse_and(p: CstParser): Int
  var node = cps_parse_equality(p)
  while cps_cur_type(p) == token_constants::TOK_AND and cps_newline_before_cur(p) == 0
    var op = cps_advance_token(p)
    var r = cps_parse_equality(p)
    node = cps_make_binary(p, node, op, 12, r)    # CST_OP_AND
  end
  return node
end

## or
def cps_parse_or(p: CstParser): Int
  var node = cps_parse_and(p)
  while cps_cur_type(p) == token_constants::TOK_OR and cps_newline_before_cur(p) == 0
    var op = cps_advance_token(p)
    var r = cps_parse_and(p)
    node = cps_make_binary(p, node, op, 13, r)    # CST_OP_OR
  end
  return node
end

## pipe / nil-coalesce / range — the lowest-precedence tail of the chain.
##   x |> f   pipeline
##   x ?? y   nil-coalesce
##   a..b     exclusive range  (CST_RANGE, CST_OP_RANGE_EXCL)
##   a...b    inclusive range  (CST_RANGE, CST_OP_RANGE_DOTS)
def cps_parse_pipe(p: CstParser): Int
  var s = p.store
  var node = cps_parse_or(p)
  while true
    var tt = cps_cur_type(p)
    if cps_newline_before_cur(p) == 1
      break
    end
    if tt == token_constants::TOK_PIPE_GT
      var op = cps_advance_token(p)
      var r = cps_parse_or(p)
      node = cps_make_binary(p, node, op, 0, r)
    elsif tt == token_constants::TOK_QUESTION_QUESTION
      var op = cps_advance_token(p)
      var r = cps_parse_or(p)
      node = cps_make_binary(p, node, op, 0, r)
    else
      break
    end
  end
  # Range suffix (non-associative — at most one).
  var rtt = cps_cur_type(p)
  if rtt == token_constants::TOK_DOTDOT or rtt == token_constants::TOK_DOTDOTDOT
    var rop = cps_advance_token(p)
    var rhs = cps_parse_or(p)
    var rng = cst::cst_alloc(s, 20, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_RANGE
    var disc = 27  # CST_OP_RANGE_EXCL
    if rtt == token_constants::TOK_DOTDOTDOT
      disc = 29    # CST_OP_RANGE_DOTS
    end
    cst::cst_set_op(s, rng, disc)
    cst::cst_push_child(s, rng, node)
    cst::cst_push_child(s, rng, rop)
    cst::cst_push_child(s, rng, rhs)
    cps_span_from_to(p, rng, node, rhs)
    node = rng
  end
  return node
end

## Top-level expression entry.
def cps_parse_expr(p: CstParser): Int = cps_parse_pipe(p)

# ===========================================================================
# Statement grammar (covered core)
# ===========================================================================

## True if `tt` is a compound-assignment operator token.
def cps_is_compound_assign(tt: Int): Int
  if tt == token_constants::TOK_PLUS_EQ
    return 1
  end
  if tt == token_constants::TOK_MINUS_EQ
    return 1
  end
  if tt == token_constants::TOK_STAR_EQ
    return 1
  end
  if tt == token_constants::TOK_SLASH_EQ
    return 1
  end
  if tt == token_constants::TOK_PERCENT_EQ
    return 1
  end
  if tt == token_constants::TOK_CARET_EQ
    return 1
  end
  if tt == token_constants::TOK_AMP_EQ
    return 1
  end
  if tt == token_constants::TOK_PIPE_EQ
    return 1
  end
  if tt == token_constants::TOK_SHL_EQ
    return 1
  end
  if tt == token_constants::TOK_SHR_EQ
    return 1
  end
  return 0
end

## Maps a compound-assign token type → CstOp discriminant.
def cps_compound_op_disc(tt: Int): Int
  if tt == token_constants::TOK_PLUS_EQ
    return 22  # CST_OP_ADD_ASSIGN
  end
  if tt == token_constants::TOK_MINUS_EQ
    return 23  # CST_OP_SUB_ASSIGN
  end
  if tt == token_constants::TOK_STAR_EQ
    return 24  # CST_OP_MUL_ASSIGN
  end
  if tt == token_constants::TOK_SLASH_EQ
    return 25  # CST_OP_DIV_ASSIGN
  end
  if tt == token_constants::TOK_PERCENT_EQ
    return 26  # CST_OP_MOD_ASSIGN
  end
  return 0     # bitwise compound ops: no dedicated CstOp; round-trips via token
end

## Classifies an assignment by its LHS kind: ident → const-binding, field-access
## → field-assign, index → index-assign, else plain assign. Shared by the stmt
## assignment path and the right-associative chained-rhs helper below.
def cps_assign_kind_for_lhs(s: cst::CstStorage, lhs: Int): Int
  var lk = cst::cst_get_kind(s, lhs)
  if lk == 15  # CST_IDENT → const-binding
    return 54
  end
  if lk == 23  # CST_FIELD_ACCESS → field assign
    return 52
  end
  if lk == 25  # CST_INDEX → index assign
    return 51
  end
  if lk == 101 and cps_decorator_is_bare_field(s, lhs) == 1
    # `@field = value` (implicit-self field shorthand) lowers like obj.field = v.
    return 52
  end
  return 49  # CST_ASSIGN
end

## True when `lhs` is a bare-field `@field` decorator (CST_DECORATOR with only
## `@`+name token children — no structured operand and not `@c(...)`), i.e. the
## implicit-self field-access form that lowers to `self.field` and is a valid
## assignment target.
def cps_decorator_is_bare_field(s: cst::CstStorage, lhs: Int): Int
  var n = cst::cst_child_count(s, lhs)
  var j = 0
  while j < n
    var c = cst::cst_get_child(s, lhs, j)
    if cst::cst_get_kind(s, c) != 1  # any STRUCTURED child → operand / inline-C
      return 0
    end
    j = j + 1
  end
  return 1
end

## Parses the right-hand side of an assignment with right-associative chaining
## (`v[0] = v[1] = 42` ≡ `v[0] = (v[1] = 42)`). Parses an expression; if another
## `=` follows, builds a nested assignment node with the parsed expr as its LHS.
def cps_parse_rhs_value(p: CstParser): Int
  var s = p.store
  var e = cps_parse_expr(p)
  if cps_cur_type(p) != token_constants::TOK_ASSIGN
    return e
  end
  var eq = cps_advance_token(p)  # =
  var rhs = cps_parse_rhs_value(p)  # right-assoc
  var node = cst::cst_alloc(s, cps_assign_kind_for_lhs(s, e), 0, 0, cst::cst_get_line(s, e), cst::cst_get_col(s, e))
  cst::cst_push_child(s, node, e)
  cst::cst_push_child(s, node, eq)
  cst::cst_push_child(s, node, rhs)
  cps_span_from_to(p, node, e, rhs)
  return node
end

## Parses one statement. Dispatches all statement-level surface forms; falls
## back to an expression statement / assignment for anything starting with an
## expression. Every path captures tokens losslessly.
def cps_parse_stmt(p: CstParser): Int
  var s = p.store
  var tt = cps_cur_type(p)

  if tt == token_constants::TOK_VAR
    return cps_parse_var_decl(p)
  end
  # `let x = 5` — the Rust/Swift binding keyword. Quartz has no `let`: bindings are
  # const-by-default (`x = 5`) or `var x = 5` for mutable. A statement-position
  # `let` never reaches `if let` (that's consumed inside cps_parse_if), so this
  # branch fires only on the mistake. Emit a targeted diagnostic and consume the
  # `let` losslessly as an expr-stmt carrier. Inert: no `let` binding in the
  # compiler's own source (const-by-default; `var` for mutable).
  if tt == token_constants::TOK_LET
    cps_note_error_msg(p, "Quartz has no 'let' — bindings are const-by-default: write `x = 5` (immutable) or `var x = 5` (mutable)")
    var letkw = cps_advance_token(p)
    var les = cst::cst_alloc(s, 44, 0, 0, cst::cst_get_line(s, letkw), cst::cst_get_col(s, letkw))  # CST_EXPR_STMT
    cst::cst_push_child(s, les, letkw)
    cps_span_from_to(p, les, letkw, letkw)
    return les
  end
  if tt == token_constants::TOK_RETURN
    return cps_parse_return(p)
  end
  if tt == token_constants::TOK_IF or tt == token_constants::TOK_UNLESS
    return cps_parse_if(p)
  end
  # Labeled loop: `:label while/for/loop … end`. A symbol at statement position
  # followed by a loop keyword names the loop (matches parser.qz's ps_parse_stmt
  # label dispatch). The label leaf is threaded in as the loop node's first child.
  if tt == token_constants::TOK_SYMBOL
    var nxt = cps_peek_next_significant_type(p)
    if nxt == token_constants::TOK_WHILE or nxt == token_constants::TOK_FOR or nxt == token_constants::TOK_LOOP
      var lbl = cps_advance_token(p)  # :label
      if nxt == token_constants::TOK_WHILE
        return cps_parse_while(p, lbl)
      end
      if nxt == token_constants::TOK_FOR
        return cps_parse_for(p, lbl)
      end
      return cps_parse_loop(p, lbl)
    end
  end
  if tt == token_constants::TOK_WHILE
    return cps_parse_while(p, 0)
  end
  if tt == token_constants::TOK_FOR
    return cps_parse_for(p, 0)
  end
  if tt == token_constants::TOK_LOOP
    return cps_parse_loop(p, 0)
  end
  if tt == token_constants::TOK_MATCH
    return cps_parse_match(p)
  end
  if tt == token_constants::TOK_BREAK
    return cps_parse_break_continue(p, 46)     # CST_BREAK
  end
  if tt == token_constants::TOK_CONTINUE
    return cps_parse_break_continue(p, 47)     # CST_CONTINUE
  end
  if tt == token_constants::TOK_YIELD
    return cps_parse_kw_optexpr(p, 48)         # CST_YIELD
  end
  if tt == token_constants::TOK_DEFER
    return cps_parse_defer(p)
  end
  if tt == token_constants::TOK_WITH
    # At STATEMENT position legacy parses the with-block as an expression and
    # wraps it in NODE_EXPR_STMT (ps_parse_assign_or_call, parser.qz:5773). Mirror
    # that by wrapping the CST_WITH_BLOCK in a CST_EXPR_STMT(44). The RHS/value
    # position (cps_parse_primary → cps_parse_with) returns the bare node, matching
    # legacy's ps_parse_expr value path.
    var wb = cps_parse_with(p)
    var wes = cst::cst_alloc(s, 44, 0, 0, cst::cst_get_line(s, wb), cst::cst_get_col(s, wb))  # CST_EXPR_STMT
    cst::cst_push_child(s, wes, wb)
    cps_span_from_to(p, wes, wb, wb)
    return wes
  end
  if tt == token_constants::TOK_SELECT
    return cps_parse_select(p)                  # CST_SELECT (structured case/default arms)
  end
  if tt == token_constants::TOK_TASK_GROUP
    return cps_parse_block_keyword(p, 73)      # CST_TASK_GROUP
  end
  if tt == token_constants::TOK_ARENA
    return cps_parse_arena(p)
  end
  if tt == token_constants::TOK_THROW or tt == token_constants::TOK_RESUME or tt == token_constants::TOK_ASYNC or tt == token_constants::TOK_GO or tt == token_constants::TOK_AWAIT
    # keyword-prefixed expression statement (throw e / resume e / go f() / async ... )
    return cps_parse_kw_optexpr(p, 44)         # CST_EXPR_STMT wrapper
  end

  # Expression statement OR assignment / compound-assignment. Parse the LHS as
  # an expression; classify by what follows.
  var lhs = cps_parse_expr(p)
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    var eq = cps_advance_token(p)  # =
    var rhs = cps_parse_rhs_value(p)  # right-assoc: supports `a = b = c`
    var node = cst::cst_alloc(s, cps_assign_kind_for_lhs(s, lhs), 0, 0, cst::cst_get_line(s, lhs), cst::cst_get_col(s, lhs))
    cst::cst_push_child(s, node, lhs)
    cst::cst_push_child(s, node, eq)
    cst::cst_push_child(s, node, rhs)
    cps_span_from_to(p, node, lhs, rhs)
    return cps_maybe_postfix_guard(p, node)
  end
  if cps_is_compound_assign(cps_cur_type(p)) == 1
    var optt = cps_cur_type(p)
    var op = cps_advance_token(p)  # OP=
    var rhs = cps_parse_expr(p)
    var node = cst::cst_alloc(s, 50, 0, 0, cst::cst_get_line(s, lhs), cst::cst_get_col(s, lhs))  # CST_COMPOUND_ASSIGN
    cst::cst_set_op(s, node, cps_compound_op_disc(optt))
    cst::cst_push_child(s, node, lhs)
    cst::cst_push_child(s, node, op)
    cst::cst_push_child(s, node, rhs)
    cps_span_from_to(p, node, lhs, rhs)
    return cps_maybe_postfix_guard(p, node)
  end
  # `name : Type = expr` const binding with explicit type annotation.
  if cst::cst_get_kind(s, lhs) == 15 and cps_cur_type(p) == token_constants::TOK_COLON
    var colon = cps_advance_token(p)
    var ty = cps_parse_type(p)
    var node = cst::cst_alloc(s, 54, 0, 0, cst::cst_get_line(s, lhs), cst::cst_get_col(s, lhs))  # CST_CONST_BINDING
    cst::cst_push_child(s, node, lhs)
    cst::cst_push_child(s, node, colon)
    cst::cst_push_child(s, node, ty)
    var last = ty
    if cps_cur_type(p) == token_constants::TOK_ASSIGN
      var eq = cps_advance_token(p)
      cst::cst_push_child(s, node, eq)
      var rhs = cps_parse_expr(p)
      cst::cst_push_child(s, node, rhs)
      last = rhs
    end
    cps_span_from_to(p, node, lhs, last)
    return node
  end

  var es = cst::cst_alloc(s, 44, 0, 0, cst::cst_get_line(s, lhs), cst::cst_get_col(s, lhs))  # CST_EXPR_STMT
  cst::cst_push_child(s, es, lhs)
  cps_span_from_to(p, es, lhs, lhs)
  return cps_maybe_postfix_guard(p, es)
end

## Wraps `node` with a trailing postfix guard `<stmt> (if|unless|while) cond` if
## an `if`/`unless`/`while` keyword follows on the SAME source line as the node's
## end (a postfix modifier, not a block opener). The guard keyword + condition
## expression become children of a CST_WHEN_GUARD wrapper preserving order.
def cps_maybe_postfix_guard(p: CstParser, node: Int): Int
  var s = p.store
  var tt = cps_cur_type(p)
  if tt != token_constants::TOK_IF and tt != token_constants::TOK_UNLESS and tt != token_constants::TOK_WHILE
    return node
  end
  # Must be on the same line as the statement (postfix modifier).
  if cps_raw_line(p) != cst::cst_get_line(s, node)
    return node
  end
  var guard = cst::cst_alloc(s, 66, 0, 0, cst::cst_get_line(s, node), cst::cst_get_col(s, node))  # CST_WHEN_GUARD
  cst::cst_push_child(s, guard, node)
  var gk = cps_advance_token(p)  # if / unless / while
  cst::cst_push_child(s, guard, gk)
  var cond = cps_parse_expr(p)
  cst::cst_push_child(s, guard, cond)
  cps_span_from_to(p, guard, node, cond)
  return guard
end

## `break`/`continue` with optional `:label` and (for break) optional value.
def cps_parse_break_continue(p: CstParser, kind: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)  # break / continue
  var node = cst::cst_alloc(s, kind, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))
  cst::cst_push_child(s, node, kw)
  var last = kw
  # Optional :label.
  if cps_cur_type(p) == token_constants::TOK_SYMBOL and cps_raw_line(p) == cst::cst_get_line(s, kw)
    var lbl = cps_advance_token(p)
    cst::cst_push_child(s, node, lbl)
    last = lbl
  end
  # Optional break value (same-line non-terminator).
  if kind == 46 and cps_value_follows_on_line(p, kw)
    var v = cps_parse_expr(p)
    cst::cst_push_child(s, node, v)
    last = v
  end
  cps_span_from_to(p, node, kw, last)
  return cps_maybe_postfix_guard(p, node)
end

## A keyword followed by an OPTIONAL same-line expression (yield/throw/resume/
## go/async). Wraps as `kind`.
def cps_parse_kw_optexpr(p: CstParser, kind: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)
  var node = cst::cst_alloc(s, kind, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))
  cst::cst_push_child(s, node, kw)
  var last = kw
  # `go do [-> | x ->] ... end` / `async do ... end` block form.
  if cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
    cps_capture_do_header(p, node)
    var body = cps_parse_block_until(p)
    cst::cst_push_child(s, node, body)
    var endkw = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, node, endkw)
    cps_span_from_to(p, node, kw, endkw)
    return node
  end
  if cps_value_follows_on_line(p, kw)
    var e = cps_parse_expr(p)
    cst::cst_push_child(s, node, e)
    last = e
  end
  cps_span_from_to(p, node, kw, last)
  return cps_maybe_postfix_guard(p, node)
end

## True if a same-line expression value follows `kw` (not a block terminator).
def cps_value_follows_on_line(p: CstParser, kw: Int): Int
  var s = p.store
  var nt = cps_cur_type(p)
  if nt == token_constants::TOK_END or nt == token_constants::TOK_EOF or nt == token_constants::TOK_ELSE or nt == token_constants::TOK_ELSIF
    return 0
  end
  # A trailing `if/unless/while` is a postfix guard (`break if cond`), not a
  # value — leave it for the guard wrapper applied by the caller.
  if nt == token_constants::TOK_IF or nt == token_constants::TOK_UNLESS or nt == token_constants::TOK_WHILE
    return 0
  end
  if cps_raw_line(p) == cst::cst_get_line(s, kw)
    return 1
  end
  return 0
end

## `defer <stmt>` or `defer do ... end`.
def cps_parse_defer(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # defer
  var node = cst::cst_alloc(s, 68, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_DEFER
  cst::cst_push_child(s, node, kw)
  var last = kw
  if cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
    var body = cps_parse_block_until(p)
    cst::cst_push_child(s, node, body)
    var endkw = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, node, endkw)
    last = endkw
  else
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, node, stmt)
    last = stmt
  end
  cps_span_from_to(p, node, kw, last)
  return node
end

## `arena name do ... end`.
def cps_parse_arena(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # arena
  var node = cst::cst_alloc(s, 117, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_ARENA_BLOCK
  cst::cst_push_child(s, node, kw)
  # arena name + `do`.
  while cps_cur_type(p) != token_constants::TOK_DO and cps_at_end(p) == 0
    var t = cps_advance_token(p)
    cst::cst_push_child(s, node, t)
  end
  if cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## `select [newline] (arm)* end` — the unified C.13 select block. Each arm is
## `case <binding|_> = <Selectable> => body` or `default => body`, where `case`
## and `default` are CONTEXTUAL keywords (lexed as TOK_IDENT). The arm body runs
## as a statement sequence until the next arm-start (`case`/`default`) or `end`.
## Mirrors parser.qz `ps_parse_select` / `ps_parse_select_arm` exactly.
def cps_parse_select(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # select
  var node = cst::cst_alloc(s, 71, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_SELECT
  cst::cst_push_child(s, node, kw)
  # Arms until `end`.
  while cps_cur_type(p) != token_constants::TOK_END and cps_at_end(p) == 0
    if cps_at_select_arm_start(p) == 0
      break
    end
    var before = p.pos
    var arm = cps_parse_select_arm(p)
    cst::cst_push_child(s, node, arm)
    if p.pos == before
      var stuck = cps_advance_token(p)
      cst::cst_push_child(s, node, stuck)
    end
  end
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## True if the cursor sits at a select arm start: the contextual keyword `case` or
## `default` (both lexed as TOK_IDENT).
def cps_at_select_arm_start(p: CstParser): Int
  if cps_cur_type(p) != token_constants::TOK_IDENT
    return 0
  end
  var lex = cps_raw_lexeme(p)
  if str_eq(lex, "case") or str_eq(lex, "default")
    return 1
  end
  return 0
end

## One select arm: `case <binding|_> = <Selectable> => body` or `default =>
## body`. Pattern binding is a bare name or `_`; the Selectable is a full
## expression; the body is captured as a CST_BLOCK statement run up to the next
## arm or `end`.
def cps_parse_select_arm(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 72)  # CST_SELECT_ARM
  var kw = cps_advance_token(p)  # `case` / `default` (contextual ident)
  cst::cst_push_child(s, node, kw)
  var last = kw
  var is_default = str_eq(cst::cst_get_str1(s, kw), "default")
  if is_default == 0
    # Binding pattern: `_` or a bare name.
    if cps_cur_type(p) == token_constants::TOK_UNDERSCORE or cps_cur_type(p) == token_constants::TOK_IDENT
      var bind = cps_advance_token(p)
      cst::cst_push_child(s, node, bind)
      last = bind
    end
    # `= <Selectable>`.
    if cps_cur_type(p) == token_constants::TOK_ASSIGN
      var eq = cps_advance_token(p)
      cst::cst_push_child(s, node, eq)
      var sel = cps_parse_expr(p)
      cst::cst_push_child(s, node, sel)
      last = sel
    end
  end
  # `=> body`.
  if cps_cur_type(p) == token_constants::TOK_FAT_ARROW
    var arrow = cps_advance_token(p)
    cst::cst_push_child(s, node, arrow)
    last = arrow
  end
  var body = cps_parse_select_arm_body(p)
  cst::cst_push_child(s, node, body)
  cps_span_from_to(p, node, kw, body)
  return node
end

## A select arm body: a statement sequence terminated by the next arm-start
## (`case`/`default`) or `end`/EOF. Returns a CST_BLOCK.
def cps_parse_select_arm_body(p: CstParser): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    if cps_at_select_arm_start(p) == 1
      break
    end
    var before = p.pos
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
    if p.pos == before
      break
    end
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## Generic `keyword <header tokens up to do/newline> [do] <body> end` block for
## select / task_group. Captures the header tokens, the body as statements, and
## the closing `end` losslessly.
def cps_parse_block_keyword(p: CstParser, kind: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)
  var node = cst::cst_alloc(s, kind, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))
  cst::cst_push_child(s, node, kw)
  # Header up to `do` / `{` / first newline boundary.
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_DO or tt == token_constants::TOK_LBRACE or tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    # Stop the header at a newline boundary (heuristic: header is on the kw line).
    if cps_raw_line(p) != cst::cst_get_line(s, kw)
      break
    end
    var t = cps_advance_token(p)
    cst::cst_push_child(s, node, t)
  end
  if cps_cur_type(p) == token_constants::TOK_LBRACE
    # Brace-delimited body — capture balanced.
    var last = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    cps_span_from_to(p, node, kw, last)
    return node
  end
  if cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## `with Handler[ { ... } ][, Handler2…] do [-> | x ->] ... end`.
##
## The handler expression(s) are parsed STRUCTURALLY via cps_parse_expr (mirroring
## parser.qz's ps_parse_handler_block, which uses ps_parse_expr) so cst_lower can
## reproduce the legacy NODE_WITH handler subtree exactly (bare ident, struct-init
## handler-map `Throws { throw: h }`, method-call `mutex.lock`, etc.). Each handler
## is a structured child; the comma-list sugar `with H1, H2 do … end` keeps every
## handler as a separate structured child (cst_lower rebuilds the nested chain).
##
## `suppress_trailing_block` is set while parsing the handler so the postfix parser
## does NOT steal the with-block's own `do … end` (or a handler-map `{ … }` on the
## next call) as a trailing lambda arg — exactly parser.qz's suppression. The do /
## optional do-header / body / end are captured as before (verbatim tokens + the
## CST_BLOCK body), so the do-header bound-param `do v ->` round-trips for cst_lower.
def cps_parse_with(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # with
  var node = cst::cst_alloc(s, 69, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_WITH_BLOCK
  cst::cst_push_child(s, node, kw)
  # Handler expression(s) — structured. Suppress trailing-block absorption so the
  # with-block's `do` (and any handler-map `{ … }` opened by a handler call) is not
  # claimed as a lambda arg to the handler expr.
  var _saved_sup = p.suppress_trailing_block
  p.suppress_trailing_block = 1
  var fh = cps_parse_expr(p)
  cst::cst_push_child(s, node, fh)
  # Comma-list of handlers: `with H1, H2, H3 do … end` (parser.qz P2.c). Each comma
  # token + following handler expr is pushed so the run round-trips and cst_lower
  # nests the chain (first handler outermost). Newlines between are trivia-drained.
  while cps_cur_type(p) == token_constants::TOK_COMMA
    var comma = cps_advance_token(p)  # ,
    cst::cst_push_child(s, node, comma)
    var nh = cps_parse_expr(p)
    cst::cst_push_child(s, node, nh)
  end
  p.suppress_trailing_block = _saved_sup
  if cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
    # Optional lambda header `-> ` or `x ->` after do.
    cps_capture_do_header(p, node)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## Captures an optional `do`-block lambda header: `->`, or `name [, name]* ->`.
## Pushes the consumed tokens as children of `parent`. Does nothing if no header.
def cps_capture_do_header(p: CstParser, parent: Int): Void
  var s = p.store
  var tt = cps_cur_type(p)
  if tt == token_constants::TOK_ARROW
    var ar = cps_advance_token(p)
    cst::cst_push_child(s, parent, ar)
    return
  end
  # A parameterized header `p1 [: T] [, p2 ...] ->`. Only consume if a top-level
  # `->` appears before any NEWLINE / `end` (a real lambda header). Detect via a
  # raw lookahead, then consume everything up to and including the `->`.
  if cps_scan_do_header_arrow(p) == 1
    while cps_cur_type(p) != token_constants::TOK_ARROW and cps_at_end(p) == 0
      var c = cps_cur_type(p)
      if c == token_constants::TOK_LPAREN
        cps_capture_balanced(p, parent, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
      elsif c == token_constants::TOK_LT
        cps_parse_type_args_verbatim(p, parent)
      else
        var t = cps_advance_token(p)
        cst::cst_push_child(s, parent, t)
      end
    end
    if cps_cur_type(p) == token_constants::TOK_ARROW
      var ar = cps_advance_token(p)
      cst::cst_push_child(s, parent, ar)
    end
  end
end

## Raw lookahead from the cursor: is there a top-level `->` on the current line
## before a NEWLINE / `end` / EOF? (Detects a `do <params> ->` lambda header.)
def cps_scan_do_header_arrow(p: CstParser): Int
  var i = p.pos
  while i < p.count and cps_is_trivia_type(p.types[i]) == 1
    # A newline before any `->` means no header.
    if p.types[i] == token_constants::TOK_NEWLINE
      return 0
    end
    i = i + 1
  end
  var depth = 0
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LPAREN or tt == token_constants::TOK_LBRACKET
      depth = depth + 1
    elsif tt == token_constants::TOK_RPAREN or tt == token_constants::TOK_RBRACKET
      depth = depth - 1
    elsif depth == 0
      if tt == token_constants::TOK_ARROW
        return 1
      end
      # A top-level `}` closes a trailing curly block `{ <body> }` before any
      # header `->` — so the block is headerless (implicit-`it`). `do…end` headers
      # never contain a top-level `}`, so this is harmless for the do-block path.
      if tt == token_constants::TOK_NEWLINE or tt == token_constants::TOK_END or tt == token_constants::TOK_EOF or tt == token_constants::TOK_RBRACE
        return 0
      end
    end
    i = i + 1
  end
  return 0
end

## var x [: T] = expr
def cps_parse_var_decl(p: CstParser): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_VAR)  # var
  var node = cst::cst_alloc(s, 53, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_VAR_DECL
  cst::cst_push_child(s, node, kw)
  # Binding target: a bare name, or a tuple `(a, b)` / vec `[a, b]` / struct
  # `Type { x, y }` destructuring pattern. Capture patterns balanced.
  var name = 0
  if cps_cur_type(p) == token_constants::TOK_LPAREN
    name = cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
  elsif cps_cur_type(p) == token_constants::TOK_LBRACKET
    name = cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
  elsif cps_cur_type(p) == token_constants::TOK_LBRACE
    # Anonymous struct destructure `var { x, y } = expr` (no leading type name).
    name = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
  else
    cps_check_binding_name(p, "var binding")  # QZ0530 reserved-keyword reject
    name = cps_advance_token(p)  # name (or Type for `var Type { ... } = e`)
    cst::cst_push_child(s, node, name)
    if cps_cur_type(p) == token_constants::TOK_LBRACE
      name = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    end
  end
  var last = name
  if cps_cur_type(p) == token_constants::TOK_COLON
    var colon = cps_advance_token(p)
    cst::cst_push_child(s, node, colon)
    var ty = cps_parse_type(p)
    cst::cst_push_child(s, node, ty)
    last = ty
  end
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var init = cps_parse_expr(p)
    cst::cst_push_child(s, node, init)
    last = init
  end
  cps_span_from_to(p, node, kw, last)
  return node
end

## A type reference in a signature — a (possibly qualified/applied) name. The
## core covers a simple ident or dotted/qualified name; everything is captured
## as verbatim token leaves so it round-trips even when not fully structured.
def cps_parse_type(p: CstParser): Int
  var s = p.store
  var n = cps_node(p, 103)  # CST_TYPE_REF
  var last = 0
  var head_lex = ""  # head type-name lexeme; gates the trailing `can` row to `Fn`
  var is_impl_head = 0  # set when an `impl` prefix was consumed; also gates the can row
  # Leading `&` / `&mut` borrow markers or a tuple/paren/fn-arg `(...)` head.
  if cps_cur_type(p) == token_constants::TOK_AMP
    var amp = cps_advance_token(p)
    cst::cst_push_child(s, n, amp)
    last = amp
  end
  # `impl Trait` / `dyn Trait` existential/trait-object prefix — consume the
  # `impl` keyword so the following trait name is parsed as the type head.
  while cps_cur_type(p) == token_constants::TOK_IMPL
    var implkw = cps_advance_token(p)
    cst::cst_push_child(s, n, implkw)
    last = implkw
    is_impl_head = 1
  end
  if cps_cur_type(p) == token_constants::TOK_LPAREN
    # Tuple type `(A, B)` or fn-type arg list `Fn(...)` head when name-less.
    last = cps_capture_balanced(p, n, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
  elsif cps_cur_type(p) == token_constants::TOK_LBRACE
    # Structural/anonymous record type `{ x: Int, y: String }`, the open-record
    # row form `{ x: Int | .. }`, and `&`/`|` intersection/union chains over
    # records (`{ x: Int } & { y: Int }`). Mirrors parser.qz:722-776's
    # ps_parse_type record branch. The brace group is captured balanced as token
    # leaves; cl_render_type_from_tokens rewrites the spacing to the legacy
    # canonical `{ field: T, field: T }`. The trailing `&`/`|` operator chain is
    # captured below (shared with non-record union/intersection heads).
    last = cps_capture_balanced(p, n, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    while cps_cur_type(p) == token_constants::TOK_AMP or cps_cur_type(p) == token_constants::TOK_PIPE
      var oper = cps_advance_token(p)
      cst::cst_push_child(s, n, oper)
      if cps_cur_type(p) == token_constants::TOK_LBRACE
        last = cps_capture_balanced(p, n, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
      else
        var rhsname = cps_advance_token(p)
        cst::cst_push_child(s, n, rhsname)
        last = rhsname
      end
    end
    cps_span_from_to(p, n, first_token_of(s, n), last)
    return n
  else
    # The type-name head MUST be an identifier (Self/Fn/primitives all lex as
    # TOK_IDENT). Legacy ps_parse_type (parser.qz:800) `ps_expect(TOK_IDENT,
    # "Expected type name")` here, so a non-ident head (e.g. the `[u8; 10]` array
    # syntax, which is only valid inside a `binary{}` block, or a stray operator)
    # is a parse error. Without this reject the bad token is silently consumed as
    # the type name and surfaces as a generic "CST parse error" downstream.
    if cps_cur_type(p) != token_constants::TOK_IDENT
      cps_note_error_msg(p, "Expected type name")
      cps_span_from_to(p, n, first_token_of(s, n), last)
      return n
    end
    var first = cps_advance_token(p)  # type name token (ident)
    cst::cst_push_child(s, n, first)
    last = first
    head_lex = cst::cst_get_str1(s, first)
  end
  # Trailing `::`-qualified segments, `<...>` type args, `(...)` fn-type params,
  # and a `: ReturnType` tail (function types `Fn(Int): Int`).
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_DOUBLE_COLON
      var c = cps_advance_token(p)
      cst::cst_push_child(s, n, c)
      var seg = cps_advance_token(p)
      cst::cst_push_child(s, n, seg)
      last = seg
    elsif tt == token_constants::TOK_LT
      last = cps_parse_type_args_verbatim(p, n)
    elsif tt == token_constants::TOK_LPAREN
      last = cps_capture_balanced(p, n, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_COLON and cps_type_colon_continues(p)
      var colon = cps_advance_token(p)
      cst::cst_push_child(s, n, colon)
      var ret = cps_parse_type(p)
      cst::cst_push_child(s, n, ret)
      last = ret
    elsif tt == token_constants::TOK_CAN and (str_eq(head_lex, "Fn") or is_impl_head == 1)
      # Trailing effect row on a FUNCTION type (`Fn(): Void can` / `Fn(): T can
      # Label`) OR on an `impl Trait` existential type (`impl AsyncIterator<Int>
      # can e` / `impl T can Async | e`). Legacy ps_parse_type folds the impl
      # `can` row into the type annotation itself (parser.qz:684-700), so we
      # mirror that here by capturing the row into the CST_TYPE_REF token run
      # where cl_render_type_from_tokens renders it in the SPACE form. Gated to
      # `Fn`/`impl` heads so a signature-level `can` row on a def return type
      # (`def f(): Int can A, B`) is left for the signature-clause handler
      # (cps_capture_sig_clauses), which owns comma-separated effect rows.
      var ck = cps_advance_token(p)  # can
      cst::cst_push_child(s, n, ck)
      last = ck
      var cline = cst::cst_get_line(s, ck)
      # Effect labels (ident / `::`-path) plus the `| tail` open-row pipe for the
      # impl case; NOT comma — a `,` after `can` in a param list (`(f: Fn(): T
      # can, x: Int)`) is a param separator, not a label separator. Multi-label
      # inline rows don't occur in the corpus.
      #
      # The label run is bounded to `can`'s own source line: a generator body's
      # first statement (`def gen(): impl Iterator<Int> can Async` then `side(10)`
      # on the next line) must NOT be absorbed as a row label. `cps_cur_type`
      # MUST be evaluated FIRST so it drains the trailing-newline trivia and
      # advances the cursor to the next SIGNIFICANT token before `cps_raw_line`
      # reads its line — otherwise `cps_raw_line` reads the un-synced newline
      # trivia (still on `can`'s line) and the guard wrongly admits the next
      # line's first token (the async-gen statement-drop bug).
      while (cps_cur_type(p) == token_constants::TOK_IDENT or cps_cur_type(p) == token_constants::TOK_DOUBLE_COLON or cps_cur_type(p) == token_constants::TOK_PIPE) and cps_raw_line(p) == cline
        var lt = cps_advance_token(p)
        cst::cst_push_child(s, n, lt)
        last = lt
      end
    else
      break
    end
  end
  # Trailing union `A | B` / intersection `A & B` operator chain (parser.qz:765-
  # 775, the post-base `while PIPE or AMP` in ps_parse_type). Applies to ANY type
  # head in a type position — return types (`def f(): Int | String`), aliases
  # (`type N = Int | Float`), and nested args. The `can` effect-row `|` is
  # consumed by the `can` block above (Fn/impl heads only), so a `|` reaching
  # here is always a union operator. Each operand is parsed as a nested type and
  # pushed as a structured child; cl_collect_type_tokens flattens it for render.
  while cps_cur_type(p) == token_constants::TOK_PIPE or cps_cur_type(p) == token_constants::TOK_AMP
    var uop = cps_advance_token(p)
    cst::cst_push_child(s, n, uop)
    var operand = cps_parse_type(p)
    cst::cst_push_child(s, n, operand)
    last = operand
  end
  cps_span_from_to(p, n, first_token_of(s, n), last)
  return n
end

## Returns the first child handle of `n` (used as the type node's span start).
def first_token_of(s: cst::CstStorage, n: Int): Int
  if cst::cst_child_count(s, n) > 0
    return cst::cst_get_child(s, n, 0)
  end
  return 0
end

## True if a `:` at the cursor continues a FUNCTION type (`Fn(Int): Ret`) rather
## than terminating the current type. Only treat `:` as a fn-return separator
## when the type so far ended with a `)` (a fn-arg list) on the same line.
def cps_type_colon_continues(p: CstParser): Int
  # Heuristic: only when the previously-consumed token was a `)` (fn arg list).
  if p.prev_handle == 0
    return 0
  end
  if cst::cst_get_kind(p.store, p.prev_handle) == 1
    var lex = cst::cst_get_str1(p.store, p.prev_handle)
    if str_eq(lex, ")")
      return 1
    end
  end
  return 0
end

## Captures a `<...>` type-argument run verbatim (balanced), pushing every
## token as a child of `parent`. Returns the handle of the last token consumed.
def cps_parse_type_args_verbatim(p: CstParser, parent: Int): Int
  var s = p.store
  var depth = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_EOF
      break
    end
    if tt == token_constants::TOK_LT
      depth = depth + 1
    end
    var tok = cps_advance_token(p)
    cst::cst_push_child(s, parent, tok)
    last = tok
    if tt == token_constants::TOK_GT
      depth = depth - 1
      if depth <= 0
        break
      end
    elsif tt == token_constants::TOK_RSHIFT
      # `>>` closes TWO nested generic levels (`Vec<Vec<Int>>`).
      depth = depth - 2
      if depth <= 0
        break
      end
    end
  end
  return last
end

## return [expr]
def cps_parse_return(p: CstParser): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_RETURN)
  var node = cst::cst_alloc(s, 45, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_RETURN
  cst::cst_push_child(s, node, kw)
  var last = kw
  # A return value is present iff the next significant token starts on the SAME
  # line as `return` (a bare `return` is followed by a newline → leading trivia
  # of the next token, so the next significant token is on a later line).
  if cps_return_has_value(p, kw)
    var expr = cps_parse_expr(p)
    cst::cst_push_child(s, node, expr)
    last = expr
  end
  cps_span_from_to(p, node, kw, last)
  return cps_maybe_postfix_guard(p, node)
end

## Heuristic for whether a `return` has a value: the next significant token is
## not a block terminator and shares no forced newline. We rely on the pending
## leading-trivia buffer: if draining to the next token produced a newline, the
## value is absent. We approximate by checking the next significant type is an
## expression starter and is on the same source line as the return keyword.
def cps_return_has_value(p: CstParser, kw: Int): Int
  var s = p.store
  var nt = cps_cur_type(p)
  if nt == token_constants::TOK_END or nt == token_constants::TOK_EOF or nt == token_constants::TOK_ELSE or nt == token_constants::TOK_ELSIF
    return 0
  end
  # A trailing `if/unless/while` is a postfix guard on a VALUELESS return
  # (`return if cond`), not a return value — leave it for the guard wrapper.
  if nt == token_constants::TOK_IF or nt == token_constants::TOK_UNLESS or nt == token_constants::TOK_WHILE
    return 0
  end
  # Same line as the return keyword?
  if cps_raw_line(p) == cst::cst_get_line(s, kw)
    return 1
  end
  return 0
end

## if cond ... [elsif cond ...] [else ...] end   (also handles `unless`)
def cps_parse_if(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # if / unless
  var node = cst::cst_alloc(s, 55, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_IF
  cst::cst_push_child(s, node, kw)
  # Optional `let` for `if let pat = e`.
  if cps_cur_type(p) == token_constants::TOK_LET
    var letkw = cps_advance_token(p)
    cst::cst_push_child(s, node, letkw)
  end
  var cond = cps_parse_expr(p)
  cst::cst_push_child(s, node, cond)
  # Refutable bind `if <pattern> = <expr>` (also `if let pat = e`, `if Some(v)=e`).
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var rhs = cps_parse_expr(p)
    cst::cst_push_child(s, node, rhs)
  end
  if cps_cur_type(p) == token_constants::TOK_THEN
    var th = cps_advance_token(p)
    cst::cst_push_child(s, node, th)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)

  while cps_cur_type(p) == token_constants::TOK_ELSIF
    var elsif_node = cps_parse_elsif(p)
    cst::cst_push_child(s, node, elsif_node)
  end
  if cps_cur_type(p) == token_constants::TOK_ELSE
    var else_node = cps_parse_else(p)
    cst::cst_push_child(s, node, else_node)
  end

  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## elsif cond ... (clause; no trailing `end`)
def cps_parse_elsif(p: CstParser): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_ELSIF)
  var node = cst::cst_alloc(s, 58, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_ELSIF_CLAUSE
  cst::cst_push_child(s, node, kw)
  if cps_cur_type(p) == token_constants::TOK_LET
    var letkw = cps_advance_token(p)
    cst::cst_push_child(s, node, letkw)
  end
  var cond = cps_parse_expr(p)
  cst::cst_push_child(s, node, cond)
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var rhs = cps_parse_expr(p)
    cst::cst_push_child(s, node, rhs)
  end
  if cps_cur_type(p) == token_constants::TOK_THEN
    var th = cps_advance_token(p)
    cst::cst_push_child(s, node, th)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  cps_span_from_to(p, node, kw, body)
  return node
end

## else ... (clause; no trailing `end`)
def cps_parse_else(p: CstParser): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_ELSE)
  var node = cst::cst_alloc(s, 59, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_ELSE_CLAUSE
  cst::cst_push_child(s, node, kw)
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  cps_span_from_to(p, node, kw, body)
  return node
end

## while cond ... end
def cps_parse_while(p: CstParser, label: Int): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_WHILE)
  var node = cst::cst_alloc(s, 60, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_WHILE
  var first = kw
  if label != 0
    cst::cst_push_child(s, node, label)  # `:label while …` (loop label leaf, source order)
    first = label
  end
  cst::cst_push_child(s, node, kw)
  if cps_cur_type(p) == token_constants::TOK_LET
    var letkw = cps_advance_token(p)
    cst::cst_push_child(s, node, letkw)
  end
  var cond = cps_parse_expr(p)
  cst::cst_push_child(s, node, cond)
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var rhs = cps_parse_expr(p)
    cst::cst_push_child(s, node, rhs)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, first, endkw)
  return node
end

## Parses a statement sequence until a block terminator (`end`/`elsif`/`else`/
## EOF), WITHOUT consuming the terminator. Returns a CST_BLOCK node.
## `quote do <stmts> end` — macro template body. Mirrors parser.qz
## ps_parse_quote_block: consume `quote`, `do`, parse statements as a block until
## `end`, then `end`. The body statements route through cps_parse_stmt so nested
## `unquote(...)` / `unquote_each(...)` parse structurally. Returns CST_QUOTE(126)
## with children: `quote` tok, `do` tok, CST_BLOCK body, `end` tok.
def cps_parse_quote(p: CstParser): Int
  var s = p.store
  var qk = cps_advance_token(p)  # quote
  var n = cst::cst_alloc(s, 126, 0, 0, cst::cst_get_line(s, qk), cst::cst_get_col(s, qk))  # CST_QUOTE
  cst::cst_push_child(s, n, qk)
  var dokw = cps_expect(p, token_constants::TOK_DO)
  cst::cst_push_child(s, n, dokw)
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, n, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, n, endkw)
  cps_span_from_to(p, n, qk, endkw)
  return n
end

def cps_parse_block_until(p: CstParser): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_ELSIF or tt == token_constants::TOK_ELSE or tt == token_constants::TOK_EOF
      break
    end
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## Body of a trailing curly-brace block lambda `{ [header ->] <stmts> }`: parse
## statements until the closing `}` (or EOF). Mirrors `cps_parse_block_until` but
## terminates on `TOK_RBRACE` instead of `end`/`elsif`/`else`. Returns CST_BLOCK.
def cps_parse_curly_block_body(p: CstParser): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_EOF
      break
    end
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## True (1) iff `node` is a CST_FIELD_ACCESS(23) whose field name is `with` — the
## receiver of a `value.with { ... }` binary-update postfix (Binary DSL STEP 5).
## The field name is the third child (recv, dot, name); read it via cst_get_str1.
def cps_is_with_field_access(p: CstParser, node: Int): Int
  var s = p.store
  return 0 if cst::cst_get_kind(s, node) != 23
  return 0 if cst::cst_child_count(s, node) < 3
  var name_h = cst::cst_get_child(s, node, 2)
  return 0 if cst::cst_get_str1(s, name_h).eq("with") == 0
  return 1
end

## Body of a `.with { field = expr, ... }` block: COMMA-and/or-newline-separated
## `ident = expr` override entries. Mirrors cps_parse_curly_block_body but consumes
## a `,` separator between entries (legacy parser.qz:2951 advances past TOK_COMMA).
## Each entry parses via cps_parse_stmt → CST_CONST_BINDING(54) (`name = e`), which
## cst_lower's cl_collect_with_entries reads as field=value pairs. Returns CST_BLOCK.
def cps_parse_with_entry_block(p: CstParser): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_EOF
      break
    end
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
    # Consume an optional `,` separator (entries may also be newline-separated,
    # which cps_parse_stmt already absorbs as trivia).
    if cps_cur_type(p) == token_constants::TOK_COMMA
      var comma = cps_advance_token(p)
      cst::cst_push_child(s, blk, comma)
    end
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## Parses an arrow-lambda BODY (shared by all arrow-lambda forms 1/2/3). When the
## body opens with `{`, legacy `ps_parse_arrow_lambda` (parser.qz:2596-2631)
## parses it as a BLOCK of statements — consume `{`, collect `ps_parse_stmt` until
## `}`, then `ast_block` + implicit-return — NOT as a set literal. We reproduce
## that: build a CST_BLOCK(43) whose children are the `{` token, the statement
## children, and the `}` token (the brace TOKENS live inside the block so the
## verbatim oracle still round-trips losslessly, and cl_lower_block skips them as
## tokens). cst_lower's cl_lower_arrow_lambda then lowers the CST_BLOCK via
## cl_lower_block and applies cl_apply_lambda_implicit_return. Else (a non-`{`
## body) parse a bare expression, exactly as before (no block, no implicit return).
## NOTE: only the lambda-body `{` is a block; expression-position `{ … }` literals
## (cps_parse_primary's TOK_LBRACE branch) remain verbatim CST_SET_LIT.
def cps_parse_lambda_body(p: CstParser): Int
  var s = p.store
  if cps_cur_type(p) != token_constants::TOK_LBRACE
    return cps_parse_expr(p)
  end
  var blk = cps_node(p, 43)  # CST_BLOCK
  var lb = cps_advance_token(p)  # {
  cst::cst_push_child(s, blk, lb)
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_EOF
      break
    end
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
  end
  var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
  cst::cst_push_child(s, blk, rb)
  cps_span_from_to(p, blk, lb, rb)
  return blk
end

# ===========================================================================
# Definitions (covered core: function defs — block + endless)
# ===========================================================================

## def name(params) [: RetType] ... end      (block form)   → CST_FUNCTION_BLOCK
## def name(params) [: RetType] = expr        (endless form) → CST_FUNCTION_ENDLESS
def cps_parse_function(p: CstParser): Int = cps_parse_function_x(p, 0)

## `cps_parse_function` with an explicit `allow_abstract` flag: when 1 (trait /
## protocol / effect member context) a signature with no `=` and no body is
## treated as an abstract method declaration; when 0 (top level, struct/impl/
## extend/actor) a signature always has a block or endless body. This prevents a
## concrete body that begins with `@field` / `private` from being misread as an
## abstract sig followed by a sibling.
def cps_parse_function_x(p: CstParser, allow_abstract: Int): Int
  var s = p.store
  var kw = cps_expect(p, token_constants::TOK_DEF)
  # Build the node first so we can push every header token (handles operator
  # method names, generics, clauses) as children losslessly.
  var node = cst::cst_alloc(s, 83, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_FUNCTION_BLOCK (may flip to ENDLESS)
  cst::cst_push_child(s, node, kw)
  # Function name (ident / operator-like token), possibly dotted (`Type.method`)
  # or `::`-qualified.
  var name = cps_advance_token(p)
  cst::cst_push_child(s, node, name)
  while cps_cur_type(p) == token_constants::TOK_DOT or cps_cur_type(p) == token_constants::TOK_DOUBLE_COLON
    var dot = cps_advance_token(p)
    cst::cst_push_child(s, node, dot)
    var seg = cps_advance_token(p)
    cst::cst_push_child(s, node, seg)
    name = seg
  end
  # Optional generic params `<T, U>`.
  if cps_cur_type(p) == token_constants::TOK_LT
    cps_parse_type_args_verbatim(p, node)
  end
  # Parameter list `(...)`.
  var params = cps_parse_param_list(p)
  cst::cst_push_child(s, node, params)
  # Optional `: ReturnType`. A `->` here is the Rust/Swift return-arrow mistake:
  # Quartz separates a return type with `:`, not `->` (a bare `->` would otherwise
  # be misparsed as a Void def whose body is an arrow-lambda, surfacing three tokens
  # later as a confusing "Undefined variable" on the return type). Emit a targeted
  # diagnostic on the `->` position and consume it losslessly so the following type
  # token doesn't cascade. Inert: no def in self-hosted/*.qz uses `-> T` returns.
  if cps_cur_type(p) == token_constants::TOK_ARROW
    cps_note_error_msg(p, "'->' is not a return-type separator in Quartz — use ':' for the return type (def foo(): Int)")
    var arrow = cps_advance_token(p)
    cst::cst_push_child(s, node, arrow)
    if cps_cur_type(p) != token_constants::TOK_COLON
      var ret_ty = cps_parse_type(p)
      cst::cst_push_child(s, node, ret_ty)
    end
  end
  # Optional `: ReturnType`.
  if cps_cur_type(p) == token_constants::TOK_COLON
    var colon = cps_advance_token(p)
    cst::cst_push_child(s, node, colon)
    var ret_ty = cps_parse_type(p)
    cst::cst_push_child(s, node, ret_ty)
  end
  # Optional `can <effect-row>` and `where <bounds>` clauses — capture their
  # tokens up to `=` (endless) or the body newline.
  cps_capture_sig_clauses(p, node)

  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    # Endless form: def f(...) [: T] = expr
    cst::cst_set_kind(s, node, 84)  # CST_FUNCTION_ENDLESS
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var body = cps_parse_expr(p)
    cst::cst_push_child(s, node, body)
    cps_span_from_to(p, node, kw, body)
    return node
  end

  # Abstract signature (trait method declaration, no body, no `=`): ONLY in a
  # trait/protocol/effect member context. The next significant token starts a
  # sibling member (`def`) or closes the enclosing block (`end`/EOF).
  if allow_abstract == 1
    var nt = cps_cur_type(p)
    # Disambiguate `end` by INDENTATION, mirroring parser.qz (in_trait_body): an
    # `end` whose column is LESS than this `def`'s column closes the enclosing
    # trait/effect/protocol block, so the current method is abstract (no body).
    # An `end` at-or-past the `def` column belongs to THIS def's body (an empty
    # default-method body) — fall through to the block-form path which consumes
    # it. Column comparison (not "peek the token after end") is the ground truth:
    # the token after the trait-closing `end` can be anything (a top-level `var`,
    # comment, etc.), which the old peek-heuristic misread as a concrete body and
    # then ran the block consumer to EOF.
    var abstract_here = 0
    if nt == token_constants::TOK_DEF or nt == token_constants::TOK_AT or nt == token_constants::TOK_EOF
      abstract_here = 1
    elsif nt == token_constants::TOK_END
      var def_col = cst::cst_get_col(s, kw)
      if cps_raw_col(p) < def_col
        abstract_here = 1
      end
    end
    if abstract_here == 1
      var hc = cst::cst_child_count(s, node)
      if hc > 0
        var lastchild = cst::cst_get_child(s, node, hc - 1)
        cps_span_from_to(p, node, kw, lastchild)
      else
        cps_span_from_to(p, node, kw, kw)
      end
      return node
    end
  end

  # Block form: def f(...) <body> end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## Captures optional signature clauses (`can ...`, `where ...`, `when <guard>`)
## after a function return type, up to `=` / `end` / body-start. Each token
## becomes a child leaf. The `when <expr>` form is the multi-clause pattern-def
## guard (`def classify(n: Int): String when n < 0 = "negative"`): its guard
## expression lives on the signature line and ends at the endless-`=`.
## Heuristic: clause tokens live on the signature line(s); we consume until we
## reach `=`, `end`, EOF, or a token starting a new statement on a fresh line
## that is not a clause keyword.
def cps_capture_sig_clauses(p: CstParser, node: Int): Void
  var s = p.store
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_WHEN
      # Multi-clause def guard (`def f(n) when n < 0 = ...`): structure the
      # `when` keyword + guard expression into a CST_WHEN_GUARD(66) child so
      # cl_lower_function can lower the guard and attach it via ast_func_set_guard
      # (mirrors the match-arm `if`-guard capture). Lossless: the `when` keyword
      # token is kept as the wrapper's first child; verbatim render walks it.
      var gnode = cst::cst_alloc(s, 66, 0, 0, cps_raw_line(p), cps_raw_col(p))  # CST_WHEN_GUARD
      var whenkw = cps_advance_token(p)
      cst::cst_push_child(s, gnode, whenkw)
      var gexpr = cps_parse_expr(p)
      cst::cst_push_child(s, gnode, gexpr)
      cps_span_from_to(p, gnode, whenkw, gexpr)
      cst::cst_push_child(s, node, gnode)
    elsif tt == token_constants::TOK_CAN or tt == token_constants::TOK_WHERE
      var ck = cps_advance_token(p)
      cst::cst_push_child(s, node, ck)
      var clause_line = cst::cst_get_line(s, ck)
      while true
        var ct = cps_cur_type(p)
        if ct == token_constants::TOK_ASSIGN or ct == token_constants::TOK_CAN or ct == token_constants::TOK_WHERE or ct == token_constants::TOK_WHEN or ct == token_constants::TOK_END or ct == token_constants::TOK_EOF
          break
        end
        # The clause lives on the signature line. Once the next significant token
        # moves to a new line, the body has begun — stop (do NOT eat statements).
        if cps_raw_line(p) != clause_line
          break
        end
        if ct == token_constants::TOK_LPAREN
          cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
        else
          var t = cps_advance_token(p)
          cst::cst_push_child(s, node, t)
        end
      end
    else
      break
    end
  end
end

## (param[, param]*[,])  parameter list → CST_PARAM_LIST (D4 trailing-comma)
def cps_parse_param_list(p: CstParser): Int
  var s = p.store
  var lp = cps_expect(p, token_constants::TOK_LPAREN)
  var plist = cst::cst_alloc(s, 87, 0, 0, cst::cst_get_line(s, lp), cst::cst_get_col(s, lp))  # CST_PARAM_LIST
  cst::cst_push_child(s, plist, lp)
  var trailing = 0
  if cps_cur_type(p) != token_constants::TOK_RPAREN
    while true
      var param = cps_parse_param(p)
      cst::cst_push_child(s, plist, param)
      trailing = 0
      if cps_cur_type(p) == token_constants::TOK_COMMA
        var comma = cps_advance_token(p)
        cst::cst_push_child(s, plist, comma)
        trailing = 1
        if cps_cur_type(p) == token_constants::TOK_RPAREN
          break
        end
      else
        break
      end
    end
  end
  var rp = cps_expect(p, token_constants::TOK_RPAREN)
  cst::cst_push_child(s, plist, rp)
  cst::cst_set_trailing_comma(s, plist, trailing)
  cps_span_from_to(p, plist, lp, rp)
  return plist
end

## One parameter → CST_PARAM. Captures every token up to a top-level `,` or `)`,
## descending into balanced groups so default values (`x: T = f(1, 2)`),
## generics (`m: Map<K, V>`), borrow markers (`&x`), `self`, and pattern params
## round-trip without leaking a delimiter to the param-list loop.
def cps_parse_param(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 86)  # CST_PARAM
  # QZ0530: a reserved keyword at the param-NAME position (`from: Int`,
  # `end: Int`) is rejected by legacy via ps_expect_binding_name (parser.qz:6540,
  # 6716). A reserved keyword followed by `:` is unambiguously a named param —
  # NOT a literal pattern param (`def f(true)` / `def f(0)`, which are never
  # followed by `:`). This precise guard mirrors the legacy reject without
  # mis-firing on pattern params. (PSQ-9: from/as; D3: end/if/match/etc.)
  if cps_is_reserved_ident_token(cps_cur_type(p)) == 1 and cps_peek_next_significant_type(p) == token_constants::TOK_COLON
    cps_check_binding_name(p, "function parameter")
  end
  var first = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_COMMA or tt == token_constants::TOK_RPAREN or tt == token_constants::TOK_EOF
      break
    end
    var h = 0
    if tt == token_constants::TOK_ASSIGN
      # Param default value `name: Type = <expr>`. A top-level `=` inside the
      # param loop (delimited by `,`/`)`) is unambiguously a default. Keep the
      # `=` token leaf for losslessness, then capture the default as a STRUCTURED
      # expr child so cst_lower can attach it via ast_param's default slot
      # (rather than the `= expr` tokens folding into the type string).
      var eq = cps_advance_token(p)
      cst::cst_push_child(s, node, eq)
      h = cps_parse_expr(p)
      cst::cst_push_child(s, node, h)
    elsif tt == token_constants::TOK_LPAREN
      h = cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LBRACKET
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    elsif tt == token_constants::TOK_LBRACE
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    elsif tt == token_constants::TOK_LT
      h = cps_parse_type_args_verbatim(p, node)
    else
      h = cps_advance_token(p)
      cst::cst_push_child(s, node, h)
    end
    if first == 0
      first = h
    end
  end
  if first != 0
    cps_span_from_to(p, node, first, first)
  end
  return node
end

# ===========================================================================
# Control-flow statements added in M1.3b: for-in, loop, match
# ===========================================================================

## `for <pattern> in <iter> [step e] [newline] <body> end`. The pattern can be a
## bare name, a destructuring `{...}` / `[...]` / `Type {...}`, or `await name`.
## We capture the header tokens (everything up to `in`), then the iterator
## expression, an optional `step` clause, the body, and `end`.
def cps_parse_for(p: CstParser, label: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)  # for
  var node = cst::cst_alloc(s, 62, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_FOR_IN
  var first = kw
  if label != 0
    cst::cst_push_child(s, node, label)  # `:label for …`
    first = label
  end
  cst::cst_push_child(s, node, kw)
  # QZ0530: the for-loop variable (`for match in …`) cannot be a reserved keyword
  # (parser.qz:4315 routes it through ps_expect_binding_name). `await` (the
  # `for await v in chan` async-iter form) is reserved but legal here — skip it.
  var for_first_tt = cps_cur_type(p)
  if for_first_tt != token_constants::TOK_AWAIT and cps_is_reserved_ident_token(for_first_tt) == 1
    cps_check_binding_name(p, "for-loop variable")
  end
  # Pattern run up to `in` (captures bare names, await, destructuring delimiters).
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_IN or tt == token_constants::TOK_EOF or tt == token_constants::TOK_END
      break
    end
    if tt == token_constants::TOK_LBRACE
      cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    elsif tt == token_constants::TOK_LBRACKET
      cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    else
      var t = cps_advance_token(p)
      cst::cst_push_child(s, node, t)
    end
  end
  if cps_cur_type(p) == token_constants::TOK_IN
    var inkw = cps_advance_token(p)
    cst::cst_push_child(s, node, inkw)
  end
  var iter = cps_parse_expr(p)
  cst::cst_push_child(s, node, iter)
  # Optional `step <expr>` (contextual keyword `step`).
  if cps_cur_type(p) == token_constants::TOK_IDENT and str_eq(cps_raw_lexeme(p), "step")
    var stepkw = cps_advance_token(p)
    cst::cst_push_child(s, node, stepkw)
    var stepe = cps_parse_expr(p)
    cst::cst_push_child(s, node, stepe)
  end
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, first, endkw)
  return node
end

## `[:label] loop ... end`.
def cps_parse_loop(p: CstParser, label: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)  # loop
  var node = cst::cst_alloc(s, 63, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_LOOP
  var first = kw
  if label != 0
    cst::cst_push_child(s, node, label)  # `:label loop`
    first = label
  end
  cst::cst_push_child(s, node, kw)
  var body = cps_parse_block_until(p)
  cst::cst_push_child(s, node, body)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, first, endkw)
  return node
end

## `match <expr> [newline] (arm)* end`. Each arm = `[when] pattern [| pattern]*
## [if guard] => body`, where body runs until the next arm or `end`.
def cps_parse_match(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # match
  var node = cst::cst_alloc(s, 64, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_MATCH
  cst::cst_push_child(s, node, kw)
  var subj = cps_parse_expr(p)
  cst::cst_push_child(s, node, subj)
  # Arms until `end`.
  while cps_cur_type(p) != token_constants::TOK_END and cps_at_end(p) == 0
    var before = p.pos
    var arm = cps_parse_match_arm(p)
    cst::cst_push_child(s, node, arm)
    # Progress guard.
    if p.pos == before
      var stuck = cps_advance_token(p)
      cst::cst_push_child(s, node, stuck)
    end
  end
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, kw, endkw)
  return node
end

## M1.3c-2 STAGE M-0: structures a SINGLE simple match-arm pattern into a
## CST_PAT_* node — wildcard `_` (75), literal int/float/string/bool/char/regex/
## symbol or `-N` (77), or a bare-ident binding (76). Returns the structured node
## handle, or 0 if the cursor is NOT a recognized simple pattern (the caller then
## falls back to the verbatim token-capture loop, preserving losslessness). Does
## NOT consume the `=>` — leaves the cursor on the token following the pattern so
## the caller can confirm a `=>` follows before committing to the structured form.
def cps_parse_pattern(p: CstParser): Int
  var s = p.store
  var tt = cps_cur_type(p)

  # Wildcard `_`.
  if tt == token_constants::TOK_UNDERSCORE
    var node = cps_node(p, 75)  # CST_PAT_WILDCARD
    var tok = cps_advance_token(p)
    cst::cst_push_child(s, node, tok)
    cps_span_from_to(p, node, tok, tok)
    return node
  end

  # Boolean literal pattern.
  if tt == token_constants::TOK_TRUE or tt == token_constants::TOK_FALSE
    var node = cps_node(p, 77)  # CST_PAT_LITERAL
    var tok = cps_advance_token(p)
    cst::cst_push_child(s, node, tok)
    cps_span_from_to(p, node, tok, tok)
    return node
  end

  # Int / float / string / char / regex / symbol literal pattern.
  if tt == token_constants::TOK_INT or tt == token_constants::TOK_FLOAT_LIT or tt == token_constants::TOK_STRING or tt == token_constants::TOK_CHAR or tt == token_constants::TOK_REGEX or tt == token_constants::TOK_SYMBOL
    var node = cps_node(p, 77)  # CST_PAT_LITERAL
    var tok = cps_advance_token(p)
    cst::cst_push_child(s, node, tok)
    cps_span_from_to(p, node, tok, tok)
    # Range pattern (M-3): an INT literal followed by `..`/`...` introduces a
    # range whose right side is itself a pattern. Mirrors parser.qz:5487-5496
    # (the range check lives only in the INT arm of ps_parse_pattern). The
    # left literal node, the range op token, and the recursively-parsed right
    # pattern become children of a CST_PAT_RANGE(82); cst_lower rebuilds the
    # `ast_binary(left, OP_RANGE|OP_RANGE_INCLUSIVE, right)` form.
    if tt == token_constants::TOK_INT
      var rtt = cps_cur_type(p)
      if rtt == token_constants::TOK_DOTDOT or rtt == token_constants::TOK_DOTDOTDOT
        var rng = cps_node(p, 82)  # CST_PAT_RANGE
        cst::cst_push_child(s, rng, node)
        var rop = cps_advance_token(p)
        cst::cst_push_child(s, rng, rop)
        var rhs = cps_parse_pattern(p)
        if rhs == 0
          return 0
        end
        cst::cst_push_child(s, rng, rhs)
        cps_span_from_to(p, rng, node, rhs)
        return rng
      end
    end
    return node
  end

  # Struct pattern (M-2) with NO type: a bare `{ f1, f2: alias, .. }`. Mirrors
  # parser.qz:ps_parse_pattern's bare-`{` arm → ast_struct_destructure with
  # type_name "". The `{`, field idents, `:`, aliases, `..`, commas, and `}` are
  # pushed as TOKEN leaves; cst_lower rebuilds field_specs + has_rest by walking
  # them (cps_parse_pattern_struct_body validates the legacy-acceptable shape and
  # returns 0 for anything ps_parse_struct_destr_fields would reject).
  if tt == token_constants::TOK_LBRACE
    var node = cps_node(p, 80)  # CST_PAT_STRUCT
    var lb = cps_advance_token(p)
    cst::cst_push_child(s, node, lb)
    var endt = cps_parse_pattern_struct_body(p, node)
    if endt == 0
      return 0
    end
    cps_span_from_to(p, node, lb, endt)
    return node
  end

  # Vec pattern (M-2): `[ a, b, ..rest ]`. Mirrors parser.qz:ps_parse_pattern's
  # `[` arm → ast_vec_destructure. The `[`, element idents, `..`, optional rest
  # ident, commas, and `]` are pushed as TOKEN leaves; cst_lower rebuilds
  # elem_names + rest_name + has_rest. cps_parse_pattern_vec_body returns 0 for a
  # shape ps_parse_vec_destr_elems would reject (a non-ident element).
  if tt == token_constants::TOK_LBRACKET
    var node = cps_node(p, 79)  # CST_PAT_TUPLE (reused for vec destructure)
    var lb = cps_advance_token(p)
    cst::cst_push_child(s, node, lb)
    var endt = cps_parse_pattern_vec_body(p, node)
    if endt == 0
      return 0
    end
    cps_span_from_to(p, node, lb, endt)
    return node
  end

  # Negative-int literal pattern `-N` (a `-` immediately followed by an int).
  if tt == token_constants::TOK_MINUS
    var nm = cps_peek_next_significant_type(p)
    if nm == token_constants::TOK_INT
      var node = cps_node(p, 77)  # CST_PAT_LITERAL
      var minus_tok = cps_advance_token(p)
      var int_tok = cps_advance_token(p)
      cst::cst_push_child(s, node, minus_tok)
      cst::cst_push_child(s, node, int_tok)
      cps_span_from_to(p, node, minus_tok, int_tok)
      return node
    end
    return 0
  end

  # Variant / enum pattern (M-1): an IDENT followed by `::` (qualified
  # `Enum::Variant`, `mod::Enum::Variant`) or by `(` directly (unqualified
  # `Variant(args)`). A following `{` is a struct pattern (M-2, left verbatim);
  # a following `<` is a generic form (left verbatim). Mirrors the enum-pattern
  # handling of parser.qz:ps_parse_pattern (the `::`-chain and the optional
  # `(...)` payload). Structured into a CST_PAT_VARIANT(78): the path tokens
  # (ident, `::`, ident, ...) are TOKEN leaves at the head; the payload `(`,
  # recursively-parsed sub-pattern nodes, commas, and `)` follow. If ANY sub-arg
  # cannot be structured (cps_parse_pattern returns 0), the whole variant is
  # abandoned (return 0) so the arm falls back to verbatim — we never emit a
  # half-structured payload.
  if tt == token_constants::TOK_IDENT
    var nx = cps_peek_next_significant_type(p)
    if nx == token_constants::TOK_DOUBLE_COLON or nx == token_constants::TOK_LPAREN
      var node = cps_node(p, 78)  # CST_PAT_VARIANT
      var idtok = cps_advance_token(p)
      cst::cst_push_child(s, node, idtok)
      var first = idtok
      var last = idtok
      # `::`-chain: consume `:: IDENT` pairs as path tokens.
      while cps_cur_type(p) == token_constants::TOK_DOUBLE_COLON
        var coltok = cps_advance_token(p)
        cst::cst_push_child(s, node, coltok)
        last = coltok
        if cps_cur_type(p) == token_constants::TOK_IDENT
          var segtok = cps_advance_token(p)
          cst::cst_push_child(s, node, segtok)
          last = segtok
        else
          # Malformed `::` with no following ident — abandon to verbatim.
          return 0
        end
      end
      # Optional payload `( sub-pattern, ... )`.
      if cps_cur_type(p) == token_constants::TOK_LPAREN
        var lp = cps_advance_token(p)
        cst::cst_push_child(s, node, lp)
        last = lp
        if cps_cur_type(p) != token_constants::TOK_RPAREN
          while true
            # QZ0530: a reserved keyword in a payload sub-pattern position is a
            # binding-name that legacy rejects (parser.qz:5427 routes match-arm
            # bindings through the reserved-ident guard). Note the error, then
            # structure it as a CST_PAT_BINDING so the arm + its `=> body` still
            # parse cleanly (avoids cascading the whole arm to verbatim).
            var sub_tt = cps_cur_type(p)
            if cps_is_reserved_ident_token(sub_tt) == 1
              cps_check_binding_name(p, "match pattern binding")
              var bnode = cps_node(p, 76)  # CST_PAT_BINDING
              var btok = cps_advance_token(p)
              cst::cst_push_child(s, bnode, btok)
              cps_span_from_to(p, bnode, btok, btok)
              cst::cst_push_child(s, node, bnode)
              last = bnode
              if cps_cur_type(p) == token_constants::TOK_COMMA
                var bcomma = cps_advance_token(p)
                cst::cst_push_child(s, node, bcomma)
                last = bcomma
                if cps_cur_type(p) == token_constants::TOK_RPAREN
                  break
                end
                continue
              else
                break
              end
            end
            var sub = cps_parse_pattern(p)
            if sub == 0
              # A sub-arg shape we cannot structure (e.g. nested struct `{}`):
              # abandon the whole variant → verbatim fallback.
              return 0
            end
            cst::cst_push_child(s, node, sub)
            last = sub
            if cps_cur_type(p) == token_constants::TOK_COMMA
              var comma = cps_advance_token(p)
              cst::cst_push_child(s, node, comma)
              last = comma
              if cps_cur_type(p) == token_constants::TOK_RPAREN
                break
              end
            else
              break
            end
          end
        end
        if cps_cur_type(p) != token_constants::TOK_RPAREN
          # Unbalanced payload — abandon to verbatim.
          return 0
        end
        var rp = cps_advance_token(p)
        cst::cst_push_child(s, node, rp)
        last = rp
      end
      cps_span_from_to(p, node, first, last)
      return node
    end
    # Typed struct pattern (M-2): `Type { f1, f2: alias, .. }`. The type ident is
    # the head TOKEN leaf, then the `{ … }` field tokens — same body shape as the
    # bare-`{` form. Mirrors parser.qz:ps_parse_pattern's `Type{` arm →
    # ast_struct_destructure with type_name = the leading ident.
    if nx == token_constants::TOK_LBRACE
      var snode = cps_node(p, 80)  # CST_PAT_STRUCT
      var idtok = cps_advance_token(p)
      cst::cst_push_child(s, snode, idtok)
      var lb = cps_advance_token(p)  # the `{`
      cst::cst_push_child(s, snode, lb)
      var endt = cps_parse_pattern_struct_body(p, snode)
      if endt == 0
        return 0
      end
      cps_span_from_to(p, snode, idtok, endt)
      return snode
    end
    if nx == token_constants::TOK_LT
      return 0
    end
    var node = cps_node(p, 76)  # CST_PAT_BINDING
    var tok = cps_advance_token(p)
    cst::cst_push_child(s, node, tok)
    cps_span_from_to(p, node, tok, tok)
    return node
  end

  return 0
end

## Consumes a struct-destructure field body `f1, f2: alias, .. }` (the `{` already
## consumed and pushed by the caller), pushing each token as a TOKEN leaf onto
## `node`. Returns the handle of the closing `}` token, or 0 if the body has a
## shape ps_parse_struct_destr_fields would reject (a field that is not a plain
## ident, a `:` not followed by an ident, etc.) so the arm falls back to verbatim.
## Mirrors parser.qz:ps_parse_struct_destr_fields field-by-field.
def cps_parse_pattern_struct_body(p: CstParser, node: Int): Int
  var s = p.store
  var first = 1
  while cps_cur_type(p) != token_constants::TOK_RBRACE
    if cps_cur_type(p) == token_constants::TOK_EOF
      return 0
    end
    if first == 0
      if cps_cur_type(p) != token_constants::TOK_COMMA
        return 0
      end
      var comma = cps_advance_token(p)
      cst::cst_push_child(s, node, comma)
    end
    first = 0
    # Rest pattern `..` — stops the field list (legacy breaks here).
    if cps_cur_type(p) == token_constants::TOK_DOTDOT
      var dt = cps_advance_token(p)
      cst::cst_push_child(s, node, dt)
      break
    end
    if cps_cur_type(p) != token_constants::TOK_IDENT
      return 0
    end
    var fld = cps_advance_token(p)
    cst::cst_push_child(s, node, fld)
    # Optional rename `: alias`.
    if cps_cur_type(p) == token_constants::TOK_COLON
      var col = cps_advance_token(p)
      cst::cst_push_child(s, node, col)
      if cps_cur_type(p) != token_constants::TOK_IDENT
        return 0
      end
      var al = cps_advance_token(p)
      cst::cst_push_child(s, node, al)
    end
  end
  if cps_cur_type(p) != token_constants::TOK_RBRACE
    return 0
  end
  var rb = cps_advance_token(p)
  cst::cst_push_child(s, node, rb)
  return rb
end

## Consumes a vec-destructure element body `a, b, ..rest ]` (the `[` already
## consumed and pushed by the caller), pushing each token as a TOKEN leaf onto
## `node`. Returns the handle of the closing `]` token, or 0 if a shape
## ps_parse_vec_destr_elems would reject (a non-ident element). Mirrors
## parser.qz:ps_parse_vec_destr_elems element-by-element.
def cps_parse_pattern_vec_body(p: CstParser, node: Int): Int
  var s = p.store
  var first = 1
  while cps_cur_type(p) != token_constants::TOK_RBRACKET
    if cps_cur_type(p) == token_constants::TOK_EOF
      return 0
    end
    if first == 0
      if cps_cur_type(p) != token_constants::TOK_COMMA
        return 0
      end
      var comma = cps_advance_token(p)
      cst::cst_push_child(s, node, comma)
    end
    first = 0
    # Rest pattern `..` with optional binding name — stops the element list.
    if cps_cur_type(p) == token_constants::TOK_DOTDOT
      var dt = cps_advance_token(p)
      cst::cst_push_child(s, node, dt)
      if cps_cur_type(p) == token_constants::TOK_IDENT
        var rn = cps_advance_token(p)
        cst::cst_push_child(s, node, rn)
      end
      break
    end
    if cps_cur_type(p) != token_constants::TOK_IDENT
      return 0
    end
    var el = cps_advance_token(p)
    cst::cst_push_child(s, node, el)
  end
  if cps_cur_type(p) != token_constants::TOK_RBRACKET
    return 0
  end
  var rb = cps_advance_token(p)
  cst::cst_push_child(s, node, rb)
  return rb
end

## One match arm: `[when] <pattern tokens up to => > => <body until next arm>`.
## Pattern + guard are captured as a token run (with balanced groups) up to the
## `=>`; the body is captured as statements until the next arm-start or `end`.
def cps_parse_match_arm(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 65)  # CST_MATCH_ARM
  var first = 0
  # Optional leading `when`.
  if cps_cur_type(p) == token_constants::TOK_WHEN
    var wk = cps_advance_token(p)
    cst::cst_push_child(s, node, wk)
    first = wk
  end
  # M-0: speculatively try to structure a SINGLE simple pattern (wildcard /
  # literal / `-N` / bare-ident binding) when it is the WHOLE pattern region
  # (immediately followed by `=>`, no or-pattern `|`, no `if` guard, no compound
  # shape). On success push the CST_PAT_* node and skip the verbatim loop; on any
  # mismatch restore the cursor and fall through to the lossless token capture.
  var spec_saved = p.pos
  var struct_ok = cps_try_structured_arm(p, node)
  if struct_ok == 1
    if first == 0
      first = cps_match_arm_first_handle(p, node)
    end
  else
    p.pos = spec_saved
    cps_parse_match_arm_pattern_verbatim(p, node, first)
  end
  if first == 0
    first = cps_match_arm_first_handle(p, node)
  end
  var last = first
  if cps_cur_type(p) == token_constants::TOK_FAT_ARROW
    var arrow = cps_advance_token(p)
    cst::cst_push_child(s, node, arrow)
    last = arrow
  end
  # Body: brace-block / do-block / statement run until next arm boundary or end.
  if cps_cur_type(p) == token_constants::TOK_LBRACE
    # M-4: structure the brace body `=> { stmts }` into a CST_BLOCK(43) of
    # statements bracketed by the `{`/`}` token leaves (mirrors legacy
    # parser.qz:4843-4856 → ast_block(stmts) ALWAYS). Speculative: if the
    # statement parse fails to make progress (a construct cps_parse_stmt can't
    # handle), restore the cursor and fall back to the verbatim balanced capture
    # so round-trip stays byte-lossless.
    var brace_saved = p.pos
    var brace_last = cps_parse_match_arm_brace_body(p, node)
    if brace_last == 0
      p.pos = brace_saved
      last = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    else
      last = brace_last
    end
  elsif cps_cur_type(p) == token_constants::TOK_DO
    var dokw = cps_advance_token(p)
    cst::cst_push_child(s, node, dokw)
    var body = cps_parse_block_until(p)
    cst::cst_push_child(s, node, body)
    var endkw = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, node, endkw)
    last = endkw
  else
    var body = cps_parse_match_arm_body(p)
    cst::cst_push_child(s, node, body)
    last = body
  end
  cps_span_from_to(p, node, first, last)
  return node
end

## M-3: speculatively structure a WHOLE match-arm pattern region — a single
## pattern, OR an or-pattern `p1 | p2 | ...`, OPTIONALLY followed by an `if`
## guard — committing the structured children onto `arm` only if the cursor
## lands on `=>` once the region is consumed. Returns 1 on commit, 0 on abandon
## (caller resets `p.pos` and falls to the verbatim loop). Mirrors the legacy
## ps_parse_match_arm or-pattern + guard handling (parser.qz:4785-4810).
##
## All structured handles are built into LOCAL slots first and pushed onto `arm`
## only after the `=>` confirmation, so an abandon leaves `arm` untouched and the
## verbatim fallback starts clean. The `|` and `if` keyword leaves are captured
## as children (under the CST_PAT_OR / CST_WHEN_GUARD wrappers) so the round-trip
## stays byte-lossless.
def cps_try_structured_arm(p: CstParser, arm: Int): Int
  var s = p.store
  var pat0 = cps_parse_pattern(p)
  if pat0 == 0
    return 0
  end
  # Or-pattern: collect `| <pattern>` alternatives into a CST_PAT_OR(81). The
  # pipe token leaves are interleaved so the rendered source is preserved.
  var pat_child = pat0
  if cps_cur_type(p) == token_constants::TOK_PIPE
    var ornode = cps_node(p, 81)  # CST_PAT_OR
    cst::cst_push_child(s, ornode, pat0)
    var last_alt = pat0
    while cps_cur_type(p) == token_constants::TOK_PIPE
      var pipetok = cps_advance_token(p)
      cst::cst_push_child(s, ornode, pipetok)
      var alt = cps_parse_pattern(p)
      if alt == 0
        return 0
      end
      cst::cst_push_child(s, ornode, alt)
      last_alt = alt
    end
    cps_span_from_to(p, ornode, pat0, last_alt)
    pat_child = ornode
  end
  # Optional `if` guard: structure the keyword + guard expression into a
  # CST_WHEN_GUARD(66). The guard expr uses the normal expression entry.
  var guard_child = 0
  if cps_cur_type(p) == token_constants::TOK_IF
    var gnode = cps_node(p, 66)  # CST_WHEN_GUARD (reused as match-arm guard)
    var ifkw = cps_advance_token(p)
    cst::cst_push_child(s, gnode, ifkw)
    var gexpr = cps_parse_expr(p)
    if gexpr == 0
      return 0
    end
    cst::cst_push_child(s, gnode, gexpr)
    cps_span_from_to(p, gnode, ifkw, gexpr)
    guard_child = gnode
  end
  # Commit only if the whole pattern region is followed by `=>`.
  if cps_cur_type(p) != token_constants::TOK_FAT_ARROW
    return 0
  end
  cst::cst_push_child(s, arm, pat_child)
  if guard_child != 0
    cst::cst_push_child(s, arm, guard_child)
  end
  return 1
end

## Returns the first structured-or-token child handle of an arm node (used to seed
## the span when the M-0 structured path produced the only pattern child).
def cps_match_arm_first_handle(p: CstParser, node: Int): Int
  var s = p.store
  if cst::cst_child_count(s, node) > 0
    return cst::cst_get_child(s, node, 0)
  end
  return 0
end

## The original verbatim pattern-capture loop (pre-M-0): captures pattern + guard
## tokens up to `=>` as token leaves / balanced groups onto `node`. Updates the
## caller's `first` via the return-by-side-effect on the arm's children — the
## caller re-derives `first` from the arm if it was 0.
def cps_parse_match_arm_pattern_verbatim(p: CstParser, node: Int, first: Int): Void
  var s = p.store
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_FAT_ARROW or tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    var h = 0
    if tt == token_constants::TOK_LPAREN
      h = cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LBRACE
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    elsif tt == token_constants::TOK_LBRACKET
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    else
      h = cps_advance_token(p)
      cst::cst_push_child(s, node, h)
    end
    if first == 0
      first = h
    end
  end
end

## M-4: structures the brace match-arm body `=> { stmts }`. Consumes the `{`,
## parses statements into a CST_BLOCK(43) until `}` (mirrors legacy
## parser.qz:4843-4856 and `cps_parse_curly_block_body`), then consumes `}`. The
## `{`, the CST_BLOCK, and `}` are pushed onto `arm` as children so round-trip
## stays byte-lossless. Returns the handle of the closing `}` token on success,
## or 0 if the run failed to make progress (the statement parser stalled before
## `}`) — in which case the caller resets `p.pos` and falls back to the verbatim
## balanced capture. NOTE: nothing is pushed onto `arm` until the closing `}` is
## confirmed, so a 0-return leaves `arm` untouched for a clean fallback.
def cps_parse_match_arm_brace_body(p: CstParser, arm: Int): Int
  var s = p.store
  var lb = cps_advance_token(p)  # consume `{` (local; pushed only on success)
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_EOF
      break
    end
    var before = p.pos
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
    if p.pos == before
      # Statement parser stalled (a construct it can't advance past) — signal a
      # fallback to verbatim capture.
      return 0
    end
  end
  # The body must close on a `}`; anything else (EOF) means the structured parse
  # cannot reproduce the source — fall back.
  if cps_cur_type(p) != token_constants::TOK_RBRACE
    return 0
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  var rb = cps_advance_token(p)  # consume `}`
  cst::cst_push_child(s, arm, lb)
  cst::cst_push_child(s, arm, blk)
  cst::cst_push_child(s, arm, rb)
  return rb
end

## Match-arm body for the bare (no brace/do) form: a sequence of statements that
## ends at the next arm boundary (`when`, or a pattern-start heuristic) or `end`.
def cps_parse_match_arm_body(p: CstParser): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  # Legacy ps_parse_match_arm ALWAYS parses the first body statement
  # unconditionally (a string/int/ident body looks like an arm-boundary token,
  # but it is the body, not the next arm) — only SUBSEQUENT statements consult
  # the arm-boundary heuristic. Mirror that: parse the first stmt, then loop.
  var ft = cps_cur_type(p)
  if ft != token_constants::TOK_END and ft != token_constants::TOK_EOF and ft != token_constants::TOK_WHEN
    var fbefore = p.pos
    var fstmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, fstmt)
    first = fstmt
    last = fstmt
    if p.pos == fbefore
      if first != 0
        cps_span_from_to(p, blk, first, last)
      end
      return blk
    end
  end
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF or tt == token_constants::TOK_WHEN
      break
    end
    if cps_at_arm_boundary(p) == 1
      break
    end
    var before = p.pos
    var stmt = cps_parse_stmt(p)
    cst::cst_push_child(s, blk, stmt)
    if first == 0
      first = stmt
    end
    last = stmt
    if p.pos == before
      break
    end
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## Heuristic arm-boundary detector mirroring parser.qz's: an arm starts at a
## wildcard / literal / `IDENT ::|=>|<|if|`|(` (PascalCase) / `when`. Used to
## terminate a bare-body statement run before the next arm.
def cps_at_arm_boundary(p: CstParser): Int
  var tt = cps_cur_type(p)
  if tt == token_constants::TOK_UNDERSCORE
    return 1
  end
  if tt == token_constants::TOK_INT or tt == token_constants::TOK_CHAR or tt == token_constants::TOK_STRING or tt == token_constants::TOK_REGEX or tt == token_constants::TOK_STRING_START
    return 1
  end
  if tt == token_constants::TOK_TRUE or tt == token_constants::TOK_FALSE
    return 1
  end
  if tt == token_constants::TOK_SYMBOL
    return 1
  end
  # Negative-literal pattern arm `-1 => …` / `-42 => …` (a `-` followed by a
  # numeric literal at statement-boundary position begins a new match arm).
  if tt == token_constants::TOK_MINUS
    var nm = cps_peek_next_significant_type(p)
    if nm == token_constants::TOK_INT or nm == token_constants::TOK_FLOAT_LIT
      return 1
    end
  end
  if tt == token_constants::TOK_IDENT
    var nx = cps_peek_next_significant_type(p)
    if nx == token_constants::TOK_DOUBLE_COLON or nx == token_constants::TOK_FAT_ARROW or nx == token_constants::TOK_LT or nx == token_constants::TOK_IF or nx == token_constants::TOK_PIPE
      return 1
    end
    if nx == token_constants::TOK_LPAREN
      var lex = cps_raw_lexeme(p)
      if str_byte_len(lex) > 0
        var b = lex.str_byte_at(0)
        if b >= 'A' and b <= 'Z'
          return 1
        end
      end
    end
  end
  return 0
end

## Peeks the type of the next SIGNIFICANT token after the current one without
## consuming (skips trivia). Restores the cursor afterward.
def cps_peek_next_significant_type(p: CstParser): Int
  cps_sync(p)
  var saved = p.pos
  # Advance past the current significant token.
  if p.pos < p.count
    p.pos = p.pos + 1
  end
  var t = cps_cur_type(p)
  p.pos = saved
  return t
end

## Scans the balanced `(...)` param run beginning at the current `(` (cursor must
## be on TOK_LPAREN) WITHOUT consuming any tokens. At paren-depth 1, a reserved
## keyword token immediately followed by `:` is a named param whose name is a
## reserved keyword — note the QZ0530 reject (mirroring ps_expect_binding_name).
## Used by the extern-fn path where params are captured as a balanced group
## rather than via cps_parse_param.
def cps_scan_paren_params_for_reserved(p: CstParser): Void
  cps_sync(p)
  var i = p.pos
  var depth = 0
  var started = 0
  while i < p.count
    var tt = p.types[i]
    if tt == token_constants::TOK_LPAREN
      depth = depth + 1
      started = 1
    elsif tt == token_constants::TOK_RPAREN
      depth = depth - 1
      if depth == 0 and started == 1
        i = p.count
      end
    elsif depth == 1 and cps_is_reserved_ident_token(tt) == 1
      # Look at the next significant token (skip trivia) for a `:`.
      var k = i + 1
      while k < p.count and cps_is_trivia_type(p.types[k]) == 1
        k = k + 1
      end
      if k < p.count and p.types[k] == token_constants::TOK_COLON
        var kw = string_intern::intern_resolve_int(p.interner, p.lexemes[i])
        cps_note_error_msg(p, "QZ0530: '#{kw}' is a reserved keyword and cannot be used as an identifier in function parameter")
        i = p.count
      end
    end
    i = i + 1
  end
end

# ===========================================================================
# Definitions added in M1.3b
# ===========================================================================

## Generic `KEYWORD <header tokens up to body newline> <member items> end`
## block-definition parser for struct / enum / trait / impl / extend / actor /
## effect / protocol. The header (name, generics, `for Type`, `: bound`) is
## captured as token leaves up to the first newline that opens the body; the
## body is parsed as a sequence of member items (nested `def`s, decorators, and
## generic member lines), terminated by `end`. Lossless; never errors.
def cps_parse_block_def(p: CstParser, kind: Int): Int
  return cps_parse_block_def_x(p, kind, 0)
end

## As `cps_parse_block_def`, but with an optional leading MODIFIER token
## (`lead_tok`; 0 = none). When present (e.g. the contextual `linear` / `value`
## ident before `struct`), it is pushed as the node's FIRST child so the printer
## round-trips `linear struct …` verbatim; the def keyword follows. cst_lower
## detects the leading modifier and routes it to the is_linear / is_value flag.
## The node's span/line/col anchor on the modifier when supplied.
def cps_parse_block_def_x(p: CstParser, kind: Int, lead_tok: Int): Int
  var s = p.store
  var kw = cps_advance_token(p)  # struct / enum / trait / impl / extend / actor / ...
  var anchor = kw
  if lead_tok != 0
    anchor = lead_tok
  end
  var node = cst::cst_alloc(s, kind, 0, 0, cst::cst_get_line(s, anchor), cst::cst_get_col(s, anchor))
  if lead_tok != 0
    cst::cst_push_child(s, node, lead_tok)
  end
  cst::cst_push_child(s, node, kw)
  var header_line = cst::cst_get_line(s, kw)
  # Header: consume tokens that remain on the keyword's source line(s) until the
  # body begins (a token on a later line). Balanced groups (generics `<...>`,
  # payloads `(...)`) are consumed wholesale so a `<` / `(` does not leak.
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    # A `{` on the header line opens a brace-delimited body (`extend X<T> { ...
    # }` / `impl Trait for X { ... }`, parser.qz:7372-7383's `uses_brace`). Stop
    # the header here so the brace becomes the body opener, not a header token.
    if tt == token_constants::TOK_LBRACE
      break
    end
    # Body starts when the next significant token is on a later line than the
    # header keyword (canonical Quartz: `struct X` newline fields... `end`).
    if cps_raw_line(p) != header_line
      break
    end
    if tt == token_constants::TOK_LPAREN
      cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LBRACKET
      cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    elsif tt == token_constants::TOK_LT
      cps_parse_type_args_verbatim(p, node)
    else
      var t = cps_advance_token(p)
      cst::cst_push_child(s, node, t)
    end
  end
  # Body members. Abstract method signatures are allowed only in trait /
  # protocol / effect bodies (all carried as CST_TRAIT_DEF kind 92).
  var allow_abstract = 0
  if kind == 92
    allow_abstract = 1
  end
  # Brace-delimited body `{ ... }` (parser.qz:7372-7427): the `{` opener and `}`
  # closer are pushed as token-leaf children flanking the member block, so the
  # printer round-trips the brace form and cst_lower reads members uniformly.
  if cps_cur_type(p) == token_constants::TOK_LBRACE
    # A brace-delimited body is legal for impl/extend/actor, but NOT for a
    # struct: `struct X { ... }` is a common mistake (`{ }` is reserved for
    # struct *literals*). Reject with QZ0102 (parser.qz:7521), then still capture
    # the brace body losslessly so the round-trip oracle holds.
    if kind == 88
      cps_note_error_msg(p, "QZ0102: brace-delimited struct bodies are not supported — write each field on its own line and close with `end`; `{ }` is only for struct literals")
    end
    var lb = cps_advance_token(p)  # {
    cst::cst_push_child(s, node, lb)
    var bmembers = cps_parse_member_block_braced(p, allow_abstract)
    cst::cst_push_child(s, node, bmembers)
    var rb = cps_expect(p, token_constants::TOK_RBRACE)  # }
    cst::cst_push_child(s, node, rb)
    cps_span_from_to(p, node, anchor, rb)
    return node
  end
  var members = cps_parse_member_block(p, allow_abstract)
  cst::cst_push_child(s, node, members)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, anchor, endkw)
  return node
end

## As `cps_parse_member_block` but terminates on `}` (brace-delimited body) in
## addition to `end`/EOF. Used by brace-form block defs (`extend X { ... }`).
def cps_parse_member_block_braced(p: CstParser, allow_abstract: Int): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_RBRACE or tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    var before = p.pos
    var item = 0
    if tt == token_constants::TOK_DEF
      item = cps_parse_function_x(p, allow_abstract)
    else
      item = cps_parse_member_line(p)
    end
    cst::cst_push_child(s, blk, item)
    if first == 0
      first = item
    end
    last = item
    if p.pos == before
      var stuck = cps_advance_token(p)
      cst::cst_push_child(s, blk, stuck)
    end
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## Parses the body of a block-definition: a sequence of member items until
## `end`/EOF (terminator not consumed). A member is a nested `def`, a decorator
## (`@...`)-prefixed item, or a generic "member line" (struct field / enum
## variant / trait sig) captured up to its end-of-line. Returns a CST_BLOCK.
## `allow_abstract` forwards to nested defs (1 = trait-style abstract sigs ok).
def cps_parse_member_block(p: CstParser, allow_abstract: Int): Int
  var s = p.store
  var blk = cps_node(p, 43)  # CST_BLOCK
  var first = 0
  var last = 0
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    var before = p.pos
    var item = 0
    if tt == token_constants::TOK_DEF
      item = cps_parse_function_x(p, allow_abstract)
    elsif tt == token_constants::TOK_CONST
      item = cps_parse_member_line(p)
    elsif tt == token_constants::TOK_AT
      item = cps_parse_member_line(p)
    else
      item = cps_parse_member_line(p)
    end
    cst::cst_push_child(s, blk, item)
    if first == 0
      first = item
    end
    last = item
    if p.pos == before
      var stuck = cps_advance_token(p)
      cst::cst_push_child(s, blk, stuck)
    end
  end
  if first != 0
    cps_span_from_to(p, blk, first, last)
  end
  return blk
end

## A generic member line (struct field, enum variant, trait method signature,
## decorator) — captures every token up to and through the end of its logical
## line (the next token on a different line), consuming balanced groups so
## payloads / defaults round-trip. Returns a CST_FIELD_DEF carrier node.
def cps_parse_member_line(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 89)  # CST_FIELD_DEF (generic member carrier)
  var first = 0
  var line = cps_raw_line(p)
  # Track a top-level `:` (type annotation) so a subsequent top-level `=` is
  # recognized as a struct-FIELD default `name: Type = <expr>` (the only member
  # shape with both). Type aliases (`type X = T`) / consts have no `:`, so their
  # `=` stays a verbatim token run — keeping them lossless and unchanged.
  var seen_colon = 0
  # A member line that opens with `:` has no field NAME (`struct Bad / : Int`).
  # Legacy ps_parse_field_def rejects this with "Expected field name" (QZ0101);
  # mirror that so the malformed struct fails to compile instead of silently
  # parsing a nameless field. The `:` is still captured below for losslessness.
  if cps_cur_type(p) == token_constants::TOK_COLON
    cps_note_error_msg(p, "Expected field name")
  end
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    # Stop when the next significant token moves to a new line (line-based item).
    if first != 0 and cps_raw_line(p) != line
      break
    end
    var h = 0
    if tt == token_constants::TOK_ASSIGN and seen_colon == 1
      # Field default `name: Type = <expr>`. Keep the `=` token leaf for
      # losslessness, then capture the default as a STRUCTURED expr child so
      # cl_lower_field_def attaches it via ast_field_def's default slot.
      var eq = cps_advance_token(p)
      cst::cst_push_child(s, node, eq)
      h = cps_parse_expr(p)
      cst::cst_push_child(s, node, h)
    elsif tt == token_constants::TOK_COLON
      seen_colon = 1
      h = cps_advance_token(p)
      cst::cst_push_child(s, node, h)
    elsif tt == token_constants::TOK_LPAREN
      h = cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LBRACKET
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACKET, token_constants::TOK_RBRACKET)
    elsif tt == token_constants::TOK_LBRACE
      h = cps_capture_balanced(p, node, token_constants::TOK_LBRACE, token_constants::TOK_RBRACE)
    elsif tt == token_constants::TOK_LT
      h = cps_parse_type_args_verbatim(p, node)
    else
      h = cps_advance_token(p)
      cst::cst_push_child(s, node, h)
    end
    if first == 0
      first = h
    end
  end
  if first != 0
    cps_span_from_to(p, node, first, first)
  end
  return node
end

## `import a/b [as c]` / `import * from m` / `from m import a, b` — captured as a
## single-line token run (CST_IMPORT). Imports never span lines.
def cps_parse_import(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # import / from
  var node = cst::cst_alloc(s, 111, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_IMPORT
  cst::cst_push_child(s, node, kw)
  var line = cst::cst_get_line(s, kw)
  var last = kw
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    if cps_raw_line(p) != line
      break
    end
    var t = cps_advance_token(p)
    cst::cst_push_child(s, node, t)
    last = t
  end
  cps_span_from_to(p, node, kw, last)
  return node
end

## `extern "C" def name(params): T` (bodyless declaration) or an extern
## DEFINITION with a body: `extern "x86-interrupt" def isr(f: Int): Void <body>
## end` (block) / `extern "C" def f(...): T = expr` (endless). Captures the
## `extern` keyword + ABI string, then the `def`/`var` signature tokens up to the
## point where the body form is decided, mirroring parser.qz's rule: a body is
## present iff an `=` follows (endless) or the next significant token is indented
## PAST the `extern` column (block body); otherwise it is a bodyless declaration.
def cps_parse_extern(p: CstParser): Int
  var s = p.store
  var kw = cps_advance_token(p)  # extern
  var node = cst::cst_alloc(s, 113, 0, 0, cst::cst_get_line(s, kw), cst::cst_get_col(s, kw))  # CST_EXTERN_FN
  cst::cst_push_child(s, node, kw)
  var extern_col = cst::cst_get_col(s, kw)
  var sig_line = cst::cst_get_line(s, kw)
  var last = kw
  # Signature header tokens (ABI string, `def`/`var`, name, params, return type)
  # on the extern keyword's logical line. Stop at `=` (endless body), `end`, EOF,
  # or a token that moves to a NEW line (the body, or the next decl / closing).
  while true
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_ASSIGN or tt == token_constants::TOK_END or tt == token_constants::TOK_EOF
      break
    end
    if last != kw and cps_raw_line(p) != sig_line
      break
    end
    if tt == token_constants::TOK_LPAREN
      # QZ0530: extern params (`extern "C" def f(from: Int)`) are captured as a
      # balanced group, NOT via cps_parse_param — so scan the param run for a
      # reserved-keyword name before consuming it (parser.qz:6716 routes extern
      # params through ps_expect_binding_name). A reserved kw followed by `:` at
      # paren-depth 1 is a named param; reject it.
      cps_scan_paren_params_for_reserved(p)
      last = cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    elsif tt == token_constants::TOK_LT
      last = cps_parse_type_args_verbatim(p, node)
    else
      last = cps_advance_token(p)
      cst::cst_push_child(s, node, last)
    end
  end
  # Body dispatch.
  if cps_cur_type(p) == token_constants::TOK_ASSIGN
    # Endless-body extern def: `= expr`.
    var eq = cps_advance_token(p)
    cst::cst_push_child(s, node, eq)
    var body = cps_parse_expr(p)
    cst::cst_push_child(s, node, body)
    cps_span_from_to(p, node, kw, body)
    return node
  end
  # Block-body extern def: a body follows iff the next significant token is
  # indented PAST the extern column (and is not the enclosing `end`/EOF).
  var nt = cps_cur_type(p)
  if nt != token_constants::TOK_END and nt != token_constants::TOK_EOF and cps_raw_col(p) > extern_col
    var blkbody = cps_parse_block_until(p)
    cst::cst_push_child(s, node, blkbody)
    var endkw = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, node, endkw)
    cps_span_from_to(p, node, kw, endkw)
    return node
  end
  # Bodyless declaration.
  cps_span_from_to(p, node, kw, last)
  return node
end

## A top-level decorator/attribute application `@name(...)` that prefixes a
## definition. Captures the `@name(...)` run, then parses the decorated item and
## attaches it as the final child. Multiple stacked `@` attributes are folded
## into one CST_DECORATOR carrying the chain + the decorated item.
def cps_parse_top_decorator(p: CstParser): Int
  var s = p.store
  var node = cps_node(p, 101)  # CST_DECORATOR
  var first = 0
  while cps_cur_type(p) == token_constants::TOK_AT
    var at = cps_advance_token(p)
    cst::cst_push_child(s, node, at)
    if first == 0
      first = at
    end
    # attribute name. Reject unknown attributes (parser.qz:8703) so a typo'd
    # `@bogus` is a clean diagnostic, not a silently-ignored no-op.
    if cps_cur_type(p) != token_constants::TOK_LPAREN and cps_cur_type(p) != token_constants::TOK_EOF
      if cps_cur_type(p) == token_constants::TOK_IDENT and cps_is_known_attribute(cps_raw_lexeme(p)) == 0
        cps_note_error_msg(p, "Unknown attribute: expected 'cfg', 'repr', 'packed', 'align', 'naked', 'noinline', 'weak', 'panic_handler', 'export', 'no_preempt', 'value', 'derive', 'thread_local', 'pure', 'io', 'suspend', 'strict', or 'ct'")
      end
      var nm = cps_advance_token(p)
      cst::cst_push_child(s, node, nm)
    end
    # optional balanced `(...)` argument.
    if cps_cur_type(p) == token_constants::TOK_LPAREN
      cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)
    end
  end
  # The decorated item (recurse into decl dispatch).
  var item = cps_parse_decl(p)
  cst::cst_push_child(s, node, item)
  cps_span_from_to(p, node, first, item)
  return node
end

## Top-level declaration dispatch: visibility markers, decorators, imports,
## definitions (def / struct / enum / trait / impl / extend / actor / effect /
## type / newtype / const / protocol via contextual keyword), else a statement.
## Parses a protocol body step-sequence into `parent` up to (but NOT consuming)
## the matching `end` / EOF. Steps: `send Type` / `recv Type` (contextual-ident
## keyword + type), `loop <steps> end`, `choice <steps> (or <steps>)* end` —
## nested blocks become CST_BLOCK children; `or` branch separators are captured
## inline. Mirrors parser.qz's protocol-body grammar. Recursive for loop/choice.
def cps_parse_protocol_steps(p: CstParser, parent: Int): Void
  var s = p.store
  while cps_cur_type(p) != token_constants::TOK_END and cps_at_end(p) == 0
    var tt = cps_cur_type(p)
    if tt == token_constants::TOK_LOOP
      var lk = cps_advance_token(p)  # loop
      cst::cst_push_child(s, parent, lk)
      var blk = cps_node(p, 43)  # CST_BLOCK (loop body steps)
      cps_parse_protocol_steps(p, blk)
      cst::cst_push_child(s, parent, blk)
      var lend = cps_expect(p, token_constants::TOK_END)
      cst::cst_push_child(s, parent, lend)
    elsif tt == token_constants::TOK_OR
      var ork = cps_advance_token(p)  # choice branch separator
      cst::cst_push_child(s, parent, ork)
    elsif tt == token_constants::TOK_IDENT
      var lex = cps_raw_lexeme(p)
      if str_eq(lex, "send") or str_eq(lex, "recv")
        var sk = cps_advance_token(p)  # send / recv
        cst::cst_push_child(s, parent, sk)
        var sty = cps_parse_type(p)
        cst::cst_push_child(s, parent, sty)
      elsif str_eq(lex, "choice")
        var chk = cps_advance_token(p)  # choice
        cst::cst_push_child(s, parent, chk)
        var cblk = cps_node(p, 43)  # CST_BLOCK (branches + `or` separators)
        cps_parse_protocol_steps(p, cblk)
        cst::cst_push_child(s, parent, cblk)
        var cend = cps_expect(p, token_constants::TOK_END)
        cst::cst_push_child(s, parent, cend)
      else
        var t = cps_advance_token(p)  # unknown ident — capture losslessly
        cst::cst_push_child(s, parent, t)
      end
    else
      var t = cps_advance_token(p)  # any other token — capture losslessly
      cst::cst_push_child(s, parent, t)
    end
  end
end

## `protocol Name <steps> end` — session-type protocol (carried as CST_TRAIT_DEF).
def cps_parse_protocol(p: CstParser): Int
  var s = p.store
  var pk = cps_advance_token(p)  # protocol (contextual ident)
  var node = cst::cst_alloc(s, 92, 0, 0, cst::cst_get_line(s, pk), cst::cst_get_col(s, pk))  # CST_TRAIT_DEF carrier
  cst::cst_push_child(s, node, pk)
  if cps_cur_type(p) == token_constants::TOK_IDENT
    var nm = cps_advance_token(p)  # protocol name
    cst::cst_push_child(s, node, nm)
  end
  cps_parse_protocol_steps(p, node)
  var endkw = cps_expect(p, token_constants::TOK_END)
  cst::cst_push_child(s, node, endkw)
  cps_span_from_to(p, node, pk, endkw)
  return node
end

def cps_parse_decl(p: CstParser): Int
  var s = p.store
  var tt = cps_cur_type(p)

  # A stray closing delimiter at the top level can begin neither a declaration
  # nor a statement; legacy parser.qz rejects it with the "Expected declaration"
  # message (ps_parse_program fallthrough). Record that specific text so spec
  # stderr assertions match, then capture the token verbatim for losslessness.
  if tt == token_constants::TOK_RPAREN or tt == token_constants::TOK_RBRACKET or tt == token_constants::TOK_RBRACE
    cps_note_error_msg(p, "Expected declaration (def, struct, enum, trait, impl, import, from, or var)")
    return cps_advance_token(p)
  end

  # `public` is NOT a keyword in Quartz — everything before a `private` section
  # is public. Legacy parser.qz:8413 rejects TOK_PUBLIC with a parse error; the
  # CST path mirrors that by flipping had_error (quartz.qz then emits QZ0101 and
  # bails). Must fire BEFORE the visibility-section branch, which previously
  # lumped TOK_PUBLIC in with TOK_PRIVATE and accepted it silently.
  if tt == token_constants::TOK_PUBLIC
    cps_note_error(p)
    var pubk = cps_advance_token(p)
    var pnode = cst::cst_alloc(s, 102, 0, 0, cst::cst_get_line(s, pubk), cst::cst_get_col(s, pubk))  # CST_VISIBILITY
    cst::cst_push_child(s, pnode, pubk)
    cps_span_from_to(p, pnode, pubk, pubk)
    return pnode
  end
  # Visibility section / prefix: `private`, `pub`, or contextual `priv`.
  if tt == token_constants::TOK_PRIVATE
    # G11: a file may carry exactly ONE `private` section (parser.qz:8403). A
    # SECOND standalone `private` is a hard per-file error — flip had_error so
    # quartz.qz bails (mirrors legacy ps_error "'private' can only appear once
    # per file"). The verbatim oracle still round-trips the tokens losslessly.
    if p.in_private_section == 1
      cps_note_error(p)
    end
    p.in_private_section = 1
    var vk = cps_advance_token(p)
    var node = cst::cst_alloc(s, 102, 0, 0, cst::cst_get_line(s, vk), cst::cst_get_col(s, vk))  # CST_VISIBILITY
    cst::cst_push_child(s, node, vk)
    cps_span_from_to(p, node, vk, vk)
    return node
  end
  if tt == token_constants::TOK_IDENT
    var lex = cps_raw_lexeme(p)
    if str_eq(lex, "priv") or str_eq(lex, "pub")
      # `priv <def>` / `pub import ...` — capture the marker then the item.
      var vk = cps_advance_token(p)
      var node = cst::cst_alloc(s, 102, 0, 0, cst::cst_get_line(s, vk), cst::cst_get_col(s, vk))  # CST_VISIBILITY
      cst::cst_push_child(s, node, vk)
      var item = cps_parse_decl(p)
      cst::cst_push_child(s, node, item)
      cps_span_from_to(p, node, vk, item)
      return node
    end
  end

  if tt == token_constants::TOK_AT
    return cps_parse_top_decorator(p)
  end
  if tt == token_constants::TOK_IMPORT or tt == token_constants::TOK_FROM
    return cps_parse_import(p)
  end
  if tt == token_constants::TOK_EXTERN
    return cps_parse_extern(p)
  end
  if tt == token_constants::TOK_DEF
    return cps_parse_function(p)
  end
  if tt == token_constants::TOK_STRUCT
    return cps_parse_block_def(p, 88)   # CST_STRUCT_DEF
  end
  if tt == token_constants::TOK_ENUM
    return cps_parse_block_def(p, 90)   # CST_ENUM_DEF
  end
  if tt == token_constants::TOK_TRAIT
    return cps_parse_block_def(p, 92)   # CST_TRAIT_DEF
  end
  if tt == token_constants::TOK_IMPL
    return cps_parse_block_def(p, 93)   # CST_IMPL_BLOCK
  end
  if tt == token_constants::TOK_EXTEND
    return cps_parse_block_def(p, 94)   # CST_EXTEND_BLOCK
  end
  if tt == token_constants::TOK_ACTOR
    return cps_parse_block_def(p, 95)   # CST_ACTOR_DEF
  end
  if tt == token_constants::TOK_EFFECT
    return cps_parse_block_def(p, 92)   # effect decl (reuse trait carrier)
  end
  if tt == token_constants::TOK_TYPE
    return cps_parse_member_line(p)     # `type Name = T` single line
  end
  if tt == token_constants::TOK_NEWTYPE
    return cps_parse_member_line(p)     # `newtype Name = T`
  end
  if tt == token_constants::TOK_CONST
    # `const def ...` compile-time fn, or `const NAME = expr`.
    if cps_peek_next_significant_type(p) == token_constants::TOK_DEF
      var ck = cps_advance_token(p)  # const
      var fn = cps_parse_function(p)
      var node = cst::cst_alloc(s, 85, 0, 0, cst::cst_get_line(s, ck), cst::cst_get_col(s, ck))  # CST_CONST_DEF
      cst::cst_push_child(s, node, ck)
      cst::cst_push_child(s, node, fn)
      cps_span_from_to(p, node, ck, fn)
      return node
    end
    # `const NAME = expr` — structured const declaration (CST_CONST_DECL 98).
    # Children: `const` tok, NAME tok, `=` tok, RHS expr (structured via
    # cps_parse_expr so cst_lower can build a NODE_CONST_DECL with a real init).
    # Mirrors parser.qz:ps_parse_const_decl. Falls back to the member-line
    # carrier for any malformed shape (no IDENT / no `=`), preserving the prior
    # lossless behavior.
    if cps_peek_next_significant_type(p) == token_constants::TOK_IDENT
      var ck = cps_advance_token(p)  # const
      var nm = cps_advance_token(p)  # NAME
      if cps_cur_type(p) == token_constants::TOK_ASSIGN
        var eq = cps_advance_token(p)  # =
        var node = cst::cst_alloc(s, 98, 0, 0, cst::cst_get_line(s, ck), cst::cst_get_col(s, ck))  # CST_CONST_DECL
        cst::cst_push_child(s, node, ck)
        cst::cst_push_child(s, node, nm)
        cst::cst_push_child(s, node, eq)
        var init = cps_parse_expr(p)
        cst::cst_push_child(s, node, init)
        cps_span_from_to(p, node, ck, init)
        return node
      end
      # Malformed `const NAME` without `=` — wrap the two consumed tokens in a
      # member-line carrier so spans round-trip (legacy would error here).
      var carrier = cst::cst_alloc(s, 89, 0, 0, cst::cst_get_line(s, ck), cst::cst_get_col(s, ck))  # CST_FIELD_DEF
      cst::cst_push_child(s, carrier, ck)
      cst::cst_push_child(s, carrier, nm)
      cps_span_from_to(p, carrier, ck, nm)
      return carrier
    end
    return cps_parse_member_line(p)
  end
  # `cimport "header.h"` — @cImport convenience decl (clang AST → generated module).
  if tt == token_constants::TOK_CIMPORT
    var ck = cps_advance_token(p)  # cimport
    var node = cst::cst_alloc(s, 116, 0, 0, cst::cst_get_line(s, ck), cst::cst_get_col(s, ck))  # CST_C_IMPORT
    cst::cst_push_child(s, node, ck)
    var last = ck
    if cps_cur_type(p) != token_constants::TOK_EOF and cps_newline_before_cur(p) == 0
      var hdr = cps_parse_expr(p)  # header string literal
      cst::cst_push_child(s, node, hdr)
      last = hdr
    end
    cps_span_from_to(p, node, ck, last)
    return node
  end
  # `macro name(params) do <template> end` — macro definition (parser.qz
  # ps_parse_macro_def). Header + balanced `(params)` + `do` template body + `end`.
  if tt == token_constants::TOK_MACRO
    var mk = cps_advance_token(p)  # macro
    var node = cst::cst_alloc(s, 124, 0, 0, cst::cst_get_line(s, mk), cst::cst_get_col(s, mk))  # CST_MACRO_DEF
    cst::cst_push_child(s, node, mk)
    if cps_cur_type(p) == token_constants::TOK_IDENT
      var nm = cps_advance_token(p)  # macro name
      cst::cst_push_child(s, node, nm)
    end
    if cps_cur_type(p) == token_constants::TOK_LPAREN
      cps_capture_balanced(p, node, token_constants::TOK_LPAREN, token_constants::TOK_RPAREN)  # params
    end
    if cps_cur_type(p) == token_constants::TOK_DO
      var dokw = cps_advance_token(p)
      cst::cst_push_child(s, node, dokw)
    end
    var body = cps_parse_block_until(p)  # template body (string expr-stmts)
    cst::cst_push_child(s, node, body)
    var endkw = cps_expect(p, token_constants::TOK_END)
    cst::cst_push_child(s, node, endkw)
    cps_span_from_to(p, node, mk, endkw)
    return node
  end
  # Contextual keyword definitions begin with an IDENT: protocol / packed /
  # linear / value etc. Detect `protocol Name` and `packed struct` etc.
  if tt == token_constants::TOK_IDENT
    var lex2 = cps_raw_lexeme(p)
    if str_eq(lex2, "protocol")
      return cps_parse_protocol(p)
    end
    # `linear struct …` — contextual struct-modifier keyword (parser.qz:8472).
    # The `linear` ident is captured as the leading token child of the
    # CST_STRUCT_DEF; cst_lower routes it to is_linear. Only valid immediately
    # before `struct`; otherwise fall through so a bare `linear` ident parses as
    # an ordinary statement. (There is NO bare `value struct` keyword — the
    # value-struct surface is the `@value` DECORATOR, parser.qz:8676.)
    if str_eq(lex2, "linear")
      if cps_peek_next_significant_type(p) == token_constants::TOK_STRUCT
        var mod_tok = cps_advance_token(p)  # linear
        return cps_parse_block_def_x(p, 88, mod_tok)  # CST_STRUCT_DEF
      end
    end
    # `packed struct(uN) Name … end` — Binary DSL contextual keyword
    # (parser.qz:8459 / ps_parse_packed_struct). The `packed` ident is captured
    # as the leading token child of a CST_PACKED_STRUCT (kind 129); the `(uN)`
    # backing-width payload rides the header as a balanced group, and fields are
    # plain member lines (`name: <int>`). cst_lower routes 129 to NODE_PACKED_STRUCT.
    if str_eq(lex2, "packed")
      if cps_peek_next_significant_type(p) == token_constants::TOK_STRUCT
        var packed_tok = cps_advance_token(p)  # packed
        return cps_parse_block_def_x(p, 129, packed_tok)  # CST_PACKED_STRUCT
      end
    end
    # `fn main()` / `func`/`function`/`fun` — the Rust/Go/Swift function keyword.
    # Quartz defines functions with `def`. These lex as a bare TOK_IDENT at decl
    # position followed by a name + `(`, so detect that shape and emit a targeted
    # diagnostic, consuming the stray keyword losslessly. Inert: no top-level
    # `fn`/`func`/etc. declaration exists in the compiler's own source.
    if (str_eq(lex2, "fn") or str_eq(lex2, "func") or str_eq(lex2, "function") or str_eq(lex2, "fun")) and cps_peek_next_significant_type(p) == token_constants::TOK_IDENT
      cps_note_error_msg(p, "'#{lex2}' is not a Quartz keyword — use `def` to define a function (def main(): Int)")
      var fnk = cps_advance_token(p)
      var fnes = cst::cst_alloc(s, 44, 0, 0, cst::cst_get_line(s, fnk), cst::cst_get_col(s, fnk))  # CST_EXPR_STMT
      cst::cst_push_child(s, fnes, fnk)
      cps_span_from_to(p, fnes, fnk, fnk)
      return fnes
    end
  end

  # Anything else: a statement.
  return cps_parse_stmt(p)
end

# ===========================================================================
# Program (root)
# ===========================================================================

## Parses a whole module: a sequence of top-level items (function defs +
## statements) → CST_PROGRAM. Any leading trivia before the first item, and any
## trailing trivia after the last, is captured by the chokepoint and emitted as
## a trailing EOF token leaf so the oracle reproduces file-edge whitespace.
def cps_parse_program(p: CstParser): Int
  var s = p.store
  var prog = cst::cst_alloc(s, 118, 0, str_byte_len(p.source), 1, 1)  # CST_PROGRAM
  while cps_at_end(p) == 0
    var before = p.pos
    var item = cps_parse_decl(p)
    cst::cst_push_child(s, prog, item)
    # Safety: if a malformed item made no progress, force one token of progress.
    if p.pos == before
      var stuck = cps_advance_token(p)
      cst::cst_push_child(s, prog, stuck)
    end
  end
  # Emit a final EOF token leaf so any pending trailing trivia (e.g. a comment
  # or blank lines at end of file) is attached and reproduced.
  var eof = cps_advance_token(p)
  cst::cst_push_child(s, prog, eof)
  return prog
end

# ===========================================================================
# Public entry: parse source → CST
# ===========================================================================

## Parses `source` into a lossless CST, returning the CstParser (holding the
## CstStorage + root handle). Runs the lexer in full-fidelity mode.
##
## NOTE: full-fidelity mode is a process-global lexer flag; we set it for this
## parse and reset it to 0 afterward so the AST pipeline (which must see the
## default stream) is unaffected.
struct CstParseResult
  parser: CstParser
  root: Int
end

def cst_parse_source(source: String): CstParseResult
  var interner = string_intern::intern_global()
  lexer::lexer_set_full_fidelity(1)
  var lex = lexer::lexer_tokenize(source, interner)
  lexer::lexer_set_full_fidelity(0)
  var p = cps_new(lex, source)
  var root = cps_parse_program(p)
  return CstParseResult { parser: p, root: root }
end

# ===========================================================================
# The verbatim round-trip ORACLE
# ===========================================================================

## Recursively collects, into `spans` (a flat Vec of [start, end] pairs), the
## byte span of every CST_TOKEN leaf and every attached trivia record reachable
## from `h`. Order is irrelevant (sorted later); we just need full coverage.
def cst_collect_spans(s: cst::CstStorage, h: Int, starts: Vec<Int>, ends: Vec<Int>): Void
  if h == 0
    return
  end
  # Trivia attached to this node (leading + trailing).
  var lead = cst::cst_get_leading_trivia(s, h)
  var li = 0
  while li < lead.size
    var t = lead[li]
    starts.push(cst::cst_trivia_byte_start(s, t))
    ends.push(cst::cst_trivia_byte_end(s, t))
    li = li + 1
  end
  var trail = cst::cst_get_trailing_trivia(s, h)
  var ti = 0
  while ti < trail.size
    var t = trail[ti]
    starts.push(cst::cst_trivia_byte_start(s, t))
    ends.push(cst::cst_trivia_byte_end(s, t))
    ti = ti + 1
  end
  # If this is a CST_TOKEN leaf, record its own span.
  if cst::cst_get_kind(s, h) == 1  # CST_TOKEN
    starts.push(cst::cst_get_byte_start(s, h))
    ends.push(cst::cst_get_byte_end(s, h))
  end
  # Recurse into structural + n-ary children.
  var l = cst::cst_get_left(s, h)
  if l != 0
    cst_collect_spans(s, l, starts, ends)
  end
  var r = cst::cst_get_right(s, h)
  if r != 0
    cst_collect_spans(s, r, starts, ends)
  end
  var kids = cst::cst_get_children(s, h)
  var ki = 0
  while ki < kids.size
    cst_collect_spans(s, kids[ki], starts, ends)
    ki = ki + 1
  end
end

## Verbatim CST → source serializer (the losslessness oracle).
##
## Reconstructs the original source bytes from the CST + the original source.
## Collects every token/trivia span, sorts by start offset, then slices the
## original source from the minimum start to the maximum end — the gaps between
## spans are exactly the original horizontal whitespace, so the slice is the
## original input byte-for-byte (for sources whose covered range is the whole
## file; leading file whitespace before the first token, if any, is included
## because the slice starts at the global minimum which is 0 when a leading
## trivia/newline run exists, and the lexer's first token starts at offset 0
## otherwise).
def cst_to_source_verbatim(s: cst::CstStorage, root: Int, source: String): String
  var starts = vec_new<Int>()
  var ends = vec_new<Int>()
  cst_collect_spans(s, root, starts, ends)
  if starts.size == 0
    return ""
  end
  var min_start = starts[0]
  var max_end = ends[0]
  var i = 1
  while i < starts.size
    if starts[i] < min_start
      min_start = starts[i]
    end
    if ends[i] > max_end
      max_end = ends[i]
    end
    i = i + 1
  end
  return str_byte_slice(source, min_start, max_end)
end

## Convenience: parse `source` and return its verbatim round-trip. If
## `cst_roundtrip(x) == x` byte-for-byte, the CST is lossless for `x`.
def cst_roundtrip(source: String): String
  var res = cst_parse_source(source)
  return cst_to_source_verbatim(res.parser.store, res.root, source)
end

## Structural-coverage probe (M1.3b). Parses `source` and returns 1 iff the
## parse was FULLY STRUCTURED — i.e. the grammar recognized every construct and
## the parser never had to fall back to the verbatim force-consume path
## (`had_error`). The verbatim oracle always round-trips losslessly (the gate),
## because unrecognized tokens still become CST_TOKEN leaves with correct spans;
## but a `had_error` parse means a construct lacks a structured kind, which M2's
## printer cannot reformat. This is the honest coverage signal: 1 = structured,
## 0 = fell back to verbatim somewhere.
def cst_parse_fully_structured(source: String): Int
  var res = cst_parse_source(source)
  if res.parser.had_error == 1
    return 0
  end
  return 1
end

## Diagnostic: the 1-based source line where the first structural fallback fired
## while parsing `source`, or 0 if the parse was fully structured. Lets the
## corpus checker point at the construct that still lacks a structured path.
def cst_first_unstructured_line(source: String): Int
  var res = cst_parse_source(source)
  if res.parser.had_error == 0
    return 0
  end
  return res.parser.first_err_line
end

## Diagnostic: the token TYPE at the first structural fallback (or 0 if none).
def cst_first_unstructured_token(source: String): Int
  var res = cst_parse_source(source)
  if res.parser.had_error == 0
    return 0
  end
  return res.parser.first_err_type
end
