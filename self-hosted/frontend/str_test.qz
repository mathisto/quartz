##! # String Tests
##!
##! Unit tests for string manipulation.
##!
##! @since 1.0.0

# Minimal test for string operations

def main(): Int
  # Test str_eq directly
  var s1 = "def"
  var s2 = "def"
  var s3 = "end"
  
  puts("Testing str_eq:")
  
  # Test 1: identical strings
  var eq1 = s1 == s2
  puts("  'def' == 'def': ", false)
  print_int(eq1)
  puts("")
  
  # Test 2: different strings
  var eq2 = s1 == s3
  puts("  'def' == 'end': ", false)
  print_int(eq2)
  puts("")
  
  # Test 3: literal comparison
  var eq3 = "def" == "def"
  puts("  literal 'def' == 'def': ", false)
  print_int(eq3)
  puts("")
  
  # Test str_slice
  puts("")
  puts("Testing str_slice:")
  var source = "def main"
  var sliced = source.byte_slice(0, 3)
  puts("  'def main'.byte_slice(0,3): '", false)
  puts(sliced, false)
  puts("'")
  
  # Test slice comparison
  var eq4 = sliced == "def"
  puts("  sliced == 'def': ", false)
  print_int(eq4)
  puts("")
  
  # Test str_char_at
  puts("")
  puts("Testing str_char_at:")
  var ch = source.byte_at(0)
  puts("  'def main'.byte_at(0): ", false)
  print_int(ch)
  puts(" (expected 100 for 'd')")
  puts("")
  
  return 0
end
