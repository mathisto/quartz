##! # Operator Constants
##!
##! Single source of truth for operator kind values.
##! These are the operator codes stored by the parser in binary/unary AST nodes.
##!
##! Used by: mir.qz, codegen.qz
##! Note: some values are shared between binary and unary contexts.
##!
##! @see mir
##! @see codegen
##! @since 1.0.0

# === Arithmetic (binary) ===
## Addition operator.
const OP_ADD = 0
## Subtraction operator.
const OP_SUB = 1
## Multiplication operator.
const OP_MUL = 2
## Division operator.
const OP_DIV = 3
## Modulo operator.
const OP_MOD = 4

# === Legacy logical (binary, deprecated) ===
## Legacy AND operator.
const OP_AND_LEGACY = 5
## Legacy OR operator.
const OP_OR_LEGACY = 6

# === Comparison (binary) ===
## Equality operator.
const OP_EQ = 7
## Inequality operator.
const OP_NE = 8
## Less than operator.
const OP_LT = 9
## Less than or equal operator.
const OP_LE = 10
## Greater than operator.
const OP_GT = 11
## Greater than or equal operator.
const OP_GE = 12

# === Logical (unary: NOT=13, binary: AND=14, OR=15) ===
## Logical NOT operator.
const OP_NOT = 13
## Logical AND operator.
const OP_AND = 14
## Logical OR operator.
const OP_OR = 15

# === Unary (shared numbers with binary ops, distinguished by node kind) ===
## Negation operator (shares value with AND).
const OP_NEG = 14
## Bitwise NOT operator (shares value with XOR).
const OP_BIT_NOT = 18

# === Bitwise (binary) ===
## Bitwise AND operator.
const OP_BIT_AND = 16
## Bitwise OR operator.
const OP_BIT_OR = 17
## Bitwise XOR operator.
const OP_BIT_XOR = 18
## Left shift operator.
const OP_SHL = 19
## Right shift operator.
const OP_SHR = 20

# === Range and special (binary) ===
## Range operator (..).
const OP_RANGE = 21
## Nil coalescing operator (??).
const OP_NIL_COALESCE = 22
## Inclusive range operator (...).
const OP_RANGE_INCLUSIVE = 23
## Match capture operator (@).
const OP_MATCH_CAPTURE = 24
## Regex match operator (=~).
const OP_MATCH = 25
## Regex non-match operator (!~).
const OP_NOMATCH = 26
