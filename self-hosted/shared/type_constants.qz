##! # Type Constants
##!
##! Canonical type ID definitions for the Quartz type checker.
##! All type checker modules import these constants via qualified access
##! (e.g., type_constants$TYPE_INT).
##!
##! These are the canonical type IDs used by the type checker, MIR lowering,
##! and codegen. The tc_tv_* inference system uses the same numbering.
##!
##! @see typecheck_util TypecheckState struct and utilities
##! @see mir MIR lowering (uses TC_TYPE_* bridging constants)
##! @since 1.0.0

# ============================================================================
# Type Constants — Scheme A (TypecheckState)
# ============================================================================

## Unknown type - used for unresolved types during inference.
const TYPE_UNKNOWN = 0

## Integer type (64-bit signed).
const TYPE_INT = 1

## Boolean type (true/false).
const TYPE_BOOL = 2

## String type (heap-allocated, immutable).
const TYPE_STRING = 3

## Void type - no value, used for procedures.
const TYPE_VOID = 4

## Array type - homogeneous collection with element type.
const TYPE_ARRAY = 5

## Function type - callable with parameter types and return type.
const TYPE_FUNCTION = 6

## Struct type - named product type with fields.
const TYPE_STRUCT = 7

## Enum type - named sum type with variants.
const TYPE_ENUM = 8

## Generic type parameter (e.g., T in Array<T>).
const TYPE_GENERIC = 9

## Option type - Some(T) or None.
const TYPE_OPTION = 10

## Result type - Ok(T) or Err(E).
const TYPE_RESULT = 11

## Type error sentinel - propagates through expressions.
const TYPE_ERROR = 12

## Symbol type - interned string literal (:ok, :error).
const TYPE_SYMBOL = 13

## Range type - for loop iteration (1..10).
const TYPE_RANGE = 14

## Trait type - named interface for polymorphism.
const TYPE_TRAIT = 15

## Regex type - compiled regular expression pattern.
const TYPE_REGEX = 16

## FFI C Type Aliases (v5.0)
## C int (i32)
const TYPE_CINT = 17
## C char (i8)
const TYPE_CCHAR = 18
## C void* (ptr)
const TYPE_CPTR = 19
## C size_t (i64)
const TYPE_CSIZE = 20
## C float (float)
const TYPE_CFLOAT = 21
## C double (double)
const TYPE_CDOUBLE = 22
## Never type (!)
const TYPE_NEVER = 23
## Vec type - dynamic array
const TYPE_VEC = 24
## HashMap type - key-value store
const TYPE_HASHMAP = 25
## Map type - alias for HashMap (unified Map<K,V> migration target).
## Both Map<K,V> and HashMap<K,V> resolve to the same runtime representation.
const TYPE_MAP = 25
## Ptr type - typed pointer (v5.4)
const TYPE_PTR = 26
## StringBuilder handle type (v5.7)
const TYPE_STRINGBUILDER = 27

## Phase 2 container/concurrency handle types (v5.12.23)
## Set - hash set handle
const TYPE_SET = 28
## IntMap - integer-keyed map handle
const TYPE_INTMAP = 29
## Arena - arena allocator handle
const TYPE_ARENA = 30
## Pool - pool allocator handle
const TYPE_POOL = 31
## ArenaPool - arena pool handle
const TYPE_ARENAPOOL = 32
## Channel - CSP channel handle
const TYPE_CHANNEL = 33
## Mutex - mutual exclusion lock handle
const TYPE_MUTEX = 34
## Atomic - atomic integer handle
const TYPE_ATOMIC = 35

## Native float types
## F64 - 64-bit float (stored as i64 bitcast)
const TYPE_F64 = 36
## F32 - 32-bit float (stored as i64 via fptrunc+bitcast+zext)
const TYPE_F32 = 37

## Fixed-width integer types (sized storage)
## I8 - signed 8-bit integer
const TYPE_I8 = 38
## I16 - signed 16-bit integer
const TYPE_I16 = 39
## I32 - signed 32-bit integer
const TYPE_I32 = 40
## U8 - unsigned 8-bit integer
const TYPE_U8 = 41
## U16 - unsigned 16-bit integer
const TYPE_U16 = 42
## U32 - unsigned 32-bit integer
const TYPE_U32 = 43

## SIMD types
## SIMD 128-bit (4 x float)
const TYPE_SIMD_F32X4 = 44
## SIMD 128-bit (2 x double)
const TYPE_SIMD_F64X2 = 45
## SIMD 128-bit (4 x i32)
const TYPE_SIMD_I32X4 = 46
## SIMD 256-bit (8 x float) AVX
const TYPE_SIMD_F32X8 = 47
## Task<T> - concurrent task handle
const TYPE_TASK = 48
## TaskGroup - structured concurrency group
const TYPE_TASK_GROUP = 49

## Union type: A | B | C
const TYPE_UNION = 50
## Intersection type: A & B & C
const TYPE_INTERSECTION = 51
## Anonymous structural record type: { x: Int, y: Int }
const TYPE_RECORD = 52

## Tuple type: (Int, String, Bool)
const TYPE_TUPLE = 53

## Future type: async call result, Future<T>
const TYPE_FUTURE = 54

## Record type base - each registered record gets TYPE_RECORD_BASE + index
const TYPE_RECORD_BASE = 3000

## Intersection type base - each registered intersection gets TYPE_INTERSECTION_BASE + index
const TYPE_INTERSECTION_BASE = 4000

## Union type base - each registered union gets TYPE_UNION_BASE + index
const TYPE_UNION_BASE = 2000

## Newtype base - each registered newtype gets TYPE_NEWTYPE_BASE + index
const TYPE_NEWTYPE_BASE = 1000

## Forall (quantified) type base — each registered forall scheme gets TYPE_FORALL_BASE + index
## Used for Rank-2 polymorphism: forall a. Fn(a): a
const TYPE_FORALL_BASE = 5000

## Protocol type - session-typed channel protocol
const TYPE_PROTOCOL = 55

## Slice<T> — shared, read-only fat pointer {ptr, len}. 16 bytes. No capacity.
## Views into a Vec<T>, Slice<T>, or backing buffer. Auto-coerces from Vec<T>.
const TYPE_SLICE = 56

## SliceMut<T> — unique, writable fat pointer {ptr, len}. 16 bytes. Move-on-pass.
## Type-level distinct from Slice<T>; enforces aliasing-XOR-mutability.
const TYPE_SLICE_MUT = 57

## Byte — 8-bit unsigned scalar, ABI-aliases Int at the scalar level but marks
## a Slice<T> as byte-strided (1-byte GEP stride). Used for Slice<Byte> views
## over Strings — see str_as_byte_slice. Tier 4 #24 Phase 4b §2.2.
const TYPE_BYTE = 58

## NonZero — i64-represented nominal scalar whose invariant is `value != 0`
## (B.10 §14 N2). Assignment-incompatible with Int (and with `nil`, which is
## Int), so the ONLY way to obtain one is the checked `nonzero_new` /
## explicit `nonzero_new_unchecked` — which keeps 0 out of every NonZero slot,
## making `Option<NonZero>`'s niche {0,1} at 0 (None ≡ 0) sound today. Bare i64
## in every slot (a NonZero IS its value); the niche query reports {0,1}.
const TYPE_NONZERO = 59

## Protocol type base - each registered protocol gets PROTOCOL_BASE + index
const PROTOCOL_BASE = 6000

## Struct nominal-type base (B.15d/N3.1 step-4a) - each registered struct gets
## STRUCT_TYPE_BASE + struct_idx as its nominal TypeId, replacing the bare
## TYPE_STRUCT(=7) existential collapse. Range 7000..49999 (≈43k struct slots).
## NOTE: only BARE struct names parse to this id; generic-struct ptypes
## (Stream<T>, Foo<Int>) keep TYPE_STRUCT as their ptype *base* (see
## docs/design/B15_NIL_ELIMINATION.md §11.12). The existing tc_is_i64_type
## catch-all (NEWTYPE_BASE..PTYPE_BASE) already treats this range as an i64
## handle, so per-struct ids are runtime/coercion-consistent for free.
const STRUCT_TYPE_BASE = 7000

## Parameterized type base - Vec<Int>, Option<String> etc. get PTYPE_BASE + index
const PTYPE_BASE = 100000
