## Quartz Interactive REPL
##
## Raw-mode line editing, live syntax highlighting, tab completion,
## history persistence, and JIT execution via lli.
##
## @since 5.13.0

import lexer
import string_intern
import file_io

REPL_VERSION = "0.3.0"

# Token constants (inlined to avoid wildcard-import namespace collision
# when compiled as part of the compiler — see CQ.1 analysis)
_TK_EOF = 0
_TK_NEWLINE = 1
_TK_IDENT = 2
_TK_INT = 3
_TK_CHAR = 4
_TK_STRING = 5
_TK_SYMBOL = 6
_TK_DEF = 9
_TK_END = 10
_TK_IF = 11
_TK_WHILE = 14
_TK_DO = 15
_TK_TRUE = 19
_TK_FALSE = 20
_TK_VAR = 22
_TK_FOR = 27
_TK_IN = 28
_TK_STRUCT = 30
_TK_ENUM = 31
_TK_MATCH = 33
_TK_THEN = 35
_TK_IMPORT = 38
_TK_TRAIT = 43
_TK_IMPL = 44
_TK_EXTERN = 46
_TK_TYPE = 55
_TK_DOC_COMMENT = 98
_TK_DOC_MODULE = 99
_TK_DOC_INLINE = 100
_TK_ERROR = 102
_TK_NEWTYPE = 103
_TK_NIL = 104
_TK_EXTEND = 106
_TK_FLOAT_LIT = 108
_TK_CONST = 109
_TK_LOOP = 111
_TK_MACRO = 112
_TK_GO = 119
_TK_STRING_START = 127
_TK_STRING_PART = 128
_TK_INTERP_START = 129
_TK_INTERP_END = 130
_TK_STRING_END = 131

_KEY_UP = 1000
_KEY_DOWN = 1001
_KEY_RIGHT = 1002
_KEY_LEFT = 1003
_KEY_HOME = 1004
_KEY_END = 1005
_KEY_DELETE = 1006
_KEY_ALT_B = 1007
_KEY_ALT_F = 1008
_KEY_CTRL_LEFT = 1009
_KEY_CTRL_RIGHT = 1010
_KEY_PASTE_START = 1011
_KEY_PASTE_END = 1012

# Termios FFI — inlined from std/ffi/termios.qz (CQ.1 avoidance)
extern "C" def tcgetattr(fd: CInt, termios_p: CPtr): CInt
extern "C" def tcsetattr(fd: CInt, actions: CInt, termios_p: CPtr): CInt
extern "C" def isatty(fd: CInt): CInt
extern "C" def ioctl(fd: CInt, request: CInt, ...): CInt

def _TCSANOW(): Int = 0

@cfg(os: "macos")
def _TERMIOS_SIZE(): Int = 72
@cfg(os: "linux")
def _TERMIOS_SIZE(): Int = 60

@cfg(os: "macos")
def _TERMIOS_LFLAG_OFFSET(): Int = 24
@cfg(os: "linux")
def _TERMIOS_LFLAG_OFFSET(): Int = 12

@cfg(os: "macos")
def _TERMIOS_LFLAG_WIDTH(): Int = 8
@cfg(os: "linux")
def _TERMIOS_LFLAG_WIDTH(): Int = 4

@cfg(os: "macos")
def _TERMIOS_CC_OFFSET(): Int = 32
@cfg(os: "linux")
def _TERMIOS_CC_OFFSET(): Int = 17

@cfg(os: "macos")
def _ICANON(): Int = 0x100
@cfg(os: "linux")
def _ICANON(): Int = 2

@cfg(os: "macos")
def _ECHO(): Int = 8
@cfg(os: "linux")
def _ECHO(): Int = 8

@cfg(os: "macos")
def _ISIG(): Int = 0x80
@cfg(os: "linux")
def _ISIG(): Int = 1

@cfg(os: "macos")
def _IEXTEN(): Int = 0x400
@cfg(os: "linux")
def _IEXTEN(): Int = 0x8000

@cfg(os: "macos")
def _ICRNL(): Int = 0x100
@cfg(os: "linux")
def _ICRNL(): Int = 0x100

def _TERMIOS_IFLAG_OFFSET(): Int = 0

@cfg(os: "macos")
def _TERMIOS_IFLAG_WIDTH(): Int = 8
@cfg(os: "linux")
def _TERMIOS_IFLAG_WIDTH(): Int = 4

@cfg(os: "macos")
def _VMIN(): Int = 16
@cfg(os: "linux")
def _VMIN(): Int = 6

@cfg(os: "macos")
def _VTIME(): Int = 17
@cfg(os: "linux")
def _VTIME(): Int = 5

@cfg(os: "macos")
def _TIOCGWINSZ(): Int = 0x40087468
@cfg(os: "linux")
def _TIOCGWINSZ(): Int = 0x5413

def _term_read_field(base: Int, offset: Int, width: Int): Int
  var p = ptr_add(base, offset)
  if width == 4
    var b0 = ptr_read_byte(p)
    var b1 = ptr_read_byte(ptr_add(p, 1))
    var b2 = ptr_read_byte(ptr_add(p, 2))
    var b3 = ptr_read_byte(ptr_add(p, 3))
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
  end
  var b0 = ptr_read_byte(p)
  var b1 = ptr_read_byte(ptr_add(p, 1))
  var b2 = ptr_read_byte(ptr_add(p, 2))
  var b3 = ptr_read_byte(ptr_add(p, 3))
  var b4 = ptr_read_byte(ptr_add(p, 4))
  var b5 = ptr_read_byte(ptr_add(p, 5))
  var b6 = ptr_read_byte(ptr_add(p, 6))
  var b7 = ptr_read_byte(ptr_add(p, 7))
  return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216 + b4 * 4294967296 + b5 * 1099511627776 + b6 * 281474976710656 + b7 * 72057594037927936
end

def _term_write_field(base: Int, offset: Int, width: Int, value: Int): Void
  var p = ptr_add(base, offset)
  ptr_write_byte(p, band(value, 255))
  ptr_write_byte(ptr_add(p, 1), band(shr(value, 8), 255))
  ptr_write_byte(ptr_add(p, 2), band(shr(value, 16), 255))
  ptr_write_byte(ptr_add(p, 3), band(shr(value, 24), 255))
  if width == 8
    ptr_write_byte(ptr_add(p, 4), band(shr(value, 32), 255))
    ptr_write_byte(ptr_add(p, 5), band(shr(value, 40), 255))
    ptr_write_byte(ptr_add(p, 6), band(shr(value, 48), 255))
    ptr_write_byte(ptr_add(p, 7), band(shr(value, 56), 255))
  end
end

# Module-level mutable state — direct vars (CQ.2 fix enables assignment)
var _counter = 0
var _cursor = 0
var _hist_index = 0
var _running = 1
var _stdin_handle = 0
var _is_tty = 0
var _compiler = ""
var _lli = ""
var _preamble = ""
var _stdlib_path = "std"
var _hist_saved = ""
var _hist_path = ""
var _edit_buf = vec_new<Int>()
var _history = vec_new<String>()
var _term_saved_ptr = 0
var _term_raw_active = 0
var _cols = 80
var _search_mode = 0
var _search_query = ""
var _search_idx = 0
var _paste_mode = 0
var _last_type = ""

# ANSI helpers
def _esc(): String = str_concat(str_from_char(27), "[")

def _clr(s: String, code: String): String
  return str_concat(str_concat(str_concat(str_concat(_esc(), code), "m"), s), str_concat(_esc(), "0m"))
end

def _bright_blue(s: String): String = _clr(s, "94")
def _green(s: String): String = _clr(s, "32")
def _yellow(s: String): String = _clr(s, "33")
def _cyan(s: String): String = _clr(s, "36")
def _bright_cyan(s: String): String = _clr(s, "96")
def _magenta(s: String): String = _clr(s, "35")
def _red(s: String): String = _clr(s, "31")
def _dim(s: String): String = _clr(s, "2")
def _bold(s: String): String = _clr(s, "1")
def _bright_green(s: String): String = _clr(s, "92")
def _clear_eol(): String = str_concat(_esc(), "K")
def _col(n: Int): String = str_concat(str_concat(_esc(), str_from_int(n)), "G")

def _strip_ansi(s: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == 27 and i + 1 < len and str_byte_at(s, i + 1) == '['
      i = i + 2
      while i < len
        var ch = str_byte_at(s, i)
        i += 1
        if (ch >= 'A' and ch <= 'Z') or (ch >= 'a' and ch <= 'z')
          break
        end
      end
    else
      sb_append_char(sb, c)
      i += 1
    end
  end
  return sb_to_string(sb)
end

def _vlen(s: String): Int = str_byte_len(_strip_ansi(s))

# Buffer ops
def _buf_clear(): Void
  _edit_buf = vec_new<Int>()
end

def _buf_str(): String
  var sb = sb_new()
  var i = 0
  while i < _edit_buf.size
    sb_append_char(sb, _edit_buf[i])
    i += 1
  end
  return sb_to_string(sb)
end

def _buf_set(s: String): Void
  _buf_clear()
  var i = 0
  while i < str_byte_len(s)
    _edit_buf.push(str_byte_at(s, i))
    i += 1
  end
  _cursor = _edit_buf.size
end

def _buf_ins(ch: Int): Void
  if _cursor >= _edit_buf.size
    _edit_buf.push(ch)
  else
    _edit_buf.push(0)
    var i = _edit_buf.size - 1
    while i > _cursor
      vec_set(_edit_buf, i, _edit_buf[i - 1])
      i -= 1
    end
    vec_set(_edit_buf, _cursor, ch)
  end
  _cursor += 1
end

def _buf_del_back(): Void
  if _cursor <= 0
    return
  end
  _cursor -= 1
  var i = _cursor
  while i < _edit_buf.size - 1
    vec_set(_edit_buf, i, _edit_buf[i + 1])
    i += 1
  end
  vec_pop(_edit_buf)
end

def _buf_del_at(): Void
  if _cursor >= _edit_buf.size
    return
  end
  var i = _cursor
  while i < _edit_buf.size - 1
    vec_set(_edit_buf, i, _edit_buf[i + 1])
    i += 1
  end
  vec_pop(_edit_buf)
end

# Syntax highlighting
def _is_kw(tt: Int): Bool
  if tt >= _TK_DEF and tt <= _TK_IN
    return true
  end
  if tt == _TK_STRUCT or tt == _TK_ENUM
    return true
  end
  if tt >= _TK_MATCH and tt <= _TK_THEN
    return true
  end
  if tt >= _TK_IMPORT and tt <= _TK_TYPE
    return true
  end
  if tt == _TK_NEWTYPE or tt == _TK_NIL or tt == _TK_EXTEND
    return true
  end
  if tt >= _TK_CONST and tt <= _TK_GO
    return true
  end
  return false
end

def _is_upper(s: String): Bool
  if str_byte_len(s) == 0
    return false
  end
  var c = str_byte_at(s, 0)
  return c >= 'A' and c <= 'Z'
end

def _highlight(src: String): String
  if str_byte_len(src) == 0
    return ""
  end
  var interner = string_intern::intern_global()
  var lex = lexer::lexer_tokenize(src, interner)
  var types = lex.get_types()
  var lexemes = lex.get_lexemes()
  var cols = lex.get_cols()
  var count = lex.token_count()

  var sb = sb_new()
  var pos = 0
  var idx = 0
  var src_len = str_byte_len(src)

  while idx < count
    var tt = types[idx]
    if tt == _TK_EOF
      break
    end
    var tok_start = cols[idx] - 1
    var tok_text = intern_resolve_int(interner, lexemes[idx])
    var tok_len = str_byte_len(tok_text)
    var tok_end = tok_start + tok_len

    while pos < tok_start and pos < src_len
      sb_append_char(sb, str_byte_at(src, pos))
      pos += 1
    end

    if _is_kw(tt)
      if tt == _TK_TRUE or tt == _TK_FALSE or tt == _TK_NIL
        sb_append(sb, _magenta(tok_text))
      else
        sb_append(sb, _bright_blue(tok_text))
      end
    elsif tt == _TK_STRING or tt == _TK_STRING_START or tt == _TK_STRING_PART or tt == _TK_STRING_END
      sb_append(sb, _green(str_byte_slice(src, tok_start, tok_end)))
    elsif tt == _TK_INT or tt == _TK_FLOAT_LIT or tt == _TK_CHAR
      sb_append(sb, _yellow(tok_text))
    elsif tt == _TK_SYMBOL
      sb_append(sb, _cyan(tok_text))
    elsif tt == _TK_DOC_COMMENT or tt == _TK_DOC_MODULE or tt == _TK_DOC_INLINE
      sb_append(sb, _dim(str_byte_slice(src, tok_start, tok_end)))
    elsif tt == _TK_IDENT and _is_upper(tok_text)
      sb_append(sb, _bright_cyan(tok_text))
    elsif tt == _TK_ERROR
      sb_append(sb, _red(str_byte_slice(src, tok_start, tok_end)))
    else
      sb_append(sb, str_byte_slice(src, tok_start, tok_end))
    end

    pos = tok_end
    idx += 1
  end

  while pos < src_len
    sb_append_char(sb, str_byte_at(src, pos))
    pos += 1
  end
  return sb_to_string(sb)
end

# Terminal I/O
def _raw_enter(): Void
  if _term_raw_active == 1
    return
  end
  _term_saved_ptr = mem_alloc(_TERMIOS_SIZE() * 2)
  var work_ptr = ptr_add(_term_saved_ptr, _TERMIOS_SIZE())
  if tcgetattr(0, _term_saved_ptr) != 0
    qz_free(_term_saved_ptr)
    _term_saved_ptr = 0
    return
  end
  var ci = 0
  while ci < _TERMIOS_SIZE()
    ptr_write_byte(ptr_add(work_ptr, ci), ptr_read_byte(ptr_add(_term_saved_ptr, ci)))
    ci = ci + 1
  end
  var lflag = _term_read_field(work_ptr, _TERMIOS_LFLAG_OFFSET(), _TERMIOS_LFLAG_WIDTH())
  lflag = band(lflag, bnot(bor(bor(bor(_ICANON(), _ECHO()), _ISIG()), _IEXTEN())))
  _term_write_field(work_ptr, _TERMIOS_LFLAG_OFFSET(), _TERMIOS_LFLAG_WIDTH(), lflag)
  var iflag = _term_read_field(work_ptr, _TERMIOS_IFLAG_OFFSET(), _TERMIOS_IFLAG_WIDTH())
  iflag = band(iflag, bnot(_ICRNL()))
  _term_write_field(work_ptr, _TERMIOS_IFLAG_OFFSET(), _TERMIOS_IFLAG_WIDTH(), iflag)
  var cc_ptr = ptr_add(work_ptr, _TERMIOS_CC_OFFSET())
  ptr_write_byte(ptr_add(cc_ptr, _VMIN()), 1)
  ptr_write_byte(ptr_add(cc_ptr, _VTIME()), 0)
  if tcsetattr(0, _TCSANOW(), work_ptr) != 0
    qz_free(_term_saved_ptr)
    _term_saved_ptr = 0
    return
  end
  _term_raw_active = 1
  print(str_concat(_esc(), "?2004h"))
end

def _raw_exit(): Void
  if _term_raw_active == 0
    return
  end
  print(str_concat(_esc(), "?2004l"))
  tcsetattr(0, _TCSANOW(), _term_saved_ptr)
  qz_free(_term_saved_ptr)
  _term_saved_ptr = 0
  _term_raw_active = 0
end

def _term_width(): Int
  var buf = mem_alloc(8)
  var ret = ioctl(1, _TIOCGWINSZ(), buf)
  if ret != 0
    qz_free(buf)
    return 80
  end
  var b0 = ptr_read_byte(ptr_add(buf, 2))
  var b1 = ptr_read_byte(ptr_add(buf, 3))
  var w = b0 + b1 * 256
  qz_free(buf)
  if w <= 0
    return 80
  end
  return w
end

def _term_height(): Int
  var buf = mem_alloc(8)
  var ret = ioctl(1, _TIOCGWINSZ(), buf)
  if ret != 0
    qz_free(buf)
    return 24
  end
  var b0 = ptr_read_byte(buf)
  var b1 = ptr_read_byte(ptr_add(buf, 1))
  var h = b0 + b1 * 256
  qz_free(buf)
  if h <= 0
    return 24
  end
  return h
end

def _read_byte(): Int
  var s = fread(_stdin_handle, 1)
  if str_byte_len(s) == 0
    return -1
  end
  return str_byte_at(s, 0)
end

def _read_key(): Int
  var c = _read_byte()
  if c < 0
    return c
  end
  if c != 27
    return c
  end
  var c2 = _read_byte()
  if c2 < 0
    return 27
  end
  # Alt-B / Alt-F (word navigation)
  if c2 == 'b'
    return _KEY_ALT_B
  end
  if c2 == 'f'
    return _KEY_ALT_F
  end
  if c2 == '['
    var c3 = _read_byte()
    if c3 < 0
      return 27
    end
    if c3 == 'A'
      return _KEY_UP
    end
    if c3 == 'B'
      return _KEY_DOWN
    end
    if c3 == 'C'
      return _KEY_RIGHT
    end
    if c3 == 'D'
      return _KEY_LEFT
    end
    if c3 == 'H'
      return _KEY_HOME
    end
    if c3 == 'F'
      return _KEY_END
    end
    if c3 >= '0' and c3 <= '9'
      # Accumulate numeric parameters for extended sequences
      var param1 = c3 - '0'
      var param2 = 0
      var has_semi = 0
      var cn = _read_byte()
      while cn >= '0' and cn <= '9'
        param1 = param1 * 10 + (cn - '0')
        cn = _read_byte()
      end
      if cn == ';'
        has_semi = 1
        cn = _read_byte()
        while cn >= '0' and cn <= '9'
          param2 = param2 * 10 + (cn - '0')
          cn = _read_byte()
        end
      end
      if cn == '~'
        if param1 == 3
          return _KEY_DELETE
        end
        if param1 == 1 or param1 == 7
          return _KEY_HOME
        end
        if param1 == 4 or param1 == 8
          return _KEY_END
        end
        if param1 == 200
          return _KEY_PASTE_START
        end
        if param1 == 201
          return _KEY_PASTE_END
        end
      end
      # Ctrl+Arrow: ESC [1;5D / ESC [1;5C
      if has_semi == 1 and param2 == 5
        if cn == 'D'
          return _KEY_CTRL_LEFT
        end
        if cn == 'C'
          return _KEY_CTRL_RIGHT
        end
      end
    end
    return 27
  end
  if c2 == 'O'
    var c3 = _read_byte()
    if c3 == 'H'
      return _KEY_HOME
    end
    if c3 == 'F'
      return _KEY_END
    end
  end
  return 27
end

# Line rendering
def _redraw(prompt: String): Void
  _cols = _term_width()
  var line = _buf_str()
  var hl = _highlight(line)
  var prompt_len = _vlen(prompt)
  var avail = _cols - prompt_len
  if avail < 1
    avail = 1
  end
  if str_byte_len(line) > avail
    hl = _highlight(str_byte_slice(line, 0, avail - 1)) + _dim("~")
  end
  print(str_concat("\r", str_concat(prompt, str_concat(hl, _clear_eol()))))
  var cursor_pos = prompt_len + _cursor + 1
  if cursor_pos > _cols
    cursor_pos = _cols
  end
  print(_col(cursor_pos))
end

# Word navigation
def _word_back(): Void
  while _cursor > 0 and _edit_buf[_cursor - 1] == ' '
    _cursor -= 1
  end
  while _cursor > 0 and _edit_buf[_cursor - 1] != ' '
    _cursor -= 1
  end
end

def _word_fwd(): Void
  while _cursor < _edit_buf.size and _edit_buf[_cursor] != ' '
    _cursor += 1
  end
  while _cursor < _edit_buf.size and _edit_buf[_cursor] == ' '
    _cursor += 1
  end
end

# Reverse history search
def _search_find(query: String, start_idx: Int): Int
  if str_byte_len(query) == 0
    return -1
  end
  var i = start_idx
  while i >= 0
    if str_contains(_history[i], query) == 1
      return i
    end
    i -= 1
  end
  return -1
end

def _search_redraw(): Void
  var prompt = "(reverse-i-search)`" + _search_query + "': "
  var found_line = ""
  if _search_idx >= 0 and _search_idx < _history.size
    found_line = _history[_search_idx]
  end
  print("\r" + _dim(prompt) + _highlight(found_line) + _clear_eol())
end

def _search_enter(): Void
  _search_mode = 1
  _search_query = ""
  _search_idx = _history.size - 1
  _search_redraw()
end

def _search_exit(accept: Int): Void
  _search_mode = 0
  if accept == 1 and _search_idx >= 0 and _search_idx < _history.size
    _buf_set(_history[_search_idx])
  end
end

# History
def _hist_add(entry: String): Void
  if str_byte_len(entry) == 0
    return
  end
  if _history.size > 0
    if _history[_history.size - 1] == entry
      return
    end
  end
  _history.push(entry)
end

def _hist_load(): Void
  if str_byte_len(_hist_path) == 0
    return
  end
  if fio_exists(_hist_path) == false
    return
  end
  var data = fio_read(_hist_path)
  if str_byte_len(data) == 0
    return
  end
  var lines = str_split(data, "\n")
  var i = 0
  while i < lines.size
    var line = lines[i]
    if str_byte_len(line) > 0
      _history.push(line)
    end
    i += 1
  end
end

def _hist_save(): Void
  if str_byte_len(_hist_path) == 0
    return
  end
  var sb = sb_new()
  var i = 0
  while i < _history.size
    sb_append(sb, _history[i])
    sb_append(sb, "\n")
    i += 1
  end
  var _w = fio_write(_hist_path, sb_to_string(sb))
end

# Input classification
def _classify(input: String): Int
  if str_byte_len(input) == 0
    return 0
  end
  if str_byte_at(input, 0) == ':'
    return 2
  end
  var interner = string_intern::intern_global()
  var lex = lexer::lexer_tokenize(input, interner)
  var types = lex.get_types()
  var count = lex.token_count()
  var i = 0
  while i < count
    var tt = types[i]
    if tt != _TK_NEWLINE and tt != _TK_EOF
      if tt == _TK_DEF or tt == _TK_STRUCT or tt == _TK_ENUM or tt == _TK_IMPORT or tt == _TK_TRAIT or tt == _TK_IMPL or tt == _TK_CONST or tt == _TK_EXTERN or tt == _TK_TYPE or tt == _TK_MACRO or tt == _TK_NEWTYPE
        return 1
      end
      return 0
    end
    i += 1
  end
  return 0
end

def _block_depth(input: String): Int
  var interner = string_intern::intern_global()
  var lex = lexer::lexer_tokenize(input, interner)
  var types = lex.get_types()
  var count = lex.token_count()
  var depth = 0
  var i = 0
  while i < count
    var tt = types[i]
    if tt == _TK_DEF or tt == _TK_IF or tt == _TK_WHILE or tt == _TK_FOR or tt == _TK_STRUCT or tt == _TK_ENUM or tt == _TK_TRAIT or tt == _TK_IMPL or tt == _TK_MATCH or tt == _TK_DO or tt == _TK_LOOP
      depth += 1
    end
    if tt == _TK_END
      depth -= 1
    end
    i += 1
  end
  if depth < 0
    return 0
  end
  return depth
end

# Compilation
def _compile_run(source: String): String
  _counter += 1
  var tag = str_from_int(_counter)
  var src = "/tmp/_qz_repl_" + tag + ".qz"
  var ir = "/tmp/_qz_repl_" + tag + ".ll"
  var err = "/tmp/_qz_repl_" + tag + ".err"
  var out = "/tmp/_qz_repl_" + tag + ".out"

  var _w = fio_write(src, source)
  var cmd = _compiler + " --no-cache -I " + _stdlib_path + " " + src + " > " + ir + " 2> " + err
  var r = system(cmd)

  if r != 0
    var e = fio_read(err)
    var _c = system("rm -f " + src + " " + ir + " " + err)
    return "Error: " + e
  end

  var run = _lli + " " + ir + " > " + out + " 2>&1"
  var rr = system(run)
  var output = fio_read(out)
  var _c = system("rm -f " + src + " " + ir + " " + err + " " + out)

  if rr != 0 and str_byte_len(output) == 0
    return "Runtime error (exit " + str_from_int(rr / 256) + ")"
  end
  return output
end

def _make_prog(body: String): String
  var sb = sb_new()
  if str_byte_len(_preamble) > 0
    sb_append(sb, _preamble)
    sb_append(sb, "\n")
  end
  sb_append(sb, "def main(): Int\n  ")
  sb_append(sb, body)
  sb_append(sb, "\n  return 0\nend\n")
  return sb_to_string(sb)
end

def _eval_expr(input: String): String
  var src = _make_prog("print_int(" + input + ")")
  var r = _compile_run(src)
  if str_starts_with(r, "Error:") == 0
    _last_type = "Int"
    return str_trim(r)
  end
  src = _make_prog(input)
  r = _compile_run(src)
  if str_starts_with(r, "Error:") == 1
    _last_type = ""
    return r
  end
  var trimmed = str_trim(r)
  if str_byte_len(trimmed) > 0
    _last_type = "String"
    return trimmed
  end
  _last_type = "Void"
  return ""
end

def _eval_def(input: String): String
  _counter += 1
  var tag = str_from_int(_counter)
  var src = "/tmp/_qz_repl_" + tag + ".qz"
  var ir = "/tmp/_qz_repl_" + tag + ".ll"
  var err = "/tmp/_qz_repl_" + tag + ".err"

  var sb = sb_new()
  if str_byte_len(_preamble) > 0
    sb_append(sb, _preamble)
    sb_append(sb, "\n")
  end
  sb_append(sb, input)
  sb_append(sb, "\ndef main(): Int\n  return 0\nend\n")

  var _w = fio_write(src, sb_to_string(sb))
  var cmd = _compiler + " --no-cache -I " + _stdlib_path + " " + src + " > " + ir + " 2> " + err
  var r = system(cmd)
  var _c = system("rm -f " + src + " " + ir + " " + err)

  if r != 0
    var e = fio_read(err)
    return "Error: " + e
  end
  _preamble = _preamble + input + "\n"
  return ""
end

# Preamble name extraction for dynamic completion
def _extract_preamble_names(): Vec<String>
  var names = vec_new<String>()
  if str_byte_len(_preamble) == 0
    return names
  end
  var interner = string_intern::intern_global()
  var lex = lexer::lexer_tokenize(_preamble, interner)
  var types = lex.get_types()
  var lexemes = lex.get_lexemes()
  var count = lex.token_count()
  var i = 0
  while i < count - 1
    var tt = types[i]
    if tt == _TK_DEF or tt == _TK_STRUCT or tt == _TK_ENUM or tt == _TK_TRAIT or tt == _TK_VAR or tt == _TK_CONST
      var next_tt = types[i + 1]
      if next_tt == _TK_IDENT
        var name = intern_resolve_int(interner, lexemes[i + 1])
        names.push(name)
      end
    end
    i += 1
  end
  return names
end

# Tab completion
def _comp_prefix(): String
  if _cursor == 0
    return ""
  end
  var end_pos = _cursor
  var start = end_pos - 1
  while start >= 0
    var c = _edit_buf[start]
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == ':'
      start = start - 1
    else
      break
    end
  end
  start = start + 1
  var sb = sb_new()
  var i = start
  while i < end_pos
    sb_append_char(sb, _edit_buf[i])
    i += 1
  end
  return sb_to_string(sb)
end

def _comp_find(prefix: String): Vec<String>
  var m = vec_new<String>()
  if str_byte_len(prefix) == 0
    return m
  end
  # Commands
  if str_byte_at(prefix, 0) == ':'
    var cmds = vec_new<String>()
    cmds.push(":help")
    cmds.push(":quit")
    cmds.push(":q")
    cmds.push(":clear")
    cmds.push(":reset")
    cmds.push(":state")
    cmds.push(":type")
    cmds.push(":time")
    cmds.push(":vars")
    cmds.push(":load")
    cmds.push(":doc")
    var i = 0
    while i < cmds.size
      if str_starts_with(cmds[i], prefix) == 1 and cmds[i] != prefix
        m.push(cmds[i])
      end
      i += 1
    end
    return m
  end
  # Keywords + builtins
  var words = vec_new<String>()
  words.push("def")
  words.push("end")
  words.push("if")
  words.push("else")
  words.push("elsif")
  words.push("while")
  words.push("for")
  words.push("in")
  words.push("do")
  words.push("return")
  words.push("var")
  words.push("struct")
  words.push("enum")
  words.push("match")
  words.push("import")
  words.push("trait")
  words.push("impl")
  words.push("true")
  words.push("false")
  words.push("nil")
  words.push("and")
  words.push("or")
  words.push("not")
  words.push("break")
  words.push("continue")
  words.push("puts")
  words.push("print")
  words.push("print_int")
  words.push("str_from_int")
  words.push("str_byte_len")
  words.push("str_byte_at")
  words.push("str_byte_slice")
  words.push("str_concat")
  words.push("str_split")
  words.push("str_trim")
  words.push("str_starts_with")
  words.push("str_ends_with")
  words.push("str_replace")
  words.push("str_from_char")
  words.push("vec_new")
  words.push("vec_push")
  words.push("vec_get")
  words.push("vec_set")
  words.push("vec_pop")
  words.push("vec_size")
  words.push("sb_new")
  words.push("sb_append")
  words.push("sb_to_string")
  words.push("map_new")
  words.push("map_set")
  words.push("map_get")
  words.push("map_has")
  words.push("read_file")
  words.push("write_file")
  words.push("file_exists")
  words.push("time_mono_ns")
  words.push("str_contains")
  words.push("str_byte_find")
  words.push("sb_append_char")
  words.push("str_to_int")
  words.push("as_int")
  words.push("as_string")
  var i = 0
  while i < words.size
    if str_starts_with(words[i], prefix) == 1 and words[i] != prefix
      m.push(words[i])
    end
    i += 1
  end
  # Dynamic: user-defined names from preamble
  var pnames = _extract_preamble_names()
  i = 0
  while i < pnames.size
    if str_starts_with(pnames[i], prefix) == 1 and pnames[i] != prefix
      m.push(pnames[i])
    end
    i += 1
  end
  return m
end

# Commands
def _cmd_help(): Void
  puts(_bold("Quartz REPL v" + REPL_VERSION))
  puts("")
  puts("  " + _bright_blue(":help") + "          Show this help")
  puts("  " + _bright_blue(":quit") + " " + _dim("(:q)") + "    Exit")
  puts("  " + _bright_blue(":clear") + "         Clear all state")
  puts("  " + _bright_blue(":reset") + "         Clear all state")
  puts("  " + _bright_blue(":state") + "         Show raw preamble")
  puts("  " + _bright_blue(":vars") + "          List definitions")
  puts("  " + _bright_blue(":type <expr>") + "   Infer type")
  puts("  " + _bright_blue(":time <expr>") + "   Time execution")
  puts("  " + _bright_blue(":load <file>") + "   Load source file")
  puts("  " + _bright_blue(":doc <name>") + "    Show documentation")
  puts("")
  puts(_dim("Tab") + " complete | " + _dim("Ctrl-R") + " search | " + _dim("Alt-B/F") + " word nav")
  puts(_dim("Up/Down") + " history | " + _dim("Ctrl-D") + " exit")
end

def _cmd_vars(): Void
  if str_byte_len(_preamble) == 0
    puts(_dim("(no definitions)"))
    return
  end
  var interner = string_intern::intern_global()
  var lex = lexer::lexer_tokenize(_preamble, interner)
  var types = lex.get_types()
  var lexemes = lex.get_lexemes()
  var count = lex.token_count()
  var i = 0
  while i < count - 1
    var tt = types[i]
    if tt == _TK_DEF or tt == _TK_STRUCT or tt == _TK_ENUM or tt == _TK_TRAIT or tt == _TK_VAR or tt == _TK_CONST
      var next_tt = types[i + 1]
      if next_tt == _TK_IDENT
        var kind = "def"
        if tt == _TK_STRUCT
          kind = "struct"
        end
        if tt == _TK_ENUM
          kind = "enum"
        end
        if tt == _TK_TRAIT
          kind = "trait"
        end
        if tt == _TK_VAR
          kind = "var"
        end
        if tt == _TK_CONST
          kind = "const"
        end
        var name = intern_resolve_int(interner, lexemes[i + 1])
        puts("  " + _bright_blue(kind) + " " + name)
      end
    end
    i += 1
  end
end

def _cmd_load(path: String): Void
  if str_byte_len(path) == 0
    puts(_red("Usage: :load <file>"))
    return
  end
  if fio_exists(path) == false
    puts(_red("File not found: " + path))
    return
  end
  var content = fio_read(path)
  var r = _eval_def(content)
  if str_byte_len(r) > 0
    puts(r)
  else
    puts(_green("Loaded: " + path))
  end
end

def _cmd_doc(name: String): Void
  if str_byte_len(name) == 0
    puts(_red("Usage: :doc <name>"))
    return
  end
  var doc = _builtin_doc(name)
  if str_byte_len(doc) > 0
    puts("  " + _bold(name) + " — " + doc)
    return
  end
  if str_byte_len(_preamble) > 0 and str_contains(_preamble, name) == 1
    puts("  " + _bold(name) + " — " + _dim("(user-defined)"))
    return
  end
  puts(_dim("No documentation for '" + name + "'"))
end

def _builtin_doc(name: String): String
  if name == "puts"
    return "Print string with newline"
  end
  if name == "print"
    return "Print string without newline"
  end
  if name == "print_int"
    return "Print integer with newline"
  end
  if name == "str_from_int"
    return "Convert Int to String"
  end
  if name == "str_byte_len"
    return "Length of string in bytes"
  end
  if name == "str_byte_at"
    return "Byte at index in string"
  end
  if name == "str_byte_slice"
    return "Substring from start to end index"
  end
  if name == "str_concat"
    return "Concatenate two strings"
  end
  if name == "str_split"
    return "Split string by delimiter"
  end
  if name == "str_trim"
    return "Remove leading/trailing whitespace"
  end
  if name == "str_starts_with"
    return "Check if string starts with prefix (1/0)"
  end
  if name == "str_ends_with"
    return "Check if string ends with suffix (1/0)"
  end
  if name == "str_replace"
    return "Replace first occurrence in string"
  end
  if name == "str_contains"
    return "Check if string contains substring (1/0)"
  end
  if name == "str_from_char"
    return "Create single-character string from byte value"
  end
  if name == "str_to_int"
    return "Parse string as integer"
  end
  if name == "vec_new"
    return "Create new empty vector"
  end
  if name == "vec_push"
    return "Append element to vector"
  end
  if name == "vec_set"
    return "Set element at index"
  end
  if name == "vec_pop"
    return "Remove last element"
  end
  if name == "sb_new"
    return "Create new string builder"
  end
  if name == "sb_append"
    return "Append string to builder"
  end
  if name == "sb_to_string"
    return "Convert builder to string"
  end
  if name == "map_new"
    return "Create new map"
  end
  if name == "map_set"
    return "Set key-value pair"
  end
  if name == "map_get"
    return "Get value by key (Option)"
  end
  if name == "map_has"
    return "Check if key exists (Bool)"
  end
  if name == "read_file"
    return "Read entire file as string"
  end
  if name == "write_file"
    return "Write string to file"
  end
  if name == "file_exists"
    return "Check if file exists (Bool)"
  end
  if name == "time_mono_ns"
    return "Monotonic clock in nanoseconds"
  end
  return ""
end

def _cmd_type(expr: String): Void
  if str_byte_len(expr) == 0
    puts(_red("Usage: :type <expr>"))
    return
  end
  var src = _make_prog("print_int(" + expr + ")")
  var r = _compile_run(src)
  if str_starts_with(r, "Error:") == 0
    puts(_bright_cyan("Int"))
    return
  end
  src = _make_prog("puts(" + expr + ")")
  r = _compile_run(src)
  if str_starts_with(r, "Error:") == 0
    puts(_bright_cyan("String"))
    return
  end
  src = _make_prog("if " + expr + "\n    return 0\n  end")
  r = _compile_run(src)
  if str_starts_with(r, "Error:") == 0
    puts(_bright_cyan("Bool"))
    return
  end
  src = _make_prog(expr)
  r = _compile_run(src)
  if str_starts_with(r, "Error:") == 0
    puts(_bright_cyan("Void"))
    return
  end
  puts(_red("Could not determine type"))
end

def _cmd_time(expr: String): Void
  if str_byte_len(expr) == 0
    puts(_red("Usage: :time <expr>"))
    return
  end
  var body = "var _t0 = time_mono_ns()\n  " + expr + "\n  var _t1 = time_mono_ns()\n  print_int(_t1 - _t0)"
  var src = _make_prog(body)
  var r = _compile_run(src)
  if str_starts_with(r, "Error:") == 1
    puts(r)
    return
  end
  var ns = str_to_int(str_trim(r))
  if ns < 1000000
    puts(_yellow(str_from_int(ns / 1000) + " us"))
  elsif ns < 1000000000
    puts(_yellow(str_from_int(ns / 1000000) + " ms"))
  else
    puts(_yellow(str_from_int(ns / 1000000000) + " s"))
  end
end

def _handle_cmd(cmd: String): Int
  if cmd == ":quit" or cmd == ":q"
    return -1
  end
  if cmd == ":help"
    _cmd_help()
    return 1
  end
  if cmd == ":clear" or cmd == ":reset"
    _preamble = ""
    puts(_green("State cleared."))
    return 1
  end
  if cmd == ":state"
    if str_byte_len(_preamble) == 0
      puts(_dim("(no accumulated state)"))
    else
      puts(_highlight(_preamble))
    end
    return 1
  end
  if cmd == ":vars"
    _cmd_vars()
    return 1
  end
  if str_starts_with(cmd, ":type ") == 1
    _cmd_type(str_trim(str_byte_slice(cmd, 6, str_byte_len(cmd))))
    return 1
  end
  if str_starts_with(cmd, ":time ") == 1
    _cmd_time(str_trim(str_byte_slice(cmd, 6, str_byte_len(cmd))))
    return 1
  end
  if str_starts_with(cmd, ":load ") == 1
    _cmd_load(str_trim(str_byte_slice(cmd, 6, str_byte_len(cmd))))
    return 1
  end
  if str_starts_with(cmd, ":doc ") == 1
    _cmd_doc(str_trim(str_byte_slice(cmd, 5, str_byte_len(cmd))))
    return 1
  end
  puts(_red("Unknown command: " + cmd))
  return 1
end

# Process input
def _format_elapsed(ns: Int): String
  if ns < 1000000
    return ""
  end
  var ms = ns / 1000000
  return "  " + _dim("(" + str_from_int(ms) + "ms)")
end

def _process(input: String): Void
  var trimmed = str_trim(input)
  if str_byte_len(trimmed) == 0
    return
  end
  _hist_add(trimmed)
  var kind = _classify(trimmed)
  if kind == 2
    var r = _handle_cmd(trimmed)
    if r < 0
      _running = 0
    end
    return
  end
  var t0 = time_mono_ns()
  if kind == 1
    var r = _eval_def(trimmed)
    var t1 = time_mono_ns()
    var elapsed = _format_elapsed(t1 - t0)
    if str_byte_len(r) > 0
      puts(r)
    else
      puts(_green("Defined.") + elapsed)
    end
    return
  end
  var r = _eval_expr(trimmed)
  var t1 = time_mono_ns()
  var elapsed = _format_elapsed(t1 - t0)
  if str_byte_len(r) > 0
    var type_suffix = ""
    if str_byte_len(_last_type) > 0 and str_starts_with(r, "Error:") == 0
      type_suffix = "  " + _dim(_cyan(": " + _last_type))
    end
    puts("=> " + r + type_suffix + elapsed)
  end
end

# Raw-mode line editor
def _read_line_raw(prompt: String): String
  _buf_clear()
  _cursor = 0
  _hist_index = _history.size
  _hist_saved = ""
  _redraw(prompt)

  while true
    var key = _read_key()
    if key < 0
      return ":quit"
    end
    # Bracketed paste mode
    if key == _KEY_PASTE_START
      _paste_mode = 1
      continue
    end
    if key == _KEY_PASTE_END
      _paste_mode = 0
      _redraw(prompt)
      continue
    end
    # Reverse search mode
    if _search_mode == 1
      if key == '\r' or key == '\n'
        _search_exit(1)
        print("\r\n")
        return _buf_str()
      end
      if key == 27 or key == 7
        _search_exit(0)
        _redraw(prompt)
        continue
      end
      if key == 18
        if _search_idx > 0
          var found = _search_find(_search_query, _search_idx - 1)
          if found >= 0
            _search_idx = found
          end
        end
        _search_redraw()
        continue
      end
      if key == 127 or key == 8
        if str_byte_len(_search_query) > 0
          _search_query = str_byte_slice(_search_query, 0, str_byte_len(_search_query) - 1)
          _search_idx = _search_find(_search_query, _history.size - 1)
        end
        _search_redraw()
        continue
      end
      if key >= ' ' and key < 127
        _search_query = _search_query + str_from_char(key)
        var found = _search_find(_search_query, _search_idx)
        if found >= 0
          _search_idx = found
        end
        _search_redraw()
        continue
      end
      _search_exit(1)
      _redraw(prompt)
    end
    if key == '\r' or key == '\n'
      print("\r\n")
      return _buf_str()
    end
    if key == 3
      print("^C\r\n")
      return ""
    end
    if key == 4
      if _edit_buf.size == 0
        return ":quit"
      end
      _buf_del_at()
      _redraw(prompt)
      continue
    end
    if key == 127 or key == 8
      _buf_del_back()
      _redraw(prompt)
      continue
    end
    if key == _KEY_DELETE
      _buf_del_at()
      _redraw(prompt)
      continue
    end
    if key == _KEY_LEFT or key == 2
      if _cursor > 0
        _cursor -= 1
        _redraw(prompt)
      end
      continue
    end
    if key == _KEY_RIGHT or key == 6
      if _cursor < _edit_buf.size
        _cursor += 1
        _redraw(prompt)
      end
      continue
    end
    if key == 1 or key == _KEY_HOME
      _cursor = 0
      _redraw(prompt)
      continue
    end
    if key == 5 or key == _KEY_END
      _cursor = _edit_buf.size
      _redraw(prompt)
      continue
    end
    if key == 11
      while _edit_buf.size > _cursor
        vec_pop(_edit_buf)
      end
      _redraw(prompt)
      continue
    end
    if key == 21
      # Kill to start: shift remaining chars to front
      var keep = _edit_buf.size - _cursor
      var src_i = _cursor
      var dst_i = 0
      while dst_i < keep
        vec_set(_edit_buf, dst_i, _edit_buf[src_i])
        src_i = src_i + 1
        dst_i = dst_i + 1
      end
      while _edit_buf.size > keep
        vec_pop(_edit_buf)
      end
      _cursor = 0
      _redraw(prompt)
      continue
    end
    if key == 23
      if _cursor > 0
        while _cursor > 0 and _edit_buf[_cursor - 1] == ' '
          _buf_del_back()
        end
        while _cursor > 0
          var c = _edit_buf[_cursor - 1]
          if c == ' '
            break
          end
          _buf_del_back()
        end
        _redraw(prompt)
      end
      continue
    end
    # Ctrl-R: reverse history search
    if key == 18
      _search_enter()
      continue
    end
    # Word navigation
    if key == _KEY_ALT_B or key == _KEY_CTRL_LEFT
      _word_back()
      _redraw(prompt)
      continue
    end
    if key == _KEY_ALT_F or key == _KEY_CTRL_RIGHT
      _word_fwd()
      _redraw(prompt)
      continue
    end
    if key == 12
      print(str_concat(str_concat(str_from_char(27), "[2J"), str_concat(str_from_char(27), "[H")))
      _redraw(prompt)
      continue
    end
    if key == _KEY_UP or key == 16
      if _hist_index > 0
        if _hist_index == _history.size
          _hist_saved = _buf_str()
        end
        _hist_index -= 1
        _buf_set(_history[_hist_index])
        _redraw(prompt)
      end
      continue
    end
    if key == _KEY_DOWN or key == 14
      if _hist_index < _history.size
        _hist_index += 1
        if _hist_index == _history.size
          _buf_set(_hist_saved)
        else
          _buf_set(_history[_hist_index])
        end
        _redraw(prompt)
      end
      continue
    end
    if key == '\t'
      var prefix = _comp_prefix()
      if str_byte_len(prefix) > 0
        var matches = _comp_find(prefix)
        if matches.size == 1
          var plen = str_byte_len(prefix)
          var i = plen
          while i < str_byte_len(matches[0])
            _buf_ins(str_byte_at(matches[0], i))
            i += 1
          end
          _redraw(prompt)
        elsif matches.size > 1
          print("\r\n")
          var i = 0
          while i < matches.size
            print("  " + _dim(matches[i]))
            i += 1
          end
          print("\r\n")
          _redraw(prompt)
        end
      end
      continue
    end
    if key >= ' ' and key < 127
      _buf_ins(key)
      if _paste_mode == 0
        _redraw(prompt)
      end
    end
  end
  return ""
end

# Setup helpers
def _find_lli(): String
  var env_lli = getenv("QUARTZ_LLI")
  if str_byte_len(env_lli) > 0
    return env_lli
  end
  if fio_exists("/opt/homebrew/opt/llvm/bin/lli")
    return "/opt/homebrew/opt/llvm/bin/lli"
  end
  if fio_exists("/opt/homebrew/opt/llvm@20/bin/lli")
    return "/opt/homebrew/opt/llvm@20/bin/lli"
  end
  if fio_exists("/usr/bin/lli")
    return "/usr/bin/lli"
  end
  if fio_exists("/usr/lib/llvm-20/bin/lli")
    return "/usr/lib/llvm-20/bin/lli"
  end
  if fio_exists("/usr/lib/llvm-19/bin/lli")
    return "/usr/lib/llvm-19/bin/lli"
  end
  if fio_exists("/usr/lib/llvm-18/bin/lli")
    return "/usr/lib/llvm-18/bin/lli"
  end
  return ""
end

# Main entry point
def repl_main(): Int
  _stdin_handle = open_file("/dev/stdin", "r")

  _compiler = argv(0)
  _lli = _find_lli()
  if str_byte_len(_lli) == 0
    puts("Error: Cannot find lli (LLVM interpreter)")
    puts("Set QUARTZ_LLI=/path/to/lli or install LLVM")
    return 1
  end

  var stdlib_env = getenv("QUARTZ_STDLIB_PATH")
  if str_byte_len(stdlib_env) > 0
    _stdlib_path = stdlib_env
  end

  var home = getenv("HOME")
  if str_byte_len(home) > 0
    _hist_path = home + "/.quartz_history"
    _hist_load()
  end

  if isatty(0) != 0
    _is_tty = 1
  end

  puts(_bold("Quartz REPL") + " " + _dim("v" + REPL_VERSION))
  if _is_tty == 1
    var w = str_from_int(_term_width())
    var h = str_from_int(_term_height())
    puts(_dim("lli: " + _lli + " | " + w + "x" + h))
  end
  puts(_dim("Type :help for commands, :quit to exit"))
  puts("")

  if _is_tty == 1
    _raw_enter()

    var multi_buf = ""
    var in_multi = 0
    var multi_line_num = 0
    while _running == 1
      var prompt = ""
      if in_multi == 1
        multi_line_num += 1
        prompt = _dim(str_from_int(multi_line_num) + ". ")
      else
        prompt = _bold(_bright_green("qz")) + _dim("> ")
      end

      var line = _read_line_raw(prompt)
      if str_byte_len(line) == 0 and in_multi == 0
        continue
      end

      if in_multi == 1
        multi_buf = multi_buf + "\n" + line
        if _block_depth(multi_buf) <= 0
          _raw_exit()
          _process(multi_buf)
          if _running == 1
            _raw_enter()
          end
          multi_buf = ""
          in_multi = 0
          multi_line_num = 0
        end
        continue
      end

      if _block_depth(line) > 0
        multi_buf = line
        in_multi = 1
        multi_line_num = 1
        continue
      end

      _raw_exit()
      _process(line)
      if _running == 1
        _raw_enter()
      end
    end

    _raw_exit()
  else
    # Line mode for piped input
    var multi_buf = ""
    var in_multi = 0
    while _running == 1
      if in_multi == 1
        print("..> ")
      else
        print("qz> ")
      end
      var line = file_read_line(_stdin_handle)
      if str_byte_len(line) == 0 and in_multi == 0
        _running = 0
        continue
      end
      if in_multi == 1
        multi_buf = multi_buf + "\n" + line
        if _block_depth(multi_buf) <= 0
          _process(multi_buf)
          multi_buf = ""
          in_multi = 0
        end
        continue
      end
      if _block_depth(line) > 0
        multi_buf = line
        in_multi = 1
        continue
      end
      _process(line)
    end
  end

  _hist_save()
  puts("Goodbye!")
  return 0
end
