##! # Element Width Utilities
##!
##! Maps Quartz type names to byte widths and LLVM IR types
##! for width-specialized collection storage.
##!
##! Thin wrappers over the unified scalar-width table in `layout.qz` (B.10
##! Phase 0) — values are identical to the legacy table they replaced.
##!
##! @see layout layout_scalar_* (the single authority)
##! @since 2.0.0

import layout

## Returns the byte width for a collection element type.
## Narrow types (U8, I8, Bool) return 1, wide types (Int, String) return 8.
def elem_byte_width(type_name: String): Int = layout::layout_scalar_size(type_name)

## Returns the LLVM IR type string for a collection element type.
def elem_llvm_type(type_name: String): String = layout::layout_scalar_llvm(type_name)

## Returns 1 if the element type is signed (requires sext instead of zext).
def elem_is_signed(type_name: String): Int = layout::layout_scalar_is_signed(type_name)

## Returns 1 if the type name represents a narrow (sub-i64) element type.
def elem_is_narrow(type_name: String): Int
  return 1 if layout::layout_scalar_size(type_name) < 8
  return 0
end

## Returns 1 if the element type is a floating-point type.
def elem_is_float(type_name: String): Int = layout::layout_scalar_is_float(type_name)
