##! # Layout — representation kinds & the LayoutDescriptor
##!
##! Single source of truth for how a Quartz type is laid out in memory.
##! Part of the B.10 value-types epic (see `docs/design/MEMORY_MODEL_V3.md`).
##!
##! Phase 0 is pure plumbing: every struct descriptor reports today's exact
##! `Boxed` representation ({ Boxed, 8*field_count, 8, index-addressed }), and
##! the scalar table reproduces the legacy `elem_width` values byte-for-byte.
##! Nothing here changes emitted IR — it only makes representation *expressible*.
##!
##! @see mir mir_struct_layout_descriptor (compute-on-demand over the registry)
##! @see elem_width thin scalar-width wrappers that delegate here
##! @since 5.25.0-alpha

# ============================================================================
# Representation kinds (the struct/type "kind" axis — V3 §3.2)
# ============================================================================

## Default — heap i64-array, compiler-owned layout. Today's universal model.
const LAYOUT_BOXED = 0

## `@value` — inline storage, value semantics, computed field offsets.
## Produced starting Phase 2; never in Phase 0.
const LAYOUT_VALUE = 1

## `@repr(C)` — byte-level C-ABI-faithful layout. The FFI vehicle (Phase 3).
const LAYOUT_REPR_C = 2

## `packed struct(uN)` — bit-level, integer-backed named bit fields (shipped DSL).
const LAYOUT_PACKED_BITS = 3

## Sentinel for "layout not yet resolved" — collapses to Boxed at generalization
## (levity restriction, V3 §2). Never escapes into emitted code.
const LAYOUT_UNRESOLVED = -1

# ============================================================================
# LayoutDescriptor — positional array [repr_kind, size_bytes, align_bytes, field_offsets]
#
# Follows the struct-registry's positional-array idiom (no new struct type to
# register / round-trip through the qzmod cache). field_offsets is a Vec<Int>
# of per-field BYTE offsets (or bit offsets for PackedBits). In Phase 0 the
# offsets are informational only — the emit path still uses index-addressing.
# ============================================================================

## Build a descriptor. `field_offsets` is a Vec<Int>.
def layout_desc_new(repr_kind: Int, size_bytes: Int, align_bytes: Int, field_offsets: Vec): Vec
  return [repr_kind, size_bytes, align_bytes, field_offsets]
end

## Representation kind (LAYOUT_*).
def layout_desc_kind(d: Vec): Int = d[0]

## Padded total size in bytes.
def layout_desc_size(d: Vec): Int = d[1]

## Alignment in bytes.
def layout_desc_align(d: Vec): Int = d[2]

## Per-field byte offsets (Vec<Int>).
def layout_desc_offsets(d: Vec): Vec = d[3]

## Byte offset of field `i` (-1 if out of range).
def layout_desc_field_offset(d: Vec, i: Int): Int
  var offs = d[3]
  return -1 if i < 0
  return -1 if i >= vec_size(offs)
  return offs[i]
end

## Levity restriction (V3 §2): a binding's layout must never be an unresolved
## variable. Collapse an unresolved kind to Boxed so existing polymorphic code
## only ever sees boxed values. Wired into type generalization in Phase 1, when
## layouts first become able to vary; in Phase 0 nothing is ever unresolved.
def layout_resolve_or_boxed(repr_kind: Int): Int
  return LAYOUT_BOXED if repr_kind == LAYOUT_UNRESOLVED
  return repr_kind
end

# ============================================================================
# Scalar width table — the single authority behind elem_width.qz
#
# Seeded with the EXACT legacy elem_width values (incl. F32=4) so the delegating
# wrappers are byte-for-byte identical. NOTE a pre-existing divergence: this
# table sizes F32 at 4 bytes, but mir_sizeof_type has no F32/F64 branch and
# returns 8 — left unchanged in Phase 0 (fixing it is a behavior change), filed
# for Phase 1 where unboxed scalars get real treatment.
# ============================================================================

## Byte width for a scalar/element type name. Narrow types < 8; default 8.
def layout_scalar_size(type_name: String): Int
  return 1 if type_name == "U8"
  return 1 if type_name == "I8"
  return 1 if type_name == "Bool"
  return 2 if type_name == "U16"
  return 2 if type_name == "I16"
  return 4 if type_name == "U32"
  return 4 if type_name == "I32"
  return 4 if type_name == "F32"
  return 8
end

## LLVM IR scalar type string for an element type name.
def layout_scalar_llvm(type_name: String): String
  return "i8" if type_name == "U8"
  return "i8" if type_name == "I8"
  return "i8" if type_name == "Bool"
  return "i16" if type_name == "U16"
  return "i16" if type_name == "I16"
  return "i32" if type_name == "U32"
  return "i32" if type_name == "I32"
  return "float" if type_name == "F32"
  return "i64"
end

## 1 if the scalar type is signed (needs sext, not zext).
def layout_scalar_is_signed(type_name: String): Int
  return 1 if type_name == "I8"
  return 1 if type_name == "I16"
  return 1 if type_name == "I32"
  return 0
end

## 1 if the scalar type is floating-point.
def layout_scalar_is_float(type_name: String): Int
  return 1 if type_name == "F32"
  return 1 if type_name == "F64"
  return 0
end
