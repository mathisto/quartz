##! # String Compatibility Helpers
##!
##! Pure-Quartz implementations of str_find and vec_pop that return Int
##! sentinels (-1 or 0). Used during Phase 8 bootstrap to decouple the
##! compiler from intrinsics whose return types are changing from Int to
##! Option<T>.
##!
##! These functions use only stable intrinsics (str_byte_at,
##! str_byte_len, str_eq, load, store, ptr_add) so any generation can
##! compile them.

## Find index of single character in string. Returns -1 if not found.
def __char_index(s: String, ch: Int): Int
  var len = str_byte_len(s)
  for i in 0..len
    if str_byte_at(s, i) == ch
      return i
    end
  end
  return -1
end

## Find index of substring in string. Returns -1 if not found.
def __str_index(s: String, sub: String): Int
  var slen = str_byte_len(s)
  var sublen = str_byte_len(sub)
  if sublen == 0
    return 0
  end
  if sublen > slen
    return -1
  end
  var limit = slen - sublen + 1
  for i in 0..limit
    var found = 1
    for j in 0..sublen
      if str_byte_at(s, i + j) != str_byte_at(sub, j)
        found = 0
      end
    end
    if found == 1
      return i
    end
  end
  return -1
end

## Returns true if substring is found in string.
def __str_contains(s: String, sub: String): Bool = __str_index(s, sub) >= 0

## Find index of substring starting at `start`. Returns -1 if not found.
## Allocation-free alternative to `str_byte_slice(s, start, len(s))` followed
## by `__str_index(slice, sub)`. The slice form was the dominant allocator
## in `cg_emit_extern_declarations` (B.1 Phase 5.D arena attribution showed
## 1.38 GB cumulative slice cost across ~200 extern-name lookups against
## the ~80 MB IR text). This direct-search form skips the slice entirely.
def __str_index_from(s: String, sub: String, start: Int): Int
  var slen = str_byte_len(s)
  var sublen = str_byte_len(sub)
  if sublen == 0
    return start
  end
  if sublen > slen - start
    return -1
  end
  var limit = slen - sublen + 1
  var i = start
  if i < 0
    i = 0
  end
  while i < limit
    var found = 1
    for j in 0..sublen
      if str_byte_at(s, i + j) != str_byte_at(sub, j)
        found = 0
      end
    end
    if found == 1
      return i
    end
    i += 1
  end
  return -1
end

## Returns 1 if `prefix` matches `s` starting at offset `at`, else 0.
## Allocation-free alternative to `str_starts_with(str_byte_slice(s, at, end), prefix)`.
def __str_starts_with_at(s: String, prefix: String, at: Int): Int
  var slen = str_byte_len(s)
  var plen = str_byte_len(prefix)
  if at < 0
    return 0
  end
  if at + plen > slen
    return 0
  end
  for i in 0..plen
    if str_byte_at(s, at + i) != str_byte_at(prefix, i)
      return 0
    end
  end
  return 1
end

## B.1 Phase 5.E: StringBuilder-scan equivalent of `__str_index_from`. Reads
## bytes via `sb_byte_at` so the caller can pass master_out (a StringBuilder
## allocated on the default heap, outside the cg_arena) without first
## materializing it as a String. Eliminates the ~80 MB in-arena
## `out.to_string()` copy that `cg_emit_extern_declarations` previously
## required.
def __sb_index_from(sb: Int, sub: String, start: Int): Int
  var slen = sb_size(sb)
  var sublen = str_byte_len(sub)
  if sublen == 0
    return start
  end
  if sublen > slen - start
    return -1
  end
  var limit = slen - sublen + 1
  var i = start
  if i < 0
    i = 0
  end
  while i < limit
    var found = 1
    for j in 0..sublen
      if sb_byte_at(sb, i + j) != str_byte_at(sub, j)
        found = 0
      end
    end
    if found == 1
      return i
    end
    i += 1
  end
  return -1
end

## B.1 Phase 5.E: StringBuilder-scan equivalent of `__str_starts_with_at`.
def __sb_starts_with_at(sb: Int, prefix: String, at: Int): Int
  var slen = sb_size(sb)
  var plen = str_byte_len(prefix)
  if at < 0
    return 0
  end
  if at + plen > slen
    return 0
  end
  for i in 0..plen
    if sb_byte_at(sb, at + i) != str_byte_at(prefix, i)
      return 0
    end
  end
  return 1
end

## B.1 Phase 5.E: StringBuilder-scan equivalent of `str_contains` (returns Int
## sentinel rather than Bool to match the call-site pattern in
## `cg_emit_extern_declarations`'s extern-var loop).
def __sb_contains(sb: Int, sub: String): Int
  return 1 if __sb_index_from(sb, sub, 0) >= 0
  return 0
end

## Returns true if character is found in string.
def __char_contains(s: String, ch: Int): Bool = __char_index(s, ch) >= 0

## Vec pop with sentinel (returns 0 if empty, else last element).
## Decrements size. Vec layout: [cap(i64), size(i64), data_ptr(i64), elem_width(i64)]
## NOTE: load(ptr, offset) and store(ptr, offset, val) use i64 element offsets.
def __vec_pop_raw(v: Int): Int
  var sz = load(v, 1)
  if sz <= 0
    return 0
  end
  var data_ptr = load(v, 2)
  var last = sz - 1
  var val = load(data_ptr, last)
  store(v, 1, last)
  return val
end
