## Semantic newtypes for the Quartz self-hosted compiler
##
## These newtypes distinguish different kinds of Int handles used throughout
## the compiler. They exist at compile-time only (existential model — all
## vanish to i64 at runtime).
##
## These newtypes are available for use in compiler function signatures.
## Array indexing unwraps newtypes automatically (tc_unwrap_newtype).
## Vec<Newtype> enforces strict type matching (tc_elem_type_matches).

## AST node handle — index into AstStorage arrays
newtype AstNodeId = Int

## AST storage handle — an opaque i64 handle to an `ast::AstStorage`. Lives
## here (not as `ast::AstStorage`) because `compiler_types.qz` cannot import
## `ast` without a module cycle; the sanctioned newtype names the handle
## without the import. (B.15d/N3.1 step-4c — closes the forced-Int corner: a
## newtype read is no longer bare TYPE_INT, so the nil/bare-Int wall exempts it.)
newtype AstStore = Int

## Type system identifier (TYPE_INT, TYPE_STRING, TYPE_STRUCT, etc.)
newtype TypeId = Int

## MIR virtual register number
newtype MirReg = Int

## MIR basic block label
newtype MirLabel = Int

## Resolver entry — one function/struct/enum/trait/impl collected by the resolver.
## Stored in all_funcs throughout the compilation pipeline.
struct ResolverEntry
  ast_store: AstStore
  node_id: AstNodeId
  name: String
  tag: Int
end

## Cache-ro Bug B: wildcard-import canonical-mangling alias map.
##
## When a module is loaded via `import * from M`, its functions still need
## module-qualified LLVM symbols ("module$Cyan", "module$Style$new") so the
## consumer's IR agrees with the cached fragment. The resolver writes the
## canonical name into the function definition and records a bare/half-
## qualified → canonical alias here. `mir_emit_call` consults this map to
## rewrite the LLVM symbol at call-emission time, catching both:
##   - Bare free function calls: "Cyan" → "style$Cyan"
##   - UFCS-canonicalized type-method calls: "Style$new" → "style$Style$new"
##
## Lives here (not in resolver.qz) because mir.qz consumes it and doesn't
## otherwise depend on resolver.qz.
var _ct_func_alias_bare = vec_new<String>()
var _ct_func_alias_canonical = vec_new<String>()

def ct_func_alias_add(bare_name: String, canonical_name: String): Void
  if str_byte_len(bare_name) == 0 or str_byte_len(canonical_name) == 0
    return
  end
  if bare_name == canonical_name
    return
  end
  for i in 0.._ct_func_alias_bare.size
    if _ct_func_alias_bare[i] == bare_name and _ct_func_alias_canonical[i] == canonical_name
      return
    end
  end
  _ct_func_alias_bare.push(bare_name)
  _ct_func_alias_canonical.push(canonical_name)
end

def ct_func_alias_lookup(bare_name: String): String
  for i in 0.._ct_func_alias_bare.size
    if _ct_func_alias_bare[i] == bare_name
      return _ct_func_alias_canonical[i]
    end
  end
  return ""
end

## Module-aware variant. When `module_prefix` defines a function `bare_name`,
## its canonical symbol is "module_prefix$bare_name". Returns that canonical
## iff such an alias was recorded, else "".
##
## This is the fix for IMPORT_STAR_COLLISION_SILENT_SHADOW: the flat
## `ct_func_alias_lookup` is first-wins, so when two wildcard-imported modules
## both register the same bare name (e.g. `_compress` in sha256.qz and
## sha512.qz), every bare call site — *including a module's call to its OWN
## function* — resolved to whichever module registered first. A module's
## internal bare calls must resolve to its own definitions first; callers pass
## the currently-lowering function's module so same-module wins before the flat
## fallback. (Impl/extend method aliases like "Style$new" → "style$Style$new"
## fit the same `prefix$bare` shape, so this covers them too.)
def ct_func_alias_lookup_in_module(bare_name: String, module_prefix: String): String
  return "" if str_byte_len(module_prefix) == 0
  var expected = "#{module_prefix}$#{bare_name}"
  for i in 0.._ct_func_alias_bare.size
    if _ct_func_alias_bare[i] == bare_name and _ct_func_alias_canonical[i] == expected
      return expected
    end
  end
  return ""
end

## Count how many DISTINCT canonical symbols a bare name maps to. >1 means a
## genuine cross-module collision (two wildcard imports shipped the same name).
## Used to surface QZ0404 at ambiguous consumer call sites.
def ct_func_alias_distinct_count(bare_name: String): Int
  var seen = vec_new<String>()
  for i in 0.._ct_func_alias_bare.size
    if _ct_func_alias_bare[i] == bare_name
      var c = _ct_func_alias_canonical[i]
      var found = 0
      for j in 0..seen.size
        if seen[j] == c
          found = 1
        end
      end
      if found == 0
        seen.push(c)
      end
    end
  end
  return seen.size
end

def ct_func_alias_reset(): Void
  _ct_func_alias_bare = vec_new<String>()
  _ct_func_alias_canonical = vec_new<String>()
end

## Remove every alias whose canonical symbol equals `canonical_name`. Used by
## selective imports (`from M import a`) to drop the leaked bare → canonical
## alias that the underlying wildcard temp-load recorded for a NON-selected
## function (A.42 #1): without this, a `from M import a` would still let the
## bare name of a non-imported `M::b` resolve through the global alias map.
def ct_func_alias_remove_canonical(canonical_name: String): Void
  return if str_byte_len(canonical_name) == 0
  var kept_bare = vec_new<String>()
  var kept_canon = vec_new<String>()
  for i in 0.._ct_func_alias_bare.size
    if _ct_func_alias_canonical[i] != canonical_name
      kept_bare.push(_ct_func_alias_bare[i])
      kept_canon.push(_ct_func_alias_canonical[i])
    end
  end
  _ct_func_alias_bare = kept_bare
  _ct_func_alias_canonical = kept_canon
end
