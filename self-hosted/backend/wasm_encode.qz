##! # WASM Binary Encoding Primitives
##!
##! Low-level helpers for emitting WebAssembly binary format:
##! LEB128 integer encoding, IEEE 754 floats, section framing,
##! and WASM opcode constants.
##!
##! Reference: https://webassembly.github.io/spec/core/binary/
##!
##! @see codegen_wasm Main WASM backend
##! @since 5.26.0

# =============================================================================
# Byte buffer operations
# =============================================================================

## Append a single byte (0-255) to the buffer.
def wasm_emit_byte(buf: Vec<Int>, byte: Int): Void
  buf.push(byte)
end

## Append N raw bytes from a source Vec to the buffer.
def wasm_emit_bytes(buf: Vec<Int>, src: Vec<Int>): Void
  var i = 0
  var len = vec_size(src)
  while i < len
    buf.push(vec_get(src, i))
    i += 1
  end
end

## Append the contents of a sub-buffer, then return the sub-buffer size.
def wasm_emit_buf(buf: Vec<Int>, sub: Vec<Int>): Int
  var len = vec_size(sub)
  wasm_emit_bytes(buf, sub)
  return len
end

# =============================================================================
# LEB128 encoding (variable-length integers)
# =============================================================================

## Encode an unsigned 32-bit value as LEB128.
def wasm_emit_u32(buf: Vec<Int>, val: Int): Void
  var v = val
  while true
    var byte = v % 128
    v = v / 128
    if v != 0
      byte = byte + 128
    end
    buf.push(byte)
    if v == 0
      return
    end
  end
end

## Encode a signed 32-bit value as LEB128.
def wasm_emit_i32(buf: Vec<Int>, val: Int): Void
  var v = val
  var more = true
  while more
    var byte = band(v, 127)
    v = _ashr(v, 7)
    if (v == 0 and band(byte, 64) == 0) or (v == -1 and band(byte, 64) != 0)
      more = false
    else
      byte = bor(byte, 128)
    end
    buf.push(byte)
  end
end

## Encode an unsigned 64-bit value as LEB128.
def wasm_emit_u64(buf: Vec<Int>, val: Int): Void
  # Same algorithm as u32 but supports full 64-bit range
  var v = val
  # Handle negative values (treated as large unsigned)
  if v < 0
    # For negative i64 values interpreted as unsigned, we need
    # to emit all 10 bytes of LEB128
    var i = 0
    while i < 9
      var byte = band(v, 127)
      v = shr(v, 7)
      buf.push(bor(byte, 128))
      i += 1
    end
    buf.push(band(v, 1))
    return
  end
  while true
    var byte = band(v, 127)
    v = shr(v, 7)
    if v != 0
      byte = bor(byte, 128)
    end
    buf.push(byte)
    if v == 0
      return
    end
  end
end

## Arithmetic right shift (sign-extending). shr() is logical (zero-fill).
def _ashr(v: Int, n: Int): Int
  if v >= 0
    return shr(v, n)
  end
  # Fill top n bits with 1s after logical shift
  return bor(shr(v, n), shl(-1, 64 - n))
end

## Encode a signed 64-bit value as LEB128.
def wasm_emit_i64(buf: Vec<Int>, val: Int): Void
  var v = val
  var more = true
  while more
    var byte = band(v, 127)
    v = _ashr(v, 7)
    if (v == 0 and band(byte, 64) == 0) or (v == -1 and band(byte, 64) != 0)
      more = false
    else
      byte = bor(byte, 128)
    end
    buf.push(byte)
  end
end

# =============================================================================
# String and name encoding
# =============================================================================

## Encode a UTF-8 name (LEB128 length + bytes).
def wasm_emit_name(buf: Vec<Int>, name: String): Void
  var len = str_byte_len(name)
  wasm_emit_u32(buf, len)
  var i = 0
  while i < len
    buf.push(str_byte_at(name, i))
    i += 1
  end
end

# =============================================================================
# IEEE 754 float encoding
# =============================================================================

## Encode a 64-bit float as 8 bytes little-endian (via bit reinterpretation).
## The caller passes the i64 bit pattern of the f64 value.
def wasm_emit_f64_bits(buf: Vec<Int>, bits: Int): Void
  buf.push(band(bits, 255))
  buf.push(band(shr(bits, 8), 255))
  buf.push(band(shr(bits, 16), 255))
  buf.push(band(shr(bits, 24), 255))
  buf.push(band(shr(bits, 32), 255))
  buf.push(band(shr(bits, 40), 255))
  buf.push(band(shr(bits, 48), 255))
  buf.push(band(shr(bits, 56), 255))
end

# =============================================================================
# Section framing
# =============================================================================

## Emit a WASM section: section ID byte + LEB128 size + content bytes.
def wasm_emit_section(buf: Vec<Int>, section_id: Int, content: Vec<Int>): Void
  buf.push(section_id)
  wasm_emit_u32(buf, vec_size(content))
  wasm_emit_bytes(buf, content)
end

# =============================================================================
# WASM module header
# =============================================================================

## Emit the 8-byte WASM module header (magic + version).
def wasm_emit_header(buf: Vec<Int>): Void
  # Magic: \0asm
  buf.push(0)
  buf.push(97)   # 'a'
  buf.push(115)  # 's'
  buf.push(109)  # 'm'
  # Version: 1
  buf.push(1)
  buf.push(0)
  buf.push(0)
  buf.push(0)
end

# =============================================================================
# Section IDs
# =============================================================================

const WASM_SECTION_TYPE = 1
const WASM_SECTION_IMPORT = 2
const WASM_SECTION_FUNCTION = 3
const WASM_SECTION_TABLE = 4
const WASM_SECTION_MEMORY = 5
const WASM_SECTION_GLOBAL = 6
const WASM_SECTION_EXPORT = 7
const WASM_SECTION_START = 8
const WASM_SECTION_ELEMENT = 9
const WASM_SECTION_CODE = 10
const WASM_SECTION_DATA = 11
const WASM_SECTION_DATA_COUNT = 12

# =============================================================================
# Value types
# =============================================================================

const WASM_TYPE_I32 = 0x7F
const WASM_TYPE_I64 = 0x7E
const WASM_TYPE_F32 = 0x7D
const WASM_TYPE_F64 = 0x7C
const WASM_TYPE_VOID = 0x40
const WASM_TYPE_FUNC = 0x60

# =============================================================================
# Export kinds
# =============================================================================

const WASM_EXPORT_FUNC = 0
const WASM_EXPORT_TABLE = 1
const WASM_EXPORT_MEMORY = 2
const WASM_EXPORT_GLOBAL = 3

# =============================================================================
# Import kinds
# =============================================================================

const WASM_IMPORT_FUNC = 0
const WASM_IMPORT_TABLE = 1
const WASM_IMPORT_MEMORY = 2
const WASM_IMPORT_GLOBAL = 3

# =============================================================================
# Control flow opcodes
# =============================================================================

const WASM_UNREACHABLE = 0x00
const WASM_NOP = 0x01
const WASM_BLOCK = 0x02
const WASM_LOOP = 0x03
const WASM_IF = 0x04
const WASM_ELSE = 0x05
const WASM_END = 0x0B
const WASM_BR = 0x0C
const WASM_BR_IF = 0x0D
const WASM_BR_TABLE = 0x0E
const WASM_RETURN = 0x0F

# =============================================================================
# Call opcodes
# =============================================================================

const WASM_CALL = 0x10
const WASM_CALL_INDIRECT = 0x11

# =============================================================================
# Parametric opcodes
# =============================================================================

const WASM_DROP = 0x1A
const WASM_SELECT = 0x1B

# =============================================================================
# Variable opcodes
# =============================================================================

const WASM_LOCAL_GET = 0x20
const WASM_LOCAL_SET = 0x21
const WASM_LOCAL_TEE = 0x22
const WASM_GLOBAL_GET = 0x23
const WASM_GLOBAL_SET = 0x24

# =============================================================================
# Memory opcodes
# =============================================================================

const WASM_I32_LOAD = 0x28
const WASM_I64_LOAD = 0x29
const WASM_F32_LOAD = 0x2A
const WASM_F64_LOAD = 0x2B
const WASM_I32_STORE = 0x36
const WASM_I64_STORE = 0x37
const WASM_F32_STORE = 0x38
const WASM_F64_STORE = 0x39
const WASM_MEMORY_SIZE = 0x3F
const WASM_MEMORY_GROW = 0x40

# Memory load/store alignment and offset are encoded as LEB128
# after the opcode. For i64.load/store: align=3 (2^3=8 byte aligned)
const WASM_ALIGN_8 = 3
const WASM_ALIGN_4 = 2
const WASM_ALIGN_1 = 0

# =============================================================================
# i32 numeric opcodes
# =============================================================================

const WASM_I32_CONST = 0x41
const WASM_I32_EQZ = 0x45
const WASM_I32_EQ = 0x46
const WASM_I32_NE = 0x47
const WASM_I32_LT_S = 0x48
const WASM_I32_LT_U = 0x49
const WASM_I32_GT_S = 0x4A
const WASM_I32_GT_U = 0x4B
const WASM_I32_LE_S = 0x4C
const WASM_I32_LE_U = 0x4D
const WASM_I32_GE_S = 0x4E
const WASM_I32_GE_U = 0x4F
const WASM_I32_ADD = 0x6A
const WASM_I32_SUB = 0x6B
const WASM_I32_MUL = 0x6C
const WASM_I32_AND = 0x71
const WASM_I32_OR = 0x72
const WASM_I32_SHL = 0x74
const WASM_I32_SHR_U = 0x76

# =============================================================================
# i64 numeric opcodes
# =============================================================================

const WASM_I64_CONST = 0x42
const WASM_I64_EQZ = 0x50
const WASM_I64_EQ = 0x51
const WASM_I64_NE = 0x52
const WASM_I64_LT_S = 0x53
const WASM_I64_LT_U = 0x54
const WASM_I64_GT_S = 0x55
const WASM_I64_GT_U = 0x56
const WASM_I64_LE_S = 0x57
const WASM_I64_LE_U = 0x58
const WASM_I64_GE_S = 0x59
const WASM_I64_GE_U = 0x5A
const WASM_I64_CLZ = 0x79
const WASM_I64_CTZ = 0x7A
const WASM_I64_POPCNT = 0x7B
const WASM_I64_ADD = 0x7C
const WASM_I64_SUB = 0x7D
const WASM_I64_MUL = 0x7E
const WASM_I64_DIV_S = 0x7F
const WASM_I64_DIV_U = 0x80
const WASM_I64_REM_S = 0x81
const WASM_I64_REM_U = 0x82
const WASM_I64_AND = 0x83
const WASM_I64_OR = 0x84
const WASM_I64_XOR = 0x85
const WASM_I64_SHL = 0x86
const WASM_I64_SHR_S = 0x87
const WASM_I64_SHR_U = 0x88
const WASM_I64_ROTL = 0x89
const WASM_I64_ROTR = 0x8A

# =============================================================================
# f64 numeric opcodes
# =============================================================================

const WASM_F64_CONST = 0x44
const WASM_F64_ABS = 0x99
const WASM_F64_NEG = 0x9A
const WASM_F64_CEIL = 0x9B
const WASM_F64_FLOOR = 0x9C
const WASM_F64_TRUNC = 0x9D
const WASM_F64_NEAREST = 0x9E
const WASM_F64_SQRT = 0x9F
const WASM_F64_ADD = 0xA0
const WASM_F64_SUB = 0xA1
const WASM_F64_MUL = 0xA2
const WASM_F64_DIV = 0xA3
const WASM_F64_EQ = 0x61
const WASM_F64_NE = 0x62
const WASM_F64_LT = 0x63
const WASM_F64_GT = 0x64
const WASM_F64_LE = 0x65
const WASM_F64_GE = 0x66
const WASM_F64_MIN = 0xA4
const WASM_F64_MAX = 0xA5

# =============================================================================
# Conversion opcodes
# =============================================================================

const WASM_I32_WRAP_I64 = 0xA7
const WASM_I64_EXTEND_I32_S = 0xAC
const WASM_I64_EXTEND_I32_U = 0xAD
const WASM_F64_CONVERT_I64_S = 0xB9
const WASM_I64_TRUNC_F64_S = 0xB0
const WASM_I64_REINTERPRET_F64 = 0xBD
const WASM_F64_REINTERPRET_I64 = 0xBF

# =============================================================================
# Helper: emit a memory load/store with alignment and offset
# =============================================================================

## Emit i64.load with alignment=3 (8-byte) and given byte offset.
def wasm_emit_i64_load(buf: Vec<Int>, offset: Int): Void
  buf.push(WASM_I64_LOAD)
  wasm_emit_u32(buf, WASM_ALIGN_8)
  wasm_emit_u32(buf, offset)
end

## Emit i64.store with alignment=3 (8-byte) and given byte offset.
def wasm_emit_i64_store(buf: Vec<Int>, offset: Int): Void
  buf.push(WASM_I64_STORE)
  wasm_emit_u32(buf, WASM_ALIGN_8)
  wasm_emit_u32(buf, offset)
end

## Emit i32.load with alignment=2 (4-byte) and given byte offset.
def wasm_emit_i32_load(buf: Vec<Int>, offset: Int): Void
  buf.push(WASM_I32_LOAD)
  wasm_emit_u32(buf, WASM_ALIGN_4)
  wasm_emit_u32(buf, offset)
end

## Emit i32.store with alignment=2 (4-byte) and given byte offset.
def wasm_emit_i32_store(buf: Vec<Int>, offset: Int): Void
  buf.push(WASM_I32_STORE)
  wasm_emit_u32(buf, WASM_ALIGN_4)
  wasm_emit_u32(buf, offset)
end

# =============================================================================
# Bulk memory operations (proposal enabled by default in all modern runtimes)
# =============================================================================

## Emit memory.copy: copy len bytes from src to dst in linear memory.
## Stack: [dst:i32] [src:i32] [len:i32] → []
def wasm_emit_memory_copy(buf: Vec<Int>): Void
  buf.push(0xFC)  # prefix byte
  wasm_emit_u32(buf, 10)  # memory.copy opcode
  wasm_emit_u32(buf, 0)   # dst memory index
  wasm_emit_u32(buf, 0)   # src memory index
end

## Emit memory.fill: fill len bytes at dst with val.
## Stack: [dst:i32] [val:i32] [len:i32] → []
def wasm_emit_memory_fill(buf: Vec<Int>): Void
  buf.push(0xFC)  # prefix byte
  wasm_emit_u32(buf, 11)  # memory.fill opcode
  wasm_emit_u32(buf, 0)   # memory index
end

# =============================================================================
# Type section helpers
# =============================================================================

## Emit a function type: 0x60 + param types + result types.
## arity = number of i64 params, has_result = 1 if returns i64.
def wasm_emit_func_type(buf: Vec<Int>, arity: Int, has_result: Int): Void
  buf.push(WASM_TYPE_FUNC)
  # Param types: all i64
  wasm_emit_u32(buf, arity)
  var i = 0
  while i < arity
    buf.push(WASM_TYPE_I64)
    i += 1
  end
  # Result types
  if has_result == 1
    wasm_emit_u32(buf, 1)
    buf.push(WASM_TYPE_I64)
  else
    wasm_emit_u32(buf, 0)
  end
end
