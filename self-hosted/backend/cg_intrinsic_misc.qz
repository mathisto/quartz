##! # Misc Intrinsics
##!
##! Emits LLVM IR for file system, random, time, and other utility operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat


# ============================================================================
# Misc Intrinsics (17 handlers)
# ============================================================================

def cg_emit_intrinsic_misc(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "file_delete"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 @remove(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "file_size"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_file_size(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "file_mtime"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_file_mtime(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "is_digit"
    var ch = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ge0 = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 48")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".le9 = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 57")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ge0, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".le9")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool to i64")
    return
  end

  if name == "is_alpha"
    var ch = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 65")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".leZ = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 90")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".upper = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".leZ")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 97")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lez = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 122")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lower = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lez")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".upper, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lower")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool to i64")
    return
  end

  if name == "is_whitespace"
    var ch = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sp = icmp eq i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tab = icmp eq i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 9")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nl = icmp eq i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 10")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cr = icmp eq i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 13")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".t1 = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sp, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tab")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".t2 = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nl, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".t1, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".t2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool to i64")
    return
  end

  if name == "is_upper"
    var ch = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 65")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".leZ = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 90")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".leZ")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool to i64")
    return
  end

  if name == "is_lower"
    var ch = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 97")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lez = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 122")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lez")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool to i64")
    return
  end

  if name == "file_exists"
    var args = mir::mir_instr_get_args(instr)
    var path_arg = args[0]
    var path = codegen_util::cg_format_operand(path_arg)
    # Convert path to pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".path = inttoptr i64 ")
    codegen_util::cg_emit(out, path)
    codegen_util::cg_emit_line(out, " to ptr")
    # Call access(path, F_OK) - F_OK is 0
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @access(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".path, i32 0)")
    # Check if access returned 0 (file exists)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".exists = icmp eq i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret, 0")
    # Zero-extend bool to i64
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".exists to i64")
    return
  end

  if name == "file_read_line"
    var handle = args[0]
    var lbl = codegen_util::cg_next_label(state)
    var l = "#{lbl}"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf = alloca [4096 x i8]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr [4096 x i8], [4096 x i8]* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf, i64 0, i64 0")
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call ptr @fgets(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i32 4096, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull, label %frl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, ", label %frl_ok_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "frl_ok_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @strlen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".last = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lastptr = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".last")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lastch = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnl = icmp eq i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastch, 10")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnl, label %frl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, ", label %frl_nostrip_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "frl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  store i8 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 1")
    codegen_util::cg_emit(out, "  br label %frl_nostrip_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "frl_nostrip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flen = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen, %frl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, %frl_ok_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".copy = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flen)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".copy, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flen)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok_val = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".copy to i64")
    codegen_util::cg_emit(out, "  br label %frl_done_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "frl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = call ptr @qz_alloc_str(i64 0)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eof_val = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty to i64")
    codegen_util::cg_emit(out, "  br label %frl_done_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "frl_done_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok_val, %frl_nostrip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eof_val, %frl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "file_write_line"
    var handle = args[0]
    var text = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".txt", text, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @fputs(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".txt, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret to i64")
    return
  end

  if name == "is_alnum"
    var ch = args[0]
    var label = codegen_util::cg_next_label(state)
    # Check digit (48-57)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ge0 = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 48")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".le9 = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 57")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".digit = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ge0, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".le9")
    # Check upper (65-90)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 65")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".leZ = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 90")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".upper = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".geA, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".leZ")
    # Check lower (97-122)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 97")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lez = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, ch)
    codegen_util::cg_emit_line(out, ", 122")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lower = and i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gea, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lez")
    # Combine: digit OR upper OR lower
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".alpha = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".upper, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lower")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".alnum = or i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".digit, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alpha")
    # Extend to i64
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alnum to i64")
    return
  end

  if name == "sleep_ms"
    var ms = args[0]
    codegen_util::cg_emit(out, "  %sl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".us = mul i64 %v")
    codegen_util::cg_emit_int(out, ms)
    codegen_util::cg_emit_line(out, ", 1000")
    codegen_util::cg_emit(out, "  call void @usleep(i64 %sl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".us)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "crypto_rand_int"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @qz_crypto_rand_int()")
    return
  end

  if name == "rand_seed"
    var s = args[0]
    codegen_util::cg_emit(out, "  call void @qz_rand_seed(i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "rand_int"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @qz_rand_int()")
    return
  end

  if name == "rand_range"
    var lo = args[0]
    var hi = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_rand_range(i64 %v")
    codegen_util::cg_emit_int(out, lo)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, hi)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "rand_float"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d = call double @qz_rand_float()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d to i64")
    return
  end

  if name == "time_mono_ns"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @__qz_time_mono_ns()")
    return
  end

  if name == "mem_peak_rss"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @__qz_mem_peak_rss()")
    return
  end

  if name == "mem_current_rss"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @__qz_mem_current_rss()")
    return
  end

  if name == "mem_release"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @__qz_mem_release()")
    return
  end

end
