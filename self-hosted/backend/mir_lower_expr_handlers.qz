##! # MIR Lower Expression Handlers
##!
##! Expression-specific lowering dispatched from mir_lower_expr.
##!
##! @see mir_lower Main MIR lowering module

import mir
import * from mir
import nonescaping_hof
import ast
import op_constants
import node_constants
import type_constants
import token_constants
import diagnostic
import mir_lower_gen
import mir_lower_async_registry
import mir_lower
import * from str_compat
import string_intern

# Counter for unique async_mutex_lock call site IDs (prevents dynamic local name collision)
var _aml_counter = 0
var _select_fairness_id = 0
# Counter for async spill temporaries (values whose lifetime crosses an await point)
var _async_spill_counter = 0

## Returns 1 if a function name is a known suspend point intrinsic.
## These create implicit suspend/resume cycles in async $poll context without
## an explicit NODE_AWAIT, so lowered expressions around them must still spill.
def mir_is_suspending_intrinsic(name: String): Int
  return 1 if name == "recv"
  return 1 if name == "recv_timeout"
  return 1 if name == "sched_sleep"
  return 1 if name == "sched_yield"
  return 1 if name == "channel_recv"
  return 1 if name == "io_suspend"
  return 1 if name == "proc_suspend"
  return 0
end

## item 20 P1/P2 (call-site copy elision) — 1 iff the resolved callee `node_id` in
## `store` is a method whose param 0 is a `self`-named, value-layout struct (≤16B
## flat OR >16B COW, P2 lifted the P1 non-cow restriction) AND whose body directly
## stores `self.<field>`. This is the CALL-SITE twin of
## `mir_func_param0_is_mut_value_receiver` (which sees only the lowered MirFunc): the
## call site lowers BEFORE the callee, so we recompute the verdict straight from the
## callee AST. When 1, the receiver argument must be passed as the ADDRESS of the
## caller's own slot (skip the alloca+per-word value-copy), so the callee — which
## already loads/stores THROUGH param 0 as a pointer (it is decompose-excluded by the
## same predicate, so it receives a single construct-buffer pointer) — mutates the
## caller's live storage in place. P2: COW (>16B) receivers are covered too — the
## same pointer-pass works because mir_emit_value_copy returns the buffer ptr for COW
## (its retain is the only thing skipped), and the callee suppresses its cow_release +
## make-unique under ctx.borrowed_self_receiver, so the in-place mutation persists.
## Gate-0-inert: `mir_is_value_layout_type` is false for plain structs at the F4 flip
## == 0, so this returns 0 ⇒ the call site is byte-identical for non-@value code.
def mir_callee_is_mut_value_receiver(ctx: mir::MirContext, store: ast::AstStorage, node_id: AstNodeId): Int
  return 0 if node_id < 0
  var params = ast::ast_get_left(store, node_id)
  return 0 if params < 0
  return 0 if vec_size(params) == 0
  var p0 = params[0]
  return 0 if ast::ast_get_str1(store, p0).eq("self") == 0
  var p0_ty = ast::ast_get_str2(store, p0)
  return 0 if str_byte_len(p0_ty) == 0
  # Value-layout (gate-0: @value only). item 20 P2: COW (>16B) receivers are now
  # ALSO elided — the call site passes the caller's live buffer pointer WITHOUT a
  # retain (mir_emit_value_copy's cow_rc_inc is skipped along with the word-copy),
  # and the callee skips its scope-exit cow_release + the self.field make-unique, so
  # a borrowed exclusive COW `self` is mutated in place. (P1 bailed on COW here.)
  return 0 if mir::mir_is_value_layout_type(ctx, p0_ty) == 0
  var body = ast::ast_get_right(store, node_id)
  return 0 if body < 0
  return mir_lower::mir_body_assigns_self_field(store, body)
end

## Returns 1 if the expression subtree contains a NODE_AWAIT or a call to a
## known suspending intrinsic. Used to detect cross-suspend value lifetimes in
## binary/call lowering — if the RHS of an operation contains a suspend, the
## LHS SSA value won't be valid after the resume block and must be spilled to
## a generator frame slot.
def mir_expr_contains_await(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node < 0
  var kind = ast::ast_get_kind(s, node)
  # A lambda body is a separate function — an `await` inside it suspends THAT
  # function, not the enclosing one. Never descend into a lambda subtree: its
  # left/right/children slots hold pointer-valued (non-AstNodeId) data and
  # would be misread as array indices → out-of-bounds crash.
  return 0 if kind == node_constants::NODE_LAMBDA
  return 1 if kind == node_constants::NODE_AWAIT
  # Calls to known-suspending intrinsics count as suspend points.
  # Calls that will be COLORLESS-DISPATCHED also count: a call to a function
  # that is both an async target and carries EFFECT_SUSPEND lowers (inside a
  # `$poll` body) via `mir_emit_colorless_call`, which creates suspend/resume
  # blocks — exactly the case where earlier sibling-arg SSA values stop
  # dominating the `cl_done` block. The colorless-dispatch site uses the same
  # `mir_has_effect(_, 2) && mir_is_async_target(_)` predicate; by the time a
  # colorless target's `$poll` body is lowered (PASS 1.3a), PASS 1.2b's
  # effect propagation + the PASS 1.3 auto-registration have both run, so the
  # query is reliable here. A false positive only costs an unneeded spill.
  if kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(s, node)
    if callee > 0
      if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
        var cname = ast::ast_get_str1(s, callee)
        return 1 if mir_is_suspending_intrinsic(cname) == 1
        if mir_lower_async_registry::mir_has_effect(cname, 2)
          if mir_lower_async_registry::mir_is_async_target(cname)
            return 1
          end
        end
      end
    end
  end
  var left = ast::ast_get_left(s, node)
  if left > 0
    return 1 if mir_expr_contains_await(s, left) == 1
  end
  var right = ast::ast_get_right(s, node)
  if right > 0
    return 1 if mir_expr_contains_await(s, right) == 1
  end
  # ast_get_children returns a raw slot that may be 0 (Int) for leaves —
  # only walk it for node kinds known to use the children vec.
  if kind == node_constants::NODE_CALL
    var call_args = ast::ast_get_children(s, node)
    for ca in 0..call_args.size
      return 1 if mir_expr_contains_await(s, call_args[ca]) == 1
    end
  end
  if kind == node_constants::NODE_INTERP_STRING
    var interp_parts = ast::ast_get_children(s, node)
    for ip in 0..interp_parts.size
      return 1 if mir_expr_contains_await(s, interp_parts[ip]) == 1
    end
  end
  return 0
end

## If we're inside an async poll function AND the given node contains an await,
## spill `val` to a fresh generator-frame dynamic local and return a closure-like
## pair (spill_name, val). Caller later reloads via mir_async_reload_if_spilled.
## Returns "" if no spill is needed — reload is a no-op in that case.
def mir_async_spill_if_await(ctx: MirContext, s: ast::AstStorage, may_suspend_node: AstNodeId, val: Int): String
  return "" if mir_lower_gen::mir_gen_is_active() < 2
  return "" if may_suspend_node < 0
  return "" if mir_expr_contains_await(s, may_suspend_node) == 0
  _async_spill_counter = _async_spill_counter + 1
  var spill_name = "__async_spill_#{_async_spill_counter}"
  mir_lower_gen::mir_gen_register_dynamic_local(spill_name)
  ctx.mir_emit_store_var(spill_name, val)
  return spill_name
end

## Reload a value previously spilled via mir_async_spill_if_await.
## If spill_name is empty, returns `fallback` unchanged (no spill happened).
def mir_async_reload_if_spilled(ctx: MirContext, spill_name: String, fallback: Int): Int
  return fallback if str_byte_len(spill_name) == 0
  return ctx.mir_emit_load_var(spill_name)
end

# Lower a block and return the value of its last expression
# Used for if-as-expression and match-as-expression
def mir_lower_block_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)
  
  # NodeBlock = 32 - process all stmts, return last expression value
  if kind == node_constants::NODE_BLOCK
    var stmts = ast::ast_get_children(s, node)
    if stmts == 0
      return ctx.mir_emit_const_int(0)
    end
    var stmt_count = stmts.size
    if stmt_count == 0
      return ctx.mir_emit_const_int(0)
    end

    defer_scope_push(ctx)

    # Lower all statements except the last
    for i in 0..(stmt_count - 1)
      var stmt = stmts[i]
      mir_lower::mir_lower_stmt(ctx, s, stmt)
    end

    # For the last statement, check if it's an expression statement
    var last = stmts[stmt_count - 1]
    var last_kind = ast::ast_get_kind(s, last)

    # NodeExprStmt = 29 - extract and lower the expression
    if last_kind == node_constants::NODE_EXPR_STMT
      var expr_node = ast::ast_get_left(s, last)
      var result = mir_lower::mir_lower_expr(ctx, s, expr_node)
      var cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(cur) < 0
        mir_lower::defer_scope_pop(ctx)
      else
        defer_scope_discard(ctx)
      end
      return result
    end

    # Check if last statement is an expression that can be lowered directly
    # NodeIdent=6, NodeCall=9, NodeBinary=8, NodeIndex=13, NodeIntLit=0, NodeBlock=32, NodeIf=23, NodeMatch=40
    if last_kind == node_constants::NODE_IDENT or last_kind == node_constants::NODE_CALL or last_kind == node_constants::NODE_BINARY or last_kind == node_constants::NODE_INDEX or last_kind == node_constants::NODE_INT_LIT or last_kind == node_constants::NODE_BLOCK or last_kind == node_constants::NODE_IF or last_kind == node_constants::NODE_MATCH
      var result = mir_lower::mir_lower_expr(ctx, s, last)
      var cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(cur) < 0
        mir_lower::defer_scope_pop(ctx)
      else
        defer_scope_discard(ctx)
      end
      return result
    end

    # Otherwise lower as statement and return 0
    mir_lower::mir_lower_stmt(ctx, s, last)
    var cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(cur) < 0
      mir_lower::defer_scope_pop(ctx)
    else
      defer_scope_discard(ctx)
    end
    return ctx.mir_emit_const_int(0)
  end
  
  # Not a block - check for EXPR_STMT wrapper
  if kind == node_constants::NODE_EXPR_STMT
    return mir_lower::mir_lower_expr(ctx, s, ast::ast_get_left(s, node))
  end

  # Return statement - lower as statement (emits TERM_RETURN) and return dummy
  if kind == node_constants::NODE_RETURN
    mir_lower::mir_lower_stmt(ctx, s, node)
    return ctx.mir_emit_const_int(0)
  end

  # Lower directly as expression
  return mir_lower::mir_lower_expr(ctx, s, node)
end

# Lower safe field access (u?.field) into Option check + field access
# Separate function to avoid variable count limit in mir_lower_expr
def mir_lower_safe_field_access(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  # Extract base and field from AST (same slots as NodeFieldAccess)
  var base = ast::ast_get_left(s, node)
  var field = ast::ast_get_str1(s, node)
  
  # Lower base expression (should be Option<Struct>)
  var base_val = mir_lower::mir_lower_expr(ctx, s, base)
  
  # Create blocks for control flow: check -> some/none -> merge
  var check = ctx.mir_create_block("safe_check")
  var some = ctx.mir_create_block("safe_some")
  var none = ctx.mir_create_block("safe_none")
  var merge = ctx.mir_create_block("safe_merge")
  
  # Allocate result storage
  var result = ctx.mir_emit_alloc(1)
  
  # Jump from current block to check
  var entry = ctx.mir_ctx_get_block()
  mir_block_set_terminator(entry, mir::TERM_JUMP, check)
  
  # Check block: discriminate Some/None and branch.
  # B.10 §14 N3 6.3b — under niche layout the Option word IS the payload pointer
  # (Some) or the niche const (None): the tag is a range test (value != none_const
  # ⇒ Some), NOT a load@0, and the payload is the base word itself (identity), NOT
  # a load@1. Gated on the base being a niche Option ⇒ INERT when the flag is OFF.
  var sfa_niche = mir::mir_subject_is_niche_option(ctx, s, base)
  ctx.mir_switch_to_block(check)
  var is_some = 0
  if sfa_niche == 1
    var sfa_pt = mir::mir_option_subject_payload(ctx, s, base)
    var sfa_nc = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, sfa_pt))
    is_some = ctx.mir_emit_binary(op_constants::OP_NE, base_val, sfa_nc)
  else
    var tag = ctx.mir_emit_load_offset(base_val, 0)
    var zero = ctx.mir_emit_const_int(0)
    is_some = ctx.mir_emit_binary(op_constants::OP_EQ, tag, zero)
  end
  var cur = ctx.mir_ctx_get_block()
  mir_block_set_branch(cur, is_some, some, none)

  # Some block: extract payload, access field, wrap in Option::Some
  ctx.mir_switch_to_block(some)
  var payload = 0
  if sfa_niche == 1
    # Niche: the payload IS the base word (the struct pointer). Identity bind.
    payload = base_val
  else
    payload = ctx.mir_emit_load_offset(base_val, 1)
  end
  
  # Look up field index from struct type
  var fidx = 0
  # Try to infer the struct type from the base expression
  var base_kind = ast::ast_get_kind(s, base)
  if base_kind == node_constants::NODE_IDENT or base_kind == node_constants::NODE_SYMBOL_LIT
    var vname = ast::ast_get_str1(s, base)
    var stype = ctx.mir_ctx_get_var_type(vname)
    if str_byte_len(stype) > 0
      # Strip generic type args for struct registry lookup (e.g., "GBox<Int>" -> "GBox")
      var lt_pos = __char_index(stype, '<')
      if lt_pos > 0
        stype = str_byte_slice(stype, 0, lt_pos)
      end
      stype = mir_resolve_struct_name(ctx, stype)
      var idx = ctx.mir_ctx_find_field_index(stype, field)
      if idx >= 0
        fidx = idx
      end
    end
  end
  # Fallback: search all structs for this field name
  if fidx == 0
    var global_result = mir_find_field_globally(ctx, field)
    if global_result.size > 0
      fidx = global_result[1]
    end
  end
  
  var fval = ctx.mir_emit_load_offset(payload, fidx)
  
  # Wrap in Option::Some (tag=0, payload=field_val)
  var sres = ctx.mir_emit_alloc_stack(2, "Option")
  var szero = ctx.mir_emit_const_int(0)
  ctx.mir_emit_store_offset(sres, 0, szero)
  ctx.mir_emit_store_offset(sres, 1, fval)
  ctx.mir_emit_store_offset(result, 0, sres)
  mir_block_set_terminator(some, mir::TERM_JUMP, merge)

  # None block: create Option::None (tag=1, payload=0)
  ctx.mir_switch_to_block(none)
  var one = ctx.mir_emit_const_int(1)
  var nzero = ctx.mir_emit_const_int(0)
  var nres = ctx.mir_emit_alloc_stack(2, "Option")
  ctx.mir_emit_store_offset(nres, 0, one)
  ctx.mir_emit_store_offset(nres, 1, nzero)
  ctx.mir_emit_store_offset(result, 0, nres)
  var ncur = ctx.mir_ctx_get_block()
  mir_block_set_terminator(ncur, mir::TERM_JUMP, merge)
  
  # Merge block: load and return the result
  ctx.mir_switch_to_block(merge)
  return ctx.mir_emit_load_offset(result, 0)
end

def mir_try_op_overload(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, op: Int, left_val: Int, right_val: Int): Int
  var overload_struct = ast::ast_get_str2(s, node)
  if as_int(overload_struct) == 0
    return -1
  end
  if str_byte_len(overload_struct) == 0
    return -1
  end
  var op_method = match op
    0 => "op_add"
    1 => "op_sub"
    2 => "op_mul"
    3 => "op_div"
    4 => "op_mod"
    7 => "op_eq"
    8 => "op_ne"
    9 => "op_lt"
    10 => "op_le"
    11 => "op_gt"
    12 => "op_ge"
    _ => ""
  end
  if str_byte_len(op_method) == 0
    return -1
  end
  var mangled = string_intern::mangle(overload_struct, op_method)
  var args = vec_new()
  args.push(left_val)
  args.push(right_val)
  return ctx.mir_emit_call(mangled, args)
end

# ============================================================================
# Extracted Dispatch Handlers (X.4)
# ============================================================================
# Each handler follows the signature: (ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
# Called from mir_lower_expr for cases >= 60 lines.

## Lower NODE_TRY_CATCH and NODE_TRY_EXPR
def mir_lower_try(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)

  # NodeTryCatch = 63: try expr catch pattern handler
  # Result layout: [tag:i64@0, payload:i64@1]  Ok=tag 0, Err=tag 1
  if kind == node_constants::NODE_TRY_CATCH
    var body = ast::ast_get_left(s, node)
    var pattern = ast::ast_get_extra(s, node)
    var handler = ast::ast_get_right(s, node)

    var ok_block = ctx.mir_create_block("try_ok")
    var err_block = ctx.mir_create_block("try_err")
    var end_block = ctx.mir_create_block("try_end")

    # Allocate result slot
    var result_name = "__try_result"
    var result_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(result_name, result_slot)

    # enum-niche M2 — niche-aware try/catch over a niche-MULTI built-in Result. The
    # body's word is `payload_ptr | tag`: tag = `value & 7` (Ok ⇔ 0), Ok/Err payload =
    # `value & ~7`. Type-INDEPENDENT (mask 7). Gated on the body subject being a
    # niche-multi Result ⇒ INERT while the gate is OFF (returns 0 ⇒ the byte-identical
    # spill load@0/load@1 path).
    var tc_niche_multi = mir::mir_subject_is_niche_multi(ctx, s, body)

    # Lower body — returns Result ptr (or, under multi niche, the packed word)
    var body_val = mir_lower::mir_lower_expr(ctx, s, body)

    # Load tag, compare == 0 (Ok). Niche-multi: mask the low spare bits instead.
    var tag = 0
    if tc_niche_multi == 1
      var tcm_mask = ctx.mir_emit_const_int(mir::mir_result_niche_spare_mask())
      tag = ctx.mir_emit_binary(op_constants::OP_AND, body_val, tcm_mask)
    else
      tag = ctx.mir_emit_load_offset(body_val, 0)
    end
    var zero = ctx.mir_emit_const_int(0)
    var is_ok = ctx.mir_emit_binary(op_constants::OP_EQ, tag, zero)

    # Branch on tag
    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_branch(cur_block, is_ok, ok_block, err_block)

    # Ok block: extract payload, store to result
    ctx.mir_switch_to_block(ok_block)
    var ok_payload = 0
    if tc_niche_multi == 1
      var tcm_clear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
      ok_payload = ctx.mir_emit_binary(op_constants::OP_AND, body_val, tcm_clear)
    else
      ok_payload = ctx.mir_emit_load_offset(body_val, 1)
    end
    ctx.mir_emit_store_var(result_name, ok_payload)
    var ok_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(ok_cur) < 0
      mir_block_set_terminator(ok_cur, mir::TERM_JUMP, end_block)
    end

    # Err block: extract error payload, bind pattern variable, evaluate handler.
    # Niche-multi Result: the Err payload is `value & ~7` (mask off the tag bit).
    ctx.mir_switch_to_block(err_block)
    var err_payload = 0
    if tc_niche_multi == 1
      var tcm_eclear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
      err_payload = ctx.mir_emit_binary(op_constants::OP_AND, body_val, tcm_eclear)
    else
      err_payload = ctx.mir_emit_load_offset(body_val, 1)
    end

    # Bind pattern variable
    if pattern > 0
      var pat_kind = ast::ast_get_kind(s, pattern)
      if pat_kind == node_constants::NODE_IDENT
        var bind_name = ast::ast_get_str1(s, pattern)
        if bind_name != "_"
          # Register the binding FIRST so the handler body resolves
          # `bind_name` to this error payload via mir_ctx_lookup_var
          # instead of falling through to a same-named free function
          # (`try ... catch e e` with a free `e()`) — sibling of the
          # 30d37c96 enum-payload binding-shadow miscompile.
          var bind_slot = ctx.mir_ctx_alloc_slot()
          ctx.mir_ctx_bind_var(bind_name, bind_slot)
          ctx.mir_emit_store_var(bind_name, err_payload)
        end
      elsif pat_kind == node_constants::NODE_ENUM_ACCESS
        var bound_names = ast::ast_get_bound_names(s, pattern)
        if bound_names != 0
          if bound_names.size > 0
            var bname = as_string(bound_names[0])
            if bname != "_"
              # Register the binding FIRST so the handler body resolves
              # `bname` to this error payload via mir_ctx_lookup_var instead
              # of falling through to a same-named free function — the
              # enum-access guise of the 30d37c96 binding-shadow miscompile
              # (`catch Err(e)` with a free `e()`).
              var bn_slot = ctx.mir_ctx_alloc_slot()
              ctx.mir_ctx_bind_var(bname, bn_slot)
              ctx.mir_emit_store_var(bname, err_payload)
            end
          end
        end
      end
    end

    var handler_val = ctx.mir_lower_block_expr(s, handler)
    ctx.mir_emit_store_var(result_name, handler_val)
    var err_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(err_cur) < 0
      mir_block_set_terminator(err_cur, mir::TERM_JUMP, end_block)
    end

    # End block: load and return result
    ctx.mir_switch_to_block(end_block)
    return ctx.mir_emit_load_var(result_name)
  end

  # NodeTryExpr = 17 - the ? operator (try expression)
  # On Ok/Some: extract and return the payload
  # On Err/None: emit drops for all droppables, then early return the carrier
  var inner = ast::ast_get_left(s, node)
  var expr_val = mir_lower::mir_lower_expr(ctx, s, inner)

  # B.10 §14 N3 6.3c — niche-aware `try` on a niche-layout Option. Under niche the
  # single word IS the payload pointer (Some) or the niche const (None): the
  # discriminant is a range test (`value != none_const` ⇒ Some), NOT a load@0, and
  # the Some payload is the carrier word itself (identity), NOT a load@1. On None
  # the early-return value IS the carrier (the niche const), which reads back as
  # None at the call site. Gated on the subject being a niche Option ⇒ INERT when
  # the flag is OFF (mir_subject_is_niche_option returns 0 ⇒ the byte-identical
  # tag-load path below). Result `?` and spill Options keep the legacy layout.
  var try_niche = mir::mir_subject_is_niche_option(ctx, s, inner)
  # enum-niche M2 — niche-aware `?` over a niche-MULTI built-in Result. Under the
  # multi niche the single word IS `payload_ptr | tag`: tag = `value & 7` (Ok ⇔ tag
  # 0), Ok payload = `value & ~7`, Err early-return = the whole word (the call site
  # niche-decodes it back to Err). Type-INDEPENDENT (mask is the constant 7). Gated on
  # the subject being a niche-multi Result ⇒ INERT while the gate is OFF
  # (`mir_subject_is_niche_multi` returns 0 ⇒ the byte-identical tag-load path below).
  var try_niche_multi = 0
  if try_niche == 0
    try_niche_multi = mir::mir_subject_is_niche_multi(ctx, s, inner)
  end

  # item 42c — value-layout-spill `try`/`?` Ok/Some payload extract. A SPILL
  # Result/Option whose Ok/Some payload is a value-layout (`@value`/flip-eligible)
  # struct INLINE-embeds the payload's flat field words at box[word1] (construction:
  # mir_lower.qz is_oR path). The legacy spill extract below reads `load_offset(box, 1)`
  # — the FIRST FIELD VALUE (e.g. 5) — and binds it as a payload POINTER, so the
  # consumer (`inner.a`) deref's `0x5` ⇒ SIGSEGV (the gate-1 result_niche try_double
  # crash). Mirror the item-23/42 unwrap intercept and the match-arm `is_inline` bind:
  # on the present arm return the INTERIOR ADDRESS `box + 8` (the FLAT header-less field
  # block; construction strips the COW header for >16B), NOT a load. The bind site
  # arena-marks the bound name so its field reads stay offset+0 (no COW +1 shift) for
  # BOTH ≤16B and >16B. The Err/None early-return passes the box (carrier) through
  # unchanged, which is already correct. Niche subjects keep their hot paths (the
  # niche checks above win — niche payloads are pointer-like, never value-layout).
  # Keyed on `mir_result_subject_is_inline_value` / `mir_option_subject_is_inline_value`
  # ⇒ INERT at gate 0 (no `@value` Result/Option payload exists in the compiler/std ⇒
  # never fires ⇒ self-host IR byte-identical).
  var try_inline_value = 0
  if try_niche == 0 and try_niche_multi == 0
    try_inline_value = mir::mir_result_subject_is_inline_value(ctx, s, inner)
    if try_inline_value == 0
      try_inline_value = mir::mir_option_subject_is_inline_value(ctx, s, inner)
    end
  end

  # Load tag (offset 0) to check Ok/Some(0) vs Err/None(1) — spill layout. For a
  # niche Option, derive Some via the range test instead; for a niche Result, mask.
  var cmp = 0
  if try_niche == 1
    var try_pt = mir::mir_option_subject_payload(ctx, s, inner)
    var try_nc = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, try_pt))
    # Some ⇔ value != none_const. ok_block fires on Some.
    cmp = ctx.mir_emit_binary(op_constants::OP_NE, expr_val, try_nc)
  elsif try_niche_multi == 1
    # Ok ⇔ (value & 7) == 0. ok_block fires on Ok.
    var tm_mask = ctx.mir_emit_const_int(mir::mir_result_niche_spare_mask())
    var tm_tag = ctx.mir_emit_binary(op_constants::OP_AND, expr_val, tm_mask)
    var tm_zero = ctx.mir_emit_const_int(0)
    cmp = ctx.mir_emit_binary(op_constants::OP_EQ, tm_tag, tm_zero)
  else
    var load_tag = ctx.mir_emit_load_offset(expr_val, 0)
    var zero = ctx.mir_emit_const_int(0)
    cmp = ctx.mir_emit_binary(op_constants::OP_EQ, load_tag, zero)
  end

  # Create blocks
  var ok_block = ctx.mir_create_block("try_ok")
  var err_block = ctx.mir_create_block("try_err")
  var end_block = ctx.mir_create_block("try_end")

  # Branch on the discriminant (true ⇒ Ok/Some ⇒ ok_block)
  var cur_block = ctx.mir_ctx_get_block()
  mir_block_set_branch(cur_block, cmp, ok_block, err_block)

  # Ok/Some path: extract payload and jump to end
  ctx.mir_switch_to_block(ok_block)
  var payload = 0
  if try_niche == 1
    # Niche Option: the Some payload IS the carrier word (identity). No load@1.
    payload = expr_val
  elsif try_niche_multi == 1
    # Niche Result: the Ok payload is `value & ~7` (mask off the low tag bits to
    # recover the 8-aligned boxed pointer). One i64 in, one i64 out (invariant #5).
    var tm_clear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
    payload = ctx.mir_emit_binary(op_constants::OP_AND, expr_val, tm_clear)
  elsif try_inline_value == 1
    # item 42c — value-layout-spill Ok/Some: the fields live INLINE FLAT at box[word1].
    # Return the INTERIOR ADDRESS `box + 8` (no load), exactly the item-23/42 unwrap
    # intercept and the match-arm `is_inline` bind. The bind site arena-marks the name
    # so its field reads stay offset+0 for BOTH ≤16B and >16B. One i64 in/out (§5).
    var tiv_off = ctx.mir_emit_const_int(8)
    payload = ctx.mir_emit_binary(op_constants::OP_ADD, expr_val, tiv_off)
  else
    payload = ctx.mir_emit_load_offset(expr_val, 1)
  end
  mir_block_set_terminator(ok_block, mir::TERM_JUMP, end_block)

  # Err/None path: emit defers and drops, then early-return the carrier (under
  # niche the carrier IS the None const; under spill it IS the Err/None struct).
  ctx.mir_switch_to_block(err_block)
  mir_lower::emit_deferred(ctx)
  emit_drops_for_scope(ctx, 0)
  ctx.mir_emit_return(expr_val)

  # Continue in end block with extracted payload
  ctx.mir_switch_to_block(end_block)
  return payload
end

## Lower NODE_LAMBDA - closure creation, captures, env setup
def mir_lower_lambda(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  # Generate unique lambda name
  var lambda_num = ctx.mir_ctx_next_lambda()
  var lambda_name = "__lambda_#{lambda_num.to_s()}"

  # Collect captures by walking the lambda body
  var captures = mir_collect_captures(ctx, s, node)
  var capture_count = vec_size(captures)

  # R-WS3 — classify each capture read(0)/mut(1) and decide the escape-safety of
  # THIS closure. A `mut` capture may be taken BY-REFERENCE (env holds the address
  # of the caller's slot; writes in the body alias the caller's storage live) ONLY
  # when the closure is non-escaping — i.e. it was approved at the call site as a
  # direct argument to a known-inline HOF combinator (each/map/reduce/...) that
  # invokes it synchronously and does not store/spawn it. An escaping closure with
  # a mut capture falls back to the current BY-VALUE behavior (no stack address is
  # ever put in a heap env that outlives the frame). GATE-0-INERT: the compiler's
  # own closures never assign to a captured outer local ⇒ every mode is 0 ⇒ the
  # by-ref path is dead ⇒ byte-identical env layout + body.
  var capture_modes = mir::mir_classify_capture_modes(ctx, s, node, captures)
  var lambda_nonescaping = mir::mir_ctx_is_nonescaping_lambda(ctx, node)

  # R-WS3 — per-capture by-ref eligibility. A capture is taken by-reference iff:
  #   (1) it is mut-classified (the body reassigns the bare name), AND
  #   (2) this closure is non-escaping (approved at a whitelisted HOF call site).
  #
  # WS1b (value-struct whole-var-reassignment persistence) — the value-layout
  # exclusion that used to gate (@value / F4) struct captures OUT is REMOVED. It is
  # correct to take a value-layout mut-capture by-reference for the WHOLE-VAR
  # reassignment case, which is exactly what `capture_modes[cbi] == 1` selects:
  # `mir_collect_assign_targets` records whole-var reassignment targets (NODE_ASSIGN
  # / NODE_COMPOUND_ASSIGN / bare-reassign NODE_LET int_val==0 via str1) as mode 1.
  # WS2 adds mode 2 = field/index writes (`p.x = …` / `p[i] = …`), taken by-ref only
  # for a VALUE-LAYOUT base (gated below). So a mode-1 value-layout capture is a
  # whole-var `a = Struct{…}` reassignment; a mode-2 one is a field/index write.
  #
  # A value-layout LOCAL SLOT holds a SINGLE handle word (for a >16B @value/F4 struct
  # a pointer to a CoW buffer; for a ≤16B struct an inline packed word), exactly like
  # a scalar. So `mir_emit_addr_of(cap_name)` yields the address of that one-word slot
  # → stored raw into env[i+1]; the callee-side ref-var deref reads/writes that one
  # word. A whole-var reassignment write-throughs the NEW handle into the caller's
  # slot, so the caller's slot points at the closure-constructed struct's buffer and
  # the mutation persists. BORROW-NOT-OWN: the caller-side stores only the ADDRESS
  # (no mir_emit_value_copy / cow_rc_inc), so there is exactly one owner (the caller)
  # and the caller's scope-exit cow_release stays correct — no double-free.
  # RELEASE-ON-WRITE-THROUGH: the superseded buffer from a prior loop iteration is
  # NOT released before the new handle overwrites it (discipline (b) — the rebind
  # release path in mir_lower_stmt_handlers keys on a droppable entry that the by-ref
  # capture intentionally does NOT push, since pushing one would also cow_release at
  # lambda scope-exit and double-free the caller-owned buffer). The per-iteration leak
  # is FILED — see the WS1b `next:` note. This is memory-safe (no double-free), just
  # not leak-free; discipline (a) needs a release-old-without-scope-exit-release path
  # for ref-vars that does not exist this increment.
  #
  # GATE-0-INERT: capture_modes are all 0 for the compiler's own closures (none
  # reassign a captured outer local) ⇒ eligibility all 0 ⇒ byte-identical. Only the
  # value-layout whole-var-reassignment capture path changes.
  # WS2 (value-struct field/index-write persistence) — a mode-2 capture (`p.f = …`
  # / `p[i] = …` in the body, NO whole-var reassignment) is taken by-reference ONLY
  # when its base is a VALUE-LAYOUT (@value / F4) struct. For such a capture the
  # by-value snapshot (mir_emit_value_copy) loses the field write; the by-ref path
  # aliases the caller's one-word handle slot so the write (a COW make-unique +
  # shifted store for >16B, an offset store into the shared buffer for ≤16B) lands
  # in the caller's buffer and persists. For a heap/pointer base (plain-struct
  # pointer, Vec, Map — the compiler's own `ctx.field=…`-in-HOF closures) the field
  # write already persists through the shared pointer, so it stays BY-VALUE — and
  # that is what keeps gate-0 byte-identical: MirContext (and the compiler's other
  # captured mutated structs) are GC-firewall-mixed ⇒ NOT value-layout ⇒ elig 0.
  # Mode 1 (whole-var) stays layout-agnostic (WS1b), byte-identical at gate 0.
  var capture_byref = vec_new<Int>()
  for cbi in 0..capture_count
    var elig = 0
    if lambda_nonescaping == 1
      if capture_modes[cbi] == 1
        elig = 1
      elsif capture_modes[cbi] == 2
        var cb_ty = ctx.mir_ctx_get_var_type(captures[cbi])
        if str_byte_len(cb_ty) > 0
          if mir::mir_is_value_layout_type(ctx, cb_ty) == 1
            elig = 1
          end
        end
      end
    end
    capture_byref.push(elig)
  end

  # Get lambda params and body
  var params = ast::ast_get_left(s, node)
  var body = ast::ast_get_right(s, node)

  # Save current context state
  var saved_func = ctx.mir_ctx_get_func()
  var saved_block = ctx.mir_ctx_get_block()
  var saved_bindings = ctx.mir_ctx_get_bindings()
  var saved_string_vars = ctx.mir_ctx_get_string_vars()
  var saved_droppable = ctx.drops.droppable_stack
  var saved_scope_depth = ctx.mir_ctx_get_scope_depth()
  # R-WS3 — the ref-var set is per-lambda-body. Save the enclosing set and start
  # this lambda with a fresh (empty) one; restore on exit. GATE-0-INERT (empty).
  var saved_ref_vars = ctx.ref_vars
  # Pause async/generator lowering so this nested lambda is emitted as a
  # plain sync function. Without this, `%self` loads from the outer $poll
  # leak into the lambda body (`mir_gen_is_active() >= 2` gates fire on
  # every `return`, `yield`, call to `io_suspend`, etc.) producing IR that
  # references an undefined `%self` SSA name.
  var saved_gen_active = mir_lower_gen::mir_gen_pause_active()

  # Phase 2 P2.a (bug fix via P2.b): save + clear the lexical handler stack
  # so lexically-enclosing `with E {..} do ->` blocks do NOT appear in scope
  # inside the lambda body. Without this, a lambda captured by a higher-order
  # helper fn (e.g., std/reader::local passing `() -> ask()`) emits
  # `%wb.pretop.<install_dest>` / `%wb.jmpbuf.<install_dest>` SSA references
  # to the ENCLOSING function's install block — which doesn't exist in the
  # lambda's SSA scope. Same failure class as `saved_gen_active` above
  # (feedback_gen_state_lambda_leak.md). Lambda body performs fall back to
  # dynamic dispatch, which is correct since the runtime handler stack is
  # populated per thread at run time.
  var saved_hs_effs = ctx.handler_stack_effs
  var saved_hs_filters = ctx.handler_stack_filters
  var saved_hs_handlers = ctx.handler_stack_handlers
  var saved_hs_install_dests = ctx.handler_stack_install_dests
  ctx.handler_stack_effs = vec_new<String>()
  ctx.handler_stack_filters = vec_new<String>()
  ctx.handler_stack_handlers = vec_new<Int>()
  ctx.handler_stack_install_dests = vec_new<Int>()

  # Create new function for the lambda
  var lambda_func = mir_new_function(lambda_name, mir::MIR_TYPE_INT)
  # INC.1.2 — inherit the surrounding function's module so this lambda
  # ships with its parent module's `.qzmod` artifact. Read off
  # `saved_func` (the surrounding fn, captured above before `ctx.func`
  # is repointed to the lambda) — that fn already had origin_module set
  # to the canonical dep_graph name at its own lowering entry, so we get
  # the right value regardless of whether the surrounding fn has a
  # module prefix in its name.
  mir::mir_func_set_origin_module(lambda_func, mir::mir_func_get_origin_module(saved_func))

  # Add to program's function list
  var prog = ctx.mir_ctx_get_program()
  var funcs = mir_get_functions(prog)
  funcs.push(lambda_func)

  # Set as current function
  ctx.mir_ctx_set_func(lambda_func)

  # Add __env as first parameter (for closure support)
  mir_func_add_param(lambda_func, "__env", mir::MIR_TYPE_INT)

  # Add lambda parameters and mark string-typed ones
  # Build lambda string vars: start with captured string vars, then add params
  var lambda_string_vars = vec_new<String>()
  for ci in 0..capture_count
    var cn = captures[ci]
    if ctx.mir_ctx_is_string_var(cn)
      lambda_string_vars.push(cn)
    end
  end
  ctx.string_vars = lambda_string_vars
  if params != 0
    var p_count = vec_size(params)
    for pi in 0..p_count
      var p = params[pi]
      var p_name = ast::ast_get_str1(s, p)
      mir_func_add_param(lambda_func, p_name, mir::MIR_TYPE_INT)
      var p_type = ast::ast_get_str2(s, p)
      if p_type == "String"
        ctx.mir_ctx_mark_string_var(p_name)
      end
    end
  end

  # Create entry block (use mir_create_block for unique label to avoid collision with params)
  var entry = ctx.mir_create_block("entry")
  ctx.mir_ctx_set_block(entry)

  # Reset bindings and drop state for lambda scope
  ctx.bindings = vec_new()
  ctx.drops.droppable_stack = vec_new()
  ctx.mir_ctx_set_scope_depth(0)
  # R-WS3 — fresh ref-var set for this lambda body (populated below for mut-by-ref
  # captures). Empty at gate 0 ⇒ load/store keep the raw byte-identical path.
  ctx.ref_vars = vec_new<String>()

  # Bind lambda parameters in the new scope so they shadow same-named functions.
  # mir_func_add_param only registers them in the MIR function signature;
  # mir_ctx_bind_var makes them visible to mir_ctx_lookup_var during body lowering.
  if params != 0
    var bp_count = vec_size(params)
    for bpi in 0..bp_count
      var bp = params[bpi]
      var bp_name = ast::ast_get_str1(s, bp)
      var bp_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(bp_name, bp_slot)
      var bp_type = ast::ast_get_str2(s, bp)
      if bp_type == "F64" or bp_type == "F32"
        ctx.mir_ctx_mark_float_var(bp_name)
      end
      # F4 item-9 — register a struct-typed lambda param so the body's
      # `param.field` reads resolve through the receiver's value-layout layout
      # (cow buffer word f+1, or the inline @value typed GEP) — exactly as a
      # named-fn param `p: P3` does (mir_lower.qz mir_ctx_mark_struct_var at
      # ~6299). The typechecker now backfills the inferred element struct name
      # into an unannotated HOF closure param's str2 (tc_expr_lambda, F4 item-9),
      # so `v.each { it.a }` / `v.map(e -> e.b)` over a value-layout `Vec<S>`
      # reads its fields at the right offsets instead of FLAT (garbage / SIGSEGV
      # for >1-word @value elements). Mirror the named-fn skip-list (Int / Bool /
      # String / Void / union / record annotations are not nominal structs).
      # INERT at gate 0: a plain struct is not value-layout, so the downstream
      # cow_field_shift / typed-GEP predicates stay false ⇒ byte-identical; only
      # @value (and F4-flipped) element closures change.
      if str_byte_len(bp_type) > 0
        if bp_type != "Int" and bp_type != "Bool" and bp_type != "String" and bp_type != "Void"
          if not mir_is_union_annotation(bp_type)
            if str_byte_at(bp_type, 0) != '{'
              ctx.mir_ctx_mark_struct_var(bp_name, bp_type)
            end
          end
        end
      end
    end
  end

  # If there are captures, load them from env pointer
  if capture_count > 0
    # Load env pointer
    var env_val = ctx.mir_emit_load_var("__env")

    # For each capture, load from env[offset] and bind to local
    # mir_ctx_bind_var makes captures visible to nested lambda capture collection
    for i in 0..capture_count
      var cap_name = captures[i]
      var cap_val = ctx.mir_emit_load_offset(env_val, i + 1)
      # R-WS3 — mut-by-ref capture (non-escaping): env[i+1] holds the ADDRESS of the
      # caller's slot, not the value. Store that pointer into cap_name's slot and mark
      # cap_name a ref-var so subsequent loads deref it and stores write through it —
      # the body's `total = total + it` then aliases the caller's storage live. We
      # must NOT snapshot (that would give the body its own detached copy). Bind the
      # var slot BEFORE marking ref-var so mir_emit_store_var_raw (below) targets the
      # right slot; the raw store puts the pointer in without indirection.
      if capture_byref[i] == 1
        ctx.mir_ctx_bind_var(cap_name, cap_val)
        mir::mir_emit_store_var_raw(ctx, cap_name, cap_val)
        mir::mir_ctx_bind_ref_var(ctx, cap_name)
      else
        ctx.mir_emit_store_var(cap_name, cap_val)
        ctx.mir_ctx_bind_var(cap_name, cap_val)
      end
    end
  end

  # Lower body - always as expression to get implicit return value
  var result = ctx.mir_lower_block_expr(s, body)

  # If block doesn't have a terminator, return the result
  var cur_block = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(cur_block) < 0
    ctx.mir_emit_return(result)
  end

  # Restore previous context
  ctx.mir_ctx_set_func(saved_func)
  ctx.mir_ctx_set_block(saved_block)
  ctx.bindings = saved_bindings
  ctx.string_vars = saved_string_vars
  ctx.drops.droppable_stack = saved_droppable
  ctx.ref_vars = saved_ref_vars
  ctx.mir_ctx_set_scope_depth(saved_scope_depth)
  mir_lower_gen::mir_gen_resume_active(saved_gen_active)
  ctx.handler_stack_effs = saved_hs_effs
  ctx.handler_stack_filters = saved_hs_filters
  ctx.handler_stack_handlers = saved_hs_handlers
  ctx.handler_stack_install_dests = saved_hs_install_dests

  # Create closure struct in caller context
  # Layout: [fn_ptr, capture1, capture2, ...]
  var env_ptr = ctx.mir_emit_alloc(capture_count + 1)

  # Store function pointer at offset 0
  var fn_ref = ctx.mir_emit_func_ref(lambda_name)
  ctx.mir_emit_store_offset(env_ptr, 0, fn_ref)

  # Store each captured variable
  for i in 0..capture_count
    var cap_name = captures[i]
    # R-WS3 — mut-by-ref capture (non-escaping): store the ADDRESS of the caller's
    # slot into the env, NOT a value copy. The closure then aliases the caller's
    # live storage (writes persist). No value_copy / retain — the caller still OWNS
    # the slot (and, for a value-struct, its CoW buffer), so scope-exit cow_release
    # stays correct and there is no double-free (the closure is a borrower). Only
    # taken for a mut capture of a non-escaping closure; every other capture (all of
    # the compiler's own) keeps the by-value path below ⇒ byte-identical.
    if capture_byref[i] == 1
      var cap_addr = mir::mir_emit_addr_of(ctx, cap_name)
      ctx.mir_emit_store_offset(env_ptr, i + 1, cap_addr)
      continue
    end
    var cap_val = ctx.mir_emit_load_var(cap_name)
    # F4c (R5) — closures capture value-layout @value structs BY VALUE (the
    # documented contract: REFERENCE.md:540/562/571 "mutations after capture don't
    # affect the closure"). A bare load stores the captured variable's POINTER (the
    # box) into the env, ALIASING the original's storage — so a later in-place field
    # write (`p.x = 100`) leaks into the closure. mir_emit_value_copy gives the env
    # its OWN copy via the SINGLE value-layout key, mirroring `var b = a`:
    #   • >16B COW value-layout: cow_rc_inc (a counted retain on the SAME buffer,
    #     returns src). This also fixes the live COW UAF — the enclosing scope's
    #     cow_release at exit would otherwise free the buffer out from under the
    #     closure (escaped via the heap env). Copy-on-write at first mutation keeps
    #     the captured snapshot intact.
    #   • ≤16B inline value-layout: a fresh eager word-copy (NEW dst) — the env holds
    #     an independent struct, so later mutations of the original don't leak. (The
    #     old code only retained the COW sub-case via mir_value_is_cow_layout and let
    #     the inline case fall through with the bare alias — the by-value-mutation
    #     leak this fixes.)
    # We store the COPY's result (cow→same ptr, inline→new ptr), not the bare load.
    # Keyed on mir_is_value_layout_type so it is INERT for non-value captures
    # (scalars/refs/plain non-@value structs) — byte-identical for those, which is
    # everything the compiler's own closures capture.
    var cap_ty = ctx.mir_ctx_get_var_type(cap_name)
    if str_byte_len(cap_ty) > 0 and mir::mir_is_value_layout_type(ctx, cap_ty) == 1
      cap_val = mir::mir_emit_value_copy(ctx, cap_val, cap_ty)
    end
    ctx.mir_emit_store_offset(env_ptr, i + 1, cap_val)
  end

  # Tag closure pointer (set low bit = 1) to distinguish from plain fn ptrs
  var one = ctx.mir_emit_const_int(1)
  var tagged = ctx.mir_emit_binary(op_constants::OP_ADD, env_ptr, one)

  return tagged
end

## Lower array literal containing spread elements: vec_new + push/loop
def mir_lower_array_with_spread(ctx: MirContext, s: ast::AstStorage, elements: Vec<Int>, count: Int): Int
  # Create result vec via vec_new()
  var new_args = vec_new()
  var result_val = ctx.mir_emit_intrinsic("vec_new", new_args)
  var result_name = gen_temp_name_with_ctx(ctx, "__spread_result")
  var result_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(result_name, result_slot)
  ctx.mir_emit_store_var(result_name, result_val)

  for si in 0..count
    var elem_node = elements[si]
    if ast::ast_get_kind(s, elem_node) == node_constants::NODE_SPREAD
      # Spread element: loop over source vec and push each element
      var inner = ast::ast_get_left(s, elem_node)
      var src_val = mir_lower::mir_lower_expr(ctx, s, inner)
      var src_name = gen_temp_name_with_ctx(ctx, "__spread_src")
      var src_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(src_name, src_slot)
      ctx.mir_emit_store_var(src_name, src_val)

      var idx_name = gen_temp_name_with_ctx(ctx, "__spread_idx")
      var idx_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(idx_name, idx_slot)
      var zero = ctx.mir_emit_const_int(0)
      ctx.mir_emit_store_var(idx_name, zero)

      var cond_block = ctx.mir_create_block("spread_cond")
      var body_block = ctx.mir_create_block("spread_body")
      var exit_block = ctx.mir_create_block("spread_exit")

      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

      # COND: idx < vec_size(src)
      ctx.mir_switch_to_block(cond_block)
      var idx_val = ctx.mir_emit_load_var(idx_name)
      var src_load = ctx.mir_emit_load_var(src_name)
      var len_args = vec_new()
      len_args.push(src_load)
      var len_val = ctx.mir_emit_intrinsic("vec_size", len_args)
      var cmp = ctx.mir_emit_binary(op_constants::OP_LT, idx_val, len_val)
      mir_block_set_branch(cond_block, cmp, body_block, exit_block)

      # BODY: vec_push(result, vec_get(src, idx)); idx++
      ctx.mir_switch_to_block(body_block)
      var src_load2 = ctx.mir_emit_load_var(src_name)
      var idx_val2 = ctx.mir_emit_load_var(idx_name)
      var get_args = vec_new()
      get_args.push(src_load2)
      get_args.push(idx_val2)
      var elem_val = ctx.mir_emit_intrinsic("vec_get", get_args)

      var res_load = ctx.mir_emit_load_var(result_name)
      var push_args = vec_new()
      push_args.push(res_load)
      push_args.push(elem_val)
      ctx.mir_emit_intrinsic("vec_push", push_args)

      var idx_cur = ctx.mir_emit_load_var(idx_name)
      var one = ctx.mir_emit_const_int(1)
      var idx_next = ctx.mir_emit_binary(op_constants::OP_ADD, idx_cur, one)
      ctx.mir_emit_store_var(idx_name, idx_next)
      mir_block_set_terminator(body_block, mir::TERM_JUMP, cond_block)

      # Continue from exit block
      ctx.mir_switch_to_block(exit_block)
    else
      # Plain element: vec_push(result, lower(elem))
      var elem_val2 = mir_lower::mir_lower_expr(ctx, s, elem_node)
      var res_load2 = ctx.mir_emit_load_var(result_name)
      var push_args2 = vec_new()
      push_args2.push(res_load2)
      push_args2.push(elem_val2)
      ctx.mir_emit_intrinsic("vec_push", push_args2)
    end
  end

  return ctx.mir_emit_load_var(result_name)
end

## Lower NODE_ALLOC_EXPR - heap/arena allocation
def mir_lower_alloc(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var target = ast::ast_get_str1(s, node)
  var expr_node = ast::ast_get_left(s, node)
  var expr_kind = ast::ast_get_kind(s, expr_node)

  # Struct inits allocate via mir_emit_alloc. For @heap, pass through directly.
  # For named arenas, set the arena target context so the struct init handler
  # uses arena_alloc instead of malloc.
  if expr_kind == node_constants::NODE_STRUCT_INIT
    if target != "heap"
      mir_lower::mir_set_alloc_arena_target(target)
      var result = mir_lower::mir_lower_expr(ctx, s, expr_node)
      mir_lower::mir_set_alloc_arena_target("")
      return result
    end
    return mir_lower::mir_lower_expr(ctx, s, expr_node)
  end

  # String literals are already global constants in LLVM IR — just pass through.
  # No need to copy or wrap; the pointer is valid for the lifetime of the program.
  if expr_kind == node_constants::NODE_STRING_LIT
    return mir_lower::mir_lower_expr(ctx, s, expr_node)
  end

  # Array literals: heap-allocate header [cap, len, data_ptr] + data buffer
  # This mirrors NODE_ARRAY lowering but uses malloc/arena_alloc instead of stack alloca.
  if expr_kind == node_constants::NODE_ARRAY
    var elements = ast::ast_get_children(s, expr_node)
    var count = elements.size

    # Check for spread — if present, use dynamic vec_new + push path
    var has_spread_alloc = 0
    for sai in 0..count
      if ast::ast_get_kind(s, elements[sai]) == node_constants::NODE_SPREAD
        has_spread_alloc = 1
      end
    end
    if has_spread_alloc == 1
      return mir_lower_array_with_spread(ctx, s, elements, count)
    end

    var data_slots = count
    if data_slots == 0
      data_slots = 1
    end

    # Declare ptrs outside branch scope so they're visible below
    var hdr_ptr = 0
    var data_ptr = 0

    if target == "heap"
      # Allocate header (4 * 8 = 32 bytes) on heap
      var hdr_size = ctx.mir_emit_const_int(32)
      var hdr_malloc_args = vec_new()
      hdr_malloc_args.push(hdr_size)
      hdr_ptr = ctx.mir_emit_call("malloc", hdr_malloc_args)

      # Allocate data (count * 8 bytes) on heap
      var data_size = ctx.mir_emit_const_int(data_slots * 8)
      var data_malloc_args = vec_new()
      data_malloc_args.push(data_size)
      data_ptr = ctx.mir_emit_call("malloc", data_malloc_args)
    else
      # Allocate header (32 bytes) from arena
      var arena_handle = ctx.mir_emit_load_var(target)
      var hdr_size = ctx.mir_emit_const_int(32)
      var hdr_args = vec_new()
      hdr_args.push(arena_handle)
      hdr_args.push(hdr_size)
      hdr_ptr = ctx.mir_emit_intrinsic("arena_alloc", hdr_args)

      # Allocate data from arena
      var arena_handle2 = ctx.mir_emit_load_var(target)
      var data_size = ctx.mir_emit_const_int(data_slots * 8)
      var data_args = vec_new()
      data_args.push(arena_handle2)
      data_args.push(data_size)
      data_ptr = ctx.mir_emit_intrinsic("arena_alloc", data_args)
    end

    # Store header: [cap, len, data_ptr, elem_width]
    var cap_val = ctx.mir_emit_const_int(count)
    var len_val = ctx.mir_emit_const_int(count)
    var ew_val = ctx.mir_emit_const_int(8)
    ctx.mir_emit_store_offset(hdr_ptr, 0, cap_val)
    ctx.mir_emit_store_offset(hdr_ptr, 1, len_val)
    ctx.mir_emit_store_offset(hdr_ptr, 2, data_ptr)
    ctx.mir_emit_store_offset(hdr_ptr, 3, ew_val)

    # Lower each element and store to data buffer
    for i in 0..count
      var elem_node = elements[i]
      var elem_val = mir_lower::mir_lower_expr(ctx, s, elem_node)
      ctx.mir_emit_store_offset(data_ptr, i, elem_val)
    end

    return hdr_ptr
  end

  # Generic scalar: lower inner expression, heap-allocate, store, return pointer
  var inner_val = mir_lower::mir_lower_expr(ctx, s, expr_node)

  if target == "heap"
    var size_val = ctx.mir_emit_const_int(8)
    var malloc_args = vec_new()
    malloc_args.push(size_val)
    var ptr = ctx.mir_emit_call("malloc", malloc_args)
    ctx.mir_emit_store_offset(ptr, 0, inner_val)
    return ptr
  else
    var arena_handle = ctx.mir_emit_load_var(target)
    var size_val = ctx.mir_emit_const_int(8)
    var args = vec_new()
    args.push(arena_handle)
    args.push(size_val)
    var ptr = ctx.mir_emit_intrinsic("arena_alloc", args)
    ctx.mir_emit_store_offset(ptr, 0, inner_val)
    return ptr
  end
end

## Find the $next function name for a concrete struct type.
## Tries Type$next, Type$next$1, then suffix scan for module-prefixed names.
def find_next_func_name(ctx: MirContext, struct_name: String): String
  if str_byte_len(struct_name) == 0
    return ""
  end
  var candidate = string_intern::mangle(struct_name, "next")
  if ctx.mir_lookup_function(candidate).is_some()
    return candidate
  end
  var mangled = string_intern::mangle_int(candidate, 1)
  if ctx.mir_lookup_function(mangled).is_some()
    return mangled
  end
  # Suffix scan for module-prefixed names (e.g. iter$Counter$next)
  var suffix = "$#{candidate}"
  var all_funcs = ctx.mir_ctx_get_all_funcs()
  if all_funcs != 0
    for i in 0..all_funcs.size
      var entry = all_funcs[i]
      var tag = entry.tag
      if tag == 0 or tag == 10
        var entry_name = entry.name
        var pos = __str_index(entry_name, suffix)
        if pos >= 0
          if pos + str_byte_len(suffix) == str_byte_len(entry_name)
            return entry_name
          end
        end
      end
    end
  end
  return ""
end

## Synthesize a -> arg.next() closure for an Iterator-bounded call site.
## Creates a lambda function that captures the struct and calls its $next.
## Returns the tagged closure pointer.
def synthesize_next_closure(ctx: MirContext, s: ast::AstStorage, arg_node: AstNodeId, struct_val: Int): Int
  # Infer concrete type to find the right $next function
  var concrete_type = ctx.mir_infer_expr_type(s, arg_node)
  # Strip module prefix if present
  var dollar = __char_index(concrete_type, '$')
  if dollar >= 0
    concrete_type = str_byte_slice(concrete_type, dollar + 1, str_byte_len(concrete_type))
  end
  var next_func = find_next_func_name(ctx, concrete_type)
  if str_byte_len(next_func) == 0
    # Fallback: just pass the value through (will likely crash at runtime)
    return struct_val
  end

  # Generate unique lambda name
  var lambda_num = ctx.mir_ctx_next_lambda()
  var lambda_name = "__iter_closure_#{lambda_num.to_s()}"

  # Save current context state
  var saved_func = ctx.mir_ctx_get_func()
  var saved_block = ctx.mir_ctx_get_block()
  var saved_bindings = ctx.mir_ctx_get_bindings()
  var saved_string_vars = ctx.mir_ctx_get_string_vars()
  var saved_droppable2 = ctx.drops.droppable_stack
  var saved_scope_depth2 = ctx.mir_ctx_get_scope_depth()

  # Create lambda function: __env -> ConcreteType$next(env[1])
  var lambda_func = mir_new_function(lambda_name, mir::MIR_TYPE_INT)
  # INC.1.2 — inherit the surrounding function's module so this iter-
  # closure ships with its parent module's `.qzmod` artifact. See
  # `mir_lower_lambda` for why saved_func is the right source vs
  # `ctx.mir_ctx_get_module()`.
  mir::mir_func_set_origin_module(lambda_func, mir::mir_func_get_origin_module(saved_func))
  var prog = ctx.mir_ctx_get_program()
  mir_get_functions(prog).push(lambda_func)
  ctx.mir_ctx_set_func(lambda_func)

  # Add __env as sole parameter
  mir_func_add_param(lambda_func, "__env", mir::MIR_TYPE_INT)

  # Create entry block
  var entry = ctx.mir_create_block("entry")
  ctx.mir_ctx_set_block(entry)
  ctx.bindings = vec_new()
  ctx.string_vars = vec_new<String>()
  ctx.drops.droppable_stack = vec_new()
  ctx.mir_ctx_set_scope_depth(0)

  # Load captured struct from env[1]
  var env_val = ctx.mir_emit_load_var("__env")
  var captured_struct = ctx.mir_emit_load_offset(env_val, 1)

  # Call ConcreteType$next(captured_struct)
  var call_args = [captured_struct]
  var result = ctx.mir_emit_call(next_func, call_args)

  # Return the Option<Int> result
  ctx.mir_emit_return(result)

  # Restore previous context
  ctx.mir_ctx_set_func(saved_func)
  ctx.mir_ctx_set_block(saved_block)
  ctx.bindings = saved_bindings
  ctx.string_vars = saved_string_vars
  ctx.drops.droppable_stack = saved_droppable2
  ctx.mir_ctx_set_scope_depth(saved_scope_depth2)

  # Create closure env in caller: [fn_ptr, struct_val]
  var env_ptr = ctx.mir_emit_alloc(2)
  var fn_ref = ctx.mir_emit_func_ref(lambda_name)
  ctx.mir_emit_store_offset(env_ptr, 0, fn_ref)
  ctx.mir_emit_store_offset(env_ptr, 1, struct_val)

  # Tag closure pointer (set low bit = 1)
  var one = ctx.mir_emit_const_int(1)
  var tagged = ctx.mir_emit_binary(op_constants::OP_ADD, env_ptr, one)
  return tagged
end

## Colorless call: emit inline await for a suspend-effected function call
## inside a $poll body. Creates the callee's async frame, polls it, and
## generates save/restore/resume blocks for transparent yielding.
##
## This is the core of colorless concurrency: instead of requiring the user
## to write `await async callee()`, a plain `callee()` inside a go block
## Emit park-based async_rwlock_read: CAS increment + park on write-locked.
## rw_val: MIR register containing the rwlock pointer.
## Layout: [0]=state(atomic), [1]=value, [2]=wait_head, [3]=wait_tail, [4]=wait_count, [5]=internal_mtx
def mir_emit_async_rwlock_read(ctx: MirContext, rw_val: Int): Int
  var id = _aml_counter
  _aml_counter = _aml_counter + 1
  var rw_local = "__arl_rw_#{id}"
  var res_local = "__arl_res_#{id}"
  mir_lower_gen::mir_gen_register_dynamic_local(rw_local)
  mir_lower_gen::mir_gen_register_dynamic_local(res_local)
  ctx.mir_emit_store_var(rw_local, rw_val)
  ctx.mir_emit_store_var(res_local, ctx.mir_emit_const_int(0))

  # CAS attempt block: load state, if >= 0 try CAS(state, state+1)
  var cas_block = ctx.mir_create_block("arl_cas")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, cas_block)
  ctx.mir_switch_to_block(cas_block)

  var rw_r = ctx.mir_emit_load_var(rw_local)
  # Load state atomically
  var ld_a = vec_new()
  ld_a.push(rw_r)
  var state = ctx.mir_emit_intrinsic("atomic_load", ld_a)
  var is_readable = ctx.mir_emit_binary(op_constants::OP_GE, state, ctx.mir_emit_const_int(0))

  var try_block = ctx.mir_create_block("arl_try")
  var contend_block = ctx.mir_create_block("arl_contend")
  mir_block_set_branch(ctx.mir_ctx_get_block(), is_readable, try_block, contend_block)

  # Try CAS: state → state+1
  ctx.mir_switch_to_block(try_block)
  var cas_a = vec_new()
  var rw_t = ctx.mir_emit_load_var(rw_local)
  cas_a.push(rw_t)
  cas_a.push(state)
  var inc = ctx.mir_emit_binary(op_constants::OP_ADD, state, ctx.mir_emit_const_int(1))
  cas_a.push(inc)
  var cas_ok = ctx.mir_emit_intrinsic("atomic_cas", cas_a)
  var got = ctx.mir_emit_binary(op_constants::OP_EQ, cas_ok, ctx.mir_emit_const_int(1))

  var got_block = ctx.mir_create_block("arl_got")
  mir_block_set_branch(ctx.mir_ctx_get_block(), got, got_block, cas_block)

  # Got lock
  ctx.mir_switch_to_block(got_block)
  var rw_g = ctx.mir_emit_load_var(rw_local)
  var val = ctx.mir_emit_load_offset(rw_g, 1)
  ctx.mir_emit_store_var(res_local, val)
  var done_block = ctx.mir_create_block("arl_done")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, done_block)

  # Contended: enqueue + park
  ctx.mir_switch_to_block(contend_block)
  var rw_c = ctx.mir_emit_load_var(rw_local)
  var imtx = ctx.mir_emit_load_offset(rw_c, 5)
  var lk = vec_new()
  lk.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_lock", lk)

  # Parking-lot-style re-check under the wait-list lock. Same shape as
  # async_mutex_lock: load state, retry the read-acquire CAS (state+1 if
  # state >= 0), and if it succeeds, release the internal mutex and jump
  # to got_block without parking. Without this, the writer's unlock path
  # could observe an empty wait list between our outer CAS fail and our
  # internal-mutex acquire, leaving us parked forever.
  var rw_rc = ctx.mir_emit_load_var(rw_local)
  var rc_ld_a = vec_new()
  rc_ld_a.push(rw_rc)
  var rc_state = ctx.mir_emit_intrinsic("atomic_load", rc_ld_a)
  var rc_readable = ctx.mir_emit_binary(op_constants::OP_GE, rc_state, ctx.mir_emit_const_int(0))
  var rc_try_blk = ctx.mir_create_block("arl_rc_try")
  var rc_append_blk = ctx.mir_create_block("arl_rc_append")
  mir_block_set_branch(ctx.mir_ctx_get_block(), rc_readable, rc_try_blk, rc_append_blk)

  ctx.mir_switch_to_block(rc_try_blk)
  var rw_rc2 = ctx.mir_emit_load_var(rw_local)
  var rc_cas_a = vec_new()
  rc_cas_a.push(rw_rc2)
  rc_cas_a.push(rc_state)
  var rc_inc = ctx.mir_emit_binary(op_constants::OP_ADD, rc_state, ctx.mir_emit_const_int(1))
  rc_cas_a.push(rc_inc)
  var rc_cas_ok = ctx.mir_emit_intrinsic("atomic_cas", rc_cas_a)
  var rc_got = ctx.mir_emit_binary(op_constants::OP_EQ, rc_cas_ok, ctx.mir_emit_const_int(1))
  var rc_got_blk = ctx.mir_create_block("arl_rc_got")
  mir_block_set_branch(ctx.mir_ctx_get_block(), rc_got, rc_got_blk, rc_append_blk)

  ctx.mir_switch_to_block(rc_got_blk)
  var rc_ulk_a = vec_new()
  rc_ulk_a.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", rc_ulk_a)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, got_block)

  ctx.mir_switch_to_block(rc_append_blk)

  var nd = ctx.mir_emit_alloc(3)
  var fa = vec_new()
  var frm = ctx.mir_emit_intrinsic("task_frame", fa)
  ctx.mir_emit_store_offset(nd, 0, frm)
  ctx.mir_emit_store_offset(nd, 1, ctx.mir_emit_const_int(0))
  ctx.mir_emit_store_offset(nd, 2, ctx.mir_emit_const_int(0))

  # Simplified: set as head+tail (correct for single-waiter; multi-waiter needs chain)
  var rw_e = ctx.mir_emit_load_var(rw_local)
  var tail = ctx.mir_emit_load_offset(rw_e, 3)
  var empty = ctx.mir_emit_binary(op_constants::OP_EQ, tail, ctx.mir_emit_const_int(0))
  var hb = ctx.mir_create_block("arl_hd")
  var cb = ctx.mir_create_block("arl_ch")
  mir_block_set_branch(ctx.mir_ctx_get_block(), empty, hb, cb)

  ctx.mir_switch_to_block(hb)
  var rw_h = ctx.mir_emit_load_var(rw_local)
  ctx.mir_emit_store_offset(rw_h, 2, nd)
  var eq = ctx.mir_create_block("arl_eq")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eq)

  ctx.mir_switch_to_block(cb)
  ctx.mir_emit_store_offset(tail, 1, nd)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eq)

  ctx.mir_switch_to_block(eq)
  var rw_q = ctx.mir_emit_load_var(rw_local)
  ctx.mir_emit_store_offset(rw_q, 3, nd)

  var ulk = vec_new()
  ulk.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", ulk)

  var pk = vec_new()
  ctx.mir_emit_intrinsic("sched_set_park_pending", pk)
  mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, cas_block)

  ctx.mir_switch_to_block(done_block)
  return ctx.mir_emit_load_var(res_local)
end

## Emit park-based async_rwlock_write: CAS 0→-1 + park on contention.
def mir_emit_async_rwlock_write(ctx: MirContext, rw_val: Int): Int
  var id = _aml_counter
  _aml_counter = _aml_counter + 1
  var rw_local = "__awl_rw_#{id}"
  var res_local = "__awl_res_#{id}"
  mir_lower_gen::mir_gen_register_dynamic_local(rw_local)
  mir_lower_gen::mir_gen_register_dynamic_local(res_local)
  ctx.mir_emit_store_var(rw_local, rw_val)
  ctx.mir_emit_store_var(res_local, ctx.mir_emit_const_int(0))

  var cas_block = ctx.mir_create_block("awl_cas")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, cas_block)
  ctx.mir_switch_to_block(cas_block)

  var rw_r = ctx.mir_emit_load_var(rw_local)
  var cas_a = vec_new()
  cas_a.push(rw_r)
  cas_a.push(ctx.mir_emit_const_int(0))
  cas_a.push(ctx.mir_emit_const_int(-1))
  var cas_ok = ctx.mir_emit_intrinsic("atomic_cas", cas_a)
  var got = ctx.mir_emit_binary(op_constants::OP_EQ, cas_ok, ctx.mir_emit_const_int(1))

  var got_block = ctx.mir_create_block("awl_got")
  var contend_block = ctx.mir_create_block("awl_contend")
  mir_block_set_branch(ctx.mir_ctx_get_block(), got, got_block, contend_block)

  ctx.mir_switch_to_block(got_block)
  var rw_g = ctx.mir_emit_load_var(rw_local)
  var val = ctx.mir_emit_load_offset(rw_g, 1)
  ctx.mir_emit_store_var(res_local, val)
  var done_block = ctx.mir_create_block("awl_done")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, done_block)

  ctx.mir_switch_to_block(contend_block)
  var rw_c = ctx.mir_emit_load_var(rw_local)
  var imtx = ctx.mir_emit_load_offset(rw_c, 5)
  var lk = vec_new()
  lk.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_lock", lk)

  # Parking-lot-style re-check: under the wait-list lock, retry CAS 0→-1
  # to acquire the write lock. Same race-avoidance rationale as
  # async_mutex_lock and async_rwlock_read above. Without this re-check,
  # the writer could park after the last reader/writer has already released.
  var rw_wrc = ctx.mir_emit_load_var(rw_local)
  var wrc_cas_a = vec_new()
  wrc_cas_a.push(rw_wrc)
  wrc_cas_a.push(ctx.mir_emit_const_int(0))
  wrc_cas_a.push(ctx.mir_emit_const_int(-1))
  var wrc_cas_ok = ctx.mir_emit_intrinsic("atomic_cas", wrc_cas_a)
  var wrc_got = ctx.mir_emit_binary(op_constants::OP_EQ, wrc_cas_ok, ctx.mir_emit_const_int(1))
  var wrc_got_blk = ctx.mir_create_block("awl_rc_got")
  var wrc_append_blk = ctx.mir_create_block("awl_rc_append")
  mir_block_set_branch(ctx.mir_ctx_get_block(), wrc_got, wrc_got_blk, wrc_append_blk)

  ctx.mir_switch_to_block(wrc_got_blk)
  var wrc_ulk_a = vec_new()
  wrc_ulk_a.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", wrc_ulk_a)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, got_block)

  ctx.mir_switch_to_block(wrc_append_blk)

  var nd = ctx.mir_emit_alloc(3)
  var fa = vec_new()
  var frm = ctx.mir_emit_intrinsic("task_frame", fa)
  ctx.mir_emit_store_offset(nd, 0, frm)
  ctx.mir_emit_store_offset(nd, 1, ctx.mir_emit_const_int(0))
  ctx.mir_emit_store_offset(nd, 2, ctx.mir_emit_const_int(1))

  var rw_e = ctx.mir_emit_load_var(rw_local)
  var tail = ctx.mir_emit_load_offset(rw_e, 3)
  var empty = ctx.mir_emit_binary(op_constants::OP_EQ, tail, ctx.mir_emit_const_int(0))
  var hb = ctx.mir_create_block("awl_hd")
  var chb = ctx.mir_create_block("awl_ch")
  mir_block_set_branch(ctx.mir_ctx_get_block(), empty, hb, chb)

  ctx.mir_switch_to_block(hb)
  var rw_h = ctx.mir_emit_load_var(rw_local)
  ctx.mir_emit_store_offset(rw_h, 2, nd)
  var eqb = ctx.mir_create_block("awl_eq")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eqb)

  ctx.mir_switch_to_block(chb)
  ctx.mir_emit_store_offset(tail, 1, nd)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eqb)

  ctx.mir_switch_to_block(eqb)
  var rw_q = ctx.mir_emit_load_var(rw_local)
  ctx.mir_emit_store_offset(rw_q, 3, nd)

  var ulk = vec_new()
  ulk.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", ulk)

  var pk = vec_new()
  ctx.mir_emit_intrinsic("sched_set_park_pending", pk)
  mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, cas_block)

  ctx.mir_switch_to_block(done_block)
  return ctx.mir_emit_load_var(res_local)
end

## Emit park-based async_mutex_lock: CAS loop + wait list + sched_park suspend.
## Called from mir_lower_call when async_mutex_lock is used inside an async $poll.
## mtx_val: MIR register containing the mutex pointer.
def mir_emit_async_mutex_lock(ctx: MirContext, mtx_val: Int): Int
  # Unique names per call site to avoid collision when locking multiple mutexes
  var id = _aml_counter
  _aml_counter = _aml_counter + 1
  var mtx_local = "__aml_mtx_#{id}"
  var result_local = "__aml_res_#{id}"
  mir_lower_gen::mir_gen_register_dynamic_local(mtx_local)
  mir_lower_gen::mir_gen_register_dynamic_local(result_local)
  ctx.mir_emit_store_var(mtx_local, mtx_val)
  ctx.mir_emit_store_var(result_local, ctx.mir_emit_const_int(0))

  var cas_block = ctx.mir_create_block("aml_cas")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, cas_block)
  ctx.mir_switch_to_block(cas_block)

  var mtx_r = ctx.mir_emit_load_var(mtx_local)
  var cas_a = vec_new()
  cas_a.push(mtx_r)
  cas_a.push(ctx.mir_emit_const_int(0))
  cas_a.push(ctx.mir_emit_const_int(1))
  var old_val = ctx.mir_emit_intrinsic("atomic_cas", cas_a)
  var acquired = ctx.mir_emit_binary(op_constants::OP_EQ, old_val, ctx.mir_emit_const_int(1))

  var got_block = ctx.mir_create_block("aml_got")
  var contend_block = ctx.mir_create_block("aml_contend")
  mir_block_set_branch(ctx.mir_ctx_get_block(), acquired, got_block, contend_block)

  # Got lock: set owner frame, load value, jump to done
  ctx.mir_switch_to_block(got_block)
  var mtx_g = ctx.mir_emit_load_var(mtx_local)
  var fa_g = vec_new()
  var owner_frame = ctx.mir_emit_intrinsic("task_frame", fa_g)
  ctx.mir_emit_store_offset(mtx_g, 1, owner_frame)
  var val_got = ctx.mir_emit_load_offset(mtx_g, 5)
  ctx.mir_emit_store_var(result_local, val_got)
  var done_block = ctx.mir_create_block("aml_done")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, done_block)

  # Contended path: mutex_lock/unlock + park
  ctx.mir_switch_to_block(contend_block)
  var mtx_c = ctx.mir_emit_load_var(mtx_local)
  var imtx = ctx.mir_emit_load_offset(mtx_c, 6)

  var lk_a = vec_new()
  lk_a.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_lock", lk_a)

  # Parking-lot-style re-check: after acquiring the wait-list lock, retry
  # the fast-path CAS before committing to append + park. Without this
  # re-check, the holder could complete its entire unlock path (store 0,
  # acquire internal mutex, observe empty wait list, release internal
  # mutex, return) in the window between our fast-path CAS failure and
  # our acquisition of the internal mutex — leaving us appended and
  # parked with nobody to wake us. With the re-check, either the holder
  # has released (CAS succeeds → acquire without parking) or the holder
  # still holds (CAS fails → we append, and the holder's future unlock
  # path will observe us because it takes the internal mutex after
  # releasing the lock state).
  var mtx_rc = ctx.mir_emit_load_var(mtx_local)
  var rc_cas_a = vec_new()
  rc_cas_a.push(mtx_rc)
  rc_cas_a.push(ctx.mir_emit_const_int(0))
  rc_cas_a.push(ctx.mir_emit_const_int(1))
  var rc_success = ctx.mir_emit_intrinsic("atomic_cas", rc_cas_a)
  var rc_got_blk = ctx.mir_create_block("aml_rc_got")
  var rc_append_blk = ctx.mir_create_block("aml_rc_append")
  mir_block_set_branch(ctx.mir_ctx_get_block(), rc_success, rc_got_blk, rc_append_blk)

  # Re-check CAS won: release internal mutex, jump to got_block (shared
  # acquired path — stores owner frame and loads value).
  ctx.mir_switch_to_block(rc_got_blk)
  var rc_ulk_a = vec_new()
  rc_ulk_a.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", rc_ulk_a)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, got_block)

  # Re-check CAS lost: proceed with the append + park sequence below.
  ctx.mir_switch_to_block(rc_append_blk)

  # Allocate wait node [frame, next=0]
  var nd = ctx.mir_emit_alloc(2)
  var fa2 = vec_new()
  var frm = ctx.mir_emit_intrinsic("task_frame", fa2)
  ctx.mir_emit_store_offset(nd, 0, frm)
  ctx.mir_emit_store_offset(nd, 1, ctx.mir_emit_const_int(0))

  # Append to linked wait list: branch on empty
  var mtx_t = ctx.mir_emit_load_var(mtx_local)
  var tail = ctx.mir_emit_load_offset(mtx_t, 3)
  var empty = ctx.mir_emit_binary(op_constants::OP_EQ, tail, ctx.mir_emit_const_int(0))
  var hd_blk = ctx.mir_create_block("aml_hd")
  var ch_blk = ctx.mir_create_block("aml_ch")
  mir_block_set_branch(ctx.mir_ctx_get_block(), empty, hd_blk, ch_blk)

  # Empty: set head = node
  ctx.mir_switch_to_block(hd_blk)
  var mtx_h = ctx.mir_emit_load_var(mtx_local)
  ctx.mir_emit_store_offset(mtx_h, 2, nd)
  var eq_blk = ctx.mir_create_block("aml_eq")
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eq_blk)

  # Non-empty: chain to tail.next
  ctx.mir_switch_to_block(ch_blk)
  ctx.mir_emit_store_offset(tail, 1, nd)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, eq_blk)

  # Set tail = node, increment count
  ctx.mir_switch_to_block(eq_blk)
  var mtx_e = ctx.mir_emit_load_var(mtx_local)
  ctx.mir_emit_store_offset(mtx_e, 3, nd)
  var wc = ctx.mir_emit_load_offset(mtx_e, 4)
  var wc1 = ctx.mir_emit_binary(op_constants::OP_ADD, wc, ctx.mir_emit_const_int(1))
  ctx.mir_emit_store_offset(mtx_e, 4, wc1)

  # Unlock internal mutex (raw pthread — no value slot).
  var ulk_a = vec_new()
  ulk_a.push(imtx)
  ctx.mir_emit_intrinsic("pthread_mtx_unlock", ulk_a)

  # PARK + yield suspend → resume at CAS retry
  var pk_a = vec_new()
  ctx.mir_emit_intrinsic("sched_set_park_pending", pk_a)
  mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, cas_block)

  ctx.mir_switch_to_block(done_block)
  return ctx.mir_emit_load_var(result_local)
end

## transparently creates the state machine and yields.
##
## Returns the call result (loaded from callee frame[1] when done).
def mir_emit_colorless_call(ctx: MirContext, callee_name: String, args: Vec<Int>): Int
  # Record the outer function as suspendable (it transitively suspends via colorless call)
  var outer_fn = mir_lower_gen::mir_gen_get_async_func_name()
  if str_byte_len(outer_fn) > 0
    mir_lower_async_registry::mir_record_suspendable_leaf(outer_fn)
    mir_lower_async_registry::mir_record_effect_leaf(outer_fn, 2)  # EFFECT_SUSPEND
  end

  # Create the callee's async frame: __Future_callee$new(args)
  var ctor_name = "__Future_#{callee_name}$new"
  var frame = ctx.mir_emit_call(ctor_name, args)

  # Store frame in a synthetic local variable for save/restore across suspends
  var frame_var_name = "__colorless_frame_#{callee_name}"
  ctx.mir_emit_store_var(frame_var_name, frame)
  mir_lower_gen::mir_gen_register_dynamic_local(frame_var_name)

  # First poll of inner future
  var poll_fn = ctx.mir_emit_load_offset(frame, 2)
  var poll_args = vec_new()
  poll_args.push(frame)
  var poll_result = ctx.mir_emit_call_indirect(poll_fn, poll_args)

  # Check if done (poll returns 1 = POLL_READY)
  var is_ready = ctx.mir_emit_binary(op_constants::OP_EQ, poll_result, ctx.mir_emit_const_int(1))
  var done_blk = ctx.mir_create_block("cl_done")
  var suspend_blk = ctx.mir_create_block("cl_suspend")
  mir_block_set_branch(ctx.mir_ctx_get_block(), is_ready, done_blk, suspend_blk)

  # === Suspend: save locals, set state, return poll_result (propagate fd encoding) ===
  ctx.mir_switch_to_block(suspend_blk)
  var next_state = mir_lower_gen::mir_gen_inc_yield_counter()
  var local_names = mir_lower_gen::mir_gen_get_local_names()
  var local_offsets = mir_lower_gen::mir_gen_get_local_offsets()
  var self_frame = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
  for si in 0..local_names.size
    var lv = ctx.mir_emit_load_var(local_names[si])
    ctx.mir_emit_store_offset(self_frame, local_offsets[si], lv)
  end
  ctx.mir_emit_store_offset(self_frame, 0, ctx.mir_emit_const_int(next_state))
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, poll_result)

  # === Resume block: restore locals, re-poll inner future ===
  var resume_blk = ctx.mir_create_block("cl_resume")
  mir_lower_gen::mir_gen_add_resume_block(resume_blk)
  ctx.mir_switch_to_block(resume_blk)
  var self_r = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
  for ri in 0..local_names.size
    var restored = ctx.mir_emit_load_offset(self_r, local_offsets[ri])
    ctx.mir_emit_store_var(local_names[ri], restored)
  end

  # Re-poll the inner future (handle was restored from frame)
  var frame_r = ctx.mir_emit_load_var(frame_var_name)
  var poll_fn_r = ctx.mir_emit_load_offset(frame_r, 2)
  var poll_args_r = vec_new()
  poll_args_r.push(frame_r)
  var poll_result_r = ctx.mir_emit_call_indirect(poll_fn_r, poll_args_r)

  var is_ready_r = ctx.mir_emit_binary(op_constants::OP_EQ, poll_result_r, ctx.mir_emit_const_int(1))
  var resuspend_blk = ctx.mir_create_block("cl_resuspend")
  mir_block_set_branch(ctx.mir_ctx_get_block(), is_ready_r, done_blk, resuspend_blk)

  # === Re-suspend with same state (creates loop through executor) ===
  ctx.mir_switch_to_block(resuspend_blk)
  var self_rs = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
  for rsi in 0..local_names.size
    var lv_rs = ctx.mir_emit_load_var(local_names[rsi])
    ctx.mir_emit_store_offset(self_rs, local_offsets[rsi], lv_rs)
  end
  ctx.mir_emit_store_offset(self_rs, 0, ctx.mir_emit_const_int(next_state))
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, poll_result_r)

  # === Done: load result from inner future's frame[1] ===
  ctx.mir_switch_to_block(done_blk)
  var frame_done = ctx.mir_emit_load_var(frame_var_name)
  return ctx.mir_emit_load_offset(frame_done, 1)
end

## A.35 — resolve a (possibly cross-module) concrete receiver type to the
## module-qualified prefix under which its `func_name` method is mangled.
## Given bare type `SortedMap` + method `size`, suffix-searches `all_funcs`
## for the real symbol `sorted_map$SortedMap$size` and returns the prefix
## `sorted_map$SortedMap` so the caller's existing `prefix$func$arity` /
## `prefix$func` mangling resolves (and default-arg expansion still runs).
## Returns "" when no such method exists.
##
## Needed for bounded-generic dispatch `c.method()` where `c: T, T: Trait`
## and T's concrete type lives in a DIFFERENT module than the generic spec
## (e.g. `get_size<T: Container>` in the test file dispatching to `SortedMap`
## in `sorted_map`). The unprefixed `Type$func` and the spec's own module
## prefix both miss the cross-module symbol, so dispatch otherwise falls
## through to the typecheck pre-mangled FIRST trait impl (`queue$Queue$size`
## for every T) — calling the wrong type's method, which reads garbage when
## the layouts differ. Same suffix-search idiom as `emit_drops_for_scope`.
def _mir_resolve_xmod_type_prefix(ctx: MirContext, type_name: String, func_name: String, arity: Int): String
  var all_funcs = ctx.mir_ctx_get_all_funcs()
  if all_funcs == 0
    return ""
  end
  # Arity-mangled form first (overloaded methods), then the bare form.
  var suffix_arity = "$#{type_name}$#{func_name}$#{arity}"
  var suffix_bare = "$#{type_name}$#{func_name}"
  var strip_arity = str_byte_len(suffix_arity) - str_byte_len("$#{type_name}")
  var strip_bare = str_byte_len(suffix_bare) - str_byte_len("$#{type_name}")
  for i in 0..all_funcs.size
    var e = all_funcs[i]
    if e.tag == 0 and str_ends_with(e.name, suffix_arity)
      return str_byte_slice(e.name, 0, str_byte_len(e.name) - strip_arity)
    end
  end
  for j in 0..all_funcs.size
    var e2 = all_funcs[j]
    if e2.tag == 0 and str_ends_with(e2.name, suffix_bare)
      return str_byte_slice(e2.name, 0, str_byte_len(e2.name) - strip_bare)
    end
  end
  return ""
end

## A.36 — generic-struct extend-method monomorphization router.
## Given a resolved method symbol `func_name` (e.g. "ITLift$itg_go", possibly
## module-qualified "mod$ITLift$itg_go") and the receiver's inferred concrete
## instantiation type `recv_full` (e.g. "ITLift<ITBase>"), decide whether this
## is a call on a generic struct's extend-method. If so, queue a per-type-arg
## specialization and return its symbol ("ITLift$itg_go$ITBase"); otherwise "".
## The spec body lowers with the struct's params bound to the concrete args, so
## a `@field.method()` dispatch inside it resolves to the field's concrete
## method instead of self-recursing into the un-monomorphized symbol.
def _mir_try_struct_method_spec(ctx: MirContext, func_name: String, recv_full: String): String
  # Receiver must be a parameterized instantiation (carries concrete <...> args).
  var lt = __char_index(recv_full, '<')
  if lt <= 0
    return ""
  end
  # Bare struct name = last '$'-segment before '<' (strip any module prefix).
  var struct_qual = str_byte_slice(recv_full, 0, lt)
  var struct_bare = _mir_last_seg(struct_qual)
  # Struct must be generic.
  var tparams = mir::mir_get_struct_type_params(struct_bare)
  if str_byte_len(tparams) == 0
    return ""
  end
  # func_name must be an extend-method symbol "...$Struct$method": its method
  # qualifier's last segment must equal the receiver's struct.
  var last_d = _mir_last_dollar(func_name)
  if last_d <= 0
    return ""
  end
  var method_qual = str_byte_slice(func_name, 0, last_d)
  if _mir_last_seg(method_qual) != struct_bare
    return ""
  end
  # The method must be a real (tag-0) function we can re-lower as a spec.
  var entry_opt = ctx.mir_lookup_function(func_name)
  if entry_opt.is_none()
    return ""
  end
  var entry = entry_opt.unwrap()
  if entry.tag != 0
    return ""
  end
  # Concrete type args from the instantiation.
  var cargs = mir::mir_type_args_of(recv_full)
  if cargs.size == 0
    return ""
  end
  # Build the spec symbol (base$flat(arg)...) — must match the drain-loop and
  # mir_lower_struct_method_spec mangling exactly.
  var spec_name = func_name
  var cargs_int = vec_new()
  var cc = cargs.size
  for i in 0..cc
    var ca = as_string(cargs[i])
    cargs_int.push(as_int(ca))
    if str_byte_len(ca) > 0
      var flat = mir_lower::mir_flatten_type_for_symbol(ca)
      spec_name = "#{spec_name}$#{flat}"
    end
  end
  # No concrete components contributed — nothing to specialize on.
  if spec_name == func_name
    return ""
  end
  var specs = ctx.mir_ctx_get_pending_specs()
  var spec_entry = mir::PendingSpec { base_name: func_name, arg_types: cargs_int, ast_store: entry.ast_store, func_handle: entry.node_id, struct_name: struct_bare, type_params: tparams }
  specs.push(spec_entry)
  return spec_name
end

## Return the substring after the last '$' (or the whole string if none).
def _mir_last_seg(name: String): String
  var d = _mir_last_dollar(name)
  if d < 0
    return name
  end
  return str_byte_slice(name, d + 1, str_byte_len(name))
end

## Index of the last '$' in `name`, or -1.
def _mir_last_dollar(name: String): Int
  var d = -1
  var n = str_byte_len(name)
  for i in 0..n
    if str_byte_at(name, i) == '$'
      d = i
    end
  end
  return d
end

# === enum-niche M2.3 — niche-aware COLD Result combinator interception ===
# Call-site interception for the closure-taking / Result-returning combinators on a
# niche-MULTI built-in `Result<&A,&B>` (the single word `payload_ptr | tag`: tag =
# `value & 7` ⇒ Ok ⇔ 0, payload = `value & ~7`). The erased std bodies
# (`result_map<T,E,U>`/`result_map_err`/`result_and_then`/`ok`/`err` in std/prelude.qz)
# read the Result via the BOXED spill layout and would `inttoptr`+offset-load the packed
# word ⇒ SEGFAULT — so M2 v1 hard-rejected them (QZ0212). M2.3 LIFTS the reject by
# inlining niche-aware MIR here, exactly as the hot combinators are intercepted above.
#
# `op`: 1=result_map  2=result_map_err  3=result_and_then  4=ok  5=err.
# Returns the result SSA reg, or -1 to signal "fall back" (the ok/err defensive case
# where the produced Option is NOT niche-eligible — keep the conservative reject for
# soundness rather than mis-build a spill Option from a niche word).
#
# CRITICAL: real blocks + branch, NOT mir_emit_select — select is EAGER and would
# invoke the closure `f` on BOTH arms, calling f(garbage_ptr) on the wrong arm ⇒
# SEGFAULT. The closure is lowered + invoked ONLY inside the taken arm's block. The
# per-arm result threads through a scratch var (mir_emit_store_var / load_var at the
# merge), mirroring the try-catch merge (mir_lower_try ~457-466). Construct seams MUST
# agree byte-for-byte with mir_lower.qz ~3818-3848 (niche Result/Option construction):
#   niche Result: Ok ⇒ bare ptr (tag 0, NO OR), Err ⇒ OP_OR(ptr, 1).
#   niche Option: Some ⇒ identity, None ⇒ const mir_option_none_const(ctx, payload).
## item 42 (Part 1) — value-layout-spill Result/Option combinator interception.
## The erased prelude combinators (`result_map`/`result_and_then`/`option_map`/
## `option_and_then`) read the Ok/Some payload slot as a BOXED POINTER (`load_offset`
## + `inttoptr` inside the user fn). For a VALUE-LAYOUT (`@value` / flip-eligible)
## payload the slot holds inline FIELD WORDS (the construct side inlines them —
## mir_lower.qz is_oR path), so the erased body passes a field VALUE where the user fn
## expects a pointer → deref `0x7` → SIGSEGV. There is no monomorphization to teach the
## erased body, so — exactly like the niche-multi cold intercept — replace the CALL with
## inline value-layout-aware MIR at the call site.
##
## `op`: 1=result_map 2=result_map_err 3=result_and_then 6=option_map 7=option_and_then.
## Layout contract (mirrors item 40 / §14.10.Q4 construct-must-match-read):
##   - subject is a SPILL box `[tag@0, payload_fields@1+]` (FLAT, header-less).
##   - the MAPPED arm's interior payload address = box + 8 (word 1). A Result is either
##     Ok or Err, so BOTH payloads share that single word-1 slot — the mapped side is the
##     Ok/Some arm for op 1/3/6/7 and the Err arm for op 2 (item 42f, result_map_err).
##   - the user fn's VALUE param reads its fields at offset+0 (≤16B flat) or offset+1
##     (>16B COW header-skip). So for ≤16B we pass `box+8` directly; for >16B we rebuild
##     a COW buffer `[refcount=1, fields@1+]` (mir_emit_cow_construct_buffer) before the
##     call so the fn's +1 reads land correctly.
##   - the output box is constructed INLINE-embedding the fn's return value (mapped fields
##     word-copied into box+8), the same shape Part-3 consumer inference reads back. The
##     output tag is the mapped variant's index (Ok=0 for op 1/6, Err=1 for op 2). For
##     *_and_then the fn already returns a constructed Result/Option, so it passes through.
##   - the PASSTHROUGH arm (Err/None for op 1/3/6/7, Ok for op 2) passes the spill box
##     through UNCHANGED. That is correct for ANY payload layout (scalar, pointer, niche,
##     OR value-layout): `Result<U,E>`/`Result<T,F>` keeps the same {tag, payload} spill
##     shape on the un-mapped arm, so the carrier box is byte-compatible. This makes the
##     intercept safe to fire whenever EITHER side is value-layout — the un-mapped scalar/
##     pointer side never goes through the value-layout read, it rides the box.
##
## GATE-0-INERT: gated by mir_result_subject_is_inline_value /
## mir_result_subject_err_is_inline_value / mir_option_subject_is_inline_value (all ⇒
## mir_is_value_layout_type, false for every gate-0 payload) at the dispatch site ⇒ this
## is never reached at gate 0 ⇒ byte-identical self-host.
def mir_lower_value_combinator_intercept(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, op: Int, arg_nodes: Vec<Int>): Int
  var is_result = op == 1 or op == 2 or op == 3
  # item 42f — op 2 (result_map_err) maps the ERR arm; all others map the Ok/Some arm.
  var maps_err = op == 2
  var subj_node = arg_nodes[0]
  var subj_ty = mir::mir_infer_expr_type(ctx, s, subj_node)

  # Recover the MAPPED payload struct (input T for Ok-map, E for Err-map).
  var in_pt = ""
  if maps_err == 1
    in_pt = mir::mir_result_err_type(subj_ty)
  elsif is_result == 1
    in_pt = mir::mir_result_ok_type(subj_ty)
  else
    in_pt = mir::mir_option_payload_of_type(subj_ty)
  end
  var in_stripped = mir::mir_strip_generic_head(in_pt)
  var in_res = mir::mir_resolve_struct_name(ctx, in_stripped)
  var in_fc = ctx.mir_ctx_struct_field_count(in_res)
  var in_cow = mir::mir_value_is_cow_layout(ctx, in_res)
  # item 42f — the MAPPED side may itself be scalar/pointer (e.g. result_map fired
  # because only the ERR side is value-layout). When the mapped payload is NOT value-
  # layout, the user fn expects the boxed-slot VALUE (load_offset box[word1]) exactly
  # as the erased body passed it — NOT the interior address. Branch on this so a mixed
  # Result<scalar, @value> / Result<@value, scalar> maps the correct side correctly.
  var mapped_is_value = mir::mir_is_value_layout_type(ctx, in_stripped)

  # Lower the subject to the spill box pointer; tag at word 0.
  var box = mir_lower::mir_lower_expr(ctx, s, subj_node)
  var tag = ctx.mir_emit_load_offset(box, 0)
  var zero = ctx.mir_emit_const_int(0)
  # Branch-true selects the MAPPED arm: Ok (tag==0) for Ok-map, Err (tag!=0) for Err-map.
  var take_mapped = 0
  if maps_err == 1
    take_mapped = ctx.mir_emit_binary(op_constants::OP_NE, tag, zero)
  else
    take_mapped = ctx.mir_emit_binary(op_constants::OP_EQ, tag, zero)
  end

  var result_name = "__vlc_result"
  var result_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(result_name, result_slot)

  var mapped_block = ctx.mir_create_block("vlc_mapped")
  var pass_block = ctx.mir_create_block("vlc_pass")
  var end_block = ctx.mir_create_block("vlc_end")
  var cur_block = ctx.mir_ctx_get_block()
  mir_block_set_branch(cur_block, take_mapped, mapped_block, pass_block)

  # --- Mapped arm (Ok/Some for op 1/3/6/7; Err for op 2) ---
  ctx.mir_switch_to_block(mapped_block)
  # The arg the user fn receives. Value-layout mapped payload ⇒ pass the INTERIOR
  # ADDRESS box+8 (≤16B flat) or a rebuilt COW buffer (>16B), since the fn's value
  # param reads fields at offset+0 / offset+1. NON-value-layout (scalar/pointer)
  # mapped payload ⇒ pass the boxed-slot VALUE load_offset(box, 1) exactly as the
  # erased body did (item 42f mixed-layout Result).
  var fn_arg_ptr = 0
  if mapped_is_value == 1
    var eight = ctx.mir_emit_const_int(8)
    var interior = ctx.mir_emit_binary(op_constants::OP_ADD, box, eight)
    fn_arg_ptr = interior
    if in_cow == 1
      var cow_buf = mir::mir_emit_cow_construct_buffer(ctx, in_fc, in_res)
      for ci in 0..in_fc
        var w = ctx.mir_emit_load_offset(interior, ci)
        ctx.mir_emit_store_offset(cow_buf, 1 + ci, w)
      end
      fn_arg_ptr = cow_buf
    end
  else
    fn_arg_ptr = ctx.mir_emit_load_offset(box, 1)
  end
  var fnref = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
  var call_args = vec_new()
  call_args.push(fn_arg_ptr)
  var mapped = ctx.mir_emit_call_indirect(fnref, call_args)

  if op == 3 or op == 7
    # and_then: the fn returns a fully-constructed Result/Option already.
    ctx.mir_emit_store_var(result_name, mapped)
  else
    # map / map_err: construct the output box embedding the mapped value. The output
    # mapped-variant tag is Ok=0 (op 1/6) or Err=1 (op 2, item 42f).
    var out_tag = 0
    if maps_err == 1
      out_tag = 1
    end
    var out_tag_v = ctx.mir_emit_const_int(out_tag)
    var out_u = mir::mir_combinator_output_payload(ctx, s, op, arg_nodes[1])
    var out_stripped = mir::mir_strip_generic_head(out_u)
    var out_is_value = 0
    if str_byte_len(out_u) > 0
      out_is_value = mir::mir_is_value_layout_type(ctx, out_stripped)
    end
    if out_is_value == 1
      # Value-layout output: INLINE-embed the mapped value's fields into box[word1+].
      # `mapped` is a pointer to the returned value's words; fields live at offset
      # src_base (0 ≤16B flat, 1 >16B COW header). Word-copy into box+1.., matching
      # the construct-side is_oR path the Part-3 consumer inference reads back.
      var out_res = mir::mir_resolve_struct_name(ctx, out_stripped)
      var out_fc = ctx.mir_ctx_struct_field_count(out_res)
      var out_cow = mir::mir_value_is_cow_layout(ctx, out_res)
      var out_box = ctx.mir_emit_alloc(1 + out_fc)
      ctx.mir_emit_store_offset(out_box, 0, out_tag_v)
      var src_base = 0
      if out_cow == 1
        src_base = 1
      end
      for oi in 0..out_fc
        var ow = ctx.mir_emit_load_offset(mapped, src_base + oi)
        ctx.mir_emit_store_offset(out_box, 1 + oi, ow)
      end
      ctx.mir_emit_store_var(result_name, out_box)
    else
      # Scalar/pointer output: `mapped` IS the value. Build a 2-word spill box
      # [tag@0, value@1], the same shape the erased Result::Ok/Err construct produces.
      var out_box2 = ctx.mir_emit_alloc(2)
      ctx.mir_emit_store_offset(out_box2, 0, out_tag_v)
      ctx.mir_emit_store_offset(out_box2, 1, mapped)
      ctx.mir_emit_store_var(result_name, out_box2)
    end
  end
  var mapped_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(mapped_cur) < 0
    mir_block_set_terminator(mapped_cur, mir::TERM_JUMP, end_block)
  end

  # --- Passthrough arm (Err/None for op 1/3/6/7; Ok for op 2): pass the spill box
  # through unchanged. Correct for any un-mapped payload layout (the carrier box keeps
  # the {tag, payload} shape the output Result/Option expects on this arm).
  ctx.mir_switch_to_block(pass_block)
  ctx.mir_emit_store_var(result_name, box)
  var pass_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(pass_cur) < 0
    mir_block_set_terminator(pass_cur, mir::TERM_JUMP, end_block)
  end

  # --- Merge ---
  ctx.mir_switch_to_block(end_block)
  return ctx.mir_emit_load_var(result_name)
end

## item 42b — value-layout `ok(r)` / `err(r)` interception. These CONVERT a
## `Result<T,E>` into `Option<T>` (`ok`) / `Option<E>` (`err`), discarding the other
## arm. The erased prelude bodies (`Option::Some(v)` where `v` is the matched payload)
## read the Result's present payload as a BOXED POINTER — but for a value-layout payload
## the spill box inlines its FLAT field words at box+8, so the erased read passes a field
## VALUE where the constructed Option expects inlined fields ⇒ the produced Option drops
## every field but the first (the audit `ok le16` = 1000 / `ok cow` = 10000 miscompile).
## Mirror the Part-1 map-output construction: branch on the Result tag, and on the
## present arm build a spill `Option::Some` box INLINE-embedding the flat payload words
## (`out_box = [Some_tag@0, f0@1, …]`); on the absent arm build a 1-word spill
## `Option::None` box (`[None_tag@0]`). Some/None are variant indices 0/1.
## `op`: 4=ok (present ⇔ tag==0, Result Ok payload) 5=err (present ⇔ tag!=0, Err payload).
## GATE-0-INERT: gated by mir_result_subject_is_inline_value at the dispatch site ⇒ never
## reached at gate 0 ⇒ byte-identical self-host.
def mir_lower_value_ok_err_intercept(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, op: Int, arg_nodes: Vec<Int>): Int
  var subj_node = arg_nodes[0]
  var subj_ty = mir::mir_infer_expr_type(ctx, s, subj_node)
  # The present-arm payload type (Ok for ok(), Err for err()) — the Option's payload.
  var pt = ""
  if op == 4
    pt = mir::mir_result_ok_type(subj_ty)
  else
    pt = mir::mir_result_err_type(subj_ty)
  end
  var pres = mir::mir_resolve_struct_name(ctx, mir::mir_strip_generic_head(pt))
  var fc = ctx.mir_ctx_struct_field_count(pres)

  var box = mir_lower::mir_lower_expr(ctx, s, subj_node)
  var tag = ctx.mir_emit_load_offset(box, 0)
  var zero = ctx.mir_emit_const_int(0)
  # ok(): present ⇔ Ok ⇔ tag == 0. err(): present ⇔ Err ⇔ tag != 0.
  var present = 0
  if op == 4
    present = ctx.mir_emit_binary(op_constants::OP_EQ, tag, zero)
  else
    present = ctx.mir_emit_binary(op_constants::OP_NE, tag, zero)
  end

  var result_name = "__voe_result"
  var result_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(result_name, result_slot)

  var some_block = ctx.mir_create_block("voe_some")
  var none_block = ctx.mir_create_block("voe_none")
  var end_block = ctx.mir_create_block("voe_end")
  var cur_block = ctx.mir_ctx_get_block()
  mir_block_set_branch(cur_block, present, some_block, none_block)

  # --- present arm: build Option::Some(payload) spill box, inlining the FLAT fields.
  ctx.mir_switch_to_block(some_block)
  var eight = ctx.mir_emit_const_int(8)
  var interior = ctx.mir_emit_binary(op_constants::OP_ADD, box, eight)
  var some_box = ctx.mir_emit_alloc(1 + fc)
  var some_tag = ctx.mir_emit_const_int(0)
  ctx.mir_emit_store_offset(some_box, 0, some_tag)
  for fi in 0..fc
    var w = ctx.mir_emit_load_offset(interior, fi)
    ctx.mir_emit_store_offset(some_box, 1 + fi, w)
  end
  ctx.mir_emit_store_var(result_name, some_box)
  var some_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(some_cur) < 0
    mir_block_set_terminator(some_cur, mir::TERM_JUMP, end_block)
  end

  # --- absent arm: build Option::None spill box (tag = None index = 1).
  ctx.mir_switch_to_block(none_block)
  var none_box = ctx.mir_emit_alloc(1)
  var none_tag = ctx.mir_emit_const_int(1)
  ctx.mir_emit_store_offset(none_box, 0, none_tag)
  ctx.mir_emit_store_var(result_name, none_box)
  var none_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(none_cur) < 0
    mir_block_set_terminator(none_cur, mir::TERM_JUMP, end_block)
  end

  ctx.mir_switch_to_block(end_block)
  return ctx.mir_emit_load_var(result_name)
end

def mir_lower_cold_result_intercept(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, op: Int, arg_nodes: Vec<Int>): Int
  var r_node = arg_nodes[0]
  var rty = mir::mir_infer_expr_type(ctx, s, r_node)

  # ok()/err() produce an Option — only valid to intercept if that Option niches
  # (boxed payload). Otherwise bail to the residual reject (mir-builds a spill Option
  # from a niche word would be a false-accept). Compute the produced payload type up
  # front so the fallback happens BEFORE we emit any MIR.
  var produced_pt = ""
  if op == 4
    produced_pt = mir::mir_result_ok_type(rty)
    if mir::mir_option_is_niche(ctx, produced_pt) == 0
      return 0 - 1
    end
  end
  if op == 5
    produced_pt = mir::mir_result_err_type(rty)
    if mir::mir_option_is_niche(ctx, produced_pt) == 0
      return 0 - 1
    end
  end

  # Lower the receiver to the packed word; derive tag / Ok-payload (REUSE the mask
  # constants — never hardcode 7 / -8 — so read & construct can't drift).
  var rv = mir_lower::mir_lower_expr(ctx, s, r_node)
  var mask = ctx.mir_emit_const_int(mir::mir_result_niche_spare_mask())
  var clear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
  var tag = ctx.mir_emit_binary(op_constants::OP_AND, rv, mask)
  var zero = ctx.mir_emit_const_int(0)
  var is_ok = ctx.mir_emit_binary(op_constants::OP_EQ, tag, zero)
  var ok_pl = ctx.mir_emit_binary(op_constants::OP_AND, rv, clear)

  # Scratch slot threading the per-arm result to the merge block.
  var result_name = "__cold_result"
  var result_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(result_name, result_slot)

  var ok_block = ctx.mir_create_block("cold_ok")
  var err_block = ctx.mir_create_block("cold_err")
  var end_block = ctx.mir_create_block("cold_end")

  var cur_block = ctx.mir_ctx_get_block()
  mir_block_set_branch(cur_block, is_ok, ok_block, err_block)

  # --- Ok arm ---
  ctx.mir_switch_to_block(ok_block)
  if op == 1
    # result_map: f(ok_pl) ⇒ Ok(mapped) ⇒ bare word (tag 0, NO OR).
    var f1 = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
    var a1 = vec_new()
    a1.push(ok_pl)
    var mapped1 = ctx.mir_emit_call_indirect(f1, a1)
    ctx.mir_emit_store_var(result_name, mapped1)
  elsif op == 2
    # result_map_err on Ok: pass the Result through unchanged (Ok word = bare ptr).
    ctx.mir_emit_store_var(result_name, rv)
  elsif op == 3
    # result_and_then: f(ok_pl) already CONSTRUCTS its own niche Result word.
    var f3 = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
    var a3 = vec_new()
    a3.push(ok_pl)
    var newres3 = ctx.mir_emit_call_indirect(f3, a3)
    ctx.mir_emit_store_var(result_name, newres3)
  elsif op == 4
    # ok(): Ok ⇒ Some(payload) ⇒ identity (niche Option Some = the payload word).
    ctx.mir_emit_store_var(result_name, ok_pl)
  else
    # err(): Ok ⇒ None ⇒ the niche Option's None const.
    var none5 = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, produced_pt))
    ctx.mir_emit_store_var(result_name, none5)
  end
  var ok_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(ok_cur) < 0
    mir_block_set_terminator(ok_cur, mir::TERM_JUMP, end_block)
  end

  # --- Err arm ---
  ctx.mir_switch_to_block(err_block)
  if op == 1
    # result_map on Err: pass through unchanged (Err word = errptr|1 = Err construct).
    ctx.mir_emit_store_var(result_name, rv)
  elsif op == 2
    # result_map_err: f(err_payload) ⇒ Err(mapped) ⇒ OP_OR(mapped, 1).
    var ep2 = ctx.mir_emit_binary(op_constants::OP_AND, rv, clear)
    var f2 = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
    var a2 = vec_new()
    a2.push(ep2)
    var mapped2 = ctx.mir_emit_call_indirect(f2, a2)
    var one2 = ctx.mir_emit_const_int(1)
    var err_word2 = ctx.mir_emit_binary(op_constants::OP_OR, mapped2, one2)
    ctx.mir_emit_store_var(result_name, err_word2)
  elsif op == 3
    # result_and_then on Err: short-circuit, pass the Err Result through (NO f call).
    ctx.mir_emit_store_var(result_name, rv)
  elsif op == 4
    # ok(): Err ⇒ None ⇒ the niche Option's None const.
    var none4 = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, produced_pt))
    ctx.mir_emit_store_var(result_name, none4)
  else
    # err(): Err ⇒ Some(err_payload) ⇒ identity (the masked error pointer word).
    var ep5 = ctx.mir_emit_binary(op_constants::OP_AND, rv, clear)
    ctx.mir_emit_store_var(result_name, ep5)
  end
  var err_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(err_cur) < 0
    mir_block_set_terminator(err_cur, mir::TERM_JUMP, end_block)
  end

  # --- Merge ---
  ctx.mir_switch_to_block(end_block)
  return ctx.mir_emit_load_var(result_name)
end

def mir_lower_call(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var callee = ast::ast_get_left(s, node)
  var arg_nodes = ast::ast_get_children(s, node)

  # === Lambda call: callee is NODE_LAMBDA — lower to closure + indirect call ===
  var callee_kind = ast::ast_get_kind(s, callee)
  if callee_kind == node_constants::NODE_LAMBDA
    var fn_ptr = mir_lower::mir_lower_expr(ctx, s, callee)
    var indirect_args = vec_new()
    if arg_nodes != 0
      var la_count = arg_nodes.size
      for la_i in 0..la_count
        indirect_args.push(mir_lower::mir_lower_expr(ctx, s, arg_nodes[la_i]))
      end
    end
    mir_lower::mir_emit_fuel_check(ctx)
    return ctx.mir_emit_call_indirect(fn_ptr, indirect_args)
  end

  # === Fn-field indirect call: callee is FIELD_ACCESS (from typechecker rewrite) ===
  if callee_kind == node_constants::NODE_FIELD_ACCESS
    var fn_ptr = mir_lower::mir_lower_expr(ctx, s, callee)
    var indirect_args = vec_new()
    if arg_nodes != 0
      var ia_count = arg_nodes.size
      for ia_i in 0..ia_count
        indirect_args.push(mir_lower::mir_lower_expr(ctx, s, arg_nodes[ia_i]))
      end
    end
    mir_lower::mir_emit_fuel_check(ctx)
    return ctx.mir_emit_call_indirect(fn_ptr, indirect_args)
  end

  # === Call-of-call indirect: callee is itself a NODE_CALL whose result is a
  # fn pointer (e.g. `make_adder(100)(5)`, `f.unwrap()(5)`). The typechecker
  # already validated the inner call yields a callable Fn; lower the inner call
  # to its fn-pointer value and feed it to the same indirect-call machinery the
  # bind-form (`g = f.unwrap(); g(5)`) and the lambda/field-access branches use.
  if callee_kind == node_constants::NODE_CALL
    var fn_ptr = mir_lower::mir_lower_expr(ctx, s, callee)
    var indirect_args = vec_new()
    if arg_nodes != 0
      var cc_count = arg_nodes.size
      for cc_i in 0..cc_count
        indirect_args.push(mir_lower::mir_lower_expr(ctx, s, arg_nodes[cc_i]))
      end
    end
    mir_lower::mir_emit_fuel_check(ctx)
    return ctx.mir_emit_call_indirect(fn_ptr, indirect_args)
  end

  var func_name = ast::ast_get_str1(s, callee)

  # R-WS3 — escape approval. If this call's (method) name is a known-inline HOF
  # combinator on the non-escaping whitelist and any argument is a NODE_LAMBDA
  # literal, approve that lambda node as non-escaping so mir_lower_lambda may take
  # its mut captures BY-REFERENCE. The lambda is invoked synchronously inside this
  # call and not stored/spawned, so the caller's frame (holding the captured slots)
  # strictly outlives it — the addr-of pointers in the env can't dangle. Conservative:
  # a name off the whitelist, or a go/async/stored closure, keeps the by-value
  # fallback. Match the raw method name AND the `Type$method` UFCS-canonical suffix.
  # GATE-0-INERT: approval only matters for a lambda with a mut capture, of which the
  # compiler has none, so no closure lowering changes ⇒ byte-identical.
  if arg_nodes != 0 and arg_nodes.size > 0
    var hof_method = func_name
    if str_contains(func_name, "$")
      var hof_parts = str_split(func_name, "$")
      hof_method = hof_parts[hof_parts.size - 1]
    end
    if nonescaping_hof::hof_name_is_nonescaping(hof_method) == 1
      var hof_ac = arg_nodes.size
      for hof_ai in 0..hof_ac
        var hof_arg = arg_nodes[hof_ai]
        if ast::ast_get_kind(s, hof_arg) == node_constants::NODE_LAMBDA
          mir::mir_ctx_approve_nonescaping_lambda(ctx, hof_arg)
        end
      end
    end
  end

  # === N3.2 follow-up #2 — map_get CONSTRUCTION/READ niche atomic flip ===
  # `m.get(k)` lowers to the `map_get` intrinsic, whose codegen ALWAYS wraps the
  # found value in a TAGGED 16-byte Option box. But the niche-aware read side
  # (mir_infer_expr_type now infers `Option<V>`, so a chained `.unwrap()` /
  # `is Some` treats the single word AS the payload). A tagged box read as a
  # niche word = garbage (§14.4 construct/read mismatch). The raw sentinel form
  # `__map_get_raw` ALREADY produces exactly the niche layout — `phi [value, found],
  # [0, notfound]` = `Some(ptr)` / `None`=0, matching `mir_option_none_const(boxed)`
  # == 0. So when V is niche-eligible, REWRITE the call to `__map_get_raw` (same
  # args, same str2 key-type threading at the `map_`/`__map_get_raw` block below —
  # both string-key and int-key flavors dispatch correctly via the sentinel) so the
  # word the read side identity-binds is the bare niche value, not a tagged box.
  # V is recovered the SAME way the inference (read) recovers it — map-value-type
  # registry for an IDENT receiver, else inferred receiver Map type — so construct
  # and read can't disagree. Non-niche V (e.g. `Map<K, Option<W>>`: V=`Option<W>`
  # is NOT boxed ⇒ mir_option_is_niche==0) and gate-OFF fall through to the legacy
  # tagged map_get ⇒ byte-identical. `map_fetch` is left alone (it panics on miss,
  # returning a bare V already, not an Option). Symmetric `$map_get` UFCS form.
  if func_name == "map_get" or str_ends_with(func_name, "$map_get") == 1
    if arg_nodes != 0 and arg_nodes.size >= 1
      var mgr_recv = arg_nodes[0]
      var mgr_v = ""
      if ast::ast_get_kind(s, mgr_recv) == node_constants::NODE_IDENT
        mgr_v = ctx.mir_ctx_get_map_value_type(ast::ast_get_str1(s, mgr_recv))
      end
      if str_byte_len(mgr_v) == 0
        var mgr_recv_ty = mir::mir_infer_expr_type(ctx, s, mgr_recv)
        if str_byte_len(mgr_recv_ty) > 0
          mgr_v = mir::mir_extract_map_value_type(mgr_recv_ty)
        end
      end
      if str_byte_len(mgr_v) > 0 and mir::mir_option_is_niche(ctx, mgr_v) == 1
        func_name = "__map_get_raw"
      end
    end
  end

  # === Item 11 (enum-niche tail) — vec_pop CONSTRUCTION/READ niche atomic flip ===
  # `v.pop()` lowers to the `vec_pop` intrinsic, whose codegen ALWAYS wraps the
  # last element in a TAGGED 16-byte Option box. The niche-aware read side
  # (mir_infer_expr_type now infers `Option<T>`, so a chained `.unwrap()` / `is Some`
  # treats the single word AS the payload). A tagged box read as a niche word =
  # garbage (§14.10.Q4 construct/read mismatch). The raw sentinel form
  # `__vec_pop_raw_sentinel` produces exactly the niche layout — `phi [value, ok],
  # [0, empty]` = `Some(ptr)` / `None`=0, matching `mir_option_none_const(boxed)`==0.
  # So when T is niche-eligible, REWRITE the call to `__vec_pop_raw_sentinel` (same
  # args; it shares vec_pop's elem-type threading at the `vec_*` block below) so the
  # word the read side identity-binds is the bare niche value, not a tagged box. T is
  # recovered the SAME way the inference (read) recovers it — vec_elem_types registry
  # for an IDENT receiver, else inferred receiver Vec type — so construct and read
  # can't disagree. Non-niche T (e.g. `Vec<Int>`: mir_option_is_niche==0; or
  # `Vec<Option<W>>`: T=`Option<W>` is NOT boxed ⇒ 0) and gate-OFF fall through to
  # the legacy tagged vec_pop ⇒ byte-identical. Symmetric `$vec_pop` UFCS form.
  if func_name == "vec_pop" or str_ends_with(func_name, "$vec_pop") == 1
    if arg_nodes != 0 and arg_nodes.size >= 1
      var vpr_recv = arg_nodes[0]
      var vpr_t = ""
      if ast::ast_get_kind(s, vpr_recv) == node_constants::NODE_IDENT
        vpr_t = ctx.mir_ctx_get_vec_elem_type(ast::ast_get_str1(s, vpr_recv))
      end
      if str_byte_len(vpr_t) == 0
        var vpr_recv_ty = mir::mir_infer_expr_type(ctx, s, vpr_recv)
        if str_byte_len(vpr_recv_ty) > 0
          vpr_t = mir::mir_extract_generic_element_type(vpr_recv_ty)
        end
      end
      if str_byte_len(vpr_t) > 0 and mir::mir_option_is_niche(ctx, vpr_t) == 1
        func_name = "__vec_pop_raw_sentinel"
      end
    end
  end

  # === B.10 §14 N2 — NonZero identity intrinsics ===
  # NonZero is an i64-represented nominal scalar (TYPE_NONZERO): a NonZero IS its
  # value. Its three operations are pure runtime identities, lowered to the bare
  # argument register — no codegen / intrinsic-registry entry:
  #   nonzero_new_unchecked(x) : NonZero         = x
  #   nonzero_get(nz)          : Int             = nz
  #   nonzero_new(x)           : Option<NonZero> = x   — niche layout makes the
  #     check FREE: `Some(x)` IS `x`, and `None` IS the niche const 0, so when
  #     x==0 the returned 0 reads back as None and any x!=0 reads as Some(x)
  #     (§14.3 niche {0,1} at 0). `type_niche("NonZero")` is total ⇒ a concrete
  #     `Option<NonZero>` ALWAYS niches (no spill path to mis-build); the only
  #     erased-`Option<T>` hazard is caught by QZ0212.
  if func_name == "nonzero_new" or func_name == "nonzero_new_unchecked" or func_name == "nonzero_get"
    if arg_nodes != 0 and arg_nodes.size == 1
      return mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])
    end
  end

  # === B.10 §14 N3 6.3b — niche-aware Option CONSTRUCTION intrinsics ===
  # The bare `option_some(x)` / `option_none()` intrinsic-call form (used by the
  # qzmod cache codec's `mir_unpickle_function` to build `Option<MirFunc>`, and
  # by generator-return lowering) otherwise hits the codegen in
  # cg_intrinsic_memory.qz, which ALWAYS allocates a tagged 16-byte box. Under
  # niche layout the read side (`maybe.some?` / `maybe.unwrap()`, already niche-
  # aware at lines below) treats the single word AS the payload, so a tagged box
  # would be mis-read as the value — the cache_smoke segfault. Mirror the surface
  # `Some(x)`/`None` niche path (mir_lower.qz NODE_ENUM_ACCESS): when the result's
  # concrete payload type niches, `option_some(x)` IS the identity of `x` and
  # `option_none()` IS the niche constant. Payload type recovered the SAME way the
  # read side recovers it (§14.4), so construct/read can't disagree. SPILL (and
  # flag-OFF, where mir_option_is_niche is always 0) fall through to the legacy
  # intrinsic — byte-identical.
  if func_name == "option_some" or func_name == "option_none"
    var oc_is_some = 0
    if func_name == "option_some"
      oc_is_some = 1
    end
    var oc_arg = 0
    if oc_is_some == 1
      if arg_nodes != 0 and arg_nodes.size >= 1
        oc_arg = arg_nodes[0]
      end
    end
    var oc_pt = mir::mir_option_intrinsic_payload(ctx, s, oc_is_some, oc_arg)
    if str_byte_len(oc_pt) > 0 and mir::mir_option_is_niche(ctx, oc_pt) == 1
      if oc_is_some == 1
        if oc_arg != 0
          return mir_lower::mir_lower_expr(ctx, s, oc_arg)
        end
      else
        return ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, oc_pt))
      end
    end
  end

  # === B.10 §14 N1 — niche-aware Option intrinsics ===
  # `opt.some?` / `opt.none?` desugar to `option_is_some(opt)` (typecheck), and
  # `opt.unwrap()` to `unwrap`/`option_get`. For a niche-layout Option the scalar
  # value IS the discriminant, so emit the inline test/identity instead of the
  # boxed-load intrinsic (which would `inttoptr` a tiny scalar and segfault).
  # Gated on the receiver being a niche Option, so spill Options stay byte-
  # identical. (The generic `is_some<T>`/`map`/etc. std functions are a SEPARATE,
  # erased boundary — guarded by the N1 diagnostic, not here.)
  # B.10 §14 N3 6.3c — niche-aware `unwrap_or` (the desugar target of the `??`
  # nil-coalescing operator: `opt ?? d` ⇒ `unwrap_or(opt, d)`). Two args, so it
  # is NOT caught by the size==1 block below. Under niche layout the Option word
  # IS the payload (Some) or the niche const (None), so `unwrap_or(opt, d)` is a
  # pure SSA select: `opt != none_const ? opt : d` — both operands are already
  # eagerly lowered, matching unwrap_or's eager semantics. The generic intrinsic
  # would `inttoptr`+load the niche scalar → wrong value / segfault. Receiver-
  # niche-gated ⇒ spill Options and flag-OFF keep the byte-identical intrinsic.
  if arg_nodes != 0
    if arg_nodes.size == 2
      if func_name == "unwrap_or" or str_ends_with(func_name, "$unwrap_or") == 1
        var nuo_node = arg_nodes[0]
        if mir::mir_subject_is_niche_option(ctx, s, nuo_node) == 1
          var nuo_val = mir_lower::mir_lower_expr(ctx, s, nuo_node)
          var nuo_default = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
          var nuo_pt = mir::mir_option_subject_payload(ctx, s, nuo_node)
          var nuo_nc = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, nuo_pt))
          var nuo_is_some = ctx.mir_emit_binary(op_constants::OP_NE, nuo_val, nuo_nc)
          return ctx.mir_emit_select(nuo_is_some, nuo_val, nuo_default)
        end
      end
    end
  end
  if arg_nodes != 0
    if arg_nodes.size == 1
      # Classify: 1=is_some, 2=is_none, 3=unwrap/get. Catches BOTH the `?`-predicate
      # intrinsics (option_is_some/get) AND the prelude UFCS wrappers
      # (`Option$is_some`/`Option$is_none`/`Option$unwrap`, reached via
      # `opt.is_some()`), whose erased generic bodies would `inttoptr` a niche
      # scalar and segfault. Receiver-niche-gated, so spill Options are untouched.
      var n_op = 0
      if func_name == "option_is_some" or func_name == "is_some" or str_ends_with(func_name, "$is_some") == 1
        n_op = 1
      elsif func_name == "is_none" or str_ends_with(func_name, "$is_none") == 1
        n_op = 2
      elsif func_name == "option_get" or func_name == "unwrap" or str_ends_with(func_name, "$unwrap") == 1
        n_op = 3
      end
      if n_op > 0
        var nopt_node = arg_nodes[0]
        if mir::mir_subject_is_niche_option(ctx, s, nopt_node) == 1
          var nopt_val = mir_lower::mir_lower_expr(ctx, s, nopt_node)
          var npt0 = mir::mir_option_subject_payload(ctx, s, nopt_node)
          var n_ns = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, npt0))
          # Range-membership in the K=1 niche run (§14.3): None ⇔ value ==
          # niche_start, Some ⇔ value != niche_start. Correct for both a top
          # niche (Bool {2,254}) and a bottom niche (NonZero/borrow {0,1} at 0,
          # where the earlier `< / >=` mis-read every value as None).
          if n_op == 1
            return ctx.mir_emit_binary(op_constants::OP_NE, nopt_val, n_ns)
          end
          if n_op == 2
            return ctx.mir_emit_binary(op_constants::OP_EQ, nopt_val, n_ns)
          end
          # unwrap / option_get: `Some(x)` IS `x` — identity, no box to load.
          # (unwrap-on-None returns the niche constant rather than panicking —
          # parity with the spill `option_get`, which also reads garbage on None.)
          return nopt_val
        end
      end
    end
  end

  # === item 23 — inline @value-payload Option unwrap returns the INTERIOR ADDRESS ===
  # A SPILL `Option<P>` whose payload `P` is an inline value-layout (`@value`) struct
  # embeds P's fields INLINE in the box `{tag@0, f0@1, …}` (construction: mir_lower.qz
  # ~4095). The generic `prelude$Option$unwrap` / `option_get` returns box-WORD-1 as a
  # SCALAR (`load i64`), but for an inline payload that word is a FIELD VALUE, not a
  # pointer — the field-access consumer then `inttoptr`+gep+loads it as an address →
  # SEGV (item 23). `match Some(v)` works because it binds `v = &box[word1]` (the
  # ADDRESS of the inlined payload). Mirror that here: return `box + 8` (interior
  # address, no load), exactly the match-arm `is_inline` bind (base + 1*8). The flat,
  # header-less payload block makes the bound name arena-owned (handled at the let/
  # assign site) so its field reads stay offset+0. Receiver-payload-gated on
  # `mir_option_subject_is_inline_value` ⇒ INERT at gate 0 (no `@value` Option payload
  # exists in the compiler/std ⇒ this never fires ⇒ self-host IR byte-identical; the
  # non-`@value` scalar/pointer/niche Options the compiler actually uses are untouched).
  if arg_nodes != 0
    if arg_nodes.size == 1
      if func_name == "option_get" or func_name == "unwrap" or str_ends_with(func_name, "$unwrap") == 1
        var iv_node = arg_nodes[0]
        # item 27 — unwrap of a value-layout @value COLLECTION READOUT (`m.get(k)`,
        # `v.get(i)`). Unlike a LITERAL `Some(p)` (whose flat fields are inlined into
        # the box ⇒ `&box[word1]` below), the readout's codegen stores the value's
        # BUFFER-POINTER HANDLE at box[word1]. So unwrap must LOAD box[word1] (the
        # handle), giving the cow/value buffer pointer — the read-out retain
        # (mir_emit_cow_retain) increments ITS refcount and the field-access +1 cow
        # header-skip (gated on r's tracked cow type) reads the correct fields. Without
        # this, `&box[word1]` returns the ADDRESS of the handle slot ⇒ field a reads the
        # raw pointer word (the item-27 garbage). Checked BEFORE the inline-value case
        # since both predicates fire for a value-layout payload. Value-layout-gated ⇒
        # INERT at gate 0 (byte-identical; the compiler uses no @value collection values).
        if mir::mir_option_subject_is_cow_handle_readout(ctx, s, iv_node) == 1
          var hv_box = mir_lower::mir_lower_expr(ctx, s, iv_node)
          return ctx.mir_emit_load_offset(hv_box, 1)
        end
        if mir::mir_option_subject_is_inline_value(ctx, s, iv_node) == 1
          var iv_box = mir_lower::mir_lower_expr(ctx, s, iv_node)
          # &box[word1] = box + 8 bytes (tag@0, payload starts at word 1). One i64
          # in, one i64 out — the §4 single-SSA-value invariant. No load: the consumer
          # expects a pointer (it deref's the payload's fields), which this now is.
          var iv_off = ctx.mir_emit_const_int(8)
          return ctx.mir_emit_binary(op_constants::OP_ADD, iv_box, iv_off)
        end
      end
    end
  end

  # === item 42 (Part 2) — value-layout-spill unwrap_ok / unwrap_err intercept ===
  # `unwrap_ok(r)` / `unwrap_err(r)` over a SPILL Result whose Ok/Err payload is a
  # value-layout (`@value` / flip-eligible) struct. The erased prelude body reads the
  # payload slot as a BOXED POINTER (`load_offset 1` ⇒ `inttoptr`) — but the construct
  # side INLINES the value's flat field words at box[word1] (mir_lower.qz is_oR path),
  # so the loaded word is the FIRST FIELD VALUE (e.g. 7), deref'd as a pointer ⇒ the
  # item-23 SIGSEGV (this fixes the PRE-EXISTING `Result::Ok(@value)` + `unwrap_ok`
  # crash too). Mirror the inline-value `unwrap()` intercept (item 23) and the match-arm
  # inline bind: return the INTERIOR ADDRESS `box + 8` (the FLAT header-less field block;
  # construction strips the COW header for >16B). The bind site arena-marks the name so
  # its field reads stay offset+0 (no COW +1 shift) for BOTH ≤16B and >16B. Keyed on
  # `mir_result_subject_is_inline_value` ⇒ INERT at gate 0 (no `@value` Result payload
  # exists in the compiler/std ⇒ never fires ⇒ self-host IR byte-identical).
  if arg_nodes != 0
    if arg_nodes.size == 1
      var uok_is = func_name == "unwrap_ok" or str_ends_with(func_name, "$unwrap_ok") == 1
      var uerr_is = func_name == "unwrap_err" or str_ends_with(func_name, "$unwrap_err") == 1
      if uok_is == 1 or uerr_is == 1
        var uo_node = arg_nodes[0]
        # item 42d — `unwrap_err` reads the ERR payload, so it must gate on the Err-side
        # predicate (mir_result_subject_err_is_inline_value); the Ok-side predicate is
        # blind to a `Result<scalar, @value>` and the erased prelude body would read the
        # inline Err field word as a boxed pointer ⇒ the item-23 SIGSEGV. `unwrap_ok`
        # keeps the Ok-side predicate. A Result is EITHER Ok or Err, so both payloads
        # occupy the SAME flat slot at word1 ⇒ the interior address `box+8` is correct
        # for both sides. GATE-0-INERT: both predicates are false for every Result the
        # compiler/std use (zero `@value` payloads) ⇒ byte-identical.
        var uo_inline = 0
        if uerr_is == 1
          uo_inline = mir::mir_result_subject_err_is_inline_value(ctx, s, uo_node)
        else
          uo_inline = mir::mir_result_subject_is_inline_value(ctx, s, uo_node)
        end
        if uo_inline == 1
          var uo_box = mir_lower::mir_lower_expr(ctx, s, uo_node)
          # &box[word1] = box + 8 (tag@0, payload@word1, FLAT). One i64 in/out.
          var uo_off = ctx.mir_emit_const_int(8)
          return ctx.mir_emit_binary(op_constants::OP_ADD, uo_box, uo_off)
        end
      end
    end
  end

  # === item 42b — value-layout-spill unwrap-with-fallback intercept ===
  # `unwrap_or_ok(r, fb)` / `result_or(r, fb)` (Result) and `unwrap_or(o, fb)` (Option)
  # over a SPILL subject whose Ok/Some payload is a value-layout (`@value`/flip-eligible)
  # struct. The erased prelude body returns the present payload via the BOXED spill
  # layout (`unwrap_ok`/`unwrap` → `load_offset 1` ⇒ a FIELD VALUE deref'd as a pointer)
  # — the gate-1 result_niche SIGSEGV. Mirror the item-42 unwrap_ok intercept, but this
  # family is 2-arg and CONDITIONAL: read the spill tag (offset 0), branch on present
  # (Ok/Some ⇔ tag == 0, variant index 0), and `select` the INTERIOR ADDRESS `box + 8`
  # (the FLAT header-less inlined field block; construction strips the COW header for
  # >16B) against the FALLBACK. The fallback is itself a value-layout `T` value whose MIR
  # rep is a pointer to its field words; for a >16B (cow-layout) `T` those words live at
  # `fb + 8` (skip the refcount header) to match the FLAT Ok-interior representation the
  # arena-marked consumer reads (offset+0). For ≤16B the fallback is already flat. The
  # select is eager (both operands are addresses, no side effects). The bind site
  # arena-marks the name so field reads stay offset+0. Keyed on
  # `mir_unwrap_or_fallback_subject_is_inline_value` ⇒ INERT at gate 0 (no `@value`
  # Result/Option payload exists in the compiler/std ⇒ never fires ⇒ byte-identical).
  if arg_nodes != 0
    if arg_nodes.size == 2
      if mir::mir_unwrap_or_fallback_subject_is_inline_value(ctx, s, node) == 1
        var uof_box = mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])
        # spill tag @ offset 0; Ok/Some is variant index 0 ⇒ present ⇔ tag == 0.
        var uof_tag = ctx.mir_emit_load_offset(uof_box, 0)
        var uof_zero = ctx.mir_emit_const_int(0)
        var uof_present = ctx.mir_emit_binary(op_constants::OP_EQ, uof_tag, uof_zero)
        # present interior: &box[word1] = box + 8 (FLAT field block).
        var uof_eight = ctx.mir_emit_const_int(8)
        var uof_ok = ctx.mir_emit_binary(op_constants::OP_ADD, uof_box, uof_eight)
        # fallback: pointer to its field words. Skip the COW header for >16B so the
        # representation matches the FLAT Ok-interior (offset+0 consumer reads).
        var uof_fb = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
        var uof_pt = mir::mir_unwrap_or_fallback_payload_type(ctx, s, node)
        if str_byte_len(uof_pt) > 0
          var uof_pres = mir::mir_resolve_struct_name(ctx, mir::mir_strip_generic_head(uof_pt))
          if mir::mir_value_is_cow_layout(ctx, uof_pres) == 1
            var uof_eight2 = ctx.mir_emit_const_int(8)
            uof_fb = ctx.mir_emit_binary(op_constants::OP_ADD, uof_fb, uof_eight2)
          end
        end
        return ctx.mir_emit_select(uof_present, uof_ok, uof_fb)
      end
    end
  end

  # === item 42b — value-layout-spill ok() / err() conversion intercept ===
  # `ok(r)` / `err(r)` convert `Result<T,E>` → `Option<T>`/`Option<E>`. For a value-
  # layout present payload the erased prelude body drops every field but the first (the
  # audit `ok le16` = 1000 miscompile). Replace with inline conversion MIR
  # (mir_lower_value_ok_err_intercept). Keyed on `mir_result_subject_is_inline_value` ⇒
  # INERT at gate 0 (no `@value` Result payload exists ⇒ byte-identical). Must precede the
  # niche cold ok/err intercept below (whose subject is niche-multi, mutually exclusive
  # with value-layout, but ordering keeps the value-layout-first convention).
  if arg_nodes != 0
    if arg_nodes.size == 1
      var voe_op = 0
      if func_name == "ok" or str_ends_with(func_name, "$ok") == 1
        voe_op = 4
      elsif func_name == "err" or str_ends_with(func_name, "$err") == 1
        voe_op = 5
      end
      if voe_op > 0
        var voe_inline = 0
        if voe_op == 4
          voe_inline = mir::mir_result_subject_is_inline_value(ctx, s, arg_nodes[0])
        else
          voe_inline = mir::mir_result_subject_err_is_inline_value(ctx, s, arg_nodes[0])
        end
        if voe_inline == 1
          return mir_lower_value_ok_err_intercept(ctx, s, node, voe_op, arg_nodes)
        end
      end
    end
  end

  # === item 42 (Part 1) + 42f — value-layout-spill Result/Option map / map_err /
  # and_then intercept ===
  # Replace the erased combinator CALL with inline value-layout-aware MIR when the
  # subject has a value-layout payload on the relevant side (see
  # mir_lower_value_combinator_intercept). Gate per-op:
  #   - result_map (1) / result_and_then (3): fire if EITHER the Ok payload (the mapped
  #     side, read at box+8) OR the Err payload (passed through on the box carrier) is
  #     value-layout. An Err-only value-layout subject still mis-compiles the erased
  #     `Result::Err(e)` re-construct (it re-boxes the inline field word as a pointer),
  #     so the intercept must fire then too; the passthrough arm rides the box (correct
  #     for both scalar and value-layout Err), the mapped Ok arm handles its own layout.
  #   - result_map_err (2, item 42f): fire if EITHER the Err payload (the mapped side) OR
  #     the Ok payload (passed through) is value-layout. The Err arm reads the Err payload
  #     at box+8 and constructs the output Err box inline-embedding F; the Ok arm rides
  #     the box unchanged.
  #   - option_map (6) / option_and_then (7): fire on the Some payload.
  # Keyed on mir_result_subject_is_inline_value / mir_result_subject_err_is_inline_value /
  # mir_option_subject_is_inline_value ⇒ INERT at gate 0 (byte-identical). MUST precede
  # the niche-multi cold intercept below (whose QZ0212 reject would otherwise be a
  # false-positive for a value-layout-spill subject).
  if arg_nodes != 0
    if arg_nodes.size == 2
      var vlc_op = mir::mir_combinator_op(func_name)
      if vlc_op > 0
        var vlc_subj = arg_nodes[0]
        var vlc_is_result = vlc_op == 1 or vlc_op == 2 or vlc_op == 3
        var vlc_inline = 0
        if vlc_is_result == 1
          # Fire if EITHER Result payload side is value-layout (the un-mapped side rides
          # the carrier box unchanged, the mapped side gets value-layout extraction).
          if mir::mir_result_subject_is_inline_value(ctx, s, vlc_subj) == 1
            vlc_inline = 1
          elsif mir::mir_result_subject_err_is_inline_value(ctx, s, vlc_subj) == 1
            vlc_inline = 1
          end
        else
          vlc_inline = mir::mir_option_subject_is_inline_value(ctx, s, vlc_subj)
        end
        if vlc_inline == 1
          return mir_lower_value_combinator_intercept(ctx, s, node, vlc_op, arg_nodes)
        end
      end
    end
  end

  # === enum-niche M2 — niche-aware built-in Result combinators (hot intercept) ===
  # A niche-MULTI built-in `Result<&A,&B>` flows as a single word `payload_ptr | tag`
  # (Ok ⇒ ptr|0 = ptr, Err ⇒ ptr|1). The erased std combinators (`is_ok<T,E>`/
  # `unwrap_ok<T,E>`/… in std/prelude.qz) read it via the BOXED spill layout
  # (`load_offset 0/1`) — `inttoptr` of the packed word + offset-load ⇒ SEGFAULT.
  # There is no monomorphization to make those bodies niche-aware, so — exactly as the
  # boxed-Option `is_some`/`unwrap`/`unwrap_or` interception above — replace the CALL
  # with inline niche-aware MIR at the call site (where the concrete type is known and
  # `mir_subject_is_niche_multi` is true). The read is TYPE-INDEPENDENT: tag = `v & 7`,
  # payload = `v & ~7`. Matches BOTH the bare combinator (`is_ok`) and the prelude UFCS
  # wrapper (`Result$is_ok`, reached via `r.is_ok()`). Receiver-niche-gated ⇒ spill
  # Results and the gate-OFF scaffold keep the byte-identical erased-body call.
  if arg_nodes != 0
    # 2-arg hot combinators: unwrap_or_ok(r, d) and result_or(r, d).
    if arg_nodes.size == 2
      var rm2_node = arg_nodes[0]
      if mir::mir_subject_is_niche_multi(ctx, s, rm2_node) == 1
        var rm2_is_uoo = func_name == "unwrap_or_ok" or str_ends_with(func_name, "$unwrap_or_ok") == 1
        var rm2_is_or = func_name == "result_or" or str_ends_with(func_name, "$result_or") == 1
        if rm2_is_uoo == 1 or rm2_is_or == 1
          var rm2_val = mir_lower::mir_lower_expr(ctx, s, rm2_node)
          var rm2_default = mir_lower::mir_lower_expr(ctx, s, arg_nodes[1])
          # Ok ⇔ (v & 7) == 0. On Ok: unwrap_or_ok → the Ok payload `v & ~7`;
          # result_or → the (scalar-typed) Ok value — but a niche-multi Result has a
          # BOXED Ok payload, so result_or's `T` is a pointer and `v & ~7` is also the
          # right value. On Err: the supplied default. A pure SSA select (eager, like
          # the combinator semantics).
          var rm2_mask = ctx.mir_emit_const_int(mir::mir_result_niche_spare_mask())
          var rm2_tag = ctx.mir_emit_binary(op_constants::OP_AND, rm2_val, rm2_mask)
          var rm2_zero = ctx.mir_emit_const_int(0)
          var rm2_is_ok = ctx.mir_emit_binary(op_constants::OP_EQ, rm2_tag, rm2_zero)
          var rm2_clear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
          var rm2_payload = ctx.mir_emit_binary(op_constants::OP_AND, rm2_val, rm2_clear)
          return ctx.mir_emit_select(rm2_is_ok, rm2_payload, rm2_default)
        end
      end
    end
    # 1-arg hot combinators: is_ok / is_err / unwrap_ok / unwrap_err.
    if arg_nodes.size == 1
      var rm_op = 0
      if func_name == "is_ok" or str_ends_with(func_name, "$is_ok") == 1
        rm_op = 1
      elsif func_name == "is_err" or str_ends_with(func_name, "$is_err") == 1
        rm_op = 2
      elsif func_name == "unwrap_ok" or str_ends_with(func_name, "$unwrap_ok") == 1
        rm_op = 3
      elsif func_name == "unwrap_err" or str_ends_with(func_name, "$unwrap_err") == 1
        rm_op = 4
      end
      if rm_op > 0
        var rm_node = arg_nodes[0]
        if mir::mir_subject_is_niche_multi(ctx, s, rm_node) == 1
          var rm_val = mir_lower::mir_lower_expr(ctx, s, rm_node)
          var rm_mask = ctx.mir_emit_const_int(mir::mir_result_niche_spare_mask())
          var rm_tag = ctx.mir_emit_binary(op_constants::OP_AND, rm_val, rm_mask)
          var rm_zero = ctx.mir_emit_const_int(0)
          if rm_op == 1
            # is_ok ⇔ (v & 7) == 0
            return ctx.mir_emit_binary(op_constants::OP_EQ, rm_tag, rm_zero)
          end
          if rm_op == 2
            # is_err ⇔ (v & 7) != 0
            return ctx.mir_emit_binary(op_constants::OP_NE, rm_tag, rm_zero)
          end
          # unwrap_ok / unwrap_err: the payload IS `v & ~7` (mask off the tag bit) —
          # identity-after-mask, no box to load. (unwrap on the wrong variant returns
          # the masked pointer, parity with the spill combinators reading garbage.)
          var rm_clear = ctx.mir_emit_const_int(0 - mir::mir_result_niche_spare_mask() - 1)
          return ctx.mir_emit_binary(op_constants::OP_AND, rm_val, rm_clear)
        end
      end
    end
  end

  # === enum-niche M2.3 — niche-aware COLD Result combinator interception ===
  # The COLD Result combinators (`result_map`/`result_map_err`/`result_and_then`/`ok`/
  # `err` — closure-taking or Result-returning) are now INTERCEPTED at the call site on a
  # niche-multi Result, exactly as the hot combinators above (M2.3 lifts the M2-v1 QZ0212
  # reject). The erased std bodies read the Result via the BOXED spill layout, so a
  # niche-multi Result flowing into the real body is a false-accept SEGFAULT; instead we
  # inline niche-aware MIR (real blocks + branch — never an eager select, which would
  # invoke the closure on the wrong arm). Gated on `mir_subject_is_niche_multi` ⇒ INERT
  # while the gate is OFF (no niche-multi Result exists ⇒ the scan never fires; the std
  # self-host never reaches this branch ⇒ fixpoint IR byte-identical). The residual
  # eputs+exit(1) is the conservative fallback for the ok/err case where the PRODUCED
  # Option is not niche-eligible (helper returns -1) — mir-building a spill Option from a
  # niche word would be a false-accept, so reject it for soundness.
  if arg_nodes != 0
    if arg_nodes.size >= 1
      var rcold = 0
      if func_name == "result_map" or str_ends_with(func_name, "$result_map") == 1
        rcold = 1
      elsif func_name == "result_map_err" or str_ends_with(func_name, "$result_map_err") == 1
        rcold = 2
      elsif func_name == "result_and_then" or str_ends_with(func_name, "$result_and_then") == 1
        rcold = 3
      elsif func_name == "ok" or str_ends_with(func_name, "$ok") == 1
        rcold = 4
      elsif func_name == "err" or str_ends_with(func_name, "$err") == 1
        rcold = 5
      end
      if rcold > 0
        if mir::mir_subject_is_niche_multi(ctx, s, arg_nodes[0]) == 1
          var rc_res = mir_lower_cold_result_intercept(ctx, s, node, rcold, arg_nodes)
          if rc_res >= 0
            return rc_res
          end
          # Residual reject: ok/err where the produced Option is not niche-eligible.
          var rc_ln = ast::ast_get_line(s, node)
          var rc_cl = ast::ast_get_col(s, node)
          eputs("[QZ0212] cannot pass a niche-layout `Result` into the cold combinator `#{func_name}` (line #{str_from_int(rc_ln)}:#{str_from_int(rc_cl)}).")
          eputs("  A niche Result flows as a packed `payload|tag` word, but the combinator's erased body reads it via the boxed layout — this would crash at runtime.")
          eputs("  hint: match the Result directly (`match r { Ok(x) => …, Err(e) => … }`), or use a hot combinator (is_ok/is_err/unwrap_ok/unwrap_err/unwrap_or_ok/result_or, which are niche-aware).")
          exit(1)
        end
      end
    end
  end

  # === B.10 §14 N1 — the (B) erased-boundary diagnostic (QZ0212) ===
  # A niche-layout `Option<Bool>` value flows as a bare scalar (0/1/2). A generic
  # function `f<T>(o: Option<T>)` is compiled ONCE with `T` erased and reads its
  # Option payload via the boxed (spill) layout — `inttoptr` of the niche scalar
  # + load → SEGFAULT. There is no monomorphization to make the body niche-aware
  # (A.36 monomorphizes structs, not free functions), so passing a niche Option
  # into an abstract-`T` Option param is unsound. Error loudly instead.
  #
  # Precise + zero-false-positive: well-typed code can only pass an `Option<Bool>`
  # arg to a param typed `Option<Bool>` (payload "Bool" == arg payload → SAFE) or
  # `Option<T>` (payload is a type variable ≠ "Bool" → the erased case → ERROR).
  # A bare-`T` param (`f<T>(x: T)`) doesn't read `x` as an Option, so the scalar
  # flows opaquely and is read niche-aware at concrete sites — SAFE, not flagged
  # (only `Option<…>`-typed params are checked). Bootstrap-safe: only fires on a
  # niche arg, which the compiler/std never construct.
  var n_dg_any_niche = 0
  if arg_nodes != 0
    if arg_nodes.size > 0
      for n_dg_scan in 0..arg_nodes.size
        if mir::mir_subject_is_niche_option(ctx, s, arg_nodes[n_dg_scan]) == 1
          n_dg_any_niche = 1
        end
      end
    end
  end
  if n_dg_any_niche == 1
    if arg_nodes.size > 0
      var n_dg_resolved = ctx.mir_resolve_func_name(func_name)
      var n_dg_entry = ctx.mir_lookup_function(n_dg_resolved)
      if n_dg_entry.is_some()
        var n_dg_e = n_dg_entry.unwrap()
        var n_dg_store = n_dg_e.ast_store
        var n_dg_handle = n_dg_e.node_id
        var n_dg_params = ast::ast_get_left(n_dg_store, n_dg_handle)
        if n_dg_params >= 0
          var n_dg_pcount = vec_size(n_dg_params)
          # Only when arg/param counts align (no self-injection ambiguity).
          if n_dg_pcount == arg_nodes.size
            for n_dg_i in 0..arg_nodes.size
              var n_dg_arg = arg_nodes[n_dg_i]
              if mir::mir_subject_is_niche_option(ctx, s, n_dg_arg) == 1
                var n_dg_pann = ast::ast_get_str2(n_dg_store, n_dg_params[n_dg_i])
                if n_dg_pann.starts_with("Option<")
                  var n_dg_ppay = mir::mir_option_payload_of_type(n_dg_pann)
                  var n_dg_apay = mir::mir_option_subject_payload(ctx, s, n_dg_arg)
                  if n_dg_ppay != n_dg_apay
                    var n_dg_ln = ast::ast_get_line(s, node)
                    var n_dg_cl = ast::ast_get_col(s, node)
                    eputs("[QZ0212] cannot pass a niche-layout `Option<#{n_dg_apay}>` into the generic parameter `#{n_dg_pann}` of `#{func_name}` (line #{str_from_int(n_dg_ln)}:#{str_from_int(n_dg_cl)}).")
                    eputs("  A niche Option flows as a bare scalar, but a generic body reads its payload via the boxed layout — this would crash at runtime.")
                    eputs("  hint: give the function a concrete `Option<#{n_dg_apay}>` parameter, or match/inspect the Option before the call and pass the unwrapped value.")
                    exit(1)
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  # === enum-niche M2 — QZ0212-multi erased-`Result<T,E>`-param guard (RFC §5 #2) ===
  # Symmetric to the Option generic-param diagnostic above, for the multi-payload
  # BUILT-IN `Result`. A niche-multi `Result<&A,&B>` flows as a single packed word
  # `payload_ptr | tag` (read tag = `v & 7`, payload = `v & ~7`). A generic function
  # `def f<A,B>(r: Result<A,B>)` is compiled ONCE with `A,B` erased and reads its
  # Result via the BOXED (spill) layout — `inttoptr` the niche word + `load_offset 0`
  # for the tag and `load_offset 1` for the payload → it misreads the packed word and
  # corrupts/SEGFAULTs. There is no monomorphization to make the erased body niche-aware
  # (the std cold combinators are name-matched + rejected above; the long-tail USER
  # case is this branch). So passing a niche-multi Result into an abstract-`Result<…>`
  # param whose type args don't EXACTLY match the arg's concrete niche type is unsound.
  # Error loudly instead.
  #
  # Conservative (RFC §5 soundness floor): false-error is acceptable (the user matches
  # the Result directly or passes the unwrapped value), false-accept is FORBIDDEN. The
  # accept rule is the same precise one the Option branch uses — a param is SAFE only
  # when its `Result<…>` type args STRING-EQUAL the arg's concrete inferred Ok/Err
  # types (the only way a well-typed `Result<…>` param matches a niche-multi arg is the
  # identical concrete `Result<&A,&B>`); ANY type-variable arg (`Result<A,B>`,
  # `Result<A,String>`, …) differs ⇒ ERROR. Gated on `mir_subject_is_niche_multi`,
  # which is 0 while `mir_multi_niche_result_live()` is OFF ⇒ this branch is INERT (no
  # niche-multi Result exists ⇒ the scan never flags), emitting byte-identical IR.
  var n_dgr_any_niche = 0
  if arg_nodes != 0
    if arg_nodes.size > 0
      for n_dgr_scan in 0..arg_nodes.size
        if mir::mir_subject_is_niche_multi(ctx, s, arg_nodes[n_dgr_scan]) == 1
          n_dgr_any_niche = 1
        end
      end
    end
  end
  if n_dgr_any_niche == 1
    if arg_nodes.size > 0
      var n_dgr_resolved = ctx.mir_resolve_func_name(func_name)
      var n_dgr_entry = ctx.mir_lookup_function(n_dgr_resolved)
      if n_dgr_entry.is_some()
        var n_dgr_e = n_dgr_entry.unwrap()
        var n_dgr_store = n_dgr_e.ast_store
        var n_dgr_handle = n_dgr_e.node_id
        var n_dgr_params = ast::ast_get_left(n_dgr_store, n_dgr_handle)
        if n_dgr_params >= 0
          var n_dgr_pcount = vec_size(n_dgr_params)
          # Only when arg/param counts align (no self-injection ambiguity).
          if n_dgr_pcount == arg_nodes.size
            for n_dgr_i in 0..arg_nodes.size
              var n_dgr_arg = arg_nodes[n_dgr_i]
              if mir::mir_subject_is_niche_multi(ctx, s, n_dgr_arg) == 1
                var n_dgr_pann = ast::ast_get_str2(n_dgr_store, n_dgr_params[n_dgr_i])
                if n_dgr_pann.starts_with("Result<")
                  # The arg's concrete niche Result type (what construct/read niche on).
                  var n_dgr_aty = mir::mir_infer_expr_type(ctx, s, n_dgr_arg)
                  var n_dgr_a_ok = mir::mir_result_ok_type(n_dgr_aty)
                  var n_dgr_a_err = mir::mir_result_err_type(n_dgr_aty)
                  var n_dgr_p_ok = mir::mir_result_ok_type(n_dgr_pann)
                  var n_dgr_p_err = mir::mir_result_err_type(n_dgr_pann)
                  # SAFE iff the param's type args string-equal the arg's concrete
                  # niche type args; any erased (type-variable) arg differs ⇒ ERROR.
                  if n_dgr_p_ok != n_dgr_a_ok or n_dgr_p_err != n_dgr_a_err
                    var n_dgr_ln = ast::ast_get_line(s, node)
                    var n_dgr_cl = ast::ast_get_col(s, node)
                    eputs("[QZ0212] cannot pass a niche-layout `#{n_dgr_aty}` into the generic parameter `#{n_dgr_pann}` of `#{func_name}` (line #{str_from_int(n_dgr_ln)}:#{str_from_int(n_dgr_cl)}).")
                    eputs("  A niche Result flows as a packed `payload|tag` word, but a generic body reads it via the boxed layout — this would crash at runtime.")
                    eputs("  hint: give the function a concrete `#{n_dgr_aty}` parameter, or match the Result before the call (`match r { Ok(x) => …, Err(e) => … }`) and pass the unwrapped value.")
                    exit(1)
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  # === to_str(int_expr) → str_from_int(int_expr) rewrite ===
  # Dispatch known-Int values through `str_from_int` directly to bypass the
  # unsound `@to_str` alignment heuristic (TO_STR_INT_HEURISTIC_UNSOUND).
  # NODE_INTERP_STRING desugar handles the multi-part interp case via
  # `mir_unwrap_to_str_for_int`, but the parser's single-part shortcut
  # (parser.qz:1205-1207) bypasses NODE_INTERP_STRING entirely for `"#{n}"`,
  # returning the bare `to_str(n)` call to be lowered as a regular call.
  # Catch it here. Also catches user code that explicitly writes
  # `to_str(n)` for a known-Int `n`.
  if func_name == "to_str" and arg_nodes != 0 and arg_nodes.size == 1
    var ts_arg = arg_nodes[0]
    if mir_lower::mir_is_int_expr(ctx, s, ts_arg) == 1
      var ts_val = mir_lower::mir_lower_expr(ctx, s, ts_arg)
      var sfi_args = vec_new()
      sfi_args.push(ts_val)
      return ctx.mir_emit_intrinsic("str_from_int", sfi_args)
    end
  end

  # === Incremental-cache UFCS rewrite fallback ===
  # TC normally rewrites `v.push(x)` → `vec_push(v, x)` at
  # typecheck_expr_handlers.qz:2230-2640, mutating the callee IDENT's str1
  # in-place. In incremental mode (quartz.qz:813-851), TC body-walk is skipped
  # for cached modules whose source hasn't changed. But MIR runs on every
  # function regardless (mir_lower.qz:5212 — "MIR skip is unsafe due to
  # lambda numbering"). When a cached module's `__main__.ll` cache fragment
  # is invalidated by a sibling module's change (its spec, etc.) and gets
  # re-emitted, MIR walks the un-rewritten AST and sees the raw method name.
  # `mir_intrinsics::mir_is_intrinsic("push")` is false, the function
  # registry has no `push` entry, so the call falls through to
  # `mir_emit_load_var("push")` — producing `load i64, ptr %push` with no
  # alloca, which llc rejects with `use of undefined value '%push'`.
  #
  # Detect via the parser-set `is_ufcs` flag (NODE_CALL constructed from
  # `obj.method(args)` shape, where args[0] holds the receiver), infer
  # args[0]'s type via mir_infer_expr_type (which now consults global vars
  # via mir_ctx_lookup_global_type), and apply the canonical rewrite via
  # mir::mir_ufcs_canonical. The rewrite mutates the AST IDENT just like
  # TC would have, so subsequent code paths (intrinsic dispatch, etc.)
  # see the canonical name and proceed normally. Idempotent: once
  # func_name is a registered intrinsic, the rewrite condition fails.
  if ast::ast_call_is_ufcs(s, node) == 1 and arg_nodes != 0 and arg_nodes.size > 0
    if mir_intrinsics::mir_is_intrinsic(func_name) == 0
      if ctx.mir_lookup_function(func_name).is_none()
        var ufcs_recv_type = ctx.mir_infer_expr_type(s, arg_nodes[0])
        if str_byte_len(ufcs_recv_type) > 0
          # Strip generic args ("Vec<Vec<String>>" → "Vec") for table lookup.
          var ufcs_lt = __char_index(ufcs_recv_type, '<')
          if ufcs_lt > 0
            ufcs_recv_type = str_byte_slice(ufcs_recv_type, 0, ufcs_lt)
          end
          var ufcs_canonical = mir::mir_ufcs_canonical(ufcs_recv_type, func_name)
          if str_byte_len(ufcs_canonical) > 0
            ast::ast_set_str1(s, callee, ufcs_canonical)
            func_name = ufcs_canonical
          end
        end
      end
    end
  end

  # Local-variable shadow: a same-named top-level `def` MUST NOT be
  # dispatched when the call site has a local var or parameter holding a
  # fn pointer in scope (`var f = self.step; ...; f(self.frame)` inside
  # `Stream.next` colliding with a user `def f`, or `def caller(f: Fn(): Int)
  # = f()` colliding with a top-level `def f`). The pre-existing fallback
  # at the bottom of this function only fires when `mir_lookup_function`
  # returns 0, so without this early check the global wins and codegen
  # later panics on arity mismatch (`mir_func_get_param_type_name(0)` on
  # a 0-param callee). Skip when func_name is already module-qualified.
  if str_contains(func_name, "$") == 0
    if ctx.mir_ctx_lookup_var(func_name) >= 0
      var lv_fn_ptr = ctx.mir_emit_load_var(func_name)
      var lv_indirect_args = vec_new()
      if arg_nodes != 0
        var lv_count = arg_nodes.size
        for lv_i in 0..lv_count
          lv_indirect_args.push(mir_lower::mir_lower_expr(ctx, s, arg_nodes[lv_i]))
        end
      end
      mir_lower::mir_emit_fuel_check(ctx)
      return ctx.mir_emit_call_indirect(lv_fn_ptr, lv_indirect_args)
    end
  end

  # IMPL-TRAIT-RPITIT bounded-generic dispatch fix-up: typecheck may
  # have pre-mangled the call name (e.g. `it.next()` →
  # `AStackIter$next`) using whichever concrete the trait method's
  # `impl OtherTrait` return resolved to at typecheck time. For
  # monomorphizations over OTHER impls (e.g. AMyList → AListIter),
  # that prefix is wrong even though the receiver `it` is correctly
  # tracked as the right concrete struct via the let-init type
  # tracker. Re-resolve against the receiver's actually-tracked type
  # at MIR-lower time. Gated on spec_current_type by the helper, so
  # non-spec bodies are unaffected. We only update the local
  # func_name; the AST is never mutated (would persist across
  # monomorphizations of the same body and clobber sibling specs).
  var _rpitit_resolved = mir::mir_resolve_method_call_receiver_aware(ctx, s, node, func_name)
  if str_byte_len(_rpitit_resolved) > 0
    func_name = _rpitit_resolved
  end
  var args = vec_new()
  if arg_nodes == 0
    arg_nodes = vec_new()
  end

  # Set line info for debug metadata
  var call_line = ast::ast_get_line(s, node)
  ctx.mir_ctx_set_line(call_line)

  # === Resume dispatch (Effects F.3a + P3.0c-resume) ===
  # Runtime-dispatched on the op's kind (stashed in TLS by the effect
  # runtime's perform helper just before dispatching to this handler):
  #
  #   kind<3 (F.3a — value/function/unwind ops with tail resume)
  #     `resume(v)` = `return v` from the handler body. The handler-
  #     return ABI carries the value back to the op call site via D.5b's
  #     i64 slot. kind=2 ops still unwind via longjmp after the handler
  #     returns (handled in __qz_effect_perform's hit block).
  #
  #   kind=3 (P3.0c — continuation-preserving resume)
  #     `resume(v)` invokes the caller's stored continuation (via the
  #     __qz_effect_resume_cont helper) and falls through with the body's
  #     return as the resume-expression value. Handler keeps executing
  #     until its own `return`; the with-block teardown picks body_rv
  #     over handler_rv by reading the resumed flag set by the helper.
  #
  # The same handler function can be registered for multiple ops with
  # different kinds, so this dispatch HAS to be runtime — we can't pick
  # one path at compile time. TLS read + conditional branch is the
  # minimum-overhead shape.
  if func_name == "resume"
    var _res_val = 0
    if arg_nodes.size >= 1
      _res_val = mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])
    else
      _res_val = ctx.mir_emit_const_int(0)
    end
    var _resume_empty_args = vec_new<Int>()
    var _resume_kind = ctx.mir_emit_call("__qz_effect_get_current_kind", _resume_empty_args)
    var _resume_three = ctx.mir_emit_const_int(3)
    var _resume_is_k3 = ctx.mir_emit_binary(op_constants::OP_EQ, _resume_kind, _resume_three)
    var _resume_cont_blk = ctx.mir_create_block("resume_cont")
    var _resume_ret_blk = ctx.mir_create_block("resume_ret")
    var _resume_entry = ctx.mir_ctx_get_block()
    mir_block_set_branch(_resume_entry, _resume_is_k3, _resume_cont_blk, _resume_ret_blk)
    # kind<3 path: F.3a `ret v` — terminates the handler.
    ctx.mir_switch_to_block(_resume_ret_blk)
    ctx.mir_emit_return(_res_val)
    # kind=3 path: invoke the continuation via helper; fall through with
    # body_rv as the resume-expression value.
    ctx.mir_switch_to_block(_resume_cont_blk)
    var _resume_cont_args = vec_new<Int>()
    _resume_cont_args.push(_res_val)
    var _resume_body_rv = ctx.mir_emit_call("__qz_effect_resume_cont", _resume_cont_args)
    return _resume_body_rv
  end

  # === Effect-op call diversion (Effects C.4) ===
  # If the typechecker's C.3 block marked this NODE_CALL as an effect-op
  # invocation, route it through MIR_PERFORM_OP instead of MIR_CALL. The
  # op's declaring effect + op name both live on the AST annotation so
  # we don't have to reach back into the tc registry here (mir_lower has
  # no access to tc). Codegen stubs MIR_PERFORM_OP to a zero value in
  # C.4; C.5 binds it to the handler vtable via the evidence parameter.
  if ast::ast_is_op_call(s, node) == 1
    var _op_effect_name = ast::ast_op_call_effect_name(s, node)
    var _op_name = ast::ast_op_call_op_name(s, node)
    var _op_kind = ast::ast_op_call_kind(s, node)
    var _op_args = vec_new()
    var _op_argc = arg_nodes.size
    for _op_ai in 0.._op_argc
      _op_args.push(mir_lower::mir_lower_expr(ctx, s, arg_nodes[_op_ai]))
    end
    mir_lower::mir_emit_fuel_check(ctx)
    # P5.5.c: flag Intern use so codegen emits the main-prelude install.
    # Any `intern(...)` / `resolve(...)` perform-op lowers through here;
    # the flag stays 0 for programs that never use std/intern, so their
    # main prelude doesn't emit a reference to `@intern$intern_default_handler`
    # (which would otherwise cause a link error for non-importing programs).
    if _op_effect_name.eq("Intern")
      mir::mir_set_uses_intern(ctx.mir_ctx_get_program())
    end
    # A.3 Pass 1: same gating for Cache. The std/cache default handler
    # is `@cache$cache_default_handler`, a Quartz function that pulls in
    # build_cache + dep_graph + their transitive closure. Programs that
    # never call cache_op_* shouldn't pay that link cost.
    if _op_effect_name.eq("Cache")
      mir::mir_set_uses_cache(ctx.mir_ctx_get_program())
    end
    # A.6 Pass 1: same gating for Profile. The std/profile default
    # handler is `@profile$profile_default_handler`, a Quartz function
    # that reads RSS + emits to stderr; gating avoids forcing the link.
    if _op_effect_name.eq("Profile")
      mir::mir_set_uses_profile(ctx.mir_ctx_get_program())
    end
    # P3.0b: kind=3 ops (continuation-preserving resume) require the
    # caller to be $poll-lowered so resume(v) has a frame to re-enter.
    # Mark the enclosing function as a suspendable leaf; the fixed-
    # point in mir_mark_suspendable propagates to transitive callers.
    # EFFECT_SUSPEND auto-registration deferred to P3.0c-perform —
    # the sequencing requires scheduler integration (how a lazy
    # kind=3-containing future gets polled).
    if _op_kind == 3
      var _p3b_fn = ctx.mir_ctx_get_func()
      if _p3b_fn != 0
        var _p3b_name = mir::mir_func_get_name(_p3b_fn)
        if str_byte_len(_p3b_name) > 0
          mir_lower_async_registry::mir_record_suspendable_leaf(_p3b_name)
        end
      end
    end
    # P3.0c-perform: inside a $poll body, a kind=3 op becomes a
    # suspension point. Save state + spill locals, store %self into
    # TLS cont_frame, call perform, and ret POLL_READY (so the outer
    # invocation doesn't re-run post-perform code that the nested
    # resume-invocation already executed). The resume block loads
    # the resume value from TLS as the perform-expression value.
    # Outside $poll (non-async caller), kind=3 falls through to the
    # plain path — the null cont_frame guard in
    # __qz_effect_resume_cont makes this safe (F.3a early-return).
    if _op_kind == 3 and mir_lower_gen::mir_gen_is_active() >= 2
      return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, _op_name, _op_effect_name, _op_args)
    end
    return ctx.mir_emit_perform_op(_op_name, _op_effect_name, _op_kind, _op_args)
  end

  # === Binary DSL method diversion (Phase 1.4 STEP 2) ===
  # `TypeName$encode(self)` → MIR_BINARY_PACK
  # `TypeName$decode(bytes)` → MIR_BINARY_UNPACK
  # Only fires when TypeName names a registered binary/packed layout.
  # Stub codegen in 1.3 turned these into `add i64 0, 0`; real shift/mask
  # codegen lands in STEP 4. Deliberately runs before `join` etc. — none
  # of the other special cases legally share a TypeName$method shape.
  var _dsl_dollar = -1
  var _dsl_fn_len = str_byte_len(func_name)
  for _dsl_di in 0.._dsl_fn_len
    if str_byte_at(func_name, _dsl_di) == '$'
      _dsl_dollar = _dsl_di
    end
  end
  if _dsl_dollar > 0
    var _dsl_tail = str_byte_slice(func_name, _dsl_dollar + 1, _dsl_fn_len)
    if _dsl_tail.eq("encode") or _dsl_tail.eq("decode")
      var _dsl_head = str_byte_slice(func_name, 0, _dsl_dollar)
      var _dsl_prog = ctx.mir_ctx_get_program()
      var _dsl_layout = mir::mir_find_binary_layout(_dsl_prog, _dsl_head)
      if _dsl_layout < 0
        # Fall back to bare type name if layout was registered without
        # module prefix (main module, not imported).
        var _dsl_dol2 = -1
        var _dsl_head_len = str_byte_len(_dsl_head)
        for _dsl_di2 in 0.._dsl_head_len
          if str_byte_at(_dsl_head, _dsl_di2) == '$'
            _dsl_dol2 = _dsl_di2
          end
        end
        if _dsl_dol2 >= 0
          var _dsl_bare = str_byte_slice(_dsl_head, _dsl_dol2 + 1, _dsl_head_len)
          _dsl_layout = mir::mir_find_binary_layout(_dsl_prog, _dsl_bare)
        end
      end
      if _dsl_layout >= 0
        if _dsl_tail.eq("encode")
          var _dsl_pack = vec_new<Int>()
          if arg_nodes.size >= 1
            var _dsl_self_val = mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])
            # Phase 2 Track A: if any field in the layout has a computed
            # expression, lower each expression with `self` bound to the
            # user-supplied struct, then build a mutated clone carrying the
            # computed overrides. PACK consumes this clone like a normal
            # struct — no codegen changes needed.
            var _dsl_fcount = mir::mir_binary_layout_field_count(_dsl_prog, _dsl_layout)
            var _dsl_has_computed = 0
            for _dsl_ci in 0.._dsl_fcount
              if mir::mir_binary_layout_field_compute_ast(_dsl_prog, _dsl_layout, _dsl_ci) != 0
                _dsl_has_computed = 1
              end
            end
            if _dsl_has_computed == 1
              # Count non-pad fields to size the clone (pad fields aren't struct slots).
              var _dsl_struct_words = 0
              for _dsl_ci in 0.._dsl_fcount
                var _dsl_fname = mir::mir_binary_layout_field_name(_dsl_prog, _dsl_layout, _dsl_ci)
                if str_byte_len(_dsl_fname) > 0 and not _dsl_fname.eq("_")
                  _dsl_struct_words = _dsl_struct_words + 1
                end
              end
              var _dsl_clone = ctx.mir_emit_alloc(_dsl_struct_words)
              # Bind `self` so computed expressions can reference fields
              # of the original (user-supplied) struct via `self.field`.
              # Track saved scope sizes so we restore on exit — this fires
              # mid-function so shadowing an outer `self` is possible.
              var _dsl_bindings = mir::mir_ctx_get_bindings(ctx)
              var _dsl_struct_types = mir::mir_ctx_get_struct_types(ctx)
              var _dsl_saved_b = _dsl_bindings.size
              var _dsl_saved_s = _dsl_struct_types.size
              var _dsl_self_slot = ctx.mir_ctx_alloc_slot()
              ctx.mir_ctx_bind_var("self", _dsl_self_slot)
              # Use the registered layout name so field lookup hits the
              # same struct entry as the binary block's registration.
              var _dsl_reg_name = mir::mir_binary_layout_name(_dsl_prog, _dsl_layout)
              ctx.mir_ctx_mark_struct_var("self", _dsl_reg_name)
              ctx.mir_emit_store_var("self", _dsl_self_val)
              var _dsl_struct_fi = 0
              for _dsl_ci in 0.._dsl_fcount
                var _dsl_fname = mir::mir_binary_layout_field_name(_dsl_prog, _dsl_layout, _dsl_ci)
                if str_byte_len(_dsl_fname) == 0 or _dsl_fname.eq("_")
                  continue
                end
                var _dsl_compute_ast = mir::mir_binary_layout_field_compute_ast(_dsl_prog, _dsl_layout, _dsl_ci)
                var _dsl_slot_val = 0
                if _dsl_compute_ast != 0
                  _dsl_slot_val = mir_lower::mir_lower_expr(ctx, s, _dsl_compute_ast)
                else
                  _dsl_slot_val = ctx.mir_emit_load_offset(_dsl_self_val, _dsl_struct_fi)
                end
                ctx.mir_emit_store_offset(_dsl_clone, _dsl_struct_fi, _dsl_slot_val)
                _dsl_struct_fi = _dsl_struct_fi + 1
              end
              # Restore bindings and struct-type tables to prior state so
              # outer-scope identifiers resolve correctly after this call.
              while _dsl_bindings.size > _dsl_saved_b
                _dsl_bindings.pop()
              end
              while _dsl_struct_types.size > _dsl_saved_s
                _dsl_struct_types.pop()
              end
              _dsl_self_val = _dsl_clone
            end
            _dsl_pack.push(_dsl_self_val)
          end
          return mir::mir_emit_binary_pack(ctx, _dsl_layout, _dsl_pack)
        else
          var _dsl_bytes = 0
          if arg_nodes.size >= 1
            _dsl_bytes = mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])
          end
          return mir::mir_emit_binary_unpack(ctx, _dsl_layout, _dsl_bytes)
        end
      end
    end
  end

  # === join(handle): colorless await — same codegen as NODE_AWAIT ===
  if func_name == "join"
    if arg_nodes.size >= 1
      var join_arg = arg_nodes[0]
      var handle_val = mir_lower::mir_lower_expr(ctx, s, join_arg)
      # Check if this is a known lazy async variable
      var join_is_lazy = false
      if ast::ast_get_kind(s, join_arg) == node_constants::NODE_IDENT
        var join_name = ast::ast_get_str1(s, join_arg)
        join_is_lazy = mir_lower_async_registry::mir_is_lazy_async_var(join_name)
      end
      if join_is_lazy
        if mir_lower_gen::mir_gen_is_active() >= 2
          # Inside $poll: generate suspend/resume (same as NODE_AWAIT known-lazy)
          var join_afn = mir_lower_gen::mir_gen_get_async_func_name()
          if str_byte_len(join_afn) > 0
            mir_lower_async_registry::mir_record_suspendable_leaf(join_afn)
          end
          var join_handle_name = ast::ast_get_str1(s, join_arg)
          var jp_fn = ctx.mir_emit_load_offset(handle_val, 2)
          var jp_args = vec_new()
          jp_args.push(handle_val)
          var jp_result = ctx.mir_emit_call_indirect(jp_fn, jp_args)
          var jp_ready = ctx.mir_emit_binary(op_constants::OP_EQ, jp_result, ctx.mir_emit_const_int(1))
          var jp_done = ctx.mir_create_block("join_done")
          var jp_suspend = ctx.mir_create_block("join_suspend")
          mir_block_set_branch(ctx.mir_ctx_get_block(), jp_ready, jp_done, jp_suspend)
          # Suspend
          ctx.mir_switch_to_block(jp_suspend)
          var jp_state = mir_lower_gen::mir_gen_inc_yield_counter()
          var jp_ln = mir_lower_gen::mir_gen_get_local_names()
          var jp_lo = mir_lower_gen::mir_gen_get_local_offsets()
          var jp_self = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
          for jpi in 0..jp_ln.size
            ctx.mir_emit_store_offset(jp_self, jp_lo[jpi], ctx.mir_emit_load_var(jp_ln[jpi]))
          end
          ctx.mir_emit_store_offset(jp_self, 0, ctx.mir_emit_const_int(jp_state))
          mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, jp_result)
          # Resume
          var jp_resume = ctx.mir_create_block("join_resume")
          mir_lower_gen::mir_gen_add_resume_block(jp_resume)
          ctx.mir_switch_to_block(jp_resume)
          var jp_self_r = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
          for jpj in 0..jp_ln.size
            ctx.mir_emit_store_var(jp_ln[jpj], ctx.mir_emit_load_offset(jp_self_r, jp_lo[jpj]))
          end
          var jp_hr = ctx.mir_emit_load_var(join_handle_name)
          var jp_fn_r = ctx.mir_emit_load_offset(jp_hr, 2)
          var jp_args_r = vec_new()
          jp_args_r.push(jp_hr)
          var jp_result_r = ctx.mir_emit_call_indirect(jp_fn_r, jp_args_r)
          var jp_ready_r = ctx.mir_emit_binary(op_constants::OP_EQ, jp_result_r, ctx.mir_emit_const_int(1))
          var jp_resuspend = ctx.mir_create_block("join_resuspend")
          mir_block_set_branch(ctx.mir_ctx_get_block(), jp_ready_r, jp_done, jp_resuspend)
          # Re-suspend
          ctx.mir_switch_to_block(jp_resuspend)
          var jp_self_rs = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
          for jpk in 0..jp_ln.size
            ctx.mir_emit_store_offset(jp_self_rs, jp_lo[jpk], ctx.mir_emit_load_var(jp_ln[jpk]))
          end
          ctx.mir_emit_store_offset(jp_self_rs, 0, ctx.mir_emit_const_int(jp_state))
          mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, jp_result_r)
          # Done
          ctx.mir_switch_to_block(jp_done)
          var jp_hd = ctx.mir_emit_load_var(join_handle_name)
          return ctx.mir_emit_load_offset(jp_hd, 1)
        end
        # Non-async: completion-watch-and-block
        return mir_lower_gen::mir_emit_completion_await(ctx, handle_val)
      end
      # Dynamic handle: use completion-watch-and-block
      return mir_lower_gen::mir_emit_completion_await(ctx, handle_val)
    end
  end

  # === Special handling for addr_of (needs variable NAME, not VALUE) ===
  if func_name == "addr_of"
    if arg_nodes.size < 1
      puts("[MIR] addr_of requires 1 argument")
      return 0
    end
    var arg_node = arg_nodes[0]
    var arg_kind = ast::ast_get_kind(s, arg_node)
    # NodeIdent = 6
    if arg_kind != 6
      puts("[MIR] addr_of argument must be a variable name")
      return 0
    end
    var var_name = ast::ast_get_str1(s, arg_node)
    var dest = ctx.mir_emit_value(mir::MIR_TYPE_INT)
    var ao_instr = mir_new_instr(mir::MIR_ADDR_OF, dest, mir::MIR_TYPE_INT)
    mir_instr_set_var_name(ao_instr, var_name)
    ctx.mir_emit_instr(ao_instr)
    return dest
  end

  # Check for module-qualified call: parser creates UFCS-style call where
  # first arg is module name. Detect and fix: math.add(1,2) becomes add(math,1,2)
  # but should be math$add(1,2)
  # SKIP if func_name already has '$' (resolver already qualified it) to prevent
  # double-prefixing when a parameter name matches a module name (e.g., lexer, parser)
  var start_idx = 0
  var already_qualified = 0
  var fn_len = str_byte_len(func_name)
  for qi in 0..fn_len
    if str_byte_at(func_name, qi) == '$'
      already_qualified = 1
    end
  end
  if already_qualified == 0
    if arg_nodes.size > 0
      var first_arg = arg_nodes[0]
      var first_kind = ast::ast_get_kind(s, first_arg)
      if first_kind == node_constants::NODE_IDENT
        var first_name = ast::ast_get_str1(s, first_arg)
        # Only treat as module-qualified call if the name is NOT a local variable.
        # Local variables shadow module names (e.g., `value` var vs `value` module).
        var is_local_var = ctx.mir_ctx_lookup_var(first_name)
        if is_local_var < 0 and mir_is_module_name(ctx, first_name)
          # This is module.func() - prepend module to func name and skip first arg
          func_name = string_intern::mangle(first_name, func_name)
          start_idx = 1
        end
      end
    end
  end

  # === go_priority(level, func, args...) — priority-aware spawn ===
  # Unlike `go` (a keyword with AST-level support), go_priority is an intrinsic
  # that must construct the async Future frame here in MIR lowering.
  # Signature: go_priority(level, func_name, arg1, arg2, ...)
  #   level: 0=CRITICAL, 1=HIGH, 2=NORMAL, 3=LOW
  #   func_name: identifier of the function to spawn
  #   arg1...: arguments to pass to the function
  if func_name == "go_priority"
    var gp_prog = ctx.mir_ctx_get_program()
    mir_set_uses_scheduler(gp_prog)

    if arg_nodes.size < 2
      puts("[MIR] go_priority requires at least 2 arguments: level and function")
      return 0
    end

    # Lower priority level (first argument)
    var gp_level = mir_lower::mir_lower_expr(ctx, s, arg_nodes[0])

    # Get function name from second argument (must be an identifier)
    var gp_func_node = arg_nodes[1]
    var gp_func_name = ast::ast_get_str1(s, gp_func_node)
    var gp_resolved = mir_resolve_func_name(ctx, gp_func_name)

    # Register as async target for PASS 1.2 $new/$poll generation
    var gp_func_entry = ctx.mir_lookup_function(gp_resolved)
    if gp_func_entry.is_some()
      mir_lower_async_registry::mir_record_async_target(gp_resolved, s)
    end

    # Lower remaining arguments [2:] — these are the function's actual params
    var gp_func_args = vec_new()
    for gpi in 2..arg_nodes.size
      var gp_arg_val = mir_lower::mir_lower_expr(ctx, s, arg_nodes[gpi])
      gp_func_args.push(gp_arg_val)
    end

    # Construct Future frame: __Future_func$new(args...)
    var gp_ctor = "__Future_#{gp_resolved}$new"
    var gp_frame = ctx.mir_emit_call(gp_ctor, gp_func_args)

    # Emit go_priority intrinsic: sets priority in table, then sched_spawn
    var gp_intrinsic_args = vec_new()
    gp_intrinsic_args.push(gp_frame)
    gp_intrinsic_args.push(gp_level)
    ctx.mir_emit_intrinsic("go_priority", gp_intrinsic_args)
    return gp_frame
  end

  var arg_count = arg_nodes.size
  var na_default_mask = ast::ast_call_get_default_mask(s, node)
  # B.10 §14 N1 Phase 2 — call-argument niche expected type. Resolve the callee's
  # param AST up front so each Option<…>-typed param can supply its concrete type
  # as the niche construction's expected type while THAT arg lowers (the only
  # source for a bare `None` passed positionally). Param i ↔ arg_nodes[i]: for the
  # module-qualified case start_idx==1 shifts arg_nodes past the module-name slot,
  # so the param at index (i - start_idx) is the one the arg fills. The set is
  # scoped strictly around each arg's lowering and cleared after — never leaked to
  # an unrelated site. Falls back to no-op (SPILL, safe) whenever the callee or a
  # param annotation is unavailable.
  var na_params = -1
  var na_param_count = 0
  var na_param_store = s
  var na_have_params = 0
  var na_call_resolved = mir_resolve_func_name(ctx, func_name)
  var na_call_entry = ctx.mir_lookup_function(na_call_resolved)
  # item 20 P1 — does the resolved callee take a mutating value-struct `self`
  # receiver? If so the receiver arg (position start_idx) is passed by the caller's
  # slot ADDRESS instead of a fresh value-copy, so the in-place mutation persists.
  var na_mut_value_receiver = 0
  # items 9h+9i — the resolved callee AST node + store, so the per-arg V2b retain
  # can ask `mir_cow_value_param_is_borrowed(callee, i)`: a borrowed (read-only,
  # non-escaping cow @value) param slot gets NO caller retain, symmetric to the
  # callee's skipped release. -1 store-node ⇒ no usable AST callee ⇒ no borrow.
  var na_callee_node = -1
  var na_callee_store = s
  if na_call_entry.is_some()
    var na_fe = na_call_entry.unwrap()
    if na_fe.tag == 0
      na_params = ast::ast_get_left(na_fe.ast_store, na_fe.node_id)
      if na_params >= 0
        na_param_count = vec_size(na_params)
        na_param_store = na_fe.ast_store
        na_have_params = 1
      end
      na_mut_value_receiver = mir_callee_is_mut_value_receiver(ctx, na_fe.ast_store, na_fe.node_id)
      na_callee_node = na_fe.node_id
      na_callee_store = na_fe.ast_store
    end
  end
  # item 20 P1 — receiver-type-mangled fallback. For `p.bump()` the call is NOT
  # module-qualified, so `func_name` is the RAW unmangled method name ("bump") and
  # the direct `mir_lookup_function("bump")` above misses (the real symbol is
  # `Point$bump`). The receiver-type → `Type$func` mangling that the later A8
  # dispatch block (~3197) performs hasn't run yet, so recompute the verdict here
  # from the receiver's tracked var-type. Mirrors that block: receiver is
  # arg_nodes[start_idx]; if a NODE_IDENT, look up its var-type (spec-param type as
  # a cheap fallback), strip generic args, mangle `Type$func`, look up that entry,
  # and run the same callee predicate. ADDITIVE — only flips 0→1, never 1→0, so the
  # direct-lookup path for already-qualified / free callees stays intact. Gate-0-
  # inert: the predicate returns 0 for non-@value receivers (compiler uses zero).
  if na_mut_value_receiver == 0 and start_idx < arg_count
    var nm_recv_node = arg_nodes[start_idx]
    if ast::ast_get_kind(s, nm_recv_node) == node_constants::NODE_IDENT
      var nm_recv_name = ast::ast_get_str1(s, nm_recv_node)
      var nm_recv_ty = ctx.mir_ctx_lookup_spec_param_type(nm_recv_name)
      if str_byte_len(nm_recv_ty) == 0
        nm_recv_ty = ctx.mir_ctx_get_var_type(nm_recv_name)
      end
      if str_byte_len(nm_recv_ty) > 0
        var nm_pt = nm_recv_ty
        var nm_lt = __char_index(nm_pt, '<')
        if nm_lt > 0
          nm_pt = str_byte_slice(nm_pt, 0, nm_lt)
        end
        # item 33 — `func_name` may ALREADY be the UFCS-canonicalized
        # `Type$method` (a closure body's `ri.next()` rewrites to `RangeIter$next`
        # via mir_ufcs_canonical, line ~2459) BEFORE this predicate runs. Mangling
        # the receiver type onto that whole string yields a bogus
        # `RangeIter$RangeIter$next`; strip to the BARE method name (after the last
        # `$`) first, exactly as mir_resolve_method_call_receiver_aware does.
        var nm_bare = func_name
        var nm_fn_len = str_byte_len(func_name)
        var nm_last_dollar = -1
        for nm_di in 0..nm_fn_len
          if str_byte_at(func_name, nm_di) == '$'
            nm_last_dollar = nm_di
          end
        end
        if nm_last_dollar >= 0
          nm_bare = str_byte_slice(func_name, nm_last_dollar + 1, nm_fn_len)
        end
        var nm_mangled = string_intern::mangle(nm_pt, nm_bare)
        var nm_entry = ctx.mir_lookup_function(nm_mangled)
        # item 33 — module-qualified-callee suffix fallback. A stdlib method like
        # `RangeIter.next` registers as the MODULE-QUALIFIED `iter$RangeIter$next`,
        # so the bare `Type$method` lookup above MISSES (mir_resolve_func_name's
        # Case-1 `$`-short-circuit + this direct index lookup both only see
        # `RangeIter$next`). Mirror mir_resolve_func_name's Case-4b suffix search:
        # find the first all_funcs entry ending in `$RangeIter$next`. This is what
        # mir_emit_call ultimately dispatches to (via mir_resolve_canonical), so the
        # predicate now agrees with the emitted call. Gate-0-inert: the callee
        # predicate returns 0 for non-@value receivers ⇒ compiler uses zero ⇒ this
        # only ever flips a @value/value-layout receiver's verdict.
        if nm_entry.is_none()
          var nm_af = mir::mir_ctx_get_all_funcs(ctx)
          if nm_af != 0
            var nm_sfx = "$#{nm_mangled}"
            var nm_i = 0
            while nm_i < nm_af.size and nm_entry.is_none()
              var nm_cand = nm_af[nm_i]
              if nm_cand.tag == 0 and str_ends_with(nm_cand.name, nm_sfx) == 1
                nm_entry = Option::Some(nm_cand)
              end
              nm_i += 1
            end
          end
        end
        if nm_entry.is_some()
          var nm_fe = nm_entry.unwrap()
          if nm_fe.tag == 0
            if mir_callee_is_mut_value_receiver(ctx, nm_fe.ast_store, nm_fe.node_id) == 1
              na_mut_value_receiver = 1
            end
          end
        end
      end
    end
  end
  # B.10 §14 N1 Phase 2b — collection-INSERT niche expected type. The call-arg
  # niche propagation above (`na_param_ty`) only fires for named-function callees;
  # `v.push(x)` / `v[i] = x` lower to the `vec_push` / `vec_set` INTRINSICS, whose
  # value argument never received the element type as its construction expected
  # type. A `None` (or a `Some(struct)`) stored into a `Vec<Option<P>>` element
  # therefore SPILLED to a tagged box instead of niching, breaking the element
  # round-trip (the niche read range-tests the box pointer as non-null → Some).
  # Recover the element type the same way the post-loop `_vec_elem_type` block
  # does (UFCS str2, else tracked vec-elem registry) and, when it is an
  # `Option<…>`, set niche-expected on the VALUE arg while it lowers. Index of
  # the value arg: vec_push / set_add → start_idx+1; vec_set → start_idx+2.
  # Inert (no niche-expected set) for non-Option element types and flag-OFF
  # (mir_ctx_set_niche_expected is consumed only by niche construction, which is
  # gated on mir_option_is_niche → byte-identical when the niche doesn't apply).
  var _ci_value_idx = -1
  var _ci_elem_ty = ""
  # `map_set(map, key, value)` is the VALUE-position analog of `vec_set`: the
  # value arg is at start_idx+2 and its element type is the Map's V (the 2nd
  # type arg of `Map<K, V>`), recovered below via the map-value-type registry /
  # receiver inference rather than the vec-elem registry. Without this, a bare
  # `m.set(k, None)` on a `Map<K, Option<V>>` spilled to a tagged box that the
  # niche-aware read side range-tests as non-null → misreads as Some (§14.4).
  var _ci_is_map = 0
  if func_name == "vec_push" or func_name == "set_add"
    _ci_value_idx = start_idx + 1
  elsif func_name == "vec_set" or func_name == "vec_set_unchecked"
    _ci_value_idx = start_idx + 2
  elsif func_name == "map_set"
    _ci_value_idx = start_idx + 2
    _ci_is_map = 1
  end
  # B.10 §14.12 value semantics (V2d, INERT at gate 0): the collection-insert
  # element value-copy position. SEPARATE from `_ci_value_idx`, which is the
  # niche-expected-type position and gets reset to -1 below for non-Option/Result
  # elements (the niche logic only applies to those). The V2d copy must fire for
  # ANY value-layout element type — a `Vec<@value-struct>` push of a NODE_IDENT
  # lvalue whose `arg_val` is a function-local construct buffer (e.g. a decomposed
  # value-struct param re-boxed onto the callee's stack: `csv_document_add_row`'s
  # `vec_push(doc.rows, row)`) MUST store an independent heap copy, else the vec
  # element is a dangling pointer to a dead stack slot → SIGSEGV on later read.
  # Coupling V2d to the niche `_ci_value_idx` wrongly skipped the copy for every
  # non-niche element. Gate-0-inert: V2d is itself gated on
  # mir_is_value_layout_type (0 for every compiler struct at the flip == 0) ⇒ the
  # copy never emits in self-compile ⇒ byte-identical.
  var _v2d_value_idx = _ci_value_idx
  if _ci_value_idx >= 0
    # Element-type source for the niche expected type. The UFCS str2 annotation
    # (`_ci_ann`) is the width/layout class the codegen uses — for a payload-
    # carrying enum element like `Option<Point>` typecheck records the bare enum
    # ptype name ("Option") or the sentinel "unknown", neither of which carries
    # the concrete payload `P` the niche construction needs. The vec-elem-type
    # registry (`_ci_track`, populated from the `var v: Vec<Option<P>>` annotation
    # at let-lowering) DOES carry the full `Option<P>`. Prefer whichever names a
    # concrete `Option<…>`; the str2 form only when it is one.
    var _ci_ann = ast::ast_get_str2(s, node)
    var _ci_track = ""
    if start_idx < arg_nodes.size
      var _ci_first = arg_nodes[start_idx]
      if _ci_is_map == 1
        # Map VALUE-position: recover V (the 2nd type arg of `Map<K, V>`). The
        # map-value-type registry is keyed on var names (populated at the
        # `var m: Map<K, V>` / `map_new()` / param sites); for a non-IDENT
        # receiver infer the receiver's Map type and extract its V. The map_set
        # str2 annotation is unreliable for the value (key/value ambiguity), so
        # it is NOT consulted for maps — registry/inference only.
        if ast::ast_get_kind(s, _ci_first) == node_constants::NODE_IDENT
          _ci_track = ctx.mir_ctx_get_map_value_type(ast::ast_get_str1(s, _ci_first))
        end
        if _ci_track.starts_with("Option<") == false
          var _ci_mrecv_ty = mir::mir_infer_expr_type(ctx, s, _ci_first)
          if str_byte_len(_ci_mrecv_ty) > 0
            _ci_track = mir::mir_extract_map_value_type(_ci_mrecv_ty)
          end
        end
      elsif ast::ast_get_kind(s, _ci_first) == node_constants::NODE_IDENT
        _ci_track = ctx.mir_ctx_get_vec_elem_type(ast::ast_get_str1(s, _ci_first))
      else
        # Non-IDENT receiver (e.g. a struct field access like `f.last_errors`):
        # the vec-elem registry is keyed on var names only, so it can't carry
        # the element type here. Infer the receiver's declared collection type
        # (`mir_infer_expr_type` resolves NODE_FIELD_ACCESS to the field's type)
        # and extract its `<…>` element. Without this, a `field.push(Option::None)`
        # on a `Vec<Option<String>>`-typed field leaves niche-expected unset, so
        # the None constructs as a TAGGED spill box (non-null) that the later
        # niche `is Some` read range-tests as Some → SIGSEGV (§14.4 construct-
        # niche/read-spill mismatch). Inert flag-OFF and for non-Option elements:
        # mir_ctx_set_niche_expected below is gated on `_ci_elem_ty` being an
        # `Option<…>`, and niche construction itself is gated on mir_option_is_niche.
        var _ci_recv_ty = mir::mir_infer_expr_type(ctx, s, _ci_first)
        if str_byte_len(_ci_recv_ty) > 0
          _ci_track = mir::mir_extract_generic_element_type(_ci_recv_ty)
        end
      end
    end
    if _ci_ann.starts_with("Option<") or _ci_ann.starts_with("Result<")
      _ci_elem_ty = _ci_ann
    elsif _ci_track.starts_with("Option<") or _ci_track.starts_with("Result<")
      _ci_elem_ty = _ci_track
    end
    # enum-niche M2 — a niche-eligible `Result<A,B>` collection element niches at the
    # push/insert site to match the niche read (§14.4). Inert at gate 0.
    if _ci_elem_ty.starts_with("Option<") == false and _ci_elem_ty.starts_with("Result<") == false
      _ci_value_idx = -1
    end
  end
  # Async cross-suspend spill: if a LATER argument contains a suspend point,
  # an earlier argument's SSA register (defined in the pre-suspend block) will
  # not dominate the resume block where the call/intrinsic is finally emitted.
  # Spill each such earlier arg to a generator-frame slot in the pre-suspend
  # block, then reload it after all args are lowered. Mirrors the binary-op
  # spill site (mir_async_spill_if_await / mir_async_reload_if_spilled).
  var _arg_spills = vec_new<String>()
  for _si in start_idx..arg_count
    _arg_spills.push("")
  end
  for i in start_idx..arg_count
    if na_default_mask != 0 and ((na_default_mask >> i) & 1) == 1
      # Named arg default sentinel — push placeholder, expanded below.
      # Placeholder value is 0, a constant — needs no spill.
      args.push(0)
    else
      var arg_node = arg_nodes[i]
      var na_arg_had = 0
      var na_param_idx = i - start_idx
      if na_have_params == 1 and na_param_idx >= 0 and na_param_idx < na_param_count
        var na_param_ty = ast::ast_get_str2(na_param_store, na_params[na_param_idx])
        if na_param_ty.starts_with("Option<") or na_param_ty.starts_with("Result<")
          # enum-niche M2 — a call-arg flowing into a `Result<A,B>` param niche-
          # constructs to match the callee's param annotation, the SAME type the
          # read side recovers inside the callee (§14.4). Inert at gate 0.
          mir::mir_ctx_set_niche_expected(ctx, na_param_ty)
          na_arg_had = 1
        end
      end
      # B.10 §14 N1 Phase 2b — collection-insert value arg carries the element
      # Option<…> type as its niche construction expected type (see pre-loop block).
      if i == _ci_value_idx
        mir::mir_ctx_set_niche_expected(ctx, _ci_elem_ty)
        na_arg_had = 1
      end
      var arg_val = mir_lower::mir_lower_expr(ctx, s, arg_node)
      if na_arg_had == 1
        mir::mir_ctx_clear_niche_expected(ctx)
      end
      # R2.1 (B3) — union widening at CALL ARG: when the callee's param type is a
      # union (`A | B`) and this arg is a bare arm (not already a union cell), wrap
      # `arg_val` into the union's tagged cell so the callee's B2 narrow recovers the
      # member. Only in this real-arg else branch (never the default-arg placeholder
      # `args.push(0)`). The param annotation is registered verbatim via
      # mir_func_set_param_type_name, so a passthrough `g(x)` where `x` is a union
      # param infers to the union annotation and short-circuits (no double-widen).
      # Keyed on a union param annotation, unused by the compiler's own sources ⇒
      # gate-0-inert / byte-identical self-compile.
      if na_have_params == 1 and na_param_idx >= 0 and na_param_idx < na_param_count
        var b3_param_ty = ast::ast_get_str2(na_param_store, na_params[na_param_idx])
        if mir_is_union_annotation(b3_param_ty)
          var b3_arg_arm = ctx.mir_infer_expr_type(s, arg_node)
          if mir_is_union_annotation(b3_arg_arm) == false
            arg_val = mir_lower::mir_emit_widen_to_union(ctx, arg_val, b3_param_ty, b3_arg_arm)
          end
        end
      end
      # R2.2 — union widen at the collection-insert VALUE position (`v.push(arm)`
      # into a `Vec<A | B>`). B3's call-arg widen above is keyed on na_have_params
      # (the callee's DECLARED user param annotations); vec_push / set_add / vec_set
      # are intrinsics whose element type flows through the vec-elem registry /
      # receiver inference, NOT a param list — so recover it here and widen the arm
      # into the {tag@0,payload@1} cell the read side (v[i] narrowed-read, Edit C)
      # expects. The 16B cell rides the BOXED-pointer Vec path (a union annotation
      # is not a registered struct ⇒ cg_vec_inline_field_count=0 ⇒ stride-1), so the
      # store matches the read load. The `v[i]=arm` NODE_INDEX_ASSIGN store path is
      # a SEPARATE lowering already widened by B3 (mir_lower_stmt_handlers.qz:~1394)
      # ⇒ not double-widened here. GATE-0-INERT: no Vec<union> element in compiler/
      # std ⇒ the recovered elem type is never a union ⇒ mir_is_union_annotation is
      # false ⇒ no widen emitted ⇒ byte-identical self-compile.
      if i == _v2d_value_idx and start_idx < arg_nodes.size
        var b2e_elem = ""
        var b2e_recv = arg_nodes[start_idx]
        if ast::ast_get_kind(s, b2e_recv) == node_constants::NODE_IDENT
          b2e_elem = ctx.mir_ctx_get_vec_elem_type(ast::ast_get_str1(s, b2e_recv))
        end
        if str_byte_len(b2e_elem) == 0
          var b2e_recv_ty = mir::mir_infer_expr_type(ctx, s, b2e_recv)
          if str_byte_len(b2e_recv_ty) > 0
            b2e_elem = mir::mir_extract_generic_element_type(b2e_recv_ty)
          end
        end
        if mir_is_union_annotation(b2e_elem)
          var b2e_arm = ctx.mir_infer_expr_type(s, arg_node)
          if mir_is_union_annotation(b2e_arm) == false
            arg_val = mir_lower::mir_emit_widen_to_union(ctx, arg_val, b2e_elem, b2e_arm)
          end
        end
      end
      # R2 (C1/§3.3) — record width-subtyping REPROJECTING COPY at CALL ARG. When the
      # callee's param is a structural record (`{ x: Int }`) and the arg is a wider
      # nominal struct whose physical layout is not offset-compatible with the record
      # (COW header shift and/or field reordering), reproject the source into the
      # record's canonical flat layout so the callee's record-view reads land on the
      # right slots. Without this the callee reads the source's refcount header as
      # field 0 (the C1 regression). Only fires for a record param whose arg infers to
      # a DIFFERENT registered nominal struct — a passthrough `g(r)` where `r` is
      # already the same record infers to the record annotation and short-circuits.
      # GATE-0-INERT: no compiler/stdlib param is record-typed ⇒ byte-identical.
      var rr_reprojected = 0
      if na_have_params == 1 and na_param_idx >= 0 and na_param_idx < na_param_count
        var rr_param_ty = ast::ast_get_str2(na_param_store, na_params[na_param_idx])
        # Pure record only (not an intersection `{A}&{B}` — those resolve field reads
        # through the per-struct global fallback, so a canonical-record reproject would
        # mis-parse the merged annotation. Intersection>16B reprojection is filed C2).
        if mir::mir_is_record_annotation(rr_param_ty) and mir::mir_record_is_intersection(rr_param_ty) == false
          var rr_arg_ty = ctx.mir_infer_expr_type(s, arg_node)
          var rr_canon = mir::mir_record_canonical_name(rr_param_ty)
          # Skip when the arg is already the record's canonical layout (passthrough)
          # or its type can't be resolved to a nominal struct.
          if mir::mir_is_record_annotation(rr_arg_ty) == false and
             rr_arg_ty != rr_canon and str_byte_len(rr_arg_ty) > 0
            var rr_src_resolved = mir::mir_resolve_struct_name(ctx, rr_arg_ty)
            if rr_src_resolved != rr_canon
              arg_val = mir_lower::mir_emit_reproject_to_record(ctx, arg_val, rr_arg_ty, rr_param_ty)
              rr_reprojected = 1
            end
          end
        end
      end
      # B.10 §14.12 value semantics (V2d, INERT at gate 0): copy a `@value` struct
      # ELEMENT on collection insert. `v.push(a)` / `m.set(k, a)` must store an
      # INDEPENDENT copy so a later `a.x = 999` doesn't alias the stored element
      # (the §14.11.8 reference-semantics bug, store direction). This is the
      # OPPOSITE-direction copy from V2b: V2b copies args INTO user-defined callees
      # (and EXCLUDES intrinsic callees); V2d re-enables the copy for the SPECIFIC
      # element-storing intrinsics ONLY at the element-VALUE arg position
      # (`i == _ci_value_idx`), never the receiver (start_idx) and never a read /
      # index / slice intrinsic (those never set _ci_value_idx). Slice-safe by
      # construction: the receiver slice-view (whose var-type is its element
      # @value struct ⇒ would truncate the 24-byte header) is at start_idx, which
      # is strictly < _ci_value_idx ⇒ never reached here. Only bare-IDENT named
      # @value lvalues are copied; struct literals / call results are fresh
      # rvalues, and `&a` parses to NODE_FUNC_REF (the explicit alias opt-out).
      # Keyed on `@value` (the compiler uses zero) ⇒ gate-0-dead ⇒ fixpoint-trivial.
      if i == _v2d_value_idx and mir::mir_value_semantics_live() == 1 and rr_reprojected == 0
        if ast::ast_get_kind(s, arg_node) == node_constants::NODE_IDENT
          var v2d_arg_name = ast::ast_get_str1(s, arg_node)
          var v2d_arg_ty = ctx.mir_ctx_get_var_type(v2d_arg_name)
          if str_byte_len(v2d_arg_ty) > 0
            # F4a: single layout key (= is_value at gate-0, byte-identical).
            if mir::mir_is_value_layout_type(ctx, v2d_arg_ty) == 1
              arg_val = mir::mir_emit_value_copy(ctx, arg_val, v2d_arg_ty)
            end
          end
        end
      end
      # Does any argument at index j > i contain a suspend point? If so, this
      # arg's SSA value must be spilled before that later arg is lowered.
      var _later_suspend_node = -1
      for j in (i + 1)..arg_count
        if _later_suspend_node < 0
          if na_default_mask == 0 or ((na_default_mask >> j) & 1) == 0
            if mir_expr_contains_await(s, arg_nodes[j]) == 1
              _later_suspend_node = arg_nodes[j]
            end
          end
        end
      end
      if _later_suspend_node >= 0
        var _sp = mir_async_spill_if_await(ctx, s, _later_suspend_node, arg_val)
        _arg_spills[i - start_idx] = _sp
      end
      # B.10 §14.12 value semantics (V2b, INERT at gate 0): eager copy of a
      # `@value` struct passed BY VALUE as a call argument, so callee mutations
      # don't alias the caller's struct (the §14.11.8 reference-semantics bug).
      # Only bare-IDENT args (named lvalues that could alias) are copied; struct
      # literals / call results are already fresh rvalues, and `&a` / `&mut a`
      # parse to NODE_FUNC_REF (NOT NODE_IDENT) — the borrow is the explicit
      # opt-out, so it falls through unchanged. Keyed on `@value` (the compiler
      # uses zero) ⇒ gate-0-dead ⇒ fixpoint-trivial. v1 eager; COW later.
      # An intrinsic callee (slice_get / vec_push / map_set / …) operates on its
      # receiver/args with deliberate reference/view semantics — the §14.11.8
      # by-value-copy motivation (callee mutations must not alias the caller's
      # struct) applies ONLY to user-defined functions that take an `@value`
      # struct param by value. Worse, a slice-view receiver tracks its ELEMENT
      # type (`ws_s_c: Slice<Point>` ⇒ var-type "Point"), so copying it as that
      # `@value` struct truncates the 24-byte slice header to the element's field
      # count, dropping slot[2]=elem_width ⇒ slice_get reads OOB stride ⇒ SIGSEGV.
      # Never value-copy an intrinsic argument. Also skip when this arg was already
      # reprojected to a record (§3.3): the reproject minted a FRESH, independent
      # record-layout buffer, so V2b's aliasing motivation is already satisfied; a
      # value_copy keyed on the SOURCE type would cow_rc_inc the record buffer's word
      # 0 (a payload field, not a refcount) and corrupt the field (the +1 off-by-one).
      if mir::mir_value_semantics_live() == 1 and mir_intrinsics::mir_is_intrinsic(func_name) == 0 and rr_reprojected == 0
        if ast::ast_get_kind(s, arg_node) == node_constants::NODE_IDENT
          var vs_arg_name = ast::ast_get_str1(s, arg_node)
          var vs_arg_ty = ctx.mir_ctx_get_var_type(vs_arg_name)
          if str_byte_len(vs_arg_ty) > 0
            # F4a: single layout key (= is_value at gate-0, byte-identical).
            if mir::mir_is_value_layout_type(ctx, vs_arg_ty) == 1
              # item 20 P1 — call-site copy ELISION for a mutating value-struct
              # receiver. The RECEIVER argument (position start_idx) of a callee that
              # mutates its `self.<field>` must be passed by the caller's slot ADDRESS,
              # not a fresh value-copy: otherwise the callee mutates a throwaway copy
              # and the write is lost (`p.bump(); p.x` stayed 1). `arg_val` for a
              # NODE_IDENT value-struct lvalue ALREADY holds that slot's construct-
              # buffer pointer (the var's stored value), and the decompose-excluded
              # callee loads/stores THROUGH param 0 as a pointer, so handing it the
              # caller's slot is ABI-identical and the mutation lands in place. Skip
              # the copy ONLY for the receiver of a non-cow mutating-value-receiver
              # callee; every other value-struct arg still gets the V2b aliasing copy.
              # A struct-literal / call-result receiver (a non-addressable temporary)
              # never reaches this NODE_IDENT branch — its mutation is discarded and
              # passing its own fresh slot is already correct.
              # items 9h+9i — symmetric retain skip for a BORROWED non-self cow
              # @value param. If the resolved callee's param at this slot is a
              # provably non-escaping (read-only) cow param, the callee skips its
              # scope-exit cow_release (no droppable registration), so the caller
              # must NOT retain either — pass the caller's live buffer pointer
              # unchanged (mir_emit_value_copy's only effect on a cow arg is the
              # cow_rc_inc retain). Net no-retain/no-release keeps rc balanced; the
              # var still owns the buffer and releases it at ITS scope exit. The
              # mutating-receiver elision (na_mut_value_receiver) already covers the
              # i==start_idx self slot; this covers the read-only NON-self slots.
              # Gate-0-inert (cow-layout false ⇒ borrow predicate 0 ⇒ unchanged).
              var _v2b_borrowed = mir_lower::mir_cow_value_param_is_borrowed(ctx, na_callee_store, na_callee_node, i - start_idx)
              if i == start_idx and na_mut_value_receiver == 1
                # pass arg_val (the caller's slot pointer) unchanged — no copy
              elsif _v2b_borrowed == 1
                # borrowed read-only cow param — pass the caller's buffer, no retain
              else
                arg_val = mir::mir_emit_value_copy(ctx, arg_val, vs_arg_ty)
              end
            end
          end
        elsif ast::ast_get_kind(s, arg_node) == node_constants::NODE_FIELD_ACCESS
          # item 31b — a >16B COW @value struct read OUT of a field access
          # (`holder.styles.text`) and passed as a BY-VALUE method receiver / param
          # returns the bare COW buffer POINTER aliasing the source field's storage
          # (NODE_FIELD_ACCESS is excluded from mir_init_is_cow_collection_readout's
          # let-binding readout retain — this is its call-argument sibling). A
          # droppable by-value cow param cow_releases at the callee's scope exit; with
          # NO matching caller retain, that release drops the shared buffer to rc 0 and
          # FREES storage the source struct field still aliases ⇒ double-free / UAF at
          # teardown (the tui_viewport @value-Style SIGABRT). Emit the cow_rc_inc retain
          # (mir_emit_value_copy on a cow arg is exactly that one atomic retain — no
          # word-copy) so caller-retain ↔ callee-release balances (no leak, no double-
          # free). ONLY for a COW (>16B) field type — a ≤16B value struct decomposes to
          # an inline, independent receiver value (no shared buffer ⇒ no retain needed,
          # mirroring the readout predicate's field-access exclusion). GATED to a
          # NON-borrowed (droppable) receiver/param: a borrowed mutating-self receiver
          # (na_mut_value_receiver) and a borrowed read-only non-self cow param
          # (mir_cow_value_param_is_borrowed) both SKIP the callee release, so retaining
          # there would LEAK — pass the field buffer pointer unchanged in those cases.
          # Gate-0-inert: mir_value_is_cow_layout is false for every non-@value struct
          # at the F4 flip == 0 ⇒ compiler uses zero ⇒ byte-identical self-build.
          var fa_arg_ty = mir::mir_infer_expr_type(ctx, s, arg_node)
          if str_byte_len(fa_arg_ty) > 0 and mir::mir_value_is_cow_layout(ctx, fa_arg_ty) == 1
            var _fa_borrowed = mir_lower::mir_cow_value_param_is_borrowed(ctx, na_callee_store, na_callee_node, i - start_idx)
            if i == start_idx and na_mut_value_receiver == 1
              # borrowed mutating-self receiver — callee skips its release; no retain
            elsif _fa_borrowed == 1
              # borrowed read-only cow param — callee skips its release; no retain
            else
              # droppable by-value cow param — retain (cow_rc_inc) to balance the
              # callee's scope-exit cow_release on the aliased field buffer.
              arg_val = mir::mir_emit_value_copy(ctx, arg_val, fa_arg_ty)
            end
          end
        end
      end
      args.push(arg_val)
    end
  end
  # Reload any spilled args — their SSA registers are stale after the resume
  # block; mir_async_reload_if_spilled is a no-op when no spill happened.
  for i in start_idx..arg_count
    var _sp_name = _arg_spills[i - start_idx]
    if str_byte_len(_sp_name) > 0
      args[i - start_idx] = mir_async_reload_if_spilled(ctx, _sp_name, args[i - start_idx])
    end
  end

  # Move semantics: consume droppable args passed by value (not by borrow)
  for i in start_idx..arg_count
    if na_default_mask == 0 or ((na_default_mask >> i) & 1) == 0
      var arg_node = arg_nodes[i]
      var arg_kind = ast::ast_get_kind(s, arg_node)
      if arg_kind == node_constants::NODE_IDENT
        var arg_var_name = ast::ast_get_str1(s, arg_node)
        # B.10 §14.12.8 (C4) — a cow-layout @value arg passed to a USER function was
        # COPIED above (cow_rc_inc at the value-copy step), NOT moved: the caller
        # retains its own reference and must still cow_release it at scope exit, while
        # the callee releases the retained reference. Consuming it here would suppress
        # the caller's release ⇒ the buffer would never reach rc 0 ⇒ leak. So skip the
        # consume for a cow arg to a USER function. For an INTRINSIC callee the value-
        # copy was SKIPPED (intrinsics borrow / take ownership directly): a storing
        # intrinsic (vec_push/vec_set/set_add/map_set) takes ownership of the cow
        # buffer into the collection, so the caller must NOT also release it — fall
        # through to the normal consume (move). (Vec/Map-element cow release at
        # collection-drop time is the DEFERRED B.15d cascade.) INERT at gate 0.
        var arg_var_ty = ctx.mir_ctx_get_var_type(arg_var_name)
        var arg_is_cow = mir::mir_value_is_cow_layout(ctx, arg_var_ty)
        var callee_is_intrinsic = mir_intrinsics::mir_is_intrinsic(func_name)
        if arg_is_cow == 1 and callee_is_intrinsic == 0
          # retained copy for a user-fn call — caller keeps ownership, do not consume
        else
          mir_consume_droppable(ctx, arg_var_name)
        end
      end
    end
  end

  # === Iterator closure dispatch: .next() on Iterator-bounded params ===
  # When inside an Iterator-bounded function, calls to next(it) where it is an
  # Iterator-bounded param should be dispatched through the closure (indirect call).
  if func_name.eq("next") and args.size > 0 and start_idx < arg_count
    var iter_recv_node = arg_nodes[start_idx]
    var iter_recv_kind = ast::ast_get_kind(s, iter_recv_node)
    if iter_recv_kind == 6  # NODE_IDENT
      var iter_recv_name = ast::ast_get_str1(s, iter_recv_node)
      if ctx.mir_ctx_is_iterator_bound_param(iter_recv_name)
        # Iterator param is a closure Fn(): Option<Int> — call it with no args
        var closure_ptr = args[0]
        var empty_args = vec_new()
        return ctx.mir_emit_call_indirect(closure_ptr, empty_args)
      end
    end
  end

  # === A8: Trait / structural method rewriting inside specialized function ===
  # When lowering the body of a specialized function, resolve method calls
  # using the receiver's per-param type if available, falling back to
  # spec_current_type for backwards compat with bounded generics.
  var spec_type = ctx.mir_ctx_get_spec_current_type()
  # Per-param type: check if first arg is a variable with a known param type.
  # Only override spec_type if the per-param type actually has the target method —
  # otherwise primitive types like Int clobber the bounded generic's spec_current_type.
  if args.size > 0 and start_idx < arg_count
    var recv_node = arg_nodes[start_idx]
    var recv_kind = ast::ast_get_kind(s, recv_node)
    var param_type = ""
    if recv_kind == 6  # node_constants$NODE_IDENT
      var recv_name = ast::ast_get_str1(s, recv_node)
      param_type = ctx.mir_ctx_lookup_spec_param_type(recv_name)
      # NESTED-MONO-UFCS-TYPE-PARAM: fall back to the variable's tracked
      # struct type when the receiver isn't itself a specialization param.
      # For bodies like `var it = src; it.method()`, `src` is the spec param
      # but `it` is a local whose var_type carries the concrete struct name.
      if str_byte_len(param_type) == 0
        param_type = ctx.mir_ctx_get_var_type(recv_name)
      end
    elsif recv_kind == node_constants::NODE_INDEX
      # item 48-a HOOK #1: a NON-IDENT receiver inside a specialized body —
      # e.g. an indexed element `shapes[i].area()` where `shapes` is a
      # `Vec<T>` spec param. With the element type de-erased into the param-type
      # map (`shapes → Vec<Circle>` vs `Vec<Square>`), `mir_infer_expr_type`
      # resolves the NODE_INDEX to the concrete element type per-monomorph
      # (`Circle` / `Square`). Without this, the receiver type was never
      # recovered for index receivers, so the call fell through to a global
      # name-mangle that froze the FIRST monomorph's impl (`Circle$area`) for
      # every element type — the wrong-dispatch collision. Narrowly gated to
      # NODE_INDEX receivers so the inference does not fire on arbitrary
      # non-IDENT receivers (e.g. call/field-chains) and over-specialize
      # unrelated prelude generics.
      param_type = ctx.mir_infer_expr_type(s, recv_node)
    end
    if str_byte_len(param_type) > 0
        # Strip generic args ("MapDoubler<RangeSrc>" → "MapDoubler") for
        # struct-mangled method name lookup.
        var pt_for_dispatch = param_type
        var pt_lt = __char_index(pt_for_dispatch, '<')
        if pt_lt > 0
          pt_for_dispatch = str_byte_slice(pt_for_dispatch, 0, pt_lt)
        end
        # Only override if Type$func_name or Type$func_name$arity exists.
        # Cross-module: also check module-prefixed forms when the current spec
        # lives in an imported module (NESTED-MONO-UFCS-TYPE-PARAM cross-module).
        var mod_prefix = ctx.mir_ctx_get_spec_current_module_prefix()
        var candidate = string_intern::mangle(pt_for_dispatch, func_name)
        var candidate_arity = string_intern::mangle_int(candidate, args.size)
        var matched = 0
        if mir_func_exists_in_all_funcs(ctx, candidate) or mir_func_exists_in_all_funcs(ctx, candidate_arity)
          spec_type = pt_for_dispatch
          matched = 1
        end
        if matched == 0 and str_byte_len(mod_prefix) > 0
          var prefixed_type = "#{mod_prefix}$#{pt_for_dispatch}"
          var pcand = string_intern::mangle(prefixed_type, func_name)
          var pcand_arity = string_intern::mangle_int(pcand, args.size)
          if mir_func_exists_in_all_funcs(ctx, pcand) or mir_func_exists_in_all_funcs(ctx, pcand_arity)
            spec_type = prefixed_type
            matched = 1
          end
        end
        # A.35: receiver's concrete type lives in another module — its method
        # is mangled `module$Type$func`, which neither the unprefixed form nor
        # the spec's own module prefix reconstruct. Suffix-search all_funcs for
        # the real symbol and use its module-qualified prefix. Last resort, so
        # the same-module / spec-module forms above always win first.
        if matched == 0
          var xmod_prefix = _mir_resolve_xmod_type_prefix(ctx, pt_for_dispatch, func_name, args.size)
          if str_byte_len(xmod_prefix) > 0
            spec_type = xmod_prefix
            matched = 1
          end
        end
    end
  end
  # Strip any generic args from spec_type too — spec_current_type may hold the
  # raw `MapDoubler<RangeSrc>` form which cannot be used as a symbol prefix.
  if str_byte_len(spec_type) > 0
    var st_lt = __char_index(spec_type, '<')
    if st_lt > 0
      spec_type = str_byte_slice(spec_type, 0, st_lt)
    end
  end
  if str_byte_len(spec_type) > 0
    var provided = args.size
    # Try Type$func_name$arity first (arity-mangled variant)
    var trait_mangled = "#{spec_type}$#{func_name}$#{provided}"
    if mir_func_exists_in_all_funcs(ctx, trait_mangled)
      return ctx.mir_emit_call(trait_mangled, args)
    end
    # Cross-module fallback: try module$Type$func_name$arity when the current
    # spec lives in an imported module and spec_type came from spec_current_type
    # (which doesn't carry the module prefix).
    var mod_prefix2 = ctx.mir_ctx_get_spec_current_module_prefix()
    if str_byte_len(mod_prefix2) > 0
      var prefixed_trait_mangled = "#{mod_prefix2}$#{spec_type}$#{func_name}$#{provided}"
      if mir_func_exists_in_all_funcs(ctx, prefixed_trait_mangled)
        return ctx.mir_emit_call(prefixed_trait_mangled, args)
      end
      var prefixed_trait_no_arity = "#{mod_prefix2}$#{spec_type}$#{func_name}"
      if mir_func_exists_in_all_funcs(ctx, prefixed_trait_no_arity)
        return ctx.mir_emit_call(prefixed_trait_no_arity, args)
      end
    end
    # Try Type$func_name without arity (non-overloaded variant)
    var trait_no_arity = string_intern::mangle(spec_type, func_name)
    if mir_func_exists_in_all_funcs(ctx, trait_no_arity)
      # Expand default arguments before calling: look up the target function
      # entry and fill in default values for any missing arguments.
      var target_entry = ctx.mir_lookup_function(trait_no_arity)
      if target_entry.is_some()
        var te = target_entry.unwrap()
        if te.tag == 0
          var tfunc_store = te.ast_store
          var tfunc_handle = te.node_id
          var tparams = ast::ast_get_left(tfunc_store, tfunc_handle)
          var tparam_count = vec_size(tparams)
          if provided < tparam_count
            for tpi in provided..tparam_count
              var tparam = tparams[tpi]
              var tdefault = ast::ast_param_default_value(tfunc_store, tparam)
              if tdefault != 0
                var tlowered = mir_lower::mir_lower_expr(ctx, tfunc_store, tdefault)
                # R2.1 (B3 sibling sink) — union widening at DEFAULT ARG (trait path).
                # See the main default-expansion widen below for the rationale.
                var t2_param_ty = ast::ast_get_str2(tfunc_store, tparam)
                if mir_is_union_annotation(t2_param_ty)
                  var t2_arm = ctx.mir_infer_expr_type(tfunc_store, tdefault)
                  if mir_is_union_annotation(t2_arm) == false
                    tlowered = mir_lower::mir_emit_widen_to_union(ctx, tlowered, t2_param_ty, t2_arm)
                  end
                end
                args.push(tlowered)
              end
            end
          end
        end
      end
      return ctx.mir_emit_call(trait_no_arity, args)
    end
  end

  # === A8b: Impl block method call rewriting ===
  # When lowering the body of an impl block method (e.g., Point$eq), calls to
  # other methods in the same impl should be rewritten. For example, if Point$eq
  # calls helper(x), try Point$helper$1 first.
  var impl_type = ctx.mir_ctx_get_impl_current_type()
  if str_byte_len(impl_type) > 0
    var provided = args.size
    # Check if func_name already has Type$ prefix
    var iprefix = "#{impl_type}$"
    var has_type_prefix = 0
    if str_byte_len(func_name) > str_byte_len(iprefix)
      if func_name.starts_with(iprefix)
        has_type_prefix = 1
      end
    end
    var impl_mangled = ""
    if has_type_prefix == 1
      impl_mangled = "#{func_name}$#{provided}"
    else
      impl_mangled = "#{impl_type}$#{func_name}$#{provided}"
    end
    if mir_func_exists_in_all_funcs(ctx, impl_mangled)
      return ctx.mir_emit_call(impl_mangled, args)
    end
    # Try without arity suffix
    if has_type_prefix == 0
      var impl_no_arity = string_intern::mangle(impl_type, func_name)
      if mir_func_exists_in_all_funcs(ctx, impl_no_arity)
        return ctx.mir_emit_call(impl_no_arity, args)
      end
    end
  end

  # Expand default arguments if fewer args provided than params
  var resolved_name = mir_resolve_func_name(ctx, func_name)
  var provided_count = args.size
  var func_entry = ctx.mir_lookup_function(resolved_name)

  # Track direct calls from $poll — callees must not use alwaysinline + stack alloc
  if mir_lower_gen::mir_gen_is_active() >= 2
    mir_register_poll_callee(resolved_name)
  end

  # === Iterator closure dispatch: synthesize closures at call site ===
  # If calling an Iterator-bounded function, replace Iterator args with closures
  var ibf_call = mir_lookup_iterator_bounded(ctx, resolved_name)
  if ibf_call.is_none()
    var arity_ibf = string_intern::mangle_int(resolved_name, provided_count)
    ibf_call = mir_lookup_iterator_bounded(ctx, arity_ibf)
  end
  if ibf_call.is_some() and provided_count > 0
    var ibf_e = ibf_call.unwrap()
    var ibf_bounds = ibf_e.bounds
    var ibf_type_params = mir_get_iterator_param_names(ibf_bounds)
    var ibf_ast_store = ibf_e.ast_store
    var ibf_func_handle = ibf_e.func_handle
    var ibf_params = ast::ast_get_left(ibf_ast_store, ibf_func_handle)
    var ibf_param_count = 0
    if ibf_params >= 0
      ibf_param_count = vec_size(ibf_params)
    end
    # Build new args: replace Iterator-typed params with synthesized closures
    var new_args = vec_new()
    var ibf_arg_idx = 0
    for ibf_pi in 0..ibf_param_count
      var ibf_param = ibf_params[ibf_pi]
      var ibf_ptype = ast::ast_get_str2(ibf_ast_store, ibf_param)
      # Check if this param's type is an Iterator type param
      var is_iter_arg = 0
      for ibf_ti in 0..ibf_type_params.size
        if ibf_type_params[ibf_ti].eq(ibf_ptype)
          is_iter_arg = 1
        end
      end
      if is_iter_arg == 1 and ibf_arg_idx < args.size
        # Synthesize -> arg.next() closure for this argument
        var concrete_arg = args[ibf_arg_idx]
        var arg_node_for_type = arg_nodes[start_idx + ibf_arg_idx]
        var closure_val = synthesize_next_closure(ctx, s, arg_node_for_type, concrete_arg)
        new_args.push(closure_val)
      elsif ibf_arg_idx < args.size
        new_args.push(args[ibf_arg_idx])
      end
      ibf_arg_idx += 1
    end
    return ctx.mir_emit_call(resolved_name, new_args)
  end

  # === A.36: generic-struct extend-method monomorphization ===
  # Route a call on a concrete instantiation of a generic struct (e.g.
  # `l.itg_go()` with l: ITLift<ITBase>) to a per-type-arg specialization so the
  # body's dispatch on a type-param field (`@source.itg_go()`) resolves to the
  # field's concrete method instead of self-recursing into ITLift$itg_go.
  # MUST run before the bounded-generic-function path below: a generic struct's
  # extend-method is otherwise mis-registered as a bounded generic and lowered
  # with a spurious extra param (arity mismatch → crash). Cheap gate: only
  # qualified (Type$method) calls with a receiver can match.
  if already_qualified == 1 and start_idx < arg_count
    var _sm_recv_full = ctx.mir_infer_expr_type(s, arg_nodes[start_idx])
    if str_byte_len(_sm_recv_full) > 0
      var _sm_spec = _mir_try_struct_method_spec(ctx, func_name, _sm_recv_full)
      if str_byte_len(_sm_spec) > 0
        return ctx.mir_emit_call(_sm_spec, args)
      end
    end
  end

  # === Monomorphization: Check for bounded generic function ===
  # Try both the resolved name and arity-mangled variants
  var gbf_entry = ctx.mir_lookup_bounded_generic(resolved_name)
  if gbf_entry.is_none()
    # Try with arity suffix (exact match)
    var arity_name = string_intern::mangle_int(resolved_name, provided_count)
    gbf_entry = ctx.mir_lookup_bounded_generic(arity_name)
  end
  if gbf_entry.is_none() and provided_count > 0
    # Try with arity+1 (function has self param that caller doesn't count)
    var arity_self = string_intern::mangle_int(resolved_name, provided_count + 1)
    gbf_entry = ctx.mir_lookup_bounded_generic(arity_self)
  end
  if gbf_entry.is_some() and provided_count > 0
    var gbf_e = gbf_entry.unwrap()
    # Infer concrete types for ALL arguments
    var all_arg_types = vec_new()
    var has_any_type = 0
    var inferred_count = 0
    for ai in start_idx..arg_count
      var anode = arg_nodes[ai]
      var atype = ctx.mir_infer_expr_type(s, anode)
      if str_byte_len(atype) > 0
        # Strip module prefix if present
        var ad = __char_index(atype, '$')
        if ad >= 0
          atype = str_byte_slice(atype, ad + 1, str_byte_len(atype))
        end
        has_any_type = 1
        inferred_count += 1
      end
      # item 48-a HOOK #1: de-erase a bare `Vec` argument to its concrete
      # `Vec<Elem>` form so the monomorph key varies by element type. This
      # de-erased string flows into BOTH the call-site spec_name AND the
      # PendingSpec.arg_types (consumed verbatim by the emit site), keeping the
      # two manglings in byte-identical lockstep.
      atype = mir::mir_deerase_vec_arg_type(ctx, s, anode, atype)
      all_arg_types.push(as_int(atype))
    end
    if has_any_type == 1
      # Build compound specialized name: base$type1$type2...
      # Only include non-empty types in the name; flatten parameterized
      # types like `Foo<Bar>` into `Foo$Bar` so `<`/`>`/`,` don't end up
      # in LLVM symbol names.
      var gbf_mangled = gbf_e.mangled
      var spec_name = gbf_mangled
      var aat_count = all_arg_types.size
      for ati in 0..aat_count
        var tstr = as_string(all_arg_types[ati])
        if str_byte_len(tstr) > 0
          var tflat = mir_lower::mir_flatten_type_for_symbol(tstr)
          spec_name = "#{spec_name}$#{tflat}"
        end
      end
      # Queue specialization — dedup is handled by mir_emit_pending_specializations
      var specs = ctx.mir_ctx_get_pending_specs()
      var spec_entry = mir::PendingSpec { base_name: gbf_mangled, arg_types: all_arg_types, ast_store: gbf_e.ast_store, func_handle: gbf_e.func_handle, struct_name: "", type_params: "" }
      specs.push(spec_entry)
      # Emit call to specialized function
      return ctx.mir_emit_call(spec_name, args)
    end
  end

  # Arity overload resolution (early): if already found, check for overloads
  if func_entry.is_some()
    var all_funcs_early = ctx.mir_ctx_get_all_funcs()
    if all_funcs_early != 0
      if mir_has_arity_overload(all_funcs_early, resolved_name)
        var arity_matched = mir_find_arity_match(all_funcs_early, resolved_name, provided_count)
        if arity_matched.is_some()
          resolved_name = string_intern::mangle_int(resolved_name, provided_count)
          func_entry = arity_matched
        end
      end
    end
  end

  if func_entry.is_some()
    var fe = func_entry.unwrap()
    # Only expand default args for regular functions (tag 0), not extern fns (tag 10)
    # Extern fns store params in children (not left), and have no default values
    if fe.tag == 0
      var func_ast_store = fe.ast_store
      var func_handle = fe.node_id
      var params = ast::ast_get_left(func_ast_store, func_handle)
      var param_count = vec_size(params)

      # Static extend method: if calling a qualified function (has $) with one
      # fewer arg than params, and first param is "self", prepend a dummy zero.
      # This enables associated functions: Type$constructor(args) without self.
      if provided_count == param_count - 1 and already_qualified == 1 and param_count > 0
        var first_param = params[0]
        var fp_name = ast::ast_get_str1(func_ast_store, first_param)
        if fp_name == "self"
          var new_args = vec_new()
          var self_dummy = ctx.mir_emit_const_int(0)
          new_args.push(self_dummy)
          var na_count = args.size
          for na_i in 0..na_count
            new_args.push(args[na_i])
          end
          args = new_args
          provided_count += 1
        end
      end

      # If we have fewer args than params, fill in defaults
      if provided_count < param_count
        for i in provided_count..param_count
          var param = params[i]
          var default_val = ast::ast_param_default_value(func_ast_store, param)
          if default_val != 0
            # Lower the default value expression using the function's AST store
            var lowered = mir_lower::mir_lower_expr(ctx, func_ast_store, default_val)
            # R2.1 (B3 sibling sink) — union widening at DEFAULT ARG. When the
            # param's declared type is a union (`A | B`) and the default value is a
            # bare arm (e.g. `= 99` → Int), wrap the lowered default into the union's
            # tagged cell so the callee's return-site un-widen (`load_offset(val,1)`)
            # reads a real payload instead of dereferencing a raw scalar. Mirrors the
            # call-arg widen above. Gate-0-inert: no compiler source uses union-typed
            # default params ⇒ byte-identical self-compile.
            var d2_param_ty = ast::ast_get_str2(func_ast_store, param)
            if mir_is_union_annotation(d2_param_ty)
              var d2_arm = ctx.mir_infer_expr_type(func_ast_store, default_val)
              if mir_is_union_annotation(d2_arm) == false
                lowered = mir_lower::mir_emit_widen_to_union(ctx, lowered, d2_param_ty, d2_arm)
              end
            end
            args.push(lowered)
          end
        end
      end

      # Named arg default expansion: fill gap slots marked by default_mask
      if na_default_mask != 0
        for ndi in 0..param_count
          if (na_default_mask >> ndi) & 1 == 1
            var nd_param = params[ndi]
            var nd_default = ast::ast_param_default_value(func_ast_store, nd_param)
            if nd_default > 0
              var nd_adjusted = ndi - start_idx
              if nd_adjusted >= 0 and nd_adjusted < args.size
                var nd_lowered = mir_lower::mir_lower_expr(ctx, func_ast_store, nd_default)
                # R2.1 (B3 sibling sink) — union widening at DEFAULT ARG (named-arg
                # gap fill). See the main default-expansion widen for the rationale.
                var nd_param_ty = ast::ast_get_str2(func_ast_store, nd_param)
                if mir_is_union_annotation(nd_param_ty)
                  var nd_arm = ctx.mir_infer_expr_type(func_ast_store, nd_default)
                  if mir_is_union_annotation(nd_arm) == false
                    nd_lowered = mir_lower::mir_emit_widen_to_union(ctx, nd_lowered, nd_param_ty, nd_arm)
                  end
                end
                args[nd_adjusted] = nd_lowered
              end
            end
          end
        end
      end
    end
  end

  # Five scheduler-backed suspension intrinsics route through
  # `perform(Async, suspend, [fd])` at kind=3. Pre-TLS flags
  # (io_set_pending_proc, etc.) are set first — same shape as the
  # intrinsic path used to emit. Then mir_emit_kind3_perform_suspend
  # spills locals, resets @__qz_effect_park_rv, calls perform. Default
  # Async.suspend handler calls __qz_effect_park(fd) which stashes
  # `-(fd+2)` into TLS; the caller's $poll epilogue reads TLS and
  # `ret %tls_rv` so the scheduler sees the negative sentinel and runs
  # the same dispatch driven by the TLS flags. User
  # `with Async { suspend: my_h } do ... end` handlers override.
  if func_name == "io_suspend" and mir_lower_gen::mir_gen_is_active() >= 2
    var _sus_args = vec_new()
    _sus_args.push(args[0])
    return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "suspend", "Async", _sus_args)
  end

  # proc_suspend(pid): TLS proc flag → worker dispatches to
  # __qz_sched_register_proc (pid encoded identically to fd).
  if func_name == "proc_suspend" and mir_lower_gen::mir_gen_is_active() >= 2
    var proc_args = vec_new()
    proc_args.push(ctx.mir_emit_const_int(1))
    ctx.mir_emit_intrinsic("io_set_pending_proc", proc_args)
    var _sus_args = vec_new()
    _sus_args.push(args[0])
    return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "suspend", "Async", _sus_args)
  end

  # io_suspend_timeout(fd, timeout_ms, events): store timeout + events
  # to TLS before the suspend point.
  if func_name == "io_suspend_timeout" and mir_lower_gen::mir_gen_is_active() >= 2
    var tmo_args = vec_new()
    tmo_args.push(args[1])
    ctx.mir_emit_intrinsic("io_set_pending_timeout", tmo_args)
    var ev_args = vec_new()
    ev_args.push(args[2])
    ctx.mir_emit_intrinsic("io_set_pending_events", ev_args)
    var _sus_args = vec_new()
    _sus_args.push(args[0])
    return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "suspend", "Async", _sus_args)
  end

  # sched_sleep(ms): timeout into TLS, suspend with fd=0 sentinel.
  # Worker detects sleep TLS > 0 → __qz_sched_register_timer; timer
  # fires in kqueue/epoll → poller re-enqueues task.
  if func_name == "sched_sleep" and mir_lower_gen::mir_gen_is_active() >= 2
    var sleep_args = vec_new()
    sleep_args.push(args[0])
    ctx.mir_emit_intrinsic("io_set_pending_sleep", sleep_args)
    var _sus_args = vec_new()
    _sus_args.push(ctx.mir_emit_const_int(0))
    return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "suspend", "Async", _sus_args)
  end

  # sched_yield(): perform(Async, suspend, [-1]) at kind=3. Default
  # handler calls __qz_effect_park(-1) → TLS = -1 → outer ret -1 →
  # scheduler re-enqueues.
  if func_name == "sched_yield" and mir_lower_gen::mir_gen_is_active() >= 2
    var _sus_args = vec_new()
    _sus_args.push(ctx.mir_emit_const_int(-1))
    return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "suspend", "Async", _sus_args)
  end

  # 4D.5c.1: __qz_async_park_propagate(rv) — consumer-side park bridge.
  # Lowered specially in BOTH async and sync branches (the function is
  # registered as a typecheck builtin only — never reaches codegen):
  #
  #   - Inside async ($poll body, _gen_active >= 2): emit a state-machine
  #     suspend point that returns the rv arg directly via
  #     mir_emit_async_suspend_point_raw. Caller's outer $poll picks up
  #     the rv as ITS return value, so a park encoding (≤ -2) flows up
  #     unchanged and the scheduler registers on the right fd/timer.
  #     Resume re-enters the loop body at the next-state label.
  #   - Outside async: the rv ≤ -1 case can't normally happen (callers
  #     only see park encodings via async-typed $poll calls), but we still
  #     need to emit *something* lowerable. Fall back to synchronous
  #     sched_yield + return — equivalent to the existing else branch in
  #     `lower_stream_async_iteration` (mir_lower_iter.qz, post-4D.5c.4).
  #
  # See docs/design/PHASE_4D_5C_CONSUMER_MERGE.md.
  if func_name == "__qz_async_park_propagate"
    if mir_lower_gen::mir_gen_is_active() >= 2
      mir_lower_gen::mir_emit_async_suspend_point_raw(ctx, args[0], 0, "park_resume")
      return ctx.mir_emit_const_int(0)
    end
    var pp_yield_args = vec_new()
    ctx.mir_emit_intrinsic("sched_yield", pp_yield_args)
    return ctx.mir_emit_const_int(0)
  end

  # sched_park() inside async $poll: set TLS park flag, then yield suspend point.
  if func_name == "sched_park" and mir_lower_gen::mir_gen_is_active() >= 2
    var park_args = vec_new()
    ctx.mir_emit_intrinsic("sched_set_park_pending", park_args)
    mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, 0)
    return ctx.mir_emit_const_int(0)
  end

  # QZ0210: sched_park() is an async-only primitive. Calling it outside of
  # an async $poll state machine falls through to the abort-based intrinsic
  # emission in cg_intrinsic_conc_sched.qz, which crashes the process at
  # runtime. Reject at compile time so users get a clean error instead.
  #
  # A.17 fix: the exemption is gated on `mir_is_plain_reachable` — does the
  # enclosing function's plain (non-$poll) body actually run? — NOT on
  # `mir_is_async_target`. The async-target registry is an over-
  # approximation: `mir_propagate_suspend_ast` auto-registers EVERY
  # function that transitively reaches a suspend leaf (sched_park included),
  # so a plainly-called `def parker(): sched_park()` got wrongly exempted.
  # The plain-reachable set (PASS 0.99c) asks the correct question: a
  # `sched_park`-containing function whose plain body runs aborts at
  # runtime — reject it. A function reached only via `go fn()` has its
  # plain body emitted as dead code and is absent from the set → exempt.
  if func_name == "sched_park" and mir_lower_gen::mir_gen_is_active() < 2
    var qz210_cur_func = ctx.mir_ctx_get_func()
    if qz210_cur_func != 0
      var qz210_cur_name = mir::mir_func_get_name(qz210_cur_func)
      # Strip module prefix (e.g. "mod_foo$parker" → "parker") to match how
      # the plain-reachable registry records names (bare identifiers).
      var qz210_bare_name = qz210_cur_name
      var qz210_dollar = __char_index(qz210_cur_name, '$')
      if qz210_dollar >= 0
        qz210_bare_name = str_byte_slice(qz210_cur_name, qz210_dollar + 1, str_byte_len(qz210_cur_name))
      end
      var qz210_plain_reachable = mir_lower_async_registry::mir_is_plain_reachable(qz210_bare_name)
      if qz210_plain_reachable
        var qz210_line = ast::ast_get_line(s, node)
        var qz210_col = ast::ast_get_col(s, node)
        eputs("[QZ0210] sched_park() cannot be called from non-async context — park is an async-only primitive.")
        eputs("  in function '#{qz210_cur_name}' at line #{str_from_int(qz210_line)}:#{str_from_int(qz210_col)}")
        eputs("  hint: spawn the parking work via `go fn()` so its body runs as an async state machine:")
        eputs("    def worker(): Int")
        eputs("      sched_park()   # legal — worker is a go target")
        eputs("      return 0")
        eputs("    end")
        eputs("    def main(): Int")
        eputs("      var h = go worker()")
        eputs("      sched_wake(as_int_generic(h))")
        eputs("      await h")
        eputs("    end")
        exit(1)
      end
    end
  end

  # async_mutex_lock(mtx) inside async $poll: CAS loop with park on contention.
  if func_name == "async_mutex_lock" and mir_lower_gen::mir_gen_is_active() >= 2
    return ctx.mir_emit_async_mutex_lock(args[0])
  end

  # async_rwlock_read(rw) inside async context: CAS increment + park on write-locked.
  if func_name == "async_rwlock_read" and mir_lower_gen::mir_gen_is_active() >= 2
    return ctx.mir_emit_async_rwlock_read(args[0])
  end

  # async_rwlock_write(rw) inside async context: CAS 0→-1 + park on contention.
  if func_name == "async_rwlock_write" and mir_lower_gen::mir_gen_is_active() >= 2
    return ctx.mir_emit_async_rwlock_write(args[0])
  end

  # Extern functions (tag 10) bypass the intrinsic check.
  # Names like send/recv/fread/exit collide with Quartz intrinsics,
  # but if the user imported an extern declaration, the extern wins
  # — UNLESS the call's arg_count doesn't match the extern's parameter
  # count AND the name is a known intrinsic that does match. This is
  # the MIR-lowering half of the arity-aware dispatch added at typecheck
  # for the channel-send vs ws2_32-send name clash on Windows. Without
  # this, a 2-arg `send(ch, val)` would emit `call @send(i64, ptr)`
  # against the extern's 4-arg signature, producing broken IR.
  # Path A — see feedback_channel_send_vs_ws2_send_name_clash.md.
  var _fe_is_extern = false
  if func_entry.is_some()
    var fe_chk = func_entry.unwrap()
    _fe_is_extern = fe_chk.tag == 10
  end
  if _fe_is_extern
    var fe_ext = func_entry.unwrap()
    var _ext_params = ast::ast_get_children(fe_ext.ast_store, fe_ext.node_id)
    var _ext_param_count = -1
    var _ext_is_variadic = 0
    if _ext_params != 0
      _ext_param_count = vec_size(_ext_params)
      if _ext_param_count > 0
        _ext_is_variadic = ast::ast_param_is_variadic(fe_ext.ast_store, _ext_params[_ext_param_count - 1])
      end
    end
    var _ext_provided = args.size
    # Variadic externs (printf-style): the trailing `...` param counts as
    # the last entry in `children`, and the call must provide at least
    # (_ext_param_count - 1) args (the fixed prefix). Non-variadic: must
    # match exactly. If arity doesn't match AND the name is a known
    # intrinsic, fall through to intrinsic dispatch below.
    var _ext_arity_ok = 1
    if _ext_param_count >= 0
      if _ext_is_variadic == 1
        if _ext_provided < (_ext_param_count - 1)
          _ext_arity_ok = 0
        end
      else
        if _ext_provided != _ext_param_count
          _ext_arity_ok = 0
        end
      end
    end
    if _ext_arity_ok == 1 or mir_intrinsics::mir_is_intrinsic(func_name) == 0
      return ctx.mir_emit_call(resolved_name, args)
    end
    # else: arity mismatches the extern AND name is an intrinsic — fall
    # through. Path A — see feedback_channel_send_vs_ws2_send_name_clash.md.
  end

  # User-defined functions shadow these 6 intrinsic names.
  # These are the only intrinsic names that collide with common user function
  # names. If a user defines `first()`, their function takes precedence.
  # Other intrinsics like `unwrap`/`to_str` have companion wrappers in std
  # that must NOT override intrinsic dispatch.
  var _fe_is_tag0 = false
  if func_entry.is_some()
    var fe_c = func_entry.unwrap()
    _fe_is_tag0 = fe_c.tag == 0
  end
  if _fe_is_tag0
    if func_name == "first" or func_name == "get_arg" or func_name == "is_alnum" or func_name == "is_alpha" or func_name == "is_digit" or func_name == "str_eq"
      return ctx.mir_emit_call(resolved_name, args)
    end
  end


  if mir_intrinsics::mir_is_intrinsic(func_name)
    # Set uses_scheduler flag when scheduler intrinsics are used
    if func_name == "sched_init" or func_name == "sched_spawn" or func_name == "sched_spawn_priority" or func_name == "sched_shutdown" or func_name == "sched_yield" or func_name == "sched_idle_hook_set" or func_name == "sched_idle_hook_clear" or func_name == "sched_register_proc" or func_name == "proc_suspend"
      var sched_prog = ctx.mir_ctx_get_program()
      mir_set_uses_scheduler(sched_prog)
    end

    # A.17 — channel/mutex/select intrinsics emit `__qz_waiter_*` runtime
    # calls (waiter side-table notify/register/unregister). Those runtime
    # functions are only defined under the `uses_scheduler` gate in
    # codegen_runtime.qz. A bare `main()` using channels or mutexes with no
    # `go`/`async` (which would set the flag via the `Async` perform-op)
    # otherwise emits the waiter calls with no definitions → `llc` rejects
    # with `use of undefined value '@__qz_waiter_notify_all'`. Set the flag
    # for every intrinsic that emits a `__qz_waiter_*` call.
    if mir_intrinsic_uses_waiter_runtime(func_name)
      mir_set_uses_scheduler(ctx.mir_ctx_get_program())
    end

    # B.7 Phase 4d: any program calling `scope_register_deadline` needs the
    # `__qz_scope_deadline_thread` runtime function emitted (which references
    # `@_scope_fire_deadline_exceeded`). Setting the flag here — at MIR
    # lowering — guarantees it is observable to `cg_emit_runtime_decls`,
    # which runs before function bodies in codegen.
    if func_name == "scope_register_deadline"
      mir_set_uses_scope_deadline(ctx.mir_ctx_get_program())
    end

    # Special handling for typed allocators: arena_alloc<T>(arena) -> arena_alloc(arena, sizeof(T))
    if func_name == "arena_alloc"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        # Typed allocator - compute sizeof(T) and add as second argument
        var type_size = mir_sizeof_type(ctx, type_arg)
        var size_val = ctx.mir_emit_const_int(type_size)
        args.push(size_val)
      end
    end

    # Type-safe pointer read: ptr_read<T>(ptr) -> ptr_read(ptr, sizeof(T), field_count)
    if func_name == "ptr_read"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        var type_size = mir_sizeof_type(ctx, type_arg)
        var field_count = type_size / 8
        if field_count < 1
          field_count = 1
        end
        var size_val = ctx.mir_emit_const_int(type_size)
        var fc_val = ctx.mir_emit_const_int(field_count)
        args.push(size_val)
        args.push(fc_val)
      end
    end

    # Type-safe pointer write: ptr_write<T>(ptr, value) -> ptr_write(ptr, value, sizeof(T), field_count)
    if func_name == "ptr_write"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        var type_size = mir_sizeof_type(ctx, type_arg)
        var field_count = type_size / 8
        if field_count < 1
          field_count = 1
        end
        var size_val = ctx.mir_emit_const_int(type_size)
        var fc_val = ctx.mir_emit_const_int(field_count)
        args.push(size_val)
        args.push(fc_val)
      end
    end

    # Volatile load: volatile_load<T>(ptr) -> volatile_load(ptr, sizeof(T), field_count)
    if func_name == "volatile_load"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        var type_size = mir_sizeof_type(ctx, type_arg)
        var field_count = type_size / 8
        if field_count < 1
          field_count = 1
        end
        var size_val = ctx.mir_emit_const_int(type_size)
        var fc_val = ctx.mir_emit_const_int(field_count)
        args.push(size_val)
        args.push(fc_val)
      end
    end

    # Volatile store: volatile_store<T>(ptr, value) -> volatile_store(ptr, value, sizeof(T), field_count)
    if func_name == "volatile_store"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        var type_size = mir_sizeof_type(ctx, type_arg)
        var field_count = type_size / 8
        if field_count < 1
          field_count = 1
        end
        var size_val = ctx.mir_emit_const_int(type_size)
        var fc_val = ctx.mir_emit_const_int(field_count)
        args.push(size_val)
        args.push(fc_val)
      end
    end

    # field_offset<StructType>(field_index) - pass struct name as string arg
    if func_name == "field_offset"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        # Resolve struct name (handles cross-module: "Point" -> "mod$Point")
        var resolved = mir_resolve_struct_name(ctx, type_arg)
        var name_val = ctx.mir_emit_const_int(as_int(resolved))
        args.push(name_val)
      end
    end

    # array_new<T, N>() - extract N from type_arg and pass as argument
    if func_name == "array_new"
      var type_arg = ast::ast_get_type_arg(s, node)
      if str_byte_len(type_arg) > 0
        var comma_pos = __char_index(type_arg, ',')
        if comma_pos >= 0
          var n_str = str_byte_slice(type_arg, comma_pos + 1, str_byte_len(type_arg))
          # Trim leading spaces
          var n_start = 0
          while n_start < str_byte_len(n_str)
            if str_byte_at(n_str, n_start) != ' '
              break
            end
            n_start += 1
          end
          if n_start > 0
            n_str = str_byte_slice(n_str, n_start, str_byte_len(n_str))
          end
          var arr_size = str_to_int(n_str)
          if arr_size <= 0
            arr_size = 1
          end
          var size_val = ctx.mir_emit_const_int(arr_size)
          args.push(size_val)
        end
      end
    end

    # map_new<K,V>(): extract key type and emit with annotation for codegen dispatch
    if func_name == "map_new"
      var ta = ast::ast_get_type_arg(s, node)
      var key_str = "String"
      if str_byte_len(ta) > 0
        var comma_pos = __char_index(ta, ',')
        if comma_pos > 0
          key_str = str_trim(str_byte_slice(ta, 0, comma_pos))
        else
          key_str = str_trim(ta)
        end
      end
      return ctx.mir_emit_intrinsic_typed("map_new", args, key_str)
    end

    # to_f64 on a float argument is identity (F32/F64 both stored as double bits)
    if func_name == "to_f64"
      if args.size > 0
        var tf64_arg_node = arg_nodes[start_idx]
        if mir_lower::mir_is_float_expr(ctx, s, tf64_arg_node)
          return args[0]
        end
      end
    end

    # to_f32 on a float (F64) argument must narrow via fptrunc (f64_to_f32), not
    # sitofp: the operand is already double-bits-in-i64, so the Int->F32 `to_f32`
    # intrinsic would reinterpret the bit pattern as a signed integer and produce
    # garbage. Mirror of the to_f64-identity case above; this is the free-function
    # path the `: F32 =` init-truncation wrap (mir_lower_stmt_handlers) cannot reach.
    if func_name == "to_f32"
      if args.size > 0
        var tf32_arg_node = arg_nodes[start_idx]
        if mir_lower::mir_is_float_expr(ctx, s, tf32_arg_node)
          return ctx.mir_emit_intrinsic("f64_to_f32", args)
        end
      end
    end

    # mem_forget(x): remove variable from droppable stack, emit no-op
    if func_name == "mem_forget"
      if args.size > 0
        # Try to resolve the argument variable name from the AST
        var forget_arg_node = arg_nodes[start_idx]
        var forget_kind = ast::ast_get_kind(s, forget_arg_node)
        if forget_kind == node_constants::NODE_IDENT
          var forget_name = ast::ast_get_str1(s, forget_arg_node)
          mir_consume_droppable(ctx, forget_name)
        end
      end
      return ctx.mir_emit_const_int(0)
    end

    # Thread element type for width-aware vec intrinsics (mem-v2)
    var _vec_elem_type = ""
    if func_name == "vec_new" or func_name == "vec_new_filled"
      # vec_new<U8>() or vec_new_filled<U8>(n, val) — type_arg holds element type
      var ta = ast::ast_get_type_arg(s, node)
      if str_byte_len(ta) > 0
        _vec_elem_type = ta
      end
    end
    # B.10 §14.12.8 (C4.5/h7) — `vec_free` joins the element-type-threaded set ONLY at
    # cow gate-1, so its codegen knows the element type and can cow_release each
    # cow-layout element buffer on collection-drop (else they leak). Gated on
    # mir_value_cow_live so at gate 0 the vec_free instruction carries NO slot2 elem
    # type, exactly as pre-C4.5 ⇒ byte-identical. The vec_free cow loop is itself
    # additionally gated by mir_prog_struct_is_cow_layout in codegen, so a non-cow Vec
    # at gate 1 still emits the identical free sequence.
    var h7_free_threaded = func_name == "vec_free" and mir::mir_value_cow_live() == 1
    if func_name == "vec_push" or func_name == "vec_get" or func_name == "vec_set" or func_name == "vec_get_unchecked" or func_name == "vec_set_unchecked" or func_name == "vec_pop" or func_name == "__vec_pop_raw_sentinel" or func_name == "vec_extend" or func_name == "vec_insert" or func_name == "vec_delete" or func_name == "vec_contains" or func_name == "vec_index_of" or func_name == "vec_dedup" or h7_free_threaded
      # Type checker annotates UFCS vec calls with element type in str2
      var ufcs_ann = ast::ast_get_str2(s, node)
      if str_byte_len(ufcs_ann) > 0
        _vec_elem_type = ufcs_ann
      else
        # Fallback: look up the first argument's variable name in vec_elem_types tracking
        if start_idx < arg_nodes.size
          var first_arg_node = arg_nodes[start_idx]
          if ast::ast_get_kind(s, first_arg_node) == node_constants::NODE_IDENT
            var first_arg_name = ast::ast_get_str1(s, first_arg_node)
            var tracked_elem = ctx.mir_ctx_get_vec_elem_type(first_arg_name)
            if str_byte_len(tracked_elem) > 0
              _vec_elem_type = tracked_elem
            end
          end
        end
      end
    end

    # F4 item-9 — thread the Vec element type into the higher-order collection
    # intrinsics so codegen (cg_intrinsic_collection) can fetch an inline
    # value-layout element by-ADDRESS at the struct's stride (data + i*fc) and
    # pass the element pointer to the lambda, instead of a stride-1 single-i64
    # word (which reads field 0 only → the lambda inttoptr's a scalar field →
    # SIGSEGV for an inline @value element). The typechecker already stamps the
    # element name into str2 at the UFCS HOF rewrite (tc_expr_handlers ~2826),
    # exactly like vec_get/vec_push above. INERT at gate 0: codegen's inline-
    # field-count predicate is 0 for plain (non-value-layout) structs ⇒ the
    # legacy stride-1 path ⇒ byte-identical; only @value (and F4-flipped)
    # elements take the by-address fetch.
    if func_name == "map" or func_name == "each" or func_name == "filter" or func_name == "reduce" or func_name == "count" or func_name == "any?" or func_name == "all?" or func_name == "find" or func_name == "first" or func_name == "last"
      var hof_ann = ast::ast_get_str2(s, node)
      if str_byte_len(hof_ann) > 0
        _vec_elem_type = hof_ann
      end
    end

    # Thread key type for map_* operations including map_new (for layout
    # selection). The typecheck back-stamps map_new with str2 when a later
    # map_set/map_insert reveals the key type via inference.
    # `__map_get_raw` is the internal sentinel-returning lookup; it shares the
    # same dispatch and must read str2 too (typecheck stamps it at the same
    # site). Without this, Int-keyed __map_get_raw silently routes to the
    # string-key codegen → qz_str_hash on an Int → SIGSEGV.
    if str_starts_with(func_name, "map_") or func_name == "__map_get_raw"
      var map_str2 = ast::ast_get_str2(s, node)
      if str_byte_len(map_str2) > 0
        _vec_elem_type = map_str2
      end
    end

    # Threading the same slot2/elem_type signal for set_* lets the WASM
    # backend route Set<Int> through intmap_* (multiplicative i64 hash)
    # instead of hashmap_* (str_hash dereferences the int as a pointer).
    # Without this, the typecheck-set slot2 annotation is dropped at the
    # MIR boundary and the codegen path defaults to string-keyed.
    if str_starts_with(func_name, "set_")
      var set_str2 = ast::ast_get_str2(s, node)
      if str_byte_len(set_str2) > 0
        _vec_elem_type = set_str2
      end
    end

    # R2 (C3) — a structural-record `Vec<{ x: Int }>` element annotation (from
    # `vec_new<{...}>()`, the UFCS push/get str2 stamp, or the tracked-var fallback)
    # is raw record spelling. Canonicalize it to C1's registered sorted `__rec$...`
    # @value struct name so `mir_emit_intrinsic_typed` → `cg_vec_inline_field_count`
    # resolves the flat value-layout stride (fc≥1) and the push takes the V2d
    # independent-heap-copy / by-address read path (not the boxed-ptr-as-i64 store
    # that reads garbage on `v[0]`). Register the @value struct FIRST so a bare
    # `vec_new<{...}>()` + push with no annotated binding still lands the struct
    # (insurance vs the construct-side derefs-unregistered-layout SIGSEGV, the C3
    # analog of GAP-B2). GATE-0-INERT: gated on mir_is_record_annotation (non-
    # intersection), which the compiler's own Vec elements never satisfy ⇒ byte-
    # identical.
    if str_byte_len(_vec_elem_type) > 0 and mir::mir_is_record_annotation(_vec_elem_type) and mir::mir_record_is_intersection(_vec_elem_type) == false
      mir::mir_register_record_struct(ctx, _vec_elem_type, s)
      _vec_elem_type = mir::mir_record_canonical_name(_vec_elem_type)
    end

    # ===== Colorblind Async: scheduler-aware blocking primitives =====
    # When inside a $poll context (_gen_active >= 2), blocking operations
    # (recv, send, mutex_lock) are lowered as try + async_suspend loops
    # so they suspend the task instead of blocking the OS thread.
    # This enables Go/Erlang-style M:N scheduling for actors and tasks.
    if mir_lower_gen::mir_gen_is_active() >= 2
      if func_name == "recv"
        # recv(ch) in async context: check cap to choose strategy
        # Cap=0 (rendezvous): use blocking recv (worker thread blocks briefly)
        # Cap>0 or cap=-1 (unbounded): try_recv + io_suspend loop
        var __ch_name = gen_for_temp(ctx, "__ar_ch")
        var __ch_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__ch_name, __ch_slot)
        ctx.mir_emit_store_var(__ch_name, args[0])
        mir_lower_gen::mir_gen_register_dynamic_local(__ch_name)

        var __recv_name = gen_for_temp(ctx, "__ar_res")
        var __recv_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__recv_name, __recv_slot)
        mir_lower_gen::mir_gen_register_dynamic_local(__recv_name)

        # Check cap: load(ch, 14) = byte offset 112 = cap field
        var __cap_ch = ctx.mir_emit_load_var(__ch_name)
        var __cap_args = [__cap_ch, ctx.mir_emit_const_int(14)]
        var __cap = ctx.mir_emit_intrinsic("load", __cap_args)
        var __is_rv = ctx.mir_emit_binary(op_constants::OP_EQ, __cap, ctx.mir_emit_const_int(0))

        var __rv_block = ctx.mir_create_block("recv_rv")
        var __try_block = ctx.mir_create_block("recv_try")
        var __got_block = ctx.mir_create_block("recv_got")
        var __wait_block = ctx.mir_create_block("recv_wait")
        var __done_block = ctx.mir_create_block("recv_done")

        ctx.mir_emit_branch(__is_rv, __rv_block, __try_block)

        # RENDEZVOUS: use blocking recv (worker thread blocks briefly, same as Go)
        ctx.mir_switch_to_block(__rv_block)
        var __rv_ch = ctx.mir_emit_load_var(__ch_name)
        var __rv_args = [__rv_ch]
        var __rv_val = ctx.mir_emit_intrinsic("recv", __rv_args)
        ctx.mir_emit_store_var(__recv_name, __rv_val)
        mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, __done_block)

        # TRY: try_recv_or_closed(ch) — for buffered/unbounded channels
        ctx.mir_switch_to_block(__try_block)
        var __ch_loaded = ctx.mir_emit_load_var(__ch_name)
        var __try_args = [__ch_loaded]
        var __status = ctx.mir_emit_intrinsic("try_recv_or_closed", __try_args)
        var __got = ctx.mir_emit_binary(op_constants::OP_GT, __status, ctx.mir_emit_const_int(0))
        ctx.mir_emit_store_var(__recv_name, __status)
        ctx.mir_emit_branch(__got, __got_block, __wait_block)

        # WAIT: park task on channel (no fd, no pipe — just frame pointer in channel struct)
        # channel_park_recv re-checks buffer under mutex (TOCTOU-safe):
        #   returns 1 = buffer got data (retry), 0 = parked (yield)
        # Park the top-level task frame (@__qz_current_frame), not the inner $poll's `self`:
        # for nested-poll cases (colorless dispatch — task$poll → my_acquire$poll), `self`
        # is the inner my_acquire frame, but the scheduler tracks tasks by the top-level
        # frame the worker last set @__qz_current_frame to. Waking the inner frame would
        # re-poll my_acquire$poll standalone and never resume task$poll.
        ctx.mir_switch_to_block(__wait_block)
        var __ch_w = ctx.mir_emit_load_var(__ch_name)
        var __self_frame = ctx.mir_emit_intrinsic("task_self", vec_new())
        var __park_args = [__ch_w, __self_frame]
        var __park_result = ctx.mir_emit_intrinsic("channel_park_recv", __park_args)
        var __should_retry = ctx.mir_emit_binary(op_constants::OP_EQ, __park_result, ctx.mir_emit_const_int(1))
        var __park_block = ctx.mir_create_block("recv_park")
        ctx.mir_emit_branch(__should_retry, __try_block, __park_block)

        # PARK: set park pending flag and yield — scheduler won't re-enqueue
        # Send will wake us via __qz_sched_reenqueue when data arrives
        ctx.mir_switch_to_block(__park_block)
        ctx.mir_emit_intrinsic("sched_set_park_pending", vec_new())
        mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, __try_block)

        # GOT: extract value from Option (from try_recv path)
        ctx.mir_switch_to_block(__got_block)
        var __opt = ctx.mir_emit_load_var(__recv_name)
        var __get_args = [__opt]
        var __val = ctx.mir_emit_intrinsic("option_get", __get_args)
        var __free_args = [__opt]
        ctx.mir_emit_intrinsic("option_free", __free_args)
        ctx.mir_emit_store_var(__recv_name, __val)
        mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, __done_block)

        # DONE: result from either rendezvous or buffered path
        ctx.mir_switch_to_block(__done_block)
        return ctx.mir_emit_load_var(__recv_name)
      end

      if func_name == "send"
        # send(ch, val) in async context: check cap for rendezvous fallback
        var __sch_name = gen_for_temp(ctx, "__as_ch")
        var __sch_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__sch_name, __sch_slot)
        ctx.mir_emit_store_var(__sch_name, args[0])
        mir_lower_gen::mir_gen_register_dynamic_local(__sch_name)

        var __sv_name = gen_for_temp(ctx, "__as_val")
        var __sv_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__sv_name, __sv_slot)
        ctx.mir_emit_store_var(__sv_name, args[1])
        mir_lower_gen::mir_gen_register_dynamic_local(__sv_name)

        # Check cap
        var __scap_ch = ctx.mir_emit_load_var(__sch_name)
        var __scap_args = [__scap_ch, ctx.mir_emit_const_int(14)]
        var __scap = ctx.mir_emit_intrinsic("load", __scap_args)
        var __sis_rv = ctx.mir_emit_binary(op_constants::OP_EQ, __scap, ctx.mir_emit_const_int(0))

        var __srv_block = ctx.mir_create_block("send_rv")
        var __stry_block = ctx.mir_create_block("send_try")
        var __sdone_block = ctx.mir_create_block("send_done")
        var __swait_block = ctx.mir_create_block("send_wait")

        ctx.mir_emit_branch(__sis_rv, __srv_block, __stry_block)

        # RENDEZVOUS: use blocking send (worker thread blocks briefly)
        ctx.mir_switch_to_block(__srv_block)
        var __srv_ch = ctx.mir_emit_load_var(__sch_name)
        var __srv_val = ctx.mir_emit_load_var(__sv_name)
        var __srv_args = [__srv_ch, __srv_val]
        ctx.mir_emit_intrinsic("send", __srv_args)
        mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, __sdone_block)

        # TRY: try_send(ch, val) — for buffered/unbounded channels
        ctx.mir_switch_to_block(__stry_block)
        var __sch_loaded = ctx.mir_emit_load_var(__sch_name)
        var __sv_loaded = ctx.mir_emit_load_var(__sv_name)
        var __stry_args = [__sch_loaded, __sv_loaded]
        var __sok = ctx.mir_emit_intrinsic("try_send", __stry_args)
        var __ssent = ctx.mir_emit_binary(op_constants::OP_EQ, __sok, ctx.mir_emit_const_int(1))
        ctx.mir_emit_branch(__ssent, __sdone_block, __swait_block)

        # WAIT: yield to scheduler, then retry
        ctx.mir_switch_to_block(__swait_block)
        mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, __stry_block)

        # DONE
        ctx.mir_switch_to_block(__sdone_block)
        return ctx.mir_emit_const_int(0)
      end

      if func_name == "mutex_lock"
        # mutex_lock(m) in async context → try_lock loop with io_suspend.
        # Returns the mutex's stored value (offset 64) — must match
        # sync mutex_lock semantics so callers can do
        # `val = mutex_lock(mx); mutex_unlock(mx, val + 1)`.
        var __m_name = gen_for_temp(ctx, "__am_mtx")
        var __m_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__m_name, __m_slot)
        ctx.mir_emit_store_var(__m_name, args[0])
        mir_lower_gen::mir_gen_register_dynamic_local(__m_name)
        # Result local — holds the value we loaded on the successful try.
        var __m_res_name = gen_for_temp(ctx, "__am_res")
        var __m_res_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(__m_res_name, __m_res_slot)
        ctx.mir_emit_store_var(__m_res_name, ctx.mir_emit_const_int(0))
        mir_lower_gen::mir_gen_register_dynamic_local(__m_res_name)

        var __mtry_block = ctx.mir_create_block("lock_try")
        var __mlocked_block = ctx.mir_create_block("lock_done")
        var __mwait_block = ctx.mir_create_block("lock_wait")

        mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, __mtry_block)

        # TRY: mutex_try_lock(m) returns the mutex's value on success,
        # -1 on failure (contention). Previous code compared `== 1` which
        # treated any stored value other than 1 as contention, causing
        # eternal yield loops under concurrent `go` tasks contending for
        # the same mutex (QZ-scheduler bug filed 2026-04-22).
        ctx.mir_switch_to_block(__mtry_block)
        var __m_loaded = ctx.mir_emit_load_var(__m_name)
        var __mtry_args = [__m_loaded]
        var __mlocked = ctx.mir_emit_intrinsic("mutex_try_lock", __mtry_args)
        ctx.mir_emit_store_var(__m_res_name, __mlocked)
        var __mgot = ctx.mir_emit_binary(op_constants::OP_NE, __mlocked, ctx.mir_emit_const_int(-1))
        ctx.mir_emit_branch(__mgot, __mlocked_block, __mwait_block)

        # WAIT: yield to scheduler, then retry (mutexes don't have notify fds)
        ctx.mir_switch_to_block(__mwait_block)
        mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, __mtry_block)

        # DONE — return the stored mutex value
        ctx.mir_switch_to_block(__mlocked_block)
        return ctx.mir_emit_load_var(__m_res_name)
      end
    end

    var result = 0
    if str_byte_len(_vec_elem_type) > 0
      result = ctx.mir_emit_intrinsic_typed(func_name, args, _vec_elem_type)
    else
      result = ctx.mir_emit_intrinsic(func_name, args)
    end

    # Store type_size in slot1 for narrow volatile access
    if func_name == "volatile_load" or func_name == "volatile_store"
      var vtype_arg = ast::ast_get_type_arg(s, node)
      var vtype_size = 8
      if str_byte_len(vtype_arg) > 0
        vtype_size = mir_sizeof_type(ctx, vtype_arg)
      end
      var vblock = ctx.mir_ctx_get_block()
      var vinstrs = mir_block_get_instructions(vblock)
      var last_instr = vinstrs[vinstrs.size - 1]
      mir_instr_set_slot1(last_instr, vtype_size)
    end

    # Divergent calls: panic/exit/unreachable never return
    if func_name == "panic" or func_name == "exit" or func_name == "unreachable"
      var cur_blk = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_blk, mir::TERM_UNREACHABLE, 0)
      mir_block_mark_terminated(cur_blk)
    end

    return result
  end

  # Check if this is a known function or a variable holding a function pointer
  # If func_entry is 0 (not found) and not an intrinsic, try suffix search
  # for struct methods (e.g., "get_types" -> "LexerResult$get_types")
  if func_entry.is_none()
    var suffix = "$#{func_name}"
    var all_funcs = ctx.mir_ctx_get_all_funcs()
    var suffix_entry: Option<ResolverEntry> = Option::None
    if all_funcs != 0
      for __si in 0..all_funcs.size
        var __se = all_funcs[__si]
        if __se.tag == 0 and str_ends_with(__se.name, suffix)
          suffix_entry = Option::Some(__se)
          break
        end
      end
    end
    if suffix_entry.is_some()
      var se = suffix_entry.unwrap()
      resolved_name = se.name
      func_entry = suffix_entry
      # Arity overload resolution (suffix path): check if found function has overloads
      if all_funcs != 0
        if mir_has_arity_overload(all_funcs, resolved_name)
          var arity_matched = mir_find_arity_match(all_funcs, resolved_name, provided_count)
          if arity_matched.is_some()
            resolved_name = string_intern::mangle_int(resolved_name, provided_count)
            func_entry = arity_matched
          end
        end
      end
    else
      # Safety net: if name contains '$', it's a module-qualified function.
      # Emit a direct call even if not found in all_funcs, matching the
      # C bootstrap's strchr(name, '$') != NULL guard (mir.c:2662).
      if str_contains(func_name, "$")
        return ctx.mir_emit_call(resolved_name, args)
      end
      # Not a defined function or intrinsic - must be a variable holding fn ptr
      var fn_ptr = ctx.mir_emit_load_var(func_name)
      return ctx.mir_emit_call_indirect(fn_ptr, args)
    end
  end

  # === Colorless call dispatch ===
  # Inside a $poll body, if the callee has EFFECT_SUSPEND, transparently
  # create its async frame and inline-await it (yield to scheduler at
  # suspension points instead of blocking the worker thread).
  #
  # P4.B.8.b skip: don't colorless-dispatch user-facing generator
  # constructors. `def inner_gen(): impl Iterator<T>` lowers (via
  # `mir_lower_generator_effect`) to a thin constructor that returns a
  # `Stream<T>` consumer handle. Calling it from inside another
  # generator's `$poll` body — `for x in inner_gen() ... yield x` —
  # MUST evaluate to that Stream so the for-in desugar can drive it
  # through `Stream$next`. Colorless dispatch would instead spin up a
  # `__Future_inner_gen$new()` frame and treat the call as an awaited
  # value, polling until POLL_READY and loading whatever's at frame[1]
  # — that's not the Stream the user expects to iterate. Skip generators
  # here; the existing constructor-call path returns the Stream
  # correctly and the for-in lowering takes over from there.
  if mir_lower_gen::mir_gen_is_active() >= 2
    if mir_lower_async_registry::mir_has_effect(resolved_name, 2)  # EFFECT_SUSPEND
      if mir_lower_async_registry::mir_is_async_target(resolved_name)
        # Phase 4D.5b: annotation-based gen detection (was registry).
        if not mir::mir_func_annotation_is_generator(mir::mir_func_lookup_annotation(ctx, resolved_name))
          return ctx.mir_emit_colorless_call(resolved_name, args)
        end
      end
    end
  end

  # P21 / R3.2: NO per-call-site fuel_check for direct calls. Preemption is now
  # emitted once per function ENTRY (mir_lower.qz, both function-lowering paths):
  # the direct callee, being a non-@no_preempt function, decrements fuel via its
  # own entry check, so a check here would be redundant. Recursion (no loop
  # back-edge) is bounded by the per-activation entry check; loops keep their
  # back-edge checks; INDIRECT calls (lambda/fn-field/call-of-call/var-fn) and
  # op-calls KEEP their checks below because the callee target is unknown at the
  # site and may be @no_preempt or a runtime callback with no entry check.
  return ctx.mir_emit_call(resolved_name, args)
end

# item 51 — value-struct deep `==`/`!=`. A value-layout (`@value`, or — under the
# F4 gate — an eligible plain) struct has VALUE semantics, so `x == y` must compare
# FIELDS, not the two alloca POINTERS. The runtime already emits a field-by-field
# `@qz_eq_<Name>` (codegen_runtime.qz `_cg_emit_struct_hash_eq_functions`) for every
# all-hashable, non-narrow struct (the map-key path), but `==` never CALLED it — it
# fell through to a raw pointer `icmp eq`. Reference structs keep identity `==`
# (== reference equality), so this routing is GATED on value-layout.
#
# Returns the struct name to route through `@qz_eq_<Name>`, or "" to keep the raw
# `icmp` path. Only the INLINE ≤16B, non-cow, non-narrow, all-hashable case is
# routed — that is exactly the set for which `_cg_emit_struct_eq` reads the correct
# FLAT i64 offsets 0..N with no refcount-header (+1) skip and no sub-word packing:
#   * cow >16B  : qz_eq reads offset 0 = the refcount word (always 1) ⇒ would
#                 mis-compare ⇒ EXCLUDED (mir_value_is_cow_layout).
#   * narrow    : qz_eq is never emitted (the emission loop `continue`s) AND the
#                 packed offsets differ from the flat stride ⇒ EXCLUDED.
#   * non-hashable field (not Int/Bool/String/Symbol): qz_eq not emitted ⇒ EXCLUDED.
# GATE-0 INERT: mir_is_value_layout_type's value disjunct is `@value`-only until the
# F4 flip is live, so a plain reference struct returns "" ⇒ byte-identical icmp path.
def mir_value_struct_eq_name(ctx: MirContext, s: ast::AstStorage, left_node: AstNodeId, right_node: AstNodeId): String
  var lt = mir::mir_infer_expr_type(ctx, s, left_node)
  if str_byte_len(lt) == 0
    return ""
  end
  # Strip generic args for struct-registry lookup.
  var lt_for_lookup = lt
  var lt_pos = __char_index(lt_for_lookup, '<')
  if lt_pos > 0
    lt_for_lookup = str_byte_slice(lt_for_lookup, 0, lt_pos)
  end
  var name = mir::mir_resolve_struct_name(ctx, lt_for_lookup)
  if str_byte_len(name) == 0
    return ""
  end
  # Must be value-layout (the gate-0 inertness key: @value-only at flip=0).
  if mir::mir_is_value_layout_type(ctx, name) == 0
    return ""
  end
  # COW (>16B) is now handled: _cg_emit_struct_eq applies the +1 refcount-word skip
  # for cow-layout structs (mir_prog_struct_is_cow_layout), so both inline ≤16B and
  # cow >16B read the correct field words.
  # item 51b — narrow-packed value structs now DO get qz_eq_<Name> emitted (typed
  # byte-offset GEP into `%struct.Name`), so route their `==`/`!=` through it too.
  # (Prior code early-returned "" here, dropping narrow structs to a raw icmp of
  # two distinct alloca pointers → identical-field structs compared UNEQUAL.)
  # qz_eq_<Name> is only emitted when every field is hashable
  # (Int/Bool/String/Symbol) — mirror that gate exactly. Use the ctx-side struct
  # REGISTRY (same source `mir_is_value_layout_type` consults) so the field-type
  # verdict cannot disagree with the layout verdict.
  var fields_opt = mir::mir_ctx_get_struct_fields(ctx, name)
  if fields_opt.is_none()
    return ""
  end
  var fields = fields_opt.unwrap()
  var field_types = fields.field_types
  var fc = vec_size(field_types)
  if fc == 0
    return ""
  end
  for fi in 0..fc
    var ft = as_string(field_types[fi])
    # item 51b — narrow fixed-width ints (I8/I16/I32/U8/U16/U32/CInt/CChar) are now
    # hashable/eq-emitted (mirror the `all_hashable` gate in
    # cg_emit_struct_hash_eq_functions exactly), so they don't disqualify.
    if ft != "Int" and ft != "Bool" and ft != "String" and ft != "Symbol" and mir::mir_is_narrow_fixed_width(ft) == 0
      return ""
    end
  end
  return name
end

def mir_lower_binary(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)

  # NodeBinary = 8 (C-aligned)
  if kind == node_constants::NODE_BINARY
    var bin = ast::ast_extract_binary(s, node)
    var left_node = bin[0]
    var right_node = bin[1]
    var op = bin[2]

    # Nil coalescing: op_constants$OP_NIL_COALESCE (22)
    # left ?? right -> if left is Some, return payload; else evaluate right
    # Uses alloca-based branching for proper short-circuit evaluation
    #
    # Chaining support: a ?? b ?? 99 parses as (a ?? b) ?? 99
    # Inner ?? must preserve Option pointer when RHS is also Option type,
    # otherwise outer ?? tries to load tag from unwrapped Int -> crash
    if op == op_constants::OP_NIL_COALESCE
      # 1. Evaluate LHS first
      var left_val = mir_lower::mir_lower_expr(ctx, s, left_node)

      # B.10 §14 N3 6.3c — niche-aware `??` on a niche-layout Option LHS. Under
      # niche the LHS word IS the payload (Some) or the niche const (None): the
      # Some test is `value != none_const` (NOT a load@0), the Some payload is the
      # word itself (NOT a load@1), and `None` is the niche const (preserved for a
      # chained `?? rhs_is_option`). The legacy block below load@0/load@1 — which
      # under niche would inttoptr the scalar and read garbage. Gated on the LHS
      # being a niche Option ⇒ INERT flag-OFF (returns 0 ⇒ the byte-identical
      # block below). Mirrors the safe-nav / unwrap niche reads (§14.4) so all
      # read positions on an un-annotated niche local agree.
      var coal_niche = mir::mir_subject_is_niche_option(ctx, s, left_node)
      if coal_niche == 1
        var coal_pt = mir::mir_option_subject_payload(ctx, s, left_node)
        var coal_nc = ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, coal_pt))
        var coal_is_some = ctx.mir_emit_binary(op_constants::OP_NE, left_val, coal_nc)
        # Under niche, the Some payload IS the LHS word, AND a chained-Option LHS
        # is preserved as the SAME word — so the Some arm stores `left_val` in
        # both the plain-value and chaining cases (no load@1, no rhs_is_option
        # branch needed; the spill path below still distinguishes them).
        var coal_res = ctx.mir_emit_alloc(1)
        var coal_some_b = ctx.mir_create_block("coal_some")
        var coal_none_b = ctx.mir_create_block("coal_none")
        var coal_merge_b = ctx.mir_create_block("coal_merge")
        var coal_entry = ctx.mir_ctx_get_block()
        mir_block_set_branch(coal_entry, coal_is_some, coal_some_b, coal_none_b)
        # Some arm: identity (the word IS the payload, or preserve for chaining —
        # either way it's the LHS word under niche).
        ctx.mir_switch_to_block(coal_some_b)
        ctx.mir_emit_store_offset(coal_res, 0, left_val)
        mir_block_set_terminator(coal_some_b, mir::TERM_JUMP, coal_merge_b)
        # None arm: evaluate RHS lazily (short-circuit), store.
        ctx.mir_switch_to_block(coal_none_b)
        var coal_rhs_val = mir_lower::mir_lower_expr(ctx, s, right_node)
        ctx.mir_emit_store_offset(coal_res, 0, coal_rhs_val)
        var coal_none_cur = ctx.mir_ctx_get_block()
        mir_block_set_terminator(coal_none_cur, mir::TERM_JUMP, coal_merge_b)
        ctx.mir_switch_to_block(coal_merge_b)
        return ctx.mir_emit_load_offset(coal_res, 0)
      end

      # 2. Check if RHS is Option type (determines preserve vs unwrap)
      # RHS is Option if: NodeEnumAccess (39), NodeIdent (6), or ?? binary
      var right_kind = ast::ast_get_kind(s, right_node)
      var rhs_is_option = 0
      if right_kind == node_constants::NODE_ENUM_ACCESS
        # NodeEnumAccess - explicit enum constructor
        rhs_is_option = 1
      end
      if right_kind == node_constants::NODE_IDENT
        # NodeIdent - variable reference, assume Option in ?? context
        rhs_is_option = 1
      end
      if right_kind == node_constants::NODE_BINARY
        # NodeBinary - check if another ??
        var right_op = ast::ast_get_op(s, right_node)
        if right_op == op_constants::OP_NIL_COALESCE
          rhs_is_option = 1
        end
      end

      # 3. Allocate stack slot for result (avoids PHI complexity)
      var result_ptr = ctx.mir_emit_alloc(1)

      # 4. Create all blocks upfront
      var check_block = ctx.mir_create_block("coal_check")
      var some_block = ctx.mir_create_block("coal_some")
      var none_block = ctx.mir_create_block("coal_none")
      var merge_block = ctx.mir_create_block("coal_merge")

      # 5. Current block (entry): jump to check block
      var entry_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(entry_block, mir::TERM_JUMP, check_block)

      # 6. Check block: load tag, compare, branch
      ctx.mir_switch_to_block(check_block)
      var tag_val = ctx.mir_emit_load_offset(left_val, 0)
      var zero = ctx.mir_emit_const_int(0)
      var is_some = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, zero)
      var check_cur = ctx.mir_ctx_get_block()
      mir_block_set_branch(check_cur, is_some, some_block, none_block)

      # 7. Some arm: store payload OR Option pointer depending on RHS type
      ctx.mir_switch_to_block(some_block)
      if rhs_is_option == 1
        # RHS is Option - preserve LHS Option pointer for chaining
        ctx.mir_emit_store_offset(result_ptr, 0, left_val)
      else
        # RHS is plain value - unwrap LHS payload
        var payload_val = ctx.mir_emit_load_offset(left_val, 1)
        ctx.mir_emit_store_offset(result_ptr, 0, payload_val)
      end
      mir_block_set_terminator(some_block, mir::TERM_JUMP, merge_block)

      # 8. None arm: NOW evaluate RHS (delayed!), store and jump
      ctx.mir_switch_to_block(none_block)
      var rhs_val = mir_lower::mir_lower_expr(ctx, s, right_node)
      ctx.mir_emit_store_offset(result_ptr, 0, rhs_val)
      var none_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(none_cur, mir::TERM_JUMP, merge_block)

      # 9. Merge: load result from stack slot
      ctx.mir_switch_to_block(merge_block)
      return ctx.mir_emit_load_offset(result_ptr, 0)
    end

    # Short-circuit and/or: only evaluate RHS if needed.
    # PSQ-10 (Apr 19 2026): result slot is function-local and never
    # escapes — use alloc_stack so it hoists to a single fn-entry alloca
    # instead of mallocing once per evaluation. Previously, a tight loop
    # with `and` as its condition would drip an 8-byte heap cell per
    # iteration (unbounded), OOM-killing the KERN.3a virtio-net poll.
    if op == op_constants::OP_AND
      var left_val_sc = mir_lower::mir_lower_expr(ctx, s, left_node)
      var rhs_block = ctx.mir_create_block("and_rhs")
      var skip_block = ctx.mir_create_block("and_skip")
      var merge_block = ctx.mir_create_block("and_merge")
      var result_ptr = ctx.mir_emit_alloc_stack(1, "")
      # and: if LHS true -> evaluate RHS, if false -> skip (result=0)
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_branch(cur_block, left_val_sc, rhs_block, skip_block)
      # Skip block: store 0 (false), jump to merge
      ctx.mir_switch_to_block(skip_block)
      var zero_val = ctx.mir_emit_const_int(0)
      ctx.mir_emit_store_offset(result_ptr, 0, zero_val)
      mir_block_set_terminator(skip_block, mir::TERM_JUMP, merge_block)
      # RHS block: evaluate right, normalize to bool (NE 0), store, jump
      ctx.mir_switch_to_block(rhs_block)
      var right_val_sc = mir_lower::mir_lower_expr(ctx, s, right_node)
      var zero2 = ctx.mir_emit_const_int(0)
      var bool_val = ctx.mir_emit_binary(op_constants::OP_NE, right_val_sc, zero2)
      ctx.mir_emit_store_offset(result_ptr, 0, bool_val)
      var rhs_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(rhs_cur, mir::TERM_JUMP, merge_block)
      # Merge: load result
      ctx.mir_switch_to_block(merge_block)
      return ctx.mir_emit_load_offset(result_ptr, 0)
    end
    if op == op_constants::OP_OR
      var left_val_sc = mir_lower::mir_lower_expr(ctx, s, left_node)
      var rhs_block = ctx.mir_create_block("or_rhs")
      var skip_block = ctx.mir_create_block("or_skip")
      var merge_block = ctx.mir_create_block("or_merge")
      # PSQ-10 fix: see OP_AND above — stack slot avoids per-iter malloc.
      var result_ptr = ctx.mir_emit_alloc_stack(1, "")
      # or: if LHS true -> skip (result=1), if false -> evaluate RHS
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_branch(cur_block, left_val_sc, skip_block, rhs_block)
      # Skip block: store 1 (true), jump to merge
      ctx.mir_switch_to_block(skip_block)
      var one_val = ctx.mir_emit_const_int(1)
      ctx.mir_emit_store_offset(result_ptr, 0, one_val)
      mir_block_set_terminator(skip_block, mir::TERM_JUMP, merge_block)
      # RHS block: evaluate right, normalize to bool (NE 0), store, jump
      ctx.mir_switch_to_block(rhs_block)
      var right_val_sc = mir_lower::mir_lower_expr(ctx, s, right_node)
      var zero2 = ctx.mir_emit_const_int(0)
      var bool_val = ctx.mir_emit_binary(op_constants::OP_NE, right_val_sc, zero2)
      ctx.mir_emit_store_offset(result_ptr, 0, bool_val)
      var rhs_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(rhs_cur, mir::TERM_JUMP, merge_block)
      # Merge: load result
      ctx.mir_switch_to_block(merge_block)
      return ctx.mir_emit_load_offset(result_ptr, 0)
    end

    # Range operators: create first-class range object
    # range_new(start, end, inclusive_flag)
    if op == op_constants::OP_RANGE or op == op_constants::OP_RANGE_INCLUSIVE
      var start_val = mir_lower::mir_lower_expr(ctx, s, left_node)
      var end_val = mir_lower::mir_lower_expr(ctx, s, right_node)
      var incl_flag = 0
      if op == op_constants::OP_RANGE_INCLUSIVE
        incl_flag = 1
      end
      var incl_val = ctx.mir_emit_const_int(incl_flag)
      var args = vec_new()
      args.push(start_val)
      args.push(end_val)
      args.push(incl_val)
      return ctx.mir_emit_intrinsic("range_new", args)
    end

    # Other binary ops: evaluate both sides eagerly
    var left_val = mir_lower::mir_lower_expr(ctx, s, left_node)
    # If RHS contains an await, the SSA value for left_val won't survive the
    # suspend/resume cycle — spill it to a generator frame slot and reload after.
    var _bin_spill = mir_async_spill_if_await(ctx, s, right_node, left_val)
    var right_val = mir_lower::mir_lower_expr(ctx, s, right_node)
    left_val = mir_async_reload_if_spilled(ctx, _bin_spill, left_val)

    # Check for operator overloading on struct types
    var overload_val = ctx.mir_try_op_overload(s, node, op, left_val, right_val)
    if overload_val >= 0
      return overload_val
    end

    # Check for string operations via heuristic detection
    # Covers: string literals, tracked string vars, known intrinsics,
    # user-defined function returns, container element access, field access,
    # and index expressions on string containers
    var is_string_op = 0
    if mir_lower::mir_is_string_expr(ctx, s, left_node)
      is_string_op = 1
    end
    if mir_lower::mir_is_string_expr(ctx, s, right_node)
      is_string_op = 1
    end
    # Check for float operations
    var is_float_op = 0
    if mir_lower::mir_is_float_expr(ctx, s, left_node)
      is_float_op = 1
    end
    if mir_lower::mir_is_float_expr(ctx, s, right_node)
      is_float_op = 1
    end
    if op == op_constants::OP_ADD
      if is_string_op == 1
        # String concatenation - emit intrinsic call to str_concat
        var args = vec_new()
        args.push(left_val)
        args.push(right_val)
        return ctx.mir_emit_intrinsic("str_concat", args)
      end
    end
    if op == op_constants::OP_MUL
      if is_string_op == 1
        # str_repeat(string, count) — normalize argument order so the
        # string is always first regardless of `"ha" * 3` vs `3 * "ha"`.
        var str_val = left_val
        var count_val = right_val
        if mir_lower::mir_is_string_expr(ctx, s, left_node) == 0
          str_val = right_val
          count_val = left_val
        end
        var args = vec_new()
        args.push(str_val)
        args.push(count_val)
        return ctx.mir_emit_intrinsic("str_repeat", args)
      end
    end
    # String equality: op_constants$OP_EQ (7) with string operand
    if op == op_constants::OP_EQ
      if is_string_op == 1
        # String equality - emit intrinsic call to str_eq
        var args = vec_new()
        args.push(left_val)
        args.push(right_val)
        return ctx.mir_emit_intrinsic("str_eq", args)
      end
    end
    # String inequality: op_constants$OP_NE (8) with string operand
    if op == op_constants::OP_NE
      if is_string_op == 1
        # String inequality - emit str_eq then negate (== 0)
        var args = vec_new()
        args.push(left_val)
        args.push(right_val)
        var eq_result = ctx.mir_emit_intrinsic("str_eq", args)
        var zero = ctx.mir_emit_const_int(0)
        return ctx.mir_emit_binary(op_constants::OP_EQ, eq_result, zero)
      end
    end
    # item 51 — value-struct deep `==`/`!=`. For a value-layout struct (value
    # semantics) `==` must compare FIELDS via @qz_eq_<Name>, not the two alloca
    # pointers. Reference structs keep identity `==` (raw icmp below). The routing
    # is gated to the all-hashable case the runtime qz_eq handles correctly
    # (item 51b — narrow-packed structs now included via typed-GEP field reads).
    # GATE-0 INERT (value-layout is
    # @value-only at flip=0 ⇒ reference structs return "" ⇒ byte-identical icmp).
    if op == op_constants::OP_EQ
      if is_string_op == 0
        var veq_name = mir_value_struct_eq_name(ctx, s, left_node, right_node)
        if str_byte_len(veq_name) > 0
          var veq_args = vec_new()
          veq_args.push(left_val)
          veq_args.push(right_val)
          return ctx.mir_emit_call("qz_eq_#{veq_name}", veq_args)
        end
      end
    end
    if op == op_constants::OP_NE
      if is_string_op == 0
        var vne_name = mir_value_struct_eq_name(ctx, s, left_node, right_node)
        if str_byte_len(vne_name) > 0
          var vne_args = vec_new()
          vne_args.push(left_val)
          vne_args.push(right_val)
          var vne_eq = ctx.mir_emit_call("qz_eq_#{vne_name}", vne_args)
          var vne_zero = ctx.mir_emit_const_int(0)
          return ctx.mir_emit_binary(op_constants::OP_EQ, vne_eq, vne_zero)
        end
      end
    end
    # Regex match: op_constants$OP_MATCH (25)
    if op == op_constants::OP_MATCH
      var args = vec_new()
      args.push(left_val)
      args.push(right_val)
      return ctx.mir_emit_intrinsic("regex_match", args)
    end
    # Regex non-match: op_constants$OP_NOMATCH (26)
    if op == op_constants::OP_NOMATCH
      var args = vec_new()
      args.push(left_val)
      args.push(right_val)
      var match_result = ctx.mir_emit_intrinsic("regex_match", args)
      # Negate: result == 0
      var zero = ctx.mir_emit_const_int(0)
      return ctx.mir_emit_binary(op_constants::OP_EQ, match_result, zero)
    end
    # Regex match with captures: op_constants$OP_MATCH_CAPTURE (24)
    if op == op_constants::OP_MATCH_CAPTURE
      var args = vec_new()
      args.push(left_val)
      args.push(right_val)
      return ctx.mir_emit_intrinsic("regex_capture", args)
    end
    # Float binary: emit with F64 dest_type for codegen dispatch
    if is_float_op == op_constants::OP_SUB
      # For comparison ops (op_constants$OP_EQ=7, op_constants$OP_NE=8, op_constants$OP_LT=9, etc.), result is
      # Bool (Int), not F64. But at MIR level we still emit float_binary —
      # codegen will check dest_type to decide fadd vs add, fcmp vs icmp.
      return ctx.mir_emit_float_binary(op, left_val, right_val)
    end
    # Narrow integer type wrapping: truncate intermediate results for correct
    # semantics (e.g., U8 add wraps at 256 before subsequent operations)
    if op <= op_constants::OP_MOD
      var left_narrow = mir_get_narrow_type_of_expr(ctx, s, left_node)
      if str_byte_len(left_narrow) > 0
        var right_narrow = mir_get_narrow_type_of_expr(ctx, s, right_node)
        if right_narrow == left_narrow
          var result = ctx.mir_emit_binary(op, left_val, right_val)
          var wrap_name = mir_narrow_to_intrinsic(left_narrow)
          if str_byte_len(wrap_name) > 0
            var wrap_args = vec_new()
            wrap_args.push(result)
            return ctx.mir_emit_intrinsic(wrap_name, wrap_args)
          end
          return result
        end
      end
    end
    # Unsigned comparison: emit unsigned binary for U8/U16/U32 operands
    if op >= op_constants::OP_LT and op <= op_constants::OP_GE
      var left_narrow = mir_get_narrow_type_of_expr(ctx, s, left_node)
      if mir_is_unsigned_type(left_narrow)
        return ctx.mir_emit_unsigned_binary(op, left_val, right_val)
      end
    end
    # Shovel operator: << on collections → push/add/append/send
    if op == op_constants::OP_SHL
      var shovel_tag = ast::ast_get_str2(s, node)
      if str_byte_len(shovel_tag) > 0
        var intrinsic_name = ""
        if shovel_tag == "shovel_vec_push"
          intrinsic_name = "vec_push"
        elsif shovel_tag == "shovel_set_add"
          intrinsic_name = "set_add"
        elsif shovel_tag == "shovel_sb_append"
          intrinsic_name = "sb_append"
        elsif shovel_tag == "shovel_send"
          intrinsic_name = "send"
        end
        if str_byte_len(intrinsic_name) > 0
          var shovel_args = vec_new()
          shovel_args.push(left_val)
          shovel_args.push(right_val)
          ctx.mir_emit_intrinsic(intrinsic_name, shovel_args)
          return left_val
        end
      end
    end
    return ctx.mir_emit_binary(op, left_val, right_val)
  end

  # NodeUnary = 7 (C-aligned)
  if kind == node_constants::NODE_UNARY
    var operand_node = ast::ast_get_left(s, node)
    var operand_val = mir_lower::mir_lower_expr(ctx, s, operand_node)
    var op = ast::ast_get_op(s, node)
    # OpNot = 13: logical not - compare equal to 0
    if op == op_constants::OP_NOT
      var zero = ctx.mir_emit_const_int(0)
      return ctx.mir_emit_binary(op_constants::OP_EQ, operand_val, zero)
    end
    # OpNeg = 14: arithmetic negation - 0 - x
    if op == op_constants::OP_NEG
      if mir_lower::mir_is_float_expr(ctx, s, operand_node)
        var zero_f = ctx.mir_emit_const_float("0.0")
        return ctx.mir_emit_float_binary(op_constants::OP_SUB, zero_f, operand_val)
      end
      var zero = ctx.mir_emit_const_int(0)
      return ctx.mir_emit_binary(op_constants::OP_SUB, zero, operand_val)
    end
    # OpBitNot = 18: bitwise complement - x XOR -1
    if op == op_constants::OP_BIT_NOT
      var neg_one = ctx.mir_emit_const_int(-1)
      return ctx.mir_emit_binary(op_constants::OP_BIT_XOR, operand_val, neg_one)
    end
    # OpOr = 12: handle ?? or similar (dead: parser never produces unary op 12)
    if op == op_constants::OP_GE
      var one = ctx.mir_emit_const_int(1)
      return ctx.mir_emit_binary(op_constants::OP_EQ, operand_val, one)
    end
    return operand_val
  end

  return 0
end

def mir_lower_match_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var subject_node = ast::ast_get_left(s, node)
  var arms = ast::ast_get_children(s, node)

  # Lower subject once
  var subject_val = mir_lower::mir_lower_expr(ctx, s, subject_node)

  # Flow-sensitive narrowing: if subject is a variable known to be a specific variant,
  # skip all tag checks and emit the matching arm body directly.
  var narrow_subj_kind = ast::ast_get_kind(s, subject_node)
  if narrow_subj_kind == node_constants::NODE_IDENT
    var narrow_subj_name = ast::ast_get_str1(s, subject_node)
    var narrowed_to = ctx.mir_ctx_find_narrowing(narrow_subj_name)
    if str_byte_len(narrowed_to) > 0
      # Subject is narrowed — find the arm matching the narrowed variant
      var num_narrow_arms = arms.size
      for ni in 0..num_narrow_arms
        var narrow_arm = arms[ni]
        var narrow_pat = ast::ast_get_left(s, narrow_arm)
        var narrow_pat_kind = ast::ast_get_kind(s, narrow_pat)
        var narrow_arm_variant = ""
        if narrow_pat_kind == node_constants::NODE_ENUM_ACCESS
          narrow_arm_variant = ast::ast_get_str2(s, narrow_pat)
        elsif narrow_pat_kind == node_constants::NODE_IDENT
          # Bare ident that matches an enum variant
          var ni_name = ast::ast_get_str1(s, narrow_pat)
          var ni_enum = mir_find_enum_by_variant(ctx, ni_name)
          if str_byte_len(ni_enum) > 0
            narrow_arm_variant = ni_name
          end
        end
        if narrow_arm_variant == narrowed_to
          # Found matching arm — emit body directly with no tag check
          var narrow_body = ast::ast_get_right(s, narrow_arm)
          var narrow_saved_depth = ctx.mir_ctx_get_scope_depth()
          ctx.mir_ctx_set_scope_depth(narrow_saved_depth + 1)

          # Apply payload bindings if the arm has bound names (e.g., Some(v))
          if narrow_pat_kind == node_constants::NODE_ENUM_ACCESS
            var narrow_bound = ast::ast_get_bound_names(s, narrow_pat)
            if narrow_bound > 0
              if vec_size(narrow_bound) > 0
                var narrow_names = vec_new<String>()
                for nbi in 0..vec_size(narrow_bound)
                  narrow_names.push(as_string(narrow_bound[nbi]))
                end
                var narrow_pat_base = ast::ast_get_str1(s, narrow_pat)
                var narrow_pat_variant = ast::ast_get_str2(s, narrow_pat)
                var narrow_pat_enum = mir_resolve_enum_name(ctx, narrow_pat_base)
                mir_mark_pattern_bindings_typed(ctx, s, subject_node, narrow_pat_enum, narrow_pat_variant, narrow_names)
                ctx.mir_ctx_set_pending_bind(narrow_names, subject_val)
                mir::mir_set_pending_inline_for_enum(ctx, s, subject_node, narrow_pat_enum, narrow_pat_variant, narrow_names)
                ctx.mir_ctx_apply_pending_bind()
              end
            end
          end

          var narrow_val = ctx.mir_lower_block_expr(s, narrow_body)
          emit_and_pop_drops_for_scope(ctx, narrow_saved_depth + 1)
          ctx.mir_ctx_set_scope_depth(narrow_saved_depth)
          return narrow_val
        end
      end
      # No matching arm found — fall through to normal match lowering
    end
  end

  # Create end block for merge point
  var end_block = ctx.mir_create_block("match_end")

  # Result variable - we'll store arm results here
  var result_name = "__match_result"
  var result_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(result_name, result_slot)

  # Initialize result to 0
  var zero = ctx.mir_emit_const_int(0)
  ctx.mir_emit_store_var(result_name, zero)

  # Hash pre-filter: count string arms; if >= 5, hash subject once
  var num_arms = arms.size
  var string_arm_count = 0
  for i in 0..num_arms
    var pat = ast::ast_get_left(s, arms[i])
    if ast::ast_get_kind(s, pat) == node_constants::NODE_STRING_LIT
      string_arm_count += 1
    end
  end
  var use_hash_dispatch = 0
  var subject_hash = 0
  var subject_len = 0
  if string_arm_count >= 5
    use_hash_dispatch = 1
    # Length-based pre-dispatch: str_byte_len is a single field load (cheapest discriminator)
    var len_args = [subject_val]
    subject_len = ctx.mir_emit_intrinsic("str_byte_len", len_args)
    # Hash for within-length-group disambiguation
    var hash_args = [subject_val]
    subject_hash = ctx.mir_emit_intrinsic("str_hash", hash_args)
  end

  for i in 0..num_arms
    var arm = arms[i]
    var pattern_node = ast::ast_get_left(s, arm)
    var body_node = ast::ast_get_right(s, arm)
    var pattern_kind = ast::ast_get_kind(s, pattern_node)

    # Create blocks for this arm
    var arm_block = ctx.mir_create_block("match_arm")
    var next_block = ctx.mir_create_block("match_next")

    # Check if wildcard pattern (NodeWildcard = 42)
    if pattern_kind == node_constants::NODE_WILDCARD
      # Check for binding name and guard on this arm
      var bind_name = ast::ast_get_str1(s, arm)
      var guard_node = ast::ast_get_extra(s, arm)

      # Jump from current block to arm_block
      var prev_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(prev_block, mir::TERM_JUMP, arm_block)
      ctx.mir_switch_to_block(arm_block)

      # Scope for match arm variables
      var saved_depth = ctx.mir_ctx_get_scope_depth()
      ctx.mir_ctx_set_scope_depth(saved_depth + 1)

      # If there's a binding, store the subject value
      if str_byte_len(bind_name) > 0
        # Register the binding as a local FIRST (alloc_slot + bind_var) so
        # the guard + arm body resolve `bind_name` via mir_ctx_lookup_var
        # instead of falling through to a same-named free function/method —
        # the wildcard-with-guard guise of the 30d37c96 binding-shadow
        # miscompile (`n if n > 5 => n` with a free `n()`).
        var bind_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(bind_name, bind_slot)
        ctx.mir_emit_store_var(bind_name, subject_val)
      end

      # If there's a guard, evaluate it and conditionally branch
      if guard_node > 0
        var guard_val = mir_lower::mir_lower_expr(ctx, s, guard_node)
        var guard_body = ctx.mir_create_block("guard_body")
        var cur_g = ctx.mir_ctx_get_block()
        mir_block_set_branch(cur_g, guard_val, guard_body, next_block)
        ctx.mir_switch_to_block(guard_body)
      end

      var arm_val = ctx.mir_lower_block_expr(s, body_node)
      emit_and_pop_drops_for_scope(ctx, saved_depth + 1)
      ctx.mir_ctx_set_scope_depth(saved_depth)
      ctx.mir_emit_store_var(result_name, arm_val)
      var arm_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(arm_cur) < 0
        mir_block_set_terminator(arm_cur, mir::TERM_JUMP, end_block)
      end

      # If no guard, wildcard is exhaustive — skip remaining arms
      if guard_node <= 0
        ctx.mir_switch_to_block(end_block)
        return ctx.mir_emit_load_var(result_name)
      end

      # With guard, continue to next arm (guard might fail)
      ctx.mir_switch_to_block(next_block)
      continue
    end

    # Or-pattern: pat1 | pat2 | pat3 — comparison chain
    if pattern_kind == node_constants::NODE_OR_PATTERN
      var or_pats = ast::ast_get_children(s, pattern_node)
      var or_cnt = vec_size(or_pats)

      for opi in 0..or_cnt
        var sub_pat = or_pats[opi]
        var sub_kind = ast::ast_get_kind(s, sub_pat)
        var or_next = next_block
        if opi < or_cnt - 1
          or_next = ctx.mir_create_block("or_next")
        end

        if sub_kind == node_constants::NODE_WILDCARD
          var or_prev = ctx.mir_ctx_get_block()
          mir_block_set_terminator(or_prev, mir::TERM_JUMP, arm_block)
          ctx.mir_switch_to_block(or_next)
        elsif sub_kind == node_constants::NODE_ENUM_ACCESS
          var or_base = ast::ast_get_str1(s, sub_pat)
          var or_vname = ast::ast_get_str2(s, sub_pat)
          var or_ename = ""
          if str_byte_len(or_base) == 0
            or_ename = mir_find_enum_by_variant(ctx, or_vname)
          else
            or_ename = mir_resolve_enum_name(ctx, or_base)
          end
          var or_tag = mir_get_enum_tag_subj(ctx, s, subject_node, or_ename, subject_val)
          var or_vidx = mir_find_variant_index_ctx(ctx, or_ename, or_vname)
          var or_idx_val = ctx.mir_emit_const_int(or_vidx)
          var or_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, or_tag, or_idx_val)
          var or_cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(or_cur, or_cmp, arm_block, or_next)
          ctx.mir_switch_to_block(or_next)
          if opi == 0
            var or_bnames = ast::ast_get_bound_names(s, sub_pat)
            if or_bnames > 0
              if or_bnames.size > 0
                var or_names = vec_new<String>()
                for obi in 0..or_bnames.size
                  or_names.push(as_string(or_bnames[obi]))
                end
                mir_mark_pattern_bindings_typed(ctx, s, subject_node, or_ename, or_vname, or_names)
                ctx.mir_ctx_set_pending_bind(or_names, subject_val)
                mir::mir_set_pending_inline_for_enum(ctx, s, subject_node, or_ename, or_vname, or_names)
              end
            end
          end
        elsif sub_kind == node_constants::NODE_IDENT
          var or_iname = ast::ast_get_str1(s, sub_pat)
          var or_found_enum = mir_find_enum_by_variant(ctx, or_iname)
          var or_cmp = 0
          if str_byte_len(or_found_enum) > 0
            var or_tag = mir_get_enum_tag_subj(ctx, s, subject_node, or_found_enum, subject_val)
            var or_vidx = mir_find_variant_index_ctx(ctx, or_found_enum, or_iname)
            var or_idx_val = ctx.mir_emit_const_int(or_vidx)
            or_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, or_tag, or_idx_val)
          else
            var or_pval = mir_lower::mir_lower_expr(ctx, s, sub_pat)
            or_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, or_pval)
          end
          var or_cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(or_cur, or_cmp, arm_block, or_next)
          ctx.mir_switch_to_block(or_next)
        elsif sub_kind == node_constants::NODE_STRING_LIT
          var or_pval = mir_lower::mir_lower_expr(ctx, s, sub_pat)
          var or_eq_args = [subject_val, or_pval]
          var or_cmp = ctx.mir_emit_intrinsic("str_eq", or_eq_args)
          var or_cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(or_cur, or_cmp, arm_block, or_next)
          ctx.mir_switch_to_block(or_next)
        else
          var or_pval = mir_lower::mir_lower_expr(ctx, s, sub_pat)
          var or_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, or_pval)
          var or_cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(or_cur, or_cmp, arm_block, or_next)
          ctx.mir_switch_to_block(or_next)
        end
      end

      # Arm body
      ctx.mir_switch_to_block(arm_block)
      ctx.mir_ctx_apply_pending_bind()
      var or_saved_depth = ctx.mir_ctx_get_scope_depth()
      ctx.mir_ctx_set_scope_depth(or_saved_depth + 1)

      var or_guard_node = ast::ast_get_extra(s, arm)
      if or_guard_node > 0
        var or_gval = mir_lower::mir_lower_expr(ctx, s, or_guard_node)
        var or_gbody = ctx.mir_create_block("guard_body")
        var or_gcur = ctx.mir_ctx_get_block()
        mir_block_set_branch(or_gcur, or_gval, or_gbody, next_block)
        ctx.mir_switch_to_block(or_gbody)
      end

      var or_arm_val = ctx.mir_lower_block_expr(s, body_node)
      emit_and_pop_drops_for_scope(ctx, or_saved_depth + 1)
      ctx.mir_ctx_set_scope_depth(or_saved_depth)
      ctx.mir_emit_store_var(result_name, or_arm_val)
      var or_arm_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(or_arm_cur) < 0
        mir_block_set_terminator(or_arm_cur, mir::TERM_JUMP, end_block)
      end

      ctx.mir_switch_to_block(next_block)
      continue
    end

    # Check if enum pattern (NodeEnumAccess = 39) or bare ident matching variant
    var cmp_val = 0
    if pattern_kind == node_constants::NODE_ENUM_ACCESS
      # Enum pattern: get tag from subject (handles simple vs payload enums)
      var base_enum_name = ast::ast_get_str1(s, pattern_node)
      var variant_name = ast::ast_get_str2(s, pattern_node)
      # Resolve to qualified name; for unqualified patterns (empty name), find by variant
      var enum_name = ""
      if str_byte_len(base_enum_name) == 0
        enum_name = mir_find_enum_by_variant(ctx, variant_name)
      else
        enum_name = mir_resolve_enum_name(ctx, base_enum_name)
      end
      var tag_val = mir_get_enum_tag_subj(ctx, s, subject_node, enum_name, subject_val)

      # Get variant name, then compute index
      var variant_idx = mir_find_variant_index_ctx(ctx, enum_name, variant_name)
      var idx_val = ctx.mir_emit_const_int(variant_idx)

      cmp_val = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, idx_val)

      # PATTERN_PARSER_REJECTS_QUALIFIED_VARIANT sub-bug (b) fix + enum-niche tail
      # item 1: emit nested tag checks for constructor sub-patterns. The inner
      # payload load/deref is UNSAFE for a dataless outer variant (reads an
      # uninitialized payload slot ⇒ SEGFAULT), so guard it behind the outer tag
      # match: branch (outer_cmp ⇒ inner_check_block else next_block) and run the
      # loads only in the outer-matched block. The inner read goes through the niche
      # seam (mir_get_enum_tag_nested) so a niche inner reads correctly.
      var sub_pats = ast::ast_get_children(s, pattern_node)
      var has_ctor_sub = 0
      if sub_pats > 0
        var sub_count0 = vec_size(sub_pats)
        for spi0 in 0..sub_count0
          var sp0 = sub_pats[spi0]
          if sp0 > 0 and ast::ast_get_kind(s, sp0) == node_constants::NODE_ENUM_ACCESS
            has_ctor_sub = 1
          end
        end
      end
      if has_ctor_sub == 1
        var inner_check_block = ctx.mir_create_block("match_expr_inner_check")
        var outer_cur = ctx.mir_ctx_get_block()
        mir_block_set_branch(outer_cur, cmp_val, inner_check_block, next_block)
        ctx.mir_switch_to_block(inner_check_block)
        cmp_val = ctx.mir_emit_const_int(1)
        var sub_count = vec_size(sub_pats)
        for spi in 0..sub_count
          var sub_pat = sub_pats[spi]
          if sub_pat > 0
            var sub_kind = ast::ast_get_kind(s, sub_pat)
            if sub_kind == node_constants::NODE_ENUM_ACCESS
              var inner_payload_val = ctx.mir_emit_load_offset(subject_val, spi + 1)
              var inner_base = ast::ast_get_str1(s, sub_pat)
              var inner_variant = ast::ast_get_str2(s, sub_pat)
              var inner_enum = ""
              if str_byte_len(inner_base) == 0
                inner_enum = mir_find_enum_by_variant(ctx, inner_variant)
              else
                inner_enum = mir_resolve_enum_name(ctx, inner_base)
              end
              var inner_static_ty = ""
              var outer_field_types = mir_ctx_lookup_variant_field_types(ctx, enum_name, variant_name)
              if outer_field_types != 0 and spi < outer_field_types.size
                inner_static_ty = as_string(outer_field_types[spi])
              end
              var inner_tag = mir_get_enum_tag_nested(ctx, inner_enum, inner_static_ty, inner_payload_val)
              var inner_vidx = mir_find_variant_index_ctx(ctx, inner_enum, inner_variant)
              var inner_idx_val = ctx.mir_emit_const_int(inner_vidx)
              var inner_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, inner_tag, inner_idx_val)
              cmp_val = ctx.mir_emit_binary(op_constants::OP_AND, cmp_val, inner_cmp)
              # enum-niche tail item 6 — materialize nested inner-payload binds.
              # This block (inner_check_block) dominates the arm block, and is
              # reached ONLY when the outer tag matched (item 1's guard), so the
              # inner payload deref is safe. mir_bind_enum_payload_nested uses the
              # SAME niche/spill classifier as mir_get_enum_tag_nested above, so the
              # recovered value matches construction (§14.10.Q4). apply_pending_bind
              # only stores the recovered reg into the bound slot.
              var inner_bnames = ast::ast_get_bound_names(s, sub_pat)
              if inner_bnames > 0 and inner_bnames.size > 0
                for ibi in 0..inner_bnames.size
                  var inner_name = as_string(inner_bnames[ibi])
                  if inner_name != "_"
                    var rec = mir::mir_bind_enum_payload_nested(ctx, inner_enum, inner_static_ty, inner_payload_val, inner_variant, ibi)
                    var rec_ty = mir::mir_nested_bind_payload_type(ctx, inner_enum, inner_static_ty, inner_variant, ibi)
                    var rec_inl = mir::mir_nested_bind_is_inline(ctx, inner_enum, inner_static_ty, inner_variant)
                    mir::mir_ctx_push_nested_bind(ctx, inner_name, rec, rec_ty, rec_inl)
                  end
                end
              end
            end
          end
        end
      end

      # If pattern has bound names, bind payloads in arm block (multi-field)
      var bound_names = ast::ast_get_bound_names(s, pattern_node)
      if bound_names > 0
        if bound_names.size > 0
          var names = vec_new<String>()
          for bi in 0..bound_names.size
            names.push(as_string(bound_names[bi]))
          end
          mir_mark_pattern_bindings_typed(ctx, s, subject_node, enum_name, variant_name, names)
          ctx.mir_ctx_set_pending_bind(names, subject_val)
          # B.10 §12.10 — flag inline @value payloads so apply_pending_bind binds
          # an interior address instead of a boxed-pointer load.
          mir::mir_set_pending_inline_for_enum(ctx, s, subject_node, enum_name, variant_name, names)
        end
      end
    elsif pattern_kind == node_constants::NODE_STRUCT_DESTRUCTURE
      # Struct pattern: irrefutable — always matches, bind fields
      var sd_prev_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(sd_prev_block, mir::TERM_JUMP, arm_block)
      ctx.mir_switch_to_block(arm_block)

      var sd_saved_depth = ctx.mir_ctx_get_scope_depth()
      ctx.mir_ctx_set_scope_depth(sd_saved_depth + 1)

      var sd_type_name = ast::ast_get_str1(s, pattern_node)
      var sd_field_specs = ast::ast_get_str2(s, pattern_node)
      var sd_struct_name = sd_type_name
      if str_byte_len(sd_struct_name) == 0
        sd_struct_name = ctx.mir_infer_expr_type(s, subject_node)
      end
      var sd_specs = str_split(sd_field_specs, ",")
      for sd_fi in 0..sd_specs.size
        var sd_spec = sd_specs[sd_fi]
        var sd_fname = sd_spec
        var sd_bname = sd_spec
        var sd_cp = __char_index(sd_spec, ':')
        if sd_cp >= 0
          sd_fname = str_byte_slice(sd_spec, 0, sd_cp)
          sd_bname = str_byte_slice(sd_spec, sd_cp + 1, str_byte_len(sd_spec))
        end
        var sd_fidx = ctx.mir_ctx_find_field_index(sd_struct_name, sd_fname)
        var sd_offset = sd_fi
        if sd_fidx >= 0
          sd_offset = sd_fidx
        end
        var sd_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(sd_bname, sd_slot)
        var sd_val = ctx.mir_emit_load_offset(subject_val, sd_offset)
        ctx.mir_emit_store_var(sd_bname, sd_val)
      end

      var sd_guard = ast::ast_get_extra(s, arm)
      if sd_guard > 0
        var sd_gval = mir_lower::mir_lower_expr(ctx, s, sd_guard)
        var sd_gbody = ctx.mir_create_block("guard_body")
        var sd_gcur = ctx.mir_ctx_get_block()
        mir_block_set_branch(sd_gcur, sd_gval, sd_gbody, next_block)
        ctx.mir_switch_to_block(sd_gbody)
      end

      var sd_arm_val = ctx.mir_lower_block_expr(s, body_node)
      emit_and_pop_drops_for_scope(ctx, sd_saved_depth + 1)
      ctx.mir_ctx_set_scope_depth(sd_saved_depth)
      ctx.mir_emit_store_var(result_name, sd_arm_val)
      var sd_arm_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(sd_arm_cur) < 0
        mir_block_set_terminator(sd_arm_cur, mir::TERM_JUMP, end_block)
      end
      if sd_guard <= 0
        ctx.mir_switch_to_block(end_block)
        return ctx.mir_emit_load_var(result_name)
      end
      ctx.mir_switch_to_block(next_block)
      continue
    elsif pattern_kind == node_constants::NODE_VEC_DESTRUCTURE
      # Vec pattern: irrefutable — always matches, bind elements
      var vd_prev_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(vd_prev_block, mir::TERM_JUMP, arm_block)
      ctx.mir_switch_to_block(arm_block)

      var vd_saved_depth = ctx.mir_ctx_get_scope_depth()
      ctx.mir_ctx_set_scope_depth(vd_saved_depth + 1)

      var vd_elems_str = ast::ast_get_str1(s, pattern_node)
      var vd_rest = ast::ast_get_str2(s, pattern_node)
      var vd_has_rest = ast::ast_get_op(s, pattern_node)
      var vd_elems = str_split(vd_elems_str, ",")
      for vd_ei in 0..vd_elems.size
        var vd_ename = vd_elems[vd_ei]
        if str_byte_len(vd_ename) > 0
          var vd_slot = ctx.mir_ctx_alloc_slot()
          ctx.mir_ctx_bind_var(vd_ename, vd_slot)
          var vd_idx = ctx.mir_emit_const_int(vd_ei)
          var vd_val = ctx.mir_emit_intrinsic("vec_get", [subject_val, vd_idx])
          ctx.mir_emit_store_var(vd_ename, vd_val)
        end
      end
      if vd_has_rest == 1 and str_byte_len(vd_rest) > 0
        var vd_rest_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(vd_rest, vd_rest_slot)
        var vd_rest_vec = ctx.mir_emit_intrinsic("vec_new", [])
        ctx.mir_emit_store_var(vd_rest, vd_rest_vec)
      end

      var vd_guard = ast::ast_get_extra(s, arm)
      if vd_guard > 0
        var vd_gval = mir_lower::mir_lower_expr(ctx, s, vd_guard)
        var vd_gbody = ctx.mir_create_block("guard_body")
        var vd_gcur = ctx.mir_ctx_get_block()
        mir_block_set_branch(vd_gcur, vd_gval, vd_gbody, next_block)
        ctx.mir_switch_to_block(vd_gbody)
      end

      var vd_arm_val = ctx.mir_lower_block_expr(s, body_node)
      emit_and_pop_drops_for_scope(ctx, vd_saved_depth + 1)
      ctx.mir_ctx_set_scope_depth(vd_saved_depth)
      ctx.mir_emit_store_var(result_name, vd_arm_val)
      var vd_arm_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(vd_arm_cur) < 0
        mir_block_set_terminator(vd_arm_cur, mir::TERM_JUMP, end_block)
      end
      if vd_guard <= 0
        ctx.mir_switch_to_block(end_block)
        return ctx.mir_emit_load_var(result_name)
      end
      ctx.mir_switch_to_block(next_block)
      continue
    elsif pattern_kind == node_constants::NODE_IDENT
      # Bare ident pattern: check if it matches an enum variant name
      var ident_name = ast::ast_get_str1(s, pattern_node)
      var found_enum = mir_find_enum_by_variant(ctx, ident_name)
      if str_byte_len(found_enum) > 0
        # Resolve as enum variant: compare subject tag to variant index
        var tag_val = mir_get_enum_tag_subj(ctx, s, subject_node, found_enum, subject_val)
        var variant_idx = mir_find_variant_index_ctx(ctx, found_enum, ident_name)
        var idx_val = ctx.mir_emit_const_int(variant_idx)
        cmp_val = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, idx_val)
      else
        # Not an enum variant: compare as value (constant or binding)
        var pattern_val = mir_lower::mir_lower_expr(ctx, s, pattern_node)
        if string_arm_count > 0
          # Subject is a string (other arms are string literals) — use str_eq
          var eq_args = [subject_val, pattern_val]
          cmp_val = ctx.mir_emit_intrinsic("str_eq", eq_args)
        else
          cmp_val = ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, pattern_val)
        end
      end
    elsif pattern_kind == node_constants::NODE_REGEX_LIT
      # Regex pattern: call regex_match(subject, pattern)
      var pattern_val = mir_lower::mir_lower_expr(ctx, s, pattern_node)
      var rargs = [subject_val, pattern_val]
      cmp_val = ctx.mir_emit_intrinsic("regex_match", rargs)
    elsif pattern_kind == node_constants::NODE_BINARY
      # Range pattern: 1..10 or 1...10
      var range_op = ast::ast_get_op(s, pattern_node)
      if range_op == op_constants::OP_RANGE or range_op == op_constants::OP_RANGE_INCLUSIVE
        var left_node = ast::ast_get_left(s, pattern_node)
        var right_node = ast::ast_get_right(s, pattern_node)
        var lo_val = mir_lower::mir_lower_expr(ctx, s, left_node)
        var hi_val = mir_lower::mir_lower_expr(ctx, s, right_node)
        var ge_cmp = ctx.mir_emit_binary(op_constants::OP_GE, subject_val, lo_val)
        var hi_cmp = 0
        if range_op == op_constants::OP_RANGE_INCLUSIVE
          hi_cmp = ctx.mir_emit_binary(op_constants::OP_LE, subject_val, hi_val)
        else
          hi_cmp = ctx.mir_emit_binary(op_constants::OP_LT, subject_val, hi_val)
        end
        cmp_val = ctx.mir_emit_binary(op_constants::OP_BIT_AND, ge_cmp, hi_cmp)
      else
        # Non-range binary in pattern position — fall through to literal comparison
        var pattern_val = mir_lower::mir_lower_expr(ctx, s, pattern_node)
        cmp_val = ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, pattern_val)
      end
    else
      # Non-enum pattern: compare subject to pattern value directly
      var pattern_val = mir_lower::mir_lower_expr(ctx, s, pattern_node)

      # String patterns (node_constants$NODE_STRING_LIT = 3) need str_eq comparison
      if use_hash_dispatch == 1 and pattern_kind == node_constants::NODE_STRING_LIT
        # Length + hash pre-filter: length check (cheapest) → hash check → str_eq verify
        var pat_str = ast::ast_get_str1(s, pattern_node)
        var pat_len = str_byte_len(pat_str)
        var len_const = ctx.mir_emit_const_int(pat_len)
        var len_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, subject_len, len_const)
        var hash_block = ctx.mir_create_block("match_len_ok")
        var cur_l = ctx.mir_ctx_get_block()
        mir_block_set_branch(cur_l, len_cmp, hash_block, next_block)
        ctx.mir_switch_to_block(hash_block)
        # Hash check within length group
        var pat_hash = fnv1a_hash(pat_str)
        var hash_const = ctx.mir_emit_const_int(pat_hash)
        var hash_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, subject_hash, hash_const)
        var verify_block = ctx.mir_create_block("match_verify")
        var cur_h = ctx.mir_ctx_get_block()
        mir_block_set_branch(cur_h, hash_cmp, verify_block, next_block)
        ctx.mir_switch_to_block(verify_block)
        var eq_args = [subject_val, pattern_val]
        cmp_val = ctx.mir_emit_intrinsic("str_eq", eq_args)
      elsif pattern_kind == node_constants::NODE_STRING_LIT
        var args = [subject_val, pattern_val]
        cmp_val = ctx.mir_emit_intrinsic("str_eq", args)
      else
        cmp_val = ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, pattern_val)
      end
    end

    var cur = ctx.mir_ctx_get_block()
    mir_block_set_branch(cur, cmp_val, arm_block, next_block)

    # Arm block: apply pending binds, check guard, lower body, store result
    ctx.mir_switch_to_block(arm_block)
    ctx.mir_ctx_apply_pending_bind()
    # Scope for match arm variables
    var saved_depth = ctx.mir_ctx_get_scope_depth()
    ctx.mir_ctx_set_scope_depth(saved_depth + 1)

    # Check for guard expression on enum/value patterns.
    # Use `> 0` because 0 is the AST null sentinel — `>= 0` synthesizes a
    # phantom guard that always evaluates to 0 (false), silently skipping
    # guardless arms. Caused the MULTI-CLAUSE-1 crash.
    var arm_guard_node = ast::ast_get_extra(s, arm)
    if arm_guard_node > 0
      var guard_val = mir_lower::mir_lower_expr(ctx, s, arm_guard_node)
      var guard_body = ctx.mir_create_block("guard_body")
      var cur_g = ctx.mir_ctx_get_block()
      mir_block_set_branch(cur_g, guard_val, guard_body, next_block)
      ctx.mir_switch_to_block(guard_body)
    end

    var arm_val = ctx.mir_lower_block_expr(s, body_node)
    # Emit drops for arm-local variables before jump (and pop to prevent re-drop)
    emit_and_pop_drops_for_scope(ctx, saved_depth + 1)
    ctx.mir_ctx_set_scope_depth(saved_depth)
    ctx.mir_emit_store_var(result_name, arm_val)
    var arm_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(arm_cur) < 0
      mir_block_set_terminator(arm_cur, mir::TERM_JUMP, end_block)
    end

    # Continue with next arm
    ctx.mir_switch_to_block(next_block)
  end

  # After all arms, jump to end (unreachable if exhaustive)
  var final_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(final_cur) < 0
    mir_block_set_terminator(final_cur, mir::TERM_JUMP, end_block)
  end

  ctx.mir_switch_to_block(end_block)
  return ctx.mir_emit_load_var(result_name)
end

def mir_lower_concurrency(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)

  # NodeTaskGroup = 71: task_group |g| ... end (structured concurrency)
  if kind == node_constants::NODE_TASK_GROUP
    # Mark program as using task_group (for conditional TLS preamble)
    var tg_prog = ctx.mir_ctx_get_program()
    mir_set_uses_task_group(tg_prog)
    mir_set_uses_scheduler(tg_prog)

    var tg_name = ast::ast_get_str1(s, node)
    var body = ast::ast_get_left(s, node)

    # task_pool_get()
    var pool_args = vec_new()
    var pool_val = ctx.mir_emit_intrinsic("task_pool_get", pool_args)

    # task_group_new(pool)
    var tgn_args = vec_new()
    tgn_args.push(pool_val)
    var group_val = ctx.mir_emit_intrinsic("task_group_new", tgn_args)

    # Store group handle as local variable
    ctx.mir_emit_store_var(tg_name, group_val)

    # Lower body
    var body_val = 0
    if body >= 0
      var body_kind = ast::ast_get_kind(s, body)
      if body_kind == node_constants::NODE_BLOCK
        var children = ast::ast_get_children(s, body)
        var count = children.size

        # Check if last expression is g.collect() — must run AFTER await.
        # After typecheck, the call name is in the left child IDENT's str1.
        var last_is_collect = 0
        if count > 0
          var last_stmt = children[count - 1]
          var last_kind = ast::ast_get_kind(s, last_stmt)
          var check_call = -1
          if last_kind == node_constants::NODE_EXPR_STMT
            var inner = ast::ast_get_left(s, last_stmt)
            if ast::ast_get_kind(s, inner) == node_constants::NODE_CALL
              check_call = inner
            end
          elsif last_kind == node_constants::NODE_CALL
            check_call = last_stmt
          end
          if check_call >= 0
            # Check str1 of the call node itself
            var call_name = ast::ast_get_str1(s, check_call)
            if call_name == "taskgroup_collect"
              last_is_collect = 1
            end
            # Also check the left child (IDENT node) for function name
            if last_is_collect == 0
              var call_left = ast::ast_get_left(s, check_call)
              if call_left >= 0
                var left_name = ast::ast_get_str1(s, call_left)
                if left_name == "taskgroup_collect"
                  last_is_collect = 1
                end
              end
            end
          end
        end

        if last_is_collect == 1
          # Lower all stmts except last (collect must be after await)
          var i = 0
          while i < count - 1
            mir_lower::mir_lower_stmt(ctx, s, children[i])
            i += 1
          end
        else
          # Lower all body stmts, capturing last expression value
          for i in 0..count
            var stmt = children[i]
            var stmt_kind = ast::ast_get_kind(s, stmt)
            if i == count - 1 and stmt_kind == node_constants::NODE_EXPR_STMT
              var inner = ast::ast_get_left(s, stmt)
              body_val = mir_lower::mir_lower_expr(ctx, s, inner)
            else
              mir_lower::mir_lower_stmt(ctx, s, stmt)
            end
          end
        end

        # Await all spawned tasks
        var g_load = ctx.mir_emit_load_var(tg_name)
        var aw_args = vec_new()
        aw_args.push(g_load)
        ctx.mir_emit_intrinsic("task_group_await_all", aw_args)

        # If last was collect, evaluate it now (after await)
        if last_is_collect == 1 and count > 0
          var last_collect_stmt = children[count - 1]
          var inner = ast::ast_get_left(s, last_collect_stmt)
          body_val = mir_lower::mir_lower_expr(ctx, s, inner)
        end
      end
    end

    # task_group_destroy(g)
    var g_load2 = ctx.mir_emit_load_var(tg_name)
    var td_args = vec_new()
    td_args.push(g_load2)
    ctx.mir_emit_intrinsic("task_group_destroy", td_args)

    return body_val
  end

  # NodeSelect = 59: select { channel_arms }
  # Polling loop: try each arm's channel op, execute first that succeeds
  if kind == node_constants::NODE_SELECT
    var arms = ast::ast_get_children(s, node)
    if arms == 0
      return ctx.mir_emit_const_int(0)
    end
    var arm_count = arms.size
    if arm_count == 0
      return ctx.mir_emit_const_int(0)
    end

    # Allocate result variable
    var result_name = "__select_result"
    var result_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(result_name, result_slot)

    # Create blocks
    var loop_block = ctx.mir_create_block("select_loop")
    var done_block = ctx.mir_create_block("select_done")

    var try_blocks = vec_new()
    var body_blocks = vec_new()
    var free_blocks = vec_new()
    for i in 0..arm_count
      try_blocks.push(ctx.mir_create_block("select_try"))
      body_blocks.push(ctx.mir_create_block("select_body"))
      free_blocks.push(ctx.mir_create_block("select_free"))
    end

    # Pre-compute channel notify fd for I/O-based suspension (if any channel arms)
    var has_channel_arm = false
    var notify_fd_name = "__select_notify_fd"
    for i in 0..arm_count
      var arm = arms[i]
      var op_kind = ast::ast_get_op(s, arm)
      if (op_kind == 0 or op_kind == 1) and not has_channel_arm
        has_channel_arm = true
        var channel_node = ast::ast_get_left(s, arm)
        var ch_val = mir_lower::mir_lower_expr(ctx, s, channel_node)
        var nfd_args = vec_new()
        nfd_args.push(ch_val)
        var notify_fd = ctx.mir_emit_intrinsic("channel_notify_fd", nfd_args)
        var nfd_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(notify_fd_name, nfd_slot)
        ctx.mir_emit_store_var(notify_fd_name, notify_fd)
      end
    end

    # C.13 Phase 4b — active-wake protocol for user-defined Selectables.
    # Hoist op_kind=5 selectable expression lowering out of try_blocks
    # (where it ran every poll iteration, re-evaluating constructors like
    # `deadline_ms(ms)` and silently advancing deadlines each round) into
    # the entry block. Stash each `self` in a slot bound `__sel_self_<i>`
    # so try / body blocks can re-load without re-evaluating. After all
    # selectables are stashed, register the polling task's frame on each
    # one's waker list — when any becomes ready, its impl calls
    # `sched_wake(frame)` and the parked select wakes immediately,
    # collapsing observe-latency from chunk-poll cadence (~10ms) to
    # microseconds. Body blocks call `unregister_waker` before running
    # user code (Plan A — eager unregistration is throw-safe because
    # complete() may throw via Throws and would otherwise leak wakers).
    var has_selectable_arm = false
    for i in 0..arm_count
      var sel_check_arm = arms[i]
      if ast::ast_get_op(s, sel_check_arm) == 5
        if not has_selectable_arm
          has_selectable_arm = true
        end
        var sel_self_name_pre = "__sel_self_#{i}"
        var sel_self_slot_pre = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(sel_self_name_pre, sel_self_slot_pre)
        var sel_node_pre = ast::ast_get_left(s, sel_check_arm)
        var sel_self_pre = mir_lower::mir_lower_expr(ctx, s, sel_node_pre)
        ctx.mir_emit_store_var(sel_self_name_pre, sel_self_pre)
        if mir_lower_gen::mir_gen_is_active() >= 2
          mir_lower_gen::mir_gen_register_dynamic_local(sel_self_name_pre)
        end
      end
    end

    # Register the polling task as a waker on every user-defined
    # Selectable. ScopeCancelSelectable wires through B.7 4e.8's
    # `_scope_register_waiter`; DeadlineSelectable wires through
    # `scope_deadline` (B.7 4d) — see std/sync/composition/scope.qz. Recv / Send /
    # Future are stubs in this phase (Phase 5 will wire them via channel
    # waker list + future completion-fd substrates). Stub register_waker
    # is a no-op so chunked-poll fall-through still works for those arms
    # — active-wake is purely additive.
    if has_selectable_arm
      var rw_frame = ctx.mir_emit_intrinsic("task_self", vec_new())
      for ri in 0..arm_count
        var rw_arm = arms[ri]
        if ast::ast_get_op(s, rw_arm) == 5
          var rw_struct = ast::ast_select_arm_struct(s, rw_arm)
          var rw_self = ctx.mir_emit_load_var("__sel_self_#{ri}")
          var rw_fn = string_intern::mangle(rw_struct, "register_waker")
          var rw_args = vec_new()
          rw_args.push(rw_self)
          rw_args.push(rw_frame)
          mir_emit_call(ctx, rw_fn, rw_args)
        end
      end
    end

    # Phase 14: Classify arms into shuffleable (recv/send/await) vs. default/timeout
    var shuffleable = vec_new()
    var default_idx = -1
    var timeout_idx = -1
    for ci in 0..arm_count
      var ci_arm = arms[ci]
      var ci_op = ast::ast_get_op(s, ci_arm)
      if ci_op == 2
        default_idx = ci
      elsif ci_op == 4
        timeout_idx = ci
      else
        shuffleable.push(ci)
      end
    end
    var shuffle_count = shuffleable.size

    # Phase 14: Fairness infrastructure — Fisher-Yates shuffle with dispatch chain
    # For ≤1 shuffleable arms, skip fairness (zero overhead).
    var use_fairness = shuffle_count > 1
    var perm_name = "__sel_perm_#{_select_fairness_id}"
    var tried_name = "__sel_tried_#{_select_fairness_id}"
    _select_fairness_id += 1

    if use_fairness
      # Allocate fairness variable slots
      var perm_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(perm_name, perm_slot)
      var tried_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(tried_name, tried_slot)
    end

    # Create fairness blocks (only if > 1 shuffleable arm)
    var dispatch_block = 0
    var advance_block = 0
    var fallback_block = 0
    if use_fairness
      dispatch_block = ctx.mir_create_block("sel_dispatch")
      advance_block = ctx.mir_create_block("sel_advance")
      if default_idx >= 0
        fallback_block = ctx.mir_create_block("sel_fallback")
      elsif timeout_idx >= 0
        fallback_block = try_blocks[timeout_idx]
      else
        fallback_block = loop_block
      end
    end

    # Determine the first try target (dispatch_block if fairness, else first non-default arm)
    var first_try_target = try_blocks[0]
    if use_fairness
      first_try_target = dispatch_block
    else
      # Skip default arms — find first non-default arm to start from
      if shuffle_count > 0
        first_try_target = try_blocks[shuffleable[0]]
      elsif default_idx >= 0
        first_try_target = body_blocks[default_idx]
      end
    end

    # Emit permutation vec + Fisher-Yates shuffle (before loop, in entry block)
    if use_fairness
      var perm_vec = ctx.mir_emit_intrinsic("vec_new", vec_new())
      for si in 0..shuffle_count
        var si_val = ctx.mir_emit_const_int(shuffleable[si])
        ctx.mir_emit_intrinsic("vec_push", [perm_vec, si_val])
      end
      # Unrolled Fisher-Yates: for k = shuffle_count-1 downto 1
      var k = shuffle_count - 1
      while k >= 1
        var k_const = ctx.mir_emit_const_int(k)
        var k_plus_1 = ctx.mir_emit_const_int(k + 1)
        var zero_const = ctx.mir_emit_const_int(0)
        var j = ctx.mir_emit_intrinsic("rand_range", [zero_const, k_plus_1])
        var tmp_k = ctx.mir_emit_intrinsic("vec_get", [perm_vec, k_const])
        var tmp_j = ctx.mir_emit_intrinsic("vec_get", [perm_vec, j])
        ctx.mir_emit_intrinsic("vec_set", [perm_vec, k_const, tmp_j])
        ctx.mir_emit_intrinsic("vec_set", [perm_vec, j, tmp_k])
        k -= 1
      end
      ctx.mir_emit_store_var(perm_name, perm_vec)
      ctx.mir_emit_store_var(tried_name, ctx.mir_emit_const_int(0))
    end

    # P28: Timeout arm setup — record start time and timeout duration
    var start_time_name = "__sel_start_ns"
    var timeout_ms_name = "__sel_timeout_ms"
    if timeout_idx >= 0
      var st_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(start_time_name, st_slot)
      var start_ns = ctx.mir_emit_intrinsic("time_mono_ns", vec_new())
      ctx.mir_emit_store_var(start_time_name, start_ns)

      var tmo_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(timeout_ms_name, tmo_slot)
      var tmo_arm = arms[timeout_idx]
      var tmo_expr = ast::ast_get_left(s, tmo_arm)
      var tmo_val = mir_lower::mir_lower_expr(ctx, s, tmo_expr)
      ctx.mir_emit_store_var(timeout_ms_name, tmo_val)
    end

    # Jump to loop
    var entry = ctx.mir_ctx_get_block()
    mir_block_set_terminator(entry, mir::TERM_JUMP, loop_block)

    # Loop block: suspend on I/O or yield, then dispatch to try arms
    ctx.mir_switch_to_block(loop_block)
    # Reset tried counter at start of each poll round
    if use_fairness
      ctx.mir_emit_store_var(tried_name, ctx.mir_emit_const_int(0))
    end

    # P28: If timeout arm, compute remaining and check for early expiry before suspend
    if timeout_idx >= 0
      var tl_now = ctx.mir_emit_intrinsic("time_mono_ns", vec_new())
      var tl_start = ctx.mir_emit_load_var(start_time_name)
      var tl_elapsed = ctx.mir_emit_binary(op_constants::OP_SUB, tl_now, tl_start)
      var tl_divisor = ctx.mir_emit_const_int(1000000)
      var tl_elapsed_ms = ctx.mir_emit_binary(op_constants::OP_DIV, tl_elapsed, tl_divisor)
      var tl_tmo = ctx.mir_emit_load_var(timeout_ms_name)
      var tl_remaining = ctx.mir_emit_binary(op_constants::OP_SUB, tl_tmo, tl_elapsed_ms)
      # If remaining <= 0, timeout expired — jump directly to timeout body
      var tl_zero = ctx.mir_emit_const_int(0)
      var tl_expired = ctx.mir_emit_binary(op_constants::OP_LE, tl_remaining, tl_zero)
      var tl_cont = ctx.mir_create_block("sel_tmo_cont")
      ctx.mir_emit_branch(tl_expired, body_blocks[timeout_idx], tl_cont)
      ctx.mir_switch_to_block(tl_cont)
      # Store remaining for timer creation during I/O registration
      ctx.mir_emit_intrinsic("io_set_pending_timeout", [tl_remaining])
      if mir_lower_gen::mir_gen_is_active() >= 2
        mir_lower_gen::mir_gen_register_dynamic_local(start_time_name)
        mir_lower_gen::mir_gen_register_dynamic_local(timeout_ms_name)
      end
    end

    if has_channel_arm
      var loaded_fd = ctx.mir_emit_load_var(notify_fd_name)
      if mir_lower_gen::mir_gen_is_active() >= 2
        mir_lower_gen::mir_gen_register_dynamic_local(notify_fd_name)
        mir_lower_gen::mir_gen_register_dynamic_local(result_name)
        if use_fairness
          mir_lower_gen::mir_gen_register_dynamic_local(perm_name)
          mir_lower_gen::mir_gen_register_dynamic_local(tried_name)
        end
        mir_lower_gen::mir_emit_async_suspend_point(ctx, loaded_fd, first_try_target)
      else
        if timeout_idx >= 0
          # Non-async: use io_suspend_timeout for timer-backed suspension
          var loaded_fd2 = ctx.mir_emit_load_var(notify_fd_name)
          var tl_tmo2 = ctx.mir_emit_load_var(timeout_ms_name)
          var tl_now2 = ctx.mir_emit_intrinsic("time_mono_ns", vec_new())
          var tl_start2 = ctx.mir_emit_load_var(start_time_name)
          var tl_elapsed2 = ctx.mir_emit_binary(op_constants::OP_SUB, tl_now2, tl_start2)
          var tl_div2 = ctx.mir_emit_const_int(1000000)
          var tl_elapsed_ms2 = ctx.mir_emit_binary(op_constants::OP_DIV, tl_elapsed2, tl_div2)
          var tl_remaining2 = ctx.mir_emit_binary(op_constants::OP_SUB, tl_tmo2, tl_elapsed_ms2)
          var tl_one = ctx.mir_emit_const_int(1)
          var tl_events = ctx.mir_emit_const_int(1)
          ctx.mir_emit_intrinsic("io_suspend_timeout", [loaded_fd2, tl_remaining2, tl_events])
        else
          var suspend_args = vec_new()
          suspend_args.push(loaded_fd)
          ctx.mir_emit_intrinsic("io_suspend", suspend_args)
        end
        var loop_cur = ctx.mir_ctx_get_block()
        mir_block_set_terminator(loop_cur, mir::TERM_JUMP, first_try_target)
      end
    else
      if mir_lower_gen::mir_gen_is_active() >= 2
        mir_lower_gen::mir_gen_register_dynamic_local(result_name)
        if use_fairness
          mir_lower_gen::mir_gen_register_dynamic_local(perm_name)
          mir_lower_gen::mir_gen_register_dynamic_local(tried_name)
        end
        if timeout_idx >= 0
          # No channel arm + timeout: use sched_sleep for timer-only suspend
          var tl_tmo3 = ctx.mir_emit_load_var(timeout_ms_name)
          var tl_now3 = ctx.mir_emit_intrinsic("time_mono_ns", vec_new())
          var tl_start3 = ctx.mir_emit_load_var(start_time_name)
          var tl_elapsed3 = ctx.mir_emit_binary(op_constants::OP_SUB, tl_now3, tl_start3)
          var tl_div3 = ctx.mir_emit_const_int(1000000)
          var tl_elapsed_ms3 = ctx.mir_emit_binary(op_constants::OP_DIV, tl_elapsed3, tl_div3)
          var tl_remaining3 = ctx.mir_emit_binary(op_constants::OP_SUB, tl_tmo3, tl_elapsed_ms3)
          ctx.mir_emit_intrinsic("io_set_pending_sleep", [tl_remaining3])
          var sleep_fd = ctx.mir_emit_const_int(0)
          mir_lower_gen::mir_emit_async_suspend_point(ctx, sleep_fd, first_try_target)
        else
          mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, first_try_target)
        end
      else
        var yield_args = vec_new()
        ctx.mir_emit_intrinsic("sched_yield", yield_args)
        var loop_cur2 = ctx.mir_ctx_get_block()
        mir_block_set_terminator(loop_cur2, mir::TERM_JUMP, first_try_target)
      end
    end

    # Phase 14: Emit dispatch + comparison chain + advance (only if fairness)
    if use_fairness
      # dispatch_block: check if we've tried all shuffleable arms
      ctx.mir_switch_to_block(dispatch_block)
      var d_tried = ctx.mir_emit_load_var(tried_name)
      var d_count = ctx.mir_emit_const_int(shuffle_count)
      var d_in_range = ctx.mir_emit_binary(op_constants::OP_LT, d_tried, d_count)
      var index_block = ctx.mir_create_block("sel_index")
      ctx.mir_emit_branch(d_in_range, index_block, fallback_block)

      # index_block: load arm_idx from perm vec, then comparison chain
      ctx.mir_switch_to_block(index_block)
      var d_perm = ctx.mir_emit_load_var(perm_name)
      var d_tried2 = ctx.mir_emit_load_var(tried_name)
      var arm_idx = ctx.mir_emit_intrinsic("vec_get", [d_perm, d_tried2])

      # Comparison chain: dispatch arm_idx to correct try_block
      for ci in 0..shuffle_count
        var src_idx = shuffleable[ci]
        var cmp_val = ctx.mir_emit_const_int(src_idx)
        var is_match = ctx.mir_emit_binary(op_constants::OP_EQ, arm_idx, cmp_val)
        if ci + 1 < shuffle_count
          var next_cmp = ctx.mir_create_block("sel_cmp")
          ctx.mir_emit_branch(is_match, try_blocks[src_idx], next_cmp)
          ctx.mir_switch_to_block(next_cmp)
        else
          # Last arm: unconditional jump (must be this one)
          var cmp_cur = ctx.mir_ctx_get_block()
          mir_block_set_terminator(cmp_cur, mir::TERM_JUMP, try_blocks[src_idx])
        end
      end

      # advance_block: increment tried counter, re-dispatch
      ctx.mir_switch_to_block(advance_block)
      var a_tried = ctx.mir_emit_load_var(tried_name)
      var a_next = ctx.mir_emit_binary(op_constants::OP_ADD, a_tried, ctx.mir_emit_const_int(1))
      ctx.mir_emit_store_var(tried_name, a_next)
      var adv_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(adv_cur, mir::TERM_JUMP, dispatch_block)

      # fallback_block: default arm (if present)
      if default_idx >= 0
        ctx.mir_switch_to_block(fallback_block)
        var fb_cur = ctx.mir_ctx_get_block()
        mir_block_set_terminator(fb_cur, mir::TERM_JUMP, body_blocks[default_idx])
      end
    end

    # Generate try blocks
    for i in 0..arm_count
      var arm = arms[i]
      var op_kind = ast::ast_get_op(s, arm)

      ctx.mir_switch_to_block(try_blocks[i])

      if op_kind == 2
        # Default arm: unconditional jump to body
        # With fairness: only reachable via fallback_block (checked last, Go semantics)
        # Without fairness: reachable in source order (existing behavior)
        var cur = ctx.mir_ctx_get_block()
        mir_block_set_terminator(cur, mir::TERM_JUMP, body_blocks[i])
      else
        # Compute failure target: advance_block (fairness) or next channel arm (no fairness)
        var fail_target = loop_block
        if use_fairness
          fail_target = advance_block
        else
          # Skip default and timeout arms — they're checked last
          var next_channel = -1
          var j = i + 1
          while j < arm_count
            var j_op = ast::ast_get_op(s, arms[j])
            if j_op != 2 and j_op != 4
              next_channel = j
              j = arm_count
            end
            j += 1
          end
          if next_channel >= 0
            fail_target = try_blocks[next_channel]
          elsif default_idx >= 0
            fail_target = body_blocks[default_idx]
          elsif timeout_idx >= 0
            fail_target = try_blocks[timeout_idx]
          end
        end

        if op_kind == 0
          # Recv arm: try_recv returns Option ptr, branch on is_some
          var channel_node = ast::ast_get_left(s, arm)
          var ch_val = mir_lower::mir_lower_expr(ctx, s, channel_node)
          var recv_args = vec_new()
          recv_args.push(ch_val)
          var opt_ptr = ctx.mir_emit_intrinsic("try_recv", recv_args)
          ctx.mir_emit_store_var(result_name, opt_ptr)
          var is_some_args = vec_new()
          is_some_args.push(opt_ptr)
          var is_some = ctx.mir_emit_intrinsic("option_is_some", is_some_args)
          var cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(cur, is_some, body_blocks[i], free_blocks[i])
          # Free block: free the None option, then check if channel is closed.
          # Go semantics: recv from closed channel succeeds with zero value.
          ctx.mir_switch_to_block(free_blocks[i])
          var load_opt = ctx.mir_emit_load_var(result_name)
          ctx.mir_emit_intrinsic("option_free", [load_opt])
          # Check channel_closed — if closed, fire arm with zero value (Go semantics)
          var closed_args = vec_new()
          closed_args.push(ch_val)
          var is_closed = ctx.mir_emit_intrinsic("channel_closed", closed_args)
          var closed_body = ctx.mir_create_block("sel_closed")
          ctx.mir_emit_branch(is_closed, closed_body, fail_target)
          # Closed path: create synthetic Some(0), store to result, jump to body
          ctx.mir_switch_to_block(closed_body)
          var synth_opt = ctx.mir_emit_alloc(2)
          ctx.mir_emit_store_offset(synth_opt, 0, ctx.mir_emit_const_int(0))
          ctx.mir_emit_store_offset(synth_opt, 1, ctx.mir_emit_const_int(0))
          ctx.mir_emit_store_var(result_name, synth_opt)
          var closed_cur = ctx.mir_ctx_get_block()
          mir_block_set_terminator(closed_cur, mir::TERM_JUMP, body_blocks[i])
        end
        if op_kind == 1
          # Send arm: try_send(channel, payload), branch on result != 0
          var channel_node = ast::ast_get_left(s, arm)
          var payload_node = ast::ast_get_extra(s, arm)
          var ch_val = mir_lower::mir_lower_expr(ctx, s, channel_node)
          var data_val = mir_lower::mir_lower_expr(ctx, s, payload_node)
          var send_args = vec_new()
          send_args.push(ch_val)
          send_args.push(data_val)
          var sent_ok = ctx.mir_emit_intrinsic("try_send", send_args)
          var cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(cur, sent_ok, body_blocks[i], fail_target)
        end
        if op_kind == 3
          # Await arm: check if task frame state == -1 (done)
          var task_node = ast::ast_get_left(s, arm)
          var task_val = mir_lower::mir_lower_expr(ctx, s, task_node)
          var state = ctx.mir_emit_load_offset(task_val, 0)
          var neg_one = ctx.mir_emit_const_int(-1)
          var is_done = ctx.mir_emit_binary(op_constants::OP_EQ, state, neg_one)
          var cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(cur, is_done, body_blocks[i], fail_target)
        end
        if op_kind == 4
          # P28: Timeout arm — check if elapsed >= timeout_ms
          var tt_now = ctx.mir_emit_intrinsic("time_mono_ns", vec_new())
          var tt_start = ctx.mir_emit_load_var(start_time_name)
          var tt_elapsed = ctx.mir_emit_binary(op_constants::OP_SUB, tt_now, tt_start)
          var tt_divisor = ctx.mir_emit_const_int(1000000)
          var tt_elapsed_ms = ctx.mir_emit_binary(op_constants::OP_DIV, tt_elapsed, tt_divisor)
          var tt_tmo = ctx.mir_emit_load_var(timeout_ms_name)
          var tt_expired = ctx.mir_emit_binary(op_constants::OP_GE, tt_elapsed_ms, tt_tmo)
          var cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(cur, tt_expired, body_blocks[i], loop_block)
        end
        if op_kind == 5
          # C.13 Phase 4b — user-defined Selectable. The selectable
          # expression was lowered once in the entry block (see the
          # active-wake hoist near the top of NODE_SELECT) and stashed
          # in `__sel_self_<i>`. Here in the try block we just reload
          # it and call `<Struct>$try_poll(self)`. On a hit we branch
          # to the body block (which unregisters all wakers, then calls
          # `<Struct>$complete(self)` for the destructive op). On a
          # miss we free the None option + jump to fail_target.
          var sel_struct = ast::ast_select_arm_struct(s, arm)
          var sel_self_name = "__sel_self_#{i}"
          var sel_self = ctx.mir_emit_load_var(sel_self_name)
          var tp_fn = string_intern::mangle(sel_struct, "try_poll")
          var tp_args = vec_new()
          tp_args.push(sel_self)
          var sel_opt = mir_emit_call(ctx, tp_fn, tp_args)
          ctx.mir_emit_store_var(result_name, sel_opt)
          var sel_is_some_args = vec_new()
          sel_is_some_args.push(sel_opt)
          var sel_is_some = ctx.mir_emit_intrinsic("option_is_some", sel_is_some_args)
          var sel_cur = ctx.mir_ctx_get_block()
          mir_block_set_branch(sel_cur, sel_is_some, body_blocks[i], free_blocks[i])
          # Free block: free the None option, jump to fail_target
          ctx.mir_switch_to_block(free_blocks[i])
          var sel_load_opt = ctx.mir_emit_load_var(result_name)
          ctx.mir_emit_intrinsic("option_free", [sel_load_opt])
          var sel_free_cur = ctx.mir_ctx_get_block()
          mir_block_set_terminator(sel_free_cur, mir::TERM_JUMP, fail_target)
        end
      end
    end

    # Generate body blocks
    for i in 0..arm_count
      var arm = arms[i]
      var op_kind = ast::ast_get_op(s, arm)
      var body_node = ast::ast_get_right(s, arm)

      ctx.mir_switch_to_block(body_blocks[i])

      # C.13 Phase 4b — body prologue: unregister every Selectable
      # waker BEFORE the arm-specific binding/complete code runs. Plan A:
      # eager unregistration. ScopeCancelSelectable's complete() throws
      # via Throws and never returns; if we deferred unregister to after
      # complete, the throw would unwind with the winner's waker still
      # registered (and any other registered impls — DeadlineSelectable
      # timers, channel waker entries once Phase 5 wires them).
      # Unregister-all-then-complete keeps the unwind path clean. Run
      # for every body block regardless of op_kind so a recv/send/await
      # arm winning still cleans up co-existing Selectable wakers.
      # register_waker / unregister_waker are required by trait contract
      # to be idempotent, so unregistering when never registered is a
      # no-op.
      if has_selectable_arm
        var ur_frame = ctx.mir_emit_intrinsic("task_self", vec_new())
        for uri in 0..arm_count
          var ur_arm = arms[uri]
          if ast::ast_get_op(s, ur_arm) == 5
            var ur_struct = ast::ast_select_arm_struct(s, ur_arm)
            var ur_self = ctx.mir_emit_load_var("__sel_self_#{uri}")
            var ur_fn = string_intern::mangle(ur_struct, "unregister_waker")
            var ur_args = vec_new()
            ur_args.push(ur_self)
            ur_args.push(ur_frame)
            mir_emit_call(ctx, ur_fn, ur_args)
          end
        end
      end

      # For recv arms: extract value from Option, free it, bind variable
      if op_kind == 0
        var load_opt = ctx.mir_emit_load_var(result_name)
        var get_args = vec_new()
        get_args.push(load_opt)
        var value = ctx.mir_emit_intrinsic("option_get", get_args)
        var free_args = vec_new()
        free_args.push(load_opt)
        ctx.mir_emit_intrinsic("option_free", free_args)
        ctx.mir_emit_store_var(result_name, value)
        var binding = ast::ast_get_str1(s, arm)
        if str_byte_len(binding) > 0
          # Register the arm binding FIRST so the body resolves it via
          # mir_ctx_lookup_var instead of a same-named free function
          # (concurrency recv-arm guise of the 30d37c96 shadow miscompile).
          var binding_slot = ctx.mir_ctx_alloc_slot()
          ctx.mir_ctx_bind_var(binding, binding_slot)
          ctx.mir_emit_store_var(binding, value)
        end
      end

      # For await arms: extract result from frame[1], bind variable
      if op_kind == 3
        var task_node = ast::ast_get_left(s, arm)
        var task_val = mir_lower::mir_lower_expr(ctx, s, task_node)
        var result_val = ctx.mir_emit_load_offset(task_val, 1)
        ctx.mir_emit_store_var(result_name, result_val)
        var binding = ast::ast_get_str1(s, arm)
        if str_byte_len(binding) > 0
          # Register the arm binding FIRST so the body resolves it via
          # mir_ctx_lookup_var instead of a same-named free function
          # (concurrency await-arm guise of the 30d37c96 shadow miscompile).
          var binding_slot = ctx.mir_ctx_alloc_slot()
          ctx.mir_ctx_bind_var(binding, binding_slot)
          ctx.mir_emit_store_var(binding, result_val)
        end
      end

      # C.13 Phase 4a: For user-defined Selectable arms, extract the
      # payload from the Some(payload) option, free the option, then
      # call `<Struct>$complete(self)` for its destructive side effects
      # (channel pop, future await, scope-cancel throw). complete's
      # return value is DISCARDED in v1 — the user's binding is set
      # from the option's payload, which gives the right semantics for
      # impls where try_poll is destructive (RecvSelectable v1 stores
      # the popped value in the Some payload). The binding thus matches
      # what the user expected to receive. `self` was stashed in the
      # per-arm `__sel_self_<i>` slot during the entry-block hoist
      # (Phase 4b). All Selectable wakers were already unregistered in
      # the body prologue above before complete runs — so a throwing
      # complete (ScopeCancel / Deadline) unwinds cleanly with no
      # leaked waker registrations.
      if op_kind == 5
        var sel_load_opt = ctx.mir_emit_load_var(result_name)
        var sel_get_args = vec_new()
        sel_get_args.push(sel_load_opt)
        var sel_value = ctx.mir_emit_intrinsic("option_get", sel_get_args)
        ctx.mir_emit_intrinsic("option_free", [sel_load_opt])
        var sel_struct = ast::ast_select_arm_struct(s, arm)
        var sel_self_name = "__sel_self_#{i}"
        var sel_self = ctx.mir_emit_load_var(sel_self_name)
        var cp_fn = string_intern::mangle(sel_struct, "complete")
        var cp_args = vec_new()
        cp_args.push(sel_self)
        mir_emit_call(ctx, cp_fn, cp_args)
        ctx.mir_emit_store_var(result_name, sel_value)
        var sel_binding = ast::ast_get_str1(s, arm)
        if str_byte_len(sel_binding) > 0
          # Register the arm binding FIRST so the body resolves it via
          # mir_ctx_lookup_var instead of a same-named free function
          # (Selectable-arm guise of the 30d37c96 shadow miscompile).
          var sel_binding_slot = ctx.mir_ctx_alloc_slot()
          ctx.mir_ctx_bind_var(sel_binding, sel_binding_slot)
          ctx.mir_emit_store_var(sel_binding, sel_value)
        end
      end

      # Lower body expression
      var body_val = ctx.mir_lower_block_expr(s, body_node)
      ctx.mir_emit_store_var(result_name, body_val)

      # Jump to done
      var body_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(body_cur) < 0
        mir_block_set_terminator(body_cur, mir::TERM_JUMP, done_block)
      end
    end

    # Done block: free permutation vec (if allocated), load and return result
    ctx.mir_switch_to_block(done_block)
    if use_fairness
      var done_perm = ctx.mir_emit_load_var(perm_name)
      ctx.mir_emit_intrinsic("vec_free", [done_perm])
    end
    return ctx.mir_emit_load_var(result_name)
  end

  return 0
end

def mir_lower_collection(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)

  # NodeListComp = 46 - [expr for var in iter if cond]
  # Desugar to: result = vec_new(); loop over iter { if cond { vec_push(result, expr) } }; result
  if kind == node_constants::NODE_LIST_COMP
    var expr_node = ast::ast_get_left(s, node)
    var var_name = ast::ast_get_str1(s, node)
    var iter_node = ast::ast_get_right(s, node)
    var cond_node = ast::ast_get_extra(s, node)

    var line = ast::ast_get_line(s, node)
    var col = ast::ast_get_col(s, node)

    # Check if iterator is a Range (NodeBinary with OP_RANGE/OP_RANGE_INCLUSIVE)
    var iter_kind = ast::ast_get_kind(s, iter_node)
    var is_range = false
    if iter_kind == node_constants::NODE_BINARY
      var op = ast::ast_get_op(s, iter_node)
      if op == op_constants::OP_RANGE or op == op_constants::OP_RANGE_INCLUSIVE
        is_range = true
      end
    end

    # result = vec_new()
    var result_slot = ctx.mir_ctx_alloc_slot()
    var result_name = gen_temp_name_with_ctx(ctx, "list_result")
    ctx.mir_ctx_bind_var(result_name, result_slot)
    var vec_args = vec_new()
    var result_vec = ctx.mir_emit_intrinsic("vec_new", vec_args)
    ctx.mir_emit_store_var(result_name, result_vec)

    # Allocate slot for loop variable
    var var_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(var_name, var_slot)

    # Pre-declare idx/iter names for vec path
    var idx_name = gen_temp_name_with_ctx(ctx, "list_idx")
    var iter_name = gen_temp_name_with_ctx(ctx, "list_iter")

    # Create blocks
    var cond_block = ctx.mir_create_block("listcomp_cond")
    var body_block = ctx.mir_create_block("listcomp_body")
    var push_block = ctx.mir_create_block("listcomp_push")
    var incr_block = ctx.mir_create_block("listcomp_incr")
    var exit_block = ctx.mir_create_block("listcomp_exit")

    # Extract step (before if is_range so vars are accessible in increment block)
    var lc_step_node = ast::ast_get_int_val(s, node)
    var lc_step_val = 0
    var lc_step_is_const = false
    var lc_step_const_val = 1

    if is_range
      # Range iteration: for var in start..end [step S]
      var start_node = ast::ast_get_left(s, iter_node)
      var end_node = ast::ast_get_right(s, iter_node)
      var start_val = mir_lower::mir_lower_expr(ctx, s, start_node)
      var end_val = mir_lower::mir_lower_expr(ctx, s, end_node)

      if lc_step_node > 0
        lc_step_val = mir_lower::mir_lower_expr(ctx, s, lc_step_node)
        lc_step_is_const = mir_lower::mir_is_const_step(s, lc_step_node)
        if lc_step_is_const
          lc_step_const_val = mir_lower::mir_get_const_step_val(s, lc_step_node)
        end
      end

      # Initialize loop variable to start
      ctx.mir_emit_store_var(var_name, start_val)

      # Jump to condition
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

      # Condition: direction-aware based on step
      ctx.mir_switch_to_block(cond_block)
      var i_val = ctx.mir_emit_load_var(var_name)
      var range_op = ast::ast_get_op(s, iter_node)
      mir_lower::mir_emit_range_step_cond(ctx, s, i_val, end_val, range_op, lc_step_node, lc_step_val, lc_step_is_const, lc_step_const_val, body_block, exit_block, cond_block)

      # Body: var is already the loop variable
      ctx.mir_switch_to_block(body_block)
    else
      # Vec iteration: for var in vec
      var iter_val = mir_lower::mir_lower_expr(ctx, s, iter_node)
      var iter_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(iter_name, iter_slot)
      ctx.mir_emit_store_var(iter_name, iter_val)

      # idx = 0
      var idx_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(idx_name, idx_slot)
      var zero = ctx.mir_emit_const_int(0)
      ctx.mir_emit_store_var(idx_name, zero)

      # Jump to condition
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

      # Condition: idx < vec_size(iter)
      ctx.mir_switch_to_block(cond_block)
      var idx_val = ctx.mir_emit_load_var(idx_name)
      var iter_load = ctx.mir_emit_load_var(iter_name)
      var len_args = vec_new()
      len_args.push(iter_load)
      var len_val = ctx.mir_emit_intrinsic("vec_size", len_args)
      var cmp_val = ctx.mir_emit_binary(op_constants::OP_LT, idx_val, len_val)
      mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)

      # Body: var = iter[idx]
      ctx.mir_switch_to_block(body_block)
      var idx_load = ctx.mir_emit_load_var(idx_name)
      var iter_load2 = ctx.mir_emit_load_var(iter_name)
      var get_args = vec_new()
      get_args.push(iter_load2)
      get_args.push(idx_load)
      var elem_val = ctx.mir_emit_intrinsic("vec_get", get_args)
      ctx.mir_emit_store_var(var_name, elem_val)
    end

    # If condition exists, check it
    if cond_node > 0
      var cond_val = mir_lower::mir_lower_expr(ctx, s, cond_node)
      var body_cur = ctx.mir_ctx_get_block()
      mir_block_set_branch(body_cur, cond_val, push_block, incr_block)
    else
      var body_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(body_cur, mir::TERM_JUMP, push_block)
    end

    # Push block: vec_push(result, expr)
    ctx.mir_switch_to_block(push_block)
    var expr_val = mir_lower::mir_lower_expr(ctx, s, expr_node)
    var result_load = ctx.mir_emit_load_var(result_name)
    var push_args = vec_new()
    push_args.push(result_load)
    push_args.push(expr_val)
    ctx.mir_emit_intrinsic("vec_push", push_args)
    var push_cur = ctx.mir_ctx_get_block()
    mir_block_set_terminator(push_cur, mir::TERM_JUMP, incr_block)

    # Incr block
    ctx.mir_switch_to_block(incr_block)
    if is_range
      # Range: var += step (or 1 if no step)
      var var_cur = ctx.mir_emit_load_var(var_name)
      if lc_step_node > 0
        var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, lc_step_val)
        ctx.mir_emit_store_var(var_name, var_next)
      else
        var one = ctx.mir_emit_const_int(1)
        var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, one)
        ctx.mir_emit_store_var(var_name, var_next)
      end
    else
      # Vec: idx += 1
      var idx_cur = ctx.mir_emit_load_var(idx_name)
      var one = ctx.mir_emit_const_int(1)
      var idx_next = ctx.mir_emit_binary(op_constants::OP_ADD, idx_cur, one)
      ctx.mir_emit_store_var(idx_name, idx_next)
    end
    mir_block_set_terminator(incr_block, mir::TERM_JUMP, cond_block)

    # Exit: return result
    ctx.mir_switch_to_block(exit_block)
    return ctx.mir_emit_load_var(result_name)
  end

  # NodeSetComp = 48 - {expr for var in iter if cond}
  # Desugar to: result = set_new(); loop over iter { if cond { set_add(result, expr) } }; result
  if kind == node_constants::NODE_SET_COMP
    var expr_node = ast::ast_get_left(s, node)
    var var_name = ast::ast_get_str1(s, node)
    var iter_node = ast::ast_get_right(s, node)
    var cond_node = ast::ast_get_extra(s, node)

    var line = ast::ast_get_line(s, node)
    var col = ast::ast_get_col(s, node)

    # Check if iterator is a Range
    var iter_kind = ast::ast_get_kind(s, iter_node)
    var is_range = false
    if iter_kind == node_constants::NODE_BINARY
      var op = ast::ast_get_op(s, iter_node)
      if op == op_constants::OP_RANGE or op == op_constants::OP_RANGE_INCLUSIVE
        is_range = true
      end
    end

    # result = set_new()
    var result_slot = ctx.mir_ctx_alloc_slot()
    var result_name = gen_temp_name_with_ctx(ctx, "set_result")
    ctx.mir_ctx_bind_var(result_name, result_slot)
    var set_args = vec_new()
    var result_set = ctx.mir_emit_intrinsic("set_new", set_args)
    ctx.mir_emit_store_var(result_name, result_set)

    # Allocate slot for loop variable
    var var_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(var_name, var_slot)

    # Pre-declare idx/iter names for vec path
    var idx_name = gen_temp_name_with_ctx(ctx, "set_idx")
    var iter_name = gen_temp_name_with_ctx(ctx, "set_iter")

    # Create blocks
    var cond_block = ctx.mir_create_block("setcomp_cond")
    var body_block = ctx.mir_create_block("setcomp_body")
    var add_block = ctx.mir_create_block("setcomp_add")
    var incr_block = ctx.mir_create_block("setcomp_incr")
    var exit_block = ctx.mir_create_block("setcomp_exit")

    # Extract step (before if is_range so vars are accessible in increment block)
    var sc_step_node = ast::ast_get_int_val(s, node)
    var sc_step_val = 0
    var sc_step_is_const = false
    var sc_step_const_val = 1

    if is_range
      # Range iteration: for var in start..end [step S]
      var start_node = ast::ast_get_left(s, iter_node)
      var end_node = ast::ast_get_right(s, iter_node)
      var start_val = mir_lower::mir_lower_expr(ctx, s, start_node)
      var end_val = mir_lower::mir_lower_expr(ctx, s, end_node)

      if sc_step_node > 0
        sc_step_val = mir_lower::mir_lower_expr(ctx, s, sc_step_node)
        sc_step_is_const = mir_lower::mir_is_const_step(s, sc_step_node)
        if sc_step_is_const
          sc_step_const_val = mir_lower::mir_get_const_step_val(s, sc_step_node)
        end
      end

      # Initialize loop variable to start
      ctx.mir_emit_store_var(var_name, start_val)

      # Jump to condition
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

      # Condition: direction-aware based on step
      ctx.mir_switch_to_block(cond_block)
      var i_val = ctx.mir_emit_load_var(var_name)
      var range_op = ast::ast_get_op(s, iter_node)
      mir_lower::mir_emit_range_step_cond(ctx, s, i_val, end_val, range_op, sc_step_node, sc_step_val, sc_step_is_const, sc_step_const_val, body_block, exit_block, cond_block)

      # Body: var is already the loop variable
      ctx.mir_switch_to_block(body_block)
    else
      # Vec iteration: for var in vec
      var iter_val = mir_lower::mir_lower_expr(ctx, s, iter_node)
      var iter_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(iter_name, iter_slot)
      ctx.mir_emit_store_var(iter_name, iter_val)

      # idx = 0
      var idx_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(idx_name, idx_slot)
      var zero = ctx.mir_emit_const_int(0)
      ctx.mir_emit_store_var(idx_name, zero)

      # Jump to condition
      var cur_block = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

      # Condition: idx < vec_size(iter)
      ctx.mir_switch_to_block(cond_block)
      var idx_val = ctx.mir_emit_load_var(idx_name)
      var iter_load = ctx.mir_emit_load_var(iter_name)
      var len_args = vec_new()
      len_args.push(iter_load)
      var len_val = ctx.mir_emit_intrinsic("vec_size", len_args)
      var cmp_val = ctx.mir_emit_binary(op_constants::OP_LT, idx_val, len_val)
      mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)

      # Body: var = iter[idx]
      ctx.mir_switch_to_block(body_block)
      var idx_load = ctx.mir_emit_load_var(idx_name)
      var iter_load2 = ctx.mir_emit_load_var(iter_name)
      var get_args = vec_new()
      get_args.push(iter_load2)
      get_args.push(idx_load)
      var elem_val = ctx.mir_emit_intrinsic("vec_get", get_args)
      ctx.mir_emit_store_var(var_name, elem_val)
    end

    # If condition exists, check it
    if cond_node > 0
      var cond_val = mir_lower::mir_lower_expr(ctx, s, cond_node)
      var body_cur = ctx.mir_ctx_get_block()
      mir_block_set_branch(body_cur, cond_val, add_block, incr_block)
    else
      var body_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(body_cur, mir::TERM_JUMP, add_block)
    end

    # Add block: set_add(result, expr)
    ctx.mir_switch_to_block(add_block)
    var expr_val = mir_lower::mir_lower_expr(ctx, s, expr_node)
    var result_load = ctx.mir_emit_load_var(result_name)
    var add_args = vec_new()
    add_args.push(result_load)
    add_args.push(expr_val)
    ctx.mir_emit_intrinsic("set_add", add_args)
    var add_cur = ctx.mir_ctx_get_block()
    mir_block_set_terminator(add_cur, mir::TERM_JUMP, incr_block)

    # Incr block
    ctx.mir_switch_to_block(incr_block)
    if is_range
      # Range: var += step (or 1 if no step)
      var var_cur = ctx.mir_emit_load_var(var_name)
      if sc_step_node > 0
        var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, sc_step_val)
        ctx.mir_emit_store_var(var_name, var_next)
      else
        var one = ctx.mir_emit_const_int(1)
        var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, one)
        ctx.mir_emit_store_var(var_name, var_next)
      end
    else
      # Vec: idx += 1
      var idx_cur = ctx.mir_emit_load_var(idx_name)
      var one = ctx.mir_emit_const_int(1)
      var idx_next = ctx.mir_emit_binary(op_constants::OP_ADD, idx_cur, one)
      ctx.mir_emit_store_var(idx_name, idx_next)
    end
    mir_block_set_terminator(incr_block, mir::TERM_JUMP, cond_block)

    # Exit: return result
    ctx.mir_switch_to_block(exit_block)
    return ctx.mir_emit_load_var(result_name)
  end

  return 0
end


def mir_lower_map_comp(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var key_expr_node = ast::ast_get_left(s, node)
  var val_expr_node = ast::ast_get_right(s, node)
  var var_name = ast::ast_get_str1(s, node)
  var iter_node = ast::ast_get_extra(s, node)
  var cond_vec = ast::ast_get_children(s, node)

  # Check if iterator is a Range (NodeBinary with op_constants$OP_RANGE/op_constants$OP_RANGE_INCLUSIVE)
  var iter_kind = ast::ast_get_kind(s, iter_node)
  var is_range = false
  if iter_kind == node_constants::NODE_BINARY
    var op = ast::ast_get_op(s, iter_node)
    if op == op_constants::OP_RANGE or op == op_constants::OP_RANGE_INCLUSIVE
      is_range = true
    end
  end

  # result = map_new()
  var result_slot = ctx.mir_ctx_alloc_slot()
  var result_name = gen_temp_name_with_ctx(ctx, "map_result")
  ctx.mir_ctx_bind_var(result_name, result_slot)
  var result_map = ctx.mir_emit_intrinsic_typed("map_new", vec_new(), "Int")
  ctx.mir_emit_store_var(result_name, result_map)

  # Allocate slot for loop variable
  var var_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(var_name, var_slot)

  # Pre-declare idx/iter names for vec path (needed in incr block outside if/else)
  var idx_name = gen_temp_name_with_ctx(ctx, "map_idx")
  var iter_name = gen_temp_name_with_ctx(ctx, "map_iter")

  # Create blocks
  var cond_block = ctx.mir_create_block("mapcomp_cond")
  var body_block = ctx.mir_create_block("mapcomp_body")
  var put_block = ctx.mir_create_block("mapcomp_put")
  var incr_block = ctx.mir_create_block("mapcomp_incr")
  var exit_block = ctx.mir_create_block("mapcomp_exit")

  # Extract step for map comprehension
  var mc_step_node = ast::ast_get_int_val(s, node)
  var mc_step_val = 0
  var mc_step_is_const = false
  var mc_step_const_val = 1
  if mc_step_node > 0
    mc_step_val = mir_lower::mir_lower_expr(ctx, s, mc_step_node)
    mc_step_is_const = mir_lower::mir_is_const_step(s, mc_step_node)
    if mc_step_is_const
      mc_step_const_val = mir_lower::mir_get_const_step_val(s, mc_step_node)
    end
  end

  if is_range
    # Range iteration: for var in start..end [step S]
    var start_node = ast::ast_get_left(s, iter_node)
    var end_node = ast::ast_get_right(s, iter_node)
    var start_val = mir_lower::mir_lower_expr(ctx, s, start_node)
    var end_val = mir_lower::mir_lower_expr(ctx, s, end_node)

    # Initialize loop variable to start
    ctx.mir_emit_store_var(var_name, start_val)

    # Jump to condition
    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

    # Condition: direction-aware based on step
    ctx.mir_switch_to_block(cond_block)
    var i_val = ctx.mir_emit_load_var(var_name)
    var range_op = ast::ast_get_op(s, iter_node)
    mir_lower::mir_emit_range_step_cond(ctx, s, i_val, end_val, range_op, mc_step_node, mc_step_val, mc_step_is_const, mc_step_const_val, body_block, exit_block, cond_block)

    # Body: var is already the loop variable (no vec_get needed)
    ctx.mir_switch_to_block(body_block)
  else
    # Vec iteration: for var in vec

    # iter = lower(iter_node)
    var iter_val = mir_lower::mir_lower_expr(ctx, s, iter_node)
    var iter_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(iter_name, iter_slot)
    ctx.mir_emit_store_var(iter_name, iter_val)

    # idx = 0
    var idx_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(idx_name, idx_slot)
    var zero = ctx.mir_emit_const_int(0)
    ctx.mir_emit_store_var(idx_name, zero)

    # Jump to condition
    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_terminator(cur_block, mir::TERM_JUMP, cond_block)

    # Condition: idx < vec_size(iter)
    ctx.mir_switch_to_block(cond_block)
    var idx_val = ctx.mir_emit_load_var(idx_name)
    var iter_load = ctx.mir_emit_load_var(iter_name)
    var len_args = vec_new()
    len_args.push(iter_load)
    var len_val = ctx.mir_emit_intrinsic("vec_size", len_args)
    var cmp_val = ctx.mir_emit_binary(op_constants::OP_LT, idx_val, len_val)
    mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)

    # Body: var = iter[idx]
    ctx.mir_switch_to_block(body_block)
    var idx_load = ctx.mir_emit_load_var(idx_name)
    var iter_load2 = ctx.mir_emit_load_var(iter_name)
    var get_args = vec_new()
    get_args.push(iter_load2)
    get_args.push(idx_load)
    var elem_val = ctx.mir_emit_intrinsic("vec_get", get_args)
    ctx.mir_emit_store_var(var_name, elem_val)
  end

  # If condition exists, check it
  if vec_size(cond_vec) > 0
    var cond_node = cond_vec[0]
    var cond_val = mir_lower::mir_lower_expr(ctx, s, cond_node)
    var body_cur = ctx.mir_ctx_get_block()
    mir_block_set_branch(body_cur, cond_val, put_block, incr_block)
  else
    var body_cur = ctx.mir_ctx_get_block()
    mir_block_set_terminator(body_cur, mir::TERM_JUMP, put_block)
  end

  # Put block: map_set(result, key, val)
  ctx.mir_switch_to_block(put_block)
  var key_val = mir_lower::mir_lower_expr(ctx, s, key_expr_node)
  var val_val = mir_lower::mir_lower_expr(ctx, s, val_expr_node)
  var result_load = ctx.mir_emit_load_var(result_name)
  var set_args = vec_new()
  set_args.push(result_load)
  set_args.push(key_val)
  set_args.push(val_val)
  ctx.mir_emit_intrinsic_typed("map_set", set_args, "Int")
  var put_cur = ctx.mir_ctx_get_block()
  mir_block_set_terminator(put_cur, mir::TERM_JUMP, incr_block)

  # Incr block
  ctx.mir_switch_to_block(incr_block)
  if is_range
    # Range: var += step (or 1 if no step)
    var var_cur = ctx.mir_emit_load_var(var_name)
    if mc_step_node > 0
      var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, mc_step_val)
      ctx.mir_emit_store_var(var_name, var_next)
    else
      var one = ctx.mir_emit_const_int(1)
      var var_next = ctx.mir_emit_binary(op_constants::OP_ADD, var_cur, one)
      ctx.mir_emit_store_var(var_name, var_next)
    end
  else
    # Vec: idx += 1
    var idx_cur = ctx.mir_emit_load_var(idx_name)
    var one = ctx.mir_emit_const_int(1)
    var idx_next = ctx.mir_emit_binary(op_constants::OP_ADD, idx_cur, one)
    ctx.mir_emit_store_var(idx_name, idx_next)
  end
  mir_block_set_terminator(incr_block, mir::TERM_JUMP, cond_block)

  # Exit: return result
  ctx.mir_switch_to_block(exit_block)
  return ctx.mir_emit_load_var(result_name)
end
