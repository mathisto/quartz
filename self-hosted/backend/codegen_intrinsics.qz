##! # Codegen Intrinsics
##!
##! Emits LLVM IR for all Quartz built-in intrinsic functions.
##! Uses shared registry for O(1) name→category dispatch, then per-category handler.
##!
##! Category constants and name registration in intrinsic_registry.qz (single source of truth).

import mir
import codegen_util
import cg_intrinsic_simd
import cg_intrinsic_collection
import cg_intrinsic_concurrency
import cg_intrinsic_memory
import cg_intrinsic_data
import cg_intrinsic_intmap
import cg_intrinsic_set
import cg_intrinsic_string
import cg_intrinsic_regex
import cg_intrinsic_sb
import cg_intrinsic_core
import cg_intrinsic_io
import cg_intrinsic_math
import cg_intrinsic_misc
import cg_intrinsic_system
import cg_intrinsic_vec
import cg_intrinsic_map
import intrinsic_registry
import codegen_ctx
import * from str_compat

## Set the target for intrinsic code generation (delegates to codegen_util).
def cg_intrinsics_set_target(target: String): Void
  codegen_util::cg_set_target_mmap_flags(target)
end

## Emit an intrinsic function call.
## Uses shared registry for O(1) name→category resolution, then per-category handler.
def cg_emit_intrinsic(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr): Void can Emit
  # Sync the cg_ctx slot to the active `out` so any helper inside a
  # per-category handler that routes through the `Emit` effect (e.g.
  # `cg_emit_inttoptr`, `cg_emit_inttoptr_is`, used in panic / vec_slice /
  # str_*) writes to the same sink as the surrounding `cg_emit(out, ...)`
  # calls. Without this, the slot retains whatever the last
  # `cg_ctx_set` call wrote — which can be a different module's buffer
  # under separate compilation, causing IR lines to leak into the wrong
  # function. Diagnosed Apr 24 2026 while landing Phase 4.B.5; the
  # underlying mismatch pre-dated this work.
  codegen_ctx::cg_ctx_set(out)
  var dest = mir::mir_instr_get_dest_id(instr)
  var name = mir::mir_instr_get_func_name(instr)
  var args = mir::mir_instr_get_args(instr)
  var argc = args.size
  var d = dest.to_s()
  var _elem_slot = mir::mir_instr_get_slot2(instr)
  var _elem_type = ""
  if _elem_slot != 0
    _elem_type = as_string(_elem_slot)
  end

  # O(1) category lookup from shared registry
  var category = intrinsic_registry::get_intrinsic_category(name)

  if category == intrinsic_registry::INTRINSIC_CAT_COLLECTION
    cg_intrinsic_collection::cg_emit_intrinsic_collection(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_CONCURRENCY
    cg_intrinsic_concurrency::cg_emit_intrinsic_concurrency(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_CONVERSION
    cg_intrinsic_core::cg_emit_intrinsic_conversion(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MAP_STR
    cg_intrinsic_data::cg_emit_map_str_key(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MAP_INT
    cg_intrinsic_intmap::cg_emit_map_int_key(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_IO
    cg_intrinsic_io::cg_emit_intrinsic_io(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MATH
    cg_intrinsic_math::cg_emit_intrinsic_math(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MEMORY
    cg_intrinsic_memory::cg_emit_intrinsic_memory(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MISC
    cg_intrinsic_misc::cg_emit_intrinsic_misc(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_REGEX
    cg_intrinsic_regex::cg_emit_intrinsic_regex(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_SB
    cg_intrinsic_sb::cg_emit_intrinsic_sb(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_SET
    cg_intrinsic_set::cg_emit_intrinsic_set(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_SIMD
    cg_intrinsic_simd::cg_emit_intrinsic_simd(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_STRING
    cg_intrinsic_string::cg_emit_intrinsic_string(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_SYSTEM
    cg_intrinsic_system::cg_emit_intrinsic_system(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_VEC
    cg_intrinsic_vec::cg_emit_intrinsic_vec(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  if category == intrinsic_registry::INTRINSIC_CAT_MAP
    cg_intrinsic_map::cg_emit_intrinsic_map(state, out, prog, instr, dest, name, args, argc, d, _elem_type)
    return
  end

  # Default: unknown intrinsic = user-defined function not in registry.
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, " = call i64 @")
  codegen_util::cg_emit(out, codegen_util::cg_sanitize_llvm_name(name))
  codegen_util::cg_emit(out, "(")
  for i in 0..args.size
    if i > 0
      codegen_util::cg_emit(out, ", ")
    end
    codegen_util::cg_emit(out, "i64 %v")
    codegen_util::cg_emit(out, args[i].to_s())
  end
  codegen_util::cg_emit_line(out, ")")
end
