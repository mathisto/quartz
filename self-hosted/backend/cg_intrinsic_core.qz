##! # Conversion Intrinsics
##!
##! Emits LLVM IR for type conversion and cast operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import elem_width
import * from str_compat

# ============================================================================
# Conversion Intrinsics (42 handlers)
# ============================================================================

## Emit an identity conversion: %vD = add i64 %vARG, 0
def _cg_emit_identity_conversion(out: Int, d: String, arg_id: Int): Void
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, " = add i64 %v")
  codegen_util::cg_emit_int(out, arg_id)
  codegen_util::cg_emit_line(out, ", 0")
end

def cg_emit_intrinsic_conversion(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "as_int"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "as_int_generic"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  # as_f64: bit-faithful Int->F64 reinterpret. An F64 value is stored as
  # the i64 bit pattern of the double, so reinterpreting raw bits as a
  # double is an identity at this representation — no sitofp.
  if name == "as_f64"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "as_type"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "as_string"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "as_vec"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "fn_to_int"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "cptr_to_int"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "int_to_cptr"
    _cg_emit_identity_conversion(out, d, args[0])
    return
  end

  if name == "to_int"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = fptosi double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f to i64")
    return
  end

  if name == "to_f64"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = sitofp i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f to i64")
    return
  end

  if name == "to_f32"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d = sitofp i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f32 = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f64 = fpext float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f32 to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f64 to i64")
    return
  end

  if name == "f64_to_f32"
    # Truncate an F64 value (double-bits-in-i64) to F32 precision, kept as
    # fpext'd double-bits-in-i64. Used by the `var x: F32 = <float>` init
    # truncation wrap — must NOT sitofp (the operand is already a float).
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d = bitcast i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f32 = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f64 = fpext float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f32 to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f64 to i64")
    return
  end

  if name == "Int$to_f64"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = sitofp i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f to i64")
    return
  end

  if name == "Int$to_f32"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = sitofp i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f32 = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f64 = fpext float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f32 to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f64 to i64")
    return
  end

  if name == "Bool$to_s"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_bool_to_str(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "Int$to_s"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @str_from_int(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "F64$to_i"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = fptosi double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f to i64")
    return
  end

  if name == "F64$to_s"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @f64_to_str(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "to_i8"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_i16"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_i32"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_u8"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_u16"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_u32"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc to i64")
    return
  end

  if name == "to_u64"
    # u64 same width as i64 — identity
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, ", 0")
    return
  end

  if name == "f64_sqrt"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call double @llvm.sqrt.f64(double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "f64_sin"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call double @llvm.sin.f64(double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "f64_cos"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call double @llvm.cos.f64(double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "f64_floor"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call double @llvm.floor.f64(double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "f64_ceil"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f = bitcast i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call double @llvm.ceil.f64(double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f)")
