##! # Memory Intrinsics
##!
##! Emits LLVM IR for memory management operations (alloc, free, copy, move, borrow, refcount).
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# Memory Intrinsics (53 handlers)
# ============================================================================

def cg_emit_intrinsic_memory(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  # mem_forget is a no-op at codegen level (handled at MIR lowering)
  if name == "mem_forget"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "mem_alloc"
    var n = args[0]
    # A.3.c — single funnel through @__qz_alloc(bytes). The wrapper
    # (emitted in codegen_runtime.qz) handles the watermark fast-path,
    # bypass-during-handler check, and via_eff routing internally;
    # intrinsic codegen no longer branches itself. The wrapper checks
    # @__qz_alloc_in_handler and either bypasses to malloc or routes
    # through perform.
    #
    # A.3.c byte-semantics: `mem_alloc(N)` now allocates N BYTES (not
    # N slots × 8). Aligns with malloc's universal convention. Pre-A.3.c
    # the `mul N, 8` here over-allocated 8× for callers that were
    # passing byte counts (terminal.qz:122 `mem_alloc(1)` for a 1-byte
    # read buffer, KEVENT_SIZE() callers, etc.) — every existing call
    # site audited was passing bytes, so the slot semantics was a
    # silent footgun. The user-visible effect op `alloc(size: Int)`
    # now also means `size` bytes (alloc specs converted in lockstep).
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit_int(out, n)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.ptr", "ptr")
    return
  end

  if name == "load"
    var ptr = args[0]
    var off = args[1]
    # Convert ptr to i64*
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    # Offset
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".addr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, "")
    # Race detector: instrument read before user load
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_read8(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".addr)")
    end
    # Load
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".addr")
    return
  end

  if name == "store"
    var ptr = args[0]
    var off = args[1]
    var val = args[2]
    # Convert ptr to i64*
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    # Offset
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".addr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, "")
    # Race detector: instrument write before user store
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_write8(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".addr)")
    end
    # Store
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".addr")
    # Return 0
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "ptr_add"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %v")
    codegen_util::cg_emit_int(out, args[0])
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_int(out, args[1])
    codegen_util::cg_emit_line(out, "")
    return
  end

  if name == "ptr_cast"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 0, %v")
    codegen_util::cg_emit_int(out, args[0])
    codegen_util::cg_emit_line(out, "")
    return
  end

  if name == "field_offset"
    var fidx_reg = args[0]
    var sname_reg = args[1]
    # Resolve both constants from MIR block
    var fidx_val = codegen_util::cg_resolve_const_int(state, fidx_reg)
    var sname_val = codegen_util::cg_resolve_const_int(state, sname_reg)
    var sname = as_string(sname_val)
    # LLVM GEP-null trick: ptrtoint (getelementptr %struct.Name, ptr null, i32 0, i32 N) to i64
    codegen_util::cg_emit(out, "  %fo_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gep = getelementptr %struct.")
    codegen_util::cg_emit(out, sname)
    codegen_util::cg_emit(out, ", %struct.")
    codegen_util::cg_emit(out, sname)
    codegen_util::cg_emit(out, "* null, i32 0, i32 ")
    codegen_util::cg_emit_int(out, fidx_val)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %fo_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".gep to i64")
    return
  end

  if name == "ptr_read"
    var ptr = args[0]
    # size_arg is args[1], fc_arg is args[2] - not directly used at codegen level
    # Just load the first word (works for primitives and returns pointer-to-struct)
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    return
  end

  if name == "ptr_write"
    var ptr = args[0]
    var val = args[1]
    # size_arg is args[2], fc_arg is args[3] - not directly used at codegen level
    # Just store the value (works for primitives and struct pointers)
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "volatile_load"
    var ptr = args[0]
    var type_size = mir::mir_instr_get_slot1(instr)
    if type_size == 1
      codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".narrow = load volatile i8, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = zext i8 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".narrow to i64")
    else
      if type_size == 2
        codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "i16*")
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".narrow = load volatile i16, i16* %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".ptr")
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, " = zext i16 %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".narrow to i64")
      else
        if type_size == 4
          codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "i32*")
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".narrow = load volatile i32, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ptr")
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, " = zext i32 %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".narrow to i64")
        else
          codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, " = load volatile i64, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ptr")
        end
      end
    end
    return
  end

  if name == "volatile_store"
    var ptr = args[0]
    var val = args[1]
    var type_size = mir::mir_instr_get_slot1(instr)
    if type_size == 1
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val = trunc i64 %v")
      codegen_util::cg_emit_int(out, val)
      codegen_util::cg_emit_line(out, " to i8")
      codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
      codegen_util::cg_emit(out, "  store volatile i8 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr")
    else
      if type_size == 2
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".val = trunc i64 %v")
        codegen_util::cg_emit_int(out, val)
        codegen_util::cg_emit_line(out, " to i16")
        codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "i16*")
        codegen_util::cg_emit(out, "  store volatile i16 %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".val, i16* %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".ptr")
      else
        if type_size == 4
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".val = trunc i64 %v")
          codegen_util::cg_emit_int(out, val)
          codegen_util::cg_emit_line(out, " to i32")
          codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "i32*")
          codegen_util::cg_emit(out, "  store volatile i32 %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".val, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ptr")
        else
          codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
          codegen_util::cg_emit(out, "  store volatile i64 %v")
          codegen_util::cg_emit_int(out, val)
          codegen_util::cg_emit(out, ", ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ptr")
        end
      end
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # ============================================================
  # K8.4 atomic primitives — emit LLVM atomic ops (seq_cst).
  # ============================================================
  # On x86_64 these compile to:
  #   atomic_load_u64  → plain MOV (TSO already gives load-acquire)
  #   atomic_store_u64 → MOV + MFENCE (or XCHG; LLVM picks)
  #   atomic_cas_u64   → LOCK CMPXCHG
  # 8-byte alignment is required by the LLVM atomic ops; callers are
  # expected to use heap-allocated u64 slots (qz_malloc(8)) or
  # naturally-aligned globals. Misaligned access on x86 is undefined
  # at the atomic level (split locks at best, #AC trap at worst).

  if name == "atomic_load_u64"
    var ptr = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load atomic i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr seq_cst, align 8")
    return
  end

  if name == "atomic_store_u64"
    var ptr = args[0]
    var val = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  store atomic i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "atomic_cas_u64"
    var ptr = args[0]
    var expect = args[1]
    var new_val = args[2]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    # cmpxchg returns { i64, i1 } — { current, success }. We only
    # surface the success bit; callers wanting CAS-failure-then-retry
    # spin on the boolean.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cas = cmpxchg ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, expect)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, new_val)
    codegen_util::cg_emit_line(out, " seq_cst seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = extractvalue { i64, i1 } %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cas, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ok to i64")
    return
  end

  # ============================================================
  # C1 (value-types-finish §14.12.8) — COW refcount atomics.
  # The arg is an i64 handle pointing at the COW buffer header word
  # (refcount, i64, offset 0). Reuse the exact atomicrmw + seq_cst idiom
  # from waitgroup_done (cg_intrinsic_conc_sync.qz:665-667). 8-byte aligned
  # by malloc; atomic because COW values cross task/$poll boundaries.
  # ============================================================
  if name == "cow_rc_inc"
    # atomicrmw add 1 — retain. Prior value computed but unused (Void result).
    var ptr = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".old = atomicrmw add ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr, i64 1 seq_cst")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "cow_rc_dec"
    # atomicrmw sub 1 — release. Returns the PRIOR refcount so the caller can
    # test ==1 ⇒ this was the last reference ⇒ run nested drops + free.
    var ptr = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw sub ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr, i64 1 seq_cst")
    return
  end

  if name == "ptr_write_byte"
    var ptr = args[0]
    var byte = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte = trunc i64 %v")
    codegen_util::cg_emit_int(out, byte)
    codegen_util::cg_emit_line(out, " to i8")
    codegen_util::cg_emit(out, "  store i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "ptr_read_byte"
    var ptr = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte to i64")
    return
  end

  if name == "qz_malloc"
    var size = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit_int(out, size)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr to i64")
    return
  end

  if name == "ptr_alloc"
    var count = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bytes = mul i64 %v")
    codegen_util::cg_emit_int(out, count)
    codegen_util::cg_emit_line(out, ", 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bytes)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr to i64")
    return
  end

  if name == "qz_free"
    var ptr = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", ptr, "ptr")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "bump_new"
    var cap = args[0]
    # Total size = 16 (header) + capacity
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".total = add i64 %v")
    codegen_util::cg_emit_int(out, cap)
    codegen_util::cg_emit_line(out, ", 16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".raw = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".total)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw to ptr")
    # Store capacity at slot 0
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, cap)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    # Store offset=0 at slot 1
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    # Return pointer as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.raw", "ptr")
    return
  end

  if name == "bump_alloc"
    var bmp = args[0]
    var sz = args[1]
    # Align size to 8 bytes
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sz8 = add i64 %v")
    codegen_util::cg_emit_int(out, sz)
    codegen_util::cg_emit_line(out, ", 7")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".aligned = and i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sz8, -8")
    # Load current offset
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, bmp)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    # Result = base + 16 (skip header) + offset
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".base = add i64 %v")
    codegen_util::cg_emit_int(out, bmp)
    codegen_util::cg_emit_line(out, ", 16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".base, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    # Bump offset
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newoff = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".aligned")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newoff, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    return
  end

  if name == "bump_reset"
    var bmp = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, bmp)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "bump_free"
    var bmp = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, bmp)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "arena_new"
    # Arena header: 48 bytes via malloc (6 fields: capacity, offset, data, next, alloc_count, last_fit)
    # Data blocks: via mmap (returns pages to OS on arena_destroy via munmap)
    #
    # Phase D.x — block size bumped 4 KB → 64 KB to reduce chain length under
    # heavy workloads (compiler dogfooding: D.1's cg_arena ~80 MB → 1280 blocks
    # at 64 KB instead of 20K blocks at 4 KB; D.2's tc_arena similarly).
    #
    # Phase D.x — last_fit cache (offset 5) makes chain walk O(1) on monotonic
    # growth (the common case for codegen-style arenas). arena_alloc starts the
    # walk from `last_fit` instead of `head`. On chain growth, `last_fit` is
    # updated to point to the new tail block. arena_reset resets it to head.
    # Without this cache, the chain walk is O(N) per allocation, costing
    # O(N²) total over a saturating workload — at compiler scale (1.6T ops)
    # this is 27+ minutes of pure chain walking.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 48)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr.i64 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    codegen_util::cg_emit(out, "  store i64 65536, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    # mmap(NULL, 65536, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data = call ptr @mmap(ptr null, i64 65536, i32 3, i32 ")
    codegen_util::cg_emit(out, codegen_util::cg_get_mmap_flags())
    codegen_util::cg_emit_line(out, ", i32 -1, i64 0)")
    codegen_util::cg_emit_ptrtoint("#{d}.data.i64", "#{d}.data", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 3")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next.ptr")
    # Initialize alloc_count = 0 at offset 4
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ac.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 4")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ac.ptr")
    # Phase D.x — Initialize last_fit = head_addr (self-pointer) at offset 5.
    # Walk starts from head until first chain growth updates the cache.
    codegen_util::cg_emit_ptrtoint("#{d}.hdr.i64.self", "#{d}.hdr.i64", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lf.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 5")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr.i64.self, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lf.ptr")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  if name == "arena_alloc"
    var ar = mir::mir_call_get_arg(instr, 0)
    var size = mir::mir_call_get_arg(instr, 1)
    # Align size to 16 bytes — preserves the libc-malloc invariant that
    # @to_str's String/Int heuristic depends on (`(val & 15) == 8` after
    # qz_alloc_str's +8 data offset). 8-byte alignment here breaks
    # interpolation desugar's `to_str(...)` wrapper; see D1.5 in
    # `spec/qspec/d1_arena_codegen_repro_spec.qz`.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size.aligned = add i64 %v")
    codegen_util::cg_emit_int(out, size)
    codegen_util::cg_emit_line(out, ", 15")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size.mask = and i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.aligned, -16")
    # Phase D.x — Walk chain starting from `last_fit` cache (offset 5 of arena
    # head). On monotonic growth (the common case for codegen-style arenas),
    # last_fit always equals the tail block, so the walk visits exactly one
    # block: O(1) per allocation. Without the cache, the walk is O(N) per alloc
    # → O(N²) total under saturating workloads. arena_reset and arena_destroy
    # both reset/ignore this field appropriately.
    codegen_util::cg_emit(out, "  br label %arena_walk_start_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "arena_walk_start_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Load last_fit cache from arena head (offset 5).
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lf_load.hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ar)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lf_load.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lf_load.hdr, i64 5")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lf_start = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lf_load.ptr")
    codegen_util::cg_emit(out, "  br label %arena_walk_loop_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "arena_walk_loop_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cur = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lf_start, %arena_walk_start_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".walk.next, %arena_walk_try_next_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".prev = phi i64 [ 0, %arena_walk_start_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cur, %arena_walk_try_next_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_null = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cur, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_null, label %arena_alloc_chain_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %arena_try_fit_")
    codegen_util::cg_emit_line(out, d)
    # Try to fit allocation in this block
    codegen_util::cg_emit(out, "arena_try_fit_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cur to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".walk.next = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newoff = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.mask")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fits = icmp sle i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newoff, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fits, label %arena_alloc_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %arena_walk_try_next_")
    codegen_util::cg_emit_line(out, d)
    # Try next block in chain
    codegen_util::cg_emit(out, "arena_walk_try_next_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %arena_walk_loop_")
    codegen_util::cg_emit_line(out, d)
    # Happy path: fits in current block
    codegen_util::cg_emit(out, "arena_alloc_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newoff, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result.ptr = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  br label %arena_alloc_done_")
    codegen_util::cg_emit_line(out, d)
    # Chain path: no block has space, allocate new block
    codegen_util::cg_emit(out, "arena_alloc_chain_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    # Phase D.x — chain blocks grow at 64 KB minimum (was 4 KB). 16x fewer
    # blocks means O(N²)-shaped chain-walk overhead drops by ~256x under
    # saturating workloads (compiler dogfooding).
    codegen_util::cg_emit(out, ".need_big = icmp sgt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.mask, 65536")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.cap = select i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_big, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.mask, i64 65536")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.hdr.i8 = call ptr @__qz_alloc(i64 32)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.hdr = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.hdr.i8 to ptr")
    # Round up capacity to page size (4096) for mmap alignment
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.cap.raw = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.cap, 4095")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.cap.aligned = and i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.cap.raw, -4096")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.cap.aligned, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.hdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.off.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.hdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size.mask, ptr %v")
    codegen_util::cg_emit(out, d)
