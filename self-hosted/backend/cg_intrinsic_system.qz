##! # System Intrinsics
##!
##! Emits LLVM IR for eval, getenv, argv, and dynamic call operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import mir_lower
import codegen_util
import * from str_compat


# ============================================================================
# System Intrinsics (12 handlers)
# ============================================================================

def cg_emit_intrinsic_system(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "call_fn"
    var fn_ptr = args[0]
    var num_args = args.size - 1

    # Check closure tag (low bit)
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tag = and i64 %v")
    codegen_util::cg_emit_int(out, fn_ptr)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure = icmp eq i64 %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tag, 1")
    codegen_util::cg_emit(out, "  br i1 %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure, label %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".closure, label %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".plain")

    # Closure path: extract fn ptr and env, call with env as first arg
    codegen_util::cg_emit(out, "cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".closure:")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env = and i64 %v")
    codegen_util::cg_emit_int(out, fn_ptr)
    codegen_util::cg_emit_line(out, ", -2")
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".envptr = inttoptr i64 %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env to ptr")
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn = load i64, ptr %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".envptr")

    # Build closure function type: i64 (i64, ...args)
    var ctype = "i64 (i64"
    for ci in 0..num_args
      ctype += ", i64"
    end
    ctype += ")*"
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cptr = inttoptr i64 %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn to ")
    codegen_util::cg_emit_line(out, ctype)

    # Build closure call: call with env as first arg
    var ccall = "  %cfn#{d}.cres = call i64 %cfn#{d}.cptr(i64 %cfn#{d}.env"
    for cj in 0..num_args
      var arg = args[cj + 1]
      ccall += ", i64 %v#{arg.to_s()}"
    end
    ccall += ")"
    codegen_util::cg_emit_line(out, ccall)
    codegen_util::cg_emit(out, "  br label %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".end")

    # Plain function path
    codegen_util::cg_emit(out, "cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".plain:")
    codegen_util::cg_emit_line(out, "")

    # Build plain function type: i64 (...args)
    var ptype = "i64 ("
    for pi in 0..num_args
      if pi > 0
        ptype += ", "
      end
      ptype += "i64"
    end
    ptype += ")*"
    codegen_util::cg_emit(out, "  %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, fn_ptr)
    codegen_util::cg_emit(out, " to ")
    codegen_util::cg_emit_line(out, ptype)

    # Build plain call
    var pcall = "  %cfn#{d}.pres = call i64 %cfn#{d}.pptr("
    for pj in 0..num_args
      if pj > 0
        pcall += ", "
      end
      var arg = args[pj + 1]
      pcall += "i64 %v#{arg.to_s()}"
    end
    pcall += ")"
    codegen_util::cg_emit_line(out, pcall)
    codegen_util::cg_emit(out, "  br label %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".end")

    # Merge
    codegen_util::cg_emit(out, "cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".end:")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cres, %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".closure ], [ %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pres, %cfn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".plain ]")
    return
  end

  if name == "argc"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = load i64, ptr @qz_argc")
    return
  end

  if name == "argv"
    var args = mir::mir_instr_get_args(instr)
    var idx_arg = args[0]
    var idx = codegen_util::cg_format_operand(idx_arg)
    # Load argv base (i8** from i8***)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".base = load ptr, ptr @qz_argv")
    # Index into argv
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr ptr, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".base, i64 ")
    codegen_util::cg_emit(out, idx)
    codegen_util::cg_emit_line(out, "")
    # Load the char* (C string from OS, no length prefix)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".str = load ptr, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    # Wrap C string with length prefix for Quartz runtime
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".str)")
    # Convert to i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.wrapped", "ptr")
    return
  end

  if name == "get_arg"
    var args = mir::mir_instr_get_args(instr)
    var idx_arg = args[0]
    var idx = codegen_util::cg_format_operand(idx_arg)
    # Load argv base (i8** from i8***)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".base = load ptr, ptr @qz_argv")
    # Index into argv
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr ptr, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".base, i64 ")
    codegen_util::cg_emit(out, idx)
    codegen_util::cg_emit_line(out, "")
    # Load the char* (C string from OS, no length prefix)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".str = load ptr, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    # Wrap C string with length prefix for Quartz runtime
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".str)")
    # Convert to i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.wrapped", "ptr")
    return
  end

  if name == "getenv"
    var args = mir::mir_instr_get_args(instr)
    var name_arg = args[0]
    var name_op = codegen_util::cg_format_operand(name_arg)
    # Convert name to i8*
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".name = inttoptr i64 ")
    codegen_util::cg_emit(out, name_op)
    codegen_util::cg_emit_line(out, " to ptr")
    # Call getenv
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result = call ptr @getenv(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".name)")
    # Check for null
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".result, null")
    var lbl = codegen_util::cg_next_label(state).to_s()
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull, label %env_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, ", label %env_ok_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "env_ok_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".result)")
    codegen_util::cg_emit(out, "  br label %env_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "env_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = getelementptr <{ i64, [1 x i8] }>, <{ i64, [1 x i8] }>* @.empty_string, i64 0, i32 1, i64 0")
    codegen_util::cg_emit(out, "  br label %env_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "env_done_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = phi ptr [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped, %env_ok_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, %env_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.ptr", "ptr")
    return
  end

  if name == "system"
    var cmd = args[0]
    # Convert to i8*
    codegen_util::cg_emit_inttoptr("#{d}.cmd", cmd.to_s(), "ptr")
    # Call system
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @system(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cmd)")
    # Sign extend to i64
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret to i64")
    return
  end

  if name == "posix_spawn_wait"
    var cmd = args[0]
    codegen_util::cg_emit_inttoptr("#{d}.cmd", cmd.to_s(), "ptr")
    # Delegate to runtime helper which handles signal-handler install,
    # posix_spawnp + waitpid. Returns i64 raw wait-status.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @__qz_posix_spawn_wait(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cmd)")
    return
  end

  if name == "setenv"
    var key = args[0]
    var val = args[1]
    # Convert key and value to i8*
    codegen_util::cg_emit_inttoptr("#{d}.key", key.to_s(), "ptr")
    codegen_util::cg_emit_inttoptr("#{d}.val", val.to_s(), "ptr")
    # Call setenv(key, value, 1) — 1 = overwrite existing
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @setenv(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".key, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val, i32 1)")
    # Sign extend to i64
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret to i64")
    return
  end

  if name == "panic"
    var msg = args[0]

    # B.5e.8 — freestanding panic: scan the per-task effect stack for a user
    # `Throws` handler. If one is installed (e.g. the freestanding actor poll
    # boundary that B.5e.8 wraps around the recv loop), perform `Throws.throw`
    # (kind=2) so `__qz_effect_perform` longjmps to the handler's setjmp buf —
    # turning a kernel panic into a catchable unwind instead of a CPU halt. If
    # none is installed the scan falls through to `fpn_fallback_<d>`, which is
    # the existing @panic_handler / `unreachable` path below — unchanged
    # behavior for ordinary kernel code that installs no Throws handler. This is
    # the freestanding counterpart of the hosted B.9 Phase 2 scan (lines ~374+),
    # which was previously stubbed to a bare `unreachable` here. Note the
    # freestanding `@__qz_effect_stack_names` is a heap-strip `ptr` (loaded then
    # GEP'd as `i64`), NOT a `[256 x i64]` array like the hosted path, and the
    # freestanding `@__qz_effect_cstr_eq` returns `i1`. Index range [0, top)
    # matches `__qz_effect_perform`'s own scan, so a name hit here implies a
    # perform hit (a real Throws handler always carries op-filter "throw").
    if mir_lower::mir_is_freestanding() == 1
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.top = load i64, ptr @__qz_effect_stack_top, align 8")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.has = icmp sgt i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.top, 0")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.has, label %fpn_init_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ", label %fpn_fallback_")
      codegen_util::cg_emit_line(out, d)
      # init: load the names strip base once, start the scan at top-1
      codegen_util::cg_emit(out, "fpn_init_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.names = load ptr, ptr @__qz_effect_stack_names, align 8")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.i0 = sub i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.top, 1")
      codegen_util::cg_emit(out, "  br label %fpn_scan_")
      codegen_util::cg_emit_line(out, d)
      # scan loop: i from top-1 downto 0
      codegen_util::cg_emit(out, "fpn_scan_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.i = phi i64 [%v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.i0, %fpn_init_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, "], [%v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.in, %fpn_cont_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, "]")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.neg = icmp slt i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.i, 0")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.neg, label %fpn_fallback_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ", label %fpn_chk_")
      codegen_util::cg_emit_line(out, d)
      # check names[i] == "Throws"
      codegen_util::cg_emit(out, "fpn_chk_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.np = getelementptr inbounds i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.names, i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.i")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.ni = load i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.np, align 8")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.npt = inttoptr i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.ni to ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.eq = call i1 @__qz_effect_cstr_eq(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.npt, ptr @__qz_eff_name_throws)")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.eq, label %fpn_perform_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ", label %fpn_cont_")
      codegen_util::cg_emit_line(out, d)
      # cont: i = i - 1, loop
      codegen_util::cg_emit(out, "fpn_cont_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.in = sub i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.i, 1")
      codegen_util::cg_emit(out, "  br label %fpn_scan_")
      codegen_util::cg_emit_line(out, d)
      # perform: argv = [msg]; Throws.throw kind=2 → longjmp to handler buf
      codegen_util::cg_emit(out, "fpn_perform_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.argv = alloca i64, i64 1, align 8")
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit_int(out, msg)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.argv, align 8")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fpn.r = call i64 @__qz_effect_perform(ptr @__qz_eff_name_throws, ptr @__qz_eff_op_throw, i64 1, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fpn.argv, i64 2)")
      codegen_util::cg_emit_line(out, "  unreachable")
      # fallback: no Throws handler installed — fall through to the existing
      # @panic_handler / `unreachable` emission below.
      codegen_util::cg_emit(out, "fpn_fallback_")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
    end

    # SYS.1 item 6 — @panic_handler route. If the program registered
    # a user panic handler, emit a direct call to it and mark control
    # unreachable. Skips the libc-based write/longjmp/exit path
    # entirely — required for freestanding / kernel builds.
    var handler = mir::mir_get_panic_handler(prog)
    if str_byte_len(handler) > 0
      var handler_sym = codegen_util::cg_sanitize_llvm_name(handler)
      codegen_util::cg_emit(out, "  call i64 @")
      codegen_util::cg_emit(out, handler_sym)
      codegen_util::cg_emit(out, "(i64 %v")
      codegen_util::cg_emit_int(out, msg)
      codegen_util::cg_emit_line(out, ")")
      codegen_util::cg_emit_line(out, "  unreachable")
      # Dummy result (won't be reached) — matches the libc panic path.
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return
    end

    # Freestanding without a registered @panic_handler: emit plain
    # `unreachable`. The libc write/longjmp/exit + `@.panic.prefix` +
    # `@.newline` + `@__qz_panic_jmpbuf_get` refs below would all be
    # dangling (`cg_emit_runtime_decls` skips their declarations for
    # freestanding). Users targeting freestanding should register a
    # `@panic_handler`; without one, panic sites halt the CPU.
    if mir_lower::mir_is_freestanding() == 1
      codegen_util::cg_emit_line(out, "  unreachable")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return
    end

    # B.9 Phase 2: scan effect stack for a non-blessed `Throws` handler.
    # If found, build `"panic: " + msg` and perform Throws.throw kind=2
    # so user `with Throws { throw: rec } do ... end` blocks can catch
    # panics. Otherwise fall through to the legacy abort path (preserves
    # `panic_caught` per-thread jmpbuf compatibility — the scheduler's
    # per-task panic capture continues to work unchanged).
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.top = load i64, ptr @__qz_effect_stack_top, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.bw = load i64, ptr @__qz_alloc_blessed_watermark, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.has_user = icmp sgt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.top, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.bw")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.has_user, label %pn_scan_init_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %pn_legacy_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "pn_scan_init_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i_start = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.top, 1")
    codegen_util::cg_emit(out, "  br label %pn_scan_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "pn_scan_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i = phi i64 [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i_start, %pn_scan_init_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i_next, %pn_scan_continue_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.below = icmp slt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.bw")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.below, label %pn_legacy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %pn_scan_check_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "pn_scan_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.np = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names, i64 0, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.i")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.ni = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.np, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.npt = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.ni to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.eq = call i64 @__qz_effect_cstr_eq(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.npt, ptr @__qz_eff_name_throws)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.match = icmp ne i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.eq, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.match, label %pn_perform_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %pn_scan_continue_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "pn_scan_continue_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.i_next = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.i, 1")
    codegen_util::cg_emit(out, "  br label %pn_scan_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "pn_perform_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.pp = getelementptr inbounds <{ i64, [8 x i8] }>, ptr @__qz_panic_prefix_str, i64 0, i32 1, i64 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.pi = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.pp to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.full = call i64 @str_concat(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.pi, i64 %v")
    codegen_util::cg_emit_int(out, msg)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.argv = alloca i64, i64 1, align 8")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.full, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.argv, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pn.r = call i64 @__qz_effect_perform(ptr @__qz_eff_name_throws, ptr @__qz_eff_op_throw, i64 1, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pn.argv, i64 2)")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "pn_legacy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")

    # Print colored prefix "panic: " (bold red) to stderr
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfx = getelementptr [19 x i8], [19 x i8]* @.panic.prefix, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfx.len = call i64 @strlen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfx)")
    codegen_util::cg_emit(out, "  call i64 @write(i32 2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfx, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfx.len)")
    # Print the message to stderr
    codegen_util::cg_emit_inttoptr("#{d}.msg", msg.to_s(), "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".msg.len = call i64 @strlen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".msg)")
    codegen_util::cg_emit(out, "  call i64 @write(i32 2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".msg, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".msg.len)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nl = getelementptr [2 x i8], [2 x i8]* @.newline, i64 0, i64 0")
    codegen_util::cg_emit(out, "  call i64 @write(i32 2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nl, i64 1)")
    # Check per-thread jmpbuf: if set, longjmp instead of abort (scheduler panic capture)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".jb = call ptr @__qz_panic_jmpbuf_get()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_jb = icmp ne ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".jb, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_jb, label %panic_longjmp_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %panic_abort_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "panic_longjmp_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  call void @longjmp(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".jb, i32 1)")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "panic_abort_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_line(out, "  call void @exit(i32 1)")
    codegen_util::cg_emit_line(out, "  unreachable")
    # Need a dummy result (won't be reached)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # SYS.1 item 7 — x86 segment-based TLS (`%gs:offset` / `%fs:offset`).
  # LLVM emits the correct segment-prefixed instruction when the pointer
  # operand lives in addrspace(256) for gs or addrspace(257) for fs.
  # All four intrinsics operate on i64-sized TLS slots; wider / narrower
  # accesses can be added later if kernel code needs them.
  if name == "tls_read_gs"
    var off = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, " to ptr addrspace(256)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr addrspace(256) %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    return
  end

  if name == "tls_read_fs"
    var off = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, " to ptr addrspace(257)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr addrspace(257) %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    return
  end

  if name == "tls_write_gs"
    var off = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, " to ptr addrspace(256)")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr addrspace(256) %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    # Dummy result for the Void return.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "tls_write_fs"
    var off = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, off)
    codegen_util::cg_emit_line(out, " to ptr addrspace(257)")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr addrspace(257) %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    # Dummy result for the Void return.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # arm64 thread-pointer register access via single-instruction inline asm.
  # TPIDR_EL1 is the kernel per-CPU base; TPIDR_EL0 is the userspace TLS
  # base. `mrs` reads a system register into a GPR, `msr` writes one.
  # sideeffect on the asm so LLVM doesn't sink / CSE / DCE these calls.
  if name == "tls_read_tpidr_el1"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 asm sideeffect \"mrs $0, tpidr_el1\", \"=r\"() nounwind")
    return
  end

  if name == "tls_read_tpidr_el0"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 asm sideeffect \"mrs $0, tpidr_el0\", \"=r\"() nounwind")
    return
  end

  if name == "tls_write_tpidr_el1"
    var val = args[0]
    codegen_util::cg_emit(out, "  call void asm sideeffect \"msr tpidr_el1, $0\", \"r\"(i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, ") nounwind")
    # Dummy result for the Void return.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "tls_write_tpidr_el0"
    var val = args[0]
    codegen_util::cg_emit(out, "  call void asm sideeffect \"msr tpidr_el0, $0\", \"r\"(i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, ") nounwind")
    # Dummy result for the Void return.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # x86 port-I/O — legacy I/O-port-space access. Quartz's intrinsic ABI
  # passes all args as i64, so we truncate to i8/i16/i32 before the asm
  # and zext the result back up to i64. The asm constraint `{dx}` pins
  # the port to DX (16-bit); `{al}`/`{ax}`/`{eax}` pin the value to the
  # width-appropriate accumulator. `sideeffect` prevents CSE / DCE —
  # port-I/O has external effects the compiler cannot observe.
  if name == "port_out8"
    var port = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v = trunc i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, " to i8")
    codegen_util::cg_emit(out, "  call void asm sideeffect \"outb $0, $1\", \"{al},{dx}\"(i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v, i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "port_out16"
    var port = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v = trunc i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  call void asm sideeffect \"outw $0, $1\", \"{ax},{dx}\"(i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v, i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "port_out32"
    var port = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v = trunc i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  call void asm sideeffect \"outl $0, $1\", \"{eax},{dx}\"(i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v, i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "port_in8"
    var port = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i8 asm sideeffect \"inb $1, $0\", \"={al},{dx}\"(i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "port_in16"
    var port = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i16 asm sideeffect \"inw $1, $0\", \"={ax},{dx}\"(i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "port_in32"
    var port = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = trunc i64 %v")
    codegen_util::cg_emit_int(out, port)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 asm sideeffect \"inl $1, $0\", \"={eax},{dx}\"(i16 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  # x86 MSR write — ECX = index, EDX:EAX = 64-bit value. Split the i64
  # value into high/low i32 halves and pin each to its required register
  # via LLVM's hard-register constraints ({ecx},{eax},{edx}).
  if name == "wrmsr"
    var msr = args[0]
    var val = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".msr = trunc i64 %v")
    codegen_util::cg_emit_int(out, msr)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lo = trunc i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hi64 = lshr i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, ", 32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hi = trunc i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hi64 to i32")
    codegen_util::cg_emit(out, "  call void asm sideeffect \"wrmsr\", \"{ecx},{eax},{edx}\"(i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".msr, i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lo, i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hi) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # x86 MSR read — ECX = index, EDX:EAX = 64-bit value returned. The
  # LLVM inline-asm multi-output form returns `{i32, i32}` which we
  # extract + reassemble into an i64.
  if name == "rdmsr"
    var msr = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".msr = trunc i64 %v")
    codegen_util::cg_emit_int(out, msr)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pair = call { i32, i32 } asm sideeffect \"rdmsr\", \"={eax},={edx},{ecx}\"(i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".msr) nounwind")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lo = extractvalue { i32, i32 } %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pair, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hi = extractvalue { i32, i32 } %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pair, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lo64 = zext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lo to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hi64 = zext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hi to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hishift = shl i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hi64, 32")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = or i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hishift, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lo64")
    return
  end

  if name == "assert"
    var cond = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond = icmp ne i64 %v")
    codegen_util::cg_emit_int(out, cond)
    codegen_util::cg_emit_line(out, ", 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond, label %assert_pass_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %assert_fail_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "assert_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_line(out, "  call void @exit(i32 1)")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "assert_pass_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # Note: The duplicate panic handler that was here has been merged into
  # the primary handler above (which now includes backtrace).

  if name == "exit"
    var code_arg = args[0]
    codegen_util::cg_emit(out, "  %exit")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".trunc = trunc i64 %v")
    codegen_util::cg_emit_int(out, code_arg)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  call void @exit(i32 %exit")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".trunc)")
    codegen_util::cg_emit_line(out, "  unreachable")
    return
  end

  if name == "unreachable"
    codegen_util::cg_emit_line(out, "  call void @abort()")
    codegen_util::cg_emit_line(out, "  unreachable")
    return
  end

  if name == "unwrap"
    var opt = args[0]
    codegen_util::cg_emit(out, "  %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, opt)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tag = load i64, ptr %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_none = icmp ne i64 %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tag, 0")
    codegen_util::cg_emit(out, "  br i1 %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_none, label %unwrap_panic_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %unwrap_ok_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "unwrap_panic_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
    codegen_util::cg_emit_line(out, "  call void @abort()")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "unwrap_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.ptr = getelementptr i64, ptr %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %uw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.ptr")
    return
  end

end
