##! # Math Intrinsics
##!
##! Emits LLVM IR for bitwise and arithmetic operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat


# ============================================================================
# Math Intrinsics (15 handlers)
# ============================================================================

def cg_emit_intrinsic_math(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "bor"
    var arg0 = mir::mir_call_get_arg(instr, 0)
    var arg1 = mir::mir_call_get_arg(instr, 1)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = or i64 %v")
    codegen_util::cg_emit_int(out, arg0)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_line(out, arg1.to_s())
    return
  end

  if name == "band"
    var arg0 = mir::mir_call_get_arg(instr, 0)
    var arg1 = mir::mir_call_get_arg(instr, 1)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = and i64 %v")
    codegen_util::cg_emit_int(out, arg0)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_line(out, arg1.to_s())
    return
  end

  if name == "bxor"
    var arg0 = mir::mir_call_get_arg(instr, 0)
    var arg1 = mir::mir_call_get_arg(instr, 1)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = xor i64 %v")
    codegen_util::cg_emit_int(out, arg0)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_line(out, arg1.to_s())
    return
  end

  if name == "bnot"
    var arg0 = mir::mir_call_get_arg(instr, 0)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = xor i64 %v")
    codegen_util::cg_emit_int(out, arg0)
    codegen_util::cg_emit_line(out, ", -1")
    return
  end

  if name == "min"
    var arr = mir::mir_call_get_arg(instr, 0)
    var av = arr.to_s()
    codegen_util::cg_emit_vec_unpack_header("min", d, av)
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty = icmp eq i64 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 0")
    codegen_util::cg_emit(out, "  br i1 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty_exit, label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".start")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".start:")
    codegen_util::cg_emit_vec_unpack_data("min", d)
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".first = load i64, ptr %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr")
    codegen_util::cg_emit(out, "  br label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop:")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [1, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".start], [%min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body]")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cur = phi i64 [%min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".first, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".start], [%min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_min, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body]")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond = icmp uge i64 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond, label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".exit, label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body:")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr i64, ptr %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".less = icmp slt i64 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, %min")
    codegen_util::cg_emit(out, d)
