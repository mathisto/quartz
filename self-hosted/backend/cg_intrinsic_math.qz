    codegen_util::cg_emit(out, ".first, %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".start], [%max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_max, %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body]")
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond = icmp uge i64 %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cond, label %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".exit, label %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body")
    codegen_util::cg_emit(out, "max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body:")
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr i64, ptr %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr")
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
