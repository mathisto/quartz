    codegen_util::cg_emit(out, ".absum = extractvalue {i64, i1} %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ab, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flag1 = extractvalue {i64, i1} %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ab, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".full = call {i64, i1} @llvm.uadd.with.overflow.i64(i64 %v")
