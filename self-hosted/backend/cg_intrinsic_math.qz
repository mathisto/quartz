    codegen_util::cg_emit_line(out, ".cur")
    codegen_util::cg_emit(out, "  %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next = add i64 %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".exit:")
    codegen_util::cg_emit(out, "  br label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".finish")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty_exit:")
    codegen_util::cg_emit(out, "  br label %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".finish")
    codegen_util::cg_emit(out, "min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".finish:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cur, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".exit], [9223372036854775807, %min")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty_exit]")
    return
  end

  if name == "max"
    var arr = mir::mir_call_get_arg(instr, 0)
    var av = arr.to_s()
    codegen_util::cg_emit_vec_unpack_header("max", d, av)
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty = icmp eq i64 %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 0")
    codegen_util::cg_emit(out, "  br i1 %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, label %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty_exit, label %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".start")
    codegen_util::cg_emit(out, "max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".start:")
    codegen_util::cg_emit_vec_unpack_data("max", d)
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".first = load i64, ptr %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr")
    codegen_util::cg_emit(out, "  br label %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop")
    codegen_util::cg_emit(out, "max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop:")
    codegen_util::cg_emit(out, "  %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [1, %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".start], [%max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next, %max")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body]")
    codegen_util::cg_emit(out, "  %max")
