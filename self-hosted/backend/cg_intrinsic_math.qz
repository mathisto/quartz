    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val63 = and i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val, 9223372036854775807")
    codegen_util::cg_emit(out, "  %v")
