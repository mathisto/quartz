  # NET.1 Phase 1, Step 1.4 — wide-multiply and carry-chain intrinsics.
  # Six split intrinsics rather than three tuple-returning ones; see
  # docs/design/CRYPTO_STDLIB_DESIGN.md decision log 2026-05-08. LLVM
  # CSE folds the redundant operand chain when both halves of one call
  # are present in a basic block, so the asm is identical to a tuple
  # intrinsic on x86-64 (single mulq RAX:RDX) and aarch64 (mul + umulh).

  if name == "widening_mul_lo"
    var a = args[0].to_s()
    var b = args[1].to_s()
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".aext = zext i64 %v")
    codegen_util::cg_emit(out, a)
    codegen_util::cg_emit_line(out, " to i128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bext = zext i64 %v")
    codegen_util::cg_emit(out, b)
    codegen_util::cg_emit_line(out, " to i128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".prod = mul i128 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".aext, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bext")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = trunc i128 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".prod to i64")
    return
  end

  if name == "widening_mul_hi"
    var a = args[0].to_s()
    var b = args[1].to_s()
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".aext = zext i64 %v")
    codegen_util::cg_emit(out, a)
    codegen_util::cg_emit_line(out, " to i128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bext = zext i64 %v")
    codegen_util::cg_emit(out, b)
    codegen_util::cg_emit_line(out, " to i128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".prod = mul i128 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".aext, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bext")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hi128 = lshr i128 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".prod, 64")
