  # NET.1 Phase 1, Step 2.5 — x86 hardware RNG. Returns Int with the
  # success flag in bit 63 and 63 bits of randomness in bits 0..62.
  # Caller masks the flag bit and retries on failure (rdrand can fail
  # transiently under heavy CPU contention; rdseed fails more often
  # because the underlying entropy reservoir refills more slowly than
  # rdrand's whitened DRBG). One bit of entropy lost per call is
  # cryptographically irrelevant — the consumer side feeds output into
  # HKDF-Extract which condenses to a 256-bit PRK.
  if name == "rdrand_64"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tup = call {i64, i32} @llvm.x86.rdrand.64()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = extractvalue {i64, i32} %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tup, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok32 = extractvalue {i64, i32} %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tup, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok64 = zext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ok32 to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flag = shl i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ok64, 63")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val63 = and i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val, 9223372036854775807")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = or i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val63, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flag")
    return
  end

  if name == "rdseed_64"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tup = call {i64, i32} @llvm.x86.rdseed.64()")
    codegen_util::cg_emit(out, "  %v")
