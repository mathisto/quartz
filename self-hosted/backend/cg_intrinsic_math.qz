  if name == "popcount"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @llvm.ctpop.i64(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "clz"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @llvm.ctlz.i64(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ", i1 false)")
    return
  end

  if name == "ctz"
    var arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @llvm.cttz.i64(i64 %v")
