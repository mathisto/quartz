  if name == "rotl"
    var x = args[0]
    var amount = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @llvm.fshl.i64(i64 %v")
    codegen_util::cg_emit_int(out, x)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, x)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, amount)
