    codegen_util::cg_emit(out, ".ge, %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ok to i64")
    return
  end

  # ---- reverse/reversed(v): return new Vec with elements in reverse order ----
