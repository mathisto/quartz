  # ---- zip(v1, v2): return Vec of [a, b] pairs (stops at shortest) ----
  if name == "zip"
    var a1 = mir::mir_call_get_arg(instr, 0)
    var a2 = mir::mir_call_get_arg(instr, 1)
    var av1 = a1.to_s()
    var av2 = a2.to_s()
    var lbl = codegen_util::cg_next_label(state)
    codegen_util::cg_emit_line(out, "  ; zip: pair elements from two vecs")
    codegen_util::cg_emit_vec_unpack("z1", d, av1)
    codegen_util::cg_emit_vec_unpack("z2", d, av2)
    # min_len = min(z1.len, z2.len)
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt = icmp slt i64 %z1")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, %z2")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".min = select i1 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt, i64 %z1")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, i64 %z2")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit_vec_alloc("zip", d, "%zip#{d}.min", "0")
    codegen_util::cg_emit(out, "  br label %zip_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "zip_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %zip_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "zip_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %zip_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next, %zip_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp sge i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".min")
    codegen_util::cg_emit(out, "  br i1 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %zip_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %zip_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "zip_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = getelementptr i64, ptr %z1")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".a = load i64, ptr %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bp = getelementptr i64, ptr %z2")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".b = load i64, ptr %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bp")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pair = call i64 @__qz_pair_new(i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".a, i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".b)")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res_i = ptrtoint ptr %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res_i, i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pair)")
    codegen_util::cg_emit(out, "  %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next = add i64 %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %zip_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "zip_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %zip")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    return
  end

  # ---- partition(v, pred): return [matching, non_matching] pair ----
  if name == "partition"
    var arr_arg = mir::mir_call_get_arg(instr, 0)
    var fn_arg = mir::mir_call_get_arg(instr, 1)
    var av = arr_arg.to_s()
    var lbl = codegen_util::cg_next_label(state)
    codegen_util::cg_emit_line(out, "  ; partition: split into [matching, non_matching]")
    codegen_util::cg_emit_vec_unpack("prt", d, av)
    # Alloc two result vecs
    codegen_util::cg_emit_vec_alloc("prtm", d, "%prt#{d}.len", "0")
    codegen_util::cg_emit_vec_alloc("prtn", d, "%prt#{d}.len", "0")
    # Tag-bit check
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn_tag = and i64 %v")
    codegen_util::cg_emit_int(out, fn_arg)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure = icmp eq i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn_tag, 1")
    codegen_util::cg_emit(out, "  %prtm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ri = ptrtoint ptr %prtm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    codegen_util::cg_emit(out, "  %prtn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ri = ptrtoint ptr %prtn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    codegen_util::cg_emit(out, "  br label %prt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %prt_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %prt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next, %prt_push_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp sge i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %prt_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %prt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep = getelementptr i64, ptr %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep")
    # Call predicate (closure vs fn ptr)
    codegen_util::cg_emit(out, "  br i1 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure, label %prt_cc_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %prt_cp_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_cc_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env = and i64 %v")
    codegen_util::cg_emit_int(out, fn_arg)
    codegen_util::cg_emit_line(out, ", -2")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env_ptr = inttoptr i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env to ptr")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn_slot = load i64, ptr %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env_ptr")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn = inttoptr i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cfn_slot to i64 (i64, i64)*")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cres = call i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn(i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env, i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val)")
    codegen_util::cg_emit(out, "  br label %prt_check_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_cp_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfn = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, fn_arg)
    codegen_util::cg_emit_line(out, " to i64 (i64)*")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pres = call i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfn(i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val)")
    codegen_util::cg_emit(out, "  br label %prt_check_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_check_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res = phi i64 [%prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cres, %prt_cc_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pres, %prt_cp_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".match = icmp ne i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res, 0")
    # Push to matching or non-matching vec
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".target = select i1 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".match, i64 %prtm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ri, i64 %prtn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ri")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".target, i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val)")
    codegen_util::cg_emit(out, "  br label %prt_push_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_push_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next = add i64 %prt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %prt_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "prt_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Return [matching, non_matching] pair
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @__qz_pair_new(i64 %prtm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ri, i64 %prtn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ri)")
    return
  end


end

