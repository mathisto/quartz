    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ci_next = add i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ci, 1")
    codegen_util::cg_emit(out, "  br label %fla_cnt_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    # Allocate result vec
    codegen_util::cg_emit(out, "fla_alloc_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_vec_alloc("fla", d, "%fla#{d}.total", "%fla#{d}.total")
    # Second pass: copy elements
    codegen_util::cg_emit(out, "  br label %fla_cpy_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cpy_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %fla_cpy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cpy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oi = phi i64 [0, %fla_cpy_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oi_next, %fla_cpy_inner_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi2 = phi i64 [0, %fla_cpy_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi2_next, %fla_cpy_inner_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".odone = icmp sge i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oi, %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".odone, label %fla_done_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %fla_cpy_inner_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cpy_inner_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Load inner vec and memcpy its data
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_p = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".oi")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_i = load i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_p")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_hdr = inttoptr i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_i to ptr")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_len_p = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_hdr, i64 1")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_len = load i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_len_p")
