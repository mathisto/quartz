    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "unq_fin_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Update result vec length to final write index
    codegen_util::cg_emit(out, "  store i64 %unq")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi, ptr %unq")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_cap_ptr, align 8")
