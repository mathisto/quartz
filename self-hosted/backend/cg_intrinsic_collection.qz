    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".none, label %fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".some")
    codegen_util::cg_emit(out, "fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".some:")
    codegen_util::cg_emit_vec_unpack_data("fst", d)
    # F4 item-50 — INLINE value-layout `@value` element: return the ADDRESS of
    # element 0's interior (= the data base, offset 0) as an i64, exactly like
    # vec_get returns a direct pointer into the Vec data for an inline @value (the
    # consumer's `.field` reads through it). The legacy single-i64 LOAD would return
    # field-0's raw word, which the consumer then `inttoptr`s as a struct ptr → SEGV.
    # GATED on cg_first_last_inline_field_count >= 1 ⇒ scalars / refs / cow handles
    # take the legacy load (byte-identical); inert at gate 0.
    var _fst_ifc = cg_first_last_inline_field_count(prog, _elem_type)
    if _fst_ifc >= 1
      codegen_util::cg_emit(out, "  %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val = ptrtoint ptr %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".arr to i64")
    else
      codegen_util::cg_emit(out, "  %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val = load i64, ptr %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".arr")
    end
    codegen_util::cg_emit(out, "  br label %fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".done")
    codegen_util::cg_emit(out, "fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".none:")
    # F4 item-2a — cow element: PANIC on empty (the readout retain would deref the
    # -1 sentinel). Non-cow elements keep the -1 phi (byte-identical). INERT gate 0.
    var _fst_panic = cg_first_last_cow_panic_empty(prog, _elem_type)
    if _fst_panic == 1
      codegen_util::cg_emit_line(out, "  call void @qz_bounds_panic(i64 0, i64 0)")
      codegen_util::cg_emit_line(out, "  unreachable")
    else
      codegen_util::cg_emit(out, "  br label %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".done")
    end
    codegen_util::cg_emit(out, "fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".done:")
    if _fst_panic == 1
      # Only the .some predecessor reaches .done ⇒ a single-arg phi (the -1/.none
      # edge is now `unreachable`), so the value flows straight from .some.
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = phi i64 [%fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val, %fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".some]")
    else
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = phi i64 [%fst")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val, %fst")
