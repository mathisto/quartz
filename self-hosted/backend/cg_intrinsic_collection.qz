  if name == "first"
    var arr = mir::mir_call_get_arg(instr, 0)
    var av = arr.to_s()
    codegen_util::cg_emit_vec_unpack_header("fst", d, av)
    codegen_util::cg_emit(out, "  %fst")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty = icmp eq i64 %fst")
