    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "unq_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %unq")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    return
  end

  # ---- flatten(v): flatten Vec<Vec<T>> to Vec<T> ----
  if name == "flatten"
    var arr_arg = mir::mir_call_get_arg(instr, 0)
    var av = arr_arg.to_s()
    var lbl = codegen_util::cg_next_label(state)
    codegen_util::cg_emit_line(out, "  ; flatten: concatenate all inner vecs")
    codegen_util::cg_emit_vec_unpack("fla", d, av)
    # First pass: compute total length
    codegen_util::cg_emit(out, "  br label %fla_cnt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cnt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %fla_cnt_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cnt_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ci = phi i64 [0, %fla_cnt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ci_next, %fla_cnt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".total = phi i64 [0, %fla_cnt_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".total_next, %fla_cnt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cdone = icmp sge i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ci, %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cdone, label %fla_alloc_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %fla_cnt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_cnt_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Load inner vec from outer[ci]
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".inner_p = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ci")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".inner_i = load i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".inner_p")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".inner_hdr = inttoptr i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".inner_i to ptr")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".inner_len_p = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".inner_hdr, i64 1")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".inner_len = load i64, ptr %fla")
