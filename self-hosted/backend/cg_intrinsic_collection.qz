    codegen_util::cg_emit(out, ", label %slice_set_wide_")
    codegen_util::cg_emit_line(out, lbl)
    # Scalar: store i64 val
    codegen_util::cg_emit(out, "slice_set_scalar_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep")
    codegen_util::cg_emit(out, "  br label %slice_set_done_")
    codegen_util::cg_emit_line(out, lbl)
    # Wide: memcpy(ep, val_as_ptr, elem_width)
