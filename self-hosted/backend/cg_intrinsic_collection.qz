    codegen_util::cg_emit(out, ", %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".le = icmp sle i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit(out, ", %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ic = icmp ne i64 %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 0")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub = select i1 %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ic, i1 %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".le, i1 %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lt")
    # Both conditions must be true
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = and i1 %rg")
