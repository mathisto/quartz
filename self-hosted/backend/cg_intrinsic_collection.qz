    codegen_util::cg_emit(out, ".i, %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %enm_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %enm_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "enm_body_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep = getelementptr i64, ptr %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pair = call i64 @__qz_pair_new(i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val)")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res_i = ptrtoint ptr %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res_i, i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pair)")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next = add i64 %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %enm_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "enm_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
