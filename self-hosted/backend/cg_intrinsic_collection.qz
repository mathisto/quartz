    codegen_util::cg_emit(out, ".end.p = getelementptr i64, ptr %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 1")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e = load i64, ptr %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".end.p")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".incl.p = getelementptr i64, ptr %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 2")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = load i64, ptr %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".incl.p")
    codegen_util::cg_emit(out, "  %rg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".diff = sub i64 %rg")
