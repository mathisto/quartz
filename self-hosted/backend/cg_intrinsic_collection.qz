    codegen_util::cg_emit(out, ".iv_data_p = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_hdr, i64 2")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_data = load i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_data_p")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_arr = inttoptr i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_data to ptr")
    # dst = res_arr + wi2 * 8
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst = getelementptr i64, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res_arr, i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wi2")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nbytes = mul i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_len, 8")
    codegen_util::cg_emit(out, "  call void @llvm.memcpy.p0.p0.i64(ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst, ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iv_arr, i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nbytes, i1 false)")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi2_next = add i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi2, %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".iv_len")
    codegen_util::cg_emit(out, "  %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oi_next = add i64 %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".oi, 1")
    codegen_util::cg_emit(out, "  br label %fla_cpy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "fla_done_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %fla")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res_vec to i64")
    return
  end

  # ---- enumerate(v): return Vec of [index, value] pairs ----
  if name == "enumerate"
    var arr_arg = mir::mir_call_get_arg(instr, 0)
    var av = arr_arg.to_s()
    var lbl = codegen_util::cg_next_label(state)
    codegen_util::cg_emit_line(out, "  ; enumerate: create Vec of [index, value] pairs")
    codegen_util::cg_emit_vec_unpack("enm", d, av)
    codegen_util::cg_emit_vec_alloc("enm", d, "%enm#{d}.len", "0")
    codegen_util::cg_emit(out, "  br label %enm_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "enm_pre_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %enm_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "enm_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %enm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %enm_pre_")
