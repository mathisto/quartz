    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_scalar = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew, 8")
    codegen_util::cg_emit(out, "  br i1 %v")
