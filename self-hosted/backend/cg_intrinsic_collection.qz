##! # Collection Intrinsics
##!
##! Emits LLVM IR for collection operations (slice, map, filter, reduce, sort, zip, etc.).
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# Collection Intrinsics (34 handlers)
# ============================================================================

## F4 item-9 — inline value-layout element stride for higher-order intrinsics.
## Returns the per-element i64-slot field count (> 1) iff `elem_type` is an
## INLINE-stored value-layout struct: the same predicate cg_intrinsic_vec's
## cg_vec_inline_field_count applies for vec_new / vec_get (value-layout field
## count > 1, NOT cow-layout, firewall-safe). For those elements a Vec stores N
## flat i64 words per slot, so the HOF element-fetch stride must be `i * fc`, not
## `i * 1`. Returns 0 for cow-layout (one buffer ptr/slot — stride 1 correct),
## scalars, and reference structs. INERT at gate 0: a plain struct is not
## value-layout ⇒ field count <= 1 ⇒ 0 ⇒ the legacy stride-1 path, byte-identical.
def cg_hof_inline_field_count(prog: mir::MirProgram, elem_type: String): Int
  if str_byte_len(elem_type) == 0
    return 0
  end
  var fc = mir::mir_prog_get_value_layout_field_count(prog, elem_type)
  if fc < 1
    return 0
  end
  if mir::mir_prog_struct_is_cow_layout(prog, elem_type) == 1
    return 0
  end
  if mir::mir_prog_struct_value_firewall_safe(prog, elem_type) == 0
    return 0
  end
  return fc
end

## F4 item-9 — emit the HOF per-iteration element register `%<pfx><d>.val`.
## For an inline value-layout element (cg_hof_inline_field_count > 1) the element
## is N flat words at `data + i*fc`; pass its ADDRESS (ptrtoint of the element
## base) so the callee lambda — whose `param: S` is a by-pointer value-layout
## receiver — reads its fields inline (mirrors vec_get's inline by-address fetch
## + the named-fn ABI). Packed-narrow elements use a typed `%struct.Name` GEP
## (LLVM scales by sizeof); wide elements use an i64-slot GEP at stride fc.
## Otherwise emits the legacy stride-1 single-i64 load (`%<pfx><d>.val`), so the
## non-value path is byte-identical. `pfx` is the handler's SSA prefix (e.g.
## "ea", "map"); `arr_reg` is the `%<pfx><d>.arr` data pointer; `idx_reg` is the
## `%<pfx><d>.i` index register name (both already emitted by the caller).
def cg_emit_hof_elem_load(out: Int, prog: mir::MirProgram, pfx: String, d: String, elem_type: String): Void can Emit
  var fc = cg_hof_inline_field_count(prog, elem_type)
  if fc >= 1
    var pack = mir::mir_prog_struct_has_narrow_fields(prog, elem_type)
    if pack == 1
      # Packed narrow @value: typed-GEP element base, LLVM scales by sizeof.
      codegen_util::cg_emit(out, "  %#{pfx}#{d}.ebase = getelementptr inbounds %struct.#{elem_type}, ptr %#{pfx}#{d}.arr, i64 %#{pfx}#{d}.i")
      codegen_util::cg_emit_line(out, "")
    else
      # Wide @value: i64-slot stride fc.
      codegen_util::cg_emit(out, "  %#{pfx}#{d}.eoff = mul i64 %#{pfx}#{d}.i, #{fc.to_s()}")
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "  %#{pfx}#{d}.ebase = getelementptr inbounds i64, ptr %#{pfx}#{d}.arr, i64 %#{pfx}#{d}.eoff")
      codegen_util::cg_emit_line(out, "")
    end
    # Pass the element ADDRESS (value-layout by-pointer ABI).
    codegen_util::cg_emit(out, "  %#{pfx}#{d}.val = ptrtoint ptr %#{pfx}#{d}.ebase to i64")
    codegen_util::cg_emit_line(out, "")
    return
  end
  # Legacy stride-1 single-word load (scalars, cow buffer ptr/slot, refs).
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.ptr = getelementptr i64, ptr %#{pfx}#{d}.arr, i64 %#{pfx}#{d}.i")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.val = load i64, ptr %#{pfx}#{d}.ptr")
  codegen_util::cg_emit_line(out, "")
end

## F4 item-9b — per-element BYTE-stride expression for an inline value-layout
## RESULT container (filter/take/etc. building a `Vec<S>` of inline `@value` S).
## Mirrors the stride vec_get reads back: packed-narrow @value → exact
## sizeof(%struct.Name) (LLVM-folded const); wide @value → fc i64 words = fc*8
## bytes. Only meaningful when cg_hof_inline_field_count(prog, elem_type) > 1.
def cg_hof_result_elem_bytes(prog: mir::MirProgram, elem_type: String): String
  var fc = cg_hof_inline_field_count(prog, elem_type)
  if mir::mir_prog_struct_has_narrow_fields(prog, elem_type) == 1
    return codegen_util::cg_struct_sizeof_const(elem_type)
  end
  return (fc * 8).to_s()
end

## F4 item-9b — allocate the HOF RESULT Vec with the CORRECT per-element stride.
## For an inline value-layout element (fc > 1) the data array must hold the
## element INLINE (fc flat words / sizeof bytes per slot) exactly as vec_get
## reads it back — NOT one i64 handle per slot. Builds the 3-slot {cap,len,data}
## header (24B) and a `cap * bytes_per_elem` data buffer. For every other element
## kind (scalars, cow ptr, refs, fc<=1) delegates to the legacy stride-8
## cg_emit_vec_alloc — byte-identical, so the non-value path (the only path at
## gate 0) is untouched. Defines %{pfx}{d}.res_vec, %{pfx}{d}.res_arr,
## %{pfx}{d}.res_cap_ptr (same names as cg_emit_vec_alloc).
def cg_emit_hof_result_alloc(out: Int, prog: mir::MirProgram, pfx: String, d: String, elem_type: String, cap_val: String, len_val: String): Void can Emit
  var fc = cg_hof_inline_field_count(prog, elem_type)
  if fc < 1
    codegen_util::cg_emit_vec_alloc(pfx, d, cap_val, len_val)
    return
  end
  var ebytes = cg_hof_result_elem_bytes(prog, elem_type)
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_vec = call ptr @malloc(i64 24)")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  store i64 #{cap_val}, ptr %#{pfx}#{d}.res_vec, align 8")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_cap_ptr = getelementptr inbounds i64, ptr %#{pfx}#{d}.res_vec, i64 1")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  store i64 #{len_val}, ptr %#{pfx}#{d}.res_cap_ptr, align 8")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.elem_bytes = add i64 0, #{ebytes}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.data_size = mul i64 #{cap_val}, %#{pfx}#{d}.elem_bytes")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_data_mem = call ptr @malloc(i64 %#{pfx}#{d}.data_size)")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_data = ptrtoint ptr %#{pfx}#{d}.res_data_mem to i64")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.data_ptr2 = getelementptr inbounds i64, ptr %#{pfx}#{d}.res_vec, i64 2")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  store i64 %#{pfx}#{d}.res_data, ptr %#{pfx}#{d}.data_ptr2, align 8")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_arr = inttoptr i64 %#{pfx}#{d}.res_data to ptr")
  codegen_util::cg_emit_line(out, "")
end

## F4 item-9b — store one kept element into the HOF result Vec at slot
## `dst_idx_reg`. For an inline value-layout element (fc > 1) `src_addr_reg` is
## the ADDRESS of the source element (fc flat words / sizeof bytes), as produced
## by cg_emit_hof_elem_load; copy it INLINE (memcpy bytes_per_elem) to
## res_arr + dst_idx*bytes_per_elem so a later vec_get reads a correct inline
## struct. Otherwise stores the single i64 `src_addr_reg` at the stride-8 slot
## (legacy, byte-identical). `uniq` is a per-call-site unique suffix for the
## memcpy intrinsic-call temporaries. `src_addr_reg`/`dst_idx_reg` are full SSA
## operand strings (with leading %).
def cg_emit_hof_result_store(out: Int, prog: mir::MirProgram, pfx: String, d: String, elem_type: String, src_addr_reg: String, dst_idx_reg: String, uniq: String): Void can Emit
  var fc = cg_hof_inline_field_count(prog, elem_type)
  if fc < 1
    codegen_util::cg_emit(out, "  %#{pfx}#{d}.res_slot#{uniq} = getelementptr i64, ptr %#{pfx}#{d}.res_arr, i64 #{dst_idx_reg}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "  store i64 #{src_addr_reg}, ptr %#{pfx}#{d}.res_slot#{uniq}")
    codegen_util::cg_emit_line(out, "")
    return
  end
  var ebytes = cg_hof_result_elem_bytes(prog, elem_type)
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.dbytes#{uniq} = add i64 0, #{ebytes}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.doff#{uniq} = mul i64 #{dst_idx_reg}, %#{pfx}#{d}.dbytes#{uniq}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.dslot#{uniq} = getelementptr i8, ptr %#{pfx}#{d}.res_arr, i64 %#{pfx}#{d}.doff#{uniq}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  %#{pfx}#{d}.dsrc#{uniq} = inttoptr i64 #{src_addr_reg} to ptr")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %#{pfx}#{d}.dslot#{uniq}, ptr %#{pfx}#{d}.dsrc#{uniq}, i64 %#{pfx}#{d}.dbytes#{uniq})")
  codegen_util::cg_emit_line(out, "")
end

## F4 item-9b-find — i64-slot field count of an inline value-layout `@value` element
## for find's `Some(found)`-box construction, REGARDLESS of cow-vs-flat (unlike
## cg_hof_inline_field_count, which returns 0 for cow-layout >16B). Returns fc (>=1)
## iff `elem_type` is a value-layout, firewall-safe `@value` struct; 0 otherwise. The
## fc-2 (<=16B, flat) and fc-3+ (>16B, cow buffer) cases are BOTH eligible — find
## inlines the found element's fields into the Option niche box exactly as the
## `Option::Some(<value-layout struct>)` construction does (mir_lower.qz ~4095), so
## item-23's `.unwrap()` (returns `&box[word1]`) reads them back correctly. INERT at
## gate 0 (no `@value` element ⇒ value-layout false ⇒ 0 ⇒ the legacy sentinel path).
def cg_find_option_field_count(prog: mir::MirProgram, elem_type: String): Int
  if str_byte_len(elem_type) == 0
    return 0
  end
  var fc = mir::mir_prog_get_value_layout_field_count(prog, elem_type)
  if fc < 1
    return 0
  end
  if mir::mir_prog_struct_value_firewall_safe(prog, elem_type) == 0
    return 0
  end
  return fc
end

## F4 item-50 — i64-slot field count of an INLINE-stored value-layout `@value`
## element for first/last's by-ADDRESS read. Mirrors cg_intrinsic_vec's
## cg_vec_inline_field_count EXACTLY (same predicate vec_get uses to decide an
## inline-vs-handle element read): returns fc (>=1) iff `elem_type` is a value-layout,
## firewall-safe `@value` struct that is stored INLINE (NOT cow — a >16B cow element is
## one buffer POINTER per slot, so the legacy single-i64 load already returns the
## correct handle, exactly like vec_get's handle path). 0 ⇒ the legacy first/last load.
## INERT at gate 0 (no `@value` element ⇒ value-layout false ⇒ 0 ⇒ legacy load).
def cg_first_last_inline_field_count(prog: mir::MirProgram, elem_type: String): Int
  if str_byte_len(elem_type) == 0
    return 0
  end
  var fc = mir::mir_prog_get_value_layout_field_count(prog, elem_type)
  if fc < 1
    return 0
  end
  if mir::mir_prog_struct_is_cow_layout(prog, elem_type) == 1
    return 0
  end
  if mir::mir_prog_struct_value_firewall_safe(prog, elem_type) == 0
    return 0
  end
  return fc
end

## F4 item-50 — 1 iff a first/last-inline value-layout `@value` element has narrow
## (sub-i64) fields, so its elements pack to sizeof(%struct.Name) and the element-base
## GEP must be a typed-GEP (LLVM scales by sizeof), mirroring cg_vec_pack_narrow /
## vec_get's packed path. All-wide @value elements (sizeof == fc*8) return 0 → the
## i64-slot stride path. INERT at gate 0 (fc==0 ⇒ 0).
def cg_first_last_pack_narrow(prog: mir::MirProgram, elem_type: String): Int
  if cg_first_last_inline_field_count(prog, elem_type) == 0
    return 0
  end
  return mir::mir_prog_struct_has_narrow_fields(prog, elem_type)
end

## F4 item-2a — 1 iff first/last over `elem_type` must PANIC on an empty vec
## rather than return the -1 sentinel. A COW-layout (>16B value) element is read
## out as its bare buffer POINTER (legacy load), and the LET-level readout bind
## (mir_init_is_cow_collection_readout) emits a cow_rc_inc RETAIN on that pointer
## — retaining the -1 sentinel from an empty vec would deref -1 (SIGSEGV). Making
## cow first/last panic-on-empty (exactly like vec_get's OOB panic) guarantees the
## retained value is always a valid buffer pointer, and honors item-50's stated
## first/last contract ("panic-on-empty, like vec_get, return T directly"). 0 for
## every non-cow element (scalars / refs / inline <=16B) ⇒ the legacy -1 phi path
## (byte-identical). INERT at gate 0 (no cow element ⇒ 0).
def cg_first_last_cow_panic_empty(prog: mir::MirProgram, elem_type: String): Int
  if str_byte_len(elem_type) == 0
    return 0
  end
  return mir::mir_prog_struct_is_cow_layout(prog, elem_type)
end

## F4 item-9b-find — build the `Some(found)` Option niche box for find's `.found`
## branch. `src_reg` is find's `%fnd<d>.val`: for a flat (<=16B) inline element it is
## the element ADDRESS (flat `[f0@0, f1@1]`); for a cow (>16B) element it is the cow
## BUFFER pointer (`[refcount@0, f0@1, …]`). Mirror the construction's `src_base`
## (mir_lower.qz ~4126): copy fc field words from `src + src_base` into the box at
## `box[word1]` (= box+8), with `tag@0 = 0` (Some). The box is `{tag@0, f0@1, …, f(fc-1)@fc}`
## — a FLAT, header-less payload, exactly the `Option::Some(<value-struct>)` layout
## item-23's unwrap (`&box[word1]`) and the spill match-arm read (`base + 1*8`)
## consume. Heap-malloc'd (offset reads are position-independent). Emits the box
## pointer as i64 into `%fnd<d>.somebox`. `src_base`: 1 for cow-layout, 0 for flat.
def cg_emit_find_some_box(out: Int, prog: mir::MirProgram, d: String, elem_type: String, src_reg: String, fc: Int): Void can Emit
  var src_base = 0
  if mir::mir_prog_struct_is_cow_layout(prog, elem_type) == 1
    src_base = 1
  end
  var box_words = 1 + fc
  var box_bytes = box_words * 8
  codegen_util::cg_emit(out, "  %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".sb_mem = call ptr @malloc(i64 #{box_bytes.to_s()})")
  # tag@0 = 0 (Some)
  codegen_util::cg_emit(out, "  store i64 0, ptr %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".sb_mem, align 8")
  # source field block base = src + src_base words
  codegen_util::cg_emit(out, "  %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".sb_src = inttoptr i64 #{src_reg} to ptr")
  var k = 0
  while k < fc
    var sk = src_base + k
    var dk = 1 + k
    # load source word k
    codegen_util::cg_emit(out, "  %fnd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sb_sp#{k.to_s()} = getelementptr inbounds i64, ptr %fnd#{d}.sb_src, i64 #{sk.to_s()}")
    codegen_util::cg_emit(out, "  %fnd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sb_w#{k.to_s()} = load i64, ptr %fnd#{d}.sb_sp#{k.to_s()}, align 8")
    # store into box word (1 + k)
    codegen_util::cg_emit(out, "  %fnd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sb_dp#{k.to_s()} = getelementptr inbounds i64, ptr %fnd#{d}.sb_mem, i64 #{dk.to_s()}")
    codegen_util::cg_emit(out, "  store i64 %fnd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sb_w#{k.to_s()}, ptr %fnd#{d}.sb_dp#{k.to_s()}, align 8")
    k = k + 1
  end
  codegen_util::cg_emit(out, "  %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".somebox = ptrtoint ptr %fnd#{d}.sb_mem to i64")
end

## F4 item-9b-find — build the `None` Option box for find's `.notfound` branch:
## a 2-word heap box `{tag@0 = 1 (None), _@1}`, mirroring the spill-Option unit-variant
## construction (mir_lower.qz ~4214: alloc 2 words, store tag). `mir_get_enum_tag`
## (spill load@0) reads tag 1 ⇒ `None` (Some=0/None=1, declaration order). Emits the
## box pointer as i64 into `%fnd<d>.nonebox`.
def cg_emit_find_none_box(out: Int, d: String): Void can Emit
  codegen_util::cg_emit(out, "  %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".nb_mem = call ptr @malloc(i64 16)")
  codegen_util::cg_emit(out, "  store i64 1, ptr %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".nb_mem, align 8")
  codegen_util::cg_emit(out, "  %fnd")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".nonebox = ptrtoint ptr %fnd#{d}.nb_mem to i64")
end

def cg_emit_intrinsic_collection(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "slice"
    var vec = args[0]
    var start = args[1]
    var end_idx = args[2]
    # Tier 4 #24 wide-element follow-up: 24-byte slice header
    # {data_ptr, len, elem_width}. Reads elem_width from source Vec[3]
    # so wide @value structs (Point=16, RGB=24) stride correctly.
    # Compute len = end - start
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = sub i64 %v")
    codegen_util::cg_emit_int(out, end_idx)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_line(out, start.to_s())
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vhdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, vec)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vdata.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vdata.i to ptr")
    # Read elem_width from source Vec header[3]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr, i64 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew.ptr")
    # Compute byte offset = start * elem_width, GEP source data with i8 stride
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte.off = mul i64 %v")
    codegen_util::cg_emit(out, start.to_s())
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte.off")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sdata to i64")
    # Allocate 24-byte slice header: {data_ptr, len, elem_width}
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr.p = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr to ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr.p, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slen.ptr")
    # Store elem_width at slot[2]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sew.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr.p, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sew.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr to i64")
    return
  end

  # Tier 4 #24 follow-up: nested slicing — `s[a..b]` where s is already
  # a Slice<T>. Reads source slice's 24-byte header (data_ptr at slot[0],
  # len at slot[1], elem_width at slot[2]) instead of Vec's 32-byte layout.
  # Same elem_width-aware byte stride + 24-byte output header as `slice`.
  if name == "subslice"
    var ss_src = args[0]
    var ss_start = args[1]
    var ss_end = args[2]
    # len = end - start
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = sub i64 %v")
    codegen_util::cg_emit_int(out, ss_end)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit_line(out, ss_start.to_s())
    # Source slice header pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ss_src)
    codegen_util::cg_emit_line(out, " to ptr")
    # data_ptr at slot[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sdata.i to ptr")
    # elem_width at slot[2]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew.ptr")
    # byte_off = start * elem_width, GEP source data with i8 stride
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte.off = mul i64 %v")
    codegen_util::cg_emit(out, ss_start.to_s())
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newdata = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte.off")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newdata.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newdata to i64")
    # Allocate 24-byte output header
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out = call ptr @__qz_alloc(i64 24)")
    # Store data_ptr at slot[0]
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newdata.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out")
    # Store len at slot[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".out.lenslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out.lenslot")
    # Store elem_width at slot[2] (same as source — sub-slice preserves stride)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".out.ewslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out.ewslot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".out to i64")
    return
  end

  if name == "slice_get"
    var s = args[0]
    var idx = args[1]
    var lbl = codegen_util::cg_next_label(state).to_s()
    # Tier 4 #24 wide-element follow-up: load elem_width from shdr[2],
    # byte-stride GEP, runtime branch: ew==8 → load i64 (scalar);
    # ew>8 → return pointer (matches vec_get @value direct-pointer return).
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sdata.i to ptr")
    # Load elem_width from shdr[2]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew.ptr")
    # Compute byte offset = idx * elem_width, GEP with i8 stride
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte.off = mul i64 %v")
    codegen_util::cg_emit(out, idx.to_s())
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte.off")
    # Runtime branch on ew==8
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_scalar = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew, 8")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_scalar, label %slice_get_scalar_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, ", label %slice_get_wide_")
    codegen_util::cg_emit_line(out, lbl)
    # Scalar path: load i64
    codegen_util::cg_emit(out, "slice_get_scalar_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".loaded = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep")
    codegen_util::cg_emit(out, "  br label %slice_get_done_")
    codegen_util::cg_emit_line(out, lbl)
    # Wide path: return pointer as i64 (direct view into Vec data)
    codegen_util::cg_emit(out, "slice_get_wide_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep_i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep to i64")
    codegen_util::cg_emit(out, "  br label %slice_get_done_")
    codegen_util::cg_emit_line(out, lbl)
    # Merge
    codegen_util::cg_emit(out, "slice_get_done_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".loaded, %slice_get_scalar_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep_i, %slice_get_wide_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  # Tier 4 #24 Phase 4b §2.2: byte_slice_get — 1-byte stride read + zext.
  # Slice header layout is identical to scalar slice ({data_ptr, len}) but
  # data_ptr points at a byte buffer (the String handle from
  # str_as_byte_slice). This is the only path where stride differs.
  if name == "byte_slice_get"
    var bs_s = args[0]
    var bs_idx = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, bs_s)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sdata.i to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata, i64 %v")
    codegen_util::cg_emit_line(out, bs_idx.to_s())
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ep")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte to i64")
    return
  end

  # Tier 4 #24 Phase 4b §2.3: Slice<T>::EMPTY / SliceMut<T>::EMPTY — a
  # 24-byte heap header with {data_ptr=0, len=0, elem_width=8}. Zero
  # allocations at the call site beyond the 24-byte malloc; .size returns 0,
  # so element accesses never dereference data_ptr regardless of stride.
  # elem_width=8 is the safe scalar default — the value is never actually
  # consulted because no element reads happen on a len=0 slice.
  if name == "slice_empty"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lenslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lenslot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ewslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 2")
    codegen_util::cg_emit(out, "  store i64 8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ewslot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr to i64")
    return
  end

  # Tier 4 #24 Phase 4b §2.2: str_as_byte_slice(s) — wrap a String's byte
  # buffer in a Slice<Byte> header without copying. data_ptr = the String
  # handle (which IS the byte pointer; see str_byte_at). len = qz_str_get_len.
  # Wide-element follow-up: 24-byte header w/ elem_width=1 (byte). The
  # ew slot is documentation only — byte_slice_get does its own i8 GEP and
  # never reads slot[2]; nothing else can dispatch on a Slice<Byte> stride.
  if name == "str_as_byte_slice"
    var bs_str = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, bs_str)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, bs_str)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lenslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lenslot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ewslot = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 2")
    codegen_util::cg_emit(out, "  store i64 1, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ewslot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr to i64")
    return
  end

  if name == "slice_size"
    var s = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slen.ptr")
    return
  end

  if name == "slice_set"
    var s = args[0]
    var idx = args[1]
    var val = args[2]
    var lbl = codegen_util::cg_next_label(state).to_s()
    # Tier 4 #24 wide-element follow-up: load elem_width from shdr[2],
    # byte-stride GEP, runtime branch: ew==8 → store i64 (scalar);
    # ew>8 → memcpy elem_width bytes from val (source ptr) into ep.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".shdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sdata.i to ptr")
    # Load elem_width from shdr[2]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".shdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew.ptr")
    # byte_off = idx * elem_width, GEP with i8 stride
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte.off = mul i64 %v")
    codegen_util::cg_emit(out, idx.to_s())
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ep = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sdata, i64 %v")
