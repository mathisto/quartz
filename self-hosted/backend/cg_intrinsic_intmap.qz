    codegen_util::cg_emit(out, ".key = load i64, ptr %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".key.p")
    # Read vlen, store key at vdata[vlen], increment vlen
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen.cur = load i64, ptr %ik")
