  if name == "intmap_keys"
    # Walk the `used` byte array at offset 4 to find occupied slots.
    # CANNOT delegate to hashmap_keys: that handler treats key values 0 and 1
    # as EMPTY/TOMBSTONE sentinels, but valid integer keys can be 0 or 1.
    var hmap = args[0]
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, hmap)
    codegen_util::cg_emit_line(out, " to ptr")
    # Load capacity
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
