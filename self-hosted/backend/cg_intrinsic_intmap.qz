    codegen_util::cg_emit(out, ".vdata, i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen.cur")
    codegen_util::cg_emit(out, "  store i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen.new = add i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen.cur, 1")
    codegen_util::cg_emit(out, "  store i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen.new, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen")
    codegen_util::cg_emit(out, "  br label %iv_cont_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next = add i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %iv_loop_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_end_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr to i64")
    return
  end

  if name == "intmap_clear"
    var hmap = args[0]
    # Set size field (offset 1) to 0
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, hmap)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.p = getelementptr i64, ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Zero the `used` occupancy array (offset 4, cap bytes) so subsequent
    # lookups don't find stale keys. Without this, clear-then-add-then-has
    # is wrong (and set_clear, which delegates here, would leak old members).
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.p = getelementptr i64, ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 4")
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.i = load i64, ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.p")
    codegen_util::cg_emit(out, "  %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used = inttoptr i64 %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.i to ptr")
    codegen_util::cg_emit(out, "  call void @memset(ptr %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used, i32 0, i64 %icl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

end
