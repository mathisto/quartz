    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldused.p")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldkeys)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
