    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [ 0, %ik_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next, %ik_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp sge i64 %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %ik_end_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ik_check_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ik_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Read used[i] (i8)
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u.p = getelementptr i8, ptr %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used, i64 %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u = load i8, ptr %ik")
