    codegen_util::cg_emit_line(out, ".imr.newkeys to i64")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newkeys.i, ptr %v")
