    codegen_util::cg_emit(out, ".u = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".u.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty = icmp eq i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".u, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, label %ims_store_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ims_check_")
    codegen_util::cg_emit_line(out, d)
    # Check if key matches
    codegen_util::cg_emit(out, "ims_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".k.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".keys, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".k = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".k.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".k, %v")
    codegen_util::cg_emit_line(out, key_arg.to_s())
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq, label %ims_store_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ims_cont_")
    codegen_util::cg_emit_line(out, d)
    # Continue probing
    codegen_util::cg_emit(out, "ims_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.raw = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next = urem i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.raw, %v")
