    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.i = load i64, ptr %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.p")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used = inttoptr i64 %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.i to ptr")
    # Allocate result vector (24-byte header + cap*8 data)
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".datasize = mul i64 %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap, 8")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vhdr = bitcast ptr %ik")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec to ptr")
    codegen_util::cg_emit(out, "  store i64 %ik")
    codegen_util::cg_emit(out, d)
