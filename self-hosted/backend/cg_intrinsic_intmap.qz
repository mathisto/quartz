##! # Integer-Key Map Intrinsics
##!
##! Emits LLVM IR for integer-keyed map operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

## Load a pointer field from the intmap header at a fixed i64 offset.
## Emits: GEP + load + inttoptr, defining %v{d}.{field} as ptr.
def _im_load_field(out: Int, d: String, field: String, offset: String): Void can Emit
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".#{field}.p = getelementptr i64, ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".hdr, i64 #{offset}")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".#{field}.i = load i64, ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".#{field}.p")
  codegen_util::cg_emit_inttoptr("#{d}.#{field}", "#{d}.#{field}.i", "ptr")
end

# ============================================================================
# Integer-Key Map Intrinsics (6 handlers)
# ============================================================================

def cg_emit_map_int_key(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "intmap_new"
    # Allocate 40-byte header
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 40)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr.p = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    # Store capacity = 16
    codegen_util::cg_emit(out, "  store i64 16, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p")
    # Store size = 0 at offset 1
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.p")
    # Allocate keys array (16 * 8 = 128 bytes)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".keys = call ptr @__qz_alloc(i64 128)")
    codegen_util::cg_emit_ptrtoint("#{d}.keys.i", "#{d}.keys", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".keys.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".keys.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".keys.p")
    # Allocate vals array (16 * 8 = 128 bytes)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vals = call ptr @__qz_alloc(i64 128)")
    codegen_util::cg_emit_ptrtoint("#{d}.vals.i", "#{d}.vals", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 3")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vals.p")
    # Allocate used array (16 bytes) and zero it
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used = call ptr @__qz_alloc(i64 16)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used, i32 0, i64 16)")
    codegen_util::cg_emit_ptrtoint("#{d}.used.i", "#{d}.used", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 4")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.p")
    # Return header pointer as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  if name == "intmap_set"
    var map_arg = args[0]
    var key_arg = args[1]
    var val_arg = args[2]
    # Load header
    codegen_util::cg_emit_inttoptr_is(dest, ".hdr", map_arg, "ptr")

    # ────────────────────────────────────────────────────────────────────────
    # Resize check: when size >= cap * 3/4, double the table and rehash.
    # Pre-resize fields are read into imr.* SSA names so the post-resize
    # field reloads (the existing _im_load_field block below) are not
    # shadowed. Both the resize-taken and resize-skipped paths converge at
    # `imr_done_<d>:` immediately before the cap/keys/vals/used reload.
    # Mirrors hashmap_set's resize block (cg_intrinsic_data.qz) but uses
    # `urem` modular addressing instead of bit-mask, and a separate `used`
    # byte array instead of EMPTY/TOMBSTONE sentinels in the keys array.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.cap0 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.size.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.size0 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.size.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.thresh3 = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.cap0, 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.thresh = sdiv i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.thresh3, 4")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.need = icmp sge i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.size0, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.thresh")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.need, label %imr_resize_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %imr_done_")
    codegen_util::cg_emit_line(out, d)

    # Resize block: allocate new arrays at 2x capacity, rehash all valid
    # entries, swap header pointers, free old arrays. Old keys/vals/used
    # pointers loaded locally with imr.old* names; new arrays held in imr.new*.
    codegen_util::cg_emit(out, "imr_resize_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldkeys.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldkeys.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldkeys.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldkeys = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldkeys.i to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldvals.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldvals.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldvals.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldvals = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldvals.i to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldused.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 4")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldused.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldused.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldused = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.oldused.i to ptr")
    # Allocate new arrays at 2x capacity. cap doubles, used byte array stays cap bytes.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newcap = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.cap0, 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newkvsz = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newcap, 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newkeys = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newkvsz)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newvals = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newkvsz)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newused = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newcap)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newused, i32 0, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newcap)")
    codegen_util::cg_emit(out, "  br label %imr_rehash_")
    codegen_util::cg_emit_line(out, d)
    # Rehash loop: walk old slots, copy occupied entries into new arrays.
    codegen_util::cg_emit(out, "imr_rehash_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ri = phi i64 [0, %imr_resize_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rnext, %imr_rehash_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rdone = icmp sge i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ri, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.cap0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rdone, label %imr_rehash_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %imr_rehash_check_")
    codegen_util::cg_emit_line(out, d)
    # Check if old slot ri is occupied
    codegen_util::cg_emit(out, "imr_rehash_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ouptr = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldused, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ri")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ub = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ouptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.occupied = icmp ne i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ub, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.occupied, label %imr_rehash_copy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %imr_rehash_cont_")
    codegen_util::cg_emit_line(out, d)
    # Load old key+value, compute new index
    codegen_util::cg_emit(out, "imr_rehash_copy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.okp = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldkeys, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ri")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ok = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.okp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ovp = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.oldvals, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ri")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ov = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.ovp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rstart = urem i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ok, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newcap")
    codegen_util::cg_emit(out, "  br label %imr_rehash_probe_")
    codegen_util::cg_emit_line(out, d)
    # Linear probe in new table for an empty slot
    codegen_util::cg_emit(out, "imr_rehash_probe_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rpi = phi i64 [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rstart, %imr_rehash_copy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rpnext, %imr_rehash_probe_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.nuptr = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newused, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.rpi")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.nub = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.nuptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.nempty = icmp eq i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.nub, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.nempty, label %imr_rehash_insert_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %imr_rehash_probe_cont_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "imr_rehash_probe_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rpnext.raw = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.rpi, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rpnext = urem i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.rpnext.raw, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.newcap")
    codegen_util::cg_emit(out, "  br label %imr_rehash_probe_")
    codegen_util::cg_emit_line(out, d)
    # Insert into new table
    codegen_util::cg_emit(out, "imr_rehash_insert_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.nkp = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.newkeys, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.rpi")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imr.ok, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imr.nkp")
    codegen_util::cg_emit(out, "  %v")
