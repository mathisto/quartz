  end

  if name == "intmap_values"
    # Same issue as intmap_keys: hashmap_values skips keys 0/1 as sentinels.
    # Walk used[] and emit values[i] where used[i] != 0.
    var hmap = args[0]
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, hmap)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    # Load vals ptr (offset 3)
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals.p = getelementptr i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 3")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals.i = load i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vals.p")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals = inttoptr i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vals.i to ptr")
    # Load used ptr (offset 4)
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.p = getelementptr i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 4")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used.i = load i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.p")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used = inttoptr i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".used.i to ptr")
    # Allocate result vector
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".datasize = mul i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap, 8")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vhdr = bitcast ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec to ptr")
    codegen_util::cg_emit(out, "  store i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen = getelementptr i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata = call ptr @__qz_alloc(i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".datasize)")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.i = ptrtoint ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vdata to i64")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.p = getelementptr i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vhdr, i64 2")
    codegen_util::cg_emit(out, "  store i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.i, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vdata.p")
    codegen_util::cg_emit(out, "  br label %iv_pre_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %iv_loop_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_loop_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [ 0, %iv_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next, %iv_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp sge i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %iv_end_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %iv_check_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u.p = getelementptr i8, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used, i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u = load i8, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".u.p")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".occupied = icmp ne i8 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".u, 0")
    codegen_util::cg_emit(out, "  br i1 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".occupied, label %iv_add_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %iv_cont_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "iv_add_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals, i64 %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen.cur = load i64, ptr %iv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen")
    codegen_util::cg_emit(out, "  %iv")
