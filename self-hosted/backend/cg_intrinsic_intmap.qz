    codegen_util::cg_emit(out, ".eq = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".k, %v")
    codegen_util::cg_emit_line(out, key_arg.to_s())
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq, label %img_found_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %img_cont_")
    codegen_util::cg_emit_line(out, d)
    # Continue probing
    codegen_util::cg_emit(out, "img_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.raw = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next = urem i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.raw, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.inc = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 1")
    codegen_util::cg_emit(out, "  br label %img_loop_")
    codegen_util::cg_emit_line(out, d)
    # Found - load value, wrap in Option::Some
    codegen_util::cg_emit(out, "img_found_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vals, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx")
