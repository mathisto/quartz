    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.p2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newsize = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size, 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newsize, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.p2")
    codegen_util::cg_emit(out, "  br label %ims_done_")
    codegen_util::cg_emit_line(out, d)
    # Done
    codegen_util::cg_emit(out, "ims_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "intmap_get"
    var map_arg = args[0]
    var key_arg = args[1]
    # Load header
    codegen_util::cg_emit_inttoptr_is(dest, ".hdr", map_arg, "ptr")
    # Load capacity
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    _im_load_field(out, d, "keys", "2")
    _im_load_field(out, d, "vals", "3")
    _im_load_field(out, d, "used", "4")
    # Compute hash = key % capacity
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hash = urem i64 %v")
    codegen_util::cg_emit_int(out, key_arg)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    # Branch to probe loop
    codegen_util::cg_emit(out, "  br label %img_pre_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "img_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %img_loop_")
    codegen_util::cg_emit_line(out, d)
    # Probe loop with counter to prevent infinite loop
    codegen_util::cg_emit(out, "img_loop_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".idx = phi i64 [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hash, %img_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next, %img_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = phi i64 [0, %img_pre_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.inc, %img_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    # Check if we've searched entire table
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".maxed = icmp sge i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".maxed, label %img_notfound_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %img_check_")
    codegen_util::cg_emit_line(out, d)
    # Check if slot is used
    codegen_util::cg_emit(out, "img_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u.ptr = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".used, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".u = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".u.ptr")
    codegen_util::cg_emit(out, "  %v")
