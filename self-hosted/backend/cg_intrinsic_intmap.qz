    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, label %img_cont_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %img_cmp_")
    codegen_util::cg_emit_line(out, d)
    # Compare key
    codegen_util::cg_emit(out, "img_cmp_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".k.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".keys, i64 %v")
