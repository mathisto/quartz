      end
    end
    var _p4b_args = vec_new<Int>()
    _p4b_args.push(yield_val)
    ctx.mir_emit_perform_op("yield", "Yield", 3, _p4b_args)
    return
  end
  var _p4b_args2 = vec_new<Int>()
  _p4b_args2.push(yield_val)
  mir_emit_kind3_perform_suspend(ctx, "yield", "Yield", _p4b_args2)
end
