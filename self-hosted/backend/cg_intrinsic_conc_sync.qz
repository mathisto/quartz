##! # Concurrency Intrinsics: conc_sync
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

def cg_emit_conc_sync(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  # ---- Resource cleanup intrinsics ----

  if name == "channel_free"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; channel_free: close notify pipe fds, destroy mutex+condvar, free memory")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ch = inttoptr i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, " to ptr")
    # Close notification pipe fds if they were created (fd != -1)
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 152")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd.p = bitcast ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.gep to ptr")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.p")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_rfd = icmp ne i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd, -1")
    codegen_util::cg_emit(out, "  br i1 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_rfd, label %chf_close_rfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %chf_skip_rfd_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_close_rfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd32 = trunc i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd to i32")
    codegen_util::cg_emit(out, "  call i32 @close(i32 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd32)")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 160")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.p = bitcast ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.gep to ptr")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.p")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = trunc i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd to i32")
    codegen_util::cg_emit(out, "  call i32 @close(i32 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd32)")
    codegen_util::cg_emit(out, "  br label %chf_skip_rfd_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_skip_rfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Close send notification pipe fds if they were created (fd != -1)
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 184")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd.p = bitcast ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd.gep to ptr")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd.p")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_snrfd = icmp ne i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd, -1")
    codegen_util::cg_emit(out, "  br i1 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_snrfd, label %chf_close_snrfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %chf_skip_snrfd_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_close_snrfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd32 = trunc i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd to i32")
    codegen_util::cg_emit(out, "  call i32 @close(i32 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd32)")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snwfd.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 192")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snwfd.p = bitcast ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snwfd.gep to ptr")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snwfd = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snwfd.p")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snwfd32 = trunc i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snwfd to i32")
    codegen_util::cg_emit(out, "  call i32 @close(i32 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snwfd32)")
    codegen_util::cg_emit(out, "  br label %chf_skip_snrfd_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_skip_snrfd_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # pthread_mutex_destroy at offset 0
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 0")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_destroy(ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # pthread_cond_destroy at offset 64
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 64")
    codegen_util::cg_emit(out, "  call i32 @pthread_cond_destroy(ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd)")
    # Phase 17: If unbounded (cap==-1), walk linked list and free all nodes
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 112")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.gep")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub = icmp eq i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap, -1")
    codegen_util::cg_emit(out, "  br i1 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub, label %chf_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %chf_free_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Walk linked list from head, free each node
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head.gep = getelementptr i8, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 128")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head0 = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head.gep")
    codegen_util::cg_emit(out, "  br label %chf_ub_loop_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_ub_loop_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cur = phi i64 [ %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head0, %chf_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nxt, %chf_ub_next_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_null = icmp eq i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cur, 0")
    codegen_util::cg_emit(out, "  br i1 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_null, label %chf_free_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %chf_ub_next_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_ub_next_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".np = inttoptr i64 %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cur to ptr")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next_p = getelementptr i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".np, i64 1")
    codegen_util::cg_emit(out, "  %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nxt = load i64, ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next_p")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".np)")
    codegen_util::cg_emit(out, "  br label %chf_ub_loop_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "chf_free_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # free the channel memory
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %chf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "mutex_free"
    var mx = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; mutex_free: destroy mutex, free memory")
    codegen_util::cg_emit(out, "  %mxf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %mxf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %mxf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 0")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_destroy(ptr %mxf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %mxf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # ---- RWLock intrinsics ----
  # Layout: [pthread_rwlock_t @ 0-199 (200 bytes on macOS), value @ 200]
  # Total: 208 bytes

  if name == "rwlock_new"
    var init_val = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; rwlock_new: alloc 208 bytes for rwlock + value")
    codegen_util::cg_emit(out, "  %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 208)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i32 0, i64 208)")
    codegen_util::cg_emit(out, "  call i32 @pthread_rwlock_init(ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, ptr null)")
    codegen_util::cg_emit(out, "  %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 200")
    codegen_util::cg_emit(out, "  %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, init_val)
    codegen_util::cg_emit(out, ", ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %rw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem to i64")
    return 1
  end

  if name == "rwlock_read"
    var rw = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; rwlock_read: acquire read lock, return value")
    codegen_util::cg_emit(out, "  %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw = inttoptr i64 %v")
    codegen_util::cg_emit(out, rw)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_rwlock_rdlock(ptr %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw)")
    codegen_util::cg_emit(out, "  %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw, i64 200")
    codegen_util::cg_emit(out, "  %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %rr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    return 1
  end

  if name == "rwlock_read_unlock"
    var rw = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; rwlock_read_unlock: release read lock")
    codegen_util::cg_emit(out, "  %rru")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw = inttoptr i64 %v")
    codegen_util::cg_emit(out, rw)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_rwlock_unlock(ptr %rru")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "rwlock_try_read"
    var rw = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; rwlock_try_read: non-blocking read-lock, returns value or -1 if locked")
    codegen_util::cg_emit(out, "  %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw = inttoptr i64 %v")
    codegen_util::cg_emit(out, rw)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rc = call i32 @pthread_rwlock_tryrdlock(ptr %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw)")
    codegen_util::cg_emit(out, "  %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".failed = icmp ne i32 %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rc, 0")
    codegen_util::cg_emit(out, "  br i1 %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".failed, label %rtr_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rtr_ok_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rtr_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %rtr_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rtr_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %rtr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %rtr")
