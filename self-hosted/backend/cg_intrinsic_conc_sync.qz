    var cell = args[0].to_s()
    var init_fn = args[1].to_s()
    codegen_util::cg_emit_line(out, "  ; oncecell_get_or_init: double-checked locking")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cell = inttoptr i64 %v")
    codegen_util::cg_emit(out, cell)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".state.p = bitcast ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell to ptr")
    # Fast path: check state without lock
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".state0 = load atomic i64, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state.p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ready = icmp eq i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state0, 1")
    codegen_util::cg_emit(out, "  br i1 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ready, label %oci_fast_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %oci_slow_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_fast_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep1 = getelementptr i8, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 8")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p1 = bitcast ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep1 to ptr")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val1 = load i64, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p1")
    codegen_util::cg_emit(out, "  br label %oci_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_slow_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Slow path: lock, double-check, init if needed
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 16")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".state1 = load atomic i64, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state.p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ready2 = icmp eq i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state1, 1")
    codegen_util::cg_emit(out, "  br i1 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ready2, label %oci_unlock_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %oci_init_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_init_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Call init function (closure dispatch)
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn.tag = and i64 %v")
    codegen_util::cg_emit(out, init_fn)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn.is_cl = icmp eq i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn.tag, 1")
    codegen_util::cg_emit(out, "  br i1 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn.is_cl, label %oci_cl_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %oci_pl_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_cl_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env.i = and i64 %v")
    codegen_util::cg_emit(out, init_fn)
    codegen_util::cg_emit_line(out, ", -2")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env.p = inttoptr i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.i to ptr")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn.i = load i64, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.p")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn = inttoptr i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cfn.i to i64 (i64)*")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cres = call i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn(i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.i)")
    codegen_util::cg_emit(out, "  br label %oci_store_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_pl_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfn = inttoptr i64 %v")
    codegen_util::cg_emit(out, init_fn)
    codegen_util::cg_emit_line(out, " to i64 ()*")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pres = call i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfn()")
    codegen_util::cg_emit(out, "  br label %oci_store_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_store_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".init_val = phi i64 [%oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cres, %oci_cl_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pres, %oci_pl_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep2 = getelementptr i8, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 8")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p2 = bitcast ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep2 to ptr")
    codegen_util::cg_emit(out, "  store i64 %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".init_val, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p2")
    codegen_util::cg_emit(out, "  store atomic i64 1, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state.p seq_cst, align 8")
    codegen_util::cg_emit(out, "  br label %oci_unlock_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_unlock_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep3 = getelementptr i8, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 8")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p3 = bitcast ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep3 to ptr")
    codegen_util::cg_emit(out, "  %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val2 = load i64, ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p3")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %oci_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "oci_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val1, %oci_fast_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [%oci")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val2, %oci_unlock_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    return 1
  end

  if name == "oncecell_get"
    var cell = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; oncecell_get: return value (panic if uninitialized)")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cell = inttoptr i64 %v")
    codegen_util::cg_emit(out, cell)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".state.p = bitcast ptr %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell to ptr")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".state = load atomic i64, ptr %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state.p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = icmp eq i64 %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".state, 1")
    codegen_util::cg_emit(out, "  br i1 %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok, label %ocg_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ocg_panic_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ocg_panic_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_line(out, "  call void @abort()")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "ocg_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 8")
    codegen_util::cg_emit(out, "  %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %ocg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    return 1
  end

  if name == "oncecell_free"
    var cell = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; oncecell_free: destroy mutex, free memory")
    codegen_util::cg_emit(out, "  %ocf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cell = inttoptr i64 %v")
    codegen_util::cg_emit(out, cell)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ocf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %ocf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell, i64 16")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_destroy(ptr %ocf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %ocf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cell)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # ---- Deadline cancel token ----

  if name == "cancel_token_with_deadline"
    var timeout_ms = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; cancel_token_with_deadline: create token + spawn timeout thread")
    # Create the cancel token (8 bytes, initialized to 0)
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw = call ptr @__qz_alloc(i64 8)")
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = bitcast ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw to ptr")
    codegen_util::cg_emit(out, "  store i64 0, ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, align 8")
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tok = ptrtoint ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p to i64")
    # Allocate env for deadline thread: [token_ptr, timeout_ms]
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env = call ptr @__qz_alloc(i64 16)")
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env.p = bitcast ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env to ptr")
    codegen_util::cg_emit(out, "  store i64 %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tok, ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.p")
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env.ms = getelementptr i64, ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.p, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, timeout_ms)
    codegen_util::cg_emit(out, ", ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env.ms")
    # Spawn detached thread
    codegen_util::cg_emit(out, "  %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tid = alloca i64")
    codegen_util::cg_emit(out, "  call i32 @pthread_create(ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tid, ptr null, ptr @__qz_deadline_thread, ptr %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %ctd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tok, 0")
    return 1
  end

  return 0
end
