##! # SIMD Intrinsics
##!
##! Emits LLVM IR for SIMD vector operations.
##! Includes masked gather/scatter helpers.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# SIMD Masked Gather/Scatter Helpers
# ============================================================================

## Build a <N x ptr> vector from base pointer + <N x i32> offsets.
## Emits: extractelement each offset, sext to i64, GEP from base, insertelement into ptr vector.
def cg_emit_build_ptr_vector(out: Int, d: String, elem_type: String, ptr_vec_type: String, off_vec_type: String, lane_count: Int): Void
  for lane in 0..lane_count
    var ls = "#{lane}"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off")
    codegen_util::cg_emit(out, ls)
    codegen_util::cg_emit(out, " = extractelement ")
    codegen_util::cg_emit(out, off_vec_type)
    codegen_util::cg_emit(out, " %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".offsets, i32 ")
    codegen_util::cg_emit_line(out, ls)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off")
    codegen_util::cg_emit(out, ls)
    codegen_util::cg_emit(out, ".ext = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off")
    codegen_util::cg_emit(out, ls)
    codegen_util::cg_emit_line(out, " to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gep")
    codegen_util::cg_emit(out, ls)
    codegen_util::cg_emit(out, " = getelementptr ")
    codegen_util::cg_emit(out, elem_type)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".base, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off")
    codegen_util::cg_emit(out, ls)
    codegen_util::cg_emit_line(out, ".ext")
    if lane == 0
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".pvec")
      codegen_util::cg_emit(out, ls)
      codegen_util::cg_emit(out, " = insertelement ")
      codegen_util::cg_emit(out, ptr_vec_type)
      codegen_util::cg_emit(out, " poison, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".gep")
      codegen_util::cg_emit(out, ls)
      codegen_util::cg_emit(out, ", i32 ")
      codegen_util::cg_emit_line(out, ls)
    else
      var prev = "#{lane - 1}"
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".pvec")
      codegen_util::cg_emit(out, ls)
      codegen_util::cg_emit(out, " = insertelement ")
      codegen_util::cg_emit(out, ptr_vec_type)
      codegen_util::cg_emit(out, " %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".pvec")
      codegen_util::cg_emit(out, prev)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".gep")
      codegen_util::cg_emit(out, ls)
      codegen_util::cg_emit(out, ", i32 ")
      codegen_util::cg_emit_line(out, ls)
    end
  end
end

## Emit a masked gather: gather(base_ptr, offsets_vec, mask_vec) → result_vec.
## args[0]=base_ptr, args[1]=offsets_i32xN, args[2]=mask_i32xN
def cg_emit_masked_gather(out: Int, d: String, args: Vec<Int>, elem_type: String, vec_type: String, off_vec_type: String, mask_type: String, ptr_vec_type: String, lane_count: Int, align: Int, intrinsic_suffix: String): Void
  var base = args[0]
  var offsets_arg = args[1]
  var mask_arg = args[2]
  var last = "#{lane_count - 1}"
  # Base pointer
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".base = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, base)
  codegen_util::cg_emit_line(out, " to ptr")
  # Load offsets vector
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".off_ptr = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, offsets_arg)
  codegen_util::cg_emit_line(out, " to ptr")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".offsets = load ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, ", ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".off_ptr")
  # Load mask vector
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask_ptr = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, mask_arg)
  codegen_util::cg_emit_line(out, " to ptr")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask_i32 = load ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, ", ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".mask_ptr")
  # Build pointer vector from base + offsets
  cg_emit_build_ptr_vector(out, d, elem_type, ptr_vec_type, off_vec_type, lane_count)
  # Convert i32 mask to i1 mask
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask = icmp ne ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".mask_i32, zeroinitializer")
  # Call masked gather intrinsic
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".result = call ")
  codegen_util::cg_emit(out, vec_type)
  codegen_util::cg_emit(out, " @llvm.masked.gather.")
  codegen_util::cg_emit(out, intrinsic_suffix)
  codegen_util::cg_emit(out, "(")
  codegen_util::cg_emit(out, ptr_vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".pvec")
  codegen_util::cg_emit(out, last)
  codegen_util::cg_emit(out, ", i32 ")
  codegen_util::cg_emit_int(out, align)
  codegen_util::cg_emit(out, ", ")
  codegen_util::cg_emit(out, mask_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask, ")
  codegen_util::cg_emit(out, vec_type)
  codegen_util::cg_emit_line(out, " zeroinitializer)")
  # Store result and return as i64
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".alloca = alloca ")
  codegen_util::cg_emit_line(out, vec_type)
  codegen_util::cg_emit(out, "  store ")
  codegen_util::cg_emit(out, vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".result, ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".alloca")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, " = ptrtoint ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".alloca to i64")
end

## Emit a masked scatter: scatter(values_vec, base_ptr, offsets_vec, mask_vec).
## args[0]=values, args[1]=base_ptr, args[2]=offsets_i32xN, args[3]=mask_i32xN
def cg_emit_masked_scatter(out: Int, d: String, args: Vec<Int>, elem_type: String, vec_type: String, off_vec_type: String, mask_type: String, ptr_vec_type: String, lane_count: Int, align: Int, intrinsic_suffix: String): Void
  var values_arg = args[0]
  var base = args[1]
  var offsets_arg = args[2]
  var mask_arg = args[3]
  var last = "#{lane_count - 1}"
  # Load values vector
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".val_ptr = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, values_arg)
  codegen_util::cg_emit_line(out, " to ptr")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".values = load ")
  codegen_util::cg_emit(out, vec_type)
  codegen_util::cg_emit(out, ", ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".val_ptr")
  # Base pointer
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".base = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, base)
  codegen_util::cg_emit_line(out, " to ptr")
  # Load offsets vector
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".off_ptr = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, offsets_arg)
  codegen_util::cg_emit_line(out, " to ptr")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".offsets = load ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, ", ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".off_ptr")
  # Load mask vector
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask_ptr = inttoptr i64 %v")
  codegen_util::cg_emit_int(out, mask_arg)
  codegen_util::cg_emit_line(out, " to ptr")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask_i32 = load ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, ", ptr %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".mask_ptr")
  # Build pointer vector from base + offsets
  cg_emit_build_ptr_vector(out, d, elem_type, ptr_vec_type, off_vec_type, lane_count)
  # Convert i32 mask to i1 mask
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".mask = icmp ne ")
  codegen_util::cg_emit(out, off_vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".mask_i32, zeroinitializer")
  # Call masked scatter intrinsic
  codegen_util::cg_emit(out, "  call void @llvm.masked.scatter.")
  codegen_util::cg_emit(out, intrinsic_suffix)
  codegen_util::cg_emit(out, "(")
  codegen_util::cg_emit(out, vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".values, ")
  codegen_util::cg_emit(out, ptr_vec_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit(out, ".pvec")
  codegen_util::cg_emit(out, last)
  codegen_util::cg_emit(out, ", i32 ")
  codegen_util::cg_emit_int(out, align)
  codegen_util::cg_emit(out, ", ")
  codegen_util::cg_emit(out, mask_type)
  codegen_util::cg_emit(out, " %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, ".mask)")
  codegen_util::cg_emit(out, "  %v")
  codegen_util::cg_emit(out, d)
  codegen_util::cg_emit_line(out, " = add i64 0, 0")
end

# ============================================================================
# Simd Intrinsics (63 handlers)
# ============================================================================

def cg_emit_intrinsic_simd(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "simd_f32x4_splat"
    var val = args[0]
    var vl = val.to_s()
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dbl = bitcast i64 %v")
    codegen_util::cg_emit(out, vl)
    codegen_util::cg_emit_line(out, " to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flt = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dbl to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v0 = insertelement <4 x float> undef, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flt, i32 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v1 = insertelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v0, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flt, i32 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v2 = insertelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v1, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flt, i32 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec = insertelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v2, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flt, i32 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <4 x float>")
    codegen_util::cg_emit(out, "  store <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  if name == "simd_f32x4_add"
    var a = args[0]
    var b = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bp = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, b)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bv = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = fadd <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bv")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <4 x float>")
    codegen_util::cg_emit(out, "  store <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  if name == "simd_f32x4_sub"
    var a = args[0]
    var b = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bp = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, b)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bv = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = fsub <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bv")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <4 x float>")
    codegen_util::cg_emit(out, "  store <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  if name == "simd_f32x4_mul"
    var a = args[0]
    var b = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bp = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, b)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bv = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = fmul <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bv")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
