    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <4 x i32>, <4 x i32>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = sitofp <4 x i32> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".av to <4 x float>")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <4 x float>")
    codegen_util::cg_emit(out, "  store <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  if name == "simd_convert_f32x4_to_f64x2"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to <4 x float>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <4 x float>, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e0 = extractelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".av, i32 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e1 = extractelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".av, i32 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d0 = fpext float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e0 to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1 = fpext float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e1 to double")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ins0 = insertelement <2 x double> undef, double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d0, i32 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = insertelement <2 x double> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ins0, double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1, i32 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <2 x double>")
    codegen_util::cg_emit(out, "  store <2 x double> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv, <2 x double>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <2 x double>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  if name == "simd_convert_f64x2_to_f32x4"
    var a = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ap = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit_line(out, " to <2 x double>*")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".av = load <2 x double>, <2 x double>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e0 = extractelement <2 x double> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".av, i32 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e1 = extractelement <2 x double> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".av, i32 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f0 = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e0 to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".f1 = fptrunc double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e1 to float")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ins0 = insertelement <4 x float> zeroinitializer, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f0, i32 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv = insertelement <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ins0, float %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".f1, i32 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca = alloca <4 x float>")
    codegen_util::cg_emit(out, "  store <4 x float> %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rv, <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint <4 x float>* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloca to i64")
    return
  end

  # ---- Gather: vector API (base_ptr, offsets_vec, mask_vec) ----
  # Uses @llvm.masked.gather for hardware-accelerated gather (AVX2/AVX-512/SVE)

  if name == "simd_f32x4_gather"
    cg_emit_masked_gather(out, d, args, "float", "<4 x float>", "<4 x i32>", "<4 x i1>", "<4 x ptr>", 4, 4, "v4f32.v4p0")
    return
  end

  if name == "simd_f64x2_gather"
    cg_emit_masked_gather(out, d, args, "double", "<2 x double>", "<2 x i32>", "<2 x i1>", "<2 x ptr>", 2, 8, "v2f64.v2p0")
    return
  end

  if name == "simd_i32x4_gather"
    cg_emit_masked_gather(out, d, args, "i32", "<4 x i32>", "<4 x i32>", "<4 x i1>", "<4 x ptr>", 4, 4, "v4i32.v4p0")
    return
  end

  if name == "simd_f32x8_gather"
    cg_emit_masked_gather(out, d, args, "float", "<8 x float>", "<8 x i32>", "<8 x i1>", "<8 x ptr>", 8, 4, "v8f32.v8p0")
    return
  end

  # ---- Scatter: vector API (values_vec, base_ptr, offsets_vec, mask_vec) ----
  # Uses @llvm.masked.scatter for hardware-accelerated scatter

  if name == "simd_f32x4_scatter"
    cg_emit_masked_scatter(out, d, args, "float", "<4 x float>", "<4 x i32>", "<4 x i1>", "<4 x ptr>", 4, 4, "v4f32.v4p0")
    return
  end

  if name == "simd_f64x2_scatter"
    cg_emit_masked_scatter(out, d, args, "double", "<2 x double>", "<2 x i32>", "<2 x i1>", "<2 x ptr>", 2, 8, "v2f64.v2p0")
    return
  end

  if name == "simd_i32x4_scatter"
    cg_emit_masked_scatter(out, d, args, "i32", "<4 x i32>", "<4 x i32>", "<4 x i1>", "<4 x ptr>", 4, 4, "v4i32.v4p0")
    return
  end

  if name == "simd_f32x8_scatter"
    cg_emit_masked_scatter(out, d, args, "float", "<8 x float>", "<8 x i32>", "<8 x i1>", "<8 x ptr>", 8, 4, "v8f32.v8p0")
    return
  end

end
