##! # I/O Intrinsics
##!
##! Emits LLVM IR for print, file, and stream I/O operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# I/O Intrinsics (31 handlers)
# ============================================================================

def cg_emit_intrinsic_io(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  # D.11 Phase 8b.2.b — under freestanding (no libc), print-class intrinsics
  # emit no-op IR yielding i64 0. Diagnostic prints in stdlib (eputs in
  # std/net/hpack.qz for HPACK decode errors, eputs in std/net/http_server.qz
  # for h2 diag) are not load-bearing; the kernel's debug surface is uart_*
  # (kernel-side), not libc fprintf/write/puts. This matches the existing
  # freestanding precedent — qz_print_backtrace is a no-op, panic helpers
  # are stubs. Hosted builds keep the existing libc-emit shape.
  if codegen_util::cg_state_is_freestanding(state)
    if name == "puts" or name == "eputs" or name == "print" or name == "eprint" or name == "print_int" or name == "eprint_int"
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return
    end
  end

  if name == "puts"
    var arg = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", arg, "ptr")

    # Check if second arg provided and is false (0)
    if args.size > 1
      var newline_arg = args[1]
      # Check if newline arg is false (value 0)
      # Emit conditional: if newline_arg == 0, use printf, else use puts
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".nl = icmp eq i64 %v")
      codegen_util::cg_emit_int(out, newline_arg)
      codegen_util::cg_emit_line(out, ", 0")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".nl, label %puts.noline.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ", label %puts.line.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "puts.noline.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fmt = getelementptr [3 x i8], [3 x i8]* @.fmt.s, i64 0, i64 0")
      codegen_util::cg_emit(out, "  call i64 (ptr, ...) @printf(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fmt, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
      codegen_util::cg_emit(out, "  br label %puts.done.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "puts.line.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  call i64 @puts(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
      codegen_util::cg_emit(out, "  br label %puts.done.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "puts.done.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
    else
      # Default: use puts (with newline)
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = call i64 @puts(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
    end
    return
  end

  if name == "eputs"
    var arg = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    # Platform-specific stderr access — must mirror the declare emitted in
    # codegen_runtime::cg_emit_runtime_declares. macOS: @__stderrp. Linux:
    # @stderr. Windows (mingw-w64 UCRT): call ptr @__acrt_iob_func(i32 2)
    # (no global). Latent bug pre-Phase-1: this site hardcoded @__stderrp,
    # which would fail to link on Linux + Windows. The Linux case was masked
    # because most code uses stdout-side `puts` / `println`; surfaced first
    # by the hyperbouba cross-compile to x86_64-pc-windows-gnu.
    if codegen_util::cg_state_is_windows(state)
      codegen_util::cg_emit_line(out, ".stderr = call ptr @__acrt_iob_func(i32 2)")
    elsif str_contains(state.target_triple, "linux")
      codegen_util::cg_emit_line(out, ".stderr = load ptr, ptr @stderr")
    else
      codegen_util::cg_emit_line(out, ".stderr = load ptr, ptr @__stderrp")
    end

    if args.size > 1
      var newline_arg = args[1]
      # Conditional format string
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".nl = icmp eq i64 %v")
      codegen_util::cg_emit_int(out, newline_arg)
      codegen_util::cg_emit_line(out, ", 0")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".nl, label %eputs.noline.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ", label %eputs.line.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "eputs.noline.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fmt.no = getelementptr [3 x i8], [3 x i8]* @.fmt.s, i64 0, i64 0")
      codegen_util::cg_emit(out, "  call i32 (ptr, ptr, ...) @fprintf(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".stderr, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fmt.no, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
      codegen_util::cg_emit(out, "  br label %eputs.done.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "eputs.line.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fmt.yes = getelementptr [4 x i8], [4 x i8]* @.fmt.sn, i64 0, i64 0")
      codegen_util::cg_emit(out, "  call i32 (ptr, ptr, ...) @fprintf(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".stderr, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fmt.yes, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
      codegen_util::cg_emit(out, "  br label %eputs.done.")
      codegen_util::cg_emit_line(out, d)
      codegen_util::cg_emit(out, "eputs.done.")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
    else
      # Default: with newline
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fmt = getelementptr [4 x i8], [4 x i8]* @.fmt.sn, i64 0, i64 0")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".unused = call i32 (ptr, ptr, ...) @fprintf(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".stderr, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fmt, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ptr)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
    end
    return
  end

  if name == "print"
    var arg = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", arg, "ptr")
    # Buffered stdout via libc printf("%s", ptr) — shares the single libc
    # FILE* stdout buffer with `puts` (@puts / @printf no-newline path) and
    # `print_int` (@printf), so output from mixed print/puts calls stays in
    # program order. The previous raw `write(1, ...)` syscall bypassed the
    # libc buffer: under a buffered stdout (pipe or file) every `print` flushed
    # immediately while `puts` accumulated in the buffer until exit, so all
    # `print` output raced ahead of all `puts` output. Matches the existing
    # `@.fmt.s` ("%s") format used by the puts no-newline path: NUL-terminated
    # (Quartz strings always are), no format-string injection. See A.44.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fmt = getelementptr [3 x i8], [3 x i8]* @.fmt.s, i64 0, i64 0")
    codegen_util::cg_emit(out, "  call i64 (ptr, ...) @printf(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fmt, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "eprint"
    var arg = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @write(i32 2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len)")
    return
  end

  if name == "print_int"
    var arg = args[0]
    codegen_util::cg_emit(out, "  call void @print_int(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "eprint_int"
    var arg = args[0]
    codegen_util::cg_emit(out, "  call void @eprint_int(i64 %v")
    codegen_util::cg_emit_int(out, arg)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "path_join"
    var a = args[0]
    var b = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_path_join(i64 %v")
    codegen_util::cg_emit_int(out, a)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, b)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "path_ext"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_path_ext(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "path_dir"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_path_dir(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "path_basename"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_path_basename(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "mkdir"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 @mkdir(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s, i32 493)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "readdir"
    var p = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_readdir(i64 %v")
    codegen_util::cg_emit_int(out, p)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "getcwd"
    # Allocate a 4096-byte buffer for the path
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf = alloca i8, i64 4096, align 8")
    # Call POSIX getcwd(buf, 4096)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result = call ptr @getcwd(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf, i64 4096)")
    # Check for null (should not happen with 4096 buffer, but be safe)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".result, null")
    var lbl = codegen_util::cg_next_label(state).to_s()
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull, label %getcwd_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, ", label %getcwd_ok_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "getcwd_ok_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Wrap the C string into a Quartz length-prefixed string
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".result)")
    codegen_util::cg_emit(out, "  br label %getcwd_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "getcwd_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = getelementptr <{ i64, [1 x i8] }>, <{ i64, [1 x i8] }>* @.empty_string, i64 0, i32 1, i64 0")
    codegen_util::cg_emit(out, "  br label %getcwd_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "getcwd_done_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = phi ptr [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped, %getcwd_ok_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, %getcwd_null_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.ptr", "ptr")
    return
  end

  if name == "chdir"
    var p = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".s", p, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 @chdir(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "rmdir"
    var p = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".s", p, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 @rmdir(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "rename"
    var old_path = args[0]
    var new_path = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".old", old_path, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".new", new_path, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call i32 @rename(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".old, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r to i64")
    return
  end

  if name == "read_file"
    var args = mir::mir_instr_get_args(instr)
    var path_arg = args[0]
    var path = codegen_util::cg_format_operand(path_arg)
    var lbl = codegen_util::cg_next_label(state)
    var lbl_str = lbl.to_s()
    # Convert path to char*
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".path = inttoptr i64 ")
    codegen_util::cg_emit(out, path)
    codegen_util::cg_emit_line(out, " to ptr")
    # Open file (FILE* is opaque i8* for portability)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp = call ptr @fopen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".path, ptr getelementptr([2 x i8], [2 x i8]* @.read_mode, i64 0, i64 0))")
    # NULL check - branch to fail if fopen returned null
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp.null = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp.null, label %read_fail_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit(out, ", label %read_ok_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, "")
    # Success path
    codegen_util::cg_emit(out, "read_ok_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, ":")
    # Seek to end
    codegen_util::cg_emit(out, "  call i32 @fseek(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp, i64 0, i32 2)")
    # Get size
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size = call i64 @ftell(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Rewind to start
    codegen_util::cg_emit(out, "  call void @rewind(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Allocate buffer with length prefix
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size)")
    # Read file
    codegen_util::cg_emit(out, "  call i64 @fread(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 1, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Close file
    codegen_util::cg_emit(out, "  call i32 @fclose(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Convert to i64
    codegen_util::cg_emit_ptrtoint("#{d}.result", "#{d}.buf", "ptr")
    codegen_util::cg_emit(out, "  br label %read_done_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, "")
    # Failure path - return empty string
    codegen_util::cg_emit(out, "read_fail_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = ptrtoint ptr getelementptr(<{ i64, [1 x i8] }>, <{ i64, [1 x i8] }>* @.empty_string, i64 0, i32 1, i64 0) to i64")
    codegen_util::cg_emit(out, "  br label %read_done_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, "")
    # Merge point with phi
    codegen_util::cg_emit(out, "read_done_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result, %read_ok_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, %read_fail_")
    codegen_util::cg_emit(out, lbl_str)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "write_file"
    var args = mir::mir_instr_get_args(instr)
    var path_arg = args[0]
    var content_arg = args[1]
    var path = codegen_util::cg_format_operand(path_arg)
    var content = codegen_util::cg_format_operand(content_arg)
    # Convert to pointers
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".path = inttoptr i64 ")
    codegen_util::cg_emit(out, path)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".content = inttoptr i64 ")
    codegen_util::cg_emit(out, content)
    codegen_util::cg_emit_line(out, " to ptr")
    # Open file for writing
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp = call ptr @fopen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".path, ptr getelementptr([2 x i8], [2 x i8]* @.write_mode, i64 0, i64 0))")
    # Get content length
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".content)")
    # Write content
    codegen_util::cg_emit(out, "  call i64 @fwrite(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".content, i64 1, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Close file
    codegen_util::cg_emit(out, "  call i32 @fclose(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    # Return 0 (success)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "read_line" or name == "readline"
    var lbl = codegen_util::cg_next_label(state)
    var l = "#{lbl}"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf = alloca [4096 x i8]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = getelementptr [4096 x i8], [4096 x i8]* %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".stdin = call ptr @fdopen(i32 0, ptr getelementptr([2 x i8], [2 x i8]* @.read_mode, i64 0, i64 0))")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".r = call ptr @fgets(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i32 4096, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".stdin)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".r, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull, label %rl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, ", label %rl_ok_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "rl_ok_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @strlen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".last = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lastptr = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".last")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lastch = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnl = icmp eq i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastch, 10")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnl, label %rl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, ", label %rl_nostrip_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "rl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  store i8 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lastptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 1")
    codegen_util::cg_emit(out, "  br label %rl_nostrip_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "rl_nostrip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flen = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen, %rl_strip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, %rl_ok_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".copy = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flen)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".copy, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flen)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok_val = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".copy to i64")
    codegen_util::cg_emit(out, "  br label %rl_done_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "rl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = call ptr @qz_alloc_str(i64 0)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eof_val = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty to i64")
    codegen_util::cg_emit(out, "  br label %rl_done_")
    codegen_util::cg_emit_line(out, l)
    codegen_util::cg_emit(out, "rl_done_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok_val, %rl_nostrip_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eof_val, %rl_eof_")
    codegen_util::cg_emit(out, l)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "read_stdin"
    var lbl = codegen_util::cg_next_label(state)
    var ls = lbl.to_s()
    # Slurp all of stdin into a length-prefixed qz string. fseek/ftell does
    # not work on a pipe, so this reads in growable chunks: a malloc'd scratch
    # buffer doubled via realloc whenever fewer than 64 KiB remain, fread'd
    # until EOF (fread returns 0), then copied into a qz_alloc_str-sized final
    # string. fdopen(0, "r") is called once before the loop.
    codegen_util::cg_emit_line(out, "  br label %rs_init_#{ls}")
    codegen_util::cg_emit_line(out, "rs_init_#{ls}:")
    codegen_util::cg_emit_line(out, "  %v#{d}.cap0 = add i64 0, 65536")
    codegen_util::cg_emit_line(out, "  %v#{d}.buf0 = call ptr @malloc(i64 %v#{d}.cap0)")
    codegen_util::cg_emit_line(out, "  %v#{d}.fp = call ptr @fdopen(i32 0, ptr getelementptr([2 x i8], [2 x i8]* @.read_mode, i64 0, i64 0))")
    codegen_util::cg_emit_line(out, "  br label %rs_loop_#{ls}")
    codegen_util::cg_emit_line(out, "rs_loop_#{ls}:")
    codegen_util::cg_emit_line(out, "  %v#{d}.cap = phi i64 [ %v#{d}.cap0, %rs_init_#{ls} ], [ %v#{d}.capR, %rs_read_#{ls} ]")
    codegen_util::cg_emit_line(out, "  %v#{d}.buf = phi ptr [ %v#{d}.buf0, %rs_init_#{ls} ], [ %v#{d}.bufR, %rs_read_#{ls} ]")
    codegen_util::cg_emit_line(out, "  %v#{d}.len = phi i64 [ 0, %rs_init_#{ls} ], [ %v#{d}.len2, %rs_read_#{ls} ]")
    codegen_util::cg_emit_line(out, "  %v#{d}.room0 = sub i64 %v#{d}.cap, %v#{d}.len")
    codegen_util::cg_emit_line(out, "  %v#{d}.tight = icmp ult i64 %v#{d}.room0, 65536")
    codegen_util::cg_emit_line(out, "  br i1 %v#{d}.tight, label %rs_grow_#{ls}, label %rs_read_#{ls}")
    codegen_util::cg_emit_line(out, "rs_grow_#{ls}:")
    codegen_util::cg_emit_line(out, "  %v#{d}.cap_g = mul i64 %v#{d}.cap, 2")
    codegen_util::cg_emit_line(out, "  %v#{d}.buf_g = call ptr @realloc(ptr %v#{d}.buf, i64 %v#{d}.cap_g)")
    codegen_util::cg_emit_line(out, "  br label %rs_read_#{ls}")
    codegen_util::cg_emit_line(out, "rs_read_#{ls}:")
    codegen_util::cg_emit_line(out, "  %v#{d}.capR = phi i64 [ %v#{d}.cap, %rs_loop_#{ls} ], [ %v#{d}.cap_g, %rs_grow_#{ls} ]")
    codegen_util::cg_emit_line(out, "  %v#{d}.bufR = phi ptr [ %v#{d}.buf, %rs_loop_#{ls} ], [ %v#{d}.buf_g, %rs_grow_#{ls} ]")
    codegen_util::cg_emit_line(out, "  %v#{d}.room = sub i64 %v#{d}.capR, %v#{d}.len")
    codegen_util::cg_emit_line(out, "  %v#{d}.dst = getelementptr i8, ptr %v#{d}.bufR, i64 %v#{d}.len")
    codegen_util::cg_emit_line(out, "  %v#{d}.n = call i64 @fread(ptr %v#{d}.dst, i64 1, i64 %v#{d}.room, ptr %v#{d}.fp)")
    codegen_util::cg_emit_line(out, "  %v#{d}.len2 = add i64 %v#{d}.len, %v#{d}.n")
    codegen_util::cg_emit_line(out, "  %v#{d}.eof = icmp eq i64 %v#{d}.n, 0")
    codegen_util::cg_emit_line(out, "  br i1 %v#{d}.eof, label %rs_done_#{ls}, label %rs_loop_#{ls}")
    codegen_util::cg_emit_line(out, "rs_done_#{ls}:")
    codegen_util::cg_emit_line(out, "  %v#{d}.out = call ptr @qz_alloc_str(i64 %v#{d}.len2)")
    codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %v#{d}.out, ptr %v#{d}.bufR, i64 %v#{d}.len2)")
    codegen_util::cg_emit_line(out, "  call void @free(ptr %v#{d}.bufR)")
    codegen_util::cg_emit_line(out, "  %v#{d} = ptrtoint ptr %v#{d}.out to i64")
    return
  end

  if name == "open_file"
    var path_arg = args[0]
    var mode_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".path", path_arg, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".mode", mode_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp = call ptr @fopen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".path, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mode)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp to i64")
    return
  end

  if name == "close_file"
    var handle = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @fclose(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret to i64")
    return
  end

  if name == "pipe_open"
    var cmd_arg = args[0]
    var mode_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".cmd", cmd_arg, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".mode", mode_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp = call ptr @popen(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmd, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mode)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp to i64")
    return
  end

  if name == "pipe_close"
    var handle = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ret = call i32 @pclose(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = sext i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ret to i64")
    return
  end

  if name == "capture_output_start"
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @qz_capture_output_start()")
    return
  end

  if name == "capture_output_end"
    var handle = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_capture_output_end(i64 %v")
    codegen_util::cg_emit_int(out, handle)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "qz_redirect_stderr_to_file"
    var path = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".s", path, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_redirect_stderr_to_file(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s)")
    return
  end

  if name == "qz_restore_stderr"
    var saved = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_restore_stderr(i64 %v")
    codegen_util::cg_emit_int(out, saved)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "fwrite"
    var handle = args[0]
    var data = args[1]
    var flen = args[2]
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".data", data, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".written = call i64 @fwrite(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data, i64 1, i64 %v")
    codegen_util::cg_emit_int(out, flen)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".written, 0")
    return
  end

  if name == "fread"
    var handle = args[0]
    var flen = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".fp", handle, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".alloc = add i64 %v")
    codegen_util::cg_emit_int(out, flen)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmp = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".alloc)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".read = call i64 @fread(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmp, i64 1, i64 %v")
    codegen_util::cg_emit_int(out, flen)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".read)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmp, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".read)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmp)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf to i64")
    return
  end

  if name == "vec_save"
    var vec_arg = args[0]
    var path_arg = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_vec_save(i64 %v")
    codegen_util::cg_emit_int(out, vec_arg)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, path_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "vec_load"
    var path_arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_vec_load(i64 %v")
    codegen_util::cg_emit_int(out, path_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "strvec_save"
    var vec_arg = args[0]
    var path_arg = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_strvec_save(i64 %v")
    codegen_util::cg_emit_int(out, vec_arg)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, path_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "strvec_load"
    var path_arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_strvec_load(i64 %v")
    codegen_util::cg_emit_int(out, path_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

end
