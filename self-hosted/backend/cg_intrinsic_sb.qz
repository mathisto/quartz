    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e3c = and i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 63")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e3c1 = or i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e3c, 128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e3a2 = trunc i64 %v")
