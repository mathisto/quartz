    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is3, label %sbc_3_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %sbc_4_")
    codegen_util::cg_emit_line(out, d)
    # 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
    codegen_util::cg_emit(out, "sbc_3_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e3a = lshr i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 12")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e3a1 = or i64 %v")
    codegen_util::cg_emit(out, d)
