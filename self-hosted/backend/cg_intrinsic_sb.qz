  # B.1 Phase 5.E — read a single byte from sb's buffer at idx without
  # materializing a String. Pairs with `__sb_index_from` /
  # `__sb_starts_with_at` helpers in `shared/str_compat.qz` and lets
  # `cg_emit_extern_declarations` scan master_out's content directly,
  # eliminating the in-arena `out.to_string()` copy that was driving
  # ~80 MB of peak doubling. No bounds check — caller must respect
  # `sb_size`.
  if name == "sb_byte_at"
    var sb = args[0]
    var idx = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".hdr", sb, "ptr")
    # Load data pointer (offset 2)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.p")
    codegen_util::cg_emit_inttoptr("#{d}.data", "#{d}.data.i", "ptr")
    # Index into byte buffer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte.p = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data, i64 %v")
    codegen_util::cg_emit_int(out, idx)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".byte = load i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".byte to i64")
    return
  end

  if name == "sb_free"
    var sb = args[0]
    # Get header
    codegen_util::cg_emit_inttoptr_is(dest, ".hdr", sb, "ptr")
    # Load and free data
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit_inttoptr("#{d}.data", "#{d}.data.i", "ptr")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data)")
    # Free header
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr8 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr8)")
    # Return 0
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

end
