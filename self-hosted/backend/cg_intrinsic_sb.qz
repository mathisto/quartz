    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.final.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit_inttoptr("#{d}.data.final", "#{d}.data.final.i", "ptr")
