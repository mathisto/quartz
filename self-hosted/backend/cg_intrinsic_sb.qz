##! # StringBuilder Intrinsics
##!
##! Emits LLVM IR for mutable string builder operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# Sb Intrinsics (8 handlers)
# ============================================================================

def cg_emit_intrinsic_sb(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "sb_new"
    # Allocate 24-byte header + initial buffer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".h64 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    # Store capacity (64)
    codegen_util::cg_emit(out, "  store i64 64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64")
    # Store length (0)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len_ptr")
    # Allocate data buffer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data = call ptr @__qz_alloc(i64 64)")
    codegen_util::cg_emit_ptrtoint("#{d}.data64", "#{d}.data", "ptr")
    # Store data pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr")
    # Return header as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  # B.1 Phase 5.A — pre-allocate the data buffer at a user-supplied
  # capacity to avoid the doubling-grow leak chain when allocating
  # under an Alloc-effect arena (each grow leaves the OLD buffer in
  # the arena because the dealloc no-ops). Caller passes initial
  # capacity in bytes; floored to 64 to preserve sb_new's minimum
  # buffer size invariant.
  if name == "sb_new_with_capacity"
    var cap_arg = codegen_util::cg_format_operand(args[0])
    # Floor capacity at 64 to match sb_new's default
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap_small = icmp slt i64 ")
    codegen_util::cg_emit(out, cap_arg)
    codegen_util::cg_emit_line(out, ", 64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = select i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap_small, i64 64, i64 ")
    codegen_util::cg_emit_line(out, cap_arg)
    # Allocate 24-byte header
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".h64 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    # Store capacity (cap)
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64")
    # Store length (0)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len_ptr")
    # Allocate data buffer of cap bytes
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap)")
    codegen_util::cg_emit_ptrtoint("#{d}.data64", "#{d}.data", "ptr")
    # Store data pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h64, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr")
    # Return header as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  if name == "sb_append_char"
    var args = mir::mir_instr_get_args(instr)
    var sb_arg = args[0]
    var char_arg = args[1]
    var sb = codegen_util::cg_format_operand(sb_arg)
    var ch = codegen_util::cg_format_operand(char_arg)
    # Get header pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 ")
    codegen_util::cg_emit(out, sb)
    codegen_util::cg_emit_line(out, " to ptr")
    # Load capacity
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    # Load len
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len_ptr")
    # Load data pointer location
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data64 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr")
    # Calculate need = len + 5 (max 4 UTF-8 bytes + null terminator)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 5")
    # Check if need > cap
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".grow = icmp ugt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".grow, label %sbc_grow_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %sbc_copy_")
    codegen_util::cg_emit_line(out, d)
    # Grow block: realloc buffer
    codegen_util::cg_emit(out, "sbc_grow_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.raw = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".need, 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.small = icmp slt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw, 4")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap = select i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.small, i64 4, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    codegen_util::cg_emit_inttoptr("#{d}.olddata", "#{d}.data64", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newdata = call ptr @__qz_realloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".olddata, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap)")
    codegen_util::cg_emit_ptrtoint("#{d}.newdata.i", "#{d}.newdata", "ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newdata.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr")
    codegen_util::cg_emit(out, "  br label %sbc_copy_")
    codegen_util::cg_emit_line(out, d)
    # Copy block: reload data pointer
    codegen_util::cg_emit(out, "sbc_copy_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr2 = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data64_2 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr2")
    codegen_util::cg_emit_inttoptr("#{d}.data2", "#{d}.data64_2", "ptr")
    # Compute slot = data[len]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slot = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data2, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    # UTF-8 encoding: branch based on codepoint value
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is1 = icmp ult i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 128")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is1, label %sbc_1_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %sbc_c2_")
    codegen_util::cg_emit_line(out, d)
    # 1-byte: 0xxxxxxx
    codegen_util::cg_emit(out, "sbc_1_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".b1 = trunc i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, " to i8")
    codegen_util::cg_emit(out, "  store i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".b1, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".t1 = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, i64 1")
    codegen_util::cg_emit(out, "  store i8 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".t1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nl1 = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 1")
    codegen_util::cg_emit(out, "  br label %sbc_done_")
    codegen_util::cg_emit_line(out, d)
    # Check 2-byte
    codegen_util::cg_emit(out, "sbc_c2_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is2 = icmp ult i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 2048")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is2, label %sbc_2_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %sbc_c3_")
    codegen_util::cg_emit_line(out, d)
    # 2-byte: 110xxxxx 10xxxxxx
    codegen_util::cg_emit(out, "sbc_2_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2a = lshr i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 6")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2a1 = or i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e2a, 192")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2b = and i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 63")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2b1 = or i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e2b, 128")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2a2 = trunc i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e2a1 to i8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2b2 = trunc i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".e2b1 to i8")
    codegen_util::cg_emit(out, "  store i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2a2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2_1 = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, i64 1")
    codegen_util::cg_emit(out, "  store i8 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".e2b2, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2_1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".t2 = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, i64 2")
    codegen_util::cg_emit(out, "  store i8 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".t2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nl2 = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, 2")
    codegen_util::cg_emit(out, "  br label %sbc_done_")
    codegen_util::cg_emit_line(out, d)
    # Check 3-byte
    codegen_util::cg_emit(out, "sbc_c3_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is3 = icmp ult i64 ")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 65536")
