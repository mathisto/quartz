    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dest = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.final, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    # Copy the formatted string. Length-bounded memcpy from the qz_alloc_str
    # buffer (no NUL byte to consume — qz strings are length-prefixed, not
    # NUL-terminated, so strcpy would have walked past the data on prior
