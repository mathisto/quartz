  end

  if name == "sb_to_string"
    var args = mir::mir_instr_get_args(instr)
    var sb_arg = args[0]
    var sb = codegen_util::cg_format_operand(sb_arg)
    # Get header pointer
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr = inttoptr i64 ")
    codegen_util::cg_emit(out, sb)
    codegen_util::cg_emit_line(out, " to ptr")
    # Load len
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len_ptr")
    # Load data
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data64 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr")
    codegen_util::cg_emit_inttoptr("#{d}.data", "#{d}.data64", "ptr")
    # Allocate result string with length prefix
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len)")
    # Copy data
    codegen_util::cg_emit(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len, i1 false)")
    # Return as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.result", "ptr")
    return
  end

  if name == "sb_append_int"
    var sb = args[0]
    var n = args[1]
    var label = codegen_util::cg_next_label(state)
    # Format integer through @qz_int_to_str — pure-int formatter, no
    # pointer-sniff heuristic. Replaces the prior inline sprintf+strlen+strcpy
    # which (a) broke freestanding builds (no @sprintf / @strlen / @.fmt.int.noln
    # past the freestanding early-return), and (b) the obvious-looking @to_str
    # workaround had a worse failure mode — its pointer-vs-int heuristic
    # speculatively dereferences [val-8] for any int matching
    # `(val & 15) == 8 && val > 65535`, which SEGVs at unmapped addresses.
    # @qz_int_to_str (codegen_runtime.qz:cg_emit_int_to_str_helper) skips
    # the heuristic — sb_append_int's caller knows the arg is an int.
    # Filed by NET.1 Phase 1 (UDP layer in unikernel).
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmp.i = call i64 @qz_int_to_str(i64 %v")
    codegen_util::cg_emit_int(out, n)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit_inttoptr("#{d}.tmp", "#{d}.tmp.i", "ptr")
    # Length read from the qz_alloc_str header at ptr-8.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".addlen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmp)")
    # Get sb header
    codegen_util::cg_emit_inttoptr_is(dest, ".hdr", sb, "ptr")
    # Load capacity (offset 0)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    # Load current len (offset 1)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.ptr")
    # Load data ptr
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit_inttoptr("#{d}.data", "#{d}.data.i", "ptr")
    # Calculate new length
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newlen = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".addlen")
    # Check if we need to grow
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need = icmp sge i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newlen, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need, label %sb_grow_")
    codegen_util::cg_emit_int(out, label)
    codegen_util::cg_emit(out, ", label %sb_append_")
    codegen_util::cg_emit_int(out, label)
    codegen_util::cg_emit_line(out, "")
    # Grow block
    codegen_util::cg_emit(out, "sb_grow_")
    codegen_util::cg_emit_int(out, label)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.raw = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap, 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.small = icmp slt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw, 4")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap = select i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.small, i64 4, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.new = call ptr @__qz_realloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap)")
    codegen_util::cg_emit_ptrtoint("#{d}.data.new.i", "#{d}.data.new", "ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.new.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit(out, "  br label %sb_append_")
    codegen_util::cg_emit_int(out, label)
    codegen_util::cg_emit_line(out, "")
    # Append block
    codegen_util::cg_emit(out, "sb_append_")
    codegen_util::cg_emit_int(out, label)
    codegen_util::cg_emit_line(out, ":")
