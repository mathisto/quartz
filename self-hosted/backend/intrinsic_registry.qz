##! Intrinsic Registry — single source of truth for all Quartz compiler intrinsic names.
##! Uses a single Map for both membership testing (is_intrinsic) and category lookup.
##! ZERO imports. Pure data module. To add a new intrinsic, add ONE line here.

const INTRINSIC_CAT_COLLECTION = 1
const INTRINSIC_CAT_CONCURRENCY = 2
const INTRINSIC_CAT_CONVERSION = 3
const INTRINSIC_CAT_MAP_STR = 4
const INTRINSIC_CAT_MAP_INT = 5
const INTRINSIC_CAT_IO = 6
const INTRINSIC_CAT_MATH = 7
const INTRINSIC_CAT_MEMORY = 8
const INTRINSIC_CAT_MISC = 9
const INTRINSIC_CAT_REGEX = 10
const INTRINSIC_CAT_SB = 11
const INTRINSIC_CAT_SET = 12
const INTRINSIC_CAT_SIMD = 13
const INTRINSIC_CAT_STRING = 14
const INTRINSIC_CAT_SYSTEM = 15
const INTRINSIC_CAT_VEC = 16
const INTRINSIC_CAT_MAP = 17
const INTRINSIC_CAT_UFCS = 99

var g_registry = map_new()
var g_registry_initialized = 0

def _r(name: String, cat: Int): Void
  map_set(g_registry, name, cat)
end

def init_intrinsic_registry(): Void
  if g_registry_initialized == 1
    return
  end
  g_registry_initialized = 1

  _r("all?", INTRINSIC_CAT_COLLECTION)
  _r("any?", INTRINSIC_CAT_COLLECTION)
  _r("array_get", INTRINSIC_CAT_COLLECTION)
