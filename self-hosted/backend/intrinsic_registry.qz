  # SYS.1 item 7 — x86 segment-based TLS access for kernel per-CPU
  # variables and freestanding userspace TLS. LLVM lowers these via
  # address spaces 256 (%gs) and 257 (%fs), which the x86/x86_64
  # backend turns into segment-prefixed loads/stores.
  _r("tls_read_gs", INTRINSIC_CAT_SYSTEM)
  _r("tls_read_fs", INTRINSIC_CAT_SYSTEM)
  _r("tls_write_gs", INTRINSIC_CAT_SYSTEM)
  _r("tls_write_fs", INTRINSIC_CAT_SYSTEM)
  # arm64 thread-pointer register access (mrs/msr tpidr_el1 / tpidr_el0).
  # el1 = kernel per-CPU base; el0 = userspace TLS base. Lowered via
  # single-instruction inline asm.
  _r("tls_read_tpidr_el1", INTRINSIC_CAT_SYSTEM)
  _r("tls_write_tpidr_el1", INTRINSIC_CAT_SYSTEM)
  _r("tls_read_tpidr_el0", INTRINSIC_CAT_SYSTEM)
  _r("tls_write_tpidr_el0", INTRINSIC_CAT_SYSTEM)
  # x86 port-I/O for legacy I/O-port-space devices (COM1=0x3F8, PIC,
  # PIT, CMOS, keyboard). Lowered via sideeffect inline asm.
  _r("port_out8", INTRINSIC_CAT_SYSTEM)
  _r("port_out16", INTRINSIC_CAT_SYSTEM)
  _r("port_out32", INTRINSIC_CAT_SYSTEM)
  _r("port_in8", INTRINSIC_CAT_SYSTEM)
  _r("port_in16", INTRINSIC_CAT_SYSTEM)
  _r("port_in32", INTRINSIC_CAT_SYSTEM)
