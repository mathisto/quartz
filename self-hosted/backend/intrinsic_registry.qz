def is_intrinsic(name: String): Int
  if map_has(g_registry, name)
    return 1
  end
  return 0
end

def get_intrinsic_category(name: String): Int
  if map_has(g_registry, name)
    return __map_get_raw(g_registry, name)
  end
  return 0
end
