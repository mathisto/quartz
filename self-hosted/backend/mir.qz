##! # Mid-Level Intermediate Representation (MIR)
##!
##! Phase 4 of the Quartz compiler: lowering from AST to MIR for codegen.
##!
##! MIR is a low-level SSA-form representation with:
##! - **Basic Blocks**: Labeled instruction sequences
##! - **Virtual Registers**: SSA-style %0, %1, %2, ...
##! - **Terminators**: return, jump, branch, unreachable
##! - **Intrinsics**: All runtime calls (print, vec_new, etc.)
##!
##! ## MIR Types
##!
##! Quartz uses existential types that erase to i64 at runtime:
##!
##! | Constant | Type | Notes |
##! |----------|------|-------|
##! | MIR_TYPE_INT | 0 | 64-bit signed integer |
##! | MIR_TYPE_BOOL | 1 | 0 or 1 |
##! | MIR_TYPE_STRING | 2 | Pointer to string |
##! | MIR_TYPE_VOID | 3 | No return value |
##! | MIR_TYPE_STRUCT | 4 | Pointer to heap struct |
##! | MIR_TYPE_ENUM | 5 | Tagged union pointer |
##! | MIR_TYPE_FUNC | 6 | Function pointer |
##! | MIR_TYPE_ARRAY | 7 | Vector pointer |
##! | MIR_TYPE_OPTION | 8 | Option type |
##! | MIR_TYPE_RESULT | 9 | Result type |
##!
##! ## MIR Instructions
##!
##! | Constant | Instruction | Purpose |
##! |----------|-------------|---------|
##! | MIR_CONST_INT | 1 | Integer literal |
##! | MIR_LOAD_VAR | 4 | Load from variable |
##! | MIR_STORE_VAR | 5 | Store to variable |
##! | MIR_BINARY | 6 | Binary operations |
##! | MIR_CALL | 8 | Direct function call |
##! | MIR_INTRINSIC | 9 | Runtime intrinsic call |
##!
##! ## Storage Model
##!
##! Like the AST, MIR uses arena-style parallel vectors:
##! - Index 0: Function handles
##! - Index 1+: Function-specific data (blocks, instructions)
##!
##! @see ast AST node definitions
##! @see codegen LLVM IR emission from MIR
##! @since 1.0.0

import ast
import token_constants
import mir_intrinsics
import mir_const
import compiler_types
import node_constants
import op_constants
import type_constants
import layout
import niche
import diagnostic
import string_intern
import std/profile
import * from str_compat

var _g_poll_callees = vec_new<String>()

def mir_register_poll_callee(name: String): Void
  _g_poll_callees.push(name)
end

def mir_is_poll_callee(name: String): Int
  for i in 0.._g_poll_callees.size
    if _g_poll_callees[i] == name
      return 1
    end
  end
  return 0
end

def mir_strip_borrow_prefix(name: String): String
  if str_byte_len(name) > 5
    if str_byte_at(name, 0) == '&' and str_byte_at(name, 1) == 'm' and str_byte_at(name, 2) == 'u' and str_byte_at(name, 3) == 't' and str_byte_at(name, 4) == ' '
      return str_byte_slice(name, 5, str_byte_len(name))
    end
  end
  if str_byte_len(name) > 1 and str_byte_at(name, 0) == '&'
    return str_byte_slice(name, 1, str_byte_len(name))
  end
  return name
end

# ============================================================================
# MIR Data Structures
# ============================================================================
#
# These structs replace the previous Vec-based pseudo-structs with proper
# typed structures. This enables UFCS, improves type safety, and makes
# the code self-documenting.

## MIR Instruction - a single SSA instruction
struct MirInstr
  kind: Int
  dest_id: Int
  dest_type: Int
  operand1: Int          # Also: int_val, var_name (union semantics)
  operand2: Int          # Also: string_val, func_name (union semantics)
  op: Int
  args: Vec<Int>
  slot1: Int
  slot2: Int
  line: Int
  col: Int
end

## MIR Basic Block - a sequence of instructions with a terminator
struct MirBlock
  label: String
  instructions: Vec<MirInstr>
  term_kind: Int
  term_data: Int
  branch_true: Int
  branch_false: Int
  terminated: Int
  ## Stable per-compile identity (PF3-P1). Assigned from a deterministic
  ## monotonic counter in `mir_new_block`. Used as the membership key in the
  ## `_g_switch_block_ids` side-table instead of `as_int(block)`.
  id: Int
end

## MIR Function - a single function with params, blocks, and metadata
##
## `origin_module` is the source module that produced this function (e.g.
## `"std_string"`). Empty string means "no module attribution" — used for
## __main__ entries and for synthetic functions that are produced AFTER
## the user-defined lowering pass (async ctors, actor proxies, specialization
## bodies, `__qz_module_init`). The .qzmod producer (INC.1.2) filters
## `mir_prog.functions` by `origin_module == module_name` when writing
## `mir_bodies.bin`; functions with `origin_module == ""` get re-derived
## by the consumer at MIR-lowering time.
struct MirFunc
  name: String
  origin_module: String
  return_type: Int
  params: Vec<String>
  param_types: Vec<Int>
  param_type_names: Vec<String>
  return_type_name: String
  blocks: Vec<MirBlock>
  entry: MirBlock
  value_counter: Int
  block_counter: Int
  locals: Vec<String>
  local_narrow_names: Vec<String>
  local_narrow_types: Vec<String>
  is_naked: Int
  is_no_preempt: Int
  is_weak: Int
  is_export: Int
  is_noinline: Int
  line: Int
  col: Int
  ## Stable per-compile identity (PF3-P1). Assigned from a deterministic
  ## monotonic counter in `mir_new_function` (reset per compile via
  ## `mir_reset_id_counters`). Used as the membership key in the cconv/@ct
  ## side-tables instead of `as_int(func)` (which erases the COW struct
  ## pointer to an i64 and drops the refcount once plain structs flip to
  ## value-layout). The id is a genuine Int, so the side-tables stay
  ## `Vec<Int>` without re-erasing the struct.
  id: Int
  ## item 20 P1 — 1 iff param 0 is named `self` AND the body directly stores to
  ## `self.<field>` (NODE_FIELD_ASSIGN with a `self` NODE_IDENT receiver). Computed
  ## once during `mir_lower_function` (the AST body is only reachable there; the
  ## codegen-time decompose predicates run on MirFunc, which carries no AST). Read
  ## by `mir_func_param0_is_mut_value_receiver` to exclude a mutated value-struct
  ## `self` from register-decompose so the mutation lands in the caller's slot in
  ## place. Detection is DIRECT-self only (no transitive-via-callee). Default 0;
  ## gate-0-inert (the value-layout disjunct in the consumer short-circuits on the
  ## F4 flip). Serialized via the qzmod flags bitfield (bit 5) so cached value-
  ## struct method bodies keep the marker.
  mutates_self_field: Int
  ## item 38 — 1 iff param 0 is named `self` but the body NEVER references `self`
  ## (no NODE_IDENT named "self"). This is the signature of an ASSOCIATED
  ## (receiver-LESS, `Type::fn(..)`-called) function in an `extend`/`impl` block:
  ## the registry injects a leading `self` so static methods register uniformly,
  ## the callsite omits it (arity-adjusted in TC), and the def's phantom param 0
  ## is passed garbage (0) and never used. When param 0's type is value-layout
  ## this phantom MUST NOT be register-DECOMPOSED: decompose emits `inttoptr 0;
  ## load f0` → null deref → SIGSEGV (the `Box::make` crash). Read by the
  ## decompose predicates (`mir_func_param_is_decomposed` /
  ## `mir_func_should_decompose_value_params`) to exclude param 0. Default 0;
  ## gate-0-inert (only fires when param 0 is value-layout, which the F4 flip == 0
  ## keeps dead for plain structs). Serialized via the qzmod flags bitfield
  ## (bit 6) so cached associated-fn bodies keep the marker.
  assoc_phantom_self: Int
end

## A registered struct definition — name, field layout, repr/value flags, the
## defining AstStorage (for default-value lowering), and the inline-value marker.
##
## Replaces the former positional `Vec` tuple `[name, field_names, field_types,
## repr_c, packed, is_value, field_defaults, ast_store]`. `inline_value` folds
## what used to be a variable-arity 9th slot: ordinary structs leave it 0, and
## `mir_synth_value_layout_struct` mints specializations with it == 1 (the
## generic-over-@value inline-layout marker, B.10 §12.9). Element vecs stay bare
## `Vec` (their interned-string-handle elements keep their `as_string` bridges —
## re-typing them to `Vec<String>` is a separate zero-fire-delta cleanup).
struct MirStructDef
  name: String
  field_names: Vec
  field_types: Vec
  repr_c: Int
  packed: Int
  is_value: Int
  field_defaults: Vec<Int>
  ast_store: ast::AstStorage
  inline_value: Int
end

## Typed pair returned by `mir_ctx_get_struct_fields` — replaces the former
## erased `Vec<Int>` positional 2-tuple `[field_names, field_types]`. The two
## columns hold interned type/field-name strings (the `MirStructDef` writers
## supply `Vec<String>`), so the boundary is `Vec<String>`, not `Vec<Int>`.
## Fields are named `sd_*` (not `field_names`/`field_types`) deliberately: a
## field access on a generic `Option::unwrap()` result resolves the field
## offset by a GLOBAL field-name→offset table, so reusing `field_types` (owned
## by `MirStructDef` at index 2) would read this 2-field struct at offset 2 and
## fault. See QZ-FIELDNAME-COLLISION note below / B.15 §11.42.
struct StructFields
  field_names: Vec<String>
  field_types: Vec<String>
end

## MIR Program - top-level container for all functions and globals
struct MirProgram
  functions: Vec<MirFunc>
  string_pool: Vec<String>
  struct_defs: Vec<MirStructDef>
  enum_defs: Vec<Int>
  global_names: Vec<String>
  global_inits: Vec<Int>
  global_str_inits: Vec<String>
  const_names: Vec<String>
  const_values: Vec<Int>
  uses_task_group: Int
  global_thread_locals: Vec<Int>
  uses_scheduler: Int
  uses_intern: Int
  uses_cache: Int
  uses_profile: Int
  uses_yield: Int
  uses_scope_deadline: Int
  ## Binary DSL layout registry — see docs/design/BINARY_DSL.md.
  ## Each registered `binary {}` / `packed struct(uN)` owns a stable
  ## numeric `layout_id` (index into these parallel vectors). Codegen
  ## dispatches MIR_BINARY_PACK / MIR_BINARY_UNPACK / MIR_PACKED_BITCAST
  ## against the entry.
  ##
  ## kind = 1 for binary {} blocks, 2 for packed struct(uN).
  ## For packed structs, backing_width carries N; for binary blocks, 0.
  ## field_names / field_specs / field_widths are parallel and indexed
  ## via field_offsets (cumulative field count per layout).
  binary_layout_names: Vec<String>
  binary_layout_kinds: Vec<Int>
  binary_layout_backing: Vec<Int>
  binary_layout_field_offsets: Vec<Int>
  binary_layout_field_counts: Vec<Int>
  binary_field_names: Vec<String>
  binary_field_specs: Vec<String>
  binary_field_widths: Vec<Int>
  ## Phase 2 Track A — computed fields. Each slot holds the AST node id
  ## of the `= <expr>` following the field type, or 0 if the field is
  ## not computed. Expressions run at .encode() time with `self` bound
  ## to the struct being packed; the result overrides any user-supplied
  ## value for the field. On .decode() computed fields are read from the
  ## wire like any other field (v1 trusts; v2 may validate).
  binary_field_compute_asts: Vec<Int>
  ## Phase 2 Track B — discriminated unions.
  ##
  ## At most one union per layout in v1; -1 means "no union." The
  ## discriminator field index is a flat index into the layout's regular
  ## field list (the one referenced by binary_layout_field_offsets).
  ## Arm information is stored in parallel arm tables, and arm-field
  ## information in parallel arm-field tables.
  binary_layout_union_disc_idx: Vec<Int>
  binary_layout_union_arm_offset: Vec<Int>
  binary_layout_union_arm_count: Vec<Int>
  binary_union_arm_tags: Vec<Int>
  binary_union_arm_field_offsets: Vec<Int>
  binary_union_arm_field_counts: Vec<Int>
  binary_union_field_names: Vec<String>
  binary_union_field_specs: Vec<String>
  binary_union_field_widths: Vec<Int>
  ## SYS.1 item 6 — user-registered panic handler.
  ## Empty string means "no handler; fall back to libc-based panic
  ## (write(2) + optional longjmp to scheduler, else exit(1))."
  ## A non-empty value is the mangled LLVM symbol name of a function
  ## annotated `@panic_handler`. When set, every prelude panic emission
  ## calls that handler + unreachable, bypassing libc. Used by kernel
  ## / unikernel / embedded builds that must not link against libc.
  panic_handler_name: String
  ## Global-var alias names (parallel-vec encoded). When a module imported
  ## under multiple prefixes registers the same var node twice, mir_lower's
  ## PASS 0.6 emits ONE primary `@global_<target>` and lists every other
  ## name in `global_alias_names` with the primary it aliases at the parallel
  ## index in `global_alias_targets`. Codegen emits an LLVM alias per pair:
  ##   `@global_<alias> = alias i64, ptr @global_<target>`
  ## This preserves SHARED storage across the import surfaces, which is
  ## essential for mutable globals — writes through either name see each
  ## other. Kept at the END of the struct so insertion doesn't shift any
  ## existing field positions / offsets.
  global_alias_names: Vec<String>
  global_alias_targets: Vec<String>
end

# ============================================================================
# MirContext - Typed wrapper for MIR lowering state
# ============================================================================
# 
# This struct wraps the underlying vector storage to provide type safety
# and enable UFCS-style method calls. The data field holds a vector with:
#
# Slot | Field Name        | Type          | Purpose
# -----|-------------------|---------------|--------------------------------
#   0  | program           | Int           | MIR program being built
#   1  | func              | Int           | Current function
#   2  | block             | Int           | Current block
#   3  | bindings          | Vec<Int>      | Variable bindings {name, value}
#   4  | break_target      | Int           | Break target block
#   5  | continue_target   | Int           | Continue target block
#   6  | lambda_counter    | Int           | Lambda name counter
#   7  | next_slot         | Int           | Next var slot for params/locals
#   8  | module_name       | String        | Current module name
#   9  | all_funcs         | Vec<Int>      | All user-defined functions
#  10  | string_vars       | Vec<String>   | Names of String-typed variables
#  11  | pending_bind_names| Vec<String>   | Enum payload bind names (empty=none)
#  12  | pending_bind_base | Int           | Enum payload bind base value
#  13  | struct_types      | Vec<Vec<Int>> | Struct-typed variable mappings
#  14  | struct_registry   | Vec<MirStructDef> | Registered struct definitions
#  15  | enum_names        | Vec<String>   | Enum type names (dynamic)
#  16  | enum_values       | Vec<Vec<Int>> | Enum variant data (dynamic)
#  17  | enum_types        | Vec<Int>      | Enum payload types (dynamic)
#  18  | global_registry   | Vec<Int>      | Global variable registry
#  19  | line              | Int           | Current source line
#  20  | loop_stack        | Vec<MirLoopEntry> | Labeled loop stack
#  21  | droppable_stack   | Vec<Int>      | Stack of droppable values
#  22  | scope_depth       | Int           | Current scope nesting depth
#  23  | loop_scope_depth  | Int           | Scope depth at loop entry
#  24  | defer_stack       | Vec<Int>      | Deferred expressions stack

# ============================================================================
# MirGenericState — generic function specialization state
# ============================================================================

## A queued generic specialization to emit. Replaces the former variable-arity
## positional `Vec` tuple `[base_name, arg_types, ast_store, func_handle,
## (struct_name, type_param_csv)]` (N3.1 tuple-promotion — de-existentializes
## the `ast_store` slot so the drain no longer coerces a bare `Int` into the
## `AstStorage` params of `mir_lower_struct_method_spec` /
## `mir_lower_specialized_function`). `struct_name` is non-empty iff this is a
## struct-method spec (the former `vec_size(entry) >= 6` arity discriminator
## becomes `str_byte_len(struct_name) > 0`); `arg_types` stays a `Vec` of
## interned type-name string handles (sanctioned `as_int`/`as_string` element
## bridges, §11.27).
struct PendingSpec
  base_name: String
  arg_types: Vec
  ast_store: ast::AstStorage
  func_handle: Int
  struct_name: String
  type_params: String
end

## A registered bounded / structurally-constrained generic function. Replaces the
## former positional 7-slot `Vec` tuple `[name, ast_store, func_handle,
## type_params, bounds, mangled, iter_tag]` (N3.1 tuple-promotion —
## de-existentializes the `ast_store` slot so the iterator-closure-dispatch path
## no longer coerces a bare `Int` into `ast_get_left`/`ast_get_str2`'s
## `AstStorage` params). `iter_tag` is 1 iff ALL the fn's bounds are
## Iterator-only (set in-place by PASS 0.9.1; the former `entry.size > 6 and
## entry.field_defaults == 1` discriminator becomes `entry.iter_tag == 1`). `type_params`
## is currently unread (kept for layout parity); `bounds` is the canonical
## type — the structural/record-param construction sites that previously pushed
## an (unread) empty `Vec<String>` here now push `""`.
struct BoundedGenericFunc
  base_name: String
  ast_store: ast::AstStorage
  func_handle: Int
  type_params: String
  bounds: String
  mangled: String
  iter_tag: Int
end

## Tracks bounded generic functions, specialization queue, and param type mapping.
## Extracted from MirContext to reduce god-object field count.
struct MirGenericState
  ## Registry of bounded generic functions (see `struct BoundedGenericFunc`).
  generic_bounded_funcs: Vec<BoundedGenericFunc>
  ## Pending specialization queue (see `struct PendingSpec`).
  pending_specs: Vec<PendingSpec>
  ## Per-param type map during specialization: [[param_name, concrete_type], ...]
  spec_param_types: Vec
  ## During specialization lowering: concrete type name (e.g., "Point"), else ""
  spec_current_type: String
  ## During specialization lowering: module prefix extracted from the spec base name.
  ## E.g. when specializing `iter$sum_it`, this is "iter". Empty for main-module specs.
  ## Used by A8 trait-rewrite in mir_lower_expr_handlers.qz to construct module-prefixed
  ## candidate method names like `iter$DoubleIt$it2_next` cross-module.
  spec_current_module_prefix: String
  ## During impl method lowering: type name (e.g., "Point"), else ""
  impl_current_type: String
  ## Memoization cache: spec_name -> 1 (O(1) dedup, replaces O(n) visited set)
  spec_memo: Int
  ## Cycle detection: stack of spec names currently being lowered
  spec_in_progress: Vec<String>
end

# ============================================================================
# MirDropState — drop, defer, and droppable stack management
# ============================================================================

struct MirDropEntry
  var_name: String
  type_name: String
  depth: Int
end

## A labeled loop-stack entry: the break/continue targets plus the scope and
## defer-wrap depths captured when the loop was entered. Replaces the former
## positional `Vec<Int>` tuple `[label, break, continue, scope_depth,
## wrap_depth]` (N3.1 tuple-promotion — de-existentializes the loop-stack
## block handles so `find_loop_break`/`find_loop_continue` no longer coerce a
## bare `Int` into the `MirBlock` slot).
struct MirLoopEntry
  label: String
  break_block: MirBlock
  continue_block: MirBlock
  scope_depth: Int
  wrap_depth: Int
end

## Tracks types implementing Drop, droppable variables, and deferred actions.
## Extracted from MirContext to reduce god-object field count.
struct MirDropState
  ## Registry of types implementing Drop
  drop_types: Vec<String>
  ## Stack of droppable variables
  droppable_stack: Vec<MirDropEntry>
  ## Stack of deferred actions
  defer_stack: Vec
  ## Defer stack depth at entry of current loop
  loop_defer_depth: Int
end

## MIR Context - Typed wrapper for MIR lowering state
## This struct wraps the underlying vector storage to provide type safety
## and enable UFCS-style method calls.
struct MirContext
  ## The MIR program being built
  program: Vec
  ## Current function handle (B.15d/N3.1 step-4c: de-existentialized to
  ## `Option<MirFunc>`. `None` is the "no current function yet" state at
  ## construction; `mir_ctx_set_func` installs `Some(f)` before lowering and the
  ## hot-path getter `mir_ctx_get_func` unwraps to a real MirFunc. The bare-`0`
  ## existential sentinel is gone — the structural bare-Int wall no longer fires.
  func: Option<MirFunc>
  ## Current block handle
  block: MirBlock
  ## Variable bindings map
  bindings: Vec
  ## Target block for 'break'
  break_target: Int
  ## Target block for 'continue'
  continue_target: Int
  ## Counter for unique lambda names
  lambda_counter: Int
  ## Next available variable slot
  next_slot: Int
  ## Name of module being compiled
  module_name: String
  ## List of all user-defined function handles
  all_funcs: Vec<ResolverEntry>
  ## INC.1.12 — name → index map into `all_funcs` for tag-0 and tag-10
  ## entries. Built once when `mir_ctx_set_all_funcs` is called; lookups
  ## (`mir_lookup_function`, suffix-search-by-name callers) hit O(1)
  ## instead of walking all_funcs per call. On the self-host compile,
  ## ~6000 entries × ~10000 lookups → from O(60M) to O(60M build + 10K
  ## lookups). Tag-0 wins on name collisions (preserves original
  ## first-match semantics: tag-0 declarations appear first via
  ## resolve_collect_funcs order).
  all_funcs_by_name: Map<String, Int>
  ## Track variables that are Strings (for memory management)
  string_vars: Vec
  ## Names for pending enum payload bindings (multi-field destructure)
  pending_bind_names: Vec<String>
  ## Base value for pending enum payload binding
  pending_bind_base: Int
  ## B.10 §12.10 — per-binding inline-@value flags, parallel to
  ## pending_bind_names. 1 ⇒ the payload type is a @value struct embedded INLINE
  ## in the enum (Option/Result, v1), so the binding is an interior address
  ## (base + offset*8) rather than a loaded pointer. Empty/0 ⇒ legacy boxed load.
  pending_bind_inline: Vec<Int>
  ## B.10 §14 N1 — per-binding niche flag, parallel to pending_bind_names. 1 ⇒
  ## the subject is a niche-layout Option, so `Some`'s payload binding IS the
  ## scalar subject value itself (identity), not a load from offset 1.
  pending_bind_niche: Vec<Int>
  ## B.10 §14.9 multi-payload M1 — per-binding niche MASK, parallel to
  ## pending_bind_niche. 0 ⇒ identity bind (single-payload Option/struct-enum).
  ## >0 ⇒ a multi-payload-niche payload binding: the bound pointer has `low_zero`
  ## tag bits OR-ed into its low bits, so apply_pending_bind masks them off
  ## (`value & ~((1<<low_zero)-1)`) to recover the payload pointer. Inert while the
  ## multi-payload gate is OFF (always 0). Carries `low_zero` (the spare-bit count).
  pending_bind_niche_mask: Vec<Int>
  ## enum-niche tail item 6 — nested inner-payload binds for a NESTED constructor
  ## sub-pattern (`Outer(Inner::V(x)) => ...`). The inner value is recovered (niche
  ## `& ~spare_mask` or spill `load@+1`) in item 1's inner_check_block (which
  ## dominates the arm block), so apply_pending_bind only alloc_slot + store_var.
  ## Three parallel vectors keyed by binding ordinal: the bound name, the already-
  ## recovered MirReg holding the inner payload, and the inner payload's concrete
  ## type (for mir_ctx_mark_struct_var so `x.v` field access resolves). Reset per
  ## arm in apply_pending_bind so binds never leak across arms. Empty ⇒ no nested
  ## bind (the byte-identical wildcard / single-level path).
  pending_nested_bind_names: Vec<String>
  pending_nested_bind_regs: Vec<Int>
  pending_nested_bind_types: Vec<String>
  ## item 40 — per-nested-binding inline flag, parallel to the three vectors above.
  ## 1 iff the inner payload is an inline-embedded value-layout struct (the
  ## recovered reg is then an INTERIOR ADDRESS into the outer enum box, not a
  ## loaded payload pointer): the drain must mir_ctx_mark_arena_owned the bound
  ## name so its field reads use flat offset+0 (no COW +1 shift). 0 ⇒ the
  ## byte-identical boxed-pointer load. Empty/short ⇒ treated as 0.
  pending_nested_bind_inline: Vec<Int>
  ## B.10 Phase 4 N1 — the ambient "expected type" string an expression is being
  ## lowered INTO (the lvalue/return/param annotation), or "" when none applies.
  ## Set by statement handlers (let-init, return, assignment) around the operand
  ## lowering and cleared after. Supplies the concrete Option type to a niche
  ## construction whose own node can't carry it — notably `None`, which has no
  ## payload to infer from. Read only by the niche-layout path (MEMORY_MODEL_V3
  ## §14.5). Plain string field (not a stack): construction reads it immediately
  ## and Option constructions don't nest as their own expected context.
  niche_expected_type: String
  ## B.10 §14.12.8 (C3) — COW field-access shift flag. When 1, the bare
  ## mir_emit_load_offset / mir_emit_store_offset helpers add +1 to every offset
  ## so field index f lands at buffer word f+1 (offset 0 holds the atomic
  ## refcount header). Set by the field-access lowering sites (read/write/construct)
  ## ONLY around a single offset call when the receiver is a cow-layout buffer
  ## (mir_value_is_cow_layout == 1), then cleared immediately. This is how the
  ## conditional +1 reaches the ~266 shared offset callers without per-site edits:
  ## the helper applies the shift, the lowering site decides WHEN. INERT at gate 0
  ## (mir_value_is_cow_layout returns 0 ⇒ flag never set ⇒ +1 never fires ⇒ gate-0
  ## IR byte-identical). Mirrors the niche_expected_type threading pattern.
  cow_field_shift: Int
  ## B.10 §14.12.8 (C3) — monotonic counter giving each cow_make_unique its own
  ## unique synthetic slot var name (avoids collisions when several make-unique
  ## sequences appear in one function). Bumped per emission. Inert at gate 0.
  cow_mu_seq: Int
  ## item 20 P2 — 1 while lowering a BORROWED mutating value-struct `self`
  ## receiver method (param 0 is `self`, value-layout, COW (>16B), and the body
  ## directly stores `self.<field>`). A borrowed exclusive receiver owns the
  ## caller's live buffer for the call's duration; the caller passes its slot
  ## pointer WITHOUT a retain (the Phase-1 call-site copy elision now extends to
  ## COW), so the callee must NOT (a) register `self` droppable — no scope-exit
  ## cow_release (the caller still owns it; a release here double-frees), and must
  ## NOT (b) make-unique on `self.field=` — the mutation lands IN PLACE in the
  ## caller's buffer (that is the whole point; make-unique would fork to a
  ## throwaway and lose the write, and re-introduce the item-21 iterator loss).
  ## Retain-skip and release-skip move TOGETHER (call site skips the retain via the
  ## same predicate firing). Set in mir_lower_function{,_with_name}, read in the
  ## droppable-param registration and the field-assign make-unique gate. INERT at
  ## gate 0 (cow-layout predicate false ⇒ flag never set ⇒ branches never taken).
  borrowed_self_receiver: Int
  ## F4c (R6) — names of local bindings whose value was placed in an ARENA
  ## (`@arena_name Struct {…}`). An arena-placed value-layout struct is
  ## arena-OWNED, not COW-owned: it is a flat offset+0 buffer with NO refcount
  ## header, freed wholesale by arena_destroy. So every COW consumer (copy-retain,
  ## field-mutation make-unique, scope-exit cow_release) MUST be SUPPRESSED for
  ## these bindings — running cow_rc_inc/make-unique/release on a header-less arena
  ## buffer corrupts memory / double-frees (the ratified R6 "arena-placed structs
  ## stay non-COW" carve-out). Provenance propagates on copy (`var q = p` where p is
  ## arena-owned ⇒ q is too — they share the arena buffer). INERT at gate 0
  ## (a plain struct is not value-layout until the flip ⇒ never cow-layout ⇒ the
  ## suppression branches are never reached; @value-in-arena does not route through
  ## the arena construct arm, see mir_lower.qz NODE_STRUCT_INIT).
  arena_owned_vars: Vec<String>
  ## R-WS3 (mutable capture-by-reference) — names bound in the CURRENT lambda
  ## body as "ref-vars": the local slot for such a name holds a POINTER to the
  ## CALLER'S slot (an env-materialized `addr_of_var`), not the value itself. When
  ## a name is a ref-var, mir_emit_load_var deref-loads through the pointer
  ## (`load_offset(ptr,0)`) and mir_emit_store_var write-throughs
  ## (`store_offset(ptr,0,val)`), so ordinary reads/writes and the assign handler
  ## alias the caller's storage live (mutations persist). Populated per-lambda in
  ## mir_lower_lambda for MUT captures of NON-ESCAPING closures only; saved/cleared
  ## around each lambda body like `bindings`. INERT at gate 0: the compiler's own
  ## closures never assign to a captured outer local, so this stays empty ⇒ every
  ## load/store keeps the byte-identical raw MIR_LOAD_VAR/STORE_VAR path.
  ref_vars: Vec<String>
  ## R-WS3 — AST node ids of NODE_LAMBDA nodes APPROVED as non-escaping (passed
  ## directly as an argument to a whitelisted, known-inline HOF combinator like
  ## `each`/`map`/`reduce`, not go/async/stored). mir_lower_lambda consults this to
  ## decide whether a MUT capture may be taken by-reference (only for approved
  ## nodes; escaping lambdas keep the by-value fallback so no stack address dangles).
  ## Populated at the call-lowering site (mir_lower_call). INERT at gate 0: absence
  ## of any mut capture means the approval is never read into by-ref lowering.
  nonescaping_lambda_nodes: Vec<Int>
  ## Struct type definitions map
  struct_types: Vec
  ## Struct field registry
  struct_registry: Vec<MirStructDef>
  ## Enum names registry
  enum_names: Vec<String>
  ## Enum variants registry
  enum_variants: Vec
  ## Enum variant field types — parallel to enum_variants. Outer indexed by
  ## enum, inner by variant index, innermost is the per-field type-annotation
  ## string ("Int", "String", "Vec<Int>", ...). Used to mark match-pattern
  ## binding names with the right primitive type so downstream passes (e.g.,
  ## the WASM string-interp unwrap helper) can elide runtime to_str dispatch.
  enum_variant_field_types: Vec
  ## Enum payload flags
  enum_has_payloads: Vec<Int>
  ## Global variable registry
  global_registry: Vec
  ## Current source line number
  line: Int
  ## Drop, defer, and droppable stack management
  drops: MirDropState
  ## Stack of labeled loops
  loop_stack: Vec<MirLoopEntry>
  ## Current scope nesting depth
  scope_depth: Int
  ## Scope depth at entry of current loop
  loop_scope_depth: Int
  ## Wrap-stack depth (wrap_stack_eff_names.size) at entry of current loop.
  ## Read by NODE_BREAK / NODE_CONTINUE to drain runtime effect-stack entries
  ## for any `with E {...} do ... end` blocks the break/continue is escaping.
  loop_wrap_depth: Int
  ## Track variables that are Floats
  float_vars: Vec
  ## Generic function specialization state
  generics: MirGenericState
  ## Hoisted Vec data pointers for loop optimization: [[var_name, data_ptr_reg, elem_type], ...]
  hoisted_vec_ptrs: Vec
  ## Tracks which Vec variables hold which element type: [[var_name, elem_type], ...]
  vec_elem_types: Vec
  ## Tracks which Map variables hold which key type: [[var_name, key_type], ...]
  map_key_types: Vec
  ## Tracks which Map variables hold which VALUE type: [[var_name, value_type], ...].
  ## Parallel to map_key_types; needed so `m.set(k, None)` on a
  ## `Map<K, Option<V>>` can recover the concrete `Option<V>` and niche-construct
  ## the value (else a bare None spills to a tagged box that the niche-aware read
  ## side misreads as Some — §14.4 construct-spill/read-niche mismatch).
  map_value_types: Vec
  ## String interner for canonical pointer deduplication
  interner: StringInterner
  ## Params that are Iterator-bounded and lowered as closures (Fn(): Option<Int>)
  iterator_bound_params: Vec<String>
  ## Flow-sensitive narrowing: variable names known to be a specific enum variant
  narrowed_var_names: Vec<String>
  ## Flow-sensitive narrowing: variant names parallel to narrowed_var_names
  narrowed_variant_names: Vec<String>
  ## Effects G.1 — lexical handler stack for static evidence dispatch.
  ## Tracks enclosing `with E { op: h }` blocks so a perform(E, op) call
  ## lexically inside the body resolves to a known handler fn at MIR-emit
  ## time. Innermost entries are at the END of the vecs. One entry per
  ## multi-op record field (matches the runtime push discipline post
  ## H-delegate). Codegen (G.2) reads the annotation on MIR_PERFORM_OP
  ## (operand1) and emits a direct call instead of @__qz_effect_perform.
  handler_stack_effs: Vec<String>
  ## Op filter per stack entry; empty string = "any op of this effect"
  ## (bare-IDENT `with Throws do ... end` shape).
  handler_stack_filters: Vec<String>
  ## Handler fn name as-int per stack entry; 0 = null handler (legacy
  ## IDENT-form, no user handler — dynamic dispatch only, fast path skipped).
  handler_stack_handlers: Vec<Int>
  ## Originating MIR_HANDLE_INSTALL's dest register (reserved for G.3
  ## kind=2 fast-path unwind; not read by G.2 codegen).
  handler_stack_install_dests: Vec<Int>
  ## ----- Wrap-block stack (one entry per `with` block, NOT per evidence
  ## entry — distinct from handler_stack_* above). Used by NODE_RETURN
  ## lowering to emit balancing runtime pops for every wrap region the
  ## return path is escaping. Pushed at NODE_WITH lowering AFTER
  ## mir_emit_handle_install runs; popped BEFORE mir_emit_handle_uninstall
  ## runs on natural fall-through, so during the body the stack reflects
  ## active wraps. Filed under DIAG_WRAP_BLOCK_LEAK_248_ENTRIES_AT_PEAK.
  ##
  ## B.8 Phase 4a: each wrap entry now also carries a `kind` byte and the
  ## fields needed for kind=1 (Scoped resource). The parallel arrays stay
  ## in lockstep with eff_names + pop_counts (one entry pushed per wrap,
  ## regardless of kind). For kind=0 (effect handler — the historical
  ## case), scoped_release_fns[i] = "" and scoped_self/v_slot_names[i] = "".
  ## For kind=1 (Scoped), pop_counts[i] = 0 and eff_names[i] = "" — the
  ## early-exit emission dispatches to a release call instead of an
  ## effect-stack pop.
  ##
  ## Phase 6.5: scoped_v_slot_names replaces the old scoped_v_regs (which
  ## stored the SSA reg of the acquire return value). The wrap-stack drain
  ## now emits `mir_emit_load_var(slot_name)` to read the CURRENT bound-
  ## param value before calling release, so body reassignments to v
  ## propagate to release(self, v). The slot is always alloca'd by
  ## mir_lower_with_scoped (synthetic name when no user-supplied bound
  ## param), and its address is also pushed to the runtime Scoped-ctx TLS
  ## stack so the throw handler can deref-and-release with the same
  ## current-value semantics.
  ##
  ## Phase 2d Bug 4 fix: scoped_self_slot_names replaces the old
  ## scoped_self_regs (SSA reg of the lowered handler expression). In an
  ## async-future-wrapped function (`async f()` → `__Future_f$poll`), the
  ## state-machine emits multiple poll re-entries (poll_start, yield_resume*,
  ## k3_perform_resume*) that branch INTO the middle of the function body.
  ## The handler-expr's SSA register, defined only on the initial entry
  ## path, doesn't dominate release sites reached via yield-resume — LLVM
  ## verifier rejects with "Instruction does not dominate all uses!" on
  ## any `with Scoped do v -> ...` block whose body suspends. Spilling
  ## the handler value to a stack slot and loading it at each drain/
  ## release site is the same pattern scoped_v_slot_names uses for the
  ## acquire-return — both now survive yield/resume.
  wrap_stack_eff_names: Vec<String>
  wrap_stack_pop_counts: Vec<Int>
  wrap_stack_kinds: Vec<Int>
  wrap_stack_scoped_release_fns: Vec<String>
  wrap_stack_scoped_self_slot_names: Vec<String>
  wrap_stack_scoped_v_slot_names: Vec<String>
end

# ============================================================================
# MIR Types
# ============================================================================

# BeType - runtime types (everything is i64 at runtime)
## Integer type (i64).
const MIR_TYPE_INT = 0
## Boolean type (i64, 0 or 1).
const MIR_TYPE_BOOL = 1
## String type (i8*).
const MIR_TYPE_STRING = 2
## Void type (void).
const MIR_TYPE_VOID = 3
## Struct type (pointer to heap).
const MIR_TYPE_STRUCT = 4
## Enum type (tagged union).
const MIR_TYPE_ENUM = 5
## Function type (function pointer).
const MIR_TYPE_FUNC = 6
## Array/Vector type (pointer).
const MIR_TYPE_ARRAY = 7
## Option type.
const MIR_TYPE_OPTION = 8
## Result type.
const MIR_TYPE_RESULT = 9
## Never type.
const MIR_TYPE_NEVER = 10
## F64 type.
const MIR_TYPE_F64 = 11



# Type checking helpers for collection iteration dispatch
## Check if type is a vector/array type (using typecheck constants).
def is_vec_type(ty: Int): Bool = ty == type_constants::TYPE_ARRAY or ty == type_constants::TYPE_VEC

## Check if type is a channel type (using typecheck constants).
def is_channel_type(ty: Int): Bool = ty == type_constants::TYPE_CHANNEL

## Generate unique for-loop temp name using context slot counter.
def gen_for_temp(ctx: MirContext, prefix: String): String
  var id = mir_ctx_alloc_slot(ctx)
  return "#{prefix}_#{id.to_s()}"
end

## Generate temporary name using the current MIR slot counter from context.
def gen_temp_name_with_ctx(ctx: MirContext, prefix: String): String
  var id = mir_ctx_alloc_slot(ctx)
  return "#{prefix}_#{id.to_s()}"
end

# ============================================================================
# MIR Instructions
# ============================================================================

# Instruction kinds
## No operation.
const MIR_NOP = 0
## Integer literal.
const MIR_CONST_INT = 1
## Boolean literal.
const MIR_CONST_BOOL = 2
## String literal.
const MIR_CONST_STRING = 3
## Load variable.
const MIR_LOAD_VAR = 4
## Store variable.
const MIR_STORE_VAR = 5
## Binary operation.
const MIR_BINARY = 6
## Unary operation.
const MIR_UNARY = 7
## Function call.
const MIR_CALL = 8
## Intrinsic call.
const MIR_INTRINSIC = 9
## Function reference.
const MIR_FUNC_REF = 10
## Indirect function call.
const MIR_CALL_INDIRECT = 11
## Memory allocation.
const MIR_ALLOC = 12
## Memory load.
const MIR_LOAD = 13
## Memory store.
const MIR_STORE = 14
## Struct field access.
const MIR_FIELD_ACCESS = 15
## Array index access.
const MIR_INDEX = 16
## Array index store.
const MIR_INDEX_STORE = 17
## Phi node (SSA).
const MIR_PHI = 18
## Load with offset.
const MIR_LOAD_OFFSET = 19
## Select (conditional move).
const MIR_SELECT = 20
## Inline C code.
const MIR_INLINE_C = 21
## Get address of variable.
const MIR_ADDR_OF = 24  # Get address of stack variable (FFI v5.2)
## Float literal constant.
const MIR_CONST_FLOAT = 25  # Float literal constant (F64)
## Union wrap: create tagged pair (tag, value) → ptr.
const MIR_UNION_WRAP = 26
## Union tag: extract tag from tagged pair ptr → tag.
const MIR_UNION_TAG = 27
## Union unwrap: extract value from tagged pair ptr → value.
const MIR_UNION_UNWRAP = 28
## Stack-allocated struct (alloca instead of malloc).
const MIR_ALLOC_STACK = 29
## Extract raw data pointer from Vec handle (for loop hoisting).
const MIR_VEC_DATA_PTR = 30
## Raw index get: data_ptr[idx] with no bounds check, no header traversal.
const MIR_INDEX_RAW = 31
## Raw index store: data_ptr[idx] = val with no bounds check, no header traversal.
const MIR_INDEX_STORE_RAW = 32

## Binary DSL — `type Foo = binary {}` / `packed struct(uN)` codegen glue.
## See docs/design/BINARY_DSL.md. Sub-phase 1.3 (this commit) registers layouts
## and stubs codegen to a runtime panic; sub-phase 1.4 ships real codegen.
## Pack scalar field values into a Bytes buffer according to a registered layout.
## Operands: (layout_id, field_value_ids...). Result: Bytes handle.
const MIR_BINARY_PACK = 33
## Unpack a Bytes buffer into scalar field values per a registered layout.
## Operands: (layout_id, bytes_id). Result: Result<tuple, ParseError> handle.
const MIR_BINARY_UNPACK = 34
## Zero-cost reinterpret between a `packed struct(uN)` and its backing integer.
## Operands: (layout_id, value_id). Result: opposite-typed value.
const MIR_PACKED_BITCAST = 35

# Effects-system Phase 1 C.4.
# Effect-op invocation. func_name = op name (e.g. "throw"). slot2 holds
# the effect name (as-int string pointer) so codegen can thread evidence
# dispatch in C.5. For C.4 codegen this lowers to a stub zero value — the
# handler vtable lookup comes with C.5 + C.6.
const MIR_PERFORM_OP = 36

# Handler install marker for `with H do -> body end`. func_name = effect
# name claimed by the handler. Emitted at the START of the body; pairs
# with MIR_HANDLE_UNINSTALL after. C.4 codegen emits an IR comment only;
# C.5 allocates a stack handler struct + binds evidence for the scope.
const MIR_HANDLE_INSTALL = 37

# Matching uninstall marker emitted at the end of a with-block body.
const MIR_HANDLE_UNINSTALL = 38

# Early-return cleanup for active wrap-blocks: emits N runtime pop calls
# (`@__qz_effect_handle_uninstall(eff)` × N) without the wb.* result-slot /
# done-block dance that MIR_HANDLE_UNINSTALL emits. Used by mir_lower_stmt_return
# (and any other CFG return edge that exits a wrap region) to keep the runtime
# effect-stack balanced when the natural fall-through teardown would be skipped.
# Was filed as the Diag wrap-block leak (248 zombie entries at peak) — see
# docs/bugs/DIAG_WRAP_BLOCK_LEAK_248_ENTRIES_AT_PEAK.md.
const MIR_EFFECT_POP_N = 39

# Done-label-only variant of MIR_HANDLE_UNINSTALL. Emits ONLY the
# `wb.done.NN: ...load + uninstall × N` block, skipping the body
# fall-through prefix (store + br) that the full MIR_HANDLE_UNINSTALL
# emits. Used at NODE_WITH lowering when the body's last block already
# has a terminator (return / break / continue inside the body) — the
# early-exit path has already drained the runtime effect-stack via
# MIR_EFFECT_POP_N, but `wb.catch.NN`'s `br label %wb.done.NN`
# (emitted by MIR_HANDLE_INSTALL) still requires `wb.done.NN` to be
# defined for valid IR. The longjmp-resume path is the only edge into
# wb.done.NN in this case; its load + pops handle the catch-side teardown.
const MIR_HANDLE_UNINSTALL_DONE_ONLY = 40

## B.10 §12.9 — typed interior field address: `getelementptr %struct.Name,
## ..., i32 0, i32 <field_idx>` returning the field's address as an i64 WITHOUT
## loading. Used to embed/read a @value struct field inline inside a generic
## struct specialized at a value-layout type (`Box<P>` storing P inline).
const MIR_FIELD_ADDR = 41

# Terminator kinds
## Return from function.
const TERM_RETURN = 0
## Unconditional jump.
const TERM_JUMP = 1
## Conditional branch.
const TERM_BRANCH = 2
## Unreachable code.
const TERM_UNREACHABLE = 3
const TERM_SWITCH = 4


# ============================================================================
# Operand discrimination table — INC.1.1 (MIR pickling via .qzmod)
# ============================================================================
#
# For each MIR opcode, this table records which operand slots carry STRING
# POINTERS (i.e. raw heap pointers stashed via `as_int(s)` and recovered via
# `as_string(...)`) vs SSA register IDs or raw integers. The MIR pickler
# (see `self-hosted/shared/qzmod_emit.qz`) consults this table to know which
# slots need string-pool indexing before writing to disk, and the unpickler
# (`self-hosted/shared/qzmod_load.qz`) reverses the substitution on load.
#
# SSA register IDs and raw integers (block indices, offsets, layout IDs,
# arity counts, op codes, flags) are function-local — they survive ser-
# ialization unchanged. String pointers do NOT survive — they're rebound
# to the consumer's interner on load.
#
# Encoding for string-typed slots inside the pickle:
#   slot value 0  → 0   (no string / null sentinel)
#   slot value !0 → (pool_index + 1)   (consumer subtracts 1 before lookup)
#
# args[] semantics differ by kind:
#   * MIR_CALL / MIR_INTRINSIC / MIR_CALL_INDIRECT / MIR_INLINE_C /
#     MIR_BINARY_PACK / MIR_INDEX_STORE / MIR_INDEX_STORE_RAW / MIR_PERFORM_OP:
#     args[i] = SSA register ID (function-local).
#   * MIR_HANDLE_INSTALL: args alternates (op_filter_as_int, handler_fn_as_int)
#     pairs — BOTH are string pointers (or 0 for null filter / null handler).
#
# A handful of MIR kinds are defined but never actually emitted by any
# pass (MIR_UNARY, MIR_LOAD, MIR_FIELD_ACCESS, MIR_UNION_*). They get a
# zero mask so unexpected appearances round-trip safely as raw ints —
# defensive forward compat for any future revival.
## Bit 0 of the kind mask: operand1 carries a string pointer.
const MIR_KIND_OP1_STR = 1
## Bit 1: operand2 carries a string pointer.
const MIR_KIND_OP2_STR = 2
## Bit 2: `op` field carries a string pointer.
const MIR_KIND_OP_STR  = 4
## Bit 3: slot1 carries a string pointer.
const MIR_KIND_SLOT1_STR = 8
## Bit 4: slot2 carries a string pointer.
const MIR_KIND_SLOT2_STR = 16
## Bit 5: every args[i] carries a string pointer (uniform per-kind).
const MIR_KIND_ARGS_STR = 32

## Return the string-pointer bitmask for a MIR opcode. See module-level
## comment above for encoding semantics. Returns 0 for any opcode whose
## operand slots carry no strings (and for the vestigial / never-emitted
## opcodes).
##
## INC.1.1: single source of truth for the .qzmod MIR pickler.
def mir_kind_string_mask(kind: Int): Int
  if kind == MIR_CONST_STRING
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_LOAD_VAR
    return MIR_KIND_OP1_STR
  end
  if kind == MIR_STORE_VAR
    return MIR_KIND_OP1_STR
  end
  if kind == MIR_CALL
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_INTRINSIC
    return MIR_KIND_OP2_STR | MIR_KIND_SLOT2_STR
  end
  if kind == MIR_FUNC_REF
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_ALLOC
    return MIR_KIND_OP1_STR
  end
  if kind == MIR_ALLOC_STACK
    return MIR_KIND_OP1_STR
  end
  if kind == MIR_STORE
    return MIR_KIND_OP_STR | MIR_KIND_SLOT2_STR
  end
  if kind == MIR_LOAD_OFFSET
    return MIR_KIND_OP1_STR | MIR_KIND_OP2_STR
  end
  if kind == MIR_INDEX
    return MIR_KIND_SLOT2_STR
  end
  if kind == MIR_INDEX_STORE
    return MIR_KIND_SLOT2_STR
  end
  if kind == MIR_INDEX_RAW
    return MIR_KIND_SLOT2_STR
  end
  if kind == MIR_INDEX_STORE_RAW
    return MIR_KIND_SLOT2_STR
  end
  if kind == MIR_VEC_DATA_PTR
    return MIR_KIND_SLOT2_STR
  end
  if kind == MIR_CONST_FLOAT
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_INLINE_C
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_ADDR_OF
    return MIR_KIND_OP1_STR
  end
  if kind == MIR_PERFORM_OP
    return MIR_KIND_OP1_STR | MIR_KIND_OP2_STR | MIR_KIND_SLOT2_STR
  end
  if kind == MIR_HANDLE_INSTALL
    return MIR_KIND_OP2_STR | MIR_KIND_ARGS_STR
  end
  if kind == MIR_HANDLE_UNINSTALL
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_HANDLE_UNINSTALL_DONE_ONLY
    return MIR_KIND_OP2_STR
  end
  if kind == MIR_EFFECT_POP_N
    return MIR_KIND_OP2_STR
  end
  return 0
end


# ============================================================================
# Drop Trait RAII Support
# ============================================================================

# Drop types and droppable variables are stored in the MIR context:
# - Slot 20: drop_types registry (vec of type names)
# - Slot 21: droppable_stack (vec of {name, ty, depth} tuples as vecs)
# - Slot 22: current_scope_depth (int)

## Get drop types registry from context.
def mir_ctx_get_drop_types(ctx: MirContext): Vec<String> = ctx.drops.drop_types

## Get droppable stack from context.
def mir_ctx_get_droppable_stack(ctx: MirContext): Vec<MirDropEntry> = ctx.drops.droppable_stack

## Get current scope depth from context.
def mir_ctx_get_scope_depth(ctx: MirContext): Int = ctx.scope_depth

## Set current scope depth in context.
def mir_ctx_set_scope_depth(ctx: MirContext, depth: Int): Void
  ctx.scope_depth = depth
end

## Get loop scope depth (scope depth at loop entry).
def mir_ctx_get_loop_scope_depth(ctx: MirContext): Int = ctx.loop_scope_depth

## Set loop scope depth.
def mir_ctx_set_loop_scope_depth(ctx: MirContext, depth: Int): Void
  ctx.loop_scope_depth = depth
end

## Get loop wrap depth (wrap_stack size at loop entry). Used by NODE_BREAK /
## NODE_CONTINUE to drain runtime effect-stack entries for `with E {...} do ... end`
## blocks the break/continue is escaping. Mirrors loop_scope_depth / loop_defer_depth.
def mir_ctx_get_loop_wrap_depth(ctx: MirContext): Int = ctx.loop_wrap_depth

## Set loop wrap depth.
def mir_ctx_set_loop_wrap_depth(ctx: MirContext, depth: Int): Void
  ctx.loop_wrap_depth = depth
end

## Push a flow-sensitive narrowing: variable `var_name` is known to be `variant_name`.
def mir_ctx_push_narrowing(ctx: MirContext, var_name: String, variant_name: String): Void
  ctx.narrowed_var_names.push(var_name)
  ctx.narrowed_variant_names.push(variant_name)
end

## Get current narrowing stack depth (for save/restore).
def mir_ctx_get_narrowing_count(ctx: MirContext): Int = ctx.narrowed_var_names.size

## Restore narrowing stack to a previous depth.
def mir_ctx_pop_narrowing_to(ctx: MirContext, count: Int): Void
  while ctx.narrowed_var_names.size > count
    ctx.narrowed_var_names.pop()
    ctx.narrowed_variant_names.pop()
  end
end

## Find narrowing for a variable. Returns variant name if narrowed, "" if not.
## Searches from top of stack (innermost scope wins).
def mir_ctx_find_narrowing(ctx: MirContext, var_name: String): String
  var i = ctx.narrowed_var_names.size - 1
  while i >= 0
    if ctx.narrowed_var_names[i] == var_name
      return ctx.narrowed_variant_names[i]
    end
    i -= 1
  end
  return ""
end

## Get loop defer depth (defer stack depth at loop entry).
def mir_ctx_get_loop_defer_depth(ctx: MirContext): Int = ctx.drops.loop_defer_depth

## Set loop defer depth.
def mir_ctx_set_loop_defer_depth(ctx: MirContext, depth: Int): Void
  ctx.drops.loop_defer_depth = depth
end

## Register a type as implementing Drop.
def register_drop_type(ctx: MirContext, type_name: String): Void
  var drop_types = mir_ctx_get_drop_types(ctx)
  return if any?(drop_types, dt: String -> dt == type_name)
  drop_types.push(type_name)
end

## Check if a type implements Drop.
def type_has_drop(ctx: MirContext, type_name: String): Bool
  var drop_types = mir_ctx_get_drop_types(ctx)
  return any?(drop_types, dt: String -> dt == type_name)
end

## Check if a type needs drop (impls Drop or has droppable fields).
def type_needs_drop(ctx: MirContext, type_name: String): Bool
  # B.10 §14.12.8 (C4) — a cow-layout @value struct needs a drop even with NO user
  # Drop impl: scope-exit must cow_rc_dec the shared buffer (and free at rc 0). This
  # makes such bindings get push_droppable'd so emit_drops_for_scope sees them and
  # routes through the cow_release destroy arm. INERT at gate 0 (predicate false).
  return true if mir_value_is_cow_layout(ctx, type_name) == 1
  # Direct Drop implementation
  return true if type_has_drop(ctx, type_name)
  # Check struct fields recursively
  var struct_info = mir_ctx_get_struct_fields(ctx, type_name)
  return false if struct_info.is_none()
  var field_types = struct_info.unwrap().field_types
  return any?(field_types, ft: String -> type_needs_drop(ctx, ft))
end

## B.10 §14.12.8 (C4) — 1 iff `var_name` is already on the droppable stack at the
## current depth (used to keep cow-layout let-binding pushes idempotent across the
## several type-tracking branches in mir_lower_stmt_let). Plain membership check —
## no gate, harmless when unused.
def mir_is_droppable_pushed(ctx: MirContext, var_name: String): Int
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == var_name
      return 1
    end
    i -= 1
  end
  return 0
end

## B.10 §14.12.8 (C4 reassign-fix) — handle the OLD value of `var_name` when a
## binding is REASSIGNED (`e = …` where `e` already held a cow-layout @value).
## Without this the rebind (which routes through the SAME mir_lower_stmt_let body
## as a fresh `var`) would (a) leak the old cow buffer — its refcount is never
## decremented — and (b) push a DUPLICATE droppable entry, so scope-exit emits TWO
## cow_releases both loading `e`'s CURRENT (new) value ⇒ double-free / SIGABRT.
##
## On a genuine cow rebind this:
##   1. loads `var_name`'s OLD value (still in the slot — the new value is not stored
##      until AFTER this returns) and cow_releases it (rc_dec, free at rc 0), and
##   2. UPDATES the existing same-name droppable entry's tracked type to the new
##      value's type in place (so scope exit releases the CURRENT buffer exactly
##      once against the correct type) instead of letting the caller push a
##      duplicate.
## Returns 1 iff it found+updated an existing same-name cow droppable entry (the
## caller then SKIPS its own push_droppable to avoid a duplicate). Returns 0 when
## there is no prior droppable entry for the name (a fresh bind) ⇒ caller pushes as
## usual. Keyed on mir_value_is_cow_layout ⇒ INERT at gate 0 (predicate false). The
## new type must itself be cow-layout for the in-place update to keep the entry
## valid; if the rebind narrows to a non-cow value the old entry is REMOVED (no
## stale cow_release fires for a binding whose current value is not a cow buffer).
def mir_cow_rebind_handle_old(ctx: MirContext, var_name: String, new_type: String): Int
  return 0 if mir_value_cow_live() == 0
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var depth = mir_ctx_get_scope_depth(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == var_name and entry.depth == depth
      # Only the cow destroy arm needs the old-value release. A non-cow droppable
      # (user Drop / nested) reassign is already handled by mir_lower_stmt_assign;
      # the LET path here only fires for cow-layout @value rebinds.
      if mir_value_is_cow_layout(ctx, entry.type_name) == 1
        var old_val = mir_emit_load_var(ctx, var_name)
        mir_emit_cow_release(ctx, old_val, entry.type_name)
        if mir_value_is_cow_layout(ctx, new_type) == 1
          # Rebind stays cow: keep ONE entry, retarget it to the new value's type
          # so scope exit releases the new buffer (and only once).
          entry.type_name = new_type
          droppable_stack[i] = entry
          return 1
        else
          # Rebind narrows to a non-cow value: the binding no longer owns a cow
          # buffer. Tombstone the entry (empty type_name) so scope exit emits NO
          # cow_release/drop for it (mir_value_is_cow_layout("")==0 and
          # type_has_drop("")==false). Tombstoning avoids reindexing the LIFO stack
          # (preserving every other entry's order, unlike a remove).
          entry.type_name = ""
          droppable_stack[i] = entry
          return 1
        end
      end
      return 0
    end
    i -= 1
  end
  return 0
end

## GAP-2 (Drop soundness) — handle the OLD value of `var_name` on a REBIND of a
## NON-cow binding that carries a user `Drop` impl (or droppable fields). A bare
## `d = D{…}` / `d = make()` reassignment lowers to a NODE_LET rebind (is_mut==0),
## NOT a NODE_ASSIGN, so it routes through mir_lower_stmt_let — the same body as a
## fresh `var`. Without this the rebind would LEAK the old value (its drop is never
## emitted) and, because the duplicate push at the struct-init site is now skipped,
## leave the single droppable entry pointed at the new value (dropped once at scope
## exit). This releases the OLD value NOW, before the new value is stored:
##   1. loads `var_name`'s OLD value (still in the slot — the new value is stored
##      only AFTER this returns) and drops it via mir_emit_droppable_value_drop
##      (direct `<Type>$drop` + nested-field drops), and
##   2. retargets the existing same-name droppable entry's tracked type to the new
##      value's (bare) type so scope exit drops the CURRENT value exactly once.
## Returns 1 iff it found+handled an existing same-name non-cow droppable entry (so
## the caller knows the rebind old-drop was emitted); 0 otherwise (fresh bind, or a
## cow entry which mir_cow_rebind_handle_old owns). The cow arm is intentionally left
## to mir_cow_rebind_handle_old (called first at the same site). GATE-0-INERT: the
## compiler's own reassignments are non-Drop ⇒ no entry has type_needs_drop ⇒ this
## emits nothing ⇒ byte-identical self-compile.
def mir_rebind_drop_old_value(ctx: MirContext, var_name: String, new_type: String): Int
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var depth = mir_ctx_get_scope_depth(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == var_name and entry.depth == depth
      # cow entries are handled by mir_cow_rebind_handle_old (runs first); a
      # tombstoned entry (empty type_name) or a cow-layout entry is skipped here.
      if str_byte_len(entry.type_name) > 0 and mir_value_is_cow_layout(ctx, entry.type_name) == 0
        if type_needs_drop(ctx, entry.type_name)
          var old_val = mir_emit_load_var(ctx, var_name)
          mir_emit_droppable_value_drop(ctx, old_val, entry.type_name)
        end
        # Retarget the entry to the new value's (bare) type so scope exit drops the
        # CURRENT value once against the correct type. Strip any generic args so
        # emit_drops_for_scope mangles `<Base>$drop` (matching the struct-init push).
        var nt = new_type
        var lt = __char_index(nt, '<')
        if lt > 0
          nt = str_byte_slice(nt, 0, lt)
        end
        entry.type_name = nt
        droppable_stack[i] = entry
        return 1
      end
      return 0
    end
    i -= 1
  end
  return 0
end

## GAP-1 (Drop soundness) — SAME-SCOPE SHADOWING of a droppable binding. A fresh
## `var x = D{…}; var x = D{…}` at the SAME scope depth is NOT a rebind
## (c4_is_local_rebind==0, is_mut==1), so mir_lower_stmt_let pushes a SECOND
## droppable entry with the SAME var_name+depth as the first. Both entries resolve
## their value at scope exit via mir_emit_load_var(var_name), which — since
## MIR_LOAD_VAR/MIR_STORE_VAR are keyed by NAME (codegen allocas are name-keyed, not
## by the distinct MIR slot id) — reads the LATEST value for BOTH ⇒ the first
## binding's value is LEAKED (never dropped) and the second is DOUBLE-DROPPED.
##
## Fix: when a fresh `var` shadows a still-live droppable entry, SPILL the old
## binding's value into a fresh, uniquely-named slot BEFORE the new value overwrites
## the shared `%<name>` slot, and RETARGET the shadowed (older) entry to that fresh
## name. At scope exit load-by-name then resolves each entry to its OWN slot: the
## shadowed entry → the versioned slot (holds the old value), the new entry → the
## `<name>` slot (holds the new value) ⇒ each value drops exactly once. The versioned
## slot is a plain STORE_VAR to a name codegen has never emitted, so cg_collect_vars
## auto-registers a distinct alloca for it.
##
## Called from mir_lower_stmt_let AFTER the RHS (init_val) is lowered but BEFORE the
## new value is stored (the shared slot still holds the OLD value at this point),
## mirroring the rebind old-value site. It walks from the top and RETARGETS the FIRST
## PRIOR same-name+depth entry BELOW the just-pushed one (i.e. the second match).
## Returns 1 iff it found a prior entry and spilled it; 0 otherwise (no shadow — a
## first-of-its-name binding, so nothing to spill).
##
## Reconciliation with GAP-2's rebind retarget: a rebind (`x = …`) NEVER pushes a
## second entry (the struct-init push is skipped on c4_is_local_rebind), so there is
## only ever one same-name entry for a rebind — this helper's "prior entry" search
## finds nothing and returns 0, leaving mir_rebind_drop_old_value in sole charge of
## the rebind path. Shadowing and rebind are thus disjoint. GATE-0-INERT: the
## compiler's own source has no same-scope Drop shadowing, and the retarget/spill only
## fires when a SECOND droppable entry already exists for a name — never true for the
## compiler (its droppable entries are all cow/non-Drop and never same-scope-shadowed)
## ⇒ byte-identical self-compile.
def mir_shadow_spill_prior_value(ctx: MirContext, var_name: String): Int
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var depth = mir_ctx_get_scope_depth(ctx)
  var seen_top = 0
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == var_name and entry.depth == depth
      if seen_top == 0
        # The just-pushed NEW entry (topmost same-name/depth). Leave it targeting
        # `<name>`; keep scanning for the shadowed (older) entry below it.
        seen_top = 1
      else
        # The shadowed (older) binding. Spill its value out of the shared slot into
        # a fresh, uniquely-named slot and retarget this entry to that name. The
        # shared slot still holds the OLD value here (the new value is stored only
        # after this returns), so a load-by-name reads the value to preserve.
        var fresh_slot = mir_ctx_alloc_slot(ctx)
        var spill_name = "#{var_name}.shadow.#{fresh_slot}"
        var old_val = mir_emit_load_var(ctx, var_name)
        mir_emit_store_var(ctx, spill_name, old_val)
        entry.var_name = spill_name
        droppable_stack[i] = entry
        return 1
      end
    end
    i -= 1
  end
  return 0
end

## B.10 §14.12.8 (C4.5/h6) — 1 iff `init_node` reads a value OUT of a Vec/index into
## a fresh binding (`r = v[0]`, `r = v.get(i)`, `r = v.get_unchecked(i)`). These are
## exactly the C3.5-modified read sites that return the bare buffer POINTER for a
## cow-layout element (NODE_INDEX, and the `vec_get`/`vec_get_unchecked` intrinsic
## calls). Used by the let-binding to decide whether a cow read-out must be retained
## (cow_rc_inc) + pushed droppable, distinguishing it from a constructor CALL (already
## owned, MOVED) and from a transient field-access read. A slice (`v[a..b]`) is a
## NODE_INDEX with a RANGE index — excluded (it produces a Slice header, not a single
## element); checked by the caller via the inferred element type being cow-layout.
## No gate keyword here — harmless when the type predicate (caller) is false.
def mir_init_is_cow_collection_readout(ctx: MirContext, s: ast::AstStorage, init_node: AstNodeId): Int
  return 0 if init_node == 0
  var kind = ast::ast_get_kind(s, init_node)
  # `v[i]` — NODE_INDEX with a NON-range index (a range index `v[a..b]` produces a
  # Slice header, not a single element, so it is NOT a per-element read-out).
  if kind == node_constants::NODE_INDEX
    var index_node = ast::ast_get_right(s, init_node)
    if index_node != 0
      if ast::ast_get_kind(s, index_node) == node_constants::NODE_BINARY
        var idx_op = ast::ast_get_op(s, index_node)
        if idx_op == op_constants::OP_RANGE or idx_op == op_constants::OP_RANGE_INCLUSIVE
          return 0
        end
      end
    end
    return 1
  end
  # `v.get(i)` / `v.get_unchecked(i)` — typecheck rewrites these to the C3.5-modified
  # `vec_get` / `vec_get_unchecked` intrinsic calls, which return the bare cow buffer
  # pointer for a cow-layout element.
  if kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(s, init_node)
    if callee != 0
      if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
        var fname = ast::ast_get_str1(s, callee)
        if fname == "vec_get" or fname == "vec_get_unchecked"
          return 1
        end
        if str_ends_with(fname, "$vec_get") == 1 or str_ends_with(fname, "$vec_get_unchecked") == 1
          return 1
        end
        # F4 item-2a — `first`/`last` over a Vec of a COW-layout (>16B value)
        # element return the bare cow buffer POINTER from slot 0 / slot (len-1)
        # (the legacy single-i64 load, exactly like `vec_get`'s handle path). A
        # readout bind (`f = v.first()`) MUST therefore be tracked as the cow
        # element so `f.field` applies the +1 refcount shift + make-unique, AND
        # a cow_rc_inc retain must fire (the new owner holds its own counted
        # reference — else clearing/dropping `v` frees the buffer under `f`).
        # WITHOUT this, `f` is tracked as a plain (non-cow) struct and `f.field`
        # reads at offset+0 → hits the refcount word / one field low (item-2a
        # garbage bug). Only a COW element diverges: `mir_cow_readout_elem_type`
        # resolves the receiver's `Vec<S>` element `S`, and the LET handler gates
        # the retain/mark on `mir_value_is_cow_layout(S)` ⇒ scalar / reference /
        # inline (<=16B flat, item-50 by-address) elements return "" or non-cow
        # ⇒ INERT (byte-identical). Gate-0-dead (no @value first/last binding in
        # the compiler's own source). Cow first/last panic-on-empty (codegen), so
        # the retained pointer is always a valid buffer.
        if fname == "first" or fname == "last"
          return 1
        end
        if str_ends_with(fname, "$first") == 1 or str_ends_with(fname, "$last") == 1
          return 1
        end
        # B.10 §14.12.8 (C4.6/h9) — Option/Map unwrap readout. `r = v.get(i).unwrap()`
        # and `r = m.get(k).unwrap()` lower the unwrap CALL whose first arg IS the
        # cow buffer pointer (`Some(x)` is `x` — identity; the boxed/niche unwrap
        # both return the stored handle). Binding it WITHOUT a retain aliases the
        # element (corrupt on mutate at rc==1; UAF if the collection frees). Recurse
        # into the unwrapped subject: only a readout iff that subject is itself a
        # cow collection readout (`vec_get`/`vec_get_unchecked`/`map_get`/`[i]`).
        # `v.get(i).unwrap().x` is a NODE_FIELD_ACCESS init (transient scalar), NOT a
        # NODE_CALL of unwrap, so it never reaches here ⇒ no double-retain.
        if mir_cow_readout_unwrap_subject(s, init_node) != 0
          return 1
        end
      end
    end
  end
  return 0
end

## B.10 §14.12.8 (C4.6/h9) — if `call_node` is an `unwrap`/`option_get` CALL whose
## unwrapped subject (arg[0]) is itself a cow collection readout (`vec_get`,
## `vec_get_unchecked`, `map_get`, or `v[i]`), return that subject node; else 0.
## This is the recursion engine for both the readout predicate and the elem-type
## resolver, so they agree on what counts as an unwrap-of-readout (Result-NO-GO
## "construct/read must agree" lesson). Only single-arg unwrap; never matches a
## transient field-access (`...unwrap().x` is a FIELD_ACCESS node, not this CALL).
def mir_cow_readout_unwrap_subject(s: ast::AstStorage, call_node: AstNodeId): AstNodeId
  return 0 if call_node == 0
  return 0 if ast::ast_get_kind(s, call_node) != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, call_node)
  return 0 if callee == 0
  return 0 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  var fname = ast::ast_get_str1(s, callee)
  var is_unwrap = fname == "unwrap" or fname == "option_get" or str_ends_with(fname, "$unwrap") == 1
  return 0 if is_unwrap == false
  var args = ast::ast_get_children(s, call_node)
  return 0 if args.size == 0
  var subj = args[0]
  return 0 if subj == 0
  var sk = ast::ast_get_kind(s, subj)
  # subject is `v[i]` (non-range index)
  if sk == node_constants::NODE_INDEX
    var idx = ast::ast_get_right(s, subj)
    if idx != 0
      if ast::ast_get_kind(s, idx) == node_constants::NODE_BINARY
        var iop = ast::ast_get_op(s, idx)
        return 0 if iop == op_constants::OP_RANGE or iop == op_constants::OP_RANGE_INCLUSIVE
      end
    end
    return subj
  end
  # subject is a vec_get / vec_get_unchecked / map_get CALL
  if sk == node_constants::NODE_CALL
    var sc = ast::ast_get_left(s, subj)
    return 0 if sc == 0
    return 0 if ast::ast_get_kind(s, sc) != node_constants::NODE_IDENT
    var sfn = ast::ast_get_str1(s, sc)
    if sfn == "vec_get" or sfn == "vec_get_unchecked" or sfn == "map_get"
      return subj
    end
    if str_ends_with(sfn, "$vec_get") == 1 or str_ends_with(sfn, "$vec_get_unchecked") == 1 or str_ends_with(sfn, "$map_get") == 1 or str_ends_with(sfn, "$get") == 1
      return subj
    end
  end
  return 0
end

## B.10 §14.12.8 (C4.5/h6) — resolve the cow ELEMENT type read out by `init_node`,
## for the read-out forms `mir_init_is_cow_collection_readout` recognizes. For a
## NODE_INDEX (`v[i]`) the element type is `mir_infer_expr_type(init_node)` directly.
## For a `vec_get`/`vec_get_unchecked` CALL the element type is the generic element of
## the FIRST arg (the Vec receiver), since these intrinsics are not return-type-tracked.
## Returns "" if it cannot be determined (caller treats "" as non-cow ⇒ no retain).
def mir_cow_readout_elem_type(ctx: MirContext, s: ast::AstStorage, init_node: AstNodeId): String
  return "" if init_node == 0
  var kind = ast::ast_get_kind(s, init_node)
  if kind == node_constants::NODE_INDEX
    return mir_infer_expr_type(ctx, s, init_node)
  end
  if kind == node_constants::NODE_CALL
    # B.10 §14.12.8 (C4.6/h9) — unwrap-of-readout: resolve the element type of the
    # UNWRAPPED subject (`m.get(k).unwrap()` ⇒ the Map VALUE type; `v.get(i).unwrap()`
    # ⇒ the Vec element type). Recurse via the shared subject finder so predicate +
    # resolver agree on the form.
    var unwrap_subj = mir_cow_readout_unwrap_subject(s, init_node)
    if unwrap_subj != 0
      return mir_cow_readout_elem_type(ctx, s, unwrap_subj)
    end
    var call_args = ast::ast_get_children(s, init_node)
    return "" if call_args.size == 0
    var recv = call_args[0]
    return "" if recv == 0
    # B.10 §14.12.8 (C4.6/h8) — map_get readout: element type is the Map VALUE type,
    # not a `Vec<T>` generic element. Resolve from the receiver's `Map<K,V>` type.
    var callee = ast::ast_get_left(s, init_node)
    if callee != 0
      if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
        var cfn = ast::ast_get_str1(s, callee)
        if cfn == "map_get" or str_ends_with(cfn, "$map_get") == 1
          var m_recv_ty = mir_infer_expr_type(ctx, s, recv)
          if str_byte_len(m_recv_ty) > 0
            var m_resolved = mir_resolve_struct_name(ctx, m_recv_ty)
            var mv = mir_extract_map_value_type(m_resolved)
            return mv if str_byte_len(mv) > 0
            mv = mir_extract_map_value_type(m_recv_ty)
            return mv if str_byte_len(mv) > 0
          end
          # bare-Map receiver: type inference yields "" for map vars (their VALUE
          # type lives in the map_value_types registry, keyed by var name), so
          # consult it directly — mirrors the vec_elem_types fallback below.
          if ast::ast_get_kind(s, recv) == node_constants::NODE_IDENT
            var m_recv_name = ast::ast_get_str1(s, recv)
            return mir_ctx_get_map_value_type(ctx, m_recv_name)
          end
          return ""
        end
      end
    end
    var recv_ty = mir_infer_expr_type(ctx, s, recv)
    return "" if str_byte_len(recv_ty) == 0
    var resolved = mir_resolve_struct_name(ctx, recv_ty)
    var elem = mir_extract_generic_element_type(resolved)
    return elem if str_byte_len(elem) > 0
    elem = mir_extract_generic_element_type(recv_ty)
    return elem if str_byte_len(elem) > 0
    # bare-Vec receiver: consult the vec_elem_types registry by the receiver's name.
    if ast::ast_get_kind(s, recv) == node_constants::NODE_IDENT
      var recv_name = ast::ast_get_str1(s, recv)
      return mir_ctx_get_vec_elem_type(ctx, recv_name)
    end
    return ""
  end
  return ""
end

## Push a droppable variable onto the stack.
def push_droppable(ctx: MirContext, var_name: String, type_name: String): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var depth = mir_ctx_get_scope_depth(ctx)
  var entry = MirDropEntry { var_name: var_name, type_name: type_name, depth: depth }
  droppable_stack.push(entry)
end

## Emit drop calls for nested fields that implement Drop (recursive).
def emit_nested_drops(ctx: MirContext, var_val: Int, type_name: String): Void
  var struct_info = mir_ctx_get_struct_fields(ctx, type_name)
  return if struct_info.is_none()  # Not a struct, nothing to do

  var si = struct_info.unwrap()
  var field_names = si.field_names
  var field_types = si.field_types
  var field_count = vec_size(field_names)

  for f in 0..field_count
    var field_type = field_types[f]
    # Use type_needs_drop for traversal — finds fields that need dropping at any depth
    if type_needs_drop(ctx, field_type)
      # Extract field value using load_offset (avoids SSA corruption from field_access)
      var field_name = field_names[f]
      var field_val = mir_emit_load_offset(ctx, var_val, f)
      
      # Only call FieldType$drop if it directly implements Drop
      if type_has_drop(ctx, field_type)
        var drop_func = string_intern::mangle(field_type, "drop")
        var args = vec_new()
        args.push(field_val)
        mir_emit_call(ctx, drop_func, args)
      end
      
      # Recursively drop nested fields
      emit_nested_drops(ctx, field_val, field_type)
    end
  end
end

## Emit the drop for a single already-loaded droppable value of `type_name`.
## Mirrors the non-arena branch of emit_drops_for_scope: cow-layout release for
## flat @value buffers, else the direct `<Type>$drop` call (resolved through the
## module-prefix suffix-search) plus recursive nested-field drops. The arena
## carve-out is NOT applied here — callers that can hold an arena-owned binding
## (the scope-exit walkers) still gate on mir_ctx_is_arena_owned themselves; this
## helper is for a concrete value the caller already knows must be released
## (scope-exit non-arena entries, and the reassignment old-value drop). INERT at
## gate 0 for the direct path (the compiler's own reassignments are non-Drop) and
## for the cow arm (no @value struct pre-flip).
def mir_emit_droppable_value_drop(ctx: MirContext, load_val: Int, type_name: String): Void
  if mir_value_is_cow_layout(ctx, type_name) == 1
    mir_emit_cow_release(ctx, load_val, type_name)
    return
  end
  if type_has_drop(ctx, type_name)
    var drop_func = string_intern::mangle(type_name, "drop")
    # Resolve module-prefixed name: Arena$drop → memory$Arena$drop
    # Can't use mir_resolve_func_name (returns $ names as-is), so suffix-search all_funcs
    var all_funcs = mir_ctx_get_all_funcs(ctx)
    if all_funcs != 0
      var drop_suffix = "$#{drop_func}"
      for dfi in 0..all_funcs.size
        var dfe = all_funcs[dfi]
        if dfe.tag == 0 and str_ends_with(dfe.name, drop_suffix)
          drop_func = dfe.name
          break
        end
      end
    end
    var args = vec_new()
    args.push(load_val)
    mir_emit_call(ctx, drop_func, args)
  end
  emit_nested_drops(ctx, load_val, type_name)
end

## Emit drop calls for all variables at or above target_depth (LIFO).
def emit_drops_for_scope(ctx: MirContext, target_depth: Int): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.depth >= target_depth
      var load_val = mir_emit_load_var(ctx, entry.var_name)
      # F4c (R6) — arena-owned binding: its value lives in an arena (freed wholesale
      # by arena_destroy), NOT a COW refcount buffer. Skip cow_release entirely —
      # running cow_rc_dec/free on a header-less arena buffer double-frees. The arena
      # carve-out (ratified R6). INERT at gate 0 (no arena binding is cow-layout
      # pre-flip ⇒ this would not have hit the cow arm anyway).
      if mir_ctx_is_arena_owned(ctx, entry.var_name) == 1
        # arena-owned: arena_destroy reclaims the buffer; nothing to drop here.
      # B.10 §14.12.8 (C4) — cow-layout destroy arm + generic drop path, shared with
      # the reassignment old-value drop via mir_emit_droppable_value_drop.
      else
        mir_emit_droppable_value_drop(ctx, load_val, entry.type_name)
      end
    end
    i -= 1
  end
end

## Emit drop calls AND remove entries at or above target_depth (LIFO).
## Used for block-exit drops where the variable should not be re-dropped at function exit.
def emit_and_pop_drops_for_scope(ctx: MirContext, target_depth: Int): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  # First pass: emit drops in LIFO order
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.depth >= target_depth
      var load_val = mir_emit_load_var(ctx, entry.var_name)
      # F4c (R6) — arena-owned binding: arena_destroy reclaims it; skip cow_release
      # (see emit_drops_for_scope). INERT at gate 0.
      if mir_ctx_is_arena_owned(ctx, entry.var_name) == 1
        # arena-owned: nothing to drop here.
      # B.10 §14.12.8 (C4) — cow-layout destroy arm + generic drop path, shared with
      # the reassignment old-value drop via mir_emit_droppable_value_drop.
      else
        mir_emit_droppable_value_drop(ctx, load_val, entry.type_name)
      end
    end
    i -= 1
  end
  # Second pass: remove entries (iterate backward to safely remove)
  var j = droppable_stack.size - 1
  while j >= 0
    var entry = droppable_stack[j]
    if entry.depth >= target_depth
      vec_delete(droppable_stack, j)
    end
    j -= 1
  end
end

## Remove droppable entries at or above target_depth WITHOUT emitting drops.
## Used after loop body lowering to prevent function-exit re-drops.
## The drop IR was already emitted in the loop body block via emit_drops_for_scope.
def pop_droppables_for_scope(ctx: MirContext, target_depth: Int): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var j = droppable_stack.size - 1
  while j >= 0
    var entry = droppable_stack[j]
    if entry.depth >= target_depth
      vec_delete(droppable_stack, j)
    end
    j -= 1
  end
end

## Pop droppable entries at or above target_depth WITHOUT emitting drops.
## Used when an arm already handled drops (e.g., via return) but entries must be
## removed so subsequent match arms don't re-drop them.
def mir_pop_drops_for_scope(ctx: MirContext, target_depth: Int): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var j = droppable_stack.size - 1
  while j >= 0
    var entry = droppable_stack[j]
    if entry.depth >= target_depth
      vec_delete(droppable_stack, j)
    end
    j -= 1
  end
end

## Transfer droppable ownership from src to dst (src removed from stack).
## Used when `var b = a` where both are droppable — a no longer needs dropping.
def mir_transfer_droppable(ctx: MirContext, src_name: String, dst_name: String): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == src_name
      vec_delete(droppable_stack, i)
      return
    end
    i -= 1
  end
end

## Remove a droppable variable from the stack (ownership consumed by callee).
def mir_consume_droppable(ctx: MirContext, var_name: String): Void
  var droppable_stack = mir_ctx_get_droppable_stack(ctx)
  var i = droppable_stack.size - 1
  while i >= 0
    var entry = droppable_stack[i]
    if entry.var_name == var_name
      vec_delete(droppable_stack, i)
      return
    end
    i -= 1
  end
end

## Reset droppable tracking for a new function.
def reset_droppables(ctx: MirContext): Void
  # Clear the droppable stack
  ctx.drops.droppable_stack = vec_new()
  mir_ctx_set_scope_depth(ctx, 0)
end

# ============================================================================
# Defer Support - Deferred expression execution on function exit
# ============================================================================

# Block-scoped defer: defer_stack is a Vec of Vecs (scope stack)
# Each scope is a Vec of [ast_store, node] entries

## Push a new defer scope (called at block entry).
def defer_scope_push(ctx: MirContext): Void
  var scope = vec_new()
  ctx.drops.defer_stack.push(scope)
end

## Discard a scope without emitting defers (for terminated blocks).
def defer_scope_discard(ctx: MirContext): Void
  var scope_stack = ctx.drops.defer_stack
  if scope_stack.size > 0
    var popped = __vec_pop_raw(scope_stack)
  end
end

## Push a deferred expression onto the innermost scope.
def push_defer(ctx: MirContext, ast_store: ast::AstStorage, node: AstNodeId): Void
  var scope_stack = ctx.drops.defer_stack
  var depth = scope_stack.size
  if depth == 0
    return
  end
  var inner_scope = scope_stack[depth - 1]
  var entry = [ast_store, node]
  vec_push(inner_scope, entry)
end


## Reset defer stack for a new function.
def reset_defers(ctx: MirContext): Void
  ctx.drops.defer_stack = vec_new()
end

# ============================================================================
# MIR Storage (arena-style, parallel vectors)
# ============================================================================

## Create new MIR program storage.
def mir_new_program(): MirProgram
  return MirProgram {
    functions: vec_new(),
    string_pool: vec_new<String>(),
    struct_defs: vec_new(),
    enum_defs: vec_new(),
    global_names: vec_new<String>(),
    global_inits: vec_new(),
    global_str_inits: vec_new<String>(),
    const_names: vec_new<String>(),
    const_values: vec_new(),
    uses_task_group: 0,
    global_thread_locals: vec_new(),
    global_alias_names: vec_new<String>(),
    global_alias_targets: vec_new<String>(),
    uses_scheduler: 0,
    uses_intern: 0,
    uses_cache: 0,
    uses_profile: 0,
    uses_yield: 0,
    uses_scope_deadline: 0,
    binary_layout_names: vec_new<String>(),
    binary_layout_kinds: vec_new(),
    binary_layout_backing: vec_new(),
    binary_layout_field_offsets: vec_new(),
    binary_layout_field_counts: vec_new(),
    binary_field_names: vec_new<String>(),
    binary_field_specs: vec_new<String>(),
    binary_field_widths: vec_new(),
    binary_field_compute_asts: vec_new(),
    binary_layout_union_disc_idx: vec_new(),
    binary_layout_union_arm_offset: vec_new(),
    binary_layout_union_arm_count: vec_new(),
    binary_union_arm_tags: vec_new(),
    binary_union_arm_field_offsets: vec_new(),
    binary_union_arm_field_counts: vec_new(),
    binary_union_field_names: vec_new<String>(),
    binary_union_field_specs: vec_new<String>(),
    binary_union_field_widths: vec_new(),
    panic_handler_name: ""
  }
end

## Register a function as the program's panic handler. Errors if one
## is already registered — only one @panic_handler per program.
def mir_set_panic_handler(prog: MirProgram, name: String): Void
  if str_byte_len(prog.panic_handler_name) > 0
    panic("multiple @panic_handler functions: #{prog.panic_handler_name} and #{name}")
  end
  prog.panic_handler_name = name
end

## Get the registered panic handler's mangled LLVM symbol name, or
## "" if none is registered.
def mir_get_panic_handler(prog: MirProgram): String = prog.panic_handler_name

## Register a binary {} or packed struct(uN) layout in the MIR program.
## Returns the layout_id (index) assigned. Called by mir_lower when it sees
## a NODE_BINARY_BLOCK (kind=1) or NODE_PACKED_STRUCT (kind=2) at top level.
##
## `field_names` / `field_specs` / `field_widths` / `field_compute_asts` are
## parallel vectors of the same length, in source order. Copied into the
## program's flat tables. `field_compute_asts[i]` holds the AST node id of
## the computed expression for field i, or 0 if the field is not computed.
def mir_register_binary_layout(prog: MirProgram, name: String, kind: Int, backing_width: Int, field_names: Vec<String>, field_specs: Vec<String>, field_widths: Vec<Int>, field_compute_asts: Vec<Int>): Int
  var layout_id = prog.binary_layout_names.size
  prog.binary_layout_names.push(name)
  prog.binary_layout_kinds.push(kind)
  prog.binary_layout_backing.push(backing_width)
  var offset = prog.binary_field_names.size
  prog.binary_layout_field_offsets.push(offset)
  var n = field_names.size
  prog.binary_layout_field_counts.push(n)
  for fi in 0..n
    prog.binary_field_names.push(field_names[fi])
    prog.binary_field_specs.push(field_specs[fi])
    prog.binary_field_widths.push(field_widths[fi])
    prog.binary_field_compute_asts.push(field_compute_asts[fi])
  end
  # Phase 2 Track B defaults: layout has no union until the caller
  # populates one via mir_register_binary_union below.
  prog.binary_layout_union_disc_idx.push(-1)
  prog.binary_layout_union_arm_offset.push(0)
  prog.binary_layout_union_arm_count.push(0)
  return layout_id
end

## Phase 2 Track B — attach discriminated-union metadata to a layout.
## `disc_idx` is the discriminator's flat field index within the layout.
## `arm_tags` + `arm_field_names`/`arm_field_specs`/`arm_field_widths` with
## parallel `arm_field_start`/`arm_field_count` describe per-arm fields.
def mir_register_binary_union(prog: MirProgram, layout_id: Int, disc_idx: Int, arm_tags: Vec<Int>, arm_field_names: Vec<String>, arm_field_specs: Vec<String>, arm_field_widths: Vec<Int>, arm_field_start: Vec<Int>, arm_field_count: Vec<Int>): Void
  prog.binary_layout_union_disc_idx[layout_id] = disc_idx
  prog.binary_layout_union_arm_offset[layout_id] = prog.binary_union_arm_tags.size
  prog.binary_layout_union_arm_count[layout_id] = arm_tags.size
  var arm_field_base = prog.binary_union_field_names.size
  var na = arm_tags.size
  for ai in 0..na
    prog.binary_union_arm_tags.push(arm_tags[ai])
    prog.binary_union_arm_field_offsets.push(arm_field_base + arm_field_start[ai])
    prog.binary_union_arm_field_counts.push(arm_field_count[ai])
  end
  var naf = arm_field_names.size
  for afi in 0..naf
    prog.binary_union_field_names.push(arm_field_names[afi])
    prog.binary_union_field_specs.push(arm_field_specs[afi])
    prog.binary_union_field_widths.push(arm_field_widths[afi])
  end
end

## Phase 2 Track B accessors for codegen.
def mir_binary_layout_union_disc_idx(prog: MirProgram, layout_id: Int): Int = prog.binary_layout_union_disc_idx[layout_id]

def mir_binary_layout_union_arm_count(prog: MirProgram, layout_id: Int): Int = prog.binary_layout_union_arm_count[layout_id]

def mir_binary_union_arm_tag(prog: MirProgram, layout_id: Int, arm_idx: Int): Int
  var off = prog.binary_layout_union_arm_offset[layout_id]
  return prog.binary_union_arm_tags[off + arm_idx]
end

def mir_binary_union_arm_field_count(prog: MirProgram, layout_id: Int, arm_idx: Int): Int
  var off = prog.binary_layout_union_arm_offset[layout_id]
  return prog.binary_union_arm_field_counts[off + arm_idx]
end

def mir_binary_union_arm_field_name(prog: MirProgram, layout_id: Int, arm_idx: Int, field_idx: Int): String
  var off = prog.binary_layout_union_arm_offset[layout_id]
  var arm_off = prog.binary_union_arm_field_offsets[off + arm_idx]
  return prog.binary_union_field_names[arm_off + field_idx]
end

def mir_binary_union_arm_field_spec(prog: MirProgram, layout_id: Int, arm_idx: Int, field_idx: Int): String
  var off = prog.binary_layout_union_arm_offset[layout_id]
  var arm_off = prog.binary_union_arm_field_offsets[off + arm_idx]
  return prog.binary_union_field_specs[arm_off + field_idx]
end

def mir_binary_union_arm_field_width(prog: MirProgram, layout_id: Int, arm_idx: Int, field_idx: Int): Int
  var off = prog.binary_layout_union_arm_offset[layout_id]
  var arm_off = prog.binary_union_arm_field_offsets[off + arm_idx]
  return prog.binary_union_field_widths[arm_off + field_idx]
end

## Look up a layout_id by type name. Returns -1 if not registered.
def mir_find_binary_layout(prog: MirProgram, name: String): Int
  var n = prog.binary_layout_names.size
  for i in 0..n
    if prog.binary_layout_names[i] == name
      return i
    end
  end
  return -1
end

## Get the field count for a registered layout.
def mir_binary_layout_field_count(prog: MirProgram, layout_id: Int): Int
  return prog.binary_layout_field_counts[layout_id]
end

## Get a field name at (layout_id, field_index).
def mir_binary_layout_field_name(prog: MirProgram, layout_id: Int, field_index: Int): String
  var off = prog.binary_layout_field_offsets[layout_id]
  return prog.binary_field_names[off + field_index]
end

## Get a field type-spec at (layout_id, field_index).
def mir_binary_layout_field_spec(prog: MirProgram, layout_id: Int, field_index: Int): String
  var off = prog.binary_layout_field_offsets[layout_id]
  return prog.binary_field_specs[off + field_index]
end

## Get a field bit width at (layout_id, field_index). 0 = variable / unknown.
def mir_binary_layout_field_width(prog: MirProgram, layout_id: Int, field_index: Int): Int
  var off = prog.binary_layout_field_offsets[layout_id]
  return prog.binary_field_widths[off + field_index]
end

## Get the AST node id of the computed expression for a field, or 0 if the
## field is not computed. Phase 2 Track A.
def mir_binary_layout_field_compute_ast(prog: MirProgram, layout_id: Int, field_index: Int): Int
  var off = prog.binary_layout_field_offsets[layout_id]
  return prog.binary_field_compute_asts[off + field_index]
end

## Get the kind (1 = binary {}, 2 = packed struct) for a layout.
def mir_binary_layout_kind(prog: MirProgram, layout_id: Int): Int = prog.binary_layout_kinds[layout_id]

## Get the backing width for a packed struct layout (0 for binary blocks).
def mir_binary_layout_backing(prog: MirProgram, layout_id: Int): Int = prog.binary_layout_backing[layout_id]

## Get the layout name.
def mir_binary_layout_name(prog: MirProgram, layout_id: Int): String = prog.binary_layout_names[layout_id]

## Get the total number of registered binary/packed layouts.
def mir_binary_layout_count(prog: MirProgram): Int = prog.binary_layout_names.size

## Get program functions.
def mir_get_functions(prog: MirProgram): Vec<MirFunc> = prog.functions

## Find a function by name; returns Some(MirFunc) or None if absent.
def mir_prog_find_function(prog: MirProgram, name: String): Option<MirFunc>
  var funcs = prog.functions
  var count = funcs.size
  for i in 0..count
    var f = funcs[i]
    if mir_func_get_name(f).eq(name)
      return Option::Some(f)
    end
  end
  return Option::None
end

## Whether the program declares any @value struct. Cheap short-circuit for the
## byval-return escape tracking: programs with no @value structs (e.g. the
## compiler's own sources) skip the per-call callee resolution entirely, so
## their escape analysis — and thus self-compile IR — is byte-unchanged.
## 1 iff the program contains any value-layout struct — @value (always) OR, at the
## F4 gate, an eligible plain struct. This gates the byval-return / escape-promote /
## tail-veto / fn_entry-hoist machinery (codegen.qz:1415, mir_compute_escaped_regs,
## mir_compute_reg_origins) — all of which a FLIPPED plain struct must participate in
## (landmines #2 tail-veto, #3 alloca-hoist). Without the F4 widening, a program with
## ONLY plain structs reports 0 at gate=1 and its byval reconstruct alloca is never
## hoisted to fn_entry (SSA-dominance break) and escaping byval returns are never
## heap-promoted. INERT at gate 0: the plain-struct scan short-circuits on
## mir_default_struct_value_live()==0 ⇒ only @value triggers ⇒ byte-identical.
def mir_prog_has_value_struct(prog: MirProgram): Int
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.is_value == 1
      return 1
    end
  end
  if mir_default_struct_value_live() == 1
    for i2 in 0..count
      var entry2 = defs[i2]
      if mir_prog_struct_value_eligible(prog, entry2.name) == 1
        return 1
      end
    end
  end
  return 0
end

## Check if program uses task groups.
def mir_get_uses_task_group(prog: MirProgram): Int = prog.uses_task_group

## Set task group usage flag.
def mir_set_uses_task_group(prog: MirProgram): Void
  prog.uses_task_group = 1
end

## Check if program uses the M:N scheduler.
def mir_get_uses_scheduler(prog: MirProgram): Int = prog.uses_scheduler

def mir_get_uses_intern(prog: MirProgram): Int = prog.uses_intern

def mir_set_uses_intern(prog: MirProgram): Void
  prog.uses_intern = 1
end

## A.3 (Pass 1): does this program reference any `cache_op_*` effect op?
## Set when MIR lowering encounters a perform-op whose effect name is `Cache`.
## Codegen gates the std/cache default-handler install on this flag so
## programs that never import std/cache don't force-link build_cache.
def mir_get_uses_cache(prog: MirProgram): Int = prog.uses_cache

def mir_set_uses_cache(prog: MirProgram): Void
  prog.uses_cache = 1
end

## A.6 (Pass 1): does this program reference any `prof_*` effect op?
## Set when MIR lowering encounters a perform-op whose effect name is `Profile`.
## Codegen gates the std/profile default-handler install on this flag so
## programs that never import std/profile don't force-link it.
def mir_get_uses_profile(prog: MirProgram): Int = prog.uses_profile

def mir_set_uses_profile(prog: MirProgram): Void
  prog.uses_profile = 1
end

## 4.B.7.b (item 9): does this program perform/handle the Yield effect?
## Set when MIR lowering emits any Yield perform-op (generator `yield` /
## `can Yield` helper / Stream consumer kind=3 suspend) — see
## mir_emit_perform_op chokepoint + the qzmod recover walk. Codegen gates
## the Yield default-handler install (`@__qz_gen_yield_capture`, a Quartz
## function in std/gen.qz) on this flag so programs that never use
## generators don't force-link std/gen / reference a symbol that would
## dangle if the prelude-pull fails to materialize it. Mirrors the
## Intern/Cache/Profile gating exactly.
def mir_get_uses_yield(prog: MirProgram): Int = prog.uses_yield

def mir_set_uses_yield(prog: MirProgram): Void
  prog.uses_yield = 1
end

## item 5e (item 13): clear the Yield flag after DCE recomputes it against the
## reachable set. mir_set_uses_yield fires for every Yield perform/handle-install
## at MIR-lower time, including ones inside std/gen functions the prelude pulls
## but the program never reaches — a false positive that keeps the
## @__qz_gen_yield_capture default handler emitted as dead code. codegen
## (cg_compute_reachable) re-derives true liveness from the reachable set and
## calls this to drop the flag when no reachable function performs Yield.
def mir_clear_uses_yield(prog: MirProgram): Void
  prog.uses_yield = 0
end

## B.7 Phase 4d: does this program use `scope_register_deadline`?
## Set when MIR lowering / codegen encounters the intrinsic; codegen gates
## the `__qz_scope_deadline_thread` runtime function on this flag so
## programs that never import std/sync/composition/scope don't reference its
## deadline-fire helper.
def mir_get_uses_scope_deadline(prog: MirProgram): Int = prog.uses_scope_deadline

def mir_set_uses_scope_deadline(prog: MirProgram): Void
  prog.uses_scope_deadline = 1
end

## Set scheduler usage flag.
def mir_set_uses_scheduler(prog: MirProgram): Void
  prog.uses_scheduler = 1
end

## A.17 — true iff this intrinsic name's codegen emits a `__qz_waiter_*`
## runtime call (`__qz_waiter_notify_all` / `__qz_waiter_register` /
## `__qz_waiter_unregister` / `__qz_waiter_hash`). Those runtime functions
## are only *defined* under the `uses_scheduler` gate in
## codegen_runtime.qz, so any program touching one of these intrinsics
## must set `uses_scheduler` even when it has no `go`/`async`. Emitters:
## channel intrinsics (`send`/`recv`/`recv_timeout`/`channel_close`/
## `try_send`/`try_recv`/`try_recv_or_closed`/`try_send_pressure` —
## cf. cg_intrinsic_conc_channel{,_try}.qz), `mutex_unlock`
## (cg_intrinsic_conc_sched.qz), and `waiter_register`/`waiter_unregister`
## (the C.13 select-lowering side-table intrinsics). `channel_new`,
## `channel_new_unbounded` and `mutex_lock` are included for consistency
## (a channel/mutex created here is recv/unlocked elsewhere) and are
## harmless when the flag is already implied.
def mir_intrinsic_uses_waiter_runtime(name: String): Bool
  if name == "channel_new" or name == "channel_new_unbounded"
    return true
  end
  if name == "send" or name == "recv" or name == "recv_timeout" or name == "channel_close"
    return true
  end
  if name == "try_send" or name == "try_recv" or name == "try_recv_or_closed" or name == "try_send_pressure"
    return true
  end
  if name == "mutex_lock" or name == "mutex_unlock"
    return true
  end
  if name == "waiter_register" or name == "waiter_unregister"
    return true
  end
  return false
end

## Get string pool.
def mir_get_string_pool(prog: MirProgram): Vec<String> = prog.string_pool

## Get struct definitions.
def mir_get_struct_defs(prog: MirProgram): Vec<MirStructDef> = prog.struct_defs

## Set struct definitions.
def mir_set_struct_defs(prog: MirProgram, defs: Vec<MirStructDef>): Void
  prog.struct_defs = defs
end

## Compute the reg_origin table for a function: for each register, which
## MIR_ALLOC_STACK (if any) it derives from.
##
## Returns Vec<Int> indexed by register ID, where entry = alloc_stack_dest + 1
## if that register is (transitively) derived from a stack alloca, 0 otherwise.
## The +1 offset distinguishes reg 0 from the "no origin" sentinel.
##
## Used by codegen to veto LLVM `tail call` emission when any call argument
## is (or derives from) a caller-local stack alloca pointer. LLVM's tail marker
## asserts that no arguments alias caller allocas — violating that is UB and
## caused the Apr 12, 2026 class of miscompiled Result.unwrap / never-type bugs.
def mir_compute_reg_origins(func: MirFunc, prog: MirProgram): Vec<Int>
  var max_reg = func.value_counter
  if max_reg == 0
    return vec_new<Int>()
  end

  var reg_origin = vec_new_filled<Int>(max_reg, 0)
  var var_names = vec_new<String>()
  var var_origins = vec_new<Int>()

  # B.10 P2.1: a by-value-return call's dest holds a pointer to a caller-frame
  # reconstruct alloca — a stack origin, exactly like MIR_ALLOC_STACK. Tracking
  # it here extends the tail-call UB veto (§7.2) to those buffers. Gated on the
  # program actually having @value structs so the compiler's own build is unaffected.
  var has_vstruct = mir_prog_has_value_struct(prog)

  # item 44 — the 3rd caller-frame stack-pointer source. A decomposed @value-struct
  # param (passed as register fields %pI.fN) is reconstructed in codegen into a
  # caller-frame stack box (codegen.qz:1199 `%pI.struct = alloca`), whose pointer is
  # stored into the param var. That box is NOT a MIR instruction, so the ALLOC_STACK /
  # byval-return seeding above never sees it. Seed each such param's var name as a
  # stack origin here so the LOAD_VAR propagation below taints the loaded box ptr and
  # the tail-call-UB veto (codegen_instr.qz:~835) fires — otherwise a `tail call`
  # passing that box to a default trait method frees the box before the callee reads
  # it. Mirrors codegen's reconstruct gate exactly: should_decompose && per-param
  # decomposed. Gated on has_vstruct so the compiler's own build (0 @value structs)
  # is completely inert (gate-0 byte-identical).
  if has_vstruct == 1 and mir_func_should_decompose_value_params(func, prog) == 1
    var pcount = func.params.size
    for pi in 0..pcount
      if mir_func_param_is_decomposed(func, prog, pi) == 1
        var pname = func.params[pi]
        var palready = 0
        for pvi in 0..var_names.size
          if var_names[pvi].eq(pname)
            palready = 1
          end
        end
        if palready == 0
          var_names.push(pname)
          # Any positive value marks a stack origin; this function only tests
          # `origin > 0` and stores it verbatim (never indexes by origin-1).
          var_origins.push(max_reg + 1 + pi)
        end
      end
    end
  end

  var blocks = mir_func_get_blocks(func)
  var block_count = blocks.size
  for bi in 0..block_count
    var block = blocks[bi]
    var instrs = mir_block_get_instructions(block)
    var instr_count = instrs.size
    for ii in 0..instr_count
      var instr = instrs[ii]
      var kind = mir_instr_get_kind(instr)
      var dest = mir_instr_get_dest_id(instr)

      if kind == MIR_ALLOC_STACK
        if dest >= 0 and dest < max_reg
          reg_origin[dest] = dest + 1
        end
      end

      if kind == MIR_CALL and has_vstruct == 1
        if dest >= 0 and dest < max_reg
          var callee_opt = mir_prog_find_function(prog, mir_instr_get_func_name(instr))
          if callee_opt.is_some()
            if mir_func_returns_byval_struct(callee_opt.unwrap(), prog) == 1
              reg_origin[dest] = dest + 1
            end
          end
        end
      end

      if kind == MIR_STORE_VAR
        var val_reg = mir_instr_get_operand2(instr)
        if val_reg >= 0 and val_reg < max_reg
          var origin = reg_origin[val_reg]
          if origin > 0
            var is_global = mir_instr_get_slot1(instr)
            if is_global == 0
              var vname = mir_instr_get_var_name(instr)
              var found = 0
              for vi in 0..var_names.size
                if var_names[vi].eq(vname)
                  var_origins[vi] = origin
                  found = 1
                end
              end
              if found == 0
                var_names.push(vname)
                var_origins.push(origin)
              end
            end
          end
        end
      end

      if kind == MIR_LOAD_VAR
        var vname = mir_instr_get_var_name(instr)
        for vi in 0..var_names.size
          if var_names[vi].eq(vname)
            if dest >= 0 and dest < max_reg
              reg_origin[dest] = var_origins[vi]
            end
          end
        end
      end
    end
  end

  return reg_origin
end

## Compute which MIR_ALLOC_STACK registers escape their defining scope.
## Returns Vec<Int> indexed by register ID: 0=local, 1=escapes.
## Escape triggers: TERM_RETURN, MIR_STORE to non-stack pointer, global store.
def mir_compute_escaped_regs(func: MirFunc, suppress_return_escape: Int, prog: MirProgram): Vec<Int>
  var max_reg = func.value_counter
  if max_reg == 0
    return vec_new()
  end

  # reg_origin[r] = alloc_stack dest + 1 if register r derives from an alloc_stack.
  # 0 means no alloc_stack origin. +1 offset distinguishes reg 0 from sentinel.
  var reg_origin = vec_new_filled<Int>(max_reg, 0)

  # Variable-to-origin tracking (parallel arrays)
  var var_names = vec_new<String>()
  var var_origins = vec_new()

  # Result bitmap: escaped[r] = 1 means MIR_ALLOC_STACK at register r escapes
  var escaped = vec_new_filled<Int>(max_reg, 0)

  # B.10 P2.1: by-value-return call dests are stack origins (pointer into the
  # caller-frame reconstruct alloca). Treating them like MIR_ALLOC_STACK lets
  # the existing store-to-heap / global / return propagation heap-promote the
  # reconstruct when it escapes. Gated on @value presence (no-op for the compiler).
  var has_vstruct = mir_prog_has_value_struct(prog)

  var blocks = mir_func_get_blocks(func)
  var block_count = blocks.size
  for bi in 0..block_count
    var block = blocks[bi]
    var instrs = mir_block_get_instructions(block)
    var instr_count = instrs.size
    for ii in 0..instr_count
      var instr = instrs[ii]
      var kind = mir_instr_get_kind(instr)
      var dest = mir_instr_get_dest_id(instr)

      # Track MIR_ALLOC_STACK destinations
      if kind == MIR_ALLOC_STACK
        if dest >= 0 and dest < max_reg
          reg_origin[dest] = dest + 1
        end
      end

      # Track by-value-return call dests as stack origins (see note above).
      if kind == MIR_CALL and has_vstruct == 1
        if dest >= 0 and dest < max_reg
          var bvc_opt = mir_prog_find_function(prog, mir_instr_get_func_name(instr))
          if bvc_opt.is_some()
            if mir_func_returns_byval_struct(bvc_opt.unwrap(), prog) == 1
              reg_origin[dest] = dest + 1
            end
          end
        end
      end

      # MIR_STORE_VAR: propagate origin through variable bindings
      if kind == MIR_STORE_VAR
        var val_reg = mir_instr_get_operand2(instr)
        if val_reg >= 0 and val_reg < max_reg
          var origin = reg_origin[val_reg]
          if origin > 0
            var is_global = mir_instr_get_slot1(instr)
            if is_global == 1
              # Store to global → escape
              escaped[origin - 1] = 1
            else
              var vname = mir_instr_get_var_name(instr)
              var found = 0
              for vi in 0..var_names.size
                if var_names[vi].eq(vname)
                  # Multi-origin: if variable had a different alloc_stack origin,
                  # mark the old origin as escaped (match arms write different allocas
                  # to the same result variable — all may be returned).
                  var prev_origin = var_origins[vi]
                  if prev_origin > 0 and prev_origin != origin
                    escaped[prev_origin - 1] = 1
                  end
                  var_origins[vi] = origin
                  found = 1
                end
              end
              if found == 0
                var_names.push(vname)
                var_origins.push(origin)
              end
            end
          end
        end
      end

      # MIR_LOAD_VAR: propagate origin from variable to register
      if kind == MIR_LOAD_VAR
        var vname = mir_instr_get_var_name(instr)
        for vi in 0..var_names.size
          if var_names[vi].eq(vname)
            if dest >= 0 and dest < max_reg
              reg_origin[dest] = var_origins[vi]
            end
          end
        end
      end

      # MIR_STORE: if value has alloc_stack origin but target does not → escape
      # Catches: store into heap struct field, closure env capture
      if kind == MIR_STORE
        var ptr_reg = mir_instr_get_operand1(instr)
        var val_reg = mir_instr_get_operand2(instr)
        if val_reg >= 0 and val_reg < max_reg and ptr_reg >= 0 and ptr_reg < max_reg
          var val_origin = reg_origin[val_reg]
          if val_origin > 0
            var ptr_origin = reg_origin[ptr_reg]
            if ptr_origin == 0
              escaped[val_origin - 1] = 1
            end
          end
        end
      end
    end

    # Check block terminator for return escape
    var term_kind = mir_block_get_term_kind(block)
    if term_kind == TERM_RETURN and suppress_return_escape == 0
      var ret_reg = mir_block_get_term_data(block)
      if ret_reg >= 0 and ret_reg < max_reg
        var origin = reg_origin[ret_reg]
        if origin > 0
          escaped[origin - 1] = 1
        end
      end
    end
  end

  # Second pass: re-resolve LOAD_VAR origins and TERM_RETURN after all variable
  # origins are complete. Needed because match_end blocks may be ordered before
  # arm blocks — the first pass sees LOAD_VAR before the variable's origin is set.
  for bi2 in 0..block_count
    var block2 = blocks[bi2]
    var instrs2 = mir_block_get_instructions(block2)
    for ii2 in 0..instrs2.size
      var instr2 = instrs2[ii2]
      if mir_instr_get_kind(instr2) == MIR_LOAD_VAR
        var dest2 = mir_instr_get_dest_id(instr2)
        var vname2 = mir_instr_get_var_name(instr2)
        for vi2 in 0..var_names.size
          if var_names[vi2].eq(vname2)
            if dest2 >= 0 and dest2 < max_reg
              reg_origin[dest2] = var_origins[vi2]
            end
          end
        end
      end
    end
    var term_kind2 = mir_block_get_term_kind(block2)
    if term_kind2 == TERM_RETURN and suppress_return_escape == 0
      var ret_reg2 = mir_block_get_term_data(block2)
      if ret_reg2 >= 0 and ret_reg2 < max_reg
        var origin2 = reg_origin[ret_reg2]
        if origin2 > 0
          escaped[origin2 - 1] = 1
        end
      end
    end
  end

  # Transitive propagation: if alloc_stack A escapes and alloc_stack B
  # was stored as a field of A, then B also escapes.
  var changed = 1
  while changed == 1
    changed = 0
    for bi in 0..block_count
      var block = blocks[bi]
      var instrs = mir_block_get_instructions(block)
      var instr_count = instrs.size
      for ii in 0..instr_count
        var instr = instrs[ii]
        if mir_instr_get_kind(instr) == MIR_STORE
          var ptr_reg = mir_instr_get_operand1(instr)
          var val_reg = mir_instr_get_operand2(instr)
          if val_reg >= 0 and val_reg < max_reg and ptr_reg >= 0 and ptr_reg < max_reg
            var val_origin = reg_origin[val_reg]
            var ptr_origin = reg_origin[ptr_reg]
            if val_origin > 0 and ptr_origin > 0
              if escaped[ptr_origin - 1] == 1 and escaped[val_origin - 1] == 0
                escaped[val_origin - 1] = 1
                changed = 1
              end
            end
          end
        end
      end
    end
  end

  return escaped
end

## Check if an @value struct param should be decomposed into registers.
## Returns 1 if: @value, 1-3 fields, no narrow fields, no generic '<' in type name.
def mir_param_is_decomposable(prog: MirProgram, type_name: String): Int
  if str_byte_len(type_name) == 0
    return 0
  end
  # Skip generic types
  if str_contains(type_name, "<")
    return 0
  end
  # B.10 §14.12.8 (C3.5/h1) — a cow-layout @value struct is a HEAP refcount buffer
  # (refcount@0, payload@1..N), passed by its buffer POINTER (1 arg), with field
  # access routed +1 by C3's cow_field_shift. Register decomposition reads FLAT
  # offsets 0..N-1 of an aggregate, which clobbers the +1 layout ⇒ garbage
  # (register_passing_spec 3-field). Exclude cow structs from decomposition so they
  # pass as a single buffer pointer — uniform with C3's return-as-move model. INERT
  # at gate 0 (predicate false ⇒ unchanged ⇒ byte-identical).
  if mir_prog_struct_is_cow_layout(prog, type_name) == 1
    return 0
  end
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    var name = entry.name
    if name == type_name
      # Must be value-layout: @value (always) OR — at the F4 gate — an eligible
      # plain struct (F4-ret param decompose; the cow >16B case was excluded above,
      # so only a ≤16B flat plain struct reaches the 1-3-field decompose path).
      # mir_prog_is_value_layout_type's plain disjunct short-circuits on the gate ⇒
      # byte-identical at gate 0.
      if mir_prog_is_value_layout_type(prog, type_name) == 0
        return 0
      end
      # Must have 1-3 fields
      var field_names = entry.field_names
      var field_count = vec_size(field_names)
      if field_count < 1 or field_count > 3
        return 0
      end
      # No narrow fields
      var field_types = entry.field_types
      for fi in 0..field_count
        var ft = as_string(field_types[fi])
        if mir_is_narrow_fixed_width(ft)
          return 0
        end
      end
      return 1
    end
  end
  return 0
end

## item 47 — prog-side twin of `mir_resolve_struct_name`. A struct defined in an
## IMPORTED module registers in `prog.struct_defs` under its MODULE-QUALIFIED key
## (`hmodv$HH`), but a `vec_new<HH>()` element type / construct site names it by the
## BARE `HH`. The ctx-side value-layout predicate (`mir_is_value_layout_type`)
## resolves the name via `mir_resolve_struct_name`'s suffix match FIRST, so it sees
## value-layout; the prog-side twins (`mir_prog_is_value_layout_type` /
## `mir_prog_get_value_layout_field_count`, consumed by `cg_vec_inline_field_count`)
## did a RAW `entry.name == name` compare → missed the qualified key → returned 0 →
## ew=8 → the boxed pointer-push branch (every element aliases the one hoisted
## construct alloca ⇒ all read back as the last value). This resolver closes that
## split: exact match wins (in-module / already-qualified ⇒ byte-identical), else a
## `$<name>` suffix match resolves the bare name to the qualified key — mirroring
## `mir_resolve_struct_name` exactly. Returns the input unchanged when nothing
## matches (universal path ⇒ no behavior change for any resolvable-directly name).
def mir_prog_resolve_struct_name(prog: MirProgram, name: String): String
  return name if str_byte_len(name) == 0
  var defs = prog.struct_defs
  var count = defs.size
  var suffix = "$#{name}"
  var suffix_len = str_byte_len(suffix)
  for i in 0..count
    var key = defs[i].name
    return key if key == name
    var key_len = str_byte_len(key)
    if key_len >= suffix_len
      var end_part = str_byte_slice(key, key_len - suffix_len, key_len)
      return key if end_part == suffix
    end
  end
  return name
end

## Get struct field count from program struct_defs.
def mir_prog_get_struct_field_count(prog: MirProgram, struct_name: String): Int
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    var name = entry.name
    if name == struct_name
      var field_names = entry.field_names
      return vec_size(field_names)
    end
  end
  return 0
end

## Field-type name at `idx` in a struct (prog-side mirror of mir_ctx_get_field_type).
## Returns "" if the struct or index is unknown. Used by the byval return ABI to
## decide per-field narrow-vs-wide handling at codegen time (no MirContext there).
def mir_prog_get_struct_field_type(prog: MirProgram, struct_name: String, idx: Int): String
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == struct_name
      var field_types = entry.field_types
      return "" if idx < 0
      return "" if idx >= vec_size(field_types)
      return as_string(field_types[idx])
    end
  end
  return ""
end

## 1 if a struct uses the typed `%struct.Name` field layout — i.e. it is @repr(C)
## or has any narrow (sub-i64) integer field. Prog-side mirror of
## mir_struct_has_narrow_fields. When true, narrow fields shift the byte offsets
## of later fields, so the byval return/reconstruct paths must address every
## field through typed GEP rather than a flat i64-array index.
def mir_prog_struct_has_narrow_fields(prog: MirProgram, struct_name: String): Int
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == struct_name
      return 1 if entry.repr_c == 1
      var field_types = entry.field_types
      for j in 0..vec_size(field_types)
        if mir_is_narrow_fixed_width(as_string(field_types[j]))
          return 1
        end
      end
      return 0
    end
  end
  return 0
end

## F4-ret — prog-side twin of mir_struct_is_recursive (the ctx-side F4a exclusion).
## 1 iff `name` reaches itself through a chain of struct-typed fields (direct
## self-field, or a mutual A→B→A cycle). A recursive struct cannot be laid out
## inline (unbounded size) ⇒ stays Boxed ⇒ NOT value-layout-eligible. Bounded BFS
## over `prog.struct_defs`, visited-list capped at the def count. Field type names
## are matched directly against entry names (the prog-side functions work on
## already-concrete return/param type names — same direct-match convention as the
## existing prog-side byval/decompose predicates, no ctx resolve available here).
## Non-struct field types (scalars / String / Vec/Map handles / generics) never
## match a def name and are skipped as non-recursive edges. INERT at gate 0 (only
## consulted from the F4-gated eligibility predicate).
def mir_prog_struct_is_recursive(prog: MirProgram, name: String): Int
  return 0 if str_byte_len(name) == 0
  var defs = prog.struct_defs
  var count = defs.size
  var worklist = vec_new<String>()
  var visited = vec_new<String>()
  worklist.push(name)
  var guard = 0
  while vec_size(worklist) > 0 and guard <= count
    guard = guard + 1
    var cur = as_string(worklist[vec_size(worklist) - 1])
    worklist = mir_vec_string_pop(worklist)
    var seen = 0
    for vi in 0..vec_size(visited)
      seen = 1 if as_string(visited[vi]) == cur
    end
    if seen == 0
      visited.push(cur)
      for di in 0..count
        var dentry = defs[di]
        if dentry.name == cur
          var fts = dentry.field_types
          for fi in 0..vec_size(fts)
            var ft = as_string(fts[fi])
            if mir_is_scalar_field_type(ft) == 0
              # Direct/transitive hit on the origin ⇒ recursive.
              return 1 if ft == name
              worklist.push(ft)
            end
          end
        end
      end
    end
  end
  return 0
end

## F4-ret — prog-side twin of mir_struct_fields_mixed_firewall (the ctx-side F4a
## GC-firewall exclusion). 1 iff `name`'s fields mix raw-bit scalar slots with
## tracked-pointer slots (a future GC cannot scan the inline block uniformly) ⇒
## the struct stays Boxed and is NOT value-layout-eligible. Same classifier
## (mir_is_scalar_field_type) the ctx-side path uses. INERT at gate 0.
def mir_prog_struct_fields_mixed_firewall(prog: MirProgram, name: String): Int
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == name
      var field_types = entry.field_types
      var has_scalar = 0
      var has_pointer = 0
      for j in 0..vec_size(field_types)
        if mir_is_scalar_field_type(as_string(field_types[j])) == 1
          has_scalar = 1
        else
          has_pointer = 1
        end
      end
      return 1 if has_scalar == 1 and has_pointer == 1
      return 0
    end
  end
  return 0
end

## F4-ret — prog-side twin of mir_default_struct_value_eligible (the ctx-side F4a
## predicate). 1 iff `name` is a PLAIN (non-@value) struct that the F4 flip makes
## value-layout-eligible: non-@value, non-@repr(C), non-recursive, non-firewall-
## mixed. The return-ABI predicates (which carry `prog`/`MirFunc`, not a
## MirContext) consult THIS so a flipped plain struct gets the SAME return/decompose
## ABI an @value struct gets — keyed off the same eligibility shape as the ctx-side
## construct/copy path so the two ends cannot disagree (the f4-steps §4
## construct/read oracle-agreement rule). INERT at gate 0: short-circuits on
## mir_default_struct_value_live()==0 BEFORE touching the registry ⇒ byte-identical.
def mir_prog_struct_value_eligible(prog: MirProgram, name: String): Int
  return 0 if mir_default_struct_value_live() == 0
  return 0 if str_byte_len(name) == 0
  return 0 if str_contains(name, "<")
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == name
      return 0 if entry.is_value == 1
      return 0 if entry.repr_c == 1
      # item 35 — binary-DSL structs need a fixed boxed layout (encode/decode read
      # fields through a boxed pointer); never flip them to value-layout.
      return 0 if mir_find_binary_layout(prog, name) >= 0
      return 0 if mir_prog_struct_is_recursive(prog, name) == 1
      return 0 if mir_prog_struct_fields_mixed_firewall(prog, name) == 1
      return 1
    end
  end
  return 0
end

## F4-ret — prog-side twin of mir_is_value_layout_type. 1 iff `name` is value-
## layout on the prog side: an @value struct (unconditional) OR an eligible plain
## struct when the F4 gate is live. The return-ABI predicates route through this so
## a flipped plain struct inherits the @value byval/decompose/cow handling.
## INERT at gate 0 (the plain-struct disjunct short-circuits on the gate).
def mir_prog_is_value_layout_type(prog: MirProgram, name: String): Int
  return 0 if str_byte_len(name) == 0
  return 0 if str_contains(name, "<")
  # item 35 — a binary-DSL struct needs a FIXED boxed layout ALWAYS (the
  # encode/decode emitters read fields through a boxed pointer). DSL wins over
  # @value; check FIRST so it overrides the unconditional @value disjunct below.
  return 0 if mir_find_binary_layout(prog, name) >= 0
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == name
      return 1 if entry.is_value == 1
    end
  end
  return mir_prog_struct_value_eligible(prog, name)
end

## F4-PRE-1 — VALUE-LAYOUT field count for the Vec inline-storage gate. Returns the
## raw field count of `name` iff it is value-layout (`mir_prog_is_value_layout_type`:
## @value unconditionally, OR — at the F4 gate — an eligible plain struct), else 0.
## This is the SINGLE-SOURCE widening of the old `mir_prog_get_value_field_count`
## (which was `is_value`-only) used by `cg_vec_inline_field_count` /
## `cg_idx_inline_field_count`: a flipped plain struct must get fc == field_count so
## the Vec packs its elements into DISTINCT backing slots (per-push memcpy) and the
## `[]` read addresses them at the SAME N-word stride, instead of storing one i64
## pointer to the single construct alloca codegen hoists to fn-entry (every element
## would alias the last value — the gate-1 push-8-sum-56-reads-112 miscompile).
## Routes the layout verdict through the ONE F4 key so the construct/storage/read ends
## cannot disagree. INERT at gate 0: for a plain struct mir_prog_is_value_layout_type's
## plain disjunct short-circuits on mir_default_struct_value_live()==0 ⇒ returns 0 ⇒
## byte-identical; for an @value struct it returns the same count the old predicate did.
def mir_prog_get_value_layout_field_count(prog: MirProgram, name: String): Int
  return 0 if str_byte_len(name) == 0
  return 0 if str_contains(name, "<")
  return 0 if mir_prog_is_value_layout_type(prog, name) == 0
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == name
      return vec_size(entry.field_names)
    end
  end
  return 0
end

## F4-PRE-1 — VALUE-LAYOUT firewall-safe gate for the Vec/index inline-storage paths.
## 1 iff `name` is value-layout AND NOT GC-firewall-mixed (no raw-scalar + tracked-
## pointer mix). Widening of the old `mir_prog_struct_is_firewall_safe` (which required
## is_value==1 ⇒ 0 for every plain struct). An F4-eligible plain struct is non-
## firewall-mixed BY CONSTRUCTION (mir_prog_struct_value_eligible excludes the mixed
## case via mir_prog_struct_fields_mixed_firewall), so it is firewall-safe here too —
## but we re-derive it from the same classifier so the @value and plain paths share one
## verdict. INERT at gate 0 (plain structs are not value-layout ⇒ falls to
## mir_prog_struct_is_firewall_safe's identical @value behavior, incl. the all-pointer
## homogeneous case).
def mir_prog_struct_value_firewall_safe(prog: MirProgram, name: String): Int
  return 0 if str_byte_len(name) == 0
  return 0 if str_contains(name, "<")
  return 0 if mir_prog_is_value_layout_type(prog, name) == 0
  # @value structs keep the EXACT legacy verdict (byte-identical).
  return mir_prog_struct_is_firewall_safe(prog, name) if mir_prog_struct_value_eligible(prog, name) == 0
  # F4-eligible plain struct: firewall-safe iff not scalar+pointer mixed.
  return 0 if mir_prog_struct_fields_mixed_firewall(prog, name) == 1
  return 1
end

## B.10 §14.12.8 (C3) — prog-level twin of mir_value_is_cow_layout for the return
## ABI predicates (which carry `prog`/`MirFunc`, not a MirContext). 1 iff `name`
## is a cow-layout value struct: cow gate live + value-layout (@value OR — at the
## F4 gate — an eligible plain struct) + >16B (fc > 2) + NOT narrow + FLAT (no
## nested value-layout field). A cow struct is a HEAP refcount buffer (refcount@0,
## payload@1..N); it must NOT ride the byval/stack-alloca aggregate return paths
## (those read FLAT offsets 0..N-1, clobbering the +1 layout — the
## value_struct_gc_firewall all-scalar byval failure). Returning the buffer
## POINTER (boxed return) instead preserves the layout AND is the cow return-move.
## INERT at gate 0 (mir_value_cow_live == 0 ⇒ always 0 ⇒ byte-identical); the
## plain-struct widening is additionally behind the F4 gate (mir_prog_is_value_
## layout_type's plain disjunct short-circuits on mir_default_struct_value_live).
def mir_prog_struct_is_cow_layout(prog: MirProgram, name: String): Int
  return 0 if mir_value_cow_live() == 0
  return 0 if str_byte_len(name) == 0
  return 0 if str_contains(name, "<")
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == name
      return 0 if mir_prog_is_value_layout_type(prog, name) == 0
      var field_types = entry.field_types
      var fc = vec_size(field_types)
      return 0 if fc <= 2
      return 0 if mir_prog_struct_has_narrow_fields(prog, name) == 1
      # Flatness: no nested value-layout field (the C2/C3 safety rail). Unsafe iff
      # the nested field is ITSELF value-layout (@value OR — at the F4 gate — an
      # eligible plain struct): a shallow COW share without a per-field retain is a
      # use-after-free. Mirror of the ctx-side mir_value_is_cow_layout flatness rail
      # (which routes nested fields through mir_is_value_layout_type) so the prog and
      # ctx sides classify the same struct identically.
      for j in 0..fc
        var ft = as_string(field_types[j])
        if mir_is_scalar_field_type(ft) == 0
          return 0 if mir_prog_is_value_layout_type(prog, ft) == 1
        end
      end
      return 1
    end
  end
  return 0
end

## F4-PRE-2 — CTX-side mirror of cg_vec_inline_field_count (cg_intrinsic_vec.qz).
## Returns the per-element inline field count (>1) for a struct stored INLINE in a
## Vec under the value-layout firewall gate (value-layout, fc>1, NOT cow, NOT
## scalar+pointer firewall-mixed), else 0. The codegen vec_get/index paths consult
## the prog-side twin (cg_vec_inline_field_count → mir_prog_*) to emit a by-ADDRESS
## element fetch (data + i*fc) for such elements; this CTX variant reads the LIVE
## `ctx.struct_registry` (which IS populated during statement lowering — unlike
## `prog.struct_defs`, copied in only at the END of lowering via
## mir_set_struct_defs), so it can decide BEFORE codegen whether an untyped
## `for x in vec` must be upgraded to a TYPED vec_get and route through that same
## by-address path (matching `vec[i]`) instead of the stride-1 single-word value-load
## (which loads only field 0 of a multi-word inline element → garbage → SIGSEGV on
## `.field`). Boxed/scalar elements (fc 0/-1) and cow (>16B) elements stay on their
## existing paths. INERT at gate 0 for plain structs (mir_is_value_layout_type's plain
## disjunct short-circuits on mir_default_struct_value_live()==0 ⇒ 0); only @value
## structs return >1, exactly as the codegen predicate does.
def mir_vec_inline_field_count(ctx: MirContext, name: String): Int
  return 0 if str_byte_len(name) == 0
  return 0 if mir_is_value_layout_type(ctx, name) == 0
  var fc = mir_ctx_struct_field_count(ctx, name)
  return 0 if fc < 1
  return 0 if mir_value_is_cow_layout(ctx, name) == 1
  return 0 if mir_struct_fields_mixed_firewall(ctx, name) == 1
  return fc
end

## Check if a function returns a @value struct and is eligible for stack allocation.
## Returns 1 if function returns @value struct, is not recursive, and not generic.
def mir_func_returns_value_struct(func: MirFunc, prog: MirProgram): Int
  var ret_type = mir_func_get_return_type_name(func)
  if str_byte_len(ret_type) == 0
    return 0
  end
  if str_contains(ret_type, "<")
    return 0
  end
  var fc = mir_prog_get_value_layout_field_count(prog, ret_type)
  if fc == 0
    return 0
  end
  # B.10 §14.12.8 (C3) — cow-layout structs return their buffer POINTER (boxed),
  # not a stack-alloca aggregate; exclude them from the value-struct stack-return
  # path so the +1 refcount-buffer layout survives the return (= cow move). INERT
  # at gate 0.
  if mir_prog_struct_is_cow_layout(prog, ret_type) == 1
    return 0
  end
  # Exclude self-recursive functions (LLVM cannot inline them)
  var fname = mir_func_get_name(func)
  var blocks = mir_func_get_blocks(func)
  for bi in 0..vec_size(blocks)
    var block = blocks[bi]
    var instrs = mir_block_get_instructions(block)
    for ii in 0..vec_size(instrs)
      var instr = instrs[ii]
      if mir_instr_get_kind(instr) == MIR_CALL
        if mir_instr_get_func_name(instr).eq(fname)
          return 0
        end
      end
    end
  end
  return 1
end

## Check if a function returns a @value struct eligible for the by-value
## (aggregate) return ABI: `ret {i64 x N}` instead of returning a heap-boxed
## pointer (B.10 P2.1, the memory lever — kills the per-return __qz_alloc).
##
## Eligible iff the return type is a @value struct with >=1 field, all fields
## non-narrow (8-byte i64 slots), the type is non-generic, and the function is
## not self-recursive. The field count is UNCAPPED: codegen emits the aggregate
## return type and LLVM's SysV classifier handles register-vs-sret lowering, so
## a 6-field BoundingBox returns just as cleanly as a 3-field Point3D.
##
## Narrow-integer fields (U8/I8/U16/I16/U32/I32) are SUPPORTED (B.10 narrow-byval
## fold-in): the return aggregate stays `{i64 x N}` (one widened slot per field),
## and the two ABI boundaries (callee return-load, caller reconstruct-store) copy
## narrow fields through the typed `%struct.Name` layout with zext/sext + trunc.
## Float fields keep the existing i64-bit copy (floats ride in integer registers
## today, §5) so no special-casing is needed for them here.
def mir_func_returns_byval_struct(func: MirFunc, prog: MirProgram): Int
  var ret_type = mir_func_get_return_type_name(func)
  if str_byte_len(ret_type) == 0
    return 0
  end
  if str_contains(ret_type, "<")
    return 0
  end
  # B.10 §14.12.8 (C3) — a cow-layout @value struct is a HEAP refcount buffer
  # (refcount@0, payload@1..N); the byval aggregate decomposition reads FLAT
  # offsets 0..N-1 and would clobber the +1 layout. Return the buffer POINTER
  # (boxed return) instead — preserves the layout and IS the cow return-move.
  # INERT at gate 0 (predicate false ⇒ unchanged).
  if mir_prog_struct_is_cow_layout(prog, ret_type) == 1
    return 0
  end
  var defs = prog.struct_defs
  var count = defs.size
  var found = 0
  for i in 0..count
    var entry = defs[i]
    var name = entry.name
    if name == ret_type
      # Must be value-layout: @value (always) OR — at the F4 gate — an eligible
      # plain struct (F4-ret de-box-on-return; mir_prog_is_value_layout_type's
      # plain disjunct short-circuits on the gate ⇒ byte-identical at gate 0). A
      # >16B plain struct is cow-layout and was already returned above as a buffer
      # pointer; only a ≤16B (or all-pointer flat) plain struct reaches here and
      # rides the SysV-classified {i64 x N} aggregate return ABI (no per-return box).
      if mir_prog_is_value_layout_type(prog, name) == 0
        return 0
      end
      var field_names = entry.field_names
      var fc = vec_size(field_names)
      if fc < 1
        return 0
      end
      # Narrow integer fields are handled by the typed-layout byval path
      # (see mir_prog_struct_has_narrow_fields + codegen TERM_RETURN/MIR_CALL).
      found = 1
      # B.10 P2.3 — GC firewall: a @value block mixing raw-bit scalar slots and
      # tracked-pointer slots is unsafe to ride the unboxed byval aggregate (a
      # future GC scanning the reconstructed block cannot tell pointers from
      # bits without a scan_map). Block it → conservative boxed (__qz_alloc)
      # return. Homogeneous structs stay eligible: all-scalar (current path) and
      # all-pointer (GC scans every slot as a pointer — fine).
      var field_types = entry.field_types
      var has_scalar = 0
      var has_pointer = 0
      for j in 0..vec_size(field_types)
        if mir_is_scalar_field_type(as_string(field_types[j])) == 1
          has_scalar = 1
        else
          has_pointer = 1
        end
      end
      if has_scalar == 1 and has_pointer == 1
        return 0
      end
    end
  end
  if found == 0
    return 0
  end
  # Exclude self-recursive functions: LLVM cannot inline them and the
  # aggregate-return path relies on the result struct's stack alloca staying
  # within the frame (§7.4 — a real sret path for these is deferred).
  var fname = mir_func_get_name(func)
  var blocks = mir_func_get_blocks(func)
  for bi in 0..vec_size(blocks)
    var block = blocks[bi]
    var instrs = mir_block_get_instructions(block)
    for ii in 0..vec_size(instrs)
      var instr = instrs[ii]
      if mir_instr_get_kind(instr) == MIR_CALL
        if mir_instr_get_func_name(instr).eq(fname)
          return 0
        end
      end
    end
  end
  return 1
end

## item 20 — the SINGLE "borrowed mutating value-self receiver" detection predicate
## (Phase 4 fold: this subsumes the former 14A `$next`-only receiver exclusion). A
## value-struct method that stores to `self.field` and gets its `self` register-
## DECOMPOSED into scalar fields mutates a callee-local copy rebuilt from the args →
## the write is lost on return (the iterator-advance / setter-write family). Returns
## 1 iff ALL of:
##   1. param 0 is value-layout (`mir_prog_is_value_layout_type` on param-0's type
##      name) — THE gate-0-inert guard: a plain reference-layout struct returns 0
##      here (the plain disjunct short-circuits on `mir_default_struct_value_live()
##      == 0`), so this predicate is 0 ⇒ byte-identical self-compile;
##   2. param 0 is named `self` (the method-receiver binding);
##   3. the body mutates `self` (cached `mutates_self_field`, computed in
##      `mir_lower_function` via `mir_body_assigns_self_field` — covers BOTH a direct
##      `self.field = …` store AND a transitive UFCS self-method call, item 20 v2).
## When 1, param 0 is excluded from decompose and passed as a single construct-buffer
## pointer (mutated in place).
##
## PHASE 4 — subsumes `$next`. `for x in <custom iterator>` desugars
## (lower_custom_iteration) to a `<Struct>$next(iter)` loop; `next` advances the
## cursor via `self.cursor = …` (direct store) or a self-method call → both set
## `mutates_self_field`, so a value-layout `$next` receiver that MUTATES self lights
## here and is excluded from decompose exactly as the old `$next` carve-out did. A
## value-layout `$next` receiver that does NOT mutate self (e.g. MapIter/FilterIter,
## whose advance lives in a captured closure, not a self field) has nothing to lose
## by decomposition, so folding is behavior-preserving. The dedicated
## `mir_func_param_is_next_receiver` predicate + its decompose OR-ins were DELETED
## (item 20 Phase 4) once this general path demonstrably subsumed the iterator case
## (`custom_iterator_spec.qz` `@value` CIValCounter for-in stays green).
def mir_func_param0_is_mut_value_receiver(func: MirFunc, prog: MirProgram): Int
  return 0 if func.params.size == 0
  return 0 if func.mutates_self_field == 0
  return 0 if func.params[0].eq("self") == 0
  var type_name = func.param_type_names[0]
  return mir_prog_is_value_layout_type(prog, type_name)
end

## Check if a function should have its @value struct params decomposed into registers.
## Returns 1 if function has decomposable params and total expanded count <= 8.
def mir_func_should_decompose_value_params(func: MirFunc, prog: MirProgram): Int
  var name = mir_func_get_name(func)
  if mir_func_is_naked(func)
    return 0
  end
  if name == "main"
    return 0
  end
  var param_count = func.params.size
  if param_count == 0
    return 0
  end
  var has_decomposable = 0
  var total_expanded = 0
  for i in 0..param_count
    var type_name = func.param_type_names[i]
    if mir_param_is_decomposable(prog, type_name) and (i != 0 or (mir_func_param0_is_mut_value_receiver(func, prog) == 0 and func.assoc_phantom_self == 0))
      has_decomposable = 1
      total_expanded += mir_prog_get_struct_field_count(prog, type_name)
    else
      total_expanded += 1
    end
  end
  if has_decomposable == 0
    return 0
  end
  if total_expanded > 8
    return 0
  end
  return 1
end

## Check if param at idx should be decomposed for register passing.
def mir_func_param_is_decomposed(func: MirFunc, prog: MirProgram, idx: Int): Int
  return 0 if idx == 0 and mir_func_param0_is_mut_value_receiver(func, prog) == 1
  # item 38 — param 0 of an associated (receiver-less) fn is a phantom `self`
  # passed garbage; decomposing it null-derefs. Keep it as a single i64 param.
  return 0 if idx == 0 and func.assoc_phantom_self == 1
  var type_name = func.param_type_names[idx]
  return mir_param_is_decomposable(prog, type_name)
end

## Get global variable names.
def mir_get_global_names(prog: MirProgram): Vec<String> = prog.global_names

## Get global variable initializers.
def mir_get_global_inits(prog: MirProgram): Vec<Int> = prog.global_inits

## Get global string initializers.
def mir_get_global_str_inits(prog: MirProgram): Vec<String> = prog.global_str_inits

## Get global thread-local storage.
def mir_get_global_thread_locals(prog: MirProgram): Vec<Int> = prog.global_thread_locals

## Get global-var alias names (parallel with mir_get_global_alias_targets).
def mir_get_global_alias_names(prog: MirProgram): Vec<String> = prog.global_alias_names

## Get global-var alias targets (parallel with mir_get_global_alias_names).
def mir_get_global_alias_targets(prog: MirProgram): Vec<String> = prog.global_alias_targets

## Get constant names.
def mir_get_const_names(prog: MirProgram): Vec<String> = prog.const_names

## Get constant values.
def mir_get_const_values(prog: MirProgram): Vec<Int> = prog.const_values


## Set global variables in the program
def mir_prog_set_globals(prog: MirProgram, names: Vec<String>, inits: Vec<Int>, str_inits: Vec<String>, tl_flags: Vec<Int>): Void
  var target_names = prog.global_names
  var target_inits = prog.global_inits
  var target_str_inits = prog.global_str_inits
  var target_tls = prog.global_thread_locals
  var count = names.size
  for i in 0..count
    target_names.push(names[i])
    target_inits.push(inits[i])
    target_str_inits.push(str_inits[i])
    target_tls.push(tl_flags[i])
  end
end

## Append a global-var alias (codegen emits LLVM alias for shared storage).
def mir_prog_add_global_alias(prog: MirProgram, alias_name: String, target_name: String): Void
  prog.global_alias_names.push(alias_name)
  prog.global_alias_targets.push(target_name)
end

def mir_add_string(prog: MirProgram, s: String): Int
  var pool = mir_get_string_pool(prog)
  idx = pool.size
  pool.push(s)
  return idx
end

# Create new MIR function
# PF3-P1 — deterministic per-compile monotonic id counters for MirFunc /
# MirBlock. Each compile runs as a fresh process, so these start at 0 and are
# assigned in deterministic allocation order (same source → same lowering
# order → identical ids), which keeps fixpoint (gen1 == gen2) intact. They are
# the stable membership keys for the cconv/@ct/switch side-tables, replacing
# `as_int(struct)` (which erases the COW value-struct pointer to an i64).
var _g_mir_func_id_counter = 0
var _g_mir_block_id_counter = 0

def mir_next_func_id(): Int
  var id = _g_mir_func_id_counter
  _g_mir_func_id_counter = _g_mir_func_id_counter + 1
  return id
end

def mir_next_block_id(): Int
  var id = _g_mir_block_id_counter
  _g_mir_block_id_counter = _g_mir_block_id_counter + 1
  return id
end

def mir_new_function(name: String, return_type: Int): MirFunc
  return MirFunc {
    name: name,
    origin_module: "",
    return_type: return_type,
    params: vec_new<String>(),
    param_types: vec_new(),
    param_type_names: vec_new<String>(),
    return_type_name: "",
    blocks: vec_new(),
    entry: 0,
    value_counter: 0,
    block_counter: 0,
    locals: vec_new<String>(),
    local_narrow_names: vec_new<String>(),
    local_narrow_types: vec_new<String>(),
    is_naked: 0,
    is_no_preempt: 0,
    is_weak: 0,
    is_export: 0,
    is_noinline: 0,
    line: 1,
    col: 1,
    id: mir_next_func_id(),
    mutates_self_field: 0,
    assoc_phantom_self: 0
  }
end

## item 20 P1 — getter/setter for the direct-self-field-mutation marker.
def mir_func_get_mutates_self_field(func: MirFunc): Int = func.mutates_self_field

def mir_func_set_mutates_self_field(func: MirFunc, v: Int): Void
  func.mutates_self_field = v
end

## item 38 — getter/setter for the associated-fn phantom-self marker.
def mir_func_get_assoc_phantom_self(func: MirFunc): Int = func.assoc_phantom_self

def mir_func_set_assoc_phantom_self(func: MirFunc, v: Int): Void
  func.assoc_phantom_self = v
end

def mir_func_get_name(func: MirFunc): String = func.name

def mir_func_get_origin_module(func: MirFunc): String = func.origin_module

def mir_func_set_origin_module(func: MirFunc, module_name: String): Void
  func.origin_module = module_name
end

def mir_func_get_return_type(func: MirFunc): Int = func.return_type

def mir_func_get_value_counter(func: MirFunc): Int = func.value_counter

def mir_func_is_naked(func: MirFunc): Int = func.is_naked

def mir_func_set_naked(func: MirFunc): Void
  func.is_naked = 1
end

def mir_func_is_no_preempt(func: MirFunc): Int = func.is_no_preempt

def mir_func_set_no_preempt(func: MirFunc): Void
  func.is_no_preempt = 1
end

def mir_func_is_weak(func: MirFunc): Int = func.is_weak

def mir_func_set_weak(func: MirFunc): Void
  func.is_weak = 1
end

def mir_func_is_export(func: MirFunc): Int = func.is_export

def mir_func_set_export(func: MirFunc): Void
  func.is_export = 1
end

def mir_func_is_noinline(func: MirFunc): Int = func.is_noinline

def mir_func_set_noinline(func: MirFunc): Void
  func.is_noinline = 1
end

var _g_cconv_c_funcs = vec_new()

def mir_func_set_cconv_c(func: MirFunc): Void
  _g_cconv_c_funcs.push(func.id)
end

def mir_func_is_cconv_c(func: MirFunc): Int
  var fid = func.id
  for i in 0.._g_cconv_c_funcs.size
    if _g_cconv_c_funcs[i] == fid
      return 1
    end
  end
  return 0
end

## NET.4 Layer 3 — @ct flag side-table. Same pattern as the cconv side-tables
## above. Consumed by `self-hosted/middle/ct_taint.qz` to gate the constant-
## time taint pass; ignored everywhere else. Side-table chosen over a struct
## field to avoid forcing every MirFunc allocator to thread a default.
var _g_ct_funcs = vec_new()

def mir_func_set_ct(func: MirFunc): Void
  _g_ct_funcs.push(func.id)
end

def mir_func_is_ct(func: MirFunc): Int
  var fid = func.id
  for i in 0.._g_ct_funcs.size
    if _g_ct_funcs[i] == fid
      return 1
    end
  end
  return 0
end

## SYS.1 item 8 — x86-interrupt calling convention.
## LLVM emits `x86_intrcc` before the return type; backend handles
## the interrupt frame and `iret`. Same side-table pattern as cconv_c.
var _g_cconv_x86_intr_funcs = vec_new()

def mir_func_set_cconv_x86_intr(func: MirFunc): Void
  _g_cconv_x86_intr_funcs.push(func.id)
end

def mir_func_is_cconv_x86_intr(func: MirFunc): Int
  var fid = func.id
  for i in 0.._g_cconv_x86_intr_funcs.size
    if _g_cconv_x86_intr_funcs[i] == fid
      return 1
    end
  end
  return 0
end

## LLVM `preserve_allcc` — almost-all-registers-preserved cconv.
var _g_cconv_preserve_all_funcs = vec_new()

def mir_func_set_cconv_preserve_all(func: MirFunc): Void
  _g_cconv_preserve_all_funcs.push(func.id)
end

def mir_func_is_cconv_preserve_all(func: MirFunc): Int
  var fid = func.id
  for i in 0.._g_cconv_preserve_all_funcs.size
    if _g_cconv_preserve_all_funcs[i] == fid
      return 1
    end
  end
  return 0
end

## LLVM `preserve_mostcc` — most-registers-preserved cconv.
var _g_cconv_preserve_most_funcs = vec_new()

def mir_func_set_cconv_preserve_most(func: MirFunc): Void
  _g_cconv_preserve_most_funcs.push(func.id)
end

def mir_func_is_cconv_preserve_most(func: MirFunc): Int
  var fid = func.id
  for i in 0.._g_cconv_preserve_most_funcs.size
    if _g_cconv_preserve_most_funcs[i] == fid
      return 1
    end
  end
  return 0
end

## SYS.1 item 4 — struct-level alignment registry, keyed by struct
## name. Mir_lower fills this from AST when lowering @align(N) struct
## definitions; codegen reads it when emitting @value struct allocas.
## Parallel vectors (name, align) rather than a Map because struct
## counts are small and lookup is occasional.
var _g_mir_struct_align_names = vec_new<String>()
var _g_mir_struct_align_values = vec_new<Int>()

def mir_set_struct_align(name: String, align: Int): Void
  # Upsert — later registrations override earlier ones, though mir_lower
  # should only register once per struct.
  for i in 0.._g_mir_struct_align_names.size
    if _g_mir_struct_align_names[i] == name
      _g_mir_struct_align_values[i] = align
      return
    end
  end
  _g_mir_struct_align_names.push(name)
  _g_mir_struct_align_values.push(align)
end

def mir_get_struct_align(name: String): Int
  for i in 0.._g_mir_struct_align_names.size
    if _g_mir_struct_align_names[i] == name
      return _g_mir_struct_align_values[i]
    end
  end
  return 0
end

## A.36 — generic-struct type-parameter registry, keyed by struct name.
## Mir_lower fills this from the struct AST (NODE_STRUCT_DEF str2 slot) so the
## monomorphization path can align a concrete instantiation's type args with the
## struct's declared param names. Stored as the raw bracketed source form the
## parser emits (e.g. "<I>", "<C: Counter>", "<S, M>"); callers strip with
## `mir_struct_type_param_names`. Parallel vectors mirror the align registry.
var _g_mir_struct_tparam_names = vec_new<String>()
var _g_mir_struct_tparam_values = vec_new<String>()

def mir_set_struct_type_params(name: String, tp: String): Void
  for i in 0.._g_mir_struct_tparam_names.size
    if _g_mir_struct_tparam_names[i] == name
      _g_mir_struct_tparam_values[i] = tp
      return
    end
  end
  _g_mir_struct_tparam_names.push(name)
  _g_mir_struct_tparam_values.push(tp)
end

def mir_get_struct_type_params(name: String): String
  for i in 0.._g_mir_struct_tparam_names.size
    if _g_mir_struct_tparam_names[i] == name
      return _g_mir_struct_tparam_values[i]
    end
  end
  # item 32b — cross-module suffix fallback. A generic struct defined in an
  # IMPORTED module registers its type-params under the MODULE-PREFIXED key
  # (`nmutp_xmod_module$XMDouble`), but callers in the generic-struct
  # extend-method monomorphization router (`_mir_try_struct_method_spec`) look it
  # up by the BARE struct name (`XMDouble`, parsed off the receiver instantiation
  # `XMDouble<XMRange>`). Without this fallback the bare lookup misses ⇒ the
  # router sees a non-generic struct ⇒ no spec queued ⇒ the extend-method lowers
  # un-monomorphized ⇒ a @value field receiver read takes the boxed
  # inttoptr+GEP+load branch on the inlined value ⇒ SIGSEGV (the cross-module twin
  # of the in-module item-32 fix `14c25e61`). Mirror `mir_resolve_struct_name`'s
  # suffix match: a `$<name>` key resolves to the qualified registration. No-op
  # when names match (the exact loop above hits first) ⇒ byte-identical for every
  # in-module / non-generic / non-@value case (the universal compiler/stdlib path).
  var suffix = "$#{name}"
  var suffix_len = str_byte_len(suffix)
  for k in 0.._g_mir_struct_tparam_names.size
    var key = _g_mir_struct_tparam_names[k]
    var key_len = str_byte_len(key)
    if key_len >= suffix_len
      var end_part = str_byte_slice(key, key_len - suffix_len, key_len)
      if end_part == suffix
        return _g_mir_struct_tparam_values[k]
      end
    end
  end
  return ""
end

## Parse a struct's declared type-param string ("<I>", "<C: Counter>",
## "<S, M>") into a Vec of bare param names ["I"] / ["C"] / ["S", "M"],
## stripping the brackets and any `: Bound` / `+ Bound` clauses.
def mir_struct_type_param_names(tp: String): Vec<String>
  var names = vec_new<String>()
  var n = str_byte_len(tp)
  if n == 0
    return names
  end
  # Strip surrounding < >
  var start = 0
  var stop = n
  if str_byte_at(tp, 0) == '<'
    start = 1
  end
  if stop > start and str_byte_at(tp, stop - 1) == '>'
    stop = stop - 1
  end
  var inner = str_byte_slice(tp, start, stop)
  # Split on top-level commas (param lists never nest brackets at this level,
  # but a bound like `Iter<Int>` can — track depth to be safe).
  var depth = 0
  var seg_start = 0
  var ilen = str_byte_len(inner)
  for i in 0..ilen
    var c = str_byte_at(inner, i)
    if c == '<'
      depth += 1
    elsif c == '>'
      depth -= 1
    elsif c == ',' and depth == 0
      _mir_push_tparam_name(names, str_byte_slice(inner, seg_start, i))
      seg_start = i + 1
    end
  end
  _mir_push_tparam_name(names, str_byte_slice(inner, seg_start, ilen))
  return names
end

## Trim whitespace off a single type-param segment and drop any `: Bound`
## clause, pushing the bare name. Empty segments are skipped.
def _mir_push_tparam_name(names: Vec<String>, seg: String): Void
  var trimmed = str_trim(seg)
  var colon = __char_index(trimmed, ':')
  if colon >= 0
    trimmed = str_trim(str_byte_slice(trimmed, 0, colon))
  end
  if str_byte_len(trimmed) > 0
    names.push(trimmed)
  end
end

## Extract the top-level type arguments of a parameterized type string.
## "ITLift<ITBase>" → ["ITBase"]; "Map<String, Int>" → ["String", "Int"];
## "Outer<Inner<X>>" → ["Inner<X>"]. Returns empty if there are no `<...>` args.
def mir_type_args_of(type_str: String): Vec<String>
  var args = vec_new<String>()
  var lt = __char_index(type_str, '<')
  if lt < 0
    return args
  end
  # Find the matching closing '>' (last one at depth 0).
  var n = str_byte_len(type_str)
  var depth = 0
  var inner_start = lt + 1
  var seg_start = inner_start
  for i in lt..n
    var c = str_byte_at(type_str, i)
    if c == '<'
      depth += 1
      if depth == 1
        seg_start = i + 1
      end
    elsif c == '>'
      depth -= 1
      if depth == 0
        var seg = str_trim(str_byte_slice(type_str, seg_start, i))
        if str_byte_len(seg) > 0
          args.push(seg)
        end
        return args
      end
    elsif c == ',' and depth == 1
      var seg2 = str_trim(str_byte_slice(type_str, seg_start, i))
      if str_byte_len(seg2) > 0
        args.push(seg2)
      end
      seg_start = i + 1
    end
  end
  return args
end

def mir_func_get_params(func: MirFunc): Vec<String> = func.params

def mir_func_get_param_types(func: MirFunc): Vec<Int> = func.param_types

def mir_func_add_param(func: MirFunc, name: String, typ: Int): Void
  func.params.push(name)
  func.param_types.push(typ)
  func.param_type_names.push("")
end

def mir_func_set_param_type_name(func: MirFunc, idx: Int, type_name: String): Void
  func.param_type_names[idx] = type_name
end

def mir_func_get_param_type_name(func: MirFunc, idx: Int): String = func.param_type_names[idx]

def mir_func_set_return_type_name(func: MirFunc, type_name: String): Void
  func.return_type_name = type_name
end

def mir_func_get_return_type_name(func: MirFunc): String = func.return_type_name

def mir_func_set_local_type(func: MirFunc, name: String, type_name: String): Void
  func.local_narrow_names.push(name)
  func.local_narrow_types.push(type_name)
end

def mir_func_get_local_type(func: MirFunc, name: String): String
  var count = func.local_narrow_names.size
  for i in 0..count
    if func.local_narrow_names[i].eq(name)
      return func.local_narrow_types[i]
    end
  end
  return ""
end

## Check if a type name represents a narrow fixed-width integer type (< i64)
def mir_is_narrow_fixed_width(type_name: String): Int
  if str_byte_len(type_name) == 0
    return 0
  end
  return 1 if type_name == "I8"
  return 1 if type_name == "I16"
  return 1 if type_name == "I32"
  return 1 if type_name == "U8"
  return 1 if type_name == "U16"
  return 1 if type_name == "U32"
  return 1 if type_name == "CInt"
  return 1 if type_name == "CChar"
  return 0
end

## B.10 P2.3 — GC firewall: 1 if a @value field type name is a raw-bit SCALAR
## (no heap pointer in the slot), 0 if it is (or might be) a tracked POINTER.
##
## Scalars are the primitive types whose i64 slot holds pure bits a future GC must
## NOT trace: Int/Bool, the narrow fixed-width ints (delegated to
## mir_is_narrow_fixed_width: I8/I16/I32/U8/U16/U32/CInt/CChar), the wide C-int
## aliases (I64/U64/CSize), Char (a codepoint, TYPE_INT-backed), Byte, and the
## floats (F32/F64/Float/CFloat/CDouble — bits ride in integer registers today).
##
## Everything else is a POINTER by default (the safe direction): String, Symbol,
## Vec<...>/Map<...>/Set<...> and other parametric handles, user struct names,
## CPtr, and bare generic type-params. A mixed scalar+pointer @value block is
## blocked from the unboxed byval return path (see mir_func_returns_byval_struct)
## until a scan_map lets a GC distinguish the slots.
def mir_is_scalar_field_type(type_name: String): Int
  return 0 if str_byte_len(type_name) == 0
  # Narrow fixed-width integers (I8/I16/I32/U8/U16/U32/CInt/CChar).
  return 1 if mir_is_narrow_fixed_width(type_name)
  # Wide integer scalars.
  return 1 if type_name == "Int"
  return 1 if type_name == "Bool"
  return 1 if type_name == "I64"
  return 1 if type_name == "U64"
  return 1 if type_name == "CSize"
  return 1 if type_name == "Char"
  return 1 if type_name == "Byte"
  # Floating-point scalars (bits live in an i64 slot today, §5).
  return 1 if type_name == "F32"
  return 1 if type_name == "F64"
  return 1 if type_name == "Float"
  return 1 if type_name == "CFloat"
  return 1 if type_name == "CDouble"
  # Default: pointer / heap-tracked (String, Symbol, Vec/Map/Set, user struct,
  # CPtr, generic param, ...). Safe direction = treat as pointer.
  return 0
end

## B.10 P2.3 (Vec extension) — GC firewall for the Vec inline-storage path.
## 1 if a @value struct is firewall-safe to inline contiguously into a Vec
## backing buffer: homogeneous slots (all-scalar OR all-pointer), so a future GC
## scanning the backing can treat every slot uniformly. 0 if the struct mixes
## raw-bit scalar slots and tracked-pointer slots — that block must fall back to
## the BOXED Vec path (one i64 heap pointer per element, the non-@value path), so
## no raw String/Vec pointer is inlined alongside scalar bits without a scan_map.
## Same classification (mir_is_scalar_field_type) as the byval return firewall.
## Non-@value or unknown structs return 0 (the byval/inline callers also gate on
## mir_prog_get_value_field_count, so a 0 here just forces the boxed Vec path).
def mir_prog_struct_is_firewall_safe(prog: MirProgram, struct_name: String): Int
  if str_byte_len(struct_name) == 0
    return 0
  end
  if str_contains(struct_name, "<")
    return 0
  end
  var defs = prog.struct_defs
  var count = defs.size
  for i in 0..count
    var entry = defs[i]
    if entry.name == struct_name
      if entry.is_value != 1
        return 0
      end
      var field_types = entry.field_types
      var has_scalar = 0
      var has_pointer = 0
      for j in 0..vec_size(field_types)
        if mir_is_scalar_field_type(as_string(field_types[j])) == 1
          has_scalar = 1
        else
          has_pointer = 1
        end
      end
      if has_scalar == 1 and has_pointer == 1
        return 0
      end
      return 1
    end
  end
  return 0
end

## Check if a type name represents an unsigned integer type
def mir_is_unsigned_type(type_name: String): Int
  if str_byte_len(type_name) == 0
    return 0
  end
  return 1 if type_name == "U8"
  return 1 if type_name == "U16"
  return 1 if type_name == "U32"
  return 0
end

## Check if a type annotation is a union type (contains ' | ' at top level, not inside <>)
def mir_is_union_annotation(ann: String): Bool
  var depth = 0
  for i in 0..str_byte_len(ann)
    var c = str_byte_at(ann, i)
    if c == 60
      depth += 1
    end
    if c == 62
      depth -= 1
    end
    if c == 124 and depth == 0
      return true
    end
  end
  return false
end

## R2.1 (B1) — split a union annotation on top-level '|' into its arm strings.
## Depth-aware (respects '<'/'>' nesting so "Vec<Int | String>" is NOT split),
## mirroring tc_split_type_union (typecheck_registry.qz:2089) and the scan in
## mir_is_union_annotation above. Returns trimmed arm strings; a non-union
## annotation returns a single-element vec with the original annotation.
def mir_union_arms(ann: String): Vec<String>
  var parts = vec_new<String>()
  var depth = 0
  var start = 0
  var i = 0
  var len = str_byte_len(ann)
  while i < len
    var ch = str_byte_at(ann, i)
    if ch == 60
      depth += 1
    end
    if ch == 62
      depth -= 1
    end
    if ch == 124 and depth == 0
      var part = str_trim(str_byte_slice(ann, start, i))
      if str_byte_len(part) > 0
        parts.push(part)
      end
      start = i + 1
    end
    i += 1
  end
  var last_part = str_trim(str_byte_slice(ann, start, len))
  if str_byte_len(last_part) > 0
    parts.push(last_part)
  end
  return parts
end

## R2.1 (B1) — stable tag for a union arm = FNV-1a hash of its arm type string
## (OCaml poly-variant trick: hashing the arm type-id, not a dense per-union
## index, so widening codegen never depends on a globally-consistent arm order).
def mir_union_arm_tag(arm: String): Int
  return fnv1a_hash(arm)
end

## R2.1 (B4) — the non-Nil arm of a niche-eligible `T | Nil` union, else "".
## Conservative: returns the payload arm ONLY when the union is EXACTLY two arms
## and EXACTLY one is spelled "Nil" (the surface never spells a real member "Nil"
## — see tc_union_contains_nil). Any other shape (0/1/≥3 arms, both Nil, no Nil)
## returns "" ⇒ the caller SPILLS to the tagged `{tag,payload}` cell.
def mir_union_nil_payload_arm(ann: String): String
  var arms = mir_union_arms(ann)
  return "" if arms.size != 2
  var a0 = str_trim(as_string(arms[0]))
  var a1 = str_trim(as_string(arms[1]))
  return a1 if a0 == "Nil" and a1 != "Nil"
  return a0 if a1 == "Nil" and a0 != "Nil"
  return ""
end

## R2.1 (B4) — 1 iff `ann` is a niche-eligible `T | Nil` union: exactly two arms,
## one is `Nil`, and the non-Nil arm has a PROVEN spare inhabitant per
## `niche::type_niche` (`&T`/`&mut T` → {0}; `Bool` → {2..255}; `NonZero` → {0}).
## When true, the union drops its tag word: the value is stored payload-sized and
## the Nil bit-pattern (mir_union_nil_const) is the discriminant. CONSERVATIVE —
## returns 0 (keep the tag) whenever in ANY doubt. A false-positive niche (dropping
## the tag when the arms are NOT distinguishable by a spare bit) is a SILENT
## MISCOMPILE, so this only fires for the type_niche-confirmed spare-bit arms;
## every other union (`Int | String`, `Int | Nil`, ≥3 arms, no Nil) SPILLS.
## Modeled on mir_option_is_niche (:10419). MUST be consulted BYTE-FOR-BYTE
## identically at the widen site AND every narrow/read site.
def mir_union_is_niche(ctx: MirContext, ann: String): Int
  var arm = mir_union_nil_payload_arm(ann)
  return 0 if str_byte_len(arm) == 0
  # Only the sound-regardless-of-nil spare sources (Bool / &T / NonZero). A full-
  # width Int/String/CPtr arm has no invalid pattern ⇒ niche_count 0 ⇒ SPILL. The
  # BOXED-pointer null niche is NOT claimed here (that would collide with a Nil=0
  # arm value); we require an explicit type_niche spare, keeping this narrow.
  return 1 if niche::niche_count(niche::type_niche(arm)) >= 1
  return 0
end

## R2.1 (B4) — the bit-pattern representing the `Nil` arm under niche layout: the
## payload arm's first niche value (`0` for `&T`/`NonZero`; `2` for `Bool`).
## Analogue of mir_option_none_const (:10429). Called ONLY when mir_union_is_niche
## is 1, so type_niche is guaranteed to have a spare (niche_start well-defined).
def mir_union_nil_const(ctx: MirContext, ann: String): Int
  var arm = mir_union_nil_payload_arm(ann)
  return niche::niche_start(niche::type_niche(arm))
end

## R2 (C1) — is `ann` a structural-record type annotation `{ f1: T1, f2: T2 }`?
## True iff it starts with '{', ends with '}', and contains a top-level ':' (the
## field:type separator) at brace-depth 1 (so a bare Map literal annotation without
## a field-typed body — which the surface never produces as a TYPE annotation — is
## excluded). This is the SINGLE gate for the C1 record-value path; the compiler's
## own sources carry NO record-typed annotations that reach here as first-class
## record values (they hit the PASS 0.97 monomorphize path today) ⇒ gate-0-inert.
def mir_is_record_annotation(ann: String): Bool
  var len = str_byte_len(ann)
  return false if len < 3
  return false if str_byte_at(ann, 0) != 123
  return false if str_byte_at(ann, len - 1) != 125
  # Require a top-level (brace-depth 1, angle-depth 0) ':' separating a field name
  # from its type. Depth tracking mirrors mir_union_arms.
  var bdepth = 0
  var adepth = 0
  var i = 0
  while i < len
    var c = str_byte_at(ann, i)
    if c == 123
      bdepth += 1
    end
    if c == 125
      bdepth -= 1
    end
    if c == 60
      adepth += 1
    end
    if c == 62
      adepth -= 1
    end
    if c == 58 and bdepth == 1 and adepth == 0
      return true
    end
    i += 1
  end
  return false
end

## R2 (C1/§3.3) — 1 iff `ann` is an INTERSECTION annotation (`{A} & {B}`), i.e. a
## record-shaped annotation carrying a top-level (brace-depth 0, angle-depth 0) '&'.
## mir_is_record_annotation accepts these (first `{`, last `}`, a depth-1 ':'), but
## they are NOT a single canonical record — an intersection param resolves its field
## reads through the per-struct global fallback, so the record reprojecting copy must
## NOT intercept them (it would mir_record_parse_fields the whole `{A}&{B}` as one
## mis-parsed record). Depth tracking mirrors mir_is_record_annotation.
def mir_record_is_intersection(ann: String): Bool
  var len = str_byte_len(ann)
  var bdepth = 0
  var adepth = 0
  var i = 0
  while i < len
    var c = str_byte_at(ann, i)
    if c == 123
      bdepth += 1
    end
    if c == 125
      bdepth -= 1
    end
    if c == 60
      adepth += 1
    end
    if c == 62
      adepth -= 1
    end
    if c == 38 and bdepth == 0 and adepth == 0
      return true
    end
    i += 1
  end
  return false
end

## R2 (C1) — byte-lexicographic '<' on strings (for canonical field sorting).
## Returns true iff `a` sorts strictly before `b`.
def mir_str_lt(a: String, b: String): Bool
  var la = str_byte_len(a)
  var lb = str_byte_len(b)
  var n = la
  if lb < n
    n = lb
  end
  var i = 0
  while i < n
    var ca = str_byte_at(a, i)
    var cb = str_byte_at(b, i)
    if ca < cb
      return true
    end
    if ca > cb
      return false
    end
    i += 1
  end
  return la < lb
end

## R2 (C1) — parse a record annotation `{ f1: T1, f2: T2 }` into parallel
## (field_names, field_types) vecs, SORTED by field name (the single canonical
## order). Depth-aware split on top-level ',' (respecting '<>' and nested '{}'),
## then split each part on its FIRST top-level ':'. Models mir_union_arms.
## The sort is the canonicalization oracle: every occurrence of the same field-set
## lays out identically regardless of source field order.
def mir_record_parse_fields(ann: String): Vec<Vec<String>>
  var names = vec_new<String>()
  var types = vec_new<String>()
  var len = str_byte_len(ann)
  # Strip the outer braces.
  var inner_start = 0
  var inner_end = len
  if len >= 2 and str_byte_at(ann, 0) == 123 and str_byte_at(ann, len - 1) == 125
    inner_start = 1
    inner_end = len - 1
  end
  var depth = 0
  var start = inner_start
  var i = inner_start
  while i <= inner_end
    var at_end = i == inner_end
    var ch = 0
    if not at_end
      ch = str_byte_at(ann, i)
    end
    if ch == 60 or ch == 123
      depth += 1
    end
    if ch == 62 or ch == 125
      depth -= 1
    end
    if at_end or (ch == 44 and depth == 0)
      var part = str_trim(str_byte_slice(ann, start, i))
      if str_byte_len(part) > 0
        # Split on the FIRST top-level ':' → (name, type).
        var plen = str_byte_len(part)
        var cdepth = 0
        var colon = -1
        var k = 0
        while k < plen
          var pc = str_byte_at(part, k)
          if pc == 60 or pc == 123
            cdepth += 1
          end
          if pc == 62 or pc == 125
            cdepth -= 1
          end
          if pc == 58 and cdepth == 0
            colon = k
            k = plen
          else
            k += 1
          end
        end
        if colon >= 0
          var fname = str_trim(str_byte_slice(part, 0, colon))
          var ftype = str_trim(str_byte_slice(part, colon + 1, plen))
          names.push(fname)
          types.push(ftype)
        end
      end
      start = i + 1
    end
    i += 1
  end
  # Insertion sort by field name (small N; stable canonical order).
  var n = names.size
  var a = 1
  while a < n
    var nm = as_string(names[a])
    var ty = as_string(types[a])
    var b = a - 1
    while b >= 0 and mir_str_lt(nm, as_string(names[b]))
      names[b + 1] = names[b]
      types[b + 1] = types[b]
      b -= 1
    end
    names[b + 1] = nm
    types[b + 1] = ty
    a += 1
  end
  var out = vec_new<Vec<String>>()
  out.push(names)
  out.push(types)
  return out
end

## R2 (C1) — LLVM-symbol-safe token: map chars that are illegal in an LLVM global
## name (':', ',', '<', '>', ' ', '|', '&') to '$'. The synthetic record name flows
## verbatim into emitted symbols (qz_hash_<Name>/qz_eq_<Name>, %struct.<Name>), so
## every char must be legal. '$' is already the compiler's mangling separator.
def mir_record_sanitize_token(tok: String): String
  var out = ""
  var i = 0
  var len = str_byte_len(tok)
  while i < len
    var c = str_byte_at(tok, i)
    # ':' ',' '<' '>' ' ' '|' '&'
    if c == 58 or c == 44 or c == 60 or c == 62 or c == 32 or c == 124 or c == 38
      out = out + "$"
    else
      out = out + str_byte_slice(tok, i, i + 1)
    end
    i += 1
  end
  return out
end

## R2 (C1) — synthetic canonical struct name for a record type. SORTED field order
## (from mir_record_parse_fields) → `__rec$name1$Type1$name2$Type2` (symbol-safe).
## Every occurrence of the same field-set (any source order) maps to the SAME name
## ⇒ one shared flat layout. Field name/type tokens are sanitized so the name is a
## legal LLVM identifier (it is emitted verbatim as qz_hash_<Name>/%struct.<Name>).
def mir_record_canonical_name(ann: String): String
  var parsed = mir_record_parse_fields(ann)
  var names = parsed[0]
  var types = parsed[1]
  var n = names.size
  var out = "__rec"
  var i = 0
  while i < n
    out = out + "$" + mir_record_sanitize_token(as_string(names[i]))
    out = out + "$" + mir_record_sanitize_token(as_string(types[i]))
    i += 1
  end
  # Trailing sentinel so the name never ENDS in `$<TypeName>` — otherwise
  # mir_resolve_struct_name's `$suffix` match would resolve a bare type lookup
  # (`Int`) to this record struct (`...$Int`), causing wrong/looping resolution
  # (the item-39 `$Int` suffix-collision landmine — here it stack-overflowed).
  out = out + "$rec_"
  return out
end

## R2 (C1) — register a structural record annotation `{ x: Int, y: Int }` as a
## @value flat-layout struct under its sorted-canonical name (idempotent). Fields
## carry NO defaults. `ast_store` is only stored for API symmetry (record fields
## have no default expressions, so it is never dereferenced). After this, the
## record type behaves exactly like a nominal @value struct for construction,
## field access, decompose, and COW — reusing the name-keyed machinery verbatim.
def mir_register_record_struct(ctx: MirContext, ann: String, ast_store: ast::AstStorage): String
  var canon = mir_record_canonical_name(ann)
  var parsed = mir_record_parse_fields(ann)
  var names = parsed[0]
  var types = parsed[1]
  var n = names.size
  var field_defaults = vec_new<Int>()
  for i in 0..n
    field_defaults.push(0)
  end
  # is_value=1 → flat stack/decompose/COW layout, reusing the @value path.
  mir_ctx_register_struct(ctx, canon, names, types, 0, 0, 1, field_defaults, ast_store)
  return canon
end

## R2.1 (B1) — payload width (in i64 words) of a union's tagged cell. For B1 all
## arms are single-word scalars (Int, String both one i64), so 1. GENERALIZATION
## POINT: a wider @value arm needs max-over-arms sizing (copy the binary-union
## arm-byte accumulation idiom, cg_intrinsic_binary.qz:1837-1839) computed over
## mir_union_arms(ann).
def mir_union_payload_words(ann: String): Int
  return 1
end

## Get the narrow type name for an identifier (checks both locals and params)
## Returns the narrow type name (e.g., "U8", "I8") or "" if not narrow
def mir_get_narrow_type_of_ident(ctx: MirContext, name: String): String
  var func = mir_ctx_get_func(ctx)
  # Check local variables first
  var local_type = mir_func_get_local_type(func, name)
  if str_byte_len(local_type) > 0
    return local_type
  end
  # Check parameters
  var params = mir_func_get_params(func)
  var count = params.size
  for i in 0..count
    if params[i].eq(name)
      var pt = mir_func_get_param_type_name(func, i)
      if str_byte_len(pt) > 0
        if mir_is_narrow_fixed_width(pt)
          return pt
        end
      end
      return ""
    end
  end
  return ""
end

## Get the narrow type of an AST expression (for binary op wrapping)
## Returns the narrow type name or "" if not narrow
def mir_get_narrow_type_of_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  var kind = ast::ast_get_kind(s, node)
  # Identifier - look up variable/param narrow type
  if kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(s, node)
    return mir_get_narrow_type_of_ident(ctx, name)
  end
  # Binary expression - narrow if both operands are narrow of the same type
  if kind == node_constants::NODE_BINARY
    var bin = ast::ast_extract_binary(s, node)
    var left = bin[0]
    var right = bin[1]
    var left_type = mir_get_narrow_type_of_expr(ctx, s, left)
    if str_byte_len(left_type) > 0
      var right_type = mir_get_narrow_type_of_expr(ctx, s, right)
      return left_type if right_type == left_type
    end
    return ""
  end
  # Integer literal with type suffix
  if kind == node_constants::NODE_INT_LIT
    var suffix = ast::ast_get_str2(s, node)
    if str_byte_len(suffix) > 0
      if mir_is_narrow_fixed_width(suffix)
        return suffix
      end
    end
    return ""
  end
  # Call expression - check callee return type
  if kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(s, node)
    var callee_kind = ast::ast_get_kind(s, callee)
    if callee_kind == node_constants::NODE_IDENT
      var fname = ast::ast_get_str1(s, callee)
      var func_entry = mir_lookup_function(ctx, fname)
      if func_entry.is_some()
        var fe = func_entry.unwrap()
        var func_s = fe.ast_store
        var ret_type = mir_func_get_return_type_name(func_s)
        if str_byte_len(ret_type) > 0
          if mir_is_narrow_fixed_width(ret_type)
            return ret_type
          end
        end
      end
    end
    return ""
  end
  return ""
end

## Map a narrow type name to its truncation intrinsic name
def mir_narrow_to_intrinsic(type_name: String): String
  return "to_u8" if type_name == "U8"
  return "to_i8" if type_name == "I8"
  return "to_u16" if type_name == "U16"
  return "to_i16" if type_name == "I16"
  return "to_u32" if type_name == "U32"
  return "to_i32" if type_name == "I32"
  return ""
end

## Map a Quartz type name to its LLVM IR type string
def mir_type_name_to_llvm(type_name: String): String
  return "i8" if type_name == "I8"
  return "i16" if type_name == "I16"
  return "i32" if type_name == "I32"
  return "i8" if type_name == "U8"
  return "i16" if type_name == "U16"
  return "i32" if type_name == "U32"
  return "i32" if type_name == "CInt"
  return "i8" if type_name == "CChar"
  return "i64"
end

## Check if a struct has any narrow (non-i64) fields
def mir_struct_has_narrow_fields(ctx: MirContext, struct_name: String): Int
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      # @repr(C) structs always use typed layout
      var repr_c = entry.repr_c
      return 1 if repr_c == 1
      var field_types = entry.field_types
      var ft_count = vec_size(field_types)
      for j in 0..ft_count
        var ft = as_string(field_types[j])
        if mir_is_narrow_fixed_width(ft)
          return 1
        end
      end
      return 0
    end
  end
  return 0
end

## Get the type annotation of a field in a struct
def mir_ctx_get_field_type(ctx: MirContext, struct_name: String, field_name: String): String
  # Strip leading '&' or '&mut ' for borrow types
  struct_name = mir_strip_borrow_prefix(struct_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var field_names = entry.field_names
      var field_types = entry.field_types
      var fc = vec_size(field_names)
      for j in 0..fc
        if as_string(field_names[j]).eq(field_name)
          return as_string(field_types[j])
        end
      end
      return ""
    end
  end
  return ""
end

def mir_func_get_blocks(func: MirFunc): Vec<MirBlock> = func.blocks

def mir_func_get_entry(func: MirFunc): MirBlock = func.entry

def mir_func_next_value(func: MirFunc): Int
  var counter = func.value_counter
  func.value_counter = counter + 1
  return counter
end

def mir_func_next_block_id(func: MirFunc): Int
  var counter = func.block_counter
  func.block_counter = counter + 1
  return counter
end

def mir_func_get_locals(func: MirFunc): Vec<String> = func.locals

def mir_func_set_line(func: MirFunc, line: Int): Void
  func.line = line
end

def mir_func_get_line(func: MirFunc): Int = func.line

def mir_func_set_col(func: MirFunc, col: Int): Void
  func.col = col
end

def mir_func_get_col(func: MirFunc): Int = func.col

# Create new basic block
def mir_new_block(label: String): MirBlock
  return MirBlock {
    label: label,
    instructions: vec_new(),
    term_kind: -1,
    term_data: 0,
    branch_true: 0,
    branch_false: 0,
    terminated: 0,
    id: mir_next_block_id()
  }
end

def mir_block_get_label(block: MirBlock): String = block.label

def mir_block_get_instructions(block: MirBlock): Vec<MirInstr> = block.instructions

def mir_block_add_instr(block: MirBlock, instr: MirInstr): Void
  block.instructions.push(instr)
end

def mir_block_is_terminated(block: MirBlock): Int = block.terminated

def mir_block_mark_terminated(block: MirBlock): Void
  block.terminated = 1
end

def mir_block_set_terminator(block: MirBlock, kind: Int, data: Int): Void
  # Guard: don't overwrite if already terminated (divergent call already set it)
  return if mir_block_is_terminated(block)
  block.term_kind = kind
  block.term_data = data
end

def mir_block_set_branch(block: MirBlock, cond: MirReg, true_target: MirBlock, false_target: MirBlock): Void
  block.term_kind = TERM_BRANCH
  block.term_data = cond
  block.branch_true = as_int_generic(true_target)
  block.branch_false = as_int_generic(false_target)
end

var _g_switch_block_ids = vec_new()
var _g_switch_values = vec_new<Vec<Int>>()
var _g_switch_targets = vec_new<Vec<Int>>()

def mir_block_set_switch(block: MirBlock, cond: MirReg, case_vals: Vec<Int>, case_targets: Vec<Int>, default_target: MirBlock): Void
  block.term_kind = TERM_SWITCH
  block.term_data = cond
  block.branch_true = as_int_generic(default_target)
  block.terminated = 1
  _g_switch_block_ids.push(block.id)
  _g_switch_values.push(case_vals)
  _g_switch_targets.push(case_targets)
end

def mir_block_get_switch_values(block: MirBlock): Vec<Int>
  var bid = block.id
  var i = _g_switch_block_ids.size - 1
  while i >= 0
    if _g_switch_block_ids[i] == bid
      return _g_switch_values[i]
    end
    i -= 1
  end
  return vec_new()
end

def mir_block_get_switch_targets(block: MirBlock): Vec<Int>
  var bid = block.id
  var i = _g_switch_block_ids.size - 1
  while i >= 0
    if _g_switch_block_ids[i] == bid
      return _g_switch_targets[i]
    end
    i -= 1
  end
  return vec_new()
end

def mir_block_get_term_kind(block: MirBlock): Int = block.term_kind

def mir_block_get_term_data(block: MirBlock): Int = block.term_data

def mir_block_set_term_data(block: MirBlock, data: Int): Void
  block.term_data = data
end

def mir_block_get_branch_true(block: MirBlock): Int = block.branch_true

def mir_block_get_branch_false(block: MirBlock): Int = block.branch_false

## INC.1.3 — block-target setters used by `qzmod_load.qz`'s fix-up pass
## to rebind `branch_true` / `branch_false` from cached indices to live
## MirBlock heap pointers. Direct `block.<field> = X` field-access works
## from within a typed MirBlock binding; the helpers exist because the
## fix-up callsite reads block handles out of a `Vec<Int>` and needs the
## function-arg boundary to re-establish struct typing (see fix-up loop
## in `mir_unpickle_function`).
def mir_block_set_branch_true(block: MirBlock, target: Int): Void
  block.branch_true = target
end

def mir_block_set_branch_false(block: MirBlock, target: Int): Void
  block.branch_false = target
end

# Create new MIR instruction
def mir_new_instr(kind: Int, dest_id: Int, dest_type: Int): MirInstr
  prof_alloc_site("mir_new_instr", 88)
  return MirInstr {
    kind: kind,
    dest_id: dest_id,
    dest_type: dest_type,
    operand1: 0,
    operand2: 0,
    op: 0,
    args: vec_new(),
    slot1: 0,
    slot2: 0,
    line: 0,
    col: 0
  }
end

