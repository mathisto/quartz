# ============================================================================
# MIR Lowering State
# ============================================================================

# Lowering context holds current state during AST->MIR translation
def mir_new_context(prog: Vec): MirContext
  var mir_drops = MirDropState {
    drop_types: vec_new<String>(),
    droppable_stack: vec_new(),
    defer_stack: vec_new(),
    loop_defer_depth: 0
  }
  var mir_generics = MirGenericState {
    generic_bounded_funcs: vec_new(),
    pending_specs: vec_new(),
    spec_param_types: vec_new(),
    spec_current_type: "",
    spec_current_module_prefix: "",
    impl_current_type: "",
    spec_memo: 0,
    spec_in_progress: vec_new<String>()
  }
  var ctx = MirContext {
    program: prog,
    func: Option::None,
    block: 0,
    bindings: vec_new(),
    break_target: 0,
    continue_target: 0,
    lambda_counter: 0,
    next_slot: 0,
    module_name: "",
    all_funcs: vec_new<ResolverEntry>(),
    all_funcs_by_name: map_new<String, Int>(),
    string_vars: vec_new<String>(),
    pending_bind_names: vec_new<String>(),
    pending_bind_base: 0,
    pending_bind_inline: vec_new<Int>(),
    pending_bind_niche: vec_new<Int>(),
    pending_bind_niche_mask: vec_new<Int>(),
    pending_nested_bind_names: vec_new<String>(),
    pending_nested_bind_regs: vec_new<Int>(),
    pending_nested_bind_types: vec_new<String>(),
    pending_nested_bind_inline: vec_new<Int>(),
    niche_expected_type: "",
    cow_field_shift: 0,
    cow_mu_seq: 0,
    borrowed_self_receiver: 0,
    arena_owned_vars: vec_new<String>(),
    ref_vars: vec_new<String>(),
    nonescaping_lambda_nodes: vec_new<Int>(),
    struct_types: vec_new(),
    struct_registry: vec_new(),
    enum_names: vec_new<String>(),
    enum_variants: vec_new(),
    enum_variant_field_types: vec_new(),
    enum_has_payloads: vec_new(),
    global_registry: vec_new(),
    line: 0,
    drops: mir_drops,
    loop_stack: vec_new(),
    scope_depth: 0,
    loop_scope_depth: 0,
    loop_wrap_depth: 0,
    float_vars: vec_new<String>(),
    generics: mir_generics,
    hoisted_vec_ptrs: vec_new(),
    vec_elem_types: vec_new(),
    map_key_types: vec_new(),
    map_value_types: vec_new(),
    interner: string_intern::intern_new(),
    iterator_bound_params: vec_new<String>(),
    narrowed_var_names: vec_new<String>(),
    narrowed_variant_names: vec_new<String>(),
    handler_stack_effs: vec_new<String>(),
    handler_stack_filters: vec_new<String>(),
    handler_stack_handlers: vec_new<Int>(),
    handler_stack_install_dests: vec_new<Int>(),
    wrap_stack_eff_names: vec_new<String>(),
    wrap_stack_pop_counts: vec_new<Int>(),
    wrap_stack_kinds: vec_new<Int>(),
    wrap_stack_scoped_release_fns: vec_new<String>(),
    wrap_stack_scoped_self_slot_names: vec_new<String>(),
    wrap_stack_scoped_v_slot_names: vec_new<String>()
  }
  return ctx
end

# Helper to ensure labeled loop stack exists (now always initialized in mir_new_context)
def mir_ctx_ensure_loop_stack(ctx: MirContext): Void
  # No-op: loop_stack is always initialized in mir_new_context
end

def mir_ctx_get_loop_stack(ctx: MirContext): Vec<MirLoopEntry> = ctx.loop_stack

def mir_ctx_push_loop(ctx: MirContext, label: String, break_block: MirBlock, continue_block: MirBlock, scope_depth: Int, wrap_depth: Int): Void
  var stack = mir_ctx_get_loop_stack(ctx)
  var entry = MirLoopEntry { label: label, break_block: break_block, continue_block: continue_block, scope_depth: scope_depth, wrap_depth: wrap_depth }
  stack.push(entry)
end

def mir_ctx_pop_loop(ctx: MirContext): Void
  var stack = mir_ctx_get_loop_stack(ctx)
  if stack.size > 0
    stack.pop
  end
end

def mir_ctx_find_loop_break(ctx: MirContext, label: String): MirBlock
  var stack = mir_ctx_get_loop_stack(ctx)
  var i = stack.size - 1
  while i >= 0
    var entry = stack[i]
    if entry.label == label
      return entry.break_block
    end
    i -= 1
  end
  return 0
end

def mir_ctx_find_loop_continue(ctx: MirContext, label: String): MirBlock
  var stack = mir_ctx_get_loop_stack(ctx)
  var i = stack.size - 1
  while i >= 0
    var entry = stack[i]
    if entry.label == label
      return entry.continue_block
    end
    i -= 1
  end
  return 0
end

def mir_ctx_find_loop_scope_depth(ctx: MirContext, label: String): Int
  var stack = mir_ctx_get_loop_stack(ctx)
  var i = stack.size - 1
  while i >= 0
    var entry = stack[i]
    return entry.scope_depth if entry.label == label
    i -= 1
  end
  return -1
end

def mir_ctx_find_loop_wrap_depth(ctx: MirContext, label: String): Int
  var stack = mir_ctx_get_loop_stack(ctx)
  var i = stack.size - 1
  while i >= 0
    var entry = stack[i]
    return entry.wrap_depth if entry.label == label
    i -= 1
  end
  return -1
end

def mir_ctx_get_program(ctx: MirContext): Vec = ctx.program

# B.15d/N3.1 step-4c — `func` is `Option<MirFunc>`. The hot-path getter unwraps
# to a real MirFunc: every read happens during lowering, AFTER mir_ctx_set_func
# has installed `Some(f)`, so the `None` construction state is never observed
# here. Keeping the `MirFunc` return type leaves all ~40 readers (and the
# save/restore call sites) unchanged — the Option lives entirely inside the slot.
def mir_ctx_get_func(ctx: MirContext): MirFunc = ctx.func.unwrap()

def mir_ctx_set_func(ctx: MirContext, func: MirFunc): Void
  ctx.func = Option::Some(func)
end

def mir_ctx_get_block(ctx: MirContext): MirBlock = ctx.block

def mir_ctx_set_block(ctx: MirContext, block: MirBlock): Void
  ctx.block = block
end

def mir_ctx_get_bindings(ctx: MirContext): Vec = ctx.bindings

def mir_ctx_bind_var(ctx: MirContext, name: String, value_id: Int): Void
  var bindings = mir_ctx_get_bindings(ctx)
  var binding = [name, value_id]
  bindings.push(binding)
end

def mir_ctx_get_next_slot(ctx: MirContext): Int = ctx.next_slot

def mir_ctx_alloc_slot(ctx: MirContext): Int
  var slot = ctx.next_slot
  ctx.next_slot = slot + 1
  return slot
end

def mir_ctx_lookup_var(ctx: MirContext, name: String): Int
  var bindings = mir_ctx_get_bindings(ctx)
  var i = bindings.size - 1
  while i >= 0
    var binding = bindings[i]
    var bind_name = as_string(binding[0])
    return binding[1] if bind_name == name
    i -= 1
  end
  return -1  # Not found
end

def mir_ctx_set_break_target(ctx: MirContext, block: MirLabel): Void
  ctx.break_target = block
end

def mir_ctx_get_break_target(ctx: MirContext): Int = ctx.break_target

def mir_ctx_set_continue_target(ctx: MirContext, block: MirLabel): Void
  ctx.continue_target = block
end

def mir_ctx_get_continue_target(ctx: MirContext): Int = ctx.continue_target

def mir_ctx_next_lambda(ctx: MirContext): Int
  var n = ctx.lambda_counter
  ctx.lambda_counter = n + 1
  return n
end

def mir_ctx_set_module(ctx: MirContext, module_name: String): Void
  ctx.module_name = module_name
end

def mir_ctx_get_module(ctx: MirContext): String = ctx.module_name

def mir_ctx_set_all_funcs(ctx: MirContext, all_funcs: Vec<ResolverEntry>): Void
  ctx.all_funcs = all_funcs
  # INC.1.12 — build name → index map for O(1) lookups. Walk in order; on
  # name collision, the first-occurrence wins to preserve the previous
  # `mir_lookup_function` semantics (linear scan returned the first
  # match in vec order). Tag-0 (functions) and tag-10 (extern fns) are
  # both indexed because the legacy lookup matched either.
  var idx_map = ctx.all_funcs_by_name
  for i in 0..all_funcs.size
    var entry = all_funcs[i]
    var tag = entry.tag
    if tag == 0 or tag == 10
      if not idx_map.has(entry.name)
        idx_map.set(entry.name, i)
      end
    end
  end
end

def mir_ctx_get_all_funcs(ctx: MirContext): Vec<ResolverEntry> = ctx.all_funcs

def mir_ctx_get_generic_bounded_funcs(ctx: MirContext): Vec<BoundedGenericFunc> = ctx.generics.generic_bounded_funcs
def mir_ctx_get_pending_specs(ctx: MirContext): Vec<PendingSpec> = ctx.generics.pending_specs
def mir_ctx_get_spec_current_type(ctx: MirContext): String = ctx.generics.spec_current_type
def mir_ctx_set_spec_current_type(ctx: MirContext, t: String): Void
  ctx.generics.spec_current_type = t
end

def mir_ctx_get_spec_current_module_prefix(ctx: MirContext): String = ctx.generics.spec_current_module_prefix
def mir_ctx_set_spec_current_module_prefix(ctx: MirContext, p: String): Void
  ctx.generics.spec_current_module_prefix = p
end
def mir_ctx_get_impl_current_type(ctx: MirContext): String = ctx.generics.impl_current_type
def mir_ctx_set_impl_current_type(ctx: MirContext, t: String): Void
  ctx.generics.impl_current_type = t
end

## Per-param type tracking API for multi-type structural dispatch
def mir_ctx_set_spec_param_types(ctx: MirContext, types: Vec): Void
  ctx.generics.spec_param_types = types
end
def mir_ctx_clear_spec_param_types(ctx: MirContext): Void
  ctx.generics.spec_param_types = vec_new()
end
def mir_ctx_lookup_spec_param_type(ctx: MirContext, param_name: String): String
  var types = ctx.generics.spec_param_types
  var count = types.size
  for i in 0..count
    var entry = types[i]
    var name = as_string(entry[0])
    if name == param_name
      return as_string(entry[1])
    end
  end
  return ""
end

## Resolve a type name through the current specialization context.
## If type_name is a type param name (e.g., "T") mapped in spec_param_types,
## returns the concrete type (e.g., "Int"). Handles generic args like "Vec<T>".
## Returns type_name unchanged if no substitution applies.
def mir_resolve_type_param(ctx: MirContext, type_name: String): String
  if str_byte_len(type_name) == 0
    return ""
  end
  # Direct lookup: "T" → "Int"
  var concrete = mir_ctx_lookup_spec_param_type(ctx, type_name)
  if str_byte_len(concrete) > 0
    return concrete
  end
  # Check for generic args: "Vec<T>" → substitute inner type param
  var lt = __char_index(type_name, '<')
  if lt > 0
    var gt = __char_index(type_name, '>')
    if gt > lt
      var outer = str_byte_slice(type_name, 0, lt)
      var inner = str_byte_slice(type_name, lt + 1, gt)
      var resolved_inner = mir_resolve_type_param(ctx, inner)
      if resolved_inner != inner
        return outer.concat("<".concat(resolved_inner.concat(">")))
      end
    end
  end
  return type_name
end

## Substitute type parameter names in a type string using an explicit mapping.
## `mapping` is a Vec of [param_name: String, concrete: String] pairs.
## Handles nested generics: substitutes recursively inside `<...>`.
##
## Example: mir_subst_type_with_map("MapDoubler<I>", [["I", "RangeSrc"]])
##          → "MapDoubler<RangeSrc>"
def mir_subst_type_with_map(type_name: String, mapping: Vec): String
  if str_byte_len(type_name) == 0
    return ""
  end
  if mapping.size == 0
    return type_name
  end
  # Direct lookup: "I" → "RangeSrc"
  var mc = mapping.size
  for mi in 0..mc
    var mentry = mapping[mi]
    var mname = as_string(mentry[0])
    if mname == type_name
      return as_string(mentry[1])
    end
  end
  # Nested generic: "Outer<Inner>" — substitute inside
  var lt = __char_index(type_name, '<')
  if lt > 0
    var gt = __char_index(type_name, '>')
    if gt > lt
      var outer = str_byte_slice(type_name, 0, lt)
      var inner = str_byte_slice(type_name, lt + 1, gt)
      var resolved_inner = mir_subst_type_with_map(inner, mapping)
      if resolved_inner != inner
        return outer.concat("<".concat(resolved_inner.concat(">")))
      end
    end
  end
  return type_name
end

## A.45 — bind a BARE type-param return (`def unwrap(): T`) from a concrete
## generic receiver. `def unwrap(): T` in `extend Option` returns `Option<T>`'s
## `T`, which lives on the enum decl, not the method, with no parameter to unify
## against (self is implicit). When the receiver's tracked type is a concrete
## generic instance (`Option<SF>`), align the receiver base's declared params
## (`[T]`) with its type args (`[SF]`) and, if `ret_type` IS one of those param
## names, return the matching concrete (`SF`). Otherwise return `ret_type`
## verbatim — so concrete returns (`Int`, `Void`) and unbindable params are
## untouched. This is deliberately surgical: it only fires for a bare-param
## return on a concrete generic receiver, leaving every other call's recorded
## type exactly as before. Without it the binding's type stays `T`, field access
## loses the receiver's struct type, and MIR falls back to a global field-name→
## offset table that silently reads the wrong offset (heap corruption when two
## structs share a field name at different offsets).
## item 26 (F4 cow @value) — bind a bare type-param return `T` directly to a
## value-parameter argument annotated EXACTLY `T` (identity/passthrough generic,
## `def id<T>(t: T): T`), returning that arg's inferred type ONLY when it is a
## COW-layout @value struct. Returns "" otherwise so the caller falls through to
## the unchanged container-extraction path (mir_bind_bare_param_return). The
## cow-layout gate makes this INERT for all non-@value generics (byte-identical
## IR), confining the fix to the off-by-one the cow header-skip needs.
def mir_bind_bare_param_return_cow(ctx: MirContext, s: ast::AstStorage, call_node: AstNodeId, func_ast_store: ast::AstStorage, func_handle: AstNodeId, ret_type: String): String
  # Only an actual generic function can have a bare type-param return to bind.
  # Non-generic callees (the overwhelming majority) bail here before touching
  # the param vector — keeps this off the hot non-generic call path.
  var tp_csv = ast::ast_func_type_params(func_ast_store, func_handle)
  if str_byte_len(tp_csv) == 0
    return ""
  end
  var func_params = ast::ast_get_left(func_ast_store, func_handle)
  if func_params <= 0
    return ""
  end
  var fparam_count = vec_size(func_params)
  var call_args = ast::ast_get_children(s, call_node)
  if call_args == 0
    return ""
  end
  var arg_count = call_args.size
  for pi in 0..fparam_count
    var fparam = func_params[pi]
    var pann = ast::ast_get_str2(func_ast_store, fparam)
    if pann == ret_type and pi < arg_count
      var arg_node = call_args[pi]
      var arg_type = mir_infer_expr_type(ctx, s, arg_node)
      if str_byte_len(arg_type) > 0
        var at_base = arg_type
        var at_lt = __char_index(at_base, '<')
        if at_lt > 0
          at_base = str_byte_slice(at_base, 0, at_lt)
        end
        var at_resolved = mir_resolve_struct_name(ctx, at_base)
        if mir_value_is_cow_layout(ctx, at_resolved) == 1
          return arg_type
        end
      end
    end
  end
  return ""
end

def mir_bind_bare_param_return(ctx: MirContext, s: ast::AstStorage, call_node: AstNodeId, ret_type: String): String
  var call_args = ast::ast_get_children(s, call_node)
  if call_args == 0
    return ret_type
  end
  if call_args.size == 0
    return ret_type
  end
  var recv_type = mir_infer_expr_type(ctx, s, call_args[0])
  if str_byte_len(recv_type) == 0
    return ret_type
  end
  var rlt = __char_index(recv_type, '<')
  if rlt <= 0
    return ret_type
  end
  var base = str_byte_slice(recv_type, 0, rlt)
  var decl = mir_get_struct_type_params(base)
  if str_byte_len(decl) == 0
    return ret_type
  end
  var base_pnames = mir_struct_type_param_names(decl)
  var recv_args = mir_type_args_of(recv_type)
  var n = base_pnames.size
  if recv_args.size < n
    n = recv_args.size
  end
  for i in 0..n
    if base_pnames[i] == ret_type
      return recv_args[i]
    end
  end
  return ret_type
end

## Substitute type parameters in a function's declared return type using the
## caller's inferred argument types at a call site. Used by `var x = f(args)`
## type tracking to record the concrete return type (e.g. `MapDoubler<RangeSrc>`)
## instead of the raw declared return (`MapDoubler<I>`).
##
## Returns the substituted return type, or the raw return type if no
## substitution applies (non-generic function, empty type params, etc.).
def mir_subst_return_type_for_call(ctx: MirContext, s: ast::AstStorage, call_node: AstNodeId, func_ast_store: ast::AstStorage, func_handle: AstNodeId): String
  var ret_type = ast::ast_get_str2(func_ast_store, func_handle)
  if str_byte_len(ret_type) == 0
    return ""
  end
  # A.45: a return whose type is a BARE type-param name (no `<`) — `def
  # unwrap(): T` — erases the receiver's concrete type under the original code,
  # which returned `T` verbatim. Bind it from a concrete generic receiver. This
  # branch is the only behavioral change; the generic (`<`-bearing) path below
  # is byte-identical to the original to avoid disturbing bounded-generic,
  # iterator, and record/intersection monomorphization.
  if __char_index(ret_type, '<') < 0
    # item 26 (F4 cow @value) — IDENTITY/passthrough monomorphization. When the
    # bare return param `T` is also the EXACT annotation of a value parameter
    # (`def id<T>(t: T): T`), the concrete return type is that arg's type
    # DIRECTLY (not a container's type-arg, which is the case mir_bind_bare_param_return
    # handles). Without this, `var r = id(Q{..})` over a >16B cow @value Q tracks
    # `r` as the bare "T", so the field-access cow header-skip (mir_lower.qz
    # NODE_FIELD_ACCESS, gated on mir_value_is_cow_layout) never fires and r.a/r.b/r.c
    # read off-by-one (word0 = refcount header instead of word1). GATED on the
    # resolved arg type being COW-layout @value ⇒ INERT for every non-@value
    # generic (predicate false ⇒ falls through to the original
    # mir_bind_bare_param_return path, byte-identical) — the compiler uses generics
    # heavily over non-@value types, so this confinement is the safety property.
    var cow_id = mir_bind_bare_param_return_cow(ctx, s, call_node, func_ast_store, func_handle, ret_type)
    if str_byte_len(cow_id) > 0
      return cow_id
    end
    return mir_bind_bare_param_return(ctx, s, call_node, ret_type)
  end
  var tp_csv = ast::ast_func_type_params(func_ast_store, func_handle)
  if str_byte_len(tp_csv) == 0
    return ret_type
  end
  var func_params = ast::ast_get_left(func_ast_store, func_handle)
  if func_params < 0
    return ret_type
  end
  var fparam_count = vec_size(func_params)
  var call_args = ast::ast_get_children(s, call_node)
  if call_args == 0
    return ret_type
  end
  var arg_count = call_args.size
  var tp_names_raw = str_split(tp_csv, ",")
  var tp_count = tp_names_raw.size
  # type-param names may carry spaces from a "T, U" list — trim once so both the
  # unify comparisons and the mapping keys (which mir_subst_type_with_map matches
  # verbatim against the return-type substring) are clean.
  var tp_names = vec_new<String>()
  for _ti in 0..tp_count
    tp_names.push(str_trim(tp_names_raw[_ti]))
  end
  # Payload de-erasure Phase 2 (Path A, landed) — bind the function-level type
  # params so a generic `<`-bearing return with an EXPLICIT type-arg
  # (`first_of<Point>(...)`) keeps its concrete payload at the call site instead
  # of erasing to `Option<T>`. Without this the return erased → the Some-bind read
  # a scalar as a pointer → the option_boxed_struct_niche SIGSEGV. Inference from a
  # WRAPPED arg (`first_of(ps)` → T from `Vec<Point>`) is deliberately NOT done
  # here — a structural-unification attempt regressed FocusRing (see the fallback
  # note below); it is deferred to the de-erasure tail.
  var mapping = vec_new()
  # Path A — explicit type args. `ast_get_type_arg` yields the comma-separated
  # inner list ("Point" or "Point, Int"); wrap + reuse the depth-aware splitter.
  var _cta = ast::ast_get_type_arg(s, call_node)
  if str_byte_len(_cta) > 0
    var _cta_args = mir_type_args_of("Q<#{_cta}>")
    var _cta_n = _cta_args.size
    var _cti = 0
    while _cti < tp_count and _cti < _cta_n
      var _ca = _cta_args[_cti]
      if str_byte_len(_ca) > 0
        mapping.push([as_int(tp_names[_cti]), as_int(_ca)])
      end
      _cti += 1
    end
  end
  # Fallback — infer from argument types, but ONLY the pre-Phase-2 exact-match
  # (a param annotated EXACTLY with the type-param name, `def f<T>(t: T)`). The
  # broader wrapped-`Base<T>` structural unification was tried and REVERTED: it
  # over-bound inferred generic-Option returns (e.g. FocusRing's
  # `focus_ring_current`), changing their resolved return type and regressing all
  # of tui_focus_ring_spec. Explicit type-args (Path A above) cover the landed
  # scope (`first_of<Point>(...)`); inferred-from-wrapped-arg de-erasure
  # (`first_of(ps)`) is deferred to the de-erasure tail — see
  # docs/design/PAYLOAD_TYPE_DEERASURE.md.
  if mapping.size == 0
    for tpi in 0..tp_count
      var tp_name = tp_names[tpi]
      for pi in 0..fparam_count
        if pi < arg_count
          var fparam = func_params[pi]
          var pann = ast::ast_get_str2(func_ast_store, fparam)
          if pann == tp_name
            var arg_type = mir_infer_expr_type(ctx, s, call_args[pi])
            if str_byte_len(arg_type) > 0
              mapping.push([as_int(tp_name), as_int(arg_type)])
            end
          end
        end
      end
    end
  end
  if mapping.size == 0
    return ret_type
  end
  return mir_subst_type_with_map(ret_type, mapping)
end

## Iterator-bound parameter tracking for closure-based dispatch
def mir_ctx_get_iterator_bound_params(ctx: MirContext): Vec<String> = ctx.iterator_bound_params
def mir_ctx_set_iterator_bound_params(ctx: MirContext, params: Vec<String>): Void
  ctx.iterator_bound_params = params
end
def mir_ctx_clear_iterator_bound_params(ctx: MirContext): Void
  ctx.iterator_bound_params = vec_new<String>()
  # item 42f — also clear the per-function arena-owned-var set + COW field-shift flag
  # at gen ($poll) function entries (which reset state through this path, not
  # reset_struct_types). GATE-0-INERT (both already empty/0 at gate 0). Idempotent.
  mir_ctx_reset_arena_state(ctx)
end
def mir_ctx_is_iterator_bound_param(ctx: MirContext, name: String): Int
  var params = ctx.iterator_bound_params
  var count = params.size
  for i in 0..count
    if params[i].eq(name)
      return 1
    end
  end
  return 0
end



## Check if a bounds string contains only Iterator bounds.
## Bounds format: "T:Iterator" or "T:Iterator,U:Iterator" etc.
## Returns 1 if ALL bounds are Iterator-only, 0 if any non-Iterator bound exists.
def mir_has_only_iterator_bounds(bounds_str: String): Int
  if str_byte_len(bounds_str) == 0
    return 0
  end
  # Split on comma and check each bound
  var parts = str_split(bounds_str, ",")
  var count = parts.size
  for i in 0..count
    var b = parts[i]
    # Each bound is "T:TraitName" or "T:TraitName<Args>" — check trait base
    var colon = __char_index(b, ':')
    if colon < 0
      return 0
    end
    var trait_name = str_byte_slice(b, colon + 1, str_byte_len(b))
    # Strip generic args off trait name: `Iterator<Int>` -> `Iterator`.
    var trait_lt = __char_index(trait_name, '<')
    if trait_lt > 0
      trait_name = str_byte_slice(trait_name, 0, trait_lt)
    end
    if not trait_name.eq("Iterator")
      return 0
    end
  end
  return 1
end

## Extract Iterator-bounded param names from a bounds string.
## E.g. "T:Iterator,U:Iterator" -> ["T", "U"]
def mir_get_iterator_param_names(bounds_str: String): Vec<String>
  var result = vec_new<String>()
  if str_byte_len(bounds_str) == 0
    return result
  end
  var parts = str_split(bounds_str, ",")
  var count = parts.size
  for i in 0..count
    var b = parts[i]
    var colon = __char_index(b, ':')
    if colon > 0
      var trait_name = str_byte_slice(b, colon + 1, str_byte_len(b))
      # Strip generic args off trait name: `Iterator<Int>` -> `Iterator`.
      var trait_lt = __char_index(trait_name, '<')
      if trait_lt > 0
        trait_name = str_byte_slice(trait_name, 0, trait_lt)
      end
      if trait_name.eq("Iterator")
        var param_name = str_byte_slice(b, 0, colon)
        result.push(param_name)
      end
    end
  end
  return result
end

## Check if a function is in the iterator_bounded_funcs list.
## Returns the entry if found, 0 otherwise.
def mir_lookup_iterator_bounded(ctx: MirContext, name: String): Option<BoundedGenericFunc>
  var gbf = mir_ctx_get_generic_bounded_funcs(ctx)
  var count = gbf.size
  for i in 0..count
    var entry = gbf[i]
    # iter_tag == 1 marks iterator-bounded entries
    if entry.iter_tag == 1
      if entry.base_name.eq(name) or entry.mangled.eq(name)
        return Option::Some(entry)
      end
    end
  end
  return Option::None
end

## Check if a variable name is a global variable.
## Uses the global registry stored in context slot 18.
##
## Parameters:
##   ctx  - MIR context
##   name - Variable name to check
##
## Returns: 1 if global, 0 if not
def mir_ctx_is_global(ctx: MirContext, name: String): Int
  var global_registry = ctx.global_registry
  return 0 if global_registry.size == 0
  var global_names = global_registry[0]
  return 1 if any?(global_names, gn: Int -> as_string(gn).eq(name))
  return 0
end

## Find the full prefixed name of a global variable from a bare name.
## When a function in module "dep_graph" references "_dg_modules", the global
## is registered as "dep_graph$_dg_modules". This function resolves bare names
## by first checking the current module prefix, then falling back to suffix match.
##
## Returns: The full global name, or "" if not found.
def mir_find_global_name(ctx: MirContext, bare_name: String): String
  var global_registry = ctx.global_registry
  return "" if vec_size(global_registry) == 0
  var global_names = global_registry[0]
  var gcount = vec_size(global_names)
  # First: try current module prefix (most common case)
  var module_name = mir_ctx_get_module(ctx)
  if str_byte_len(module_name) > 0
    var prefixed = str_concat(module_name, str_concat("$", bare_name))
    for i in 0..gcount
      var gn = as_string(global_names[i])
      if str_eq(gn, prefixed)
        return gn
      end
    end
  end
  # Second: exact match (for main module globals without prefix)
  for j in 0..gcount
    var gn = as_string(global_names[j])
    if str_eq(gn, bare_name)
      return gn
    end
  end
  # Third: suffix match (fallback for cross-module scenarios)
  var suffix = str_concat("$", bare_name)
  for k in 0..gcount
    var gn = as_string(global_names[k])
    if str_ends_with(gn, suffix)
      return gn
    end
  end
  return ""
end

## Look up the declared type-annotation of the current function's parameter by name.
## Reads from `mir_func_get_param_type_name`, the same registry that primitive
## marking (`mir_ctx_mark_string_var` / `mir_ctx_mark_float_var`) consults — but
## exposes the raw annotation string for primitives like "Int" / "Bool" that
## aren't tracked in the struct_types registry (the param walk in
## mir_lower_function_with_name explicitly skips Int/Bool/String/Void there).
## Used as a fallback in `mir_infer_expr_type`'s NODE_IDENT path so UFCS-rewrite
## on Int/Bool params (e.g. `def f(ms: Int); ms.to_s()`) can resolve receiver
## types when TC body-walks were skipped under an incremental cache hit.
##
## Returns the type-name annotation, or "" if the name isn't a parameter of
## the current function.
def mir_ctx_lookup_param_type(ctx: MirContext, name: String): String
  var func = mir_ctx_get_func(ctx)
  return "" if func == 0
  var params = mir_func_get_params(func)
  return "" if vec_size(params) == 0
  var pcount = vec_size(params)
  for i in 0..pcount
    if as_string(params[i]) == name
      return mir_func_get_param_type_name(func, i)
    end
  end
  return ""
end

## Look up the type annotation of a global variable by name. The global registry
## carries each global's str2 type annotation in slot[2] alongside names (slot[0])
## and inits (slot[1]). Used by `mir_infer_expr_type`'s NODE_IDENT path as a
## fallback when local-var lookup misses, and by `mir_lower_call`'s UFCS rewrite
## fallback to identify global-var receivers like `_spin_frames_registry: Vec<...>`.
##
## Returns the type annotation string ("Vec<Vec<String>>", "Map<String, Int>", ...)
## or "" if the name isn't a known global. Tries exact name first, then falls
## back to module-prefix resolution via mir_find_global_name.
def mir_ctx_lookup_global_type(ctx: MirContext, name: String): String
  var global_registry = ctx.global_registry
  return "" if vec_size(global_registry) < 3
  var global_names = global_registry[0]
  var global_types = global_registry[2]
  var gcount = vec_size(global_names)
  for i in 0..gcount
    var gn = as_string(global_names[i])
    if str_eq(gn, name)
      return as_string(global_types[i])
    end
  end
  # Fallback: resolve bare names (e.g., `_spin_frames_registry`) to their
  # module-prefixed form (`progress$_spin_frames_registry`) and look up the
  # prefixed entry. Mirrors mir_find_global_name's resolution policy.
  var full = mir_find_global_name(ctx, name)
  if str_byte_len(full) > 0
    for j in 0..gcount
      var gn2 = as_string(global_names[j])
      if str_eq(gn2, full)
        return as_string(global_types[j])
      end
    end
  end
  return ""
end

## Canonical UFCS method rewrite: map a (receiver_type, method_name) pair to the
## equivalent intrinsic name. Mirrors the TC-side table at
## `typecheck_expr_handlers.qz:2230-2640`. Used by `mir_lower_call` as a fallback
## when typecheck's body-walk was skipped (cached module in incremental mode)
## and the AST still has the raw method name. Returns "" when no canonical form
## exists for this pair (no rewrite applies — caller should leave the call alone).
##
## The TC table is the source of truth; this duplicate exists because MIR runs
## on every function regardless of cache state (mir_lower.qz:5212 — "MIR skip is
## unsafe due to lambda numbering"), but TC body-walks are gated on the recompile
## set (quartz.qz:813). When a global-var UFCS like `_spin_frames_registry.push(x)`
## sits in a cached module that gets re-MIR'd because its containing fragment
## (`__main__.ll`) was invalidated by a sibling module's change, the AST still
## carries the raw `push` method and falls through to `mir_emit_load_var("push")`
## — which produces `load i64, ptr %push` with no alloca, an llc rejection.
def mir_ufcs_canonical(recv_type: String, method: String): String
  if recv_type == "String"
    return match method
      "cmp" => "str_cmp"
      "find" => "str_find"
      "char_at" => "str_codepoint_nth"
      "eq" => "str_eq"
      "concat" => "str_concat"
      "slice" => "str_slice"
      "split" => "str_split"
      "starts_with" => "str_starts_with"
      "ends_with" => "str_ends_with"
      "contains" => "str_contains"
      "downcase" => "str_downcase"
      "upcase" => "str_upcase"
      "trim" => "str_trim"
      "replace" => "str_replace"
      "to_i" => "str_to_int"
      "to_f" => "str_to_f64"
      "hash" => "str_hash"
      "reverse" => "str_reverse"
      "repeat" => "str_repeat"
      "count" => "str_count"
      "size" => "str_size"
      "join" => "str_join"
      "is_empty" => "str_is_empty"
      "substr" => "str_substr"
      "trim_left" => "str_trim_left"
      "trim_right" => "str_trim_right"
      "pad_left" => "str_pad_left"
      "pad_right" => "str_pad_right"
      "chars" => "str_chars"
      "byte_at" => "str_byte_at"
      "byte_slice" => "str_byte_slice"
      "byte_len" => "str_byte_size"
      "byte_size" => "str_byte_size"
      "byte_find" => "str_byte_find"
      "bytes" => "str_bytes"
      _ => ""
    end
  end
  if recv_type == "Vec" or recv_type == "Array"
    return match method
      "push" => "vec_push"
      "pop" => "vec_pop"
      "clear" => "vec_clear"
      "free" => "vec_free"
      "get" => "vec_get"
      "set" => "vec_set"
      "slice" => "slice"
      "get_unchecked" => "vec_get_unchecked"
      "set_unchecked" => "vec_set_unchecked"
      "contains" => "vec_contains"
      "index_of" => "vec_index_of"
      "insert" => "vec_insert"
      "delete" => "vec_delete"
      "join" => "vec_join"
      "reverse" => "vec_reverse"
      "sort" => "vec_sort"
      "sort_by" => "vec_sort_by"
      "size" => "vec_size"
      "shrink_to_fit" => "vec_shrink_to_fit"
      "capacity" => "vec_capacity"
      "truncate" => "vec_truncate"
      "dedup" => "vec_dedup"
      "retain" => "vec_retain"
      "extend" => "vec_extend"
      "clone" => "vec_clone"
      _ => ""
    end
  end
  if recv_type == "Map"
    return match method
      "has" => "map_has"
      "delete" => "map_delete"
      "keys" => "map_keys"
      "values" => "map_values"
      "clear" => "map_clear"
      "get" => "map_get"
      "set" => "map_set"
      "insert" => "map_insert"
      "free" => "map_free"
      "size" => "map_size"
      "contains" => "map_has"
      _ => ""
    end
  end
  if recv_type == "Set"
    return match method
      "add" => "set_add"
      "delete" => "set_delete"
      "has" => "set_has"
      "clear" => "set_clear"
      "members" => "set_members"
      "size" => "set_size"
      "free" => "set_free"
      "union" => "set_union"
      "intersection" => "set_intersection"
      "difference" => "set_difference"
      "is_subset" => "set_is_subset"
      _ => ""
    end
  end
  if recv_type == "StringBuilder"
    return match method
      "size" => "sb_size"
      "append" => "sb_append"
      "append_int" => "sb_append_int"
      "append_char" => "sb_append_char"
      "clear" => "sb_clear"
      "free" => "sb_free"
      "to_string" => "sb_to_string"
      _ => ""
    end
  end
  if recv_type == "Slice" or recv_type == "SliceMut"
    return match method
      "size" => "slice_size"
      "len" => "slice_size"
      "get" => "slice_get"
      "set" => "slice_set"
      _ => ""
    end
  end
  if recv_type == "Int"
    return match method
      "to_s" => "str_from_int"
      "to_f64" => "to_f64"
      "to_f32" => "to_f32"
      _ => ""
    end
  end
  if recv_type == "F64" or recv_type == "F32"
    return match method
      "to_i" => "to_int"
      "to_s" => "f64_to_str"
      _ => ""
    end
  end
  return ""
end

## Look up a function by name and return [ast_store, func_handle] or 0 if not found.
## Skips global variables (entry[3] == 1).
##
## Parameters:
##   ctx       - MIR context
##   func_name - Name of function to find
##
## Returns: Vector [ast_store, func_handle] or 0 if not found
def mir_lookup_function(ctx: MirContext, func_name: String): Option<ResolverEntry>
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  return Option::None if all_funcs == 0
  # INC.1.12 — O(1) lookup via name index built in mir_ctx_set_all_funcs.
  # Replaces the prior per-call O(all_funcs.size) linear scan.
  var idx_map = ctx.all_funcs_by_name
  if idx_map.has(func_name)
    var idx = idx_map.get(func_name).unwrap_or(-1)
    if idx >= 0 and idx < all_funcs.size
      return Option::Some(all_funcs[idx])
    end
  end
  return Option::None
end

# Check if a function has arity overloads (multiple entries with same name, different param count)
def mir_has_arity_overload(all_funcs: Vec<ResolverEntry>, name: String): Int
  var count = all_funcs.size
  var first_pc = -1
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      if entry.name == name
        var store = entry.ast_store
        var handle = entry.node_id
        var params = ast::ast_get_left(store, handle)
        var pc = 0
        if params >= 0
          pc = vec_size(params)
        end
        if first_pc < 0
          first_pc = pc
        else
          if pc != first_pc
            return 1
          end
        end
      end
    end
  end
  return 0
end

# Find a function entry with matching name and param count
def mir_find_arity_match(all_funcs: Vec<ResolverEntry>, name: String, arg_count: Int): Option<ResolverEntry>
  var count = all_funcs.size
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      if entry.name == name
        var store = entry.ast_store
        var handle = entry.node_id
        var params = ast::ast_get_left(store, handle)
        var pc = 0
        if params >= 0
          pc = vec_size(params)
        end
        if pc == arg_count
          return Option::Some(entry)
        end
      end
    end
  end
  return Option::None
end

# String variable tracking - needed for detecting string ops in a + b
def mir_ctx_get_string_vars(ctx: MirContext): Vec<String> = ctx.string_vars

# Reset string variable tracking for new function scope
# This prevents variable name pollution across functions where a variable
# named 'x' that is a String in one function would incorrectly cause
# an Int variable also named 'x' in another function to be treated as String.
def reset_string_vars(ctx: MirContext): Void
  var new_vars = vec_new<String>()
  ctx.string_vars = new_vars
end

def mir_ctx_mark_string_var(ctx: MirContext, name: String): Void
  var string_vars = mir_ctx_get_string_vars(ctx)
  string_vars.push(name)
end

def mir_ctx_is_string_var(ctx: MirContext, name: String): Int
  var string_vars = mir_ctx_get_string_vars(ctx)
  return 1 if any?(string_vars, sv: Int -> as_string(sv).eq(name))
  return 0
end

# Float variable tracking - needed for detecting float ops in a + b
def mir_ctx_get_float_vars(ctx: MirContext): Vec<String> = ctx.float_vars

def reset_float_vars(ctx: MirContext): Void
  var new_vars = vec_new<String>()
  ctx.float_vars = new_vars
end

def mir_ctx_mark_float_var(ctx: MirContext, name: String): Void
  var float_vars = mir_ctx_get_float_vars(ctx)
  float_vars.push(name)
end

def mir_ctx_is_float_var(ctx: MirContext, name: String): Int
  var float_vars = mir_ctx_get_float_vars(ctx)
  return 1 if any?(float_vars, fv: Int -> as_string(fv).eq(name))
  return 0
end

# Vec element type tracking - needed for width-specialized collection intrinsics
def reset_vec_elem_types(ctx: MirContext): Void
  ctx.vec_elem_types = vec_new()
end

def mir_ctx_mark_vec_elem_type(ctx: MirContext, var_name: String, elem_type: String): Void
  var types = ctx.vec_elem_types
  var entry = [var_name, elem_type]
  types.push(entry)
end

def mir_ctx_get_vec_elem_type(ctx: MirContext, var_name: String): String
  var types = ctx.vec_elem_types
  var i = vec_size(types) - 1
  while i >= 0
    var entry = types[i]
    if as_string(entry[0]).eq(var_name)
      return as_string(entry[1])
    end
    i -= 1
  end
  return ""
end

# Map key type tracking — needed so for-in over a Map can dispatch the
# map_keys intrinsic to the key-type-specialized codegen path (int vs string).
def reset_map_key_types(ctx: MirContext): Void
  ctx.map_key_types = vec_new()
  # Value-type tracking shares the Map's lexical scope discipline; reset it on
  # the same boundaries (every reset_map_key_types call site) so a stale
  # value-type entry can't leak across function scopes.
  ctx.map_value_types = vec_new()
end

def mir_ctx_mark_map_key_type(ctx: MirContext, var_name: String, key_type: String): Void
  var types = ctx.map_key_types
  var entry = [var_name, key_type]
  types.push(entry)
end

def mir_ctx_get_map_key_type(ctx: MirContext, var_name: String): String
  var types = ctx.map_key_types
  var i = vec_size(types) - 1
  while i >= 0
    var entry = types[i]
    if as_string(entry[0]).eq(var_name)
      return as_string(entry[1])
    end
    i -= 1
  end
  return ""
end

# Map VALUE type tracking — the symmetric value-position analog of
# map_key_types. Populated at the same let / map_new / param sites that record
# the key type. Consumed by the `map_set` value-arg niche-expected threading
# (mir_lower_expr_handlers.qz) so a bare `None` (or `Some(struct)`) stored into
# a `Map<K, Option<V>>` value slot niche-constructs to agree with the niche-aware
# read side (§14.4). Inert for non-Option value types. Reset is folded into
# reset_map_key_types (same lexical scope discipline) — no standalone reset.
def mir_ctx_mark_map_value_type(ctx: MirContext, var_name: String, value_type: String): Void
  var types = ctx.map_value_types
  var entry = [var_name, value_type]
  types.push(entry)
end

def mir_ctx_get_map_value_type(ctx: MirContext, var_name: String): String
  var types = ctx.map_value_types
  var i = vec_size(types) - 1
  while i >= 0
    var entry = types[i]
    if as_string(entry[0]).eq(var_name)
      return as_string(entry[1])
    end
    i -= 1
  end
  return ""
end

## Extract the VALUE type (V, the 2nd type arg) from a `Map<K, V>` type string.
## Depth-aware so a nested value type (`Map<String, Option<Point>>` → `Option<Point>`,
## `Map<String, Map<Int, Int>>` → `Map<Int, Int>`) is not truncated. Returns ""
## for non-Map types or a Map with no second type arg. Symmetric to
## mir_extract_generic_element_type (which yields the FIRST arg = K).
def mir_extract_map_value_type(type_str: String): String
  var len = str_byte_len(type_str)
  var lt_pos = -1
  for i in 0..len
    if str_byte_at(type_str, i) == '<'  # '<'
      lt_pos = i
      break
    end
  end
  return "" if lt_pos < 0

  # Find the top-level comma separating K from V (depth-aware), then read V up to
  # the matching top-level '>'.
  var depth = 0
  var comma_pos = -1
  var i2 = lt_pos + 1
  while i2 < len
    var c = str_byte_at(type_str, i2)
    if c == '<'   # '<'
      depth += 1
    elsif c == '>'  # '>'
      if depth == 0
        break
      end
      depth -= 1
    elsif c == ','  # ','
      if depth == 0
        comma_pos = i2
        break
      end
    end
    i2 += 1
  end
  return "" if comma_pos < 0

  var depth2 = 0
  var v_start = comma_pos + 1
  var v_end = len
  var j = v_start
  while j < len
    var c2 = str_byte_at(type_str, j)
    if c2 == '<'  # '<'
      depth2 += 1
    elsif c2 == '>'  # '>'
      if depth2 == 0
        v_end = j
        break
      end
      depth2 -= 1
    end
    j += 1
  end

  var result = str_byte_slice(type_str, v_start, v_end)
  # Trim leading/trailing spaces.
  while str_byte_len(result) > 0 and str_byte_at(result, 0) == ' '
    result = str_byte_slice(result, 1, str_byte_len(result))
  end
  while str_byte_len(result) > 0 and str_byte_at(result, str_byte_len(result) - 1) == ' '
    result = str_byte_slice(result, 0, str_byte_len(result) - 1)
  end
  return result
end

# Struct type tracking - needed for field access resolution
def mir_ctx_get_struct_types(ctx: MirContext): Vec = ctx.struct_types

# Reset struct-type tracking for new function scope. Mirrors the
# `reset_string_vars` / `reset_float_vars` / `reset_vec_elem_types`
# discipline. Without this, a `var p = some_progress` in one function
# leaks into a sibling `def f(p: Int)` where `mir_ctx_get_var_type("p")`
# would return "Progress" instead of "" → callers checking exact type
# (e.g., `mir_is_int_expr` for the NODE_INTERP_STRING desugar) get the
# wrong verdict and skip the type-specialized dispatch.
def reset_struct_types(ctx: MirContext): Void
  ctx.struct_types = vec_new()
  # item 42f — also clear the per-function arena-owned-var set + COW field-shift flag
  # (a function-scope marking that was leaking across functions ⇒ shifted value-layout
  # field reads). GATE-0-INERT (both already empty/0 at gate 0). reset_struct_types is
  # called at every main/actor per-function entry; the gen ($poll) entries route through
  # mir_ctx_clear_iterator_bound_params, which also resets it.
  mir_ctx_reset_arena_state(ctx)
end

def mir_ctx_mark_struct_var(ctx: MirContext, name: String, struct_type: String): Void
  var struct_types = mir_ctx_get_struct_types(ctx)
  var entry = [name, struct_type]
  struct_types.push(entry)
end

## F4c (R6) — mark `name` as an arena-OWNED binding (its value lives in an arena,
## not a COW refcount buffer). Idempotent. Consulted by the COW copy / mutation /
## drop sites to SUPPRESS cow ops on the header-less arena buffer (the ratified
## arena-non-COW carve-out). INERT at gate 0 (callers gate on cow-layout, false
## for plain structs pre-flip).
def mir_ctx_mark_arena_owned(ctx: MirContext, name: String): Void
  return if mir_ctx_is_arena_owned(ctx, name) == 1
  ctx.arena_owned_vars.push(name)
end

## item 42f — clear the per-function arena-owned-var set and the COW field-shift flag.
## `arena_owned_vars` keys flat (offset+0) field reads BY VARIABLE NAME; it is per-
## function scope but was never reset between functions, so an arena-marked `var e` in
## one function (e.g. item-42d `var e = unwrap_err(...)`) leaked the flat-read marking
## onto a LATER function's same-named param (`gve_map_err_fn3(e: GVEErr3)`), making that
## param read its value-layout fields FLAT while a caller (the item-42 combinator
## intercept) passed a COW buffer expecting offset+1 ⇒ fields shifted by the refcount
## word. Reset at every per-function entry alongside `ctx.bindings = vec_new()`.
## GATE-0-INERT: at gate 0 nothing is ever arena-marked and cow_field_shift stays 0, so
## both are already empty/0 at function entry ⇒ clearing them is a no-op ⇒ byte-identical.
def mir_ctx_reset_arena_state(ctx: MirContext): Void
  ctx.arena_owned_vars = vec_new<String>()
  ctx.cow_field_shift = 0
end

## F4c (R6) — 1 iff `name` is an arena-owned binding (see mir_ctx_mark_arena_owned).
def mir_ctx_is_arena_owned(ctx: MirContext, name: String): Int
  for i in 0..ctx.arena_owned_vars.size
    return 1 if ctx.arena_owned_vars[i].eq(name)
  end
  return 0
end

## R-WS3 — mark `name` as a mutable-by-reference capture ("ref-var") in the
## current lambda body: its local slot holds a POINTER to the caller's slot, and
## mir_emit_load_var/store_var auto-indirect through it. Idempotent.
def mir_ctx_bind_ref_var(ctx: MirContext, name: String): Void
  return if mir_ctx_is_ref_var(ctx, name) == 1
  ctx.ref_vars.push(name)
end

## R-WS3 — 1 iff `name` is a ref-var (see mir_ctx_bind_ref_var). Consulted on the
## hot load/store path. INERT at gate 0: ref_vars empty ⇒ always 0.
def mir_ctx_is_ref_var(ctx: MirContext, name: String): Int
  for i in 0..ctx.ref_vars.size
    return 1 if ctx.ref_vars[i].eq(name)
  end
  return 0
end

## R-WS3 — approve a NODE_LAMBDA node id as non-escaping (safe for mut-by-ref
## capture). Set at the whitelisted-HOF call site.
def mir_ctx_approve_nonescaping_lambda(ctx: MirContext, node: Int): Void
  ctx.nonescaping_lambda_nodes.push(node)
end

## R-WS3 — 1 iff the given NODE_LAMBDA node id was approved as non-escaping.
def mir_ctx_is_nonescaping_lambda(ctx: MirContext, node: Int): Int
  for i in 0..ctx.nonescaping_lambda_nodes.size
    return 1 if ctx.nonescaping_lambda_nodes[i] == node
  end
  return 0
end

def mir_ctx_get_var_type(ctx: MirContext, name: String): String
  var struct_types = mir_ctx_get_struct_types(ctx)
  var i = struct_types.size - 1
  while i >= 0
    var entry = struct_types[i]
    var stored_name = as_string(entry[0])
    return as_string(entry[1]) if stored_name == name
    i -= 1
  end
  return ""
end

# Extract the return type from a function-type annotation string.
# Function types are spelled `Fn(P1, P2): Return` (parser.qz:757-829), with
# an optional ` @effect` or ` can ...` row suffix. The return type is the
# substring after the top-level `): ` — found by balancing parens so that
# nested function types in the parameter list (`Fn(Fn(Int): Int): Bool`)
# don't fool a naive substring search.
#
# Returns the return-type string, or "" if `ann` is not a `Fn(` type.
def mir_extract_fn_return_type(ann: String): String
  return "" if str_byte_len(ann) < 4
  return "" if ann.starts_with("Fn(") == false
  # Scan from the `(` at index 2, balancing parens, until depth returns to 0.
  var n = str_byte_len(ann)
  var depth = 0
  var i = 2
  var close_idx = -1
  while i < n
    var ch = str_byte_at(ann, i)
    if ch == 40  # '('
      depth = depth + 1
    elsif ch == 41  # ')'
      depth = depth - 1
      if depth == 0
        close_idx = i
        i = n
      end
    end
    i = i + 1
  end
  return "" if close_idx < 0
  # Expect `: ` immediately after the matching ')'. No `:` → Void-returning
  # function type; field access on its result is a type error, return "".
  var after = close_idx + 1
  return "" if after >= n
  return "" if str_byte_at(ann, after) != 58  # ':'
  var rstart = after + 1
  while rstart < n and str_byte_at(ann, rstart) == 32  # ' '
    rstart = rstart + 1
  end
  return "" if rstart >= n
  # The return type runs to a top-level ` @` (effect bound) or ` can`
  # (effect row) boundary, or end of string.
  var rend = n
  var j = rstart
  var rdepth = 0
  while j < n
    var rc = str_byte_at(ann, j)
    if rc == 40 or rc == 60  # '(' or '<'
      rdepth = rdepth + 1
    elsif rc == 41 or rc == 62  # ')' or '>'
      rdepth = rdepth - 1
    elsif rdepth == 0 and rc == 32  # ' '
      var nxt = str_byte_at(ann, j + 1)
      if nxt == 64  # '@'
        rend = j
        j = n
      elsif j + 3 < n and nxt == 99 and str_byte_at(ann, j + 2) == 97 and str_byte_at(ann, j + 3) == 110  # "can"
        rend = j
        j = n
      end
    end
    j = j + 1
  end
  return str_byte_slice(ann, rstart, rend)
end

# Recursively infer the struct type of an AST expression.
# This enables field access resolution for complex expressions like:
#   r.routes[i].handler  (chained field access + index)
#   handler(req).status  (function call result field access)
#   SockaddrIn { ... }.sin_port  (struct init field access)
#   wrapped(req).body     (closure-valued local: return type from Fn(...) annotation)
#
# Returns the struct type name (possibly cross-module prefixed), or "" if unknown.
def mir_infer_expr_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  return "" if node == 0
  var kind = ast::ast_get_kind(s, node)

  # node_constants$NODE_IDENT = 6: look up variable's tracked struct type
  if kind == node_constants::NODE_IDENT
    var var_name = ast::ast_get_str1(s, node)
    var result = mir_ctx_get_var_type(ctx, var_name)
    # Fallback: check specialization param types (for bounded generic bodies)
    if str_byte_len(result) == 0
      result = mir_ctx_lookup_spec_param_type(ctx, var_name)
    end
    # Fallback: module-level globals — their type annotation lives on the
    # NODE_LET's str2 slot and is captured into the global registry by PASS 0.6.
    # Required for the UFCS-rewrite fallback in mir_lower_call to resolve receivers
    # like `_spin_frames_registry: Vec<Vec<String>>` when TC body-walks were
    # skipped under an incremental cache hit.
    if str_byte_len(result) == 0
      result = mir_ctx_lookup_global_type(ctx, var_name)
    end
    # Fallback: current function's parameters — picks up primitive Int/Bool/F64
    # annotations that the struct_types registry deliberately skips
    # (mir_lower_function_with_name's param walk excludes those types from
    # mir_ctx_mark_struct_var). Required for UFCS-rewrite on bodies like
    # `def f(ms: Int); ms.to_s()` to know `ms` is Int.
    if str_byte_len(result) == 0
      result = mir_ctx_lookup_param_type(ctx, var_name)
    end
    # Resolve type param names (e.g., "T" → "Int") in specialization context
    if str_byte_len(result) > 0
      result = mir_resolve_type_param(ctx, result)
    end
    return result
  end

  # node_constants$NODE_BINARY = 8: arithmetic with same-typed primitive operands
  # propagates the operand type. Mirrors the narrow shape of TC's full type rule;
  # added here so `var s = ms / 1000; s.to_s()` (with `ms: Int` parameter) can
  # resolve `s`'s type via the NODE_LET handler at mir_lower_stmt_handlers:307,
  # which consults mir_infer_expr_type on the init expression. Without this,
  # NODE_BINARY returned "" and `s` ended up untyped, breaking the UFCS-rewrite
  # fallback on cached-module local-var receivers.
  if kind == node_constants::NODE_BINARY
    var bin = ast::ast_extract_binary(s, node)
    var blhs = bin[0]
    var brhs = bin[1]
    var bltype = mir_infer_expr_type(ctx, s, blhs)
    var brtype = mir_infer_expr_type(ctx, s, brhs)
    if str_byte_len(bltype) > 0 and bltype == brtype
      if bltype == "Int" or bltype == "F64" or bltype == "F32"
        return bltype
      end
    end
    # Mixed with Int literal (literal returns "Int" via NODE_INT_LIT branch
    # below): if either side is Int and the other is "" or "Int", propagate.
    if bltype == "Int"
      if str_byte_len(brtype) == 0 or brtype == "Int"
        return "Int"
      end
    end
    if brtype == "Int"
      if str_byte_len(bltype) == 0 or bltype == "Int"
        return "Int"
      end
    end
    return ""
  end

  # node_constants$NODE_FIELD_ACCESS = 15: get base type, then look up field's type
  if kind == node_constants::NODE_FIELD_ACCESS
    var base_node = ast::ast_get_left(s, node)
    var field_name = ast::ast_get_str1(s, node)
    var base_type = mir_infer_expr_type(ctx, s, base_node)
    if str_byte_len(base_type) > 0
      # Strip generic type args for struct registry lookup
      var base_for_lookup = base_type
      var lt_pos = __char_index(base_for_lookup, '<')
      if lt_pos > 0
        base_for_lookup = str_byte_slice(base_for_lookup, 0, lt_pos)
      end
      var resolved = mir_resolve_struct_name(ctx, base_for_lookup)
      var field_type = mir_ctx_get_field_type(ctx, resolved, field_name)
      return field_type
    end
    return ""
  end

  # node_constants$NODE_CALL = 9: look up callee function's return type
  if kind == node_constants::NODE_CALL
    var callee_node = ast::ast_get_left(s, node)
    if callee_node != 0
      var callee_kind = ast::ast_get_kind(s, callee_node)
      if callee_kind == node_constants::NODE_IDENT
        var call_name = ast::ast_get_str1(s, callee_node)
        var resolved_name = mir_resolve_func_name(ctx, call_name)
        var func_entry = mir_lookup_function(ctx, resolved_name)
        # STYLE_RENDER_CONCAT_CORRUPTION fix: when typecheck rewrites a
        # cross-module method call like `Style.success().render("AAA")` to
        # callee `Style$render`, `mir_resolve_func_name` returns it as-is
        # (Case 1: already-qualified). But the registered name is the
        # fully-prefixed `style$Style$render` — exact match fails. Mirror
        # the suffix-search fallback that `mir_lower_call` uses (line ~2914)
        # so type inference sees the same return type that codegen actually
        # dispatches to. Without this, `var s = obj.method()` followed by
        # `s + other` mis-types `s` as Int and emits raw integer add instead
        # of qz_str_concat, producing SEGV / corrupted strings at runtime.
        if func_entry.is_none()
          var all_funcs = mir_ctx_get_all_funcs(ctx)
          if all_funcs != 0
            var suffix = "$#{resolved_name}"
            var af_count = all_funcs.size
            for sfi in 0..af_count
              var sfe = all_funcs[sfi]
              if sfe.tag == 0 and str_ends_with(sfe.name, suffix)
                func_entry = Option::Some(sfe)
                break
              end
            end
          end
        end
        if func_entry.is_some()
          var fe = func_entry.unwrap()
          var func_ast = fe.ast_store
          var func_handle = fe.node_id
          # NESTED-MONO-UFCS-TYPE-PARAM: substitute type params in the declared
          # return type using the caller's inferred arg types, then further
          # resolve through any enclosing specialization context.
          var ret_type = mir_subst_return_type_for_call(ctx, s, node, func_ast, func_handle)
          # item 42 (Part 3) — consumer U-inference for value-layout combinators.
          # `result_map`/`option_map`/`*_and_then` are ERASED: their declared return
          # `Result<U,E>`/`Option<U>` leaves `U` unbound by mir_subst_return_type_for_call
          # (U lives inside the `Fn(T): U` arg, never a top-level param), so a consumer
          # `var r = result_map(...)` tracks `r` as the erased type and reads it via the
          # BOXED spill layout — disagreeing with the inline construct (Part 1). Recover
          # the concrete `U` from the mapping-fn's return type and refine the result to
          # `Result<U,E>` / `Option<U>` so the consumer takes the inline path. GATED on
          # `mir_is_value_layout_type(U)==1` ⇒ DEAD at gate 0 (no type is value-layout ⇒
          # the refinement branch never fires ⇒ byte-identical; the erased type is left
          # unchanged for every non-value-layout case, exactly items 36/40).
          var i42_cop = mir_combinator_op(call_name)
          if i42_cop > 0
            var i42_args = ast::ast_get_children(s, node)
            if i42_args != 0 and i42_args.size == 2
              # The mapping-fn output payload U (new Ok for op 1/3, new Err for op 2).
              var i42_u = mir_combinator_output_payload(ctx, s, i42_cop, i42_args[1])
              if i42_cop == 6 or i42_cop == 7
                # Option combinators: Option<U>, refine only when U is value-layout.
                if str_byte_len(i42_u) > 0
                  var i42_ures = mir_resolve_struct_name(ctx, mir_strip_generic_head(i42_u))
                  if mir_is_value_layout_type(ctx, i42_ures) == 1
                    return "Option<#{i42_u}>"
                  end
                end
              else
                # Result combinators (1/2/3). Output is Result<OkOut, ErrOut>:
                #   op 1 (result_map):     OkOut = U,            ErrOut = subject Err (prop)
                #   op 2 (result_map_err): OkOut = subject Ok (prop), ErrOut = U  (item 42f)
                #   op 3 (result_and_then):OkOut = U,            ErrOut = subject Err (prop)
                # Refine to the CONCRETE Result whenever EITHER side is value-layout, so
                # the consumer's match/unwrap binds the interior address on a value-layout
                # arm (a boxed read of an inline field word ⇒ SIGSEGV). item 42f: covers
                # the new-Err output AND a value-layout Err PROPAGATED through map/and_then
                # whose Ok output is scalar (which left the Err side erased pre-42f).
                var i42_sty = mir_infer_expr_type(ctx, s, i42_args[0])
                var i42_subj_ok = mir_result_ok_type(i42_sty)
                var i42_subj_err = mir_result_err_type(i42_sty)
                var i42_ok_out = ""
                var i42_err_out = ""
                if i42_cop == 2
                  i42_ok_out = i42_subj_ok
                  i42_err_out = i42_u
                else
                  i42_ok_out = i42_u
                  i42_err_out = i42_subj_err
                end
                # Value-layout-ness of each output side (empty/scalar ⇒ not value-layout).
                var i42_ok_vl = 0
                if str_byte_len(i42_ok_out) > 0
                  i42_ok_vl = mir_is_value_layout_type(ctx, mir_resolve_struct_name(ctx, mir_strip_generic_head(i42_ok_out)))
                end
                var i42_err_vl = 0
                if str_byte_len(i42_err_out) > 0
                  i42_err_vl = mir_is_value_layout_type(ctx, mir_resolve_struct_name(ctx, mir_strip_generic_head(i42_err_out)))
                end
                if i42_ok_vl == 1 or i42_err_vl == 1
                  if str_byte_len(i42_ok_out) > 0 and str_byte_len(i42_err_out) > 0
                    return "Result<#{i42_ok_out}, #{i42_err_out}>"
                  end
                end
              end
            end
          end
          return mir_resolve_type_param(ctx, ret_type)
        end
        # CLOSURE-CALL-RETURN-TYPE fix (A.17): the callee ident is not a
        # registered function — it may be a closure-valued local variable,
        # parameter, or global (`var c = with_cors(...); c(req)`). Its tracked
        # type is a `Fn(P): Return` annotation; the call result has type
        # `Return`. Without this, `c(req)` infers "" and a subsequent
        # `.field` access falls through to `mir_find_field_globally`, which
        # silently picks the wrong struct when the field name is ambiguous
        # (e.g. `body` exists in both `Request` and `Response`).
        var callee_decl_type = mir_ctx_get_var_type(ctx, call_name)
        if str_byte_len(callee_decl_type) == 0
          callee_decl_type = mir_ctx_lookup_param_type(ctx, call_name)
        end
        if str_byte_len(callee_decl_type) == 0
          callee_decl_type = mir_ctx_lookup_global_type(ctx, call_name)
        end
        if str_byte_len(callee_decl_type) > 0
          var fn_ret = mir_extract_fn_return_type(callee_decl_type)
          if str_byte_len(fn_ret) > 0
            return mir_resolve_type_param(ctx, fn_ret)
          end
        end
        # N3.2 follow-up #2 — `m.get(k)` infers the CONCRETE `Option<V>`, not the
        # bare "Option" that `mir_intrinsic_return_type` (name-only) yields. The
        # bare form erases V, so a chained `m.get(k).unwrap().field` couldn't thread
        # V through the unwrap niche binder and `.field` fell to the GLOBAL field
        # table (wrong offset on a field-name collision). Recover V from the map
        # receiver the SAME way the map_set value-niche seam does
        # (mir_lower_expr_handlers.qz Phase 2b) and the CONSTRUCTION interception
        # does, so inference (read) and `__map_get_raw` emission (construct) agree on
        # the niche decision (§14.4). Falls back to bare "Option" when V can't
        # resolve (untracked map) ⇒ never a regression. Symmetric for `map_fetch`
        # (panics on miss but still yields V) and the `$map_get` UFCS form.
        var is_map_get = call_name == "map_get" or str_ends_with(call_name, "$map_get") == 1
        if is_map_get == 1
          var mg_args = ast::ast_get_children(s, node)
          if mg_args != 0 and mg_args.size >= 1
            var mg_recv = mg_args[0]
            var mg_v = ""
            if ast::ast_get_kind(s, mg_recv) == node_constants::NODE_IDENT
              mg_v = mir_ctx_get_map_value_type(ctx, ast::ast_get_str1(s, mg_recv))
            end
            if str_byte_len(mg_v) == 0
              var mg_recv_ty = mir_infer_expr_type(ctx, s, mg_recv)
              if str_byte_len(mg_recv_ty) > 0
                mg_v = mir_extract_map_value_type(mg_recv_ty)
              end
            end
            if str_byte_len(mg_v) > 0
              return "Option<#{mg_v}>"
            end
          end
        end
        # Item 11 (enum-niche tail) — `v.pop()` infers the CONCRETE `Option<T>`,
        # mirroring the map_get fix above. Bare "Option" (name-only) erases T so a
        # chained `v.pop().unwrap().field` couldn't thread T through the unwrap niche
        # binder and `.field` fell to the GLOBAL field table (wrong offset on a
        # field-name collision). Recover T from the Vec receiver the SAME two ways
        # the CONSTRUCTION interception does (vec_elem_types registry for an IDENT
        # receiver, else Vec<T>→T from the inferred receiver type) so inference
        # (read) and `__vec_pop_raw_sentinel` emission (construct) agree on the niche
        # decision (§14.10.Q4). Falls back to bare "Option" when T can't resolve ⇒
        # never a regression. Symmetric for the `$vec_pop` UFCS form.
        var is_vec_pop = call_name == "vec_pop" or str_ends_with(call_name, "$vec_pop") == 1
        if is_vec_pop == 1
          var vp_args = ast::ast_get_children(s, node)
          if vp_args != 0 and vp_args.size >= 1
            var vp_recv = vp_args[0]
            var vp_t = ""
            if ast::ast_get_kind(s, vp_recv) == node_constants::NODE_IDENT
              vp_t = mir_ctx_get_vec_elem_type(ctx, ast::ast_get_str1(s, vp_recv))
            end
            if str_byte_len(vp_t) == 0
              var vp_recv_ty = mir_infer_expr_type(ctx, s, vp_recv)
              if str_byte_len(vp_recv_ty) > 0
                vp_t = mir_extract_generic_element_type(vp_recv_ty)
              end
            end
            # Gate the concrete-Option inference on the SAME niche decision the
            # CONSTRUCTION interception uses (mir_lower_call): only when T is
            # niche-eligible does vec_pop lower to the raw-word sentinel, so only
            # then must the read side bind the bare word AS the payload. For
            # non-niche T (and gate-OFF) construction stays a tagged box, so
            # inference MUST stay bare "Option" — flipping to "Option<T>" here
            # while construction stays tagged is the §14.10.Q4 construct/read
            # mismatch (a tagged box misread as a niche word ⇒ garbage / SIGSEGV).
            if str_byte_len(vp_t) > 0 and mir_option_is_niche(ctx, vp_t) == 1
              return "Option<#{vp_t}>"
            end
          end
        end
        # A.45 ii (L1) — `vec_get(v, i)` / `vec_get_unchecked(v, i)` infers the
        # CONCRETE element type T of the Vec receiver, mirroring the index-syntax
        # path (NODE_INDEX below) and TC's `v[i]` element typing. The name-only
        # `mir_intrinsic_return_type` yields bare "Int", which erases the struct
        # identity so a chained `vec_get(v, i).field` falls to the GLOBAL field
        # table (`mir_find_field_globally`) and picks the WRONG offset on a
        # field-name collision between two structs ⇒ reads off the allocation
        # ⇒ nondeterministic heap corruption. Recover T from the Vec receiver the
        # SAME two ways the cow-readout resolver does (vec_elem_types registry for
        # an IDENT receiver, else Vec<T>→T from the inferred receiver type).
        # Conservative/additive: Vec<Int> resolves to "Int" (== the prior bare
        # value — byte-identical); a bare-Vec receiver (untyped vec_new, or a
        # cross-function module-global where T can't resolve) falls through to the
        # "Int" fallback unchanged — that erased case is the harder L2 work,
        # out of scope here.
        var is_vec_get = call_name == "vec_get" or call_name == "vec_get_unchecked" or str_ends_with(call_name, "$vec_get") == 1 or str_ends_with(call_name, "$vec_get_unchecked") == 1
        if is_vec_get == 1
          var vg_args = ast::ast_get_children(s, node)
          if vg_args != 0 and vg_args.size >= 1
            var vg_recv = vg_args[0]
            var vg_recv_ty = mir_infer_expr_type(ctx, s, vg_recv)
            if str_byte_len(vg_recv_ty) > 0
              var vg_resolved = mir_resolve_struct_name(ctx, vg_recv_ty)
              var vg_elem = mir_extract_generic_element_type(vg_resolved)
              return vg_elem if str_byte_len(vg_elem) > 0
              vg_elem = mir_extract_generic_element_type(vg_recv_ty)
              return vg_elem if str_byte_len(vg_elem) > 0
            end
            # bare-Vec receiver: consult the vec_elem_types registry by var name.
            if ast::ast_get_kind(s, vg_recv) == node_constants::NODE_IDENT
              var vg_recv_name = ast::ast_get_str1(s, vg_recv)
              var vg_reg_elem = mir_ctx_get_vec_elem_type(ctx, vg_recv_name)
              return vg_reg_elem if str_byte_len(vg_reg_elem) > 0
            end
          end
        end
        # Fallback: known intrinsic return types
        return mir_intrinsic_return_type(call_name)
      end
    end
    return ""
  end

  # node_constants$NODE_INDEX = 13: array subscript (e.g., routes[i])
  # Infer element type by getting base type and extracting generic parameter
  if kind == node_constants::NODE_INDEX
    var base_node = ast::ast_get_left(s, node)
    var base_type = mir_infer_expr_type(ctx, s, base_node)
    if str_byte_len(base_type) > 0
      # Resolve the base type in case it's a cross-module struct
      var resolved = mir_resolve_struct_name(ctx, base_type)
      # Extract generic element type: Vec<Route> → Route
      var elem_type = mir_extract_generic_element_type(resolved)
      return elem_type if str_byte_len(elem_type) > 0
      # If no generic, try extracting from unresolved name
      elem_type = mir_extract_generic_element_type(base_type)
      return elem_type if str_byte_len(elem_type) > 0
    end
    # Fallback: bare-Vec base (e.g., `v = vec_new<Int>()`) gets tracked as
    # struct_type "Vec" with no <T> suffix, so generic-element extraction
    # above misses. The vec_elem_types registry tracks the element type
    # from the original `vec_new<T>()` call — consult it directly.
    if ast::ast_get_kind(s, base_node) == node_constants::NODE_IDENT
      var base_name = ast::ast_get_str1(s, base_node)
      var ve_type = mir_ctx_get_vec_elem_type(ctx, base_name)
      return ve_type if str_byte_len(ve_type) > 0
    end
    return ""
  end

  # node_constants$NODE_STRUCT_INIT = 14: the struct name is directly available
  if kind == node_constants::NODE_STRUCT_INIT
    var si_name = ast::ast_get_str1(s, node)
    # A.36: for a generic struct with explicit type args (`ITLift<ITBase> {..}`),
    # carry the parameterized form so a downstream `var l = …` binding tracks
    # `ITLift<ITBase>` (not bare `ITLift`). The extend-method monomorphization
    # router needs the concrete args to specialize. Gated on the struct being
    # generic so non-generic instantiations keep returning the bare name.
    var si_args = ast::ast_get_str2(s, node)
    if str_byte_len(si_args) > 0
      if str_byte_len(mir_get_struct_type_params(si_name)) > 0
        return "#{si_name}<#{si_args}>"
      end
    end
    return si_name
  end

  # node_constants$NODE_BINARY_WITH = 96: result type is the receiver's type.
  if kind == node_constants::NODE_BINARY_WITH
    return mir_infer_expr_type(ctx, s, ast::ast_get_left(s, node))
  end

  # node_constants$NODE_ENUM_ACCESS = 39: enum name from str1 (e.g., Status::Ok → "Status")
  if kind == node_constants::NODE_ENUM_ACCESS
    return ast::ast_get_str1(s, node)
  end

  # node_constants$NODE_ALLOC_EXPR = 20: @heap or @arena — look through to inner expression
  if kind == node_constants::NODE_ALLOC_EXPR
    var inner = ast::ast_get_left(s, node)
    return mir_infer_expr_type(ctx, s, inner)
  end

  # Literal nodes: known types
  if kind == node_constants::NODE_STRING_LIT
    return "String"
  end
  if kind == node_constants::NODE_INT_LIT
    return "Int"
  end

  return ""
end

## item 48-a — de-erase a bounded-generic Vec argument's element type.
##
## ROOT: a bounded generic `def total_area<T: Area>(shapes: Vec<T>)` is
## monomorphized with a key built from each argument's inferred type. For a
## `Vec<Circle>` argument the inferred type comes back as the BARE container
## "Vec" — the element `Circle` is erased — so `Vec<Circle>` and `Vec<Square>`
## collapse to the SAME monomorph body (`total_area$1$Vec`). The first
## instantiation's element dispatch (`Circle$area`) then freezes for every
## element type → wrong-dispatch collision.
##
## This helper reconstructs the concrete `Vec<Elem>` form. The element type
## lives in the side registry populated by `vec_new<T>()` lowering, keyed on
## the variable name and read via `mir_ctx_get_vec_elem_type`. When the
## inferred type is a bare `Vec` (a container with no `<…>` element) AND the
## argument expression is a NODE_IDENT whose name has a tracked element type,
## return `Vec<Elem>`; otherwise return `inferred` unchanged.
##
## CRITICAL — mangling lockstep: this single helper is the ONLY de-erasure
## site. It runs at the CALL site while `all_arg_types` is built; that vector
## is stored verbatim into the `PendingSpec`, so the emit-site spec_name
## (`mir_emit_pending_specializations` / `mir_lower_specialized_function`)
## reconstructs a byte-identical key from the same de-erased strings. The two
## sides cannot drift because they consume the same data.
def mir_deerase_vec_arg_type(ctx: MirContext, s: ast::AstStorage, arg_node: AstNodeId, inferred: String): String
  return inferred if str_byte_len(inferred) == 0
  # Only de-erase a bare container — if the inferred type already carries a
  # `<…>` element it is concrete and must pass through untouched.
  return inferred if __char_index(inferred, '<') >= 0
  return inferred if inferred != "Vec"
  return inferred if arg_node == 0
  return inferred if ast::ast_get_kind(s, arg_node) != node_constants::NODE_IDENT
  var arg_name = ast::ast_get_str1(s, arg_node)
  var elem = mir_ctx_get_vec_elem_type(ctx, arg_name)
  return inferred if str_byte_len(elem) == 0
  return "Vec<#{elem}>"
end

## Phase 4D.5b: Generator-detection by return-type annotation.
##
## These predicates replace the runtime registries `_generator_func_names`
## and `_async_gen_func_names` (mir_lower_gen.qz) as the source of truth
## for "is this function a generator?" / "is this an async generator?"
## dispatch. The annotation string is canonical: typecheck rewrites the
## row-poly form `impl Iterator<T> can Async` to `impl AsyncIterator<T>`
## before MIR runs (see typecheck_walk.qz 4D.3 stamp), so a prefix check
## on str2 is sufficient. The same prefix check is the existing dispatch
## in `mir_lower_function_with_name` (mir_lower.qz:3295-3307) — moving
## downstream consumers to the same source eliminates a parallel cache.
##
## `is_async_generator` is a strict subset of `is_generator`: an async
## generator is any function whose return annotation starts with
## "impl AsyncIterator<". A (non-async) generator is one whose return
## annotation starts with "impl Iterator<". `is_generator` returns true
## for both forms (matches the existing `mir_gen_is_generator_function`
## superset semantics — async gens "are also" generators for for-in
## dispatch routing).
def mir_func_annotation_is_async_generator(ann: String): Bool
  if str_byte_len(ann) < 19
    return false
  end
  return ann.starts_with("impl AsyncIterator<")
end

def mir_func_annotation_is_generator(ann: String): Bool
  if mir_func_annotation_is_async_generator(ann)
    return true
  end
  if str_byte_len(ann) < 14
    return false
  end
  return ann.starts_with("impl Iterator<")
end

## Lookup a function's raw return-type annotation by name.
## Returns "" if the function isn't in the resolver's `all_funcs` list
## (e.g. intrinsics, or names that haven't been registered yet). Callers
## that need substituted/resolved types should use `mir_infer_expr_type`
## on a NODE_CALL instead — this helper deliberately returns the raw
## str2 annotation for the prefix-based predicates above.
def mir_func_lookup_annotation(ctx: MirContext, name: String): String
  var entry_opt = mir_lookup_function(ctx, name)
  if entry_opt.is_none()
    return ""
  end
  var entry = entry_opt.unwrap()
  return ast::ast_get_str2(entry.ast_store, entry.node_id)
end

## Return the known return type of a builtin/intrinsic function.
## Used as fallback when mir_lookup_function fails (intrinsics aren't in the AST).
## This enables type tracking through let-bindings like:
##   var parts = str_split("a.b", ".")  # parts is Vec<String>
##   puts(parts.size)                    # .size resolves correctly
def mir_intrinsic_return_type(name: String): String
  # String-returning intrinsics
  return "String" if name == "str_concat"
  return "String" if name == "str_slice"
  return "String" if name == "str_from_int"
  return "String" if name == "str_from_char"
  return "String" if name == "str_from_bytes"
  return "String" if name == "str_downcase"
  return "String" if name == "str_upcase"
  return "String" if name == "str_trim"
  return "String" if name == "str_replace"
  return "String" if name == "str_reverse"
  return "String" if name == "str_repeat"
  return "String" if name == "as_string"
  return "String" if name == "to_s"
  return "String" if name == "bool_to_str"
  return "String" if name == "sb_to_string"
  return "StringBuilder" if name == "sb_new"
  return "StringBuilder" if name == "sb_new_with_capacity"
  return "String" if name == "concat"
  return "String" if name == "read_file"
  return "String" if name == "readline"
  return "String" if name == "getenv"
  # Vec-returning intrinsics
  return "Vec<String>" if name == "str_split"
  return "Vec<String>" if name == "dir_list"
  return "Vec" if name == "vec_new"
  return "Vec" if name == "vec_clone"
  return "Vec" if name == "vec_slice"
  return "Vec" if name == "vec_map"
  return "Vec" if name == "vec_filter"
  return "Vec" if name == "as_vec"
  # Slice-returning intrinsics (Tier 4 #24 Phase 2)
  return "Slice" if name == "slice"
  return "Slice" if name == "subslice"
  return "Slice" if name == "str_as_byte_slice"
  return "Slice" if name == "slice_empty"
  # Map-returning intrinsics
  return "Map" if name == "map_new"
  return "Map" if name == "map_clone"
  # Option-returning intrinsics
  return "Option<Int>" if name == "vec_index_of"
  return "Option<Int>" if name == "regex_match_start"
  return "Option<Int>" if name == "regex_match_end"
  # Int-returning intrinsics (common ones that might be confused with struct).
  # Pre-2026-05-03 these returned "" so the marker wouldn't write a struct
  # entry for the binding (Int isn't a struct, has no fields). Now they
  # return "Int" so `mir_infer_expr_type` can resolve UFCS receivers like
  # `c.to_s()` where `c = str_byte_at(s, i)` lives in a cached module whose
  # TC body-walk was skipped — the UFCS rewrite fallback in mir_lower_call
  # needs the Int annotation to dispatch to `str_from_int`. Codegen field
  # lookups on a "Int"-marked binding fall through harmlessly via the
  # mir_struct_has_narrow_fields gate (Int isn't registered as a struct).
  return "Int" if name == "str_size"
  return "Option<Int>" if name == "str_find"
  return "Int" if name == "vec_size"
  return "Int" if name == "vec_capacity"
  return "Int" if name == "map_has"
  return "Int" if name == "map_size"
  return "Option" if name == "map_get"
  return "Int" if name == "__map_get_raw"
  return "Option" if name == "vec_pop"
  return "Int" if name == "__vec_pop_raw_sentinel"
  return "Int" if name == "str_byte_at"
  return "Int" if name == "str_byte_len"
  return "Int" if name == "str_byte_size"
  return "Int" if name == "time_mono_ns"
  return "Int" if name == "time_mono_ms"
  # `vec_get` / `vec_get_unchecked` mirror TC's typecheck_builtins.qz
  # registration (TYPE_INT). The element type is generic — Vec<String>'s
  # get returns a String — but TC types DIRECT calls as Int (the raw
  # slot value) and only refines via the UFCS-rewrite path
  # `strvec.get(0)` which annotates the NODE_CALL's str2 with the
  # element name. We match TC: returning "Int" lets the let handler at
  # mir_lower_stmt_handlers.qz:280-300 track `var x = vec_get(v, i)`
  # as Int so a subsequent `x.to_s()` UFCS-rewrites to `str_from_int`
  # at MIR level when body-TC was skipped under --cache-ro.
  return "Int" if name == "vec_get"
  return "Int" if name == "vec_get_unchecked"
  # B.10 §14 N2 — NonZero builtins. `nonzero_new` MUST infer as the CONCRETE
  # `Option<NonZero>`, not bare `Option`: a niche value flows as a scalar, so an
  # UNANNOTATED `match nonzero_new(x) { ... }` needs "NonZero" at the read site
  # to niche-decode. Without it the read sees bare "Option" ⇒ spill-loads tag@0
  # from the scalar ⇒ SIGSEGV (the §14.4 construct-niche/read-spill mismatch).
  # The other two are the scalar identities (the value IS its i64).
  return "Option<NonZero>" if name == "nonzero_new"
  return "NonZero" if name == "nonzero_new_unchecked"
  return "Int" if name == "nonzero_get"
  return ""
end

## Look up a bounded generic function by name in the registry.
## Checks both the base name and arity-mangled name.
## Returns the registry entry or 0 if not found.
def mir_lookup_bounded_generic(ctx: MirContext, name: String): Option<BoundedGenericFunc>
  var gbf = mir_ctx_get_generic_bounded_funcs(ctx)
  var count = gbf.size
  for i in 0..count
    var entry = gbf[i]
    if entry.base_name == name or entry.mangled == name
      return Option::Some(entry)
    end
  end
  return Option::None
end

## Check if a function with the given name exists in all_funcs (tag 0).
## Used by trait method rewriting to verify the rewritten name is valid.
def mir_func_exists_in_all_funcs(ctx: MirContext, name: String): Int
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  if all_funcs == 0
    return 0
  end
  var count = all_funcs.size
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      if entry.name == name
        return 1
      end
    end
  end
  return 0
end

## Lower a specialized instance of a bounded generic or structurally-constrained function.
## Creates a new function with the specialized name and sets per-param type mappings
## so that method calls inside the body get rewritten to Type$method.
## arg_types is a Vec<String> of concrete types, one per argument.

# Extract the first generic type parameter from a type string.
# Examples: "Vec<Route>" → "Route", "Map<String, Int>" → "String", "Int" → ""
def mir_extract_generic_element_type(type_str: String): String
  var len = str_byte_len(type_str)
  var lt_pos = -1
  for i in 0..len
    if str_byte_at(type_str, i) == '<'  # '<'
      lt_pos = i
      break
    end
  end
  return "" if lt_pos < 0

  # Find matching '>' or ',' for first param
  var depth = 0
  var start = lt_pos + 1
  var end_pos = len
  for i in start..len
    var c = str_byte_at(type_str, i)
    if c == '<'   # '<'
      depth += 1
    elsif c == '>'  # '>'
      if depth == 0
        end_pos = i
        break
      end
      depth -= 1
    elsif c == ','  # ','
      if depth == 0
        end_pos = i
        break
      end
    end
  end

  var result = str_byte_slice(type_str, start, end_pos)
  # Trim leading/trailing spaces
  if str_byte_len(result) > 0
    if str_byte_at(result, 0) == ' '
      result = str_byte_slice(result, 1, str_byte_len(result))
    end
  end
  if str_byte_len(result) > 0
    if str_byte_at(result, str_byte_len(result) - 1) == ' '
      result = str_byte_slice(result, 0, str_byte_len(result) - 1)
    end
  end
  return result
end

# Struct registry - for resolving field names to indices
def mir_ctx_get_struct_registry(ctx: MirContext): Vec<MirStructDef> = ctx.struct_registry

## Compute the LayoutDescriptor for a registered struct (B.10 Phase 0).
##
## Compute-on-demand over the existing registry — does NOT mutate the registry
## entry, so nothing serialized into struct_defs / the qzmod cache changes.
## Phase 0 always reports today's exact Boxed representation:
##   { Boxed, 8*field_count, 8, [0, 8, 16, ...] (index-addressed) }
## The byte offsets are informational only — the emit path still uses
## index-addressing until Phase 2 converts it.
##
## Lookup is EXACT-match (no borrow-prefix strip) to mirror mir_sizeof_type's
## historical behavior; callers that handle borrow types strip the prefix
## before reaching here. Returns an empty Vec sentinel when `struct_name` is
## not a registered struct (distinct from a registered zero-field struct, whose
## descriptor has size 0).
def mir_struct_layout_descriptor(ctx: MirContext, struct_name: String): Vec
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var field_count = vec_size(entry.field_names)
      var offsets = vec_new()
      for j in 0..field_count
        offsets.push(j * 8)
      end
      return layout::layout_desc_new(layout::LAYOUT_BOXED, 8 * field_count, 8, offsets)
    end
  end
  return vec_new()
end

def mir_ctx_register_struct(ctx: MirContext, struct_name: String, field_names: Vec<String>, field_types: Vec<String>, repr_c: Int, packed: Int, is_value: Int, field_defaults: Vec<Int>, ast_store: ast::AstStorage): Void
  var registry = mir_ctx_get_struct_registry(ctx)
  # Dedupe by name — when a module is reachable through two import paths
  # (e.g., `std/time` direct + `time` transitively via `std/tui/runtime`),
  # the dep-graph produces two ast_stores for the same source file and
  # mir_collect_structs registers the same struct twice. Downstream
  # codegen iterates the registry blindly and emits qz_hash_<Name> /
  # qz_eq_<Name> twice → llc rejects with "invalid redefinition".
  # Closed TUI_DASHBOARD_QZ_HASH_TIME_DURATION_DUP 2026-05-07.
  var existing = registry.size
  for i in 0..existing
    var entry_existing = registry[i]
    var name_existing = entry_existing.name
    if name_existing == struct_name
      return
    end
  end
  var entry = MirStructDef {
    name: struct_name,
    field_names: field_names,
    field_types: field_types,
    repr_c: repr_c,
    packed: packed,
    is_value: is_value,
    field_defaults: field_defaults,
    ast_store: ast_store,
    inline_value: 0,
  }
  registry.push(entry)
end

## Check if a struct is marked @repr(C)
def mir_ctx_is_repr_c(ctx: MirContext, struct_name: String): Int
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      return entry.repr_c
    end
  end
  return 0
end

## Check if a struct is marked @value (stack-allocated)
def mir_ctx_is_value_struct(ctx: MirContext, struct_name: String): Int
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      return entry.is_value
    end
  end
  return 0
end

## B.10 Phase 4 — single source of truth for "would a bare `struct` flip to
## value-layout?". 1 iff `struct_name` is a registered NON-@value, NON-@repr(C)
## struct (repr_c stays FFI-layout-faithful; an explicit @value already takes the
## value path via is_value==1). Consulted ONLY behind mir_default_struct_value_live
## (dead at gate=0), so its verdict has ZERO effect on the inert build — but it is
## the predicate F4 trusts, and every read/field/drop/niche/byval consumer must
## route through it (never re-decide) per the construct/read oracle-agreement rule
## (§14.4 / §14.10.Q4 lesson).
## ⚠ INCOMPLETE — TWO EXCLUSIONS REQUIRED BEFORE F4 FLIP (landmines §7):
##   (a) recursive structs (a field of own type, transitively) → must stay Boxed
##       (back-edge indirection; else unbounded inline size).
##   (b) GC-firewall-mixed structs (raw-bit + tracked-pointer slots) → stay Boxed
##       (reuse the @value firewall classifier ~mir.qz:2598/2636/2657).
## Both are dead-safe to omit at gate=0; they MUST be added before the gate flips.
def mir_default_struct_value_eligible(ctx: MirContext, struct_name: String): Int
  return 0 if str_byte_len(struct_name) == 0
  # Resolve to the canonical registry name FIRST so every caller (construct, copy,
  # byval, drop) classifies the SAME entry — the f4-steps §4 construct/read oracle-
  # agreement rule. Without this a raw name and a resolved name can land on
  # different verdicts (a firewall-mixed struct boxing at construct yet copying at
  # assign → the §4 positional/identity divergence landmine).
  var resolved = mir_resolve_struct_name(ctx, struct_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    if entry.name == resolved
      return 0 if entry.is_value == 1
      return 0 if entry.repr_c == 1
      # item 35 — binary-DSL structs (registered in binary_layout_names) need a
      # fixed boxed layout (encode/decode read fields through a boxed pointer);
      # never flip them to value-layout. Mirrors the @repr(C) exclusion above.
      return 0 if mir_find_binary_layout(mir_ctx_get_program(ctx), resolved) >= 0
      # (a) Recursive-struct exclusion (landmine §7 #a). A struct with a field of
      # its own type (directly, or transitively via mutual recursion A→B→A) cannot
      # be laid out inline — it would have unbounded size. It MUST stay Boxed (the
      # heap pointer provides the back-edge indirection). Walk the field graph from
      # this struct, bounded by the registry size, and exclude if the cycle reaches
      # `resolved` again.
      return 0 if mir_struct_is_recursive(ctx, resolved) == 1
      # (b) GC-firewall-mixed exclusion (landmine §7 #b). A struct that mixes
      # raw-bit scalar slots with tracked-pointer slots cannot be unboxed safely
      # until a scan_map lets a future GC distinguish the slots — so it stays Boxed.
      # NOTE: deliberately NOT mir_prog_struct_is_firewall_safe (that one is
      # @value-gated, returns 0 for plain structs); per-field scan inline here with
      # the same mir_is_scalar_field_type classifier.
      return 0 if mir_struct_fields_mixed_firewall(ctx, resolved) == 1
      return 1
    end
  end
  return 0
end

## F4a — recursive-struct detector for the plain-struct value-layout flip.
## 1 iff `struct_name` reaches itself through a chain of struct-typed fields
## (direct self-field, or a mutual-recursion cycle A→B→A). A recursive struct
## cannot be laid out inline (unbounded size) so it stays Boxed. Bounded BFS over
## the registry: the visited-list caps iterations at reg_len, so no infinite loop.
## Field type names are resolved through mir_resolve_struct_name; non-struct field
## types (scalars, String, Vec/Map/Set handles, generic params) resolve to a name
## that is not in the registry and are skipped as non-recursive edges.
def mir_struct_is_recursive(ctx: MirContext, struct_name: String): Int
  return 0 if str_byte_len(struct_name) == 0
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  var worklist = vec_new<String>()
  var visited = vec_new<String>()
  worklist.push(struct_name)
  # Bound the walk: at most reg_len distinct structs can be visited.
  var guard = 0
  while vec_size(worklist) > 0 and guard <= reg_len
    guard = guard + 1
    var cur = as_string(worklist[vec_size(worklist) - 1])
    worklist = mir_vec_string_pop(worklist)
    # Skip already-visited nodes (cycle guard / dedupe).
    var seen = 0
    for vi in 0..vec_size(visited)
      seen = 1 if as_string(visited[vi]) == cur
    end
    if seen == 0
      visited.push(cur)
      var fields_opt = mir_ctx_get_struct_fields(ctx, cur)
      if fields_opt.is_some()
        var field_types = fields_opt.unwrap().field_types
        for fi in 0..vec_size(field_types)
          var ft = as_string(field_types[fi])
          # A struct field can only be recursive if it is a struct that resolves
          # to a registered name. Scalars / handles resolve to a non-registry name.
          if mir_is_scalar_field_type(ft) == 0
            var resolved_ft = mir_resolve_struct_name(ctx, ft)
            # Direct/transitive hit on the origin struct ⇒ recursive.
            return 1 if resolved_ft == struct_name
            worklist.push(resolved_ft)
          end
        end
      end
    end
  end
  return 0
end

## Pop the last element of a Vec<String>, returning a new Vec without it.
## (Local helper for the bounded recursive walk; avoids relying on a mutating
## vec_pop intrinsic so the walk stays representation-stable.)
def mir_vec_string_pop(v: Vec<String>): Vec<String>
  var out = vec_new<String>()
  var n = vec_size(v)
  return out if n == 0
  for i in 0..(n - 1)
    out.push(as_string(v[i]))
  end
  return out
end

## F4a — GC-firewall mixed-field detector for the plain-struct value-layout flip.
## 1 iff the registry entry mixes raw-bit scalar slots with tracked-pointer slots
## (so a future GC cannot scan the inline block uniformly). Same classifier
## (mir_is_scalar_field_type) as the @value byval/inline firewall, but applied to a
## PLAIN struct entry — mir_prog_struct_is_firewall_safe cannot be reused because
## it requires is_value==1 and returns 0 for every plain struct.
def mir_struct_fields_mixed_firewall(ctx: MirContext, struct_name: String): Int
  # Read fields via the registry helper (the proven-working path used by
  # mir_value_is_cow_layout's flatness rail) rather than a passed-by-value entry.
  var fields_opt = mir_ctx_get_struct_fields(ctx, struct_name)
  return 0 if fields_opt.is_none()
  var field_types = fields_opt.unwrap().field_types
  var has_scalar = 0
  var has_pointer = 0
  for j in 0..vec_size(field_types)
    if mir_is_scalar_field_type(as_string(field_types[j])) == 1
      has_scalar = 1
    else
      has_pointer = 1
    end
  end
  return 1 if has_scalar == 1 and has_pointer == 1
  return 0
end

## B.10 §12.9 — 1 iff `name` is a registered struct with @value layout, i.e. a
## type that should be embedded INLINE (its fields laid out directly) when it
## appears as a field of a generic struct specialized at this type. This is the
## gate for selective generic-over-@value monomorphization: only instantiations
## whose type-arg satisfies this predicate take the new inline-layout path; all
## others stay on the byte-identical Boxed path.
def mir_is_value_layout_type(ctx: MirContext, name: String): Int
  return 0 if str_byte_len(name) == 0
  var resolved = mir_resolve_struct_name(ctx, name)
  # item 35 — a binary-DSL struct (`type X = binary {}` / `packed struct(uN)`,
  # registered in binary_layout_names) needs a FIXED boxed layout ALWAYS: the
  # encode/decode emitters read its fields through a boxed pointer, so a flip to
  # value-layout (default-flip OR an explicit @value) reads garbage. DSL wins over
  # @value. This check FIRST so it overrides the unconditional @value disjunct.
  return 0 if mir_find_binary_layout(mir_ctx_get_program(ctx), resolved) >= 0
  # @value structs are value-layout unconditionally.
  return 1 if mir_ctx_is_value_struct(ctx, resolved) == 1
  # F4a — plain-struct value-layout flip (the cow-reconciliation §3 widening).
  # When the F4 gate is LIVE, an ELIGIBLE plain struct (non-@value, non-@repr(C),
  # non-recursive, non-firewall-mixed) is ALSO value-layout, so it inherits the
  # EXISTING cow machinery (construct buffer, offset+1 routing, make-unique, drop)
  # and the eager ≤16B copy with ZERO new cow code — every cow/copy/field/byval
  # consumer already routes through this single layout key. INERT at gate=0
  # (mir_default_struct_value_live()==0 short-circuits ⇒ byte-identical to history).
  return 1 if mir_default_struct_value_live() == 1 and
           mir_default_struct_value_eligible(ctx, resolved) == 1
  return 0
end

## B.10 §14.12.8 (C2) — THE single COW-layout key. 1 iff a copy of `name` should
## become an O(1) refcount-share (cow_rc_inc + shared buffer ptr) instead of an
## eager word-copy. EVERY COW consumer (copy in C2, construct+offset in C3, drop in
## C4) routes through THIS predicate — never re-decides per site (the Result-NO-GO
## construct/read-must-agree lesson, §14.11.2). Three conjuncts:
##   (1) cow gate live,
##   (2) value-layout (@value today; ⊇ eligible plain structs after F4 widens
##       mir_is_value_layout_type),
##   (3) >16B = the SysV MEMORY boundary (field_count >= 3); ≤16B stays eager
##       inline bit-copy (cheaper than atomic inc + later make-unique).
## PLUS the MANDATORY FLATNESS SAFETY RAIL (scan_map / deep nested-COW DEFERRED):
## the struct must be FLAT — every field bit-copy-safe = scalar OR a reference
## handle (String/Vec/Map/...; a boxed pointer that stays shared). A NESTED
## value-layout (@value) field is NOT bit-copy-safe: a shallow share without a
## per-field retain is a use-after-free. Any such field ⇒ FALSE ⇒ eager fallback.
def mir_value_is_cow_layout(ctx: MirContext, name: String): Int
  return 0 if mir_value_cow_live() == 0
  return 0 if str_byte_len(name) == 0
  var resolved = mir_resolve_struct_name(ctx, name)
  return 0 if mir_is_value_layout_type(ctx, resolved) == 0
  # >16B threshold = field_count >= 3 (8 * field_count > 16).
  return 0 if mir_sizeof_type(ctx, resolved) <= 16
  # C3 narrow-field safety rail: a @value struct with narrow-integer fields
  # (U8/I8/U16/I16/U32/I32) rides its OWN typed-GEP byte-packed layout + by-value
  # aggregate return ABI (the narrow-byval fold-in). The COW buffer is a FLAT
  # i64-word block with +1 field routing — incompatible with sub-word packing and
  # the byval-return reconstruction (value_struct_narrow_byval_spec /
  # value_struct_gc_firewall_spec). Until COW grows a typed/narrow-aware buffer
  # (a follow-up, alongside the C5 scan_map), narrow structs fall back to the
  # eager word-copy + typed path ⇒ correct. A widening here would silently
  # miscompile their byte offsets.
  return 0 if mir_struct_has_narrow_fields(ctx, resolved) == 1
  # Flatness safety rail: every field must be scalar or a (bit-copy-safe) ref
  # handle. A nested value-layout field would require per-field retain (scan_map,
  # DEFERRED) — without it a shallow COW share double-frees ⇒ fall back to eager.
  var fields_opt = mir_ctx_get_struct_fields(ctx, resolved)
  return 0 if fields_opt.is_none()
  var field_types = fields_opt.unwrap().field_types
  for fi in 0..vec_size(field_types)
    var ft = as_string(field_types[fi])
    if mir_is_scalar_field_type(ft) == 0
      # Non-scalar slot. Safe only if it is NOT itself a value-layout struct
      # (i.e. a reference handle / boxed pointer that stays shared on bit-copy).
      return 0 if mir_is_value_layout_type(ctx, ft) == 1
    end
  end
  return 1
end

## B.10 §12.9 — 1 iff `struct_name` is a SYNTHESIZED generic-over-@value
## specialization (e.g. `Box$P`) carrying the `inline_value` marker.
## Ordinary user/stdlib structs leave `inline_value` 0, so this returns 0 for
## them — keeping the Boxed path byte-identical (the fixpoint-safety invariant).
## Only entries minted by `mir_synth_value_layout_struct` set inline_value == 1.
def mir_struct_has_inline_value(ctx: MirContext, struct_name: String): Int
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      return entry.inline_value
    end
  end
  return 0
end

## B.10 §12.9 — Same check, but operating directly on a prog struct_defs entry
## (codegen reads `prog.struct_defs`, which is the same vec by reference).
def mir_struct_def_has_inline_value(entry: MirStructDef): Int
  return entry.inline_value
end

## B.10 §12.9 — Synthesize (idempotently) a specialized struct registry entry
## for a generic struct `base_name` instantiated with concrete type args.
## Field types declared as a struct type-param resolve to the concrete arg; if
## that concrete arg is a @value-layout type, the field is laid out INLINE.
## Returns the specialized struct name (e.g. `Box$P`). The entry sets
## `inline_value == 1` flagging it as an inline-value specialization so codegen emits
## a `%struct.Box$P = type { %struct.P }` aggregate and the construction/access
## paths use typed `%struct.Name` GEP instead of pointer-boxing the field.
##
## `tparam_names` is the struct's declared type-param list (e.g. ["T"]);
## `concrete_types` is the positional instantiation (e.g. ["P"]). Only fires
## when at least one concrete arg is a value-layout type (else returns "" — the
## caller keeps the unchanged Boxed path).
def mir_synth_value_layout_struct(ctx: MirContext, base_name: String, tparam_names: Vec, concrete_types: Vec): String
  # Detect whether any concrete arg is a value-layout type.
  var any_value = 0
  var ct_count = concrete_types.size
  for ci in 0..ct_count
    if mir_is_value_layout_type(ctx, as_string(concrete_types[ci])) == 1
      any_value = 1
    end
  end
  if any_value == 0
    return ""
  end

  # Build the specialized name: base$Type1$Type2...
  var spec_name = base_name
  for ci2 in 0..ct_count
    var cn = as_string(concrete_types[ci2])
    if str_byte_len(cn) > 0
      spec_name = "#{spec_name}$#{cn}"
    end
  end

  # Idempotent: already synthesized?
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len0 = registry.size
  for ri in 0..reg_len0
    if registry[ri].name == spec_name
      return spec_name
    end
  end

  # Find the base struct entry to clone field names + substitute field types.
  var base_resolved = mir_resolve_struct_name(ctx, base_name)
  var base_entry_opt: Option<MirStructDef> = Option::None
  var reg_len1 = registry.size
  for ri2 in 0..reg_len1
    if registry[ri2].name == base_resolved
      base_entry_opt = Option::Some(registry[ri2])
    end
  end
  if base_entry_opt.is_none()
    return ""
  end
  var base_entry = base_entry_opt.unwrap()

  var base_field_names = base_entry.field_names
  var base_field_types = base_entry.field_types
  var fc = vec_size(base_field_names)
  var new_field_names = vec_new<String>()
  var new_field_types = vec_new<String>()
  var tp_count = tparam_names.size
  for fi in 0..fc
    new_field_names.push(as_string(base_field_names[fi]))
    var ft = as_string(base_field_types[fi])
    # Substitute a type-param field type with its concrete arg (positional).
    var subst = ft
    for ti in 0..tp_count
      if as_string(tparam_names[ti]) == ft
        if ti < ct_count
          subst = as_string(concrete_types[ti])
        end
      end
    end
    new_field_types.push(subst)
  end

  # Mint the entry with the inline-value marker set. Defaults/ast_store are
  # copied from the base so omitted-field handling still works.
  var new_entry = MirStructDef {
    name: spec_name,
    field_names: new_field_names,
    field_types: new_field_types,
    repr_c: base_entry.repr_c,
    packed: base_entry.packed,
    is_value: base_entry.is_value,
    field_defaults: base_entry.field_defaults,
    ast_store: base_entry.ast_store,
    inline_value: 1,
  }
  registry.push(new_entry)
  return spec_name
end

## Field count for a registered struct (-1 if not found).
def mir_ctx_struct_field_count(ctx: MirContext, struct_name: String): Int
  struct_name = mir_strip_borrow_prefix(struct_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      return vec_size(entry.field_names)
    end
  end
  return -1
end

## Field name at an index for a registered struct ("" if not found).
def mir_ctx_struct_field_name(ctx: MirContext, struct_name: String, idx: Int): String
  struct_name = mir_strip_borrow_prefix(struct_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var field_names = entry.field_names
      if idx >= 0 and idx < vec_size(field_names)
        return as_string(field_names[idx])
      end
      return ""
    end
  end
  return ""
end

def mir_ctx_find_field_index(ctx: MirContext, struct_name: String, field_name: String): Int
  # Strip leading '&' or '&mut ' for borrow types
  struct_name = mir_strip_borrow_prefix(struct_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var field_names = entry.field_names
      var field_count = vec_size(field_names)
      for j in 0..field_count
        var fname = as_string(field_names[j])
        return j if fname == field_name
      end
      return -1  # Field not found
    end
  end
  return -1  # Struct not found
end

## Find field index by searching all registered structs for a field name.
## Returns (struct_name, field_index) as a 2-element Vec, or empty Vec if not found.
def mir_find_field_globally(ctx: MirContext, field_name: String): Vec
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    # R2 (C1/§3.3) — skip SYNTHETIC canonical record views (`__rec$...$rec_`). This
    # fallback resolves intersection-param field reads against the PHYSICAL runtime
    # value, which is always a nominal struct (records have no first-class value).
    # A 1-field synthetic record minted from an intersection segment (`{x}&{y}&{z}`
    # registers `__rec$x$Int$rec_` etc.) is a flat is_value=1 view — matching it here
    # would return a non-cow struct and DROP the source's +1 COW header shift for that
    # one field (the "merges three" x-only miscompile: x@header, y/z@f+1). Matching
    # only real nominal structs keeps the cow-layout probe (caller) consistent across
    # every field. GATE-0-INERT: the compiler mints no `__rec$` structs for its own code.
    if name.starts_with("__rec") == false
      var field_names = entry.field_names
      var field_count = vec_size(field_names)
      for j in 0..field_count
        var fname = as_string(field_names[j])
        if fname == field_name
          var result: Vec = vec_new()
          result.push(as_int(name))
          result.push(j)
          return result
        end
      end
    end
  end
  var empty: Vec = vec_new()
  return empty
end

# Resolve a struct name to its registered name in the struct registry.
# Handles cross-module structs: "ParserState" -> "parser$ParserState"
def mir_resolve_struct_name(ctx: MirContext, base_name: String): String
  # Strip leading '&' or '&mut ' for borrow types
  base_name = mir_strip_borrow_prefix(base_name)
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  var suffix = "$#{base_name}"
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    # Exact match
    return name if name == base_name
    # Suffix match: "parser$ParserState" ends with "$ParserState"
    var name_len = str_byte_len(name)
    var suffix_len = str_byte_len(suffix)
    if name_len >= suffix_len
      var end_part = str_byte_slice(name, name_len - suffix_len, name_len)
      return name if end_part == suffix
    end
  end
  return base_name
end

# Get struct field info (field_names, field_types) for a struct name
# Returns None if not found, otherwise Some([field_names, field_types])
def mir_ctx_get_struct_fields(ctx: MirContext, struct_name: String): Option<StructFields>
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var result = StructFields { field_names: entry.field_names, field_types: entry.field_types }
      return Option::Some(result)
    end
  end
  return Option::None
end

## Get field defaults and AST store for a struct.
## Returns Some([field_defaults_vec, ast_store]) or None if not found / no defaults.
## field_defaults_vec[i] is AST node handle (0 = no default).
def mir_ctx_get_struct_defaults(ctx: MirContext, struct_name: String): Option<Vec<Int>>
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var name = entry.name
    if name == struct_name
      var defaults = entry.field_defaults
      var ast_store = entry.ast_store
      if defaults != 0
        var result = [defaults, ast_store]
        return Option::Some(result)
      end
      return Option::None
    end
  end
  return Option::None
end

## mir_sizeof_type() - Calculate the size in bytes of a type
##
## Returns the size needed to allocate space for a type:
## - Primitive types: 8 bytes (i64)
## - Structs: 8 * field_count (each field is i64)
## - Unknown: 8 bytes (default)
def mir_sizeof_type(ctx: MirContext, type_name: String): Int
  # Handle pointer types: Ptr<T> = 8 bytes
  return 8 if type_name.starts_with("Ptr<")
  
  # Handle array types: Array<T>, Vec<T> = 8 bytes (pointer to vec)
  return 8 if type_name.starts_with("Array<")
  return 8 if type_name.starts_with("Vec<")
  
  # Fixed-width narrow types
  return 1 if type_name == "U8"
  return 1 if type_name == "I8"
  return 2 if type_name == "U16"
  return 2 if type_name == "I16"
  return 4 if type_name == "U32"
  return 4 if type_name == "I32"

  # Primitive types = 8 bytes each
  return 8 if type_name == "Int"
  return 8 if type_name == "I64"
  return 8 if type_name == "U64"
  return 8 if type_name == "Bool"
  return 8 if type_name == "Char"
  return 8 if type_name == "Float"
  return 8 if type_name == "String"
  return 8 if type_name == "Symbol"
  
  # Struct lookup - read the LayoutDescriptor (B.10 Phase 0: Boxed, 8*field_count).
  # Empty Vec = not a registered struct → fall through to the default below.
  var desc = mir_struct_layout_descriptor(ctx, type_name)
  if vec_size(desc) > 0
    return layout::layout_desc_size(desc)
  end

  # Default: 8 bytes
  return 8
end

# Map Quartz FFI types to LLVM types for repr(C) structs
def mir_map_be_type_to_llvm(be_type: String): String
  return "i64" if be_type == "Int"
  return "i64" if be_type == "CInt"
  return "i64" if be_type == "CSize"
  return "i8" if be_type == "CChar"
  return "i8*" if be_type == "CPtr"
  return "float" if be_type == "CFloat"
  return "double" if be_type == "CDouble"
  return "i8*" if be_type == "String"
  return "i1" if be_type == "Bool"
  return "i64"  # Default for compatibility
end

# Emit LLVM struct type definitions for @repr(C) structs
# Returns a string containing all repr(C) struct type definitions
def mir_get_repr_c_structs(ctx: MirContext): String = ""

## Set current source line for debug info propagation
def mir_ctx_set_line(ctx: MirContext, line: Int): Void
  ctx.line = line
end

## Get current source line
def mir_ctx_get_line(ctx: MirContext): Int = ctx.line

# Resolve a function name to its fully-qualified form
# - If already prefixed (has $), return as-is
# - If intrinsic (puts, malloc, etc.), return as-is
## Bare names already reported (QZ0405) — dedup so one ambiguous import
## errors once, not once per call site.
var _mir_ambiguous_warned = vec_new<String>()

## Emit a one-shot QZ0405 ambiguous-import HARD ERROR for `name`, naming the
## symbol that first-wins would have picked so the user sees which one the old
## warning-era pick resolved to. Routed through `diag_emit(DIAG_ERROR)` so it
## increments the driver's error count and fails compilation at the post-MIR
## gate (`quartz.qz` — `if diag_error_count() > 0 return ""`). A genuinely
## ambiguous bare call is not something to resolve silently by first-wins; the
## user must disambiguate. The fix-it hint is carried as a diagnostic note.
def mir_error_ambiguous_import(ctx: MirContext, name: String, picked: String): Void
  for i in 0.._mir_ambiguous_warned.size
    return if _mir_ambiguous_warned[i] == name
  end
  _mir_ambiguous_warned.push(name)
  var d = diagnostic::diag_new_simple(diagnostic::DIAG_ERROR, "QZ0405", "ambiguous call to '#{name}' — two or more wildcard-imported modules define it (first-wins would resolve to '#{picked}')")
  diagnostic::diag_add_note(d, "disambiguate with a qualified import (`import M` then `M.#{name}(...)`) or an `as` rename on one of the wildcard imports")
  diagnostic::diag_emit(d)
end

## Module-aware canonical-symbol resolution (IMPORT_STAR_COLLISION_SILENT_SHADOW).
## A bare / half-qualified callee is resolved against the CURRENT module's own
## definitions first — so a module's internal call hits its own function, not a
## same-named function from another wildcard import — then falls back to the
## flat first-wins alias map for genuine cross-module calls. When the bare name
## maps to two or more distinct canonicals AND the current module is not one of
## the candidates, the call site is genuinely ambiguous; emit QZ0405 (HARD
## ERROR — the user must disambiguate rather than accept a silent first-wins pick).
def mir_resolve_canonical(ctx: MirContext, name: String): String
  var cur_mod = mir_ctx_get_module(ctx)
  if str_byte_len(cur_mod) > 0
    var local = compiler_types::ct_func_alias_lookup_in_module(name, cur_mod)
    return local if str_byte_len(local) > 0
  end
  var flat = compiler_types::ct_func_alias_lookup(name)
  if str_byte_len(flat) > 0
    # A.42 #2: a local (unprefixed) definition shadows a wildcard-import
    # alias. The flat alias map is global and first-wins, so without this a
    # `def get_val` that locally shadows a `import * from helper` (which also
    # defines `get_val`) would be hijacked: the bare call already resolved to
    # the real local symbol `@get_val`, but the alias would rewrite it to
    # `@helper$get_val`. A wildcard import canonically promotes its own funcs
    # to `module$name`, so the ONLY bare tag-0 entry named `name` is a genuine
    # local def — its presence means the alias must not apply.
    if mir_has_local_bare_func(ctx, name)
      return ""
    end
    if compiler_types::ct_func_alias_distinct_count(name) > 1
      mir_error_ambiguous_import(ctx, name, flat)
    end
  end
  return flat
end

## A.42 #2: does the current compilation define a function literally named
## `name` (unprefixed tag-0 entry)? Such an entry is a real `@name` symbol —
## either a local def or an extern "C" body — that a bare call already targets,
## so the wildcard-import canonical alias must not override it.
def mir_has_local_bare_func(ctx: MirContext, name: String): Int
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  return 0 if all_funcs == 0
  var n = all_funcs.size
  for i in 0..n
    var e = all_funcs[i]
    if e.tag == 0 and e.name == name
      return 1
    end
  end
  return 0
end

# - If extern C function (tag 10 in all_funcs), return as-is (global C symbol)
# - Otherwise, check if it's a user function and prefix with current module
def mir_resolve_func_name(ctx: MirContext, raw_name: String): String
  # Case 1: Already qualified (cross-module call like lexer$tokenize).
  # If the qualified name has an alias to a canonical module-prefixed
  # symbol (Cache-ro Bug B alias map), resolve through that — otherwise
  # downstream `mir_lookup_function` misses the user-defined extend method
  # whose entry is keyed under `module$Type$method`, not `Type$method`.
  # Without this, the ghost-self prepend at
  # `mir_lower_expr_handlers.qz:2313` is skipped (func_entry == 0) and
  # the resulting MIR_CALL passes one fewer arg than the def expects.
  var len = str_byte_len(raw_name)
  for i in 0..len
    if str_byte_at(raw_name, i) == '$'  # '$'
      var _alias = mir_resolve_canonical(ctx, raw_name)
      return _alias if str_byte_len(_alias) > 0
      return raw_name
    end
  end
  
  # Case 2: Check if it's an intrinsic (no prefix needed)
  return raw_name if mir_intrinsics::mir_is_intrinsic(raw_name)

  # Case 3: Check if it matches an extern C function (tag 10)
  # Extern functions keep their original C names (accept, close, free, etc.)
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  if all_funcs != 0
    var af_count = all_funcs.size
    for i in 0..af_count
      var entry = all_funcs[i]
      if entry.tag == 10
        if entry.name == raw_name
          return raw_name
        end
      end
    end
  end

  # Case 4: Check if the unprefixed name exists in all_funcs
  # This handles wildcard-imported functions (e.g., helper_add from `import * from helpers`)
  # that are available without a module prefix
  if all_funcs != 0
    var af_count2 = all_funcs.size
    for i2 in 0..af_count2
      var entry2 = all_funcs[i2]
      if entry2.name == raw_name
        return raw_name
      end
    end

    # Case 4a: module-local precedence (IMPORT_STAR_COLLISION_SILENT_SHADOW).
    # If the CURRENT module defines this name, resolve to its own canonical
    # symbol BEFORE any cross-module suffix match. Two wildcard-imported
    # modules that share a bare name (e.g. `_compress` in sha256.qz and
    # sha512.qz) must not hijack each other's — or their own — internal calls.
    # Without this, the suffix search below returns the first `$name` match
    # regardless of which module the call originates in.
    var cur_mod_loc = mir_ctx_get_module(ctx)
    if str_byte_len(cur_mod_loc) > 0
      var local_name = "#{cur_mod_loc}$#{raw_name}"
      for ia in 0..af_count2
        if all_funcs[ia].name == local_name
          return local_name
        end
      end
    end

    # Case 4b: Suffix search for cross-module functions. First-wins — but if
    # two or more wildcard-imported modules define this bare name and the
    # caller is not one of them, the pick is genuinely ambiguous; QZ0405 is a
    # HARD ERROR (compilation fails at the post-MIR error gate).
    var suffix = "$#{raw_name}"
    var first_match = ""
    for i3 in 0..af_count2
      var entry3 = all_funcs[i3]
      if str_ends_with(entry3.name, suffix)
        first_match = entry3.name
        break
      end
    end
    if str_byte_len(first_match) > 0
      if compiler_types::ct_func_alias_distinct_count(raw_name) > 1
        mir_error_ambiguous_import(ctx, raw_name, first_match)
      end
      return first_match
    end
  end

  # Case 5: It's a local function - prefix with current module
  var module_name = mir_ctx_get_module(ctx)
  return raw_name if str_byte_len(module_name) == 0  # No module context, return as-is

  var prefixed = "#{module_name}$"
  prefixed = "#{prefixed}#{raw_name}"
  return prefixed
end

## Receiver-aware function name resolution for UFCS calls inside spec
## bodies. Mirrors the A8 trait-rewriting logic in
## `mir_lower_expr_handlers.qz` so that downstream type tracking
## (e.g. `var it = c.iter()`) records `it`'s type via the SAME
## function the call actually dispatches to at codegen, not whichever
## `iter` happens to be first in `all_funcs`.
##
## Closes the IMPL-TRAIT-RPITIT bounded-generic-dispatch hole: in a
## body like `def f<C: Iterable>(c: C); var it = c.iter(); it.next()`,
## the let-init path was using `mir_resolve_func_name("iter")` which
## suffix-matched against the alphabetically-first `$iter` in
## `all_funcs`. The emit path (A8) correctly resolved the receiver-
## type-specific impl, but the type tracker recorded the wrong return
## annotation, which then poisoned `it.next()`'s dispatch.
##
## Returns the receiver-resolved mangled name (e.g. `AMyList$iter`) if
## the receiver's spec_param_type or var_type yields a concrete struct
## that has the requested method registered. Returns "" otherwise so
## the caller can fall back to bare `mir_resolve_func_name`.
def mir_resolve_method_call_receiver_aware(ctx: MirContext, s: ast::AstStorage, call_node: AstNodeId, raw_name: String): String
  # Gate: only redirect inside spec bodies. Non-spec code keeps its
  # bare-name lookup semantics — preserves backward compatibility for
  # cases like `def map(v: Vec, f): ...` shadowing `Vec$map`. A8 itself
  # is gated the same way (mir_lower_expr_handlers.qz line 1858 reads
  # spec_current_type), so this helper mirrors the gating exactly.
  var spec_type = mir_ctx_get_spec_current_type(ctx)
  if str_byte_len(spec_type) == 0
    return ""
  end
  var args = ast::ast_get_children(s, call_node)
  if args == 0
    return ""
  end
  if args.size == 0
    return ""
  end
  var first_arg = args[0]
  var recv_type = ""
  if ast::ast_get_kind(s, first_arg) == node_constants::NODE_IDENT
    var recv_name = ast::ast_get_str1(s, first_arg)
    recv_type = mir_ctx_lookup_spec_param_type(ctx, recv_name)
    if str_byte_len(recv_type) == 0
      recv_type = mir_ctx_get_var_type(ctx, recv_name)
    end
  elsif ast::ast_get_kind(s, first_arg) == node_constants::NODE_FIELD_ACCESS
    # A.36: a field-access receiver inside a generic-struct extend-method spec —
    # e.g. `@source.itg_go()` where `source` has the struct's type-param type.
    # Resolve ONLY when the field's declared type is exactly a bound spec param
    # ({I → ITBase}); then dispatch to the field's concrete method
    # (ITBase$itg_go) instead of the un-monomorphized extend-method symbol
    # (ITLift$itg_go), which self-recurses. The tight gate (field type IS a
    # bound param) leaves every other in-spec method call on its existing path.
    var inferred = mir_infer_expr_type(ctx, s, first_arg)
    if str_byte_len(inferred) > 0
      recv_type = mir_ctx_lookup_spec_param_type(ctx, inferred)
    end
  end
  if str_byte_len(recv_type) == 0
    return ""
  end
  # Strip generic args ("MapDoubler<RangeSrc>" → "MapDoubler") for
  # struct-mangled method-name lookup.
  var dispatch_type = recv_type
  var dt_lt = __char_index(dispatch_type, '<')
  if dt_lt > 0
    dispatch_type = str_byte_slice(dispatch_type, 0, dt_lt)
  end
  # If raw_name is already pre-mangled (typecheck eagerly resolved the
  # impl Trait return from the spec param's iter() to a specific concrete
  # at typecheck time, before knowing the per-monomorphization concrete),
  # extract the bare method name from after the last `$` and re-mangle
  # against the receiver's actually-tracked type. This is the Phase 11
  # RPITIT bounded-generic gap: the concrete impl chosen by typecheck for
  # `var it = c.iter()` (e.g. "AStackIter") is wrong for monomorphizations
  # over OTHER impls (e.g. AMyList → AListIter), and any subsequent
  # `it.method()` call name needs to be re-resolved against the actual
  # tracked struct type at MIR-lower time.
  var bare_name = raw_name
  var last_dollar = -1
  var rn_len = str_byte_len(raw_name)
  for ldi in 0..rn_len
    if str_byte_at(raw_name, ldi) == '$'
      last_dollar = ldi
    end
  end
  if last_dollar > 0
    bare_name = str_byte_slice(raw_name, last_dollar + 1, rn_len)
  end
  var arity = args.size
  # Try Type$method$arity (overload-mangled), then Type$method (plain).
  var mangled_arity = string_intern::mangle_int(string_intern::mangle(dispatch_type, bare_name), arity)
  if mir_func_exists_in_all_funcs(ctx, mangled_arity)
    return mangled_arity
  end
  var mangled = string_intern::mangle(dispatch_type, bare_name)
  if mir_func_exists_in_all_funcs(ctx, mangled)
    return mangled
  end
  # Cross-module fallback: prepend the spec's module prefix.
  var mod_prefix = mir_ctx_get_spec_current_module_prefix(ctx)
  if str_byte_len(mod_prefix) > 0
    var prefixed_type = "#{mod_prefix}$#{dispatch_type}"
    var pmangled_arity = string_intern::mangle_int(string_intern::mangle(prefixed_type, bare_name), arity)
    if mir_func_exists_in_all_funcs(ctx, pmangled_arity)
      return pmangled_arity
    end
    var pmangled = string_intern::mangle(prefixed_type, bare_name)
    if mir_func_exists_in_all_funcs(ctx, pmangled)
      return pmangled
    end
  end
  return ""
end

# Check if a name is a known module prefix by scanning all_funcs for any function
# with that prefix (e.g., "math" matches if "math$add" exists in all_funcs)
def mir_is_module_name(ctx: MirContext, name: String): Int
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  return 0 if all_funcs == 0
  var prefix = "#{name}$"
  for i in 0..all_funcs.size
    var e = all_funcs[i]
    if e.name.starts_with(prefix)
      return 1
    end
  end
  return 0
end

# ============================================================================
# Helper functions for lowering
# ============================================================================

def mir_emit_value(ctx: MirContext, typ: Int): Int
  var func = mir_ctx_get_func(ctx)
  return mir_func_next_value(func)
end

def mir_emit_instr(ctx: MirContext, instr: MirInstr): Void
  var block = mir_ctx_get_block(ctx)
  mir_block_add_instr(block, instr)
end

def mir_create_block(ctx: MirContext, label: String): MirBlock
  var func = mir_ctx_get_func(ctx)
  var block_id = mir_func_next_block_id(func)
  var full_label = "#{label}#{block_id.to_s()}"
  var block = mir_new_block(full_label)
  var blocks = mir_func_get_blocks(func)
  blocks.push(block)
  return block
end

def mir_switch_to_block(ctx: MirContext, block: MirBlock): Void
  mir_ctx_set_block(ctx, block)
end

# ============================================================================
# Emit basic instructions
# ============================================================================

def mir_emit_const_int(ctx: MirContext, val: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_CONST_INT, dest, MIR_TYPE_INT)
  mir_instr_set_int_val(instr, val)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_const_bool(ctx: MirContext, val: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_BOOL)
  var instr = mir_new_instr(MIR_CONST_BOOL, dest, MIR_TYPE_BOOL)
  mir_instr_set_int_val(instr, val)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_const_string(ctx: MirContext, val: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_STRING)
  var instr = mir_new_instr(MIR_CONST_STRING, dest, MIR_TYPE_STRING)
  mir_instr_set_string_val(instr, val)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_const_float(ctx: MirContext, val: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_F64)
  var instr = mir_new_instr(MIR_CONST_FLOAT, dest, MIR_TYPE_F64)
  mir_instr_set_string_val(instr, val)
  mir_emit_instr(ctx, instr)
  return dest
end

## mir_emit_inline_c - Emit inline C/asm escape hatch
## @c("code") allows embedding raw C/asm for low-level operations.
## @c("code", var1, var2) binds variables as input operands ($1, $2, ...).
## $0 is the output register.
## Emitted as LLVM inline assembly.
def mir_emit_inline_c(ctx: MirContext, code: String, args: Vec<Int>): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_INLINE_C, dest, MIR_TYPE_INT)
  mir_instr_set_string_val(instr, code)
  mir_instr_set_args(instr, args)  # Store args vector (may be empty)
  mir_emit_instr(ctx, instr)
  return dest
end

## R-WS3 — emit a RAW MIR_LOAD_VAR for `name` with NO ref-var indirection. The
## ref-var deref path calls this to fetch the stored POINTER from the ref-var's
## own slot before dereferencing it. Direct callers should use mir_emit_load_var.
def mir_emit_load_var_raw(ctx: MirContext, name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_LOAD_VAR, dest, MIR_TYPE_INT)
  mir_instr_set_var_name(instr, name)
  # slot1 = is_global flag
  var is_global = mir_ctx_is_global(ctx, name)
  mir_instr_set_slot1(instr, is_global)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_load_var(ctx: MirContext, name: String): Int
  # R-WS3 — ref-var indirection. When `name` is a mutable-by-reference capture,
  # its local slot holds a POINTER to the caller's slot; a read must deref it.
  # INERT at gate 0: ref_vars is empty for every compiler closure ⇒ raw path.
  if mir_ctx_is_ref_var(ctx, name) == 1
    var rv_ptr = mir_emit_load_var_raw(ctx, name)
    return mir_emit_load_offset(ctx, rv_ptr, 0)
  end
  return mir_emit_load_var_raw(ctx, name)
end

# Emit field access: object.field_name
def mir_emit_field_access(ctx: MirContext, obj: MirReg, field_idx: Int, field_name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_FIELD_ACCESS, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, obj)
  mir_instr_set_slot1(instr, field_idx)
  mir_instr_set_var_name(instr, field_name)
  mir_emit_instr(ctx, instr)
  return dest
end

# Emit function reference (address-of function)
def mir_emit_func_ref(ctx: MirContext, name: String): Int
  # Cache-ro Bug B: same alias rewrite as mir_emit_call — `ptrtoint @<name>`
  # emissions for function-as-value need to point to the canonical symbol.
  var _fr_canonical = mir_resolve_canonical(ctx, name)
  if str_byte_len(_fr_canonical) > 0
    name = _fr_canonical
  end
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_FUNC_REF, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, name)
  mir_emit_instr(ctx, instr)
  return dest
end

## R-WS3 — emit a RAW MIR_STORE_VAR for `name` with NO ref-var indirection. The
## caller-side of a ref-var (storing the addr-of pointer into the ref-var's slot)
## uses this so it writes the POINTER itself, not through it.
def mir_emit_store_var_raw(ctx: MirContext, name: String, val: MirReg): Void
  var instr = mir_new_instr(MIR_STORE_VAR, 0, MIR_TYPE_VOID)
  mir_instr_set_var_name(instr, name)
  mir_instr_set_operand2(instr, val)
  # slot1 = is_global flag
  var is_global = mir_ctx_is_global(ctx, name)
  mir_instr_set_slot1(instr, is_global)
  mir_emit_instr(ctx, instr)
end

def mir_emit_store_var(ctx: MirContext, name: String, val: MirReg): Void
  # R-WS3 — ref-var indirection. When `name` is a mutable-by-reference capture,
  # writes must go THROUGH the stored pointer to the caller's slot so the mutation
  # persists into the caller's storage (live aliasing). This is exactly why the
  # NODE_ASSIGN handler (mir_lower_stmt_handlers.qz) needs no change: it ends in
  # mir_emit_store_var, which transparently write-throughs. INERT at gate 0.
  if mir_ctx_is_ref_var(ctx, name) == 1
    var rv_ptr = mir_emit_load_var_raw(ctx, name)
    mir_emit_store_offset(ctx, rv_ptr, 0, val)
    return
  end
  mir_emit_store_var_raw(ctx, name, val)
end

## Emit MIR_ADDR_OF for a local variable. Codegen produces
## `ptrtoint ptr %<safe_name> to i64`, returning the alloca's address as
## an i64. Used by B.8 Phase 6.5 to push the bound-param slot pointer
## onto the runtime Scoped-ctx TLS stack so the throw handler can deref-
## and-release with the body's most-recent write to v.
def mir_emit_addr_of(ctx: MirContext, name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_ADDR_OF, dest, MIR_TYPE_INT)
  mir_instr_set_var_name(instr, name)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_binary(ctx: MirContext, op: Int, left: MirReg, right: MirReg): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_BINARY, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, left)
  mir_instr_set_operand2(instr, right)
  mir_instr_set_op(instr, op)
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_BINARY_PACK instruction. operand1 is the binary-layout id
## (NOT an SSA register — it's a raw integer that codegen looks up in the
## layout registry). args holds the encoded field value registers — for
## STEP 2 this is typically just the `self` value; STEP 4 expands to
## per-field values after walking the struct.
def mir_emit_binary_pack(ctx: MirContext, layout_id: Int, field_vals: Vec<Int>): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_BINARY_PACK, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, layout_id)
  mir_instr_set_args(instr, field_vals)
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_BINARY_UNPACK instruction. operand1 = layout id (raw int),
## operand2 = Bytes-handle SSA register. Result is a Result<T, ParseError>
## sum-value — STEP 4 constructs it from decoded fields.
def mir_emit_binary_unpack(ctx: MirContext, layout_id: Int, bytes_val: MirReg): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_BINARY_UNPACK, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, layout_id)
  mir_instr_set_operand2(instr, bytes_val)
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_PACKED_BITCAST instruction. operand1 = layout id (raw int),
## operand2 = source SSA register. slot1 = direction (0 = struct→int,
## 1 = int→struct). Since both values are i64 at runtime, STEP 4's
## codegen emits this as a no-op pass-through after range checks.
def mir_emit_packed_bitcast(ctx: MirContext, layout_id: Int, src_val: MirReg, direction: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_PACKED_BITCAST, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, layout_id)
  mir_instr_set_operand2(instr, src_val)
  mir_instr_set_slot1(instr, direction)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_unsigned_binary(ctx: MirContext, op: Int, left: MirReg, right: MirReg): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_BINARY, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, left)
  mir_instr_set_operand2(instr, right)
  mir_instr_set_op(instr, op)
  mir_instr_set_slot1(instr, 1)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_float_binary(ctx: MirContext, op: Int, left: MirReg, right: MirReg): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_F64)
  var instr = mir_new_instr(MIR_BINARY, dest, MIR_TYPE_F64)
  mir_instr_set_operand1(instr, left)
  mir_instr_set_operand2(instr, right)
  mir_instr_set_op(instr, op)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_call(ctx: MirContext, func_name: String, args: Vec<Int>): Int
  # Cache-ro Bug B: rewrite bare / half-qualified callees to their canonical
  # module-prefixed symbol when the target was wildcard-imported. Resolver
  # populates the alias map; this is the single chokepoint that catches
  # both bare free-function calls and UFCS-canonicalized "Type$method"
  # calls so the LLVM symbol agrees with the cached per-module fragment.
  var _ca_canonical = mir_resolve_canonical(ctx, func_name)
  if str_byte_len(_ca_canonical) > 0
    func_name = _ca_canonical
  end
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_CALL, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, func_name)
  mir_instr_set_args(instr, args)
  # Get line from context if available
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Push one lexical handler-stack entry. Called from NODE_WITH lowering
## once per op-filter entry (one for bare-IDENT, N for multi-op records).
## Effects G.1 infrastructure for static evidence dispatch.
def mir_ctx_push_handler_entry(ctx: MirContext, eff: String, op_filter: String, handler_as_int: Int, install_dest: Int): Void
  ctx.handler_stack_effs.push(eff)
  ctx.handler_stack_filters.push(op_filter)
  ctx.handler_stack_handlers.push(handler_as_int)
  ctx.handler_stack_install_dests.push(install_dest)
end

## Pop N lexical handler-stack entries. Matches the number of entries
## pushed for a given `with` block at NODE_WITH exit.
def mir_ctx_pop_handler_entries(ctx: MirContext, n: Int): Void
  var _i = 0
  while _i < n
    var _top = ctx.handler_stack_effs.size - 1
    if _top < 0
      return
    end
    ctx.handler_stack_effs.pop()
    ctx.handler_stack_filters.pop()
    ctx.handler_stack_handlers.pop()
    ctx.handler_stack_install_dests.pop()
    _i += 1
  end
end

## Push one wrap-block entry. Called from NODE_WITH lowering AFTER
## mir_emit_handle_install runs (so the wrap-stack only ever reflects
## installs that have already pushed onto the runtime effect-stack).
## Pop_count = number of evidence entries the wrap installed (= the count
## passed to mir_emit_handle_uninstall on natural fall-through).
def mir_ctx_push_wrap(ctx: MirContext, eff_name: String, pop_count: Int): Void
  ctx.wrap_stack_eff_names.push(eff_name)
  ctx.wrap_stack_pop_counts.push(pop_count)
  ctx.wrap_stack_kinds.push(0)
  ctx.wrap_stack_scoped_release_fns.push("")
  ctx.wrap_stack_scoped_self_slot_names.push("")
  ctx.wrap_stack_scoped_v_slot_names.push("")
end

## B.8 Phase 4a: push a Scoped-resource wrap entry. NODE_RETURN inside
## the body emits a `<Struct>$release(self, v)` call instead of an
## effect-stack pop. The eff_name slot stays empty and pop_count = 0
## so the legacy effect-pop branch in mir_ctx_emit_active_wrap_pops
## skips this entry.
##
## Phase 6.5: takes the bound-value slot's variable NAME instead of an
## SSA register. Drain time emits `mir_emit_load_var(slot_name)` to read
## the body's most-recent write to v before calling release, so reassign-
## ments inside the body propagate.
##
## Phase 2d Bug 4 fix: takes the HANDLER's slot name (not an SSA reg).
## See the comment on wrap_stack_scoped_self_slot_names for why — async
## state-machine re-entry blocks bypass the original handler-expr def
## site, so the value must live in memory across yield/resume.
def mir_ctx_push_wrap_scoped(ctx: MirContext, release_fn: String, self_slot_name: String, v_slot_name: String): Void
  ctx.wrap_stack_eff_names.push("")
  ctx.wrap_stack_pop_counts.push(0)
  ctx.wrap_stack_kinds.push(1)
  ctx.wrap_stack_scoped_release_fns.push(release_fn)
  ctx.wrap_stack_scoped_self_slot_names.push(self_slot_name)
  ctx.wrap_stack_scoped_v_slot_names.push(v_slot_name)
end

## Pop one wrap-block entry. Called from NODE_WITH lowering BEFORE
## mir_emit_handle_uninstall runs (so during the natural-exit path the
## wrap is no longer "active" by the time uninstall runs).
def mir_ctx_pop_wrap(ctx: MirContext): Void
  if ctx.wrap_stack_eff_names.size == 0
    return
  end
  ctx.wrap_stack_eff_names.pop()
  ctx.wrap_stack_pop_counts.pop()
  ctx.wrap_stack_kinds.pop()
  ctx.wrap_stack_scoped_release_fns.pop()
  ctx.wrap_stack_scoped_self_slot_names.pop()
  ctx.wrap_stack_scoped_v_slot_names.pop()
end

## Emit MIR_EFFECT_POP_N instructions for every active wrap-block (top-down,
## reverse-LIFO order to match runtime stack discipline). Called from NODE_RETURN
## lowering BEFORE mir_block_set_terminator(TERM_RETURN, ...) so the runtime
## effect-stack is drained on the early-exit path. Does NOT pop the wrap-stack —
## the caller is still inside the lowering of the wrap's body, the natural
## fall-through (if reached) still needs the matching pop_wrap.
def mir_ctx_emit_active_wrap_pops(ctx: MirContext): Void
  var _i = ctx.wrap_stack_eff_names.size - 1
  while _i >= 0
    var _kind = ctx.wrap_stack_kinds[_i]
    if _kind == 1
      # B.8 Phase 4b: Scoped early-exit cleanup.
      #   1. effect_pop_n("Throws", 1)  — drain runtime stack of our
      #      throw-safety Throws frame.
      #   2. __qz_scoped_ctx_pop()      — drain TLS Scoped-ctx entry.
      #   3. <Struct>$release(self, v)  — normal release.
      # Throws.throw paths bypass this drain (the runtime handler does
      # its own cleanup before rethrowing), so the wrap-stack drain
      # only fires on NODE_RETURN / break / continue.
      mir_emit_effect_pop_n(ctx, "Throws", 1)
      var _pop_args = vec_new<Int>()
      mir_emit_call(ctx, "__qz_scoped_ctx_pop", _pop_args)
      var _rel = ctx.wrap_stack_scoped_release_fns[_i]
      # Phase 2d Bug 4 fix: load self from its slot (was an SSA reg that
      # didn't dominate yield-resume re-entry paths in async-future bodies).
      var _self_slot = ctx.wrap_stack_scoped_self_slot_names[_i]
      var _self = mir_emit_load_var(ctx, _self_slot)
      # Phase 6.5: load the CURRENT v from its slot before calling
      # release. The body may have reassigned v (write-back semantics),
      # and release must see that final value.
      var _slot = ctx.wrap_stack_scoped_v_slot_names[_i]
      var _v = mir_emit_load_var(ctx, _slot)
      var _args = vec_new<Int>()
      _args.push(_self)
      _args.push(_v)
      mir_emit_call(ctx, _rel, _args)
    else
      var _eff = ctx.wrap_stack_eff_names[_i]
      var _n = ctx.wrap_stack_pop_counts[_i]
      mir_emit_effect_pop_n(ctx, _eff, _n)
    end
    _i -= 1
  end
end

## Drain wrap-stack entries from current depth down to (but not including)
## target_depth. Used by NODE_BREAK / NODE_CONTINUE lowering: target_depth is
## the wrap-stack size captured at loop entry (loop_wrap_depth). Entries at
## indices >= target_depth correspond to `with E {...} do ... end` blocks
## opened INSIDE the loop body — those are the ones the break/continue is
## escaping and that need a runtime effect-stack pop.
##
## Like mir_ctx_emit_active_wrap_pops, does NOT modify the wrap-stack itself.
## The natural fall-through path still handles its own pops via mir_ctx_pop_wrap;
## break/continue is an alternate exit, not a replacement for that.
def mir_ctx_emit_wrap_pops_to_depth(ctx: MirContext, target_depth: Int): Void
  var _i = ctx.wrap_stack_eff_names.size - 1
  while _i >= target_depth
    var _kind = ctx.wrap_stack_kinds[_i]
    if _kind == 1
      # B.8 Phase 4b: Scoped wrap teardown on a break/continue path.
      # Same triple as mir_ctx_emit_active_wrap_pops — drain our Throws
      # frame, drain TLS Scoped-ctx, fire normal release.
      mir_emit_effect_pop_n(ctx, "Throws", 1)
      var _pop_args = vec_new<Int>()
      mir_emit_call(ctx, "__qz_scoped_ctx_pop", _pop_args)
      var _rel = ctx.wrap_stack_scoped_release_fns[_i]
      # Phase 2d Bug 4 fix: load self from its slot — break/continue
      # paths in async-future bodies have the same dominance problem
      # as the natural-exit and active-wrap drains.
      var _self_slot = ctx.wrap_stack_scoped_self_slot_names[_i]
      var _self = mir_emit_load_var(ctx, _self_slot)
      # Phase 6.5: load the CURRENT v from its slot — see the sibling
      # comment in mir_ctx_emit_active_wrap_pops above. break/continue
      # is just a different early-exit shape, same write-back semantics.
      var _slot = ctx.wrap_stack_scoped_v_slot_names[_i]
      var _v = mir_emit_load_var(ctx, _slot)
      var _args = vec_new<Int>()
      _args.push(_self)
      _args.push(_v)
      mir_emit_call(ctx, _rel, _args)
    else
      var _eff = ctx.wrap_stack_eff_names[_i]
      var _n = ctx.wrap_stack_pop_counts[_i]
      mir_emit_effect_pop_n(ctx, _eff, _n)
    end
    _i -= 1
  end
end

## Lookup innermost handler for (effect_name, op_name). Returns handler
## fn name as-int (lossless pointer-roundtrip via as_int/as_string); 0
## when no lexical match (perform falls back to dynamic stack scan).
## Matching discipline mirrors runtime __qz_effect_perform: effect name
## equality AND (filter empty OR filter == op_name).
def mir_ctx_lookup_handler(ctx: MirContext, eff: String, op_name: String): Int
  var _i = ctx.handler_stack_effs.size - 1
  while _i >= 0
    var _e = ctx.handler_stack_effs[_i]
    if _e.eq(eff)
      var _f = ctx.handler_stack_filters[_i]
      if str_byte_len(_f) == 0 or _f.eq(op_name)
        return ctx.handler_stack_handlers[_i]
      end
    end
    _i -= 1
  end
  return 0
end

## Companion to mir_ctx_lookup_handler: returns the install_dest register
## for the same innermost matching entry (or 0 when no match). Used by
## G-extended to thread `%wb.jmpbuf.<install_dest>` + `%wb.pretop.<install_dest>`
## into the kind=2 fast-path unwind codegen. Walks the stack with identical
## matching discipline to lookup_handler; callers should gate on the handler
## lookup's non-zero return rather than interpreting install_dest==0 alone
## (install_dest is a valid SSA register ID in general, though in practice
## never 0 — kept as a sentinel only for defensive null-path).
def mir_ctx_lookup_install_dest(ctx: MirContext, eff: String, op_name: String): Int
  var _i = ctx.handler_stack_effs.size - 1
  while _i >= 0
    var _e = ctx.handler_stack_effs[_i]
    if _e.eq(eff)
      var _f = ctx.handler_stack_filters[_i]
      if str_byte_len(_f) == 0 or _f.eq(op_name)
        return ctx.handler_stack_install_dests[_i]
      end
    end
    _i -= 1
  end
  return 0
end

## Emit a MIR_PERFORM_OP instruction for an effect-op invocation.
## `op_name` = the op being called (e.g. "throw"); `effect_name` = the
## declaring effect's name (e.g. "Throws"). `args` is a Vec<Int> of
## lowered argument registers, same shape as mir_emit_call. Returns the
## dest register; C.4 codegen stubs this to `add i64 0, 0`.
## Effects-system Phase 1 C.4.
## Effects G.1: operand1 is set to the lexical-handler fn name as-int (or
## 0 when no enclosing `with` block covers this perform). Codegen (G.2)
## uses this to fast-path kind<2 performs to a direct call.
def mir_emit_perform_op(ctx: MirContext, op_name: String, effect_name: String, kind: Int, args: Vec<Int>): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_PERFORM_OP, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, op_name)
  mir_instr_set_args(instr, args)
  # Effect name stashed in slot2 via as_int string-pointer trick (same
  # pattern as mir_emit_intrinsic_typed's elem_type). Op kind in slot1
  # (Effects F.3b): 0/1 = tail-resume (normal return), 2 = operation /
  # unwind (longjmp back to enclosing with-block after handler returns).
  mir_instr_set_slot1(instr, kind)
  mir_instr_set_slot2(instr, as_int(effect_name))
  # 4.B.7.b (item 9): flag Yield use at the universal perform-op chokepoint
  # so codegen installs the `@__qz_gen_yield_capture` default handler. Every
  # Yield perform — direct generator `yield` (mir_lower_gen.qz), the kind=3
  # Stream-consumer suspend, and `can Yield` helpers — routes through here,
  # so this is the never-under-set site. Same rationale + shape as Intern.
  if effect_name.eq("Yield")
    mir_set_uses_yield(mir_ctx_get_program(ctx))
  end
  # Effects G.1: consult the lexical handler stack. Stashed on operand1 as
  # the handler fn name's as-int (roundtrip via as_string in codegen).
  # Zero = no static match, use dynamic dispatch.
  var _static_handler = mir_ctx_lookup_handler(ctx, effect_name, op_name)
  mir_instr_set_operand1(instr, _static_handler)
  # Effects G-extended: also stash the matching install's dest register in
  # the `op` field so codegen can thread %wb.jmpbuf.<dest> and
  # %wb.pretop.<dest> into the kind=2 unwind fast path. We reuse `op`
  # rather than operand2 because operand2 is already occupied by
  # mir_instr_set_func_name (the op name); `op` is unused for
  # MIR_PERFORM_OP. Gated by the operand1 non-zero check (install_dest
  # is meaningful only when a handler was resolved).
  if _static_handler != 0
    var _static_install_dest = mir_ctx_lookup_install_dest(ctx, effect_name, op_name)
    mir_instr_set_op(instr, _static_install_dest)
  end
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_HANDLE_INSTALL marker at the start of a `with` body.
##
## `effect_name` = the effect the handler claims.
## `entries` = Vec<Int> of (op_filter_as_int, handler_fn_as_int) PAIRS,
## where each pair describes one runtime stack entry to push. A pair of
## (0, 0) means "null filter + null handler" (legacy IDENT-form fallback
## that lets the default handler fire). A pair of (op_filter, 0) means
## "filter on this op but no user handler" (unusual — routes to
## unhandled). A pair of (0, handler_fn) means "handle any op of this
## effect via handler_fn" (legacy single-op behavior; pre H-delegate).
## A pair of (op_filter, handler_fn) means "handle only this op via
## handler_fn, fall through otherwise" (H-delegate per-op install).
##
## Single-op `with E { op: h }` → entries = [intern("op"), intern(h)].
## Multi-op `with E { a: h1, b: h2 }` → entries = [intern("a"), intern(h1), intern("b"), intern(h2)].
## IDENT form `with E do ... end` → entries = [0, 0].
##
## Codegen emits the setjmp/result-slot frame ONCE and then N runtime
## install calls (N = entries.size / 2) that share the frame.
##
## Effects-system Phases 1/2: Milestones C.4, D.3, D.5, H (multi-op) —
## and H-delegate (per-op install + fall-through).
##
## `init_state_reg` (Phase 2, P2.a): MIR register holding the initial state
## value for stateful effects (`State<S>`). Sentinel `-1` means "no initial
## state" — ordinary effects (Throws, Log, Async, Reader, etc.) pass -1 and
## codegen skips the evidence-slot store. When >= 0, codegen emits a
## `store init_val, state_slots[pretop]` right after the first runtime
## install call so subsequent perform dispatches can read
## `state_slots[current_install_idx]`. Encoded as operand1=has_init flag +
## slot1=reg so a legitimate reg id of 0 is distinguishable from absent.
def mir_emit_handle_install(ctx: MirContext, effect_name: String, entries: Vec<Int>, init_state_reg: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_VOID)
  var instr = mir_new_instr(MIR_HANDLE_INSTALL, dest, MIR_TYPE_VOID)
  mir_instr_set_func_name(instr, effect_name)
  mir_instr_set_args(instr, entries)
  # 4.B.7.b (item 9): a `with Yield {...}` block (Stream consumer / custom
  # handler) also needs the default install present as the fallback below it.
  # Over-setting is harmless (installs an unused handler); never under-set.
  if effect_name.eq("Yield")
    mir_set_uses_yield(mir_ctx_get_program(ctx))
  end
  if init_state_reg >= 0
    mir_instr_set_operand1(instr, 1)
    mir_instr_set_slot1(instr, init_state_reg)
  end
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  # F.3b: return dest so the paired UNINSTALL can embed it into its own
  # slot — codegen uses install_dest as the unique label suffix to link
  # setjmp's catch label (emitted at INSTALL) with the done block
  # (emitted at UNINSTALL).
  return dest
end

## Emit a MIR_HANDLE_UNINSTALL marker at the end of a `with` body.
## Effects F.3b: takes `body_val` (the body's last register) so codegen
## can materialize the with-block's result. Returns a fresh dest
## register which aliases either body_val (normal path) or the
## unwound value stashed by __qz_effect_perform's kind=2 longjmp path
## (catch path). NODE_WITH's overall value is this dest.
## Effects-system Phase 1 Milestone C/D (C.4 + D.3),
## Phase 2 F.3b (unwind result threading).
def mir_emit_handle_uninstall(ctx: MirContext, effect_name: String, body_val: Int, install_dest: Int, pop_count: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_HANDLE_UNINSTALL, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, effect_name)
  # slot1 = body value (F.3b) — codegen stores this into the result slot
  # allocated at INSTALL, then the catch and body paths converge at the
  # done block via load.
  mir_instr_set_slot1(instr, body_val)
  # slot2 = matching INSTALL's dest register (F.3b) — lets codegen use
  # the same `.Nsuffix` label identifiers on both sides so %wb.bodyN,
  # %wb.catchN, %wb.doneN, and %wb.result_slotN line up across the pair.
  mir_instr_set_slot2(instr, install_dest)
  # operand1 = pop count (H-delegate) — number of stack entries to pop
  # at UNINSTALL. Matches the install's entry-pair count. Most with-
  # blocks today pop 1 (single-op or IDENT-form); multi-op records
  # pop N.
  mir_instr_set_operand1(instr, pop_count)
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_HANDLE_UNINSTALL_DONE_ONLY instruction — codegen renders ONLY
## the `wb.done.NN:` block (load + uninstall × pop_count), skipping the body
## fall-through prefix (store body_val + br label %wb.done.NN) that
## MIR_HANDLE_UNINSTALL emits. Used at NODE_WITH lowering when the body's
## last block is already terminated (return/break/continue inside body) —
## the early-exit path drained the runtime effect-stack via MIR_EFFECT_POP_N,
## but `wb.catch.NN`'s `br label %wb.done.NN` (emitted at MIR_HANDLE_INSTALL
## time) still needs `wb.done.NN` to be defined for valid IR.
##
## install_dest is the matching INSTALL's dest register so the `.NN` label
## suffix lines up. pop_count matches the install's entry-pair count.
def mir_emit_handle_uninstall_done_only(ctx: MirContext, effect_name: String, install_dest: Int, pop_count: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_HANDLE_UNINSTALL_DONE_ONLY, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, effect_name)
  mir_instr_set_slot2(instr, install_dest)
  mir_instr_set_operand1(instr, pop_count)
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit a MIR_EFFECT_POP_N instruction — codegen renders to N raw runtime
## pop calls (`@__qz_effect_handle_uninstall(eff)` × N) without the wb.* dance
## that MIR_HANDLE_UNINSTALL emits. Used by early-return cleanup to drain the
## runtime effect-stack on CFG edges that bypass the natural wrap teardown.
def mir_emit_effect_pop_n(ctx: MirContext, effect_name: String, pop_count: Int): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_EFFECT_POP_N, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, effect_name)
  mir_instr_set_operand1(instr, pop_count)
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_intrinsic(ctx: MirContext, name: String, args: Vec<Int>): Int
  # Cache-ro Bug B: MIR_INTRINSIC is also name-keyed dispatch. UFCS-category
  # intrinsics (e.g. "Mutex$lock") that don't match any cg_intrinsic_*
  # handler fall through codegen_intrinsics.qz's default and emit
  # `call @<name>` directly — the alias rewrite must apply here too so the
  # consumer-side call agrees with the cached canonical symbol.
  var _ci_canonical = mir_resolve_canonical(ctx, name)
  if str_byte_len(_ci_canonical) > 0
    name = _ci_canonical
  end
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_INTRINSIC, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, name)
  mir_instr_set_args(instr, args)
  # Get line from context if available
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Emit an intrinsic call with element type metadata.
## The element type string (e.g. "U8", "I16") is stored in slot2
## so codegen can emit width-specialized storage operations.
def mir_emit_intrinsic_typed(ctx: MirContext, name: String, args: Vec<Int>, elem_type: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_INTRINSIC, dest, MIR_TYPE_INT)
  mir_instr_set_func_name(instr, name)
  mir_instr_set_args(instr, args)
  mir_instr_set_slot2(instr, as_int(elem_type))
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_call_indirect(ctx: MirContext, fn_ptr: MirReg, args: Vec<Int>): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_CALL_INDIRECT, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, fn_ptr)
  mir_instr_set_args(instr, args)
  # Get line from context if available
  var line = ctx.line
  if line > 0
    mir_instr_set_line(instr, line)
  end
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_load_offset(ctx: MirContext, base_val: MirReg, offset: Int): Int
  # Load from struct/enum at given offset
  # Emit: dest = load(base + offset)
  # B.10 §14.12.8 (C3) — conditional COW +1. When the field-access site has marked
  # the receiver as a cow-layout buffer (refcount header at word 0), field f lives
  # at buffer word f+1. The flag is set ONLY around a cow field-access offset call,
  # so enums/closures/generators/ref-structs (flag never set for them) are
  # unaffected. INERT at gate 0 (flag never set ⇒ +1 never fires).
  var eff_offset = offset
  if ctx.cow_field_shift == 1
    eff_offset = offset + 1
  end
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_LOAD_OFFSET, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, base_val)
  mir_instr_set_slot2(instr, eff_offset)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_select(ctx: MirContext, cond: MirReg, true_val: MirReg, false_val: MirReg): Int
  # Select instruction: dest = cond ? true_val : false_val
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_SELECT, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, cond)
  mir_instr_set_operand2(instr, true_val)
  mir_instr_set_slot1(instr, false_val)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_alloc(ctx: MirContext, words: Int): Int
  # Allocate memory for struct/enum (words * 8 bytes)
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_ALLOC, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, words)
  mir_emit_instr(ctx, instr)
  return dest
end

def mir_emit_store_offset(ctx: MirContext, ptr: MirReg, offset: Int, value: MirReg): Void
  # Store value at ptr + offset - allocate unique ID for labels
  # B.10 §14.12.8 (C3) — conditional COW +1 (see mir_emit_load_offset). Field f of
  # a cow-layout buffer stores to word f+1 (word 0 = refcount header). Flag-gated
  # so non-cow stores (enums/closures/...) are byte-identical. INERT at gate 0.
  var eff_offset = offset
  if ctx.cow_field_shift == 1
    eff_offset = offset + 1
  end
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_STORE, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, ptr)
  mir_instr_set_operand2(instr, value)
  mir_instr_set_slot1(instr, eff_offset)
  mir_emit_instr(ctx, instr)
end

## Typed struct allocation: sets struct_name in operand1 for sizeof-via-GEP
def mir_emit_alloc_typed(ctx: MirContext, words: Int, struct_name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_ALLOC, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, words)
  mir_instr_set_operand1(instr, as_int(struct_name))
  mir_emit_instr(ctx, instr)
  return dest
end

## Stack allocation for @value structs: alloca instead of malloc
def mir_emit_alloc_stack(ctx: MirContext, words: Int, struct_name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_ALLOC_STACK, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, words)
  if str_byte_len(struct_name) > 0
    mir_instr_set_operand1(instr, as_int(struct_name))
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## B.10 §14.12 — emit an independent COPY of a `@value` struct value (value
## semantics). `src` is a pointer (i64 handle) to the source struct region; this
## allocates a fresh N-word region and word-copies every field so the result
## aliases NOTHING — `var b = a; b.x = 2` leaves `a` unchanged. v1 = EAGER copy
## (word loop); COW (>16B header-refcount, lazy make-unique) is a later
## optimization that replaces this for large structs. Called at copy-on-assign
## sites (NODE_LET-IDENT, assign, call-arg, field-init) gated on
## mir_value_semantics_live() AND mir_ctx_is_value_struct(struct_name). Returns
## `src` unchanged if the struct is unknown (field count <= 0) — a safe no-op.
def mir_emit_value_copy(ctx: MirContext, src: MirReg, struct_name: String): Int
  # B.10 §14.12.8 (C2) — COW O(1) copy. For a >16B FLAT @value struct (cow gate
  # live), a "copy" is an atomic refcount retain on the SAME buffer, NOT an O(n)
  # word-copy: cow_rc_inc(src) + share the buffer ptr. The deep copy is deferred
  # to first mutation (cow_make_unique, C3). DEAD at gate 0 (predicate false) ⇒
  # falls through to the eager loop below ⇒ gate-0 IR byte-identical. ≤16B / non-
  # value-layout / nested-@value structs also fall through (predicate false).
  #
  # CHECKED BEFORE the field-count guard: the cow retain shares the buffer pointer
  # and needs NO field count, whereas mir_ctx_struct_field_count does an EXACT
  # (unresolved) name match — for a module-qualified stdlib struct passed by its
  # bare name (`Style` ⇒ registry key `style$Style`) it returns -1, so the old
  # `n <= 0` early-return silently dropped the cow_rc_inc, leaving the caller's
  # scope-exit cow_release unbalanced ⇒ premature free / use-after-free of the
  # shared buffer (the empty-Style render_at heap-corruption repro). mir_value_is_
  # cow_layout resolves the name internally, so its verdict is correct here.
  if mir_value_is_cow_layout(ctx, struct_name) == 1
    var rc_args = vec_new<Int>()
    rc_args.push(as_int(src))
    mir_emit_intrinsic(ctx, "cow_rc_inc", rc_args)
    return src
  end
  # §14.11.8 — the ≤16B eager word-copy needs the struct's field count, but
  # mir_ctx_struct_field_count does an EXACT (unresolved) registry match. The 5
  # value-copy callsites pass a tracked var-type name, which for a module-qualified
  # stdlib struct is the BARE name (`Style` ⇒ registry key `style$Style`) ⇒ the
  # unresolved lookup returned -1, so the `n <= 0` guard skipped the copy and the
  # callee ALIASED the caller's struct (silent wrong-value). Resolve the name first
  # (mir_resolve_struct_name returns the input unchanged when unknown), exactly as
  # mir_value_is_cow_layout already does above. INERT at gate 0 (no @value structs).
  var resolved_sn = mir_resolve_struct_name(ctx, struct_name)
  var n = mir_ctx_struct_field_count(ctx, resolved_sn)
  if n <= 0
    return src
  end
  # item 24 — deep-copy nested @value members. A plain struct lays every field out
  # as ONE boxed word (LAYOUT_BOXED, 8*field_count), so a @value-layout member field
  # is stored as a POINTER to its own (separately-allocated) buffer. A bare word copy
  # would make `dst` ALIAS `src`'s member buffer: a later `dst.member.f = …` would
  # corrupt `src.member` — for a >16B cow member the make-unique sees rc==1 (never
  # bumped on this aggregate copy) and mutates in place; for an inline ≤16B member the
  # shared buffer is mutated directly. Recurse mir_emit_value_copy on each @value
  # member word, applying the SAME copy-on-assign mechanism per-member: cow member →
  # cow_rc_inc (a later mutate forks via make-unique); inline member → fresh eager
  # word-copy (already independent). Non-@value members keep the plain word copy.
  # Field types are read from the registry; resolves NOTHING for a struct with no
  # @value members ⇒ behavior identical to the bare loop. INERT at gate 0 (no @value
  # structs ⇒ this copy emitter is never reached AND no member resolves value-layout).
  var vc_field_types = vec_new<String>()
  var vc_fields_opt = mir_ctx_get_struct_fields(ctx, resolved_sn)
  if vc_fields_opt.is_some()
    vc_field_types = vc_fields_opt.unwrap().field_types
  end
  var vc_ft_count = vec_size(vc_field_types)
  # item 31 — the eager value-copy destination must be HEAP, not a stack alloca.
  # A copied @value struct can ESCAPE the emitting frame (returned by value, stored
  # into a longer-lived aggregate, threaded through a tuple). A stack-alloca dest
  # dangles the moment that frame unwinds, so a later consumer reads garbage. Before
  # item 24 this surfaced only as a silent wrong-value (the dangling words were
  # bit-copied); item 24's per-member cow_rc_inc recursion turned the SAME dangling
  # read into an atomicrmw on a non-pointer word (SIGABRT — the tui_viewport regress).
  # The member rc_inc is correct ONLY when the buffer it walks is live; heap-allocating
  # the copy guarantees that for the escaping case while staying byte-identical for the
  # non-escaping one (same word loop, only the allocation site changes). The dest is a
  # plain N-word region (the cow refcount-share path returned early above), so no +1
  # header shift applies. INERT at gate 0 (no @value structs ⇒ never emitted).
  var dst = mir_emit_alloc(ctx, n)
  for i in 0..n
    var w = mir_emit_load_offset(ctx, src, i)
    if i < vc_ft_count
      var vc_ft = as_string(vc_field_types[i])
      if mir_is_value_layout_type(ctx, vc_ft) == 1
        w = mir_emit_value_copy(ctx, w, vc_ft)
      end
    end
    mir_emit_store_offset(ctx, dst, i, w)
  end
  return dst
end

## B.10 §14.12.8 (C3) — construct a COW buffer for a cow-layout @value struct.
## Heap-allocates 1+N words (mir_emit_alloc = malloc): word 0 = atomic refcount
## initialized to 1, words 1..N = the N payload fields (written later by the
## construct site with the +1 shift flag set). Returns the buffer BASE pointer
## (offset 0, where the refcount lives) — the same pointer cow_rc_inc/dec operate
## on and that copies share (consistent with C2's mir_emit_value_copy reroute).
## Only called when mir_value_is_cow_layout(ctx, struct_name) == 1 (gate-guarded
## at the call site), so INERT at gate 0.
def mir_emit_cow_construct_buffer(ctx: MirContext, n_fields: Int, struct_name: String): Int
  var buf = mir_emit_alloc(ctx, 1 + n_fields)
  # refcount header at word 0 = 1 (shift flag OFF here ⇒ true offset 0).
  var one = mir_emit_const_int(ctx, 1)
  mir_emit_store_offset(ctx, buf, 0, one)
  return buf
end

## B.10 §14.12.8 (C3) — cow_make_unique ≡ Rust Arc::make_mut. Emitted BEFORE a
## field store into a cow-layout buffer that MIGHT be shared. Inline-MIR sequence
## (NOT codegen-threaded, per R1): load the atomic refcount at word 0; if rc == 1
## the buffer is uniquely owned ⇒ no-op (store in place); if rc > 1 it is shared ⇒
## allocate a fresh 1+N buffer, set its refcount = 1, SHALLOW bit-copy the N
## payload words (correct for FLAT structs — the only cow-eligible shape in C3; the
## per-COW-ptr-field witness retain is the C5 scan_map, DEFERRED), cow_rc_dec the
## old buffer (drop OUR share; another sharer keeps it alive ⇒ no free here), and
## REBIND to the fresh buffer. Realized via a synthetic local var that both arms
## write, reloaded after the merge so the caller's store targets the right buffer.
## Returns the (possibly new) buffer register. Only called when
## mir_value_is_cow_layout == 1 (gate-guarded at the call site) ⇒ INERT at gate 0.
def mir_emit_cow_make_unique(ctx: MirContext, buf: MirReg, n_fields: Int, struct_name: String): Int
  # Synthetic local that holds the effective buffer ptr across the branch.
  var slot_name = "__cow_mu_buf_#{ctx.cow_mu_seq.to_s()}"
  ctx.cow_mu_seq = ctx.cow_mu_seq + 1
  mir_emit_store_var(ctx, slot_name, buf)

  # rc = atomic_load(buf + 0). cow_rc_dec returns prior then re-incs? No — we need
  # a pure load. Read the refcount word directly (shift flag OFF ⇒ true offset 0).
  var rc = mir_emit_load_offset(ctx, buf, 0)
  var one = mir_emit_const_int(ctx, 1)
  # shared? rc > 1
  var is_shared = mir_emit_binary(ctx, 11, rc, one) # 11 = OP_GT

  var copy_block = mir_create_block(ctx, "cow_mu_copy")
  var merge_block = mir_create_block(ctx, "cow_mu_merge")
  var cur = mir_ctx_get_block(ctx)
  mir_block_set_branch(cur, is_shared, copy_block, merge_block)

  # ---- copy_block: rc > 1, deep-copy ----
  mir_switch_to_block(ctx, copy_block)
  var fresh = mir_emit_alloc(ctx, 1 + n_fields)
  var fresh_one = mir_emit_const_int(ctx, 1)
  mir_emit_store_offset(ctx, fresh, 0, fresh_one) # new refcount = 1
  # SHALLOW payload bit-copy: words 1..n_fields (header excluded). Shift flag OFF;
  # iterate true buffer words 1+i directly so the header is never clobbered.
  for i in 0..n_fields
    var w = mir_emit_load_offset(ctx, buf, 1 + i)
    mir_emit_store_offset(ctx, fresh, 1 + i, w)
  end
  # Drop our share of the old buffer (another sharer still holds it ⇒ no free).
  var dec_args = vec_new<Int>()
  dec_args.push(as_int(buf))
  mir_emit_intrinsic(ctx, "cow_rc_dec", dec_args)
  # Rebind the synthetic slot to the fresh buffer.
  mir_emit_store_var(ctx, slot_name, fresh)
  var copy_cur = mir_ctx_get_block(ctx)
  mir_block_set_terminator(copy_cur, TERM_JUMP, merge_block)

  # ---- merge_block: reload effective buffer ----
  mir_switch_to_block(ctx, merge_block)
  return mir_emit_load_var(ctx, slot_name)
end

## B.10 §14.12.8 (C4) — emit nested drops for a cow-layout buffer's payload fields,
## accounting for the +1 header shift. Mirrors `emit_nested_drops` but loads field
## `f` from buffer word `f+1` (the COW payload lives after the refcount header at
## word 0). Only droppable ref-handle fields (a ref-struct with a Drop impl, or a
## struct that transitively needs drop) get a drop call; scalars and non-droppable
## handles are skipped. The flatness rail (mir_value_is_cow_layout) guarantees NO
## nested value-layout COW-ptr field reaches here (those force eager fallback), so
## the field drops are exclusively for ref-handle (boxed) droppables. Gate-guarded
## by the caller ⇒ INERT at gate 0.
def mir_emit_cow_nested_drops(ctx: MirContext, buf: MirReg, struct_name: String): Void
  var struct_info = mir_ctx_get_struct_fields(ctx, struct_name)
  return if struct_info.is_none()
  var si = struct_info.unwrap()
  var field_names = si.field_names
  var field_types = si.field_types
  var field_count = vec_size(field_names)
  # Route field loads through the +1 COW shift so word 0 (refcount) is never read
  # as a field. Save/restore the flag so we don't leak the shift to siblings.
  var saved_shift = ctx.cow_field_shift
  ctx.cow_field_shift = 1
  for f in 0..field_count
    var field_type = as_string(field_types[f])
    if type_needs_drop(ctx, field_type)
      # Load field f from payload word f+1 (the flag adds the +1).
      var field_val = mir_emit_load_offset(ctx, buf, f)
      # Temporarily clear the shift while recursing/dropping the field value:
      # the field's OWN layout (a ref-struct) is flat-offset, not cow-shifted.
      ctx.cow_field_shift = 0
      if type_has_drop(ctx, field_type)
        var drop_func = string_intern::mangle(field_type, "drop")
        var all_funcs = mir_ctx_get_all_funcs(ctx)
        if all_funcs != 0
          var drop_suffix = "$#{drop_func}"
          for dfi in 0..all_funcs.size
            var dfe = all_funcs[dfi]
            if dfe.tag == 0 and str_ends_with(dfe.name, drop_suffix)
              drop_func = dfe.name
              break
            end
          end
        end
        var args = vec_new()
        args.push(field_val)
        mir_emit_call(ctx, drop_func, args)
      end
      emit_nested_drops(ctx, field_val, field_type)
      ctx.cow_field_shift = 1
    end
  end
  ctx.cow_field_shift = saved_shift
end

## B.10 §14.12.8 (C4.5/h6) — retain a cow-layout @value buffer that is READ OUT of
## a collection/index into a NEW owner binding (`r = v[0]`, `r = v.get(i)`). The C3.5
## read path returns the bare buffer POINTER from the Vec slot (the cow value IS its
## handle), so binding it WITHOUT a retain would alias the element: mutating `r`
## (make-unique fires only if rc>1) would corrupt `v[0]`, and dropping `v` would free
## the buffer out from under `r` (UAF). This is the exact value-semantics copy concept
## `mir_emit_value_copy` applies to `var b = a` (cow_rc_inc + share-ptr), reused here
## for the read-out bind site. The bound `r` is pushed droppable by the caller so the
## new reference is released at scope exit (the symmetric cow_rc_dec). Only called when
## mir_value_is_cow_layout == 1 (gate-guarded at the call site) ⇒ INERT at gate 0.
def mir_emit_cow_retain(ctx: MirContext, buf: MirReg): Void
  var rc_args = vec_new<Int>()
  rc_args.push(as_int(buf))
  mir_emit_intrinsic(ctx, "cow_rc_inc", rc_args)
end

## B.10 §14.12.8 (C4) — Drop-class destroy witness for a cow-layout @value buffer.
## `cow_release(buf)` ≡ `prior = cow_rc_dec(buf); if prior == 1 { nested drops; free }`.
## The atomic dec returns the PRIOR refcount; prior == 1 ⇒ this was the LAST
## reference (new count 0) ⇒ run drops for any droppable payload fields (offset+1)
## THEN free the buffer via qz_free; prior > 1 ⇒ another sharer holds the buffer,
## so we only relinquish our reference (no drop, no free). Emitted on the NORMAL
## scope-exit path by emit_drops_for_scope; a throw/panic unwinds via longjmp and
## SKIPS this MIR (accept-leak-on-throw, RATIFIED §14.11.7 decision 3 — matches
## trait Drop, which also does not run on unwind). Return-move is suppressed
## upstream: a returned cow local is removed from the droppable stack by
## mir_consume_droppable BEFORE the scope sweep, so it never reaches here. Only
## called when mir_value_is_cow_layout == 1 (gate-guarded) ⇒ INERT at gate 0.
def mir_emit_cow_release(ctx: MirContext, buf: MirReg, struct_name: String): Void
  # prior = cow_rc_dec(buf)  (atomic sub, returns prior refcount in dest)
  var dec_args = vec_new<Int>()
  dec_args.push(as_int(buf))
  var dec_dest = mir_emit_intrinsic(ctx, "cow_rc_dec", dec_args)

  var one = mir_emit_const_int(ctx, 1)
  # last reference? prior == 1  (7 = OP_EQ)
  var is_last = mir_emit_binary(ctx, 7, dec_dest, one)

  var free_block = mir_create_block(ctx, "cow_free")
  var done_block = mir_create_block(ctx, "cow_free_done")
  var cur = mir_ctx_get_block(ctx)
  mir_block_set_branch(cur, is_last, free_block, done_block)

  # ---- free_block: prior == 1 ⇒ refcount now 0 ⇒ destroy ----
  mir_switch_to_block(ctx, free_block)
  # A user `Drop` impl on the cow struct itself fires exactly once, when the LAST
  # reference dies (here), receiving the buffer ptr as `self`.
  if type_has_drop(ctx, struct_name)
    var udrop = string_intern::mangle(struct_name, "drop")
    var all_funcs = mir_ctx_get_all_funcs(ctx)
    if all_funcs != 0
      var udrop_suffix = "$#{udrop}"
      for ufi in 0..all_funcs.size
        var ufe = all_funcs[ufi]
        if ufe.tag == 0 and str_ends_with(ufe.name, udrop_suffix)
          udrop = ufe.name
          break
        end
      end
    end
    var udrop_args = vec_new()
    udrop_args.push(as_int(buf))
    mir_emit_call(ctx, udrop, udrop_args)
  end
  # Run drops for droppable payload fields BEFORE freeing the buffer memory.
  mir_emit_cow_nested_drops(ctx, buf, struct_name)
  var free_args = vec_new<Int>()
  free_args.push(as_int(buf))
  mir_emit_intrinsic(ctx, "qz_free", free_args)
  var free_cur = mir_ctx_get_block(ctx)
  mir_block_set_terminator(free_cur, TERM_JUMP, done_block)

  # ---- done_block ----
  mir_switch_to_block(ctx, done_block)
end

## Extract raw data pointer from Vec handle (hoisted before loops).
## Returns the raw data pointer as an i64 (will be inttoptr'd in codegen).
def mir_emit_vec_data_ptr(ctx: MirContext, vec_reg: MirReg, elem_type: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_VEC_DATA_PTR, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, vec_reg)
  if str_byte_len(elem_type) > 0
    mir_instr_set_slot2(instr, as_int(elem_type))
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Raw index get: load element from data_ptr[idx] with no bounds check.
## data_ptr is a raw pointer (from MIR_VEC_DATA_PTR), not a Vec handle.
def mir_emit_index_raw(ctx: MirContext, data_ptr: MirReg, idx: MirReg, elem_type: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_INDEX_RAW, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, data_ptr)
  mir_instr_set_operand2(instr, idx)
  if str_byte_len(elem_type) > 0
    mir_instr_set_slot2(instr, as_int(elem_type))
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Raw index store: store val into data_ptr[idx] with no bounds check.
def mir_emit_index_store_raw(ctx: MirContext, data_ptr: MirReg, idx: MirReg, val: Int, elem_type: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_INDEX_STORE_RAW, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, data_ptr)
  mir_instr_set_operand2(instr, idx)
  var args = vec_new()
  args.push(val)
  mir_instr_set_args(instr, args)
  if str_byte_len(elem_type) > 0
    mir_instr_set_slot2(instr, as_int(elem_type))
  end
  mir_emit_instr(ctx, instr)
  return dest
end

## Typed struct field store: sets struct_name in slot2, field_type in op
def mir_emit_store_field(ctx: MirContext, ptr: MirReg, offset: Int, value: MirReg, struct_name: String, field_type: String): Void
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_STORE, dest, MIR_TYPE_INT)
  mir_instr_set_operand1(instr, ptr)
  mir_instr_set_operand2(instr, value)
  mir_instr_set_slot1(instr, offset)
  mir_instr_set_slot2(instr, as_int(struct_name))
  instr.op = as_int(field_type)
  mir_emit_instr(ctx, instr)
end

## B.10 §12.9 — typed interior field address (no load). slot1=base reg,
## slot2=field index, operand1=struct_name. Emits a `%struct.Name` GEP and
## ptrtoint, yielding the field's address as an i64.
def mir_emit_field_addr(ctx: MirContext, base: MirReg, field_idx: Int, struct_name: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_FIELD_ADDR, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, base)
  mir_instr_set_slot2(instr, field_idx)
  mir_instr_set_operand1(instr, as_int(struct_name))
  mir_emit_instr(ctx, instr)
  return dest
end

## Typed struct field load: sets struct_name in operand1, field_type in operand2
def mir_emit_load_field(ctx: MirContext, base: MirReg, offset: Int, struct_name: String, field_type: String): Int
  var dest = mir_emit_value(ctx, MIR_TYPE_INT)
  var instr = mir_new_instr(MIR_LOAD_OFFSET, dest, MIR_TYPE_INT)
  mir_instr_set_slot1(instr, base)
  mir_instr_set_slot2(instr, offset)
  mir_instr_set_operand1(instr, as_int(struct_name))
  mir_instr_set_operand2(instr, as_int(field_type))
  mir_emit_instr(ctx, instr)
  return dest
end

# Short-circuit helper: emit a branch instruction
def mir_emit_branch(ctx: MirContext, cond: MirReg, true_label: MirLabel, false_label: MirLabel): Void
  var cur_block = mir_ctx_get_block(ctx)
  mir_block_set_branch(cur_block, cond, true_label, false_label)
end

# Short-circuit helper: emit an unconditional jump
def mir_emit_jump(ctx: MirContext, target_label: MirLabel): Void
  var cur_block = mir_ctx_get_block(ctx)
  mir_block_set_terminator(cur_block, TERM_JUMP, target_label)
end

# Emit a return terminator with the given value
def mir_emit_return(ctx: MirContext, val: MirReg): Void
  var cur_block = mir_ctx_get_block(ctx)
  mir_block_set_terminator(cur_block, TERM_RETURN, val)
end

# ============================================================================
# Enum variant index lookup
# ============================================================================
# Get enum registry from context (slots 15, 16, 17 - pushed after struct slots 13-14)
def mir_ctx_get_enum_names(ctx: MirContext): Vec<String> = ctx.enum_names

def mir_ctx_get_enum_variants(ctx: MirContext): Vec<Vec<String>> = ctx.enum_variants

def mir_ctx_get_enum_variant_field_types(ctx: MirContext): Vec = ctx.enum_variant_field_types

def mir_ctx_get_enum_has_payloads(ctx: MirContext): Vec<Int> = ctx.enum_has_payloads

## Look up the field-type vector for a specific variant. Returns 0 if the
## enum or variant isn't registered (e.g., built-in Option/Result, or a name
## resolution miss). Caller should treat 0 as "no info, do nothing."
def mir_ctx_lookup_variant_field_types(ctx: MirContext, enum_name: String, variant_name: String): Int
  var enum_names = mir_ctx_get_enum_names(ctx)
  return 0 if enum_names == 0
  var per_enum = mir_ctx_get_enum_variant_field_types(ctx)
  return 0 if per_enum == 0
  var variants = mir_ctx_get_enum_variants(ctx)
  return 0 if variants == 0
  var n = enum_names.size
  for i in 0..n
    if enum_names[i] == enum_name
      var v_names = variants[i]
      return 0 if v_names == 0
      var vn = v_names.size
      for j in 0..vn
        if as_string(v_names[j]) == variant_name
          var per_variant = per_enum[i]
          return 0 if per_variant == 0
          return 0 if j >= per_variant.size
          return per_variant[j]
        end
      end
    end
  end
  return 0
end

## Null-safe single-field accessor over the variant-field-type registry: the
## declared type STRING of `variant_name`'s `field_idx`-th field, or "" if the
## enum/variant/field isn't registered. Wraps mir_ctx_lookup_variant_field_types
## with the exact bounds-guarded read used at the nested-bind read sites
## (mir_nested_bind_payload_type), so construct-side callers (the spill-outer
## payload-slot niche_expected priming) recover a slot's declared type without
## re-implementing the index dance (which mis-typed the Vec handle and crashed).
def mir_ctx_variant_field_type_str(ctx: MirContext, enum_name: String, variant_name: String, field_idx: Int): String
  var fts = mir_ctx_lookup_variant_field_types(ctx, enum_name, variant_name)
  return "" if fts == 0
  return "" if field_idx >= fts.size
  return as_string(fts[field_idx])
end

## Apply primitive-type tracking for a list of match-pattern binding names
## given the enum/variant context. Today this only marks String fields so
## the string-interp unwrap helper can elide runtime to_str dispatch on
## WASM. Extend with other primitive markers as backends need them.
def mir_mark_pattern_bindings_typed(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, enum_name: String, variant_name: String, names: Vec<String>): Void
  var field_types = mir_ctx_lookup_variant_field_types(ctx, enum_name, variant_name)
  return if field_types == 0
  var name_count = names.size
  var type_count = field_types.size
  var limit = name_count
  if type_count < limit
    limit = type_count
  end
  # B.10 §14 N3 6.3b — for a single-payload Option/Result match, the declared
  # field type is the abstract enum type-param `T`, which loses the niche verdict
  # the bound payload's subsequent reads need (e.g. `match oi { Some(inner) =>
  # inner is None }` where `oi: Option<Option<Point>>` binds `inner: Option<Point>`
  # — a niche-eligible Option whose `is None` must be the niche range-test, not a
  # tagged load@0). Recover the CONCRETE payload type from the subject and override
  # the tracked type ONLY when the bound payload is itself an `Option<X>` whose own
  # standalone layout niches (i.e. `Option<X>` niche-reads as a subject) — that is
  # the case the abstract `T` masks. NOTE: the gate is `mir_option_is_niche` on the
  # INNER payload `X`, not on `concrete_pl` itself: `concrete_pl` is `Option<X>`,
  # which `mir_option_is_niche` rejects (nested-Option carve-out for the OUTER
  # layout), but `inner` read on its own DOES niche. INERT when the master flag is
  # OFF (returns 0 ⇒ no override ⇒ byte-identical IR), niche-class-only when ON.
  var concrete_pl = ""
  if name_count == 1
    if enum_name == "Option" or enum_name == "Result"
      concrete_pl = mir_enum_payload_concrete_type(ctx, s, subject_node, enum_name, variant_name)
    end
  end
  for i in 0..limit
    var bname = as_string(names[i])
    if bname != "_"
      var ftype = as_string(field_types[i])
      if i == 0
        if str_byte_len(concrete_pl) > 0
          # Payload-type de-erasure (Phase 1): carry the CONCRETE monomorphic
          # payload type for the binding, not the abstract enum field-type `T`.
          # This is the type `mir_set_pending_inline_for_enum` reads to select
          # interior-address (inline value struct) vs boxed-load at the match-arm
          # bind. Previously ONLY a nested `Option<X>` payload was recovered (and
          # only when its inner niched), so a PLAIN struct payload — `match inner
          # { Some(p) => p.x }` where `inner: Option<Point>` — kept the abstract
          # `T`, fell to the boxed-load path, and bound a loaded scalar as if it
          # were a pointer → `p.x` dereferenced `42` → runtime SIGSEGV. The
          # recovery chains: the outer `Some(inner)` now tracks `inner` concretely,
          # which lets the inner match resolve `p`'s concrete `Point`.
          # `mir_enum_payload_concrete_type` returns "" when the subject is erased
          # (→ keep `T`) or the abstract param itself, and a real resolved type
          # name otherwise, so this only tightens — it never fabricates a type.
          ftype = concrete_pl
        end
      end
      if str_byte_len(ftype) > 0
        # Track the binding's declared payload type so mir_infer_expr_type can
        # resolve field access / UFCS method dispatch on it — e.g. `.size` on a
        # `Vec<T>` payload lowers to the vec_size intrinsic. Without this a
        # non-String payload binding had no tracked MIR type, so a `.size` in a
        # typecheck-skipped context (a while-condition inside a curly-block
        # match arm) fell through to the offset-0 field-access fallback and
        # read the wrong word at runtime (HB-DOG.6).
        mir_ctx_mark_struct_var(ctx, bname, ftype)
        if ftype == "String"
          mir_ctx_mark_string_var(ctx, bname)
        end
      end
    end
  end
end

# Check if an enum has any payload variants (requires allocation)
# Returns 1 if enum needs pointer representation, 0 for simple tag-only
def mir_enum_has_payloads(ctx: MirContext, enum_name: String): Int
  # Built-in Option always has payload (Some has value)
  return 1 if enum_name == "Option"
  # Built-in Result always has payload (Ok/Err have values)
  return 1 if enum_name == "Result"
  
  # Look up in registry
  var names = mir_ctx_get_enum_names(ctx)
  var flags = mir_ctx_get_enum_has_payloads(ctx)
  
  return 0 if names == 0
  return 0 if flags == 0
  
  var names_len = names.size
  for i in 0..names_len
    var stored_name = names[i]
    return flags[i] if stored_name == enum_name
  end
  
  # Unknown enum - default to no payloads (simple)
  return 0
end

# Extract enum tag from a value - handles both simple and payload enums
# Simple enum: value IS the tag (i64)
# Payload enum: value is pointer, tag at offset 0
def mir_get_enum_tag(ctx: MirContext, enum_name: String, enum_val: MirReg): Int
  var has_payloads = mir_enum_has_payloads(ctx, enum_name)
  if has_payloads == 0
    # Simple enum: value is already the tag
    return enum_val
  end
  # Payload enum: load tag from offset 0
  return mir_emit_load_offset(ctx, enum_val, 0)
end

# Find variant index by enum name and variant name
# Uses context for custom enum lookup, hardcoded for built-ins
def mir_find_variant_index_ctx(ctx: MirContext, enum_name: String, variant_name: String): Int
  # Built-in Option: Some=0, None=1
  if enum_name == "Option"
    return 0 if variant_name == "Some"
    return 1 if variant_name == "None"
  end
  
  # Built-in Result: Ok=0, Err=1  
  if enum_name == "Result"
    return 0 if variant_name == "Ok"
    return 1 if variant_name == "Err"
  end
  
  # Look up in registry from context
  var enum_names = mir_ctx_get_enum_names(ctx)
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  
  if enum_names == 0
    # Fallback for legacy: check variant name only
    return 0 if variant_name == "Some"
    return 1 if variant_name == "None"
    return 0 if variant_name == "Ok"
    return 1 if variant_name == "Err"
    return 0
  end
  
  return mir_find_variant_in_vectors(enum_names, enum_variants, enum_name, variant_name)
end

## Resolve a base enum name to its fully qualified name.
##
## When code references `Color::Red` but `Color` is defined in module `mod_colors`,
## the enum was registered as `mod_colors$Color`. This function finds the qualified
## name by searching the enum registry for an entry that ends with `$base_name`.
##
## Returns:
##   - The qualified name (e.g., "mod_colors$Color") if found in registry
##   - The base_name itself if it's a local enum or builtin (Option, Result)
def mir_resolve_enum_name(ctx: MirContext, base_name: String): String
  # Built-in enums don't need resolution
  return base_name if base_name == "Option"
  return base_name if base_name == "Result"
  
  var enum_names = mir_ctx_get_enum_names(ctx)
  return base_name if enum_names == 0
  
  # Build the suffix to search for: "$Color"
  var suffix = "$#{base_name}"
  
  # Search for a registered enum that ends with this suffix
  var count = enum_names.size
  for i in 0..count
    var registered_name = enum_names[i]
    
    # Check if registered_name ends with suffix
    var reg_len = str_byte_len(registered_name)
    var suffix_len = str_byte_len(suffix)

    if reg_len >= suffix_len
      var end_part = str_byte_slice(registered_name, reg_len - suffix_len, reg_len)
      return registered_name if end_part == suffix
    end

    # Also check for exact match (local enum without prefix)
    return base_name if registered_name == base_name
  end
  
  # Not found in registry - return base_name as fallback
  return base_name
end

## Search all registered enums for a variant name.
## Returns the (resolved) enum name if the variant is found, or empty string if not.
## This is used to resolve bare/unqualified variant names in match patterns.
def mir_find_enum_by_variant(ctx: MirContext, variant_name: String): String
  var enum_names = mir_ctx_get_enum_names(ctx)
  return "" if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return "" if enum_variants == 0
  var count = enum_names.size
  for i in 0..count
    var variants = enum_variants[i]
    var vcount = variants.size
    for v in 0..vcount
      if variants[v] == variant_name
        return enum_names[i]
      end
    end
  end
  return ""
end

## Resolve the enum name for an `is X` predicate, preferring the subject's
## static type over a global registry-wide variant search.
##
## IS_PREDICATE_CROSS_ENUM_TAG_COLLISION (sister: is_none_non_option_segfault):
## the legacy `mir_find_enum_by_variant` returns the FIRST enum with a variant
## by that name. When two enums in scope share a variant name, that picks the
## wrong enum and `mir_get_enum_tag` reads the tag against an unrelated enum's
## payload shape — silent miscompare or SIGSEGV depending on registry agreement.
##
## Strategy: infer subject's type via `mir_infer_expr_type` (returns annotations
## like "Cmd<Int>", "Option<T>", etc), strip generic args, resolve through the
## registry, and verify the named variant lives in that enum. On miss, fall
## back to the legacy global search so Int-erased generic receivers and other
## shapes that lose type info still work.
def mir_resolve_is_enum(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, variant_name: String): String
  if subject_node >= 0
    var inferred = mir_infer_expr_type(ctx, s, subject_node)
    if str_byte_len(inferred) > 0
      var base = inferred
      var lt_pos = __char_index(base, '<')
      if lt_pos > 0
        base = str_byte_slice(base, 0, lt_pos)
      end
      var resolved = mir_resolve_enum_name(ctx, base)
      var enum_names = mir_ctx_get_enum_names(ctx)
      if resolved == "Option" or resolved == "Result"
        return resolved
      end
      if enum_names != 0
        var enum_variants = mir_ctx_get_enum_variants(ctx)
        var rcount = enum_names.size
        for ri in 0..rcount
          if enum_names[ri] == resolved
            var variants = enum_variants[ri]
            var vcount = variants.size
            for vj in 0..vcount
              return resolved if variants[vj] == variant_name
            end
            # Subject's enum is registered but the variant is NOT in it.
            # Returning "" forces the caller into the legacy global search;
            # typecheck has already emitted QZ0231 when this is reachable
            # via a NODE_IDENT subject. For non-ident subjects (where TC
            # couldn't validate), the legacy lookup at least keeps codegen
            # producing well-formed IR — runtime semantics remain wrong
            # but no worse than the pre-fix behaviour.
            return ""
          end
        end
      end
    end
  end
  # Subject's type unknown (Int-erased generic, untyped param, etc.).
  return mir_find_enum_by_variant(ctx, variant_name)
end

# Legacy wrapper for backward compatibility (uses hardcoded only)
def mir_find_variant_index(enum_name: String, variant_name: String): Int
  # Built-in Option: Some=0, None=1
  if enum_name == "Option"
    return 0 if variant_name == "Some"
    return 1 if variant_name == "None"
  end
  
  # Built-in Result: Ok=0, Err=1  
  if enum_name == "Result"
    return 0 if variant_name == "Ok"
    return 1 if variant_name == "Err"
  end
  
  # Fallback for legacy code that doesn't have enum context
  return 0 if variant_name == "Some"
  return 1 if variant_name == "None"
  return 0 if variant_name == "Ok"
  return 1 if variant_name == "Err"
  
  # For custom enums, look up in the registry passed via context
  # The registry is stored in MIR context slot 15 (enum_names) and 16 (enum_variants)
  return 0
end

# Look up variant in registry vectors
def mir_find_variant_in_vectors(enum_names: Vec<String>, enum_variants: Vec<Vec<String>>, enum_name: String, variant_name: String): Int
  return 0 if enum_names == 0
  
  var enum_count = enum_names.size
  for i in 0..enum_count
    var stored_name = enum_names[i]
    if stored_name == enum_name
      # Found enum, search for variant
      var variants = enum_variants[i]
      var variant_count = variants.size
      for j in 0..variant_count
        var v_name = variants[j]
        return j if v_name == variant_name
      end
      return 0
    end
  end
  return 0
end

def mir_ctx_set_pending_bind(ctx: MirContext, names: Vec<String>, base_val: MirReg): Void
  ctx.pending_bind_names = names
  ctx.pending_bind_base = base_val
  # Default to no inline flags; mir_set_pending_inline_for_enum overrides when
  # the matched variant carries an inline @value payload (§12.10).
  ctx.pending_bind_inline = vec_new<Int>()
end

## enum-niche tail item 6 — record one nested inner-payload bind for the current
## match arm. `recovered_reg` is the already-recovered inner payload (from
## mir_bind_enum_payload_nested, emitted in item 1's inner_check_block which
## dominates the arm block); `concrete_type` is the inner payload's type (for
## mir_ctx_mark_struct_var). Drained + reset per arm by mir_ctx_apply_pending_bind.
def mir_ctx_push_nested_bind(ctx: MirContext, name: String, recovered_reg: MirReg, concrete_type: String, is_inline: Int): Void
  ctx.pending_nested_bind_names.push(name)
  ctx.pending_nested_bind_regs.push(as_int(recovered_reg))
  ctx.pending_nested_bind_types.push(concrete_type)
  # item 40 — 1 iff `recovered_reg` is an interior address into the outer enum box
  # (inline-embedded value-layout inner payload); the drain marks the name
  # arena-owned so field reads use flat offset+0. Set by the caller from
  # mir_nested_bind_is_inline (mirrors mir_bind_enum_payload_nested's verdict).
  ctx.pending_nested_bind_inline.push(is_inline)
end

## B.10 §12.10 — Strip top-level generic args: "Foo<X>" → "Foo" (no-op otherwise).
def mir_strip_generic_head(t: String): String
  var lt = __char_index(t, '<')
  return t if lt < 0
  return str_byte_slice(t, 0, lt)
end

## B.10 §12.10 — Concrete payload type of the matched variant, recovered from the
## match subject's static type. v1 covers built-in Option/Result single-payload
## variants: Option<X>/Some → X ; Result<X,Y>/Ok → X ; Result<X,Y>/Err → Y.
## Returns "" when the shape isn't an inline-eligible single-payload variant.
def mir_enum_payload_concrete_type(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, enum_name: String, variant_name: String): String
  var subj_type = mir_infer_expr_type(ctx, s, subject_node)
  return "" if str_byte_len(subj_type) == 0
  var args = mir_type_args_of(subj_type)
  if enum_name == "Option"
    if variant_name == "Some"
      return as_string(args[0]) if args.size >= 1
    end
    return ""
  end
  if enum_name == "Result"
    if variant_name == "Ok"
      return as_string(args[0]) if args.size >= 1
    end
    if variant_name == "Err"
      return as_string(args[1]) if args.size >= 2
    end
    return ""
  end
  return ""
end

# ============================================================================
# B.10 Phase 4 N1 — niche layout (the single source of truth + type plumbing)
# ============================================================================
# `niche.qz` is the pure decision core; the bridge below is the ONE adapter the
# codegen consults, so the niche-vs-spill verdict can never diverge between
# where an `Option` is built and where it is read (the §14.4 mixed-rep hazard).
# `Option` is the only enum N1 niches: exactly single-payload (`Some`) + single-
# dataless (`None`), so the §14.3 router is `enum_layout(1, 1, payload)`.
# (`Result` is two-payload ⇒ SPILL, byte-identical to today.)
#
# `payload_type` MUST be the *concrete monomorphic* payload type (e.g. "Bool").
# An abstract type-param ("T") is not "Bool"/borrow ⇒ `type_niche` → none ⇒
# SPILL, so a generic `Option<T>` body always spills. The diagnostic forbids a
# niche-bearing `Option<concrete>` from ever reaching such an erased body, which
# keeps the single-body-serves-both erasure sound.
#
# Niche representation (i64-existential word model): the value flows as an i64
# holding the bare payload — `0/1` for `Some(false/true)`, the niche constant
# (`2` for `Bool`) for `None`. Same slot type as today's pointer, so vars/args/
# returns are representation-compatible; only the interpreting sites change
# (construction = identity/const, tag-read = range test, payload-bind = identity).

# ============================================================================
# B.10 Phase 4 N3 (item 6.1) — boxed-pointer null niche, PHASE 1 scaffolding
# ============================================================================
# The §14 boxed-pointer null niche makes `Option<any boxed heap T>` zero-cost:
# the all-zero bit-pattern (`nil`) is an extra inhabitant of every boxed heap
# reference, so `None` can reuse it instead of a separate tag word. This is the
# big surface co-dependent with B.15 (mandatory `Option`), because once `nil`=0
# is the `None` niche over boxed types, a bare `0`/`nil` flowing into a boxed
# slot would alias `None` — the soundness wall typecheck enforces (QZ0213/4/5).
#
# This whole block is PHASE-1 SCAFFOLDING and is provably INERT: the master flag
# `mir_boxed_niche_enabled()` returns 0, so `mir_payload_is_boxed` short-circuits
# to 0 before any classification runs, and the boxed branch in `mir_option_is_niche`
# never fires. The carve-out logic in `mir_payload_is_boxed_classify` is therefore
# dead code in Phase 1 (intentionally — it exists for review + the later flip, and
# is unit-tested directly via the classify helper). A later human-supervised phase
# flips the flag to 1, at which point the existing niche read/construct sites
# (already routed through this bridge) light up for boxed payloads automatically.

## Master flag for the N3 boxed-pointer null niche. 0 = OFF (Phase 1: inert).
## While this returns 0 the boxed-niche branch NEVER fires, so emitted IR is
## byte-identical to pre-N3. A later phase flips this to 1.
##
## PHASE 3b FLIP ATTEMPT 2 (parked — see BLOCKER below). Attempt 1's payload-
## projection asymmetries are now FIXED (see "§14 N3 6.3b" sites): the call-site
## intercept's subject type is recovered as the CONCRETE monomorphized type, the
## safe-field-access (`u?.field`) read is niche-aware, match-arm bindings of a
## niche-`Option<X>` payload track `Option<X>` so their `is None` niche-reads, and
## a niche `Option<X>` nested inside a SPILL outer is niche-CONSTRUCTED (mixed-rep
## fix). With these, the staged bootstrap now CONVERGES: gen1→gen2→gen3 all build
## rc=0 and `quake fixpoint` verifies gen1==gen2 byte-identical (2829 fns). The 16-
## test option_boxed_struct_niche_spec passes 16/16 UNDER niche (incl. unwrap().x +
## nested Some(None)≠None). All Part-A fixes are flag-gated ⇒ INERT with this flag
## at 0 (verified: golden vs flag-OFF self-IR byte-identical on style_demo/brainfuck
## /the niche spec; fixpoint self-reproduces).
##
## 4th asymmetry (qzmod cache codec) — FIXED (item 6.3b). The codec's
## `mir_unpickle_function` builds its `Option<MirFunc>` via the BARE
## `option_some(func)` / `option_none()` INTRINSIC calls, whose codegen in
## cg_intrinsic_memory.qz unconditionally allocs a TAGGED 16-byte box; the read
## side (`maybe.some?` / `maybe.unwrap()`) is niche-aware, so under niche it read
## the box pointer AS the payload → a contained Vec decoded null → the
## cache_smoke crash at `_qzmod_rewrite_call_names + 240`. FIX: niche-aware
## construction intercept for `option_some`/`option_none` in mir_lower_call
## (mir_lower_expr_handlers.qz), mirroring the surface `Some`/`None` path —
## payload type recovered via `mir_option_intrinsic_payload` (expected-type, then
## arg type for Some); niche ⇒ identity / niche-const, spill ⇒ legacy intrinsic.
## Verified: flag-OFF IR byte-identical to golden; under niche, full guard
## (incl cache_smoke) + fixpoint (2830 fns) + a real double-compile cached build
## all PASS. This intercept is INERT with the flag at 0.
##
## 5th asymmetry (un-annotated-local read inference) — FIXED (item 6.3c). Three
## construct/read agreement gaps for un-annotated locals were closed, ALL gated on
## mir_option_is_niche/mir_subject_is_niche_option ⇒ byte-identical IR flag-OFF
## (proven: 6/6 named specs diff-clean vs the committed golden):
##   1. var-binding inference (mir_lower_stmt_handlers.qz NODE_LET): `var u =
##      option_some(x)` now refines u's tracked type to `Option<P>` via the SAME
##      mir_option_intrinsic_payload the construction side uses, so the read side's
##      mir_infer_expr_type(u) recovers the concrete payload (covers `.unwrap`,
##      `.some?`/`.none?`, match — the mir_get_enum_tag_subj read sites).
##   2. `try u` (NodeTryExpr, mir_lower_expr_handlers.qz): was unconditionally
##      load@0/load@1; now niche-aware (range test + identity payload).
##   3. `u ?? d` (OP_NIL_COALESCE binary, mir_lower_expr_handlers.qz): was
##      load@0/load@1; now niche-aware (Some ⇔ value != none_const, payload IS the
##      word). (Also added an unwrap_or call-form intercept for `.unwrap_or()`.)
## Verified under niche: safe_navigation_spec, nil_coalescing_spec, try_keyword_spec
## all PASS; option_boxed_unannotated_niche_spec 8/8; option_boxed_struct_niche_spec
## 16/16; full guard incl cache_smoke PASS (2830 fns); double-compile cache-stable.
##
## BLOCKER (6th asymmetry — Option in a struct FIELD from a bare-`None` un-annotated
## local): with the flag at 1, full guard PASSES and 830/840 native qspec files pass,
## but tui_v06_theme_spec + tui_v06_cell_primitive_spec each fail ONE assertion
## (`t.base10_17 is None`, instrumented to the exact line) — both PASS on golden.
## Root cause: std/tui/theme.qz `theme_from_string` builds the field via an
## UN-ANNOTATED bare-`None` local — `var ext = Option::None` (line ~746), later
## conditionally `ext = Option::Some(Base24Ext{..})`, then stored `base10_17: ext`.
## `base10_17` is declared `Option<Base24Ext>` (a boxed struct ⇒ niches). The READ
## `t.base10_17 is None` niches (field type recovered via mir_infer_expr_type's
## NODE_FIELD_ACCESS branch). But the bare-`None` CONSTRUCTION at `var ext = None`
## has NO payload node and NO annotation, so mir_option_construction_payload
## returns "" ⇒ SPILL (tagged box). Field stores a spill box; niche read range-tests
## the box pointer → wrong verdict. Distinct from the 5th: 6.3c's intrinsic-arg
## recovery does NOT apply (this is the SURFACE `Option::None` enum-access form with
## no payload to infer P from; P is only recoverable from the LATER typed
## reassignment or the destination field's declared type).
## NOTE: a plain-`def main` standalone repro fails on BOTH golden and niche (222),
## i.e. it does NOT reproduce the golden-passing baseline — the bug only manifests
## golden-pass/niche-fail inside the qspec `do ->` lambda body, so the local-type
## tracking that lets the read niche is lambda-scoped. Minimal repro that DID
## isolate the construct/read split: see /tmp standalone theme repro in the 6.3c
## handoff; the failing assertion is exactly `t.base10_17 is None`.
## FIX BEFORE NEXT FLIP: recover `Option<P>` for a bare-`None` un-annotated local
## from (a) a later `x = Option::Some(P{})` reassignment in the same body, or (b)
## the declared type of the struct field it is stored into (`base10_17: ext` ⇒ ext
## is `Option<Base24Ext>`) — so the None CONSTRUCTION niches to match the field-typed
## READ. Must stay niche-gated for flag-OFF IR neutrality. The 6.3c inference +
## try/?? niche-read fixes below are KEPT (proven inert flag-OFF) — they are a
## prerequisite for the next flip either way. The per-class gate scaffolding below
## is retained for that flip.
def mir_boxed_niche_enabled(): Int
  return 1
end

## Per-class LIVE gates (Phase 3 scoping). The master flag turns the machinery on;
## these gates decide WHICH boxed classes actually niche. Phase 3 targets ONLY
## non-`@value` user structs — all heap BUILTINS (String/Vec/Map/Set/IntMap/
## Function/Regex/Future/Tuple) STAY TAGGED until a later phase. Inert while the
## master flag above is 0.
def mir_boxed_niche_struct_live(): Int
  return 1
end

## Boxed heap-builtin LIVE gate. Phase 6.4a: the SIX clean named builtins
## (Vec / Map / Set / IntMap / Regex / Future) now niche — each is a single
## non-null heap-pointer word whose `nil` (0) is an extra inhabitant, so
## `Option<P>` reuses `0` for `None`. Empty collections are non-null header
## pointers (no empty-vs-null ambiguity). String was bisected OUT (see
## `mir_is_held_builtin_name`): it crashed the form-widget call graph via
## `Vec<Option<String>>` — held for item 6.4b.
def mir_boxed_niche_builtin_live(): Int
  return 1
end

## Tuple LIVE gate (item 6.4e — SCAFFOLD, GATED OFF). 0 = OFF (inert). Tuple is
## its own gate, flipping independently of the other boxed classes. A Quartz tuple
## literal is a flat heap allocation (`mir_lower.qz` NODE_TUPLE_LITERAL:
## `tuple_ptr = mir_emit_alloc(slots)`) returning a non-null header-less pointer —
## structurally identical to a boxed struct. No valid tuple is 0, so `0`/`nil` is a
## free extra inhabitant ⇒ SOUND to niche `None` to 0 (none_const = 0, NOT a top
## niche K). The niche payload-bind is IDENTITY (the pointer is stored/loaded
## verbatim), so the tuple's element slots survive the Option round-trip intact.
##
## NAME-FORM SOUNDNESS (the stated deferral blocker — RESOLVED for recognition).
## The deferral cited "name-form type-tracking robustness": a fear that a tuple
## ptype could be mis-recognized (false positive/negative) and silently niche at
## the wrong representation. Investigation (see §14.7 + below) shows recognition IS
## reliable: the typechecker's CANONICAL tuple rendering (`tc_type_name_full`,
## typecheck.qz:2884-2896) and the generic-substitution path (typecheck_generics.qz
## :541) BOTH emit a tuple as `(elem, elem, ...)` — a LEADING bare `(`. Function
## types render as `Fn(...)` (typecheck_registry.qz:3175 `var ann = "Fn("`) and are
## both parsed (typecheck.qz:1589 requires `starts_with("Fn(")`) and rendered with
## the `Fn` prefix, so they NEVER collide with the bare-`(` form. A grep of every
## ptype-string producer confirms the ONLY leading-`(` emitters are the two tuple
## paths. The parse side is symmetric (typecheck.qz:1208 treats a leading bare `(`
## annotation as a tuple). So `name.starts_with("(")` in mir_is_held_builtin_name
## is an EXACT tuple discriminator — no false positives, no false negatives. The
## stale `Tuple`/`Tuple<` forms in that helper are never actually emitted (kept as
## defensive belt-and-braces). Recognition is therefore SOUND; the remaining risk
## at flip time is purely the construct/read-asymmetry chase (the QZ0212 cadence),
## not mis-recognition.
##
## SCAFFOLDED but NOT flipped: like the other classes, flipping is a representation
## rebase (the compiler itself constructs Option<tuple> in places) and a supervised
## one-way door. With this gate at 0 the Tuple arm in mir_payload_is_boxed_classify
## is dead code ⇒ Option<tuple> stays on the byte-identical SPILL (tagged box) path
## it uses today. option_tuple_niche_spec passes under that spill path and locks
## behavior for the eventual supervised flip.
def mir_boxed_niche_tuple_live(): Int
  return 1
end

## Function LIVE gate (item 6.4c — LANDED). Function is its own gate, flipping
## independently of Tuple. A Quartz `Function` value is a SINGLE word: either a
## bare function pointer (low bit 0, a real code address) or a tagged closure
## `env|1` (low bit 1; mir_lower.qz builds `env = alloc(N+1); closure = env|1`,
## codegen_runtime.qz discriminates by `&1` and presence-tests `!= 0`). Neither a
## real fn-ptr nor an `env|1` closure is ever 0, so `0` is a free extra inhabitant
## — SOUND to niche for `None`. The niche payload-bind is IDENTITY (the word is
## stored/loaded verbatim), so the closure low-bit tag + captured env survive the
## Option round-trip intact (proven by option_boxed_function_niche_spec: a captured
## closure pushed into Some(...) and pulled back out still calls with its env).
def mir_boxed_niche_function_live(): Int
  return 1
end

## String LIVE gate (item 6.4b — LANDED). String is its own gate, flipping
## independently of Function/Tuple. A Quartz String is a pointer to the DATA field
## of a length-prefixed buffer (qz_alloc_str returns the non-null data ptr; empty
## "" → @.empty_string data field, also non-null), so NO valid String is 0 — 0 is
## a free extra inhabitant. SOUND to niche. The prior tui_form SIGSEGV was NOT a
## String-repr problem: it was a construct/read asymmetry — `Option::None` pushed
## into a struct-FIELD `Vec<Option<String>>` (and `field[i] = None`, `obj.opt =
## None`) constructed a TAGGED spill box because the niche-expected type wasn't
## threaded for non-IDENT collection/field receivers, so the niche read range-
## tested the non-null box as Some → garbage render → crash. Fixed at three seams
## (mir_lower_expr_handlers collection-insert; mir_lower_stmt_handlers index-assign
## + field-assign) by inferring the receiver's declared Option type. With those,
## construct and read agree and String niches cleanly.
def mir_boxed_niche_string_live(): Int
  return 1
end

## Dataless-enum LIVE gate (B.10 §14 N3 item 6.4d — SCAFFOLD, GATED OFF).
## 0 = OFF (inert). A DATALESS enum (`enum Color { Red, Green, Blue }`) is
## scalar-represented — the value IS its tag (0..K-1). So `Option<Color>` has a
## clean TOP NICHE: `None` = K (the variant count), every valid `Color` is < K.
## This sits ABOVE the tags exactly like Bool's {2,254}, so there is NO nil=0
## collision — sound BY CONSTRUCTION (the niche is the variant count, not 0).
## SCAFFOLDED but NOT flipped: this is a representation rebase that changes the
## compiler's own emitted IR (token kinds / AST node kinds construct
## Option<dataless-enum> widely), so flipping it is a supervised one-way door
## (it risks re-triggering the QZ0212 erased-boundary asymmetry chase). With this
## gate at 0 the dataless-enum branch in `mir_payload_is_boxed_classify` AND the
## dataless arm in `mir_option_none_const` are dead code ⇒ Option<dataless-enum>
## stays on the byte-identical SPILL (tagged box) path it uses today. The
## option_dataless_enum_niche_spec suite passes under that spill path and locks
## behavior for the eventual supervised flip.
def mir_boxed_niche_dataless_enum_live(): Int
  return 1
end

## Variant count K of a payload type-name `pt` IFF `pt` names a REGISTERED
## DATALESS enum (>=1 variant, NO payload-bearing variants) — else 0. Pure ctx
## lookup (no IR emit, no mutation): resolves the bare/qualified name through the
## enum registry, confirms it is dataless via `mir_enum_has_payloads`, and returns
## the variant count from `ctx.enum_variants`. This K IS the top-niche `None`
## constant for `Option<pt>` (every valid variant tag is 0..K-1, so K is the first
## free inhabitant — a TOP niche). `niche.qz` is string-pure and CANNOT compute K
## (it can't know the enum's variant count from the name), so the ctx-awareness
## lives here; `niche.qz` stays unpolluted. Built-in Option/Result are excluded
## (they are payload-bearing). Returns 0 for any non-enum / unregistered name, so
## the classifier branch and the none_const arm both no-op for non-dataless types.
def mir_payload_dataless_enum_variant_count(ctx: MirContext, pt: String): Int
  return 0 if str_byte_len(pt) == 0
  # Generic forms (`Option<…>`, `Vec<…>`) are never a bare dataless enum name.
  return 0 if pt == "Option"
  return 0 if pt == "Result"
  var base = mir_strip_generic_head(pt)
  return 0 if str_byte_len(base) == 0
  var resolved: String = mir_resolve_enum_name(ctx, base)
  var enum_names = mir_ctx_get_enum_names(ctx)
  return 0 if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return 0 if enum_variants == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      # Found the enum. Dataless iff it has NO payload-bearing variants.
      return 0 if mir_enum_has_payloads(ctx, resolved) == 1
      var variants = enum_variants[i]
      return 0 if variants == 0
      var k = variants.size
      return 0 if k == 0
      return k
    end
  end
  return 0
end

# ============================================================================
# General single-payload + K-dataless enum niche (Rust-parity generalization)
# ============================================================================
# The Option niche (Some(p)=p / None=0) generalizes to ANY user enum with exactly
# ONE payload-carrying variant + K dataless variants, when the payload variant's
# payload type P is a niche-eligible BOXED type. Layout: the enum value IS P (a
# boxed pointer, always a large page-aligned address ≥ 4096). Each dataless variant
# occupies a BOTTOM niche value in {0..K-1} (declaration order among the dataless
# variants) — the low spare values a boxed pointer never takes (Rust reserves the
# bottom page = 4096 niche slots for exactly this). Read by a range test: scalar
# `v < K` ⇒ the j=v-th dataless variant; `v ≥ K` ⇒ the payload variant.
#
# This SUBSUMES Option (K=1, None=0, Some=ptr) — but Option stays on its existing
# dedicated `enum_name == "Option"` fast-paths so its emitted IR is byte-identical;
# this machinery fires ONLY for non-Option/Result user enums of the right shape.
#
# Gated by `mir_boxed_niche_single_payload_enum_live()` ⇒ dead code (the gate at 0
# makes `mir_enum_is_niche` always 0) until a supervised flip. This is a
# representation rebase (the compiler may construct such enums), so guard fixpoint
# must hold at the NEW representation, exactly per §14.4.

## Single-payload-enum niche LIVE gate. 1 = ON (LANDED): a user enum with exactly
## one single-field boxed-payload variant + K dataless variants niches to one word
## (payload = the pointer; dataless D_j = the bottom-niche scalar j ∈ {0..K-1}).
## Built-in Option/Result keep their dedicated byte-identical paths. The flip is a
## representation rebase, but fixpoint-trivial: the only compiler/stdlib enums of
## this SHAPE (LookupResult/BlendMode/TabsEvent) all have an `Int` payload, which
## is NOT niche-eligible (`mir_payload_is_boxed("Int")`=0 — every bit pattern is a
## valid Int), so they stay on the SPILL path and the compiler's own IR is
## unchanged by the flip (the "safe-by-non-usage" property the Bool/NonZero niches
## also enjoyed). Only user enums with a boxed (struct/String/Vec/…) single-field
## payload actually niche.
def mir_boxed_niche_single_payload_enum_live(): Int
  return 1
end

## 1 iff variant index `vi` of registered enum `resolved` carries a payload (its
## per-variant field-type vector is non-empty). 0 for dataless variants / misses.
def mir_enum_variant_has_payload(ctx: MirContext, resolved: String, vi: Int): Int
  var enum_names = mir_ctx_get_enum_names(ctx)
  return 0 if enum_names == 0
  var per_enum = mir_ctx_get_enum_variant_field_types(ctx)
  return 0 if per_enum == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var per_variant = per_enum[i]
      return 0 if per_variant == 0
      return 0 if vi >= per_variant.size
      var ftypes = per_variant[vi]
      return 0 if ftypes == 0
      return 1 if ftypes.size >= 1
      return 0
    end
  end
  return 0
end

## Compute the single-payload-enum niche layout for `enum_name`. Returns a packed
## positional record [niche, payload_idx, K, payload_type]:
##   - niche       — 1 iff this enum is a niche-eligible single-payload+K-dataless
##                   shape AND the single-payload-enum gate is live; else 0.
##   - payload_idx — declaration index of the single payload-bearing variant (-1
##                   when not the right shape).
##   - K           — number of dataless variants.
##   - payload_type— the payload variant's single-field type-annotation string.
## Built-in Option/Result are EXCLUDED (they keep their dedicated byte-identical
## paths). A shape qualifies iff: exactly one payload-bearing variant, that variant
## has exactly one field, K ≥ 1 dataless variants, and the payload type is a
## niche-eligible boxed type (`mir_payload_is_boxed`) with ≥ K spare low niche
## values (a boxed pointer's bottom page covers any reasonable K — guarded below).
def mir_enum_single_payload_layout(ctx: MirContext, enum_name: String): Vec
  var none_layout = [0, -1, 0, ""]
  return none_layout if str_byte_len(enum_name) == 0
  return none_layout if enum_name == "Option"
  return none_layout if enum_name == "Result"
  var resolved: String = mir_resolve_enum_name(ctx, enum_name)
  var enum_names = mir_ctx_get_enum_names(ctx)
  return none_layout if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return none_layout if enum_variants == 0
  var per_enum = mir_ctx_get_enum_variant_field_types(ctx)
  return none_layout if per_enum == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      return none_layout if variants == 0
      var nv = variants.size
      return none_layout if nv == 0
      var per_variant = per_enum[i]
      return none_layout if per_variant == 0
      var payload_idx = -1
      var payload_count = 0
      var dataless = 0
      var ptype = ""
      for vi in 0..nv
        var ftypes = 0
        if vi < per_variant.size
          ftypes = per_variant[vi]
        end
        var nfields = 0
        if ftypes != 0
          nfields = ftypes.size
        end
        if nfields >= 1
          payload_count = payload_count + 1
          payload_idx = vi
          # Only single-field payload variants are v1-eligible.
          if nfields == 1
            ptype = as_string(ftypes[0])
          else
            ptype = ""
          end
        else
          dataless = dataless + 1
        end
      end
      # Must be exactly one single-field payload variant + ≥1 dataless variant.
      return none_layout if payload_count != 1
      return none_layout if dataless < 1
      return none_layout if str_byte_len(ptype) == 0
      # The payload must be a genuine boxed HEAP-POINTER type, whose bottom page
      # (≥4096 spare low values) hosts the {0..K-1} dataless run — exactly Rust's
      # `Box<T>` niche. CRITICAL SOUNDNESS CARVE-OUT: a DATALESS-ENUM payload
      # classifies as "boxed-niche-eligible" via mir_payload_is_boxed (the gate
      # that powers the OUTER Option<dataless-enum> TOP niche), but its values are
      # SMALL SCALAR TAGS {0..M-1}, NOT large pointers — they would COLLIDE with the
      # bottom niche {0..K-1} (`SubJust(SubA)`=0 == `SubNothing`'s niche 0). Likewise
      # Bool/NonZero/borrow niche via their own scalar entries, not a pointer. So
      # require a real pointer payload: boxed via mir_payload_is_boxed AND NOT a
      # scalar-niche (dataless-enum / Bool / NonZero / borrow) payload. Anything that
      # is scalar SPILLS (byte-identical tagged box) — correct, since a scalar payload
      # has no pointer-bottom niche.
      return none_layout if mir_payload_is_boxed(ctx, ptype) == 0
      return none_layout if mir_payload_dataless_enum_variant_count(ctx, ptype) >= 1
      var pn = niche::type_niche(ptype)
      return none_layout if niche::niche_has(pn) == 1
      return none_layout if ptype.starts_with("&")
      return none_layout if dataless > mir_boxed_payload_niche_budget()
      var niche = mir_boxed_niche_single_payload_enum_live()
      return [niche, payload_idx, dataless, ptype]
    end
  end
  return none_layout
end

## The number of spare low niche values a niche-eligible boxed pointer guarantees.
## A heap pointer is page-aligned (malloc returns ≥ one page in); the bottom page
## (4096 bytes) is never a valid object address — exactly Rust's `Box<T>` niche
## reservation. Any single-payload enum with ≤ this many dataless variants niches.
def mir_boxed_payload_niche_budget(): Int = 4096

## 1 iff `enum_name` is a niche-layout single-payload+K-dataless user enum (gated).
def mir_enum_is_niche(ctx: MirContext, enum_name: String): Int
  return mir_enum_single_payload_layout(ctx, enum_name)[0]
end

## The packed layout's accessors (positional record [niche, payload_idx, K, ptype]).
def mir_enum_niche_payload_idx(l: Vec): Int = l[1]
def mir_enum_niche_k(l: Vec): Int = l[2]
def mir_enum_niche_payload_type(l: Vec): String = as_string(l[3])

## The niche SCALAR value for dataless variant at declaration index `vi`: the count
## of dataless (payload-less) variants declared BEFORE vi (so dataless variants map
## to {0..K-1} in declaration order). For the payload variant returns -1 (it is the
## pointer, not a niche constant). `resolved` must be the registry-resolved name.
def mir_enum_dataless_niche_scalar(ctx: MirContext, resolved: String, vi: Int): Int
  var enum_names = mir_ctx_get_enum_names(ctx)
  return -1 if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return -1 if enum_variants == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      return -1 if variants == 0
      var nv = variants.size
      return -1 if vi >= nv
      # The target variant must itself be dataless.
      return -1 if mir_enum_variant_has_payload(ctx, resolved, vi) == 1
      var scalar = 0
      for j in 0..vi
        if mir_enum_variant_has_payload(ctx, resolved, j) == 0
          scalar = scalar + 1
        end
      end
      return scalar
    end
  end
  return -1
end

## Inverse map: the declaration index of the dataless variant whose niche scalar is
## `scalar` (j-th dataless variant in declaration order). -1 on miss.
def mir_enum_dataless_decl_idx_for_scalar(ctx: MirContext, resolved: String, scalar: Int): Int
  var enum_names = mir_ctx_get_enum_names(ctx)
  return -1 if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return -1 if enum_variants == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      return -1 if variants == 0
      var nv = variants.size
      var seen = 0
      for vi in 0..nv
        if mir_enum_variant_has_payload(ctx, resolved, vi) == 0
          if seen == scalar
            return vi
          end
          seen = seen + 1
        end
      end
      return -1
    end
  end
  return -1
end

# ============================================================================
# Multi-payload enum niche — M1 scaffold (Swift-parity terminal increment)
# ============================================================================
# RFC: docs/design/ENUM_NICHE_MULTIPAYLOAD.md. MEMORY_MODEL_V3 §14.9.
#
# An enum with EXACTLY TWO payload-carrying variants, BOTH carrying a single
# BOXED-pointer payload (`Result<&A,&B>`-shaped), niches into ONE word by packing
# a 1-bit discriminant (declaration index) into the common low alignment bits of
# the two 8-aligned payload pointers (3 guaranteed-zero low bits ⇒ ≤8 variants):
#   - construct variant i ⇒ `payload_ptr | i`  (Ok=0 ⇒ bare ptr; Err=1 ⇒ ptr|1)
#   - read tag = `value & spare_mask` ; payload ptr = `value & ~spare_mask`
# HARD INVARIANT (RFC §4 / ratification Q7): the niche-multi value is EXACTLY ONE
# i64 SSA value (`ptr | tag`), NEVER a (pointer-alloca, tag-alloca) pair — so a
# value live across a `$poll` suspend spills the WHOLE packed word, not a stale
# pointer interpretation. The construct emits one i64; the read masks that one i64.
#
# The ctx-dependent spare-bit computation lives HERE (mir_multi_enum_common_spare),
# feeding the PURE niche.qz router (niche::enum_layout_multi) — preserving niche.qz
# string-purity for the qzmod round-trip (RFC §2.3 / ratification Q4), exactly as
# the single-payload + dataless-enum scaffolds did.
#
# Gated by `mir_boxed_niche_multi_payload_live()` ⇒ dead code (the gate at 0 makes
# `mir_multi_enum_is_niche` always 0) until a supervised flip. This is a
# representation rebase (the compiler may construct such enums), so the flip is a
# one-way door requiring the QZ0212 erased-boundary audit (RFC §5) — held OFF.

## Multi-payload-enum niche LIVE gate (M1 — 2-boxed user enums). 1 = LIVE (FLIPPED
## 2026-06-13 per the §14.9 audit verdict). With the gate at 1, a NON-colliding
## 2-single-boxed-payload user enum (≤8 variants) niches into ONE word: construct
## packs `payload_ptr | tag_idx`, read masks `& spare_mask` / `& ~spare_mask`.
## EXCLUDED and held on the SPILL path: built-in Option/Result (Option has its own
## single-payload path; built-in Result is PERMANENTLY out of M1 per the compiler-
## self Result audit — erased std combinators + try-desugar read it via the hard
## SPILL layout, an uncaught false-accept) AND any user enum whose variant set
## collides with Ok/Err/Some/None (the bare-variant-resolution asymmetry, forced
## SPILL so construct and read AGREE). Mirrors the per-class single-payload gates
## (`mir_boxed_niche_struct_live` etc.). The audit established self-build clean +
## fixpoint + full qspec green at gate=1; invariant #7 (one i64 SSA value) holds.
def mir_boxed_niche_multi_payload_live(): Int
  return 1
end

## ── enum-niche 3a — N-variant (1≤N≤8) all-boxed-payload user-enum niche gate ───
## 0 = OFF (INERT). The M1 niche (`mir_boxed_niche_multi_payload_live`) clamps to
## EXACTLY 2 boxed-payload variants. This gate widens that clamp to N boxed-payload
## variants (1≤N≤8, total variant count ≤8) — the construct/read/bind machinery is
## ALREADY N-general (tag = the variant DECLARATION index packed into the 3 low
## alignment bits of the 8-aligned payload pointer; read = `ptr & 7`, payload =
## `ptr & ~7`). 3a covers the ALL-PAYLOAD case (no dataless variants); dataless-mix
## construct for N≠2 is 3b. Held at 0 because, like M1, the flip is a representation
## rebase (the compiler may construct such enums) requiring a supervised audit:
## self-build clean + fixpoint byte-identical + full qspec green. With the gate at 0
## the N clause is dead ⇒ eligibility still clamps to exactly-2 ⇒ emitted IR is
## byte-identical to the M1-only compiler.
def mir_multi_niche_nvariant_live(): Int
  return 1
end

## ── enum-niche 3b — boxed+dataless-MIX multi-payload niche LIVE gate ────────────
## 0 = OFF (INERT). When this returns 1 (a supervised one-way flip, AFTER self-build
## clean + fixpoint byte-identical + full qspec green), an N-payload (≥2 single-boxed
## payload variants) enum that ALSO carries ≥1 dataless variant niches into ONE word:
## each payload variant i ⇒ `payload_ptr | i`; each DATALESS variant ⇒ the SMALL
## INTEGER equal to its declaration index (`0 | tag_i = tag_i`), in an otherwise-zero
## word. This never collides with a real payload word `ptr | tag_j` because boxed
## pointers are ≥ 4096; dispatch is tag-bits-only (`& 7`); dataless match arms bind no
## payload so the read path never derefs a dataless word.
##
## ATOMIC AGREEMENT (§14.10.Q4): this gate governs BOTH (a) the eligibility relaxation
## (`mir_multi_enum_common_spare` admits dataless-bearing niche-multi enums — read
## side) AND (b) the dataless construct arm (`mir_lower` NODE_ENUM_ACCESS — construct
## side). They flip together so construct and read NEVER disagree. While OFF, a
## dataless-bearing N-payload enum SPILLS on BOTH construct and read (no half-niche).
## NOTE: a PRE-EXISTING half-niche bug exists at gate=0 for the LITERAL 2-payload
## clause (it admitted dataless companions for read but had no construct arm); this
## gate's eligibility edit (requiring dataless==0 unless this is 1) CLOSES that bug —
## at gate=0 a 2-payload+dataless enum now SPILLS consistently (the broken niche read
## is gone), and at gate=1 it niches consistently (construct arm packs the dataless
## word). Sibling of `mir_multi_niche_nvariant_live`.
def mir_multi_niche_dataless_mix_live(): Int
  return 1
end

## ── enum-niche M2 — built-in `Result<&A,&B>` niche LIVE gate ───────────────────
## 0 = OFF (SCAFFOLD, INERT). When this returns 1 (a supervised one-way flip, AFTER
## the compiler-self Result-usage audit per RFC §5), the BUILT-IN `Result<T,E>` whose
## BOTH type args resolve to boxed heap pointers niches into ONE word via the M1
## machinery: `Ok(p)` = `p | 0` = `p` (FREE), `Err(p)` = `p | 1`; read tag = `value &
## 7`, payload = `value & ~7` — the spare mask is the COMPILE-TIME CONSTANT 7 for
## every boxed instantiation (3 low alignment bits of an 8-aligned pointer), hence the
## niche read is TYPE-INDEPENDENT and can be emitted at the call site / try-desugar
## without knowing the concrete T/E (RFC §2.3). Sibling of
## `mir_boxed_niche_multi_payload_live` (M1, user enums). Held at 0 because built-in
## Result flows through the ERASED std combinators (`is_ok<T,E>`/`unwrap_ok<T,E>`/…)
## and the `?`/try-catch desugar, which read it via the hard SPILL layout — a
## false-accept SEGFAULT until QZ0212-multi + the hot-combinator interception + the
## ?/try niche-awareness (all scaffolded below, gated on THIS) are audited green.
## With the gate at 0 every M2 branch is dead code ⇒ emitted IR byte-identical.
def mir_multi_niche_result_live(): Int
  return 1
end

## B.10 Phase 4 — DEFAULT-STRUCT-LAYOUT FLIP gate (F0 scaffold, INERT at 0).
## When 0, a bare `struct` (registry is_value==0) keeps the Boxed `else` arm at
## mir_lower.qz NODE_STRUCT_INIT — byte-identical to history. When 1, an ELIGIBLE
## plain struct (see mir_default_struct_value_eligible) routes to the @value
## stack-alloca / value-layout path instead of mir_emit_alloc(N).
## THIS IS THE ONE-WAY DOOR (§14.4 representation rebase): the compiler is made of
## structs, so flipping to 1 changes the compiler's OWN emitted IR — fixpoint
## becomes gen1==gen2 under the new repr, NOT byte-identical to history. Do NOT
## flip to 1 outside the dedicated supervised F4 session gated on the 6
## ratifications in docs/conductor/struct-layout-flip-prep-2026-06-15.md +
## MEMORY_MODEL_V3 §14.11. Mirrors the niche-gate discipline (§14.10.Q4-Q7).
def mir_default_struct_value_live(): Int
  return 1
end

## B.10 §14.12 — VALUE SEMANTICS gate (V-track scaffold, INERT at 0). When 1, an
## `@value` struct gets copy-on-assign value semantics (`var b = a` produces an
## INDEPENDENT copy, so mutating b does NOT mutate a). Keyed on `@value` (is_value),
## NOT the plain-struct flip — the compiler uses ZERO `@value` structs, so the
## copy path NEVER fires in self-compile ⇒ fixpoint-TRIVIAL and REVERSIBLE (unlike
## the §14.11 plain-struct layout flip, which is the separate one-way door). v1 =
## EAGER copy (mir_emit_value_copy); COW (>16B refcount) is a later optimization.
## Design: §14.12. Do NOT conflate with mir_default_struct_value_live (the flip).
def mir_value_semantics_live(): Int
  return 1
end

## B.10 §14.12.8 — COW gate (C-track scaffold, INERT at 0). When 0, @value copies
## stay EAGER (mir_emit_value_copy word-loop) — behavior identical to today. When
## 1, a >16B FLAT @value copy becomes an O(1) cow_rc_inc + shared buffer ptr (with
## construct-side header buffer + offset+1 field routing landing in C3, and
## cow_release-on-scope-exit in C4). Keyed on @value (is_value) + value-layout +
## >16B AND a flatness safety rail (no nested >16B @value field — those fall back
## to eager to avoid a use-after-free from a shallow share without per-field
## retain; scan_map / deep nested-COW is DEFERRED to a follow-up saga). The
## compiler uses ZERO @value structs, so the COW path NEVER fires in self-compile
## ⇒ fixpoint-TRIVIAL (gen1==gen2) and REVERSIBLE (flip back to 0 → eager copy).
## NOT the §14.11 plain-struct one-way door (mir_default_struct_value_live). Flip
## only at C6 after full gate-1 qspec. Design: docs/sagas/.../cow-abi.md §4.
def mir_value_cow_live(): Int
  return 1
end

## 1 iff the built-in `Result<A,B>` named by `result_type` is M2-niche-eligible: the
## gate is LIVE *and* BOTH type args resolve to genuine boxed heap pointers (so both
## payload words share the 3 low spare bits ⇒ a 1-bit discriminant fits for free).
## A scalar Ok/Err payload (`Result<Int,String>`, `Result<Int,Int>`) has NO spare bit
## ⇒ returns 0 ⇒ SPILL (the §8 information-theoretic floor). String-pure parse of the
## two top-level type args (depth-aware, mirroring `mir_extract_map_value_type`); the
## boxedness verdict reuses the M1 carve-out (`mir_multi_variant_is_single_boxed`'s
## genuine-pointer rule, inlined here as the same predicate chain). With the gate at 0
## this ALWAYS returns 0 ⇒ every Result classifies SPILL ⇒ the read/try/combinator
## branches stay dead ⇒ inert.
def mir_result_type_is_niche_multi(ctx: MirContext, result_type: String): Int
  return 0 if mir_multi_niche_result_live() == 0
  return 0 if str_byte_len(result_type) == 0
  return 0 if result_type.starts_with("Result<") == false
  var ok_t = mir_result_ok_type(result_type)
  var err_t = mir_result_err_type(result_type)
  return 0 if str_byte_len(ok_t) == 0
  return 0 if str_byte_len(err_t) == 0
  return 0 if mir_niche_payload_is_genuine_pointer(ctx, ok_t) == 0
  return 0 if mir_niche_payload_is_genuine_pointer(ctx, err_t) == 0
  return 1
end

## Genuine-boxed-heap-pointer predicate shared by the M2 Result niche (the exact
## carve-out `mir_multi_variant_is_single_boxed` applies per-variant, factored so the
## Result-from-type-args path reuses it): boxed AND not a dataless enum AND not a
## scalar-niche type (Bool/NonZero) AND not a borrow. Only struct/String/Vec/Map/Set/
## IntMap/Regex/Future/Function/Tuple have a real bottom-page niche.
def mir_niche_payload_is_genuine_pointer(ctx: MirContext, pt: String): Int
  return 0 if str_byte_len(pt) == 0
  return 0 if mir_payload_is_boxed(ctx, pt) == 0
  return 0 if mir_payload_dataless_enum_variant_count(ctx, pt) >= 1
  var pn = niche::type_niche(pt)
  return 0 if niche::niche_has(pn) == 1
  return 0 if pt.starts_with("&")
  return 1
end

## Extract the Ok (first) type arg `A` from a `Result<A,B>` type string, depth-aware
## and whitespace-trimmed. "" on a malformed / non-Result string.
def mir_result_ok_type(ty: String): String
  return "" if ty.starts_with("Result<") == false
  var len = str_byte_len(ty)
  var depth = 0
  var start = 7
  var i = start
  var comma = -1
  while i < len
    var c = str_byte_at(ty, i)
    if c == '<'
      depth += 1
    elsif c == '>'
      break if depth == 0
      depth -= 1
    elsif c == ','
      if depth == 0
        comma = i
        break
      end
    end
    i += 1
  end
  return "" if comma < 0
  return mir_trim_spaces(str_byte_slice(ty, start, comma))
end

## Extract the Err (second) type arg `B` from a `Result<A,B>` type string, depth-aware.
def mir_result_err_type(ty: String): String
  return "" if ty.starts_with("Result<") == false
  var len = str_byte_len(ty)
  var depth = 0
  var i = 7
  var comma = -1
  while i < len
    var c = str_byte_at(ty, i)
    if c == '<'
      depth += 1
    elsif c == '>'
      break if depth == 0
      depth -= 1
    elsif c == ','
      if depth == 0
        comma = i
        break
      end
    end
    i += 1
  end
  return "" if comma < 0
  var depth2 = 0
  var v_start = comma + 1
  var v_end = len
  var j = v_start
  while j < len
    var c2 = str_byte_at(ty, j)
    if c2 == '<'
      depth2 += 1
    elsif c2 == '>'
      if depth2 == 0
        v_end = j
        break
      end
      depth2 -= 1
    end
    j += 1
  end
  return mir_trim_spaces(str_byte_slice(ty, v_start, v_end))
end

## Trim leading/trailing ASCII spaces from `s`.
def mir_trim_spaces(s: String): String
  var r = s
  while str_byte_len(r) > 0 and str_byte_at(r, 0) == ' '
    r = str_byte_slice(r, 1, str_byte_len(r))
  end
  while str_byte_len(r) > 0 and str_byte_at(r, str_byte_len(r) - 1) == ' '
    r = str_byte_slice(r, 0, str_byte_len(r) - 1)
  end
  return r
end

## item 42 — recover the declared RETURN TYPE of a combinator's mapping-fn argument
## (`result_map(res, f)`'s `f`). For a bare IDENT referencing a named fn, read its
## declared return annotation; for any other expr (lambda, fn-valued local) infer the
## `Fn(T): U` type and extract `U`. Returns "" if it can't resolve. Used by the value-
## layout consumer-inference refinement (Part 3) and the combinator-internal intercept
## (Part 1) to learn the OUTPUT payload type `U` the erased call-node type erases.
def mir_combinator_mapfn_ret_type(ctx: MirContext, s: ast::AstStorage, fn_arg: AstNodeId): String
  return "" if fn_arg == 0
  if ast::ast_get_kind(s, fn_arg) == node_constants::NODE_IDENT
    var fname = ast::ast_get_str1(s, fn_arg)
    var resolved = mir_resolve_func_name(ctx, fname)
    var fe = mir_lookup_function(ctx, resolved)
    if fe.is_none()
      var all_funcs = mir_ctx_get_all_funcs(ctx)
      if all_funcs != 0
        var suffix = "$#{resolved}"
        var afc = all_funcs.size
        for sfi in 0..afc
          var sfe = all_funcs[sfi]
          if sfe.tag == 0 and str_ends_with(sfe.name, suffix)
            fe = Option::Some(sfe)
            break
          end
        end
      end
    end
    if fe.is_some()
      var e = fe.unwrap()
      return ast::ast_get_str2(e.ast_store, e.node_id)
    end
    return ""
  end
  # Lambda / fn-valued: the inferred type is a `Fn(P): R` annotation.
  var ann = mir_infer_expr_type(ctx, s, fn_arg)
  return mir_extract_fn_return_type(ann)
end

## item 42 — recover the OUTPUT payload type `U` produced by a Result/Option combinator
## CALL whose subject's payload is value-layout. `cop` is the combinator opcode (see
## mir_combinator_op): map/option_map ⇒ U = mapfn return directly; and_then ⇒ U = the Ok/
## Some type of the mapfn's `Result<U,E>`/`Option<U>` return. Returns "" when it can't be
## resolved. The decisive value-layout gate (`mir_is_value_layout_type(U)==1`) is applied
## by the callers — this only extracts the name.
def mir_combinator_output_payload(ctx: MirContext, s: ast::AstStorage, cop: Int, fn_arg: AstNodeId): String
  var fr = mir_combinator_mapfn_ret_type(ctx, s, fn_arg)
  return "" if str_byte_len(fr) == 0
  # result_map (1) / option_map (6): U is the fn return directly.
  # result_map_err (2): F (the new Err payload) is the fn return directly (item 42f).
  return fr if cop == 1 or cop == 2 or cop == 6
  # result_and_then (3): fn returns Result<U,E> ⇒ U is its Ok type.
  if cop == 3
    return mir_result_ok_type(fr)
  end
  # option_and_then (7): fn returns Option<U> ⇒ U is its payload.
  if cop == 7
    return mir_option_payload_of_type(fr)
  end
  return ""
end

## item 42 — combinator opcode for a free/UFCS function name, or 0 if not a known
## value-layout-interceptable combinator. 1=result_map 2=result_map_err
## 3=result_and_then 6=option_map 7=option_and_then. (ok/err/or are not value-payload-
## mapping over a single payload slot in a way the combinator intercept handles — ok/err
## have their own conversion intercept, or/unwrap_or have the fallback intercept.)
## item 42f — result_map_err (2) maps the ERR slot; the intercept reads the Err payload
## on the Err arm and passes the Ok payload through on the Ok arm (mirror image of op 1).
def mir_combinator_op(func_name: String): Int
  return 1 if func_name == "result_map" or str_ends_with(func_name, "$result_map") == 1
  return 2 if func_name == "result_map_err" or str_ends_with(func_name, "$result_map_err") == 1
  return 3 if func_name == "result_and_then" or str_ends_with(func_name, "$result_and_then") == 1
  return 6 if func_name == "option_map" or str_ends_with(func_name, "$option_map") == 1
  return 7 if func_name == "option_and_then" or str_ends_with(func_name, "$option_and_then") == 1
  return 0
end

## item 42 — 1 iff `node` is an `unwrap_ok`/`unwrap_err` CALL (single-arg). Used at the
## bind site to arena-mark the bound name when the unwrapped Result has a value-layout
## (inline) payload (the Part-2 intercept returned the FLAT interior address).
def mir_result_subject_is_unwrap_ok_call(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node == 0
  return 0 if ast::ast_get_kind(s, node) != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, node)
  return 0 if callee == 0
  return 0 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  var fname = ast::ast_get_str1(s, callee)
  return 1 if fname == "unwrap_ok" or fname == "unwrap_err"
  return 1 if str_ends_with(fname, "$unwrap_ok") == 1 or str_ends_with(fname, "$unwrap_err") == 1
  return 0
end

## item 42 — the unwrapped subject (arg[0]) of an unwrap_ok/unwrap_err CALL, else 0.
def mir_unwrap_ok_call_subject(s: ast::AstStorage, node: AstNodeId): AstNodeId
  return 0 if mir_result_subject_is_unwrap_ok_call(s, node) == 0
  var args = ast::ast_get_children(s, node)
  return 0 if args.size == 0
  return args[0]
end

## item 42 — the Ok or Err payload TYPE of an unwrap_ok/unwrap_err call's subject (for
## arena-mark struct tracking at the bind site). "" when unknown.
def mir_unwrap_ok_call_payload_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  var subj = mir_unwrap_ok_call_subject(s, node)
  return "" if subj == 0
  var callee = ast::ast_get_left(s, node)
  var fname = ast::ast_get_str1(s, callee)
  var is_err = fname == "unwrap_err" or str_ends_with(fname, "$unwrap_err") == 1
  var rty = mir_infer_expr_type(ctx, s, subj)
  if is_err == 1
    return mir_result_err_type(rty)
  end
  return mir_result_ok_type(rty)
end

## item 42b — combinator-kind for the 2-arg UNWRAP-WITH-FALLBACK family, or 0 if `fname`
## is not one. These return the bare Ok/Some payload `T` (value-layout) on the
## present branch, else the supplied `fallback` (also `T`, value-layout). The erased
## prelude bodies read the Result/Option payload slot via the BOXED spill layout — but a
## value-layout payload is INLINED FLAT at box[word1], so the loaded word is the first
## FIELD VALUE (e.g. 55), deref'd by the consumer as a pointer ⇒ SIGSEGV (the gate-1
## result_niche crash). The value-layout intercept (mir_lower_expr_handlers.qz) selects
## the INTERIOR ADDRESS (`box+8`) on the present branch and the FLAT fallback on the
## else branch. 1=unwrap_or_ok (Result) 2=result_or (Result) 3=unwrap_or (Option)
## 4=option_or (Option). result_or / option_or are documented aliases of unwrap_or_ok /
## unwrap_or and share the same erased-payload crash, so they take the same path.
def mir_unwrap_or_fallback_kind(fname: String): Int
  return 1 if fname == "unwrap_or_ok" or str_ends_with(fname, "$unwrap_or_ok") == 1
  return 2 if fname == "result_or" or str_ends_with(fname, "$result_or") == 1
  return 3 if fname == "unwrap_or" or str_ends_with(fname, "$unwrap_or") == 1
  return 4 if fname == "option_or" or str_ends_with(fname, "$option_or") == 1
  return 0
end

## item 42b — 1 iff `node` is a 2-arg unwrap-with-fallback CALL (unwrap_or_ok / result_or
## / unwrap_or). Used at the bind site to arena-mark the bound name when the present
## branch yields a value-layout (inline) payload (the intercept returned the FLAT
## interior address / flat fallback). Mirror of `mir_result_subject_is_unwrap_ok_call`.
def mir_subject_is_unwrap_or_fallback_call(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node == 0
  return 0 if ast::ast_get_kind(s, node) != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, node)
  return 0 if callee == 0
  return 0 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  var fname = ast::ast_get_str1(s, callee)
  return 0 if mir_unwrap_or_fallback_kind(fname) == 0
  return 1
end

## item 42b — the subject (arg[0]) of an unwrap-with-fallback CALL, else 0.
def mir_unwrap_or_fallback_subject(s: ast::AstStorage, node: AstNodeId): AstNodeId
  return 0 if mir_subject_is_unwrap_or_fallback_call(s, node) == 0
  var args = ast::ast_get_children(s, node)
  return 0 if args.size == 0
  return args[0]
end

## item 42b — 1 iff an unwrap-with-fallback CALL's subject is a value-layout (inline)
## Result/Option whose present-branch payload is an `@value`/flip-eligible struct (and
## NOT niche — those flow through the niche-multi / niche-option hot intercepts). Dispatch
## on kind: unwrap_or_ok/result_or read a Result Ok payload, unwrap_or reads an Option
## payload. GATE-0-INERT: the compiler/std use ZERO `@value` Result/Option payloads ⇒
## mir_*_subject_is_inline_value is false everywhere ⇒ returns 0 ⇒ byte-identical.
def mir_unwrap_or_fallback_subject_is_inline_value(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var subj = mir_unwrap_or_fallback_subject(s, node)
  return 0 if subj == 0
  var callee = ast::ast_get_left(s, node)
  var fname = ast::ast_get_str1(s, callee)
  var kind = mir_unwrap_or_fallback_kind(fname)
  return 0 if kind == 0
  if kind == 3 or kind == 4
    return mir_option_subject_is_inline_value(ctx, s, subj)
  end
  return mir_result_subject_is_inline_value(ctx, s, subj)
end

## item 42b — the present-branch payload TYPE (Ok / Some) of an unwrap-with-fallback
## call's subject (for arena-mark struct tracking at the bind site). "" when unknown.
def mir_unwrap_or_fallback_payload_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  var subj = mir_unwrap_or_fallback_subject(s, node)
  return "" if subj == 0
  var callee = ast::ast_get_left(s, node)
  var fname = ast::ast_get_str1(s, callee)
  var kind = mir_unwrap_or_fallback_kind(fname)
  return "" if kind == 0
  var sty = mir_infer_expr_type(ctx, s, subj)
  if kind == 3 or kind == 4
    return mir_option_payload_of_type(sty)
  end
  return mir_result_ok_type(sty)
end

## item 42 — 1 iff `subject_node` is a Result whose Ok payload is a value-layout
## (`@value` / flip-eligible) struct (and NOT niche-multi — that path is the M2
## intercept). Mirror of `mir_option_subject_is_inline_value` for Result. GATE-0-INERT:
## the compiler/std use ZERO `@value` Result payloads, so `mir_is_value_layout_type` is
## false for every Result Ok payload here ⇒ returns 0 everywhere ⇒ byte-identical.
def mir_result_subject_is_inline_value(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  return 0 if subject_node == 0
  return 0 if mir_subject_is_niche_multi(ctx, s, subject_node) == 1
  var rty = mir_infer_expr_type(ctx, s, subject_node)
  return 0 if rty.starts_with("Result<") == false
  var ok_t = mir_result_ok_type(rty)
  return 0 if str_byte_len(ok_t) == 0
  var res = mir_resolve_struct_name(ctx, mir_strip_generic_head(ok_t))
  return mir_is_value_layout_type(ctx, res)
end

## item 42b — 1 iff `subject_node` is a Result whose ERR payload is a value-layout
## (`@value`/flip-eligible) struct (and NOT niche-multi). Mirror of the Ok-side
## `mir_result_subject_is_inline_value`, used by the `err(r)` conversion intercept (whose
## present payload is the Err side). GATE-0-INERT: zero `@value` Result Err payloads in
## the compiler/std ⇒ returns 0 everywhere ⇒ byte-identical.
def mir_result_subject_err_is_inline_value(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  return 0 if subject_node == 0
  return 0 if mir_subject_is_niche_multi(ctx, s, subject_node) == 1
  var rty = mir_infer_expr_type(ctx, s, subject_node)
  return 0 if rty.starts_with("Result<") == false
  var err_t = mir_result_err_type(rty)
  return 0 if str_byte_len(err_t) == 0
  var res = mir_resolve_struct_name(ctx, mir_strip_generic_head(err_t))
  return mir_is_value_layout_type(ctx, res)
end

## item 42c — 1 iff `node` is a `try`/`?` expression (NODE_TRY_EXPR). Used at the
## let/assign bind site to arena-mark the bound name when the try subject's present
## (Ok/Some) payload is an inline value-layout struct (the try intercept returned the
## FLAT interior address `box+8`). Mirror of `mir_option_subject_is_unwrap_call`.
def mir_init_is_try_expr(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node == 0
  return 0 if ast::ast_get_kind(s, node) != node_constants::NODE_TRY_EXPR
  return 1
end

## item 42c — the subject (left child) of a `try`/`?` expression, else 0.
def mir_try_expr_subject(s: ast::AstStorage, node: AstNodeId): AstNodeId
  return 0 if mir_init_is_try_expr(s, node) == 0
  return ast::ast_get_left(s, node)
end

## item 42c — 1 iff a `try`/`?` expression's subject is a SPILL Result/Option whose
## present (Ok/Some) payload is a value-layout (`@value`/flip-eligible) struct (and NOT
## niche — those flow through the niche-multi / niche-option hot try paths). The try
## intercept returns the FLAT interior address `box+8` for such a subject, so the bound
## name must be arena-marked (offset+0 field reads, no COW +1 shift). GATE-0-INERT:
## reuses mir_result/option_subject_is_inline_value ⇒ false for every gate-0 payload ⇒
## returns 0 everywhere ⇒ byte-identical.
def mir_try_subject_present_is_inline_value(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var subj = mir_try_expr_subject(s, node)
  return 0 if subj == 0
  return 1 if mir_result_subject_is_inline_value(ctx, s, subj) == 1
  return 1 if mir_option_subject_is_inline_value(ctx, s, subj) == 1
  return 0
end

## item 42c — the present (Ok/Some) payload TYPE of a `try`/`?` expression's subject
## (for arena-mark struct tracking at the bind site). "" when unknown / not value-layout.
def mir_try_subject_present_payload_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  var subj = mir_try_expr_subject(s, node)
  return "" if subj == 0
  var sty = mir_infer_expr_type(ctx, s, subj)
  if sty.starts_with("Result<")
    return mir_result_ok_type(sty)
  end
  if sty.starts_with("Option<")
    return mir_option_payload_of_type(sty)
  end
  return ""
end

## M2 read-side: the spare mask for a niche-multi BUILT-IN Result is the same
## compile-time constant the M1 layout uses — the 3 low alignment bits ⇒ mask 7.
## Factored so the Result read/try/intercept seams agree on ONE constant without
## re-deriving the (ctx-registry-absent) Result layout.
def mir_result_niche_spare_mask(): Int = 7

## The low-spare-bit COUNT for a niche-multi built-in Result — 3 (the 3 guaranteed-
## zero low bits of an 8-aligned boxed pointer). `apply_pending_bind` consumes this as
## the bit width and derives the clear-mask `& ~((1<<3)-1)` = `& ~7`. Sibling of
## `mir_result_niche_spare_mask` (the mask 7 = (1<<3)-1).
def mir_result_niche_low_zero(): Int = 3

## 1 if a match/if/is/try on `subject_node` should use the MULTI-payload niche read
## (the subject's concrete static type is a niche-multi enum). Read-side twin of
## `mir_subject_is_niche_option`, generalized to the multi-payload case. For a
## BUILT-IN `Result<A,B>` it consults `mir_result_type_is_niche_multi` (both args
## boxed + gate live); for a USER multi-payload enum it consults the registry-based
## `mir_multi_enum_is_niche`. The QZ0212-multi cold guard and the try/hot-combinator
## seams gate on THIS. Always 0 while `mir_multi_niche_result_live()` is OFF (the
## Result branch is gated) AND while M1 user enums are the only niche-multi shape
## (those are already handled by the read seams) ⇒ inert for Result.
def mir_subject_is_niche_multi(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  var inferred = mir_infer_expr_type(ctx, s, subject_node)
  return 0 if str_byte_len(inferred) == 0
  if inferred.starts_with("Result<")
    return mir_result_type_is_niche_multi(ctx, inferred)
  end
  # User multi-payload enum (M1): strip the generic head and consult the registry.
  var base = inferred
  var lt = __char_index(base, '<')
  if lt > 0
    base = str_byte_slice(base, 0, lt)
  end
  return 0 if base == "Option"
  return 0 if base == "Result"
  return mir_multi_enum_is_niche(ctx, base)
end

## Spare-bit descriptor for a multi-payload enum — a positional record
## [low_zero, extra_count, eligible]:
##   - low_zero  — common low alignment spare bits shared by ALL payload words
##                 (3 for uniformly-boxed 8-aligned pointers; 0 if any is a scalar).
##   - extra_count — intersected whole-value extra inhabitants (reserved for M3).
##   - eligible  — 1 iff this enum is M1-niche-eligible (exactly 2 single-boxed-
##                 payload variants, ≤8 variants) AND the gate is live; else 0.
def mir_multi_spare_new(low_zero: Int, extra_count: Int, eligible: Int): Vec = [low_zero, extra_count, eligible]
def mir_multi_spare_low_zero(sp: Vec): Int = sp[0]
def mir_multi_spare_extra(sp: Vec): Int = sp[1]
def mir_multi_spare_eligible(sp: Vec): Int = sp[2]

## 1 iff variant index `vi` of registered enum `resolved` is a SINGLE-FIELD payload
## variant whose field type is a GENUINE boxed heap pointer (struct/String/Vec/Map/
## Set/IntMap/Regex/Future/Function/Tuple — the real-pointer niche classes), NOT a
## scalar/dataless-enum/borrow (which have no low spare bits). Mirrors the
## single-payload carve-out (`mir_enum_single_payload_layout`). The bound payload
## type is returned via `out` (a 1-slot Vec) for the caller; "" when not eligible.
def mir_multi_variant_is_single_boxed(ctx: MirContext, resolved: String, vi: Int, out: Vec): Int
  vec_set(out, 0, "")
  var per_enum = mir_ctx_get_enum_variant_field_types(ctx)
  return 0 if per_enum == 0
  var enum_names = mir_ctx_get_enum_names(ctx)
  return 0 if enum_names == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var per_variant = per_enum[i]
      return 0 if per_variant == 0
      return 0 if vi >= per_variant.size
      var ftypes = per_variant[vi]
      return 0 if ftypes == 0
      return 0 if ftypes.size != 1
      var ptype = as_string(ftypes[0])
      return 0 if str_byte_len(ptype) == 0
      # Genuine boxed HEAP-POINTER payload only (same carve-out as single-payload).
      return 0 if mir_payload_is_boxed(ctx, ptype) == 0
      return 0 if mir_payload_dataless_enum_variant_count(ctx, ptype) >= 1
      var pn = niche::type_niche(ptype)
      return 0 if niche::niche_has(pn) == 1
      return 0 if ptype.starts_with("&")
      vec_set(out, 0, ptype)
      return 1
    end
  end
  return 0
end

## 1 iff the registered enum `resolved` has a variant name that COLLIDES with a
## built-in enum's variant set the bare-variant resolver (`mir_find_enum_by_variant`)
## mis-routes to the built-in. The Ok/Err asymmetry (§14.9): a user M1 enum naming a
## variant `Ok` or `Err` constructs via its QUALIFIED name (`Res::Ok`, niche-eligible)
## but a BARE `Ok`/`Err` match/`is` arm resolves through the global variant search to
## the built-in `Result` (which the classifier excludes ⇒ SPILL read) — construct and
## read disagree ⇒ SEGFAULT under niche. The conservative consistent rule (RFC §5,
## "detect+spill any M1 enum whose variant set collides with a built-in"): treat such
## an enum as NOT M1-eligible so BOTH construct and read take the SPILL path and agree.
## `Some`/`None` are Option's; `Ok`/`Err` are Result's — the two built-in enums whose
## variants `mir_find_enum_by_variant` resolves ahead of a user enum. Built-in Result
## is itself held out of M1 (the compiler-self Result audit: erased std combinators
## `is_ok<T,E>`/`unwrap_ok<T,E>` and the try/catch desugar read Result via the hard
## spill layout — a false-accept hazard QZ0212 does not yet cover for multi-niche).
def mir_multi_enum_variant_collides_builtin(ctx: MirContext, resolved: String): Int
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return 0 if enum_variants == 0
  var enum_names = mir_ctx_get_enum_names(ctx)
  return 0 if enum_names == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      return 0 if variants == 0
      var nv = variants.size
      for vi in 0..nv
        var vn = variants[vi]
        return 1 if vn == "Ok"
        return 1 if vn == "Err"
        return 1 if vn == "Some"
        return 1 if vn == "None"
      end
      return 0
    end
  end
  return 0
end

## Compute the multi-payload spare-bit descriptor for `enum_name` (ctx-aware).
## Scans the enum's variants: counts payload vs dataless variants, confirms EVERY
## payload variant is a single GENUINE-boxed pointer (8-aligned ⇒ 3 low spare bits),
## and reports `low_zero` = min over payloads of their spare bits (3 if all boxed,
## 0 if any payload isn't). `eligible` is 1 ONLY when the gate is live AND the enum
## is M1-shaped (exactly 2 single-boxed-payload variants, no other payload variants,
## ≤8 total variants) AND its variant set does NOT collide with a built-in enum's
## (Ok/Err/Some/None — the §14.9 bare-variant-resolution asymmetry). Built-in
## Option/Result are EXCLUDED: Option has its dedicated single-payload path; built-in
## Result is PERMANENTLY held out of M1 per the compiler-self Result audit (§14.9) —
## erased std combinators (is_ok<T,E>/unwrap_ok<T,E>/… in std/prelude.qz) and the
## try/catch desugar (mir_lower_try) read Result via the hard SPILL layout, an
## uncaught false-accept QZ0212 does not yet cover for multi-niche args. Niching it
## needs QZ0212-multi + a niche-aware try-desugar + erased-combinator monomorphization.
## CONSERVATIVE: any miss / unknown / built-in-name collision ⇒ low_zero=0, eligible=0.
def mir_multi_enum_common_spare(ctx: MirContext, enum_name: String): Vec
  var none_spare = mir_multi_spare_new(0, 0, 0)
  return none_spare if str_byte_len(enum_name) == 0
  # The OPTION early-out is PERMANENT (RFC §8 / ratification Q6): built-in Option
  # keeps its dedicated single-payload niche, NOT the multi-payload packing — routing
  # it here would need a tag bit it doesn't want (a regression).
  return none_spare if enum_name == "Option"
  # enum-niche M2: the RESULT early-out is now GATED. With the gate OFF (default,
  # scaffold) built-in Result still returns none_spare ⇒ SPILL, byte-identical. With
  # the gate ON, the bare name "Result" still falls through to `none_spare` below
  # (built-in Result is NOT in the user-enum registry this loop scans, so the loop
  # finds nothing) — Result's REAL niche eligibility is decided by the type-arg-aware
  # `mir_result_type_is_niche_multi` at the call/read/try sites (it needs the concrete
  # `Result<A,B>` boxedness, which the bare name lacks), NOT by this registry scan.
  # The lift is kept faithful to RFC §4 so the early-out no longer unconditionally
  # blocks Result; it remains inert because the gate is 0.
  if mir_multi_niche_result_live() == 0
    return none_spare if enum_name == "Result"
  end
  var resolved: String = mir_resolve_enum_name(ctx, enum_name)
  var enum_names = mir_ctx_get_enum_names(ctx)
  return none_spare if enum_names == 0
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  return none_spare if enum_variants == 0
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      return none_spare if variants == 0
      var nv = variants.size
      return none_spare if nv == 0
      var payload_count = 0
      var dataless = 0
      var boxed_payloads = 0
      var out = vec_new()
      out.push("")
      for vi in 0..nv
        if mir_enum_variant_has_payload(ctx, resolved, vi) == 1
          payload_count = payload_count + 1
          if mir_multi_variant_is_single_boxed(ctx, resolved, vi, out) == 1
            boxed_payloads = boxed_payloads + 1
          end
        else
          dataless = dataless + 1
        end
      end
      # M1: exactly two payload variants, BOTH single genuine-boxed pointers.
      # Any non-boxed payload (a scalar / @value / multi-field variant) ⇒ low_zero
      # collapses to 0 (no common spare) ⇒ SPILL. >2 payload variants is M2 ⇒ SPILL.
      var low_zero = 0
      if (payload_count == 2 and boxed_payloads == 2) or (mir_multi_niche_nvariant_live() == 1 and payload_count >= 1 and payload_count == boxed_payloads)
        low_zero = 3
      end
      var v = payload_count + dataless
      # §14.9 Ok/Err asymmetry resolution: a user M1 enum whose variant set collides
      # with a built-in (Ok/Err/Some/None) constructs via its qualified name (niche)
      # but a bare-variant match arm resolves to the built-in (spill) ⇒ disagreement
      # ⇒ segfault. Spill the WHOLE enum so construct and read agree on SPILL. This
      # keeps the descriptor's low_zero=3 informational while forcing eligible=0.
      var collides = mir_multi_enum_variant_collides_builtin(ctx, resolved)
      var eligible = 0
      # enum-niche 3b — ATOMIC dataless guard (§14.10.Q4). A dataless-bearing
      # niche-multi enum is eligible (read side niches) ONLY when the 3b construct
      # arm is also live (mir_multi_niche_dataless_mix_live() == 1), so construct and
      # read agree. This guard applies to BOTH the literal 2-payload clause AND the
      # N-payload (3a) clause — closing the pre-existing half-niche bug where the
      # 2-payload clause admitted dataless companions for read but had no construct
      # arm (live miscompile). At gate=0: dataless-bearing enums SPILL on both sides.
      var dataless_ok = 1
      if dataless > 0 and mir_multi_niche_dataless_mix_live() == 0
        dataless_ok = 0
      end
      if mir_boxed_niche_multi_payload_live() == 1
        if low_zero >= 1 and dataless_ok == 1 and ((payload_count == 2 and boxed_payloads == 2) or (mir_multi_niche_nvariant_live() == 1 and payload_count >= 1 and payload_count == boxed_payloads)) and v <= 8 and collides == 0
          eligible = 1
        end
      end
      return mir_multi_spare_new(low_zero, 0, eligible)
    end
  end
  return none_spare
end

## The multi-payload niche layout for `enum_name`, routed through the PURE
## niche.qz router with the ctx-computed spare bits. Returns the niche.qz packed
## record [kind, common_low_zero, V]. When the gate is OFF, `eligible` is 0 so this
## always yields SPILL (kind 0) ⇒ inert.
def mir_multi_enum_layout(ctx: MirContext, enum_name: String): Vec
  var sp = mir_multi_enum_common_spare(ctx, enum_name)
  if mir_multi_spare_eligible(sp) == 0
    return niche::enum_layout_new(niche::ENUM_LAYOUT_SPILL, 0, 0)
  end
  # Re-derive payload/dataless counts for the pure router (it makes the final
  # niche-vs-spill call from the SHAPE — the ctx side already proved eligibility).
  var resolved: String = mir_resolve_enum_name(ctx, enum_name)
  var enum_names = mir_ctx_get_enum_names(ctx)
  var enum_variants = mir_ctx_get_enum_variants(ctx)
  var count = enum_names.size
  for i in 0..count
    if enum_names[i] == resolved
      var variants = enum_variants[i]
      var nv = variants.size
      var payload_count = 0
      var dataless = 0
      for vi in 0..nv
        if mir_enum_variant_has_payload(ctx, resolved, vi) == 1
          payload_count = payload_count + 1
        else
          dataless = dataless + 1
        end
      end
      return niche::enum_layout_multi(payload_count, dataless, mir_multi_spare_low_zero(sp), mir_multi_spare_extra(sp))
    end
  end
  return niche::enum_layout_new(niche::ENUM_LAYOUT_SPILL, 0, 0)
end

## 1 iff `enum_name` is a niche-layout multi-payload (M1 2-boxed) enum (gated).
## Always 0 while the gate is OFF.
def mir_multi_enum_is_niche(ctx: MirContext, enum_name: String): Int
  return 1 if niche::enum_layout_kind(mir_multi_enum_layout(ctx, enum_name)) == niche::ENUM_LAYOUT_NICHE_MULTI
  return 0
end

## The packed spare-mask for the multi-payload niche: `(1 << low_zero) - 1`. The
## tag occupies these low bits; the payload pointer is `value & ~mask`. Reads
## low_zero from the niche.qz layout record's reused `niche_start` slot.
def mir_multi_enum_spare_mask(layout: Vec): Int
  var low_zero = niche::enum_layout_niche_start(layout)
  var mask = 1
  var bi = 0
  var acc = 0
  while bi < low_zero
    acc = acc + mask
    mask = mask * 2
    bi = bi + 1
  end
  return acc
end

## 1 iff payload type-name `P` is a sanctioned IR/arena handle struct, for which
## `0` is a legal STRUCTURAL sentinel (not `None`). Mirrors typecheck's
## `tc_n3_is_sanctioned_handle_type` (typecheck_helpers.qz). These must stay
## TAGGED — their `0` value must remain representable, so they are NOT niche-able.
def mir_is_sanctioned_handle_name(name: String): Int
  return 1 if name == "mir$MirBlock"
  return 1 if name == "ast$AstStorage"
  return 1 if name == "MirBlock"
  return 1 if name == "AstStorage"
  return 0
end

## 1 iff `P` names a CLEAN niche-eligible boxed heap BUILTIN — the SIX types that
## are an unambiguous single non-null heap-pointer word AND have proven a clean
## niche round-trip through the full call graph: Vec / Map / Set / IntMap / Regex /
## Future. Generic forms (`Vec<…>`) match by prefix. `CPtr` is deliberately ABSENT
## (FFI null is a legitimate sentinel) and scalar/value types (`Int`/`Bool`/
## `NonZero`/narrow ints) never reach here. String / Function / Tuple are held back
## in `mir_is_held_builtin_name` (each with a distinct named blocker — see there).
def mir_is_clean_niche_builtin_name(name: String): Int
  return 1 if name == "Vec"
  return 1 if name.starts_with("Vec<")
  return 1 if name == "Map"
  return 1 if name.starts_with("Map<")
  return 1 if name == "Set"
  return 1 if name.starts_with("Set<")
  return 1 if name == "IntMap"
  return 1 if name.starts_with("IntMap<")
  return 1 if name == "Regex"
  return 1 if name == "Future"
  return 1 if name.starts_with("Future<")
  return 0
end

## 1 iff `P` names the boxed Tuple builtin — a flat non-null heap allocation
## (`mir_lower.qz` NODE_TUPLE_LITERAL), structurally a boxed pointer whose `0`/`nil`
## is a free extra inhabitant. Gated by `mir_boxed_niche_tuple_live()` (item 6.4e,
## SCAFFOLD GATED OFF). The CANONICAL ptype spelling of a tuple is the bare-`(`
## form `(Int, String)` (typecheck.qz:2887 + typecheck_generics.qz:541) — function
## types use the `Fn(` prefix (no collision; see the gate's NAME-FORM SOUNDNESS
## note). The `Tuple`/`Tuple<` forms are never actually emitted (defensive belt).
## (String LANDED in 6.4b via mir_boxed_niche_string_live; Function/Fn( LANDED in
## 6.4c via mir_boxed_niche_function_live. Tuple is the last held boxed builtin.)
def mir_is_held_builtin_name(name: String): Int
  return 1 if name == "Tuple"
  return 1 if name.starts_with("Tuple<")
  return 1 if name.starts_with("(")
  return 0
end

## 1 iff `P` names the boxed Function/closure builtin. Single-word value (bare
## fn-ptr low-bit-0, or `env|1` closure low-bit-1), never 0 — so `0` niches for
## `None`. Gated by mir_boxed_niche_function_live (item 6.4c).
def mir_is_function_builtin_name(name: String): Int
  return 1 if name == "Function"
  return 1 if name.starts_with("Fn(")
  return 0
end

## 1 iff `name` is an EXACT registered struct-registry entry (already-resolved,
## module-mangled nominal name). Used to distinguish a real boxed user struct
## from an unregistered/unknown type-name (which is not a known boxed type).
def mir_struct_name_is_registered(ctx: MirContext, name: String): Int
  var registry = mir_ctx_get_struct_registry(ctx)
  var reg_len = registry.size
  for i in 0..reg_len
    var entry = registry[i]
    var ename = entry.name
    if ename == name
      return 1
    end
  end
  return 0
end

## The REAL classifier (no flag gate). 1 iff payload type-name `P` is a
## niche-eligible BOXED heap type whose `nil` (all-zero) is an extra inhabitant,
## so `Option<P>` can reuse `0` for `None`. Carve-outs (return 0) are the
## soundness boundary:
##   - nested `Option<…>`     — only the innermost niches; outer over inner would
##                              collide on `0` (LOAD-BEARING for soundness).
##   - sanctioned handles      — `0` is a legal structural sentinel, stays tagged.
##   - `CPtr`                  — FFI null is a legitimate value, stays tagged.
##   - `@value` (inline) struct — not a boxed pointer, no null inhabitant.
##   - `Int`/`I64`/`U64`/narrow/`Bool`/`NonZero` — scalars; Bool/NonZero niche via
##                              their OWN `type_niche` entries, not this path.
##   - dataless enums          — out of scope, stay tagged.
## Returns 1 for a registered non-`@value` user struct and the boxed builtins.
## (Phase 1: this runs ONLY in the classify-helper unit test — the flag-gated
## wrapper below short-circuits before reaching it in live codegen.)
def mir_payload_is_boxed_classify(ctx: MirContext, pt: String): Int
  return 0 if str_byte_len(pt) == 0
  # nested Option — only the innermost niches (soundness: avoid 0-collision).
  return 0 if pt.starts_with("Option<")
  # CPtr — FFI null is a legitimate sentinel; mirror type_niche(CPtr)=none.
  return 0 if pt == "CPtr"
  # Scalars / niche-via-own-entry: never boxed.
  return 0 if pt == "Int"
  return 0 if pt == "I64"
  return 0 if pt == "U64"
  return 0 if pt == "I8"
  return 0 if pt == "I16"
  return 0 if pt == "I32"
  return 0 if pt == "U8"
  return 0 if pt == "U16"
  return 0 if pt == "U32"
  return 0 if pt == "Bool"
  return 0 if pt == "NonZero"
  return 0 if pt == "Float"
  return 0 if pt == "F64"
  return 0 if pt == "F32"
  return 0 if pt == "Void"
  # Sanctioned IR/arena handles — `0` is a structural sentinel, stay tagged.
  return 0 if mir_is_sanctioned_handle_name(pt) == 1
  # Borrows — already niche via type_niche (bottom niche {0,1}); not this path.
  return 0 if pt.starts_with("&")
  # Clean boxed heap builtins (Vec/Map/Set/IntMap/Regex/Future). Phase 6.4a: these
  # niche when the clean-builtin gate is live.
  if mir_is_clean_niche_builtin_name(pt) == 1
    return 1 if mir_boxed_niche_builtin_live() == 1
    return 0
  end
  # String — its own gate (item 6.4b). Repr-eligible (data ptr non-null), held
  # while the gate is 0 pending the Vec<Option<String>> form-widget diagnosis.
  if pt == "String"
    return 1 if mir_boxed_niche_string_live() == 1
    return 0
  end
  # Function/closure — its own gate (item 6.4c). The single word is never 0 (bare
  # fn-ptr or `env|1` closure), and the niche identity bind preserves the low-bit
  # closure tag + captured env across the Option round-trip.
  if mir_is_function_builtin_name(pt) == 1
    return 1 if mir_boxed_niche_function_live() == 1
    return 0
  end
  # Tuple (item 6.4e SCAFFOLD, GATED OFF). A tuple is a flat non-null heap
  # allocation — structurally a boxed pointer, so `0`/`nil` niches for `None`
  # (none_const = 0, a boxed-pointer null niche, NOT a top niche K). Recognized by
  # the canonical bare-`(` ptype form (no Fn-type collision — see the gate's
  # NAME-FORM SOUNDNESS note). Gated by mir_boxed_niche_tuple_live() ⇒ dead code
  # (returns 0) until a supervised flip — so Option<tuple> stays on the spill path
  # and emitted IR is byte-identical.
  if mir_is_held_builtin_name(pt) == 1
    return 1 if mir_boxed_niche_tuple_live() == 1
    return 0
  end
  # Dataless enum (B.10 §14 N3 6.4d SCAFFOLD, GATED OFF). A dataless enum is
  # scalar-represented (the value IS its tag, 0..K-1), so `Option<enum>` niches
  # ABOVE the tags at `None` = K — a TOP niche, no nil=0 collision (sound by
  # construction). This is NOT a boxed-pointer null niche: the none_const is the
  # variant count K (supplied by mir_option_none_const's dedicated dataless arm),
  # NOT 0. Gated by mir_boxed_niche_dataless_enum_live() ⇒ dead code (returns 0)
  # until a supervised flip — so Option<dataless-enum> stays on the spill path and
  # emitted IR is byte-identical.
  if mir_payload_dataless_enum_variant_count(ctx, pt) >= 1
    return 1 if mir_boxed_niche_dataless_enum_live() == 1
    return 0
  end
  # Registered user struct: boxed iff NOT @value (inline). Resolve the nominal
  # name then consult the @value marker. Unregistered names resolve to themselves
  # and are not @value, but an unregistered non-builtin is not a known boxed type
  # either — so require registry membership via a non-@value resolved struct.
  var resolved: String = mir_resolve_struct_name(ctx, pt)
  # item 36 — route through the SINGLE layout key so a flip-eligible plain struct
  # (not just an explicit @value) is recognized as value-layout (⇒ NOT boxed).
  # mir_is_value_layout_type is gate-0 inert (mir_default_struct_value_live()==0
  # short-circuits its flip disjunct) ⇒ this reduces to the old @value-only test
  # ⇒ byte-identical at gate 0. resolved is already canonical; the predicate
  # re-resolves idempotently (exact-match returns it unchanged).
  var is_val: Int = mir_is_value_layout_type(ctx, resolved)
  return 0 if is_val == 1
  # Only count it as a boxed user struct if it actually resolved to a registered
  # entry (resolved differs from the bare name, OR the bare name is itself a
  # registered entry). mir_resolve_struct_name returns the input unchanged when
  # unknown; treat a registered match as the signal.
  var is_reg: Int = mir_struct_name_is_registered(ctx, resolved)
  if is_reg == 1
    # Phase 3 LIVE class: non-`@value` user structs niche; gated for staged rollout.
    return 1 if mir_boxed_niche_struct_live() == 1
    return 0
  end
  return 0
end

## Flag-gated wrapper. 1 iff `P` is a niche-eligible boxed heap type AND the N3
## master flag is on. Phase 1: flag is 0 ⇒ always returns 0 (INERT) — the
## classify logic above is dead code until the flip.
def mir_payload_is_boxed(ctx: MirContext, pt: String): Int
  return 0 if mir_boxed_niche_enabled() == 0
  return mir_payload_is_boxed_classify(ctx, pt)
end

## The §14.3 layout decision [kind, niche_start, dataless_used] for an Option
## whose Some payload is `payload_type`.
def mir_option_layout(payload_type: String): Vec
  return niche::enum_layout(1, 1, payload_type)
end

## 1 if `Option<payload_type>` uses niche layout (no tag word, no alloc). 0 = spill.
## `ctx` is threaded so the boxed-niche branch can consult the struct registry
## (N3 item 6.1). In Phase 1 `mir_payload_is_boxed` returns 0 (flag off), so the
## result is exactly the pre-N3 Bool/NonZero/borrow verdict — byte-identical IR.
def mir_option_is_niche(ctx: MirContext, payload_type: String): Int
  return 1 if niche::enum_layout_kind(mir_option_layout(payload_type)) == niche::ENUM_LAYOUT_NICHE
  return 1 if mir_payload_is_boxed(ctx, payload_type) == 1
  return 0
end

## The bit-pattern representing `None` under niche layout. For the existing
## Bool/NonZero/borrow niches it is the payload's first niche value (e.g. 2 for
## `Bool`); for a boxed payload (N3, flag-gated) it is `0` (`nil`). In Phase 1 the
## boxed branch is inert (flag off), so this is exactly the pre-N3 constant.
def mir_option_none_const(ctx: MirContext, payload_type: String): Int
  # Dataless enum (6.4d SCAFFOLD, GATED OFF): the niche sits ABOVE the variant
  # tags (0..K-1), so `None` = K (the variant count). MUST precede the boxed `0`
  # check — a dataless enum classifies as "boxed-niche-eligible" once the gate is
  # live, but its none_const is K, NOT the boxed-pointer `nil`=0. Gated ⇒ inert:
  # with the gate at 0 this arm never fires and the result is the pre-scaffold
  # constant (byte-identical IR).
  if mir_boxed_niche_dataless_enum_live() == 1
    var k = mir_payload_dataless_enum_variant_count(ctx, payload_type)
    return k if k >= 1
  end
  return 0 if mir_payload_is_boxed(ctx, payload_type) == 1
  return niche::enum_layout_niche_start(mir_option_layout(payload_type))
end

## Extract `P` from an "Option<P>" type string, else "". Whitespace-trimmed.
def mir_option_payload_of_type(ty: String): String
  return "" if str_byte_len(ty) == 0
  return "" if ty.starts_with("Option<") == false
  var inner = str_byte_slice(ty, 7, str_byte_len(ty) - 1)
  # Trim surrounding spaces (annotations may read "Option< Bool >").
  while str_byte_len(inner) > 0 and str_byte_at(inner, 0) == ' '
    inner = str_byte_slice(inner, 1, str_byte_len(inner))
  end
  while str_byte_len(inner) > 0 and str_byte_at(inner, str_byte_len(inner) - 1) == ' '
    inner = str_byte_slice(inner, 0, str_byte_len(inner) - 1)
  end
  return inner
end

## Set/clear/read the ambient expected type for niche construction (None's type
## comes from here — its own node carries no payload). Statement handlers set it
## around an operand lowering and clear it after.
def mir_ctx_set_niche_expected(ctx: MirContext, ty: String): Void
  ctx.niche_expected_type = ty
end
def mir_ctx_get_niche_expected(ctx: MirContext): String
  return ctx.niche_expected_type
end
def mir_ctx_clear_niche_expected(ctx: MirContext): Void
  ctx.niche_expected_type = ""
end

## B.10 §14.12.8 (C3) — set/clear the COW field-access +1 shift around a single
## offset call. Set to 1 by a field read/write/construct site when the receiver
## is a cow-layout buffer (mir_value_is_cow_layout == 1); read by
## mir_emit_load_offset / mir_emit_store_offset; cleared right after. Inert at
## gate 0 (predicate false ⇒ never set ⇒ +1 never applied ⇒ byte-identical IR).
def mir_ctx_set_cow_field_shift(ctx: MirContext, on: Int): Void
  ctx.cow_field_shift = on
end
def mir_ctx_get_cow_field_shift(ctx: MirContext): Int
  return ctx.cow_field_shift
end

## item 20 P2 — borrowed mutating value-struct `self` receiver flag (see the field
## doc). Set/cleared around a method body lowering in mir_lower_function{,_with_name}.
def mir_ctx_set_borrowed_self_receiver(ctx: MirContext, on: Int): Void
  ctx.borrowed_self_receiver = on
end
def mir_ctx_get_borrowed_self_receiver(ctx: MirContext): Int
  return ctx.borrowed_self_receiver
end

## The concrete Option payload type for a construction node, for the niche
## decision — WITHOUT perturbing general `mir_infer_expr_type` (isolated to the
## niche path so existing IR is untouched). Sources, in priority order:
##   1. the ambient expected type (the lvalue/return annotation) — authoritative,
##      and the ONLY source for `None`;
##   2. for `Some(x)`, the payload's own inferred type (incl. bool literals).
## Returns "" when undeterminable (⇒ SPILL — safe, and consistent because the
## read side derives the type the same way and also spills).
def mir_option_construction_payload(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, variant_name: String): String
  var exp = mir_option_payload_of_type(mir_ctx_get_niche_expected(ctx))
  return exp if str_byte_len(exp) > 0
  if variant_name == "Some"
    var payloads = ast::ast_get_payloads(s, node)
    if payloads != 0
      if payloads.size >= 1
        return mir_niche_scalar_lit_type(ctx, s, payloads[0])
      end
    end
  end
  return ""
end

## enum-niche M2 — construction-side recovery of the concrete `Result<A,B>` type for
## an `Ok(x)`/`Err(e)` construction, so the niche-multi construct decision agrees with
## the read (§14.4). The ONLY robust source is the ambient niche-expected type (the
## return/lvalue `Result<A,B>` annotation, set by the statement handlers around the
## operand) — `Ok(x)`/`Err(e)` carry only the payload, not the sibling type arg, so
## the bare construction node can't name both A and B. Returns "" when the ambient
## type isn't a `Result<…>` ⇒ SPILL (and the read side, lacking the type too, also
## spills ⇒ they agree). With the gate OFF, `mir_result_type_is_niche_multi` is always
## 0 at the callsite, so this never changes emitted IR.
def mir_result_construction_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, variant_name: String): String
  var exp = mir_ctx_get_niche_expected(ctx)
  return exp if exp.starts_with("Result<")
  return ""
end

## §14 N3 6.3b — construction-side payload recovery for the BARE `option_some`/
## `option_none` INTRINSIC call form (e.g. the qzmod cache codec's
## `mir_unpickle_function`, which builds its `Option<MirFunc>` via
## `option_some(func)` / `option_none()` rather than surface `Some`/`None`). The
## generic intrinsic codegen unconditionally emits a TAGGED 16-byte box; under
## niche layout the read side (`maybe.some?` / `maybe.unwrap()`, already niche-
## aware) interprets that box pointer AS the payload — so a populated value
## decodes as a heap address (and a contained Vec field reads null → crash in
## `_qzmod_rewrite_call_names`). This recovers the SAME payload type the surface
## path uses so construct and read agree (§14.4):
##   1. ambient expected type (return/lvalue annotation) — authoritative, and the
##      ONLY source for the arg-less `option_none()`;
##   2. for `option_some(arg)`, the arg's own inferred type.
## Returns "" when undeterminable ⇒ SPILL (legacy tagged-box intrinsic — and the
## read side spills too, so they still agree). When the master niche flag is OFF,
## `mir_option_is_niche` is always 0 at the callsite, so this never changes IR.
def mir_option_intrinsic_payload(ctx: MirContext, s: ast::AstStorage, is_some: Int, arg_node: AstNodeId): String
  var exp = mir_option_payload_of_type(mir_ctx_get_niche_expected(ctx))
  return exp if str_byte_len(exp) > 0
  if is_some == 1
    if arg_node != 0
      return mir_niche_scalar_lit_type(ctx, s, arg_node)
    end
  end
  return ""
end

## §14 N3 6.3d — bare-`None` un-annotated-local payload recovery (6th asymmetry).
## A `var x = Option::None` with NO annotation and NO payload node leaves the
## construction with no way to recover `P`: the surface `None` form carries no
## payload to infer from (unlike 6.3c's `option_some(arg)`), and at let-lowering
## time the var is not yet tracked (its type is only pinned by a LATER
## `x = Option::Some(P{..})` reassignment, possibly nested in an `if`/loop, and/or
## the typed field it flows into). The READ side recovers `Option<P>` (via the
## field's declared type / the var's by-then-tracked type) and niches; the bare-
## `None` construction must agree or the field holds a spill box that the niche
## read range-tests as non-null → `is None` wrongly false (theme.qz
## `theme_from_string`'s `base10_17`).
##
## Fix shape (option (b) from the handoff): a forward pre-scan over the enclosing
## body recovers `Option<P>` from the var's `x = Some(P{..})` / `option_some(arg)`
## reassignment and pre-marks the var's tracked type BEFORE its let is lowered, so
## the existing reassignment-fallback in the NODE_LET handler supplies it as the
## niche-construction expected type. Niche-gated end-to-end (the pre-scan no-ops
## when the master flag is off), so flag-OFF IR is byte-identical.

## Recover `P` from a `Some` payload node: a struct literal carries its name in
## str1 directly (avoids depending on var-tracking that isn't populated yet during
## the pre-scan); anything else falls back to mir_infer_expr_type. "" if unknown.
def mir_niche_some_payload_type(ctx: MirContext, s: ast::AstStorage, payload_node: AstNodeId): String
  return "" if payload_node == 0
  var pk = ast::ast_get_kind(s, payload_node)
  if pk == node_constants::NODE_STRUCT_INIT
    return ast::ast_get_str1(s, payload_node)
  end
  if pk == node_constants::NODE_ALLOC_EXPR
    var inner = ast::ast_get_left(s, payload_node)
    if inner >= 0 and ast::ast_get_kind(s, inner) == node_constants::NODE_STRUCT_INIT
      return ast::ast_get_str1(s, inner)
    end
  end
  return mir_infer_expr_type(ctx, s, payload_node)
end

## If `node` is an `Option::Some(P)` enum-access or `option_some(arg)` call, return
## `P`; else "". Used by the bare-None reassignment search.
def mir_niche_some_construct_payload(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  return "" if node < 0
  var k = ast::ast_get_kind(s, node)
  if k == node_constants::NODE_ENUM_ACCESS
    if ast::ast_get_variant(s, node) == "Some"
      var payloads = ast::ast_get_payloads(s, node)
      if payloads != 0
        if payloads.size >= 1
          return mir_niche_some_payload_type(ctx, s, payloads[0])
        end
      end
    end
    return ""
  end
  if k == node_constants::NODE_CALL
    var callee = ast::ast_get_left(s, node)
    if callee >= 0 and ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
      if ast::ast_get_str1(s, callee) == "option_some"
        var args = ast::ast_get_children(s, node)
        if args.size >= 1
          return mir_niche_some_payload_type(ctx, s, args[0])
        end
      end
    end
    return ""
  end
  return ""
end

## Recursively search `root` for a reassignment `var_name = Some(P{..})` /
## `option_some(arg)` and return the recovered `Option<P>` (e.g. the later
## conditional `ext = Option::Some(Base24Ext{..})` that pins a bare-None local).
## Both the reassigning-LET form (`x = …`, parser emits NODE_LET) and NODE_ASSIGN
## are handled; the search descends into `if`/loop/block bodies because the
## reassignment is typically nested. Returns "" when none found.
def mir_niche_search_some_reassign(ctx: MirContext, s: ast::AstStorage, root: AstNodeId, var_name: String): String
  return "" if root < 0
  var k = ast::ast_get_kind(s, root)
  # Reassignment / re-binding site: `name = Some(P)` (parser emits NODE_LET for
  # bare `x = …` and NODE_ASSIGN both). Check the str1-named target's RHS.
  if k == node_constants::NODE_LET or k == node_constants::NODE_ASSIGN
    if ast::ast_get_str1(s, root) == var_name
      var rhs = ast::ast_get_left(s, root)
      var pt = mir_niche_some_construct_payload(ctx, s, rhs)
      if str_byte_len(pt) > 0
        return "Option<#{pt}>"
      end
    end
    return ""
  end
  # Kind-directed descent into the statement containers that can hold a nested
  # reassignment. Deliberately NOT a blind children/left/right walk: most node
  # kinds have no children vector, and `ast_get_children` (as_vec) on a node
  # whose children slot is empty crashes. Only the containers below are walked.
  if k == node_constants::NODE_BLOCK or k == node_constants::NODE_MATCH
    # BLOCK: statement list. MATCH: arm list (each arm's body is its right child;
    # recursing on the arm node descends via this same function's arm handling
    # — but arms are not LET/ASSIGN, so descend into each arm's right (body)).
    var children = ast::ast_get_children(s, root)
    var cn = children.size
    for ci in 0..cn
      var child = children[ci]
      if child >= 0
        if k == node_constants::NODE_MATCH
          # arm node: body is the right child
          var arm_body = ast::ast_get_right(s, child)
          var ra = mir_niche_search_some_reassign(ctx, s, arm_body, var_name)
          return ra if str_byte_len(ra) > 0
        else
          var rc = mir_niche_search_some_reassign(ctx, s, child, var_name)
          return rc if str_byte_len(rc) > 0
        end
      end
    end
    return ""
  end
  if k == node_constants::NODE_IF
    # left=cond, right=then, extra=else
    var then_n = ast::ast_get_right(s, root)
    var rt = mir_niche_search_some_reassign(ctx, s, then_n, var_name)
    return rt if str_byte_len(rt) > 0
    var else_n = ast::ast_get_extra(s, root)
    var re = mir_niche_search_some_reassign(ctx, s, else_n, var_name)
    return re if str_byte_len(re) > 0
    return ""
  end
  if k == node_constants::NODE_WHILE or k == node_constants::NODE_FOR
    # body is the right child
    var body_n = ast::ast_get_right(s, root)
    return mir_niche_search_some_reassign(ctx, s, body_n, var_name)
  end
  if k == node_constants::NODE_EXPR_STMT
    # wrapped statement is the left child (e.g. a match/with in stmt position)
    var inner_n = ast::ast_get_left(s, root)
    return mir_niche_search_some_reassign(ctx, s, inner_n, var_name)
  end
  return ""
end

## 1 iff `node` is a `var x = Option::None` let with NO annotation (the bare-None
## un-annotated-local form). The reassigning `x = None` form (str1 already
## tracked) is handled by the existing fallback; this targets the FRESH binding
## whose type isn't yet known at let-lowering time.
def mir_niche_is_bare_none_let(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node < 0
  return 0 if ast::ast_get_kind(s, node) != node_constants::NODE_LET
  return 0 if str_byte_len(ast::ast_get_str2(s, node)) > 0
  var init = ast::ast_get_left(s, node)
  return 0 if init < 0
  return 0 if ast::ast_get_kind(s, init) != node_constants::NODE_ENUM_ACCESS
  return 0 if ast::ast_get_variant(s, init) != "None"
  var en = ast::ast_get_enum_name(s, init)
  return 1 if en == "Option"
  return 0
end

## Pre-scan a block's direct statements (called at the top of NODE_BLOCK
## lowering): for each bare-`None` un-annotated let, recover `Option<P>` from a
## later `Some(P)` reassignment anywhere in the function body (`body_root`) and
## pre-mark the var's tracked type so the let handler's reassignment-fallback
## supplies it as the niche-construction expected type. Niche-gated: a complete
## no-op when the master flag is off (⇒ flag-OFF IR is byte-identical).
def mir_niche_prescan_bare_none_lets(ctx: MirContext, s: ast::AstStorage, stmts: Vec, body_root: AstNodeId): Void
  return if mir_boxed_niche_enabled() == 0
  var n = stmts.size
  for i in 0..n
    var stmt = stmts[i]
    if mir_niche_is_bare_none_let(s, stmt) == 1
      var name = ast::ast_get_str1(s, stmt)
      # Only act if not already tracked (don't clobber an outer binding's type).
      if str_byte_len(mir_ctx_get_var_type(ctx, name)) == 0
        var recovered = mir_niche_search_some_reassign(ctx, s, body_root, name)
        if str_byte_len(recovered) > 0
          # Only niche-eligible payloads get pre-marked — keeps the effect scoped
          # to exactly the constructions that would otherwise spill-vs-niche split.
          var pl = mir_option_payload_of_type(recovered)
          if mir_option_is_niche(ctx, pl) == 1
            mir_ctx_mark_struct_var(ctx, name, recovered)
          end
        end
      end
    end
  end
end

## Narrow payload-type probe for the niche path: recognizes the literal/var
## forms whose Option is niche-eligible (today: `Bool`). Bool literals are
## NODE_BOOL_LIT; a typed local/param falls back to mir_infer_expr_type. Kept
## separate from mir_infer_expr_type so adding bool-literal typing here cannot
## shift UFCS/field-resolution decisions elsewhere.
def mir_niche_scalar_lit_type(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): String
  return "" if node == 0
  var k = ast::ast_get_kind(s, node)
  return "Bool" if k == node_constants::NODE_BOOL_LIT
  var inf = mir_infer_expr_type(ctx, s, node)
  return inf
end

## Read-side twin of mir_option_construction_payload: the concrete Option
## payload type of a match/if/is SUBJECT, via the subject's static type. "" ⇒
## spill. (Construction derives the same string from the same var/return
## annotation, so the two sides never disagree — §14.4.)
def mir_option_subject_payload(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): String
  return mir_option_payload_of_type(mir_infer_expr_type(ctx, s, subject_node))
end

## Niche-aware enum tag. For a niche Option the scalar value encodes the variant
## directly via range-membership in the niche run (§14.3): `Option` has exactly
## one dataless variant (`None`, K=1), so the run is the single value
## `{niche_start}` and the test is `value == niche_start` ⇒ `None` (tag 1), else
## `Some` (tag 0) — and the OP_EQ result IS exactly that tag (None=1/Some=0 per
## mir_find_variant_index_ctx). The membership test (vs. the earlier `>=`) is
## correct for BOTH a *top* niche (`Bool`, niche `{2,254}` above its valid 0/1)
## AND a *bottom* niche (`NonZero`/borrow/the N3 boxed-pointer null niche, niche
## `{0,1}` at 0 — where `>= 0` was always-true, hence always-None, a latent bug).
## Spill enums (and `payload_type == ""`) load tag at offset 0 as before, so
## callers lacking the static type stay byte-identical. (K>1 dataless would need
## the full `niche_start <= v < niche_start+K` range + per-variant tag mapping —
## not wired, since `Option` is K=1.)
def mir_get_enum_tag_niche(ctx: MirContext, enum_name: String, enum_val: MirReg, payload_type: String): Int
  if enum_name == "Option"
    if str_byte_len(payload_type) > 0
      if mir_option_is_niche(ctx, payload_type) == 1
        var nstart = mir_emit_const_int(ctx, mir_option_none_const(ctx, payload_type))
        return mir_emit_binary(ctx, op_constants::OP_EQ, enum_val, nstart)
      end
    end
  end
  # General single-payload+K-dataless user enum (gated). The scalar `enum_val`
  # encodes the variant via a BOTTOM niche: dataless variants are {0..K-1} (j-th
  # dataless variant ⇒ scalar j), the payload variant is the pointer (≥ K). The
  # match/`is` read sites compare the returned tag against the DECLARATION-ORDER
  # variant index, so reconstruct that index: `v ≥ K ⇒ payload_idx`, else the decl
  # index of the j=v-th dataless variant (a select chain over the {0..K-1} table).
  var gl = mir_enum_single_payload_layout(ctx, enum_name)
  if mir_enum_niche_payload_idx(gl) >= 0 and gl[0] == 1
    var resolved: String = mir_resolve_enum_name(ctx, enum_name)
    var k = mir_enum_niche_k(gl)
    var payload_idx = mir_enum_niche_payload_idx(gl)
    # Start from the payload index; fold each dataless scalar j in 0..K-1 as a
    # select `(v == j) ? decl_idx_j : acc`. The final acc is the decl-order tag.
    var acc = mir_emit_const_int(ctx, payload_idx)
    for j in 0..k
      var decl_idx = mir_enum_dataless_decl_idx_for_scalar(ctx, resolved, j)
      if decl_idx >= 0
        var jconst = mir_emit_const_int(ctx, j)
        var is_j = mir_emit_binary(ctx, op_constants::OP_EQ, enum_val, jconst)
        var dconst = mir_emit_const_int(ctx, decl_idx)
        acc = mir_emit_select(ctx, is_j, dconst, acc)
      end
    end
    return acc
  end
  # Multi-payload (M1 2-boxed Result) niche (gated ⇒ dead while the gate is OFF).
  # The packed word is `payload_ptr | tag` where tag = the variant's DECLARATION
  # index in the low spare bits; the tag IS that index directly, so masking the
  # low bits recovers the discriminant the match/`is` jump table expects. One i64
  # in, one i64 out (the §4 single-SSA-value invariant — no decomposition).
  var ml = mir_multi_enum_layout(ctx, enum_name)
  if niche::enum_layout_kind(ml) == niche::ENUM_LAYOUT_NICHE_MULTI
    var mask = mir_emit_const_int(ctx, mir_multi_enum_spare_mask(ml))
    return mir_emit_binary(ctx, op_constants::OP_AND, enum_val, mask)
  end
  return mir_get_enum_tag(ctx, enum_name, enum_val)
end

## 1 if a match/if/is on `subject_node` should use niche reads (subject is a
## niche-layout Option). Convenience wrapper the read sites gate on.
def mir_subject_is_niche_option(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  var pt = mir_option_subject_payload(ctx, s, subject_node)
  return 0 if str_byte_len(pt) == 0
  return mir_option_is_niche(ctx, pt)
end

## item 23 — 1 iff `subject_node` is an `Option<P>` whose payload `P` is an INLINE
## value-layout (`@value`) struct (and NOT niche). Such an Option SPILLS — its
## fields are embedded INLINE into the box `{tag@0, f0@1, f1@2, …}` by the
## construction path (mir_lower.qz ~4095) — so `unwrap`/`option_get` must return
## the INTERIOR ADDRESS `&box[word1]` (= box+8), mirroring the match-arm bind
## (mir_ctx_apply_pending_bind's is_inline branch), NOT a `load(box[word1])` scalar
## (the field-access consumer dereferences the returned word as a pointer → the
## item-23 SEGV). The box payload block is FLAT/header-less (construction strips the
## COW refcount header for >16B), so the bound name must be marked arena-owned for
## its field reads to stay offset+0 (no COW +1 shift). GATE-0-INERT: the compiler /
## std use ZERO `@value` Option payloads, so `mir_is_value_layout_type` is false for
## every Option payload here ⇒ this returns 0 everywhere ⇒ byte-identical self-host.
def mir_option_subject_is_inline_value(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  var pt = mir_option_subject_payload(ctx, s, subject_node)
  return 0 if str_byte_len(pt) == 0
  return 0 if mir_option_is_niche(ctx, pt) == 1
  return mir_is_value_layout_type(ctx, pt)
end

## item 27 — 1 iff `subject_node` is a COLLECTION READOUT CALL (`m.get(k)`, `v.get(i)`)
## whose Option payload is a value-layout (`@value`) struct. Such a readout's codegen
## (cg_intrinsic_data `hashmap_get` / the vec `.get` family) does NOT inline the
## struct's fields into the Some box — it stores the value's BUFFER-POINTER HANDLE at
## box[word1] (the cow refcount buffer for >16B; the flat-stack pointer for ≤16B).
## A LITERAL `Some(p)` by contrast inlines `p`'s flat fields into the box (mir_lower.qz
## ~4194), so the two constructions DISAGREE on what box[word1] holds (§14.4
## construct/read agreement). The inline-value unwrap returns `&box[word1]` (correct
## only for the literal's INLINED fields). For a handle-storing readout it must instead
## LOAD box[word1] (the stored buffer pointer), so the bound `r` is the cow/value HANDLE
## — then the read-out retain (`cow_rc_inc` on the handle) and the field-access +1 cow
## header-skip (gated on `r`'s tracked cow type) both apply correctly, and the value
## survives the collection being freed (h9). GATE-0-INERT: value-layout-gated ⇒ the
## compiler/std use ZERO `@value` map/vec values ⇒ this returns 0 everywhere ⇒
## byte-identical self-host (the non-`@value` collection reads keep the legacy unwrap).
def mir_option_subject_is_cow_handle_readout(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId): Int
  return 0 if subject_node == 0
  return 0 if ast::ast_get_kind(s, subject_node) != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, subject_node)
  return 0 if callee == 0
  return 0 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  var cfn = ast::ast_get_str1(s, callee)
  var is_readout = cfn == "map_get" or cfn == "vec_get" or cfn == "vec_get_unchecked"
  if is_readout == false
    is_readout = str_ends_with(cfn, "$map_get") == 1 or str_ends_with(cfn, "$vec_get") == 1 or str_ends_with(cfn, "$vec_get_unchecked") == 1
  end
  return 0 if is_readout == false
  var pt = mir_option_subject_payload(ctx, s, subject_node)
  return 0 if str_byte_len(pt) == 0
  return 0 if mir_option_is_niche(ctx, pt) == 1
  return mir_is_value_layout_type(ctx, pt)
end

## item 23 — 1 iff `node` is an `unwrap`/`option_get`/`$unwrap` CALL (single-arg
## form). Used at the let/assign bind site to arena-mark the bound name when the
## unwrapped Option has an inline `@value` payload (see mir_option_subject_is_inline_value).
def mir_option_subject_is_unwrap_call(s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node == 0
  return 0 if ast::ast_get_kind(s, node) != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, node)
  return 0 if callee == 0
  return 0 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  var fname = ast::ast_get_str1(s, callee)
  return 1 if fname == "unwrap" or fname == "option_get"
  return 1 if str_ends_with(fname, "$unwrap") == 1
  return 0
end

## item 23 — the unwrapped subject (arg[0]) of an unwrap/option_get CALL, else 0.
def mir_unwrap_call_subject(s: ast::AstStorage, node: AstNodeId): AstNodeId
  return 0 if mir_option_subject_is_unwrap_call(s, node) == 0
  var args = ast::ast_get_children(s, node)
  return 0 if args.size == 0
  return args[0]
end

## SURF.FLOW Phase 3 — layout-correct payload extraction for a flow-narrowed bare
## read (`if r is Ok` / `r.some?` / `e is Variant`, then a bare read of the subject
## inside the proven region). The typecheck identifier handler stamped this read's
## int_val to 1; control flow has PROVEN the subject is the narrowed variant, so we
## produce its single payload. The extraction is VARIANT-INDEPENDENT: every narrowable
## variant has exactly ONE payload at field offset 1, and the recovery mechanics
## depend only on the subject's LAYOUT (which the inferred static type selects),
## mirroring the match-arm bind (mir_ctx_apply_pending_bind):
##   - niche single-payload Option (Some)        → identity (the scalar IS the payload)
##   - niche single-payload user enum            → identity (boxed ptr IS the payload)
##   - niche-multi (built-in Result both-boxed, or M1 user enum) → mask off the low
##     spare tag bits: `value & ~((1<<low_zero)-1)` recovers the boxed payload pointer
##   - SPILL (Option / Result / user enum, tag@0/payload@1) → load offset 1
## `nr_val` is the already-loaded subject word; `subject_node` carries the static type.
def mir_emit_narrowed_read(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, nr_val: MirReg): Int
  # R2.1 (B4) — niche `T | Nil` union: no tag word, so the narrowed payload IS the
  # bare value (identity). Control flow (`if x is <arm>`) proved it is NOT the Nil
  # bit-pattern, so the value is the member directly — no `payload@1` load. The
  # SAME mir_union_is_niche verdict as the widen + is-check sites, so construct and
  # read agree. MUST precede the generic union SPILL `load@1` below. INERT at gate
  # 0 (no niche `T|Nil` union subject in the compiler/std ⇒ predicate 0).
  var nr_union_ann = mir_infer_expr_type(ctx, s, subject_node)
  if mir_is_union_annotation(nr_union_ann)
    return nr_val if mir_union_is_niche(ctx, nr_union_ann) == 1
  end
  # Niche single-payload Option — payload IS the scalar (identity).
  if mir_subject_is_niche_option(ctx, s, subject_node) == 1
    return nr_val
  end
  # Niche-multi: built-in Result (both args boxed) or M1 user multi-payload enum.
  # Recover the payload pointer by masking off the low spare tag bits.
  if mir_subject_is_niche_multi(ctx, s, subject_node) == 1
    var inferred = mir_infer_expr_type(ctx, s, subject_node)
    var low_zero = mir_result_niche_low_zero()   # 3 for built-in Result
    if inferred.starts_with("Result<") == false
      # M1 user enum: the spare-bit width comes from its layout descriptor.
      var base = inferred
      var lt = __char_index(base, '<')
      if lt > 0
        base = str_byte_slice(base, 0, lt)
      end
      var ml = mir_multi_enum_layout(ctx, base)
      low_zero = niche::enum_layout_niche_start(ml)
    end
    # value & ~((1<<low_zero)-1) emitted as `value & (-(1<<low_zero))`.
    var spare = 1
    var bi = 0
    var acc = 0
    while bi < low_zero
      acc = acc + spare
      spare = spare * 2
      bi = bi + 1
    end
    var clear = mir_emit_const_int(ctx, 0 - acc - 1)
    return mir_emit_binary(ctx, op_constants::OP_AND, nr_val, clear)
  end
  # Niche single-payload USER enum (boxed pointer IS the payload — identity).
  var inferred2 = mir_infer_expr_type(ctx, s, subject_node)
  if str_byte_len(inferred2) > 0
    var ubase = inferred2
    var ult = __char_index(ubase, '<')
    if ult > 0
      ubase = str_byte_slice(ubase, 0, ult)
    end
    if ubase != "Option" and ubase != "Result"
      if mir_enum_single_payload_layout(ctx, ubase)[0] == 1
        return nr_val
      end
    end
  end
  # item 42e — flow-narrowed read of a SPILL Result/Option whose narrowed (Ok/Some)
  # payload is a value-layout (`@value`/flip-eligible) struct. `if r is Ok; r.a` keeps
  # the narrow stamp on the field-access base `r` (tc_unstamp_narrowed_into_wide only
  # retracts a narrowed read flowing WHOLE into a wide let/return/struct-field/call-arg
  # slot — a field-access base is NONE of those), so this narrowed-read DOES fire. The
  # spill `load box[word1]` below reads the first INLINE FIELD VALUE (the construction
  # embeds the @value's FLAT field words at box[word1], mir_lower.qz ~4238), which the
  # field-access consumer then deref's as a payload pointer ⇒ the item-23 SIGSEGV (the
  # likely-next result_niche crash after item 42c). Mirror the item-23/40/42 inline-value
  # extracts: return the INTERIOR ADDRESS `box + 8` (no load) — the FLAT header-less
  # field block (construction strips the COW header for >16B), so the consumer's
  # `load_offset(box+8, field_idx)` reads each field at offset+0 for BOTH ≤16B and >16B.
  # Keyed on mir_result_subject_is_inline_value (Ok side) / mir_option_subject_is_inline_value
  # (Some side) ⇒ INERT at gate 0 (no `@value` Result/Option payload exists in the
  # compiler/std ⇒ never fires ⇒ self-host IR byte-identical).
  if mir_result_subject_is_inline_value(ctx, s, subject_node) == 1 or
     mir_option_subject_is_inline_value(ctx, s, subject_node) == 1
    var nr_eight = mir_emit_const_int(ctx, 8)
    return mir_emit_binary(ctx, op_constants::OP_ADD, nr_val, nr_eight)
  end
  # SPILL layout (Option / Result / user enum): tag@0, payload@offset 1. For the cases
  # that reach here the payload is pointer-like (the load is correct).
  return mir_emit_load_offset(ctx, nr_val, 1)
end

## The read-site entry point: niche-aware tag for a discriminant whose subject
## AST node is known (every match/if-let/is site on a top-level subject). Derives
## the subject's concrete Option payload type and dispatches to the niche range-
## test or the byte-identical boxed tag-load. Drop-in for `mir_get_enum_tag` at
## sites that carry `subject_node`.
def mir_get_enum_tag_subj(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, enum_name: String, enum_val: MirReg): Int
  # enum-niche M2 — a niche-MULTI built-in Result match reads its discriminant by
  # masking the low spare bits of the packed `payload_ptr | tag` word: tag = `v & 7`
  # (Ok ⇒ 0, Err ⇒ 1, matching the declaration-order variant index the match jump
  # table expects). Type-INDEPENDENT. Gated via `mir_subject_is_niche_multi` ⇒ INERT
  # while the gate is OFF (returns 0 ⇒ the byte-identical Option/spill tag-load below).
  # User M1 multi enums already niche-read through mir_get_enum_tag_niche's registry
  # path, so this branch is specifically the built-in-Result bridge (whose layout the
  # bare-name registry scan can't see).
  if mir_subject_is_niche_multi(ctx, s, subject_node) == 1
    var inferred = mir_infer_expr_type(ctx, s, subject_node)
    if inferred.starts_with("Result<")
      var mask = mir_emit_const_int(ctx, mir_result_niche_spare_mask())
      return mir_emit_binary(ctx, op_constants::OP_AND, enum_val, mask)
    end
  end
  return mir_get_enum_tag_niche(ctx, enum_name, enum_val, mir_option_subject_payload(ctx, s, subject_node))
end

## enum-niche tail item 1 — niche-aware tag for a NESTED constructor sub-pattern's
## inner value (`Outer(Inner::V(...))`). The three nested-dispatch read seams
## (mir_lower_if_pattern, the statement-context match arm, the value-context match
## arm) previously read the inner value with a RAW SPILL load + tagged-box
## `mir_get_enum_tag`, which corrupts/segfaults when the inner value is a niche
## representation (Option/Result/M1-user-enum packed into the low alignment bits of
## an 8-aligned pointer). This consolidates the niche read so the three sites stay
## in lockstep. `inner_static_ty` is the inner value's DECLARED type, recovered from
## the OUTER variant's field types at the read site. INERT for spill inners:
## mir_get_enum_tag_niche falls back to mir_get_enum_tag (the byte-identical spill
## tag-load) when the inner isn't niche, so non-niche inners emit identical IR.
def mir_get_enum_tag_nested(ctx: MirContext, inner_enum: String, inner_static_ty: String, inner_payload_val: MirReg): Int
  # Option niche + user single/multi-payload (M1) niche: mir_get_enum_tag_niche
  # self-dispatches on inner_enum (registry) / ptype (Option payload), exactly
  # mirroring how those reps are CONSTRUCTED into the outer's spill slot — an M1
  # user enum is niche-packed (`payload_ptr | tag`) even as a spill-outer payload,
  # so the registry read masks; a non-niche inner falls through to the byte-
  # identical tagged-box load. For a niche Option inner the payload type is needed
  # for the none-const range test; derive it from the inner's static `Option<P>`.
  #
  # NOTE — built-in Result<A,B>: a top-level / niche-outer Result niche-packs, but
  # as the payload of a SPILL outer enum it is constructed as a TAGGED BOX (no
  # `or`-mask — verified in IR). These nested-dispatch read sites only run when the
  # outer SPILLS, so the inner Result is always tagged-boxed here ⇒ NO `& 7` mask;
  # mir_get_enum_tag_niche falls through to mir_get_enum_tag (the tagged load),
  # which matches construction. Masking here (the original M2 bridge) read the box
  # heap pointer's low bits as a tag ⇒ wrong dispatch. The construction-side niche
  # asymmetry for nested Result payloads is filed for the conductor (item 1 tail).
  var ptype = ""
  if inner_static_ty.starts_with("Option<")
    ptype = mir_option_payload_of_type(inner_static_ty)
  end
  return mir_get_enum_tag_niche(ctx, inner_enum, inner_payload_val, ptype)
end

## enum-niche tail item 6 — recover the INNER payload value for a nested
## constructor sub-pattern bind (`Outer(Inner::V(x)) => ... x ...`). MUST agree
## with mir_get_enum_tag_nested's niche-vs-spill verdict (§14.10.Q4 construct/read/
## bind agreement): the SAME classifier decides, so a niche-packed inner is
## un-masked and a tagged-box inner is loaded at +1 — exactly mirroring how the
## inner was CONSTRUCTED. A mismatch (masking a tagged box, or load@+1 on a packed
## word) silently corrupts `x`. `inner_payload_val` is the already-loaded outer
## payload slot (`load@spi+1`); `inner_field_idx` is the inner variant's payload
## field position (0 for the single-field nested case). Emitted in item 1's
## inner_check_block, which dominates the arm block — apply_pending_bind only
## stores the returned reg.
##
## Niche verdicts (NO load — the payload lives in the scalar word itself):
##   * M1 multi-payload user enum (NICHE_MULTI): `inner_payload_val & ~spare_mask`
##     recovers the boxed payload pointer (tag was OR-ed into the low bits).
##   * single-payload+K-dataless niche user enum: the scalar IS the payload pointer
##     for the payload variant ⇒ identity bind (no mask, no load).
##   * niche Option `Some(x)`: the payload IS the scalar subject ⇒ identity bind.
## Spill verdict (the fallthrough, INCLUDING built-in Result nested in a spill
## outer — constructed as a TAGGED BOX, see mir_get_enum_tag_nested's note):
##   `load_offset(inner_payload_val, inner_field_idx + 1)` skips the inner tag word.
def mir_bind_enum_payload_nested(ctx: MirContext, inner_enum: String, inner_static_ty: String, inner_payload_val: MirReg, inner_variant: String, inner_field_idx: Int): Int
  # M1 multi-payload niche: un-mask the low tag bits to recover the payload pointer.
  # Mirrors mir_get_enum_tag_niche's NICHE_MULTI branch and apply_pending_bind's
  # `value & ~mask` arithmetic (complement = 0 - spare_mask - 1).
  if inner_enum != "Option" and inner_enum != "Result"
    var ml = mir_multi_enum_layout(ctx, inner_enum)
    if niche::enum_layout_kind(ml) == niche::ENUM_LAYOUT_NICHE_MULTI
      var spare = mir_multi_enum_spare_mask(ml)
      var clear = mir_emit_const_int(ctx, 0 - spare - 1)
      return mir_emit_binary(ctx, op_constants::OP_AND, inner_payload_val, clear)
    end
    # single-payload+K-dataless niche user enum: the scalar IS the payload pointer
    # for the payload variant (identity-after-niche). Mirrors mir_get_enum_tag_niche's
    # single-payload branch — no mask, no load.
    var gl = mir_enum_single_payload_layout(ctx, inner_enum)
    if mir_enum_niche_payload_idx(gl) >= 0 and gl[0] == 1
      var resolved: String = mir_resolve_enum_name(ctx, inner_enum)
      var vidx = mir_find_variant_index_ctx(ctx, resolved, inner_variant)
      if vidx == mir_enum_niche_payload_idx(gl)
        return inner_payload_val
      end
    end
  end
  # niche Option Some(x): identity bind (the scalar subject IS the payload).
  if inner_enum == "Option" and inner_variant == "Some"
    if inner_static_ty.starts_with("Option<")
      var optp = mir_option_payload_of_type(inner_static_ty)
      if str_byte_len(optp) > 0 and mir_option_is_niche(ctx, optp) == 1
        return inner_payload_val
      end
    end
  end
  # item 40 — inline-embedded value-layout inner payload. The construct side
  # (mir_lower.qz is_oR path) stores a value-layout (≤16B inline OR >16B CoW,
  # header stripped) struct's WORDS directly into the inner box at word offset
  # inner_field_idx+1, NOT a payload pointer. So the spill `load_offset(+1)`
  # below would read the FIRST WORD of the value (e.g. the field int 7) and bind
  # it as a payload POINTER → the arm body derefs 0x7 → SIGSEGV. Mirror the
  # top-level seam (apply_pending_bind's is_inline branch, §12.10): bind the
  # INTERIOR ADDRESS `inner_payload_val + (inner_field_idx+1)*8` (no load); the
  # caller marks the name arena-owned so field reads use flat offset+0 (no COW
  # +1 shift). The value's words live FLAT (header-less) at that address, so an
  # arena-owned struct read lands on each field correctly — including the >16B
  # 3-field case. INERT at gate 0: no @value enum payload exists in the
  # compiler's own source ⇒ this branch is never taken there ⇒ byte-identical.
  if mir_nested_bind_is_inline(ctx, inner_enum, inner_static_ty, inner_variant) == 1
    var byte_off = mir_emit_const_int(ctx, (inner_field_idx + 1) * 8)
    return mir_emit_binary(ctx, op_constants::OP_ADD, inner_payload_val, byte_off)
  end
  # Spill (incl. built-in Result nested in a spill outer ⇒ TAGGED BOX): load the
  # inner payload at field offset +1 (offset 0 is the inner tag word).
  return mir_emit_load_offset(ctx, inner_payload_val, inner_field_idx + 1)
end

## item 40 — does the nested inner payload bind embed an inline value-layout
## struct (⇒ interior-address bind, arena-owned)? The construct side inlines a
## value-layout payload for single-payload Option/Result; user enums + niche
## shapes are handled by the earlier branches in mir_bind_enum_payload_nested
## (which return before the inline branch), so this only needs to recognize the
## Option/Result spill-outer shape. Mirrors mir_set_pending_inline_for_enum's
## §12.10 predicate (mir_is_value_layout_type on the resolved payload struct).
## Gate-0 inert: returns 0 unless the inner payload is a value-layout struct,
## and no @value enum payload exists in the compiler's own source.
def mir_nested_bind_is_inline(ctx: MirContext, inner_enum: String, inner_static_ty: String, inner_variant: String): Int
  if inner_enum != "Option" and inner_enum != "Result"
    return 0
  end
  # A niche Option Some(x) binds the scalar subject identically (handled above);
  # its payload is pointer-like, never a value-layout struct, so the niche guard
  # is implied by mir_is_value_layout_type below. Recover the inner payload type
  # from the inner static `Option<P>` / `Result<A,B>`.
  var ptype = ""
  if inner_enum == "Option" and inner_static_ty.starts_with("Option<")
    ptype = mir_option_payload_of_type(inner_static_ty)
  elsif inner_enum == "Result" and inner_static_ty.starts_with("Result<")
    if inner_variant == "Ok"
      ptype = mir_result_ok_type(inner_static_ty)
    elsif inner_variant == "Err"
      ptype = mir_result_err_type(inner_static_ty)
    end
  end
  if str_byte_len(ptype) == 0
    return 0
  end
  var pres = mir_resolve_struct_name(ctx, mir_strip_generic_head(ptype))
  if mir_is_value_layout_type(ctx, pres) == 1
    return 1
  end
  return 0
end

## enum-niche tail item 6 — the inner payload's CONCRETE type for a nested bind, so
## apply_pending_bind can mir_ctx_mark_struct_var the bound name (`x.v` field access
## resolves). Reads the inner variant's payload field annotation from the inner
## enum's variant-field registry; for built-in Result, derives A (Ok)/B (Err) from
## the inner static `Result<A,B>`. "" when unknown (downstream falls back).
def mir_nested_bind_payload_type(ctx: MirContext, inner_enum: String, inner_static_ty: String, inner_variant: String, inner_field_idx: Int): String
  if inner_enum == "Result" and inner_static_ty.starts_with("Result<")
    if inner_variant == "Ok"
      return mir_result_ok_type(inner_static_ty)
    end
    if inner_variant == "Err"
      return mir_result_err_type(inner_static_ty)
    end
  end
  if inner_enum == "Option" and inner_static_ty.starts_with("Option<")
    return mir_option_payload_of_type(inner_static_ty)
  end
  var fts = mir_ctx_lookup_variant_field_types(ctx, inner_enum, inner_variant)
  if fts != 0 and inner_field_idx < fts.size
    return as_string(fts[inner_field_idx])
  end
  return ""
end

## B.10 §12.10 — Compute + store the per-binding inline-@value flags for a pending
## enum-payload binding, mirroring construction's inline decision so the match
## binds an INTERIOR ADDRESS for an inlined @value payload instead of a loaded
## pointer. v1: single-payload Option/Result whose payload type is a @value
## struct. Every other shape leaves flags=0 (the byte-identical boxed load).
def mir_set_pending_inline_for_enum(ctx: MirContext, s: ast::AstStorage, subject_node: AstNodeId, enum_name: String, variant_name: String, names: Vec<String>): Void
  var flags = vec_new<Int>()
  var nc = names.size
  for i in 0..nc
    flags.push(0)
  end
  if nc == 1
    if enum_name == "Option" or enum_name == "Result"
      # Source 1: the subject's static type args (Option<P> → P). Source 2 (the
      # binding's own type, set by typecheck's tc_bind_pattern_variables from the
      # subject type) backstops it when the subject type didn't carry args.
      var ptype = mir_enum_payload_concrete_type(ctx, s, subject_node, enum_name, variant_name)
      if str_byte_len(ptype) == 0
        ptype = mir_ctx_get_var_type(ctx, as_string(names[0]))
      end
      if str_byte_len(ptype) > 0
        var pres = mir_resolve_struct_name(ctx, mir_strip_generic_head(ptype))
        # item 36 — single layout key (flip-eligible plain struct OR @value).
        # Gate-0 inert ⇒ byte-identical. resolved name re-resolves idempotently.
        if mir_is_value_layout_type(ctx, pres) == 1
          vec_set(flags, 0, 1)
        end
      end
    end
  end
  ctx.pending_bind_inline = flags
  # B.10 §14 N1 — niche flag, parallel to the inline flag. When the subject is a
  # niche-layout Option, `Some`'s single payload binding IS the scalar subject
  # value (identity), so apply_pending_bind must NOT load from offset 1.
  var niche_flags = vec_new<Int>()
  for ni in 0..nc
    niche_flags.push(0)
  end
  if enum_name == "Option" and variant_name == "Some" and nc == 1
    if mir_subject_is_niche_option(ctx, s, subject_node) == 1
      vec_set(niche_flags, 0, 1)
    end
  end
  # General single-payload+K-dataless user enum (gated): matching the PAYLOAD
  # variant binds the scalar subject value verbatim (identity) — the boxed pointer
  # IS the payload, so apply_pending_bind must NOT load from offset 1.
  if nc == 1 and enum_name != "Option" and enum_name != "Result"
    var gl = mir_enum_single_payload_layout(ctx, enum_name)
    if mir_enum_niche_payload_idx(gl) >= 0 and gl[0] == 1
      var resolved: String = mir_resolve_enum_name(ctx, enum_name)
      var vidx = mir_find_variant_index_ctx(ctx, resolved, variant_name)
      if vidx == mir_enum_niche_payload_idx(gl)
        vec_set(niche_flags, 0, 1)
        # Track the bound payload's concrete type so downstream reads (field
        # access / UFCS on it) resolve — mirrors mir_mark_pattern_bindings_typed.
        var ptype = mir_enum_niche_payload_type(gl)
        if str_byte_len(ptype) > 0
          mir_ctx_mark_struct_var(ctx, as_string(names[0]), ptype)
        end
      end
    end
  end
  # B.10 §14.9 multi-payload M1 (gated ⇒ all-zero while the gate is OFF). Matching a
  # payload variant of a niche-multi enum binds the packed word `payload_ptr | tag`;
  # the bound pointer must MASK off the low tag bits to recover the payload pointer.
  # Record the spare-bit count (low_zero) per binding so apply_pending_bind masks.
  var niche_mask_flags = vec_new<Int>()
  for mi in 0..nc
    niche_mask_flags.push(0)
  end
  if nc == 1 and enum_name != "Option" and enum_name != "Result"
    var ml = mir_multi_enum_layout(ctx, enum_name)
    if niche::enum_layout_kind(ml) == niche::ENUM_LAYOUT_NICHE_MULTI
      var mresolved: String = mir_resolve_enum_name(ctx, enum_name)
      # Every payload variant of an M1 enum is a single boxed pointer; binding it
      # is identity-after-mask (the masked pointer IS the payload). Mark the
      # binding's concrete type for downstream reads, mirroring the single-payload
      # path. low_zero (the mask width) goes into the per-binding mask vector.
      var mout = vec_new()
      mout.push("")
      var mvidx = mir_find_variant_index_ctx(ctx, mresolved, variant_name)
      if mir_multi_variant_is_single_boxed(ctx, mresolved, mvidx, mout) == 1
        vec_set(niche_flags, 0, 1)
        vec_set(niche_mask_flags, 0, niche::enum_layout_niche_start(ml))
        var mptype = as_string(mout[0])
        if str_byte_len(mptype) > 0
          mir_ctx_mark_struct_var(ctx, as_string(names[0]), mptype)
        end
      end
    end
  end
  # enum-niche M2 — built-in Result niche-multi payload bind. Matching `Ok(x)`/`Err(e)`
  # of a niche-multi `Result<A,B>` binds the packed `payload_ptr | tag` word; the bound
  # pointer must MASK off the low tag bits (`& ~7`) to recover the boxed payload. The
  # built-in Result isn't in the user-enum registry the M1 block above scans, so it
  # needs the type-arg-aware `mir_subject_is_niche_multi`; the bound payload's concrete
  # type is A (Ok) or B (Err) from the subject's `Result<A,B>`. Gated ⇒ all-zero while
  # OFF (mir_subject_is_niche_multi returns 0 ⇒ no mask ⇒ byte-identical load@1).
  if nc == 1 and (variant_name == "Ok" or variant_name == "Err")
    if mir_subject_is_niche_multi(ctx, s, subject_node) == 1
      var rinf = mir_infer_expr_type(ctx, s, subject_node)
      if rinf.starts_with("Result<")
        vec_set(niche_flags, 0, 1)
        vec_set(niche_mask_flags, 0, mir_result_niche_low_zero())
        var rptype = mir_result_ok_type(rinf)
        if variant_name == "Err"
          rptype = mir_result_err_type(rinf)
        end
        if str_byte_len(rptype) > 0
          mir_ctx_mark_struct_var(ctx, as_string(names[0]), rptype)
        end
      end
    end
  end
  ctx.pending_bind_niche = niche_flags
  ctx.pending_bind_niche_mask = niche_mask_flags
end

def mir_ctx_apply_pending_bind(ctx: MirContext): Void
  var pending_names = ctx.pending_bind_names
  if pending_names.size > 0
    var pending_base = ctx.pending_bind_base
    var inline_flags = ctx.pending_bind_inline
    var niche_flags = ctx.pending_bind_niche
    var niche_mask_flags = ctx.pending_bind_niche_mask
    for i in 0..pending_names.size
      var name = pending_names[i]
      # Skip wildcard bindings — _ means discard the payload
      if name != "_"
        # Register the binding as a local FIRST so the arm body's
        # NODE_IDENT lowering resolves `name` to this payload slot
        # (mir_ctx_lookup_var) instead of falling through to a same-named
        # free function/method (e.g. a match arm binding `msg` shadowing a
        # `Box.msg` method). Without this, mir_ctx_lookup_var misses, the
        # ident path emits a bogus `@<Type>$<name>` func-ref, and the arm
        # returns a function pointer where the field value was expected —
        # the single-field-variant throw-payload SEGFAULT (fail_typed →
        # BuildError::AssertionFailed). Mirrors the struct/vec destructure
        # paths, which already alloc_slot + bind_var before store_var.
        var bind_slot = mir_ctx_alloc_slot(ctx)
        mir_ctx_bind_var(ctx, name, bind_slot)
        var is_inline = 0
        if i < inline_flags.size
          is_inline = as_int(inline_flags[i])
        end
        var is_niche = 0
        if i < niche_flags.size
          is_niche = as_int(niche_flags[i])
        end
        var niche_mask = 0
        if i < niche_mask_flags.size
          niche_mask = as_int(niche_mask_flags[i])
        end
        var payload_val = 0
        if is_niche == 1 and niche_mask > 0
          # B.10 §14.9 multi-payload M1 — the payload pointer has `niche_mask` low
          # tag bits OR-ed in; mask them OFF to recover the pointer. `value & ~mask`
          # emitted as `value & complement` where complement = -(1<<mask). The
          # masked pointer IS the single-boxed payload (identity-after-mask). One
          # i64 in (pending_base), one i64 out — the §4 single-SSA-value invariant.
          var spare_mask = 1
          var bi = 0
          var acc = 0
          while bi < niche_mask
            acc = acc + spare_mask
            spare_mask = spare_mask * 2
            bi = bi + 1
          end
          var clear = mir_emit_const_int(ctx, 0 - acc - 1)
          payload_val = mir_emit_binary(ctx, op_constants::OP_AND, pending_base, clear)
        elsif is_niche == 1
          # B.10 §14 N1 — niche `Some(x)`: the payload IS the scalar subject
          # value itself (no box, no load). identity bind.
          payload_val = pending_base
        elsif is_inline == 1
          # B.10 §12.10 — inline @value payload: bind the INTERIOR ADDRESS
          # (base + (i+1)*8), no load. The value's words live in the enum at
          # word offset i+1; field access on `name` reads them directly (single
          # indirection), byte-identical downstream to a boxed pointer deref but
          # with no separate heap box. Offset i+1 holds for single-payload
          # Option/Result (v1); the gate in mir_set_pending_inline_for_enum
          # restricts inline to exactly that shape.
          var byte_off = mir_emit_const_int(ctx, (i + 1) * 8)
          payload_val = mir_emit_binary(ctx, op_constants::OP_ADD, pending_base, byte_off)
          # 14C — the inline @value payload was copied into the enum as a FLAT,
          # header-less field block (the construct side strips the COW refcount
          # header when reading a >16B value-layout payload). So this interior
          # address is a flat offset+0 buffer, exactly like an arena-owned struct.
          # Mark it arena-owned so its field reads do NOT apply the COW +1 shift
          # (which would read one word past each field — the off-by-tag enum-payload
          # miscompile for field_count >= 3). INERT at gate 0: no @value enum
          # payload exists in the compiler's own source, so this name is never
          # inline-bound there ⇒ byte-identical.
          mir_ctx_mark_arena_owned(ctx, name)
        else
          # Load payload from offset i+1 (offset 0 is the tag)
          payload_val = mir_emit_load_offset(ctx, pending_base, i + 1)
        end
        mir_emit_store_var(ctx, name, payload_val)
      end
    end
    ctx.pending_bind_names = vec_new<String>()
    ctx.pending_bind_base = 0
    ctx.pending_bind_inline = vec_new<Int>()
    ctx.pending_bind_niche = vec_new<Int>()
    ctx.pending_bind_niche_mask = vec_new<Int>()
  end
  # enum-niche tail item 6 — drain nested inner-payload binds. Each recovered reg
  # was emitted in item 1's inner_check_block (which dominates this arm block) by
  # mir_bind_enum_payload_nested, so here we only alloc_slot + bind_var + store_var
  # and mark the bound name's concrete type so `x.v` field access resolves. Reset
  # per arm (parallel to the outer-bind reset) so nested binds never leak across
  # arms. Independent of the outer pending_bind state above (a nested bind may
  # coexist with — or be the only thing in — an arm).
  var nested_names = ctx.pending_nested_bind_names
  if nested_names.size > 0
    var nested_regs = ctx.pending_nested_bind_regs
    var nested_types = ctx.pending_nested_bind_types
    var nested_inline = ctx.pending_nested_bind_inline
    for ni in 0..nested_names.size
      var nn = as_string(nested_names[ni])
      if nn != "_"
        var nslot = mir_ctx_alloc_slot(ctx)
        mir_ctx_bind_var(ctx, nn, nslot)
        mir_emit_store_var(ctx, nn, as_int(nested_regs[ni]))
        var nty = as_string(nested_types[ni])
        if str_byte_len(nty) > 0
          mir_ctx_mark_struct_var(ctx, nn, nty)
        end
        # item 40 — the recovered reg is an INTERIOR ADDRESS into the outer enum
        # box (inline value-layout inner payload), not a loaded pointer. Mark it
        # arena-owned so its FLAT (header-less) field block reads use offset+0 —
        # no COW +1 shift (which would read one word past each field, the
        # off-by-tag miscompile for field_count >= 3). Mirrors the top-level
        # is_inline branch (§12.10). Gate-0 inert (no @value enum payload).
        var n_inl = 0
        if ni < nested_inline.size
          n_inl = as_int(nested_inline[ni])
        end
        if n_inl == 1
          mir_ctx_mark_arena_owned(ctx, nn)
        end
      end
    end
    ctx.pending_nested_bind_names = vec_new<String>()
    ctx.pending_nested_bind_regs = vec_new<Int>()
    ctx.pending_nested_bind_types = vec_new<String>()
    ctx.pending_nested_bind_inline = vec_new<Int>()
  end
end

# ============================================================================
# Compile-time FNV-1a hash (mirrors @__str_hash runtime)
# ============================================================================

def fnv1a_hash(s: String): Int
  var hash = -3750763034362895579
  var slen = str_byte_len(s)
  for i in 0..slen
    var ch = str_byte_at(s, i)
    hash ^= ch
    hash *= 1099511628211
  end
  return hash
end


# ============================================================================
# Lambda Capture Collection
# ============================================================================

# Check if name is in a list of strings (parameter names or captures)
def mir_is_in_list(name: String, names: Vec<String>): Int
  return 1 if any?(names, n: String -> name == n)
  return 0
end

# Helper: push a (tag, data) pair onto the capture worklist, returns new top
def mir_cap_wl_push(wl: Vec<Int>, top: Int, tag: Int, data: Int): Int
  if top < wl.size
    vec_set(wl, top, tag)
  else
    wl.push(tag)
  end
  if top + 1 < wl.size
    vec_set(wl, top + 1, data)
  else
    wl.push(data)
  end
  return top + 2
end

# Helper: push a name onto the capture scope chain, returns new top
def mir_cap_scope_push(scope: Vec<Int>, top: Int, name_int: Int): Int
  if top < scope.size
    vec_set(scope, top, name_int)
  else
    scope.push(name_int)
  end
  return top + 1
end

# Helper: check if a name exists in the capture scope chain
def mir_cap_scope_has(scope: Vec<Int>, top: Int, name: String): Int
  for i in 0..top
    if as_string(scope[i]).eq(name)
      return 1
    end
  end
  return 0
end

# Iterative capture walker — collects free variables from a lambda body
# Uses explicit worklist + scope chain instead of recursion to avoid
# stack overflow on deeply nested closure-heavy files (e.g. QSpec tests)
# Worklist tags: 0=VISIT, 1=POP_SCOPE_TO, 2=ADD_LET_NAME, 3=ADD_NAME
def mir_collect_captures_walk(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, params: Int, captures: Vec<String>): Void
  return if node == 0
  var wl = vec_new()
  var wl_top = 0
  var scope = vec_new()
  var scope_top = 0

  # Initialize scope with incoming params
  var init_pc = vec_size(params)
  for init_pi in 0..init_pc
    scope.push(params[init_pi])
    scope_top += 1
  end

  # Seed worklist with initial node
  wl.push(0)
  wl.push(as_int(node))
  wl_top = 2

  while wl_top > 0
    wl_top -= 2
    var tag = wl[wl_top]
    var data = wl[wl_top + 1]

    if tag == 1
      # POP_SCOPE_TO: restore scope chain
      scope_top = data
    elsif tag == 2
      # ADD_LET_NAME: conditionally shadow a name declared by a preceding statement.
      # A BREAK label and a FRESH local decl (var/const, int_val==1) genuinely shadow
      # an outer capture and must be pushed. A BARE reassignment `name = expr` lowers
      # to NODE_LET int_val==0 (the CST cannot tell fresh-decl from reassign for a
      # bare ident — cst_parser cps_assign_kind_for_lhs) and rebinds an EXISTING slot;
      # when `name` is an outer local that is a MUT-CAPTURE, not a shadow. Pushing it
      # here is the pre-existing capture-drop crash (WS1a): the reassigned outer name
      # is treated as a fresh local and dropped from the capture set.
      var nk = ast::ast_get_kind(s, data)
      if nk == node_constants::NODE_BREAK
        scope_top = mir_cap_scope_push(scope, scope_top, as_int(ast::ast_get_str1(s, data)))
      elsif nk == node_constants::NODE_LET
        if ast::ast_get_int_val(s, data) == 1
          scope_top = mir_cap_scope_push(scope, scope_top, as_int(ast::ast_get_str1(s, data)))
        end
      end
    elsif tag == 3
      # ADD_NAME: unconditionally add name to scope
      scope_top = mir_cap_scope_push(scope, scope_top, data)
    elsif tag == 0
      # VISIT: process a node. B.15d/N3.1 step-4a-2 — guard against non-node
      # integers that reach this worklist via slots like a for-node's `int_val`
      # step (which can hold a type id, not an AstNodeId). Pre-flip those were
      # the in-bounds TYPE_STRUCT(=7); per-struct nominal ids (≥7000) overflow
      # the node array. Mirrors the tc_collect_captures_walk guard.
      if data > 0 and data < ast::ast_node_count(s)
        var kind = ast::ast_get_kind(s, data)

        if kind == node_constants::NODE_IDENT
          var name = ast::ast_get_str1(s, data)
          if mir_cap_scope_has(scope, scope_top, name) == 0
            if mir_is_in_list(name, captures) == 0
              # Variable lookup comes FIRST: if the name is bound as a local
              # in the outer scope, it MUST be captured regardless of whether
              # it also matches a stdlib intrinsic name (collection-name
              # collisions like `first`, `sum`, `map`, `take`). Removing the
              # pre-lookup intrinsic gate was A5's fix — before that, a local
              # variable named `first` in the lambda's outer scope would be
              # silently eaten by the intrinsic check, leaving the lambda body
              # referencing an unallocated `%first` at codegen time.
              if not str_contains(name, "$")
                var val = mir_ctx_lookup_var(ctx, name)
                if val >= 0
                  captures.push(name)
                end
              end
            end
          end

        elsif kind == node_constants::NODE_BINARY
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_UNARY
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_CALL
          var args = ast::ast_get_children(s, data)
          if args != 0
            var ai = args.size - 1
            while ai >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, args[ai])
              ai -= 1
            end
          end
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_IF
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_extra(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_BLOCK
          var stmts = ast::ast_get_children(s, data)
          if stmts != 0
            var sc = stmts.size
            var saved = scope_top
            wl_top = mir_cap_wl_push(wl, wl_top, 1, saved)
            # Push stmts in reverse, interleaving ADD_LET_NAME
            var ri = sc - 1
            while ri >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, stmts[ri])
              if ri > 0
                wl_top = mir_cap_wl_push(wl, wl_top, 2, stmts[ri - 1])
              end
              ri -= 1
            end
          end

        elsif kind == node_constants::NODE_RETURN
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_LET
          # WS1a — a BARE reassignment `name = expr` lowers to NODE_LET int_val==0.
          # The VISIT walks only the RHS (ast_get_left), so a WRITE-ONLY reassignment
          # `{ a = Struct{...} }` whose RHS never references `a` would leave the outer
          # name `a` uncollected → no env slot → lost mutation / uninit value-layout
          # read fault. Treat the LHS name as a capture candidate here, mirroring the
          # NODE_IDENT logic: an outer local (mir_ctx_lookup_var >= 0), not shadowed by
          # a closure-local decl, not already captured, no `$`. int_val==1 (a fresh
          # `var name = …` decl) introduces a new local and is NOT a capture.
          if ast::ast_get_int_val(s, data) == 0
            var let_name = ast::ast_get_str1(s, data)
            if str_byte_len(let_name) > 0
              if mir_cap_scope_has(scope, scope_top, let_name) == 0
                if mir_is_in_list(let_name, captures) == 0
                  if not str_contains(let_name, "$")
                    if mir_ctx_lookup_var(ctx, let_name) >= 0
                      captures.push(let_name)
                    end
                  end
                end
              end
            end
          end
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_LET_DESTRUCTURE
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_STRUCT_DESTRUCTURE or kind == node_constants::NODE_VEC_DESTRUCTURE
          var destr_init = ast::ast_get_left(s, data)
          if destr_init > 0
            wl_top = mir_cap_wl_push(wl, wl_top, 0, destr_init)
          end

        elsif kind == node_constants::NODE_OR_PATTERN
          var or_cap_pats = ast::ast_get_children(s, data)
          if or_cap_pats != 0
            var or_cap_cnt = vec_size(or_cap_pats)
            for or_ci in 0..or_cap_cnt
              wl_top = mir_cap_wl_push(wl, wl_top, 0, or_cap_pats[or_ci])
            end
          end

        elsif kind == node_constants::NODE_ASSIGN
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_COMPOUND_ASSIGN
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))

        elsif kind == node_constants::NODE_EXPR_STMT
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_INDEX
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_FIELD_ACCESS
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_TRY_CATCH
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_WITH
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_LAMBDA
          var inner_params = ast::ast_get_left(s, data)
          var inner_body = ast::ast_get_right(s, data)
          var saved = scope_top
          wl_top = mir_cap_wl_push(wl, wl_top, 1, saved)
          wl_top = mir_cap_wl_push(wl, wl_top, 0, inner_body)
          # Add inner param names to scope immediately
          if inner_params != 0
            var ipc = vec_size(inner_params)
            for ipi in 0..ipc
              scope_top = mir_cap_scope_push(scope, scope_top, as_int(ast::ast_get_str1(s, inner_params[ipi])))
            end
          end

        elsif kind == node_constants::NODE_WHILE
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_FOR
          var f_iter = ast::ast_get_left(s, data)
          var f_body = ast::ast_get_right(s, data)
          var f_var = ast::ast_get_str1(s, data)
          var saved = scope_top
          wl_top = mir_cap_wl_push(wl, wl_top, 1, saved)
          wl_top = mir_cap_wl_push(wl, wl_top, 0, f_body)
          wl_top = mir_cap_wl_push(wl, wl_top, 3, as_int(f_var))
          # Walk step expression if present
          var f_step = ast::ast_get_int_val(s, data)
          if f_step > 0
            wl_top = mir_cap_wl_push(wl, wl_top, 0, f_step)
          end
          wl_top = mir_cap_wl_push(wl, wl_top, 0, f_iter)

        elsif kind == node_constants::NODE_FOR_AWAIT
          var fa_iter = ast::ast_get_left(s, data)
          var fa_body = ast::ast_get_right(s, data)
          var fa_var = ast::ast_get_str1(s, data)
          var saved = scope_top
          wl_top = mir_cap_wl_push(wl, wl_top, 1, saved)
          wl_top = mir_cap_wl_push(wl, wl_top, 0, fa_body)
          wl_top = mir_cap_wl_push(wl, wl_top, 3, as_int(fa_var))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, fa_iter)

        elsif kind == node_constants::NODE_INDEX_ASSIGN
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_extra(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_FIELD_ASSIGN
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_extra(s, data))
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_MATCH
          var arms = ast::ast_get_children(s, data)
          if arms != 0
            var mai = arms.size - 1
            while mai >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, arms[mai]))
              wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, arms[mai]))
              mai -= 1
            end
          end
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_INTERP_STRING
          var parts = ast::ast_get_children(s, data)
          if parts != 0
            var ipi = parts.size - 1
            while ipi >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, parts[ipi])
              ipi -= 1
            end
          end

        elsif kind == node_constants::NODE_STRUCT_INIT
          var fields = ast::ast_get_children(s, data)
          if fields != 0
            var fi = fields.size - 1
            while fi >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_right(s, fields[fi]))
              fi -= 1
            end
          end
          # C.1 spread base lives in `lefts` until tc desugar.
          var su_base = ast::ast_get_left(s, data)
          if su_base != 0
            wl_top = mir_cap_wl_push(wl, wl_top, 0, su_base)
          end

        elsif kind == node_constants::NODE_SPREAD
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_ARRAY
          var elems = ast::ast_get_children(s, data)
          if elems != 0
            var ei = elems.size - 1
            while ei >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, elems[ei])
              ei -= 1
            end
          end

        elsif kind == node_constants::NODE_TUPLE_LITERAL
          var elems = ast::ast_get_children(s, data)
          if elems != 0
            var ei = elems.size - 1
            while ei >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, elems[ei])
              ei -= 1
            end
          end

        elsif kind == node_constants::NODE_SET_LITERAL
          var elems = ast::ast_get_children(s, data)
          if elems != 0
            var ei = elems.size - 1
            while ei >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, elems[ei])
              ei -= 1
            end
          end

        elsif kind == node_constants::NODE_MAP_LIT
          var elems = ast::ast_get_children(s, data)
          if elems != 0
            var ei = elems.size - 1
            while ei >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, elems[ei])
              ei -= 1
            end
          end

        elsif kind == node_constants::NODE_SAFE_FIELD_ACCESS
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_TRY_EXPR
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_AWAIT
          # await expr — walk the awaited expression so its free vars get captured
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_GO
          # go func(args) — walk the inner call so its free vars get captured
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_ASYNC_CALL
          # async func(args) — walk the inner call so its free vars get captured
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_ENUM_ACCESS
          # Enum::Variant(payload, ...) — payloads in `children`. Without this
          # case, a lambda body of `FrameMsg::App(seq)` silently dropped `seq`
          # from captures: env had no slot, body emitted `%seq` with no alloca,
          # llc rejected with "use of undefined value '%seq'".
          # See LAMBDA_CAPTURE_BODY_NOT_REWRITTEN_TO_ENV bug doc.
          var ea_payloads = ast::ast_get_children(s, data)
          if ea_payloads != 0
            var eai = ea_payloads.size - 1
            while eai >= 0
              wl_top = mir_cap_wl_push(wl, wl_top, 0, ea_payloads[eai])
              eai -= 1
            end
          end

        elsif kind == node_constants::NODE_IS_CHECK
          # `expr is Variant` — subject in `left`.
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_TYPE_CAST
          # `expr as Type` — base in `left`.
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_YIELD
          # `yield expr` — value in `left`.
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))

        elsif kind == node_constants::NODE_DEFER
          # `defer expr` — body in `left`.
          wl_top = mir_cap_wl_push(wl, wl_top, 0, ast::ast_get_left(s, data))
        end
        # Default: literals and other leaf nodes — no children to push
      end
    end
  end
end

# Collect captures for a lambda in MIR lowering phase
def mir_collect_captures(ctx: MirContext, s: ast::AstStorage, lambda_node: AstNodeId): Vec<String>
  var captures = vec_new<String>()
  var params = ast::ast_get_left(s, lambda_node)
  var body = ast::ast_get_right(s, lambda_node)
  
  # Build param names vec
  var param_names = vec_new()
  if params != 0
    param_names = map(params, p: Int -> as_int(ast::ast_get_str1(s, p)))
  end
  
  mir_collect_captures_walk(ctx, s, body, param_names, captures)
  return captures
end

## WS2 — walk an lvalue spine (field-access / index chain) down to its base
## binding name. `p.x` / `p.q.x` / `a[i]` / `a[i].x` all bottom out at the base
## IDENT `p` / `a`. Returns "" for a non-place spine (a call result, literal, or
## other temporary — such a write can never touch a captured named slot).
def mir_assign_base_name(s: ast::AstStorage, node: AstNodeId): String
  return "" if node == 0 or node <= 0 or node >= ast::ast_node_count(s)
  var k = ast::ast_get_kind(s, node)
  if k == node_constants::NODE_IDENT
    return ast::ast_get_str1(s, node)
  elsif k == node_constants::NODE_FIELD_ACCESS
    return mir_assign_base_name(s, ast::ast_get_left(s, node))
  elsif k == node_constants::NODE_INDEX
    return mir_assign_base_name(s, ast::ast_get_left(s, node))
  end
  return ""
end

## R-WS3 / WS2 — recursively record assign-TARGET base names reachable in `node`.
## WHOLE-VAR reassignment targets go into `out`; FIELD/INDEX-write bases go into
## `field_out`. Descends left/right/extra/children generically (over-approximate
## traversal is safe: only assign targets are recorded). Does NOT descend into a
## nested NODE_LAMBDA (a Phase-1 conservative choice: an inner lambda's mutations
## are its own concern; the outer lambda that merely reads `x` stays by-value).
def mir_collect_assign_targets(s: ast::AstStorage, node: AstNodeId, out: Vec<String>, field_out: Vec<String>): Void
  return if node == 0 or node <= 0 or node >= ast::ast_node_count(s)
  var kind = ast::ast_get_kind(s, node)
  # Do not cross into nested closures.
  return if kind == node_constants::NODE_LAMBDA

  # WHOLE-VAR reassignment (mode 1): a bare `name = …` / `name += …` rebinds the
  # captured local's SLOT, so persisting it into the caller requires by-ref for ANY
  # layout (the primary `total = total + it` target). Recorded into `out`.
  #
  # FIELD/INDEX assign (`p.x = …`, `a[i] = …`, mode 2): recorded SEPARATELY into
  # `field_out`, because the by-ref decision is LAYOUT-DEPENDENT (applied later in
  # the eligibility gate, which has the type in hand):
  #  - For a heap/pointer base (plain-struct pointer, Vec, Map) the capture IS the
  #    shared pointer, so the field/element write already lands in the caller's
  #    object under by-value-of-pointer semantics — NO by-ref, and by-ref'ing it
  #    would wrongly relayout the compiler's own `ctx.field = …`-in-HOF closures
  #    (MirContext is GC-firewall-mixed ⇒ NOT value-layout ⇒ the gate keeps it
  #    by-value ⇒ byte-identical). So the eligibility gate only by-refs a VALUE-
  #    LAYOUT base.
  #  - For a VALUE-LAYOUT (@value / F4) base the by-value snapshot loses the field
  #    write, so it needs by-ref — the persistence WS2 delivers.
  if kind == node_constants::NODE_ASSIGN or kind == node_constants::NODE_COMPOUND_ASSIGN
    var an = ast::ast_get_str1(s, node)
    if str_byte_len(an) > 0
      out.push(an)
    end
  elsif kind == node_constants::NODE_FIELD_ASSIGN
    # `obj.f = …` — base name of the object spine (`ast_get_left`).
    var fb = mir_assign_base_name(s, ast::ast_get_left(s, node))
    if str_byte_len(fb) > 0
      field_out.push(fb)
    end
  elsif kind == node_constants::NODE_INDEX_ASSIGN
    # `a[i] = …` — base name of the array spine (`ast_get_left`).
    var ib = mir_assign_base_name(s, ast::ast_get_left(s, node))
    if str_byte_len(ib) > 0
      field_out.push(ib)
    end
  elsif kind == node_constants::NODE_LET
    # The CST lowers a BARE reassignment `name = expr` to NODE_LET with int_val==0
    # (no `var`); a fresh mutable decl `var name = expr` has int_val==1. Only the
    # bare reassignment rebinds an EXISTING slot — and when `name` is a captured
    # outer local, that is exactly the mut-capture we must take by-reference
    # (`total = total + it`). A fresh `var`-decl (int_val==1) introduces a NEW local
    # that shadows any same-named capture, so it must NOT count. int_val==0 whose
    # name is NOT a capture is harmless: mir_classify_capture_modes filters to the
    # capture set, so a bare new-const-local of a non-captured name is ignored.
    if ast::ast_get_int_val(s, node) == 0
      var ln = ast::ast_get_str1(s, node)
      if str_byte_len(ln) > 0
        out.push(ln)
      end
    end
  end

  # Recurse into structural slots.
  mir_collect_assign_targets(s, ast::ast_get_left(s, node), out, field_out)
  mir_collect_assign_targets(s, ast::ast_get_right(s, node), out, field_out)
  mir_collect_assign_targets(s, ast::ast_get_extra(s, node), out, field_out)
  var children = ast::ast_get_children(s, node)
  if children != 0
    var cc = children.size
    for ci in 0..cc
      mir_collect_assign_targets(s, children[ci], out, field_out)
    end
  end
end

## R-WS3 / WS2 — classify each captured name:
##   0 = read           (by-value snapshot)
##   1 = whole-var mut  (`name = …` — by-ref for ANY layout when non-escaping)
##   2 = field/index mut (`name.f = …` / `name[i] = …` — by-ref ONLY for a
##                        VALUE-LAYOUT base, gated in the eligibility loop)
## Returns a Vec<Int> parallel to `captures`. Whole-var mut (1) wins over field/
## index mut (2) if a name is both. This function is STRUCTURAL — the layout gate
## for mode 2 lives in the eligibility loop (mir_lower_lambda) where the type is in
## hand. Gate-0 result: the compiler's own closures never whole-var-reassign a
## captured local ⇒ no mode 1; the `ctx.field=…`-in-HOF closures are mode 2 but on a
## firewall-mixed (non-value-layout) base ⇒ the eligibility gate keeps them by-value
## ⇒ byte-identical.
def mir_classify_capture_modes(ctx: MirContext, s: ast::AstStorage, lambda_node: AstNodeId, captures: Vec<String>): Vec<Int>
  var modes = vec_new<Int>()
  var cn = vec_size(captures)
  var body = ast::ast_get_right(s, lambda_node)
  var targets = vec_new<String>()
  var field_targets = vec_new<String>()
  mir_collect_assign_targets(s, body, targets, field_targets)
  for i in 0..cn
    var name = captures[i]
    var is_mut = 0
    for ti in 0..targets.size
      if targets[ti].eq(name)
        is_mut = 1
      end
    end
    # Field/index write — only when NOT already a whole-var reassignment (mode 1
    # wins, since it needs by-ref for any layout).
    if is_mut == 0
      for fi in 0..field_targets.size
        if field_targets[fi].eq(name)
          is_mut = 2
        end
      end
    end
    modes.push(is_mut)
  end
  return modes
end

def main(): Int = 0
