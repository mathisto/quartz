##! # LLVM IR Separate & Incremental Compilation
##!
##! Alternative codegen entry points for incremental (cache-aware)
##! and separate (per-module) compilation modes.
##!
##! @see codegen Main codegen entry points (cg_codegen, cg_codegen_debug)
##! @see codegen_util Shared codegen utilities

import mir
import * from mir
import codegen
import codegen_util
import codegen_runtime
import std/emit
import codegen_ctx
import file_io
import * from str_compat

## INC.1.7 — moved to `codegen_util::cg_extract_module`. Re-exported as
## a thin wrapper so `cg_codegen_incremental`'s in-file call sites stay
## unqualified.
def cg_extract_module(func_name: String): String = codegen_util::cg_extract_module(func_name)

## Check if a module name is in a recompile set.
def _cg_module_in_set(mod_name: String, recompile_set: Vec<String>): Int
  for i in 0..recompile_set.size
    if recompile_set[i].eq(mod_name)
      return 1
    end
  end
  return 0
end

## INC.1.6 — parse a per-module fragment body (V2 format) and populate
## the caller-provided function-name → IR-slice map. Linear scan over
## the body finds every ";;FN <name>;;\n" marker; the IR for that
## function is everything up to (but not including) the next marker, or
## EOF. Function names across the program are globally unique (each is
## module-prefixed), so a single flat map can hold every loaded
## fragment's contents. Building per fragment is O(body_len); per-
## function lookups are O(1), avoiding an O(N²) per-function scan.
def _cg_parse_frag_into(frag_body: String, m: Map<String, String>): Void
  if str_byte_len(frag_body) == 0
    return
  end
  var body_len = str_byte_len(frag_body)
  var marker = ";;FN "
  var marker_len = str_byte_len(marker)
  var cur = __str_index(frag_body, marker)
  while cur >= 0
    # Parse the function name: from cur + marker_len up to ";;\n".
    var name_start = cur + marker_len
    var name_end = __str_index_from(frag_body, ";;\n", name_start)
    if name_end < 0
      # Malformed marker — bail.
      return
    end
    var fname = str_byte_slice(frag_body, name_start, name_end)
    var ir_start = name_end + 3
    var next_marker = __str_index_from(frag_body, marker, ir_start)
    var ir_end = body_len
    if next_marker >= 0
      ir_end = next_marker
    end
    var ir_text = str_byte_slice(frag_body, ir_start, ir_end)
    m.set(fname, ir_text)
    cur = next_marker
  end
end

## Incremental code generation.
## Emits fresh codegen for functions in recompile_modules, loads cached IR for others.
## Pre-loads the string pool from cache to maintain stable string indices.
##
## Returns the combined LLVM IR.
def cg_codegen_incremental(prog: MirProgram, target: String, all_funcs: Vec<ResolverEntry>, overflow_check: Int, stack_alloc: Int, recompile_modules: Vec<String>, cached_pool: Vec<String>, cache_dir: String, race_mode: Int, exclusivity_check: Int): String
  var out = sb_new()
  defer sb_free(out)

  # Emit header
  codegen_util::cg_emit_line(out, "; Generated by Quartz self-hosted compiler (incremental)")
  codegen_util::cg_emit_line(out, "")

  # Emit runtime declarations
  var tg_flag = prog.mir_get_uses_task_group()
  var sched_flag = prog.mir_get_uses_scheduler()
  codegen_runtime::cg_emit_runtime_decls(out, target, tg_flag, sched_flag, prog.mir_get_uses_scope_deadline())

  # Emit struct type definitions for narrow-field structs
  codegen_runtime::cg_emit_struct_types(out, prog)

  # Emit global variable declarations
  codegen::cg_emit_global_vars(out, prog)

  # Emit const declarations
  codegen::cg_emit_const_decls(out, prog)

  # Initialize codegen state
  var state = codegen_util::cg_new_state()
  codegen_util::cg_set_overflow_check(state, overflow_check)
  codegen_util::cg_set_exclusivity_check(state, exclusivity_check)
  codegen_util::cg_set_stack_alloc(state, stack_alloc)
  codegen_util::cg_set_race_mode(state, race_mode)
  codegen::cg_collect_extern_info(state, all_funcs)

  # Pre-load cached string pool
  var pool_limit = cached_pool.size
  for pi in 0..pool_limit
    state.string_pool.push(cached_pool[pi])
  end
  state.string_count = pool_limit

  # Pre-scan for mir::MIR_FUNC_REF targets
  codegen::cg_prescan_func_ref_targets(state, prog)

  # INC.1.6: compute reachable function set so we can DCE both the fresh
  # emission and the cached-fragment load. Mirrors cg_codegen which has
  # always run this. Without it, the incremental path emits every function
  # in `prog.functions` regardless of reachability — see
  # `feedback_cg_codegen_incremental_no_dce_warm_doubled.md` for the
  # measurement (2890 defines vs cold's 1160 on qzmod_inject_spec).
  codegen::cg_compute_reachable(state, prog)

  # INC.1.6: per-function fragment migration. Older fragments concatenated
  # function IRs without delimiters, so the load path couldn't extract a
  # specific function's slice. The new format prepends each function's IR
  # with a ";;FN <name>;;" comment line and writes a "META_V2:" header.
  # We use the sentinel file `<modules>/.format_v2` to detect whether
  # cached fragments are in the new format. If the sentinel is missing,
  # the pre-scan treats every cached module as needing fresh emission
  # (forces a one-time fragment rewrite per cache directory).
  var inc_format_sentinel = "#{cache_dir}/modules/.format_v2"
  var inc_format_ok = 0
  if str_byte_len(cache_dir) > 0 and fio_exists(inc_format_sentinel)
    inc_format_ok = 1
  end

  # Emit functions: fresh codegen for changed modules, cached fragments for unchanged
  # Uses deterministic metadata slots: function i starts at i * 128
  var funcs = prog.mir_get_functions()
  var func_count = funcs.size

  # Pre-scan: ensure all "unchanged" modules have cached fragments AND
  # those fragments are in the new (per-function-delimited) format. If
  # either fails, the module is pushed onto recompile_modules so its
  # functions emit fresh and a new V2 fragment is written below.
  # Unreachable functions are skipped so a module whose only references
  # are dead doesn't force itself into recompile_modules.
  var checked_mods = vec_new<String>()
  for pre_i in 0..func_count
    var pre_func = funcs[pre_i]
    var pre_fname = pre_func.mir_func_get_name()
    if codegen::cg_is_reachable_fn(state, pre_fname) == 0
      continue
    end
    var pre_fmod = cg_extract_module(pre_fname)
    if _cg_module_in_set(pre_fmod, recompile_modules) == 0
      # Check if already verified
      var pre_checked = 0
      for pci in 0..checked_mods.size
        if checked_mods[pci].eq(pre_fmod)
          pre_checked = 1
          break
        end
      end
      if pre_checked == 0
        var pre_frag_path = "#{cache_dir}/modules/#{pre_fmod}.ll"
        var pre_exists = fio_exists(pre_frag_path)
        if inc_format_ok == 0 or not pre_exists
          # Fragment missing or pre-V2 format — must emit fresh
          recompile_modules.push(pre_fmod)
        end
        checked_mods.push(pre_fmod)
      end
    end
  end

  # Track which modules we emit fresh (for saving updated fragments)
  var fresh_mod_names = vec_new<String>()
  var fresh_mod_builders = vec_new()
  var fresh_mod_meta = vec_new()  # Vec of Vec<Int> — loop metadata IDs per fresh module
  # Track which modules we loaded from cache (to avoid loading twice)
  # and a single flat function-name → IR-slice map populated by
  # `_cg_parse_frag_into` as each module's fragment loads. Function
  # names are globally unique (module-prefixed by `cg_extract_module`'s
  # inverse), so one map suffices and per-function lookup is O(1).
  var loaded_mods = vec_new<String>()
  var loaded_fn_ir = map_new<String, String>()

  for i in 0..func_count
    var func = funcs[i]
    var fname = func.mir_func_get_name()
    var is_reachable = codegen::cg_is_reachable_fn(state, fname)
    var fmod = cg_extract_module(fname)
    var is_recompile_mod = _cg_module_in_set(fmod, recompile_modules)

    if is_recompile_mod
      # Bug A.1 — full-surface fragment emission for the recompile branch.
      # User-source functions (origin_module non-empty) always land in
      # their module's fragment so future cache consumers see the complete
      # module surface even when this compile's call graph didn't reach
      # every fn. Synthetic functions (lambdas, async ctors, etc.) leave
      # origin_module == "" and are gated on reachability as before.
      var has_origin = str_byte_len(func.mir_func_get_origin_module()) > 0
      var emit_to_main = is_reachable == 1
      var emit_to_frag = has_origin == 1
      if emit_to_main == 0 and emit_to_frag == 0
        continue
      end
      # Changed module — emit fresh with deterministic metadata slot
      state.metadata_counter = i * 128
      var prev_md_count = state.loop_metadata_ids.size
      # Ambient Emit install wraps the whole per-fn emission + post-processing.
      # Fresh-local sb + method-call-on-local work inside the body — the
      # lambda-method-resolution bug flagged during P5.3.d.2 no longer
      # reproduces on this compiler (see docs/bugs/ memo for context).
      var func_ir = ""
      codegen_ctx::cg_ctx_set(out)
      with Emit {
        emit: codegen_ctx::cg_ctx_emit_handler,
        emit_line: codegen_ctx::cg_ctx_emit_line_handler,
        emit_int: codegen_ctx::cg_ctx_emit_int_handler
      } do ->
        var func_buf = sb_new()
        codegen::cg_emit_function(state, func_buf, prog, func, i)
        func_ir = func_buf.to_string()
        sb_free(func_buf)
      end
      # INC.1.6: per-function delimiter so the saved fragment can be
      # sliced back into per-function IR on the next warm load. The marker
      # is an LLVM IR comment line — llc ignores `;`-prefixed lines.
      var marker = ";;FN #{fname};;\n"
      if emit_to_main == 1
        sb_append(out, marker)
        sb_append(out, func_ir)
      end
      if emit_to_frag == 1
        # Collect for saving updated fragment
        var found_fm = -1
        for fmi in 0..fresh_mod_names.size
          if fresh_mod_names[fmi].eq(fmod)
            found_fm = fmi
            break
          end
        end
        if found_fm >= 0
          var esb = fresh_mod_builders[found_fm]
          sb_append(esb, marker)
          sb_append(esb, func_ir)
          var existing_meta = fresh_mod_meta[found_fm]
          var mdi = prev_md_count
          while mdi < state.loop_metadata_ids.size
            vec_push(existing_meta, state.loop_metadata_ids[mdi])
            mdi += 1
          end
        else
          fresh_mod_names.push(fmod)
          var nsb = sb_new()
          sb_append(nsb, marker)
          sb_append(nsb, func_ir)
          fresh_mod_builders.push(nsb)
          var new_meta = vec_new()
          var mdi = prev_md_count
          while mdi < state.loop_metadata_ids.size
            new_meta.push(state.loop_metadata_ids[mdi])
            mdi += 1
          end
          fresh_mod_meta.push(new_meta)
        end
      end
    else
      # Unchanged module path: only emit reachable functions. Cache fragment
      # is consulted; unreachable funcs are skipped entirely.
      if is_reachable == 0
        continue
      end
      # Unchanged module — load cached fragment once, then extract this
      # function's IR per request (INC.1.6).
      var loaded_idx = -1
      for li in 0..loaded_mods.size
        if loaded_mods[li].eq(fmod)
          loaded_idx = li
          break
        end
      end
      if loaded_idx < 0
        var cached_frag_path = "#{cache_dir}/modules/#{fmod}.ll"
        var cached_frag = ""
        if fio_exists(cached_frag_path)
          cached_frag = fio_read(cached_frag_path)
        end
        var frag_body = ""
        if str_byte_len(cached_frag) > 0
          # Parse metadata header: META_V2:id1,id2,...\n---\n<IR>
          var sep = __str_index(cached_frag, "\n---\n")
          if sep >= 0
            var header = str_byte_slice(cached_frag, 0, sep)
            frag_body = str_byte_slice(cached_frag, sep + 5, str_byte_len(cached_frag))
            # Parse loop metadata IDs from header. INC.1.6 uses the
            # `META_V2:` prefix (8 bytes); pre-V2 fragments are filtered
            # out by the pre-scan above so we don't need fallback parsing.
            if str_byte_len(header) > 8
              var md_str = str_byte_slice(header, 8, str_byte_len(header))
              if str_byte_len(md_str) > 0
                var md_parts = str_split(md_str, ",")
                for mi in 0..md_parts.size
                  if str_byte_len(md_parts[mi]) > 0
                    state.loop_metadata_ids.push(str_to_int(md_parts[mi]))
                  end
                end
              end
            end
          end
        end
        _cg_parse_frag_into(frag_body, loaded_fn_ir)
        loaded_mods.push(fmod)
        loaded_idx = loaded_mods.size - 1
      end
      # Emit only this function's slice from the cached fragment.
      var slice_ir = ""
      if loaded_fn_ir.has(fname)
        slice_ir = loaded_fn_ir.get(fname).unwrap_or("")
      end
      if str_byte_len(slice_ir) > 0
        sb_append(out, slice_ir)
      else
        # INC.2.5: the cached fragment is DCE-pruned against the
        # producing program's call graph — `cg_codegen` gates fragment
        # collection on `cg_is_reachable_fn`, so a function the producer
        # never reached is absent from its module's fragment. A consumer
        # whose call graph DOES reach it (here: a spec that reaches
        # `Progress$spinner_only` via a `go`-synthetic the prewarm never
        # lowered) would otherwise emit a `call` with no `define`. The
        # fragment is an optimization, not the source of truth: fall
        # back to fresh codegen from the module's MIR, which is present
        # in `prog` because hit-with-MIR modules ship their MIR bodies.
        state.metadata_counter = i * 128
        var fb_ir = ""
        codegen_ctx::cg_ctx_set(out)
        with Emit {
          emit: codegen_ctx::cg_ctx_emit_handler,
          emit_line: codegen_ctx::cg_ctx_emit_line_handler,
          emit_int: codegen_ctx::cg_ctx_emit_int_handler
        } do ->
          var fb_buf = sb_new()
          codegen::cg_emit_function(state, fb_buf, prog, func, i)
          fb_ir = fb_buf.to_string()
          sb_free(fb_buf)
        end
        sb_append(out, ";;FN #{fname};;\n")
        sb_append(out, fb_ir)
      end
    end
  end

  # Save updated fragments for changed modules + write `.format_v2`
  # sentinel. INC.1.7: extracted into
  # `codegen_util::cg_write_module_fragments` so the cold path
  # (`cg_codegen`/`cg_codegen_debug`) can write fragments the same way
  # and warm-mod-1 finds them rather than over-invalidating every
  # module via the safety net in `quartz.qz`.
  codegen_util::cg_write_module_fragments(fresh_mod_names, fresh_mod_builders, fresh_mod_meta, cache_dir)

  # Emit module init (incremental path)
  codegen::cg_emit_module_init(state, out, prog)

  # Emit string constants
  codegen_util::cg_emit_string_constants(state, out)

  # Emit FNV-1a string hash helper
  codegen_runtime::cg_emit_str_hash_helper(out, 0)

  # Emit effect-dispatch runtime (Milestone D.1). Hosted only.
  if codegen_runtime::cg_is_freestanding(target) == 0
    codegen_runtime::cg_emit_effect_runtime(out, 0, prog.mir_get_uses_scheduler(), prog.mir_get_uses_intern(), prog.mir_get_uses_cache(), prog.mir_get_uses_profile(), prog.mir_get_uses_yield())
  end

  # Emit per-struct hash/eq functions and custom-key map runtime
  codegen_runtime::cg_emit_struct_hash_eq_functions(out, prog)
  codegen_runtime::cg_emit_custom_map_functions(out)

  # Emit panic + backtrace helpers. Freestanding gets stubs with
  # `unreachable` bodies; hosted gets the libc-backed versions.
  if codegen_runtime::cg_is_freestanding(target) == 1
    codegen_runtime::cg_emit_freestanding_panic_stubs(out, 0)
  else
    if state.overflow_check == 1
      codegen_runtime::cg_emit_overflow_panic_helper(out, 0)
    end
    if state.exclusivity_check == 1
      codegen_runtime::cg_emit_access_head_tls(out, target, 0)
      codegen_runtime::cg_emit_exclusivity_panic_helper(out, 0)
    end
    codegen_runtime::cg_emit_bounds_panic_helper(out, 0)
    codegen_runtime::cg_emit_map_key_panic_helper(out, 0)
    codegen_runtime::cg_emit_async_lock_drain_panic_helper(out, 0)
    codegen_runtime::cg_emit_backtrace_helper(out, 0, target)
  end

  # Emit main wrapper
  if codegen_runtime::cg_is_freestanding(target) == 0
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "; Main entry point wrapper")
    if codegen_runtime::cg_is_wasi(target)
      codegen_util::cg_emit_line(out, "define void @_start() {")
      codegen_util::cg_emit_line(out, "  %result = call i64 @qz_main()")
      codegen_util::cg_emit_line(out, "  ret void")
      codegen_util::cg_emit_line(out, "}")
    else
      codegen_util::cg_emit_line(out, "define i32 @main(i32 %argc, ptr %argv) {")
      codegen_util::cg_emit_line(out, "  %argc64 = sext i32 %argc to i64")
      codegen_util::cg_emit_line(out, "  store i64 %argc64, ptr @qz_argc")
      codegen_util::cg_emit_line(out, "  store ptr %argv, ptr @qz_argv")
      if state.race_mode == 1
        codegen_util::cg_emit_line(out, "  call void @__qz_race_init()")
      end
      # Effects D.4 — runtime init + default handlers (hosted only).
      codegen_runtime::cg_emit_effect_main_prelude(out, prog.mir_get_uses_intern(), prog.mir_get_uses_cache(), prog.mir_get_uses_profile())
      codegen_util::cg_emit_line(out, "  %result = call i64 @qz_main()")
      codegen_util::cg_emit_line(out, "  %result32 = trunc i64 %result to i32")
      if sched_flag == 1
        codegen_util::cg_emit_line(out, "  call i32 @fflush(ptr null)")
        codegen_util::cg_emit_line(out, "  call void @_exit(i32 %result32)")
        codegen_util::cg_emit_line(out, "  unreachable")
      end
      codegen_util::cg_emit_line(out, "  ret i32 %result32")
      codegen_util::cg_emit_line(out, "}")
    end
  end

  # Emit race detector runtime if enabled
  if state.race_mode == 1
    codegen_runtime::cg_emit_race_detector_runtime(out, target)
  end

  # Emit loop vectorization metadata
  codegen_util::cg_emit_loop_metadata(state, out)

  # Save string pool for incremental cache
  _cg_last_string_pool = state.string_pool

  return out.to_string()
end

# ============================================================================
# Separate Compilation (P.3)
# ============================================================================

## Separate compilation: emit per-module .ll files.
## The compiler still runs monolithically through lex → parse → typecheck → MIR.
## The split happens at codegen: emit N .ll files (one per module), each independently
## compilable by llc.
##
## Returns a manifest string: newline-separated list of .ll file paths written.
def cg_codegen_separate(prog: MirProgram, target: String, all_funcs: Vec<ResolverEntry>, overflow_check: Int, stack_alloc: Int, topo_order: Vec<String>, cache_dir: String, race_mode: Int, exclusivity_check: Int): String
  # Phase 1: Collect all MIR functions grouped by module
  var funcs = prog.mir_get_functions()
  var func_count = funcs.size
  var tg_flag = prog.mir_get_uses_task_group()
  var sched_flag = prog.mir_get_uses_scheduler()

  # Build module → function index mapping
  # mod_names: unique module names in order encountered
  # mod_func_indices: parallel Vec of Vec<Int> — function indices per module
  var mod_names = vec_new<String>()
  var mod_func_indices = vec_new()  # Vec of Vec<Int>
  for i in 0..func_count
    var func = funcs[i]
    var fname = func.mir_func_get_name()
    var fmod = codegen_util::cg_module_for_func(fname)
    # Find or create module entry
    var found = -1
    for mi in 0..mod_names.size
      if mod_names[mi].eq(fmod)
        found = mi
        break
      end
    end
    if found < 0
      mod_names.push(fmod)
      var indices = vec_new()
      indices.push(i)
      mod_func_indices.push(indices)
    else
      var indices = mod_func_indices[found]
      indices.push(i)
    end
  end

  # Phase 1b: Also scan globals and constants for modules that have no functions
  # (e.g., node_constants, op_constants — pure constant-definition modules)
  var g_names = prog.mir_get_global_names()
  for gi in 0..g_names.size
    var gn = g_names[gi]
    var gdollar = __char_index(gn, '$')
    var gmod = "__main__"
    if gdollar > 0
      gmod = str_byte_slice(gn, 0, gdollar)
    end
    var gfound = 0
    for gmi in 0..mod_names.size
      if mod_names[gmi].eq(gmod)
        gfound = 1
        break
      end
    end
    if gfound == 0
      mod_names.push(gmod)
      mod_func_indices.push(vec_new())
    end
  end
  var c_names = prog.mir_get_const_names()
  for ci in 0..c_names.size
    var cn = c_names[ci]
    var cdollar = __char_index(cn, '$')
    var cmod = "__main__"
    if cdollar > 0
      cmod = str_byte_slice(cn, 0, cdollar)
    end
    var cfound = 0
    for cmi in 0..mod_names.size
      if mod_names[cmi].eq(cmod)
        cfound = 1
        break
      end
    end
    if cfound == 0
      mod_names.push(cmod)
      mod_func_indices.push(vec_new())
    end
  end

  # Phase 2: Initialize shared codegen state
  var state = codegen_util::cg_new_state()
  codegen_util::cg_set_overflow_check(state, overflow_check)
  codegen_util::cg_set_exclusivity_check(state, exclusivity_check)
  codegen_util::cg_set_stack_alloc(state, stack_alloc)
  codegen_util::cg_set_race_mode(state, race_mode)
  codegen::cg_collect_extern_info(state, all_funcs)
  codegen::cg_prescan_func_ref_targets(state, prog)

  # Determine which module is the "main" module (contains qz_main)
  var main_mod = "__main__"

  # Collect all defined function names per module (for cross-module declare computation)
  # all_defined[mi] = Vec<String> of function names defined in module mi
  var all_defined = vec_new()  # Vec of Vec<String>
  var all_mono = vec_new()     # Vec of Vec<String> — monomorphized funcs per module
  for mni in 0..mod_names.size
    var def_names = vec_new<String>()
    var mono_names = vec_new<String>()
    var idxs = mod_func_indices[mni]
    var fi = 0
    while fi < vec_size(idxs)
      var func_idx = vec_get(idxs, fi)
      var func = funcs[func_idx]
      var fname = func.mir_func_get_name()
      var emit_name = fname
      if fname == "main"
        emit_name = "qz_main"
      else
        emit_name = codegen_util::cg_sanitize_llvm_name(fname)
      end
      def_names.push(emit_name)
      if codegen_util::cg_is_monomorphized(fname)
        mono_names.push(emit_name)
      end
      fi += 1
    end
    all_defined.push(def_names)
    all_mono.push(mono_names)
  end

  # Phase 3: Emit each module's .ll file
  # When the build cache is disabled (`--no-cache`), `cache_get_dir()` returns
  # the empty string. Writing fragments to "#{cache_dir}/sep/..." would then
  # produce the absolute, unwritable path "/sep/<mod>.ll"; the failed open
  # yields a NULL FILE* and a later flockfile segfaults. Fall back to a
  # CWD-relative dir so `--separate --no-cache` writes to a writable location.
  # CWD-relative (rather than an absolute /tmp path) keeps the emitted
  # manifest paths relative — callers that `cd` into a working directory get
  # fully isolated fragment output, with no cross-invocation collisions.
  var sep_root = cache_dir
  if str_byte_len(sep_root) == 0
    sep_root = ".quartz-sep"
  end
  # Ensure output directory exists
  var _mkdir1 = mkdir(sep_root)
  var _mkdir2 = mkdir("#{sep_root}/sep")

  var manifest = sb_new()
  defer sb_free(manifest)

  for mod_i in 0..mod_names.size
    var mod_name = mod_names[mod_i]
    var is_main_mod = mod_name == main_mod
    state.current_module = mod_name

    # Reset per-module state: each .ll file has independent namespaces
    state.string_pool = vec_new<String>()
    state.string_count = 0
    state.label_counter = 0
    state.loop_metadata_ids = vec_new()
    state.metadata_counter = 0
    state.overflow_label_counter = 0

    var out = sb_new()

    # --- Preamble ---
    codegen_util::cg_emit(out, "; Generated by Quartz self-hosted compiler (separate: ")
    codegen_util::cg_emit(out, mod_name)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit_line(out, "")

    # Target info
    codegen_runtime::cg_emit_target_info(out, target)

    # Struct type definitions (same for all modules)
    codegen_runtime::cg_emit_struct_types(out, prog)

    # Runtime globals: define in main module, declare external elsewhere
    if is_main_mod == 1
      codegen_runtime::cg_emit_runtime_globals_define(out)
    else
      codegen_runtime::cg_emit_runtime_globals_declare(out)
    end

    # Runtime helper functions (linkonce_odr) — includes declares, format strings,
    # and all function definitions. Post-processed from monolithic cg_emit_runtime_decls.
    # Format strings are included (converted from private to linkonce_odr).
    # Pass uses_scheduler=1 unconditionally to match the effect runtime below,
    # which conservatively emits the default Async handler's `__qz_sched_init` /
    # `__qz_sched_spawn` call sites regardless of per-module scheduler use
    # (some other module in the link unit might use `go`). Linker dedupes the
    # linkonce_odr definitions.
    codegen_runtime::cg_emit_runtime_helpers_linkonce(out, target, tg_flag, 1, prog.mir_get_uses_scope_deadline())

    # Helper functions (str_hash, overflow_panic, bounds_panic, backtrace) — linkonce_odr
    codegen_runtime::cg_emit_str_hash_helper(out, 1)
    if codegen_runtime::cg_is_freestanding(target) == 1
      codegen_runtime::cg_emit_freestanding_panic_stubs(out, 1)
    else
      if overflow_check == 1
        codegen_runtime::cg_emit_overflow_panic_helper(out, 1)
      end
      if exclusivity_check == 1
        codegen_runtime::cg_emit_access_head_tls(out, target, 1)
        codegen_runtime::cg_emit_exclusivity_panic_helper(out, 1)
      end
      codegen_runtime::cg_emit_bounds_panic_helper(out, 1)
      codegen_runtime::cg_emit_map_key_panic_helper(out, 1)
      codegen_runtime::cg_emit_async_lock_drain_panic_helper(out, 1)
      codegen_runtime::cg_emit_backtrace_helper(out, 1, target)
      # Effect-dispatch runtime (Milestone D.1). Hosted only.
      # linkonce path (per-module fragment) conservatively assumes scheduler
      # may be used by some other module in the link unit — emit full body.
      # uses_intern is read from the SAME prog across all fragments, so the
      # emitted install_defaults body is byte-identical across modules
      # (linkonce_odr ODR satisfied).
      codegen_runtime::cg_emit_effect_runtime(out, 1, 1, prog.mir_get_uses_intern(), prog.mir_get_uses_cache(), prog.mir_get_uses_profile(), prog.mir_get_uses_yield())
    end

    # --- Global variables ---
    # This module's globals: define. Other modules' globals: declare external.
    _cg_emit_globals_for_module(out, prog, mod_name)

    # Const declarations for this module
    _cg_emit_consts_for_module(out, prog, mod_name)

    # --- Cross-module function declarations ---
    _cg_emit_cross_module_declares(out, state, prog, funcs, mod_i, mod_names, mod_func_indices, all_defined)

    # --- This module's functions ---
    var idxs = mod_func_indices[mod_i]
    var has_original_init = 0
    var fi = 0
    while fi < vec_size(idxs)
      var func_idx = vec_get(idxs, fi)
      var func = funcs[func_idx]
      var fname = func.mir_func_get_name()

      # MIR-synthesized __qz_module_init: emit it renamed to __qz_original_module_init
      # so it doesn't conflict with our orchestrator. It contains complex computed
      # global inits (vec_new, etc.) that per-module string inits don't cover.
      if fname == "__qz_module_init"
        if is_main_mod == 1
          # Ambient Emit install — fresh-local sb + method-call inside body.
          var init_ir = ""
          codegen_ctx::cg_ctx_set(out)
          with Emit {
            emit: codegen_ctx::cg_ctx_emit_handler,
            emit_line: codegen_ctx::cg_ctx_emit_line_handler,
            emit_int: codegen_ctx::cg_ctx_emit_int_handler
          } do ->
            var init_buf = sb_new()
            codegen::cg_emit_function(state, init_buf, prog, func, func_idx)
            init_ir = init_buf.to_string()
            sb_free(init_buf)
          end
          # Rename: @__qz_module_init → @__qz_original_module_init
          init_ir = str_replace(init_ir, "@__qz_module_init", "@__qz_original_module_init")
          sb_append(out, init_ir)
          has_original_init = 1
        end
        fi += 1
        continue
      end

      # Determine linkage prefix
      var is_mono = codegen_util::cg_is_monomorphized(fname)
      var is_private = codegen_util::cg_is_private_func(fname)

      # Ambient Emit install for the per-fn dispatch.
      codegen_ctx::cg_ctx_set(out)
      with Emit {
        emit: codegen_ctx::cg_ctx_emit_handler,
        emit_line: codegen_ctx::cg_ctx_emit_line_handler,
        emit_int: codegen_ctx::cg_ctx_emit_int_handler
      } do ->
        if is_mono == 1
          # Monomorphized generic: linkonce_odr for linker dedup
          _cg_emit_function_with_linkage(state, out, prog, func, func_idx, "linkonce_odr")
        elsif is_private == 1
          # Private function: internal linkage
          _cg_emit_function_with_linkage(state, out, prog, func, func_idx, "internal")
        else
          # Normal function: default linkage
          codegen::cg_emit_function(state, out, prog, func, func_idx)
        end
      end
      fi += 1
    end

    # --- Per-module init function ---
    _cg_emit_per_module_init(state, out, prog, mod_name)

    # --- Main module extras ---
    if is_main_mod == 1
      # Emit per-struct hash/eq functions and custom-key map runtime
      codegen_runtime::cg_emit_struct_hash_eq_functions(out, prog)
      codegen_runtime::cg_emit_custom_map_functions(out)

      # Emit orchestrator __qz_module_init that calls per-module inits in topo order
      _cg_emit_module_init_calls(out, mod_names, topo_order, has_original_init)

      # Main wrapper (@main)
      if codegen_runtime::cg_is_freestanding(target) == 0
        codegen_util::cg_emit_line(out, "")
        codegen_util::cg_emit_line(out, "; Main entry point wrapper")
        if codegen_runtime::cg_is_wasi(target)
          codegen_util::cg_emit_line(out, "define void @_start() {")
          codegen_util::cg_emit_line(out, "  %result = call i64 @qz_main()")
          codegen_util::cg_emit_line(out, "  ret void")
          codegen_util::cg_emit_line(out, "}")
        else
          codegen_util::cg_emit_line(out, "define i32 @main(i32 %argc, ptr %argv) {")
          codegen_util::cg_emit_line(out, "  %argc64 = sext i32 %argc to i64")
          codegen_util::cg_emit_line(out, "  store i64 %argc64, ptr @qz_argc")
          codegen_util::cg_emit_line(out, "  store ptr %argv, ptr @qz_argv")
          codegen_util::cg_emit_line(out, "  %result = call i64 @qz_main()")
          if sched_flag == 1
            codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_signal_shutdown")
            codegen_util::cg_emit_line(out, "  %ms.init.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 10")
            codegen_util::cg_emit_line(out, "  %ms.init = load i64, ptr %ms.init.p")
            codegen_util::cg_emit_line(out, "  %ms.was_init = icmp ne i64 %ms.init, 0")
            codegen_util::cg_emit_line(out, "  br i1 %ms.was_init, label %ms_shutdown, label %ms_done")
            codegen_util::cg_emit_line(out, "ms_shutdown:")
            codegen_util::cg_emit_line(out, "  call i64 @__qz_sched_shutdown_graceful(i64 50)")
            codegen_util::cg_emit_line(out, "  call void @__qz_sched_shutdown()")
            codegen_util::cg_emit_line(out, "  br label %ms_done")
            codegen_util::cg_emit_line(out, "ms_done:")
          end
          codegen_util::cg_emit_line(out, "  %result32 = trunc i64 %result to i32")
          codegen_util::cg_emit_line(out, "  ret i32 %result32")
          codegen_util::cg_emit_line(out, "}")
        end
      end

    end

    # --- String constants (standard @.str.N naming, unique per file) ---
    codegen_util::cg_emit_string_constants(state, out)

    # --- Loop metadata ---
    codegen_util::cg_emit_loop_metadata(state, out)

    # Write .ll file
    var ll_path = "#{sep_root}/sep/#{mod_name}.ll"
    var ir_text = out.to_string()
    sb_free(out)
    var _w = fio_write(ll_path, ir_text)

    sb_append(manifest, ll_path)
    sb_append(manifest, "\n")

  end

  return manifest.to_string()
end

## Emit a function with a specific linkage type (linkonce_odr, internal, etc.)
## Wraps cg_emit_function by post-processing the `define` keyword.
def _cg_emit_function_with_linkage(state: CodegenState, out: Int, prog: MirProgram, func: MirFunc, func_idx: Int, linkage: String): Void can Emit
  # Emit into a temp buffer, then replace `define ` with `define <linkage> `
  var buf = sb_new()
  # P5.3.d.2: route cg_ctx to the temp buffer so any migrated leaf's
  # bare `emit(...)` reaches `buf` (not the outer `out`). Restore on
  # return so the caller's wrap continues sinking to its own target.
  var saved_ctx = codegen_ctx::cg_ctx_get()
  codegen_ctx::cg_ctx_set(buf)
  codegen::cg_emit_function(state, buf, prog, func, func_idx)
  codegen_ctx::cg_ctx_set(saved_ctx)
  var ir = buf.to_string()
  sb_free(buf)
  # Replace first occurrence of "define " with "define <linkage> "
  var prefix = "define "
  var replacement = "define #{linkage} "
  var idx = __str_index(ir, prefix)
  if idx >= 0
    var before = str_byte_slice(ir, 0, idx)
    var after = str_byte_slice(ir, "#{idx}#{str_byte_len(prefix)}", str_byte_len(ir))
    sb_append(out, before)
    sb_append(out, replacement)
    sb_append(out, after)
  else
    sb_append(out, ir)
  end
end

## Emit global variable definitions for globals owned by this module,
## and external declarations for globals owned by other modules.
def _cg_emit_globals_for_module(out: Int, prog: MirProgram, mod_name: String): Void
  var names = prog.mir_get_global_names()
  var inits = prog.mir_get_global_inits()
  var tl_flags = prog.mir_get_global_thread_locals()
  var count = names.size

  if count == 0
    return
  end

  codegen_util::cg_emit_line(out, "; Global Variables")

  for i in 0..count
    var name = names[i]
    # Extract module from global name: "lexer$_state" → "lexer"
    var dollar = __char_index(name, '$')
    var g_mod = "__main__"
    if dollar > 0
      g_mod = str_byte_slice(name, 0, dollar)
    end

    if g_mod == mod_name
      # This module owns this global — define it
      codegen_util::cg_emit(out, "@global_")
      codegen_util::cg_emit(out, name)
      if tl_flags[i] == 1
        codegen_util::cg_emit(out, " = thread_local global i64 ")
      else
        codegen_util::cg_emit(out, " = global i64 ")
      end
      codegen_util::cg_emit_line(out, inits[i].to_s())
    else
      # Other module's global — declare external
      codegen_util::cg_emit(out, "@global_")
      codegen_util::cg_emit(out, name)
      if tl_flags[i] == 1
        codegen_util::cg_emit_line(out, " = external thread_local global i64")
      else
        codegen_util::cg_emit_line(out, " = external global i64")
      end
    end
  end
  codegen_util::cg_emit_line(out, "")
end

## Emit const declarations for constants owned by this module,
## and external declarations for constants from other modules.
def _cg_emit_consts_for_module(out: Int, prog: MirProgram, mod_name: String): Void
  var names = prog.mir_get_const_names()
  var values = prog.mir_get_const_values()
  var count = names.size

  if count == 0
    return
  end

  codegen_util::cg_emit_line(out, "; Constants")

  for i in 0..count
    var name = names[i]
    var dollar = __char_index(name, '$')
    var c_mod = "__main__"
    if dollar > 0
      c_mod = str_byte_slice(name, 0, dollar)
    end

    if c_mod == mod_name
      codegen_util::cg_emit(out, "@const_")
      codegen_util::cg_emit(out, name)
      codegen_util::cg_emit(out, " = constant i64 ")
      codegen_util::cg_emit_line(out, values[i].to_s())
    else
      codegen_util::cg_emit(out, "@const_")
      codegen_util::cg_emit(out, name)
      codegen_util::cg_emit_line(out, " = external constant i64")
    end
  end
  codegen_util::cg_emit_line(out, "")
end

## Emit cross-module function declarations for a specific module.
## Declares ALL functions from OTHER modules (unused declares are harmless in LLVM IR).
## This avoids the need for callee tracking.
def _cg_emit_cross_module_declares(out: Int, state: CodegenState, prog: MirProgram, funcs: Vec<mir::MirFunc>, mod_idx: Int, mod_names: Vec<String>, mod_func_indices: Vec, all_defined: Vec): Void
  # Collect all function names defined in this module
  var my_defs = all_defined[mod_idx]
  var my_def_count = vec_size(my_defs)

  var has_header = 0
  # Iterate over all other modules and declare their functions
  for omi in 0..mod_names.size
    if omi != mod_idx
      var other_idxs = mod_func_indices[omi]
      var ofi = 0
      while ofi < vec_size(other_idxs)
        var func_idx = vec_get(other_idxs, ofi)
        var func = funcs[func_idx]
        var fname = func.mir_func_get_name()

        # Skip __qz_module_init (handled separately)
        if fname == "__qz_module_init"
          ofi += 1
          continue
        end

        # Skip private functions (internal linkage, not visible)
        if codegen_util::cg_is_private_func(fname)
          ofi += 1
          continue
        end

        if has_header == 0
          codegen_util::cg_emit_line(out, "; Cross-module function declarations")
          has_header = 1
        end

        _cg_emit_func_declare(out, state, prog, func)
        ofi += 1
      end
    end
  end

  if has_header == 1
    codegen_util::cg_emit_line(out, "")
  end
end

## Emit a single function declaration for cross-module use.
def _cg_emit_func_declare(out: Int, state: CodegenState, prog: MirProgram, func: MirFunc): Void
  var fname = func.mir_func_get_name()
  var emit_name = fname
  if fname == "main"
    emit_name = "qz_main"
  else
    emit_name = codegen_util::cg_sanitize_llvm_name(fname)
  end

  var pc = func.mir_func_get_params().size
  var rtn = func.mir_func_get_return_type_name()
  var ret_type = "i64"
  if rtn.mir_is_narrow_fixed_width()
    ret_type = rtn.mir_type_name_to_llvm()
  end

  codegen_util::cg_emit(out, "declare ")
  codegen_util::cg_emit(out, ret_type)
  codegen_util::cg_emit(out, " @")
  codegen_util::cg_emit(out, emit_name)
  codegen_util::cg_emit(out, "(")

  var should_decompose = codegen::cg_func_should_decompose(state, func, prog)
  var comma = 0
  for pi in 0..pc
    var ptn = func.mir_func_get_param_type_name(pi)
    if should_decompose == 1 and func.mir_func_param_is_decomposed(prog, pi)
      var fc = prog.mir_prog_get_struct_field_count(ptn)
      var ffi = 0
      while ffi < fc
        if comma == 1
          codegen_util::cg_emit(out, ", ")
        end
        codegen_util::cg_emit(out, "i64")
        comma = 1
        ffi += 1
      end
    else
      if comma == 1
        codegen_util::cg_emit(out, ", ")
      end
      if ptn.mir_is_narrow_fixed_width()
        codegen_util::cg_emit(out, ptn.mir_type_name_to_llvm())
      else
        codegen_util::cg_emit(out, "i64")
      end
      comma = 1
    end
  end
  codegen_util::cg_emit_line(out, ")")
end

## Find a MIR function by its sanitized name. Returns the function handle or -1.
def _cg_find_mir_func(prog: MirProgram, sanitized_name: String): Int
  var funcs = prog.mir_get_functions()
  var count = funcs.size
  for i in 0..count
    var f = funcs[i]
    var fname = f.mir_func_get_name()
    var ename = fname
    if fname == "main"
      ename = "qz_main"
    else
      ename = codegen_util::cg_sanitize_llvm_name(fname)
    end
    if ename == sanitized_name
      return f
    end
  end
  return -1
end

## Emit per-module init function with init-once guard.
def _cg_emit_per_module_init(state: CodegenState, out: Int, prog: MirProgram, mod_name: String): Void
  var safe_name = codegen_util::cg_sanitize_llvm_name(mod_name)

  codegen_util::cg_emit_line(out, "")
  # Init-once flag
  codegen_util::cg_emit(out, "@__qz_inited_")
  codegen_util::cg_emit(out, safe_name)
  codegen_util::cg_emit_line(out, " = internal global i1 false")
  codegen_util::cg_emit(out, "define void @__qz_module_init_")
  codegen_util::cg_emit(out, safe_name)
  codegen_util::cg_emit_line(out, "() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit(out, "  %done = load i1, i1* @__qz_inited_")
  codegen_util::cg_emit_line(out, safe_name)
  codegen_util::cg_emit_line(out, "  br i1 %done, label %skip, label %init")
  codegen_util::cg_emit_line(out, "init:")
  codegen_util::cg_emit(out, "  store i1 true, i1* @__qz_inited_")
  codegen_util::cg_emit_line(out, safe_name)

  # Initialize globals owned by this module that need string init
  # Uses the global string pool (@.str.N) since each .ll file is independent
  var names = prog.mir_get_global_names()
  var str_inits = prog.mir_get_global_str_inits()
  var gcount = names.size
  var reg_idx = 0
  for gi in 0..gcount
    if str_byte_len(str_inits[gi]) > 0
      var gname = names[gi]
      var dollar = __char_index(gname, '$')
      var g_mod = "__main__"
      if dollar > 0
        g_mod = str_byte_slice(gname, 0, dollar)
      end
      if g_mod == mod_name
        var str_val = str_inits[gi]
        var str_idx = codegen_util::cg_add_string(state, str_val)
        var slen = str_byte_len(str_val) + 1
        # GEP to get past length prefix
        codegen_util::cg_emit(out, "  %ginit_")
        codegen_util::cg_emit_int(out, reg_idx)
        codegen_util::cg_emit(out, ".ptr = getelementptr <{ i64, [")
        codegen_util::cg_emit_int(out, slen)
        codegen_util::cg_emit(out, " x i8] }>, <{ i64, [")
        codegen_util::cg_emit_int(out, slen)
        codegen_util::cg_emit(out, " x i8] }>* @.str.")
        codegen_util::cg_emit_int(out, str_idx)
        codegen_util::cg_emit_line(out, ", i64 0, i32 1, i64 0")
        # ptrtoint
        codegen_util::cg_emit(out, "  %ginit_")
        codegen_util::cg_emit_int(out, reg_idx)
        codegen_util::cg_emit(out, " = ptrtoint ptr %ginit_")
        codegen_util::cg_emit_int(out, reg_idx)
        codegen_util::cg_emit_line(out, ".ptr to i64")
        # store
        codegen_util::cg_emit(out, "  store i64 %ginit_")
        codegen_util::cg_emit_int(out, reg_idx)
        codegen_util::cg_emit(out, ", ptr @global_")
        codegen_util::cg_emit_line(out, gname)
        reg_idx += 1
      end
    end
  end

  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
end

## Emit calls to all per-module init functions in topological order.
## This is injected into the __main__ module's preamble as declares +
## a helper function that qz_main calls.
def _cg_emit_module_init_calls(out: Int, mod_names: Vec<String>, topo_order: Vec<String>, has_original_init: Int): Void
  # Declare all per-module init functions
  codegen_util::cg_emit_line(out, "; Per-module init declarations")
  for mi in 0..mod_names.size
    var mod_name = mod_names[mi]
    if mod_name != "__main__"
      var safe = codegen_util::cg_sanitize_llvm_name(mod_name)
      codegen_util::cg_emit(out, "declare void @__qz_module_init_")
      codegen_util::cg_emit(out, safe)
      codegen_util::cg_emit_line(out, "()")
    end
  end
  codegen_util::cg_emit_line(out, "")

  # Emit __qz_module_init orchestrator that:
  # 1. Calls per-module init functions in topo order (string-init globals)
  # 2. Calls __qz_original_module_init for complex computed inits
  codegen_util::cg_emit_line(out, "define i64 @__qz_module_init() nounwind {")
  codegen_util::cg_emit_line(out, "entry_init:")
  # First call per-module inits from topo_order (imported modules)
  for ti in 0..topo_order.size
    var tmod = topo_order[ti]
    # Check this module is actually in our module set
    var found = 0
    var tmi = 0
    while tmi < mod_names.size
      if mod_names[tmi].eq(tmod)
        found = 1
        break
      end
      tmi += 1
    end
    if found == 1 and tmod != "__main__"
      var safe = codegen_util::cg_sanitize_llvm_name(tmod)
      codegen_util::cg_emit(out, "  call void @__qz_module_init_")
      codegen_util::cg_emit(out, safe)
      codegen_util::cg_emit_line(out, "()")
    end
  end
  # Call __main__'s per-module init (string-init globals)
  var main_safe = codegen_util::cg_sanitize_llvm_name("__main__")
  codegen_util::cg_emit(out, "  call void @__qz_module_init_")
  codegen_util::cg_emit(out, main_safe)
  codegen_util::cg_emit_line(out, "()")
  # Call the renamed MIR-synthesized init for complex computed globals (if it exists)
  if has_original_init == 1
    codegen_util::cg_emit_line(out, "  %_orig_init = call i64 @__qz_original_module_init()")
  end
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
end
