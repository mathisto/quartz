##! # C Backend Code Generator
##!
##! Emits C code from the MIR representation. Parallel to codegen.qz (LLVM IR)
##! but targeting C as the output language. Everything is int64_t at runtime,
##! matching Quartz's existential type model.
##!
##! Handles: 24 MIR instruction kinds (NOP, CONST_INT..UNION_WRAP incl.
##!   ADDR_OF/CONST_FLOAT) and 19 intrinsics (I/O, memory, string, math, time,
##!   process control). Terminators: RETURN, JUMP, BRANCH, UNREACHABLE.
##!   Unhandled MIR kinds and intrinsics `panic(...)` at codegen time rather
##!   than silently emitting `0` (R4.1: loud unimplemented-path errors).
##!
##! @see codegen LLVM IR code generator
##! @since 5.26.0

import mir
import op_constants

# ============================================================================
# Module-level C string pool
# ============================================================================

var g_c_string_pool = vec_new<String>()
var g_c_string_count = 0

## Reset the C string pool for a new compilation.
def cg_c_reset_pool(): Void
  g_c_string_pool = vec_new<String>()
  g_c_string_count = 0
end

## Add a string to the pool. Returns existing index if already present.
def cg_c_add_string(val: String): Int
  for i in 0..g_c_string_count
    if g_c_string_pool[i] == val
      return i
    end
  end
  g_c_string_pool.push(val)
  var idx = g_c_string_count
  g_c_string_count = g_c_string_count + 1
  return idx
end

## Pre-scan all MIR functions to collect string constants into the pool.
def cg_c_prescan_strings(prog: mir::MirProgram): Void
  var funcs = mir::mir_get_functions(prog)
  for fi in 0..funcs.size
    var func = funcs[fi]
    var blocks = mir::mir_func_get_blocks(func)
    for bi in 0..blocks.size
      var blk = blocks[bi]
      var instrs = mir::mir_block_get_instructions(blk)
      for ii in 0..instrs.size
        var instr = instrs[ii]
        var kind = mir::mir_instr_get_kind(instr)
        if kind == 3  # MIR_CONST_STRING
          var str_val = mir::mir_instr_get_string_val(instr)
          cg_c_add_string(str_val)
        end
      end
    end
  end
end

## Emit the collected string pool as length-prefixed C structs.
def cg_c_emit_string_pool(out: Int): Void
  if g_c_string_count > 0
    cg_c_line(out, "/* String constants (length-prefixed) */")
    for i in 0..g_c_string_count
      var s = g_c_string_pool[i]
      var slen = str_byte_len(s)
      var data_sz = (slen + 1).to_s()
      var escaped = cg_c_escape_string(s)
      var idx = i.to_s()
      cg_c_line(out, "static const struct { int64_t len; char data[#{data_sz}]; } _qstr_#{idx} = { #{slen}, \"#{escaped}\" };")
      cg_c_line(out, "#define STR_#{idx} ((qz_val)(intptr_t)&_qstr_#{idx}.data[0])")
    end
    cg_c_line(out, "")
  end
end

# ============================================================================
# Name Sanitization
# ============================================================================

## Sanitize a Quartz function name for C: replace '$' with '__'
def cg_c_sanitize_name(name: String): String
  var result = sb_new()
  for i in 0..str_byte_len(name)
    var ch = str_byte_at(name, i)
    if ch == '$'
      sb_append(result, "__")
    else
      sb_append_char(result, ch)
    end
  end
  return sb_to_string(result)
end

# ============================================================================
# C Code Emission Helpers
# ============================================================================

## Emit a line to the output string builder
def cg_c_line(out: Int, line: String): Void
  sb_append(out, line)
  sb_append(out, "\n")
end

## Format a virtual register reference
def cg_c_reg(id: Int): String = "v#{id.to_s()}"

## Format a block label
def cg_c_label(label: String): String = "L_#{label}"

# ============================================================================
# Header and Preamble
# ============================================================================

## Emit C file header with includes and type definitions
def cg_c_emit_header(out: Int): Void
  cg_c_line(out, "/* Generated by Quartz C backend */")
  cg_c_line(out, "#include \"quartz_runtime.h\"")
  cg_c_line(out, "")
end

# ============================================================================
# String Constants
# ============================================================================

## Escape a string for C string literal embedding
def cg_c_escape_string(s: String): String
  var sb = sb_new()
  for j in 0..str_byte_len(s)
    var ch = str_byte_at(s, j)
    if ch == '\n'
      sb_append(sb, "\\n")
    elsif ch == '\r'
      sb_append(sb, "\\r")
    elsif ch == '\t'
      sb_append(sb, "\\t")
    elsif ch == '"'
      sb_append(sb, "\\\"")
    elsif ch == '\\'
      sb_append(sb, "\\\\")
    elsif ch == 0
      sb_append(sb, "\\0")
    else
      sb_append_char(sb, ch)
    end
  end
  return sb_to_string(sb)
end

## Emit length-prefixed string constant declarations.
## Layout: { int64_t len; char data[len+1]; }
## The qz_val points to &data[0], matching LLVM backend.
def cg_c_emit_string_constants(out: Int, prog: mir::MirProgram): Void
  var pool = mir::mir_get_string_pool(prog)
  if pool.size > 0
    cg_c_line(out, "/* String constants (length-prefixed) */")
    for i in 0..pool.size
      var s = pool[i]
      var slen = str_byte_len(s)
      var data_sz = (slen + 1).to_s()
      var escaped = cg_c_escape_string(s)
      var idx = i.to_s()
      cg_c_line(out, "static const struct { int64_t len; char data[#{data_sz}]; } _qstr_#{idx} = { #{slen}, \"#{escaped}\" };")
      cg_c_line(out, "#define STR_#{idx} ((qz_val)(intptr_t)&_qstr_#{idx}.data[0])")
    end
    cg_c_line(out, "")
  end
end

# ============================================================================
# Global Variables
# ============================================================================

## Emit global variable declarations
def cg_c_emit_globals(out: Int, prog: mir::MirProgram): Void
  var names = mir::mir_get_global_names(prog)
  var inits = mir::mir_get_global_inits(prog)
  if names.size > 0
    cg_c_line(out, "/* Global variables */")
    for i in 0..names.size
      var name = cg_c_sanitize_name(names[i])
      var init_val = inits[i]
      cg_c_line(out, "qz_val #{name} = #{init_val};")
    end
    cg_c_line(out, "")
  end
end

# ============================================================================
# Forward Declarations
# ============================================================================

## Emit forward declarations for all functions
def cg_c_emit_forward_decls(out: Int, prog: mir::MirProgram): Void
  var funcs = mir::mir_get_functions(prog)
  cg_c_line(out, "/* Forward declarations */")
  for i in 0..funcs.size
    var func = funcs[i]
    var name = mir::mir_func_get_name(func)
    var c_name = ""
    if name == "main"
      c_name = "qz_main"
    else
      c_name = cg_c_sanitize_name(name)
    end
    var ret_type = mir::mir_func_get_return_type(func)
    var params = mir::mir_func_get_params(func)

    var sb = sb_new()
    # Return type
    if ret_type == 3
      sb_append(sb, "void ")
    else
      sb_append(sb, "qz_val ")
    end
    sb_append(sb, c_name)
    sb_append(sb, "(")
    for pi in 0..params.size
      if pi > 0
        sb_append(sb, ", ")
      end
      sb_append(sb, "qz_val ")
      sb_append(sb, cg_c_sanitize_name(params[pi]))
    end
    sb_append(sb, ");")
    cg_c_line(out, sb_to_string(sb))
  end
  cg_c_line(out, "")
end

# ============================================================================
# Binary Operation Emission
# ============================================================================

## Emit a C binary operation
def cg_c_emit_binary(out: Int, dest: String, op: Int, left: String, right: String): Void
  var sb = sb_new()
  sb_append(sb, "  qz_val ")
  sb_append(sb, dest)
  sb_append(sb, " = ")
  if op == op_constants::OP_ADD
    sb_append(sb, "#{left} + #{right}")
  elsif op == op_constants::OP_SUB
    sb_append(sb, "#{left} - #{right}")
  elsif op == op_constants::OP_MUL
    sb_append(sb, "#{left} * #{right}")
  elsif op == op_constants::OP_DIV
    sb_append(sb, "#{left} / #{right}")
  elsif op == op_constants::OP_MOD
    sb_append(sb, "#{left} % #{right}")
  elsif op == op_constants::OP_EQ
    sb_append(sb, "(#{left} == #{right})")
  elsif op == op_constants::OP_NE
    sb_append(sb, "(#{left} != #{right})")
  elsif op == op_constants::OP_LT
    sb_append(sb, "(#{left} < #{right})")
  elsif op == op_constants::OP_LE
    sb_append(sb, "(#{left} <= #{right})")
  elsif op == op_constants::OP_GT
    sb_append(sb, "(#{left} > #{right})")
  elsif op == op_constants::OP_GE
    sb_append(sb, "(#{left} >= #{right})")
  elsif op == op_constants::OP_BIT_AND
    sb_append(sb, "#{left} & #{right}")
  elsif op == op_constants::OP_BIT_OR
    sb_append(sb, "#{left} | #{right}")
  elsif op == op_constants::OP_BIT_XOR
    sb_append(sb, "#{left} ^ #{right}")
  elsif op == op_constants::OP_SHL
    sb_append(sb, "#{left} << #{right}")
  elsif op == op_constants::OP_SHR
    sb_append(sb, "#{left} >> #{right}")
  else
    panic("C backend: binary op #{op} not implemented (R4.1: unimplemented backend path)")
  end
  sb_append(sb, ";")
  cg_c_line(out, sb_to_string(sb))
end

# ============================================================================
# Instruction Emission
# ============================================================================

## Emit a single MIR instruction as C code
def cg_c_emit_instr(out: Int, prog: mir::MirProgram, instr: mir::MirInstr): Void
  var kind = mir::mir_instr_get_kind(instr)
  var dest = mir::mir_instr_get_dest_id(instr)
  var d = cg_c_reg(dest)

  # MIR_CONST_INT = 1
  if kind == 1
    var val = mir::mir_instr_get_int_val(instr)
    cg_c_line(out, "  qz_val #{d} = #{val};")
    return
  end

  # MIR_CONST_BOOL = 2
  if kind == 2
    var val = mir::mir_instr_get_int_val(instr)
    cg_c_line(out, "  qz_val #{d} = #{val};")
    return
  end

  # MIR_CONST_STRING = 3
  if kind == 3
    var str_val = mir::mir_instr_get_string_val(instr)
    var str_idx = cg_c_add_string(str_val)
    cg_c_line(out, "  qz_val #{d} = STR_#{str_idx};")
    return
  end

  # MIR_LOAD_VAR = 4
  if kind == 4
    var var_name = mir::mir_instr_get_var_name(instr)
    cg_c_line(out, "  qz_val #{d} = #{cg_c_sanitize_name(var_name)};")
    return
  end

  # MIR_STORE_VAR = 5
  if kind == 5
    var var_name = mir::mir_instr_get_var_name(instr)
    var src = mir::mir_instr_get_operand1(instr)
    cg_c_line(out, "  #{cg_c_sanitize_name(var_name)} = #{cg_c_reg(src)};")
    return
  end

  # MIR_BINARY = 6
  if kind == 6
    var op = mir::mir_instr_get_op(instr)
    var left = mir::mir_instr_get_operand1(instr)
    var right = mir::mir_instr_get_operand2(instr)
    cg_c_emit_binary(out, d, op, cg_c_reg(left), cg_c_reg(right))
    return
  end

  # MIR_UNARY = 7
  if kind == 7
    var op = mir::mir_instr_get_op(instr)
    var operand = mir::mir_instr_get_operand1(instr)
    if op == op_constants::OP_SUB
      cg_c_line(out, "  qz_val #{d} = -#{cg_c_reg(operand)};")
    elsif op == op_constants::OP_NOT
      cg_c_line(out, "  qz_val #{d} = !#{cg_c_reg(operand)};")
    elsif op == op_constants::OP_BIT_XOR
      cg_c_line(out, "  qz_val #{d} = ~#{cg_c_reg(operand)};")
    else
      cg_c_line(out, "  qz_val #{d} = #{cg_c_reg(operand)}; /* unary op #{op} */")
    end
    return
  end

  # MIR_CALL = 8
  if kind == 8
    var func_name = mir::mir_instr_get_func_name(instr)
    var args = mir::mir_instr_get_args(instr)
    var sb = sb_new()
    sb_append(sb, "  qz_val ")
    sb_append(sb, d)
    sb_append(sb, " = ")
    sb_append(sb, cg_c_sanitize_name(func_name))
    sb_append(sb, "(")
    for ai in 0..args.size
      if ai > 0
        sb_append(sb, ", ")
      end
      sb_append(sb, cg_c_reg(args[ai]))
    end
    sb_append(sb, ");")
    cg_c_line(out, sb_to_string(sb))
    return
  end

  # MIR_INTRINSIC = 9
  if kind == 9
    cg_c_emit_intrinsic(out, d, instr)
    return
  end

  # MIR_FUNC_REF = 10 — function pointer
  if kind == 10
    var func_name = mir::mir_instr_get_func_name(instr)
    cg_c_line(out, "  qz_val #{d} = (qz_val)(intptr_t)&#{cg_c_sanitize_name(func_name)};")
    return
  end

  # MIR_CALL_INDIRECT = 11 — call through function pointer
  if kind == 11
    var callee = mir::mir_instr_get_operand1(instr)
    var args = mir::mir_instr_get_args(instr)
    var sb = sb_new()
    sb_append(sb, "  qz_val ")
    sb_append(sb, d)
    sb_append(sb, " = ((qz_val(*)(")
    for ai in 0..args.size
      if ai > 0
        sb_append(sb, ", ")
      end
      sb_append(sb, "qz_val")
    end
    if args.size == 0
      sb_append(sb, "void")
    end
    sb_append(sb, "))(intptr_t)")
    sb_append(sb, cg_c_reg(callee))
    sb_append(sb, ")(")
    for ai in 0..args.size
      if ai > 0
        sb_append(sb, ", ")
      end
      sb_append(sb, cg_c_reg(args[ai]))
    end
    sb_append(sb, ");")
    cg_c_line(out, sb_to_string(sb))
    return
  end

  # MIR_ALLOC = 12 — heap allocation (struct/array)
  if kind == 12
    var size = mir::mir_instr_get_int_val(instr)
    cg_c_line(out, "  qz_val #{d} = (qz_val)(intptr_t)calloc(#{size}, sizeof(qz_val));")
    return
  end

  # MIR_LOAD = 13 — load from pointer
  if kind == 13
    var ptr = mir::mir_instr_get_operand1(instr)
    cg_c_line(out, "  qz_val #{d} = *((qz_val*)(intptr_t)#{cg_c_reg(ptr)});")
    return
  end

  # MIR_STORE = 14 — store to pointer
  if kind == 14
    var ptr = mir::mir_instr_get_operand1(instr)
    var val = mir::mir_instr_get_operand2(instr)
    cg_c_line(out, "  *((qz_val*)(intptr_t)#{cg_c_reg(ptr)}) = #{cg_c_reg(val)};")
    return
  end

  # MIR_FIELD_ACCESS = 15 — struct field load: ptr[index]
  if kind == 15
    var ptr = mir::mir_instr_get_operand1(instr)
    var idx = mir::mir_instr_get_slot1(instr)
    cg_c_line(out, "  qz_val #{d} = ((qz_val*)(intptr_t)#{cg_c_reg(ptr)})[#{idx}];")
    return
  end

  # MIR_INDEX = 16 — dynamic index load: ptr[idx]
  if kind == 16
    var ptr = mir::mir_instr_get_operand1(instr)
    var idx = mir::mir_instr_get_operand2(instr)
    cg_c_line(out, "  qz_val #{d} = ((qz_val*)(intptr_t)#{cg_c_reg(ptr)})[#{cg_c_reg(idx)}];")
    return
  end

  # MIR_INDEX_STORE = 17 — dynamic index store: ptr[idx] = val
  if kind == 17
    var ptr = mir::mir_instr_get_operand1(instr)
    var idx = mir::mir_instr_get_operand2(instr)
    var val = mir::mir_instr_get_slot1(instr)
    cg_c_line(out, "  ((qz_val*)(intptr_t)#{cg_c_reg(ptr)})[#{cg_c_reg(idx)}] = #{cg_c_reg(val)};")
    return
  end

  # MIR_PHI = 18 — phi nodes become variable assignments in predecessors
  # In C, phi is handled by assigning to a shared variable in each predecessor block
  # The phi instruction just reads the phi variable
  if kind == 18
    var phi_name = mir::mir_instr_get_var_name(instr)
    cg_c_line(out, "  qz_val #{d} = #{cg_c_sanitize_name(phi_name)}; /* phi */")
    return
  end

  # MIR_LOAD_OFFSET = 19 — load from pointer + byte offset
  if kind == 19
    var ptr = mir::mir_instr_get_operand1(instr)
    var offset = mir::mir_instr_get_slot1(instr)
    cg_c_line(out, "  qz_val #{d} = *((qz_val*)((char*)(intptr_t)#{cg_c_reg(ptr)} + #{offset}));")
    return
  end

  # MIR_SELECT = 20 — ternary: cond ? a : b
  if kind == 20
    var cond = mir::mir_instr_get_operand1(instr)
    var a = mir::mir_instr_get_operand2(instr)
    var b = mir::mir_instr_get_slot1(instr)
    cg_c_line(out, "  qz_val #{d} = #{cg_c_reg(cond)} ? #{cg_c_reg(a)} : #{cg_c_reg(b)};")
    return
  end

  # MIR_INLINE_C = 21 — emit raw C code
  if kind == 21
    var code = mir::mir_instr_get_string_val(instr)
    cg_c_line(out, "  #{code}")
    return
  end

  # MIR_CONST_FLOAT = 25
  if kind == 25
    var str_val = mir::mir_instr_get_string_val(instr)
    var uid = "_uf#{dest.to_s()}"
    cg_c_line(out, "  union { double d; qz_val i; } #{uid}; #{uid}.d = #{str_val};")
    cg_c_line(out, "  qz_val #{d} = #{uid}.i;")
    return
  end

  # MIR_ADDR_OF = 24 — get address of stack variable
  if kind == 24
    var var_name = mir::mir_instr_get_var_name(instr)
    cg_c_line(out, "  qz_val #{d} = (qz_val)(intptr_t)&#{cg_c_sanitize_name(var_name)};")
    return
  end

  # MIR_UNION_WRAP = 26 — create tagged pair (tag, value) → ptr
  if kind == 26
    var tag_val = mir::mir_instr_get_operand1(instr)
    var payload = mir::mir_instr_get_operand2(instr)
    cg_c_line(out, "  int64_t* _uw#{dest} = (int64_t*)calloc(2, sizeof(int64_t));")
    cg_c_line(out, "  _uw#{dest}[0] = #{cg_c_reg(tag_val)};")
    cg_c_line(out, "  _uw#{dest}[1] = #{cg_c_reg(payload)};")
    cg_c_line(out, "  qz_val #{d} = (qz_val)(intptr_t)_uw#{dest};")
    return
  end

  # MIR_NOP = 0 is a genuine no-op; any other unhandled kind has no C emit
  # path — fail loudly rather than silently emitting `0` (R4.1).
  if kind != 0
    panic("C backend: MIR kind #{kind} not implemented (R4.1: unimplemented backend path)")
  end
end

# ============================================================================
# Intrinsic Emission
# ============================================================================

## Emit a MIR intrinsic call as C code
def cg_c_emit_intrinsic(out: Int, d: String, instr: mir::MirInstr): Void
  var func_name = mir::mir_instr_get_func_name(instr)
  var args = mir::mir_instr_get_args(instr)

  # I/O intrinsics
  if func_name == "puts"
    cg_c_line(out, "  puts((const char*)(intptr_t)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "print"
    cg_c_line(out, "  printf(\"%s\", (const char*)(intptr_t)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "print_int"
    cg_c_line(out, "  printf(\"%lld\\n\", (long long)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "eprint"
    cg_c_line(out, "  fprintf(stderr, \"%s\", (const char*)(intptr_t)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "eputs"
    cg_c_line(out, "  fputs((const char*)(intptr_t)#{cg_c_reg(args[0])}, stderr); fputc('\\n', stderr);")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end

  # Process control
  if func_name == "exit"
    cg_c_line(out, "  exit((int)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end

  # Memory intrinsics
  if func_name == "mem_alloc"
    cg_c_line(out, "  qz_val #{d} = (qz_val)(intptr_t)calloc(1, #{cg_c_reg(args[0])});")
    return
  end
  if func_name == "qz_free"
    cg_c_line(out, "  free((void*)(intptr_t)#{cg_c_reg(args[0])});")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "ptr_read_byte"
    cg_c_line(out, "  qz_val #{d} = (qz_val)(*((unsigned char*)(intptr_t)#{cg_c_reg(args[0])}));")
    return
  end
  if func_name == "ptr_write_byte"
    cg_c_line(out, "  *((unsigned char*)(intptr_t)#{cg_c_reg(args[0])}) = (unsigned char)#{cg_c_reg(args[1])};")
    cg_c_line(out, "  qz_val #{d} = 0;")
    return
  end
  if func_name == "ptr_add"
    cg_c_line(out, "  qz_val #{d} = #{cg_c_reg(args[0])} + #{cg_c_reg(args[1])};")
    return
  end
  if func_name == "int_to_cptr"
    cg_c_line(out, "  qz_val #{d} = #{cg_c_reg(args[0])};")
    return
  end

  # String intrinsics
  if func_name == "str_size"
    cg_c_line(out, "  qz_val #{d} = (qz_val)strlen((const char*)(intptr_t)#{cg_c_reg(args[0])});")
    return
  end
  if func_name == "str_eq"
    cg_c_line(out, "  qz_val #{d} = (strcmp((const char*)(intptr_t)#{cg_c_reg(args[0])}, (const char*)(intptr_t)#{cg_c_reg(args[1])}) == 0) ? 1 : 0;")
    return
  end
  if func_name == "str_get"
    cg_c_line(out, "  qz_val #{d} = (qz_val)((unsigned char*)((intptr_t)#{cg_c_reg(args[0])}))[#{cg_c_reg(args[1])}];")
    return
  end

  # Math intrinsics
  if func_name == "abs"
    cg_c_line(out, "  qz_val #{d} = (#{cg_c_reg(args[0])} < 0) ? -#{cg_c_reg(args[0])} : #{cg_c_reg(args[0])};")
    return
  end
  if func_name == "min"
    cg_c_line(out, "  qz_val #{d} = (#{cg_c_reg(args[0])} < #{cg_c_reg(args[1])}) ? #{cg_c_reg(args[0])} : #{cg_c_reg(args[1])};")
    return
  end
  if func_name == "max"
    cg_c_line(out, "  qz_val #{d} = (#{cg_c_reg(args[0])} > #{cg_c_reg(args[1])}) ? #{cg_c_reg(args[0])} : #{cg_c_reg(args[1])};")
    return
  end

  # Time intrinsics
  if func_name == "time_epoch"
    cg_c_line(out, "  qz_val #{d} = (qz_val)time(NULL);")
    return
  end

  # Default: no C emit path for this intrinsic — fail loudly rather than
  # silently emitting `0` (R4.1: unimplemented backend path).
  panic("C backend: intrinsic '" + func_name + "' not implemented (R4.1: unimplemented backend path)")
end

# ============================================================================
# Block Terminator Emission
# ============================================================================

## Emit block terminator as C code
def cg_c_emit_terminator(out: Int, blk: mir::MirBlock, blocks: Vec<mir::MirBlock>): Void
  var term_kind = mir::mir_block_get_term_kind(blk)

  # TERM_RETURN = 0
  if term_kind == 0
    var data = mir::mir_block_get_term_data(blk)
    cg_c_line(out, "  return #{cg_c_reg(data)};")
    return
  end

  # TERM_JUMP = 1
  if term_kind == 1
    var target = mir::mir_block_get_term_data(blk)
    if target >= 0
      if target < blocks.size
        var target_blk = blocks[target]
        var target_label = mir::mir_block_get_label(target_blk)
        cg_c_line(out, "  goto #{cg_c_label(target_label)};")
        return
      end
    end
    cg_c_line(out, "  goto L_unknown;")
    return
  end

  # TERM_BRANCH = 2
  if term_kind == 2
    var cond = mir::mir_block_get_term_data(blk)
    var true_idx = mir::mir_block_get_branch_true(blk)
    var false_idx = mir::mir_block_get_branch_false(blk)
    var true_label = "L_unknown"
    var false_label = "L_unknown"
    if true_idx >= 0
      if true_idx < blocks.size
        true_label = cg_c_label(mir::mir_block_get_label(blocks[true_idx]))
      end
    end
    if false_idx >= 0
      if false_idx < blocks.size
        false_label = cg_c_label(mir::mir_block_get_label(blocks[false_idx]))
      end
    end
    cg_c_line(out, "  if (#{cg_c_reg(cond)}) goto #{true_label}; else goto #{false_label};")
    return
  end

  # TERM_UNREACHABLE = 3
  if term_kind == 3
    cg_c_line(out, "  __builtin_unreachable();")
    return
  end
end

# ============================================================================
# Function Emission
# ============================================================================

## Emit a single function as C code
def cg_c_emit_function(out: Int, prog: mir::MirProgram, func: mir::MirFunc): Void
  var name = mir::mir_func_get_name(func)
  # Rename main to qz_main (matching LLVM backend behavior)
  var c_name = ""
  if name == "main"
    c_name = "qz_main"
  else
    c_name = cg_c_sanitize_name(name)
  end
  var ret_type = mir::mir_func_get_return_type(func)
  var params = mir::mir_func_get_params(func)
  var blocks = mir::mir_func_get_blocks(func)
  var locals = mir::mir_func_get_locals(func)

  # Function signature
  var sb = sb_new()
  if ret_type == 3
    sb_append(sb, "void ")
  else
    sb_append(sb, "qz_val ")
  end
  sb_append(sb, c_name)
  sb_append(sb, "(")
  for pi in 0..params.size
    if pi > 0
      sb_append(sb, ", ")
    end
    sb_append(sb, "qz_val ")
    sb_append(sb, cg_c_sanitize_name(params[pi]))
  end
  if params.size == 0
    sb_append(sb, "void")
  end
  sb_append(sb, ") {")
  cg_c_line(out, sb_to_string(sb))

  # Local variable declarations
  for li in 0..locals.size
    var lname = cg_c_sanitize_name(locals[li])
    cg_c_line(out, "  qz_val #{lname} = 0;")
  end

  # Emit basic blocks
  for bi in 0..blocks.size
    var blk = blocks[bi]
    var label = mir::mir_block_get_label(blk)
    cg_c_line(out, "#{cg_c_label(label)}:;")

    # Emit instructions
    var instrs = mir::mir_block_get_instructions(blk)
    for ii in 0..instrs.size
      cg_c_emit_instr(out, prog, instrs[ii])
    end

    # Emit terminator
    cg_c_emit_terminator(out, blk, blocks)
  end

  cg_c_line(out, "}")
  cg_c_line(out, "")
end

# ============================================================================
# Main Entry Point
# ============================================================================

## Emit a C main() wrapper that calls qz_main
def cg_c_emit_main_wrapper(out: Int): Void
  cg_c_line(out, "/* Entry point wrapper */")
  cg_c_line(out, "int main(int argc, char** argv) {")
  cg_c_line(out, "  return (int)qz_main();")
  cg_c_line(out, "}")
end

## Generate C code from MIR program. Main entry point for the C backend.
def cg_c_codegen(prog: mir::MirProgram, all_funcs: Vec<ResolverEntry>): String
  var out = sb_new()

  # Reset and pre-scan string pool
  cg_c_reset_pool()
  cg_c_prescan_strings(prog)

  cg_c_emit_header(out)
  cg_c_emit_string_pool(out)
  cg_c_emit_globals(out, prog)
  cg_c_emit_forward_decls(out, prog)

  # Emit all functions (main is renamed to qz_main in cg_c_emit_function)
  # Emit non-main functions first, then main last (so qz_main is defined before wrapper)
  var funcs = mir::mir_get_functions(prog)
  for i in 0..funcs.size
    var func = funcs[i]
    var name = mir::mir_func_get_name(func)
    if name != "main"
      cg_c_emit_function(out, prog, func)
    end
  end

  # Emit main (as qz_main) last
  for i in 0..funcs.size
    var func = funcs[i]
    var name = mir::mir_func_get_name(func)
    if name == "main"
      cg_c_emit_function(out, prog, func)
    end
  end

  cg_c_emit_main_wrapper(out)

  return sb_to_string(out)
end
