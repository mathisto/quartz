    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd)")
    codegen_util::cg_emit(out, "  br label %trc_nosig_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "trc_nosig_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ul2 = call i32 @pthread_mutex_unlock(ptr %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".optptr = ptrtoint ptr %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".opt to i64")
    codegen_util::cg_emit(out, "  br label %trc_done_")
    codegen_util::cg_emit_line(out, d)
    # Done: phi to select return value
    codegen_util::cg_emit(out, "trc_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ -1, %trc_closed_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ 0, %trc_open_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".optptr, %trc_nosig_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.optptr, %trc_ub_fin_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    # C.13.6 channel waker: try_recv_or_closed frees a slot on success.
    # Wakes SendSelectable write-waiters parked on `@ch | 1`. Fired
    # unconditionally on all merge-paths; spurious wakes on empty/closed
    # paths are bounded — write-waiters re-poll once. (Close itself
    # already woke both directions via channel_close's two notify_alls;
    # this wake here is for the success-path consumer freeing a slot.)
    codegen_util::cg_emit(out, "  %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wkey = or i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  call void @__qz_waiter_notify_all(i64 %trc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wkey)")
    return 1
  end

  return 0
end
