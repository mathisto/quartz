##! # Concurrency Intrinsics: conc_channel_try
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

def cg_emit_conc_channel_try(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  if name == "try_send"
    var ch = args[0].to_s()
    var val = args[1].to_s()
    codegen_util::cg_emit_line(out, "  ; try_send: non-blocking, returns 1=ok, 0=full, 2=ok+at_hwm")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ch = inttoptr i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 0")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 64")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.gep = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 112")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = bitcast ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.gep to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.gep = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 120")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.p = bitcast ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.gep to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail.gep = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 136")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail.p = bitcast ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.gep to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.gep = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 208")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.p = bitcast ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.gep to ptr")
    # Lock-free pre-check: if buffered channel is full, return 0 without locking
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pre.cnt = load atomic i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p monotonic, align 8")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pre.cap = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pre.full = icmp uge i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pre.cnt, %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pre.cap")
    # cap==-1 (unbounded) means 0xFFFF..., so uge is always false → never skips
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pre.full, label %ts_pre_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_lock_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_pre_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %ts_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_lock_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lk = call i32 @pthread_mutex_lock(ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    # Phase 17: Check unbounded (cap==-1) — always succeeds via linked-list enqueue
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub = icmp eq i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap, -1")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub, label %ts_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_full_check_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Linked-list enqueue (same as send unbounded)
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node = call ptr @__qz_alloc(i64 16)")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, val)
    codegen_util::cg_emit(out, ", ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.nn = getelementptr i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.nn")
    # Load tail, check if queue empty
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.tail = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ht = icmp ne i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.tail, 0")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ht, label %ts_ub_app_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_ub_emp_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ub_app_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ot = inttoptr i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.tail to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.on = getelementptr i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.ot, i64 1")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni = ptrtoint ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node to i64")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.on")
    codegen_util::cg_emit(out, "  br label %ts_ub_st_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ub_emp_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Set head (offset 128)
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni2 = ptrtoint ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node to i64")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.hp = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 128")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni2, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.hp")
    codegen_util::cg_emit(out, "  br label %ts_ub_st_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ub_st_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Update tail
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni3 = ptrtoint ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.node to i64")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.ni3, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    # count++
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.c1 = add i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 1")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.c1, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Signal + unlock
    codegen_util::cg_emit(out, "  call i32 @pthread_cond_signal(ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd)")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %ts_done_")
    codegen_util::cg_emit_line(out, d)
    # --- End unbounded try_send, resume with full check ---
    codegen_util::cg_emit(out, "ts_full_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".full = icmp eq i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt, %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".full, label %ts_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_handoff_check_")
    codegen_util::cg_emit_line(out, d)
    # P36.2: Fast-path when buffer empty AND receiver parked
    # Skips 3 conditional branches (signal?, wake?, pipe?) — all are unconditionally needed
    codegen_util::cg_emit(out, "ts_handoff_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt_zero = icmp eq i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 0")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt_zero, label %ts_handoff_maybe_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_ok_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_handoff_maybe_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.rw.p = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 168")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.rw = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.rw.p")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.has_rw = icmp ne i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.rw, 0")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.has_rw, label %ts_handoff_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_ok_")
    codegen_util::cg_emit_line(out, d)
    # Fast handoff: buffer empty + receiver waiting → write to buffer, signal+wake+pipe unconditionally
    codegen_util::cg_emit(out, "ts_handoff_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Store value at buffer[tail] (tail must be 0 since count==0 and buffer was empty)
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, val)
    codegen_util::cg_emit(out, ", ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.p")
    # tail = 1 % cap (no need to load tail — it's 0 when count==0 for ring buffer)
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.tail1 = urem i64 1, %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.tail1, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    # count = 1
    codegen_util::cg_emit(out, "  store i64 1, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Unconditional signal (buffer was empty → always signal)
    codegen_util::cg_emit(out, "  call i32 @pthread_cond_signal(ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd)")
    # Dequeue recv_q head node, extract frame, wake
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.node = inttoptr i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.rw to ptr")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.frame = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.node")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.nn = getelementptr i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.node, i64 1")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.next = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.nn")
    codegen_util::cg_emit(out, "  store i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.next, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.rw.p")
    # Clear tail if queue now empty
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.qe = icmp eq i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.next, 0")
    codegen_util::cg_emit(out, "  br i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.qe, label %ts_ho_ct_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ts_ho_wake_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ho_ct_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.tp = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 176")
    codegen_util::cg_emit(out, "  store i64 0, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.tp")
    codegen_util::cg_emit(out, "  br label %ts_ho_wake_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_ho_wake_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.node)")
    codegen_util::cg_emit(out, "  call void @__qz_sched_wake(i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.frame)")
    # Pipe notification (always check — needed for edge-triggered async)
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.wfd.p = getelementptr i8, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 160")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.wfd = load i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.wfd.p")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ho.has_pipe = icmp ne i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ho.wfd, -1")
    codegen_util::cg_emit(out, "  br i1 %ts")
