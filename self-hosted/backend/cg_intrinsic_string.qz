  if name == "str_bytes"
    var s = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_chars(i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_byte_find"
    var hay = args[0]
    var ndl = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".hay", hay, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".ndl", ndl, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found = call ptr @strstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hay, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ndl)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".found, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull, label %bfind_nf_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %bfind_f_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "bfind_f_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".found to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hay.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hay to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".offset = sub i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found.i, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hay.i")
    codegen_util::cg_emit_option_some_inline("osbf_#{d}", "%v#{d}.offset")
    codegen_util::cg_emit(out, "  br label %bfind_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "bfind_nf_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_option_none_inline("onbf_#{d}")
    codegen_util::cg_emit(out, "  br label %bfind_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "bfind_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %osbf_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %bfind_f_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %onbf_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %bfind_nf_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "str_is_valid_utf8"
    var s = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_is_valid_utf8(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len)")
    return
  end

end

