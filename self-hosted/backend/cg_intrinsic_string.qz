##! # String Intrinsics
##!
##! Emits LLVM IR for immutable string operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import codegen_runtime
import * from str_compat


# ============================================================================
# String Intrinsics (34 handlers)
# ============================================================================

def cg_emit_intrinsic_string(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "str_size"
    # FIX.2: Now returns codepoint count (was: byte count)
    var arg = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_len_utf8(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".blen)")
    return
  end

  # str_len_utf8 removed in v5.27 — use str_size (identical)

  # str_codepoint_at(s, byte_idx) → decode codepoint at byte offset.
  # O(1). Mirrors str_byte_at's shape — both take a byte index.
  if name == "str_codepoint_at"
    var s_arg = args[0]
    var idx_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_codepoint_at_byte(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen, i64 %v")
    codegen_util::cg_emit_int(out, idx_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  # str_codepoint_byte_len(s, byte_idx) → UTF-8 stride (1/2/3/4) for
  # the codepoint that starts at `byte_idx`. O(1). Pair with
  # str_codepoint_at to walk a string sequentially.
  if name == "str_codepoint_byte_len"
    var s_arg = args[0]
    var idx_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_codepoint_byte_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen, i64 %v")
    codegen_util::cg_emit_int(out, idx_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  # str_codepoint_nth(s, cp_idx) → the n-th codepoint. O(n) walk
  # from string start. Use only when ordinal access is genuinely
  # what you need; for sequential iteration prefer
  # str_codepoint_at + str_codepoint_byte_len. Calls the historical
  # @qz_str_codepoint_at helper (name kept for bootstrap stability).
  if name == "str_codepoint_nth"
    var s_arg = args[0]
    var idx_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_codepoint_at(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen, i64 %v")
    codegen_util::cg_emit_int(out, idx_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_from_codepoint"
    var cp_arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_from_codepoint(i64 %v")
    codegen_util::cg_emit_int(out, cp_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "to_str"
    var val_arg = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @to_str(i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_concat"
    var a = args[0]
    var b = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".a", a, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".b", b, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.a = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".a)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.b = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".b)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.a, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.b")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".a, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.a)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst = getelementptr i8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.a")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".b, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.b)")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.buf", "ptr")
    return
  end

  if name == "str_eq"
    var a = args[0]
    var b = args[1]
    var lbl = codegen_util::cg_next_label(state).to_s()
    codegen_util::cg_emit_inttoptr_is(dest, ".a", a, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".b", b, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.a = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".a)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.b = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".b)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.eq = icmp eq i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.a, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.b")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len.eq, label %streq_cmp_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, ", label %streq_ne_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "streq_cmp_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmp = call i32 @memcmp(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".a, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".b, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len.a)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq = icmp eq i32 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cmp, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eqval = zext i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".eq to i64")
    codegen_util::cg_emit(out, "  br label %streq_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "streq_ne_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %streq_done_")
    codegen_util::cg_emit_line(out, lbl)
    codegen_util::cg_emit(out, "streq_done_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eqval, %streq_cmp_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit(out, " ], [ 0, %streq_ne_")
    codegen_util::cg_emit(out, lbl)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "str_hash"
    var s = args[0]
    codegen_util::cg_emit(out, "  %sh")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @__str_hash(ptr %sh")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    return
  end

  # str_char_at: transitional alias for str_codepoint_nth. Identical
  # codegen — emits a call to @qz_str_codepoint_at (the historical
  # helper kept under its old name for bootstrap stability). Will be
  # removed once stdlib + spec call sites migrate to str_codepoint_nth.
  if name == "str_char_at"
    var s_arg = args[0]
    var idx_arg = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_codepoint_at(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".blen, i64 %v")
    codegen_util::cg_emit_int(out, idx_arg)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_slice"
    # FIX.2: Now uses codepoint indices (was: byte indices)
    var s = args[0]
    var start_idx = args[1]
    var end_idx = args[2]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_str_slice_utf8(i64 %v")
    codegen_util::cg_emit_int(out, s)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, start_idx)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, end_idx)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_contains"
    var haystack = args[0]
    var needle = args[1]
    codegen_util::cg_emit_inttoptr_is(dest, ".hay", haystack, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".ndl", needle, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found = call ptr @strstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hay, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ndl)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".isnull = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".found, null")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bool = select i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".isnull, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bool, 0")
    return
  end

  if name == "str_from_int"
    var n = args[0]
    if codegen_runtime::cg_is_freestanding(state.target_triple) == 1
      # D.11 Phase 8b step 2 — freestanding str_from_int. Dispatch to
      # @qz_int_to_str (emitted by cg_emit_int_to_str_helper inside
      # the freestanding branch of cg_emit_runtime_decls), which is a
      # pure-IR i64→decimal loop that writes into a qz_alloc_str
      # buffer. No @sprintf, no @.fmt.int.noln, no @qz_wrap_cstr
      # (none of which are emitted in freestanding builds —
      # cg_emit_runtime_helpers_2 sits past the early-return).
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = call i64 @qz_int_to_str(i64 %v")
      codegen_util::cg_emit_int(out, n)
      codegen_util::cg_emit_line(out, ")")
      return
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmp = call ptr @__qz_alloc(i64 32)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fmt = getelementptr [4 x i8], [4 x i8]* @.fmt.int.noln, i64 0, i64 0")
    codegen_util::cg_emit(out, "  call i32 (ptr, ptr, ...) @sprintf(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmp, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fmt, i64 %v")
    codegen_util::cg_emit_int(out, n)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmp)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmp)")
    codegen_util::cg_emit_ptrtoint(d, "#{d}.buf", "ptr")
    return
  end

  if name == "str_to_int"
    var s = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @atoll(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr)")
    return
  end

  if name == "str_to_f64"
    var s = args[0]
    codegen_util::cg_emit_inttoptr_is(dest, ".ptr", s, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dbl = call double @strtod(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr, ptr null)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = bitcast double %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dbl to i64")
    return
  end

  if name == "bool_to_str"
    var b = args[0]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_bool_to_str(i64 %v")
    codegen_util::cg_emit_int(out, b)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "str_split"
    var s = args[0]
    var delim = args[1]
    # Create result vector
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec = call i64 @qz_vec_new()")
    # Convert string and delimiter to pointers
    codegen_util::cg_emit_inttoptr_is(dest, ".str", s, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".delim", delim, "ptr")
    # Get lengths using O(1) length read
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dlen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".delim)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slen = call i64 @qz_str_get_len(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".str)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bufsize = add i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slen, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bufsize)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".str, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bufsize)")
    # Call str_split runtime helper
    codegen_util::cg_emit(out, "  call void @qz_str_split_impl(i64 %v")
    codegen_util::cg_emit(out, d)
