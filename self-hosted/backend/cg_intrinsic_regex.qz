    codegen_util::cg_emit(out, ".str, i64 1, ptr %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pmatch, i32 0)")
    codegen_util::cg_emit(out, "  %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found = icmp eq i32 %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".match, 0")
    codegen_util::cg_emit(out, "  br i1 %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".found, label %rmp_hit_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rmp_miss_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rmp_hit_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pmatch.ptr = bitcast ptr %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pmatch to ptr")
    if is_start == 1
      codegen_util::cg_emit(out, "  %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".pos = load i64, ptr %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".pmatch.ptr")
    else
      codegen_util::cg_emit(out, "  %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".eo.ptr = getelementptr i64, ptr %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".pmatch.ptr, i64 1")
      codegen_util::cg_emit(out, "  %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".pos = load i64, ptr %rmp")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".eo.ptr")
    end
    codegen_util::cg_emit(out, "  call void @regfree(ptr %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".regex)")
    codegen_util::cg_emit_option_some_inline("rmp.s.#{d}", "%rmp#{d}.pos")
    codegen_util::cg_emit(out, "  br label %rmp_end_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rmp_miss_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  call void @regfree(ptr %rmp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".regex)")
    codegen_util::cg_emit(out, "  br label %rmp_fail_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rmp_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_option_none_inline("rmp.n.#{d}")
    codegen_util::cg_emit(out, "  br label %rmp_end_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rmp_end_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %rmp.s.")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %rmp_hit_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %rmp.n.")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %rmp_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "regex_capture_named"
    var text_arg = args[0]
    var pat_arg = args[1]
    var name_arg = args[2]
    codegen_util::cg_emit_inttoptr_is(dest, ".text", text_arg, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".pat", pat_arg, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".name", name_arg, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res = call ptr @regex_capture_named_pattern(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".text, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pat, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".name)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".null = icmp eq ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res, null")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".null, label %rcn_empty_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rcn_ok_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rcn_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wrapped = call ptr @qz_wrap_cstr(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wrapped to i64")
    codegen_util::cg_emit(out, "  br label %rcn_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rcn_empty_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty = call ptr @qz_alloc_str(i64 0)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty.i64 = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".empty to i64")
    codegen_util::cg_emit(out, "  br label %rcn_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rcn_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok, %rcn_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty.i64, %rcn_empty_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

end

