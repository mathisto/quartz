    codegen_util::cg_emit(out, ".oldbytes = mul i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".cap.p, 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newdata = call ptr @__qz_realloc(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".olddata, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".oldbytes, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".newbytes)")
    codegen_util::cg_emit_ptrtoint("#{d}.newdata.i", "#{d}.newdata", "ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newdata.i, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".data.ptr.g")
    codegen_util::cg_emit(out, "  br label %regex_cap_store_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_store_")
    codegen_util::cg_emit_int(out, dest)
