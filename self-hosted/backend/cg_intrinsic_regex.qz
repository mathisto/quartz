##! # Regex Intrinsics
##!
##! Emits LLVM IR for PCRE2 regular expression operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

# ============================================================================
# Regex Intrinsics (9 handlers)
# ============================================================================

def cg_emit_intrinsic_regex(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "regex_match"
    var str = args[0]
    var pat = args[1]
    # Convert to i8*
    codegen_util::cg_emit_inttoptr_is(dest, ".str", str, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".pat", pat, "ptr")
    # Allocate regex_t on stack
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".regex = alloca i8, i64 128")
    # regcomp with REG_EXTENDED|REG_NOSUB = 9
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".comp = call i32 @regcomp(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".regex, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".pat, i32 9)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".ok = icmp eq i32 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".comp, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".ok, label %regex_match_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_fail_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_match_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".match = call i32 @regexec(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".regex, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".str, i64 0, ptr null, i32 0)")
    codegen_util::cg_emit(out, "  call void @regfree(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".regex)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".eq0 = icmp eq i32 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".match, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".res = zext i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".eq0 to i64")
    codegen_util::cg_emit(out, "  br label %regex_done_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_fail_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %regex_done_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_done_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, " = phi i64 [ %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".res, %regex_match_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, " ], [ 0, %regex_fail_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "regex_capture"
    var str = args[0]
    var pat = args[1]
    # Convert to i8*
    codegen_util::cg_emit_inttoptr_is(dest, ".str", str, "ptr")
    codegen_util::cg_emit_inttoptr_is(dest, ".pat", pat, "ptr")
    # Allocate regex_t on stack (128 bytes)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".regex = alloca i8, i64 128")
    # regcomp with REG_EXTENDED = 1 (NOT REG_NOSUB)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".comp = call i32 @regcomp(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".regex, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".pat, i32 1)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".ok = icmp eq i32 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".comp, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".ok, label %regex_cap_ok_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_cap_fail_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_ok_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    # Allocate pmatch array (10 regmatch_t * 16 bytes = 160 bytes)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".pmatch = alloca i8, i64 160")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".match = call i32 @regexec(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".regex, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".str, i64 10, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".pmatch, i32 0)")
    codegen_util::cg_emit(out, "  call void @regfree(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".regex)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".matched = icmp eq i32 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".match, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".matched, label %regex_cap_extract_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_cap_fail_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_extract_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    # Create vector to hold captures
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 24)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".hdr.i64 = bitcast ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    codegen_util::cg_emit(out, "  store i64 16, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".size.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".size.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".data = call ptr @__qz_alloc(i64 128)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 2")
    codegen_util::cg_emit_ptrtoint("#{d}.data.i64", "#{d}.data", "ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".data.i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".data.ptr")
    codegen_util::cg_emit_ptrtoint("#{d}.vec", "#{d}.hdr", "ptr")
    # Loop through pmatch extracting ALL capture groups (0-9)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".pmatch.ptr = bitcast ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".pmatch to ptr")
    codegen_util::cg_emit(out, "  br label %regex_cap_loop_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_loop_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    # Phi for loop index: 0 on entry, incremented each iteration
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".i = phi i64 [ 0, %regex_cap_extract_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, " ], [ %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".i.next, %regex_cap_cont_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, " ]")
    # Check if index < 10
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".loop.cond = icmp slt i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".i, 10")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".loop.cond, label %regex_cap_check_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_cap_loopend_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_check_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    # Each regmatch_t is 16 bytes: offset = i * 2 (in i64 units)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".off = mul i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".i, 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".so.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".pmatch.ptr, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".so = load i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".so.ptr")
    # Check if group matched: rm_so != -1
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".valid = icmp ne i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".so, -1")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".valid, label %regex_cap_push_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_cap_cont_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_push_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    # Load rm_eo (at offset + 1 in i64 units)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".eo.off = add i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".off, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".eo.ptr = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".pmatch.ptr, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".eo.off")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".eo = load i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".eo.ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".len = sub i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".eo, %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".so")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".src = getelementptr i8, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".str, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".so")
    # Allocate and copy substring
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".sub = call ptr @qz_alloc_str(i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".len)")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".sub, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".src, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".len)")
    codegen_util::cg_emit_ptrtoint("#{d}.subi64", "#{d}.sub", "ptr")
    # Inline vec_push with proper grow logic
    codegen_util::cg_emit_inttoptr("#{d}.hdr.p", "#{d}.vec", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".cap.p = load i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".size.ptr.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".size.p = load i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".size.ptr.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".full = icmp sge i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".size.p, %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".cap.p")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".full, label %regex_cap_grow_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ", label %regex_cap_store_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "regex_cap_grow_")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newcap.raw = mul i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".cap.p, 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newcap.small = icmp slt i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".newcap.raw, 4")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newcap = select i1 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newcap.small, i64 4, i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".newcap.raw")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newcap, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".newbytes = mul i64 %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".newcap, 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".data.ptr.g = getelementptr i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit(out, ".olddata.i = load i64, ptr %v")
    codegen_util::cg_emit_int(out, dest)
    codegen_util::cg_emit_line(out, ".data.ptr.g")
    codegen_util::cg_emit_inttoptr("#{d}.olddata", "#{d}.olddata.i", "ptr")
