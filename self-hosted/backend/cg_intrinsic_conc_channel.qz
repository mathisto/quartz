##! # Concurrency Intrinsics: conc_channel
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import codegen_runtime
import * from str_compat

# D.11 Phase 7 / B.5d (Path A) — freestanding channel codegen fork.
#
# Stdlib's channel intrinsics emit raw pthread_mutex/pthread_cond — see
# [[feedback-stdlib-codegen-intrinsics-hosted-only]]. In freestanding
# (x86_64-unknown-none-elf), redirect to the kernel's chan_* primitives
# defined in tools/baremetal/hello_x86.qz. The kernel provides:
#
#   def chan_new(cap: Int): Int       — alloc + init channel from PMM
#   def chan_send(ch: Int, v: Int): Void
#   def chan_recv(ch: Int): Int       — blocks if empty
#   def chan_close(ch: Int): Void
#   def chan_closed(ch: Int): Int     — 0 or 1
#   def chan_count(ch: Int): Int
#   def chan_cap(ch: Int): Int
#
# The kernel's chan struct (CHAN_* offsets in hello_x86.qz) is NOT
# layout-compatible with stdlib's hosted struct (different mutex/cond
# fields) — that's why we route through function calls, not inlined
# accessors. The function-call boundary lets the kernel own the ABI.
#
# Names that don't map cleanly (notify_fd, async_*, park_*, high_water,
# notify_pipe, notify_send_*, send_notify_*) fall through to the hosted
# emit, which will emit pthread calls + link-fail. Caller of those in
# kernel context: open a bug. B.5d's surface is the core 7 above; B.5e
# may extend if Actor needs more.
def cg_freestanding_channel_emit(out: Int, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String): Int
  if name == "channel_new"
    var cap = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_new → kernel chan_new")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_new(i64 %v")
    codegen_util::cg_emit(out, cap)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "send"
    var ch  = args[0].to_s()
    var val = args[1].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding send → kernel chan_send")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_send(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit(out, val)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "recv"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding recv → kernel chan_recv")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_recv(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "try_recv"
    # B.5e.7a — actor stop/cascade/crash drain loops. Returns Option ptr
    # [tag:i64, value:i64] (tag 0 = Some); kernel chan_try_recv matches the
    # hosted try_recv contract.
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding try_recv → kernel chan_try_recv")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_try_recv(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "try_recv_or_closed"
    # B.5e.7a — actor stop/method proxies. Returns >0 = Option ptr
    # [tag:i64, value:i64] (got value), 0 = empty+open, -1 = empty+closed.
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding try_recv_or_closed → kernel chan_try_recv_or_closed")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_try_recv_or_closed(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "channel_close"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_close → kernel chan_close")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_close(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "channel_closed"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_closed → kernel chan_closed")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_closed(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "channel_size"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_size → kernel chan_count")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_count(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "channel_capacity"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_capacity → kernel chan_cap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @chan_cap(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "channel_is_empty"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_is_empty → chan_count == 0")
    codegen_util::cg_emit(out, "  %ie")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = call i64 @chan_count(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %ie")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq = icmp eq i64 %ie")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %ie")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".eq to i64")
    return 1
  end
  if name == "channel_is_full"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding channel_is_full → chan_count == chan_cap")
    codegen_util::cg_emit(out, "  %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = call i64 @chan_count(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = call i64 @chan_cap(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".eq = icmp eq i64 %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt, %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %if")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".eq to i64")
    return 1
  end
  # B.5e — actor runtime intrinsics. Hosted emits @__qz_actor_mark_clean /
  # @__qz_actor_check_clean (a pthread-mutex side-table) and reads/writes the
  # @__qz_current_actor_inbox TLS global. Freestanding has neither, so redirect
  # to the kernel helpers in tools/baremetal/hello_x86.qz: the clean-mark
  # side-table (actor_*_clean_kernel) and the per-task TASK_ACTOR_INBOX slot
  # (actor_*_self_inbox_kernel). See the hosted siblings at ~2629-2682 below.
  if name == "actor_mark_clean"
    var inbox = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding actor_mark_clean → kernel side-table")
    codegen_util::cg_emit(out, "  call void @actor_mark_clean_kernel(i64 %v")
    codegen_util::cg_emit(out, inbox)
    codegen_util::cg_emit_line(out, ")")
    # Void intrinsic; materialize %v<d> = 0 so the dispatcher's SSA refs resolve.
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end
  if name == "actor_check_clean"
    var inbox = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding actor_check_clean → kernel side-table")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @actor_check_clean_kernel(i64 %v")
    codegen_util::cg_emit(out, inbox)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end
  if name == "actor_self_inbox"
    codegen_util::cg_emit_line(out, "  ; freestanding actor_self_inbox → per-task TASK_ACTOR_INBOX")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = call i64 @actor_self_inbox_kernel()")
    return 1
  end
  if name == "__actor_set_self_inbox"
    var inbox = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; freestanding __actor_set_self_inbox → per-task TASK_ACTOR_INBOX")
    codegen_util::cg_emit(out, "  call void @actor_set_self_inbox_kernel(i64 %v")
    codegen_util::cg_emit(out, inbox)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end
  return 0
end

def cg_emit_conc_channel(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  # D.11 Phase 7 / B.5d — freestanding fast-path. Returns 1 if handled;
  # otherwise falls through to the hosted (pthread-based) emit below.
  if codegen_runtime::cg_is_freestanding(state.target_triple) == 1
    var fs = cg_freestanding_channel_emit(out, dest, name, args, argc, d)
    if fs == 1
      return 1
    end
  end

  if name == "channel_new_unbounded"
    codegen_util::cg_emit_line(out, "  ; channel_new_unbounded: alloc unbounded channel (linked-list queue, cap=-1)")
    # Fixed size = 168 bytes (no ring buffer). Layout same as channel_new.
    # cap=-1 sentinel tells send/recv to use linked-list path.
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 216)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i32 0, i64 216)")
    # Initialize mutex at offset 0
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 0")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_init(ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx, ptr null)")
    # Initialize cond at offset 64
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 64")
    codegen_util::cg_emit(out, "  call i32 @pthread_cond_init(ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd, ptr null)")
    # Store capacity = -1 at offset 112
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 112")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    # count=0, head=0, tail=0 already from memset
    # Initialize notify pipe fds to -1 (lazy allocation)
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd.p = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 152")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.p")
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.p = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 160")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.p")
    # Initialize send notification pipe fds to -1 (lazy allocation, mirrors recv pipe)
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd.p = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 184")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snrfd.p")
    codegen_util::cg_emit(out, "  %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snwfd.p = getelementptr i8, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 192")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".snwfd.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %ub")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem to i64")
    return 1
  end

  if name == "channel_new"
    var cap = args[0].to_s()
    codegen_util::cg_emit(out, "  ; channel_new: alloc buffered channel with capacity %v")
    codegen_util::cg_emit_line(out, cap)
    # Use the user-requested capacity directly. Ring-buffer indexing uses
    # `urem count, cap` instead of the former `and count, (cap - 1)` trick,
    # which required cap to be a power of 2. The observable semantics are
    # now "a channel holds exactly `cap` items" — no silent round-up that
    # used to make channel_new(10) actually hold 16.
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap1 = add i64 %v")
    codegen_util::cg_emit(out, cap)
    codegen_util::cg_emit_line(out, ", 0")
    # Size = 208 + (capacity * 8)  [layout: mutex@0, cond@64, cap@112, count@120, head@128, tail@136, closed@144, notify_rfd@152, notify_wfd@160, recv_q_head@168, recv_q_tail@176, send_q_head@184, send_q_tail@192, high_water_mark@200, buffer@208]
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bufsize = mul i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap1, 8")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size = add i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bufsize, 208")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sztrunc = trunc i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size to i32")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".szi64 = zext i32 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sztrunc to i64")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mem = call ptr @__qz_alloc(i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".szi64)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mem, i32 0, i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".szi64)")
    # Initialize mutex at offset 0
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 0")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.rc = call i32 @pthread_mutex_init(ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx, ptr null)")
    # Initialize cond at offset 64
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd = getelementptr i8, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 64")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd.rc = call i32 @pthread_cond_init(ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd, ptr null)")
    # Store capacity at offset 112
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.gep = getelementptr i8, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 112")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = bitcast ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap1, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    # count=0, head=0, tail=0 already from memset
    # Initialize notify pipe fds to -1 (not yet created, lazy allocation)
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd.gep = getelementptr i8, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 152")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nrfd.p = bitcast ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.p")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.gep = getelementptr i8, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 160")
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.p = bitcast ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 -1, ptr %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.p")
    # Initialize send notification pipe fds to -1 (lazy allocation, mirrors recv pipe)
    codegen_util::cg_emit(out, "  %ch")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".snrfd.gep = getelementptr i8, ptr %ch")
