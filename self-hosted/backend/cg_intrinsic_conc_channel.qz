    codegen_util::cg_emit_line(out, ".pipebuf, i64 0, i64 0")
    codegen_util::cg_emit(out, "  call i32 @pipe(ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rp)")
    # Load read fd (index 0) and write fd (index 1)
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wp = getelementptr [2 x i32], [2 x i32]* %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pipebuf, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd32 = load i32, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rp")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = load i32, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wp")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_rfd = zext i32 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd32 to i64")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_wfd = zext i32 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd32 to i64")
    # Store fds into channel at offsets 184 (rfd) and 192 (wfd)
    codegen_util::cg_emit(out, "  store i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_rfd, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.p")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.gep = getelementptr i8, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 192")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.p = bitcast ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_wfd, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.p")
    # Catch-up: if channel has space (count < cap) or is closed, write a byte to wake senders
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.gep = getelementptr i8, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 120")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.p = bitcast ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.gep to ptr")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = load i64, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.gep = getelementptr i8, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 112")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = bitcast ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.gep to ptr")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_space = icmp slt i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt, %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cls.gep = getelementptr i8, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 144")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cls.p = bitcast ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cls.gep to ptr")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cls = load i64, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cls.p")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closed = icmp ne i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cls, 0")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_catchup = or i1 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_space, %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".is_closed")
    codegen_util::cg_emit(out, "  br i1 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_catchup, label %csn_catchup_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %csn_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "csn_catchup_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cbuf = alloca i8")
    codegen_util::cg_emit(out, "  store i8 1, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cbuf")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cwfd32 = trunc i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new_wfd to i32")
    codegen_util::cg_emit(out, "  call i64 @write(i32 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cwfd32, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cbuf, i64 1)")
    codegen_util::cg_emit(out, "  br label %csn_done_")
    codegen_util::cg_emit_line(out, d)
    # Done: reload read fd from memory (either pre-existing or just created)
    codegen_util::cg_emit(out, "csn_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".final_rfd = load i64, ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nrfd.p")
    codegen_util::cg_emit(out, "  %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ul = call i32 @pthread_mutex_unlock(ptr %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %csn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".final_rfd, 0")
    return 1
  end

  return 0
end
