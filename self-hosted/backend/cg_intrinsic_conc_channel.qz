    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".full = icmp eq i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt, %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  br i1 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".full, label %snd_block_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %snd_store_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_block_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wt = call i32 @pthread_cond_wait(ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %snd_wait_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_store_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Store at buffer[tail]
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slot = getelementptr i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.p, i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, val)
    codegen_util::cg_emit(out, ", ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot")
    # tail = (tail + 1) % capacity
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail1 = add i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail, 1")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tailmod = urem i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail1, %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap")
    codegen_util::cg_emit(out, "  store i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tailmod, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    # count++
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt1 = add i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 1")
    codegen_util::cg_emit(out, "  store i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt1, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Conditional signal: only wake blocked receiver if buffer was empty
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_sig = icmp eq i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 0")
    codegen_util::cg_emit(out, "  br i1 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_sig, label %snd_sig_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %snd_nosig_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_sig_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sg = call i32 @pthread_cond_signal(ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnd)")
    codegen_util::cg_emit(out, "  br label %snd_nosig_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_nosig_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Dequeue + wake head of recv_q (head@168, tail@176) — under mutex, race-free
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.p = getelementptr i8, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 168")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.p")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_rw = icmp ne i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw, 0")
    codegen_util::cg_emit(out, "  br i1 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_rw, label %snd_wake_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %snd_no_wake_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_wake_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Dequeue head node: extract frame, advance head, fix tail if empty, free node
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.ptr = inttoptr i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw to ptr")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.frame = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.ptr")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.nn = getelementptr i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.ptr, i64 1")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.next = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.nn")
    codegen_util::cg_emit(out, "  store i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.next, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.p")
    # If next==0, clear tail too
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.empty = icmp eq i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.next, 0")
    codegen_util::cg_emit(out, "  br i1 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rw.empty, label %snd_clear_tail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %snd_wake_do_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_clear_tail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rqt.p = getelementptr i8, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 176")
    codegen_util::cg_emit(out, "  store i64 0, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rqt.p")
    codegen_util::cg_emit(out, "  br label %snd_wake_do_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_wake_do_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.ptr)")
    codegen_util::cg_emit(out, "  call void @__qz_sched_wake(i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rw.frame)")
    codegen_util::cg_emit(out, "  br label %snd_no_wake_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_no_wake_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ul = call i32 @pthread_mutex_unlock(ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # Notify async receivers via pipe (if pipe exists: notify_write_fd != -1)
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.gep = getelementptr i8, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 160")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd.p = bitcast ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.gep to ptr")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nwfd = load i64, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd.p")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_pipe = icmp ne i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd, -1")
    codegen_util::cg_emit(out, "  br i1 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_pipe, label %snd_notify_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %snd_skip_notify_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_notify_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nbuf = alloca i8")
    codegen_util::cg_emit(out, "  store i8 1, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nbuf")
    codegen_util::cg_emit(out, "  %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = trunc i64 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nwfd to i32")
    codegen_util::cg_emit(out, "  call i64 @write(i32 %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32, ptr %snd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nbuf, i64 1)")
    codegen_util::cg_emit(out, "  br label %snd_skip_notify_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "snd_skip_notify_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Race detector: release at send synchronization point
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_release(ptr %snd")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ch)")
    end
    # C.13.6 channel waker: send fills a slot, so wake RecvSelectable
    # read-waiters parked on `@ch`. SendSelectable write-waiters are NOT
    # woken — they registered on `@ch | 1` (no slot freed).
    codegen_util::cg_emit(out, "  call void @__qz_waiter_notify_all(i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, ")")
    # P21: reset fuel after channel send (natural yield point)
    codegen_util::cg_emit_line(out, "  store i64 4000, ptr @__qz_sched_fuel")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "recv"
    var ch = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; recv: lock, wait until count > 0, load from head, signal, unlock")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ch = inttoptr i64 %v")
    codegen_util::cg_emit(out, ch)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 0")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnd = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 64")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.gep = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 112")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = bitcast ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.gep to ptr")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.gep = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 120")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.p = bitcast ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.gep to ptr")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head.gep = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 128")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head.p = bitcast ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head.gep to ptr")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cls.gep = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 144")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cls.p = bitcast ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cls.gep to ptr")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.gep = getelementptr i8, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch, i64 208")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.p = bitcast ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.gep to ptr")
    # Lock
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lk = call i32 @pthread_mutex_lock(ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # Phase 17: Check capacity for unbounded (-1), rendezvous (0), or buffered (>0)
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rvcap = load i64, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    # Check unbounded first (cap == -1)
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub = icmp eq i64 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rvcap, -1")
    codegen_util::cg_emit(out, "  br i1 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_ub, label %rcv_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rcv_rv_check_")
    codegen_util::cg_emit_line(out, d)
    # --- Unbounded recv: linked-list dequeue ---
    codegen_util::cg_emit(out, "rcv_ub_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %rcv_ub_wait_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rcv_ub_wait_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Wait while count==0 and not closed
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.cnt = load i64, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.empty = icmp eq i64 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.cnt, 0")
    codegen_util::cg_emit(out, "  br i1 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.empty, label %rcv_ub_check_close_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rcv_ub_dequeue_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "rcv_ub_check_close_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.cls = load i64, ptr %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cls.p")
    codegen_util::cg_emit(out, "  %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.is_cls = icmp ne i64 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ub.cls, 0")
    codegen_util::cg_emit(out, "  br i1 %rcv")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ub.is_cls, label %rcv_ub_closed_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %rcv_ub_block_")
    codegen_util::cg_emit_line(out, d)
