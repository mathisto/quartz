  # async_rwlock_free(rw) — free internal mutex + block
  if name == "async_rwlock_free"
    var rw_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %arf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
