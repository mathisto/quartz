    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cn = inttoptr i64 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ch to ptr")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmp = getelementptr i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cn, i64 2")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cm = load i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cmp")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmw = icmp eq i64 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cm, 1")
    codegen_util::cg_emit(out, "  br i1 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmw, label %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_ulk, label %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_bpop")
    codegen_util::cg_emit(out, "arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_bpop:")
