    var init_val = args[0].to_s()
    codegen_util::cg_emit(out, "  %arn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 48)")
    codegen_util::cg_emit(out, "  call ptr @memset(ptr %arn")
