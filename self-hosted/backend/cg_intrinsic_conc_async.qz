    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nxp = getelementptr i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nd, i64 1")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nx = load i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nxp")
    # Batch-wake: load popped waiter's mode (slot 2). Readers queued
    # consecutively behind a writer must all wake together, else they
    # serialize via cascading read_unlock wakes.
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mdp = getelementptr i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nd, i64 2")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".md = load i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mdp")
    codegen_util::cg_emit(out, "  store i64 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nx, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hp")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nxz = icmp eq i64 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nx, 0")
    codegen_util::cg_emit(out, "  br i1 %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nxz, label %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_ct, label %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_dw")
    codegen_util::cg_emit(out, "arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_ct:")
    codegen_util::cg_emit(out, "  %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tp = getelementptr i64, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 3")
    codegen_util::cg_emit(out, "  store i64 0, ptr %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tp")
    codegen_util::cg_emit(out, "  br label %arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_dw")
    codegen_util::cg_emit(out, "arwu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_dw:")
    # Free head node, wake first frame, then dispatch on mode.
    # Mutex is held throughout the batch so wait-list mutations stay atomic.
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %arwu")
