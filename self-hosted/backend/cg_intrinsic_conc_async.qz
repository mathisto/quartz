##! # Concurrency Intrinsics: conc_async
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import * from str_compat

def cg_emit_conc_async(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  # ============================================================================
  # Async Mutex Intrinsics
  # ============================================================================

  # async_mutex_new(initial_value) — allocate and initialize async mutex
  if name == "async_mutex_new"
    var init_val = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; async_mutex_new: allocate 7-slot mutex")
    codegen_util::cg_emit(out, "  %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 56)")
    codegen_util::cg_emit(out, "  call ptr @memset(ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i32 0, i64 56)")
    codegen_util::cg_emit(out, "  %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 5")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, init_val)
    codegen_util::cg_emit(out, ", ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    # 64-byte bare pthread_mutex_t. mir_emit_async_mutex_lock uses the raw
    # pthread_mtx_{lock,unlock} intrinsics (no value-slot load/store), so
    # the allocation does not need the +8 byte protected-value slot the
    # Quartz Mutex<T> struct carries.
    codegen_util::cg_emit(out, "  %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx = call ptr @__qz_alloc(i64 64)")
    codegen_util::cg_emit(out, "  call ptr @memset(ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx, i32 0, i64 64)")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_init(ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx, ptr null)")
    codegen_util::cg_emit(out, "  %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.i = ptrtoint ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx to i64")
    codegen_util::cg_emit(out, "  %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.p = getelementptr i64, ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 6")
    codegen_util::cg_emit(out, "  store i64 %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.i, ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %amn")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem to i64")
    return 1
  end

  # async_mutex_lock(mtx) — non-async fallback: spin-CAS
  if name == "async_mutex_lock"
    var mtx_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  br label %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_spin")
    codegen_util::cg_emit(out, "aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_spin:")
    codegen_util::cg_emit(out, "  %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cas = cmpxchg ptr %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 0, i64 1 acq_rel monotonic")
    codegen_util::cg_emit(out, "  %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = extractvalue { i64, i1 } %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cas, 1")
    codegen_util::cg_emit(out, "  br i1 %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok, label %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_got, label %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_spin")
    codegen_util::cg_emit(out, "aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_got:")
    codegen_util::cg_emit(out, "  %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 5")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %aml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    return 1
  end

  # async_mutex_unlock(mtx, new_value)
  if name == "async_mutex_unlock"
    var mtx_arg = args[0].to_s()
    var val_arg = args[1].to_s()
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 5")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, val_arg)
    codegen_util::cg_emit(out, ", ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  store atomic i64 0, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p release, align 8")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 6")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.i = load i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx.p")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx = inttoptr i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx)")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 2")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".head = load i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head.p")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_waiter = icmp ne i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head, 0")
    codegen_util::cg_emit(out, "  br i1 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has_waiter, label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_wake, label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_no_waiter")
    codegen_util::cg_emit(out, "amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_wake:")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".node = inttoptr i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head to ptr")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".waiter = load i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".node")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".node, i64 1")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next = load i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next.p")
    codegen_util::cg_emit(out, "  store i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".head.p")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next_null = icmp eq i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next, 0")
    codegen_util::cg_emit(out, "  br i1 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".next_null, label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_clr_tail, label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_do_wake")
    codegen_util::cg_emit(out, "amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_clr_tail:")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tail.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 3")
    codegen_util::cg_emit(out, "  store i64 0, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tail.p")
    codegen_util::cg_emit(out, "  br label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_do_wake")
    codegen_util::cg_emit(out, "amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_do_wake:")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wc.p = getelementptr i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 4")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wc = load i64, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wc.p")
    codegen_util::cg_emit(out, "  %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wc.dec = sub i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wc, 1")
    codegen_util::cg_emit(out, "  store i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wc.dec, ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wc.p")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".node)")
    codegen_util::cg_emit(out, "  call void @__qz_sched_wake(i64 %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".waiter)")
    codegen_util::cg_emit(out, "  br label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_no_waiter:")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx)")
    codegen_util::cg_emit(out, "  br label %amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "amu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # async_mutex_try_lock(mtx)
  if name == "async_mutex_try_lock"
    var mtx_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cas = cmpxchg ptr %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 0, i64 1 acq_rel monotonic")
    codegen_util::cg_emit(out, "  %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = extractvalue { i64, i1 } %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cas, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %amt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ok to i64")
    return 1
  end

  # async_mutex_get(mtx)
  if name == "async_mutex_get"
    var mtx_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %amg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %amg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %amg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 5")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %amg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    return 1
  end

  # async_mutex_set(mtx, value)
  if name == "async_mutex_set"
    var mtx_arg = args[0].to_s()
    var val_arg = args[1].to_s()
    codegen_util::cg_emit(out, "  %ams")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ams")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = getelementptr i64, ptr %ams")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 5")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, val_arg)
    codegen_util::cg_emit(out, ", ptr %ams")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # async_mutex_free(mtx)
  if name == "async_mutex_free"
    var mtx_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mtx_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    # Drain-on-free assertion: if wait list is non-empty, freeing the mutex
    # leaks parked-task wait nodes and primes the next waker/unlock for UAF
    # on the freed struct. Abort loudly with a diagnostic instead.
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".drainhd.p = getelementptr i64, ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 2")
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".drainhd = load i64, ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".drainhd.p")
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".drainhas = icmp ne i64 %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".drainhd, 0")
    codegen_util::cg_emit(out, "  br i1 %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".drainhas, label %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_drainpanic, label %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_drainok")
    codegen_util::cg_emit(out, "amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_drainpanic:")
    codegen_util::cg_emit_line(out, "  call void @qz_async_lock_drain_panic()")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit(out, "amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_drainok:")
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.p = getelementptr i64, ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, i64 6")
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx.i = load i64, ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx.p")
    codegen_util::cg_emit(out, "  %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".imtx = inttoptr i64 %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx.i to ptr")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".imtx)")
    codegen_util::cg_emit(out, "  call void @__qz_dealloc(ptr %amf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # ============================================================================
  # Async RwLock Intrinsics
  # Layout: [0]=state (atomic: 0=unlocked, >0=reader_count, -1=write_locked)
