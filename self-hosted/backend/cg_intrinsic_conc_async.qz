  # async_rwlock_get(rw) — read value at slot 1
  if name == "async_rwlock_get"
    var rw_arg = args[0].to_s()
    codegen_util::cg_emit(out, "  %arg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
