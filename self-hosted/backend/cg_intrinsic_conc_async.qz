    codegen_util::cg_emit_line(out, " to ptr")
    # Drain-on-free assertion: wait_head at slot 2 must be 0. Otherwise
    # parked readers/writers leak and the next unlock UAFs the freed block.
    codegen_util::cg_emit(out, "  %arf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".drainhd.p = getelementptr i64, ptr %arf")
