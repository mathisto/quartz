    codegen_util::cg_emit_line(out, ".tid.gep")
    # Lock task-local mutex
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %tlg")
