    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hd.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hd = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hd.p")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 2")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tl = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl.p")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".avail = sub i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hd, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl")
    # n = min(avail, max_count)
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmp = icmp slt i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".avail, %v")
    codegen_util::cg_emit_line(out, max_arg)
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".n = select i1 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmp, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".avail, i64 %v")
    codegen_util::cg_emit_line(out, max_arg)
    # Read loop: push 4 i64s per event into vec
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.i = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.p")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf = inttoptr i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.i to ptr")
    codegen_util::cg_emit(out, "  br label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop:")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_read], [%srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.next, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_body]")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp sge i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".n")
    codegen_util::cg_emit(out, "  br i1 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_end, label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_body")
    codegen_util::cg_emit(out, "srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_body:")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tl, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ridx = and i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off, 65535")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slot = mul i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ridx, 4")
    # Read 4 slots
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s0 = getelementptr i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v0 = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s0")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".v0)")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1o = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, 1")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1 = getelementptr i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s1o")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v1 = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s1")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".v1)")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2o = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, 2")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2 = getelementptr i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2o")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v2 = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".v2)")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s3o = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".slot, 3")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s3 = getelementptr i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s3o")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".v3 = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s3")
    codegen_util::cg_emit(out, "  call void @qz_vec_push(i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec, i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".v3)")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.next = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_end:")
    # Advance tail
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tl.new = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tl, %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".n")
    codegen_util::cg_emit(out, "  store i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tl.new, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl.p")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec, 0")
    return 1
  end

  # sched_park() in non-async context: unreachable (dead code) at runtime.
  #
  # This handler is only reached when sched_park falls through the async-path
  # MIR rewrite in mir_lower_expr_handlers.qz (the `_gen_active >= 2` gate).
  # After Phase 4 QZ0210 (commit 737b0a4e), direct calls from main() are
  # rejected at MIR-lower time. After wider QZ0210 (follow-up #3), all
  # transitive non-async calls will be rejected too. Until that lands, this
  # handler still fires for plain-body emission of go-target functions —
  # those plain bodies are emitted but never called (zero plain callers in
  # compiled binaries, verified Apr 15 via IR grep). An abort is safe dead
  # code there.
  #
  # The legacy spin-park implementation (frame[5] CAS 0→3 + sched_yield spin
  # loop + CAS 3→0 wake) was deleted: it was incompatible with the Apr 15
  # __qz_sched_wake CAS-retry rewrite (commit ab9a7829). Specifically, the
  # wake protocol uses frame[5] values {0,1,2} for async state-machine tasks,
  # and spin-park's use of state 3 is now legacy.
  if name == "sched_park"
    codegen_util::cg_emit_line(out, "  ; sched_park: illegal in non-async context — abort (dead code in go-target plain bodies)")
    codegen_util::cg_emit_line(out, "  call void @abort()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_set_park_pending() — internal: set TLS park flag for worker loop
  if name == "sched_set_park_pending"
    codegen_util::cg_emit_line(out, "  ; sched_set_park_pending: set TLS park flag")
    codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_sched_park_pending")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_wake(task_frame) — safe wake with CAS park_state protocol.
  # Handles wake-before-park: if task hasn't parked yet, sets WAKE_PENDING(2) in frame[5]
  # so the worker loop re-enqueues instead of parking.
  if name == "sched_wake"
    var wake_frame = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_wake: CAS park_state protocol")
    codegen_util::cg_emit(out, "  call void @__qz_sched_wake(i64 %v")
    codegen_util::cg_emit(out, wake_frame)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # task_frame() — return current task frame pointer from thread-local
  if name == "task_frame"
    codegen_util::cg_emit_line(out, "  ; task_frame: load current task frame pointer")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = load i64, ptr @__qz_current_frame")
    return 1
  end

  return 0
end
