    var ispe_val = args[0].to_s()
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, ispe_val)
    codegen_util::cg_emit_line(out, ", ptr @__qz_io_pending_events")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # io_set_pending_proc(val) — store to TLS so worker task_io_real dispatches
  # to __qz_sched_register_proc on the pending suspend. Set to 1 by proc_suspend
  # MIR lowering; cleared back to 0 by the worker after reading it.
  if name == "io_set_pending_proc"
    var ispp_val = args[0].to_s()
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, ispp_val)
    codegen_util::cg_emit_line(out, ", ptr @__qz_io_pending_is_proc")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

