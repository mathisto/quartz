  # sched_is_active() — returns 1 iff @__qz_sched_state == RUNNING (1).
  # B2 (Apr 14, 2026): rewritten from the `completion_map[3] != 0` pointer-
  # proxy check to an atomic load of the authoritative scheduler state word.
  # The old check was a false positive during init (completion map allocated
  # before workers spawned) and a false positive after a free-without-zero
  # if any slot leaked. The state word is toggled by sched_init (→RUNNING)
  # and sched_shutdown (RUNNING→STOPPING→UNINIT) as atomic seq_cst stores,
  # so this read is race-free. Matches Go runtime's sched state, Tokio's
  # worker State, libuv's loop alive predicate.
  if name == "sched_is_active"
    codegen_util::cg_emit_line(out, "  ; sched_is_active: atomic load of @__qz_sched_state, compare == RUNNING(1)")
    codegen_util::cg_emit(out, "  %sia")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".st = load atomic i64, ptr @__qz_sched_state seq_cst, align 8")
    codegen_util::cg_emit(out, "  %sia")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".running = icmp eq i64 %sia")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".st, 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %sia")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".running to i64")
    return 1
  end

  # task_id_next() — atomically increment task ID counter, return new unique ID
  if name == "task_id_next"
    codegen_util::cg_emit_line(out, "  ; task_id_next: atomic increment of task ID counter")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = atomicrmw add ptr @__qz_task_id_counter, i64 1 seq_cst")
    return 1
  end

  # set_current_frame(frame_ptr) — store frame pointer to thread-local @__qz_current_frame
  if name == "set_current_frame"
    var frame_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; set_current_frame: update thread-local frame pointer")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, frame_arg)
    codegen_util::cg_emit_line(out, ", ptr @__qz_current_frame")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
