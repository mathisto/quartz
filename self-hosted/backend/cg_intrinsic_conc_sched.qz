    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_found], [0, %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_ret0]")
    return 1
  end

  # sched_sleep(ms) — non-async fallback: blocking sleep via usleep
  # In async context, MIR lowering intercepts this and emits TLS + suspend instead.
  if name == "sched_sleep"
    var ss_ms = args[0].to_s()
    if codegen_runtime::cg_is_freestanding(state.target_triple) == 1
      # Freestanding non-async fallback. `@usleep` doesn't exist in the kernel
      # (libc_stubs.c has no sleep), and a cooperative yield_now() would leave
      # the caller perpetually READY — which deadlocks `sched_pump`, whose drain
      # loop only returns once the ready ring empties. So we PARK the task via
      # the B.4 suspend bridge (the same `__qz_effect_park_rv_store(-2)` +
      # `__qz_effect_suspend()` sequence b5c_waiter_body uses): the task goes
      # BLOCKED and is removed from the ready ring, then resumes when something
      # calls __qz_sched_wake on it.
      #
      # The only non-async kernel callers are plain `def`s like std/actor's
      # `_supervisor_watcher`, where sched_sleep is the idle-park behind
      # close-event active-wake: the watcher waiter_registers on every child
      # inbox BEFORE parking, so a child crash (channel_close → notify_all →
      # kernel_waiter_wake_all → __qz_sched_wake) resumes it; the first crash
      # is also caught by the watcher's initial post-register scan, so the
      # missing-timeout window the hosted long-poll covers doesn't bite here.
      #
      # KNOWN LIMITATION (filed B.5e.8c follow-up): this ignores the `ms`
      # duration — it's an event-park, not a timed sleep. A non-async caller
      # that sched_sleeps WITHOUT an active-wake source (e.g. `_backoff_apply`
      # with jittered backoff enabled) would park indefinitely. A real kernel
      # ms-timer wake is needed to make this a true timed sleep.
      codegen_util::cg_emit_line(out, "  ; sched_sleep: B.4 suspend-park (freestanding non-async; event-wake, not timed)")
      codegen_util::cg_emit_line(out, "  call void @__qz_effect_park_rv_store(i64 -2)")
      codegen_util::cg_emit(out, "  %ss")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".prv = call i64 @__qz_effect_suspend()")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; sched_sleep: non-async fallback via usleep")
    codegen_util::cg_emit(out, "  %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".us = mul i64 %v")
    codegen_util::cg_emit(out, ss_ms)
    codegen_util::cg_emit_line(out, ", 1000")
    codegen_util::cg_emit(out, "  %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".us32 = trunc i64 %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".us to i32")
    codegen_util::cg_emit(out, "  call i32 @usleep(i32 %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".us32)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_yield() — cooperative yield: call usleep(1) to yield CPU to other threads
  if name == "sched_yield"
    if codegen_runtime::cg_is_freestanding(state.target_triple) == 1
      # D.11 Phase 8b step 1 — freestanding maps sched_yield to the
      # kernel's yield_now() (defined in tools/baremetal/hello_x86.qz).
      # `@usleep` doesn't exist in libc_stubs.c and the kernel's task
      # park/wake is the right substrate for cooperative yields anyway.
      codegen_util::cg_emit_line(out, "  ; sched_yield: kernel yield_now() (freestanding)")
      codegen_util::cg_emit_line(out, "  call void @yield_now()")
    else
      codegen_util::cg_emit_line(out, "  ; sched_yield: cooperative yield point")
      codegen_util::cg_emit_line(out, "  call i32 @usleep(i32 1)")
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # fuel_check() — P21 preemptive scheduling: decrement TLS fuel, yield if empty
  if name == "fuel_check"
    codegen_util::cg_emit_line(out, "  ; fuel_check: BEAM-style reduction counting")
    codegen_util::cg_emit(out, "  %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fuel = load i64, ptr @__qz_sched_fuel")
    codegen_util::cg_emit(out, "  %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dec = sub i64 %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fuel, 1")
    codegen_util::cg_emit(out, "  store i64 %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dec, ptr @__qz_sched_fuel")
    codegen_util::cg_emit(out, "  %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty = icmp sle i64 %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dec, 0")
    codegen_util::cg_emit(out, "  br i1 %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".empty, label %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".yield, label %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cont")
    codegen_util::cg_emit(out, "fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".yield:")
    codegen_util::cg_emit_line(out, "  call void @__qz_fuel_refill()")
    codegen_util::cg_emit(out, "  br label %fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cont")
    codegen_util::cg_emit(out, "fc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cont:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_register_io(fd, task) — register fd with I/O poller, store task for wake
  if name == "sched_register_io"
    var a0 = args[0]
    var a1 = args[1]
    codegen_util::cg_emit_line(out, "  ; sched_register_io: register fd for I/O wakeup")
    codegen_util::cg_emit(out, "  call void @__qz_sched_register_io(i64 %v")
    codegen_util::cg_emit_int(out, a0)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, a1)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_register_proc(pid, task) — register child pid with I/O poller via
  # pidfd_open (Linux) or kevent EVFILT_PROC (macOS). Stores task for wake when
  # the child exits. Auto-initializes the scheduler.
  if name == "sched_register_proc"
    var srp_a0 = args[0]
    var srp_a1 = args[1]
    codegen_util::cg_emit_line(out, "  ; sched_register_proc: auto-init + register pid for exit wakeup")
    codegen_util::cg_emit_line(out, "  %srp" + d + ".init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit_line(out, "  %srp" + d + ".init.v = load i64, ptr %srp" + d + ".init.p")
    codegen_util::cg_emit_line(out, "  %srp" + d + ".need.init = icmp eq i64 %srp" + d + ".init.v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %srp" + d + ".need.init, label %srp" + d + ".do.init, label %srp" + d + ".call")
    codegen_util::cg_emit_line(out, "srp" + d + ".do.init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %srp" + d + ".call")
    codegen_util::cg_emit_line(out, "srp" + d + ".call:")
    codegen_util::cg_emit(out, "  call void @__qz_sched_register_proc(i64 %v")
    codegen_util::cg_emit_int(out, srp_a0)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, srp_a1)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_set_max_tasks(n) — set max concurrent tasks (0 = unlimited).
  # Hosted: store n into slot 18 of the @__qz_sched array (the hosted
  # scheduler's backpressure limit). Freestanding: no-op — the kernel's
  # task pool has its own bounded NUM_TASKS limit set at boot. Without
  # the gate, any user code calling `sched_set_max_tasks` (e.g.
  # `http_serve_supervised` when `config.max_connections > 0`) under
  # x86_64-unknown-none-elf emits a GEP into the undeclared @__qz_sched
  # global and llc bails. D.11 Phase 8b / step 3.
  if name == "sched_set_max_tasks"
    var n_arg = args[0].to_s()
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; sched_set_max_tasks: no-op (freestanding — kernel NUM_TASKS is fixed)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; sched_set_max_tasks: set backpressure limit")
    codegen_util::cg_emit(out, "  %smt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p = getelementptr [20 x i64], [20 x i64]* @__qz_sched, i64 0, i64 18")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, n_arg)
    codegen_util::cg_emit(out, ", ptr %smt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_task_count() — return number of active (spawned but not completed) tasks
  if name == "sched_task_count"
    codegen_util::cg_emit_line(out, "  ; sched_task_count: read active_tasks")
    codegen_util::cg_emit(out, "  %stc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p = getelementptr [20 x i64], [20 x i64]* @__qz_sched, i64 0, i64 16")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %stc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p")
    return 1
  end

  # sched_queue_depth() — return number of tasks waiting in global queue
  if name == "sched_queue_depth"
    codegen_util::cg_emit_line(out, "  ; sched_queue_depth: read global queue count")
    codegen_util::cg_emit(out, "  %sqd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p = getelementptr [20 x i64], [20 x i64]* @__qz_sched, i64 0, i64 5")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %sqd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p")
    return 1
  end

  # sched_worker_count() — return number of worker threads
  if name == "sched_worker_count"
    codegen_util::cg_emit_line(out, "  ; sched_worker_count: read num_workers")
    codegen_util::cg_emit(out, "  %swc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p = getelementptr [20 x i64], [20 x i64]* @__qz_sched, i64 0, i64 9")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %swc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p")
    return 1
  end

  # sched_active_tasks() — return current active task count (atomic read)
  if name == "sched_active_tasks"
    codegen_util::cg_emit_line(out, "  ; sched_active_tasks: atomic read of active_tasks counter")
    codegen_util::cg_emit_line(out, "  %sat" + d + ".p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
    codegen_util::cg_emit_line(out, "  %v" + d + " = load atomic i64, ptr %sat" + d + ".p seq_cst, align 8")
    return 1
  end

  # sched_tasks_completed() — return monotonic completed-tasks counter (atomic read)
  if name == "sched_tasks_completed"
    codegen_util::cg_emit_line(out, "  ; sched_tasks_completed: atomic read of completed counter")
    codegen_util::cg_emit_line(out, "  %v" + d + " = load atomic i64, ptr @__qz_sched_completed seq_cst, align 8")
    return 1
  end

  # sched_worker_busy_ns(wid) — return cumulative busy nanoseconds for worker
  # Checks snapshot (slot[33]) first (available after sched_shutdown), falls back to live data
  if name == "sched_worker_busy_ns"
    var wid_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_worker_busy_ns: read per-worker busy_ns (snapshot or live)")
    # Check if shutdown snapshot exists (slot[33])
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".snap.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".snap.i = load i64, ptr %swbn" + d + ".snap.p")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".has.snap = icmp ne i64 %swbn" + d + ".snap.i, 0")
    codegen_util::cg_emit_line(out, "  br i1 %swbn" + d + ".has.snap, label %swbn" + d + ".use.snap, label %swbn" + d + ".use.live")
    # Snapshot path: read from packed array at snapshot[wid]
    codegen_util::cg_emit_line(out, "swbn" + d + ".use.snap:")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".snap = inttoptr i64 %swbn" + d + ".snap.i to ptr")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".snap.slot = getelementptr i64, ptr %swbn" + d + ".snap, i64 %v" + wid_arg)
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".snap.val = load i64, ptr %swbn" + d + ".snap.slot")
    codegen_util::cg_emit_line(out, "  br label %swbn" + d + ".done")
    # Live path: read from per-worker data[wid*10 + 8]
    codegen_util::cg_emit_line(out, "swbn" + d + ".use.live:")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".wd.i = load i64, ptr %swbn" + d + ".wd.p")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".wd = inttoptr i64 %swbn" + d + ".wd.i to ptr")
    # Per-worker stride is 12 i64 slots (96 bytes), busy_ns at slot [8] — must
    # match the wdata allocation (codegen_runtime.qz ~5340: nw*96) and every
    # other wdata accessor (the busy_ns writer at ~7608 and the shutdown
    # snapshot at ~9973 both use *12). A stale stride of 10 here read each
    # worker's busy_ns off the wrong slot (worker_id, cap=256, queue pointer,
    # …) for every wid>0, surfacing as pointer-like garbage interleaved with
    # real figures in /load/metrics busy_ns.
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".off = mul i64 %v" + wid_arg + ", 12")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".slot = getelementptr i64, ptr %swbn" + d + ".wd, i64 %swbn" + d + ".off")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".busy.p = getelementptr i64, ptr %swbn" + d + ".slot, i64 8")
    codegen_util::cg_emit_line(out, "  %swbn" + d + ".live.val = load i64, ptr %swbn" + d + ".busy.p")
    codegen_util::cg_emit_line(out, "  br label %swbn" + d + ".done")
    # Merge
    codegen_util::cg_emit_line(out, "swbn" + d + ".done:")
    codegen_util::cg_emit_line(out, "  %v" + d + " = phi i64 [%swbn" + d + ".snap.val, %swbn" + d + ".use.snap], [%swbn" + d + ".live.val, %swbn" + d + ".use.live]")
    return 1
  end

  # sched_enable_tracing(enabled) — enable (1) or disable (0) trace ring buffer
  if name == "sched_enable_tracing"
    var en_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_enable_tracing: toggle trace ring buffer")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".en = icmp ne i64 %v")
    codegen_util::cg_emit(out, en_arg)
    codegen_util::cg_emit_line(out, ", 0")
    codegen_util::cg_emit(out, "  br i1 %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".en, label %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_on, label %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_off")
    codegen_util::cg_emit(out, "set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_on:")
    # Allocate buffer: 65536 events * 4 slots * 8 bytes = 2097152 bytes
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf = call ptr @__qz_alloc(i64 2097152)")
    codegen_util::cg_emit(out, "  call ptr @memset(ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf, i32 0, i64 2097152)")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.i = ptrtoint ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf to i64")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 3")
    codegen_util::cg_emit(out, "  store i64 %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".buf.i, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".buf.p")
    # Allocate mutex
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx = call ptr @__qz_alloc(i64 64)")
    codegen_util::cg_emit(out, "  call ptr @memset(ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx, i32 0, i64 64)")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_init(ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx, ptr null)")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = ptrtoint ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx to i64")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 4")
    codegen_util::cg_emit(out, "  store i64 %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    # Reset head/tail
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hd.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hd.p")
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 2")
    codegen_util::cg_emit(out, "  store i64 0, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tl.p")
    # Set enabled flag LAST (after buffer is ready)
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 0")
    codegen_util::cg_emit(out, "  store i64 1, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en.p")
    codegen_util::cg_emit(out, "  br label %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_off:")
    # Disable first
    codegen_util::cg_emit(out, "  %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en2.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 0")
    codegen_util::cg_emit(out, "  store i64 0, ptr %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en2.p")
    codegen_util::cg_emit(out, "  br label %set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "set")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
