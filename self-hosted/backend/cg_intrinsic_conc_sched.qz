    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    # Not found — return 0
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_notfound:")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  br label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_ret0")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_ret0:")
