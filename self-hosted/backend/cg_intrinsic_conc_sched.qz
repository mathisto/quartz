    codegen_util::cg_emit_line(out, ".ptr, i64 2")
    codegen_util::cg_emit(out, "  %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn_i64 = load i64, ptr %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn_gep, align 8")
