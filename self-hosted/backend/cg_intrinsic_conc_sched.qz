    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tid = load i64, ptr %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tid.p")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmask = and i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tid, 4095")
