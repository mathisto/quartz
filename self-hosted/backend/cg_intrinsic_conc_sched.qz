    codegen_util::cg_emit_line(out, ".slot")
    codegen_util::cg_emit(out, "  br label %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_zero:")
    codegen_util::cg_emit(out, "  br label %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_read], [0, %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_zero]")
    return 1
