  # sched_read_traces(max_count) — read up to max_count events, return Vec<Int> (flat: 4 ints per event)
  if name == "sched_read_traces"
    var max_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_read_traces: read events from ring buffer")
    # Allocate result Vec
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec = call i64 @qz_vec_new()")
