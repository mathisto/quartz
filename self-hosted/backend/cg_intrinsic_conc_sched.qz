    codegen_util::cg_emit(out, "_notfound, label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_scheck")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_scheck:")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".soff = mul i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".si, 3")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".st.gep = getelementptr i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".soff")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".st = load i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".st.gep")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmatch = icmp eq i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".st, %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tid")
    codegen_util::cg_emit(out, "  br i1 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tmatch, label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_tchk, label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_snext")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_tchk:")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sk.off = add i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".soff, 1")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sk.gep = getelementptr i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sk.off")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sk = load i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sk.gep")
    codegen_util::cg_emit(out, "  %tlg")
