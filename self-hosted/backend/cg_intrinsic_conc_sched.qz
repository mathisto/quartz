  # task_id() — return current async task's ID from frame[4] via thread-local current frame
  if name == "task_id"
    codegen_util::cg_emit_line(out, "  ; task_id: read current task ID")
    codegen_util::cg_emit(out, "  %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".frame = load i64, ptr @__qz_current_frame")
    codegen_util::cg_emit(out, "  %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has = icmp ne i64 %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".frame, 0")
    codegen_util::cg_emit(out, "  br i1 %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".has, label %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_read, label %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_zero")
    codegen_util::cg_emit(out, "ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_read:")
    codegen_util::cg_emit(out, "  %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fp = inttoptr i64 %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".frame to ptr")
    codegen_util::cg_emit(out, "  %ti")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".slot = getelementptr i64, ptr %ti")
