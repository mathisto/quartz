    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptbl.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 32")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptbl.i = load i64, ptr %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptbl.p")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptbl = inttoptr i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptbl.i to ptr")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pslot = getelementptr i64, ptr %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptbl, i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tmask")
    codegen_util::cg_emit(out, "  store i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iprio, ptr %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pslot")
