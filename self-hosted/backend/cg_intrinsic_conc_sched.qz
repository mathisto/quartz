    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr.i = load i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr = inttoptr i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.i to ptr")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = load i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Scan for matching (task_id, key) pair
    codegen_util::cg_emit(out, "  br label %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_scan")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
