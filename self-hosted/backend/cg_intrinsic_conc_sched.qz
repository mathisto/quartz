  if name == "waiter_unregister"
    var twu_target = args[0].to_s()
    var twu_waiter = args[1].to_s()
    # Freestanding twin of waiter_register — kernel_waiter_unregister(token,
    # waiter). Idempotent; returns i64 (ignored).
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; waiter_unregister: kernel active-wake table (freestanding)")
      codegen_util::cg_emit_line(out, "  %v" + d + ".wu = call i64 @kernel_waiter_unregister(i64 %v" + twu_target + ", i64 %v" + twu_waiter + ")")
      codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0  ; void result placeholder")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; waiter_unregister: remove (target, waiter) pair (hashmap-backed)")
    codegen_util::cg_emit_line(out, "  call void @__qz_waiter_unregister(i64 %v" + twu_target + ", i64 %v" + twu_waiter + ")")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0  ; void result placeholder")
    return 1
  end

  # B.7 Phase 4a: current_scope_load() — read the per-thread current Scope
  # handle from the canonical compiler-emitted TLS. Used by user-side
  # current_scope() + scope_with prev/restore.
  if name == "current_scope_load"
    codegen_util::cg_emit_line(out, "  ; current_scope_load: read per-thread Scope handle")
    codegen_util::cg_emit_line(out, "  %v" + d + " = load i64, ptr @__qz_current_scope_handle, align 8")
    return 1
  end

  # B.7 Phase 4a: current_scope_store(s) — write the per-thread current
  # Scope handle. scope_with uses this to push (s) and pop (prev). Phase
  # 4b's worker $poll dispatch writes the same TLS at poll boundaries.
  if name == "current_scope_store"
    var cs_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; current_scope_store: write per-thread Scope handle")
    codegen_util::cg_emit_line(out, "  store i64 %v" + cs_arg + ", ptr @__qz_current_scope_handle, align 8")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0  ; void result placeholder")
    return 1
  end

  # B.7 Phase 4d: scope_register_deadline(scope, abs_ns) — spawn a detached
  # pthread that sleeps until `abs_ns` then calls @_scope_fire_deadline_exceeded
