    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fd32 = trunc i64 %v")
    codegen_util::cg_emit(out, ist_fd)
    codegen_util::cg_emit_line(out, " to i32")
    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fd.p = bitcast ptr %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfd.p to ptr")
