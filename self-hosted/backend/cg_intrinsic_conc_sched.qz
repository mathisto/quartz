    codegen_util::cg_emit(out, "  %isps")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sentinel = add i64 %v")
    codegen_util::cg_emit(out, isps_val)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  store i64 %isps")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sentinel, ptr @__qz_io_pending_sleep_ms")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
