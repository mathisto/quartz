  # =========================================================================
  # M:N Scheduler intrinsics
  # =========================================================================

  # sched_init(num_workers) — initialize the M:N scheduler with N worker
  # threads. Hosted: call @__qz_sched_init (which provisions the pthread
  # pool + @__qz_sched array). Freestanding: no-op — the kernel boot code
  # already initialized the M:N scheduler (per-CPU rings, ready_push,
  # sched_pump_step) before any user code runs. Without the gate, any
  # user code calling sched_init (e.g. http_serve_supervised's
  # auto-init at line 3384) emits a call to the undefined hosted
  # runtime symbol. D.11 Phase 8b / step 3.
  if name == "sched_init"
    var nw_arg = args[0].to_s()
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; sched_init: no-op (freestanding — kernel already booted the scheduler)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; sched_init: initialize M:N scheduler")
    codegen_util::cg_emit(out, "  call void @__qz_sched_init(i64 %v")
    codegen_util::cg_emit(out, nw_arg)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_idle_hook_set(fn) — register a Quartz Fn(): Void called once per
  # scheduler I/O poll iteration. Auto-initializes the scheduler so the I/O
  # poller thread is running. Replaces any previously-registered hook.
  # The function value uses the standard tagged-pointer convention; the I/O
  # poller dispatches plain fn vs closure at call time.
  if name == "sched_idle_hook_set"
    var ih_fn_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_idle_hook_set: auto-init + store fn ptr in slot 35")
    codegen_util::cg_emit_line(out, "  %ihs" + d + ".init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit_line(out, "  %ihs" + d + ".init.v = load i64, ptr %ihs" + d + ".init.p")
    codegen_util::cg_emit_line(out, "  %ihs" + d + ".need.init = icmp eq i64 %ihs" + d + ".init.v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ihs" + d + ".need.init, label %ihs" + d + ".do.init, label %ihs" + d + ".store")
    codegen_util::cg_emit_line(out, "ihs" + d + ".do.init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %ihs" + d + ".store")
    codegen_util::cg_emit_line(out, "ihs" + d + ".store:")
    codegen_util::cg_emit_line(out, "  %ihs" + d + ".slot = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 35")
    codegen_util::cg_emit_line(out, "  store atomic i64 %v" + ih_fn_arg + ", ptr %ihs" + d + ".slot seq_cst, align 8")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0")
    return 1
  end

