    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sv.off = add i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".soff, 2")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sv.gep = getelementptr i64, ptr %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sv.off")
