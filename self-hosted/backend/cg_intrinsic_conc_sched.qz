    codegen_util::cg_emit_line(out, ".env = call ptr @__qz_alloc(i64 16)")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, srd_scope)
    codegen_util::cg_emit(out, ", ptr %srd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env, align 8")
    codegen_util::cg_emit(out, "  %srd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dl.gep = getelementptr i64, ptr %srd")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, srd_abs)
    codegen_util::cg_emit(out, ", ptr %srd")
