##! # Concurrency Intrinsics: conc_sched
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import codegen_runtime
import * from str_compat

def cg_emit_conc_sched(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  if name == "mutex_new"
    var init_val = args[0].to_s()
    # Freestanding: alloc the same 72-byte handle shape but skip
    # @pthread_mutex_init. The kernel has no pthread; consumers that
    # call mutex_lock/unlock through the freestanding gates below get
    # single-threaded Get/Put semantics without thread-safety. Safe
    # under the kernel's sync-per-conn execution model
    # (`http_dyn_gsup_spawn_one` runs the body inline; see chunk B notes).
    # Layout stays byte-identical (value at offset 64) so consumer
    # code that GEPs into the Mutex layout works unchanged. D.11
    # Phase 8b / step 3.
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; mutex_new: alloc 72 bytes, no pthread init (freestanding)")
      codegen_util::cg_emit(out, "  %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 72)")
      codegen_util::cg_emit(out, "  call void @memset(ptr %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mem, i32 0, i64 72)")
      codegen_util::cg_emit(out, "  %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mem, i64 64")
      codegen_util::cg_emit(out, "  %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.p = bitcast ptr %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.gep to ptr")
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit(out, init_val)
      codegen_util::cg_emit(out, ", ptr %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.p")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = ptrtoint ptr %mx")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mem to i64")
      return 1
    end
    # Atomic-flag mutex: lock word (i64, 0=free/1=held) at offset 0, value
    # at offset 64. NOT a pthread_mutex_t — pthread mutexes are owned by the
    # acquiring OS thread, but Quartz goroutines migrate across worker threads
    # at cooperative suspend points (the async `mutex_lock` is a try-lock+yield
    # loop), so a lock acquired on worker A and released on worker B is
    # undefined behavior that corrupts glibc's mutex state → intermittent
    # multi-worker SIGSEGV. A bare atomic flag has no thread ownership, so any
    # worker can release. Matches Go's runtime mutex / tokio's async Mutex,
    # which are likewise not tied to an OS thread. The memset already zeroes
    # the flag (0 = free), so no init call is needed.
    codegen_util::cg_emit_line(out, "  ; mutex_new: alloc 72 bytes; atomic-flag lock at off 0, value at off 64")
    codegen_util::cg_emit(out, "  %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem = call ptr @__qz_alloc(i64 72)")
    codegen_util::cg_emit(out, "  call void @memset(ptr %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i32 0, i64 72)")
    codegen_util::cg_emit(out, "  %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem, i64 64")
    codegen_util::cg_emit(out, "  %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, init_val)
    codegen_util::cg_emit(out, ", ptr %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %mx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mem to i64")
    return 1
  end

  if name == "mutex_lock"
    var mx = args[0].to_s()
    # Freestanding: skip @pthread_mutex_lock (no pthread in the kernel);
    # just load the protected value from offset 64. Single-threaded Get
    # semantics — safe under sync-per-conn execution. See `mutex_new`
    # gate above for the layout invariant. D.11 Phase 8b / step 3.
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; mutex_lock: load protected value (freestanding, no pthread)")
      codegen_util::cg_emit(out, "  %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
      codegen_util::cg_emit(out, mx)
      codegen_util::cg_emit_line(out, " to ptr")
      codegen_util::cg_emit(out, "  %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mx, i64 64")
      codegen_util::cg_emit(out, "  %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.p = bitcast ptr %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.gep to ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, " = load i64, ptr %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.p")
      return 1
    end
    # Sync (non-async) mutex_lock: spin on the atomic flag, yielding the OS
    # thread between attempts. Layout-consistent with the async try-lock path
    # (cmpxchg 0->1 at offset 0) so a mutex acquired in one context and
    # released in another interoperates. Sync contention is brief (setup /
    # worker-prelude paths); sched_yield avoids burning a core. acquire
    # ordering on success publishes the protected data on release.
    codegen_util::cg_emit_line(out, "  ; mutex_lock: acquire atomic-flag lock (spin+yield), return protected value")
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flag = getelementptr i8, ptr %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 0")
    codegen_util::cg_emit(out, "  br label %ml_spin_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ml_spin_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cx = cmpxchg ptr %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flag, i64 0, i64 1 acquire monotonic")
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = extractvalue { i64, i1 } %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cx, 1")
    codegen_util::cg_emit(out, "  br i1 %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok, label %ml_got_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ml_retry_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ml_retry_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_line(out, "  call i32 @sched_yield()")
    codegen_util::cg_emit(out, "  br label %ml_spin_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ml_got_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Race detector: acquire after mutex lock
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_acquire(ptr %ml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mx)")
    end
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 64")
    codegen_util::cg_emit(out, "  %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load i64, ptr %ml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    return 1
  end

  if name == "mutex_unlock"
    var mx = args[0].to_s()
    var new_val = args[1].to_s()
    # Freestanding: store the new value, skip @pthread_mutex_unlock and
    # the @__qz_waiter_notify_all callback (no MutexTrySelectable waiters
    # registered against this mutex in the kernel today; if a future
    # consumer needs it, route to kernel_waiter_wake_all). Single-threaded
    # Put semantics. See `mutex_new` gate for the layout invariant.
    # D.11 Phase 8b / step 3.
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; mutex_unlock: store new value (freestanding, no pthread, no waiter notify)")
      codegen_util::cg_emit(out, "  %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
      codegen_util::cg_emit(out, mx)
      codegen_util::cg_emit_line(out, " to ptr")
      codegen_util::cg_emit(out, "  %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mx, i64 64")
      codegen_util::cg_emit(out, "  %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".val.p = bitcast ptr %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.gep to ptr")
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit(out, new_val)
      codegen_util::cg_emit(out, ", ptr %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".val.p")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; mutex_unlock: store new value, release lock")
    codegen_util::cg_emit(out, "  %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 64")
    codegen_util::cg_emit(out, "  %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, new_val)
    codegen_util::cg_emit(out, ", ptr %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flag = getelementptr i8, ptr %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 0")
    # Race detector: release before mutex unlock
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_release(ptr %mu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".mx)")
    end
    # Release the atomic flag (store 0). `release` ordering publishes the
    # value-slot write above + any protected data to the next acquirer. No
    # thread ownership, so this is safe from any worker the goroutine landed on.
    codegen_util::cg_emit(out, "  store atomic i64 0, ptr %mu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flag release, align 8")
    # C.13 Phase 5: wake any MutexTrySelectable arms parked on this mutex.
    # Reuses the resource-waiter side-table — the "target" key is just an
    # i64, so a mutex handle works the same way as a task frame. Wakes fire
    # AFTER pthread_mutex_unlock so a woken waiter can immediately acquire.
    codegen_util::cg_emit(out, "  call void @__qz_waiter_notify_all(i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # pthread_mtx_lock(imtx): raw pthread_mutex_lock with no value-slot load.
  # Used by mir_emit_async_mutex_lock / mir_emit_async_rwlock_{read,write}
  # for their internal wait-list mutex, which is a bare pthread_mutex_t —
  # not a Quartz Mutex<T> struct. Race-detector acquire matches mutex_lock:
  # acquire hook fires AFTER the pthread lock succeeds.
  if name == "pthread_mtx_lock"
    var mx = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; pthread_mtx_lock: raw pthread_mutex_lock (no value slot)")
    codegen_util::cg_emit(out, "  %pml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %pml")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p)")
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_acquire(ptr %pml")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".p)")
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # pthread_mtx_unlock(imtx): raw pthread_mutex_unlock with no value-slot
  # store. Paired with pthread_mtx_lock. Race-detector release matches
  # mutex_unlock: release hook fires BEFORE the pthread unlock.
  if name == "pthread_mtx_unlock"
    var mx = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; pthread_mtx_unlock: raw pthread_mutex_unlock (no value slot)")
    codegen_util::cg_emit(out, "  %pmu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    if state.race_mode == 1
      codegen_util::cg_emit(out, "  call void @__qz_race_release(ptr %pmu")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".p)")
    end
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %pmu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "mutex_try_lock"
    var mx = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; mutex_try_lock: non-blocking, returns value or -1 if locked")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mx = inttoptr i64 %v")
    codegen_util::cg_emit(out, mx)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".flag = getelementptr i8, ptr %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 0")
    # CAS the atomic flag 0 -> 1. Success (acquire ordering) = we hold the
    # lock; failure = contended. No thread ownership — the cooperative async
    # mutex_lock loop calls this from whatever worker the goroutine resumed on.
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cx = cmpxchg ptr %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".flag, i64 0, i64 1 acquire monotonic")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok = extractvalue { i64, i1 } %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cx, 1")
    codegen_util::cg_emit(out, "  br i1 %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ok, label %mtl_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %mtl_fail_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "mtl_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %mtl_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "mtl_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.gep = getelementptr i8, ptr %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mx, i64 64")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val.p = bitcast ptr %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.gep to ptr")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load i64, ptr %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val.p")
    codegen_util::cg_emit(out, "  br label %mtl_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "mtl_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res = phi i64 [ -1, %mtl_fail_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, %mtl_ok_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %mtl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".res, 0")
    return 1
  end

  # io_suspend(fd) — outside async $poll context, this is a no-op returning 0.
  # Inside async $poll, the MIR lowering handles it via save/return/resume blocks;
  # this codegen path only handles the non-async fallback.
  if name == "io_suspend"
    codegen_util::cg_emit_line(out, "  ; io_suspend: no-op outside async context")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # proc_suspend(pid) — outside async $poll context, this is a no-op returning 0.
  # Inside async $poll, MIR lowering sets the pending-proc TLS flag and emits a
  # suspend point whose fd slot actually holds the pid; worker task_io_real
  # dispatches to __qz_sched_register_proc when the flag is set.
  if name == "proc_suspend"
    codegen_util::cg_emit_line(out, "  ; proc_suspend: no-op outside async context")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # io_suspend_timeout(fd, timeout_ms, events) — non-async fallback uses POSIX poll().
  # Inside async $poll, MIR lowering stores TLS + suspends; this path only handles non-async.
  if name == "io_suspend_timeout"
    var ist_fd = args[0].to_s()
    var ist_tmo = args[1].to_s()
    var ist_ev = args[2].to_s()
    codegen_util::cg_emit_line(out, "  ; io_suspend_timeout: non-async fallback via poll()")
    # Allocate pollfd struct (8 bytes: i32 fd, i16 events, i16 revents)
    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfd = alloca [8 x i8]")
    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfd.p = bitcast [8 x i8]* %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfd to ptr")
    codegen_util::cg_emit(out, "  call void @memset(ptr %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfd.p, i32 0, i64 8)")
