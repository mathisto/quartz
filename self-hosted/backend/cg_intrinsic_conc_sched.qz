  # this takes a pre-existing async task frame (e.g., from `async expr`).
  # Used by the HTTP server to spawn connection handlers at elevated priority.
  if name == "sched_spawn_priority"
    var sp_task_arg = args[0].to_s()
    var sp_level_arg = args[1].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_spawn_priority: auto-init + set priority + spawn pre-built frame")
    # Auto-initialize scheduler if needed
    codegen_util::cg_emit_line(out, "  %sp" + d + ".init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".init.v = load i64, ptr %sp" + d + ".init.p")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".need.init = icmp eq i64 %sp" + d + ".init.v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %sp" + d + ".need.init, label %sp" + d + ".do.init, label %sp" + d + ".set.prio")
    codegen_util::cg_emit_line(out, "sp" + d + ".do.init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %sp" + d + ".set.prio")
    codegen_util::cg_emit_line(out, "sp" + d + ".set.prio:")
    # Map user level to internal: 0→1(CRITICAL), 1→2(HIGH), 2→0(NORMAL), 3→3(LOW)
    codegen_util::cg_emit_line(out, "  %sp" + d + ".is0 = icmp eq i64 %v" + sp_level_arg + ", 0")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".is1 = icmp eq i64 %v" + sp_level_arg + ", 1")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".is3 = icmp eq i64 %v" + sp_level_arg + ", 3")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".s1 = select i1 %sp" + d + ".is0, i64 1, i64 0")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".s2 = select i1 %sp" + d + ".is1, i64 2, i64 %sp" + d + ".s1")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".iprio = select i1 %sp" + d + ".is3, i64 3, i64 %sp" + d + ".s2")
    # Extract task_id from frame[4], mask with 4095
    codegen_util::cg_emit_line(out, "  %sp" + d + ".frame = inttoptr i64 %v" + sp_task_arg + " to ptr")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".tid.p = getelementptr i64, ptr %sp" + d + ".frame, i64 4")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".tid = load i64, ptr %sp" + d + ".tid.p")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".tmask = and i64 %sp" + d + ".tid, 4095")
    # Store priority in table
    codegen_util::cg_emit_line(out, "  %sp" + d + ".ptbl.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 32")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".ptbl.i = load i64, ptr %sp" + d + ".ptbl.p")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".ptbl = inttoptr i64 %sp" + d + ".ptbl.i to ptr")
    codegen_util::cg_emit_line(out, "  %sp" + d + ".pslot = getelementptr i64, ptr %sp" + d + ".ptbl, i64 %sp" + d + ".tmask")
    codegen_util::cg_emit_line(out, "  store i64 %sp" + d + ".iprio, ptr %sp" + d + ".pslot")
    # Call sched_spawn (reads priority from table and routes to correct queue)
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_spawn(i64 %v" + sp_task_arg + ")")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0")
    return 1
  end

  if name == "sched_spawn"
    var task_arg = args[0].to_s()
    # Freestanding: no-op. On the kernel the `async fn(args)` / `go fn()` that
    # produced this handle ALREADY spawned a live goroutine — the freestanding
    # async lowering routes through go_fn / kern_go_closure (task_alloc + seeded
    # stack + ready_push) and returns a running kernel task handle (mir_lower.qz
    # ~2558-2579). The handle is already on the scheduler's ready ring, so a
    # second enqueue here would be a double-spawn. (Same shape as the B.5e.4
    # spurious-perform suppression.) The hosted body below is the pthread
    # multi-worker deque enqueue, which references @__qz_current_worker_id /
    # @__qz_sched_local_push / @pthread_cond_signal — none defined in the kernel.
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; sched_spawn: no-op (freestanding — async/go already task_alloc'd + ready_push'd)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; sched_spawn: auto-init + enqueue task frame onto scheduler")
    # Auto-initialize scheduler if not yet initialized (slot [10] = initialized flag)
    codegen_util::cg_emit(out, "  %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit(out, "  %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".init.v = load i64, ptr %ss" + d + ".init.p")
    codegen_util::cg_emit(out, "  %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".need.init = icmp eq i64 %ss" + d + ".init.v, 0")
    codegen_util::cg_emit(out, "  br i1 %ss")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".need.init, label %ss" + d + ".do.init, label %ss" + d + ".spawn")
    codegen_util::cg_emit_line(out, "ss" + d + ".do.init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %ss" + d + ".spawn")
    codegen_util::cg_emit_line(out, "ss" + d + ".spawn:")
    # A.27: capture parent's user-installed effect handlers at spawn time
    # and register them against this task's frame, mirroring do_spawn in
    # cg_emit_async_spawn_handler (codegen_runtime.qz:768). The worker
    # poll-dispatch site (codegen_runtime.qz:5343) looks up the snapshot
    # and applies it before each $poll call, so an `await` performed inside
    # the spawned task body dispatches the parent's `with Async { await: h }`
    # handler instead of the builtin default. Without this, sched_spawn'd
    # tasks (the direct-intrinsic spawn path — distinct from `go f()`'s
    # perform(Async, spawn) path) silently lost handler inheritance.
    # snapshot_capture returns 0 (and register no-ops on the lookup side)
    # when no handlers sit above the blessed watermark, so handler-free
    # spawns pay nothing.
    codegen_util::cg_emit_line(out, "  %ss" + d + ".snap.i = call i64 @__qz_effect_snapshot_capture()")
    codegen_util::cg_emit(out, "  call void @__qz_task_snapshot_register(i64 %v")
    codegen_util::cg_emit(out, task_arg)
    codegen_util::cg_emit_line(out, ", i64 %ss" + d + ".snap.i)")
    # B.7 Phase 5 Bucket 1: capture current_scope at spawn time so go_spawn-
    # spawned tasks (and other sched_spawn callers — go_arena, go_cancellable,
    # go_cancel_on_success, _go_race_run) inherit scope. Mirrors do_spawn: in
    # cg_emit_async_spawn_handler at codegen_runtime.qz:745. Without this, the
    # new structured-concurrency wrappers can't observe parent scope from the
    # go_spawn body — children load root scope at poll entry. Idempotent +
    # mutex-internal + no-ops on scope==0, so root-scope spawns pay no cost.
    codegen_util::cg_emit_line(out, "  %ss" + d + ".scope.i = load i64, ptr @__qz_current_scope_handle, align 8")
    codegen_util::cg_emit(out, "  call void @__qz_task_scope_set(i64 %v")
    codegen_util::cg_emit(out, task_arg)
    codegen_util::cg_emit_line(out, ", i64 %ss" + d + ".scope.i)")
    # Phase 3: Spawn fast path — push to local deque if on worker thread
    codegen_util::cg_emit_line(out, "  %ss" + d + ".wid = load i64, ptr @__qz_current_worker_id")
    codegen_util::cg_emit_line(out, "  %ss" + d + ".is_worker = icmp sge i64 %ss" + d + ".wid, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ss" + d + ".is_worker, label %ss" + d + ".local, label %ss" + d + ".global")
    codegen_util::cg_emit_line(out, "ss" + d + ".local:")
    # Atomic active_tasks++ then push to local deque (no global mutex)
    codegen_util::cg_emit_line(out, "  %ss" + d + ".at.p = getelementptr i64, ptr @__qz_sched, i64 16")
    codegen_util::cg_emit_line(out, "  %ss" + d + ".at.old = atomicrmw add ptr %ss" + d + ".at.p, i64 1 seq_cst")
    codegen_util::cg_emit(out, "  call void @__qz_sched_local_push(i64 %ss" + d + ".wid, i64 %v")
    codegen_util::cg_emit(out, task_arg)
    codegen_util::cg_emit_line(out, ")")
    # Signal one idle worker (cond_signal, not broadcast)
    codegen_util::cg_emit_line(out, "  %ss" + d + ".cv.p = getelementptr i64, ptr @__qz_sched, i64 7")
    codegen_util::cg_emit_line(out, "  %ss" + d + ".cv.i = load i64, ptr %ss" + d + ".cv.p")
    codegen_util::cg_emit_line(out, "  %ss" + d + ".cv = inttoptr i64 %ss" + d + ".cv.i to ptr")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_signal(ptr %ss" + d + ".cv)")
    codegen_util::cg_emit_line(out, "  br label %ss" + d + ".done")
    codegen_util::cg_emit_line(out, "ss" + d + ".global:")
    # Main thread or non-worker: use global __qz_sched_spawn (takes mutex)
    codegen_util::cg_emit(out, "  call void @__qz_sched_spawn(i64 %v")
    codegen_util::cg_emit(out, task_arg)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit_line(out, "  br label %ss" + d + ".done")
    codegen_util::cg_emit_line(out, "ss" + d + ".done:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_shutdown() — drain scheduler queue, join workers. Hosted: call
  # @__qz_sched_shutdown to stop the pthread pool. Freestanding: no-op —
  # the kernel scheduler runs for the lifetime of the unikernel; user code
  # never tears it down. Without the gate, http_serve_supervised's
  # shutdown path emits a call to the undefined runtime symbol.
  # D.11 Phase 8b / step 3.
  if name == "sched_shutdown"
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; sched_shutdown: no-op (freestanding — kernel scheduler runs forever)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, " = add i64 0, 0")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; sched_shutdown: stop scheduler")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_shutdown()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # sched_shutdown_graceful(timeout_ms) — timed drain, returns 0=clean 1=timeout
  if name == "sched_shutdown_graceful"
    var timeout = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; sched_shutdown_graceful: timed shutdown")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @__qz_sched_shutdown_graceful(i64 %v")
    codegen_util::cg_emit(out, timeout)
    codegen_util::cg_emit_line(out, ")")
    return 1
  end

  # sched_shutdown_requested() — returns 1 if SIGTERM/SIGINT was received
  if name == "sched_shutdown_requested"
    codegen_util::cg_emit_line(out, "  ; sched_shutdown_requested: check signal flag")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = load i64, ptr @__qz_signal_shutdown")
    return 1
  end

  # sched_shutdown_on_signal() — install SIGTERM/SIGINT handlers for auto-shutdown
  if name == "sched_shutdown_on_signal"
    codegen_util::cg_emit_line(out, "  ; sched_shutdown_on_signal: install signal handlers")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_shutdown_on_signal()")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # =========================================================================
  # Completion notification intrinsics
  # =========================================================================

  # completion_watch(task_frame) — create pipe, register (task, wfd) in map, return rfd
  if name == "completion_watch"
    var tf_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; completion_watch: create notification pipe for task completion")
    # Create pipe
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pipe = alloca [2 x i32]")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pp = bitcast [2 x i32]* %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pipe to ptr")
    codegen_util::cg_emit(out, "  call i32 @pipe(ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp)")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd32 = load i32, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wgep = getelementptr i32, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp, i64 1")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = load i32, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wgep")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd = sext i32 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd32 to i64")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd = sext i32 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd32 to i64")
    # Lock completion map mutex
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # Load count and array pointer
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = load i64, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr.i = load i64, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr = inttoptr i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.i to ptr")
    # Store pair at index count*2
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = mul i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 2")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tf.gep = getelementptr i64, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, tf_arg)
    codegen_util::cg_emit(out, ", ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep")
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd.gep = getelementptr i64, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep, i64 1")
    codegen_util::cg_emit(out, "  store i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd.gep")
    # Increment count
    codegen_util::cg_emit(out, "  %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.inc = add i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 1")
    codegen_util::cg_emit(out, "  store i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt.inc, ptr %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
