  if name == "sched_idle_hook_clear"
    codegen_util::cg_emit_line(out, "  ; sched_idle_hook_clear: store 0 in slot 35")
    codegen_util::cg_emit_line(out, "  %ihc" + d + ".slot = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 35")
    codegen_util::cg_emit_line(out, "  store atomic i64 0, ptr %ihc" + d + ".slot seq_cst, align 8")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0")
    return 1
  end

  # sched_spawn(task_frame) — enqueue async task frame onto scheduler queue
  # Phase 13: go_priority(task_frame, level) — set priority then spawn
  # Internal encoding: 0=CRITICAL→1, 1=HIGH→2, 2=NORMAL→0, 3=LOW→3
  if name == "go_priority"
    var task_arg = args[0].to_s()
    var level_arg = args[1].to_s()
    codegen_util::cg_emit_line(out, "  ; go_priority: auto-init + set priority in table, then sched_spawn")
    # Auto-initialize scheduler if needed (priority table is allocated in sched_init)
    codegen_util::cg_emit_line(out, "  %gp" + d + ".init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit_line(out, "  %gp" + d + ".init.v = load i64, ptr %gp" + d + ".init.p")
    codegen_util::cg_emit_line(out, "  %gp" + d + ".need.init = icmp eq i64 %gp" + d + ".init.v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %gp" + d + ".need.init, label %gp" + d + ".do.init, label %gp" + d + ".set.prio")
    codegen_util::cg_emit_line(out, "gp" + d + ".do.init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %gp" + d + ".set.prio")
    codegen_util::cg_emit_line(out, "gp" + d + ".set.prio:")
