    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %tls")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %tls")
