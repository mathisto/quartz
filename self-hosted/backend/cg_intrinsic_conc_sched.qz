    codegen_util::cg_emit_line(out, "_snext")
    codegen_util::cg_emit(out, "tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_snext:")
    codegen_util::cg_emit(out, "  %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".si.next = add i64 %tlg")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".si, 1")
