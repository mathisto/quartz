  # task_self() — return the current task's identity for select-arm waker
  # registration. Hosted: load frame pointer from TLS-equivalent global
  # @__qz_current_frame (set by the scheduler on task switch). Freestanding:
  # call the kernel's `sched_current()` which loads from the per-CPU GS-base
  # slot `PCPU_CURRENT_TASK`. The select-arm lowering passes this value as
  # the waker key to `<Selectable>$register_waker`; freestanding waker
  # side-tables (Phase 8a step 5 / commit 2c532f23) key on task pointer,
  # so emitting `sched_current()` keeps the wake-from-`chan_send` ↔
  # `select` arm contract self-consistent. Without this gate the kernel
  # build errors with `use of undefined value '@__qz_current_frame'` once
  # http_serve_supervised (or any user code with a `select` arm) enters
  # the live IR.
  if name == "task_self"
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; task_self: kernel sched_current() (freestanding)")
      codegen_util::cg_emit_line(out, "  %v" + d + " = call i64 @sched_current()")
    else
      codegen_util::cg_emit_line(out, "  ; task_self: load current task frame pointer")
      codegen_util::cg_emit_line(out, "  %v" + d + " = load i64, ptr @__qz_current_frame")
    end
    return 1
  end

  # C.13 Phase 5 — waiter_register(target, waiter_frame): append the
  # (target, waiter) pair to the resource-waiter side-table. When `target`
  # later notifies (task_done / mutex unlock / channel state-change / etc.),
  # `__qz_waiter_notify_all` calls `sched_wake(waiter)` for every matching
  # entry. Idempotent — same pair registered twice stays once.
  # Target is a kind-tagged i64 key:
  #   task handle              — bit 0 clear (single-event resource)
  #   mutex/rwlock handle      — bit 0 clear
  #   channel handle | 0       — read-waiters (recv-side)
  #   channel handle | 1       — write-waiters (send-side)
  if name == "waiter_register"
    var twr_target = args[0].to_s()
    var twr_waiter = args[1].to_s()
    # Freestanding: route to the kernel's active-wake table. The hosted
    # @__qz_waiter_register lives past the freestanding early-return in
    # cg_emit_runtime_decls; the kernel instead supplies kernel_waiter_register
    # (token, waiter) — the same primitive b5c_waiter_body and the supervisor
    # close-event wake use. channel_close freestanding wakes via
    # kernel_waiter_wake_all(token), so registering on `inbox | CLOSE_EVENT_BIT`
    # gives the watcher its ~0ms active wake; the watcher's SUPERVISOR_PARK_MS
    # long-poll is the fallback if a wake is ever missed. Returns i64 (ignored).
    if codegen_util::cg_state_is_freestanding(state) == 1
      codegen_util::cg_emit_line(out, "  ; waiter_register: kernel active-wake table (freestanding)")
      codegen_util::cg_emit_line(out, "  %v" + d + ".wr = call i64 @kernel_waiter_register(i64 %v" + twr_target + ", i64 %v" + twr_waiter + ")")
      codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0  ; void result placeholder")
      return 1
    end
    codegen_util::cg_emit_line(out, "  ; waiter_register: queue sched_wake on target notify (hashmap-backed)")
    codegen_util::cg_emit_line(out, "  call void @__qz_waiter_register(i64 %v" + twr_target + ", i64 %v" + twr_waiter + ")")
    codegen_util::cg_emit_line(out, "  %v" + d + " = add i64 0, 0  ; void result placeholder")
    return 1
  end

