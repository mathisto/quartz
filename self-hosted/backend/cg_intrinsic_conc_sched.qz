    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".en = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en.p")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".on = icmp ne i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".en, 0")
    codegen_util::cg_emit(out, "  br i1 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".on, label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_read, label %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_read:")
    # Lock mutex
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 4")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %srt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
