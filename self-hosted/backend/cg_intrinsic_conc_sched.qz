  # io_set_pending_timeout(val) — store to TLS for worker thread dispatch
  if name == "io_set_pending_timeout"
    var ispt_val = args[0].to_s()
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, ispt_val)
    codegen_util::cg_emit_line(out, ", ptr @__qz_io_pending_timeout")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
