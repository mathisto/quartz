    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit(out, fa)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn_gep = getelementptr inbounds i64, ptr %fp")
