    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %cw")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd, 0")
    return 1
  end

  # completion_unwatch(task_frame) — remove entry from map, close pipe fds
  if name == "completion_unwatch"
    var tf_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; completion_unwatch: remove completion watcher")
    # Lock completion map mutex
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr.i = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr = inttoptr i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.i to ptr")
    # Scan for matching task frame, swap with last entry, close fds
    codegen_util::cg_emit(out, "  br label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_entry")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop:")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_entry], [%cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.next, %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next]")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.done = icmp uge i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt")
    codegen_util::cg_emit(out, "  br i1 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.done, label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_done, label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_check")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_entry:")
    codegen_util::cg_emit(out, "  br label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_check:")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = mul i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 2")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tf.gep = getelementptr i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tf = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".match = icmp eq i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tf, %v")
    codegen_util::cg_emit_line(out, tf_arg)
    codegen_util::cg_emit(out, "  br i1 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".match, label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_remove, label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_remove:")
    # Close the write fd
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd.gep = getelementptr i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep, i64 1")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd.gep")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = trunc i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd to i32")
    codegen_util::cg_emit(out, "  call i32 @close(i32 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd32)")
    # Swap with last entry: copy last pair over this one
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".last = sub i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt, 1")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".last.off = mul i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".last, 2")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt.gep = getelementptr i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".last.off")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt.tf = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lt.gep")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lw.gep = getelementptr i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lt.gep, i64 1")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt.wfd = load i64, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".lw.gep")
    codegen_util::cg_emit(out, "  store i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt.tf, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep")
    codegen_util::cg_emit(out, "  store i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".lt.wfd, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd.gep")
    # Decrement count
    codegen_util::cg_emit(out, "  store i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".last, ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  br label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next:")
    codegen_util::cg_emit(out, "  %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i.next = add i64 %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %cu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  # completion_watch_multi(tasks_vec) — watch N tasks sharing 1 pipe, return rfd
  if name == "completion_watch_multi"
    var vec_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; completion_watch_multi: watch multiple tasks on shared pipe")
    # Create pipe
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pipe = alloca [2 x i32]")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pp = bitcast [2 x i32]* %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pipe to ptr")
    codegen_util::cg_emit(out, "  call i32 @pipe(ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp)")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd32 = load i32, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wgep = getelementptr i32, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp, i64 1")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd32 = load i32, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wgep")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".rfd = sext i32 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd32 to i64")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd = sext i32 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd32 to i64")
    # Lock completion map mutex
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # Get vec length: Vec layout is [ptr, len, cap] as i64* at offset 0, 1, 2
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vp = inttoptr i64 %v")
    codegen_util::cg_emit(out, vec_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata.i = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vp")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata = inttoptr i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vdata.i to ptr")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen.gep = getelementptr i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vp, i64 1")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vlen = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen.gep")
    # Load completion map state
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt0 = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 0")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr.i = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.p")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr = inttoptr i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".arr.i to ptr")
    # Loop: register each task in the vec
    codegen_util::cg_emit(out, "  br label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_entry2")
    codegen_util::cg_emit(out, "cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop:")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j = phi i64 [0, %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_entry2], [%cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j.next, %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next]")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".curcount = phi i64 [%cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cnt0, %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_entry2], [%cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".curcount.inc, %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next]")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j.done = icmp uge i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j, %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vlen")
    codegen_util::cg_emit(out, "  br i1 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j.done, label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "_done, label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_body")
    codegen_util::cg_emit(out, "cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_entry2:")
    codegen_util::cg_emit(out, "  br label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_body:")
    # Load task frame from vec[j]
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".task.gep = getelementptr i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vdata, i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".j")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".task = load i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".task.gep")
    # Store pair at curcount*2
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = mul i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".curcount, 2")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tf.gep = getelementptr i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr, i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  store i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".task, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd.gep = getelementptr i64, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".tf.gep, i64 1")
    codegen_util::cg_emit(out, "  store i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wfd, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wfd.gep")
    codegen_util::cg_emit(out, "  br label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next")
    codegen_util::cg_emit(out, "cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_next:")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".j.next = add i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".j, 1")
    codegen_util::cg_emit(out, "  %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".curcount.inc = add i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".curcount, 1")
    codegen_util::cg_emit(out, "  br label %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_loop")
    codegen_util::cg_emit(out, "cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "_done:")
    # Store new count: %curcount is the loop-carry phi from _loop (sole pred of _done),
    # holds cnt0 + N after all N iterations registered through _next.
    codegen_util::cg_emit(out, "  store i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".curcount, ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p")
    # Unlock
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_unlock(ptr %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    # Return read fd
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = add i64 %cwm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".rfd, 0")
    return 1
  end

  # completion_unwatch_all(tasks_vec) — remove all entries for tasks in vec, close pipe
  if name == "completion_unwatch_all"
    var vec_arg = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; completion_unwatch_all: batch remove completion watchers")
    # Lock completion map mutex
    codegen_util::cg_emit(out, "  %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
    codegen_util::cg_emit(out, "  %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx.i = load i64, ptr %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.p")
    codegen_util::cg_emit(out, "  %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".mtx = inttoptr i64 %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx.i to ptr")
    codegen_util::cg_emit(out, "  call i32 @pthread_mutex_lock(ptr %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".mtx)")
    codegen_util::cg_emit(out, "  %cua")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 1")
    codegen_util::cg_emit(out, "  %cua")
    codegen_util::cg_emit(out, d)
