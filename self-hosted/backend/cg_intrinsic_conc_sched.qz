    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1 = select i1 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".is0, i64 1, i64 0")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2 = select i1 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is1, i64 2, i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s1")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".iprio = select i1 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is3, i64 3, i64 %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2")
