    # Formula: (level + 1) % 4 maps: 0→1, 1→2, 2→3, 3→0... no. Direct comparison chain.
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is0 = icmp eq i64 %v")
    codegen_util::cg_emit(out, level_arg)
    codegen_util::cg_emit_line(out, ", 0")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is1 = icmp eq i64 %v")
    codegen_util::cg_emit(out, level_arg)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is3 = icmp eq i64 %v")
    codegen_util::cg_emit(out, level_arg)
    codegen_util::cg_emit_line(out, ", 3")
