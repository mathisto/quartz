    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".frame = inttoptr i64 %v")
    codegen_util::cg_emit(out, task_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %gp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".tid.p = getelementptr i64, ptr %gp")
    codegen_util::cg_emit(out, d)
