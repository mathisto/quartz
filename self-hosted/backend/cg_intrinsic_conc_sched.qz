    codegen_util::cg_emit(out, "  %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_eager = icmp eq i64 %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn_i64, 0")
    codegen_util::cg_emit(out, "  br i1 %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_eager, label %fp_eager_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %fp_poll_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "fp_eager_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %fp_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "fp_poll_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn = inttoptr i64 %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn_i64 to i64 (i64)*")
    codegen_util::cg_emit(out, "  %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result = call i64 %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn(i64 %v")
    codegen_util::cg_emit(out, fa)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  br label %fp_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "fp_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ 1, %fp_eager_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %fp")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".result, %fp_poll_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
