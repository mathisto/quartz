    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ev16 = trunc i64 %v")
    codegen_util::cg_emit(out, ist_ev)
    codegen_util::cg_emit_line(out, " to i16")
    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ev.p = getelementptr i8, ptr %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pfd.p, i64 4")
    codegen_util::cg_emit(out, "  %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ev.i16p = bitcast ptr %ist")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ev.p to i16*")
    codegen_util::cg_emit(out, "  store i16 %ist")
