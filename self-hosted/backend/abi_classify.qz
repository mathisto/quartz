##! # abi_classify — target C-ABI struct classification (clang `ABIInfo` analog)
##!
##! Part of the B.10 value-types epic, Phase 3 (see `docs/design/MEMORY_MODEL_V3.md`
##! §13). Decides how a struct crosses an `extern "C"` boundary on a given target:
##! register-coerced (small) vs `byval`/`sret` indirect (large). This is the
##! INTERNAL convention's C-boundary counterpart — Quartz↔Quartz calls keep the
##! `{i64 x N}` decompose-by-field path (§12.1–§12.4); only at `mir_func_is_cconv_c`
##! boundaries do we run a target's true ABI classifier.
##!
##! P3.0 (this commit) is the pure classification core + data model only:
##!   - the `AbiArgInfo` positional record (mirrors `layout_desc`'s idiom),
##!   - the System V AMD64 classifier (deploy / x86_64 — the `lovelace` oracle),
##!   - the AArch64 AAPCS classifier (host / arm64 — the native run gate, incl. HFA),
##!   - target dispatch.
##! It operates over a plain `Vec<String>` of field-type names so it is unit-testable
##! standalone (no `MirProgram` needed) — see `spec/qspec/abi_classify_spec.qz`.
##! NOT yet wired into codegen: the `prog`-side adapter (build the field list from
##! `MirProgram` + the `cg_emit_function`/`MIR_CALL` integration) and the real-C
##! link-and-run oracle land in P3.1+, where each struct case is verifiable.
##!
##! v1 scope (carried from §13): flat scalar/pointer fields only — no nested-struct
##! flattening (a struct-typed field is treated as one 8-byte INTEGER/pointer slot),
##! no over-aligned/`_Alignas` fields, no `__int128`/`long double`/vectors.
##!
##! @see layout the scalar width/float authority this delegates to
##! @see mir MirProgram struct field accessors (used by the P3.1 adapter)
##! @since 5.25.0-alpha

import layout

# ============================================================================
# AbiArgInfo kinds — how ONE param/return crosses the C boundary
# ============================================================================

## Scalar/pointer — pass as its natural LLVM type (today's behavior, unchanged).
const ABI_DIRECT = 0

## Small aggregate — pass/return as `coerce_type`; LLVM's backend assigns the
## physical registers (GP/XMM/V) from that type. We never hand-pick registers.
const ABI_COERCE = 1

## Large argument — caller copies to memory, passes a `byval(%struct.T)` pointer.
const ABI_INDIRECT_BYVAL = 2

## Large return — hidden `sret(%struct.T)` first parameter; callee stores + `ret void`.
const ABI_INDIRECT_SRET = 3

# ============================================================================
# Eightbyte classes (System V §3.2.3, reduced to Quartz's type set — no X87)
# ============================================================================

const ABI_CLASS_NONE = 0
const ABI_CLASS_INTEGER = 1
const ABI_CLASS_SSE = 2
const ABI_CLASS_MEMORY = 3

# ============================================================================
# AbiArgInfo — positional [kind, coerce_type, n_regs] (layout_desc idiom; no new
# struct type to round-trip through the qzmod cache). `coerce_type` is the LLVM
# type string for ABI_COERCE ("" for DIRECT/INDIRECT). `n_regs` is the eightbyte
# / register count an aggregate consumes (0 for DIRECT/INDIRECT).
# ============================================================================

## Build an AbiArgInfo.
def abi_info_new(kind: Int, coerce_type: String, n_regs: Int): Vec
  return [kind, coerce_type, n_regs]
end

## The ABI_* disposition.
def abi_info_kind(a: Vec): Int = a[0]

## LLVM coercion type string (only meaningful for ABI_COERCE).
def abi_info_coerce_type(a: Vec): String = as_string(a[1])

## Eightbyte / register count consumed.
def abi_info_n_regs(a: Vec): Int = a[2]

# ============================================================================
# Target dispatch — which architecture's ABI applies to a target triple
# ============================================================================

## 1 if `target` is an x86_64 triple (System V AMD64 ABI).
def abi_target_is_x86_64(target: String): Int
  return 1 if str_contains(target, "x86_64")
  return 0
end

## 1 if `target` is an aarch64/arm64 triple (AAPCS64 ABI).
def abi_target_is_aarch64(target: String): Int
  return 1 if str_contains(target, "aarch64")
  return 1 if str_contains(target, "arm64")
  return 0
end

# ============================================================================
# Layout helpers (flat scalar/pointer struct, C alignment)
# ============================================================================

## Round `x` up to a multiple of `a` (a >= 1).
def abi_round_up(x: Int, a: Int): Int
  return x if a <= 1
  return ((x + a - 1) / a) * a
end

## Padded C size in bytes of a struct given its field-type names. Each field's
## natural alignment equals its scalar size (1/2/4/8); pointers and wide scalars
## are 8. v1 treats a struct-typed field as a single 8-byte pointer slot.
def abi_struct_size(fields: Vec): Int
  var off = 0
  var max_align = 1
  for i in 0..vec_size(fields)
    var ft = as_string(fields[i])
    var sz = layout::layout_scalar_size(ft)
    off = abi_round_up(off, sz)
    off = off + sz
    if sz > max_align
      max_align = sz
    end
  end
  return abi_round_up(off, max_align)
end

## P3.4b — byte offset of field `idx` in the C (`@repr(C)`) layout: natural
## alignment per scalar size, matching `abi_struct_size`'s walk. Used by the
## boundary-repack to place each field at its true C offset (which diverges from
## Quartz's internal i64-slot layout once an F32 narrows 8→4 bytes).
def abi_field_c_offset(fields: Vec, idx: Int): Int
  var off = 0
  for i in 0..vec_size(fields)
    var ft = as_string(fields[i])
    var sz = layout::layout_scalar_size(ft)
    off = abi_round_up(off, sz)
    return off if i == idx
    off = off + sz
  end
  return off
end

## P3.4b — the C-faithful LLVM scalar type for field type `ft` at the boundary:
## F32→`float` (4 bytes, vs Quartz's internal 8-byte double-bits-in-i64),
## F64→`double`, narrow ints→`iN`, wide ints/Int→`i64`.
def abi_field_c_llvm(ft: String): String
  return "float" if ft == "F32"
  return "double" if ft == "F64"
  return "i8" if ft == "I8"
  return "i8" if ft == "U8"
  return "i16" if ft == "I16"
  return "i16" if ft == "U16"
  return "i32" if ft == "I32"
  return "i32" if ft == "U32"
  return "i64"
end

## SysV merge rule for two eightbyte classes (§3.2.3): NONE is identity,
## MEMORY dominates, then INTEGER, else SSE.
def abi_merge_class(a: Int, b: Int): Int
  return b if a == ABI_CLASS_NONE
  return a if b == ABI_CLASS_NONE
  return ABI_CLASS_MEMORY if a == ABI_CLASS_MEMORY
  return ABI_CLASS_MEMORY if b == ABI_CLASS_MEMORY
  return ABI_CLASS_INTEGER if a == ABI_CLASS_INTEGER
  return ABI_CLASS_INTEGER if b == ABI_CLASS_INTEGER
  return ABI_CLASS_SSE
end

## Classify each eightbyte of a (<=16 byte) struct. Returns Vec<Int> of
## ABI_CLASS_INTEGER/SSE — one entry per eightbyte. A field is SSE iff it is a
## float; integers, pointers, and struct-slots are INTEGER. A field straddling
## the 8-byte boundary contributes to both eightbytes (merge rule).
def abi_eightbyte_classes_sysv(fields: Vec, size: Int): Vec
  var n_eb = abi_round_up(size, 8) / 8
  var classes = vec_new()
  for e in 0..n_eb
    var cls = ABI_CLASS_NONE
    var eb_lo = e * 8
    var eb_hi = eb_lo + 8
    var off = 0
    for i in 0..vec_size(fields)
      var ft = as_string(fields[i])
      var sz = layout::layout_scalar_size(ft)
      off = abi_round_up(off, sz)
      var fstart = off
      var fend = off + sz
      off = off + sz
      if fstart < eb_hi and fend > eb_lo
        var fld = ABI_CLASS_INTEGER
        if layout::layout_scalar_is_float(ft) == 1
          fld = ABI_CLASS_SSE
        end
        cls = abi_merge_class(cls, fld)
      end
    end
    classes.push(cls)
  end
  return classes
end

## The LLVM integer type covering an eightbyte that holds `bytes` (1..8) of
## struct data (P3.4a). SysV coerces a partial trailing INTEGER eightbyte to the
## smallest int that covers its used bytes — clang's `getIntegerTypeAtOffset`:
## 1→i8, 2→i16, 3..4→i32, 5..8→i64. A 4-byte int struct (`{u8,u8,u8,u8}`) thus
## coerces to `i32` (not `i64`), matching clang and avoiding an out-of-bounds load
## past the struct. Full eightbytes (all-wide structs) always have `bytes==8 →
## i64`, so this is byte-identical on the existing wide path.
def abi_int_width_llvm(bytes: Int): String
  return "i8" if bytes <= 1
  return "i16" if bytes <= 2
  return "i32" if bytes <= 4
  return "i64"
end

## Used-byte extent of eightbyte `e` for a struct of `size` bytes (1..8).
def abi_eb_bytes(size: Int, e: Int): Int
  var b = size - e * 8
  return 8 if b > 8
  return b
end

## P3.4b — LLVM type for an SSE (all-float) eightbyte `e`. clang's
## `getSSETypeAtOffset`, reduced to our flat scalar set: an F64 in the eightbyte
## ⇒ `double`; two F32s packed into the eightbyte (offsets 0 and 4) ⇒
## `<2 x float>`; a single F32 alone in the eightbyte ⇒ `float`. Verified vs
## `clang -emit-llvm --target=x86_64`: `{float,float}`→`<2 x float>`,
## `{float,long}` eb0→`float`, `{float,float,float}` eb0→`<2 x float>` eb1→`float`.
def abi_sse_eb_llvm(fields: Vec, e: Int): String
  var eb_lo = e * 8
  var eb_hi = eb_lo + 8
  var off = 0
  var nfloat = 0
  var has_f64 = 0
  for i in 0..vec_size(fields)
    var ft = as_string(fields[i])
    var sz = layout::layout_scalar_size(ft)
    off = abi_round_up(off, sz)
    var fstart = off
    var fend = off + sz
    off = off + sz
    if fstart < eb_hi and fend > eb_lo
      if ft == "F64"
        has_f64 = 1
      else
        nfloat = nfloat + 1
      end
    end
  end
  return "double" if has_f64 == 1
  return "<2 x float>" if nfloat >= 2
  return "float"
end

## LLVM type for one classified eightbyte `e` of `fields` (struct `size` bytes):
## an SSE eightbyte resolves to its float SSE type (P3.4b), an INTEGER eightbyte
## to the int width covering its used bytes (P3.4a).
def abi_eb_llvm_full(fields: Vec, classes: Vec, size: Int, e: Int): String
  return abi_sse_eb_llvm(fields, e) if classes[e] == ABI_CLASS_SSE
  return abi_int_width_llvm(abi_eb_bytes(size, e))
end

## Build the coercion type string from per-eightbyte classes ("i64", "i32",
## "double", "float", "<2 x float>", or a "{X, Y}" pair), sizing each INTEGER
## eightbyte to its used bytes and each SSE eightbyte to its float SSE type.
def abi_coerce_type_from_classes(fields: Vec, classes: Vec, size: Int): String
  var n = vec_size(classes)
  return abi_eb_llvm_full(fields, classes, size, 0) if n == 1
  var s = "{"
  for i in 0..n
    s = s + ", " if i > 0
    s = s + abi_eb_llvm_full(fields, classes, size, i)
  end
  s = s + "}"
  return s
end

# ============================================================================
# System V AMD64 classifier (x86_64 — deploy / spec-conformance gate)
# ============================================================================

## Classify a struct (by its field-type names) for the SysV AMD64 C ABI.
## `is_return` selects sret vs byval for the MEMORY (>16 byte) case.
def abi_classify_fields_sysv(fields: Vec, is_return: Int): Vec
  return abi_info_new(ABI_DIRECT, "", 0) if vec_size(fields) == 0
  var size = abi_struct_size(fields)
  if size > 16
    return abi_info_new(ABI_INDIRECT_SRET, "", 0) if is_return == 1
    return abi_info_new(ABI_INDIRECT_BYVAL, "", 0)
  end
  var classes = abi_eightbyte_classes_sysv(fields, size)
  return abi_info_new(ABI_COERCE, abi_coerce_type_from_classes(fields, classes, size), vec_size(classes))
end

# ============================================================================
# AArch64 AAPCS classifier (arm64 — host / native run gate)
# ============================================================================

## 1 if the struct is a Homogeneous Float Aggregate: 1..4 fields, all the SAME
## float type. HFAs pass in up to 4 SIMD (V) registers. v1: no nested HFAs.
def abi_is_hfa(fields: Vec): Int
  var n = vec_size(fields)
  return 0 if n == 0
  return 0 if n > 4
  var ft0 = as_string(fields[0])
  return 0 if layout::layout_scalar_is_float(ft0) == 0
  for i in 0..n
    var ft = as_string(fields[i])
    return 0 if layout::layout_scalar_is_float(ft) == 0
    return 0 if ft != ft0
  end
  return 1
end

## Classify a struct for the AArch64 AAPCS64 C ABI.
def abi_classify_fields_aapcs(fields: Vec, is_return: Int): Vec
  return abi_info_new(ABI_DIRECT, "", 0) if vec_size(fields) == 0
  if abi_is_hfa(fields) == 1
    var ft0 = as_string(fields[0])
    var elem = "float"
    elem = "double" if ft0 == "F64"
    var n = vec_size(fields)
    return abi_info_new(ABI_COERCE, "[" + str_from_int(n) + " x " + elem + "]", n)
  end
  var size = abi_struct_size(fields)
  if size > 16
    return abi_info_new(ABI_INDIRECT_SRET, "", 0) if is_return == 1
    return abi_info_new(ABI_INDIRECT_BYVAL, "", 0)
  end
  return abi_info_new(ABI_COERCE, "i64", 1) if size <= 8
  return abi_info_new(ABI_COERCE, "[2 x i64]", 2)
end

# ============================================================================
# Public entry — dispatch a struct field-list to the active target's classifier
# ============================================================================

## Classify a struct (field-type names) for `target`. Unknown targets fall back
## to ABI_DIRECT so callers keep the legacy opaque-pointer path (no regression).
def abi_classify_fields(target: String, fields: Vec, is_return: Int): Vec
  return abi_classify_fields_aapcs(fields, is_return) if abi_target_is_aarch64(target) == 1
  return abi_classify_fields_sysv(fields, is_return) if abi_target_is_x86_64(target) == 1
  return abi_info_new(ABI_DIRECT, "", 0)
end
