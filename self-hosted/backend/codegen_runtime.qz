  # the drain flag set before any task gets enqueued into a torn-down queue.
  codegen_util::cg_emit_line(out, "  %drain.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 34")
  codegen_util::cg_emit_line(out, "  %drain.v = load atomic i64, ptr %drain.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %is_draining = icmp ne i64 %drain.v, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_draining, label %spawn_exit, label %spawn_proceed")
  codegen_util::cg_emit_line(out, "spawn_proceed:")
  # Lock mutex
  codegen_util::cg_emit_line(out, "  %mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mtx.i = load i64, ptr %mtx.p")
  codegen_util::cg_emit_line(out, "  %mtx = inttoptr i64 %mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %mtx)")
  # Backpressure: wait while max_tasks > 0 && active_tasks >= max_tasks
  codegen_util::cg_emit_line(out, "  br label %bp_check")
  codegen_util::cg_emit_line(out, "bp_check:")
  codegen_util::cg_emit_line(out, "  %bp.max.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 18")
  codegen_util::cg_emit_line(out, "  %bp.max = load i64, ptr %bp.max.p")
  codegen_util::cg_emit_line(out, "  %bp.has_limit = icmp sgt i64 %bp.max, 0")
  codegen_util::cg_emit_line(out, "  br i1 %bp.has_limit, label %bp_chk_at, label %bp_done")
  codegen_util::cg_emit_line(out, "bp_chk_at:")
  codegen_util::cg_emit_line(out, "  %bp.at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  %bp.at = load i64, ptr %bp.at.p")
  codegen_util::cg_emit_line(out, "  %bp.full = icmp sge i64 %bp.at, %bp.max")
  codegen_util::cg_emit_line(out, "  br i1 %bp.full, label %bp_wait, label %bp_done")
  codegen_util::cg_emit_line(out, "bp_wait:")
  codegen_util::cg_emit_line(out, "  %bp.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %bp.cond.i = load i64, ptr %bp.cond.p")
  codegen_util::cg_emit_line(out, "  %bp.cond = inttoptr i64 %bp.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_wait(ptr %bp.cond, ptr %mtx)")
  codegen_util::cg_emit_line(out, "  br label %bp_check")
  codegen_util::cg_emit_line(out, "bp_done:")
