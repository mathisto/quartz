  codegen_util::cg_emit_line(out, "  %padptr = inttoptr i64 %pad to ptr")
  codegen_util::cg_emit_line(out, "  %len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %padc = load i8, ptr %padptr")
  codegen_util::cg_emit_line(out, "  %need.pad = icmp ult i64 %len, %target")
  codegen_util::cg_emit_line(out, "  br i1 %need.pad, label %do.pad, label %ret.copy")
