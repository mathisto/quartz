  codegen_util::cg_emit_line(out, "  %thp.i_t.gep = getelementptr i64, ptr %thp.arr, i64 %thp.i_t.off")
  codegen_util::cg_emit_line(out, "  %thp.i_t = load i64, ptr %thp.i_t.gep")
  codegen_util::cg_emit_line(out, "  %thp.p_t.off = add i64 %thp.p_off, 1")
  codegen_util::cg_emit_line(out, "  %thp.p_t.gep = getelementptr i64, ptr %thp.arr, i64 %thp.p_t.off")
  codegen_util::cg_emit_line(out, "  %thp.p_t = load i64, ptr %thp.p_t.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thp.p_d, ptr %thp.i_d.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thp.p_t, ptr %thp.i_t.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thp.i_d, ptr %thp.p_d.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thp.i_t, ptr %thp.p_t.gep")
  codegen_util::cg_emit_line(out, "  br label %thp_su_loop")
  codegen_util::cg_emit_line(out, "thp_unlock_ok:")
