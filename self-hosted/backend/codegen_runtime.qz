  codegen_util::cg_emit_line(out, "  %sp.has_parent = icmp ne i64 %sp.cf, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sp.has_parent, label %sp_get_parent, label %sp_no_parent")
  codegen_util::cg_emit_line(out, "sp_get_parent:")
