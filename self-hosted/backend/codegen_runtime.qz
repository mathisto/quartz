    codegen_util::cg_emit_line(out, "  %pepev = alloca [12 x i8]")
    codegen_util::cg_emit_line(out, "  %pepev.ptr = bitcast [12 x i8]* %pepev to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %pepev.ptr, i32 0, i64 12)")
    codegen_util::cg_emit_line(out, "  %pepev.ev = bitcast ptr %pepev.ptr to ptr")
    codegen_util::cg_emit_line(out, "  store i32 1073741825, ptr %pepev.ev")
    codegen_util::cg_emit_line(out, "  %pepev.fd.p = getelementptr i8, ptr %pepev.ptr, i64 4")
    codegen_util::cg_emit_line(out, "  %pepev.fd = bitcast ptr %pepev.fd.p to ptr")
    codegen_util::cg_emit_line(out, "  %pfd.i32 = trunc i64 %pfd.i64 to i32")
    codegen_util::cg_emit_line(out, "  store i32 %pfd.i32, ptr %pepev.fd")
    codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %epfd, i32 1, i32 %pfd.i32, ptr %pepev.ptr)")
    codegen_util::cg_emit_line(out, "  ret void")
