  codegen_util::cg_emit_line(out, "  %thd.sd_child_d = phi i64 [%thd.sd_r_d, %thd_sd_use_right], [%thd.sd_l_d, %thd_sd_pick_left]")
  codegen_util::cg_emit_line(out, "  %thd.sd_i_off = mul i64 %thd.sd_i, 2")
  codegen_util::cg_emit_line(out, "  %thd.sd_i_d.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_i_off")
  codegen_util::cg_emit_line(out, "  %thd.sd_i_d = load i64, ptr %thd.sd_i_d.gep")
  codegen_util::cg_emit_line(out, "  %thd.sd_need_swap = icmp slt i64 %thd.sd_child_d, %thd.sd_i_d")
  codegen_util::cg_emit_line(out, "  br i1 %thd.sd_need_swap, label %thd_sd_swap, label %thd_after_sift")
  codegen_util::cg_emit_line(out, "thd_sd_swap:")
