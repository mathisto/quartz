    codegen_util::cg_emit_line(out, "  store i64 %f, ptr @__qz_effect_current_cont_frame, align 8")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "define i64 @__qz_effect_get_cont_frame() nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %f = load i64, ptr @__qz_effect_current_cont_frame, align 8")
    codegen_util::cg_emit_line(out, "  ret i64 %f")
