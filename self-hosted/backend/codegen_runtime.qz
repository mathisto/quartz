    codegen_util::cg_emit_line(out, "  %wk.tc.sock = call i64 @__qz_task_iosock_take(i64 %task)")
    codegen_util::cg_emit_line(out, "  %wk.tc.has_sock = icmp ne i64 %wk.tc.sock, 0")
    codegen_util::cg_emit_line(out, "  br i1 %wk.tc.has_sock, label %wk_tc_io_cancel, label %wk_tc_skip_io")
    codegen_util::cg_emit_line(out, "wk_tc_io_cancel:")
    codegen_util::cg_emit_line(out, "  %wk.tc.afd.slot33.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
    codegen_util::cg_emit_line(out, "  %wk.tc.afd.h.i = load i64, ptr %wk.tc.afd.slot33.p")
    codegen_util::cg_emit_line(out, "  %wk.tc.afd.h = inttoptr i64 %wk.tc.afd.h.i to ptr")
    codegen_util::cg_emit_line(out, "  %wk.tc.iosb.p = inttoptr i64 %wk.tc.sock to ptr")
    codegen_util::cg_emit_line(out, "  %wk.tc.cancel.iosb = alloca [16 x i8]")
    codegen_util::cg_emit_line(out, "  %wk.tc.cancel.iosb.p = bitcast [16 x i8]* %wk.tc.cancel.iosb to ptr")
    codegen_util::cg_emit_line(out, "  %wk.tc.cancel.r = call i32 @NtCancelIoFileEx(ptr %wk.tc.afd.h, ptr %wk.tc.iosb.p, ptr %wk.tc.cancel.iosb.p)")
