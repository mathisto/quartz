  codegen_util::cg_emit_line(out, "  br label %trd_loop")
  codegen_util::cg_emit_line(out, "trd_unlock:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %trd.mtx)")
  codegen_util::cg_emit_line(out, "  br label %trd_ret")
  codegen_util::cg_emit_line(out, "trd_ret:")
