  codegen_util::cg_emit_line(out, "entry:")
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %wp.iocp.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %wp.iocp.i = load i64, ptr %wp.iocp.p")
    codegen_util::cg_emit_line(out, "  %wp.iocp = inttoptr i64 %wp.iocp.i to ptr")
