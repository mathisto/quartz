  # qz_str_is_valid_utf8: validate UTF-8 encoding
  # Returns 1 if valid, 0 if invalid
  # Checks: lead byte sequence lengths, continuation bytes (10xxxxxx),
  #         no overlong encodings, no surrogates (0xD800-0xDFFF), no codepoints > 0x10FFFF
  codegen_util::cg_emit_line(out, "define i64 @qz_str_is_valid_utf8(ptr %ptr, i64 %len) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %valid_cp ]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %ret_valid, label %body")
  codegen_util::cg_emit_line(out, "body:")
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %b0 = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %b0z = zext i8 %b0 to i64")
  # 1-byte: 0xxxxxxx
  codegen_util::cg_emit_line(out, "  %is_ascii = icmp ult i64 %b0z, 128")
  codegen_util::cg_emit_line(out, "  br i1 %is_ascii, label %ascii, label %check_2b")
  codegen_util::cg_emit_line(out, "ascii:")
  codegen_util::cg_emit_line(out, "  %i.a = add i64 %i, 1")
