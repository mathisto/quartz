  codegen_util::cg_emit_line(out, "  br label %wd_free_loop")
  codegen_util::cg_emit_line(out, "wd_free_done:")
  # Free wdata array itself (B2: zero slot 17 after free)
  codegen_util::cg_emit_line(out, "  %wd.arr = inttoptr i64 %wd.raw to ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %wd.arr)")
