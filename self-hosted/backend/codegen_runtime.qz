  codegen_util::cg_emit_line(out, "  store i64 %sp.tr.cnt.inc, ptr %sp.tr.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %sp_tr_done")
  codegen_util::cg_emit_line(out, "sp_tr_done:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %sp.tr.mtx)")
  # Signal condvar
  codegen_util::cg_emit_line(out, "  %cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %cond.i = load i64, ptr %cond.p")
  codegen_util::cg_emit_line(out, "  %cond = inttoptr i64 %cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_signal(ptr %cond)")
