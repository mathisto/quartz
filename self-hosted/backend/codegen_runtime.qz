    # output IOSB for the kernel to write the cancel status — alloca'd
    # on this thread's stack since the kernel writes it synchronously
    # before returning.
    codegen_util::cg_emit_line(out, "  %wk.afd.slot33.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
    codegen_util::cg_emit_line(out, "  %wk.afd.h.i = load i64, ptr %wk.afd.slot33.p")
    codegen_util::cg_emit_line(out, "  %wk.afd.h = inttoptr i64 %wk.afd.h.i to ptr")
    codegen_util::cg_emit_line(out, "  %wk.iosb.p = inttoptr i64 %wk.sock to ptr")
    codegen_util::cg_emit_line(out, "  %wk.cancel.iosb = alloca [16 x i8]")
    codegen_util::cg_emit_line(out, "  %wk.cancel.iosb.p = bitcast [16 x i8]* %wk.cancel.iosb to ptr")
    codegen_util::cg_emit_line(out, "  %wk.cancel.r = call i32 @NtCancelIoFileEx(ptr %wk.afd.h, ptr %wk.iosb.p, ptr %wk.cancel.iosb.p)")
