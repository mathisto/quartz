    # hosted/Unix branch gets from libc by default.
    #
    # Pre-B.2 emitted `define i32 @setjmp { ret 0 }` / `define void @longjmp
    # { unreachable }` stubs. That was correct ONLY for kernel code that
    # compiled `with` blocks but never executed them at runtime
    # (`__qz_effect_perform` was also a stub returning 0, so no body-wrap
    # reached its longjmp escape). B.3 makes perform real — at which point
    # those stubs would silently swallow throws. Real setjmp/longjmp must
    # land first.
    #
    # Aarch64: the placeholder C side in libc_stubs.c is gated on
    # `defined(__x86_64__)` so this declare-only emit is consistent across
    # both freestanding targets even though the aarch64 verify pipeline
    # currently can't reach the smoke. Once aarch64 verify is unbroken,
    # a parallel aarch64 inline-asm setjmp/longjmp lands in libc_stubs.c
    # without touching this emit site.
    codegen_util::cg_emit_line(out, "; setjmp / longjmp — extern, link resolves to libc_stubs.c x86_64 inline asm (B.2)")
    codegen_util::cg_emit_line(out, "declare i32 @setjmp(ptr) returns_twice nounwind")
    codegen_util::cg_emit_line(out, "declare void @longjmp(ptr, i32) noreturn nounwind")
    codegen_util::cg_emit_line(out, "")

    # D.11 Phase 8b.2.b — monotonic-ns bridge to the kernel clock. The
    # hosted shape at codegen_runtime.qz:3987-4029 emits a body that
    # calls clock_gettime (Unix) / QueryPerformanceCounter (Windows);
    # freestanding kernel has neither, but provides its own RDTSC-
    # derived time source (uk_time_mono_ns in hello_x86.qz, ns since
    # boot). The kernel exports it as `def kern_time_mono_ns(): Int =
    # uk_time_mono_ns()` — same in-module-define resolution pattern
    # as @kern_tcp_listen etc. Same callers as hosted:
    # _http_access_log timing, scope deadline computation,
    # _async_tls_* timeout loops (dead in freestanding via h2 stub
    # but transitively-reachable through `_async_http_*` keep-alive
    # deadlines, so the bridge is load-bearing on the http_serve_supervised
    # hot path).
    # Direct call into the kernel's `def uk_time_mono_ns(): Int`. The
    # @uk_time_mono_ns symbol is already preserved (called from kernel
    # main paths like soul_demo_body), so no DCE-prevention shim is
    # needed — same in-module-define resolution pattern as
    # @kern_tcp_listen / @kern_tcp_close / @__qz_eff_ensure_strip etc.
    # No forward `declare` here; LLVM resolves the symbol from the
    # in-module Quartz def.
    codegen_util::cg_emit_line(out, "; D.11 Phase 8b.2.b — monotonic-ns bridge to kernel uk_time_mono_ns")
    codegen_util::cg_emit_line(out, "define i64 @__qz_time_mono_ns() nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %v = call i64 @uk_time_mono_ns()")
    codegen_util::cg_emit_line(out, "  ret i64 %v")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # D.11 Phase 8b.2.b — pure-IR @atoll for freestanding. The hosted
    # path declares libc's atoll as extern (codegen_runtime.qz:3576);
    # the freestanding kernel has no libc, so we emit a minimal body
    # that handles the subset HTTP parsing reaches: optional leading
    # whitespace, optional +/- sign, then decimal digits until non-
    # digit or NUL. Matches C atoll semantics for valid input;
    # overflow is undefined in both libc atoll and this version.
    # str_to_int is reached through Content-Length header parsing in
    # `_parse_request_from_buffer` — load-bearing on every HTTP
    # request the kernel serves.
    codegen_util::cg_emit_line(out, "; D.11 Phase 8b.2.b — pure-IR atoll (HTTP Content-Length, etc.)")
    codegen_util::cg_emit_line(out, "define i64 @atoll(ptr %s) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  br label %skip_ws")
    codegen_util::cg_emit_line(out, "skip_ws:")
    codegen_util::cg_emit_line(out, "  %ws_i = phi i64 [0, %entry], [%ws_inext, %skip_ws]")
    codegen_util::cg_emit_line(out, "  %ws_p = getelementptr i8, ptr %s, i64 %ws_i")
    codegen_util::cg_emit_line(out, "  %ws_c = load i8, ptr %ws_p")
    codegen_util::cg_emit_line(out, "  %ws_inext = add i64 %ws_i, 1")
    codegen_util::cg_emit_line(out, "  %ws_is_sp = icmp eq i8 %ws_c, 32")
    codegen_util::cg_emit_line(out, "  %ws_is_tab = icmp eq i8 %ws_c, 9")
    codegen_util::cg_emit_line(out, "  %ws_is_lf = icmp eq i8 %ws_c, 10")
    codegen_util::cg_emit_line(out, "  %ws_is_cr = icmp eq i8 %ws_c, 13")
    codegen_util::cg_emit_line(out, "  %ws_is_vt = icmp eq i8 %ws_c, 11")
    codegen_util::cg_emit_line(out, "  %ws_is_ff = icmp eq i8 %ws_c, 12")
    codegen_util::cg_emit_line(out, "  %ws_or1 = or i1 %ws_is_sp, %ws_is_tab")
    codegen_util::cg_emit_line(out, "  %ws_or2 = or i1 %ws_is_lf, %ws_is_cr")
    codegen_util::cg_emit_line(out, "  %ws_or3 = or i1 %ws_is_vt, %ws_is_ff")
    codegen_util::cg_emit_line(out, "  %ws_or4 = or i1 %ws_or1, %ws_or2")
    codegen_util::cg_emit_line(out, "  %ws_is = or i1 %ws_or4, %ws_or3")
    codegen_util::cg_emit_line(out, "  br i1 %ws_is, label %skip_ws, label %sign_check")
    codegen_util::cg_emit_line(out, "sign_check:")
    codegen_util::cg_emit_line(out, "  %sg_is_plus = icmp eq i8 %ws_c, 43")
    codegen_util::cg_emit_line(out, "  %sg_is_minus = icmp eq i8 %ws_c, 45")
    codegen_util::cg_emit_line(out, "  %sg_has_sign = or i1 %sg_is_plus, %sg_is_minus")
    codegen_util::cg_emit_line(out, "  %sg_i_after = select i1 %sg_has_sign, i64 %ws_inext, i64 %ws_i")
    codegen_util::cg_emit_line(out, "  br label %digit_loop")
    codegen_util::cg_emit_line(out, "digit_loop:")
    codegen_util::cg_emit_line(out, "  %d_i = phi i64 [%sg_i_after, %sign_check], [%d_inext, %digit_continue]")
    codegen_util::cg_emit_line(out, "  %d_acc = phi i64 [0, %sign_check], [%d_acc_next, %digit_continue]")
    codegen_util::cg_emit_line(out, "  %d_p = getelementptr i8, ptr %s, i64 %d_i")
    codegen_util::cg_emit_line(out, "  %d_c = load i8, ptr %d_p")
    codegen_util::cg_emit_line(out, "  %d_c64 = zext i8 %d_c to i64")
    codegen_util::cg_emit_line(out, "  %d_ge0 = icmp uge i8 %d_c, 48")
    codegen_util::cg_emit_line(out, "  %d_le9 = icmp ule i8 %d_c, 57")
    codegen_util::cg_emit_line(out, "  %d_is_digit = and i1 %d_ge0, %d_le9")
    codegen_util::cg_emit_line(out, "  br i1 %d_is_digit, label %digit_continue, label %finish")
    codegen_util::cg_emit_line(out, "digit_continue:")
    codegen_util::cg_emit_line(out, "  %d_acc_x10 = mul i64 %d_acc, 10")
    codegen_util::cg_emit_line(out, "  %d_val = sub i64 %d_c64, 48")
    codegen_util::cg_emit_line(out, "  %d_acc_next = add i64 %d_acc_x10, %d_val")
    codegen_util::cg_emit_line(out, "  %d_inext = add i64 %d_i, 1")
    codegen_util::cg_emit_line(out, "  br label %digit_loop")
    codegen_util::cg_emit_line(out, "finish:")
    codegen_util::cg_emit_line(out, "  %neg = sub i64 0, %d_acc")
    codegen_util::cg_emit_line(out, "  %result = select i1 %sg_is_minus, i64 %neg, i64 %d_acc")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # Sort helpers — libc-free (call @qsort which we just declared).
    # Prelude `sorted()` / `reversed()` + the `sorted` / `vec_sort`
    # intrinsics reference these by name. Without them LLC rejects any
    # freestanding IR containing a sort. Lifted from
    # `cg_emit_runtime_helpers_2` where they live in the hosted path.
    codegen_util::cg_emit_line(out, "; Sort helpers (libc-free — @qsort is link-time extern)")
    codegen_util::cg_emit_line(out, "define private i32 @qz_sort_cmp_asc(ptr %a, ptr %b) noredzone {")
    codegen_util::cg_emit_line(out, "  %ap = bitcast ptr %a to ptr")
    codegen_util::cg_emit_line(out, "  %bp = bitcast ptr %b to ptr")
    codegen_util::cg_emit_line(out, "  %av = load i64, ptr %ap")
    codegen_util::cg_emit_line(out, "  %bv = load i64, ptr %bp")
    codegen_util::cg_emit_line(out, "  %lt = icmp slt i64 %av, %bv")
    codegen_util::cg_emit_line(out, "  %gt = icmp sgt i64 %av, %bv")
    codegen_util::cg_emit_line(out, "  %r1 = select i1 %lt, i32 -1, i32 0")
    codegen_util::cg_emit_line(out, "  %r2 = select i1 %gt, i32 1, i32 %r1")
    codegen_util::cg_emit_line(out, "  ret i32 %r2")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "define void @qz_vec_sort(i64 %vec) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
    codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
    codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
    codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
    codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
    codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
    codegen_util::cg_emit_line(out, "  call void @qsort(ptr %data, i64 %size, i64 8, ptr @qz_sort_cmp_asc)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # B.5e.7a — qz_vec_remove (the `vec_delete` intrinsic helper). Pure
    # pointer arithmetic (save elem, shift left, decrement size) — libc-free
    # and freestanding-safe. The freestanding `actor ... end` poll loop's
    # link/monitor-remove arms (tags -7/-8) emit `vec_delete`, so the kernel
    # needs this definition. Lifted verbatim from cg_emit_runtime_helpers_2
    # (hosted) where it lives past the freestanding early-return; +noredzone.
    codegen_util::cg_emit_line(out, "define i64 @qz_vec_remove(i64 %vec, i64 %idx) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
    codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
    codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
    codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
    codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
    codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
    codegen_util::cg_emit_line(out, "  %elem.ptr = getelementptr i64, ptr %data, i64 %idx")
    codegen_util::cg_emit_line(out, "  %result = load i64, ptr %elem.ptr")
    codegen_util::cg_emit_line(out, "  %last = sub i64 %size, 1")
    codegen_util::cg_emit_line(out, "  %nothing = icmp sge i64 %idx, %last")
    codegen_util::cg_emit_line(out, "  br i1 %nothing, label %done, label %shift_loop")
    codegen_util::cg_emit_line(out, "shift_loop:")
    codegen_util::cg_emit_line(out, "  %j = phi i64 [%idx, %entry], [%j.next, %shift_body]")
    codegen_util::cg_emit_line(out, "  %j.done = icmp sge i64 %j, %last")
    codegen_util::cg_emit_line(out, "  br i1 %j.done, label %done, label %shift_body")
    codegen_util::cg_emit_line(out, "shift_body:")
    codegen_util::cg_emit_line(out, "  %j1 = add i64 %j, 1")
    codegen_util::cg_emit_line(out, "  %src.ptr = getelementptr i64, ptr %data, i64 %j1")
    codegen_util::cg_emit_line(out, "  %src.val = load i64, ptr %src.ptr")
    codegen_util::cg_emit_line(out, "  %dst.ptr = getelementptr i64, ptr %data, i64 %j")
    codegen_util::cg_emit_line(out, "  store i64 %src.val, ptr %dst.ptr")
    codegen_util::cg_emit_line(out, "  %j.next = add i64 %j, 1")
    codegen_util::cg_emit_line(out, "  br label %shift_loop")
    codegen_util::cg_emit_line(out, "done:")
    codegen_util::cg_emit_line(out, "  %newsize = sub i64 %size, 1")
    codegen_util::cg_emit_line(out, "  store i64 %newsize, ptr %size.ptr")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # Length-prefixed string helpers + libc-free to_str. The hosted
    # path emits richer versions below the freestanding early-return;
    # here we emit the minimum set needed for kernel code that uses
    # string interpolation (`"Hi #{x}"`), `str_concat`, or `.to_s`:
    #   - qz_alloc_str: length-prefixed allocation via link-time malloc
    #   - qz_str_get_len: read length prefix at ptr-8
    #   - to_str: "smart" i64→str (pointer-shaped input returns unchanged;
    #     plain int gets stringified into a new qz_alloc_str buffer)
    # Any kernel that supplies a real malloc (e.g. one backed by a
    # PMM) gets working interpolation for free.
    codegen_util::cg_emit_line(out, "; Length-prefixed string helpers (libc-free — malloc is link-time extern)")
    codegen_util::cg_emit_line(out, "define ptr @qz_alloc_str(i64 %len) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %total = add i64 %len, 9")
    codegen_util::cg_emit_line(out, "  %raw = call ptr @__qz_alloc(i64 %total)")
    codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %len, ptr %hdr")
    codegen_util::cg_emit_line(out, "  %data = getelementptr i8, ptr %raw, i64 8")
    codegen_util::cg_emit_line(out, "  %null_ptr = getelementptr i8, ptr %data, i64 %len")
    codegen_util::cg_emit_line(out, "  store i8 0, ptr %null_ptr")
    codegen_util::cg_emit_line(out, "  ret ptr %data")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "define i64 @qz_str_get_len(ptr %str) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %raw = getelementptr i8, ptr %str, i64 -8")
    codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
    codegen_util::cg_emit_line(out, "  %len = load i64, ptr %hdr")
    codegen_util::cg_emit_line(out, "  ret i64 %len")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # qz_str_hash — FNV-1a 64-bit string hash for length-prefixed strings.
    # Lifted verbatim from hosted at codegen_runtime.qz:10369; pure IR (no
    # libc deps). Pairs with qz_str_eq for `Map<String, V>` bucket lookups.
    codegen_util::cg_emit_line(out, "; FNV-1a 64-bit string hash")
    codegen_util::cg_emit_line(out, "define i64 @qz_str_hash(ptr %str) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %raw = getelementptr i8, ptr %str, i64 -8")
    codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
    codegen_util::cg_emit_line(out, "  %len = load i64, ptr %hdr")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "loop:")
    codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %body ]")
    codegen_util::cg_emit_line(out, "  %hash = phi i64 [ -3750763034362895579, %entry ], [ %hash.next, %body ]")
    codegen_util::cg_emit_line(out, "  %done = icmp uge i64 %i, %len")
    codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %body")
    codegen_util::cg_emit_line(out, "body:")
    codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %str, i64 %i")
    codegen_util::cg_emit_line(out, "  %byte = load i8, ptr %bp")
    codegen_util::cg_emit_line(out, "  %b64 = zext i8 %byte to i64")
    codegen_util::cg_emit_line(out, "  %xored = xor i64 %hash, %b64")
    codegen_util::cg_emit_line(out, "  %hash.next = mul i64 %xored, 1099511628211")
    codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "exit:")
    codegen_util::cg_emit_line(out, "  ret i64 %hash")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # qz_str_eq — length-aware string equality. Returns 1 if equal, 0 if
    # not. Replaces @strcmp for `Map<String, V>` bucket comparison so
    # keys containing embedded \x00 bytes don't falsely alias. Lifted
    # verbatim from the hosted emit at codegen_runtime.qz:10266; depends
    # only on @memcmp which the freestanding decl block declared above.
    # Pulled in by std/net/http_server.qz transitively through the
    # Map<String, V> header-table machinery.
    codegen_util::cg_emit_line(out, "; Length-aware string equality (safe for NUL-containing keys)")
    codegen_util::cg_emit_line(out, "define i64 @qz_str_eq(ptr %a, ptr %b) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %araw = getelementptr i8, ptr %a, i64 -8")
    codegen_util::cg_emit_line(out, "  %braw = getelementptr i8, ptr %b, i64 -8")
    codegen_util::cg_emit_line(out, "  %alen = load i64, ptr %araw")
    codegen_util::cg_emit_line(out, "  %blen = load i64, ptr %braw")
    codegen_util::cg_emit_line(out, "  %len_eq = icmp eq i64 %alen, %blen")
    codegen_util::cg_emit_line(out, "  br i1 %len_eq, label %cmp, label %neq")
    codegen_util::cg_emit_line(out, "cmp:")
    codegen_util::cg_emit_line(out, "  %zero = icmp eq i64 %alen, 0")
    codegen_util::cg_emit_line(out, "  br i1 %zero, label %eq, label %memcmp_bb")
    codegen_util::cg_emit_line(out, "memcmp_bb:")
    codegen_util::cg_emit_line(out, "  %r = call i32 @memcmp(ptr %a, ptr %b, i64 %alen)")
    codegen_util::cg_emit_line(out, "  %rz = icmp eq i32 %r, 0")
    codegen_util::cg_emit_line(out, "  br i1 %rz, label %eq, label %neq")
    codegen_util::cg_emit_line(out, "eq:")
    codegen_util::cg_emit_line(out, "  ret i64 1")
    codegen_util::cg_emit_line(out, "neq:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # qz_wrap_cstr — wrap a NUL-terminated C string into a length-prefixed
    # Quartz string. Lifted from hosted at codegen_runtime.qz:10246; deps
    # @strlen + @qz_alloc_str + @memcpy all available in freestanding.
    # Load-bearing on the prelude codepoint/string helpers below and on
    # any helper that returns a string built from a NUL-terminated buffer.
    codegen_util::cg_emit_line(out, "; Wrap C string into length-prefixed string")
    codegen_util::cg_emit_line(out, "define ptr @qz_wrap_cstr(ptr %cstr) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "  %len = call i64 @strlen(ptr %cstr)")
    codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %len)")
    codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %cstr, i64 %len)")
    codegen_util::cg_emit_line(out, "  ret ptr %buf")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # qz_str_from_codepoint — encode a Unicode codepoint as a UTF-8
