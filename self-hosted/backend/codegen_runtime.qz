  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %wf.lq)")
  codegen_util::cg_emit_line(out, "  br label %wf_check_mtx")
  codegen_util::cg_emit_line(out, "wf_check_mtx:")
