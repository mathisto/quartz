  codegen_util::cg_emit_line(out, "  %pc.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %pc.cond.i = load i64, ptr %pc.cond.p")
  codegen_util::cg_emit_line(out, "  %pc.cond = inttoptr i64 %pc.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %pc.cond)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %pc.gmtx)")
