  codegen_util::cg_emit_line(out, "  br i1 %thc.has_mtx, label %thc_lock, label %thc_ret_null")
  codegen_util::cg_emit_line(out, "thc_lock:")
  codegen_util::cg_emit_line(out, "  %thc.mtx = inttoptr i64 %thc.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %thc.mtx)")
  codegen_util::cg_emit_line(out, "  %thc.cnt.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %thc.cnt = load i64, ptr %thc.cnt.p")
  codegen_util::cg_emit_line(out, "  %thc.arr.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %thc.arr.i = load i64, ptr %thc.arr.p")
