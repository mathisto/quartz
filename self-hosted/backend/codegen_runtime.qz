  codegen_util::cg_emit_line(out, "  %exit.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %exit.mtx.i = load i64, ptr %exit.mtx.p")
