  codegen_util::cg_emit_line(out, "  %dt.off = mul i64 %dt.i, 4")
  codegen_util::cg_emit_line(out, "  %dt.tid.gep = getelementptr i64, ptr %dt.arr, i64 %dt.off")
  codegen_util::cg_emit_line(out, "  %dt.tid = load i64, ptr %dt.tid.gep")
  codegen_util::cg_emit_line(out, "  %dt.pid.off = add i64 %dt.off, 1")
  codegen_util::cg_emit_line(out, "  %dt.pid.gep = getelementptr i64, ptr %dt.arr, i64 %dt.pid.off")
  codegen_util::cg_emit_line(out, "  %dt.pid = load i64, ptr %dt.pid.gep")
  codegen_util::cg_emit_line(out, "  %dt.st.off = add i64 %dt.off, 3")
  codegen_util::cg_emit_line(out, "  %dt.st.gep = getelementptr i64, ptr %dt.arr, i64 %dt.st.off")
  codegen_util::cg_emit_line(out, "  %dt.st = load i64, ptr %dt.st.gep")
  # Print: "  task N parent=P status=S\n" per entry
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.dt_task to i64))")
  codegen_util::cg_emit_line(out, "  %dt.tid.s = call i64 @str_from_int(i64 %dt.tid)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 %dt.tid.s)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.dt_parent to i64))")
  codegen_util::cg_emit_line(out, "  %dt.pid.s = call i64 @str_from_int(i64 %dt.pid)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 %dt.pid.s)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.dt_status to i64))")
  codegen_util::cg_emit_line(out, "  %dt.st.s = call i64 @str_from_int(i64 %dt.st)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 %dt.st.s)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.dt_newline to i64))")
  codegen_util::cg_emit_line(out, "  br label %dt_next")
  codegen_util::cg_emit_line(out, "dt_next:")
  codegen_util::cg_emit_line(out, "  %dt.i.next = add i64 %dt.i, 1")
  codegen_util::cg_emit_line(out, "  br label %dt_loop")
  codegen_util::cg_emit_line(out, "dt_unlock:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %dt.mtx)")
  codegen_util::cg_emit_line(out, "  br label %dt_ret")
  codegen_util::cg_emit_line(out, "dt_ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_completion_notify(task_frame): scan completion map for watchers of this task
  # For each matching entry, write 1 byte to the notification pipe fd, then clear the entry.
  # Called from task_done and panic_caught under the scheduler mutex (already held).
  codegen_util::cg_emit_line(out, "define i64 @__qz_completion_notify(i64 %cn.task) nounwind {")
  codegen_util::cg_emit_line(out, "cn_entry:")
  # Load completion map mutex and lock it
  codegen_util::cg_emit_line(out, "  %cn.mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %cn.mtx.i = load i64, ptr %cn.mtx.p")
  codegen_util::cg_emit_line(out, "  %cn.mtx = inttoptr i64 %cn.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  %cn.mtx.nz = icmp ne i64 %cn.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %cn.mtx.nz, label %cn_do_lock, label %cn_ret0")
  codegen_util::cg_emit_line(out, "cn_do_lock:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %cn.mtx)")
  # Load array pointer and count
  codegen_util::cg_emit_line(out, "  %cn.arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %cn.arr.i = load i64, ptr %cn.arr.p")
  codegen_util::cg_emit_line(out, "  %cn.arr = inttoptr i64 %cn.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  %cn.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %cn.cnt = load i64, ptr %cn.cnt.p")
  codegen_util::cg_emit_line(out, "  %cn.has = icmp sgt i64 %cn.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %cn.has, label %cn_scan, label %cn_unlock")
  codegen_util::cg_emit_line(out, "cn_scan:")
  # Allocate 1 byte for write notification
  codegen_util::cg_emit_line(out, "  %cn.wbuf = alloca i8")
  codegen_util::cg_emit_line(out, "  store i8 1, ptr %cn.wbuf")
  codegen_util::cg_emit_line(out, "  br label %cn_loop")
  codegen_util::cg_emit_line(out, "cn_loop:")
  codegen_util::cg_emit_line(out, "  %cn.i = phi i64 [0, %cn_scan], [%cn.i.next, %cn_next]")
  codegen_util::cg_emit_line(out, "  %cn.matches = phi i64 [0, %cn_scan], [%cn.matches.next, %cn_next]")
  codegen_util::cg_emit_line(out, "  %cn.i.done = icmp uge i64 %cn.i, %cn.cnt")
  codegen_util::cg_emit_line(out, "  br i1 %cn.i.done, label %cn_unlock, label %cn_check")
  codegen_util::cg_emit_line(out, "cn_check:")
  # Each pair is 2 i64: [task_frame, write_fd] at index i*2 and i*2+1
  codegen_util::cg_emit_line(out, "  %cn.off = mul i64 %cn.i, 2")
  codegen_util::cg_emit_line(out, "  %cn.tf.gep = getelementptr i64, ptr %cn.arr, i64 %cn.off")
  codegen_util::cg_emit_line(out, "  %cn.tf = load i64, ptr %cn.tf.gep")
  codegen_util::cg_emit_line(out, "  %cn.match = icmp eq i64 %cn.tf, %cn.task")
  codegen_util::cg_emit_line(out, "  br i1 %cn.match, label %cn_notify, label %cn_next")
  codegen_util::cg_emit_line(out, "cn_notify:")
  # Write 1 byte to the notification pipe fd
  codegen_util::cg_emit_line(out, "  %cn.wfd.gep = getelementptr i64, ptr %cn.arr, i64 %cn.off")
  codegen_util::cg_emit_line(out, "  %cn.wfd.gep2 = getelementptr i64, ptr %cn.wfd.gep, i64 1")
  codegen_util::cg_emit_line(out, "  %cn.wfd = load i64, ptr %cn.wfd.gep2")
  codegen_util::cg_emit_line(out, "  %cn.wfd.i32 = trunc i64 %cn.wfd to i32")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 %cn.wfd.i32, ptr %cn.wbuf, i64 1)")
  codegen_util::cg_emit_line(out, "  %cn.m.inc = add i64 %cn.matches, 1")
  codegen_util::cg_emit_line(out, "  br label %cn_next")
  codegen_util::cg_emit_line(out, "cn_next:")
  codegen_util::cg_emit_line(out, "  %cn.matches.next = phi i64 [%cn.matches, %cn_check], [%cn.m.inc, %cn_notify]")
  codegen_util::cg_emit_line(out, "  %cn.i.next = add i64 %cn.i, 1")
  codegen_util::cg_emit_line(out, "  br label %cn_loop")
  codegen_util::cg_emit_line(out, "cn_unlock:")
  codegen_util::cg_emit_line(out, "  %cn.total = phi i64 [0, %cn_do_lock], [%cn.matches, %cn_loop]")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %cn.mtx)")
  codegen_util::cg_emit_line(out, "  ret i64 %cn.total")
  codegen_util::cg_emit_line(out, "cn_ret0:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_task_local_cleanup(task_id): remove all task-local entries for the given task
  # Called from task_done and panic_caught when a task completes.
  codegen_util::cg_emit_line(out, "define void @__qz_task_local_cleanup(i64 %tlc.tid) nounwind {")
  codegen_util::cg_emit_line(out, "tlc_entry:")
  codegen_util::cg_emit_line(out, "  %tlc.mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %tlc.mtx.i = load i64, ptr %tlc.mtx.p")
  codegen_util::cg_emit_line(out, "  %tlc.mtx.nz = icmp ne i64 %tlc.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tlc.mtx.nz, label %tlc_lock, label %tlc_ret")
  codegen_util::cg_emit_line(out, "tlc_lock:")
  codegen_util::cg_emit_line(out, "  %tlc.mtx = inttoptr i64 %tlc.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %tlc.mtx)")
  codegen_util::cg_emit_line(out, "  %tlc.arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %tlc.arr.i = load i64, ptr %tlc.arr.p")
  codegen_util::cg_emit_line(out, "  %tlc.arr = inttoptr i64 %tlc.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  %tlc.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %tlc.cnt0 = load i64, ptr %tlc.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %tlc_loop")
  codegen_util::cg_emit_line(out, "tlc_loop:")
  codegen_util::cg_emit_line(out, "  %tlc.i = phi i64 [0, %tlc_lock], [%tlc.i.next, %tlc_next], [%tlc.i, %tlc_swap]")
  codegen_util::cg_emit_line(out, "  %tlc.cnt = phi i64 [%tlc.cnt0, %tlc_lock], [%tlc.cnt, %tlc_next], [%tlc.cnt.dec, %tlc_swap]")
  codegen_util::cg_emit_line(out, "  %tlc.done = icmp uge i64 %tlc.i, %tlc.cnt")
  codegen_util::cg_emit_line(out, "  br i1 %tlc.done, label %tlc_store, label %tlc_check")
  codegen_util::cg_emit_line(out, "tlc_check:")
  # Each triple is 3 i64: (task_id, key, value) at index i*3
  codegen_util::cg_emit_line(out, "  %tlc.off = mul i64 %tlc.i, 3")
  codegen_util::cg_emit_line(out, "  %tlc.tid.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.off")
  codegen_util::cg_emit_line(out, "  %tlc.tid.v = load i64, ptr %tlc.tid.gep")
  codegen_util::cg_emit_line(out, "  %tlc.match = icmp eq i64 %tlc.tid.v, %tlc.tid")
  codegen_util::cg_emit_line(out, "  br i1 %tlc.match, label %tlc_swap, label %tlc_next")
  codegen_util::cg_emit_line(out, "tlc_swap:")
  # Swap-remove: copy last entry over current, decrement count
  codegen_util::cg_emit_line(out, "  %tlc.cnt.dec = sub i64 %tlc.cnt, 1")
  codegen_util::cg_emit_line(out, "  %tlc.last.off = mul i64 %tlc.cnt.dec, 3")
  codegen_util::cg_emit_line(out, "  %tlc.l0.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.last.off")
  codegen_util::cg_emit_line(out, "  %tlc.l0 = load i64, ptr %tlc.l0.gep")
  codegen_util::cg_emit_line(out, "  %tlc.l1.off = add i64 %tlc.last.off, 1")
  codegen_util::cg_emit_line(out, "  %tlc.l1.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.l1.off")
  codegen_util::cg_emit_line(out, "  %tlc.l1 = load i64, ptr %tlc.l1.gep")
  codegen_util::cg_emit_line(out, "  %tlc.l2.off = add i64 %tlc.last.off, 2")
  codegen_util::cg_emit_line(out, "  %tlc.l2.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.l2.off")
  codegen_util::cg_emit_line(out, "  %tlc.l2 = load i64, ptr %tlc.l2.gep")
  codegen_util::cg_emit_line(out, "  store i64 %tlc.l0, ptr %tlc.tid.gep")
  codegen_util::cg_emit_line(out, "  %tlc.k.off = add i64 %tlc.off, 1")
  codegen_util::cg_emit_line(out, "  %tlc.k.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.k.off")
  codegen_util::cg_emit_line(out, "  store i64 %tlc.l1, ptr %tlc.k.gep")
  codegen_util::cg_emit_line(out, "  %tlc.v.off = add i64 %tlc.off, 2")
  codegen_util::cg_emit_line(out, "  %tlc.v.gep = getelementptr i64, ptr %tlc.arr, i64 %tlc.v.off")
  codegen_util::cg_emit_line(out, "  store i64 %tlc.l2, ptr %tlc.v.gep")
  # Don't increment — re-check swapped entry
  codegen_util::cg_emit_line(out, "  br label %tlc_loop")
  codegen_util::cg_emit_line(out, "tlc_next:")
  codegen_util::cg_emit_line(out, "  %tlc.i.next = add i64 %tlc.i, 1")
  codegen_util::cg_emit_line(out, "  br label %tlc_loop")
  codegen_util::cg_emit_line(out, "tlc_store:")
  codegen_util::cg_emit_line(out, "  store i64 %tlc.cnt, ptr %tlc.cnt.p")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %tlc.mtx)")
  codegen_util::cg_emit_line(out, "  br label %tlc_ret")
  codegen_util::cg_emit_line(out, "tlc_ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # =========================================================================
  # E.1.c.b: task-snapshot side-table helpers
  # =========================================================================
  # Side-table @__qz_task_snapshots stores (frame_ptr, snapshot_buf_ptr)
  # pairs in a flat i64 array protected by a mutex. Linear-scan keyed by
  # frame_ptr — same shape as completion_map / task_locals. Capacity 256
  # pairs; growth NYI (256 in-flight `go fn()` tasks with parent installs
  # is well above realistic). The mutex is created in __qz_sched_init —
  # all helpers no-op when mutex_ptr == 0 (scheduler not initialized yet,
  # which means no `go` has been emitted yet so register can't have been
  # called).

  # __qz_task_snapshot_register(frame, snap): insert (frame, snap) pair.
  # No-op if snap == 0. Caller must have called __qz_sched_init first
  # (default Async.spawn handler does this on the path that registers).
  codegen_util::cg_emit_line(out, "define void @__qz_task_snapshot_register(i64 %tsr.frame, i64 %tsr.snap) nounwind {")
  codegen_util::cg_emit_line(out, "tsr_entry:")
  codegen_util::cg_emit_line(out, "  %tsr.snap.nz = icmp ne i64 %tsr.snap, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tsr.snap.nz, label %tsr_chk_mtx, label %tsr_ret")
  codegen_util::cg_emit_line(out, "tsr_chk_mtx:")
  codegen_util::cg_emit_line(out, "  %tsr.mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %tsr.mtx.i = load i64, ptr %tsr.mtx.p")
  codegen_util::cg_emit_line(out, "  %tsr.has_mtx = icmp ne i64 %tsr.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tsr.has_mtx, label %tsr_lock, label %tsr_ret")
  codegen_util::cg_emit_line(out, "tsr_lock:")
  codegen_util::cg_emit_line(out, "  %tsr.mtx = inttoptr i64 %tsr.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %tsr.mtx)")
  codegen_util::cg_emit_line(out, "  %tsr.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %tsr.cnt = load i64, ptr %tsr.cnt.p")
  codegen_util::cg_emit_line(out, "  %tsr.cap.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %tsr.cap = load i64, ptr %tsr.cap.p")
  codegen_util::cg_emit_line(out, "  %tsr.full = icmp sge i64 %tsr.cnt, %tsr.cap")
  codegen_util::cg_emit_line(out, "  br i1 %tsr.full, label %tsr_unlock, label %tsr_ins")
  codegen_util::cg_emit_line(out, "tsr_ins:")
  codegen_util::cg_emit_line(out, "  %tsr.arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %tsr.arr.i = load i64, ptr %tsr.arr.p")
  codegen_util::cg_emit_line(out, "  %tsr.arr = inttoptr i64 %tsr.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  %tsr.off = mul i64 %tsr.cnt, 2")
  codegen_util::cg_emit_line(out, "  %tsr.f.gep = getelementptr i64, ptr %tsr.arr, i64 %tsr.off")
  codegen_util::cg_emit_line(out, "  store i64 %tsr.frame, ptr %tsr.f.gep")
  codegen_util::cg_emit_line(out, "  %tsr.s.off = add i64 %tsr.off, 1")
  codegen_util::cg_emit_line(out, "  %tsr.s.gep = getelementptr i64, ptr %tsr.arr, i64 %tsr.s.off")
  codegen_util::cg_emit_line(out, "  store i64 %tsr.snap, ptr %tsr.s.gep")
  codegen_util::cg_emit_line(out, "  %tsr.cnt.next = add i64 %tsr.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %tsr.cnt.next, ptr %tsr.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %tsr_unlock")
  codegen_util::cg_emit_line(out, "tsr_unlock:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %tsr.mtx)")
  codegen_util::cg_emit_line(out, "  br label %tsr_ret")
  codegen_util::cg_emit_line(out, "tsr_ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_task_snapshot_lookup(frame): linear scan; return snap or 0.
  # Hot path on every poll dispatch — fast no-op when count==0 (the
  # initial check avoids touching the mutex when no snapshots have been
  # registered, which is the common case for programs that don't install
  # handlers across spawn).
  codegen_util::cg_emit_line(out, "define i64 @__qz_task_snapshot_lookup(i64 %tsl.frame) nounwind {")
  codegen_util::cg_emit_line(out, "tsl_entry:")
  codegen_util::cg_emit_line(out, "  %tsl.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %tsl.cnt = load i64, ptr %tsl.cnt.p")
  codegen_util::cg_emit_line(out, "  %tsl.empty = icmp eq i64 %tsl.cnt, 0")
