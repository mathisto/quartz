  codegen_util::cg_emit_line(out, "  %thd.sd_l_d.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_l_off")
  codegen_util::cg_emit_line(out, "  %thd.sd_l_d = load i64, ptr %thd.sd_l_d.gep")
  codegen_util::cg_emit_line(out, "  br i1 %thd.sd_has_right, label %thd_sd_pick_right, label %thd_sd_pick_left")
  codegen_util::cg_emit_line(out, "thd_sd_pick_right:")
  codegen_util::cg_emit_line(out, "  %thd.sd_r_off = mul i64 %thd.sd_right, 2")
  codegen_util::cg_emit_line(out, "  %thd.sd_r_d.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_r_off")
  codegen_util::cg_emit_line(out, "  %thd.sd_r_d = load i64, ptr %thd.sd_r_d.gep")
  codegen_util::cg_emit_line(out, "  %thd.sd_right_smaller = icmp slt i64 %thd.sd_r_d, %thd.sd_l_d")
  codegen_util::cg_emit_line(out, "  br i1 %thd.sd_right_smaller, label %thd_sd_use_right, label %thd_sd_pick_left")
