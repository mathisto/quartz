    codegen_util::cg_emit_line(out, "  %tfd.i64 = sext i32 %tfd to i64")
    # Guard: if tfd >= 65536, close and return (fd too high for io_map)
    codegen_util::cg_emit_line(out, "  %tfd.safe = icmp slt i64 %tfd.i64, 65536")
    codegen_util::cg_emit_line(out, "  br i1 %tfd.safe, label %setup, label %bail")
    codegen_util::cg_emit_line(out, "bail:")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %tfd)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "setup:")
    # Store task at io_map[tfd]
    codegen_util::cg_emit_line(out, "  %map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
    codegen_util::cg_emit_line(out, "  %map.i = load i64, ptr %map.p")
    codegen_util::cg_emit_line(out, "  %map.base = inttoptr i64 %map.i to ptr")
    codegen_util::cg_emit_line(out, "  %map.slot = getelementptr i64, ptr %map.base, i64 %tfd.i64")
    codegen_util::cg_emit_line(out, "  store i64 %task, ptr %map.slot")
    # Set timeout: itimerspec = {interval={0,0}, value={sec,nsec}}
    codegen_util::cg_emit_line(out, "  %tspec = alloca [32 x i8]")
    codegen_util::cg_emit_line(out, "  %tspec.ptr = bitcast [32 x i8]* %tspec to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %tspec.ptr, i32 0, i64 32)")
    codegen_util::cg_emit_line(out, "  %tmo.sec = sdiv i64 %timeout_ms, 1000")
    codegen_util::cg_emit_line(out, "  %tmo.rem = srem i64 %timeout_ms, 1000")
    codegen_util::cg_emit_line(out, "  %tmo.nsec = mul i64 %tmo.rem, 1000000")
    # value.tv_sec at offset 16 (after 16 bytes of interval)
    codegen_util::cg_emit_line(out, "  %tspec.sec.p = getelementptr i8, ptr %tspec.ptr, i64 16")
    codegen_util::cg_emit_line(out, "  store i64 %tmo.sec, ptr %tspec.sec.p")
    codegen_util::cg_emit_line(out, "  %tspec.nsec.p = getelementptr i8, ptr %tspec.ptr, i64 24")
    codegen_util::cg_emit_line(out, "  store i64 %tmo.nsec, ptr %tspec.nsec.p")
    codegen_util::cg_emit_line(out, "  call i32 @timerfd_settime(i32 %tfd, i32 0, ptr %tspec.ptr, ptr null)")
    # Load epoll fd
    codegen_util::cg_emit_line(out, "  %epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %epfd.i64 = load i64, ptr %epfd.p")
    codegen_util::cg_emit_line(out, "  %epfd = trunc i64 %epfd.i64 to i32")
    # Register timerfd with epoll (EPOLLIN | EPOLLONESHOT = 1073741825)
    codegen_util::cg_emit_line(out, "  %tev = alloca [12 x i8]")
    codegen_util::cg_emit_line(out, "  %tev.ptr = bitcast [12 x i8]* %tev to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %tev.ptr, i32 0, i64 12)")
    codegen_util::cg_emit_line(out, "  store i32 1073741825, ptr %tev.ptr")
    codegen_util::cg_emit_line(out, "  %tev.fd.p = getelementptr i8, ptr %tev.ptr, i64 4")
    codegen_util::cg_emit_line(out, "  store i32 %tfd, ptr %tev.fd.p")
    codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %epfd, i32 1, i32 %tfd, ptr %tev.ptr)")
    # Mark timerfd as self-peer for cleanup: timer_peers[tfd] = -(tfd+1)
    # Poller cleanup will close the timerfd when the timer fires
