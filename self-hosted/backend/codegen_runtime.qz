    codegen_util::cg_emit_line(out, "declare i32 @GetFileAttributesExA(ptr, i32, ptr) nounwind")
    codegen_util::cg_emit_line(out, "define i64 @qz_file_size(i64 %p) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %ps = inttoptr i64 %p to ptr")
    codegen_util::cg_emit_line(out, "  %data.buf = alloca [36 x i8]")
    codegen_util::cg_emit_line(out, "  %data.ptr = bitcast [36 x i8]* %data.buf to ptr")
    codegen_util::cg_emit_line(out, "  %r = call i32 @GetFileAttributesExA(ptr %ps, i32 0, ptr %data.ptr)")
    codegen_util::cg_emit_line(out, "  %ok = icmp ne i32 %r, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ok, label %read, label %err")
    codegen_util::cg_emit_line(out, "read:")
    codegen_util::cg_emit_line(out, "  %hi.ptr = getelementptr i8, ptr %data.ptr, i64 28")
    codegen_util::cg_emit_line(out, "  %hi32.p = bitcast ptr %hi.ptr to ptr")
    codegen_util::cg_emit_line(out, "  %hi32 = load i32, ptr %hi32.p")
    codegen_util::cg_emit_line(out, "  %hi64 = zext i32 %hi32 to i64")
    codegen_util::cg_emit_line(out, "  %hi.shl = shl i64 %hi64, 32")
    codegen_util::cg_emit_line(out, "  %lo.ptr = getelementptr i8, ptr %data.ptr, i64 32")
    codegen_util::cg_emit_line(out, "  %lo32.p = bitcast ptr %lo.ptr to ptr")
    codegen_util::cg_emit_line(out, "  %lo32 = load i32, ptr %lo32.p")
    codegen_util::cg_emit_line(out, "  %lo64 = zext i32 %lo32 to i64")
    codegen_util::cg_emit_line(out, "  %size = or i64 %hi.shl, %lo64")
    codegen_util::cg_emit_line(out, "  ret i64 %size")
    codegen_util::cg_emit_line(out, "err:")
    codegen_util::cg_emit_line(out, "  ret i64 -1")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
  codegen_util::cg_emit_line(out, "define i64 @qz_file_size(i64 %p) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ps = inttoptr i64 %p to ptr")
  codegen_util::cg_emit_line(out, "  %stat.buf = alloca [256 x i8]")
  codegen_util::cg_emit_line(out, "  %stat.ptr = bitcast [256 x i8]* %stat.buf to ptr")
