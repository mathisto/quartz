  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %thd.mtx)")
  codegen_util::cg_emit_line(out, "  br label %thd_ret_null")
  codegen_util::cg_emit_line(out, "thd_ret_null:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
