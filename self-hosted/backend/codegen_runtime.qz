  # __qz_timer_heap_drain_one(now_ns) -> i64
  # If root.deadline ≤ now_ns: pop root (swap-with-last + sift-down) and
  # return the popped task pointer. Tombstones (task==0) are popped
  # silently and the loop re-checks — caller sees only real tasks. If
  # heap is empty or root is in the future: return 0. Single lock
  # acquisition per call; caller loops on non-zero returns.
  codegen_util::cg_emit_line(out, "define i64 @__qz_timer_heap_drain_one(i64 %thd.now) nounwind {")
  codegen_util::cg_emit_line(out, "thd_entry:")
  codegen_util::cg_emit_line(out, "  %thd.mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %thd.mtx.i = load i64, ptr %thd.mtx.p")
  codegen_util::cg_emit_line(out, "  %thd.has_mtx = icmp ne i64 %thd.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %thd.has_mtx, label %thd_lock, label %thd_ret_null")
  codegen_util::cg_emit_line(out, "thd_lock:")
  codegen_util::cg_emit_line(out, "  %thd.mtx = inttoptr i64 %thd.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %thd.mtx)")
  codegen_util::cg_emit_line(out, "  %thd.cnt.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %thd.arr.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %thd.arr.i = load i64, ptr %thd.arr.p")
  codegen_util::cg_emit_line(out, "  %thd.arr = inttoptr i64 %thd.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %thd_drain_loop")
  codegen_util::cg_emit_line(out, "thd_drain_loop:")
  codegen_util::cg_emit_line(out, "  %thd.cnt = load i64, ptr %thd.cnt.p")
  codegen_util::cg_emit_line(out, "  %thd.empty = icmp eq i64 %thd.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %thd.empty, label %thd_unlock_null, label %thd_check_root")
  codegen_util::cg_emit_line(out, "thd_check_root:")
  codegen_util::cg_emit_line(out, "  %thd.root_d.gep = getelementptr i64, ptr %thd.arr, i64 0")
  codegen_util::cg_emit_line(out, "  %thd.root_d = load i64, ptr %thd.root_d.gep")
  codegen_util::cg_emit_line(out, "  %thd.expired = icmp sle i64 %thd.root_d, %thd.now")
  codegen_util::cg_emit_line(out, "  br i1 %thd.expired, label %thd_pop, label %thd_unlock_null")
