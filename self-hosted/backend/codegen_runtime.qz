  end
  codegen_util::cg_emit_line(out, "  %mt.p64 = bitcast ptr %mt.ptr to ptr")
  codegen_util::cg_emit_line(out, "  %mt = load i64, ptr %mt.p64")
  codegen_util::cg_emit_line(out, "  ret i64 %mt")
  codegen_util::cg_emit_line(out, "err:")
  codegen_util::cg_emit_line(out, "  ret i64 -1")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  end

  # readdir(path): return Vec<String> of directory entries
  codegen_util::cg_emit_line(out, "define i64 @qz_readdir(i64 %p) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ps = inttoptr i64 %p to ptr")
  codegen_util::cg_emit_line(out, "  %hdr.raw = call ptr @__qz_alloc(i64 32)")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %hdr.raw to ptr")
  codegen_util::cg_emit_line(out, "  store i64 16, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.raw = call ptr @__qz_alloc(i64 128)")
  codegen_util::cg_emit_line(out, "  %data.i = ptrtoint ptr %data.raw to i64")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 %data.i, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %ew.ptr = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 8, ptr %ew.ptr")
  codegen_util::cg_emit_line(out, "  %vec.i = ptrtoint ptr %hdr.raw to i64")
  codegen_util::cg_emit_line(out, "  %dir = call ptr @opendir(ptr %ps)")
  codegen_util::cg_emit_line(out, "  %dir.null = icmp eq ptr %dir, null")
  codegen_util::cg_emit_line(out, "  br i1 %dir.null, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %ent = call ptr @readdir(ptr %dir)")
  codegen_util::cg_emit_line(out, "  %ent.null = icmp eq ptr %ent, null")
  codegen_util::cg_emit_line(out, "  br i1 %ent.null, label %close, label %process")
  codegen_util::cg_emit_line(out, "process:")
  # d_name offset: 21 on macOS, 19 on Linux
  if str_contains(target, "linux")
    codegen_util::cg_emit_line(out, "  %name.ptr = getelementptr i8, ptr %ent, i64 19")
  else
    codegen_util::cg_emit_line(out, "  %name.ptr = getelementptr i8, ptr %ent, i64 21")
  end
  codegen_util::cg_emit_line(out, "  %name.dup = call ptr @qz_wrap_cstr(ptr %name.ptr)")
  codegen_util::cg_emit_line(out, "  %name.i = ptrtoint ptr %name.dup to i64")
  codegen_util::cg_emit_line(out, "  call void @qz_vec_push_runtime(i64 %vec.i, i64 %name.i)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "close:")
  codegen_util::cg_emit_line(out, "  call i32 @closedir(ptr %dir)")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret i64 %vec.i")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # vec push helper for runtime use (used by readdir)
  codegen_util::cg_emit_line(out, "define void @qz_vec_push_runtime(i64 %vec, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %full = icmp sge i64 %size, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %full, label %grow, label %store")
  codegen_util::cg_emit_line(out, "grow:")
  codegen_util::cg_emit_line(out, "  %newcap.raw = mul i64 %cap, 2")
  codegen_util::cg_emit_line(out, "  %newcap.small = icmp slt i64 %newcap.raw, 4")
  codegen_util::cg_emit_line(out, "  %newcap = select i1 %newcap.small, i64 4, i64 %newcap.raw")
  codegen_util::cg_emit_line(out, "  store i64 %newcap, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %data.ptr2 = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i2 = load i64, ptr %data.ptr2")
  codegen_util::cg_emit_line(out, "  %data2 = inttoptr i64 %data.i2 to ptr")
  codegen_util::cg_emit_line(out, "  %newbytes = mul i64 %newcap, 8")
  codegen_util::cg_emit_line(out, "  %oldbytes = mul i64 %cap, 8")
  codegen_util::cg_emit_line(out, "  %newdata = call ptr @__qz_realloc(ptr %data2, i64 %oldbytes, i64 %newbytes)")
  codegen_util::cg_emit_line(out, "  %newdata.i = ptrtoint ptr %newdata to i64")
  codegen_util::cg_emit_line(out, "  store i64 %newdata.i, ptr %data.ptr2")
  codegen_util::cg_emit_line(out, "  br label %store")
  codegen_util::cg_emit_line(out, "store:")
  codegen_util::cg_emit_line(out, "  %data.ptr3 = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i3 = load i64, ptr %data.ptr3")
  codegen_util::cg_emit_line(out, "  %data3 = inttoptr i64 %data.i3 to ptr")
  codegen_util::cg_emit_line(out, "  %size2 = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %data3, i64 %size2")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %slot")
  codegen_util::cg_emit_line(out, "  %newsize = add i64 %size2, 1")
  codegen_util::cg_emit_line(out, "  store i64 %newsize, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # UTF-8 helpers
  # str_len_utf8: count codepoints (non-continuation bytes)
  codegen_util::cg_emit_line(out, "define i64 @qz_str_len_utf8(ptr %ptr, i64 %blen) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %cont ]")
  codegen_util::cg_emit_line(out, "  %count = phi i64 [ 0, %entry ], [ %count.next, %cont ]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %body")
  codegen_util::cg_emit_line(out, "body:")
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %b = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %bz = zext i8 %b to i64")
  codegen_util::cg_emit_line(out, "  %masked = and i64 %bz, 192")
  codegen_util::cg_emit_line(out, "  %is_cont = icmp eq i64 %masked, 128")
  codegen_util::cg_emit_line(out, "  %inc = select i1 %is_cont, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %count.next = add i64 %count, %inc")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  ret i64 %count")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # str_codepoint_at: decode the codepoint that STARTS at byte offset
  # `byte_idx`. O(1). Mirrors the byte-offset shape of `str_byte_at`.
  # If the byte at `byte_idx` is a UTF-8 continuation byte (10xxxxxx),
  # behavior is undefined — callers are expected to walk by
  # str_codepoint_byte_len strides starting from a known boundary.
  codegen_util::cg_emit_line(out, "define i64 @qz_str_codepoint_at_byte(ptr %ptr, i64 %blen, i64 %byte_idx) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %oob = icmp uge i64 %byte_idx, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %oob, label %ret_zero, label %decode")
  codegen_util::cg_emit_line(out, "ret_zero:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "decode:")
  codegen_util::cg_emit_line(out, "  %dp = getelementptr i8, ptr %ptr, i64 %byte_idx")
  codegen_util::cg_emit_line(out, "  %db = load i8, ptr %dp")
  codegen_util::cg_emit_line(out, "  %dbz = zext i8 %db to i64")
  codegen_util::cg_emit_line(out, "  %is1 = icmp ult i64 %dbz, 128")
  codegen_util::cg_emit_line(out, "  br i1 %is1, label %ret1, label %check2")
  codegen_util::cg_emit_line(out, "ret1:")
  codegen_util::cg_emit_line(out, "  ret i64 %dbz")
  codegen_util::cg_emit_line(out, "check2:")
  codegen_util::cg_emit_line(out, "  %is2 = icmp ult i64 %dbz, 224")
  codegen_util::cg_emit_line(out, "  br i1 %is2, label %do2, label %check3")
  codegen_util::cg_emit_line(out, "do2:")
  codegen_util::cg_emit_line(out, "  %i2.1 = add i64 %byte_idx, 1")
  codegen_util::cg_emit_line(out, "  %p2.1 = getelementptr i8, ptr %ptr, i64 %i2.1")
  codegen_util::cg_emit_line(out, "  %b2.1 = load i8, ptr %p2.1")
  codegen_util::cg_emit_line(out, "  %b2.1z = zext i8 %b2.1 to i64")
  codegen_util::cg_emit_line(out, "  %cp2.a = and i64 %dbz, 31")
  codegen_util::cg_emit_line(out, "  %cp2.a1 = shl i64 %cp2.a, 6")
  codegen_util::cg_emit_line(out, "  %cp2.b = and i64 %b2.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp2 = or i64 %cp2.a1, %cp2.b")
  codegen_util::cg_emit_line(out, "  ret i64 %cp2")
  codegen_util::cg_emit_line(out, "check3:")
  codegen_util::cg_emit_line(out, "  %is3 = icmp ult i64 %dbz, 240")
  codegen_util::cg_emit_line(out, "  br i1 %is3, label %do3, label %do4")
  codegen_util::cg_emit_line(out, "do3:")
  codegen_util::cg_emit_line(out, "  %i3.1 = add i64 %byte_idx, 1")
  codegen_util::cg_emit_line(out, "  %i3.2 = add i64 %byte_idx, 2")
  codegen_util::cg_emit_line(out, "  %p3.1 = getelementptr i8, ptr %ptr, i64 %i3.1")
  codegen_util::cg_emit_line(out, "  %p3.2 = getelementptr i8, ptr %ptr, i64 %i3.2")
  codegen_util::cg_emit_line(out, "  %b3.1 = load i8, ptr %p3.1")
  codegen_util::cg_emit_line(out, "  %b3.2 = load i8, ptr %p3.2")
  codegen_util::cg_emit_line(out, "  %b3.1z = zext i8 %b3.1 to i64")
  codegen_util::cg_emit_line(out, "  %b3.2z = zext i8 %b3.2 to i64")
  codegen_util::cg_emit_line(out, "  %cp3.a = and i64 %dbz, 15")
  codegen_util::cg_emit_line(out, "  %cp3.a1 = shl i64 %cp3.a, 12")
  codegen_util::cg_emit_line(out, "  %cp3.b = and i64 %b3.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.b1 = shl i64 %cp3.b, 6")
  codegen_util::cg_emit_line(out, "  %cp3.c = and i64 %b3.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.ab = or i64 %cp3.a1, %cp3.b1")
  codegen_util::cg_emit_line(out, "  %cp3 = or i64 %cp3.ab, %cp3.c")
  codegen_util::cg_emit_line(out, "  ret i64 %cp3")
  codegen_util::cg_emit_line(out, "do4:")
  codegen_util::cg_emit_line(out, "  %i4.1 = add i64 %byte_idx, 1")
  codegen_util::cg_emit_line(out, "  %i4.2 = add i64 %byte_idx, 2")
  codegen_util::cg_emit_line(out, "  %i4.3 = add i64 %byte_idx, 3")
  codegen_util::cg_emit_line(out, "  %p4.1 = getelementptr i8, ptr %ptr, i64 %i4.1")
  codegen_util::cg_emit_line(out, "  %p4.2 = getelementptr i8, ptr %ptr, i64 %i4.2")
  codegen_util::cg_emit_line(out, "  %p4.3 = getelementptr i8, ptr %ptr, i64 %i4.3")
  codegen_util::cg_emit_line(out, "  %b4.1 = load i8, ptr %p4.1")
  codegen_util::cg_emit_line(out, "  %b4.2 = load i8, ptr %p4.2")
  codegen_util::cg_emit_line(out, "  %b4.3 = load i8, ptr %p4.3")
  codegen_util::cg_emit_line(out, "  %b4.1z = zext i8 %b4.1 to i64")
  codegen_util::cg_emit_line(out, "  %b4.2z = zext i8 %b4.2 to i64")
  codegen_util::cg_emit_line(out, "  %b4.3z = zext i8 %b4.3 to i64")
  codegen_util::cg_emit_line(out, "  %cp4.a = and i64 %dbz, 7")
  codegen_util::cg_emit_line(out, "  %cp4.a1 = shl i64 %cp4.a, 18")
  codegen_util::cg_emit_line(out, "  %cp4.b = and i64 %b4.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.b1 = shl i64 %cp4.b, 12")
  codegen_util::cg_emit_line(out, "  %cp4.c = and i64 %b4.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.c1 = shl i64 %cp4.c, 6")
  codegen_util::cg_emit_line(out, "  %cp4.d = and i64 %b4.3z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.ab = or i64 %cp4.a1, %cp4.b1")
  codegen_util::cg_emit_line(out, "  %cp4.cd = or i64 %cp4.c1, %cp4.d")
  codegen_util::cg_emit_line(out, "  %cp4 = or i64 %cp4.ab, %cp4.cd")
  codegen_util::cg_emit_line(out, "  ret i64 %cp4")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # str_codepoint_byte_len: number of UTF-8 bytes in the codepoint
  # starting at `byte_idx`. Returns 1/2/3/4 for valid leads, 1 for
  # continuation bytes (best-effort recovery).
  codegen_util::cg_emit_line(out, "define i64 @qz_str_codepoint_byte_len(ptr %ptr, i64 %blen, i64 %byte_idx) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %oob = icmp uge i64 %byte_idx, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %oob, label %ret_zero, label %compute")
  codegen_util::cg_emit_line(out, "ret_zero:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "compute:")
  codegen_util::cg_emit_line(out, "  %lp = getelementptr i8, ptr %ptr, i64 %byte_idx")
  codegen_util::cg_emit_line(out, "  %lb = load i8, ptr %lp")
  codegen_util::cg_emit_line(out, "  %lbz = zext i8 %lb to i64")
  codegen_util::cg_emit_line(out, "  %lt128 = icmp ult i64 %lbz, 128")
  codegen_util::cg_emit_line(out, "  %lt224 = icmp ult i64 %lbz, 224")
  codegen_util::cg_emit_line(out, "  %lt240 = icmp ult i64 %lbz, 240")
  codegen_util::cg_emit_line(out, "  %s.a = select i1 %lt128, i64 1, i64 2")
  codegen_util::cg_emit_line(out, "  %s.b = select i1 %lt224, i64 %s.a, i64 3")
  codegen_util::cg_emit_line(out, "  %s = select i1 %lt240, i64 %s.b, i64 4")
  codegen_util::cg_emit_line(out, "  ret i64 %s")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_codepoint_at: the n-th codepoint. O(n) walk.
  # User-facing intrinsic names that bind to this helper are
  # `str_codepoint_nth` (canonical) and `str_char_at` (transitional
  # alias). Helper kept under its historical C name so the bootstrap
  # chain stays byte-identical across the rename — internal callers
  # don't see the user-visible rename.
  codegen_util::cg_emit_line(out, "define i64 @qz_str_codepoint_at(ptr %ptr, i64 %blen, i64 %cp_idx) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %advance ]")
  codegen_util::cg_emit_line(out, "  %cp_count = phi i64 [ 0, %entry ], [ %cp_count.next, %advance ]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %not_found, label %body")
  codegen_util::cg_emit_line(out, "body:")
  codegen_util::cg_emit_line(out, "  %found = icmp eq i64 %cp_count, %cp_idx")
  codegen_util::cg_emit_line(out, "  br i1 %found, label %decode, label %skip")
  codegen_util::cg_emit_line(out, "decode:")
  codegen_util::cg_emit_line(out, "  %dp = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %db = load i8, ptr %dp")
  codegen_util::cg_emit_line(out, "  %dbz = zext i8 %db to i64")
  codegen_util::cg_emit_line(out, "  %is1 = icmp ult i64 %dbz, 128")
  codegen_util::cg_emit_line(out, "  br i1 %is1, label %ret1, label %check2")
  codegen_util::cg_emit_line(out, "ret1:")
  codegen_util::cg_emit_line(out, "  ret i64 %dbz")
  codegen_util::cg_emit_line(out, "check2:")
  codegen_util::cg_emit_line(out, "  %is2 = icmp ult i64 %dbz, 224")
  codegen_util::cg_emit_line(out, "  br i1 %is2, label %do2, label %check3")
  codegen_util::cg_emit_line(out, "do2:")
  codegen_util::cg_emit_line(out, "  %i2.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %p2.1 = getelementptr i8, ptr %ptr, i64 %i2.1")
  codegen_util::cg_emit_line(out, "  %b2.1 = load i8, ptr %p2.1")
  codegen_util::cg_emit_line(out, "  %b2.1z = zext i8 %b2.1 to i64")
  codegen_util::cg_emit_line(out, "  %cp2.a = and i64 %dbz, 31")
  codegen_util::cg_emit_line(out, "  %cp2.a1 = shl i64 %cp2.a, 6")
  codegen_util::cg_emit_line(out, "  %cp2.b = and i64 %b2.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp2 = or i64 %cp2.a1, %cp2.b")
  codegen_util::cg_emit_line(out, "  ret i64 %cp2")
  codegen_util::cg_emit_line(out, "check3:")
  codegen_util::cg_emit_line(out, "  %is3 = icmp ult i64 %dbz, 240")
  codegen_util::cg_emit_line(out, "  br i1 %is3, label %do3, label %do4")
  codegen_util::cg_emit_line(out, "do3:")
  codegen_util::cg_emit_line(out, "  %i3.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i3.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %p3.1 = getelementptr i8, ptr %ptr, i64 %i3.1")
  codegen_util::cg_emit_line(out, "  %p3.2 = getelementptr i8, ptr %ptr, i64 %i3.2")
  codegen_util::cg_emit_line(out, "  %b3.1 = load i8, ptr %p3.1")
  codegen_util::cg_emit_line(out, "  %b3.2 = load i8, ptr %p3.2")
  codegen_util::cg_emit_line(out, "  %b3.1z = zext i8 %b3.1 to i64")
  codegen_util::cg_emit_line(out, "  %b3.2z = zext i8 %b3.2 to i64")
  codegen_util::cg_emit_line(out, "  %cp3.a = and i64 %dbz, 15")
  codegen_util::cg_emit_line(out, "  %cp3.a1 = shl i64 %cp3.a, 12")
  codegen_util::cg_emit_line(out, "  %cp3.b = and i64 %b3.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.b1 = shl i64 %cp3.b, 6")
  codegen_util::cg_emit_line(out, "  %cp3.c = and i64 %b3.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.ab = or i64 %cp3.a1, %cp3.b1")
  codegen_util::cg_emit_line(out, "  %cp3 = or i64 %cp3.ab, %cp3.c")
  codegen_util::cg_emit_line(out, "  ret i64 %cp3")
  codegen_util::cg_emit_line(out, "do4:")
  codegen_util::cg_emit_line(out, "  %i4.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i4.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %i4.3 = add i64 %i, 3")
  codegen_util::cg_emit_line(out, "  %p4.1 = getelementptr i8, ptr %ptr, i64 %i4.1")
  codegen_util::cg_emit_line(out, "  %p4.2 = getelementptr i8, ptr %ptr, i64 %i4.2")
  codegen_util::cg_emit_line(out, "  %p4.3 = getelementptr i8, ptr %ptr, i64 %i4.3")
  codegen_util::cg_emit_line(out, "  %b4.1 = load i8, ptr %p4.1")
  codegen_util::cg_emit_line(out, "  %b4.2 = load i8, ptr %p4.2")
  codegen_util::cg_emit_line(out, "  %b4.3 = load i8, ptr %p4.3")
  codegen_util::cg_emit_line(out, "  %b4.1z = zext i8 %b4.1 to i64")
  codegen_util::cg_emit_line(out, "  %b4.2z = zext i8 %b4.2 to i64")
  codegen_util::cg_emit_line(out, "  %b4.3z = zext i8 %b4.3 to i64")
  codegen_util::cg_emit_line(out, "  %cp4.a = and i64 %dbz, 7")
  codegen_util::cg_emit_line(out, "  %cp4.a1 = shl i64 %cp4.a, 18")
  codegen_util::cg_emit_line(out, "  %cp4.b = and i64 %b4.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.b1 = shl i64 %cp4.b, 12")
  codegen_util::cg_emit_line(out, "  %cp4.c = and i64 %b4.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.c1 = shl i64 %cp4.c, 6")
  codegen_util::cg_emit_line(out, "  %cp4.d = and i64 %b4.3z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.ab = or i64 %cp4.a1, %cp4.b1")
  codegen_util::cg_emit_line(out, "  %cp4.cd = or i64 %cp4.c1, %cp4.d")
  codegen_util::cg_emit_line(out, "  %cp4 = or i64 %cp4.ab, %cp4.cd")
  codegen_util::cg_emit_line(out, "  ret i64 %cp4")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  %sp = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %sb = load i8, ptr %sp")
  codegen_util::cg_emit_line(out, "  %sbz = zext i8 %sb to i64")
  codegen_util::cg_emit_line(out, "  %sk1 = icmp ult i64 %sbz, 128")
  codegen_util::cg_emit_line(out, "  %sk2 = icmp ult i64 %sbz, 224")
  codegen_util::cg_emit_line(out, "  %sk3 = icmp ult i64 %sbz, 240")
  codegen_util::cg_emit_line(out, "  %step.a = select i1 %sk1, i64 1, i64 2")
  codegen_util::cg_emit_line(out, "  %step.b = select i1 %sk2, i64 %step.a, i64 3")
  codegen_util::cg_emit_line(out, "  %step = select i1 %sk3, i64 %step.b, i64 4")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, %step")
  codegen_util::cg_emit_line(out, "  %cp_count.next = add i64 %cp_count, 1")
  codegen_util::cg_emit_line(out, "  br label %advance")
  codegen_util::cg_emit_line(out, "advance:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "not_found:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # str_from_codepoint: encode codepoint as UTF-8 string
  codegen_util::cg_emit_line(out, "define i64 @qz_str_from_codepoint(i64 %cp) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @__qz_alloc(i64 5)")
  codegen_util::cg_emit_line(out, "  %is1 = icmp ult i64 %cp, 128")
  codegen_util::cg_emit_line(out, "  br i1 %is1, label %enc1, label %check2")
  codegen_util::cg_emit_line(out, "enc1:")
  codegen_util::cg_emit_line(out, "  %b1 = trunc i64 %cp to i8")
  codegen_util::cg_emit_line(out, "  store i8 %b1, ptr %buf")
  codegen_util::cg_emit_line(out, "  %buf1.1 = getelementptr i8, ptr %buf, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf1.1")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "check2:")
  codegen_util::cg_emit_line(out, "  %is2 = icmp ult i64 %cp, 2048")
  codegen_util::cg_emit_line(out, "  br i1 %is2, label %enc2, label %check3")
  codegen_util::cg_emit_line(out, "enc2:")
  codegen_util::cg_emit_line(out, "  %e2.a = lshr i64 %cp, 6")
  codegen_util::cg_emit_line(out, "  %e2.a1 = or i64 %e2.a, 192")
  codegen_util::cg_emit_line(out, "  %e2.b = and i64 %cp, 63")
  codegen_util::cg_emit_line(out, "  %e2.b1 = or i64 %e2.b, 128")
  codegen_util::cg_emit_line(out, "  %e2.a2 = trunc i64 %e2.a1 to i8")
  codegen_util::cg_emit_line(out, "  %e2.b2 = trunc i64 %e2.b1 to i8")
  codegen_util::cg_emit_line(out, "  store i8 %e2.a2, ptr %buf")
  codegen_util::cg_emit_line(out, "  %buf2.1 = getelementptr i8, ptr %buf, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 %e2.b2, ptr %buf2.1")
  codegen_util::cg_emit_line(out, "  %buf2.2 = getelementptr i8, ptr %buf, i64 2")
  codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf2.2")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "check3:")
  codegen_util::cg_emit_line(out, "  %is3 = icmp ult i64 %cp, 65536")
  codegen_util::cg_emit_line(out, "  br i1 %is3, label %enc3, label %enc4")
  codegen_util::cg_emit_line(out, "enc3:")
  codegen_util::cg_emit_line(out, "  %e3.a = lshr i64 %cp, 12")
  codegen_util::cg_emit_line(out, "  %e3.a1 = or i64 %e3.a, 224")
  codegen_util::cg_emit_line(out, "  %e3.b = lshr i64 %cp, 6")
  codegen_util::cg_emit_line(out, "  %e3.b0 = and i64 %e3.b, 63")
  codegen_util::cg_emit_line(out, "  %e3.b1 = or i64 %e3.b0, 128")
  codegen_util::cg_emit_line(out, "  %e3.c = and i64 %cp, 63")
  codegen_util::cg_emit_line(out, "  %e3.c1 = or i64 %e3.c, 128")
  codegen_util::cg_emit_line(out, "  %e3.a2 = trunc i64 %e3.a1 to i8")
  codegen_util::cg_emit_line(out, "  %e3.b2 = trunc i64 %e3.b1 to i8")
  codegen_util::cg_emit_line(out, "  %e3.c2 = trunc i64 %e3.c1 to i8")
  codegen_util::cg_emit_line(out, "  store i8 %e3.a2, ptr %buf")
  codegen_util::cg_emit_line(out, "  %buf3.1 = getelementptr i8, ptr %buf, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 %e3.b2, ptr %buf3.1")
  codegen_util::cg_emit_line(out, "  %buf3.2 = getelementptr i8, ptr %buf, i64 2")
  codegen_util::cg_emit_line(out, "  store i8 %e3.c2, ptr %buf3.2")
  codegen_util::cg_emit_line(out, "  %buf3.3 = getelementptr i8, ptr %buf, i64 3")
  codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf3.3")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "enc4:")
  codegen_util::cg_emit_line(out, "  %e4.a = lshr i64 %cp, 18")
  codegen_util::cg_emit_line(out, "  %e4.a1 = or i64 %e4.a, 240")
  codegen_util::cg_emit_line(out, "  %e4.b = lshr i64 %cp, 12")
  codegen_util::cg_emit_line(out, "  %e4.b0 = and i64 %e4.b, 63")
  codegen_util::cg_emit_line(out, "  %e4.b1 = or i64 %e4.b0, 128")
  codegen_util::cg_emit_line(out, "  %e4.c = lshr i64 %cp, 6")
  codegen_util::cg_emit_line(out, "  %e4.c0 = and i64 %e4.c, 63")
  codegen_util::cg_emit_line(out, "  %e4.c1 = or i64 %e4.c0, 128")
  codegen_util::cg_emit_line(out, "  %e4.d = and i64 %cp, 63")
  codegen_util::cg_emit_line(out, "  %e4.d1 = or i64 %e4.d, 128")
  codegen_util::cg_emit_line(out, "  %e4.a2 = trunc i64 %e4.a1 to i8")
  codegen_util::cg_emit_line(out, "  %e4.b2 = trunc i64 %e4.b1 to i8")
  codegen_util::cg_emit_line(out, "  %e4.c2 = trunc i64 %e4.c1 to i8")
  codegen_util::cg_emit_line(out, "  %e4.d2 = trunc i64 %e4.d1 to i8")
  codegen_util::cg_emit_line(out, "  store i8 %e4.a2, ptr %buf")
  codegen_util::cg_emit_line(out, "  %buf4.1 = getelementptr i8, ptr %buf, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 %e4.b2, ptr %buf4.1")
  codegen_util::cg_emit_line(out, "  %buf4.2 = getelementptr i8, ptr %buf, i64 2")
  codegen_util::cg_emit_line(out, "  store i8 %e4.c2, ptr %buf4.2")
  codegen_util::cg_emit_line(out, "  %buf4.3 = getelementptr i8, ptr %buf, i64 3")
  codegen_util::cg_emit_line(out, "  store i8 %e4.d2, ptr %buf4.3")
  codegen_util::cg_emit_line(out, "  %buf4.4 = getelementptr i8, ptr %buf, i64 4")
  codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf4.4")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %pstr = call ptr @qz_wrap_cstr(ptr %buf)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %buf)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %pstr to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_capture_output_start: redirect stdout to pipe, return packed handle.
  # Windows: stub returning -1 (POSIX pipe not in mingw-w64; the Windows path
  # is CreatePipe + handle redirection, filed for post-Phase-1).
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "define i64 @qz_capture_output_start() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  ret i64 -1")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
  codegen_util::cg_emit_line(out, "define i64 @qz_capture_output_start() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %pfd = alloca [2 x i32]")
  codegen_util::cg_emit_line(out, "  %pfd_ptr = bitcast [2 x i32]* %pfd to ptr")
  codegen_util::cg_emit_line(out, "  %pipe_ret = call i32 @pipe(ptr %pfd_ptr)")
  codegen_util::cg_emit_line(out, "  %read_ptr = getelementptr i32, ptr %pfd_ptr, i32 0")
  codegen_util::cg_emit_line(out, "  %read_fd = load i32, ptr %read_ptr")
  codegen_util::cg_emit_line(out, "  %write_ptr = getelementptr i32, ptr %pfd_ptr, i32 1")
  codegen_util::cg_emit_line(out, "  %write_fd = load i32, ptr %write_ptr")
  codegen_util::cg_emit_line(out, "  %saved_fd = call i32 @dup(i32 1)")
  codegen_util::cg_emit_line(out, "  call i32 @fflush(ptr null)")
  codegen_util::cg_emit_line(out, "  %dup2_ret = call i32 @dup2(i32 %write_fd, i32 1)")
  codegen_util::cg_emit_line(out, "  call i32 @close(i32 %write_fd)")
  codegen_util::cg_emit_line(out, "  %saved_i64 = zext i32 %saved_fd to i64")
  codegen_util::cg_emit_line(out, "  %shifted = shl i64 %saved_i64, 32")
  codegen_util::cg_emit_line(out, "  %read_i64 = zext i32 %read_fd to i64")
  codegen_util::cg_emit_line(out, "  %handle = or i64 %shifted, %read_i64")
  codegen_util::cg_emit_line(out, "  ret i64 %handle")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  end

  # qz_capture_output_end: restore stdout, read captured output as string
  codegen_util::cg_emit_line(out, "define i64 @qz_capture_output_end(i64 %handle) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call i32 @fflush(ptr null)")
  codegen_util::cg_emit_line(out, "  %shifted = lshr i64 %handle, 32")
  codegen_util::cg_emit_line(out, "  %saved_fd = trunc i64 %shifted to i32")
  codegen_util::cg_emit_line(out, "  %read_fd = trunc i64 %handle to i32")
  codegen_util::cg_emit_line(out, "  %dup2_ret = call i32 @dup2(i32 %saved_fd, i32 1)")
  codegen_util::cg_emit_line(out, "  call i32 @close(i32 %saved_fd)")
  codegen_util::cg_emit_line(out, "  %tmp = call ptr @__qz_alloc(i64 65536)")
  codegen_util::cg_emit_line(out, "  %nread = call i64 @read(i32 %read_fd, ptr %tmp, i64 65535)")
  codegen_util::cg_emit_line(out, "  call i32 @close(i32 %read_fd)")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %nread)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %tmp, i64 %nread)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %tmp)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_redirect_stderr_to_file: open `path` for write, swap stderr's
  # underlying fd to point at it, return a saved-fd token the caller passes
  # to @qz_restore_stderr. Uses fopen("w") + fileno + dup2 rather than raw
  # open() because O_WRONLY|O_CREAT|O_TRUNC flag values differ across
  # macOS (1537) and Linux (577); fopen sidesteps the portability split.
  # Returns -1 if fopen failed; caller must check before calling restore.
  codegen_util::cg_emit_line(out, "define i64 @qz_redirect_stderr_to_file(ptr %path) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %stderr = call ptr @__acrt_iob_func(i32 2)")
  elsif str_contains(target, "linux") or str_contains(target, "gnu")
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @stderr")
  else
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @__stderrp")
  end
  codegen_util::cg_emit_line(out, "  call i32 @fflush(ptr %stderr)")
  codegen_util::cg_emit_line(out, "  %stderr_fd = call i32 @fileno(ptr %stderr)")
  codegen_util::cg_emit_line(out, "  %saved_fd = call i32 @dup(i32 %stderr_fd)")
  codegen_util::cg_emit_line(out, "  %new_fp = call ptr @fopen(ptr %path, ptr getelementptr([2 x i8], [2 x i8]* @.write_mode, i64 0, i64 0))")
  codegen_util::cg_emit_line(out, "  %fp_null = icmp eq ptr %new_fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fp_null, label %fail, label %do_dup")
  codegen_util::cg_emit_line(out, "do_dup:")
  codegen_util::cg_emit_line(out, "  %new_fd = call i32 @fileno(ptr %new_fp)")
  codegen_util::cg_emit_line(out, "  %dup2_ret = call i32 @dup2(i32 %new_fd, i32 %stderr_fd)")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %new_fp)")
  codegen_util::cg_emit_line(out, "  %saved64 = sext i32 %saved_fd to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %saved64")
  codegen_util::cg_emit_line(out, "fail:")
  codegen_util::cg_emit_line(out, "  call i32 @close(i32 %saved_fd)")
  codegen_util::cg_emit_line(out, "  ret i64 -1")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_restore_stderr: undo a qz_redirect_stderr_to_file. `saved` is the
  # token returned by the redirect; <0 means the redirect itself failed and
  # there's nothing to restore. Idempotent on the failure path.
  codegen_util::cg_emit_line(out, "define i64 @qz_restore_stderr(i64 %saved) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_neg = icmp slt i64 %saved, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_neg, label %skip, label %do_restore")
  codegen_util::cg_emit_line(out, "do_restore:")
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %stderr = call ptr @__acrt_iob_func(i32 2)")
  elsif str_contains(target, "linux") or str_contains(target, "gnu")
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @stderr")
  else
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @__stderrp")
  end
  codegen_util::cg_emit_line(out, "  call i32 @fflush(ptr %stderr)")
  codegen_util::cg_emit_line(out, "  %stderr_fd = call i32 @fileno(ptr %stderr)")
  codegen_util::cg_emit_line(out, "  %saved_fd = trunc i64 %saved to i32")
  codegen_util::cg_emit_line(out, "  %dup2_ret = call i32 @dup2(i32 %saved_fd, i32 %stderr_fd)")
  codegen_util::cg_emit_line(out, "  call i32 @close(i32 %saved_fd)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_bool_to_str: return "true" (len=4) or "false" (len=5)
  # Allocates a length-prefixed string via qz_alloc_str and copies the bytes.
  codegen_util::cg_emit_line(out, "define i64 @qz_bool_to_str(i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_true = icmp ne i64 %b, 0")
  codegen_util::cg_emit_line(out, "  %len = select i1 %is_true, i64 4, i64 5")
  codegen_util::cg_emit_line(out, "  %dst = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  br i1 %is_true, label %write_true, label %write_false")
  codegen_util::cg_emit_line(out, "write_true:")
  # 't' 'r' 'u' 'e'
  codegen_util::cg_emit_line(out, "  %t0 = getelementptr i8, ptr %dst, i64 0")
  codegen_util::cg_emit_line(out, "  store i8 116, ptr %t0")
  codegen_util::cg_emit_line(out, "  %t1 = getelementptr i8, ptr %dst, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 114, ptr %t1")
  codegen_util::cg_emit_line(out, "  %t2 = getelementptr i8, ptr %dst, i64 2")
  codegen_util::cg_emit_line(out, "  store i8 117, ptr %t2")
  codegen_util::cg_emit_line(out, "  %t3 = getelementptr i8, ptr %dst, i64 3")
  codegen_util::cg_emit_line(out, "  store i8 101, ptr %t3")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "write_false:")
  # 'f' 'a' 'l' 's' 'e'
  codegen_util::cg_emit_line(out, "  %f0 = getelementptr i8, ptr %dst, i64 0")
  codegen_util::cg_emit_line(out, "  store i8 102, ptr %f0")
  codegen_util::cg_emit_line(out, "  %f1 = getelementptr i8, ptr %dst, i64 1")
  codegen_util::cg_emit_line(out, "  store i8 97, ptr %f1")
  codegen_util::cg_emit_line(out, "  %f2 = getelementptr i8, ptr %dst, i64 2")
  codegen_util::cg_emit_line(out, "  store i8 108, ptr %f2")
  codegen_util::cg_emit_line(out, "  %f3 = getelementptr i8, ptr %dst, i64 3")
  codegen_util::cg_emit_line(out, "  store i8 115, ptr %f3")
  codegen_util::cg_emit_line(out, "  %f4 = getelementptr i8, ptr %dst, i64 4")
  codegen_util::cg_emit_line(out, "  store i8 101, ptr %f4")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %dst to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  cg_emit_runtime_helpers_3(out, target)
end

## Emit Phase U.11 string UFCS runtime helper functions
def cg_emit_runtime_helpers_3(out: Int, target: String): Void
  # qz_str_is_empty: return 1 if string is empty, 0 otherwise
  codegen_util::cg_emit_line(out, "define i64 @qz_str_is_empty(i64 %s) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %s to ptr")
