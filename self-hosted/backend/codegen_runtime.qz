  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tl.arr, i32 0, i64 6144)")
  codegen_util::cg_emit_line(out, "  %tl.arr.i = ptrtoint ptr %tl.arr to i64")
  codegen_util::cg_emit_line(out, "  %tl.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %tl.arr.i, ptr %tl.arr.ptr")
