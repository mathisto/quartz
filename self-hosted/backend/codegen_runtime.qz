  codegen_util::cg_emit_line(out, "  %ptbl.i = ptrtoint ptr %ptbl.mem to i64")
  codegen_util::cg_emit_line(out, "  %ptbl.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 32")
  codegen_util::cg_emit_line(out, "  store i64 %ptbl.i, ptr %ptbl.ptr")
  # Initialize task-local storage: 256 triples = 768 i64 slots = 6144 bytes
