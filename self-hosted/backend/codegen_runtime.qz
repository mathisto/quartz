  codegen_util::cg_emit_line(out, "  %trd.entry_tid = load i64, ptr %trd.tid.gep")
  codegen_util::cg_emit_line(out, "  %trd.match = icmp eq i64 %trd.entry_tid, %trd.tid")
  codegen_util::cg_emit_line(out, "  br i1 %trd.match, label %trd_mark, label %trd_next")
  codegen_util::cg_emit_line(out, "trd_mark:")
