  #          expired entries via __qz_timer_heap_drain_one before each
  #          GetQueuedCompletionStatusEx call.
  codegen_util::cg_emit_line(out, "define void @__qz_sched_register_timer(i64 %task, i64 %timeout_ms) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  if cg_is_windows(target)
