    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_lookup = internal unnamed_addr constant [16 x i8] c\"cache_op_lookup\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_store = internal unnamed_addr constant [15 x i8] c\"cache_op_store\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_save_pool = internal unnamed_addr constant [19 x i8] c\"cache_op_save_pool\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_load_pool = internal unnamed_addr constant [19 x i8] c\"cache_op_load_pool\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_save_ast = internal unnamed_addr constant [18 x i8] c\"cache_op_save_ast\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_load_ast = internal unnamed_addr constant [18 x i8] c\"cache_op_load_ast\\00\", align 1")
