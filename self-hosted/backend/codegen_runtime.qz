  # __qz_sched_worker(arg): scheduler worker thread
  # Loops: try local queue → global queue → steal → condvar wait
  # Then polls the task frame, handles result (done/yield/io-suspend)
  codegen_util::cg_emit_line(out, "define ptr @__qz_sched_worker(ptr %arg) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Get worker ID from thread arg
  codegen_util::cg_emit_line(out, "  %wid = ptrtoint ptr %arg to i64")
  # Set thread name: "qz-sched-N"
  codegen_util::cg_emit_line(out, "  %tn.buf = alloca [16 x i8]")
  codegen_util::cg_emit_line(out, "  %tn.ptr = bitcast [16 x i8]* %tn.buf to ptr")
  codegen_util::cg_emit_line(out, "  %tn.fmt = getelementptr [13 x i8], [13 x i8]* @.qz_sched_name, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %tn.ptr, i64 16, ptr %tn.fmt, i64 %wid)")
  if str_contains(target, "apple") or str_contains(target, "macos")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_setname_np(ptr %tn.ptr)")
  else
    codegen_util::cg_emit_line(out, "  %tn.self = call i64 @pthread_self()")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_setname_np(i64 %tn.self, ptr %tn.ptr)")
  end
  # Initialize per-worker Chase-Lev deque (lock-free, no mutex)
  # Layout: [0]=buffer, [1]=bottom(atomic), [2]=top(atomic), [3]=unused, [4]=cap=256, [5]=unused, [6]=wid, [7]=rng
  codegen_util::cg_emit_line(out, "  %wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.i = load i64, ptr %wd.p")
  codegen_util::cg_emit_line(out, "  %wd.base = inttoptr i64 %wd.i to ptr")
  codegen_util::cg_emit_line(out, "  %wd.off = mul i64 %wid, 12")
  codegen_util::cg_emit_line(out, "  %wd.slot = getelementptr i64, ptr %wd.base, i64 %wd.off")
  # Allocate local queue: 256 slots * 8 bytes = 2048
  codegen_util::cg_emit_line(out, "  %lq.mem = call ptr @__qz_alloc(i64 2048)")
  codegen_util::cg_emit_line(out, "  %lq.i = ptrtoint ptr %lq.mem to i64")
  codegen_util::cg_emit_line(out, "  store i64 %lq.i, ptr %wd.slot")
  # bottom = 0, top = 0 (implicit from wdata calloc, but explicit for clarity)
  codegen_util::cg_emit_line(out, "  %lb.gep = getelementptr i64, ptr %wd.slot, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %lb.gep")
  codegen_util::cg_emit_line(out, "  %lt.gep = getelementptr i64, ptr %wd.slot, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %lt.gep")
  # cap = 256
  codegen_util::cg_emit_line(out, "  %lcap.gep = getelementptr i64, ptr %wd.slot, i64 4")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %lcap.gep")
  # Store worker_id
  codegen_util::cg_emit_line(out, "  %wid.gep = getelementptr i64, ptr %wd.slot, i64 6")
  codegen_util::cg_emit_line(out, "  store i64 %wid, ptr %wid.gep")
  # Seed RNG state (slot[7]): (wid+1) * 6364136223846793005
  codegen_util::cg_emit_line(out, "  %rng.seed0 = add i64 %wid, 1")
  codegen_util::cg_emit_line(out, "  %rng.seed = mul i64 %rng.seed0, 6364136223846793005")
  codegen_util::cg_emit_line(out, "  %rng.gep = getelementptr i64, ptr %wd.slot, i64 7")
  codegen_util::cg_emit_line(out, "  store i64 %rng.seed, ptr %rng.gep")
  # Create per-worker pipe for idle parking (P27: eliminates thundering herd)
  codegen_util::cg_emit_line(out, "  %pipe.fds = alloca [2 x i32]")
  codegen_util::cg_emit_line(out, "  call i32 @pipe(ptr %pipe.fds)")
  codegen_util::cg_emit_line(out, "  %pipe.rfd.p = getelementptr [2 x i32], [2 x i32]* %pipe.fds, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %pipe.rfd32 = load i32, ptr %pipe.rfd.p")
  codegen_util::cg_emit_line(out, "  %pipe.rfd = sext i32 %pipe.rfd32 to i64")
  codegen_util::cg_emit_line(out, "  %pipe.wfd.p = getelementptr [2 x i32], [2 x i32]* %pipe.fds, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %pipe.wfd32 = load i32, ptr %pipe.wfd.p")
  codegen_util::cg_emit_line(out, "  %pipe.wfd = sext i32 %pipe.wfd32 to i64")
  codegen_util::cg_emit_line(out, "  %pipe.r.gep = getelementptr i64, ptr %wd.slot, i64 10")
  codegen_util::cg_emit_line(out, "  store i64 %pipe.rfd, ptr %pipe.r.gep")
  codegen_util::cg_emit_line(out, "  %pipe.w.gep = getelementptr i64, ptr %wd.slot, i64 11")
  codegen_util::cg_emit_line(out, "  store i64 %pipe.wfd, ptr %pipe.w.gep")
  # Set TLS worker ID (used by spawn fast path)
  codegen_util::cg_emit_line(out, "  store i64 %wid, ptr @__qz_current_worker_id")
  # Allocate jmpbuf for panic capture
  codegen_util::cg_emit_line(out, "  %jmpbuf = alloca [32 x i64]")
  codegen_util::cg_emit_line(out, "  %jmpbuf.ptr = bitcast [32 x i64]* %jmpbuf to ptr")
  # Phase E.1.c (2026-04-28): per-worker effect-handler defaults install.
  # All effect-stack arrays + watermark are TLS, so each worker has its own
  # view starting at top=0. Without this install, user task code's
  # `with E { ... } do ... end` blocks would land at scan position 0
  # without the blessed defaults beneath them, AND the Alloc fast-path
  # watermark would be 0 → every alloc would be considered "user handler"
  # and route through perform unnecessarily. Installing the same blessed
  # set as main here keeps semantics consistent across threads.
  codegen_util::cg_emit_line(out, "  ; E.1.c: per-worker blessed-default install (TLS effect stack)")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_install_defaults()")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  # Check dump flag (CONC.11): if SIGUSR1 was received, dump tasks and clear flag
  codegen_util::cg_emit_line(out, "  %dump.flag = load i64, ptr @__qz_dump_requested")
  codegen_util::cg_emit_line(out, "  %dump.req = icmp ne i64 %dump.flag, 0")
  codegen_util::cg_emit_line(out, "  br i1 %dump.req, label %do_dump, label %no_dump")
  codegen_util::cg_emit_line(out, "do_dump:")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_dump_requested")
  codegen_util::cg_emit_line(out, "  call void @__qz_dump_tasks()")
  codegen_util::cg_emit_line(out, "  br label %no_dump")
  codegen_util::cg_emit_line(out, "no_dump:")
  # === Early shutdown check — catches workers in LIFO/local/steal fast paths ===
  # Workers that dequeue via fast paths (no mutex) never see check_drain.
  # Check slot 8 (official shutdown flag, set by sched_shutdown/graceful timeout).
  codegen_util::cg_emit_line(out, "  %esd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  %esd = load atomic i64, ptr %esd.p monotonic, align 8")
  codegen_util::cg_emit_line(out, "  %esd.set = icmp ne i64 %esd, 0")
  codegen_util::cg_emit_line(out, "  br i1 %esd.set, label %early_exit, label %loop_continue")
  codegen_util::cg_emit_line(out, "early_exit:")
  # exit: expects mutex held — acquire before branching
  codegen_util::cg_emit_line(out, "  %esd.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %esd.mtx.i = load i64, ptr %esd.mtx.p")
  codegen_util::cg_emit_line(out, "  %esd.mtx = inttoptr i64 %esd.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %esd.mtx)")
  codegen_util::cg_emit_line(out, "  br label %exit")
  codegen_util::cg_emit_line(out, "loop_continue:")
  # === Anti-starvation: check global queues periodically ===
  # Per-worker tick counter (wdata[9]). Every 8th iteration, skip local
  # and check global/priority queues. Ensures newly-spawned tasks get picked
  # up promptly even when local queues have yielded tasks.
  codegen_util::cg_emit_line(out, "  %tk.wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %tk.wd.i = load i64, ptr %tk.wd.p")
  codegen_util::cg_emit_line(out, "  %tk.wd = inttoptr i64 %tk.wd.i to ptr")
  codegen_util::cg_emit_line(out, "  %tk.base = mul i64 %wid, 12")
  codegen_util::cg_emit_line(out, "  %tk.slot = getelementptr i64, ptr %tk.wd, i64 %tk.base")
  codegen_util::cg_emit_line(out, "  %tk.p = getelementptr i64, ptr %tk.slot, i64 9")
  codegen_util::cg_emit_line(out, "  %tk.v = load i64, ptr %tk.p")
  codegen_util::cg_emit_line(out, "  %tk.v1 = add i64 %tk.v, 1")
  codegen_util::cg_emit_line(out, "  store i64 %tk.v1, ptr %tk.p")
  codegen_util::cg_emit_line(out, "  %tk.mod = and i64 %tk.v1, 7")
  codegen_util::cg_emit_line(out, "  %tk.check_global = icmp eq i64 %tk.mod, 0")
  # Also check HIGH/CRITICAL — never starve urgent tasks
  codegen_util::cg_emit_line(out, "  %urg.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %urg.c = load atomic i64, ptr %urg.c.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %urg.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %urg.h = load atomic i64, ptr %urg.h.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %urg.sum = add i64 %urg.c, %urg.h")
  codegen_util::cg_emit_line(out, "  %has_urgent = icmp ugt i64 %urg.sum, 0")
  # Skip local if urgent OR every 8th tick (anti-starvation)
  codegen_util::cg_emit_line(out, "  %skip_local = or i1 %has_urgent, %tk.check_global")
  codegen_util::cg_emit_line(out, "  br i1 %skip_local, label %try_global, label %try_lifo")
  # === LIFO slot: check per-worker single-task slot for cache-hot task ===
  # Tokio optimization: recently-woken tasks are stored here for immediate execution.
  # Bounded to 3 consecutive LIFO runs for fairness.
  codegen_util::cg_emit_line(out, "try_lifo:")
  codegen_util::cg_emit_line(out, "  %lifo.p = load i64, ptr @__qz_lifo_task")
  codegen_util::cg_emit_line(out, "  %lifo.has = icmp ne i64 %lifo.p, 0")
  codegen_util::cg_emit_line(out, "  br i1 %lifo.has, label %lifo_check_fairness, label %try_local")
  codegen_util::cg_emit_line(out, "lifo_check_fairness:")
  codegen_util::cg_emit_line(out, "  %lifo.cnt = load i64, ptr @__qz_lifo_count")
  codegen_util::cg_emit_line(out, "  %lifo.fair = icmp ult i64 %lifo.cnt, 3")
  codegen_util::cg_emit_line(out, "  br i1 %lifo.fair, label %lifo_take, label %lifo_overflow")
  codegen_util::cg_emit_line(out, "lifo_take:")
  # Take the LIFO task, increment consecutive count
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_lifo_task")
  codegen_util::cg_emit_line(out, "  %lifo.cnt1 = add i64 %lifo.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %lifo.cnt1, ptr @__qz_lifo_count")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "lifo_overflow:")
  # Fairness limit hit: move LIFO task to local deque, reset counter
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_lifo_task")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_lifo_count")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %wid, i64 %lifo.p)")
  codegen_util::cg_emit_line(out, "  br label %try_local")
  codegen_util::cg_emit_line(out, "try_local:")
  # Normal fast path: check local queue (no lock)
  codegen_util::cg_emit_line(out, "  %lp = call i64 @__qz_sched_local_pop(i64 %wid)")
  codegen_util::cg_emit_line(out, "  %has_lp = icmp ne i64 %lp, 0")
  codegen_util::cg_emit_line(out, "  br i1 %has_lp, label %got_local, label %try_global")
  codegen_util::cg_emit_line(out, "got_local:")
  # Reset LIFO counter (non-LIFO task breaks the streak)
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_lifo_count")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "try_global:")
  # === Phase 8: Atomic pre-check — skip global mutex if all queues empty ===
  # Read NORMAL + priority counts without locking. If all zero AND not shutdown, skip to steal.
  codegen_util::cg_emit_line(out, "  %pre.n.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %pre.n = load atomic i64, ptr %pre.n.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %pre.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %pre.c = load atomic i64, ptr %pre.c.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %pre.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %pre.h = load atomic i64, ptr %pre.h.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %pre.l.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 31")
  codegen_util::cg_emit_line(out, "  %pre.l = load atomic i64, ptr %pre.l.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %pre.sum1 = add i64 %pre.n, %pre.c")
  codegen_util::cg_emit_line(out, "  %pre.sum2 = add i64 %pre.sum1, %pre.h")
  codegen_util::cg_emit_line(out, "  %pre.sum = add i64 %pre.sum2, %pre.l")
  # Also check shutdown flag (must still check even if queues appear empty)
  codegen_util::cg_emit_line(out, "  %pre.sd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  %pre.sd = load atomic i64, ptr %pre.sd.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %pre.anything = add i64 %pre.sum, %pre.sd")
  codegen_util::cg_emit_line(out, "  %pre.skip = icmp eq i64 %pre.anything, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pre.skip, label %try_steal_direct, label %try_global_lock")
  # Direct steal path (no mutex held)
  codegen_util::cg_emit_line(out, "try_steal_direct:")
  codegen_util::cg_emit_line(out, "  %stolen2 = call i64 @__qz_sched_steal(i64 %wid)")
  codegen_util::cg_emit_line(out, "  %has_stolen2 = icmp ne i64 %stolen2, 0")
  codegen_util::cg_emit_line(out, "  br i1 %has_stolen2, label %got_stolen2, label %spin_start")
  codegen_util::cg_emit_line(out, "got_stolen2:")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "try_global_lock:")
  # === Global queue dequeue (need mutex) ===
  codegen_util::cg_emit_line(out, "  %gmtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %gmtx.i = load i64, ptr %gmtx.p")
  codegen_util::cg_emit_line(out, "  %gmtx = inttoptr i64 %gmtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %gmtx)")
  # Check shutdown
  codegen_util::cg_emit_line(out, "  %sd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  %sd = load i64, ptr %sd.p")
  codegen_util::cg_emit_line(out, "  %is_shutdown = icmp ne i64 %sd, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_shutdown, label %check_drain, label %check_work")
  codegen_util::cg_emit_line(out, "check_drain:")
  # Sum all queue counts: NORMAL(slot5) + CRITICAL(slot23) + HIGH(slot27) + LOW(slot31)
  codegen_util::cg_emit_line(out, "  %drain.n.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %drain.n = load i64, ptr %drain.n.p")
  codegen_util::cg_emit_line(out, "  %drain.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %drain.c = load i64, ptr %drain.c.p")
  codegen_util::cg_emit_line(out, "  %drain.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %drain.h = load i64, ptr %drain.h.p")
  codegen_util::cg_emit_line(out, "  %drain.l.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 31")
  codegen_util::cg_emit_line(out, "  %drain.l = load i64, ptr %drain.l.p")
  codegen_util::cg_emit_line(out, "  %drain.s1 = add i64 %drain.n, %drain.c")
  codegen_util::cg_emit_line(out, "  %drain.s2 = add i64 %drain.s1, %drain.h")
  codegen_util::cg_emit_line(out, "  %drain.cnt = add i64 %drain.s2, %drain.l")
  codegen_util::cg_emit_line(out, "  %drain.empty = icmp eq i64 %drain.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %drain.empty, label %exit, label %check_work")
  # Phase 13: Priority-aware dequeue — check CRITICAL, HIGH, NORMAL, LOW in order
  codegen_util::cg_emit_line(out, "check_work:")
  # Check CRITICAL queue (slot 23 = count)
  codegen_util::cg_emit_line(out, "  %pc.cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %pc.cnt = load i64, ptr %pc.cnt.p")
  codegen_util::cg_emit_line(out, "  %pc.has = icmp ugt i64 %pc.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pc.has, label %dq_critical, label %check_high")
  # Check HIGH queue (slot 27 = count)
  codegen_util::cg_emit_line(out, "check_high:")
  codegen_util::cg_emit_line(out, "  %ph.cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %ph.cnt = load i64, ptr %ph.cnt.p")
  codegen_util::cg_emit_line(out, "  %ph.has = icmp ugt i64 %ph.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %ph.has, label %dq_high, label %check_normal")
  # Check NORMAL queue (slot 5 = count, existing)
  codegen_util::cg_emit_line(out, "check_normal:")
  codegen_util::cg_emit_line(out, "  %cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %cnt = load i64, ptr %cnt.p")
  codegen_util::cg_emit_line(out, "  %has_work = icmp ugt i64 %cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %has_work, label %dequeue, label %check_low")
  # Check LOW queue (slot 31 = count)
  codegen_util::cg_emit_line(out, "check_low:")
  codegen_util::cg_emit_line(out, "  %pl.cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 31")
  codegen_util::cg_emit_line(out, "  %pl.cnt = load i64, ptr %pl.cnt.p")
  codegen_util::cg_emit_line(out, "  %pl.has = icmp ugt i64 %pl.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pl.has, label %dq_low, label %try_steal")
  # Dequeue from CRITICAL queue (slots 20=queue, 21=head, 23=count)
  codegen_util::cg_emit_line(out, "dq_critical:")
  codegen_util::cg_emit_line(out, "  %dc.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 21")
  codegen_util::cg_emit_line(out, "  %dc.head = load i64, ptr %dc.h.p")
  codegen_util::cg_emit_line(out, "  %dc.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 20")
  codegen_util::cg_emit_line(out, "  %dc.q.i = load i64, ptr %dc.q.p")
  codegen_util::cg_emit_line(out, "  %dc.q = inttoptr i64 %dc.q.i to ptr")
  codegen_util::cg_emit_line(out, "  %dc.slot = getelementptr i64, ptr %dc.q, i64 %dc.head")
  codegen_util::cg_emit_line(out, "  %dc.task = load i64, ptr %dc.slot")
  codegen_util::cg_emit_line(out, "  %dc.h1 = add i64 %dc.head, 1")
  codegen_util::cg_emit_line(out, "  %dc.hw = and i64 %dc.h1, 65535")
  codegen_util::cg_emit_line(out, "  store i64 %dc.hw, ptr %dc.h.p")
  codegen_util::cg_emit_line(out, "  %dc.c1 = sub i64 %pc.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %dc.c1, ptr %pc.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %dq_prio_done")
  # Dequeue from HIGH queue (slots 24=queue, 25=head, 27=count)
  codegen_util::cg_emit_line(out, "dq_high:")
  codegen_util::cg_emit_line(out, "  %dh.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 25")
  codegen_util::cg_emit_line(out, "  %dh.head = load i64, ptr %dh.h.p")
  codegen_util::cg_emit_line(out, "  %dh.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 24")
  codegen_util::cg_emit_line(out, "  %dh.q.i = load i64, ptr %dh.q.p")
  codegen_util::cg_emit_line(out, "  %dh.q = inttoptr i64 %dh.q.i to ptr")
  codegen_util::cg_emit_line(out, "  %dh.slot = getelementptr i64, ptr %dh.q, i64 %dh.head")
  codegen_util::cg_emit_line(out, "  %dh.task = load i64, ptr %dh.slot")
  codegen_util::cg_emit_line(out, "  %dh.h1 = add i64 %dh.head, 1")
  codegen_util::cg_emit_line(out, "  %dh.hw = and i64 %dh.h1, 65535")
  codegen_util::cg_emit_line(out, "  store i64 %dh.hw, ptr %dh.h.p")
  codegen_util::cg_emit_line(out, "  %dh.c1 = sub i64 %ph.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %dh.c1, ptr %ph.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %dq_prio_done")
  # Dequeue from NORMAL queue (slots 1=queue, 2=head, 5=count) — existing logic
  codegen_util::cg_emit_line(out, "dequeue:")
  codegen_util::cg_emit_line(out, "  %head.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %head = load i64, ptr %head.p")
  codegen_util::cg_emit_line(out, "  %q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %q.i = load i64, ptr %q.p")
  codegen_util::cg_emit_line(out, "  %q.base = inttoptr i64 %q.i to ptr")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %q.base, i64 %head")
  codegen_util::cg_emit_line(out, "  %gtask = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %head.next = add i64 %head, 1")
  codegen_util::cg_emit_line(out, "  %head.wrap = and i64 %head.next, 1048575")
  codegen_util::cg_emit_line(out, "  store i64 %head.wrap, ptr %head.p")
  codegen_util::cg_emit_line(out, "  %cnt2.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %cnt2 = load i64, ptr %cnt2.p")
  codegen_util::cg_emit_line(out, "  %cnt.dec = sub i64 %cnt2, 1")
  codegen_util::cg_emit_line(out, "  store i64 %cnt.dec, ptr %cnt2.p")
  codegen_util::cg_emit_line(out, "  br label %dq_prio_done")
  # Dequeue from LOW queue (slots 28=queue, 29=head, 31=count)
  codegen_util::cg_emit_line(out, "dq_low:")
  codegen_util::cg_emit_line(out, "  %dl.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 29")
  codegen_util::cg_emit_line(out, "  %dl.head = load i64, ptr %dl.h.p")
  codegen_util::cg_emit_line(out, "  %dl.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 28")
  codegen_util::cg_emit_line(out, "  %dl.q.i = load i64, ptr %dl.q.p")
  codegen_util::cg_emit_line(out, "  %dl.q = inttoptr i64 %dl.q.i to ptr")
  codegen_util::cg_emit_line(out, "  %dl.slot = getelementptr i64, ptr %dl.q, i64 %dl.head")
  codegen_util::cg_emit_line(out, "  %dl.task = load i64, ptr %dl.slot")
  codegen_util::cg_emit_line(out, "  %dl.h1 = add i64 %dl.head, 1")
  codegen_util::cg_emit_line(out, "  %dl.hw = and i64 %dl.h1, 65535")
  codegen_util::cg_emit_line(out, "  store i64 %dl.hw, ptr %dl.h.p")
  codegen_util::cg_emit_line(out, "  %dl.c1 = sub i64 %pl.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %dl.c1, ptr %pl.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %dq_prio_done")
  # Convergence: phi the dequeued task from whichever queue provided it
  codegen_util::cg_emit_line(out, "dq_prio_done:")
  codegen_util::cg_emit_line(out, "  %pq.task = phi i64 [%dc.task, %dq_critical], [%dh.task, %dq_high], [%gtask, %dequeue], [%dl.task, %dq_low]")
  # Signal reenqueue waiters that queue has space
  codegen_util::cg_emit_line(out, "  %dq.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %dq.cond.i = load i64, ptr %dq.cond.p")
  codegen_util::cg_emit_line(out, "  %dq.cond = inttoptr i64 %dq.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_signal(ptr %dq.cond)")
  # Reload mutex pointer (can't reuse %gmtx.i — not in scope from wait_loop path)
  codegen_util::cg_emit_line(out, "  %mtx.dq.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mtx.dq.i = load i64, ptr %mtx.dq.p")
  codegen_util::cg_emit_line(out, "  %mtx.dq = inttoptr i64 %mtx.dq.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %mtx.dq)")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  # === Phase 3: Try work stealing (unlock global first) ===
  codegen_util::cg_emit_line(out, "try_steal:")
  # Reload mutex pointer (can't reuse %gmtx.i — not in scope from wait_loop path)
  codegen_util::cg_emit_line(out, "  %mtx.st.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mtx.st.i = load i64, ptr %mtx.st.p")
  codegen_util::cg_emit_line(out, "  %mtx.st = inttoptr i64 %mtx.st.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %mtx.st)")
  codegen_util::cg_emit_line(out, "  %stolen = call i64 @__qz_sched_steal(i64 %wid)")
  codegen_util::cg_emit_line(out, "  %has_stolen = icmp ne i64 %stolen, 0")
  codegen_util::cg_emit_line(out, "  br i1 %has_stolen, label %got_stolen, label %spin_start")
  codegen_util::cg_emit_line(out, "got_stolen:")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  # === Phase 5: Spin-before-sleep — retry steal 3 more times before condvar ===
  # Avoids expensive condvar_wait/signal syscall for transient idle periods.
  # Go uses ⌊busy/2⌋ max spinners; we do a simpler fixed retry count.
  codegen_util::cg_emit_line(out, "spin_start:")
  codegen_util::cg_emit_line(out, "  br label %spin_loop")
  codegen_util::cg_emit_line(out, "spin_loop:")
  codegen_util::cg_emit_line(out, "  %spin.i = phi i64 [0, %spin_start], [%spin.next, %spin_retry]")
  codegen_util::cg_emit_line(out, "  %spin.done = icmp uge i64 %spin.i, 3")
  codegen_util::cg_emit_line(out, "  br i1 %spin.done, label %do_wait, label %spin_try")
  codegen_util::cg_emit_line(out, "spin_try:")
  # Also re-check local queue (another worker may have pushed work via reenqueue/spawn)
  codegen_util::cg_emit_line(out, "  %spin.local = call i64 @__qz_sched_local_pop(i64 %wid)")
  codegen_util::cg_emit_line(out, "  %spin.has_local = icmp ne i64 %spin.local, 0")
  codegen_util::cg_emit_line(out, "  br i1 %spin.has_local, label %spin_got_local, label %spin_steal")
  codegen_util::cg_emit_line(out, "spin_got_local:")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "spin_steal:")
  codegen_util::cg_emit_line(out, "  %spin.stolen = call i64 @__qz_sched_steal(i64 %wid)")
  codegen_util::cg_emit_line(out, "  %spin.has_stolen = icmp ne i64 %spin.stolen, 0")
  codegen_util::cg_emit_line(out, "  br i1 %spin.has_stolen, label %spin_got_stolen, label %spin_retry")
  codegen_util::cg_emit_line(out, "spin_got_stolen:")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "spin_retry:")
  codegen_util::cg_emit_line(out, "  %spin.next = add i64 %spin.i, 1")
  codegen_util::cg_emit_line(out, "  br label %spin_loop")
  # === Phase 4: Park on condvar (nothing after spinning) ===
  codegen_util::cg_emit_line(out, "do_wait:")
  # Load mutex pointer fresh (can't reuse %gmtx.i — not in scope from spin path)
  codegen_util::cg_emit_line(out, "  %dw.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %dw.mtx.i = load i64, ptr %dw.mtx.p")
  codegen_util::cg_emit_line(out, "  %dw.mtx = inttoptr i64 %dw.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %dw.mtx)")
  codegen_util::cg_emit_line(out, "  br label %wait_loop")
  codegen_util::cg_emit_line(out, "wait_loop:")
  # Re-check shutdown after re-acquiring mutex
  codegen_util::cg_emit_line(out, "  %sd2.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  %sd2 = load i64, ptr %sd2.p")
  codegen_util::cg_emit_line(out, "  %is_sd2 = icmp ne i64 %sd2, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_sd2, label %drain_or_exit, label %wait_count")
  codegen_util::cg_emit_line(out, "drain_or_exit:")
  # Check ALL queue counts (NORMAL + CRITICAL + HIGH + LOW) before deciding to exit
  codegen_util::cg_emit_line(out, "  %de.n.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %de.n = load i64, ptr %de.n.p")
  codegen_util::cg_emit_line(out, "  %de.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %de.c = load i64, ptr %de.c.p")
  codegen_util::cg_emit_line(out, "  %de.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %de.h = load i64, ptr %de.h.p")
  codegen_util::cg_emit_line(out, "  %de.l.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 31")
  codegen_util::cg_emit_line(out, "  %de.l = load i64, ptr %de.l.p")
  codegen_util::cg_emit_line(out, "  %de.s1 = add i64 %de.n, %de.c")
  codegen_util::cg_emit_line(out, "  %de.s2 = add i64 %de.s1, %de.h")
  codegen_util::cg_emit_line(out, "  %de.total = add i64 %de.s2, %de.l")
  codegen_util::cg_emit_line(out, "  %de.empty = icmp eq i64 %de.total, 0")
  codegen_util::cg_emit_line(out, "  br i1 %de.empty, label %exit, label %check_work")
  codegen_util::cg_emit_line(out, "wait_count:")
  # Check ALL queue counts before deciding to sleep
  codegen_util::cg_emit_line(out, "  %wc.n.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %wc.n = load i64, ptr %wc.n.p")
  codegen_util::cg_emit_line(out, "  %wc.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  %wc.c = load i64, ptr %wc.c.p")
  codegen_util::cg_emit_line(out, "  %wc.h.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 27")
  codegen_util::cg_emit_line(out, "  %wc.h = load i64, ptr %wc.h.p")
  codegen_util::cg_emit_line(out, "  %wc.l.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 31")
  codegen_util::cg_emit_line(out, "  %wc.l = load i64, ptr %wc.l.p")
  codegen_util::cg_emit_line(out, "  %wc.s1 = add i64 %wc.n, %wc.c")
  codegen_util::cg_emit_line(out, "  %wc.s2 = add i64 %wc.s1, %wc.h")
  codegen_util::cg_emit_line(out, "  %wc.total = add i64 %wc.s2, %wc.l")
  codegen_util::cg_emit_line(out, "  %wc.has = icmp ugt i64 %wc.total, 0")
  codegen_util::cg_emit_line(out, "  br i1 %wc.has, label %check_work, label %cond_wait")
  codegen_util::cg_emit_line(out, "wait_dequeue:")
  # Dequeue from global (we hold the mutex) — separate SSA names
  codegen_util::cg_emit_line(out, "  %w.head.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %w.head = load i64, ptr %w.head.p")
  codegen_util::cg_emit_line(out, "  %w.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %w.q.i = load i64, ptr %w.q.p")
  codegen_util::cg_emit_line(out, "  %w.q.base = inttoptr i64 %w.q.i to ptr")
  codegen_util::cg_emit_line(out, "  %w.slot = getelementptr i64, ptr %w.q.base, i64 %w.head")
  codegen_util::cg_emit_line(out, "  %w.task = load i64, ptr %w.slot")
  codegen_util::cg_emit_line(out, "  %w.head.next = add i64 %w.head, 1")
  codegen_util::cg_emit_line(out, "  %w.head.wrap = and i64 %w.head.next, 1048575")
  codegen_util::cg_emit_line(out, "  store i64 %w.head.wrap, ptr %w.head.p")
  codegen_util::cg_emit_line(out, "  %w.cnt3.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %w.cnt3 = load i64, ptr %w.cnt3.p")
  codegen_util::cg_emit_line(out, "  %w.cnt.dec = sub i64 %w.cnt3, 1")
  codegen_util::cg_emit_line(out, "  store i64 %w.cnt.dec, ptr %w.cnt3.p")
  # Signal reenqueue waiters that queue has space
  codegen_util::cg_emit_line(out, "  %wdq.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %wdq.cond.i = load i64, ptr %wdq.cond.p")
  codegen_util::cg_emit_line(out, "  %wdq.cond = inttoptr i64 %wdq.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_signal(ptr %wdq.cond)")
  codegen_util::cg_emit_line(out, "  %mtx.wd = inttoptr i64 %dw.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %mtx.wd)")
  codegen_util::cg_emit_line(out, "  br label %setup_poll")
  codegen_util::cg_emit_line(out, "cond_wait:")
  codegen_util::cg_emit_line(out, "  %cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %cond.i = load i64, ptr %cond.p")
  codegen_util::cg_emit_line(out, "  %cond = inttoptr i64 %cond.i to ptr")
  codegen_util::cg_emit_line(out, "  %mtx.cw = inttoptr i64 %dw.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_wait(ptr %cond, ptr %mtx.cw)")
  codegen_util::cg_emit_line(out, "  br label %wait_loop")
  # === Poll task — convergence point for local/global/steal/wait paths ===
  codegen_util::cg_emit_line(out, "setup_poll:")
  codegen_util::cg_emit_line(out, "  %task.i = phi i64 [%lp, %got_local], [%pq.task, %dq_prio_done], [%stolen, %got_stolen], [%w.task, %wait_dequeue], [%spin.local, %spin_got_local], [%spin.stolen, %spin_got_stolen], [%stolen2, %got_stolen2], [%lifo.p, %lifo_take]")
  # Set up panic capture
  codegen_util::cg_emit_line(out, "  call void @__qz_panic_jmpbuf_set(ptr %jmpbuf.ptr)")
  codegen_util::cg_emit_line(out, "  %jmp_rc = call i32 @setjmp(ptr %jmpbuf.ptr)")
  codegen_util::cg_emit_line(out, "  %panicked = icmp ne i32 %jmp_rc, 0")
  codegen_util::cg_emit_line(out, "  br i1 %panicked, label %panic_caught, label %do_poll")
  codegen_util::cg_emit_line(out, "do_poll:")
  # Store current frame in thread-local for task_id() intrinsic
  codegen_util::cg_emit_line(out, "  store i64 %task.i, ptr @__qz_current_frame")
  codegen_util::cg_emit_line(out, "  %task.p = inttoptr i64 %task.i to ptr")
  # Early-done check: eager futures have state=-1 and no poll function at frame[2].
  # Skip the poll call and go directly to task_done handling.
  codegen_util::cg_emit_line(out, "  %early.state = load i64, ptr %task.p")
  codegen_util::cg_emit_line(out, "  %early.done = icmp eq i64 %early.state, -1")
  codegen_util::cg_emit_line(out, "  br i1 %early.done, label %task_done, label %do_poll_call")
  codegen_util::cg_emit_line(out, "do_poll_call:")
  # P21: Reset fuel budget before each task poll (BEAM-style reduction counting)
  codegen_util::cg_emit_line(out, "  store i64 4000, ptr @__qz_sched_fuel")
  # Sampled time accounting: measure every 64th poll, scale by 64
  codegen_util::cg_emit_line(out, "  %bt.ctr = load i64, ptr @__qz_poll_sample_ctr")
  codegen_util::cg_emit_line(out, "  %bt.ctr1 = add i64 %bt.ctr, 1")
  codegen_util::cg_emit_line(out, "  store i64 %bt.ctr1, ptr @__qz_poll_sample_ctr")
  codegen_util::cg_emit_line(out, "  %bt.sample = and i64 %bt.ctr, 63")
  codegen_util::cg_emit_line(out, "  %bt.do_time = icmp eq i64 %bt.sample, 0")
  codegen_util::cg_emit_line(out, "  br i1 %bt.do_time, label %bt_start_time, label %bt_skip_start")
  codegen_util::cg_emit_line(out, "bt_start_time:")
  codegen_util::cg_emit_line(out, "  %bt.start_val = call i64 @__qz_time_mono_ns()")
  codegen_util::cg_emit_line(out, "  br label %bt_skip_start")
  codegen_util::cg_emit_line(out, "bt_skip_start:")
  codegen_util::cg_emit_line(out, "  %bt.start = phi i64 [%bt.start_val, %bt_start_time], [0, %do_poll_call]")
  # E.1.c.b: snapshot-based handler inheritance.
  # Look up the task's snapshot (no-op fast path when count==0 — common
  # case for programs that don't install handlers across spawn), and
  # apply it on top of the worker's blessed defaults. Both lookup
  # (zero-count short circuit) and apply (snap=0) are no-ops so we skip
  # the explicit branch — the apply short-circuits and returns 0.
  # `apply` returns the COUNT of entries it pushed; we use that to
  # truncate the stack after poll_fn returns, dropping ONLY our snapshot
  # pushes and preserving any in-flight `with`-block installs the body
  # has open across yield/suspend boundaries. (A naive reset to a saved
  # pre-poll top would erase the body's in-flight installs, breaking
  # generators that yield from inside a wrap-block — see the body-wrap
  # last-stmt gotcha and the kind=3 routine state machines.)
  codegen_util::cg_emit_line(out, "  %sn.snap = call i64 @__qz_task_snapshot_lookup(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  %sn.pushed = call i64 @__qz_effect_snapshot_apply(i64 %sn.snap)")
  # B.7 Phase 4b: scope inheritance.
  # On poll entry: load this task's scope (spawn-time value or last-yield
  # value) into TLS, saving the worker's previous TLS scope so we can
  # restore it after the poll. After poll_fn returns: save body's current
  # TLS scope back to the table (so subsequent polls resume the body's
  # POV — preserves scope_with installs that span a yield/suspend),
  # then restore worker's pre-poll TLS. Mirrors the snapshot apply/drop
  # pattern but symmetric (table↔TLS) since scope is a single i64 not a
  # variable-length stack.
  codegen_util::cg_emit_line(out, "  %sn.scope = call i64 @__qz_task_scope_lookup(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  %sn.prev_scope = load i64, ptr @__qz_current_scope_handle, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %sn.scope, ptr @__qz_current_scope_handle, align 8")
  # Load poll_fn from frame[2], call poll_fn(frame)
  codegen_util::cg_emit_line(out, "  %pfn.gep = getelementptr i64, ptr %task.p, i64 2")
  codegen_util::cg_emit_line(out, "  %pfn.i = load i64, ptr %pfn.gep")
  codegen_util::cg_emit_line(out, "  %pfn = inttoptr i64 %pfn.i to i64 (i64)*")
  codegen_util::cg_emit_line(out, "  %poll_result = call i64 %pfn(i64 %task.i)")
  # B.7 Phase 4b: save body's current TLS scope to the table, restore worker's TLS.
  codegen_util::cg_emit_line(out, "  %sn.body_scope = load i64, ptr @__qz_current_scope_handle, align 8")
  codegen_util::cg_emit_line(out, "  call void @__qz_task_scope_set(i64 %task.i, i64 %sn.body_scope)")
  codegen_util::cg_emit_line(out, "  store i64 %sn.prev_scope, ptr @__qz_current_scope_handle, align 8")
