  codegen_util::cg_emit_line(out, "  %nw1 = sub i64 %nw, 1")
  codegen_util::cg_emit_line(out, "  %v1raw = urem i64 %rng, %nw1")
  codegen_util::cg_emit_line(out, "  %v1.ge = icmp uge i64 %v1raw, %wid")
  codegen_util::cg_emit_line(out, "  %v1adj = add i64 %v1raw, 1")
  codegen_util::cg_emit_line(out, "  %victim1 = select i1 %v1.ge, i64 %v1adj, i64 %v1raw")
  # Try victim 1
  codegen_util::cg_emit_line(out, "  %r1 = call i64 @__qz_sched_steal_from(i64 %victim1, ptr %wd.base, i64 %wid)")
  codegen_util::cg_emit_line(out, "  %r1.ok = icmp ne i64 %r1, 0")
  codegen_util::cg_emit_line(out, "  br i1 %r1.ok, label %got_task1, label %try_victim2")
  codegen_util::cg_emit_line(out, "got_task1:")
  codegen_util::cg_emit_line(out, "  ret i64 %r1")
  codegen_util::cg_emit_line(out, "try_victim2:")
  # Victim 2: use different bits of rng
  codegen_util::cg_emit_line(out, "  %rng2 = lshr i64 %rng, 32")
  codegen_util::cg_emit_line(out, "  %v2raw = urem i64 %rng2, %nw1")
  codegen_util::cg_emit_line(out, "  %v2.ge = icmp uge i64 %v2raw, %wid")
  codegen_util::cg_emit_line(out, "  %v2adj = add i64 %v2raw, 1")
  codegen_util::cg_emit_line(out, "  %victim2 = select i1 %v2.ge, i64 %v2adj, i64 %v2raw")
  codegen_util::cg_emit_line(out, "  %r2 = call i64 @__qz_sched_steal_from(i64 %victim2, ptr %wd.base, i64 %wid)")
  codegen_util::cg_emit_line(out, "  ret i64 %r2")
  codegen_util::cg_emit_line(out, "fail:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_steal_from(victim, wd_base, stealer_wid): Chase-Lev steal-half
  # Steals N=max(1, size/2) tasks from victim's top via single CAS.
  # Returns first stolen task (or 0). Remaining N-1 tasks pushed to stealer's local deque.
  # Amortizes steal overhead for streaming workloads (same approach as Go/Tokio).
  codegen_util::cg_emit_line(out, "define i64 @__qz_sched_steal_from(i64 %victim, ptr %wd.base, i64 %stealer) nounwind {")
  codegen_util::cg_emit_line(out, "sf_entry:")
  codegen_util::cg_emit_line(out, "  %v.off = mul i64 %victim, 12")
  codegen_util::cg_emit_line(out, "  %v.slot = getelementptr i64, ptr %wd.base, i64 %v.off")
  # Load top then bottom (order matters for consistency)
  codegen_util::cg_emit_line(out, "  %v.t.gep = getelementptr i64, ptr %v.slot, i64 2")
  codegen_util::cg_emit_line(out, "  %v.t = load atomic i64, ptr %v.t.gep acquire, align 8")
  # Full barrier between top and bottom reads
  codegen_util::cg_emit_line(out, "  fence seq_cst")
  codegen_util::cg_emit_line(out, "  %v.b.gep = getelementptr i64, ptr %v.slot, i64 1")
  codegen_util::cg_emit_line(out, "  %v.b = load atomic i64, ptr %v.b.gep acquire, align 8")
  # Check if victim has tasks
  codegen_util::cg_emit_line(out, "  %v.sz = sub i64 %v.b, %v.t")
  codegen_util::cg_emit_line(out, "  %v.empty = icmp sle i64 %v.sz, 0")
  codegen_util::cg_emit_line(out, "  br i1 %v.empty, label %sf_fail, label %sf_steal")
  codegen_util::cg_emit_line(out, "sf_steal:")
  # Compute N = max(1, size/2) — steal half the victim's work
  codegen_util::cg_emit_line(out, "  %v.half = lshr i64 %v.sz, 1")
  codegen_util::cg_emit_line(out, "  %v.half.lt1 = icmp slt i64 %v.half, 1")
  codegen_util::cg_emit_line(out, "  %v.n = select i1 %v.half.lt1, i64 1, i64 %v.half")
  # Load victim's buffer pointer
  codegen_util::cg_emit_line(out, "  %v.lq.gep = getelementptr i64, ptr %v.slot, i64 0")
  codegen_util::cg_emit_line(out, "  %v.lq.i = load i64, ptr %v.lq.gep")
  codegen_util::cg_emit_line(out, "  %v.lq = inttoptr i64 %v.lq.i to ptr")
  # CAS top from t to t+n (claim N tasks atomically)
  codegen_util::cg_emit_line(out, "  %v.tn = add i64 %v.t, %v.n")
  codegen_util::cg_emit_line(out, "  %v.cas = cmpxchg ptr %v.t.gep, i64 %v.t, i64 %v.tn seq_cst seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  %v.cas.ok = extractvalue { i64, i1 } %v.cas, 1")
  codegen_util::cg_emit_line(out, "  br i1 %v.cas.ok, label %sf_got, label %sf_fail")
  codegen_util::cg_emit_line(out, "sf_got:")
  # Load the first stolen task (to return directly)
  codegen_util::cg_emit_line(out, "  %v.idx0 = and i64 %v.t, 255")
  codegen_util::cg_emit_line(out, "  %v.slot0 = getelementptr i64, ptr %v.lq, i64 %v.idx0")
  codegen_util::cg_emit_line(out, "  %first = load i64, ptr %v.slot0")
  # Check if there are remaining tasks to push to stealer's local deque
  codegen_util::cg_emit_line(out, "  %v.has_rest = icmp ugt i64 %v.n, 1")
  codegen_util::cg_emit_line(out, "  br i1 %v.has_rest, label %sf_push_loop, label %sf_return")
  # Loop: push tasks [t+1 .. t+n-1] to stealer's local deque
  codegen_util::cg_emit_line(out, "sf_push_loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [1, %sf_got], [%i.next, %sf_push_loop]")
  codegen_util::cg_emit_line(out, "  %ti = add i64 %v.t, %i")
  codegen_util::cg_emit_line(out, "  %ti.idx = and i64 %ti, 255")
  codegen_util::cg_emit_line(out, "  %ti.slot = getelementptr i64, ptr %v.lq, i64 %ti.idx")
  codegen_util::cg_emit_line(out, "  %ti.task = load i64, ptr %ti.slot")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %stealer, i64 %ti.task)")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i.done = icmp uge i64 %i.next, %v.n")
  codegen_util::cg_emit_line(out, "  br i1 %i.done, label %sf_return, label %sf_push_loop")
  codegen_util::cg_emit_line(out, "sf_return:")
  codegen_util::cg_emit_line(out, "  ret i64 %first")
  codegen_util::cg_emit_line(out, "sf_fail:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_register_io(fd, task): on POSIX register fd with kqueue/epoll
  # one-shot, storing task in io_map; on Windows allocate a 72-byte SockState
  # block and submit an AFD_POLL via NtDeviceIoControlFile (Phase 5e). The
  # POSIX path uses fd-as-int io_map[fd]=task identity; the Windows path uses
  # the SockState pointer (returned to ev_io: via OVERLAPPED_ENTRY.lpOverlapped)
  # as the per-poll identity, so the io_map write is skipped entirely.
  codegen_util::cg_emit_line(out, "define void @__qz_sched_register_io(i64 %fd, i64 %task) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  if cg_is_windows(target)
    # Phase 5e — Windows AFD path. The %fd argument is interpreted as a
    # Winsock SOCKET (uintptr_t; same width as i64 on x64). LSP unwrap via
    # WSAIoctl(SIO_BASE_HANDLE=0x48000022) is the canonical first step.
    # WSAIoctl(socket, SIO_BASE_HANDLE, NULL, 0, &base_socket, 8, &bytes,
    #          NULL, NULL). On failure (non-zero return) we treat as fatal
    #          for v1; Komodia-family LSP fallback is filed-forward.
    codegen_util::cg_emit_line(out, "  %afd.base.slot = alloca i64")
    codegen_util::cg_emit_line(out, "  %afd.bytes.slot = alloca i32")
    codegen_util::cg_emit_line(out, "  %afd.lsp.r = call i32 @WSAIoctl(i64 %fd, i32 1207959586, ptr null, i32 0, ptr %afd.base.slot, i32 8, ptr %afd.bytes.slot, ptr null, ptr null)")
    codegen_util::cg_emit_line(out, "  %afd.lsp.ok = icmp eq i32 %afd.lsp.r, 0")
    codegen_util::cg_emit_line(out, "  br i1 %afd.lsp.ok, label %afd_alloc, label %afd_fail_inline")
    codegen_util::cg_emit_line(out, "afd_alloc:")
    codegen_util::cg_emit_line(out, "  %afd.base = load i64, ptr %afd.base.slot")
    # Allocate 72-byte SockState: [0..15]=IOSB, [16..47]=AFD_POLL_INFO,
    # [48..55]=task ptr, [56..59]=events u32, [60..63]=flags u32,
    # [64..71]=reserved.
    codegen_util::cg_emit_line(out, "  %afd.block.p = call ptr @__qz_alloc(i64 72)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %afd.block.p, i32 0, i64 72)")
    # Layout: iosb at offset 0 (16 B), poll_info at offset 16 (32 B),
    # task_ptr at offset 48 (8 B).
    # iosb.Status = STATUS_PENDING (0x103) — the kernel will overwrite this
    # on completion; pre-set so a cancel branch can race-detect.
    codegen_util::cg_emit_line(out, "  store i32 259, ptr %afd.block.p")
    # poll_info.Timeout (LARGE_INTEGER i64) at offset 16: INT64_MAX so the
    # kernel never times out — Quartz's timer heap (5c) owns deadlines for
    # register_io_ex, and plain register_io is no-timeout.
    codegen_util::cg_emit_line(out, "  %afd.pi.to.p = getelementptr i8, ptr %afd.block.p, i64 16")
    codegen_util::cg_emit_line(out, "  store i64 9223372036854775807, ptr %afd.pi.to.p")
    # poll_info.NumberOfHandles (u32) at offset 24 = 1
    codegen_util::cg_emit_line(out, "  %afd.pi.n.p = getelementptr i8, ptr %afd.block.p, i64 24")
    codegen_util::cg_emit_line(out, "  store i32 1, ptr %afd.pi.n.p")
    # poll_info.Exclusive (u32) at offset 28 = 0 (already memset zero)
    # poll_info.handles[0].Handle (HANDLE, 8 B) at offset 32 = base_socket
    codegen_util::cg_emit_line(out, "  %afd.pi.h.p = getelementptr i8, ptr %afd.block.p, i64 32")
    codegen_util::cg_emit_line(out, "  store i64 %afd.base, ptr %afd.pi.h.p")
    # poll_info.handles[0].Events (u32) at offset 40
    # POLL_RECEIVE(0x01) | POLL_ACCEPT(0x80) | POLL_DISCONNECT(0x08) |
    # POLL_ABORT(0x10) | POLL_LOCAL_CLOSE(0x20) | POLL_CONNECT_FAIL(0x100) = 0x1B9
    codegen_util::cg_emit_line(out, "  %afd.pi.e.p = getelementptr i8, ptr %afd.block.p, i64 40")
    codegen_util::cg_emit_line(out, "  store i32 441, ptr %afd.pi.e.p")
    # poll_info.handles[0].Status (NTSTATUS i32) at offset 44 = 0 (memset)
    # task_ptr at offset 48
    codegen_util::cg_emit_line(out, "  %afd.tp.p = getelementptr i8, ptr %afd.block.p, i64 48")
    codegen_util::cg_emit_line(out, "  store i64 %task, ptr %afd.tp.p")
    # user_events at offset 56 (record what we asked for; aids future
    # edge-trigger masking but unused in v1's one-shot model)
    codegen_util::cg_emit_line(out, "  %afd.ue.p = getelementptr i8, ptr %afd.block.p, i64 56")
    codegen_util::cg_emit_line(out, "  store i32 1, ptr %afd.ue.p")
    # Submit AFD_POLL: NtDeviceIoControlFile(afd, NULL, NULL, sock_state,
    # &iosb, IOCTL_AFD_POLL=0x00012024, &poll_info, 32, &poll_info, 32).
    # ApcContext = sock_state pointer — comes back as OVERLAPPED_ENTRY.lpOverlapped.
    # InputBuffer = OutputBuffer = pointer to AFD_POLL_INFO (in-place update).
    codegen_util::cg_emit_line(out, "  %afd.slot33.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
    codegen_util::cg_emit_line(out, "  %afd.h.i = load i64, ptr %afd.slot33.p")
    codegen_util::cg_emit_line(out, "  %afd.h = inttoptr i64 %afd.h.i to ptr")
    codegen_util::cg_emit_line(out, "  %afd.iosb.p = bitcast ptr %afd.block.p to ptr")
    codegen_util::cg_emit_line(out, "  %afd.poll.p = getelementptr i8, ptr %afd.block.p, i64 16")
    codegen_util::cg_emit_line(out, "  %afd.nt.r = call i32 @NtDeviceIoControlFile(ptr %afd.h, ptr null, ptr null, ptr %afd.block.p, ptr %afd.iosb.p, i32 74276, ptr %afd.poll.p, i32 32, ptr %afd.poll.p, i32 32)")
    # STATUS_PENDING (0x103) = success-async (the common case).
    # STATUS_SUCCESS (0) = inline completion — let the IOCP path handle it
    #   (FILE_SKIP_SET_EVENT_ON_HANDLE still queues a completion per mio).
    # Negative NTSTATUS = error; free block and inline-reenqueue.
