  codegen_util::cg_emit_line(out, "  %sp.tr.arr.i = load i64, ptr %sp.tr.arr.p")
  codegen_util::cg_emit_line(out, "  %sp.tr.arr = inttoptr i64 %sp.tr.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  %sp.tr.off = mul i64 %sp.tr.cnt, 4")
  codegen_util::cg_emit_line(out, "  %sp.tr.s0 = getelementptr i64, ptr %sp.tr.arr, i64 %sp.tr.off")
  codegen_util::cg_emit_line(out, "  store i64 %sp.tid, ptr %sp.tr.s0")
  codegen_util::cg_emit_line(out, "  %sp.tr.s1 = getelementptr i64, ptr %sp.tr.s0, i64 1")
