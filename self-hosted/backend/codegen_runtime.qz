  codegen_util::cg_emit_line(out, "  %wk.zero.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %wk.zero.p")
