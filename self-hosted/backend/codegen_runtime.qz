  codegen_util::cg_emit_line(out, "  %rq.lifo = load i64, ptr @__qz_lifo_task")
  codegen_util::cg_emit_line(out, "  %rq.lifo_empty = icmp eq i64 %rq.lifo, 0")
  codegen_util::cg_emit_line(out, "  br i1 %rq.lifo_empty, label %rq_lifo_set, label %rq_deque_push")
  codegen_util::cg_emit_line(out, "rq_lifo_set:")
