    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "pfd_register:")
    # io_map[pfd] = task
    codegen_util::cg_emit_line(out, "  %map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
    codegen_util::cg_emit_line(out, "  %map.i = load i64, ptr %map.p")
    codegen_util::cg_emit_line(out, "  %map.base = inttoptr i64 %map.i to ptr")
    codegen_util::cg_emit_line(out, "  %map.slot = getelementptr i64, ptr %map.base, i64 %pfd.i64")
    codegen_util::cg_emit_line(out, "  store i64 %task, ptr %map.slot")
    # pidfd_set[pfd] = 1 — poller will close(pfd) after firing
    codegen_util::cg_emit_line(out, "  %pfds.b.i = load i64, ptr @__qz_pidfd_set")
    codegen_util::cg_emit_line(out, "  %pfds.b = inttoptr i64 %pfds.b.i to ptr")
    codegen_util::cg_emit_line(out, "  %pfds.slot = getelementptr i64, ptr %pfds.b, i64 %pfd.i64")
    codegen_util::cg_emit_line(out, "  store i64 1, ptr %pfds.slot")
