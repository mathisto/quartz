    codegen_util::cg_emit_line(out, "  %ih.cfn = inttoptr i64 %ih.cfn.raw to i64 (i64)*")
    codegen_util::cg_emit_line(out, "  %ih.cres = call i64 %ih.cfn(i64 %ih.env)")
    codegen_util::cg_emit_line(out, "  br label %ih_skip")
