  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %thp.mtx)")
  codegen_util::cg_emit_line(out, "  br label %thp_ret_fail")
  codegen_util::cg_emit_line(out, "thp_ret_fail:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
