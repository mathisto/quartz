  codegen_util::cg_emit_line(out, "check_2b:")
  codegen_util::cg_emit_line(out, "  %is_2b = icmp ult i64 %b0z, 224")
  codegen_util::cg_emit_line(out, "  br i1 %is_2b, label %do_2b, label %check_3b")
  codegen_util::cg_emit_line(out, "do_2b:")
  # Must have at least 2 bytes remaining
  codegen_util::cg_emit_line(out, "  %i2.end = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %i2.ok = icmp sle i64 %i2.end, %len")
  codegen_util::cg_emit_line(out, "  br i1 %i2.ok, label %do_2b_cont, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_2b_cont:")
  # Check lead byte >= 0xC2 (reject overlong)
  codegen_util::cg_emit_line(out, "  %is_overlong_2 = icmp ult i64 %b0z, 194")
  codegen_util::cg_emit_line(out, "  br i1 %is_overlong_2, label %ret_invalid, label %do_2b_c1")
  codegen_util::cg_emit_line(out, "do_2b_c1:")
  codegen_util::cg_emit_line(out, "  %i2.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %p2.1 = getelementptr i8, ptr %ptr, i64 %i2.1")
  codegen_util::cg_emit_line(out, "  %b2.1 = load i8, ptr %p2.1")
  codegen_util::cg_emit_line(out, "  %b2.1z = zext i8 %b2.1 to i64")
  codegen_util::cg_emit_line(out, "  %b2.1m = and i64 %b2.1z, 192")
  codegen_util::cg_emit_line(out, "  %b2.1ok = icmp eq i64 %b2.1m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b2.1ok, label %ok_2b, label %ret_invalid")
  codegen_util::cg_emit_line(out, "ok_2b:")
  codegen_util::cg_emit_line(out, "  br label %valid_cp")
  # 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
  codegen_util::cg_emit_line(out, "check_3b:")
  codegen_util::cg_emit_line(out, "  %is_3b = icmp ult i64 %b0z, 240")
  codegen_util::cg_emit_line(out, "  br i1 %is_3b, label %do_3b, label %check_4b")
  codegen_util::cg_emit_line(out, "do_3b:")
  codegen_util::cg_emit_line(out, "  %i3.end = add i64 %i, 3")
  codegen_util::cg_emit_line(out, "  %i3.ok = icmp sle i64 %i3.end, %len")
  codegen_util::cg_emit_line(out, "  br i1 %i3.ok, label %do_3b_c1, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_3b_c1:")
  codegen_util::cg_emit_line(out, "  %i3.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %p3.1 = getelementptr i8, ptr %ptr, i64 %i3.1")
  codegen_util::cg_emit_line(out, "  %b3.1 = load i8, ptr %p3.1")
  codegen_util::cg_emit_line(out, "  %b3.1z = zext i8 %b3.1 to i64")
  codegen_util::cg_emit_line(out, "  %b3.1m = and i64 %b3.1z, 192")
  codegen_util::cg_emit_line(out, "  %b3.1ok = icmp eq i64 %b3.1m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b3.1ok, label %do_3b_c2, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_3b_c2:")
  codegen_util::cg_emit_line(out, "  %i3.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %p3.2 = getelementptr i8, ptr %ptr, i64 %i3.2")
  codegen_util::cg_emit_line(out, "  %b3.2 = load i8, ptr %p3.2")
  codegen_util::cg_emit_line(out, "  %b3.2z = zext i8 %b3.2 to i64")
  codegen_util::cg_emit_line(out, "  %b3.2m = and i64 %b3.2z, 192")
  codegen_util::cg_emit_line(out, "  %b3.2ok = icmp eq i64 %b3.2m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b3.2ok, label %do_3b_decode, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_3b_decode:")
  # Decode and check overlong (cp >= 0x0800) and surrogates (0xD800-0xDFFF)
  codegen_util::cg_emit_line(out, "  %cp3.a = and i64 %b0z, 15")
  codegen_util::cg_emit_line(out, "  %cp3.a1 = shl i64 %cp3.a, 12")
  codegen_util::cg_emit_line(out, "  %cp3.b = and i64 %b3.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.b1 = shl i64 %cp3.b, 6")
  codegen_util::cg_emit_line(out, "  %cp3.c = and i64 %b3.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp3.ab = or i64 %cp3.a1, %cp3.b1")
  codegen_util::cg_emit_line(out, "  %cp3 = or i64 %cp3.ab, %cp3.c")
  # Reject overlong
  codegen_util::cg_emit_line(out, "  %cp3.overlong = icmp ult i64 %cp3, 2048")
  codegen_util::cg_emit_line(out, "  br i1 %cp3.overlong, label %ret_invalid, label %do_3b_surr")
  codegen_util::cg_emit_line(out, "do_3b_surr:")
  # Reject surrogates: 0xD800 <= cp <= 0xDFFF
  codegen_util::cg_emit_line(out, "  %cp3.ge_d8 = icmp uge i64 %cp3, 55296")
  codegen_util::cg_emit_line(out, "  %cp3.le_df = icmp ule i64 %cp3, 57343")
  codegen_util::cg_emit_line(out, "  %cp3.is_surr = and i1 %cp3.ge_d8, %cp3.le_df")
  codegen_util::cg_emit_line(out, "  br i1 %cp3.is_surr, label %ret_invalid, label %ok_3b")
  codegen_util::cg_emit_line(out, "ok_3b:")
  codegen_util::cg_emit_line(out, "  br label %valid_cp")
  # 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
  codegen_util::cg_emit_line(out, "check_4b:")
  codegen_util::cg_emit_line(out, "  %is_4b = icmp ult i64 %b0z, 248")
  codegen_util::cg_emit_line(out, "  br i1 %is_4b, label %do_4b, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_4b:")
  codegen_util::cg_emit_line(out, "  %i4.end = add i64 %i, 4")
  codegen_util::cg_emit_line(out, "  %i4.ok = icmp sle i64 %i4.end, %len")
  codegen_util::cg_emit_line(out, "  br i1 %i4.ok, label %do_4b_c1, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_4b_c1:")
  codegen_util::cg_emit_line(out, "  %i4.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %p4.1 = getelementptr i8, ptr %ptr, i64 %i4.1")
  codegen_util::cg_emit_line(out, "  %b4.1 = load i8, ptr %p4.1")
  codegen_util::cg_emit_line(out, "  %b4.1z = zext i8 %b4.1 to i64")
  codegen_util::cg_emit_line(out, "  %b4.1m = and i64 %b4.1z, 192")
  codegen_util::cg_emit_line(out, "  %b4.1ok = icmp eq i64 %b4.1m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b4.1ok, label %do_4b_c2, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_4b_c2:")
  codegen_util::cg_emit_line(out, "  %i4.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %p4.2 = getelementptr i8, ptr %ptr, i64 %i4.2")
  codegen_util::cg_emit_line(out, "  %b4.2 = load i8, ptr %p4.2")
  codegen_util::cg_emit_line(out, "  %b4.2z = zext i8 %b4.2 to i64")
  codegen_util::cg_emit_line(out, "  %b4.2m = and i64 %b4.2z, 192")
  codegen_util::cg_emit_line(out, "  %b4.2ok = icmp eq i64 %b4.2m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b4.2ok, label %do_4b_c3, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_4b_c3:")
  codegen_util::cg_emit_line(out, "  %i4.3 = add i64 %i, 3")
  codegen_util::cg_emit_line(out, "  %p4.3 = getelementptr i8, ptr %ptr, i64 %i4.3")
  codegen_util::cg_emit_line(out, "  %b4.3 = load i8, ptr %p4.3")
  codegen_util::cg_emit_line(out, "  %b4.3z = zext i8 %b4.3 to i64")
  codegen_util::cg_emit_line(out, "  %b4.3m = and i64 %b4.3z, 192")
  codegen_util::cg_emit_line(out, "  %b4.3ok = icmp eq i64 %b4.3m, 128")
  codegen_util::cg_emit_line(out, "  br i1 %b4.3ok, label %do_4b_decode, label %ret_invalid")
  codegen_util::cg_emit_line(out, "do_4b_decode:")
  # Decode and check overlong (cp >= 0x10000) and max (cp <= 0x10FFFF)
  codegen_util::cg_emit_line(out, "  %cp4.a = and i64 %b0z, 7")
  codegen_util::cg_emit_line(out, "  %cp4.a1 = shl i64 %cp4.a, 18")
  codegen_util::cg_emit_line(out, "  %cp4.b = and i64 %b4.1z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.b1 = shl i64 %cp4.b, 12")
  codegen_util::cg_emit_line(out, "  %cp4.c = and i64 %b4.2z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.c1 = shl i64 %cp4.c, 6")
  codegen_util::cg_emit_line(out, "  %cp4.d = and i64 %b4.3z, 63")
  codegen_util::cg_emit_line(out, "  %cp4.ab = or i64 %cp4.a1, %cp4.b1")
  codegen_util::cg_emit_line(out, "  %cp4.cd = or i64 %cp4.c1, %cp4.d")
  codegen_util::cg_emit_line(out, "  %cp4 = or i64 %cp4.ab, %cp4.cd")
  # Reject overlong
  codegen_util::cg_emit_line(out, "  %cp4.overlong = icmp ult i64 %cp4, 65536")
  codegen_util::cg_emit_line(out, "  br i1 %cp4.overlong, label %ret_invalid, label %do_4b_max")
  codegen_util::cg_emit_line(out, "do_4b_max:")
  # Reject > U+10FFFF
  codegen_util::cg_emit_line(out, "  %cp4.toobig = icmp ugt i64 %cp4, 1114111")
  codegen_util::cg_emit_line(out, "  br i1 %cp4.toobig, label %ret_invalid, label %ok_4b")
  codegen_util::cg_emit_line(out, "ok_4b:")
  codegen_util::cg_emit_line(out, "  br label %valid_cp")
  # Valid codepoint — advance
  codegen_util::cg_emit_line(out, "valid_cp:")
  codegen_util::cg_emit_line(out, "  %i.next = phi i64 [ %i.a, %ascii ], [ %i2.end, %ok_2b ], [ %i3.end, %ok_3b ], [ %i4.end, %ok_4b ]")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "ret_valid:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "ret_invalid:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # ============================================================================
  # FIX.2: Codepoint-based string runtime helpers
  # ============================================================================

  # qz_str_slice_utf8: substring by codepoint range [cp_start, cp_end)
  # Scans to find byte offsets for codepoint positions, then memcpy
  codegen_util::cg_emit_line(out, "define i64 @qz_str_slice_utf8(i64 %s, i64 %cp_start, i64 %cp_end) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %blen = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "scan:")
  codegen_util::cg_emit_line(out, "  %bi = phi i64 [ 0, %entry ], [ %bi.next, %advance ]")
  codegen_util::cg_emit_line(out, "  %ci = phi i64 [ 0, %entry ], [ %ci.next, %advance ]")
  codegen_util::cg_emit_line(out, "  %byte_start = phi i64 [ 0, %entry ], [ %byte_start.u, %advance ]")
  codegen_util::cg_emit_line(out, "  %byte_end = phi i64 [ 0, %entry ], [ %byte_end.u, %advance ]")
  codegen_util::cg_emit_line(out, "  %at_end = icmp sge i64 %bi, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %at_end, label %done, label %check_start")
  codegen_util::cg_emit_line(out, "check_start:")
  codegen_util::cg_emit_line(out, "  %is_start = icmp eq i64 %ci, %cp_start")
  codegen_util::cg_emit_line(out, "  %byte_start.u = select i1 %is_start, i64 %bi, i64 %byte_start")
  codegen_util::cg_emit_line(out, "  %is_end = icmp eq i64 %ci, %cp_end")
  codegen_util::cg_emit_line(out, "  %byte_end.u = select i1 %is_end, i64 %bi, i64 %byte_end")
  # Determine byte width of current codepoint
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %ptr, i64 %bi")
  codegen_util::cg_emit_line(out, "  %b = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %bz = zext i8 %b to i64")
  codegen_util::cg_emit_line(out, "  %w1 = icmp ult i64 %bz, 128")
  codegen_util::cg_emit_line(out, "  %w2 = icmp ult i64 %bz, 224")
  codegen_util::cg_emit_line(out, "  %w3 = icmp ult i64 %bz, 240")
  codegen_util::cg_emit_line(out, "  %step.a = select i1 %w1, i64 1, i64 2")
  codegen_util::cg_emit_line(out, "  %step.b = select i1 %w2, i64 %step.a, i64 3")
  codegen_util::cg_emit_line(out, "  %step = select i1 %w3, i64 %step.b, i64 4")
  codegen_util::cg_emit_line(out, "  %bi.next = add i64 %bi, %step")
  codegen_util::cg_emit_line(out, "  %ci.next = add i64 %ci, 1")
  codegen_util::cg_emit_line(out, "  br label %advance")
  codegen_util::cg_emit_line(out, "advance:")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "done:")
  # Handle end == total codepoints (slice to end)
  codegen_util::cg_emit_line(out, "  %end_at_end = icmp eq i64 %ci, %cp_end")
  codegen_util::cg_emit_line(out, "  %final_byte_end = select i1 %end_at_end, i64 %blen, i64 %byte_end")
  # Also handle start == total codepoints
  codegen_util::cg_emit_line(out, "  %start_at_end = icmp eq i64 %ci, %cp_start")
  codegen_util::cg_emit_line(out, "  %final_byte_start = select i1 %start_at_end, i64 %blen, i64 %byte_start")
  codegen_util::cg_emit_line(out, "  %slice_len = sub i64 %final_byte_end, %final_byte_start")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %slice_len)")
  codegen_util::cg_emit_line(out, "  %src = getelementptr i8, ptr %ptr, i64 %final_byte_start")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %src, i64 %slice_len)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_find_utf8: find substring, return codepoint offset as Option<Int>
  # Uses strstr for byte search, then counts codepoints to match position
  codegen_util::cg_emit_line(out, "define i64 @qz_str_find_utf8(i64 %hay_s, i64 %ndl_s) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hay = inttoptr i64 %hay_s to ptr")
  codegen_util::cg_emit_line(out, "  %ndl = inttoptr i64 %ndl_s to ptr")
  codegen_util::cg_emit_line(out, "  %found = call ptr @strstr(ptr %hay, ptr %ndl)")
  codegen_util::cg_emit_line(out, "  %isnull = icmp eq ptr %found, null")
  codegen_util::cg_emit_line(out, "  br i1 %isnull, label %not_found, label %count_cp")
  codegen_util::cg_emit_line(out, "count_cp:")
  # Count codepoints from hay to found
  codegen_util::cg_emit_line(out, "  %byte_offset = ptrtoint ptr %found to i64")
  codegen_util::cg_emit_line(out, "  %hay_i = ptrtoint ptr %hay to i64")
  codegen_util::cg_emit_line(out, "  %boff = sub i64 %byte_offset, %hay_i")
  codegen_util::cg_emit_line(out, "  %cp_off = call i64 @qz_str_len_utf8(ptr %hay, i64 %boff)")
  # Build Option::Some(cp_off) — tag 0 = Some (matches cg_emit_option_some_inline)
  codegen_util::cg_emit_line(out, "  %some_raw = call ptr @__qz_alloc(i64 16)")
  codegen_util::cg_emit_line(out, "  %some_tag = bitcast ptr %some_raw to ptr")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %some_tag")
  codegen_util::cg_emit_line(out, "  %some_val_ptr = getelementptr i8, ptr %some_raw, i64 8")
  codegen_util::cg_emit_line(out, "  %some_val_i = bitcast ptr %some_val_ptr to ptr")
  codegen_util::cg_emit_line(out, "  store i64 %cp_off, ptr %some_val_i")
  codegen_util::cg_emit_line(out, "  %some_res = ptrtoint ptr %some_raw to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %some_res")
  codegen_util::cg_emit_line(out, "not_found:")
  # Build Option::None — tag 1 = None (matches cg_emit_option_none_inline)
  codegen_util::cg_emit_line(out, "  %none_raw = call ptr @__qz_alloc(i64 16)")
  codegen_util::cg_emit_line(out, "  %none_tag = bitcast ptr %none_raw to ptr")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %none_tag")
  codegen_util::cg_emit_line(out, "  %none_res = ptrtoint ptr %none_raw to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %none_res")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_chars_utf8: return Vec<Int> of codepoint values
  codegen_util::cg_emit_line(out, "define i64 @qz_str_chars_utf8(i64 %s) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %blen = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %vec = call i64 @qz_vec_new()")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i64 %blen, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %push ]")
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %b = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %bz = zext i8 %b to i64")
  # 1-byte ASCII
  codegen_util::cg_emit_line(out, "  %is1 = icmp ult i64 %bz, 128")
  codegen_util::cg_emit_line(out, "  br i1 %is1, label %cp1, label %chk2")
  codegen_util::cg_emit_line(out, "cp1:")
  codegen_util::cg_emit_line(out, "  br label %push")
  # 2-byte
  codegen_util::cg_emit_line(out, "chk2:")
  codegen_util::cg_emit_line(out, "  %is2 = icmp ult i64 %bz, 224")
  codegen_util::cg_emit_line(out, "  br i1 %is2, label %cp2, label %chk3")
  codegen_util::cg_emit_line(out, "cp2:")
  codegen_util::cg_emit_line(out, "  %i2.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %p2 = getelementptr i8, ptr %ptr, i64 %i2.1")
  codegen_util::cg_emit_line(out, "  %b2 = load i8, ptr %p2")
  codegen_util::cg_emit_line(out, "  %b2z = zext i8 %b2 to i64")
  codegen_util::cg_emit_line(out, "  %c2a = and i64 %bz, 31")
  codegen_util::cg_emit_line(out, "  %c2a1 = shl i64 %c2a, 6")
  codegen_util::cg_emit_line(out, "  %c2b = and i64 %b2z, 63")
  codegen_util::cg_emit_line(out, "  %cp2v = or i64 %c2a1, %c2b")
  codegen_util::cg_emit_line(out, "  br label %push")
  # 3-byte
  codegen_util::cg_emit_line(out, "chk3:")
  codegen_util::cg_emit_line(out, "  %is3 = icmp ult i64 %bz, 240")
  codegen_util::cg_emit_line(out, "  br i1 %is3, label %cp3, label %cp4")
  codegen_util::cg_emit_line(out, "cp3:")
  codegen_util::cg_emit_line(out, "  %i3.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i3.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %p3a = getelementptr i8, ptr %ptr, i64 %i3.1")
  codegen_util::cg_emit_line(out, "  %p3b = getelementptr i8, ptr %ptr, i64 %i3.2")
  codegen_util::cg_emit_line(out, "  %b3a = load i8, ptr %p3a")
  codegen_util::cg_emit_line(out, "  %b3b = load i8, ptr %p3b")
  codegen_util::cg_emit_line(out, "  %b3az = zext i8 %b3a to i64")
  codegen_util::cg_emit_line(out, "  %b3bz = zext i8 %b3b to i64")
  codegen_util::cg_emit_line(out, "  %c3a = and i64 %bz, 15")
  codegen_util::cg_emit_line(out, "  %c3a1 = shl i64 %c3a, 12")
  codegen_util::cg_emit_line(out, "  %c3b = and i64 %b3az, 63")
  codegen_util::cg_emit_line(out, "  %c3b1 = shl i64 %c3b, 6")
  codegen_util::cg_emit_line(out, "  %c3c = and i64 %b3bz, 63")
  codegen_util::cg_emit_line(out, "  %c3ab = or i64 %c3a1, %c3b1")
  codegen_util::cg_emit_line(out, "  %cp3v = or i64 %c3ab, %c3c")
  codegen_util::cg_emit_line(out, "  br label %push")
  # 4-byte
  codegen_util::cg_emit_line(out, "cp4:")
  codegen_util::cg_emit_line(out, "  %i4.1 = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i4.2 = add i64 %i, 2")
  codegen_util::cg_emit_line(out, "  %i4.3 = add i64 %i, 3")
  codegen_util::cg_emit_line(out, "  %p4a = getelementptr i8, ptr %ptr, i64 %i4.1")
  codegen_util::cg_emit_line(out, "  %p4b = getelementptr i8, ptr %ptr, i64 %i4.2")
  codegen_util::cg_emit_line(out, "  %p4c = getelementptr i8, ptr %ptr, i64 %i4.3")
  codegen_util::cg_emit_line(out, "  %b4a = load i8, ptr %p4a")
  codegen_util::cg_emit_line(out, "  %b4b = load i8, ptr %p4b")
  codegen_util::cg_emit_line(out, "  %b4c = load i8, ptr %p4c")
  codegen_util::cg_emit_line(out, "  %b4az = zext i8 %b4a to i64")
  codegen_util::cg_emit_line(out, "  %b4bz = zext i8 %b4b to i64")
  codegen_util::cg_emit_line(out, "  %b4cz = zext i8 %b4c to i64")
  codegen_util::cg_emit_line(out, "  %c4a = and i64 %bz, 7")
  codegen_util::cg_emit_line(out, "  %c4a1 = shl i64 %c4a, 18")
  codegen_util::cg_emit_line(out, "  %c4b = and i64 %b4az, 63")
  codegen_util::cg_emit_line(out, "  %c4b1 = shl i64 %c4b, 12")
  codegen_util::cg_emit_line(out, "  %c4c = and i64 %b4bz, 63")
  codegen_util::cg_emit_line(out, "  %c4c1 = shl i64 %c4c, 6")
  codegen_util::cg_emit_line(out, "  %c4d = and i64 %b4cz, 63")
  codegen_util::cg_emit_line(out, "  %c4ab = or i64 %c4a1, %c4b1")
  codegen_util::cg_emit_line(out, "  %c4cd = or i64 %c4c1, %c4d")
  codegen_util::cg_emit_line(out, "  %cp4v = or i64 %c4ab, %c4cd")
  codegen_util::cg_emit_line(out, "  br label %push")
  # Push codepoint and advance
  codegen_util::cg_emit_line(out, "push:")
  codegen_util::cg_emit_line(out, "  %cpval = phi i64 [ %bz, %cp1 ], [ %cp2v, %cp2 ], [ %cp3v, %cp3 ], [ %cp4v, %cp4 ]")
  codegen_util::cg_emit_line(out, "  %width = phi i64 [ 1, %cp1 ], [ 2, %cp2 ], [ 3, %cp3 ], [ 4, %cp4 ]")
  codegen_util::cg_emit_line(out, "  call void @qz_vec_push(i64 %vec, i64 %cpval)")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, %width")
  codegen_util::cg_emit_line(out, "  %cont = icmp ult i64 %i.next, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %cont, label %loop, label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret i64 %vec")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_reverse_utf8: reverse string by codepoints (preserves multi-byte sequences)
  codegen_util::cg_emit_line(out, "define i64 @qz_str_reverse_utf8(i64 %s) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %src = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %blen = call i64 @qz_str_get_len(ptr %src)")
  codegen_util::cg_emit_line(out, "  %dst = call ptr @qz_alloc_str(i64 %blen)")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i64 %blen, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %si = phi i64 [ 0, %entry ], [ %si.next, %copy ]")
  codegen_util::cg_emit_line(out, "  %di = phi i64 [ %blen, %entry ], [ %di.next, %copy ]")
  # Determine width of codepoint at si
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %src, i64 %si")
  codegen_util::cg_emit_line(out, "  %b = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %bz = zext i8 %b to i64")
  codegen_util::cg_emit_line(out, "  %w1 = icmp ult i64 %bz, 128")
  codegen_util::cg_emit_line(out, "  %w2 = icmp ult i64 %bz, 224")
  codegen_util::cg_emit_line(out, "  %w3 = icmp ult i64 %bz, 240")
  codegen_util::cg_emit_line(out, "  %step.a = select i1 %w1, i64 1, i64 2")
  codegen_util::cg_emit_line(out, "  %step.b = select i1 %w2, i64 %step.a, i64 3")
  codegen_util::cg_emit_line(out, "  %step = select i1 %w3, i64 %step.b, i64 4")
  # di.next = di - step (destination offset for this codepoint)
  codegen_util::cg_emit_line(out, "  %di.next = sub i64 %di, %step")
  # Copy 'step' bytes from src[si] to dst[di.next]
  codegen_util::cg_emit_line(out, "  %dst.p = getelementptr i8, ptr %dst, i64 %di.next")
  codegen_util::cg_emit_line(out, "  %src.p = getelementptr i8, ptr %src, i64 %si")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst.p, ptr %src.p, i64 %step)")
  codegen_util::cg_emit_line(out, "  %si.next = add i64 %si, %step")
  codegen_util::cg_emit_line(out, "  br label %copy")
  codegen_util::cg_emit_line(out, "copy:")
  codegen_util::cg_emit_line(out, "  %more = icmp ult i64 %si.next, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %more, label %loop, label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %dst to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_pad_left_utf8: pad to target codepoint width, pad char on left
  # Uses codepoint count for width comparison, byte-level for memory ops
  codegen_util::cg_emit_line(out, "define i64 @qz_str_pad_left_utf8(i64 %s, i64 %target, i64 %pad) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %padptr = inttoptr i64 %pad to ptr")
  codegen_util::cg_emit_line(out, "  %byte_len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %cp_len = call i64 @qz_str_len_utf8(ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  %padc = load i8, ptr %padptr")
  codegen_util::cg_emit_line(out, "  %need_pad = icmp ult i64 %cp_len, %target")
  codegen_util::cg_emit_line(out, "  br i1 %need_pad, label %do_pad, label %ret_copy")
  codegen_util::cg_emit_line(out, "do_pad:")
  codegen_util::cg_emit_line(out, "  %pad_count = sub i64 %target, %cp_len")
  codegen_util::cg_emit_line(out, "  %total = add i64 %byte_len, %pad_count")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %total)")
  codegen_util::cg_emit_line(out, "  br label %pad_loop")
  codegen_util::cg_emit_line(out, "pad_loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %do_pad ], [ %i.next, %pad_loop ]")
  codegen_util::cg_emit_line(out, "  %dst = getelementptr i8, ptr %buf, i64 %i")
  codegen_util::cg_emit_line(out, "  store i8 %padc, ptr %dst")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %pad_done = icmp uge i64 %i.next, %pad_count")
  codegen_util::cg_emit_line(out, "  br i1 %pad_done, label %copy_src, label %pad_loop")
  codegen_util::cg_emit_line(out, "copy_src:")
  codegen_util::cg_emit_line(out, "  %dst2 = getelementptr i8, ptr %buf, i64 %pad_count")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst2, ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "ret_copy:")
  codegen_util::cg_emit_line(out, "  %cpbuf = call ptr @qz_alloc_str(i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %cpbuf, ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  %cpres = ptrtoint ptr %cpbuf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %cpres")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_pad_right_utf8: pad to target codepoint width, pad char on right
  codegen_util::cg_emit_line(out, "define i64 @qz_str_pad_right_utf8(i64 %s, i64 %target, i64 %pad) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %padptr = inttoptr i64 %pad to ptr")
  codegen_util::cg_emit_line(out, "  %byte_len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %cp_len = call i64 @qz_str_len_utf8(ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  %padc = load i8, ptr %padptr")
  codegen_util::cg_emit_line(out, "  %need_pad = icmp ult i64 %cp_len, %target")
  codegen_util::cg_emit_line(out, "  br i1 %need_pad, label %do_pad, label %ret_copy")
  codegen_util::cg_emit_line(out, "do_pad:")
  codegen_util::cg_emit_line(out, "  %pad_count = sub i64 %target, %cp_len")
  codegen_util::cg_emit_line(out, "  %total = add i64 %byte_len, %pad_count")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %total)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  br label %pad_loop")
  codegen_util::cg_emit_line(out, "pad_loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ %byte_len, %do_pad ], [ %i.next, %pad_loop ]")
  codegen_util::cg_emit_line(out, "  %dst = getelementptr i8, ptr %buf, i64 %i")
  codegen_util::cg_emit_line(out, "  store i8 %padc, ptr %dst")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %pad_done = icmp uge i64 %i.next, %total")
  codegen_util::cg_emit_line(out, "  br i1 %pad_done, label %done, label %pad_loop")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "ret_copy:")
  codegen_util::cg_emit_line(out, "  %cpbuf = call ptr @qz_alloc_str(i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %cpbuf, ptr %ptr, i64 %byte_len)")
  codegen_util::cg_emit_line(out, "  %cpres = ptrtoint ptr %cpbuf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %cpres")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # ============================================================================
  # Binary Vec I/O runtime helpers
  # ============================================================================

  # qz_vec_save: write Vec<Int> to binary file
  # Format: [size:8 bytes][data: size*8 bytes]
  codegen_util::cg_emit_line(out, "define i64 @qz_vec_save(i64 %vec, i64 %path) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %path.s = inttoptr i64 %path to ptr")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
  # Open file for binary write
  codegen_util::cg_emit_line(out, "  %wb = getelementptr [3 x i8], [3 x i8]* @.wb_mode, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fp = call ptr @fopen(ptr %path.s, ptr %wb)")
  codegen_util::cg_emit_line(out, "  %fp.null = icmp eq ptr %fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fp.null, label %fail, label %write")
  codegen_util::cg_emit_line(out, "write:")
  # Write size (8 bytes)
  codegen_util::cg_emit_line(out, "  %size.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  store i64 %size, ptr %size.buf")
  codegen_util::cg_emit_line(out, "  %size.p = bitcast ptr %size.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %size.p, i64 8, i64 1, ptr %fp)")
  # Write data (size * 8 bytes)
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %data, i64 8, i64 %size, ptr %fp)")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fp)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "fail:")
  codegen_util::cg_emit_line(out, "  ret i64 -1")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_vec_load: read Vec<Int> from binary file
  codegen_util::cg_emit_line(out, "define i64 @qz_vec_load(i64 %path) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %path.s = inttoptr i64 %path to ptr")
  codegen_util::cg_emit_line(out, "  %rb = getelementptr [3 x i8], [3 x i8]* @.rb_mode, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fp = call ptr @fopen(ptr %path.s, ptr %rb)")
  codegen_util::cg_emit_line(out, "  %fp.null = icmp eq ptr %fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fp.null, label %fail, label %read.hdr")
  codegen_util::cg_emit_line(out, "read.hdr:")
  # Read size
  codegen_util::cg_emit_line(out, "  %size.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  %size.p = bitcast ptr %size.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %size.p, i64 8, i64 1, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.buf")
  # Allocate Vec header (32 bytes: cap, size, data_ptr, elem_width)
  codegen_util::cg_emit_line(out, "  %hdr.raw = call ptr @__qz_alloc(i64 32)")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %hdr.raw to ptr")
  codegen_util::cg_emit_line(out, "  store i64 %size, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %sz.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 %size, ptr %sz.ptr")
  # Allocate data array
  codegen_util::cg_emit_line(out, "  %bytes = mul i64 %size, 8")
  codegen_util::cg_emit_line(out, "  %bytes.safe = add i64 %bytes, 8")
  codegen_util::cg_emit_line(out, "  %data.raw = call ptr @__qz_alloc(i64 %bytes.safe)")
  codegen_util::cg_emit_line(out, "  %data.i = ptrtoint ptr %data.raw to i64")
  codegen_util::cg_emit_line(out, "  %dp = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 %data.i, ptr %dp")
  codegen_util::cg_emit_line(out, "  %ew.ptr = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 8, ptr %ew.ptr")
  # Read data
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %data.raw, i64 8, i64 %size, ptr %fp)")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fp)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %hdr.raw to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "fail:")
  # Return empty vec on failure
  codegen_util::cg_emit_line(out, "  %empty = call i64 @qz_vec_new()")
  codegen_util::cg_emit_line(out, "  ret i64 %empty")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_strvec_save: write Vec<String> to binary file
  # Format: [count:8][len0:8][data0:len0][len1:8][data1:len1]...
  codegen_util::cg_emit_line(out, "define i64 @qz_strvec_save(i64 %vec, i64 %path) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %path.s = inttoptr i64 %path to ptr")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %count = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %arr = inttoptr i64 %data.i to ptr")
  codegen_util::cg_emit_line(out, "  %wb = getelementptr [3 x i8], [3 x i8]* @.wb_mode, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fp = call ptr @fopen(ptr %path.s, ptr %wb)")
  codegen_util::cg_emit_line(out, "  %fp.null = icmp eq ptr %fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fp.null, label %fail, label %write.hdr")
  codegen_util::cg_emit_line(out, "write.hdr:")
  # Write count
  codegen_util::cg_emit_line(out, "  %cnt.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  store i64 %count, ptr %cnt.buf")
  codegen_util::cg_emit_line(out, "  %cnt.p = bitcast ptr %cnt.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %cnt.p, i64 8, i64 1, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %len.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %write.hdr], [%i.next, %loop.body]")
  codegen_util::cg_emit_line(out, "  %done = icmp uge i64 %i, %count")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %finish, label %loop.body")
  codegen_util::cg_emit_line(out, "loop.body:")
  codegen_util::cg_emit_line(out, "  %ep = getelementptr i64, ptr %arr, i64 %i")
  codegen_util::cg_emit_line(out, "  %ev = load i64, ptr %ep")
  codegen_util::cg_emit_line(out, "  %es = inttoptr i64 %ev to ptr")
  codegen_util::cg_emit_line(out, "  %el = call i64 @qz_str_get_len(ptr %es)")
  # Write string length
  codegen_util::cg_emit_line(out, "  store i64 %el, ptr %len.buf")
  codegen_util::cg_emit_line(out, "  %len.p = bitcast ptr %len.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %len.p, i64 8, i64 1, ptr %fp)")
  # Write string data
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %es, i64 1, i64 %el, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "finish:")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fp)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "fail:")
  codegen_util::cg_emit_line(out, "  ret i64 -1")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_strvec_load: read Vec<String> from binary file
  codegen_util::cg_emit_line(out, "define i64 @qz_strvec_load(i64 %path) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %path.s = inttoptr i64 %path to ptr")
  codegen_util::cg_emit_line(out, "  %rb = getelementptr [3 x i8], [3 x i8]* @.rb_mode, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fp = call ptr @fopen(ptr %path.s, ptr %rb)")
  codegen_util::cg_emit_line(out, "  %fp.null = icmp eq ptr %fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fp.null, label %fail, label %read.hdr")
  codegen_util::cg_emit_line(out, "read.hdr:")
  # Read count
  codegen_util::cg_emit_line(out, "  %cnt.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  %cnt.p = bitcast ptr %cnt.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %cnt.p, i64 8, i64 1, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %count = load i64, ptr %cnt.buf")
  # Create Vec
  codegen_util::cg_emit_line(out, "  %vec = call i64 @qz_vec_new()")
  codegen_util::cg_emit_line(out, "  %len.buf = alloca i64")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %read.hdr], [%i.next, %loop.body]")
  codegen_util::cg_emit_line(out, "  %done = icmp uge i64 %i, %count")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %finish, label %loop.body")
  codegen_util::cg_emit_line(out, "loop.body:")
  # Read string length
  codegen_util::cg_emit_line(out, "  %len.p = bitcast ptr %len.buf to ptr")
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %len.p, i64 8, i64 1, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %slen = load i64, ptr %len.buf")
  # Allocate string and read data
  codegen_util::cg_emit_line(out, "  %sbuf = call ptr @qz_alloc_str(i64 %slen)")
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %sbuf, i64 1, i64 %slen, ptr %fp)")
  codegen_util::cg_emit_line(out, "  %sval = ptrtoint ptr %sbuf to i64")
  codegen_util::cg_emit_line(out, "  call void @qz_vec_push(i64 %vec, i64 %sval)")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "finish:")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fp)")
  codegen_util::cg_emit_line(out, "  ret i64 %vec")
  codegen_util::cg_emit_line(out, "fail:")
  # Return empty vec on failure
  codegen_util::cg_emit_line(out, "  %empty = call i64 @qz_vec_new()")
  codegen_util::cg_emit_line(out, "  ret i64 %empty")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # =========================================================================
  # ALPN Callback for HTTP/2 TLS Negotiation
  # =========================================================================
  # Server-side ALPN callback: selects "h2" or "http/1.1" from client's list.
  # Called by OpenSSL during TLS handshake. Uses SSL_select_next_proto helper.
  # Protocol list format: length-prefixed strings "\x02h2\x08http/1.1"
  # ALPN protocol constants: "h2" and "http/1.1" for server preference matching
  codegen_util::cg_emit_line(out, "@__qz_alpn_h2 = private constant [2 x i8] c\"h2\"")
  codegen_util::cg_emit_line(out, "@__qz_alpn_h1 = private constant [8 x i8] c\"http/1.1\"")
  codegen_util::cg_emit_line(out, "")
  # ALPN callback: scan client's protocol list for "h2" (preferred) or "http/1.1".
  # No OpenSSL helper dependency — pure byte scanning of length-prefixed protocol list.
  # Client sends: [len1][proto1][len2][proto2]...
  codegen_util::cg_emit_line(out, "define i32 @__qz_alpn_select_cb(ptr %ssl, ptr %out, ptr %outlen, ptr %in, i32 %inlen, ptr %arg) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %len = zext i32 %inlen to i64")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "scan:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%next, %advance]")
  codegen_util::cg_emit_line(out, "  %done = icmp uge i64 %i, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %noack, label %read_len")
  codegen_util::cg_emit_line(out, "read_len:")
  codegen_util::cg_emit_line(out, "  %lp = getelementptr i8, ptr %in, i64 %i")
  codegen_util::cg_emit_line(out, "  %plen8 = load i8, ptr %lp")
  codegen_util::cg_emit_line(out, "  %plen = zext i8 %plen8 to i64")
  codegen_util::cg_emit_line(out, "  %start = add i64 %i, 1")
  # Check for "h2" (length=2, bytes='h','2')
  codegen_util::cg_emit_line(out, "  %is2 = icmp eq i64 %plen, 2")
  codegen_util::cg_emit_line(out, "  br i1 %is2, label %check_h2, label %advance")
  codegen_util::cg_emit_line(out, "check_h2:")
  codegen_util::cg_emit_line(out, "  %pp = getelementptr i8, ptr %in, i64 %start")
  codegen_util::cg_emit_line(out, "  %b0 = load i8, ptr %pp")
  codegen_util::cg_emit_line(out, "  %p1 = getelementptr i8, ptr %pp, i64 1")
  codegen_util::cg_emit_line(out, "  %b1 = load i8, ptr %p1")
  codegen_util::cg_emit_line(out, "  %is_h = icmp eq i8 %b0, 104")
  codegen_util::cg_emit_line(out, "  %is_2 = icmp eq i8 %b1, 50")
  codegen_util::cg_emit_line(out, "  %is_h2 = and i1 %is_h, %is_2")
  codegen_util::cg_emit_line(out, "  br i1 %is_h2, label %found_h2, label %advance")
  codegen_util::cg_emit_line(out, "found_h2:")
  codegen_util::cg_emit_line(out, "  store ptr @__qz_alpn_h2, ptr %out")
  codegen_util::cg_emit_line(out, "  store i8 2, ptr %outlen")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "advance:")
  codegen_util::cg_emit_line(out, "  %next = add i64 %start, %plen")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "noack:")
  # SSL_TLSEXT_ERR_NOACK = 3 — no matching protocol
  codegen_util::cg_emit_line(out, "  ret i32 3")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  # Helper: return the function pointer for __qz_alpn_select_cb as i64
  codegen_util::cg_emit_line(out, "define i64 @__qz_alpn_cb_ptr() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %p = ptrtoint ptr @__qz_alpn_select_cb to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %p")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

# ============================================================================
# Per-Struct Hash/Eq Functions + Custom-Key Map Runtime (Phase 5)
# ============================================================================

## Emit per-struct hash and equality functions for all hashable structs.
## Iterates struct_defs and generates @qz_hash_<Name> and @qz_eq_<Name>
## for structs whose fields are all hashable (Int, Bool, String, Symbol).
## Narrow-field structs are skipped (requires typed GEP).
def cg_emit_struct_hash_eq_functions(out: Int, prog: mir::MirProgram): Void
  var struct_defs = mir::mir_get_struct_defs(prog)
  if as_int(struct_defs) == 0
    return
  end
  var count = struct_defs.size
  for i in 0..count
    var entry = struct_defs[i]
    var name = entry.name
    var field_names = entry.field_names
    var field_types = entry.field_types
    var field_count = vec_size(field_names)

    # Skip structs with non-hashable fields
    var all_hashable = true
    var has_narrow = false
    for j in 0..field_count
      var ft = as_string(field_types[j])
      if ft != "Int" and ft != "Bool" and ft != "String" and ft != "Symbol"
        # item 51b — mirror mir_value_struct_eq_name's gate EXACTLY: any narrow
        # fixed-width int (I8/I16/I32/U8/U16/U32/CInt/CChar) is hashable/eq-able via
        # typed-GEP field reads. Using the shared mir_is_narrow_fixed_width helper
        # (rather than an inline 6-type list) keeps codegen's emit decision in sync
        # with the mir-side `==` routing decision, so a struct never routes `==` to
        # a qz_eq_<Name> that codegen then declines to emit (undefined-symbol link).
        if mir::mir_is_narrow_fixed_width(ft) == 1
          has_narrow = true
        else
          all_hashable = false
        end
      end
    end
    # item 51b — narrow-packed value structs (I8/I16/I32/U8/U16/U32 fields) DO get
    # hash/eq emitted now. The narrow struct is emitted with a typed `%struct.Name`
    # aggregate (cg_emit_struct_types), so _cg_emit_struct_hash/_eq read each field
    # via a typed `getelementptr %struct.Name, ..., i32 <idx>` (LLVM computes the
    # real byte offset + skips padding). Only genuinely non-hashable structs (a
    # non-scalar/non-String field) stay excluded.
    if not all_hashable
      continue
    end

    # item 51 — a COW (>16B) value-layout struct is a refcount buffer: word 0 is the
    # atomic refcount header and field f lives at word f+1 (the same +1 shift the
    # field-READ path applies via ctx.cow_field_shift). Flat offset 0..N would read
    # the refcount word (always 1) as field 0. Thread the base word so BOTH the map-
    # key hash/eq and the value-struct `==` routing (mir_lower) address fields
    # identically. GATE-0 INERT: mir_prog_struct_is_cow_layout is 0 for every
    # reference struct (value-layout==0), so base stays 0 ⇒ byte-identical IR.
    var field_word_base = 0
    if mir::mir_prog_struct_is_cow_layout(prog, name) == 1
      field_word_base = 1
    end

    var narrow_flag = 0
    if has_narrow
      narrow_flag = 1
    end
    _cg_emit_struct_hash(out, name, field_types, field_count, field_word_base, narrow_flag)
    _cg_emit_struct_eq(out, name, field_types, field_count, field_word_base, narrow_flag)
  end
end

## Emit FNV-1a hash function for a struct: @qz_hash_<name>(i64 %key) -> i64
## Fields are loaded via GEP from the struct pointer. String fields are hashed
## via @qz_str_hash; all others are XORed directly as i64.
def _cg_emit_struct_hash(out: Int, name: String, field_types: Int, field_count: Int, field_word_base: Int, has_narrow: Int): Void
  codegen_util::cg_emit_line(out, "; FNV-1a hash for struct #{name}")
  codegen_util::cg_emit_line(out, "define i64 @qz_hash_#{name}(i64 %key) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")

  # Edge case: 0-field struct → return FNV offset basis
  if field_count == 0
    codegen_util::cg_emit_line(out, "  ret i64 -3750763034362895579")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    return
  end

  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %key to ptr")
  # item 51b — narrow-packed value struct: fields live at their real (padded) byte
  # offsets in the typed `%struct.Name` aggregate, NOT at flat i64 words. GEP into
  # the type by field index (`i32 idx`) so LLVM computes the exact offset + never
  # reads tail padding. A COW (>16B) narrow struct still has the +8 refcount header;
  # advance the base pointer past it, then GEP into the pure struct type.
  var struct_base = "%ptr"
  if has_narrow == 1 and field_word_base == 1
    codegen_util::cg_emit_line(out, "  %sbase = getelementptr i8, ptr %ptr, i64 8")
    struct_base = "%sbase"
  end

  var prev_hash = "-3750763034362895579"
  for i in 0..field_count
    var ft = as_string(field_types[i])
    var idx = i.to_s()
    # item 51 — cow structs shift field f to word f+base (word 0 = refcount).
    var word = i + field_word_base

    # Load field
    if has_narrow == 1
      # Typed GEP into the aggregate; load the field's native width, zext to i64.
      var llt = mir::mir_type_name_to_llvm(ft)
      codegen_util::cg_emit_line(out, "  %f#{idx}_ptr = getelementptr %struct.#{name}, ptr #{struct_base}, i64 0, i32 #{idx}")
      if llt == "i64" or ft == "String"
        codegen_util::cg_emit_line(out, "  %f#{idx} = load i64, ptr %f#{idx}_ptr")
      else
        codegen_util::cg_emit_line(out, "  %f#{idx}_nw = load #{llt}, ptr %f#{idx}_ptr")
        codegen_util::cg_emit_line(out, "  %f#{idx} = zext #{llt} %f#{idx}_nw to i64")
      end
    elsif word == 0
      codegen_util::cg_emit_line(out, "  %f#{idx} = load i64, ptr %ptr")
    else
      codegen_util::cg_emit_line(out, "  %f#{idx}_ptr = getelementptr i64, ptr %ptr, i64 #{word.to_s()}")
      codegen_util::cg_emit_line(out, "  %f#{idx} = load i64, ptr %f#{idx}_ptr")
    end

    # Hash field
    if ft == "String"
      codegen_util::cg_emit_line(out, "  %f#{idx}_sp = inttoptr i64 %f#{idx} to ptr")
      codegen_util::cg_emit_line(out, "  %f#{idx}_hash = call i64 @qz_str_hash(ptr %f#{idx}_sp)")
      codegen_util::cg_emit_line(out, "  %h#{idx}_xor = xor i64 #{prev_hash}, %f#{idx}_hash")
    else
      codegen_util::cg_emit_line(out, "  %h#{idx}_xor = xor i64 #{prev_hash}, %f#{idx}")
    end
    codegen_util::cg_emit_line(out, "  %h#{idx} = mul i64 %h#{idx}_xor, 1099511628211")
    prev_hash = "%h#{idx}"
  end

  codegen_util::cg_emit_line(out, "  ret i64 #{prev_hash}")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## Emit field-by-field equality for a struct: @qz_eq_<name>(i64 %a, i64 %b) -> i64
## Returns 1 if all fields match, 0 otherwise. String fields use strcmp.
def _cg_emit_struct_eq(out: Int, name: String, field_types: Int, field_count: Int, field_word_base: Int, has_narrow: Int): Void
  codegen_util::cg_emit_line(out, "; Equality for struct #{name}")
  codegen_util::cg_emit_line(out, "define i64 @qz_eq_#{name}(i64 %a, i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")

  # Edge case: 0-field struct → always equal
  if field_count == 0
    codegen_util::cg_emit_line(out, "  ret i64 1")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    return
  end

  codegen_util::cg_emit_line(out, "  %pa = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %pb = inttoptr i64 %b to ptr")
  # item 51b — narrow-packed: read fields at their real byte offsets via a typed
  # GEP into `%struct.Name` (see _cg_emit_struct_hash). Advance past the +8 COW
  # refcount header first when present.
  var abase = "%pa"
  var bbase = "%pb"
  if has_narrow == 1 and field_word_base == 1
    codegen_util::cg_emit_line(out, "  %sabase = getelementptr i8, ptr %pa, i64 8")
    codegen_util::cg_emit_line(out, "  %sbbase = getelementptr i8, ptr %pb, i64 8")
    abase = "%sabase"
    bbase = "%sbbase"
  end

  for i in 0..field_count
    var ft = as_string(field_types[i])
    var idx = i.to_s()
    # item 51 — cow structs shift field f to word f+base (word 0 = refcount).
    var word = i + field_word_base
    var next_label = "check#{i + 1}"
    if i == field_count - 1
      next_label = "equal"
    end

    # Load field from both structs
    if has_narrow == 1
      var llt = mir::mir_type_name_to_llvm(ft)
      codegen_util::cg_emit_line(out, "  %fa#{idx}_ptr = getelementptr %struct.#{name}, ptr #{abase}, i64 0, i32 #{idx}")
      codegen_util::cg_emit_line(out, "  %fb#{idx}_ptr = getelementptr %struct.#{name}, ptr #{bbase}, i64 0, i32 #{idx}")
      if llt == "i64" or ft == "String"
        codegen_util::cg_emit_line(out, "  %fa#{idx} = load i64, ptr %fa#{idx}_ptr")
        codegen_util::cg_emit_line(out, "  %fb#{idx} = load i64, ptr %fb#{idx}_ptr")
      else
        codegen_util::cg_emit_line(out, "  %fa#{idx}_nw = load #{llt}, ptr %fa#{idx}_ptr")
        codegen_util::cg_emit_line(out, "  %fb#{idx}_nw = load #{llt}, ptr %fb#{idx}_ptr")
        codegen_util::cg_emit_line(out, "  %fa#{idx} = zext #{llt} %fa#{idx}_nw to i64")
        codegen_util::cg_emit_line(out, "  %fb#{idx} = zext #{llt} %fb#{idx}_nw to i64")
      end
    elsif word == 0
      codegen_util::cg_emit_line(out, "  %fa#{idx} = load i64, ptr %pa")
      codegen_util::cg_emit_line(out, "  %fb#{idx} = load i64, ptr %pb")
    else
      codegen_util::cg_emit_line(out, "  %fa#{idx}_ptr = getelementptr i64, ptr %pa, i64 #{word.to_s()}")
      codegen_util::cg_emit_line(out, "  %fb#{idx}_ptr = getelementptr i64, ptr %pb, i64 #{word.to_s()}")
      codegen_util::cg_emit_line(out, "  %fa#{idx} = load i64, ptr %fa#{idx}_ptr")
      codegen_util::cg_emit_line(out, "  %fb#{idx} = load i64, ptr %fb#{idx}_ptr")
    end

    # Compare
    if ft == "String"
      codegen_util::cg_emit_line(out, "  %sa#{idx} = inttoptr i64 %fa#{idx} to ptr")
      codegen_util::cg_emit_line(out, "  %sb#{idx} = inttoptr i64 %fb#{idx} to ptr")
      codegen_util::cg_emit_line(out, "  %cmp#{idx}_r = call i32 @strcmp(ptr %sa#{idx}, ptr %sb#{idx})")
      codegen_util::cg_emit_line(out, "  %eq#{idx} = icmp eq i32 %cmp#{idx}_r, 0")
    else
      codegen_util::cg_emit_line(out, "  %eq#{idx} = icmp eq i64 %fa#{idx}, %fb#{idx}")
    end
    codegen_util::cg_emit_line(out, "  br i1 %eq#{idx}, label %#{next_label}, label %neq")

    if i < field_count - 1
      codegen_util::cg_emit_line(out, "#{next_label}:")
    end
  end

  codegen_util::cg_emit_line(out, "equal:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "neq:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## Emit generic custom-key map functions that use function pointers for hash/eq.
## These are standalone LLVM IR functions callable from any struct-key map.
## Map layout: [cap: i64, size: i64, keys_ptr: i64, vals_ptr: i64]
## Slot states: 0=empty, 1=tombstone, >1=occupied key (same as string-key hashmap).
def cg_emit_custom_map_functions(out: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; === Custom-Key Map Functions (Phase 5) ===")
  codegen_util::cg_emit_line(out, "")

  _cg_emit_map_custom_get(out)
  _cg_emit_map_custom_has(out)
  _cg_emit_map_custom_rehash(out)
  _cg_emit_map_custom_set(out)
  _cg_emit_map_custom_delete(out)
  # WS3 — value-compare set algebra over the SAME custom-key layout. These
  # iterate occupied keys (slot > 1) of the string-hashmap layout and use
  # qz_map_custom_has / qz_map_custom_set with the per-struct hash/eq fn pointers,
  # so union/intersection/difference/is_subset respect VALUE equality for struct
  # sets (the intmap-layout @qz_set_* helpers compare by identity + read a `used`
  # byte-array this layout does not have).
  _cg_emit_map_custom_new(out)
  _cg_emit_set_custom_union(out)
  _cg_emit_set_custom_intersection(out)
  _cg_emit_set_custom_difference(out)
  _cg_emit_set_custom_is_subset(out)
end

## @qz_map_custom_new() -> i64
## Fresh empty custom-key map/set: 32-byte header [cap=16, size=0, keys, vals],
## keys zeroed (0 = empty slot). Mirrors the inline `hashmap_new` (cg_intrinsic_data)
## as a CALLABLE helper so the set-algebra helpers below can allocate a result set.
def _cg_emit_map_custom_new(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_map_custom_new() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = call ptr @__qz_alloc(i64 32)")
  codegen_util::cg_emit_line(out, "  store i64 16, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %size.p = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %size.p")
  codegen_util::cg_emit_line(out, "  %keys = call ptr @__qz_alloc(i64 128)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %keys, i32 0, i64 128)")
  codegen_util::cg_emit_line(out, "  %keys.i = ptrtoint ptr %keys to i64")
  codegen_util::cg_emit_line(out, "  %keys.p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 %keys.i, ptr %keys.p")
  codegen_util::cg_emit_line(out, "  %vals = call ptr @__qz_alloc(i64 128)")
  codegen_util::cg_emit_line(out, "  %vals.i = ptrtoint ptr %vals to i64")
  codegen_util::cg_emit_line(out, "  %vals.p = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %vals.i, ptr %vals.p")
  codegen_util::cg_emit_line(out, "  %r = ptrtoint ptr %hdr to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %r")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_set_custom_union(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) -> i64
## New set = all occupied keys of a, then all of b (custom_set dedups by value).
def _cg_emit_set_custom_union(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_set_custom_union(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %new = call i64 @qz_map_custom_new()")
  codegen_util::cg_emit_line(out, "  %a.hdr = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.p = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.p")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %la")
  codegen_util::cg_emit_line(out, "la:")
  codegen_util::cg_emit_line(out, "  %ia = phi i64 [0, %entry], [%ia.n, %ca]")
  codegen_util::cg_emit_line(out, "  %ia.done = icmp sge i64 %ia, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %ia.done, label %lb.init, label %ka")
  codegen_util::cg_emit_line(out, "ka:")
  codegen_util::cg_emit_line(out, "  %a.slot = getelementptr i64, ptr %a.keys, i64 %ia")
  codegen_util::cg_emit_line(out, "  %a.k = load i64, ptr %a.slot")
  codegen_util::cg_emit_line(out, "  %a.occ = icmp ugt i64 %a.k, 1")
  codegen_util::cg_emit_line(out, "  br i1 %a.occ, label %adda, label %ca")
  codegen_util::cg_emit_line(out, "adda:")
  codegen_util::cg_emit_line(out, "  call void @qz_map_custom_set(i64 %new, i64 %a.k, i64 %a.k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  br label %ca")
  codegen_util::cg_emit_line(out, "ca:")
  codegen_util::cg_emit_line(out, "  %ia.n = add i64 %ia, 1")
  codegen_util::cg_emit_line(out, "  br label %la")
  codegen_util::cg_emit_line(out, "lb.init:")
  codegen_util::cg_emit_line(out, "  %b.hdr = inttoptr i64 %b to ptr")
  codegen_util::cg_emit_line(out, "  %b.cap = load i64, ptr %b.hdr")
  codegen_util::cg_emit_line(out, "  %b.keys.p = getelementptr i64, ptr %b.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %b.keys.i = load i64, ptr %b.keys.p")
  codegen_util::cg_emit_line(out, "  %b.keys = inttoptr i64 %b.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %lb")
  codegen_util::cg_emit_line(out, "lb:")
  codegen_util::cg_emit_line(out, "  %ib = phi i64 [0, %lb.init], [%ib.n, %cb]")
  codegen_util::cg_emit_line(out, "  %ib.done = icmp sge i64 %ib, %b.cap")
  codegen_util::cg_emit_line(out, "  br i1 %ib.done, label %fin, label %kb")
  codegen_util::cg_emit_line(out, "kb:")
  codegen_util::cg_emit_line(out, "  %b.slot = getelementptr i64, ptr %b.keys, i64 %ib")
  codegen_util::cg_emit_line(out, "  %b.k = load i64, ptr %b.slot")
  codegen_util::cg_emit_line(out, "  %b.occ = icmp ugt i64 %b.k, 1")
  codegen_util::cg_emit_line(out, "  br i1 %b.occ, label %addb, label %cb")
  codegen_util::cg_emit_line(out, "addb:")
  codegen_util::cg_emit_line(out, "  call void @qz_map_custom_set(i64 %new, i64 %b.k, i64 %b.k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  br label %cb")
  codegen_util::cg_emit_line(out, "cb:")
  codegen_util::cg_emit_line(out, "  %ib.n = add i64 %ib, 1")
  codegen_util::cg_emit_line(out, "  br label %lb")
  codegen_util::cg_emit_line(out, "fin:")
  codegen_util::cg_emit_line(out, "  ret i64 %new")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_set_custom_intersection(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) -> i64
## New set = occupied keys of a that are also members of b (by value).
def _cg_emit_set_custom_intersection(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_set_custom_intersection(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %new = call i64 @qz_map_custom_new()")
  codegen_util::cg_emit_line(out, "  %a.hdr = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.p = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.p")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.n, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %fin, label %chk")
  codegen_util::cg_emit_line(out, "chk:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %a.keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %occ = icmp ugt i64 %k, 1")
  codegen_util::cg_emit_line(out, "  br i1 %occ, label %test, label %cont")
  codegen_util::cg_emit_line(out, "test:")
  codegen_util::cg_emit_line(out, "  %inb = call i64 @qz_map_custom_has(i64 %b, i64 %k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  %isin = icmp ne i64 %inb, 0")
  codegen_util::cg_emit_line(out, "  br i1 %isin, label %add, label %cont")
  codegen_util::cg_emit_line(out, "add:")
  codegen_util::cg_emit_line(out, "  call void @qz_map_custom_set(i64 %new, i64 %k, i64 %k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  br label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.n = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "fin:")
  codegen_util::cg_emit_line(out, "  ret i64 %new")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_set_custom_difference(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) -> i64
## New set = occupied keys of a NOT members of b (by value).
def _cg_emit_set_custom_difference(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_set_custom_difference(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %new = call i64 @qz_map_custom_new()")
