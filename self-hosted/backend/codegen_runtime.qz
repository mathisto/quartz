    # EV_DELETE on a non-existent ident returns ENOENT which is harmless.
    codegen_util::cg_emit_line(out, "  %wk.epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %wk.epfd.i64 = load i64, ptr %wk.epfd.p")
    codegen_util::cg_emit_line(out, "  %wk.epfd = trunc i64 %wk.epfd.i64 to i32")
    codegen_util::cg_emit_line(out, "  %wk.del_kev = alloca [32 x i8]")
    codegen_util::cg_emit_line(out, "  %wk.del_kev.p = bitcast [32 x i8]* %wk.del_kev to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %wk.del_kev.p, i32 0, i64 32)")
    codegen_util::cg_emit_line(out, "  %wk.del_kev.id = bitcast ptr %wk.del_kev.p to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %wk.ident, ptr %wk.del_kev.id")
    codegen_util::cg_emit_line(out, "  %wk.del_kev.f.p = getelementptr i8, ptr %wk.del_kev.p, i64 8")
    codegen_util::cg_emit_line(out, "  %wk.del_kev.f = bitcast ptr %wk.del_kev.f.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 -7, i16* %wk.del_kev.f")
    # flags = EV_DELETE = 2
    codegen_util::cg_emit_line(out, "  %wk.del_kev.fl.p = getelementptr i8, ptr %wk.del_kev.p, i64 10")
    codegen_util::cg_emit_line(out, "  %wk.del_kev.fl = bitcast ptr %wk.del_kev.fl.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 2, i16* %wk.del_kev.fl")
    codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %wk.epfd, ptr %wk.del_kev.p, i32 1, ptr null, i32 0, ptr null)")
  else
    # Linux: ident IS the timerfd. epoll_ctl(EPOLL_CTL_DEL=2) then close(fd).
    codegen_util::cg_emit_line(out, "  %wk.epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %wk.epfd.i64 = load i64, ptr %wk.epfd.p")
    codegen_util::cg_emit_line(out, "  %wk.epfd = trunc i64 %wk.epfd.i64 to i32")
    codegen_util::cg_emit_line(out, "  %wk.tfd.i32 = trunc i64 %wk.ident to i32")
    codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %wk.epfd, i32 2, i32 %wk.tfd.i32, ptr null)")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %wk.tfd.i32)")
