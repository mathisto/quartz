  codegen_util::cg_emit_line(out, "  %sn.new_top = sub i64 %sn.cur_top, %sn.pushed")
  codegen_util::cg_emit_line(out, "  store i64 %sn.new_top, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %sn_done")
  codegen_util::cg_emit_line(out, "sn_done:")
  # Accumulate busy_ns only on sampled polls (every 64th), scaled by 64
  codegen_util::cg_emit_line(out, "  br i1 %bt.do_time, label %bt_end_time, label %bt_skip_end")
  codegen_util::cg_emit_line(out, "bt_end_time:")
  codegen_util::cg_emit_line(out, "  %bt.end = call i64 @__qz_time_mono_ns()")
  codegen_util::cg_emit_line(out, "  %bt.delta = sub i64 %bt.end, %bt.start")
  codegen_util::cg_emit_line(out, "  %bt.scaled = shl i64 %bt.delta, 6")
  codegen_util::cg_emit_line(out, "  %bt.wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %bt.wd.i = load i64, ptr %bt.wd.p")
  codegen_util::cg_emit_line(out, "  %bt.wd = inttoptr i64 %bt.wd.i to ptr")
  codegen_util::cg_emit_line(out, "  %bt.off = mul i64 %wid, 12")
  codegen_util::cg_emit_line(out, "  %bt.slot = getelementptr i64, ptr %bt.wd, i64 %bt.off")
  codegen_util::cg_emit_line(out, "  %bt.busy.p = getelementptr i64, ptr %bt.slot, i64 8")
  codegen_util::cg_emit_line(out, "  %bt.old = load i64, ptr %bt.busy.p")
  codegen_util::cg_emit_line(out, "  %bt.new = add i64 %bt.old, %bt.scaled")
  codegen_util::cg_emit_line(out, "  store i64 %bt.new, ptr %bt.busy.p")
  codegen_util::cg_emit_line(out, "  br label %bt_skip_end")
  codegen_util::cg_emit_line(out, "bt_skip_end:")
  # Clear jmpbuf
  codegen_util::cg_emit_line(out, "  call void @__qz_panic_jmpbuf_set(ptr null)")
  # Check task state: frame[0]
  codegen_util::cg_emit_line(out, "  %state.p = inttoptr i64 %task.i to ptr")
  codegen_util::cg_emit_line(out, "  %state = load i64, ptr %state.p")
  codegen_util::cg_emit_line(out, "  %is_done = icmp eq i64 %state, -1")
