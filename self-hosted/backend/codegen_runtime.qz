  codegen_util::cg_emit_line(out, "  %pc.snap.taken = call i64 @__qz_task_snapshot_take(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_snapshot_free(i64 %pc.snap.taken)")
