    codegen_util::cg_emit_line(out, "@__qz_eff_name_yield = internal unnamed_addr constant [6 x i8] c\"Yield\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_intern = internal unnamed_addr constant [7 x i8] c\"intern\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_resolve = internal unnamed_addr constant [8 x i8] c\"resolve\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_yield = internal unnamed_addr constant [6 x i8] c\"yield\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_await = internal unnamed_addr constant [6 x i8] c\"await\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_spawn = internal unnamed_addr constant [6 x i8] c\"spawn\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_suspend = internal unnamed_addr constant [8 x i8] c\"suspend\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_get = internal unnamed_addr constant [4 x i8] c\"get\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_set = internal unnamed_addr constant [4 x i8] c\"set\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_ask = internal unnamed_addr constant [4 x i8] c\"ask\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_read = internal unnamed_addr constant [9 x i8] c\"fio_read\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_write = internal unnamed_addr constant [10 x i8] c\"fio_write\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_exists = internal unnamed_addr constant [11 x i8] c\"fio_exists\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_list_dir = internal unnamed_addr constant [13 x i8] c\"fio_list_dir\\00\", align 1")
    # Alloc effect string globals — Phase A.3.a (2026-04-26).
