  codegen_util::cg_emit_line(out, "  %rq.ptbl.i = load i64, ptr %rq.ptbl.p")
  codegen_util::cg_emit_line(out, "  %rq.ptbl = inttoptr i64 %rq.ptbl.i to ptr")
