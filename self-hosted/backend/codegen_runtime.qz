  # Trace: PARK event (type=7, task=frame, payload=0)
  codegen_util::cg_emit_line(out, "  call void @__qz_trace_emit(i64 7, i64 %task.i, i64 0)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "do_yield:")
  # During shutdown, drop yielded tasks instead of re-enqueuing (prevents infinite loop)
  # PSQ-7 D5: slot 8 written by shutdown (line ~3555) without mutex via @__qz_signal_shutdown
  # path; read here without the global mutex, so require atomic acquire to pair with the
  # release in shutdown.
  codegen_util::cg_emit_line(out, "  %dy.sd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  %dy.sd = load atomic i64, ptr %dy.sd.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  %dy.is_sd = icmp ne i64 %dy.sd, 0")
  codegen_util::cg_emit_line(out, "  br i1 %dy.is_sd, label %dy_force_done, label %dy_reenqueue")
  codegen_util::cg_emit_line(out, "dy_force_done:")
  # Force task state to done (-1) and go through task_done path
  codegen_util::cg_emit_line(out, "  %dy.fp = inttoptr i64 %task.i to ptr")
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr %dy.fp")
  codegen_util::cg_emit_line(out, "  br label %task_done")
  codegen_util::cg_emit_line(out, "dy_reenqueue:")
  # Task yielded — push to GLOBAL queue (FIFO) to prevent LIFO livelock.
  # Local deque is LIFO: yielded producer would starve consumer parked in deque.
  # Global queue is FIFO: yielded task goes behind other tasks, consumer runs first.
  codegen_util::cg_emit_line(out, "  %dy.saved_wid = load i64, ptr @__qz_current_worker_id")
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr @__qz_current_worker_id")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  store i64 %dy.saved_wid, ptr @__qz_current_worker_id")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "panic_caught:")
  # Task panicked — check if actor (frame[3] == -999) → restart instead of kill
  codegen_util::cg_emit_line(out, "  call void @__qz_panic_jmpbuf_set(ptr null)")
  codegen_util::cg_emit_line(out, "  %pc.task.p = inttoptr i64 %task.i to ptr")
  # Actor restart check: Erlang-style "let it crash" — actor loops restart on panic
  codegen_util::cg_emit_line(out, "  %pc.f3.gep = getelementptr i64, ptr %pc.task.p, i64 3")
  codegen_util::cg_emit_line(out, "  %pc.f3 = load i64, ptr %pc.f3.gep")
  codegen_util::cg_emit_line(out, "  %pc.is_actor = icmp eq i64 %pc.f3, -999")
  codegen_util::cg_emit_line(out, "  br i1 %pc.is_actor, label %pc_actor_restart, label %pc_normal_panic")
  codegen_util::cg_emit_line(out, "pc_actor_restart:")
  # Reset state to 0 (poll_start) — actor loop restarts from recv
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %pc.task.p")
  # Re-enqueue on local queue (actor resumes processing messages)
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %wid, i64 %task.i)")
  codegen_util::cg_emit_line(out, "  call void @__qz_trace_emit(i64 3, i64 %task.i, i64 -999)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "pc_normal_panic:")
  # Non-actor task panicked — mark state as -1 (done), store -1 as result
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr %pc.task.p")
  codegen_util::cg_emit_line(out, "  %pc.res.gep = getelementptr i64, ptr %pc.task.p, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr %pc.res.gep")
  # Cancel-on-failure: panics trigger cancel for positive tokens (cancel_on_failure mode)
  codegen_util::cg_emit_line(out, "  %pc.ct.gep = getelementptr i64, ptr %pc.task.p, i64 3")
  codegen_util::cg_emit_line(out, "  %pc.ct = load i64, ptr %pc.ct.gep")
  codegen_util::cg_emit_line(out, "  %pc.ct.pos = icmp sgt i64 %pc.ct, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pc.ct.pos, label %pc_do_cancel, label %pc_decrement")
  codegen_util::cg_emit_line(out, "pc_do_cancel:")
  codegen_util::cg_emit_line(out, "  %pc.ct.p = inttoptr i64 %pc.ct to ptr")
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr %pc.ct.p seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %pc_decrement")
  codegen_util::cg_emit_line(out, "pc_decrement:")
  # Atomic active_tasks decrement (no global mutex needed)
  codegen_util::cg_emit_line(out, "  %pc.at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
