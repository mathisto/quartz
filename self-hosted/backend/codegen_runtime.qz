    codegen_util::cg_emit_line(out, "  %ih.is_closure = icmp eq i64 %ih.tag, 1")
    codegen_util::cg_emit_line(out, "  br i1 %ih.is_closure, label %ih_closure, label %ih_plain")
    codegen_util::cg_emit_line(out, "ih_closure:")
