  # __qz_sched_spawn(task_frame): enqueue a task frame onto the scheduler
  # If max_tasks > 0, blocks until active_tasks < max_tasks (backpressure)
  codegen_util::cg_emit_line(out, "define void @__qz_sched_spawn(i64 %task) nounwind {")
