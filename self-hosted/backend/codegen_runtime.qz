  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "finish:")
  codegen_util::cg_emit_line(out, "  ret i64 %new.set")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_set_is_subset: returns 1 if all elements of a are in b.
  codegen_util::cg_emit_line(out, "define i64 @qz_set_is_subset(i64 %a, i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %a.hdr = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.ptr = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.ptr")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  %a.used.ptr = getelementptr i64, ptr %a.hdr, i64 4")
  codegen_util::cg_emit_line(out, "  %a.used.i = load i64, ptr %a.used.ptr")
  codegen_util::cg_emit_line(out, "  %a.used = inttoptr i64 %a.used.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %yes, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %u.ptr = getelementptr i8, ptr %a.used, i64 %i")
  codegen_util::cg_emit_line(out, "  %u = load i8, ptr %u.ptr")
  codegen_util::cg_emit_line(out, "  %occ = icmp ne i8 %u, 0")
  codegen_util::cg_emit_line(out, "  br i1 %occ, label %test_b, label %cont")
  codegen_util::cg_emit_line(out, "test_b:")
  codegen_util::cg_emit_line(out, "  %k.ptr = getelementptr i64, ptr %a.keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %val = load i64, ptr %k.ptr")
  codegen_util::cg_emit_line(out, "  %in_b = call i64 @qz_set_has_helper(i64 %b, i64 %val)")
  codegen_util::cg_emit_line(out, "  %is_out = icmp eq i64 %in_b, 0")
