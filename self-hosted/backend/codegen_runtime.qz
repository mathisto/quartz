    # OVERLAPPED_ENTRY is 32 bytes on x86_64; 64 entries × 32 = 2048 bytes,
    # matches kqueue's per-loop budget.
    codegen_util::cg_emit_line(out, "  %ovbuf = alloca [2048 x i8]")
