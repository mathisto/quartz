    # overflow keeps the comparison in __qz_timer_heap_drain_one's icmp sle
    # well-defined; pathological huge timeout_ms collapses to "in the
    # future, indefinitely" which is the desired semantics).
    codegen_util::cg_emit_line(out, "  %tm.now = call i64 @__qz_time_mono_ns()")
    codegen_util::cg_emit_line(out, "  %tm.delta = mul i64 %timeout_ms, 1000000")
    codegen_util::cg_emit_line(out, "  %tm.deadline = add i64 %tm.now, %tm.delta")
    # Push into heap. Caller's responsibility to handle the rare full
    # case: we silently drop (matches POSIX silent-drop on
    # `tfd >= 65536` and the kqueue-ident wraparound). A future ROADMAP
    # follow-up can grow the heap on demand.
    codegen_util::cg_emit_line(out, "  %tm.pushed = call i64 @__qz_timer_heap_push(i64 %tm.deadline, i64 %task)")
    # Side-table set: task → task (any non-zero sentinel; the cancel path
    # uses presence-only, the actual heap surgery happens in
    # __qz_timer_heap_cancel by linear scan).
    codegen_util::cg_emit_line(out, "  call void @__qz_task_timer_set(i64 %task, i64 %task)")
    # Nudge the IOCP poller so it re-computes next_expiry_ms — its current
    # GQCSEx wait may be longer than the new deadline.
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_wake_poller()")
    codegen_util::cg_emit_line(out, "  ret void")
  elsif str_contains(target, "apple") or str_contains(target, "macos")
    # Atomically allocate timer ident: CAS loop wraps 65536 → 2048
    codegen_util::cg_emit_line(out, "  %id.raw = atomicrmw add ptr @__qz_timer_ident, i64 1 seq_cst")
    codegen_util::cg_emit_line(out, "  %id.over = icmp sge i64 %id.raw, 65536")
    codegen_util::cg_emit_line(out, "  br i1 %id.over, label %wrap, label %use_id")
    codegen_util::cg_emit_line(out, "wrap:")
    codegen_util::cg_emit_line(out, "  store i64 2048, ptr @__qz_timer_ident")
    codegen_util::cg_emit_line(out, "  br label %use_id")
    codegen_util::cg_emit_line(out, "use_id:")
    codegen_util::cg_emit_line(out, "  %id = phi i64 [%id.raw, %entry], [2048, %wrap]")
    # Store task at io_map[id]
    codegen_util::cg_emit_line(out, "  %map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
    codegen_util::cg_emit_line(out, "  %map.i = load i64, ptr %map.p")
    codegen_util::cg_emit_line(out, "  %map.base = inttoptr i64 %map.i to ptr")
    codegen_util::cg_emit_line(out, "  %map.slot = getelementptr i64, ptr %map.base, i64 %id")
    codegen_util::cg_emit_line(out, "  store i64 %task, ptr %map.slot")
    # Load kqueue fd
    codegen_util::cg_emit_line(out, "  %epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %epfd.i64 = load i64, ptr %epfd.p")
    codegen_util::cg_emit_line(out, "  %epfd = trunc i64 %epfd.i64 to i32")
    # Register EVFILT_TIMER (-7) with EV_ADD|EV_ONESHOT (17), NOTE_USECONDS (fflags=2)
    codegen_util::cg_emit_line(out, "  %kev = alloca [32 x i8]")
