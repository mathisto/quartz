  codegen_util::cg_emit_line(out, "  %wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.raw = load i64, ptr %wd.p")
  codegen_util::cg_emit_line(out, "  %wd.base = inttoptr i64 %wd.raw to ptr")
  codegen_util::cg_emit_line(out, "  br label %wd_free_loop")
  codegen_util::cg_emit_line(out, "wd_free_loop:")
  codegen_util::cg_emit_line(out, "  %wfi = phi i64 [0, %bn_copy_done], [%wfi.next, %wd_free_next]")
  codegen_util::cg_emit_line(out, "  %wfi.done = icmp uge i64 %wfi, %nw")
  codegen_util::cg_emit_line(out, "  br i1 %wfi.done, label %wd_free_done, label %wd_free_one")
  codegen_util::cg_emit_line(out, "wd_free_one:")
  codegen_util::cg_emit_line(out, "  %wf.off = mul i64 %wfi, 12")
  codegen_util::cg_emit_line(out, "  %wf.slot = getelementptr i64, ptr %wd.base, i64 %wf.off")
  # Free local queue if allocated
  codegen_util::cg_emit_line(out, "  %wf.lq.i = load i64, ptr %wf.slot")
  codegen_util::cg_emit_line(out, "  %wf.lq.has = icmp ne i64 %wf.lq.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %wf.lq.has, label %wf_free_lq, label %wf_check_mtx")
  codegen_util::cg_emit_line(out, "wf_free_lq:")
