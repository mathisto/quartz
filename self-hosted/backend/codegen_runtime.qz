  codegen_util::cg_emit_line(out, "  call void @__qz_trace_emit(i64 1, i64 %task, i64 0)")
  codegen_util::cg_emit_line(out, "  br label %spawn_exit")
  codegen_util::cg_emit_line(out, "spawn_exit:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_reenqueue(task): enqueue without incrementing active_tasks
  # Phase 4: Fast path — push to local deque if on worker thread
  codegen_util::cg_emit_line(out, "define void @__qz_sched_reenqueue(i64 %task) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Check if on worker thread
  codegen_util::cg_emit_line(out, "  %rq.wid = load i64, ptr @__qz_current_worker_id")
  codegen_util::cg_emit_line(out, "  %rq.is_worker = icmp sge i64 %rq.wid, 0")
  codegen_util::cg_emit_line(out, "  br i1 %rq.is_worker, label %rq_local, label %rq_global")
  codegen_util::cg_emit_line(out, "rq_local:")
