  codegen_util::cg_emit_line(out, "  %td.gmtx.i = load i64, ptr %td.gmtx.p")
  codegen_util::cg_emit_line(out, "  %td.gmtx = inttoptr i64 %td.gmtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %td.gmtx)")
  codegen_util::cg_emit_line(out, "  %td.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %td.cond.i = load i64, ptr %td.cond.p")
  codegen_util::cg_emit_line(out, "  %td.cond = inttoptr i64 %td.cond.i to ptr")
