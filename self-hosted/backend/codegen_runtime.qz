  codegen_util::cg_emit_line(out, "  store atomic i64 0, ptr %pk.ps.p monotonic, align 8")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %wid, i64 %task.i)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_park_done:")
