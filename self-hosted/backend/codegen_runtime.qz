    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_phase = internal unnamed_addr constant [11 x i8] c\"prof_phase\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_span_begin = internal unnamed_addr constant [16 x i8] c\"prof_span_begin\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_span_end = internal unnamed_addr constant [14 x i8] c\"prof_span_end\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_sample = internal unnamed_addr constant [12 x i8] c\"prof_sample\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_alloc_site = internal unnamed_addr constant [16 x i8] c\"prof_alloc_site\\00\", align 1")
    # Random effect string globals — Phase A.8 (2026-05-01).
    codegen_util::cg_emit_line(out, "@__qz_eff_name_random = internal unnamed_addr constant [7 x i8] c\"Random\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_rand_seed_op = internal unnamed_addr constant [13 x i8] c\"rand_seed_op\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_rand_int_op = internal unnamed_addr constant [12 x i8] c\"rand_int_op\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_rand_range_op = internal unnamed_addr constant [14 x i8] c\"rand_range_op\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_rand_crypto_op = internal unnamed_addr constant [15 x i8] c\"rand_crypto_op\\00\", align 1")
