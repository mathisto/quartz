    # match. PostQueuedCompletionStatus is a few-hundred-ns call so the
    # threadpool-context overhead is negligible.
    codegen_util::cg_emit_line(out, "  %rw.ok = call i32 @RegisterWaitForSingleObject(ptr %wh.slot, ptr %hproc, ptr @__qz_proc_exit_callback, ptr %task.p, i32 -1, i32 8)")
    codegen_util::cg_emit_line(out, "  %rw.failed = icmp eq i32 %rw.ok, 0")
    codegen_util::cg_emit_line(out, "  br i1 %rw.failed, label %rw_fail, label %rw_done")
    codegen_util::cg_emit_line(out, "rw_fail:")
