  codegen_util::cg_emit_line(out, "  %wd.snap.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.snap.i = load i64, ptr %wd.snap.p")
  codegen_util::cg_emit_line(out, "  %wd.snap = inttoptr i64 %wd.snap.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %bn_copy_loop")
  codegen_util::cg_emit_line(out, "bn_copy_loop:")
