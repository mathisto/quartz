  # the matching cell. Idempotent.
  codegen_util::cg_emit_line(out, "define void @__qz_waiter_unregister(i64 %hu.target, i64 %hu.waiter) nounwind {")
  codegen_util::cg_emit_line(out, "hu_entry:")
  codegen_util::cg_emit_line(out, "  %hu.stripes.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 4")
  codegen_util::cg_emit_line(out, "  %hu.stripes.i = load i64, ptr %hu.stripes.p")
