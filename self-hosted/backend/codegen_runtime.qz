  codegen_util::cg_emit_line(out, "  %thd.sd_i_t.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_i_t.off")
  codegen_util::cg_emit_line(out, "  %thd.sd_i_t = load i64, ptr %thd.sd_i_t.gep")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_off = mul i64 %thd.sd_child, 2")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_d.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_c_off")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_d = load i64, ptr %thd.sd_c_d.gep")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_t.off = add i64 %thd.sd_c_off, 1")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_t.gep = getelementptr i64, ptr %thd.arr, i64 %thd.sd_c_t.off")
  codegen_util::cg_emit_line(out, "  %thd.sd_c_t = load i64, ptr %thd.sd_c_t.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.sd_c_d, ptr %thd.sd_i_d.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.sd_c_t, ptr %thd.sd_i_t.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.sd_i_d, ptr %thd.sd_c_d.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.sd_i_t, ptr %thd.sd_c_t.gep")
  codegen_util::cg_emit_line(out, "  br label %thd_sd_loop")
  codegen_util::cg_emit_line(out, "thd_after_sift:")
