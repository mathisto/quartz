    codegen_util::cg_emit_line(out, "  %filters_base = load ptr, ptr @__qz_effect_stack_op_filters, align 8")
    codegen_util::cg_emit_line(out, "  %handlers_base = load ptr, ptr @__qz_effect_stack_handlers, align 8")
    codegen_util::cg_emit_line(out, "  %bufs_base = load ptr, ptr @__qz_effect_stack_bufs, align 8")
    codegen_util::cg_emit_line(out, "  %results_base = load ptr, ptr @__qz_effect_stack_results, align 8")
    codegen_util::cg_emit_line(out, "  %resumed_base = load ptr, ptr @__qz_effect_stack_resumed, align 8")
