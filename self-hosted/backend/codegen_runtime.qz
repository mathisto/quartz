  codegen_util::cg_emit_line(out, "  %td.tid2.gep = getelementptr i64, ptr %task.p, i64 4")
  codegen_util::cg_emit_line(out, "  %td.tid2 = load i64, ptr %td.tid2.gep")
  codegen_util::cg_emit_line(out, "  %td.tid.nz = icmp ne i64 %td.tid2, 0")
  codegen_util::cg_emit_line(out, "  br i1 %td.tid.nz, label %td_cleanup, label %td_loop")
  codegen_util::cg_emit_line(out, "td_cleanup:")
  codegen_util::cg_emit_line(out, "  call void @__qz_task_local_cleanup(i64 %td.tid2)")
  codegen_util::cg_emit_line(out, "  br label %td_loop")
  codegen_util::cg_emit_line(out, "td_loop:")
  # E.1.c.b: take + free task's effect-stack snapshot (no-op when none).
  codegen_util::cg_emit_line(out, "  %td.snap.taken = call i64 @__qz_task_snapshot_take(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_snapshot_free(i64 %td.snap.taken)")
