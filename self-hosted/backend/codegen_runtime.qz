    codegen_util::cg_emit_line(out, "  %nev = call i32 @kevent(i32 %epfd, ptr null, i32 0, ptr %evbuf.ptr, i32 64, ptr %ts.ptr)")
  else
    codegen_util::cg_emit_line(out, "  %nev = call i32 @epoll_wait(i32 %epfd, ptr %evbuf.ptr, i32 64, i32 1)")  # 1ms (was 100ms)
  end
  # Process events: loop from 0..nev
  codegen_util::cg_emit_line(out, "  %nev.pos = icmp sgt i32 %nev, 0")
  codegen_util::cg_emit_line(out, "  br i1 %nev.pos, label %ev_loop, label %check_shutdown")
  codegen_util::cg_emit_line(out, "ev_loop:")
  codegen_util::cg_emit_line(out, "  %ei = phi i32 [0, %ih_skip], [%ei.next, %ev_next]")
  codegen_util::cg_emit_line(out, "  %ei.done = icmp uge i32 %ei, %nev")
  codegen_util::cg_emit_line(out, "  br i1 %ei.done, label %check_shutdown, label %ev_process")
  codegen_util::cg_emit_line(out, "ev_process:")
  # Extract fd from event
  if str_contains(target, "apple") or str_contains(target, "macos")
    # kqueue: ident at offset 0 of each 32-byte struct
    codegen_util::cg_emit_line(out, "  %ei.i64 = sext i32 %ei to i64")
    codegen_util::cg_emit_line(out, "  %ev.off = mul i64 %ei.i64, 32")
    codegen_util::cg_emit_line(out, "  %ev.p = getelementptr i8, ptr %evbuf.ptr, i64 %ev.off")
    codegen_util::cg_emit_line(out, "  %ev.id.p = bitcast ptr %ev.p to ptr")
    codegen_util::cg_emit_line(out, "  %ev.fd = load i64, ptr %ev.id.p")
    # PROC branch: check filter (offset 8, i16). EVFILT_PROC = -5 means the
    # event is a process-exit notification from sched_register_proc; the
    # "ident" is actually a pid and the task pointer is in udata (offset 24).
    # Skip the io_map lookup (which is fd-indexed and can't store pid→task).
    codegen_util::cg_emit_line(out, "  %ev.f.p = getelementptr i8, ptr %ev.p, i64 8")
    codegen_util::cg_emit_line(out, "  %ev.f = bitcast ptr %ev.f.p to i16*")
    codegen_util::cg_emit_line(out, "  %ev.f.v = load i16, i16* %ev.f")
    codegen_util::cg_emit_line(out, "  %ev.is_proc = icmp eq i16 %ev.f.v, -5")
    codegen_util::cg_emit_line(out, "  br i1 %ev.is_proc, label %ev_proc_mac, label %ev_pipe_check")
    codegen_util::cg_emit_line(out, "ev_proc_mac:")
    codegen_util::cg_emit_line(out, "  %ev.u.p = getelementptr i8, ptr %ev.p, i64 24")
    codegen_util::cg_emit_line(out, "  %ev.u = bitcast ptr %ev.u.p to ptr")
    codegen_util::cg_emit_line(out, "  %ev.proc_task = load i64, ptr %ev.u")
    codegen_util::cg_emit_line(out, "  %ev.proc_has = icmp ne i64 %ev.proc_task, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ev.proc_has, label %ev_proc_mac_enq, label %ev_next")
    codegen_util::cg_emit_line(out, "ev_proc_mac_enq:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %ev.proc_task)")
    codegen_util::cg_emit_line(out, "  br label %ev_next")
    codegen_util::cg_emit_line(out, "ev_pipe_check:")
  else
    # epoll: data.fd at offset 4 of each 12-byte struct
    codegen_util::cg_emit_line(out, "  %ei.i64 = sext i32 %ei to i64")
    codegen_util::cg_emit_line(out, "  %ev.off = mul i64 %ei.i64, 12")
    codegen_util::cg_emit_line(out, "  %ev.p = getelementptr i8, ptr %evbuf.ptr, i64 %ev.off")
    codegen_util::cg_emit_line(out, "  %ev.fd.p = getelementptr i8, ptr %ev.p, i64 4")
    codegen_util::cg_emit_line(out, "  %ev.fd.ptr = bitcast ptr %ev.fd.p to ptr")
    codegen_util::cg_emit_line(out, "  %ev.fd.i32 = load i32, ptr %ev.fd.ptr")
    codegen_util::cg_emit_line(out, "  %ev.fd = sext i32 %ev.fd.i32 to i64")
  end
  # If this is the wakeup pipe fd, set saw_pipe flag and skip to next event
  # (don't exit yet — process remaining I/O events in this batch first)
  codegen_util::cg_emit_line(out, "  %is_pipe = icmp eq i64 %ev.fd, %pr.i64")
  codegen_util::cg_emit_line(out, "  br i1 %is_pipe, label %ev_pipe, label %ev_lookup")
  codegen_util::cg_emit_line(out, "ev_pipe:")
  codegen_util::cg_emit_line(out, "  store i8 1, ptr %saw_pipe")
  codegen_util::cg_emit_line(out, "  br label %ev_next")
  codegen_util::cg_emit_line(out, "ev_lookup:")
  # Atomic xchg io_map[fd] → 0. Atomic-vs-load-store because sched_wake (B.7
  # Phase 4e.8) races against the poller for sched_sleep'd tasks: whoever wins
  # the xchg owns the re-enqueue. If we read 0, sched_wake already claimed it.
  codegen_util::cg_emit_line(out, "  %map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
  codegen_util::cg_emit_line(out, "  %map.i = load i64, ptr %map.p")
  codegen_util::cg_emit_line(out, "  %map.base = inttoptr i64 %map.i to ptr")
  codegen_util::cg_emit_line(out, "  %map.slot = getelementptr i64, ptr %map.base, i64 %ev.fd")
  codegen_util::cg_emit_line(out, "  %ev.task = atomicrmw xchg ptr %map.slot, i64 0 acq_rel")
  codegen_util::cg_emit_line(out, "  %ev.has_task = icmp ne i64 %ev.task, 0")
  codegen_util::cg_emit_line(out, "  br i1 %ev.has_task, label %ev_enqueue, label %ev_next")
  codegen_util::cg_emit_line(out, "ev_enqueue:")
  # B.7 Phase 4e.8: clear the task's pending-timer side-table entry so a
  # subsequent sched_wake on this task correctly falls through to the CAS
  # protocol (instead of trying to cancel an already-fired timer).
  codegen_util::cg_emit_line(out, "  %ev.tt.taken = call i64 @__qz_task_timer_take(i64 %ev.task)")
  # Re-enqueue the task (no active_tasks increment — task already counted)
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %ev.task)")
  # Clean up peer event (timer ↔ I/O) to prevent double-wakeup
  if str_contains(target, "apple") or str_contains(target, "macos")
    # macOS: try to delete EVFILT_TIMER for this ident (harmless if not registered)
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %del_kev.p, i32 0, i64 32)")
    codegen_util::cg_emit_line(out, "  %del_kev.id = bitcast ptr %del_kev.p to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %ev.fd, ptr %del_kev.id")
    # Try delete EVFILT_TIMER (-7) — covers case where I/O fired first
    codegen_util::cg_emit_line(out, "  %del_kev.f.p = getelementptr i8, ptr %del_kev.p, i64 8")
    codegen_util::cg_emit_line(out, "  %del_kev.f = bitcast ptr %del_kev.f.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 -7, i16* %del_kev.f")
    # flags = EV_DELETE = 2
    codegen_util::cg_emit_line(out, "  %del_kev.fl.p = getelementptr i8, ptr %del_kev.p, i64 10")
    codegen_util::cg_emit_line(out, "  %del_kev.fl = bitcast ptr %del_kev.fl.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 2, i16* %del_kev.fl")
    codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %epfd, ptr %del_kev.p, i32 1, ptr null, i32 0, ptr null)")
    # Also try delete EVFILT_READ (-1) — covers case where timer fired first
    codegen_util::cg_emit_line(out, "  store i16 -1, i16* %del_kev.f")
    codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %epfd, ptr %del_kev.p, i32 1, ptr null, i32 0, ptr null)")
    # Also try delete EVFILT_WRITE (-2) — covers write direction
    codegen_util::cg_emit_line(out, "  store i16 -2, i16* %del_kev.f")
    codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %epfd, ptr %del_kev.p, i32 1, ptr null, i32 0, ptr null)")
    codegen_util::cg_emit_line(out, "  br label %ev_next")
  else
    # Linux: check pidfd_set first — if this fd was registered via
    # __qz_sched_register_proc (Linux pidfd_open path), we must close(fd) here
    # because EPOLLONESHOT removed the fd from epoll but didn't close it.
    # Failing to close leaks one fd per child wait.
    codegen_util::cg_emit_line(out, "  %pfds.b.i = load i64, ptr @__qz_pidfd_set")
    codegen_util::cg_emit_line(out, "  %pfds.b.ne = icmp ne i64 %pfds.b.i, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pfds.b.ne, label %pfd_check, label %tp_check_branch")
    codegen_util::cg_emit_line(out, "pfd_check:")
    codegen_util::cg_emit_line(out, "  %pfds.b = inttoptr i64 %pfds.b.i to ptr")
    codegen_util::cg_emit_line(out, "  %pfds.slot = getelementptr i64, ptr %pfds.b, i64 %ev.fd")
    codegen_util::cg_emit_line(out, "  %pfds.val = load i64, ptr %pfds.slot")
    codegen_util::cg_emit_line(out, "  %pfds.is = icmp ne i64 %pfds.val, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pfds.is, label %pfd_close, label %tp_check_branch")
    codegen_util::cg_emit_line(out, "pfd_close:")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %pfds.slot")
    codegen_util::cg_emit_line(out, "  %pfd.close.i32 = trunc i64 %ev.fd to i32")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %pfd.close.i32)")
    # Pidfds are not paired with timers; skip timer_peers check entirely
    codegen_util::cg_emit_line(out, "  br label %ev_next")
    codegen_util::cg_emit_line(out, "tp_check_branch:")
    # Linux: check timer_peers[fd] for peer relationship
    codegen_util::cg_emit_line(out, "  %tp.b.i = load i64, ptr @__qz_timer_peers")
    codegen_util::cg_emit_line(out, "  %tp.has = icmp ne i64 %tp.b.i, 0")
    codegen_util::cg_emit_line(out, "  br i1 %tp.has, label %tp_check, label %ev_next")
    codegen_util::cg_emit_line(out, "tp_check:")
    codegen_util::cg_emit_line(out, "  %tp.b = inttoptr i64 %tp.b.i to ptr")
    codegen_util::cg_emit_line(out, "  %tp.slot = getelementptr i64, ptr %tp.b, i64 %ev.fd")
    codegen_util::cg_emit_line(out, "  %tp.val = load i64, ptr %tp.slot")
    codegen_util::cg_emit_line(out, "  %tp.none = icmp eq i64 %tp.val, 0")
    codegen_util::cg_emit_line(out, "  br i1 %tp.none, label %ev_next, label %tp_cleanup")
    codegen_util::cg_emit_line(out, "tp_cleanup:")
    # Determine if we are the I/O fd (peer >= 0) or the timerfd (peer < 0)
    codegen_util::cg_emit_line(out, "  %tp.is_io = icmp sge i64 %tp.val, 0")
    codegen_util::cg_emit_line(out, "  br i1 %tp.is_io, label %tp_io_fired, label %tp_timer_fired")
    codegen_util::cg_emit_line(out, "tp_io_fired:")
    # I/O fired first: peer = timerfd. Deregister + close timerfd.
    codegen_util::cg_emit_line(out, "  %tp.tfd = trunc i64 %tp.val to i32")
    codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %epfd, i32 2, i32 %tp.tfd, ptr null)")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %tp.tfd)")
    # Clear io_map[tfd] and both timer_peers entries
    codegen_util::cg_emit_line(out, "  %tp.tfd.slot = getelementptr i64, ptr %map.base, i64 %tp.val")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.tfd.slot")
    codegen_util::cg_emit_line(out, "  %tp.peer.slot = getelementptr i64, ptr %tp.b, i64 %tp.val")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.peer.slot")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.slot")
    codegen_util::cg_emit_line(out, "  br label %ev_next")
    codegen_util::cg_emit_line(out, "tp_timer_fired:")
    # Timer fired first: I am timerfd. Peer fd = -(val+1).
    codegen_util::cg_emit_line(out, "  %tp.neg = add i64 %tp.val, 1")
    codegen_util::cg_emit_line(out, "  %tp.peer_fd = sub i64 0, %tp.neg")
    codegen_util::cg_emit_line(out, "  %tp.peer_fd.i32 = trunc i64 %tp.peer_fd to i32")
    # Deregister peer from epoll
    codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %epfd, i32 2, i32 %tp.peer_fd.i32, ptr null)")
    # Close myself (the timerfd)
    codegen_util::cg_emit_line(out, "  %tp.me.i32 = trunc i64 %ev.fd to i32")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %tp.me.i32)")
    # Clear io_map[peer_fd] and both timer_peers entries
    codegen_util::cg_emit_line(out, "  %tp.peer.map.slot = getelementptr i64, ptr %map.base, i64 %tp.peer_fd")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.peer.map.slot")
    codegen_util::cg_emit_line(out, "  %tp.peer.tp.slot = getelementptr i64, ptr %tp.b, i64 %tp.peer_fd")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.peer.tp.slot")
    codegen_util::cg_emit_line(out, "  store i64 0, ptr %tp.slot")
    codegen_util::cg_emit_line(out, "  br label %ev_next")
  end
  codegen_util::cg_emit_line(out, "ev_next:")
  codegen_util::cg_emit_line(out, "  %ei.next = add i32 %ei, 1")
  codegen_util::cg_emit_line(out, "  br label %ev_loop")
  codegen_util::cg_emit_line(out, "check_shutdown:")
  # Check if wakeup pipe was seen — drain pipe bytes to prevent buildup.
  # Only exit if the global shutdown signal is actually set.
  # (register_io also writes to the wakeup pipe to nudge the poller)
  codegen_util::cg_emit_line(out, "  %sp = load i8, ptr %saw_pipe")
  codegen_util::cg_emit_line(out, "  %is_sp = icmp ne i8 %sp, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_sp, label %drain_pipe, label %poll_loop")
  codegen_util::cg_emit_line(out, "drain_pipe:")
  # Drain wakeup pipe (non-blocking read of up to 64 bytes)
  codegen_util::cg_emit_line(out, "  %drain.buf = alloca [64 x i8]")
  codegen_util::cg_emit_line(out, "  %drain.p = bitcast [64 x i8]* %drain.buf to ptr")
  codegen_util::cg_emit_line(out, "  %pr.i32 = trunc i64 %pr.i64 to i32")
  codegen_util::cg_emit_line(out, "  call i64 @read(i32 %pr.i32, ptr %drain.p, i64 64)")
  # Check actual shutdown flag
  codegen_util::cg_emit_line(out, "  %ss.flag = load atomic i64, ptr @__qz_signal_shutdown monotonic, align 8")
  codegen_util::cg_emit_line(out, "  %ss.is_shutdown = icmp ne i64 %ss.flag, 0")
  codegen_util::cg_emit_line(out, "  br i1 %ss.is_shutdown, label %exit, label %poll_loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  ret ptr null")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  end

  # __qz_sched_shutdown(): drain queue, join workers, cleanup
  codegen_util::cg_emit_line(out, "define void @__qz_sched_shutdown() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %init.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 10")
  codegen_util::cg_emit_line(out, "  %init.val = load i64, ptr %init.ptr")
  codegen_util::cg_emit_line(out, "  %not_init = icmp eq i64 %init.val, 0")
  codegen_util::cg_emit_line(out, "  br i1 %not_init, label %noop, label %do_shutdown")
  codegen_util::cg_emit_line(out, "do_shutdown:")
  # B2: transition @__qz_sched_state to STOPPING (2) atomically.
  # Happens FIRST, before any teardown work. sched_is_active() called from
  # another thread will now return 0 (only RUNNING == active), so new
  # spawn/channel/io ops will either error cleanly or take their "scheduler
  # inactive" fallback path instead of racing with the teardown.
  codegen_util::cg_emit_line(out, "  store atomic i64 2, ptr @__qz_sched_state seq_cst, align 8")
  # Phase 1: Wait for all spawned tasks to complete (active_tasks == 0)
  # This ensures I/O-suspended tasks get woken and processed before we tear down.
  codegen_util::cg_emit_line(out, "  %sd.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %sd.mtx.i = load i64, ptr %sd.mtx.p")
  codegen_util::cg_emit_line(out, "  %sd.mtx = inttoptr i64 %sd.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %sd.mtx)")
  # Set draining flag (slot 34) to prevent new spawns during shutdown
  codegen_util::cg_emit_line(out, "  %drain.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 34")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %drain.p")
  codegen_util::cg_emit_line(out, "  br label %wait_active")
  codegen_util::cg_emit_line(out, "wait_active:")
  codegen_util::cg_emit_line(out, "  %wa.at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  %wa.at = load atomic i64, ptr %wa.at.p seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  %wa.done = icmp eq i64 %wa.at, 0")
  codegen_util::cg_emit_line(out, "  br i1 %wa.done, label %all_tasks_done, label %wa_chk_signal")
  # Check if signal-triggered shutdown was requested
  codegen_util::cg_emit_line(out, "wa_chk_signal:")
  codegen_util::cg_emit_line(out, "  %wa.sig = load i64, ptr @__qz_signal_shutdown")
  codegen_util::cg_emit_line(out, "  %wa.sig_set = icmp ne i64 %wa.sig, 0")
  codegen_util::cg_emit_line(out, "  br i1 %wa.sig_set, label %all_tasks_done, label %wait_active_sleep")
  codegen_util::cg_emit_line(out, "wait_active_sleep:")
  codegen_util::cg_emit_line(out, "  %wa.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %wa.cond.i = load i64, ptr %wa.cond.p")
  codegen_util::cg_emit_line(out, "  %wa.cond = inttoptr i64 %wa.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_wait(ptr %wa.cond, ptr %sd.mtx)")
  codegen_util::cg_emit_line(out, "  br label %wait_active")
  codegen_util::cg_emit_line(out, "all_tasks_done:")
  # Phase 2: Set shutdown flag + signal flag UNDER MUTEX (prevents lost wake race)
  codegen_util::cg_emit_line(out, "  %sd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %sd.p")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_signal_shutdown")
  # Broadcast condvar while holding mutex (ensures workers see flag before parking)
  codegen_util::cg_emit_line(out, "  %sd.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %sd.cond.i = load i64, ptr %sd.cond.p")
  codegen_util::cg_emit_line(out, "  %sd.cond = inttoptr i64 %sd.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %sd.cond)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %sd.mtx)")
  # Phase 3: Wake I/O poller (POSIX pipe / Windows IOCP — routed through
  # __qz_sched_wake_poller) so it observes @__qz_signal_shutdown, then join.
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_wake_poller()")
  codegen_util::cg_emit_line(out, "  %io.tid.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 13")
  codegen_util::cg_emit_line(out, "  %io.tid = load i64, ptr %io.tid.p")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_join(i64 %io.tid, ptr null)")
  # Phase 4: Broadcast condvar to wake workers (they'll see shutdown+empty→exit)
  codegen_util::cg_emit_line(out, "  %cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %cond.i = load i64, ptr %cond.p")
  codegen_util::cg_emit_line(out, "  %cond = inttoptr i64 %cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %cond)")
  # Join all workers
  codegen_util::cg_emit_line(out, "  %nw.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 9")
  codegen_util::cg_emit_line(out, "  %nw = load i64, ptr %nw.p")
  codegen_util::cg_emit_line(out, "  %wk.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %wk.i = load i64, ptr %wk.p")
  codegen_util::cg_emit_line(out, "  %wk = inttoptr i64 %wk.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %join_loop")
  codegen_util::cg_emit_line(out, "join_loop:")
  codegen_util::cg_emit_line(out, "  %ji = phi i64 [0, %all_tasks_done], [%ji.next, %join_next]")
  codegen_util::cg_emit_line(out, "  %ji.done = icmp uge i64 %ji, %nw")
  codegen_util::cg_emit_line(out, "  br i1 %ji.done, label %cleanup, label %join_one")
  codegen_util::cg_emit_line(out, "join_one:")
  codegen_util::cg_emit_line(out, "  %tid.p = getelementptr i64, ptr %wk, i64 %ji")
  codegen_util::cg_emit_line(out, "  %tid = load i64, ptr %tid.p")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_join(i64 %tid, ptr null)")
  codegen_util::cg_emit_line(out, "  br label %join_next")
  codegen_util::cg_emit_line(out, "join_next:")
  codegen_util::cg_emit_line(out, "  %ji.next = add i64 %ji, 1")
  codegen_util::cg_emit_line(out, "  br label %join_loop")
  codegen_util::cg_emit_line(out, "cleanup:")
  # Destroy mutex (B2: zero slot 6 after free — prevents dangling ptr after shutdown)
  codegen_util::cg_emit_line(out, "  %mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mtx.i = load i64, ptr %mtx.p")
  codegen_util::cg_emit_line(out, "  %mtx = inttoptr i64 %mtx.i to ptr")
