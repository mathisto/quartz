  # POSIX: write one byte to slot 15 (io_pipe_w). The poller has the read
  #   end registered with kqueue/epoll, so it becomes immediately readable.
  # Windows: PostQueuedCompletionStatus(iocp, 0, key=1, NULL). Key=1 packs
