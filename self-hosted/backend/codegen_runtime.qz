  codegen_util::cg_emit_line(out, "  %tr.mtx.i2 = load i64, ptr %tr.mtx.p2")
  codegen_util::cg_emit_line(out, "  %tr.mtx.r = inttoptr i64 %tr.mtx.i2 to ptr")
