    # consumed by the poller's ev_io: handler — we don't free it here.
    codegen_util::cg_emit_line(out, "  br label %wk_reenqueue")
  end
  codegen_util::cg_emit_line(out, "wk_retry:")
  # Load state with acquire ordering — synchronizes with the parking task's release store of 1.
  codegen_util::cg_emit_line(out, "  %wk.state = load atomic i64, ptr %wk.ps.p acquire, align 8")
  codegen_util::cg_emit_line(out, "  switch i64 %wk.state, label %wk_done [")
  codegen_util::cg_emit_line(out, "    i64 0, label %wk_try_notify")
  codegen_util::cg_emit_line(out, "    i64 1, label %wk_try_unpark")
