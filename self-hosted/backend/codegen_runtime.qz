  codegen_util::cg_emit_line(out, "  %trd.st.gep = getelementptr i64, ptr %trd.arr, i64 %trd.st.off")
  codegen_util::cg_emit_line(out, "  store i64 2, ptr %trd.st.gep")
  codegen_util::cg_emit_line(out, "  br label %trd_unlock")
  codegen_util::cg_emit_line(out, "trd_next:")
