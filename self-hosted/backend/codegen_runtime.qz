  codegen_util::cg_emit_line(out, "  %thd.last_d.gep = getelementptr i64, ptr %thd.arr, i64 %thd.last_off")
  codegen_util::cg_emit_line(out, "  %thd.last_d = load i64, ptr %thd.last_d.gep")
  codegen_util::cg_emit_line(out, "  %thd.last_t.off = add i64 %thd.last_off, 1")
  codegen_util::cg_emit_line(out, "  %thd.last_t.gep = getelementptr i64, ptr %thd.arr, i64 %thd.last_t.off")
  codegen_util::cg_emit_line(out, "  %thd.last_t = load i64, ptr %thd.last_t.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.last_d, ptr %thd.root_d.gep")
  codegen_util::cg_emit_line(out, "  store i64 %thd.last_t, ptr %thd.root_t.gep")
  codegen_util::cg_emit_line(out, "  br label %thd_sd_loop")
