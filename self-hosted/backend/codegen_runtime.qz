  codegen_util::cg_emit_line(out, "  %td.ct.gep = getelementptr i64, ptr %task.p, i64 3")
  codegen_util::cg_emit_line(out, "  %td.ct = load i64, ptr %td.ct.gep")
  codegen_util::cg_emit_line(out, "  %td.ct.actor = icmp eq i64 %td.ct, -999")
  codegen_util::cg_emit_line(out, "  br i1 %td.ct.actor, label %td_decrement, label %td_chk_cancel")
  codegen_util::cg_emit_line(out, "td_chk_cancel:")
  codegen_util::cg_emit_line(out, "  %td.ct.nz = icmp ne i64 %td.ct, 0")
  codegen_util::cg_emit_line(out, "  br i1 %td.ct.nz, label %td_chk_policy, label %td_decrement")
  codegen_util::cg_emit_line(out, "td_chk_policy:")
  codegen_util::cg_emit_line(out, "  %td.res.gep = getelementptr i64, ptr %task.p, i64 1")
  codegen_util::cg_emit_line(out, "  %td.res = load i64, ptr %td.res.gep")
  codegen_util::cg_emit_line(out, "  %td.ct.pos = icmp sgt i64 %td.ct, 0")
  codegen_util::cg_emit_line(out, "  br i1 %td.ct.pos, label %td_cof, label %td_cos")
  # Cancel-on-failure: cancel if result == -1
  codegen_util::cg_emit_line(out, "td_cof:")
  codegen_util::cg_emit_line(out, "  %td.res.err = icmp eq i64 %td.res, -1")
  codegen_util::cg_emit_line(out, "  br i1 %td.res.err, label %td_do_cancel, label %td_decrement")
  # Cancel-on-success: cancel abs(token) if result != -1
  codegen_util::cg_emit_line(out, "td_cos:")
  codegen_util::cg_emit_line(out, "  %td.res.ok = icmp ne i64 %td.res, -1")
  codegen_util::cg_emit_line(out, "  br i1 %td.res.ok, label %td_do_cancel_cos, label %td_decrement")
  codegen_util::cg_emit_line(out, "td_do_cancel:")
  codegen_util::cg_emit_line(out, "  %td.ct.p = inttoptr i64 %td.ct to ptr")
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr %td.ct.p seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %td_decrement")
  codegen_util::cg_emit_line(out, "td_do_cancel_cos:")
  codegen_util::cg_emit_line(out, "  %td.ct.abs = sub i64 0, %td.ct")
  codegen_util::cg_emit_line(out, "  %td.ct.abs.p = inttoptr i64 %td.ct.abs to ptr")
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr %td.ct.abs.p seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %td_decrement")
  codegen_util::cg_emit_line(out, "td_decrement:")
  # Task complete — increment completed counter + decrement active_tasks
  codegen_util::cg_emit_line(out, "  %td.cc.old = atomicrmw add ptr @__qz_sched_completed, i64 1 seq_cst")
  # Atomic active_tasks decrement (no global mutex needed)
  codegen_util::cg_emit_line(out, "  %td.at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  %td.at.old = atomicrmw sub ptr %td.at.p, i64 1 seq_cst")
