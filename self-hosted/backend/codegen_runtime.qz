##! # Codegen Runtime
##!
##! Emits LLVM IR for runtime declarations, helper functions,
##! struct type definitions, target info, and library function declarations.
##!
##! @see codegen_util Shared codegen utilities
##! @see codegen Main code generation module
##! @since 5.13.0

import mir
import codegen_util

# ============================================================================
# FNV-1a String Hash Helper
# ============================================================================

## Emit FNV-1a string hash helper function.
def cg_emit_str_hash_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; FNV-1a string hash")
  if linkonce == 1
    codegen_util::cg_emit_line(out, "define linkonce_odr i64 @__str_hash(ptr %s) nounwind {")
  else
    codegen_util::cg_emit_line(out, "define i64 @__str_hash(ptr %s) nounwind {")
  end
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %idx = phi i64 [0, %entry], [%idx.next, %loop.body]")
  codegen_util::cg_emit_line(out, "  %hash = phi i64 [-3750763034362895579, %entry], [%hash.next, %loop.body]")
  codegen_util::cg_emit_line(out, "  %ptr = getelementptr i8, ptr %s, i64 %idx")
  codegen_util::cg_emit_line(out, "  %byte = load i8, ptr %ptr")
  codegen_util::cg_emit_line(out, "  %done = icmp eq i8 %byte, 0")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %loop.body")
  codegen_util::cg_emit_line(out, "loop.body:")
  codegen_util::cg_emit_line(out, "  %byte.ext = zext i8 %byte to i64")
  codegen_util::cg_emit_line(out, "  %hash.xor = xor i64 %hash, %byte.ext")
  codegen_util::cg_emit_line(out, "  %hash.next = mul i64 %hash.xor, 1099511628211")
  codegen_util::cg_emit_line(out, "  %idx.next = add i64 %idx, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  ret i64 %hash")
  codegen_util::cg_emit_line(out, "}")
end

# ============================================================================
# Effects runtime dispatch helpers (Milestone D.1)
# ============================================================================

## Emit the effect dispatch runtime: handler stack globals + five helper
## functions (init, str_eq, install, uninstall, perform, unhandled).
##
## Effects runtime, Phase 1 D.1 — initial dispatch helpers.
##
## Architecture: dynamic dispatch via a global bounded stack of
## (effect_name_ptr, handler_fn_ptr) entries. MIR_HANDLE_INSTALL pushes;
## MIR_HANDLE_UNINSTALL pops; MIR_PERFORM_OP calls __qz_effect_perform,
## which walks the stack top-down for an effect-name match. On match
## with a non-null handler, calls the handler with the op name pointer;
## on miss or null handler, routes to __qz_effect_unhandled which writes
## a diagnostic to stderr and exits with code 66.
##
## Stack capacity is fixed at 32 entries — effect handlers don't nest
## arbitrarily deep in realistic programs, and a fixed stack avoids
## dynamic allocation + keeps the runtime self-contained. Overflow is
## silently ignored (push clamps at 31); a proper bounds-panic is a
## D.8 polish item.
##
## The linkonce parameter matches the pattern used by cg_emit_str_hash
## and friends — non-zero under separate compilation to avoid multiple-
## definition link errors.
def cg_emit_effect_runtime(out: Int, linkonce: Int, uses_scheduler: Int, uses_intern: Int, uses_cache: Int, uses_profile: Int, uses_yield: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; === Effects runtime (Milestone D.1) ===")

  var linkage_global = "@__qz_effect_stack_top"
  var linkage_names = "@__qz_effect_stack_names"
  var linkage_handlers = "@__qz_effect_stack_handlers"
  var linkage_bufs = "@__qz_effect_stack_bufs"
  var linkage_results = "@__qz_effect_stack_results"
  var linkage_filters = "@__qz_effect_stack_op_filters"
  var linkage_resumed = "@__qz_effect_stack_resumed"
  var linkage_state_slots = "@__qz_effect_stack_state_slots"
  var linkage_current_idx = "@__qz_effect_current_install_idx"
  var linkage_current_kind = "@__qz_effect_current_kind"
  var linkage_current_cont = "@__qz_effect_current_cont_frame"
  var linkage_current_rval = "@__qz_effect_current_resume_val"
  var linkage_park_rv = "@__qz_effect_park_rv"
  # Effects 4.B.4.c: TLS outgoing-value slot for Stream.next() yield
  # capture. Handler writes via __qz_gen_stash(v); Stream.next() reads
  # via __qz_gen_take_stashed() after a POLL_SUSPENDED return. One slot
  # is sufficient because yield is synchronous within a single $poll
  # invocation and Stream.next() consumes before the next invocation.
  var linkage_gen_stashed = "@__qz_gen_stashed_val"
  # Bypass-during-handler TLS flag for the Alloc effect.
  # __qz_effect_perform sets to 1 around the matched-handler call when
  # the matched effect is "Alloc" and restores afterwards. The
  # __qz_alloc/__qz_dealloc wrapper bodies (always routed through
  # perform post-A.7) read this flag and emit direct @malloc/@free
  # when 1, bypassing the handler-stack scan that would otherwise
  # infinite-recurse on a tracking/budget/arena handler that itself
  # allocates. Default 0.
  var linkage_alloc_in_handler = "@__qz_alloc_in_handler"
  # A.4: blessed-handler watermark for the routing-on Alloc fast-path.
  # Captured per-thread by `__qz_effect_install_defaults` — once at
  # qz_main entry, once per scheduler worker at __qz_sched_worker entry
  # (Phase E.1.c). Records the value of __qz_effect_stack_top immediately
  # after the blessed default handlers (Alloc, FileIo, Async, ...) finish
  # installing on this thread. The wrapper checks `top <= bw` to detect
  # the "no user `with Alloc {...}` is on top of the blessed defaults"
  # case and routes directly to malloc/free without entering
  # __qz_effect_perform. Default 0 — before install_defaults runs (or in
  # test/free-standing programs without prelude install) the watermark
  # is 0, top is 0, top<=bw is true, all allocations fast-path direct.
  # TLS so each scheduler worker has its own watermark matching its own
  # blessed-default install.
  var linkage_alloc_bw = "@__qz_alloc_blessed_watermark"
  # Phase E.7: per-worker (TLS) arena pool. `_handles` holds up to
  # ARENA_POOL_CAP=64 i64 arena handles released back to the pool by
  # `__qz_arena_pool_give`; `_count` is the current depth (LIFO,
  # newest at top). On worker thread exit, pooled arenas leak — same
  # lifetime model as TLS effect-stack state (E.1.c). Acquisition via
  # `__qz_arena_pool_take` pops the top; refill happens lazily as
  # callers `arena_release(h)`. Bounds RSS by `parallelism × cap × 64KB`.
  var linkage_arena_pool_handles = "@__qz_arena_pool_handles"
  var linkage_arena_pool_count = "@__qz_arena_pool_count"
  var linkage_unhandled_msg = "@__qz_effect_unhandled_msg"
  # B.7 Phase 4a: canonical TLS for the per-thread current Scope handle.
  # User-side `current_scope()` reads it via the `current_scope_load`
  # intrinsic; `scope_with` writes it via `current_scope_store`. Phase 4b's
  # spawn-time scope inheritance + worker $poll dispatch read/write this
  # same symbol from the compiler runtime IR. Default 0 = "no scope yet" —
  # `current_scope()` returns `scope_root()` lazily in that case so the
  # root-scope allocation deferred until first call.
  var linkage_current_scope = "@__qz_current_scope_handle"
  # B.8 Phase 4b: per-thread Scoped-resource context stack. Each `with X
  # do v -> body end` against a Scoped impl pushes (self, v, rot_fn_ptr)
  # onto this stack BEFORE installing its Throws frame; pops on natural
  # exit. The generic `__qz_scoped_throw_handler` reads the top entry on
  # rethrow to dispatch to the impl's release_on_throw. Cap=256 silently
  # drops on overflow (same shape as the effect stack). TLS so cross-
  # worker Scoped nesting via go_arena stays scoped to the worker that
  # ran the body (parent's stack invisible by design, per Phase E.1.c).
  var linkage_scoped_ctx_top = "@__qz_scoped_ctx_top"
  var linkage_scoped_ctx_self = "@__qz_scoped_ctx_self"
  var linkage_scoped_ctx_v = "@__qz_scoped_ctx_v"
  var linkage_scoped_ctx_rot_fn = "@__qz_scoped_ctx_release_on_throw_fn"

  # Handler stack globals — ALL THREAD-LOCAL as of Phase E.1.c (2026-04-28).
  #
  # Effects F.3b added: bufs (jmpbuf pointer per entry, 0 = "no unwind") +
  # results (stash slot for kind=2 longjmp return).
  # Effects H-delegate added: op_filters — when non-zero, an entry matches
  # ONLY its specific op of the effect (enables per-op install, so
  # multi-op handler records push N entries that fall through to outer
  # handlers on unmatched ops). Zero filter = "any op of this effect."
  # Effects P3.0a added: resumed (per-entry flag set to 1 by `resume(v)` in
  # a kind=3 handler body — tells the with-block teardown "handler
  # invoked resume; with-block value = body's return stashed in
  # results[slot], not handler's return") + current_install_idx (TLS slot
  # carrying the effect-stack index of the currently-executing handler,
  # written by __qz_effect_perform before dispatch; read by resume(v) at
  # the resume site to locate the matching entry's continuation frame in
  # bufs[slot]). See docs/design/P3_0_KIND3_CPS.md §"Q7 handler ABI".
  #
  # Phase E.1.c (2026-04-28): the previous design split TLS/global asymmetrically
  # — `bufs`/`results`/`resumed`/`state_slots` were TLS but `top`/`names`/
  # `handlers`/`op_filters` were global. The reasoning was that workers should
  # see main-thread installs of the blessed defaults (Async/FileIo/Throws/...).
  # That assumption broke when `go_arena(f)` (Phase E.1.a) became the first
  # stdlib API to install non-blessed handlers per-task: two parallel workers
  # each opening a `with Alloc.in_arena(ar) do ... end` block raced on the
  # global `top` (non-atomic load-modify-store) and the `names[top]`/
  # `handlers[top]` slots, corrupting the stack and SIGSEGVing on the loser's
  # subsequent perform. Filed in
  # docs/bugs/EFFECT_STACK_TOP_GLOBAL_MULTI_WORKER_RACE.md.
  #
  # Fix (Phase E.1.c, this commit): make ALL stack arrays + top TLS. To
  # preserve the "workers see the blessed defaults" invariant we re-run
  # `__qz_effect_install_defaults` at every worker thread's entry block
  # (see __qz_sched_worker emit in cg_emit_runtime_decls). Each worker now
  # has its own top + names + handlers + op_filters + watermark; user
  # `with E {...}` installs from inside `go_arena` task bodies stay scoped
  # to the worker that runs them. Matches Erlang/BEAM (per-scheduler
  # process-table view) and Go (per-P runtime state). Cross-worker
  # `with`-scope migration is unsupported by design — `with` is dynamic-
  # extent of the calling thread, and tasks that suspend mid-`with` and
  # resume on a different worker were already UB in the prior design
  # (the bufs/results were TLS, so cross-thread longjmp wouldn't have
  # worked anyway).
  if linkonce == 1
    codegen_util::cg_emit_line(out, "#{linkage_global} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_names} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_handlers} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_bufs} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_results} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_filters} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_resumed} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    # Phase 2 P2.a: evidence-slot array. TLS so nested `with State(v)` across
    # scheduler workers don't corrupt each other. Slot[K] is the state cell
    # for the install at stack-index K. Read/written by the default state
    # handler (and user handlers via __qz_effect_state_get/set).
    codegen_util::cg_emit_line(out, "#{linkage_state_slots} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_idx} = linkonce_odr thread_local global i64 -1, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_kind} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_cont} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_rval} = linkonce_odr thread_local global i64 0, align 8")
    # Effects P3.E-runtime: park-for-wake sentinel TLS. Default POLL_READY (1).
    # A kind=3 handler that calls __qz_effect_park(fd) overwrites this with
    # the scheduler-park encoding `-(fd+2)`. mir_emit_kind3_perform_suspend
    # reads TLS after the perform call and `ret %tls_rv` — POLL_READY means
    # caller's $poll finished normally; the negative sentinel tells the
    # scheduler to park this task on the registered fd/pid/timer instead.
    codegen_util::cg_emit_line(out, "#{linkage_park_rv} = linkonce_odr thread_local global i64 1, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_gen_stashed} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_alloc_in_handler} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_alloc_bw} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_arena_pool_handles} = linkonce_odr thread_local global [64 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_arena_pool_count} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_unhandled_msg} = linkonce_odr unnamed_addr constant [27 x i8] c\"unhandled effect op called\\0A\", align 1")
    codegen_util::cg_emit_line(out, "#{linkage_current_scope} = linkonce_odr thread_local global i64 0, align 8")
    # B.8 Phase 4b: Scoped-ctx TLS arrays.
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_top} = linkonce_odr thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_self} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_v} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_rot_fn} = linkonce_odr thread_local global [256 x i64] zeroinitializer, align 8")
    # C.14.7 — running-actor inbox TLS slot. Written by the auto-generated
    # actor poll loop at $poll entry (via __actor_set_self_inbox); read by
    # actor_self_inbox(), which std/actor.qz::actor_die uses to close the
    # inbox without marking it clean. TLS so cross-worker actor poll
    # resumption refreshes the value (each worker sees its current actor).
    # Default 0 — actor_self_inbox() outside an actor context returns 0.
    codegen_util::cg_emit_line(out, "@__qz_current_actor_inbox = linkonce_odr thread_local global i64 0, align 8")
  else
    codegen_util::cg_emit_line(out, "#{linkage_global} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_names} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_handlers} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_bufs} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_results} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_filters} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_resumed} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_state_slots} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_idx} = internal thread_local global i64 -1, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_kind} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_cont} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_current_rval} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_park_rv} = internal thread_local global i64 1, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_gen_stashed} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_alloc_in_handler} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_alloc_bw} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_arena_pool_handles} = internal thread_local global [64 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_arena_pool_count} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_unhandled_msg} = internal unnamed_addr constant [27 x i8] c\"unhandled effect op called\\0A\", align 1")
    codegen_util::cg_emit_line(out, "#{linkage_current_scope} = internal thread_local global i64 0, align 8")
    # B.8 Phase 4b: Scoped-ctx TLS arrays.
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_top} = internal thread_local global i64 0, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_self} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_v} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    codegen_util::cg_emit_line(out, "#{linkage_scoped_ctx_rot_fn} = internal thread_local global [256 x i64] zeroinitializer, align 8")
    # C.14.7 — running-actor inbox TLS slot (see comment in linkonce branch).
    codegen_util::cg_emit_line(out, "@__qz_current_actor_inbox = internal thread_local global i64 0, align 8")
  end

  var prefix = "define "
  if linkonce == 1
    prefix = "define linkonce_odr "
  end

  # __qz_effect_init: zero the stack top. Defaults register after.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_init() nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_cstr_eq: byte-by-byte null-terminated string compare.
  # Returns 1 on match, 0 otherwise. Pure — no syscalls, no globals.
  codegen_util::cg_emit_line(out, "#{prefix}i1 @__qz_effect_cstr_eq(ptr %a, ptr %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%inext, %advance]")
  codegen_util::cg_emit_line(out, "  %apa = getelementptr i8, ptr %a, i64 %i")
  codegen_util::cg_emit_line(out, "  %apb = getelementptr i8, ptr %b, i64 %i")
  codegen_util::cg_emit_line(out, "  %ca = load i8, ptr %apa")
  codegen_util::cg_emit_line(out, "  %cb = load i8, ptr %apb")
  codegen_util::cg_emit_line(out, "  %eq = icmp eq i8 %ca, %cb")
  codegen_util::cg_emit_line(out, "  br i1 %eq, label %check_end, label %nope")
  codegen_util::cg_emit_line(out, "check_end:")
  codegen_util::cg_emit_line(out, "  %atend = icmp eq i8 %ca, 0")
  codegen_util::cg_emit_line(out, "  br i1 %atend, label %yep, label %advance")
  codegen_util::cg_emit_line(out, "advance:")
  codegen_util::cg_emit_line(out, "  %inext = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "yep:")
  codegen_util::cg_emit_line(out, "  ret i1 1")
  codegen_util::cg_emit_line(out, "nope:")
  codegen_util::cg_emit_line(out, "  ret i1 0")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_handle_install: push (name, handler, buf, op_filter) onto stack.
  # Effects F.3b: `buf_ptr` is the caller's jmp_buf allocation (i64-encoded
  # pointer). Pass 0 when the installer doesn't want unwind semantics
  # (e.g. D.4 default-handler prelude — its Throws handler calls exit()
  # and Log returns normally). kind=2 perform sites use this buf to
  # longjmp back to the matching with-block after the handler returns.
  # Effects H-delegate: `op_filter` is a ptr to a null-terminated op-name
  # string (lives in the string pool, same encoding as eff_name). When
  # non-null, this entry matches ONLY the specified op of the effect;
  # unmatched ops fall through to the next entry. When null, the entry
  # matches any op of the effect (legacy/single-field behavior).
  # Overflow at stack_top==256 silently ignored. **Asymmetry note**:
  # install skips on overflow but uninstall still decrements — this
  # caused the FileIo/Intern wrap-deletion bug (2026-04-23): when stack
  # depth hit 32 during self-compile (max observed = 33), subsequent
  # uninstalls popped legitimately-installed entries below, eventually
  # draining the prelude defaults (Throws/Log/Async/FileIo/Intern) and
  # surfacing as `unhandled effect op called`. Fix: expanded cap 32→256
  # (7x+ headroom over self-compile max). A truly symmetric design
  # (always-increment top + bounds-check reads) is filed as a followup;
  # 256 is adequate for the practical range of wrap-nesting depths in
  # compiler dogfooding.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_handle_install(ptr %eff_name, i64 %handler_ptr, i64 %buf_ptr, ptr %op_filter) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %fits = icmp slt i64 %top, 256")
  codegen_util::cg_emit_line(out, "  br i1 %fits, label %do_push, label %skip")
  codegen_util::cg_emit_line(out, "do_push:")
  codegen_util::cg_emit_line(out, "  %name_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names, i64 0, i64 %top")
  codegen_util::cg_emit_line(out, "  %handler_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_handlers, i64 0, i64 %top")
  codegen_util::cg_emit_line(out, "  %buf_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_bufs, i64 0, i64 %top")
  codegen_util::cg_emit_line(out, "  %filter_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_op_filters, i64 0, i64 %top")
  codegen_util::cg_emit_line(out, "  %eff_i64 = ptrtoint ptr %eff_name to i64")
  codegen_util::cg_emit_line(out, "  %filter_i64 = ptrtoint ptr %op_filter to i64")
  codegen_util::cg_emit_line(out, "  store i64 %eff_i64, ptr %name_slot, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %handler_ptr, ptr %handler_slot, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %buf_ptr, ptr %buf_slot, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %filter_i64, ptr %filter_slot, align 8")
  codegen_util::cg_emit_line(out, "  %top_next = add i64 %top, 1")
  codegen_util::cg_emit_line(out, "  store i64 %top_next, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %skip")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_handle_uninstall: pop one entry. No-op at stack empty.
  # Deliberately doesn't verify name-match — if push/pop get mispaired,
  # the next perform picks up a stale entry; that's a codegen bug, not
  # a runtime concern. D.5 adds push/pop verification if needed.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_handle_uninstall(ptr %eff_name) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %nz = icmp sgt i64 %top, 0")
  codegen_util::cg_emit_line(out, "  br i1 %nz, label %do_pop, label %skip")
  codegen_util::cg_emit_line(out, "do_pop:")
  codegen_util::cg_emit_line(out, "  %top_prev = sub i64 %top, 1")
  codegen_util::cg_emit_line(out, "  store i64 %top_prev, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %skip")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # ---------------------------------------------------------------------
  # E.1.c.b: spawn-time effect-stack snapshot for handler inheritance
  # ---------------------------------------------------------------------
  # E.1.c made every worker boot with only blessed defaults on its TLS
  # effect stack. That broke the canonical pattern
  #   with E { ... } do go fn() end
  # because handlers installed on the parent thread's stack were no
  # longer visible to the spawned task running on a worker. E.1.c.b
  # restores that pattern via spawn-time snapshot:
  #   - At `go fn()` (default Async.spawn handler), capture the parent's
  #     user-installed entries above the blessed_watermark into a heap
  #     buffer and register the buffer pointer in a side-table keyed by
  #     the task frame pointer.
  #   - At each worker $poll dispatch, look up the snapshot, save the
  #     worker's TLS effect_stack_top, apply the snapshot's entries on
  #     top of the worker's blessed defaults, call $poll, then restore
  #     TLS top — net effect: each poll runs with parent's handlers
  #     visible, and the worker's stack is reset on poll exit so other
  #     tasks on the same worker don't observe leaks.
  #   - At task completion, take the snapshot off the side-table and
  #     free the buffer.
  #
  # Snapshot buffer layout (heap, malloc'd):
  #   [0]   i64 count                              — entries above watermark
  #   [1+]  4 i64 per entry: name, handler, filter, state_slot
  # Total bytes: 8 + count * 32.
  #
  # `buf` slot in the live stack carries jmp_buf addresses pinned to the
  # installer's stack frame; we drop them in the snapshot (store 0). That
  # rules out cross-thread kind=2 (longjmp/Throws) handlers — by design.
  # If the parent installs Throws and a goroutine throws, perform falls
  # through to the worker's blessed Throws default. This matches the
  # existing E.1.c semantic that cross-worker `with` migration is UB —
  # the parent's stack may not even exist by the time the worker resumes.
  # `resumed` is per-perform transient (always 0 at install time); not
  # included in the snapshot.

  # __qz_effect_snapshot_capture(): malloc + copy entries above blessed
  # watermark. Returns 0 if no user installs are above watermark — caller
  # uses 0 to short-circuit register/lookup/apply. Capture is read-only on
  # the source TLS stack; it does not modify top/names/handlers.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_snapshot_capture() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sc.top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %sc.bw = load i64, ptr @__qz_alloc_blessed_watermark, align 8")
  codegen_util::cg_emit_line(out, "  %sc.count = sub i64 %sc.top, %sc.bw")
  codegen_util::cg_emit_line(out, "  %sc.has = icmp sgt i64 %sc.count, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sc.has, label %sc_alloc, label %sc_ret_null")
  codegen_util::cg_emit_line(out, "sc_alloc:")
  # Direct @malloc — skip __qz_alloc routing so the snapshot isn't
  # observable to a user Alloc tracking handler currently on the stack.
  codegen_util::cg_emit_line(out, "  %sc.entry_bytes = mul i64 %sc.count, 32")
  codegen_util::cg_emit_line(out, "  %sc.total = add i64 %sc.entry_bytes, 8")
  codegen_util::cg_emit_line(out, "  %sc.buf = call ptr @malloc(i64 %sc.total)")
  codegen_util::cg_emit_line(out, "  store i64 %sc.count, ptr %sc.buf, align 8")
  codegen_util::cg_emit_line(out, "  br label %sc_loop")
  codegen_util::cg_emit_line(out, "sc_loop:")
  codegen_util::cg_emit_line(out, "  %sc.i = phi i64 [0, %sc_alloc], [%sc.i.next, %sc_body]")
  codegen_util::cg_emit_line(out, "  %sc.done = icmp uge i64 %sc.i, %sc.count")
  codegen_util::cg_emit_line(out, "  br i1 %sc.done, label %sc_ret_buf, label %sc_body")
  codegen_util::cg_emit_line(out, "sc_body:")
  codegen_util::cg_emit_line(out, "  %sc.src = add i64 %sc.bw, %sc.i")
  codegen_util::cg_emit_line(out, "  %sc.np = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names, i64 0, i64 %sc.src")
  codegen_util::cg_emit_line(out, "  %sc.nv = load i64, ptr %sc.np, align 8")
  codegen_util::cg_emit_line(out, "  %sc.hp = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_handlers, i64 0, i64 %sc.src")
  codegen_util::cg_emit_line(out, "  %sc.hv = load i64, ptr %sc.hp, align 8")
  codegen_util::cg_emit_line(out, "  %sc.fp = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_op_filters, i64 0, i64 %sc.src")
  codegen_util::cg_emit_line(out, "  %sc.fv = load i64, ptr %sc.fp, align 8")
  codegen_util::cg_emit_line(out, "  %sc.sp = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %sc.src")
  codegen_util::cg_emit_line(out, "  %sc.sv = load i64, ptr %sc.sp, align 8")
  codegen_util::cg_emit_line(out, "  %sc.eo = mul i64 %sc.i, 32")
  codegen_util::cg_emit_line(out, "  %sc.eo8 = add i64 %sc.eo, 8")
  codegen_util::cg_emit_line(out, "  %sc.dst = getelementptr i8, ptr %sc.buf, i64 %sc.eo8")
  codegen_util::cg_emit_line(out, "  store i64 %sc.nv, ptr %sc.dst, align 8")
  codegen_util::cg_emit_line(out, "  %sc.dst_h = getelementptr i8, ptr %sc.dst, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 %sc.hv, ptr %sc.dst_h, align 8")
  codegen_util::cg_emit_line(out, "  %sc.dst_f = getelementptr i8, ptr %sc.dst, i64 16")
  codegen_util::cg_emit_line(out, "  store i64 %sc.fv, ptr %sc.dst_f, align 8")
  codegen_util::cg_emit_line(out, "  %sc.dst_s = getelementptr i8, ptr %sc.dst, i64 24")
  codegen_util::cg_emit_line(out, "  store i64 %sc.sv, ptr %sc.dst_s, align 8")
  codegen_util::cg_emit_line(out, "  %sc.i.next = add i64 %sc.i, 1")
  codegen_util::cg_emit_line(out, "  br label %sc_loop")
  codegen_util::cg_emit_line(out, "sc_ret_buf:")
  codegen_util::cg_emit_line(out, "  %sc.ret = ptrtoint ptr %sc.buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %sc.ret")
  codegen_util::cg_emit_line(out, "sc_ret_null:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_snapshot_apply(snap): push snapshot's entries onto the
  # current thread's TLS effect stack via __qz_effect_handle_install
  # (which already handles the cap=256 overflow path). After install,
  # copy the saved state_slot into the new entry's TLS state_slots[i].
  # Pass buf=0 — cross-thread longjmp is UB so we deliberately drop
  # parent's jmpbuf; kind=2 handlers degrade to the worker's blessed
  # default (typically Throws → exit).
  #
  # Returns the COUNT of entries actually pushed (may be < snap->count
  # if the worker's stack was already near the cap=256 ceiling — install
  # silently skips on overflow). Caller MUST use this count, not the
  # snapshot's nominal count, when truncating top — otherwise restore
  # would drop entries below the blessed watermark on cap-overflow paths.
  # Snap=0 → returns 0 (no-op).
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_snapshot_apply(i64 %sa.snap.i) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sa.nz = icmp ne i64 %sa.snap.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sa.nz, label %sa_load, label %sa_ret_zero")
  codegen_util::cg_emit_line(out, "sa_load:")
  codegen_util::cg_emit_line(out, "  %sa.snap = inttoptr i64 %sa.snap.i to ptr")
  codegen_util::cg_emit_line(out, "  %sa.count = load i64, ptr %sa.snap, align 8")
  codegen_util::cg_emit_line(out, "  %sa.start_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %sa_loop")
  codegen_util::cg_emit_line(out, "sa_loop:")
  codegen_util::cg_emit_line(out, "  %sa.i = phi i64 [0, %sa_load], [%sa.i.next, %sa_after]")
  codegen_util::cg_emit_line(out, "  %sa.done = icmp uge i64 %sa.i, %sa.count")
  codegen_util::cg_emit_line(out, "  br i1 %sa.done, label %sa_ret, label %sa_body")
  codegen_util::cg_emit_line(out, "sa_body:")
  codegen_util::cg_emit_line(out, "  %sa.eo = mul i64 %sa.i, 32")
  codegen_util::cg_emit_line(out, "  %sa.eo8 = add i64 %sa.eo, 8")
  codegen_util::cg_emit_line(out, "  %sa.src = getelementptr i8, ptr %sa.snap, i64 %sa.eo8")
  codegen_util::cg_emit_line(out, "  %sa.nv = load i64, ptr %sa.src, align 8")
  codegen_util::cg_emit_line(out, "  %sa.src_h = getelementptr i8, ptr %sa.src, i64 8")
  codegen_util::cg_emit_line(out, "  %sa.hv = load i64, ptr %sa.src_h, align 8")
  codegen_util::cg_emit_line(out, "  %sa.src_f = getelementptr i8, ptr %sa.src, i64 16")
  codegen_util::cg_emit_line(out, "  %sa.fv = load i64, ptr %sa.src_f, align 8")
  codegen_util::cg_emit_line(out, "  %sa.src_s = getelementptr i8, ptr %sa.src, i64 24")
  codegen_util::cg_emit_line(out, "  %sa.sv = load i64, ptr %sa.src_s, align 8")
  codegen_util::cg_emit_line(out, "  %sa.pre_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %sa.np = inttoptr i64 %sa.nv to ptr")
  codegen_util::cg_emit_line(out, "  %sa.fp = inttoptr i64 %sa.fv to ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr %sa.np, i64 %sa.hv, i64 0, ptr %sa.fp)")
  codegen_util::cg_emit_line(out, "  %sa.post_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %sa.pushed = icmp sgt i64 %sa.post_top, %sa.pre_top")
  codegen_util::cg_emit_line(out, "  br i1 %sa.pushed, label %sa_state, label %sa_after")
  codegen_util::cg_emit_line(out, "sa_state:")
  codegen_util::cg_emit_line(out, "  %sa.ssp = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %sa.pre_top")
  codegen_util::cg_emit_line(out, "  store i64 %sa.sv, ptr %sa.ssp, align 8")
  codegen_util::cg_emit_line(out, "  br label %sa_after")
  codegen_util::cg_emit_line(out, "sa_after:")
  codegen_util::cg_emit_line(out, "  %sa.i.next = add i64 %sa.i, 1")
  codegen_util::cg_emit_line(out, "  br label %sa_loop")
  codegen_util::cg_emit_line(out, "sa_ret:")
  codegen_util::cg_emit_line(out, "  %sa.end_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %sa.delta = sub i64 %sa.end_top, %sa.start_top")
  codegen_util::cg_emit_line(out, "  ret i64 %sa.delta")
  codegen_util::cg_emit_line(out, "sa_ret_zero:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_snapshot_free(snap): @free the snapshot buffer. No-op on 0.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_snapshot_free(i64 %sf.snap.i) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sf.nz = icmp ne i64 %sf.snap.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sf.nz, label %sf_do, label %sf_ret")
  codegen_util::cg_emit_line(out, "sf_do:")
  codegen_util::cg_emit_line(out, "  %sf.p = inttoptr i64 %sf.snap.i to ptr")
  codegen_util::cg_emit_line(out, "  call void @free(ptr %sf.p)")
  codegen_util::cg_emit_line(out, "  br label %sf_ret")
  codegen_util::cg_emit_line(out, "sf_ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_unhandled: write diagnostic to stderr + exit(66).
  # For D.1 the message is a fixed string; stderr tagging with the
  # specific effect+op names lands in a later chunk if worth the
  # sprintf complexity. The exit code 66 matches the EXIT_NOINPUT
  # sysexit convention for "required input missing" — appropriate
  # for "effect handler required but absent."
  #
  # A Path-A diagnostic instrumentation pass (P5.5 session, 2026-04-23)
  # temporarily emitted "<eff>.<op> top=<N>\n" here and at install entry
  # to narrow the FileIo wrap-deletion bug. Findings recorded in
  # `docs/bugs/FILEIO_WRAP_DELETION_UNHANDLED_FIO_WRITE.md` §Diagnostic
  # findings. Instrumentation reverted once the key fact was recorded
  # (top=8635, deterministic across runs, install never sees >40).
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_unhandled(ptr %eff, ptr %op) noreturn nounwind {")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr @__qz_effect_unhandled_msg, i64 27)")
  codegen_util::cg_emit_line(out, "  call void @exit(i32 66)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # Default handler functions registered by D.4's main prelude. These
  # fire when user code invokes an op for a blessed effect and no
  # user `with` block has overridden the default. Blessed set for D.4:
  # Throws (catastrophic — write + exit) and Log (non-fatal — write +
  # return 0). Effect-name globals are used by the main-wrapper to
  # call handle_install at startup.
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@__qz_eff_name_throws = linkonce_odr unnamed_addr constant [7 x i8] c\"Throws\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_name_log = linkonce_odr unnamed_addr constant [4 x i8] c\"Log\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_name_async = linkonce_odr unnamed_addr constant [6 x i8] c\"Async\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_name_file_io = linkonce_odr unnamed_addr constant [7 x i8] c\"FileIo\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_name_intern = linkonce_odr unnamed_addr constant [7 x i8] c\"Intern\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_name_yield = linkonce_odr unnamed_addr constant [6 x i8] c\"Yield\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_intern = linkonce_odr unnamed_addr constant [7 x i8] c\"intern\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_resolve = linkonce_odr unnamed_addr constant [8 x i8] c\"resolve\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_yield = linkonce_odr unnamed_addr constant [6 x i8] c\"yield\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_await = linkonce_odr unnamed_addr constant [6 x i8] c\"await\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_spawn = linkonce_odr unnamed_addr constant [6 x i8] c\"spawn\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_suspend = linkonce_odr unnamed_addr constant [8 x i8] c\"suspend\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_get = linkonce_odr unnamed_addr constant [4 x i8] c\"get\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_set = linkonce_odr unnamed_addr constant [4 x i8] c\"set\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_ask = linkonce_odr unnamed_addr constant [4 x i8] c\"ask\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_read = linkonce_odr unnamed_addr constant [9 x i8] c\"fio_read\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_write = linkonce_odr unnamed_addr constant [10 x i8] c\"fio_write\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_exists = linkonce_odr unnamed_addr constant [11 x i8] c\"fio_exists\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_fio_list_dir = linkonce_odr unnamed_addr constant [13 x i8] c\"fio_list_dir\\00\", align 1")
    # Alloc effect string globals — Phase A.3.a (2026-04-26). Effect name
    # `Alloc` (6 chars + nul) and op names `alloc` / `dealloc`.
    codegen_util::cg_emit_line(out, "@__qz_eff_name_alloc = linkonce_odr unnamed_addr constant [6 x i8] c\"Alloc\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_alloc = linkonce_odr unnamed_addr constant [6 x i8] c\"alloc\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_dealloc = linkonce_odr unnamed_addr constant [8 x i8] c\"dealloc\\00\", align 1")
    # Throws.throw op name + panic prefix qz-string — B.9 Phase 2 (2026-05-02).
    # `panic(msg)` performs Throws.throw with `"panic: " + msg` so user
    # `with Throws { throw: rec } do ... end` blocks can catch panics.
    codegen_util::cg_emit_line(out, "@__qz_eff_op_throw = linkonce_odr unnamed_addr constant [6 x i8] c\"throw\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_panic_prefix_str = linkonce_odr unnamed_addr constant <{ i64, [8 x i8] }> <{ i64 7, [8 x i8] c\"panic: \\00\" }>, align 16")
    # Cache effect string globals — Phase A.3 (2026-05-01). Effect name
    # `Cache` (5 chars + nul) and 6 op names. Op-name lengths include nul:
    # cache_op_lookup=16, cache_op_store=15, cache_op_save_pool=19,
    # cache_op_load_pool=19, cache_op_save_ast=18, cache_op_load_ast=18.
    codegen_util::cg_emit_line(out, "@__qz_eff_name_cache = linkonce_odr unnamed_addr constant [6 x i8] c\"Cache\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_lookup = linkonce_odr unnamed_addr constant [16 x i8] c\"cache_op_lookup\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_store = linkonce_odr unnamed_addr constant [15 x i8] c\"cache_op_store\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_save_pool = linkonce_odr unnamed_addr constant [19 x i8] c\"cache_op_save_pool\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_load_pool = linkonce_odr unnamed_addr constant [19 x i8] c\"cache_op_load_pool\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_save_ast = linkonce_odr unnamed_addr constant [18 x i8] c\"cache_op_save_ast\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_cache_op_load_ast = linkonce_odr unnamed_addr constant [18 x i8] c\"cache_op_load_ast\\00\", align 1")
    # Profile effect string globals — Phase A.6 (2026-05-01). Effect name
    # `Profile` (7 chars + nul) and 5 op names. Lengths include nul:
    # prof_phase=11, prof_span_begin=16, prof_span_end=14, prof_sample=12,
    # prof_alloc_site=16 (B.1 Phase 1, 2026-05-01).
    codegen_util::cg_emit_line(out, "@__qz_eff_name_profile = linkonce_odr unnamed_addr constant [8 x i8] c\"Profile\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_phase = linkonce_odr unnamed_addr constant [11 x i8] c\"prof_phase\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_span_begin = linkonce_odr unnamed_addr constant [16 x i8] c\"prof_span_begin\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_span_end = linkonce_odr unnamed_addr constant [14 x i8] c\"prof_span_end\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_sample = linkonce_odr unnamed_addr constant [12 x i8] c\"prof_sample\\00\", align 1")
    codegen_util::cg_emit_line(out, "@__qz_eff_op_prof_alloc_site = linkonce_odr unnamed_addr constant [16 x i8] c\"prof_alloc_site\\00\", align 1")
    # Random effect string globals — Phase A.8 (2026-05-01). Effect name
