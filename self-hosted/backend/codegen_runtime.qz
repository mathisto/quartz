  codegen_util::cg_emit_line(out, "skip_pq1:")
  codegen_util::cg_emit_line(out, "  %pq3.free.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 28")
  codegen_util::cg_emit_line(out, "  %pq3.free.i = load i64, ptr %pq3.free.p")
  codegen_util::cg_emit_line(out, "  %pq3.free.nz = icmp ne i64 %pq3.free.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pq3.free.nz, label %free_pq3, label %skip_pq3")
  codegen_util::cg_emit_line(out, "free_pq3:")
  codegen_util::cg_emit_line(out, "  %pq3.raw = inttoptr i64 %pq3.free.i to ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %pq3.raw)")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %pq3.free.p")
  codegen_util::cg_emit_line(out, "  br label %skip_pq3")
  codegen_util::cg_emit_line(out, "skip_pq3:")
  # B2: Free priority table (slot 32) — previously leaked entirely.
  # 524288 bytes (65536 i64 entries). Allocated at sched_init:1122-1126.
  codegen_util::cg_emit_line(out, "  %ptbl.free.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 32")
  codegen_util::cg_emit_line(out, "  %ptbl.free.i = load i64, ptr %ptbl.free.p")
  codegen_util::cg_emit_line(out, "  %ptbl.free.nz = icmp ne i64 %ptbl.free.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %ptbl.free.nz, label %free_ptbl, label %skip_ptbl")
  codegen_util::cg_emit_line(out, "free_ptbl:")
  codegen_util::cg_emit_line(out, "  %ptbl.raw = inttoptr i64 %ptbl.free.i to ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %ptbl.raw)")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %ptbl.free.p")
  codegen_util::cg_emit_line(out, "  br label %skip_ptbl")
  codegen_util::cg_emit_line(out, "skip_ptbl:")
  # Reset state
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %init.ptr")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %sd.p")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_signal_shutdown")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %drain.p")
  # B2: transition @__qz_sched_state from STOPPING back to UNINIT (0)
  # atomically. After this point sched_is_active() returns 0 and the
  # scheduler is ready to be re-initialized.
  codegen_util::cg_emit_line(out, "  store atomic i64 0, ptr @__qz_sched_state seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %noop")
  codegen_util::cg_emit_line(out, "noop:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_shutdown_graceful(timeout_ms): timed wait for active_tasks==0
  # Returns 0 if all tasks completed, 1 if timed out.
  # On timeout, force-zeroes active_tasks so subsequent sched_shutdown() drains cleanly.
  # Usage: result = sched_shutdown_graceful(5000); sched_shutdown()
  codegen_util::cg_emit_line(out, "define i64 @__qz_sched_shutdown_graceful(i64 %timeout_ms) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %g.init.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 10")
  codegen_util::cg_emit_line(out, "  %g.init = load i64, ptr %g.init.p")
  codegen_util::cg_emit_line(out, "  %g.not_init = icmp eq i64 %g.init, 0")
  codegen_util::cg_emit_line(out, "  br i1 %g.not_init, label %g.noop, label %g.start")
  codegen_util::cg_emit_line(out, "g.start:")
  # Set draining flag (slot 34) to prevent new spawns during shutdown
  codegen_util::cg_emit_line(out, "  %g.drain.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 34")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %g.drain.p")
  # Compute absolute deadline: clock_gettime(CLOCK_REALTIME=0) + timeout_ms
  codegen_util::cg_emit_line(out, "  %g.ts = alloca [2 x i64]")
  codegen_util::cg_emit_line(out, "  %g.ts.p = bitcast [2 x i64]* %g.ts to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @clock_gettime(i32 0, ptr %g.ts.p)")
  codegen_util::cg_emit_line(out, "  %g.sec = load i64, ptr %g.ts.p")
  codegen_util::cg_emit_line(out, "  %g.nsec.p = getelementptr i64, ptr %g.ts.p, i64 1")
  codegen_util::cg_emit_line(out, "  %g.nsec = load i64, ptr %g.nsec.p")
  codegen_util::cg_emit_line(out, "  %g.to.sec = sdiv i64 %timeout_ms, 1000")
  codegen_util::cg_emit_line(out, "  %g.to.rem = srem i64 %timeout_ms, 1000")
  codegen_util::cg_emit_line(out, "  %g.to.nsec = mul i64 %g.to.rem, 1000000")
  codegen_util::cg_emit_line(out, "  %g.new.sec = add i64 %g.sec, %g.to.sec")
  codegen_util::cg_emit_line(out, "  %g.new.nsec = add i64 %g.nsec, %g.to.nsec")
  codegen_util::cg_emit_line(out, "  %g.overflow = icmp sge i64 %g.new.nsec, 1000000000")
  codegen_util::cg_emit_line(out, "  br i1 %g.overflow, label %g.normalize, label %g.dl_ready")
  codegen_util::cg_emit_line(out, "g.normalize:")
  codegen_util::cg_emit_line(out, "  %g.adj.sec = add i64 %g.new.sec, 1")
  codegen_util::cg_emit_line(out, "  %g.adj.nsec = sub i64 %g.new.nsec, 1000000000")
  codegen_util::cg_emit_line(out, "  br label %g.dl_ready")
  codegen_util::cg_emit_line(out, "g.dl_ready:")
  codegen_util::cg_emit_line(out, "  %g.dl.sec = phi i64 [%g.adj.sec, %g.normalize], [%g.new.sec, %g.start]")
  codegen_util::cg_emit_line(out, "  %g.dl.nsec = phi i64 [%g.adj.nsec, %g.normalize], [%g.new.nsec, %g.start]")
  codegen_util::cg_emit_line(out, "  store i64 %g.dl.sec, ptr %g.ts.p")
  codegen_util::cg_emit_line(out, "  store i64 %g.dl.nsec, ptr %g.nsec.p")
  # Lock mutex, enter timed wait loop
  codegen_util::cg_emit_line(out, "  %g.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %g.mtx.i = load i64, ptr %g.mtx.p")
  codegen_util::cg_emit_line(out, "  %g.mtx = inttoptr i64 %g.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %g.mtx)")
  codegen_util::cg_emit_line(out, "  br label %g.wait")
  codegen_util::cg_emit_line(out, "g.wait:")
  codegen_util::cg_emit_line(out, "  %g.at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  %g.at = load atomic i64, ptr %g.at.p seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  %g.at.done = icmp eq i64 %g.at, 0")
  codegen_util::cg_emit_line(out, "  br i1 %g.at.done, label %g.clean, label %g.timedwait")
  codegen_util::cg_emit_line(out, "g.timedwait:")
  codegen_util::cg_emit_line(out, "  %g.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %g.cond.i = load i64, ptr %g.cond.p")
  codegen_util::cg_emit_line(out, "  %g.cond = inttoptr i64 %g.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  %g.wt.rc = call i32 @pthread_cond_timedwait(ptr %g.cond, ptr %g.mtx, ptr %g.ts.p)")
  # ETIMEDOUT = 60 (macOS) or 110 (Linux)
  codegen_util::cg_emit_line(out, "  %g.is_to60 = icmp eq i32 %g.wt.rc, 60")
  codegen_util::cg_emit_line(out, "  %g.is_to110 = icmp eq i32 %g.wt.rc, 110")
  codegen_util::cg_emit_line(out, "  %g.timed_out = or i1 %g.is_to60, %g.is_to110")
  codegen_util::cg_emit_line(out, "  br i1 %g.timed_out, label %g.timeout, label %g.chk_sig")
  # Check if signal-triggered shutdown was requested
  codegen_util::cg_emit_line(out, "g.chk_sig:")
  codegen_util::cg_emit_line(out, "  %g.sig = load i64, ptr @__qz_signal_shutdown")
  codegen_util::cg_emit_line(out, "  %g.sig_set = icmp ne i64 %g.sig, 0")
  codegen_util::cg_emit_line(out, "  br i1 %g.sig_set, label %g.timeout, label %g.wait")
  # Clean path: all tasks completed within timeout
  codegen_util::cg_emit_line(out, "g.clean:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %g.mtx)")
  codegen_util::cg_emit_line(out, "  br label %g.done")
  # Timeout path: force-zero active_tasks so sched_shutdown won't block
  codegen_util::cg_emit_line(out, "g.timeout:")
  codegen_util::cg_emit_line(out, "  store atomic i64 0, ptr %g.at.p seq_cst, align 8")
  # Set signal flag so blocking recv/send can see shutdown
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_signal_shutdown")
  # Also set the actual shutdown flag (slot 8) so worker loop do_yield force-terminates tasks
  codegen_util::cg_emit_line(out, "  %g.sd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %g.sd.p")
  # Broadcast condvar to wake all workers so they see the shutdown flag
  codegen_util::cg_emit_line(out, "  %g.cv.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %g.cv.i = load i64, ptr %g.cv.p")
  codegen_util::cg_emit_line(out, "  %g.cv = inttoptr i64 %g.cv.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %g.cv)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %g.mtx)")
  codegen_util::cg_emit_line(out, "  br label %g.done")
  codegen_util::cg_emit_line(out, "g.done:")
  codegen_util::cg_emit_line(out, "  %g.result = phi i64 [0, %g.clean], [1, %g.timeout]")
  codegen_util::cg_emit_line(out, "  br label %g.noop")
  codegen_util::cg_emit_line(out, "g.noop:")
  codegen_util::cg_emit_line(out, "  %g.ret = phi i64 [0, %entry], [%g.result, %g.done]")
  codegen_util::cg_emit_line(out, "  ret i64 %g.ret")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_shutdown_on_signal(): install SIGTERM/SIGINT handlers
  # Sets @__qz_signal_shutdown to 1 on signal, writes to wakeup pipe
  codegen_util::cg_emit_line(out, "define void @__qz_signal_handler(i32 %sig) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_signal_shutdown")
  # Write to wakeup pipe to unblock parked workers
  codegen_util::cg_emit_line(out, "  %sh.pw.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 15")
  codegen_util::cg_emit_line(out, "  %sh.pw.i64 = load i64, ptr %sh.pw.p")
  codegen_util::cg_emit_line(out, "  %sh.pw.i32 = trunc i64 %sh.pw.i64 to i32")
  codegen_util::cg_emit_line(out, "  %sh.buf = alloca i8")
  codegen_util::cg_emit_line(out, "  store i8 1, ptr %sh.buf")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 %sh.pw.i32, ptr %sh.buf, i64 1)")
  # Broadcast condvar to wake parked workers
  codegen_util::cg_emit_line(out, "  %sh.cond.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %sh.cond.i = load i64, ptr %sh.cond.p")
  codegen_util::cg_emit_line(out, "  %sh.cond = inttoptr i64 %sh.cond.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %sh.cond)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "define void @__qz_sched_shutdown_on_signal() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Install signal handler for SIGTERM(15) and SIGINT(2)
  codegen_util::cg_emit_line(out, "  %h = bitcast void (i32)* @__qz_signal_handler to ptr")
  codegen_util::cg_emit_line(out, "  call ptr @signal(i32 15, ptr %h)")
  codegen_util::cg_emit_line(out, "  call ptr @signal(i32 2, ptr %h)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  else
    # No scheduler — emit stubs (referenced by async_mutex_unlock and sched_wake intrinsic)
    codegen_util::cg_emit_line(out, "define void @__qz_sched_reenqueue(i64 %task) nounwind { ret void }")
    codegen_util::cg_emit_line(out, "define void @__qz_sched_wake(i64 %task) nounwind { ret void }")
    codegen_util::cg_emit_line(out, "")
  end # uses_scheduler

  # __qz_deadline_thread(env): background thread that sleeps then cancels a token
  # env layout: [token_ptr@0, timeout_ms@8]
  codegen_util::cg_emit_line(out, "define ptr @__qz_deadline_thread(ptr %arg) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %env = bitcast ptr %arg to ptr")
  codegen_util::cg_emit_line(out, "  %tok.i = load i64, ptr %env")
  codegen_util::cg_emit_line(out, "  %ms.gep = getelementptr i64, ptr %env, i64 1")
  codegen_util::cg_emit_line(out, "  %ms = load i64, ptr %ms.gep")
  # Convert ms to useconds for usleep (ms * 1000)
  codegen_util::cg_emit_line(out, "  %us = mul i64 %ms, 1000")
  codegen_util::cg_emit_line(out, "  %us32 = trunc i64 %us to i32")
  codegen_util::cg_emit_line(out, "  call i32 @usleep(i32 %us32)")
  # Cancel the token: atomic store 1
  codegen_util::cg_emit_line(out, "  %tok.p = inttoptr i64 %tok.i to ptr")
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr %tok.p seq_cst, align 8")
  # Free env
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %arg)")
  codegen_util::cg_emit_line(out, "  ret ptr null")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # B.7 Phase 4d — __qz_scope_deadline_thread(env): background thread that
  # sleeps until an absolute monotonic-ns deadline, then calls the user-side
  # @_scope_fire_deadline_exceeded(scope) helper to proactively cancel the
  # scope (which walks descendants under the tree mutex).
  #
  # env layout: [scope_handle@0, abs_deadline_ns@8]. Gated on
  # `uses_scope_deadline` so programs that never call `scope_register_deadline`
  # don't reference @_scope_fire_deadline_exceeded.
  if uses_scope_deadline == 1
    codegen_util::cg_emit_line(out, "define ptr @__qz_scope_deadline_thread(ptr %arg) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %senv = bitcast ptr %arg to ptr")
    codegen_util::cg_emit_line(out, "  %sscope = load i64, ptr %senv")
    codegen_util::cg_emit_line(out, "  %sdl.gep = getelementptr i64, ptr %senv, i64 1")
    codegen_util::cg_emit_line(out, "  %sdl = load i64, ptr %sdl.gep")
    codegen_util::cg_emit_line(out, "  %snow = call i64 @__qz_time_mono_ns()")
    codegen_util::cg_emit_line(out, "  %sdelta = sub i64 %sdl, %snow")
    codegen_util::cg_emit_line(out, "  %spos = icmp sgt i64 %sdelta, 0")
    codegen_util::cg_emit_line(out, "  br i1 %spos, label %sleep_blk, label %fire_blk")
    codegen_util::cg_emit_line(out, "sleep_blk:")
    # delta_ns / 1000 = microseconds; cap to i32 max (~71 minutes) — anything
    # past that, just sleep what fits and the scope-cancel walk catches it.
    codegen_util::cg_emit_line(out, "  %sus = sdiv i64 %sdelta, 1000")
    codegen_util::cg_emit_line(out, "  %sclamped.cmp = icmp sgt i64 %sus, 2147483647")
    codegen_util::cg_emit_line(out, "  %sus.bounded = select i1 %sclamped.cmp, i64 2147483647, i64 %sus")
    codegen_util::cg_emit_line(out, "  %sus32 = trunc i64 %sus.bounded to i32")
    codegen_util::cg_emit_line(out, "  call i32 @usleep(i32 %sus32)")
    codegen_util::cg_emit_line(out, "  br label %fire_blk")
    codegen_util::cg_emit_line(out, "fire_blk:")
    codegen_util::cg_emit_line(out, "  %sret = call i64 @_scope_fire_deadline_exceeded(i64 %sscope)")
    codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %arg)")
    codegen_util::cg_emit_line(out, "  ret ptr null")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

   codegen_util::cg_emit_line(out, "")
   
   # LLVM F64 math intrinsics
   codegen_util::cg_emit_line(out, "; LLVM F64 math intrinsics")
   codegen_util::cg_emit_line(out, "declare double @llvm.sqrt.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.sin.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.cos.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.pow.f64(double, double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.floor.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.ceil.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.round.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.fabs.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.log.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.exp.f64(double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.minnum.f64(double, double)")
   codegen_util::cg_emit_line(out, "declare double @llvm.maxnum.f64(double, double)")
   codegen_util::cg_emit_line(out, "declare double @atan2(double, double)")
   codegen_util::cg_emit_line(out, "declare double @tan(double)")
   codegen_util::cg_emit_line(out, "declare double @asin(double)")
   codegen_util::cg_emit_line(out, "declare double @acos(double)")
   codegen_util::cg_emit_line(out, "declare double @atan(double)")
   codegen_util::cg_emit_line(out, "declare double @log2(double)")
   codegen_util::cg_emit_line(out, "declare double @log10(double)")
   # LLVM bit manipulation intrinsics
   codegen_util::cg_emit_line(out, "; LLVM bit manipulation intrinsics")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.ctpop.i64(i64)")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.ctlz.i64(i64, i1)")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.cttz.i64(i64, i1)")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.bswap.i64(i64)")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.fshl.i64(i64, i64, i64)")
   codegen_util::cg_emit_line(out, "declare i64 @llvm.fshr.i64(i64, i64, i64)")
   # Overflow checking intrinsics
   codegen_util::cg_emit_line(out, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)")
   codegen_util::cg_emit_line(out, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)")
   codegen_util::cg_emit_line(out, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)")
   codegen_util::cg_emit_line(out, "declare {i64, i1} @llvm.uadd.with.overflow.i64(i64, i64)")
   codegen_util::cg_emit_line(out, "declare {i64, i1} @llvm.usub.with.overflow.i64(i64, i64)")
   # x86 hardware-RNG intrinsics (NET.1 Phase 1, Step 2.5)
   codegen_util::cg_emit_line(out, "declare {i64, i32} @llvm.x86.rdrand.64()")
   codegen_util::cg_emit_line(out, "declare {i64, i32} @llvm.x86.rdseed.64()")
   # SIMD LLVM intrinsics
   codegen_util::cg_emit_line(out, "declare <4 x float> @llvm.fma.v4f32(<4 x float>, <4 x float>, <4 x float>)")
   codegen_util::cg_emit_line(out, "declare <2 x double> @llvm.fma.v2f64(<2 x double>, <2 x double>, <2 x double>)")
   codegen_util::cg_emit_line(out, "declare <4 x float> @llvm.minnum.v4f32(<4 x float>, <4 x float>)")
   codegen_util::cg_emit_line(out, "declare <4 x float> @llvm.maxnum.v4f32(<4 x float>, <4 x float>)")
   codegen_util::cg_emit_line(out, "declare <4 x float> @llvm.fabs.v4f32(<4 x float>)")
   codegen_util::cg_emit_line(out, "declare <2 x double> @llvm.minnum.v2f64(<2 x double>, <2 x double>)")
   codegen_util::cg_emit_line(out, "declare <2 x double> @llvm.maxnum.v2f64(<2 x double>, <2 x double>)")
   codegen_util::cg_emit_line(out, "declare <2 x double> @llvm.fabs.v2f64(<2 x double>)")
   # F32x8 (256-bit AVX) LLVM intrinsics
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.fma.v8f32(<8 x float>, <8 x float>, <8 x float>)")
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.minnum.v8f32(<8 x float>, <8 x float>)")
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.maxnum.v8f32(<8 x float>, <8 x float>)")
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.fabs.v8f32(<8 x float>)")
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.sqrt.v8f32(<8 x float>)")
   # SIMD masked gather/scatter intrinsics
   codegen_util::cg_emit_line(out, "declare <4 x float> @llvm.masked.gather.v4f32.v4p0(<4 x ptr>, i32, <4 x i1>, <4 x float>)")
   codegen_util::cg_emit_line(out, "declare <2 x double> @llvm.masked.gather.v2f64.v2p0(<2 x ptr>, i32, <2 x i1>, <2 x double>)")
   codegen_util::cg_emit_line(out, "declare <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr>, i32, <4 x i1>, <4 x i32>)")
   codegen_util::cg_emit_line(out, "declare <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr>, i32, <8 x i1>, <8 x float>)")
   codegen_util::cg_emit_line(out, "declare void @llvm.masked.scatter.v4f32.v4p0(<4 x float>, <4 x ptr>, i32, <4 x i1>)")
   codegen_util::cg_emit_line(out, "declare void @llvm.masked.scatter.v2f64.v2p0(<2 x double>, <2 x ptr>, i32, <2 x i1>)")
   codegen_util::cg_emit_line(out, "declare void @llvm.masked.scatter.v4i32.v4p0(<4 x i32>, <4 x ptr>, i32, <4 x i1>)")
   codegen_util::cg_emit_line(out, "declare void @llvm.masked.scatter.v8f32.v8p0(<8 x float>, <8 x ptr>, i32, <8 x i1>)")
   codegen_util::cg_emit_line(out, "")
   
   # Global argc/argv storage
  codegen_util::cg_emit_line(out, "@qz_argc = global i64 0")
  codegen_util::cg_emit_line(out, "@qz_argv = global ptr null")
  codegen_util::cg_emit_line(out, "")
  # Async frame tracking (always emitted — async constructors reference these)
  codegen_util::cg_emit_line(out, "@__qz_current_frame = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_task_id_counter = global i64 1")
  # TLS side channel for io_suspend_timeout — worker reads after $poll returns -(fd+2)
  codegen_util::cg_emit_line(out, "@__qz_io_pending_timeout = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_events = thread_local global i64 0")
  # TLS side channel for sched_sleep — worker reads after $poll returns -(0+2)=-2
  codegen_util::cg_emit_line(out, "@__qz_io_pending_sleep_ms = thread_local global i64 0")
  # TLS side channel for proc_suspend — when set, worker calls __qz_sched_register_proc
  # instead of __qz_sched_register_io and treats the suspend "fd" as a pid.
  codegen_util::cg_emit_line(out, "@__qz_io_pending_is_proc = thread_local global i64 0")
  # TLS side channel for sched_park — worker checks after $poll returns 0 (yield)
  codegen_util::cg_emit_line(out, "@__qz_sched_park_pending = thread_local global i64 0")
  # TLS worker ID — -1 for non-workers (main thread), 0..N-1 for scheduler workers
  codegen_util::cg_emit_line(out, "@__qz_current_worker_id = thread_local global i64 -1")
  # TLS LIFO slot for cache-hot task execution (Tokio optimization)
  codegen_util::cg_emit_line(out, "@__qz_lifo_task = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_lifo_count = thread_local global i64 0")
  # TLS fuel counter for preemptive scheduling (P21: BEAM-style reduction counting)
  # Initialized to INT64_MAX so non-scheduler code effectively never yields.
  # Scheduler workers reset to 4000 before each task poll.
  codegen_util::cg_emit_line(out, "@__qz_sched_fuel = thread_local global i64 9223372036854775807")
  codegen_util::cg_emit_line(out, "@__qz_poll_sample_ctr = thread_local global i64 0")
  # Weak stub for __qz_sched_reenqueue — async_mutex_unlock references it.
  # Without scheduler, no waiters exist (dead path). Real definition overrides when scheduler active.
  # (stub for __qz_sched_reenqueue emitted conditionally in cg_emit_runtime_decls)
  codegen_util::cg_emit_line(out, "")

  # PRNG state (Phase 1d: xoshiro256**)
  codegen_util::cg_emit_line(out, "@qz_rng_s0 = internal global i64 1234567890123456789")
  codegen_util::cg_emit_line(out, "@qz_rng_s1 = internal global i64 9876543210987654321")
  codegen_util::cg_emit_line(out, "@qz_rng_s2 = internal global i64 3141592653589793238")
  codegen_util::cg_emit_line(out, "@qz_rng_s3 = internal global i64 2718281828459045235")
  codegen_util::cg_emit_line(out, "")
  
  # Format strings
  codegen_util::cg_emit_line(out, "@.fmt.int = private constant [5 x i8] c\"%ld\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@.fmt.int.noln = private constant [4 x i8] c\"%ld\\00\"")
  codegen_util::cg_emit_line(out, "@.fmt.s = private constant [3 x i8] c\"%s\\00\"")
  codegen_util::cg_emit_line(out, "@.fmt.sn = private constant [4 x i8] c\"%s\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@.panic.prefix = private constant [19 x i8] c\"\\1B[1;31mpanic: \\1B[0m\\00\"")
  codegen_util::cg_emit_line(out, "@.newline = private constant [2 x i8] c\"\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@.read_mode = private constant [2 x i8] c\"r\\00\"")
  codegen_util::cg_emit_line(out, "@.write_mode = private constant [2 x i8] c\"w\\00\"")
  codegen_util::cg_emit_line(out, "@.wb_mode = private constant [3 x i8] c\"wb\\00\"")
  codegen_util::cg_emit_line(out, "@.rb_mode = private constant [3 x i8] c\"rb\\00\"")
  codegen_util::cg_emit_line(out, "@.empty_string = private constant <{ i64, [1 x i8] }> <{ i64 0, [1 x i8] c\"\\00\" }>")
  codegen_util::cg_emit_line(out, "@.str.dot = private constant [2 x i8] c\".\\00\"")
  codegen_util::cg_emit_line(out, "")

  # Length-prefixed string helpers
  # qz_alloc_str: allocate length-prefixed string of given byte length
  codegen_util::cg_emit_line(out, "; Length-prefixed string allocator")
  codegen_util::cg_emit_line(out, "define ptr @qz_alloc_str(i64 %len) nounwind {")
  codegen_util::cg_emit_line(out, "  %total = add i64 %len, 9")
  codegen_util::cg_emit_line(out, "  %raw = call ptr @__qz_alloc(i64 %total)")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
  codegen_util::cg_emit_line(out, "  store i64 %len, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %data = getelementptr i8, ptr %raw, i64 8")
  codegen_util::cg_emit_line(out, "  %null_ptr = getelementptr i8, ptr %data, i64 %len")
  codegen_util::cg_emit_line(out, "  store i8 0, ptr %null_ptr")
  codegen_util::cg_emit_line(out, "  ret ptr %data")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_wrap_cstr: wrap a C string into length-prefixed string
  codegen_util::cg_emit_line(out, "; Wrap C string into length-prefixed string")
  codegen_util::cg_emit_line(out, "define ptr @qz_wrap_cstr(ptr %cstr) nounwind {")
  codegen_util::cg_emit_line(out, "  %len = call i64 @strlen(ptr %cstr)")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %cstr, i64 %len)")
  codegen_util::cg_emit_line(out, "  ret ptr %buf")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_get_len: read length from prefix at ptr[-8]
  codegen_util::cg_emit_line(out, "; Read string length from prefix")
  codegen_util::cg_emit_line(out, "define i64 @qz_str_get_len(ptr %str) nounwind {")
  codegen_util::cg_emit_line(out, "  %raw = getelementptr i8, ptr %str, i64 -8")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
  codegen_util::cg_emit_line(out, "  %len = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  ret i64 %len")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_hash: FNV-1a 64-bit hash for length-prefixed strings
  codegen_util::cg_emit_line(out, "; FNV-1a 64-bit string hash")
  codegen_util::cg_emit_line(out, "define i64 @qz_str_hash(ptr %str) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %raw = getelementptr i8, ptr %str, i64 -8")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
  codegen_util::cg_emit_line(out, "  %len = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %body ]")
  codegen_util::cg_emit_line(out, "  %hash = phi i64 [ -3750763034362895579, %entry ], [ %hash.next, %body ]")
  codegen_util::cg_emit_line(out, "  %done = icmp uge i64 %i, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %body")
  codegen_util::cg_emit_line(out, "body:")
  codegen_util::cg_emit_line(out, "  %bp = getelementptr i8, ptr %str, i64 %i")
  codegen_util::cg_emit_line(out, "  %byte = load i8, ptr %bp")
  codegen_util::cg_emit_line(out, "  %b64 = zext i8 %byte to i64")
  codegen_util::cg_emit_line(out, "  %xored = xor i64 %hash, %b64")
  codegen_util::cg_emit_line(out, "  %hash.next = mul i64 %xored, 1099511628211")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  ret i64 %hash")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_str_eq: length-aware string equality — returns 1 if equal, 0 if not.
  # Replaces @strcmp in Map<String, V> bucket comparison so keys
  # containing embedded \x00 bytes don't falsely alias. Reads both
  # length prefixes; fast-rejects on length mismatch; falls through
  # to @memcmp for the byte comparison.
  codegen_util::cg_emit_line(out, "; Length-aware string equality (safe for NUL-containing keys)")
  codegen_util::cg_emit_line(out, "define i64 @qz_str_eq(ptr %a, ptr %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %araw = getelementptr i8, ptr %a, i64 -8")
  codegen_util::cg_emit_line(out, "  %braw = getelementptr i8, ptr %b, i64 -8")
  codegen_util::cg_emit_line(out, "  %alen = load i64, ptr %araw")
  codegen_util::cg_emit_line(out, "  %blen = load i64, ptr %braw")
  codegen_util::cg_emit_line(out, "  %len_eq = icmp eq i64 %alen, %blen")
  codegen_util::cg_emit_line(out, "  br i1 %len_eq, label %cmp, label %neq")
  codegen_util::cg_emit_line(out, "cmp:")
  codegen_util::cg_emit_line(out, "  %zero = icmp eq i64 %alen, 0")
  codegen_util::cg_emit_line(out, "  br i1 %zero, label %eq, label %memcmp_bb")
  codegen_util::cg_emit_line(out, "memcmp_bb:")
  codegen_util::cg_emit_line(out, "  %r = call i32 @memcmp(ptr %a, ptr %b, i64 %alen)")
  codegen_util::cg_emit_line(out, "  %rz = icmp eq i32 %r, 0")
  codegen_util::cg_emit_line(out, "  br i1 %rz, label %eq, label %neq")
  codegen_util::cg_emit_line(out, "eq:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "neq:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # print_int helper function
  codegen_util::cg_emit_line(out, "define void @print_int(i64 %n) nounwind {")
  codegen_util::cg_emit_line(out, "  %fmt = getelementptr [5 x i8], [5 x i8]* @.fmt.int, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i64 (ptr, ...) @printf(ptr %fmt, i64 %n)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # eprint_int helper function (print integer to stderr)
  codegen_util::cg_emit_line(out, "define void @eprint_int(i64 %n) nounwind {")
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %stderr = call ptr @__acrt_iob_func(i32 2)")
  elsif cg_is_linux(target)
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @stderr")
  else
    codegen_util::cg_emit_line(out, "  %stderr = load ptr, ptr @__stderrp")
  end
  codegen_util::cg_emit_line(out, "  %fmt = getelementptr [5 x i8], [5 x i8]* @.fmt.int, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @fprintf(ptr %stderr, ptr %fmt, i64 %n)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Pure-int formatter (no pointer-sniff) — same definition emitted in
  # freestanding mode. sb_append_int and any int-format-only path routes
  # through this instead of @to_str.
  cg_emit_int_to_str_helper(out)

  # to_str: convert value to string (for string interpolation)
  # Runtime type discrimination using alignment invariant:
  # ALL Quartz string data pointers satisfy (ptr & 0xF) == 8 because:
  #   - Heap strings: qz_alloc_str does malloc(len+9) → 16-byte aligned,
  #     returns ptr+8, so data pointer = 16n+8.
  #   - String constants: emitted with `align 16`, data at offset 8,
  #     so data pointer = 16n+8.
  # This check is a single AND+CMP — zero speculative memory access.
  # After alignment passes, we further validate:
  #   - val > 0xFFFF (rejects small integers matching alignment)
  #   - *(val - 8) < 1GB (length prefix is reasonable)
  #   - *(val + len) == 0 (null terminator present)
  codegen_util::cg_emit_line(out, "@.fmt.str = private constant [4 x i8] c\"%ld\\00\"")
  codegen_util::cg_emit_line(out, "define i64 @to_str(i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Check alignment: (val & 0xF) == 8
  codegen_util::cg_emit_line(out, "  %low4 = and i64 %val, 15")
  codegen_util::cg_emit_line(out, "  %is_aligned = icmp eq i64 %low4, 8")
  codegen_util::cg_emit_line(out, "  br i1 %is_aligned, label %check_range, label %int_path")
  # Reject negative values (huge unsigned) and small values (< 64KB)
  codegen_util::cg_emit_line(out, "check_range:")
  codegen_util::cg_emit_line(out, "  %is_negative = icmp slt i64 %val, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_negative, label %int_path, label %check_min")
  codegen_util::cg_emit_line(out, "check_min:")
  codegen_util::cg_emit_line(out, "  %above_min = icmp ugt i64 %val, 65535")
  codegen_util::cg_emit_line(out, "  br i1 %above_min, label %check_str, label %int_path")
  # Now safe to dereference — alignment guarantees this is a plausible pointer
  codegen_util::cg_emit_line(out, "check_str:")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %val to ptr")
  codegen_util::cg_emit_line(out, "  %raw = getelementptr i8, ptr %ptr, i64 -8")
  codegen_util::cg_emit_line(out, "  %hdr = bitcast ptr %raw to ptr")
  codegen_util::cg_emit_line(out, "  %len = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %valid = icmp ult i64 %len, 1073741824")
  codegen_util::cg_emit_line(out, "  br i1 %valid, label %check_null, label %int_path")
  codegen_util::cg_emit_line(out, "check_null:")
  codegen_util::cg_emit_line(out, "  %endp = getelementptr i8, ptr %ptr, i64 %len")
  codegen_util::cg_emit_line(out, "  %endbyte = load i8, ptr %endp")
  codegen_util::cg_emit_line(out, "  %is_null = icmp eq i8 %endbyte, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_null, label %str_path, label %int_path")
  codegen_util::cg_emit_line(out, "str_path:")
  codegen_util::cg_emit_line(out, "  ret i64 %val")
  codegen_util::cg_emit_line(out, "int_path:")
  codegen_util::cg_emit_line(out, "  %tmp = call ptr @__qz_alloc(i64 21)")
  codegen_util::cg_emit_line(out, "  %fmt = getelementptr [4 x i8], [4 x i8]* @.fmt.str, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @sprintf(ptr %tmp, ptr %fmt, i64 %val)")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_wrap_cstr(ptr %tmp)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %tmp)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_concat: concatenate two strings (for string + operator)
  codegen_util::cg_emit_line(out, "define i64 @str_concat(i64 %a, i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr_a = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %ptr_b = inttoptr i64 %b to ptr")
  codegen_util::cg_emit_line(out, "  %len_a = call i64 @qz_str_get_len(ptr %ptr_a)")
  codegen_util::cg_emit_line(out, "  %len_b = call i64 @qz_str_get_len(ptr %ptr_b)")
  codegen_util::cg_emit_line(out, "  %total = add i64 %len_a, %len_b")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %total)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %ptr_a, i64 %len_a)")
  codegen_util::cg_emit_line(out, "  %dst = getelementptr i8, ptr %buf, i64 %len_a")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst, ptr %ptr_b, i64 %len_b)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_starts_with: check if string starts with prefix
  codegen_util::cg_emit_line(out, "declare i32 @strncmp(ptr, ptr, i64)")
  codegen_util::cg_emit_line(out, "define i64 @str_starts_with(i64 %str, i64 %prefix) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr_str = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %ptr_prefix = inttoptr i64 %prefix to ptr")
  codegen_util::cg_emit_line(out, "  %len_prefix = call i64 @qz_str_get_len(ptr %ptr_prefix)")
  codegen_util::cg_emit_line(out, "  %cmp = call i32 @strncmp(ptr %ptr_str, ptr %ptr_prefix, i64 %len_prefix)")
  codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i32 %cmp, 0")
  codegen_util::cg_emit_line(out, "  %result = zext i1 %is_zero to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_ends_with: check if string ends with suffix
  codegen_util::cg_emit_line(out, "define i64 @str_ends_with(i64 %str, i64 %suffix) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr_str = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %ptr_suffix = inttoptr i64 %suffix to ptr")
  codegen_util::cg_emit_line(out, "  %len_str = call i64 @qz_str_get_len(ptr %ptr_str)")
  codegen_util::cg_emit_line(out, "  %len_suffix = call i64 @qz_str_get_len(ptr %ptr_suffix)")
  codegen_util::cg_emit_line(out, "  %too_short = icmp ult i64 %len_str, %len_suffix")
  codegen_util::cg_emit_line(out, "  br i1 %too_short, label %fail, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %offset = sub i64 %len_str, %len_suffix")
  codegen_util::cg_emit_line(out, "  %end_ptr = getelementptr i8, ptr %ptr_str, i64 %offset")
  codegen_util::cg_emit_line(out, "  %cmp = call i32 @strcmp(ptr %end_ptr, ptr %ptr_suffix)")
  codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i32 %cmp, 0")
  codegen_util::cg_emit_line(out, "  %result = zext i1 %is_zero to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "fail:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_downcase: convert string to lowercase
  codegen_util::cg_emit_line(out, "declare i32 @tolower(i32)")
  codegen_util::cg_emit_line(out, "define i64 @str_downcase(i64 %str) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %0 ], [ %next, %loop ]")
  codegen_util::cg_emit_line(out, "  %src.ptr = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %dst.ptr = getelementptr i8, ptr %buf, i64 %i")
  codegen_util::cg_emit_line(out, "  %c = load i8, ptr %src.ptr")
  codegen_util::cg_emit_line(out, "  %c.i32 = zext i8 %c to i32")
  codegen_util::cg_emit_line(out, "  %lower = call i32 @tolower(i32 %c.i32)")
  codegen_util::cg_emit_line(out, "  %lower.i8 = trunc i32 %lower to i8")
  codegen_util::cg_emit_line(out, "  store i8 %lower.i8, ptr %dst.ptr")
  codegen_util::cg_emit_line(out, "  %next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %done = icmp ugt i64 %next, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_upcase: convert string to uppercase
  codegen_util::cg_emit_line(out, "declare i32 @toupper(i32)")
  codegen_util::cg_emit_line(out, "define i64 @str_upcase(i64 %str) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %0 ], [ %next, %loop ]")
  codegen_util::cg_emit_line(out, "  %src.ptr = getelementptr i8, ptr %ptr, i64 %i")
  codegen_util::cg_emit_line(out, "  %dst.ptr = getelementptr i8, ptr %buf, i64 %i")
  codegen_util::cg_emit_line(out, "  %c = load i8, ptr %src.ptr")
  codegen_util::cg_emit_line(out, "  %c.i32 = zext i8 %c to i32")
  codegen_util::cg_emit_line(out, "  %upper = call i32 @toupper(i32 %c.i32)")
  codegen_util::cg_emit_line(out, "  %upper.i8 = trunc i32 %upper to i8")
  codegen_util::cg_emit_line(out, "  store i8 %upper.i8, ptr %dst.ptr")
  codegen_util::cg_emit_line(out, "  %next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %done = icmp ugt i64 %next, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %loop")
  codegen_util::cg_emit_line(out, "exit:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_trim: trim whitespace from both ends
  codegen_util::cg_emit_line(out, "declare i32 @isspace(i32)")
  codegen_util::cg_emit_line(out, "define i64 @str_trim(i64 %str) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %len = call i64 @qz_str_get_len(ptr %ptr)")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i64 %len, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %ret.empty, label %find.start")
  codegen_util::cg_emit_line(out, "find.start:")
  codegen_util::cg_emit_line(out, "  %start = phi i64 [ 0, %0 ], [ %start.next, %find.start ]")
  codegen_util::cg_emit_line(out, "  %start.ptr = getelementptr i8, ptr %ptr, i64 %start")
  codegen_util::cg_emit_line(out, "  %start.c = load i8, ptr %start.ptr")
  codegen_util::cg_emit_line(out, "  %start.c32 = zext i8 %start.c to i32")
  codegen_util::cg_emit_line(out, "  %start.is.space = call i32 @isspace(i32 %start.c32)")
  codegen_util::cg_emit_line(out, "  %start.next = add i64 %start, 1")
  codegen_util::cg_emit_line(out, "  %start.cont = icmp ne i32 %start.is.space, 0")
  codegen_util::cg_emit_line(out, "  %start.inbounds = icmp ult i64 %start.next, %len")
  codegen_util::cg_emit_line(out, "  %start.loop = and i1 %start.cont, %start.inbounds")
  codegen_util::cg_emit_line(out, "  br i1 %start.loop, label %find.start, label %find.end.init")
  codegen_util::cg_emit_line(out, "find.end.init:")
  codegen_util::cg_emit_line(out, "  %end.init = sub i64 %len, 1")
  codegen_util::cg_emit_line(out, "  br label %find.end")
  codegen_util::cg_emit_line(out, "find.end:")
  codegen_util::cg_emit_line(out, "  %end = phi i64 [ %end.init, %find.end.init ], [ %end.prev, %find.end ]")
  codegen_util::cg_emit_line(out, "  %end.ptr = getelementptr i8, ptr %ptr, i64 %end")
  codegen_util::cg_emit_line(out, "  %end.c = load i8, ptr %end.ptr")
  codegen_util::cg_emit_line(out, "  %end.c32 = zext i8 %end.c to i32")
  codegen_util::cg_emit_line(out, "  %end.is.space = call i32 @isspace(i32 %end.c32)")
  codegen_util::cg_emit_line(out, "  %end.prev = sub i64 %end, 1")
  codegen_util::cg_emit_line(out, "  %end.cont = icmp ne i32 %end.is.space, 0")
  codegen_util::cg_emit_line(out, "  %end.inbounds = icmp ugt i64 %end, %start")
  codegen_util::cg_emit_line(out, "  %end.loop = and i1 %end.cont, %end.inbounds")
  codegen_util::cg_emit_line(out, "  br i1 %end.loop, label %find.end, label %copy")
  codegen_util::cg_emit_line(out, "copy:")
  codegen_util::cg_emit_line(out, "  %new.len = sub i64 %end, %start")
  codegen_util::cg_emit_line(out, "  %new.len.1 = add i64 %new.len, 1")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %new.len.1)")
  codegen_util::cg_emit_line(out, "  %src = getelementptr i8, ptr %ptr, i64 %start")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf, ptr %src, i64 %new.len.1)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "ret.empty:")
  codegen_util::cg_emit_line(out, "  %empty.buf = call ptr @qz_alloc_str(i64 0)")
  codegen_util::cg_emit_line(out, "  %empty.result = ptrtoint ptr %empty.buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %empty.result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # str_replace: replace ALL occurrences of 'from' with 'to'
  # Two-pass: count occurrences, allocate exact buffer, build result
  codegen_util::cg_emit_line(out, "define i64 @str_replace(i64 %str, i64 %from, i64 %to) nounwind {")
  codegen_util::cg_emit_line(out, "  %ptr.str = inttoptr i64 %str to ptr")
  codegen_util::cg_emit_line(out, "  %ptr.from = inttoptr i64 %from to ptr")
  codegen_util::cg_emit_line(out, "  %ptr.to = inttoptr i64 %to to ptr")
  codegen_util::cg_emit_line(out, "  %len.str = call i64 @qz_str_get_len(ptr %ptr.str)")
  codegen_util::cg_emit_line(out, "  %len.from = call i64 @qz_str_get_len(ptr %ptr.from)")
  codegen_util::cg_emit_line(out, "  %len.to = call i64 @qz_str_get_len(ptr %ptr.to)")
  codegen_util::cg_emit_line(out, "  %from.empty = icmp eq i64 %len.from, 0")
  codegen_util::cg_emit_line(out, "  br i1 %from.empty, label %ret.copy, label %count.start")
  # Pass 1: count occurrences
  codegen_util::cg_emit_line(out, "count.start:")
  codegen_util::cg_emit_line(out, "  br label %count.loop")
  codegen_util::cg_emit_line(out, "count.loop:")
  codegen_util::cg_emit_line(out, "  %cc = phi ptr [%ptr.str, %count.start], [%cc.next, %count.hit]")
  codegen_util::cg_emit_line(out, "  %cn = phi i64 [0, %count.start], [%cn.inc, %count.hit]")
  codegen_util::cg_emit_line(out, "  %cf = call ptr @strstr(ptr %cc, ptr %ptr.from)")
  codegen_util::cg_emit_line(out, "  %cf.null = icmp eq ptr %cf, null")
  codegen_util::cg_emit_line(out, "  br i1 %cf.null, label %count.done, label %count.hit")
  codegen_util::cg_emit_line(out, "count.hit:")
  codegen_util::cg_emit_line(out, "  %cn.inc = add i64 %cn, 1")
  codegen_util::cg_emit_line(out, "  %cc.next = getelementptr i8, ptr %cf, i64 %len.from")
  codegen_util::cg_emit_line(out, "  br label %count.loop")
  codegen_util::cg_emit_line(out, "count.done:")
  codegen_util::cg_emit_line(out, "  %no.match = icmp eq i64 %cn, 0")
  codegen_util::cg_emit_line(out, "  br i1 %no.match, label %ret.copy, label %alloc")
  # Allocate exact buffer
  codegen_util::cg_emit_line(out, "alloc:")
  codegen_util::cg_emit_line(out, "  %rm = mul i64 %cn, %len.from")
  codegen_util::cg_emit_line(out, "  %ad = mul i64 %cn, %len.to")
  codegen_util::cg_emit_line(out, "  %t1 = sub i64 %len.str, %rm")
  codegen_util::cg_emit_line(out, "  %t2 = add i64 %t1, %ad")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %t2)")
  codegen_util::cg_emit_line(out, "  br label %build.loop")
  # Pass 2: build result
  codegen_util::cg_emit_line(out, "build.loop:")
  codegen_util::cg_emit_line(out, "  %bc = phi ptr [%ptr.str, %alloc], [%bc.next, %build.hit]")
  codegen_util::cg_emit_line(out, "  %bo = phi ptr [%buf, %alloc], [%bo.next, %build.hit]")
  codegen_util::cg_emit_line(out, "  %bf = call ptr @strstr(ptr %bc, ptr %ptr.from)")
  codegen_util::cg_emit_line(out, "  %bf.null = icmp eq ptr %bf, null")
  codegen_util::cg_emit_line(out, "  br i1 %bf.null, label %build.fin, label %build.hit")
  codegen_util::cg_emit_line(out, "build.hit:")
  codegen_util::cg_emit_line(out, "  %bc.i = ptrtoint ptr %bc to i64")
  codegen_util::cg_emit_line(out, "  %bf.i = ptrtoint ptr %bf to i64")
  codegen_util::cg_emit_line(out, "  %plen = sub i64 %bf.i, %bc.i")
  codegen_util::cg_emit_line(out, "  call ptr @strncpy(ptr %bo, ptr %bc, i64 %plen)")
  codegen_util::cg_emit_line(out, "  %bo.1 = getelementptr i8, ptr %bo, i64 %plen")
  codegen_util::cg_emit_line(out, "  call ptr @strncpy(ptr %bo.1, ptr %ptr.to, i64 %len.to)")
  codegen_util::cg_emit_line(out, "  %bo.next = getelementptr i8, ptr %bo.1, i64 %len.to")
  codegen_util::cg_emit_line(out, "  %bc.next = getelementptr i8, ptr %bf, i64 %len.from")
  codegen_util::cg_emit_line(out, "  br label %build.loop")
  codegen_util::cg_emit_line(out, "build.fin:")
  codegen_util::cg_emit_line(out, "  call ptr @strcpy(ptr %bo, ptr %bc)")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  # Return copy of original (no match or empty from)
  codegen_util::cg_emit_line(out, "ret.copy:")
  codegen_util::cg_emit_line(out, "  %cpbuf = call ptr @qz_alloc_str(i64 %len.str)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %cpbuf, ptr %ptr.str, i64 %len.str)")
  codegen_util::cg_emit_line(out, "  %cpres = ptrtoint ptr %cpbuf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %cpres")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Continued in cg_emit_runtime_helpers_2 to avoid MIR block instruction limit
  cg_emit_runtime_helpers_2(out, target)
end

## Emit Phase 1c/1d/1f runtime helper functions (continuation of cg_emit_runtime_decls)
def cg_emit_runtime_helpers_2(out: Int, target: String): Void
  # Phase 1c: str_reverse — reverse a string
  codegen_util::cg_emit_line(out, "define i64 @qz_str_reverse(i64 %s) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %src = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %len = call i64 @qz_str_get_len(ptr %src)")
  codegen_util::cg_emit_line(out, "  %dst = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  %is_empty = icmp eq i64 %len, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_empty, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %loop]")
  codegen_util::cg_emit_line(out, "  %ri = sub i64 %len, %i")
  codegen_util::cg_emit_line(out, "  %ri1 = sub i64 %ri, 1")
  codegen_util::cg_emit_line(out, "  %src.p = getelementptr i8, ptr %src, i64 %ri1")
  codegen_util::cg_emit_line(out, "  %ch = load i8, ptr %src.p")
  codegen_util::cg_emit_line(out, "  %dst.p = getelementptr i8, ptr %dst, i64 %i")
  codegen_util::cg_emit_line(out, "  store i8 %ch, ptr %dst.p")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %done.check = icmp uge i64 %i.next, %len")
  codegen_util::cg_emit_line(out, "  br i1 %done.check, label %done, label %loop")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %dst to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1c: str_repeat — repeat a string n times
  codegen_util::cg_emit_line(out, "define i64 @qz_str_repeat(i64 %s, i64 %n) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %src = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %slen = call i64 @qz_str_get_len(ptr %src)")
  codegen_util::cg_emit_line(out, "  %total = mul i64 %slen, %n")
  codegen_util::cg_emit_line(out, "  %dst = call ptr @qz_alloc_str(i64 %total)")
  codegen_util::cg_emit_line(out, "  %is_zero = icmp sle i64 %n, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_zero, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %loop]")
  codegen_util::cg_emit_line(out, "  %offset = mul i64 %i, %slen")
  codegen_util::cg_emit_line(out, "  %dst.p = getelementptr i8, ptr %dst, i64 %offset")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst.p, ptr %src, i64 %slen)")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %done.check = icmp uge i64 %i.next, %n")
  codegen_util::cg_emit_line(out, "  br i1 %done.check, label %done, label %loop")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %dst to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1c: str_count — count non-overlapping occurrences of needle in haystack
  codegen_util::cg_emit_line(out, "define i64 @qz_str_count(i64 %s, i64 %needle) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %src = inttoptr i64 %s to ptr")
  codegen_util::cg_emit_line(out, "  %ndl = inttoptr i64 %needle to ptr")
  codegen_util::cg_emit_line(out, "  %ndl_len = call i64 @qz_str_get_len(ptr %ndl)")
  codegen_util::cg_emit_line(out, "  %ndl_empty = icmp eq i64 %ndl_len, 0")
  codegen_util::cg_emit_line(out, "  br i1 %ndl_empty, label %ret_zero, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %pos = phi ptr [%src, %entry], [%pos.next, %found]")
  codegen_util::cg_emit_line(out, "  %count = phi i64 [0, %entry], [%count.next, %found]")
  codegen_util::cg_emit_line(out, "  %match = call ptr @strstr(ptr %pos, ptr %ndl)")
  codegen_util::cg_emit_line(out, "  %not_found = icmp eq ptr %match, null")
  codegen_util::cg_emit_line(out, "  br i1 %not_found, label %ret_count, label %found")
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  %count.next = add i64 %count, 1")
  codegen_util::cg_emit_line(out, "  %pos.next = getelementptr i8, ptr %match, i64 %ndl_len")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "ret_count:")
  codegen_util::cg_emit_line(out, "  ret i64 %count")
  codegen_util::cg_emit_line(out, "ret_zero:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1d: xoshiro256** PRNG — qz_rand_seed (splitmix64 to fill state)
  codegen_util::cg_emit_line(out, "define void @qz_rand_seed(i64 %seed) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # splitmix64 step 1
  codegen_util::cg_emit_line(out, "  %z0 = add i64 %seed, 7640891576956012809")
  codegen_util::cg_emit_line(out, "  %z0a = lshr i64 %z0, 30")
  codegen_util::cg_emit_line(out, "  %z0b = xor i64 %z0, %z0a")
  codegen_util::cg_emit_line(out, "  %z0c = mul i64 %z0b, -4658895280553007687")
  codegen_util::cg_emit_line(out, "  %z0d = lshr i64 %z0c, 27")
  codegen_util::cg_emit_line(out, "  %z0e = xor i64 %z0c, %z0d")
  codegen_util::cg_emit_line(out, "  %z0f = mul i64 %z0e, -7723592293110705685")
  codegen_util::cg_emit_line(out, "  %z0g = lshr i64 %z0f, 31")
  codegen_util::cg_emit_line(out, "  %s0 = xor i64 %z0f, %z0g")
  codegen_util::cg_emit_line(out, "  store i64 %s0, ptr @qz_rng_s0")
  # splitmix64 step 2
  codegen_util::cg_emit_line(out, "  %z1 = add i64 %z0, 7640891576956012809")
  codegen_util::cg_emit_line(out, "  %z1a = lshr i64 %z1, 30")
  codegen_util::cg_emit_line(out, "  %z1b = xor i64 %z1, %z1a")
  codegen_util::cg_emit_line(out, "  %z1c = mul i64 %z1b, -4658895280553007687")
  codegen_util::cg_emit_line(out, "  %z1d = lshr i64 %z1c, 27")
  codegen_util::cg_emit_line(out, "  %z1e = xor i64 %z1c, %z1d")
  codegen_util::cg_emit_line(out, "  %z1f = mul i64 %z1e, -7723592293110705685")
  codegen_util::cg_emit_line(out, "  %z1g = lshr i64 %z1f, 31")
  codegen_util::cg_emit_line(out, "  %s1 = xor i64 %z1f, %z1g")
  codegen_util::cg_emit_line(out, "  store i64 %s1, ptr @qz_rng_s1")
  # splitmix64 step 3
  codegen_util::cg_emit_line(out, "  %z2 = add i64 %z1, 7640891576956012809")
  codegen_util::cg_emit_line(out, "  %z2a = lshr i64 %z2, 30")
  codegen_util::cg_emit_line(out, "  %z2b = xor i64 %z2, %z2a")
  codegen_util::cg_emit_line(out, "  %z2c = mul i64 %z2b, -4658895280553007687")
  codegen_util::cg_emit_line(out, "  %z2d = lshr i64 %z2c, 27")
  codegen_util::cg_emit_line(out, "  %z2e = xor i64 %z2c, %z2d")
  codegen_util::cg_emit_line(out, "  %z2f = mul i64 %z2e, -7723592293110705685")
  codegen_util::cg_emit_line(out, "  %z2g = lshr i64 %z2f, 31")
  codegen_util::cg_emit_line(out, "  %s2 = xor i64 %z2f, %z2g")
  codegen_util::cg_emit_line(out, "  store i64 %s2, ptr @qz_rng_s2")
  # splitmix64 step 4
  codegen_util::cg_emit_line(out, "  %z3 = add i64 %z2, 7640891576956012809")
  codegen_util::cg_emit_line(out, "  %z3a = lshr i64 %z3, 30")
  codegen_util::cg_emit_line(out, "  %z3b = xor i64 %z3, %z3a")
  codegen_util::cg_emit_line(out, "  %z3c = mul i64 %z3b, -4658895280553007687")
  codegen_util::cg_emit_line(out, "  %z3d = lshr i64 %z3c, 27")
  codegen_util::cg_emit_line(out, "  %z3e = xor i64 %z3c, %z3d")
  codegen_util::cg_emit_line(out, "  %z3f = mul i64 %z3e, -7723592293110705685")
  codegen_util::cg_emit_line(out, "  %z3g = lshr i64 %z3f, 31")
  codegen_util::cg_emit_line(out, "  %s3 = xor i64 %z3f, %z3g")
  codegen_util::cg_emit_line(out, "  store i64 %s3, ptr @qz_rng_s3")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1d: qz_rand_int — xoshiro256** next
  codegen_util::cg_emit_line(out, "define i64 @qz_rand_int() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %s0 = load i64, ptr @qz_rng_s0")
  codegen_util::cg_emit_line(out, "  %s1 = load i64, ptr @qz_rng_s1")
  codegen_util::cg_emit_line(out, "  %s2 = load i64, ptr @qz_rng_s2")
  codegen_util::cg_emit_line(out, "  %s3 = load i64, ptr @qz_rng_s3")
  # result = rotl(s1 * 5, 7) * 9
  codegen_util::cg_emit_line(out, "  %s1x5 = mul i64 %s1, 5")
  codegen_util::cg_emit_line(out, "  %shl7 = shl i64 %s1x5, 7")
  codegen_util::cg_emit_line(out, "  %shr57 = lshr i64 %s1x5, 57")
  codegen_util::cg_emit_line(out, "  %rotl = or i64 %shl7, %shr57")
  codegen_util::cg_emit_line(out, "  %result = mul i64 %rotl, 9")
  # t = s1 << 17
  codegen_util::cg_emit_line(out, "  %t = shl i64 %s1, 17")
  # s2 ^= s0
  codegen_util::cg_emit_line(out, "  %s2a = xor i64 %s2, %s0")
  # s3 ^= s1
  codegen_util::cg_emit_line(out, "  %s3a = xor i64 %s3, %s1")
  # s1 ^= s2
  codegen_util::cg_emit_line(out, "  %s1a = xor i64 %s1, %s2a")
  # s0 ^= s3
  codegen_util::cg_emit_line(out, "  %s0a = xor i64 %s0, %s3a")
  # s2 ^= t
  codegen_util::cg_emit_line(out, "  %s2b = xor i64 %s2a, %t")
  # s3 = rotl(s3, 45)
  codegen_util::cg_emit_line(out, "  %s3shl = shl i64 %s3a, 45")
  codegen_util::cg_emit_line(out, "  %s3shr = lshr i64 %s3a, 19")
  codegen_util::cg_emit_line(out, "  %s3b = or i64 %s3shl, %s3shr")
  # store back
  codegen_util::cg_emit_line(out, "  store i64 %s0a, ptr @qz_rng_s0")
  codegen_util::cg_emit_line(out, "  store i64 %s1a, ptr @qz_rng_s1")
  codegen_util::cg_emit_line(out, "  store i64 %s2b, ptr @qz_rng_s2")
  codegen_util::cg_emit_line(out, "  store i64 %s3b, ptr @qz_rng_s3")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1d: qz_rand_range — lo + (rand_int() urem (hi - lo))
  codegen_util::cg_emit_line(out, "define i64 @qz_rand_range(i64 %lo, i64 %hi) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %span = sub i64 %hi, %lo")
  codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i64 %span, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_zero, label %ret_lo, label %do_rand")
  codegen_util::cg_emit_line(out, "do_rand:")
  codegen_util::cg_emit_line(out, "  %r = call i64 @qz_rand_int()")
  codegen_util::cg_emit_line(out, "  %rem = urem i64 %r, %span")
  codegen_util::cg_emit_line(out, "  %result = add i64 %lo, %rem")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "ret_lo:")
  codegen_util::cg_emit_line(out, "  ret i64 %lo")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1d: qz_rand_float — mask to 53 bits, convert to double in [0,1)
  codegen_util::cg_emit_line(out, "define double @qz_rand_float() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %r = call i64 @qz_rand_int()")
  codegen_util::cg_emit_line(out, "  %masked = lshr i64 %r, 11")
  codegen_util::cg_emit_line(out, "  %d = uitofp i64 %masked to double")
  codegen_util::cg_emit_line(out, "  %scale = fdiv double 1.0, 9007199254740992.0")
  codegen_util::cg_emit_line(out, "  %result = fmul double %d, %scale")
  codegen_util::cg_emit_line(out, "  ret double %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 1e: crypto-secure random
  # macOS: arc4random_buf, Linux: getrandom syscall wrapper, Windows:
  # BCryptGenRandom from bcrypt.dll. BCRYPT_USE_SYSTEM_PREFERRED_RNG (flag = 2)
  # routes through the kernel-mode CNG provider — no algorithm-handle setup
  # required. Returns NTSTATUS; 0 == STATUS_SUCCESS. We trap on non-success so
  # a quietly-broken crypto layer surfaces loudly rather than degrading to a
  # zeroed buffer. Adds `-lbcrypt` to the Windows link (handled by the
  # Quakefile / examples/hyperbouba Makefile Windows branches).
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "declare i32 @BCryptGenRandom(ptr, ptr, i32, i32) nounwind")
    codegen_util::cg_emit_line(out, "define i64 @qz_crypto_rand_int() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %buf = alloca i64")
    codegen_util::cg_emit_line(out, "  %ptr = bitcast ptr %buf to ptr")
    # BCryptGenRandom(NULL, &buf, 8, BCRYPT_USE_SYSTEM_PREFERRED_RNG=2)
    codegen_util::cg_emit_line(out, "  %st = call i32 @BCryptGenRandom(ptr null, ptr %ptr, i32 8, i32 2)")
    codegen_util::cg_emit_line(out, "  %ok = icmp eq i32 %st, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ok, label %good, label %bad")
    codegen_util::cg_emit_line(out, "good:")
    codegen_util::cg_emit_line(out, "  %val = load i64, ptr %buf, align 8")
    codegen_util::cg_emit_line(out, "  ret i64 %val")
    codegen_util::cg_emit_line(out, "bad:")
    codegen_util::cg_emit_line(out, "  call void @abort()")
    codegen_util::cg_emit_line(out, "  unreachable")
    codegen_util::cg_emit_line(out, "}")
  elsif cg_is_linux(target)
    codegen_util::cg_emit_line(out, "declare i64 @getrandom(ptr, i64, i32)")
    codegen_util::cg_emit_line(out, "define i64 @qz_crypto_rand_int() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %buf = alloca i64")
    codegen_util::cg_emit_line(out, "  %ptr = bitcast ptr %buf to ptr")
    codegen_util::cg_emit_line(out, "  %n = call i64 @getrandom(ptr %ptr, i64 8, i32 0)")
    codegen_util::cg_emit_line(out, "  %val = load i64, ptr %buf, align 8")
    codegen_util::cg_emit_line(out, "  ret i64 %val")
    codegen_util::cg_emit_line(out, "}")
  else
    codegen_util::cg_emit_line(out, "declare void @arc4random_buf(ptr, i64)")
    codegen_util::cg_emit_line(out, "define i64 @qz_crypto_rand_int() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %buf = alloca i64")
    codegen_util::cg_emit_line(out, "  %ptr = bitcast ptr %buf to ptr")
    codegen_util::cg_emit_line(out, "  call void @arc4random_buf(ptr %ptr, i64 8)")
    codegen_util::cg_emit_line(out, "  %val = load i64, ptr %buf, align 8")
    codegen_util::cg_emit_line(out, "  ret i64 %val")
    codegen_util::cg_emit_line(out, "}")
  end
  codegen_util::cg_emit_line(out, "")

  # Phase 1f / R3.4: set algebra runtime helpers.
  #
  # A Set is now backed by the intmap (int-keyed open-addressing hash table,
  # cg_intrinsic_intmap.qz): header [cap, size, keys_ptr, vals_ptr, used_ptr];
  # keys/vals are i64[cap]; used is a byte[cap] occupancy bitmap (1 = present).
  # The element is stored as the KEY. These helpers iterate / insert against
  # that layout (the old flat-array layout is gone). Inserts use open
  # addressing with linear probing (hash = key urem cap); the algebra ops
  # below pre-size each result set so qz_set_add_helper never needs to resize
  # (load factor stays <= 50%, so probing always terminates).

  # qz_set_new_sized: allocate an empty intmap-backed set with the given
  # capacity (used by union/intersection/difference to pre-size the result).
  codegen_util::cg_emit_line(out, "define i64 @qz_set_new_sized(i64 %cap) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = call ptr @__qz_alloc(i64 40)")
  codegen_util::cg_emit_line(out, "  store i64 %cap, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %kbytes = mul i64 %cap, 8")
  codegen_util::cg_emit_line(out, "  %keys = call ptr @__qz_alloc(i64 %kbytes)")
  codegen_util::cg_emit_line(out, "  %keys.i = ptrtoint ptr %keys to i64")
  codegen_util::cg_emit_line(out, "  %keys.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 %keys.i, ptr %keys.ptr")
  codegen_util::cg_emit_line(out, "  %vals = call ptr @__qz_alloc(i64 %kbytes)")
  codegen_util::cg_emit_line(out, "  %vals.i = ptrtoint ptr %vals to i64")
  codegen_util::cg_emit_line(out, "  %vals.ptr = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %vals.i, ptr %vals.ptr")
  codegen_util::cg_emit_line(out, "  %used = call ptr @__qz_alloc(i64 %cap)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %used, i32 0, i64 %cap)")
  codegen_util::cg_emit_line(out, "  %used.i = ptrtoint ptr %used to i64")
  codegen_util::cg_emit_line(out, "  %used.ptr = getelementptr i64, ptr %hdr, i64 4")
  codegen_util::cg_emit_line(out, "  store i64 %used.i, ptr %used.ptr")
  codegen_util::cg_emit_line(out, "  %r = ptrtoint ptr %hdr to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %r")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_set_add_helper: insert %val (as key) into the intmap-backed set, no-op
  # if already present. Open-addressing linear probe; assumes spare capacity
  # (callers pre-size). Does NOT resize.
  codegen_util::cg_emit_line(out, "define void @qz_set_add_helper(i64 %set, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %set to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %keys.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys.i = load i64, ptr %keys.ptr")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys.i to ptr")
  codegen_util::cg_emit_line(out, "  %used.ptr = getelementptr i64, ptr %hdr, i64 4")
  codegen_util::cg_emit_line(out, "  %used.i = load i64, ptr %used.ptr")
  codegen_util::cg_emit_line(out, "  %used = inttoptr i64 %used.i to ptr")
  codegen_util::cg_emit_line(out, "  %hash = urem i64 %val, %cap")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [%hash, %entry], [%i.next, %cont]")
  codegen_util::cg_emit_line(out, "  %u.ptr = getelementptr i8, ptr %used, i64 %i")
  codegen_util::cg_emit_line(out, "  %u = load i8, ptr %u.ptr")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i8 %u, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %store, label %cmp")
  codegen_util::cg_emit_line(out, "cmp:")
  codegen_util::cg_emit_line(out, "  %k.ptr = getelementptr i64, ptr %keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr %k.ptr")
  codegen_util::cg_emit_line(out, "  %eq = icmp eq i64 %k, %val")
  codegen_util::cg_emit_line(out, "  br i1 %eq, label %ret, label %cont")
  codegen_util::cg_emit_line(out, "store:")
  codegen_util::cg_emit_line(out, "  %sk.ptr = getelementptr i64, ptr %keys, i64 %i")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %sk.ptr")
  codegen_util::cg_emit_line(out, "  store i8 1, ptr %u.ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %newsize = add i64 %size, 1")
  codegen_util::cg_emit_line(out, "  store i64 %newsize, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  br label %ret")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.raw = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i.next = urem i64 %i.raw, %cap")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_set_has_helper: 1 if %val is present in the intmap-backed set, else 0.
  # Open-addressing probe; stops at the first empty slot or after a full cycle.
  codegen_util::cg_emit_line(out, "define i64 @qz_set_has_helper(i64 %set, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %set to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %keys.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys.i = load i64, ptr %keys.ptr")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys.i to ptr")
  codegen_util::cg_emit_line(out, "  %used.ptr = getelementptr i64, ptr %hdr, i64 4")
  codegen_util::cg_emit_line(out, "  %used.i = load i64, ptr %used.ptr")
  codegen_util::cg_emit_line(out, "  %used = inttoptr i64 %used.i to ptr")
  codegen_util::cg_emit_line(out, "  %hash = urem i64 %val, %cap")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [%hash, %entry], [%i.next, %cont]")
  codegen_util::cg_emit_line(out, "  %cnt = phi i64 [0, %entry], [%cnt.inc, %cont]")
  codegen_util::cg_emit_line(out, "  %maxed = icmp sge i64 %cnt, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %maxed, label %not_found, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %u.ptr = getelementptr i8, ptr %used, i64 %i")
  codegen_util::cg_emit_line(out, "  %u = load i8, ptr %u.ptr")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i8 %u, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %not_found, label %cmp")
  codegen_util::cg_emit_line(out, "cmp:")
  codegen_util::cg_emit_line(out, "  %k.ptr = getelementptr i64, ptr %keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr %k.ptr")
  codegen_util::cg_emit_line(out, "  %eq = icmp eq i64 %k, %val")
  codegen_util::cg_emit_line(out, "  br i1 %eq, label %found, label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.raw = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %i.next = urem i64 %i.raw, %cap")
  codegen_util::cg_emit_line(out, "  %cnt.inc = add i64 %cnt, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "not_found:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_set_union: new set with all elements from both a and b.
  # Pre-size to 2*(a.cap+b.cap) so qz_set_add_helper never resizes.
  codegen_util::cg_emit_line(out, "define i64 @qz_set_union(i64 %a, i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %a.hdr = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.ptr = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.ptr")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  %a.used.ptr = getelementptr i64, ptr %a.hdr, i64 4")
  codegen_util::cg_emit_line(out, "  %a.used.i = load i64, ptr %a.used.ptr")
  codegen_util::cg_emit_line(out, "  %a.used = inttoptr i64 %a.used.i to ptr")
  codegen_util::cg_emit_line(out, "  %b.hdr = inttoptr i64 %b to ptr")
  codegen_util::cg_emit_line(out, "  %b.cap = load i64, ptr %b.hdr")
  codegen_util::cg_emit_line(out, "  %b.keys.ptr = getelementptr i64, ptr %b.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %b.keys.i = load i64, ptr %b.keys.ptr")
  codegen_util::cg_emit_line(out, "  %b.keys = inttoptr i64 %b.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  %b.used.ptr = getelementptr i64, ptr %b.hdr, i64 4")
  codegen_util::cg_emit_line(out, "  %b.used.i = load i64, ptr %b.used.ptr")
  codegen_util::cg_emit_line(out, "  %b.used = inttoptr i64 %b.used.i to ptr")
  codegen_util::cg_emit_line(out, "  %sum = add i64 %a.cap, %b.cap")
  codegen_util::cg_emit_line(out, "  %newcap = mul i64 %sum, 2")
  codegen_util::cg_emit_line(out, "  %new.set = call i64 @qz_set_new_sized(i64 %newcap)")
  codegen_util::cg_emit_line(out, "  br label %loop_a")
  codegen_util::cg_emit_line(out, "loop_a:")
  codegen_util::cg_emit_line(out, "  %ia = phi i64 [0, %entry], [%ia.next, %cont_a]")
  codegen_util::cg_emit_line(out, "  %ia.done = icmp sge i64 %ia, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %ia.done, label %loop_b, label %check_a")
  codegen_util::cg_emit_line(out, "check_a:")
  codegen_util::cg_emit_line(out, "  %a.u.ptr = getelementptr i8, ptr %a.used, i64 %ia")
  codegen_util::cg_emit_line(out, "  %a.u = load i8, ptr %a.u.ptr")
  codegen_util::cg_emit_line(out, "  %a.occ = icmp ne i8 %a.u, 0")
  codegen_util::cg_emit_line(out, "  br i1 %a.occ, label %add_a, label %cont_a")
  codegen_util::cg_emit_line(out, "add_a:")
