    # task, we won the race vs. the poller and own the re-enqueue. If old
    # == 0, the poller already cleared the slot and is re-enqueueing —
    # fall through to CAS as no-op.
    codegen_util::cg_emit_line(out, "  %wk.map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
    codegen_util::cg_emit_line(out, "  %wk.map.i = load i64, ptr %wk.map.p")
    codegen_util::cg_emit_line(out, "  %wk.map.base = inttoptr i64 %wk.map.i to ptr")
    codegen_util::cg_emit_line(out, "  %wk.map.slot = getelementptr i64, ptr %wk.map.base, i64 %wk.ident")
    codegen_util::cg_emit_line(out, "  %wk.old_task = atomicrmw xchg ptr %wk.map.slot, i64 0 acq_rel")
    codegen_util::cg_emit_line(out, "  %wk.won = icmp eq i64 %wk.old_task, %task")
    codegen_util::cg_emit_line(out, "  br i1 %wk.won, label %wk_timer_cancel, label %wk_retry")
  end
  codegen_util::cg_emit_line(out, "wk_timer_cancel:")
