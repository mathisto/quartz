    codegen_util::cg_emit_line(out, "  %io.pr.i64 = load i64, ptr %io.pr.p")
    codegen_util::cg_emit_line(out, "  %io.pr.i32 = trunc i64 %io.pr.i64 to i32")
    codegen_util::cg_emit_line(out, "  call i32 @close(i32 %io.pr.i32)")
