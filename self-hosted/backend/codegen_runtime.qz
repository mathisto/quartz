  codegen_util::cg_emit_line(out, "define void @__qz_task_registry_mark_done(i64 %trd.tid) nounwind {")
  codegen_util::cg_emit_line(out, "trd_entry:")
  codegen_util::cg_emit_line(out, "  %trd.mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 3")
