  codegen_util::cg_emit_line(out, "  %tl.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %tl.mtx.i, ptr %tl.mtx.ptr")
  # Initialize task registry: 65536 quads * 4 slots * 8 bytes = 2097152 bytes
  codegen_util::cg_emit_line(out, "  %tr.arr = call ptr @__qz_alloc(i64 2097152)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tr.arr, i32 0, i64 2097152)")
  codegen_util::cg_emit_line(out, "  %tr.arr.i = ptrtoint ptr %tr.arr to i64")
  codegen_util::cg_emit_line(out, "  %tr.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %tr.arr.i, ptr %tr.arr.ptr")
  # capacity = 65536
  codegen_util::cg_emit_line(out, "  %tr.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 65536, ptr %tr.cap.ptr")
  # Allocate and init task registry mutex
  codegen_util::cg_emit_line(out, "  %tr.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tr.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %tr.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %tr.mtx.i = ptrtoint ptr %tr.mtx to i64")
  codegen_util::cg_emit_line(out, "  %tr.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %tr.mtx.i, ptr %tr.mtx.ptr")
  # E.1.c.b: init task-snapshot side-table — 256 pairs = 512 i64 = 4096 bytes
  codegen_util::cg_emit_line(out, "  %tsn.arr = call ptr @__qz_alloc(i64 4096)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tsn.arr, i32 0, i64 4096)")
  codegen_util::cg_emit_line(out, "  %tsn.arr.i = ptrtoint ptr %tsn.arr to i64")
  codegen_util::cg_emit_line(out, "  %tsn.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %tsn.arr.i, ptr %tsn.arr.ptr")
  codegen_util::cg_emit_line(out, "  %tsn.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %tsn.cap.ptr")
  codegen_util::cg_emit_line(out, "  %tsn.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tsn.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %tsn.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %tsn.mtx.i = ptrtoint ptr %tsn.mtx to i64")
  codegen_util::cg_emit_line(out, "  %tsn.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_snapshots, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %tsn.mtx.i, ptr %tsn.mtx.ptr")
  # B.7 Phase 4b: init task-scope side-table — 256 pairs = 512 i64 = 4096 bytes
  codegen_util::cg_emit_line(out, "  %tsc.arr = call ptr @__qz_alloc(i64 4096)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tsc.arr, i32 0, i64 4096)")
  codegen_util::cg_emit_line(out, "  %tsc.arr.i = ptrtoint ptr %tsc.arr to i64")
  codegen_util::cg_emit_line(out, "  %tsc.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_scopes, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %tsc.arr.i, ptr %tsc.arr.ptr")
  codegen_util::cg_emit_line(out, "  %tsc.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_scopes, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %tsc.cap.ptr")
  codegen_util::cg_emit_line(out, "  %tsc.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tsc.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %tsc.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %tsc.mtx.i = ptrtoint ptr %tsc.mtx to i64")
  codegen_util::cg_emit_line(out, "  %tsc.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_scopes, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %tsc.mtx.i, ptr %tsc.mtx.ptr")
  # B.7 Phase 4e.8: init task-timer side-table — 256 pairs = 512 i64 = 4096 bytes
  codegen_util::cg_emit_line(out, "  %tst.arr = call ptr @__qz_alloc(i64 4096)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tst.arr, i32 0, i64 4096)")
  codegen_util::cg_emit_line(out, "  %tst.arr.i = ptrtoint ptr %tst.arr to i64")
  codegen_util::cg_emit_line(out, "  %tst.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_timers, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %tst.arr.i, ptr %tst.arr.ptr")
  codegen_util::cg_emit_line(out, "  %tst.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_timers, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %tst.cap.ptr")
  codegen_util::cg_emit_line(out, "  %tst.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %tst.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %tst.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %tst.mtx.i = ptrtoint ptr %tst.mtx to i64")
  codegen_util::cg_emit_line(out, "  %tst.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_timers, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %tst.mtx.i, ptr %tst.mtx.ptr")
  if cg_is_windows(target)
    # Phase 5e+ — init Windows-only task→SockState side-table. Same
    # capacity (256 pairs = 4096 bytes) and shape as __qz_task_timers,
    # plus its own mutex. POSIX doesn't initialize this because POSIX
    # sched_wake never goes through __qz_task_iosock_take (no AFD-
    # equivalent to cancel; epoll/kqueue ONESHOT auto-removes).
    codegen_util::cg_emit_line(out, "  %tis.arr = call ptr @__qz_alloc(i64 4096)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %tis.arr, i32 0, i64 4096)")
    codegen_util::cg_emit_line(out, "  %tis.arr.i = ptrtoint ptr %tis.arr to i64")
    codegen_util::cg_emit_line(out, "  %tis.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_iosocks, i64 0, i64 0")
    codegen_util::cg_emit_line(out, "  store i64 %tis.arr.i, ptr %tis.arr.ptr")
    codegen_util::cg_emit_line(out, "  %tis.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_iosocks, i64 0, i64 2")
    codegen_util::cg_emit_line(out, "  store i64 256, ptr %tis.cap.ptr")
    codegen_util::cg_emit_line(out, "  %tis.mtx = call ptr @__qz_alloc(i64 64)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %tis.mtx, i32 0, i64 64)")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %tis.mtx, ptr null)")
    codegen_util::cg_emit_line(out, "  %tis.mtx.i = ptrtoint ptr %tis.mtx to i64")
    codegen_util::cg_emit_line(out, "  %tis.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_iosocks, i64 0, i64 3")
    codegen_util::cg_emit_line(out, "  store i64 %tis.mtx.i, ptr %tis.mtx.ptr")
  end
  # C.14.4 — init actor-exit clean-marker sidecar: 4096 i64 slots = 32768 bytes
  codegen_util::cg_emit_line(out, "  %aec.arr = call ptr @__qz_alloc(i64 32768)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %aec.arr, i32 0, i64 32768)")
  codegen_util::cg_emit_line(out, "  %aec.arr.i = ptrtoint ptr %aec.arr to i64")
  codegen_util::cg_emit_line(out, "  %aec.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_actor_exit_clean, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %aec.arr.i, ptr %aec.arr.ptr")
  codegen_util::cg_emit_line(out, "  %aec.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_actor_exit_clean, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 4096, ptr %aec.cap.ptr")
  codegen_util::cg_emit_line(out, "  %aec.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %aec.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %aec.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %aec.mtx.i = ptrtoint ptr %aec.mtx to i64")
  codegen_util::cg_emit_line(out, "  %aec.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_actor_exit_clean, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %aec.mtx.i, ptr %aec.mtx.ptr")
  # C.13 Phase 5 / C.14.3a — init the resource-waiter hashmap. Factored
  # into a separate function so the loop over 64 stripe mutexes doesn't
  # fragment __qz_sched_init's basic-block flow.
  codegen_util::cg_emit_line(out, "  call void @__qz_waiters_init()")
  # Spawn I/O poller thread. The pthread_create resolves through the 5a
  # Win32 shim on Windows (CreateThread) and stores the HANDLE-as-i64 in
  # slot 13 the same way it stores a pthread_t on POSIX. The poller body
  # itself is platform-branched inside __qz_sched_io_poller below — IOCP
  # GetQueuedCompletionStatusEx loop on Windows, kqueue/epoll_wait loop
  # elsewhere.
  codegen_util::cg_emit_line(out, "  %io.tid.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 13")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_create(ptr %io.tid.ptr, ptr null, ptr @__qz_sched_io_poller, ptr null)")
  # Allocate per-worker data: nw * 12 slots * 8 bytes = nw * 96
  # Layout: [0]=buffer, [1]=bottom, [2]=top, [3]=unused, [4]=cap=256,
  #          [5]=unused, [6]=worker_id, [7]=rng_state, [8]=busy_ns, [9]=exec_start
  #          [10]=pipe_rfd, [11]=pipe_wfd
  codegen_util::cg_emit_line(out, "  %wd.sz = mul i64 %nw, 96")
  codegen_util::cg_emit_line(out, "  %wd.mem = call ptr @__qz_alloc(i64 %wd.sz)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %wd.mem, i32 0, i64 %wd.sz)")
  codegen_util::cg_emit_line(out, "  %wd.i = ptrtoint ptr %wd.mem to i64")
  codegen_util::cg_emit_line(out, "  %wd.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  store i64 %wd.i, ptr %wd.ptr")
  # Allocate worker thread IDs
  codegen_util::cg_emit_line(out, "  %wk.sz = mul i64 %nw, 8")
  codegen_util::cg_emit_line(out, "  %wk.mem = call ptr @__qz_alloc(i64 %wk.sz)")
  codegen_util::cg_emit_line(out, "  %wk.i = ptrtoint ptr %wk.mem to i64")
  codegen_util::cg_emit_line(out, "  %wk.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %wk.i, ptr %wk.ptr")
  # Spawn worker threads (pass worker index as arg)
  codegen_util::cg_emit_line(out, "  %wk.arr = bitcast ptr %wk.mem to ptr")
  codegen_util::cg_emit_line(out, "  br label %spawn_loop")
  codegen_util::cg_emit_line(out, "spawn_loop:")
  codegen_util::cg_emit_line(out, "  %si = phi i64 [0, %nw_done], [%si.next, %spawn_next]")
  codegen_util::cg_emit_line(out, "  %si.done = icmp uge i64 %si, %nw")
  codegen_util::cg_emit_line(out, "  br i1 %si.done, label %spawn_done, label %spawn_one")
  codegen_util::cg_emit_line(out, "spawn_one:")
  codegen_util::cg_emit_line(out, "  %tid.slot = getelementptr i64, ptr %wk.arr, i64 %si")
  codegen_util::cg_emit_line(out, "  %si.arg = inttoptr i64 %si to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_create(ptr %tid.slot, ptr null, ptr @__qz_sched_worker, ptr %si.arg)")
  codegen_util::cg_emit_line(out, "  br label %spawn_next")
  codegen_util::cg_emit_line(out, "spawn_next:")
  codegen_util::cg_emit_line(out, "  %si.next = add i64 %si, 1")
  codegen_util::cg_emit_line(out, "  br label %spawn_loop")
  codegen_util::cg_emit_line(out, "spawn_done:")
  # Install task-dump signal handler (CONC.11):
  # - POSIX: signal(SIGUSR1, __qz_sigusr1_handler). SIGUSR1 = 30 on macOS,
  #   10 on Linux. `kill -USR1 <pid>` from another shell triggers a dump.
  # - Windows: SetConsoleCtrlHandler(__qz_console_ctrl_handler, TRUE).
  #   Ctrl+Break in the console triggers the dump. Other control events
  #   (Ctrl+C, Ctrl+Close, logoff, shutdown) fall through to the default
  #   handler (terminate), preserving expected console behavior.
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  call i32 @SetConsoleCtrlHandler(ptr @__qz_console_ctrl_handler, i32 1)")
  elsif cg_is_macos(target)
    codegen_util::cg_emit_line(out, "  call ptr @signal(i32 30, ptr @__qz_sigusr1_handler)")
  else
    codegen_util::cg_emit_line(out, "  call ptr @signal(i32 10, ptr @__qz_sigusr1_handler)")
  end
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %init.ptr")
  # B2: transition @__qz_sched_state to RUNNING (1) atomically.
  # Happens after workers + I/O poller are spawned but before init returns,
  # so any concurrent sched_is_active() either sees UNINIT (racing with
  # first initializer) or RUNNING (init complete). Never RUNNING with
  # uninitialized workers.
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr @__qz_sched_state seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sigusr1_handler(sig): SIGUSR1 signal handler — set dump flag
  codegen_util::cg_emit_line(out, "define void @__qz_sigusr1_handler(i32 %sig) nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_dump_requested")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  if cg_is_windows(target)
    # __qz_console_ctrl_handler(dwCtrlType): Windows console control handler.
    # Returns BOOL: TRUE (1) = "I handled this event, don't propagate",
    # FALSE (0) = "let default handler run".
    #
    # CTRL_BREAK_EVENT (1) is the Windows analog of POSIX SIGUSR1 for our
    # task-dump trigger — set the dump flag and signal "handled" so the
    # default break-into-debugger doesn't fire.
    #
    # Every other control type (CTRL_C_EVENT=0, CTRL_CLOSE_EVENT=2,
    # CTRL_LOGOFF_EVENT=5, CTRL_SHUTDOWN_EVENT=6) falls through to FALSE
    # so the OS's default handler runs — preserves Ctrl+C terminate,
    # close-window terminate, etc.
    codegen_util::cg_emit_line(out, "define i32 @__qz_console_ctrl_handler(i32 %ctrl) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %is_break = icmp eq i32 %ctrl, 1")
    codegen_util::cg_emit_line(out, "  br i1 %is_break, label %handle_break, label %unhandled")
    codegen_util::cg_emit_line(out, "handle_break:")
    codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_dump_requested")
    codegen_util::cg_emit_line(out, "  ret i32 1")
    codegen_util::cg_emit_line(out, "unhandled:")
    codegen_util::cg_emit_line(out, "  ret i32 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # __qz_dump_tasks(): iterate task registry and print to stderr
  codegen_util::cg_emit_line(out, "define void @__qz_dump_tasks() nounwind {")
  codegen_util::cg_emit_line(out, "dt_entry:")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.stt_hdr to i64))")
  codegen_util::cg_emit_line(out, "  %dt.mtx.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %dt.mtx.i = load i64, ptr %dt.mtx.p")
  codegen_util::cg_emit_line(out, "  %dt.has_mtx = icmp ne i64 %dt.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %dt.has_mtx, label %dt_scan, label %dt_ret")
  codegen_util::cg_emit_line(out, "dt_scan:")
