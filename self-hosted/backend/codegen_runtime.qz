    # discard it (Phase 5d does not support cancellation; UnregisterWaitEx
    # would need this handle, filed-forward).
    codegen_util::cg_emit_line(out, "  %wh.slot = alloca ptr")
    codegen_util::cg_emit_line(out, "  %hproc = inttoptr i64 %pid to ptr")
    # Context = task pointer. The callback re-derives the i64 via ptrtoint.
    codegen_util::cg_emit_line(out, "  %task.p = inttoptr i64 %task to ptr")
