  codegen_util::cg_emit_line(out, "task_sleep:")
  codegen_util::cg_emit_line(out, "  %io.sleep_ms = sub i64 %io.sleep, 1")
  codegen_util::cg_emit_line(out, "  %io.sleep_nz = icmp sgt i64 %io.sleep_ms, 0")
  codegen_util::cg_emit_line(out, "  br i1 %io.sleep_nz, label %task_sleep_timer, label %task_sleep_yield")
  codegen_util::cg_emit_line(out, "task_sleep_timer:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_register_timer(i64 %task.i, i64 %io.sleep_ms)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_sleep_yield:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task.i)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_io_real:")
  # I/O suspended — decode "fd" (may actually be a pid for proc_suspend)
