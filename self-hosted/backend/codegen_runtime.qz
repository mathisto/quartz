  # __qz_default_throws_handler: writes the actual thrown message to stderr
  # followed by a newline, then exits 66. Matches handler ABI
  # `i64 (ptr %op, i64 %argc, ptr %argv)` since Milestone E(post). argv[0]
  # is the i64 string handle for the message; we extract its byte length
  # via qz_str_get_len (which reads the length prefix at ptr-8) and write
  # directly. Mirrors the default Log handler shape (Phase 6.1.a). Never
  # returns. User handlers decode each arg as `as_string(load(argv, i))`
  # (or unbox primitives) per the standard handler ABI.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_throws_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "  %thr.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %thr.msg = inttoptr i64 %thr.pi to ptr")
  codegen_util::cg_emit_line(out, "  %thr.len = call i64 @qz_str_get_len(ptr %thr.msg)")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr %thr.msg, i64 %thr.len)")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr @__qz_eff_newline, i64 1)")
  codegen_util::cg_emit_line(out, "  call void @exit(i32 66)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # __qz_default_log_handler: writes the actual message to stderr followed
  # by a newline, returns 0. Non-fatal. Same `i64 (ptr %op, i64 %argc,
  # ptr %argv)` ABI as the throws default. argv[0] is the i64 string
  # handle for the message; we extract its byte length via qz_str_get_len
  # (which reads the length prefix at ptr-8) and write directly.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_log_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "  %log.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %log.msg = inttoptr i64 %log.pi to ptr")
  codegen_util::cg_emit_line(out, "  %log.len = call i64 @qz_str_get_len(ptr %log.msg)")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr %log.msg, i64 %log.len)")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr @__qz_eff_newline, i64 1)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # __qz_default_async_handler: scheduler-as-handler default for the Async
  # effect (Effects P3.B). Same ABI as Throws/Log. Dispatches on op name:
  #   yield   → call @usleep(1) [matches existing sched_yield behavior],
  #             return 0.
  #   await   → busy-poll handle's frame[2] poll_fn until state == ready,
  #             load result from frame[1], call __qz_effect_resume_cont
  #             to deliver it back into the caller's $poll. Kind=3:
  #             resume_cont re-enters caller's state machine with %result,
  #             caller runs body to completion (writes body_rv → frame[1],
  #             state=-1 → frame[0]), returns to this handler which then
  #             returns. Outer perform call's `ret POLL_READY` finishes
  #             the caller's $poll outer invocation. (P3.C.3 baseline —
  #             busy-poll replaces the pipe-based completion_block path
  #             for simplicity; the worker thread spins inside a usleep(100)
  #             loop until the future completes. Post-migration perf
  #             work will swap to a park-for-wake model.)
  #   spawn   → auto-init scheduler if needed, then @__qz_sched_spawn(
  #             argv[0]) and return argv[0] (the task frame handle). P3.D
  #             — kind=1 (function-kind): perform's return value becomes
  #             the caller's expression value, so `var h = go f()` yields
  #             the frame. No caller-side $poll rewriting.
  #   suspend → P3.E-runtime: call @__qz_effect_park(argv[0]) which
  #             stashes `-(fd+2)` into @__qz_effect_park_rv TLS. When
  #             the handler returns, the caller's kind=3 perform epilogue
  #             loads the TLS and `ret %tls_rv` — scheduler interprets
  #             the negative sentinel as "park this task on argv[0]"
  #             (fd / pid / timer depending on the TLS flags the caller
  #             pre-set before emitting the perform). Gated on
  #             uses_scheduler like spawn — dormant imports get a stub.
  #   other   → return 0 stub (benign).
  #
  # User-installed handlers via `with Async { op: h } do ... end` still
  # override this default per the H-delegate per-op filter mechanism.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_async_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_yield = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_yield)")
  codegen_util::cg_emit_line(out, "  br i1 %is_yield, label %do_yield, label %try_await")
  codegen_util::cg_emit_line(out, "try_await:")
  codegen_util::cg_emit_line(out, "  %is_await = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_await)")
  codegen_util::cg_emit_line(out, "  br i1 %is_await, label %do_await_init, label %try_spawn")
  codegen_util::cg_emit_line(out, "try_spawn:")
  codegen_util::cg_emit_line(out, "  %is_spawn = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_spawn)")
  codegen_util::cg_emit_line(out, "  br i1 %is_spawn, label %do_spawn, label %try_suspend")
  codegen_util::cg_emit_line(out, "try_suspend:")
  codegen_util::cg_emit_line(out, "  %is_suspend = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_suspend)")
  codegen_util::cg_emit_line(out, "  br i1 %is_suspend, label %do_suspend, label %do_stub")
  codegen_util::cg_emit_line(out, "do_yield:")
  codegen_util::cg_emit_line(out, "  call i32 @usleep(i32 1)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  # P3.D: spawn branch requires the scheduler runtime (__qz_sched_init,
  # __qz_sched_spawn, @__qz_sched). Those symbols are only emitted when
  # `prog.uses_scheduler` is set — gated on `go`/channels/actors being
  # present. If the program has no such use, no NODE_GO can ever trigger
  # perform(Async, spawn), so emit a harmless `ret 0` stub. This keeps
  # the default handler cheap/linkable for programs that merely import
  # std/async without actually spawning.
  if uses_scheduler == 1
    codegen_util::cg_emit_line(out, "do_spawn:")
    codegen_util::cg_emit_line(out, "  %sp.frame = load i64, ptr %argv, align 8")
    codegen_util::cg_emit_line(out, "  %sp.init.p = getelementptr i64, ptr @__qz_sched, i64 10")
    codegen_util::cg_emit_line(out, "  %sp.init.v = load i64, ptr %sp.init.p, align 8")
    codegen_util::cg_emit_line(out, "  %sp.need_init = icmp eq i64 %sp.init.v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %sp.need_init, label %do_spawn_init, label %do_spawn_call")
    codegen_util::cg_emit_line(out, "do_spawn_init:")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_init(i64 0)")
    codegen_util::cg_emit_line(out, "  br label %do_spawn_call")
    codegen_util::cg_emit_line(out, "do_spawn_call:")
    # E.1.c.b: capture parent's user-installed effect handlers and register
    # them against this task's frame. The worker poll-dispatch site looks
    # up the snapshot and applies it before each $poll call so the task
    # body sees parent's handlers (Erlang/BEAM-style "fiber inherits
    # caller's dynamic context"). Skipped silently when there are no
    # entries above the blessed watermark (snap == 0). Custom handlers
    # that bypass this default Async.spawn path don't get inheritance —
    # documented limitation, follow-up scope.
    codegen_util::cg_emit_line(out, "  %sp.snap.i = call i64 @__qz_effect_snapshot_capture()")
    codegen_util::cg_emit_line(out, "  call void @__qz_task_snapshot_register(i64 %sp.frame, i64 %sp.snap.i)")
    # B.7 Phase 4b: capture parent's current_scope at spawn time and
    # register against this task's frame. Worker poll dispatch loads it
    # into TLS @__qz_current_scope_handle on every poll entry so the task
    # body sees parent's scope (structured-concurrency cancellation tree).
    # `__qz_task_scope_set` is an upsert that no-ops on scope == 0, so
    # root-scope spawns stay out of the table to keep the lookup fast.
    codegen_util::cg_emit_line(out, "  %sp.scope.i = load i64, ptr @__qz_current_scope_handle, align 8")
    codegen_util::cg_emit_line(out, "  call void @__qz_task_scope_set(i64 %sp.frame, i64 %sp.scope.i)")
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_spawn(i64 %sp.frame)")
    codegen_util::cg_emit_line(out, "  ret i64 %sp.frame")
  else
    codegen_util::cg_emit_line(out, "do_spawn:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
  end
  # P3.E-runtime: do_suspend. argv[0] = fd/pid/timer encoded as i64.
  # __qz_effect_park(fd) stashes `-(fd+2)` into TLS, returns 0. The
  # caller's kind=3 perform epilogue picks it up. No scheduler-runtime
  # symbols referenced, so this branch is safe regardless of
  # uses_scheduler — the scheduler dispatch happens on the poll return
  # (worker's task_io_real reads the pre-set TLS flags to decide
  # register_io vs register_proc vs register_timer).
  codegen_util::cg_emit_line(out, "do_suspend:")
  codegen_util::cg_emit_line(out, "  %su.fd = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %su.rv = call i64 @__qz_effect_park(i64 %su.fd)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "do_await_init:")
  codegen_util::cg_emit_line(out, "  %h_i64 = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %h_ptr = inttoptr i64 %h_i64 to ptr")
  codegen_util::cg_emit_line(out, "  br label %do_await_poll")
  codegen_util::cg_emit_line(out, "do_await_poll:")
  codegen_util::cg_emit_line(out, "  %st = load i64, ptr %h_ptr, align 8")
  codegen_util::cg_emit_line(out, "  %st_done = icmp eq i64 %st, -1")
  codegen_util::cg_emit_line(out, "  br i1 %st_done, label %do_await_done, label %do_await_tick")
  codegen_util::cg_emit_line(out, "do_await_tick:")
  codegen_util::cg_emit_line(out, "  %pf_slot = getelementptr inbounds i8, ptr %h_ptr, i64 16")
  codegen_util::cg_emit_line(out, "  %pf = load ptr, ptr %pf_slot, align 8")
  codegen_util::cg_emit_line(out, "  %pr = call i64 %pf(i64 %h_i64)")
  codegen_util::cg_emit_line(out, "  %ready = icmp eq i64 %pr, 1")
  codegen_util::cg_emit_line(out, "  br i1 %ready, label %do_await_done, label %do_await_wait")
  codegen_util::cg_emit_line(out, "do_await_wait:")
  codegen_util::cg_emit_line(out, "  call i32 @usleep(i32 100)")
  codegen_util::cg_emit_line(out, "  br label %do_await_poll")
  codegen_util::cg_emit_line(out, "do_await_done:")
  codegen_util::cg_emit_line(out, "  %res_slot = getelementptr inbounds i8, ptr %h_ptr, i64 8")
  codegen_util::cg_emit_line(out, "  %rv = load i64, ptr %res_slot, align 8")
  codegen_util::cg_emit_line(out, "  %_rc = call i64 @__qz_effect_resume_cont(i64 %rv)")
  codegen_util::cg_emit_line(out, "  ret i64 %rv")
  codegen_util::cg_emit_line(out, "do_stub:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # P5.4.e: FileIo default handler. Dispatches by op name to libc-backed
  # filesystem ops. Matches the hand-rolled Quartz defaults at
  # `std/file_io.qz` (fio_default_{read,write,exists,list_dir}) but emits
  # as inline LLVM IR so the main prelude can install unconditionally
  # without depending on std/file_io being imported. All four ops are
  # kind=1 (function-kind): handler runs, returns value, perform resumes
  # at op call site. User `with FileIo { ... } do ... end` blocks push
  # over this default per the standard handler-stack top-down scan.
  # Blessed relaxation at typecheck (typecheck_expr_handlers.qz):
  # FileIo op calls are considered covered without explicit `can FileIo`
  # because this prelude install always satisfies them at runtime.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_fileio_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %fio.is_read = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_fio_read)")
  codegen_util::cg_emit_line(out, "  br i1 %fio.is_read, label %fio_do_read, label %fio_try_write")
  codegen_util::cg_emit_line(out, "fio_try_write:")
  codegen_util::cg_emit_line(out, "  %fio.is_write = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_fio_write)")
  codegen_util::cg_emit_line(out, "  br i1 %fio.is_write, label %fio_do_write, label %fio_try_exists")
  codegen_util::cg_emit_line(out, "fio_try_exists:")
  codegen_util::cg_emit_line(out, "  %fio.is_exists = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_fio_exists)")
  codegen_util::cg_emit_line(out, "  br i1 %fio.is_exists, label %fio_do_exists, label %fio_try_list_dir")
  codegen_util::cg_emit_line(out, "fio_try_list_dir:")
  codegen_util::cg_emit_line(out, "  %fio.is_list_dir = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_fio_list_dir)")
  codegen_util::cg_emit_line(out, "  br i1 %fio.is_list_dir, label %fio_do_list_dir, label %fio_do_stub")
  # read branch: fopen "r" → fseek/ftell/rewind → qz_alloc_str → fread → fclose.
  # Mirrors cg_intrinsic_io.qz's read_file expansion. On fopen failure returns
  # the empty string (same semantics as the intrinsic).
  codegen_util::cg_emit_line(out, "fio_do_read:")
  codegen_util::cg_emit_line(out, "  %fio.rd.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %fio.rd.path = inttoptr i64 %fio.rd.pi to ptr")
  codegen_util::cg_emit_line(out, "  %fio.rd.fp = call ptr @fopen(ptr %fio.rd.path, ptr getelementptr([2 x i8], [2 x i8]* @.read_mode, i64 0, i64 0))")
  codegen_util::cg_emit_line(out, "  %fio.rd.null = icmp eq ptr %fio.rd.fp, null")
  codegen_util::cg_emit_line(out, "  br i1 %fio.rd.null, label %fio_rd_empty, label %fio_rd_ok")
  codegen_util::cg_emit_line(out, "fio_rd_ok:")
  codegen_util::cg_emit_line(out, "  call i32 @fseek(ptr %fio.rd.fp, i64 0, i32 2)")
  codegen_util::cg_emit_line(out, "  %fio.rd.size = call i64 @ftell(ptr %fio.rd.fp)")
  codegen_util::cg_emit_line(out, "  call void @rewind(ptr %fio.rd.fp)")
  codegen_util::cg_emit_line(out, "  %fio.rd.buf = call ptr @qz_alloc_str(i64 %fio.rd.size)")
  codegen_util::cg_emit_line(out, "  call i64 @fread(ptr %fio.rd.buf, i64 1, i64 %fio.rd.size, ptr %fio.rd.fp)")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fio.rd.fp)")
  codegen_util::cg_emit_line(out, "  %fio.rd.result = ptrtoint ptr %fio.rd.buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %fio.rd.result")
  codegen_util::cg_emit_line(out, "fio_rd_empty:")
  codegen_util::cg_emit_line(out, "  %fio.rd.empty = ptrtoint ptr getelementptr(<{ i64, [1 x i8] }>, <{ i64, [1 x i8] }>* @.empty_string, i64 0, i32 1, i64 0) to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %fio.rd.empty")
  # write branch: fopen "w" → qz_str_get_len → fwrite → fclose. Returns 0
  # on success; caller discards. Mirrors cg_intrinsic_io.qz's write_file.
  codegen_util::cg_emit_line(out, "fio_do_write:")
  codegen_util::cg_emit_line(out, "  %fio.wr.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %fio.wr.path = inttoptr i64 %fio.wr.pi to ptr")
  codegen_util::cg_emit_line(out, "  %fio.wr.cgep = getelementptr i64, ptr %argv, i64 1")
  codegen_util::cg_emit_line(out, "  %fio.wr.ci = load i64, ptr %fio.wr.cgep, align 8")
  codegen_util::cg_emit_line(out, "  %fio.wr.content = inttoptr i64 %fio.wr.ci to ptr")
  codegen_util::cg_emit_line(out, "  %fio.wr.fp = call ptr @fopen(ptr %fio.wr.path, ptr getelementptr([2 x i8], [2 x i8]* @.write_mode, i64 0, i64 0))")
  codegen_util::cg_emit_line(out, "  %fio.wr.len = call i64 @qz_str_get_len(ptr %fio.wr.content)")
  codegen_util::cg_emit_line(out, "  call i64 @fwrite(ptr %fio.wr.content, i64 1, i64 %fio.wr.len, ptr %fio.wr.fp)")
  codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fio.wr.fp)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  # exists branch: access(path, F_OK) == 0. Mirrors cg_intrinsic_misc.qz's
  # file_exists. Returns 1 if present, 0 otherwise.
  codegen_util::cg_emit_line(out, "fio_do_exists:")
  codegen_util::cg_emit_line(out, "  %fio.ex.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %fio.ex.path = inttoptr i64 %fio.ex.pi to ptr")
  codegen_util::cg_emit_line(out, "  %fio.ex.ret = call i32 @access(ptr %fio.ex.path, i32 0)")
  codegen_util::cg_emit_line(out, "  %fio.ex.eq = icmp eq i32 %fio.ex.ret, 0")
  codegen_util::cg_emit_line(out, "  %fio.ex.res = zext i1 %fio.ex.eq to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %fio.ex.res")
  # list_dir branch: qz_readdir(path_i64) returns a Vec<String> i64 handle.
  # Mirrors cg_intrinsic_io.qz's readdir.
  codegen_util::cg_emit_line(out, "fio_do_list_dir:")
  codegen_util::cg_emit_line(out, "  %fio.ld.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %fio.ld.r = call i64 @qz_readdir(i64 %fio.ld.pi)")
  codegen_util::cg_emit_line(out, "  ret i64 %fio.ld.r")
  codegen_util::cg_emit_line(out, "fio_do_stub:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # A.3.a: Alloc default handler. Dispatches by op name to the libc
  # allocator. Matches the hand-rolled Quartz defaults at `std/alloc.qz`
  # (default_alloc_handler / default_dealloc_handler) but emits as inline
  # LLVM IR so the main prelude can install unconditionally without
  # requiring `import std/alloc`. Both ops are kind=1 (function-kind):
  # handler runs, returns a value (pointer-as-i64 for alloc, 0 for
  # dealloc), perform resumes at op call site. User
  # `with Alloc { alloc: h, dealloc: h2 } do ... end` blocks push above
  # this default per the standard handler-stack top-down scan.
  #
  # Blessed relaxation in typecheck_expr_handlers.qz adds Alloc to the
  # set so user code can call `alloc(N)` / `dealloc(p)` without an
  # explicit `can Alloc` row, just like `Throws` / `Log` / `FileIo` /
  # `Intern`.
  #
  # A.3.c byte-semantics: argv[0] for `alloc` is BYTES (not slots).
  # Aligns with malloc's universal byte-count convention. Pre-A.3.c
  # the unit was slots and the handler did `mul size, 8`; that
  # mismatched the byte-count `mem_alloc(N)` semantic that every
  # internal stdlib call site has been passing to it for months.
  # The user-visible effect op `alloc(size: Int): CPtr` now means
  # `size` bytes; existing alloc specs converted slot→byte counts
  # in lockstep with this change.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_alloc_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %alloc.is_alloc = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_alloc)")
  codegen_util::cg_emit_line(out, "  br i1 %alloc.is_alloc, label %alloc_do_alloc, label %alloc_try_dealloc")
  codegen_util::cg_emit_line(out, "alloc_try_dealloc:")
  codegen_util::cg_emit_line(out, "  %alloc.is_dealloc = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_dealloc)")
  codegen_util::cg_emit_line(out, "  br i1 %alloc.is_dealloc, label %alloc_do_dealloc, label %alloc_do_stub")
  # alloc branch: argv[0] is bytes (i64).
  codegen_util::cg_emit_line(out, "alloc_do_alloc:")
  codegen_util::cg_emit_line(out, "  %alloc.al.bytes = load i64, ptr %argv, align 8")
  # @malloc direct (NOT wrapper) — this IS the default Alloc handler
  # body. Routing via @__qz_alloc would either bypass back to @malloc
  # (the wrapper's direct branch fires when @__qz_alloc_in_handler is
  # set, which __qz_effect_perform sets around our invocation) or
  # infinite-recurse via perform when not bypassing.
  codegen_util::cg_emit_line(out, "  %alloc.al.ptr = call ptr @malloc(i64 %alloc.al.bytes)")
  codegen_util::cg_emit_line(out, "  %alloc.al.result = ptrtoint ptr %alloc.al.ptr to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %alloc.al.result")
  # dealloc branch: argv[0] is a CPtr-as-i64. Mirrors cg_intrinsic_memory.qz's
  # mem_free expansion (@free on the inttoptr-converted pointer).
  codegen_util::cg_emit_line(out, "alloc_do_dealloc:")
  codegen_util::cg_emit_line(out, "  %alloc.de.pi = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %alloc.de.ptr = inttoptr i64 %alloc.de.pi to ptr")
  # @free direct — same rationale as @malloc above. Default handler body.
  codegen_util::cg_emit_line(out, "  call void @free(ptr %alloc.de.ptr)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "alloc_do_stub:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # A.8: Random default handler. Inline IR; dispatches by op name to the
  # existing `qz_rand_*` runtime helpers (xoshiro256** for seed/int/range,
  # arc4random_buf or getrandom for crypto). Same shape as FileIo / Alloc:
  # always-forward to libc-equivalent primitives. Installed unconditionally
  # in __qz_effect_install_defaults; no `uses_random` MIR flag needed
  # because the default body has zero link-cost beyond the runtime helpers
  # which `cg_emit_runtime_helpers_2` already emits unconditionally.
  #
  # Blessed relaxation in typecheck_expr_handlers.qz adds Random to the set
  # so user code can call `rand_int_op()` / `rand_range_op(lo, hi)` /
  # `rand_seed_op(seed)` / `rand_crypto_op()` without an explicit
  # `can Random` row, just like Throws / Log / FileIo / Intern / Alloc /
  # Cache / Profile.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_random_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %rnd.is_seed = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_rand_seed_op)")
  codegen_util::cg_emit_line(out, "  br i1 %rnd.is_seed, label %rnd_do_seed, label %rnd_try_int")
  codegen_util::cg_emit_line(out, "rnd_try_int:")
  codegen_util::cg_emit_line(out, "  %rnd.is_int = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_rand_int_op)")
  codegen_util::cg_emit_line(out, "  br i1 %rnd.is_int, label %rnd_do_int, label %rnd_try_range")
  codegen_util::cg_emit_line(out, "rnd_try_range:")
  codegen_util::cg_emit_line(out, "  %rnd.is_range = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_rand_range_op)")
  codegen_util::cg_emit_line(out, "  br i1 %rnd.is_range, label %rnd_do_range, label %rnd_try_crypto")
  codegen_util::cg_emit_line(out, "rnd_try_crypto:")
  codegen_util::cg_emit_line(out, "  %rnd.is_crypto = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_rand_crypto_op)")
  codegen_util::cg_emit_line(out, "  br i1 %rnd.is_crypto, label %rnd_do_crypto, label %rnd_do_stub")
  # seed branch: argv[0] is i64 seed.
  codegen_util::cg_emit_line(out, "rnd_do_seed:")
  codegen_util::cg_emit_line(out, "  %rnd.sd.seed = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  call void @qz_rand_seed(i64 %rnd.sd.seed)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  # int branch: zero-arg, returns next xoshiro256** value.
  codegen_util::cg_emit_line(out, "rnd_do_int:")
  codegen_util::cg_emit_line(out, "  %rnd.it.r = call i64 @qz_rand_int()")
  codegen_util::cg_emit_line(out, "  ret i64 %rnd.it.r")
  # range branch: argv[0]=lo, argv[1]=hi. Forwards to qz_rand_range
  # (same biased modulo reduction as the existing intrinsic).
  codegen_util::cg_emit_line(out, "rnd_do_range:")
  codegen_util::cg_emit_line(out, "  %rnd.rg.lo = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %rnd.rg.hi.gep = getelementptr i64, ptr %argv, i64 1")
  codegen_util::cg_emit_line(out, "  %rnd.rg.hi = load i64, ptr %rnd.rg.hi.gep, align 8")
  codegen_util::cg_emit_line(out, "  %rnd.rg.r = call i64 @qz_rand_range(i64 %rnd.rg.lo, i64 %rnd.rg.hi)")
  codegen_util::cg_emit_line(out, "  ret i64 %rnd.rg.r")
  # crypto branch: zero-arg, OS CSPRNG.
  codegen_util::cg_emit_line(out, "rnd_do_crypto:")
  codegen_util::cg_emit_line(out, "  %rnd.cr.r = call i64 @qz_crypto_rand_int()")
  codegen_util::cg_emit_line(out, "  ret i64 %rnd.cr.r")
  codegen_util::cg_emit_line(out, "rnd_do_stub:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # A.3.c — @__qz_alloc / @__qz_dealloc allocation primitive wrappers.
  #
  # Single funnel point for every allocation in compiled binaries. Every
  # `@malloc(i64 N)` call site in the codegen layer (qz_vec_new,
  # qz_str_concat, sb_*, map_*, channels, mutexes, task frames, regex,
  # binary, etc.) calls `@__qz_alloc(i64 N)` instead. Same for
  # `@free(ptr p)` → `@__qz_dealloc(ptr p)`. This makes the Alloc
  # effect's `with Alloc { ... }` block actually catch all allocation
  # traffic, not just user-visible `alloc(N)` calls and the `mem_alloc`
  # intrinsic.
  #
  # Bytes throughout — wrapper takes byte count, matches malloc's
  # universal convention. `mem_alloc(slots)` codegen multiplies by 8
  # at the intrinsic site before calling the wrapper.
  #
  # The wrapper body has a TWO-stage fast-path:
  #
  #   STAGE 1 (cheap, common case): `top <= bw` — no user `with Alloc {...}`
  #   is installed on top of the blessed defaults. Pure global loads + one
  #   icmp + one branch; no TLS access. Routes directly to @malloc/@free
  #   without the perform stack scan.
  #
  #   STAGE 2 (TLS-touching, rare): `__qz_alloc_in_handler != 0` — handler
  #   recursion bypass (D4). Only checked when stage 1 says "user handler
  #   installed"; ensures a custom Alloc handler that itself allocates
  #   (e.g., `puts("size:#{n}")` for tracing) doesn't infinite-recurse.
  #
  # Reordering matters: stage 1 catches >99% of allocations in any program
  # that doesn't actively wrap its hot path in `with Alloc`, paying only
  # 2 global loads + icmp + branch (~2 cycles after inlining). The
  # bypass-flag TLS load only fires on the slow path where stage 1 misses.
  #
  # The watermark is captured per-thread by `__qz_effect_install_defaults`
  # — once on main at qz_main entry, once per scheduler worker at worker
  # entry (Phase E.1.c). TLS storage so each thread's view is independent;
  # never mutated after the install completes, safely cached in registers
  # across the wrapper body.
  #
  # `alwaysinline` on both wrappers so they fold into call sites under
  # any pipeline that runs the AlwaysInliner pass (debug + release builds
  # both run `opt --passes=always-inline,mergefunc`).
  codegen_util::cg_emit_line(out, "#{prefix}ptr @__qz_alloc(i64 %bytes) nounwind alwaysinline {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %qza.top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %qza.bw = load i64, ptr @__qz_alloc_blessed_watermark, align 8")
  codegen_util::cg_emit_line(out, "  %qza.no_user = icmp sle i64 %qza.top, %qza.bw")
  codegen_util::cg_emit_line(out, "  br i1 %qza.no_user, label %qza_direct, label %qza_check_h")
  codegen_util::cg_emit_line(out, "qza_check_h:")
  codegen_util::cg_emit_line(out, "  %qza.in_h = load i64, ptr @__qz_alloc_in_handler, align 8")
  codegen_util::cg_emit_line(out, "  %qza.in_h_set = icmp ne i64 %qza.in_h, 0")
  codegen_util::cg_emit_line(out, "  br i1 %qza.in_h_set, label %qza_direct, label %qza_via_eff")
  codegen_util::cg_emit_line(out, "qza_direct:")
  codegen_util::cg_emit_line(out, "  %qza.dp = call ptr @malloc(i64 %bytes)")
  codegen_util::cg_emit_line(out, "  ret ptr %qza.dp")
  codegen_util::cg_emit_line(out, "qza_via_eff:")
  codegen_util::cg_emit_line(out, "  %qza.argv = alloca i64, i64 1, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %bytes, ptr %qza.argv, align 8")
  codegen_util::cg_emit_line(out, "  %qza.epi = call i64 @__qz_effect_perform(ptr @__qz_eff_name_alloc, ptr @__qz_eff_op_alloc, i64 1, ptr %qza.argv, i64 1)")
  codegen_util::cg_emit_line(out, "  %qza.ep = inttoptr i64 %qza.epi to ptr")
  codegen_util::cg_emit_line(out, "  ret ptr %qza.ep")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_dealloc(ptr %p) nounwind alwaysinline {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %qzd.top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %qzd.bw = load i64, ptr @__qz_alloc_blessed_watermark, align 8")
  codegen_util::cg_emit_line(out, "  %qzd.no_user = icmp sle i64 %qzd.top, %qzd.bw")
  codegen_util::cg_emit_line(out, "  br i1 %qzd.no_user, label %qzd_direct, label %qzd_check_h")
  codegen_util::cg_emit_line(out, "qzd_check_h:")
  codegen_util::cg_emit_line(out, "  %qzd.in_h = load i64, ptr @__qz_alloc_in_handler, align 8")
  codegen_util::cg_emit_line(out, "  %qzd.in_h_set = icmp ne i64 %qzd.in_h, 0")
  codegen_util::cg_emit_line(out, "  br i1 %qzd.in_h_set, label %qzd_direct, label %qzd_via_eff")
  codegen_util::cg_emit_line(out, "qzd_direct:")
  codegen_util::cg_emit_line(out, "  call void @free(ptr %p)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "qzd_via_eff:")
  codegen_util::cg_emit_line(out, "  %qzd.pi = ptrtoint ptr %p to i64")
  codegen_util::cg_emit_line(out, "  %qzd.argv = alloca i64, i64 1, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %qzd.pi, ptr %qzd.argv, align 8")
  codegen_util::cg_emit_line(out, "  %qzd.r = call i64 @__qz_effect_perform(ptr @__qz_eff_name_alloc, ptr @__qz_eff_op_dealloc, i64 1, ptr %qzd.argv, i64 1)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # A.3.d — @__qz_realloc allocation primitive wrapper.
  #
  # Phase A.3.c migrated raw @malloc/@free emit sites to @__qz_alloc/
  # @__qz_dealloc but missed the @realloc paths. This wrapper closes that
  # hole so Vec/String growth past initial capacity respects an installed
  # `with Alloc { ... } do ... end` handler.
  #
  # Signature: `__qz_realloc(ptr old, i64 old_bytes, i64 new_bytes) -> ptr`.
  # Each call site passes the OLD allocation size (typically `cap * 8` for
  # Vec; the buffer's true allocated capacity, not the used portion). The
  # extra parameter — vs libc's `realloc(ptr, new_bytes)` — is what lets
  # the routing path decompose without a third Alloc effect op. On the
  # bypass path we simply ignore it and call libc realloc.
  #
  # Routing strategy: DECOMPOSE rather than extend the Alloc effect with
  # a third op. When a user handler is in scope, route as
  # `alloc(new_bytes) + memcpy(min(old_bytes, new_bytes)) + dealloc(old)`.
  # This keeps the D1 minimal effect surface (alloc/dealloc only) and
  # makes every existing stdlib handler (arena/counter/deny/tracking)
  # work transparently. Trade-off: arena handlers lose the "last-alloc-
  # in-arena bump-extend" optimization (a real but optional perf win
  # filed as a Phase B followup if needed).
  #
  # Edge cases:
  #   old == NULL  → forward to alloc, skip memcpy + dealloc (matches
  #                  libc's `realloc(NULL, N) ≡ malloc(N)`).
  #   new_bytes == 0 → forward to dealloc, return NULL (matches libc's
  #                    `realloc(p, 0) ≡ free(p)` on most platforms).
  #
  # Bypass path keeps behavior identical to pre-A.3.d for the no-user-
  # handler case: one direct `call @realloc(...)`. With alwaysinline +
  # `opt --passes=always-inline`, the wrapper folds into a direct realloc
  # call site whenever LLVM can prove the routing branches are dead (it
  # generally can't statically — the watermark/in_h are runtime globals —
  # but the bypass branch is the predicted path so the cost is one icmp +
  # branch on top of the realloc).
  codegen_util::cg_emit_line(out, "#{prefix}ptr @__qz_realloc(ptr %old, i64 %old_bytes, i64 %new_bytes) nounwind alwaysinline {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %qzr.top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %qzr.bw = load i64, ptr @__qz_alloc_blessed_watermark, align 8")
  codegen_util::cg_emit_line(out, "  %qzr.no_user = icmp sle i64 %qzr.top, %qzr.bw")
  codegen_util::cg_emit_line(out, "  br i1 %qzr.no_user, label %qzr_direct, label %qzr_check_h")
  codegen_util::cg_emit_line(out, "qzr_check_h:")
  codegen_util::cg_emit_line(out, "  %qzr.in_h = load i64, ptr @__qz_alloc_in_handler, align 8")
  codegen_util::cg_emit_line(out, "  %qzr.in_h_set = icmp ne i64 %qzr.in_h, 0")
  codegen_util::cg_emit_line(out, "  br i1 %qzr.in_h_set, label %qzr_direct, label %qzr_via_eff")
  codegen_util::cg_emit_line(out, "qzr_direct:")
  codegen_util::cg_emit_line(out, "  %qzr.dp = call ptr @realloc(ptr %old, i64 %new_bytes)")
  codegen_util::cg_emit_line(out, "  ret ptr %qzr.dp")
  codegen_util::cg_emit_line(out, "qzr_via_eff:")
  codegen_util::cg_emit_line(out, "  %qzr.old_null = icmp eq ptr %old, null")
  codegen_util::cg_emit_line(out, "  br i1 %qzr.old_null, label %qzr_alloc_only, label %qzr_check_zero")
  codegen_util::cg_emit_line(out, "qzr_check_zero:")
  codegen_util::cg_emit_line(out, "  %qzr.new_zero = icmp eq i64 %new_bytes, 0")
  codegen_util::cg_emit_line(out, "  br i1 %qzr.new_zero, label %qzr_dealloc_only, label %qzr_full")
  codegen_util::cg_emit_line(out, "qzr_alloc_only:")
  codegen_util::cg_emit_line(out, "  %qzr.ap = call ptr @__qz_alloc(i64 %new_bytes)")
  codegen_util::cg_emit_line(out, "  ret ptr %qzr.ap")
  codegen_util::cg_emit_line(out, "qzr_dealloc_only:")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %old)")
  codegen_util::cg_emit_line(out, "  ret ptr null")
  codegen_util::cg_emit_line(out, "qzr_full:")
  codegen_util::cg_emit_line(out, "  %qzr.np = call ptr @__qz_alloc(i64 %new_bytes)")
  codegen_util::cg_emit_line(out, "  %qzr.shrink = icmp ult i64 %old_bytes, %new_bytes")
  codegen_util::cg_emit_line(out, "  %qzr.copy = select i1 %qzr.shrink, i64 %old_bytes, i64 %new_bytes")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %qzr.np, ptr %old, i64 %qzr.copy)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %old)")
  codegen_util::cg_emit_line(out, "  ret ptr %qzr.np")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_perform: top-down stack walk for a matching effect name.
  # On hit with a non-null handler, call handler(op_ptr, argc, argv).
  # On miss or null handler, divert to unhandled. Handler signature is
  # `i64 (ptr %op_name, i64 %argc, ptr %argv)` since Milestone E(post).
  # argv points to a caller-allocated `[argc x i64]` array; each slot
  # carries one op argument as an i64 (Quartz values are all i64-sized
  # at runtime — strings/structs as tagged/raw pointers, ints/bools/
  # chars as themselves). Zero-arg ops pass argc=0 with argv=null; user
  # handlers ignoring args simply don't read them.
  # Effects F.3b adds the `%kind` parameter. kind==2 ("operation" — memo
  # §2.3) means the handler discards the continuation: after the handler
  # returns, we stash the return value in __qz_effect_stack_results[slot]
  # and longjmp(stack_bufs[slot], 1) to the enclosing with-block. kind<2
  # (0/1 — tail resume / value kind) returns the handler's value normally
  # to the op call site, matching F.3a's function-kind fast path.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_perform(ptr %eff, ptr %op, i64 %argc, ptr %argv, i64 %kind) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %empty = icmp sle i64 %top, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %unhandled, label %scan_init")
  codegen_util::cg_emit_line(out, "scan_init:")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "scan:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [%top, %scan_init], [%iprev, %miss]")
  codegen_util::cg_emit_line(out, "  %idone = icmp sle i64 %i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %idone, label %unhandled, label %scan_body")
  codegen_util::cg_emit_line(out, "scan_body:")
  codegen_util::cg_emit_line(out, "  %iprev = sub i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %n_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  %n_i64 = load i64, ptr %n_slot, align 8")
  codegen_util::cg_emit_line(out, "  %n_ptr = inttoptr i64 %n_i64 to ptr")
  codegen_util::cg_emit_line(out, "  %eq = call i1 @__qz_effect_cstr_eq(ptr %n_ptr, ptr %eff)")
  codegen_util::cg_emit_line(out, "  br i1 %eq, label %filter_check, label %miss")
  # H-delegate: check op_filter. Null filter matches any op; non-null
  # filter must string-compare equal to the requested op, otherwise
  # skip to next entry (fall through to outer handlers).
  codegen_util::cg_emit_line(out, "filter_check:")
  codegen_util::cg_emit_line(out, "  %f_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_op_filters, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  %f_i64 = load i64, ptr %f_slot, align 8")
  codegen_util::cg_emit_line(out, "  %f_any = icmp eq i64 %f_i64, 0")
  codegen_util::cg_emit_line(out, "  br i1 %f_any, label %hit, label %filter_check_op")
  codegen_util::cg_emit_line(out, "filter_check_op:")
  codegen_util::cg_emit_line(out, "  %f_ptr = inttoptr i64 %f_i64 to ptr")
  codegen_util::cg_emit_line(out, "  %f_eq = call i1 @__qz_effect_cstr_eq(ptr %f_ptr, ptr %op)")
  codegen_util::cg_emit_line(out, "  br i1 %f_eq, label %hit, label %miss")
  codegen_util::cg_emit_line(out, "miss:")
  codegen_util::cg_emit_line(out, "  br label %scan")
  codegen_util::cg_emit_line(out, "hit:")
  codegen_util::cg_emit_line(out, "  %h_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_handlers, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  %h_i64 = load i64, ptr %h_slot, align 8")
  codegen_util::cg_emit_line(out, "  %h_null = icmp eq i64 %h_i64, 0")
  codegen_util::cg_emit_line(out, "  br i1 %h_null, label %unhandled, label %do_call")
  codegen_util::cg_emit_line(out, "do_call:")
  codegen_util::cg_emit_line(out, "  %h_ptr = inttoptr i64 %h_i64 to ptr")
  # Effects P3.0a: record install index in TLS + zero per-entry resumed
  # flag before the handler call. `resume(v)` in a kind=3 handler reads
  # current_install_idx to locate its continuation frame (bufs[idx])
  # and writes resumed[idx]=1 so the with-block teardown knows which
  # return value to pick. For non-kind=3 calls these stores are inert.
  # Effects P3.0c-runtime: also stash the op's kind in TLS. `resume(v)`
  # reads this at its dispatch block to branch between F.3a semantics
  # (kind<3 → `ret i64 %v` — early return from handler) and the kind=3
  # continuation-call path (load frame from bufs[idx], load poll_fn
  # from frame[2], call poll_fn(frame, %v), stash result to
  # results[idx], set resumed[idx]=1, continue handler).
  codegen_util::cg_emit_line(out, "  store i64 %iprev, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %kind, ptr @__qz_effect_current_kind, align 8")
  codegen_util::cg_emit_line(out, "  %r_reset_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_resumed, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %r_reset_slot, align 8")
  # Bypass-during-handler flag for Alloc-effect routing. The
  # __qz_alloc/__qz_dealloc wrappers route every allocation through
  # perform with effect=Alloc; a handler that itself allocates (e.g.,
  # a tracking handler that pushes onto a Vec) would infinite-recurse
  # via the stdlib's internal mem_alloc calls. Set @__qz_alloc_in_handler
  # to 1 around the matched-handler call WHEN the matched effect is
  # "Alloc"; the wrappers read this flag and short-circuit to direct
  # @malloc/@free instead of routing through perform when set.
  # Save+restore so nested perform calls stack cleanly. The select
  # keeps the store a no-op when not Alloc, so non-Alloc effects pay
  # only ~2ns of TLS load+select+store per perform — negligible against
  # the existing ~10-100ns scan cost.
  codegen_util::cg_emit_line(out, "  %is_alloc.a3b = call i1 @__qz_effect_cstr_eq(ptr %eff, ptr @__qz_eff_name_alloc)")
  codegen_util::cg_emit_line(out, "  %in_h_save.a3b = load i64, ptr @__qz_alloc_in_handler, align 8")
  codegen_util::cg_emit_line(out, "  %new_in_h.a3b = select i1 %is_alloc.a3b, i64 1, i64 %in_h_save.a3b")
  codegen_util::cg_emit_line(out, "  store i64 %new_in_h.a3b, ptr @__qz_alloc_in_handler, align 8")
  codegen_util::cg_emit_line(out, "  %rv = call i64 %h_ptr(ptr %op, i64 %argc, ptr %argv)")
  # Restore in-handler flag immediately after the handler returns so the
  # rest of the perform body (kind dispatch, ret_normal, do_unwind) and
  # any subsequent code in the calling function see the prior value.
  # Skipped when the handler longjmps directly out of perform (e.g., the
  # handler invokes `throw(...)` and unwinds to an outer with-Throws). In
  # that case the with-block layer (codegen_instr.qz wb.catch — B.0a)
  # restores the flag from a snapshot taken before the with-block's
  # setjmp; the catch-path restore covers exactly the case this line
  # cannot reach.
  codegen_util::cg_emit_line(out, "  store i64 %in_h_save.a3b, ptr @__qz_alloc_in_handler, align 8")
  # F.3b + P3.0c-perform + P4.B.8.a: post-handler dispatch on kind.
  #   kind<2  → return %rv normally (handler's value goes to perform caller).
  #   kind=2  → stash %rv to results[iprev], longjmp to bufs[iprev] (unwind).
  #   kind=3  → check resumed[iprev]:
  #              resumed=1 → body already ran via nested $poll invocation
  #                from __qz_effect_resume_cont. Caller's $poll frame[1]
  #                holds body_rv; caller's emission pattern `ret frame[1]`
  #                takes it from there. Return normally from perform.
  #              resumed=0 → check park_rv (P4.B.8.a — cooperative suspend).
  #                park_rv == 1 (POLL_READY default — unchanged from
  #                  park_reset) means the handler took no action and
  #                  fell through. Honour F.3b semantics: stash %rv,
  #                  longjmp to bufs[iprev] (handler aborts the body).
  #                park_rv != 1 (handler called __qz_effect_suspend → 0,
  #                  or __qz_effect_park(fd) → -(fd+2)) means the handler
  #                  explicitly suspended. Return %rv normally and let the
  #                  caller's post-perform read park_rv via __qz_effect_
  #                  park_get_rv to propagate POLL_SUSPENDED / park up the
  #                  call chain. This is the architectural enabler for
  #                  modular `can Yield` helpers — the kind=3 perform from
  #                  inside a $poll-lifted helper no longer tears down the
  #                  outer caller's $poll frame, so the caller's state-
  #                  machine state survives across the suspension and the
  #                  next consumer-drive re-enters at the right resume
  #                  block. The legacy unwind path stays the right answer
  #                  for the "user installed `with E { op: h } do -> body
  #                  end` and h returned without resuming or suspending"
  #                  case (intentional with-block early-exit).
  codegen_util::cg_emit_line(out, "  %is_k3 = icmp eq i64 %kind, 3")
  codegen_util::cg_emit_line(out, "  br i1 %is_k3, label %k3_dispatch, label %kind_lt3")
  codegen_util::cg_emit_line(out, "k3_dispatch:")
  codegen_util::cg_emit_line(out, "  %rf_slot.p = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_resumed, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  %rf_val = load i64, ptr %rf_slot.p, align 8")
  codegen_util::cg_emit_line(out, "  %was_resumed = icmp ne i64 %rf_val, 0")
  codegen_util::cg_emit_line(out, "  br i1 %was_resumed, label %ret_normal, label %k3_check_suspend")
  codegen_util::cg_emit_line(out, "k3_check_suspend:")
  codegen_util::cg_emit_line(out, "  %k3_prv = load i64, ptr @__qz_effect_park_rv, align 8")
  codegen_util::cg_emit_line(out, "  %k3_aborted = icmp eq i64 %k3_prv, 1")
  codegen_util::cg_emit_line(out, "  br i1 %k3_aborted, label %maybe_unwind, label %ret_normal")
  codegen_util::cg_emit_line(out, "kind_lt3:")
  codegen_util::cg_emit_line(out, "  %is_unwind = icmp sge i64 %kind, 2")
  codegen_util::cg_emit_line(out, "  br i1 %is_unwind, label %maybe_unwind, label %ret_normal")
  codegen_util::cg_emit_line(out, "maybe_unwind:")
  codegen_util::cg_emit_line(out, "  %b_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_bufs, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  %b_i64 = load i64, ptr %b_slot, align 8")
  codegen_util::cg_emit_line(out, "  %b_null = icmp eq i64 %b_i64, 0")
  codegen_util::cg_emit_line(out, "  br i1 %b_null, label %ret_normal, label %do_unwind")
  codegen_util::cg_emit_line(out, "do_unwind:")
  codegen_util::cg_emit_line(out, "  %r_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_results, i64 0, i64 %iprev")
  codegen_util::cg_emit_line(out, "  store i64 %rv, ptr %r_slot, align 8")
  codegen_util::cg_emit_line(out, "  %b_ptr = inttoptr i64 %b_i64 to ptr")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %b_ptr, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "ret_normal:")
  codegen_util::cg_emit_line(out, "  ret i64 %rv")
  codegen_util::cg_emit_line(out, "unhandled:")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_unhandled(ptr %eff, ptr %op)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # B.8 Phase 4b: Scoped-resource throw-safety runtime.
  # B.8 Phase 6.5: TLS slot stores the bound-value SLOT POINTER (not the
  # value itself) so the throw handler observes write-back semantics.
  #
  # Each `with X do v -> body end` against a Scoped impl pushes a TLS
  # ctx entry (self, v_slot_ptr, release_on_throw_fn_ptr) before installing a
  # Throws frame whose handler is `__qz_scoped_throw_handler`. On
  # natural exit the pop runs, the Throws frame uninstalls, and the
  # impl's `release(self, *v_slot_ptr)` fires (Phase 4a). On throw/panic,
  # perform finds our Throws frame, calls our handler — the handler reads
  # the ctx top, decrements `__qz_effect_stack_top` by 1 (skip past our own
  # Throws frame so the rethrow scan finds the next outer one), dereferences
  # v_slot_ptr to read the body's most-recent write to v, invokes the
  # impl's `release_on_throw(self, v, msg)`, then re-performs the throw
  # with the same msg. The recursive perform finds the next outer Throws
  # frame; its handler's longjmp escapes the entire chain. Our handler
  # `unreachable`s after the recursive perform — perform's own post-handler
  # kind=2 longjmp never fires for our frame, so we don't double-pop.
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; === Scoped-resource throw-safety (B.8 Phase 4b) ===")

  # Push (self, v_slot_ptr, rot_fn) onto the Scoped-ctx TLS stack.
  # Phase 6.5: 2nd arg is the bound-value slot's address (i64) — not the
  # value. The throw handler dereferences before calling release_on_throw.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_scoped_ctx_push(i64 %self, i64 %v_slot_ptr, i64 %rot_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sp.top = load i64, ptr @__qz_scoped_ctx_top, align 8")
  codegen_util::cg_emit_line(out, "  %sp.fits = icmp slt i64 %sp.top, 256")
  codegen_util::cg_emit_line(out, "  br i1 %sp.fits, label %do_push, label %skip")
  codegen_util::cg_emit_line(out, "do_push:")
  codegen_util::cg_emit_line(out, "  %sp.self_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_self, i64 0, i64 %sp.top")
  codegen_util::cg_emit_line(out, "  store i64 %self, ptr %sp.self_p, align 8")
  codegen_util::cg_emit_line(out, "  %sp.v_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_v, i64 0, i64 %sp.top")
  codegen_util::cg_emit_line(out, "  store i64 %v_slot_ptr, ptr %sp.v_p, align 8")
  codegen_util::cg_emit_line(out, "  %sp.rot_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_release_on_throw_fn, i64 0, i64 %sp.top")
  codegen_util::cg_emit_line(out, "  store i64 %rot_fn, ptr %sp.rot_p, align 8")
  codegen_util::cg_emit_line(out, "  %sp.top_next = add i64 %sp.top, 1")
  codegen_util::cg_emit_line(out, "  store i64 %sp.top_next, ptr @__qz_scoped_ctx_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %skip")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # Pop one Scoped-ctx entry. No-op when stack empty.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_scoped_ctx_pop() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sx.top = load i64, ptr @__qz_scoped_ctx_top, align 8")
  codegen_util::cg_emit_line(out, "  %sx.nz = icmp sgt i64 %sx.top, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sx.nz, label %do_pop, label %skip")
  codegen_util::cg_emit_line(out, "do_pop:")
  codegen_util::cg_emit_line(out, "  %sx.top_prev = sub i64 %sx.top, 1")
  codegen_util::cg_emit_line(out, "  store i64 %sx.top_prev, ptr @__qz_scoped_ctx_top, align 8")
  codegen_util::cg_emit_line(out, "  br label %skip")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # Generic Throws-handler installed by every Scoped `with`-block. Reads
  # the top Scoped-ctx entry, fires release_on_throw, then re-performs
  # the throw so the rescan finds the next outer Throws handler. Skip-
  # our-own-frame trick: decrement `__qz_effect_stack_top` by 1 BEFORE
  # the recursive perform; the recursive scan starts at top-1, missing
  # our entry. (Our entry is still in the array — the install path's
  # natural-exit uninstall would normally pop it, but we never reach
  # natural exit on this code path; the outer handler's longjmp escapes
  # past our cleanup. The leaked stack slot gets reclaimed by the
  # unwound caller's later install or stays harmlessly above-top.)
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_scoped_throw_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Read msg from argv[0]. Throws.throw is always argc=1.
  codegen_util::cg_emit_line(out, "  %sth.msg = load i64, ptr %argv, align 8")
  # Read top Scoped-ctx entry (self, v_slot_ptr, rot_fn).
  # Phase 6.5: __qz_scoped_ctx_v stores the v slot's address. We
  # dereference it here so the call to release_on_throw sees the body's
  # most-recent write to v (write-back semantics).
  codegen_util::cg_emit_line(out, "  %sth.ctx_top = load i64, ptr @__qz_scoped_ctx_top, align 8")
  codegen_util::cg_emit_line(out, "  %sth.ctx_idx = sub i64 %sth.ctx_top, 1")
  codegen_util::cg_emit_line(out, "  %sth.self_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_self, i64 0, i64 %sth.ctx_idx")
  codegen_util::cg_emit_line(out, "  %sth.self = load i64, ptr %sth.self_p, align 8")
  codegen_util::cg_emit_line(out, "  %sth.v_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_v, i64 0, i64 %sth.ctx_idx")
  codegen_util::cg_emit_line(out, "  %sth.v_slot_i = load i64, ptr %sth.v_p, align 8")
  codegen_util::cg_emit_line(out, "  %sth.v_slot_ptr = inttoptr i64 %sth.v_slot_i to ptr")
  codegen_util::cg_emit_line(out, "  %sth.v = load i64, ptr %sth.v_slot_ptr, align 8")
  codegen_util::cg_emit_line(out, "  %sth.rot_p = getelementptr inbounds [256 x i64], ptr @__qz_scoped_ctx_release_on_throw_fn, i64 0, i64 %sth.ctx_idx")
  codegen_util::cg_emit_line(out, "  %sth.rot = load i64, ptr %sth.rot_p, align 8")
  # Pop our Scoped-ctx so a nested perform inside release_on_throw
  # (or in the recursive Throws scan) doesn't see this entry.
  codegen_util::cg_emit_line(out, "  store i64 %sth.ctx_idx, ptr @__qz_scoped_ctx_top, align 8")
  # Decrement effect stack top by 1 — skip past our own Throws frame so
  # the recursive perform's top-down scan starts at the entry below us.
  codegen_util::cg_emit_line(out, "  %sth.eff_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  %sth.eff_top_next = sub i64 %sth.eff_top, 1")
  codegen_util::cg_emit_line(out, "  store i64 %sth.eff_top_next, ptr @__qz_effect_stack_top, align 8")
  # Call release_on_throw(self, v, msg) via fn pointer.
  codegen_util::cg_emit_line(out, "  %sth.rot_fn = inttoptr i64 %sth.rot to ptr")
  codegen_util::cg_emit_line(out, "  call i64 %sth.rot_fn(i64 %sth.self, i64 %sth.v, i64 %sth.msg)")
  # Re-perform throw — fresh argv buffer, same msg, same kind=2.
  codegen_util::cg_emit_line(out, "  %sth.argv_new = alloca i64, i64 1, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %sth.msg, ptr %sth.argv_new, align 8")
  codegen_util::cg_emit_line(out, "  call i64 @__qz_effect_perform(ptr @__qz_eff_name_throws, ptr @__qz_eff_op_throw, i64 1, ptr %sth.argv_new, i64 2)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # Effects P3.0c-resume: runtime helpers read by `resume(v)` lowering.
  #
  # __qz_effect_get_current_kind: trivial TLS-load helper. Called at
  # each resume site to switch between F.3a semantics (kind<3 → early
  # return from handler) and kind=3 continuation-preserving semantics
  # (invoke stored continuation, stash body_rv, let handler fall through).
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_get_current_kind() nounwind {")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr @__qz_effect_current_kind, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %k")
  codegen_util::cg_emit_line(out, "}")

  # Effects P3.0c-perform: TLS cont_frame writer + reader. Called by the
  # kind=3 MIR_PERFORM_OP emission inside a $poll-lowered caller to
  # stash the caller's frame pointer before calling __qz_effect_perform.
  # __qz_effect_resume_cont (above) reads it at the resume site.
  # Write/restore pair lets the caller save+restore if it needs to
  # preserve the outer frame across a nested perform (single-level
  # nesting is in-scope for P3.0c-perform; multi-level is P3 followup).
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_set_cont_frame(i64 %f) nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 %f, ptr @__qz_effect_current_cont_frame, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_get_cont_frame() nounwind {")
  codegen_util::cg_emit_line(out, "  %f = load i64, ptr @__qz_effect_current_cont_frame, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %f")
  codegen_util::cg_emit_line(out, "}")

  # Read resume(v)'s argument from TLS at a kind=3 perform's post-
  # perform block. __qz_effect_resume_cont writes it there just before
  # invoking the nested $poll that dispatched to the post-perform block.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_get_resume_val() nounwind {")
  codegen_util::cg_emit_line(out, "  %v = load i64, ptr @__qz_effect_current_resume_val, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_resume_cont: kind=3 continuation dispatch. Called only
  # on the kind==3 branch of the resume site. Reads the current-in-
  # flight caller frame from @__qz_effect_current_cont_frame (TLS —
  # written by the kind=3 perform site in a $poll-lowered caller, zero
  # when called from non-$poll code), loads poll_fn from frame[2] (per
  # memo §Q2 — bare frame pointer; $poll layout already puts poll_fn at
  # slot 2), invokes it with the resume value, and stashes the body's
  # return into results[idx] + sets resumed[idx]=1 so the with-block
  # teardown can distinguish "handler resumed → body's return wins"
  # from "handler aborted → handler's return wins" (memo §"Closed
  # summary" row Q6).
  #
  # P3.0c-resume-null-guard: if cont_frame is 0 (caller wasn't $poll-
  # lowered, so no continuation is available), we fall back to F.3a
  # semantics — treat as kind<3 early-return. This makes user code
  # safe even when the classifier has promoted an op to kind=3 but
  # the caller-side MIR emission (P3.0c-perform, next chunk) hasn't
  # yet captured the caller's frame. Once P3.0c-perform wires up the
  # TLS store at kind=3 perform sites in $poll bodies, the guard's
  # null path becomes unreachable for legitimate kind=3 invocations.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_resume_cont(i64 %v) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %cont_i64 = load i64, ptr @__qz_effect_current_cont_frame, align 8")
  codegen_util::cg_emit_line(out, "  %is_null = icmp eq i64 %cont_i64, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_null, label %nocont, label %docont")
  codegen_util::cg_emit_line(out, "nocont:")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "docont:")
  # Stash the resume value into TLS so the post-perform block of the
  # NESTED $poll invocation can pick it up. $poll's ABI is single-arg
  # (ptr self); threading v through a 2nd param would widen that ABI
  # across every async function. TLS keeps the change local to resume.
  codegen_util::cg_emit_line(out, "  store i64 %v, ptr @__qz_effect_current_resume_val, align 8")
  codegen_util::cg_emit_line(out, "  %idx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %cont = inttoptr i64 %cont_i64 to ptr")
  codegen_util::cg_emit_line(out, "  %poll_slot = getelementptr inbounds i64, ptr %cont, i64 2")
  codegen_util::cg_emit_line(out, "  %poll_i64 = load i64, ptr %poll_slot, align 8")
  codegen_util::cg_emit_line(out, "  %poll = inttoptr i64 %poll_i64 to ptr")
  # Nested poll invocation. Returns POLL_READY (1) or similar — we
  # ignore the poll discriminant here; body's actual return value is
  # written to frame[1] by the body-end path of the nested invocation.
  codegen_util::cg_emit_line(out, "  %unused_poll_rc = call i64 %poll(ptr %cont)")
  codegen_util::cg_emit_line(out, "  %body_slot = getelementptr inbounds i64, ptr %cont, i64 1")
  codegen_util::cg_emit_line(out, "  %body_rv = load i64, ptr %body_slot, align 8")
  codegen_util::cg_emit_line(out, "  %r_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_results, i64 0, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 %body_rv, ptr %r_slot, align 8")
  codegen_util::cg_emit_line(out, "  %rf_slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_resumed, i64 0, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %rf_slot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %body_rv")
  codegen_util::cg_emit_line(out, "}")

  # Effects P3.E-runtime + P4.B.3 POLL_SUSPENDED: park-rv sentinel helpers.
  #
  # The kind=3 perform site's `ret` picks up whatever's in the TLS slot
  # @__qz_effect_park_rv. Sentinel values:
  #
  #   |  value      | meaning                | set by              |
  #   |-------------|------------------------|---------------------|
  #   |  1          | POLL_READY (default)   | park_reset()        |
  #   |  0          | POLL_SUSPENDED (P4.B.3)| __qz_effect_suspend |
  #   |  -1         | yield-park (fd = -1)   | __qz_effect_park(-1)|
  #   |  ≤ -2       | park on fd = -(v+2)    | __qz_effect_park(fd)|
  #
  # POLL_READY: handler resumed synchronously via resume(v). Outer $poll
  # nested-invocation ran body to end; body_rv is in frame[1]; state=-1.
  # Returning 1 tells scheduler task is done.
  #
  # POLL_SUSPENDED (P4.B.3): handler stashed a value elsewhere (e.g., into
  # a generator's outgoing slot) and wants the outer $poll frame to park
  # at the post-perform state. Scheduler sees 0 (not < -1) and reenqueues
  # via the task_yield branch; consumer-driven callers read the outgoing
  # slot and re-invoke $poll. Body hasn't been re-entered yet — next poll
  # dispatches via state switch to resume_block.
  #
  # Park (≤-1): handler called __qz_effect_park(fd) to register the task
  # with a scheduler wake source. Worker's task_io_real decodes the fd
  # and registers via kqueue / timer / proc-wait.
  #
  # park_reset() is called before every kind=3 perform — resets TLS to
  # POLL_READY so a handler that didn't call park/suspend doesn't inherit
  # stale state from a prior perform.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_park_reset() nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_effect_park_rv, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_park(i64 %fd) nounwind {")
  codegen_util::cg_emit_line(out, "  %neg2 = sub i64 -2, %fd")
  codegen_util::cg_emit_line(out, "  store i64 %neg2, ptr @__qz_effect_park_rv, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_park_get_rv() nounwind {")
  codegen_util::cg_emit_line(out, "  %v = load i64, ptr @__qz_effect_park_rv, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "}")
  # Effects P4.B.3: POLL_SUSPENDED sentinel setter. Handler calls this to
  # park the outer $poll frame at post-perform state without scheduler
  # fd/timer registration. Outer poll returns 0; next poll re-enters via
  # the state-machine switch at the resume block. Consumer-driven code
  # (e.g. Stream.next in 4.B.4) reads this as "value produced, frame
  # ready for another drive"; scheduler-driven code reenqueues via the
  # task_yield branch (poll_result >= -1 → do_yield path).
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_suspend() nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_effect_park_rv, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # Effects 4.B.4.c: Stream<T>.next() yield-capture helpers.
  #
  # `__qz_gen_stash(v)` writes v into @__qz_gen_stashed_val (TLS). Called
  # from __qz_gen_yield_capture (std/gen.qz) on each `yield v` inside a
  # generator body driven by Stream.next().
  #
  # `__qz_gen_take_stashed()` reads and returns the stashed value. Called
  # from Stream.next() after the `with Yield ... do -> step(frame) end`
  # expression evaluates to POLL_SUSPENDED(0).
  #
  # `__qz_effect_argv_load(argv, i)` — loads argv[i] (i64) from the
  # effect-op argument array the runtime passes to handlers. Effect ABI
  # since Milestone E(post) is `(ptr op, i64 argc, ptr argv)`; std/gen's
  # handler receives `argv` as `Int` and needs the i-th i64 out of it.
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_gen_stash(i64 %v) nounwind {")
  codegen_util::cg_emit_line(out, "  store i64 %v, ptr @__qz_gen_stashed_val, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_gen_take_stashed() nounwind {")
  codegen_util::cg_emit_line(out, "  %v = load i64, ptr @__qz_gen_stashed_val, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_argv_load(i64 %argv, i64 %i) nounwind {")
  codegen_util::cg_emit_line(out, "  %p = inttoptr i64 %argv to ptr")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr inbounds i64, ptr %p, i64 %i")
  codegen_util::cg_emit_line(out, "  %v = load i64, ptr %slot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "}")

  # Phase 2 P2.a: stateful-effect runtime helpers.
  #
  # __qz_effect_state_get: read the state cell for the currently-dispatching
  # handler. Reads @__qz_effect_current_install_idx (TLS, set by perform
  # before dispatch) and returns state_slots[idx]. Called by
  # __qz_default_state_handler for the "get" op, and by user-written State
  # handlers that cooperate with the default evidence-slot machinery.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_state_get() nounwind {")
  codegen_util::cg_emit_line(out, "  %idx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %idx")
  codegen_util::cg_emit_line(out, "  %v = load i64, ptr %slot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %v")
  codegen_util::cg_emit_line(out, "}")

  # __qz_effect_state_set: write the state cell for the currently-dispatching
  # handler. Matches the get helper's index-resolution pattern. Returns 0
  # (set is Int-returning by effect-decl convention, value is ignored).
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_effect_state_set(i64 %v) nounwind {")
  codegen_util::cg_emit_line(out, "  %idx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 %v, ptr %slot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # __qz_default_state_handler: the default handler installed by
  # `with State(v) do ... end` (call-form shorthand). Matches the standard
  # handler ABI `(ptr op, i64 argc, ptr argv): i64`. Dispatches on op
  # name:
  #   get → state_slots[current_install_idx]
  #   set → store argv[0] into state_slots[current_install_idx], return 0
  # Unknown op: return 0 (benign; real state effects won't hit this).
  # State effects ARE NOT in the blessed prelude-install set — a get/set
  # outside a `with State(...)` block routes to unhandled via the standard
  # scan, which is the correct semantics (the effect is required but
  # absent from the handler stack).
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_state_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_get = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_get)")
  codegen_util::cg_emit_line(out, "  br i1 %is_get, label %do_get, label %try_set")
  codegen_util::cg_emit_line(out, "try_set:")
  codegen_util::cg_emit_line(out, "  %is_set = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_set)")
  codegen_util::cg_emit_line(out, "  br i1 %is_set, label %do_set, label %do_stub_st")
  codegen_util::cg_emit_line(out, "do_get:")
  codegen_util::cg_emit_line(out, "  %gidx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %gslot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %gidx")
  codegen_util::cg_emit_line(out, "  %gv = load i64, ptr %gslot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %gv")
  codegen_util::cg_emit_line(out, "do_set:")
  codegen_util::cg_emit_line(out, "  %newv = load i64, ptr %argv, align 8")
  codegen_util::cg_emit_line(out, "  %sidx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %sslot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %sidx")
  codegen_util::cg_emit_line(out, "  store i64 %newv, ptr %sslot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "do_stub_st:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # Phase 2 P2.b: __qz_default_reader_handler. Same ABI as State; only op
  # is "ask" which returns slots[current_install_idx]. Writes are not
  # supported (Reader is read-only ambient). Unknown op → 0.
  codegen_util::cg_emit_line(out, "#{prefix}i64 @__qz_default_reader_handler(ptr %op, i64 %argc, ptr %argv) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_ask = call i1 @__qz_effect_cstr_eq(ptr %op, ptr @__qz_eff_op_ask)")
  codegen_util::cg_emit_line(out, "  br i1 %is_ask, label %do_ask, label %do_stub_rd")
  codegen_util::cg_emit_line(out, "do_ask:")
  codegen_util::cg_emit_line(out, "  %aidx = load i64, ptr @__qz_effect_current_install_idx, align 8")
  codegen_util::cg_emit_line(out, "  %aslot = getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_state_slots, i64 0, i64 %aidx")
  codegen_util::cg_emit_line(out, "  %av = load i64, ptr %aslot, align 8")
  codegen_util::cg_emit_line(out, "  ret i64 %av")
  codegen_util::cg_emit_line(out, "do_stub_rd:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")

  # Phase E.1.c (2026-04-28): emit `@__qz_effect_install_defaults` — the
  # per-thread blessed-default install + watermark capture function. Called
  # once from the main wrapper AND once per scheduler worker thread at
  # __qz_sched_worker entry. With every effect-stack array now TLS, each
  # thread needs its own install of the blessed defaults to avoid scan
  # misses + watermark mismatches.
  cg_emit_effect_install_defaults_fn(out, linkonce, uses_intern, uses_cache, uses_profile, uses_yield)
end

## Emit the effect runtime's main-wrapper prelude: call __qz_effect_init
## + register default handlers for blessed effects.
##
## Effects runtime, Phase 1 D.4 — main-prelude default-handler install.
##
## Hooked into the `@main` wrapper after argv/argc setup but BEFORE
## calling `@qz_main`. This guarantees every user program has a
## well-defined behavior for unhandled ops: Throws writes "default
## throws fired" + exits 66; Log writes "default log fired" + returns
## 0 (non-fatal, execution continues). Callers (user `with` blocks)
## override by push/pop on the same handler stack — top-down lookup
## finds user handler first.
##
## D.4 deliberately keeps the set of blessed effects small (Throws +
## Log). Extending to more (Clock, Random, IO) is D.7 stdlib work.
##
## Note: Milestone H's dispatch-shim synthesis was removed in H-delegate
## (per-op install puts runtime routing in @__qz_effect_perform's scan,
## not in a per-with-block function). No codegen hook needed at module
## level for effect dispatch beyond the runtime helpers.
## Phase E.1.c (2026-04-28): emits the inline call into `__qz_effect_install_defaults`,
## the per-thread blessed-default install + watermark capture function. The body lives
## in the function emitted by `cg_emit_effect_install_defaults_fn`, which gates Intern
## install on uses_intern at compile time. Same call site shape works in main wrapper
## and __qz_sched_worker entry — TLS stack arrays mean each thread has its own view.
def cg_emit_effect_main_prelude(out: Int, uses_intern: Int, uses_cache: Int, uses_profile: Int): Void
  codegen_util::cg_emit_line(out, "  ; effect runtime D.4 / P3.B / E.1.c: initialize + register default handlers (per-thread)")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_install_defaults()")
end

## Phase E.1.c (2026-04-28): emit the per-thread blessed-default install + watermark
## capture as a callable function `@__qz_effect_install_defaults`. Called once from the
## main wrapper (cg_emit_effect_main_prelude) AND once from each scheduler worker's
## entry block (see __qz_sched_worker emission in cg_emit_runtime_decls). Each thread
## has its own TLS view of stack_top/_names/_handlers/_op_filters/watermark, so
## re-running this in every worker is correct + necessary — without it, workers see
## top=0 / empty arrays / watermark=0 and any user `with E {...}` from inside a task
## body lands at the wrong scan position relative to the missing blessed defaults.
## Body is essentially the pre-E.1.c inline install code from cg_emit_effect_main_prelude.
def cg_emit_effect_install_defaults_fn(out: Int, linkonce: Int, uses_intern: Int, uses_cache: Int, uses_profile: Int, uses_yield: Int): Void
  var prefix = "define "
  if linkonce == 1
    prefix = "define linkonce_odr "
  end
  codegen_util::cg_emit_line(out, "#{prefix}void @__qz_effect_install_defaults() nounwind {")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_init()")
  codegen_util::cg_emit_line(out, "  %eff_throws_ptr = ptrtoint ptr @__qz_default_throws_handler to i64")
  # F.3b: default handlers install with buf=0 (no unwind). Throws' default
  # calls exit() so unwind would be moot; Log's default returns normally.
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_throws, i64 %eff_throws_ptr, i64 0, ptr null)")
  codegen_util::cg_emit_line(out, "  %eff_log_ptr = ptrtoint ptr @__qz_default_log_handler to i64")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_log, i64 %eff_log_ptr, i64 0, ptr null)")
  # P3.B: Async default handler. Installed with op_filter=null (catches
  # any Async op). User-installed `with Async { op: h } do ... end`
  # handlers push above this on the stack, so the topmost match wins
  # per the standard H-delegate scan logic.
  codegen_util::cg_emit_line(out, "  %eff_async_ptr = ptrtoint ptr @__qz_default_async_handler to i64")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_async, i64 %eff_async_ptr, i64 0, ptr null)")
  # P5.4.e: FileIo default handler.
  codegen_util::cg_emit_line(out, "  %eff_fio_ptr = ptrtoint ptr @__qz_default_fileio_handler to i64")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_file_io, i64 %eff_fio_ptr, i64 0, ptr null)")
  # A.3.a: Alloc default handler.
  codegen_util::cg_emit_line(out, "  %eff_alloc_ptr = ptrtoint ptr @__qz_default_alloc_handler to i64")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_alloc, i64 %eff_alloc_ptr, i64 0, ptr null)")
  # A.8: Random default handler — installed unconditionally, no
  # `uses_random` gate. Body is inline IR forwarding to qz_rand_seed /
  # qz_rand_int / qz_rand_range / qz_crypto_rand_int (already emitted
  # by cg_emit_runtime_helpers_2). Same shape as FileIo / Alloc.
  codegen_util::cg_emit_line(out, "  %eff_random_ptr = ptrtoint ptr @__qz_default_random_handler to i64")
  codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_random, i64 %eff_random_ptr, i64 0, ptr null)")
  # P5.5.c: Intern default handler — gated on uses_intern (compile-time flag).
  # The handler is a Quartz function (`@intern$intern_default_handler` in
  # std/intern.qz), so installing unconditionally would force every program
  # to link std/intern. The `uses_intern` flag from MIR is exactly "does
  # this compile use Intern at all"; gate the install on it.
  if uses_intern == 1
    codegen_util::cg_emit_line(out, "  %eff_intern_ptr = ptrtoint ptr @intern$intern_default_handler to i64")
    codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_intern, i64 %eff_intern_ptr, i64 0, ptr null)")
  end
  # A.3 (Pass 1): Cache default handler — gated on uses_cache. Same
  # rationale as Intern: the handler is `@cache$cache_default_handler`,
  # a Quartz function that pulls in build_cache + dep_graph + content_hash
  # + their transitive closure. Programs that never call cache_op_*
  # shouldn't pay that link cost.
  if uses_cache == 1
    codegen_util::cg_emit_line(out, "  %eff_cache_ptr = ptrtoint ptr @cache$cache_default_handler to i64")
    codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_cache, i64 %eff_cache_ptr, i64 0, ptr null)")
  end
  # A.6 (Pass 1): Profile default handler — gated on uses_profile. Same
  # rationale as Cache: the handler is `@profile$profile_default_handler`,
  # a Quartz function that reads RSS + emits to stderr. Programs that
  # never call prof_* shouldn't pay the link cost.
  if uses_profile == 1
    codegen_util::cg_emit_line(out, "  %eff_profile_ptr = ptrtoint ptr @profile$profile_default_handler to i64")
    codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_profile, i64 %eff_profile_ptr, i64 0, ptr null)")
  end
  # 4.B.7.b (item 9): Yield default handler — gated on uses_yield. The
  # handler is `@__qz_gen_yield_capture`, a Quartz function (std/gen.qz),
  # so installing unconditionally forced EVERY program to reference it —
  # a dangling symbol if the prelude-pull ever fails to materialize it
  # (the latent landmine). Same rationale + shape as Intern/Cache/Profile:
  # gate the install on the compile-time "does this program use Yield" flag.
  if uses_yield == 1
    codegen_util::cg_emit_line(out, "  %eff_yield_ptr = ptrtoint ptr @__qz_gen_yield_capture to i64")
    codegen_util::cg_emit_line(out, "  call void @__qz_effect_handle_install(ptr @__qz_eff_name_yield, i64 %eff_yield_ptr, i64 0, ptr null)")
  end
  # A.4 + E.1.c: capture the post-prelude effect-stack height as the
  # blessed-handler watermark for THIS thread (TLS). The Alloc wrapper's
  # routing-on fast-path checks `top <= bw` to detect "no user `with
  # Alloc {...}` is on top of the blessed defaults" and skip perform.
  codegen_util::cg_emit_line(out, "  %bw_top = load i64, ptr @__qz_effect_stack_top, align 8")
  codegen_util::cg_emit_line(out, "  store i64 %bw_top, ptr @__qz_alloc_blessed_watermark, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
end

## Emit minimal freestanding stubs for the panic + backtrace helpers.
##
## Hosted builds emit libc-backed versions of `qz_overflow_panic`,
## `qz_bounds_panic`, `qz_map_key_panic`, `qz_print_backtrace` that call
## `@write` / `@sprintf` / `@longjmp` / `@abort` / `@__qz_panic_jmpbuf_get` /
## `@backtrace` / `@backtrace_symbols_fd`. Freestanding / kernel builds
## don't have those symbols — `cg_emit_runtime_decls` early-returns for
## freestanding targets and never declares them.
##
## For freestanding we emit stubs with matching ABIs but empty bodies
## (`unreachable` for `noreturn` helpers, `ret void` for the backtrace
## one). LLC accepts this; the caller's branch to the helper becomes a
## branch to `unreachable`, which LLVM's optimizer treats as "this path
## cannot happen" — equivalent to a CPU trap for bounds violations.
##
## A proper implementation would route these through `@panic_handler`
## (if registered) — that's a follow-up tracked in KERNEL_EPIC.md. The
## stub form is sufficient to unblock freestanding ELF linking TODAY.
def cg_emit_freestanding_panic_stubs(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Freestanding panic stubs (no libc — unreachable-only)")
  var linkage_prefix = "define "
  if linkonce == 1
    linkage_prefix = "define linkonce_odr "
  end

  # Overflow panic: takes no args, noreturn.
  codegen_util::cg_emit_line(out, "#{linkage_prefix}void @qz_overflow_panic() noreturn nounwind {")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # Bounds panic: (i64 %index, i64 %size), noreturn.
  codegen_util::cg_emit_line(out, "#{linkage_prefix}void @qz_bounds_panic(i64 %index, i64 %size) noreturn nounwind {")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # Map key panic: (ptr %key), noreturn.
  codegen_util::cg_emit_line(out, "#{linkage_prefix}void @qz_map_key_panic(ptr %key) noreturn nounwind {")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")

  # Backtrace: no-op for freestanding (no stack-walking primitives).
  codegen_util::cg_emit_line(out, "#{linkage_prefix}void @qz_print_backtrace() nounwind {")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")

  # @abort stub: several intrinsic handlers (unwrap, unwrap_ok, unreachable,
  # assert, panic) inline `call void @abort()` in their panic paths as a
  # shortcut — they don't route through qz_bounds_panic / qz_overflow_panic
  # / the @panic_handler. For freestanding the stub must exist; we lower
  # abort to a noreturn unreachable. A kernel-aware follow-up would swap
  # this for the user's @panic_handler (tracked in KERNEL_EPIC Discoveries).
  codegen_util::cg_emit_line(out, "#{linkage_prefix}void @abort() noreturn nounwind {")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
end

## Emit overflow panic helper function.
def cg_emit_overflow_panic_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Overflow panic helper")
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@.overflow_msg = linkonce_odr unnamed_addr constant [18 x i8] c\"integer overflow\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_overflow_panic() noreturn nounwind {")
  else
    codegen_util::cg_emit_line(out, "@.overflow_msg = private unnamed_addr constant [18 x i8] c\"integer overflow\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define void @qz_overflow_panic() noreturn nounwind {")
  end
  codegen_util::cg_emit_line(out, "  %msg = getelementptr [18 x i8], [18 x i8]* @.overflow_msg, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fd = call i64 @write(i32 2, ptr %msg, i64 17)")
  # Check per-thread jmpbuf: if set, longjmp instead of abort (panic capture for spawned tasks)
  codegen_util::cg_emit_line(out, "  %jb = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %has_jb = icmp ne ptr %jb, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_jb, label %do_longjmp, label %do_abort")
  codegen_util::cg_emit_line(out, "do_longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %jb, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "do_abort:")
  codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
  codegen_util::cg_emit_line(out, "  call void @abort()")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
end

## Emit the dynamic-exclusivity runtime (QZ0410). Gated by `--exclusivity-check`
## at the caller — this is only reached when `exclusivity_check == 1`, so with
## the flag OFF none of these symbols appear and IR is byte-identical to today.
##
## Emits three things:
##   1. `qz_exclusivity_panic(ptr addr, ptr prev_loc, ptr cur_loc)` — the QZ0410
##      trap. Mirrors `cg_emit_overflow_panic_helper` byte-for-byte (jmpbuf-aware
##      longjmp for spawned-task capture, else backtrace + abort).
##   2. `qz_begin_access(ptr addr, i64 kind, ptr loc, ptr rec)` — pushes an access
##      record onto the per-thread intrusive list `__qz_access_head`, after walking
##      the list for a conflicting live access (base-pointer overlap where at least
##      one side is a modify). On conflict → `qz_exclusivity_panic` (noreturn).
##   3. `qz_end_access(ptr rec)` — pops (LIFO; the static non-escape rule guarantees
##      brackets nest lexically, §1 of the dynamic-migration design).
##
## The per-thread head pointer `__qz_access_head` (get/set) is emitted separately by
## `cg_emit_access_head_tls`, which owns the pthread-key vs WASI split. `linkonce`
## selects private vs linkonce_odr directly here (and in cg_emit_access_head_tls),
## so separate-compilation per-module emission is linker-deduped. Both are emitted
## from the panic-helper sites under the same `exclusivity_check == 1` gate.
##
## Access record layout (32 bytes, alloca'd by the caller):
##   [ptr addr @0, i64 kind @8, ptr loc @16, ptr prev @24]
def cg_emit_exclusivity_panic_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Dynamic exclusivity runtime (QZ0410) — emitted only under --exclusivity-check")
  # QZ0410 message constant + noreturn trap. 78-byte payload incl trailing \0A\00.
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@.exclusivity_msg = linkonce_odr unnamed_addr constant [78 x i8] c\"exclusivity violation: overlapping accesses, modification requires exclusive\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_exclusivity_panic(ptr %addr, ptr %prev_loc, ptr %cur_loc) noreturn nounwind {")
  else
    codegen_util::cg_emit_line(out, "@.exclusivity_msg = private unnamed_addr constant [78 x i8] c\"exclusivity violation: overlapping accesses, modification requires exclusive\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define void @qz_exclusivity_panic(ptr %addr, ptr %prev_loc, ptr %cur_loc) noreturn nounwind {")
  end
  codegen_util::cg_emit_line(out, "  %msg = getelementptr [78 x i8], [78 x i8]* @.exclusivity_msg, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fd = call i64 @write(i32 2, ptr %msg, i64 77)")
  # jmpbuf-aware tail (identical skeleton to cg_emit_overflow_panic_helper)
  codegen_util::cg_emit_line(out, "  %jb = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %has_jb = icmp ne ptr %jb, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_jb, label %do_longjmp, label %do_abort")
  codegen_util::cg_emit_line(out, "do_longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %jb, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "do_abort:")
  codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
  codegen_util::cg_emit_line(out, "  call void @abort()")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  # qz_begin_access(addr, kind, loc, rec): walk the list, trap on conflict, push.
  if linkonce == 1
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_begin_access(ptr %addr, i64 %kind, ptr %loc, ptr %rec) nounwind {")
  else
    codegen_util::cg_emit_line(out, "define void @qz_begin_access(ptr %addr, i64 %kind, ptr %loc, ptr %rec) nounwind {")
  end
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %head0 = call ptr @__qz_access_head_get()")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %cur = phi ptr [ %head0, %entry ], [ %next, %cont ]")
  codegen_util::cg_emit_line(out, "  %at_end = icmp eq ptr %cur, null")
  codegen_util::cg_emit_line(out, "  br i1 %at_end, label %push, label %check")
  codegen_util::cg_emit_line(out, "check:")
  # n->addr at offset 0
  codegen_util::cg_emit_line(out, "  %n_addr = load ptr, ptr %cur")
  codegen_util::cg_emit_line(out, "  %same = icmp eq ptr %n_addr, %addr")
  codegen_util::cg_emit_line(out, "  br i1 %same, label %kindchk, label %cont")
  codegen_util::cg_emit_line(out, "kindchk:")
  # n->kind at offset 8; conflict iff (n->kind | kind) != 0  (at least one modify)
  codegen_util::cg_emit_line(out, "  %n_kind_ptr = getelementptr i8, ptr %cur, i64 8")
  codegen_util::cg_emit_line(out, "  %n_kind = load i64, ptr %n_kind_ptr")
  codegen_util::cg_emit_line(out, "  %or_kind = or i64 %n_kind, %kind")
  codegen_util::cg_emit_line(out, "  %is_modify = icmp ne i64 %or_kind, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_modify, label %trap, label %cont")
  codegen_util::cg_emit_line(out, "trap:")
  # n->loc at offset 16
  codegen_util::cg_emit_line(out, "  %n_loc_ptr = getelementptr i8, ptr %cur, i64 16")
  codegen_util::cg_emit_line(out, "  %n_loc = load ptr, ptr %n_loc_ptr")
  codegen_util::cg_emit_line(out, "  call void @qz_exclusivity_panic(ptr %addr, ptr %n_loc, ptr %loc)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "cont:")
  # advance: next = cur->prev at offset 24
  codegen_util::cg_emit_line(out, "  %n_prev_ptr = getelementptr i8, ptr %cur, i64 24")
  codegen_util::cg_emit_line(out, "  %next = load ptr, ptr %n_prev_ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "push:")
  # rec->addr = addr; rec->kind = kind; rec->loc = loc; rec->prev = head0
  codegen_util::cg_emit_line(out, "  store ptr %addr, ptr %rec")
  codegen_util::cg_emit_line(out, "  %r_kind_ptr = getelementptr i8, ptr %rec, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 %kind, ptr %r_kind_ptr")
  codegen_util::cg_emit_line(out, "  %r_loc_ptr = getelementptr i8, ptr %rec, i64 16")
  codegen_util::cg_emit_line(out, "  store ptr %loc, ptr %r_loc_ptr")
  codegen_util::cg_emit_line(out, "  %r_prev_ptr = getelementptr i8, ptr %rec, i64 24")
  codegen_util::cg_emit_line(out, "  store ptr %head0, ptr %r_prev_ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_access_head_set(ptr %rec)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  # qz_end_access(rec): head = rec->prev  (LIFO pop)
  if linkonce == 1
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_end_access(ptr %rec) nounwind {")
  else
    codegen_util::cg_emit_line(out, "define void @qz_end_access(ptr %rec) nounwind {")
  end
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %prev_ptr = getelementptr i8, ptr %rec, i64 24")
  codegen_util::cg_emit_line(out, "  %prev = load ptr, ptr %prev_ptr")
  codegen_util::cg_emit_line(out, "  call void @__qz_access_head_set(ptr %prev)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
end

## Emit the per-thread `__qz_access_head` intrusive-list TLS (get/set), mirroring
## the panic-jmpbuf TLS (`@__qz_panic_key` / `__qz_panic_jmpbuf_get` / `_set`).
## Native uses a pthread_key_t; WASI (single-threaded) uses a plain global.
## Emitted only under --exclusivity-check (caller-gated). `linkonce` selects
## `linkonce_odr` linkage for the globals + get/set defs so separate-compilation
## per-module emission is linker-deduped (this pathway is entirely inside the
## flag gate, so a default build never sees any of it).
def cg_emit_access_head_tls(out: Int, target: String, linkonce: Int): Void
  var glob_prefix = "global"
  var def_prefix = "define"
  if linkonce == 1
    glob_prefix = "linkonce_odr global"
    def_prefix = "define linkonce_odr"
  end
  codegen_util::cg_emit_line(out, "")
  if cg_is_wasi(target) == 0
    # Native: pthread_key_t (parallels @__qz_panic_key at codegen_runtime.qz:4343)
    codegen_util::cg_emit_line(out, "; exclusivity: per-thread access-list head via pthread_key (null = empty list)")
    codegen_util::cg_emit_line(out, "@__qz_access_key = #{glob_prefix} i64 0")
    codegen_util::cg_emit_line(out, "@__qz_access_key_once = #{glob_prefix} i64 0")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "#{def_prefix} void @__qz_access_key_ensure() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %cas = cmpxchg ptr @__qz_access_key_once, i64 0, i64 1 acq_rel monotonic")
    codegen_util::cg_emit_line(out, "  %won = extractvalue { i64, i1 } %cas, 1")
    codegen_util::cg_emit_line(out, "  br i1 %won, label %do_init, label %done")
    codegen_util::cg_emit_line(out, "do_init:")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_key_create(ptr @__qz_access_key, void(ptr)* null)")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "done:")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "#{def_prefix} ptr @__qz_access_head_get() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  call void @__qz_access_key_ensure()")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_access_key")
    codegen_util::cg_emit_line(out, "  %val = call ptr @pthread_getspecific(i64 %key)")
    codegen_util::cg_emit_line(out, "  ret ptr %val")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "#{def_prefix} void @__qz_access_head_set(ptr %val) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  call void @__qz_access_key_ensure()")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_access_key")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_setspecific(i64 %key, ptr %val)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
    # WASI: single-threaded, plain global (parallels @__qz_panic_jmpbuf_wasi)
    codegen_util::cg_emit_line(out, "; exclusivity: single-threaded access-list head (WASI)")
    codegen_util::cg_emit_line(out, "@__qz_access_head_wasi = #{glob_prefix} ptr null")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "#{def_prefix} ptr @__qz_access_head_get() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %val = load ptr, ptr @__qz_access_head_wasi")
    codegen_util::cg_emit_line(out, "  ret ptr %val")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "#{def_prefix} void @__qz_access_head_set(ptr %val) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  store ptr %val, ptr @__qz_access_head_wasi")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end
end

## Emit async-lock drain panic helper. Called from `async_mutex_free` /
## `async_rwlock_free` when the lock's wait list is non-empty at free
## time — indicates a programmer UAF (freeing a lock that still has
## parked tasks). Aborts with a diagnostic message before the wait
## nodes get clobbered. The bounds_panic / overflow_panic pattern is
## mirrored exactly (jmpbuf-aware for spawned-task panic capture).
def cg_emit_async_lock_drain_panic_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Async-lock drain panic helper")
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@.async_lock_drain_msg = linkonce_odr unnamed_addr constant [59 x i8] c\"async lock freed while wait list non-empty (UAF imminent)\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_async_lock_drain_panic() noreturn nounwind {")
  else
    codegen_util::cg_emit_line(out, "@.async_lock_drain_msg = private unnamed_addr constant [59 x i8] c\"async lock freed while wait list non-empty (UAF imminent)\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define void @qz_async_lock_drain_panic() noreturn nounwind {")
  end
  codegen_util::cg_emit_line(out, "  %msg = getelementptr [59 x i8], [59 x i8]* @.async_lock_drain_msg, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fd = call i64 @write(i32 2, ptr %msg, i64 58)")
  codegen_util::cg_emit_line(out, "  %jb = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %has_jb = icmp ne ptr %jb, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_jb, label %do_longjmp, label %do_abort")
  codegen_util::cg_emit_line(out, "do_longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %jb, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "do_abort:")
  codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
  codegen_util::cg_emit_line(out, "  call void @abort()")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
end

## Emit bounds check panic helper function.
def cg_emit_bounds_panic_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Bounds check panic helper")
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@.bounds_fmt = linkonce_odr unnamed_addr constant [42 x i8] c\"index out of bounds: index %ld, size %ld\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_bounds_panic(i64 %index, i64 %size) noreturn nounwind {")
  else
    codegen_util::cg_emit_line(out, "@.bounds_fmt = private unnamed_addr constant [42 x i8] c\"index out of bounds: index %ld, size %ld\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define void @qz_bounds_panic(i64 %index, i64 %size) noreturn nounwind {")
  end
  codegen_util::cg_emit_line(out, "  %buf = alloca [128 x i8]")
  codegen_util::cg_emit_line(out, "  %ptr = getelementptr [128 x i8], [128 x i8]* %buf, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fmt = getelementptr [42 x i8], [42 x i8]* @.bounds_fmt, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %len.i32 = call i32 (ptr, ptr, ...) @sprintf(ptr %ptr, ptr %fmt, i64 %index, i64 %size)")
  codegen_util::cg_emit_line(out, "  %len = sext i32 %len.i32 to i64")
  codegen_util::cg_emit_line(out, "  %wr = call i64 @write(i32 2, ptr %ptr, i64 %len)")
  # Check per-thread jmpbuf: if set, longjmp instead of abort (panic capture for spawned tasks)
  codegen_util::cg_emit_line(out, "  %jb = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %has_jb = icmp ne ptr %jb, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_jb, label %do_longjmp, label %do_abort")
  codegen_util::cg_emit_line(out, "do_longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %jb, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "do_abort:")
  codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
  codegen_util::cg_emit_line(out, "  call void @abort()")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
end

## Emit map key-not-found panic helper function.
def cg_emit_map_key_panic_helper(out: Int, linkonce: Int): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Map key-not-found panic helper")
  if linkonce == 1
    codegen_util::cg_emit_line(out, "@.map_key_fmt = linkonce_odr unnamed_addr constant [19 x i8] c\"key not found: %s\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_map_key_panic(ptr %key) noreturn nounwind {")
  else
    codegen_util::cg_emit_line(out, "@.map_key_fmt = private unnamed_addr constant [19 x i8] c\"key not found: %s\\0A\\00\"")
    codegen_util::cg_emit_line(out, "define void @qz_map_key_panic(ptr %key) noreturn nounwind {")
  end
  codegen_util::cg_emit_line(out, "  %buf = alloca [256 x i8]")
  codegen_util::cg_emit_line(out, "  %ptr = getelementptr [256 x i8], [256 x i8]* %buf, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %fmt = getelementptr [19 x i8], [19 x i8]* @.map_key_fmt, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %len.i32 = call i32 (ptr, ptr, ...) @sprintf(ptr %ptr, ptr %fmt, ptr %key)")
  codegen_util::cg_emit_line(out, "  %len = sext i32 %len.i32 to i64")
  codegen_util::cg_emit_line(out, "  %wr = call i64 @write(i32 2, ptr %ptr, i64 %len)")
  codegen_util::cg_emit_line(out, "  %jb = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %has_jb = icmp ne ptr %jb, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_jb, label %do_longjmp, label %do_abort")
  codegen_util::cg_emit_line(out, "do_longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %jb, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "do_abort:")
  codegen_util::cg_emit_line(out, "  call void @qz_print_backtrace()")
  codegen_util::cg_emit_line(out, "  call void @abort()")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
end

## Emit backtrace helper function.
## On macOS/glibc: uses backtrace() + backtrace_symbols_fd().
## On musl/Alpine: no-op stub (backtrace not available).
## On Windows: RtlCaptureStackBackTrace (exported by kernel32 / re-exported
## from ntdll) + a hex-only fprintf loop to stderr. Names are not resolved
## — eli (or any consumer) can decode with `addr2line` / `llvm-symbolizer`
## against the .exe. dbghelp's SymFromAddr would symbolicate inline but
## SYMBOL_INFO is a variable-length struct and dragging in dbghelp.dll
## doubles the link surface; addresses are enough for "where did we crash".
def cg_emit_backtrace_helper(out: Int, linkonce: Int, target: String): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; Backtrace helper for panic stack traces")
  if cg_is_windows(target)
    # RtlCaptureStackBackTrace(FramesToSkip, FramesToCapture, BackTrace, Hash).
    # Returns WORD (i16) — the number of frames actually captured. Kernel32
    # re-exports it; no extra -l. We print one line per frame to stderr via
    # fprintf with the canonical "  0x%llx\n" — pointer-as-i64 keeps the IR
    # portable across x86_64 and aarch64 Windows.
    codegen_util::cg_emit_line(out, "declare i16 @RtlCaptureStackBackTrace(i32, i32, ptr, ptr) nounwind")
    codegen_util::cg_emit_line(out, "@.bt_fmt_win = private unnamed_addr constant [10 x i8] c\"  0x%llx\\0A\\00\"")
    if linkonce == 1
      codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_print_backtrace() nounwind {")
    else
      codegen_util::cg_emit_line(out, "define void @qz_print_backtrace() nounwind {")
    end
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %buf = alloca [64 x ptr]")
    codegen_util::cg_emit_line(out, "  %ptr = bitcast [64 x ptr]* %buf to ptr")
    codegen_util::cg_emit_line(out, "  %n16 = call i16 @RtlCaptureStackBackTrace(i32 0, i32 64, ptr %ptr, ptr null)")
    codegen_util::cg_emit_line(out, "  %n = zext i16 %n16 to i32")
    codegen_util::cg_emit_line(out, "  %stderr = call ptr @__acrt_iob_func(i32 2)")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "loop:")
    codegen_util::cg_emit_line(out, "  %i = phi i32 [0, %entry], [%i.next, %body]")
    codegen_util::cg_emit_line(out, "  %done = icmp sge i32 %i, %n")
    codegen_util::cg_emit_line(out, "  br i1 %done, label %exit, label %body")
    codegen_util::cg_emit_line(out, "body:")
    codegen_util::cg_emit_line(out, "  %i64.idx = sext i32 %i to i64")
    codegen_util::cg_emit_line(out, "  %slot = getelementptr ptr, ptr %ptr, i64 %i64.idx")
    codegen_util::cg_emit_line(out, "  %addr.p = load ptr, ptr %slot")
    codegen_util::cg_emit_line(out, "  %addr.i = ptrtoint ptr %addr.p to i64")
    codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @fprintf(ptr %stderr, ptr @.bt_fmt_win, i64 %addr.i)")
    codegen_util::cg_emit_line(out, "  %i.next = add i32 %i, 1")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "exit:")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
  elsif cg_is_linux(target)
    # musl (Alpine) doesn't ship execinfo, and we don't want to gate at
    # link time on which libc the host has — emit the no-op stub. Real
    # Linux backtrace path is identical to macOS below; if we ever pin to
    # glibc we can collapse this branch back into the else.
    if linkonce == 1
      codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_print_backtrace() nounwind {")
    else
      codegen_util::cg_emit_line(out, "define void @qz_print_backtrace() nounwind {")
    end
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
  else
    codegen_util::cg_emit_line(out, "declare i32 @backtrace(ptr, i32)")
    codegen_util::cg_emit_line(out, "declare void @backtrace_symbols_fd(ptr, i32, i32)")
    if linkonce == 1
      codegen_util::cg_emit_line(out, "define linkonce_odr void @qz_print_backtrace() nounwind {")
    else
      codegen_util::cg_emit_line(out, "define void @qz_print_backtrace() nounwind {")
    end
    codegen_util::cg_emit_line(out, "  %buf = alloca [64 x ptr]")
    codegen_util::cg_emit_line(out, "  %ptr = bitcast [64 x ptr]* %buf to ptr")
    codegen_util::cg_emit_line(out, "  %n = call i32 @backtrace(ptr %ptr, i32 64)")
    codegen_util::cg_emit_line(out, "  call void @backtrace_symbols_fd(ptr %ptr, i32 %n, i32 2)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
  end
end

# ============================================================================
# Target Info Emission (platform-specific)
# ============================================================================

## Emit target-specific datalayout and triple.
def cg_emit_target_info(out: Int, target: String): Void
  if target == "x86_64-linux-gnu" or target == "x86_64-unknown-linux-gnu"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"x86_64-unknown-linux-gnu\"")
  elsif target == "aarch64-linux-gnu" or target == "aarch64-unknown-linux-gnu"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"aarch64-unknown-linux-gnu\"")
  elsif target == "aarch64-apple-macosx"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:o-i64:64-i128:128-n32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"arm64-apple-macosx14.0.0\"")
  elsif target == "x86_64-apple-macosx"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"x86_64-apple-macosx14.0.0\"")
  elsif target == "wasm32-wasi"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-n32:64-S128-ni:1:10:20\"")
    codegen_util::cg_emit_line(out, "target triple = \"wasm32-wasi\"")
  elsif target == "aarch64-unknown-none"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"aarch64-unknown-none\"")
  elsif target == "x86_64-unknown-none-elf"
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"x86_64-unknown-none-elf\"")
  elsif target == "x86_64-pc-windows-gnu" or target == "x86_64-pc-windows-msvc"
    # x86_64 Windows: gnu and msvc share identical datalayout (m:w COFF mangling,
    # same SSE alignment); only the triple suffix differs. Strings captured
    # verbatim from `zig cc -target x86_64-windows-{gnu,msvc} -emit-llvm -S`.
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    if target == "x86_64-pc-windows-msvc"
      codegen_util::cg_emit_line(out, "target triple = \"x86_64-pc-windows-msvc\"")
    else
      codegen_util::cg_emit_line(out, "target triple = \"x86_64-pc-windows-gnu\"")
    end
  elsif target == "aarch64-pc-windows-gnu" or target == "aarch64-pc-windows-msvc"
    # aarch64 Windows: datalayout captured from `zig cc -target aarch64-windows-gnu
    # -emit-llvm -S`. Same shape for msvc.
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-p:64:64-i32:32-i64:64-i128:128-n32:64-S128-Fn32\"")
    if target == "aarch64-pc-windows-msvc"
      codegen_util::cg_emit_line(out, "target triple = \"aarch64-pc-windows-msvc\"")
    else
      codegen_util::cg_emit_line(out, "target triple = \"aarch64-pc-windows-gnu\"")
    end
  else
    # Default: use aarch64-apple-macosx (host default on M-series)
    codegen_util::cg_emit_line(out, "target datalayout = \"e-m:o-i64:64-i128:128-n32:64-S128\"")
    codegen_util::cg_emit_line(out, "target triple = \"arm64-apple-macosx14.0.0\"")
  end
end

# ============================================================================
# Program Emission
# ============================================================================

## Emit LLVM struct type definitions for structs with narrow fields.
## B.10 §12.9 — emit a non-narrow @value struct's type as an all-i64 aggregate
## (`%struct.P = type { i64, i64 }`). Such structs carry no narrow fields, so the
## generic narrow-emit loop below skips them; they need a type def only because
## an inline-value generic spec embeds them. Each i64 slot is the wide field
## representation (the all-wide-field limitation of the v1 inline path).
def cg_emit_value_struct_type(out: Int, struct_defs: Vec<mir::MirStructDef>, name: String): Void
  var n = struct_defs.size
  for i in 0..n
    var e = struct_defs[i]
    if e.name == name
      var fts = e.field_types
      var fc = vec_size(fts)
      var line = "%struct.#{name} = type { "
      for j in 0..fc
        if j > 0
          line += ", "
        end
        var ft = as_string(fts[j])
        if mir::mir_is_narrow_fixed_width(ft)
          line += mir::mir_type_name_to_llvm(ft)
        else
          line += "i64"
        end
      end
      line += " }"
      codegen_util::cg_emit_line(out, line)
      return
    end
  end
end

def cg_emit_struct_types(out: Int, prog: mir::MirProgram): Void
  var struct_defs = mir::mir_get_struct_defs(prog)
  if as_int(struct_defs) == 0
    return
  end
  var count = struct_defs.size
  # B.10 §12.9 PASS A — emit type defs for any @value struct embedded inline by
  # a generic-over-@value specialization (inline_value == 1). Deduped by name.
  # These come first so the spec aggregate types below can reference them.
  var emitted_value = vec_new<String>()
  for si in 0..count
    var sentry = struct_defs[si]
    if mir::mir_struct_def_has_inline_value(sentry) == 1
      var sfts = sentry.field_types
      var sfc = vec_size(sfts)
      for sj in 0..sfc
        var sft = as_string(sfts[sj])
        # item 39c — value-layout member, NOT is_value-only: a flip-eligible plain
        # struct member must also get its own `%struct.X` type def emitted so the
        # PASS B inline below can reference it. mir_prog_is_value_layout_type is
        # gate-0 inert for plain structs (short-circuits on the F4 gate) ⇒ at gate 0
        # this returns exactly the old is_value result ⇒ byte-identical.
        if mir::mir_prog_is_value_layout_type(prog, sft) == 1
          var already = 0
          for ei in 0..emitted_value.size
            if emitted_value[ei] == sft
              already = 1
            end
          end
          if already == 0
            cg_emit_value_struct_type(out, struct_defs, sft)
            emitted_value.push(sft)
          end
        end
      end
    end
  end
  # B.10 §12.9 PASS B — emit the inline-value specialization aggregate types
  # (`%struct.Box$P = type { %struct.P }`). A field whose type is an embedded
  # @value struct becomes a nested `%struct.<FieldType>`; other fields keep
  # their scalar LLVM type.
  for sbi in 0..count
    var sbentry = struct_defs[sbi]
    if mir::mir_struct_def_has_inline_value(sbentry) == 1
      var sbname = sbentry.name
      var sbfts = sbentry.field_types
      var sbfc = vec_size(sbfts)
      var sbline = "%struct.#{sbname} = type { "
      for sbj in 0..sbfc
        if sbj > 0
          sbline += ", "
        end
        var sbft = as_string(sbfts[sbj])
        # item 39c (root) — value-layout member, NOT is_value-only. The old
        # is_value-only test emitted a flip-eligible plain member (e.g. inline
        # GVHeap) as a bare `i64` (1 slot) instead of `%struct.GVHeap` (2 slots),
        # undersizing the aggregate so the next field aliased GVHeap.b (160 vs 330).
        # mir_prog_is_value_layout_type widens to is_value OR flip-eligible and is
        # gate-0 inert for plain structs ⇒ byte-identical at gate 0.
        if mir::mir_prog_is_value_layout_type(prog, sbft) == 1
          sbline += "%struct.#{sbft}"
        elsif mir::mir_is_narrow_fixed_width(sbft)
          sbline += mir::mir_type_name_to_llvm(sbft)
        else
          sbline += "i64"
        end
      end
      sbline += " }"
      codegen_util::cg_emit_line(out, sbline)
    end
  end
  for i in 0..count
    var entry = struct_defs[i]
    var name = entry.name
    var field_types = entry.field_types
    var ft_count = vec_size(field_types)
    # Emit the typed `%struct.Name` for any struct that addresses its fields
    # through a typed GEP: one with a narrow field, OR an @repr(C) struct (which
    # uses the typed layout regardless — see mir_prog_struct_has_narrow_fields).
    # B.10 P3.4 — without the @repr(C) arm, a repr(C) struct whose fields are all
    # non-narrow (e.g. all-F32 / all-F64) used `%struct.Name` GEPs against a type
    # that was never declared → `llc: base element of getelementptr must be
    # sized`. The emitted layout is the INTERNAL one (F32/F64 → i64 double-bits
    # slot via mir_type_name_to_llvm), matching the `store i64` field writes; the
    # C-faithful boundary layout is a separate concern (P3.4b coerce repack).
    var has_narrow = 0
    for j in 0..ft_count
      var ft = as_string(field_types[j])
      if mir::mir_is_narrow_fixed_width(ft)
        has_narrow = 1
      end
    end
    var is_repr_c = entry.repr_c
    if has_narrow == 1 or is_repr_c == 1
      var is_packed = entry.packed
      var line = "%struct.#{name} = type "
      if is_packed == 1
        line += "<{ "
      else
        line += "{ "
      end
      for j in 0..ft_count
        if j > 0
          line += ", "
        end
        var ft = as_string(field_types[j])
        line += mir::mir_type_name_to_llvm(ft)
      end
      if is_packed == 1
        line += " }>"
      else
        line += " }"
      end
      codegen_util::cg_emit_line(out, line)
    end
    # B.10 P3.4-ii-b — emit the C-FAITHFUL layout type `%struct.Name.cabi` for an
    # @repr(C) struct with any F32 field. The internal `%struct.Name` above stores
    # F32 as an 8-byte double-bits i64 slot, so it is NOT the C layout (a 4-byte
    # `float` at a packed offset). A >16B F32 struct crosses the C boundary as a
    # `byval`/`sret` pointer, which needs a true-C-size named type — this is it
    # (`{float,…}`, natural alignment == C). The boundary repack (codegen.qz
    # cg_c_abi_emit_qz_to_c_buf/_c_to_qz_buf) converts between the two layouts.
    # Gated on repr(C)+F32 (none in compiler/std) ⇒ fixpoint-safe.
    if is_repr_c == 1
      var has_f32 = 0
      for j in 0..ft_count
        if as_string(field_types[j]) == "F32"
          has_f32 = 1
        end
      end
      if has_f32 == 1
        var cline = "%struct.#{name}.cabi = type { "
        for j in 0..ft_count
          if j > 0
            cline += ", "
          end
          var cft = as_string(field_types[j])
          if cft == "F32"
            cline += "float"
          elsif cft == "F64"
            cline += "double"
          elsif mir::mir_is_narrow_fixed_width(cft)
            cline += mir::mir_type_name_to_llvm(cft)
          else
            cline += "i64"
          end
        end
        cline += " }"
        codegen_util::cg_emit_line(out, cline)
      end
    end
  end
end

## Check if target is freestanding (no libc).
def cg_is_freestanding(target: String): Int
  if str_ends_with(target, "-none")
    return 1
  end
  if str_ends_with(target, "-none-elf")
    return 1
  end
  return 0
end

## Check if target is WASI (no pthreads, no POSIX system/regex).
def cg_is_wasi(target: String): Int
  if str_contains(target, "wasi")
    return 1
  end
  return 0
end

def cg_is_linux(target: String): Int
  if str_contains(target, "linux")
    return 1
  end
  return 0
end

def cg_is_windows(target: String): Int
  if str_contains(target, "windows")
    return 1
  end
  return 0
end

def cg_is_macos(target: String): Int
  if str_contains(target, "apple") or str_contains(target, "darwin") or str_contains(target, "macos")
    return 1
  end
  return 0
end

## Emit a libc-free integer-to-string helper. Identical implementation in
## hosted and freestanding modes — caller-side guarantees the input is an
## int (no pointer-sniff heuristic; sb_append_int and string-interpolation
## paths know their argument type). This avoids both the libc sprintf
## dependency (broken in freestanding) AND the @to_str pointer-sniff
## heuristic's false-positive SEGV on aligned-and-large int values
## (the documented TO_STR_INT_HEURISTIC_UNSOUND footgun: the sniff
## dereferences [val-8] for any val matching `(val & 15) == 8 && val > 65535`,
## SEGV-ing if that address is unmapped). Returns a length-prefixed
## qz_alloc_str-allocated string handle. Hand-rolled digit decomposition
## via urem/udiv into a 24-byte stack buffer, then qz_alloc_str + memcpy.
def cg_emit_int_to_str_helper(out: Int): Void
  codegen_util::cg_emit_line(out, "; Libc-free pure-int formatter (no pointer-sniff — caller guarantees int)")
  codegen_util::cg_emit_line(out, "define i64 @qz_int_to_str(i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sbuf = alloca [24 x i8]")
  codegen_util::cg_emit_line(out, "  %is_neg = icmp slt i64 %val, 0")
  codegen_util::cg_emit_line(out, "  %nval = sub i64 0, %val")
  codegen_util::cg_emit_line(out, "  %abs = select i1 %is_neg, i64 %nval, i64 %val")
  codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i64 %abs, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_zero, label %zero_case, label %loop")
  codegen_util::cg_emit_line(out, "zero_case:")
  codegen_util::cg_emit_line(out, "  %zslot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 23")
  codegen_util::cg_emit_line(out, "  store i8 48, ptr %zslot")
  codegen_util::cg_emit_line(out, "  br label %finish")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %cur_i = phi i64 [23, %entry], [%next_i, %loop]")
  codegen_util::cg_emit_line(out, "  %cur_v = phi i64 [%abs, %entry], [%next_v, %loop]")
  codegen_util::cg_emit_line(out, "  %digit = urem i64 %cur_v, 10")
  codegen_util::cg_emit_line(out, "  %next_v = udiv i64 %cur_v, 10")
  codegen_util::cg_emit_line(out, "  %ch_i = add i64 %digit, 48")
  codegen_util::cg_emit_line(out, "  %ch = trunc i64 %ch_i to i8")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %cur_i")
  codegen_util::cg_emit_line(out, "  store i8 %ch, ptr %slot")
  codegen_util::cg_emit_line(out, "  %next_i = sub i64 %cur_i, 1")
  codegen_util::cg_emit_line(out, "  %done = icmp eq i64 %next_v, 0")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %after_loop, label %loop")
  codegen_util::cg_emit_line(out, "after_loop:")
  codegen_util::cg_emit_line(out, "  br i1 %is_neg, label %prepend_minus, label %no_sign")
  codegen_util::cg_emit_line(out, "prepend_minus:")
  codegen_util::cg_emit_line(out, "  %mslot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %next_i")
  codegen_util::cg_emit_line(out, "  store i8 45, ptr %mslot")
  codegen_util::cg_emit_line(out, "  br label %finish")
  codegen_util::cg_emit_line(out, "no_sign:")
  codegen_util::cg_emit_line(out, "  br label %finish")
  codegen_util::cg_emit_line(out, "finish:")
  codegen_util::cg_emit_line(out, "  %start_i = phi i64 [23, %zero_case], [%cur_i, %no_sign], [%next_i, %prepend_minus]")
  codegen_util::cg_emit_line(out, "  %str_len = sub i64 24, %start_i")
  codegen_util::cg_emit_line(out, "  %rbuf = call ptr @qz_alloc_str(i64 %str_len)")
  codegen_util::cg_emit_line(out, "  %src = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %start_i")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %rbuf, ptr %src, i64 %str_len)")
  codegen_util::cg_emit_line(out, "  %rval = ptrtoint ptr %rbuf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %rval")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## Emit Windows pthread→Win32 shim block. Phase 5a of QUARTZ_WINDOWS_TARGET.md:
## replace every pthread_* extern declaration with a local definition that
## wraps the native Win32 primitive. Same shim signatures + same symbol names
## as POSIX, so existing call sites in the scheduler IR resolve here on
## Windows without per-site branching.
##
## Storage model: pthread_t / pthread_mutex_t / pthread_cond_t allocs are all
## 64 bytes (`__qz_alloc(64)`). On Windows the first 8 bytes hold a Win32
## SRWLOCK (mutex) / CONDITION_VARIABLE (condvar) — both single-pointer
## structures. pthread_t i64 carries a HANDLE bit-pattern (ptrtoint/inttoptr).
##
## Native Win32 primitive choices (per docs/design/QUARTZ_WINDOWS_TARGET.md §5E):
## - SRWLOCK for pthread_mutex_t — non-reentrant; fair on Win8+
## - CONDITION_VARIABLE for pthread_cond_t — pairs with SRWLOCK via
##   SleepConditionVariableSRW
## - CreateThread / WaitForSingleObject / CloseHandle for pthread_create/join/detach
## - TlsAlloc / TlsSetValue / TlsGetValue for pthread_key_create/set/getspecific
## - Sleep / SwitchToThread for nanosleep / sched_yield
## - __qz_time_mono_ns (already shimmed via QPC in Phase 4) for clock_gettime
##   and as the time-source for pthread_cond_timedwait's abs-deadline→rel-ms
##   conversion (same source on both sides → drift = 0).
##
## What's deliberately not shimmed: pthread_attr_init / pthread_attr_setdetachstate
## (currently unreferenced in scheduler IR — only declared, never called).
## If they ever become reachable, add no-op shims here.
def cg_emit_windows_thread_shims(out: Int): Void
  codegen_util::cg_emit_line(out, "; ============================================================================")
  codegen_util::cg_emit_line(out, "; Phase 5a — Windows pthread→Win32 shim block")
  codegen_util::cg_emit_line(out, "; ============================================================================")
  codegen_util::cg_emit_line(out, "; Native Win32 externs (kernel32.dll — implicitly linked by zig cc/lld-link)")
  codegen_util::cg_emit_line(out, "declare ptr @CreateThread(ptr, i64, ptr, ptr, i32, ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @WaitForSingleObject(ptr, i32) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @CloseHandle(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @GetCurrentThreadId() nounwind")
  # SetThreadDescription (Win10+ 1607) — debugger thread name.
  # Pseudo-handle GetCurrentThread() = (HANDLE)-2 is documented as safe.
  codegen_util::cg_emit_line(out, "declare i32 @SetThreadDescription(ptr, ptr) nounwind")
  # MultiByteToWideChar — UTF-8 → UTF-16 conversion for the description.
  codegen_util::cg_emit_line(out, "declare i32 @MultiByteToWideChar(i32, i32, ptr, i32, ptr, i32) nounwind")
  # SetConsoleCtrlHandler — Ctrl+Break / Ctrl+C handler installation.
  # POSIX equivalent of signal(SIGUSR1, h); used to trigger task dumps.
  codegen_util::cg_emit_line(out, "declare i32 @SetConsoleCtrlHandler(ptr, i32) nounwind")
  codegen_util::cg_emit_line(out, "declare void @InitializeSRWLock(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare void @AcquireSRWLockExclusive(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare void @ReleaseSRWLockExclusive(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare i8 @TryAcquireSRWLockExclusive(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare void @InitializeConditionVariable(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @SleepConditionVariableSRW(ptr, ptr, i32, i32) nounwind")
  codegen_util::cg_emit_line(out, "declare void @WakeConditionVariable(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare void @WakeAllConditionVariable(ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @TlsAlloc() nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @TlsSetValue(i32, ptr) nounwind")
  codegen_util::cg_emit_line(out, "declare ptr @TlsGetValue(i32) nounwind")
  codegen_util::cg_emit_line(out, "declare void @Sleep(i32) nounwind")
  codegen_util::cg_emit_line(out, "declare void @SwitchToThread() nounwind")
  codegen_util::cg_emit_line(out, "")

  # pthread_create — HANDLE returned by CreateThread stored as i64 at *tid_out.
  codegen_util::cg_emit_line(out, "define i32 @pthread_create(ptr %tid_out, ptr %attr, ptr %fn, ptr %arg) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %h = call ptr @CreateThread(ptr null, i64 0, ptr %fn, ptr %arg, i32 0, ptr null)")
  codegen_util::cg_emit_line(out, "  %hi = ptrtoint ptr %h to i64")
  codegen_util::cg_emit_line(out, "  store i64 %hi, ptr %tid_out")
  codegen_util::cg_emit_line(out, "  %nz = icmp ne ptr %h, null")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %nz, i32 0, i32 1")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_join — WaitForSingleObject(INFINITE) + CloseHandle.
  codegen_util::cg_emit_line(out, "define i32 @pthread_join(i64 %tid, ptr %retval) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %h = inttoptr i64 %tid to ptr")
  codegen_util::cg_emit_line(out, "  %wr = call i32 @WaitForSingleObject(ptr %h, i32 -1)")
  codegen_util::cg_emit_line(out, "  %cr = call i32 @CloseHandle(ptr %h)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_detach — CloseHandle releases the kernel-side handle; thread
  # continues running and self-cleans on exit.
  codegen_util::cg_emit_line(out, "define i32 @pthread_detach(i64 %tid) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %h = inttoptr i64 %tid to ptr")
  codegen_util::cg_emit_line(out, "  %cr = call i32 @CloseHandle(ptr %h)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_self — GetCurrentThreadId returns DWORD, widen to i64 for the
  # POSIX-shaped caller. Note: this is the thread ID, NOT a HANDLE; if any
  # caller expects to pthread_join on the result of pthread_self, that would
  # need to use GetCurrentThread() instead (pseudo-handle, must be duplicated
  # to be join-able). The Quartz scheduler uses pthread_self only for
  # setname_np, which is no-op'd on Windows, so the distinction is moot here.
  codegen_util::cg_emit_line(out, "define i64 @pthread_self() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %t = call i32 @GetCurrentThreadId()")
  codegen_util::cg_emit_line(out, "  %t64 = zext i32 %t to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %t64")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_setname_np (i64, ptr) — Windows shim that maps to
  # SetThreadDescription (Win10 1607+). Converts the UTF-8 name to UTF-16
  # via MultiByteToWideChar, then calls SetThreadDescription on the
  # pseudo-handle (HANDLE)-2 (documented to refer to the current thread).
  # Threads named here show up by name in WinDbg / Visual Studio /
  # ETW traces / SysInternals Process Explorer.
  #
  # The %tid argument is the i32 thread ID from GetCurrentThreadId(),
  # ignored here — SetThreadDescription on the pseudo-handle always
  # targets the current thread. Quartz's call-site pattern always calls
  # pthread_setname_np on its own pthread_self() result, so this matches.
  #
  # 256-byte stack buffer = 128 wide chars; Quartz thread names are
  # always short ASCII ("qz-io-poll", "qz-worker-0", "qz-worker-31") so
  # there's no risk of truncation.
  codegen_util::cg_emit_line(out, "define i32 @pthread_setname_np(i64 %tid, ptr %name) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %wbuf = alloca [128 x i16]")
  codegen_util::cg_emit_line(out, "  %wbuf.p = bitcast [128 x i16]* %wbuf to ptr")
  # MultiByteToWideChar(CP_UTF8=65001, flags=0, src, -1=null-terminated,
  #                     dst, dst_cch=128). Returns wide chars written
  # (incl. null) or 0 on failure. Ignored.
  codegen_util::cg_emit_line(out, "  call i32 @MultiByteToWideChar(i32 65001, i32 0, ptr %name, i32 -1, ptr %wbuf.p, i32 128)")
  # GetCurrentThread() pseudo-handle is (HANDLE)-2.
  codegen_util::cg_emit_line(out, "  %hthread = inttoptr i64 -2 to ptr")
  # SetThreadDescription is best-effort — ignore the HRESULT return.
  codegen_util::cg_emit_line(out, "  call i32 @SetThreadDescription(ptr %hthread, ptr %wbuf.p)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_attr_init / pthread_attr_setdetachstate — no-op shims. Unused in
  # scheduler IR today but the declares are emitted; provide bodies so any
  # future caller links cleanly.
  codegen_util::cg_emit_line(out, "define i32 @pthread_attr_init(ptr %a) nounwind { ret i32 0 }")
  codegen_util::cg_emit_line(out, "define i32 @pthread_attr_setdetachstate(ptr %a, i32 %s) nounwind { ret i32 0 }")
  codegen_util::cg_emit_line(out, "")

  # pthread_mutex_* → SRWLOCK exclusive. SRWLOCK is a single-pointer struct,
  # fits in the first 8 bytes of the 64-byte pthread_mutex_t alloc. No
  # explicit init needed (InitializeSRWLock just writes the zero pattern),
  # no destroy.
  codegen_util::cg_emit_line(out, "define i32 @pthread_mutex_init(ptr %m, ptr %a) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @InitializeSRWLock(ptr %m)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_mutex_lock(ptr %m) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @AcquireSRWLockExclusive(ptr %m)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_mutex_unlock(ptr %m) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @ReleaseSRWLockExclusive(ptr %m)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  # pthread_mutex_trylock — returns 0 on success, EBUSY (Linux=16) otherwise.
  # POSIX callers check `!= 0` for contention; the exact errno doesn't matter.
  codegen_util::cg_emit_line(out, "define i32 @pthread_mutex_trylock(ptr %m) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ok = call i8 @TryAcquireSRWLockExclusive(ptr %m)")
  codegen_util::cg_emit_line(out, "  %nz = icmp ne i8 %ok, 0")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %nz, i32 0, i32 16")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_mutex_destroy(ptr %m) nounwind { ret i32 0 }")
  codegen_util::cg_emit_line(out, "")

  # pthread_cond_* → CONDITION_VARIABLE + SleepConditionVariableSRW.
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_init(ptr %c, ptr %a) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @InitializeConditionVariable(ptr %c)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_wait(ptr %c, ptr %m) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %r = call i32 @SleepConditionVariableSRW(ptr %c, ptr %m, i32 -1, i32 0)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_signal(ptr %c) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @WakeConditionVariable(ptr %c)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_broadcast(ptr %c) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @WakeAllConditionVariable(ptr %c)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_destroy(ptr %c) nounwind { ret i32 0 }")
  codegen_util::cg_emit_line(out, "")

  # pthread_cond_timedwait — POSIX takes abs CLOCK_REALTIME timespec. The
  # caller computes deadline = now() + relative_ms by calling clock_gettime
  # (our shim — same QPC source as __qz_time_mono_ns). Here we convert back:
  # rel_ms = abs_ns - now_ns, clamp to [0, INFINITE-1].
  # Returns 0 on signal/spurious-wake, ETIMEDOUT (Linux=110) on timeout.
  # The caller's existing branch checks for {ETIMEDOUT_macOS=60, ETIMEDOUT_linux=110}
  # so the 110 we return matches the Linux arm.
  codegen_util::cg_emit_line(out, "define i32 @pthread_cond_timedwait(ptr %c, ptr %m, ptr %abs_ts) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %asec.p = bitcast ptr %abs_ts to ptr")
  codegen_util::cg_emit_line(out, "  %asec = load i64, ptr %asec.p")
  codegen_util::cg_emit_line(out, "  %ansec.p = getelementptr i8, ptr %abs_ts, i64 8")
  codegen_util::cg_emit_line(out, "  %ansec = load i64, ptr %ansec.p")
  codegen_util::cg_emit_line(out, "  %sec_ns = mul i64 %asec, 1000000000")
  codegen_util::cg_emit_line(out, "  %abs_ns = add i64 %sec_ns, %ansec")
  codegen_util::cg_emit_line(out, "  %now_ns = call i64 @__qz_time_mono_ns()")
  codegen_util::cg_emit_line(out, "  %rem_ns = sub i64 %abs_ns, %now_ns")
  codegen_util::cg_emit_line(out, "  %rem_ms = sdiv i64 %rem_ns, 1000000")
  codegen_util::cg_emit_line(out, "  %is_neg = icmp slt i64 %rem_ms, 0")
  codegen_util::cg_emit_line(out, "  %lo = select i1 %is_neg, i64 0, i64 %rem_ms")
  codegen_util::cg_emit_line(out, "  %too_big = icmp sgt i64 %lo, 2147483646")
  codegen_util::cg_emit_line(out, "  %clamped = select i1 %too_big, i64 2147483646, i64 %lo")
  codegen_util::cg_emit_line(out, "  %ms.i32 = trunc i64 %clamped to i32")
  codegen_util::cg_emit_line(out, "  %r = call i32 @SleepConditionVariableSRW(ptr %c, ptr %m, i32 %ms.i32, i32 0)")
  codegen_util::cg_emit_line(out, "  %ok = icmp ne i32 %r, 0")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %ok, i32 0, i32 110")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # pthread_rwlock_* — degrade to exclusive on Windows v1. SRWLock has a
  # native shared mode (AcquireSRWLockShared / ReleaseSRWLockShared) but
  # mixing shared+exclusive across the same shim symbol requires per-call
  # bookkeeping (you must release with the same mode you acquired). The
  # callers in std/sync/rwlock.qz don't track that. Degrading to exclusive
  # is functionally correct, just less concurrent. Phase 5b consideration:
  # split into pthread_rwlock_rdlock_shim / pthread_rwlock_wrlock_shim
  # that route to shared vs exclusive, with unlock dispatching off a flag
  # byte stored alongside the SRWLock pointer.
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_init(ptr %l, ptr %a) nounwind {")
  codegen_util::cg_emit_line(out, "entry: call void @InitializeSRWLock(ptr %l) ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_rdlock(ptr %l) nounwind {")
  codegen_util::cg_emit_line(out, "entry: call void @AcquireSRWLockExclusive(ptr %l) ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_tryrdlock(ptr %l) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ok = call i8 @TryAcquireSRWLockExclusive(ptr %l)")
  codegen_util::cg_emit_line(out, "  %nz = icmp ne i8 %ok, 0")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %nz, i32 0, i32 16")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_wrlock(ptr %l) nounwind {")
  codegen_util::cg_emit_line(out, "entry: call void @AcquireSRWLockExclusive(ptr %l) ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_trywrlock(ptr %l) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ok = call i8 @TryAcquireSRWLockExclusive(ptr %l)")
  codegen_util::cg_emit_line(out, "  %nz = icmp ne i8 %ok, 0")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %nz, i32 0, i32 16")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_unlock(ptr %l) nounwind {")
  codegen_util::cg_emit_line(out, "entry: call void @ReleaseSRWLockExclusive(ptr %l) ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_rwlock_destroy(ptr %l) nounwind { ret i32 0 }")
  codegen_util::cg_emit_line(out, "")

  # pthread_key_* → TlsAlloc / TlsSetValue / TlsGetValue. Destructor arg
  # is ignored — the only caller is __qz_panic_key_create which passes null.
  codegen_util::cg_emit_line(out, "define i32 @pthread_key_create(ptr %key_out, ptr %dtor) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %k = call i32 @TlsAlloc()")
  codegen_util::cg_emit_line(out, "  %k64 = zext i32 %k to i64")
  codegen_util::cg_emit_line(out, "  store i64 %k64, ptr %key_out")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @pthread_setspecific(i64 %key, ptr %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %k = trunc i64 %key to i32")
  codegen_util::cg_emit_line(out, "  %r = call i32 @TlsSetValue(i32 %k, ptr %val)")
  codegen_util::cg_emit_line(out, "  %nz = icmp ne i32 %r, 0")
  codegen_util::cg_emit_line(out, "  %rc = select i1 %nz, i32 0, i32 1")
  codegen_util::cg_emit_line(out, "  ret i32 %rc")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define ptr @pthread_getspecific(i64 %key) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %k = trunc i64 %key to i32")
  codegen_util::cg_emit_line(out, "  %p = call ptr @TlsGetValue(i32 %k)")
  codegen_util::cg_emit_line(out, "  ret ptr %p")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # clock_gettime(any_clock, ts_out) — route everything through
  # __qz_time_mono_ns. Both CLOCK_REALTIME (0) and CLOCK_MONOTONIC (1/6) yield
  # the same QPC-derived source so that pthread_cond_timedwait above can
  # subtract abs - now in the same clock domain. Drift across the two clocks
  # would be a bug; we sidestep by using one.
  codegen_util::cg_emit_line(out, "define i32 @clock_gettime(i32 %clk, ptr %ts) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ns = call i64 @__qz_time_mono_ns()")
  codegen_util::cg_emit_line(out, "  %sec = sdiv i64 %ns, 1000000000")
  codegen_util::cg_emit_line(out, "  %nsec = srem i64 %ns, 1000000000")
  codegen_util::cg_emit_line(out, "  %sec.p = bitcast ptr %ts to ptr")
  codegen_util::cg_emit_line(out, "  store i64 %sec, ptr %sec.p")
  codegen_util::cg_emit_line(out, "  %nsec.p = getelementptr i8, ptr %ts, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 %nsec, ptr %nsec.p")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # nanosleep / usleep / sched_yield — Win32 has Sleep (ms) + SwitchToThread.
  codegen_util::cg_emit_line(out, "define i32 @nanosleep(ptr %req, ptr %rem) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sec.p = bitcast ptr %req to ptr")
  codegen_util::cg_emit_line(out, "  %sec = load i64, ptr %sec.p")
  codegen_util::cg_emit_line(out, "  %nsec.p = getelementptr i8, ptr %req, i64 8")
  codegen_util::cg_emit_line(out, "  %nsec = load i64, ptr %nsec.p")
  codegen_util::cg_emit_line(out, "  %sec_ms = mul i64 %sec, 1000")
  codegen_util::cg_emit_line(out, "  %ns_ms = sdiv i64 %nsec, 1000000")
  codegen_util::cg_emit_line(out, "  %total = add i64 %sec_ms, %ns_ms")
  codegen_util::cg_emit_line(out, "  %too_big = icmp sgt i64 %total, 2147483646")
  codegen_util::cg_emit_line(out, "  %ms64 = select i1 %too_big, i64 2147483646, i64 %total")
  codegen_util::cg_emit_line(out, "  %ms = trunc i64 %ms64 to i32")
  codegen_util::cg_emit_line(out, "  call void @Sleep(i32 %ms)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @usleep(i32 %us) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ms.raw = sdiv i32 %us, 1000")
  codegen_util::cg_emit_line(out, "  %zero = icmp eq i32 %ms.raw, 0")
  codegen_util::cg_emit_line(out, "  %us_nz = icmp ne i32 %us, 0")
  codegen_util::cg_emit_line(out, "  %need_min = and i1 %zero, %us_nz")
  codegen_util::cg_emit_line(out, "  %ms = select i1 %need_min, i32 1, i32 %ms.raw")
  codegen_util::cg_emit_line(out, "  call void @Sleep(i32 %ms)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "define i32 @sched_yield() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  call void @SwitchToThread()")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # sysconf(_SC_NPROCESSORS_ONLN=58/84) — return GetActiveProcessorCount
  # via Win32. ALL_PROCESSOR_GROUPS=0xFFFF reports across all processor
  # groups (matters on >64-CPU hosts). Fallback to 1 if API fails.
  codegen_util::cg_emit_line(out, "declare i32 @GetActiveProcessorCount(i16) nounwind")
  codegen_util::cg_emit_line(out, "define i64 @sysconf(i32 %k) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %n = call i32 @GetActiveProcessorCount(i16 -1)")
  codegen_util::cg_emit_line(out, "  %n64 = zext i32 %n to i64")
  codegen_util::cg_emit_line(out, "  %ok = icmp ne i32 %n, 0")
  codegen_util::cg_emit_line(out, "  %ret = select i1 %ok, i64 %n64, i64 1")
  codegen_util::cg_emit_line(out, "  ret i64 %ret")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # signal(sig, handler) — return null. Windows has no POSIX signals; the
  # SIGUSR1 dump-handler install in sched_init is gated to non-Windows
  # below. Provided here as a defensive no-op in case any other caller
  # references it.
  codegen_util::cg_emit_line(out, "define ptr @signal(i32 %sig, ptr %handler) nounwind {")
  codegen_util::cg_emit_line(out, "  ret ptr null")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # setjmp / longjmp — MSVC's runtime has them under the same names. UCRT
  # exports `_setjmp` and `longjmp`; mingw-w64's setjmp.h maps `setjmp` to
  # `_setjmp` via a macro. Declaring them as externs (not defines) lets the
  # linker resolve to UCRT.
  codegen_util::cg_emit_line(out, "declare i32 @setjmp(ptr) returns_twice")
  codegen_util::cg_emit_line(out, "declare void @longjmp(ptr, i32) noreturn")
  codegen_util::cg_emit_line(out, "declare i32 @atexit(void()*)")
  codegen_util::cg_emit_line(out, "")

  # Phase 5b — IOCP externs (kernel32.dll). Used by __qz_sched_init to
  # create the completion port, by __qz_sched_io_poller to drain it via
  # GetQueuedCompletionStatusEx, and by __qz_sched_wake_poller to cross-
  # thread wake the poller via PostQueuedCompletionStatus.
  #
  # Completion-key encoding (low 2 bits = kind, high bits = payload):
  #   kind 0 (Io)      — payload = Task* (8-byte aligned, kind bits clear).
  #                      Phase 5e populates via AFD.SYS poll completions.
  #   kind 1 (Wake)    — payload = 0. Cross-thread wake; the poller just
  #                      drains it and re-checks @__qz_signal_shutdown.
  #   kind 2 (Timer)   — Phase 5c. Software heap drains expired timers and
  #                      posts these.
  #   kind 3 (Process) — Phase 5d. RegisterWaitForSingleObject callback
  #                      posts on child exit.
  #
  # Key=0 is reserved (it's the default association on a newly-created
  # IOCP HANDLE), so MAGIC_WAKE_KEY=1 also doubles as "any post with kind=1".
  codegen_util::cg_emit_line(out, "declare ptr @CreateIoCompletionPort(ptr, ptr, i64, i32) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @GetQueuedCompletionStatusEx(ptr, ptr, i32, ptr, i32, i32) nounwind")
  codegen_util::cg_emit_line(out, "declare i32 @PostQueuedCompletionStatus(ptr, i32, i64, ptr) nounwind")
  codegen_util::cg_emit_line(out, "")

  # Phase 5d — process-exit monitoring extern (kernel32.dll). libuv pattern:
  # RegisterWaitForSingleObject on the child process HANDLE with
  # WT_EXECUTEONLYONCE; the callback runs on a Win32 threadpool thread and
  # posts a kind=3 completion to our IOCP, which the poller dispatches
  # identically to kind=Io (strip kind bits → __qz_sched_reenqueue).
  #
  # Signature: BOOL RegisterWaitForSingleObject(
  #   PHANDLE phNewWaitObject, HANDLE hObject, WAITORTIMERCALLBACK Callback,
  #   PVOID Context, ULONG dwMilliseconds, ULONG dwFlags)
  #
  # We never UnregisterWaitEx in v1 — Phase 5d does not support cancellation
  # (sched_wake on a proc-suspended task is the same uncovered corner as 5c
  # before its cancel branch landed; filed-forward when a workload needs it).
  codegen_util::cg_emit_line(out, "declare i32 @RegisterWaitForSingleObject(ptr, ptr, ptr, ptr, i32, i32) nounwind")
  codegen_util::cg_emit_line(out, "")

  # __qz_proc_exit_callback(ctx, timer_or_wait_fired) — Win32 threadpool
  # callback fired when a registered process HANDLE becomes signaled (child
  # exited). Runs on a Windows threadpool thread (NOT a Quartz worker), so
  # it must restrict itself to thread-safe Win32 calls. PostQueuedCompletionStatus
  # is thread-safe by design. The %fired argument is BOOLEAN (i8) — TRUE iff
  # the wait timed out; for INFINITE waits this is always FALSE, so we ignore
  # it. ctx is the Quartz task pointer we passed at RegisterWaitForSingleObject
  # time. We encode the completion key as (task | 3) so the poller's low-2-bit
  # switch dispatches to kind=Process.
  codegen_util::cg_emit_line(out, "define void @__qz_proc_exit_callback(ptr %ctx, i8 %fired) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %iocp.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
  codegen_util::cg_emit_line(out, "  %iocp.i = load i64, ptr %iocp.p")
  codegen_util::cg_emit_line(out, "  %iocp = inttoptr i64 %iocp.i to ptr")
  codegen_util::cg_emit_line(out, "  %task.i = ptrtoint ptr %ctx to i64")
  codegen_util::cg_emit_line(out, "  %key = or i64 %task.i, 3")
  codegen_util::cg_emit_line(out, "  %r = call i32 @PostQueuedCompletionStatus(ptr %iocp, i32 0, i64 %key, ptr null)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Phase 5e — AFD.SYS socket-readiness externs. ntdll.dll for the NT
  # primitives, kernel32.dll for the IOCP perf hint, ws2_32.dll for
  # WSAIoctl(SIO_BASE_HANDLE) to defeat LSPs.
  #
  # The AFD pattern (mio src/sys/windows/{afd,selector}.rs, wepoll wepoll.c):
  #   1. NtCreateFile(\Device\Afd\Quartz) → afd HANDLE
  #   2. CreateIoCompletionPort(afd, iocp, key=0, 0) associates AFD with IOCP
  #   3. SetFileCompletionNotificationModes(afd, FILE_SKIP_SET_EVENT_ON_HANDLE=2)
  #   4. Per socket: WSAIoctl(SIO_BASE_HANDLE) unwraps the LSP-introduced
  #      proxy SOCKET to a base kernel HANDLE that AFD can actually poll.
  #      Komodia-family LSP fallback (SIO_BSP_HANDLE_POLL → SIO_BSP_HANDLE_SELECT
  #      → SIO_BSP_HANDLE) is filed-forward; treat failure as fatal for v1.
  #   5. Per registration: NtDeviceIoControlFile(afd, NULL, NULL, sock_state,
  #      &iosb, IOCTL_AFD_POLL=0x00012024, &poll_info, 32, &poll_info, 32).
  #      ApcContext (arg 4) = SockState pointer → comes back to ev_io: as
  #      OVERLAPPED_ENTRY.lpOverlapped.
  #
  # NtCreateFile signature (11 args, x64 calling convention):
  #   NTSTATUS NtCreateFile(PHANDLE FileHandle, ACCESS_MASK DesiredAccess,
  #                        POBJECT_ATTRIBUTES ObjectAttributes,
  #                        PIO_STATUS_BLOCK IoStatusBlock,
  #                        PLARGE_INTEGER AllocationSize, ULONG FileAttributes,
  #                        ULONG ShareAccess, ULONG CreateDisposition,
  #                        ULONG CreateOptions, PVOID EaBuffer, ULONG EaLength)
  codegen_util::cg_emit_line(out, "declare i32 @NtCreateFile(ptr, i32, ptr, ptr, ptr, i32, i32, i32, i32, ptr, i32) nounwind")
  # NtDeviceIoControlFile signature (10 args):
  #   NTSTATUS NtDeviceIoControlFile(HANDLE FileHandle, HANDLE Event,
  #                                  PIO_APC_ROUTINE ApcRoutine, PVOID ApcContext,
  #                                  PIO_STATUS_BLOCK IoStatusBlock,
  #                                  ULONG IoControlCode, PVOID InputBuffer,
  #                                  ULONG InputBufferLength, PVOID OutputBuffer,
  #                                  ULONG OutputBufferLength)
  codegen_util::cg_emit_line(out, "declare i32 @NtDeviceIoControlFile(ptr, ptr, ptr, ptr, ptr, i32, ptr, i32, ptr, i32) nounwind")
  # NtCancelIoFileEx signature (3 args):
  #   NTSTATUS NtCancelIoFileEx(HANDLE FileHandle, PIO_STATUS_BLOCK IoRequestToCancel,
  #                             PIO_STATUS_BLOCK IoStatusBlock)
  codegen_util::cg_emit_line(out, "declare i32 @NtCancelIoFileEx(ptr, ptr, ptr) nounwind")
  # NtClose — release the AFD HANDLE at shutdown.
  codegen_util::cg_emit_line(out, "declare i32 @NtClose(ptr) nounwind")
  # SetFileCompletionNotificationModes(HANDLE FileHandle, UCHAR Flags). Flag
  # FILE_SKIP_SET_EVENT_ON_HANDLE=2 tells the kernel to skip the event signal
  # when an IOCP-bound HANDLE has its I/O complete — a measurable perf win,
  # documented by Microsoft, used by every production IOCP runtime.
  codegen_util::cg_emit_line(out, "declare i32 @SetFileCompletionNotificationModes(ptr, i8) nounwind")
  # WSAIoctl(SOCKET s, DWORD dwIoControlCode, LPVOID lpvInBuffer,
  #          DWORD cbInBuffer, LPVOID lpvOutBuffer, DWORD cbOutBuffer,
  #          LPDWORD lpcbBytesReturned, LPWSAOVERLAPPED lpOverlapped,
  #          LPWSAOVERLAPPED_COMPLETION_ROUTINE lpCompletionRoutine)
  codegen_util::cg_emit_line(out, "declare i32 @WSAIoctl(i64, i32, ptr, i32, ptr, i32, ptr, ptr, ptr) nounwind")
  codegen_util::cg_emit_line(out, "")

  # \Device\Afd\Quartz as UTF-16LE, 18 chars × 2 bytes = 36 bytes (no NUL).
  # AFD only matches the \Device\Afd prefix and ignores the trailing namespace
  # component, so any reasonable suffix works (mio uses \Mio, wepoll \Wepoll).
  codegen_util::cg_emit_line(out, "@.qz_afd_dev = private unnamed_addr constant [36 x i8] c\"\\5C\\00\\44\\00\\65\\00\\76\\00\\69\\00\\63\\00\\65\\00\\5C\\00\\41\\00\\66\\00\\64\\00\\5C\\00\\51\\00\\75\\00\\61\\00\\72\\00\\74\\00\\7A\\00\"")
  codegen_util::cg_emit_line(out, "")
end

## Emit external runtime declarations (libc, etc.).
def cg_emit_runtime_decls(out: Int, target: String, uses_task_group: Int, uses_scheduler: Int, uses_scope_deadline: Int): Void
  # Target datalayout and triple for platform-specific optimizations
  cg_emit_target_info(out, target)
  codegen_util::cg_emit_line(out, "")

  # Freestanding: emit only target info + declarations for the small set
  # of C symbols that compiler-emitted code (Map/HashMap/Vec/String
  # intrinsics) calls by name. Users ("freestanding / kernel consumers")
  # provide these at link time — either from their own bump/slab allocator
  # + hand-rolled mem helpers, or from compiler-rt / musl-libc-mini /
  # similar. This is the Rust `no_std` + `alloc` pattern: `extern "C"`
  # declarations for `malloc` / `free` / `memcpy` / `memset` / `qsort`
  # that the user resolves at link time. Without these declarations LLC
  # rejects the IR with `use of undefined value '@malloc'`.
  if cg_is_freestanding(target)
    codegen_util::cg_emit_line(out, "; Quartz Freestanding Runtime Declarations")
    codegen_util::cg_emit_line(out, "; (user supplies at link time — allocator, mem helpers, sort)")
    codegen_util::cg_emit_line(out, "declare noalias ptr @malloc(i64)")
    codegen_util::cg_emit_line(out, "declare noalias ptr @realloc(ptr, i64)")
    codegen_util::cg_emit_line(out, "declare void @free(ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @memcpy(ptr, ptr, i64)")
    codegen_util::cg_emit_line(out, "declare void @memset(ptr, i32, i64)")
    codegen_util::cg_emit_line(out, "declare void @qsort(ptr, i64, i64, ptr)")
    # D.11 Phase 8b.2.b — additional libc string helpers needed by
    # http_server.qz transitive imports. Pure-C implementations live
    # in tools/baremetal/libc_stubs.c. These are dependency-free
    # primitives (no syscalls); hosted gets them from libc, the
    # kernel from libc_stubs.c.
    codegen_util::cg_emit_line(out, "declare i32 @memcmp(ptr, ptr, i64)")
    codegen_util::cg_emit_line(out, "declare i64 @strlen(ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @strcmp(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @strstr(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @strncpy(ptr, ptr, i64)")
    codegen_util::cg_emit_line(out, "declare ptr @strcpy(ptr, ptr)")
    # KERN.SLAB.2 — kernel-provided diagnostic barriers (libc_stubs.c).
    # qz_effect_install_alias_check: called from emitted
    #   __qz_effect_handle_install body before storing eff_name into
    #   names[top]. Halts if name_slot aliases the current task struct.
    # qz_effect_restore_names_check: called from emitted
    #   __qz_effect_restore_from_task body before publishing the loaded
    #   v_names to @__qz_effect_stack_names. Halts if v_names is wild.
    codegen_util::cg_emit_line(out, "declare void @qz_effect_install_alias_check(i64, i64, i64, i64)")
    codegen_util::cg_emit_line(out, "declare void @qz_effect_save_names_check(i64, i64)")
    codegen_util::cg_emit_line(out, "declare void @qz_effect_restore_names_check(i64, i64)")
    codegen_util::cg_emit_line(out, "")

    # Effects runtime + Alloc-wrapper stubs.
    #
    # Compiler-emitted IR threads through three layers of indirection that
    # the freestanding path otherwise fails to define:
    #
    #   1. Allocator wrappers `@__qz_alloc` / `@__qz_dealloc` / `@__qz_realloc`
    #      — Phase A.3 of Operation Piezoelectric Effects rerouted every
    #      raw `@malloc`/`@free`/`@realloc` emit site through these wrappers
    #      so the Alloc effect can intercept allocations. The hosted path
    #      defines them to consult an effect-handler stack and fall through
    #      to libc; freestanding has no handler stack, so we emit thin
    #      pass-throughs to the link-time `@malloc`/`@free`/`@realloc`
    #      declared above. Kernel consumers supply those via libc_stubs.c
    #      or equivalent (bump PMM, slab allocator, etc.).
    #
    #   2. Effect-stack push/pop `@__qz_effect_handle_install` /
    #      `@__qz_effect_handle_uninstall` — every `with E {...}` body-wrap
    #      emits paired install/uninstall calls regardless of whether the
    #      effect is actually performed at runtime. std/* code (e.g. the
    #      default Yield handler in std/gen.qz) emits these even for
    #      kernel programs that never drive `with`. No-op stubs are
    #      sufficient because `@__qz_effect_perform` (also stubbed) is
    #      never called at runtime in kernel builds — the inline body-wrap
    #      bookkeeping with `@__qz_effect_stack_top` / `__qz_effect_stack_results`
    #      / `__qz_alloc_in_handler` then just exercises zero-initialized
    #      slots (correct fallthrough for a no-handler-installed program).
    #
    #   3. Generator/yield helpers `@__qz_effect_argv_load`,
    #      `@__qz_effect_suspend`, `@__qz_gen_stash`,
    #      `@__qz_gen_take_stashed` — declared in `cg_emit_runtime_helpers`
    #      under hosted but not freestanding. Pulled in by std/* generator
    #      lowering even when kernel code never instantiates a generator.
    #      Stubs return zero / POLL_READY (1) to make link-time satisfy
    #      llc; runtime never executes them in kernel builds.
    #
    # The hosted path emits richer versions in `cg_emit_effect_runtime`
    # (codegen_runtime.qz:72) gated on `cg_is_freestanding(target) == 0`
    # at the call site (codegen.qz:1198).
    # D.11 Phase 7 / B.1.b — per-task effect-stack bridge.
    #
    # The 4 scalar globals (top / current_scope / scoped_ctx_top /
    # alloc_in_handler) stay as process-globals. Their values save/restore
    # to/from per-task Task slots at every context switch — the scheduler
    # owns that protocol (yield_now + sched_pump) by calling the
    # @__qz_effect_save_to_task / @__qz_effect_restore_from_task helpers
    # emitted below.
    #
    # The 7 array bases switch from `[256 x i64] zeroinitializer` (the
    # hosted/TLS layout) to `ptr null`. Each runtime function loads the
    # base pointer once at function entry and GEPs through it — a strip
    # of 16 KiB (4 PMM pages) backs the 7 arrays per task and is
    # alloc'd lazily on first install via the kernel-side
    # @__qz_eff_ensure_strip extern.
    #
    # Through B.1.b: install / uninstall / save / restore are real;
    # perform / suspend / gen_stash / take / scoped_ctx_push / pop /
    # throw_handler are still stubs (B.3 makes perform real; B.4 makes
    # suspend real). The stubbed paths are unreachable in the kernel
    # through B.6 — SOUL.6 demos install zero handlers — so no-op stubs
    # remain correct as a defensive ceiling for IR that mir-lowering
    # emits even when never executed.
    #
    # Task struct slot offsets MUST match
    # tools/baremetal/hello_x86.qz `const TASK_EFFECT_*` block.
    # Locked coupling — verify both sides after any TASK_STRUCT_SIZE change.

