  # ============================================================
  # Resource-waiter side-table (hashmap)
  # ============================================================
  #
  # Backs every Selectable.register_waker (FutureSelectable, channel
  # send/recv/close, MutexTrySelectable, SignalSelectable, etc.) and
  # the active-wake retrofits in std/actor.qz Supervisor +
  # DynamicSupervisor. Separate-chaining hashmap with 256-bucket initial
  # size, splitmix64 hash, and 64 striped pthread_mutex locks. Doubles
  # + rehashes at load factor > 0.75. Chain cells are 24 bytes
  # (target_key, waiter_frame, next_ptr) allocated via @__qz_alloc and
  # freed via @free on unregister/notify.
  #
  # Concurrency protocol:
  # - Each register/unregister/notify takes one stripe lock (selected
  #   by hash & 63 — independent of nbuckets so it stays valid across
  #   grows).
  # - Grow takes ALL 64 stripe locks in order before swapping the
  #   bucket array, then releases in reverse. Anyone holding a stripe
  #   lock can safely read bucket_array_ptr / nbuckets_mask.
  # - count is atomic (atomicrmw add/sub) so the grow heuristic can
  #   read it lock-free.

  # Splitmix64-style hash. Mixes pointer alignment patterns so that
  # malloc-aligned target keys don't bias bucket distribution. Same
  # constants as @qz_rand_seed splitmix64. alwaysinline so register/
  # unregister/notify pay no call overhead.
  codegen_util::cg_emit_line(out, "define i64 @__qz_waiter_hash(i64 %hh.x) nounwind alwaysinline {")
  codegen_util::cg_emit_line(out, "hh_entry:")
  codegen_util::cg_emit_line(out, "  %hh.s1 = lshr i64 %hh.x, 30")
  codegen_util::cg_emit_line(out, "  %hh.x1 = xor i64 %hh.x, %hh.s1")
  codegen_util::cg_emit_line(out, "  %hh.x2 = mul i64 %hh.x1, -4658895280553007687")
  codegen_util::cg_emit_line(out, "  %hh.s2 = lshr i64 %hh.x2, 27")
  codegen_util::cg_emit_line(out, "  %hh.x3 = xor i64 %hh.x2, %hh.s2")
  codegen_util::cg_emit_line(out, "  %hh.x4 = mul i64 %hh.x3, -7723592293110705685")
  codegen_util::cg_emit_line(out, "  %hh.s3 = lshr i64 %hh.x4, 31")
  codegen_util::cg_emit_line(out, "  %hh.r = xor i64 %hh.x4, %hh.s3")
  codegen_util::cg_emit_line(out, "  ret i64 %hh.r")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_waiters_init — allocate buckets array + stripe mutexes.
  # Called once from __qz_sched_init.
  codegen_util::cg_emit_line(out, "define void @__qz_waiters_init() nounwind {")
  codegen_util::cg_emit_line(out, "hmi_entry:")
  codegen_util::cg_emit_line(out, "  ; buckets: 256 * 8 = 2048 bytes, zeroed")
  codegen_util::cg_emit_line(out, "  %hmi.buckets = call ptr @__qz_alloc(i64 2048)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %hmi.buckets, i32 0, i64 2048)")
  codegen_util::cg_emit_line(out, "  %hmi.buckets.i = ptrtoint ptr %hmi.buckets to i64")
  codegen_util::cg_emit_line(out, "  %hmi.buckets.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %hmi.buckets.i, ptr %hmi.buckets.p")
  codegen_util::cg_emit_line(out, "  %hmi.nb.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %hmi.nb.p")
  codegen_util::cg_emit_line(out, "  %hmi.mk.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 255, ptr %hmi.mk.p")
  codegen_util::cg_emit_line(out, "  ; stripes: 64 * 64 = 4096 bytes, zeroed, then pthread_mutex_init each")
  codegen_util::cg_emit_line(out, "  %hmi.stripes = call ptr @__qz_alloc(i64 4096)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %hmi.stripes, i32 0, i64 4096)")
  codegen_util::cg_emit_line(out, "  br label %hmi_loop")
  codegen_util::cg_emit_line(out, "hmi_loop:")
  codegen_util::cg_emit_line(out, "  %hmi.si = phi i64 [0, %hmi_entry], [%hmi.si.next, %hmi_step]")
  codegen_util::cg_emit_line(out, "  %hmi.si.done = icmp uge i64 %hmi.si, 64")
  codegen_util::cg_emit_line(out, "  br i1 %hmi.si.done, label %hmi_done, label %hmi_step")
  codegen_util::cg_emit_line(out, "hmi_step:")
  codegen_util::cg_emit_line(out, "  %hmi.si.off = mul i64 %hmi.si, 64")
  codegen_util::cg_emit_line(out, "  %hmi.si.mtx = getelementptr i8, ptr %hmi.stripes, i64 %hmi.si.off")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %hmi.si.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %hmi.si.next = add i64 %hmi.si, 1")
  codegen_util::cg_emit_line(out, "  br label %hmi_loop")
  codegen_util::cg_emit_line(out, "hmi_done:")
  codegen_util::cg_emit_line(out, "  %hmi.stripes.i = ptrtoint ptr %hmi.stripes to i64")
  codegen_util::cg_emit_line(out, "  %hmi.stripes.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 4")
  codegen_util::cg_emit_line(out, "  store i64 %hmi.stripes.i, ptr %hmi.stripes.p")
  codegen_util::cg_emit_line(out, "  %hmi.ns.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  store i64 64, ptr %hmi.ns.p")
  codegen_util::cg_emit_line(out, "  %hmi.sm.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  store i64 63, ptr %hmi.sm.p")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_waiter_register(target, waiter): prepend (target, waiter) cell
  # to its bucket chain unless already present. Idempotent. No-op if
  # target == 0, waiter == 0, or table uninitialized.
  codegen_util::cg_emit_line(out, "define void @__qz_waiter_register(i64 %hr.target, i64 %hr.waiter) nounwind {")
  codegen_util::cg_emit_line(out, "hr_entry:")
  codegen_util::cg_emit_line(out, "  %hr.t.nz = icmp ne i64 %hr.target, 0")
  codegen_util::cg_emit_line(out, "  %hr.w.nz = icmp ne i64 %hr.waiter, 0")
  codegen_util::cg_emit_line(out, "  %hr.both.nz = and i1 %hr.t.nz, %hr.w.nz")
  codegen_util::cg_emit_line(out, "  br i1 %hr.both.nz, label %hr_chk_init, label %hr_ret")
  codegen_util::cg_emit_line(out, "hr_chk_init:")
  codegen_util::cg_emit_line(out, "  %hr.stripes.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 4")
  codegen_util::cg_emit_line(out, "  %hr.stripes.i = load i64, ptr %hr.stripes.p")
  codegen_util::cg_emit_line(out, "  %hr.has_stripes = icmp ne i64 %hr.stripes.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %hr.has_stripes, label %hr_lock, label %hr_ret")
  codegen_util::cg_emit_line(out, "hr_lock:")
  codegen_util::cg_emit_line(out, "  %hr.hash = call i64 @__qz_waiter_hash(i64 %hr.target)")
  codegen_util::cg_emit_line(out, "  %hr.stripe.idx = and i64 %hr.hash, 63")
  codegen_util::cg_emit_line(out, "  %hr.stripe.off = mul i64 %hr.stripe.idx, 64")
  codegen_util::cg_emit_line(out, "  %hr.stripes.ptr = inttoptr i64 %hr.stripes.i to ptr")
  codegen_util::cg_emit_line(out, "  %hr.mtx = getelementptr i8, ptr %hr.stripes.ptr, i64 %hr.stripe.off")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %hr.mtx)")
  codegen_util::cg_emit_line(out, "  %hr.buckets.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %hr.buckets.i = load i64, ptr %hr.buckets.p")
  codegen_util::cg_emit_line(out, "  %hr.buckets = inttoptr i64 %hr.buckets.i to ptr")
  codegen_util::cg_emit_line(out, "  %hr.mask.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %hr.mask = load i64, ptr %hr.mask.p")
  codegen_util::cg_emit_line(out, "  %hr.bucket.idx = and i64 %hr.hash, %hr.mask")
  codegen_util::cg_emit_line(out, "  %hr.head.gep = getelementptr i64, ptr %hr.buckets, i64 %hr.bucket.idx")
  codegen_util::cg_emit_line(out, "  %hr.head.i = load i64, ptr %hr.head.gep")
  codegen_util::cg_emit_line(out, "  br label %hr_walk")
  codegen_util::cg_emit_line(out, "hr_walk:")
  codegen_util::cg_emit_line(out, "  %hr.cur.i = phi i64 [%hr.head.i, %hr_lock], [%hr.next.i, %hr_advance]")
  codegen_util::cg_emit_line(out, "  %hr.cur.nz = icmp ne i64 %hr.cur.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %hr.cur.nz, label %hr_check, label %hr_insert")
  codegen_util::cg_emit_line(out, "hr_check:")
  codegen_util::cg_emit_line(out, "  %hr.cur.ptr = inttoptr i64 %hr.cur.i to ptr")
  codegen_util::cg_emit_line(out, "  %hr.cur.t.gep = getelementptr i8, ptr %hr.cur.ptr, i64 0")
  codegen_util::cg_emit_line(out, "  %hr.cur.t = load i64, ptr %hr.cur.t.gep")
  codegen_util::cg_emit_line(out, "  %hr.cur.w.gep = getelementptr i8, ptr %hr.cur.ptr, i64 8")
  codegen_util::cg_emit_line(out, "  %hr.cur.w = load i64, ptr %hr.cur.w.gep")
  codegen_util::cg_emit_line(out, "  %hr.t.match = icmp eq i64 %hr.cur.t, %hr.target")
  codegen_util::cg_emit_line(out, "  %hr.w.match = icmp eq i64 %hr.cur.w, %hr.waiter")
  codegen_util::cg_emit_line(out, "  %hr.both.match = and i1 %hr.t.match, %hr.w.match")
  codegen_util::cg_emit_line(out, "  br i1 %hr.both.match, label %hr_unlock, label %hr_advance")
  codegen_util::cg_emit_line(out, "hr_advance:")
  codegen_util::cg_emit_line(out, "  %hr.next.gep = getelementptr i8, ptr %hr.cur.ptr, i64 16")
  codegen_util::cg_emit_line(out, "  %hr.next.i = load i64, ptr %hr.next.gep")
  codegen_util::cg_emit_line(out, "  br label %hr_walk")
  codegen_util::cg_emit_line(out, "hr_insert:")
  codegen_util::cg_emit_line(out, "  %hr.cell = call ptr @__qz_alloc(i64 24)")
  codegen_util::cg_emit_line(out, "  %hr.cell.t.gep = getelementptr i8, ptr %hr.cell, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %hr.target, ptr %hr.cell.t.gep")
  codegen_util::cg_emit_line(out, "  %hr.cell.w.gep = getelementptr i8, ptr %hr.cell, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 %hr.waiter, ptr %hr.cell.w.gep")
  codegen_util::cg_emit_line(out, "  %hr.cell.n.gep = getelementptr i8, ptr %hr.cell, i64 16")
  codegen_util::cg_emit_line(out, "  store i64 %hr.head.i, ptr %hr.cell.n.gep")
  codegen_util::cg_emit_line(out, "  %hr.cell.i = ptrtoint ptr %hr.cell to i64")
  codegen_util::cg_emit_line(out, "  store i64 %hr.cell.i, ptr %hr.head.gep")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %hr.mtx)")
  codegen_util::cg_emit_line(out, "  ; bump count atomically; check grow trigger")
  codegen_util::cg_emit_line(out, "  %hr.cnt.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %hr.cnt.old = atomicrmw add ptr %hr.cnt.p, i64 1 seq_cst")
  codegen_util::cg_emit_line(out, "  %hr.cnt.new = add i64 %hr.cnt.old, 1")
  codegen_util::cg_emit_line(out, "  %hr.nb.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %hr.nb = load i64, ptr %hr.nb.p")
  codegen_util::cg_emit_line(out, "  %hr.nb.3 = mul i64 %hr.nb, 3")
  codegen_util::cg_emit_line(out, "  %hr.threshold = lshr i64 %hr.nb.3, 2")
  codegen_util::cg_emit_line(out, "  %hr.needs_grow = icmp ugt i64 %hr.cnt.new, %hr.threshold")
  codegen_util::cg_emit_line(out, "  br i1 %hr.needs_grow, label %hr_grow, label %hr_ret")
  codegen_util::cg_emit_line(out, "hr_grow:")
  codegen_util::cg_emit_line(out, "  call void @__qz_waiter_grow()")
  codegen_util::cg_emit_line(out, "  br label %hr_ret")
  codegen_util::cg_emit_line(out, "hr_unlock:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %hr.mtx)")
  codegen_util::cg_emit_line(out, "  br label %hr_ret")
  codegen_util::cg_emit_line(out, "hr_ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

