      codegen_util::cg_emit_line(out, "  %epev.fd = bitcast ptr %epev.fd.p to ptr")
      codegen_util::cg_emit_line(out, "  store i32 %fd.i32, ptr %epev.fd")
      codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %epfd, i32 1, i32 %fd.i32, ptr %epev.ptr)")
    end
