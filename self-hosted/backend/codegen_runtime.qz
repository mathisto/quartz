    codegen_util::cg_emit_line(out, "  %new_in_h.a3b = select i1 %is_alloc.a3b, i64 1, i64 %in_h_save.a3b")
    codegen_util::cg_emit_line(out, "  store i64 %new_in_h.a3b, ptr @__qz_alloc_in_handler, align 8")
    codegen_util::cg_emit_line(out, "  %rv = call i64 %h_ptr(ptr %op, i64 %argc, ptr %argv)")
