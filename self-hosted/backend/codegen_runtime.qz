  codegen_util::cg_emit_line(out, "  %thd.root_t = load i64, ptr %thd.root_t.gep")
  codegen_util::cg_emit_line(out, "  %thd.new_cnt = sub i64 %thd.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %thd.new_cnt, ptr %thd.cnt.p")
  codegen_util::cg_emit_line(out, "  %thd.now_empty = icmp eq i64 %thd.new_cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %thd.now_empty, label %thd_after_sift, label %thd_move_last")
  codegen_util::cg_emit_line(out, "thd_move_last:")
