  codegen_util::cg_emit_line(out, "  %tl.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_task_locals, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %tl.cap.ptr")
