  # a Vec<Int> stores 8-byte inline elements, so element i is data[i].
  codegen_util::cg_emit_line(out, "define i64 @qz_str_from_bytes(i64 %vec) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %len = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i64 = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i64 to ptr")
  codegen_util::cg_emit_line(out, "  %buf = call ptr @qz_alloc_str(i64 %len)")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i64 %len, 0")
  codegen_util::cg_emit_line(out, "  br i1 %empty, label %done, label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]")
  codegen_util::cg_emit_line(out, "  %eslot = getelementptr i64, ptr %data, i64 %i")
  codegen_util::cg_emit_line(out, "  %elem = load i64, ptr %eslot")
  codegen_util::cg_emit_line(out, "  %byte = trunc i64 %elem to i8")
  codegen_util::cg_emit_line(out, "  %cp = getelementptr i8, ptr %buf, i64 %i")
  codegen_util::cg_emit_line(out, "  store i8 %byte, ptr %cp")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  %cont = icmp ult i64 %i.next, %len")
  codegen_util::cg_emit_line(out, "  br i1 %cont, label %loop, label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  %res = ptrtoint ptr %buf to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %res")
