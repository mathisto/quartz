  codegen_util::cg_emit_line(out, "  %thp.cnt.next = add i64 %thp.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %thp.cnt.next, ptr %thp.cnt.p")
  codegen_util::cg_emit_line(out, "  br label %thp_su_loop")
