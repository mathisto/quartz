  codegen_util::cg_emit_line(out, "  %pc.gmtx.i = load i64, ptr %pc.gmtx.p")
  codegen_util::cg_emit_line(out, "  %pc.gmtx = inttoptr i64 %pc.gmtx.i to ptr")
