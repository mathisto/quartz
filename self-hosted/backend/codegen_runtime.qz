  # deliveries route through it.
  codegen_util::cg_emit_line(out, "define void @qz_signal_on_flag(i64 %sig, i64 %flag) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %sig32 = trunc i64 %sig to i32")
  codegen_util::cg_emit_line(out, "  %fptr = inttoptr i64 %flag to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i32 [0, %entry], [%i.next, %next]")
  codegen_util::cg_emit_line(out, "  %end = icmp uge i32 %i, 32")
  codegen_util::cg_emit_line(out, "  br i1 %end, label %register, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %i64 = sext i32 %i to i64")
  codegen_util::cg_emit_line(out, "  %sptr = getelementptr inbounds [32 x i32], ptr @qz_signal_signum_table, i64 0, i64 %i64")
  codegen_util::cg_emit_line(out, "  %s = load i32, ptr %sptr, align 4")
  codegen_util::cg_emit_line(out, "  %match = icmp eq i32 %s, %sig32")
  codegen_util::cg_emit_line(out, "  %empty = icmp eq i32 %s, 0")
