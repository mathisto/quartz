  codegen_util::cg_emit_line(out, "  %ep.ts = add i64 %ep.base, 2")
  codegen_util::cg_emit_line(out, "  %ep.cs = add i64 %ep.base, 3")
  codegen_util::cg_emit_line(out, "  %ep.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 %ep.qs")
  codegen_util::cg_emit_line(out, "  %ep.q.i = load i64, ptr %ep.q.p")
  codegen_util::cg_emit_line(out, "  %ep.q = inttoptr i64 %ep.q.i to ptr")
  codegen_util::cg_emit_line(out, "  %ep.t.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 %ep.ts")
  codegen_util::cg_emit_line(out, "  %ep.tail = load i64, ptr %ep.t.p")
  codegen_util::cg_emit_line(out, "  %ep.slot = getelementptr i64, ptr %ep.q, i64 %ep.tail")
  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %ep.slot")
  codegen_util::cg_emit_line(out, "  %ep.t1 = add i64 %ep.tail, 1")
  codegen_util::cg_emit_line(out, "  %ep.tw = and i64 %ep.t1, 65535")
  codegen_util::cg_emit_line(out, "  store i64 %ep.tw, ptr %ep.t.p")
  codegen_util::cg_emit_line(out, "  %ep.c.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 %ep.cs")
  codegen_util::cg_emit_line(out, "  %ep.cnt = load i64, ptr %ep.c.p")
  codegen_util::cg_emit_line(out, "  %ep.cnt1 = add i64 %ep.cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %ep.cnt1, ptr %ep.c.p")
  codegen_util::cg_emit_line(out, "  br label %enq_done")
  codegen_util::cg_emit_line(out, "enq_done:")
  # active_tasks++ (protected by mutex)
  codegen_util::cg_emit_line(out, "  %at.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  %at.old = atomicrmw add ptr %at.p, i64 1 seq_cst")
