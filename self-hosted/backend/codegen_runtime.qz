    # already dead (or a zombie), kevent returns the event immediately and we
    # re-enqueue without going through the poller loop.
    codegen_util::cg_emit_line(out, "  %pkev.out = alloca [32 x i8]")
    codegen_util::cg_emit_line(out, "  %pkev.out.ptr = bitcast [32 x i8]* %pkev.out to ptr")
    codegen_util::cg_emit_line(out, "  %pkev.ts = alloca [16 x i8]")
    codegen_util::cg_emit_line(out, "  %pkev.ts.ptr = bitcast [16 x i8]* %pkev.ts to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %pkev.ts.ptr, i32 0, i64 16)")
    codegen_util::cg_emit_line(out, "  %pkev.n = call i32 @kevent(i32 %epfd, ptr %pkev.ptr, i32 1, ptr %pkev.out.ptr, i32 1, ptr %pkev.ts.ptr)")
    codegen_util::cg_emit_line(out, "  %pkev.imm = icmp sgt i32 %pkev.n, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pkev.imm, label %pkev_imm, label %pkev_register_failed_check")
    codegen_util::cg_emit_line(out, "pkev_imm:")
    # Already dead — re-enqueue task directly
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "pkev_register_failed_check:")
    # n == 0: registered, will fire later. n < 0: error (e.g. ESRCH if pid invalid).
    codegen_util::cg_emit_line(out, "  %pkev.err = icmp slt i32 %pkev.n, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pkev.err, label %pkev_err_reenq, label %pkev_done")
    codegen_util::cg_emit_line(out, "pkev_err_reenq:")
    # Bad pid (e.g. ESRCH) — re-enqueue immediately so user code can detect
    # the error via waitpid rather than hanging forever
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "pkev_done:")
    codegen_util::cg_emit_line(out, "  ret void")
  else
    # Linux: pidfd_open returns a pollable fd that becomes readable on exit
    codegen_util::cg_emit_line(out, "  %pfd.raw = call i32 @pidfd_open(i32 %pid.i32, i32 0)")
    codegen_util::cg_emit_line(out, "  %pfd.ok = icmp sge i32 %pfd.raw, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pfd.ok, label %pfd_have, label %pfd_fail_reenq")
    codegen_util::cg_emit_line(out, "pfd_fail_reenq:")
    # pidfd_open failed — re-enqueue task immediately so user code can detect
    # the error via waitpid (or carry on if the child was already reaped)
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "pfd_have:")
    codegen_util::cg_emit_line(out, "  %pfd.i64 = sext i32 %pfd.raw to i64")
    # Guard: io_map is sized for fds < 65536
    codegen_util::cg_emit_line(out, "  %pfd.in_range = icmp slt i64 %pfd.i64, 65536")
    codegen_util::cg_emit_line(out, "  br i1 %pfd.in_range, label %pfd_register, label %pfd_too_high")
    codegen_util::cg_emit_line(out, "pfd_too_high:")
