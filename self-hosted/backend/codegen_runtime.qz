  codegen_util::cg_emit_line(out, "  %bn.store.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
  codegen_util::cg_emit_line(out, "  store i64 %bn.ptr, ptr %bn.store.p")
