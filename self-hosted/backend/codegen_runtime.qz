  # If sched_wake already set WAKE_PENDING(2), re-enqueue instead of parking.
  codegen_util::cg_emit_line(out, "  %pk.ps.p = getelementptr i64, ptr %task.p, i64 5")
  codegen_util::cg_emit_line(out, "  %pk.cas = cmpxchg ptr %pk.ps.p, i64 0, i64 1 acq_rel monotonic")
  codegen_util::cg_emit_line(out, "  %pk.old = extractvalue {i64, i1} %pk.cas, 0")
  codegen_util::cg_emit_line(out, "  %pk.was_wp = icmp eq i64 %pk.old, 2")
  codegen_util::cg_emit_line(out, "  br i1 %pk.was_wp, label %task_park_woken, label %task_park_done")
  codegen_util::cg_emit_line(out, "task_park_woken:")
