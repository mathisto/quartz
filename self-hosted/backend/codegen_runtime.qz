  codegen_util::cg_emit_line(out, "  br i1 %thd.is_tomb, label %thd_drain_loop, label %thd_unlock_ok")
  codegen_util::cg_emit_line(out, "thd_unlock_ok:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %thd.mtx)")
