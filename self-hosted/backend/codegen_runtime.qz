  codegen_util::cg_emit_line(out, "  %bni.busy.p = getelementptr i64, ptr %bni.slot, i64 8")
  codegen_util::cg_emit_line(out, "  %bni.val = load i64, ptr %bni.busy.p")
  codegen_util::cg_emit_line(out, "  %bni.dst = getelementptr i64, ptr %bn.mem, i64 %bni")
