  codegen_util::cg_emit_line(out, "  %trd.has_mtx = icmp ne i64 %trd.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %trd.has_mtx, label %trd_scan, label %trd_ret")
  codegen_util::cg_emit_line(out, "trd_scan:")
  codegen_util::cg_emit_line(out, "  %trd.mtx = inttoptr i64 %trd.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %trd.mtx)")
  codegen_util::cg_emit_line(out, "  %trd.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %trd.cnt = load i64, ptr %trd.cnt.p")
  codegen_util::cg_emit_line(out, "  %trd.arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %trd.arr.i = load i64, ptr %trd.arr.p")
  codegen_util::cg_emit_line(out, "  %trd.arr = inttoptr i64 %trd.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %trd_loop")
  codegen_util::cg_emit_line(out, "trd_loop:")
  codegen_util::cg_emit_line(out, "  %trd.i = phi i64 [0, %trd_scan], [%trd.i.next, %trd_next]")
  codegen_util::cg_emit_line(out, "  %trd.done = icmp sge i64 %trd.i, %trd.cnt")
  codegen_util::cg_emit_line(out, "  br i1 %trd.done, label %trd_unlock, label %trd_check")
  codegen_util::cg_emit_line(out, "trd_check:")
