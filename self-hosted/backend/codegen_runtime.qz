  codegen_util::cg_emit_line(out, "  %td.was_last = icmp eq i64 %td.at.old, 1")
  codegen_util::cg_emit_line(out, "  br i1 %td.was_last, label %td_signal, label %td_skip")
  codegen_util::cg_emit_line(out, "td_signal:")
