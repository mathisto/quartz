  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %hu.mtx)")
  codegen_util::cg_emit_line(out, "  %hu.buckets.p = getelementptr [8 x i64], [8 x i64]* @__qz_waiters, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %hu.buckets.i = load i64, ptr %hu.buckets.p")
