  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.p = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.p")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.n, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %fin, label %chk")
  codegen_util::cg_emit_line(out, "chk:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %a.keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %occ = icmp ugt i64 %k, 1")
  codegen_util::cg_emit_line(out, "  br i1 %occ, label %test, label %cont")
  codegen_util::cg_emit_line(out, "test:")
  codegen_util::cg_emit_line(out, "  %inb = call i64 @qz_map_custom_has(i64 %b, i64 %k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  %isout = icmp eq i64 %inb, 0")
  codegen_util::cg_emit_line(out, "  br i1 %isout, label %add, label %cont")
  codegen_util::cg_emit_line(out, "add:")
  codegen_util::cg_emit_line(out, "  call void @qz_map_custom_set(i64 %new, i64 %k, i64 %k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  br label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.n = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "fin:")
  codegen_util::cg_emit_line(out, "  ret i64 %new")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_set_custom_is_subset(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) -> i64
## 1 iff every occupied key of a is a member of b (by value).
def _cg_emit_set_custom_is_subset(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_set_custom_is_subset(i64 %a, i64 %b, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %a.hdr = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %a.cap = load i64, ptr %a.hdr")
  codegen_util::cg_emit_line(out, "  %a.keys.p = getelementptr i64, ptr %a.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %a.keys.i = load i64, ptr %a.keys.p")
  codegen_util::cg_emit_line(out, "  %a.keys = inttoptr i64 %a.keys.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.n, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %a.cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %yes, label %chk")
  codegen_util::cg_emit_line(out, "chk:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %a.keys, i64 %i")
  codegen_util::cg_emit_line(out, "  %k = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %occ = icmp ugt i64 %k, 1")
  codegen_util::cg_emit_line(out, "  br i1 %occ, label %test, label %cont")
  codegen_util::cg_emit_line(out, "test:")
  codegen_util::cg_emit_line(out, "  %inb = call i64 @qz_map_custom_has(i64 %b, i64 %k, ptr %hash_fn, ptr %eq_fn)")
  codegen_util::cg_emit_line(out, "  %isout = icmp eq i64 %inb, 0")
  codegen_util::cg_emit_line(out, "  br i1 %isout, label %no, label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.n = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "yes:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "no:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_map_custom_get(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) -> i64
## Returns Option: Some(value) on match, None on miss.
def _cg_emit_map_custom_get(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_map_custom_get(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  # Load header
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %map to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %mask = sub i64 %cap, 1")
  codegen_util::cg_emit_line(out, "  %keys_p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys_i = load i64, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys_i to ptr")
  codegen_util::cg_emit_line(out, "  %vals_p = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  %vals_i = load i64, ptr %vals_p")
  codegen_util::cg_emit_line(out, "  %vals = inttoptr i64 %vals_i to ptr")
  # Hash key
  codegen_util::cg_emit_line(out, "  %hash = call i64 %hash_fn(i64 %key)")
  codegen_util::cg_emit_line(out, "  %start = and i64 %hash, %mask")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # Probe loop
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %idx = phi i64 [%start, %entry], [%next, %cont]")
  codegen_util::cg_emit_line(out, "  %cnt = phi i64 [0, %entry], [%cntn, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %cnt, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %not_found, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %keys, i64 %idx")
  codegen_util::cg_emit_line(out, "  %slotv = load i64, ptr %slot")
  # Empty (0) → not found
  codegen_util::cg_emit_line(out, "  %is_empty = icmp eq i64 %slotv, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_empty, label %not_found, label %check_tomb")
  # Tombstone (1) → skip
  codegen_util::cg_emit_line(out, "check_tomb:")
  codegen_util::cg_emit_line(out, "  %is_tomb = icmp eq i64 %slotv, 1")
  codegen_util::cg_emit_line(out, "  br i1 %is_tomb, label %cont, label %compare")
  # Compare via eq_fn
  codegen_util::cg_emit_line(out, "compare:")
  codegen_util::cg_emit_line(out, "  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)")
  codegen_util::cg_emit_line(out, "  %is_eq = icmp ne i64 %eq, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_eq, label %found, label %cont")
  # Continue probing
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %next_raw = add i64 %idx, 1")
  codegen_util::cg_emit_line(out, "  %next = and i64 %next_raw, %mask")
  codegen_util::cg_emit_line(out, "  %cntn = add i64 %cnt, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # Found: build Option::Some(value)
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  %vslot = getelementptr i64, ptr %vals, i64 %idx")
  codegen_util::cg_emit_line(out, "  %val = load i64, ptr %vslot")
  codegen_util::cg_emit_line(out, "  %some_mem = call ptr @__qz_alloc(i64 16)")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %some_mem")
  codegen_util::cg_emit_line(out, "  %some_vp = getelementptr i64, ptr %some_mem, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %some_vp")
  codegen_util::cg_emit_line(out, "  %some_r = ptrtoint ptr %some_mem to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %some_r")
  # Not found: build Option::None
  codegen_util::cg_emit_line(out, "not_found:")
  codegen_util::cg_emit_line(out, "  %none_mem = call ptr @__qz_alloc(i64 16)")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %none_mem")
  codegen_util::cg_emit_line(out, "  %none_vp = getelementptr i64, ptr %none_mem, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %none_vp")
  codegen_util::cg_emit_line(out, "  %none_r = ptrtoint ptr %none_mem to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %none_r")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_map_custom_has(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) -> i64
## Returns 1 if key exists, 0 otherwise.
def _cg_emit_map_custom_has(out: Int): Void
  codegen_util::cg_emit_line(out, "define i64 @qz_map_custom_has(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %map to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %mask = sub i64 %cap, 1")
  codegen_util::cg_emit_line(out, "  %keys_p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys_i = load i64, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys_i to ptr")
  codegen_util::cg_emit_line(out, "  %hash = call i64 %hash_fn(i64 %key)")
  codegen_util::cg_emit_line(out, "  %start = and i64 %hash, %mask")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %idx = phi i64 [%start, %entry], [%next, %cont]")
  codegen_util::cg_emit_line(out, "  %cnt = phi i64 [0, %entry], [%cntn, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %cnt, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %not_found, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %keys, i64 %idx")
  codegen_util::cg_emit_line(out, "  %slotv = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %is_empty = icmp eq i64 %slotv, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_empty, label %not_found, label %check_tomb")
  codegen_util::cg_emit_line(out, "check_tomb:")
  codegen_util::cg_emit_line(out, "  %is_tomb = icmp eq i64 %slotv, 1")
  codegen_util::cg_emit_line(out, "  br i1 %is_tomb, label %cont, label %compare")
  codegen_util::cg_emit_line(out, "compare:")
  codegen_util::cg_emit_line(out, "  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)")
  codegen_util::cg_emit_line(out, "  %is_eq = icmp ne i64 %eq, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_eq, label %found, label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %next_raw = add i64 %idx, 1")
  codegen_util::cg_emit_line(out, "  %next = and i64 %next_raw, %mask")
  codegen_util::cg_emit_line(out, "  %cntn = add i64 %cnt, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "not_found:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_map_custom_rehash(i64 %map, ptr %hash_fn) -> void
## Doubles capacity and re-inserts all occupied entries using hash_fn.
def _cg_emit_map_custom_rehash(out: Int): Void
  codegen_util::cg_emit_line(out, "define void @qz_map_custom_rehash(i64 %map, ptr %hash_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %map to ptr")
  codegen_util::cg_emit_line(out, "  %old_cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %keys_p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %old_keys_i = load i64, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %old_keys = inttoptr i64 %old_keys_i to ptr")
  codegen_util::cg_emit_line(out, "  %vals_p = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  %old_vals_i = load i64, ptr %vals_p")
  codegen_util::cg_emit_line(out, "  %old_vals = inttoptr i64 %old_vals_i to ptr")
  # New capacity = old * 2 (min 4)
  codegen_util::cg_emit_line(out, "  %new_cap_raw = mul i64 %old_cap, 2")
  codegen_util::cg_emit_line(out, "  %too_small = icmp slt i64 %new_cap_raw, 4")
  codegen_util::cg_emit_line(out, "  %new_cap = select i1 %too_small, i64 4, i64 %new_cap_raw")
  codegen_util::cg_emit_line(out, "  %new_mask = sub i64 %new_cap, 1")
  codegen_util::cg_emit_line(out, "  %new_bytes = mul i64 %new_cap, 8")
  # Allocate new arrays
  codegen_util::cg_emit_line(out, "  %new_keys = call ptr @__qz_alloc(i64 %new_bytes)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %new_keys, i32 0, i64 %new_bytes)")
  codegen_util::cg_emit_line(out, "  %new_vals = call ptr @__qz_alloc(i64 %new_bytes)")
  # Rehash loop over old slots
  codegen_util::cg_emit_line(out, "  br label %rh_loop")
  codegen_util::cg_emit_line(out, "rh_loop:")
  codegen_util::cg_emit_line(out, "  %ri = phi i64 [0, %entry], [%ri_next, %rh_cont]")
  codegen_util::cg_emit_line(out, "  %rh_done = icmp sge i64 %ri, %old_cap")
  codegen_util::cg_emit_line(out, "  br i1 %rh_done, label %rh_finish, label %rh_check")
  codegen_util::cg_emit_line(out, "rh_check:")
  codegen_util::cg_emit_line(out, "  %old_kslot = getelementptr i64, ptr %old_keys, i64 %ri")
  codegen_util::cg_emit_line(out, "  %old_key = load i64, ptr %old_kslot")
  # Skip empty (0) and tombstone (1)
  codegen_util::cg_emit_line(out, "  %rh_valid = icmp ugt i64 %old_key, 1")
  codegen_util::cg_emit_line(out, "  br i1 %rh_valid, label %rh_copy, label %rh_cont")
  # Hash old key into new table
  codegen_util::cg_emit_line(out, "rh_copy:")
  codegen_util::cg_emit_line(out, "  %old_vslot = getelementptr i64, ptr %old_vals, i64 %ri")
  codegen_util::cg_emit_line(out, "  %old_val = load i64, ptr %old_vslot")
  codegen_util::cg_emit_line(out, "  %rh_hash = call i64 %hash_fn(i64 %old_key)")
  codegen_util::cg_emit_line(out, "  %rh_start = and i64 %rh_hash, %new_mask")
  codegen_util::cg_emit_line(out, "  br label %rh_probe")
  codegen_util::cg_emit_line(out, "rh_probe:")
  codegen_util::cg_emit_line(out, "  %rh_pi = phi i64 [%rh_start, %rh_copy], [%rh_pnext, %rh_probe_cont]")
  codegen_util::cg_emit_line(out, "  %nk_slot = getelementptr i64, ptr %new_keys, i64 %rh_pi")
  codegen_util::cg_emit_line(out, "  %nk_val = load i64, ptr %nk_slot")
  codegen_util::cg_emit_line(out, "  %nk_empty = icmp eq i64 %nk_val, 0")
  codegen_util::cg_emit_line(out, "  br i1 %nk_empty, label %rh_insert, label %rh_probe_cont")
  codegen_util::cg_emit_line(out, "rh_probe_cont:")
  codegen_util::cg_emit_line(out, "  %rh_pnext_raw = add i64 %rh_pi, 1")
  codegen_util::cg_emit_line(out, "  %rh_pnext = and i64 %rh_pnext_raw, %new_mask")
  codegen_util::cg_emit_line(out, "  br label %rh_probe")
  codegen_util::cg_emit_line(out, "rh_insert:")
  codegen_util::cg_emit_line(out, "  store i64 %old_key, ptr %nk_slot")
  codegen_util::cg_emit_line(out, "  %nv_slot = getelementptr i64, ptr %new_vals, i64 %rh_pi")
  codegen_util::cg_emit_line(out, "  store i64 %old_val, ptr %nv_slot")
  codegen_util::cg_emit_line(out, "  br label %rh_cont")
  codegen_util::cg_emit_line(out, "rh_cont:")
  codegen_util::cg_emit_line(out, "  %ri_next = add i64 %ri, 1")
  codegen_util::cg_emit_line(out, "  br label %rh_loop")
  # Update header, free old arrays
  codegen_util::cg_emit_line(out, "rh_finish:")
  codegen_util::cg_emit_line(out, "  store i64 %new_cap, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %new_keys_i = ptrtoint ptr %new_keys to i64")
  codegen_util::cg_emit_line(out, "  store i64 %new_keys_i, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %new_vals_i = ptrtoint ptr %new_vals to i64")
  codegen_util::cg_emit_line(out, "  store i64 %new_vals_i, ptr %vals_p")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %old_keys)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %old_vals)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_map_custom_set(i64 %map, i64 %key, i64 %val, ptr %hash_fn, ptr %eq_fn) -> void
## Inserts or updates key/value. Rehashes if load factor >= 75%.
def _cg_emit_map_custom_set(out: Int): Void
  codegen_util::cg_emit_line(out, "define void @qz_map_custom_set(i64 %map, i64 %key, i64 %val, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %map to ptr")
  # Load size and capacity, check load factor
  codegen_util::cg_emit_line(out, "  %cap0 = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %size_p = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size0 = load i64, ptr %size_p")
  codegen_util::cg_emit_line(out, "  %thresh = mul i64 %cap0, 3")
  codegen_util::cg_emit_line(out, "  %thresh2 = sdiv i64 %thresh, 4")
  codegen_util::cg_emit_line(out, "  %need_resize = icmp sge i64 %size0, %thresh2")
  codegen_util::cg_emit_line(out, "  br i1 %need_resize, label %do_rehash, label %search")
  codegen_util::cg_emit_line(out, "do_rehash:")
  codegen_util::cg_emit_line(out, "  call void @qz_map_custom_rehash(i64 %map, ptr %hash_fn)")
  codegen_util::cg_emit_line(out, "  br label %search")
  # Search for slot (re-read header after potential rehash)
  codegen_util::cg_emit_line(out, "search:")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %mask = sub i64 %cap, 1")
  codegen_util::cg_emit_line(out, "  %keys_p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys_i = load i64, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys_i to ptr")
  codegen_util::cg_emit_line(out, "  %vals_pp = getelementptr i64, ptr %hdr, i64 3")
  codegen_util::cg_emit_line(out, "  %vals_i = load i64, ptr %vals_pp")
  codegen_util::cg_emit_line(out, "  %vals = inttoptr i64 %vals_i to ptr")
  codegen_util::cg_emit_line(out, "  %hash = call i64 %hash_fn(i64 %key)")
  codegen_util::cg_emit_line(out, "  %start = and i64 %hash, %mask")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # Probe loop
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %idx = phi i64 [%start, %search], [%next, %cont]")
  codegen_util::cg_emit_line(out, "  %pcnt = phi i64 [0, %search], [%pcntn, %cont]")
  codegen_util::cg_emit_line(out, "  %pdone = icmp sge i64 %pcnt, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %pdone, label %done, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %keys, i64 %idx")
  codegen_util::cg_emit_line(out, "  %slotv = load i64, ptr %slot")
  # Empty (0) or tombstone (1) → insert here
  codegen_util::cg_emit_line(out, "  %avail = icmp ule i64 %slotv, 1")
  codegen_util::cg_emit_line(out, "  br i1 %avail, label %store, label %cmp")
  # Compare existing key
  codegen_util::cg_emit_line(out, "cmp:")
  codegen_util::cg_emit_line(out, "  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)")
  codegen_util::cg_emit_line(out, "  %is_eq = icmp ne i64 %eq, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_eq, label %update, label %cont")
  # Continue probing
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %next_raw = add i64 %idx, 1")
  codegen_util::cg_emit_line(out, "  %next = and i64 %next_raw, %mask")
  codegen_util::cg_emit_line(out, "  %pcntn = add i64 %pcnt, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # New entry: store key + value, increment size
  codegen_util::cg_emit_line(out, "store:")
  codegen_util::cg_emit_line(out, "  store i64 %key, ptr %slot")
  codegen_util::cg_emit_line(out, "  %vslot = getelementptr i64, ptr %vals, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %vslot")
  codegen_util::cg_emit_line(out, "  %sz = load i64, ptr %size_p")
  codegen_util::cg_emit_line(out, "  %sz1 = add i64 %sz, 1")
  codegen_util::cg_emit_line(out, "  store i64 %sz1, ptr %size_p")
  codegen_util::cg_emit_line(out, "  ret void")
  # Existing entry: update value only
  codegen_util::cg_emit_line(out, "update:")
  codegen_util::cg_emit_line(out, "  %uvslot = getelementptr i64, ptr %vals, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %uvslot")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

## @qz_map_custom_delete(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) -> void
## Finds key and sets slot to tombstone (1). Decrements size on match.
def _cg_emit_map_custom_delete(out: Int): Void
  codegen_util::cg_emit_line(out, "define void @qz_map_custom_delete(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %map to ptr")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %hdr")
  codegen_util::cg_emit_line(out, "  %mask = sub i64 %cap, 1")
  codegen_util::cg_emit_line(out, "  %size_p = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %keys_p = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %keys_i = load i64, ptr %keys_p")
  codegen_util::cg_emit_line(out, "  %keys = inttoptr i64 %keys_i to ptr")
  codegen_util::cg_emit_line(out, "  %hash = call i64 %hash_fn(i64 %key)")
  codegen_util::cg_emit_line(out, "  %start = and i64 %hash, %mask")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %idx = phi i64 [%start, %entry], [%next, %cont]")
  codegen_util::cg_emit_line(out, "  %cnt = phi i64 [0, %entry], [%cntn, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %cnt, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %end, label %check")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %keys, i64 %idx")
  codegen_util::cg_emit_line(out, "  %slotv = load i64, ptr %slot")
  codegen_util::cg_emit_line(out, "  %is_empty = icmp eq i64 %slotv, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_empty, label %end, label %check_tomb")
  codegen_util::cg_emit_line(out, "check_tomb:")
  codegen_util::cg_emit_line(out, "  %is_tomb = icmp eq i64 %slotv, 1")
  codegen_util::cg_emit_line(out, "  br i1 %is_tomb, label %cont, label %compare")
  codegen_util::cg_emit_line(out, "compare:")
  codegen_util::cg_emit_line(out, "  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)")
  codegen_util::cg_emit_line(out, "  %is_eq = icmp ne i64 %eq, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_eq, label %found, label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %next_raw = add i64 %idx, 1")
  codegen_util::cg_emit_line(out, "  %next = and i64 %next_raw, %mask")
  codegen_util::cg_emit_line(out, "  %cntn = add i64 %cnt, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # Found: tombstone the slot, decrement size
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %slot")
  codegen_util::cg_emit_line(out, "  %sz = load i64, ptr %size_p")
  codegen_util::cg_emit_line(out, "  %sz1 = sub i64 %sz, 1")
  codegen_util::cg_emit_line(out, "  store i64 %sz1, ptr %size_p")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "end:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
end

# ============================================================================
# Composable Runtime Emission for Separate Compilation (P.3)
# ============================================================================

## Emit runtime globals with definitions (main module only).
def cg_emit_runtime_globals_define(out: Int): Void
  codegen_util::cg_emit_line(out, "@qz_argc = global i64 0")
  codegen_util::cg_emit_line(out, "@qz_argv = global ptr null")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@qz_rng_s0 = global i64 1234567890123456789")
  codegen_util::cg_emit_line(out, "@qz_rng_s1 = global i64 9876543210987654321")
  codegen_util::cg_emit_line(out, "@qz_rng_s2 = global i64 3141592653589793238")
  codegen_util::cg_emit_line(out, "@qz_rng_s3 = global i64 2718281828459045235")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@__qz_panic_key = global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_panic_key_once = global i64 0")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@__qz_current_frame = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_task_id_counter = global i64 1")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_timeout = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_events = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_sleep_ms = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_is_proc = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_sched_park_pending = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_current_worker_id = thread_local global i64 -1")
  codegen_util::cg_emit_line(out, "@__qz_sched_fuel = thread_local global i64 9223372036854775807")
  codegen_util::cg_emit_line(out, "@__qz_poll_sample_ctr = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_lifo_task = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_lifo_count = thread_local global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_signal_shutdown = global i64 0")
  # @__qz_sched: unconditional (try_send/channel_close reference it for recv_q wakeup)
  codegen_util::cg_emit_line(out, "@__qz_sched = global [36 x i64] zeroinitializer")
  codegen_util::cg_emit_line(out, "")
end

## Emit runtime globals as external declarations (non-main modules).
def cg_emit_runtime_globals_declare(out: Int): Void
  codegen_util::cg_emit_line(out, "@qz_argc = external global i64")
  codegen_util::cg_emit_line(out, "@qz_argv = external global ptr")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@qz_rng_s0 = external global i64")
  codegen_util::cg_emit_line(out, "@qz_rng_s1 = external global i64")
  codegen_util::cg_emit_line(out, "@qz_rng_s2 = external global i64")
  codegen_util::cg_emit_line(out, "@qz_rng_s3 = external global i64")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@__qz_panic_key = external global i64")
  codegen_util::cg_emit_line(out, "@__qz_panic_key_once = external global i64")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "@__qz_current_frame = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_task_id_counter = external global i64")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_timeout = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_events = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_sleep_ms = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_io_pending_is_proc = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_sched_park_pending = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_current_worker_id = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_sched_fuel = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_poll_sample_ctr = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_lifo_task = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_lifo_count = external thread_local global i64")
  codegen_util::cg_emit_line(out, "@__qz_signal_shutdown = external global i64")
  codegen_util::cg_emit_line(out, "@__qz_sched = external global [36 x i64]")
  codegen_util::cg_emit_line(out, "")
end

## Emit all runtime helper function definitions with linkonce_odr linkage.
## Emits the full runtime from cg_emit_runtime_decls into a temp buffer, then
## post-processes to make all function definitions linkonce_odr and all private
## constants linkonce_odr unnamed_addr. Duplicate `declare` statements are harmless
## in LLVM IR (linker resolves them). Globals are stripped and handled separately.
def cg_emit_runtime_helpers_linkonce(out: Int, target: String, uses_task_group: Int, uses_scheduler: Int, uses_scope_deadline: Int): Void
  var buf = sb_new()
  cg_emit_runtime_decls(buf, target, uses_task_group, uses_scheduler, uses_scope_deadline)
  var ir = buf.to_string()
  sb_free(buf)

  # Post-process: add linkonce_odr to all function definitions
  # Step 1: Strip existing linkage keywords to normalize
  var result = str_replace(ir, "\ndefine private ", "\ndefine ")
  result = str_replace(result, "\ndefine internal ", "\ndefine ")
  # Step 2: Add linkonce_odr to all function definitions uniformly
  result = str_replace(result, "\ndefine ", "\ndefine linkonce_odr ")
  # Private constants referenced by linkonce_odr functions must also be linkonce_odr
  result = str_replace(result, " = private unnamed_addr constant", " = linkonce_odr unnamed_addr constant")
  result = str_replace(result, " = private constant", " = linkonce_odr unnamed_addr constant")
  # Remove global definitions (caller handles these separately)
  result = str_replace(result, "@qz_argc = global i64 0\n", "")
  result = str_replace(result, "@qz_argv = global ptr null\n", "")
  result = str_replace(result, "@qz_rng_s0 = internal global i64 1234567890123456789\n", "")
  result = str_replace(result, "@qz_rng_s1 = internal global i64 9876543210987654321\n", "")
  result = str_replace(result, "@qz_rng_s2 = internal global i64 3141592653589793238\n", "")
  result = str_replace(result, "@qz_rng_s3 = internal global i64 2718281828459045235\n", "")
  # Strip panic key globals (defined/declared by cg_emit_runtime_globals_define/declare)
  result = str_replace(result, "@__qz_panic_key = global i64 0\n", "")
  result = str_replace(result, "@__qz_panic_key_once = global i64 0\n", "")
  # Strip cancel key globals (task_group-specific, emitted inline)
  result = str_replace(result, "@__qz_cancel_key = global i64 0\n", "")
  result = str_replace(result, "@__qz_cancel_key_once = global i64 0\n", "")
  # Strip async frame tracking globals (defined/declared by cg_emit_runtime_globals_define/declare)
  result = str_replace(result, "@__qz_current_frame = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_task_id_counter = global i64 1\n", "")
  result = str_replace(result, "@__qz_io_pending_timeout = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_io_pending_events = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_io_pending_sleep_ms = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_io_pending_is_proc = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_timer_peers = global i64 0\n", "")
  result = str_replace(result, "@__qz_sched_fuel = thread_local global i64 9223372036854775807\n", "")
  result = str_replace(result, "@__qz_poll_sample_ctr = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_signal_shutdown = global i64 0\n", "")
  result = str_replace(result, "@__qz_sched_park_pending = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_current_worker_id = thread_local global i64 -1\n", "")
  result = str_replace(result, "@__qz_lifo_task = thread_local global i64 0\n", "")
  result = str_replace(result, "@__qz_lifo_count = thread_local global i64 0\n", "")
  # Strip @__qz_sched (unconditional, handled by globals_define/declare)
  result = str_replace(result, "@__qz_sched = global [36 x i64] zeroinitializer\n", "")
  # Remaining `= global ...` declarations emitted by cg_emit_runtime_decls
  # (e.g. @__qz_completion_map, @__qz_timer_ident, @__qz_trace, @__qz_task_locals,
  # @__qz_task_registry, ...) need linkonce_odr in separate compilation so they
  # don't produce duplicate-symbol link errors across per-module fragments.
  # Convert any unstripped `= global` (hosted runtime bookkeeping tables) to
  # `= linkonce_odr global`. Note: external declares (`= external global`) and
  # thread_local variants are untouched — they don't have a body to deduplicate.
  result = str_replace(result, " = global ", " = linkonce_odr global ")
  # Strip ALPN protos constant (private, will be duplicated in linkonce safely)
  # No action needed — private constants are converted to linkonce_odr unnamed_addr above
  # Remove target info (caller emits this separately)
  result = str_replace(result, "target datalayout", "; target datalayout")
  result = str_replace(result, "target triple", "; target triple")

  sb_append(out, result)
end

# ============================================================================
# Race Detector Runtime (Phase 11)
# ============================================================================
#
# Emits LLVM IR functions for runtime data race detection.
# Shadow memory: 4 slots per 8-byte app word, direct-mapped.
# Vector clocks: per-thread, 64 entries max.
# Happens-before: acquire/release on sync object addresses.

def cg_emit_race_detector_runtime(out: Int, target: String): Void
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "; === Race Detector Runtime (Phase 11) ===")
  codegen_util::cg_emit_line(out, "")
  # Globals
  codegen_util::cg_emit_line(out, "@__qz_race_shadow = internal global ptr null")
  codegen_util::cg_emit_line(out, "@__qz_race_enabled = internal global i64 0")
  codegen_util::cg_emit_line(out, "@__qz_race_tid_counter = internal global i64 1")
  codegen_util::cg_emit_line(out, "@__qz_race_vc_slots = internal global ptr null")
  codegen_util::cg_emit_line(out, "@__qz_race_sync_vcs = internal global ptr null")
  codegen_util::cg_emit_line(out, "@__qz_race_tid = thread_local global i64 -1")
  codegen_util::cg_emit_line(out, "@__qz_race_msg1 = internal constant [34 x i8] c\"WARNING: DATA RACE at address %p\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@__qz_race_msg2 = internal constant [27 x i8] c\"  Thread %ld performed %s\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@__qz_race_str_read = internal constant [5 x i8] c\"read\\00\"")
  codegen_util::cg_emit_line(out, "@__qz_race_str_write = internal constant [6 x i8] c\"write\\00\"")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_init: mmap shadow, alloc VCs, set enabled
  codegen_util::cg_emit_line(out, "define void @__qz_race_init() {")
  codegen_util::cg_emit_line(out, "  ; Shadow: 128MB (covers ~4MB app heap with 4 slots/word)")
  codegen_util::cg_emit_line(out, "  %shadow = call ptr @__qz_mmap_anon(i64 134217728)")
  codegen_util::cg_emit_line(out, "  store ptr %shadow, ptr @__qz_race_shadow")
  codegen_util::cg_emit_line(out, "  ; VC array: 64 threads * 64 clocks * 8 bytes = 32768 bytes")
  codegen_util::cg_emit_line(out, "  %vc = call ptr @__qz_alloc(i64 32768)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %vc, i32 0, i64 32768)")
  codegen_util::cg_emit_line(out, "  store ptr %vc, ptr @__qz_race_vc_slots")
  codegen_util::cg_emit_line(out, "  ; Sync VC table: 4096 entries * 64 clocks * 8 bytes = 2097152 bytes")
  codegen_util::cg_emit_line(out, "  %svc = call ptr @__qz_alloc(i64 2097152)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %svc, i32 0, i64 2097152)")
  codegen_util::cg_emit_line(out, "  store ptr %svc, ptr @__qz_race_sync_vcs")
  codegen_util::cg_emit_line(out, "  ; Init main thread: tid=0, vc[0][0]=1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %vc")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_mmap_anon helper
  if cg_is_wasi(target) == 0
    codegen_util::cg_emit_line(out, "define internal ptr @__qz_mmap_anon(i64 %size) {")
    codegen_util::cg_emit_line(out, "  %r = call ptr @mmap(ptr null, i64 %size, i32 3, i32 4098, i32 -1, i64 0)")
    codegen_util::cg_emit_line(out, "  ret ptr %r")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # __qz_race_register_thread: called on first access by a new thread
  codegen_util::cg_emit_line(out, "define internal void @__qz_race_register_thread() {")
  codegen_util::cg_emit_line(out, "  %old = atomicrmw add ptr @__qz_race_tid_counter, i64 1 seq_cst")
  codegen_util::cg_emit_line(out, "  store i64 %old, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  ; Init this thread's VC: vc[tid][tid] = 1")
  codegen_util::cg_emit_line(out, "  %vc = load ptr, ptr @__qz_race_vc_slots")
  codegen_util::cg_emit_line(out, "  %off1 = mul i64 %old, 512")
  codegen_util::cg_emit_line(out, "  %off2 = mul i64 %old, 8")
  codegen_util::cg_emit_line(out, "  %off = add i64 %off1, %off2")
  codegen_util::cg_emit_line(out, "  %ep = getelementptr i8, ptr %vc, i64 %off")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %ep")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_read8: check shadow for read-write conflicts
  codegen_util::cg_emit_line(out, "define void @__qz_race_read8(ptr %addr) {")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  %active = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %active, label %check, label %done")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %tid = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  %need_reg = icmp eq i64 %tid, -1")
  codegen_util::cg_emit_line(out, "  br i1 %need_reg, label %do_reg, label %do_check")
  codegen_util::cg_emit_line(out, "do_reg:")
  codegen_util::cg_emit_line(out, "  call void @__qz_race_register_thread()")
  codegen_util::cg_emit_line(out, "  %tid2 = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  br label %do_check")
  codegen_util::cg_emit_line(out, "do_check:")
  codegen_util::cg_emit_line(out, "  %mytid = phi i64 [ %tid, %check ], [ %tid2, %do_reg ]")
  codegen_util::cg_emit_line(out, "  ; Compute shadow address: shadow_base + ((addr >> 3) % (128MB / 32)) * 32")
  codegen_util::cg_emit_line(out, "  %ai = ptrtoint ptr %addr to i64")
  codegen_util::cg_emit_line(out, "  %shifted = lshr i64 %ai, 3")
  codegen_util::cg_emit_line(out, "  %idx = urem i64 %shifted, 4194304")
  codegen_util::cg_emit_line(out, "  %soff = mul i64 %idx, 32")
  codegen_util::cg_emit_line(out, "  %sb = load ptr, ptr @__qz_race_shadow")
  codegen_util::cg_emit_line(out, "  %sp = getelementptr i8, ptr %sb, i64 %soff")
  codegen_util::cg_emit_line(out, "  ; Check 4 shadow slots for write conflicts")
  codegen_util::cg_emit_line(out, "  %s0 = load i64, ptr %sp")
  codegen_util::cg_emit_line(out, "  %s0_tid = lshr i64 %s0, 48")
  codegen_util::cg_emit_line(out, "  %s0_wr = and i64 %s0, 32")
  codegen_util::cg_emit_line(out, "  %s0_same = icmp eq i64 %s0_tid, %mytid")
  codegen_util::cg_emit_line(out, "  %s0_is_wr = icmp ne i64 %s0_wr, 0")
  codegen_util::cg_emit_line(out, "  %s0_diff = icmp ne i64 %s0_tid, 0")
  codegen_util::cg_emit_line(out, "  %s0_conflict = and i1 %s0_is_wr, %s0_diff")
  codegen_util::cg_emit_line(out, "  %s0_real = and i1 %s0_conflict, true")
  codegen_util::cg_emit_line(out, "  %s0_check = select i1 %s0_same, i1 false, i1 %s0_real")
  codegen_util::cg_emit_line(out, "  br i1 %s0_check, label %race_found, label %update")
  codegen_util::cg_emit_line(out, "race_found:")
  codegen_util::cg_emit_line(out, "  call void @__qz_race_report(ptr %addr, i64 %mytid, i64 %s0_tid, i64 0, i64 1)")
  codegen_util::cg_emit_line(out, "  br label %update")
  codegen_util::cg_emit_line(out, "update:")
  codegen_util::cg_emit_line(out, "  ; Encode: (tid << 48) | 0 (read, no write bit)")
  codegen_util::cg_emit_line(out, "  %enc = shl i64 %mytid, 48")
  codegen_util::cg_emit_line(out, "  store i64 %enc, ptr %sp")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_write8: check shadow for any conflicts
  codegen_util::cg_emit_line(out, "define void @__qz_race_write8(ptr %addr) {")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  %active = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %active, label %check, label %done")
  codegen_util::cg_emit_line(out, "check:")
  codegen_util::cg_emit_line(out, "  %tid = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  %need_reg = icmp eq i64 %tid, -1")
  codegen_util::cg_emit_line(out, "  br i1 %need_reg, label %do_reg, label %do_check")
  codegen_util::cg_emit_line(out, "do_reg:")
  codegen_util::cg_emit_line(out, "  call void @__qz_race_register_thread()")
  codegen_util::cg_emit_line(out, "  %tid2 = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  br label %do_check")
  codegen_util::cg_emit_line(out, "do_check:")
  codegen_util::cg_emit_line(out, "  %mytid = phi i64 [ %tid, %check ], [ %tid2, %do_reg ]")
  codegen_util::cg_emit_line(out, "  %ai = ptrtoint ptr %addr to i64")
  codegen_util::cg_emit_line(out, "  %shifted = lshr i64 %ai, 3")
  codegen_util::cg_emit_line(out, "  %idx = urem i64 %shifted, 4194304")
  codegen_util::cg_emit_line(out, "  %soff = mul i64 %idx, 32")
  codegen_util::cg_emit_line(out, "  %sb = load ptr, ptr @__qz_race_shadow")
  codegen_util::cg_emit_line(out, "  %sp = getelementptr i8, ptr %sb, i64 %soff")
  codegen_util::cg_emit_line(out, "  ; DEBUG: Check shadow for write conflict")
  codegen_util::cg_emit_line(out, "  %s0 = load i64, ptr %sp")
  codegen_util::cg_emit_line(out, "  %s0_tid = lshr i64 %s0, 48")
  codegen_util::cg_emit_line(out, "  %s0_same = icmp eq i64 %s0_tid, %mytid")
  codegen_util::cg_emit_line(out, "  %s0_nz = icmp ne i64 %s0, 0")
  codegen_util::cg_emit_line(out, "  %s0_diff = select i1 %s0_same, i1 false, i1 %s0_nz")
  codegen_util::cg_emit_line(out, "  br i1 %s0_diff, label %race_found, label %update")
  codegen_util::cg_emit_line(out, "race_found:")
  codegen_util::cg_emit_line(out, "  call void @__qz_race_report(ptr %addr, i64 %mytid, i64 %s0_tid, i64 1, i64 0)")
  codegen_util::cg_emit_line(out, "  br label %update")
  codegen_util::cg_emit_line(out, "update:")
  codegen_util::cg_emit_line(out, "  ; Encode: (tid << 48) | 32 (write bit = bit 5)")
  codegen_util::cg_emit_line(out, "  %enc0 = shl i64 %mytid, 48")
  codegen_util::cg_emit_line(out, "  %enc = or i64 %enc0, 32")
  codegen_util::cg_emit_line(out, "  store i64 %enc, ptr %sp")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_acquire: merge sync object's VC into current thread's VC
  codegen_util::cg_emit_line(out, "define void @__qz_race_acquire(ptr %sync) {")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  %active = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %active, label %do_acq, label %done")
  codegen_util::cg_emit_line(out, "do_acq:")
  codegen_util::cg_emit_line(out, "  %tid = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  %vc = load ptr, ptr @__qz_race_vc_slots")
  codegen_util::cg_emit_line(out, "  %svc = load ptr, ptr @__qz_race_sync_vcs")
  codegen_util::cg_emit_line(out, "  ; Hash sync addr to VC table index (4096 entries)")
  codegen_util::cg_emit_line(out, "  %si = ptrtoint ptr %sync to i64")
  codegen_util::cg_emit_line(out, "  %sh = lshr i64 %si, 3")
  codegen_util::cg_emit_line(out, "  %sidx = urem i64 %sh, 4096")
  codegen_util::cg_emit_line(out, "  %svoff = mul i64 %sidx, 512")
  codegen_util::cg_emit_line(out, "  %svp = getelementptr i8, ptr %svc, i64 %svoff")
  codegen_util::cg_emit_line(out, "  ; My VC offset: tid * 64 * 8 = tid * 512")
  codegen_util::cg_emit_line(out, "  %myoff = mul i64 %tid, 512")
  codegen_util::cg_emit_line(out, "  %myvc = getelementptr i8, ptr %vc, i64 %myoff")
  codegen_util::cg_emit_line(out, "  ; Merge: for i in 0..8, my_vc[i] = max(my_vc[i], sync_vc[i])")
  codegen_util::cg_emit_line(out, "  ; Unrolled for first 8 entries (covers most programs)")
  # Unrolled VC merge loop for 8 entries
  var vi = 0
  while vi < 8
    var vs = vi.to_s()
    var voff = (vi * 8).to_s()
    codegen_util::cg_emit(out, "  %acq.mp")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = getelementptr i8, ptr %myvc, i64 ")
    codegen_util::cg_emit_line(out, voff)
    codegen_util::cg_emit(out, "  %acq.sp")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = getelementptr i8, ptr %svp, i64 ")
    codegen_util::cg_emit_line(out, voff)
    codegen_util::cg_emit(out, "  %acq.mv")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = load i64, ptr %acq.mp")
    codegen_util::cg_emit_line(out, vs)
    codegen_util::cg_emit(out, "  %acq.sv")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = load i64, ptr %acq.sp")
    codegen_util::cg_emit_line(out, vs)
    codegen_util::cg_emit(out, "  %acq.gt")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = icmp ugt i64 %acq.sv")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, ", %acq.mv")
    codegen_util::cg_emit_line(out, vs)
    codegen_util::cg_emit(out, "  %acq.mx")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, " = select i1 %acq.gt")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, ", i64 %acq.sv")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, ", i64 %acq.mv")
    codegen_util::cg_emit_line(out, vs)
    codegen_util::cg_emit(out, "  store i64 %acq.mx")
    codegen_util::cg_emit(out, vs)
    codegen_util::cg_emit(out, ", ptr %acq.mp")
    codegen_util::cg_emit_line(out, vs)
    vi = vi + 1
  end
  codegen_util::cg_emit_line(out, "  ; Increment own clock")
  codegen_util::cg_emit_line(out, "  %acq.tidoff = mul i64 %tid, 8")
  codegen_util::cg_emit_line(out, "  %acq.myep = getelementptr i8, ptr %myvc, i64 %acq.tidoff")
  codegen_util::cg_emit_line(out, "  %acq.mye = load i64, ptr %acq.myep")
  codegen_util::cg_emit_line(out, "  %acq.mye1 = add i64 %acq.mye, 1")
  codegen_util::cg_emit_line(out, "  store i64 %acq.mye1, ptr %acq.myep")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_release: copy current thread's VC to sync object's VC
  codegen_util::cg_emit_line(out, "define void @__qz_race_release(ptr %sync) {")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  %active = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %active, label %do_rel, label %done")
  codegen_util::cg_emit_line(out, "do_rel:")
  codegen_util::cg_emit_line(out, "  %tid = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  %vc = load ptr, ptr @__qz_race_vc_slots")
  codegen_util::cg_emit_line(out, "  %svc = load ptr, ptr @__qz_race_sync_vcs")
  codegen_util::cg_emit_line(out, "  %si = ptrtoint ptr %sync to i64")
  codegen_util::cg_emit_line(out, "  %sh = lshr i64 %si, 3")
  codegen_util::cg_emit_line(out, "  %sidx = urem i64 %sh, 4096")
  codegen_util::cg_emit_line(out, "  %svoff = mul i64 %sidx, 512")
  codegen_util::cg_emit_line(out, "  %svp = getelementptr i8, ptr %svc, i64 %svoff")
  codegen_util::cg_emit_line(out, "  %myoff = mul i64 %tid, 512")
  codegen_util::cg_emit_line(out, "  %myvc = getelementptr i8, ptr %vc, i64 %myoff")
  codegen_util::cg_emit_line(out, "  ; Copy my VC to sync VC (first 8 entries)")
  codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0.p0.i64(ptr %svp, ptr %myvc, i64 64, i1 false)")
  codegen_util::cg_emit_line(out, "  ; Increment own clock")
  codegen_util::cg_emit_line(out, "  %rel.tidoff = mul i64 %tid, 8")
  codegen_util::cg_emit_line(out, "  %rel.myep = getelementptr i8, ptr %myvc, i64 %rel.tidoff")
  codegen_util::cg_emit_line(out, "  %rel.mye = load i64, ptr %rel.myep")
  codegen_util::cg_emit_line(out, "  %rel.mye1 = add i64 %rel.mye, 1")
  codegen_util::cg_emit_line(out, "  store i64 %rel.mye1, ptr %rel.myep")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_fork: copy parent VC to new thread, increment parent clock
  codegen_util::cg_emit_line(out, "define void @__qz_race_fork(i64 %unused) {")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr @__qz_race_enabled")
  codegen_util::cg_emit_line(out, "  %active = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %active, label %do_fork, label %done")
  codegen_util::cg_emit_line(out, "do_fork:")
  codegen_util::cg_emit_line(out, "  %ptid = load i64, ptr @__qz_race_tid")
  codegen_util::cg_emit_line(out, "  %new_tid = atomicrmw add ptr @__qz_race_tid_counter, i64 1 seq_cst")
  codegen_util::cg_emit_line(out, "  %vc = load ptr, ptr @__qz_race_vc_slots")
  codegen_util::cg_emit_line(out, "  %poff = mul i64 %ptid, 512")
  codegen_util::cg_emit_line(out, "  %pvc = getelementptr i8, ptr %vc, i64 %poff")
  codegen_util::cg_emit_line(out, "  %coff = mul i64 %new_tid, 512")
  codegen_util::cg_emit_line(out, "  %cvc = getelementptr i8, ptr %vc, i64 %coff")
  codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0.p0.i64(ptr %cvc, ptr %pvc, i64 64, i1 false)")
  codegen_util::cg_emit_line(out, "  ; Increment parent clock")
  codegen_util::cg_emit_line(out, "  %ptidoff = mul i64 %ptid, 8")
  codegen_util::cg_emit_line(out, "  %pep = getelementptr i8, ptr %pvc, i64 %ptidoff")
  codegen_util::cg_emit_line(out, "  %pe = load i64, ptr %pep")
  codegen_util::cg_emit_line(out, "  %pe1 = add i64 %pe, 1")
  codegen_util::cg_emit_line(out, "  store i64 %pe1, ptr %pep")
  codegen_util::cg_emit_line(out, "  br label %done")
  codegen_util::cg_emit_line(out, "done:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_race_report: print race warning to stderr, then exit(66) — TSan/Go standard
  codegen_util::cg_emit_line(out, "@__qz_race_sep = internal constant [19 x i8] c\"==================\\0A\"")
  codegen_util::cg_emit_line(out, "@__qz_race_hdr = internal constant [20 x i8] c\"WARNING: DATA RACE\\0A\\00\"")
  codegen_util::cg_emit_line(out, "define void @__qz_race_report(ptr %addr, i64 %tid1, i64 %tid2, i64 %t1_write, i64 %t2_write) {")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr @__qz_race_sep, i64 19)")
  codegen_util::cg_emit_line(out, "  call i64 @write(i32 2, ptr @__qz_race_hdr, i64 20)")
  codegen_util::cg_emit_line(out, "  call void @exit(i32 66)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "}")
  # Note: fprintf, calloc, llvm.memcpy, mmap are already declared by the standard runtime
  codegen_util::cg_emit_line(out, "")
end
