    # the in-flight AFD poll and cancel it via NtCancelIoFileEx. The poller's
    # ev_io: handler will also call __qz_task_iosock_take on natural fire
    # to clear the entry (preventing double-cancel of a freed block on a
    # later sched_wake).
    codegen_util::cg_emit_line(out, "  %afd.block.i64 = ptrtoint ptr %afd.block.p to i64")
    codegen_util::cg_emit_line(out, "  call void @__qz_task_iosock_set(i64 %task, i64 %afd.block.i64)")
    codegen_util::cg_emit_line(out, "  br label %afd_done")
    codegen_util::cg_emit_line(out, "afd_submit_fail:")
    # Free the SockState; we own it (kernel never accepted ownership).
    codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %afd.block.p)")
    codegen_util::cg_emit_line(out, "  br label %afd_fail_inline")
    codegen_util::cg_emit_line(out, "afd_fail_inline:")
    # WSAIoctl failed OR NtDeviceIoControlFile returned a negative NTSTATUS.
    # Re-enqueue the task inline so the caller observes "fd not registered"
    # via its normal recv/send path returning WSAEBADF / WSAEINVAL. Mirrors
    # the POSIX kev_imm fast-path one-for-one.
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  br label %afd_done")
    codegen_util::cg_emit_line(out, "afd_done:")
  else
    # Store task at io_map[fd]
    codegen_util::cg_emit_line(out, "  %map.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
    codegen_util::cg_emit_line(out, "  %map.i = load i64, ptr %map.p")
    codegen_util::cg_emit_line(out, "  %map.base = inttoptr i64 %map.i to ptr")
    codegen_util::cg_emit_line(out, "  %map.slot = getelementptr i64, ptr %map.base, i64 %fd")
    codegen_util::cg_emit_line(out, "  store i64 %task, ptr %map.slot")
    # Load kqueue/epoll fd
    codegen_util::cg_emit_line(out, "  %epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %epfd.i64 = load i64, ptr %epfd.p")
    codegen_util::cg_emit_line(out, "  %epfd = trunc i64 %epfd.i64 to i32")
    codegen_util::cg_emit_line(out, "  %fd.i32 = trunc i64 %fd to i32")
