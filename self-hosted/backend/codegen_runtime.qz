      # If data is already pending, kevent returns immediately with the event.
      # This eliminates the TOCTOU race between registration and data arrival.
      codegen_util::cg_emit_line(out, "  %kev.out = alloca [32 x i8]")
      codegen_util::cg_emit_line(out, "  %kev.out.ptr = bitcast [32 x i8]* %kev.out to ptr")
      codegen_util::cg_emit_line(out, "  %kev.ts = alloca [16 x i8]")
      codegen_util::cg_emit_line(out, "  %kev.ts.ptr = bitcast [16 x i8]* %kev.ts to ptr")
      codegen_util::cg_emit_line(out, "  call void @memset(ptr %kev.ts.ptr, i32 0, i64 16)")
      codegen_util::cg_emit_line(out, "  %kev.n = call i32 @kevent(i32 %epfd, ptr %kev.ptr, i32 1, ptr %kev.out.ptr, i32 1, ptr %kev.ts.ptr)")
      codegen_util::cg_emit_line(out, "  %kev.ready = icmp sgt i32 %kev.n, 0")
      codegen_util::cg_emit_line(out, "  br i1 %kev.ready, label %kev_imm, label %kev_wait")
