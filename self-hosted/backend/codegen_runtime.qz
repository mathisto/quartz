    codegen_util::cg_emit_line(out, "  br i1 %is_k3, label %k3_dispatch, label %kind_lt3")
    codegen_util::cg_emit_line(out, "k3_dispatch:")
    codegen_util::cg_emit_line(out, "  %rf_slot.p = getelementptr inbounds i64, ptr %resumed_base, i64 %iprev")
    codegen_util::cg_emit_line(out, "  %rf_val = load i64, ptr %rf_slot.p, align 8")
    codegen_util::cg_emit_line(out, "  %was_resumed = icmp ne i64 %rf_val, 0")
    codegen_util::cg_emit_line(out, "  br i1 %was_resumed, label %ret_normal, label %k3_check_suspend")
