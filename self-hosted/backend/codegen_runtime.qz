  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %td.gmtx)")
  codegen_util::cg_emit_line(out, "  br label %td_skip")
  codegen_util::cg_emit_line(out, "td_skip:")
  # Mark task as done in task registry (status = 2)
  codegen_util::cg_emit_line(out, "  %td.tid.p = getelementptr i64, ptr %task.p, i64 4")
  codegen_util::cg_emit_line(out, "  %td.tid = load i64, ptr %td.tid.p")
  codegen_util::cg_emit_line(out, "  call void @__qz_task_registry_mark_done(i64 %td.tid)")
