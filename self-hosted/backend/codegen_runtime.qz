  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %rq.wid, i64 %task)")
  codegen_util::cg_emit_line(out, "  %rq.cv.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %rq.cv.i = load i64, ptr %rq.cv.p")
  codegen_util::cg_emit_line(out, "  %rq.cv = inttoptr i64 %rq.cv.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_signal(ptr %rq.cv)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "rq_global:")
  # Not on worker — use global queue (takes mutex)
  codegen_util::cg_emit_line(out, "  %mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mtx.i = load i64, ptr %mtx.p")
  codegen_util::cg_emit_line(out, "  %mtx = inttoptr i64 %mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %mtx)")
  # Capacity check: wait while global queue is full (count >= cap)
  codegen_util::cg_emit_line(out, "  br label %rq_check")
  codegen_util::cg_emit_line(out, "rq_check:")
  codegen_util::cg_emit_line(out, "  %rq.cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %rq.cnt = load i64, ptr %rq.cnt.p")
  codegen_util::cg_emit_line(out, "  %rq.cap.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 4")
