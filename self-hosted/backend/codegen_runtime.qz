  # path_join(a, b): join two path components
  codegen_util::cg_emit_line(out, "define i64 @qz_path_join(i64 %a, i64 %b) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %as = inttoptr i64 %a to ptr")
  codegen_util::cg_emit_line(out, "  %bs = inttoptr i64 %b to ptr")
  codegen_util::cg_emit_line(out, "  %alen = call i64 @qz_str_get_len(ptr %as)")
  codegen_util::cg_emit_line(out, "  %blen = call i64 @qz_str_get_len(ptr %bs)")
  codegen_util::cg_emit_line(out, "  %last.idx = sub i64 %alen, 1")
  codegen_util::cg_emit_line(out, "  %last.ptr = getelementptr i8, ptr %as, i64 %last.idx")
  codegen_util::cg_emit_line(out, "  %last.c = load i8, ptr %last.ptr")
  codegen_util::cg_emit_line(out, "  %has.slash = icmp eq i8 %last.c, 47")
  codegen_util::cg_emit_line(out, "  br i1 %has.slash, label %no_sep, label %add_sep")
  codegen_util::cg_emit_line(out, "add_sep:")
  codegen_util::cg_emit_line(out, "  %total.s = add i64 %alen, %blen")
  codegen_util::cg_emit_line(out, "  %total.sep = add i64 %total.s, 1")
  codegen_util::cg_emit_line(out, "  %buf1 = call ptr @qz_alloc_str(i64 %total.sep)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf1, ptr %as, i64 %alen)")
  codegen_util::cg_emit_line(out, "  %sep.ptr = getelementptr i8, ptr %buf1, i64 %alen")
  codegen_util::cg_emit_line(out, "  store i8 47, ptr %sep.ptr")
  codegen_util::cg_emit_line(out, "  %new.start = add i64 %alen, 1")
  codegen_util::cg_emit_line(out, "  %dst1 = getelementptr i8, ptr %buf1, i64 %new.start")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst1, ptr %bs, i64 %blen)")
  codegen_util::cg_emit_line(out, "  %result1 = ptrtoint ptr %buf1 to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result1")
  codegen_util::cg_emit_line(out, "no_sep:")
  codegen_util::cg_emit_line(out, "  %total.n = add i64 %alen, %blen")
  codegen_util::cg_emit_line(out, "  %buf2 = call ptr @qz_alloc_str(i64 %total.n)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %buf2, ptr %as, i64 %alen)")
  codegen_util::cg_emit_line(out, "  %dst2 = getelementptr i8, ptr %buf2, i64 %alen")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %dst2, ptr %bs, i64 %blen)")
  codegen_util::cg_emit_line(out, "  %result2 = ptrtoint ptr %buf2 to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result2")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # path_ext(p): return extension after last dot
  codegen_util::cg_emit_line(out, "define i64 @qz_path_ext(i64 %p) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ps = inttoptr i64 %p to ptr")
