    # resource exhaustion. Re-enqueue inline so user code can detect the
    # error via GetExitCodeProcess (or carry on), matching the POSIX
    # ESRCH / pidfd_open-failed fast-paths.
    codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
    codegen_util::cg_emit_line(out, "  ret void")
