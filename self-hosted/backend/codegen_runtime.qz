  codegen_util::cg_emit_line(out, "pc_skip:")
  # Trace: PANIC event (type=3, task=frame, payload=-1)
  codegen_util::cg_emit_line(out, "  call void @__qz_trace_emit(i64 3, i64 %task.i, i64 -1)")
