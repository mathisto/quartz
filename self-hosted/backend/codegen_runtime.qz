  codegen_util::cg_emit_line(out, "  call void @memset(ptr %pq1.mem, i32 0, i64 524288)")
  codegen_util::cg_emit_line(out, "  %pq1.i = ptrtoint ptr %pq1.mem to i64")
  codegen_util::cg_emit_line(out, "  %pq1.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 24")
  codegen_util::cg_emit_line(out, "  store i64 %pq1.i, ptr %pq1.ptr")
  # LOW queue: slots [28]=queue, [29]=head, [30]=tail, [31]=count
