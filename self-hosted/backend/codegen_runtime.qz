  end
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Timer ident counter for standalone timers (macOS kqueue ident namespace)
  if str_contains(target, "apple") or str_contains(target, "macos")
    codegen_util::cg_emit_line(out, "@__qz_timer_ident = global i64 2048")
