    codegen_util::cg_emit_line(out, "  ret void")
    # Function body ends here on Windows — the closing `}` is emitted
    # unconditionally below (the `if`-envelope's POSIX branch shares the
    # same close). The POSIX prelude + branches are gated to the else arm
    # so no kqueue/pidfd IR leaks into the Windows output.
  else
  # Load kqueue/epoll fd
  codegen_util::cg_emit_line(out, "  %epfd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
  codegen_util::cg_emit_line(out, "  %epfd.i64 = load i64, ptr %epfd.p")
  codegen_util::cg_emit_line(out, "  %epfd = trunc i64 %epfd.i64 to i32")
  codegen_util::cg_emit_line(out, "  %pid.i32 = trunc i64 %pid to i32")
