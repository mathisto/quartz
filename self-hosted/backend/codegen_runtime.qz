  codegen_util::cg_emit_line(out, "  ret i64 %dot.i")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # path_basename(p): return filename portion
  codegen_util::cg_emit_line(out, "define i64 @qz_path_basename(i64 %p) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %ps = inttoptr i64 %p to ptr")
  codegen_util::cg_emit_line(out, "  %slash = call ptr @strrchr(ptr %ps, i32 47)")
  codegen_util::cg_emit_line(out, "  %is.null = icmp eq ptr %slash, null")
  codegen_util::cg_emit_line(out, "  br i1 %is.null, label %no_slash, label %has_slash")
