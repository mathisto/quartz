    codegen_util::cg_emit_line(out, "  %io.iocp.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  %io.iocp.i64 = load i64, ptr %io.iocp.p")
    codegen_util::cg_emit_line(out, "  %io.iocp.h = inttoptr i64 %io.iocp.i64 to ptr")
