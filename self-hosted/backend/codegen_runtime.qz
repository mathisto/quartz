  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %sp.tr.s2")
  codegen_util::cg_emit_line(out, "  %sp.tr.s3 = getelementptr i64, ptr %sp.tr.s0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %sp.tr.s3")
