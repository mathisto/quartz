  # CAS failure → state changed (most likely to PARKED(1)) — retry the dispatch.
  codegen_util::cg_emit_line(out, "  %wk.cas0 = cmpxchg ptr %wk.ps.p, i64 0, i64 2 acq_rel acquire")
  codegen_util::cg_emit_line(out, "  %wk.ok0 = extractvalue {i64, i1} %wk.cas0, 1")
  codegen_util::cg_emit_line(out, "  br i1 %wk.ok0, label %wk_done, label %wk_retry")
  codegen_util::cg_emit_line(out, "wk_try_unpark:")
  # State was PARKED(1): transition to RUNNING(0) and re-enqueue the task.
  # CAS failure → state changed (should not happen — only the task itself clears 1) — retry.
  codegen_util::cg_emit_line(out, "  %wk.cas1 = cmpxchg ptr %wk.ps.p, i64 1, i64 0 acq_rel acquire")
  codegen_util::cg_emit_line(out, "  %wk.ok1 = extractvalue {i64, i1} %wk.cas1, 1")
  codegen_util::cg_emit_line(out, "  br i1 %wk.ok1, label %wk_reenqueue, label %wk_retry")
  codegen_util::cg_emit_line(out, "wk_reenqueue:")
  codegen_util::cg_emit_line(out, "  %wk.wid = load i64, ptr @__qz_current_worker_id")
  codegen_util::cg_emit_line(out, "  %wk.is_worker = icmp sge i64 %wk.wid, 0")
  codegen_util::cg_emit_line(out, "  br i1 %wk.is_worker, label %wk_local, label %wk_global")
  codegen_util::cg_emit_line(out, "wk_local:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_local_push(i64 %wk.wid, i64 %task)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "wk_global:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "wk_done:")
  # State 2 (WAKE_PENDING) or any unexpected value — already notified or no action needed.
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_trace_emit(type, task, payload): write event to ring buffer if tracing enabled
  # Event types: 1=SPAWN, 2=COMPLETE, 3=PANIC, 4=YIELD, 5=IO_SUSPEND, 6=CANCEL
  codegen_util::cg_emit_line(out, "define void @__qz_trace_emit(i64 %type, i64 %task, i64 %payload) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %en.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %en = load i64, ptr %en.p")
  codegen_util::cg_emit_line(out, "  %is_on = icmp ne i64 %en, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_on, label %do_trace, label %skip")
  codegen_util::cg_emit_line(out, "do_trace:")
  # Lock trace mutex
  codegen_util::cg_emit_line(out, "  %mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 4")
  codegen_util::cg_emit_line(out, "  %mtx.i = load i64, ptr %mtx.p")
  codegen_util::cg_emit_line(out, "  %mtx = inttoptr i64 %mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %mtx)")
  # Get timestamp via clock_gettime(CLOCK_MONOTONIC=6 on macOS, 1 on Linux)
  codegen_util::cg_emit_line(out, "  %ts.buf = alloca [2 x i64]")
  codegen_util::cg_emit_line(out, "  %ts.p = bitcast [2 x i64]* %ts.buf to ptr")
  if str_contains(target, "apple") or str_contains(target, "macos")
    codegen_util::cg_emit_line(out, "  call i32 @clock_gettime(i32 6, ptr %ts.p)")
  else
    codegen_util::cg_emit_line(out, "  call i32 @clock_gettime(i32 1, ptr %ts.p)")
  end
  codegen_util::cg_emit_line(out, "  %ts.sec.p = getelementptr [2 x i64], [2 x i64]* %ts.buf, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %ts.sec = load i64, ptr %ts.sec.p")
  codegen_util::cg_emit_line(out, "  %ts.nsec.p = getelementptr [2 x i64], [2 x i64]* %ts.buf, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %ts.nsec = load i64, ptr %ts.nsec.p")
  codegen_util::cg_emit_line(out, "  %ts.s2ns = mul i64 %ts.sec, 1000000000")
  codegen_util::cg_emit_line(out, "  %ts.ns = add i64 %ts.s2ns, %ts.nsec")
  # Compute slot: head & 65535 (modulo 64K)
  codegen_util::cg_emit_line(out, "  %hd.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %hd = load i64, ptr %hd.p")
  codegen_util::cg_emit_line(out, "  %idx = and i64 %hd, 65535")
  codegen_util::cg_emit_line(out, "  %slot = mul i64 %idx, 4")
  # Write 4-slot event: [type, task, timestamp_ns, payload]
  codegen_util::cg_emit_line(out, "  %buf.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %buf.i = load i64, ptr %buf.p")
  codegen_util::cg_emit_line(out, "  %buf = inttoptr i64 %buf.i to ptr")
  codegen_util::cg_emit_line(out, "  %e0.p = getelementptr i64, ptr %buf, i64 %slot")
  codegen_util::cg_emit_line(out, "  store i64 %type, ptr %e0.p")
  codegen_util::cg_emit_line(out, "  %s1 = add i64 %slot, 1")
  codegen_util::cg_emit_line(out, "  %e1.p = getelementptr i64, ptr %buf, i64 %s1")
  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %e1.p")
  codegen_util::cg_emit_line(out, "  %s2 = add i64 %slot, 2")
  codegen_util::cg_emit_line(out, "  %e2.p = getelementptr i64, ptr %buf, i64 %s2")
  codegen_util::cg_emit_line(out, "  store i64 %ts.ns, ptr %e2.p")
  codegen_util::cg_emit_line(out, "  %s3 = add i64 %slot, 3")
  codegen_util::cg_emit_line(out, "  %e3.p = getelementptr i64, ptr %buf, i64 %s3")
  codegen_util::cg_emit_line(out, "  store i64 %payload, ptr %e3.p")
  # Advance head
  codegen_util::cg_emit_line(out, "  %hd.next = add i64 %hd, 1")
  codegen_util::cg_emit_line(out, "  store i64 %hd.next, ptr %hd.p")
  # If ring buffer full (head - tail > 65536), advance tail
  codegen_util::cg_emit_line(out, "  %tl.p = getelementptr [5 x i64], [5 x i64]* @__qz_trace, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %tl = load i64, ptr %tl.p")
  codegen_util::cg_emit_line(out, "  %span = sub i64 %hd.next, %tl")
  codegen_util::cg_emit_line(out, "  %over = icmp sgt i64 %span, 65536")
  codegen_util::cg_emit_line(out, "  br i1 %over, label %advance_tail, label %trace_done")
  codegen_util::cg_emit_line(out, "advance_tail:")
  codegen_util::cg_emit_line(out, "  %tl.new = sub i64 %hd.next, 65536")
  codegen_util::cg_emit_line(out, "  store i64 %tl.new, ptr %tl.p")
  codegen_util::cg_emit_line(out, "  br label %trace_done")
  codegen_util::cg_emit_line(out, "trace_done:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %mtx)")
  codegen_util::cg_emit_line(out, "  br label %skip")
  codegen_util::cg_emit_line(out, "skip:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_local_push(wid, task): Chase-Lev deque push (lock-free)
  # Owner pushes to bottom. If full (bottom - top >= 256), move-half to global.
  # Move-half: CAS own top forward by 128, batch-enqueue to global under one mutex.
  # Per-worker layout: [0]=buffer, [1]=bottom(atomic), [2]=top(atomic), [4]=cap=256
  codegen_util::cg_emit_line(out, "define void @__qz_sched_local_push(i64 %wid, i64 %task) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_worker = icmp sge i64 %wid, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_worker, label %try_local, label %to_global_single")
  codegen_util::cg_emit_line(out, "try_local:")
  codegen_util::cg_emit_line(out, "  %wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.i = load i64, ptr %wd.p")
  codegen_util::cg_emit_line(out, "  %wd.base = inttoptr i64 %wd.i to ptr")
  codegen_util::cg_emit_line(out, "  %wd.off = mul i64 %wid, 12")
  codegen_util::cg_emit_line(out, "  %wd.slot = getelementptr i64, ptr %wd.base, i64 %wd.off")
  # Load bottom and top atomically
  codegen_util::cg_emit_line(out, "  %b.gep = getelementptr i64, ptr %wd.slot, i64 1")
  codegen_util::cg_emit_line(out, "  %b = load atomic i64, ptr %b.gep acquire, align 8")
  codegen_util::cg_emit_line(out, "  %t.gep = getelementptr i64, ptr %wd.slot, i64 2")
  codegen_util::cg_emit_line(out, "  %t = load atomic i64, ptr %t.gep acquire, align 8")
  # Check if full: bottom - top >= 256
  codegen_util::cg_emit_line(out, "  %sz = sub i64 %b, %t")
  codegen_util::cg_emit_line(out, "  %full = icmp sge i64 %sz, 256")
  codegen_util::cg_emit_line(out, "  br i1 %full, label %move_half, label %push_local")
  codegen_util::cg_emit_line(out, "push_local:")
  # Store task at buffer[bottom & 255]
  codegen_util::cg_emit_line(out, "  %lq.gep = getelementptr i64, ptr %wd.slot, i64 0")
  codegen_util::cg_emit_line(out, "  %lq.i = load i64, ptr %lq.gep")
  codegen_util::cg_emit_line(out, "  %lq = inttoptr i64 %lq.i to ptr")
  codegen_util::cg_emit_line(out, "  %idx = and i64 %b, 255")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %lq, i64 %idx")
  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %slot")
  # Increment bottom (release store — ensures buffer write is visible before bottom update)
  codegen_util::cg_emit_line(out, "  %b.next = add i64 %b, 1")
  codegen_util::cg_emit_line(out, "  store atomic i64 %b.next, ptr %b.gep release, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  #
  # Move-half overflow: advance own top by 128 via CAS, batch-enqueue to global
  # This replaces the old recursive reenqueue path with a single mutex acquisition.
  #
  codegen_util::cg_emit_line(out, "move_half:")
  # Load buffer pointer for reading tasks to move
  codegen_util::cg_emit_line(out, "  %mh.lq.gep = getelementptr i64, ptr %wd.slot, i64 0")
  codegen_util::cg_emit_line(out, "  %mh.lq.i = load i64, ptr %mh.lq.gep")
  codegen_util::cg_emit_line(out, "  %mh.lq = inttoptr i64 %mh.lq.i to ptr")
  # CAS own top from t to t+128 (claim 128 tasks for removal)
  # Stealers also CAS on top, so we must use CAS too
  codegen_util::cg_emit_line(out, "  %mh.tn = add i64 %t, 128")
  codegen_util::cg_emit_line(out, "  %mh.cas = cmpxchg ptr %t.gep, i64 %t, i64 %mh.tn seq_cst seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  %mh.cas.ok = extractvalue { i64, i1 } %mh.cas, 1")
  codegen_util::cg_emit_line(out, "  br i1 %mh.cas.ok, label %mh_batch, label %to_global_single")
  codegen_util::cg_emit_line(out, "mh_batch:")
  # Lock global mutex for batch enqueue
  codegen_util::cg_emit_line(out, "  %mh.mtx.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  %mh.mtx.i = load i64, ptr %mh.mtx.p")
  codegen_util::cg_emit_line(out, "  %mh.mtx = inttoptr i64 %mh.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %mh.mtx)")
  # Load global queue state: tail, buffer, count
  codegen_util::cg_emit_line(out, "  %mh.tail.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %mh.tail0 = load i64, ptr %mh.tail.p")
  codegen_util::cg_emit_line(out, "  %mh.q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %mh.q.i = load i64, ptr %mh.q.p")
  codegen_util::cg_emit_line(out, "  %mh.q = inttoptr i64 %mh.q.i to ptr")
  # Batch loop: copy 128 tasks from local buffer[t..t+128) to global queue
  codegen_util::cg_emit_line(out, "  br label %mh_loop")
  codegen_util::cg_emit_line(out, "mh_loop:")
  codegen_util::cg_emit_line(out, "  %mh.i = phi i64 [0, %mh_batch], [%mh.i.next, %mh_loop]")
  codegen_util::cg_emit_line(out, "  %mh.tail = phi i64 [%mh.tail0, %mh_batch], [%mh.tail.next, %mh_loop]")
  # Load task from local buffer[(t + i) & 255]
  codegen_util::cg_emit_line(out, "  %mh.ti = add i64 %t, %mh.i")
  codegen_util::cg_emit_line(out, "  %mh.ti.idx = and i64 %mh.ti, 255")
  codegen_util::cg_emit_line(out, "  %mh.ti.slot = getelementptr i64, ptr %mh.lq, i64 %mh.ti.idx")
  codegen_util::cg_emit_line(out, "  %mh.ti.task = load i64, ptr %mh.ti.slot")
  # Store to global queue[tail & 1048575]
  codegen_util::cg_emit_line(out, "  %mh.gq.idx = and i64 %mh.tail, 1048575")
  codegen_util::cg_emit_line(out, "  %mh.gq.slot = getelementptr i64, ptr %mh.q, i64 %mh.gq.idx")
  codegen_util::cg_emit_line(out, "  store i64 %mh.ti.task, ptr %mh.gq.slot")
  codegen_util::cg_emit_line(out, "  %mh.tail.next = add i64 %mh.tail, 1")
  codegen_util::cg_emit_line(out, "  %mh.i.next = add i64 %mh.i, 1")
  codegen_util::cg_emit_line(out, "  %mh.done = icmp uge i64 %mh.i.next, 128")
  codegen_util::cg_emit_line(out, "  br i1 %mh.done, label %mh_finish, label %mh_loop")
  codegen_util::cg_emit_line(out, "mh_finish:")
  # Update global tail and count
  codegen_util::cg_emit_line(out, "  %mh.tail.wrap = and i64 %mh.tail.next, 1048575")
  codegen_util::cg_emit_line(out, "  store i64 %mh.tail.wrap, ptr %mh.tail.p")
  codegen_util::cg_emit_line(out, "  %mh.cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %mh.cnt = load i64, ptr %mh.cnt.p")
  codegen_util::cg_emit_line(out, "  %mh.cnt.inc = add i64 %mh.cnt, 128")
  codegen_util::cg_emit_line(out, "  store i64 %mh.cnt.inc, ptr %mh.cnt.p")
  # Signal idle workers and unlock
  codegen_util::cg_emit_line(out, "  %mh.cv.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  %mh.cv.i = load i64, ptr %mh.cv.p")
  codegen_util::cg_emit_line(out, "  %mh.cv = inttoptr i64 %mh.cv.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_broadcast(ptr %mh.cv)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %mh.mtx)")
  # Now push the overflow task locally (deque has 128 free slots)
  codegen_util::cg_emit_line(out, "  %mh.b2 = load atomic i64, ptr %b.gep acquire, align 8")
  codegen_util::cg_emit_line(out, "  %mh.lq2.gep = getelementptr i64, ptr %wd.slot, i64 0")
  codegen_util::cg_emit_line(out, "  %mh.lq2.i = load i64, ptr %mh.lq2.gep")
  codegen_util::cg_emit_line(out, "  %mh.lq2 = inttoptr i64 %mh.lq2.i to ptr")
  codegen_util::cg_emit_line(out, "  %mh.idx2 = and i64 %mh.b2, 255")
  codegen_util::cg_emit_line(out, "  %mh.slot2 = getelementptr i64, ptr %mh.lq2, i64 %mh.idx2")
  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %mh.slot2")
  codegen_util::cg_emit_line(out, "  %mh.b2.next = add i64 %mh.b2, 1")
  codegen_util::cg_emit_line(out, "  store atomic i64 %mh.b2.next, ptr %b.gep release, align 8")
  codegen_util::cg_emit_line(out, "  ret void")
  # Fallback: CAS failed (stealer modified top) — single-task reenqueue
  codegen_util::cg_emit_line(out, "to_global_single:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_reenqueue(i64 %task)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_local_pop(): Chase-Lev deque pop (lock-free, LIFO from bottom)
  # Owner pops from bottom. Competes with stealers via CAS on last element.
  codegen_util::cg_emit_line(out, "define i64 @__qz_sched_local_pop(i64 %wid) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %is_worker = icmp sge i64 %wid, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_worker, label %try_pop, label %empty")
  codegen_util::cg_emit_line(out, "try_pop:")
  codegen_util::cg_emit_line(out, "  %wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.i = load i64, ptr %wd.p")
  codegen_util::cg_emit_line(out, "  %wd.base = inttoptr i64 %wd.i to ptr")
  codegen_util::cg_emit_line(out, "  %wd.off = mul i64 %wid, 12")
  codegen_util::cg_emit_line(out, "  %wd.slot = getelementptr i64, ptr %wd.base, i64 %wd.off")
  codegen_util::cg_emit_line(out, "  %b.gep = getelementptr i64, ptr %wd.slot, i64 1")
  codegen_util::cg_emit_line(out, "  %t.gep = getelementptr i64, ptr %wd.slot, i64 2")
  # Decrement bottom speculatively
  codegen_util::cg_emit_line(out, "  %b = load atomic i64, ptr %b.gep acquire, align 8")
  codegen_util::cg_emit_line(out, "  %b1 = sub i64 %b, 1")
  codegen_util::cg_emit_line(out, "  store atomic i64 %b1, ptr %b.gep release, align 8")
  # Full memory barrier — critical for Chase-Lev correctness on ARM
  # Ensures the bottom write is visible before we read top
  codegen_util::cg_emit_line(out, "  fence seq_cst")
  # Load top
  codegen_util::cg_emit_line(out, "  %t = load atomic i64, ptr %t.gep acquire, align 8")
  # Check if deque is empty (b1 < t means we decremented below top)
  codegen_util::cg_emit_line(out, "  %sz = sub i64 %b1, %t")
  codegen_util::cg_emit_line(out, "  %is_neg = icmp slt i64 %sz, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_neg, label %fix_empty, label %take")
  codegen_util::cg_emit_line(out, "take:")
  # Load the task from buffer[b1 & 255]
  codegen_util::cg_emit_line(out, "  %lq.gep = getelementptr i64, ptr %wd.slot, i64 0")
  codegen_util::cg_emit_line(out, "  %lq.i = load i64, ptr %lq.gep")
  codegen_util::cg_emit_line(out, "  %lq = inttoptr i64 %lq.i to ptr")
  codegen_util::cg_emit_line(out, "  %idx = and i64 %b1, 255")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %lq, i64 %idx")
  codegen_util::cg_emit_line(out, "  %task = load i64, ptr %slot")
  # Check if this is the last element (size == 0 after our take)
  codegen_util::cg_emit_line(out, "  %is_last = icmp eq i64 %sz, 0")
  codegen_util::cg_emit_line(out, "  br i1 %is_last, label %race, label %success")
  codegen_util::cg_emit_line(out, "race:")
  # Last element — compete with stealers via CAS on top
  # If CAS succeeds, we got it. If fails, a stealer took it.
  codegen_util::cg_emit_line(out, "  %t1 = add i64 %t, 1")
  codegen_util::cg_emit_line(out, "  %cas = cmpxchg ptr %t.gep, i64 %t, i64 %t1 seq_cst seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  %cas.ok = extractvalue { i64, i1 } %cas, 1")
  # Either way, reset bottom = t + 1 (deque is now empty)
  codegen_util::cg_emit_line(out, "  store atomic i64 %t1, ptr %b.gep release, align 8")
  codegen_util::cg_emit_line(out, "  br i1 %cas.ok, label %success, label %empty")
  codegen_util::cg_emit_line(out, "success:")
  codegen_util::cg_emit_line(out, "  ret i64 %task")
  codegen_util::cg_emit_line(out, "fix_empty:")
  # Deque was empty — restore bottom
  codegen_util::cg_emit_line(out, "  store atomic i64 %b, ptr %b.gep release, align 8")
  codegen_util::cg_emit_line(out, "  br label %empty")
  codegen_util::cg_emit_line(out, "empty:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_steal(): try to steal a task from another worker's local queue
  # Uses randomized victim selection (O(1) amortized, same approach as Go/tokio).
  # Picks 2 random victims via xorshift64 PRNG. Returns task pointer or 0.
  codegen_util::cg_emit_line(out, "define i64 @__qz_sched_steal(i64 %wid) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %nw.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 9")
  codegen_util::cg_emit_line(out, "  %nw = load i64, ptr %nw.p")
  codegen_util::cg_emit_line(out, "  %wd.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 17")
  codegen_util::cg_emit_line(out, "  %wd.i = load i64, ptr %wd.p")
  codegen_util::cg_emit_line(out, "  %wd.base = inttoptr i64 %wd.i to ptr")
  # Only steal if >1 worker
  codegen_util::cg_emit_line(out, "  %nw.ok = icmp ugt i64 %nw, 1")
  codegen_util::cg_emit_line(out, "  br i1 %nw.ok, label %pick_victim, label %fail")
  codegen_util::cg_emit_line(out, "pick_victim:")
  # Xorshift64 PRNG: seed = (wid+1) * 6364136223846793005 (LCG constant)
  # This gives different starting points per worker
  codegen_util::cg_emit_line(out, "  %seed0 = add i64 %wid, 1")
  codegen_util::cg_emit_line(out, "  %seed1 = mul i64 %seed0, 6364136223846793005")
  codegen_util::cg_emit_line(out, "  %x1 = xor i64 %seed1, 13")
  codegen_util::cg_emit_line(out, "  %x2 = lshr i64 %x1, 7")
  codegen_util::cg_emit_line(out, "  %x3 = xor i64 %x1, %x2")
  codegen_util::cg_emit_line(out, "  %x4 = shl i64 %x3, 17")
  codegen_util::cg_emit_line(out, "  %rng = xor i64 %x3, %x4")
