    codegen_util::cg_emit_line(out, "  %wp.pw.i64 = load i64, ptr %wp.pw.p")
    codegen_util::cg_emit_line(out, "  %wp.pw.i32 = trunc i64 %wp.pw.i64 to i32")
    codegen_util::cg_emit_line(out, "  %wp.buf = alloca i8")
    codegen_util::cg_emit_line(out, "  store i8 1, ptr %wp.buf")
    codegen_util::cg_emit_line(out, "  %wp.r = call i64 @write(i32 %wp.pw.i32, ptr %wp.buf, i64 1)")
