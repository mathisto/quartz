  codegen_util::cg_emit_line(out, "  %pc.tid.gep = getelementptr i64, ptr %pc.task.p, i64 4")
  codegen_util::cg_emit_line(out, "  %pc.tid = load i64, ptr %pc.tid.gep")
  codegen_util::cg_emit_line(out, "  %pc.tid.nz = icmp ne i64 %pc.tid, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pc.tid.nz, label %pc_tl_cleanup, label %pc_tl_done")
  codegen_util::cg_emit_line(out, "pc_tl_cleanup:")
