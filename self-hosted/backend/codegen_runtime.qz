    codegen_util::cg_emit_line(out, "  %wk.tp.has = icmp ne i64 %wk.tp.b.i, 0")
    codegen_util::cg_emit_line(out, "  br i1 %wk.tp.has, label %wk_clear_tp, label %wk_skip_tp")
    codegen_util::cg_emit_line(out, "wk_clear_tp:")
