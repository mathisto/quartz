  codegen_util::cg_emit_line(out, "  %sp.frame = inttoptr i64 %task to ptr")
  codegen_util::cg_emit_line(out, "  %sp.tid.p = getelementptr i64, ptr %sp.frame, i64 4")
  codegen_util::cg_emit_line(out, "  %sp.tid = load i64, ptr %sp.tid.p")
  codegen_util::cg_emit_line(out, "  %sp.ptbl.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 32")
  codegen_util::cg_emit_line(out, "  %sp.ptbl.i = load i64, ptr %sp.ptbl.p")
  codegen_util::cg_emit_line(out, "  %sp.ptbl = inttoptr i64 %sp.ptbl.i to ptr")
  codegen_util::cg_emit_line(out, "  %sp.tmask = and i64 %sp.tid, 65535")
  codegen_util::cg_emit_line(out, "  %sp.pslot = getelementptr i64, ptr %sp.ptbl, i64 %sp.tmask")
  codegen_util::cg_emit_line(out, "  %sp.prio = load i64, ptr %sp.pslot")
  codegen_util::cg_emit_line(out, "  %sp.is.normal = icmp eq i64 %sp.prio, 0")
  codegen_util::cg_emit_line(out, "  br i1 %sp.is.normal, label %enq_normal, label %enq_prio")
  # NORMAL enqueue (existing path, slots 1-5)
  codegen_util::cg_emit_line(out, "enq_normal:")
  codegen_util::cg_emit_line(out, "  %tail.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %tail = load i64, ptr %tail.p")
  codegen_util::cg_emit_line(out, "  %q.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %q.i = load i64, ptr %q.p")
  codegen_util::cg_emit_line(out, "  %q.base = inttoptr i64 %q.i to ptr")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %q.base, i64 %tail")
  codegen_util::cg_emit_line(out, "  store i64 %task, ptr %slot")
  codegen_util::cg_emit_line(out, "  %tail.next = add i64 %tail, 1")
  codegen_util::cg_emit_line(out, "  %tail.wrap = and i64 %tail.next, 1048575")
  codegen_util::cg_emit_line(out, "  store i64 %tail.wrap, ptr %tail.p")
  codegen_util::cg_emit_line(out, "  %cnt.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 5")
  codegen_util::cg_emit_line(out, "  %cnt = load i64, ptr %cnt.p")
  codegen_util::cg_emit_line(out, "  %cnt.inc = add i64 %cnt, 1")
  codegen_util::cg_emit_line(out, "  store i64 %cnt.inc, ptr %cnt.p")
