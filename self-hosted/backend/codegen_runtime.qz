  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # qz_vec_new: create a new vector (for str_split)
  codegen_util::cg_emit_line(out, "define i64 @qz_vec_new() nounwind {")
  codegen_util::cg_emit_line(out, "  %hdr = call ptr @__qz_alloc(i64 32)")
  codegen_util::cg_emit_line(out, "  %hdr.i64 = bitcast ptr %hdr to ptr")
  codegen_util::cg_emit_line(out, "  store i64 8, ptr %hdr.i64")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr.i64, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  %data.i64 = ptrtoint ptr %data to i64")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr.i64, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 %data.i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %ew.ptr = getelementptr i64, ptr %hdr.i64, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 8, ptr %ew.ptr")
  codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %hdr to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # qz_vec_push: push element to vector (for str_split)
  codegen_util::cg_emit_line(out, "define void @qz_vec_push(i64 %vec, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %cap.ptr = getelementptr i64, ptr %hdr, i64 0")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %cap = load i64, ptr %cap.ptr")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.i64 = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %need_grow = icmp uge i64 %size, %cap")
  codegen_util::cg_emit_line(out, "  br i1 %need_grow, label %grow, label %store")
  codegen_util::cg_emit_line(out, "grow:")
  codegen_util::cg_emit_line(out, "  %newcap.raw = mul i64 %cap, 2")
  codegen_util::cg_emit_line(out, "  %newcap.small = icmp slt i64 %newcap.raw, 4")
  codegen_util::cg_emit_line(out, "  %newcap = select i1 %newcap.small, i64 4, i64 %newcap.raw")
  codegen_util::cg_emit_line(out, "  %newbytes = mul i64 %newcap, 8")
  codegen_util::cg_emit_line(out, "  %oldbytes = mul i64 %cap, 8")
  codegen_util::cg_emit_line(out, "  %olddata = inttoptr i64 %data.i64 to ptr")
  codegen_util::cg_emit_line(out, "  %newdata = call ptr @__qz_realloc(ptr %olddata, i64 %oldbytes, i64 %newbytes)")
  codegen_util::cg_emit_line(out, "  %newdata.i64 = ptrtoint ptr %newdata to i64")
  codegen_util::cg_emit_line(out, "  store i64 %newcap, ptr %cap.ptr")
  codegen_util::cg_emit_line(out, "  store i64 %newdata.i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  br label %store")
  codegen_util::cg_emit_line(out, "store:")
  codegen_util::cg_emit_line(out, "  %cur.data.i64 = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %cur.data = inttoptr i64 %cur.data.i64 to ptr")
  codegen_util::cg_emit_line(out, "  %slot = getelementptr i64, ptr %cur.data, i64 %size")
  codegen_util::cg_emit_line(out, "  store i64 %val, ptr %slot")
  codegen_util::cg_emit_line(out, "  %newsize = add i64 %size, 1")
  codegen_util::cg_emit_line(out, "  store i64 %newsize, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  
  # qz_str_split_impl: split string by delimiter into vector
  # Uses strstr (not strtok) to correctly handle empty tokens from
  # trailing delimiters ("a,b," → ["a","b",""]) and consecutive
  # delimiters ("a,,b" → ["a","","b"]).
  codegen_util::cg_emit_line(out, "define void @qz_str_split_impl(i64 %vec, ptr %buf, ptr %delim) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %dlen = call i64 @qz_str_get_len(ptr %delim)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %cur = phi ptr [%buf, %entry], [%adv, %found]")
  codegen_util::cg_emit_line(out, "  %pos = call ptr @strstr(ptr %cur, ptr %delim)")
  codegen_util::cg_emit_line(out, "  %has_match = icmp ne ptr %pos, null")
  codegen_util::cg_emit_line(out, "  br i1 %has_match, label %found, label %tail")
  # Delimiter found: extract substring [cur..pos), advance past delimiter
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  %seg.i = ptrtoint ptr %cur to i64")
  codegen_util::cg_emit_line(out, "  %pos.i = ptrtoint ptr %pos to i64")
  codegen_util::cg_emit_line(out, "  %seg.len = sub i64 %pos.i, %seg.i")
  codegen_util::cg_emit_line(out, "  %seg.buf = call ptr @qz_alloc_str(i64 %seg.len)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %seg.buf, ptr %cur, i64 %seg.len)")
  codegen_util::cg_emit_line(out, "  %seg.val = ptrtoint ptr %seg.buf to i64")
  codegen_util::cg_emit_line(out, "  call void @qz_vec_push(i64 %vec, i64 %seg.val)")
  codegen_util::cg_emit_line(out, "  %adv = getelementptr i8, ptr %pos, i64 %dlen")
  codegen_util::cg_emit_line(out, "  br label %loop")
  # No more delimiters: push remainder and return
  codegen_util::cg_emit_line(out, "tail:")
  codegen_util::cg_emit_line(out, "  %rem.len = call i64 @strlen(ptr %cur)")
  codegen_util::cg_emit_line(out, "  %rem.buf = call ptr @qz_alloc_str(i64 %rem.len)")
  codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %rem.buf, ptr %cur, i64 %rem.len)")
  codegen_util::cg_emit_line(out, "  %rem.val = ptrtoint ptr %rem.buf to i64")
  codegen_util::cg_emit_line(out, "  call void @qz_vec_push(i64 %vec, i64 %rem.val)")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # vec_contains: linear scan
  codegen_util::cg_emit_line(out, "define i64 @qz_vec_contains(i64 %vec, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %size")
  codegen_util::cg_emit_line(out, "  br i1 %done, label %not_found, label %body")
  codegen_util::cg_emit_line(out, "body:")
  codegen_util::cg_emit_line(out, "  %elem.ptr = getelementptr i64, ptr %data, i64 %i")
  codegen_util::cg_emit_line(out, "  %elem = load i64, ptr %elem.ptr")
  codegen_util::cg_emit_line(out, "  %eq = icmp eq i64 %elem, %val")
  codegen_util::cg_emit_line(out, "  br i1 %eq, label %found, label %cont")
  codegen_util::cg_emit_line(out, "cont:")
  codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "found:")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "not_found:")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # vec_index_of: linear scan, returns index or -1
  codegen_util::cg_emit_line(out, "define i64 @qz_vec_index_of(i64 %vec, i64 %val) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
  codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
  codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
  codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "loop:")
  codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %cont]")
  codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %size")
