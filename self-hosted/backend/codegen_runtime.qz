  codegen_util::cg_emit_line(out, "  %td.result = load i64, ptr %td.result.p")
  codegen_util::cg_emit_line(out, "  call void @__qz_trace_emit(i64 2, i64 %task.i, i64 %td.result)")
  # Notify any waiters watching this task for completion
  codegen_util::cg_emit_line(out, "  %td.watchers = call i64 @__qz_completion_notify(i64 %task.i)")
