    codegen_util::cg_emit_line(out, "  %tp.base = inttoptr i64 %tp.base.i to ptr")
    codegen_util::cg_emit_line(out, "  %tp.neg = add i64 %tfd.i64, 1")
    codegen_util::cg_emit_line(out, "  %tp.neg2 = sub i64 0, %tp.neg")
    codegen_util::cg_emit_line(out, "  %tp.slot = getelementptr i64, ptr %tp.base, i64 %tfd.i64")
    codegen_util::cg_emit_line(out, "  store i64 %tp.neg2, ptr %tp.slot")
    # B.7 Phase 4e.8: record this task's pending timer fd so __qz_sched_wake
    # can cancel it on scope-cancel. Linux uses the timerfd as the ident.
    codegen_util::cg_emit_line(out, "  call void @__qz_task_timer_set(i64 %task, i64 %tfd.i64)")
    codegen_util::cg_emit_line(out, "  ret void")
  end
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_wake_poller(): nudge the I/O poller thread to drain a
  # completion and re-check @__qz_signal_shutdown. Callers store the
  # shutdown flag (or otherwise mutate poller-observable state) *before*
  # invoking this fn — the wake is just the "look again" signal.
