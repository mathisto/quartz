    # codegen_runtime.qz:12135. Allocates a 5-byte scratch buf via
    # @__qz_alloc, writes 1-4 UTF-8 bytes + NUL terminator, then wraps
    # via @qz_wrap_cstr (which strlen-scans + qz_alloc_str-copies into
    # the final length-prefixed buffer) and deallocs the scratch.
    codegen_util::cg_emit_line(out, "; UTF-8 codepoint encoder")
    codegen_util::cg_emit_line(out, "define i64 @qz_str_from_codepoint(i64 %cp) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %buf = call ptr @__qz_alloc(i64 5)")
    codegen_util::cg_emit_line(out, "  %is1 = icmp ult i64 %cp, 128")
    codegen_util::cg_emit_line(out, "  br i1 %is1, label %enc1, label %check2")
    codegen_util::cg_emit_line(out, "enc1:")
    codegen_util::cg_emit_line(out, "  %b1 = trunc i64 %cp to i8")
    codegen_util::cg_emit_line(out, "  store i8 %b1, ptr %buf")
    codegen_util::cg_emit_line(out, "  %buf1.1 = getelementptr i8, ptr %buf, i64 1")
    codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf1.1")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "check2:")
    codegen_util::cg_emit_line(out, "  %is2 = icmp ult i64 %cp, 2048")
    codegen_util::cg_emit_line(out, "  br i1 %is2, label %enc2, label %check3")
    codegen_util::cg_emit_line(out, "enc2:")
    codegen_util::cg_emit_line(out, "  %e2.a = lshr i64 %cp, 6")
    codegen_util::cg_emit_line(out, "  %e2.a1 = or i64 %e2.a, 192")
    codegen_util::cg_emit_line(out, "  %e2.b = and i64 %cp, 63")
    codegen_util::cg_emit_line(out, "  %e2.b1 = or i64 %e2.b, 128")
    codegen_util::cg_emit_line(out, "  %e2.a2 = trunc i64 %e2.a1 to i8")
    codegen_util::cg_emit_line(out, "  %e2.b2 = trunc i64 %e2.b1 to i8")
    codegen_util::cg_emit_line(out, "  store i8 %e2.a2, ptr %buf")
    codegen_util::cg_emit_line(out, "  %buf2.1 = getelementptr i8, ptr %buf, i64 1")
    codegen_util::cg_emit_line(out, "  store i8 %e2.b2, ptr %buf2.1")
    codegen_util::cg_emit_line(out, "  %buf2.2 = getelementptr i8, ptr %buf, i64 2")
    codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf2.2")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "check3:")
    codegen_util::cg_emit_line(out, "  %is3 = icmp ult i64 %cp, 65536")
    codegen_util::cg_emit_line(out, "  br i1 %is3, label %enc3, label %enc4")
    codegen_util::cg_emit_line(out, "enc3:")
    codegen_util::cg_emit_line(out, "  %e3.a = lshr i64 %cp, 12")
    codegen_util::cg_emit_line(out, "  %e3.a1 = or i64 %e3.a, 224")
    codegen_util::cg_emit_line(out, "  %e3.b = lshr i64 %cp, 6")
    codegen_util::cg_emit_line(out, "  %e3.b0 = and i64 %e3.b, 63")
    codegen_util::cg_emit_line(out, "  %e3.b1 = or i64 %e3.b0, 128")
    codegen_util::cg_emit_line(out, "  %e3.c = and i64 %cp, 63")
    codegen_util::cg_emit_line(out, "  %e3.c1 = or i64 %e3.c, 128")
    codegen_util::cg_emit_line(out, "  %e3.a2 = trunc i64 %e3.a1 to i8")
    codegen_util::cg_emit_line(out, "  %e3.b2 = trunc i64 %e3.b1 to i8")
    codegen_util::cg_emit_line(out, "  %e3.c2 = trunc i64 %e3.c1 to i8")
    codegen_util::cg_emit_line(out, "  store i8 %e3.a2, ptr %buf")
    codegen_util::cg_emit_line(out, "  %buf3.1 = getelementptr i8, ptr %buf, i64 1")
    codegen_util::cg_emit_line(out, "  store i8 %e3.b2, ptr %buf3.1")
    codegen_util::cg_emit_line(out, "  %buf3.2 = getelementptr i8, ptr %buf, i64 2")
    codegen_util::cg_emit_line(out, "  store i8 %e3.c2, ptr %buf3.2")
    codegen_util::cg_emit_line(out, "  %buf3.3 = getelementptr i8, ptr %buf, i64 3")
    codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf3.3")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "enc4:")
    codegen_util::cg_emit_line(out, "  %e4.a = lshr i64 %cp, 18")
    codegen_util::cg_emit_line(out, "  %e4.a1 = or i64 %e4.a, 240")
    codegen_util::cg_emit_line(out, "  %e4.b = lshr i64 %cp, 12")
    codegen_util::cg_emit_line(out, "  %e4.b0 = and i64 %e4.b, 63")
    codegen_util::cg_emit_line(out, "  %e4.b1 = or i64 %e4.b0, 128")
    codegen_util::cg_emit_line(out, "  %e4.c = lshr i64 %cp, 6")
    codegen_util::cg_emit_line(out, "  %e4.c0 = and i64 %e4.c, 63")
    codegen_util::cg_emit_line(out, "  %e4.c1 = or i64 %e4.c0, 128")
    codegen_util::cg_emit_line(out, "  %e4.d = and i64 %cp, 63")
    codegen_util::cg_emit_line(out, "  %e4.d1 = or i64 %e4.d, 128")
    codegen_util::cg_emit_line(out, "  %e4.a2 = trunc i64 %e4.a1 to i8")
    codegen_util::cg_emit_line(out, "  %e4.b2 = trunc i64 %e4.b1 to i8")
    codegen_util::cg_emit_line(out, "  %e4.c2 = trunc i64 %e4.c1 to i8")
    codegen_util::cg_emit_line(out, "  %e4.d2 = trunc i64 %e4.d1 to i8")
    codegen_util::cg_emit_line(out, "  store i8 %e4.a2, ptr %buf")
    codegen_util::cg_emit_line(out, "  %buf4.1 = getelementptr i8, ptr %buf, i64 1")
    codegen_util::cg_emit_line(out, "  store i8 %e4.b2, ptr %buf4.1")
    codegen_util::cg_emit_line(out, "  %buf4.2 = getelementptr i8, ptr %buf, i64 2")
    codegen_util::cg_emit_line(out, "  store i8 %e4.c2, ptr %buf4.2")
    codegen_util::cg_emit_line(out, "  %buf4.3 = getelementptr i8, ptr %buf, i64 3")
    codegen_util::cg_emit_line(out, "  store i8 %e4.d2, ptr %buf4.3")
    codegen_util::cg_emit_line(out, "  %buf4.4 = getelementptr i8, ptr %buf, i64 4")
    codegen_util::cg_emit_line(out, "  store i8 0, ptr %buf4.4")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "done:")
    codegen_util::cg_emit_line(out, "  %pstr = call ptr @qz_wrap_cstr(ptr %buf)")
    codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %buf)")
    codegen_util::cg_emit_line(out, "  %result = ptrtoint ptr %pstr to i64")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # Libc-free to_str. Same pointer-sniff heuristic as the hosted
    # version (alignment + length-prefix plausibility + null terminator),
    # but the int path is hand-rolled: stack buffer, right-to-left digit
    # fill via urem/udiv, optional '-' prefix, qz_alloc_str + memcpy.
    # No sprintf, no strlen, no libc. Covers plain i64 values in
    # `"#{x}"` which is by far the dominant use case in kernel code.
    codegen_util::cg_emit_line(out, "; Libc-free to_str (pointer smart-check + hand-rolled int→str)")
    codegen_util::cg_emit_line(out, "define i64 @to_str(i64 %val) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %low4 = and i64 %val, 15")
    codegen_util::cg_emit_line(out, "  %is_aligned = icmp eq i64 %low4, 8")
    codegen_util::cg_emit_line(out, "  br i1 %is_aligned, label %check_range, label %int_start")
    codegen_util::cg_emit_line(out, "check_range:")
    codegen_util::cg_emit_line(out, "  %is_negptr = icmp slt i64 %val, 0")
    codegen_util::cg_emit_line(out, "  br i1 %is_negptr, label %int_start, label %check_min")
    codegen_util::cg_emit_line(out, "check_min:")
    codegen_util::cg_emit_line(out, "  %above_min = icmp ugt i64 %val, 65535")
    codegen_util::cg_emit_line(out, "  br i1 %above_min, label %check_str, label %int_start")
    codegen_util::cg_emit_line(out, "check_str:")
    codegen_util::cg_emit_line(out, "  %pstr = inttoptr i64 %val to ptr")
    codegen_util::cg_emit_line(out, "  %praw = getelementptr i8, ptr %pstr, i64 -8")
    codegen_util::cg_emit_line(out, "  %phdr = bitcast ptr %praw to ptr")
    codegen_util::cg_emit_line(out, "  %plen = load i64, ptr %phdr")
    codegen_util::cg_emit_line(out, "  %valid = icmp ult i64 %plen, 1073741824")
    codegen_util::cg_emit_line(out, "  br i1 %valid, label %check_null, label %int_start")
    codegen_util::cg_emit_line(out, "check_null:")
    codegen_util::cg_emit_line(out, "  %pendp = getelementptr i8, ptr %pstr, i64 %plen")
    codegen_util::cg_emit_line(out, "  %pend = load i8, ptr %pendp")
    codegen_util::cg_emit_line(out, "  %pis_null = icmp eq i8 %pend, 0")
    codegen_util::cg_emit_line(out, "  br i1 %pis_null, label %str_path, label %int_start")
    codegen_util::cg_emit_line(out, "str_path:")
    codegen_util::cg_emit_line(out, "  ret i64 %val")
    codegen_util::cg_emit_line(out, "int_start:")
    # 24-byte stack buffer holds up to 20 i64 digits + sign + slack.
    codegen_util::cg_emit_line(out, "  %sbuf = alloca [24 x i8]")
    codegen_util::cg_emit_line(out, "  %is_neg = icmp slt i64 %val, 0")
    codegen_util::cg_emit_line(out, "  %nval = sub i64 0, %val")
    codegen_util::cg_emit_line(out, "  %abs = select i1 %is_neg, i64 %nval, i64 %val")
    codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i64 %abs, 0")
    codegen_util::cg_emit_line(out, "  br i1 %is_zero, label %zero_case, label %loop")
    # Zero special-case: write '0' at offset 23.
    codegen_util::cg_emit_line(out, "zero_case:")
    codegen_util::cg_emit_line(out, "  %zslot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 23")
    codegen_util::cg_emit_line(out, "  store i8 48, ptr %zslot")
    codegen_util::cg_emit_line(out, "  br label %finish")
    # Main digit loop — writes right-to-left starting at offset 23.
    codegen_util::cg_emit_line(out, "loop:")
    codegen_util::cg_emit_line(out, "  %cur_i = phi i64 [23, %int_start], [%next_i, %loop]")
    codegen_util::cg_emit_line(out, "  %cur_v = phi i64 [%abs, %int_start], [%next_v, %loop]")
    codegen_util::cg_emit_line(out, "  %digit = urem i64 %cur_v, 10")
    codegen_util::cg_emit_line(out, "  %next_v = udiv i64 %cur_v, 10")
    codegen_util::cg_emit_line(out, "  %ch_i = add i64 %digit, 48")
    codegen_util::cg_emit_line(out, "  %ch = trunc i64 %ch_i to i8")
    codegen_util::cg_emit_line(out, "  %slot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %cur_i")
    codegen_util::cg_emit_line(out, "  store i8 %ch, ptr %slot")
    codegen_util::cg_emit_line(out, "  %next_i = sub i64 %cur_i, 1")
    codegen_util::cg_emit_line(out, "  %done = icmp eq i64 %next_v, 0")
    codegen_util::cg_emit_line(out, "  br i1 %done, label %after_loop, label %loop")
    # After loop: optionally prepend '-'. Pick start index for the copy.
    codegen_util::cg_emit_line(out, "after_loop:")
    codegen_util::cg_emit_line(out, "  br i1 %is_neg, label %prepend_minus, label %no_sign")
    codegen_util::cg_emit_line(out, "prepend_minus:")
    codegen_util::cg_emit_line(out, "  %mslot = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %next_i")
    codegen_util::cg_emit_line(out, "  store i8 45, ptr %mslot")
    codegen_util::cg_emit_line(out, "  br label %finish")
    codegen_util::cg_emit_line(out, "no_sign:")
    codegen_util::cg_emit_line(out, "  br label %finish")
    # Finalize: compute start, allocate heap string, memcpy from stack.
    codegen_util::cg_emit_line(out, "finish:")
    codegen_util::cg_emit_line(out, "  %start_i = phi i64 [23, %zero_case], [%cur_i, %no_sign], [%next_i, %prepend_minus]")
    codegen_util::cg_emit_line(out, "  %str_len = sub i64 24, %start_i")
    codegen_util::cg_emit_line(out, "  %rbuf = call ptr @qz_alloc_str(i64 %str_len)")
    codegen_util::cg_emit_line(out, "  %src = getelementptr [24 x i8], ptr %sbuf, i64 0, i64 %start_i")
    codegen_util::cg_emit_line(out, "  call ptr @memcpy(ptr %rbuf, ptr %src, i64 %str_len)")
    codegen_util::cg_emit_line(out, "  %rval = ptrtoint ptr %rbuf to i64")
    codegen_util::cg_emit_line(out, "  ret i64 %rval")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # vec_reverse: in-place element swap. Libc-free.
    codegen_util::cg_emit_line(out, "define void @qz_vec_reverse(i64 %vec) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %hdr = inttoptr i64 %vec to ptr")
    codegen_util::cg_emit_line(out, "  %size.ptr = getelementptr i64, ptr %hdr, i64 1")
    codegen_util::cg_emit_line(out, "  %size = load i64, ptr %size.ptr")
    codegen_util::cg_emit_line(out, "  %data.ptr = getelementptr i64, ptr %hdr, i64 2")
    codegen_util::cg_emit_line(out, "  %data.i = load i64, ptr %data.ptr")
    codegen_util::cg_emit_line(out, "  %data = inttoptr i64 %data.i to ptr")
    codegen_util::cg_emit_line(out, "  %half = sdiv i64 %size, 2")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "loop:")
    codegen_util::cg_emit_line(out, "  %i = phi i64 [0, %entry], [%i.next, %body]")
    codegen_util::cg_emit_line(out, "  %done = icmp sge i64 %i, %half")
    codegen_util::cg_emit_line(out, "  br i1 %done, label %finish, label %body")
    codegen_util::cg_emit_line(out, "body:")
    codegen_util::cg_emit_line(out, "  %j = sub i64 %size, %i")
    codegen_util::cg_emit_line(out, "  %j1 = sub i64 %j, 1")
    codegen_util::cg_emit_line(out, "  %ptr.lo = getelementptr i64, ptr %data, i64 %i")
    codegen_util::cg_emit_line(out, "  %ptr.hi = getelementptr i64, ptr %data, i64 %j1")
    codegen_util::cg_emit_line(out, "  %val.lo = load i64, ptr %ptr.lo")
    codegen_util::cg_emit_line(out, "  %val.hi = load i64, ptr %ptr.hi")
    codegen_util::cg_emit_line(out, "  store i64 %val.hi, ptr %ptr.lo")
    codegen_util::cg_emit_line(out, "  store i64 %val.lo, ptr %ptr.hi")
    codegen_util::cg_emit_line(out, "  %i.next = add i64 %i, 1")
    codegen_util::cg_emit_line(out, "  br label %loop")
    codegen_util::cg_emit_line(out, "finish:")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # Pure-int formatter (no pointer-sniff) — sb_append_int and any
    # int-format-only path routes through this instead of @to_str.
    cg_emit_int_to_str_helper(out)

    # Freestanding RNG (B.5e.8c). std/actor's restart-backoff jitter
    # (`backoff_next_delay_at`) emits `@qz_rand_range`, which calls
    # `@qz_rand_int` over the `@qz_rng_s0..s3` state globals. The hosted
    # definitions live past this early-return (codegen_runtime.qz ~10426 /
    # ~10958 / ~10996). They are pure-IR (xoshiro256** — no libc, no
    # syscalls), so we lift the state globals + both functions verbatim here.
    # Seeds are the same non-zero constants the hosted path uses (xoshiro256**
    # requires non-zero state). Backoff is disabled by default
    # (`backoff_disabled` → min_backoff_ms==0 short-circuits before any
    # rand_range call), so this is dead at runtime unless a kernel supervisor
    # opts into jittered backoff; it exists to satisfy the link.
    codegen_util::cg_emit_line(out, "@qz_rng_s0 = internal global i64 1234567890123456789")
    codegen_util::cg_emit_line(out, "@qz_rng_s1 = internal global i64 9876543210987654321")
    codegen_util::cg_emit_line(out, "@qz_rng_s2 = internal global i64 3141592653589793238")
    codegen_util::cg_emit_line(out, "@qz_rng_s3 = internal global i64 2718281828459045235")
    codegen_util::cg_emit_line(out, "")
    # qz_rand_int — xoshiro256** next (verbatim lift of the hosted body).
    codegen_util::cg_emit_line(out, "define i64 @qz_rand_int() nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %s0 = load i64, ptr @qz_rng_s0")
    codegen_util::cg_emit_line(out, "  %s1 = load i64, ptr @qz_rng_s1")
    codegen_util::cg_emit_line(out, "  %s2 = load i64, ptr @qz_rng_s2")
    codegen_util::cg_emit_line(out, "  %s3 = load i64, ptr @qz_rng_s3")
    codegen_util::cg_emit_line(out, "  %s1x5 = mul i64 %s1, 5")
    codegen_util::cg_emit_line(out, "  %shl7 = shl i64 %s1x5, 7")
    codegen_util::cg_emit_line(out, "  %shr57 = lshr i64 %s1x5, 57")
    codegen_util::cg_emit_line(out, "  %rotl = or i64 %shl7, %shr57")
    codegen_util::cg_emit_line(out, "  %result = mul i64 %rotl, 9")
    codegen_util::cg_emit_line(out, "  %t = shl i64 %s1, 17")
    codegen_util::cg_emit_line(out, "  %s2a = xor i64 %s2, %s0")
    codegen_util::cg_emit_line(out, "  %s3a = xor i64 %s3, %s1")
    codegen_util::cg_emit_line(out, "  %s1a = xor i64 %s1, %s2a")
    codegen_util::cg_emit_line(out, "  %s0a = xor i64 %s0, %s3a")
    codegen_util::cg_emit_line(out, "  %s2b = xor i64 %s2a, %t")
    codegen_util::cg_emit_line(out, "  %s3shl = shl i64 %s3a, 45")
    codegen_util::cg_emit_line(out, "  %s3shr = lshr i64 %s3a, 19")
    codegen_util::cg_emit_line(out, "  %s3b = or i64 %s3shl, %s3shr")
    codegen_util::cg_emit_line(out, "  store i64 %s0a, ptr @qz_rng_s0")
    codegen_util::cg_emit_line(out, "  store i64 %s1a, ptr @qz_rng_s1")
    codegen_util::cg_emit_line(out, "  store i64 %s2b, ptr @qz_rng_s2")
    codegen_util::cg_emit_line(out, "  store i64 %s3b, ptr @qz_rng_s3")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    # qz_rand_range — lo + (rand_int() urem span); span==0 → lo.
    codegen_util::cg_emit_line(out, "define i64 @qz_rand_range(i64 %lo, i64 %hi) nounwind noredzone {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %span = sub i64 %hi, %lo")
    codegen_util::cg_emit_line(out, "  %is_zero = icmp eq i64 %span, 0")
    codegen_util::cg_emit_line(out, "  br i1 %is_zero, label %ret_lo, label %do_rand")
    codegen_util::cg_emit_line(out, "do_rand:")
    codegen_util::cg_emit_line(out, "  %r = call i64 @qz_rand_int()")
    codegen_util::cg_emit_line(out, "  %rem = urem i64 %r, %span")
    codegen_util::cg_emit_line(out, "  %result = add i64 %lo, %rem")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "ret_lo:")
    codegen_util::cg_emit_line(out, "  ret i64 %lo")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    return
  end

  # External declarations for runtime
  codegen_util::cg_emit_line(out, "; Quartz Runtime Declarations")
  codegen_util::cg_emit_line(out, "")

  # Core I/O
  codegen_util::cg_emit_line(out, "declare i64 @puts(ptr)")
  codegen_util::cg_emit_line(out, "declare i64 @printf(ptr, ...)")
  codegen_util::cg_emit_line(out, "declare i32 @sprintf(ptr, ptr, ...)")
  codegen_util::cg_emit_line(out, "declare i32 @snprintf(ptr, i64, ptr, ...)")
  codegen_util::cg_emit_line(out, "declare i32 @fprintf(ptr, ptr, ...)")
  codegen_util::cg_emit_line(out, "declare i64 @write(i32, ptr, i64)")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "")

  # Memory management
  codegen_util::cg_emit_line(out, "declare noalias ptr @malloc(i64)")
  codegen_util::cg_emit_line(out, "declare ptr @realloc(ptr, i64)")
  codegen_util::cg_emit_line(out, "declare void @free(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @mmap(ptr, i64, i32, i32, i32, i64)")
  codegen_util::cg_emit_line(out, "declare i32 @munmap(ptr, i64)")
  codegen_util::cg_emit_line(out, "declare ptr @memcpy(ptr, ptr, i64)")
  codegen_util::cg_emit_line(out, "declare i32 @memcmp(ptr, ptr, i64)")
  codegen_util::cg_emit_line(out, "declare ptr @memset(ptr, i32, i64)")
  codegen_util::cg_emit_line(out, "declare void @qsort(ptr, i64, i64, ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @strrchr(ptr, i32)")
  codegen_util::cg_emit_line(out, "declare ptr @strncpy(ptr, ptr, i64)")
  codegen_util::cg_emit_line(out, "")

  # String operations
  codegen_util::cg_emit_line(out, "declare i64 @strlen(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @strcmp(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @strcpy(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @strcat(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare i64 @atoll(ptr)")
  codegen_util::cg_emit_line(out, "declare double @strtod(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @getenv(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @strdup(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @fgetc(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @access(ptr, i32)")  # file_exists intrinsic
  codegen_util::cg_emit_line(out, "declare i32 @mkdir(ptr, i32)")
  codegen_util::cg_emit_line(out, "declare i32 @rmdir(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @chdir(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @getcwd(ptr, i64)")
  codegen_util::cg_emit_line(out, "declare i32 @rename(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @remove(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @opendir(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @readdir(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @closedir(ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @stat(ptr, ptr)")
  codegen_util::cg_emit(out, "declare ptr @strtok(ptr, ptr)\ndeclare ptr @strstr(ptr, ptr)\n")
  
  # POSIX regex operations — not available on WASI
  if cg_is_wasi(target) == 0
    codegen_util::cg_emit_line(out, "declare i32 @regcomp(ptr, ptr, i32)")
    codegen_util::cg_emit_line(out, "declare i32 @regexec(ptr, ptr, i64, ptr, i32)")
    codegen_util::cg_emit_line(out, "declare void @regfree(ptr)")
    # PCRE2-backed regex runtime functions (from quartz-bootstrap/src/regex.c)
    codegen_util::cg_emit_line(out, "declare i1 @regex_match_pattern(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare i64 @regex_count_pattern(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_replace_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_replace_all_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_capture_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare i64 @regex_match_start_pattern(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare i64 @regex_match_end_pattern(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_split_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_find_all_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @regex_capture_named_pattern(ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "")
  end
  
  # File I/O (use i8* for FILE* - opaque pointer for portability)
  codegen_util::cg_emit_line(out, "declare ptr @fopen(ptr, ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @fclose(ptr)")
  codegen_util::cg_emit_line(out, "declare i64 @fread(ptr, i64, i64, ptr)")
  codegen_util::cg_emit_line(out, "declare i64 @fwrite(ptr, i64, i64, ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @fseek(ptr, i64, i32)")
  codegen_util::cg_emit_line(out, "declare i64 @ftell(ptr)")
  codegen_util::cg_emit_line(out, "declare void @rewind(ptr)")
  codegen_util::cg_emit_line(out, "declare ptr @fgets(ptr, i32, ptr)")
  codegen_util::cg_emit_line(out, "declare i32 @fputs(ptr, ptr)")
  # Platform-specific stderr access: macOS uses @__stderrp, Linux uses @stderr,
  # Windows (mingw-w64 UCRT) routes through __acrt_iob_func(2) — no global.
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "declare ptr @__acrt_iob_func(i32)")
  elsif cg_is_linux(target)
    codegen_util::cg_emit_line(out, "@stderr = external global ptr")
  else
    codegen_util::cg_emit_line(out, "@__stderrp = external global ptr")
  end
  codegen_util::cg_emit_line(out, "")
  
  # Process — exit/abort available everywhere, system/popen POSIX-only.
  # Windows: system+popen exist via UCRT but with underscored names (_popen);
  # posix_spawnp / waitpid / pipe / dup2 / fcntl / fileno / poll / signal etc.
  # are POSIX-only. Windows v1 emits stub bodies for the runtime helpers that
  # use them (Phase 2 of QUARTZ_WINDOWS_TARGET.md §Path A).
  codegen_util::cg_emit_line(out, "declare void @exit(i32)")
  codegen_util::cg_emit_line(out, "declare void @_exit(i32)")
  codegen_util::cg_emit_line(out, "declare void @abort()")
  if cg_is_wasi(target) == 0 and cg_is_windows(target) == 0
    codegen_util::cg_emit_line(out, "declare i32 @system(ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @setenv(ptr, ptr, i32)")
    codegen_util::cg_emit_line(out, "declare ptr @popen(ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @pclose(ptr)")
    codegen_util::cg_emit_line(out, "declare ptr @fdopen(i32, ptr)")
    # Parallel-safe subprocess spawn (posix_spawnp + waitpid) — bypasses
    # the libc system()/popen() process-wide mutex so worker goroutines
    # can spawn child processes concurrently. See cg_intrinsic_system.qz
    # `posix_spawn_wait` and the __qz_posix_spawn_wait helper below.
    codegen_util::cg_emit_line(out, "declare i32 @posix_spawnp(ptr, ptr, ptr, ptr, ptr, ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @waitpid(i32, ptr, i32)")
    codegen_util::cg_emit_line(out, "@environ = external global ptr")
    codegen_util::cg_emit_line(out, "@.qz_psp_sh = private unnamed_addr constant [8 x i8] c\"/bin/sh\\00\"")
    codegen_util::cg_emit_line(out, "@.qz_psp_dashc = private unnamed_addr constant [3 x i8] c\"-c\\00\"")
    # Once-flag for SIGINT/SIGTERM handler install, plus a flag the
    # handler sets (signal() is required to be a real function so
    # children can inherit a non-SIG_IGN handler that execvp resets to
    # SIG_DFL — that's how children still die from Ctrl+C with the
    # standard 130 exit status that the qspec runner already detects).
    codegen_util::cg_emit_line(out, "@__qz_psp_sigint_once = global i32 0")
    codegen_util::cg_emit_line(out, "@__qz_psp_sigint_flag = global i64 0")
    codegen_util::cg_emit_line(out, "")
    # SIGINT/SIGTERM handler used by __qz_posix_spawn_wait. Stores 1
    # into the flag and returns. Default action would terminate the
    # parent process; this prevents that and lets the qspec runner
    # detect cancel via children's exit-130 instead.
    codegen_util::cg_emit_line(out, "define void @__qz_psp_sig_handler(i32 %sig) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr @__qz_psp_sigint_flag monotonic, align 8")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    # __qz_posix_spawn_wait(cmd: ptr) → i64 raw wait-status
    # First call CASes the once-flag and installs the no-op SIGINT/SIGTERM
    # handler, then runs `/bin/sh -c <cmd>` via posix_spawnp + waitpid
    # (no libc mutex, so goroutines run truly in parallel). Returns the
    # same raw status format as system() so existing
    # `result/256` and `band(result,127)` decoders work unchanged.
    codegen_util::cg_emit_line(out, "define i64 @__qz_posix_spawn_wait(ptr %cmd) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %once.cas = cmpxchg ptr @__qz_psp_sigint_once, i32 0, i32 1 acq_rel monotonic")
    codegen_util::cg_emit_line(out, "  %once.won = extractvalue { i32, i1 } %once.cas, 1")
    codegen_util::cg_emit_line(out, "  br i1 %once.won, label %do_install, label %after_install")
    codegen_util::cg_emit_line(out, "do_install:")
    codegen_util::cg_emit_line(out, "  call ptr @signal(i32 2, ptr @__qz_psp_sig_handler)")
    codegen_util::cg_emit_line(out, "  call ptr @signal(i32 15, ptr @__qz_psp_sig_handler)")
    codegen_util::cg_emit_line(out, "  br label %after_install")
    codegen_util::cg_emit_line(out, "after_install:")
    codegen_util::cg_emit_line(out, "  %argv = alloca [4 x ptr]")
    codegen_util::cg_emit_line(out, "  %argv0 = getelementptr inbounds [4 x ptr], ptr %argv, i64 0, i64 0")
    codegen_util::cg_emit_line(out, "  store ptr @.qz_psp_sh, ptr %argv0")
    codegen_util::cg_emit_line(out, "  %argv1 = getelementptr inbounds [4 x ptr], ptr %argv, i64 0, i64 1")
    codegen_util::cg_emit_line(out, "  store ptr @.qz_psp_dashc, ptr %argv1")
    codegen_util::cg_emit_line(out, "  %argv2 = getelementptr inbounds [4 x ptr], ptr %argv, i64 0, i64 2")
    codegen_util::cg_emit_line(out, "  store ptr %cmd, ptr %argv2")
    codegen_util::cg_emit_line(out, "  %argv3 = getelementptr inbounds [4 x ptr], ptr %argv, i64 0, i64 3")
    codegen_util::cg_emit_line(out, "  store ptr null, ptr %argv3")
    codegen_util::cg_emit_line(out, "  %pid_buf = alloca i32")
    codegen_util::cg_emit_line(out, "  %envp = load ptr, ptr @environ")
    codegen_util::cg_emit_line(out, "  %sp.rc = call i32 @posix_spawnp(ptr %pid_buf, ptr @.qz_psp_sh, ptr null, ptr null, ptr %argv, ptr %envp)")
    codegen_util::cg_emit_line(out, "  %sp.ok = icmp eq i32 %sp.rc, 0")
    codegen_util::cg_emit_line(out, "  br i1 %sp.ok, label %do_wait, label %sp_fail")
    codegen_util::cg_emit_line(out, "sp_fail:")
    codegen_util::cg_emit_line(out, "  ret i64 -1")
    codegen_util::cg_emit_line(out, "do_wait:")
    codegen_util::cg_emit_line(out, "  %pid = load i32, ptr %pid_buf")
    codegen_util::cg_emit_line(out, "  %wstat_buf = alloca i32")
    codegen_util::cg_emit_line(out, "  store i32 0, ptr %wstat_buf")
    codegen_util::cg_emit_line(out, "  call i32 @waitpid(i32 %pid, ptr %wstat_buf, i32 0)")
    codegen_util::cg_emit_line(out, "  %wstat = load i32, ptr %wstat_buf")
    codegen_util::cg_emit_line(out, "  %wstat64 = sext i32 %wstat to i64")
    codegen_util::cg_emit_line(out, "  ret i64 %wstat64")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # POSIX-only stdout redirection primitives (pipe + fcntl + poll). These
    # are not in mingw-w64. The portable I/O primitives below are emitted in
    # their own block so Windows still gets them.
    codegen_util::cg_emit_line(out, "declare i32 @pipe(ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @fcntl(i32, i32, ...)")
    codegen_util::cg_emit_line(out, "declare i32 @poll(ptr, i32, i32)")
    codegen_util::cg_emit_line(out, "@__stdoutp = external global ptr")
    codegen_util::cg_emit_line(out, "")
  end

  # Universally-available POSIX I/O primitives — mingw-w64 ships these too,
  # so we don't gate them behind Windows. Required by qz_redirect_stderr_to_file,
  # qz_restore_stderr, and qz_capture_output_end bodies.
  if cg_is_wasi(target) == 0
    codegen_util::cg_emit_line(out, "declare i32 @dup(i32)")
    codegen_util::cg_emit_line(out, "declare i32 @dup2(i32, i32)")
    codegen_util::cg_emit_line(out, "declare i32 @close(i32)")
    codegen_util::cg_emit_line(out, "declare i32 @fflush(ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @fileno(ptr)")
    codegen_util::cg_emit_line(out, "declare i64 @read(i32, ptr, i64)")
    codegen_util::cg_emit_line(out, "")
  end

  # ============================================================================
  # Concurrency Runtime (pthread) — not available on WASI
  # ============================================================================
  # On Windows: emit the pthread→Win32 shim block instead of the POSIX
  # externs. The shim provides definitions for every pthread_* symbol used
  # in the scheduler IR, wrapping native SRWLOCK / CONDITION_VARIABLE /
  # CreateThread primitives. No winpthreads.dll dependency.
  # See cg_emit_windows_thread_shims above + docs/design/QUARTZ_WINDOWS_TARGET.md §5a.
  if cg_is_wasi(target) == 0
    if cg_is_windows(target)
      cg_emit_windows_thread_shims(out)
    else
      # pthread types (opaque pointers)
      codegen_util::cg_emit_line(out, "; Concurrency runtime declarations")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_create(ptr, ptr, ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_join(i64, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_detach(i64)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_attr_init(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_attr_setdetachstate(ptr, i32)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_mutex_init(ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_mutex_lock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_mutex_unlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_mutex_trylock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_init(ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_wait(ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_signal(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_broadcast(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_timedwait(ptr, ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_mutex_destroy(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_cond_destroy(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_init(ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_rdlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_tryrdlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_wrlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_trywrlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_unlock(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_rwlock_destroy(ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @clock_gettime(i32, ptr)")
      codegen_util::cg_emit_line(out, "declare i64 @sysconf(i32)")
      codegen_util::cg_emit_line(out, "declare i32 @usleep(i32)")
      codegen_util::cg_emit_line(out, "declare i32 @sched_yield()")
      codegen_util::cg_emit_line(out, "declare i32 @nanosleep(ptr, ptr)")
      codegen_util::cg_emit_line(out, "declare i32 @setjmp(ptr) returns_twice")
      codegen_util::cg_emit_line(out, "declare void @longjmp(ptr, i32) noreturn")
      codegen_util::cg_emit_line(out, "declare i32 @atexit(void()*)")
      codegen_util::cg_emit_line(out, "declare void (i32)* @signal(i32, void (i32)*)")
      # pthread TLS API — used instead of thread_local attribute (lli doesn't support emutls)
      codegen_util::cg_emit_line(out, "declare i32 @pthread_key_create(ptr, void(ptr)*)")
      codegen_util::cg_emit_line(out, "declare i32 @pthread_setspecific(i64, ptr)")
      codegen_util::cg_emit_line(out, "declare ptr @pthread_getspecific(i64)")
      codegen_util::cg_emit_line(out, "declare i64 @pthread_self()")
      # Thread naming for debugger visibility
      if cg_is_macos(target)
        codegen_util::cg_emit_line(out, "declare i32 @pthread_setname_np(ptr)")
      else
        codegen_util::cg_emit_line(out, "declare i32 @pthread_setname_np(i64, ptr)")
      end
      codegen_util::cg_emit_line(out, "")
    end
  end

  codegen_util::cg_emit_line(out, "")

  # Panic capture jmpbuf — per-thread access, implementation depends on target
  if cg_is_wasi(target) == 0
    # Native: pthread_key_t for thread-safe access (works with both lli and native)
    codegen_util::cg_emit_line(out, "; panic capture: per-thread jmpbuf via pthread_key (null = abort on panic)")
    codegen_util::cg_emit_line(out, "@__qz_panic_key = global i64 0")
    codegen_util::cg_emit_line(out, "@__qz_panic_key_once = global i64 0")
    codegen_util::cg_emit_line(out, "")
    # Lazy-init the pthread_key_t (once per process, thread-safe via cmpxchg)
    codegen_util::cg_emit_line(out, "define void @__qz_panic_key_ensure() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %cas = cmpxchg ptr @__qz_panic_key_once, i64 0, i64 1 acq_rel monotonic")
    codegen_util::cg_emit_line(out, "  %won = extractvalue { i64, i1 } %cas, 1")
    codegen_util::cg_emit_line(out, "  br i1 %won, label %do_init, label %done")
    codegen_util::cg_emit_line(out, "do_init:")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_key_create(ptr @__qz_panic_key, void(ptr)* null)")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "done:")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    # Get: returns current thread's jmpbuf (or null).
    # HB-DOG.7: must ensure the pthread key is created before
    # `pthread_getspecific` — `_get` can be reached (via a bounds /
    # overflow / map-key panic, or the panic intrinsic) in a process
    # that never started the scheduler, so `_set` (the only other
    # `__qz_panic_key_ensure` caller) may never have run. With the key
    # still 0, `pthread_getspecific(0)` is undefined behavior — on macOS
    # key 0 is libc-reserved TSD and returns a non-null garbage pointer,
    # so the panic helper `longjmp`s into garbage → SIGSEGV instead of a
    # clean abort. A freshly-created pthread key reads back NULL until
    # `_set`, so this also yields the correct "no handler installed".
    codegen_util::cg_emit_line(out, "define ptr @__qz_panic_jmpbuf_get() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  call void @__qz_panic_key_ensure()")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_panic_key")
    codegen_util::cg_emit_line(out, "  %val = call ptr @pthread_getspecific(i64 %key)")
    codegen_util::cg_emit_line(out, "  ret ptr %val")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    # Set: store jmpbuf for this thread
    codegen_util::cg_emit_line(out, "define void @__qz_panic_jmpbuf_set(ptr %val) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  call void @__qz_panic_key_ensure()")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_panic_key")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_setspecific(i64 %key, ptr %val)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
    # WASI: single-threaded, use plain global
    codegen_util::cg_emit_line(out, "; panic capture: single-threaded jmpbuf (WASI)")
    codegen_util::cg_emit_line(out, "@__qz_panic_jmpbuf_wasi = global ptr null")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "define ptr @__qz_panic_jmpbuf_get() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %val = load ptr, ptr @__qz_panic_jmpbuf_wasi")
    codegen_util::cg_emit_line(out, "  ret ptr %val")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "define void @__qz_panic_jmpbuf_set(ptr %val) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  store ptr %val, ptr @__qz_panic_jmpbuf_wasi")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # Structured concurrency: task_group runtime (conditional — only when program uses task_group)
  # Group layout (48 bytes): [frames@0, results@8, count@16, cap@24, cancelled@32, pending@40]
  if uses_task_group == 1
    codegen_util::cg_emit_line(out, "; task_group cancel pointer (per-thread via pthread_key)")
    codegen_util::cg_emit_line(out, "@__qz_cancel_key = global i64 0")
    codegen_util::cg_emit_line(out, "@__qz_cancel_key_once = global i64 0")
    # Cancel key init + get/set helpers
    codegen_util::cg_emit_line(out, "define void @__qz_cancel_key_ensure() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %cas = cmpxchg ptr @__qz_cancel_key_once, i64 0, i64 1 acq_rel monotonic")
    codegen_util::cg_emit_line(out, "  %won = extractvalue { i64, i1 } %cas, 1")
    codegen_util::cg_emit_line(out, "  br i1 %won, label %do_init, label %done")
    codegen_util::cg_emit_line(out, "do_init:")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_key_create(ptr @__qz_cancel_key, void(ptr)* null)")
    codegen_util::cg_emit_line(out, "  br label %done")
    codegen_util::cg_emit_line(out, "done:")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "define ptr @__qz_cancel_get() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_cancel_key")
    codegen_util::cg_emit_line(out, "  %val = call ptr @pthread_getspecific(i64 %key)")
    codegen_util::cg_emit_line(out, "  ret ptr %val")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit_line(out, "define void @__qz_cancel_set(ptr %val) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  call void @__qz_cancel_key_ensure()")
    codegen_util::cg_emit_line(out, "  %key = load i64, ptr @__qz_cancel_key")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_setspecific(i64 %key, ptr %val)")
    codegen_util::cg_emit_line(out, "  ret void")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")

    # (Pool runtime removed — task_group now routes through M:N scheduler)

    # __qz_tg_poll(frame): generic poll function for task_group closures on scheduler
    # Frame layout: [0]=state, [1]=result, [2]=poll_fn, [3]=closure, [4]=task_id, [5]=group_ptr, [6]=index
    codegen_util::cg_emit_line(out, "define i64 @__qz_tg_poll(i64 %frame.i) nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %frame = inttoptr i64 %frame.i to ptr")
    # Load closure from frame[3]
    codegen_util::cg_emit_line(out, "  %clo.gep = getelementptr i64, ptr %frame, i64 3")
    codegen_util::cg_emit_line(out, "  %clo = load i64, ptr %clo.gep")
    # Set cancel pointer from group (frame[5] → group.cancelled at byte 32)
    codegen_util::cg_emit_line(out, "  %grp.gep = getelementptr i64, ptr %frame, i64 5")
    codegen_util::cg_emit_line(out, "  %grp.i = load i64, ptr %grp.gep")
    codegen_util::cg_emit_line(out, "  %grp.p = inttoptr i64 %grp.i to ptr")
    codegen_util::cg_emit_line(out, "  %cancel.gep = getelementptr i8, ptr %grp.p, i64 32")
    codegen_util::cg_emit_line(out, "  call void @__qz_cancel_set(ptr %cancel.gep)")
    # Tag-bit closure dispatch
    codegen_util::cg_emit_line(out, "  %tag = and i64 %clo, 1")
    codegen_util::cg_emit_line(out, "  %is_clo = icmp eq i64 %tag, 1")
    codegen_util::cg_emit_line(out, "  br i1 %is_clo, label %dispatch_clo, label %dispatch_fn")
    codegen_util::cg_emit_line(out, "dispatch_clo:")
    codegen_util::cg_emit_line(out, "  %env.i = and i64 %clo, -2")
    codegen_util::cg_emit_line(out, "  %env.p = inttoptr i64 %env.i to ptr")
    codegen_util::cg_emit_line(out, "  %code.i = load i64, ptr %env.p")
    codegen_util::cg_emit_line(out, "  %code = inttoptr i64 %code.i to i64 (i64)*")
    codegen_util::cg_emit_line(out, "  %res.clo = call i64 %code(i64 %env.i)")
    codegen_util::cg_emit_line(out, "  br label %store_result")
    codegen_util::cg_emit_line(out, "dispatch_fn:")
    codegen_util::cg_emit_line(out, "  %fn = inttoptr i64 %clo to i64 ()*")
    codegen_util::cg_emit_line(out, "  %res.fn = call i64 %fn()")
    codegen_util::cg_emit_line(out, "  br label %store_result")
    codegen_util::cg_emit_line(out, "store_result:")
    codegen_util::cg_emit_line(out, "  %result = phi i64 [%res.clo, %dispatch_clo], [%res.fn, %dispatch_fn]")
    # Store result in frame[1] and set state = -1 (done)
    codegen_util::cg_emit_line(out, "  %res.slot = getelementptr i64, ptr %frame, i64 1")
    codegen_util::cg_emit_line(out, "  store i64 %result, ptr %res.slot")
    codegen_util::cg_emit_line(out, "  store i64 -1, ptr %frame")
    # Store result in group's results array (frame[5]=group, frame[6]=index)
    codegen_util::cg_emit_line(out, "  %idx.gep = getelementptr i64, ptr %frame, i64 6")
    codegen_util::cg_emit_line(out, "  %idx = load i64, ptr %idx.gep")
    codegen_util::cg_emit_line(out, "  %grp.res.gep = getelementptr i8, ptr %grp.p, i64 8")
    codegen_util::cg_emit_line(out, "  %grp.res.pp = bitcast ptr %grp.res.gep to ptr")
    codegen_util::cg_emit_line(out, "  %grp.res.i = load i64, ptr %grp.res.pp")
    codegen_util::cg_emit_line(out, "  %grp.res = inttoptr i64 %grp.res.i to ptr")
    codegen_util::cg_emit_line(out, "  %grp.res.slot = getelementptr i64, ptr %grp.res, i64 %idx")
    codegen_util::cg_emit_line(out, "  store i64 %result, ptr %grp.res.slot")
    # Atomically decrement group.pending
    codegen_util::cg_emit_line(out, "  %pend.gep = getelementptr i8, ptr %grp.p, i64 40")
    codegen_util::cg_emit_line(out, "  %pend.p = bitcast ptr %pend.gep to ptr")
    codegen_util::cg_emit_line(out, "  %pend.old = atomicrmw sub ptr %pend.p, i64 1 seq_cst")
    # Clear cancel pointer
    codegen_util::cg_emit_line(out, "  call void @__qz_cancel_set(ptr null)")
    codegen_util::cg_emit_line(out, "  ret i64 %result")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # =========================================================================
  # Colorless Concurrency: Poll-Closure Bridge
  # =========================================================================
  # Enables `go do ... end` blocks by bridging closures to the scheduler's
  # poll interface. The scheduler expects frame[2] to point to a poll function
  # (i64 -> i64). This function loads a closure from frame[4] and calls it.
  codegen_util::cg_emit_line(out, "define i64 @__qz_poll_closure(i64 %frame_i) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %frame = inttoptr i64 %frame_i to ptr")
  codegen_util::cg_emit_line(out, "  %clo.gep = getelementptr i64, ptr %frame, i64 4")
  codegen_util::cg_emit_line(out, "  %clo = load i64, ptr %clo.gep")
  # Tag-bit closure dispatch (same pattern as taskgroup_spawn)
  codegen_util::cg_emit_line(out, "  %tag = and i64 %clo, 1")
  codegen_util::cg_emit_line(out, "  %is_clo = icmp eq i64 %tag, 1")
  codegen_util::cg_emit_line(out, "  br i1 %is_clo, label %dispatch_clo, label %dispatch_fn")
  codegen_util::cg_emit_line(out, "dispatch_clo:")
  codegen_util::cg_emit_line(out, "  %env.i = and i64 %clo, -2")
  codegen_util::cg_emit_line(out, "  %env.p = inttoptr i64 %env.i to ptr")
  codegen_util::cg_emit_line(out, "  %code.i = load i64, ptr %env.p")
  codegen_util::cg_emit_line(out, "  %code = inttoptr i64 %code.i to i64 (i64)*")
  codegen_util::cg_emit_line(out, "  %res.clo = call i64 %code(i64 %env.i)")
  codegen_util::cg_emit_line(out, "  br label %pc_store")
  codegen_util::cg_emit_line(out, "dispatch_fn:")
  codegen_util::cg_emit_line(out, "  %fn = inttoptr i64 %clo to i64 ()*")
  codegen_util::cg_emit_line(out, "  %res.fn = call i64 %fn()")
  codegen_util::cg_emit_line(out, "  br label %pc_store")
  codegen_util::cg_emit_line(out, "pc_store:")
  codegen_util::cg_emit_line(out, "  %result = phi i64 [%res.clo, %dispatch_clo], [%res.fn, %dispatch_fn]")
  codegen_util::cg_emit_line(out, "  %res.slot = getelementptr i64, ptr %frame, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 %result, ptr %res.slot")
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr %frame")
  codegen_util::cg_emit_line(out, "  ret i64 1")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # =========================================================================
  # Monotonic Clock Helper — used by time_mono_ns intrinsic
  # Windows: QueryPerformanceCounter + QueryPerformanceFrequency. Both live in
  # kernel32 (always linked, no -l needed); replacing the mingw-w64
  # clock_gettime shim with QPC drops the runtime libwinpthread dependency for
  # pure-compute Windows binaries that don't otherwise need it. Overflow-safe
  # mixed-precision split: (c/f)*1e9 + (c%f)*1e9/f — for typical QPC freq ~10MHz
  # the modulo factor is bounded by 1e7, so (c%f)*1e9 < 1e16, comfortably i64.
  # =========================================================================
  if cg_is_wasi(target) == 0
    if cg_is_windows(target)
      codegen_util::cg_emit_line(out, "declare i32 @QueryPerformanceFrequency(ptr) nounwind")
      codegen_util::cg_emit_line(out, "declare i32 @QueryPerformanceCounter(ptr) nounwind")
      codegen_util::cg_emit_line(out, "define i64 @__qz_time_mono_ns() nounwind {")
      codegen_util::cg_emit_line(out, "entry:")
      codegen_util::cg_emit_line(out, "  %freq.buf = alloca i64")
      codegen_util::cg_emit_line(out, "  %ctr.buf = alloca i64")
      codegen_util::cg_emit_line(out, "  call i32 @QueryPerformanceFrequency(ptr %freq.buf)")
      codegen_util::cg_emit_line(out, "  call i32 @QueryPerformanceCounter(ptr %ctr.buf)")
      codegen_util::cg_emit_line(out, "  %freq = load i64, ptr %freq.buf")
      codegen_util::cg_emit_line(out, "  %ctr = load i64, ptr %ctr.buf")
      codegen_util::cg_emit_line(out, "  %q = sdiv i64 %ctr, %freq")
      codegen_util::cg_emit_line(out, "  %r = srem i64 %ctr, %freq")
      codegen_util::cg_emit_line(out, "  %high = mul i64 %q, 1000000000")
      codegen_util::cg_emit_line(out, "  %r2 = mul i64 %r, 1000000000")
      codegen_util::cg_emit_line(out, "  %low = sdiv i64 %r2, %freq")
      codegen_util::cg_emit_line(out, "  %ns = add i64 %high, %low")
      codegen_util::cg_emit_line(out, "  ret i64 %ns")
      codegen_util::cg_emit_line(out, "}")
      codegen_util::cg_emit_line(out, "")
    else
      codegen_util::cg_emit_line(out, "define i64 @__qz_time_mono_ns() nounwind {")
      codegen_util::cg_emit_line(out, "entry:")
      codegen_util::cg_emit_line(out, "  %ts.buf = alloca [2 x i64]")
      codegen_util::cg_emit_line(out, "  %ts.p = bitcast [2 x i64]* %ts.buf to ptr")
      if str_contains(target, "apple") or str_contains(target, "macos")
        codegen_util::cg_emit_line(out, "  call i32 @clock_gettime(i32 6, ptr %ts.p)")
      else
        codegen_util::cg_emit_line(out, "  call i32 @clock_gettime(i32 1, ptr %ts.p)")
      end
      codegen_util::cg_emit_line(out, "  %ts.sec.p = getelementptr [2 x i64], [2 x i64]* %ts.buf, i64 0, i64 0")
      codegen_util::cg_emit_line(out, "  %ts.sec = load i64, ptr %ts.sec.p")
      codegen_util::cg_emit_line(out, "  %ts.nsec.p = getelementptr [2 x i64], [2 x i64]* %ts.buf, i64 0, i64 1")
      codegen_util::cg_emit_line(out, "  %ts.nsec = load i64, ptr %ts.nsec.p")
      codegen_util::cg_emit_line(out, "  %ts.s2ns = mul i64 %ts.sec, 1000000000")
      codegen_util::cg_emit_line(out, "  %ts.ns = add i64 %ts.s2ns, %ts.nsec")
      codegen_util::cg_emit_line(out, "  ret i64 %ts.ns")
      codegen_util::cg_emit_line(out, "}")
      codegen_util::cg_emit_line(out, "")
    end
  end

  # =========================================================================
  # Peak RSS Helper — used by mem_peak_rss intrinsic
  # Windows: K32GetProcessMemoryInfo (exported by kernel32 since Win7;
  # avoids the psapi.dll redirect, so no -lpsapi). Buffer is a
  # PROCESS_MEMORY_COUNTERS — 72 bytes on x64:
  #   0   DWORD  cb                       (set to 72 on input)
  #   4   DWORD  PageFaultCount
  #   8   SIZE_T PeakWorkingSetSize       ← what we want
  #  16   SIZE_T WorkingSetSize
  #  24   SIZE_T QuotaPeakPagedPoolUsage
  #  32   SIZE_T QuotaPagedPoolUsage
  #  40   SIZE_T QuotaPeakNonPagedPoolUsage
  #  48   SIZE_T QuotaNonPagedPoolUsage
  #  56   SIZE_T PagefileUsage
  #  64   SIZE_T PeakPagefileUsage
  # GetCurrentProcess() returns the pseudo-handle (HANDLE)-1.
  # =========================================================================
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "declare ptr @GetCurrentProcess() nounwind")
    codegen_util::cg_emit_line(out, "declare i32 @K32GetProcessMemoryInfo(ptr, ptr, i32) nounwind")
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_peak_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %pmc = alloca [72 x i8]")
    codegen_util::cg_emit_line(out, "  %pmc.ptr = bitcast [72 x i8]* %pmc to ptr")
    # Set cb field (offset 0) to 72 so the API knows the buffer size
    codegen_util::cg_emit_line(out, "  %cb.p = bitcast ptr %pmc.ptr to ptr")
    codegen_util::cg_emit_line(out, "  store i32 72, ptr %cb.p")
    codegen_util::cg_emit_line(out, "  %hproc = call ptr @GetCurrentProcess()")
    codegen_util::cg_emit_line(out, "  %r = call i32 @K32GetProcessMemoryInfo(ptr %hproc, ptr %pmc.ptr, i32 72)")
    codegen_util::cg_emit_line(out, "  %ok = icmp ne i32 %r, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ok, label %read, label %fail")
    codegen_util::cg_emit_line(out, "read:")
    codegen_util::cg_emit_line(out, "  %peak.p = getelementptr i8, ptr %pmc.ptr, i64 8")
    codegen_util::cg_emit_line(out, "  %peak.p64 = bitcast ptr %peak.p to ptr")
    codegen_util::cg_emit_line(out, "  %peak = load i64, ptr %peak.p64")
    codegen_util::cg_emit_line(out, "  ret i64 %peak")
    codegen_util::cg_emit_line(out, "fail:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  elsif cg_is_wasi(target) == 0
    codegen_util::cg_emit_line(out, "declare i32 @getrusage(i32, ptr)")
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_peak_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %ru.buf = alloca [18 x i64]")
    codegen_util::cg_emit_line(out, "  call i32 @getrusage(i32 0, ptr %ru.buf)")
    codegen_util::cg_emit_line(out, "  %ru.maxrss.p = getelementptr i64, ptr %ru.buf, i64 4")
    codegen_util::cg_emit_line(out, "  %ru.maxrss = load i64, ptr %ru.maxrss.p")
    codegen_util::cg_emit_line(out, "  ret i64 %ru.maxrss")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_peak_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # =========================================================================
  # Current RSS Helper — used by mem_current_rss intrinsic
  # Uses mach_task_basic_info on macOS, /proc/self/statm on Linux
  # =========================================================================
  if str_contains(target, "apple")
    # macOS: mach_task_basic_info → resident_size field
    # struct mach_task_basic_info (48 bytes, MACH_TASK_BASIC_INFO_COUNT=12):
    #   offset 0: virtual_size (i64)
    #   offset 8: resident_size (i64) ← we want this
    #   offset 16: resident_size_max (i64)
    #   offset 24: user_time (8 bytes), offset 32: system_time (8 bytes)
    #   offset 40: policy (i32), offset 44: suspend_count (i32)
    codegen_util::cg_emit_line(out, "declare i32 @mach_task_self()")
    codegen_util::cg_emit_line(out, "declare i32 @task_info(i32, i32, ptr, ptr)")
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_current_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %info = alloca [48 x i8]")
    codegen_util::cg_emit_line(out, "  %count = alloca i32")
    codegen_util::cg_emit_line(out, "  store i32 12, ptr %count")
    codegen_util::cg_emit_line(out, "  %self = call i32 @mach_task_self()")
    # MACH_TASK_BASIC_INFO = 20
    codegen_util::cg_emit_line(out, "  %r = call i32 @task_info(i32 %self, i32 20, ptr %info, ptr %count)")
    codegen_util::cg_emit_line(out, "  %ok = icmp eq i32 %r, 0")
    codegen_util::cg_emit_line(out, "  br i1 %ok, label %read, label %fail")
    codegen_util::cg_emit_line(out, "read:")
    codegen_util::cg_emit_line(out, "  %rss.p = getelementptr i8, ptr %info, i64 8")
    codegen_util::cg_emit_line(out, "  %rss = load i64, ptr %rss.p")
    codegen_util::cg_emit_line(out, "  ret i64 %rss")
    codegen_util::cg_emit_line(out, "fail:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  elsif str_contains(target, "linux")
    # Linux: read /proc/self/statm, 2nd field * page_size.
    # fopen/fclose/sysconf are already declared above (file-IO block +
    # pthread/concurrency block, both unconditional on linux) — re-declaring
    # them here produces duplicate `declare`s that make the IR llc-invalid.
    # Only fscanf is unique to this helper.
    codegen_util::cg_emit_line(out, "declare i32 @fscanf(ptr, ptr, ...)")
    codegen_util::cg_emit_line(out, "@.statm_path = private constant [17 x i8] c\"/proc/self/statm\\00\"")
    codegen_util::cg_emit_line(out, "@.statm_fmt = private constant [8 x i8] c\"%ld %ld\\00\"")
    codegen_util::cg_emit_line(out, "@.statm_r = private constant [2 x i8] c\"r\\00\"")
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_current_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  %vsize = alloca i64")
    codegen_util::cg_emit_line(out, "  %rss_pages = alloca i64")
    codegen_util::cg_emit_line(out, "  %fp = call ptr @fopen(ptr @.statm_path, ptr @.statm_r)")
    codegen_util::cg_emit_line(out, "  %null = icmp eq ptr %fp, null")
    codegen_util::cg_emit_line(out, "  br i1 %null, label %fail, label %read")
    codegen_util::cg_emit_line(out, "read:")
    codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @fscanf(ptr %fp, ptr @.statm_fmt, ptr %vsize, ptr %rss_pages)")
    codegen_util::cg_emit_line(out, "  call i32 @fclose(ptr %fp)")
    codegen_util::cg_emit_line(out, "  %pages = load i64, ptr %rss_pages")
    # _SC_PAGESIZE = 30 on Linux
    codegen_util::cg_emit_line(out, "  %pgsz = call i64 @sysconf(i32 30)")
    codegen_util::cg_emit_line(out, "  %rss = mul i64 %pages, %pgsz")
    codegen_util::cg_emit_line(out, "  ret i64 %rss")
    codegen_util::cg_emit_line(out, "fail:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  else
    # WASI / other: stub
    codegen_util::cg_emit_line(out, "define i64 @__qz_mem_current_rss() nounwind {")
    codegen_util::cg_emit_line(out, "entry:")
    codegen_util::cg_emit_line(out, "  ret i64 0")
    codegen_util::cg_emit_line(out, "}")
    codegen_util::cg_emit_line(out, "")
  end

  # =========================================================================
  # __qz_mem_release: ask the system allocator to return excess pooled
  # memory to the OS. Returns bytes released (or 0 on platforms that
  # don't expose this).
  #
  # macOS: malloc_zone_pressure_relief(NULL, 0)
  # Linux: malloc_trim(0)  (returns 1 on success, but we return 0 either
  #        way since we don't track bytes freed)
  if cg_is_wasi(target) == 0
    if str_contains(target, "apple")
      codegen_util::cg_emit_line(out, "declare i64 @malloc_zone_pressure_relief(ptr, i64)")
      codegen_util::cg_emit_line(out, "define internal i64 @__qz_mem_release() nounwind {")
      codegen_util::cg_emit_line(out, "entry:")
      codegen_util::cg_emit_line(out, "  %r = call i64 @malloc_zone_pressure_relief(ptr null, i64 0)")
      codegen_util::cg_emit_line(out, "  ret i64 %r")
      codegen_util::cg_emit_line(out, "}")
      codegen_util::cg_emit_line(out, "")
    elsif str_contains(target, "linux")
      codegen_util::cg_emit_line(out, "declare i32 @malloc_trim(i64)")
      codegen_util::cg_emit_line(out, "define internal i64 @__qz_mem_release() nounwind {")
      codegen_util::cg_emit_line(out, "entry:")
      codegen_util::cg_emit_line(out, "  %_r = call i32 @malloc_trim(i64 0)")
      codegen_util::cg_emit_line(out, "  ret i64 0")
      codegen_util::cg_emit_line(out, "}")
      codegen_util::cg_emit_line(out, "")
    else
      codegen_util::cg_emit_line(out, "define internal i64 @__qz_mem_release() nounwind {")
      codegen_util::cg_emit_line(out, "entry:")
      codegen_util::cg_emit_line(out, "  ret i64 0")
      codegen_util::cg_emit_line(out, "}")
      codegen_util::cg_emit_line(out, "")
    end
  end

  # __qz_fuel_refill(): reset TLS fuel counter and yield CPU (cold path for fuel_check)
  # Always emitted (not scheduler-conditional) because fuel_check is instrumented in all code.
  # Uses POSIX sched_yield() instead of usleep(1) — NEVER block a worker OS thread.
  # Also checks shutdown flag to force-terminate tasks during graceful shutdown.
  codegen_util::cg_emit_line(out, "define void @__qz_fuel_refill() nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  store i64 4000, ptr @__qz_sched_fuel")
  # Check shutdown flag — if set, mark current task as done and return
  codegen_util::cg_emit_line(out, "  %fr.sd = load atomic i64, ptr @__qz_signal_shutdown monotonic, align 8")
  codegen_util::cg_emit_line(out, "  %fr.shutting = icmp ne i64 %fr.sd, 0")
  codegen_util::cg_emit_line(out, "  br i1 %fr.shutting, label %fr.shutdown, label %fr.yield")
  codegen_util::cg_emit_line(out, "fr.shutdown:")
  # Force-terminate: set current frame state to -1 (done) if in async context
  codegen_util::cg_emit_line(out, "  %fr.frame = load i64, ptr @__qz_current_frame")
  codegen_util::cg_emit_line(out, "  %fr.has_frame = icmp ne i64 %fr.frame, 0")
  codegen_util::cg_emit_line(out, "  br i1 %fr.has_frame, label %fr.kill_task, label %fr.yield")
  codegen_util::cg_emit_line(out, "fr.kill_task:")
  codegen_util::cg_emit_line(out, "  %fr.fp = inttoptr i64 %fr.frame to ptr")
  codegen_util::cg_emit_line(out, "  store i64 -1, ptr %fr.fp")
  # Force-unwind via longjmp to worker's setjmp — instantly terminates the task
  # instead of letting it run to natural completion (could be billions of iterations).
  # Only works in worker threads where the panic jmpbuf is set.
  codegen_util::cg_emit_line(out, "  %fr.jmpbuf = call ptr @__qz_panic_jmpbuf_get()")
  codegen_util::cg_emit_line(out, "  %fr.has_jmpbuf = icmp ne ptr %fr.jmpbuf, null")
  codegen_util::cg_emit_line(out, "  br i1 %fr.has_jmpbuf, label %fr.longjmp, label %fr.ret")
  codegen_util::cg_emit_line(out, "fr.longjmp:")
  codegen_util::cg_emit_line(out, "  call void @longjmp(ptr %fr.jmpbuf, i32 1)")
  codegen_util::cg_emit_line(out, "  unreachable")
  codegen_util::cg_emit_line(out, "fr.ret:")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "fr.yield:")
  codegen_util::cg_emit_line(out, "  call i32 @sched_yield()")
  codegen_util::cg_emit_line(out, "  ret void")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # Signal-triggered shutdown flag — unconditional (recv/send check this for shutdown awareness)
  codegen_util::cg_emit_line(out, "@__qz_signal_shutdown = global i64 0")

  # @__qz_sched: always emitted (try_send/channel_close reference it for recv_q wakeup).
  # In non-scheduler programs, recv_q is always empty and pipe fds are -1,
  # so the code paths that use this are never taken.
  codegen_util::cg_emit_line(out, "@__qz_sched = global [36 x i64] zeroinitializer")

  # @__qz_sched_state: authoritative scheduler lifecycle state word.
  # B2 (Apr 14, 2026): replaces the `completion_map[3] != 0` / `iomap != 0`
  # pointer-proxy pattern that broke when freed-without-zero slots left
  # dangling non-null pointers. Transitions are explicit, atomic seq_cst,
  # and visible to every thread. Design follows Go runtime's sched state
  # machine, Tokio's worker State atomic, and libuv's loop_alive predicate
  # — all converged on "single atomic state variable, explicit transitions,
  # zero on free" as the anti-pattern to pointer-proxy checks.
  #
  # Values:
  #   0 = UNINIT   — not yet initialized OR fully torn down (equivalent)
  #   1 = RUNNING  — init completed, workers spawned, I/O poller alive
  #   2 = STOPPING — shutdown began, draining active tasks
  #   3 = STOPPED  — final state before returning to UNINIT; kept briefly
  #                  to distinguish "clean shutdown in progress" from UNINIT
  #                  for diagnostics
  #
  # sched_is_active() intrinsic reads this word via `load atomic seq_cst`
  # and compares with RUNNING. See cg_intrinsic_conc_sched.qz:sched_is_active.
  codegen_util::cg_emit_line(out, "@__qz_sched_state = global i64 0")

  # =========================================================================
  # M:N Scheduler Runtime (conditional — only when program uses go/sched_*)
  # =========================================================================
  if uses_scheduler == 1
  # @__qz_sched layout (20 i64 slots, 160 bytes):
  #   [0] workers      - pointer to pthread_t array
  #   [1] queue        - pointer to ring buffer of task frame pointers (4096 slots)
  #   [2] head         - dequeue index
  #   [3] tail         - enqueue index
  #   [4] cap          - queue capacity (4096)
  #   [5] count        - current queue size
  #   [6] mutex        - pthread_mutex_t* for queue protection
  #   [7] cond         - pthread_cond_t* for worker wakeup
  #   [8] shutdown     - flag for graceful shutdown
  #   [9] num_workers  - number of spawned worker threads
  #   [10] initialized - initialization sentinel
  #   [11] io_epfd     - kqueue/epoll fd for I/O event notification
  #   [12] io_map      - pointer to fd→task array (4096 slots, 32768 bytes)
  #   [13] io_poller   - pthread_t for I/O poller thread
  #   [14] io_pipe_r   - read end of wakeup pipe (to wake poller on shutdown)
  #   [15] io_pipe_w   - write end of wakeup pipe
  #   [16] active_tasks - count of spawned-but-not-completed tasks (protected by mutex)
  #   [17] wdata       - pointer to per-worker data array (12 i64 slots per worker)
  #   [18] max_tasks   - backpressure limit (0 = unlimited, >0 = max concurrent tasks)
  #   [19] task_id_ctr - atomic counter for unique task IDs (starts at 1)
  #
  # Per-worker data layout (12 i64 slots = 96 bytes per worker; must match
  # the `nw * 96` allocation in __qz_sched_init below and every wdata
  # accessor's `mul %wid, 12` stride — see sched_worker_busy_ns):
  #   [0] local_queue  - pointer to Chase-Lev deque buffer (256 i64 slots)
  #   [1] bottom       - deque bottom index (owner push/pop end)
  #   [2] top          - deque top index (steal end)
  #   [3] unused
  #   [4] local_cap    - capacity (256)
  #   [5] unused       - (was local_mutex; deque is lock-free, no mutex)
  #   [6] worker_id    - this worker's index (0..num_workers-1)
  #   [7] rng_state    - per-worker RNG state (victim selection for stealing)
  #   [8] busy_ns      - cumulative busy nanoseconds (sampled, scaled x64)
  #   [9] exec_start   - timestamp of current poll's start
  #   [10] pipe_rfd    - per-worker wakeup pipe read fd
  #   [11] pipe_wfd    - per-worker wakeup pipe write fd
  #
  # Task frame layout (from async state machines):
  #   [0] state        - -1=done, >=0=suspended at yield point N
  #   [1] result       - return value when done
  #   [2] poll_fn      - pointer to $poll function
  #   [3] cancel_token - cancel token (>0: cancel_on_failure, <0: cancel_on_success, 0: none)
  #   [4] task_id      - unique task ID, assigned by constructor via task_id_next
  #   [5] park_state   - atomic: 0=RUNNING, 1=PARKED, 2=WAKE_PENDING
  #   [6..] params, locals (PARAM_BASE=6)
  #
  # Worker calls poll_fn(frame). If state==-1 after return, task is done.
  # If poll returns < -1, task is blocked on I/O (fd = -(result+2)).
  # Otherwise task yielded and is re-enqueued.

  # @__qz_sched emitted unconditionally above (needed by try_send/channel_close recv_q code)
  # Scheduler introspection: monotonic completed-tasks counter (atomic)
  codegen_util::cg_emit_line(out, "@__qz_sched_completed = global i64 0")
  # Trace ring buffer: [0]=enabled, [1]=head, [2]=tail, [3]=buffer_ptr, [4]=mutex_ptr
  # Each event: 4 i64 slots [event_type, task_ptr, timestamp_ns, payload]
  # Buffer: 65536 events * 4 slots * 8 bytes = 2MB, oldest overwritten
  codegen_util::cg_emit_line(out, "@__qz_trace = global [5 x i64] zeroinitializer")
  # Completion notification map: [0]=array_ptr, [1]=count, [2]=capacity, [3]=mutex_ptr
  # Array stores flat pairs of (task_frame_ptr, notify_write_fd) as i64 values.
  # When a task completes, workers scan the map for matching frames and write to the pipe.
  codegen_util::cg_emit_line(out, "@__qz_completion_map = global [4 x i64] zeroinitializer")
  # Task-local storage: [0]=array_ptr, [1]=count, [2]=capacity, [3]=mutex_ptr
  # Array stores flat triples of (task_id, key, value) as i64 values.
  codegen_util::cg_emit_line(out, "@__qz_task_locals = global [4 x i64] zeroinitializer")
  # Task registry: [0]=array_ptr, [1]=count, [2]=capacity, [3]=mutex_ptr
  # Array stores flat quads: (task_id, parent_id, frame_ptr, status) per task
  # status: 0=inactive, 1=active, 2=done
  codegen_util::cg_emit_line(out, "@__qz_task_registry = global [4 x i64] zeroinitializer")
  # E.1.c.b task-snapshot side-table: [0]=array_ptr, [1]=count, [2]=capacity, [3]=mutex_ptr
  # Array stores flat pairs of (task_frame_ptr, snapshot_buf_ptr) as i64.
  # Populated at `go fn()` (default Async.spawn handler) when the parent has
  # user-installed handlers above blessed_watermark; consumed at worker
  # poll-dispatch (lookup) and task completion (take + free).
  codegen_util::cg_emit_line(out, "@__qz_task_snapshots = global [4 x i64] zeroinitializer")
  # B.7 Phase 4b task-scope side-table: same shape as task-snapshots but
  # holds (task_frame_ptr, scope_handle) pairs. Populated at `go fn()`
  # with the parent's spawn-time current_scope; consumed at worker poll
  # dispatch (lookup → load TLS at entry, save TLS → table at exit so
  # body's scope_with mutations survive yield/resume) and task completion
  # (take). No malloc'd buffer per entry — the scope handle IS the value,
  # so take needs no companion free.
  codegen_util::cg_emit_line(out, "@__qz_task_scopes = global [4 x i64] zeroinitializer")
  # B.7 Phase 4e.8 task-timer side-table: holds (task_frame_ptr, timer_ident_or_fd)
  # pairs for sched_sleep'd tasks. Populated by __qz_sched_register_timer after
  # successful kqueue/epoll registration; consumed by __qz_sched_wake to cancel
  # the pending timer (so the cancel-walker's wake call interrupts a sleeping
  # task within microseconds instead of waiting for the chunk timer to fire).
  # The poller's ev_enqueue path also clears the entry on natural timer-fire so
  # subsequent sched_wake calls correctly fall through to the CAS protocol.
  codegen_util::cg_emit_line(out, "@__qz_task_timers = global [4 x i64] zeroinitializer")
  # Phase 5e+ — Windows-only side-table mapping task → AFD SockState pointer.
  # Populated by __qz_sched_register_io's Windows branch after a successful
  # NtDeviceIoControlFile(IOCTL_AFD_POLL); consumed by __qz_sched_wake
  # (cancel-on-wake via NtCancelIoFileEx) and by the IOCP poller's ev_io:
  # handler (clear-on-natural-fire). Symmetric to __qz_task_timers's role
  # for sched_sleep cancellation.
  #
  # Closes the bounded-leak filed-forward from Phase 5e: pre-5e+ a
  # cancelled sched_park left the 72-byte SockState block in flight until
  # the AFD eventually completed naturally; on workloads with many
  # cancel-on-failure or scope-deadline cancellations of pending I/O, the
  # leak accumulated. NtCancelIoFileEx forces the kernel to complete the
  # request with STATUS_CANCELLED, which the poller's ev_io: handler
  # observes and frees the block immediately.
  #
  # Layout matches __qz_task_timers: [4 x i64] = [entries_ptr, count,
  # capacity, mutex_ptr]. Entries are (frame_i64, sockstate_i64) pairs,
  # 16 bytes each. Capacity 256 = 4096 bytes; same sizing as the timer
  # table (one in-flight io_suspend per task is the design contract).
  # Allocated globally on all targets so the IR refs to set/take helpers
  # link uniformly; only Windows actually initializes the mutex / arr.
  codegen_util::cg_emit_line(out, "@__qz_task_iosocks = global [4 x i64] zeroinitializer")
  # Phase 5c (Windows timers): software min-heap of (deadline_ns, task) pairs.
  # POSIX uses kqueue EVFILT_TIMER / timerfd routed through the per-fd io_map,
  # but Windows has no readiness-based timer-fd primitive. __qz_sched_register_timer
  # on Windows pushes here under heap.mutex; the IOCP poller drains expired
  # entries at the top of each loop iteration and computes the next-expiry-ms
  # to pass as GetQueuedCompletionStatusEx's wait timeout (libuv uv__next_timeout
  # pattern, src/timer.c). Single-claim semantics for sched_sleep cancellation
  # are serialised through heap.mutex — whichever side (poller drain vs.
  # sched_wake heap_cancel) zeroes the entry's task field owns the re-enqueue;
  # the loser's task_timer_take returns 0 and the cancel falls through to the
  # CAS protocol as a (benign) no-op, identical to the POSIX xchg loser branch.
  # Layout (5 i64s = 40 B):
  #   [0] entries_ptr — ptrtoint of [capacity × {deadline_ns: i64, task: i64}]
  #                     (16 B per entry; default capacity 1024 → 16 KB block)
  #   [1] count       — current heap size (protected by mutex)
  #   [2] capacity    — fixed at init; grow filed forward (1024 is libuv's
  #                     initial uv__hash_size and matches our scope_active count
  #                     ceiling on a 5M-task SOUL.5-style workload)
  #   [3] mutex_ptr   — pthread_mutex_t* (resolves to SRWLOCK via the 5a shim)
  #   [4] reserved
  # Allocated unconditionally (16 KB + 64 B = 16.06 KB; negligible vs io_map's
  # 512 KB allocation) so the helpers don't need conditional emission; only
  # Windows actually touches the heap.
  codegen_util::cg_emit_line(out, "@__qz_timer_heap = global [5 x i64] zeroinitializer")
  # C.13 Phase 5 resource-waiter side-table (C.14.3a hashmap rewrite):
  # separate-chaining hashmap with striped mutexes. Holds (target_key,
  # waiter_frame) pairs in 24-byte chain cells. Target_key is a kind-tagged
  # i64 — task frame, mutex/rwlock handle, channel handle | 0 (read-
  # waiters), channel handle | 1 (send-waiters), channel handle | 2
  # (close-event waiters). Populated by every Selectable.register_waker;
  # consumed by task_done / panic_caught / mutex unlock / channel send /
  # channel recv / channel close (notify path → sched_wake all matching
  # waiters; chain unlink + free). Multiple waiters per target supported.
  # Layout:
  #   [0] bucket_array_ptr (i64; ptrtoint of nbuckets * 8 bytes; each
  #                         slot is i64-as-cell-pointer or 0)
  #   [1] nbuckets         (initially 256, doubles on grow)
  #   [2] nbuckets_mask    (nbuckets - 1)
  #   [3] count            (atomic; total entries in chains)
  #   [4] stripes_block_ptr (i64; ptrtoint of NSTRIPES contiguous mutex
  #                          objects, 64 bytes each)
  #   [5] nstripes         (64)
  #   [6] stripes_mask     (63)
  #   [7] reserved         (0)
  codegen_util::cg_emit_line(out, "@__qz_waiters = global [8 x i64] zeroinitializer")
  # C.14.4 actor-exit clean-marker sidecar set. Holds inbox handles that
  # the actor closed cleanly (via the auto-generated stop / cascade-stop
  # paths in PASS_ACTOR). The supervisor's watcher consults this on close
  # detection to distinguish "actor self-stopped" (clean) from any other
  # path that closed the inbox (treated as crash for Transient restart
  # semantics). Fixed-size linear-scan array — sparse working set (close
  # events are bounded by close-rate × supervisor-read-latency, single-digit
  # to low-hundreds in practice). Layout:
  #   [0] entries_ptr (4096 × i64; 0 = empty, non-zero = clean-marked inbox)
  #   [1] count       (atomic; telemetry)
  #   [2] capacity    (4096; fixed for v1)
  #   [3] mutex_ptr   (pthread_mutex_t; single, contention is low — writes
  #                    only at actor close, reads only at supervisor death-detect)
  codegen_util::cg_emit_line(out, "@__qz_actor_exit_clean = global [4 x i64] zeroinitializer")
  # Signal dump flag: set by SIGUSR1 handler, checked by worker loop
  codegen_util::cg_emit_line(out, "@__qz_dump_requested = global i64 0")
  # @__qz_current_frame and @__qz_task_id_counter emitted unconditionally above
  # Thread name format string and pthread_setname_np declaration
  codegen_util::cg_emit_line(out, "@.qz_sched_name = private unnamed_addr constant [13 x i8] c\"qz-sched-%ld\\00\"")
  # Task tree string constants
  codegen_util::cg_emit_line(out, "@.stt_hdr = private unnamed_addr constant [23 x i8] c\"=== Task Tree (count: \\00\"")
  codegen_util::cg_emit_line(out, "@.stt_nl = private unnamed_addr constant [5 x i8] c\") ==\\00\"")
  codegen_util::cg_emit_line(out, "@.dt_task = private unnamed_addr constant [8 x i8] c\"  task \\00\"")
  codegen_util::cg_emit_line(out, "@.dt_parent = private unnamed_addr constant [9 x i8] c\" parent=\\00\"")
  codegen_util::cg_emit_line(out, "@.dt_status = private unnamed_addr constant [9 x i8] c\" status=\\00\"")
  codegen_util::cg_emit_line(out, "@.dt_newline = private unnamed_addr constant [2 x i8] c\"\\0A\\00\"")
  codegen_util::cg_emit_line(out, "@.qz_io_name = private unnamed_addr constant [11 x i8] c\"qz-io-poll\\00\"")
  codegen_util::cg_emit_line(out, "")

  # I/O poller declarations (kqueue on macOS, epoll on Linux, no-op stubs on Windows)
  # Note: pipe() and close() already declared in capture_output / task_group section.
  # Windows v1 (Phase 5a): the I/O poller body is emitted but never spawned;
  # we provide return-error stub definitions so the kqueue/epoll references
  # inside the (dead) body link cleanly. Phase 5b replaces these with real
  # IOCP-backed equivalents at the call sites, and the stubs go away.
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "define i32 @kqueue() nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @kevent(i32, ptr, i32, ptr, i32, ptr) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @epoll_create1(i32) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @epoll_ctl(i32, i32, i32, ptr) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @epoll_wait(i32, ptr, i32, i32) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @timerfd_create(i32, i32) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @timerfd_settime(i32, i32, ptr, ptr) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @pidfd_open(i32, i32) nounwind { ret i32 -1 }")
    # pipe / fcntl — referenced by the (dead-on-Windows) wakeup-pipe paths.
    # Stub them too rather than gate every callsite. These get superseded by
    # PostQueuedCompletionStatus in 5b.
    codegen_util::cg_emit_line(out, "define i32 @pipe(ptr) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "define i32 @fcntl(i32, i32, ...) nounwind { ret i32 -1 }")
    codegen_util::cg_emit_line(out, "@__qz_timer_peers = global i64 0")
    codegen_util::cg_emit_line(out, "@__qz_pidfd_set = global i64 0")
  elsif cg_is_macos(target)
    codegen_util::cg_emit_line(out, "declare i32 @kqueue()")
    codegen_util::cg_emit_line(out, "declare i32 @kevent(i32, ptr, i32, ptr, i32, ptr)")
  else
    codegen_util::cg_emit_line(out, "declare i32 @epoll_create1(i32)")
    codegen_util::cg_emit_line(out, "declare i32 @epoll_ctl(i32, i32, i32, ptr)")
    codegen_util::cg_emit_line(out, "declare i32 @epoll_wait(i32, ptr, i32, i32)")
    codegen_util::cg_emit_line(out, "declare i32 @timerfd_create(i32, i32)")
    codegen_util::cg_emit_line(out, "declare i32 @timerfd_settime(i32, i32, ptr, ptr)")
    # pidfd_open(pid, flags) → fd. Linux 5.3+ kernel. Direct glibc 2.36+ wrapper.
    # Used by __qz_sched_register_proc for pidfd-based child exit detection.
    codegen_util::cg_emit_line(out, "declare i32 @pidfd_open(i32, i32)")
    codegen_util::cg_emit_line(out, "@__qz_timer_peers = global i64 0")
    # @__qz_pidfd_set: 65536-slot bitmap-as-i64-array marking which fds in io_map
    # are pidfds (1) vs regular I/O fds (0). Allocated in sched_init alongside
    # io_map. Used by the I/O poller to close pidfds after they fire (epoll
    # ONESHOT removes the fd from epoll but doesn't close it).
    codegen_util::cg_emit_line(out, "@__qz_pidfd_set = global i64 0")
  end
  codegen_util::cg_emit_line(out, "")

  # Standalone eputs/str_from_int for hand-coded runtime IR (scheduler dump, trace).
  # These intrinsics are normally inlined, but hand-coded IR needs callable functions.
  codegen_util::cg_emit_line(out, "define i64 @eputs(i64 %ep.str) nounwind {")
  codegen_util::cg_emit_line(out, "ep_entry:")
  codegen_util::cg_emit_line(out, "  %ep.ptr = inttoptr i64 %ep.str to ptr")
  # Windows must come first — the existing `str_contains "gnu"` predicate
  # matches `x86_64-pc-windows-gnu`, so Windows would otherwise fall into the
  # @stderr (Linux) branch and fail to link.
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %ep.stderr = call ptr @__acrt_iob_func(i32 2)")
  elsif str_contains(target, "linux") or str_contains(target, "gnu")
    codegen_util::cg_emit_line(out, "  %ep.stderr = load ptr, ptr @stderr")
  else
    codegen_util::cg_emit_line(out, "  %ep.stderr = load ptr, ptr @__stderrp")
  end
  codegen_util::cg_emit_line(out, "  %ep.fmt = getelementptr [4 x i8], [4 x i8]* @.fmt.sn, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @fprintf(ptr %ep.stderr, ptr %ep.fmt, ptr %ep.ptr)")
  codegen_util::cg_emit_line(out, "  ret i64 0")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")
  codegen_util::cg_emit_line(out, "define i64 @str_from_int(i64 %sfi.n) nounwind {")
  codegen_util::cg_emit_line(out, "sfi_entry:")
  codegen_util::cg_emit_line(out, "  %sfi.buf = call ptr @__qz_alloc(i64 32)")
  codegen_util::cg_emit_line(out, "  %sfi.fmt = getelementptr [4 x i8], [4 x i8]* @.fmt.int.noln, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  call i32 (ptr, ptr, ...) @sprintf(ptr %sfi.buf, ptr %sfi.fmt, i64 %sfi.n)")
  codegen_util::cg_emit_line(out, "  %sfi.wrapped = call ptr @qz_wrap_cstr(ptr %sfi.buf)")
  codegen_util::cg_emit_line(out, "  call void @__qz_dealloc(ptr %sfi.buf)")
  codegen_util::cg_emit_line(out, "  %sfi.result = ptrtoint ptr %sfi.wrapped to i64")
  codegen_util::cg_emit_line(out, "  ret i64 %sfi.result")
  codegen_util::cg_emit_line(out, "}")
  codegen_util::cg_emit_line(out, "")

  # __qz_sched_init(num_workers): initialize the M:N scheduler
  codegen_util::cg_emit_line(out, "define void @__qz_sched_init(i64 %nw_req) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %init.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 10")
  codegen_util::cg_emit_line(out, "  %init.val = load i64, ptr %init.ptr")
  codegen_util::cg_emit_line(out, "  %already = icmp ne i64 %init.val, 0")
  codegen_util::cg_emit_line(out, "  br i1 %already, label %done, label %do_init")
  codegen_util::cg_emit_line(out, "do_init:")
  # Reset signal/draining/shutdown/active_tasks flags (may be stale from previous init/shutdown cycle)
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_signal_shutdown")
  codegen_util::cg_emit_line(out, "  %drain.reset.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 34")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %drain.reset.p")
  # Reset active_tasks (slot 16) — may be negative after graceful timeout + fuel_refill longjmp
  codegen_util::cg_emit_line(out, "  %at.reset.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 16")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %at.reset.p")
  # Reset shutdown flag (slot 8)
  codegen_util::cg_emit_line(out, "  %sd.reset.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 8")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr %sd.reset.p")
  # Determine worker count: use arg if > 0, else auto-detect
  codegen_util::cg_emit_line(out, "  %nw.has = icmp sgt i64 %nw_req, 0")
  codegen_util::cg_emit_line(out, "  br i1 %nw.has, label %nw_use_arg, label %nw_auto")
  codegen_util::cg_emit_line(out, "nw_use_arg:")
  codegen_util::cg_emit_line(out, "  %nw.clamped.hi = icmp sgt i64 %nw_req, 64")
  codegen_util::cg_emit_line(out, "  %nw.from_arg = select i1 %nw.clamped.hi, i64 64, i64 %nw_req")
  codegen_util::cg_emit_line(out, "  br label %nw_done")
  codegen_util::cg_emit_line(out, "nw_auto:")
  if str_contains(target, "apple") or str_contains(target, "macos")
    codegen_util::cg_emit_line(out, "  %ncpu = call i64 @sysconf(i32 58)")
  else
    codegen_util::cg_emit_line(out, "  %ncpu = call i64 @sysconf(i32 84)")
  end
  codegen_util::cg_emit_line(out, "  %ncpu.lo = icmp slt i64 %ncpu, 1")
  codegen_util::cg_emit_line(out, "  %ncpu1 = select i1 %ncpu.lo, i64 1, i64 %ncpu")
  codegen_util::cg_emit_line(out, "  %ncpu.hi = icmp sgt i64 %ncpu1, 64")
  codegen_util::cg_emit_line(out, "  %nw.from_auto = select i1 %ncpu.hi, i64 64, i64 %ncpu1")
  codegen_util::cg_emit_line(out, "  br label %nw_done")
  codegen_util::cg_emit_line(out, "nw_done:")
  codegen_util::cg_emit_line(out, "  %nw = phi i64 [%nw.from_arg, %nw_use_arg], [%nw.from_auto, %nw_auto]")
  # Store num_workers
  codegen_util::cg_emit_line(out, "  %nw.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 9")
  codegen_util::cg_emit_line(out, "  store i64 %nw, ptr %nw.ptr")
  # Allocate ring buffer: 1048576 slots * 8 bytes = 8388608 (8 MB)
  # Supports up to 1M concurrent tasks in the global queue
  codegen_util::cg_emit_line(out, "  %queue = call ptr @__qz_alloc(i64 8388608)")
  codegen_util::cg_emit_line(out, "  %queue.i = ptrtoint ptr %queue to i64")
  codegen_util::cg_emit_line(out, "  %q.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  store i64 %queue.i, ptr %q.ptr")
  # cap = 1048576
  codegen_util::cg_emit_line(out, "  %cap.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 4")
  codegen_util::cg_emit_line(out, "  store i64 1048576, ptr %cap.ptr")
  # Allocate and init mutex
  codegen_util::cg_emit_line(out, "  %mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %mtx.i = ptrtoint ptr %mtx to i64")
  codegen_util::cg_emit_line(out, "  %mtx.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 6")
  codegen_util::cg_emit_line(out, "  store i64 %mtx.i, ptr %mtx.ptr")
  # Allocate and init condvar
  codegen_util::cg_emit_line(out, "  %cond = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %cond, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_cond_init(ptr %cond, ptr null)")
  codegen_util::cg_emit_line(out, "  %cond.i = ptrtoint ptr %cond to i64")
  codegen_util::cg_emit_line(out, "  %cond.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 7")
  codegen_util::cg_emit_line(out, "  store i64 %cond.i, ptr %cond.ptr")
  # Create kqueue/epoll fd for I/O event notification — Windows v1 (Phase
  # 5a) skips this entirely. The slot stays 0; Phase 5b lights it up with
  # CreateIoCompletionPort. Without an I/O poller, pure-compute Quartz
  # programs (no fd I/O, no sched_sleep, no process spawn) run fine; any
  # call into the I/O surface will hit a stub trap until 5b–5e land.
  if cg_is_windows(target)
    # Phase 5b — IOCP HANDLE in slot 11 (i64 holds ptrtoint of HANDLE).
    # CreateIoCompletionPort(INVALID_HANDLE_VALUE=-1, NULL, 0, 1):
    #   1st arg = (HANDLE)-1 to create a fresh port (vs. associate one)
    #   2nd arg = NULL existing port
    #   3rd arg = 0 completion key (we encode kind in the per-post key)
    #   4th arg = 1 NumberOfConcurrentThreads (single poller thread).
    codegen_util::cg_emit_line(out, "  %io.iocp.inv = inttoptr i64 -1 to ptr")
    codegen_util::cg_emit_line(out, "  %io.iocp = call ptr @CreateIoCompletionPort(ptr %io.iocp.inv, ptr null, i64 0, i32 1)")
    codegen_util::cg_emit_line(out, "  %io.iocp.i64 = ptrtoint ptr %io.iocp to i64")
    codegen_util::cg_emit_line(out, "  %io.iocp.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  store i64 %io.iocp.i64, ptr %io.iocp.ptr")
    # Phase 5e — open the AFD device and associate with IOCP. The AFD HANDLE
    # is the single Quartz-runtime-wide pollset for sockets; per-socket
    # SockState blocks pass through it via NtDeviceIoControlFile(IOCTL_AFD_POLL).
    # Build a UNICODE_STRING pointing at @.qz_afd_dev (36 bytes of UTF-16LE
    # for "\Device\Afd\Quartz", NUL-free per UNICODE_STRING contract). The
    # OBJECT_ATTRIBUTES struct points at the UNICODE_STRING.
    codegen_util::cg_emit_line(out, "  %afd.unistr = alloca [16 x i8]")
    codegen_util::cg_emit_line(out, "  %afd.unistr.p = bitcast [16 x i8]* %afd.unistr to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %afd.unistr.p, i32 0, i64 16)")
    # Length (USHORT, offset 0) = 36 (byte count, not including any NUL)
    codegen_util::cg_emit_line(out, "  store i16 36, ptr %afd.unistr.p")
    # MaximumLength (USHORT, offset 2) = 36
    codegen_util::cg_emit_line(out, "  %afd.unistr.maxp = getelementptr i8, ptr %afd.unistr.p, i64 2")
    codegen_util::cg_emit_line(out, "  store i16 36, ptr %afd.unistr.maxp")
    # Buffer (PWSTR, offset 8) = &@.qz_afd_dev
    codegen_util::cg_emit_line(out, "  %afd.unistr.bufp = getelementptr i8, ptr %afd.unistr.p, i64 8")
    codegen_util::cg_emit_line(out, "  %afd.dev.p = getelementptr [36 x i8], [36 x i8]* @.qz_afd_dev, i64 0, i64 0")
    codegen_util::cg_emit_line(out, "  store ptr %afd.dev.p, ptr %afd.unistr.bufp")
    # OBJECT_ATTRIBUTES (48 bytes): Length=48, RootDirectory=NULL,
    # ObjectName=&unistr, Attributes=0, SecurityDescriptor=NULL,
    # SecurityQualityOfService=NULL
    codegen_util::cg_emit_line(out, "  %afd.objattr = alloca [48 x i8]")
    codegen_util::cg_emit_line(out, "  %afd.objattr.p = bitcast [48 x i8]* %afd.objattr to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %afd.objattr.p, i32 0, i64 48)")
    # Length (ULONG, offset 0) = sizeof(OBJECT_ATTRIBUTES) = 48
    codegen_util::cg_emit_line(out, "  store i32 48, ptr %afd.objattr.p")
    # ObjectName (PUNICODE_STRING, offset 16) = &unistr
    codegen_util::cg_emit_line(out, "  %afd.objattr.namep = getelementptr i8, ptr %afd.objattr.p, i64 16")
    codegen_util::cg_emit_line(out, "  store ptr %afd.unistr.p, ptr %afd.objattr.namep")
    # Output: PHANDLE for the new AFD HANDLE
    codegen_util::cg_emit_line(out, "  %afd.handle.slot = alloca ptr")
    codegen_util::cg_emit_line(out, "  %afd.iosb = alloca [16 x i8]")
    codegen_util::cg_emit_line(out, "  %afd.iosb.p = bitcast [16 x i8]* %afd.iosb to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %afd.iosb.p, i32 0, i64 16)")
    # NtCreateFile(PHANDLE, DesiredAccess=SYNCHRONIZE=0x00100000, &ObjectAttributes,
    #              &IoStatusBlock, AllocationSize=NULL, FileAttributes=0,
    #              ShareAccess=FILE_SHARE_READ|FILE_SHARE_WRITE=3,
    #              CreateDisposition=FILE_OPEN=1, CreateOptions=0,
    #              EaBuffer=NULL, EaLength=0). On failure the slot stays 0;
    # subsequent CreateIoCompletionPort + SetFileCompletionNotificationModes
    # on a null HANDLE return errors that we ignore (the failure surfaces
    # at register_io time via the AFD path's negative-NTSTATUS handler).
    # Linear chain — no conditional branches that would split this basic
    # block and break downstream phi predecessors.
    codegen_util::cg_emit_line(out, "  %afd.nt = call i32 @NtCreateFile(ptr %afd.handle.slot, i32 1048576, ptr %afd.objattr.p, ptr %afd.iosb.p, ptr null, i32 0, i32 3, i32 1, i32 0, ptr null, i32 0)")
    codegen_util::cg_emit_line(out, "  %afd.handle = load ptr, ptr %afd.handle.slot")
    codegen_util::cg_emit_line(out, "  %afd.handle.i64 = ptrtoint ptr %afd.handle to i64")
    codegen_util::cg_emit_line(out, "  %afd.slot33.p = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 33")
    codegen_util::cg_emit_line(out, "  store i64 %afd.handle.i64, ptr %afd.slot33.p")
    # Associate AFD HANDLE with IOCP: CreateIoCompletionPort(afd, iocp,
    # CompletionKey=0, NumberOfConcurrentThreads=0 [ignored when associating]).
    codegen_util::cg_emit_line(out, "  call ptr @CreateIoCompletionPort(ptr %afd.handle, ptr %io.iocp, i64 0, i32 0)")
    # Skip event-set-on-completion path — completion arrives via IOCP, no
    # need for the kernel to also signal the HANDLE's event.
    codegen_util::cg_emit_line(out, "  call i32 @SetFileCompletionNotificationModes(ptr %afd.handle, i8 2)")
  else
    if cg_is_macos(target)
      codegen_util::cg_emit_line(out, "  %io.epfd = call i32 @kqueue()")
    else
      codegen_util::cg_emit_line(out, "  %io.epfd = call i32 @epoll_create1(i32 0)")
    end
    codegen_util::cg_emit_line(out, "  %io.epfd.i64 = sext i32 %io.epfd to i64")
    codegen_util::cg_emit_line(out, "  %io.epfd.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 11")
    codegen_util::cg_emit_line(out, "  store i64 %io.epfd.i64, ptr %io.epfd.ptr")
  end
  # Allocate fd→task map: 65536 slots * 8 bytes = 524288. The map is
  # allocated on every target (including Windows) because cg_intrinsic_*
  # paths reference @__qz_sched slot 12; leaving it null would segfault
  # the first lookup. The Windows map stays empty until 5b's IOCP path
  # populates it.
  codegen_util::cg_emit_line(out, "  %io.map = call ptr @__qz_alloc(i64 524288)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %io.map, i32 0, i64 524288)")
  codegen_util::cg_emit_line(out, "  %io.map.i = ptrtoint ptr %io.map to i64")
  codegen_util::cg_emit_line(out, "  %io.map.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 12")
  codegen_util::cg_emit_line(out, "  store i64 %io.map.i, ptr %io.map.ptr")
  # Phase 5c (Windows): allocate the timer min-heap. 1024 entries × 16 B
  # (deadline_ns + task per entry) = 16 KB block; 64 B mutex object;
  # capacity, entries_ptr, mutex_ptr written into the @__qz_timer_heap
  # slots. POSIX targets leave the heap zeroed — the helpers compile on
  # every target so the IR links, but only the IOCP poller actually
  # drains entries.
  if cg_is_windows(target)
    codegen_util::cg_emit_line(out, "  %th.mem = call ptr @__qz_alloc(i64 16384)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %th.mem, i32 0, i64 16384)")
    codegen_util::cg_emit_line(out, "  %th.mem.i = ptrtoint ptr %th.mem to i64")
    codegen_util::cg_emit_line(out, "  %th.arr.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 0")
    codegen_util::cg_emit_line(out, "  store i64 %th.mem.i, ptr %th.arr.p")
    codegen_util::cg_emit_line(out, "  %th.cap.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 2")
    codegen_util::cg_emit_line(out, "  store i64 1024, ptr %th.cap.p")
    codegen_util::cg_emit_line(out, "  %th.mtx = call ptr @__qz_alloc(i64 64)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %th.mtx, i32 0, i64 64)")
    codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %th.mtx, ptr null)")
    codegen_util::cg_emit_line(out, "  %th.mtx.i = ptrtoint ptr %th.mtx to i64")
    codegen_util::cg_emit_line(out, "  %th.mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 3")
    codegen_util::cg_emit_line(out, "  store i64 %th.mtx.i, ptr %th.mtx.p")
  end
  # Linux: allocate timer_peers array for timerfd↔fd peer tracking
  if cg_is_macos(target) == 0 and cg_is_windows(target) == 0
    codegen_util::cg_emit_line(out, "  %tp.mem = call ptr @__qz_alloc(i64 524288)")
    # Initialize all slots to 0 (no peer)
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %tp.mem, i32 0, i64 524288)")
    codegen_util::cg_emit_line(out, "  %tp.i = ptrtoint ptr %tp.mem to i64")
    codegen_util::cg_emit_line(out, "  store i64 %tp.i, ptr @__qz_timer_peers")
    # Allocate pidfd_set: 65536-slot array (i64 each = 524288 bytes) marking
    # which io_map entries are pidfds. Poller reads this on event fire to
    # decide whether to close(fd) (cleans up the leaked pidfd) before reenqueue.
    codegen_util::cg_emit_line(out, "  %pfds.mem = call ptr @__qz_alloc(i64 524288)")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %pfds.mem, i32 0, i64 524288)")
    codegen_util::cg_emit_line(out, "  %pfds.i = ptrtoint ptr %pfds.mem to i64")
    codegen_util::cg_emit_line(out, "  store i64 %pfds.i, ptr @__qz_pidfd_set")
  end
  # Create wakeup pipe for signaling I/O poller on shutdown — skipped on
  # Windows (5b will use PostQueuedCompletionStatus instead). The pipe-fd
  # slots stay 0 on Windows; sched_shutdown branches read them as "no
  # pipe → no drain" so leaving them zeroed is correct.
  if cg_is_windows(target) == 0
    codegen_util::cg_emit_line(out, "  %io.pipe = alloca [2 x i32]")
    codegen_util::cg_emit_line(out, "  %io.pipe.ptr = bitcast [2 x i32]* %io.pipe to ptr")
    codegen_util::cg_emit_line(out, "  call i32 @pipe(ptr %io.pipe.ptr)")
    # Set pipe read end to non-blocking (needed for drain in poller loop)
    codegen_util::cg_emit_line(out, "  %io.pipe.r.raw = load i32, ptr %io.pipe.ptr")
    codegen_util::cg_emit_line(out, "  %io.pipe.r.flags = call i32 @fcntl(i32 %io.pipe.r.raw, i32 3)")
    codegen_util::cg_emit_line(out, "  %io.pipe.r.nb = or i32 %io.pipe.r.flags, 4")
    codegen_util::cg_emit_line(out, "  call i32 @fcntl(i32 %io.pipe.r.raw, i32 4, i32 %io.pipe.r.nb)")
    codegen_util::cg_emit_line(out, "  %io.pipe.r = load i32, ptr %io.pipe.ptr")
    codegen_util::cg_emit_line(out, "  %io.pipe.r.gep = getelementptr i32, ptr %io.pipe.ptr, i64 1")
    codegen_util::cg_emit_line(out, "  %io.pipe.w = load i32, ptr %io.pipe.r.gep")
    codegen_util::cg_emit_line(out, "  %io.pipe.r.i64 = sext i32 %io.pipe.r to i64")
    codegen_util::cg_emit_line(out, "  %io.pipe.w.i64 = sext i32 %io.pipe.w to i64")
    codegen_util::cg_emit_line(out, "  %io.pr.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 14")
    codegen_util::cg_emit_line(out, "  store i64 %io.pipe.r.i64, ptr %io.pr.ptr")
    codegen_util::cg_emit_line(out, "  %io.pw.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 15")
    codegen_util::cg_emit_line(out, "  store i64 %io.pipe.w.i64, ptr %io.pw.ptr")
    # Register pipe read end with kqueue/epoll (persistent, not oneshot)
    if cg_is_macos(target)
      codegen_util::cg_emit_line(out, "  %io.pkev = alloca [32 x i8]")
      codegen_util::cg_emit_line(out, "  %io.pkev.ptr = bitcast [32 x i8]* %io.pkev to ptr")
      codegen_util::cg_emit_line(out, "  call void @memset(ptr %io.pkev.ptr, i32 0, i64 32)")
      # ident = pipe_r (offset 0, i64)
      codegen_util::cg_emit_line(out, "  %io.pkev.id = bitcast ptr %io.pkev.ptr to ptr")
      codegen_util::cg_emit_line(out, "  store i64 %io.pipe.r.i64, ptr %io.pkev.id")
      # filter = EVFILT_READ = -1 (offset 8, i16)
      codegen_util::cg_emit_line(out, "  %io.pkev.f.p = getelementptr i8, ptr %io.pkev.ptr, i64 8")
      codegen_util::cg_emit_line(out, "  %io.pkev.f = bitcast ptr %io.pkev.f.p to i16*")
      codegen_util::cg_emit_line(out, "  store i16 -1, i16* %io.pkev.f")
      # flags = EV_ADD | EV_ENABLE = 5 (offset 10, i16)
      codegen_util::cg_emit_line(out, "  %io.pkev.fl.p = getelementptr i8, ptr %io.pkev.ptr, i64 10")
      codegen_util::cg_emit_line(out, "  %io.pkev.fl = bitcast ptr %io.pkev.fl.p to i16*")
      codegen_util::cg_emit_line(out, "  store i16 5, i16* %io.pkev.fl")
      codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %io.epfd, ptr %io.pkev.ptr, i32 1, ptr null, i32 0, ptr null)")
    else
      codegen_util::cg_emit_line(out, "  %io.pev = alloca [12 x i8]")
      codegen_util::cg_emit_line(out, "  %io.pev.ptr = bitcast [12 x i8]* %io.pev to ptr")
      codegen_util::cg_emit_line(out, "  call void @memset(ptr %io.pev.ptr, i32 0, i64 12)")
      # events = EPOLLIN = 1 (offset 0, i32)
      codegen_util::cg_emit_line(out, "  %io.pev.ev = bitcast ptr %io.pev.ptr to ptr")
      codegen_util::cg_emit_line(out, "  store i32 1, ptr %io.pev.ev")
      # data.fd = pipe_r (offset 4, i32)
      codegen_util::cg_emit_line(out, "  %io.pev.fd.p = getelementptr i8, ptr %io.pev.ptr, i64 4")
      codegen_util::cg_emit_line(out, "  %io.pev.fd = bitcast ptr %io.pev.fd.p to ptr")
      codegen_util::cg_emit_line(out, "  store i32 %io.pipe.r, ptr %io.pev.fd")
      codegen_util::cg_emit_line(out, "  call i32 @epoll_ctl(i32 %io.epfd, i32 1, i32 %io.pipe.r, ptr %io.pev.ptr)")
    end
  end
  # Initialize completion notification map: 256 pairs = 512 i64 slots = 4096 bytes
  codegen_util::cg_emit_line(out, "  %cm.arr = call ptr @__qz_alloc(i64 4096)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %cm.arr, i32 0, i64 4096)")
  codegen_util::cg_emit_line(out, "  %cm.arr.i = ptrtoint ptr %cm.arr to i64")
  codegen_util::cg_emit_line(out, "  %cm.arr.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  store i64 %cm.arr.i, ptr %cm.arr.ptr")
  # count = 0 (already zeroinit)
  # capacity = 256
  codegen_util::cg_emit_line(out, "  %cm.cap.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  store i64 256, ptr %cm.cap.ptr")
  # Allocate and init completion map mutex
  codegen_util::cg_emit_line(out, "  %cm.mtx = call ptr @__qz_alloc(i64 64)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %cm.mtx, i32 0, i64 64)")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_init(ptr %cm.mtx, ptr null)")
  codegen_util::cg_emit_line(out, "  %cm.mtx.i = ptrtoint ptr %cm.mtx to i64")
  codegen_util::cg_emit_line(out, "  %cm.mtx.ptr = getelementptr [4 x i64], [4 x i64]* @__qz_completion_map, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  store i64 %cm.mtx.i, ptr %cm.mtx.ptr")
  # Initialize task_id_counter to 1 (0 means "no task")
  codegen_util::cg_emit_line(out, "  %tid.ctr.ptr = getelementptr [36 x i64], [36 x i64]* @__qz_sched, i64 0, i64 19")
  codegen_util::cg_emit_line(out, "  store i64 1, ptr %tid.ctr.ptr")
  # Phase 13: Allocate priority queues (CRITICAL=slot[20], HIGH=slot[24], LOW=slot[28])
  # Each is a 65536-slot ring buffer (524288 bytes)
  # CRITICAL queue: slots [20]=queue, [21]=head, [22]=tail, [23]=count
  codegen_util::cg_emit_line(out, "  %pq0.mem = call ptr @__qz_alloc(i64 524288)")
  codegen_util::cg_emit_line(out, "  call void @memset(ptr %pq0.mem, i32 0, i64 524288)")
  codegen_util::cg_emit_line(out, "  %pq0.i = ptrtoint ptr %pq0.mem to i64")
