  codegen_util::cg_emit_line(out, "  %sp.ptid.p = getelementptr i64, ptr %sp.pf, i64 4")
  codegen_util::cg_emit_line(out, "  %sp.ptid.val = load i64, ptr %sp.ptid.p")
  codegen_util::cg_emit_line(out, "  br label %sp_reg_task")
  codegen_util::cg_emit_line(out, "sp_no_parent:")
