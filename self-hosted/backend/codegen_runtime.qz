  codegen_util::cg_emit_line(out, "  %thp.p_d.gep = getelementptr i64, ptr %thp.arr, i64 %thp.p_off")
  codegen_util::cg_emit_line(out, "  %thp.p_d = load i64, ptr %thp.p_d.gep")
