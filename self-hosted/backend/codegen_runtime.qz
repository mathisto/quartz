  # without stomping each other.
  codegen_util::cg_emit_line(out, "@qz_signal_signum_table = private global [32 x i32] zeroinitializer")
  codegen_util::cg_emit_line(out, "@qz_signal_flag_table = private global [32 x ptr] zeroinitializer")
