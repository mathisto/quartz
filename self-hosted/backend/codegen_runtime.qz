  codegen_util::cg_emit_line(out, "")

  # __qz_sched_wake(task): safe wake with CAS park_state protocol.
  # Handles wake-before-park: if task hasn't parked yet, sets WAKE_PENDING flag
  # so the worker loop re-enqueues instead of parking.
  # Park states in frame[5]: 0=RUNNING, 1=PARKED, 2=WAKE_PENDING
  #
  # Protocol is a retry loop (parking_lot / tokio style): load current state,
  # dispatch on it, attempt CAS, retry on CAS failure. Never fail silently.
  # The prior single-attempt version lost wakes when the task's task_parked
  # branch transitioned 0→1 between this wake's CAS(1→0) and CAS(0→2).
  #
  # B.7 Phase 4e.8 — sched_sleep interruption: before entering the CAS protocol,
  # check the __qz_task_timers side table for a pending sched_sleep timer. If
  # found, atomically claim the io_map slot (xchg → 0); if won, cancel the
  # kernel-side registration (kevent EV_DELETE / epoll_ctl DEL + close) and
  # re-enqueue immediately. If we lose the io_map race, the poller already
  # picked up the timer and is re-enqueueing — fall through to the CAS protocol
  # as a no-op (CAS 0→2 is harmless; next sched_park will consume WAKE_PENDING).
  codegen_util::cg_emit_line(out, "define void @__qz_sched_wake(i64 %task) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  codegen_util::cg_emit_line(out, "  %wk.frame = inttoptr i64 %task to ptr")
  codegen_util::cg_emit_line(out, "  %wk.ps.p = getelementptr i64, ptr %wk.frame, i64 5")
  # B.7 Phase 4e.8: try to claim the task's pending sched_sleep timer.
  codegen_util::cg_emit_line(out, "  %wk.ident = call i64 @__qz_task_timer_take(i64 %task)")
  codegen_util::cg_emit_line(out, "  %wk.has_timer = icmp ne i64 %wk.ident, 0")
  if cg_is_windows(target)
    # Phase 5e+ — on Windows, route the no-timer branch through wk_io_check
    # to also try claiming a pending AFD poll (cancel-on-wake via
    # NtCancelIoFileEx). On POSIX the no-timer branch goes straight to the
    # CAS protocol because there's no equivalent per-task heap alloc to
    # cancel — kqueue/epoll ONESHOT auto-removes the registration.
    codegen_util::cg_emit_line(out, "  br i1 %wk.has_timer, label %wk_timer_claim, label %wk_io_check")
  else
