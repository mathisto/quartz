  codegen_util::cg_emit_line(out, "  %fptr_slot = getelementptr inbounds [32 x ptr], ptr @qz_signal_flag_table, i64 0, i64 %i64")
  codegen_util::cg_emit_line(out, "  store ptr %fptr, ptr %fptr_slot, align 8")
