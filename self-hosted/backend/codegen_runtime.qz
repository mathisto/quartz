  codegen_util::cg_emit_line(out, "  %sp.tr.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %sp.tr.cnt = load i64, ptr %sp.tr.cnt.p")
  codegen_util::cg_emit_line(out, "  %sp.tr.cap.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %sp.tr.cap = load i64, ptr %sp.tr.cap.p")
  codegen_util::cg_emit_line(out, "  %sp.tr.full = icmp sge i64 %sp.tr.cnt, %sp.tr.cap")
  codegen_util::cg_emit_line(out, "  br i1 %sp.tr.full, label %sp_tr_done, label %sp_tr_write")
  codegen_util::cg_emit_line(out, "sp_tr_write:")
