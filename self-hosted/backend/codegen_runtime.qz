    codegen_util::cg_emit_line(out, "  %pkev.ptr = bitcast [32 x i8]* %pkev to ptr")
    codegen_util::cg_emit_line(out, "  call void @memset(ptr %pkev.ptr, i32 0, i64 32)")
    # ident = pid (offset 0, i64) — kevent ident is uintptr_t which is i64 on darwin
    codegen_util::cg_emit_line(out, "  %pkev.id = bitcast ptr %pkev.ptr to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %pid, ptr %pkev.id")
    # filter = EVFILT_PROC = -5 (offset 8, i16)
    codegen_util::cg_emit_line(out, "  %pkev.f.p = getelementptr i8, ptr %pkev.ptr, i64 8")
    codegen_util::cg_emit_line(out, "  %pkev.f = bitcast ptr %pkev.f.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 -5, i16* %pkev.f")
    # flags = EV_ADD | EV_ENABLE | EV_ONESHOT = 0x0001|0x0004|0x0010 = 21 (offset 10, i16)
    codegen_util::cg_emit_line(out, "  %pkev.fl.p = getelementptr i8, ptr %pkev.ptr, i64 10")
    codegen_util::cg_emit_line(out, "  %pkev.fl = bitcast ptr %pkev.fl.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 21, i16* %pkev.fl")
    # fflags = NOTE_EXIT = 0x80000000 (offset 12, i32)
