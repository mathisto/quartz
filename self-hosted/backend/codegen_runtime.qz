  # __qz_sched_register_io_ex(fd, task, timeout_ms, events): register fd with direction + optional timer
  codegen_util::cg_emit_line(out, "define void @__qz_sched_register_io_ex(i64 %fd, i64 %task, i64 %timeout, i64 %events) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
  if cg_is_windows(target)
    # Phase 5e — Windows AFD-flavored register_io_ex. Selects POLL_SEND vs
