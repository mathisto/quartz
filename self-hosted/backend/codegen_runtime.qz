  codegen_util::cg_emit_line(out, "  %fptr = load ptr, ptr %fptr_slot, align 8")
  codegen_util::cg_emit_line(out, "  %is_null = icmp eq ptr %fptr, null")
  codegen_util::cg_emit_line(out, "  br i1 %is_null, label %next, label %store")
  codegen_util::cg_emit_line(out, "store:")
  codegen_util::cg_emit_line(out, "  store atomic i64 1, ptr %fptr seq_cst, align 8")
  codegen_util::cg_emit_line(out, "  br label %next")
  codegen_util::cg_emit_line(out, "next:")
  codegen_util::cg_emit_line(out, "  %i.next = add i32 %i, 1")
