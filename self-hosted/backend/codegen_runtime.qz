    codegen_util::cg_emit_line(out, "  call void @memset(ptr %kev.ptr, i32 0, i64 32)")
    # ident = id (offset 0, i64)
    codegen_util::cg_emit_line(out, "  %kev.id = bitcast ptr %kev.ptr to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %id, ptr %kev.id")
    # filter = EVFILT_TIMER = -7 (offset 8, i16)
    codegen_util::cg_emit_line(out, "  %kev.f.p = getelementptr i8, ptr %kev.ptr, i64 8")
    codegen_util::cg_emit_line(out, "  %kev.f = bitcast ptr %kev.f.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 -7, i16* %kev.f")
    # flags = EV_ADD | EV_ONESHOT = 0x0001 | 0x0010 = 17 (offset 10, i16)
    codegen_util::cg_emit_line(out, "  %kev.fl.p = getelementptr i8, ptr %kev.ptr, i64 10")
    codegen_util::cg_emit_line(out, "  %kev.fl = bitcast ptr %kev.fl.p to i16*")
    codegen_util::cg_emit_line(out, "  store i16 17, i16* %kev.fl")
    # fflags = NOTE_USECONDS = 0x00000002 (offset 12, i32)
    codegen_util::cg_emit_line(out, "  %kev.ff.p = getelementptr i8, ptr %kev.ptr, i64 12")
    codegen_util::cg_emit_line(out, "  %kev.ff = bitcast ptr %kev.ff.p to ptr")
    codegen_util::cg_emit_line(out, "  store i32 2, ptr %kev.ff")
    # data = timeout_us = timeout_ms * 1000 (offset 16, i64)
    codegen_util::cg_emit_line(out, "  %timeout_us = mul i64 %timeout_ms, 1000")
    codegen_util::cg_emit_line(out, "  %kev.d.p = getelementptr i8, ptr %kev.ptr, i64 16")
    codegen_util::cg_emit_line(out, "  %kev.d = bitcast ptr %kev.d.p to ptr")
    codegen_util::cg_emit_line(out, "  store i64 %timeout_us, ptr %kev.d")
    codegen_util::cg_emit_line(out, "  call i32 @kevent(i32 %epfd, ptr %kev.ptr, i32 1, ptr null, i32 0, ptr null)")
    # B.7 Phase 4e.8: record this task's pending timer ident so __qz_sched_wake
    # can cancel it on scope-cancel. Capacity-1 per task (a goroutine can only
    # be in one sched_sleep at a time); upsert overwrites any stale entry.
    codegen_util::cg_emit_line(out, "  call void @__qz_task_timer_set(i64 %task, i64 %id)")
    codegen_util::cg_emit_line(out, "  ret void")
  else
    # Linux: timerfd_create(CLOCK_MONOTONIC=1, 0)
