  # bypass the timeout/events branches (they don't apply to process exit waits).
  codegen_util::cg_emit_line(out, "  %io.is_proc = load i64, ptr @__qz_io_pending_is_proc")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_io_pending_is_proc")
  codegen_util::cg_emit_line(out, "  %io.proc_nz = icmp ne i64 %io.is_proc, 0")
  codegen_util::cg_emit_line(out, "  br i1 %io.proc_nz, label %task_io_proc, label %task_io_check_ex")
  codegen_util::cg_emit_line(out, "task_io_proc:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_register_proc(i64 %io.fd, i64 %task.i)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_io_check_ex:")
  # Load TLS side channel: timeout and events from io_suspend_timeout
  codegen_util::cg_emit_line(out, "  %io.timeout = load i64, ptr @__qz_io_pending_timeout")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_io_pending_timeout")
  codegen_util::cg_emit_line(out, "  %io.events = load i64, ptr @__qz_io_pending_events")
  codegen_util::cg_emit_line(out, "  store i64 0, ptr @__qz_io_pending_events")
  codegen_util::cg_emit_line(out, "  %io.has_tmo = icmp sgt i64 %io.timeout, 0")
  codegen_util::cg_emit_line(out, "  %io.has_ev = icmp sgt i64 %io.events, 0")
  codegen_util::cg_emit_line(out, "  %io.need_ex = or i1 %io.has_tmo, %io.has_ev")
  codegen_util::cg_emit_line(out, "  br i1 %io.need_ex, label %task_io_ex, label %task_io_plain")
  codegen_util::cg_emit_line(out, "task_io_plain:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_register_io(i64 %io.fd, i64 %task.i)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_io_ex:")
  codegen_util::cg_emit_line(out, "  call void @__qz_sched_register_io_ex(i64 %io.fd, i64 %task.i, i64 %io.timeout, i64 %io.events)")
  codegen_util::cg_emit_line(out, "  br label %loop")
  codegen_util::cg_emit_line(out, "task_yield:")
  # Check if task was parked via sched_park() — TLS flag set by sched_set_park_pending
  codegen_util::cg_emit_line(out, "  %pk.flag = load i64, ptr @__qz_sched_park_pending")
  codegen_util::cg_emit_line(out, "  %pk.is_park = icmp ne i64 %pk.flag, 0")
  codegen_util::cg_emit_line(out, "  br i1 %pk.is_park, label %task_parked, label %do_yield")
  codegen_util::cg_emit_line(out, "task_parked:")
  # Clear TLS park flag
