  # ========================================================================
  # Phase 5c — Windows timer min-heap helpers
  #
  # Binary min-heap over [capacity × (deadline_ns: i64, task: i64)] entries
  # at @__qz_timer_heap. Compared by deadline_ns; task is the carried
  # payload re-enqueued on drain. Tombstones are entries with task=0 from
  # __qz_timer_heap_cancel — drain pops them silently so the heap remains
  # sorted on deadline without per-cancel structural surgery. All public
  # helpers acquire @__qz_timer_heap.mutex internally; callers do not.
  #
  # Emitted on every target (the IR has to link uniformly) but only
  # exercised by the IOCP poller body, which only runs on Windows.
  # ========================================================================

  # __qz_timer_heap_push(deadline_ns, task) -> i64
  # Insert (deadline, task) and sift-up to maintain min-heap invariant.
  # Returns 1 on success, 0 if heap is at capacity (caller should fall back
  # to a synchronous Sleep() or drop the timer — for 5c, capacity 1024 is
  # treated as ample and silent failure mirrors POSIX's silent failure when
  # the timerfd / kqueue ident range is exhausted).
  codegen_util::cg_emit_line(out, "define i64 @__qz_timer_heap_push(i64 %thp.deadline, i64 %thp.task) nounwind {")
  codegen_util::cg_emit_line(out, "thp_entry:")
  codegen_util::cg_emit_line(out, "  %thp.mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %thp.mtx.i = load i64, ptr %thp.mtx.p")
  codegen_util::cg_emit_line(out, "  %thp.has_mtx = icmp ne i64 %thp.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %thp.has_mtx, label %thp_lock, label %thp_ret_fail")
  codegen_util::cg_emit_line(out, "thp_lock:")
  codegen_util::cg_emit_line(out, "  %thp.mtx = inttoptr i64 %thp.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %thp.mtx)")
  codegen_util::cg_emit_line(out, "  %thp.cnt.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %thp.cnt = load i64, ptr %thp.cnt.p")
  codegen_util::cg_emit_line(out, "  %thp.cap.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 2")
  codegen_util::cg_emit_line(out, "  %thp.cap = load i64, ptr %thp.cap.p")
  codegen_util::cg_emit_line(out, "  %thp.full = icmp sge i64 %thp.cnt, %thp.cap")
  codegen_util::cg_emit_line(out, "  br i1 %thp.full, label %thp_unlock_fail, label %thp_insert")
  codegen_util::cg_emit_line(out, "thp_insert:")
