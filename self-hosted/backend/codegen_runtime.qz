  #   8:  DWORD  ftCreationTime.dwHighDateTime
  #  12:  DWORD  ftLastAccessTime.dwLowDateTime
  #  16:  DWORD  ftLastAccessTime.dwHighDateTime
  #  20:  DWORD  ftLastWriteTime.dwLowDateTime
  #  24:  DWORD  ftLastWriteTime.dwHighDateTime
