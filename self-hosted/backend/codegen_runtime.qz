  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %dt.mtx)")
  codegen_util::cg_emit_line(out, "  %dt.cnt.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %dt.cnt = load i64, ptr %dt.cnt.p")
  codegen_util::cg_emit_line(out, "  %dt.cnt.s = call i64 @str_from_int(i64 %dt.cnt)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 %dt.cnt.s)")
  codegen_util::cg_emit_line(out, "  call i64 @eputs(i64 ptrtoint (ptr @.stt_nl to i64))")
  codegen_util::cg_emit_line(out, "  %dt.arr.p = getelementptr [4 x i64], [4 x i64]* @__qz_task_registry, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %dt.arr.i = load i64, ptr %dt.arr.p")
  codegen_util::cg_emit_line(out, "  %dt.arr = inttoptr i64 %dt.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  br label %dt_loop")
  codegen_util::cg_emit_line(out, "dt_loop:")
  codegen_util::cg_emit_line(out, "  %dt.i = phi i64 [0, %dt_scan], [%dt.i.next, %dt_next]")
  codegen_util::cg_emit_line(out, "  %dt.done = icmp sge i64 %dt.i, %dt.cnt")
  codegen_util::cg_emit_line(out, "  br i1 %dt.done, label %dt_unlock, label %dt_print")
  codegen_util::cg_emit_line(out, "dt_print:")
