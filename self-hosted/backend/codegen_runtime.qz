    # popped the entry and is/will re-enqueue itself — fall through to
    # the CAS protocol as the (benign) loser of the race, matching the
    # POSIX xchg-loser branch.
    codegen_util::cg_emit_line(out, "  %wk.won = call i64 @__qz_timer_heap_cancel(i64 %task)")
    codegen_util::cg_emit_line(out, "  %wk.won_b = icmp ne i64 %wk.won, 0")
