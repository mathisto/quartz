  # qz_str_pad_left: pad string to target length with pad char on the left
  codegen_util::cg_emit_line(out, "define i64 @qz_str_pad_left(i64 %s, i64 %target, i64 %pad) nounwind {")
  codegen_util::cg_emit_line(out, "entry:")
