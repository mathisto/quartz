  # __qz_timer_heap_next_expiry_ms(now_ns) -> i32
  # Returns the DWORD timeout to pass to GetQueuedCompletionStatusEx:
  #   - heap empty                                : INFINITE (0xFFFFFFFF as i32 -1)
  #   - root.deadline ≤ now_ns                    : 0 (poll without blocking)
  #   - else                                      : (deadline-now)/1e6 clamped to 0x7FFFFFFE
  # Clamping the upper bound to INT32_MAX-1 reserves 0xFFFFFFFF for the
  # empty-heap INFINITE signal so the caller can distinguish "no timers"
  # from "very-far-future timer". 49.7 days is the practical ceiling
  # anyway — anything longer is filed-forward as a v2 NtAssociateWait
  # concern.
  codegen_util::cg_emit_line(out, "define i32 @__qz_timer_heap_next_expiry_ms(i64 %tne.now) nounwind {")
  codegen_util::cg_emit_line(out, "tne_entry:")
  codegen_util::cg_emit_line(out, "  %tne.mtx.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 3")
  codegen_util::cg_emit_line(out, "  %tne.mtx.i = load i64, ptr %tne.mtx.p")
  codegen_util::cg_emit_line(out, "  %tne.has_mtx = icmp ne i64 %tne.mtx.i, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tne.has_mtx, label %tne_lock, label %tne_infinite")
  codegen_util::cg_emit_line(out, "tne_lock:")
  codegen_util::cg_emit_line(out, "  %tne.mtx = inttoptr i64 %tne.mtx.i to ptr")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_lock(ptr %tne.mtx)")
  codegen_util::cg_emit_line(out, "  %tne.cnt.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 1")
  codegen_util::cg_emit_line(out, "  %tne.cnt = load i64, ptr %tne.cnt.p")
  codegen_util::cg_emit_line(out, "  %tne.empty = icmp eq i64 %tne.cnt, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tne.empty, label %tne_unlock_inf, label %tne_compute")
  codegen_util::cg_emit_line(out, "tne_compute:")
  codegen_util::cg_emit_line(out, "  %tne.arr.p = getelementptr [5 x i64], [5 x i64]* @__qz_timer_heap, i64 0, i64 0")
  codegen_util::cg_emit_line(out, "  %tne.arr.i = load i64, ptr %tne.arr.p")
  codegen_util::cg_emit_line(out, "  %tne.arr = inttoptr i64 %tne.arr.i to ptr")
  codegen_util::cg_emit_line(out, "  %tne.root_d.gep = getelementptr i64, ptr %tne.arr, i64 0")
  codegen_util::cg_emit_line(out, "  %tne.root_d = load i64, ptr %tne.root_d.gep")
  codegen_util::cg_emit_line(out, "  %tne.delta_ns = sub i64 %tne.root_d, %tne.now")
  codegen_util::cg_emit_line(out, "  %tne.is_past = icmp sle i64 %tne.delta_ns, 0")
  codegen_util::cg_emit_line(out, "  br i1 %tne.is_past, label %tne_unlock_zero, label %tne_to_ms")
  codegen_util::cg_emit_line(out, "tne_to_ms:")
  # Round up to next ms so the wait never returns before the deadline.
  codegen_util::cg_emit_line(out, "  %tne.delta_plus = add i64 %tne.delta_ns, 999999")
  codegen_util::cg_emit_line(out, "  %tne.ms64 = sdiv i64 %tne.delta_plus, 1000000")
  # Clamp to INT32_MAX - 1 (reserve 0xFFFFFFFF for INFINITE).
  codegen_util::cg_emit_line(out, "  %tne.clamp = icmp sgt i64 %tne.ms64, 2147483646")
  codegen_util::cg_emit_line(out, "  %tne.ms_clamped = select i1 %tne.clamp, i64 2147483646, i64 %tne.ms64")
  codegen_util::cg_emit_line(out, "  %tne.ms32 = trunc i64 %tne.ms_clamped to i32")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %tne.mtx)")
  codegen_util::cg_emit_line(out, "  ret i32 %tne.ms32")
  codegen_util::cg_emit_line(out, "tne_unlock_zero:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %tne.mtx)")
  codegen_util::cg_emit_line(out, "  ret i32 0")
  codegen_util::cg_emit_line(out, "tne_unlock_inf:")
  codegen_util::cg_emit_line(out, "  call i32 @pthread_mutex_unlock(ptr %tne.mtx)")
  codegen_util::cg_emit_line(out, "  br label %tne_infinite")
  codegen_util::cg_emit_line(out, "tne_infinite:")
  codegen_util::cg_emit_line(out, "  ret i32 -1")
  codegen_util::cg_emit_line(out, "}")
