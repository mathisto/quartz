  codegen_util::cg_emit_line(out, "  %thd.sd_left = mul i64 %thd.sd_i, 2")
  codegen_util::cg_emit_line(out, "  %thd.sd_left2 = add i64 %thd.sd_left, 1")
  codegen_util::cg_emit_line(out, "  %thd.sd_no_left = icmp uge i64 %thd.sd_left2, %thd.new_cnt")
  codegen_util::cg_emit_line(out, "  br i1 %thd.sd_no_left, label %thd_after_sift, label %thd_sd_has_left")
  codegen_util::cg_emit_line(out, "thd_sd_has_left:")
  # Determine smaller child (left vs right) by deadline.
  codegen_util::cg_emit_line(out, "  %thd.sd_right = add i64 %thd.sd_left2, 1")
  codegen_util::cg_emit_line(out, "  %thd.sd_has_right = icmp ult i64 %thd.sd_right, %thd.new_cnt")
