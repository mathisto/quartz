##! # Codegen Context Bridge
##!
##! Routes the `Emit` algebraic effect (declared in `std/emit.qz`) to the
##! ambient StringBuilder sink. Bridge mirrors `typecheck_diag.qz` and
##! `typecheck_ctx.qz`: a single-slot global carries the active `out:
##! Int` descriptor; default handlers forward into
##! `codegen_util::cg_emit` / `cg_emit_line` / `cg_emit_int`.
##!
##! Effects-system Phase 5.3 (compiler dogfooding — Emit effect for
##! LLVM IR emission).
##!
##! ## Why a bridge (not naked `with Emit(out) do -> ...`)
##!
##! The full codegen pass crosses dozens of functions. Making every
##! codegen helper take a `can Emit` row in its signature would churn
##! ~all 25k `cg_emit(` callsites in a single pass. The body-wrap
##! pattern (validated in Phase 5.1 Diagnostics and Phase 5.2
##! State<TcCtx>) keeps outer signatures stable while migrated leaf
##! helpers dogfood the effect locally.
##!
##! ## Slot lifecycle
##!
##! A migrated helper calls `cg_ctx_set(out)` before its body-wrap; the
##! handlers retrieve `out` via `cg_ctx_get()` at each perform. For the
##! incremental migration we accept the slot state leaking across calls
##! (a helper sets the slot, returns, and whatever follows sees the
##! last-set value) — this is safe because codegen is single-threaded
##! and every subsequent helper either sets the slot itself or continues
##! passing `out` explicitly through the direct API.

import codegen_util
import * from str_compat

## Single-slot home for the active StringBuilder descriptor. Vec form
## (not a scalar) because Quartz top-level vars need an initial value.
var __cg_ctx_out: Vec<Int> = vec_new<Int>()

## Set the active output sink. Idempotent — repeated calls overwrite.
## Call at the top of each migrated helper before installing the Emit
## handler.
def cg_ctx_set(out: Int): Void
  if __cg_ctx_out.size == 0
    __cg_ctx_out.push(out)
  else
    __cg_ctx_out[0] = out
  end
end

## Clear the active sink. Optional — call between codegen passes if
## paranoia about stale state is desired.
def cg_ctx_clear(): Void
  if __cg_ctx_out.size > 0
    var _t = __cg_ctx_out.pop()
  end
end

## Fetch the active sink. If the slot is empty (nobody called
## `cg_ctx_set`), writes a stderr breadcrumb and returns 0 — callers
## should set the slot before installing the handler.
def cg_ctx_get(): Int
  if __cg_ctx_out.size == 0
    eputs("[cg_ctx] cg_ctx_get fired with no active sink; returning 0")
    return 0
  end
  return __cg_ctx_out[0]
end

## Emit default handler. ABI: `(op_name, argc, argv): Int`. argv layout:
## [s: String]. Forwards to `codegen_util::cg_emit(cg_ctx_get(), s)`.
def cg_ctx_emit_handler(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  codegen_util::cg_emit(cg_ctx_get(), s)
  return 0
end

## Emit_line default handler. argv layout: [s: String]. Forwards to
## `codegen_util::cg_emit_line(cg_ctx_get(), s)`.
def cg_ctx_emit_line_handler(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  codegen_util::cg_emit_line(cg_ctx_get(), s)
  return 0
end

## Emit_int default handler. argv layout: [n: Int]. Forwards to
## `codegen_util::cg_emit_int(cg_ctx_get(), n)`.
def cg_ctx_emit_int_handler(op_name: Int, argc: Int, argv: Int): Int
  var n = load(argv, 0)
  codegen_util::cg_emit_int(cg_ctx_get(), n)
  return 0
end
