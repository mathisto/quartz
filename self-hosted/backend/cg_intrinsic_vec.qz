        codegen_util::cg_emit(out, ".val = sext ")
        codegen_util::cg_emit(out, elt)
        codegen_util::cg_emit(out, " %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".narrow to i64")
      else
