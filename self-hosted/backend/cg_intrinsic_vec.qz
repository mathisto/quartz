    codegen_util::cg_emit(out, ".copybytes = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sz, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ndata, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".copybytes)")
