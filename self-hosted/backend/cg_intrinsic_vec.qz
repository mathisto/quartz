    codegen_util::cg_emit(out, ".dbytes = mul i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap, %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ndata = call ptr @__qz_alloc(i64 %v")
