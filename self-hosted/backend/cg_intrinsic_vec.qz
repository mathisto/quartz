          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".data, i64 %v")
          codegen_util::cg_emit_line(out, idx.to_s())
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".srcptr.i = load i64, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".elem.ptr, align 8")
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".srcptr = inttoptr i64 %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".srcptr.i to ptr")
          var copy_bytes_nv = (_vg_valfc * 8).to_s()
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".copy = alloca i8, i64 ")
          codegen_util::cg_emit_line(out, copy_bytes_nv)
          codegen_util::cg_emit(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %v")
