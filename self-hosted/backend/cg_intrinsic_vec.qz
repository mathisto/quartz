      codegen_util::cg_emit(out, ".fr.i, %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fr.len")
      codegen_util::cg_emit(out, "  br i1 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fr.more, label %vf_rc_body_")
