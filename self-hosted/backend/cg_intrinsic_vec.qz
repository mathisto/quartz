      codegen_util::cg_emit(out, "  br label %vf_rc_entry_")
      codegen_util::cg_emit_int(out, frlbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vf_rc_entry_")
      codegen_util::cg_emit_int(out, frlbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  br label %vf_rc_head_")
      codegen_util::cg_emit_int(out, frlbl)
      codegen_util::cg_emit_line(out, "")
