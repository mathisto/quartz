          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".ioff = mul i64 %v")
          codegen_util::cg_emit_int(out, idx)
          codegen_util::cg_emit(out, ", ")
          codegen_util::cg_emit_int(out, _vg_vfc)
          codegen_util::cg_emit_line(out, "")
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".elem.base = getelementptr inbounds i64, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".data, i64 %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ioff")
        end
        codegen_util::cg_emit_ptrtoint("#{d}.val", "#{d}.elem.base", "ptr")
