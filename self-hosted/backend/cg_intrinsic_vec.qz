    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ndata.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ndata to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nd.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nhdr, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
