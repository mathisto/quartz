  if name == "vec_clone"
    var vec = args[0]
    # Read source header: [0]=capacity, [1]=size, [2]=data, [3]=elem_width
    codegen_util::cg_emit_inttoptr_is(dest, ".src.hdr", vec, "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".src.hdr, i64 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sz.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".src.hdr, i64 1")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sz = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sz.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".src.hdr, i64 2")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.p")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data = inttoptr i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.i to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".src.hdr, i64 3")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew = load i64, ptr %v")
