          codegen_util::cg_emit(out, ".srcptr, i64 ")
          codegen_util::cg_emit(out, copy_bytes_nv)
          codegen_util::cg_emit_line(out, ", i1 false)")
          codegen_util::cg_emit_ptrtoint("#{d}.val", "#{d}.copy", "ptr")
        else
