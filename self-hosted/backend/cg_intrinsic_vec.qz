        # semantics → deep copy) from non-`@value` reference structs
        # (reference semantics → return the stored handle). A `@value` struct
        # whose fields can't be inline-packed (mixed scalar+pointer, GC
        # firewall) is stored BOXED and MUST be value-copied on read. But a
        # non-`@value` (heap reference) struct stores one i64 handle per slot,
        # and a read returns that HANDLE — copying it would break the pointer
        # identity these structs rely on (compared by pointer, mutated in
        # place; the `MIR_INDEX`/`vec_pop` paths already return the handle).
        # The discriminator is the `@value` field count (`> 0` only for
        # `@value` structs), NOT the raw struct field count — the latter
        # matched reference structs too, wrongly deep-copying them (which
        # corrupted MIR-body pickle block-refs once MIR collections were typed
        # `Vec<MirBlock>`). `@value` inline structs are handled above
        # (`_vg_vfc > 1`).
        var _vg_valfc = 0
        if str_byte_len(_elem_type) > 0
          _vg_valfc = mir::mir_prog_get_value_layout_field_count(prog, _elem_type)
        end
        # B.10 §14.12.8 (C3.5/h2) — a cow-layout element is stored as its buffer
