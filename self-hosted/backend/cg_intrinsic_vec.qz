          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".elem.ptr = getelementptr inbounds i64, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".data, i64 %v")
          codegen_util::cg_emit_line(out, idx.to_s())
          codegen_util::cg_emit(out, "  %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".val = load i64, ptr %v")
