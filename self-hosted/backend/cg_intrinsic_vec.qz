      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data.n, i64 %v")
      codegen_util::cg_emit_line(out, idx.to_s())
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".narrow = load ")
      codegen_util::cg_emit(out, elt)
      codegen_util::cg_emit(out, ", ")
      codegen_util::cg_emit(out, elt)
