##! # Vec Intrinsics
##!
##! Emits LLVM IR for dynamic vector/array operations.
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import elem_width
import * from str_compat


# ============================================================================
# Vec @value inline-storage gating (B.10 value-types)
# ============================================================================

## Field count for an @value struct that is ALSO firewall-safe (homogeneous: all
## raw-bit scalar OR all tracked-pointer slots — see mir_prog_struct_is_firewall_safe).
## This is the gate for the Vec INLINE-storage path. A mixed scalar+pointer @value
## struct returns 0 here, so it falls through to the BOXED Vec path (one i64 heap
## pointer per element) — closing the GC firewall hole (B.10 P2.3, Vec extension):
## no raw String/Vec pointer gets inlined contiguously alongside scalar bits without
## a scan_map. All-scalar (e.g. Point3D, RGBA) and all-pointer @value structs stay
## inline. Returns 0 for non-@value / unknown / generic / empty type names.
def cg_vec_inline_field_count(prog: mir::MirProgram, elem_type: String): Int
  if str_byte_len(elem_type) == 0
    return 0
  end
  # item 47 — resolve a bare cross-module element name (`HH`) to its qualified
  # struct_defs key (`hmodv$HH`) ONCE at this boundary, so every prog-side value-
  # layout / firewall / cow / narrow helper below receives the key its raw
  # `entry.name == name` lookups match. Without this, a cross-module @value element
  # missed the value-layout verdict → fc=0 → ew=8 → the boxed pointer-push branch
  # aliased every element to the one hoisted construct alloca. Exact/in-module names
  # resolve to themselves ⇒ byte-identical for the single-module path.
  elem_type = mir::mir_prog_resolve_struct_name(prog, elem_type)
  # F4-PRE-1 — route the field count through the SINGLE value-layout key so a flipped
  # plain struct (F4 gate live) is recognized as value-layout and packs its elements
  # into distinct backing slots, not one aliasing i64 pointer. Widens (does NOT
  # replace) the old is_value-only mir_prog_get_value_field_count: at gate 0 a plain
  # struct is not value-layout ⇒ fc == 0 ⇒ byte-identical; an @value struct gets the
  # identical count it got before.
  var fc = mir::mir_prog_get_value_layout_field_count(prog, elem_type)
  if fc < 1
    return 0
  end
  # B.10 §14.12.8 (C3.5/h2) — a cow-layout @value element is a HEAP refcount buffer
  # (refcount@0, payload@1..N); its VALUE is the buffer POINTER. The inline-storage
  # path would store N FLAT words 0..N-1 per element, mismatching the 1+N buffer
  # (inline_struct_vec_spec 3-field: got 0, want 300). Return 0 ⇒ fall through to
  # the BOXED Vec path (one i64 pointer per element) which stores the buffer pointer
  # in a single slot; the collection-insert copy already retains via
  # mir_emit_value_copy (cow_rc_inc), and vec_get returns the pointer back — uniform
  # with C3's pointer model. INERT at gate 0 (predicate false ⇒ unchanged).
  if mir::mir_prog_struct_is_cow_layout(prog, elem_type) == 1
    return 0
  end
  # F4-PRE-1 — value-layout firewall gate (widened from the is_value-only
  # mir_prog_struct_is_firewall_safe). An F4-eligible plain struct is non-firewall-
  # mixed by eligibility, so it passes here and reaches the packed inline path. INERT
  # at gate 0 (plain ⇒ not value-layout ⇒ identical @value-only verdict).
  if mir::mir_prog_struct_value_firewall_safe(prog, elem_type) == 0
    return 0
  end
  return fc
end

## 1 if a Vec-inline-eligible @value struct has narrow (sub-i64) fields, so its
## elements pack to the true sizeof(%struct.Name) rather than the field_count*8
## i64-slot stride. All-wide @value structs (sizeof == field_count*8 already) return
## 0 → they stay on the EXACT legacy i64-slot path, byte-identical (hard invariant:
## struct_heavy / Point3D IR must not change).
def cg_vec_pack_narrow(prog: mir::MirProgram, elem_type: String): Int
  if cg_vec_inline_field_count(prog, elem_type) == 0
    return 0
  end
  return mir::mir_prog_struct_has_narrow_fields(prog, elem_type)
end

## R3.4 — resolve a Vec element type to the struct name IFF codegen emits
## `@qz_eq_<Name>` for it (a value-layout, all-hashable user struct). Returns ""
## for anything else (Int / String / pointer / non-hashable / non-value-layout),
## so contains / index_of / dedup lower to byte-identical IR for those.
##
## Predicate parity: this MUST agree with cg_emit_struct_hash_eq_functions'
## emission gate (every field Int/Bool/String/Symbol OR narrow-fixed-width) AND
## with mir_prog_is_value_layout_type. Mirrors cg_intrinsic_map::_map_struct_key_name
## (kept local here to avoid a vec→map import cycle: map already imports vec).
##
## Unlike cg_vec_inline_field_count, this deliberately DOES include CoW (>16B)
## value structs: those are stored one boxed pointer per slot (ew==8), the loaded
## slot IS a pointer to the struct buffer, and qz_eq_<Name> reads that buffer with
## the same +1 refcount shift (field_word_base) it uses for the map-key path. So a
## single struct-eq call is correct for both the inline (≤16B) and boxed (>16B)
## element layouts. INERT at F4 gate 0 (mir_prog_is_value_layout_type == 0 for a
## plain struct ⇒ "" ⇒ byte-identical).
def cg_vec_struct_eq_name(prog: mir::MirProgram, elem_type: String): String
  if str_byte_len(elem_type) == 0
    return ""
  end
  if elem_type == "Int" or elem_type == "String"
    return ""
  end
  var name = mir::mir_prog_resolve_struct_name(prog, elem_type)
  var lt = __char_index(name, '<')
  if lt > 0
    name = str_byte_slice(name, 0, lt)
  end
  if str_byte_len(name) == 0
    return ""
  end
  if mir::mir_prog_is_value_layout_type(prog, name) == 0
    return ""
  end
  var struct_defs = mir::mir_get_struct_defs(prog)
  if as_int(struct_defs) == 0
    return ""
  end
  var count = struct_defs.size
  for i in 0..count
    var entry = struct_defs[i]
    if entry.name == name
      var field_types = entry.field_types
      var fc = vec_size(field_types)
      if fc == 0
        return ""
      end
      for j in 0..fc
        var ft = as_string(field_types[j])
        if ft != "Int" and ft != "Bool" and ft != "String" and ft != "Symbol" and mir::mir_is_narrow_fixed_width(ft) == 0
          return ""
        end
      end
      return name
    end
  end
  return ""
end

## R3.4 — emit an inline `ew`-strided linear scan of a value-layout struct Vec that
## compares each element field-deep via `@qz_eq_<sname>(i64 %a, i64 %b)` (a==query
## ptr, b==element ptr). Shared by vec_contains + vec_index_of.
##
## - `inline` (1 = cg_vec_inline_field_count>=1, ≤16B non-CoW): the element VALUE
##   lives AT the slot; the element pointer is `data + i*ew`.
## - boxed (inline==0, CoW >16B, ew==8): the slot HOLDS a pointer to the heap
##   refcount buffer; load it and pass that pointer (qz_eq_<Name> applies the +1
##   refcount field shift itself).
## `val` is always a pointer (i64) to the query struct.
##
## contains_mode==1 → defines `%v<d>` = 1 (found) / 0 (absent).
## contains_mode==0 → defines `%v<d>.raw` = index (found) / -1 (absent).
def cg_emit_vec_struct_scan(state: CodegenState, out: Int, prog: mir::MirProgram, d: String, vec: Int, val: Int, sname: String, inline: Int, contains_mode: Int): Void can Emit
  var lbl = codegen_util::cg_next_label(state).to_s()
  var vv = vec.to_s()
  var qv = val.to_s()
  var res = "%v#{d}"
  if contains_mode == 0
    res = "%v#{d}.raw"
  end
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.hdr = inttoptr i64 %v#{vv} to ptr")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.size.p = getelementptr inbounds i64, ptr %vsc#{lbl}.hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.size = load i64, ptr %vsc#{lbl}.size.p, align 8")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.data.p = getelementptr inbounds i64, ptr %vsc#{lbl}.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.data.i = load i64, ptr %vsc#{lbl}.data.p, align 8")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.data = inttoptr i64 %vsc#{lbl}.data.i to ptr")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.ew.p = getelementptr inbounds i64, ptr %vsc#{lbl}.hdr, i64 3")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.ew = load i64, ptr %vsc#{lbl}.ew.p, align 8")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.qptr = inttoptr i64 %v#{qv} to ptr")
  # Dedicated preheader names the phi's entry predecessor unambiguously (the current
  # block label is not known here).
  codegen_util::cg_emit_line(out, "  br label %vsc#{lbl}.pre")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.pre:")
  codegen_util::cg_emit_line(out, "  br label %vsc#{lbl}.loop")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.loop:")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.i = phi i64 [0, %vsc#{lbl}.pre], [%vsc#{lbl}.i.next, %vsc#{lbl}.cont]")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.done = icmp sge i64 %vsc#{lbl}.i, %vsc#{lbl}.size")
  codegen_util::cg_emit_line(out, "  br i1 %vsc#{lbl}.done, label %vsc#{lbl}.notfound, label %vsc#{lbl}.body")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.body:")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.off = mul i64 %vsc#{lbl}.i, %vsc#{lbl}.ew")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.slot = getelementptr inbounds i8, ptr %vsc#{lbl}.data, i64 %vsc#{lbl}.off")
  if inline >= 1
    # Element value lives inline at the slot; the slot address IS the struct ptr.
    codegen_util::cg_emit_line(out, "  %vsc#{lbl}.ae = ptrtoint ptr %vsc#{lbl}.slot to i64")
  else
    # Boxed (CoW): the slot holds an i64 pointer to the struct buffer.
    codegen_util::cg_emit_line(out, "  %vsc#{lbl}.ae = load i64, ptr %vsc#{lbl}.slot, align 8")
  end
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.aq = ptrtoint ptr %vsc#{lbl}.qptr to i64")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.eqr = call i64 @qz_eq_#{sname}(i64 %vsc#{lbl}.aq, i64 %vsc#{lbl}.ae)")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.iseq = icmp ne i64 %vsc#{lbl}.eqr, 0")
  codegen_util::cg_emit_line(out, "  br i1 %vsc#{lbl}.iseq, label %vsc#{lbl}.found, label %vsc#{lbl}.cont")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.cont:")
  codegen_util::cg_emit_line(out, "  %vsc#{lbl}.i.next = add i64 %vsc#{lbl}.i, 1")
  codegen_util::cg_emit_line(out, "  br label %vsc#{lbl}.loop")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.found:")
  codegen_util::cg_emit_line(out, "  br label %vsc#{lbl}.end")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.notfound:")
  codegen_util::cg_emit_line(out, "  br label %vsc#{lbl}.end")
  codegen_util::cg_emit_line(out, "vsc#{lbl}.end:")
  if contains_mode == 1
    codegen_util::cg_emit_line(out, "  #{res} = phi i64 [1, %vsc#{lbl}.found], [0, %vsc#{lbl}.notfound]")
  else
    codegen_util::cg_emit_line(out, "  #{res} = phi i64 [%vsc#{lbl}.i, %vsc#{lbl}.found], [-1, %vsc#{lbl}.notfound]")
  end
end

## R3.4 — in-place adjacent-dedup for a value-layout struct Vec. Compares each
## element against the last KEPT element field-deep via @qz_eq_<sname> and, when
## distinct, compacts it down to the write cursor with an `ew`-wide memcpy. Mirrors
## the legacy i64 dedup's semantics (adjacent equality against the previous kept
## slot) but strides/copies by `ew` and compares struct-deep. Defines %v<d> = 0.
##
## - `inline` (≤16B non-CoW): element value lives inline at `data + i*ew`; the slot
##   address is the struct ptr; compaction memcpys `ew` bytes.
## - boxed (CoW >16B, ew==8): the slot holds an i64 pointer to the buffer; qz_eq_
##   gets the loaded pointer; compaction memcpys the 8-byte pointer word.
def cg_emit_vec_struct_dedup(state: CodegenState, out: Int, prog: mir::MirProgram, d: String, vec: Int, sname: String, inline: Int): Void can Emit
  var lbl = codegen_util::cg_next_label(state).to_s()
  var vv = vec.to_s()
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.hdr = inttoptr i64 %v#{vv} to ptr")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.size.p = getelementptr inbounds i64, ptr %vds#{lbl}.hdr, i64 1")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.size = load i64, ptr %vds#{lbl}.size.p, align 8")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.data.p = getelementptr inbounds i64, ptr %vds#{lbl}.hdr, i64 2")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.data.i = load i64, ptr %vds#{lbl}.data.p, align 8")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.data = inttoptr i64 %vds#{lbl}.data.i to ptr")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.ew.p = getelementptr inbounds i64, ptr %vds#{lbl}.hdr, i64 3")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.ew = load i64, ptr %vds#{lbl}.ew.p, align 8")
  # size <= 1 → nothing to do.
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.trivial = icmp sle i64 %vds#{lbl}.size, 1")
  codegen_util::cg_emit_line(out, "  br i1 %vds#{lbl}.trivial, label %vds#{lbl}.end, label %vds#{lbl}.pre")
  codegen_util::cg_emit_line(out, "vds#{lbl}.pre:")
  codegen_util::cg_emit_line(out, "  br label %vds#{lbl}.loop")
  codegen_util::cg_emit_line(out, "vds#{lbl}.loop:")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.ri = phi i64 [1, %vds#{lbl}.pre], [%vds#{lbl}.ri.next, %vds#{lbl}.next]")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.wi = phi i64 [1, %vds#{lbl}.pre], [%vds#{lbl}.wi.next, %vds#{lbl}.next]")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.done = icmp sge i64 %vds#{lbl}.ri, %vds#{lbl}.size")
  codegen_util::cg_emit_line(out, "  br i1 %vds#{lbl}.done, label %vds#{lbl}.fin, label %vds#{lbl}.body")
  codegen_util::cg_emit_line(out, "vds#{lbl}.body:")
  # cur = element[ri], prev = last kept element[wi-1]
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.cur.off = mul i64 %vds#{lbl}.ri, %vds#{lbl}.ew")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.cur.slot = getelementptr inbounds i8, ptr %vds#{lbl}.data, i64 %vds#{lbl}.cur.off")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.pidx = sub i64 %vds#{lbl}.wi, 1")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.prev.off = mul i64 %vds#{lbl}.pidx, %vds#{lbl}.ew")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.prev.slot = getelementptr inbounds i8, ptr %vds#{lbl}.data, i64 %vds#{lbl}.prev.off")
  if inline >= 1
    codegen_util::cg_emit_line(out, "  %vds#{lbl}.a.cur = ptrtoint ptr %vds#{lbl}.cur.slot to i64")
    codegen_util::cg_emit_line(out, "  %vds#{lbl}.a.prev = ptrtoint ptr %vds#{lbl}.prev.slot to i64")
  else
    codegen_util::cg_emit_line(out, "  %vds#{lbl}.a.cur = load i64, ptr %vds#{lbl}.cur.slot, align 8")
    codegen_util::cg_emit_line(out, "  %vds#{lbl}.a.prev = load i64, ptr %vds#{lbl}.prev.slot, align 8")
  end
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.eqr = call i64 @qz_eq_#{sname}(i64 %vds#{lbl}.a.prev, i64 %vds#{lbl}.a.cur)")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.iseq = icmp ne i64 %vds#{lbl}.eqr, 0")
  codegen_util::cg_emit_line(out, "  br i1 %vds#{lbl}.iseq, label %vds#{lbl}.skip, label %vds#{lbl}.keep")
  codegen_util::cg_emit_line(out, "vds#{lbl}.keep:")
  # Compact element[ri] down to element[wi] (skip the no-op copy when ri==wi).
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.dst.off = mul i64 %vds#{lbl}.wi, %vds#{lbl}.ew")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.dst.slot = getelementptr inbounds i8, ptr %vds#{lbl}.data, i64 %vds#{lbl}.dst.off")
  codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %vds#{lbl}.dst.slot, ptr %vds#{lbl}.cur.slot, i64 %vds#{lbl}.ew, i1 false)")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.wi.inc = add i64 %vds#{lbl}.wi, 1")
  codegen_util::cg_emit_line(out, "  br label %vds#{lbl}.next")
  codegen_util::cg_emit_line(out, "vds#{lbl}.skip:")
  codegen_util::cg_emit_line(out, "  br label %vds#{lbl}.next")
  codegen_util::cg_emit_line(out, "vds#{lbl}.next:")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.wi.next = phi i64 [%vds#{lbl}.wi.inc, %vds#{lbl}.keep], [%vds#{lbl}.wi, %vds#{lbl}.skip]")
  codegen_util::cg_emit_line(out, "  %vds#{lbl}.ri.next = add i64 %vds#{lbl}.ri, 1")
  codegen_util::cg_emit_line(out, "  br label %vds#{lbl}.loop")
  codegen_util::cg_emit_line(out, "vds#{lbl}.fin:")
  codegen_util::cg_emit_line(out, "  store i64 %vds#{lbl}.wi, ptr %vds#{lbl}.size.p, align 8")
  codegen_util::cg_emit_line(out, "  br label %vds#{lbl}.end")
  codegen_util::cg_emit_line(out, "vds#{lbl}.end:")
  codegen_util::cg_emit_line(out, "  %v#{d} = add i64 0, 0")
end

# ============================================================================
# Vec Intrinsics (20 handlers)
# ============================================================================

def cg_emit_intrinsic_vec(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if name == "vec_new"
    var ew = 8
    if str_byte_len(_elem_type) > 0
      ew = elem_width::elem_byte_width(_elem_type)
    end
    # Inline struct storage: @value only. Wide structs use field_count*8 bytes/elem
    # (i64-slot stride); narrow firewall-safe structs PACK to sizeof(%struct.Name).
    var _vnew_fc = cg_vec_inline_field_count(prog, _elem_type)
    var _vnew_pack = cg_vec_pack_narrow(prog, _elem_type)
    if _vnew_fc >= 1
      ew = _vnew_fc * 8
    end
    # Packed narrow @value: per-element width = sizeof(%struct.Name), computed once
    # via the LLVM sizeof idiom (GEP null + ptrtoint) so it can never disagree with
    # the %struct.Name field layout.
    if _vnew_pack == 1
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".szgep = getelementptr %struct.")
      codegen_util::cg_emit(out, _elem_type)
      codegen_util::cg_emit_line(out, ", ptr null, i64 1")
      codegen_util::cg_emit_ptrtoint("#{d}.elemsz", "#{d}.szgep", "ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".initbytes = mul i64 8, %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".elemsz")
    end
    var init_bytes = (8 * ew).to_s()
    # 32-byte header: 4 × i64
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 32)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr.i64 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    # [0] capacity = 8
    codegen_util::cg_emit(out, "  store i64 8, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, align 8")
    # [1] size = 0
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".size.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 1")
    codegen_util::cg_emit(out, "  store i64 0, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.ptr, align 8")
    # [2] data array (8 elements * elem_width bytes)
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    if _vnew_pack == 1
      codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".initbytes)")
    else
      codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 ")
      codegen_util::cg_emit(out, init_bytes)
      codegen_util::cg_emit_line(out, ")")
    end
    codegen_util::cg_emit_ptrtoint("#{d}.data.i64", "#{d}.data", "ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data.ptr, align 8")
    # [3] elem_width
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 3")
    if _vnew_pack == 1
      # header[3] carries the packed sizeof so the runtime-width grow/store paths
      # (.newbytes = newcap * ew.g, byte.off = size * ew.s) stay consistent.
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".elemsz, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ew.ptr, align 8")
    else
      codegen_util::cg_emit(out, "  store i64 ")
      codegen_util::cg_emit_int(out, ew)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".ew.ptr, align 8")
    end
    # Return header pointer as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  if name == "vec_new_filled"
    var count_reg = args[0]
    var fill_reg = args[1]
    var ew = 8
    if str_byte_len(_elem_type) > 0
      ew = elem_width::elem_byte_width(_elem_type)
    end
    # @value struct fill: broadcast the single fill element N times into inline
    # contiguous storage. Firewall-safe wide => field_count*8 stride; firewall-safe
    # narrow => packed sizeof(%struct.Name) via typed GEP; mixed (not firewall-safe)
    # => boxed i64-pointer slots (one heap ptr per element, GC-safe). All three share
    # the same counted loop; only the per-element stride/store differs.
    var _vnf_valfc = mir::mir_prog_get_value_layout_field_count(prog, _elem_type)
    if _vnf_valfc >= 1
      var _vnf_fc = cg_vec_inline_field_count(prog, _elem_type)
      var _vnf_pack = cg_vec_pack_narrow(prog, _elem_type)
      var flbl = codegen_util::cg_next_label(state)
      # Per-element width (header[3] / data alloc stride).
      if _vnf_fc >= 1
        ew = _vnf_fc * 8
      end
      # Packed-narrow sizeof, computed once (LLVM sizeof idiom).
      if _vnf_pack == 1
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".szgep = getelementptr %struct.")
        codegen_util::cg_emit(out, _elem_type)
        codegen_util::cg_emit_line(out, ", ptr null, i64 1")
        codegen_util::cg_emit_ptrtoint("#{d}.elemsz", "#{d}.szgep", "ptr")
      end
      # 32-byte header
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 32)")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".hdr.i64 = bitcast ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr to ptr")
      # [0] capacity = count, [1] size = count
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr.i64")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".sz.p = getelementptr i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr.i64, i64 1")
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".sz.p")
      # Data alloc: count * stride bytes.
      if _vnf_pack == 1
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".nb = mul i64 %v")
        codegen_util::cg_emit_int(out, count_reg)
        codegen_util::cg_emit(out, ", %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".elemsz")
      else
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".nb = mul i64 %v")
        codegen_util::cg_emit_int(out, count_reg)
        codegen_util::cg_emit(out, ", ")
        codegen_util::cg_emit_int(out, ew)
        codegen_util::cg_emit_line(out, "")
      end
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".nb)")
      # Store data pointer at header[2].
      codegen_util::cg_emit_ptrtoint("#{d}.data.i", "#{d}.data", "ptr")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".dp = getelementptr i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr.i64, i64 2")
      codegen_util::cg_emit(out, "  store i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data.i, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".dp")
      # [3] elem_width: packed sizeof or field_count*8.
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".ewp = getelementptr i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr.i64, i64 3")
      if _vnf_pack == 1
        codegen_util::cg_emit(out, "  store i64 %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".elemsz, ptr %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".ewp")
      else
        codegen_util::cg_emit(out, "  store i64 ")
        codegen_util::cg_emit_int(out, ew)
        codegen_util::cg_emit(out, ", ptr %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".ewp")
      end
      # Fill loop: for i in 0..count, copy the fill element into slot i.
      codegen_util::cg_emit(out, "  br label %vnf_pre_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnf_pre_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  br label %vnf_loop_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnf_loop_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".i = phi i64 [0, %vnf_pre_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit(out, "], [%vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".inext, %vnf_body_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, "]")
      codegen_util::cg_emit(out, "  %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".cont = icmp slt i64 %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".i, %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "  br i1 %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".cont, label %vnf_body_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit(out, ", label %vnf_done_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnf_body_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, ":")
      if _vnf_fc >= 1
        # Firewall-safe inline: element base addressed at the chosen stride.
        if _vnf_pack == 1
          # Packed narrow: typed %struct.Name GEP (LLVM scales by sizeof).
          codegen_util::cg_emit(out, "  %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".eb = getelementptr inbounds %struct.")
          codegen_util::cg_emit(out, _elem_type)
          codegen_util::cg_emit(out, ", ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".data, i64 %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".i")
        else
          # Wide: i64-array GEP by i * field_count.
          codegen_util::cg_emit(out, "  %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".ioff = mul i64 %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".i, ")
          codegen_util::cg_emit_int(out, _vnf_fc)
          codegen_util::cg_emit_line(out, "")
          codegen_util::cg_emit(out, "  %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".eb = getelementptr inbounds i64, ptr %v")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit(out, ".data, i64 %vnf")
          codegen_util::cg_emit(out, d)
          codegen_util::cg_emit_line(out, ".ioff")
        end
        codegen_util::cg_emit(out, "  %vnf")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".src = inttoptr i64 %v")
        codegen_util::cg_emit_int(out, fill_reg)
        codegen_util::cg_emit_line(out, " to ptr")
        codegen_util::cg_emit(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %vnf")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".eb, ptr %vnf")
        codegen_util::cg_emit(out, d)
        if _vnf_pack == 1
          codegen_util::cg_emit(out, ".src, i64 ")
          codegen_util::cg_emit(out, codegen_util::cg_struct_sizeof_const(_elem_type))
          codegen_util::cg_emit_line(out, ", i1 false)")
        else
          codegen_util::cg_emit(out, ".src, i64 ")
          codegen_util::cg_emit(out, (_vnf_fc * 8).to_s())
          codegen_util::cg_emit_line(out, ", i1 false)")
        end
      else
        # Mixed (not firewall-safe): boxed — store the i64 fill pointer into slot i.
        codegen_util::cg_emit(out, "  %vnf")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".eb = getelementptr inbounds i64, ptr %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".data, i64 %vnf")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".i")
        codegen_util::cg_emit(out, "  store i64 %v")
        codegen_util::cg_emit_int(out, fill_reg)
        codegen_util::cg_emit(out, ", ptr %vnf")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit_line(out, ".eb")
      end
      codegen_util::cg_emit(out, "  %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".inext = add i64 %vnf")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".i, 1")
      codegen_util::cg_emit(out, "  br label %vnf_loop_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnf_done_")
      codegen_util::cg_emit_int(out, flbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
      return
    end
    # 32-byte header
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr = call ptr @__qz_alloc(i64 32)")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".hdr.i64 = bitcast ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr to ptr")
    # [0] capacity = count
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, count_reg)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64")
    # [1] size = count
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".sz.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.i64, i64 1")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit_int(out, count_reg)
    codegen_util::cg_emit(out, ", ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".sz.p")
    # Allocate data: count * elem_width bytes
    if ew == 1
      # 1-byte scalars (U8/I8/Bool/CChar): a byte-memset of (v & 0xff) is correct
      # and fast — every byte of the backing equals the truncated fill value.
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit_line(out, ")")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fill.i32 = trunc i64 %v")
      codegen_util::cg_emit_int(out, fill_reg)
      codegen_util::cg_emit_line(out, " to i32")
      codegen_util::cg_emit(out, "  call void @memset(ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data, i32 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fill.i32, i64 %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit_line(out, ")")
    else
      # Multi-byte scalars (Int/I64/U64/I32/U32/I16/U16/F64/F32, ew 2/4/8): a
      # byte-memset can't broadcast a >1-byte runtime value, so emit a counted
      # broadcast loop that stores the (truncated) fill value into each of the N
      # slots at stride ew. The fill value is a RUNTIME SSA register (%v<fill_reg>),
      # so we cannot special-case 0 statically — broadcast unconditionally.
      var s_elt = elem_width::elem_llvm_type(_elem_type)
      var s_is_float = elem_width::elem_is_float(_elem_type)
      var s_lbl = codegen_util::cg_next_label(state)
      # Data alloc: count * ew bytes.
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".nb = mul i64 %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit(out, ", ")
      codegen_util::cg_emit_int(out, ew)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data = call ptr @__qz_alloc(i64 %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".nb)")
      # Pre-convert the fill value once, before the loop, to the element's storage
      # type. Three cases, matching the vec_push/vec_set store conventions exactly:
      #   - s_elt == "i64" (Int/I64/U64 and the wide F64 storage): store raw i64 bits
      #     (no conversion — F64 rides as its i64 bit pattern, like the wide push path).
      #   - narrow float (F32, s_elt == "float"): bitcast i64->double, fptrunc to float.
      #   - narrow int (s_elt i16/i32): trunc i64 to iN.
      if s_elt == "i64"
        # No conversion: %v<fill_reg> is already the i64 value/bit-pattern to store.
      elsif s_is_float == 1
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".f.dbl = bitcast i64 %v")
        codegen_util::cg_emit_int(out, fill_reg)
        codegen_util::cg_emit_line(out, " to double")
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".f.val = fptrunc double %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".f.dbl to ")
        codegen_util::cg_emit_line(out, s_elt)
      else
        codegen_util::cg_emit(out, "  %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".f.val = trunc i64 %v")
        codegen_util::cg_emit_int(out, fill_reg)
        codegen_util::cg_emit(out, " to ")
        codegen_util::cg_emit_line(out, s_elt)
      end
      # Broadcast loop: for i in 0..count, store the fill value into slot i.
      # Explicit entry block so the loop phi has a named predecessor.
      codegen_util::cg_emit(out, "  br label %vnfs_entry_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnfs_entry_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  br label %vnfs_loop_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnfs_loop_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".i = phi i64 [0, %vnfs_entry_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit(out, "], [%vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".inext, %vnfs_body_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, "]")
      codegen_util::cg_emit(out, "  %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".cont = icmp slt i64 %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".i, %v")
      codegen_util::cg_emit_int(out, count_reg)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "  br i1 %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".cont, label %vnfs_body_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit(out, ", label %vnfs_done_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnfs_body_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, ":")
      codegen_util::cg_emit(out, "  %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".eb = getelementptr inbounds ")
      codegen_util::cg_emit(out, s_elt)
      codegen_util::cg_emit(out, ", ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".data, i64 %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".i")
      codegen_util::cg_emit(out, "  store ")
      codegen_util::cg_emit(out, s_elt)
      if s_elt == "i64"
        # Raw i64 fill register stored directly.
        codegen_util::cg_emit(out, " %v")
        codegen_util::cg_emit_int(out, fill_reg)
      else
        codegen_util::cg_emit(out, " %v")
        codegen_util::cg_emit(out, d)
        codegen_util::cg_emit(out, ".f.val")
      end
      codegen_util::cg_emit(out, ", ptr %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".eb")
      codegen_util::cg_emit(out, "  %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".inext = add i64 %vnfs")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".i, 1")
      codegen_util::cg_emit(out, "  br label %vnfs_loop_")
      codegen_util::cg_emit_int(out, s_lbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "vnfs_done_")
      codegen_util::cg_emit_int(out, s_lbl)
