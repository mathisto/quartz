    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".wi, 1")
    codegen_util::cg_emit(out, "  br label %vrt_next_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "vrt_skip_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %vrt_next_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "vrt_next_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi_next = phi i64 [%vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi_inc, %vrt_store_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, "], [%vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi, %vrt_skip_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "]")
    codegen_util::cg_emit(out, "  %vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ri_next = add i64 %vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ri, 1")
    codegen_util::cg_emit(out, "  br label %vrt_loop_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    codegen_util::cg_emit(out, "vrt_end_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    # Store final write count as new size
    codegen_util::cg_emit(out, "  store i64 %vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".wi, ptr %vrt")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".size.ptr, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  # ---- vec_extend(v1, v2): append all elements of v2 to v1 ----
  if name == "vec_extend"
    var v1 = args[0]
    var v2 = args[1]
    var lbl = codegen_util::cg_next_label(state)
    # @value vecs use a non-8 per-element stride (narrow=packed sizeof, wide=fc*8)
    # stored in header[3] by vec_new/vec_push/vec_new_filled. Both v1 and v2 share
    # the elem type, so a single contiguous memcpy of stride*s2 bytes is correct.
    # Scalar vecs keep the literal *8 stride so their IR stays byte-identical.
    var _ext_value = 0
    if mir::mir_prog_get_value_layout_field_count(prog, _elem_type) > 1
      _ext_value = 1
    end
    codegen_util::cg_emit_line(out, "  ; vec_extend: append v2 elements to v1")
    # Unpack v1 header
    codegen_util::cg_emit_inttoptr_is(dest, ".h1", v1, "ptr")
    # Per-element byte stride: @value reads header[3]; scalar uses literal 8.
    if _ext_value == 1
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".stride.ptr = getelementptr inbounds i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".h1, i64 3")
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".stride = load i64, ptr %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".stride.ptr, align 8")
    end
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cap1 = load i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h1, align 8")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h1, i64 1")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1 = load i64, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s1.ptr, align 8")
    # Unpack v2 header: just need size and data
    codegen_util::cg_emit_inttoptr_is(dest, ".h2", v2, "ptr")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h2, i64 1")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s2 = load i64, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2.ptr, align 8")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d2.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h2, i64 2")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d2 = load i64, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d2.ptr, align 8")
    codegen_util::cg_emit_inttoptr("e#{d}.arr2", "e#{d}.d2", "ptr")
    # Compute new_size = s1 + s2
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_size = add i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".s1, %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s2")
    # Check if grow needed: new_size > cap1
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_grow = icmp sgt i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_size, %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap1")
    codegen_util::cg_emit(out, "  br i1 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".need_grow, label %ve_grow_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit(out, ", label %ve_copy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    # Grow: double capacity until sufficient
    codegen_util::cg_emit(out, "ve_grow_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nc_raw = shl i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cap1, 1")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nc_enough = icmp sge i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nc_raw, %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new_size")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap = select i1 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nc_enough, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nc_raw, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new_size")
    codegen_util::cg_emit(out, "  store i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h1, align 8")
    # Realloc data: newcap * stride bytes (8 for scalar, header[3] for @value)
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".nb = mul i64 %ve")
    codegen_util::cg_emit(out, d)
    if _ext_value == 1
      codegen_util::cg_emit(out, ".newcap, %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".stride")
    else
      codegen_util::cg_emit_line(out, ".newcap, 8")
    end
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h1, i64 2")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_old = load i64, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1.ptr, align 8")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_old_p = inttoptr i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1_old to ptr")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oldbytes = mul i64 %ve")
    codegen_util::cg_emit(out, d)
    if _ext_value == 1
      codegen_util::cg_emit(out, ".cap1, %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".stride")
    else
      codegen_util::cg_emit_line(out, ".cap1, 8")
    end
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_new = call ptr @__qz_realloc(ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_old_p, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".oldbytes, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".nb)")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_new_i = ptrtoint ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1_new to i64")
    codegen_util::cg_emit(out, "  store i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1_new_i, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1.ptr, align 8")
    codegen_util::cg_emit(out, "  br label %ve_copy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, "")
    # Copy: memcpy v2 data to v1 data + s1 * 8
    codegen_util::cg_emit(out, "ve_copy_")
    codegen_util::cg_emit_int(out, lbl)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1f.ptr = getelementptr inbounds i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".h1, i64 2")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1f = load i64, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1f.ptr, align 8")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1f_p = inttoptr i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".d1f to ptr")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".off = mul i64 %ve")
    codegen_util::cg_emit(out, d)
    if _ext_value == 1
      codegen_util::cg_emit(out, ".s1, %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".stride")
    else
      codegen_util::cg_emit_line(out, ".s1, 8")
    end
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst = getelementptr i8, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".d1f_p, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".off")
    codegen_util::cg_emit(out, "  %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cpylen = mul i64 %ve")
    codegen_util::cg_emit(out, d)
    if _ext_value == 1
      codegen_util::cg_emit(out, ".s2, %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".stride")
    else
      codegen_util::cg_emit_line(out, ".s2, 8")
    end
    codegen_util::cg_emit(out, "  call void @llvm.memcpy.p0.p0.i64(ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr2, i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cpylen, i1 false)")
    # B.10 §14.12.8 (C3.6/h5) — cow-element retain. For a cow-layout @value Vec the
    # element slot is an 8-byte buffer POINTER (refcount@0, payload@1..N); the memcpy
    # above copied s2 pointers but did NOT retain the shared buffers. Both v1 and v2
    # now reference each cow buffer with the refcount NOT incremented → undercount →
    # once C4 (Drop) lands, dropping one source frees a still-referenced buffer (UAF).
    # Emit a cow_rc_inc per copied element (atomicrmw add 1 seq_cst on the header word,
    # the same retain idiom as cg_intrinsic_memory.qz:374 / collection-insert push) so
    # the refcount matches the true reference count. cow stride is 8 (one ptr/slot), so
    # iterate the s2 copied slots at %ve.dst. INERT at gate 0: mir_prog_struct_is_cow_layout
    # returns 0 when mir_value_cow_live()==0 ⇒ this whole block is skipped ⇒ byte-identical.
    if mir::mir_prog_struct_is_cow_layout(prog, _elem_type) == 1
      var rclbl = codegen_util::cg_next_label(state)
      codegen_util::cg_emit(out, "  br label %ve_rc_head_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "ve_rc_head_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, ":")
      # i = phi [0, copy-entry], [i.next, body]
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.i = phi i64 [ 0, %ve_copy_")
      codegen_util::cg_emit_int(out, lbl)
      codegen_util::cg_emit(out, " ], [ %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.inext, %ve_rc_body_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, " ]")
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.more = icmp slt i64 %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.i, %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".s2")
      codegen_util::cg_emit(out, "  br i1 %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.more, label %ve_rc_body_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit(out, ", label %ve_rc_done_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "ve_rc_body_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, ":")
      # slot ptr = dst + i*8 (cow stride is 8: one buffer pointer per slot)
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.slot = getelementptr inbounds i64, ptr %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".dst, i64 %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".rc.i")
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.buf = load i64, ptr %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".rc.slot, align 8")
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.bufp = inttoptr i64 %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".rc.buf to ptr")
      # retain: atomicrmw add 1 seq_cst on the refcount header word (offset 0)
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.old = atomicrmw add ptr %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".rc.bufp, i64 1 seq_cst")
      codegen_util::cg_emit(out, "  %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".rc.inext = add i64 %ve")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".rc.i, 1")
      codegen_util::cg_emit(out, "  br label %ve_rc_head_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, "")
      codegen_util::cg_emit(out, "ve_rc_done_")
      codegen_util::cg_emit_int(out, rclbl)
      codegen_util::cg_emit_line(out, ":")
    end
    # Store new size
    codegen_util::cg_emit(out, "  store i64 %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_size, ptr %ve")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".s1.ptr, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

end

