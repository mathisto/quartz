      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fr.len.ptr = getelementptr i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".hdr, i64 1")
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".fr.len = load i64, ptr %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit_line(out, ".fr.len.ptr")
      # Explicit entry label so the head phi has a known predecessor (the current
