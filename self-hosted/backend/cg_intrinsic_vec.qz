    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".bytes = mul i64 %v")
    codegen_util::cg_emit_int(out, slice_len)
    codegen_util::cg_emit(out, ", %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ew")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst = call ptr @__qz_alloc(i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bytes)")
    # memcpy from source + offset (offset already computed in bytes using elem_width-unaware mul by 8)
    codegen_util::cg_emit(out, "  call ptr @memcpy(ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".src.start, i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".bytes)")
    # Store data pointer at header offset 2
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst.i = ptrtoint ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dst to i64")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dp = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 2")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".dst.i, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dp")
    # Store elem_width at header offset 3
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new.ew.p = getelementptr i64, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".hdr.p, i64 3")
    codegen_util::cg_emit(out, "  store i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ew, ptr %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".new.ew.p")
    # Return header pointer as i64
    codegen_util::cg_emit_ptrtoint(d, "#{d}.hdr", "ptr")
    return
  end

  if name == "vec_contains"
    var vec = args[0]
    var val = args[1]
    # R3.4 — value-layout struct element: the shared qz_vec_contains scans at an
    # 8-byte stride and compares one i64 word (icmp eq), but a struct element is
    # `ew` bytes wide and %val is a POINTER to the query struct — so the runtime
    # compares a struct field-word against a pointer (always false). Emit an inline
    # ew-strided scan calling the field-deep @qz_eq_<Name> instead (same struct-eq
    # the map struct-key path uses). Non-struct elements (Int/String/pointer) fall
    # through to the unchanged runtime → byte-identical IR.
    var _c_sname = cg_vec_struct_eq_name(prog, _elem_type)
    if str_byte_len(_c_sname) > 0
      var _c_inline = cg_vec_inline_field_count(prog, _elem_type)
      cg_emit_vec_struct_scan(state, out, prog, d, vec, val, _c_sname, _c_inline, 1)
      return
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_vec_contains(i64 %v")
    codegen_util::cg_emit_int(out, vec)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "vec_index_of"
    var vec = args[0]
    var val = args[1]
    # R3.4 — value-layout struct element: emit an inline ew-strided scan that
    # writes the found index (or -1) into %v<d>.raw via @qz_eq_<Name>, then fall
    # into the shared Option-wrapping below. Non-struct elements use the unchanged
    # runtime call → byte-identical IR. (See vec_contains rationale.)
    var _io_sname = cg_vec_struct_eq_name(prog, _elem_type)
    if str_byte_len(_io_sname) > 0
      var _io_inline = cg_vec_inline_field_count(prog, _elem_type)
      cg_emit_vec_struct_scan(state, out, prog, d, vec, val, _io_sname, _io_inline, 0)
    else
      codegen_util::cg_emit(out, "  %v")
      codegen_util::cg_emit(out, d)
      codegen_util::cg_emit(out, ".raw = call i64 @qz_vec_index_of(i64 %v")
      codegen_util::cg_emit_int(out, vec)
      codegen_util::cg_emit(out, ", i64 %v")
      codegen_util::cg_emit_int(out, val)
      codegen_util::cg_emit_line(out, ")")
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".neg = icmp slt i64 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw, 0")
    codegen_util::cg_emit(out, "  br i1 %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".neg, label %vio_none_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %vio_some_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "vio_some_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_option_some_inline("vio.s.#{d}", "%v#{d}.raw")
    codegen_util::cg_emit(out, "  br label %vio_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "vio_none_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit_option_none_inline("vio.n.#{d}")
    codegen_util::cg_emit(out, "  br label %vio_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "vio_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [ %vio.s.")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %vio_some_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " ], [ %vio.n.")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".res, %vio_none_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " ]")
    return
  end

  if name == "vec_insert"
    var vec = args[0]
    var idx = args[1]
    var val = args[2]
    # item 49: @value / value-layout element insert. The shared runtime
    # qz_vec_insert is stride-1/boxed (grows *8, shifts single i64 words, stores
    # %val as a boxed pointer) — correct ONLY for reference/Int/String (ew==8,
    # %val is the scalar/boxed value). For a value-layout element %val is a
    # POINTER to the source struct and the element is `ew` bytes wide (packed
    # sizeof or fc*8), so it must be shifted + stored inline by memcpy of `ew`
    # bytes. We emit that inline here, reading ew from header[3] at runtime
    # (mirrors the value-layout push / wide-store paths). Non-value-layout falls
    # through to the unchanged runtime call → behaviorally inert at ew==8.
    # Gate on the INLINE-storage predicate (cg_vec_inline_field_count), NOT the
    # broader value-layout field count: a cow-layout (>16B) or mixed @value
    # element is stored BOXED (one i64 pointer per slot, ew==8) so its correct
    # insert IS the stride-1/boxed runtime (store the pointer). Only truly
    # inline-stored value elements (wide fc*8 or packed-narrow) need the ew-wide
    # memcpy path here.
    var _ins_valfc = cg_vec_inline_field_count(prog, _elem_type)
    if _ins_valfc >= 1
      var ilbl = codegen_util::cg_next_label(state).to_s()
      var iv = idx.to_s()
      var vv = val.to_s()
      codegen_util::cg_emit_line(out, "  %v#{d}.hdr = inttoptr i64 %v#{vec.to_s()} to ptr")
      codegen_util::cg_emit_line(out, "  %v#{d}.cap = load i64, ptr %v#{d}.hdr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.size.ptr = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.size = load i64, ptr %v#{d}.size.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.ew.ptr = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 3")
      codegen_util::cg_emit_line(out, "  %v#{d}.ew = load i64, ptr %v#{d}.ew.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.full = icmp sge i64 %v#{d}.size, %v#{d}.cap")
      codegen_util::cg_emit_line(out, "  br i1 %v#{d}.full, label %vec_ins_grow_#{ilbl}, label %vec_ins_shift_#{ilbl}")
      # Grow: realloc to newcap*ew bytes
      codegen_util::cg_emit_line(out, "vec_ins_grow_#{ilbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.newcap.raw = mul i64 %v#{d}.cap, 2")
      codegen_util::cg_emit_line(out, "  %v#{d}.newcap.small = icmp slt i64 %v#{d}.newcap.raw, 4")
      codegen_util::cg_emit_line(out, "  %v#{d}.newcap = select i1 %v#{d}.newcap.small, i64 4, i64 %v#{d}.newcap.raw")
      codegen_util::cg_emit_line(out, "  %v#{d}.newbytes = mul i64 %v#{d}.newcap, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.oldbytes = mul i64 %v#{d}.cap, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.ptr.g = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 2")
      codegen_util::cg_emit_line(out, "  %v#{d}.olddata.i = load i64, ptr %v#{d}.data.ptr.g, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.olddata = inttoptr i64 %v#{d}.olddata.i to ptr")
      codegen_util::cg_emit_line(out, "  %v#{d}.newdata = call ptr @__qz_realloc(ptr %v#{d}.olddata, i64 %v#{d}.oldbytes, i64 %v#{d}.newbytes)")
      codegen_util::cg_emit_line(out, "  %v#{d}.newdata.i = ptrtoint ptr %v#{d}.newdata to i64")
      codegen_util::cg_emit_line(out, "  store i64 %v#{d}.newcap, ptr %v#{d}.hdr, align 8")
      codegen_util::cg_emit_line(out, "  store i64 %v#{d}.newdata.i, ptr %v#{d}.data.ptr.g, align 8")
      codegen_util::cg_emit_line(out, "  br label %vec_ins_shift_#{ilbl}")
      # Shift: for j = size-1 down to idx, memcpy ew bytes from data+j*ew to data+(j+1)*ew
      codegen_util::cg_emit_line(out, "vec_ins_shift_#{ilbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.ptr.s = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 2")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.i.s = load i64, ptr %v#{d}.data.ptr.s, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.s = inttoptr i64 %v#{d}.data.i.s to ptr")
      codegen_util::cg_emit_line(out, "  %v#{d}.j.start = sub i64 %v#{d}.size, 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.nothing = icmp slt i64 %v#{d}.j.start, %v#{iv}")
      codegen_util::cg_emit_line(out, "  br i1 %v#{d}.nothing, label %vec_ins_store_#{ilbl}, label %vec_ins_loop_#{ilbl}")
      codegen_util::cg_emit_line(out, "vec_ins_loop_#{ilbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.j = phi i64 [%v#{d}.j.start, %vec_ins_shift_#{ilbl}], [%v#{d}.j.next, %vec_ins_body_#{ilbl}]")
      codegen_util::cg_emit_line(out, "  %v#{d}.j.done = icmp slt i64 %v#{d}.j, %v#{iv}")
      codegen_util::cg_emit_line(out, "  br i1 %v#{d}.j.done, label %vec_ins_store_#{ilbl}, label %vec_ins_body_#{ilbl}")
      codegen_util::cg_emit_line(out, "vec_ins_body_#{ilbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.src.off = mul i64 %v#{d}.j, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.src.p = getelementptr inbounds i8, ptr %v#{d}.data.s, i64 %v#{d}.src.off")
      codegen_util::cg_emit_line(out, "  %v#{d}.j1 = add i64 %v#{d}.j, 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.dst.off = mul i64 %v#{d}.j1, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.dst.p = getelementptr inbounds i8, ptr %v#{d}.data.s, i64 %v#{d}.dst.off")
      codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %v#{d}.dst.p, ptr %v#{d}.src.p, i64 %v#{d}.ew, i1 false)")
      codegen_util::cg_emit_line(out, "  %v#{d}.j.next = sub i64 %v#{d}.j, 1")
      codegen_util::cg_emit_line(out, "  br label %vec_ins_loop_#{ilbl}")
      # Store: memcpy ew bytes from %val (pointer to source struct) into slot idx
      codegen_util::cg_emit_line(out, "vec_ins_store_#{ilbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.slot.off = mul i64 %v#{iv}, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.slot.p = getelementptr inbounds i8, ptr %v#{d}.data.s, i64 %v#{d}.slot.off")
      codegen_util::cg_emit_line(out, "  %v#{d}.ins.src = inttoptr i64 %v#{vv} to ptr")
      codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %v#{d}.slot.p, ptr %v#{d}.ins.src, i64 %v#{d}.ew, i1 false)")
      codegen_util::cg_emit_line(out, "  %v#{d}.newsize = add i64 %v#{d}.size, 1")
      codegen_util::cg_emit_line(out, "  store i64 %v#{d}.newsize, ptr %v#{d}.size.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d} = add i64 0, 0")
      return
    end
    codegen_util::cg_emit(out, "  call void @qz_vec_insert(i64 %v")
    codegen_util::cg_emit_int(out, vec)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, idx)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, val)
    codegen_util::cg_emit_line(out, ")")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return
  end

  if name == "vec_delete"
    var vec = args[0]
    var idx = args[1]
    # item 49 sibling: value-layout remove/delete. The shared runtime
    # qz_vec_remove is stride-1/boxed (shifts single i64 words, returns the boxed
    # element). For a value-layout element the slots are `ew` bytes wide, so a
    # left-shift must memcpy `ew` bytes per element. We return the boxed-pointer
    # form is not meaningful for inline value elements; delete's result is
    # typically discarded (Void surface), so we return 0. Non-value-layout falls
    # through to the unchanged runtime call → behaviorally inert at ew==8.
    # Gate on the INLINE-storage predicate: boxed (cow/mixed) @value elements are
    # stride-1 pointers → the unchanged runtime remove is correct for them.
    var _del_valfc = cg_vec_inline_field_count(prog, _elem_type)
    if _del_valfc >= 1
      var dlbl = codegen_util::cg_next_label(state).to_s()
      var div = idx.to_s()
      codegen_util::cg_emit_line(out, "  %v#{d}.hdr = inttoptr i64 %v#{vec.to_s()} to ptr")
      codegen_util::cg_emit_line(out, "  %v#{d}.size.ptr = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.size = load i64, ptr %v#{d}.size.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.ew.ptr = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 3")
      codegen_util::cg_emit_line(out, "  %v#{d}.ew = load i64, ptr %v#{d}.ew.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.ptr = getelementptr inbounds i64, ptr %v#{d}.hdr, i64 2")
      codegen_util::cg_emit_line(out, "  %v#{d}.data.i = load i64, ptr %v#{d}.data.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d}.data = inttoptr i64 %v#{d}.data.i to ptr")
      codegen_util::cg_emit_line(out, "  %v#{d}.last = sub i64 %v#{d}.size, 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.nothing = icmp sge i64 %v#{div}, %v#{d}.last")
      codegen_util::cg_emit_line(out, "  br i1 %v#{d}.nothing, label %vec_del_done_#{dlbl}, label %vec_del_start_#{dlbl}")
      codegen_util::cg_emit_line(out, "vec_del_start_#{dlbl}:")
      codegen_util::cg_emit_line(out, "  br label %vec_del_loop_#{dlbl}")
      codegen_util::cg_emit_line(out, "vec_del_loop_#{dlbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.j = phi i64 [%v#{div}, %vec_del_start_#{dlbl}], [%v#{d}.j.next, %vec_del_body_#{dlbl}]")
      codegen_util::cg_emit_line(out, "  %v#{d}.j.done = icmp sge i64 %v#{d}.j, %v#{d}.last")
      codegen_util::cg_emit_line(out, "  br i1 %v#{d}.j.done, label %vec_del_done_#{dlbl}, label %vec_del_body_#{dlbl}")
      codegen_util::cg_emit_line(out, "vec_del_body_#{dlbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.j1 = add i64 %v#{d}.j, 1")
      codegen_util::cg_emit_line(out, "  %v#{d}.src.off = mul i64 %v#{d}.j1, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.src.p = getelementptr inbounds i8, ptr %v#{d}.data, i64 %v#{d}.src.off")
      codegen_util::cg_emit_line(out, "  %v#{d}.dst.off = mul i64 %v#{d}.j, %v#{d}.ew")
      codegen_util::cg_emit_line(out, "  %v#{d}.dst.p = getelementptr inbounds i8, ptr %v#{d}.data, i64 %v#{d}.dst.off")
      codegen_util::cg_emit_line(out, "  call void @llvm.memcpy.p0i8.p0i8.i64(ptr %v#{d}.dst.p, ptr %v#{d}.src.p, i64 %v#{d}.ew, i1 false)")
      codegen_util::cg_emit_line(out, "  %v#{d}.j.next = add i64 %v#{d}.j, 1")
      codegen_util::cg_emit_line(out, "  br label %vec_del_loop_#{dlbl}")
      codegen_util::cg_emit_line(out, "vec_del_done_#{dlbl}:")
      codegen_util::cg_emit_line(out, "  %v#{d}.newsize = sub i64 %v#{d}.size, 1")
      codegen_util::cg_emit_line(out, "  store i64 %v#{d}.newsize, ptr %v#{d}.size.ptr, align 8")
      codegen_util::cg_emit_line(out, "  %v#{d} = add i64 0, 0")
      return
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_vec_remove(i64 %v")
    codegen_util::cg_emit_int(out, vec)
    codegen_util::cg_emit(out, ", i64 %v")
    codegen_util::cg_emit_int(out, idx)
    codegen_util::cg_emit_line(out, ")")
    return
  end

  if name == "vec_join"
    var vec = args[0]
    var sep = args[1]
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = call i64 @qz_vec_join(i64 %v")
    codegen_util::cg_emit_int(out, vec)
