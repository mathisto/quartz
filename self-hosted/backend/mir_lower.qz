##! # MIR Lowering
##!
##! Expression, statement, and function lowering from AST to MIR.
##! Separated from mir.qz (data structures and helpers) for maintainability.
##!
##! @see mir MIR data structures and builder functions
##! @see codegen LLVM IR emission from MIR
##! @since 5.25.0

import mir
import * from mir
import ast
import node_constants
import op_constants
import type_constants
import token_constants
import mir_intrinsics
import mir_const
import mir_lower_async_registry
import mir_lower_gen
import mir_lower_stmt_handlers
import mir_lower_expr_handlers
import mir_lower_iter
import compiler_types
import diagnostic
import * from str_compat
import string_intern
import dep_graph
import qzmod_load
import qzmod_format

# --- Actor-generated function names (excluded from effect propagation) ---
var _actor_generated_funcs: Vec<String> = vec_new<String>()

# --- Loop-as-expression result variable ---
# When non-empty, break VALUE stores to this variable before jumping.
# Set by mir_lower_expr when lowering NODE_WHILE in expression position.
var _loop_expr_result_var: String = ""

# --- Arena allocation context for struct init ---
# When non-empty, the struct init handler uses arena_alloc instead of malloc.
# Set by mir_lower_alloc when target != "heap" and expr is NODE_STRUCT_INIT.
var _mir_alloc_arena_target: String = ""

# --- Incremental compilation support ---
# When non-empty, identifies which modules have changed for warning suppression.
# MIR always lowers ALL functions (lambdas require global sequential numbering).
# Set via mir_lower_set_recompile() before calling mir_lower_all().
var _mir_recompile_set = vec_new<String>()

# When 1, suppress struct resolution warnings for unchanged module functions.
# Set per-function in Pass 1 based on recompile set membership.
var _mir_suppress_warnings = 0

# --- Freestanding target context ---
# When 1, skip fuel_check instrumentation (BEAM-style reduction counting
# is userspace-scheduler machinery; kernel / embedded code preempts via
# timer interrupts, not fuel). The `@__qz_fuel_refill` + `@__qz_sched_fuel`
# symbols are not emitted for freestanding targets (see
# `codegen_runtime.qz:cg_emit_runtime_decls` early-return), so leaving
# the instrumentation in place produces unresolved LLC references.
# Set from the top-level compiler (`quartz.qz::do_build`) once the
# target string is known; cleared on every fresh build.
var _mir_is_freestanding = 0


## Get the current arena allocation target variable name.
def mir_get_alloc_arena_target(): String = _mir_alloc_arena_target

## Set the arena allocation target variable name.
def mir_set_alloc_arena_target(val: String): Void
  _mir_alloc_arena_target = val
end

## Set warning suppression flag for incremental compilation.
## 1 = suppress (unchanged module), 0 = emit warnings (changed module).
def mir_lower_set_suppress_warnings(val: Int): Void
  _mir_suppress_warnings = val
end

## Set the freestanding-target flag for MIR instrumentation gating.
## Called from `quartz.qz::do_build` when the target is freestanding
## (e.g. `aarch64-unknown-none`, `x86_64-unknown-none-elf`). Gates
## fuel_check instrumentation so freestanding builds don't emit
## unresolved `@__qz_fuel_refill` references.
def mir_set_freestanding(val: Int): Void
  _mir_is_freestanding = val
end

## Query the freestanding-target flag. For use by handlers that need to
## branch on target but don't have it in scope.
def mir_is_freestanding(): Int = _mir_is_freestanding

## D.11 Phase 7 / B.5e.3 — freestanding arg-passing async/go spawn.
##
## `go_fn(entry)` (used by B.5e.2's zero-arg redirect) takes a bare zero-arg
## entry pointer and cannot forward call args. For `async fn(a, b)` /
## `go fn(a, b)` on the kernel target we instead spawn via the kernel's
## closure-capture entry `kern_go_closure(closure)`, which the kernel
## already uses for the supervised HTTP per-conn loop. The Quartz closure
## ABI (single source of truth: codegen_runtime.qz `@__qz_poll_closure`,
## C dispatch `__qz_invoke_closure` in libc_stubs.c) is a tagged pointer:
##
##   env = alloc(N+1) ; env[0]=entry_fn_ptr ; env[1..N]=captured values
##   closure = env|1  (low bit set distinguishes from a plain fn ptr)
##
## `__qz_invoke_closure` calls `entry(env)` — a SINGLE arg (the env). So
## the captured-args call must live in a ZERO-USER-PARAM thunk that reads
## its args back out of `env[1..N]` and tail-calls the real target. This
## mirrors the closure env that `mir_lower_lambda` builds for an AST
## lambda `-> fn(a, b)`, but the args here are already-lowered MIR values
## (we have no lambda AST node), so we synthesize the thunk + env in MIR
## directly.
##
## `arg_vals` are MIR register values for each evaluated call arg, lowered
## in the CALLER's context BEFORE this is invoked. `resolved_name` is the
## already-mangled target. Returns the MIR value of the spawned kernel
## task handle (same shape `go_fn`/`kern_go_closure` return), consumable by
## `kernel_awaitable` (B.5a).
def _mir_fs_spawn_closure_with_args(ctx: MirContext, resolved_name: String, arg_vals: Vec<Int>): Int
  var argc = arg_vals.size

  # --- Synthesize the zero-user-param thunk `__fs_async_thunk_N(__env)` ---
  # It loads each captured arg from env[i+1] and calls the real target.
  var thunk_num = ctx.mir_ctx_next_lambda()
  var thunk_name = "__fs_async_thunk_#{thunk_num.to_s()}"

  # Save caller MIR context (thunk creation repoints ctx.func/block/etc.).
  var saved_func = ctx.mir_ctx_get_func()
  var saved_block = ctx.mir_ctx_get_block()
  var saved_bindings = ctx.mir_ctx_get_bindings()
  var saved_string_vars = ctx.mir_ctx_get_string_vars()
  var saved_droppable = ctx.drops.droppable_stack
  var saved_scope_depth = ctx.mir_ctx_get_scope_depth()
  # Emit the thunk as a plain sync fn — pause any active async/generator
  # lowering so `%self`/$poll state does not leak into the thunk body
  # (same hazard mir_lower_lambda guards against).
  var saved_gen_active = mir_lower_gen::mir_gen_pause_active()
  var saved_hs_effs = ctx.handler_stack_effs
  var saved_hs_filters = ctx.handler_stack_filters
  var saved_hs_handlers = ctx.handler_stack_handlers
  var saved_hs_install_dests = ctx.handler_stack_install_dests
  ctx.handler_stack_effs = vec_new<String>()
  ctx.handler_stack_filters = vec_new<String>()
  ctx.handler_stack_handlers = vec_new<Int>()
  ctx.handler_stack_install_dests = vec_new<Int>()

  var thunk_func = mir_new_function(thunk_name, mir::MIR_TYPE_INT)
  # Inherit the surrounding fn's module so the thunk ships in the right
  # `.qzmod` fragment (mirrors mir_lower_lambda).
  mir::mir_func_set_origin_module(thunk_func, mir::mir_func_get_origin_module(saved_func))
  var prog = ctx.mir_ctx_get_program()
  var funcs = mir_get_functions(prog)
  funcs.push(thunk_func)

  ctx.mir_ctx_set_func(thunk_func)
  mir_func_add_param(thunk_func, "__env", mir::MIR_TYPE_INT)

  var thunk_entry = ctx.mir_create_block("entry")
  ctx.mir_ctx_set_block(thunk_entry)
  ctx.bindings = vec_new()
  ctx.string_vars = vec_new<String>()
  ctx.drops.droppable_stack = vec_new()
  ctx.mir_ctx_set_scope_depth(0)

  # Load env, read each captured arg back from env[i+1], call the target.
  var env_in = ctx.mir_emit_load_var("__env")
  var call_args = vec_new()
  for i in 0..argc
    call_args.push(ctx.mir_emit_load_offset(env_in, i + 1))
  end
  var thunk_result = ctx.mir_emit_call(resolved_name, call_args)
  ctx.mir_emit_return(thunk_result)

  # Restore caller MIR context.
  ctx.mir_ctx_set_func(saved_func)
  ctx.mir_ctx_set_block(saved_block)
  ctx.bindings = saved_bindings
  ctx.string_vars = saved_string_vars
  ctx.drops.droppable_stack = saved_droppable
  ctx.mir_ctx_set_scope_depth(saved_scope_depth)
  mir_lower_gen::mir_gen_resume_active(saved_gen_active)
  ctx.handler_stack_effs = saved_hs_effs
  ctx.handler_stack_filters = saved_hs_filters
  ctx.handler_stack_handlers = saved_hs_handlers
  ctx.handler_stack_install_dests = saved_hs_install_dests

  # --- Build the closure env in the CALLER context ---
  # Layout: [thunk_fn_ptr, arg0, arg1, ...]. Tag low bit so
  # __qz_invoke_closure dispatches it as a closure (calls entry(env)).
  var env_ptr = ctx.mir_emit_alloc(argc + 1)
  var thunk_ref = ctx.mir_emit_func_ref(thunk_name)
  ctx.mir_emit_store_offset(env_ptr, 0, thunk_ref)
  for j in 0..argc
    ctx.mir_emit_store_offset(env_ptr, j + 1, arg_vals[j])
  end
  var one = ctx.mir_emit_const_int(1)
  var tagged = ctx.mir_emit_binary(op_constants::OP_ADD, env_ptr, one)

  # Spawn via the kernel's closure-aware entry. Returns the kernel task
  # handle, consumable by kernel_awaitable (B.5a).
  var spawn_args = vec_new()
  spawn_args.push(tagged)
  return ctx.mir_emit_call("kern_go_closure", spawn_args)
end

## Freestanding spawn of a `go do ... end` lambda (B.5e.5). The named
## `go fn(args)` path runs `fn` on its own kernel goroutine stack; this does
## the same for a lambda by synthesizing a closure thunk whose body IS the
## lambda body, with captures restored from the closure env. No hosted
## `$new`/`$poll` state machine and no `perform(Async, spawn, ...)` (which has
## no kernel handler) — the goroutine runs straight-line on its own stack,
## parking on blocking ops via the B.4 suspend/wake bridge.
##
## `body` is the lambda's body AST node (NODE_BLOCK or a bare expr); `cap_names`
## are the captured variable names (from `mir_collect_captures`); `cap_vals` are
## their MIR values, evaluated in the CALLER context BEFORE this is invoked.
## Returns the spawned kernel task handle (same shape `kern_go_closure`
## returns), consumable by `kernel_awaitable` (B.5a).
def _mir_fs_spawn_lambda(ctx: MirContext, s: ast::AstStorage, body: AstNodeId, cap_names: Vec<String>, cap_vals: Vec<Int>): Int
  var capc = cap_names.size

  # --- Synthesize the zero-user-param thunk `__fs_lambda_thunk_N(__env)` ---
  var thunk_num = ctx.mir_ctx_next_lambda()
  var thunk_name = "__fs_lambda_thunk_#{thunk_num.to_s()}"

  # Save caller MIR context — the thunk repoints ctx.func/block/bindings/etc.
  # Mirrors the save set of the hosted go-lambda path (handles arbitrary body
  # constructs) plus the gen-pause + handler-stack clear of the named
  # freestanding closure helper above.
  var saved_func = ctx.mir_ctx_get_func()
  var saved_block = ctx.mir_ctx_get_block()
  var saved_bindings = ctx.mir_ctx_get_bindings()
  var saved_string_vars = ctx.mir_ctx_get_string_vars()
  var saved_float_vars = ctx.float_vars
  var saved_vec_elem_types = ctx.vec_elem_types
  var saved_iter_bound = ctx.iterator_bound_params
  var saved_droppable = ctx.drops.droppable_stack
  var saved_defers = ctx.drops.defer_stack
  var saved_scope_depth = ctx.mir_ctx_get_scope_depth()
  # Emit the thunk as a plain sync fn — pause any active async/generator
  # lowering so $poll state does not leak into the thunk body.
  var saved_gen_active = mir_lower_gen::mir_gen_pause_active()
  var saved_hs_effs = ctx.handler_stack_effs
  var saved_hs_filters = ctx.handler_stack_filters
  var saved_hs_handlers = ctx.handler_stack_handlers
  var saved_hs_install_dests = ctx.handler_stack_install_dests
  ctx.handler_stack_effs = vec_new<String>()
  ctx.handler_stack_filters = vec_new<String>()
  ctx.handler_stack_handlers = vec_new<Int>()
  ctx.handler_stack_install_dests = vec_new<Int>()

  var thunk_func = mir_new_function(thunk_name, mir::MIR_TYPE_INT)
  # Inherit the surrounding fn's module so the thunk ships in the right
  # `.qzmod` fragment (mirrors mir_lower_lambda).
  mir::mir_func_set_origin_module(thunk_func, mir::mir_func_get_origin_module(saved_func))
  var prog = ctx.mir_ctx_get_program()
  var funcs = mir_get_functions(prog)
  funcs.push(thunk_func)

  ctx.mir_ctx_set_func(thunk_func)
  mir_func_add_param(thunk_func, "__env", mir::MIR_TYPE_INT)

  var thunk_entry = ctx.mir_create_block("entry")
  ctx.mir_ctx_set_block(thunk_entry)
  ctx.bindings = vec_new()
  ctx.string_vars = vec_new<String>()
  ctx.reset_float_vars()
  ctx.reset_vec_elem_types()
  ctx.reset_map_key_types()
  ctx.mir_ctx_clear_iterator_bound_params()
  ctx.drops.droppable_stack = vec_new()
  ctx.reset_defers()
  ctx.mir_ctx_set_scope_depth(0)

  # Restore captures: load env[i+1] into a fresh slot bound under the
  # capture's name so the lambda body resolves them.
  var env_in = ctx.mir_emit_load_var("__env")
  for i in 0..capc
    var cap_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(cap_names[i], cap_slot)
    var loaded = ctx.mir_emit_load_offset(env_in, i + 1)
    ctx.mir_emit_store_var(cap_names[i], loaded)
  end

  # Lower the lambda body. A NODE_BLOCK's explicit returns terminate the
  # thunk directly; a bare expression's value is returned. A body that falls
  # through (void) returns 0.
  var body_result = -1
  if body >= 0
    var bkind = ast::ast_get_kind(s, body)
    if bkind == node_constants::NODE_BLOCK
      mir_lower_stmt(ctx, s, body)
    else
      body_result = ctx.mir_lower_expr(s, body)
    end
  end
  var body_end = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(body_end) < 0
    var ret_val = ctx.mir_emit_const_int(0)
    if body_result >= 0
      ret_val = body_result
    end
    ctx.mir_emit_return(ret_val)
  end

  # Restore caller MIR context.
  ctx.mir_ctx_set_func(saved_func)
  ctx.mir_ctx_set_block(saved_block)
  ctx.bindings = saved_bindings
  ctx.string_vars = saved_string_vars
  ctx.float_vars = saved_float_vars
  ctx.vec_elem_types = saved_vec_elem_types
  ctx.iterator_bound_params = saved_iter_bound
  ctx.drops.droppable_stack = saved_droppable
  ctx.drops.defer_stack = saved_defers
  ctx.mir_ctx_set_scope_depth(saved_scope_depth)
  mir_lower_gen::mir_gen_resume_active(saved_gen_active)
  ctx.handler_stack_effs = saved_hs_effs
  ctx.handler_stack_filters = saved_hs_filters
  ctx.handler_stack_handlers = saved_hs_handlers
  ctx.handler_stack_install_dests = saved_hs_install_dests

  # --- Build the closure env in the CALLER context ---
  # Layout: [thunk_fn_ptr, cap0, cap1, ...]. Tag low bit so
  # __qz_invoke_closure dispatches it as a closure (calls entry(env)).
  var env_ptr = ctx.mir_emit_alloc(capc + 1)
  var thunk_ref = ctx.mir_emit_func_ref(thunk_name)
  ctx.mir_emit_store_offset(env_ptr, 0, thunk_ref)
  for j in 0..capc
    ctx.mir_emit_store_offset(env_ptr, j + 1, cap_vals[j])
  end
  var one = ctx.mir_emit_const_int(1)
  var tagged = ctx.mir_emit_binary(op_constants::OP_ADD, env_ptr, one)

  var spawn_args = vec_new()
  spawn_args.push(tagged)
  return ctx.mir_emit_call("kern_go_closure", spawn_args)
end

## Set the recompile set for selective MIR lowering.
## Pass 1 will only lower functions from modules in this set.
def mir_lower_set_recompile(modules: Vec<String>): Void
  _mir_recompile_set = modules
end

## Clear the recompile set (all functions will be lowered).
def mir_lower_clear_recompile(): Void
  _mir_recompile_set = vec_new<String>()
end

## INC.1.3 — local membership probe for the per-call hit-store set used by
## PASS 1 to skip body lowering for cached modules. Mirrors `_qzh_in_set`
## in `quartz.qz` (which is private there); the qzmod hits are bounded by
## the import graph depth, so linear scan is fine.
def _mir_ast_store_in_hit_set(store: Int, hit_stores: Vec<Int>): Int
  for i in 0..hit_stores.size
    if hit_stores[i] == store
      return 1
    end
  end
  return 0
end

## INC.1.4 — string-set membership for `loaded_hashes` dedup. Empty hash
## ("") never matches — caller bears the cost of skipping uninitialized
## entries explicitly. Linear scan; the hit count is bounded by the
## import-graph depth.
def _qzmod_string_in(s: String, set: Vec<String>): Int
  if str_byte_len(s) == 0
    return 0
  end
  for i in 0..set.size
    if str_eq(set[i], s)
      return 1
    end
  end
  return 0
end

## INC.1.4 — is this `ast_store` referencing a module whose MIR has been
## loaded from cache? PASS 1 uses this to decide skip-vs-lower. Dep-graph
## allocates a separate ast_store per import-path alias (e.g. `terminal`
## and `std/terminal` both name the same source but live as two nodes
## with two ast_stores); a content_hash join across all aliases ensures
## the skip fires for every alias of a hit module. Empty hash (no
## dep-graph registration) decodes to "not loaded" — never skip.
def _mir_ast_store_hash_in_loaded(ast_store: ast::AstStorage, loaded_hashes: Vec<String>): Int
  if ast_store == 0
    return 0
  end
  var name = dep_graph::depgraph_name_for_ast_store(ast_store)
  if str_byte_len(name) == 0
    return 0
  end
  var hash = dep_graph::depgraph_get_content_hash(name)
  return _qzmod_string_in(hash, loaded_hashes)
end

## QZMOD_ALIAS_NOT_SHADOW (2026-06-02) — resolve an `ast_store` to the
## content_hash of the source it was registered for, via its dep-graph node.
## Returns "" when the store has no dep-graph registration (synthetic/local).
## Used by the PASS 0.999 shadow check to distinguish a genuine local shadow
## (different source) from a same-source import-path alias (same hash) — the
## latter must NOT suppress the cached MIR body.
def _mir_ast_store_content_hash(ast_store: ast::AstStorage): String
  if ast_store == 0
    return ""
  end
  var name = dep_graph::depgraph_name_for_ast_store(ast_store)
  if str_byte_len(name) == 0
    return ""
  end
  return dep_graph::depgraph_get_content_hash(name)
end

## INC.1.4 — does `all_funcs` carry a regular-fn or extern-fn entry by this
## exact name? Mirrors `mir_lookup_function` (mir.qz:3180) without needing a
## MirContext — the consumer rewrite runs before per-function ctx setup.
def _qzmod_all_funcs_has_name(all_funcs: Vec<ResolverEntry>, name: String): Int
  for i in 0..all_funcs.size
    var entry = all_funcs[i]
    var tag = entry.tag
    if tag == 0 or tag == 10
      if entry.name == name
        return 1
      end
    end
  end
  return 0
end

## INC.1.4 — recover program-level `uses_*` flags from loaded MIR. The
## flags (`uses_scheduler`, `uses_intern`, `uses_cache`, `uses_profile`,
## `uses_scope_deadline`, `uses_task_group`) are normally OR'd by side
## effect inside `mir_lower_call` / `mir_lower_expr` paths whenever
## specific opcodes/effect-names are emitted. The consumer skips body
## lowering for hit modules, so those side-effects never fire — the
## cached MIR carries the right opcodes but `prog.uses_*` stays at zero.
## Codegen then emits the no-scheduler / no-intern stubs, producing IR
## that diverges from cold-compile (fixpoint failure) and would crash at
## runtime if dispatched. Recover by walking the loaded MirFunc bodies
## and re-OR'ing each flag based on the patterns the cold path matches:
##   - `MIR_INTRINSIC operand2 ∈ {sched_*, proc_suspend}` → uses_scheduler
##   - `MIR_INTRINSIC operand2 == "scope_register_deadline"` → uses_scope_deadline
##   - `MIR_INTRINSIC operand2 == "task_group_new"` → uses_task_group + uses_scheduler
##   - `MIR_PERFORM_OP slot2 == "Async"` → uses_scheduler (covers go/await/spawn)
##   - `MIR_PERFORM_OP slot2 ∈ {"Intern", "Cache", "Profile", "Yield"}` → respective flag
def _qzmod_recover_uses_flags(bodies: Vec<MirFunc>, prog: MirProgram): Void
  for fi in 0..bodies.size
    var fn: MirFunc = bodies[fi]
    var blocks = mir_func_get_blocks(fn)
    for bi in 0..blocks.size
      var block: MirBlock = blocks[bi]
      var instrs = mir_block_get_instructions(block)
      for ii in 0..instrs.size
        var instr_handle = instrs[ii]
        var kind = mir::mir_instr_get_kind(instr_handle)
        if kind == mir::MIR_INTRINSIC
          var iname = mir::mir_instr_get_func_name(instr_handle)
          if iname == "sched_init" or iname == "sched_spawn" or iname == "sched_spawn_priority" or iname == "sched_shutdown" or iname == "sched_yield" or iname == "sched_idle_hook_set" or iname == "sched_idle_hook_clear" or iname == "sched_register_proc" or iname == "proc_suspend"
            mir_set_uses_scheduler(prog)
          end
          # A.17 — channel/mutex/select intrinsics emit `__qz_waiter_*`
          # runtime calls gated on `uses_scheduler` in codegen_runtime.qz.
          # Mirror the cold-path detection in mir_lower_expr_handlers.qz so
          # cached (qzmod-hit) and non-cached builds agree on the flag.
          if mir_intrinsic_uses_waiter_runtime(iname)
            mir_set_uses_scheduler(prog)
          end
          if iname == "scope_register_deadline"
            mir_set_uses_scope_deadline(prog)
          end
          if iname == "task_group_new"
            mir_set_uses_task_group(prog)
            mir_set_uses_scheduler(prog)
          end
        end
        if kind == mir::MIR_PERFORM_OP
          # Effect name lives in slot2 as an interned string (cf.
          # mir_emit_perform_op at mir.qz:4701). Slot2 is a string under
          # the MIR_KIND_SLOT2_STR mask — read as a `String` via
          # `as_string` of the slot's int.
          var eff_int = mir::mir_instr_get_slot2(instr_handle)
          var effname = as_string(eff_int)
          if effname == "Async"
            mir_set_uses_scheduler(prog)
          end
          if effname == "Intern"
            mir_set_uses_intern(prog)
          end
          if effname == "Cache"
            mir_set_uses_cache(prog)
          end
          if effname == "Profile"
            mir_set_uses_profile(prog)
          end
          if effname == "Yield"
            mir_set_uses_yield(prog)
          end
        end
      end
    end
  end
end

## INC.1.4 — repair cross-module call names in loaded MIR bodies. The
## producer's MIR pickle ships `MIR_CALL.operand2` verbatim. When the
## producer ran without the callee's module in `all_funcs` (e.g. only one
## of multiple dep-graph aliases shipped MIR, or context-dependent suffix
## resolution didn't fire at producer mir-lower time), the unmangled bare
## name (`EAGAIN`) reaches the consumer and codegen emits `call @EAGAIN`
## against the prefixed definition `@socket$EAGAIN`. llc rejects.
##
## This pass walks every loaded MirFunc's blocks → instructions; for each
## `MIR_CALL` (and `MIR_FUNC_REF`) whose operand2 string doesn't match a
## function in `all_funcs` and lacks any `$`, suffix-search for a unique
## `<prefix>$<name>` match and rewrite operand2 in place. Mirrors the
## cold-compile late-binding at `mir_lower_expr_handlers.qz:2926-2950`
## (suffix-search + arity-overload mangling). Idempotent: names that
## already resolve cleanly are untouched. See feedback memo
## `feedback_qzmod_dep_graph_aliases_split_mir_shipping.md` for the
## diagnosis driving this fix.
def _qzmod_rewrite_call_names(bodies: Vec<MirFunc>, all_funcs: Vec<ResolverEntry>): Void
  for fi in 0..bodies.size
    var fn: MirFunc = bodies[fi]
    var blocks = mir_func_get_blocks(fn)
    for bi in 0..blocks.size
      var block: MirBlock = blocks[bi]
      var instrs = mir_block_get_instructions(block)
      for ii in 0..instrs.size
        var instr_handle = instrs[ii]
        var kind = mir::mir_instr_get_kind(instr_handle)
        # Only MIR_CALL + MIR_FUNC_REF carry cross-module function names.
        # MIR_INTRINSIC.operand2 holds intrinsic names (`vec_push`, `str_from_int`)
        # which are bare by design. MIR_HANDLE_INSTALL et al. carry effect-op
        # strings, not fn names. MIR_PERFORM_OP's op2 is the effect-op name.
        var is_call = 0
        if kind == mir::MIR_CALL
          is_call = 1
        end
        if kind == mir::MIR_FUNC_REF
          is_call = 1
        end
        continue if is_call == 0
        var name = mir::mir_instr_get_func_name(instr_handle)
        continue if str_byte_len(name) == 0
        # Already module-qualified (or arity-mangled, or runtime helper like
        # `__qz_…`) — keep as-is.
        continue if str_contains(name, "$") == 1
        # Direct match in all_funcs — already resolved (e.g. top-level
        # `def main` or stdlib bare helper) — skip.
        continue if _qzmod_all_funcs_has_name(all_funcs, name) == 1
        # Suffix-search: first entry whose name ends in `$<name>`. This
        # mirrors the cold-compile fallback at
        # `mir_lower_expr_handlers.qz:2926-2941`. The cold path picks the
        # first match; we do the same. If there are multiple modules
        # exporting the same short name, the ambiguity is the same as
        # cold — surfacing it here is consistent.
        var suffix = "$#{name}"
        var found = ""
        for ai in 0..all_funcs.size
          var entry = all_funcs[ai]
          if entry.tag == 0 and str_ends_with(entry.name, suffix)
            found = entry.name
            break
          end
        end
        continue if str_byte_len(found) == 0
        # Arity-overload disambiguation (MIR_CALL only — MIR_FUNC_REF has
        # no args). If the resolved function has overloads, mangle by the
        # arg count present in this instruction. Mirrors cold path lines
        # 2942-2950.
        if kind == mir::MIR_CALL
          if mir_has_arity_overload(all_funcs, found) == 1
            var args = mir::mir_instr_get_args(instr_handle)
            var arity_match = mir_find_arity_match(all_funcs, found, args.size)
            if arity_match.is_some()
              found = string_intern::mangle_int(found, args.size)
            end
          end
        end
        mir::mir_instr_set_func_name(instr_handle, found)
      end
    end
  end
end

## Resolve a global variable's type for the PASS 0.6 registry.
##
## Primary source: the explicit `: Type` annotation the parser writes
## into str2 on the NODE_LET. When the user omits the annotation
## (`_state = vec_new<Int>()` vs `_state: Vec<Int> = vec_new<Int>()`),
## str2 is empty — and `mir_ctx_lookup_global_type` returns empty,
## breaking the UFCS rewrite fallback in `mir_lower_call` for any
## `_state.method(args)` call under an incremental cache hit where TC
## body-walk was skipped. Without this inference, the rewrite gives
## up, the call falls through to `LoadVar(method) + CallIndirect`,
## and llc rejects the IR with `use of undefined value '%method'`.
##
## Inference handles the common shape: init is an intrinsic call
## (`vec_new`, `map_new`, `sb_new`, ...) whose return type is in the
## `mir_intrinsic_return_type` table. Also handles direct struct
## init. Returns "" when no inference applies — caller preserves
## current behavior.
def _resolve_global_type(ast_store: AstStorage, node: AstNodeId, init_node: AstNodeId): String
  var annotated = ast::ast_get_str2(ast_store, node)
  if str_byte_len(annotated) > 0
    return annotated
  end
  return "" if init_node < 0
  var init_kind = ast::ast_get_kind(ast_store, init_node)
  if init_kind == node_constants::NODE_CALL
    var callee = ast::ast_get_left(ast_store, init_node)
    if callee >= 0 and ast::ast_get_kind(ast_store, callee) == node_constants::NODE_IDENT
      var callee_name = ast::ast_get_str1(ast_store, callee)
      # A.45 ii (L2) — an UN-annotated module-global constructed with a typed
      # `vec_new<T>()` / `vec_new_filled<T>()` carries its element type T on the
      # call node's type-arg slot, but `mir_intrinsic_return_type` yields the bare
      # "Vec" (element erased). That erasure means a cross-function
      # `g_vec[i].field` / `vec_get(g_vec, i).field` access (whose MIR element
      # recovery resolves the receiver via `mir_ctx_lookup_global_type`) gets bare
      # "Vec", falls to the GLOBAL field-name table (`mir_find_field_globally`),
      # and picks the WRONG offset on a cross-struct field-name collision ⇒
      # nondeterministic heap corruption. Recover `Vec<T>` from the constructor's
      # type-arg here so the global registry stores the concrete element type and
      # the existing typed-receiver path (L1 / index-syntax) resolves the offset.
      # Conservative/additive: bare `vec_new()` (no type-arg) keeps "Vec"
      # unchanged, and `vec_new<Int>()` resolves to "Vec<Int>" (element extraction
      # yields "Int" — byte-identical downstream). Only typed `Vec<Struct>`
      # globals gain tracking.
      if callee_name == "vec_new" or callee_name == "vec_new_filled"
        var vn_type_arg = ast::ast_get_type_arg(ast_store, init_node)
        if str_byte_len(vn_type_arg) > 0
          return "Vec<#{vn_type_arg}>"
        end
      end
      return mir_intrinsic_return_type(callee_name)
    end
  end
  if init_kind == node_constants::NODE_STRUCT_INIT
    return ast::ast_get_str1(ast_store, init_node)
  end
  return ""
end

## Check if a function should be lowered (warnings emitted) under the
## current recompile set. Mirrors TC's gate at quartz.qz: primary lookup is
## via ast_store → dep-graph canonical module name; fallback is the func-name
## prefix. Pure-prefix lookup is incorrect because (a) free functions are
## stored in the registry under their bare name (no `$` prefix), so the
## prefix path defaults to `__main__` and spuriously matches the always-in-set
## main module, and (b) impl methods carry the struct-name prefix
## (`Progress$spinner_only`), not the module-short-name (`progress`), so the
## prefix path silently mis-classifies impl methods. The ast_store path
## handles both correctly.
def _mir_should_lower(ast_store: ast::AstStorage, func_name: String): Int
  if _mir_recompile_set.size == 0
    return 1  # No filter — lower everything
  end

  var mod_name = ""
  var dg_name = dep_graph::depgraph_name_for_ast_store(ast_store)
  if str_byte_len(dg_name) > 0
    # Primary path: dep-graph canonical module name. Strip directory prefix
    # ("std/progress" → "progress") to match the recompile_set normalization
    # done by quartz.qz after depgraph_invalidate_with_cutoff.
    var len = str_byte_len(dg_name)
    var last_slash = -1
    for i in 0..len
      if str_byte_at(dg_name, i) == '/'
        last_slash = i
      end
    end
    if last_slash >= 0
      mod_name = str_byte_slice(dg_name, last_slash + 1, len)
    else
      mod_name = dg_name
    end
  else
    # Fallback: extract module name from function-name prefix. Rare —
    # entry.ast_store should always be registered. Defaults to `__main__`
    # for the bare-name (no `$`) case.
    mod_name = "__main__"
    var dollar = __char_index(func_name, '$')
    if dollar > 0
      mod_name = str_byte_slice(func_name, 0, dollar)
      var dd = __str_index(mod_name, "$$")
      if dd >= 0
        mod_name = str_byte_slice(mod_name, 0, dd)
      end
    end
  end

  for i in 0.._mir_recompile_set.size
    if _mir_recompile_set[i].eq(mod_name)
      return 1
    end
  end
  return 0
end

# ============================================================================
# C4 guardrail: post-resolve NODE_IDENT resolution check (QZ9501)
# ============================================================================

## Check whether a NODE_IDENT name has any valid global resolution path
## beyond local/function/arity-mangled lookups (which the caller has
## already tried). Returns 1 if the name is a known global (const, var,
## imported global, or resolves via module-prefix suffix match), 0
## otherwise. Used by the mir_lower NODE_IDENT branch to decide whether
## a fall-through to mir_emit_load_var is legitimate (global) or an
## internal compiler bug (unresolved, fires QZ9501).
def mir_ident_has_global_resolution(ctx: MirContext, name: String): Int
  if mir_ctx_is_global(ctx, name) == 1
    return 1
  end
  # Suffix-match resolves bare names against module-prefixed globals,
  # e.g. `config` against `mymod$config`. Any non-empty return means a
  # matching global exists.
  var resolved = mir_find_global_name(ctx, name)
  if str_byte_len(resolved) > 0
    return 1
  end
  return 0
end

## Check whether an identifier name starts with a PascalCase character.
## Quartz convention reserves PascalCase for types, enums, and variant
## constructors — these should never appear as a bare NODE_IDENT at MIR
## lowering entry. Lowercase names (match pattern bindings, closure
## captures, generator locals) have legitimate late-bound resolution
## paths and are EXCLUDED from the C4 guardrail to avoid false
## positives. The assertion narrowed here catches the
## OPTION-CTOR-IN-IMPL-BODY class — bare `None` / `Some` / `Ok` / `Err`
## leaking through a resolver hole — without firing on match arm
## bindings or similar.
def mir_ident_is_pascal_case(name: String): Int
  if str_byte_len(name) == 0
    return 0
  end
  var c = str_byte_at(name, 0)
  if c >= 'A' and c <= 'Z'
    return 1
  end
  return 0
end

# ============================================================================
# Range step helpers
# ============================================================================

## Check if a step node is a constant integer literal (positive or negative unary).
def mir_is_const_step(s: ast::AstStorage, step_node: AstNodeId): Bool
  var sk = ast::ast_get_kind(s, step_node)
  if sk == node_constants::NODE_INT_LIT
    return true
  end
  if sk == node_constants::NODE_UNARY
    if ast::ast_get_op(s, step_node) == op_constants::OP_NEG
      var inner = ast::ast_get_left(s, step_node)
      if ast::ast_get_kind(s, inner) == node_constants::NODE_INT_LIT
        return true
      end
    end
  end
  return false
end

## Get the constant value of a step node. Only valid when mir_is_const_step returns true.
def mir_get_const_step_val(s: ast::AstStorage, step_node: AstNodeId): Int
  var sk = ast::ast_get_kind(s, step_node)
  if sk == node_constants::NODE_INT_LIT
    return ast::ast_get_int_val(s, step_node)
  end
  # Must be NODE_UNARY with OP_NEG
  var inner = ast::ast_get_left(s, step_node)
  return 0 - ast::ast_get_int_val(s, inner)
end

## Emit direction-aware condition for a range loop with optional step.
## Handles: no-step (forward), constant step (compile-time direction), variable step (runtime).
def mir_emit_range_step_cond(ctx: MirContext, s: ast::AstStorage, i_val: Int, end_val: Int, range_op: Int, step_node: Int, step_val: Int, step_is_const: Bool, step_const_val: Int, body_block: MirBlock, exit_block: MirBlock, cond_block: MirBlock): Void
  if step_node == 0
    # No step — original behavior: i < end or i <= end
    var cmp_op = op_constants::OP_LT
    if range_op == op_constants::OP_RANGE_INCLUSIVE
      cmp_op = op_constants::OP_LE
    end
    var cmp_val = ctx.mir_emit_binary(cmp_op, i_val, end_val)
    mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)
  elsif step_is_const
    # Constant step — pick direction at compile time
    if step_const_val > 0
      var fwd_op = op_constants::OP_LT
      if range_op == op_constants::OP_RANGE_INCLUSIVE
        fwd_op = op_constants::OP_LE
      end
      var cmp_val = ctx.mir_emit_binary(fwd_op, i_val, end_val)
      mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)
    elsif step_const_val < 0
      var bwd_op = op_constants::OP_GT
      if range_op == op_constants::OP_RANGE_INCLUSIVE
        bwd_op = op_constants::OP_GE
      end
      var cmp_val = ctx.mir_emit_binary(bwd_op, i_val, end_val)
      mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)
    else
      # Zero step — never enter loop
      var zero_cmp = ctx.mir_emit_const_int(0)
      mir_block_set_branch(cond_block, zero_cmp, body_block, exit_block)
    end
  else
    # Variable step — runtime direction check using arithmetic
    var zero = ctx.mir_emit_const_int(0)
    var step_neg = ctx.mir_emit_binary(op_constants::OP_LT, step_val, zero)
    var step_pos = ctx.mir_emit_binary(op_constants::OP_GT, step_val, zero)
    var fwd_op = op_constants::OP_LT
    var bwd_op = op_constants::OP_GT
    if range_op == op_constants::OP_RANGE_INCLUSIVE
      fwd_op = op_constants::OP_LE
      bwd_op = op_constants::OP_GE
    end
    var fwd_cmp = ctx.mir_emit_binary(fwd_op, i_val, end_val)
    var bwd_cmp = ctx.mir_emit_binary(bwd_op, i_val, end_val)
    var part1 = ctx.mir_emit_binary(op_constants::OP_MUL, step_neg, bwd_cmp)
    var part2 = ctx.mir_emit_binary(op_constants::OP_MUL, step_pos, fwd_cmp)
    var cmp_val = ctx.mir_emit_binary(op_constants::OP_ADD, part1, part2)
    mir_block_set_branch(cond_block, cmp_val, body_block, exit_block)
  end
end

# ============================================================================
# Deferred expression emission (moved from mir.qz)
# ============================================================================

## Emit deferred expressions for innermost scope in LIFO order, then pop scope.
def defer_scope_pop(ctx: MirContext): Void
  var scope_stack = ctx.drops.defer_stack
  var depth = scope_stack.size
  if depth == 0
    return
  end
  var inner_scope = scope_stack[depth - 1]
  var i = vec_size(inner_scope) - 1
  while i >= 0
    var entry = inner_scope[i]
    var ast_store: ast::AstStorage = as_type<ast::AstStorage>(entry[0])
    var node = entry[1]
    ctx.mir_lower_stmt(ast_store, node)
    i -= 1
  end
  var popped = __vec_pop_raw(scope_stack)
  return
end

## Emit ALL deferred expressions across all scopes in LIFO order (for function return).
def emit_deferred(ctx: MirContext): Void
  var scope_stack = ctx.drops.defer_stack
  var sc = scope_stack.size - 1
  while sc >= 0
    var scope = scope_stack[sc]
    var i = vec_size(scope) - 1
    while i >= 0
      var entry = scope[i]
      var ast_store: ast::AstStorage = as_type<ast::AstStorage>(entry[0])
      var node = entry[1]
      ctx.mir_lower_stmt(ast_store, node)
      i -= 1
    end
    sc -= 1
  end
end

## Emit deferred expressions for scopes at or above target_depth only.
## Used by break/continue to emit only loop-body defers, not outer defers.
def emit_deferred_to_depth(ctx: MirContext, target_depth: Int): Void
  var scope_stack = ctx.drops.defer_stack
  var sc = scope_stack.size - 1
  while sc >= target_depth
    var scope = scope_stack[sc]
    var i = vec_size(scope) - 1
    while i >= 0
      var entry = scope[i]
      var ast_store: ast::AstStorage = as_type<ast::AstStorage>(entry[0])
      var node = entry[1]
      # Use mir_lower_stmt (matching emit_deferred / emit_deferred_to_scope).
      # Previously used mir_lower_expr which broke on statement-shaped defer
      # bodies (assignments, compound assigns, blocks). Latent bug caught by
      # the Apr 12 2026 defer-parser-extension research.
      ctx.mir_lower_stmt(ast_store, node)
      i -= 1
    end
    sc -= 1
  end
end

# ============================================================================
# Generic specialization lowering (moved from mir.qz)
# ============================================================================

## Flatten a parameterized type name into a form safe for LLVM symbol use.
## `MapDoubler<RangeSrc>` → `MapDoubler$RangeSrc`.
## `Map<Int, Vec<String>>` → `Map$Int$Vec$String`.
def mir_flatten_type_for_symbol(type_str: String): String
  var len = str_byte_len(type_str)
  if len == 0
    return type_str
  end
  # Fast path: no generic brackets, nothing to flatten
  if __char_index(type_str, '<') < 0
    return type_str
  end
  var out = ""
  var last_was_sep = 0  # 1 if we just appended a $
  var i = 0
  while i < len
    var ch = str_byte_at(type_str, i)
    if ch == '<' or ch == ',' or ch == '>'
      # Collapse consecutive separators so `Foo<Bar>` ends as `Foo$Bar`.
      if last_was_sep == 0 and str_byte_len(out) > 0
        out = "#{out}$"
        last_was_sep = 1
      end
    elsif ch == ' '
      # Strip whitespace inside generic args (e.g. `Map<Int, String>`)
    else
      out = "#{out}#{str_byte_slice(type_str, i, i + 1)}"
      last_was_sep = 0
    end
    i += 1
  end
  # Trim trailing `$` if any
  while str_byte_len(out) > 0 and str_byte_at(out, str_byte_len(out) - 1) == '$'
    out = str_byte_slice(out, 0, str_byte_len(out) - 1)
  end
  return out
end

def mir_lower_specialized_function(ctx: MirContext, base_name: String, arg_types: Vec, ast_store: ast::AstStorage, func_handle: AstNodeId): Void
  # Build specialized name: base_name$type1$type2...
  # MUST stay in lockstep with the caller-side mangling in
  # mir_lower_expr_handlers.qz (~line 1750). Both sides skip empty type
  # components — when a positional arg's inferred type is empty (e.g. an
  # un-annotated lambda for `f: Fn(Int): Int`), neither side appends a
  # `$` for it. If the two sides drift, the def emits `foo$2$T$` (trailing
  # `$`) while the call site emits `foo$2$T` (no trailing) and llc fails
  # with `use of undefined value @foo$2$T`. The Phase 6 std/iter.qz rewrite
  # tripped this when MapIter's constructor took a closure as second arg.
  var spec_name = base_name
  var atc = arg_types.size
  for ati in 0..atc
    var type_str = as_string(arg_types[ati])
    # Defensive: symbol components must not contain whitespace.
    # If this fires, something leaked an unresolved "impl Trait" annotation
    # (or another free-form string with spaces) into monomorphization.
    # See docs/handoff/impl-trait-sprint.md Phase 1 — probe 2 regression sentinel.
    if __char_index(type_str, ' ') >= 0
      eputs("MANGLER BUG: specialization component contains whitespace")
      eputs("  base_name = #{base_name}")
      eputs("  component = '#{type_str}'")
      eputs("  spec_name so far = #{spec_name}")
      eputs("  hint: an 'impl Trait' return type likely did not resolve to concrete before monomorphization")
    end
    # Normalize parameterized type names for LLVM symbol use. `MapDoubler<RangeSrc>`
    # contains `<` and `>` which LLVM rejects in identifiers, so flatten them
    # into `$` separators: `MapDoubler$RangeSrc`. Each type arg remains distinct.
    if str_byte_len(type_str) > 0
      var flat = mir_flatten_type_for_symbol(type_str)
      spec_name = "#{spec_name}$#{flat}"
    end
  end

  # Cycle detection: skip if this specialization is already being lowered
  var in_progress_stack = ctx.generics.spec_in_progress
  var ip_count = in_progress_stack.size
  var is_in_progress = 0
  for ipi in 0..ip_count
    if in_progress_stack[ipi].eq(spec_name)
      is_in_progress = 1
    end
  end
  if is_in_progress == 1
    return
  end

  # Push onto in-progress stack for cycle detection
  ctx.generics.spec_in_progress.push(spec_name)

  # Build per-param type map: [[param_name, concrete_type], ...]
  var param_types = vec_new()
  var params = ast::ast_get_left(ast_store, func_handle)
  if params >= 0
    var pc = vec_size(params)
    for pi in 0..pc
      var pname = ast::ast_get_str1(ast_store, params[pi])
      var ptype = ""
      if pi < atc
        ptype = as_string(arg_types[pi])
      end
      if str_byte_len(ptype) > 0
        var pt_entry = [as_int(pname), as_int(ptype)]
        param_types.push(pt_entry)
      end
    end
  end
  # Append type_param→concrete_type entries (e.g., ["T", "Int"], ["U", "String"])
  # so that mir_ctx_lookup_spec_param_type can resolve type param names in nested calls.
  var tp_csv = ast::ast_func_type_params(ast_store, func_handle)
  if str_byte_len(tp_csv) > 0
    var tp_names = str_split(tp_csv, ",")
    var tp_count = tp_names.size
    if params >= 0
      var pc2 = vec_size(params)
      for pi2 in 0..pc2
        var ann = ast::ast_get_str2(ast_store, params[pi2])
        if str_byte_len(ann) > 0
          for tpi in 0..tp_count
            var tp_name = tp_names[tpi]
            if ann == tp_name
              # Check if this type param is already mapped (first-wins)
              var already = 0
              var pt_len = param_types.size
              for chk in 0..pt_len
                var chk_entry = param_types[chk]
                if as_string(chk_entry[0]) == ann
                  already = 1
                end
              end
              if already == 0
                if pi2 < atc
                  var tp_entry = [as_int(ann), as_int(as_string(arg_types[pi2]))]
                  param_types.push(tp_entry)
                end
              end
            elsif ann == "Vec<#{tp_name}>"
              # item 48-b HOOK #2: a `Vec<T>`-shaped param annotation never
              # equals the bare type-param name, so the exact-match arm above
              # leaves T UNBOUND in the body. Then `mir_infer_expr_type(shapes[i])`
              # cannot resolve `Vec<T>` → the concrete element, so an INLINE
              # value-layout element read at `shapes[i]` takes the boxed-pointer
              # path (inttoptr a scalar field word → SIGSEGV). De-erase the actual
              # arg's element type (48-a populated arg_types as `Vec<Circle>`) and
              # bind `T → Circle` so `mir_resolve_type_param("Vec<T>")` resolves to
              # `Vec<Circle>` and the value-layout inline index-read fires.
              #
              # GATE-0-INERT: bound ONLY when the de-erased element is a
              # value-layout type. Reference-struct elements (8B boxed) already
              # read correctly via the boxed-pointer path and must keep T unbound
              # so behavior/IR is byte-identical at the flip == 0.
              if pi2 < atc
                var arg_ty = as_string(arg_types[pi2])
                var concrete_elem = mir::mir_extract_generic_element_type(arg_ty)
                if str_byte_len(concrete_elem) > 0 and mir::mir_is_value_layout_type(ctx, concrete_elem) == 1
                  # First-wins: skip if this type param is already mapped.
                  var v_already = 0
                  var v_pt_len = param_types.size
                  for v_chk in 0..v_pt_len
                    var v_chk_entry = param_types[v_chk]
                    if as_string(v_chk_entry[0]) == tp_name
                      v_already = 1
                    end
                  end
                  if v_already == 0
                    var v_tp_entry = [as_int(tp_name), as_int(concrete_elem)]
                    param_types.push(v_tp_entry)
                  end
                end
              end
            end
          end
        end
      end
    end
  end

  ctx.mir_ctx_set_spec_param_types(param_types)

  # Set spec_current_type for backwards compat with bounded generic trait rewriting
  if atc > 0
    ctx.mir_ctx_set_spec_current_type(as_string(arg_types[0]))
  end

  # Extract the module prefix from base_name (e.g., "iter$sum_it$1" → "iter").
  # Cross-module A8 trait-rewrite dispatch needs this to construct fully
  # qualified method symbols like `iter$DoubleIt$it2_next`. Module names are
  # single identifiers (no `$`), so the module prefix is everything before
  # the FIRST `$` in base_name. For main-module specs, base_name has no `$`
  # module component and mod_prefix stays empty.
  var mod_prefix = ""
  var bn_len = str_byte_len(base_name)
  var first_dollar = -1
  for di in 0..bn_len
    if str_byte_at(base_name, di) == '$'
      first_dollar = di
      break
    end
  end
  if first_dollar > 0
    # Only treat as module prefix if there is content after it (not just
    # `$1` arity suffix on a main-module function). Heuristic: the character
    # after `$` must not be a digit, and there must be a non-digit segment.
    var after = str_byte_at(base_name, first_dollar + 1)
    if after < '0' or after > '9'
      mod_prefix = str_byte_slice(base_name, 0, first_dollar)
    end
  end
  ctx.mir_ctx_set_spec_current_module_prefix(mod_prefix)

  # Lower as a named function
  mir_lower_function_with_name(ctx, ast_store, func_handle, spec_name)

  # Phase 4D.5b: for async generators, also emit the `$poll` body. PASS 1.2a's
  # emission path uses `mir_lookup_function` which fails for spec names (they
  # aren't in `all_funcs`), so it never iterates them. Emit the poll directly
  # here while the spec context (param_types, current_module_prefix) is still
  # active — substitutions in the body lower correctly. The `mir_lower_function_with_name`
  # call above only emits the user-facing constructor (via the unified
  # `mir_lower_generator_effect` post-4D.5c.5); non-spec gens get their $poll
  # from PASS 1.2a's `mir_lower_async_poll` instead.
  #
  # Phase 4D.5c.3: also emit the `$new` constructor for async-gen specs.
  # The user-facing `<spec_name>` ctor (emitted by `mir_lower_generator_effect`
  # via `mir_lower_function_with_name` above) calls `__Future_<spec_name>$new(params)`
  # instead of inline-allocating the frame, so $new must exist for specs too.
  # PASS 1.3c (mir_lower.qz:4378) only iterates names in the async-target
  # registry, which uses `mir_lookup_function` for the AST handle — that fails
  # for spec names (they aren't in `all_funcs`). Emit $new directly here, in
  # the same way $poll is.
  var spec_ret_ann = ast::ast_get_str2(ast_store, func_handle)
  if str_byte_len(spec_ret_ann) >= 19
    if spec_ret_ann.starts_with("impl AsyncIterator<")
      mir_lower_gen::mir_lower_async_poll(ctx, ast_store, func_handle, spec_name)
      mir_lower_gen::mir_lower_async_constructor(ctx, ast_store, func_handle, spec_name)
    end
  end

  # Clear specialization context
  ctx.mir_ctx_clear_spec_param_types()
  ctx.mir_ctx_set_spec_current_type("")
  ctx.mir_ctx_set_spec_current_module_prefix("")

  # Pop from in-progress stack
  if ctx.generics.spec_in_progress.size > 0
    var _popped = __vec_pop_raw(ctx.generics.spec_in_progress)
  end
end

## A.36 — lower a monomorphized variant of a generic-struct extend-method.
## Unlike `mir_lower_specialized_function` (free generics, where the type-param
## bindings come from the function's own `<T>` and its argument types), the
## bindings here come from the *struct's* declared type params zipped against
## the receiver instantiation's concrete type args. e.g. for
## `extend ITLift<T> with ITGen do def itg_go(self) = @source.itg_go() + 1 end`
## called on `ITLift<ITBase>`, we emit `ITLift$itg_go$ITBase` with the binding
## {I → ITBase} (I being `struct ITLift<I>`'s param, the registered type of the
## `source` field). The body's `@source.itg_go()` then resolves through that
## binding to `ITBase$itg_go` instead of self-recursing into `ITLift$itg_go`.
def mir_lower_struct_method_spec(ctx: MirContext, base_name: String, arg_types: Vec, ast_store: ast::AstStorage, func_handle: AstNodeId, struct_name: String, tparam_csv: String): Void
  var spec_name = base_name
  var atc = arg_types.size
  for ati in 0..atc
    var type_str = as_string(arg_types[ati])
    if str_byte_len(type_str) > 0
      var flat = mir_flatten_type_for_symbol(type_str)
      spec_name = "#{spec_name}$#{flat}"
    end
  end

  # Cycle detection: skip if this specialization is already being lowered.
  var in_progress_stack = ctx.generics.spec_in_progress
  var ip_count = in_progress_stack.size
  for ipi in 0..ip_count
    if in_progress_stack[ipi].eq(spec_name)
      return
    end
  end
  ctx.generics.spec_in_progress.push(spec_name)

  # Build [struct_param_name → concrete_type] bindings, positionally.
  var param_names = mir::mir_struct_type_param_names(tparam_csv)
  var param_types = vec_new()
  var pn_count = param_names.size
  for pi in 0..pn_count
    if pi < atc
      var cn = as_string(arg_types[pi])
      if str_byte_len(cn) > 0
        var pt_entry = [as_int(as_string(param_names[pi])), as_int(cn)]
        param_types.push(pt_entry)
      end
    end
  end
  # item 32 — also bind under the EXTEND block's own type-param names, read off
  # `self`'s declared annotation (`extend ITLift<T>` ⇒ self: `ITLift<T>` ⇒ `T`).
  # The struct may declare `<I>` while the extend declares `<T>` over it; the body
  # references the EXTEND's names, so a binding keyed only by the struct's `<I>`
  # leaves `T` unresolved and `@field`'s NODE_FIELD_ACCESS infers `ITLift<T>`
  # (unresolved) ⇒ the §12.9 inline-value-layout branch never fires ⇒ a
  # value-layout field reached through a trait/method receiver does an extra
  # inttoptr+GEP+load on the inlined value ⇒ SIGSEGV. Both name-sets are
  # positionally aligned with `arg_types`. When extend names == struct names
  # (the universal compiler/stdlib case) this re-sets identical keys to identical
  # values ⇒ byte-identical IR; it only adds new bindings when the names differ.
  var self_params = ast::ast_get_left(ast_store, func_handle)
  if self_params >= 0 and vec_size(self_params) > 0
    var self_p0 = self_params[0]
    var self_ann = ast::ast_get_str2(ast_store, self_p0)
    var extend_names = mir::mir_type_args_of(self_ann)
    var en_count = extend_names.size
    for ei in 0..en_count
      if ei < atc
        var ecn = as_string(arg_types[ei])
        var ename = as_string(extend_names[ei])
        if str_byte_len(ecn) > 0 and str_byte_len(ename) > 0
          var ept_entry = [as_int(ename), as_int(ecn)]
          param_types.push(ept_entry)
        end
      end
    end
  end
  ctx.mir_ctx_set_spec_param_types(param_types)

  # spec_current_type / impl_current_type = the extended struct, so the
  # receiver-aware + A8/A8b dispatch machinery is active inside the body. Field
  # receivers whose declared type is a struct type param resolve through
  # spec_param_types; genuine self-calls fall back to this struct.
  ctx.mir_ctx_set_spec_current_type(struct_name)
  ctx.mir_ctx_set_impl_current_type(struct_name)

  # Module prefix only if base_name's first segment names a real module
  # (cross-module structs register as `module$Struct$method`). Unlike the
  # free-generic path we must NOT treat the struct name itself as a prefix.
  var mod_prefix = ""
  var first_dollar = __char_index(base_name, '$')
  if first_dollar > 0
    var first_seg = str_byte_slice(base_name, 0, first_dollar)
    if mir::mir_is_module_name(ctx, first_seg) == 1
      mod_prefix = first_seg
    end
  end
  ctx.mir_ctx_set_spec_current_module_prefix(mod_prefix)

  mir_lower_function_with_name(ctx, ast_store, func_handle, spec_name)

  ctx.mir_ctx_clear_spec_param_types()
  ctx.mir_ctx_set_spec_current_type("")
  ctx.mir_ctx_set_impl_current_type("")
  ctx.mir_ctx_set_spec_current_module_prefix("")

  if ctx.generics.spec_in_progress.size > 0
    var _popped = __vec_pop_raw(ctx.generics.spec_in_progress)
  end
end

## Emit all pending specializations queued during PASS 1.
## Processes the queue in a while loop since specializing one function
## can queue more specializations (cascading monomorphization).
## Uses the memo cache for O(1) deduplication, and a hard depth limit
## of 1000 as a safety net.
def mir_emit_pending_specializations(ctx: MirContext): Void
  var specs = ctx.mir_ctx_get_pending_specs()
  # Use index-based while loop instead of for-in range — new specs may be
  # appended during processing (e.g., both_scores<T,U> triggers get_score<T>
  # and get_score<U> specializations). The while loop drains the full queue.
  var i = 0
  while i < specs.size
    # Safety: abort if specialization count exceeds depth limit
    if i >= 1000
      break
    end
    var entry = specs[i]
    var base_name = entry.base_name
    var arg_types = entry.arg_types
    var ast_store = entry.ast_store
    var func_handle = entry.func_handle
    # Convert arg_types to Vec<String> if needed
    var types_vec = vec_new<String>()
    if as_int(arg_types) > 0
      var tc = vec_size(arg_types)
      for j in 0..tc
        types_vec.push(as_string(arg_types[j]))
      end
    end
    # Build spec name and check memo cache (O(1)).
    # MUST match the canonical mangling in mir_lower_specialized_function:
    # skip empty type components AND flatten parameterized types so the
    # memo key matches what eventually gets emitted as the LLVM symbol.
    var spec_name = base_name
    for vi in 0..types_vec.size
      var ts = types_vec[vi]
      if str_byte_len(ts) > 0
        var tflat = mir_flatten_type_for_symbol(ts)
        spec_name = "#{spec_name}$#{tflat}"
      end
    end
    # Lazy-init memo Map
    if ctx.generics.spec_memo == 0
      ctx.generics.spec_memo = map_new()
    end
    if map_has(ctx.generics.spec_memo, spec_name) == 0
      map_set(ctx.generics.spec_memo, spec_name, 1)
      # A.36: struct-method specs set `struct_name`/`type_params` (non-empty)
      # and route to the struct-aware lowering path; regular generics leave
      # them empty.
      if str_byte_len(entry.struct_name) > 0
        mir_lower_struct_method_spec(ctx, base_name, types_vec, ast_store, func_handle, entry.struct_name, entry.type_params)
      else
        mir_lower_specialized_function(ctx, base_name, types_vec, ast_store, func_handle)
      end
    end
    i += 1
  end
end

# ============================================================================
# Block lowering (moved from mir.qz)
# ============================================================================

def mir_lower_block(ctx: MirContext, s: ast::AstStorage, block_node: Int): Void
  defer_scope_push(ctx)
  var stmts = ast::ast_get_children(s, block_node)
  if stmts != 0
    each(stmts, stmt: Int -> ctx.mir_lower_stmt(s, stmt))
  end
  var cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(cur) < 0
    defer_scope_pop(ctx)
  else
    defer_scope_discard(ctx)
  end
end

# ============================================================================
# Expression lowering
# ============================================================================

# Helper: check if a field access expression resolves to a String-typed field
def mir_is_string_field_access(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var base = ast::ast_get_left(s, node)
  if base >= 0
    if ast::ast_get_kind(s, base) == node_constants::NODE_IDENT
      var obj_name = ast::ast_get_str1(s, base)
      var st = ctx.mir_ctx_get_var_type(obj_name)
      if str_byte_len(st) > 0
        var fn = ast::ast_get_str1(s, node)
        var ft = ctx.mir_ctx_get_field_type(st, fn)
        return 1 if ft == "String"
      end
    end
  end
  return 0
end

# Helper: check if a function call returns a String
def mir_is_string_call(s: ast::AstStorage, node: AstNodeId): Int
  var callee = ast::ast_get_left(s, node)
  if callee >= 0
    if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
      var cn = ast::ast_get_str1(s, callee)
      return 1 if cn == "as_string"
      return 1 if cn == "to_s"
      return 1 if cn == "to_string"
      return 1 if cn == "concat"
      return 1 if cn == "str_slice"
      return 1 if cn == "str_byte_slice"
      return 1 if cn == "str_substr"
      return 1 if cn == "str_from_int"
      return 1 if cn == "str_from_char"
      return 1 if cn == "str_from_bytes"
      return 1 if cn == "str_from_codepoint"
      return 1 if cn == "str_from_ptr"
      return 1 if cn == "str_downcase"
      return 1 if cn == "str_upcase"
      return 1 if cn == "str_trim"
      return 1 if cn == "str_trim_left"
      return 1 if cn == "str_trim_right"
      return 1 if cn == "str_replace"
      return 1 if cn == "str_reverse"
      return 1 if cn == "str_repeat"
      return 1 if cn == "str_concat"
      return 1 if cn == "str_join"
      return 1 if cn == "sb_to_string"
      return 1 if cn == "getenv"
      return 1 if cn == "read_file"
      return 1 if cn == "path_join"
    end
  end
  return 0
end

## Check if a call expression accesses a string element from a container.
## vec_get(v, i) where v is a string var → element is String
## Also handles vec_pop, vec_get_unchecked, map_get.
def mir_is_string_container_access(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var callee = ast::ast_get_left(s, node)
  if callee >= 0
    if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
      var fn_name = ast::ast_get_str1(s, callee)
      if fn_name == "vec_get" or fn_name == "vec_get_unchecked" or fn_name == "vec_pop" or fn_name == "map_get"
        var args = ast::ast_get_children(s, node)
        if args != 0
          if vec_size(args) > 0
            var recv = args[0]
            if ast::ast_get_kind(s, recv) == node_constants::NODE_IDENT
              var recv_name = ast::ast_get_str1(s, recv)
              # If receiver is marked as string var, its elements are strings
              return ctx.mir_ctx_is_string_var(recv_name)
            end
          end
        end
      end
    end
  end
  return 0
end

# Helper: recursively check if expression is string-typed
# Handles chained concatenations like "a#{b}c" -> ((a+b)+c) where left is NodeBinary
# Also handles string variables by checking string_vars set
def mir_is_string_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)
  return 1 if kind == node_constants::NODE_STRING_LIT
  return 1 if kind == node_constants::NODE_INTERP_STRING
  # NodeIdent = 6 - check if variable is known to be a string
  if kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(s, node)
    return ctx.mir_ctx_is_string_var(name)
  end
  # NodeBinary = 8 with op_constants$OP_ADD (0) - check if either operand is string
  if kind == node_constants::NODE_BINARY
    var op = ast::ast_get_op(s, node)
    if op == op_constants::OP_ADD
      var bin = ast::ast_extract_binary(s, node)
      var left = bin[0]
      var right = bin[1]
      return 1 if mir_is_string_expr(ctx, s, left)
      return 1 if mir_is_string_expr(ctx, s, right)
    end
  end
  # NodeCall = 9 - check if function is known to return String
  if kind == node_constants::NODE_CALL
    return 1 if mir_is_string_call(s, node)
    # Container element access: vec_get/map_get on string-element containers
    return 1 if mir_is_string_container_access(ctx, s, node)
    # Fallback: check user-defined function return type from AST
    var callee = ast::ast_get_left(s, node)
    if callee >= 0
      if ast::ast_get_kind(s, callee) == node_constants::NODE_IDENT
        var call_name = ast::ast_get_str1(s, callee)
        var resolved_name = mir_resolve_func_name(ctx, call_name)
        var func_entry = ctx.mir_lookup_function(resolved_name)
        if func_entry.is_some()
          var fe = func_entry.unwrap()
          var func_ast = fe.ast_store
          var func_handle = fe.node_id
          var ret_type = ast::ast_get_str2(func_ast, func_handle)
          if ret_type == "String"
            return 1
          end
        end
      end
    end
    # Fall through to universal fallback below — `mir_infer_expr_type`
    # now suffix-searches for cross-module qualified names (e.g.
    # `Style$render` typecheck-mangled callee resolving to the registered
    # `style$Style$render`), which the inline lookup above misses. Without
    # the fallthrough, `s.render(a) + s.render(b)` mis-typed both vars as
    # Int and emitted raw integer add (STYLE_RENDER_CONCAT_CORRUPTION).
  end
  # NodeFieldAccess = 15 - check if struct field is String-typed.
  # The fast path (mir_is_string_field_access) only recognises a plain-ident
  # base whose tracked type exact-matches the struct registry. When it says
  # "no" we must NOT return 0 — fall through to the universal mir_infer_expr_type
  # fallback below, which resolves chained/index bases (`args[0].text`) and
  # cross-module / generic-prefixed struct names. Without the fall-through,
  # `t.key == key` on a cross-module struct lowered to an integer pointer
  # compare instead of `str_eq`.
  if kind == node_constants::NODE_FIELD_ACCESS
    return 1 if mir_is_string_field_access(ctx, s, node) == 1
  end
  # NodeIndex = 13 - check if element of string-containing collection.
  # Two routes: (a) base is a string var (e.g. parts from str_split — chars/
  # split-result tracking), or (b) base is a Vec with String element type
  # tracked from `vec_new<String>()` / explicit `Vec<String>` annotation.
  # Route (b) is what makes `var label = labels[i]` followed by
  # `eputs("...#{label}...")` elide the parser-emitted `to_str(label)` —
  # without it, `to_str` runs at runtime and trips
  # PROFILE_ALLOC_TOP_N_VEC_STRING_HEISENBUG under arena pressure.
  if kind == node_constants::NODE_INDEX
    var base_node = ast::ast_get_left(s, node)
    if ast::ast_get_kind(s, base_node) == node_constants::NODE_IDENT
      var base_name = ast::ast_get_str1(s, base_node)
      var elem_t = ctx.mir_ctx_get_vec_elem_type(base_name)
      return 1 if elem_t == "String"
      return 1 if ctx.mir_ctx_is_string_var(base_name) == 1
    end
    # Non-ident base, or untracked ident: fall through to the universal
    # mir_infer_expr_type fallback rather than returning 0.
  end
  # Universal fallback: use the MIR type inference engine which resolves
  # function return types across module boundaries. This catches all cases
  # the heuristics above miss (e.g., cross-module function calls like
  # color_red("x") + msg where color_red is imported from another module).
  var inferred = ctx.mir_infer_expr_type(s, node)
  if inferred == "String"
    return 1
  end
  return 0
end

def mir_is_float_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  var kind = ast::ast_get_kind(s, node)
  return 1 if kind == node_constants::NODE_FLOAT_LIT
  # NodeIdent = 6 - check if variable is known to be a float
  if kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(s, node)
    return ctx.mir_ctx_is_float_var(name)
  end
  # NodeBinary = 8 - check if either operand is float
  if kind == node_constants::NODE_BINARY
    var bin = ast::ast_extract_binary(s, node)
    var left = bin[0]
    var right = bin[1]
    return 1 if mir_is_float_expr(ctx, s, left)
    return 1 if mir_is_float_expr(ctx, s, right)
  end
  # NodeUnary = 7 - check if operand is float (e.g. -3.14)
  if kind == node_constants::NODE_UNARY
    var operand = ast::ast_get_left(s, node)
    return mir_is_float_expr(ctx, s, operand)
  end
  # NodeIndex = 13 - `a[i]` into a Vec<F32>/Vec<F64> yields a float.
  # Without this, `var av = a[i]` never marks `av` as a float var, so a
  # later `av * b[i]` lowers to an integer `mul` instead of `fmul`.
  if kind == node_constants::NODE_INDEX
    var idx_base = ast::ast_get_left(s, node)
    if ast::ast_get_kind(s, idx_base) == node_constants::NODE_IDENT
      var idx_base_name = ast::ast_get_str1(s, idx_base)
      var idx_elem_t = ctx.mir_ctx_get_vec_elem_type(idx_base_name)
      if idx_elem_t == "F32" or idx_elem_t == "F64"
        return 1
      end
    end
    # Non-ident base or untracked elem type: fall through to the universal
    # mir_infer_expr_type fallback (handles `struct.vecfield[i]`, chained
    # index, cross-module Vec<F64> element types).
  end
  # NodeCall = 9 - check if called function returns F32/F64
  if kind == node_constants::NODE_CALL
    var call_callee = ast::ast_get_left(s, node)
    var callee_kind = ast::ast_get_kind(s, call_callee)
    if callee_kind == node_constants::NODE_IDENT
      var fname = ast::ast_get_str1(s, call_callee)
      # Known float-returning intrinsics
      if fname == "to_f32" or fname == "to_f64" or fname == "as_f64"
        return 1
      end
      # vec_get/vec_get_unchecked with F32/F64 element type returns float
      if fname == "vec_get" or fname == "vec_get_unchecked"
        var vec_elem_ann = ast::ast_get_str2(s, node)
        if vec_elem_ann == "F32" or vec_elem_ann == "F64"
          return 1
        end
        # Fallback: check first argument's vec elem type tracking
        if str_byte_len(vec_elem_ann) == 0
          var vg_args = ast::ast_get_children(s, node)
          if vg_args.size > 0
            var vg_first = vg_args[0]
            if ast::ast_get_kind(s, vg_first) == node_constants::NODE_IDENT
              var vg_name = ast::ast_get_str1(s, vg_first)
              var vg_elem = ctx.mir_ctx_get_vec_elem_type(vg_name)
              if vg_elem == "F32" or vg_elem == "F64"
                return 1
              end
            end
          end
        end
      end
      # Look up user function return type
      var func_entry = ctx.mir_lookup_function(fname)
      if func_entry.is_some()
        var fe = func_entry.unwrap()
        var func_s = fe.ast_store
        var func_node = fe.node_id
        var ret_ann = ast::ast_get_str2(func_s, func_node)
        if ret_ann == "F32" or ret_ann == "F64" or ret_ann == "Float"
          return 1
        end
      end
    end
  end
  # Universal fallback: consult the MIR type inference engine. This catches
  # struct/record F64 field access (`b.ev`), Vec<F64> element index, and
  # cross-module float-returning calls that the heuristics above miss.
  # Without this, `b.ev - b.sv` (two F64 struct fields) lowered to integer
  # `sub` of the IEEE-754 bit patterns instead of `fsub` — see HB-DOG.8.
  # Mirrors the same fallback `mir_is_string_expr` uses for String.
  var inferred = ctx.mir_infer_expr_type(s, node)
  if inferred == "F64" or inferred == "F32" or inferred == "Float"
    return 1
  end
  return 0
end

## P21: Emit fuel_check intrinsic for preemptive scheduling.
## Skips emission in async context (has suspend-based preemption), @no_preempt
## functions, and freestanding / kernel targets.
def mir_emit_fuel_check(ctx: MirContext): Void
  # Skip in async $poll context — already has suspend-based preemption
  if mir_lower_gen::mir_gen_is_active() >= 2
    return
  end
  # Skip if current function is @no_preempt
  var func = ctx.mir_ctx_get_func()
  if mir_func_is_no_preempt(func)
    return
  end
  # Skip for freestanding / kernel targets — BEAM-style reduction
  # counting is userspace-scheduler machinery; the kernel preempts via
  # timer interrupts. Leaving the instrumentation in place would emit
  # unresolved `@__qz_fuel_refill` + `@__qz_sched_fuel` references
  # because `cg_emit_runtime_decls` skips their definitions for
  # freestanding targets. See KERNEL_EPIC.md Discoveries (2026-04-18).
  if _mir_is_freestanding == 1
    return
  end
  var args = vec_new()
  ctx.mir_emit_intrinsic("fuel_check", args)
end

## Phase 2 P2.a: map a stateful effect name to its default-handler runtime
## symbol. Returns the C symbol name (without the `@` prefix) for codegen
## to emit as an install handler pointer. Empty string = no default
## registered for this effect (caller falls back to null handler, which
## routes to unhandled).
##
## This is a closed set of blessed stateful effects maintained by the
## compiler — adding a new one requires (a) declaring the effect in a
## stdlib module, (b) emitting the default handler in
## `codegen_runtime.qz::cg_emit_effect_runtime`, and (c) adding the name
## here. Non-stateful effects (Throws, Log, Async, Diag, ParseError)
## already install their defaults via `cg_emit_effect_main_prelude` and
## are matched on the effect stack by dynamic scan — they don't route
## through this helper.
def _mir_default_handler_for_effect(eff_name: String): String
  return "__qz_default_state_handler" if eff_name.eq("State")
  return "__qz_default_reader_handler" if eff_name.eq("Reader")
  return ""
end

# B.0c — method-dispatch registry for `with EffectName.method(arg) do ... end`.
# Pushes (op_filter_int, handler_fn_int) pairs into `entries` for each op
# of `eff_name` that the named method should bind. For Alloc.in_arena, this
# means installing both `alloc` and `dealloc` to the env-aware arena
# handlers; the call's first arg becomes the env (arena handle) accessible
# via __qz_effect_state_get() inside each handler. Handler-name resolution
# uses mir_resolve_func_name so mangled stdlib names link correctly.
def _mir_method_dispatch_entries(ctx: MirContext, eff_name: String, method_name: String, entries: Vec<Int>): Void
  if eff_name.eq("Alloc")
    if method_name.eq("in_arena")
      var alloc_h = mir_resolve_func_name(ctx, "arena_alloc_handler_e")
      var dealloc_h = mir_resolve_func_name(ctx, "arena_dealloc_handler_e")
      entries.push(as_int("alloc"))
      entries.push(as_int(alloc_h))
      entries.push(as_int("dealloc"))
      entries.push(as_int(dealloc_h))
      return
    end
    # B.3 — `with Alloc.deny_all() do ... end` sandbox handler. Stateless
    # (no env): every alloc throws via Throws; dealloc forwards to mem_free
    # so caller may free pre-sandbox allocations. Uses A.5's existing
    # deny_*_handler functions directly — no `_e` suffix variant needed.
    if method_name.eq("deny_all")
      var alloc_h = mir_resolve_func_name(ctx, "deny_alloc_handler")
      var dealloc_h = mir_resolve_func_name(ctx, "deny_dealloc_handler")
      entries.push(as_int("alloc"))
      entries.push(as_int(alloc_h))
      entries.push(as_int("dealloc"))
      entries.push(as_int(dealloc_h))
      return
    end
    # B.4 — `with Alloc.with_budget(N) do ... end` budget-tracked handler.
    # Single-slot remaining-budget pattern: state_slot[i] tracks bytes
    # remaining; each alloc decrements via state_set; throws when request
    # exceeds remaining. Init env (the user's budget arg) becomes the
    # initial remaining. Dealloc is a no-op for budget purposes (we
    # track cumulative allocation, not live bytes — same semantics as
    # A.5's counter_*_handler).
    if method_name.eq("with_budget")
      var alloc_h = mir_resolve_func_name(ctx, "budget_alloc_handler_e")
      var dealloc_h = mir_resolve_func_name(ctx, "budget_dealloc_handler_e")
      entries.push(as_int("alloc"))
      entries.push(as_int(alloc_h))
      entries.push(as_int("dealloc"))
      entries.push(as_int(dealloc_h))
      return
    end
  end
  # Unrecognized (eff, method): leave entries empty so codegen treats this
  # as an unrecognized handler shape (no install emitted, body still runs
  # but routes to outer handlers / blessed defaults).
end

## Phase E.1.b: gate for auto-arena around `go fn(args)` (named-function
## form). Phase E.4.a (slice 1) extends to cover String returns; slice 2
## extends to `Vec<value-typed-T>` returns via `arena_promote_vec_value`.
## Slices 3-4 add struct + Vec<reference-typed> support. Lambda forms
## (`go (-> ...)()`, `go do ... end`) intentionally skip this gate so
## `go_arena(f)`'s inner `go (-> body)` doesn't double-wrap; users opt
## in via `go_arena(f)` for lambdas.
def _mir_is_value_typed_annotation(ann: String): Bool
  return ann.eq("Int") or ann.eq("Bool") or ann.eq("Void") or ann.eq("Float") or ann.eq("Char") or ann.eq("CPtr") or ann.eq("Symbol") or ann.eq("Nil") or ann.eq("Int8") or ann.eq("Int16") or ann.eq("Int32") or ann.eq("Int64") or ann.eq("UInt8") or ann.eq("UInt16") or ann.eq("UInt32") or ann.eq("UInt64") or ann.eq("Float32") or ann.eq("Float64") or ann.eq("")
end

## Subset of value-typed annotations whose Vec storage uses 8-byte element
## slots (the default). Excludes narrow-element types (Bool/I8/U8 = 1 byte;
## I16/U16 = 2 bytes; I32/U32/F32 = 4 bytes) because their Vec layout is
## width-specialized — see `shared/elem_width.qz:elem_byte_width`. Slice 2
## of E.4.a covers only `Vec<8-byte-element>`; narrow-element Vec returns
## fall through to libc-heap fallback until a width-aware promote helper
## ships (slice 2.b or slice 4).
def _mir_is_8byte_value_typed_annotation(ann: String): Bool
  return ann.eq("Int") or ann.eq("Float") or ann.eq("Char") or ann.eq("CPtr") or ann.eq("Symbol") or ann.eq("Nil") or ann.eq("Int64") or ann.eq("UInt64") or ann.eq("Float64") or ann.eq("Void") or ann.eq("")
end

## Extract the element-type annotation from a `Vec<X>` return-type string
## as the parser produces it (literal source-text form). Returns "" if the
## annotation is not a Vec generic or is malformed.
def _mir_extract_vec_elem_ann(ann: String): String
  if not ann.starts_with("Vec<")
    return ""
  end
  if not ann.ends_with(">")
    return ""
  end
  return str_byte_slice(ann, 4, str_byte_len(ann) - 1)
end

## Phase E.4.a slice 3.b: classify a single struct-field annotation
## `field_ann` for the per-struct mixed-field walker. Returns
## `[supported, kind, aux]` — supported=1 means the field can be
## promoted by `arena_promote_struct_mixed`; supported=0 means the
## whole struct is rejected (gate falls through to libc-heap fallback).
##
## Field kinds in the descriptor (encoded into the layout Vec the
## synthesizer builds at runtime):
##   0 = value-typed i64 (Int/Bool/Char/Float/Symbol/Nil/CPtr/...) —
##       slot copied verbatim, no promote needed.
##   2 = String — call arena_promote_string per slot.
##   4 = uniform-value-field nested struct — call
##       arena_promote_struct_value(slot, aux) with aux=slot_count.
## Unsupported (returns supported=0):
##   - narrow-fixed-width (I8/I16/I32/U8/U16/U32/CInt/CChar)
##   - Vec<T> fields (deferred — slice 5+; needs per-field as_vec
##     coercion, same blocker as slice 4's nested-Vec elements)
##   - mixed-field nested struct (recursive slice 3.b would be needed)
##   - Map/Option/Result/Future/function-pointer/enum-with-payload
##   - any annotation that doesn't resolve into the above categories
def _mir_classify_struct_field(ctx: MirContext, field_ann: String): Vec<Int>
  var out = vec_new<Int>()
  out.push(0)  # supported
  out.push(0)  # kind
  out.push(0)  # aux
  if str_byte_len(field_ann) == 0
    return out
  end
  if mir_is_narrow_fixed_width(field_ann) == 1
    return out
  end
  if _mir_is_value_typed_annotation(field_ann)
    out[0] = 1
    return out
  end
  if field_ann.eq("String")
    out[0] = 1
    out[1] = 2
    return out
  end
  if field_ann.starts_with("Vec<")
    return out
  end
  var slot_count = _mir_struct_uniform_value_slot_count(ctx, field_ann)
  if slot_count > 0
    out[0] = 1
    out[1] = 4
    out[2] = slot_count
    return out
  end
  return out
end

## Phase E.4.a slice 3.b: build the per-struct descriptor for
## `arena_promote_struct_mixed`. Returns a flat Vec<Int> shaped as
## `[n_fields, kind_0, aux_0, kind_1, aux_1, ..., kind_{N-1}, aux_{N-1}]`.
## Returns an empty Vec if any field is unsupported (caller's gate
## treats that as fall-through). Returns an empty Vec if `struct_name`
## has no fields or isn't registered. Reject criteria are the union of
## `_mir_classify_struct_field`'s rejections.
##
## The descriptor is then emitted at runtime by the synthesizer (via
## a `vec_new()` + per-field `push` chain) and passed to
## `arena_promote_struct_mixed(r, layout)`. Constructing the descriptor
## per goroutine call is small and predictable; future optimization
## could cache descriptors per struct type, but the dynamic approach
## avoids per-struct walker function emission entirely.
def _mir_struct_mixed_field_layout(ctx: MirContext, struct_name_ann: String): Vec<Int>
  var empty = vec_new<Int>()
  if str_byte_len(struct_name_ann) == 0
    return empty
  end
  var struct_name = mir_resolve_struct_name(ctx, struct_name_ann)
  var fields_info = mir_ctx_get_struct_fields(ctx, struct_name)
  if fields_info.is_none()
    return empty
  end
  # item 36 — a value-layout struct (explicit @value OR flip-eligible plain) is
  # stack/inline-laid-out, not a heap-boxed struct, so it never needs the boxed
  # mixed-field GC layout. Route through the single layout key. Gate-0 inert ⇒
  # byte-identical (reduces to the old @value-only test pre-flip).
  if mir::mir_is_value_layout_type(ctx, struct_name) == 1
    return empty
  end
  var field_types = fields_info.unwrap().field_types
  var ft_count = vec_size(field_types)
  if ft_count <= 0
    return empty
  end
  var layout = vec_new<Int>()
  layout.push(ft_count)
  var has_non_value_field = false
  for j in 0..ft_count
    var ft = field_types[j]
    var c = _mir_classify_struct_field(ctx, ft)
    if c[0] == 0
      return empty
    end
    if c[1] != 0
      has_non_value_field = true
    end
    layout.push(c[1])
    layout.push(c[2])
  end
  # If every field is kind=0 (pure value-typed), slice 3.a should have
  # already handled this struct. Gate ordering ensures we reach slice
  # 3.b only when 3.a's predicate falls through (some non-value field
  # exists), so this guard is defensive.
  if not has_non_value_field
    return empty
  end
  return layout
end

## Phase E.4.a slice 4: classify a `Vec<T>` element annotation `elem_ann`
## into a (elem_kind, elem_aux) pair for use by `arena_promote_vec_ref`'s
## inner dispatch. Returns [0, 0] if the element type isn't supported by
## any per-element promote (caller falls through to libc-heap fallback).
##
## Element kinds:
##   2 = String              → call arena_promote_string per element
##   3 = Vec<8-byte-value-prim> → call arena_promote_vec_value per element
##                                (one level of nesting; deeper nesting
##                                rejected — keeps recursion bounded).
##   4 = uniform-value-field struct → call arena_promote_struct_value
##                                    per element with slot_count = elem_aux
def _mir_classify_vec_element(ctx: MirContext, elem_ann: String, found_promote_string: Bool, found_promote_vec_value: Bool, found_promote_struct_value: Bool): Vec<Int>
  var out = vec_new<Int>()
  out.push(0)
  out.push(0)
  if str_byte_len(elem_ann) == 0
    return out
  end
  if elem_ann.eq("String") and found_promote_string
    out[0] = 2
    return out
  end
  # Nested `Vec<U>` element: only if U is itself a primitive 8-byte-value.
  # Deeper nesting (`Vec<Vec<Vec<Int>>>`) is explicitly rejected; user
  # falls through to libc-heap fallback. Keeps recursion bounded at 1 level.
  if elem_ann.starts_with("Vec<") and found_promote_vec_value
    var inner_ann = _mir_extract_vec_elem_ann(elem_ann)
    if str_byte_len(inner_ann) > 0 and _mir_is_8byte_value_typed_annotation(inner_ann)
      out[0] = 3
      return out
    end
  end
  if found_promote_struct_value
    var elem_slot_count = _mir_struct_uniform_value_slot_count(ctx, elem_ann)
    if elem_slot_count > 0
      out[0] = 4
      out[1] = elem_slot_count
      return out
    end
  end
  return out
end

## Returns auto-arena promote info as a 3-element Vec [kind, aux1, aux2]:
##   kind = 0 → skip (no auto-arena)
##   kind = 1 → value-typed (no promote needed); aux1 = 0; aux2 = 0
##   kind = 2 → String (call `arena_promote_string(r)`); aux1 = 0; aux2 = 0
##   kind = 3 → Vec<8-byte-element-T> (call `arena_promote_vec_value(r)`);
##              aux1 = 0; aux2 = 0 — slice 2's primitive fast-path.
##   kind = 4 → uniform-value-field struct
##              (call `arena_promote_struct_value(r, slot_count)`);
##              aux1 = slot_count; aux2 = 0
##   kind = 5 → Vec<reference-typed-T> needing per-element promote
##              (call `arena_promote_vec_ref(r, elem_kind, elem_aux)` —
##              slice 4's polymorphic dispatcher);
##              aux1 = elem_kind (2=String, 3=nested Vec<value-prim>,
##                                4=uniform-value-field struct);
##              aux2 = elem_aux (slot_count when elem_kind=4; 0 otherwise).
##   kind = 6 → mixed-field struct (call
##              `arena_promote_struct_mixed(r, layout_vec)` with a
##              runtime-constructed descriptor); aux1, aux2 unused —
##              the synthesizer builds the descriptor via vec_new+push
##              chains keyed by struct-field annotations.
## (Kept for future expansion; not currently a separate kind: per-struct
## walker emission with cycle detection.)
## The caller passes [kind, aux1, aux2] to `_mir_synthesize_arena_wrap`
## so the synthesized AST can route the result through the right per-type
## promote-fn before `arena_destroy`.
def _mir_should_auto_arena(ctx: MirContext, s: ast::AstStorage, inner_call: AstNodeId): Vec<Int>
  var info = vec_new<Int>()
  info.push(0)
  info.push(0)
  info.push(0)
  if inner_call < 0
    return info
  end
  if ast::ast_get_kind(s, inner_call) != node_constants::NODE_CALL
    return info
  end
  var callee = ast::ast_get_left(s, inner_call)
  if callee < 0
    return info
  end
  if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
    return info
  end
  var fn_name = ast::ast_get_str1(s, callee)
  var entry_opt = mir_lookup_function(ctx, fn_name)
  if entry_opt.is_none()
    return info
  end
  var entry = entry_opt.unwrap()
  # Auto-arena requires the env-aware handlers from std/alloc to be in the
  # import graph; without them, codegen would emit dangling references to
  # `@arena_alloc_handler_e`. Programs that don't import std/alloc keep
  # current behavior (libc heap). Until the handlers move into runtime IR
  # (always-emitted), this is the import-level opt-in.
  # Suffix-search because the symbol is module-prefixed (`alloc$arena_alloc_handler_e`).
  # Phase E.4.a slice 1: also probe for `arena_promote_string` (kind=2).
  # Phase E.4.a slice 2: also probe for `arena_promote_vec_value` (kind=3).
  # Phase E.4.a slice 3.a: also probe for `arena_promote_struct_value` (kind=4).
  # Phase E.4.a slice 4: also probe for `arena_promote_vec_ref` (kind=5).
  var all_funcs = mir_ctx_get_all_funcs(ctx)
  var found_arena_handler = false
  var found_arena_acquire = false
  var found_promote_string = false
  var found_promote_vec_value = false
  var found_promote_struct_value = false
  var found_promote_vec_ref = false
  var found_promote_struct_mixed = false
  if all_funcs != 0
    var af_count = all_funcs.size
    for af_i in 0..af_count
      var af_entry = all_funcs[af_i]
      if af_entry.tag == 0
        if af_entry.name.eq("arena_alloc_handler_e") or af_entry.name.ends_with("$arena_alloc_handler_e")
          found_arena_handler = true
        end
        # Phase E.7: synthesizer emits `arena_acquire(8192)` / `arena_release(ar)`
        # in place of `arena_new` / `arena_destroy`. These live in std/alloc.qz
        # alongside the handler, so this gate is normally satisfied together
        # with `found_arena_handler` — but a user who hand-rolls their own
        # `arena_alloc_handler_e` without importing std/alloc would break the
        # synthesized AST without this check.
        if af_entry.name.eq("arena_acquire") or af_entry.name.ends_with("$arena_acquire")
          found_arena_acquire = true
        end
        if af_entry.name.eq("arena_promote_string") or af_entry.name.ends_with("$arena_promote_string")
          found_promote_string = true
        end
        if af_entry.name.eq("arena_promote_vec_value") or af_entry.name.ends_with("$arena_promote_vec_value")
          found_promote_vec_value = true
        end
        if af_entry.name.eq("arena_promote_struct_value") or af_entry.name.ends_with("$arena_promote_struct_value")
          found_promote_struct_value = true
        end
        if af_entry.name.eq("arena_promote_vec_ref") or af_entry.name.ends_with("$arena_promote_vec_ref")
          found_promote_vec_ref = true
        end
        if af_entry.name.eq("arena_promote_struct_mixed") or af_entry.name.ends_with("$arena_promote_struct_mixed")
          found_promote_struct_mixed = true
        end
      end
    end
  end
  if not found_arena_handler
    return info
  end
  if not found_arena_acquire
    return info
  end
  var ret_ann = ast::ast_get_str2(entry.ast_store, entry.node_id)
  if _mir_is_value_typed_annotation(ret_ann)
    info[0] = 1
    return info
  end
  if ret_ann.eq("String") and found_promote_string
    info[0] = 2
    return info
  end
  if found_promote_vec_value
    var elem_ann = _mir_extract_vec_elem_ann(ret_ann)
    if str_byte_len(elem_ann) > 0 and _mir_is_8byte_value_typed_annotation(elem_ann)
      info[0] = 3
      return info
    end
  end
  if found_promote_struct_value
    var struct_slot_count = _mir_struct_uniform_value_slot_count(ctx, ret_ann)
    if struct_slot_count > 0
      info[0] = 4
      info[1] = struct_slot_count
      return info
    end
  end
  # Phase E.4.a slice 4: Vec<reference-typed-T> needing per-element promote.
  # Falls through from kind=3's primitive fast-path; classifier returns the
  # element's promote-kind (2=String, 3=nested-Vec, 4=uniform-struct) and
  # any per-element aux (slot_count for struct elements).
  if found_promote_vec_ref
    var ref_elem_ann = _mir_extract_vec_elem_ann(ret_ann)
    if str_byte_len(ref_elem_ann) > 0
      var ek_info = _mir_classify_vec_element(ctx, ref_elem_ann, found_promote_string, found_promote_vec_value, found_promote_struct_value)
      var ek_kind = ek_info[0]
      var ek_aux = ek_info[1]
      if ek_kind > 0
        info[0] = 5
        info[1] = ek_kind
        info[2] = ek_aux
        return info
      end
    end
  end
  # Phase E.4.a slice 3.b: mixed-field struct returns. Slice 3.a already
  # handled uniform-value-field structs (kind=4); 3.b extends to structs
  # with at least one String / uniform-nested-struct field. Layout
  # builder returns empty Vec if any field is unsupported (Vec/narrow/
  # mixed-nested/etc.) — fall through to libc-heap fallback.
  if found_promote_struct_mixed
    var mixed_layout = _mir_struct_mixed_field_layout(ctx, ret_ann)
    if mixed_layout.size > 0
      info[0] = 6
      # aux1/aux2 unused for kind=6 — the synthesizer builds the
      # descriptor at runtime from struct registry info, which it can
      # re-look-up from the call's return-type annotation. We thread
      # the descriptor IDX via aux1 = AST handle of the layout literal
      # would be cleaner; instead we re-resolve the layout at synth time.
      return info
    end
  end
  return info
end

## If `ret_ann` resolves to a registered struct whose fields are all
## non-narrow value-typed, return the field count (= i64 slot count for the
## heap layout). Otherwise return 0. Reject criteria:
##   - struct not registered
##   - any field is narrow-fixed-width (I8/I16/I32/U8/U16/U32/CInt/CChar) —
##     would corrupt under slot-by-slot i64 copy
##   - any field is a non-value-typed annotation (String/Vec/struct/etc) —
##     slice 3.b territory
##   - struct is @value (stack-allocated; doesn't go through heap promote path)
def _mir_struct_uniform_value_slot_count(ctx: MirContext, ret_ann: String): Int
  if str_byte_len(ret_ann) == 0
    return 0
  end
  var struct_name = mir_resolve_struct_name(ctx, ret_ann)
  var fields_info = mir_ctx_get_struct_fields(ctx, struct_name)
  if fields_info.is_none()
    return 0
  end
  # item 36 — a value-layout struct (explicit @value OR flip-eligible plain) is
  # stack-allocated and never goes through the heap-promote path, so it has no
  # uniform-value-slot heap-promote analysis. Single layout key; gate-0 inert ⇒
  # byte-identical (reduces to the old @value-only test pre-flip).
  if mir::mir_is_value_layout_type(ctx, struct_name) == 1
    return 0
  end
  var field_types = fields_info.unwrap().field_types
  var ft_count = vec_size(field_types)
  if ft_count <= 0
    return 0
  end
  for j in 0..ft_count
    var ft = field_types[j]
    if mir_is_narrow_fixed_width(ft) == 1
      return 0
    end
    if not _mir_is_value_typed_annotation(ft)
      return 0
    end
  end
  return ft_count
end

## Synthesize the arena-wrap AST so the existing go-lambda lowering
## machinery handles per-task-arena setup/teardown without any new MIR
## codegen. Mirrors `_go_arena_body` in `std/concurrency.qz`:
##
##   (lambda () {
##     var ar = arena_new(8192)
##     var r = -1
##     var panicked = 1
##     with Alloc.in_arena(ar) do ->
##       with Throws { throw: __qz_arena_panic_rec } do ->
##         r = orig_call
##         panicked = 0                              # only reached if no panic
##         0
##       end
##       0
##     end
##     if panicked == 1                              # E.4.b: panic path
##       arena_destroy(ar)
##       return -1                                   # panic sentinel
##     end
##     # var p = arena_promote_<T>(r [, aux])        # only when kind != 1
##     arena_destroy(ar)
##     return r_or_p
##   })()
##
## The `Alloc$in_arena` IDENT shape matches what the parser emits for
## `Alloc.in_arena(...)` (PascalCase field-access squash, see
## `feedback_pascalcase_field_squash.md`). The block-form WITH body
## (NODE_BLOCK containing only the original call) lowers as
## `mir_lower_block_expr` and yields the call's value.
##
## **Phase E.4.b (2026-04-28) — panic-path arena cleanup.** Without an
## inner Throws frame, a panic from `orig_call` unwinds through
## `with Alloc.in_arena` and the `arena_destroy(ar)` is bypassed → arena
## leak proportional to panic count. The fix nests
## `with Throws { throw: __qz_arena_panic_rec }` INSIDE
## `with Alloc.in_arena(ar)` so that:
##   1. `throw(...)` longjmps to the inner Throws's `wb.catch` (one
##      level up from the throw site, still inside Alloc's body).
##   2. The inner Throws's `wb.done` pops its single entry cleanly.
##   3. Control resumes in the outer Alloc body, which completes normally
##      and runs Alloc's `wb.done` — popping its 2 entries cleanly. NO
##      effect-stack leak (which would corrupt the next goroutine on the
##      same worker, observed empirically as a SIGSEGV on iteration 2 of
##      a panic-recover loop).
##   4. Lambda checks `panicked` flag, runs `arena_destroy`, returns the
##      `-1` panic sentinel that `panic_caught` already uses pre-fix.
##
## Re-throwing across the goroutine boundary into the parent's
## `with Throws` setjmp would be a cross-stack longjmp and abort the
## process; the sentinel return matches existing await-side semantics.
## The panic *message* is captured into `_qz_arena_panic_msg`
## (`std/alloc.qz`) for diagnostic use but is not auto-propagated.
##
## `kind` is the promote-kind from `_mir_should_auto_arena` (1=value,
## 2=String, 3=Vec<value-typed>, 4=uniform-value-field struct,
## 5=Vec<reference-typed> via slice 4's polymorphic `arena_promote_vec_ref`).
## `aux1` and `aux2` carry per-kind auxiliary scalars:
##   kind=4: aux1 = struct slot_count, aux2 = 0
##   kind=5: aux1 = element kind (2/3/4), aux2 = element aux (slot_count
##                                                            for elem_kind=4)
##   other kinds: aux1 = aux2 = 0.
## The promote call deliberately runs OUTSIDE the `with Alloc.in_arena`
## block so the allocation routes through the parent's installed `Alloc`
## (the snapshot from E.1.c.b is still active here per Q6 of the E.4
## design memo).
def _mir_synthesize_arena_wrap(ctx: MirContext, s: ast::AstStorage, orig_call: AstNodeId, kind: Int, aux1: Int, aux2: Int): AstNodeId
  var line = ast::ast_get_line(s, orig_call)
  var col = ast::ast_get_col(s, orig_call)

  var ar_var = "__qz_go_arena_h"
  var r_var = "__qz_go_arena_r"
  var panicked_var = "__qz_go_arena_panicked"
  var p_var = "__qz_go_arena_p"

  # var ar = arena_acquire(8192)
  # Phase E.7: route through the per-worker TLS arena pool (LIFO, cap=64).
  # `arena_acquire` pops a previously-released arena (after `arena_reset`)
  # if the pool is non-empty, else falls back to `arena_new(8192)`. Same
  # observable shape as the pre-E.7 `arena_new(8192)` call; net effect is
  # amortizing the mmap syscall pair across high-churn task spawning.
  var arena_new_callee = ast::ast_ident(s, "arena_acquire", line, col)
  var arena_new_args = vec_new()
  arena_new_args.push(ast::ast_int_lit(s, 8192, line, col))
  var arena_new_call = ast::ast_call(s, arena_new_callee, arena_new_args, line, col)
  var ar_let = ast::ast_let(s, ar_var, "", arena_new_call, 1, line, col)

  # var r = -1; var panicked = 1   — defaults reflect "body panicked"; the
  # in-body assignments only fire if orig_call returns normally.
  var r_let = ast::ast_let(s, r_var, "", ast::ast_int_lit(s, -1, line, col), 1, line, col)
  var panicked_let = ast::ast_let(s, panicked_var, "", ast::ast_int_lit(s, 1, line, col), 1, line, col)

  # Inner: `with Throws { throw: __qz_arena_panic_rec } do -> r = orig_call;
  # panicked = 0; 0 end`. On panic, the Throws's wb.done pops cleanly,
  # then control resumes in the surrounding Alloc body. Critical: this
  # ordering ensures Alloc's wb.done ALSO runs to pop its 2 entries —
  # without that, a panic-recover loop accumulates leaked Alloc entries
  # and crashes on iteration 2.
  var r_assign = ast::ast_assign(s, r_var, orig_call, line, col)
  var panicked_assign = ast::ast_assign(s, panicked_var, ast::ast_int_lit(s, 0, line, col), line, col)
  var with_throws_body_stmts = vec_new()
  with_throws_body_stmts.push(r_assign)
  with_throws_body_stmts.push(panicked_assign)
  with_throws_body_stmts.push(ast::ast_int_lit(s, 0, line, col))
  var with_throws_body = ast::ast_block(s, with_throws_body_stmts, line, col)

  # Throws { throw: __qz_arena_panic_rec }  — NODE_STRUCT_INIT
  var throws_field_handlers = vec_new()
  throws_field_handlers.push(ast::ast_ident(s, "__qz_arena_panic_rec", line, col))
  var throws_field_names = vec_new<Int>()
  throws_field_names.push(as_int("throw"))
  var throws_handler_node = ast::ast_struct_init(s, "Throws", throws_field_handlers, throws_field_names, line, col)
  var with_throws_node = ast::ast_with(s, throws_handler_node, with_throws_body, line, col)

  # Outer: `with Alloc.in_arena(ar) do -> with-throws-block; 0 end`.
  var alloc_in_arena_callee = ast::ast_ident(s, "Alloc$in_arena", line, col)
  var with_alloc_handler_args = vec_new()
  with_alloc_handler_args.push(ast::ast_ident(s, ar_var, line, col))
  var with_alloc_handler = ast::ast_call(s, alloc_in_arena_callee, with_alloc_handler_args, line, col)
  var with_alloc_body_stmts = vec_new()
  with_alloc_body_stmts.push(with_throws_node)
  with_alloc_body_stmts.push(ast::ast_int_lit(s, 0, line, col))
  var with_alloc_body = ast::ast_block(s, with_alloc_body_stmts, line, col)
  var with_alloc_node = ast::ast_with(s, with_alloc_handler, with_alloc_body, line, col)

  # if panicked == 1 { arena_destroy(ar); return -1 } end
  var panicked_eq_1 = ast::ast_binary(
    s,
    ast::ast_ident(s, panicked_var, line, col),
    op_constants::OP_EQ,
    ast::ast_int_lit(s, 1, line, col),
    line,
    col
  )
  var panic_destroy_args = vec_new()
  panic_destroy_args.push(ast::ast_ident(s, ar_var, line, col))
  var panic_destroy_call = ast::ast_call(
    s,
    ast::ast_ident(s, "arena_release", line, col),
    panic_destroy_args,
    line,
    col
  )
  # Return -1 (panic sentinel) — matches `panic_caught`'s pre-fix
  # contract. Cross-stack longjmp into the parent's setjmp is unsafe.
  var panic_return = ast::ast_return(s, ast::ast_int_lit(s, -1, line, col), line, col)
  var panic_then_stmts = vec_new()
  panic_then_stmts.push(panic_destroy_call)
  panic_then_stmts.push(panic_return)
  var panic_then_block = ast::ast_block(s, panic_then_stmts, line, col)
  var panic_if = ast::ast_if(s, panicked_eq_1, panic_then_block, -1, line, col)

  # Success path: optional promote, then arena_destroy + return r_or_p.
  # kind=2 (String) / kind=3 (Vec<value>) / kind=4 (uniform-value struct) /
  # kind=5 (Vec<reference-typed> via polymorphic arena_promote_vec_ref) /
  # kind=6 (mixed-field struct via arena_promote_struct_mixed +
  #         runtime-built descriptor).
  var p_let = -1
  var return_var_name = r_var
  var promote_fn_name = ""
  if kind == 2
    promote_fn_name = "arena_promote_string"
  end
  if kind == 3
    promote_fn_name = "arena_promote_vec_value"
  end
  if kind == 4
    promote_fn_name = "arena_promote_struct_value"
  end
  if kind == 5
    promote_fn_name = "arena_promote_vec_ref"
  end
  if kind == 6
    promote_fn_name = "arena_promote_struct_mixed"
  end
  # kind=6 stmts that build the descriptor Vec at runtime; emitted
  # BEFORE the promote call site so the layout var is in scope.
  var layout_stmts = vec_new()
  var layout_var = "__qz_go_arena_layout"
  if kind == 6
    # Look up the struct layout from the orig_call's return-type
    # annotation. The gate already validated this returns a non-empty
    # layout; we re-resolve here so the synthesizer doesn't need an
    # extra parameter to thread the layout through.
    var orig_callee = ast::ast_get_left(s, orig_call)
    var orig_fn_name = ast::ast_get_str1(s, orig_callee)
    # The gate (above) already validated this lookup succeeds; .unwrap() makes
    # that invariant explicit (panics loudly if ever violated, vs. the prior
    # silent deref of a 0 sentinel).
    var orig_entry = mir_lookup_function(ctx, orig_fn_name).unwrap()
    var ret_ann_for_layout = ast::ast_get_str2(orig_entry.ast_store, orig_entry.node_id)
    var k6_layout = _mir_struct_mixed_field_layout(ctx, ret_ann_for_layout)
    # var layout = vec_new()
    var k6_vec_new_callee = ast::ast_ident(s, "vec_new", line, col)
    var k6_no_args = vec_new()
    var k6_vec_new_call = ast::ast_call(s, k6_vec_new_callee, k6_no_args, line, col)
    var k6_layout_let = ast::ast_let(s, layout_var, "", k6_vec_new_call, 1, line, col)
    layout_stmts.push(k6_layout_let)
    # For each entry in k6_layout, emit `layout.push(entry_value)`.
    # k6_layout's structure: [n_fields, k_0, a_0, k_1, a_1, ...].
    var k6_li = 0
    while k6_li < k6_layout.size
      var k6_val = k6_layout[k6_li]
      var k6_push_callee_inner = ast::ast_ident(s, layout_var, line, col)
      # Build `layout.push(k6_val)` — UFCS method call on layout var.
      # This parses as a NODE_METHOD_CALL or NODE_CALL with receiver
      # squashed in. Use vec_push() function-call form for reliability:
      # `vec_push(layout, k6_val)`.
      var k6_push_callee = ast::ast_ident(s, "vec_push", line, col)
      var k6_push_args = vec_new()
      k6_push_args.push(ast::ast_ident(s, layout_var, line, col))
      k6_push_args.push(ast::ast_int_lit(s, k6_val, line, col))
      var k6_push_call = ast::ast_call(s, k6_push_callee, k6_push_args, line, col)
      layout_stmts.push(k6_push_call)
      k6_li = k6_li + 1
    end
  end
  if str_byte_len(promote_fn_name) > 0
    var promote_callee = ast::ast_ident(s, promote_fn_name, line, col)
    var promote_args = vec_new()
    promote_args.push(ast::ast_ident(s, r_var, line, col))
    if kind == 4
      promote_args.push(ast::ast_int_lit(s, aux1, line, col))
    end
    if kind == 5
      promote_args.push(ast::ast_int_lit(s, aux1, line, col))
      promote_args.push(ast::ast_int_lit(s, aux2, line, col))
    end
    if kind == 6
      promote_args.push(ast::ast_ident(s, layout_var, line, col))
    end
    var promote_call = ast::ast_call(s, promote_callee, promote_args, line, col)
    p_let = ast::ast_let(s, p_var, "", promote_call, 1, line, col)
    return_var_name = p_var
  end

  var destroy_callee = ast::ast_ident(s, "arena_release", line, col)
  var destroy_args = vec_new()
  destroy_args.push(ast::ast_ident(s, ar_var, line, col))
  var destroy_call = ast::ast_call(s, destroy_callee, destroy_args, line, col)

  var return_node = ast::ast_return(s, ast::ast_ident(s, return_var_name, line, col), line, col)

  # Lambda body block:
  #   ar_let, r_let, panicked_let, with_alloc_node, panic_if,
  #   [layout_stmts...], [p_let], destroy_call, return_node
  var stmts = vec_new()
  stmts.push(ar_let)
  stmts.push(r_let)
  stmts.push(panicked_let)
  stmts.push(with_alloc_node)
  stmts.push(panic_if)
  if kind == 6
    var ls_i = 0
    while ls_i < layout_stmts.size
      stmts.push(layout_stmts[ls_i])
      ls_i = ls_i + 1
    end
  end
  if p_let >= 0
    stmts.push(p_let)
  end
  stmts.push(destroy_call)
  stmts.push(return_node)
  var outer_block = ast::ast_block(s, stmts, line, col)

  var no_params = vec_new()
  var lambda_node = ast::ast_lambda(s, no_params, "", outer_block, line, col)

  var no_args = vec_new()
  return ast::ast_call(s, lambda_node, no_args, line, col)
end

## If `part` is a parser-generated `to_str(inner)` call wrapping an
## already-String-typed expression, return `inner`. Otherwise return
## `part` unchanged. Used by NODE_INTERP_STRING desugar to elide the
## redundant runtime dispatch — the LLVM `to_str` heuristic happens to
## be a passthrough for valid strings, but the WASM backend can't safely
## replicate it (low linear-memory addresses defeat the heuristic).
def mir_unwrap_to_str_for_string(ctx: MirContext, s: ast::AstStorage, part: AstNodeId): AstNodeId
  return part if part < 0
  var part_kind = ast::ast_get_kind(s, part)
  return part if part_kind != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, part)
  return part if callee < 0
  return part if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  return part if ast::ast_get_str1(s, callee) != "to_str"
  var call_args = ast::ast_get_children(s, part)
  return part if call_args == 0
  return part if call_args.size != 1
  var inner = call_args[0]
  return inner if mir_is_string_expr(ctx, s, inner) == 1
  return part
end

## Conservative detector for compile-time Int-typed expressions. False-negative
## is safe (caller falls back to `to_str`). False-positive would route a String
## pointer through `sb_append_int` / `str_from_int` and garble output, so the
## detector trusts only the `mir_infer_expr_type == "Int"` verdict — which is
## already a multi-source verdict (literals, propagated arithmetic, intrinsic
## return registry, function ret-anns, param/global type lookup).
def mir_is_int_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  return 0 if node < 0
  var inferred = ctx.mir_infer_expr_type(s, node)
  return 1 if inferred == "Int"
  return 0
end

## Sister to `mir_unwrap_to_str_for_string`: if `part` is a parser-generated
## `to_str(inner)` wrapping a known-Int expression, return `inner` so the
## NODE_INTERP_STRING desugar can dispatch through `sb_append_int` /
## `str_from_int` directly. Returns -1 (an invalid AstNodeId) when the part
## doesn't match — caller falls back to the existing String-elision-or-to_str
## path. Closes the TO_STR_INT_HEURISTIC_UNSOUND latent SIGSEGV class for any
## Int interp the compiler can prove statically (e.g., `bytes = 416760` style
## values that satisfied the alignment heuristic and dereferenced an unmapped
## page when `@to_str` took the String path).
def mir_unwrap_to_str_for_int(ctx: MirContext, s: ast::AstStorage, part: AstNodeId): AstNodeId
  return -1 if part < 0
  var part_kind = ast::ast_get_kind(s, part)
  return -1 if part_kind != node_constants::NODE_CALL
  var callee = ast::ast_get_left(s, part)
  return -1 if callee < 0
  return -1 if ast::ast_get_kind(s, callee) != node_constants::NODE_IDENT
  return -1 if ast::ast_get_str1(s, callee) != "to_str"
  var call_args = ast::ast_get_children(s, part)
  return -1 if call_args == 0
  return -1 if call_args.size != 1
  var inner = call_args[0]
  return inner if mir_is_int_expr(ctx, s, inner) == 1
  return -1
end

## B.8 Phase 4a — lower a Scoped NODE_WITH (`with X do v -> body end`).
## Phase 4b extends with throw-safety: the body is wrapped in a Throws
## frame whose handler is the runtime's generic
## `__qz_scoped_throw_handler`; on throw/panic the handler reads (self,
## v, release_on_throw_fn_ptr) from a TLS Scoped-ctx stack, fires
## release_on_throw, decrements `__qz_effect_stack_top` by 1 (to skip
## past its own frame), and re-performs the throw so the rescan finds
## the next outer Throws handler.
##
## Sequence:
##   1. Lower handler expr → %self  (the Scoped guard value)
##   2. Call <Struct>$acquire(%self) → %v  (the bound value)
##   3. If a bound-param name was given, alloc a slot for it and store %v
##      so body references resolve cleanly.
##   4a. Resolve <Struct>$release_on_throw fn pointer via mir_emit_func_ref.
##   4b. Push (self, v, rot_fn_ptr) onto the runtime Scoped-ctx TLS stack.
##   4c. Install a Throws frame whose only entry binds op=throw to the
##       runtime helper `__qz_scoped_throw_handler`.
##   4d. Push lexical handler-stack entry so MIR-time throws inside the
##       body resolve to our handler (kind classifier + handler lookup).
##   5. Push a Scoped wrap so NODE_RETURN / break / continue inside the
##      body fire effect_pop_n("Throws", 1) + scoped_ctx_pop + release(self, v).
##   6. Lower the body. Expression position uses mir_lower_block_expr;
##      statement position uses mir_lower_stmt.
##   7. Pop the Scoped wrap and the lexical handler entry.
##   8. Natural-exit teardown: mir_emit_handle_uninstall("Throws", val,
##      install_dest, 1) to drain our Throws frame; __qz_scoped_ctx_pop
##      to drain the TLS ctx; <Struct>$release(self, v) for normal release.
##   9. Return the body's final value (statement form returns 0).
def mir_lower_with_scoped(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, scoped_struct: String, is_stmt: Int): Int
  var sc_handler = ast::ast_get_left(s, node)
  var sc_body = ast::ast_get_right(s, node)
  var sc_bound = ast::ast_with_bound_param(s, node)

  # Step 1: Lower the handler value. The user wrote a real expression
  # like `mutex.lock` or `Mutex { ... }` — it has type T where T impls
  # Scoped. Lower it once so subsequent acquire/release calls see the
  # same handle.
  #
  # Phase 2d Bug 4 fix: spill the handler value into a stack slot
  # immediately. If this function is the body of an async-future-wrapped
  # call (`async f()` → `__Future_f$poll`), the wrapper synthesis later
  # inserts `yield_resume*` / `k3_perform_resume*` re-entry blocks that
  # branch INTO the middle of the function body, bypassing the original
  # handler-expr def. The SSA reg `sc_self` doesn't dominate uses in
  # release sites reached via yield-resume. Storing through a slot lets
  # the value live in memory; every later use (acquire, scoped_ctx_push,
  # wrap-drain, natural-exit release) loads from the slot.
  var sc_self_reg0 = ctx.mir_lower_expr(s, sc_handler)
  var sc_self_synth_id = ctx.mir_ctx_alloc_slot()
  var sc_self_slot_name = "__qz_scoped_self_" + sc_self_synth_id.to_s()
  var sc_self_user_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(sc_self_slot_name, sc_self_user_slot)
  ctx.mir_emit_store_var(sc_self_slot_name, sc_self_reg0)
  # If this with-block sits inside an async/generator $poll body, the guard-self
  # slot is live across any suspend nested in the body (the natural-exit release
  # reads it after the loop resumes). It's synthesized here — not in the AST — so
  # the static collector can't see it; register it dynamically so the suspend
  # save/restore round-trips it through the generator frame. No-op outside a
  # generator (_gen_active == 0).
  mir_lower_gen::mir_gen_register_dynamic_local(sc_self_slot_name)
  var sc_self = ctx.mir_emit_load_var(sc_self_slot_name)

  # Step 2: Resolve <Struct>$acquire and call(self) → %v.
  var sc_acquire_fn = string_intern::mangle(scoped_struct, "acquire")
  var sc_acquire_args = vec_new<Int>()
  sc_acquire_args.push(sc_self)
  var sc_v = ctx.mir_emit_call(sc_acquire_fn, sc_acquire_args)

  # Step 3: Always alloca a slot for v and store the acquire return into
  # it. If a user-supplied bound name was given, the slot uses that name
  # so body references resolve cleanly. Otherwise a synthetic name keeps
  # the slot addressable (the runtime Scoped-ctx TLS stack stores the
  # slot's address, not the value, so the throw handler can deref-and-
  # release with the body's most-recent write).
  #
  # Phase 6.5: this slot is the seat of write-back semantics. Body
  # reassignments to the bound name flow through STORE_VAR into the same
  # slot; every release site (natural exit, wrap_stack drain on
  # return/break/continue, runtime throw handler) reads the CURRENT
  # value before calling release(self, v).
  var sc_v_slot_name = ""
  if sc_bound != -1
    sc_v_slot_name = ast::ast_get_str1(s, sc_bound)
  else
    var sc_synth_id = ctx.mir_ctx_alloc_slot()
    sc_v_slot_name = "__qz_scoped_v_" + sc_synth_id.to_s()
  end
  var sc_user_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var(sc_v_slot_name, sc_user_slot)
  ctx.mir_emit_store_var(sc_v_slot_name, sc_v)
  # The acquired value `v` is read at every release site (natural exit, early-exit
  # drain, throw handler). When a bound name was given it's already a static
  # generator local (this call no-ops); when synthesized (`__qz_scoped_v_*`) it
  # isn't in the AST, so register it dynamically so it survives a suspend nested
  # in the body. No-op outside a generator.
  mir_lower_gen::mir_gen_register_dynamic_local(sc_v_slot_name)
  var sc_v_slot_ptr = ctx.mir_emit_addr_of(sc_v_slot_name)

  # Phase 4b Step 4a/b/c: install Throws frame + push Scoped-ctx.
  #
  # rot_fn name is the resolved <Struct>$release_on_throw mangling.
  # mir_emit_func_ref produces a register holding `ptrtoint ptr @<name> to i64`
  # — exactly the shape __qz_scoped_ctx_push wants for its rot_fn arg.
  #
  # Phase 6.5: the second arg is now the slot POINTER (i64 ptr-as-int),
  # not the bound value. The runtime helpers store this pointer in
  # __qz_scoped_ctx_v[idx]; on throw, __qz_scoped_throw_handler dereferences
  # to read the body's most-recent write to v before calling release_on_throw.
  var sc_release_fn = string_intern::mangle(scoped_struct, "release")
  var sc_rot_fn_name = string_intern::mangle(scoped_struct, "release_on_throw")
  var sc_rot_fn_ref = ctx.mir_emit_func_ref(sc_rot_fn_name)
  var sc_push_args = vec_new<Int>()
  # Phase 2d Bug 4 fix: re-load self from its slot here (in case the
  # block that ran step 1 differs from the current block — e.g., the
  # handler expr was a method-call with internal control flow). For
  # simple expressions the load is a same-block redundancy SimplifyCFG
  # will fold; for complex ones, dominance is guaranteed.
  var sc_self_push = ctx.mir_emit_load_var(sc_self_slot_name)
  sc_push_args.push(sc_self_push)
  sc_push_args.push(sc_v_slot_ptr)
  sc_push_args.push(sc_rot_fn_ref)
  ctx.mir_emit_call("__qz_scoped_ctx_push", sc_push_args)
  # Install a Throws frame with one entry: op="throw", handler =
  # runtime symbol __qz_scoped_throw_handler. Mirrors the H-delegate
  # NODE_STRUCT_INIT shape so the existing handle_install codegen
  # (jmpbuf + setjmp + catch block) wires up correctly. The catch
  # block is dead code under our handler — our handler unreachables
  # after rethrow so perform never reaches its kind=2 longjmp — but
  # the standard machinery emits the right setjmp scaffold anyway.
  var sc_install_entries = vec_new<Int>()
  sc_install_entries.push(as_int("throw"))
  sc_install_entries.push(as_int("__qz_scoped_throw_handler"))
  var sc_install_dest = ctx.mir_emit_handle_install("Throws", sc_install_entries, -1)
  # Step 4d: lexical handler-stack entry so MIR-time throws inside the
  # body resolve here. Mirrors the standard NODE_WITH path's push.
  ctx.mir_ctx_push_handler_entry("Throws", "throw", as_int("__qz_scoped_throw_handler"), sc_install_dest)

  # Step 5: Push Scoped wrap. Resolved release fn name is the same
  # mangle as acquire — <Struct>$release. Early-exit paths inside the
  # body see this entry and emit:
  #   - effect_pop_n("Throws", 1)  (drain runtime stack of our frame)
  #   - __qz_scoped_ctx_pop()      (drain TLS ctx)
  #   - <Struct>$release(self, current_v)  (normal release)
  #
  # Phase 6.5: the wrap entry holds the slot's variable name, not an
  # SSA register. The drain emits load_var(slot) at drain time so it
  # picks up any reassignments the body made before the early-exit.
  ctx.mir_ctx_push_wrap_scoped(sc_release_fn, sc_self_slot_name, sc_v_slot_name)

  # Step 6: Lower body.
  var sc_val = 0
  if is_stmt == 1
    if sc_body >= 0
      mir_lower_stmt(ctx, s, sc_body)
    end
    sc_val = ctx.mir_emit_const_int(0)
  else
    if sc_body >= 0
      sc_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, sc_body)
    else
      sc_val = ctx.mir_emit_const_int(0)
    end
  end

  # Step 7: Pop Scoped wrap + lexical handler entry (so the natural-
  # exit release below isn't double-fired for a body-internal early-
  # return that already drained this entry).
  ctx.mir_ctx_pop_wrap()
  ctx.mir_ctx_pop_handler_entries(1)

  # Step 8: Natural-exit teardown. If body terminated (return / throw /
  # unreachable), the current MIR block already has a terminator and the
  # early-exit cleanup ran via the wrap_stack drain. Skip the natural-
  # exit emission in that case BUT still emit a wb.done.NN block so the
  # standard catch path's `br label %wb.done.NN` resolves — same shape
  # as the legacy NODE_WITH terminated-body branch.
  var sc_cur = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(sc_cur) >= 0
    var sc_done_only = ctx.mir_create_block("wb_done_only_scoped")
    ctx.mir_switch_to_block(sc_done_only)
    ctx.mir_emit_handle_uninstall_done_only("Throws", sc_install_dest, 1)
    return sc_val
  end
  # Natural-exit path: uninstall Throws, pop scoped ctx, fire release.
  # The handle_uninstall returns a register holding the body value
  # (loaded via wb.done.NN's load from result_slot); use that as our
  # final return so the IR threads through cleanly.
  #
  # Phase 6.5: load v from its slot before calling release so any body
  # reassignments propagate. Symmetric with the wrap_stack drain on
  # early-exit and the runtime throw handler's deref.
  var sc_post_val = ctx.mir_emit_handle_uninstall("Throws", sc_val, sc_install_dest, 1)
  var sc_pop_args = vec_new<Int>()
  ctx.mir_emit_call("__qz_scoped_ctx_pop", sc_pop_args)
  var sc_v_final = ctx.mir_emit_load_var(sc_v_slot_name)
  # Phase 2d Bug 4 fix: load self from its slot. The natural-exit
  # block can be reached via wb.done.NN whose predecessor wb.catch.NN
  # is a setjmp landing — even without async, dominance is fragile
  # here; with async-future wrappers, the path through yield-resume
  # would otherwise bypass the handler-expr def entirely.
  var sc_self_final = ctx.mir_emit_load_var(sc_self_slot_name)
  var sc_release_args = vec_new<Int>()
  sc_release_args.push(sc_self_final)
  sc_release_args.push(sc_v_final)
  ctx.mir_emit_call(sc_release_fn, sc_release_args)
  return sc_post_val
end

# B.10 §14.12 value semantics (V2c, INERT at gate 0): eager copy of a `@value`
# struct value used as a STRUCT FIELD INITIALIZER (`Outer { inner: a }` where `a`
# is a named `@value` struct), so mutating `outer.inner` does NOT alias the
# caller's `a` (the §14.11.8 reference-semantics bug). Mirrors the call-arg site
# (commit 4f5d0219): only bare-IDENT initializers (named lvalues that could
# alias) are copied; struct literals / call results are already fresh rvalues,
# and `&a` / `&mut a` parse to NODE_FUNC_REF (NOT NODE_IDENT) — the borrow is the
# explicit opt-out and falls through unchanged. Keyed on `@value` (the compiler
# uses ZERO @value structs) ⇒ gate-0-dead ⇒ fixpoint-trivial. v1 eager; COW later.
# Returns `field_val` unchanged unless value semantics is live AND the
# initializer is a bare IDENT resolving to a registered @value struct.
def mir_maybe_copy_value_field_init(ctx: MirContext, s: ast::AstStorage, field_node: AstNodeId, field_val: Int): Int
  if mir::mir_value_semantics_live() == 1
    if ast::ast_get_kind(s, field_node) == node_constants::NODE_IDENT
      var vs_fi_name = ast::ast_get_str1(s, field_node)
      var vs_fi_ty = ctx.mir_ctx_get_var_type(vs_fi_name)
      if str_byte_len(vs_fi_ty) > 0
        # F4a: single layout key (= is_value at gate-0, byte-identical).
        if mir::mir_is_value_layout_type(ctx, vs_fi_ty) == 1
          return mir::mir_emit_value_copy(ctx, field_val, vs_fi_ty)
        end
      end
    end
  end
  return field_val
end

## F4c (R6) — 1 iff a field-access / assignment BASE node is a bare ident naming an
## arena-owned binding (an `@arena_name Struct {…}` value). Such a buffer is FLAT
## (offset+0, no COW refcount header), so the COW +1 field shift and make-unique
## MUST be suppressed for it (the ratified arena-non-COW carve-out). Only a direct
## ident receiver is recognized — a chained / call-result base does not carry the
## per-binding arena flag, and an arena value never escapes its arm to such a base
## in current code, so conservatively returning 0 there keeps the cow path
## (correct: those are not arena-owned bindings). INERT at gate 0.
def mir_field_base_is_arena_owned(ctx: MirContext, s: ast::AstStorage, base_node: AstNodeId): Int
  return 0 if base_node < 0
  return 0 if ast::ast_get_kind(s, base_node) != node_constants::NODE_IDENT
  var bn = ast::ast_get_str1(s, base_node)
  return 0 if str_byte_len(bn) == 0
  return mir::mir_ctx_is_arena_owned(ctx, bn)
end

## F4 item-9j — INLINE-value-layout array-literal element field count.
## Returns the per-element i64-slot field count (> 1) iff the array literal's
## element type is an INLINE-stored value-layout struct — the same predicate
## (cg_intrinsic_collection::cg_hof_inline_field_count / cg_intrinsic_vec::
## cg_vec_inline_field_count) the read paths (vec_get, for-in, HOF) apply to
## decide their stride. For such elements a Vec stores N flat words / packed-
## sizeof bytes per slot, NOT one boxed pointer; the literal's legacy inline
## (`mir_emit_store_offset(data, i, elem_ptr)`) build boxes a pointer at stride-1
## that the read side mis-decodes. Returns 0 for cow-layout (>16B, one buffer
## ptr/slot — boxed stride-1 IS correct), scalars, and reference structs ⇒ those
## keep the byte-identical legacy build. INERT at gate 0: a plain struct is not
## value-layout ⇒ fc <= 1 ⇒ 0 ⇒ the legacy path, byte-identical.
## (Uses CTX predicates — the MirProgram's struct_defs are not yet populated at
## lowering time; the per-fn struct REGISTRY is. mir_is_value_layout_type /
## mir_value_is_cow_layout / mir_ctx_struct_field_count all read the registry, the
## same source item-9e's elem-type tracking and the construct path consult, so
## construct/storage/read stay in lockstep. Firewall safety (no scalar+pointer mix)
## is re-derived inline from the registry field types — the read side boxes a
## firewall-mixed @value, so we must NOT inline-flat those.)
def mir_array_literal_inline_fc(ctx: MirContext, s: ast::AstStorage, first_elem: AstNodeId): Int
  return 0 if first_elem < 0
  var ety = ctx.mir_infer_expr_type(s, first_elem)
  return 0 if str_byte_len(ety) == 0
  var name = mir_resolve_struct_name(ctx, mir_strip_generic_head(ety))
  return 0 if str_byte_len(name) == 0
  return 0 if mir::mir_is_value_layout_type(ctx, name) == 0
  return 0 if mir::mir_value_is_cow_layout(ctx, name) == 1
  var fc = mir::mir_ctx_struct_field_count(ctx, name)
  return 0 if fc < 1
  # Firewall-safe gate: an inline-stored @value must be homogeneous (all scalar
  # OR all reference handle) — a scalar+pointer MIX boxes (read side returns a
  # value-copied handle), so it keeps the legacy boxed-pointer-per-slot build.
  var sf = mir::mir_ctx_get_struct_fields(ctx, name)
  return 0 if sf.is_none()
  var fts = sf.unwrap().field_types
  var has_scalar = 0
  var has_pointer = 0
  for _ialf in 0..vec_size(fts)
    if mir::mir_is_scalar_field_type(as_string(fts[_ialf])) == 1
      has_scalar = 1
    else
      has_pointer = 1
    end
  end
  return 0 if has_scalar == 1 and has_pointer == 1
  return fc
end

## R2.1 (B1) — widen an arm value into a union's runtime tagged `{tag, payload}`
## cell. Reuses the enum legacy boxed path shape (mir_lower.qz:4399-4459):
## alloc(1 + payload_words), tag word (= hash of the arm type) at offset 0, the
## value at offset 1; returns the cell pointer (a valid i64 handle, so downstream
## alloc/GC/escape handling already knows the layout). `ann` is the union
## annotation (e.g. "Int | String"); `arm_ann` is the RHS's concrete arm type
## (e.g. "Int"). Construction only — reading/narrowing is B2.
def mir_emit_widen_to_union(ctx: MirContext, value: Int, ann: String, arm_ann: String): Int
  # R2.1 (B4) — niche `T | Nil`: no tag word, no alloc. The value IS the union
  # (payload-sized). The payload arm widens by IDENTITY; the `Nil` arm becomes the
  # spare bit-pattern constant (mir_union_nil_const). The niche verdict here MUST
  # match every narrow/read site (mir_emit_narrowed_read + the is-check) — all
  # consult the SAME mir_union_is_niche predicate. INERT at gate 0 (no niche `T|Nil`
  # union reaches widen in the compiler/std ⇒ predicate 0 ⇒ tagged path below).
  if mir::mir_union_is_niche(ctx, ann) == 1
    if str_trim(arm_ann) == "Nil"
      return ctx.mir_emit_const_int(mir::mir_union_nil_const(ctx, ann))
    end
    return value
  end
  var payload_words = mir::mir_union_payload_words(ann)
  var enum_ptr = ctx.mir_emit_alloc(1 + payload_words)
  var tag_val = ctx.mir_emit_const_int(mir::mir_union_arm_tag(arm_ann))
  ctx.mir_emit_store_offset(enum_ptr, 0, tag_val)
  ctx.mir_emit_store_offset(enum_ptr, 1, value)
  return enum_ptr
end

## R2.2 (item 1) — the inverse of mir_emit_widen_to_union: recover the arm payload
## from a union value flowing into a BARE-ARM sink (a narrowing coercion — today a
## non-union RETURN slot; let/arg/store are filed follow-ons). For a NICHE `T | Nil`
## union the value IS the payload (identity) — the SAME mir_union_is_niche verdict the
## widen + mir_emit_narrowed_read sites consult, so construct/un-widen agree byte-for-
## byte and a niche union is NOT spuriously load-offset'd. For a SPILLED union the
## payload is at cell offset 1 (widen stored it there via store_offset(enum_ptr, 1)).
## INERT at gate 0: fires only when inference yields a top-level union in a scalar sink,
## which the compiler/std never produce ⇒ byte-identical self-compile.
def mir_emit_unwiden_from_union(ctx: MirContext, value: Int, ann: String): Int
  return value if mir::mir_union_is_niche(ctx, ann) == 1
  return ctx.mir_emit_load_offset(value, 1)
end

## R2 (C1/§3.3) — record width-subtyping REPROJECTING COPY. When a value of a wider
## SOURCE struct (`source_type`) is passed/bound where a narrower structural record
## (`record_ann`) is expected, the two physical layouts are NOT offset-compatible:
## the record reader reads its own canonical flat layout (field f at buffer word f,
## no refcount header — the record is is_value=1 ≤16B flat OR its own COW buffer),
## but a >16B source struct is a COW buffer (refcount header at word 0, field f at
## word f+1) and a wider source reorders/shifts the shared prefix. Reading the source
## directly through the record's accessor then reads the wrong slot (pre-fix: `r.x`
## on a Point3D read the refcount header → returned 2, not x). §3.3's resolution:
## materialize a fresh buffer in the RECORD's exact canonical layout, copying each
## record field FROM the source by NAME (so the source's own field ordering + COW
## header shift are applied on the read) and storing it FLAT at the record's
## canonical index. The returned buffer then reads correctly through the record view.
## GATE-0-INERT: only fires when `record_ann` is a record annotation and `source_type`
## is a registered nominal struct that is NOT the same record — the compiler+stdlib
## carry zero record-typed params, so this never triggers for self-compile.
def mir_emit_reproject_to_record(ctx: MirContext, value: Int, source_type: String, record_ann: String): Int
  var canon = mir::mir_record_canonical_name(record_ann)
  var parsed = mir::mir_record_parse_fields(record_ann)
  var rec_names = parsed[0]
  var n = rec_names.size
  # Fresh flat buffer in the record's canonical layout (is_value=1, offset+0). The
  # record reader reads this buffer at flat word f, so store each field there.
  var dst = ctx.mir_emit_alloc(n)
  # Source read layout: apply the COW +1 header shift iff the SOURCE struct is a
  # cow-layout buffer (>16B value struct). A ≤16B flat source has no header (offset+0).
  var src_resolved = mir_resolve_struct_name(ctx, source_type)
  var src_is_cow = mir::mir_value_is_cow_layout(ctx, src_resolved)
  for i in 0..n
    var fname = as_string(rec_names[i])
    var src_idx = ctx.mir_ctx_find_field_index(src_resolved, fname)
    if src_idx < 0
      # Field absent in source (should be caught by typecheck width-subtyping); copy 0.
      ctx.mir_emit_store_offset(dst, i, ctx.mir_emit_const_int(0))
    else
      var fv = 0
      if src_is_cow == 1
        mir::mir_ctx_set_cow_field_shift(ctx, 1)
        fv = ctx.mir_emit_load_offset(value, src_idx)
        mir::mir_ctx_set_cow_field_shift(ctx, 0)
      else
        fv = ctx.mir_emit_load_offset(value, src_idx)
      end
      ctx.mir_emit_store_offset(dst, i, fv)
    end
  end
  return dst
end

## R2 (C3/§3.3) — record RETURN-position reprojecting copy, keyed on the already-
## CANONICALIZED record struct name (`__rec$...$rec_`) rather than the raw annotation.
## The return-type seam canonicalizes the fn's stored return-type-name (so byval-return
## recognition works), which loses the raw `{ x: Int }` spelling that
## mir_emit_reproject_to_record needs. This twin derives the record's canonical field
## names from the REGISTERED struct's own layout and reprojects the returned nominal
## SOURCE (`source_type`) into that flat canonical order, so the caller's record-view
## field reads land on the right slots even when the source's layout (COW header shift
## and/or field ordering) differs from the record's. GATE-0-INERT: only reached when
## the return-type-name is a canonical record and the returned expr infers to a
## DIFFERENT registered nominal struct — self-compile has zero record returns.
def mir_emit_reproject_return_to_record(ctx: MirContext, value: Int, source_type: String, canon_record: String): Int
  var n = ctx.mir_ctx_struct_field_count(canon_record)
  if n <= 0
    return value
  end
  # Fresh flat buffer in the record's canonical layout (is_value flat, offset+0), OR
  # a >16B cow record buffer whose field f lands at word f+1 — reuse the record's own
  # cow-layout probe so the store side matches how the caller reads it back.
  var dst_is_cow = mir::mir_value_is_cow_layout(ctx, canon_record)
  var dst = ctx.mir_emit_alloc(n)
  var src_resolved = mir_resolve_struct_name(ctx, source_type)
  var src_is_cow = mir::mir_value_is_cow_layout(ctx, src_resolved)
  for i in 0..n
    var fname = ctx.mir_ctx_struct_field_name(canon_record, i)
    var src_idx = ctx.mir_ctx_find_field_index(src_resolved, fname)
    var fv = 0
    if src_idx < 0
      fv = ctx.mir_emit_const_int(0)
    elsif src_is_cow == 1
      mir::mir_ctx_set_cow_field_shift(ctx, 1)
      fv = ctx.mir_emit_load_offset(value, src_idx)
      mir::mir_ctx_set_cow_field_shift(ctx, 0)
    else
      fv = ctx.mir_emit_load_offset(value, src_idx)
    end
    if dst_is_cow == 1
      mir::mir_ctx_set_cow_field_shift(ctx, 1)
      ctx.mir_emit_store_offset(dst, i, fv)
      mir::mir_ctx_set_cow_field_shift(ctx, 0)
    else
      ctx.mir_emit_store_offset(dst, i, fv)
    end
  end
  return dst
end

def mir_lower_expr(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Int
  if node < 0
    return ctx.mir_emit_const_int(0)
  end
  var kind = ast::ast_get_kind(s, node)

  return ctx.mir_emit_const_int(ast::ast_get_int_val(s, node)) if kind == node_constants::NODE_INT_LIT
  
  # NodeFloatLit = 68: float literal stored as string
  return ctx.mir_emit_const_float(ast::ast_get_str1(s, node)) if kind == node_constants::NODE_FLOAT_LIT
  
  return ctx.mir_emit_const_bool(ast::ast_get_int_val(s, node)) if kind == node_constants::NODE_BOOL_LIT
  
  # NodeNilLit = 2: nil is 0 at runtime (same as false)
  return ctx.mir_emit_const_bool(0) if kind == node_constants::NODE_NIL_LIT
  
  if kind == node_constants::NODE_STRING_LIT
    # String literals from AST are already unescaped by the lexer (no quotes)
    var str_val = ast::ast_get_str1(s, node)
    return ctx.mir_emit_const_string(str_val)
  end
  
  # NodeSymbolLit = 4: Compute FNV-1a hash of symbol name
  if kind == node_constants::NODE_SYMBOL_LIT
    var sym_name = ast::ast_get_str1(s, node)
    # FNV-1a hash: start with offset basis, xor each byte, multiply by prime
    # hash = -3750763034362895579 (signed i64 of 0xcbf29ce484222325), prime = 1099511628211
    var hash = -3750763034362895579
    var sym_len = str_byte_len(sym_name)
    # Skip the leading colon, start at index 1
    for i in 1..sym_len
      var ch = str_byte_at(sym_name, i)
      hash ^= ch
      hash *= 1099511628211
    end
    return ctx.mir_emit_const_int(hash)
  end

  # NodeRegexLit = 5: Regex literal ~r"pattern" → emit as const string
  # The pattern string is passed to POSIX regcomp at runtime
  if kind == node_constants::NODE_REGEX_LIT
    var pattern = ast::ast_get_str1(s, node)
    return ctx.mir_emit_const_string(pattern)
  end

  # NodeExternFn = 53: extern function declaration (FFI)
  # No code generation needed - extern declarations are handled separately
  return 0 if kind == node_constants::NODE_EXTERN_FN

  # NodeProtocolDef = 87: protocol definition (session types)
  # Compile-time only — no runtime code generation
  return 0 if kind == node_constants::NODE_PROTOCOL_DEF
  
  # NODE_ASYNC_CALL = 84: async func(args) — creates Future
  # Two paths:
  #   Lazy: if target is a named function, call __Future_func$new(args) → returns frame
  #   Eager: for function variables/closures, evaluate immediately + wrap in 2-slot frame
  if kind == node_constants::NODE_ASYNC_CALL
    var inner = ast::ast_get_left(s, node)

    # Extract target function name (if it's a direct call to a named function)
    var target_name = ""
    if inner >= 0
      var inner_kind = ast::ast_get_kind(s, inner)
      if inner_kind == node_constants::NODE_CALL
        var callee_node = ast::ast_get_left(s, inner)
        if callee_node >= 0
          if ast::ast_get_kind(s, callee_node) == node_constants::NODE_IDENT
            target_name = ast::ast_get_str1(s, callee_node)
          end
        end
      end
    end

    # Only use lazy path for actual named functions (not function variables/params).
    # Check if the target resolves to a known function definition.
    var use_lazy = false
    var resolved_name = ""
    if str_byte_len(target_name) > 0
      resolved_name = mir_resolve_func_name(ctx, target_name)
      var func_entry = ctx.mir_lookup_function(resolved_name)
      if func_entry.is_some()
        use_lazy = true
      end
    end

    # D.11 Phase 7 / B.5e — freestanding explicit-async lowering.
    #
    # On the kernel target, `async fn()` (and `go fn()`, which re-enters
    # here after rewriting NODE_GO → NODE_ASYNC_CALL) must NOT synthesize a
    # hosted `__Future_<name>$new`/`$poll` wrapper: the `$poll` body
    # references hosted-only runtime (`@__qz_current_frame`,
    # `@pthread_*`, `@__qz_waiter_notify_all`, completion/timer/racedet
    # symbols) that has no kernel definition. The kernel spawns named
    # zero-arg functions through `go_fn(entry_fn_ptr)` (a real task_alloc
    # + seeded stack + ready_push), returning a kernel task handle that
    # `kernel_awaitable` (B.5a) can observe. We redirect to that here.
    #
    # ARG CASE (B.5e.3): `go_fn`'s ABI is a zero-arg entry pointer and
    # cannot forward call args, so `async fn(a, b)` spawns through the
    # kernel's closure-capture entry `kern_go_closure(closure)` instead.
    # We evaluate the args in THIS (caller) context, capture them into a
    # closure env, and synthesize a zero-user-param thunk that reads them
    # back and tail-calls the target. See _mir_fs_spawn_closure_with_args
    # and docs/design/D11_FREESTANDING_EFFECT_BRIDGE.md B.5e.3. No hosted
    # `__Future_<name>$new`/`$poll` wrapper is synthesized on this path.
    if use_lazy and _mir_is_freestanding == 1
      var _fs_arg_nodes = ast::ast_get_children(s, inner)
      var _fs_argc = 0
      if _fs_arg_nodes != 0
        _fs_argc = _fs_arg_nodes.size
      end
      if _fs_argc == 0
        # Zero-arg: spawn via kernel go_fn(funcref). The returned handle
        # is a kernel task pointer, consumable by kernel_awaitable.
        var _fs_ref = ctx.mir_emit_func_ref(resolved_name)
        var _fs_spawn_args = vec_new()
        _fs_spawn_args.push(_fs_ref)
        return ctx.mir_emit_call("go_fn", _fs_spawn_args)
      end
      # Arg case: evaluate args in caller context, then spawn a capturing
      # closure via kern_go_closure. mir_record_async_target is NOT called
      # — no hosted wrapper is generated.
      var _fs_evaled = vec_new()
      for _fa in 0.._fs_argc
        _fs_evaled.push(ctx.mir_lower_expr(s, _fs_arg_nodes[_fa]))
      end
      return _mir_fs_spawn_closure_with_args(ctx, resolved_name, _fs_evaled)
    end

    if use_lazy and _mir_is_freestanding == 0
      # Hosted: record target for PASS 1.2 $new/$poll generation.
      mir_lower_async_registry::mir_record_async_target(resolved_name, s)
    end

    if use_lazy
      # Lazy path: call __Future_func$new(args) which returns a frame with state=0
      var ctor_name = "__Future_#{resolved_name}$new"
      # Extract and lower args from the inner call node
      var arg_nodes = ast::ast_get_children(s, inner)
      var ctor_args = vec_new()
      if arg_nodes != 0
        for i in 0..arg_nodes.size
          ctor_args.push(ctx.mir_lower_expr(s, arg_nodes[i]))
        end
      end
      return ctx.mir_emit_call(ctor_name, ctor_args)
    else
      # Eager fallback: function variables/closures — evaluate and wrap
      # Must allocate 6 slots (PARAM_BASE) so go_spawn can safely write:
      #   frame[3] = cancel_token, frame[4] = task_id, frame[5] = park_state
      var call_result = ctx.mir_emit_const_int(0)
      if inner >= 0
        call_result = ctx.mir_lower_expr(s, inner)
      end
      var frame = ctx.mir_emit_alloc(6)
      ctx.mir_emit_store_offset(frame, 0, ctx.mir_emit_const_int(-1))
      ctx.mir_emit_store_offset(frame, 1, call_result)
      ctx.mir_emit_store_offset(frame, 2, ctx.mir_emit_const_int(0))
      ctx.mir_emit_store_offset(frame, 3, ctx.mir_emit_const_int(0))
      ctx.mir_emit_store_offset(frame, 4, ctx.mir_emit_const_int(0))
      ctx.mir_emit_store_offset(frame, 5, ctx.mir_emit_const_int(0))
      return frame
    end
  end

  # NODE_GO = 85: go func(args) — spawn lightweight task on M:N scheduler
  # Desugars to: var frame = async func(args); sched_spawn(frame); return frame
  if kind == node_constants::NODE_GO
    var go_prog = ctx.mir_ctx_get_program()
    mir_set_uses_scheduler(go_prog)
    var inner = ast::ast_get_left(s, node)

    # Phase E.1.b: auto-arena gate. For `go fn(args)` where fn is a
    # top-level user function with value-typed return (Int/Bool/Void/etc.),
    # synthesize an arena-wrapping lambda body so the existing go-lambda
    # path handles per-task arena setup/teardown. Conservative: skips
    # reference-typed returns (would dangle after arena_destroy until E.4
    # lands), lambda forms (avoid double-wrap with go_arena's internal
    # `go (-> _go_arena_body(f))`), and unknown callees (extern/intrinsic).
    var _go_is_named_call = false
    if inner >= 0
      if ast::ast_get_kind(s, inner) == node_constants::NODE_CALL
        var _go_check_callee = ast::ast_get_left(s, inner)
        if _go_check_callee >= 0
          if ast::ast_get_kind(s, _go_check_callee) == node_constants::NODE_IDENT
            _go_is_named_call = true
          end
        end
      end
    end
    if _go_is_named_call
      var auto_arena_info = _mir_should_auto_arena(ctx, s, inner)
      var auto_arena_kind = auto_arena_info[0]
      var auto_arena_aux1 = auto_arena_info[1]
      var auto_arena_aux2 = auto_arena_info[2]
      if auto_arena_kind > 0
        inner = _mir_synthesize_arena_wrap(ctx, s, inner, auto_arena_kind, auto_arena_aux1, auto_arena_aux2)
      end
    end

    # Check for go (lambda)() — lambda block form (from `go do ... end`)
    # Cannot use the NODE_ASYNC_CALL path because lambdas don't have names
    # and can't get $poll/$new variants. Instead, create a frame with
    # __qz_poll_closure as the poll function and the closure as payload.
    # Phase E.1.b: also reached when auto-arena synthesizes a wrap (above).
    var go_is_lambda = false
    if inner >= 0
      if ast::ast_get_kind(s, inner) == node_constants::NODE_CALL
        var go_callee = ast::ast_get_left(s, inner)
        if go_callee >= 0
          if ast::ast_get_kind(s, go_callee) == node_constants::NODE_LAMBDA
            go_is_lambda = true
          end
        end
      end
    end

    if go_is_lambda
      # Proper async state machine for go-lambda — enables colorblind async.
      # Captures are extracted from the lambda body and passed as params
      # to the async constructor. The $poll function restores them on each poll.
      var go_callee = ast::ast_get_left(s, inner)
      var go_body = ast::ast_get_right(s, go_callee)

      # Collect captured variable names
      var go_captures = mir_collect_captures(ctx, s, go_callee)
      var cap_names = vec_new<String>()
      for ci in 0..vec_size(go_captures)
        cap_names.push(go_captures[ci])
      end

      # Freestanding (B.5e.5): spawn the lambda as a real kernel goroutine via a
      # closure thunk (captures threaded through the env), mirroring the named
      # `go fn(args)` path. No hosted $new/$poll wrapper and no
      # perform(Async, spawn, ...) — the kernel has no Async/spawn handler;
      # kern_go_closure already does task_alloc + seeded stack + ready_push and
      # returns the kernel task handle directly.
      if _mir_is_freestanding == 1
        var go_cap_vals = vec_new()
        for cvi in 0..cap_names.size
          go_cap_vals.push(ctx.mir_emit_load_var(cap_names[cvi]))
        end
        return _mir_fs_spawn_lambda(ctx, s, go_body, cap_names, go_cap_vals)
      end

      # Generate unique name
      var go_num = ctx.mir_ctx_next_lambda()
      var go_func_name = "__go_lambda_#{go_num.to_s()}"

      # Save enclosing function's MIR context — constructor/poll create new functions
      var go_saved_func = ctx.mir_ctx_get_func()
      var go_saved_block = ctx.mir_ctx_get_block()
      var go_saved_bindings = ctx.bindings
      var go_saved_scope = ctx.mir_ctx_get_scope_depth()
      var go_saved_drops = ctx.drops.droppable_stack
      var go_saved_defers = ctx.drops.defer_stack
      var go_saved_string_vars = ctx.string_vars
      var go_saved_float_vars = ctx.float_vars
      var go_saved_vec_elem_types = ctx.vec_elem_types
      var go_saved_iter_bound = ctx.iterator_bound_params
      # Save mir_lower_gen async/generator state — the poll synthesizer below
      # sets up a fresh $poll state machine and `_gen_clear()`s it on exit,
      # which would otherwise wipe the enclosing async fn's _gen_frame_var
      # when this `go` sits in `return` position.
      var go_saved_gen = mir_lower_gen::mir_gen_snapshot()

      # Build async constructor + poll with captures
      mir_lower_gen::mir_lower_go_lambda_constructor(ctx, s, go_body, go_func_name, cap_names)
      mir_lower_gen::mir_lower_go_lambda_poll(ctx, s, go_body, go_func_name, cap_names)

      # Restore enclosing function's MIR context
      ctx.mir_ctx_set_func(go_saved_func)
      ctx.mir_ctx_set_block(go_saved_block)
      ctx.bindings = go_saved_bindings
      ctx.mir_ctx_set_scope_depth(go_saved_scope)
      ctx.drops.droppable_stack = go_saved_drops
      ctx.drops.defer_stack = go_saved_defers
      ctx.string_vars = go_saved_string_vars
      ctx.float_vars = go_saved_float_vars
      ctx.vec_elem_types = go_saved_vec_elem_types
      ctx.iterator_bound_params = go_saved_iter_bound
      mir_lower_gen::mir_gen_restore(go_saved_gen)

      # Call constructor with captured values
      var ctor_name = "__Future_#{go_func_name}$new"
      var ctor_args = vec_new()
      for ci in 0..cap_names.size
        var cap_val = ctx.mir_emit_load_var(cap_names[ci])
        ctor_args.push(cap_val)
      end
      var frame = ctx.mir_emit_call(ctor_name, ctor_args)

      # `go` routes its scheduler enqueue through
      # `perform(Async, spawn, frame)` at kind=1. Default handler
      # (__qz_default_async_handler do_spawn) auto-inits the scheduler
      # and calls __qz_sched_spawn(frame), returning the frame. kind=1
      # is function-kind, so the perform's return value is the handler's
      # return — `var h = go ...` still receives the frame handle and
      # the caller continues without $poll-ification.
      var perform_args = vec_new()
      perform_args.push(frame)
      return ctx.mir_emit_perform_op("spawn", "Async", 1, perform_args)
    end

    # Named function: reuse existing async lowering, then route the
    # scheduler enqueue through perform(Async, spawn, frame) at kind=1.
    ast::ast_set_kind(s, node, node_constants::NODE_ASYNC_CALL)
    var frame = ctx.mir_lower_expr(s, node)
    ast::ast_set_kind(s, node, node_constants::NODE_GO)

    # Freestanding (B.5e): the NODE_ASYNC_CALL lowering above already spawned
    # the task on the kernel scheduler — go_fn (zero-arg) / kern_go_closure
    # (arg case) both do task_alloc + seeded stack + ready_push — and returned
    # its kernel task handle. There is no hosted Async/spawn effect handler in
    # the kernel; emitting perform(Async, spawn, frame) here would re-dispatch
    # an already-running task through a nonexistent handler. Return the handle
    # directly (same shape `async fn()` yields, consumable by kernel_awaitable).
    if _mir_is_freestanding == 1
      return frame
    end

    var perform_args = vec_new()
    perform_args.push(frame)
    return ctx.mir_emit_perform_op("spawn", "Async", 1, perform_args)
  end

  # NodeAwait = 58: await handle (wait for completion).
  #
  # Two lowering paths:
  #   Inside $poll state machine: route through kind=3 perform (suspend,
  #     resume from the default Async handler via __qz_effect_resume_cont).
  #   Outside $poll: runtime dispatch on state[0] — eager-future (==-1)
  #     loads the cached result at [1]; scheduler task uses
  #     completion_await (completion_map + poller thread wake).
  #
  # Post-P3.G-followup: `spawn`/pthread_join path is gone. All handles
  # are scheduler-backed (from `go`) or eager futures (from `async`).
  if kind == node_constants::NODE_AWAIT
    var handle = ast::ast_get_left(s, node)
    var handle_val = ctx.mir_lower_expr(s, handle)

    if mir_lower_gen::mir_gen_is_active() >= 2
      var _p3c2_afn = mir_lower_gen::mir_gen_get_async_func_name()
      if str_byte_len(_p3c2_afn) > 0
        mir_lower_async_registry::mir_record_suspendable_leaf(_p3c2_afn)
      end
      var _p3c2_args = vec_new()
      _p3c2_args.push(handle_val)
      return mir_lower_gen::mir_emit_kind3_perform_suspend(ctx, "await", "Async", _p3c2_args)
    end

    # Outside $poll: any await implies scheduler runtime is needed.
    # (completion_await depends on completion_map + poller.)
    var _aw_prog = ctx.mir_ctx_get_program()
    mir_set_uses_scheduler(_aw_prog)

    # Known-lazy Future shortcut: if the handle was bound by
    # `var h = async f(...)` and we know the target function is
    # suspendable-lazy, skip the state[0] probe and go straight to
    # completion_await.
    var is_known_lazy = false
    if ast::ast_get_kind(s, handle) == node_constants::NODE_IDENT
      var handle_name = ast::ast_get_str1(s, handle)
      is_known_lazy = mir_lower_async_registry::mir_is_lazy_async_var(handle_name)
    end
    if is_known_lazy
      return mir_lower_gen::mir_emit_completion_await(ctx, handle_val)
    end

    var state_val = ctx.mir_emit_load_offset(handle_val, 0)
    var neg_one = ctx.mir_emit_const_int(-1)
    var is_future = ctx.mir_emit_binary(op_constants::OP_EQ, state_val, neg_one)

    var future_block = ctx.mir_create_block("await_future")
    var task_block = ctx.mir_create_block("await_task")
    var merge_block = ctx.mir_create_block("await_merge")

    var result_name = "__await_result_#{ctx.mir_ctx_alloc_slot().to_s()}"
    var result_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(result_name, result_slot)

    var cur = ctx.mir_ctx_get_block()
    mir_block_set_branch(cur, is_future, future_block, task_block)

    # Eager Future path: load result from frame[1]
    ctx.mir_switch_to_block(future_block)
    var future_result = ctx.mir_emit_load_offset(handle_val, 1)
    ctx.mir_emit_store_var(result_name, future_result)
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, merge_block)

    # Scheduler task path: completion-watch-and-block.
    ctx.mir_switch_to_block(task_block)
    var sched_result = mir_lower_gen::mir_emit_completion_await(ctx, handle_val)
    ctx.mir_emit_store_var(result_name, sched_result)
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_JUMP, merge_block)

    ctx.mir_switch_to_block(merge_block)
    return ctx.mir_emit_load_var(result_name)
  end

  # NodeTaskGroup = 71, NodeSelect = 59 (extracted to mir_lower_concurrency)
  return mir_lower_expr_handlers::mir_lower_concurrency(ctx, s, node) if kind == node_constants::NODE_TASK_GROUP
  return mir_lower_expr_handlers::mir_lower_concurrency(ctx, s, node) if kind == node_constants::NODE_SELECT

  # NodeTryCatch = 63 (extracted to mir_lower_try)
  return mir_lower_expr_handlers::mir_lower_try(ctx, s, node) if kind == node_constants::NODE_TRY_CATCH

  # NodeInlineC = 54: @c("code") or @c("code", var1, var2) inline asm
  if kind == node_constants::NODE_INLINE_C
    var code = ast::ast_get_str1(s, node)
    var ast_args = ast::ast_get_children(s, node)  # Vector of arg expressions
    var mir_args = vec_new()
    if ast_args != 0
      mir_args = map(ast_args, arg_node: Int -> ctx.mir_lower_expr(s, arg_node))
    end
    return ctx.mir_emit_inline_c(code, mir_args)
  end
  
  # NodeIdent = 6 (C-aligned)
  if kind == node_constants::NODE_IDENT
    var name = ast::ast_get_str1(s, node)
    # Check local variables FIRST - they shadow function names
    var local_slot = ctx.mir_ctx_lookup_var(name)
    if local_slot >= 0
      # SURF.FLOW Phase 1/3 — flow-narrowed read. Typecheck stamped this exact read
      # node's int_val to 1 (a plain ident never uses int_val) when a presence/variant
      # guard proved the binding is the narrowed variant; the read's static type is the
      # inner payload, so we must produce the PAYLOAD here, not the wide enum word.
      # mir_emit_narrowed_read dispatches on the subject's LAYOUT (niche identity /
      # niche-multi mask / spill load@1) — generalized from Option-only to Option +
      # Result + user enums. Control flow has proven the variant, so no trap.
      if ast::ast_get_int_val(s, node) == 1
        var nr_val = ctx.mir_emit_load_var(name)
        return mir::mir_emit_narrowed_read(ctx, s, node, nr_val)
      end
      return ctx.mir_emit_load_var(name)
    end
    # Only check function registry if NOT a local variable
    var func_entry = ctx.mir_lookup_function(name)
    if func_entry.is_some()
      return ctx.mir_emit_func_ref(name)
    end
    # Try arity-mangled names: name$0, name$1, ..., name$10
    for arity in 0..11
      var mangled = string_intern::mangle_int(name, arity)
      var found = ctx.mir_lookup_function(mangled)
      if found.is_some()
        return ctx.mir_emit_func_ref(mangled)
      end
    end
    # HB-DOG.12: a function imported via a qualified `import mod` is
    # registered under the module-prefixed name `mod$name`, so the bare
    # `name` misses `mir_lookup_function`. Used as a *value* (`g = name`,
    # `register(..., name)`) it would otherwise fall through to a bogus
    # `load %name`. The NODE_CALL path already suffix-searches `all_funcs`
    # for a `$<name>` match (mir_lower_expr_handlers.qz) — mirror it here
    # so the function-as-value path resolves cross-module symbols too.
    var idfr_all_funcs = ctx.mir_ctx_get_all_funcs()
    if idfr_all_funcs != 0
      var idfr_suffix = "$#{name}"
      for idfr_ai in 0..idfr_all_funcs.size
        var idfr_entry: ResolverEntry = idfr_all_funcs[idfr_ai]
        if idfr_entry.tag == 0 and str_ends_with(idfr_entry.name, idfr_suffix)
          return ctx.mir_emit_func_ref(idfr_entry.name)
        end
      end
    end
    # C4 guardrail (QZ9501): any NODE_IDENT reaching codegen without
    # resolving to a local, function, arity-mangled function, or known
    # global is an internal compiler bug. Silent fall-through used to
    # emit `%<name> undef` IR that llc rejected downstream with cryptic
    # "use of undefined value" errors (root cause of the
    # OPTION-CTOR-IN-IMPL-BODY class of bugs). Fail fast instead so
    # resolver scope-push omissions surface at MIR entry.
    #
    # Globals (const X = ..., var G = ..., imported const) are allowed
    # through because codegen resolves them via @const_X / @<name>
    # module symbols.
    # Narrow guard: only PascalCase names are suspect. Lowercase names
    # have legitimate late-bound paths (match pattern bindings, closure
    # captures, generator locals). PascalCase identifiers in expression
    # position that failed all lookups are almost certainly unresolved
    # variant constructors or type references that leaked past the
    # resolver.
    if mir_ident_is_pascal_case(name) == 1
      if mir_ident_has_global_resolution(ctx, name) == 0
        var qz_line = ast::ast_get_line(s, node)
        var qz_col = ast::ast_get_col(s, node)
        var qz_mod = mir_ctx_get_module(ctx)
        eputs("[QZ9501] internal compiler error: identifier '#{name}' reached codegen unresolved at #{qz_mod}:#{str_from_int(qz_line)}:#{str_from_int(qz_col)}")
        eputs("  PascalCase identifiers in expression position must resolve to")
        eputs("  a function, global, or enum variant. This is a resolver hole.")
        eputs("  Please file an issue with a minimal reproducer.")
        exit(1)
      end
    end
    # For compile-time constants (const X = expr), emit LOAD_VAR.
    # Codegen resolves these by loading from @const_X globals.
    return ctx.mir_emit_load_var(name)
  end
  
  # NodeTryExpr = 17 (extracted to mir_lower_try)
  return mir_lower_expr_handlers::mir_lower_try(ctx, s, node) if kind == node_constants::NODE_TRY_EXPR

  # NodeFuncRef = 18 - function reference (&funcname syntax)
  if kind == node_constants::NODE_FUNC_REF
    var name = ast::ast_get_str1(s, node)
    # Check if this is a borrow (&var) rather than function reference
    var var_dest = ctx.mir_ctx_lookup_var(name)
    if var_dest >= 0
      # Borrow expression — emit LOAD_VAR (pass the pointer, don't consume)
      return ctx.mir_emit_load_var(name)
    end
    return ctx.mir_emit_func_ref(name)
  end

  # NodeBorrow = 102 — PROJECTED data-borrow `&mut p.f` / `&p.f` / `&mut a[i]`
  # (WS4 Step 0). Mirrors the NODE_FUNC_REF base-borrow lowering above: a base
  # borrow `&mut x` emits `mir_emit_load_var(name)` — it passes the loaded
  # value/pointer WITHOUT consuming, since reference-typed places (structs/vecs)
  # are already pointers in their slots. The faithful analog for a PROJECTED
  # place is to lower the operand `p.f` / `a[i]` exactly as a normal read: it
  # yields the same value/pointer a plain access does, matching the base-borrow
  # semantics. The exclusivity precision (disjoint fields, IndexDyn) lives in
  # exclusivity.qz, which reads NODE_BORROW's operand to build a projected Place.
  # GATE-0-INERT: no first-party code uses `&mut p.f`/`&mut a[i]`, so NODE_BORROW
  # is never constructed when compiling the current corpus — this branch is dead.
  if kind == node_constants::NODE_BORROW
    return ctx.mir_lower_expr(s, ast::ast_get_left(s, node))
  end

  # NodeLambda = 19 (extracted to mir_lower_lambda)
  return mir_lower_expr_handlers::mir_lower_lambda(ctx, s, node) if kind == node_constants::NODE_LAMBDA

  # NodeBinary = 8, NodeUnary = 7 (extracted to mir_lower_binary)
  return mir_lower_expr_handlers::mir_lower_binary(ctx, s, node) if kind == node_constants::NODE_BINARY
  return mir_lower_expr_handlers::mir_lower_binary(ctx, s, node) if kind == node_constants::NODE_UNARY

  # NodeCall = 9 (C-aligned)
  return mir_lower_expr_handlers::mir_lower_call(ctx, s, node) if kind == node_constants::NODE_CALL

  # NodeArray = 10 (C-aligned): Array literal with unified layout [cap, len, data_ptr, elems...]
  if kind == node_constants::NODE_ARRAY
    var elements = ast::ast_get_children(s, node)
    var count = elements.size

    # Check if any element is a spread — if so, use dynamic path
    var has_spread = 0
    for si in 0..count
      if ast::ast_get_kind(s, elements[si]) == node_constants::NODE_SPREAD
        has_spread = 1
      end
    end

    if has_spread == 1
      return mir_lower_expr_handlers::mir_lower_array_with_spread(ctx, s, elements, count)
    end

    # F4 item-9j — INLINE value-layout element (≤16B @value struct, fc > 1, NOT
    # cow): the read paths (vec_get/for-in/HOF) decode this Vec's slots as N flat
    # words / packed-sizeof bytes per slot at stride fc, but the legacy inline
    # build below stores ONE boxed pointer per slot at stride-1 — every element
    # (incl v[0]) is then mis-read as the box pointer. Route through the typed
    # vec_new + vec_push sequence, whose codegen already lays the element FLAT
    # (memcpy of fc*8 / sizeof bytes) with the correct header elem_width, exactly
    # as the read side expects. Scalars, reference structs, and cow (>16B) @value
    # elements (whose boxed-ptr-per-slot IS the layout the read side wants) keep
    # the byte-identical legacy build. INERT at gate 0 (predicate ⇒ 0 for every
    # non-@value struct the compiler itself uses ⇒ this branch emits nothing).
    if count > 0
      var _ialit_fc = mir_array_literal_inline_fc(ctx, s, elements[0])
      if _ialit_fc >= 1
        var _ialit_ety = mir_resolve_struct_name(ctx, mir_strip_generic_head(ctx.mir_infer_expr_type(s, elements[0])))
        var _ialit_new_args = vec_new()
        var _ialit_vec = ctx.mir_emit_intrinsic_typed("vec_new", _ialit_new_args, _ialit_ety)
        var _ialit_name = gen_temp_name_with_ctx(ctx, "__inline_arr")
        var _ialit_slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(_ialit_name, _ialit_slot)
        ctx.mir_emit_store_var(_ialit_name, _ialit_vec)
        for _iali in 0..count
          var _ialit_ev = ctx.mir_lower_expr(s, elements[_iali])
          var _ialit_load = ctx.mir_emit_load_var(_ialit_name)
          var _ialit_push_args = vec_new()
          _ialit_push_args.push(_ialit_load)
          _ialit_push_args.push(_ialit_ev)
          ctx.mir_emit_intrinsic_typed("vec_push", _ialit_push_args, _ialit_ety)
        end
        return ctx.mir_emit_load_var(_ialit_name)
      end
    end

    # Use at least 1 slot for data to avoid zero-size allocation
    var data_slots = count
    if data_slots == 0
      data_slots = 1
    end

    # Allocate header (4 slots: cap, len, data_ptr, elem_width)
    var hdr_ptr = ctx.mir_emit_alloc(4)

    # Allocate data (count slots for elements)
    var data_ptr = ctx.mir_emit_alloc(data_slots)

    # Create constants for cap and len
    var cap_val = ctx.mir_emit_const_int(count)
    var len_val = ctx.mir_emit_const_int(count)
    var ew_val = ctx.mir_emit_const_int(8)

    # Store header: [cap, len, data_ptr, elem_width]
    ctx.mir_emit_store_offset(hdr_ptr, 0, cap_val)
    ctx.mir_emit_store_offset(hdr_ptr, 1, len_val)
    ctx.mir_emit_store_offset(hdr_ptr, 2, data_ptr)
    ctx.mir_emit_store_offset(hdr_ptr, 3, ew_val)

    # Lower each element and store to data
    for i in 0..count
      var elem_node = elements[i]
      var elem_val = ctx.mir_lower_expr(s, elem_node)
      ctx.mir_emit_store_offset(data_ptr, i, elem_val)
    end

    # Return header pointer (this is the array value)
    return hdr_ptr
  end

  # Set literal (node_constants$NODE_SET_LITERAL = 11): desugar to set_new() + set_add(set, elem)...
  if kind == node_constants::NODE_SET_LITERAL
    var elements = ast::ast_get_children(s, node)
    var count = elements.size
    # WS3 — a set literal `{Point{1,2}, Point{1,2}}` desugars here to an ANONYMOUS
    # temp, so the named-var pending_set_new back-stamp never fires and the literal
    # would take the identity intmap path (equal-valued elements kept distinct).
    # Infer the element type from the first element; if it is VALUE-LAYOUT, annotate
    # set_new + set_add with the struct name so codegen routes them to the field-deep
    # @qz_map_custom_* value-compare path (equal-valued elements collapse). Int/
    # String/scalar/non-value elements keep the plain untyped emission → BYTE-
    # IDENTICAL (mir_is_value_layout_type is false ⇒ empty annotation ⇒ intmap path).
    var set_elem_ann = ""
    if count > 0
      var first_ty = ctx.mir_infer_expr_type(s, elements[0])
      if str_byte_len(first_ty) > 0
        var st_lt = __char_index(first_ty, '<')
        if st_lt > 0
          first_ty = str_byte_slice(first_ty, 0, st_lt)
        end
        if mir::mir_is_value_layout_type(ctx, first_ty) == 1
          set_elem_ann = first_ty
        end
      end
    end
    # Emit set_new() call
    var new_args = vec_new()
    var set_val = 0
    if str_byte_len(set_elem_ann) > 0
      set_val = ctx.mir_emit_intrinsic_typed("set_new", new_args, set_elem_ann)
    else
      set_val = ctx.mir_emit_intrinsic("set_new", new_args)
    end
    # Emit set_add(set, elem) for each element
    for i in 0..count
      var elem_node = elements[i]
      var elem_val = ctx.mir_lower_expr(s, elem_node)
      var add_args = vec_new()
      add_args.push(set_val)
      add_args.push(elem_val)
      if str_byte_len(set_elem_ann) > 0
        ctx.mir_emit_intrinsic_typed("set_add", add_args, set_elem_ann)
      else
        ctx.mir_emit_intrinsic("set_add", add_args)
      end
    end
    return set_val
  end

  # Tuple literal (kind=77): flat allocation, no header
  if kind == node_constants::NODE_TUPLE_LITERAL
    var elements = ast::ast_get_children(s, node)
    var count = elements.size
    var slots = count
    if slots == 0
      slots = 1
    end
    var tuple_ptr = ctx.mir_emit_alloc(slots)
    for i in 0..count
      var elem_val = ctx.mir_lower_expr(s, elements[i])
      ctx.mir_emit_store_offset(tuple_ptr, i, elem_val)
    end
    return tuple_ptr
  end

  # NodeIndex = 13 (C-aligned): arr[idx] -> emit mir$mir::MIR_INDEX(arr, idx)
  # Supports negative indexing: a[-1] -> a[vec_size(a) + (-1)]
  # Only triggers for unary negation (node_constants$NODE_UNARY = 7, OpNeg = 14) — zero overhead for positive indices
  if kind == node_constants::NODE_INDEX
    var base_node = ast::ast_get_left(s, node)
    var index_node = ast::ast_get_right(s, node)
    
    # Lower base expression
    var base_val = ctx.mir_lower_expr(s, base_node)
    
    # Check for slice: index is node_constants$NODE_BINARY with op_constants$OP_RANGE (21) or op_constants$OP_RANGE_INCLUSIVE (23)
    var index_kind = ast::ast_get_kind(s, index_node)
    if index_kind == node_constants::NODE_BINARY
      var idx_op = ast::ast_get_op(s, index_node)
      if idx_op == op_constants::OP_RANGE or idx_op == op_constants::OP_RANGE_INCLUSIVE
        # Slice: v[start..end] / v[start...end] / v[..] / v[a..] / v[..b]
        # Parser emits NODE_INT_LIT with value -1 as the "to container size"
        # sentinel for open-ended ranges (v[a..] and v[..]).
        # Detect base type to dispatch slice (Vec base) vs subslice (Slice
        # base) — nested slicing reads a 24-byte Slice header instead of
        # the Vec's 32-byte layout.
        var base_type_str = ctx.mir_infer_expr_type(s, base_node)
        var is_slice_base = 0
        if str_byte_len(base_type_str) >= 5
          var pfx5 = str_byte_slice(base_type_str, 0, 5)
          if pfx5 == "Slice"
            is_slice_base = 1
          end
        end
        # String base: s[a..b] is a codepoint-range substring, not a Vec/Slice
        # header. Dispatch to `str_slice(s, cp_start, cp_end)` and use the
        # codepoint count (`str_size`) as the open-ended-end sentinel.
        var is_string_base = 0
        if base_type_str == "String" or base_type_str == "Str"
          is_string_base = 1
        end
        var range_left = ast::ast_get_left(s, index_node)
        var range_right = ast::ast_get_right(s, index_node)
        var end_is_sentinel = 0
        if ast::ast_get_kind(s, range_right) == node_constants::NODE_INT_LIT
          if ast::ast_get_int_val(s, range_right) == -1
            end_is_sentinel = 1
          end
        end
        var start_val = ctx.mir_lower_expr(s, range_left)
        var end_val = 0
        if end_is_sentinel == 1
          # Sentinel -1 end means "to container size".
          var size_args = vec_new()
          size_args.push(base_val)
          var size_intrinsic = "vec_size"
          if is_slice_base == 1
            size_intrinsic = "slice_size"
          end
          if is_string_base == 1
            size_intrinsic = "str_size"
          end
          end_val = ctx.mir_emit_intrinsic(size_intrinsic, size_args)
        else
          end_val = ctx.mir_lower_expr(s, range_right)
        end
        # Tier 4 #24 Phase 4b §2.4: v[a..b] emits the `slice` intrinsic
        # (24-byte zero-copy Slice<T> header) instead of `vec_slice` (32-byte
        # Vec copy). Inclusive ranges pass end+1 so slice's internal
        # len = end - start computation matches the user's b-inclusive
        # semantics. For Slice base, dispatch to `subslice` which reads the
        # source's 24-byte header layout.
        var slice_end = end_val
        if idx_op == op_constants::OP_RANGE_INCLUSIVE
          var one_val = ctx.mir_emit_const_int(1)
          slice_end = ctx.mir_emit_binary(op_constants::OP_ADD, end_val, one_val)
        end
        var slice_args = vec_new()
        slice_args.push(base_val)
        slice_args.push(start_val)
        slice_args.push(slice_end)
        var slice_intrinsic = "slice"
        if is_slice_base == 1
          slice_intrinsic = "subslice"
        end
        if is_string_base == 1
          slice_intrinsic = "str_slice"
        end
        return ctx.mir_emit_intrinsic(slice_intrinsic, slice_args)
      end
    end
    
    # Check for negative index: node_constants$NODE_UNARY with OpNeg
    var index_val = 0
    if index_kind == 7
      if ast::ast_get_op(s, index_node) == 14
        # Negative index: emit vec_size(base) + (-X)
        var neg_val = ctx.mir_lower_expr(s, index_node)
        var len_args = vec_new()
        len_args.push(base_val)
        var len_val = ctx.mir_emit_intrinsic("vec_size", len_args)
        index_val = ctx.mir_emit_binary(op_constants::OP_ADD, len_val, neg_val)
      else
        index_val = ctx.mir_lower_expr(s, index_node)
      end
    else
      index_val = ctx.mir_lower_expr(s, index_node)
    end
    
    # ======== Loop Vec Optimization: use unchecked access if in a loop ========
    var base_kind = ast::ast_get_kind(s, base_node)
    if base_kind == 6  # node_constants$NODE_IDENT — check if this Vec is in the unchecked set
      var base_name = ast::ast_get_str1(s, base_node)
      var hoisted = ctx.hoisted_vec_ptrs
      for hpi in 0..hoisted.size
        var h_name = as_string(hoisted[hpi])
        if h_name == base_name
          # Found in unchecked set — use vec_get_unchecked intrinsic
          var elem_ann = ast::ast_get_str2(s, node)
          # item 48-b: inside a de-erased bounded-generic body the TC-stamped
          # element annotation is the type-param name `T` (or empty). Resolve it
          # through the specialization context so a value-layout element
          # (`T → Circle`, bound by HOOK #2) reaches codegen as the concrete type
          # and the inline by-address read fires instead of a scalar-word read
          # (which inttoptr's field 0 → SIGSEGV). Gate-0-inert: for a concrete
          # annotation mir_resolve_type_param is identity; the empty-annotation
          # fallback to mir_infer_expr_type only binds when the inferred element
          # is value-layout (T unbound for reference elems → resolves to "").
          if str_byte_len(elem_ann) > 0 and elem_ann != "error"
            elem_ann = mir::mir_resolve_type_param(ctx, elem_ann)
          else
            var inf_elem = ctx.mir_infer_expr_type(s, node)
            if str_byte_len(inf_elem) > 0 and mir::mir_is_value_layout_type(ctx, inf_elem) == 1
              elem_ann = inf_elem
            end
          end
          var get_args = vec_new()
          get_args.push(base_val)
          get_args.push(index_val)
          return ctx.mir_emit_intrinsic_typed("vec_get_unchecked", get_args, elem_ann)
        end
      end
    end
    # ============================================================================
    
    # Create mir$mir::MIR_INDEX instruction
    var dest = ctx.mir_emit_value(mir::MIR_TYPE_INT)
    var instr = mir_new_instr(mir::MIR_INDEX, dest, mir::MIR_TYPE_INT)
    mir_instr_set_operand1(instr, base_val)
    mir_instr_set_operand2(instr, index_val)
    # Thread element type for width-aware codegen (mem-v2)
    var elem_ann = ast::ast_get_str2(s, node)
    # item 48-b: resolve a type-param element annotation (`T`) through the
    # specialization context so a value-layout element read inside a de-erased
    # bounded-generic body takes the inline by-address path. Gate-0-inert:
    # mir_resolve_type_param is identity for concrete annotations; the empty
    # fallback to mir_infer_expr_type only binds when the element is value-layout.
    if str_byte_len(elem_ann) > 0 and elem_ann != "error"
      elem_ann = mir::mir_resolve_type_param(ctx, elem_ann)
    else
      var idx_inf_elem = ctx.mir_infer_expr_type(s, node)
      if str_byte_len(idx_inf_elem) > 0 and mir::mir_is_value_layout_type(ctx, idx_inf_elem) == 1
        elem_ann = idx_inf_elem
      end
    end
    # R2 (C3) — `v[i]` on a `Vec<{ x: Int }>` reads its element type from THIS slot2
    # (via cg_idx_inline_field_count in codegen_instr). A raw record annotation `{ x:
    # Int }` fails the registry exact-match → fc=0 → flat i64 load at stride 1, while
    # the push side (canonicalized) stored at the record's value-layout stride N →
    # layout mismatch → SIGSEGV on the field read. Canonicalize to C1's registered
    # `__rec$...` @value struct name (register first) so the index read takes the
    # inline by-address path at the matching stride. Also handles the empty-annotation
    # fallback via the vec-elem registry, which the LET/param seams canonicalize.
    # GATE-0-INERT: gated on mir_is_record_annotation ⇒ byte-identical.
    if str_byte_len(elem_ann) > 0 and mir::mir_is_record_annotation(elem_ann) and mir::mir_record_is_intersection(elem_ann) == false
      mir::mir_register_record_struct(ctx, elem_ann, s)
      elem_ann = mir::mir_record_canonical_name(elem_ann)
    end
    # Empty/unresolved annotation: recover the canonical record element from the
    # vec-elem registry (populated + canonicalized at the `var v: Vec<{...}>` LET
    # seam), so `v[i]` on a record Vec finds the value-layout stride. Gate-0-inert:
    # the registry carries a `__rec` name only when a record Vec was declared.
    if str_byte_len(elem_ann) == 0 and base_kind == 6
      var idx_reg_elem = ctx.mir_ctx_get_vec_elem_type(ast::ast_get_str1(s, base_node))
      if str_byte_len(idx_reg_elem) > 0 and idx_reg_elem.starts_with("__rec")
        elem_ann = idx_reg_elem
      end
    end
    if str_byte_len(elem_ann) > 0 and elem_ann != "error"
      mir_instr_set_slot2(instr, as_int(elem_ann))
    end
    ctx.mir_emit_instr(instr)
    # R2.2 (GAP-B2 element read) — flow-narrowed element read `v[i]`. Typecheck
    # stamped this NODE_INDEX int_val=1 (typecheck_expr_handlers.qz:~467) when
    # `if v[i] is Member` proved the tag; the loaded element (`dest`) is the union
    # {tag@0,payload@1} cell POINTER (stored boxed, stride-1 by the Edit B widen),
    # so recover the member payload@1 via mir_emit_narrowed_read (a non-niche union
    # falls through its niche checks to the spill load@1). Mirrors the NODE_IDENT
    # (:3312) and NODE_FIELD_ACCESS (:4256) narrowed reads verbatim. INERT at gate 0
    # (no compiler-source index read is narrowed ⇒ int_val stays 0).
    if ast::ast_get_int_val(s, node) == 1
      return mir::mir_emit_narrowed_read(ctx, s, node, dest)
    end
    return dest
  end

  # NodeIndexAssign = 27 (C-aligned): arr[idx] = val -> emit mir$mir::MIR_INDEX_STORE
  # Returns the stored value to support chained assignment: a[0] = a[1] = 42
  # Supports negative indexing: a[-1] = val -> a[vec_size(a) - 1] = val
  if kind == node_constants::NODE_INDEX_ASSIGN
    var arr_node = ast::ast_get_left(s, node)
    var idx_node = ast::ast_get_right(s, node)
    var val_node = ast::ast_get_extra(s, node)
    
    var arr_val = ctx.mir_lower_expr(s, arr_node)
    var val_val = ctx.mir_lower_expr(s, val_node)
    
    # Check for negative index: node_constants$NODE_UNARY with OpNeg
    var idx_kind = ast::ast_get_kind(s, idx_node)
    var idx_val = 0
    if idx_kind == 7
      if ast::ast_get_op(s, idx_node) == 14
        var neg_val = ctx.mir_lower_expr(s, idx_node)
        var la = vec_new()
        la.push(arr_val)
        var lv = ctx.mir_emit_intrinsic("vec_size", la)
        idx_val = ctx.mir_emit_binary(op_constants::OP_ADD, lv, neg_val)
      else
        idx_val = ctx.mir_lower_expr(s, idx_node)
      end
    else
      idx_val = ctx.mir_lower_expr(s, idx_node)
    end
    
    # ======== Loop Vec Optimization: use unchecked access if in a loop ========
    var arr_base_kind = ast::ast_get_kind(s, arr_node)
    if arr_base_kind == 6  # node_constants$NODE_IDENT — check if this Vec is in the unchecked set
      var arr_base_name = ast::ast_get_str1(s, arr_node)
      var hoisted = ctx.hoisted_vec_ptrs
      for hpi in 0..hoisted.size
        var h_name = as_string(hoisted[hpi])
        if h_name == arr_base_name
          # Found in unchecked set — use vec_set_unchecked intrinsic
          var ia_elem_ann = ast::ast_get_str2(s, node)
          var set_args = vec_new()
          set_args.push(arr_val)
          set_args.push(idx_val)
          set_args.push(val_val)
          return ctx.mir_emit_intrinsic_typed("vec_set_unchecked", set_args, ia_elem_ann)
        end
      end
    end
    # ============================================================================
    
    # Create mir$mir::MIR_INDEX_STORE instruction (kind 17)
    var dest = ctx.mir_emit_value(mir::MIR_TYPE_INT)
    var instr = mir_new_instr(mir::MIR_INDEX_STORE, dest, mir::MIR_TYPE_INT)
    mir_instr_set_operand1(instr, arr_val)
    mir_instr_set_operand2(instr, idx_val)
    var args = vec_new()
    args.push(val_val)
    mir_instr_set_args(instr, args)
    # Thread element type for width-aware codegen (mem-v2)
    var ia_elem_ann = ast::ast_get_str2(s, node)
    if str_byte_len(ia_elem_ann) > 0
      mir_instr_set_slot2(instr, as_int(ia_elem_ann))
    end
    ctx.mir_emit_instr(instr)
    return dest  # Return dest which holds the stored value (for chaining)
  end
  
  # NodeMapLit = 12: Create Map and populate with key-value pairs.
  # Detects key type: string/symbol keys → Map<String,V>, integer keys → Map<Int,V>.
  # The key type annotation ("String" or "Int") is propagated to codegen via slot2.
  if kind == node_constants::NODE_MAP_LIT
    var keys = ast::ast_get_extra(s, node)
    var values = ast::ast_get_children(s, node)
    var count = vec_size(keys)
    # Detect if keys are strings/symbols or integers
    var use_string_keys = 0
    if count > 0
      var first_key_kind = ast::ast_get_kind(s, keys[0])
      if first_key_kind == node_constants::NODE_SYMBOL_LIT or first_key_kind == node_constants::NODE_STRING_LIT
        use_string_keys = 1
      elsif mir_is_string_expr(ctx, s, keys[0])
        use_string_keys = 1
      end
    end
    var key_type_ann = "Int"
    if use_string_keys == 1
      key_type_ann = "String"
    end
    var map_result = ctx.mir_emit_intrinsic_typed("map_new", vec_new(), key_type_ann)
    for i in 0..count
      var key_node = keys[i]
      var val_node = values[i]
      var key_val = 0
      if use_string_keys == 1 and ast::ast_get_kind(s, key_node) == node_constants::NODE_SYMBOL_LIT
        # Symbol key :name -> strip leading colon, emit as string constant
        var sym_name = ast::ast_get_str1(s, key_node)
        var str_name = str_byte_slice(sym_name, 1, str_byte_len(sym_name))
        key_val = ctx.mir_emit_const_string(str_name)
      else
        key_val = ctx.mir_lower_expr(s, key_node)
      end
      var val_val = ctx.mir_lower_expr(s, val_node)
      var set_args = vec_new()
      set_args.push(map_result)
      set_args.push(key_val)
      set_args.push(val_val)
      ctx.mir_emit_intrinsic_typed("map_set", set_args, key_type_ann)
    end
    return map_result
  end
  
  # NodeStructInit = 14: allocate struct and populate fields
  if kind == node_constants::NODE_STRUCT_INIT
    # struct_name is at str1 (slot 4), fields vec at children (slot 10)
    var struct_name = ast::ast_get_str1(s, node)
    var fields = ast::ast_get_children(s, node)
    var field_names = ast::ast_get_struct_init_field_names(s, node)
    var field_count = fields.size
    
    # Resolve cross-module struct name
    struct_name = mir_resolve_struct_name(ctx, struct_name)

    # B.10 §12.9 — generic-over-@value selective monomorphization. If this is a
    # generic instantiation (`Box<P>`) whose type-arg is a @value-layout type,
    # synthesize a specialized struct entry (`Box$P`) that lays the value field
    # out INLINE, and retarget construction/access onto it. Non-@value
    # instantiations (and all non-generic structs) get "" back and keep the
    # byte-identical Boxed path untouched (the fixpoint-safety invariant).
    var inline_value = 0
    var type_args_csv = ast::ast_get_str2(s, node)
    if str_byte_len(type_args_csv) > 0
      var ta_concrete = str_split(type_args_csv, ",")
      var ta_trimmed = vec_new<String>()
      for tai in 0..ta_concrete.size
        # item 32 — resolve a type-param type-arg (`ITLift<I> { ... }` inside the
        # monomorphized `it_make_lift<I=ITBase>`) to its concrete binding so the
        # construction site agrees with the value-layout READ side. Without this
        # the arg stays the bare param name `I` (not @value) ⇒ reference-layout
        # construction, while `ITLift$itg_go$ITBase` reads it value-inlined ⇒ the
        # `source` pointer/value mismatch (`genfn BAD`). Gate-0-inert: for a
        # non-@value concrete arg mir_synth_value_layout_struct still returns ""
        # (byte-identical); resolution is a no-op when the arg is already concrete.
        var ta_one = str_trim(as_string(ta_concrete[tai]))
        ta_one = mir::mir_resolve_type_param(ctx, ta_one)
        ta_trimmed.push(ta_one)
      end
      var base_tp_csv = mir::mir_get_struct_type_params(struct_name)
      var base_tp_names = mir::mir_struct_type_param_names(base_tp_csv)
      var spec_struct = mir::mir_synth_value_layout_struct(ctx, struct_name, base_tp_names, ta_trimmed)
      if str_byte_len(spec_struct) > 0
        struct_name = spec_struct
        inline_value = 1
      end
    end

    var has_narrow = mir_struct_has_narrow_fields(ctx, struct_name)

    # Determine total field count from struct definition for allocation
    var total_field_count = field_count
    var struct_fields_info = ctx.mir_ctx_get_struct_fields(struct_name)
    if struct_fields_info.is_some()
      var def_field_names = struct_fields_info.unwrap().field_names
      total_field_count = vec_size(def_field_names)
    end

    # Allocate memory for the struct (always total field count)
    var struct_ptr = 0
    var is_value_struct = ctx.mir_ctx_is_value_struct(struct_name)
    # B.10 §14.12.8 (C3) — COW construct. A cow-layout (>16B FLAT @value) struct is
    # built as a HEAP refcount buffer (1+N words: word 0 = atomic refcount = 1,
    # words 1..N = fields) instead of a stack alloca. Takes precedence over the
    # is_value stack-alloca arm (cow structs ARE @value, but outlive their scope /
    # cross tasks ⇒ must be heap). Field stores below detect this via
    # _mir_construct_is_cow and emit with the +1 shift flag set. INERT at gate 0
    # (predicate false ⇒ falls through to the existing is_value arm unchanged).
    # F4c (R6) — an ARENA-placed struct is NEVER COW: it is allocated flat from the
    # arena (offset+0, no refcount header) and reclaimed by arena_destroy. Force the
    # cow-construct flag off so the field stores below use the plain offset+0 path
    # (NOT the +1 cow shift, which would write past the header-less arena buffer →
    # heap corruption). The ratified arena-non-COW carve-out. INERT at gate 0 (the
    # cow predicate is false for plain structs pre-flip regardless).
    var _mir_construct_is_cow = mir::mir_value_is_cow_layout(ctx, struct_name)
    if _mir_alloc_arena_target != ""
      _mir_construct_is_cow = 0
    end
    if _mir_alloc_arena_target == "" and _mir_construct_is_cow == 1
      struct_ptr = mir::mir_emit_cow_construct_buffer(ctx, total_field_count, struct_name)
    elsif _mir_alloc_arena_target != "" and is_value_struct != 1
      # Arena-placed struct: allocate from named arena instead of malloc
      var arena_handle = ctx.mir_emit_load_var(_mir_alloc_arena_target)
      var size_val = ctx.mir_emit_const_int(total_field_count * 8)
      var arena_args = vec_new<Int>()
      arena_args.push(arena_handle)
      arena_args.push(size_val)
      struct_ptr = ctx.mir_emit_intrinsic("arena_alloc", arena_args)
    elsif is_value_struct == 1
      # @value struct: use stack alloca instead of malloc
      struct_ptr = ctx.mir_emit_alloc_stack(total_field_count, struct_name)
    elsif inline_value == 1
      # B.10 §12.9 — inline-value generic spec: typed heap alloc sized from
      # `%struct.Box$P` (which embeds the @value field), so the box is wide
      # enough to hold the inline struct, not just a pointer slot.
      struct_ptr = ctx.mir_emit_alloc_typed(total_field_count, struct_name)
    elsif has_narrow == 1
      struct_ptr = ctx.mir_emit_alloc_typed(total_field_count, struct_name)
    elsif mir::mir_is_value_layout_type(ctx, struct_name) == 1
      # B.10 Phase 4 F0/F4a (INERT at gate=0): default-struct-layout flip. A plain
      # eligible struct routes to the @value stack-alloca / value-layout path
      # (same call the is_value==1 arm uses) instead of the Boxed mir_emit_alloc.
      # Routed through mir_is_value_layout_type — the SINGLE layout key — so the
      # construct and the copy/read/byval consumers (which all consult the same
      # predicate, name-RESOLVED) cannot disagree (the f4-steps §4 construct/read
      # oracle-agreement rule: name resolution must be identical at both ends, else
      # a firewall-excluded struct can box at construct yet copy at assign).
      # DEAD while mir_default_struct_value_live()==0 — gate-0 IR byte-identical.
      struct_ptr = ctx.mir_emit_alloc_stack(total_field_count, struct_name)
    else
      struct_ptr = ctx.mir_emit_alloc(total_field_count)
    end

    # Track which fields were provided (by their definition index)
    var provided_indices = vec_new()

    # Lower each field expression and store at correct offset
    # Use field names to look up actual struct definition indices
    for i in 0..field_count
      var field_node = fields[i]

      # Look up the correct field index from struct definition
      var actual_idx = i  # Default to literal order as fallback
      var field_type = ""
      var fname_resolved = ""
      if field_names != 0
        var name_ptr = field_names[i]
        var fname = as_string(name_ptr)
        fname_resolved = fname
        var idx = ctx.mir_ctx_find_field_index(struct_name, fname)
        if idx >= 0
          actual_idx = idx
          field_type = ctx.mir_ctx_get_field_type(struct_name, fname) if has_narrow == 1
        end
      end

      # B.10 §12.9 — inline-value field: the declared field type is a @value
      # struct embedded inline. Lower its initializer to a pointer, take the
      # interior address of this field within the box (typed GEP), and word-copy
      # the @value aggregate in place rather than storing a heap pointer slot.
      var field_is_inline_value = 0
      if inline_value == 1 and str_byte_len(fname_resolved) > 0
        var decl_ft = ctx.mir_ctx_get_field_type(struct_name, fname_resolved)
        # item 39 — symmetric guard with the §12.9 read site: a PRIMITIVE/builtin
        # scalar field can never be an embedded @value struct, so it must take the
        # plain single-word store path, not the inline-value word-copy. Without this
        # the suffix-match in mir_resolve_struct_name (e.g. "Int" vs a synthesized
        # spec ending `$Int`) makes the construct word-copy the scalar as if it were
        # a pointer to a @value aggregate.
        if mir::mir_is_value_layout_type(ctx, decl_ft) == 1 and
           mir::mir_is_scalar_field_type(decl_ft) == 0
          field_is_inline_value = 1
          var src_ptr = ctx.mir_lower_expr(s, field_node)
          var dst_addr = ctx.mir_emit_field_addr(struct_ptr, actual_idx, struct_name)
          var vstruct = mir_resolve_struct_name(ctx, decl_ft)
          var words = mir_ctx_struct_field_count(ctx, vstruct)
          for wk in 0..words
            var wval = ctx.mir_emit_load_offset(src_ptr, wk)
            ctx.mir_emit_store_offset(dst_addr, wk, wval)
          end
        end
      end

      provided_indices.push(actual_idx)

      # B.10 §14 N3 6.3d — a bare `Option::None` (or `Some(P)`) written DIRECTLY as
      # a struct-init field value (e.g. `base10_17: Option::None`) has no lvalue
      # local to supply its payload type. Set the niche-construction expected type
      # from the field's DECLARED type so the None niches to match the field-typed
      # read. Scoped strictly around this field's lowering; niche-gated ⇒
      # byte-identical IR flag-OFF (mir_ctx_set_niche_expected is consulted only on
      # the niche construction path, which is inert when the master flag is off).
      var n63d_si_set = 0
      if str_byte_len(fname_resolved) > 0
        var n63d_decl_ft = ctx.mir_ctx_get_field_type(struct_name, fname_resolved)
        if n63d_decl_ft.starts_with("Option<")
          mir::mir_ctx_set_niche_expected(ctx, n63d_decl_ft)
          n63d_si_set = 1
        end
      end

      if _mir_construct_is_cow == 1
        # B.10 §14.12.8 (C3) — COW buffer field store. Field f → buffer word f+1
        # (word 0 = refcount). Set the +1 shift flag around the single offset
        # store. The buffer is a flat i64-word block, so all fields (incl. narrow)
        # store one word here. INERT at gate 0 (this arm unreachable when the
        # predicate is false ⇒ the existing arms run unchanged).
        var field_val_cow = ctx.mir_lower_expr(s, field_node)
        field_val_cow = mir_maybe_copy_value_field_init(ctx, s, field_node, field_val_cow)
        mir::mir_ctx_set_cow_field_shift(ctx, 1)
        ctx.mir_emit_store_offset(struct_ptr, actual_idx, field_val_cow)
        mir::mir_ctx_set_cow_field_shift(ctx, 0)
      elsif field_is_inline_value == 1
        # already stored inline above
      elsif inline_value == 1
        # B.10 §12.9 — a non-@value field of an inline-value spec must still be
        # addressed through the typed `%struct.Name` GEP (logical field index →
        # real byte offset), because an inline @value field shifts later fields
        # off the flat i64-word grid. Using an untyped i64 offset here would
        # alias the embedded struct's tail (the PAIR_P_INT regression).
        var field_val_iv = ctx.mir_lower_expr(s, field_node)
        field_val_iv = mir_maybe_copy_value_field_init(ctx, s, field_node, field_val_iv)
        var decl_ft_iv = ctx.mir_ctx_get_field_type(struct_name, fname_resolved)
        ctx.mir_emit_store_field(struct_ptr, actual_idx, field_val_iv, struct_name, decl_ft_iv)
      elsif has_narrow == 1
        var field_val = ctx.mir_lower_expr(s, field_node)
        field_val = mir_maybe_copy_value_field_init(ctx, s, field_node, field_val)
        ctx.mir_emit_store_field(struct_ptr, actual_idx, field_val, struct_name, field_type)
      else
        var field_val2 = ctx.mir_lower_expr(s, field_node)
        field_val2 = mir_maybe_copy_value_field_init(ctx, s, field_node, field_val2)
        ctx.mir_emit_store_offset(struct_ptr, actual_idx, field_val2)
      end
      if n63d_si_set == 1
        mir::mir_ctx_clear_niche_expected(ctx)
      end
    end

    # Fill in default values for omitted fields
    if field_count < total_field_count
      var defaults_info = ctx.mir_ctx_get_struct_defaults(struct_name)
      if defaults_info.is_some()
        var di_v = defaults_info.unwrap()
        var defaults_vec = di_v[0]
        var def_ast_store = di_v[1]
        for di in 0..total_field_count
          # Check if this field was provided
          var was_provided = false
          for pi in 0..provided_indices.size
            if provided_indices[pi] == di
              was_provided = true
            end
          end
          if was_provided == false
            # Field not provided — fill with default value
            var default_node = defaults_vec[di]
            if default_node != 0
              var default_val = ctx.mir_lower_expr(def_ast_store, default_node)
              if _mir_construct_is_cow == 1
                # B.10 §14.12.8 (C3) — default into COW buffer word di+1.
                mir::mir_ctx_set_cow_field_shift(ctx, 1)
                ctx.mir_emit_store_offset(struct_ptr, di, default_val)
                mir::mir_ctx_set_cow_field_shift(ctx, 0)
              elsif has_narrow == 1 or inline_value == 1
                # Inline-value specs: route scalar defaults through the typed GEP
                # so byte offsets stay correct past the embedded @value field.
                # (A @value field default would need an inline struct literal —
                # out of v1 scope; such fields are always explicitly provided.)
                var def_field_names2 = struct_fields_info.unwrap().field_names
                var dfname = def_field_names2[di]
                var dfield_type = ctx.mir_ctx_get_field_type(struct_name, dfname)
                ctx.mir_emit_store_field(struct_ptr, di, default_val, struct_name, dfield_type)
              else
                ctx.mir_emit_store_offset(struct_ptr, di, default_val)
              end
            else
              # No default and not provided — store 0 as fallback
              var zero_val = ctx.mir_emit_const_int(0)
              if _mir_construct_is_cow == 1
                mir::mir_ctx_set_cow_field_shift(ctx, 1)
                ctx.mir_emit_store_offset(struct_ptr, di, zero_val)
                mir::mir_ctx_set_cow_field_shift(ctx, 0)
              else
                ctx.mir_emit_store_offset(struct_ptr, di, zero_val)
              end
            end
          end
        end
      end
    end

    return struct_ptr
  end
  
  # NodeFieldAccess = 15: load field from struct pointer
  if kind == node_constants::NODE_FIELD_ACCESS
    # slot 7 = base expression (struct), slot 4 = field name
    var base_node = ast::ast_get_left(s, node)
    var field_name = ast::ast_get_str1(s, node)

    # Lower the base expression to get struct pointer
    var base_val = ctx.mir_lower_expr(s, base_node)

    # Numeric field name for tuple access: .0, .1, .2, ...
    var fn_first = str_byte_at(field_name, 0)
    if fn_first >= 48 and fn_first <= 57
      var field_idx = str_to_int(field_name)
      return ctx.mir_emit_load_offset(base_val, field_idx)
    end

    # Infer the struct type of the base expression recursively.
    # This handles simple idents (r), chained accesses (r.routes[i]),
    # function call results (handler(req)), and struct inits.
    var struct_type = ctx.mir_infer_expr_type(s, base_node)

    # B.10 §12.9 — inline-value generic field read. If the base is a generic
    # instantiation at a @value type (`Box<P>`), resolve to the synthesized
    # inline-value spec (`Box$P`); if `field_name` is the embedded @value field,
    # return its INTERIOR address (a typed GEP, no load) so the trailing `.x`
    # reads inline (single indirection) instead of chasing a boxed pointer.
    if str_byte_len(struct_type) > 0
      var iv_lt = __char_index(struct_type, '<')
      if iv_lt > 0
        var iv_base = str_byte_slice(struct_type, 0, iv_lt)
        var iv_gt = __char_index(struct_type, '>')
        if iv_gt > iv_lt
          var iv_args_csv = str_byte_slice(struct_type, iv_lt + 1, iv_gt)
          var iv_args = str_split(iv_args_csv, ",")
          var iv_trim = vec_new<String>()
          for iai in 0..iv_args.size
            iv_trim.push(str_trim(as_string(iv_args[iai])))
          end
          var iv_base_resolved = mir_resolve_struct_name(ctx, iv_base)
          var iv_tp = mir::mir_get_struct_type_params(iv_base_resolved)
          var iv_tp_names = mir::mir_struct_type_param_names(iv_tp)
          var iv_spec = mir::mir_synth_value_layout_struct(ctx, iv_base_resolved, iv_tp_names, iv_trim)
          if str_byte_len(iv_spec) > 0
            var iv_fidx = ctx.mir_ctx_find_field_index(iv_spec, field_name)
            if iv_fidx >= 0
              var iv_ft = ctx.mir_ctx_get_field_type(iv_spec, field_name)
              # item 39 — a PRIMITIVE/builtin scalar field (Int/Bool/F64/...) can
              # never be an embedded @value struct, so it must ALWAYS take the load
              # branch. Guard against mir_resolve_struct_name suffix-matching a bare
              # type-arg name (e.g. "Int") against a synthesized spec like
              # `GVPair$GVPoint$Int` (ends in `$Int`), which would wrongly report the
              # scalar as value-layout and return its ADDRESS via FIELD_ADDR.
              if mir::mir_is_value_layout_type(ctx, iv_ft) == 1 and
                 mir::mir_is_scalar_field_type(iv_ft) == 0
                # Embedded @value field: return its interior address (no load),
                # so the trailing `.x` reads inline.
                return ctx.mir_emit_field_addr(base_val, iv_fidx, iv_spec)
              else
                # Non-@value field of an inline-value spec: load through the
                # typed `%struct.Name` GEP so the inline @value field's extra
                # width shifts this field to its real byte offset.
                return ctx.mir_emit_load_field(base_val, iv_fidx, iv_spec, iv_ft)
              end
            end
          end
        end
      end
    end

    if str_byte_len(struct_type) > 0
      # Strip generic type args for struct registry lookup (e.g., "GBox<Int>" -> "GBox")
      var lt_pos = __char_index(struct_type, '<')
      if lt_pos > 0
        struct_type = str_byte_slice(struct_type, 0, lt_pos)
      end
      # Builtin-collection .size/.length: dispatch to the size intrinsic.
      # Typecheck normally rewrites `.size` on Vec/Map/String/Set to the
      # corresponding `*_size` call, but compute expressions on binary
      # blocks skip typecheck re-entry, so handle the rewrite here.
      if field_name == "size" or field_name == "length"
        var size_intrinsic = ""
        if struct_type == "Vec" or struct_type == "Array"
          size_intrinsic = "vec_size"
        elsif struct_type == "String"
          size_intrinsic = "str_size"
        elsif struct_type == "Map"
          size_intrinsic = "map_size"
        elsif struct_type == "Set"
          size_intrinsic = "set_size"
        end
        if str_byte_len(size_intrinsic) > 0
          var size_args = vec_new()
          size_args.push(base_val)
          return ctx.mir_emit_intrinsic(size_intrinsic, size_args)
        end
      end
      # Resolve cross-module struct name (e.g. "ParserState" -> "parser$ParserState")
      var resolved_type = mir_resolve_struct_name(ctx, struct_type)
      # Look up field index in struct registry
      var field_idx = ctx.mir_ctx_find_field_index(resolved_type, field_name)
      if field_idx >= 0
        # F4c (R6) — arena-owned receiver: an arena-placed value-layout struct is a
        # FLAT offset+0 buffer with NO refcount header, so its field reads must NOT
        # apply the COW +1 shift (doing so reads one word past the field / off the
        # end → segfault). Suppress the cow read branch when the base ident is
        # arena-owned (the ratified arena-non-COW carve-out). INERT at gate 0
        # (no arena-owned binding is cow-layout pre-flip ⇒ this never diverges).
        var _far_arena = mir_field_base_is_arena_owned(ctx, s, base_node)
        # B.10 §14.12.8 (C3) — COW buffer field read: field f → buffer word f+1
        # (word 0 = refcount). Set the +1 shift flag around the single load. Takes
        # precedence over the narrow typed-GEP path: a cow buffer is a flat i64
        # block, so every field (incl. narrow) reads one word. INERT at gate 0.
        if mir::mir_value_is_cow_layout(ctx, resolved_type) == 1 and _far_arena == 0
          mir::mir_ctx_set_cow_field_shift(ctx, 1)
          var cow_fv = ctx.mir_emit_load_offset(base_val, field_idx)
          mir::mir_ctx_set_cow_field_shift(ctx, 0)
          return cow_fv
        end
        if mir_struct_has_narrow_fields(ctx, resolved_type)
          var ft = ctx.mir_ctx_get_field_type(resolved_type, field_name)
          return ctx.mir_emit_load_field(base_val, field_idx, resolved_type, ft)
        else
          var fa_field_val = ctx.mir_emit_load_offset(base_val, field_idx)
          # GAP-B2-nonident-narrow — flow-narrowed union field read. Typecheck stamped
          # this NODE_FIELD_ACCESS int_val=1 when `if s.u is Member` proved the tag; the
          # field word is the tagged union CELL `{tag@0, payload@1}` (B1/B3), so recover
          # the member payload@1 via mir_emit_narrowed_read (union falls through its
          # niche checks to the spill load@1). Mirrors the NODE_IDENT narrowed read.
          # INERT at gate 0 (no compiler-source field is narrowed ⇒ int_val stays 0).
          if ast::ast_get_int_val(s, node) == 1
            return mir::mir_emit_narrowed_read(ctx, s, node, fa_field_val)
          end
          return fa_field_val
        end
      end
    end

    # Fallback: search all registered structs for this field (record/intersection types)
    var global_result = mir_find_field_globally(ctx, field_name)
    if global_result.size > 0
      var gf_sname = as_string(global_result[0])
      var gf_idx = global_result[1]
      # R2 (C1/§3.3) — intersection (`{A}&{B}`) params resolve field reads through this
      # global fallback rather than a canonical merged record. When the physical value
      # is a >16B COW source struct (`Vec3` passed to `{x}&{y}&{z}`), field f lives at
      # buffer word f+1 (word 0 = refcount header). Without the shift, `r.x` reads the
      # header (the "merges three" 42→24 miscompile). Apply the +1 shift keyed on the
      # FOUND struct's own cow-layout, matching the nominal read path (line 4094).
      # GATE-0-INERT: no compiler/stdlib field-access reaches this fallback against a
      # cow-layout struct (records/intersections are user-program-only) ⇒ byte-identical.
      if mir::mir_value_is_cow_layout(ctx, gf_sname) == 1
        mir::mir_ctx_set_cow_field_shift(ctx, 1)
        var gf_cow = ctx.mir_emit_load_offset(base_val, gf_idx)
        mir::mir_ctx_set_cow_field_shift(ctx, 0)
        return gf_cow
      end
      return ctx.mir_emit_load_offset(base_val, gf_idx)
    end

    # Final fallback: emit warning and use field index 0
    # Suppress for unchanged modules in incremental mode (TC skipped their bodies,
    # so str2 annotations are missing — expected, codegen loads cached fragments).
    if _mir_suppress_warnings == 0
      var d = diagnostic::diag_new_simple(diagnostic::DIAG_WARNING, "QZ0603", "cannot resolve struct type for field access '.#{field_name}', using offset 0")
      diagnostic::diag_emit(d)
    end
    return ctx.mir_emit_load_offset(base_val, 0)
  end
  
  # NodeSafeFieldAccess = 16 (safe navigation: u?.field)
  return mir_lower_expr_handlers::mir_lower_safe_field_access(ctx, s, node) if kind == node_constants::NODE_SAFE_FIELD_ACCESS

  # NodeBinaryWith = 96 — `value.with { field = expr; ... }` (STEP 5).
  # Allocates a new struct, copies each field from the receiver unless
  # overridden. Receiver type is resolved via mir_infer_expr_type to
  # find the struct's field ordering.
  if kind == node_constants::NODE_BINARY_WITH
    var bw_base = ast::ast_get_left(s, node)
    var bw_base_val = mir_lower_expr(ctx, s, bw_base)
    var bw_base_type = ctx.mir_infer_expr_type(s, bw_base)
    var bw_resolved = mir_resolve_struct_name(ctx, bw_base_type)
    var bw_field_count = ctx.mir_ctx_struct_field_count(bw_resolved)
    if bw_field_count <= 0
      return bw_base_val
    end
    var bw_children = ast::ast_get_children(s, node)
    var bw_alloc = ctx.mir_emit_alloc(bw_field_count)
    # Emit an inttoptr for the base so we can load fields from it.
    for bw_i in 0..bw_field_count
      var bw_fname = ctx.mir_ctx_struct_field_name(bw_resolved, bw_i)
      var bw_override_val = -1
      if bw_children != 0
        for bw_ci in 0..bw_children.size
          var bw_entry = bw_children[bw_ci]
          var bw_en_name = ast::ast_get_str1(s, bw_entry)
          if bw_en_name.eq(bw_fname)
            bw_override_val = mir_lower_expr(ctx, s, ast::ast_get_left(s, bw_entry))
          end
        end
      end
      if bw_override_val >= 0
        ctx.mir_emit_store_offset(bw_alloc, bw_i, bw_override_val)
      else
        var bw_loaded = ctx.mir_emit_load_offset(bw_base_val, bw_i)
        ctx.mir_emit_store_offset(bw_alloc, bw_i, bw_loaded)
      end
    end
    return bw_alloc
  end

  # NodeTypeCast = 97 — `expr as TypeName` (Binary DSL STEP 3).
  # Resolves to MIR_PACKED_BITCAST when one side is a registered packed
  # layout; otherwise passes the source value through unchanged.
  if kind == node_constants::NODE_TYPE_CAST
    var tc_src = ast::ast_get_left(s, node)
    var tc_val = mir_lower_expr(ctx, s, tc_src)
    var tc_target = ast::ast_get_str1(s, node)
    var tc_prog = ctx.mir_ctx_get_program()
    var tc_layout = mir_find_binary_layout(tc_prog, tc_target)
    if tc_layout >= 0
      # Int → packed struct (direction 1)
      return ctx.mir_emit_packed_bitcast(tc_layout, tc_val, 1)
    end
    # Try source-side: fetch its struct name and check if it's a packed layout.
    var tc_src_struct = ctx.mir_infer_expr_type(s, tc_src)
    if str_byte_len(tc_src_struct) > 0
      var tc_lt = __char_index(tc_src_struct, '<')
      if tc_lt > 0
        tc_src_struct = str_byte_slice(tc_src_struct, 0, tc_lt)
      end
      tc_layout = mir_find_binary_layout(tc_prog, tc_src_struct)
      if tc_layout >= 0
        # Packed struct → integer (direction 0)
        return ctx.mir_emit_packed_bitcast(tc_layout, tc_val, 0)
      end
    end
    # Not a packed cast — just return the source value unchanged.
    return tc_val
  end
  
  # NodeEnumAccess = 39 (enum constructor expression: Option::Some(42))
  if kind == node_constants::NODE_ENUM_ACCESS
    var base_enum_name = ast::ast_get_enum_name(s, node)
    # Tier 4 #24 Phase 4b §2.3: Slice::EMPTY / SliceMut::EMPTY short-circuit
    # to the slice_empty intrinsic. Emitted before enum-name resolution
    # because Slice isn't a user-defined enum.
    var se_variant = ast::ast_get_variant(s, node)
    if se_variant == "EMPTY"
      if base_enum_name == "Slice" or base_enum_name == "SliceMut"
        var empty_args = vec_new()
        return ctx.mir_emit_intrinsic("slice_empty", empty_args)
      end
    end
    # Resolve to qualified name (e.g., "Color" -> "mod_colors$Color")
    var enum_name = mir_resolve_enum_name(ctx, base_enum_name)
    var variant_name = ast::ast_get_variant(s, node)
    var payloads = ast::ast_get_payloads(s, node)
    var tag_idx = mir_find_variant_index_ctx(ctx, enum_name, variant_name)
    var tag_val = ctx.mir_emit_const_int(tag_idx)
    
    # Check if this is a payload variant (Some(x)) or unit variant (None)
    var has_payload = 0
    if payloads != 0
      if payloads.size > 0
        has_payload = 1
      end
    end
    
    # Use stack allocation for Option/Result enums (escape analysis promotes to heap when needed)
    var use_stack = enum_name == "Option" or enum_name == "Result"

    # B.10 §14 N1 — niche-layout Option construction. The concrete payload type
    # is recovered the SAME way the read sites recover it (mir_option_* SoT), so
    # construct and read can't disagree (§14.4). Under niche layout there is no
    # tag word and no alloc: `Some(x)` IS the identity of `x`, `None` IS the
    # niche constant. `None`'s type comes from the ambient expected type (its
    # node has no payload). SPILL (everything the compiler/std uses, and any
    # undeterminable type) falls through to the byte-identical legacy path below.
    if enum_name == "Option" and (variant_name == "Some" or variant_name == "None")
      var n_pt = mir::mir_option_construction_payload(ctx, s, node, variant_name)
      if str_byte_len(n_pt) > 0 and mir::mir_option_is_niche(ctx, n_pt) == 1
        if variant_name == "Some"
          return ctx.mir_lower_expr(s, payloads[0])
        end
        return ctx.mir_emit_const_int(mir::mir_option_none_const(ctx, n_pt))
      end
    end

    # enum-niche M2 — niche-multi built-in Result construction. `Ok(x)`/`Err(e)` of a
    # `Result<A,B>` whose BOTH args are boxed niches to ONE word: `Ok(x)` IS `x` (tag
    # 0 = bare pointer, FREE), `Err(e)` IS `e | 1`. The concrete `Result<A,B>` comes
    # from the ambient expected type (the same source the read side uses ⇒ no
    # construct/read disagreement, §14.4). SPILL Results (scalar payload, or no ambient
    # type) fall through to the byte-identical legacy box path. Gated ⇒ dead while OFF
    # (`mir_result_type_is_niche_multi` returns 0). ONE i64 SSA value (invariant #5).
    if enum_name == "Result" and (variant_name == "Ok" or variant_name == "Err")
      if has_payload == 1
        var r_ty = mir::mir_result_construction_type(ctx, s, node, variant_name)
        if str_byte_len(r_ty) > 0 and mir::mir_result_type_is_niche_multi(ctx, r_ty) == 1
          var r_ptr = ctx.mir_lower_expr(s, payloads[0])
          if tag_idx == 0
            # Ok ⇒ the word IS the bare pointer (no OR — free).
            return r_ptr
          end
          var r_tag = ctx.mir_emit_const_int(tag_idx)
          return ctx.mir_emit_binary(op_constants::OP_OR, r_ptr, r_tag)
        end
      end
    end

    # General single-payload+K-dataless user enum (gated). Under niche layout there
    # is no tag word and no alloc: the PAYLOAD variant IS the identity of its single
    # boxed payload (the pointer); each DATALESS variant IS its bottom-niche scalar
    # ({0..K-1}, declaration order among dataless variants). Built-in Option/Result
    # keep their dedicated paths above; SPILL enums fall through byte-identically.
    if enum_name != "Option" and enum_name != "Result"
      var g_layout = mir::mir_enum_single_payload_layout(ctx, enum_name)
      if mir::mir_enum_niche_payload_idx(g_layout) >= 0 and g_layout[0] == 1
        if has_payload == 1
          # Payload variant — identity of the single boxed payload.
          return ctx.mir_lower_expr(s, payloads[0])
        end
        # Dataless variant — its bottom-niche scalar.
        var g_scalar = mir::mir_enum_dataless_niche_scalar(ctx, enum_name, tag_idx)
        if g_scalar >= 0
          return ctx.mir_emit_const_int(g_scalar)
        end
      end
    end

    # B.10 §14.9 multi-payload M1 (gated ⇒ dead code while the gate is OFF). An
    # enum with exactly two single-boxed-payload variants niches to ONE word:
    # variant i ⇒ `payload_ptr | tag_idx` (tag = declaration index in the low spare
    # bits; Ok=0 ⇒ bare ptr, Err=1 ⇒ ptr|1). No tag word, no alloc. The payload's
    # low `low_zero` bits are known-zero (boxed, 8-aligned), so OR-ing the tag is
    # lossless and the read masks it out. ONE i64 SSA value (the §4 invariant).
    # SPILL enums fall through to the byte-identical legacy box path below.
    if enum_name != "Option" and enum_name != "Result"
      if has_payload == 1
        if mir::mir_multi_enum_is_niche(ctx, enum_name) == 1
          var m_ptr = ctx.mir_lower_expr(s, payloads[0])
          if tag_idx == 0
            # Tag 0 ⇒ the word IS the bare pointer (no OR needed — free).
            return m_ptr
          end
          var m_tag = ctx.mir_emit_const_int(tag_idx)
          return ctx.mir_emit_binary(op_constants::OP_OR, m_ptr, m_tag)
        end
      end
    end

    # enum-niche 3b — DATALESS variant of a niche-multi enum (gated ⇒ dead while
    # mir_multi_niche_dataless_mix_live() == 0). A dataless variant encodes as the
    # SMALL INTEGER equal to its DECLARATION index (`0 | tag_idx = tag_idx`), in an
    # otherwise-zero word. This is the SAME decl-index tag space the payload variants
    # pack into the low spare bits (NOT a separate {0..K-1} dataless numbering), so the
    # read side's `value & 7` recovers `tag_idx` for both payload and dataless variants
    # uniformly. No collision with a real payload word `ptr | tag_j` (boxed ptrs ≥ 4096
    # ⇒ `ptr & ~7` is nonzero, but a dataless word has all high bits zero). No alloc, no
    # tag word. Dataless match arms bind no payload ⇒ the read never derefs this word.
    # ATOMIC with the eligibility relaxation in mir_multi_enum_common_spare (same gate).
    if enum_name != "Option" and enum_name != "Result"
      if has_payload == 0 and mir_multi_niche_dataless_mix_live() == 1
        if mir::mir_multi_enum_is_niche(ctx, enum_name) == 1
          return ctx.mir_emit_const_int(tag_idx)
        end
      end
    end

    if has_payload == 1
      # Payload variant: allocate 1 + N words, store tag + all payload fields.
      var payload_count = payloads.size

      # B.10 §12.10 — detect inline @value payloads (Option/Result, v1). A @value
      # struct payload is embedded INLINE in the enum (its words live in the
      # payload area) instead of boxing a pointer. Pre-scan each payload's width
      # so the enum is sized to fit. Byte-identical to the legacy path when no
      # payload is @value (all widths 1 ⇒ same size + offsets), keeping the
      # compiler/std self-compile — which has zero @value enum payloads —
      # unchanged (fixpoint-safe).
      var is_oR = enum_name == "Option" or enum_name == "Result"
      var any_inline = 0
      var widths = vec_new<Int>()
      var inlines = vec_new<Int>()
      if is_oR == 1
        for pi0 in 0..payload_count
          var ptype0 = ctx.mir_infer_expr_type(s, payloads[pi0])
          var w0 = 1
          var inl0 = 0
          if str_byte_len(ptype0) > 0
            var pres0 = mir_resolve_struct_name(ctx, mir_strip_generic_head(ptype0))
            # item 36 — single layout key (flip-eligible plain OR @value); gate-0
            # inert ⇒ byte-identical. resolved name re-resolves idempotently.
            if mir::mir_is_value_layout_type(ctx, pres0) == 1
              var fc0 = ctx.mir_ctx_struct_field_count(pres0)
              if fc0 >= 1
                w0 = fc0
                inl0 = 1
                any_inline = 1
              end
            end
          end
          widths.push(w0)
          inlines.push(inl0)
        end
      end

      if any_inline == 1
        # Inline path: size = 1 (tag) + Σ payload widths; @value payloads are
        # word-copied into the payload area, scalars stored as one word.
        var total_words = 0
        for wi in 0..payload_count
          total_words = total_words + as_int(widths[wi])
        end
        var enum_ptr_v = 0
        if use_stack
          enum_ptr_v = ctx.mir_emit_alloc_stack(1 + total_words, enum_name)
        else
          enum_ptr_v = ctx.mir_emit_alloc(1 + total_words)
        end
        ctx.mir_emit_store_offset(enum_ptr_v, 0, tag_val)
        var off = 1
        for pi1 in 0..payload_count
          var pval1 = ctx.mir_lower_expr(s, payloads[pi1])
          var w1 = as_int(widths[pi1])
          if as_int(inlines[pi1]) == 1
            # Copy the @value's FIELD words inline (pval1 is a pointer to its
            # words). A >16B (field_count >= 3) value-layout payload is a COW
            # buffer — `[refcount@0, f0@1, …, f(n-1)@n]` — so its fields live at
            # words 1..1+w1, NOT 0..w1. Reading from word 0 would copy the
            # refcount header in place of f0 and shift every field by one word
            # (and drop the last field), the silent off-by-tag enum-payload
            # miscompile. A <=16B value-layout payload (field_count <= 2) is a
            # flat stack `[f0@0, f1@1]` with NO header, so its read base is 0.
            # The enum payload itself stays a FLAT header-less copy either way,
            # so the (flat, offset+0) match-arm read agrees. Keyed on
            # mir_value_is_cow_layout ⇒ INERT at gate 0 (predicate false ⇒
            # src_base 0 ⇒ byte-identical to the legacy inline copy).
            var src_base = 0
            var p1ty = ctx.mir_infer_expr_type(s, payloads[pi1])
            if str_byte_len(p1ty) > 0
              var p1res = mir_resolve_struct_name(ctx, mir_strip_generic_head(p1ty))
              if mir::mir_value_is_cow_layout(ctx, p1res) == 1
                src_base = 1
              end
            end
            for k in 0..w1
              var word_k = ctx.mir_emit_load_offset(pval1, src_base + k)
              ctx.mir_emit_store_offset(enum_ptr_v, off + k, word_k)
            end
          else
            ctx.mir_emit_store_offset(enum_ptr_v, off, pval1)
          end
          off = off + w1
        end
        return enum_ptr_v
      end

      # Legacy boxed path (byte-identical) — one word per payload field.
      var enum_ptr = 0
      if use_stack
        enum_ptr = ctx.mir_emit_alloc_stack(1 + payload_count, enum_name)
      else
        enum_ptr = ctx.mir_emit_alloc(1 + payload_count)
      end
      ctx.mir_emit_store_offset(enum_ptr, 0, tag_val)
      # B.10 §14 N3 6.3b — when a SPILL Option/Result encloses a payload that is
      # itself a niche-eligible `Option<…>` construction (e.g. the inner
      # `Some(Point{..})` of `Some(Some(Point{..}))` whose outer
      # `Option<Option<Point>>` is spill), the inner construction must niche-build
      # so the read side — which now tracks the bound payload as the concrete
      # `Option<Point>` and niche-reads it — agrees on representation (§14.4). The
      # outer's stale ambient niche_expected (`Option<Option<Point>>`) would
      # otherwise leak in and make the inner mis-derive its payload to `Option<…>`
      # ⇒ SPILL ⇒ mixed-rep miscompile. Set each payload slot's OWN concrete
      # expected type (the i-th type-arg of the outer payload type) around its
      # lowering, then restore. INERT when the flag is OFF (the inner falls to the
      # byte-identical spill construct regardless of the expected type).
      var nce_outer = mir::mir_ctx_get_niche_expected(ctx)
      var nce_args = mir::mir_type_args_of(nce_outer)
      # enum-niche tail item 6 — Option-inner of a USER spill outer. When the outer
      # is a user enum (NOT Option/Result), `nce_outer`'s type-args don't describe
      # the slots; recover each slot's DECLARED field type from the outer variant's
      # field-type registry. This is the construct-side twin of mir_get_enum_tag_nested:
      # the read side classifies the inner via that same declared `Option<P>` (niche
      # ⇒ `val == 0` ⇒ None), so the inner `Some(x)` (identity ptr) and `None`
      # (none_const) MUST niche-build consistently. Without it the operand-less `None`
      # has no ambient type ⇒ falls to its own SPILL box ⇒ a nonzero box pointer that
      # the niche read never sees as None (§14.10.Q4 construct/read disagreement, the
      # item-6 Option-inner miscompile). For an Option/Result outer the `nce_args`
      # slice already supplies the slot type, so this lookup only fires for user outers.
      var user_outer = 1
      if enum_name == "Option" or enum_name == "Result"
        user_outer = 0
      end
      for pi in 0..payload_count
        var payload_node = payloads[pi]
        var nce_set = 0
        if pi < nce_args.size
          var nce_pty = as_string(nce_args[pi])
          if str_byte_len(nce_pty) > 0
            mir::mir_ctx_set_niche_expected(ctx, nce_pty)
            nce_set = 1
          end
        end
        if nce_set == 0 and user_outer == 1
          var decl_pty = mir::mir_ctx_variant_field_type_str(ctx, enum_name, variant_name, pi)
          if str_byte_len(decl_pty) > 0 and decl_pty.starts_with("Option<")
            mir::mir_ctx_set_niche_expected(ctx, decl_pty)
            nce_set = 1
          end
        end
        var payload_val = ctx.mir_lower_expr(s, payload_node)
        if nce_set == 1
          mir::mir_ctx_set_niche_expected(ctx, nce_outer)
        end
        ctx.mir_emit_store_offset(enum_ptr, pi + 1, payload_val)
      end
      return enum_ptr
    end

    # Unit variant: check if enum type needs pointer representation
    var enum_needs_alloc = mir_enum_has_payloads(ctx, enum_name)
    if enum_needs_alloc == 1
      # Enum has payload variants somewhere - must allocate for consistency
      var enum_ptr = 0
      if use_stack
        enum_ptr = ctx.mir_emit_alloc_stack(2, enum_name)
      else
        enum_ptr = ctx.mir_emit_alloc(2)
      end
      ctx.mir_emit_store_offset(enum_ptr, 0, tag_val)
      return enum_ptr
    end
    
    # Simple enum (no payload variants anywhere): return tag directly
    return tag_val
  end
  
  # Match expression = 40 (extracted to mir_lower_match_expr)
  return mir_lower_expr_handlers::mir_lower_match_expr(ctx, s, node) if kind == node_constants::NODE_MATCH
  
  # NodeIf = 23 - if-as-expression
  if kind == node_constants::NODE_IF
    var cond_node = ast::ast_get_left(s, node)
    var then_node = ast::ast_get_right(s, node)
    var else_node = ast::ast_get_extra(s, node)
    var eif_int_val = ast::ast_get_int_val(s, node)

    var then_block = ctx.mir_create_block("if_expr_then")
    var else_block = ctx.mir_create_block("if_expr_else")
    var merge_block = ctx.mir_create_block("if_expr_end")

    # Allocate result slot
    var result_name = "__if_result"
    var result_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(result_name, result_slot)

    if eif_int_val == 1
      # Pattern binding expression: `if PATTERN = EXPR then v else 0 end`
      var eif_pb_pattern = ast::ast_get_op(s, node)
      var eif_pb_subject = ctx.mir_lower_expr(s, cond_node)
      mir_lower_stmt_handlers::mir_lower_if_pattern(ctx, s, eif_pb_pattern, eif_pb_subject, cond_node, then_block, else_block)

      ctx.mir_switch_to_block(then_block)
      ctx.mir_ctx_apply_pending_bind()
      mir_lower_stmt_handlers::mir_lower_if_pattern_bind_fields(ctx, s, eif_pb_pattern, eif_pb_subject, cond_node)
      var eif_pb_then_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, then_node)
      ctx.mir_emit_store_var(result_name, eif_pb_then_val)
      var eif_pb_then_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(eif_pb_then_cur) < 0
        mir_block_set_terminator(eif_pb_then_cur, mir::TERM_JUMP, merge_block)
      end

      ctx.mir_switch_to_block(else_block)
      var eif_pb_else_val = ctx.mir_emit_const_int(0)
      if else_node >= 0
        eif_pb_else_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, else_node)
      end
      ctx.mir_emit_store_var(result_name, eif_pb_else_val)
      var eif_pb_else_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(eif_pb_else_cur) < 0
        mir_block_set_terminator(eif_pb_else_cur, mir::TERM_JUMP, merge_block)
      end

      ctx.mir_switch_to_block(merge_block)
      return ctx.mir_emit_load_var(result_name)
    end

    # Is-with-bindings expression: `if val is Some(x) then x else 0 end`
    var isb_cond_kind = ast::ast_get_kind(s, cond_node)
    var isb_bound = 0
    if isb_cond_kind == node_constants::NODE_IS_CHECK
      isb_bound = ast::ast_get_bound_names(s, cond_node)
    end
    if isb_bound > 0 and vec_size(isb_bound) > 0
      var isb_subject_node = ast::ast_get_left(s, cond_node)
      var isb_variant_name = ast::ast_get_str1(s, cond_node)
      var isb_subject_val = ctx.mir_lower_expr(s, isb_subject_node)
      # IS_PREDICATE_CROSS_ENUM_TAG_COLLISION: prefer subject's static type.
      var isb_enum_name = mir_resolve_is_enum(ctx, s, isb_subject_node, isb_variant_name)
      var isb_tag_val = mir_get_enum_tag_subj(ctx, s, isb_subject_node, isb_enum_name, isb_subject_val)
      var isb_variant_idx = mir_find_variant_index_ctx(ctx, isb_enum_name, isb_variant_name)
      var isb_idx_val = ctx.mir_emit_const_int(isb_variant_idx)
      var isb_cmp = ctx.mir_emit_binary(op_constants::OP_EQ, isb_tag_val, isb_idx_val)
      var isb_cur = ctx.mir_ctx_get_block()
      mir_block_set_branch(isb_cur, isb_cmp, then_block, else_block)

      # Flow-sensitive narrowing for is-with-bindings expression
      var isbe_narrow_saved = ctx.mir_ctx_get_narrowing_count()
      var isbe_narrow_var = ""
      if ast::ast_get_kind(s, isb_subject_node) == node_constants::NODE_IDENT
        isbe_narrow_var = ast::ast_get_str1(s, isb_subject_node)
      end

      # Then block: extract payloads and bind, narrow subject
      if str_byte_len(isbe_narrow_var) > 0
        ctx.mir_ctx_push_narrowing(isbe_narrow_var, isb_variant_name)
      end
      ctx.mir_switch_to_block(then_block)
      var isb_names = vec_new<String>()
      for isb_i in 0..vec_size(isb_bound)
        isb_names.push(as_string(isb_bound[isb_i]))
      end
      mir_mark_pattern_bindings_typed(ctx, s, isb_subject_node, isb_enum_name, isb_variant_name, isb_names)
      ctx.mir_ctx_set_pending_bind(isb_names, isb_subject_val)
      mir::mir_set_pending_inline_for_enum(ctx, s, isb_subject_node, isb_enum_name, isb_variant_name, isb_names)
      ctx.mir_ctx_apply_pending_bind()
      var isb_then_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, then_node)
      ctx.mir_emit_store_var(result_name, isb_then_val)
      var isb_then_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(isb_then_cur) < 0
        mir_block_set_terminator(isb_then_cur, mir::TERM_JUMP, merge_block)
      end
      ctx.mir_ctx_pop_narrowing_to(isbe_narrow_saved)

      # Else block: push opposite narrowing for 2-variant enums
      if str_byte_len(isbe_narrow_var) > 0
        if isb_variant_name == "Some"
          ctx.mir_ctx_push_narrowing(isbe_narrow_var, "None")
        elsif isb_variant_name == "None"
          ctx.mir_ctx_push_narrowing(isbe_narrow_var, "Some")
        elsif isb_variant_name == "Ok"
          ctx.mir_ctx_push_narrowing(isbe_narrow_var, "Err")
        elsif isb_variant_name == "Err"
          ctx.mir_ctx_push_narrowing(isbe_narrow_var, "Ok")
        end
      end
      ctx.mir_switch_to_block(else_block)
      var isb_else_val = ctx.mir_emit_const_int(0)
      if else_node >= 0
        isb_else_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, else_node)
      end
      ctx.mir_emit_store_var(result_name, isb_else_val)
      var isb_else_cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(isb_else_cur) < 0
        mir_block_set_terminator(isb_else_cur, mir::TERM_JUMP, merge_block)
      end
      ctx.mir_ctx_pop_narrowing_to(isbe_narrow_saved)

      ctx.mir_switch_to_block(merge_block)
      return ctx.mir_emit_load_var(result_name)
    end

    # Normal if expression (not pattern binding)
    var cond_val = ctx.mir_lower_expr(s, cond_node)
    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_branch(cur_block, cond_val, then_block, else_block)

    # Flow-sensitive narrowing: if condition is `x is Variant`, narrow x in then/else
    var eif_narrow_saved = ctx.mir_ctx_get_narrowing_count()
    var eif_narrow_var = ""
    var eif_narrow_variant = ""
    var eif_cond_kind = ast::ast_get_kind(s, cond_node)
    if eif_cond_kind == node_constants::NODE_IS_CHECK
      var eif_narrow_subj = ast::ast_get_left(s, cond_node)
      if eif_narrow_subj >= 0 and ast::ast_get_kind(s, eif_narrow_subj) == node_constants::NODE_IDENT
        eif_narrow_var = ast::ast_get_str1(s, eif_narrow_subj)
        eif_narrow_variant = ast::ast_get_str1(s, cond_node)
      end
    end

    # Then branch - push narrowing, get last expression value
    if str_byte_len(eif_narrow_var) > 0
      ctx.mir_ctx_push_narrowing(eif_narrow_var, eif_narrow_variant)
    end
    ctx.mir_switch_to_block(then_block)
    var then_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, then_node)
    ctx.mir_emit_store_var(result_name, then_val)
    var then_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(then_cur) < 0
      mir_block_set_terminator(then_cur, mir::TERM_JUMP, merge_block)
    end
    ctx.mir_ctx_pop_narrowing_to(eif_narrow_saved)

    # Else branch - push opposite narrowing for 2-variant enums
    if str_byte_len(eif_narrow_var) > 0
      if eif_narrow_variant == "Some"
        ctx.mir_ctx_push_narrowing(eif_narrow_var, "None")
      elsif eif_narrow_variant == "None"
        ctx.mir_ctx_push_narrowing(eif_narrow_var, "Some")
      elsif eif_narrow_variant == "Ok"
        ctx.mir_ctx_push_narrowing(eif_narrow_var, "Err")
      elsif eif_narrow_variant == "Err"
        ctx.mir_ctx_push_narrowing(eif_narrow_var, "Ok")
      end
    end
    ctx.mir_switch_to_block(else_block)
    var else_val = ctx.mir_emit_const_int(0)
    if else_node >= 0
      else_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, else_node)
    end
    ctx.mir_emit_store_var(result_name, else_val)
    var else_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(else_cur) < 0
      mir_block_set_terminator(else_cur, mir::TERM_JUMP, merge_block)
    end
    ctx.mir_ctx_pop_narrowing_to(eif_narrow_saved)

    ctx.mir_switch_to_block(merge_block)
    return ctx.mir_emit_load_var(result_name)
  end
  
  # NodeAllocExpr = 20 (extracted to mir_lower_alloc)
  return mir_lower_expr_handlers::mir_lower_alloc(ctx, s, node) if kind == node_constants::NODE_ALLOC_EXPR

  # NodeListComp = 46, NodeSetComp = 48 (extracted to mir_lower_collection)
  return mir_lower_expr_handlers::mir_lower_collection(ctx, s, node) if kind == node_constants::NODE_LIST_COMP
  return mir_lower_expr_handlers::mir_lower_collection(ctx, s, node) if kind == node_constants::NODE_SET_COMP

  # NodeMapComp = 47 - {key => val for var in iter if cond}
  if kind == node_constants::NODE_MAP_COMP
    return mir_lower_expr_handlers::mir_lower_map_comp(ctx, s, node)
  end
  
  # NodeBlock = 32 - block as expression (e.g., from map comprehension desugaring)
  return mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, node) if kind == node_constants::NODE_BLOCK

  # NODE_WITH = 101 (Effects C.1/C.4/D.5 + H-delegate): `with H do -> body end`.
  # Codegen wraps the body with MIR_HANDLE_INSTALL / MIR_HANDLE_UNINSTALL
  # so the handler-stack scope opens and closes precisely. Handler shapes:
  #   1. Bare NODE_IDENT (`with Throws do ... end`): claims the effect
  #      for narrowing purposes only. Entries = [0, 0] → install pushes
  #      a null-filter / null-handler entry; perform(E, any_op) finds
  #      this entry, sees null handler, falls through to unhandled
  #      unless an outer handler covers E.
  #   2. NODE_STRUCT_INIT `with E { op1: h1, op2: h2, ... } do ... end`:
  #      effect name comes from the struct name; each field becomes one
  #      stack entry with op_filter=field_name and handler=resolved fn.
  #      Multi-op records push N entries (one per field) at install and
  #      pop N at uninstall. Unmatched ops fall through to outer
  #      handlers naturally — this is H-delegate's entire point.
  # Any unrecognized shape installs with empty effect name — codegen
  # treats that as a no-op pair.
  if kind == node_constants::NODE_WITH
    # B.8 Phase 4a: `with X do v -> body end` Scoped form. Typecheck stamped
    # the resolved struct name onto str2 (`ast_with_set_scoped_struct`) when
    # X's type was found to impl Scoped. Empty string means legacy effect-
    # handler path — fall through to the kind-based dispatch below.
    var nw_scoped_struct = ast::ast_with_scoped_struct(s, node)
    if str_byte_len(nw_scoped_struct) > 0
      return mir_lower_with_scoped(ctx, s, node, nw_scoped_struct, 0)
    end
    var nw_handler = ast::ast_get_left(s, node)
    var nw_body = ast::ast_get_right(s, node)
    var nw_eff_name = ""
    var nw_entries = vec_new<Int>()
    # Phase 2 P2.a: initial-state reg for stateful effects. -1 = absent.
    # Set only when the handler shape carries an init value (NODE_CALL form
    # for State(v)/Reader(v) or struct-init with reserved `initial:` field).
    var nw_init_state_reg = -1
    if nw_handler >= 0
      var nw_handler_kind = ast::ast_get_kind(s, nw_handler)
      if nw_handler_kind == node_constants::NODE_IDENT
        nw_eff_name = ast::ast_get_str1(s, nw_handler)
        # B.2 — `with TestAlloc do body end` aliases to an Alloc install
        # backed by a singleton test arena. Routes alloc/dealloc through
        # the env-aware arena handlers (same as B.1's in_arena), with
        # env = handle returned by __qz_test_alloc_arena_acquire (resets
        # the singleton on each call so sequential blocks are isolated).
        # Nesting is NOT supported — inner `with TestAlloc` resets the
        # arena under the outer scope's allocations. Documented in the
        # B.2 spec; deferred until a per-install-teardown substrate
        # supports per-scope arena lifecycles.
        if nw_eff_name.eq("TestAlloc")
          nw_eff_name = "Alloc"
          var alloc_h = mir_resolve_func_name(ctx, "arena_alloc_handler_e")
          var dealloc_h = mir_resolve_func_name(ctx, "arena_dealloc_handler_e")
          nw_entries.push(as_int("alloc"))
          nw_entries.push(as_int(alloc_h))
          nw_entries.push(as_int("dealloc"))
          nw_entries.push(as_int(dealloc_h))
          var acquire_fn = mir_resolve_func_name(ctx, "test_alloc_arena_acquire")
          var no_args = vec_new<Int>()
          nw_init_state_reg = ctx.mir_emit_call(acquire_fn, no_args)
        else
          # Bare IDENT → one entry with null filter + null handler.
          nw_entries.push(0)
          nw_entries.push(0)
        end
      elsif nw_handler_kind == node_constants::NODE_STRUCT_INIT
        nw_eff_name = ast::ast_get_str1(s, nw_handler)
        var nw_fields = ast::ast_get_children(s, nw_handler)
        var nw_field_names = ast::ast_get_struct_init_field_names(s, nw_handler)
        var nw_fi = 0
        while nw_fi < nw_fields.size
          var nw_fv = nw_fields[nw_fi]
          if nw_fv >= 0 and ast::ast_get_kind(s, nw_fv) == node_constants::NODE_IDENT
            var nw_raw = ast::ast_get_str1(s, nw_fv)
            var nw_resolved = mir_resolve_func_name(ctx, nw_raw)
            # op_filter = field name (as-int string ptr); handler =
            # resolved fn name (as-int). Per-op install with H-delegate
            # fall-through for unlisted ops.
            nw_entries.push(nw_field_names[nw_fi])
            nw_entries.push(as_int(nw_resolved))
          end
          nw_fi += 1
        end
      elsif nw_handler_kind == node_constants::NODE_CALL
        # Phase 2 P2.a: `with State(42) do ... end` — call-form handler.
        # Callee ident is the effect name; arg[0] is the initial-state
        # expression. Single entry installed: null filter + default
        # handler for the effect. Default handlers for stateful effects
        # are hard-coded stdlib runtime symbols (e.g.
        # `__qz_default_state_handler`) — resolved by effect-name lookup,
        # not user-facing function resolution.
        # B.0c — `with EffectName.method(args) do ... end` parses as a
        # NODE_CALL whose callee IDENT name is `EffectName$method` (parser
        # squashes field access on PascalCase idents). Split on `$` to
        # recover the effect name and method-dispatch key; the method
        # registry returns a list of (op_filter, handler_fn) pairs that
        # become per-op stack entries (same shape as struct-init form).
        var nw_callee = ast::ast_get_left(s, nw_handler)
        if nw_callee >= 0 and ast::ast_get_kind(s, nw_callee) == node_constants::NODE_IDENT
          var nw_full_name = ast::ast_get_str1(s, nw_callee)
          var nw_method_name = ""
          var nw_dollar = -1
          var nw_scan_i = 0
          while nw_scan_i < str_byte_len(nw_full_name)
            if nw_full_name.byte_at(nw_scan_i) == 36
              nw_dollar = nw_scan_i
              nw_scan_i = str_byte_len(nw_full_name)
            else
              nw_scan_i = nw_scan_i + 1
            end
          end
          if nw_dollar > 0
            nw_eff_name = str_byte_slice(nw_full_name, 0, nw_dollar)
            nw_method_name = str_byte_slice(nw_full_name, nw_dollar + 1, str_byte_len(nw_full_name))
          else
            nw_eff_name = nw_full_name
          end
          if str_byte_len(nw_method_name) > 0
            # Method-dispatch path: look up (eff, method) → N (op, handler)
            # pairs. Each pair becomes one install entry with op_filter +
            # specific handler. Mirrors struct-init's per-op install shape.
            _mir_method_dispatch_entries(ctx, nw_eff_name, nw_method_name, nw_entries)
          else
            # Bare effect-name call-form (existing State(v) shape).
            var nw_default_handler = _mir_default_handler_for_effect(nw_eff_name)
            nw_entries.push(0)
            if str_byte_len(nw_default_handler) > 0
              nw_entries.push(as_int(nw_default_handler))
            else
              nw_entries.push(0)
            end
          end
          # Lower the initial-state expression (arg[0] if present). For
          # method-dispatch installs, this becomes the env value visible
          # to every entry's handler via __qz_effect_state_get().
          var nw_call_args = ast::ast_get_children(s, nw_handler)
          if nw_call_args != 0 and nw_call_args.size > 0
            nw_init_state_reg = ctx.mir_lower_expr(s, nw_call_args[0])
          else
            nw_init_state_reg = ctx.mir_emit_const_int(0)
          end
        end
      elsif nw_handler_kind == node_constants::NODE_FIELD_ACCESS
        # B.0c — bare `with EffectName.method do ... end` (zero-arg method,
        # no parens) — parses as NODE_FIELD if not followed by call-args
        # or, depending on parser, may also reach as NODE_IDENT with `$`.
        # Handle the NODE_FIELD shape here for completeness; arg list is
        # empty, so init_state defaults to 0.
        var nw_field_owner = ast::ast_get_left(s, nw_handler)
        if nw_field_owner >= 0 and ast::ast_get_kind(s, nw_field_owner) == node_constants::NODE_IDENT
          nw_eff_name = ast::ast_get_str1(s, nw_field_owner)
          var nw_field_method = ast::ast_get_str1(s, nw_handler)
          if str_byte_len(nw_field_method) > 0
            _mir_method_dispatch_entries(ctx, nw_eff_name, nw_field_method, nw_entries)
            nw_init_state_reg = ctx.mir_emit_const_int(0)
          end
        end
      end
    end
    var nw_install_dest = ctx.mir_emit_handle_install(nw_eff_name, nw_entries, nw_init_state_reg)
    # Effects G.1: push one lexical handler-stack entry per install entry so
    # performs inside the body resolve to a known handler fn at MIR-emit
    # time. Skip when eff_name is empty (unrecognized shape — no lexical
    # scope is being opened).
    var nw_push_n = 0
    if str_byte_len(nw_eff_name) > 0
      var nw_pi = 0
      while nw_pi < nw_entries.size
        var _filter_int = nw_entries[nw_pi]
        var _handler_int = nw_entries[nw_pi + 1]
        var _filter_str = ""
        if _filter_int != 0
          _filter_str = as_string(_filter_int)
        end
        ctx.mir_ctx_push_handler_entry(nw_eff_name, _filter_str, _handler_int, nw_install_dest)
        nw_push_n += 1
        nw_pi += 2
      end
    end
    # Diag-leak fix: track this wrap on the wrap_stack so NODE_RETURN inside
    # the body emits a balancing runtime pop. Pop_count matches what
    # mir_emit_handle_uninstall would pop on natural fall-through below.
    var nw_pop = nw_entries.size / 2
    if str_byte_len(nw_eff_name) > 0 and nw_pop > 0
      ctx.mir_ctx_push_wrap(nw_eff_name, nw_pop)
    end
    var nw_val = 0
    if nw_body >= 0
      nw_val = mir_lower_expr_handlers::mir_lower_block_expr(ctx, s, nw_body)
    else
      nw_val = ctx.mir_emit_const_int(0)
    end
    if nw_push_n > 0
      ctx.mir_ctx_pop_handler_entries(nw_push_n)
    end
    # Pop the wrap-stack entry pushed above — natural fall-through is now
    # handled by mir_emit_handle_uninstall below; the wrap is no longer "active"
    # for any subsequent return inside an enclosing scope.
    if str_byte_len(nw_eff_name) > 0 and nw_pop > 0
      ctx.mir_ctx_pop_wrap()
    end
    # F.3b: uninstall returns the with-block's final register (loads
    # from result slot so body-path and unwind-path merge cleanly).
    # H-delegate: pop_count = N entries (nw_entries.size / 2).
    # Diag-leak fix: if every path through the body terminated (e.g. all
    # branches return, break, or continue), the current block has a
    # terminator set and our pop_n at each early-exit already drained the
    # runtime stack. Emitting the FULL MIR_HANDLE_UNINSTALL would codegen
    # to an additional store + br + pops appended to the same block — at
    # runtime that re-pops the same wrap (the originally-filed double-pop).
    #
    # But `wb.catch.NN`'s `br label %wb.done.NN` (emitted by MIR_HANDLE_INSTALL
    # for the longjmp-resume path) still references `wb.done.NN` — so we
    # MUST emit the wb.done.NN label for valid IR. Switch to a fresh MIR
    # block (predecessor-less, since the prior block terminated) and emit
    # MIR_HANDLE_UNINSTALL_DONE_ONLY there: just the `wb.done.NN: load + pops`
    # without the body fall-through prefix. The longjmp-resume path is the
    # only edge into wb.done.NN; load + pops handle its teardown. Subsequent
    # code (after the with-block) emits into the new MIR block, which IR-level
    # falls through into wb.done.NN's continuation.
    var _nw_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(_nw_cur) >= 0
      var _nw_done_only_block = ctx.mir_create_block("wb_done_only")
      ctx.mir_switch_to_block(_nw_done_only_block)
      return ctx.mir_emit_handle_uninstall_done_only(nw_eff_name, nw_install_dest, nw_pop)
    end
    return ctx.mir_emit_handle_uninstall(nw_eff_name, nw_val, nw_install_dest, nw_pop)
  end

  # NODE_WHILE in expression position: loop-as-expression with break VALUE
  if kind == node_constants::NODE_WHILE
    # Allocate result slot for break values to store into
    var loop_result_name = "__loop_result"
    var loop_result_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(loop_result_name, loop_result_slot)
    # Initialize to 0 (default if loop exits without break value)
    ctx.mir_emit_store_var(loop_result_name, ctx.mir_emit_const_int(0))

    # Set the context so break VALUE knows where to store
    var saved_loop_result = _loop_expr_result_var
    _loop_expr_result_var = loop_result_name

    # Reuse the statement-level while lowering (creates cond/body/exit blocks)
    mir_lower_stmt_handlers::mir_lower_stmt_while(ctx, s, node)

    _loop_expr_result_var = saved_loop_result

    # Load and return the result from the exit block
    return ctx.mir_emit_load_var(loop_result_name)
  end

  # NODE_INTERP_STRING = 43: desugar to sb_new + sb_append chain + sb_to_string + sb_free
  # This avoids N intermediate str_concat allocations — only 1 final string allocated.
  #
  # The parser wraps every `#{expr}` part in `to_str(expr)` (parser.qz:1179).
  # `to_str`'s LLVM runtime impl uses an alignment heuristic to pass strings
  # through unchanged; for Int values that happen to satisfy `(val & 15) == 8
  # && val > 65535` the heuristic mis-classifies them as String pointers and
  # dereferences an unmapped page → SIGSEGV (see TO_STR_INT_HEURISTIC_UNSOUND
  # in docs/bugs/done/). The WASM `to_str` impl can't replicate the LLVM
  # heuristic at all (low linear-memory addresses defeat the small-int
  # rejection). Per-part dispatch covers both hazards:
  #   - String inner: strip the parser wrap, append directly (existing).
  #   - Int inner: strip the parser wrap, dispatch through `sb_append_int` /
  #     `str_from_int` — neither backend touches the unsound heuristic.
  #   - Other inner: keep the wrap, residual hazard for unannotated values
  #     (filed for follow-up if a Float or untyped trigger surfaces).
  if kind == node_constants::NODE_INTERP_STRING
    var parts = ast::ast_get_children(s, node)
    if parts == 0 or parts.size == 0
      return ctx.mir_emit_const_string("")
    end
    if parts.size == 1
      var only_int = mir_unwrap_to_str_for_int(ctx, s, parts[0])
      if only_int >= 0
        var int_val = ctx.mir_lower_expr(s, only_int)
        var sfi_args = vec_new()
        sfi_args.push(int_val)
        return ctx.mir_emit_intrinsic("str_from_int", sfi_args)
      end
      var only_part = mir_unwrap_to_str_for_string(ctx, s, parts[0])
      return ctx.mir_lower_expr(s, only_part)
    end
    # Create StringBuilder, append each part, convert to string, free.
    # Async cross-suspend spill: `sb` is created once and reused for every
    # part's append (and the final to_string/free). If any part lowers to a
    # suspending colorless call (e.g. `#{closure(x)}` inside an async $poll
    # body), the resume block where the append is finally emitted is not
    # dominated by `sb`'s defining block — `sb` must be spilled to a generator
    # frame slot before the suspend and reloaded after. Mirrors the call-arg
    # and binary-op spill sites. No-op outside async mode (gen_is_active < 2).
    var sb = ctx.mir_emit_intrinsic("sb_new", vec_new())
    for j in 0..parts.size
      var raw_part = parts[j]
      # Try Int classification first — bypasses the unsound `@to_str` heuristic.
      var int_inner = mir_unwrap_to_str_for_int(ctx, s, raw_part)
      if int_inner >= 0
        var _sb_spill = mir_lower_expr_handlers::mir_async_spill_if_await(ctx, s, int_inner, sb)
        var int_val = ctx.mir_lower_expr(s, int_inner)
        sb = mir_lower_expr_handlers::mir_async_reload_if_spilled(ctx, _sb_spill, sb)
        var ai_args = vec_new()
        ai_args.push(sb)
        ai_args.push(int_val)
        ctx.mir_emit_intrinsic("sb_append_int", ai_args)
      else
        # Fall back to String-elision-or-to_str path
        var part_node = mir_unwrap_to_str_for_string(ctx, s, raw_part)
        var _sb_spill = mir_lower_expr_handlers::mir_async_spill_if_await(ctx, s, part_node, sb)
        var part_val = ctx.mir_lower_expr(s, part_node)
        sb = mir_lower_expr_handlers::mir_async_reload_if_spilled(ctx, _sb_spill, sb)
        var append_args = vec_new()
        append_args.push(sb)
        append_args.push(part_val)
        ctx.mir_emit_intrinsic("sb_append", append_args)
      end
    end
    var to_str_args = vec_new()
    to_str_args.push(sb)
    var result = ctx.mir_emit_intrinsic("sb_to_string", to_str_args)
    var free_args = vec_new()
    free_args.push(sb)
    ctx.mir_emit_intrinsic("sb_free", free_args)
    return result
  end

  # NODE_IS_CHECK = 92: expr is VariantName — boolean tag check
  if kind == node_constants::NODE_IS_CHECK
    var subject_node = ast::ast_get_left(s, node)
    var variant_name = ast::ast_get_str1(s, node)
    var subject_val = ctx.mir_lower_expr(s, subject_node)
    # R2.1 (B2) — union `is Member` tag compare. A union value is the tagged
    # `{tag@0, payload@1}` cell (B1); prove membership by `load@0 == fnv1a(arm)`
    # using the SAME tag helper construction uses (mir_union_arm_tag), so widen
    # and read agree by construction. Keyed on the subject's tracked union
    # annotation (forward-plumbed by the B1 LET handler) ⇒ gate-0-inert.
    var is_subj_ann = ctx.mir_infer_expr_type(s, subject_node)
    if mir::mir_is_union_annotation(is_subj_ann)
      # R2.1 (B4) — niche `T | Nil`: there is NO tag word. The bare VALUE is the
      # discriminant: `is Nil` ⟺ `value == nil_const`; the (only) other arm ⟺
      # `value != nil_const`. Same mir_union_is_niche verdict as the widen site,
      # so construct and read agree. Exactly two arms is guaranteed by the
      # predicate, so `is <payload arm>` is the negation of `is Nil`.
      if mir::mir_union_is_niche(ctx, is_subj_ann) == 1
        var u_nil_const = ctx.mir_emit_const_int(mir::mir_union_nil_const(ctx, is_subj_ann))
        if str_trim(variant_name) == "Nil"
          return ctx.mir_emit_binary(op_constants::OP_EQ, subject_val, u_nil_const)
        end
        return ctx.mir_emit_binary(op_constants::OP_NE, subject_val, u_nil_const)
      end
      var u_tag_val = ctx.mir_emit_load_offset(subject_val, 0)
      var u_want_tag = ctx.mir_emit_const_int(mir::mir_union_arm_tag(variant_name))
      return ctx.mir_emit_binary(op_constants::OP_EQ, u_tag_val, u_want_tag)
    end
    # IS_PREDICATE_CROSS_ENUM_TAG_COLLISION: resolve enum from subject's
    # static type, not a global variant-name search. See mir_resolve_is_enum.
    var enum_name = mir_resolve_is_enum(ctx, s, subject_node, variant_name)
    var tag_val = mir_get_enum_tag_subj(ctx, s, subject_node, enum_name, subject_val)
    var variant_idx = mir_find_variant_index_ctx(ctx, enum_name, variant_name)
    var idx_val = ctx.mir_emit_const_int(variant_idx)
    return ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, idx_val)
  end

  return 0
end


def mir_lower_stmt(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Void
  var kind = ast::ast_get_kind(s, node)

  # NodeReturn = 22 (C-aligned)
  if kind == node_constants::NODE_RETURN
    # Inside a generator or async $poll function
    if mir_lower_gen::mir_gen_is_active() > 0
      if mir_lower_gen::mir_gen_is_active() == 2
        # Async mode: return val → store result in frame[1], set state=-1, return POLL_READY(1)
        # Covers async fns, impl Iterator (via mir_lower_generator_effect),
        # and impl AsyncIterator (unified in 4.B.7.b). For generator flavors
        # the return value is conceptually ignored by the consumer on
        # POLL_READY — treat as "body complete / None".
        var return_val = ctx.mir_emit_const_int(0)
        var ret_expr = ast::ast_get_left(s, node)
        if ret_expr >= 0
          return_val = ctx.mir_lower_expr(s, ret_expr)
        end
        var self_val = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
        ctx.mir_emit_store_offset(self_val, 1, return_val)
        ctx.mir_emit_store_offset(self_val, 0, ctx.mir_emit_const_int(-1))
        var block = ctx.mir_ctx_get_block()
        mir_block_set_terminator(block, mir::TERM_RETURN, ctx.mir_emit_const_int(1))
        var cont = ctx.mir_create_block("async_after_return")
        ctx.mir_switch_to_block(cont)
        return
      else
        # Generator mode: bare return → set state=-1, return option_none()
        var self_val = ctx.mir_emit_load_var(mir_lower_gen::mir_gen_get_frame_var())
        ctx.mir_emit_store_offset(self_val, 0, ctx.mir_emit_const_int(-1))
        var none_val = ctx.mir_emit_intrinsic("option_none", vec_new())
        var block = ctx.mir_ctx_get_block()
        mir_block_set_terminator(block, mir::TERM_RETURN, none_val)
        var cont = ctx.mir_create_block("gen_after_return")
        ctx.mir_switch_to_block(cont)
        return
      end
    end
    mir_lower_stmt_handlers::mir_lower_stmt_return(ctx, s, node)
    return
  end
  
  # NodeLet = 25 (C-aligned)
  if kind == node_constants::NODE_LET
    mir_lower_stmt_handlers::mir_lower_stmt_let(ctx, s, node)
    return
  end

  # NodeLetDestructure = 78: var (a, b) = expr
  if kind == node_constants::NODE_LET_DESTRUCTURE
    var names_str = ast::ast_get_str1(s, node)
    var init_node = ast::ast_get_left(s, node)
    var names = str_split(names_str, ",")
    var arity = names.size
    # Lower the init expression to a temporary
    var init_val = ctx.mir_lower_expr(s, init_node)
    # For each binding, load the element at the corresponding offset
    for di in 0..arity
      var dname = names[di]
      var slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(dname, slot)
      var elem_val = ctx.mir_emit_load_offset(init_val, di)
      ctx.mir_emit_store_var(dname, elem_val)
    end
    return
  end

  # NODE_STRUCT_DESTRUCTURE = 79: Point { x, y } = expr
  if kind == node_constants::NODE_STRUCT_DESTRUCTURE
    var type_name = ast::ast_get_str1(s, node)
    var field_specs = ast::ast_get_str2(s, node)
    var init_node = ast::ast_get_left(s, node)
    var init_val = ctx.mir_lower_expr(s, init_node)

    # Resolve struct name for field index lookup
    var struct_name = type_name
    if str_byte_len(struct_name) == 0
      # Try to infer from init expression
      var init_kind = ast::ast_get_kind(s, init_node)
      if init_kind == node_constants::NODE_STRUCT_INIT
        struct_name = ast::ast_get_str1(s, init_node)
      elsif init_kind == node_constants::NODE_IDENT
        struct_name = ctx.mir_ctx_get_var_type(ast::ast_get_str1(s, init_node))
      elsif init_kind == node_constants::NODE_CALL
        struct_name = ctx.mir_infer_expr_type(s, init_node)
      end
    end

    # Strip generic args from struct name for registry lookup
    if str_byte_len(struct_name) > 0
      var lt_pos = __char_index(struct_name, '<')
      if lt_pos > 0
        struct_name = str_byte_slice(struct_name, 0, lt_pos)
      end
      struct_name = mir_resolve_struct_name(ctx, struct_name)
    end

    var specs = str_split(field_specs, ",")
    for fi in 0..specs.size
      var spec = specs[fi]
      var field_name = spec
      var bind_name = spec
      var colon_pos = __char_index(spec, ':')
      if colon_pos >= 0
        field_name = str_byte_slice(spec, 0, colon_pos)
        bind_name = str_byte_slice(spec, colon_pos + 1, str_byte_len(spec))
      end
      # Resolve field position — use named lookup if available, else positional
      var field_idx = ctx.mir_ctx_find_field_index(struct_name, field_name)
      var offset = fi
      if field_idx >= 0
        offset = field_idx
      end
      var slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(bind_name, slot)
      # B.10 §14.12.8 (C3.5/h3) — COW destructure field read. When the source is a
      # cow-layout buffer (refcount@0, payload@1..N), field f lives at buffer word
      # f+1; route the offset load through C3's cow_field_shift flag (the SAME
      # mechanism dot-read uses) so destructuring stays consistent with field
      # access. INERT at gate 0 (predicate false ⇒ flag never set ⇒ +0 ⇒
      # byte-identical).
      var _sd_is_cow = mir::mir_value_is_cow_layout(ctx, struct_name)
      if _sd_is_cow == 1
        mir::mir_ctx_set_cow_field_shift(ctx, 1)
      end
      var elem_val = ctx.mir_emit_load_offset(init_val, offset)
      if _sd_is_cow == 1
        mir::mir_ctx_set_cow_field_shift(ctx, 0)
      end
      ctx.mir_emit_store_var(bind_name, elem_val)
    end
    return
  end

  # NODE_VEC_DESTRUCTURE = 80: [a, b, ..rest] = expr
  if kind == node_constants::NODE_VEC_DESTRUCTURE
    var elem_names_str = ast::ast_get_str1(s, node)
    var rest_name = ast::ast_get_str2(s, node)
    var has_rest = ast::ast_get_op(s, node)
    var init_node = ast::ast_get_left(s, node)
    var init_val = ctx.mir_lower_expr(s, init_node)

    var elems = str_split(elem_names_str, ",")
    for ei in 0..elems.size
      var ename = elems[ei]
      if str_byte_len(ename) > 0
        var slot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(ename, slot)
        var idx_val = ctx.mir_emit_const_int(ei)
        var get_args = [init_val, idx_val]
        var elem_val = ctx.mir_emit_intrinsic("vec_get", get_args)
        ctx.mir_emit_store_var(ename, elem_val)
      end
    end

    # Rest binding: create new vec from remaining elements
    if has_rest == 1 and str_byte_len(rest_name) > 0
      var rest_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(rest_name, rest_slot)
      # Create new vec and push remaining elements
      var new_vec = ctx.mir_emit_intrinsic("vec_new", [])
      var elem_count = elems.size
      var len_val = ctx.mir_emit_intrinsic("vec_size", [init_val])
      # Loop: for i in elem_count..len
      var idx_name = "__destr_rest_idx"
      var rest_idx_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(idx_name, rest_idx_slot)
      var start = ctx.mir_emit_const_int(elem_count)
      ctx.mir_emit_store_var(idx_name, start)
      # Store new_vec to rest_name
      ctx.mir_emit_store_var(rest_name, new_vec)

      var cond_block = ctx.mir_create_block("destr_rest_cond")
      var body_block = ctx.mir_create_block("destr_rest_body")
      var exit_block = ctx.mir_create_block("destr_rest_exit")

      var cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(cur, mir::TERM_JUMP, cond_block)

      ctx.mir_switch_to_block(cond_block)
      var ri_val = ctx.mir_emit_load_var(idx_name)
      var ri_len = ctx.mir_emit_intrinsic("vec_size", [init_val])
      var ri_cmp = ctx.mir_emit_binary(op_constants::OP_LT, ri_val, ri_len)
      mir_block_set_branch(cond_block, ri_cmp, body_block, exit_block)

      ctx.mir_switch_to_block(body_block)
      var ri_elem = ctx.mir_emit_intrinsic("vec_get", [init_val, ri_val])
      var rest_vec = ctx.mir_emit_load_var(rest_name)
      ctx.mir_emit_intrinsic("vec_push", [rest_vec, ri_elem])
      var ri_one = ctx.mir_emit_const_int(1)
      var ri_next = ctx.mir_emit_binary(op_constants::OP_ADD, ri_val, ri_one)
      ctx.mir_emit_store_var(idx_name, ri_next)
      mir_block_set_terminator(body_block, mir::TERM_JUMP, cond_block)

      ctx.mir_switch_to_block(exit_block)
    end
    return
  end

  # NODE_YIELD = 83 — generator yield
  if kind == node_constants::NODE_YIELD
    mir_lower_gen::mir_lower_stmt_yield(ctx, s, node)
    return
  end

  # NODE_ASYNC_CALL = 84 — async function call (as statement, result discarded)
  if kind == node_constants::NODE_ASYNC_CALL
    ctx.mir_lower_expr(s, node)
    return
  end

  # NODE_GO = 85 — go func(args) as statement
  if kind == node_constants::NODE_GO
    ctx.mir_lower_expr(s, node)
    return
  end

  # NodeAssign = 26 (C-aligned)
  if kind == node_constants::NODE_ASSIGN
    mir_lower_stmt_handlers::mir_lower_stmt_assign(ctx, s, node)
    return
  end
  
  # NodeIndexAssign = 27 (C-aligned): arr[idx] = value -> mir$mir::MIR_INDEX_STORE
  if kind == node_constants::NODE_INDEX_ASSIGN
    mir_lower_stmt_handlers::mir_lower_stmt_index_assign(ctx, s, node)
    return
  end
  
  # NodeFieldAssign = 28 (C-aligned): obj.field = value -> store at field offset
  if kind == node_constants::NODE_FIELD_ASSIGN
    mir_lower_stmt_handlers::mir_lower_stmt_field_assign(ctx, s, node)
    return
  end

  # NodeExprStmt = 29 (C-aligned)
  if kind == node_constants::NODE_EXPR_STMT
    var expr_node = ast::ast_get_left(s, node)
    var result_reg = ctx.mir_lower_expr(s, expr_node)
    # Track droppable temporaries: if expression result has Drop trait,
    # bind to a temp variable and register for scope-exit cleanup
    var inferred_type = ctx.mir_infer_expr_type(s, expr_node)
    if str_byte_len(inferred_type) > 0
      if type_needs_drop(ctx, inferred_type)
        var func = ctx.mir_ctx_get_func()
        var temp_name = "__drop_tmp_#{mir_func_next_value(func).to_s()}"
        ctx.mir_emit_store_var(temp_name, result_reg)
        ctx.mir_ctx_mark_struct_var(temp_name, inferred_type)
        push_droppable(ctx, temp_name, inferred_type)
      end
    end
    return
  end

  # NodeCall = 9 - bare function calls as statements (e.g., match arm bodies)
  # These aren't wrapped in node_constants$NODE_EXPR_STMT when they're direct arm bodies
  if kind == node_constants::NODE_CALL
    ctx.mir_lower_expr(s, node)
    return
  end

  # NodeBlock = 32 (C-aligned)
  if kind == node_constants::NODE_BLOCK
    defer_scope_push(ctx)
    var stmts = ast::ast_get_children(s, node)
    var stmt_count = stmts.size
    # B.10 §14 N3 6.3d — recover the Option payload type of any bare-`None`
    # un-annotated local in this block from its later `Some(P)` reassignment, so
    # the niche construction agrees with the field/var-typed read. Niche-gated:
    # a complete no-op (byte-identical IR) when the master flag is off.
    mir::mir_niche_prescan_bare_none_lets(ctx, s, stmts, node)
    for i in 0..stmt_count
      var stmt = stmts[i]
      ctx.mir_lower_stmt(s, stmt)
      # Stop if block has terminator (break/continue/return)
      var cur = ctx.mir_ctx_get_block()
      if mir_block_get_term_kind(cur) >= 0
        defer_scope_discard(ctx)
        return
      end
    end
    defer_scope_pop(ctx)
    return
  end

  # NODE_WITH = 101 (Effects C.1/C.4/D.5 + H-delegate): mirrors expr-path
  # lowering with no return value. See mir_lower_expr's NODE_WITH block
  # for the full commentary on entry-pair construction.
  if kind == node_constants::NODE_WITH
    # B.8 Phase 4a: Scoped form in statement position. See expr-path mirror
    # comment for full rationale; same dispatch on the str2-stamped name.
    var nw_scoped_struct_s = ast::ast_with_scoped_struct(s, node)
    if str_byte_len(nw_scoped_struct_s) > 0
      mir_lower_with_scoped(ctx, s, node, nw_scoped_struct_s, 1)
      return
    end
    var nw_handler_s = ast::ast_get_left(s, node)
    var nw_body_s = ast::ast_get_right(s, node)
    var nw_eff_name_s = ""
    var nw_entries_s = vec_new<Int>()
    var nw_init_state_reg_s = -1
    if nw_handler_s >= 0
      var nw_hk_s = ast::ast_get_kind(s, nw_handler_s)
      if nw_hk_s == node_constants::NODE_IDENT
        nw_eff_name_s = ast::ast_get_str1(s, nw_handler_s)
        nw_entries_s.push(0)
        nw_entries_s.push(0)
      elsif nw_hk_s == node_constants::NODE_STRUCT_INIT
        nw_eff_name_s = ast::ast_get_str1(s, nw_handler_s)
        var nw_fields_s = ast::ast_get_children(s, nw_handler_s)
        var nw_field_names_s = ast::ast_get_struct_init_field_names(s, nw_handler_s)
        var nw_fi_s = 0
        while nw_fi_s < nw_fields_s.size
          var nw_fv_s = nw_fields_s[nw_fi_s]
          if nw_fv_s >= 0 and ast::ast_get_kind(s, nw_fv_s) == node_constants::NODE_IDENT
            var nw_raw_s = ast::ast_get_str1(s, nw_fv_s)
            var nw_resolved_s = mir_resolve_func_name(ctx, nw_raw_s)
            nw_entries_s.push(nw_field_names_s[nw_fi_s])
            nw_entries_s.push(as_int(nw_resolved_s))
          end
          nw_fi_s += 1
        end
      elsif nw_hk_s == node_constants::NODE_CALL
        # Phase 2 P2.a: `with State(42) do ... end` — statement context.
        # B.0c — `with EffectName.method(args) do ... end` parses as a
        # NODE_CALL whose callee IDENT name is `EffectName$method` (parser
        # squashes field access on PascalCase idents). Split on `$` to
        # recover the effect name and method-dispatch key. Mirrors the
        # expr-context branch above; without this, statement-context
        # `with Alloc.in_arena(ar) do ... end` falls through to a default
        # handler and Alloc.alloc routing breaks.
        var nw_callee_s = ast::ast_get_left(s, nw_handler_s)
        if nw_callee_s >= 0 and ast::ast_get_kind(s, nw_callee_s) == node_constants::NODE_IDENT
          var nw_full_name_s = ast::ast_get_str1(s, nw_callee_s)
          var nw_method_name_s = ""
          var nw_dollar_s = -1
          var nw_scan_i_s = 0
          while nw_scan_i_s < str_byte_len(nw_full_name_s)
            if nw_full_name_s.byte_at(nw_scan_i_s) == 36
              nw_dollar_s = nw_scan_i_s
              nw_scan_i_s = str_byte_len(nw_full_name_s)
            else
              nw_scan_i_s = nw_scan_i_s + 1
            end
          end
          if nw_dollar_s > 0
            nw_eff_name_s = str_byte_slice(nw_full_name_s, 0, nw_dollar_s)
            nw_method_name_s = str_byte_slice(nw_full_name_s, nw_dollar_s + 1, str_byte_len(nw_full_name_s))
          else
            nw_eff_name_s = nw_full_name_s
          end
          if str_byte_len(nw_method_name_s) > 0
            _mir_method_dispatch_entries(ctx, nw_eff_name_s, nw_method_name_s, nw_entries_s)
          else
            var nw_default_handler_s = _mir_default_handler_for_effect(nw_eff_name_s)
            nw_entries_s.push(0)
            if str_byte_len(nw_default_handler_s) > 0
              nw_entries_s.push(as_int(nw_default_handler_s))
            else
              nw_entries_s.push(0)
            end
          end
          var nw_call_args_s = ast::ast_get_children(s, nw_handler_s)
          if nw_call_args_s != 0 and nw_call_args_s.size > 0
            nw_init_state_reg_s = ctx.mir_lower_expr(s, nw_call_args_s[0])
          else
            nw_init_state_reg_s = ctx.mir_emit_const_int(0)
          end
        end
      end
    end
    var nw_install_dest_s = ctx.mir_emit_handle_install(nw_eff_name_s, nw_entries_s, nw_init_state_reg_s)
    # Effects G.1: push lexical handler-stack entries for static dispatch.
    # Matches the expr-path logic above.
    var nw_push_n_s = 0
    if str_byte_len(nw_eff_name_s) > 0
      var nw_pi_s = 0
      while nw_pi_s < nw_entries_s.size
        var _filter_int_s = nw_entries_s[nw_pi_s]
        var _handler_int_s = nw_entries_s[nw_pi_s + 1]
        var _filter_str_s = ""
        if _filter_int_s != 0
          _filter_str_s = as_string(_filter_int_s)
        end
        ctx.mir_ctx_push_handler_entry(nw_eff_name_s, _filter_str_s, _handler_int_s, nw_install_dest_s)
        nw_push_n_s += 1
        nw_pi_s += 2
      end
    end
    # Diag-leak fix: track this stmt-context wrap on the wrap_stack — symmetric
    # with the expr-context push above.
    var nw_pop_s = nw_entries_s.size / 2
    if str_byte_len(nw_eff_name_s) > 0 and nw_pop_s > 0
      ctx.mir_ctx_push_wrap(nw_eff_name_s, nw_pop_s)
    end
    if nw_body_s >= 0
      ctx.mir_lower_stmt(s, nw_body_s)
    end
    if nw_push_n_s > 0
      ctx.mir_ctx_pop_handler_entries(nw_push_n_s)
    end
    if str_byte_len(nw_eff_name_s) > 0 and nw_pop_s > 0
      ctx.mir_ctx_pop_wrap()
    end
    # Diag-leak fix: same all-paths-terminated guard as expr-context above.
    # Same wb.done.NN-must-be-defined invariant — switch to a fresh MIR
    # block and emit DONE_ONLY so wb.catch.NN's reference resolves.
    var _nw_cur_s = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(_nw_cur_s) >= 0
      var _nw_done_only_block_s = ctx.mir_create_block("wb_done_only")
      ctx.mir_switch_to_block(_nw_done_only_block_s)
      ctx.mir_emit_handle_uninstall_done_only(nw_eff_name_s, nw_install_dest_s, nw_pop_s)
      return
    end
    # F.3b: stmt-level with still threads a body_val (zero — stmt context
    # doesn't produce a user-visible value). The dest returned by
    # uninstall is discarded here, matching stmt semantics.
    var _nw_s_zero = ctx.mir_emit_const_int(0)
    ctx.mir_emit_handle_uninstall(nw_eff_name_s, _nw_s_zero, nw_install_dest_s, nw_pop_s)
    return
  end
  
  # NodeIf = 23 (C-aligned)
  if kind == node_constants::NODE_IF
    mir_lower_stmt_handlers::mir_lower_stmt_if(ctx, s, node)
    return
  end
  
  # While statement - NodeWhile = 24 (C-aligned)
  if kind == node_constants::NODE_WHILE
    mir_lower_stmt_handlers::mir_lower_stmt_while(ctx, s, node)
    return
  end
  
  # NodeFor = 44 (C-aligned): for var in range/collection
  if kind == node_constants::NODE_FOR
    mir_lower_stmt_handlers::mir_lower_stmt_for(ctx, s, node)
    return
  end

  # NODE_FOR_AWAIT (86): for await x in channel/async_iterator
  # For channels: loop { opt = try_recv(ch); if some: x = unwrap; body; else if closed: break; else io_suspend(notify_fd) }
  # For AsyncIterator: dispatch to lower_stream_async_iteration (poll-based protocol)
  if kind == node_constants::NODE_FOR_AWAIT
    var var_name = ast::ast_get_str1(s, node)
    var ch_node = ast::ast_get_left(s, node)
    var body_node = ast::ast_get_right(s, node)

    # Check if iterating an async generator (direct call or variable holding one)
    # Phase 4D.5b: annotation-based dispatch (same swap as for-in NODE_CALL above).
    var ch_kind = ast::ast_get_kind(s, ch_node)
    if ch_kind == node_constants::NODE_CALL
      var fa_callee = ast::ast_get_left(s, ch_node)
      if fa_callee >= 0
        var fa_callee_kind = ast::ast_get_kind(s, fa_callee)
        if fa_callee_kind == node_constants::NODE_IDENT
          var fa_func_name = ast::ast_get_str1(s, fa_callee)
          var fa_iter_ann = ctx.mir_infer_expr_type(s, ch_node)
          if mir_func_annotation_is_async_generator(fa_iter_ann)
            # INDIRECT path: load the $poll fn pointer from the generator
            # handle's slot [1] (the constructor stores the correctly-mangled
            # `__Future_<resolved-name>$poll`) rather than rebuilding it from
            # the surface callee `fa_func_name`, which omits the module prefix
            # + monomorphization suffix and so referenced an undefined symbol
            # for any generic / cross-module generator (e.g. std/streams'
            # `stream_map`). Correct by construction. (A.44(2))
            mir_lower_iter::lower_stream_async_iteration(ctx, s, var_name, "", ch_node, body_node, "", true)
            return
          end
        end
      end
    end

    # Check if iterating a variable that holds an async iterator (indirect poll via frame[2])
    if ch_kind == node_constants::NODE_IDENT
      var fa_ident = ast::ast_get_str1(s, ch_node)
      var fa_var_type = ctx.mir_ctx_get_var_type(fa_ident)
      # `impl AsyncIterator<T>` type annotation. Both literal source annotations
      # (e.g. `var nums = counting()` where counting returns `impl AsyncIterator<Int>`)
      # and `_impl_N` synthetic params desugared by resolve_desugar_impl_trait_args
      # are marked with "impl AsyncIterator<..." — the latter via bound lookup in
      # mir_lower_generator (see mir_lower_gen.qz's `impl Iterator<T> type` block).
      if str_byte_len(fa_var_type) >= 19
        if fa_var_type.starts_with("impl AsyncIterator<")
          mir_lower_iter::lower_stream_async_iteration(ctx, s, var_name, "", ch_node, body_node, "", true)
          return
        end
      end
    end

    # Channel path: standard try_recv_or_closed protocol
    var ch_var_name = "__fa_ch_#{var_name}"

    var ch_val = ctx.mir_lower_expr(s, ch_node)

    # Store channel in a named variable (fixes SSA domination after suspend/resume)
    ctx.mir_emit_store_var(ch_var_name, ch_val)

    # Register dynamic locals for async/async-gen frame save/restore
    if mir_lower_gen::mir_gen_is_active() >= 2
      mir_lower_gen::mir_gen_register_dynamic_local(var_name)
      mir_lower_gen::mir_gen_register_dynamic_local(ch_var_name)
    end

    var loop_block = ctx.mir_create_block("for_await_loop")
    var body_block = ctx.mir_create_block("for_await_body")
    var closed_block = ctx.mir_create_block("for_await_closed")
    var suspend_block = ctx.mir_create_block("for_await_suspend")
    var done_block = ctx.mir_create_block("for_await_done")

    # Save old break/continue targets for nested loops
    var saved_break = ctx.mir_ctx_get_break_target()
    var saved_continue = ctx.mir_ctx_get_continue_target()
    var saved_loop_scope = ctx.mir_ctx_get_loop_scope_depth()
    var saved_loop_defer = ctx.mir_ctx_get_loop_defer_depth()
    var saved_loop_wrap = ctx.mir_ctx_get_loop_wrap_depth()

    # Set targets for this loop
    var loop_scope = ctx.mir_ctx_get_scope_depth()
    ctx.mir_ctx_set_break_target(done_block)
    ctx.mir_ctx_set_continue_target(loop_block)
    ctx.mir_ctx_set_loop_scope_depth(loop_scope)
    ctx.mir_ctx_set_loop_defer_depth(ctx.drops.defer_stack.size)
    ctx.mir_ctx_set_loop_wrap_depth(ctx.wrap_stack_eff_names.size)

    # Jump to loop
    var entry = ctx.mir_ctx_get_block()
    mir_block_set_terminator(entry, mir::TERM_JUMP, loop_block)

    # Loop: reload ch, try_recv_or_closed(ch) — atomic check of buffer+closed
    # Returns: >0 = Option ptr (got value), 0 = empty+open, -1 = empty+closed
    ctx.mir_switch_to_block(loop_block)
    var ch_reload = ctx.mir_emit_load_var(ch_var_name)
    var recv_args = vec_new()
    recv_args.push(ch_reload)
    var status = ctx.mir_emit_intrinsic("try_recv_or_closed", recv_args)

    # Check if we received a value (status > 0 means Option pointer)
    var zero = ctx.mir_emit_const_int(0)
    var got_value = ctx.mir_emit_binary(op_constants::OP_GT, status, zero)
    var loop_cur = ctx.mir_ctx_get_block()
    mir_block_set_branch(loop_cur, got_value, body_block, closed_block)

    # Body: status IS the Option pointer — extract value, bind, lower body
    ctx.mir_switch_to_block(body_block)
    var get_args = vec_new()
    get_args.push(status)
    var value = ctx.mir_emit_intrinsic("option_get", get_args)
    var free_args = vec_new()
    free_args.push(status)
    ctx.mir_emit_intrinsic("option_free", free_args)
    # Register the loop variable FIRST so the body resolves `var_name` via
    # mir_ctx_lookup_var instead of falling through to a same-named free
    # function (for-await-channel guise of the 30d37c96 shadow miscompile).
    var fa_var_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(var_name, fa_var_slot)
    ctx.mir_emit_store_var(var_name, value)
    mir_lower_block(ctx, s, body_node)
    var body_cur = ctx.mir_ctx_get_block()
    if mir_block_get_term_kind(body_cur) < 0
      mir_block_set_terminator(body_cur, mir::TERM_JUMP, loop_block)
    end

    # Closed check: status == -1 means empty+closed (done), else empty+open (suspend)
    ctx.mir_switch_to_block(closed_block)
    var neg_one = ctx.mir_emit_const_int(-1)
    var is_closed = ctx.mir_emit_binary(op_constants::OP_EQ, status, neg_one)
    var closed_cur = ctx.mir_ctx_get_block()
    mir_block_set_branch(closed_cur, is_closed, done_block, suspend_block)

    # Suspend: channel open but empty — park or io_suspend based on context
    ctx.mir_switch_to_block(suspend_block)
    if mir_lower_gen::mir_gen_is_active() >= 2
      # Async context: park task on channel (TOCTOU-safe under mutex)
      # Same pattern as direct recv() — channel_park_recv re-checks buffer
      var __fa_ch_w = ctx.mir_emit_load_var(ch_var_name)
      var __fa_self = ctx.mir_emit_load_var("self")
      var __fa_park_args = [__fa_ch_w, __fa_self]
      var __fa_park_result = ctx.mir_emit_intrinsic("channel_park_recv", __fa_park_args)
      var __fa_should_retry = ctx.mir_emit_binary(op_constants::OP_EQ, __fa_park_result, ctx.mir_emit_const_int(1))
      var __fa_park_block = ctx.mir_create_block("for_await_park")
      ctx.mir_emit_branch(__fa_should_retry, loop_block, __fa_park_block)

      # PARK: set park pending flag and yield — scheduler won't re-enqueue
      # Send will wake us via __qz_sched_wake when data arrives
      ctx.mir_switch_to_block(__fa_park_block)
      ctx.mir_emit_intrinsic("sched_set_park_pending", vec_new())
      mir_lower_gen::mir_emit_async_suspend_point(ctx, -1, loop_block)
    else
      # Non-async: io_suspend-based (existing behavior, no scheduler available)
      var ch_reload2 = ctx.mir_emit_load_var(ch_var_name)
      var nfd_args = vec_new()
      nfd_args.push(ch_reload2)
      var nfd = ctx.mir_emit_intrinsic("channel_notify_fd", nfd_args)
      var suspend_args = vec_new()
      suspend_args.push(nfd)
      ctx.mir_emit_intrinsic("io_suspend", suspend_args)
      var susp_cur = ctx.mir_ctx_get_block()
      mir_block_set_terminator(susp_cur, mir::TERM_JUMP, loop_block)
    end

    # Restore old break/continue targets
    ctx.mir_ctx_set_break_target(saved_break)
    ctx.mir_ctx_set_continue_target(saved_continue)
    ctx.mir_ctx_set_loop_scope_depth(saved_loop_scope)
    ctx.mir_ctx_set_loop_defer_depth(saved_loop_defer)
    ctx.mir_ctx_set_loop_wrap_depth(saved_loop_wrap)

    # Done block: continue after loop
    ctx.mir_switch_to_block(done_block)
    return
  end


  # Match statement - node_constants$NODE_MATCH = 40 (C-aligned) - desugar to if-else chain
  if kind == node_constants::NODE_MATCH
    mir_lower_stmt_handlers::mir_lower_stmt_match(ctx, s, node)
    return
  end
  
  # Break statement (NodeBreak = 30)
  if kind == node_constants::NODE_BREAK
    var label = ast::ast_get_str1(s, node)
    var break_target = 0
    var target_scope_depth = -1
    var target_wrap_depth = -1
    if str_byte_len(label) > 0
      break_target = ctx.mir_ctx_find_loop_break(label)
      target_scope_depth = ctx.mir_ctx_find_loop_scope_depth(label)
      target_wrap_depth = ctx.mir_ctx_find_loop_wrap_depth(label)
      if break_target == 0
        break_target = ctx.mir_ctx_get_break_target()
        target_scope_depth = ctx.mir_ctx_get_loop_scope_depth()
        target_wrap_depth = ctx.mir_ctx_get_loop_wrap_depth()
      end
    else
      break_target = ctx.mir_ctx_get_break_target()
      target_scope_depth = ctx.mir_ctx_get_loop_scope_depth()
      target_wrap_depth = ctx.mir_ctx_get_loop_wrap_depth()
    end

    # If break has a value AND we're in a loop-as-expression context,
    # store the value to the result variable before jumping.
    var break_val_node = ast::ast_get_left(s, node)
    if break_val_node > 0 and _loop_expr_result_var != ""
      var break_val = ctx.mir_lower_expr(s, break_val_node)
      ctx.mir_emit_store_var(_loop_expr_result_var, break_val)
    end

    # Emit defers and drops for scopes between current and loop scope
    var target_defer_depth = ctx.mir_ctx_get_loop_defer_depth()
    emit_deferred_to_depth(ctx, target_defer_depth)
    if target_scope_depth >= 0
      emit_drops_for_scope(ctx, target_scope_depth + 1)
    end

    # Diag-leak fix follow-on: drain runtime effect-stack entries for any
    # `with E {...} do ... end` blocks opened INSIDE the loop body. The
    # enclosing wraps stay live because we only drain ABOVE target_wrap_depth.
    # Does NOT pop the wrap-stack itself — natural fall-through (if reached
    # via the else branch of an if/else) still needs the matching pop_wrap.
    if target_wrap_depth >= 0
      ctx.mir_ctx_emit_wrap_pops_to_depth(target_wrap_depth)
    end

    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_terminator(cur_block, mir::TERM_JUMP, break_target)
    return
  end

  # Continue statement (NodeContinue = 31)
  if kind == node_constants::NODE_CONTINUE
    var label = ast::ast_get_str1(s, node)
    var continue_target = 0
    var target_scope_depth = -1
    var target_wrap_depth = -1
    if str_byte_len(label) > 0
      continue_target = ctx.mir_ctx_find_loop_continue(label)
      target_scope_depth = ctx.mir_ctx_find_loop_scope_depth(label)
      target_wrap_depth = ctx.mir_ctx_find_loop_wrap_depth(label)
      if continue_target == 0
        continue_target = ctx.mir_ctx_get_continue_target()
        target_scope_depth = ctx.mir_ctx_get_loop_scope_depth()
        target_wrap_depth = ctx.mir_ctx_get_loop_wrap_depth()
      end
    else
      continue_target = ctx.mir_ctx_get_continue_target()
      target_scope_depth = ctx.mir_ctx_get_loop_scope_depth()
      target_wrap_depth = ctx.mir_ctx_get_loop_wrap_depth()
    end

    # Emit defers and drops for scopes between current and loop scope
    var target_defer_depth = ctx.mir_ctx_get_loop_defer_depth()
    emit_deferred_to_depth(ctx, target_defer_depth)
    if target_scope_depth >= 0
      emit_drops_for_scope(ctx, target_scope_depth + 1)
    end

    # Drain wraps opened inside the loop body — see NODE_BREAK above.
    if target_wrap_depth >= 0
      ctx.mir_ctx_emit_wrap_pops_to_depth(target_wrap_depth)
    end

    var cur_block = ctx.mir_ctx_get_block()
    mir_block_set_terminator(cur_block, mir::TERM_JUMP, continue_target)
    return
  end

  # Defer statement (NodeDefer = 61)
  if kind == node_constants::NODE_DEFER
    # Push the deferred expression onto the defer stack
    # It will be emitted at all function exit points (before drops)
    var expr_node = ast::ast_get_left(s, node)
    push_defer(ctx, s, expr_node)
    return
  end

  # Task group block as statement (NodeTaskGroup = 71)
  if kind == node_constants::NODE_TASK_GROUP
    ctx.mir_lower_expr(s, node)
    return
  end
end

# ============================================================================
# Function lowering
# ============================================================================

## item 20 P2 — is the function AST node `node` a BORROWED mutating COW value-struct
## `self` receiver? Returns 1 iff: param 0 is named `self`, its declared type is
## value-layout AND cow-layout (>16B @value), and the body directly stores to
## `self.<field>`. This is the CALLEE-side twin of the call-site
## `mir_callee_is_mut_value_receiver` predicate (which, post-P2, also fires for cow).
## When 1, mir_lower_function{,_with_name} sets ctx.borrowed_self_receiver so the
## droppable registration skips registering `self` (no scope-exit cow_release — the
## caller owns the buffer and passed it WITHOUT a retain) and the field-assign
## make-unique gate skips forking (mutate the caller's buffer in place). The
## resolved param type is taken straight from the AST annotation (str2); generic
## args are stripped before the cow-layout query. Gate-0-inert: cow-layout is false
## for plain structs at the F4 flip == 0, so this returns 0 ⇒ flag never set.
## owner-Q#5 predicate consolidation (item-20 Phase 7 / WS4-a). The SINGLE shared
## "borrowed mutating COW value-struct self receiver" gate, keyed off an
## ALREADY-COMPUTED `mutates_self` verdict (the cached body-mutates-self result).
## Both callee-side lowering paths hoist ONE `mir_body_assigns_self_field` call to
## function entry and pass its result here, instead of the predicate re-walking the
## body itself. Byte-identical to the former inline recompute: same layout/cow
## gates, same mutates verdict. Gate-0-inert (cow-layout false ⇒ returns 0).
def mir_receiver_is_borrowed_mut_self(ctx: MirContext, s: ast::AstStorage, node: Int, mutates_self: Int): Int
  return 0 if node < 0
  var params = ast::ast_get_left(s, node)
  return 0 if params < 0
  return 0 if vec_size(params) == 0
  var p0 = params[0]
  return 0 if ast::ast_get_str1(s, p0).eq("self") == 0
  var p0_ty = ast::ast_get_str2(s, p0)
  return 0 if str_byte_len(p0_ty) == 0
  # Strip generic args (Type<...>) before the layout query.
  var lt = __char_index(p0_ty, '<')
  if lt > 0
    p0_ty = str_byte_slice(p0_ty, 0, lt)
  end
  return 0 if mir::mir_is_value_layout_type(ctx, p0_ty) == 0
  return 0 if mir::mir_value_is_cow_layout(ctx, p0_ty) == 0
  return mutates_self
end

## item 20 P2 — thin wrapper preserved for any non-hoisted caller: computes the
## body-mutates-self verdict then delegates to the consolidated gate. The two
## in-tree callee-lowering paths now compute `mutates_self` ONCE and call
## `mir_receiver_is_borrowed_mut_self` directly (Q#5 consolidation).
def mir_func_node_is_borrowed_cow_self_receiver(ctx: MirContext, s: ast::AstStorage, node: Int): Int
  return 0 if node < 0
  var body = ast::ast_get_right(s, node)
  return 0 if body < 0
  return mir_receiver_is_borrowed_mut_self(ctx, s, node, mir_body_assigns_self_field(s, body))
end

## items 9h+9i — does the binding named `pname` ESCAPE the body `root`?
## CONSERVATIVE escape analysis used to decide whether a NON-self by-value COW
## `@value` param may be BORROWED (no callee-release / no caller-retain — the
## item-20 self exemption generalized to any provably read-only cow param). A
## param escapes if its SSA/name flows into something that takes ownership or
## could outlive the call: `return`, a store to a struct field / collection, a
## struct-literal field, or a by-value call argument. The ONLY non-escaping use
## we admit is a read of one of the param's FIELDS — i.e. the param IDENT appears
## strictly as the OBJECT (`ast_get_left`) of a NODE_FIELD_ACCESS (`p.field`).
## EVERY other occurrence of the bare name (return operand, call argument,
## assignment RHS, struct-literal value, field-assign value, vec_push arg, …)
## is treated as escaping. This is deliberately conservative: when unsure we
## report escape (1) ⇒ keep TODAY's retain+release behavior ⇒ no new double-free.
## Implementation: one work-queue tree walk. We mark the specific node handle
## that sits in a FIELD_ACCESS object slot as a SAFE read; then any IDENT handle
## named `pname` that was NOT so marked is an escape. Returns 1 if it escapes.
def mir_param_escapes(s: ast::AstStorage, root: Int, pname: String): Int
  return 1 if root <= 0
  return 1 if str_byte_len(pname) == 0
  var node_count = ast::ast_node_count(s)
  # First pass: collect the handles of param-IDENTs that are a FIELD_ACCESS object
  # (safe reads), and the handles of ALL param-IDENT occurrences.
  var safe_handles = vec_new()
  var ident_handles = vec_new()
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    if node <= 0 or node >= node_count
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    # A field-READ `pname.field`: the object (left) is a SAFE use of the param.
    if kind == node_constants::NODE_FIELD_ACCESS
      var obj = ast::ast_get_left(s, node)
      if obj > 0 and obj < node_count
        if ast::ast_get_kind(s, obj) == node_constants::NODE_IDENT
          if ast::ast_get_str1(s, obj).eq(pname)
            safe_handles.push(obj)
          end
        end
      end
    end
    # Record any IDENT occurrence of the param name.
    if kind == node_constants::NODE_IDENT
      if ast::ast_get_str1(s, node).eq(pname)
        ident_handles.push(node)
      end
    end
    # Traverse children / left / right / extra (same shape as the self-field walk).
    var children_raw = ast::ast_get_children_raw(s, node)
    if children_raw > 0
      var children = ast::ast_get_children(s, node)
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0 and child < node_count
          queue.push(child)
        end
      end
    end
    var left = ast::ast_get_left(s, node)
    if left > 0 and left < node_count
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0 and right < node_count
      queue.push(right)
    end
    var extra = ast::ast_get_extra(s, node)
    if extra > 0 and extra < node_count
      queue.push(extra)
    end
  end
  # Any param-IDENT occurrence that is NOT a recorded safe FIELD_ACCESS object
  # is an escape.
  var ni = 0
  while ni < ident_handles.size
    var ih = ident_handles[ni]
    var is_safe = 0
    var si = 0
    while si < safe_handles.size
      if safe_handles[si] == ih
        is_safe = 1
      end
      si = si + 1
    end
    if is_safe == 0
      return 1
    end
    ni = ni + 1
  end
  return 0
end

## items 9h+9i — may the param at index `idx` of function AST `node` be BORROWED?
## Returns 1 iff: the param's declared type is value-layout AND cow-layout (>16B
## @value) AND the param does NOT escape the body (mir_param_escapes == 0). When
## 1, the callee skips registering the param droppable (no scope-exit cow_release)
## and the call site skips the V2b cow_rc_inc retain for args bound to this slot —
## net no-retain/no-release, exactly item-20's self exemption, generalized to a
## provably read-only NON-self cow param. An ESCAPING cow param (or any non-cow /
## non-@value param) returns 0 ⇒ unchanged retain+release ⇒ no new double-free.
## Gate-0-inert: cow-layout is false for plain structs at the F4 flip == 0.
def mir_cow_value_param_is_borrowed(ctx: MirContext, s: ast::AstStorage, node: Int, idx: Int): Int
  return 0 if node < 0
  var params = ast::ast_get_left(s, node)
  return 0 if params < 0
  return 0 if idx < 0
  return 0 if idx >= vec_size(params)
  var p = params[idx]
  var pname = ast::ast_get_str1(s, p)
  return 0 if str_byte_len(pname) == 0
  var p_ty = ast::ast_get_str2(s, p)
  return 0 if str_byte_len(p_ty) == 0
  # Strip generic args (Type<...>) before the layout query.
  var lt = __char_index(p_ty, '<')
  if lt > 0
    p_ty = str_byte_slice(p_ty, 0, lt)
  end
  return 0 if mir::mir_is_value_layout_type(ctx, p_ty) == 0
  return 0 if mir::mir_value_is_cow_layout(ctx, p_ty) == 0
  var body = ast::ast_get_right(s, node)
  return 0 if body < 0
  # ESCAPE gate: only borrow a provably non-escaping (read-only) cow param.
  return 0 if mir_param_escapes(s, body, pname) == 1
  return 1
end

## item 20 — is `recv` a self-rooted receiver, i.e. `self` or `self.<field>[.<field>…]`?
## Walks down the NODE_FIELD_ACCESS `left` (base) chain (layout { left = base,
## str1 = field }, ast.qz:1017) and returns 1 iff the chain bottoms out at a
## NODE_IDENT named `self`. Bare `self` (NODE_IDENT) returns 1 directly. Any other
## root (a local, a call result, an index) returns 0. Handle-bounded against the
## same OOB shapes `mir_body_assigns_self_field` guards. Used by the transitive
## self-mutation detection below.
def mir_receiver_is_self_rooted(s: ast::AstStorage, node: Int): Int
  var node_count = ast::ast_node_count(s)
  var cur = node
  # Bound the descent: a self.<field> chain is finite, but guard against a
  # malformed cyclic/OOB handle just in case (cap at node_count iterations).
  var steps = 0
  while cur > 0 and cur < node_count and steps < node_count
    var kind = ast::ast_get_kind(s, cur)
    if kind == node_constants::NODE_IDENT
      if ast::ast_get_str1(s, cur).eq("self")
        return 1
      end
      return 0
    end
    if kind == node_constants::NODE_FIELD_ACCESS
      cur = ast::ast_get_left(s, cur)
      steps = steps + 1
      continue
    end
    # Any other receiver shape (call, index, literal) is not self-rooted.
    return 0
  end
  return 0
end

## item 20 — does this function body mutate its `self` receiver, DIRECTLY or
## TRANSITIVELY? Work-queue whole-tree scan (mirrors `mir_body_has_ufcs_calls`)
## returning 1 on the FIRST of either:
##   (a) DIRECT store: a NODE_FIELD_ASSIGN whose object/receiver (`ast_get_left`)
##       is a NODE_IDENT named `self`. Layout { left = object, str1 = field,
##       extra = value } (mir_lower_stmt_field_assign).
##   (b) TRANSITIVE mutation (item-20 v2): a UFCS NODE_CALL (extra/is_ufcs != 0)
##       whose first arg (the receiver, args[0]) is self-rooted (`self` or
##       `self.<field>…`, via mir_receiver_is_self_rooted). A self-method call
##       MAY mutate self, so conservatively flag it. UFCS only (the `is_ufcs`
##       flag distinguishes `self.advance()` from a free call that merely takes
##       `self` as an arg by value), so this is methods-only — no item-22
##       free-function-copy ambiguity.
## WHY conservative over-approximation is safe: over-flagging a READ-ONLY
## self-method-caller only passes self by-pointer instead of by-copy — the method
## reads self either way, no mutation, the caller's slot is unchanged. And the
## whole marker is gate-0-inert: the value-layout gate in every consumer
## (mir_func_param0_is_mut_value_receiver, mir_callee_is_mut_value_receiver, the
## COW field-store gate) short-circuits when no struct is value-layout, so the
## marker is dead for plain (gate-0) structs ⇒ byte-identical self-compile.
## Cached onto MirFunc by `mir_lower_function`.
def mir_body_assigns_self_field(s: ast::AstStorage, root: Int): Int
  if root <= 0
    return 0
  end
  var node_count = ast::ast_node_count(s)
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    # Bound the handle: a node's `children` slot is 0 for childless nodes (see
    # ast.qz `s.children.push(0)`); `as_vec(0)` yields a junk vec whose entries are
    # NOT node handles. Method bodies (lowered via mir_lower_function_with_name)
    # reach such shapes that the free-function path never did, so a raw whole-tree
    # walk would push a garbage child and index s.kinds OOB (size-57 crash). Reject
    # any handle outside [1, node_count) before touching storage.
    if node <= 0 or node >= node_count
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    if kind == node_constants::NODE_FIELD_ASSIGN
      var obj = ast::ast_get_left(s, node)
      if obj > 0 and obj < node_count
        if ast::ast_get_kind(s, obj) == node_constants::NODE_IDENT
          if ast::ast_get_str1(s, obj).eq("self")
            return 1
          end
        end
      end
    end
    # item 20 v2 — TRANSITIVE self-mutation: a UFCS method call whose receiver
    # (args[0]) is self-rooted (`self.advance()` / `self.lex.bump()`). Conservatively
    # assume such a call may mutate self → flag the enclosing method. UFCS-only
    # (extra/is_ufcs != 0) so a free call merely passing `self` by value is excluded
    # (that is the item-22 by-value-copy case, deliberately untouched).
    if kind == node_constants::NODE_CALL
      if ast::ast_call_is_ufcs(s, node) != 0
        var cargs = ast::ast_get_children(s, node)
        if vec_size(cargs) > 0
          var recv = cargs[0]
          if recv > 0 and recv < node_count
            if mir_receiver_is_self_rooted(s, recv) == 1
              return 1
            end
          end
        end
      end
    end
    # Traverse children — only when the raw slot is a real vec handle (non-zero).
    # `ast_get_children` is `as_vec(s.children[node])`; guard the raw slot directly
    # so a 0 slot never becomes a bogus vec.
    var children_raw = ast::ast_get_children_raw(s, node)
    if children_raw > 0
      var children = ast::ast_get_children(s, node)
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0 and child < node_count
          queue.push(child)
        end
      end
    end
    # Traverse left/right/extra subtrees
    var left = ast::ast_get_left(s, node)
    if left > 0 and left < node_count
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0 and right < node_count
      queue.push(right)
    end
    var extra = ast::ast_get_extra(s, node)
    if extra > 0 and extra < node_count
      queue.push(extra)
    end
  end
  return 0
end

## item 38 — does the body reference `self` as a value (any NODE_IDENT named
## "self")? A genuine receiver method reads `self` (field access, method call,
## passing it along); an ASSOCIATED (receiver-less, `Type::fn`-called) function
## never does — its `self` param 0 is a phantom injected by the registry so
## static methods register uniformly. Whole-tree walk mirroring
## `mir_body_assigns_self_field`'s handle-bounding (a 0 `children` slot is NOT a
## node-handle vec). Used by the function-lowering paths to set
## `assoc_phantom_self` so the codegen decompose predicates (MirFunc-only, no
## AST) keep a phantom value-layout `self` out of register-decompose.
def mir_body_references_self(s: ast::AstStorage, root: Int): Int
  if root <= 0
    return 0
  end
  var node_count = ast::ast_node_count(s)
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    if node <= 0 or node >= node_count
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    if kind == node_constants::NODE_IDENT
      if ast::ast_get_str1(s, node).eq("self")
        return 1
      end
    end
    var children_raw = ast::ast_get_children_raw(s, node)
    if children_raw > 0
      var children = ast::ast_get_children(s, node)
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0 and child < node_count
          queue.push(child)
        end
      end
    end
    var left = ast::ast_get_left(s, node)
    if left > 0 and left < node_count
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0 and right < node_count
      queue.push(right)
    end
    var extra = ast::ast_get_extra(s, node)
    if extra > 0 and extra < node_count
      queue.push(extra)
    end
  end
  return 0
end

## item 38 — set `assoc_phantom_self` on `func` iff param 0 is named `self` but
## the body never references it (the associated-fn phantom-self signature). Both
## function-lowering paths call this after the param loop + body lowering.
## Gate-0-inert: the consumer only fires when param 0 is value-layout.
def mir_mark_assoc_phantom_self(func: mir::MirFunc, s: ast::AstStorage, body_node: Int): Void
  return if func.params.size == 0
  return if func.params[0].eq("self") == 0
  if body_node >= 0 and mir_body_references_self(s, body_node) == 0
    mir::mir_func_set_assoc_phantom_self(func, 1)
  end
end

def mir_lower_function(ctx: MirContext, s: ast::AstStorage, node: AstNodeId): Void
  # Reset droppable tracking for this function
  reset_droppables(ctx)
  
  # Reset defer stack for this function
  reset_defers(ctx)
  
  # Reset string variable tracking to prevent cross-function pollution
  reset_string_vars(ctx)
  reset_float_vars(ctx)
  reset_vec_elem_types(ctx)
  reset_map_key_types(ctx)
  reset_struct_types(ctx)

  # Reset bindings to prevent cross-function pollution of variable names
  ctx.bindings = vec_new()

  var prog = ctx.mir_ctx_get_program()
  var name = ast::ast_get_str1(s, node)
  var func = mir_new_function(name, mir::MIR_TYPE_INT)
  # INC.1.2 — tag the producing module so qzmod_emit can filter
  # mir_prog.functions per .qzmod module artifact. Resolve via dep_graph
  # using the ast_store handle, NOT ctx.module_name — ctx.module_name is
  # extracted from the function's prefixed final_name via
  # `mir_extract_module_name`, which returns "" for prefix-less stdlib
  # helpers (e.g. `__char_index` in `str_compat`). dep_graph carries the
  # canonical import-path name keyed by ast_store, so it works for both
  # prefix-bearing methods and prefix-less free functions.
  mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(s))

  # Set function line info for debug metadata
  var func_line = ast::ast_get_line(s, node)
  mir_func_set_line(func, func_line)

  # Store original return type name for narrow type codegen
  var ret_type_name = ast::ast_get_str2(s, node)
  if str_byte_len(ret_type_name) > 0
    # R2 (C3) — a structural-record RETURN annotation (`{ x: Int, y: Int }`) must be
    # canonicalized to C1's registered sorted `__rec$...$rec_` @value struct name so
    # `mir_func_returns_byval_struct` (exact-match) recognizes it and returns it byval
    # (≤16B `{i64 x N}`) or via cow-buffer-ptr (>16B), instead of the fc=0 bare-i64
    # fallthrough that reads garbage on the caller's field access. Register first so
    # the @value struct is live in the registry before any read side. GATE-0-INERT:
    # gated on mir_is_record_annotation (non-intersection), which the compiler's own
    # return types never satisfy ⇒ byte-identical.
    if mir::mir_is_record_annotation(ret_type_name) and mir::mir_record_is_intersection(ret_type_name) == false
      mir::mir_register_record_struct(ctx, ret_type_name, s)
      ret_type_name = mir::mir_record_canonical_name(ret_type_name)
    end
    mir_func_set_return_type_name(func, ret_type_name)
  end

  # Propagate @naked attribute from AST
  if ast::ast_func_is_naked(s, node)
    mir_func_set_naked(func)
  end

  # Propagate @noinline attribute from AST
  if ast::ast_func_is_noinline(s, node)
    mir_func_set_noinline(func)
  end

  # Propagate @weak attribute from AST
  if ast::ast_func_is_weak(s, node)
    mir_func_set_weak(func)
  end

  # Propagate @panic_handler attribute from AST — register the raw
  # function name in the program so the panic-intrinsic emission path
  # can route calls to this handler. Name is sanitized at emit time.
  if ast::ast_func_is_panic_handler(s, node)
    mir::mir_set_panic_handler(ctx.program, name)
  end

  # Propagate @export attribute from AST — WASM backend reads this in
  # codegen_wasm to emit the function in the export section.
  if ast::ast_func_is_export(s, node)
    mir_func_set_export(func)
  end

  # Propagate @no_preempt attribute from AST (P21: skip fuel_check instrumentation)
  if ast::ast_func_is_no_preempt(s, node)
    mir_func_set_no_preempt(func)
  end

  # Propagate @ct attribute from AST (NET.4 Layer 3: ct_taint MIR pass)
  if ast::ast_func_is_ct(s, node)
    mir::mir_func_set_ct(func)
  end

  # Propagate C calling convention from AST (extern "C" def with body)
  if ast::ast_func_is_cconv_c(s, node)
    mir_func_set_cconv_c(func)
  end

  # Propagate x86-interrupt calling convention from AST
  if ast::ast_func_is_cconv_x86_intr(s, node)
    mir_func_set_cconv_x86_intr(func)
  end

  # Propagate preserve_all / preserve_most calling conventions from AST
  if ast::ast_func_is_cconv_preserve_all(s, node)
    mir_func_set_cconv_preserve_all(func)
  end
  if ast::ast_func_is_cconv_preserve_most(s, node)
    mir_func_set_cconv_preserve_most(func)
  end

  mir_get_functions(prog).push(func)
  ctx.mir_ctx_set_func(func)

  # item 20 P2 — borrowed mutating COW value-struct `self` receiver (see the twin
  # in mir_lower_function_with_name). A free-function-form value-struct method
  # (`def bump(self: Big)`) lowers through THIS path, so the flag must be set here
  # too. Computed before the param loop; cleared at function exit. Gate-0-inert.
  #
  # owner-Q#5 consolidation (WS4-a): compute `mutates_self` ONCE here and reuse it
  # for BOTH the borrowed-self gate (below) and the cached-flag set (after the param
  # loop). Byte-identical: same body node, same verdict, same gate.
  var mut_body_node = ast::ast_get_right(s, node)
  var mutates_self = 0
  if mut_body_node >= 0
    mutates_self = mir_body_assigns_self_field(s, mut_body_node)
  end
  var params = ast::ast_get_left(s, node)
  # item-20 Phase 7 (WS4-a) — an EXPLICIT `&mut self` receiver forces the borrow
  # ABI even if inference does not see a field-assign (authoritative-upward; never
  # downgrades). recv_borrow==2 sets the same `mutates_self` verdict the inference
  # computes, feeding BOTH the borrowed-self gate and the cached flag. Byte-identical
  # at gate 0: no self-hosted method declares `&mut self` (recv_borrow stays 0).
  if params >= 0 and vec_size(params) > 0
    if ast::ast_param_receiver_borrow(s, params[0]) == 2
      mutates_self = 1
    end
  end
  mir::mir_ctx_set_borrowed_self_receiver(ctx, mir_receiver_is_borrowed_mut_self(ctx, s, node, mutates_self))

  # Node handles start at 0, use >= 0 for valid nodes
  if params >= 0
    var param_count = vec_size(params)
    for i in 0..param_count
      var param = params[i]
      var param_name = ast::ast_get_str1(s, param)
      mir_func_add_param(func, param_name, mir::MIR_TYPE_INT)
      var slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(param_name, slot)
      # Mark param as string if type annotation is exactly String
      # NOTE: Do NOT use substring match — Vec<String> vars are NOT strings
      var param_type = ast::ast_get_str2(s, param)
      if param_type == "String"
        ctx.mir_ctx_mark_string_var(param_name)
      end
      if param_type == "F64" or param_type == "F32"
        ctx.mir_ctx_mark_float_var(param_name)
      end
      # Track Map<K,V> parameters so for-in over the param uses the correct
      # key-type-specialized map_keys codegen.
      if param_type.starts_with("Map<")
        var pm_lt = __char_index(param_type, '<')
        if pm_lt > 0
          var pm_inner = str_byte_slice(param_type, pm_lt + 1, str_byte_len(param_type))
          var pm_comma = __char_index(pm_inner, ',')
          if pm_comma > 0
            var pm_key = str_byte_slice(pm_inner, 0, pm_comma)
            while str_byte_len(pm_key) > 0 and str_byte_at(pm_key, str_byte_len(pm_key) - 1) == ' '
              pm_key = str_byte_slice(pm_key, 0, str_byte_len(pm_key) - 1)
            end
            if str_byte_len(pm_key) > 0
              ctx.mir_ctx_mark_map_key_type(param_name, pm_key)
            end
          end
        end
        # Track the VALUE type (V) so `m.set(k, None)` on a `Map<K, Option<V>>`
        # PARAM niche-builds its value (else spill → niche-read misreads as Some).
        var pm_val = mir::mir_extract_map_value_type(param_type)
        if str_byte_len(pm_val) > 0
          ctx.mir_ctx_mark_map_value_type(param_name, pm_val)
        end
      end
      # item 52 — register a `Vec<S>` PARAM's element type (value-layout only) so
      # an explicit `vec_push(v, c)` on the param recovers the element type via the
      # vec-elem registry fallback. See the twin block in mir_lower_function_with_name.
      # GATE-0-INERT: gated on mir_is_value_layout_type(elem)==1 (0 pre-flip).
      if str_byte_len(param_type) > 0 and param_type.starts_with("Vec<")
        var pv_elem = mir::mir_extract_generic_element_type(param_type)
        # R2 (C3) — a `Vec<{ x: Int }>` PARAM's element annotation is raw record;
        # canonicalize to C1's registered @value struct name (register first) so the
        # value-layout gate + vec-elem registry see the flat-offset record layout.
        # GATE-0-INERT: gated on mir_is_record_annotation ⇒ byte-identical.
        if str_byte_len(pv_elem) > 0 and mir::mir_is_record_annotation(pv_elem) and mir::mir_record_is_intersection(pv_elem) == false
          mir::mir_register_record_struct(ctx, pv_elem, s)
          pv_elem = mir::mir_record_canonical_name(pv_elem)
        end
        if str_byte_len(pv_elem) > 0 and mir::mir_is_value_layout_type(ctx, pv_elem) == 1
          ctx.mir_ctx_mark_vec_elem_type(param_name, pv_elem)
        end
      end
      # Store original param type name for narrow type codegen
      if str_byte_len(param_type) > 0
        mir_func_set_param_type_name(func, i, param_type)
      end
      # Track droppable parameters — skip self in Drop impls to prevent infinite recursion
      # item 20 P2 — also skip a borrowed mutating COW value-struct `self` (param 0):
      # the caller passed its buffer without a retain, so a scope-exit cow_release here
      # would double-free. Mirrors the with_name path. Gate-0-inert.
      # items 9h+9i — also skip a borrowed NON-self by-value COW @value param (a
      # provably non-escaping read-only cow arg): the caller passes its live buffer
      # WITHOUT a retain (V2b retain skipped symmetrically), so registering it
      # droppable would emit a scope-exit cow_release that double-frees the still-
      # owned buffer (vec element / HOF predicate). Gate-0-inert (cow-layout false).
      if str_byte_len(param_type) > 0
        if type_needs_drop(ctx, param_type)
          if not str_ends_with(name, "$drop")
            if not (i == 0 and mir::mir_ctx_get_borrowed_self_receiver(ctx) == 1)
              if mir_cow_value_param_is_borrowed(ctx, s, node, i) == 0
                push_droppable(ctx, param_name, param_type)
              end
            end
          end
        end
      end
    end
  end

  var entry = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(entry)

  # P21 / R3.2: ONE fuel_check at function entry (BEAM-style reduction counting).
  # Preemption is now "once per function activation" instead of "once per direct
  # call site": every direct call into a non-@no_preempt function decrements fuel
  # via the callee's OWN entry check, so the per-call-site direct check (formerly
  # at mir_lower_expr_handlers:4246) is redundant and was removed. The recursion
  # case (fib: no loop back-edge) is covered here — each recursive activation hits
  # this entry check. Loop back-edge checks (mir_lower_stmt_handlers,
  # mir_lower_iter) and indirect/lambda/fn-ptr/op-call checks are KEPT (back-edges
  # bound progress within an activation; indirect targets are unknown at the call
  # site). @no_preempt / freestanding / async-$poll emit no check (the helper
  # short-circuits) — the documented, correct behavior.
  mir_emit_fuel_check(ctx)

  var body_node = ast::ast_get_right(s, node)
  # item 20 P1 — cache whether the body directly stores to `self.<field>` (OR was
  # declared `&mut self`) so the codegen-time decompose predicates (which see only
  # MirFunc, no AST) can keep a mutated value-struct `self` receiver out of register-
  # decompose. `mutates_self` was computed ONCE at function entry (Q#5 consolidation)
  # from the SAME body node, then OR'd with the explicit `&mut self` annotation.
  # Gate-0-inert: the marker is dead unless param 0 is a value-layout struct, which
  # the consumer's value-layout gate short-circuits at the F4 flip == 0.
  if mutates_self != 0
    mir::mir_func_set_mutates_self_field(func, 1)
  end
  # item 38 — mark a phantom (associated-fn) `self` param 0 so codegen excludes it
  # from value-decompose. Gate-0-inert.
  mir_mark_assoc_phantom_self(func, s, body_node)
  # Node handles start at 0, use >= 0 for valid nodes
  if body_node >= 0
    ctx.mir_lower_stmt(s, body_node)
  end

  var block = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(block) < 0
    # Implicit void return - emit drops before returning
    emit_drops_for_scope(ctx, 0)
    # B.10 §14.12.8 (C4) — the cow_release destroy arm may split the block
    # (conditional free); re-fetch the current block before terminating. With no
    # cow drops this is the same `block`. INERT at gate 0 (no split emitted).
    block = ctx.mir_ctx_get_block()
    mir_block_set_terminator(block, mir::TERM_RETURN, -1)
  end
  # item 20 P2 — clear the borrowed-self-receiver flag so it never leaks into the
  # next function's lowering. Gate-0-inert (was already 0).
  mir::mir_ctx_set_borrowed_self_receiver(ctx, 0)
end

# ============================================================================
# Entry point
# ============================================================================

## Lowers an AST program to MIR.
##
## This is the main entry point for MIR lowering. It performs:
## 1. Creates a new MIR program storage
## 2. Builds enum registry from enum definitions
## 3. Lowers each function definition to MIR functions
##
## @param ast_storage AST arena storage handle
## @param root Root program AST node handle
## @returns MIR program storage handle
## @example
##   # After parsing and type checking:
##   mir_prog = mir_lower_program(ast_storage, program_node)
##   codegen_program(mir_prog)
## Check if an AST subtree contains any UFCS method calls (dot-syntax).
## Uses a work-queue scan of the AST. Returns 1 if found, 0 otherwise.
## Used by PASS 0.95 to detect structurally-constrained functions.
def mir_body_has_ufcs_calls(s: ast::AstStorage, root: Int): Int
  if root <= 0
    return 0
  end
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    if node <= 0
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    # node_constants$NODE_CALL = 9: check for UFCS flag
    if kind == 9
      if ast::ast_call_is_ufcs(s, node)
        return 1
      end
    end
    # Traverse children
    var children = ast::ast_get_children(s, node)
    if children > 0
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0
          queue.push(child)
        end
      end
    end
    # Traverse left and right subtrees
    var left = ast::ast_get_left(s, node)
    if left > 0
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0
      queue.push(right)
    end
  end
  return 0
end

## Check if an AST subtree calls any registered structural function.
## Used by PASS 0.96 for transitive structural constraint detection.
def mir_body_calls_structural(s: ast::AstStorage, root: Int, ctx: MirContext): Int
  if root <= 0
    return 0
  end
  var queue = vec_new()
  queue.push(root)
  while queue.size > 0
    var node = queue[queue.size - 1]
    queue.pop()
    if node <= 0
      continue
    end
    var kind = ast::ast_get_kind(s, node)
    # node_constants$NODE_CALL = 9: check if callee is a registered structural function
    if kind == 9
      var callee = ast::ast_get_left(s, node)
      if callee > 0
        var callee_kind = ast::ast_get_kind(s, callee)
        if callee_kind == 6
          var callee_name = ast::ast_get_str1(s, callee)
          if ctx.mir_lookup_bounded_generic(callee_name).is_some()
            return 1
          end
        end
      end
    end
    # Traverse children
    var children = ast::ast_get_children(s, node)
    if children > 0
      var ccount = vec_size(children)
      for ci in 0..ccount
        var child = children[ci]
        if child > 0
          queue.push(child)
        end
      end
    end
    # Traverse left and right subtrees
    var left = ast::ast_get_left(s, node)
    if left > 0
      queue.push(left)
    end
    var right = ast::ast_get_right(s, node)
    if right > 0
      queue.push(right)
    end
  end
  return 0
end

def mir_lower_program(ast_storage: ast::AstStorage, root: AstNodeId): Int
  var prog = mir_new_program()
  var ctx = mir_new_context(prog)
  
  var items = ast::ast_get_children(ast_storage, root)
  
  return prog if items == 0
  
  # PASS 1: Build enum registry from enum definitions
  # Store in context slots 13 and 14 (after the 13 existing slots 0-12)
  var enum_names = vec_new<String>()
  var enum_variants = vec_new()
  var enum_variant_field_types = vec_new()

  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)

    if kind == node_constants::NODE_ENUM_DEF
      # NodeEnumDef: extract name and variants
      var enum_name = ast::ast_get_str1(ast_storage, item)
      enum_names.push(enum_name)

      var variants_vec = ast::ast_get_children(ast_storage, item)
      var variant_names = vec_new<String>()
      var per_variant_types = vec_new()
      if variants_vec > 0
        for vi in 0..variants_vec.size
          var variant_node = variants_vec[vi]
          variant_names.push(ast::ast_get_str1(ast_storage, variant_node))
          var field_types = vec_new<String>()
          if ast::ast_get_kind(ast_storage, variant_node) == node_constants::NODE_VARIANT_DEF
            var fields = ast_storage.children[variant_node]
            if fields > 0
              var num_fields = vec_size(fields)
              for fi in 0..num_fields
                field_types.push(ast::ast_get_str2(ast_storage, fields[fi]))
              end
            end
          end
          per_variant_types.push(field_types)
        end
      end
      enum_variants.push(variant_names)
      enum_variant_field_types.push(per_variant_types)
    end
  end

  # Store enum registry in context for lookup during lowering
  ctx.enum_names = enum_names
  ctx.enum_variants = enum_variants
  ctx.enum_variant_field_types = enum_variant_field_types
  
  # PASS 1.5: Register Drop types from impl blocks
  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)
    
    if kind == node_constants::NODE_IMPL_BLOCK  # NodeImplBlock
      var trait_name = ast::ast_get_str1(ast_storage, item)
      var for_type = ast::ast_get_str2(ast_storage, item)
      if trait_name == "Drop"
        register_drop_type(ctx, for_type)
      end
    end
  end
  
  # PASS 1.7: Collect and evaluate const declarations, process static_assert
  var const_names_sp = mir_get_const_names(prog)
  var const_values_sp = mir_get_const_values(prog)

  # Scan for const functions (const def — int_val >= 2)
  var fn_names_sp = vec_new<String>()
  var fn_stores_sp = vec_new()
  var fn_nodes_sp = vec_new()
  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_FUNCTION  # NodeFunction
      if ast::ast_get_int_val(ast_storage, item) >= 2
        var fname = ast::ast_get_str1(ast_storage, item)
        fn_names_sp.push(fname)
        fn_stores_sp.push(as_int_generic(ast_storage))
        fn_nodes_sp.push(item)
      end
    end
  end

  # Evaluate const decls and static_asserts
  var local_names_sp = vec_new<String>()
  var local_values_sp = vec_new()
  var eval_state_sp = vec_new()
  eval_state_sp.push(0)
  eval_state_sp.push(0)
  eval_state_sp.push(0)
  eval_state_sp.push(0)
  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_CONST_DECL  # NodeConstDecl
      var name = ast::ast_get_str1(ast_storage, item)
      var init_node = ast::ast_get_right(ast_storage, item)
      eval_state_sp[0] = 0
      eval_state_sp[1] = 0
      eval_state_sp[2] = 0
      eval_state_sp[3] = as_int(name)
      var value = mir_const::mir_const_eval_full(ast_storage, init_node, const_names_sp, const_values_sp, local_names_sp, local_values_sp, fn_names_sp, fn_stores_sp, fn_nodes_sp, eval_state_sp)
      const_names_sp.push(name)
      const_values_sp.push(value)
    end
    if kind == node_constants::NODE_STATIC_ASSERT  # NodeStaticAssert
      var cond_node = ast::ast_get_left(ast_storage, item)
      eval_state_sp[0] = 0
      eval_state_sp[1] = 0
      eval_state_sp[2] = 0
      eval_state_sp[3] = 0
      var result = mir_const::mir_const_eval_full(ast_storage, cond_node, const_names_sp, const_values_sp, local_names_sp, local_values_sp, fn_names_sp, fn_stores_sp, fn_nodes_sp, eval_state_sp)
      if result == 0
        var msg = ast::ast_get_str2(ast_storage, item)
        puts("static_assert failed: ")
        puts(msg)
        puts("\n")
        exit(1)
      end
    end
  end
  
  # PASS 1.9: Register bounded generic functions (single-file path)
  var gbf_sp = ctx.mir_ctx_get_generic_bounded_funcs()
  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_FUNCTION
      var tp_sp = ast::ast_func_type_params(ast_storage, item)
      var bounds_sp = ast::ast_func_type_param_bounds(ast_storage, item)
      if str_byte_len(tp_sp) > 0 and str_byte_len(bounds_sp) > 0
        var name_sp = ast::ast_get_str1(ast_storage, item)
        var params_sp = ast::ast_get_left(ast_storage, item)
        var pc_sp = 0
        if params_sp >= 0
          pc_sp = vec_size(params_sp)
        end
        var mangled_sp = string_intern::mangle_int(name_sp, pc_sp)
        # iter_tag 0 (set later by PASS 0.9.1 if all bounds are Iterator-only).
        var gbf_entry_sp = mir::BoundedGenericFunc { base_name: name_sp, ast_store: ast_storage, func_handle: item, type_params: tp_sp, bounds: bounds_sp, mangled: mangled_sp, iter_tag: 0 }
        gbf_sp.push(gbf_entry_sp)
      end
    end
  end

  # PASS 2: Lower functions (skip bounded generics)
  for i in 0..items.size
    var item = items[i]
    var kind = ast::ast_get_kind(ast_storage, item)
    if kind == node_constants::NODE_FUNCTION  # NodeFunction
      # Skip bounded generic functions — only emitted as specializations
      var tp_sp2 = ast::ast_func_type_params(ast_storage, item)
      var bounds_sp2 = ast::ast_func_type_param_bounds(ast_storage, item)
      if str_byte_len(tp_sp2) == 0 or str_byte_len(bounds_sp2) == 0
        mir_lower_function(ctx, ast_storage, item)
      end
    end
  end

  # Copy struct registry to program for codegen access (use setter to avoid field_idx=0 bug)
  mir_set_struct_defs(prog, ctx.mir_ctx_get_struct_registry())

  return prog
end


# Lower a function with a pre-built name (already prefixed if needed)
def mir_lower_function_with_name(ctx: MirContext, s: ast::AstStorage, node: AstNodeId, name: String): Void
  # Phase 4D.5c.5: both sync `impl Iterator<T>` and async `impl AsyncIterator<T>`
  # generators dispatch to the same constructor lowering. Post-4D.5c.3 the two
  # ctor bodies are byte-identical (both call `__Future_<name>$new(...)` then
  # wrap in a 2-word Stream<T,e>). Async generators auto-register as async
  # targets via PASS 0.99b's `__qz_yield_marker__` suspend-propagation; the
  # explicit `mir_record_async_target` call inside `mir_lower_generator_effect`
  # is idempotent (deduplicates by name), so it's safe for both flavors.
  var ret_ann = ast::ast_get_str2(s, node)
  if str_byte_len(ret_ann) > 19
    if ret_ann.starts_with("impl AsyncIterator<")
      mir_lower_gen::mir_lower_generator_effect(ctx, s, node, name)
      return
    end
  end
  if str_byte_len(ret_ann) > 14
    if ret_ann.starts_with("impl Iterator<")
      mir_lower_gen::mir_lower_generator_effect(ctx, s, node, name)
      return
    end
  end

  # Reset per-function tracking to prevent cross-function pollution
  reset_droppables(ctx)
  reset_defers(ctx)
  reset_string_vars(ctx)
  reset_float_vars(ctx)
  reset_vec_elem_types(ctx)
  reset_map_key_types(ctx)
  reset_struct_types(ctx)
  ctx.mir_ctx_clear_iterator_bound_params()
  # Clear lazy async variable tracking (per-function scope)
  mir_lower_async_registry::mir_clear_lazy_async_vars()

  # Reset bindings to prevent cross-function pollution of variable names
  ctx.bindings = vec_new()

  var prog = ctx.mir_ctx_get_program()
  var func = mir_new_function(name, mir::MIR_TYPE_INT)
  # INC.1.2 — tag the producing module so qzmod_emit can filter
  # mir_prog.functions per .qzmod module artifact. See user-fn path in
  # `mir_lower_function` for why dep_graph keyed by ast_store is the
  # canonical lookup (ctx.module_name is "" for prefix-less helpers).
  mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(s))

  # Store original return type name for narrow type codegen
  var ret_type_name = ast::ast_get_str2(s, node)
  if str_byte_len(ret_type_name) > 0
    # R2 (C3) — a structural-record RETURN annotation (`{ x: Int, y: Int }`) must be
    # canonicalized to C1's registered sorted `__rec$...$rec_` @value struct name so
    # `mir_func_returns_byval_struct` (exact-match) recognizes it and returns it byval
    # (≤16B `{i64 x N}`) or via cow-buffer-ptr (>16B), instead of the fc=0 bare-i64
    # fallthrough that reads garbage on the caller's field access. Register first so
    # the @value struct is live in the registry before any read side. GATE-0-INERT:
    # gated on mir_is_record_annotation (non-intersection), which the compiler's own
    # return types never satisfy ⇒ byte-identical.
    if mir::mir_is_record_annotation(ret_type_name) and mir::mir_record_is_intersection(ret_type_name) == false
      mir::mir_register_record_struct(ctx, ret_type_name, s)
      ret_type_name = mir::mir_record_canonical_name(ret_type_name)
    end
    mir_func_set_return_type_name(func, ret_type_name)
  end

  # Propagate @naked attribute from AST
  if ast::ast_func_is_naked(s, node)
    mir_func_set_naked(func)
  end

  # Propagate @noinline attribute from AST
  if ast::ast_func_is_noinline(s, node)
    mir_func_set_noinline(func)
  end

  # Propagate @weak attribute from AST
  if ast::ast_func_is_weak(s, node)
    mir_func_set_weak(func)
  end

  # Propagate @panic_handler attribute from AST — register the raw
  # function name in the program so the panic-intrinsic emission path
  # can route calls to this handler. Name is sanitized at emit time.
  if ast::ast_func_is_panic_handler(s, node)
    mir::mir_set_panic_handler(ctx.program, name)
  end

  # Propagate @export attribute from AST — WASM backend reads this in
  # codegen_wasm to emit the function in the export section.
  if ast::ast_func_is_export(s, node)
    mir_func_set_export(func)
  end

  # Propagate @no_preempt attribute from AST (P21: skip fuel_check instrumentation)
  if ast::ast_func_is_no_preempt(s, node)
    mir_func_set_no_preempt(func)
  end

  # Propagate @ct attribute from AST (NET.4 Layer 3: ct_taint MIR pass)
  if ast::ast_func_is_ct(s, node)
    mir::mir_func_set_ct(func)
  end

  # Propagate C calling convention from AST (extern "C" def with body)
  if ast::ast_func_is_cconv_c(s, node)
    mir_func_set_cconv_c(func)
  end

  # Propagate x86-interrupt calling convention from AST
  if ast::ast_func_is_cconv_x86_intr(s, node)
    mir_func_set_cconv_x86_intr(func)
  end

  # Propagate preserve_all / preserve_most calling conventions from AST
  if ast::ast_func_is_cconv_preserve_all(s, node)
    mir_func_set_cconv_preserve_all(func)
  end
  if ast::ast_func_is_cconv_preserve_most(s, node)
    mir_func_set_cconv_preserve_most(func)
  end

  mir_get_functions(prog).push(func)
  ctx.mir_ctx_set_func(func)

  # item 20 P2 — borrowed mutating COW value-struct `self` receiver. Computed
  # BEFORE the param loop so the droppable registration (skips `self`) and the
  # field-assign make-unique gate (skips forking) can read ctx.borrowed_self_receiver.
  # Cleared at function exit below. Gate-0-inert (cow-layout false ⇒ stays 0).
  #
  # owner-Q#5 consolidation (WS4-a): compute `mutates_self` ONCE here and reuse it
  # for BOTH the borrowed-self gate and the cached-flag set (after the param loop),
  # OR'd with an explicit `&mut self` annotation. Byte-identical: same body node,
  # same verdict, same gate; no self-hosted method declares `&mut self` at gate 0.
  var mut_body_node = ast::ast_get_right(s, node)
  var mutates_self = 0
  if mut_body_node >= 0
    mutates_self = mir_body_assigns_self_field(s, mut_body_node)
  end
  var recv_params = ast::ast_get_left(s, node)
  if recv_params >= 0 and vec_size(recv_params) > 0
    if ast::ast_param_receiver_borrow(s, recv_params[0]) == 2
      mutates_self = 1
    end
  end
  mir::mir_ctx_set_borrowed_self_receiver(ctx, mir_receiver_is_borrowed_mut_self(ctx, s, node, mutates_self))

  # Check if this is an iterator-bounded function — if so, collect Iterator type param names
  var iter_type_params = vec_new<String>()
  var ibf_entry = mir_lookup_iterator_bounded(ctx, name)
  if ibf_entry.is_some()
    var ibf_bounds = ibf_entry.unwrap().bounds
    iter_type_params = mir_get_iterator_param_names(ibf_bounds)
  end

  var params = ast::ast_get_left(s, node)
  if params >= 0
    var param_count = vec_size(params)
    for i in 0..param_count
      var param = params[i]
      var param_name = ast::ast_get_str1(s, param)
      mir_func_add_param(func, param_name, mir::MIR_TYPE_INT)
      var slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(param_name, slot)

      var param_type = ast::ast_get_str2(s, param)
      # Resolve type param names (e.g., "T" → "Int") during specialization
      param_type = mir_resolve_type_param(ctx, param_type)

      # Check if this param's type is an Iterator-bounded type param
      var is_iter_param = 0
      var itp_count = iter_type_params.size
      for itp_i in 0..itp_count
        if iter_type_params[itp_i].eq(param_type)
          is_iter_param = 1
        end
      end

      if is_iter_param == 1
        # Iterator-bounded param: treated as closure Fn(): Option<Int>
        # Do NOT mark as struct — it's a closure pointer, not a struct
        var ibparams = ctx.mir_ctx_get_iterator_bound_params()
        ibparams.push(param_name)
      else
        # Mark param as string if type annotation is exactly String
        # NOTE: Do NOT use substring match — Vec<String> vars are NOT strings
        if param_type == "String"
          ctx.mir_ctx_mark_string_var(param_name)
        end
        if param_type == "F64" or param_type == "F32"
          ctx.mir_ctx_mark_float_var(param_name)
        end
        # Track Map<K,V> parameters so for-in dispatches the correct key path.
        if param_type.starts_with("Map<")
          var pm2_lt = __char_index(param_type, '<')
          if pm2_lt > 0
            var pm2_inner = str_byte_slice(param_type, pm2_lt + 1, str_byte_len(param_type))
            var pm2_comma = __char_index(pm2_inner, ',')
            if pm2_comma > 0
              var pm2_key = str_byte_slice(pm2_inner, 0, pm2_comma)
              while str_byte_len(pm2_key) > 0 and str_byte_at(pm2_key, str_byte_len(pm2_key) - 1) == ' '
                pm2_key = str_byte_slice(pm2_key, 0, str_byte_len(pm2_key) - 1)
              end
              if str_byte_len(pm2_key) > 0
                ctx.mir_ctx_mark_map_key_type(param_name, pm2_key)
              end
            end
          end
          # Track the VALUE type (V) for the `m.set(k, None)` niche threading.
          var pm2_val = mir::mir_extract_map_value_type(param_type)
          if str_byte_len(pm2_val) > 0
            ctx.mir_ctx_mark_map_value_type(param_name, pm2_val)
          end
        end
        # item 52 — register a `Vec<S>` PARAM's element type in the vec-elem
        # registry so an explicit `vec_push(v, c)` on the param recovers the
        # element type (the UFCS str2 annotation is only stamped for `v.push(c)`;
        # the fallback in mir_lower_expr_handlers looks up the receiver var name
        # in THIS registry, which previously only carried let-binding elems, never
        # params). Without it, `_elem_type` is empty → codegen takes the runtime-ew
        # store path and stores the V2d value-COPY's box POINTER as the inline i64
        # element, while vec_get reads the slot as an inline value-layout struct →
        # garbage. GATE-0-INERT: gated on mir_is_value_layout_type(elem)==1, which
        # is 0 for every compiler struct at flip==0 ⇒ registry unchanged ⇒ every
        # `_elem_type`-consuming push/get on a Vec param stays empty ⇒ byte-identical.
        if str_byte_len(param_type) > 0 and param_type.starts_with("Vec<")
          var pv_elem = mir::mir_extract_generic_element_type(param_type)
          # R2 (C3) — canonicalize a raw record `Vec<{ x: Int }>` element (register
          # first). GATE-0-INERT: gated on mir_is_record_annotation ⇒ byte-identical.
          if str_byte_len(pv_elem) > 0 and mir::mir_is_record_annotation(pv_elem) and mir::mir_record_is_intersection(pv_elem) == false
            mir::mir_register_record_struct(ctx, pv_elem, s)
            pv_elem = mir::mir_record_canonical_name(pv_elem)
          end
          if str_byte_len(pv_elem) > 0 and mir::mir_is_value_layout_type(ctx, pv_elem) == 1
            ctx.mir_ctx_mark_vec_elem_type(param_name, pv_elem)
          end
        end
        # Store original param type name for narrow type codegen
        if str_byte_len(param_type) > 0
          mir_func_set_param_type_name(func, i, param_type)
        end
        # Mark param as struct-typed for field access resolution
        # Skip union annotations — they are compile-time-only, not nominal structs
        if str_byte_len(param_type) > 0
          if param_type != "Int"
            if param_type != "Bool"
              if param_type != "String"
                if param_type != "Void"
                  if not mir_is_union_annotation(param_type)
                    # R2 (C1) — structural record param `r: { x: Int, y: Int }`.
                    # Instead of the old monomorphize-per-callsite fake, mint a
                    # sorted-canonical synthetic struct name, register it as a
                    # @value flat-layout entry (idempotent), and mark the param
                    # with that name so field reads resolve through the ordinary
                    # nominal path (mir_ctx_find_field_index → flat offset load).
                    # GATE-0-INERT: gated on mir_is_record_annotation, which the
                    # compiler's own sources never satisfy in param position that
                    # reaches a first-class record value (they take PASS 0.97).
                    if mir::mir_is_record_annotation(param_type) and mir::mir_record_is_intersection(param_type) == false
                      mir::mir_register_record_struct(ctx, param_type, s)
                      ctx.mir_ctx_mark_struct_var(param_name, mir::mir_record_canonical_name(param_type))
                    elsif str_byte_at(param_type, 0) != '{'
                      ctx.mir_ctx_mark_struct_var(param_name, param_type)
                    end
                  end
                end
              end
            end
          end
        end
        # Track droppable parameters — skip self in Drop impls to prevent infinite recursion
        # item 20 P2 — also skip param 0 when it is a BORROWED mutating COW value-struct
        # `self` receiver: the caller passed its live buffer WITHOUT a retain (call-site
        # copy elision), so registering `self` droppable would emit a scope-exit
        # cow_release that double-frees the caller's still-owned buffer. Retain-skip and
        # release-skip move together. Gate-0-inert (the flag is 0 for non-cow receivers).
        # items 9h+9i — also skip a borrowed NON-self by-value COW @value param
        # (provably non-escaping read-only cow arg): caller passes its buffer WITHOUT
        # a retain (V2b retain skipped symmetrically), so a scope-exit cow_release here
        # would double-free the still-owned buffer. Gate-0-inert (cow-layout false).
        if str_byte_len(param_type) > 0
          if type_needs_drop(ctx, param_type)
            if not str_ends_with(name, "$drop")
              if not (i == 0 and mir::mir_ctx_get_borrowed_self_receiver(ctx) == 1)
                if mir_cow_value_param_is_borrowed(ctx, s, node, i) == 0
                  push_droppable(ctx, param_name, param_type)
                end
              end
            end
          end
        end
        # Structural method constraints: during specialization of a function with
        # generic or untyped params, mark them with their per-param concrete type.
        # This enables mir_infer_expr_type to resolve cascading structural calls.
        # Check spec_param_types FIRST (for bounded generics like T: Trait),
        # then fall back to spec_current_type.
        var sct = ctx.mir_ctx_lookup_spec_param_type(param_name)
        if str_byte_len(sct) > 0
          ctx.mir_ctx_mark_struct_var(param_name, sct)
        elsif str_byte_len(param_type) == 0
          sct = ctx.mir_ctx_get_spec_current_type()
          if str_byte_len(sct) > 0
            ctx.mir_ctx_mark_struct_var(param_name, sct)
          end
        end
      end
    end
  end

  var entry = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(entry)

  # P21 / R3.2: ONE fuel_check at function entry — see the matching comment in
  # mir_lower_function. This is the second function-lowering path (non-void /
  # named / generic-spec bodies, including recursive `fib`), so it MUST emit the
  # entry check too; without it, a recursive function lowered through this path
  # would lose its only per-activation preemption point now that the per-call
  # direct check is gone.
  mir_emit_fuel_check(ctx)

  var body_node = ast::ast_get_right(s, node)
  # item 20 P1 — cache whether the body directly stores to `self.<field>` (OR was
  # declared `&mut self`) so the codegen-time decompose predicates (which see only
  # MirFunc, no AST) can keep a mutated value-struct `self` receiver out of register-
  # decompose. This is the METHOD-lowering twin of the same block in
  # `mir_lower_function`: extend / `impl` methods (and all $-prefixed receivers) lower
  # through THIS function, NOT the free-function path. `mutates_self` was computed
  # ONCE at function entry (Q#5 consolidation) from the SAME body node, then OR'd with
  # the explicit `&mut self` annotation. Gate-0-inert: the marker is dead unless param
  # 0 is a value-layout struct, which the consumer's value-layout gate short-circuits.
  if mutates_self != 0
    mir::mir_func_set_mutates_self_field(func, 1)
  end
  # item 38 — mark a phantom (associated-fn) `self` param 0 so codegen excludes it
  # from value-decompose. Gate-0-inert.
  mir_mark_assoc_phantom_self(func, s, body_node)
  var has_return_type = false
  if str_byte_len(ret_type_name) > 0
    if ret_type_name != "Void"
      if ret_type_name != "!"
        has_return_type = true
      end
    end
  end

  var last_value = -1
  if body_node >= 0
    var body_kind = ast::ast_get_kind(s, body_node)
    if body_kind == node_constants::NODE_BLOCK and has_return_type
      # Non-void function with block body: special handling for last statement
      # Push a defer scope so defer statements in this block work correctly
      defer_scope_push(ctx)
      var stmts = ast::ast_get_children(s, body_node)
      if stmts != 0 and stmts.size > 0
        # B.10 §14 N3 6.3d — pre-scan this function body (the return-typed block
        # body has its own inlined statement loop, distinct from the NODE_BLOCK
        # handler) for bare-`None` un-annotated locals; recover Option<P> from a
        # later Some(P) reassignment so the niche construction agrees with the
        # field/var-typed read. Niche-gated ⇒ byte-identical IR flag-OFF.
        mir::mir_niche_prescan_bare_none_lets(ctx, s, stmts, body_node)
        var stmt_count = stmts.size
        # Lower all statements except the last
        for si in 0..(stmt_count - 1)
          ctx.mir_lower_stmt(s, stmts[si])
          var cur = ctx.mir_ctx_get_block()
          if mir_block_get_term_kind(cur) >= 0
            # Block already terminated (break/return), stop
            # emit_deferred was already called by the return handler
            defer_scope_discard(ctx)
            stmt_count = 0
          end
        end
        # Handle last statement with expression semantics if applicable
        if stmt_count > 0
          var cur2 = ctx.mir_ctx_get_block()
          if mir_block_get_term_kind(cur2) < 0
            var last_stmt = stmts[stmt_count - 1]
            var last_kind = ast::ast_get_kind(s, last_stmt)
            var use_expr = false
            if last_kind == node_constants::NODE_MATCH
              use_expr = true
            end
            if last_kind == node_constants::NODE_IF
              if mir_lower_gen::mir_block_contains_return(s, last_stmt) == false
                use_expr = true
              end
            end
            if use_expr
              last_value = ctx.mir_lower_expr(s, last_stmt)
              # Emit deferred expressions before implicit return
              defer_scope_pop(ctx)
            else
              ctx.mir_lower_stmt(s, last_stmt)
              # If last stmt didn't terminate, emit defers
              var cur3 = ctx.mir_ctx_get_block()
              if mir_block_get_term_kind(cur3) < 0
                defer_scope_pop(ctx)
              else
                defer_scope_discard(ctx)
              end
            end
          end
        end
      else
        # Empty block body — just discard the defer scope
        defer_scope_discard(ctx)
      end
    else
      ctx.mir_lower_stmt(s, body_node)
    end
  end

  var block = ctx.mir_ctx_get_block()
  if mir_block_get_term_kind(block) < 0
    # Emit drops before implicit return
    emit_drops_for_scope(ctx, 0)
    if has_return_type and last_value >= 0
      # Return the value of the last expression
      mir_block_set_terminator(block, mir::TERM_RETURN, last_value)
    else
      # Implicit void return - use -1 as sentinel
      mir_block_set_terminator(block, mir::TERM_RETURN, -1)
    end
  end
  # item 20 P2 — clear the borrowed-self-receiver flag at method-body exit so it
  # never leaks into the next function's lowering. Gate-0-inert (was already 0).
  mir::mir_ctx_set_borrowed_self_receiver(ctx, 0)
end

# Extract module name from prefixed name (e.g., "mir$func" -> "mir")
def mir_extract_module_name(prefixed_name: String): String
  var len = str_byte_len(prefixed_name)
  for i in 0..len
    return str_byte_slice(prefixed_name, 0, i) if str_byte_at(prefixed_name, i) == '$'  # '$'
  end
  return ""  # No module prefix found
end

# Entry point for multi-module compilation
# all_funcs: vec of ResolverEntry entries
## INC.1.3 — incremental MIR lowering entry. `qzmod_hits` carries the per-
## module `QzmodLoadResult` set collected during resolution; `hit_ast_stores`
## is the parallel set of consumer ast_stores already registered via
## `tc_inject_qzmod`. PASS 1 skips body lowering for user functions whose
## ast_store lives in `hit_ast_stores`; a new pre-PASS-1 step unpickles the
## producer's MIR bodies from each hit and merges them onto
## `mir_prog.functions`. `mir_lower_all` (below) is a thin wrapper that
## passes empty vecs for callers that don't have a hit set (bootstrap.qz
## recovery path).
def mir_lower_all_incremental(all_funcs: Vec<ResolverEntry>, hit_ast_stores: Vec<Int>, qzmod_hits: Vec<QzmodLoadResult>): MirProgram
  return _mir_lower_all_inner(all_funcs, hit_ast_stores, qzmod_hits)
end

def mir_lower_all(all_funcs: Vec<ResolverEntry>): MirProgram
  return _mir_lower_all_inner(all_funcs, vec_new<Int>(), vec_new<QzmodLoadResult>())
end

## Extract the lambda-counter value N from a cached synthetic function
## name, or -1 if the name carries none. `__lambda_<N>` / `__go_lambda_<N>`
## bodies and the `__Future_`-wrapped synthetics `__Future___lambda_<N>$*`
## / `__Future___go_lambda_<N>$*` all embed the substring `lambda_`
## immediately before <N>; cached `.qzmod` MIR ships the `__Future_`-wrapped
## forms. A scan that only matched the bare `__lambda_` prefix under-counted
## and let a freshly-numbered go-lambda collide with a cached one (A.23).
def _mir_cached_lambda_num(name: String): Int
  var is_lambda = str_starts_with(name, "__lambda_")
  var is_go = str_starts_with(name, "__go_lambda_")
  var is_future = str_starts_with(name, "__Future_")
  if is_lambda == false and is_go == false and is_future == false
    return -1
  end
  var li = __str_index(name, "lambda_")
  if li < 0
    return -1
  end
  return str_to_int(str_byte_slice(name, li + 7, str_byte_len(name)))
end

## Internal entry — `mir_lower_all` and `mir_lower_all_incremental` both
## dispatch here. Empty hit vecs are equivalent to the pre-INC.1.3 behavior.
def _mir_lower_all_inner(all_funcs: Vec<ResolverEntry>, hit_ast_stores: Vec<Int>, qzmod_hits: Vec<QzmodLoadResult>): MirProgram
  var prog = mir_new_program()
  var ctx = mir_new_context(prog)

  # Initialize async infrastructure (globals start fresh from module-level init)
  mir_lower_async_registry::mir_init_suspendable_leaves()

  # Store all_funcs in context for function name resolution
  ctx.mir_ctx_set_all_funcs(all_funcs)

  # PASS 0: Build enum registry from all AST stores
  var enum_names = vec_new<String>()
  var enum_variants = vec_new()
  var enum_variant_field_types = vec_new()
  var enum_has_payloads = vec_new()
  var processed_stores = vec_new()

  var count = all_funcs.size
  for i in 0..count
    var entry = all_funcs[i]
    var ast_store = entry.ast_store
    var prefixed_name = entry.name

    # Skip if we've already processed this AST store
    var already_processed = any?(processed_stores, s: Int -> s == ast_store)

    if already_processed == 0
      processed_stores.push(ast_store)

      # Extract module prefix from prefixed_name (e.g., "mod_colors$get_red" -> "mod_colors")
      # For main module functions without prefix, this will be empty string
      var module_prefix = ""
      var dollar_pos = __char_index(prefixed_name, '$')
      if dollar_pos >= 0
        module_prefix = str_byte_slice(prefixed_name, 0, dollar_pos)
      end

      # Scan this AST storage for enum definitions with the module prefix
      mir_collect_enums(ast_store, enum_names, enum_variants, enum_variant_field_types, enum_has_payloads, module_prefix)
    end
  end

  # Store enum registry in context struct fields
  ctx.enum_names = enum_names
  ctx.enum_variants = enum_variants
  ctx.enum_variant_field_types = enum_variant_field_types
  ctx.enum_has_payloads = enum_has_payloads
  
  # PASS 0.5: Collect struct definitions and register in context slot 14
  processed_stores = vec_new()
  for i in 0..count
    var entry = all_funcs[i]
    var ast_store = entry.ast_store

    var already_processed = any?(processed_stores, s: Int -> s == ast_store)

    if already_processed == 0
      processed_stores.push(ast_store)
      mir_collect_structs(ctx, ast_store)
    end
  end

  # PASS 0.55 (Binary DSL, sub-phase 1.3): collect NODE_BINARY_BLOCK and
  # NODE_PACKED_STRUCT layouts into the MIR program's layout registry.
  # The registry is consumed by MIR_BINARY_PACK / MIR_BINARY_UNPACK /
  # MIR_PACKED_BITCAST codegen (stubbed in cg_intrinsic_binary.qz).
  processed_stores = vec_new()
  for i in 0..count
    var entry = all_funcs[i]
    var ast_store = entry.ast_store
    var already_processed = any?(processed_stores, s: Int -> s == ast_store)
    if already_processed == 0
      processed_stores.push(ast_store)
      mir_collect_binary_layouts(ctx, ast_store)
    end
  end

  # PASS 0.55: Register Drop types from impl blocks in all_funcs
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 9  # impl block entry
      var ast_store = entry.ast_store
      var node = entry.node_id
      var trait_name = ast::ast_get_str1(ast_store, node)
      var for_type = ast::ast_get_str2(ast_store, node)
      if trait_name == "Drop"
        register_drop_type(ctx, for_type)
      end
    end
  end

  # PASS 0.6: Collect global variables (tag == 1)
  var global_names = vec_new<String>()  # Names of global variables
  var global_inits = vec_new()  # Initial values (0 for non-literal inits)
  var global_str_inits = vec_new<String>()  # String init values ("" if not string)
  var global_tl_flags = vec_new()  # Thread-local flags (0 or 1)
  var global_ast_stores = vec_new()  # AST stores for complex init lowering
  var global_init_nodes = vec_new()  # Init expression nodes for complex inits
  var global_types = vec_new<String>()  # Type annotations from NODE_LET str2

  # Track AST → primary-name so duplicate entries for the same global
  # (from the wildcard-vs-qualified resolver dedup gate — see
  # resolve_recollect_funcs_only in self-hosted/resolver.qz) get
  # segregated: ONE primary, N aliases. mir_prog_add_global_alias
  # records each alias and codegen emits LLVM `alias` directives so
  # both names share storage.
  var _alias_primary_stores = vec_new<Int>()
  var _alias_primary_nodes = vec_new<Int>()
  var _alias_primary_names = vec_new<String>()
  # Parallel accumulator for alias names + their primary's type. These
  # get added to the ctx.global_registry name list AFTER the primary
  # loop completes, so `mir_ctx_is_global` and
  # `mir_ctx_lookup_global_type` accept alias references — but they're
  # NOT pushed to mir_prog's global_names (which drives storage
  # emission) so codegen only emits one storage + N LLVM aliases.
  var _alias_extra_names = vec_new<String>()
  var _alias_extra_types = vec_new<String>()

  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 1
      var ast_store = entry.ast_store
      var node = entry.node_id
      var name = entry.name
      # Detect a duplicate entry pointing to the same AST node — register
      # as an alias of the prior primary instead of a fresh global.
      var existing_primary = ""
      for _pi in 0.._alias_primary_stores.size
        if _alias_primary_stores[_pi] == ast_store and _alias_primary_nodes[_pi] == node
          existing_primary = _alias_primary_names[_pi]
          break
        end
      end
      if str_byte_len(existing_primary) > 0
        # Skip storage emission; record alias mapping for codegen.
        mir_prog_add_global_alias(prog, name, existing_primary)
        # And surface the alias name to the ctx registry so MIR-level
        # `mir_ctx_is_global` / `mir_ctx_lookup_global_type` queries on
        # the qualified consumer's side return the right answers.
        _alias_extra_names.push(name)
        _alias_extra_types.push(_resolve_global_type(ast_store, node, ast::ast_get_right(ast_store, node)))
      else
        var init_node = ast::ast_get_right(ast_store, node)

        # Check if init is a simple integer or string literal
        var init_val = 0
        var str_init_val = ""
        if init_node >= 0
          var init_kind = ast::ast_get_kind(ast_store, init_node)
          if init_kind == node_constants::NODE_INT_LIT  # NodeIntLit
            init_val = ast::ast_get_int_val(ast_store, init_node)
          end
          if init_kind == node_constants::NODE_STRING_LIT  # NodeStringLit
            str_init_val = ast::ast_get_str1(ast_store, init_node)
          end
        end

        global_names.push(name)
        global_inits.push(init_val)
        global_str_inits.push(str_init_val)
        global_tl_flags.push(ast::ast_get_op(ast_store, node))
        global_ast_stores.push(ast_store)
        global_init_nodes.push(init_node)
        # Capture the type annotation from the NODE_LET (str2 carries the
        # source-level `: Vec<...>` annotation) — available even when TC
        # body-walk was skipped for the owning module under an incremental
        # cache hit. Falls back to inference over the init expression when
        # the user omitted the annotation (`_state = vec_new<Int>()` vs
        # `_state: Vec<Int> = ...`). Required for the UFCS rewrite fallback
        # in mir_lower_call to identify receiver types.
        global_types.push(_resolve_global_type(ast_store, node, init_node))

        _alias_primary_stores.push(as_int_generic(ast_store))
        _alias_primary_nodes.push(as_int_generic(node))
        _alias_primary_names.push(name)
      end
    end
  end

  # Store global registry in context struct field. Slot[2] holds type
  # annotations in the same order as slot[0] names;
  # mir_ctx_lookup_global_type indexes by name.
  #
  # IMPORTANT: extending the LOCAL `global_names` with alias names here
  # would corrupt the parallel-vec indexing used by PASS 1.5 (complex
  # global init lowering) because PASS 0.8 (`const_decl` → global)
  # appends const entries to BOTH `global_names` AND
  # `global_init_nodes`. PASS 1.5 then indexes `global_names[gi]` with
  # a `gi` drawn from `global_init_nodes.size`, expecting primaries
  # first then const entries. Inserting aliases here would shift the
  # const entries out of step. Defer alias extension until after PASS
  # 0.8 completes.
  var global_registry = [global_names, global_inits, global_types]
  ctx.global_registry = global_registry

  # Note: line, drop_types, droppable_stack, scope_depth, loop_scope_depth,
  # and defer_stack are already initialized in mir$mir_new_context()

  # Register globals in the program structure (primaries only — aliases
  # never get their own storage; codegen emits LLVM `alias` from the
  # mir_prog_get_global_alias_* lists, sharing the primary's storage).
  var global_count = global_names.size
  mir_prog_set_globals(prog, global_names, global_inits, global_str_inits, global_tl_flags)
  
  # PASS 0.7: Collect and evaluate const declarations
  var const_names_prog = mir_get_const_names(prog)
  var const_values_prog = mir_get_const_values(prog)
  var const_ast_stores = vec_new()
  var const_init_nodes = vec_new()

  # Scan for const functions (tag==0 with int_val >= 2)
  var fn_names_mp = vec_new<String>()
  var fn_stores_mp = vec_new()
  var fn_nodes_mp = vec_new()
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0  # Function entry
      var ast_store = entry.ast_store
      var func_node = entry.node_id
      if ast::ast_get_int_val(ast_store, func_node) >= 2
        var fname = ast::ast_get_str1(ast_store, func_node)
        fn_names_mp.push(fname)
        fn_stores_mp.push(ast_store)
        fn_nodes_mp.push(func_node)
      end
    end
  end

  # Evaluate const decls and static_asserts
  var local_names_mp = vec_new<String>()
  var local_values_mp = vec_new()
  var eval_state_mp = vec_new()
  eval_state_mp.push(0)
  eval_state_mp.push(0)
  eval_state_mp.push(0)
  eval_state_mp.push(0)
  for i in 0..count
    var entry = all_funcs[i]
    var entry_type = entry.tag
    if entry_type == 2
      var ast_store = entry.ast_store
      var node = entry.node_id
      var name = entry.name
      var init_node = ast::ast_get_right(ast_store, node)
      eval_state_mp[0] = 0
      eval_state_mp[1] = 0
      eval_state_mp[2] = 0
      eval_state_mp[3] = as_int(name)
      var value = mir_const::mir_const_eval_full(ast_store, init_node, const_names_prog, const_values_prog, local_names_mp, local_values_mp, fn_names_mp, fn_stores_mp, fn_nodes_mp, eval_state_mp)
      const_names_prog.push(name)
      const_values_prog.push(value)
      const_ast_stores.push(ast_store)
      const_init_nodes.push(init_node)
    end
    if entry_type == 3
      var ast_store = entry.ast_store
      var node = entry.node_id
      var cond_node = ast::ast_get_left(ast_store, node)
      eval_state_mp[0] = 0
      eval_state_mp[1] = 0
      eval_state_mp[2] = 0
      eval_state_mp[3] = 0
      var result = mir_const::mir_const_eval_full(ast_store, cond_node, const_names_prog, const_values_prog, local_names_mp, local_values_mp, fn_names_mp, fn_stores_mp, fn_nodes_mp, eval_state_mp)
      if result == 0
        var msg = ast::ast_get_str2(ast_store, node)
        puts("static_assert failed: ")
        puts(msg)
        puts("\n")
        exit(1)
      end
    end
  end

  # PASS 0.8: Add const declarations as globals (matching C bootstrap behavior)
  # Const decls are emitted as immutable LLVM globals with their evaluated value.
  # For string literal consts, extract the string value into gstr_inits so codegen
  # emits a store in __qz_module_init. For non-evaluable consts (value==0, not a
  # string literal), add to global_init_nodes for runtime expression lowering.
  var prog_gnames = mir_get_global_names(prog)
  var prog_ginits = mir_get_global_inits(prog)
  var prog_gstr_inits = mir_get_global_str_inits(prog)
  var prog_gtls = mir_get_global_thread_locals(prog)
  # Const ctx-registration entries (string-literal + compile-time-evaluable
  # consts) that have NO global_init_nodes entry. Collected here, appended to
  # global_names AFTER the loop — same discipline as PASS 0.8b aliases. They
  # MUST NOT be pushed mid-loop: PASS 1.5 (complex init lowering) pairs
  # global_names[primary_count + k] with global_init_nodes[k] 1:1, so an
  # init-node-less push interleaved before a later runtime-init (e.g. float)
  # const would shift that index and store the float's init expr into the wrong
  # global (observed: a string const before a float const left the float at 0).
  var _const_ctx_names = vec_new<String>()
  var _const_ctx_inits = vec_new()
  for i in 0..const_names_prog.size
    var cval = const_values_prog[i]
    var str_init = ""
    var cinit_node = const_init_nodes[i]
    var cast_store = const_ast_stores[i]

    if cval == 0 and cinit_node >= 0
      var cinit_kind = ast::ast_get_kind(cast_store, cinit_node)
      if cinit_kind == node_constants::NODE_STRING_LIT
        # String literal const: extract value for codegen str_inits pathway
        str_init = ast::ast_get_str1(cast_store, cinit_node)
      else
        # Non-evaluable, non-string const (e.g. a float literal or runtime
        # expression): add to PASS 0.6 parallel vectors so __qz_module_init can
        # lower the expression at runtime. This push DOES have a matching
        # global_init_nodes entry, so it stays 1:1 and must remain in-loop.
        global_names.push(const_names_prog[i])
        global_inits.push(0)
        global_str_inits.push("")
        global_tl_flags.push(0)
        global_ast_stores.push(cast_store)
        global_init_nodes.push(cinit_node)
        global_types.push("")  # consts have no NODE_LET str2 annotation
      end
    end

    prog_gnames.push(const_names_prog[i])
    prog_ginits.push(cval)
    prog_gstr_inits.push(str_init)
    prog_gtls.push(0)
    # Register in context so mir_ctx_is_global recognizes const globals (only
    # for consts NOT already added to global_names by the else branch above).
    # Deferred to after the loop — see _const_ctx_names note above.
    if cval != 0 or cinit_node < 0 or ast::ast_get_kind(cast_store, cinit_node) == node_constants::NODE_STRING_LIT
      _const_ctx_names.push(const_names_prog[i])
      _const_ctx_inits.push(cval)
    end
  end

  # Append the deferred const ctx-registration entries AFTER all runtime-init
  # const entries (preserves the global_names <-> global_init_nodes pairing).
  for _ci in 0.._const_ctx_names.size
    global_names.push(_const_ctx_names[_ci])
    global_inits.push(_const_ctx_inits[_ci])
    global_types.push("")
  end

  # PASS 0.8b: Extend the ctx-side global_names with global-var alias
  # entries (recorded during PASS 0.6's tag==1 duplicate detection).
  # Must run AFTER PASS 0.8 — PASS 1.5 (complex init lowering) indexes
  # global_names[gi] with gi drawn from global_init_nodes.size, which
  # is primary_count + const_complex_count. Aliases appended after both
  # of those don't trip the indexing, but they DO become visible to
  # `mir_ctx_is_global` and `mir_ctx_lookup_global_type` — which is the
  # whole point (qualified-consumer references via `m::X` mangle to
  # `m$X`, and we need that name to resolve as a global).
  for _ax in 0.._alias_extra_names.size
    global_names.push(_alias_extra_names[_ax])
    global_inits.push(0)
    global_types.push(_alias_extra_types[_ax])
  end

  # PASS 0.9: Register bounded generic functions for monomorphization
  # Bounded generics (e.g., def are_equal<T: Eq>(a: T, b: T)) are NOT lowered
  # directly — instead they are registered here and specializations are emitted
  # on demand when call sites are encountered.
  # Bounded generics ALWAYS need specialization — the type param bounds require
  # dispatch through concrete impl (Type$method). Both UFCS (a.eq(b)) and bare
  # call (eq(a, b)) patterns need the concrete type resolved at call sites.
  var gbf = ctx.mir_ctx_get_generic_bounded_funcs()
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      var ast_store = entry.ast_store
      var func_handle = entry.node_id
      var tp = ast::ast_func_type_params(ast_store, func_handle)
      var bounds = ast::ast_func_type_param_bounds(ast_store, func_handle)
      if str_byte_len(tp) > 0 and str_byte_len(bounds) > 0
        var name = entry.name
        var params = ast::ast_get_left(ast_store, func_handle)
        var pc = 0
        if params >= 0
          pc = vec_size(params)
        end
        var mangled = string_intern::mangle_int(name, pc)
        # iter_tag 0 (set later by PASS 0.9.1 if all bounds are Iterator-only).
        var gbf_entry = mir::BoundedGenericFunc { base_name: name, ast_store: ast_store, func_handle: func_handle, type_params: tp, bounds: bounds, mangled: mangled, iter_tag: 0 }
        gbf.push(gbf_entry)
      end
    end
  end

  # PASS 0.9.1: Tag iterator-bounded functions for closure dispatch.
  # Functions where ALL bounds are Iterator-only get tagged (entry[6]=1) and
  # will be lowered normally in PASS 1 (not skipped), with their Iterator params
  # transformed to closure params.
  var gbf_count_091 = gbf.size
  for i in 0..gbf_count_091
    var entry = gbf[i]
    var bounds_091 = entry.bounds
    if str_byte_len(bounds_091) > 0
      if mir_has_only_iterator_bounds(bounds_091)
        # Tag as iterator-bounded. `gbf[i]` returns the stored struct handle
        # (reference semantics — vec_get loads the handle for non-@value structs,
        # commit 5361b984), so the field write goes through the shared backing
        # element, not a copy. (Was the `entry[6] = 1` positional-slot write.)
        entry.iter_tag = 1
      end
    end
  end

  # PASS 0.95 helper: scan AST subtree for UFCS method calls (iterative).
  # Returns 1 if the subtree contains any node_constants$NODE_CALL with is_ufcs flag set.

  # PASS 0.95: Register structurally-constrained functions for monomorphization
  # Functions with untyped parameters (no type annotation on at least one param)
  # whose body contains UFCS method calls (dot-syntax: thing.method()) are treated
  # like bounded generics. They are skipped in PASS 1 and specialized on demand
  # at call sites, using the concrete argument type to resolve method calls.
  # NOTE: We ONLY register functions that actually call methods on untyped params
  # (detected via UFCS flag). Functions with untyped params that just do arithmetic
  # (e.g., def add(a, b) = a + b) are NOT registered — they work via type inference.
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      var ast_store = entry.ast_store
      var func_handle = entry.node_id
      var name = entry.name
      # Skip main, already-registered bounded generics, and impl/extend methods
      if name != "main" and not str_contains(name, "$")
        var tp = ast::ast_func_type_params(ast_store, func_handle)
        var bounds = ast::ast_func_type_param_bounds(ast_store, func_handle)
        var is_already_bounded = str_byte_len(tp) > 0 and str_byte_len(bounds) > 0
        if is_already_bounded == false
          var params = ast::ast_get_left(ast_store, func_handle)
          var pc = 0
          var has_untyped = 0
          if params >= 0
            pc = vec_size(params)
            for pi in 0..pc
              var param = params[pi]
              var param_type = ast::ast_get_str2(ast_store, param)
              if str_byte_len(param_type) == 0
                has_untyped = 1
              end
            end
          end
          if has_untyped == 1 and pc > 0
            # Scan function body for UFCS method calls
            var body = ast::ast_get_right(ast_store, func_handle)
            var has_ufcs = mir_body_has_ufcs_calls(ast_store, body)
            if has_ufcs == 1
              # Register same as bounded generics — reuses the specialization queue
              var mangled = string_intern::mangle_int(name, pc)
              # iter_tag 0 — structural funcs are never iterator-bounded.
              var gbf_entry = mir::BoundedGenericFunc { base_name: name, ast_store: ast_store, func_handle: func_handle, type_params: "", bounds: "", mangled: mangled, iter_tag: 0 }
              gbf.push(gbf_entry)
            end
          end
        end
      end
    end
  end

  # PASS 0.96: Transitive structural constraint detection (fixpoint).
  # If a function has untyped params and calls any registered structural function,
  # it also needs monomorphization to propagate the concrete type. This handles
  # chained calls like: def outer(t) = inner(t) + 1 where inner is structural.
  # Run in a fixpoint loop since transitivity can be multi-level.
  var changed = 1
  while changed == 1
    changed = 0
    for i in 0..count
      var entry = all_funcs[i]
      if entry.tag == 0
        var ast_store = entry.ast_store
        var func_handle = entry.node_id
        var name = entry.name
        # Skip already-registered, main, and impl/extend methods
        if name != "main" and not str_contains(name, "$") and ctx.mir_lookup_bounded_generic(name).is_none()
          var tp = ast::ast_func_type_params(ast_store, func_handle)
          var bounds = ast::ast_func_type_param_bounds(ast_store, func_handle)
          var is_already_bounded = str_byte_len(tp) > 0 and str_byte_len(bounds) > 0
          if is_already_bounded == false
            var params = ast::ast_get_left(ast_store, func_handle)
            var pc = 0
            var has_untyped = 0
            if params >= 0
              pc = vec_size(params)
              for pi in 0..pc
                var param = params[pi]
                var param_type = ast::ast_get_str2(ast_store, param)
                if str_byte_len(param_type) == 0
                  has_untyped = 1
                end
              end
            end
            if has_untyped == 1 and pc > 0
              # Check if body calls any registered structural function
              var body = ast::ast_get_right(ast_store, func_handle)
              var calls_structural = mir_body_calls_structural(ast_store, body, ctx)
              if calls_structural == 1
                var mangled = string_intern::mangle_int(name, pc)
                # iter_tag 0 — structural funcs are never iterator-bounded.
                var gbf_entry = mir::BoundedGenericFunc { base_name: name, ast_store: ast_store, func_handle: func_handle, type_params: "", bounds: "", mangled: mangled, iter_tag: 0 }
                gbf.push(gbf_entry)
                changed = 1
              end
            end
          end
        end
      end
    end
  end

  # PASS 0.97: Register record-param functions for monomorphization.
  # R2 (C1) — SUPERSEDED by the standalone flat-offset record-value path (the
  # param seam ~6932 registers a sorted-canonical @value struct and marks the
  # param with it, so field reads resolve through the ordinary nominal path). A
  # `mir_is_record_annotation` param no longer needs per-callsite monomorphization,
  # so it is excluded here. GATE-0-INERT: the compiler+stdlib carry ZERO real
  # record-typed param declarations (verified: only docstrings mention `{f:T}`),
  # so `has_record` was already always false for self-compile ⇒ byte-identical.
  # A `{`-prefixed non-record annotation (none exist today) would still fall to
  # the old path.
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      var name = entry.name
      if name != "main" and ctx.mir_lookup_bounded_generic(name).is_none()
        var ast_store = entry.ast_store
        var func_handle = entry.node_id
        var params = ast::ast_get_left(ast_store, func_handle)
        var has_record = false
        var pc = 0
        if params >= 0
          pc = vec_size(params)
          for pi in 0..pc
            var pt = ast::ast_get_str2(ast_store, params[pi])
            if str_byte_len(pt) > 0 and str_byte_at(pt, 0) == '{' and not mir::mir_is_record_annotation(pt)
              has_record = true
            end
          end
        end
        if has_record and pc > 0
          var mangled = string_intern::mangle_int(name, pc)
          # iter_tag 0 — record-param funcs are never iterator-bounded.
          var gbf_entry = mir::BoundedGenericFunc { base_name: name, ast_store: ast_store, func_handle: func_handle, type_params: "", bounds: "", mangled: mangled, iter_tag: 0 }
          gbf.push(gbf_entry)
        end
      end
    end
  end

  # PASS 0.98: Pre-scan all AST stores for async targets.
  # Previously, _async_func_names was populated on-demand during PASS 1 when
  # NODE_ASYNC_CALL was encountered. This left a hole: when lowering the plain
  # body of `def foo()` before any `go foo()` call site had been processed,
  # mir_is_async_target("foo") returned false — meaning QZ0210's check
  # couldn't distinguish legitimate go-target plain bodies from genuine
  # sched_park-outside-async errors.
  # Pre-scanning fixes this: walk every AST store once, register every
  # NODE_ASYNC_CALL / NODE_GO target. PASS 1's on-demand registration is
  # now idempotent (mir_record_async_target guards against duplicates).
  processed_stores = vec_new()
  for i in 0..count
    var entry = all_funcs[i]
    var ast_store = entry.ast_store
    var already_processed = any?(processed_stores, s: Int -> s == ast_store)
    if already_processed == 0
      processed_stores.push(ast_store)
      mir_lower_async_registry::mir_scan_async_targets(ast_store)
    end
  end

  # PASS 0.99: Reset async target collection for this compilation.
  # Async targets are discovered during PASS 1 when NODE_ASYNC_CALL is encountered.
  # $new constructors and $poll state machines are both generated in PASS 1.2.

  # Async targets are collected during PASS 1 when NODE_ASYNC_CALL is lowered.
  # The eager fallback is always used during PASS 1. After PASS 1, PASS 1.2
  # generates $new constructors and $poll state machines for discovered targets.

  # PASS 0.99b: AST-level suspend-effect propagation.
  # Fixpoint: any user function that transitively calls sched_yield / recv
  # / io_suspend / etc. is registered as an async target NOW, so that when
  # PASS 1.2a generates $poll bodies for go-targets, the colorless-dispatch
  # path inside those bodies can route calls to the suspendable callees
  # through @callee$poll instead of the plain sync @callee. Without this,
  # an earlier-generated $poll body calls a later-registered callee as
  # sync, parking the worker in pthread_cond_wait/usleep and starving
  # the scheduler. See docs/bugs/done/SYNC_RECV_WORKER_STARVATION.md.
  mir_lower_async_registry::mir_propagate_suspend_ast(all_funcs)

  # PASS 0.99c (A.17): compute the plain-reachable function set from `main`.
  # The QZ0210 check uses `mir_is_plain_reachable` — NOT the over-broad
  # async-target registry — to decide whether a `sched_park()` call sits
  # in a function whose plain body actually runs. See mir_compute_plain_
  # reachable in mir_lower_async_registry.qz.
  mir_lower_async_registry::mir_compute_plain_reachable(all_funcs)

  # PASS_ACTOR: Generate MIR for actor definitions (tag 12)
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 12
      mir_lower_actor(ctx, entry)
    end
  end

  # PASS 0.999 (INC.1.3): merge cached MIR bodies for each .qzmod hit.
  # Producer's `mir_pickle_function` shipped one MirFunc per non-synthetic
  # user function whose `origin_module == module_name`; `qzmod_load_mir_bodies`
  # walks each hit's blob and returns the unpickled Vec<MirFunc>. We push
  # each onto `mir_prog.functions` so codegen sees them, and track the max
  # `__lambda_<N>` id observed so PASS 1's consumer-local lambda numbering
  # starts past the producer's allocations (lambda names are flat across
  # all modules — collisions would shadow shipped lambdas with fresh ones).
  #
  # Gate on `hit_ast_stores` (= modules whose `tc_inject_qzmod` succeeded
  # at the consumer's Phase 4.0 pre-pass): a `.qzmod` artifact that loaded
  # cleanly but failed to inject (incompatible producer ptype arena, etc.)
  # is treated as a miss by PASS 1 — its module falls through to the
  # AST-path body lowering, so shipping its cached MIR here would double-
  # emit every function (LLVM "invalid redefinition" at llc).
  var max_cached_lambda = -1
  var cached_loaded = 0
  # INC.1.5 — track names of synthetic functions (`__Future_*$poll/$new`,
  # `__lambda_<N>`, actor proxies) loaded from `.qzmod`. PASS 1.2a/1.3a/1.3c
  # iterate the async-target registry to generate `mir_lower_async_poll` /
  # `mir_lower_async_constructor`; PASS 1.2b's `mir_mark_suspendable` seeds
  # the registry from call-graph edges that include cached MirFuncs — so
  # cached-hit modules' synthetics would be regenerated and emitted twice
  # (`invalid redefinition of function '__Future_*$poll'` at llc). Skip the
  # regeneration when the synthetic name is already present from cache.
  var cached_synthetic_names = vec_new<String>()
  # Track which source files we've already loaded MIR for. Dep-graph
  # registers each import-path name as a SEPARATE node with its OWN
  # ast_store (e.g. `terminal` and `std/terminal` referring to the same
  # source file land as two entries — different ast_stores, same path,
  # same content_hash). The earlier dedup-by-ast_store was wrong: two
  # aliases pointing to the same source had different ast_stores, so
  # both passed the dedup gate, and the cached MIR was loaded twice →
  # `invalid redefinition of function 'terminal$KEY_UP'` at llc.
  # Dedup by content_hash instead: same source → same hash, regardless
  # of how many import-path aliases name it. The companion producer-side
  # fix in `qzmod_emit.qz` deletes stale `mir_bodies.bin` files when an
  # alias has nothing to ship; the consumer-side `bodies_match` check
  # below validates each load against the alias's identity before
  # committing.
  var loaded_hashes = vec_new<String>()
  for qhi in 0..qzmod_hits.size
    var hit = qzmod_hits[qhi]
    if hit.ok == 1
      var hit_store = dep_graph::depgraph_get_ast_store(hit.module_name)
      var injected = 0
      if hit_store != 0
        injected = _mir_ast_store_in_hit_set(hit_store, hit_ast_stores)
      end
      var hit_hash = dep_graph::depgraph_get_content_hash(hit.module_name)
      var already_loaded = _qzmod_string_in(hit_hash, loaded_hashes)
      if injected == 1 and already_loaded == 0 and hit.mir_bodies_off.size > 0
        var bodies = qzmod_load::qzmod_load_mir_bodies(hit)
        # INC.1.4 — validate the bodies belong to THIS alias before we
        # commit. The producer's MIR filter is `origin_module == module_name`
        # (typecheck_registry.qz:5220); a `mir_bodies.bin` written by a
        # past binary that double-shipped (pre-INC.1.4) may sit in the
        # NON-canonical alias's directory (e.g. `std__terminal/`) carrying
        # MirFuncs whose origin_module is the canonical name (`terminal`).
        # The producer skips writing when there's nothing to ship; it does
        # NOT clean stale files (the matching producer cleanup is in this
        # same commit but only affects future runs). Without this check,
        # `loaded_stores` would pin the stale alias's bodies first and
        # subsequent codegen would emit duplicate function definitions
        # (`invalid redefinition of function 'terminal$KEY_UP'`). Compare
        # the first MirFunc's origin_module against `hit.module_name`; on
        # mismatch, treat as a stale read and skip.
        var bodies_match = 1
        if bodies.size > 0
          var first_fn: MirFunc = bodies[0]
          var first_origin = mir_func_get_origin_module(first_fn)
          if str_byte_len(first_origin) > 0 and not str_eq(first_origin, hit.module_name)
            bodies_match = 0
          end
        end
        if bodies_match == 0
          # Stale alias — don't push, don't dedup. The canonical alias's
          # later iteration will load the correct bodies (or fall back to
          # AST-path lowering if no alias is canonical for this run).
        else
        loaded_hashes.push(hit_hash)
        # INC.1.4 — repair cross-module call names. Producer can ship
        # bare names (`EAGAIN`) when the callee module wasn't in `all_funcs`
        # at producer mir-lower time; consumer has the full set in scope.
        _qzmod_rewrite_call_names(bodies, all_funcs)
        # INC.1.4 — recover `prog.uses_*` flags that would have fired
        # during cold body-lowering. Without this, codegen emits no-op
        # stubs for the scheduler/intern/cache/profile/scope-deadline
        # runtimes (gen1.ll vs gen2.ll fixpoint divergence).
        _qzmod_recover_uses_flags(bodies, prog)
        for bi in 0..bodies.size
          var fn = bodies[bi]
          var fname = mir_func_get_name(fn)
          # QZMOD_INJECT_IGNORES_CONSUMER_SHADOW (2026-05-21):
          # the resolver's local-wins shadow rule (`resolver.qz:1241-1271`)
          # replaces a wildcard-imported function entry in `all_funcs` with
          # the consumer's `def F` when both spell `F` bare. But the qzmod
          # body load below pushes the producer's `F` directly onto
          # `mir_get_functions(prog)` without consulting `all_funcs` —
          # the consumer's PASS 1 then lowers its own `F` from the local
          # AST, and codegen emits `define @F` twice → `llc` reject. Skip
          # any body whose name has a LOCAL all_funcs entry from a
          # DIFFERENT ast_store than this hit's. That entry exists only
          # when the shadow rule replaced a wildcard-imported entry with
          # a same-named local from another source. Cold-path equivalent:
          # PASS 1 iterates all_funcs (post-shadow) and lowers only the
          # winning entry. Same outcome here, applied to the qzmod side.
          #
          # QZMOD_ALIAS_NOT_SHADOW (2026-06-02): a different-ast_store entry
          # is NOT a shadow when it refers to the SAME SOURCE FILE as the hit
          # (same content_hash). The dep-graph allocates a separate ast_store
          # per import-path alias, and a single source can be reached by two
          # alias nodes (e.g. `std/time` imported both directly by the program
          # and transitively via another module) — both register their
          # module-qualified funcs (`time$time_epoch_ms`) into `all_funcs`
          # under distinct ast_stores. The pre-fix check saw the OTHER alias's
          # entry, declared a shadow, and skipped the cached body; PASS 1 then
          # ALSO skipped it (its ast_store's content_hash is in `loaded_hashes`)
          # → the function was emitted by NEITHER path → `llc: use of undefined
          # value '@time$time_epoch_ms'`. A genuine local shadow always comes
          # from a DIFFERENT source (different content_hash) AND produces a
          # BARE name (the resolver's local-wins rule only fires for wildcard-
          # imported bare names); a module-`$`-qualified cached body can never
          # be bare-shadowed. Gate the shadow on a differing content_hash so
          # same-source aliases are loaded, not dropped.
          var shadowed_by_local = 0
          for _qzs_ai in 0..all_funcs.size
            var _qzs_e = all_funcs[_qzs_ai]
            if _qzs_e.tag == 0 and _qzs_e.name == fname
              if _qzs_e.ast_store != hit_store
                var _qzs_hash = _mir_ast_store_content_hash(_qzs_e.ast_store)
                # Same source (alias of the hit) → not a shadow. Differing
                # source (or unknown hash) → genuine shadow, skip the body.
                if str_byte_len(_qzs_hash) == 0 or not str_eq(_qzs_hash, hit_hash)
                  shadowed_by_local = 1
                  break
                end
              end
            end
          end
          if shadowed_by_local == 1
            continue
          end
          mir_get_functions(prog).push(fn)
          cached_loaded = cached_loaded + 1
          cached_synthetic_names.push(fname)
          # `__lambda_<N>` and `__go_lambda_<N>` both draw <N> from the same
          # `ctx.mir_ctx_next_lambda()` counter — both must bump the cached
          # max, and cached MIR ships them `__Future_`-wrapped (A.23).
          var cached_lnum = _mir_cached_lambda_num(fname)
          if cached_lnum > max_cached_lambda
            max_cached_lambda = cached_lnum
          end
        end
        end
      end
    end
  end
  if max_cached_lambda >= 0
    ctx.lambda_counter = max_cached_lambda + 1
  end

  # PASS 1: Lower all functions (skip global vars and const functions)
  # Handles forward declarations and arity overloads:
  # - Forward decl: same name, same param count, earlier has empty body → skip earlier
  # - Arity overload: same name, different param counts → mangle both with $N
  # This mirrors C bootstrap's arity mangling (typecheck.c:343, mir.c:7102-7108)
  # and forward decl replacement (ast.c:1412, mir.c:7407-7426).
  for i in 0..count
    var entry = all_funcs[i]
    if entry.tag == 0
      var ast_store = entry.ast_store
      var func_handle = entry.node_id
      # Const functions (int_val >= 2) are also lowered for runtime use
      var name = entry.name

      # Skip actor-synthetic function stubs (body=-1) — generated in PASS_ACTOR
      var func_body_check = ast::ast_get_right(ast_store, func_handle)
      if func_body_check < 0
        # Actor stub — skip, MIR generated in PASS_ACTOR
      elsif _mir_ast_store_hash_in_loaded(ast_store, loaded_hashes) == 1
        # INC.1.3 — hit-module body: MIR was unpickled in PASS 0.999 above
        # and pushed onto `mir_prog.functions`. Bounded generics are NOT
        # in the cache (producer skips them); specializations of generics
        # owned by hit modules still emit in PASS 1.1 from the consumer's
        # call sites. Lambdas inside this body shipped under their own
        # `__lambda_<N>` MirFuncs and were loaded above. Skip live
        # lowering — the loaded MIR is authoritative.
        # INC.1.4 — join by `content_hash`, not `ast_store`. The resolver
        # allocates separate ast_stores per import-path alias (`terminal`
        # vs `std/terminal`) even when they point to the same source; a
        # single qzmod hit covers all aliases via the shared source hash.
      else

      # Skip bounded generic functions — they are only emitted as specializations
      var tp_skip = ast::ast_func_type_params(ast_store, func_handle)
      var bounds_skip = ast::ast_func_type_param_bounds(ast_store, func_handle)
      var is_bounded_generic = str_byte_len(tp_skip) > 0 and str_byte_len(bounds_skip) > 0

      # Iterator-bounded functions are NOT skipped — they are lowered normally
      # with their Iterator params transformed to closure params
      if is_bounded_generic
        var ibf_check = mir_lookup_iterator_bounded(ctx, name)
        if ibf_check.is_some()
          is_bounded_generic = false
        end
      end

      # Skip structurally-constrained functions — also emitted as specializations
      # (but NOT iterator-bounded functions, which are lowered normally)
      if is_bounded_generic == false
        var is_structural = ctx.mir_lookup_bounded_generic(name).is_some()
        if is_structural
          var ibf_check2 = mir_lookup_iterator_bounded(ctx, name)
          if ibf_check2.is_none()
            is_bounded_generic = true
          end
        end
      end

      # Get this function's param count
      var params = ast::ast_get_left(ast_store, func_handle)
      var param_count = 0
      if params >= 0
        param_count = vec_size(params)
      end

      # Check for forward declaration or arity overload
      var has_later_same_arity = 0
      var has_different_arity = 0
      for j in 0..count
        if j != i
          var other_entry = all_funcs[j]
          if other_entry.tag == 0
            if other_entry.name == name
              var other_store = other_entry.ast_store
              var other_handle = other_entry.node_id
              var other_params = ast::ast_get_left(other_store, other_handle)
              var other_param_count = 0
              if other_params >= 0
                other_param_count = vec_size(other_params)
              end
              if other_param_count == param_count and j > i
                has_later_same_arity = 1
              end
              if other_param_count != param_count
                has_different_arity = 1
              end
            end
          end
        end
      end

      if has_later_same_arity == 1
        # Forward declaration: skip this entry, later one has the real body
      else
        if is_bounded_generic == false
          # Determine the final function name
          var final_name = name
          if has_different_arity == 1
            # Arity overload: mangle name with $N (param count)
            final_name = string_intern::mangle_int(name, param_count)
          end

          # Incremental: suppress warnings for unchanged modules.
          # Always lower ALL functions — MIR skip is unsafe because lambda
          # numbering is global/sequential and would shift if modules are skipped.
          mir_lower_set_suppress_warnings(1 - _mir_should_lower(ast_store, final_name))

          # Extract module name and set in context for call resolution
          var module_name = mir_extract_module_name(final_name)
          ctx.mir_ctx_set_module(module_name)

          # A9: Detect impl block methods and set impl_current_type
          # If final_name contains '$' (e.g., "Point$eq"), check if the
          # prefix matches an impl block's for_type (tag 9 entries)
          var impl_for = ""
          var dollar_pos = __char_index(final_name, '$')
          if dollar_pos > 0
            var type_prefix = str_byte_slice(final_name, 0, dollar_pos)
            for ti in 0..count
              var tentry = all_funcs[ti]
              if tentry.tag == 9
                var impl_type = ast::ast_get_str2(tentry.ast_store, tentry.node_id)
                if impl_type == type_prefix
                  impl_for = type_prefix
                end
              end
            end
          end
          if str_byte_len(impl_for) > 0
            ctx.mir_ctx_set_impl_current_type(impl_for)
          end

          mir_lower_function_with_name(ctx, ast_store, func_handle, final_name)

          if str_byte_len(impl_for) > 0
            ctx.mir_ctx_set_impl_current_type("")
          end
          mir_lower_set_suppress_warnings(0)
        end
      end
      end
    end
  end

  # PASS 1.1: Emit pending specializations queued during PASS 1
  ctx.mir_emit_pending_specializations()

  # PASS 1.2a: Generate async $poll state machines.
  # Must run before call graph analysis so io_suspend calls are recorded as leaves.
  #
  # Phase 4D.5b: covers BOTH async functions and async generators uniformly.
  # The constructor lowering (`mir_lower_generator_effect`, unified for sync
  # and async in 4D.5c.5) emits ONLY the user-facing `<name>` ctor. Async-
  # generator $poll bodies are emitted here via the same `mir_lower_async_poll`
  # path as async fns (the state machine is identical post-4.B.7.b unification).
  # Specialized async-generator $polls are emitted by `mir_emit_pending_specializations`
  # at PASS 1.1 — those names don't appear in `all_funcs`, so the lookup-by-name
  # below would fail for them.
  # B.5e.3 — freestanding skips ALL $poll synthesis. The async-target
  # registry is still populated (PASS 0.98 pre-scan, needed for QZ0210's
  # plain-reachable distinction), but the kernel spawns via go_fn /
  # kern_go_closure (B.5e.2 + B.5e.3), never Future-poll state machines.
  # Synthesizing `__Future_<fn>$poll` here would reference hosted-only
  # globals (@__qz_sched, @__qz_waiter_notify_all, …) that are undefined
  # in the kernel — an llc-level "use of undefined value", not a
  # gc-droppable dead def. This gate (keyed on the unconditional
  # _mir_is_freestanding flag) closes the single-file-build hole that
  # qzmod_active_target()-keyed gates missed. See
  # docs/design/D11_FREESTANDING_EFFECT_BRIDGE.md B.5e.3.
  var _afn_count = mir_lower_async_registry::mir_async_target_count()
  if _mir_is_freestanding == 0
    for api in 0.._afn_count
      var ap_name = mir_lower_async_registry::mir_async_target_name(api)
      var func_entry = ctx.mir_lookup_function(ap_name)
      if func_entry.is_some()
        var ap_fe = func_entry.unwrap()
        var ap_store = ap_fe.ast_store
        var ap_node = ap_fe.node_id
        var ap_module = mir_extract_module_name(ap_name)
        ctx.mir_ctx_set_module(ap_module)
        # INC.1.5 — skip if cached `.qzmod` already shipped this `$poll`.
        var ap_poll_name = "__Future_#{ap_name}$poll"
        if _qzmod_string_in(ap_poll_name, cached_synthetic_names) == 0
          mir_lower_gen::mir_lower_async_poll(ctx, ap_store, ap_node, ap_name)
        end
        ctx.mir_ctx_set_module("")
      end
    end
  end

  # PASS 1.2b: Call graph analysis for suspendable functions.
  # After $poll generation, io_suspend leaves have been recorded.
  # Build call graph and propagate suspendability transitively.
  var cg_graph = mir_lower_async_registry::mir_build_call_graph(prog)
  mir_lower_async_registry::mir_mark_suspendable(cg_graph, prog)

  # PASS 1.2b-actor: Remove actor-generated functions from call graph.
  # Actor proxies call recv (EFFECT_SUSPEND) but are blocking, not suspending.
  # Removing them from the graph prevents SUSPEND from propagating to callers.
  for agf_i in 0.._actor_generated_funcs.size
    var agf_name = _actor_generated_funcs[agf_i]
    if map_has(cg_graph, agf_name)
      # Replace callees with empty list (don't propagate through this function)
      map_set(cg_graph, agf_name, vec_new<String>())
    end
  end

  # PASS 1.2b': Multi-effect inference.
  # Initialize effect leaf registry and propagate through call graph.
  # Effects: IO=1, Suspend=2, Panic=4, Alloc=8 (bitwise OR to combine).
  mir_lower_async_registry::mir_init_effect_leaves()
  mir_lower_async_registry::mir_propagate_effects(cg_graph, prog)

  # PASS 1.2b'': Verify effect annotations against inferred effects.
  for vfi in 0..all_funcs.size
    var ventry = all_funcs[vfi]
    if ventry.tag == 0  # function entry
      var v_ann = ast::ast_func_get_effect_annotation(ventry.ast_store, ventry.node_id)
      if v_ann != 0
        var vname = ventry.name
        var inferred = mir_lower_async_registry::mir_get_function_effects(vname)
        var vline = ast::ast_get_line(ventry.ast_store, ventry.node_id)
        var vcol = ast::ast_get_col(ventry.ast_store, ventry.node_id)
        # @pure: function must have zero inferred effects
        if (v_ann & 256) != 0  # EFFECT_ANNOTATED_PURE
          if inferred != 0
            var effect_label = mir_lower_async_registry::mir_effect_label(inferred)
            eputs("warning[QZ1410]: @pure function '#{vname}' has inferred effects: #{effect_label}")
            eputs("   --> #{vname}:#{to_str(vline)}:#{to_str(vcol)}")
          end
        end
        # @io: function must have IO effect
        if (v_ann & 1) != 0  # EFFECT_IO
          if (inferred & 1) == 0
            eputs("warning[QZ1411]: @io function '#{vname}' has no inferred IO effect")
            eputs("   --> #{vname}:#{to_str(vline)}:#{to_str(vcol)}")
          end
        end
        # @suspend: function must have Suspend effect
        if (v_ann & 2) != 0  # EFFECT_SUSPEND
          if (inferred & 2) == 0
            eputs("warning[QZ1412]: @suspend function '#{vname}' has no inferred Suspend effect")
            eputs("   --> #{vname}:#{to_str(vline)}:#{to_str(vcol)}")
          end
        end
      end
    end
  end

  # PASS 1.3: Colorless functions — auto-register EFFECT_SUSPEND functions as async targets.
  # Any function that transitively calls io_suspend/sched_yield/chan_recv (has EFFECT_SUSPEND)
  # gets compiled as a state machine ($poll/$new), enabling transparent yielding in go blocks.
  # Skip generated functions (__Future_*, __GenState_*, __lambda_*) and already-registered targets.
  #
  # D.11 Phase 7 / B.5d.1 — skip auto-registration entirely on freestanding
  # targets. The synthesized `__Future_X$poll` wrappers reference hosted
  # runtime (@__qz_current_frame, @__qz_sched_park_pending, pthread_*,
  # @__qz_waiter_notify_all, plus ~30 more from racedet/panic/pidfd/timer
  # subsystems) — none of which exist in the kernel. In freestanding the
  # kernel uses go_fn + seeded stacks for goroutines (real switch_to
  # context switches, not Future-poll machinery), so the wrappers are
  # pure dead code that breaks linking. Skipping the registration also
  # skips PASS 1.3a wrapper-body synthesis below, eliminating ~hundreds
  # of dead-code IR lines per consumer of stdlib channel/scope/awaitable.
  # B.5e.3: gate on the unconditional freestanding flag (set from
  # quartz.qz's `--target` check), NOT qzmod_active_target() — the latter
  # is empty on the single-file kernel build (`--no-cache`), so a
  # single-file `--target …-none-elf` compile would otherwise synthesize
  # orphan $poll wrappers that reference undefined hosted globals
  # (@__qz_sched, @__qz_waiter_notify_all) — an llc-level error.
  var _skip_pass13 = 0
  if _mir_is_freestanding == 1
    _skip_pass13 = 1
  end
  var auto_registered = 0
  if _skip_pass13 == 0
    for ari in 0..all_funcs.size
      var ar_entry = all_funcs[ari]
      if ar_entry.tag == 0  # function entry
        var ar_name = ar_entry.name
        # Skip actor-synthetic stubs (body=-1) — their MIR was generated in PASS_ACTOR
        var ar_body = ast::ast_get_right(ar_entry.ast_store, ar_entry.node_id)
        if ar_body >= 0
        if mir_lower_async_registry::mir_has_effect(ar_name, 2)  # EFFECT_SUSPEND
          if not mir_lower_async_registry::mir_is_async_target(ar_name)
            # Skip generated functions — lambdas + closures can't become $poll
            # state machines (their param/frame layout is different), and the
            # __Future_/__GenState_ variants are themselves $poll-shape.
            if not str_starts_with(ar_name, "__Future_")
              if not str_starts_with(ar_name, "__GenState_")
                if not str_starts_with(ar_name, "__lambda_")
                  if not str_starts_with(ar_name, "__closure_")
                    if not str_ends_with(ar_name, "$poll")
                      if not str_ends_with(ar_name, "$new")
                        mir_lower_async_registry::mir_record_async_target(ar_name, 0)
                        auto_registered += 1
                      end
                    end
                  end
                end
              end
            end
          end
        end
        end
      end
    end
  end

  # PASS 1.3a: Generate $poll state machines for auto-registered targets.
  # These $poll bodies benefit from effect inference: calls to other EFFECT_SUSPEND
  # functions automatically become inline awaits (colorless dispatch).
  # Phase 4D.5b: async generators handled here uniformly (see PASS 1.2a comment).
  var total_afn_count = mir_lower_async_registry::mir_async_target_count()
  if auto_registered > 0
    for api3 in _afn_count..total_afn_count
      var ap3_name = mir_lower_async_registry::mir_async_target_name(api3)
      var func_entry3 = ctx.mir_lookup_function(ap3_name)
      if func_entry3.is_some()
        var ap3_fe = func_entry3.unwrap()
        var ap3_store = ap3_fe.ast_store
        var ap3_node = ap3_fe.node_id
        var ap3_module = mir_extract_module_name(ap3_name)
        ctx.mir_ctx_set_module(ap3_module)
        # INC.1.5 — skip if cached `.qzmod` already shipped this `$poll`.
        var ap3_poll_name = "__Future_#{ap3_name}$poll"
        if _qzmod_string_in(ap3_poll_name, cached_synthetic_names) == 0
          mir_lower_gen::mir_lower_async_poll(ctx, ap3_store, ap3_node, ap3_name)
        end
        ctx.mir_ctx_set_module("")
      end
    end

    # PASS 1.3b: Rebuild call graph with new $poll functions.
    var cg_graph2 = mir_lower_async_registry::mir_build_call_graph(prog)
    mir_lower_async_registry::mir_mark_suspendable(cg_graph2, prog)
  end

  # PASS 1.3c: Generate async $new constructors for ALL targets (explicit + auto).
  # Pure functions (non-suspendable) get eager pre-poll (Kotlin fast-path).
  # Suspendable functions (contain io_suspend transitively) skip pre-poll → lazy Future.
  # B.5e.3 — freestanding skips $new synthesis too (same rationale as the
  # PASS 1.2a $poll gate above: the kernel never builds Future frames).
  var final_afn_count = mir_lower_async_registry::mir_async_target_count()
  if _mir_is_freestanding == 0
    for api2 in 0..final_afn_count
      var ap_name2 = mir_lower_async_registry::mir_async_target_name(api2)
      var func_entry2 = ctx.mir_lookup_function(ap_name2)
      if func_entry2.is_some()
        var ap_fe2 = func_entry2.unwrap()
        var ap_store2 = ap_fe2.ast_store
        var ap_node2 = ap_fe2.node_id
        var ap_module2 = mir_extract_module_name(ap_name2)
        ctx.mir_ctx_set_module(ap_module2)
        # INC.1.5 — skip if cached `.qzmod` already shipped this `$new`.
        var ap_new_name2 = "__Future_#{ap_name2}$new"
        if _qzmod_string_in(ap_new_name2, cached_synthetic_names) == 0
          mir_lower_gen::mir_lower_async_constructor(ctx, ap_store2, ap_node2, ap_name2)
        end
        ctx.mir_ctx_set_module("")
      end
    end
  end

  # PASS 1.5: Synthesize __qz_module_init for complex global initializers
  # Global vars with non-literal initializers (e.g., _state = vec_new()) need
  # their init expressions lowered and called at program startup.
  # Also handles const string globals (e.g., QUARTZ_VERSION = "5.12.15-alpha")
  # which need runtime string pointer stores.
  # This mirrors bootstrap mir.c:7494-7521.
  var has_complex_init = 0
  for gi in 0..global_init_nodes.size
    var init_node = global_init_nodes[gi]
    if init_node >= 0
      var init_val = global_inits[gi]
      var str_val = global_str_inits[gi]
      if init_val == 0
        if str_byte_len(str_val) == 0
          has_complex_init = 1
        end
      end
    end
  end

  # Also check if any program globals need string initialization
  var prog_gnames_init = mir_get_global_names(prog)
  var prog_gstr_init = mir_get_global_str_inits(prog)
  var has_str_init = 0
  for si in 0..prog_gstr_init.size
    if str_byte_len(prog_gstr_init[si]) > 0
      has_str_init = 1
    end
  end

  if has_complex_init == 1 or has_str_init == 1
    # Reset per-function context
    reset_droppables(ctx)
    reset_defers(ctx)
    reset_string_vars(ctx)
    reset_float_vars(ctx)
    reset_vec_elem_types(ctx)
    reset_map_key_types(ctx)
    reset_struct_types(ctx)
    ctx.bindings = vec_new()

    var init_func = mir_new_function("__qz_module_init", mir::MIR_TYPE_INT)
    mir_get_functions(prog).push(init_func)
    ctx.mir_ctx_set_func(init_func)

    var init_entry = ctx.mir_create_block("entry")
    ctx.mir_switch_to_block(init_entry)

    # Emit complex var global inits (expression lowering).
    # TWO PASSES — literal stores before complex inits.
    #
    # `var X = LITERAL` and `var X = complex()` can coexist in
    # `__qz_module_init`. The original single-pass codegen emitted them
    # in declaration order; that left `store 0, @global_X` instructions
    # interleaved with `call lazy_init()` instructions. If a complex
    # init lazy-initializes some sentinel global (e.g.
    # `if g_pmm_next == 0 then g_pmm_next = pool_start end`) and a
    # LATER `var g_pmm_next = 0` declaration emits its trivial store
    # AFTER, the trivial store silently undoes the lazy init. PMM bump
    # cursor hit this in D.11 Phase 8c.1 (2026-05-25); see
    # feedback_qz_module_init_trivial_store_ordering.md.
    #
    # Fix #2 from that memo: emit literal-LIT stores FIRST in a
    # separate pass, then complex inits AFTER. The literal stores
    # become idempotent backstops behind which any subsequent complex
    # init's lazy mutation survives. Cannot just SKIP the literal
    # stores (Fix #1) — DCE reachability seeds from `__qz_module_init`,
    # and removing the lit-store emissions causes downstream cache-
    # codec sites (module-fragment writes, qzmod producer) to drop
    # unrelated function defs (`terminal$KEY_DELETE`, `colors$_init_state`,
    # …). The lit-store stays so downstream emissions stay consistent;
    # the reorder is sufficient to close the clobber.
    #
    # Pass 1a: literal NODE_INT_LIT stores (idempotent — equal to
    # whatever the LLVM static initializer set in @global_X = …).
    for gi in 0..global_init_nodes.size
      var init_node = global_init_nodes[gi]
      if init_node >= 0
        var init_val = global_inits[gi]
        var str_val = global_str_inits[gi]
        if init_val == 0
          if str_byte_len(str_val) == 0
            var ast_store = global_ast_stores[gi]
            var init_kind = ast::ast_get_kind(ast_store, init_node)
            if init_kind == node_constants::NODE_INT_LIT
              var gname = global_names[gi]
              var module_name = mir_extract_module_name(gname)
              ctx.mir_ctx_set_module(module_name)
              var result = ctx.mir_lower_expr(ast_store, init_node)
              ctx.mir_emit_store_var(gname, result)
            end
          end
        end
      end
    end

    # Pass 1b: non-literal complex inits (vec_new, function calls,
    # const expressions that didn't const-eval, …). These run AFTER
    # all literal stores so any lazy-init they perform survives.
    for gi in 0..global_init_nodes.size
      var init_node = global_init_nodes[gi]
      if init_node >= 0
        var init_val = global_inits[gi]
        var str_val = global_str_inits[gi]
        if init_val == 0
          if str_byte_len(str_val) == 0
            var ast_store = global_ast_stores[gi]
            var init_kind = ast::ast_get_kind(ast_store, init_node)
            if init_kind != node_constants::NODE_INT_LIT
              var gname = global_names[gi]
              var module_name = mir_extract_module_name(gname)
              ctx.mir_ctx_set_module(module_name)
              var result = ctx.mir_lower_expr(ast_store, init_node)
              ctx.mir_emit_store_var(gname, result)
            end
          end
        end
      end
    end

    # Emit const string global inits (string literal stores)
    for si in 0..prog_gstr_init.size
      if str_byte_len(prog_gstr_init[si]) > 0
        var str_reg = ctx.mir_emit_const_string(prog_gstr_init[si])
        ctx.mir_emit_store_var(prog_gnames_init[si], str_reg)
      end
    end

    # Return 0
    var zero_ret = ctx.mir_emit_const_int(0)
    ctx.mir_emit_return(zero_ret)
  end

  # Copy struct registry to program for codegen access (use setter to avoid field_idx=0 bug)
  mir_set_struct_defs(prog, ctx.mir_ctx_get_struct_registry())

  return prog
end

# Get context from program (for emit_repr_c_structs after MIR lowering)
# ============================================================================
# Actor MIR Lowering
# ============================================================================
# Generates all MIR functions for a language-level actor definition.
# Each actor produces:
#   1. Spawn function: ActorName() — allocates state, creates channel, spawns poll task
#   2. Poll function: ActorName$__poll(frame) — recv loop + message dispatch
#   3. Proxy methods: ActorName$method(self, ...) — construct message + send to inbox

## Reset per-function MIR state (used before generating each synthetic function)
def mir_actor_reset_func_state(ctx: MirContext): Void
  reset_droppables(ctx)
  reset_defers(ctx)
  reset_string_vars(ctx)
  reset_float_vars(ctx)
  reset_vec_elem_types(ctx)
  reset_map_key_types(ctx)
  reset_struct_types(ctx)
  ctx.mir_ctx_clear_iterator_bound_params()
  ctx.bindings = vec_new()
end

## Main entry point: generate all MIR for an actor definition
def mir_lower_actor(ctx: MirContext, entry: ResolverEntry): Void
  var ast_store = entry.ast_store
  var node = entry.node_id
  var actor_name = entry.name
  var children = ast::ast_get_children(ast_store, node)

  # Separate fields (NODE_FIELD_DEF=37) and methods (NODE_FUNCTION=34)
  var field_names = vec_new<String>()
  var field_defaults = vec_new()
  var method_nodes = vec_new()
  var method_names = vec_new<String>()
  var method_ret_types = vec_new<String>()
  var method_param_counts = vec_new()

  var ch_count = children.size
  for ci in 0..ch_count
    var child = children[ci]
    var ck = ast::ast_get_kind(ast_store, child)
    if ck == 37
      field_names.push(ast::ast_get_str1(ast_store, child))
      field_defaults.push(ast::ast_field_default(ast_store, child))
    elsif ck == 34
      method_nodes.push(child)
      method_names.push(ast::ast_get_str1(ast_store, child))
      var ret = ast::ast_get_str2(ast_store, child)
      if str_byte_len(ret) == 0
        ret = "Void"
      end
      method_ret_types.push(ret)
      var mp = ast::ast_get_left(ast_store, child)
      var mpc = 0
      if mp > 0
        mpc = vec_size(mp)
      end
      method_param_counts.push(mpc)
    end
  end

  var field_count = field_names.size
  var method_count = method_nodes.size
  var inbox_offset = field_count

  # 1. Generate spawn function(s)
  if field_count > 0
    # Two spawn variants (arity overloading): Counter$0() and Counter$N(fields...)
    mir_lower_actor_spawn(ctx, ast_store, "#{actor_name}$0", field_names, field_defaults, field_count, inbox_offset, 0)
    mir_lower_actor_spawn(ctx, ast_store, "#{actor_name}$#{field_count}", field_names, field_defaults, field_count, inbox_offset, 1)
  else
    # Single spawn: Counter() — no fields to initialize
    mir_lower_actor_spawn(ctx, ast_store, actor_name, field_names, field_defaults, field_count, inbox_offset, 0)
  end

  # 2. Generate poll function (recv loop + dispatch).
  # B.5e.7a — freestanding emits a plain kernel-goroutine fn instead of the
  # hosted async-generator $poll state machine.
  if _mir_is_freestanding == 1
    mir_lower_actor_poll_freestanding(ctx, ast_store, actor_name, field_names, field_count, inbox_offset, method_nodes, method_ret_types, method_param_counts)
  else
    mir_lower_actor_poll(ctx, ast_store, actor_name, field_names, field_count, inbox_offset, method_nodes, method_names, method_ret_types, method_param_counts)
  end

  # 3. Generate proxy method bodies
  mir_lower_actor_proxies(ctx, actor_name, method_nodes, method_names, method_ret_types, method_param_counts, ast_store)

  # 4. Generate stop proxy: ActorName$stop(self) -> Int (synchronous shutdown)
  mir_lower_actor_stop(ctx, ast_store, actor_name)

  # 5. Generate async proxy variants for non-void methods (for select integration)
  mir_lower_actor_async_proxies(ctx, actor_name, method_nodes, method_names, method_ret_types, method_param_counts, ast_store)

  # 6. Generate link/unlink/monitor/demonitor proxy functions (Phase 10)
  mir_lower_actor_link_proxies(ctx, ast_store, actor_name, field_count)
end

## Generate spawn function: spawn_name() -> Int
## use_params=0: uses defaults. use_params=1: reads field values from function params.
## poll_name is always based on the original actor name (not arity-mangled).
def mir_lower_actor_spawn(ctx: MirContext, ast_store: ast::AstStorage, spawn_name: String, field_names: Vec<String>, field_defaults: Vec<Int>, field_count: Int, inbox_offset: Int, use_params: Int): Void
  ctx.mir_actor_reset_func_state()

  var prog = ctx.mir_ctx_get_program()
  var func = mir_new_function(spawn_name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(ast_store))
  mir_get_functions(prog).push(func)
  ctx.mir_ctx_set_func(func)
  _actor_generated_funcs.push(spawn_name)

  # If use_params, add function parameters matching actor fields
  if use_params == 1
    for fp_i in 0..field_count
      mir_func_add_param(func, field_names[fp_i], mir::MIR_TYPE_INT)
      var fp_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(field_names[fp_i], fp_slot)
    end
  end

  var entry_block = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(entry_block)

  # Create inbox channel with capacity 256
  var cap_val = ctx.mir_emit_const_int(256)
  var ch_args = vec_new()
  ch_args.push(cap_val)
  var inbox = ctx.mir_emit_intrinsic("channel_new", ch_args)

  # Allocate state struct: field_count + 4 words (inbox, pending_reply, links, monitors)
  var state_words = field_count + 4
  var state = ctx.mir_emit_alloc(state_words)

  # Initialize fields: from params if use_params, else from defaults
  for fi in 0..field_count
    if use_params == 1
      var param_val = ctx.mir_emit_load_var(field_names[fi])
      ctx.mir_emit_store_offset(state, fi, param_val)
    else
      var default_node = field_defaults[fi]
      if default_node > 0
        var val = ctx.mir_lower_expr(ast_store, default_node)
        ctx.mir_emit_store_offset(state, fi, val)
      else
        var zero = ctx.mir_emit_const_int(0)
        ctx.mir_emit_store_offset(state, fi, zero)
      end
    end
  end

  # Store inbox and initialize pending_reply to 0
  ctx.mir_emit_store_offset(state, inbox_offset, inbox)
  var pending_zero = ctx.mir_emit_const_int(0)
  ctx.mir_emit_store_offset(state, inbox_offset + 1, pending_zero)

  # Initialize __links and __monitors to empty vecs (Phase 10: Process Links & Monitors)
  var links_vec = ctx.mir_emit_intrinsic("vec_new", vec_new())
  ctx.mir_emit_store_offset(state, inbox_offset + 2, links_vec)
  var monitors_vec = ctx.mir_emit_intrinsic("vec_new", vec_new())
  ctx.mir_emit_store_offset(state, inbox_offset + 3, monitors_vec)

  # Phase 9 (Actor M:N): Spawn actor on M:N scheduler instead of OS thread.
  # Call the async constructor to get a frame, then sched_spawn.
  var poll_base = spawn_name
  var dollar_idx = __char_index(spawn_name, '$')
  if dollar_idx > 0
    poll_base = str_byte_slice(spawn_name, 0, dollar_idx)
  end
  # B.5e.7a — freestanding: spawn the plain `ActorName$__poll(state)` goroutine
  # fn (mir_lower_actor_poll_freestanding) as a real kernel goroutine via
  # kern_go_closure, capturing `state` as its single arg (the B.5e.3 helper).
  # No hosted Future frame, so no -999 frame[3] supervision sentinel — kernel
  # actor restart-on-panic is filed forward (depends on kernel panic recovery).
  if _mir_is_freestanding == 1
    var fs_poll_name = string_intern::mangle(poll_base, "__poll")
    var fs_spawn_args = vec_new()
    fs_spawn_args.push(state)
    _mir_fs_spawn_closure_with_args(ctx, fs_poll_name, fs_spawn_args)
    mir_set_uses_scheduler(prog)
  else
    var ctor_name = "__Future_#{poll_base}$__poll$new"
    var ctor_args = vec_new()
    ctor_args.push(state)
    var frame = ctx.mir_emit_call(ctor_name, ctor_args)
    # Mark as actor frame: store sentinel -999 in frame[3] (cancel_token slot).
    # The worker loop's panic_caught handler checks this to restart actors on panic
    # instead of killing them (Erlang-style "let it crash" supervision).
    var actor_sentinel = ctx.mir_emit_const_int(-999)
    ctx.mir_emit_store_offset(frame, 3, actor_sentinel)
    var sched_args = vec_new()
    sched_args.push(frame)
    ctx.mir_emit_intrinsic("sched_spawn", sched_args)
    mir_set_uses_scheduler(prog)
  end

  # Return inbox channel handle
  var block = ctx.mir_ctx_get_block()
  mir_block_set_terminator(block, mir::TERM_RETURN, inbox)
end

## Emit a notification loop in MIR: iterate Vec at state[vec_offset],
## send [tag_val, self_inbox] to each non-closed channel handle.
## Emits jump from current block to the loop init block.
## When done, jumps to after_block. No unterminated block remains.
## Requires __notify_i and __inbox and __actor_state slots already allocated.
def mir_emit_actor_notify_loop(ctx: MirContext, prefix: String, vec_offset: Int, tag_val: Int, after_block: MirBlock): Void
  var init_block = ctx.mir_create_block("#{prefix}_init")
  ctx.mir_emit_jump(init_block)
  ctx.mir_switch_to_block(init_block)

  var st = ctx.mir_emit_load_var("__actor_state")
  var nvec = ctx.mir_emit_load_offset(st, vec_offset)
  var nsize_args = vec_new()
  nsize_args.push(nvec)
  var nsize = ctx.mir_emit_intrinsic("vec_size", nsize_args)
  ctx.mir_emit_store_var("__notify_i", ctx.mir_emit_const_int(0))

  var check_block = ctx.mir_create_block("#{prefix}_chk")
  ctx.mir_emit_jump(check_block)
  ctx.mir_switch_to_block(check_block)

  var ni = ctx.mir_emit_load_var("__notify_i")
  var ncond = ctx.mir_emit_binary(op_constants::OP_LT, ni, nsize)
  var body_block = ctx.mir_create_block("#{prefix}_body")
  ctx.mir_emit_branch(ncond, body_block, after_block)

  ctx.mir_switch_to_block(body_block)
  var ni2 = ctx.mir_emit_load_var("__notify_i")
  var get_args = vec_new()
  get_args.push(nvec)
  get_args.push(ni2)
  var ntarget = ctx.mir_emit_intrinsic("vec_get", get_args)

  var closed_args = vec_new()
  closed_args.push(ntarget)
  var nclosed = ctx.mir_emit_intrinsic("channel_closed", closed_args)
  var send_block = ctx.mir_create_block("#{prefix}_send")
  var skip_block = ctx.mir_create_block("#{prefix}_skip")
  ctx.mir_emit_branch(nclosed, skip_block, send_block)

  ctx.mir_switch_to_block(send_block)
  var nmsg = ctx.mir_emit_alloc(2)
  ctx.mir_emit_store_offset(nmsg, 0, ctx.mir_emit_const_int(tag_val))
  var ninbox = ctx.mir_emit_load_var("__inbox")
  ctx.mir_emit_store_offset(nmsg, 1, ninbox)
  var nsend_args = vec_new()
  nsend_args.push(ntarget)
  nsend_args.push(nmsg)
  ctx.mir_emit_intrinsic("send", nsend_args)
  ctx.mir_emit_jump(skip_block)

  ctx.mir_switch_to_block(skip_block)
  var ni3 = ctx.mir_emit_load_var("__notify_i")
  var ni_next = ctx.mir_emit_binary(op_constants::OP_ADD, ni3, ctx.mir_emit_const_int(1))
  ctx.mir_emit_store_var("__notify_i", ni_next)
  ctx.mir_emit_jump(check_block)
end

## Emit a remove-by-value loop: scan Vec at state[vec_offset] for
## msg[1] and call vec_remove on the first match.
## Emits jump from current block. Jumps to after_block when done.
def mir_emit_actor_vec_remove(ctx: MirContext, prefix: String, vec_offset: Int, after_block: MirBlock): Void
  var init_block = ctx.mir_create_block("#{prefix}_init")
  ctx.mir_emit_jump(init_block)
  ctx.mir_switch_to_block(init_block)

  var st = ctx.mir_emit_load_var("__actor_state")
  var rvec = ctx.mir_emit_load_offset(st, vec_offset)
  var rsize_args = vec_new()
  rsize_args.push(rvec)
  var rsize = ctx.mir_emit_intrinsic("vec_size", rsize_args)
  var rmsg = ctx.mir_emit_load_var("__msg")
  var rtarget = ctx.mir_emit_load_offset(rmsg, 1)
  ctx.mir_emit_store_var("__notify_i", ctx.mir_emit_const_int(0))

  var check_block = ctx.mir_create_block("#{prefix}_chk")
  ctx.mir_emit_jump(check_block)
  ctx.mir_switch_to_block(check_block)

  var ri = ctx.mir_emit_load_var("__notify_i")
  var rcond = ctx.mir_emit_binary(op_constants::OP_LT, ri, rsize)
  var body_block = ctx.mir_create_block("#{prefix}_body")
  ctx.mir_emit_branch(rcond, body_block, after_block)

  ctx.mir_switch_to_block(body_block)
  var ri2 = ctx.mir_emit_load_var("__notify_i")
  var rget_args = vec_new()
  rget_args.push(rvec)
  rget_args.push(ri2)
  var relem = ctx.mir_emit_intrinsic("vec_get", rget_args)
  var req = ctx.mir_emit_binary(op_constants::OP_EQ, relem, rtarget)
  var found_block = ctx.mir_create_block("#{prefix}_found")
  var next_block = ctx.mir_create_block("#{prefix}_next")
  ctx.mir_emit_branch(req, found_block, next_block)

  ctx.mir_switch_to_block(found_block)
  var ri3 = ctx.mir_emit_load_var("__notify_i")
  var rm_args = vec_new()
  rm_args.push(rvec)
  rm_args.push(ri3)
  ctx.mir_emit_intrinsic("vec_delete", rm_args)
  ctx.mir_emit_jump(after_block)

  ctx.mir_switch_to_block(next_block)
  var ri4 = ctx.mir_emit_load_var("__notify_i")
  var ri_next = ctx.mir_emit_binary(op_constants::OP_ADD, ri4, ctx.mir_emit_const_int(1))
  ctx.mir_emit_store_var("__notify_i", ri_next)
  ctx.mir_emit_jump(check_block)
end

## Generate poll function: ActorName$__poll(self) -> Int
## The recv loop: receive messages from inbox, dispatch to handlers
def mir_lower_actor_poll(ctx: MirContext, ast_store: ast::AstStorage, actor_name: String, field_names: Vec<String>, field_count: Int, inbox_offset: Int, method_nodes: Vec<Int>, method_names: Vec<String>, method_ret_types: Vec<String>, method_param_counts: Vec<Int>): Void
  # Phase 9 (Actor M:N): Generate async constructor + $poll state machine.
  # The actor loop runs as a scheduler task with colorblind async recv/send.
  var poll_name = string_intern::mangle(actor_name, "__poll")
  var PARAM_BASE = 6  # async frame: [state@0, result@1, poll_fn@2, cancel@3, task_id@4, park_state@5, params@6+]

  # --- Emit constructor: __Future_ActorName$__poll$new(__actor_state) ---
  ctx.mir_actor_reset_func_state()
  var prog = ctx.mir_ctx_get_program()

  # All vars that need to live across suspend points (captures + internal)
  var all_var_names = vec_new<String>()
  all_var_names.push("__actor_state")
  for fi in 0..field_count
    all_var_names.push(field_names[fi])
  end
  all_var_names.push("__inbox")
  all_var_names.push("__msg")
  all_var_names.push("__notify_i")

  var frame_size = PARAM_BASE + all_var_names.size + mir_lower_gen::GEN_FRAME_PADDING

  var ctor_name = "__Future_#{poll_name}$new"
  var ctor_func = mir_new_function(ctor_name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(ctor_func, dep_graph::depgraph_name_for_ast_store(ast_store))
  mir_get_functions(prog).push(ctor_func)
  ctx.mir_ctx_set_func(ctor_func)

  mir_func_add_param(ctor_func, "__actor_state", mir::MIR_TYPE_INT)
  var ctor_state_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("__actor_state", ctor_state_slot)

  var ctor_entry = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(ctor_entry)

  var frame_ptr = ctx.mir_emit_alloc(frame_size)
  ctx.mir_emit_store_offset(frame_ptr, 0, ctx.mir_emit_const_int(0))
  ctx.mir_emit_store_offset(frame_ptr, 1, ctx.mir_emit_const_int(0))
  var async_poll_name = "__Future_#{poll_name}$poll"
  var poll_fn_ref = ctx.mir_emit_func_ref(async_poll_name)
  ctx.mir_emit_store_offset(frame_ptr, 2, poll_fn_ref)
  ctx.mir_emit_store_offset(frame_ptr, 3, ctx.mir_emit_const_int(0))
  var tid_args = vec_new()
  var tid_val = ctx.mir_emit_intrinsic("task_id_next", tid_args)
  ctx.mir_emit_store_offset(frame_ptr, 4, tid_val)
  # Park state = 0 (RUNNING)
  ctx.mir_emit_store_offset(frame_ptr, 5, ctx.mir_emit_const_int(0))
  # Store __actor_state as first param in frame
  var ctor_state_val = ctx.mir_emit_load_var("__actor_state")
  ctx.mir_emit_store_offset(frame_ptr, PARAM_BASE, ctor_state_val)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, frame_ptr)

  # --- Emit $poll state machine: __Future_ActorName$__poll$poll(self) ---
  ctx.mir_actor_reset_func_state()

  var poll_func = mir_new_function(async_poll_name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(poll_func, dep_graph::depgraph_name_for_ast_store(ast_store))
  mir_get_functions(prog).push(poll_func)
  ctx.mir_ctx_set_func(poll_func)
  _actor_generated_funcs.push(poll_name)

  # $poll takes one param: self (the frame pointer)
  mir_func_add_param(poll_func, "self", mir::MIR_TYPE_INT)
  var self_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("self", self_slot)

  # Bind all variables (they'll be saved/restored from frame across suspends)
  var all_offsets = vec_new()
  for vi in 0..all_var_names.size
    var var_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(all_var_names[vi], var_slot)
    all_offsets.push(PARAM_BASE + vi)
  end

  # Set up async state machine context (_gen_active=2)
  mir_lower_gen::mir_gen_init_state_machine(poll_name)
  mir_lower_gen::mir_gen_set_active(2)
  mir_lower_gen::mir_gen_set_frame_var("self")
  mir_lower_gen::mir_gen_set_locals(all_var_names, all_offsets)
  mir_lower_gen::mir_gen_set_next_offset(PARAM_BASE + all_var_names.size)

  # Entry: load state, dispatch to resume point
  var poll_entry = ctx.mir_create_block("poll_entry")
  ctx.mir_switch_to_block(poll_entry)

  var self_val = ctx.mir_emit_load_var("self")
  var state_val = ctx.mir_emit_load_offset(self_val, 0)

  var done_block = ctx.mir_create_block("poll_done")
  var start_block = ctx.mir_create_block("poll_start")
  mir_lower_gen::mir_gen_add_resume_block(start_block)

  # Start block: restore all variables from frame
  ctx.mir_switch_to_block(start_block)
  var self_start = ctx.mir_emit_load_var("self")
  for vi in 0..all_var_names.size
    var loaded = ctx.mir_emit_load_offset(self_start, all_offsets[vi])
    ctx.mir_emit_store_var(all_var_names[vi], loaded)
  end

  # B.5e.7a — emit the shared recv-loop body in this generator $poll
  # function (freestanding=0: terminations write the async frame).
  mir_emit_actor_poll_body(ctx, ast_store, field_names, field_count, inbox_offset, method_nodes, method_ret_types, method_param_counts, 0)
  # ===== End actor poll body =====
  # Done block: actor terminated (shouldn't reach here normally — infinite loop)
  ctx.mir_switch_to_block(done_block)
  mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(1))

  # Build state dispatch chain in poll_entry
  mir_lower_gen::mir_gen_build_dispatch(ctx, poll_entry, done_block)
end

## B.5e.7a — freestanding actor message loop. The kernel has no hosted Future
## state machine (no pthreads/waiters/$poll), so instead of the generator
## `$poll`, the actor runs as a real kernel goroutine: a PLAIN function
## `ActorName$__poll(__actor_state)` whose body runs straight-line, parking on
## the blocking `recv` via the B.4 suspend/wake bridge (kernel channels, B.5d).
## `mir_lower_actor_spawn` spawns it via `kern_go_closure` (B.5e.3 helper).
## All loop vars are plain stack slots — the goroutine has its own real stack,
## so they persist across `recv` with no save/restore. Shares the exact body
## with the hosted path via `mir_emit_actor_poll_body(..., 1)`.
def mir_lower_actor_poll_freestanding(ctx: MirContext, ast_store: ast::AstStorage, actor_name: String, field_names: Vec<String>, field_count: Int, inbox_offset: Int, method_nodes: Vec<Int>, method_ret_types: Vec<String>, method_param_counts: Vec<Int>): Void
  var poll_name = string_intern::mangle(actor_name, "__poll")
  ctx.mir_actor_reset_func_state()
  var prog = ctx.mir_ctx_get_program()

  var poll_func = mir_new_function(poll_name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(poll_func, dep_graph::depgraph_name_for_ast_store(ast_store))
  mir_get_functions(prog).push(poll_func)
  ctx.mir_ctx_set_func(poll_func)
  _actor_generated_funcs.push(poll_name)

  # The state struct pointer arrives as the sole parameter (captured into the
  # goroutine closure env by mir_lower_actor_spawn's _mir_fs_spawn_closure_with_args).
  mir_func_add_param(poll_func, "__actor_state", mir::MIR_TYPE_INT)
  var state_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("__actor_state", state_slot)

  # Bind the remaining loop vars (and actor fields) to plain stack slots. They
  # start uninitialized; the body sets them (e.g. __inbox from the state struct,
  # fields per-handler). No async frame, no `self`.
  for fi in 0..field_count
    var fld_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(field_names[fi], fld_slot)
  end
  var inbox_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("__inbox", inbox_slot)
  var msg_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("__msg", msg_slot)
  var notify_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("__notify_i", notify_slot)

  var entry_block = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(entry_block)

  mir_emit_actor_poll_body(ctx, ast_store, field_names, field_count, inbox_offset, method_nodes, method_ret_types, method_param_counts, 1)
end

## B.5e.7a — shared actor message-loop body. Emitted verbatim by BOTH the
## hosted generator `$poll` (freestanding=0) and the freestanding plain
## goroutine fn `ActorName$__poll` (freestanding=1). The caller must have
## already bound `__actor_state`, the actor fields, `__inbox`, `__msg`,
## `__notify_i` (and, hosted-only, `self`) and be positioned in a live block.
## Only the 3 termination sites diverge: hosted writes the async frame
## (`self[0]=-1; return 1`); freestanding just `return 0` (goroutine done).
def mir_emit_actor_poll_body(ctx: MirContext, ast_store: ast::AstStorage, field_names: Vec<String>, field_count: Int, inbox_offset: Int, method_nodes: Vec<Int>, method_ret_types: Vec<String>, method_param_counts: Vec<Int>, freestanding: Int): Void
  # ===== Begin actor poll body (same logic, now with _gen_active=2) =====
  # State layout: [fields..., inbox, pending_reply, links, monitors]
  var pending_reply_offset = inbox_offset + 1
  var links_offset = inbox_offset + 2
  var monitors_offset = inbox_offset + 3

  # B.5e.8 Stage 2 — freestanding per-goroutine panic-recovery boundary.
  # Hosted catches a handler panic in the scheduler worker loop
  # (`panic_caught` → frame[3]==-999 → `pc_actor_restart` re-enters $poll,
  # which re-runs the entry prologue to clean the orphaned reply + notify
  # links/monitors, then continues recv — the actor SURVIVES, only the
  # in-flight message is dropped). The freestanding poll is a plain goroutine
  # with no such boundary, so a handler panic would unwind via the freestanding
  # `panic` path. B.5e.8a made that path perform `Throws.throw` (kind=2) IF a
  # Throws handler is installed; here we install one whose setjmp buf lands back
  # at `actor_reenter`, giving the same recover-in-place semantics.
  #
  # Shape: `actor_reenter` installs a Throws handler (no-op handler fn +
  # this install's own jmpbuf) and setjmps; the body (entry prologue + recv
  # loop) is the install's body. The body never falls through — stop/cascade/
  # crash set TERM_RETURN(0); the dispatch loop cycles internally — so the
  # install's `wb.done` block is reachable ONLY via the catch (longjmp) path.
  # On a panic, `__qz_effect_perform` longjmps to the buf → wb.catch → wb.done
  # (which pops the handler) → loop back to `actor_reenter`, re-installing and
  # re-running the prologue. pop(wb.done) + reinstall(actor_reenter) keep the
  # effect-stack depth balanced across panics.
  var fs_reenter_block = -1
  var fs_install_dest = -1
  if freestanding == 1
    fs_reenter_block = ctx.mir_create_block("actor_reenter")
    ctx.mir_emit_jump(fs_reenter_block)
    ctx.mir_switch_to_block(fs_reenter_block)
    var fs_throws_entries = vec_new<Int>()
    fs_throws_entries.push(as_int("throw"))
    fs_throws_entries.push(as_int("__qz_actor_throws_noop"))
    fs_install_dest = ctx.mir_emit_handle_install("Throws", fs_throws_entries, -1)
    ctx.mir_ctx_push_handler_entry("Throws", "throw", as_int("__qz_actor_throws_noop"), fs_install_dest)
    ctx.mir_ctx_push_wrap("Throws", 1)
  end

  # Entry block: load inbox, clean up any pending reply from a panicked handler
  var entry_block = ctx.mir_create_block("actor_entry")
  ctx.mir_emit_jump(entry_block)
  ctx.mir_switch_to_block(entry_block)

  var state_ptr = ctx.mir_emit_load_var("__actor_state")
  var inbox_val = ctx.mir_emit_load_offset(state_ptr, inbox_offset)
  ctx.mir_emit_store_var("__inbox", inbox_val)

  # C.14.7: write the running actor's inbox to TLS so transitive calls to
  # `actor_self_inbox()` from inside handler bodies (and free fns reached
  # from handlers) read the correct inbox. `std/actor.qz::actor_die(reason)`
  # uses this to close its own inbox without marking it clean → supervisor
  # observes EXIT_CRASH and respawns under Permanent/Transient policy.
  # Written once per $poll entry: cross-worker resumption refreshes the
  # value (each worker writes its current actor's inbox).
  var set_self_inbox_args = vec_new()
  set_self_inbox_args.push(inbox_val)
  ctx.mir_emit_intrinsic("__actor_set_self_inbox", set_self_inbox_args)

  # Check pending_reply: if non-zero, a previous handler panicked mid-reply.
  # Close the orphaned reply channel to unblock the waiting caller.
  var pending_reply = ctx.mir_emit_load_offset(state_ptr, pending_reply_offset)
  var has_pending = ctx.mir_emit_binary(op_constants::OP_NE, pending_reply, ctx.mir_emit_const_int(0))
  var cleanup_block = ctx.mir_create_block("cleanup_reply")
  var no_cleanup_block = ctx.mir_create_block("no_cleanup")
  ctx.mir_emit_branch(has_pending, cleanup_block, no_cleanup_block)
  ctx.mir_switch_to_block(cleanup_block)
  # Phase 10: pending_reply > 0 means real reply channel; -1 means void method crash sentinel
  var pr_is_real = ctx.mir_emit_binary(op_constants::OP_GT, pending_reply, ctx.mir_emit_const_int(0))
  var close_reply_block = ctx.mir_create_block("close_reply")
  var skip_close_block = ctx.mir_create_block("skip_close")
  ctx.mir_emit_branch(pr_is_real, close_reply_block, skip_close_block)
  ctx.mir_switch_to_block(close_reply_block)
  var cleanup_close_args = vec_new()
  cleanup_close_args.push(pending_reply)
  ctx.mir_emit_intrinsic("channel_close", cleanup_close_args)
  ctx.mir_emit_jump(skip_close_block)
  ctx.mir_switch_to_block(skip_close_block)
  var clear_zero = ctx.mir_emit_const_int(0)
  ctx.mir_emit_store_offset(state_ptr, pending_reply_offset, clear_zero)
  # Phase 10: Notify links (tag -2 = crash) and monitors (tag -3 = down) after panic
  var panic_mons_bridge = ctx.mir_create_block("panic_mons")
  ctx.mir_emit_actor_notify_loop("panic_links", links_offset, -2, panic_mons_bridge)
  ctx.mir_switch_to_block(panic_mons_bridge)
  ctx.mir_emit_actor_notify_loop("panic_mons", monitors_offset, -3, no_cleanup_block)
  ctx.mir_switch_to_block(no_cleanup_block)

  # Loop block: recv from inbox
  var loop_block = ctx.mir_create_block("loop")
  ctx.mir_emit_jump(loop_block)
  ctx.mir_switch_to_block(loop_block)

  # C.14.7: at the top of every iteration, check whether the inbox has been
  # closed externally (by `actor_die()` from inside a handler, or by a raw
  # `channel_close(actor.inbox)` call). If closed, jump to crash_exit_block
  # which mirrors stop_block's cleanup but skips actor_mark_clean — so the
  # supervisor sees EXIT_CRASH rather than EXIT_NORMAL. This prevents the
  # latent SEGFAULT where recv on a closed channel returns 0 and the next
  # `load_offset(msg, 0)` derefs a null pointer.
  var inbox_loaded = ctx.mir_emit_load_var("__inbox")
  var crash_exit_block = ctx.mir_create_block("crash_exit")
  var recv_block = ctx.mir_create_block("recv_block")
  var closed_check_args = vec_new()
  closed_check_args.push(inbox_loaded)
  var inbox_is_closed = ctx.mir_emit_intrinsic("channel_closed", closed_check_args)
  ctx.mir_emit_branch(inbox_is_closed, crash_exit_block, recv_block)
  ctx.mir_switch_to_block(recv_block)

  var recv_args = vec_new()
  recv_args.push(inbox_loaded)
  var msg = ctx.mir_emit_intrinsic("recv", recv_args)
  ctx.mir_emit_store_var("__msg", msg)

  # Load message tag from msg[0]
  var tag_val = ctx.mir_emit_load_offset(msg, 0)

  # Check for stop message (tag == -1) before method dispatch
  var stop_block = ctx.mir_create_block("stop")
  var check_cascade = ctx.mir_create_block("check_cascade")
  var neg_one = ctx.mir_emit_const_int(-1)
  var is_stop = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_one)
  ctx.mir_emit_branch(is_stop, stop_block, check_cascade)

  # Phase 10: Check for link/monitor system messages before method dispatch
  # Tag -4: LINK_STOPPED (cascade stop from linked actor)
  var cascade_block = ctx.mir_create_block("cascade_stop")
  var check_link_add = ctx.mir_create_block("check_link_add")
  ctx.mir_switch_to_block(check_cascade)
  var neg_four = ctx.mir_emit_const_int(-4)
  var is_cascade = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_four)
  ctx.mir_emit_branch(is_cascade, cascade_block, check_link_add)

  # Tag -5: LINK_ADD
  var link_add_block = ctx.mir_create_block("link_add")
  var check_mon_add = ctx.mir_create_block("check_mon_add")
  ctx.mir_switch_to_block(check_link_add)
  var neg_five = ctx.mir_emit_const_int(-5)
  var is_link_add = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_five)
  ctx.mir_emit_branch(is_link_add, link_add_block, check_mon_add)

  # Tag -6: MONITOR_ADD
  var mon_add_block = ctx.mir_create_block("mon_add")
  var check_link_rm = ctx.mir_create_block("check_link_rm")
  ctx.mir_switch_to_block(check_mon_add)
  var neg_six = ctx.mir_emit_const_int(-6)
  var is_mon_add = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_six)
  ctx.mir_emit_branch(is_mon_add, mon_add_block, check_link_rm)

  # Tag -7: LINK_REMOVE
  var link_rm_block = ctx.mir_create_block("link_rm")
  var check_mon_rm = ctx.mir_create_block("check_mon_rm")
  ctx.mir_switch_to_block(check_link_rm)
  var neg_seven = ctx.mir_emit_const_int(-7)
  var is_link_rm = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_seven)
  ctx.mir_emit_branch(is_link_rm, link_rm_block, check_mon_rm)

  # Tag -8: MONITOR_REMOVE
  var mon_rm_block = ctx.mir_create_block("mon_rm")
  var check_neg = ctx.mir_create_block("check_neg")
  ctx.mir_switch_to_block(check_mon_rm)
  var neg_eight = ctx.mir_emit_const_int(-8)
  var is_mon_rm = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, neg_eight)
  ctx.mir_emit_branch(is_mon_rm, mon_rm_block, check_neg)

  # Catch-all for remaining negative tags (-2 crash, -3 down): free msg, continue
  var dispatch_block = ctx.mir_create_block("dispatch")
  var neg_msg_block = ctx.mir_create_block("neg_msg")
  ctx.mir_switch_to_block(check_neg)
  var zero_tag = ctx.mir_emit_const_int(0)
  var is_neg = ctx.mir_emit_binary(op_constants::OP_LT, tag_val, zero_tag)
  ctx.mir_emit_branch(is_neg, neg_msg_block, dispatch_block)

  # Stop block: send reply, close inbox, free message, notify links/monitors, drain, free state
  ctx.mir_switch_to_block(stop_block)
  var stop_reply_ch = ctx.mir_emit_load_offset(msg, 1)
  var stop_zero = ctx.mir_emit_const_int(0)
  var stop_send_args = vec_new()
  stop_send_args.push(stop_reply_ch)
  stop_send_args.push(stop_zero)
  ctx.mir_emit_intrinsic("send", stop_send_args)
  # Close inbox IMMEDIATELY after reply — marks actor as dead so concurrent
  # stop() calls on linked actors see channel_closed and return early,
  # preventing the cascade-stop race where LINK_STOPPED arrives before
  # the caller's stop message.
  # C.14.4: mark the inbox as a clean self-exit BEFORE close, so the
  # supervisor's death-detection (which reads via actor_check_clean) sees
  # this as a clean stop. Transient children skip restart on clean exit;
  # Permanent restarts regardless; Temporary never restarts.
  var close_inbox = ctx.mir_emit_load_var("__inbox")
  var mark_clean_args_stop = vec_new()
  mark_clean_args_stop.push(close_inbox)
  ctx.mir_emit_intrinsic("actor_mark_clean", mark_clean_args_stop)
  var close_args = vec_new()
  close_args.push(close_inbox)
  ctx.mir_emit_intrinsic("channel_close", close_args)
  # Free stop message
  var free_stop_msg_args = vec_new()
  free_stop_msg_args.push(msg)
  ctx.mir_emit_intrinsic("mem_free", free_stop_msg_args)
  # Phase 10: Notify links (tag -4 = stopped) and monitors (tag -3 = down) before cleanup
  var stop_mons_bridge = ctx.mir_create_block("stop_mons")
  var stop_cleanup_block = ctx.mir_create_block("stop_cleanup")
  ctx.mir_emit_actor_notify_loop("stop_links", links_offset, -4, stop_mons_bridge)
  ctx.mir_switch_to_block(stop_mons_bridge)
  ctx.mir_emit_actor_notify_loop("stop_mons", monitors_offset, -3, stop_cleanup_block)
  # Cleanup: drain remaining inbox messages (already closed, try_recv still returns buffered)
  ctx.mir_switch_to_block(stop_cleanup_block)
  var sdrain_check = ctx.mir_create_block("sdrain_check")
  ctx.mir_emit_jump(sdrain_check)
  ctx.mir_switch_to_block(sdrain_check)
  var sdrain_inbox = ctx.mir_emit_load_var("__inbox")
  var sdrain_opt = ctx.mir_emit_intrinsic("try_recv", [sdrain_inbox])
  var sdrain_tag = ctx.mir_emit_load_offset(sdrain_opt, 0)
  var sdrain_is_some = ctx.mir_emit_binary(op_constants::OP_EQ, sdrain_tag, ctx.mir_emit_const_int(0))
  var sdrain_body = ctx.mir_create_block("sdrain_body")
  var sdrain_done = ctx.mir_create_block("sdrain_done")
  ctx.mir_emit_branch(sdrain_is_some, sdrain_body, sdrain_done)
  ctx.mir_switch_to_block(sdrain_body)
  var sdrain_val = ctx.mir_emit_load_offset(sdrain_opt, 1)
  var sdrain_msg_tag = ctx.mir_emit_load_offset(sdrain_val, 0)
  var sdrain_is_stop = ctx.mir_emit_binary(op_constants::OP_EQ, sdrain_msg_tag, ctx.mir_emit_const_int(-1))
  var sdrain_reply = ctx.mir_create_block("sdrain_reply")
  var sdrain_free = ctx.mir_create_block("sdrain_free")
  ctx.mir_emit_branch(sdrain_is_stop, sdrain_reply, sdrain_free)
  ctx.mir_switch_to_block(sdrain_reply)
  var sdrain_reply_ch = ctx.mir_emit_load_offset(sdrain_val, 1)
  ctx.mir_emit_intrinsic("send", [sdrain_reply_ch, ctx.mir_emit_const_int(0)])
  ctx.mir_emit_jump(sdrain_free)
  ctx.mir_switch_to_block(sdrain_free)
  ctx.mir_emit_intrinsic("mem_free", [sdrain_val])
  ctx.mir_emit_jump(sdrain_check)
  # Free resources (inbox already closed above)
  ctx.mir_switch_to_block(sdrain_done)
  # Free links and monitors vecs before freeing state
  var stop_state_final = ctx.mir_emit_load_var("__actor_state")
  var stop_links_vec = ctx.mir_emit_load_offset(stop_state_final, links_offset)
  ctx.mir_emit_intrinsic("mem_free", [stop_links_vec])
  var stop_mons_vec = ctx.mir_emit_load_offset(stop_state_final, monitors_offset)
  ctx.mir_emit_intrinsic("mem_free", [stop_mons_vec])
  ctx.mir_emit_intrinsic("mem_free", [stop_state_final])
  # Phase 9: terminate $poll state machine (set state=-1, return POLL_READY=1).
  # Freestanding (B.5e.7a): no async frame — the goroutine just returns.
  if freestanding == 1
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(0))
  else
    var stop_self = ctx.mir_emit_load_var("self")
    ctx.mir_emit_store_offset(stop_self, 0, ctx.mir_emit_const_int(-1))
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(1))
  end

  # Create continue block (jump back to loop) — needed by system msg handlers below
  var continue_block = ctx.mir_create_block("continue")

  # Phase 10: Cascade stop block (tag -4 from linked actor)
  # Notify own links and monitors, then shut down
  ctx.mir_switch_to_block(cascade_block)
  var cascade_free_args = vec_new()
  var cascade_msg = ctx.mir_emit_load_var("__msg")
  cascade_free_args.push(cascade_msg)
  ctx.mir_emit_intrinsic("mem_free", cascade_free_args)
  var cascade_mons_bridge = ctx.mir_create_block("cascade_mons")
  var cascade_cleanup = ctx.mir_create_block("cascade_cleanup")
  ctx.mir_emit_actor_notify_loop("cas_links", links_offset, -4, cascade_mons_bridge)
  ctx.mir_switch_to_block(cascade_mons_bridge)
  ctx.mir_emit_actor_notify_loop("cas_mons", monitors_offset, -3, cascade_cleanup)
  # Close inbox FIRST so stop proxies racing on channel_closed see it as dead.
  # Then drain: try_recv still returns buffered messages from a closed channel.
  ctx.mir_switch_to_block(cascade_cleanup)
  var cas_inbox_early = ctx.mir_emit_load_var("__inbox")
  # C.14.4: mark cascade-stop as a clean exit. Cascade is initiated by a
  # linked actor's clean shutdown (tag -4 LINK_STOPPED); from the dying
  # actor's perspective this is normal termination, not a crash. Transient
  # children of a supervisor under cascade should NOT restart.
  var mark_clean_args_cas = vec_new()
  mark_clean_args_cas.push(cas_inbox_early)
  ctx.mir_emit_intrinsic("actor_mark_clean", mark_clean_args_cas)
  var cas_close_args = vec_new()
  cas_close_args.push(cas_inbox_early)
  ctx.mir_emit_intrinsic("channel_close", cas_close_args)

  # Drain inbox: reply to any pending stop messages (tag -1) to prevent deadlock
  var drain_check = ctx.mir_create_block("drain_check")
  ctx.mir_emit_jump(drain_check)
  ctx.mir_switch_to_block(drain_check)
  var drain_inbox = ctx.mir_emit_load_var("__inbox")
  var drain_opt = ctx.mir_emit_intrinsic("try_recv", [drain_inbox])
  var drain_tag = ctx.mir_emit_load_offset(drain_opt, 0)
  var drain_is_some = ctx.mir_emit_binary(op_constants::OP_EQ, drain_tag, ctx.mir_emit_const_int(0))
  var drain_body = ctx.mir_create_block("drain_body")
  var drain_done = ctx.mir_create_block("drain_done")
  ctx.mir_emit_branch(drain_is_some, drain_body, drain_done)

  ctx.mir_switch_to_block(drain_body)
  var drain_val = ctx.mir_emit_load_offset(drain_opt, 1)
  var drain_msg_tag = ctx.mir_emit_load_offset(drain_val, 0)
  var drain_is_stop = ctx.mir_emit_binary(op_constants::OP_EQ, drain_msg_tag, ctx.mir_emit_const_int(-1))
  var drain_reply = ctx.mir_create_block("drain_reply")
  var drain_free = ctx.mir_create_block("drain_free")
  ctx.mir_emit_branch(drain_is_stop, drain_reply, drain_free)

  ctx.mir_switch_to_block(drain_reply)
  var drain_reply_ch = ctx.mir_emit_load_offset(drain_val, 1)
  ctx.mir_emit_intrinsic("send", [drain_reply_ch, ctx.mir_emit_const_int(0)])
  ctx.mir_emit_jump(drain_free)

  ctx.mir_switch_to_block(drain_free)
  ctx.mir_emit_intrinsic("mem_free", [drain_val])
  ctx.mir_emit_jump(drain_check)

  # Free resources (inbox already closed above)
  ctx.mir_switch_to_block(drain_done)
  # Free links and monitors vecs before freeing state
  var cas_state_final = ctx.mir_emit_load_var("__actor_state")
  var cas_links_vec = ctx.mir_emit_load_offset(cas_state_final, links_offset)
  ctx.mir_emit_intrinsic("mem_free", [cas_links_vec])
  var cas_mons_vec = ctx.mir_emit_load_offset(cas_state_final, monitors_offset)
  ctx.mir_emit_intrinsic("mem_free", [cas_mons_vec])
  ctx.mir_emit_intrinsic("mem_free", [cas_state_final])
  # Phase 9: terminate $poll state machine (set state=-1, return POLL_READY=1).
  # Freestanding (B.5e.7a): no async frame — the goroutine just returns.
  if freestanding == 1
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(0))
  else
    var cas_self = ctx.mir_emit_load_var("self")
    ctx.mir_emit_store_offset(cas_self, 0, ctx.mir_emit_const_int(-1))
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(1))
  end

  # Phase 10: Link add (tag -5): push msg[1] to __links vec
  ctx.mir_switch_to_block(link_add_block)
  var la_state = ctx.mir_emit_load_var("__actor_state")
  var la_vec = ctx.mir_emit_load_offset(la_state, links_offset)
  var la_msg = ctx.mir_emit_load_var("__msg")
  var la_val = ctx.mir_emit_load_offset(la_msg, 1)
  ctx.mir_emit_intrinsic("vec_push", [la_vec, la_val])
  ctx.mir_emit_intrinsic("mem_free", [la_msg])
  ctx.mir_emit_jump(continue_block)

  # Phase 10: Monitor add (tag -6): push msg[1] to __monitors vec
  ctx.mir_switch_to_block(mon_add_block)
  var ma_state = ctx.mir_emit_load_var("__actor_state")
  var ma_vec = ctx.mir_emit_load_offset(ma_state, monitors_offset)
  var ma_msg = ctx.mir_emit_load_var("__msg")
  var ma_val = ctx.mir_emit_load_offset(ma_msg, 1)
  ctx.mir_emit_intrinsic("vec_push", [ma_vec, ma_val])
  ctx.mir_emit_intrinsic("mem_free", [ma_msg])
  ctx.mir_emit_jump(continue_block)

  # Phase 10: Link remove (tag -7): scan __links for msg[1] and remove
  ctx.mir_switch_to_block(link_rm_block)
  var lr_done = ctx.mir_create_block("link_rm_done")
  ctx.mir_emit_actor_vec_remove("lr", links_offset, lr_done)
  ctx.mir_switch_to_block(lr_done)
  var lr_msg = ctx.mir_emit_load_var("__msg")
  ctx.mir_emit_intrinsic("mem_free", [lr_msg])
  ctx.mir_emit_jump(continue_block)

  # Phase 10: Monitor remove (tag -8): scan __monitors for msg[1] and remove
  ctx.mir_switch_to_block(mon_rm_block)
  var mr_done = ctx.mir_create_block("mon_rm_done")
  ctx.mir_emit_actor_vec_remove("mr", monitors_offset, mr_done)
  ctx.mir_switch_to_block(mr_done)
  var mr_msg = ctx.mir_emit_load_var("__msg")
  ctx.mir_emit_intrinsic("mem_free", [mr_msg])
  ctx.mir_emit_jump(continue_block)

  # Phase 10: Catch-all negative tag (tag -2 crash, -3 down): free msg, continue
  ctx.mir_switch_to_block(neg_msg_block)
  var neg_msg_ref = ctx.mir_emit_load_var("__msg")
  ctx.mir_emit_intrinsic("mem_free", [neg_msg_ref])
  ctx.mir_emit_jump(continue_block)

  # Continue dispatch for method tags (>= 0)
  ctx.mir_switch_to_block(dispatch_block)

  # Dispatch chain: check tag against each method index
  var method_count = method_nodes.size
  for mi in 0..method_count
    var expected_tag = ctx.mir_emit_const_int(mi)
    var eq_result = ctx.mir_emit_binary(op_constants::OP_EQ, tag_val, expected_tag)

    var handler_block = ctx.mir_create_block("handler_#{mi}")
    var next_block = ctx.mir_create_block("next_#{mi}")
    ctx.mir_emit_branch(eq_result, handler_block, next_block)

    # === Handler block ===
    ctx.mir_switch_to_block(handler_block)

    # Save and clear break/continue targets for method body lowering.
    # Prevents loops in method bodies from accidentally targeting the poll loop.
    var saved_break = ctx.mir_ctx_get_break_target()
    var saved_continue = ctx.mir_ctx_get_continue_target()
    ctx.mir_ctx_set_break_target(0)
    ctx.mir_ctx_set_continue_target(0)

    # Phase 10: Set pending_reply to -1 (crash sentinel) at handler start.
    # If the handler panics, setjmp returns to entry and cleanup detects -1.
    var state_ld = ctx.mir_emit_load_var("__actor_state")
    var crash_sentinel = ctx.mir_emit_const_int(-1)
    ctx.mir_emit_store_offset(state_ld, pending_reply_offset, crash_sentinel)

    # Pre-load actor fields from state
    for fi in 0..field_count
      var fld_val = ctx.mir_emit_load_offset(state_ld, fi)
      ctx.mir_emit_store_var(field_names[fi], fld_val)
    end

    # Extract method parameters from message (starting at offset 1)
    var method_node = method_nodes[mi]
    var method_params = ast::ast_get_left(ast_store, method_node)
    var param_count = method_param_counts[mi]
    var method_body = ast::ast_get_right(ast_store, method_node)
    var method_ret = method_ret_types[mi]
    var is_void = method_ret == "Void" or method_ret == "void" or str_byte_len(method_ret) == 0

    # Bind method params from message payload
    for pi in 0..param_count
      var param_node = method_params[pi]
      var param_name = ast::ast_get_str1(ast_store, param_node)
      var pslot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(param_name, pslot)
      var param_val = ctx.mir_emit_load_offset(msg, 1 + pi)
      ctx.mir_emit_store_var(param_name, param_val)
    end

    # For non-void methods, the reply_ch is after the params in the message
    # Save it to state so the panic handler can close it if handler crashes
    var reply_ch_val = 0
    if is_void == false
      reply_ch_val = ctx.mir_emit_load_offset(msg, 1 + param_count)
      var save_state = ctx.mir_emit_load_var("__actor_state")
      ctx.mir_emit_store_offset(save_state, pending_reply_offset, reply_ch_val)
    end

    # Lower the method body
    if method_body >= 0
      if is_void
        ctx.mir_lower_stmt(ast_store, method_body)
      else
        # Extract the return expression from the body
        var body_kind = ast::ast_get_kind(ast_store, method_body)
        var return_expr = -1
        if body_kind == node_constants::NODE_BLOCK
          var body_children = ast::ast_get_children(ast_store, method_body)
          var bc_count = body_children.size
          if bc_count > 0
            var last_stmt = body_children[bc_count - 1]
            var last_kind = ast::ast_get_kind(ast_store, last_stmt)
            if last_kind == node_constants::NODE_RETURN
              return_expr = ast::ast_get_left(ast_store, last_stmt)
              for si in 0..(bc_count - 1)
                ctx.mir_lower_stmt(ast_store, body_children[si])
              end
            else
              ctx.mir_lower_stmt(ast_store, method_body)
            end
          end
        elsif body_kind == node_constants::NODE_RETURN
          return_expr = ast::ast_get_left(ast_store, method_body)
        else
          return_expr = method_body
        end

        # Send reply value on reply channel
        if return_expr >= 0
          var reply_val = ctx.mir_lower_expr(ast_store, return_expr)
          var send_args = vec_new()
          send_args.push(reply_ch_val)
          send_args.push(reply_val)
          ctx.mir_emit_intrinsic("send", send_args)
          # Clear pending_reply — handler succeeded, reply sent
          var clear_state = ctx.mir_emit_load_var("__actor_state")
          var clear_pr = ctx.mir_emit_const_int(0)
          ctx.mir_emit_store_offset(clear_state, pending_reply_offset, clear_pr)
        end
      end
    end

    # Restore break/continue targets
    ctx.mir_ctx_set_break_target(saved_break)
    ctx.mir_ctx_set_continue_target(saved_continue)

    # Post-store actor fields back to state
    var state_ld2 = ctx.mir_emit_load_var("__actor_state")
    for fi in 0..field_count
      var fld_after = ctx.mir_emit_load_var(field_names[fi])
      ctx.mir_emit_store_offset(state_ld2, fi, fld_after)
    end

    # Phase 10: Clear crash sentinel — handler completed successfully
    var state_clear = ctx.mir_emit_load_var("__actor_state")
    ctx.mir_emit_store_offset(state_clear, pending_reply_offset, ctx.mir_emit_const_int(0))

    # Free processed message to prevent memory leak
    var msg_to_free = ctx.mir_emit_load_var("__msg")
    var free_msg_args = vec_new()
    free_msg_args.push(msg_to_free)
    ctx.mir_emit_intrinsic("mem_free", free_msg_args)

    # Jump back to loop
    var cur_block = ctx.mir_ctx_get_block()
    if mir_block_is_terminated(cur_block) == 0
      ctx.mir_emit_jump(continue_block)
    end

    # Next check block
    ctx.mir_switch_to_block(next_block)
  end

  # After all checks: unknown tag, just continue loop
  ctx.mir_emit_jump(continue_block)

  # Continue block: jump back to loop
  ctx.mir_switch_to_block(continue_block)
  ctx.mir_emit_jump(loop_block)

  # C.14.7 — crash_exit_block: entered when the inbox is observed closed at
  # the top of loop_block (typical: `actor_die()` from inside a handler).
  # Mirrors stop_block's cleanup (notify links/mons, drain buffered messages,
  # free state, terminate state machine) but uses the CRASH tags (-2/-3)
  # and skips actor_mark_clean — leaving the supervisor to observe
  # EXIT_CRASH on its `actor_check_clean` probe.
  ctx.mir_switch_to_block(crash_exit_block)
  var crash_mons_bridge = ctx.mir_create_block("crash_mons")
  var crash_drain_check = ctx.mir_create_block("crash_drain_check")
  ctx.mir_emit_actor_notify_loop("crash_links", links_offset, -2, crash_mons_bridge)
  ctx.mir_switch_to_block(crash_mons_bridge)
  ctx.mir_emit_actor_notify_loop("crash_mons", monitors_offset, -3, crash_drain_check)
  # Drain any buffered messages (channel closed but try_recv still returns
  # buffered). Mirror sdrain_check's stop-message reply pattern so callers
  # waiting on a stop reply don't deadlock; other messages just freed.
  ctx.mir_switch_to_block(crash_drain_check)
  var crash_drain_inbox = ctx.mir_emit_load_var("__inbox")
  var crash_drain_opt = ctx.mir_emit_intrinsic("try_recv", [crash_drain_inbox])
  var crash_drain_tag = ctx.mir_emit_load_offset(crash_drain_opt, 0)
  var crash_drain_is_some = ctx.mir_emit_binary(op_constants::OP_EQ, crash_drain_tag, ctx.mir_emit_const_int(0))
  var crash_drain_body = ctx.mir_create_block("crash_drain_body")
  var crash_drain_done = ctx.mir_create_block("crash_drain_done")
  ctx.mir_emit_branch(crash_drain_is_some, crash_drain_body, crash_drain_done)
  ctx.mir_switch_to_block(crash_drain_body)
  var crash_drain_val = ctx.mir_emit_load_offset(crash_drain_opt, 1)
  var crash_drain_msg_tag = ctx.mir_emit_load_offset(crash_drain_val, 0)
  var crash_drain_is_stop = ctx.mir_emit_binary(op_constants::OP_EQ, crash_drain_msg_tag, ctx.mir_emit_const_int(-1))
  var crash_drain_reply = ctx.mir_create_block("crash_drain_reply")
  var crash_drain_free = ctx.mir_create_block("crash_drain_free")
  ctx.mir_emit_branch(crash_drain_is_stop, crash_drain_reply, crash_drain_free)
  ctx.mir_switch_to_block(crash_drain_reply)
  var crash_drain_reply_ch = ctx.mir_emit_load_offset(crash_drain_val, 1)
  ctx.mir_emit_intrinsic("send", [crash_drain_reply_ch, ctx.mir_emit_const_int(0)])
  ctx.mir_emit_jump(crash_drain_free)
  ctx.mir_switch_to_block(crash_drain_free)
  ctx.mir_emit_intrinsic("mem_free", [crash_drain_val])
  ctx.mir_emit_jump(crash_drain_check)
  # Free links + mons vecs and state. Inbox itself is already closed (that's
  # why we got here); no actor_mark_clean call — supervisor sees EXIT_CRASH.
  ctx.mir_switch_to_block(crash_drain_done)
  var crash_state_final = ctx.mir_emit_load_var("__actor_state")
  var crash_links_vec = ctx.mir_emit_load_offset(crash_state_final, links_offset)
  ctx.mir_emit_intrinsic("mem_free", [crash_links_vec])
  var crash_mons_vec = ctx.mir_emit_load_offset(crash_state_final, monitors_offset)
  ctx.mir_emit_intrinsic("mem_free", [crash_mons_vec])
  ctx.mir_emit_intrinsic("mem_free", [crash_state_final])
  # Terminate state machine: set state=-1, return POLL_READY=1.
  # Freestanding (B.5e.7a): no async frame — the goroutine just returns.
  if freestanding == 1
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(0))
  else
    var crash_self = ctx.mir_emit_load_var("self")
    ctx.mir_emit_store_offset(crash_self, 0, ctx.mir_emit_const_int(-1))
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ctx.mir_emit_const_int(1))
  end

  # B.5e.8 Stage 2 — close the freestanding panic-recovery boundary. Every body
  # path above is terminated (TERM_RETURN(0) at stop/cascade/crash; the dispatch
  # loop cycles via continue_block), so the install's `wb.done` block is reached
  # ONLY through the catch (longjmp) edge. Mirror the NODE_WITH terminated-body
  # path (mir_lower.qz ~4030): pop the lexical handler/wrap, switch to a fresh
  # block, emit DONE_ONLY (renders just `wb.done.NN:` + the runtime pop — no body
  # fall-through prefix), then jump back to `actor_reenter` to re-install + re-run
  # the prologue. The pop here balances the reinstall there.
  if freestanding == 1
    ctx.mir_ctx_pop_wrap()
    ctx.mir_ctx_pop_handler_entries(1)
    var fs_done_block = ctx.mir_create_block("actor_wb_done")
    ctx.mir_switch_to_block(fs_done_block)
    ctx.mir_emit_handle_uninstall_done_only("Throws", fs_install_dest, 1)
    ctx.mir_emit_jump(fs_reenter_block)
  end

end

## Generate proxy method bodies
## Each proxy: constructs a message, sends to inbox, optionally waits for reply
def mir_lower_actor_proxies(ctx: MirContext, actor_name: String, method_nodes: Vec<Int>, method_names: Vec<String>, method_ret_types: Vec<String>, method_param_counts: Vec<Int>, ast_store: ast::AstStorage): Void
  var method_count = method_nodes.size
  for mi in 0..method_count
    ctx.mir_actor_reset_func_state()

    var method_name = method_names[mi]
    var method_ret = method_ret_types[mi]
    var param_count = method_param_counts[mi]
    var is_void = method_ret == "Void" or method_ret == "void" or str_byte_len(method_ret) == 0

    var proxy_name = string_intern::mangle(actor_name, method_name)
    var ret_type = mir::MIR_TYPE_INT
    if is_void
      ret_type = mir::MIR_TYPE_INT
    end

    var prog = ctx.mir_ctx_get_program()
    var func = mir_new_function(proxy_name, ret_type)
    mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(ast_store))
    mir_get_functions(prog).push(func)
    ctx.mir_ctx_set_func(func)
    _actor_generated_funcs.push(proxy_name)

    # Parameter: self (inbox channel handle)
    mir_func_add_param(func, "self", mir::MIR_TYPE_INT)
    var self_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var("self", self_slot)

    # Additional parameters from the original method
    var method_node = method_nodes[mi]
    var method_params = ast::ast_get_left(ast_store, method_node)
    var param_names = vec_new<String>()
    for pi in 0..param_count
      var param_node = method_params[pi]
      var pname = ast::ast_get_str1(ast_store, param_node)
      param_names.push(pname)
      mir_func_add_param(func, pname, mir::MIR_TYPE_INT)
      var pslot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var(pname, pslot)
    end

    var entry_block = ctx.mir_create_block("entry")
    ctx.mir_switch_to_block(entry_block)

    # Check if actor is stopped (inbox channel closed) — prevents deadlock
    var self_check = ctx.mir_emit_load_var("self")
    var closed_args = vec_new()
    closed_args.push(self_check)
    var is_closed = ctx.mir_emit_intrinsic("channel_closed", closed_args)
    var live_block = ctx.mir_create_block("live")
    var dead_block = ctx.mir_create_block("dead")
    ctx.mir_emit_branch(is_closed, dead_block, live_block)
    # Dead block: actor stopped, return 0 immediately (Go-style zero-value semantics)
    ctx.mir_switch_to_block(dead_block)
    var dead_zero = ctx.mir_emit_const_int(0)
    mir_block_set_terminator(dead_block, mir::TERM_RETURN, dead_zero)
    # Live block: actor running, proceed with message send
    ctx.mir_switch_to_block(live_block)

    # Allocate message: [tag, param1, ..., paramN, (reply_ch if non-void)]
    var msg_words = 1 + param_count
    if is_void == false
      msg_words += 1
    end
    var msg_alloc = ctx.mir_emit_alloc(msg_words)

    # Store tag
    var tag_val = ctx.mir_emit_const_int(mi)
    ctx.mir_emit_store_offset(msg_alloc, 0, tag_val)

    # Store params
    for pi in 0..param_count
      var p_val = ctx.mir_emit_load_var(param_names[pi])
      ctx.mir_emit_store_offset(msg_alloc, 1 + pi, p_val)
    end

    # For non-void: create reply channel and store in message
    var reply_ch = 0
    if is_void == false
      var reply_cap = ctx.mir_emit_const_int(1)
      var reply_args = vec_new()
      reply_args.push(reply_cap)
      reply_ch = ctx.mir_emit_intrinsic("channel_new", reply_args)
      ctx.mir_emit_store_offset(msg_alloc, 1 + param_count, reply_ch)
    end

    # Send message to inbox (self)
    var self_val = ctx.mir_emit_load_var("self")
    var send_args = vec_new()
    send_args.push(self_val)
    send_args.push(msg_alloc)
    ctx.mir_emit_intrinsic("send", send_args)

    # For non-void: recv reply, close reply channel, return
    var block = ctx.mir_ctx_get_block()
    if is_void
      var void_ret = ctx.mir_emit_const_int(0)
      mir_block_set_terminator(block, mir::TERM_RETURN, void_ret)
    else
      var recv_args = vec_new()
      recv_args.push(reply_ch)
      var reply_val = ctx.mir_emit_intrinsic("recv", recv_args)
      # Close reply channel to prevent resource leak
      var close_reply_args = vec_new()
      close_reply_args.push(reply_ch)
      ctx.mir_emit_intrinsic("channel_close", close_reply_args)
      mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, reply_val)
    end
  end
end

## Generate async proxy variants for non-void methods
## Returns the reply channel handle instead of blocking — enables select integration.
## e.g., Counter$get_count_async(self) -> Int (reply channel handle)
def mir_lower_actor_async_proxies(ctx: MirContext, actor_name: String, method_nodes: Vec<Int>, method_names: Vec<String>, method_ret_types: Vec<String>, method_param_counts: Vec<Int>, ast_store: ast::AstStorage): Void
  var method_count = method_nodes.size
  for mi in 0..method_count
    var method_ret = method_ret_types[mi]
    var is_void = method_ret == "Void" or method_ret == "void" or str_byte_len(method_ret) == 0
    if is_void
      # Void methods don't have reply channels — no async variant needed
    else
      ctx.mir_actor_reset_func_state()

      var method_name = method_names[mi]
      var param_count = method_param_counts[mi]
      var async_name = string_intern::mangle(actor_name, "#{method_name}_async")

      var prog = ctx.mir_ctx_get_program()
      var func = mir_new_function(async_name, mir::MIR_TYPE_INT)
      mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(ast_store))
      mir_get_functions(prog).push(func)
      ctx.mir_ctx_set_func(func)
      _actor_generated_funcs.push(async_name)

      mir_func_add_param(func, "self", mir::MIR_TYPE_INT)
      var self_slot = ctx.mir_ctx_alloc_slot()
      ctx.mir_ctx_bind_var("self", self_slot)

      var method_node = method_nodes[mi]
      var method_params = ast::ast_get_left(ast_store, method_node)
      var param_names = vec_new<String>()
      for pi in 0..param_count
        var param_node = method_params[pi]
        var pname = ast::ast_get_str1(ast_store, param_node)
        param_names.push(pname)
        mir_func_add_param(func, pname, mir::MIR_TYPE_INT)
        var pslot = ctx.mir_ctx_alloc_slot()
        ctx.mir_ctx_bind_var(pname, pslot)
      end

      var entry_block = ctx.mir_create_block("entry")
      ctx.mir_switch_to_block(entry_block)

      # Check if actor is stopped
      var self_check = ctx.mir_emit_load_var("self")
      var closed_args = vec_new()
      closed_args.push(self_check)
      var is_closed = ctx.mir_emit_intrinsic("channel_closed", closed_args)
      var live_block = ctx.mir_create_block("live")
      var dead_block = ctx.mir_create_block("dead")
      ctx.mir_emit_branch(is_closed, dead_block, live_block)
      ctx.mir_switch_to_block(dead_block)
      var dead_zero = ctx.mir_emit_const_int(0)
      mir_block_set_terminator(dead_block, mir::TERM_RETURN, dead_zero)
      ctx.mir_switch_to_block(live_block)

      # Allocate message: [tag, params..., reply_ch]
      var msg_words = 1 + param_count + 1
      var msg_alloc = ctx.mir_emit_alloc(msg_words)
      var tag_val = ctx.mir_emit_const_int(mi)
      ctx.mir_emit_store_offset(msg_alloc, 0, tag_val)
      for pi in 0..param_count
        var p_val = ctx.mir_emit_load_var(param_names[pi])
        ctx.mir_emit_store_offset(msg_alloc, 1 + pi, p_val)
      end

      # Create reply channel
      var reply_cap = ctx.mir_emit_const_int(1)
      var reply_args = vec_new()
      reply_args.push(reply_cap)
      var reply_ch = ctx.mir_emit_intrinsic("channel_new", reply_args)
      ctx.mir_emit_store_offset(msg_alloc, 1 + param_count, reply_ch)

      # Send message — but do NOT recv. Return the reply channel handle.
      var self_val = ctx.mir_emit_load_var("self")
      var send_args = vec_new()
      send_args.push(self_val)
      send_args.push(msg_alloc)
      ctx.mir_emit_intrinsic("send", send_args)

      # Return reply channel handle — caller uses recv() or select on it
      mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, reply_ch)
    end
  end
end

## Generate stop proxy: ActorName$stop(self) -> Int
## Sends tag=-1 stop message with reply channel, blocks until actor confirms shutdown.
def mir_lower_actor_stop(ctx: MirContext, ast_store: ast::AstStorage, actor_name: String): Void
  ctx.mir_actor_reset_func_state()

  var stop_name = string_intern::mangle(actor_name, "stop")
  var prog = ctx.mir_ctx_get_program()
  var func = mir_new_function(stop_name, mir::MIR_TYPE_INT)
  mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(ast_store))
  mir_get_functions(prog).push(func)
  ctx.mir_ctx_set_func(func)
  _actor_generated_funcs.push(stop_name)

  # Parameter: self (inbox channel handle)
  mir_func_add_param(func, "self", mir::MIR_TYPE_INT)
  var self_slot = ctx.mir_ctx_alloc_slot()
  ctx.mir_ctx_bind_var("self", self_slot)

  var entry_block = ctx.mir_create_block("entry")
  ctx.mir_switch_to_block(entry_block)

  # Check if actor is already stopped (idempotent stop)
  var stop_self_check = ctx.mir_emit_load_var("self")
  var stop_closed_args = vec_new()
  stop_closed_args.push(stop_self_check)
  var stop_is_closed = ctx.mir_emit_intrinsic("channel_closed", stop_closed_args)
  var stop_live_block = ctx.mir_create_block("live")
  var stop_dead_block = ctx.mir_create_block("dead")
  ctx.mir_emit_branch(stop_is_closed, stop_dead_block, stop_live_block)
  ctx.mir_switch_to_block(stop_dead_block)
  var stop_dead_zero = ctx.mir_emit_const_int(0)
  mir_block_set_terminator(stop_dead_block, mir::TERM_RETURN, stop_dead_zero)
  ctx.mir_switch_to_block(stop_live_block)

  # Allocate message: [tag=-1, reply_ch]
  var msg_alloc = ctx.mir_emit_alloc(2)
  var neg_one = ctx.mir_emit_const_int(-1)
  ctx.mir_emit_store_offset(msg_alloc, 0, neg_one)

  # Create reply channel
  var one = ctx.mir_emit_const_int(1)
  var reply_args = vec_new()
  reply_args.push(one)
  var reply_ch = ctx.mir_emit_intrinsic("channel_new", reply_args)
  ctx.mir_emit_store_offset(msg_alloc, 1, reply_ch)

  # Send stop message to inbox
  var self_val = ctx.mir_emit_load_var("self")
  var send_args = vec_new()
  send_args.push(self_val)
  send_args.push(msg_alloc)
  ctx.mir_emit_intrinsic("send", send_args)

  # Wait for actor to confirm shutdown.
  # Use try_recv_or_closed loop with inbox-closed fallback to handle
  # cascade-stop race: if a linked actor stops this actor via LINK_STOPPED
  # between our channel_closed check and recv, the actor cascade-stops
  # and closes inbox without replying. Blocking recv would hang forever.
  var poll_loop = ctx.mir_create_block("stop_poll")
  var poll_got = ctx.mir_create_block("stop_got")
  var poll_empty = ctx.mir_create_block("stop_empty")
  var poll_done = ctx.mir_create_block("stop_done")
  ctx.mir_emit_jump(poll_loop)

  ctx.mir_switch_to_block(poll_loop)
  var try_recv_args = vec_new()
  try_recv_args.push(reply_ch)
  var try_result = ctx.mir_emit_intrinsic("try_recv_or_closed", try_recv_args)
  var got_reply = ctx.mir_emit_binary(op_constants::OP_GT, try_result, ctx.mir_emit_const_int(0))
  ctx.mir_emit_branch(got_reply, poll_got, poll_empty)

  ctx.mir_switch_to_block(poll_got)
  var got_val = ctx.mir_emit_intrinsic("option_get", [try_result])
  ctx.mir_emit_intrinsic("option_free", [try_result])
  ctx.mir_emit_jump(poll_done)

  ctx.mir_switch_to_block(poll_empty)
  ctx.mir_emit_intrinsic("option_free", [try_result])
  # Check if inbox is closed (actor cascade-stopped) — if so, stop waiting
  var inbox_recheck = ctx.mir_emit_load_var("self")
  var inbox_closed_args = vec_new()
  inbox_closed_args.push(inbox_recheck)
  var inbox_now_closed = ctx.mir_emit_intrinsic("channel_closed", inbox_closed_args)
  var cascade_exit = ctx.mir_create_block("stop_cascade_exit")
  var poll_yield = ctx.mir_create_block("stop_yield")
  ctx.mir_emit_branch(inbox_now_closed, cascade_exit, poll_yield)

  ctx.mir_switch_to_block(cascade_exit)
  ctx.mir_emit_jump(poll_done)

  ctx.mir_switch_to_block(poll_yield)
  ctx.mir_emit_intrinsic("sched_yield", vec_new())
  ctx.mir_emit_jump(poll_loop)

  ctx.mir_switch_to_block(poll_done)
  var close_stop_reply = vec_new()
  close_stop_reply.push(reply_ch)
  ctx.mir_emit_intrinsic("channel_close", close_stop_reply)

  var ret_zero = ctx.mir_emit_const_int(0)
  var block = ctx.mir_ctx_get_block()
  mir_block_set_terminator(block, mir::TERM_RETURN, ret_zero)
end

## Generate link/unlink/monitor/demonitor proxy functions (Phase 10)
## link(self, other): send tag -5 to both self and other (bidirectional)
## unlink(self, other): send tag -7 to both
## monitor(self, target): send tag -6 to target with self as watcher
## demonitor(self, target): send tag -8 to target with self
def mir_lower_actor_link_proxies(ctx: MirContext, ast_store: ast::AstStorage, actor_name: String, field_count: Int): Void
  # Helper: generate a proxy that sends a tag to one or two actors
  # mode 0 = send to both (link/unlink), mode 1 = send to target only (monitor/demonitor)
  var names: Vec<String> = ["link", "unlink", "monitor", "demonitor"]
  var tags = [-5, -7, -6, -8]
  var modes = [0, 0, 1, 1]

  for pi in 0..4
    ctx.mir_actor_reset_func_state()
    var proxy_name = string_intern::mangle(actor_name, names[pi])
    var prog = ctx.mir_ctx_get_program()
    var func = mir_new_function(proxy_name, mir::MIR_TYPE_INT)
    mir::mir_func_set_origin_module(func, dep_graph::depgraph_name_for_ast_store(ast_store))
    mir_get_functions(prog).push(func)
    ctx.mir_ctx_set_func(func)
    _actor_generated_funcs.push(proxy_name)

    # Parameters: self (inbox handle), other/target (inbox handle)
    mir_func_add_param(func, "self", mir::MIR_TYPE_INT)
    var self_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var("self", self_slot)
    var other_name = "other"
    if modes[pi] == 1
      other_name = "target"
    end
    mir_func_add_param(func, other_name, mir::MIR_TYPE_INT)
    var other_slot = ctx.mir_ctx_alloc_slot()
    ctx.mir_ctx_bind_var(other_name, other_slot)

    var entry = ctx.mir_create_block("entry")
    ctx.mir_switch_to_block(entry)
    var tag_val = ctx.mir_emit_const_int(tags[pi])
    var self_val = ctx.mir_emit_load_var("self")
    var other_val = ctx.mir_emit_load_var(other_name)

    if modes[pi] == 0
      # Bidirectional: send to self (with other as payload) AND to other (with self as payload)
      var msg1 = ctx.mir_emit_alloc(2)
      ctx.mir_emit_store_offset(msg1, 0, tag_val)
      ctx.mir_emit_store_offset(msg1, 1, other_val)
      ctx.mir_emit_intrinsic("send", [self_val, msg1])

      var msg2 = ctx.mir_emit_alloc(2)
      ctx.mir_emit_store_offset(msg2, 0, tag_val)
      ctx.mir_emit_store_offset(msg2, 1, self_val)
      ctx.mir_emit_intrinsic("send", [other_val, msg2])
    else
      # Unidirectional: send to target (with self as watcher payload)
      var msg1 = ctx.mir_emit_alloc(2)
      ctx.mir_emit_store_offset(msg1, 0, tag_val)
      ctx.mir_emit_store_offset(msg1, 1, self_val)
      ctx.mir_emit_intrinsic("send", [other_val, msg1])
    end

    var ret_zero = ctx.mir_emit_const_int(0)
    mir_block_set_terminator(ctx.mir_ctx_get_block(), mir::TERM_RETURN, ret_zero)
  end
end

# Context is appended at the end of prog after MIR lowering (index 6)
def mir_get_context_from_prog(prog: Vec): Int = prog[6]
# Scans ALL handles in the AST looking for NodeEnumDef (kind 38)
# Also tracks whether each enum has any payload variants (for representation decision)
# module_prefix: If non-empty, prefixes enum names with "module_prefix$" (for imported modules)
def mir_collect_enums(ast_store: ast::AstStorage, enum_names: Vec<String>, enum_variants: Vec, enum_variant_field_types: Vec, enum_has_payloads: Vec<Int>, module_prefix: String): Int
  # Get the kinds vector - its length tells us how many nodes exist
  var kinds = ast_store.kinds
  var num_nodes = kinds.size

  # Scan all handles looking for enum definitions
  for i in 0..num_nodes
    var kind = ast::ast_get_kind(ast_store, i)

    if kind == node_constants::NODE_ENUM_DEF
      # NodeEnumDef: extract name and variants
      var base_enum_name = ast::ast_get_str1(ast_store, i)

      # Apply module prefix if provided (for imported modules)
      var enum_name = base_enum_name
      if str_byte_len(module_prefix) > 0
        enum_name = "#{module_prefix}$"
        enum_name = "#{enum_name}#{base_enum_name}"
      end

      enum_names.push(enum_name)

      # A.45: record the enum's declared type parameters ("<T>", "<T, E>") under
      # the bare name (matching how type annotations are written, e.g.
      # `Option<SF>`) so extend-method generic-return inference can bind them.
      # `enum Option<T> def unwrap(): T` returns Option<T>'s `T`, which lives on
      # the enum decl, not the method — without this the receiver type is lost
      # and field access on the result falls to the global name table.
      var enum_tparams = ast::ast_get_str2(ast_store, i)
      if str_byte_len(enum_tparams) > 0
        mir::mir_set_struct_type_params(base_enum_name, enum_tparams)
      end

      # Get variants vector from slot 10 (via ast_get_children which reads slot 10)
      var variants_vec = ast::ast_get_children(ast_store, i)
      var variant_names = vec_new<String>()
      var per_variant_types = vec_new()
      var has_payload = 0

      if variants_vec > 0
        for vi in 0..variants_vec.size
          variant_names.push(ast::ast_get_str1(ast_store, variants_vec[vi]))
        end
        # Walk each variant's fields once to capture both payload-presence
        # and per-field type annotations (used to prime string_var tracking
        # for match-pattern bindings, etc).
        for j in 0..variants_vec.size
          var variant_node = variants_vec[j]
          var variant_kind = ast::ast_get_kind(ast_store, variant_node)
          var field_types = vec_new<String>()
          if variant_kind == node_constants::NODE_VARIANT_DEF
            var fields = ast_store.children[variant_node]
            if fields > 0
              var num_fields = vec_size(fields)
              if num_fields > 0
                has_payload = 1
                for fi in 0..num_fields
                  var field_node = fields[fi]
                  field_types.push(ast::ast_get_str2(ast_store, field_node))
                end
              end
            end
          end
          per_variant_types.push(field_types)
        end
      end

      enum_variants.push(variant_names)
      enum_variant_field_types.push(per_variant_types)
      enum_has_payloads.push(has_payload)
    end
  end
  return 0
end

# Collect binary-DSL layouts (NODE_BINARY_BLOCK=93, NODE_PACKED_STRUCT=94)
# from an AST storage and register each with the MIR program. Sub-phase
# 1.3 of the binary DSL (see docs/design/BINARY_DSL.md): the registry
# is consumed by codegen stubs today and by real codegen in 1.4.
def mir_collect_binary_layouts(ctx: MirContext, ast_store: ast::AstStorage): Void
  var kinds = ast_store.kinds
  var num_nodes = kinds.size
  var prog = ctx.program
  for i in 0..num_nodes
    var kind = ast::ast_get_kind(ast_store, i)
    if kind == node_constants::NODE_BINARY_BLOCK or kind == node_constants::NODE_PACKED_STRUCT
      var name = ast::ast_get_str1(ast_store, i)
      # If already registered (multi-module compile), skip the second import.
      if mir_find_binary_layout(prog, name) >= 0
        continue
      end
      var layout_kind = 0
      if kind == node_constants::NODE_BINARY_BLOCK
        layout_kind = 1
      else
        layout_kind = 2
      end
      var backing = 0
      if layout_kind == 2
        backing = ast::ast_get_int_val(ast_store, i)
      end
      var field_names = vec_new<String>()
      var field_specs = vec_new<String>()
      var field_widths = vec_new()
      var field_compute_asts = vec_new()
      # Phase 2 Track B — one union per layout in v1. When we encounter a
      # NODE_BINARY_UNION child we strip it from the flat field list and
      # collect its metadata into these parallel arrays, then register via
      # mir_register_binary_union after the main layout is in place.
      var union_disc = ""
      var union_arm_tags = vec_new<Int>()
      var union_arm_field_names = vec_new<String>()
      var union_arm_field_specs = vec_new<String>()
      var union_arm_field_widths = vec_new<Int>()
      var union_arm_field_start = vec_new<Int>()
      var union_arm_field_count = vec_new<Int>()
      var field_children = ast::ast_get_children(ast_store, i)
      if field_children != 0
        for fi in 0..field_children.size
          var fnode = field_children[fi]
          var fnode_kind = ast::ast_get_kind(ast_store, fnode)
          if fnode_kind == node_constants::NODE_BINARY_UNION
            union_disc = ast::ast_get_str1(ast_store, fnode)
            var arms = ast::ast_get_children(ast_store, fnode)
            if arms != 0
              for ai in 0..arms.size
                var arm = arms[ai]
                union_arm_tags.push(ast::ast_get_int_val(ast_store, arm))
                var arm_fields = ast::ast_get_children(ast_store, arm)
                var start = union_arm_field_names.size
                var count = 0
                if arm_fields != 0
                  for afi in 0..arm_fields.size
                    var af = arm_fields[afi]
                    union_arm_field_names.push(ast::ast_get_str1(ast_store, af))
                    union_arm_field_specs.push(ast::ast_get_str2(ast_store, af))
                    union_arm_field_widths.push(ast::ast_get_int_val(ast_store, af))
                    count = count + 1
                  end
                end
                union_arm_field_start.push(start)
                union_arm_field_count.push(count)
              end
            end
            continue
          end
          field_names.push(ast::ast_get_str1(ast_store, fnode))
          field_specs.push(ast::ast_get_str2(ast_store, fnode))
          field_widths.push(ast::ast_get_int_val(ast_store, fnode))
          # Phase 2 Track A: `extras` holds the computed expression AST handle
          # when present (set by ps_parse_binary_block_field), else 0.
          field_compute_asts.push(ast::ast_get_extra(ast_store, fnode))
        end
      end
      var layout_id = mir_register_binary_layout(prog, name, layout_kind, backing, field_names, field_specs, field_widths, field_compute_asts)
      # Phase 2 Track B — attach union metadata if present. The discriminator
      # must resolve to a flat field index in the main layout; typecheck
      # QZ0954 guarantees it does.
      if str_byte_len(union_disc) > 0
        var disc_idx = -1
        var nn = field_names.size
        for fi in 0..nn
          if field_names[fi].eq(union_disc)
            disc_idx = fi
          end
        end
        mir_register_binary_union(prog, layout_id, disc_idx, union_arm_tags, union_arm_field_names, union_arm_field_specs, union_arm_field_widths, union_arm_field_start, union_arm_field_count)
      end
    end
  end
end

## Mirror of typecheck::_tc_bin_parse_numeric_width for MIR registration.
## Returns packed width*2+is_float, 0 if spec is not a numeric primitive.
def _mir_bin_parse_numeric_width(spec: String): Int
  var n = str_byte_len(spec)
  return 0 if n < 2
  var head = str_byte_at(spec, 0)
  var is_float = 0
  if head == 117 or head == 105
    is_float = 0
  elsif head == 102
    is_float = 1
  else
    return 0
  end
  var i = 1
  var width = 0
  var saw_digit = 0
  while i < n
    var d = str_byte_at(spec, i)
    if d < 48 or d > 57
      break
    end
    width = (width * 10) + (d - 48)
    saw_digit = 1
    i = i + 1
  end
  return 0 if saw_digit == 0
  if i == n
    return width * 2 + is_float
  end
  if i + 2 != n
    return 0
  end
  var s1 = str_byte_at(spec, i)
  var s2 = str_byte_at(spec, i + 1)
  if (s1 == 108 and s2 == 101) or (s1 == 98 and s2 == 101)
    return width * 2 + is_float
  end
  return 0
end

## Runtime annotation for a binary field spec. Mirrors typecheck's
## _tc_bin_field_annotation so MIR struct-registry field types match
## what typecheck sees, enabling `.size`/`.len`/etc. member resolution
## on non-primitive binary fields (e.g. Vec<Int> arrays, String pstrings).
def _mir_bin_field_annotation(spec: String): String
  var n = str_byte_len(spec)
  return "Int" if n == 0
  var packed = _mir_bin_parse_numeric_width(spec)
  if packed > 0
    var is_float = packed % 2
    var width = packed / 2
    if is_float == 1
      return "F32" if width == 32
      return "F64" if width == 64
      return "Int"
    end
    return "Int"
  end
  return "String" if spec == "cstring"
  if n >= 7
    if str_byte_slice(spec, 0, 7).eq("pstring")
      return "String"
    end
  end
  return "Bytes" if spec == "bytes"
  if n >= 6
    if str_byte_slice(spec, 0, 6).eq("bytes(")
      return "Bytes"
    end
  end
  if n >= 3 and str_byte_at(spec, 0) == 91
    var end_idx = 1
    while end_idx < n
      var ch = str_byte_at(spec, end_idx)
      if ch == 59 or ch == 93
        break
      end
      end_idx = end_idx + 1
    end
    if end_idx > 1
      var elem = str_byte_slice(spec, 1, end_idx)
      var elem_packed = _mir_bin_parse_numeric_width(elem)
      if elem_packed > 0 and (elem_packed % 2) == 0
        return "Vec<Int>"
      end
    end
  end
  return "Int"
end

# Collect struct definitions from an AST storage
# Scans ALL handles looking for NodeStructDef (kind 36)
# Registers struct name -> field names mapping in context
def mir_collect_structs(ctx: MirContext, ast_store: ast::AstStorage): Void
  var kinds = ast_store.kinds
  var num_nodes = kinds.size
  
  for i in 0..num_nodes
    var kind = ast::ast_get_kind(ast_store, i)
    if kind == node_constants::NODE_STRUCT_DEF
      # NodeStructDef (kind 36): slot 4 = name, slot 10 = fields
      var struct_name = ast::ast_get_str1(ast_store, i)
      
      var fields_vec = ast::ast_get_children(ast_store, i)
      var field_names = vec_new<String>()
      var field_types = vec_new<String>()
      var field_defaults = vec_new()

      if fields_vec > 0
        for j in 0..fields_vec.size
          var field_node = fields_vec[j]
          # NodeFieldDef (kind 37): slot 4 = name, slot 5 = type
          var field_name = ast::ast_get_str1(ast_store, field_node)
          var field_type = ast::ast_get_str2(ast_store, field_node)
          field_names.push(field_name)
          field_types.push(field_type)
          # Extract default value AST node handle (0 = no default)
          var default_val = ast::ast_field_default(ast_store, field_node)
          field_defaults.push(default_val)
        end
      end
      
      var repr_c = ast::ast_struct_get_repr_c(ast_store, i)
      var packed = ast::ast_get_extra(ast_store, i)
      var is_value = ast::ast_struct_is_value(ast_store, i)
      ctx.mir_ctx_register_struct(struct_name, field_names, field_types, repr_c, packed, is_value, field_defaults, ast_store)

      # A.36: remember the struct's declared type parameters ("<I>", "<S, M>")
      # so generic-struct extend-method monomorphization can align a concrete
      # instantiation's type args with the field types written against them.
      var struct_tparams = ast::ast_get_str2(ast_store, i)
      if str_byte_len(struct_tparams) > 0
        mir::mir_set_struct_type_params(struct_name, struct_tparams)
      end

      # SYS.1 item 4 — propagate @align(N) from AST to MIR's per-name
      # struct-alignment registry. Codegen reads this when emitting the
      # alloca for non-escaped @value instances of this struct.
      var struct_align = ast::ast_struct_get_align(ast_store, i)
      if struct_align > 0
        mir::mir_set_struct_align(struct_name, struct_align)
      end
    end
    # Binary DSL blocks and packed structs register as struct-like types so
    # regular field access (`.field`) and struct-literal construction resolve.
    # Pad fields (`_`) are skipped — they're layout placeholders, not fields.
    if kind == node_constants::NODE_BINARY_BLOCK or kind == node_constants::NODE_PACKED_STRUCT
      var dsl_name = ast::ast_get_str1(ast_store, i)
      var dsl_fields = ast::ast_get_children(ast_store, i)
      var dsl_field_names = vec_new<String>()
      var dsl_field_types = vec_new<String>()
      var dsl_field_defaults = vec_new()
      if dsl_fields > 0
        for j in 0..dsl_fields.size
          var dsl_fn = dsl_fields[j]
          var dsl_fn_kind = ast::ast_get_kind(ast_store, dsl_fn)
          if dsl_fn_kind == node_constants::NODE_BINARY_UNION
            # Phase 2 Track B: flatten every arm's fields into the outer
            # struct, deduped by name (matches typecheck's v1 flat-union
            # registration). Different wire specs under the same name are
            # a typecheck error (QZ0957) and never reach here in practice.
            var arms = ast::ast_get_children(ast_store, dsl_fn)
            if arms > 0
              for aj in 0..arms.size
                var arm = arms[aj]
                var arm_fields = ast::ast_get_children(ast_store, arm)
                if arm_fields > 0
                  for afj in 0..arm_fields.size
                    var af = arm_fields[afj]
                    var afname = ast::ast_get_str1(ast_store, af)
                    if str_byte_len(afname) == 0 or afname.eq("_")
                      continue
                    end
                    var already = 0
                    var dn = dsl_field_names.size
                    for dx in 0..dn
                      if dsl_field_names[dx].eq(afname)
                        already = 1
                      end
                    end
                    if already == 1
                      continue
                    end
                    dsl_field_names.push(afname)
                    var aspec = ast::ast_get_str2(ast_store, af)
                    dsl_field_types.push(_mir_bin_field_annotation(aspec))
                    dsl_field_defaults.push(0)
                  end
                end
              end
            end
            continue
          end
          var dsl_fname = ast::ast_get_str1(ast_store, dsl_fn)
          if str_byte_len(dsl_fname) == 0 or dsl_fname.eq("_")
            continue
          end
          dsl_field_names.push(dsl_fname)
          # Binary blocks: derive the runtime annotation from the field spec
          # so member access (`.size`, etc.) on non-primitive fields resolves
          # via the struct registry. Packed structs have only numeric specs,
          # so the helper falls back to "Int" for them.
          if kind == node_constants::NODE_BINARY_BLOCK
            var dsl_spec = ast::ast_get_str2(ast_store, dsl_fn)
            dsl_field_types.push(_mir_bin_field_annotation(dsl_spec))
          else
            dsl_field_types.push("Int")
          end
          dsl_field_defaults.push(0)
        end
      end
      ctx.mir_ctx_register_struct(dsl_name, dsl_field_names, dsl_field_types, 0, 0, 0, dsl_field_defaults, ast_store)
    end
  end
end


def main(): Int = 0
