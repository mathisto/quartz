##! # Concurrency Intrinsics — Dispatcher
##!
##! Thin dispatcher for concurrency intrinsics. Delegates to sub-handlers:
##!   - conc_task: parallel, atomics, task groups, cancel tokens
##!   - conc_sync: channel/mutex free, rwlock, waitgroup, oncecell
##!   - conc_channel: channel creation, send, recv, close, metrics
##!   - conc_channel_try: try_send, try_recv, try_recv_or_closed
##!   - conc_sched: mutex, io_suspend, future_poll, scheduler, completion, task_local
##!   - conc_async: async_mutex, async_rwlock
##!
##! @see codegen_intrinsics Main intrinsic dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import cg_intrinsic_conc_task
import cg_intrinsic_conc_sync
import cg_intrinsic_conc_channel
import cg_intrinsic_conc_channel_try
import cg_intrinsic_conc_sched
import cg_intrinsic_conc_async
import * from str_compat

def cg_emit_intrinsic_concurrency(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Void can Emit
  if cg_intrinsic_conc_task::cg_emit_conc_task(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
  if cg_intrinsic_conc_sync::cg_emit_conc_sync(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
  if cg_intrinsic_conc_channel::cg_emit_conc_channel(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
  if cg_intrinsic_conc_channel_try::cg_emit_conc_channel_try(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
  if cg_intrinsic_conc_sched::cg_emit_conc_sched(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
  if cg_intrinsic_conc_async::cg_emit_conc_async(state, out, prog, instr, dest, name, args, argc, d, _elem_type) == 1
    return
  end
end
