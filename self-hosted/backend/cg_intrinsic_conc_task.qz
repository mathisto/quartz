    codegen_util::cg_emit_line(out, ".hdr, i64 2")
    codegen_util::cg_emit(out, "  store i64 %tc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data.i, ptr %tc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".dp")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %tc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec to i64")
    return 1
  end

  if name == "taskgroup_cancel"
    var grp = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; taskgroup_cancel")
    codegen_util::cg_emit(out, "  %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".grp = inttoptr i64 %v")
    codegen_util::cg_emit(out, grp)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".gep = getelementptr i8, ptr %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".grp, i64 32")
    codegen_util::cg_emit(out, "  %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = bitcast ptr %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".gep to ptr")
    codegen_util::cg_emit(out, "  store atomic i64 1, ptr %tcancel")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "is_cancelled"
    codegen_util::cg_emit_line(out, "  ; is_cancelled")
    codegen_util::cg_emit(out, "  %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw = call ptr @__qz_cancel_get()")
    codegen_util::cg_emit(out, "  %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".null = icmp eq ptr %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw, null")
    codegen_util::cg_emit(out, "  br i1 %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".null, label %ic_no_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ", label %ic_check_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ic_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pp = bitcast ptr %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw to ptr")
    codegen_util::cg_emit(out, "  %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load atomic i64, ptr %ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".pp seq_cst, align 8")
    codegen_util::cg_emit(out, "  br label %ic_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ic_no_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  br label %ic_done_")
    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ic_done_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%ic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val, %ic_check_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, "], [0, %ic_no_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, "]")
    return 1
  end

  # Cancel token intrinsics — standalone atomic i64 tokens
  if name == "cancel_token_new"
    codegen_util::cg_emit_line(out, "  ; cancel_token_new: allocate aligned i64 initialized to 0")
    codegen_util::cg_emit(out, "  %ct")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw = call ptr @__qz_alloc(i64 8)")
    codegen_util::cg_emit(out, "  %ct")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = bitcast ptr %ct")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".raw to ptr")
    codegen_util::cg_emit(out, "  store i64 0, ptr %ct")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %ct")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p to i64")
    return 1
  end

  if name == "cancel_token_cancel"
    var tok = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; cancel_token_cancel: atomic store 1")
    codegen_util::cg_emit(out, "  %ctc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, tok)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  store atomic i64 1, ptr %ctc")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "cancel_token_is_cancelled"
    var tok = args[0].to_s()
    codegen_util::cg_emit_line(out, "  ; cancel_token_is_cancelled: atomic load + compare")
    codegen_util::cg_emit(out, "  %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, tok)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".val = load atomic i64, ptr %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cmp = icmp ne i64 %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".val, 0")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = zext i1 %ctic")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cmp to i64")
    return 1
  end

  if name == "cancel_token_free"
    var tok = args[0].to_s()
    # Safety: do NOT free the token memory. Worker threads may still reference
    # it via frame[3] in the task_done cancel path (race: main thread frees
    # token while worker reads frame[3] → use-after-free). Instead, zero
    # the flag so cancel_token_is_cancelled returns false. 8 bytes leaked per
    # token is negligible. A proper fix requires task_done synchronization.
    codegen_util::cg_emit_line(out, "  ; cancel_token_free (zero but no free — worker race safety)")
    codegen_util::cg_emit(out, "  %ctf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p = inttoptr i64 %v")
    codegen_util::cg_emit(out, tok)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  store atomic i64 0, ptr %ctf")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  return 0
end
