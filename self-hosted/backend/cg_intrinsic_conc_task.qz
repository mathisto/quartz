    codegen_util::cg_emit_line(out, d)
    codegen_util::cg_emit(out, "ts_spawn_")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ":")
    # Allocate async frame: 7 i64 slots = 56 bytes
    # [0]=state(0), [1]=result(0), [2]=poll_fn, [3]=closure, [4]=task_id, [5]=group_ptr, [6]=index
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
