##! # Concurrency Intrinsics: conc_task
##!
##! @see cg_intrinsic_concurrency Main concurrency dispatcher
##! @see codegen_util Shared codegen utilities

import mir
import codegen_util
import codegen_runtime
import * from str_compat

def cg_emit_conc_task(state: CodegenState, out: Int, prog: mir::MirProgram, instr: mir::MirInstr, dest: Int, name: String, args: Vec<Int>, argc: Int, d: String, _elem_type: String): Int
  if name == "parallel_reduce"
    var arr = mir::mir_call_get_arg(instr, 0)
    var init = mir::mir_call_get_arg(instr, 1)
    var fn = mir::mir_call_get_arg(instr, 2)
    var av = arr.to_s()
    var iv = init.to_s()
    var fv = fn.to_s()
    codegen_util::cg_emit_line(out, "  ; parallel_reduce: fold array with fn(acc, elem)")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".vec = inttoptr i64 %v")
    codegen_util::cg_emit(out, av)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".len = load i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data_ptr_loc = getelementptr i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".vec, i64 2")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".data = load i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data_ptr_loc")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr_ptr = inttoptr i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".data to ptr")
    # Check if fn is a closure
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".fn_tag = and i64 %v")
    codegen_util::cg_emit(out, fv)
    codegen_util::cg_emit_line(out, ", 1")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure = icmp eq i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".fn_tag, 1")
    codegen_util::cg_emit(out, "  br label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".entry")
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".entry:")
    codegen_util::cg_emit(out, "  br label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop")
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop:")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i = phi i64 [0, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".entry], [%pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next]")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".acc = phi i64 [%v")
    codegen_util::cg_emit(out, iv)
    codegen_util::cg_emit(out, ", %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".entry], [%pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_acc, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next]")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done = icmp uge i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".len")
    codegen_util::cg_emit(out, "  br i1 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".done, label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".end, label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body")
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".body:")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".elem_ptr = getelementptr i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".arr_ptr, i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".elem = load i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".elem_ptr")
    codegen_util::cg_emit(out, "  br i1 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".is_closure, label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".call_closure, label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".call_plain")
    # Closure call: fn(env, acc, elem)
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".call_closure:")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env = and i64 %v")
    codegen_util::cg_emit(out, fv)
    codegen_util::cg_emit_line(out, ", -2")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env_ptr = inttoptr i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env to ptr")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn_slot = load i64, ptr %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".env_ptr")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn = inttoptr i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".cfn_slot to i64 (i64, i64, i64)*")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cacc = call i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cfn(i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".env, i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".acc, i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".elem)")
    codegen_util::cg_emit(out, "  br label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next")
    # Plain call: fn(acc, elem)
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".call_plain:")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfn = inttoptr i64 %v")
    codegen_util::cg_emit(out, fv)
    codegen_util::cg_emit_line(out, " to i64 (i64, i64)*")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pacc = call i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pfn(i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".acc, i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".elem)")
    codegen_util::cg_emit(out, "  br label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next")
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".next:")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".new_acc = phi i64 [%pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".cacc, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".call_closure], [%pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".pacc, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".call_plain]")
    codegen_util::cg_emit(out, "  %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".i_next = add i64 %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".i, 1")
    codegen_util::cg_emit(out, "  br label %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop")
    codegen_util::cg_emit(out, "pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".end:")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = phi i64 [%pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".acc, %pr")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".loop]")
    return 1
  end

  if name == "atomic_new"
    var initial = args[0]
    codegen_util::cg_emit_line(out, "  ; atomic_new: allocate aligned i64 and initialize")
    codegen_util::cg_emit(out, "  %atm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr = call ptr @__qz_alloc(i64 8)")
    codegen_util::cg_emit(out, "  %atm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".p64 = bitcast ptr %atm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr to ptr")
    codegen_util::cg_emit(out, "  store atomic i64 %v")
    codegen_util::cg_emit_int(out, initial)
    codegen_util::cg_emit(out, ", ptr %atm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".p64 seq_cst, align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = ptrtoint ptr %atm")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".ptr to i64")
    return 1
  end

  if name == "atomic_load"
    var ptr_arg = args[0]
    var ord = "seq_cst"
    if argc > 1
      ord = codegen_util::resolve_ordering(state, args[1])
    end
    codegen_util::cg_emit(out, "  ; atomic_load: ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, " load")
    codegen_util::cg_emit(out, "  %atl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = load atomic i64, ptr %atl")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_store"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit(out, "  ; atomic_store: ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, " store")
    codegen_util::cg_emit(out, "  %ats")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  store atomic i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, ", ptr %ats")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "signal_on_flag"
    var sig_arg = args[0]
    var flag_arg = args[1]
    if codegen_runtime::cg_is_freestanding(state.target_triple) == 1
      # D.11 Phase 8a step 5 — freestanding no-op. Kernel has no libc
      # signal() and routes shutdown via uart_shutdown → scope_cancel
      # (root) per the bridge memo Q5, not via signal_on_flag. The
      # `@qz_signal_on_flag` runtime helper isn't emitted in
      # freestanding builds (cg_emit_runtime_helpers_2 sits past the
      # early-return in cg_emit_runtime_decls), so emitting the call
      # would yield an undefined-symbol link error.
      codegen_util::cg_emit_line(out, "  ; signal_on_flag: freestanding no-op (no libc signal())")
    else
      codegen_util::cg_emit_line(out, "  ; signal_on_flag: register signal handler that sets atomic flag")
      codegen_util::cg_emit(out, "  call void @qz_signal_on_flag(i64 %v")
      codegen_util::cg_emit_int(out, sig_arg)
      codegen_util::cg_emit(out, ", i64 %v")
      codegen_util::cg_emit_int(out, flag_arg)
      codegen_util::cg_emit_line(out, ")")
    end
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, " = add i64 0, 0")
    return 1
  end

  if name == "atomic_add"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_add: returns old value, adds val")
    codegen_util::cg_emit(out, "  %ata")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw add ptr %ata")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_sub"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_sub: returns old value, subtracts val")
    codegen_util::cg_emit(out, "  %atsu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw sub ptr %atsu")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_exchange"
    var ptr_arg = args[0]
    var new_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_exchange: returns old value, sets new value")
    codegen_util::cg_emit(out, "  %atx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw xchg ptr %atx")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, new_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_and"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_and: returns old value, bitwise-ands val")
    codegen_util::cg_emit(out, "  %atan")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw and ptr %atan")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_or"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_or: returns old value, bitwise-ors val")
    codegen_util::cg_emit(out, "  %ator")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw or ptr %ator")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_xor"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_xor: returns old value, bitwise-xors val")
    codegen_util::cg_emit(out, "  %atxo")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr = inttoptr i64 %v")
    codegen_util::cg_emit_int(out, ptr_arg)
    codegen_util::cg_emit_line(out, " to ptr")
    codegen_util::cg_emit(out, "  %v")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, " = atomicrmw xor ptr %atxo")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".ptr, i64 %v")
    codegen_util::cg_emit_int(out, val_arg)
    codegen_util::cg_emit(out, " ")
    codegen_util::cg_emit(out, ord)
    codegen_util::cg_emit_line(out, ", align 8")
    return 1
  end

  if name == "atomic_min"
    var ptr_arg = args[0]
    var val_arg = args[1]
    var ord = "seq_cst"
    if argc > 2
      ord = codegen_util::resolve_ordering(state, args[2])
    end
    codegen_util::cg_emit_line(out, "  ; atomic_min: returns old value, signed-min with val")
    codegen_util::cg_emit(out, "  %atmn")
