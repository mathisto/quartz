    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".frm.slot = getelementptr i64, ptr %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".frm.base, i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".idx")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".frame.i = ptrtoint ptr %ts")
