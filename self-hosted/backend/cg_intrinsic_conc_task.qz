    codegen_util::cg_emit(out, ".newcap.small = icmp slt i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw, 4")
    codegen_util::cg_emit(out, "  %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap = select i1 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit(out, ".newcap.small, i64 4, i64 %ts")
    codegen_util::cg_emit(out, d)
    codegen_util::cg_emit_line(out, ".newcap.raw")
