  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)  # cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # Inline rehash: double cap, alloc new arrays, reinsert all
  # Save old arrays
  # old_cap = map[0], old_keys = map[2], old_vals = map[3], old_states = map[4]
  # Use locals 3-6 to save old values... but we only have 2 locals. Need more.
  # Actually, let me just read the old values, create new arrays, then loop.
  # For simplicity, I'll save old_cap on the stack and use the map's fields directly.
  # Approach: double cap in-place, alloc new arrays, iterate old states, re-insert
  # This requires saving old pointers. Let me add more locals.
  # Call __wasm_hm_rehash(map)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_hm_rehash"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if (rehash)

  # find_slot
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_hm_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # slot
  # if slot >= 0 → update value
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # values[slot] = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # val
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # New entry: neg_slot = -(slot + 1) → actual slot = -(slot) - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # actual slot
  # keys[slot] = key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # key
  wasm_encode::wasm_emit_i64_store(body, 0)
  # values[slot] = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # states[slot] = 1 (occupied)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # size++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if/else (update vs insert)
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## hashmap_del(map, key): find_slot, mark deleted.
def _wasm_synth_hashmap_del(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_hm_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # if slot >= 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # states[slot] = 2 (deleted)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 2)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # size--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## hashmap_keys(map): collect occupied keys into a new vec.
def _wasm_synth_hashmap_keys(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: result_vec, cap, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # cap = map[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # Loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # if states[i] == 1 → push keys[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # result
  # keys[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if occupied
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## hashmap_values(map): collect occupied values into a new vec.
## Same structure as hashmap_keys but reads from values_ptr (offset 24).
def _wasm_synth_hashmap_values(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  # Read from values_ptr (offset 24) instead of keys_ptr (offset 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)  # values_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Rehash helper: double capacity, re-insert all entries using specified set function.
def _wasm_synth_rehash(set_func_name: String): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: old_cap, old_keys, old_vals, old_states, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  # Save old values
  # old_cap = map[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # old_keys = map[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # old_vals = map[3]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # old_states = map[4]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # new_cap = old_cap * 2
  # map[0] = new_cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # map[1] = 0 (size)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # map[2] = alloc(new_cap * 8) — keys
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 16)  # new_cap * 8 = old_cap * 2 * 8 = old_cap * 16
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_i64_store(body, 16)
  # map[3] = alloc(new_cap * 8) — values
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_i64_store(body, 24)
  # map[4] = alloc(new_cap) — states (new_cap = old_cap * 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_i64_store(body, 32)
  # Iterate old entries: for i in 0..old_cap, if old_states[i] == 1 → hashmap_set(map, old_keys[i], old_vals[i])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= old_cap → break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # if old_states[i] == 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)  # old_states
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)  # i
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # hashmap_set(map, old_keys[i], old_vals[i])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # map
  # old_keys[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # old_vals[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx(set_func_name))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)  # discard return value
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if occupied
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end


## set_add(s, v): call hashmap_set(s, v, 1).
def _wasm_synth_set_add(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("hashmap_set"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## set_int_add(s, v): call intmap_set(s, v, 1).
## Used by Set<Int> after slot2="Int" annotation routes set_add through here.
def _wasm_synth_set_int_add(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("intmap_set"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit exit(code) -> calls proc_exit
def _wasm_synth_exit(proc_exit_idx: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, proc_exit_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_UNREACHABLE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit __wasm_memcpy(dst, src, len): copy len bytes using memory.copy.
## Params: dst(i64), src(i64), len(i64). Returns: void (but we return dst for convenience).
def _wasm_synth_helper_memcpy(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)  # 0 local groups
  # memory.copy expects i32 args: dst, src, len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # dst
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # src
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_memory_copy(body)
  # Return dst
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit __wasm_memset(dst, val, len): fill len bytes with val.
## Params: dst(i64), val(i64), len(i64). Returns: dst.
def _wasm_synth_helper_memset(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # dst
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_memory_fill(body)
  # Return dst
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit __wasm_realloc(old_ptr, old_size, new_size): alloc new + memcpy.
## Params: old_ptr(i64), old_size(i64), new_size(i64). Returns: new_ptr(i64).
def _wasm_synth_helper_realloc(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: new_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # new_ptr = alloc(new_size)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # new_size
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # local 3 = new_ptr
  # memcpy(new_ptr, old_ptr, old_size)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # new_ptr (dst)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # old_ptr (src)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # old_size (len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)  # memcpy returns dst, we don't need it
  # Return new_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit __wasm_alloc_str(len): allocate a Quartz string with given byte length.
## Returns pointer to data[0]. Layout: [i64 len][data bytes][null]
## Params: len(i64). Returns: data_ptr(i64).
def _wasm_synth_helper_alloc_str(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: base_ptr, data_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # base_ptr = alloc(8 + len + 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)  # 8 (len prefix) + 1 (null term)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # len param
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # local 1 = base_ptr
  # Store length at base_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # len
  wasm_encode::wasm_emit_i64_store(body, 0)
  # data_ptr = base_ptr + 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # local 2 = data_ptr
  # Write null terminator at data_ptr + len
  # i32.store8 expects: [addr:i32] [val:i32] on stack
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)  # val = 0 (null byte)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)  # align
  wasm_encode::wasm_emit_u32(body, 0)  # offset
  # Return data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Get the type signature info for a synthesized function by name.
## Returns (arity * 2 + has_result) packed into a single integer.
## The caller unpacks: arity = result / 2, has_result = result % 2.
def _wasm_synth_type_info(name: String): Int
  var name = _wasm_normalize_name(name)
  # void return (0-arg)
  if name == "capture_output_start" or name == "capture_output_end" or name == "fuel_check"
    return 0
  end
  # Note: In Quartz's existential type model, nearly ALL functions return i64.
  # Only ptr_write_byte is truly void (it's a memory store, not a Quartz function).
  if name == "ptr_write_byte"
    return 4
  end
  # 0-arg → i64
  if name == "vec_new" or name == "sb_new" or name == "option_none" or name == "hashmap_new" or name == "intmap_new" or name == "set_new"
    return 1
  end
  # 3-arg → i64
  if name == "__wasm_memcpy" or name == "__wasm_memset" or name == "__wasm_realloc"
    return 7
  end
  # 2-arg → i64
  if name == "ptr_add" or name == "unwrap_or" or name == "str_byte_at"
    return 5
  end
  if name == "band" or name == "bor" or name == "bxor" or name == "shl" or name == "shr"
    return 5
  end
  if name == "str_concat" or name == "str_eq" or name == "str_starts_with" or name == "str_ends_with"
    return 5
  end
  if name == "str_contains" or name == "str_find" or name == "__wasm_str_find_raw" or name == "str_cmp" or name == "str_char_at"
    return 5
  end
  if name == "str_codepoint_at" or name == "str_codepoint_byte_len" or name == "str_codepoint_nth"
    return 5
  end
  # 3-arg string ops
  if name == "str_slice" or name == "str_byte_slice" or name == "str_substr"
    return 7
  end
  # Vec: 2-arg ops
  if name == "vec_push" or name == "vec_get" or name == "vec_get_unchecked" or name == "vec_contains" or name == "vec_index_of"
    return 5
  end
  # Vec: 3-arg ops
  if name == "vec_set" or name == "vec_set_unchecked" or name == "vec_slice"
    return 7
  end
  # Vec: 2-arg (new_filled)
  if name == "vec_new_filled"
    return 5
  end
  # HashMap: 2-arg ops
  if name == "hashmap_get" or name == "hashmap_has" or name == "hashmap_delete"
    return 5
  end
  # str_hash: 1-arg
  if name == "str_hash"
    return 3
  end
  # HashMap: 3-arg ops
  if name == "hashmap_set"
    return 7
  end
  # IntMap: 2-arg ops
  if name == "intmap_get" or name == "intmap_has" or name == "intmap_delete"
    return 5
  end
  # IntMap: 3-arg ops
  if name == "intmap_set"
    return 7
  end
  # Set: 2-arg ops
  if name == "set_add" or name == "set_int_add" or name == "set_has" or name == "set_delete"
    return 5
  end
  # __hashmap_get_raw / __hashmap_get_sentinel: 2-arg
  if name == "__hashmap_get_raw" or name == "__hashmap_get_sentinel"
    return 5
  end
  # Internal hashmap helpers
  if name == "__wasm_hm_find_slot" or name == "__wasm_im_find_slot"
    return 5
  end
  if name == "__wasm_hm_rehash" or name == "__wasm_im_rehash"
    return 3
  end
  # Vec: void returns (push is special — returns void but we return i64 0)
  # StringBuilder: 2-arg
  if name == "sb_append" or name == "sb_append_char" or name == "sb_append_int"
    return 5
  end
  # Higher-order Vec ops: (vec, fn) -> i64
  if name == "each" or name == "find" or name == "map" or name == "filter"
    return 5
  end
  # reduce: (vec, init, fn) -> i64  (3-arg)
  if name == "reduce"
    return 7
  end
  # zip: (vec_a, vec_b) -> i64
  if name == "zip"
    return 5
  end
  # __qz_pair_new: (a, b) -> i64
  if name == "__qz_pair_new"
    return 5
  end
  # Option: option_some is 1-arg
  # Char class: 1-arg
  # Extended string ops
  if name == "str_replace"
    return 7
  end
  if name == "str_repeat"
    return 5
  end
  if name == "str_split" or name == "str_join"
    return 5
  end
  # Float binary ops: 2-arg → i64
  if name == "f64_min" or name == "f64_max"
    return 5
  end
  # Void returns
  if name == "capture_output_start" or name == "capture_output_end"
    return 0
  end
  # 1-arg → i64 (default for most: str_trim, str_downcase, str_upcase,
  # f64_abs, f64_neg, f64_sqrt, f64_floor, f64_ceil, bnot, popcount, clz, ctz)
  return 3
end

## Determine if the key type annotation indicates integer keys.
## Mirrors cg_intrinsic_map._map_is_int_key in the LLVM backend so the
## WASM backend can route unified map_* intrinsics to the correct
## key-type-specialized helper.
def _wasm_is_int_key(elem_type: String): Bool
  if str_byte_len(elem_type) == 0
    return false
  end
  if elem_type == "Int"
    return true
  end
  if str_byte_len(elem_type) >= 3
    if elem_type.starts_with("Int")
      return true
    end
  end
  if str_byte_len(elem_type) == 1
    if str_byte_at(elem_type, 0) == 'I'
      return true
    end
  end
  return false
end

## Map a unified map_* name to its string-key WASM runtime function name.
def _wasm_map_to_hashmap(name: String): String
  if name == "map_new"
    return "hashmap_new"
  end
  if name == "map_get"
    return "hashmap_get"
  end
  if name == "map_set"
    return "hashmap_set"
  end
  if name == "map_has"
    return "hashmap_has"
  end
  if name == "map_delete"
    return "hashmap_delete"
  end
  if name == "map_size"
    return "hashmap_size"
  end
  if name == "map_keys"
    return "hashmap_keys"
  end
  if name == "map_values"
    return "hashmap_values"
  end
  if name == "map_clear"
    return "hashmap_clear"
  end
  if name == "map_free"
    return "hashmap_free"
  end
  if name == "__map_get_raw"
    return "__hashmap_get_sentinel"
  end
  return name
end

## Map a unified map_* name to its int-key WASM runtime function name.
def _wasm_map_to_intmap(name: String): String
  if name == "map_new"
    return "intmap_new"
  end
  if name == "map_get"
    return "intmap_get"
  end
  if name == "map_set"
    return "intmap_set"
  end
  if name == "map_has"
    return "intmap_has"
  end
  if name == "map_delete"
    return "intmap_delete"
  end
  if name == "map_size"
    return "intmap_size"
  end
  if name == "map_keys"
    return "intmap_keys"
  end
  if name == "map_values"
    return "intmap_values"
  end
  if name == "map_clear"
    return "intmap_clear"
  end
  if name == "map_free"
    return "intmap_free"
  end
  if name == "__map_get_raw"
    return "intmap_get"
  end
  return name
end

## Resolve a unified map_* intrinsic name to the backend-specific
## hashmap_*/intmap_* runtime helper using the elem_type annotation
## extracted from the MIR instruction's slot2.
##
## Mirrors cg_intrinsic_map.cg_emit_intrinsic_map's dispatch shape so
## both backends route map_* by key type the same way.
def _wasm_resolve_map_name(name: String, elem_type: String): String
  if str_starts_with(name, "map_") == false and name != "__map_get_raw"
    return name
  end
  if _wasm_is_int_key(elem_type)
    return _wasm_map_to_intmap(name)
  end
  return _wasm_map_to_hashmap(name)
end

## Resolve set_* intrinsics by element type. For Set<Int>, route the
## key-aware ops (add/has/delete) through intmap_* so the multiplicative
## i64 hash is used instead of str_hash dereferencing the int as a
## pointer. For Set<String> (default), keep the existing set_* names
## which wrap hashmap_*. Layout-only ops (new/size/clear/free/members)
## share storage between the two and don't need redirection — leaving
## them as set_* keeps the synth body sharing intact.
def _wasm_resolve_set_name(name: String, elem_type: String): String
  if str_starts_with(name, "set_") == false
    return name
  end
  if _wasm_is_int_key(elem_type) == false
    return name
  end
  if name == "set_add"
    return "set_int_add"
  end
  if name == "set_has"
    return "intmap_has"
  end
  if name == "set_delete"
    return "intmap_delete"
  end
  return name
end

## Emit the body for a synthesized function by name.
## Normalize UFCS names: Map$get -> map_get, Vec$push -> vec_push, etc.
def _wasm_normalize_name(name: String): String
  if str_starts_with(name, "Map$")
    return "map_" + str_slice(name, 4, str_byte_len(name))
  end
  if str_starts_with(name, "Vec$")
    return "vec_" + str_slice(name, 4, str_byte_len(name))
  end
  if str_starts_with(name, "String$")
    return "str_" + str_slice(name, 7, str_byte_len(name))
  end
  return name
end

def _wasm_emit_synth_body(name: String, proc_exit_idx: Int, fd_write_idx: Int, heap_ptr_global: Int): Vec<Int>
  var name = _wasm_normalize_name(name)
  if name == "alloc"
    return _wasm_synth_alloc(heap_ptr_global)
  end
  if name == "qz_free" or name == "vec_free" or name == "sb_free" or name == "hashmap_free" or name == "intmap_free" or name == "option_free" or name == "set_free"
    return _wasm_synth_free()
  end
  if name == "panic"
    return _wasm_synth_panic(proc_exit_idx)
  end
  if name == "puts"
    return _wasm_synth_puts(fd_write_idx, heap_ptr_global)
  end
  if name == "print" or name == "eprint" or name == "eputs"
    return _wasm_synth_print(fd_write_idx)
  end
  if name == "exit"
    return _wasm_synth_exit(proc_exit_idx)
  end
  if name == "unwrap" or name == "int_to_cptr" or name == "as_string" or name == "as_int" or name == "as_int_generic" or name == "as_type"
    return _wasm_synth_identity()
  end
  if name == "unwrap_or"
    return _wasm_synth_unwrap_or()
  end
  if name == "ptr_add"
    return _wasm_synth_ptr_add()
  end
  if name == "ptr_read_byte"
    return _wasm_synth_ptr_read_byte()
  end
  if name == "ptr_write_byte"
    return _wasm_synth_ptr_write_byte()
  end
  if name == "str_byte_len" or name == "str_size" or name == "str_len_utf8"
    return _wasm_synth_str_byte_len()
  end
  if name == "str_byte_at" or name == "str_codepoint_at" or name == "str_codepoint_byte_len" or name == "str_codepoint_nth" or name == "str_char_at"
    return _wasm_synth_str_byte_at()
  end
  if name == "band"
    return _wasm_synth_binop(wasm_encode::WASM_I64_AND)
  end
  if name == "bor"
    return _wasm_synth_binop(wasm_encode::WASM_I64_OR)
  end
  if name == "bxor"
    return _wasm_synth_binop(wasm_encode::WASM_I64_XOR)
  end
  if name == "shl"
    return _wasm_synth_binop(wasm_encode::WASM_I64_SHL)
  end
  if name == "shr"
    return _wasm_synth_binop(wasm_encode::WASM_I64_SHR_U)
  end
  # Internal helpers
  if name == "__wasm_memcpy"
    return _wasm_synth_helper_memcpy()
  end
  if name == "__wasm_memset"
    return _wasm_synth_helper_memset()
  end
  if name == "__wasm_realloc"
    return _wasm_synth_helper_realloc()
  end
  if name == "__wasm_alloc_str"
    return _wasm_synth_helper_alloc_str()
  end
  # Phase 1: String operations
  if name == "str_concat"
    return _wasm_synth_str_concat()
  end
  if name == "str_eq"
    return _wasm_synth_str_eq()
  end
  if name == "str_from_int"
    return _wasm_synth_str_from_int()
  end
  if name == "to_str"
    return _wasm_synth_to_str()
  end
  if name == "str_from_char"
    return _wasm_synth_str_from_char()
  end
  if name == "str_is_empty"
    return _wasm_synth_str_is_empty()
  end
  if name == "print_int" or name == "eprint_int"
    return _wasm_synth_print_int(fd_write_idx)
  end
  if name == "str_starts_with"
    return _wasm_synth_str_starts_with()
  end
  if name == "str_ends_with"
    return _wasm_synth_str_ends_with()
  end
  if name == "str_to_int"
    return _wasm_synth_str_to_int()
  end
  if name == "str_contains"
    return _wasm_synth_str_contains()
  end
  if name == "str_find"
    return _wasm_synth_str_find()
  end
  if name == "__wasm_str_find_raw"
    return _wasm_synth_str_find_raw()
  end
  if name == "str_slice" or name == "str_byte_slice" or name == "str_substr"
    return _wasm_synth_str_slice()
  end
  if name == "str_cmp"
    return _wasm_synth_str_cmp()
  end
  # Vec operations (Phase 2)
  if name == "vec_new"
    return _wasm_synth_vec_new()
  end
  if name == "vec_push"
    return _wasm_synth_vec_push()
  end
  if name == "vec_get"
    return _wasm_synth_vec_get()
  end
  if name == "vec_get_unchecked"
    return _wasm_synth_vec_get_unchecked()
  end
  if name == "vec_set"
    return _wasm_synth_vec_set()
  end
  if name == "vec_set_unchecked"
    # Same as set but without bounds check
    return _wasm_synth_vec_set()
  end
  if name == "vec_size"
    return _wasm_synth_vec_size()
  end
  if name == "vec_pop"
    return _wasm_synth_vec_pop()
  end
  if name == "vec_clear"
    return _wasm_synth_vec_clear()
  end
  if name == "vec_contains"
    return _wasm_synth_vec_contains()
  end
  if name == "vec_index_of"
    return _wasm_synth_vec_index_of()
  end
  if name == "vec_free" or name == "vec_shrink_to_fit"
    return _wasm_synth_free()
  end
  if name == "vec_new_filled"
    return _wasm_synth_vec_new_filled()
  end
  if name == "vec_reverse"
    return _wasm_synth_vec_reverse()
  end
  if name == "vec_clone"
    return _wasm_synth_vec_clone()
  end
  if name == "vec_slice"
    return _wasm_synth_vec_slice()
  end
  if name == "vec_sort"
    return _wasm_synth_vec_sort()
  end
  if name == "sorted"
    return _wasm_synth_sorted()
  end
  if name == "each"
    return _wasm_synth_each()
  end
  if name == "find"
    return _wasm_synth_find()
  end
  if name == "map"
    return _wasm_synth_map()
  end
  if name == "filter"
    return _wasm_synth_filter()
  end
  if name == "reduce"
    return _wasm_synth_reduce()
  end
  if name == "unique"
    return _wasm_synth_unique()
  end
  if name == "__qz_pair_new"
    return _wasm_synth_pair_new()
  end
  if name == "zip"
    return _wasm_synth_zip()
  end
  if name == "enumerate"
    return _wasm_synth_enumerate()
  end
  # StringBuilder operations (Phase 3)
  if name == "sb_new"
    return _wasm_synth_sb_new()
  end
  if name == "sb_append"
    return _wasm_synth_sb_append()
  end
  if name == "sb_append_char"
    return _wasm_synth_sb_append_char()
  end
  if name == "sb_append_int"
    return _wasm_synth_sb_append_int()
  end
  if name == "sb_to_string"
    return _wasm_synth_sb_to_string()
  end
  if name == "sb_size"
    return _wasm_synth_sb_size()
  end
  if name == "sb_clear" or name == "sb_free"
    return _wasm_synth_free()
  end
  # Option operations (Phase 4)
  if name == "option_some"
    return _wasm_synth_option_some()
  end
  if name == "option_none"
    return _wasm_synth_option_none()
  end
  if name == "option_is_some"
    return _wasm_synth_option_is_some()
  end
  if name == "option_get"
    return _wasm_synth_option_get()
  end
  # Char classification (Phase 6)
  if name == "is_digit"
    return _wasm_synth_is_digit()
  end
  if name == "is_alpha"
    return _wasm_synth_is_alpha()
  end
  if name == "is_alnum"
    return _wasm_synth_is_alnum()
  end
  if name == "is_whitespace"
    return _wasm_synth_is_whitespace()
  end
  if name == "is_upper"
    return _wasm_synth_is_upper()
  end
  if name == "is_lower"
    return _wasm_synth_is_lower()
  end
  # Extended string operations (Phase 7)
  if name == "str_trim"
    return _wasm_synth_str_trim()
  end
  if name == "str_trim_left"
    return _wasm_synth_str_trim_left()
  end
  if name == "str_trim_right"
    return _wasm_synth_str_trim_right()
  end
  if name == "str_downcase"
    return _wasm_synth_str_downcase()
  end
  if name == "str_upcase"
    return _wasm_synth_str_upcase()
  end
  if name == "str_repeat"
    return _wasm_synth_str_repeat()
  end
  if name == "str_replace"
    return _wasm_synth_str_replace()
  end
  if name == "str_split"
    return _wasm_synth_str_split()
  end
  if name == "str_join"
    return _wasm_synth_str_join()
  end
  if name == "str_chars"
    return _wasm_synth_str_chars()
  end
  if name == "str_reverse"
    return _wasm_synth_str_reverse()
  end
  # Float math (Phase 7)
  if name == "f64_abs"
    return _wasm_synth_f64_unary(wasm_encode::WASM_F64_ABS)
  end
  if name == "f64_neg"
    return _wasm_synth_f64_unary(wasm_encode::WASM_F64_NEG)
  end
  if name == "f64_sqrt"
    return _wasm_synth_f64_unary(wasm_encode::WASM_F64_SQRT)
  end
  if name == "f64_floor"
    return _wasm_synth_f64_unary(wasm_encode::WASM_F64_FLOOR)
  end
  if name == "f64_ceil"
    return _wasm_synth_f64_unary(wasm_encode::WASM_F64_CEIL)
  end
  if name == "f64_min"
    return _wasm_synth_f64_binary(wasm_encode::WASM_F64_MIN)
  end
  if name == "f64_max"
    return _wasm_synth_f64_binary(wasm_encode::WASM_F64_MAX)
  end
  # Bit manipulation (Phase 7)
  if name == "bnot"
    return _wasm_synth_bnot()
  end
  if name == "popcount"
    return _wasm_synth_i64_unary(wasm_encode::WASM_I64_POPCNT)
  end
  if name == "clz"
    return _wasm_synth_i64_unary(wasm_encode::WASM_I64_CLZ)
  end
  if name == "ctz"
    return _wasm_synth_i64_unary(wasm_encode::WASM_I64_CTZ)
  end
  # Misc no-ops
  if name == "fuel_check"
    # True void no-op: empty body, no return value
    var body = vec_new<Int>()
    wasm_encode::wasm_emit_u32(body, 0)
    wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
    return body
  end
  if name == "capture_output_start" or name == "capture_output_end" or name == "mem_forget"
    return _wasm_synth_free()
  end
  # HashMap operations (Phase 5)
  if name == "str_hash"
    return _wasm_synth_str_hash()
  end
  if name == "__wasm_hm_find_slot"
    return _wasm_synth_hm_find_slot()
  end
  if name == "__wasm_im_find_slot"
    return _wasm_synth_im_find_slot()
  end
  if name == "__wasm_hm_rehash"
    return _wasm_synth_rehash("hashmap_set")
  end
  if name == "__wasm_im_rehash"
    return _wasm_synth_rehash("intmap_set")
  end
  if name == "hashmap_new" or name == "intmap_new" or name == "set_new"
    return _wasm_synth_hashmap_new()
  end
  if name == "hashmap_set"
    return _wasm_synth_hashmap_set()
  end
  if name == "hashmap_get" or name == "__hashmap_get_raw" or name == "__hashmap_get_sentinel"
    return _wasm_synth_hashmap_get()
  end
  if name == "hashmap_has"
    return _wasm_synth_hashmap_has()
  end
  if name == "hashmap_delete"
    return _wasm_synth_hashmap_del()
  end
  if name == "hashmap_size" or name == "intmap_size"
    return _wasm_synth_hashmap_size()
  end
  if name == "hashmap_keys"
    return _wasm_synth_hashmap_keys()
  end
  if name == "hashmap_values"
    return _wasm_synth_hashmap_values()
  end
  if name == "hashmap_clear" or name == "intmap_clear"
    return _wasm_synth_vec_clear()  # sets size=0 (close enough)
  end

  if name == "intmap_set"
    return _wasm_synth_intmap_set()
  end
  if name == "intmap_get"
    return _wasm_synth_intmap_get()
  end
  if name == "intmap_has"
    return _wasm_synth_intmap_has()
  end
  if name == "intmap_delete"
    return _wasm_synth_intmap_del()
  end
  if name == "intmap_keys" or name == "intmap_values"
    return _wasm_synth_hashmap_keys()
  end
  # Set: thin wrappers around hashmap
  if name == "set_add"
    # set_add(s, v) = hashmap_set(s, v, 1) — but set_add takes 2 args, hashmap_set takes 3
    # Emit: call hashmap_set(s, v, 1)
    return _wasm_synth_set_add()
  end
  if name == "set_int_add"
    # set_int_add(s, v) = intmap_set(s, v, 1). Emitted when Set<Int>.
    return _wasm_synth_set_int_add()
  end
  if name == "set_has"
    return _wasm_synth_hashmap_has()
  end
  if name == "set_delete"
    return _wasm_synth_hashmap_del()
  end
  if name == "set_size"
    return _wasm_synth_hashmap_size()
  end
  if name == "set_members"
    return _wasm_synth_hashmap_keys()
  end
  # Remaining stubs
  return _wasm_synth_identity()
end

## intmap_has(map, key): find slot with im_find_slot, check >= 0.
def _wasm_synth_intmap_has(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_im_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## intmap_get(map, key): find slot with im_find_slot, return value or 0.
def _wasm_synth_intmap_get(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: slot
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_im_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # if slot >= 0 -> return values[slot]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## intmap_del(map, key): find slot with im_find_slot, mark deleted.
def _wasm_synth_intmap_del(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: slot
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_im_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # if slot >= 0: states[slot] = 2 (deleted), size--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # states[slot] = 2
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 2)
  wasm_encode::wasm_emit_byte(body, 0x3A)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # size--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## intmap_set(map, key, val): check load, maybe im_rehash, im_find_slot, insert.
def _wasm_synth_intmap_set(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: slot, neg_slot
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Check load: if size * 4 >= cap * 3 -> rehash
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_im_rehash"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # slot = im_find_slot(map, key)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_im_find_slot"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # if slot >= 0: update values[slot]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # neg_slot = -(slot + 1) = insert position
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # keys[neg_slot] = key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # values[neg_slot] = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # states[neg_slot] = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, 0x3A)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # size++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Ensure a function is in the synth list. Avoids duplicates.
def _wasm_ensure_synth(name: String): Void
  if _wasm_get_func_idx(name) >= 0
    return
  end
  var i = 0
  while i < g_wasm_synth_count
    if g_wasm_synth_names[i] == name
      return
    end
    i += 1
  end
  g_wasm_synth_names.push(name)
  g_wasm_synth_count = g_wasm_synth_count + 1
end

## Register internal helper functions. Called after intrinsic prescan + MIR function index assignment.
def _wasm_register_internal_helpers(): Void
  # memcpy: (i64, i64, i64) -> i64
  g_wasm_synth_names.push("__wasm_memcpy")
  g_wasm_synth_count = g_wasm_synth_count + 1
  # memset: (i64, i64, i64) -> i64
  g_wasm_synth_names.push("__wasm_memset")
  g_wasm_synth_count = g_wasm_synth_count + 1
  # realloc: (i64, i64, i64) -> i64
  g_wasm_synth_names.push("__wasm_realloc")
  g_wasm_synth_count = g_wasm_synth_count + 1
  # alloc_str: (i64) -> i64
  g_wasm_synth_names.push("__wasm_alloc_str")
  g_wasm_synth_count = g_wasm_synth_count + 1
  # Ensure core dependencies are available
  _wasm_ensure_synth("alloc")
  _wasm_ensure_synth("str_from_char")
  _wasm_ensure_synth("to_str")
  _wasm_ensure_synth("sb_append")
  _wasm_ensure_synth("str_from_int")
  _wasm_ensure_synth("print")
  # print_int now calls puts (LLVM @print_int prints `%ld\n`); without
  # this cascade puts could be missing from the synth set when only
  # print_int is used, leaving an unresolved env import.
  _wasm_ensure_synth("puts")
  _wasm_ensure_synth("str_slice")
  _wasm_ensure_synth("str_find")
  # str_find now boxes the raw index into Option::Some / Option::None to
  # match LLVM's qz_str_find_utf8 contract (typecheck registry says
  # str_find: Option<Int>). Pull in the raw helper + Option synthesizers.
  _wasm_ensure_synth("__wasm_str_find_raw")
  _wasm_ensure_synth("option_some")
  _wasm_ensure_synth("option_none")
  _wasm_ensure_synth("str_concat")
  _wasm_ensure_synth("vec_new")
  _wasm_ensure_synth("vec_push")
  _wasm_ensure_synth("vec_get")
  _wasm_ensure_synth("vec_size")
  # HashMap dependencies — only register if hashmap is used
  var has_hashmap = 0
  var has_intmap = 0
  for i in 0..g_wasm_synth_count
    var sn = g_wasm_synth_names[i]
    if str_starts_with(sn, "hashmap_") or str_starts_with(sn, "set_") or sn == "__hashmap_get_raw" or sn == "__hashmap_get_sentinel"
      has_hashmap = 1
    end
    if str_starts_with(sn, "intmap_") or sn == "set_int_add"
      has_intmap = 1
    end
  end
  if has_hashmap == 1
    _wasm_ensure_synth("str_hash")
    _wasm_ensure_synth("str_eq")
    _wasm_ensure_synth("vec_new")
    _wasm_ensure_synth("vec_push")
    _wasm_ensure_synth("hashmap_set")
    g_wasm_synth_names.push("__wasm_hm_find_slot")
    g_wasm_synth_count = g_wasm_synth_count + 1
    g_wasm_synth_names.push("__wasm_hm_rehash")
    g_wasm_synth_count = g_wasm_synth_count + 1
  end
  if has_intmap == 1
    _wasm_ensure_synth("vec_new")
    _wasm_ensure_synth("vec_push")
    g_wasm_synth_names.push("__wasm_im_find_slot")
    g_wasm_synth_count = g_wasm_synth_count + 1
    g_wasm_synth_names.push("__wasm_im_rehash")
    g_wasm_synth_count = g_wasm_synth_count + 1
    _wasm_ensure_synth("intmap_set")
  end
  # `sorted` calls vec_clone + vec_sort internally. Cascade ensures the
  # dependency synth bodies are also emitted with valid function indices.
  var has_sorted = 0
  var has_alloc_dep = 0
  var has_unique = 0
  var has_pair_user = 0
  for j in 0..g_wasm_synth_count
    var jn = g_wasm_synth_names[j]
    if jn == "sorted"
      has_sorted = 1
    end
    if jn == "map" or jn == "filter" or jn == "unique" or jn == "zip" or jn == "enumerate" or jn == "__qz_pair_new"
      has_alloc_dep = 1
    end
    if jn == "unique"
      has_unique = 1
    end
    if jn == "zip" or jn == "enumerate"
      has_pair_user = 1
    end
  end
  # `unique` calls sorted internally → cascade sorted before its own deps.
  if has_unique == 1
    _wasm_ensure_synth("sorted")
    has_sorted = 1
  end
  if has_sorted == 1
    _wasm_ensure_synth("vec_clone")
    _wasm_ensure_synth("vec_sort")
  end
  # map / filter / unique / zip / enumerate / __qz_pair_new all call
  # vec_new + vec_push. str_chars also calls vec_new + vec_push.
  var has_str_chars_user = 0
  for k in 0..g_wasm_synth_count
    var kn = g_wasm_synth_names[k]
    if kn == "str_chars"
      has_str_chars_user = 1
    end
  end
  if has_alloc_dep == 1 or has_str_chars_user == 1
    _wasm_ensure_synth("vec_new")
    _wasm_ensure_synth("vec_push")
  end
  # zip and enumerate call __qz_pair_new internally.
  if has_pair_user == 1
    _wasm_ensure_synth("__qz_pair_new")
  end
end

