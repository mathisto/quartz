##! # WASM Synthesized Runtime Functions
##!
##! All built-in function implementations for the direct WASM backend.
##! Synthesized functions are compiled directly into WASM bytecode,
##! eliminating the need for env:: imports.
##!
##! @see codegen_wasm WASM module assembly and MIR walking
##! @see wasm_encode WASM binary encoding primitives
##! @since 5.26.0

import mir
import wasm_encode

# =============================================================================
# Function type deduplication
# =============================================================================
# Type entries stored as raw bytes (each entry is the full func type encoding).
# Owned here (not in codegen_wasm) so synth bodies can register types
# inline — needed for HOF synth (each / map / filter / reduce / find)
# whose call_indirect ops require pre-registered type indices.

var g_wasm_type_entries = vec_new<Vec<Int>>()
var g_wasm_type_count = 0

def _wasm_reset_types(): Void
  g_wasm_type_entries = vec_new<Vec<Int>>()
  g_wasm_type_count = 0
end

## Register a type from raw param/result type bytes. Returns type index.
## Deduplicates by comparing encoded bytes.
def _wasm_register_type(entry: Vec<Int>): Int
  var i = 0
  while i < g_wasm_type_count
    var existing = g_wasm_type_entries[i]
    if vec_size(existing) == vec_size(entry)
      var same = 1
      var j = 0
      while j < vec_size(existing)
        if vec_get(existing, j) != vec_get(entry, j)
          same = 0
        end
        j += 1
      end
      if same == 1
        return i
      end
    end
    i += 1
  end
  g_wasm_type_entries.push(entry)
  var idx = g_wasm_type_count
  g_wasm_type_count = g_wasm_type_count + 1
  return idx
end

## Get or create a type index for a Quartz function (all i64 params, i64 result).
def _wasm_get_type_idx(arity: Int, has_result: Int): Int
  var entry = vec_new<Int>()
  wasm_encode::wasm_emit_func_type(entry, arity, has_result)
  return _wasm_register_type(entry)
end

## Register a WASI-style type with i32 params.
def _wasm_get_type_idx_i32(num_i32_params: Int, has_i32_result: Int): Int
  var entry = vec_new<Int>()
  entry.push(wasm_encode::WASM_TYPE_FUNC)
  wasm_encode::wasm_emit_u32(entry, num_i32_params)
  var i = 0
  while i < num_i32_params
    entry.push(wasm_encode::WASM_TYPE_I32)
    i += 1
  end
  if has_i32_result == 1
    wasm_encode::wasm_emit_u32(entry, 1)
    entry.push(wasm_encode::WASM_TYPE_I32)
  else
    wasm_encode::wasm_emit_u32(entry, 0)
  end
  return _wasm_register_type(entry)
end

## Read-side accessors used by codegen_wasm's Type section emitter.
def _wasm_get_type_count(): Int = g_wasm_type_count

def _wasm_get_type_entry(i: Int): Vec<Int> = g_wasm_type_entries[i]

# =============================================================================
# Function index mapping (shared with codegen_wasm)
# =============================================================================

# Maps function name → WASM function index (imports first, then defined)
var g_wasm_func_names = vec_new<String>()
var g_wasm_func_indices = vec_new<Int>()
var g_wasm_func_count = 0

def _wasm_reset_func_map(): Void
  g_wasm_func_names = vec_new<String>()
  g_wasm_func_indices = vec_new<Int>()
  g_wasm_func_count = 0
end

def _wasm_set_func_idx(name: String, idx: Int): Void
  g_wasm_func_names.push(name)
  g_wasm_func_indices.push(idx)
  g_wasm_func_count = g_wasm_func_count + 1
end

def _wasm_get_func_idx(name: String): Int
  var i = 0
  while i < g_wasm_func_count
    if g_wasm_func_names[i] == name
      return g_wasm_func_indices[i]
    end
    i += 1
  end
  return -1
end

# =============================================================================
# Synthesized function registry
# =============================================================================

var g_wasm_synth_names = vec_new<String>()
var g_wasm_synth_bodies = vec_new<Vec<Int>>()
var g_wasm_synth_count = 0

def _wasm_reset_synth(): Void
  g_wasm_synth_names = vec_new<String>()
  g_wasm_synth_bodies = vec_new<Vec<Int>>()
  g_wasm_synth_count = 0
end

# =============================================================================
# Internal helper function indices (resolved at codegen time)
# =============================================================================

# These are internal functions called BY other synthesized functions.
# They do not appear in MIR — they are purely internal to the WASM runtime.
var g_wasm_helper_memcpy_idx = -1
var g_wasm_helper_realloc_idx = -1
var g_wasm_helper_memset_idx = -1
var g_wasm_helper_alloc_str_idx = -1

# =============================================================================
# Accessor functions (called by codegen_wasm)
# =============================================================================

## Get number of registered synthesized functions.
def wasm_rt_get_synth_count(): Int = g_wasm_synth_count

## Get the name of a synthesized function by index.
def wasm_rt_get_synth_name(idx: Int): String = g_wasm_synth_names[idx]

## Register a synthesized function name. Avoids duplicates.
def wasm_rt_register_synth(name: String): Void
  var i = 0
  while i < g_wasm_synth_count
    if g_wasm_synth_names[i] == name
      return
    end
    i += 1
  end
  g_wasm_synth_names.push(name)
  g_wasm_synth_count = g_wasm_synth_count + 1
end

## Set resolved helper function indices after index assignment.
def wasm_rt_set_helper_indices(memcpy_idx: Int, memset_idx: Int, realloc_idx: Int, alloc_str_idx: Int): Void
  g_wasm_helper_memcpy_idx = memcpy_idx
  g_wasm_helper_memset_idx = memset_idx
  g_wasm_helper_realloc_idx = realloc_idx
  g_wasm_helper_alloc_str_idx = alloc_str_idx
end

# =============================================================================
# Synthesized runtime functions (built into the WASM module)
# =============================================================================

def _wasm_is_synthesized(name: String): Int
  if name == "alloc" or name == "qz_free" or name == "panic"
    return 1
  end
  if name == "unwrap" or name == "unwrap_or"
    return 1
  end
  if name == "puts" or name == "print" or name == "eputs" or name == "eprint"
    return 1
  end
  if name == "exit"
    return 1
  end
  if name == "ptr_read_byte" or name == "ptr_write_byte" or name == "ptr_add"
    return 1
  end
  if name == "int_to_cptr" or name == "str_byte_len" or name == "str_byte_at"
    return 1
  end
  if name == "band" or name == "bor" or name == "bxor"
    return 1
  end
  if name == "shl" or name == "shr"
    return 1
  end
  # String operations (Phase 1)
  if name == "str_concat" or name == "str_eq" or name == "str_from_int" or name == "to_str"
    return 1
  end
  if name == "str_from_char" or name == "str_slice" or name == "str_char_at"
    return 1
  end
  if name == "str_to_int" or name == "str_hash" or name == "str_cmp"
    return 1
  end
  if name == "str_starts_with" or name == "str_ends_with" or name == "str_contains" or name == "str_find" or name == "__wasm_str_find_raw"
    return 1
  end
  if name == "str_is_empty" or name == "str_size" or name == "str_len_utf8"
    return 1
  end
  if name == "print_int" or name == "eprint_int" or name == "as_string" or name == "str_substr"
    return 1
  end
  if name == "str_byte_slice" or name == "str_codepoint_at" or name == "str_codepoint_byte_len" or name == "str_codepoint_nth" or name == "str_from_codepoint"
    return 1
  end
  # Vec operations (Phase 2)
  if name == "vec_new" or name == "vec_push" or name == "vec_get" or name == "vec_set"
    return 1
  end
  if name == "vec_get_unchecked" or name == "vec_set_unchecked" or name == "vec_size"
    return 1
  end
  if name == "vec_pop" or name == "vec_new_filled" or name == "vec_contains" or name == "vec_index_of"
    return 1
  end
  if name == "vec_clone" or name == "vec_slice" or name == "vec_clear" or name == "vec_reverse"
    return 1
  end
  if name == "vec_sort" or name == "sorted"
    return 1
  end
  if name == "each" or name == "find" or name == "map" or name == "filter" or name == "reduce" or name == "unique"
    return 1
  end
  if name == "zip" or name == "enumerate" or name == "__qz_pair_new"
    return 1
  end
  if name == "vec_free" or name == "vec_shrink_to_fit"
    return 1
  end
  # StringBuilder operations (Phase 3)
  if name == "sb_new" or name == "sb_append" or name == "sb_append_char" or name == "sb_append_int"
    return 1
  end
  if name == "sb_to_string" or name == "sb_len" or name == "sb_size" or name == "sb_clear" or name == "sb_free"
    return 1
  end
  # Option operations (Phase 4)
  if name == "option_some" or name == "option_none" or name == "option_is_some" or name == "option_get" or name == "option_free"
    return 1
  end
  # HashMap operations (Phase 5)
  if name == "hashmap_new" or name == "hashmap_set" or name == "hashmap_get" or name == "hashmap_has"
    return 1
  end
  if name == "hashmap_delete" or name == "hashmap_size" or name == "hashmap_keys" or name == "hashmap_values"
    return 1
  end
  if name == "hashmap_clear" or name == "hashmap_free" or name == "__hashmap_get_raw" or name == "__hashmap_get_sentinel"
    return 1
  end
  if name == "str_hash"
    return 1
  end
  # UFCS aliases — Map$method maps to map_method
  if name == "Map$get" or name == "Map$set" or name == "Map$has"
    return 1
  end
  if name == "Map$delete" or name == "Map$size" or name == "Map$keys" or name == "Map$values" or name == "Map$clear"
    return 1
  end
  # UFCS aliases — Vec$method maps to vec_method
  if name == "Vec$push" or name == "Vec$get" or name == "Vec$set" or name == "Vec$size"
    return 1
  end
  if name == "Vec$pop" or name == "Vec$clear" or name == "Vec$clone" or name == "Vec$slice" or name == "Vec$contains" or name == "Vec$reverse"
    return 1
  end
  # UFCS aliases — String$method maps to str_method
  if name == "String$trim" or name == "String$upcase" or name == "String$downcase"
    return 1
  end
  if name == "String$replace" or name == "String$split" or name == "String$repeat"
    return 1
  end
  if name == "String$contains" or name == "String$starts_with" or name == "String$ends_with" or name == "String$find"
    return 1
  end
  if name == "String$size"
    return 1
  end
  # IntMap operations (Phase 5)
  if name == "intmap_new" or name == "intmap_set" or name == "intmap_get" or name == "intmap_has" or name == "intmap_delete"
    return 1
  end
  if name == "intmap_free" or name == "intmap_size" or name == "intmap_keys" or name == "intmap_values"
    return 1
  end
  # Set operations (Phase 5)
  if name == "set_new" or name == "set_add" or name == "set_has"
    return 1
  end
  if name == "set_delete" or name == "set_size" or name == "set_members" or name == "set_free" or name == "set_clear"
    return 1
  end
  # Int-keyed set wrapper — emitted when slot2="Int" routes set_add through
  # intmap_set instead of hashmap_set. set_has/delete redirect directly to
  # intmap_has/delete and don't need a separate wrapper.
  if name == "set_int_add"
    return 1
  end
  # Char classification (Phase 6)
  if name == "is_digit" or name == "is_alpha" or name == "is_alnum" or name == "is_whitespace" or name == "is_upper" or name == "is_lower"
    return 1
  end
  # Extended string operations (Phase 7)
  if name == "str_trim" or name == "str_trim_left" or name == "str_trim_right"
    return 1
  end
  if name == "str_downcase" or name == "str_upcase"
    return 1
  end
  if name == "str_repeat" or name == "str_replace"
    return 1
  end
  if name == "str_split" or name == "str_join"
    return 1
  end
  if name == "str_chars" or name == "str_reverse"
    return 1
  end
  # Float math (Phase 7)
  if name == "f64_abs" or name == "f64_neg" or name == "f64_sqrt"
    return 1
  end
  if name == "f64_floor" or name == "f64_ceil" or name == "f64_min" or name == "f64_max"
    return 1
  end
  # Bit manipulation (Phase 7)
  if name == "bnot" or name == "popcount" or name == "clz" or name == "ctz"
    return 1
  end
  # Preemptive scheduling (no-op on WASM — single-threaded)
  if name == "fuel_check"
    return 1
  end
  # Misc stubs
  if name == "as_int" or name == "as_int_generic" or name == "as_type" or name == "mem_forget"
    return 1
  end
  if name == "capture_output_start" or name == "capture_output_end"
    return 1
  end
  return 0
end

## Emit bump allocator: maintains a heap pointer global, returns allocated address.
## alloc(size_bytes: i64) -> i64 (address)
def _wasm_synth_alloc(heap_ptr_global: Int): Vec<Int>
  var body = vec_new<Int>()
  # 1 local (result ptr, i64)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = heap_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_GLOBAL_GET)
  wasm_encode::wasm_emit_u32(body, heap_ptr_global)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # local 1 = result
  # heap_ptr += size (param 0), aligned to 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_GLOBAL_GET)
  wasm_encode::wasm_emit_u32(body, heap_ptr_global)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # param: size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  # Align to 8: (ptr + 7) & ~7
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_GLOBAL_SET)
  wasm_encode::wasm_emit_u32(body, heap_ptr_global)
  # Check if we need to grow memory
  # if heap_ptr > memory.size * 65536, grow
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_GLOBAL_GET)
  wasm_encode::wasm_emit_u32(body, heap_ptr_global)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_MEMORY_SIZE)
  wasm_encode::wasm_emit_u32(body, 0)  # memory 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 16)  # 65536 = 1<<16
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_SHL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_MEMORY_GROW)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit qz_free: no-op (bump allocator doesn't free).
## qz_free(ptr: i64) -> void
def _wasm_synth_free(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit panic: calls proc_exit(1).
## panic(msg: i64) -> i64
def _wasm_synth_panic(proc_exit_idx: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, proc_exit_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_UNREACHABLE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit puts: write string to stdout via WASI fd_write.
## puts(str: i64) -> i64
def _wasm_synth_puts(fd_write_idx: Int, heap_ptr_global: Int): Vec<Int>
  var body = vec_new<Int>()
  # Locals: iov_base (i32), len (i64), nwritten_ptr (i32)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I32)
  # Get string length from length-prefix: load i64 from [str - 8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # param: str ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # local 1 = len
  # Build iovec at scratch area (offset 0-15 in linear memory)
  # iov[0].buf = str ptr (i32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # str ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i32_store(body, 0)
  # iov[0].len = str length (i32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i32_store(body, 0)
  # Call fd_write(stdout=1, iovs=0, iovs_len=1, nwritten=8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)  # fd = stdout
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)  # iovs ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)  # iovs_len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 8)  # nwritten ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, fd_write_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # Write newline: store '\n' at offset 12, build iov, call fd_write
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 12)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 10)  # '\n'
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_STORE)
  wasm_encode::wasm_emit_u32(body, 0)  # align
  wasm_encode::wasm_emit_u32(body, 0)  # offset
  # iov for newline
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 12)
  wasm_encode::wasm_emit_i32_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_i32_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, fd_write_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit print: like puts but no trailing newline.
def _wasm_synth_print(fd_write_idx: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Get string length
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # Build iov and call fd_write
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i32_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i32_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, fd_write_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit simple passthrough: returns its argument.
## Used for: unwrap(x) -> x, ptr_add(a,b) -> a+b, etc.
def _wasm_synth_identity(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit ptr_add(ptr, offset) -> ptr + offset
def _wasm_synth_ptr_add(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit ptr_read_byte(ptr) -> byte at ptr
def _wasm_synth_ptr_read_byte(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  # i32.load8_u: opcode 0x2D, align 0, offset 0
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit ptr_write_byte(ptr, byte) -> void
def _wasm_synth_ptr_write_byte(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  # i32.store8: opcode 0x3A, align 0, offset 0
  wasm_encode::wasm_emit_byte(body, 0x3A)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit str_byte_len(str) -> length from prefix
def _wasm_synth_str_byte_len(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit str_byte_at(str, idx) -> byte
def _wasm_synth_str_byte_at(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit a binary operation: op(a, b) -> a OP b
def _wasm_synth_binop(opcode: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, opcode)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# Phase 1: String operation synthesizers
# =============================================================================

## str_concat(a, b): concatenate two Quartz strings.
## alloc_str(len_a + len_b), memcpy a, memcpy b.
def _wasm_synth_str_concat(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: len_a, len_b, total_len, result_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_a = str_byte_len(a) — load i64 from a - 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # param a
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # local 2 = len_a
  # len_b = str_byte_len(b)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # param b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # local 3 = len_b
  # total = len_a + len_b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # local 4 = total_len
  # result_ptr = alloc_str(total_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)  # local 5 = result_ptr
  # memcpy(result_ptr, a, len_a)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # a
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # len_a
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # memcpy(result_ptr + len_a, b, len_b)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)  # result_ptr + len_a
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # len_b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # Return result_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_eq(a, b): compare two strings for equality. Returns 1 if equal, 0 otherwise.
## Uses a result local instead of block values for simplicity.
def _wasm_synth_str_eq(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len_a, i, result
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_a = load i64 from a - 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # len_a
  # result = 1 (assume equal)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # result = 1
  # if len_a != len_b → result = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # result = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # Same length — compare bytes: i = 0; while i < len_a
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= len_a → break (all bytes matched, result stays 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)  # br_if to block end
  # Compare a[i] vs b[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # Mismatch: result = 0, break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 2)  # break out of block
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if (mismatch)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)  # continue loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if/else (len check)
  # Return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_from_int(n): convert integer to decimal string.
## Handles negative numbers. Uses repeated division by 10.
def _wasm_synth_str_from_int(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: is_neg, abs_val, buf_ptr, digit_count, result_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Allocate temp buffer (21 bytes max for i64 decimal: "-9223372036854775808")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 24)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # buf_ptr
  # digit_count = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Handle n == 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # n
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # store '0' at buf[0], digit_count = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 48)  # '0'
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # digit_count = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # is_neg = n < 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # is_neg
  # abs_val = is_neg ? -n : n
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # abs_val
  # Extract digits in reverse: while abs_val > 0: buf[digit_count++] = '0' + abs_val % 10; abs_val /= 10
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # buf[digit_count] = '0' + (abs_val % 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # buf_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)  # digit_count
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_REM_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 48)  # '0'
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_ADD)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # digit_count++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # abs_val /= 10
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_DIV_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 1)  # continue loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end else (n != 0)
  # Now buf has digits in reverse. Build result string.
  # total_len = digit_count + is_neg
  # result_ptr = alloc_str(total_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)  # result_ptr
  # If negative, write '-' at result[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 45)  # '-'
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Copy digits in reverse order: result[is_neg + i] = buf[digit_count - 1 - i]
  # Reuse local 2 as loop counter i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # result[is_neg + i] = buf[digit_count - 1 - i]
  # dst addr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # is_neg
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # i
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  # src byte: buf[digit_count - 1 - i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 1)  # continue loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  # Return result_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## to_str(val): convert integer to decimal string.
##
## INTERP_STRING (the dominant `#{expr}` use case) dispatches at MIR-lower
## time — see `mir_lower.qz` NODE_INTERP_STRING handling, which strips the
## parser-emitted `to_str(...)` wrap when the inner expression has type
## String. So `to_str` only sees Int values from interp parts.
##
## A runtime alignment+length+null heuristic (as the LLVM backend does, see
## `codegen_runtime.qz:6317`) cannot work safely on WASM because linear
## memory allocations live at low addresses (often < 65535) — the LLVM
## guard `val > 0xFFFF` would reject every legitimate WASM string pointer.
## Compile-time dispatch is sound; runtime dispatch is fragile.
##
## If user code calls `to_str(s)` on a String directly (outside of
## interpolation), this will incorrectly format it as an integer. Rare in
## practice — `s.to_s()` UFCS goes through impl-method dispatch, not here.
def _wasm_synth_to_str(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)  # 0 locals
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_from_int"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_from_char(ch): create a 1-byte string from char code.
def _wasm_synth_str_from_char(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: data_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # data_ptr = alloc_str(1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # store byte at data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_is_empty(s): return 1 if string length is 0.
def _wasm_synth_str_is_empty(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## print_int(n): convert to string and print (no newline).
def _wasm_synth_print_int(fd_write_idx: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # call str_from_int(n)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_from_int"))
  # call puts(str) — LLVM @print_int uses "%ld\n" so a trailing newline
  # is part of the contract.
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("puts"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_starts_with(s, prefix): check if s begins with prefix.
def _wasm_synth_str_starts_with(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len_s, len_p, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_s = str_byte_len(s)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # len_p = str_byte_len(prefix)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # if len_p > len_s → return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # Compare first len_p bytes using str_eq-style loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= len_p → break with 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # if s[i] != prefix[i] → break with 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if/else
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_ends_with(s, suffix): check if s ends with suffix.
def _wasm_synth_str_ends_with(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len_s, len_suf, offset
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_s
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # len_suf
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # if len_suf > len_s → return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # Call str_eq on the suffix portion: str_eq(s + (len_s - len_suf), suffix)
  # But we can't easily create a substring pointer without alloc. Instead, call starts_with with offset.
  # Simpler: use byte-by-byte comparison from offset = len_s - len_suf
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # offset = len_s - len_suf
  # Compare bytes: i from 0 to len_suf
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # reuse as i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # s[offset + i] vs suffix[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if/else
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# Phase 2: Vec operation synthesizers
# =============================================================================
# Vec layout: [i64 cap=0][i64 size=8][i64 data_ptr=16][i64 elem_width=24] = 32 bytes

## vec_new(): allocate empty vec with capacity 8.
def _wasm_synth_vec_new(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: hdr_ptr, data_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  # hdr = alloc(32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 0)  # local 0 = hdr
  # data = alloc(64)  (8 slots * 8 bytes)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # local 1 = data
  # hdr[0] = 8 (capacity)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # hdr[1] = 0 (size)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # hdr[2] = data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 16)
  # hdr[3] = 8 (elem_width)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_i64_store(body, 24)
  # Return hdr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_push(vec, val): push value, growing if needed. Returns 0.
def _wasm_synth_vec_push(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: cap, size, data_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Load cap, size, data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # vec
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # data_ptr
  # if size >= cap → grow
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # newcap = cap * 2 (min 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # cap = cap * 2
  # realloc(data_ptr, old_size * 8, new_cap * 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)  # old data
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # old size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # new cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_realloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # data = new data
  # Store back: hdr[0] = newcap, hdr[2] = new data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_i64_store(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if (grow)
  # data[size] = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)  # data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # val
  wasm_encode::wasm_emit_i64_store(body, 0)
  # size++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_get(vec, idx): load data[idx] with bounds check (trap on OOB).
def _wasm_synth_vec_get(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)  # no locals
  # Bounds check: if idx < 0 or idx >= size → unreachable
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # idx
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)  # size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)  # either condition
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_UNREACHABLE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Load data[idx]: data_ptr + idx * 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)  # data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_get_unchecked(vec, idx): no bounds check.
def _wasm_synth_vec_get_unchecked(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_set(vec, idx, val): store with bounds check.
def _wasm_synth_vec_set(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # Bounds check
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_UNREACHABLE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # data_ptr + idx * 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # val
  wasm_encode::wasm_emit_i64_store(body, 0)
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_size: return hdr[1] (size field).
def _wasm_synth_vec_size(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_pop: decrement size, return last element.
def _wasm_synth_vec_pop(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: new_size
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # new_size = size - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # Store new size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # Return data[new_size]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)  # data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_clear: set size = 0.
def _wasm_synth_vec_clear(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_new_filled(count, val): create vec pre-filled with count copies of val.
def _wasm_synth_vec_new_filled(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: hdr, data, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  # hdr = alloc(32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = alloc(count * 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # count
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # hdr[0]=count, hdr[1]=count, hdr[2]=data, hdr[3]=8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_i64_store(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_i64_store(body, 24)
  # Fill: for i in 0..count: data[i] = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_reverse(vec): reverse elements in place.
def _wasm_synth_vec_reverse(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: size, data, left, right, tmp
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = vec[1], data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # left = 0, right = size - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # while left < right: swap data[left] and data[right]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # tmp = data[left]  (reuse local 1 since we read size already)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # tmp
  # data[left] = data[right]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # data[right] = tmp
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # left++, right--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_contains(vec, val): linear scan, return 1 if found.
def _wasm_synth_vec_contains(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: size, data_ptr, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Load size + data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # data_ptr
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= size → break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # if data[i] == val → return 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # Not found
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_index_of(vec, val): linear scan, return index or -1.
def _wasm_synth_vec_index_of(): Vec<Int>
  var body = vec_new<Int>()
  # Same structure as contains but returns index
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# Phase 3: StringBuilder synthesizers
# =============================================================================
# SB layout: [i64 cap=0][i64 len=8][i64 data_ptr=16] = 24 bytes

## sb_new(): create new StringBuilder.
def _wasm_synth_sb_new(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  # hdr = alloc(24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 24)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 0)
  # data = alloc(64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # hdr[0] = 64 (cap)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 64)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # hdr[1] = 0 (len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # hdr[2] = data
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sb_append(sb, str): append string bytes to StringBuilder, growing if needed.
def _wasm_synth_sb_append(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: cap, len, data_ptr, str_len
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Load sb fields
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # data_ptr
  # str_len = str_byte_len(str)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)  # str_len
  # if len + str_len > cap → grow
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # Double cap until sufficient
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  # Realloc data
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # old len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # new cap
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_realloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Store back cap + data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_i64_store(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if (grow)
  # memcpy(data + len, str, str_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # str (src)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)  # str_len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # len += str_len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_i64_store(body, 8)
  # Return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sb_append_char(sb, ch): append single byte.
def _wasm_synth_sb_append_char(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # Use sb_append with str_from_char
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # sb
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # ch
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_from_char"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("sb_append"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sb_append_int(sb, n): append integer as string.
def _wasm_synth_sb_append_int(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("to_str"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("sb_append"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sb_to_string(sb): convert to Quartz string.
def _wasm_synth_sb_to_string(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: len, result_ptr
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len = sb[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # result_ptr = alloc_str(len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # memcpy(result_ptr, sb.data_ptr, len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)  # data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # Return result_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sb_size: return sb[1].
def _wasm_synth_sb_size(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# Phase 4: Option synthesizers
# =============================================================================

## option_some(val): alloc [tag=0, payload=val].
def _wasm_synth_option_some(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # tag = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # payload = val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## option_none(): alloc [tag=1, payload=0].
def _wasm_synth_option_none(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## option_is_some(opt): return tag == 0.
def _wasm_synth_option_is_some(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## option_get(opt): return payload.
def _wasm_synth_option_get(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# Phase 6: Char classification synthesizers
# =============================================================================

## is_digit(ch): ch >= 48 && ch <= 57
def _wasm_synth_is_digit(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 48)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 57)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## is_alpha(ch): (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
def _wasm_synth_is_alpha(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # upper: ch >= 65 && ch <= 90
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 65)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 90)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  # lower: ch >= 97 && ch <= 122
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 97)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 122)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# =============================================================================
# =============================================================================
# Phase 7: Extended string operations
# =============================================================================

## str_to_int(s): parse decimal string to integer. Handles negative.
def _wasm_synth_str_to_int(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: len, i, result, is_neg
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # len
  # result = 0, i = 0, is_neg = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # if len > 0 && s[0] == '-': is_neg = 1, i = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 45)  # '-'
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # while i < len: result = result * 10 + (s[i] - '0'); i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # result = result * 10 + (s[i] - 48)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 48)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # if is_neg: result = -result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_contains(s, sub): return 1 if sub is found in s.
def _wasm_synth_str_contains(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # Delegate to __wasm_str_find_raw and check if >= 0. (Cannot use the
  # user-level str_find here — that returns an Option<Int> heap-box
  # pointer which is always positive, breaking the >= 0 test.)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_str_find_raw"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_find(s, sub): user-level entry — returns Option<Int> per the
## typecheck registry (TYPE_OPTION). Wraps __wasm_str_find_raw and boxes
## the raw index into Option::Some(idx) (tag 0, payload idx) or
## Option::None (tag 1) — matching LLVM's qz_str_find_utf8 contract.
##
## Pre-fix this synth returned the raw index directly, which compiled but
## broke any caller using `match opt { Some(v) => ... | None => ... }` —
## the i64 raw int was treated as a heap-box pointer and the match read
## arbitrary memory at the int's value.
def _wasm_synth_str_find(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: raw_idx
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # raw = __wasm_str_find_raw(s, sub)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_str_find_raw"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # if raw < 0: return option_none() else: return option_some(raw)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("option_none"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("option_some"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## __wasm_str_find_raw(s, sub): naive substring search, returns raw index
## or -1. Wrapped by _wasm_synth_str_find for the user-level Option<Int>
## contract.
def _wasm_synth_str_find_raw(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: len_s, len_sub, i, j
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_s, len_sub
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # if len_sub > len_s → return -1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # if len_sub == 0 → return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Naive search: for i in 0..len_s-len_sub+1: check s[i..i+len_sub] == sub
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i > len_s - len_sub → break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Check s[i..i+len_sub] == sub using str_starts_with on offset pointer
  # We can use a simple inner loop: j = 0; while j < len_sub && s[i+j] == sub[j]: j++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)  # j = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if j >= len_sub → found! return i
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # if s[i+j] != sub[j] → break inner loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)  # break inner
  # j++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)  # continue inner
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end inner loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end inner block
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)  # continue outer
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end outer loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end outer block
  # Not found
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_slice(s, start, end): extract substring [start, end).
def _wasm_synth_str_slice(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: new_len, result
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # new_len = end - start
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)  # end
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # start
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # result = alloc_str(new_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # memcpy(result, s + start, new_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7: Extended string operations
# =============================================================================

## str_trim(s): trim leading and trailing whitespace (space, tab, newline, cr).
## Returns new string with whitespace removed from both ends.
def _wasm_synth_str_trim(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: len, start, end_pos, new_len
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # start = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # end_pos = len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # Scan from left: while start < end_pos && is_whitespace(s[start])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if start >= end_pos, break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load byte at s[start]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # Check if whitespace: 32(space), 9(tab), 10(lf), 13(cr)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 13)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, 0x01)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # start++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Scan from right: while end_pos > start && is_whitespace(s[end_pos-1])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load byte at s[end_pos-1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # Check whitespace
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 13)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, 0x01)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # end_pos--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Call str_slice(s, start, end_pos)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_downcase(s): return new string with all ASCII uppercase converted to lowercase.
def _wasm_synth_str_downcase(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: len, result, i (i64), temp_byte (i32)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_u32(body, 1)  # group 2: 1 i32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I32)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # result = alloc_str(len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # memcpy(result, s, len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i = 0; loop: convert A-Z (65-90) to a-z (97-122) by adding 32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load byte at result[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # If byte >= 65 && byte <= 90, store byte + 32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 4)  # reuse local 4 as temp byte
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 65)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_GE_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 90)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_LE_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # Store byte + 32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_ADD)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_upcase(s): return new string with all ASCII lowercase converted to uppercase.
## Same as str_downcase but converts a-z (97-122) to A-Z (65-90) by subtracting 32.
def _wasm_synth_str_upcase(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_u32(body, 1)  # group 2: 1 i32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I32)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # result = alloc_str(len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # memcpy(result, s, len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i = 0; loop: convert a-z (97-122) to A-Z by subtracting 32
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 97)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_GE_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 122)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_LE_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_SUB)
  wasm_encode::wasm_emit_byte(body, 0x3A)  # i32.store8
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_repeat(s, count): repeat string count times.
def _wasm_synth_str_repeat(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len, total_len, result
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # total_len = len * count
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # result = alloc_str(total_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Loop: copy s into result[i*len] for i in 0..count
  # Reuse local 3 as offset (starts at 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # memcpy(result + offset, s, len) where offset = i * len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7: Float math (native WASM f64 instructions)
# =============================================================================
# Pattern: reinterpret i64 as f64, apply f64 op, reinterpret back to i64.

## Emit a unary f64 op: reinterpret_f64(i64 param) -> f64.op -> reinterpret_i64
def _wasm_synth_f64_unary(opcode: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_F64_REINTERPRET_I64)
  wasm_encode::wasm_emit_byte(body, opcode)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_REINTERPRET_F64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit a binary f64 op: reinterpret both args, apply op, reinterpret result
def _wasm_synth_f64_binary(opcode: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_F64_REINTERPRET_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_F64_REINTERPRET_I64)
  wasm_encode::wasm_emit_byte(body, opcode)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_REINTERPRET_F64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7: Bit manipulation (native WASM i64 instructions)
# =============================================================================

## bnot(x): bitwise NOT, i64.xor(x, -1)
def _wasm_synth_bnot(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_XOR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## Emit a unary i64 op (popcount, clz, ctz)
def _wasm_synth_i64_unary(opcode: Int): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, opcode)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7b: Char classification (proper implementations)
# =============================================================================

## is_alnum(ch): is_digit || is_alpha
def _wasm_synth_is_alnum(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # digit: ch >= 48 && ch <= 57
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 48)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 57)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  # upper: ch >= 65 && ch <= 90
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 65)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 90)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  # lower: ch >= 97 && ch <= 122
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 97)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 122)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## is_whitespace(ch): ch == 32 || ch == 9 || ch == 10 || ch == 13
def _wasm_synth_is_whitespace(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 13)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## is_upper(ch): ch >= 65 && ch <= 90
def _wasm_synth_is_upper(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 65)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 90)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## is_lower(ch): ch >= 97 && ch <= 122
def _wasm_synth_is_lower(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 97)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 122)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7c: unwrap_or proper implementation
# =============================================================================

## unwrap_or(opt, default): if tag == 0 (Some) return payload, else return default.
## Option layout: [i64 tag][i64 payload], tag 0=Some, 1=None.
def _wasm_synth_unwrap_or(): Vec<Int>
  var body = vec_new<Int>()
  wasm_encode::wasm_emit_u32(body, 0)
  # Load tag from opt (param 0) at offset 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # if tag == 0 (Some)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # Return payload at offset 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # Return default (param 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7d: str_cmp lexicographic comparison
# =============================================================================

## str_cmp(a, b): lexicographic comparison. Returns <0, 0, or >0.
def _wasm_synth_str_cmp(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: len_a, len_b, min_len, i, diff
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len_a = *(a - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # len_b = *(b - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # min_len = len_a < len_b ? len_a : len_b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_SELECT)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # Loop: compare bytes
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= min_len, break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load a[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # Load b[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # if a[i] != b[i], return a[i] - b[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)  # diff (not min_len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # All bytes equal: return len_a - len_b
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 7e: vec_clone and vec_slice
# =============================================================================
# Vec layout: [i64 cap][i64 size][i64 data_ptr][i64 elem_width=8] — 32 bytes

## vec_clone(v): allocate new vec, copy data array.
def _wasm_synth_vec_clone(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: cap, size, data_ptr, result
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # cap = v[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # size = v[8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data_ptr = v[16]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # result = alloc(32) for vec header
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Store cap, size, elem_width=8 in new header
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_i64_store(body, 24)
  # Alloc new data array: cap * 8 bytes
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # Store data_ptr in header
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_i64_store(body, 16)
  # memcpy(new_data, old_data, size * 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # Return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_sort(v): in-place insertion sort, ascending. Returns 0 (void
## sentinel — Quartz's existential model emits result i64 even for
## conceptually-void intrinsics; LLVM peer is `qz_vec_sort` calling
## libc qsort, which has no WASM equivalent).
##
## Insertion sort is O(n²) but small and dependency-free. For large
## datasets users should switch to the LLVM backend. The dominant WASM
## use case is small interactive collections, which insertion sort
## handles fine. Stability and ascending order match the LLVM helper.
def _wasm_synth_vec_sort(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: size, data, i, key, j
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # i = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # outer: while i < size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= size, br to outer-exit
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # key = i64.load(data + i*8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # j = i - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # inner: while j >= 0 && data[j] > key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if j < 0, br to inner-exit
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # if data[j] <= key, br to inner-exit
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # data[j+1] = data[j]
  # dst addr: data + (j+1)*8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  # value: data[j]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # j = j - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # br 0: continue inner loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end inner loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end inner block
  # data[j+1] = key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_i64_store(body, 0)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # br 0: continue outer loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end outer loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end outer block
  # return 0 (void sentinel)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## __qz_pair_new(a, b): build a 2-element Vec<Int>. Used by zip and
## enumerate to produce pair-of-(i64, i64) records. Mirrors LLVM's
## `__qz_pair_new` in `codegen_runtime.qz:7447` (runtime helper).
def _wasm_synth_pair_new(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: result
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = vec_new(); vec_push(result, a); vec_push(result, b); return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## zip(a, b): produce Vec of pair-Vecs, length = min(a.size, b.size).
def _wasm_synth_zip(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: sa, sb, da, db, i, result, size  (params 0=a, 1=b)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # sa = a[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # sb = b[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # da = a[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # db = b[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # size = min(sa, sb)  -> stored in local 7 (no-wait; 6=result, 7=size, 8=i)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_SELECT)
  # store min as `sa` (reuse local 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # exit if i >= size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # vec_push(result, __qz_pair_new(da[i], db[i]))
  # Stack discipline: push result first so post-call stack is [result, pair].
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  # val_a = da[i*8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # val_b = db[i*8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # pair = __qz_pair_new(val_a, val_b)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__qz_pair_new"))
  # vec_push(result, pair); drop ret
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## enumerate(v): produce Vec of pair-Vecs (idx, val).
def _wasm_synth_enumerate(): Vec<Int>
  var body = vec_new<Int>()
  # 4 locals: size, data, i, result  (param 0=v)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = v[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # data = v[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # vec_push(result, __qz_pair_new(i, data[i*8]))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__qz_pair_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## unique(v): return new Vec<Int> with duplicates removed (sort + dedup).
## Mirrors LLVM `cg_intrinsic_collection.qz::unique` semantics — output
## is sorted ascending, NOT original order. Implementation: call sorted(v)
## to produce a clone+sorted intermediate, then walk linearly pushing
## only elements that differ from the previously-pushed.
def _wasm_synth_unique(): Vec<Int>
  var body = vec_new<Int>()
  # 6 locals: s, size, data, i, prev, result (param 0=v)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # s = sorted(v)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("sorted"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # size = s[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = s[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # if size == 0, return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # vec_push(result, data[0])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # prev = data[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # i = 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # cur = data[i*8]; if cur != prev: push, prev = cur
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # Dup-and-stash: tee into transient (no extra local — use param 0 since v
  # is no longer needed after sorted())
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## sorted(v): clone v, sort the clone in-place, return the clone.
## Mirrors LLVM `cg_intrinsic_collection.qz::sorted` which clones via
## explicit alloc + memcpy then calls qsort on the result data.
def _wasm_synth_sorted(): Vec<Int>
  var body = vec_new<Int>()
  # 1 local: cloned vec handle
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # cloned = vec_clone(v)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_clone"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # vec_sort(cloned) — discard void-sentinel result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_sort"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # return cloned
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## each(v, fn): iterate v, calling fn(elem) for each element. Returns 0.
##
## Closure dispatch mirrors `cg_intrinsic_collection.qz::each` and the
## generic `MIR_CALL_INDIRECT` path in `codegen_wasm.qz:864-942`:
##   * `(fn & 1) == 1` → closure: env_ptr is `fn & ~1`; func table_idx
##     is at `env[0] >> 1`; call signature is `(env, val) -> i64`.
##   * `(fn & 1) == 0` → plain function: table_idx is `fn >> 1`; call
##     signature is `(val) -> i64`.
##
## Both call_indirect signatures are registered through
## `_wasm_get_type_idx` (now in this module so synth bodies can register
## types without needing the codegen_wasm circular import).
def _wasm_synth_each(): Vec<Int>
  var body = vec_new<Int>()
  var closure_type = _wasm_get_type_idx(2, 1)  # (env, val) -> i64
  var plain_type = _wasm_get_type_idx(1, 1)    # (val) -> i64
  # 4 locals: size, data, i, val   (params 0=vec, 1=fn)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # outer block / loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= size, br to outer-exit
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # val = i64.load(data + i*8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # closure dispatch: if (fn & 1) closure path else plain
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # closure path: push env, val, table_idx; call_indirect closure_type
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, closure_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # plain path: push val, table_idx; call_indirect plain_type
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, plain_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # br 0: continue loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # return 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## map(v, fn): allocate new Vec<Int>, push fn(elem) for each elem, return.
## Same closure-dispatch shape as `each` / `find`. The mapped value
## stays on the WASM stack across the if/else (closure vs plain) and is
## consumed directly by `vec_push(result, mapped)` — a cheap
## stack-discipline trick that avoids a temporary local.
def _wasm_synth_map(): Vec<Int>
  var body = vec_new<Int>()
  var closure_type = _wasm_get_type_idx(2, 1)
  var plain_type = _wasm_get_type_idx(1, 1)
  # 5 locals: size, data, i, val, result   (params 0=vec, 1=fn)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # outer block / loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= size, exit loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # val = data[i*8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # Push `result` so the post-call stack is [result, mapped] for vec_push
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  # closure dispatch
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # closure: env, val, table_idx -> i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, closure_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # plain: val, table_idx -> i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, plain_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Stack: [result, mapped] → vec_push(result, mapped); drop ret
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## filter(v, fn): allocate new Vec<Int>, conditionally push elem if
## fn(elem) is non-zero. Same closure-dispatch shape as `map`; differs
## in that the predicate result gates a vec_push rather than feeding it.
def _wasm_synth_filter(): Vec<Int>
  var body = vec_new<Int>()
  var closure_type = _wasm_get_type_idx(2, 1)
  var plain_type = _wasm_get_type_idx(1, 1)
  # 6 locals: size, data, i, val, result, pred  (params 0=vec, 1=fn)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # exit if i >= size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # val = data[i*8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # closure dispatch produces predicate
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # closure
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, closure_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # plain
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, plain_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # if predicate non-zero, vec_push(result, val)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## reduce(v, init, fn): fold over v, threading accumulator. fn takes
## (acc, val) — different shape from map/filter/each (1-arg) so the
## type indices differ: closure = `(env, acc, val) -> i64`,
## plain = `(acc, val) -> i64`.
def _wasm_synth_reduce(): Vec<Int>
  var body = vec_new<Int>()
  var closure_type = _wasm_get_type_idx(3, 1)  # (env, acc, val) -> i64
  var plain_type = _wasm_get_type_idx(2, 1)    # (acc, val) -> i64
  # 4 locals: size, data, i, val   (params 0=vec, 1=init, 2=fn; acc reuses 1)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # exit if i >= size
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # val = data[i*8]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # acc = closure_dispatch(fn, acc, val)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # closure: env, acc, val, table_idx -> i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, closure_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # plain: acc, val, table_idx -> i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, plain_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # store back to acc (param local 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # return acc
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## find(v, fn): return first elem where fn(elem) is non-zero. Returns 0
## (sentinel for "not found") if no match — mirrors LLVM's `find` impl
## which uses the 0 sentinel rather than Option<T>.
##
## Same closure-dispatch shape as `each`: low-bit tag selects closure
## vs plain call; closure call passes `(env, val)`, plain passes `(val)`.
## Differs from `each` in that the call's result is preserved (not
## dropped) and used as the predicate gate for the early return.
def _wasm_synth_find(): Vec<Int>
  var body = vec_new<Int>()
  var closure_type = _wasm_get_type_idx(2, 1)
  var plain_type = _wasm_get_type_idx(1, 1)
  # 5 locals: size, data, i, val, pred_result   (params 0=vec, 1=fn)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # size = vec[1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # data = vec[2]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # outer block (result i64) — break out with the matched val
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # inner block — fall through to "not found" path
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= size, br to inner-block-exit (= notfound path)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # val = i64.load(data + i*8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # closure dispatch
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # closure path: env, val, table_idx → call_indirect closure_type → i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, closure_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  # plain path: val, table_idx → call_indirect plain_type → i64
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SHR_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL_INDIRECT)
  wasm_encode::wasm_emit_u32(body, plain_type)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if (result i64)
  # Stack now has the predicate result. If non-zero, br outer-block with val.
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_NE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 3)  # br outer block (3 nesting levels: if, loop, inner-block, outer-block)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end pred-if
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end inner block
  # not-found tail: leave 0 on stack (outer block result)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end outer block (result i64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## vec_slice(v, start, end): create new vec from sub-range [start, end).
def _wasm_synth_vec_slice(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: new_size, result, new_data
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # new_size = end - start
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # result = alloc(32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  var alloc_idx = _wasm_get_func_idx("alloc")
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Store cap=new_size, size=new_size, elem_width=8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_i64_store(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_i64_store(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_i64_store(body, 24)
  # Alloc data: new_size * 8
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, alloc_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # Store data_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_i64_store(body, 16)
  # memcpy(new_data, old_data + start*8, new_size*8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  # old_data_ptr = v[16]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_memcpy_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_trim_left(s): trim leading whitespace only, return str_slice(s, start, len).
def _wasm_synth_str_trim_left(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len, start, temp_byte
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # start = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # Scan left: while start < len && is_ws(s[start])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load s[start]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # Check ws: ==32 || ==9 || ==10 || ==13, break if not
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 13)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, 0x01)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # start++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Call str_slice(s, start, len)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_trim_right(s): trim trailing whitespace only, return str_slice(s, 0, end_pos).
def _wasm_synth_str_trim_right(): Vec<Int>
  var body = vec_new<Int>()
  # 2 locals: len/end_pos, temp_byte
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # end_pos = *(s - 8)  (= len initially)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # Scan right: while end_pos > 0 && is_ws(s[end_pos-1])
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # Load s[end_pos - 1]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  # Check ws
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_TEE)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 9)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 10)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 13)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_OR)
  wasm_encode::wasm_emit_byte(body, 0x01)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # end_pos--
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Call str_slice(s, 0, end_pos)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_replace(s, from, to): replace all occurrences of from with to.
## Uses str_find + str_slice + str_concat loop.
def _wasm_synth_str_replace(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: result, pos, start, len_from, found
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = "" (empty string via alloc_str(0))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # start = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # len_from = *(from - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # len_s = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # Loop: find from in s starting at pos=start
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # found = str_find(str_slice(s, start, len_s), from)
  # First compute remaining = str_slice(s, start, len_s)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  # __wasm_str_find_raw(remaining, from) — internal raw-int variant; the
  # user-level str_find returns Option<Int> which would invalidate the
  # `< 0` test below.
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_str_find_raw"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 7)
  # if found < 0, break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # result = str_concat(result, str_slice(s, start, start+found))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_concat"))
  # result = str_concat(result_so_far, to)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_concat"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # start = start + found + len_from
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 7)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Append remaining: result = str_concat(result, str_slice(s, start, len_s))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_concat"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_split(s, delim): split string by delimiter, return Vec<String>.
def _wasm_synth_str_split(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: result_vec, start, len_s, len_d, found
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result_vec = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # start = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # len_s = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # len_d = *(delim - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # Loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # found = str_find(str_slice(s, start, len_s), delim)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  # Internal raw-int variant — see _wasm_synth_str_find_raw note above.
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("__wasm_str_find_raw"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # if found < 0, break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # vec_push(result_vec, str_slice(s, start, start+found))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # start = start + found + len_d
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Push final segment: vec_push(result_vec, str_slice(s, start, len_s))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_slice"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_reverse(s): return a new string with codepoints (NOT bytes) in
## reverse order. Mirrors LLVM `qz_str_reverse_utf8` (codegen_runtime.qz),
## which is the function user `str_reverse(s)` calls actually route to on
## the LLVM side. Walks src forward by codepoint width (1/2/3/4 bytes
## determined by the UTF-8 prefix byte) and writes each span at a
## decreasing destination offset.
##
## For pure ASCII (byte == codepoint), this reduces to the same byte-level
## reversal an earlier version implemented; for any input containing
## multi-byte sequences this preserves codepoint integrity instead of
## scrambling the constituent bytes (e.g., "héllo" → "olléh", not invalid
## UTF-8 with the 'é' bytes split + re-attached to neighbours).
def _wasm_synth_str_reverse(): Vec<Int>
  var body = vec_new<Int>()
  # 6 locals: blen(1), dst(2), si(3), di(4), byte(5), step(6)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # blen = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # dst = alloc_str(blen)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # si = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # di = blen
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # block / loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if si >= blen: br 1 (exit)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # byte = load8_u(s + si)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # step = (byte < 128) ? 1 : (byte < 224) ? 2 : (byte < 240) ? 3 : 4
  # Build the nested select via three IF/ELSE blocks. Default 4, narrow
  # down through 3, 2, 1 from inside out.
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 128)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 224)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 240)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_LT_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_ELSE)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)
  # di -= step
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # memory.copy(dst + di, s + si, step)  — preserves codepoint span order
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_memory_copy(body)
  # si += step
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # return dst
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_chars(s): return Vec<Int> of byte values for each byte in `s`. Used by
## `for c in s` desugaring (mir_lower_iter). Mirrors LLVM `qz_str_chars` from
## codegen_runtime.qz — same byte-level (not codepoint) iteration semantics.
def _wasm_synth_str_chars(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: len(1), result(2), i(3)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # len = *(s - 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # result = vec_new()
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_new"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # block / loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= len: break (br 1 to exit block)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # vec_push(result, *(s+i)) — push result, then byte, then call+drop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_push"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_DROP)
  # i = i + 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # br loop_start
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # return result
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## str_join(vec, sep): join Vec<String> with separator. Returns concatenated string.
def _wasm_synth_str_join(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: result, size, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # result = alloc_str(0) (empty string)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, g_wasm_helper_alloc_str_idx)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # size = vec_size(vec)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_size"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  # Loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # if i > 0, concat sep first
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GT_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_concat"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # result = str_concat(result, vec_get(vec, i))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("vec_get"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_concat"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

# Phase 5: HashMap, IntMap, Set synthesizers
# =============================================================================
# HashMap layout: [i64 cap=0][i64 size=8][i64 keys_ptr=16][i64 values_ptr=24][i64 states_ptr=32] = 40 bytes
# States: byte array, 0=empty, 1=occupied, 2=deleted

## str_hash(s): FNV-1a hash of string bytes.
def _wasm_synth_str_hash(): Vec<Int>
  var body = vec_new<Int>()
  # 3 locals: h, len, i
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # h = FNV basis (14695981039346656037 as signed = -3750763034362895579)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, -3750763034362895579)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)  # local 1 = h
  # len = str_byte_len(s)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # len
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # i
  # Loop: while i < len
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)  # break
  # h ^= byte[i]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # h
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # s
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)  # i
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_EXTEND_I32_U)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_XOR)
  # h *= FNV prime (1099511628211)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1099511628211)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 1)
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end

## __wasm_hm_find_slot(map, key): linear probing find. Returns positive=found, negative=first-empty.
def _wasm_synth_hm_find_slot(): Vec<Int>
  var body = vec_new<Int>()
  # 5 locals: cap, mask, h_idx, i, slot
  wasm_encode::wasm_emit_u32(body, 1)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_I64)
  # cap = map[0]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # map
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 2)  # cap
  # mask = cap - 1
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 3)  # mask
  # h_idx = str_hash(key) & mask
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_hash"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 4)  # h_idx
  # i = 0
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  # Loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BLOCK)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOOP)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # if i >= cap → break
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_GE_S)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR_IF)
  wasm_encode::wasm_emit_u32(body, 1)
  # slot = (h_idx + i) & mask
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 4)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 3)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_AND)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 6)  # slot
  # Load state byte: states_ptr + slot
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)  # map
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)  # states_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)  # slot
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)  # i32.load8_u
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # if state == 0 (empty) → return -(slot + 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQZ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)  # -(slot + 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  # Reload state for occupied check
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 32)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, 0x2D)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_u32(body, 0)
  # if state == 1 (occupied) && keys[slot] == key → return slot
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_CONST)
  wasm_encode::wasm_emit_i32(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_EQ)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  # Load keys[slot]
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 16)  # keys_ptr
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 8)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_MUL)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_i64_load(body, 0)
  # Call str_eq(keys[slot], key)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 1)  # key
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_CALL)
  wasm_encode::wasm_emit_u32(body, _wasm_get_func_idx("str_eq"))
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I32_WRAP_I64)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_IF)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_TYPE_VOID)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 6)  # return slot
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_RETURN)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if str_eq
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end if occupied
  # i++
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 1)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_ADD)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_SET)
  wasm_encode::wasm_emit_u32(body, 5)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_BR)
  wasm_encode::wasm_emit_u32(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end loop
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)  # end block
  # Fallthrough: return -(cap)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_CONST)
  wasm_encode::wasm_emit_i64(body, 0)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_LOCAL_GET)
  wasm_encode::wasm_emit_u32(body, 2)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_I64_SUB)
  wasm_encode::wasm_emit_byte(body, wasm_encode::WASM_END)
  return body
end




## __wasm_im_find_slot(map, key): integer key find using multiplicative hash.
def _wasm_synth_im_find_slot(): Vec<Int>
  var body = vec_new<Int>()
  # Same as hm_find_slot but with integer hash and integer key comparison
