## Platform-specific linker stack size flag.
@cfg(os: "macos")
def _linker_stack_flag(): String = "-Wl,-stack_size,0x2000000"

@cfg(os: "linux")
def _linker_stack_flag(): String = ""

## Compile IR string to a native binary at output_path.
## If release is true, applies opt -O2 and strips debug info.
## Returns 0 on success, 1 on failure.
def build_binary(ir: String, output_path: String, release: Int): Int
  var ir_path = "/tmp/_quartz_build.ll"
  var opt_path = "/tmp/_quartz_build_opt.ll"
  var obj_path = "/tmp/_quartz_build.o"
  var err_path = "/tmp/_quartz_build.err"

  var _wr = fio_write(ir_path, ir)

  # Step 1: Optimize (release mode only)
  var llc_input = ir_path
  if release == 1
    var opt_sb = sb_new()
    sb_append(opt_sb, "opt -O2 ")
    sb_append(opt_sb, ir_path)
    sb_append(opt_sb, " -o ")
    sb_append(opt_sb, opt_path)
    sb_append(opt_sb, " -S 2>")
    sb_append(opt_sb, err_path)
    var opt_raw = system(sb_to_string(opt_sb))
    if decode_wait_status(opt_raw) != 0
      var opt_err = fio_read(err_path)
      eputs("error: opt failed: #{opt_err}")
      file_delete(ir_path)
      file_delete(opt_path)
      file_delete(err_path)
      return 1
    end
    llc_input = opt_path
  end

  # Step 2: Assemble to object file
  var llc_sb = sb_new()
  sb_append(llc_sb, "llc -filetype=obj ")
  if release == 1
    sb_append(llc_sb, "-O2 ")
  end
  sb_append(llc_sb, llc_input)
  sb_append(llc_sb, " -o ")
  sb_append(llc_sb, obj_path)
  sb_append(llc_sb, " 2>")
  sb_append(llc_sb, err_path)
  var llc_raw = system(sb_to_string(llc_sb))
  if decode_wait_status(llc_raw) != 0
    var llc_err = fio_read(err_path)
    eputs("error: llc failed: #{llc_err}")
    file_delete(ir_path)
    file_delete(opt_path)
    file_delete(obj_path)
    file_delete(err_path)
    return 1
  end

  # Step 3: Link to binary
  var cc_sb = sb_new()
  sb_append(cc_sb, "clang ")
  if release == 0
    sb_append(cc_sb, "-g ")
  end
  var stack_flag = _linker_stack_flag()
  if str_byte_len(stack_flag) > 0
    sb_append(cc_sb, stack_flag)
    sb_append(cc_sb, " ")
  end
  sb_append(cc_sb, obj_path)
  sb_append(cc_sb, " -o ")
  sb_append(cc_sb, output_path)
  sb_append(cc_sb, " 2>")
  sb_append(cc_sb, err_path)
  var cc_raw = system(sb_to_string(cc_sb))
  if decode_wait_status(cc_raw) != 0
    var cc_err = fio_read(err_path)
    eputs("error: clang link failed: #{cc_err}")
    file_delete(ir_path)
    file_delete(opt_path)
    file_delete(obj_path)
    file_delete(err_path)
    return 1
  end

  # Cleanup temp files
  file_delete(ir_path)
  file_delete(opt_path)
  file_delete(obj_path)
  file_delete(err_path)
  return 0
end

## Lint a source file for style and correctness issues.
## Lint subcommand — gated behind @cfg(feature: "lint"). The full
## implementation pulls in the ~2400-LOC tools/lint.qz module, which is
## dead weight for the typical compile path. Default-off; users enable
## with `quartz --feature lint lint <file>`.
@cfg(feature: "lint")
def do_lint(args: ParsedArgs): Int
  var file = parsed_positional(args, 0)
  if str_byte_len(file) == 0
    puts("Error: no source file specified")
    puts("Usage: quartz lint [options] <source.qz>")
    return 1
  end

  var source = fio_read(file)
  if str_byte_len(source) == 0
    puts("Error: could not read file '#{file}'")
    return 1
  end

  # Set error format if requested
  var fmt = parsed_get(args, "--error-format")
  if fmt == "json"
    diagnostic::diag_set_format(2)
  end

  # Load config
  var config = lint::lint_default_config()
  var config_path = parsed_get(args, "--config")
  if str_byte_len(config_path) == 0
    config_path = lint::lint_find_config()
  end
  if str_byte_len(config_path) > 0
    config = lint::lint_load_config(config_path)
  end

  # Tier 1: Text-based rules (always run, even on broken files)
  var result = lint::lint_file_with_config(source, file, config)

  # Tier 2: AST-based rules (only if file parses successfully)
  var interner = string_intern::intern_global()
  var lex_result = lexer::lexer_tokenize(source, interner)
  var types = lex_result.get_types()
  var lexemes = lex_result.get_lexemes()
  var lines = lex_result.get_lines()
  var cols = lex_result.get_cols()
  var count = lex_result.token_count()
  # CST parse for the lint Tier-2 surface. Tier-2 runs only on a clean parse.
  var cst_res = cst_parser::cst_parse_source(source)
  if cst_res.parser.had_error == 0
    var cst_storage = ast::ast_new_storage()
    var cst_program = cst_lower::cst_lower(cst_res.parser.store, cst_res.root, cst_storage)
    var src_lines = diagnostic::diag_split_source(source)
    lint::lint_tier2(cst_storage, cst_program, source, file, src_lines, config, result)
  end

  # Apply fixes if --fix flag is set
  var apply_fix = parsed_has(args, "--fix")
  if apply_fix and result.fixes.size() > 0
    var fixed_source = lint::lint_apply_fixes(source, result.fixes)
    var _wr = fio_write(file, fixed_source)
    puts("Applied #{result.fixes.size()} fix(es) to #{file}.")
    return 0
  end

  lint::lint_result_emit(result)

  if result.count == 0
    puts("No issues found.")
  else
    puts("#{result.count} issue(s) found.")
  end

  return result.count > 0
end

@cfg(not: feature: "lint")
def do_lint(args: ParsedArgs): Int
  eputs("error: lint subcommand not available (recompile quartz with --feature lint)")
  return 1
end

## Run the compile-and-execute pipeline from parsed arguments.
def do_run(args: ParsedArgs): Int
  var file = parsed_positional(args, 0)
  if str_byte_len(file) == 0
    puts("Error: no source file specified")
    puts("Usage: quartz run [options] <source.qz> [-- program args...]")
    return 1
  end

  # Collect include paths
  var import_paths = parsed_get_all(args, "--include")

  # Prepend stdlib path if specified, or auto-detect from binary location
  var stdlib_path = parsed_get(args, "--stdlib-path")
  if str_byte_len(stdlib_path) == 0
    stdlib_path = getenv("QUARTZ_STDLIB_PATH")
  end
  if str_byte_len(stdlib_path) == 0
    stdlib_path = detect_stdlib_path()
  end
  if str_byte_len(stdlib_path) > 0
    var with_stdlib = vec_new<String>()
    with_stdlib.push(stdlib_path)
    # Also prepend project root so std-internal `import std/...` forms
    # (std/style.qz, std/terminal.qz, std/net/*) resolve without explicit -I .
    var project_root = detect_project_root()
    if str_byte_len(project_root) > 0
      with_stdlib.push(project_root)
    end
    each(import_paths, p: String -> with_stdlib.push(p))
    import_paths = with_stdlib
  end

  # Ensure include paths end with /
  var fixed_paths = vec_new<String>()
  for pi in 0..import_paths.size
    var p = import_paths[pi]
    var plen = str_byte_len(p)
    if plen > 0
      var last_char = str_byte_at(p, plen - 1)
      if last_char != '/'
        p = "#{p}/"
      end
    end
    fixed_paths.push(p)
  end
  import_paths = fixed_paths

  # Read flags
  var debug_mode = parsed_has(args, "--debug")
  var no_opt = parsed_has(args, "--no-opt")
  var overflow_check = parsed_has(args, "--overflow-check")
  var exclusivity_check = parsed_has(args, "--exclusivity-check")
  var stack_alloc = parsed_has(args, "--stack-alloc")
  var race_mode = parsed_has(args, "--race")

  # quartz run always produces a binary — enable stack_alloc by default
  if debug_mode == 0 and no_opt == 0
    stack_alloc = 1
  end

  # Error format
  var error_format = parsed_get(args, "--error-format")
  if error_format == "json"
    diagnostic::diag_set_format(1)
  end

  # Optimization level
  var opt_str = parsed_get(args, "--opt-level")
  if str_byte_len(opt_str) > 0
    var opt_char = str_byte_at(opt_str, 0)
    if opt_char >= '0'
      if opt_char <= '3'
        if opt_char == '0'
          no_opt = 1
        end
      end
    end
  end

  # Target
  var target = parsed_get(args, "--target")
  if str_byte_len(target) == 0
    target = get_host_target()
  end

  # Backend
  g_backend = parsed_get(args, "--backend")

  var source = fio_read(file)

  # Cache
  var no_cache = parsed_has(args, "--no-cache")
  var explain_cache = parsed_has(args, "--explain-cache")
  var cache_dir = parsed_get(args, "--cache-dir")
  if str_byte_len(cache_dir) == 0
    cache_dir = ".quartz-cache"
  end
  if no_cache == 0
    if explain_cache == 1
      build_cache::cache_set_explain(1)
    end
    build_cache::cache_open(cache_dir)
    if parsed_has(args, "--cache-ro") == 1
      build_cache::cache_set_read_only()
    end
  end

  # Compile to IR
  var ir = compile(source, file, import_paths, debug_mode, target, no_opt, overflow_check, 0, stack_alloc, race_mode, exclusivity_check)
  if str_byte_len(ir) == 0
    return 1
  end

  # Build to temp binary — optimize by default
  var tmp_bin = "/tmp/_quartz_run_bin"
  var optimize = 1
  if debug_mode == 1 or no_opt == 1
    optimize = 0
  end
  var build_result = build_binary(ir, tmp_bin, optimize)
  if build_result != 0
    return 1
  end

  # Execute the binary, forwarding any args after --
  var run_sb = sb_new()
  sb_append(run_sb, tmp_bin)
  # Forward positional args beyond the source file
  for ai in 1..args.positionals.size
    sb_append(run_sb, " ")
    sb_append(run_sb, args.positionals[ai])
  end
  var run_raw = system(sb_to_string(run_sb))
  var exit_code = decode_wait_status(run_raw)

  # Cleanup
  file_delete(tmp_bin)

  return exit_code
end

# ============================================================================
# Phase 5.0b — Persistent worker mode
# ============================================================================
#
# Invoked as `quartz --persistent-worker --connect-port=PORT`. The process
# opens a TCP connection to 127.0.0.1:PORT (the runner's listener), then
# loops reading length-prefixed JSON WorkRequest frames over that socket
# and writing WorkResponse frames back. Each compile request runs through
# the existing do_build pipeline with --ir-output redirecting LLVM IR to
# a worker-local tmpfile so the worker's stdout stays free for diagnostics.
#
# v0 scope: serial dispatch (no in-flight overlap, no preemptive cancel).
# Per-request stderr capture is wired (Phase 5.0c.1): if req.stderr_path
# is non-empty, _pworker_compile redirects fd-2 to that path for the
# duration of the compile via qz_redirect_stderr_to_file / qz_restore_stderr
# (the FILE* underlying @stderr / @__stderrp is rebased in place; eputs
# from typecheck/parser etc. land in the runner-named path).
# State accumulation across requests (cache_open / dep_graph / global g_*
# vars) remains the fsc-trap risk flagged in docs/design/QUARTZD.md D5;
# the frozen-stdlib-base refactor in 5.0f is the load-bearing fix.

## Read exactly N bytes from a TCP stream. Returns "" on EOF or socket
## error. Binary-safe: uses raw socket_recv into a malloc'd buffer, then
## materializes a Quartz string via cptr_to_string_with_len so embedded
## NUL bytes (common in length prefixes — any body < 256 has 3 zero
## bytes in the 4-byte LE prefix) are preserved.
def _pworker_read_exact(stream: TcpStream, n: Int): String
  if n <= 0
    return ""
  end
  var buf = qz_malloc(n)
  if buf == 0
    return ""
  end
  var got = 0
  while got < n
    var bytes = socket::socket_recv(stream.fd, buf + got, n - got, 0)
    if bytes <= 0
      mem_free(buf)
      return ""
    end
    got = got + bytes
  end
  var s = cptr_to_string_with_len(buf, n)
  mem_free(buf)
  return s
end

## Read one length-prefixed frame. Returns the FULL frame (4-byte length
## prefix + body) so callers hand the result directly to decode_request /
## decode_response. Returns "" on EOF / partial frame.
def _pworker_read_frame(stream: TcpStream): String
  var prefix = _pworker_read_exact(stream, 4)
  if str_byte_len(prefix) != 4
    return ""
  end
  var body_len = read_frame_length(prefix)
  if body_len < 0
    return ""
  end
  if body_len == 0
    return prefix
  end
  var body = _pworker_read_exact(stream, body_len)
  if str_byte_len(body) != body_len
    return ""
  end
  return prefix + body
end

## Binary-safe write to a TCP stream. Loops on partial sends. Returns
## total bytes sent or -1 on socket error. Bypasses tcp_write's
## string_to_cstr/strdup path which truncates at the first embedded NUL —
## a hard-no for length-prefixed frames.
def _pworker_write_all(stream: TcpStream, data: String): Int
  var total = str_byte_len(data)
  if total == 0
    return 0
  end
  var ptr = str_to_ptr(data)
  var sent = 0
  while sent < total
    var n = socket::socket_send(stream.fd, ptr + sent, total - sent, 0)
    if n < 0
      return -1
    end
    sent = sent + n
  end
  return sent
end

## Wall time elapsed since `start_ns`, in milliseconds.
def _pworker_ms_since(start_ns: Int): Int
  return (time_mono_ns() - start_ns) / 1000000
end

## Build a WorkResponse for a control request (ping, shutdown) that
## completed successfully without producing IR.
def _pworker_ok_resp(request_id: Int, duration_ms: Int): WorkResponse
  return WorkResponse {
    request_id: request_id,
    status: RESP_OK(),
    exit_code: 0,
    stdout: "",
    stderr: "",
    stderr_path: "",
    ir_path: "",
    duration_ms: duration_ms,
  }
end

## Build a WorkResponse for an error case (decode failure, unknown
## request kind). The error message ships inline in `stderr`.
def _pworker_err_resp(request_id: Int, msg: String, duration_ms: Int): WorkResponse
  return WorkResponse {
    request_id: request_id,
    status: RESP_ERROR(),
    exit_code: 1,
    stdout: "",
    stderr: msg,
    stderr_path: "",
    ir_path: "",
    duration_ms: duration_ms,
  }
end

## Dispatch a compile request through do_build. argv from WorkRequest is
## user-form (positional source file at index 0, e.g.
## ["spec/foo.qz", "-I", "std", "--ir-output", "/tmp/r1.ll"]); the
## argparser expects argv[0] to be a program name, so we prepend
## "quartz" before parsing. Honours req.cwd via chdir before the build
## (relative -I paths and source-file paths resolve correctly).
def _pworker_compile(cli: ArgParser, req: WorkRequest, start_ns: Int): WorkResponse
  if str_byte_len(req.cwd) > 0
    var _cd = chdir(req.cwd)
  end
  var full_argv = vec_new<String>()
  full_argv.push("quartz")
  for i in 0..req.argv.size
    full_argv.push(req.argv[i])
  end
  var args = argparser_parse_argv(cli, full_argv)
  var ir_path = parsed_get(args, "--ir-output")
  var saved_stderr = -1
  if str_byte_len(req.stderr_path) > 0
    saved_stderr = qz_redirect_stderr_to_file(req.stderr_path)
  end
  var exit_code = do_build(args)
  if saved_stderr >= 0
    var _r = qz_restore_stderr(saved_stderr)
  end
  var status = RESP_OK()
  if exit_code != 0
    status = RESP_ERROR()
  end
  return WorkResponse {
    request_id: req.request_id,
    status: status,
    exit_code: exit_code,
    stdout: "",
    stderr: "",
    stderr_path: req.stderr_path,
    ir_path: ir_path,
    duration_ms: _pworker_ms_since(start_ns),
  }
end

## Process one decoded WorkRequest and produce a WorkResponse.
def _pworker_handle(cli: ArgParser, req: WorkRequest): WorkResponse
  var start_ns = time_mono_ns()
  if req.kind == REQ_PING()
    return _pworker_ok_resp(req.request_id, _pworker_ms_since(start_ns))
  end
  if req.kind == REQ_SHUTDOWN()
    return _pworker_ok_resp(req.request_id, _pworker_ms_since(start_ns))
  end
  if req.kind == REQ_CANCEL()
    # v0: single-threaded worker has no in-flight request at receive time
    # (we only read a new frame after writing the previous response). So
    # we ack with status: cancelled and continue. Phase 5.1 wires real
    # preemptive cancellation once compile dispatches into a goroutine.
    return WorkResponse {
      request_id: req.request_id,
      status: RESP_CANCELLED(),
      exit_code: 0,
      stdout: "",
      stderr: "",
      stderr_path: "",
      ir_path: "",
      duration_ms: _pworker_ms_since(start_ns),
    }
  end
  if req.kind == REQ_COMPILE()
    return _pworker_compile(cli, req, start_ns)
  end
  return _pworker_err_resp(req.request_id, "unknown request kind: #{req.kind}", _pworker_ms_since(start_ns))
end

## Main worker dispatch loop. Reads a frame, decodes, dispatches by kind,
## writes a response frame, repeats. Exits cleanly on EOF / socket error
## OR after responding to a SHUTDOWN request.
def _pworker_loop(cli: ArgParser, stream: TcpStream): Int
  while true
    var frame = _pworker_read_frame(stream)
    if str_byte_len(frame) == 0
      var _close = tcp_close(stream)
      return 0
    end
    var dec = decode_request(frame)
    var resp = WorkResponse {
      request_id: 0,
      status: RESP_ERROR(),
      exit_code: 1,
      stdout: "",
      stderr: "",
      stderr_path: "",
      ir_path: "",
      duration_ms: 0,
    }
    var is_shutdown = 0
    if dec.ok
      resp = _pworker_handle(cli, dec.request)
      if dec.request.kind == REQ_SHUTDOWN()
        is_shutdown = 1
      end
    else
      resp = _pworker_err_resp(0, "decode failed: #{dec.error_msg}", 0)
    end
    var encoded = encode_response(resp)
    var written = _pworker_write_all(stream, encoded)
    if written < 0
      var _close = tcp_close(stream)
      return 1
    end
    if is_shutdown == 1
      var _close = tcp_close(stream)
      return 0
    end
  end
  return 0
end

## Persistent worker mode entry point. Connects to 127.0.0.1:port, then
## runs the dispatch loop. The CLI arg parser is built once by main()
## and threaded through every per-request dispatch — no per-request
## flag registration cost.
def _run_persistent_worker(cli: ArgParser, port: Int): Int
  var conn = tcp_connect("127.0.0.1", port)
  match conn
    TcpResult::Err(e) => {
      eputs("worker: connect to 127.0.0.1:#{port} failed: #{e.message}\n")
      return 1
    }
    TcpResult::Ok(stream) => {
      return _pworker_loop(cli, stream)
    }
  end
  return 0
end
