  egraph_opt::mir_egraph_optimize(mir_prog, overflow_check)
end

@cfg(not: feature: "egraph")
def _maybe_egraph_optimize(mir_prog: mir::MirProgram, overflow_check: Int): Void
end

## REPL wrapper — gated behind @cfg(feature: "repl").
@cfg(feature: "repl")
def _run_repl(): Int = repl::repl_main()

@cfg(not: feature: "repl")
def _run_repl(): Int
  eputs("error: REPL not available (compile with --feature repl)")
  return 1
