#!/usr/bin/env ruby
# frozen_string_literal: true

# =============================================================================
# Quartz Benchmark Suite — World-Class Performance Tracking
# =============================================================================
#
# Statistically rigorous, self-adversarial benchmark runner with:
# - Per-iteration sample storage for historical reanalysis
# - Standard deviation, IQR, coefficient of variation reporting
# - Peak RSS memory measurement via /usr/bin/time
# - Compiler metrics (binary size, IR lines, function count)
# - Cohen's d effect size for regression detection
# - Self-compilation benchmark (compiler compiling itself)
# - Fair cross-language comparisons (grouped by allocation strategy)
#
# Usage:
#   bin/bench                    # Run all benchmarks (10 iterations)
#   bin/bench --quick            # Quick mode: fibonacci + selfcomp (5 iterations)
#   bin/bench --precise          # Precise mode: 30 iterations
#   bin/bench --compare          # Compare against previous run
#   bin/bench --ci               # CI mode: exit 1 on significant regressions
#   bin/bench --history [NAME]   # Show historical results
#   bin/bench fibonacci sieve    # Run specific benchmarks
#

require 'sqlite3'
require 'fileutils'
require 'optparse'
require 'tmpdir'
require 'open3'

PROJECT_ROOT = File.expand_path('..', __dir__)
BENCHMARKS_DIR = File.join(PROJECT_ROOT, 'benchmarks')
DB_PATH = File.join(BENCHMARKS_DIR, 'results.sqlite3')
QUARTZ_COMPILER = File.join(PROJECT_ROOT, 'self-hosted/bin/quartz')

ITERATIONS = 10          # Standard: enough for meaningful stddev
ITERATIONS_QUICK = 5     # Quick: per-build validation
ITERATIONS_PRECISE = 30  # Precise: deep analysis

# Ensure LLVM tools (llc) are in PATH
LLVM_BIN = '/opt/homebrew/opt/llvm/bin'
ENV['PATH'] = "#{LLVM_BIN}:#{ENV['PATH']}" if File.directory?(LLVM_BIN)

# ---------------------------------------------------------------------------
# Benchmark Registry
# ---------------------------------------------------------------------------
BENCHMARKS = {
  'fibonacci'     => { dir: 'fibonacci',     qz: 'fib.qz',    c: 'fib.c',    rs: 'fib.rs',    zig: 'fib.zig',    bl: 'fib.bl' },
  'sum'           => { dir: 'sum',           qz: 'sum.qz',    c: 'sum.c',    rs: 'sum.rs',    zig: 'sum.zig' },
  'sieve'         => { dir: 'sieve',         qz: 'sieve.qz',  c: 'sieve.c',  rs: 'sieve.rs',  zig: 'sieve.zig', byte_qz: 'sieve_byte.qz', bitvec_qz: 'sieve_bitvec.qz' },
  'string_concat' => { dir: 'string_concat', qz: 'concat.qz', c: 'concat.c', rs: 'concat.rs', zig: 'concat.zig' },
  'matrix'        => { dir: 'matrix',        qz: 'matrix.qz', c: 'matrix.c', rs: 'matrix.rs', zig: 'matrix.zig' },
  'binary_trees'  => { dir: 'binary_trees',  qz: 'trees.qz',  c: 'trees.c',  rs: 'trees.rs',  zig: 'trees.zig',
                        arena_qz: 'trees_arena.qz', bump_qz: 'trees_bump.qz',
                        bump_c: 'trees_bump.c', bump_rs: 'trees_bump.rs' },
}

