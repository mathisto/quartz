#!/bin/bash
# Simple REPL for Be - wraps compiler for interactive use
# Usage: be-repl (requires rlwrap for readline support)

BE_COMPILER="${BE_COMPILER:-./bootstrap/bin/be}"
TMPFILE=$(mktemp /tmp/be_repl_XXXXXX.be)
trap "rm -f $TMPFILE" EXIT

echo "Be REPL v0.4.0 (type 'exit' to quit, 'help' for commands)"
echo "Expressions are wrapped in main() and executed."
echo ""

while true; do
    read -p "be> " -r line
    
    case "$line" in
        exit|quit)
            echo "Goodbye!"
            exit 0
            ;;
        help)
            echo "Commands:"
            echo "  exit, quit  - Exit the REPL"
            echo "  help        - Show this help"
            echo "  :verbose    - Toggle verbose compilation"
            echo ""
            echo "Enter Be expressions to evaluate (wrapped in main -> Int)"
            continue
            ;;
        :verbose)
            if [ -z "$VERBOSE" ]; then
                VERBOSE="--verbose"
                echo "Verbose mode ON"
            else
                VERBOSE=""
                echo "Verbose mode OFF"
            fi
            continue
            ;;
        "")
            continue
            ;;
    esac
    
    # Wrap in main function
    cat > "$TMPFILE" << EOF
def main() -> Int
  $line
end
EOF
    
    # Compile and run
    if IR=$("$BE_COMPILER" $VERBOSE "$TMPFILE" 2>&1); then
        if OUTPUT=$(echo "$IR" | clang -x ir - -o "${TMPFILE}.out" 2>&1); then
            RESULT=$("${TMPFILE}.out")
            EXIT_CODE=$?
            [ -n "$RESULT" ] && echo "$RESULT"
            echo "=> $EXIT_CODE"
            rm -f "${TMPFILE}.out"
        else
            echo "Link error: $OUTPUT"
        fi
    else
        echo "$IR"
    fi
done
