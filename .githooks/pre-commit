#!/bin/bash
set -euo pipefail

if git diff --cached --name-only | grep -Eq '^(\.github/workflows/ci\.yml|\.githooks/pre-commit|Quakefile\.qz|self-hosted/.*|std/.*|tools/.*|examples/(brainfuck|expr_eval|style_demo)\.qz)$'; then
    checker=$(mktemp "${TMPDIR:-/tmp}/quartz-guard-check.XXXXXX")
    trap 'rm -f "$checker"' EXIT
    if git cat-file -e HEAD:tools/quartz_guard.rb 2>/dev/null; then
        mode=$(git ls-tree HEAD -- tools/quartz_guard.rb | cut -d' ' -f1)
        if [ "$mode" != "100755" ]; then
            echo "ERROR: trusted HEAD checker must have mode 100755" >&2
            exit 1
        fi
        git show HEAD:tools/quartz_guard.rb > "$checker"
        chmod 500 "$checker"
        ruby "$checker" check staged
    else
        if [ -z "${QUARTZ_GUARD_BOOTSTRAP_CHECKER:-}" ] || [ -z "${QUARTZ_GUARD_BOOTSTRAP_CHECKER_SHA256:-}" ] || [ -z "${QUARTZ_GUARD_BOOTSTRAP_POLICY_SHA256:-}" ]; then
            echo "ERROR: HEAD has no trusted checker; follow docs/QUARTZ_GUARD.md bootstrap migration" >&2
            exit 1
        fi
        actual=$(shasum -a 256 "$QUARTZ_GUARD_BOOTSTRAP_CHECKER" | cut -d' ' -f1)
        if [ "$actual" != "$QUARTZ_GUARD_BOOTSTRAP_CHECKER_SHA256" ]; then
            echo "ERROR: bootstrap checker SHA mismatch" >&2
            exit 1
        fi
        QUARTZ_GUARD_BOOTSTRAP_CHECKER_SHA256="$actual" ruby "$QUARTZ_GUARD_BOOTSTRAP_CHECKER" check staged
    fi
fi
