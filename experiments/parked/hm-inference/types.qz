# types.be - Type representation for Be self-hosted compiler
# Phase 3: Type System Foundation

# Type kinds (mirrors bootstrap/src/types.h)
const TYPE_UNKNOWN = 0

const TYPE_VOID = 1

const TYPE_INT = 2

const TYPE_BOOL = 3

const TYPE_STRING = 4

const TYPE_ARRAY = 5

const TYPE_FUNCTION = 6

const TYPE_STRUCT = 7

const TYPE_ENUM = 8

const TYPE_GENERIC = 9

const TYPE_OPTION = 10

const TYPE_RESULT = 11

const TYPE_RANGE = 12

const TYPE_SYMBOL = 13

const TYPE_ERROR = 14

const TYPE_NIL = 15

const TYPE_NEVER = 16

# FFI/C interop types (v5.2)
const TYPE_CINT = 17
const TYPE_CCHAR = 18
const TYPE_CSIZE = 19
const TYPE_CPTR = 20
const TYPE_CFLOAT = 21
const TYPE_CDOUBLE = 22
const TYPE_CVOID = 23

# Handle types (v5.4)
const TYPE_VEC = 24      # Vec<T> - dynamic array handle
const TYPE_HASHMAP = 25  # HashMap<K,V> - key-value store handle
const TYPE_PTR = 26      # Ptr<T> - typed pointer

# Phase 2 container/concurrency handle types (v5.12.23)
const TYPE_STRINGBUILDER = 27  # StringBuilder handle type
const TYPE_SET = 28       # Set - hash set handle
const TYPE_INTMAP = 29    # IntMap - integer-keyed map handle
const TYPE_ARENA = 30     # Arena - arena allocator handle
const TYPE_POOL = 31      # Pool - pool allocator handle
const TYPE_ARENAPOOL = 32 # ArenaPool - arena pool handle
const TYPE_CHANNEL = 33   # Channel - CSP channel handle
const TYPE_MUTEX = 34     # Mutex - mutual exclusion lock handle
const TYPE_ATOMIC = 35    # Atomic - atomic integer handle

# Native float types
const TYPE_F64 = 36       # F64 - 64-bit float (stored as i64 bitcast)
const TYPE_F32 = 37       # F32 - 32-bit float (stored as i64 via fptrunc+bitcast+zext)

# Type storage (arena-style, like AST)
# Parallel vectors indexed by type handle. Each type handle is an index
# into all vectors simultaneously.
struct TypeStorage
  kinds: Vec<Int>
  names: Vec<Int>          # String pointers as Int (existential)
  element_types: Vec<Int>  # For array/option/result/vec element type
  param_types: Vec<Int>    # For function params - vector of type handles
  return_types: Vec<Int>   # For function return type
  fields: Vec<Int>         # For struct fields - vector of field handles
  variants: Vec<Int>       # For enum variants - vector of variant handles
  type_params: Vec<Int>    # For generic type args - 0 or string ptr to comma-joined type handles
end

def type_new_storage(): TypeStorage
  return TypeStorage {
    kinds: vec_new(),
    names: vec_new(),
    element_types: vec_new(),
    param_types: vec_new(),
    return_types: vec_new(),
    fields: vec_new(),
    variants: vec_new(),
    type_params: vec_new()
  }
end

def type_alloc(s: TypeStorage, kind: Int, name: String, elem: Int, params: Int, ret: Int, fields: Int, variants: Int): Int
  var h = s.kinds.size
  s.kinds.push(kind)
  s.names.push(as_int(name))
  s.element_types.push(elem)
  s.param_types.push(params)
  s.return_types.push(ret)
  s.fields.push(fields)
  s.variants.push(variants)
  s.type_params.push(0)
  return h
end

# Type constructors
def type_void(s: TypeStorage): Int = type_alloc(s, TYPE_VOID, "", 0, 0, 0, 0, 0)

def type_int(s: TypeStorage): Int = type_alloc(s, TYPE_INT, "", 0, 0, 0, 0, 0)

def type_bool(s: TypeStorage): Int = type_alloc(s, TYPE_BOOL, "", 0, 0, 0, 0, 0)

def type_string(s: TypeStorage): Int = type_alloc(s, TYPE_STRING, "", 0, 0, 0, 0, 0)

def type_array(s: TypeStorage, elem_type: Int): Int = type_alloc(s, TYPE_ARRAY, "", elem_type, 0, 0, 0, 0)

def type_function(s: TypeStorage, param_types: Int, return_type: Int): Int = type_alloc(s, TYPE_FUNCTION, "", 0, param_types, return_type, 0, 0)

def type_struct(s: TypeStorage, name: String, fields: Int): Int = type_alloc(s, TYPE_STRUCT, name, 0, 0, 0, fields, 0)

def type_struct_generic(s: TypeStorage, name: String, fields: Int, type_args: String): Int
  var h = type_alloc(s, TYPE_STRUCT, name, 0, 0, 0, fields, 0)
  s.type_params[h] = as_int(type_args)
  return h
end

def type_enum(s: TypeStorage, name: String, variants: Int): Int = type_alloc(s, TYPE_ENUM, name, 0, 0, 0, 0, variants)

def type_enum_generic(s: TypeStorage, name: String, variants: Int, type_args: String): Int
  var h = type_alloc(s, TYPE_ENUM, name, 0, 0, 0, 0, variants)
  s.type_params[h] = as_int(type_args)
  return h
end

def type_generic(s: TypeStorage, name: String): Int = type_alloc(s, TYPE_GENERIC, name, 0, 0, 0, 0, 0)

def type_option(s: TypeStorage, elem_type: Int): Int = type_alloc(s, TYPE_OPTION, "", elem_type, 0, 0, 0, 0)

def type_result(s: TypeStorage, ok_type: Int, err_type: Int): Int
  # Store ok_type in elem, err_type in params (reusing slot)
  return type_alloc(s, TYPE_RESULT, "", ok_type, err_type, 0, 0, 0)
end

def type_range(s: TypeStorage): Int = type_alloc(s, TYPE_RANGE, "", 0, 0, 0, 0, 0)

def type_unknown(s: TypeStorage): Int = type_alloc(s, TYPE_UNKNOWN, "", 0, 0, 0, 0, 0)

def type_error(s: TypeStorage): Int = type_alloc(s, TYPE_UNKNOWN, "error", 0, 0, 0, 0, 0)

def type_nil(s: TypeStorage): Int = type_alloc(s, TYPE_NIL, "", 0, 0, 0, 0, 0)

def type_never(s: TypeStorage): Int = type_alloc(s, TYPE_NEVER, "", 0, 0, 0, 0, 0)

def type_f64(s: TypeStorage): Int = type_alloc(s, TYPE_F64, "", 0, 0, 0, 0, 0)

def type_f32(s: TypeStorage): Int = type_alloc(s, TYPE_F32, "", 0, 0, 0, 0, 0)

# Handle type constructors (v5.4)
def type_vec(s: TypeStorage, elem_type: Int): Int = type_alloc(s, TYPE_VEC, "", elem_type, 0, 0, 0, 0)

def type_hashmap(s: TypeStorage, key_type: Int, value_type: Int): Int
  # Store key_type in elem, value_type in params (reusing slots)
  return type_alloc(s, TYPE_HASHMAP, "", key_type, value_type, 0, 0, 0)
end

def type_ptr(s: TypeStorage, pointee_type: Int): Int = type_alloc(s, TYPE_PTR, "", pointee_type, 0, 0, 0, 0)

# Type accessors
def type_get_kind(s: TypeStorage, h: Int): Int = s.kinds[h]

def type_get_name(s: TypeStorage, h: Int): String = as_string(s.names[h])

def type_get_elem(s: TypeStorage, h: Int): Int = s.element_types[h]

def type_get_params(s: TypeStorage, h: Int): Int = s.param_types[h]

def type_get_return(s: TypeStorage, h: Int): Int = s.return_types[h]

def type_get_fields(s: TypeStorage, h: Int): Int = s.fields[h]

def type_get_variants(s: TypeStorage, h: Int): Int = s.variants[h]

def type_get_type_params(s: TypeStorage, h: Int): Int = s.type_params[h]

# Type matching (with bottom-type unification: Never matches anything)
def types_match(s: TypeStorage, a: Int, b: Int): Int
  return 1 if a == b
  var ka = type_get_kind(s, a)
  var kb = type_get_kind(s, b)
  # Never type is the bottom type - matches anything
  return 1 if ka == TYPE_NEVER
  return 1 if kb == TYPE_NEVER
  return type_equals(s, a, b)
end

# Type comparison
def type_equals(s: TypeStorage, a: Int, b: Int): Int
  return 1 if a == b
  var ka = type_get_kind(s, a)
  var kb = type_get_kind(s, b)
  return 0 if ka != kb
  # For primitives, kind equality is enough
  return 1 if ka == TYPE_VOID
  return 1 if ka == TYPE_INT
  return 1 if ka == TYPE_BOOL
  return 1 if ka == TYPE_STRING
  # TYPE_CHAR removed - chars are ints now
  return 1 if ka == TYPE_RANGE
  # For compound types, check structure
  return type_equals(s, type_get_elem(s, a), type_get_elem(s, b)) if ka == TYPE_ARRAY
  return type_equals(s, type_get_elem(s, a), type_get_elem(s, b)) if ka == TYPE_OPTION
  if ka == TYPE_VEC
    # Vec<T> - compare element types (NULL elem = unparameterized, matches any)
    var ea = type_get_elem(s, a)
    var eb = type_get_elem(s, b)
    return 1 if ea == 0 or eb == 0
    return type_equals(s, ea, eb)
  end
  if ka == TYPE_HASHMAP
    # HashMap<K,V> - compare key and value types
    var ka = type_get_elem(s, a)   # key stored in elem slot
    var kb = type_get_elem(s, b)
    var va = type_get_params(s, a) # value stored in params slot
    var vb = type_get_params(s, b)
    return 1 if ka == 0 or kb == 0
    return type_equals(s, ka, kb) and type_equals(s, va, vb)
  end
  if ka == TYPE_PTR
    # Ptr<T> - compare pointee types (NULL = unparameterized)
    var pa = type_get_elem(s, a)
    var pb = type_get_elem(s, b)
    return 1 if pa == 0 or pb == 0
    return type_equals(s, pa, pb)
  end
  if ka == TYPE_STRUCT
    return type_get_name(s, a).eq(type_get_name(s, b))
  end
  if ka == TYPE_ENUM
    return type_get_name(s, a).eq(type_get_name(s, b))
  end
  if ka == TYPE_GENERIC
    return type_get_name(s, a).eq(type_get_name(s, b))
  end
  # Function type comparison would need param-by-param check
  return 0
end

# Type printing (for error messages)
def type_to_string(s: TypeStorage, h: Int): String
  var k = type_get_kind(s, h)
  return "Unknown" if k == TYPE_UNKNOWN
  return "Void" if k == TYPE_VOID
  return "Int" if k == TYPE_INT
  return "Bool" if k == TYPE_BOOL
  return "String" if k == TYPE_STRING
  # TYPE_CHAR removed - chars are ints now
  return "Range" if k == TYPE_RANGE
  return "Array<...>" if k == TYPE_ARRAY
  return "Option<...>" if k == TYPE_OPTION
  return "Result<...>" if k == TYPE_RESULT
  return "Fn(...)" if k == TYPE_FUNCTION
  return "Vec<...>" if k == TYPE_VEC
  return "HashMap<...>" if k == TYPE_HASHMAP
  return "Ptr<...>" if k == TYPE_PTR
  return type_get_name(s, h) if k == TYPE_STRUCT
  return type_get_name(s, h) if k == TYPE_ENUM
  return type_get_name(s, h) if k == TYPE_GENERIC
  return "Nil" if k == TYPE_NIL
  return "!" if k == TYPE_NEVER
  return "F64" if k == TYPE_F64
  return "F32" if k == TYPE_F32
  return "?"
end
