# Type Inference Module (Self-Contained)
# Part of Be self-hosted compiler Phase 3
#
# Infers types for AST expressions. Currently standalone - cross-module
# integration will be added when Quartz's module system supports it properly.

# ============================================================================
# AST Node Kind Constants - MUST match C's NodeType order (bootstrap/src/ast.h)
# ============================================================================
const NodeIntLit = 0

const NodeBoolLit = 1

const NodeNilLit = 2

const NodeStringLit = 3

const NodeSymbolLit = 4

const NodeRegexLit = 5

const NodeIdent = 6

const NodeUnary = 7

const NodeBinary = 8

const NodeCall = 9

const NodeArray = 10

const NodeSetLit = 11

const NodeMapLit = 12

const NodeIndex = 13

const NodeStructInit = 14

const NodeFieldAccess = 15

const NodeSafeFieldAccess = 16

const NodeTryExpr = 17

const NodeFuncRef = 18

const NodeLambda = 19

const NodeAllocExpr = 20

const NodeCaptureVar = 21

const NodeReturn = 22

const NodeIf = 23

const NodeWhile = 24

const NodeLet = 25

const NodeAssign = 26

const NodeIndexAssign = 27

const NodeFieldAssign = 28

const NodeExprStmt = 29

const NodeBreak = 30

const NodeContinue = 31

const NodeBlock = 32

const NodeParam = 33

const NodeDef = 34

const NodeProgram = 35

const NodeStructDef = 36

const NodeFieldDef = 37

const NodeEnumDef = 38

const NodeEnumAccess = 39

const NodeMatch = 40

const NodeMatchArm = 41

const NodeWildcard = 42

# ============================================================================
# Type Kind Constants (duplicated from middle/types.be)
# ============================================================================
const TYPE_UNKNOWN = 0

const TYPE_VOID = 1

const TYPE_INT = 2

const TYPE_BOOL = 3

const TYPE_STRING = 4

const TYPE_ARRAY = 5

const TYPE_FUNCTION = 6

const TYPE_STRUCT = 7

const TYPE_ENUM = 8

const TYPE_GENERIC = 9

const TYPE_OPTION = 10

const TYPE_RESULT = 12

const TYPE_RANGE = 13

const TYPE_NIL = 15

# ============================================================================
# InferStorage - Type inference storage
# ============================================================================

struct InferStorage
  kinds: Vec           # Type kinds
  names: Vec           # Type names (as_int)
  elem_types: Vec      # Element types for arrays/options
  param_types: Vec     # Parameter types (as_int for vectors)
  return_types: Vec    # Return types for functions
  next_type_var: Int   # Counter for fresh type variables
  bindings: Vec        # Type variable bindings
  error_count: Int     # Number of unification failures
  error_messages: Vec  # Error message strings (as_int)
  error_lines: Vec     # Error line numbers
  error_cols: Vec      # Error column numbers
end

# Create new type storage
def infer_type_storage_new(): InferStorage
  return InferStorage{
    kinds: vec_new(),
    names: vec_new(),
    elem_types: vec_new(),
    param_types: vec_new(),
    return_types: vec_new(),
    next_type_var: 1,
    bindings: vec_new(),
    error_count: 0,
    error_messages: vec_new(),
    error_lines: vec_new(),
    error_cols: vec_new()
  }
end

# Check if inference had unification errors
def infer_has_errors(storage: InferStorage): Int
  return storage.error_count
end

# Record an inference error with source location
def infer_add_error(storage: InferStorage, message: String, line: Int, col: Int): Void
  storage.error_messages.push(as_int(message))
  storage.error_lines.push(line)
  storage.error_cols.push(col)
end

# Get the number of recorded error messages
def infer_error_message_count(storage: InferStorage): Int
  return storage.error_messages.size
end

# Get error message at index
def infer_get_error_message(storage: InferStorage, idx: Int): String
  return as_string(storage.error_messages[idx])
end

# Get error line at index
def infer_get_error_line(storage: InferStorage, idx: Int): Int
  return storage.error_lines[idx]
end

# Get error col at index
def infer_get_error_col(storage: InferStorage, idx: Int): Int
  return storage.error_cols[idx]
end

# ============================================================================
# Operator Constants
# ============================================================================
const OP_PLUS = 0

const OP_MINUS = 1

const OP_STAR = 2

const OP_SLASH = 3

const OP_PERCENT = 4

const OP_EQ = 5

const OP_NE = 6

const OP_LT = 7

const OP_LE = 8

const OP_GT = 9

const OP_GE = 10

const OP_AND = 11

const OP_OR = 12

const OP_NOT = 13

const OP_NEG = 14

# Allocate a new type slot, return its index
def infer_type_alloc(storage: InferStorage): Int
  var kinds = storage.kinds
  var idx = vec_len(kinds)
  kinds.push(TYPE_UNKNOWN)
  storage.names.push(0)
  storage.elem_types.push(0)
  storage.param_types.push(0)
  storage.return_types.push(0)
  return idx
end

# Get type kind
def infer_type_get_kind(storage: InferStorage, type_idx: Int): Int
  var kinds = storage.kinds
  return kinds[type_idx]
end

# Set type kind
def infer_type_set_kind(storage: InferStorage, type_idx: Int, kind: Int): Void
  var kinds = storage.kinds
  kinds[type_idx] = kind
end

# Create primitive types
def infer_make_int(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_INT)
  return idx
end

def infer_make_bool(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_BOOL)
  return idx
end

def infer_make_string(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_STRING)
  return idx
end

def infer_make_void(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_VOID)
  return idx
end

def infer_make_unknown(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_UNKNOWN)
  return idx
end

def infer_make_nil(storage: InferStorage): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_NIL)
  return idx
end

def infer_make_array(storage: InferStorage, elem_type: Int): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_ARRAY)
  var elem_types = storage.elem_types
  elem_types[idx] = elem_type
  return idx
end

## Get the element type of an array type.
## Returns 0 if type is not an array or has no element type set.
def infer_get_elem_type(storage: InferStorage, type_idx: Int): Int
  # Type variable - can't get elem type directly
  return 0 if type_idx < 0
  var kinds = storage.kinds
  var kind = kinds[type_idx]
  return 0 if kind != TYPE_ARRAY
  var elem_types = storage.elem_types
  return elem_types[type_idx]
end

## Check if a type index is a parameterized type stored in storage.
## Returns 1 if type_idx is a valid index with a concrete kind, 0 otherwise.
## This distinguishes stored types from primitive constants (TYPE_INT=1, TYPE_ARRAY=5).
def infer_is_parameterized_type(storage: InferStorage, type_idx: Int): Int
  # Type variable - not a stored parameterized type
  return 0 if type_idx < 0
  var kinds = storage.kinds
  var kinds_len = vec_len(kinds)
  # Index out of bounds - not a stored type
  return 0 if type_idx >= kinds_len
  # Type index is within storage bounds
  return 1
end

# ============================================================================
# Type Variables (v3.0 Type Inference)
# ============================================================================
# Type variables use NEGATIVE IDs: -1, -2, -3...
# This avoids needing a separate TYPE_VAR kind and integrates cleanly
# with existing type infrastructure.
#
# Pattern from bee compiler (proven working):
# - fresh_var() returns 0 - counter (negative)
# - is_type_var(t) checks t < 0
# - Bindings stored in separate vector (index = -var_id - 1)

# Check if a type is a type variable (negative ID)
def infer_is_type_var(type_idx: Int): Int
  return 1 if type_idx < 0
  return 0
end

# Generate a fresh type variable (returns negative ID)
def infer_fresh_var(storage: InferStorage): Int
  var counter = storage.next_type_var
  counter += 1  # Increment first so we never return 0
  storage.next_type_var = counter
  return 0 - counter  # Returns -1, -2, -3, ... (never 0)
end

# Reset type variable counter (for new inference context)
def infer_reset_type_vars(storage: InferStorage): Void
  storage.next_type_var = 1
  # Clear bindings
  var bindings = storage.bindings
  var count = vec_len(bindings)
  for i in 0..count
    bindings[i] = 0
  end
end

# Bind a type variable to a type
# var_id is negative, convert to index: idx = -var_id - 1
def infer_bind_type_var(storage: InferStorage, var_id: Int, bound_type: Int): Void
  var idx = (0 - var_id) - 1
  var bindings = storage.bindings
  # Ensure bindings vector is large enough
  while vec_len(bindings) <= idx
    bindings.push(0)
  end
  bindings[idx] = bound_type
end

# Get the binding for a type variable (0 = unbound)
def infer_get_type_binding(storage: InferStorage, var_id: Int): Int
  var idx = (0 - var_id) - 1
  var bindings = storage.bindings
  return 0 if idx >= vec_len(bindings)
  return bindings[idx]
end

# Resolve a type by following bindings (chase pointer chain)
def infer_resolve_type(storage: InferStorage, t: Int): Int
  if infer_is_type_var(t) != 0
    var bound = infer_get_type_binding(storage, t)
    return t if bound == 0
    return infer_resolve_type(storage, bound)
  end
  return t
end

# Occurs check: does var_id appear in type t?
# Prevents infinite types like 'a = List<'a>
# Returns 1 for true, 0 for false (workaround for Bool codegen bug)
def infer_occurs_in(storage: InferStorage, var_id: Int, t: Int): Int
  var resolved = infer_resolve_type(storage, t)
  
  # Direct match
  return 1 if resolved == var_id
  
  # Not a type var and not compound - no occurrence
  return 0 if infer_is_type_var(resolved) != 0
  
  # Check inside compound types
  if resolved >= 0
    var kind = infer_type_get_kind(storage, resolved)
    
    # Array<elem> - check element type
    if kind == TYPE_ARRAY
      var elem = storage.elem_types[resolved]
      return infer_occurs_in(storage, var_id, elem)
    end
    
    # Function types - check params and return
    if kind == TYPE_FUNCTION
      var ret = storage.return_types[resolved]
      if infer_occurs_in(storage, var_id, ret) != 0
        return 1
      end
      var params_vec = storage.param_types[resolved]
      if params_vec != 0
        return 1 if any(params_vec, pt: Int -> infer_occurs_in(storage, var_id, pt) != 0)
      end
    end
  end
  
  return 0
end

# Unify two types, returning 1 on success, 0 on failure
# This is the core of Hindley-Milner type inference
def infer_unify(storage: InferStorage, t1: Int, t2: Int): Int
  var r1 = infer_resolve_type(storage, t1)
  var r2 = infer_resolve_type(storage, t2)
  
  # Same type (or same type var) - trivially unified
  return 1 if r1 == r2
  
  # If r1 is a type variable, bind it to r2
  if infer_is_type_var(r1) != 0
    return 0 if infer_occurs_in(storage, r1, r2) != 0  # Infinite type
    infer_bind_type_var(storage, r1, r2)
    return 1
  end
  
  # If r2 is a type variable, bind it to r1
  if infer_is_type_var(r2) != 0
    return 0 if infer_occurs_in(storage, r2, r1) != 0  # Infinite type
    infer_bind_type_var(storage, r2, r1)
    return 1
  end
  
  # Both are concrete types - check structural equality
  # UNKNOWN matches anything (legacy behavior)
  if r1 >= 0
    var k1 = infer_type_get_kind(storage, r1)
    return 1 if k1 == TYPE_UNKNOWN
  end
  if r2 >= 0
    var k2 = infer_type_get_kind(storage, r2)
    return 1 if k2 == TYPE_UNKNOWN
  end
  
  # Both concrete, non-unknown - check kind match
  return 0 if r1 < 0
  return 0 if r2 < 0
  
  var k1 = infer_type_get_kind(storage, r1)
  var k2 = infer_type_get_kind(storage, r2)
  
  return 0 if k1 != k2
  
  # Primitives match if kinds match
  return 1 if k1 == TYPE_INT
  return 1 if k1 == TYPE_BOOL
  return 1 if k1 == TYPE_STRING
  return 1 if k1 == TYPE_VOID
  
  # Arrays - unify element types
  if k1 == TYPE_ARRAY
    var elem1 = storage.elem_types[r1]
    var elem2 = storage.elem_types[r2]
    return infer_unify(storage, elem1, elem2)
  end
  
  # Functions - unify return and all params
  if k1 == TYPE_FUNCTION
    var ret1 = storage.return_types[r1]
    var ret2 = storage.return_types[r2]
    if infer_unify(storage, ret1, ret2) != 0
      # continue
    else
      return 0
    end
    var params1 = storage.param_types[r1]
    var params2 = storage.param_types[r2]
    if params1 == 0
      return 1 if params2 == 0
      return 0
    end
    return 0 if params2 == 0
    var len1 = vec_len(params1)
    var len2 = vec_len(params2)
    return 0 if len1 != len2
    for i in 0..len1
      var param_a = params1[i]
      var param_b = params2[i]
      if infer_unify(storage, param_a, param_b) != 0
        # continue
      else
        return 0
      end
    end
    return 1
  end
  
  # Struct/Enum - compare by name
  if k1 == TYPE_STRUCT
    var name1 = as_string(storage.names[r1])
    var name2 = as_string(storage.names[r2])
    if name1.eq(name2)
      return 1
    end
    return 0
  end
  if k1 == TYPE_ENUM
    var name1 = as_string(storage.names[r1])
    var name2 = as_string(storage.names[r2])
    if name1.eq(name2)
      return 1
    end
    return 0
  end
  
  return 0
end

# ============================================================================
# Function Type Constructor (needed for substitution)
# ============================================================================

def infer_make_function(storage: InferStorage, param_types: Int, return_type: Int): Int
  var idx = infer_type_alloc(storage)
  infer_type_set_kind(storage, idx, TYPE_FUNCTION)
  var params_vec = storage.param_types
  params_vec[idx] = param_types
  var ret_vec = storage.return_types
  ret_vec[idx] = return_type
  return idx
end

# ============================================================================
# Free Variables and Generalization (v3.0 Polymorphism)
# ============================================================================
# In Hindley-Milner, generalization abstracts over type variables that are
# "free" in a type but not free in the environment. This creates polytypes
# (∀a. T) that can be instantiated with fresh variables at use sites.

# Collect all type variables in a type (adds to result vec, avoids duplicates)
def infer_collect_type_vars(storage: InferStorage, type_idx: Int, result: Int): Void
  var resolved = infer_resolve_type(storage, type_idx)
  
  # If it's a type variable, add it (if not already present)
  if infer_is_type_var(resolved) != 0
    if any(result, r: Int -> r == resolved) == 0
      vec_push(result, resolved)
    end
    return
  end
  
  # If it's a concrete type, recurse into components
  if resolved >= 0
    var kind = infer_type_get_kind(storage, resolved)
    
    # Array<elem> - recurse into element type
    if kind == TYPE_ARRAY
      var elem = storage.elem_types[resolved]
      infer_collect_type_vars(storage, elem, result)
      return
    end
    
    # Function - recurse into params and return
    if kind == TYPE_FUNCTION
      var ret = storage.return_types[resolved]
      infer_collect_type_vars(storage, ret, result)
      var params = storage.param_types[resolved]
      if params != 0
        var param_count = vec_len(params)
        for j in 0..param_count
          var param_type = vec_get(params, j)
          infer_collect_type_vars(storage, param_type, result)
        end
      end
      return
    end
  end
  # Primitives have no type vars - nothing to collect
end

# Check if a type var ID appears in a vector
def infer_var_in_vec(var_id: Int, v: Int): Int
  return 1 if any(v, x: Int -> x == var_id)
  return 0
end

# Collect type vars from all types bound in environment
def infer_env_collect_type_vars(storage: InferStorage, env: InferEnv, result: Int): Void
  var types = env.types
  var count = types.size
  for i in 0..count
    var type_idx = types[i]
    infer_collect_type_vars(storage, type_idx, result)
  end
end

# Find free type variables in a type (vars not appearing in environment types)
# Returns a vec of type var IDs
def infer_free_vars(storage: InferStorage, env: InferEnv, type_idx: Int): Int
  # Collect all type vars in the type
  var type_vars = vec_new()
  infer_collect_type_vars(storage, type_idx, type_vars)
  
  # Collect all type vars in the environment's types
  var env_vars = vec_new()
  infer_env_collect_type_vars(storage, env, env_vars)
  
  # Filter: keep vars from type that are NOT in env
  var free = filter(type_vars, v: Int -> infer_var_in_vec(v, env_vars) == 0)
  
  return free
end

# ============================================================================
# Polytypes (∀a. T)
# ============================================================================
# A polytype wraps a monotype with a list of quantified type variables.
# Representation: vec with slot 0 = type_idx, slot 1 = vec of quantified vars

# Create a new polytype structure
def infer_polytype_new(type_idx: Int, quantified_vars: Int): Int
  var poly = [type_idx, quantified_vars]
  return poly
end

# Get the underlying monotype from a polytype
def infer_polytype_get_type(poly: Int): Int = poly[0]

# Get the quantified type variables from a polytype
def infer_polytype_get_vars(poly: Int): Int = poly[1]

# Check if a polytype is actually polymorphic (has quantified vars)
def infer_polytype_is_poly(poly: Int): Int
  var vars = infer_polytype_get_vars(poly)
  return 1 if vec_len(vars) > 0
  return 0
end

# Generalize a type by abstracting over free type variables
# Returns a polytype (∀free_vars. type)
def infer_generalize(storage: InferStorage, env: InferEnv, type_idx: Int): Int
  var free = infer_free_vars(storage, env, type_idx)
  return infer_polytype_new(type_idx, free)
end

# ============================================================================
# Substitution and Instantiation
# ============================================================================

# Substitute type vars according to mapping (vec of [old_var, new_var] pairs)
# Returns a new type with substitutions applied
def infer_substitute(storage: InferStorage, type_idx: Int, mapping: Int): Int
  var resolved = infer_resolve_type(storage, type_idx)
  
  # If it's a type var, check if it's in the mapping
  if infer_is_type_var(resolved) != 0
    var count = vec_len(mapping) / 2
    for i in 0..count
      var old_var = mapping[i * 2]
      var new_var = mapping[i * 2 + 1]
      return new_var if resolved == old_var
    end
    # Not in mapping, return as-is
    return resolved
  end
  
  # If it's a concrete type, recurse into components
  if resolved >= 0
    var kind = infer_type_get_kind(storage, resolved)
    
    # Array<elem> - substitute in element type
    if kind == TYPE_ARRAY
      var elem = storage.elem_types[resolved]
      var new_elem = infer_substitute(storage, elem, mapping)
      # Only create new type if elem changed
      return infer_make_array(storage, new_elem) if new_elem != elem
      return resolved
    end
    
    # Function - substitute in params and return
    if kind == TYPE_FUNCTION
      var ret = storage.return_types[resolved]
      var new_ret = infer_substitute(storage, ret, mapping)
      
      var params = storage.param_types[resolved]
      var new_params = vec_new()
      var changed = 0
      if new_ret != ret
        changed = 1
      end
      
      if params != 0
        var param_count = vec_len(params)
        for j in 0..param_count
          var param_type = vec_get(params, j)
          var new_param = infer_substitute(storage, param_type, mapping)
          vec_push(new_params, new_param)
          if new_param != param_type
            changed = 1
          end
        end
      end
      
      # Only create new function type if something changed
      return infer_make_function(storage, new_params, new_ret) if changed != 0
      return resolved
    end
  end
  
  # Primitives return as-is
  return resolved
end

# Instantiate a polytype by replacing quantified vars with fresh vars
# Returns a new monotype
def infer_instantiate(storage: InferStorage, poly: Int): Int
  var type_idx = infer_polytype_get_type(poly)
  var quantified = infer_polytype_get_vars(poly)
  var count = vec_len(quantified)
  
  # No quantified vars - just return the type as-is
  return type_idx if count == 0
  
  # Create fresh vars for each quantified var
  var mapping = vec_new()
  for i in 0..count
    var old_var = quantified[i]
    var new_var = infer_fresh_var(storage)
    mapping.push(old_var)
    mapping.push(new_var)
  end
  
  # Apply substitution to create new type
  return infer_substitute(storage, type_idx, mapping)
end

# ============================================================================
# AST Accessor Helpers (assume ast_storage is vector of vectors like ast.be)
# ============================================================================

def infer_ast_get_kind(ast_storage: ast$AstStorage, node_idx: Int): Int
  var kinds = ast_storage.kinds
  return kinds[node_idx]
end

def infer_ast_get_int_val(ast_storage: ast$AstStorage, node_idx: Int): Int
  var int_vals = ast_storage.int_vals
  return int_vals[node_idx]
end

def infer_ast_get_str1(ast_storage: ast$AstStorage, node_idx: Int): String
  var str1s = ast_storage.str1s
  return as_string(str1s[node_idx])
end

def infer_ast_get_op(ast_storage: ast$AstStorage, node_idx: Int): Int
  var ops = ast_storage.ops
  return ops[node_idx]
end

def infer_ast_get_left(ast_storage: ast$AstStorage, node_idx: Int): Int
  var lefts = ast_storage.lefts
  return lefts[node_idx]
end

def infer_ast_get_right(ast_storage: ast$AstStorage, node_idx: Int): Int
  var rights = ast_storage.rights
  return rights[node_idx]
end

def infer_ast_get_children(ast_storage: ast$AstStorage, node_idx: Int): Int
  var children = ast_storage.children
  return children[node_idx]
end

# Get type annotation string (slot 5) - used for VarDecl type_ann and Def return_type
def infer_ast_get_str2(ast_storage: ast$AstStorage, node_idx: Int): String
  var str2s = ast_storage.str2s
  return as_string(str2s[node_idx])
end

# Get body node (slot 8) - used for function body
def infer_ast_get_body(ast_storage: ast$AstStorage, node_idx: Int): Int
  var bodies = ast_storage.rights
  return bodies[node_idx]
end

def infer_ast_get_line(ast_storage: ast$AstStorage, node_idx: Int): Int
  return ast$ast_get_line(ast_storage, node_idx)
end

def infer_ast_get_col(ast_storage: ast$AstStorage, node_idx: Int): Int
  return ast$ast_get_col(ast_storage, node_idx)
end

# Get a human-readable name for an inferred type
def infer_type_name(storage: InferStorage, t: Int): String
  var resolved = infer_resolve_type(storage, t)
  if resolved < 0
    return "?"
  end
  var kind = infer_type_get_kind(storage, resolved)
  if kind == TYPE_INT
    return "Int"
  end
  if kind == TYPE_BOOL
    return "Bool"
  end
  if kind == TYPE_STRING
    return "String"
  end
  if kind == TYPE_VOID
    return "Void"
  end
  if kind == TYPE_ARRAY
    return "Array"
  end
  if kind == TYPE_FUNCTION
    return "Fn"
  end
  if kind == TYPE_OPTION
    return "Option"
  end
  if kind == TYPE_NIL
    return "Nil"
  end
  if kind == TYPE_UNKNOWN
    return "Unknown"
  end
  return "?"
end

# ============================================================================
# Simple Variable Environment (standalone version)
# ============================================================================

struct InferEnv
  names: Vec<Int>
  types: Vec<Int>
end

# Create a new environment: vector of (name, type) pairs
def infer_env_new(): InferEnv
  return InferEnv { names: vec_new(), types: vec_new() }
end

# Bind a variable
def infer_env_bind(env: InferEnv, name: String, type_idx: Int): Void
  env.names.push(as_int(name))
  env.types.push(type_idx)
end

# Lookup a variable (returns -1 if not found)
def infer_env_lookup(env: InferEnv, name: String): Int
  var names = env.names
  var types = env.types
  var count = names.size
  var i = count - 1
  while i >= 0
    var stored_name = as_string(names[i])
    return types[i] if stored_name.eq(name)
    i -= 1
  end
  return -1
end

# ============================================================================
# Type Inference for Expressions
# ============================================================================

# Check if operator is arithmetic
def is_arithmetic_op(op: Int): Int
  return 1 if op == OP_PLUS
  return 1 if op == OP_MINUS
  return 1 if op == OP_STAR
  return 1 if op == OP_SLASH
  return 1 if op == OP_PERCENT
  return 0
end

# Check if operator is comparison
def is_comparison_op(op: Int): Int
  return 1 if op == OP_EQ
  return 1 if op == OP_NE
  return 1 if op == OP_LT
  return 1 if op == OP_LE
  return 1 if op == OP_GT
  return 1 if op == OP_GE
  return 0
end

# Check if operator is logical
def is_logical_op(op: Int): Int
  return 1 if op == OP_AND
  return 1 if op == OP_OR
  return 0
end

# Main inference function
def infer_expr(type_storage: InferStorage, env: InferEnv, ast_storage: ast$AstStorage, node_idx: Int): Int
  var kind = infer_ast_get_kind(ast_storage, node_idx)
  
  # Integer literal
  return infer_make_int(type_storage) if kind == NodeIntLit
  
  # Boolean literal
  return infer_make_bool(type_storage) if kind == NodeBoolLit
  
  # Nil literal
  return infer_make_nil(type_storage) if kind == NodeNilLit
  
  # String literal
  return infer_make_string(type_storage) if kind == NodeStringLit
  
  # Character literal
  # Identifier - lookup in environment
  if kind == NodeIdent
    var name = infer_ast_get_str1(ast_storage, node_idx)
    var type_idx = infer_env_lookup(env, name)
    # Unknown variable - return unknown type
    return infer_make_unknown(type_storage) if type_idx < 0
    return type_idx
  end
  
  # Binary expression
  if kind == NodeBinary
    var op = infer_ast_get_op(ast_storage, node_idx)
    var left_idx = infer_ast_get_left(ast_storage, node_idx)
    var right_idx = infer_ast_get_right(ast_storage, node_idx)
    
    # Infer operand types (for future type checking)
    var left_type = infer_expr(type_storage, env, ast_storage, left_idx)
    var right_type = infer_expr(type_storage, env, ast_storage, right_idx)
    
    # Arithmetic operators return Int
    return infer_make_int(type_storage) if is_arithmetic_op(op) != 0
    
    # Comparison operators return Bool
    return infer_make_bool(type_storage) if is_comparison_op(op) != 0
    
    # Logical operators return Bool
    return infer_make_bool(type_storage) if is_logical_op(op) != 0
    
    return infer_make_unknown(type_storage)
  end
  
  # Unary expression
  if kind == NodeUnary
    var op = infer_ast_get_op(ast_storage, node_idx)
    var operand_idx = infer_ast_get_left(ast_storage, node_idx)
    var operand_type = infer_expr(type_storage, env, ast_storage, operand_idx)
    
    # Negation returns Int
    return infer_make_int(type_storage) if op == OP_NEG
    
    # Logical not returns Bool
    return infer_make_bool(type_storage) if op == OP_NOT
    
    return operand_type
  end
  
  # Array literal
  if kind == NodeArray
    var children = infer_ast_get_children(ast_storage, node_idx)
    var count = vec_len(children)
    if count > 0
      var first_elem = children[0]
      var elem_type = infer_expr(type_storage, env, ast_storage, first_elem)
      return infer_make_array(type_storage, elem_type)
    end
    var unknown = infer_make_unknown(type_storage)
    return infer_make_array(type_storage, unknown)
  end
  
  # Block expression - type is type of last expression
  if kind == NodeBlock
    var children = infer_ast_get_children(ast_storage, node_idx)
    var count = vec_len(children)
    if count > 0
      var last_idx = children[count - 1]
      return infer_expr(type_storage, env, ast_storage, last_idx)
    end
    return infer_make_void(type_storage)
  end
  
  # If expression - unify then/else branches
  if kind == NodeIf
    var children = infer_ast_get_children(ast_storage, node_idx)
    var count = vec_len(children)
    # If has: condition, then_block, [else_block]
    if count >= 2
      var then_idx = children[1]
      var then_type = infer_expr(type_storage, env, ast_storage, then_idx)
      
      if count >= 3
        var else_idx = children[2]
        var else_type = infer_expr(type_storage, env, ast_storage, else_idx)
        
        # Unify the two branches
        if infer_unify(type_storage, then_type, else_type) != 0
          return infer_resolve_type(type_storage, then_type)
        end
        # Unification failed - return fresh type var for error recovery
        return infer_fresh_var(type_storage)
      end
      # No else branch - if-as-statement returns Void
      return infer_make_void(type_storage)
    end
    return infer_make_void(type_storage)
  end
  
  # Match expression - unify all arms
  if kind == NodeMatch
    var children = infer_ast_get_children(ast_storage, node_idx)
    var count = vec_len(children)
    # Match has: scrutinee, then arm pairs (pattern, body)
    # For now, assume children[1..] are arm bodies
    if count >= 2
      # Start with first arm's type
      var first_arm_idx = children[1]
      var result_type = infer_expr(type_storage, env, ast_storage, first_arm_idx)
      
      # Unify with remaining arms
      for i in 2..count
        var arm_idx = children[i]
        var arm_type = infer_expr(type_storage, env, ast_storage, arm_idx)
        if infer_unify(type_storage, result_type, arm_type) != 0
          # continue
        else
          # Unification failed - return fresh type var
          return infer_fresh_var(type_storage)
        end
      end
      return infer_resolve_type(type_storage, result_type)
    end
    return infer_make_void(type_storage)
  end
  
  # NodeLet (kind 20): let-binding with generalization
  # name in slot 4, type_ann in slot 5, value in slot 7
  if kind == NodeLet
    var name = infer_ast_get_str1(ast_storage, node_idx)
    var value_idx = infer_ast_get_left(ast_storage, node_idx)
    
    # Infer the type of the value expression
    var value_type = infer_expr(type_storage, env, ast_storage, value_idx)
    
    # Generalize: abstract over free type vars not in env
    var poly = infer_generalize(type_storage, env, value_type)
    
    # Bind the generalized type in environment
    # Note: For now, we store the monotype; polytypes need env extension
    infer_env_bind(env, name, value_type)
    
    # VarDecl itself has type Void
    return infer_make_void(type_storage)
  end
  
  # NodeDef (kind 29): function definition with generalization
  # name in slot 4, return_type in slot 5, params in slot 7, body in slot 8
  if kind == NodeDef
    var name = infer_ast_get_str1(ast_storage, node_idx)
    var params_idx = infer_ast_get_left(ast_storage, node_idx)
    var body_idx = infer_ast_get_body(ast_storage, node_idx)
    
    # Create fresh type var for return type
    var ret_var = infer_fresh_var(type_storage)
    
    # Create new environment with params
    var fn_env = infer_env_new()
    var param_types = vec_new()
    
    # Process parameters (if any)
    if params_idx != 0
      var params = infer_ast_get_children(ast_storage, params_idx)
      if params != 0
        var param_count = vec_len(params)
        for i in 0..param_count
          var param_idx = params[i]
          var param_name = infer_ast_get_str1(ast_storage, param_idx)
          # Create fresh type var for each param
          var param_type = infer_fresh_var(type_storage)
          param_types.push(param_type)
          infer_env_bind(fn_env, param_name, param_type)
        end
      end
    end
    
    # Infer body type (if body exists)
    var body_type = ret_var
    if body_idx != 0
      body_type = infer_expr(type_storage, fn_env, ast_storage, body_idx)
      # Unify with return type var
      if infer_unify(type_storage, ret_var, body_type) == 0
        # Unification failed
        body_type = infer_fresh_var(type_storage)
      end
    end
    
    # Create function type
    var fn_type = infer_make_function(type_storage, param_types, infer_resolve_type(type_storage, ret_var))
    
    # Generalize the function type
    var poly = infer_generalize(type_storage, env, fn_type)
    
    # Bind in outer environment
    infer_env_bind(env, name, fn_type)
    
    # Def itself has type Void
    return infer_make_void(type_storage)
  end
  
  # NodeCall (kind 8): function application with instantiation
  # callee in slot 7 (left), args in slot 10 (children)
  if kind == NodeCall
    var callee_idx = infer_ast_get_left(ast_storage, node_idx)
    var args_vec = infer_ast_get_children(ast_storage, node_idx)
    
    # Infer callee type
    var callee_type = infer_expr(type_storage, env, ast_storage, callee_idx)
    var resolved_callee = infer_resolve_type(type_storage, callee_type)
    
    # If callee is a function type, unify args with params
    if resolved_callee >= 0
      var callee_kind = infer_type_get_kind(type_storage, resolved_callee)
      if callee_kind == TYPE_FUNCTION
        var param_types = type_storage.param_types[resolved_callee]
        var ret_type = type_storage.return_types[resolved_callee]
        
        # Unify each argument with corresponding parameter
        if args_vec != 0
          if param_types != 0
            var arg_count = vec_len(args_vec)
            var param_count = vec_len(param_types)
            for i in 0..arg_count
              if i < param_count
                var arg_idx = args_vec[i]
                var arg_type = infer_expr(type_storage, env, ast_storage, arg_idx)
                var param_type = param_types[i]
                if infer_unify(type_storage, arg_type, param_type) == 0
                  type_storage.error_count = type_storage.error_count + 1
                  var arg_line = infer_ast_get_line(ast_storage, arg_idx)
                  var arg_col = infer_ast_get_col(ast_storage, arg_idx)
                  var msg = "Argument type mismatch: expected ".concat(infer_type_name(type_storage, param_type)).concat(", got ").concat(infer_type_name(type_storage, arg_type))
                  infer_add_error(type_storage, msg, arg_line, arg_col)
                end
              end
            end
          end
        end
        
        return infer_resolve_type(type_storage, ret_type)
      end
    end
    
    # If callee is a type var, create function type and unify
    if infer_is_type_var(resolved_callee) != 0
      var arg_types = vec_new()
      if args_vec != 0
        var arg_count = vec_len(args_vec)
        for i in 0..arg_count
          var arg_idx = args_vec[i]
          var arg_type = infer_expr(type_storage, env, ast_storage, arg_idx)
          arg_types.push(arg_type)
        end
      end
      var ret_var = infer_fresh_var(type_storage)
      var fn_type = infer_make_function(type_storage, arg_types, ret_var)
      if infer_unify(type_storage, resolved_callee, fn_type) == 0
        type_storage.error_count = type_storage.error_count + 1
        var call_line = infer_ast_get_line(ast_storage, node_idx)
        var call_col = infer_ast_get_col(ast_storage, node_idx)
        var msg = "Cannot unify callee type with function signature"
        infer_add_error(type_storage, msg, call_line, call_col)
      end
      return ret_var
    end

    # Unknown callee type - return fresh var
    return infer_fresh_var(type_storage)
  end
  
  # Default: unknown type
  return infer_make_unknown(type_storage)
end

# ============================================================================
# Type Equality Check
# ============================================================================
def infer_types_equal(storage: InferStorage, t1: Int, t2: Int): Int
  var k1 = infer_type_get_kind(storage, t1)
  var k2 = infer_type_get_kind(storage, t2)
  
  # Unknown matches anything
  return 1 if k1 == TYPE_UNKNOWN
  return 1 if k2 == TYPE_UNKNOWN
  
  # Kinds must match
  return 0 if k1 != k2
  
  # For arrays, check element types
  if k1 == TYPE_ARRAY
    var elem1 = storage.elem_types[t1]
    var elem2 = storage.elem_types[t2]
    return infer_types_equal(storage, elem1, elem2)
  end
  
  # Primitives are equal if kinds match
  return 1
end

# ============================================================================
# Type to String (for debugging)
# ============================================================================
def infer_type_to_string(storage: InferStorage, type_idx: Int): String
  # Handle type variables (negative IDs)
  if infer_is_type_var(type_idx) != 0
    # Check if bound
    var bound = infer_get_type_binding(storage, type_idx)
    return infer_type_to_string(storage, bound) if bound != 0
    # Unbound type variable - display as 'a, 'b, etc.
    var var_num = 0 - type_idx
    return "'a" if var_num == 1
    return "'b" if var_num == 2
    return "'c" if var_num == 3
    return "'d" if var_num == 4
    return "'?"
  end
  
  var kind = infer_type_get_kind(storage, type_idx)
  
  return "Unknown" if kind == TYPE_UNKNOWN
  return "Void" if kind == TYPE_VOID
  return "Int" if kind == TYPE_INT
  return "Bool" if kind == TYPE_BOOL
  return "String" if kind == TYPE_STRING
  return "Array<...>" if kind == TYPE_ARRAY
  return "Fn(...)" if kind == TYPE_FUNCTION
  return "Struct" if kind == TYPE_STRUCT
  return "Enum" if kind == TYPE_ENUM
  
  return "?"
end

# ============================================================================
# Integration API (for use by typecheck.be)
# ============================================================================
# These functions provide a clean interface for integrating type inference
# with the existing type checking infrastructure.

struct InferGlobals
  storage: Int
  env: InferEnv
end

# Global inference state storage
# Initialized lazily on first use
def infer_globals(): InferGlobals
  return InferGlobals { storage: 0, env: InferEnv { names: vec_new(), types: vec_new() } }
end

# Cached globals (reset per compilation - caller must manage)
def infer_get_globals(): InferGlobals = infer_globals()

# Extract storage from InferGlobals using struct field access.
# Callers in typecheck.qz get globals as Int (from tc_get_infer_globals),
# so globals[0] compiles as Vec subscript (wrong). This helper uses
# .storage field access which generates the correct struct GEP.
def infer_get_storage(g: InferGlobals): Int = g.storage

# Initialize inference system for a compilation unit
def infer_init_with(globals: InferGlobals): Void
  globals.storage = infer_type_storage_new()
  globals.env = infer_env_new()
end

# Infer the type of an expression (main entry point for typecheck.be)
# Returns a TYPE_* constant compatible with typecheck.be
# Caller must pass globals from infer_get_globals()
def infer_expression_type(globals: InferGlobals, ast_storage: ast$AstStorage, node_idx: Int): Int
  if globals.storage == 0
    infer_init_with(globals)
  end
  
  var inferred = infer_expr(globals.storage, globals.env, ast_storage, node_idx)
  var resolved = infer_resolve_type(globals.storage, inferred)
  
  # If still a type variable, return TYPE_UNKNOWN-like value
  return 0 if infer_is_type_var(resolved) != 0  # TYPE_UNKNOWN = 0
  
  # Return the type kind (which matches TYPE_* constants)
  return infer_type_get_kind(globals.storage, resolved)
end

# Get the number of inference errors recorded since last call
def infer_get_error_count(globals: InferGlobals): Int
  if globals.storage == 0
    return 0
  end
  return infer_error_message_count(globals.storage)
end

# Get inference error message at index
def infer_get_error(globals: InferGlobals, idx: Int): String
  return infer_get_error_message(globals.storage, idx)
end

# Get inference error line at index
def infer_get_error_line_at(globals: InferGlobals, idx: Int): Int
  return infer_get_error_line(globals.storage, idx)
end

# Get inference error col at index
def infer_get_error_col_at(globals: InferGlobals, idx: Int): Int
  return infer_get_error_col(globals.storage, idx)
end

# Bind a name to a type in the inference environment
# Used when typecheck.be processes declarations
def infer_bind_name(globals: InferGlobals, name: String, type_kind: Int): Void
  if globals.storage == 0
    infer_init_with(globals)
  end
  
  # Create a concrete type from the kind
  var type_idx = infer_type_alloc(globals.storage)
  infer_type_set_kind(globals.storage, type_idx, type_kind)
  infer_env_bind(globals.env, name, type_idx)
end

# Check if inferred type matches declared type
# Returns 1 if compatible, 0 if not
def infer_check_match(globals: InferGlobals, ast_storage: ast$AstStorage, node_idx: Int, declared_type: Int): Int
  var inferred = infer_expression_type(globals, ast_storage, node_idx)
  
  # If either is unknown, consider it a match (inference incomplete)
  return 1 if inferred == 0
  return 1 if declared_type == 0
  
  # Direct kind match
  return 1 if inferred == declared_type
  
  return 0
end

# Get a fresh type variable (for use in function param inference)
def infer_fresh_type_var(globals: InferGlobals): Int
  if globals.storage == 0
    infer_init_with(globals)
  end
  return infer_fresh_var(globals.storage)
end

# Unify two types and return success
def infer_unify_types(globals: InferGlobals, type1: Int, type2: Int): Int
  if globals.storage == 0
    infer_init_with(globals)
  end
  return infer_unify(globals.storage, type1, type2)
end

# ============================================================================
# Test / Main
# ============================================================================
def main(): Int
  puts("=== Type Inference Module Test ===")
  
  # Create type storage (v3 with type var support)
  var type_storage = infer_type_storage_new()
  puts("Created type storage (v3)")
  
  # Create environment
  var env = infer_env_new()
  puts("Created environment")
  
  # Bind some test variables
  var int_type = infer_make_int(type_storage)
  var bool_type = infer_make_bool(type_storage)
  var str_type = infer_make_string(type_storage)
  
  infer_env_bind(env, "x", int_type)
  infer_env_bind(env, "flag", bool_type)
  infer_env_bind(env, "name", str_type)
  puts("Bound test variables: x:Int, flag:Bool, name:String")
  
  # Test lookups
  var x_type = infer_env_lookup(env, "x")
  var flag_type = infer_env_lookup(env, "flag")
  var unknown_type = infer_env_lookup(env, "unknown_var")
  
  puts("Lookup x: #{infer_type_to_string(type_storage, x_type)}")
  puts("Lookup flag: #{infer_type_to_string(type_storage, flag_type)}")
  
  puts("Lookup unknown_var: not found (correct)") if unknown_type < 0
  
  # Test type creation
  var arr_type = infer_make_array(type_storage, int_type)
  puts("Created Array<Int>: #{infer_type_to_string(type_storage, arr_type)}")
  
  # Test type equality
  var int2 = infer_make_int(type_storage)
  if infer_types_equal(type_storage, int_type, int2) != 0
    puts("Int == Int: true (correct)")
  end
  
  if infer_types_equal(type_storage, int_type, bool_type) != 0
    puts("Int == Bool: true (wrong!)")
  else
    puts("Int == Bool: false (correct)")
  end
  
  # ========================================
  # v3.0 Type Variable Tests
  # ========================================
  puts("")
  puts("=== v3.0 Type Variable Tests ===")
  
  # Test fresh_var generation
  var t1 = infer_fresh_var(type_storage)
  var t2 = infer_fresh_var(type_storage)
  var t3 = infer_fresh_var(type_storage)
  puts("Created type vars: #{infer_type_to_string(type_storage, t1)}, #{infer_type_to_string(type_storage, t2)}, #{infer_type_to_string(type_storage, t3)}")
  
  # Test is_type_var
  if infer_is_type_var(t1) != 0
    puts("is_type_var('a): true (correct)")
  else
    puts("is_type_var('a): false (wrong!)")
  end
  
  if infer_is_type_var(int_type) != 0
    puts("is_type_var(Int): true (wrong!)")
  else
    puts("is_type_var(Int): false (correct)")
  end
  
  # Test unification: 'a with Int
  puts("")
  puts("Testing unify('a, Int)...")
  var fresh_a = infer_fresh_var(type_storage)
  if infer_unify(type_storage, fresh_a, int_type) != 0
    puts("unify('a, Int): success (correct)")
    var resolved = infer_resolve_type(type_storage, fresh_a)
    puts("resolve('a): #{infer_type_to_string(type_storage, resolved)}")
  else
    puts("unify('a, Int): failed (wrong!)")
  end
  
  # Test unification: Int with Int
  puts("")
  puts("Testing unify(Int, Int)...")
  if infer_unify(type_storage, int_type, int2) != 0
    puts("unify(Int, Int): success (correct)")
  else
    puts("unify(Int, Int): failed (wrong!)")
  end
  
  # Test unification failure: Int with Bool
  puts("")
  puts("Testing unify(Int, Bool)...")
  if infer_unify(type_storage, int_type, bool_type) != 0
    puts("unify(Int, Bool): success (wrong!)")
  else
    puts("unify(Int, Bool): failed (correct)")
  end
  
  # Test unification: 'b with 'c (both unbound)
  puts("")
  puts("Testing unify('b, 'c)...")
  var fresh_b = infer_fresh_var(type_storage)
  var fresh_c = infer_fresh_var(type_storage)
  if infer_unify(type_storage, fresh_b, fresh_c) != 0
    puts("unify('b, 'c): success (correct)")
    # Now bind 'c to String
    if infer_unify(type_storage, fresh_c, str_type) != 0
      puts("unify('c, String): success")
      # 'b should now resolve to String too
      var resolved_b = infer_resolve_type(type_storage, fresh_b)
      puts("resolve('b): #{infer_type_to_string(type_storage, resolved_b)}")
    end
  else
    puts("unify('b, 'c): failed (wrong!)")
  end
  
  # Test occurs check: prevent infinite types
  puts("")
  puts("Testing occurs check...")
  var fresh_d = infer_fresh_var(type_storage)
  var arr_d = infer_make_array(type_storage, fresh_d)
  if infer_unify(type_storage, fresh_d, arr_d) != 0
    puts("unify('d, Array<'d>): success (wrong - should fail!)")
  else
    puts("unify('d, Array<'d>): failed (correct - infinite type)")
  end
  
  # ========================================
  # v3.0 Generalization & Instantiation Tests
  # ========================================
  puts("")
  puts("=== v3.0 Generalization Tests ===")
  
  # Reset for clean tests
  infer_reset_type_vars(type_storage)
  var env2 = infer_env_new()
  
  # Test 1: free_vars on a simple type var (should be free)
  var alpha = infer_fresh_var(type_storage)
  var free1 = infer_free_vars(type_storage, env2, alpha)
  puts("free_vars('a) in empty env: #{vec_len(free1)} vars")
  if vec_len(free1) == 1
    puts("  Got 1 free var (correct)")
  else
    puts("  Wrong count!")
  end
  
  # Test 2: free_vars on Int (should be 0 free vars)
  var int_t = infer_make_int(type_storage)
  var free2 = infer_free_vars(type_storage, env2, int_t)
  puts("free_vars(Int) in empty env: #{vec_len(free2)} vars")
  if vec_len(free2) == 0
    puts("  Got 0 free vars (correct)")
  else
    puts("  Wrong count!")
  end
  
  # Test 3: free_vars on Array<'b> (should have 1 free var)
  var beta = infer_fresh_var(type_storage)
  var arr_beta = infer_make_array(type_storage, beta)
  var free3 = infer_free_vars(type_storage, env2, arr_beta)
  puts("free_vars(Array<'b>) in empty env: #{vec_len(free3)} vars")
  if vec_len(free3) == 1
    puts("  Got 1 free var (correct)")
  else
    puts("  Wrong count!")
  end
  
  # Test 4: free_vars with env containing the var (should be 0)
  var env3 = infer_env_new()
  infer_env_bind(env3, "x", beta)  # beta is now in env
  var free4 = infer_free_vars(type_storage, env3, arr_beta)
  puts("free_vars(Array<'b>) with 'b in env: #{vec_len(free4)} vars")
  if vec_len(free4) == 0
    puts("  Got 0 free vars (correct - 'b is bound in env)")
  else
    puts("  Wrong count!")
  end
  
  # Test 5: generalize creates polytype
  puts("")
  puts("Testing generalization...")
  var gamma = infer_fresh_var(type_storage)
  var arr_gamma = infer_make_array(type_storage, gamma)
  var env4 = infer_env_new()
  var poly1 = infer_generalize(type_storage, env4, arr_gamma)
  var poly_vars = infer_polytype_get_vars(poly1)
  puts("generalize(Array<'c>) in empty env:")
  puts("  Quantified vars: #{vec_len(poly_vars)}")
  if vec_len(poly_vars) == 1
    puts("  Got 1 quantified var (correct)")
  else
    puts("  Wrong count!")
  end
  if infer_polytype_is_poly(poly1) != 0
    puts("  is_poly: true (correct)")
  else
    puts("  is_poly: false (wrong!)")
  end
  
  # Test 6: generalize with var in env (should not quantify)
  var env5 = infer_env_new()
  infer_env_bind(env5, "y", gamma)
  var poly2 = infer_generalize(type_storage, env5, arr_gamma)
  var poly_vars2 = infer_polytype_get_vars(poly2)
  puts("generalize(Array<'c>) with 'c in env:")
  puts("  Quantified vars: #{vec_len(poly_vars2)}")
  if vec_len(poly_vars2) == 0
    puts("  Got 0 quantified vars (correct - 'c is in env)")
  else
    puts("  Wrong count!")
  end
  
  # Test 7: instantiate creates fresh vars
  puts("")
  puts("Testing instantiation...")
  var delta = infer_fresh_var(type_storage)
  var arr_delta = infer_make_array(type_storage, delta)
  var env6 = infer_env_new()
  var poly3 = infer_generalize(type_storage, env6, arr_delta)
  puts("Created polytype forall 'd. Array<'d>")
  
  var inst1 = infer_instantiate(type_storage, poly3)
  var inst2 = infer_instantiate(type_storage, poly3)
  puts("inst1 type: #{infer_type_to_string(type_storage, inst1)}")
  puts("inst2 type: #{infer_type_to_string(type_storage, inst2)}")
  
  # The two instances should have different fresh vars
  # We can check by getting the element types
  if inst1 != inst2
    puts("  Two instantiations are different types (correct)")
  else
    puts("  Same type returned (could be OK if array wrapping)")
  end
  
  # Test 8: instantiate non-polymorphic type returns same
  var int_poly = infer_polytype_new(int_t, vec_new())
  var inst3 = infer_instantiate(type_storage, int_poly)
  if inst3 == int_t
    puts("instantiate(Int) returns same Int (correct)")
  else
    puts("instantiate(Int) returned different type")
  end
  
  # Test 9: Function type with type vars
  puts("")
  puts("Testing function type generalization...")
  var fn_var = infer_fresh_var(type_storage)
  var fn_params = [fn_var]
  var fn_type = infer_make_function(type_storage, fn_params, fn_var)
  var env7 = infer_env_new()
  var fn_free = infer_free_vars(type_storage, env7, fn_type)
  puts("free_vars(Fn('e): 'e) = #{vec_len(fn_free)} vars")
  if vec_len(fn_free) == 1
    puts("  Got 1 free var (correct - same var in param and return)")
  else
    puts("  Wrong count!")
  end
  
  var fn_poly = infer_generalize(type_storage, env7, fn_type)
  var fn_inst1 = infer_instantiate(type_storage, fn_poly)
  var fn_inst2 = infer_instantiate(type_storage, fn_poly)
  puts("Instantiated identity function twice")
  if fn_inst1 != fn_inst2
    puts("  Different instances (correct)")
  else
    puts("  Same instance")
  end
  
  # ========================================
  # v3.0 Polymorphic Function Tests
  # ========================================
  puts("")
  puts("=== v3.0 Polymorphic Function Tests ===")
  
  # Test 10: Identity function pattern - the core HM use case
  # def identity(x): return x end
  # identity(42)    -> Int
  # identity("hi")  -> String
  puts("")
  puts("Testing identity function polymorphism...")
  
  # Create identity function: forall a. a -> a
  var id_var = infer_fresh_var(type_storage)
  var id_params = [id_var]
  var id_fn = infer_make_function(type_storage, id_params, id_var)
  var id_env = infer_env_new()
  var id_poly = infer_generalize(type_storage, id_env, id_fn)
  
  # Instantiate for Int usage
  var id_int = infer_instantiate(type_storage, id_poly)
  var id_int_params = type_storage.param_types[id_int]
  var id_int_param = id_int_params[0]
  var id_int_ret = type_storage.return_types[id_int]
  
  # Unify param with Int
  var test_int = infer_make_int(type_storage)
  infer_unify(type_storage, id_int_param, test_int)
  var resolved_ret = infer_resolve_type(type_storage, id_int_ret)
  var ret_kind = infer_type_get_kind(type_storage, resolved_ret)
  puts("identity(Int) return type: #{infer_type_to_string(type_storage, resolved_ret)}")
  if ret_kind == TYPE_INT
    puts("  Returns Int (correct)")
  else
    puts("  Wrong return type!")
  end
  
  # Instantiate again for String usage (fresh instance)
  var id_str = infer_instantiate(type_storage, id_poly)
  var id_str_params = type_storage.param_types[id_str]
  var id_str_param = id_str_params[0]
  var id_str_ret = type_storage.return_types[id_str]
  
  # Unify param with String
  var test_str = infer_make_string(type_storage)
  infer_unify(type_storage, id_str_param, test_str)
  var resolved_str_ret = infer_resolve_type(type_storage, id_str_ret)
  var str_ret_kind = infer_type_get_kind(type_storage, resolved_str_ret)
  puts("identity(String) return type: #{infer_type_to_string(type_storage, resolved_str_ret)}")
  if str_ret_kind == TYPE_STRING
    puts("  Returns String (correct)")
  else
    puts("  Wrong return type!")
  end
  
  # Test 11: Two-argument function
  # def const(x, y): return x end
  # forall a b. a -> b -> a
  puts("")
  puts("Testing const function (a -> b -> a)...")
  var const_a = infer_fresh_var(type_storage)
  var const_b = infer_fresh_var(type_storage)
  var const_params = [const_a, const_b]
  var const_fn = infer_make_function(type_storage, const_params, const_a)
  var const_env = infer_env_new()
  var const_free = infer_free_vars(type_storage, const_env, const_fn)
  puts("free_vars(const): #{vec_len(const_free)} vars")
  if vec_len(const_free) == 2
    puts("  Got 2 free vars (correct)")
  else
    puts("  Wrong count!")
  end
  
  var const_poly = infer_generalize(type_storage, const_env, const_fn)
  var const_vars = infer_polytype_get_vars(const_poly)
  puts("Quantified vars: #{vec_len(const_vars)}")
  if vec_len(const_vars) == 2
    puts("  Got 2 quantified vars (correct)")
  else
    puts("  Wrong count!")
  end
  
  # Test 12: Nested function types (higher-order)
  # map : forall a b. (a -> b) -> Array<a> -> Array<b>
  puts("")
  puts("Testing higher-order function (map-like)...")
  var map_a = infer_fresh_var(type_storage)
  var map_b = infer_fresh_var(type_storage)
  
  # Inner function: a -> b
  var inner_params = [map_a]
  var inner_fn = infer_make_function(type_storage, inner_params, map_b)
  
  # Array types
  var arr_a = infer_make_array(type_storage, map_a)
  var arr_b = infer_make_array(type_storage, map_b)
  
  # Outer function: (a -> b) -> Array<a> -> Array<b>
  var outer_params = [inner_fn, arr_a]
  var map_fn = infer_make_function(type_storage, outer_params, arr_b)
  
  var map_env = infer_env_new()
  var map_free = infer_free_vars(type_storage, map_env, map_fn)
  puts("free_vars(map): #{vec_len(map_free)} vars")
  if vec_len(map_free) == 2
    puts("  Got 2 free vars (correct - a and b)")
  else
    puts("  Wrong count!")
  end
  
  # Test 13: Type variable propagation through structures
  puts("")
  puts("Testing type var propagation...")
  var prop_var = infer_fresh_var(type_storage)
  var prop_arr = infer_make_array(type_storage, prop_var)
  
  # Bind var to Bool
  var test_bool = infer_make_bool(type_storage)
  infer_unify(type_storage, prop_var, test_bool)
  
  # Array element should now be Bool
  var arr_elem = type_storage.elem_types[prop_arr]
  var resolved_elem = infer_resolve_type(type_storage, arr_elem)
  var elem_kind = infer_type_get_kind(type_storage, resolved_elem)
  puts("Array<'x> after unify('x, Bool): #{infer_type_to_string(type_storage, prop_arr)}")
  if elem_kind == TYPE_BOOL
    puts("  Element is Bool (correct - propagation worked)")
  else
    puts("  Wrong element type!")
  end
  
  puts("")
  puts("=== All Tests Complete ===")
  return 0
end
