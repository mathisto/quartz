# Asset baker for the Quartz unikernel.
#
# Walks site/dist/, emits tools/baremetal/site_assets.qz containing
# assets_init() which the kernel calls at boot. Each asset is encoded
# as a hex-escaped Quartz string literal that the kernel copies into
# fresh PMM pages via copy_str_to_pmm (defined in hello_x86.qz).
#
# Regenerate with: ./self-hosted/bin/quake baremetal:bake_assets
# (site/dist/ must be built first via `cd site && npm run build`.)
#
# Routing rules (Astro → Quartz-unikernel):
#   site/dist/index.html                    → /marketing
#     (the dynamic `/` route remains the live-telemetry landing page)
#   site/dist/foo/bar/index.html            → /foo/bar
#   site/dist/anything/else.css             → /anything/else.css
#
# MIME detection is extension-based. Unknown extensions get
# application/octet-stream — noisy but not a security issue for
# static content that we authored.

import io/file
import string

# Inline shell capture to avoid importing * from quake (which collides
# with the sibling tools/quake.qz launcher when this file is compiled
# from tools/). Mirrors std/quake.qz's sh_capture via the same
# pipe_open / fread / pipe_close intrinsics.
def shell_capture(cmd: String): String
  var h = pipe_open(cmd, "r")
  if h == 0
    return ""
  end
  var out = ""
  var buf = fread(h, 4096)
  while str_byte_len(buf) > 0
    out = "#{out}#{buf}"
    buf = fread(h, 4096)
  end
  var _ignored = pipe_close(h)
  return out
end

def hex_digit(n: Int): Int
  if n < 10
    return 48 + n
  end
  return 87 + n
end

# Encode raw bytes as a Quartz \xNN-escaped string literal body
# (without surrounding quotes). 4x bloat but byte-exact and safe for
# all content including control chars and non-UTF-8.
def append_hex_escaped(sb: StringBuilder, s: String): Void
  var n = str_byte_len(s)
  var i = 0
  while i < n
    var b = str_byte_at(s, i)
    sb.append_char(92)
    sb.append_char(120)
    sb.append_char(hex_digit((b >> 4) & 0xF))
    sb.append_char(hex_digit(b & 0xF))
    i = i + 1
  end
end

def detect_mime(rel: String): String
  if str_ends_with(rel, ".html")
    return "text/html; charset=utf-8"
  end
  if str_ends_with(rel, ".css")
    return "text/css; charset=utf-8"
  end
  if str_ends_with(rel, ".js")
    return "application/javascript; charset=utf-8"
  end
  if str_ends_with(rel, ".svg")
    return "image/svg+xml"
  end
  if str_ends_with(rel, ".ico")
    return "image/x-icon"
  end
  if str_ends_with(rel, ".png")
    return "image/png"
  end
  if str_ends_with(rel, ".woff2")
    return "font/woff2"
  end
  if str_ends_with(rel, ".json")
    return "application/json; charset=utf-8"
  end
  if str_ends_with(rel, ".wasm")
    return "application/wasm"
  end
  if str_ends_with(rel, ".ch8")
    return "application/octet-stream"
  end
  if str_ends_with(rel, ".qz")
    return "text/plain; charset=utf-8"
  end
  return "application/octet-stream"
end

# Convert a dist-relative path (e.g. "docs/patterns/index.html") to its
# served URL path (e.g. "/docs/patterns"). Astro's convention is
# directory/index.html → /directory.
def dist_to_served(rel: String): String
  if rel == "index.html"
    return "/marketing"
  end
  if str_ends_with(rel, "/index.html")
    var base_end = str_byte_len(rel) - str_byte_len("/index.html")
    return "/" + str_byte_slice(rel, 0, base_end)
  end
  return "/" + rel
end

def emit_header(sb: StringBuilder, asset_count: Int, total_bytes: Int): Void
  sb.append("# AUTO-GENERATED by tools/bake_assets.qz. Do not edit by hand.\n")
  sb.append("# Regenerate with: ./self-hosted/bin/quake baremetal:bake_assets\n")
  sb.append("#\n")
  sb.append("# Assets: ")
  sb.append(asset_count.to_s())
  sb.append(", total body bytes: ")
  sb.append(total_bytes.to_s())
  sb.append("\n#\n")
  sb.append("# Concatenated into hello_x86.qz at build time; provides\n")
  sb.append("# assets_init() which the kernel calls once at boot.\n\n")
  sb.append("def assets_init(): Void\n")
end

def main(): Int
  var dist_root = "site/dist"
  var dist_prefix = "site/dist/"
  var out_path = "tools/baremetal/site_assets.qz"

  if not file_exists(dist_root)
    eputs("error: #{dist_root}/ not found — run `cd site && npm run build` first")
    return 1
  end

  # Enumerate files via find (follows the symlink installed by the
  # worktree bring-up). Simpler than recursing via file_list_dir +
  # heuristic is_file checks, and the set is stable per Astro build.
  var find_out = shell_capture("find -L #{dist_root} -type f | sort")
  var lines = str_split(find_out, "\n")

  var sb = sb_new()
  sb.append("# AUTO-GENERATED — placeholder until we know asset count.\n")   # overwritten below

  # Walk lines, read each file, accumulate (path, mime, bytes).
  # We can't emit the final header until we know the asset count, so
  # we'll build body + header separately and join at the end.
  var body = sb_new()
  var asset_count = 0
  var total_bytes = 0

  var i = 0
  while i < lines.size
    var full = lines[i]
    if str_byte_len(full) > 0 and str_starts_with(full, dist_prefix)
      var rel = str_byte_slice(full, str_byte_len(dist_prefix), str_byte_len(full))
      var served = dist_to_served(rel)
      var mime = detect_mime(rel)
      var content = read_file(full)
      var n = str_byte_len(content)

      total_bytes = total_bytes + n
      body.append("  asset_register(\"")
      body.append(served)
      body.append("\", \"")
      body.append(mime)
      body.append("\", copy_str_to_pmm(\"")
      append_hex_escaped(body, content)
      body.append("\", ")
      body.append(n.to_s())
      body.append("), ")
      body.append(n.to_s())
      body.append(")\n")
      asset_count = asset_count + 1
    end
    i = i + 1
  end

  var out_sb = sb_new()
  emit_header(out_sb, asset_count, total_bytes)
  out_sb.append(body.to_string())
  out_sb.append("end\n")

  var out = out_sb.to_string()
  write_file(out_path, out)
  puts("Baked #{asset_count} assets, #{total_bytes} bytes → #{out_path}")
  return 0
end
