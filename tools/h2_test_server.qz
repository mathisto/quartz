import net/http_server

def main(): Int
  var config = http_server_config(8443)
  config.read_timeout_ms = 5000
  config.write_timeout_ms = 5000
  var tls = HttpsTlsConfig {
    cert_file: "/tmp/h2_cert.pem",
    key_file: "/tmp/h2_key.pem"
  }
  https_serve_supervised(config, tls) do req: Request ->
    if req.path == "/json"
      json_response("{\"protocol\": \"h2\", \"method\": \"" + req.method + "\"}")
    else
      text_response("Hello from Quartz HTTP/2!")
    end
  end
  return 0
end
