# be-fmt: Be source code formatter (simplified v1)
# Enforces basic STYLE.md conventions

## Convert character code at position to string
def char_at(s: String, i: Int): String = str_from_char(s.str_byte_at(i))

def is_alpha_code(code: Int): Bool
  return (code >= 'a' and code <= 'z') or (code >= 'A' and code <= 'Z') or code == '_'
end

def is_digit_code(code: Int): Bool = code >= '0' and code <= '9'

def is_alnum_code(code: Int): Bool = is_alpha_code(code) or is_digit_code(code)

def is_space_code(code: Int): Bool = code == ' ' or code == '\t'

def str_is_alpha(c: String): Bool = is_alpha_code(c.str_byte_at(0))

def str_is_digit(c: String): Bool = is_digit_code(c.str_byte_at(0))

def str_is_alnum(c: String): Bool = is_alnum_code(c.str_byte_at(0))

def str_is_space(c: String): Bool = is_space_code(c.str_byte_at(0))

def indent_str(level: Int): String
  var result = ""
  for i in 0..level
    result = "#{result}  "
  end
  return result
end

def is_indent_keyword(word: String): Bool
  return word == "def" or word == "if" or word == "elsif" or 
         word == "else" or word == "while" or word == "for" or
         word == "struct" or word == "enum" or word == "match" or
         word == "when" or word == "module"
end

def format_source(source: String): String
  var output = ""
  var indent = 0
  var pos = 0
  len = str_byte_len(source)
  var at_line_start = true
  
  while pos < len
    var c = char_at(source, pos)
    
    if c == "\n"
      output = "#{output}\n"
      at_line_start = true
      pos += 1
    elsif str_is_space(c) and at_line_start
      pos += 1
    elsif c == "#"
      if at_line_start
        output = "#{output}#{indent_str(indent)}"
      end
      while pos < len and char_at(source, pos) != "\n"
        output = "#{output}#{char_at(source, pos)}"
        pos += 1
      end
      at_line_start = false
    elsif str_is_alpha(c)
      var word = ""
      while pos < len and str_is_alnum(char_at(source, pos))
        word = "#{word}#{char_at(source, pos)}"
        pos += 1
      end
      
      if word == "end" and at_line_start
        indent -= 1
        if indent < 0
          indent = 0
        end
      end
      
      if at_line_start
        output = "#{output}#{indent_str(indent)}"
        at_line_start = false
      end
      
      output = "#{output}#{word}"
      
      if is_indent_keyword(word) and not at_line_start
        indent += 1
      end
    elsif str_is_digit(c)
      if at_line_start
        output = "#{output}#{indent_str(indent)}"
        at_line_start = false
      end
      while pos < len and (str_is_alnum(char_at(source, pos)) or char_at(source, pos) == ".")
        output = "#{output}#{char_at(source, pos)}"
        pos += 1
      end
    elsif c == "\"" or c == "'"
      if at_line_start
        output = "#{output}#{indent_str(indent)}"
        at_line_start = false
      end
      var q_char = c
      output = "#{output}#{c}"
      pos += 1
      while pos < len
        var ch = char_at(source, pos)
        output = "#{output}#{ch}"
        pos += 1
        if ch == "\\"
          if pos < len
            output = "#{output}#{char_at(source, pos)}"
            pos += 1
          end
        elsif ch == q_char
          break
        end
      end
    else
      if at_line_start and not str_is_space(c)
        output = "#{output}#{indent_str(indent)}"
        at_line_start = false
      end
      if not str_is_space(c) or not at_line_start
        output = "#{output}#{c}"
      end
      pos += 1
    end
  end
  
  return output
end

## Standalone demo / test harness (not used when imported as a library).
def fmt_demo(): Int
  puts("be-fmt: Be source formatter")
  puts("Usage: Pipe source or use read_file")
  
  test_source = "def foo(x: Int): Int\nif x > 0\nreturn x\nend\nreturn 0\nend"
  puts("Input:")
  puts(test_source)
  puts("")
  puts("Output:")
  puts(format_source(test_source))
  
  return 0
end
