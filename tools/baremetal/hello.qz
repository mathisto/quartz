# Bare metal hello world for QEMU aarch64-virt
# Boots with no OS, no libc, writes to PL011 UART
#
# Build:
#   quartz --target aarch64-unknown-none hello.qz | \
#     llc -march=aarch64 -filetype=obj -o hello.o
#   ld.lld -T aarch64-virt.ld -o hello.elf hello.o
#
# Run:
#   qemu-system-aarch64 -M virt -cpu cortex-a57 -nographic -kernel hello.elf

# PL011 UART base address on QEMU virt machine
const UART_BASE = 0x09000000

# Write a single byte to UART data register
def uart_putc(c: Int): Void
  volatile_store<U8>(UART_BASE, c)
end

# Write a null-terminated string to UART byte by byte
def uart_puts(s: Int): Void
  var i = 0
  var byte = ptr_read_byte(s + i)
  while byte != 0
    uart_putc(byte)
    i = i + 1
    byte = ptr_read_byte(s + i)
  end
end

# Entry point: set up stack and jump to main
@naked
def _start(): Int
  @c("ldr x0, =_stack_top; mov sp, x0; bl qz_main; 1: wfe; b 1b")
end

# Main program
def main(): Int
  uart_puts(as_int("Hello from Quartz!"))
  uart_putc(10)
  return 0
end
