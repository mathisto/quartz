# Bare metal hello world for QEMU x86_64.
# x86_64 twin of tools/baremetal/hello.qz.
#
# Entry is NOT in this file — `tools/baremetal/boot_trampoline_x86.s`
# owns `_start` and handles the 32→64 long-mode transition (GDT +
# identity-mapped PML4 + CR3/CR4/EFER/CR0 setup + far-jump to 64-bit
# code). Once in 64-bit mode the trampoline calls qz_main, which is
# compiled from this file.
#
# COM1 16550 UART at I/O port 0x3F8 drives the "-serial stdio" output
# under `qemu-system-x86_64 -kernel ... -serial stdio`.
#
# Build pipeline (`quake baremetal:qemu_boot_x86_64`):
#   quartz --target x86_64-unknown-none-elf hello_x86.qz
#     | llc -march=x86-64 -mattr=-sse,-mmx,-avx -relocation-model=static
#     | ld.lld -T x86_64-multiboot.ld
#       (+ boot_trampoline_x86.o + multiboot_headers.o + libc_stubs.o
#        + .quartz-cache/hacl-x86-freestanding/*.o for WireGuard)

# NET.1 Phase 1, Step 2.5 — WireGuard glue. Imports the userspace WG
# stack (handshake / transport / timers / device) on top of the
# crypto stdlib (HACL* via FFI). Entropy comes from RDRAND/RDSEED via
# `rng_new_hw` (no POSIX `getentropy(3)` in freestanding). The unikernel
# acts as a responder for now — outbound-initiator paths are wired but
# require a peer with a known endpoint, which only Step 2.6 (interop)
# will exercise via wg-quick / boringtun.
import std/net/wireguard/device
import std/net/wireguard/peer
import std/net/wireguard/handshake
import std/net/wireguard/session
import std/net/wireguard/timers
import std/crypto/noise
import std/crypto/rng
import std/core/crypto/zeroize
# K8.5: Spinlock for ready-queue gating once AP runs sched_pump.
# Bare names — `import * from` keeps spinlock_lock / spinlock_unlock
# at the call sites where they appear in tight loops. Pulled from the
# split-out spinlock module (not std/sync directly) because std/sync's
# Semaphore uses channel codegen, which references hosted-only TLS
# globals (@__qz_current_frame) that the freestanding target can't link.
import * from std/sync/exclusion/spinlock
# K8.9: userland M:N scheduler exposition. Same import shape as
# spinlock — bare names, freestanding-safe, owns the kern8_gs_load_u64
# extern declaration. The kernel calls scheduler_register_pcpu_pages
# right after kern8_pcpu_init to wire the API to live state.
import * from std/sync/scheduler
# D.11 Phase 7 / B.3: Throws effect for the bridge-roundtrip smoke. Pulls
# in the `Throws` effect decl + `throw(msg: String)` op so the
# `b3_throws_body` goroutine below can exercise the freestanding
# perform-dispatch unwind path through `with Throws { throw: h } do ->
# throw("oops") end`. std/throws.qz has zero transitive imports —
# adding it costs ~no kernel-binary growth.
import std/throws

# D.11 Phase 7 / B.5a — Selectable trait for kernel-side awaitable.
# Trait surface only; zero transitive imports. The trait definition has
# no implementations, so it costs zero kernel-binary growth on its own.
# Kernel-side `extend KAwait with Selectable<Int>` lives further below
# (around the b3/b4 smoke block).
import * from std/selectable

# D.11 Phase 7 / B.5d.1 — stdlib channel intrinsics in freestanding.
# Path A: cg_intrinsic_conc_channel.qz redirects channel_new/send/recv/
# channel_close/channel_closed/channel_size/channel_capacity/
# channel_is_empty/channel_is_full to the kernel's chan_* surface.
# B.5d.1's PASS 1.2b+1.3 freestanding gate in mir_lower.qz suppresses
# __Future_X$poll wrapper synthesis — the wrapper bodies would
# reference hosted runtime (@__qz_current_frame, pthread_*,
# racedet/panic side-tables) that the kernel doesn't link. With the
# gate, importing channel pulls only Scoped + Selectable trait surfaces.
import * from std/sync/communication/channel

# Bring the stdlib HTTP server in scope so a goroutine in main can call
# `http_serve_supervised` on port 80. The supervised path is the only
# kernel HTTP path — the hand-rolled inline path was deleted in D.11
# Phase 8c.2 once dual-port parity proved the migration. The wildcard
# import keeps `Request` / `Response` / `html_response` /
# `http_server_config` unqualified at the call sites below; ld.lld's
# `--gc-sections` (Quakefile `baremetal:build_elf` + `baremetal:qemu_http`)
# drops every unreachable function in http_server.qz's transitive
# closure (TLS subgraph, h2, static middleware).
import * from std/net/http_server

# Log effect surface — `with Log { emit: kernel_log_emit } do -> ... end`
# in `supervised_server_body` routes http_server's `log::info` calls to
# UART. http_server.qz also imports std/log; this brings `Log` into
# scope at the kernel side so the `with` handler can be written here.
import * from std/log

# B.5e.8c — the real std/actor.qz Supervisor (Supervisor struct, watcher
# loop, supervisor_new / supervisor_child / supervisor_restart_count /
# supervisor_stop). First time the full Actor + Supervisor stdlib stack
# compiles into the kernel; everything beneath it (the `actor ... end`
# keyword, channels, scheduler) is already freestanding.
import * from std/actor

# 16550 UART port layout. COM1 base = 0x3F8.
const UART_DATA = 0x3F8  # RBR (read) / THR (write) — data byte
const UART_IER  = 0x3F9  # Interrupt Enable Register
const UART_FCR  = 0x3FA  # FIFO Control Register
const UART_LCR  = 0x3FB  # Line Control Register
const UART_MCR  = 0x3FC  # Modem Control Register
const UART_LSR  = 0x3FD  # Line Status Register

# LSR bit 5 (0x20) = Transmitter Holding Register Empty — safe to write.
const LSR_THRE = 0x20

# 8259A PIC data-port addresses. We keep these around only to mask the
# legacy PIC lines (write 0xFF to both data ports) before enabling the
# APIC, to keep the PIC from delivering spurious interrupts alongside
# the APIC. Everything else PIC-related has been retired in favor of
# the LAPIC.
const PIC_MASTER_DATA = 0x21
const PIC_SLAVE_DATA  = 0xA1

# Local APIC (LAPIC) — per-CPU interrupt controller on every x86-64
# core. We use the legacy MMIO interface (vs. the newer MSR-based
# x2APIC) because it works uniformly in TCG, KVM, and on bare-metal
# without capability gating.
#
# The global enable lives in MSR IA32_APIC_BASE (0x1B), bit 11. Once
# enabled, the LAPIC exposes a 4 KiB register window starting at a
# physical address whose upper 20 bits live in bits 12-31 of the same
# MSR — 0xFEE00000 by default, which is what we identity-map in
# boot_trampoline_x86.s (pd_apic[503]).
const MSR_IA32_APIC_BASE = 0x1B
const APIC_GLOBAL_ENABLE = 0x800             # MSR bit 11
const APIC_MMIO_BASE     = 0xFEE00000        # default LAPIC MMIO

# LAPIC register offsets. Each register is 32 bits wide, naturally
# aligned to a 16-byte boundary.
const APIC_REG_EOI      = 0xB0   # End-of-interrupt — write 0 after any ISR
const APIC_REG_SPURIOUS = 0xF0   # Spurious-interrupt vector + bit 8 = software enable
const APIC_REG_LVT_TIMER = 0x320 # Local Vector Table entry for timer
const APIC_REG_INITIAL   = 0x380 # Initial count (counts down to 0)
const APIC_REG_DIVIDE    = 0x3E0 # Divide config for the timer's bus-clock source

# Timer vector: 0x20, same slot we used for the retired PIT IRQ0. By
# reusing 0x20, the existing IDT entry + ISR setup continue to work
# as-is.
const APIC_TIMER_VECTOR = 0x20
# K8.7 — cross-CPU wake-up IPI vector. Sent by ready_push when a task
# transitions the global queue from empty → non-empty; idle CPUs in
# `hlt` wake, run the no-op ISR (just acks LAPIC), and loop back into
# sched_pump. Vector picked just above timer (0x20) to keep our
# LAPIC-driven vectors contiguous; nothing else uses 0x21.
const APIC_WAKE_IPI_VECTOR = 0x21

# LVT Timer encoding: bit 17 = periodic mode, bits 0-7 = vector.
const APIC_LVT_TIMER_PERIODIC = 0x00020000
const APIC_DIVIDE_BY_16 = 0x03

# Global tick counter — bumped on every IRQ0 (timer) by timer_isr.
# Main loop reads it to print heartbeat lines without trusting wall time.
var g_tick_count = 0

# PMM bump-allocator cursor. Initialized by pmm_init() to the base of
# the .bss pool provided by boot_trampoline_x86.s. Each page alloc
# bumps it by 4096. Never reclaims — a real kernel layers a buddy /
# freelist allocator on top of a bump PMM for startup memory, then
# switches to the richer allocator once enough state is set up.
#
# The `var X = LITERAL` literal-store-after-lazy-init clobber that
# previously forced this into C-side static storage (D.11 Phase 8c.1,
# 2026-05-25) is closed by the compiler-side fix in PASS 1.5 of
# `self-hosted/backend/mir_lower.qz`: literal stores now emit BEFORE
# complex initializers in `__qz_module_init`, so any lazy-init a
# complex initializer performs on this sentinel survives. Backed by
# spec/qspec/module_init_literal_zero_clobber_spec.qz and dual-curl
# regression in `quake baremetal:qemu_http`.
var g_pmm_next = 0

# --- Context-switched scheduler state ---------------------------
# Real tasks: each has its own 4 KiB stack from the PMM and a saved
# RSP slot in a 3-slot table at `g_task_slot_addr`:
#   slot 0: scheduler's saved RSP (main loop)
#   slot 1: task A's saved RSP
#   slot 2: task B's saved RSP
# `switch_to` (defined in boot_trampoline_x86.s) pushes the six
# callee-saved regs, swaps RSP, pops the target's regs, and `ret`s —
# landing on the target task's next instruction (or on its entry
# function the first time we switch into it, courtesy of the fake
# frame set up by `task_init_stack`).
var g_task_slot_addr = 0    # base of the 3-slot RSP table
var g_task_a_done = 0       # 1 when task A has returned to scheduler
var g_task_b_done = 0       # 1 when task B has returned to scheduler

# Initialize COM1 for 8N1 @ 115200 baud (QEMU's virtual UART is forgiving
# but real hardware requires this). DLAB (LCR bit 7) gates access to
# the divisor latch registers.
#
# Transmit-only — we don't enable the RX IRQ because retiring the PIC
# (in favor of the LAPIC) leaves us without a routable delivery path
# for IRQ4. An I/O APIC would handle that; until we add one, RX stays
# polled / disabled.
def uart_init(): Void
  port_out8(UART_IER, 0x00)        # disable all UART interrupts
  port_out8(UART_LCR, 0x80)        # DLAB = 1 (access divisor)
  port_out8(UART_DATA, 0x01)       # divisor low  = 1
  port_out8(UART_IER, 0x00)        # divisor high = 0 (IER doubles as DLM when DLAB)
  port_out8(UART_LCR, 0x03)        # DLAB = 0, 8N1 (8 data, no parity, 1 stop)
  port_out8(UART_FCR, 0xC7)        # enable FIFO, clear, 14-byte threshold
  port_out8(UART_MCR, 0x0B)        # DTR/RTS set, OUT2 set (irrelevant now)
end

# Write a single byte to COM1 after waiting for the TX buffer to drain.
def uart_putc(c: Int): Void
  while (port_in8(UART_LSR) & LSR_THRE) == 0
  end
  port_out8(UART_DATA, c)
end

# Write a null-terminated C string byte-by-byte. Used when we start
# from a raw `CPtr` / integer address (e.g. labels from asm).
def uart_puts(s: Int): Void
  var i = 0
  var byte = ptr_read_byte(s + i)
  while byte != 0
    uart_putc(byte)
    i = i + 1
    byte = ptr_read_byte(s + i)
  end
end

# Write a Quartz `String` value — length-prefixed, NOT null-terminated.
# Iterates explicitly so we print exactly .size bytes.
def uart_put_str(s: String): Void
  var n = str_byte_len(s)
  var i = 0
  while i < n
    uart_putc(str_byte_at(s, i))
    i = i + 1
  end
end

# Panic handler — every Quartz panic site lands here. Writes "PANIC\n"
# to COM1, then halts with interrupts masked. On x86 `hlt` parks the
# CPU until a maskable interrupt fires; `cli` before guards against
# that; the `jmp` loop catches NMIs.
@panic_handler
def panic_halt(msg: String): Void can Sched
  uart_putc(80)   # 'P'
  uart_putc(65)   # 'A'
  uart_putc(78)   # 'N'
  uart_putc(73)   # 'I'
  uart_putc(67)   # 'C'
  uart_putc(10)   # '\n'
  @c("cli; 1: hlt; jmp 1b")
end

# ---- IDT / exception handler scaffolding --------------------------
# boot_trampoline_x86.s reserves .bss space for the IDT and IDTR
# pseudo-descriptor and exports three shims whose ABI Quartz can't
# express directly (memory-operand form of `lidt`, and taking the
# address of a static symbol).
extern "C" def get_idt_addr(): Int
extern "C" def get_idtr_addr(): Int
extern "C" def idt_load(idtr_ptr: Int): Void
extern "C" def get_pmm_pool_start(): Int
extern "C" def get_pmm_pool_end(): Int
# SOUL.2 (2026-05-09): runtime PMM pool discovery via PVH start_info.
# get_pvh_start_info returns the EDI value the PVH loader passed at
# kernel entry (pointer to an hvm_start_info struct in low memory).
# get_detected_ram_bytes returns the total Type=1 RAM size summed
# from the memmap (set by pvh_probe_ram before pmm_init).
# pmm_set_pool_bounds is the setter pvh_probe_ram calls to install
# the runtime pool bounds — pmm_init then reads them back via the
# get_pmm_pool_start/end shims above.
extern "C" def get_pvh_start_info(): Int
extern "C" def get_pvh_start_info_alt(): Int
extern "C" def get_detected_ram_bytes(): Int
extern "C" def pmm_set_pool_bounds(start: Int, pool_end: Int, total_ram: Int): Void
# Cooperative context switch. Both args are linear addresses of i64
# RSP-save slots — `from_slot` gets the current RSP written to it
# (after pushing callee-saved regs), `to_slot` is read to get the
# RSP of the task to resume. Defined in boot_trampoline_x86.s.
# (Param name `from_slot` rather than `from` because `from` is a
# Quartz keyword — `import * from module` — and using it as an
# identifier sends the type checker into an OOM loop.)
extern "C" def switch_to(from_slot: Int, to_slot: Int): Void
# SOUL.4 v3 — RDTSC wall-clock reader. Returns a 64-bit cycle count.
# Modern x86 (`-cpu max`, Skylake+) advertises invariant TSC, so this
# is monotonic across power states; QEMU TCG honors invtsc with -cpu
# max. Used by uk_time_mono_ns() and soul_demo_body's wall-clock deadline.
extern "C" def read_tsc(): Int
# Slab allocator (libc_stubs.c) — six power-of-2 size classes (16..512 B)
# layered over the bump PMM, refilling on demand by consuming one PMM
# page per class on first use. malloc/free/realloc dispatch on size +
# slab page magic; multi-page allocations (> 512 B) keep the original
# bump path. See tools/baremetal/libc_stubs.c for the C implementation.
# Smoke result: count of passing checks out of 15 (6 per-class round
# trips + 3 LIFO ordering checks + 6 class-boundary picks).
extern "C" def slab_smoke(): Int
# Field codes: 0=chunk_size, 1=allocs, 2=frees, 3=refills, 4=in_use.
# Class index 0..5 maps to chunk size 16/32/64/128/256/512.
extern "C" def slab_class_stat(class_idx: Int, field: Int): Int
extern "C" def libc_multipage_stat(field: Int): Int

# Per-request arena (D.11 Phase 8b.2.c.7). Implementations in libc_stubs.c.
# Begin opens a per-task arena that captures every subsequent multi-page
# alloc; end releases the whole captured chain back to the multi-page
# freelist in O(N). Used by `_http_supervised_per_conn_loop` to bound the
# Quartz-String leak from `_async_http_write_response_timeout` to one
# request. libc_arena_stat field codes: 0=begins, 1=ends, 2=released
# chunks, 3=active flag on the calling task. See [[feedback-multipage-bump-no-reclaim]].
extern "C" def qz_arena_begin(): Void
extern "C" def qz_arena_end(): Void
extern "C" def libc_arena_stat(field: Int): Int
# Allocator-side gate: until this is called, the arena code in libc_stubs.c
# skips `sched_current()` entirely (gs-base isn't valid pre-uk_sched_init,
# and reading garbage at gs:24 then dereferencing it as a task pointer
# faults #GP). Called once from `main` right after uk_sched_init returns.
extern "C" def qz_arena_runtime_ready(): Void

# Release any in-flight arena chain on `task`'s TASK_ARENA_HEAD slot back
# to the multi-page freelist and clear the slot. Called from task_free
# to avoid stranding chunks when a task dies mid-arena (e.g., uncaught
# throw past `qz_arena_end`). Safe to call on a slot that's already 0.
extern "C" def qz_arena_drain_task(task: Int): Void
extern "C" def qz_task_alloc_dirty_check(task: Int): Void
# Path C.5.2 — hand the single active-stack base to the C side once at boot
# Path C.5.5 — the active stack is per-CPU; qz_arena_begin's stack-overflow
# canary check reads the running CPU's base directly via
# %gs:PCPU_ACTIVE_STACK_BASE (kern8_gs_load_u64 on the C side), so no
# Quartz→C setter is needed. (Slot 16 now holds the parked SAVED-stack
# buffer, 0 while RUNNING.)
# Path C.5.2 — copy-in/out of the active stack. `memcpy` is a linked global
# in libc_stubs.c; schedule-in copies a parked task's frames back to the
# active stack and schedule-out copies the live frames into its saved buffer.
extern "C" def memcpy(dst: Int, src: Int, n: Int): Int

# Breakpoint (vector 3) ISR. `int $3` triggers this. LLVM x86_intrcc
# emits the interrupt prologue/epilogue and `iret` — so we just do
# the useful work and fall off the end. #BP is a trap: saved RIP
# points past the `int3`, so iret cleanly resumes the caller.
extern "x86-interrupt" def breakpoint_isr(frame: Int): Void
  uart_putc(84)   # 'T'
  uart_putc(82)   # 'R'
  uart_putc(65)   # 'A'
  uart_putc(80)   # 'P'
  uart_putc(10)   # '\n'
end

# Divide error (vector 0) ISR. Triggered when `div` / `idiv`
# divides by zero or the quotient overflows. #DE is a *fault*, not
# a trap — saved RIP points AT the divide, not past it — so iret
# would restart the faulting instruction and loop forever. Halt
# here instead of attempting to resume.
extern "x86-interrupt" def divide_error_isr(frame: Int): Void
  uart_putc(68)   # 'D'
  uart_putc(73)   # 'I'
  uart_putc(86)   # 'V'
  uart_putc(48)   # '0'
  uart_putc(10)   # '\n'
  @c("cli; 1: hlt; jmp 1b")
end

# Timer (LAPIC timer → vector 0x20) ISR. Fires periodically at the
# rate apic_init() programs. Bumps the global tick counter and
# acknowledges the LAPIC by writing 0 to the EOI register — unlike
# the retired PIC path, any nonzero value is ignored.
extern "x86-interrupt" def timer_isr(frame: Int): Void
  g_tick_count = g_tick_count + 1
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_EOI, 0)
end

# K8.7 — wake IPI handler. Fires when another CPU broadcasts a wake-up
# (ready_push 0 → 1 transition). Body is intentionally empty: the only
# thing that needs to happen is unblock the `hlt` instruction this CPU
# was sleeping on, so when iret returns we land back in `ap_main`'s
# sched_pump loop (or BSP's serve loop) and naturally drain the ready
# queue. Just ack the LAPIC and return.
extern "x86-interrupt" def wake_ipi_isr(frame: Int): Void
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_EOI, 0)
end

# Read CR2 — the CPU stashes the faulting linear address here when a
# page fault (#PF) is delivered. No dedicated intrinsic yet; inline
# asm is the escape hatch.
def read_cr2(): Int = @c("mov %cr2, $0")

# Hex-print an i64 to COM1 as "0x..." (no leading zeros stripped).
# Used by the page fault reporter where decimal isn't useful.
def uart_put_hex(n: Int): Void
  uart_putc(48)   # '0'
  uart_putc(120)  # 'x'
  var shift = 60
  while shift >= 0
    var nibble = (n >> shift) & 0xF
    if nibble < 10
      uart_putc(48 + nibble)       # '0'..'9'
    else
      uart_putc(87 + nibble)       # 'a'..'f' (87 = 'a' - 10)
    end
    shift = shift - 4
  end
end

# Page fault (CPU exception #14) ISR. CPU pushes an error code (unlike
# #BP / #DE), so the handler takes two params — `frame` is the normal
# interrupt frame pointer, `err` is the fault-classification bitmask
# (bit 0 = P, bit 1 = W, bit 2 = U/S, bit 3 = RSVD, bit 4 = I/D).
# CR2 holds the faulting linear address.
#
# A real kernel would look up the VMA, decide to page in / COW / kill,
# and resume. For now we just print a diagnostic and halt — so any
# accidental bad access during later paging work surfaces loudly with
# the offending address in plain text, not a silent triple-fault.

extern "x86-interrupt" def page_fault_isr(frame: Int, err: Int): Void
  var cr2 = read_cr2()
  uart_put_str("PF at ")
  uart_put_hex(cr2)
  uart_put_str(" err=")
  uart_put_hex(err)
  uart_putc(10)   # '\n'

  # Dump the interrupt frame (RIP, CS, RFLAGS, RSP, SS) so `addr2line`
  # against the ELF can point at the exact faulting instruction next
  # time we hit a PF in production. For x86-interrupt calling
  # convention with error code, the CPU layout on entry (after the
  # kernel has popped the error into %err param) is:
  #   frame+0   RIP
  #   frame+8   CS
  #   frame+16  RFLAGS
  #   frame+24  RSP
  #   frame+32  SS
  # Quartz's x86-interrupt ABI passes `frame` as a pointer to that
  # 5-qword region. Dump all of them.
  uart_put_str("  RIP=")
  uart_put_hex(volatile_load<U64>(frame + 0))
  uart_put_str(" CS=")
  uart_put_hex(volatile_load<U64>(frame + 8))
  uart_putc(10)
  uart_put_str("  RFL=")
  uart_put_hex(volatile_load<U64>(frame + 16))
  uart_put_str(" RSP=")
  uart_put_hex(volatile_load<U64>(frame + 24))
  uart_put_str(" SS=")
  uart_put_hex(volatile_load<U64>(frame + 32))
  uart_putc(10)

  @c("cli; 1: hlt; jmp 1b")
end

# Shared skeleton for error-code exceptions that aren't PF (#GP, #DF,
# #SS, #NP). Printing the tag + RIP/CS/RFL/RSP lets us addr2line the
# faulting instruction post-mortem when the kernel triple-faults
# under production load instead of going silent at QEMU exit 0.
extern "x86-interrupt" def general_protection_isr(frame: Int, err: Int): Void
  uart_put_str("#GP err=")
  uart_put_hex(err)
  uart_putc(10)
  uart_put_str("  RIP=")
  uart_put_hex(volatile_load<U64>(frame + 0))
  uart_put_str(" CS=")
  uart_put_hex(volatile_load<U64>(frame + 8))
  uart_putc(10)
  uart_put_str("  RFL=")
  uart_put_hex(volatile_load<U64>(frame + 16))
  uart_put_str(" RSP=")
  uart_put_hex(volatile_load<U64>(frame + 24))
  uart_putc(10)
  @c("cli; 1: hlt; jmp 1b")
end

extern "x86-interrupt" def double_fault_isr(frame: Int, err: Int): Void
  uart_put_str("#DF err=")
  uart_put_hex(err)
  uart_putc(10)
  uart_put_str("  RIP=")
  uart_put_hex(volatile_load<U64>(frame + 0))
  uart_put_str(" RSP=")
  uart_put_hex(volatile_load<U64>(frame + 24))
  uart_putc(10)
  @c("cli; 1: hlt; jmp 1b")
end

extern "x86-interrupt" def invalid_opcode_isr(frame: Int): Void
  uart_put_str("#UD\n")
  uart_put_str("  RIP=")
  uart_put_hex(volatile_load<U64>(frame + 0))
  uart_put_str(" RSP=")
  uart_put_hex(volatile_load<U64>(frame + 24))
  uart_putc(10)
  @c("cli; 1: hlt; jmp 1b")
end

extern "x86-interrupt" def stack_fault_isr(frame: Int, err: Int): Void
  uart_put_str("#SS err=")
  uart_put_hex(err)
  uart_putc(10)
  uart_put_str("  RIP=")
  uart_put_hex(volatile_load<U64>(frame + 0))
  uart_put_str(" RSP=")
  uart_put_hex(volatile_load<U64>(frame + 24))
  uart_putc(10)
  @c("cli; 1: hlt; jmp 1b")
end

# Fill one 16-byte IDT entry (x86_64 gate descriptor layout):
#   0..1  offset_0_15
#   2..3  segment selector (0x08 = our 64-bit code segment)
#   4     IST index (0 = use current stack)
#   5     type/attrs (0x8E = P=1 DPL=00 Type=Interrupt Gate, 64-bit)
#   6..7  offset_16_31
#   8..11 offset_32_63
#   12..15 zero
def idt_set_entry(idt_base: Int, vector: Int, handler: Int): Void
  var entry = idt_base + (vector * 16)
  ptr_write_byte(entry + 0,  handler & 0xFF)
  ptr_write_byte(entry + 1,  (handler >> 8) & 0xFF)
  ptr_write_byte(entry + 2,  0x08)           # selector low
  ptr_write_byte(entry + 3,  0x00)           # selector high
  ptr_write_byte(entry + 4,  0x00)           # IST = 0
  ptr_write_byte(entry + 5,  0x8E)           # present + interrupt gate
  ptr_write_byte(entry + 6,  (handler >> 16) & 0xFF)
  ptr_write_byte(entry + 7,  (handler >> 24) & 0xFF)
  ptr_write_byte(entry + 8,  (handler >> 32) & 0xFF)
  ptr_write_byte(entry + 9,  (handler >> 40) & 0xFF)
  ptr_write_byte(entry + 10, (handler >> 48) & 0xFF)
  ptr_write_byte(entry + 11, (handler >> 56) & 0xFF)
  ptr_write_byte(entry + 12, 0x00)
  ptr_write_byte(entry + 13, 0x00)
  ptr_write_byte(entry + 14, 0x00)
  ptr_write_byte(entry + 15, 0x00)
end

# Zero the entire 4096-byte IDT region.
def idt_zero(idt_base: Int): Void
  var i = 0
  while i < 4096
    ptr_write_byte(idt_base + i, 0)
    i = i + 1
  end
end

# Populate the IDT pseudo-descriptor (limit = 16*256-1 = 0x0FFF) and
# call `lidt`. After this, CPU exceptions + software interrupts
# dispatch through our table.
def idt_install(): Void
  var idt_base = get_idt_addr()
  idt_zero(idt_base)
  idt_set_entry(idt_base, 0, divide_error_isr)
  idt_set_entry(idt_base, 3, breakpoint_isr)
  # Vector 6 = #UD invalid opcode — fires on any unmapped instruction
  # the CPU tries to decode; useful catch-all for corrupt code.
  idt_set_entry(idt_base, 6, invalid_opcode_isr)
  # Vector 8 = #DF double fault — CPU's last line of defence before
  # a triple fault resets the machine. Registering any handler here
  # converts an otherwise-silent QEMU exit-0 into a diagnostic dump.
  idt_set_entry(idt_base, 8, double_fault_isr)
  # Vector 12 = #SS stack fault — misaligned RSP, too-short stack.
  idt_set_entry(idt_base, 12, stack_fault_isr)
  # Vector 13 = #GP general protection — bad segment / selector, or
  # most importantly here, writes that violate paging permissions.
  idt_set_entry(idt_base, 13, general_protection_isr)
  # Vector 14 = #PF page fault. Pushed with an error code, hence the
  # 2-arg ISR signature — x86_intrcc handles this automatically.
  idt_set_entry(idt_base, 14, page_fault_isr)
  # Vector 0x20 — reused from the old PIT/PIC path for the LAPIC timer.
  idt_set_entry(idt_base, APIC_TIMER_VECTOR, timer_isr)
  # Vector 0x21 — K8.7 cross-CPU wake-up IPI. No-op ISR; the wake
  # itself happens via `iret` returning the CPU to userspace (where
  # the sched_pump loop runs).
  idt_set_entry(idt_base, APIC_WAKE_IPI_VECTOR, wake_ipi_isr)

  var idtr = get_idtr_addr()
  # 2-byte limit, little-endian
  ptr_write_byte(idtr + 0, 0xFF)
  ptr_write_byte(idtr + 1, 0x0F)
  # 8-byte base (IDT linear address), little-endian
  ptr_write_byte(idtr + 2, idt_base & 0xFF)
  ptr_write_byte(idtr + 3, (idt_base >> 8) & 0xFF)
  ptr_write_byte(idtr + 4, (idt_base >> 16) & 0xFF)
  ptr_write_byte(idtr + 5, (idt_base >> 24) & 0xFF)
  ptr_write_byte(idtr + 6, (idt_base >> 32) & 0xFF)
  ptr_write_byte(idtr + 7, (idt_base >> 40) & 0xFF)
  ptr_write_byte(idtr + 8, (idt_base >> 48) & 0xFF)
  ptr_write_byte(idtr + 9, (idt_base >> 56) & 0xFF)

  idt_load(idtr)
end

# Mask every line on both 8259A PICs so they stop delivering interrupts
# after we enable the LAPIC. The legacy PIC hardware doesn't vanish
# when the APIC comes up — it keeps signalling its old vectors unless
# we tell it to shut up. We also can't easily route its lines through
# the LAPIC without an I/O APIC (a later piece), so the cleanest story
# right now is: PIC silent, LAPIC owns the timer, no external IRQs
# until the I/O APIC lands.
def pic_disable(): Void
  port_out8(PIC_MASTER_DATA, 0xFF)    # mask all master IRQs
  port_out8(PIC_SLAVE_DATA,  0xFF)    # mask all slave IRQs
end

# Enable the LAPIC + configure its built-in periodic timer.
#
# Sequence:
#   1. Read the APIC-base MSR, OR in the global-enable bit (MSR 0x1B,
#      bit 11), write back. The APIC is now "globally" enabled — its
#      MMIO window responds and delivery from the local APIC is live.
#   2. Write the Spurious-Interrupt-Vector register: 0x100 (software
#      enable, bit 8) | 0xFF (spurious vector). 0xFF is the standard
#      "nothing useful happened" vector; nothing in our IDT handles
#      it, but it must be set for the APIC to route real interrupts.
#   3. Write the LVT Timer register: bit 17 = periodic mode, bits 0-7
#      = vector 0x20 (our timer ISR).
#   4. Write the Divide Configuration register: 0x3 = divide bus
#      clock by 16. Ensures the initial count expresses a reasonable
#      duration rather than a near-instant tick.
#   5. Write the Initial-Count register: starts the countdown.
#      10_000_000 at TCG's ~1 GHz simulated bus gives ticks roughly
#      100 ms apart — fast enough to prove the timer fires during
#      the scheduler demo, slow enough to not swamp the UART.
def apic_init(): Void
  # 1. Global enable via MSR.
  var base = rdmsr(MSR_IA32_APIC_BASE)
  wrmsr(MSR_IA32_APIC_BASE, base | APIC_GLOBAL_ENABLE)

  # 2. Software-enable spurious vector (bit 8 | 0xFF).
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_SPURIOUS, 0x1FF)

  # 3. Periodic LVT timer, vector 0x20.
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_LVT_TIMER, APIC_LVT_TIMER_PERIODIC | APIC_TIMER_VECTOR)

  # 4. Divide by 16.
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_DIVIDE, APIC_DIVIDE_BY_16)

  # 5. Initial count — starts the timer. ~10M bus-clock ticks between
  # fires.
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_INITIAL, 10000000)
end

# --- KERN.8 K8.1: ACPI MADT parsing for SMP CPU enumeration --------
#
# Walks ACPI tables on boot to count logical CPUs and capture each
# one's LAPIC ID. The CPU count + LAPIC ID array drives every later
# K8.x phase (per-CPU page allocation, AP trampoline targets, IPI
# destinations). This phase only enumerates and prints — actual AP
# bringup waits for K8.3.
#
# Discovery path (per ACPI 6.5 §5):
#
#   PVH start_info (offset +32) → RSDP → XSDT (revision >= 2) or
#   RSDT (legacy ACPI 1.0) → array of table pointers → find table
#   with signature "APIC" → walk MADT entries → collect LAPIC entries.
#
# QEMU microvm requirement: ACPI is opt-in on this machine type. Boot
# with `-machine microvm,acpi=on` so the PVH start_info has a non-
# zero rsdp_paddr; without it `acpi_init` falls back to a single-CPU
# assumption. The systemd unit on the VPS will need the same flag
# before K8.MVP smoke runs against production.
#
# Reference: docs/design/KERN_8_SMP.md (decision D1: ACPI MADT, not
# legacy MP tables). OSDev wiki "RSDP", "RSDT", "MADT" pages are the
# canonical structural reference; ACPI specification §5.2.5
# (RSDP/XSDT) + §5.2.12 (MADT) is authoritative.

# RSDP signature "RSD PTR " split across two U32 reads (LE order).
const ACPI_RSDP_SIG_LO = 0x20445352   # "RSD " = 0x52 0x53 0x44 0x20 LE
const ACPI_RSDP_SIG_HI = 0x20525450   # "PTR " = 0x50 0x54 0x52 0x20 LE

# Table signatures (4-byte ASCII, LE U32).
const ACPI_SIG_RSDT = 0x54445352   # "RSDT"
const ACPI_SIG_XSDT = 0x54445358   # "XSDT"
const ACPI_SIG_MADT = 0x43495041   # "APIC"

# Standard ACPI table header is 36 bytes; MADT extends it by 8 (local
# APIC address U32 + flags U32) before the entry array starts.
const ACPI_HDR_BYTES   = 36
const MADT_HDR_BYTES   = 44

# MADT entry types we care about. Other types (NMI source, LAPIC
# override, etc.) are skipped — their `length` field still drives
# the iterator forward.
const MADT_ENTRY_LAPIC  = 0
const MADT_ENTRY_IOAPIC = 1

# Processor LAPIC entry flags (offset +4, U32).
const MADT_LAPIC_FLAG_ENABLED        = 1   # CPU is usable now
const MADT_LAPIC_FLAG_ONLINE_CAPABLE = 2   # CPU is hot-pluggable but not yet online

# Per-CPU table sizing. 16 covers any realistic Quartz unikernel
# topology for the foreseeable future; bumping later is a one-line
# const change.
const KERN8_MAX_CPUS = 16

# CPU table slot layout (8 bytes per entry — U64-stride for cache
# alignment + room to grow). Reserved bytes 3..7 stay zero today;
# K8.2 may use one for "this slot's per-CPU page paddr" once the
# per-CPU framework lands.
const CPU_TBL_FLAGS    = 0   # U8: bit 0 enabled, bit 1 online_capable
const CPU_TBL_ACPI_ID  = 1   # U8: ACPI processor ID
const CPU_TBL_APIC_ID  = 2   # U8: hardware LAPIC ID (IPI destination)
const CPU_TBL_STRIDE   = 8

var g_cpu_count = 0
# Path C.5.5 — gate: APs spin-wait (hlt) in ap_main until BSP flips this to 1,
# which main does AFTER the cooperative boot demos (sched/chan/mutex) complete.
# Those demos assume single-CPU cooperative semantics and run on BSP; bringing
# APs online before them would distribute demo tasks across CPUs mid-boot. Once
# set, each AP marks itself online (PCPU_SCHED_ONLINE) and pumps its ready ring.
var g_ap_sched_enabled = 0
var g_cpu_table = 0   # base of KERN8_MAX_CPUS × CPU_TBL_STRIDE bytes (1 PMM page)

def cpu_tbl_addr(idx: Int): Int = g_cpu_table + (idx * CPU_TBL_STRIDE)
def cpu_apic_id(idx: Int): Int = volatile_load<U8>(cpu_tbl_addr(idx) + CPU_TBL_APIC_ID)
def cpu_acpi_id(idx: Int): Int = volatile_load<U8>(cpu_tbl_addr(idx) + CPU_TBL_ACPI_ID)
def cpu_flags(idx: Int): Int = volatile_load<U8>(cpu_tbl_addr(idx) + CPU_TBL_FLAGS)
def cpu_enabled(idx: Int): Int
  if (cpu_flags(idx) & MADT_LAPIC_FLAG_ENABLED) != 0
    return 1
  end
  return 0
end

# Validate RSDP signature ("RSD PTR ") via two U32 reads. Returns 1
# on match, 0 otherwise.
def acpi_rsdp_sig_valid(rsdp: Int): Int
  if volatile_load<U32>(rsdp) != ACPI_RSDP_SIG_LO
    return 0
  end
  if volatile_load<U32>(rsdp + 4) != ACPI_RSDP_SIG_HI
    return 0
  end
  return 1
end

# Linear 16-byte-aligned scan for the RSDP signature. Used as
# fallback when PVH start_info doesn't carry rsdp_paddr (QEMU
# microvm with acpi=on places ACPI tables in low memory but does
# not populate start_info.rsdp). Scans:
#   1. EBDA (Extended BIOS Data Area) — first 1 KiB pointed to by
#      the U16 at physical 0x40E (real-mode segment, shifted left 4).
#   2. The legacy BIOS area 0xE0000..0xFFFFF.
# Both ranges are inside our identity map. Returns 0 if no signature
# is found in either range.
def acpi_rsdp_scan(): Int
  var ebda_seg = volatile_load<U16>(0x40E)
  if ebda_seg != 0
    var ebda_base = ebda_seg << 4
    var p = ebda_base
    var stop = ebda_base + 1024
    while p < stop
      if acpi_rsdp_sig_valid(p) == 1
        return p
      end
      p = p + 16
    end
  end
  var p = 0xE0000
  var stop = 0x100000
  while p < stop
    if acpi_rsdp_sig_valid(p) == 1
      return p
    end
    p = p + 16
  end
  return 0
end

# Find the MADT pointer by walking RSDT/XSDT entries. Returns 0 if
# no table with signature "APIC" is present. `is_xsdt` selects entry
# pointer width (8 bytes for XSDT, 4 for RSDT).
def acpi_find_madt(sdt: Int, is_xsdt: Int): Int
  var sdt_len = volatile_load<U32>(sdt + 4)
  if sdt_len < ACPI_HDR_BYTES
    return 0
  end
  var entries_base = sdt + ACPI_HDR_BYTES
  var entries_bytes = sdt_len - ACPI_HDR_BYTES
  var ptr_size = 4
  if is_xsdt != 0
    ptr_size = 8
  end
  var n = entries_bytes / ptr_size
  var i = 0
  while i < n
    var ptr = 0
    if is_xsdt != 0
      ptr = volatile_load<U64>(entries_base + (i * 8))
    else
      ptr = volatile_load<U32>(entries_base + (i * 4))
    end
    if ptr != 0
      if volatile_load<U32>(ptr) == ACPI_SIG_MADT
        return ptr
      end
    end
    i = i + 1
  end
  return 0
end

# Walk MADT entries (variable-length, type-tagged). For each Type-0
# Processor Local APIC entry, append a slot to g_cpu_table. Entries
# of other types advance the iterator by their `length` field and
# are otherwise ignored at K8.1 (IOAPIC + interrupt overrides matter
# at K8.7 when we wire IPI delivery).
def acpi_walk_madt(madt: Int): Void
  var madt_len = volatile_load<U32>(madt + 4)
  if madt_len < MADT_HDR_BYTES
    return
  end
  var entry_ptr = madt + MADT_HDR_BYTES
  var madt_end = madt + madt_len
  while entry_ptr < madt_end
    var etype = volatile_load<U8>(entry_ptr)
    var elen  = volatile_load<U8>(entry_ptr + 1)
    if elen == 0
      # Malformed entry — abort to avoid infinite loop.
      return
    end
    if etype == MADT_ENTRY_LAPIC
      var acpi_id = volatile_load<U8>(entry_ptr + 2)
      var apic_id = volatile_load<U8>(entry_ptr + 3)
      var flags   = volatile_load<U32>(entry_ptr + 4)
      if g_cpu_count < KERN8_MAX_CPUS
        var slot = cpu_tbl_addr(g_cpu_count)
        volatile_store<U8>(slot + CPU_TBL_FLAGS, flags & 3)
        volatile_store<U8>(slot + CPU_TBL_ACPI_ID, acpi_id)
        volatile_store<U8>(slot + CPU_TBL_APIC_ID, apic_id)
        g_cpu_count = g_cpu_count + 1
      end
    end
    entry_ptr = entry_ptr + elen
  end
end

# Top-level ACPI bringup. Allocates the CPU table page, dereferences
# PVH start_info → RSDP → XSDT-or-RSDT → MADT, fills g_cpu_table,
# logs a summary to serial. Idempotent in the "single-CPU fallback"
# sense — if any structural step fails (no PVH info, no RSDP, no
# MADT, malformed signature) the kernel boots in single-CPU mode
# and a follow-up K8.x phase will not bring any APs online.
#
# Must be called AFTER pmm_init (we PMM-alloc the table page) and
# AFTER uart_init (we log progress). Today's call site in main() is
# right after apic_init.
def acpi_init(): Void
  g_cpu_table = pmm_alloc_page()
  pmm_zero_page(g_cpu_table)

  # Prefer PVH start_info's rsdp_paddr (offset +32). If it's zero
  # (QEMU microvm w/ acpi=on populates the RSDP in low memory but
  # doesn't set start_info.rsdp), fall back to the BIOS-area scan.
  var rsdp = 0
  var info = pvh_find_start_info()
  if info != 0
    rsdp = volatile_load<U64>(info + 32)
  end
  if rsdp == 0
    rsdp = acpi_rsdp_scan()
  end

  if rsdp == 0
    uart_put_str("[acpi] no RSDP — single-CPU fallback (try -machine microvm,acpi=on)\n")
    return
  end

  if acpi_rsdp_sig_valid(rsdp) == 0
    uart_put_str("[acpi] RSDP signature mismatch at ")
    uart_put_hex(rsdp)
    uart_putc(10)
    return
  end

  uart_put_str("[acpi] RSDP at ")
  uart_put_hex(rsdp)
  uart_putc(10)

  var revision = volatile_load<U8>(rsdp + 15)
  var sdt = 0
  var is_xsdt = 0
  if revision >= 2
    sdt = volatile_load<U64>(rsdp + 24)
    if sdt != 0
      is_xsdt = 1
    end
  end
  if sdt == 0
    sdt = volatile_load<U32>(rsdp + 16)   # ACPI 1.0 RSDT fallback
  end
  if sdt == 0
    uart_put_str("[acpi] no RSDT/XSDT pointer\n")
    return
  end

  var madt = acpi_find_madt(sdt, is_xsdt)
  if madt == 0
    uart_put_str("[acpi] no MADT in RSDT/XSDT — single-CPU fallback\n")
    return
  end

  acpi_walk_madt(madt)

  uart_put_str("[acpi] CPUs detected: ")
  uart_put_uint(g_cpu_count)
  uart_putc(10)
  var ci = 0
  while ci < g_cpu_count
    uart_put_str("  cpu[")
    uart_put_uint(ci)
    uart_put_str("] acpi_id=")
    uart_put_uint(cpu_acpi_id(ci))
    uart_put_str(" apic_id=")
    uart_put_uint(cpu_apic_id(ci))
    uart_put_str(" enabled=")
    uart_put_uint(cpu_enabled(ci))
    uart_putc(10)
    ci = ci + 1
  end
end

# --- KERN.8 K8.2: per-CPU state framework (GS-base) ----------------
#
# Each detected CPU gets one PMM page of per-CPU state, layout below.
# BSP loads its page address into IA32_GS_BASE in `kern8_pcpu_init`;
# APs do the equivalent in their bringup trampoline (K8.3). After
# init, any code can read CPU-local fields via `cpu_local_load(off)`
# (which dispatches through `kern8_gs_load_u64` → `mov %gs:off, %rax`).
#
# K8.2 ships only the framework — populating headers, writing GS-base
# on BSP, exposing accessors. The fields themselves get used as
# subsequent phases land:
#   - PCPU_CPU_ID + PCPU_LAPIC_ID — used for "running on CPU N"
#     telemetry (K8.8) and IPI destination resolution (K8.7).
#   - PCPU_KERNEL_STACK_TOP — RSP for interrupt entry (post-MVP).
#   - PCPU_CURRENT_TASK — replaces the global g_sched_current
#     when scheduler goes per-CPU (K8.6).
#   - PCPU_SCHED_MAIN_RSP — replaces g_sched_main_rsp_slot when
#     scheduler goes per-CPU (K8.6).
#   - PCPU_HEARTBEAT — per-CPU "scheduler alive" signal (K8.8).
#
# Layout matches the table in `docs/design/KERN_8_SMP.md` D4. Field
# offsets locked here; subsequent phases consume them.

const PCPU_CPU_ID            = 0    # U64
const PCPU_LAPIC_ID          = 8    # U64
const PCPU_KERNEL_STACK_TOP  = 16   # U64
const PCPU_CURRENT_TASK      = 24   # U64
const PCPU_SCHED_MAIN_RSP    = 32   # U64
const PCPU_HEARTBEAT         = 40   # U64
const PCPU_IDLE_TICKS        = 48   # U64
const PCPU_IPI_PENDING       = 56   # U64
# K8.6 — per-CPU ready ring. Each CPU owns one ring of NUM_TASKS slots;
# stealers contend through PCPU_READY_SPINLOCK. Owner reads/writes its
# own ring under the same lock — owner usually wins uncontested. The
# 64..127 region was reserved at K8.2 for exactly this growth.
const PCPU_READY_RING_BASE   = 64   # U64 — base of NUM_TASKS × 8 bytes
const PCPU_READY_HEAD        = 72   # U64 — dequeue index (mod NUM_TASKS)
const PCPU_READY_TAIL        = 80   # U64 — enqueue index (mod NUM_TASKS)
const PCPU_READY_COUNT       = 88   # U64 — ring occupancy
const PCPU_READY_SPINLOCK    = 96   # U64 — heap-allocated spinlock addr
const PCPU_PENDING_YIELDED   = 104  # U64 — task ptr just yielded/blocked/exited;
                                    #       sched_post_switch reads after switch_to.
# Path C.5.5 — base of THIS CPU's 16-KiB active stack. The RUNNING task's
# frames live here (canary at base+0). Per-CPU so SMP can schedule in
# parallel: each CPU restores its tasks to ITS OWN fixed VA, keeping the
# copy-stack same-address-restore invariant per-CPU (tasks pin to a home
# CPU at first run and never migrate — C.5.5.2). Mirrored C-side as
# `#define PCPU_ACTIVE_STACK_BASE 112` for the qz_arena_begin canary read.
const PCPU_ACTIVE_STACK_BASE = 112  # U64 — base of this CPU's active stack
# Path C.5.5 — 1 once this CPU is actively running sched_pump (BSP at boot,
# APs when C.5.5.3 un-parks them). least_loaded_cpu only distributes work to
# ONLINE CPUs, so a brought-up-but-parked AP never receives tasks it can't
# run. 0 = offline (don't route work here).
const PCPU_SCHED_ONLINE      = 120  # U64 — 1 if this CPU pumps the scheduler
                                    #       K8.6.3 onward.
# 112..127 reserved; 128..4095 still earmarked for per-CPU GDT/TSS
# when ring-3 entry / IST stacks become a thing (post-MVP).

# x86_64 GS-base MSRs.
const MSR_IA32_GS_BASE        = 0xC0000101
const MSR_IA32_KERNEL_GS_BASE = 0xC0000102

# Index array (one PMM page) holding the per-CPU page address per
# CPU index. Lets K8.3's AP bringup look up a target page by index
# without rewalking g_cpu_table.
var g_pcpu_pages = 0   # base of KERN8_MAX_CPUS × 8 bytes

def pcpu_page_for(idx: Int): Int = volatile_load<U64>(g_pcpu_pages + (idx * 8))

# C-side helpers (libc_stubs.c) for the segment-override load/store.
# kern8_gs_load_u64 lives in std/sync/scheduler.qz (owned with the
# K8.9 userland exposition). kern8_gs_store_u64 stays kernel-only —
# scheduler.qz is read-only externally.
extern "C" def kern8_gs_store_u64(off: Int, val: Int): Void

# Public surface: read/write CPU-local fields by offset. These are
# the THREE-line lattice through which all per-CPU access flows once
# K8.6 lifts to per-CPU run queues.
def cpu_local_load(off: Int): Int = kern8_gs_load_u64(off)
def cpu_local_store(off: Int, val: Int): Void = kern8_gs_store_u64(off, val)

# Convenience accessors. Add more as fields get used downstream.
def cpu_current_id(): Int = cpu_local_load(PCPU_CPU_ID)
def cpu_current_lapic_id(): Int = cpu_local_load(PCPU_LAPIC_ID)

# Initialize per-CPU pages for every detected CPU + load BSP's
# GS-base. Allocates 2 PMM pages per CPU (per-CPU header page +
# kernel stack page) plus 1 page for the index array. At
# g_cpu_count = 4 that's 9 pages = 36 KiB. Negligible.
#
# Must run AFTER acpi_init (we read g_cpu_count + cpu_apic_id) and
# BEFORE any code that consults %gs:offset (K8.3's AP trampoline +
# any per-CPU scheduler field). Today's call site in main() is
# right after acpi_init.
def kern8_pcpu_init(): Void
  if g_cpu_count == 0
    uart_put_str("[pcpu] no CPUs detected — skipping per-CPU init\n")
    return
  end

  # Path C.5.5 — create the SMP allocator locks before any AP can pump.
  # spinlock_new → qz_malloc may itself call pmm_alloc_page, but g_pmm_lock is
  # still 0 during these calls (set last), so they run lock-free — correct,
  # since we're single-threaded here (APs are gated until post-boot-demos).
  g_taskpool_lock = spinlock_new()
  g_ss_lock = spinlock_new()
  g_pmm_lock = spinlock_new()

  g_pcpu_pages = pmm_alloc_page()
  pmm_zero_page(g_pcpu_pages)

  # K8.6 — ring sizing is independent of CPU index, computed once.
  var ring_bytes = NUM_TASKS * 8
  var ring_pages = (ring_bytes + 4095) / 4096

  var i = 0
  while i < g_cpu_count
    var pcpu = pmm_alloc_page()
    pmm_zero_page(pcpu)
    volatile_store<U64>(pcpu + PCPU_CPU_ID, i)
    volatile_store<U64>(pcpu + PCPU_LAPIC_ID, cpu_apic_id(i))
    # Per-CPU kernel stack — one PMM page. RSP starts 8 bytes from
    # the top so the first push lands aligned. Unused at K8.2; AP
    # bringup at K8.3 picks it up via PCPU_KERNEL_STACK_TOP.
    var stack = pmm_alloc_page()
    pmm_zero_page(stack)
    volatile_store<U64>(pcpu + PCPU_KERNEL_STACK_TOP, stack + 4096 - 8)

    # K8.6 — per-CPU ready ring. Sized NUM_TASKS slots: the global cap
    # NUM_TASKS bounds total READY count, so per-CPU overflow is
    # impossible. Initialized HERE (not uk_sched_init) so that APs
    # entering ap_main → sched_pump → ready_pop_from(self) before
    # uk_sched_init runs find a valid (empty) ring rather than a
    # null spinlock pointer.
    var ring_base = pmm_alloc_page()
    var rp = 1
    while rp < ring_pages
      pmm_alloc_page()
      rp = rp + 1
    end
    var rzp = 0
    while rzp < ring_pages
      pmm_zero_page(ring_base + rzp * 4096)
      rzp = rzp + 1
    end
    volatile_store<U64>(pcpu + PCPU_READY_RING_BASE, ring_base)
    # HEAD/TAIL/COUNT/PENDING_YIELDED already 0 from pmm_zero_page above.
    volatile_store<U64>(pcpu + PCPU_READY_SPINLOCK, spinlock_new())

    # Path C.5.5 — this CPU's active stack: TASK_STACK_PAGES (16 KiB)
    # contiguous PMM pages (the bump allocator hands them back sequentially).
    # The RUNNING task's frames live here; on park they copy out to the
    # task's saved buffer, on resume back IN to active_top - len (the SAME
    # VA, since a task never migrates off its home CPU — C.5.5.2). Stamp the
    # canary at base+0 ONCE: copy-in/out only touch [active_top-len,
    # active_top), never base+0, unless a frame overflows the full 16 KiB —
    # exactly what qz_arena_begin's canary check (reading %gs:ACTIVE_STACK_BASE)
    # is meant to catch. Allocated for every detected CPU even though APs are
    # parked until C.5.5.3 — cost is g_cpu_count x 16 KiB, negligible.
    var as_base = pmm_alloc_page()
    var as_pg = 1
    while as_pg < TASK_STACK_PAGES
      pmm_alloc_page()
      as_pg = as_pg + 1
    end
    volatile_store<U64>(as_base, TASK_STACK_CANARY)
    volatile_store<U64>(pcpu + PCPU_ACTIVE_STACK_BASE, as_base)

    # Stash in index array.
    volatile_store<U64>(g_pcpu_pages + (i * 8), pcpu)
    i = i + 1
  end

  # BSP (CPU 0) loads its own per-CPU page into IA32_GS_BASE. From
  # this point on, `%gs:offset` reads land in BSP's page.
  wrmsr(MSR_IA32_GS_BASE, pcpu_page_for(0))

  # Path C.5.5 — BSP pumps the scheduler from boot (demos + serve loop), so
  # mark it online: least_loaded_cpu may distribute work here. APs are offline
  # until C.5.5.3 un-parks them (they set their own slot in ap_main). While
  # the only online CPU is BSP, all work routes to BSP — single-scheduler
  # behavior, identical to pre-C.5.5.
  volatile_store<U64>(pcpu_page_for(0) + PCPU_SCHED_ONLINE, 1)

  # Verify: round-trip cpu_id through %gs:0. If GS-base is broken
  # or the C extern is mis-compiled, this won't match.
  var verify_id = cpu_current_id()
  var verify_lapic = cpu_current_lapic_id()
  uart_put_str("[pcpu] BSP page=")
  uart_put_hex(pcpu_page_for(0))
  uart_put_str(" %gs:cpu_id=")
  uart_put_uint(verify_id)
  uart_put_str(" %gs:lapic_id=")
  uart_put_uint(verify_lapic)
  uart_putc(10)

  # Round-trip a write through cpu_local_store and read it back via
  # cpu_local_load — proves the store path lands in %gs:offset and
  # the load path sees it. Use PCPU_HEARTBEAT (currently 0) as the
  # scratch field; the heartbeat task will own it from K8.8 onward.
  cpu_local_store(PCPU_HEARTBEAT, 0xDEADBEEF)
  var verify_hb = cpu_local_load(PCPU_HEARTBEAT)
  uart_put_str("[pcpu] BSP heartbeat round-trip: ")
  uart_put_hex(verify_hb)
  uart_put_str(" (expect 0x00000000deadbeef)\n")
  # Reset to 0 so the K8.8 heartbeat task starts from a clean slate.
  cpu_local_store(PCPU_HEARTBEAT, 0)
end

# --- KERN.8 K8.3: AP bringup (INIT-SIPI-SIPI + trampoline) ---------
#
# Wakes every AP enumerated by acpi_init, transitions each from
# 16-bit real mode → 32-bit protected → 64-bit long, lands them on
# their own per-CPU stack with GS-base loaded, and parks them in a
# halt loop. Demo work still runs on BSP only — K8.3 ships the
# bringup substrate, K8.5/K8.MVP make the AP a real scheduler.
#
# Trampoline blob lives in `tools/baremetal/ap_trampoline_x86.s` and
# is memcpy'd to physical 0x8000 here at runtime. SIPI vector = 8
# (so the AP wakes at CS:IP = 0x800:0 → linear 0x8000).
#
# Reference: docs/design/KERN_8_SMP.md decision D2 + D3, OSDev wiki
# "Symmetric Multiprocessing", Intel SDM Vol. 3 §8.4 (multiprocessor
# init protocol).

const KERN8_AP_TRAMPOLINE_PHYS = 0x8000

# LAPIC ICR (Interrupt Command Register). Writing the LOW dword
# triggers the IPI; HIGH dword carries the destination LAPIC ID
# (bits 24..31) for physical-destination mode.
const APIC_REG_ICR_LOW  = 0x300
const APIC_REG_ICR_HIGH = 0x310

# ICR-low field encodings.
const APIC_ICR_DELIVERY_INIT    = 0x500    # bits 8-10 = 5 (INIT)
const APIC_ICR_DELIVERY_STARTUP = 0x600    # bits 8-10 = 6 (Startup)
const APIC_ICR_DELIVERY_FIXED   = 0x000    # bits 8-10 = 0 (Fixed)
const APIC_ICR_LEVEL_ASSERT     = 0x4000   # bit 14 (level=assert)
const APIC_ICR_PENDING          = 0x1000   # bit 12 (delivery-status)
# Destination shorthand (bits 18-19). When non-zero the ICR-high
# destination field is ignored, so a single 32-bit write triggers the
# IPI. K8.7 uses ALL_EXCLUDING_SELF for the wake broadcast — sending
# to "self" would just be a self-interrupt with no useful effect.
const APIC_ICR_DEST_ALL_EXCLUDING_SELF = 0xC0000   # bits 18-19 = 11

# Trampoline blob metadata — provided by ap_trampoline_x86.s. The
# blob has zeroed slots BSP fills in before SIPI: PML4 base, AP
# stack top, ap_main address.
extern "C" def get_ap_trampoline_blob(): Int
extern "C" def get_ap_trampoline_size(): Int
extern "C" def get_ap_pml4_slot_offset(): Int
extern "C" def get_ap_stack_slot_offset(): Int
extern "C" def get_ap_main_slot_offset(): Int

# Read CR3 (BSP's PML4 base) — APs share BSP's identity map.
extern "C" def read_cr3(): Int

# Address-of `ap_main` resolved within Quartz's own translation unit
# via inline asm. Avoids name-mangling assumptions across .o boundaries.
def ap_main_addr(): Int = @c("leaq ap_main(%rip), $0")

# Force `ap_main` into the emitted LL. Inline-asm references in
# `ap_main_addr` are opaque to Quartz's codegen; without an explicit
# Quartz-level call edge the compiler DCEs the function before LLC
# sees it, and the link fails with "undefined symbol: ap_main".
# The guard global is never set, so the call is never executed —
# the only effect is to keep ap_main reachable in the call graph.
var g_ap_main_keepalive = 0
def ap_main_keepalive_guard(): Void
  if g_ap_main_keepalive == 1
    ap_main(0)
  end
end

# AP-alive counter. AP increments before halting; BSP polls.
# K8.3 serializes bringup (one AP at a time), so plain non-atomic
# RMW is race-free — exactly one writer at a time. K8.4 swaps to
# atomic_inc once `lock cmpxchg` intrinsics land.
var g_ap_alive_count = 0

# Function-call-boundary read forces the compiler to reload the
# global, so the BSP poll loop sees the AP's update without volatile.
def read_ap_alive(): Int = g_ap_alive_count

# TSC-based busy-wait. Coarse — TSC frequency is hardware-dependent,
# but the Intel SDM specifies INIT-SIPI delays as MINIMUMs, so
# overestimating the wait is always safe.
def busy_wait_tsc(cycles: Int): Void
  var start = read_tsc()
  while (read_tsc() - start) < cycles
    # spin
  end
end

# Approximate ms / µs at 1 GHz nominal TSC. Intel calls for ≥10ms
# between INIT and first SIPI, ≥200µs between SIPIs.
def busy_wait_ms(ms: Int): Void = busy_wait_tsc(ms * 1000000)
def busy_wait_us(us: Int): Void = busy_wait_tsc(us * 1000)

# Poll ICR-low until delivery-status (bit 12) clears. Returns once
# the previous IPI has been accepted by the system bus.
def apic_icr_wait_idle(): Void
  var tries = 0
  while tries < 1000000
    var icr = volatile_load<U32>(APIC_MMIO_BASE + APIC_REG_ICR_LOW)
    if (icr & APIC_ICR_PENDING) == 0
      return
    end
    tries = tries + 1
  end
  uart_put_str("[apic] WARN: ICR delivery-status stuck after 1M polls\n")
end

# Send INIT IPI to `target_apic_id`. Edge-triggered, level-asserted —
# the deassert form (level=0) is only needed on legacy hardware that
# also requires the older 82489DX assert/deassert dance. Modern
# hardware accepts the single-shot assert form.
def apic_send_init(target_apic_id: Int): Void
  apic_icr_wait_idle()
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_ICR_HIGH, target_apic_id << 24)
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_ICR_LOW,
    APIC_ICR_DELIVERY_INIT | APIC_ICR_LEVEL_ASSERT)
  apic_icr_wait_idle()
end

# Send STARTUP IPI to `target_apic_id` with `vector` in the low byte.
# Vector V means CS:IP = V*0x100 : 0 (linear V*0x1000) — for our
# trampoline at phys 0x8000, vector = 8.
def apic_send_startup(target_apic_id: Int, vector: Int): Void
  apic_icr_wait_idle()
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_ICR_HIGH, target_apic_id << 24)
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_ICR_LOW,
    APIC_ICR_DELIVERY_STARTUP | (vector & 0xFF))
  apic_icr_wait_idle()
end

# K8.7 — broadcast a fixed-delivery IPI on `vector` to every CPU
# except the sender. `ready_push` calls this after a 0 → 1 transition
# of the global queue so any CPU sleeping in `hlt` wakes and drains.
# Dest-shorthand=11 makes ICR-high irrelevant; just one ICR-low write
# triggers the IPI (cheaper than apic_send_init/startup, no high write).
# Pre-wait avoids a lost IPI when callers issue back-to-back pushes
# faster than the LAPIC accepts; post-wait is unnecessary because the
# accept latency is in nanoseconds and the next caller will pre-wait.
def apic_broadcast_ipi(vector: Int): Void
  apic_icr_wait_idle()
  volatile_store<U32>(APIC_MMIO_BASE + APIC_REG_ICR_LOW,
    APIC_ICR_DEST_ALL_EXCLUDING_SELF | APIC_ICR_DELIVERY_FIXED |
    APIC_ICR_LEVEL_ASSERT | (vector & 0xFF))
end

# AP entry point. Called from the trampoline once the AP has reached
# 64-bit long mode. Receives its LAPIC ID in RDI (per SysV); maps
# that back to a CPU index, loads the corresponding per-CPU page
# into IA32_GS_BASE, logs alive, increments the alive counter, then
# halts. K8.MVP replaces the halt loop with sched_pump.
def ap_main(apic_id: Int): Void
  var idx = -1
  var i = 0
  while i < g_cpu_count
    if cpu_apic_id(i) == apic_id
      idx = i
      i = g_cpu_count
    else
      i = i + 1
    end
  end

  if idx < 0
    uart_put_str("[ap] WARN: ap_main called with unknown apic_id=")
    uart_put_uint(apic_id)
    uart_putc(10)
    while 1 == 1
      @c("hlt")
    end
  end

  # Load this AP's per-CPU page into IA32_GS_BASE. From here %gs:off
  # reads land in this CPU's page (cpu_id, lapic_id, etc.).
  wrmsr(MSR_IA32_GS_BASE, pcpu_page_for(idx))

  # Load shared IDT before any code path can take an interrupt.
  # idt_install() populated the IDT + IDTR contents on BSP before AP
  # bringup; we just point this CPU's IDTR at the same base. Doing
  # this BEFORE apic_init() is critical — once the LAPIC timer is
  # programmed, any IRQ without an IDT triple-faults the AP.
  idt_load(get_idtr_addr())

  var verify_id = cpu_local_load(PCPU_CPU_ID)
  var verify_lapic = cpu_local_load(PCPU_LAPIC_ID)
  uart_put_str("[ap] CPU")
  uart_put_uint(idx)
  uart_put_str(" alive: %gs:cpu_id=")
  uart_put_uint(verify_id)
  uart_put_str(" %gs:lapic_id=")
  uart_put_uint(verify_lapic)
  uart_putc(10)

  # Mark alive. Plain RMW — only this AP writes (bringup is
  # serialized at K8.3); BSP's read goes through read_ap_alive() to
  # force reload. K8.4 atomics make this concurrent-safe for >2 APs.
  g_ap_alive_count = g_ap_alive_count + 1

  # Initialize this AP's LAPIC + start its periodic timer. Each CPU has
  # its own LAPIC at APIC_MMIO_BASE; writes from THIS CPU configure
  # THIS LAPIC. The timer wakes the AP from hlt below; without K8.7's
  # cross-CPU IPI wake-up, the LAPIC timer is the only wake source for
  # an idle AP.
  apic_init()

  # Initialize this AP's LAPIC + start its periodic timer (above). The timer
  # wakes the AP from hlt; with K8.7's cross-CPU IPI it also wakes on a
  # ready_push 0→1 transition routed to this CPU.
  #
  # Path C.5.5 — copying stacks are now PER-CPU: kern8_pcpu_init gave each CPU
  # its own 16-KiB active stack at its own VA, and a task pins to the CPU it
  # first parks on (TASK_HOME_CPU) so it always resumes at the same VA — the
  # same-address-restore invariant holds per-CPU. So APs pump again.
  #
  # First wait for BSP to finish the cooperative boot demos (which run
  # single-CPU on BSP) and flip g_ap_sched_enabled. The wait loop hlt's and
  # wakes on the LAPIC timer (~100 ms), re-checking each tick — boot-to-serve
  # latency of one tick is irrelevant.
  uart_put_str("[ap] CPU")
  uart_put_uint(idx)
  uart_put_str(" waiting for scheduler enable (C.5.5)\n")
  while g_ap_sched_enabled == 0
    @c("sti; hlt; cli")
  end
  # Mark online so BSP's least_loaded_cpu starts distributing unpinned tasks
  # here. Our ready ring + active stack are already initialized (kern8_pcpu_init).
  cpu_local_store(PCPU_SCHED_ONLINE, 1)
  uart_put_str("[ap] CPU")
  uart_put_uint(idx)
  uart_put_str(" online — pumping per-CPU ready ring (C.5.5)\n")
  # K8.6.7 — sched_pump (drain) per outer iter; load-aware push keeps this CPU's
  # drain loop from monopolizing a self-yielding task (a most-loaded CPU's
  # yields route to a lighter sibling). Then hlt until the next timer/IPI.
  while 1 == 1
    sched_pump()
    @c("sti; hlt; cli")
  end
end

# BSP-side bringup orchestrator. Serializes — one AP at a time:
#   1. Memcpy trampoline blob to phys 0x8000 (once).
#   2. Populate constant slots (PML4, ap_main address).
#   3. For each AP: write its stack into stack_slot, send
#      INIT-SIPI-SIPI, poll g_ap_alive_count.
def kern8_ap_bringup(): Void
  if g_cpu_count <= 1
    uart_put_str("[ap] single-CPU system — no APs to bring up\n")
    return
  end

  var blob = get_ap_trampoline_blob()
  var size = get_ap_trampoline_size()
  var dst = KERN8_AP_TRAMPOLINE_PHYS

  # Byte-copy the blob to its runtime address (phys 0x8000, identity-
  # mapped by the BSP's PML4 — we cover 0..1 GiB with 2 MiB pages).
  var i = 0
  while i < size
    volatile_store<U8>(dst + i, volatile_load<U8>(blob + i))
    i = i + 1
  end

  var pml4_off = get_ap_pml4_slot_offset()
  var main_off = get_ap_main_slot_offset()
  var stack_off = get_ap_stack_slot_offset()

  # PML4 base = current CR3 with low 12 bits masked off (CR3 carries
  # PCID + cache-control flags we don't want propagated as paging
  # state).
  var pml4 = read_cr3() & 0xFFFFFFFFFFFFF000
  volatile_store<U64>(dst + pml4_off, pml4)
  volatile_store<U64>(dst + main_off, ap_main_addr())

  uart_put_str("[ap] trampoline at ")
  uart_put_hex(dst)
  uart_put_str(" size=")
  uart_put_uint(size)
  uart_put_str(" pml4=")
  uart_put_hex(pml4)
  uart_putc(10)

  var vector = dst >> 12
  var ap_idx = 1
  while ap_idx < g_cpu_count
    if cpu_enabled(ap_idx) == 1
      var target_apic = cpu_apic_id(ap_idx)
      var stack_top = volatile_load<U64>(pcpu_page_for(ap_idx) + PCPU_KERNEL_STACK_TOP)
      volatile_store<U64>(dst + stack_off, stack_top)

      uart_put_str("[ap] starting CPU")
      uart_put_uint(ap_idx)
      uart_put_str(" apic_id=")
      uart_put_uint(target_apic)
      uart_put_str(" stack=")
      uart_put_hex(stack_top)
      uart_putc(10)

      var alive_before = read_ap_alive()
      apic_send_init(target_apic)
      busy_wait_ms(10)
      apic_send_startup(target_apic, vector)
      busy_wait_us(200)
      apic_send_startup(target_apic, vector)

      # Poll for ~1s wall-time (1G TSC cycles at the nominal 1 GHz).
      var t0 = read_tsc()
      var deadline = 1000000000
      var elapsed = 0
      while (read_ap_alive() == alive_before) and (elapsed < deadline)
        elapsed = read_tsc() - t0
      end
      if read_ap_alive() == alive_before
        uart_put_str("[ap] WARN: CPU")
        uart_put_uint(ap_idx)
        uart_put_str(" did not come up within 1G cycles\n")
      end
    end
    ap_idx = ap_idx + 1
  end

  uart_put_str("[ap] bringup complete: g_ap_alive_count=")
  uart_put_uint(g_ap_alive_count)
  uart_put_str(" expected=")
  uart_put_uint(g_cpu_count - 1)
  uart_putc(10)
end

# --- virtio-mmio (QEMU -M microvm) ---------------------------------
#
# QEMU's `microvm` machine type exposes eight virtio-mmio slots as a
# flat array at 0xFEB00000, 0x200 bytes apart. Each slot is a full
# virtio-mmio device register window (version 2, i.e. non-legacy).
#
# This block probes the slots at boot to find the virtio-net device —
# identified by DeviceID = 1 at offset 0x008 — and later code talks
# to it through the same register offsets.
#
# Spec reference: virtio 1.2, §4.2 (MMIO transport).
const VIRTIO_MMIO_BASE  = 0xFEB00000
const VIRTIO_MMIO_STRIDE = 0x200
# QEMU 10.2 microvm allocates 24 virtio-mmio slots; scanning 32 gives
# us some headroom for future QEMU versions without paying much for
# the extra MMIO reads (each read on an empty slot returns 0).
const VIRTIO_MMIO_SLOTS  = 32

# virtio-mmio register offsets. Common to both legacy (v1) and
# modern (v2) transport, unless marked.
const VIRTIO_REG_MAGIC      = 0x000    # must read 0x74726976 ("virt")
const VIRTIO_REG_VERSION    = 0x004    # 1 = legacy, 2 = modern
const VIRTIO_REG_DEVICE_ID  = 0x008    # 0 = empty slot, 1 = virtio-net

const VIRTIO_MAGIC       = 0x74726976   # "virt" little-endian
const VIRTIO_DEV_NET     = 1            # virtio-net

# QEMU `-M microvm` advertises virtio-mmio VERSION = 1 (legacy) and
# offers no machine-level flag to flip it. We accept either version
# at probe time; init in the next piece will branch on version for
# the register-layout differences (queue setup in particular).
const VIRTIO_VERSION_LEGACY = 1
const VIRTIO_VERSION_MODERN = 2

# Legacy virtio-mmio register offsets (v1). Modern (v2) reuses most
# of these but adds the split QueueDescLow/High etc. — we won't need
# those while microvm's legacy transport is our target.
const VIRTIO_REG_HOST_FEATURES       = 0x010
const VIRTIO_REG_HOST_FEATURES_SEL   = 0x014
const VIRTIO_REG_GUEST_FEATURES      = 0x020
const VIRTIO_REG_GUEST_FEATURES_SEL  = 0x024
const VIRTIO_REG_GUEST_PAGE_SIZE     = 0x028   # legacy only
const VIRTIO_REG_QUEUE_SEL           = 0x030
const VIRTIO_REG_QUEUE_NUM_MAX       = 0x034
const VIRTIO_REG_QUEUE_NUM           = 0x038
const VIRTIO_REG_QUEUE_ALIGN         = 0x03C   # legacy only
const VIRTIO_REG_QUEUE_PFN           = 0x040   # legacy only
const VIRTIO_REG_QUEUE_NOTIFY        = 0x050
const VIRTIO_REG_INTERRUPT_STATUS    = 0x060
const VIRTIO_REG_INTERRUPT_ACK       = 0x064
const VIRTIO_REG_STATUS              = 0x070
const VIRTIO_REG_CONFIG              = 0x100   # device-specific config (MAC etc.)

# Status bits (the sequence device drivers must OR-in, per spec).
const VIRTIO_STATUS_ACK         = 1
const VIRTIO_STATUS_DRIVER      = 2
const VIRTIO_STATUS_DRIVER_OK   = 4
const VIRTIO_STATUS_FEATURES_OK = 8
const VIRTIO_STATUS_FAILED      = 128

# virtio-net feature bits.
const VIRTIO_NET_F_MAC = 5

# Split virtqueue descriptor flags.
const VIRTQ_DESC_F_NEXT  = 1   # descriptor continues via next
const VIRTQ_DESC_F_WRITE = 2   # device writes this buffer (RX)

# Ring sizes — keep minimal while we're in the "prove it works"
# phase. QEMU virtio-net advertises QueueNumMax = 256, but 8 is
# plenty for receiving a handful of frames. Every device we care
# about supports at least 8.
const VIRTIO_NET_QSIZE = 8
const VIRTIO_RX_QUEUE  = 0
const VIRTIO_TX_QUEUE  = 1

# --- Driver state ----------------------------------------------
# One virtio-net device supported. Populated by virtio_net_init().
var g_vnet_base          = 0    # MMIO base of the device slot
var g_vnet_desc_addr     = 0    # RX queue: descriptor table
var g_vnet_avail_addr    = 0    # RX queue: avail ring
var g_vnet_used_addr     = 0    # RX queue: used ring
var g_vnet_rx_buf        = 0    # single RX buffer we post/reuse
var g_vnet_rx_posted     = 0    # RX avail.idx we've advanced to
var g_vnet_rx_consumed   = 0    # RX used.idx we've processed
var g_vnet_tx_desc_addr  = 0    # TX queue: descriptor table
var g_vnet_tx_avail_addr = 0    # TX queue: avail ring
var g_vnet_tx_used_addr  = 0    # TX queue: used ring
var g_vnet_tx_posted     = 0    # TX avail.idx we've advanced to
var g_tx_stalls          = 0    # # times virtio_net_tx_send hit a long spin
var g_tx_retransmits     = 0    # # segments replayed after RTO expiry
var g_tx_bytes_pending   = 0    # bytes currently in-flight across all slots (samples live)

# MAC read from virtio-net config space during init. Exposed to the
# HTTP response builder so the landing page can display the device's
# identity without re-reading MMIO per request.
var g_vnet_mac0 = 0
var g_vnet_mac1 = 0
var g_vnet_mac2 = 0
var g_vnet_mac3 = 0
var g_vnet_mac4 = 0
var g_vnet_mac5 = 0

# Gateway MAC — link-layer destination for any unsolicited TX. Captured
# from the eth-src of the boot ARP reply (and refreshed from any
# inbound IPv4 frame thereafter). All non-on-link traffic in QEMU SLIRP
# routes through 10.0.2.2 = MAC 52:55:0a:00:02:02; we don't trust the
# default and learn it instead. NET.1 Phase 1, Step 2.6.
var g_gateway_mac0 = 0
var g_gateway_mac1 = 0
var g_gateway_mac2 = 0
var g_gateway_mac3 = 0
var g_gateway_mac4 = 0
var g_gateway_mac5 = 0
var g_gateway_mac_known = 0

# --- TCP echo server state ----------------------------------------
# Single-connection TCP server listening on port 80. The state
# machine transitions per RFC 793 §3.2 with only the subset a toy
# echo needs — no retransmits, no TIME_WAIT, one connection at a
# time. All multi-byte fields (IP, port, seq, ack) are stored in
# host byte order and byte-swapped on the wire.
const TCP_LISTEN_PORT = 80
const TCP_ISS          = 0x12345678   # fixed server ISN (toy)

const TCP_FLAG_FIN = 0x01
const TCP_FLAG_SYN = 0x02
const TCP_FLAG_RST = 0x04
const TCP_FLAG_PSH = 0x08
const TCP_FLAG_ACK = 0x10

const TCP_STATE_LISTEN     = 0
const TCP_STATE_SYN_RCVD   = 1
const TCP_STATE_ESTAB      = 2
const TCP_STATE_CLOSE_WAIT = 3
const TCP_STATE_LAST_ACK   = 4
const TCP_STATE_CLOSED     = 5
# FIN_SENT: we've sent our FIN (after writing the HTTP response) and
# are waiting for the peer to FIN. Unifies FIN_WAIT_1 / FIN_WAIT_2 /
# CLOSING because a toy HTTP server has no reason to distinguish
# them — any incoming FIN just needs an ACK before we CLOSE.
const TCP_STATE_FIN_SENT   = 6
# Slot sentinel meaning "this conn-table slot is unused." Must be
# a value outside the state-machine enumeration above.
const TCP_STATE_FREE       = 255

# --- UDP (NET.1 Phase 1, May 2026) ----------------------------------
# Stateless datagram layer riding the existing IPv4 path. WireGuard
# (std/net/wireguard) binds UDP_WG_PORT; UDP_ECHO_PORT is the smoke-test
# responder used to validate the layer in QEMU before WG goes on top.
const IP_PROTO_TCP  = 0x06
const IP_PROTO_UDP  = 0x11
const UDP_ECHO_PORT = 7         # RFC 862 echo (smoke test only)
const UDP_WG_PORT   = 51820     # WireGuard default — std/net/wireguard

# WireGuard wire-format message-type bytes (per WG paper §5.4).
const WG_MSG_INITIATION = 0x01
const WG_MSG_RESPONSE   = 0x02
const WG_MSG_COOKIE     = 0x03   # Phase 2 cookie reply (DoS defense)
const WG_MSG_DATA       = 0x04

# Wire-format byte lengths.
const WG_INITIATION_LEN = 148
const WG_RESPONSE_LEN   = 92
const WG_COOKIE_REPLY_LEN = 64

# Action bits returned by `wg_timers_tick` — re-exported here to avoid a
# transitive `import` from `wg_tick_dispatch`'s callers. Keep in sync with
# `std/net/wireguard/timers.qz`.
const WG_ACTION_REKEY                 = 1
const WG_ACTION_RETRANSMIT_HANDSHAKE  = 2
const WG_ACTION_GIVE_UP_HANDSHAKE     = 4
const WG_ACTION_SEND_KEEPALIVE        = 8
const WG_ACTION_REJECT_SESSION        = 16

# WireGuard device state. Phase 1 = responder-only (no operator-supplied
# peer endpoints yet). The Device's static keypair is RDSEED/RDRAND-seeded
# at boot; the peer table starts empty. When an inbound MSG_INITIATION
# arrives from a configured peer (Step 2.6 will add the configuration
# surface), `wg_device_handle_initiation` walks the peer table by static
# pubkey, builds the response, and udp_send_reply ships it back to the
# inbound endpoint.
var g_wg_device: Device = Device {
  static_priv: 0,
  static_pub: 0,
  rng: Rng { prk: 0 },
  peers: vec_new<DevicePeer>(),
  cookie_secret: 0,
  cookie_secret_ms: 0,
  prev_cookie_secret: 0,
  prev_cookie_secret_ms: 0,
  under_load: 0,
  recent_handshake_count: 0,
  recent_handshake_window_ms: 0
}
var g_wg_initialized = 0

# Outbound WG packet body scratch. Reused across calls. Largest message
# is MSG_INITIATION at 148 bytes — round to 256 for alignment.
const WG_MSG_SCRATCH_SIZE = 256
var g_wg_msg_scratch = 0

# Inner-IP injection scratch (Step 2.6). When a tunneled MSG_DATA decrypts
# to an inner IPv4 packet, we synthesize an Ethernet frame around it (dst
# = our MAC, src = gateway MAC, ethertype = 0x0800) and feed it back into
# `ip_handle_frame_at` so the unikernel's TCP/UDP stack treats it as if
# it had arrived natively. One MTU-sized page is plenty (1500-byte inner
# IP + 14-byte eth header).
var g_wg_inner_scratch = 0
var g_wg_rx_inner_routed = 0

# Counters for stats.json visibility.
var g_wg_rx_initiation = 0
var g_wg_rx_response   = 0
var g_wg_rx_data       = 0
var g_wg_rx_cookie     = 0
var g_wg_rx_dropped    = 0
var g_wg_tx_response   = 0
var g_wg_tx_keepalive  = 0
var g_wg_tx_rekey      = 0
var g_wg_tx_cookie     = 0

# Connection table. Each slot is 192 bytes (bumped from 128 in DEF-E-N1
# phase 5 to add the per-connection goroutine fields at the tail):
#   offset 0    state (U8, TCP_STATE_FREE when unused)
#   offset 4    rcv_nxt (U32)
#   offset 8    snd_nxt (U32)            — next seq we'll transmit
#   offset 12   snd_una (U32)            — first unACKed seq
#   offset 16   remote_port (U32; stored as 32 for alignment)
#   offset 20   peer_mac (6 × U8)
#   offset 32   peer_ip  (4 × U8)
#   offset 36   peer_win (U16)           — peer's advertised receive window
#   offset 38   resp_active (U8)         — 1 if a response is mid-flight
#   offset 40   resp_scratch (U64 ptr)   — 64 KiB per-slot header+small-body scratch
#   offset 48   resp_body_ptr (U64 ptr)  — 0 if body inline in scratch, else PMM asset ptr
#   offset 56   resp_hdr_len (U32)       — header bytes in scratch (or full response length if body inline)
#   offset 60   resp_body_len (U32)      — external body length (0 for dynamic)
#   offset 64   resp_start_seq (U32)     — seq of first response byte
#   offset 68   resp_fin_sent (U8)       — 1 once FIN has been queued
#   offset 72   last_tx_tick (U64)       — g_tick_count when last segment was pushed
#   offset 80   goroutine (U64 ptr)      — task owning this slot's TCP state machine
#   offset 88   rx_chan (U64 ptr)        — bounded chan (cap 4) forwarding frames from main
#   offset 96   rx_scratch (U64 ptr)     — 2 PMM pages (4 × 1500 B ring) for forwarded frames
#   offset 104  rx_write_idx (U8)        — main's next buffer index (0..3)
#   offset 105  rx_read_idx (U8)         — goroutine's next buffer index (0..3)
# 106..191 reserved (delayed-ACK timer, RTT estimate, etc).
#
# 64 slots × 192 bytes = 12288 bytes = 3 PMM pages.
const CONN_SLOTS           = 64
const CONN_SLOT_SIZE       = 192
const SLOT_STATE           = 0
const SLOT_RCV_NXT         = 4
const SLOT_SND_NXT         = 8
const SLOT_SND_UNA         = 12
const SLOT_REMOTE_PORT     = 16
const SLOT_PEER_MAC        = 20
const SLOT_PEER_IP         = 32
const SLOT_PEER_WIN        = 36
const SLOT_RESP_ACTIVE     = 38
const SLOT_RESP_SCRATCH    = 40
const SLOT_RESP_BODY_PTR   = 48
const SLOT_RESP_HDR_LEN    = 56
const SLOT_RESP_BODY_LEN   = 60
const SLOT_RESP_START_SEQ  = 64
const SLOT_RESP_FIN_SENT   = 68
const SLOT_LAST_TX_TICK    = 72
# DEF-E-N1 phase 5: per-connection goroutine owns its TCP state machine.
# Main parses enough of each RX frame to identify peer+port, copies the
# Ethernet frame into SLOT_RX_SCRATCH[write_idx], and chan_try_sends the
# frame length into SLOT_RX_CHAN so the goroutine can pick it up. On SYN
# for an unknown peer, main allocates the slot synchronously, sends SYN
# + ACK, and spawns the goroutine — which then loops on chan_recv for
# everything post-handshake (ACK-of-SYN, data, FIN, LAST_ACK).
const SLOT_GOROUTINE       = 80   # U64 task ptr (0 while unallocated)
const SLOT_RX_CHAN         = 88   # U64 channel ptr (cap=4) — Ethernet frame-length tokens (main → conn pump)
const SLOT_RX_SCRATCH      = 96   # U64 ptr to 2 PMM pages; 4 × 1500 B ring
const SLOT_RX_WRITE_IDX    = 104  # U8 main's next buffer index (0..3)
const SLOT_RX_READ_IDX     = 105  # U8 goroutine's next buffer index (0..3)
# Payload-rx plumbing for the userland tcp_accept path. Populated lazily
# on first ESTAB-data deposit. Cursors are monotonic U32 (wrap mod ring
# size); signal channel is cap=1, holds a single "data available" token.
const SLOT_PAYLOAD_RX_CHAN      = 112  # U64 cap=1 signal channel
const SLOT_PAYLOAD_RX_SCRATCH   = 120  # U64 ptr to one PMM page; 4 KiB ring
const SLOT_PAYLOAD_RX_WRITE_OFF = 128  # U32 monotonic write cursor (mod ring size)
const SLOT_PAYLOAD_RX_READ_OFF  = 132  # U32 monotonic read cursor (mod ring size)
# Offsets 136-137 unused (U8 hole).
const SLOT_LOCAL_PORT           = 138  # U16 dst-port the slot is bound to (set from listening entry); load-bearing for tcp_find_slot disambiguation under same-src-port-different-dst-port reuse
const SLOT_TX_DONE_CHAN         = 144  # U64 cap=1 signal channel — fires when async_tcp_write completes
# 152..191 reserved (delayed-ACK timer, RTT estimate, etc).
const SLOT_RX_SCRATCH_STRIDE = 1536   # per-frame slot in rx scratch; fits Ethernet MTU (1514) + pad
const SLOT_RX_CHAN_CAP     = 4
const PAYLOAD_RX_RING_SIZE = 4096    # one PMM page; sized for typical HTTP request headers + small body

# Per-slot response scratch — 16 contiguous PMM pages (64 KiB) matches
# the old shared g_http_resp_scratch capacity, so any dynamic response
# that fit into the old buffer also fits into a slot-private one.
# 64 slots × 16 pages = 1024 pages = 4 MiB of the 64 MiB PMM pool.
const RESP_SCRATCH_PAGES   = 16

# Retransmission time-out in ticks. The LAPIC timer fires at ~1 Hz, so
# RTO_TICKS = 1 ≈ 1 s — the RFC 6298 default. Doubled on each retry
# up to RTO_MAX_TICKS; giving up after RTO_MAX_RETRIES forces the slot
# closed. These values are deliberately generous — SLIRP has sub-ms
# RTT, so a 1 s first-retry is only going to fire under actual loss.
const RTO_TICKS            = 1
const RTO_MAX_TICKS        = 60
const RTO_MAX_RETRIES      = 8

var g_conn_table      = 0   # base address of the 16-slot conn table
var g_tcp_connections = 0   # total completed connections (never reset)

# Slot accessors — endless defs so the call overhead inlines and
# there's no heap alloc. All per-slot state goes through these.
def conn_slot_addr(i: Int): Int = g_conn_table + (i * CONN_SLOT_SIZE)
def conn_state(slot: Int): Int = volatile_load<U8>(slot + SLOT_STATE)
def conn_set_state(slot: Int, s: Int): Void = volatile_store<U8>(slot + SLOT_STATE, s)
def conn_rcv_nxt(slot: Int): Int = volatile_load<U32>(slot + SLOT_RCV_NXT)
def conn_set_rcv_nxt(slot: Int, v: Int): Void = volatile_store<U32>(slot + SLOT_RCV_NXT, v)
def conn_snd_nxt(slot: Int): Int = volatile_load<U32>(slot + SLOT_SND_NXT)
def conn_set_snd_nxt(slot: Int, v: Int): Void = volatile_store<U32>(slot + SLOT_SND_NXT, v)
def conn_snd_una(slot: Int): Int = volatile_load<U32>(slot + SLOT_SND_UNA)
def conn_set_snd_una(slot: Int, v: Int): Void = volatile_store<U32>(slot + SLOT_SND_UNA, v)
def conn_remote_port(slot: Int): Int = volatile_load<U32>(slot + SLOT_REMOTE_PORT)
def conn_set_remote_port(slot: Int, p: Int): Void = volatile_store<U32>(slot + SLOT_REMOTE_PORT, p)
def conn_peer_win(slot: Int): Int = volatile_load<U16>(slot + SLOT_PEER_WIN)
def conn_set_peer_win(slot: Int, w: Int): Void = volatile_store<U16>(slot + SLOT_PEER_WIN, w)
def conn_resp_active(slot: Int): Int = volatile_load<U8>(slot + SLOT_RESP_ACTIVE)
def conn_set_resp_active(slot: Int, v: Int): Void = volatile_store<U8>(slot + SLOT_RESP_ACTIVE, v)
def conn_resp_scratch(slot: Int): Int = volatile_load<U64>(slot + SLOT_RESP_SCRATCH)
def conn_resp_body_ptr(slot: Int): Int = volatile_load<U64>(slot + SLOT_RESP_BODY_PTR)
def conn_set_resp_body_ptr(slot: Int, p: Int): Void = volatile_store<U64>(slot + SLOT_RESP_BODY_PTR, p)
def conn_resp_hdr_len(slot: Int): Int = volatile_load<U32>(slot + SLOT_RESP_HDR_LEN)
def conn_set_resp_hdr_len(slot: Int, n: Int): Void = volatile_store<U32>(slot + SLOT_RESP_HDR_LEN, n)
def conn_resp_body_len(slot: Int): Int = volatile_load<U32>(slot + SLOT_RESP_BODY_LEN)
def conn_set_resp_body_len(slot: Int, n: Int): Void = volatile_store<U32>(slot + SLOT_RESP_BODY_LEN, n)
def conn_resp_start_seq(slot: Int): Int = volatile_load<U32>(slot + SLOT_RESP_START_SEQ)
def conn_set_resp_start_seq(slot: Int, s: Int): Void = volatile_store<U32>(slot + SLOT_RESP_START_SEQ, s)
def conn_resp_fin_sent(slot: Int): Int = volatile_load<U8>(slot + SLOT_RESP_FIN_SENT)
def conn_set_resp_fin_sent(slot: Int, v: Int): Void = volatile_store<U8>(slot + SLOT_RESP_FIN_SENT, v)
def conn_last_tx_tick(slot: Int): Int = volatile_load<U64>(slot + SLOT_LAST_TX_TICK)
def conn_set_last_tx_tick(slot: Int, t: Int): Void = volatile_store<U64>(slot + SLOT_LAST_TX_TICK, t)
def conn_goroutine(slot: Int): Int = volatile_load<U64>(slot + SLOT_GOROUTINE)
def conn_set_goroutine(slot: Int, t: Int): Void = volatile_store<U64>(slot + SLOT_GOROUTINE, t)
def conn_rx_chan(slot: Int): Int = volatile_load<U64>(slot + SLOT_RX_CHAN)
def conn_set_rx_chan(slot: Int, c: Int): Void = volatile_store<U64>(slot + SLOT_RX_CHAN, c)
def conn_rx_scratch(slot: Int): Int = volatile_load<U64>(slot + SLOT_RX_SCRATCH)
def conn_set_rx_scratch(slot: Int, p: Int): Void = volatile_store<U64>(slot + SLOT_RX_SCRATCH, p)
def conn_rx_write_idx(slot: Int): Int = volatile_load<U8>(slot + SLOT_RX_WRITE_IDX)
def conn_set_rx_write_idx(slot: Int, i: Int): Void = volatile_store<U8>(slot + SLOT_RX_WRITE_IDX, i)
def conn_rx_read_idx(slot: Int): Int = volatile_load<U8>(slot + SLOT_RX_READ_IDX)
def conn_set_rx_read_idx(slot: Int, i: Int): Void = volatile_store<U8>(slot + SLOT_RX_READ_IDX, i)
def conn_payload_rx_chan(slot: Int): Int = volatile_load<U64>(slot + SLOT_PAYLOAD_RX_CHAN)
def conn_set_payload_rx_chan(slot: Int, c: Int): Void = volatile_store<U64>(slot + SLOT_PAYLOAD_RX_CHAN, c)
def conn_payload_rx_scratch(slot: Int): Int = volatile_load<U64>(slot + SLOT_PAYLOAD_RX_SCRATCH)
def conn_set_payload_rx_scratch(slot: Int, p: Int): Void = volatile_store<U64>(slot + SLOT_PAYLOAD_RX_SCRATCH, p)
def conn_payload_rx_write_off(slot: Int): Int = volatile_load<U32>(slot + SLOT_PAYLOAD_RX_WRITE_OFF)
def conn_set_payload_rx_write_off(slot: Int, v: Int): Void = volatile_store<U32>(slot + SLOT_PAYLOAD_RX_WRITE_OFF, v)
def conn_payload_rx_read_off(slot: Int): Int = volatile_load<U32>(slot + SLOT_PAYLOAD_RX_READ_OFF)
def conn_set_payload_rx_read_off(slot: Int, v: Int): Void = volatile_store<U32>(slot + SLOT_PAYLOAD_RX_READ_OFF, v)
def conn_local_port(slot: Int): Int = volatile_load<U16>(slot + SLOT_LOCAL_PORT)
def conn_set_local_port(slot: Int, p: Int): Void = volatile_store<U16>(slot + SLOT_LOCAL_PORT, p)
def conn_tx_done_chan(slot: Int): Int = volatile_load<U64>(slot + SLOT_TX_DONE_CHAN)
def conn_set_tx_done_chan(slot: Int, c: Int): Void = volatile_store<U64>(slot + SLOT_TX_DONE_CHAN, c)

# Derived: total response byte length. Body bytes are stored in two
# regions — the in-scratch header (hdr_len) and the optional PMM asset
# body (body_len). For dynamic responses (landing, stats), body_len
# is 0 and hdr_len is the full response length.
def conn_resp_total_len(slot: Int): Int = conn_resp_hdr_len(slot) + conn_resp_body_len(slot)

# Initialize the conn table — allocate the slot table + per-slot
# response scratch buffers, mark every slot FREE. Called once at
# boot, before the serve loop.
#
# Layout: the slot table is CONN_SLOTS * CONN_SLOT_SIZE bytes. For
# CONN_SLOTS=64, CONN_SLOT_SIZE=192 that's 12 KiB = 3 contiguous PMM
# pages (the bump allocator returns sequentially adjacent pages).
# Each slot then owns RESP_SCRATCH_PAGES contiguous PMM pages used as
# its private response-build buffer + retry source, plus 2 pages of
# inbound-frame scratch (4 × 1500 B ring that main copies into so the
# per-connection goroutine can consume at its own pace without racing
# the RX ring). 64 slots × (16 + 2) pages × 4 KiB = 4.5 MiB committed.
def tcp_conn_table_init(): Void
  # 3 adjacent pages for 12 KiB of slot table. conn_slot_addr indexes
  # off g_conn_table so the bump allocator's contiguity is load-bearing.
  g_conn_table = pmm_alloc_page()
  pmm_alloc_page()
  pmm_alloc_page()
  var i = 0
  while i < CONN_SLOTS
    var slot = conn_slot_addr(i)
    volatile_store<U8>(slot + SLOT_STATE, TCP_STATE_FREE)
    var scratch = pmm_alloc_page()
    var pg = 1
    while pg < RESP_SCRATCH_PAGES
      pmm_alloc_page()
      pg = pg + 1
    end
    volatile_store<U64>(slot + SLOT_RESP_SCRATCH, scratch)
    volatile_store<U8>(slot + SLOT_RESP_ACTIVE, 0)
    volatile_store<U8>(slot + SLOT_RESP_FIN_SENT, 0)
    # Inbound-frame ring: 2 adjacent pages = 8192 bytes > 4 × 1536 = 6144.
    var rx_scratch = pmm_alloc_page()
    pmm_alloc_page()
    conn_set_rx_scratch(slot, rx_scratch)
    conn_set_rx_write_idx(slot, 0)
    conn_set_rx_read_idx(slot, 0)
    conn_set_goroutine(slot, 0)
    conn_set_rx_chan(slot, 0)
    i = i + 1
  end
end

# Find the slot matching (peer_ip, peer_port). Returns slot address
# or 0 if no match. Nested `if` (instead of chained `and`) dodges
# PSQ-10's compound-boolean malloc-per-eval bug, which would
# otherwise fire on every incoming packet × up to 16 slots.
def tcp_find_slot(ip0: Int, ip1: Int, ip2: Int, ip3: Int, port: Int, local_port: Int): Int
  var i = 0
  while i < CONN_SLOTS
    var slot = conn_slot_addr(i)
    if conn_state(slot) != TCP_STATE_FREE
      if conn_remote_port(slot) == port
        if conn_local_port(slot) == local_port
          if volatile_load<U8>(slot + SLOT_PEER_IP + 0) == ip0
            if volatile_load<U8>(slot + SLOT_PEER_IP + 1) == ip1
              if volatile_load<U8>(slot + SLOT_PEER_IP + 2) == ip2
                if volatile_load<U8>(slot + SLOT_PEER_IP + 3) == ip3
                  return slot
                end
              end
            end
          end
        end
      end
    end
    i = i + 1
  end
  return 0
end

# Return the first FREE slot, or 0 if the table is full.
def tcp_find_free_slot(): Int
  var i = 0
  while i < CONN_SLOTS
    var slot = conn_slot_addr(i)
    if conn_state(slot) == TCP_STATE_FREE
      return slot
    end
    i = i + 1
  end
  return 0
end

# Count active (non-free) slots. Exposed via /api/stats.json so the
# browser can show live concurrency. Cheap — 16-slot scan.
def tcp_active_conns(): Int
  var count = 0
  var i = 0
  while i < CONN_SLOTS
    var slot = conn_slot_addr(i)
    if conn_state(slot) != TCP_STATE_FREE
      count = count + 1
    end
    i = i + 1
  end
  return count
end

# Release a slot back to the free pool. Called from the connection
# goroutine on final CLOSED. Keeps resp_scratch + rx_scratch + rx_chan
# pointers intact (kernel-lifetime PMM allocs; rx_chan is reset on
# next reuse via chan_reset); only the per-connection state clears.
# Clears SLOT_GOROUTINE so main can detect "this slot is ready for a
# fresh goroutine" cleanly. The caller's task_exit() runs right after,
# so no main-side race on the now-zero task ptr.
def tcp_free_slot(slot: Int): Void
  volatile_store<U8>(slot + SLOT_STATE, TCP_STATE_FREE)
  volatile_store<U8>(slot + SLOT_RESP_ACTIVE, 0)
  volatile_store<U8>(slot + SLOT_RESP_FIN_SENT, 0)
  volatile_store<U16>(slot + SLOT_PEER_WIN, 0)
  conn_set_goroutine(slot, 0)
  # Close the per-slot signal channels so any parked goroutine (blocked
  # in async_tcp_read or async_tcp_write) wakes up and sees EOF.
  # Channels stay allocated for next slot reuse; chan_reset on next
  # tcp_accept_syn clears the closed flag.
  var rx_ch = conn_payload_rx_chan(slot)
  if rx_ch != 0
    chan_close(rx_ch)
  end
  var tx_ch = conn_tx_done_chan(slot)
  if tx_ch != 0
    chan_close(tx_ch)
  end
end

# Reusable TX scratch for tcp_send and HTTP response bodies. Allocated
# once at boot (in main) and reused forever. Without this every
# request leaks 2 pages from the bump allocator (one per tcp_send
# call + one per response body build), which exhausts the 64 MiB
# PMM pool inside an hour of meta-refresh traffic.
var g_tcp_tx_scratch = 0

# Reusable TX scratch for UDP replies. One PMM page is plenty — even
# a max-MTU UDP datagram (1500 - 20 IP - 8 UDP = 1472 payload) fits in
# a single 4 KiB page including the eth/ip/udp headers and virtio prelude.
# Allocated once at boot in main().
var g_udp_tx_scratch = 0

# UDP telemetry counters surfaced via /api/stats.json.
var g_udp_rx_total   = 0   # all UDP datagrams received
var g_udp_echo_total = 0   # UDP_ECHO_PORT datagrams echoed back

# Slot address for index i.
def virtio_slot(i: Int): Int
  return VIRTIO_MMIO_BASE + (i * VIRTIO_MMIO_STRIDE)
end

# Scan all virtio-mmio slots, looking for the first one that claims
# to be virtio-net (DeviceID = 1) with a supported version (1 or 2).
# Returns the slot's base MMIO address, or 0 if no matching device.
# QEMU microvm fills slots back-to-front, so virtio-net sits near
# the end of the range.
def virtio_find_net(): Int
  var i = 0
  while i < VIRTIO_MMIO_SLOTS
    var base = virtio_slot(i)
    if volatile_load<U32>(base + VIRTIO_REG_MAGIC) == VIRTIO_MAGIC
      var version = volatile_load<U32>(base + VIRTIO_REG_VERSION)
      var dev_id  = volatile_load<U32>(base + VIRTIO_REG_DEVICE_ID)
      if (version == VIRTIO_VERSION_LEGACY or version == VIRTIO_VERSION_MODERN) and dev_id == VIRTIO_DEV_NET
        return base
      end
    end
    i = i + 1
  end
  return 0
end

# 32-bit MMIO helpers — all virtio-mmio register accesses must be
# 32 bits wide per spec §4.2.2.2.
def vnet_r32(offset: Int): Int
  return volatile_load<U32>(g_vnet_base + offset)
end

def vnet_w32(offset: Int, val: Int): Void
  volatile_store<U32>(g_vnet_base + offset, val)
end

# Print one byte as two-digit lowercase hex. Used for MAC formatting.
def uart_put_hex2(n: Int): Void
  var hi = (n >> 4) & 0xF
  var lo = n & 0xF
  if hi < 10
    uart_putc(48 + hi)
  else
    uart_putc(87 + hi)
  end
  if lo < 10
    uart_putc(48 + lo)
  else
    uart_putc(87 + lo)
  end
end

# Zero a full 4 KiB page (512 i64 stores).
def virtio_zero_page(addr: Int): Void
  var i = 0
  while i < 512
    store(addr, i, 0)
    i = i + 1
  end
end

# Feature-negotiate + queue-set-up the legacy virtio-net device at
# `base`. Spec §3.1 initialization sequence for legacy transport:
#
#   1. reset                     — status = 0
#   2. ack                       — status |= ACK
#   3. driver                    — status |= DRIVER
#   4. feature negotiation       — read host features, write what we
#                                  accept into guest features
#   5. legacy specifics          — write guest page size = 4096
#   6. queue setup               — QueueSel, QueueNum, QueueAlign,
#                                  QueuePFN for each queue we want
#   7. driver_ok                 — status |= DRIVER_OK
#
# Legacy virtqueue memory is a single contiguous region laid out as:
#   offset 0:              descriptor table (16 * N bytes)
#   offset 16*N:           avail ring (6 + 2*N bytes)
#   offset aligned(…, 4K): used ring (6 + 8*N + 2 bytes)
#
# For N=8 this fits in 8 KiB (two 4-KiB pages). We allocate them
# contiguously from the PMM bump allocator — pmm_alloc_page always
# hands out monotonically increasing addresses.
def virtio_net_init(base: Int): Void
  g_vnet_base = base

  # 1. reset
  vnet_w32(VIRTIO_REG_STATUS, 0)

  # 2. ack
  vnet_w32(VIRTIO_REG_STATUS, VIRTIO_STATUS_ACK)

  # 3. driver
  vnet_w32(VIRTIO_REG_STATUS, VIRTIO_STATUS_ACK | VIRTIO_STATUS_DRIVER)

  # 4. feature negotiation — only accept VIRTIO_NET_F_MAC (bit 5).
  #    Split across two 32-bit halves: low (bits 0..31), high (32..63).
  vnet_w32(VIRTIO_REG_HOST_FEATURES_SEL, 0)
  var host_lo = vnet_r32(VIRTIO_REG_HOST_FEATURES)
  var want_lo = 1 << VIRTIO_NET_F_MAC
  vnet_w32(VIRTIO_REG_GUEST_FEATURES_SEL, 0)
  vnet_w32(VIRTIO_REG_GUEST_FEATURES, want_lo & host_lo)

  vnet_w32(VIRTIO_REG_HOST_FEATURES_SEL, 1)
  var _host_hi = vnet_r32(VIRTIO_REG_HOST_FEATURES)
  vnet_w32(VIRTIO_REG_GUEST_FEATURES_SEL, 1)
  vnet_w32(VIRTIO_REG_GUEST_FEATURES, 0)     # accept nothing from high half

  # 5. legacy page size — needed before QueuePFN is meaningful.
  vnet_w32(VIRTIO_REG_GUEST_PAGE_SIZE, 4096)

  # Read the 6-byte MAC from device config space. Legacy virtio-net
  # places MAC at offset 0 of the config window when F_MAC is set.
  var mac0 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 0)
  var mac1 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 1)
  var mac2 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 2)
  var mac3 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 3)
  var mac4 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 4)
  var mac5 = volatile_load<U8>(base + VIRTIO_REG_CONFIG + 5)

  # Stash MAC bytes so http_build_landing_telemetry can show them
  # without re-reading config MMIO per request.
  g_vnet_mac0 = mac0
  g_vnet_mac1 = mac1
  g_vnet_mac2 = mac2
  g_vnet_mac3 = mac3
  g_vnet_mac4 = mac4
  g_vnet_mac5 = mac5

  # 6a. RX queue (queue 0) setup.
  vnet_w32(VIRTIO_REG_QUEUE_SEL, VIRTIO_RX_QUEUE)
  var qmax = vnet_r32(VIRTIO_REG_QUEUE_NUM_MAX)
  if qmax < VIRTIO_NET_QSIZE
    uart_put_str("virtio-net: RX QueueNumMax too small\n")
    vnet_w32(VIRTIO_REG_STATUS, VIRTIO_STATUS_FAILED)
    return
  end
  vnet_w32(VIRTIO_REG_QUEUE_NUM, VIRTIO_NET_QSIZE)
  vnet_w32(VIRTIO_REG_QUEUE_ALIGN, 4096)

  var rx_queue_mem = pmm_alloc_page()
  pmm_alloc_page()
  virtio_zero_page(rx_queue_mem)
  virtio_zero_page(rx_queue_mem + 4096)

  g_vnet_desc_addr  = rx_queue_mem
  g_vnet_avail_addr = rx_queue_mem + (16 * VIRTIO_NET_QSIZE)
  g_vnet_used_addr  = rx_queue_mem + 4096

  vnet_w32(VIRTIO_REG_QUEUE_PFN, rx_queue_mem >> 12)

  # 6b. TX queue (queue 1) setup — identical shape, separate memory.
  vnet_w32(VIRTIO_REG_QUEUE_SEL, VIRTIO_TX_QUEUE)
  var txmax = vnet_r32(VIRTIO_REG_QUEUE_NUM_MAX)
  if txmax < VIRTIO_NET_QSIZE
    uart_put_str("virtio-net: TX QueueNumMax too small\n")
    vnet_w32(VIRTIO_REG_STATUS, VIRTIO_STATUS_FAILED)
    return
  end
  vnet_w32(VIRTIO_REG_QUEUE_NUM, VIRTIO_NET_QSIZE)
  vnet_w32(VIRTIO_REG_QUEUE_ALIGN, 4096)

  var tx_queue_mem = pmm_alloc_page()
  pmm_alloc_page()
  virtio_zero_page(tx_queue_mem)
  virtio_zero_page(tx_queue_mem + 4096)

  g_vnet_tx_desc_addr  = tx_queue_mem
  g_vnet_tx_avail_addr = tx_queue_mem + (16 * VIRTIO_NET_QSIZE)
  g_vnet_tx_used_addr  = tx_queue_mem + 4096

  vnet_w32(VIRTIO_REG_QUEUE_PFN, tx_queue_mem >> 12)

  # 7. driver_ok — device is now live.
  vnet_w32(VIRTIO_REG_STATUS, VIRTIO_STATUS_ACK | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_DRIVER_OK)

  uart_put_str("virtio-net ready: MAC=")
  uart_put_hex2(mac0)
  uart_putc(58)   # ':'
  uart_put_hex2(mac1)
  uart_putc(58)
  uart_put_hex2(mac2)
  uart_putc(58)
  uart_put_hex2(mac3)
  uart_putc(58)
  uart_put_hex2(mac4)
  uart_putc(58)
  uart_put_hex2(mac5)
  uart_putc(10)
end

# Post one empty RX buffer on the avail ring and kick the device.
# Can be called repeatedly — each call reuses descriptor slot 0 and
# the single RX buffer, and advances avail.idx through the ring so
# the device sees a fresh "available" entry each time. The caller is
# responsible for having consumed (parsed/dumped) any prior frame in
# the shared buffer before re-posting.
#
# Split virtqueue layout (legacy):
#   descriptor[0] (16 bytes): addr, len, flags, next
#   avail ring   (+16*N):     flags, idx, ring[N]
#   used  ring   (+4096):     flags, idx, ring[N] of {id, len}
def virtio_net_rx_post(): Void
  if g_vnet_rx_buf == 0
    g_vnet_rx_buf = pmm_alloc_page()
  end

  var desc0 = g_vnet_desc_addr
  volatile_store<U64>(desc0 + 0,  g_vnet_rx_buf)
  volatile_store<U32>(desc0 + 8,  4096)
  volatile_store<U16>(desc0 + 12, VIRTQ_DESC_F_WRITE)
  volatile_store<U16>(desc0 + 14, 0)

  # avail.ring[posted % N] = desc 0
  var slot = g_vnet_rx_posted & (VIRTIO_NET_QSIZE - 1)
  volatile_store<U16>(g_vnet_avail_addr + 4 + (slot * 2), 0)
  g_vnet_rx_posted = g_vnet_rx_posted + 1
  volatile_store<U16>(g_vnet_avail_addr + 2, g_vnet_rx_posted)

  vnet_w32(VIRTIO_REG_QUEUE_NOTIFY, VIRTIO_RX_QUEUE)
end

# Post a single TX descriptor pointing at `buf` (`len` bytes) on the
# TX queue, kick the device, and block until the device has actually
# processed the descriptor.
#
# The synchronous wait is load-bearing: we reuse descriptor slot 0
# across every TX, so the next caller would overwrite `desc[0].addr`
# before the device had a chance to DMA the old buffer. Without the
# wait, a back-to-back `tcp_send(response) + tcp_send(FIN)` causes
# the response buffer pointer to be clobbered — the device ends up
# reading and sending the FIN twice while the response never leaves.
# Caught live in KERN.3d debugging.
def virtio_net_tx_send(buf: Int, len: Int): Void
  var desc = g_vnet_tx_desc_addr
  volatile_store<U64>(desc + 0,  buf)
  volatile_store<U32>(desc + 8,  len)
  volatile_store<U16>(desc + 12, 0)   # device READS (no F_WRITE)
  volatile_store<U16>(desc + 14, 0)

  var slot = g_vnet_tx_posted & (VIRTIO_NET_QSIZE - 1)
  volatile_store<U16>(g_vnet_tx_avail_addr + 4 + (slot * 2), 0)
  g_vnet_tx_posted = g_vnet_tx_posted + 1
  volatile_store<U16>(g_vnet_tx_avail_addr + 2, g_vnet_tx_posted)

  vnet_w32(VIRTIO_REG_QUEUE_NOTIFY, VIRTIO_TX_QUEUE)

  # Synchronous drain — spin until used.idx catches up to tx_posted.
  # Never fake-complete: the old code set `used = g_vnet_tx_posted`
  # after 10M spins to escape a stuck device, but that caused the
  # NEXT call to overwrite desc[0] while the device was still DMAing
  # the current packet — silent descriptor corruption. Observed live
  # on the VPS at exactly 149 segments × 1400 bytes = 209 160 bytes
  # into /docs/quartz_reference (docs/bugs/UNIKERNEL_TX_STALL_209KB.md).
  # We instead bump a counter on the first 10M-spin milestone and
  # keep waiting — a genuinely broken device will now visibly hang
  # the kernel (health check goes red) rather than silently corrupt
  # traffic. Until DEF-D (retransmits + receive-window honoring)
  # lands, this is the honest behavior.
  #
  # IMPORTANT: both avail.idx and used.idx are 16-bit wrapping per
  # the virtio spec. g_vnet_tx_posted is a full 64-bit monotonic
  # counter; we mask to 16 bits before comparison. Without this
  # mask, at the 65 536th packet the wrapped device used.idx (0)
  # never matches the unbounded posted counter (65 536), and the
  # drain loop hangs forever (first seen on the VPS at ~10 min
  # uptime — see UNIKERNEL_TX_IDX_WRAP_HANG.md).
  var spins = 0
  var stalled_logged = 0
  var posted_lo = g_vnet_tx_posted & 0xFFFF
  var used = volatile_load<U16>(g_vnet_tx_used_addr + 2)
  while used != posted_lo
    if spins == 10000000
      if stalled_logged == 0
        g_tx_stalls = g_tx_stalls + 1
        uart_put_str("[tx: stall >10M spins, packet ")
        uart_put_uint(g_vnet_tx_posted)
        uart_put_str("]\n")
        stalled_logged = 1
      end
    end
    spins = spins + 1
    used = volatile_load<U16>(g_vnet_tx_used_addr + 2)
  end
end

# Compute the RFC 1071 "Internet Checksum" (16-bit one's-complement
# sum, folded) over `byte_len` bytes starting at `addr`. Used for
# both the IPv4 header checksum and the ICMP/TCP/UDP checksums.
#
# Treats the buffer as big-endian 16-bit words (network byte order).
# Handles odd byte count by padding the final high-byte with zero.
# Written to dodge PSQ-10 (no compound boolean in the loop).
def ip_checksum(addr: Int, byte_len: Int): Int
  var sum = 0
  var i = 0
  var limit = byte_len - 1
  while i < limit
    var hi = volatile_load<U8>(addr + i)
    var lo = volatile_load<U8>(addr + i + 1)
    sum = sum + ((hi << 8) | lo)
    i = i + 2
  end
  if i < byte_len
    sum = sum + (volatile_load<U8>(addr + i) << 8)
  end
  # Fold carries until only 16 bits remain.
  while (sum >> 16) != 0
    sum = (sum & 0xFFFF) + (sum >> 16)
  end
  return (sum & 0xFFFF) ^ 0xFFFF
end

# Build and send a broadcast ARP WHO-HAS for the SLIRP gateway
# (10.0.2.2), sourced from our virtio MAC and the default DHCP IP
# 10.0.2.15. QEMU's user-mode network stack replies with an ARP reply
# naming the gateway's MAC (52:55:0a:00:02:02) — that's the frame we
# receive in virtio_net_wait_rx and hex-dump.
#
# Buffer layout (52 bytes):
#   [0..10]   legacy virtio_net_hdr (all zero)
#   [10..14]  ignored dst ether     — fits into eth header below
#   [10..16]  eth dst MAC           = FF FF FF FF FF FF (broadcast)
#   [16..22]  eth src MAC           = 52 54 00 12 34 56
#   [22..24]  ethertype             = 08 06 (ARP)
#   [24..26]  ARP htype             = 00 01 (Ethernet)
#   [26..28]  ARP ptype             = 08 00 (IPv4)
#   [28]      ARP hlen              = 6
#   [29]      ARP plen              = 4
#   [30..32]  ARP oper              = 00 01 (request)
#   [32..38]  ARP sender MAC        = 52 54 00 12 34 56
#   [38..42]  ARP sender IP         = 0A 00 02 0F (10.0.2.15)
#   [42..48]  ARP target MAC        = 00 00 00 00 00 00
#   [48..52]  ARP target IP         = 0A 00 02 02 (10.0.2.2)
def virtio_net_tx_arp_request(): Void
  var buf = pmm_alloc_page()

  # Zero the header + frame region. pmm_alloc_page hands out non-zeroed
  # pages (the bump allocator doesn't clear) so we can't rely on 0s.
  var j = 0
  while j < 64
    volatile_store<U8>(buf + j, 0)
    j = j + 1
  end

  # Ethernet: dst broadcast, src = our MAC, ethertype = ARP
  volatile_store<U8>(buf + 10, 0xFF)
  volatile_store<U8>(buf + 11, 0xFF)
  volatile_store<U8>(buf + 12, 0xFF)
  volatile_store<U8>(buf + 13, 0xFF)
  volatile_store<U8>(buf + 14, 0xFF)
  volatile_store<U8>(buf + 15, 0xFF)
  volatile_store<U8>(buf + 16, 0x52)
  volatile_store<U8>(buf + 17, 0x54)
  volatile_store<U8>(buf + 18, 0x00)
  volatile_store<U8>(buf + 19, 0x12)
  volatile_store<U8>(buf + 20, 0x34)
  volatile_store<U8>(buf + 21, 0x56)
  volatile_store<U8>(buf + 22, 0x08)     # ethertype hi
  volatile_store<U8>(buf + 23, 0x06)     # ethertype lo — 0x0806 = ARP

  # ARP body
  volatile_store<U8>(buf + 24, 0x00)
  volatile_store<U8>(buf + 25, 0x01)     # htype = 1 (Ethernet)
  volatile_store<U8>(buf + 26, 0x08)
  volatile_store<U8>(buf + 27, 0x00)     # ptype = 0x0800 (IPv4)
  volatile_store<U8>(buf + 28, 0x06)     # hlen
  volatile_store<U8>(buf + 29, 0x04)     # plen
  volatile_store<U8>(buf + 30, 0x00)
  volatile_store<U8>(buf + 31, 0x01)     # oper = 1 (request)
  # Sender MAC = our MAC
  volatile_store<U8>(buf + 32, 0x52)
  volatile_store<U8>(buf + 33, 0x54)
  volatile_store<U8>(buf + 34, 0x00)
  volatile_store<U8>(buf + 35, 0x12)
  volatile_store<U8>(buf + 36, 0x34)
  volatile_store<U8>(buf + 37, 0x56)
  # Sender IP = 10.0.2.15 (SLIRP's default DHCP address)
  volatile_store<U8>(buf + 38, 0x0A)
  volatile_store<U8>(buf + 39, 0x00)
  volatile_store<U8>(buf + 40, 0x02)
  volatile_store<U8>(buf + 41, 0x0F)
  # Target MAC already zero
  # Target IP = 10.0.2.2 (SLIRP gateway)
  volatile_store<U8>(buf + 48, 0x0A)
  volatile_store<U8>(buf + 49, 0x00)
  volatile_store<U8>(buf + 50, 0x02)
  volatile_store<U8>(buf + 51, 0x02)

  virtio_net_tx_send(buf, 52)
end

# Build + send an ICMP echo request to 10.0.2.2 (SLIRP gateway).
# SLIRP responds with an ICMP echo reply, which we hex-dump on RX.
#
# Frame layout (60 bytes on the wire):
#   [0..10]   virtio_net_hdr  (all zero)
#   [10..24]  Ethernet         dst=gateway MAC, src=ours, ethertype=0x0800
#   [24..44]  IPv4             ver 4, IHL 5, total_len 36, TTL 64,
#                              proto ICMP, src 10.0.2.15, dst 10.0.2.2
#   [44..52]  ICMP header      type 8, code 0, id 1, seq 1
#   [52..60]  ICMP payload     "pingqz!\0"
#
# Both the IPv4 header checksum (20 B) and the ICMP checksum (16 B
# covering header + payload) are computed after the buffer is laid
# out with 0x0000 placeholders in those fields.
def virtio_net_send_icmp_echo(): Void
  var buf = pmm_alloc_page()

  var j = 0
  while j < 64
    volatile_store<U8>(buf + j, 0)
    j = j + 1
  end

  # Ethernet: dst = SLIRP gateway MAC (learned via the ARP roundtrip
  # in 3a but hardcoded here), src = our MAC, type = IPv4.
  volatile_store<U8>(buf + 10, 0x52)
  volatile_store<U8>(buf + 11, 0x55)
  volatile_store<U8>(buf + 12, 0x0a)
  volatile_store<U8>(buf + 13, 0x00)
  volatile_store<U8>(buf + 14, 0x02)
  volatile_store<U8>(buf + 15, 0x02)
  volatile_store<U8>(buf + 16, 0x52)
  volatile_store<U8>(buf + 17, 0x54)
  volatile_store<U8>(buf + 18, 0x00)
  volatile_store<U8>(buf + 19, 0x12)
  volatile_store<U8>(buf + 20, 0x34)
  volatile_store<U8>(buf + 21, 0x56)
  volatile_store<U8>(buf + 22, 0x08)
  volatile_store<U8>(buf + 23, 0x00)

  # IPv4 header (20 bytes)
  volatile_store<U8>(buf + 24, 0x45)     # version=4, IHL=5
  volatile_store<U8>(buf + 25, 0x00)     # DSCP/ECN
  volatile_store<U8>(buf + 26, 0x00)
  volatile_store<U8>(buf + 27, 0x24)     # total length = 36
  volatile_store<U8>(buf + 28, 0x00)
  volatile_store<U8>(buf + 29, 0x00)     # ID
  volatile_store<U8>(buf + 30, 0x40)
  volatile_store<U8>(buf + 31, 0x00)     # flags=DF, frag=0
  volatile_store<U8>(buf + 32, 0x40)     # TTL = 64
  volatile_store<U8>(buf + 33, 0x01)     # protocol = ICMP
  # checksum placeholder at 34/35 (already zero)
  volatile_store<U8>(buf + 36, 0x0a)
  volatile_store<U8>(buf + 37, 0x00)
  volatile_store<U8>(buf + 38, 0x02)
  volatile_store<U8>(buf + 39, 0x0f)     # src 10.0.2.15
  volatile_store<U8>(buf + 40, 0x0a)
  volatile_store<U8>(buf + 41, 0x00)
  volatile_store<U8>(buf + 42, 0x02)
  volatile_store<U8>(buf + 43, 0x02)     # dst 10.0.2.2

  var ip_sum = ip_checksum(buf + 24, 20)
  volatile_store<U8>(buf + 34, (ip_sum >> 8) & 0xFF)
  volatile_store<U8>(buf + 35, ip_sum & 0xFF)

  # ICMP header (8 bytes)
  volatile_store<U8>(buf + 44, 0x08)     # type = 8 (echo request)
  volatile_store<U8>(buf + 45, 0x00)     # code = 0
  # checksum placeholder at 46/47 (already zero)
  volatile_store<U8>(buf + 48, 0x00)
  volatile_store<U8>(buf + 49, 0x01)     # identifier = 1
  volatile_store<U8>(buf + 50, 0x00)
  volatile_store<U8>(buf + 51, 0x01)     # sequence = 1

  # ICMP payload (8 bytes): "pingqz!\0"
  volatile_store<U8>(buf + 52, 112)  # 'p'
  volatile_store<U8>(buf + 53, 105)  # 'i'
  volatile_store<U8>(buf + 54, 110)  # 'n'
  volatile_store<U8>(buf + 55, 103)  # 'g'
  volatile_store<U8>(buf + 56, 113)  # 'q'
  volatile_store<U8>(buf + 57, 122)  # 'z'
  volatile_store<U8>(buf + 58, 33)   # '!'
  volatile_store<U8>(buf + 59, 0)    # NUL padding

  var icmp_sum = ip_checksum(buf + 44, 16)
  volatile_store<U8>(buf + 46, (icmp_sum >> 8) & 0xFF)
  volatile_store<U8>(buf + 47, icmp_sum & 0xFF)

  virtio_net_tx_send(buf, 60)
end

# Poll the used ring until the device completes our posted descriptor,
# or until we've spun enough to reasonably declare no frame coming.
# Returns the byte count the device wrote (including the 10-byte
# legacy virtio_net_hdr) or -1 on timeout.
#
# Used ring layout (at +4096 from queue base):
#   +0  u16 flags
#   +2  u16 idx       — incremented by device after each completion
#   +4  ring[N] × 8 bytes:
#     +0  u32 id      — descriptor index (matches what we put in avail)
#     +4  u32 len     — bytes written into the buffer
def virtio_net_rx_wait(): Int
  var spins = 0
  var max_spins = 20000000
  # used.idx is a 16-bit wrapping counter per virtio spec;
  # g_vnet_rx_consumed is a 64-bit monotonic counter. Mask to 16
  # bits so the "no new packet yet" condition remains correct after
  # the 65 536th RX frame (device's used.idx wraps to 0 there, which
  # looks like a fresh packet to the unmasked comparison and causes
  # us to re-process the oldest ring slot forever).
  var consumed_lo = g_vnet_rx_consumed & 0xFFFF
  var used_idx = volatile_load<U16>(g_vnet_used_addr + 2)
  while used_idx == consumed_lo
    if spins >= max_spins
      return 0 - 1
    end
    spins = spins + 1
    # DEF-E-N1 phase 5: yield to the scheduler every 256 spins so the
    # heartbeat + per-connection goroutines actually run while RX is
    # idle. Without this the polling loop hoards the CPU and every
    # goroutine starves until a packet arrives. sched_pump_step is a
    # no-op when the ready queue is empty, so the fast path (truly idle
    # kernel) still closes ~20 M spins in milliseconds.
    if (spins & 255) == 0
      sched_pump_step()
    end
    used_idx = volatile_load<U16>(g_vnet_used_addr + 2)
  end
  var slot = g_vnet_rx_consumed & (VIRTIO_NET_QSIZE - 1)
  var entry_addr = g_vnet_used_addr + 4 + (slot * 8)
  var len = volatile_load<U32>(entry_addr + 4)
  # Per-frame diagnostic — also provides a crucial few µs of pacing
  # that QEMU legacy virtio-net seems to need between polls (without
  # this the kernel runs ahead of real packet delivery and reads
  # slots that the device hasn't actually populated yet, producing
  # ghost completions with stale or partially-written length values).
  uart_put_str("[rx: u=")
  uart_put_uint(used_idx)
  uart_put_str(" c=")
  uart_put_uint(g_vnet_rx_consumed)
  uart_put_str(" len=")
  uart_put_uint(len)
  uart_put_str("]\n")
  g_vnet_rx_consumed = g_vnet_rx_consumed + 1
  return len
end

# Parse the next frame sitting in the RX buffer as Ethernet + IPv4 +
# ICMP and print a one-line "ping: reply from X.X.X.X seq=N" summary.
# Expects the frame to be at least the 10-byte virtio_net_hdr + 14 B
# ethernet + 20 B IPv4 + 8 B ICMP = 52 B; shorter frames fall back to
# a hex dump so the caller can debug them.
def virtio_net_parse_icmp_reply(buf_bytes: Int): Void
  var hdr_len = 10
  if buf_bytes < hdr_len + 42
    uart_put_str("ICMP: frame too short — raw dump follows\n")
    virtio_net_dump_frame(buf_bytes)
    return
  end
  var eth = g_vnet_rx_buf + hdr_len
  var ethertype_hi = volatile_load<U8>(eth + 12)
  var ethertype_lo = volatile_load<U8>(eth + 13)
  var ethertype = (ethertype_hi << 8) | ethertype_lo
  if ethertype != 0x0800
    uart_put_str("ICMP: expected IPv4 ethertype, got 0x")
    uart_put_hex2(ethertype_hi)
    uart_put_hex2(ethertype_lo)
    uart_putc(10)
    virtio_net_dump_frame(buf_bytes)
    return
  end
  var ip = eth + 14
  var proto = volatile_load<U8>(ip + 9)
  if proto != 1
    uart_put_str("ICMP: expected proto=1, got ")
    uart_put_uint(proto)
    uart_putc(10)
    virtio_net_dump_frame(buf_bytes)
    return
  end
  var src0 = volatile_load<U8>(ip + 12)
  var src1 = volatile_load<U8>(ip + 13)
  var src2 = volatile_load<U8>(ip + 14)
  var src3 = volatile_load<U8>(ip + 15)
  # IPv4 header length is low nibble of byte 0 in dwords.
  var ihl = volatile_load<U8>(ip + 0) & 0xF
  var icmp = ip + (ihl * 4)
  var icmp_type = volatile_load<U8>(icmp + 0)
  var seq_hi   = volatile_load<U8>(icmp + 6)
  var seq_lo   = volatile_load<U8>(icmp + 7)
  var seq = (seq_hi << 8) | seq_lo

  uart_put_str("ping: reply from ")
  uart_put_uint(src0)
  uart_putc(46)                  # '.'
  uart_put_uint(src1)
  uart_putc(46)
  uart_put_uint(src2)
  uart_putc(46)
  uart_put_uint(src3)
  uart_put_str(" type=")
  uart_put_uint(icmp_type)
  uart_put_str(" seq=")
  uart_put_uint(seq)
  uart_putc(10)
end

# --- Network byte-order helpers ---------------------------------
def read_be16(addr: Int, off: Int): Int
  var hi = volatile_load<U8>(addr + off)
  var lo = volatile_load<U8>(addr + off + 1)
  return (hi << 8) | lo
end

def read_be32(addr: Int, off: Int): Int
  var b0 = volatile_load<U8>(addr + off)
  var b1 = volatile_load<U8>(addr + off + 1)
  var b2 = volatile_load<U8>(addr + off + 2)
  var b3 = volatile_load<U8>(addr + off + 3)
  return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

def write_be16(addr: Int, off: Int, val: Int): Void
  volatile_store<U8>(addr + off,     (val >> 8) & 0xFF)
  volatile_store<U8>(addr + off + 1, val & 0xFF)
end

def write_be32(addr: Int, off: Int, val: Int): Void
  volatile_store<U8>(addr + off,     (val >> 24) & 0xFF)
  volatile_store<U8>(addr + off + 1, (val >> 16) & 0xFF)
  volatile_store<U8>(addr + off + 2, (val >> 8) & 0xFF)
  volatile_store<U8>(addr + off + 3, val & 0xFF)
end

# --- TCP helpers --------------------------------------------------

# Compute the TCP checksum over the standard 12-byte pseudo-header
# (src IP | dst IP | 0 | proto | tcp_len) plus the TCP segment itself
# (header + data). `ip_start` points at the IPv4 header in the buffer;
# `tcp_start` at the TCP header. `tcp_len` is the total TCP segment
# length (header + data). Caller must have zeroed the TCP checksum
# field at `tcp_start + 16..18` before calling.
def tcp_checksum(ip_start: Int, tcp_start: Int, tcp_len: Int): Int
  var sum = 0
  # Pseudo-header: src IP (4B), dst IP (4B)
  sum = sum + read_be16(ip_start, 12) + read_be16(ip_start, 14)
  sum = sum + read_be16(ip_start, 16) + read_be16(ip_start, 18)
  # 0 | proto 6 | tcp_len
  sum = sum + 0x0006
  sum = sum + tcp_len

  # TCP segment (header + data)
  var i = 0
  var limit = tcp_len - 1
  while i < limit
    sum = sum + read_be16(tcp_start, i)
    i = i + 2
  end
  if i < tcp_len
    sum = sum + (volatile_load<U8>(tcp_start + i) << 8)
  end

  while (sum >> 16) != 0
    sum = (sum & 0xFFFF) + (sum >> 16)
  end
  return (sum & 0xFFFF) ^ 0xFFFF
end

# Build and transmit a TCP segment to the peer represented by the
# conn table slot at `slot`. Peer MAC / IP / port are all read from
# the slot (per-connection state). `seq` and `ack` are host-byte-
# order sequence numbers; `flags` is the TCP flags byte. If
# `data_len > 0`, `data_buf` bytes are copied into the segment.
def tcp_send(slot: Int, seq: Int, ack: Int, flags: Int, data_buf: Int, data_len: Int): Void
  # Reuse the global TX scratch — virtio_net_tx_send blocks until the
  # device consumes the buffer, so one page is sufficient for the
  # lifetime of the server.
  var buf = g_tcp_tx_scratch

  # Zero the region we'll write (64 bytes of header + up to ~900 bytes
  # of payload; we're conservative because pmm_alloc_page doesn't zero).
  var j = 0
  var zlen = 64 + data_len
  while j < zlen
    volatile_store<U8>(buf + j, 0)
    j = j + 1
  end

  # Ethernet: dst=peer MAC (from slot), src=our MAC, type=IPv4
  volatile_store<U8>(buf + 10, volatile_load<U8>(slot + SLOT_PEER_MAC + 0))
  volatile_store<U8>(buf + 11, volatile_load<U8>(slot + SLOT_PEER_MAC + 1))
  volatile_store<U8>(buf + 12, volatile_load<U8>(slot + SLOT_PEER_MAC + 2))
  volatile_store<U8>(buf + 13, volatile_load<U8>(slot + SLOT_PEER_MAC + 3))
  volatile_store<U8>(buf + 14, volatile_load<U8>(slot + SLOT_PEER_MAC + 4))
  volatile_store<U8>(buf + 15, volatile_load<U8>(slot + SLOT_PEER_MAC + 5))
  volatile_store<U8>(buf + 16, 0x52)
  volatile_store<U8>(buf + 17, 0x54)
  volatile_store<U8>(buf + 18, 0x00)
  volatile_store<U8>(buf + 19, 0x12)
  volatile_store<U8>(buf + 20, 0x34)
  volatile_store<U8>(buf + 21, 0x56)
  volatile_store<U8>(buf + 22, 0x08)
  volatile_store<U8>(buf + 23, 0x00)

  # IPv4 (20 bytes)
  var ip = buf + 24
  var total_len_ip = 40 + data_len    # 20 IP + 20 TCP + data
  volatile_store<U8>(ip + 0, 0x45)    # ver=4, IHL=5
  write_be16(ip, 2, total_len_ip)
  volatile_store<U8>(ip + 6, 0x40)    # flags=DF
  volatile_store<U8>(ip + 8, 0x40)    # TTL=64
  volatile_store<U8>(ip + 9, 0x06)    # proto=TCP
  # src IP 10.0.2.15
  volatile_store<U8>(ip + 12, 0x0a)
  volatile_store<U8>(ip + 13, 0x00)
  volatile_store<U8>(ip + 14, 0x02)
  volatile_store<U8>(ip + 15, 0x0f)
  # dst IP = peer (from slot)
  volatile_store<U8>(ip + 16, volatile_load<U8>(slot + SLOT_PEER_IP + 0))
  volatile_store<U8>(ip + 17, volatile_load<U8>(slot + SLOT_PEER_IP + 1))
  volatile_store<U8>(ip + 18, volatile_load<U8>(slot + SLOT_PEER_IP + 2))
  volatile_store<U8>(ip + 19, volatile_load<U8>(slot + SLOT_PEER_IP + 3))
  write_be16(ip, 10, ip_checksum(ip, 20))

  # TCP (20 bytes)
  var tcp = buf + 44
  # Phase 8a step 3+4: src port is the slot's local_port (set by
  # tcp_accept_syn from the matching listening-table entry). Pre-step-3
  # this was a TCP_LISTEN_PORT hardcode that broke multi-port serving;
  # peer wouldn't match SYN+ACK from port 80 against its connection to
  # port 5559.
  write_be16(tcp, 0, conn_local_port(slot))   # src port (us, slot's bound port)
  write_be16(tcp, 2, conn_remote_port(slot))  # dst port (peer, from slot)
  write_be32(tcp, 4, seq)
  write_be32(tcp, 8, ack)
  volatile_store<U8>(tcp + 12, 0x50)        # data offset 5 (20 bytes)
  volatile_store<U8>(tcp + 13, flags)
  write_be16(tcp, 14, 4096)                 # window

  # Copy payload
  var k = 0
  while k < data_len
    volatile_store<U8>(tcp + 20 + k, volatile_load<U8>(data_buf + k))
    k = k + 1
  end

  write_be16(tcp, 16, tcp_checksum(ip, tcp, 20 + data_len))

  virtio_net_tx_send(buf, 10 + 14 + 20 + 20 + data_len)
end

# Write a fixed HTTP/1.1 200 OK response into `buf` (expected to be a
# freshly-allocated 4 KiB page). Returns the number of bytes written.
# `Connection: close` + the server sending FIN after the response is
# what signals end-of-body to the client (we don't bother computing
# Content-Length; the close-terminated framing works with curl, wget,
# and every browser since 1996).
# Copy a String literal into buf at off. Returns new offset. Avoids
# any heap allocation — no runtime string concatenation involved.
def buf_write_str(buf: Int, off: Int, s: String): Int
  var n = str_byte_len(s)
  var i = 0
  while i < n
    volatile_store<U8>(buf + off + i, str_byte_at(s, i))
    i = i + 1
  end
  return off + n
end

# Write a non-negative integer in base 10 into buf at off. Returns
# new offset. Mirrors uart_put_uint's scale-walk so the digits come
# out in the correct order without needing a scratch buffer.
def buf_write_dec(buf: Int, off: Int, n: Int): Int
  if n == 0
    volatile_store<U8>(buf + off, 48)   # '0'
    return off + 1
  end
  var scale = 1
  var probe = n
  while probe >= 10
    scale = scale * 10
    probe = probe / 10
  end
  var remaining = n
  var cur = off
  while scale > 0
    var digit = remaining / scale
    volatile_store<U8>(buf + cur, 48 + digit)
    remaining = remaining - (digit * scale)
    scale = scale / 10
    cur = cur + 1
  end
  return cur
end

# Write a single byte as two lowercase hex digits (no prefix).
def buf_write_hex2(buf: Int, off: Int, b: Int): Int
  var hi = (b >> 4) & 0xF
  var lo = b & 0xF
  var hi_ch = 48 + hi
  if hi >= 10
    hi_ch = 87 + hi   # 'a'..'f' = 97..102
  end
  var lo_ch = 48 + lo
  if lo >= 10
    lo_ch = 87 + lo
  end
  volatile_store<U8>(buf + off, hi_ch)
  volatile_store<U8>(buf + off + 1, lo_ch)
  return off + 2
end

# Shared landing-page chrome — head (with parametric title), nav,
# telemetry grid, scripts. Both `http_build_landing` (mattkelly.io /
# quartz.mattkelly.io) and `http_build_soul_landing` (soulofquartz.
# mattkelly.io) call these so theme/CSS/JS edits land in one place.
# Page-specific narrative is inlined per builder.
def http_build_landing_head(buf: Int, off: Int, title: String): Int
  off = buf_write_str(buf, off, "<!doctype html>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>")
  off = buf_write_str(buf, off, title)
  off = buf_write_str(buf, off, "</title>\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400..700&family=Geist:wght@400..800&display=swap\">\n<script>(function(){var t=(typeof localStorage!=='undefined'&&localStorage.getItem('theme'))||'tokyo-night';document.documentElement.setAttribute('data-theme',t)})()</script>\n")
  off = buf_write_str(buf, off, "<style>:root,[data-theme=\"tokyo-night\"]{--bg-rgb:26,27,38;--bg-color:#1a1b26;--surface-color:#24283b;--surface-hover:#2f334d;--text-color:#c0caf5;--text-muted:#565f89;--primary-color:#7aa2f7;--secondary-color:#bb9af7;--border-color:#414868;--code-bg:#1f2335}[data-theme=\"catppuccin\"]{--bg-rgb:30,30,46;--bg-color:#1e1e2e;--surface-color:#313244;--surface-hover:#45475a;--text-color:#cdd6f4;--text-muted:#a6adc8;--primary-color:#89b4fa;--secondary-color:#f5c2e7;--border-color:#585b70;--code-bg:#181825}[data-theme=\"rose-pine\"]{--bg-rgb:25,23,36;--bg-color:#191724;--surface-color:#1f1d2e;--surface-hover:#26233a;--text-color:#e0def4;--text-muted:#908caa;--primary-color:#31748f;--secondary-color:#ebbcba;--border-color:#44415a;--code-bg:#26233a}*{box-sizing:border-box}body{font:16px/1.55 'Geist',system-ui,-apple-system,sans-serif;background:var(--bg-color);color:var(--text-color);max-width:64rem;margin:0 auto;padding:0 1.2rem;transition:background-color .2s,color .2s}nav.site-nav{position:sticky;top:0;z-index:50;background:rgba(var(--bg-rgb),.8);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border-color);margin:0 0 2rem}.nav-inner{max-width:1100px;margin:0 auto;padding:.75rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}.nav-brand{font-weight:700;font-size:1.05rem;color:var(--text-color);text-decoration:none;border:none}.nav-brand:hover{color:var(--primary-color)}.nav-links{display:flex;align-items:center;gap:1.25rem}.nav-links a{color:var(--text-muted);font-weight:500;font-size:.95rem;text-decoration:none;border:none}.nav-links a:hover{color:var(--text-color)}.nav-links a.nav-quartz{color:var(--primary-color);border:1px solid var(--border-color);padding:.3rem .75rem;border-radius:8px}.nav-links a.nav-quartz:hover{background:var(--surface-hover);border-color:var(--primary-color)}.nav-quartz-dd{position:relative}.nav-quartz-menu{position:absolute;top:calc(100% + 8px);left:0;z-index:100;min-width:190px;padding:.4rem;background:var(--surface-color);border:1px solid var(--border-color);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.4);opacity:0;visibility:hidden;transform:translateY(-5px);transition:opacity .15s ease,transform .15s ease,visibility .15s}.nav-quartz-dd:hover .nav-quartz-menu,.nav-quartz-dd:focus-within .nav-quartz-menu{opacity:1;visibility:visible;transform:translateY(0)}.nav-quartz-menu a{display:block;padding:.45rem .7rem;border-radius:6px;color:var(--text-color);font-size:.9rem;font-weight:500;text-decoration:none;border:none}.nav-quartz-menu a:hover{background:var(--surface-hover);color:var(--primary-color)}.theme-switcher{position:relative}.theme-btn{display:flex;align-items:center;gap:.5rem;background:transparent;border:1px solid var(--border-color);color:var(--text-color);padding:.35rem .7rem;border-radius:8px;cursor:pointer;font:500 .9rem 'Geist',sans-serif;transition:background .2s,border-color .2s}.theme-btn:hover{background:var(--surface-hover);border-color:var(--primary-color)}.theme-btn .chevron{transition:transform .2s}.theme-btn[aria-expanded=\"true\"] .chevron{transform:rotate(180deg)}.theme-menu{position:absolute;top:calc(100% + 8px);right:0;margin:0;padding:.4rem;list-style:none;min-width:160px;z-index:100;background:var(--surface-color);border:1px solid var(--border-color);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.4)}.theme-menu[hidden]{display:none}.theme-option-btn{display:flex;align-items:center;gap:.6rem;width:100%;text-align:left;background:transparent;border:none;color:var(--text-color);padding:.45rem .7rem;border-radius:6px;cursor:pointer;font:.9rem 'Geist',sans-serif;transition:background .1s}.theme-option-btn:hover{background:var(--surface-hover);color:var(--primary-color)}.theme-menu li[aria-selected=\"true\"] .theme-option-btn{color:var(--primary-color);font-weight:600}.theme-swatch{width:12px;height:12px;border-radius:50%;border:1px solid var(--border-color);flex-shrink:0}h1{font-size:2rem;margin:0 0 .2em;letter-spacing:-.01em}h2{font-size:1.1rem;margin:2em 0 .6em;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;font-weight:600}.lead{color:var(--text-muted);margin:0 0 2em;font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.75rem}.card{background:var(--surface-color);padding:1rem 1.1rem;border-radius:.55em;border:1px solid var(--border-color)}.lbl{color:var(--text-muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;font-weight:600}.val{font:600 1.55rem 'Geist Mono',ui-monospace,monospace;color:var(--primary-color);font-variant-numeric:tabular-nums;margin-top:.2em;line-height:1.2}.sub{color:var(--text-muted);font-size:.75rem;font-family:'Geist Mono',ui-monospace,monospace;margin-top:.3em}pre,code{font:14px 'Geist Mono',ui-monospace,monospace;background:var(--code-bg);color:var(--primary-color);padding:.1em .4em;border-radius:.3em}pre{padding:.8em 1em;overflow-x:auto;line-height:1.45;border:1px solid var(--border-color)}p{color:var(--text-color)}a{color:var(--primary-color);text-decoration:none;transition:color .15s}a:hover{color:var(--secondary-color)}small{color:var(--text-muted)}@media(max-width:700px){.nav-links{gap:.85rem}.nav-links a:not(.nav-quartz){display:none}}</style>\n")
  return off
end

# Top nav — mirrors the Astro Header component. All DNS-backed
# experiences use absolute subdomain URLs so the address bar matches
# the content; in-unikernel routes (Playground, Docs) stay relative.
# JS in `http_build_landing_scripts` marks the link for the current
# hostname as `.cur` after page load.
def http_build_landing_nav(buf: Int, off: Int): Int
  off = buf_write_str(buf, off, "<nav class=\"site-nav\"><div class=\"nav-inner\"><a href=\"https://mattkelly.io/\" class=\"nav-brand\">Matt&nbsp;Kelly</a><div class=\"nav-links\"><a href=\"https://mattkelly.io/projects\">Projects</a><a href=\"https://mattkelly.io/blog/\">Blog</a><a href=\"https://mattkelly.io/cv\">CV</a><div class=\"nav-quartz-dd\"><a href=\"https://mattkelly.io/quartz\" class=\"nav-quartz\">Quartz ▾</a><div class=\"nav-quartz-menu\" role=\"menu\"><a href=\"https://mattkelly.io/quartz\">Overview</a><a href=\"https://mattkelly.io/quartz/docs/getting_started\">Docs</a><a href=\"https://mattkelly.io/quartz/playground\">Playground</a><a href=\"https://mattkelly.io/quartz/chip8\">CHIP-8 Emulator</a><a href=\"https://soulofquartz.mattkelly.io/\">Soul of Quartz ↗</a></div></div><div class=\"theme-switcher\"><button id=\"theme-toggle\" class=\"theme-btn\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42\"/></svg><span id=\"current-theme-label\">Theme</span><svg class=\"chevron\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg></button><ul id=\"theme-menu\" class=\"theme-menu\" role=\"listbox\" hidden><li role=\"option\" data-theme-value=\"tokyo-night\" aria-selected=\"false\"><button class=\"theme-option-btn\" type=\"button\"><span class=\"theme-swatch\" style=\"background:#7aa2f7\"></span><span>Tokyo Night</span></button></li><li role=\"option\" data-theme-value=\"catppuccin\" aria-selected=\"false\"><button class=\"theme-option-btn\" type=\"button\"><span class=\"theme-swatch\" style=\"background:#89b4fa\"></span><span>Catppuccin</span></button></li><li role=\"option\" data-theme-value=\"rose-pine\" aria-selected=\"false\"><button class=\"theme-option-btn\" type=\"button\"><span class=\"theme-swatch\" style=\"background:#31748f\"></span><span>Rosé Pine</span></button></li></ul></div></div></div></nav>\n")
  return off
end

# Live telemetry grid — server-side initial values + JS polling.
# Identical content on both unikernel and soul landings; both pages
# prove the same thing ("this kernel is alive"). After SOUL.4 ships,
# the soul page replaces this with the htop-equivalent view; for now
# both share the 11-card grid.
def http_build_landing_telemetry(buf: Int, off: Int): Int
  off = buf_write_str(buf, off, "<h2>Live kernel telemetry</h2>\n<div class=\"grid\">\n")

  # Card 1 — scheduler ticks.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Ticks</div><div class=\"val\" id=\"t\">")
  off = buf_write_dec(buf, off, g_tick_count)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">LAPIC @ 100 Hz</div></div>\n")

  # Card 1b — guest (unikernel) uptime. Derived from g_tick_count / 100
  # since the LAPIC fires at 100 Hz. Distinct from the host-VPS uptime
  # card below — the guest cycles every 45 min via systemd RuntimeMaxSec,
  # the host hasn't rebooted in weeks. Initial server-side render is just
  # the raw seconds; JS replaces with fmtDur on first /api/stats.json
  # fetch.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Unikernel uptime</div><div class=\"val\" id=\"gu\">")
  off = buf_write_dec(buf, off, g_tick_count / 100)
  off = buf_write_str(buf, off, "s</div><div class=\"sub\">cycles every 45 min</div></div>\n")

  # Card 2 — total connections served since boot.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Served</div><div class=\"val\" id=\"c\">")
  off = buf_write_dec(buf, off, g_tcp_connections)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">connections since boot</div></div>\n")

  # Card 2b — active connections right now.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Active</div><div class=\"val\" id=\"a\">")
  off = buf_write_dec(buf, off, tcp_active_conns())
  off = buf_write_str(buf, off, "</div><div class=\"sub\" id=\"as\">of ")
  off = buf_write_dec(buf, off, CONN_SLOTS)
  off = buf_write_str(buf, off, " slots</div></div>\n")

  # Card 3 — PMM.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">PMM</div><div class=\"val\" id=\"p\">")
  off = buf_write_dec(buf, off, pmm_used_bytes() / 1024)
  off = buf_write_str(buf, off, "</div><div class=\"sub\" id=\"ps\">KiB of ")
  off = buf_write_dec(buf, off, pmm_total_bytes() / (1024 * 1024))
  off = buf_write_str(buf, off, " MiB pool</div></div>\n")

  # Card 3a — Detected RAM (SOUL.2). Total system RAM the kernel
  # discovered from the PVH memmap at boot. Server-rendered only —
  # the value never changes after boot, so no JS polling.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Detected RAM</div><div class=\"val\">")
  off = buf_write_dec(buf, off, get_detected_ram_bytes() / (1024 * 1024))
  off = buf_write_str(buf, off, "</div><div class=\"sub\">MiB from PVH mmap at boot</div></div>\n")

  # Cards 5a/5b/5c — HOST VPS telemetry (from the Caddy-side
  # /api/host.json, which is refreshed every 10 s by a systemd timer
  # scraping /proc on the Linux host). These show the cost-of-serving
  # from outside the guest — CPU % is the QEMU process itself plus
  # Caddy's TLS termination; RAM is everything on the 8 GB VPS; uptime
  # is the host, not the guest (guest cycles every 45 min via
  # RuntimeMaxSec — see .scratch/DEPLOYMENT.md). Initial values render
  # as em-dashes; JS replaces them on first /api/host.json fetch.
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Host VPS uptime</div><div class=\"val\" id=\"hu\">&mdash;</div><div class=\"sub\">Linux host, since last reboot</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Host CPU</div><div class=\"val\" id=\"hc\">&mdash;</div><div class=\"sub\" id=\"hcs\">% across cores</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Host RAM</div><div class=\"val\" id=\"hm\">&mdash;</div><div class=\"sub\" id=\"hms\">used / total</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Load avg</div><div class=\"val\" id=\"hl\" style=\"font-size:1.05rem\">&mdash;</div><div class=\"sub\">1 / 5 / 15 min</div></div>\n")

  off = buf_write_str(buf, off, "</div>\n")
  return off
end

# Inline JS — fetch loop + theme switcher. Polls /api/stats.json (500 ms),
# /api/host.json (2 s), /api/recent.json (500 ms). Same script on both
# unikernel and soul landings; an SSE-driven push variant for the soul
# page is filed for SOUL.4.
def http_build_landing_scripts(buf: Int, off: Int): Int
  off = buf_write_str(buf, off, "<script>\nlet $=i=>document.getElementById(i);\nfunction fmtDur(s){if(s<60)return s+'s';let d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);if(d>0)return d+'d '+h+'h '+m+'m';if(h>0)return h+'h '+m+'m';return m+'m'}\nfunction fmtMB(mb){if(mb<1024)return mb.toFixed(0)+' MB';return (mb/1024).toFixed(1)+' GB'}\nasync function fs(){try{let r=await fetch('/api/stats.json',{cache:'no-store'});if(!r.ok)return;let s=await r.json();$('t').textContent=s.ticks.toLocaleString();$('gu').textContent=fmtDur(Math.floor(s.ticks/100));$('c').textContent=s.connections_served.toLocaleString();$('a').textContent=s.connections_active;$('as').textContent='of '+s.connections_max+' slots';$('p').textContent=(s.pmm_bytes_used/1024).toFixed(0);$('ps').textContent='KiB of '+(s.pmm_bytes_total/1048576).toFixed(0)+' MiB pool'}catch(e){}}\nasync function fh(){try{let r=await fetch('/api/host.json',{cache:'no-store'});if(!r.ok)return;let h=await r.json();$('hu').textContent=fmtDur(h.uptime_sec);$('hc').textContent=h.cpu_pct+'%';$('hcs').textContent='across '+h.ncpus+' cores';$('hm').textContent=fmtMB(h.mem_used_mb);$('hms').textContent='of '+fmtMB(h.mem_total_mb);$('hl').textContent=h.load1.toFixed(2)+' / '+h.load5.toFixed(2)+' / '+h.load15.toFixed(2)}catch(e){}}\nasync function fr(){try{let r=await fetch('/api/recent.json',{cache:'no-store'});if(!r.ok)return;let j=await r.json();let feed=$('feed');if(!j.items||!j.items.length){feed.innerHTML='<div class=\"empty\">waiting for first request&hellip;</div>';return}let near=feed.scrollHeight-feed.scrollTop-feed.clientHeight<20;let html='';for(let it of j.items){let c='st';if(it.status>=400)c+=' s4';else if(it.status>=300)c+=' s3';html+='<div class=\"row\"><span class=\"tick\">'+it.tick.toLocaleString()+'</span><span class=\"'+c+'\">'+it.status+'</span><span class=\"pth\">'+it.path.replace(/[&<>]/g,s=>({'&':'&amp;','<':'&lt;','>':'&gt;'})[s])+'</span></div>';}feed.innerHTML=html;if(near)feed.scrollTop=feed.scrollHeight}catch(e){}}\nlet tNames={'tokyo-night':'Tokyo Night','catppuccin':'Catppuccin','rose-pine':'Rosé Pine'};\nfunction tUpd(){let t=document.documentElement.getAttribute('data-theme')||'tokyo-night';let lbl=$('current-theme-label');if(lbl)lbl.textContent=tNames[t]||t;document.querySelectorAll('#theme-menu li').forEach(li=>li.setAttribute('aria-selected',li.dataset.themeValue===t?'true':'false'))}\nfunction tClose(){let m=$('theme-menu'),b=$('theme-toggle');if(m){m.hidden=true;m.classList.remove('animate-in')}if(b)b.setAttribute('aria-expanded','false')}\nfunction tSet(t){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('theme',t)}catch(e){}tUpd();tClose()}\n$('theme-toggle').addEventListener('click',e=>{e.stopPropagation();let m=$('theme-menu'),b=$('theme-toggle');if(m.hidden){m.hidden=false;m.classList.add('animate-in');b.setAttribute('aria-expanded','true')}else{tClose()}});\ndocument.querySelectorAll('#theme-menu li').forEach(li=>li.querySelector('button').addEventListener('click',()=>tSet(li.dataset.themeValue)));\ndocument.addEventListener('click',e=>{if(!e.target.closest('.theme-switcher'))tClose()});\ntUpd();fs();fh();fr();setInterval(fs,500);setInterval(fh,2000);setInterval(fr,500);\n</script>\n")
  return off
end

# Landing page — styled dark-mode unikernel demo. Initial
# counter values are rendered server-side so the page is useful
# even with JavaScript disabled; a fetch() loop against
# /api/stats.json then updates the numbers every 500 ms.
#
# Zero-alloc assembly via buf_write_* helpers. No #{} interpolation
# anywhere in the hot path. Response is multi-segmented on the wire
# (see tcp_handle_ipv4) so the page can exceed one Ethernet MTU.
def http_build_landing(buf: Int): Int
  var off = 0

  # Status line + response headers.
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\n\r\n")

  off = http_build_landing_head(buf, off, "Quartz unikernel")
  off = http_build_landing_nav(buf, off)

  # Hero.
  off = buf_write_str(buf, off, "<h1>Quartz unikernel</h1>\n<p class=\"lead\">You're looking at a webpage served by a tiny virtual machine that runs nothing else. No Linux inside. No nginx. No OpenSSL. The kernel, the network stack, the webserver, and the cryptography were all written from scratch in <a href=\"https://git.sr.ht/~mathisto/Quartz\">Quartz</a> &mdash; a programming language whose compiler is also written in Quartz.</p>\n")

  off = http_build_landing_telemetry(buf, off)

  # Live request feed. Shows the ring buffer of recent paths
  # served by this kernel — fed by /api/recent.json (64-slot
  # ring, newest last). Gives the visitor a visceral sense of
  # "other people are landing on this kernel right now."
  off = buf_write_str(buf, off, "<style>.feed{background:var(--code-bg);padding:.9rem 1.1rem;border-radius:.55em;border:1px solid var(--border-color);max-height:18rem;overflow-y:auto;font:13px 'Geist Mono',ui-monospace,monospace}.feed .row{display:flex;gap:.7rem;align-items:baseline;padding:.15rem 0;border-bottom:1px dotted var(--border-color)}.feed .row:last-child{border-bottom:none}.feed .tick{color:var(--text-muted);font-variant-numeric:tabular-nums;min-width:4.5rem;text-align:right}.feed .st{color:var(--primary-color);min-width:2.5rem;font-weight:600}.feed .st.s4{color:#f66}.feed .st.s3{color:#fb6}.feed .pth{color:var(--text-color);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.feed .empty{color:var(--text-muted);font-style:italic;padding:.3em 0}</style>\n<h2>Live request feed</h2>\n<p class=\"lead\" style=\"font-size:.9rem;margin:0 0 .8em\">Last 64 paths served, oldest first. Auto-refreshes every 500&nbsp;ms. You'll see your own request land at the bottom &mdash; and anyone else's, in real time.</p>\n<div class=\"feed\" id=\"feed\"><div class=\"empty\">waiting for first request&hellip;</div></div>\n")

  # Latest milestone — WireGuard / native crypto. Lead with the most
  # recent achievement; surface the unikernel's WG public key inline as
  # tangible proof. The pubkey is 32 bytes; we render as 64 lowercase
  # hex chars in a code block. Defensive against pre-init reads (empty
  # fallback if g_wg_initialized == 0).
  off = buf_write_str(buf, off, "<h2>Latest: a VPN, written end-to-end in Quartz</h2>\n<p>The newest piece of this stack is <a href=\"https://www.wireguard.com/\">WireGuard</a>, the modern VPN protocol. The whole thing &mdash; the Curve25519 elliptic-curve math, the ChaCha20-Poly1305 authenticated encryption, the BLAKE2s hashing, the HKDF key derivation, the Noise handshake &mdash; is now implemented in Quartz. Zero C dependencies. Zero FFI. The kernel running this page generates its own keypair on boot, and it interoperates handshake-clean against <code>wireguard-go</code>, the canonical reference implementation.</p>\n<p>Here's this kernel's WireGuard public key, generated the moment it booted:</p>\n<pre style=\"font-size:.85rem;word-break:break-all;line-height:1.4\">")
  if g_wg_initialized == 1
    var pkv = wg_device_static_pub(g_wg_device)
    var pi = 0
    while pi < 32
      off = buf_write_hex2(buf, off, volatile_load<U8>(pkv + pi))
      pi = pi + 1
    end
  end
  off = buf_write_str(buf, off, "</pre>\n<p style=\"color:var(--text-muted);font-size:.88rem\">It rotates every 45 minutes when the guest cycles. Same string is exposed at <a href=\"/api/stats.json\"><code>/api/stats.json</code></a> as <code>wg_pubkey</code>.</p>\n")

  # How this works — short, plain, no jargon.
  off = buf_write_str(buf, off, "<h2>How this works</h2>\n<p>Programming languages are usually written in <em>other</em> programming languages &mdash; C, mostly. Quartz is its own. The compiler that turns Quartz code into a binary is itself a Quartz binary. The kernel running this page is a Quartz binary. The Ethernet driver, the TCP stack, the HTTP server, the WireGuard crypto &mdash; all Quartz code. The HTML you're reading was assembled by Quartz code stitching strings into a buffer and writing the buffer to a TCP socket the same Quartz code opened.</p>\n<p>The whole thing is a closed loop: Quartz writes the language that writes the OS that writes the webpage that explains what Quartz is.</p>\n<p>The only thing inside this VM that <em>isn't</em> Quartz is QEMU's emulation of the virtio-net network card. Everything else &mdash; from the first byte of the Ethernet frame through the last byte of this HTML &mdash; came from one codebase, in one language.</p>\n")

  # Explore — links, tighter than the prior version.
  off = buf_write_str(buf, off, "<h2>Explore</h2>\n<ul class=\"plain\">\n<li>&bull; <a href=\"https://mattkelly.io/\">Quartz landing page</a> &mdash; what the language is</li>\n<li>&bull; <a href=\"https://chip8.mattkelly.io/\">CHIP-8 emulator</a> &mdash; Quartz compiled to WebAssembly, running in your browser</li>\n<li>&bull; <a href=\"/docs\">Documentation</a></li>\n<li>&bull; <a href=\"https://git.sr.ht/~mathisto/Quartz\">Source on sourcehut</a> &mdash; the kernel for this page is at <code>tools/baremetal/hello_x86.qz</code></li>\n</ul>\n")

  off = http_build_landing_scripts(buf, off)

  return off
end

# Soul of Quartz landing — companion to http_build_landing, served
# when the request's Host header starts with "soulofquartz". Same
# kernel ELF, same listener; different story:
#   - unikernel.mattkelly.io   →  "look how minimal"  (7 MB ELF)
#   - soulofquartz.mattkelly.io →  "look how it scales" (5M tasks)
#
# Today is v0/preview — shared chrome (head/nav/telemetry/scripts)
# plus a soul-specific hero, phase-status board, and the BEAM-pitch
# narrative. SOUL.4 replaces the static telemetry grid here with the
# htop view; SOUL.5 adds spawn-N buttons; SOUL.6 adds structured-
# concurrency micro-demos. Multi-session roadmap is in
# `docs/SOUL_OF_QUARTZ.md`.
#
# Named after Saša Jurić's "The Soul of Erlang and Elixir" (GOTO 2019,
# sasa1977/soul_of_erlang_and_elixir on GitHub).
def http_build_soul_landing(buf: Int): Int
  var off = 0

  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\n\r\n")

  off = http_build_landing_head(buf, off, "Soul of Quartz")
  off = http_build_landing_nav(buf, off)

  # Hero — emphasize scale + the BEAM-equivalence pitch. Different
  # narrative from the unikernel landing's "look how minimal" framing.
  off = buf_write_str(buf, off, "<h1>Soul of Quartz</h1>\n<p class=\"lead\">A live look at how <a href=\"https://git.sr.ht/~mathisto/Quartz\">Quartz</a> handles tens of thousands of things happening at once. Click any button below to spawn that many tiny independent tasks &mdash; watch the grid light up as they wake, work, and finish, then drain back to baseline within seconds. Inspired by Saša Jurić's <a href=\"https://github.com/sasa1977/soul_of_erlang_and_elixir\">\"The Soul of Erlang and Elixir\"</a>, rebuilt from scratch.</p>\n")

  # SOUL.4 — Live scheduler-state grid. Server-rendered initial values,
  # then the inline script at page bottom polls /api/soul/stats.json
  # at 500 ms cadence. Counter card IDs sl_* are read by fsoul() in
  # the soul-specific script appended after http_build_landing_scripts.
  off = buf_write_str(buf, off, "<h2>Live scheduler state</h2>\n")
  off = buf_write_str(buf, off, "<div style=\"display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:0 0 1.2em\"><button class=\"sb\" onclick=\"fsp(100)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 100</button><button class=\"sb\" onclick=\"fsp(1000)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 1k</button><button class=\"sb\" onclick=\"fsp(10000)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 10k</button><button class=\"sb\" onclick=\"fsp(30000)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 30k</button><button class=\"sb\" onclick=\"fsp(100000)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 100k</button><button class=\"sb\" onclick=\"fsp(500000)\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--text-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Spawn 500k</button><span style=\"width:.6rem\"></span><button class=\"sb\" onclick=\"fcancel()\" style=\"background:var(--surface-color);border:1px solid var(--border-color);color:var(--secondary-color);padding:.5rem 1rem;border-radius:.4em;cursor:pointer;font:600 .9rem 'Geist Mono',ui-monospace,monospace\">Cancel All</button><span id=\"sp_msg\" style=\"color:var(--text-muted);font-size:.85rem;font-family:'Geist Mono',ui-monospace,monospace\"></span></div>\n")
  off = buf_write_str(buf, off, "<div class=\"grid\">\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Live tasks</div><div class=\"val\" id=\"sl_alive\">")
  off = buf_write_dec(buf, off, g_task_alive)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">running + ready + dead-pending</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">High-water</div><div class=\"val\" id=\"sl_alive_max\">")
  off = buf_write_dec(buf, off, g_task_alive_max)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">max concurrent since boot</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Spawned</div><div class=\"val\" id=\"sl_spawn\">")
  off = buf_write_dec(buf, off, g_task_spawn_total)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">total since boot</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Exited</div><div class=\"val\" id=\"sl_exit\">")
  off = buf_write_dec(buf, off, g_task_exit_total)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">total <code>task_exit()</code> calls</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Ready queue</div><div class=\"val\" id=\"sl_ready\">")
  off = buf_write_dec(buf, off, sched_total_ready())
  off = buf_write_str(buf, off, "</div><div class=\"sub\">awaiting CPU</div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"card\"><div class=\"lbl\">Pool capacity</div><div class=\"val\" id=\"sl_cap\">")
  off = buf_write_dec(buf, off, NUM_TASKS)
  off = buf_write_str(buf, off, "</div><div class=\"sub\">today; ratchets up for SOUL.5</div></div>\n")
  off = buf_write_str(buf, off, "</div>\n")

  # SOUL.5 v3 — state-grid + stacked aggregate bar. The 4096-row table
  # at v2 broke at scale (4096 rows is unreadable as a list). The
  # grid view is one cell per slot in a 64x64 layout; the stacked bar
  # above shows the same population as a single-line proportion. The
  # row table moves into a `<details>` drill-down for the 1% case
  # ("show me specific IDs"). All three are populated by fsoul_grid()
  # off /api/soul/tasks.json (one fetch per tick — grid + counts +
  # cap-20 row array all in the same response).
  off = buf_write_str(buf, off, "<style>.sbar{display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--surface-color);border:1px solid var(--border-color);margin:0 0 .6em}.sbar>.seg{transition:width .3s ease;min-width:0;height:100%}.seg.r{background:var(--primary-color)}.seg.x{background:#7cba78}.seg.b{background:#e0af68}.seg.d{background:#f7768e;opacity:.55}.slegend{display:flex;flex-wrap:wrap;gap:.7rem;font:12px 'Geist Mono',ui-monospace,monospace;color:var(--text-muted);margin:0 0 1em}.slegend>span{display:inline-flex;align-items:center;gap:.35rem}.slegend i{display:inline-block;width:10px;height:10px;border-radius:2px}.slegend i.r{background:var(--primary-color)}.slegend i.x{background:#7cba78}.slegend i.b{background:#e0af68}.slegend i.d{background:#f7768e}.slegend i.f{background:var(--surface-color);border:1px solid var(--border-color)}.cgrid{display:grid;grid-template-columns:repeat(32,1fr);gap:2px;max-width:100%;margin:0 0 .8em}.c{aspect-ratio:1;min-width:0;background:var(--surface-color);border-radius:1px;transition:background .15s ease}.c.r{background:var(--primary-color)}.c.x{background:#7cba78}.c.b{background:#e0af68}.c.d{background:#f7768e;opacity:.55}.tdrill{margin:.4em 0 0}.tdrill summary{cursor:pointer;color:var(--text-muted);font:600 .75rem 'Geist Mono',ui-monospace,monospace;text-transform:uppercase;letter-spacing:.06em;padding:.3rem 0;list-style:none}.tdrill summary::-webkit-details-marker{display:none}.tdrill summary::before{content:\"\\25b8 \"}.tdrill[open] summary::before{content:\"\\25be \"}.tdrill[open] summary{color:var(--primary-color)}.tdrill table{width:100%;border-collapse:collapse;font:13px 'Geist Mono',ui-monospace,monospace;margin:.4rem 0 0}.tdrill th{text-align:left;padding:.3rem .8rem .3rem 0;color:var(--text-muted);text-transform:uppercase;font-size:.7rem;letter-spacing:.06em;border-bottom:1px solid var(--border-color)}.tdrill td{padding:.2rem 0}.tdrill td.id{color:var(--primary-color);width:5rem}.cpulanes{display:flex;flex-direction:column;gap:.35rem;margin:0 0 1em}.cpurow{display:grid;grid-template-columns:5.5rem 1fr 9rem;align-items:center;gap:.6rem;font:12px 'Geist Mono',ui-monospace,monospace}.cpulbl{color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;font-weight:600}.cputrack{position:relative;height:14px;border-radius:7px;background:var(--surface-color);border:1px solid var(--border-color);overflow:hidden}.cpufill{position:absolute;left:0;top:0;height:100%;transition:width .35s ease;background:var(--primary-color)}.cpufill.c1{background:#7cba78}.cpufill.c2{background:#e0af68}.cpufill.c3{background:#bb9af7}.cpufill.c4{background:#f7768e}.cpufill.c5{background:#7dcfff}.cpufill.c6{background:#9ece6a}.cpufill.c7{background:#ff9e64}.cpunum{color:var(--text-muted);text-align:right}.cpunum strong{color:var(--text-color);font-weight:600}</style>\n")
  off = buf_write_str(buf, off, "<h2>Pool state</h2>\n")
  off = buf_write_str(buf, off, "<div class=\"sbar\" id=\"sl_sbar\"><div class=\"seg r\" id=\"sl_seg_r\" style=\"width:0%\"></div><div class=\"seg x\" id=\"sl_seg_x\" style=\"width:0%\"></div><div class=\"seg b\" id=\"sl_seg_b\" style=\"width:0%\"></div><div class=\"seg d\" id=\"sl_seg_d\" style=\"width:0%\"></div></div>\n")
  off = buf_write_str(buf, off, "<div class=\"slegend\"><span><i class=\"r\"></i><span id=\"sl_lr\">0</span> ready</span><span><i class=\"x\"></i><span id=\"sl_lx\">0</span> running</span><span><i class=\"b\"></i><span id=\"sl_lb\">0</span> blocked</span><span><i class=\"d\"></i><span id=\"sl_ld\">0</span> dead</span><span><i class=\"f\"></i><span id=\"sl_lf\">524288</span> free</span></div>\n")

  # K8.9 / SOUL.5 v5 — per-CPU lane visualization. One row per CPU
  # showing the heartbeat-rate (deltas/sec) as a horizontal bar
  # normalized against the busiest CPU. Live evidence that work is
  # being distributed across cores. Sourced from /api/soul/stats.json
  # cpus[] array; populated by fsoul_cpus() in the inline script
  # below.
  off = buf_write_str(buf, off, "<div id=\"sl_cpus\" class=\"cpulanes\" aria-label=\"per-CPU sched-tick rate lanes\" style=\"margin:1em 0\"></div>\n")

  off = buf_write_str(buf, off, "<div id=\"sl_grid\" class=\"cgrid\" aria-label=\"task pool state grid (one cell per slot)\"></div>\n")

  # Live telemetry — same grid as the unikernel landing. Proves
  # "same kernel, different story": the unikernel page also surfaces
  # these counters; the soul page surfaces the scheduler-specific
  # telemetry above and shares the kernel-level grid here.
  off = http_build_landing_telemetry(buf, off)

  off = http_build_landing_scripts(buf, off)

  # SOUL.4 + SOUL.5 — soul-specific poll loops + spawn-N click handler.
  # fsoul() polls /api/soul/stats.json for the aggregate-counter cards;
  # fsoul_tasks() polls /api/soul/tasks.json for the htop table tbody;
  # fsp(n) hits /api/soul/spawn?n=N and triggers an immediate refresh
  # so users see the spawn land without waiting for the 500 ms tick.
  off = buf_write_str(buf, off, "<script>\nlet _slcpu_prev=null,_slcpu_t_prev=0;\nasync function fsoul(){try{let r=await fetch('/api/soul/stats.json',{cache:'no-store'});if(!r.ok)return;let s=await r.json();let t=s.tasks;document.getElementById('sl_alive').textContent=t.alive.toLocaleString();document.getElementById('sl_alive_max').textContent=t.alive_max.toLocaleString();document.getElementById('sl_spawn').textContent=t.spawn_total.toLocaleString();document.getElementById('sl_exit').textContent=t.exit_total.toLocaleString();document.getElementById('sl_ready').textContent=t.ready;document.getElementById('sl_cap').textContent=t.max_capacity;let cpus=s.cpus||[];let now=Date.now();let dt=(_slcpu_t_prev>0)?(now-_slcpu_t_prev)/1000:0;let rates=cpus.map((c,i)=>{let p=_slcpu_prev?_slcpu_prev[i]:null;return(p&&dt>0)?Math.max(0,(c.heartbeat-p.heartbeat)/dt):0});let peak=Math.max(1,...rates);let cel=document.getElementById('sl_cpus');if(cel){let html='';for(let i=0;i<cpus.length;i++){let pct=Math.min(100,(rates[i]/peak)*100);let cls='cpufill c'+(i%8);html+='<div class=\"cpurow\"><div class=\"cpulbl\">CPU '+i+'</div><div class=\"cputrack\"><div class=\"'+cls+'\" style=\"width:'+pct.toFixed(1)+'%\"></div></div><div class=\"cpunum\"><strong>'+Math.round(rates[i]).toLocaleString()+'</strong>/s &middot; ready '+(cpus[i].ready||0)+'</div></div>'}cel.innerHTML=html}_slcpu_prev=cpus;_slcpu_t_prev=now}catch(e){}}\nlet _slprev='',_slcells=null,_slLastN=0;const _slcls={F:'c',R:'c r',X:'c x',B:'c b',D:'c d'};\nasync function fsoul_grid(){try{let r=await fetch('/api/soul/tasks.json',{cache:'no-store'});if(!r.ok)return;let s=await r.json();_slLastN=s.alive||0;let g=s.grid||'';let n=g.length;let gel=document.getElementById('sl_grid');if(gel&&(!_slcells||_slcells.length!==n)){gel.innerHTML='<span class=\"c\"></span>'.repeat(n);_slcells=gel.children;_slprev=''}if(_slcells&&_slcells.length===n){for(let i=0;i<n;i++){if(g[i]!==_slprev[i]){_slcells[i].className=_slcls[g[i]]||'c'}}}_slprev=g;let cap=s.capacity||1;let c=s.counts||{};let pct=k=>(((c[k]||0)*100)/cap)+'%';let setW=(id,k)=>{let e=document.getElementById(id);if(e)e.style.width=pct(k)};setW('sl_seg_r','ready');setW('sl_seg_x','running');setW('sl_seg_b','blocked');setW('sl_seg_d','dead');let setL=(id,k)=>{let e=document.getElementById(id);if(e)e.textContent=(c[k]||0).toLocaleString()};setL('sl_lr','ready');setL('sl_lx','running');setL('sl_lb','blocked');setL('sl_ld','dead');setL('sl_lf','free');let tbody=document.getElementById('sl_tasks_tbody');if(tbody){if(!s.tasks||!s.tasks.length){tbody.innerHTML='<tr><td colspan=\"3\" style=\"padding:.5rem 0;color:var(--text-muted);font-style:italic\">no active tasks</td></tr>'}else{let html='';for(let t of s.tasks){html+='<tr><td class=\"id\">'+t.id+'</td><td>'+t.state+'</td><td>'+(t.cpu===undefined?'-':t.cpu)+'</td></tr>'}tbody.innerHTML=html}}let more=document.getElementById('sl_tasks_more');if(more){if(s.alive>s.emitted){more.textContent='showing '+s.emitted+' of '+s.alive.toLocaleString()+' active tasks ('+(s.alive-s.emitted).toLocaleString()+' more not rendered)'}else{more.textContent=''}}}catch(e){}}\nasync function fsp(n){try{let r=await fetch('/api/soul/spawn?n='+n,{cache:'no-store'});if(!r.ok){document.getElementById('sp_msg').textContent='request failed ('+r.status+')';return}let s=await r.json();let msg=document.getElementById('sp_msg');if(s.spawned===s.requested){msg.textContent='spawned '+s.spawned.toLocaleString()+' — '+s.alive_after.toLocaleString()+'/'+s.capacity.toLocaleString()+' alive'}else if(s.spawned>0){msg.textContent='spawned '+s.spawned.toLocaleString()+' (pool at max — '+s.alive_after.toLocaleString()+'/'+s.capacity.toLocaleString()+')'}else{msg.textContent='pool at max — '+s.alive_after.toLocaleString()+'/'+s.capacity.toLocaleString()+' alive; wait for tasks to drain'}fsoul();fsoul_grid()}catch(e){document.getElementById('sp_msg').textContent='error: '+e.message}}\nasync function fcancel(){try{let r=await fetch('/api/soul/cancel',{cache:'no-store'});if(!r.ok){document.getElementById('sp_msg').textContent='cancel request failed ('+r.status+')';return}let s=await r.json();document.getElementById('sp_msg').textContent='cancel signalled — '+s.alive_before.toLocaleString()+' tasks notified (gen #'+s.cancel_gen+')';fsoul();fsoul_grid();setTimeout(()=>{fsoul();fsoul_grid()},250);setTimeout(()=>{fsoul();fsoul_grid()},800)}catch(e){document.getElementById('sp_msg').textContent='cancel error: '+e.message}}\nfsoul();fsoul_grid();setInterval(fsoul,500);function _slGridLoop(){fsoul_grid().finally(()=>{let d=_slLastN>5000?2000:(_slLastN>1000?1000:500);setTimeout(_slGridLoop,d)})}setTimeout(_slGridLoop,500);\nasync function fdemo_deadline(){let el=document.getElementById('demo_deadline_result');el.innerHTML='<span style=\"color:var(--text-muted)\">running...</span>';try{let r=await fetch('/api/soul/demo/deadline',{cache:'no-store'});if(!r.ok){el.textContent='request failed ('+r.status+')';return}let s=await r.json();if(s.error){el.textContent='error: '+s.error+' ('+s.alive+'/'+s.capacity+' alive)';return}let drifts=s.drifts_ns||[];let maxD=s.max_drift_ns||1;let minD=s.min_drift_ns||0;let bars='';for(let i=0;i<drifts.length;i++){let d=drifts[i];let pct=Math.max(.5,(d/maxD)*100);let us=(d/1000).toFixed(0);bars+='<div style=\"display:flex;align-items:center;gap:.4em;margin:.15em 0\"><div style=\"width:1.4em;color:var(--text-muted);font-size:.75rem;text-align:right\">c'+i+'</div><div style=\"flex:1;background:var(--bg-alt);height:.8em;border-radius:2px;position:relative\"><div style=\"width:'+pct.toFixed(1)+'%;height:100%;background:var(--accent);border-radius:2px\"></div></div><div style=\"width:5em;font-size:.75rem;color:var(--text-muted);text-align:right\">+'+us+'&micro;s</div></div>'}let hdr='<div style=\"margin-bottom:.4em\"><strong>'+s.completed+'/'+s.spawned+'</strong> unwound &middot; spread <strong>'+((maxD-minD)/1000).toFixed(0)+'&micro;s</strong> &middot; max drift <strong>'+(maxD/1000).toFixed(0)+'&micro;s</strong> past 200 ms deadline</div>';el.innerHTML=hdr+bars}catch(e){el.textContent='error: '+e.message}}\nasync function fdemo_cascade(n){let el=document.getElementById('demo_cascade_result');el.innerHTML='<span style=\"color:var(--text-muted)\">spawning '+n.toLocaleString()+' + signalling...</span>';try{let r=await fetch('/api/soul/demo/cascade?n='+n,{cache:'no-store'});if(!r.ok){el.textContent='request failed ('+r.status+')';return}let s=await r.json();if(s.error){el.textContent='error: '+s.error;return}let firstUs=(s.signal_to_first_ns/1000).toFixed(0);let lastUs=(s.signal_to_last_ns/1000).toFixed(0);let lastMs=(s.signal_to_last_ns/1000000).toFixed(2);let pctUnder1=Math.round((s.under_1ms*100)/Math.max(1,s.completed));let pctUnder10=Math.round((s.under_10ms*100)/Math.max(1,s.completed));el.innerHTML='<div><strong>'+s.completed.toLocaleString()+'/'+s.spawned.toLocaleString()+'</strong> tasks unwound after signal</div><div style=\"margin-top:.3em\">first noticed in <strong>'+firstUs+'&micro;s</strong>, last in <strong>'+lastMs+'&nbsp;ms</strong> ('+lastUs+'&micro;s)</div><div style=\"margin-top:.3em\">under 1&nbsp;ms: <strong>'+s.under_1ms.toLocaleString()+'</strong> ('+pctUnder1+'%) &middot; under 10&nbsp;ms: <strong>'+s.under_10ms.toLocaleString()+'</strong> ('+pctUnder10+'%)</div><div style=\"margin-top:.5em;background:var(--bg-alt);height:.6em;border-radius:2px;position:relative;overflow:hidden\"><div style=\"width:'+pctUnder1+'%;height:100%;background:var(--accent);position:absolute;left:0\"></div><div style=\"width:'+(pctUnder10-pctUnder1)+'%;height:100%;background:var(--accent);opacity:.5;position:absolute;left:'+pctUnder1+'%\"></div></div>'}catch(e){el.textContent='error: '+e.message}}\nasync function fdemo_race(){let el=document.getElementById('demo_race_result');el.innerHTML='<span style=\"color:var(--text-muted)\">racing...</span>';try{let r=await fetch('/api/soul/demo/race',{cache:'no-store'});if(!r.ok){el.textContent='request failed ('+r.status+')';return}let s=await r.json();if(s.error){el.textContent='error: '+s.error;return}let racers=s.racers||[];let maxMs=Math.max(1,...racers.map(x=>x.scheduled_ms));let bars='';for(let r2 of racers){let pct=Math.max(.5,(r2.scheduled_ms/maxMs)*100);let bg=r2.won?'var(--accent)':'var(--text-muted)';let op=r2.won?'1':'.4';let label=r2.won?'WIN':'lost';bars+='<div style=\"display:flex;align-items:center;gap:.4em;margin:.15em 0\"><div style=\"width:1.4em;color:var(--text-muted);font-size:.75rem;text-align:right\">r'+r2.id+'</div><div style=\"flex:1;background:var(--bg-alt);height:.8em;border-radius:2px;position:relative\"><div style=\"width:'+pct.toFixed(1)+'%;height:100%;background:'+bg+';opacity:'+op+';border-radius:2px\"></div></div><div style=\"width:6em;font-size:.75rem;color:var(--text-muted);text-align:right\">'+r2.scheduled_ms+'&nbsp;ms &middot; '+label+'</div></div>'}let hdr='<div style=\"margin-bottom:.4em\">winner: <strong>r'+s.winner_id+'</strong> at <strong>'+s.winner_finish_ms+'&nbsp;ms</strong> &middot; '+s.completed+'/'+s.spawned+' completed</div>';el.innerHTML=hdr+bars}catch(e){el.textContent='error: '+e.message}}\nasync function fdemo_restart(){let el=document.getElementById('demo_restart_result');el.innerHTML='<span style=\"color:var(--text-muted)\">running supervisor...</span>';try{let r=await fetch('/api/soul/demo/restart',{cache:'no-store'});if(!r.ok){el.textContent='request failed ('+r.status+')';return}let s=await r.json();if(s.error){el.textContent='error: '+s.error;return}let evs=s.events||[];const cls={spawn:'var(--text-muted)',exit:'#e06c75',restart:'#e5c07b',success:'var(--accent)'};let rows='';for(let ev of evs){let c=cls[ev.kind]||'var(--text-muted)';rows+='<div style=\"display:flex;align-items:center;gap:.4em;margin:.1em 0\"><div style=\"width:4em;font-size:.75rem;color:var(--text-muted);text-align:right\">+'+ev.t_ms+'&nbsp;ms</div><div style=\"width:.6em;height:.6em;border-radius:50%;background:'+c+'\"></div><div style=\"font-size:.75rem;color:'+c+'\"><strong>'+ev.kind+'</strong></div><div style=\"font-size:.75rem;color:var(--text-muted)\">attempt '+ev.attempt+'</div></div>'}let banner=s.success?'<strong style=\"color:var(--accent)\">survived on attempt '+s.attempts+'</strong> &middot; '+s.total_ms+'&nbsp;ms total':'<strong style=\"color:#e06c75\">gave up after '+s.attempts+' attempts</strong>';el.innerHTML='<div style=\"margin-bottom:.4em\">'+banner+'</div>'+rows}catch(e){el.textContent='error: '+e.message}}\n</script>\n")

  return off
end

# =============================================================================
# Supervised HTTP router (port 80)
# =============================================================================
#
# `kernel_router_handler` is the `Fn(Request): Response` callback passed to
# `http_serve_supervised(http_server_config(80), kernel_router_handler)`
# from `supervised_server_body`. 14 routes: landing pages, JSON endpoints,
# soul demo endpoints, baked assets with 304 short-circuit, 404 catch-all.
#
# Approach for dynamic routes: alloc 32 KiB scratch, call `http_build_X(buf)`
# (which writes a full HTTP/1.1 response — status line + headers + body),
# slice past `\r\n\r\n`, wrap the body suffix as a `String` via
# `cstr_to_string` (lowers to `@qz_wrap_cstr`), free the scratch, return
# html/json `Response`. Wire-format re-serialization is owned by
# `_async_http_write_response_timeout`.
#
# Approach for baked assets: zero-copy `bytes_response(mime, body_ptr,
# body_len)` directly off the PMM-resident asset region — the supervised
# writer emits headers then streams body bytes via a second send. ETag is
# attached as an extra header for cache validators; If-None-Match matches
# short-circuit to 304 Not Modified with the same ETag header.

# Find the "\r\n\r\n" header/body separator in a freshly-built HTTP
# response. Returns the offset of the first body byte, or -1 if absent.
def _slice_find_body_off(raw: Int, total: Int): Int
  var i = 0
  while i + 3 < total
    if volatile_load<U8>(raw + i) == 13
      if volatile_load<U8>(raw + i + 1) == 10
        if volatile_load<U8>(raw + i + 2) == 13
          if volatile_load<U8>(raw + i + 3) == 10
            return i + 4
          end
        end
      end
    end
    i = i + 1
  end
  return -1
end

# Slice the body out of a scratch-built HTTP response and wrap it as a
# Quartz `String`. Frees `raw`. `kind`: 0=html, 1=json. Called after
# every `http_build_X(buf)` invocation in `kernel_router_handler` so the
# supervised writer re-emits status line + headers.
def _build_body_only(raw: Int, total: Int, kind: Int): Response
  if raw == 0
    return text_response("alloc failed")
  end
  var body_off = _slice_find_body_off(raw, total)
  if body_off < 0
    mem_free(raw)
    return text_response("malformed response: no header separator")
  end
  # NUL-terminate after the last body byte so `qz_wrap_cstr`'s @strlen
  # stops at the right place. All builders emit pure ASCII (HTML / JSON).
  volatile_store<U8>(raw + total, 0)
  var body = cstr_to_string(int_to_cptr(raw + body_off))
  mem_free(raw)
  if kind == 1
    return json_response(body)
  end
  return html_response(body)
end

# Byte-level path equality. Avoids `String.eq` (which lowers through
# `@qz_str_get_len` — not in the freestanding-reachable set yet) by
# using only `str_byte_at` and `str_byte_len`, both verified safe via
# `_parse_request_from_buffer`.
def _path_eq(p: String, expected: String): Int
  var pl = str_byte_len(p)
  var el = str_byte_len(expected)
  if pl != el
    return 0
  end
  var i = 0
  while i < pl
    if str_byte_at(p, i) != str_byte_at(expected, i)
      return 0
    end
    i = i + 1
  end
  return 1
end

# Wrap a NUL-terminated byte region as a Quartz `String`. Copies into a
# fresh allocation since `cstr_to_string` requires a trailing NUL —
# callers without one allocate a +1 buffer first.
def _bytes_to_string(src: Int, len: Int): String
  var buf = mem_alloc(len + 1)
  if buf == 0
    return ""
  end
  var i = 0
  while i < len
    volatile_store<U8>(buf + i, volatile_load<U8>(src + i))
    i = i + 1
  end
  volatile_store<U8>(buf + len, 0)
  var s = cstr_to_string(int_to_cptr(buf))
  mem_free(buf)
  return s
end

# Linear scan of the asset table by parsed path `String`. Returns entry
# index or -1. Parallel to the legacy `asset_lookup` which compares
# against raw request bytes; this version consumes the supervised
# parser's `req.path` (no "GET " prefix, no HTTP/1.1 suffix).
def asset_lookup_by_path(path: String): Int
  var plen = str_byte_len(path)
  var i = 0
  while i < g_asset_count
    var entry = g_asset_table + (i * ASSET_ENTRY_SIZE)
    var ap_ptr = volatile_load<U64>(entry + 0)
    var ap_len = volatile_load<U64>(entry + 8)
    if ap_len == plen
      var k = 0
      var eq = 1
      while k < plen
        if volatile_load<U8>(ap_ptr + k) != str_byte_at(path, k)
          eq = 0
          k = plen
        end
        k = k + 1
      end
      if eq == 1
        return i
      end
    end
    i = i + 1
  end
  return -1
end

# Conditional GET: compare the parsed `If-None-Match` header value
# against the 16-hex-digit etag at `etag_ptr`. Returns 1 on match
# (caller emits 304 Not Modified), 0 otherwise. Strong validators only,
# single etag, quoted (`"<16hex>"`). Weak (`W/"..."`) or comma-separated
# lists fall through as mismatches.
def asset_if_none_match_str(req: Request, etag_ptr: Int): Int
  var n = req.header_keys.size
  var i = 0
  while i < n
    if str_eq_ignore_case(req.header_keys[i], "If-None-Match") == 1
      var v = req.header_vals[i]
      var vlen = str_byte_len(v)
      if vlen >= ETAG_HEX_LEN + 2
        if str_byte_at(v, 0) == 34
          if str_byte_at(v, ETAG_HEX_LEN + 1) == 34
            var k = 0
            var eq = 1
            while k < ETAG_HEX_LEN
              if str_byte_at(v, 1 + k) != volatile_load<U8>(etag_ptr + k)
                eq = 0
                k = ETAG_HEX_LEN
              end
              k = k + 1
            end
            if eq == 1
              return 1
            end
          end
        end
      end
      return 0
    end
    i = i + 1
  end
  return 0
end

# Wrap a 16-hex-byte etag at `etag_ptr` as a quoted ETag header value
# (`"<16hex>"`, 18 bytes). Used by both 200-asset and 304 responses.
def _etag_quoted(etag_ptr: Int): String
  var buf = mem_alloc(ETAG_HEX_LEN + 3)
  if buf == 0
    return ""
  end
  volatile_store<U8>(buf + 0, 34)
  var e = 0
  while e < ETAG_HEX_LEN
    volatile_store<U8>(buf + 1 + e, volatile_load<U8>(etag_ptr + e))
    e = e + 1
  end
  volatile_store<U8>(buf + 1 + ETAG_HEX_LEN, 34)
  volatile_store<U8>(buf + 2 + ETAG_HEX_LEN, 0)
  var s = cstr_to_string(int_to_cptr(buf))
  mem_free(buf)
  return s
end

# Build a zero-copy 200 OK Response for a baked asset. The body region
# is PMM-resident and stable for the kernel's lifetime; `bytes_response`
# records (ptr, len) and the supervised writer streams the bytes via a
# second send without copying through a `String`. Mime is wrapped from
# the PMM mime region (not NUL-terminated) into a fresh `String`.
def _build_asset_response(idx: Int): Response
  var entry = g_asset_table + (idx * ASSET_ENTRY_SIZE)
  var mime_ptr = volatile_load<U64>(entry + 16)
  var mime_len = volatile_load<U64>(entry + 24)
  var body_ptr = volatile_load<U64>(entry + 32)
  var body_len = volatile_load<U64>(entry + 40)
  var etag_ptr = volatile_load<U64>(entry + 48)

  var mime = _bytes_to_string(mime_ptr, mime_len)
  var etag = _etag_quoted(etag_ptr)
  var resp = bytes_response(mime, body_ptr, body_len)
  resp = response_header(resp, "ETag", etag)
  resp = response_header(resp, "Cache-Control", "public, max-age=60")
  return resp
end

# 304 Not Modified — empty body + matching ETag. The supervised
# serializer emits status line + Content-Type + Content-Length: 0 +
# extra headers; clients re-validate from cache against the ETag.
def _build_304_response(etag_ptr: Int): Response
  var etag = _etag_quoted(etag_ptr)
  var resp = text_response("")
  resp.status = 304
  resp = response_header(resp, "ETag", etag)
  resp = response_header(resp, "Cache-Control", "public, max-age=60")
  return resp
end

# Parse `n=<int>` from `req.query`. Returns -1 if absent/unparseable;
# `/api/soul/spawn` coerces missing to 0 at the callsite, while
# `cascade` / `race` pass the raw -1 through and interpret it as "use
# the route default".
def _query_n(req: Request): Int
  var result = -1
  match req.query.get("n")
    Some(v) => {
      result = v.to_i()
    }
    None => {}
    _ => {}
  end
  return result
end

# Case-sensitive prefix match of the `Host:` header. Routes the `/`
# request: `soulofquartz` → soul landing, anything else (including
# `mattkelly.io` / `quartz.mattkelly.io`) → unikernel landing.
def _host_starts_with(req: Request, prefix: String): Int
  var n = req.header_keys.size
  var i = 0
  while i < n
    if str_eq_ignore_case(req.header_keys[i], "Host") == 1
      var v = req.header_vals[i]
      var plen = str_byte_len(prefix)
      var vlen = str_byte_len(v)
      if vlen < plen
        return 0
      end
      var k = 0
      while k < plen
        if str_byte_at(v, k) != str_byte_at(prefix, k)
          return 0
        end
        k = k + 1
      end
      return 1
    end
    i = i + 1
  end
  return 0
end

# 14-route dispatcher for the supervised HTTP server. Order matters:
# explicit dynamic routes first, then asset table, then 404 catch-all.
# Each dynamic route allocates a 32 KiB scratch, calls the corresponding
# `http_build_X(buf)` builder, then slices past the response headers via
# `_build_body_only`. Asset responses are zero-copy and skip the scratch
# path entirely. The 304 short-circuit on `If-None-Match` preserves the
# conditional-GET cache validator contract.
def _kernel_router_dispatch(req: Request): Response
  # 64 KiB scratch. The soul landing emits ~38 KB of HTML+inline JS;
  # at 32 KiB the writers silently overflowed past the malloc'd region
  # into adjacent slab pages, which the concurrent supervised spawn
  # (Phase 8b.2.c) was actively churning. Symptom on the browser side
  # was `Uncaught SyntaxError: Invalid or unexpected token` mid-script
  # (the inline JS got truncated/corrupted) and buttons became inert.
  # 64 KiB covers every current route with comfortable headroom; the
  # multi-page bump path in libc_stubs.c rounds to whole pages so 65536
  # = 16 pages exactly. Filed forward: a bounded `buf_write_str` (or a
  # StringBuilder-shaped builder) so future page growth doesn't reach
  # the same silent-overflow rake.
  var bufsize = 65536

  # Route 1 — /  (host=soulofquartz* → soul landing, else → unikernel landing)
  if _path_eq(req.path, "/") == 1
    if _host_starts_with(req, "soulofquartz") == 1
      var raw = mem_alloc(bufsize)
      var total = http_build_soul_landing(raw)
      return _build_body_only(raw, total, 0)
    end
    var raw2 = mem_alloc(bufsize)
    var total2 = http_build_landing(raw2)
    return _build_body_only(raw2, total2, 0)
  end

  # Route 2 — /api/stats.json
  if _path_eq(req.path, "/api/stats.json") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_stats_json(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 3 — /api/soul/stats.json
  if _path_eq(req.path, "/api/soul/stats.json") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_stats_json(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 4 — /api/soul/tasks.json
  if _path_eq(req.path, "/api/soul/tasks.json") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_tasks_json(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 5 — /api/soul/spawn?n=N
  if _path_eq(req.path, "/api/soul/spawn") == 1
    var n = _query_n(req)
    if n < 0
      n = 0
    end
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_spawn(raw, n)
    return _build_body_only(raw, total, 1)
  end

  # Route 6 — /api/soul/cancel
  if _path_eq(req.path, "/api/soul/cancel") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_cancel(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 7 — /api/soul/demo/deadline
  if _path_eq(req.path, "/api/soul/demo/deadline") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_demo_deadline(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 8 — /api/soul/demo/cascade?n=N  (-1 means use route default)
  if _path_eq(req.path, "/api/soul/demo/cascade") == 1
    var cn = _query_n(req)
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_demo_cascade(raw, cn)
    return _build_body_only(raw, total, 1)
  end

  # Route 9 — /api/soul/demo/race?n=N  (-1 means use route default)
  if _path_eq(req.path, "/api/soul/demo/race") == 1
    var rn = _query_n(req)
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_demo_race(raw, rn)
    return _build_body_only(raw, total, 1)
  end

  # Route 10 — /api/soul/demo/restart
  if _path_eq(req.path, "/api/soul/demo/restart") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_soul_demo_restart(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 11 — /api/recent.json
  if _path_eq(req.path, "/api/recent.json") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_recent_json(raw)
    return _build_body_only(raw, total, 1)
  end

  # Route 12 — /health
  if _path_eq(req.path, "/health") == 1
    var raw = mem_alloc(bufsize)
    var total = http_build_health(raw)
    return _build_body_only(raw, total, 0)
  end

  # Route 13 — baked-asset lookup with 304 Not Modified short-circuit
  var idx = asset_lookup_by_path(req.path)
  if idx >= 0
    var entry = g_asset_table + (idx * ASSET_ENTRY_SIZE)
    var etag_ptr = volatile_load<U64>(entry + 48)
    if asset_if_none_match_str(req, etag_ptr) == 1
      return _build_304_response(etag_ptr)
    end
    return _build_asset_response(idx)
  end

  # Route 14 — 404 catch-all (styled HTML, same theme as the landings)
  var raw = mem_alloc(bufsize)
  var total = http_build_404(raw)
  var resp = _build_body_only(raw, total, 0)
  resp.status = 404
  return resp
end

# Wrapper that dispatches the request and then logs (path, status) into
# the recent-requests ring buffer. Splitting record-from-dispatch keeps
# the dispatcher free of early-return bookkeeping.
def kernel_router_handler(req: Request): Response
  var resp = _kernel_router_dispatch(req)
  _record_supervised_request(req.path, resp.status)
  return resp
end

# Copy the request path into a temp byte buffer and feed it to
# recent_record. recent_record copies the bytes into the ring; the
# scratch is freed at return.
def _record_supervised_request(path: String, status: Int): Void
  var plen = str_byte_len(path)
  if plen <= 0
    return
  end
  if plen > 256
    plen = 256
  end
  var buf = mem_alloc(plen)
  if buf == 0
    return
  end
  var i = 0
  while i < plen
    volatile_store<U8>(buf + i, str_byte_at(path, i))
    i = i + 1
  end
  recent_record(buf, plen, status)
  mem_free(buf)
end

# Log effect handler for the supervised server. Routes stdlib `log::info`
# / `log::warn` / `log::error` emits to UART. Without this, http_server's
# startup info message (`log::info("Listening on port ...")`) trips the
# kernel's `__qz_eff_unhandled_halt` because no Log handler is installed
# at the goroutine entry. D.11 Phase 8b / step 3.
#
# Uses the low-level `(op_name, argc, argv): Int` handler shape that the
# freestanding effect-perform bridge expects (per `std/log.qz:24-27` —
# "Decode the message via as_string(load(argv, 0))"). The high-level
# `(s: String): Int` shape only works on hosted where the compiler
# auto-decodes; freestanding passes the raw argv triple. `op_name`
# carries the operation tag ("emit") which we ignore — Log only has
# the one op — and argv[0] is the prefixed message String.
def kernel_log_emit(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  uart_put_str(msg)
  uart_putc(10)
  return 0
end

# Goroutine entry — calls `http_serve_supervised` on port 80. The
# supervised entry blocks for the lifetime of the server. Spawned from
# `main` via `go_fn(supervised_server_body)`. Installs a Log handler so
# the stdlib server's `log::info` calls route to UART (otherwise the
# `Log` effect is unhandled and the kernel halts on first emit).
def supervised_server_body(): Int
  var rc = 0
  with Log { emit: kernel_log_emit } do ->
    rc = http_serve_supervised(http_server_config(TCP_LISTEN_PORT), kernel_router_handler)
  end
  uart_put_str("[supervised] http_serve_supervised returned rc=")
  uart_put_uint(rc)
  uart_putc(10)
  return rc
end

# GET /api/stats.json — machine-readable live counters. Suitable for
# a fetch() poll loop in the browser. Fields mirror the landing page
# items, plus a version marker so future schema evolution is visible.
def http_build_stats_json(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  off = buf_write_str(buf, off, "{\"version\":1,\"ticks\":")
  off = buf_write_dec(buf, off, g_tick_count)
  off = buf_write_str(buf, off, ",\"connections_served\":")
  off = buf_write_dec(buf, off, g_tcp_connections)
  off = buf_write_str(buf, off, ",\"connections_active\":")
  off = buf_write_dec(buf, off, tcp_active_conns())
  off = buf_write_str(buf, off, ",\"connections_max\":")
  off = buf_write_dec(buf, off, CONN_SLOTS)
  off = buf_write_str(buf, off, ",\"pmm_pages_used\":")
  off = buf_write_dec(buf, off, pmm_used_pages())
  off = buf_write_str(buf, off, ",\"pmm_pages_total\":")
  off = buf_write_dec(buf, off, pmm_total_pages())
  off = buf_write_str(buf, off, ",\"pmm_bytes_used\":")
  off = buf_write_dec(buf, off, pmm_used_bytes())
  off = buf_write_str(buf, off, ",\"pmm_bytes_total\":")
  off = buf_write_dec(buf, off, pmm_total_bytes())
  off = buf_write_str(buf, off, ",\"tx_stalls\":")
  off = buf_write_dec(buf, off, g_tx_stalls)
  off = buf_write_str(buf, off, ",\"tx_retransmits\":")
  off = buf_write_dec(buf, off, g_tx_retransmits)
  off = buf_write_str(buf, off, ",\"tx_bytes_pending\":")
  off = buf_write_dec(buf, off, g_tx_bytes_pending)
  off = buf_write_str(buf, off, ",\"goroutine_heartbeat\":")
  off = buf_write_dec(buf, off, g_goroutine_heartbeat)
  off = buf_write_str(buf, off, ",\"goroutines_alive\":")
  off = buf_write_dec(buf, off, g_task_alive)
  off = buf_write_str(buf, off, ",\"conn_goroutine_spawn_total\":")
  off = buf_write_dec(buf, off, g_conn_goroutine_spawn_total)
  off = buf_write_str(buf, off, ",\"assets\":")
  off = buf_write_dec(buf, off, g_asset_count)
  off = buf_write_str(buf, off, ",\"assets_bytes\":")
  off = buf_write_dec(buf, off, asset_total_bytes())
  # Per-class slab counters (six classes: 16/32/64/128/256/512 B). Each
  # entry is {size, allocs, frees, refills, in_use}. Live observable
  # memory behavior of the slab tier of the kernel allocator.
  off = buf_write_str(buf, off, ",\"slab_classes\":[")
  var sci = 0
  while sci < 6
    if sci > 0
      off = buf_write_str(buf, off, ",")
    end
    off = buf_write_str(buf, off, "{\"size\":")
    off = buf_write_dec(buf, off, slab_class_stat(sci, 0))
    off = buf_write_str(buf, off, ",\"allocs\":")
    off = buf_write_dec(buf, off, slab_class_stat(sci, 1))
    off = buf_write_str(buf, off, ",\"frees\":")
    off = buf_write_dec(buf, off, slab_class_stat(sci, 2))
    off = buf_write_str(buf, off, ",\"refills\":")
    off = buf_write_dec(buf, off, slab_class_stat(sci, 3))
    off = buf_write_str(buf, off, ",\"in_use\":")
    off = buf_write_dec(buf, off, slab_class_stat(sci, 4))
    off = buf_write_str(buf, off, "}")
    sci = sci + 1
  end
  off = buf_write_str(buf, off, "]")
  # Multi-page bump allocator telemetry — surfaces the leak/recycle
  # rate so a sustained gap between `allocs` and `recycles+frees` is
  # observable in /api/stats.json.
  off = buf_write_str(buf, off, ",\"multipage\":{\"allocs\":")
  off = buf_write_dec(buf, off, libc_multipage_stat(0))
  off = buf_write_str(buf, off, ",\"frees\":")
  off = buf_write_dec(buf, off, libc_multipage_stat(1))
  off = buf_write_str(buf, off, ",\"refills\":")
  off = buf_write_dec(buf, off, libc_multipage_stat(2))
  off = buf_write_str(buf, off, ",\"recycles\":")
  off = buf_write_dec(buf, off, libc_multipage_stat(3))
  off = buf_write_str(buf, off, ",\"multi_refills\":")
  off = buf_write_dec(buf, off, libc_multipage_stat(4))
  off = buf_write_str(buf, off, ",\"arena\":{\"begins\":")
  off = buf_write_dec(buf, off, libc_arena_stat(0))
  off = buf_write_str(buf, off, ",\"ends\":")
  off = buf_write_dec(buf, off, libc_arena_stat(1))
  off = buf_write_str(buf, off, ",\"released\":")
  off = buf_write_dec(buf, off, libc_arena_stat(2))
  off = buf_write_str(buf, off, ",\"slab_tracked\":")
  off = buf_write_dec(buf, off, libc_arena_stat(4))
  off = buf_write_str(buf, off, ",\"slab_released\":")
  off = buf_write_dec(buf, off, libc_arena_stat(5))
  off = buf_write_str(buf, off, ",\"slab_chain_pages\":")
  off = buf_write_dec(buf, off, libc_arena_stat(6))
  off = buf_write_str(buf, off, "}}")
  off = buf_write_str(buf, off, ",\"mac\":\"")
  off = buf_write_hex2(buf, off, g_vnet_mac0)
  off = buf_write_str(buf, off, ":")
  off = buf_write_hex2(buf, off, g_vnet_mac1)
  off = buf_write_str(buf, off, ":")
  off = buf_write_hex2(buf, off, g_vnet_mac2)
  off = buf_write_str(buf, off, ":")
  off = buf_write_hex2(buf, off, g_vnet_mac3)
  off = buf_write_str(buf, off, ":")
  off = buf_write_hex2(buf, off, g_vnet_mac4)
  off = buf_write_str(buf, off, ":")
  off = buf_write_hex2(buf, off, g_vnet_mac5)
  off = buf_write_str(buf, off, "\"")
  # WireGuard static public key (32 bytes → 64 hex chars). Empty string
  # if WG hasn't initialized yet (boot race; shouldn't happen post-net-up
  # but stays defensive). Publicly observable proof that the unikernel
  # has the native-Quartz crypto stack baked in — no FFI, no HACL.
  off = buf_write_str(buf, off, ",\"wg_pubkey\":\"")
  if g_wg_initialized == 1
    var pk = wg_device_static_pub(g_wg_device)
    var i = 0
    while i < 32
      off = buf_write_hex2(buf, off, volatile_load<U8>(pk + i))
      i = i + 1
    end
  end
  off = buf_write_str(buf, off, "\"")
  # SOUL.2: total system RAM detected from the PVH memmap at boot.
  # Static after boot; the dashboard server-renders the matching
  # card so this field is mainly for external scrapers / future
  # Soul-page widgets.
  off = buf_write_str(buf, off, ",\"detected_ram_bytes\":")
  off = buf_write_dec(buf, off, get_detected_ram_bytes())
  off = buf_write_str(buf, off, "}\n")
  return off
end

# GET /api/soul/stats.json — soul-of-quartz scheduler-state snapshot.
# Companion to /api/stats.json: keeps that endpoint stable for the
# unikernel landing while letting the soul page evolve its own shape.
# The soul page polls both endpoints (shared chrome telemetry off
# /api/stats.json, soul-specific counters off this one).
#
# Today's surface is SOUL.4 v1: aggregate task lifecycle counters
# (live, max-concurrent, spawn-total, exit-total, ready-queue depth,
# pool capacity). Per-task table data — required for the htop-
# equivalent view — needs scheduler iterator support and ships in
# a SOUL.4 follow-on alongside SOUL.5's spawn-N demo.
def http_build_soul_stats_json(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  off = buf_write_str(buf, off, "{\"version\":1,\"ticks\":")
  off = buf_write_dec(buf, off, g_tick_count)
  off = buf_write_str(buf, off, ",\"tasks\":{\"alive\":")
  off = buf_write_dec(buf, off, g_task_alive)
  off = buf_write_str(buf, off, ",\"alive_max\":")
  off = buf_write_dec(buf, off, g_task_alive_max)
  off = buf_write_str(buf, off, ",\"spawn_total\":")
  off = buf_write_dec(buf, off, g_task_spawn_total)
  off = buf_write_str(buf, off, ",\"exit_total\":")
  off = buf_write_dec(buf, off, g_task_exit_total)
  off = buf_write_str(buf, off, ",\"ready\":")
  off = buf_write_dec(buf, off, sched_total_ready())
  off = buf_write_str(buf, off, ",\"max_capacity\":")
  off = buf_write_dec(buf, off, NUM_TASKS)
  # Path B (2026-05-29) — thin pool split for soul demo bodies. Both
  # are subsets of the combined `alive` / `max_capacity` above; the
  # split lets the dashboard show "spawned X demo / Y thin available"
  # without mixing in the fat pool (HTTP + effects) which stays
  # reserved for traffic.
  off = buf_write_str(buf, off, ",\"alive_thin\":")
  off = buf_write_dec(buf, off, g_task_alive_thin)
  off = buf_write_str(buf, off, ",\"max_capacity_thin\":")
  off = buf_write_dec(buf, off, NUM_TASKS_THIN)
  off = buf_write_str(buf, off, "}")
  # Path C.5.2 — saved-stack allocator telemetry (replaces the C.1 pool
  # counters). `saved_live` is the count of parked-frame buffers currently
  # held; `saved_live_max` is its high-water mark. The thesis of copying
  # stacks is that the BYTES behind these — `pmm_bytes` — stay tiny relative
  # to capacity (a parked demo body ≈ 192 B), so `pmm_bytes` ≪ NUM_TASKS ×
  # 16 KiB is the proof that stack memory is decoupled from capacity. There
  # is no pool to exhaust now (one shared active stack), so no exhausted/
  # back-pressure counter exists.
  off = buf_write_str(buf, off, ",\"stacks\":{\"saved_live\":")
  off = buf_write_dec(buf, off, g_ss_live)
  off = buf_write_str(buf, off, ",\"saved_live_max\":")
  off = buf_write_dec(buf, off, g_ss_live_max)
  off = buf_write_str(buf, off, ",\"alloc_total\":")
  off = buf_write_dec(buf, off, g_ss_alloc_total)
  off = buf_write_str(buf, off, ",\"free_total\":")
  off = buf_write_dec(buf, off, g_ss_free_total)
  off = buf_write_str(buf, off, ",\"pmm_bytes\":")
  off = buf_write_dec(buf, off, g_ss_bytes)
  off = buf_write_str(buf, off, ",\"copy_max_len\":")
  off = buf_write_dec(buf, off, g_ss_copy_max_len)
  off = buf_write_str(buf, off, ",\"copy_total\":")
  off = buf_write_dec(buf, off, g_ss_copy_total)
  off = buf_write_str(buf, off, "},\"heartbeat\":")
  off = buf_write_dec(buf, off, g_goroutine_heartbeat)
  # K8.8 — per-CPU scheduler heartbeat. Each CPU bumps its own
  # PCPU_HEARTBEAT counter on every task entry (in `sched_tick`),
  # so a stalled CPU is visible as a heartbeat that stops advancing
  # while sibling CPUs keep climbing. Array length = g_cpu_count
  # (= 1 on -smp 1, 2 on -smp 2, etc.); soul page renders one
  # lane bar per CPU.
  #
  # K8.9 — added `ready` field (per-CPU ready ring depth) + dogfooded
  # std/sync/scheduler so this endpoint goes through the same userland
  # API that D.11 (http_server) will consume. The array is the source
  # for SOUL.5 v5's per-CPU lane visualization on the soul page.
  off = buf_write_str(buf, off, ",\"cpus\":[")
  var ci = 0
  while ci < scheduler_cpu_count()
    if ci > 0
      off = buf_write_str(buf, off, ",")
    end
    off = buf_write_str(buf, off, "{\"id\":")
    off = buf_write_dec(buf, off, ci)
    off = buf_write_str(buf, off, ",\"lapic\":")
    off = buf_write_dec(buf, off, scheduler_cpu_lapic_id(ci))
    off = buf_write_str(buf, off, ",\"heartbeat\":")
    off = buf_write_dec(buf, off, scheduler_cpu_heartbeat(ci))
    off = buf_write_str(buf, off, ",\"ready\":")
    off = buf_write_dec(buf, off, scheduler_cpu_ready_count(ci))
    off = buf_write_str(buf, off, "}")
    ci = ci + 1
  end
  off = buf_write_str(buf, off, "]}\n")
  return off
end

# GET /api/soul/tasks.json — per-task pool snapshot for the soul page.
# SOUL.5 v3 reshape — three pieces in one response:
#
#   "grid":   SOUL_GRID_CELLS-char string, ONE char per BUCKET of
#             SOUL_GRID_BUCKET task slots. Each cell carries the
#             highest-priority state in its bucket
#             (X=running > R=ready > B=blocked > D=dead > F=free),
#             so one running task lights its whole neighbourhood —
#             pre-aggregation lets the browser-side state grid stay
#             responsive even at 30k+ alive tasks. Updated 2026-05-28
#             from 1-slot-per-cell (32 768 chars, ~33 KB) to
#             64-slots-per-cell (512 chars, ~1.5 KB).
#   "counts": per-state aggregate (free / ready / running / blocked /
#             dead). Drives the stacked aggregate bar above the grid;
#             the segments fan out from these numbers without the
#             client having to count chars itself. The counts walk
#             every individual slot (NOT the bucketed grid), so they
#             stay exact.
#   "tasks":  legacy per-row array, now capped at 20 (drill-down
#             only — the row table moved into a `<details>` element
#             at v3 because 32 768 rows is unreadable as a list). The
#             field stays for /api/soul/tasks.json scrapers and
#             for the "show top 20" disclosure.
#
# Two pool walks: the first writes the bucketed grid body +
# accumulates exact counts + finds the cap-20 alive ids; the second
# emits those ids as JSON rows. Two walks of NUM_TASKS=32768 are
# cheap (~16k slot reads × 2) and make the JSON layout straight-line —
# no scratch buffers, no splicing.
def http_build_soul_tasks_json(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  off = buf_write_str(buf, off, "{\"version\":1,\"ticks\":")
  off = buf_write_dec(buf, off, g_tick_count)

  # Pass 1: emit one bucket-aggregated char per SOUL_GRID_BUCKET slots
  # (512 chars total for NUM_TASKS=32768), while still walking every
  # slot to accumulate accurate per-state counts. The bucket char is
  # the highest-precedence state present in its 64 slots, with
  # precedence X > R > B > D > F — so a single running task in a
  # bucket otherwise full of free slots renders as "X" and you see the
  # work concentration on the dashboard. Cuts /api/soul/tasks.json
  # payload from ~33 KB to ~1.5 KB and the corresponding browser-side
  # DOM update count from 32768 to 512.
  off = buf_write_str(buf, off, ",\"grid\":\"")
  var c_free = 0
  var c_ready = 0
  var c_running = 0
  var c_blocked = 0
  var c_dead = 0
  var alive = 0
  var i = 0
  while i < NUM_TASKS
    # Walk SOUL_GRID_BUCKET slots; track the highest-precedence state
    # we've seen in this bucket. 0=F, 1=D, 2=B, 3=R, 4=X.
    var bucket_max = 0
    var inner = 0
    while inner < SOUL_GRID_BUCKET
      var t = task_addr(i + inner)
      var s = task_state(t)
      var slot_p = 0
      if s == TASK_STATE_FREE
        c_free = c_free + 1
      else
        alive = alive + 1
        if s == TASK_STATE_READY
          c_ready = c_ready + 1
          slot_p = 3
        elsif s == TASK_STATE_RUNNING
          c_running = c_running + 1
          slot_p = 4
        elsif s == TASK_STATE_DEAD
          c_dead = c_dead + 1
          slot_p = 1
        else
          c_blocked = c_blocked + 1
          slot_p = 2
        end
      end
      if slot_p > bucket_max
        bucket_max = slot_p
      end
      inner = inner + 1
    end
    var ch = 70   # 'F' default
    if bucket_max == 4
      ch = 88     # 'X' running dominates
    elsif bucket_max == 3
      ch = 82     # 'R' ready
    elsif bucket_max == 2
      ch = 66     # 'B' blocked
    elsif bucket_max == 1
      ch = 68     # 'D' dead
    end
    volatile_store<U8>(buf + off, ch)
    off = off + 1
    i = i + SOUL_GRID_BUCKET
  end
  off = buf_write_str(buf, off, "\"")

  # counts — same numbers the stacked bar above the grid renders.
  off = buf_write_str(buf, off, ",\"counts\":{\"free\":")
  off = buf_write_dec(buf, off, c_free)
  off = buf_write_str(buf, off, ",\"ready\":")
  off = buf_write_dec(buf, off, c_ready)
  off = buf_write_str(buf, off, ",\"running\":")
  off = buf_write_dec(buf, off, c_running)
  off = buf_write_str(buf, off, ",\"blocked\":")
  off = buf_write_dec(buf, off, c_blocked)
  off = buf_write_str(buf, off, ",\"dead\":")
  off = buf_write_dec(buf, off, c_dead)
  off = buf_write_str(buf, off, "}")

  # Pass 2: cap-20 row drill-down. K8.9 / SOUL.5 v5 added per-task
  # `cpu` field — the CPU id stamped by sched_tick the last time this
  # task transitioned to RUNNING. Lets the page color the drill-down
  # by which core has been carrying the work.
  off = buf_write_str(buf, off, ",\"tasks\":[")
  var first = 1
  var emitted = 0
  var j = 0
  while j < NUM_TASKS
    if emitted < 20
      var t2 = task_addr(j)
      var s2 = task_state(t2)
      if s2 != TASK_STATE_FREE
        if first == 0
          off = buf_write_str(buf, off, ",")
        end
        first = 0
        off = buf_write_str(buf, off, "{\"id\":")
        off = buf_write_dec(buf, off, uk_task_id(t2))
        off = buf_write_str(buf, off, ",\"state\":\"")
        if s2 == TASK_STATE_READY
          off = buf_write_str(buf, off, "ready")
        else
          if s2 == TASK_STATE_RUNNING
            off = buf_write_str(buf, off, "running")
          else
            if s2 == TASK_STATE_DEAD
              off = buf_write_str(buf, off, "dead")
            else
              off = buf_write_str(buf, off, "blocked")
            end
          end
        end
        off = buf_write_str(buf, off, "\",\"cpu\":")
        off = buf_write_dec(buf, off, task_last_cpu(t2))
        off = buf_write_str(buf, off, "}")
        emitted = emitted + 1
      end
    end
    j = j + 1
  end
  off = buf_write_str(buf, off, "],\"emitted\":")
  off = buf_write_dec(buf, off, emitted)
  off = buf_write_str(buf, off, ",\"alive\":")
  off = buf_write_dec(buf, off, alive)
  off = buf_write_str(buf, off, ",\"capacity\":")
  off = buf_write_dec(buf, off, NUM_TASKS)
  off = buf_write_str(buf, off, "}\n")
  return off
end

# GET /api/soul/spawn?n=N — SOUL.5 v0 raw spawn-N demo. Spawns up to
# N goroutines of soul_demo_body, bounded at NUM_TASKS - alive - 4
# to leave headroom for the heartbeat task + connection-handlers
# that may yet land + this handler itself. Returns JSON describing
# what actually fit:
#
#   {"requested": 50, "spawned": 47, "alive_after": 51, ...}
#
# Unsupervised. The supervised version (Supervisor + Actor + restart
# strategy) waits on C.14. v0's value is just demoing the htop table:
# you click Spawn 25, 25 rows appear in /api/soul/tasks.json, they
# hold for ~2 seconds (the deadline in soul_demo_body), then drain.
#
# GET (not POST) because the dispatcher is read-only. POST support
# is a separate parser change; not blocking the demo.
def http_build_soul_spawn(buf: Int, requested: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")

  # Bound the request against the THIN-pool headroom. Path B routes
  # soul_demo_body through go_fn_thin, so the bound that matters is
  # NUM_TASKS_THIN - g_task_alive_thin; the fat pool's occupancy is
  # irrelevant (HTTP-tier work doesn't compete with demos). Leave 4
  # slots of headroom for racing accept/handler spawn that might land
  # while the request body is mid-loop. (Fat reserves its own headroom
  # implicitly — kern_go_closure_hi can't be starved by a demo spawn.)
  var room = NUM_TASKS_THIN - g_task_alive_thin - 4
  if room < 0
    room = 0
  end
  var n = requested
  if n < 0
    n = 0
  end
  if n > room
    n = room
  end

  var spawned = 0
  var i = 0
  while i < n
    var t = go_fn_thin(soul_demo_body)
    if t == 0
      i = n
    else
      spawned = spawned + 1
      i = i + 1
    end
  end

  off = buf_write_str(buf, off, "{\"version\":1,\"requested\":")
  off = buf_write_dec(buf, off, requested)
  off = buf_write_str(buf, off, ",\"spawned\":")
  off = buf_write_dec(buf, off, spawned)
  off = buf_write_str(buf, off, ",\"alive_after\":")
  off = buf_write_dec(buf, off, g_task_alive)
  off = buf_write_str(buf, off, ",\"spawn_total_after\":")
  off = buf_write_dec(buf, off, g_task_spawn_total)
  off = buf_write_str(buf, off, ",\"capacity\":")
  off = buf_write_dec(buf, off, NUM_TASKS_THIN)
  off = buf_write_str(buf, off, "}\n")
  return off
end

# GET /api/soul/cancel — SOUL.5 v2 Cancel All. Bumps the global
# g_soul_cancel_gen counter; in-flight soul_demo_body tasks check
# the counter on each loop iteration and exit early via task_exit().
# Returns JSON describing the snapshot at the moment the gen bumped:
#
#   {"alive_before": 4092, "cancel_gen": 7}
#
# Drain happens on subsequent scheduler cycles — usually within
# milliseconds — so a /api/soul/stats.json poll a moment later
# shows the count returning to baseline. The page's fcancel() JS
# triggers an immediate refresh after this returns.
#
# Demos the BEAM-pitch cancel-cascade claim: thousands of sleeping
# tasks all unwind in a single scheduler cycle. Today this is a
# demo-specific signal; B.7 Phase 4e + C.14 Supervisor give the
# language a first-class scope-tree cancel that does the same thing
# for arbitrary user code.
def http_build_soul_cancel(buf: Int): Int
  var alive_before = g_task_alive
  g_soul_cancel_gen = g_soul_cancel_gen + 1
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  off = buf_write_str(buf, off, "{\"version\":1,\"alive_before\":")
  off = buf_write_dec(buf, off, alive_before)
  off = buf_write_str(buf, off, ",\"cancel_gen\":")
  off = buf_write_dec(buf, off, g_soul_cancel_gen)
  off = buf_write_str(buf, off, ",\"capacity\":")
  off = buf_write_dec(buf, off, NUM_TASKS)
  off = buf_write_str(buf, off, "}\n")
  return off
end

# GET /health — minimal text for load balancers and uptime probes.
def http_build_health(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\n\r\nok\n")
  return off
end

# ==========================================================================
# Static asset table. Populated at boot by assets_init() (generated from
# site/dist/ by `quake baremetal:bake_assets`). Each request first tries
# the dynamic routes (/ , /api/stats.json, /health); if none match, we
# linear-search this table for a GET on one of the baked paths.
#
# Entry layout (48 bytes):
#   +0   path_ptr  (u64, PMM-backed bytes)
#   +8   path_len  (u64)
#   +16  mime_ptr  (u64)
#   +24  mime_len  (u64)
#   +32  body_ptr  (u64, PMM-backed bytes)
#   +40  body_len  (u64)
# One PMM page (4 KiB) fits 85 entries; MAX_ASSETS = 64 leaves room.
# ==========================================================================

const ASSET_ENTRY_SIZE = 64
# Sized with headroom for Astro growth + playground demos + future assets.
# 512 * 64 = 32 KiB table = 8 contiguous PMM pages (see asset_table_init).
# Per-asset overhead at register time: 2 pages (path + mime) + 1 page (etag)
# + body pages (size-dependent). At ~15 pages/asset × 512 = 30 MiB, which
# comfortably fits the 64 MiB PMM pool.
const MAX_ASSETS = 512

# ETag computed at register time: FNV-1a 64-bit over the body, formatted
# as 16 lowercase hex digits (no surrounding quotes — the HTTP spec
# requires quotes in the header but we store the inner 16 chars). Used
# both to emit `ETag: "<16hex>"` on 200 responses and to short-circuit
# re-fetches with 304 Not Modified when the client sends a matching
# If-None-Match. 64 bits is more than enough entropy for a static
# asset table this small — collision probability is negligible.
const ETAG_HEX_LEN = 16

var g_asset_table = 0
var g_asset_count = 0

def asset_table_init(): Void
  # MAX_ASSETS (512) × ASSET_ENTRY_SIZE (64) = 32 KiB = 8 contiguous PMM pages.
  # The PMM bump allocator returns sequentially-adjacent pages, so we only
  # retain the first base pointer and let the subsequent pmm_alloc_page()
  # calls extend the reservation.
  g_asset_table = pmm_alloc_page()
  var pages_needed = 7
  var i = 0
  while i < pages_needed
    pmm_alloc_page()
    i = i + 1
  end
  g_asset_count = 0
end

# FNV-1a 64-bit hash over an arbitrary byte range in memory. Used
# once per asset at register time to derive a stable ETag that
# survives reboots (content-addressed, not address-addressed).
def fnv1a64(buf_ptr: Int, len: Int): Int
  var hash = 0xcbf29ce484222325
  var i = 0
  while i < len
    hash = hash ^ volatile_load<U8>(buf_ptr + i)
    hash = hash * 0x100000001b3
    i = i + 1
  end
  return hash
end

# Write `h` (64-bit) as 16 lowercase hex digits into buf at off.
# Order: most-significant nibble first. Returns new offset.
def buf_write_hex16(buf: Int, off: Int, h: Int): Int
  var nibble = 15
  var cur = off
  while nibble >= 0
    var n = (h >> (nibble * 4)) & 0xF
    var ch = 48 + n
    if n >= 10
      ch = 87 + n
    end
    volatile_store<U8>(buf + cur, ch)
    cur = cur + 1
    nibble = nibble - 1
  end
  return cur
end

# Copy byte range [0, len) from s into fresh PMM page(s). Returns base.
# Pages are allocated from the bump allocator so consecutive pmm_alloc_page
# calls give adjacent memory — we only return the first base pointer.
def copy_str_to_pmm(s: String, len: Int): Int
  if len == 0
    return 0
  end
  var pages = (len + 4095) / 4096
  var base = pmm_alloc_page()
  var p = 1
  while p < pages
    pmm_alloc_page()
    p = p + 1
  end
  var i = 0
  while i < len
    volatile_store<U8>(base + i, str_byte_at(s, i))
    i = i + 1
  end
  return base
end

# Called by assets_init() (generated) once per baked asset. Copies path
# and mime into PMM, records body descriptor as-is (body is already in
# PMM after the bake helper ran).
def asset_register(path: String, mime: String, body_ptr: Int, body_len: Int): Void
  if g_asset_count >= MAX_ASSETS
    return
  end
  var entry = g_asset_table + (g_asset_count * ASSET_ENTRY_SIZE)
  var path_len = str_byte_len(path)
  volatile_store<U64>(entry +  0, copy_str_to_pmm(path, path_len))
  volatile_store<U64>(entry +  8, path_len)
  var mime_len = str_byte_len(mime)
  volatile_store<U64>(entry + 16, copy_str_to_pmm(mime, mime_len))
  volatile_store<U64>(entry + 24, mime_len)
  volatile_store<U64>(entry + 32, body_ptr)
  volatile_store<U64>(entry + 40, body_len)
  # ETag: FNV-1a over the body, stored as 16 hex bytes in a fresh
  # PMM page. The matching logic compares these raw bytes against
  # the inner 16 chars of an `If-None-Match: "<etag>"` header.
  var etag_ptr = pmm_alloc_page()
  var h = fnv1a64(body_ptr, body_len)
  var _end_off = buf_write_hex16(etag_ptr, 0, h)
  volatile_store<U64>(entry + 48, etag_ptr)
  volatile_store<U64>(entry + 56, ETAG_HEX_LEN)
  g_asset_count = g_asset_count + 1
end

# Sum of body_len across all registered assets — used by
# /api/stats.json so the landing can display bake size.
def asset_total_bytes(): Int
  var total = 0
  var i = 0
  while i < g_asset_count
    var entry = g_asset_table + (i * ASSET_ENTRY_SIZE)
    total = total + volatile_load<U64>(entry + 40)
    i = i + 1
  end
  return total
end

# ==========================================================================
# Recent-requests ring buffer. 64 slots × 96 bytes = 6 KiB (2 PMM pages).
# Each entry records a path + tick + HTTP status. Exposed via
# /api/recent.json so the landing can show a live "last N requests" feed —
# visitor sees every other visitor's path land in near-real-time, which
# makes the kernel-is-alive demonstration visceral.
#
# Entry layout (96 bytes, no heap allocation per record):
#   +0   path bytes (64 bytes, NUL-padded, suffix-trimmed if longer)
#   +64  path_len (u32) — length of the stored suffix, 0..64
#   +68  status   (u32) — 200, 304, 404, ...
#   +72  tick     (u64) — g_tick_count at record time (100 Hz LAPIC)
#   +80  pad
# Paths longer than RECENT_PATH_MAX take the tail — the distinguishing
# suffix of "docs/a/b/c/d.html" is more informative than the common
# "docs/" prefix when slots are scarce.
# ==========================================================================

const RECENT_ENTRY_SIZE = 96
const RECENT_PATH_MAX = 64
const RECENT_SLOTS = 64

var g_recent_buf = 0
var g_recent_head = 0
var g_recent_count = 0

def recent_init(): Void
  g_recent_buf = pmm_alloc_page()
  pmm_alloc_page()
  g_recent_head = 0
  g_recent_count = 0
end

def recent_record(path_ptr: Int, path_len: Int, status: Int): Void
  if g_recent_buf == 0
    return
  end
  var entry = g_recent_buf + (g_recent_head * RECENT_ENTRY_SIZE)
  var stored_len = path_len
  var src_off = 0
  if stored_len > RECENT_PATH_MAX
    src_off = stored_len - RECENT_PATH_MAX
    stored_len = RECENT_PATH_MAX
  end
  var i = 0
  while i < stored_len
    volatile_store<U8>(entry + i, volatile_load<U8>(path_ptr + src_off + i))
    i = i + 1
  end
  while i < RECENT_PATH_MAX
    volatile_store<U8>(entry + i, 0)
    i = i + 1
  end
  volatile_store<U32>(entry + 64, stored_len)
  volatile_store<U32>(entry + 68, status)
  volatile_store<U64>(entry + 72, g_tick_count)
  g_recent_head = (g_recent_head + 1) % RECENT_SLOTS
  g_recent_count = g_recent_count + 1
end

# GET /api/recent.json — JSON array of the most recent served paths,
# ordered oldest-first. Safe to poll alongside /api/stats.json. The
# `count` field is the cumulative request count, mirrored from
# g_recent_count (diverges from items.length once the ring wraps).
def http_build_recent_json(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  off = buf_write_str(buf, off, "{\"version\":1,\"count\":")
  off = buf_write_dec(buf, off, g_recent_count)
  off = buf_write_str(buf, off, ",\"items\":[")

  var slots_used = g_recent_count
  if slots_used > RECENT_SLOTS
    slots_used = RECENT_SLOTS
  end
  var start = 0
  if g_recent_count > RECENT_SLOTS
    start = g_recent_head
  end
  var emitted = 0
  while emitted < slots_used
    var idx = (start + emitted) % RECENT_SLOTS
    var entry = g_recent_buf + (idx * RECENT_ENTRY_SIZE)
    var pl = volatile_load<U32>(entry + 64)
    var st = volatile_load<U32>(entry + 68)
    var tk = volatile_load<U64>(entry + 72)
    if emitted > 0
      volatile_store<U8>(buf + off, 44)
      off = off + 1
    end
    off = buf_write_str(buf, off, "{\"path\":\"")
    var j = 0
    while j < pl
      var b = volatile_load<U8>(entry + j)
      if b == 34 or b == 92
        volatile_store<U8>(buf + off, 92)
        off = off + 1
      end
      volatile_store<U8>(buf + off, b)
      off = off + 1
      j = j + 1
    end
    off = buf_write_str(buf, off, "\",\"status\":")
    off = buf_write_dec(buf, off, st)
    off = buf_write_str(buf, off, ",\"tick\":")
    off = buf_write_dec(buf, off, tk)
    off = buf_write_str(buf, off, "}")
    emitted = emitted + 1
  end
  off = buf_write_str(buf, off, "]}\n")
  return off
end

# Styled 404 for any unmatched path. Matches the dark theme of the
# landing page so a stray URL feels like part of the same site, not
# a bare Apache error. Browser-only — API clients that care about
# status codes will still see the 404 on the response line.
def http_build_404(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 404 Not Found\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\n\r\n")
  off = buf_write_str(buf, off, "<!doctype html>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>404 &mdash; Quartz unikernel</title>\n<style>:root{--fg:#e8e8e8;--mu:#888;--ac:#0df;--bg:#0a0a0a;--pn:#151515}*{box-sizing:border-box}body{font:16px/1.55 system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--fg);max-width:42rem;margin:5rem auto;padding:0 1.2rem}h1{font:600 3.5rem ui-monospace,SFMono-Regular,monospace;color:var(--ac);letter-spacing:-.02em;margin:0 0 .2em}p{color:var(--mu);margin:0 0 1em;font-size:1.05rem}pre{font:14px ui-monospace,SFMono-Regular,monospace;background:var(--pn);color:var(--ac);padding:.9em 1.1em;border-radius:.4em;border:1px solid #222;overflow-x:auto;line-height:1.45}a{color:var(--ac);text-decoration:none;border-bottom:1px dotted var(--ac)}a:hover{color:#fff;border-color:#fff}</style>\n")
  off = buf_write_str(buf, off, "<h1>404</h1>\n<p>The path you asked for isn't in this unikernel's baked asset table, and there's no route that matches it. Since the only network stack running is the one Quartz wrote, your request just walked the full Ethernet / IPv4 / TCP path for nothing.</p>\n<pre>GET &lt;your path&gt; HTTP/1.1\n  &rarr; Ethernet frame ingested by virtio-net\n  &rarr; IPv4 + TCP reassembled\n  &rarr; HTTP router consulted\n  &rarr; no match in asset table or dynamic routes\n  &rarr; 404</pre>\n<p>Try <a href=\"/\">the landing page</a>, <a href=\"/marketing\">the marketing page</a>, <a href=\"/api/stats.json\"><code>/api/stats.json</code></a> for live telemetry, or <a href=\"/docs\">the docs index</a>.</p>\n")
  return off
end


# ---------------------------------------------------------------------
# Window-gated response push.
#
# tcp_try_push emits as many response segments as the peer's receive
# window currently allows. Called whenever something may have opened
# the window:
#
#   1. Immediately after arming a slot's response metadata in the
#      ESTAB branch of tcp_handle_ipv4 (first push of a new response).
#   2. After processing an inbound ACK that advanced snd_una.
#   3. Retransmit pass — not called here; that path is tcp_retransmit_slot.
#
# Per RFC 793 §3.7, the peer's advertised window (SLOT_PEER_WIN) caps
# in-flight bytes (snd_nxt - snd_una). If the window is closed we emit
# a single bare ACK for the inbound data and wait for a window-update
# segment — this also serves as the ACK-of-request when the very first
# push happens under a zero-window condition (rare but possible).
#
# On all data-emitted, we also try to queue FIN once the last response
# byte is on the wire. FIN consumes 1 sequence number, so it needs a
# slot of window room too. If the window is too tight, FIN waits for
# the next call (driven by the next inbound ACK).
def tcp_try_push(slot: Int): Void
  if conn_resp_active(slot) == 0
    return
  end
  var state = conn_state(slot)
  if state != TCP_STATE_ESTAB
    if state != TCP_STATE_FIN_SENT
      return
    end
  end

  var start_seq = conn_resp_start_seq(slot)
  var total_len = conn_resp_total_len(slot)
  var hdr_len   = conn_resp_hdr_len(slot)
  var snd_nxt   = conn_snd_nxt(slot)
  var snd_una   = conn_snd_una(slot)
  var peer_win  = conn_peer_win(slot)

  var off        = snd_nxt - start_seq
  var remaining  = total_len - off
  var in_flight  = snd_nxt - snd_una
  var window_room = peer_win - in_flight

  # Zero-window path: emit a single bare ACK so the peer learns our
  # receive window and (critically) so inbound request data gets
  # acknowledged even when we can't ship the response yet.
  if window_room <= 0
    if remaining > 0
      tcp_send(slot, snd_nxt, conn_rcv_nxt(slot), TCP_FLAG_ACK, 0, 0)
      conn_set_last_tx_tick(slot, g_tick_count)
    end
    return
  end

  # Data phase — push segments until either the window closes or we
  # run out of response bytes.
  var max_seg = 1400
  while remaining > 0
    if window_room <= 0
      return
    end
    var chunk = remaining
    if chunk > max_seg
      chunk = max_seg
    end
    if chunk > window_room
      chunk = window_room
    end
    var src_ptr = 0
    if off < hdr_len
      if off + chunk > hdr_len
        chunk = hdr_len - off
      end
      src_ptr = conn_resp_scratch(slot) + off
    else
      src_ptr = conn_resp_body_ptr(slot) + (off - hdr_len)
    end
    var is_last = 0
    if off + chunk >= total_len
      is_last = 1
    end
    var tcp_flags = TCP_FLAG_ACK
    if is_last == 1
      tcp_flags = TCP_FLAG_ACK | TCP_FLAG_PSH
    end
    tcp_send(slot, snd_nxt, conn_rcv_nxt(slot), tcp_flags, src_ptr, chunk)
    snd_nxt = snd_nxt + chunk
    conn_set_snd_nxt(slot, snd_nxt)
    off = off + chunk
    remaining = remaining - chunk
    window_room = window_room - chunk
    conn_set_last_tx_tick(slot, g_tick_count)
  end

  # No auto-FIN: userland owns connection close via the explicit
  # tcp_close (kern_tcp_close) call. The legacy mode that auto-FINed
  # after each response was deleted in D.11 Phase 8c.2 along with the
  # hand-rolled inline HTTP path.
end

# Retransmit unACKed data for a single slot on RTO expiry. Replays
# one segment from snd_una; the next RTO fires again if the replay
# also isn't acknowledged. Doubling/backoff would go here (RFC 6298)
# but our single kernel-demo RTO constant is plenty conservative.
def tcp_retransmit_slot(slot: Int): Void
  if conn_resp_active(slot) == 0
    return
  end
  var snd_una = conn_snd_una(slot)
  var snd_nxt = conn_snd_nxt(slot)
  var in_flight = snd_nxt - snd_una
  if in_flight <= 0
    return
  end
  if conn_last_tx_tick(slot) + RTO_TICKS > g_tick_count
    return
  end

  var start_seq = conn_resp_start_seq(slot)
  var total_len = conn_resp_total_len(slot)
  var hdr_len   = conn_resp_hdr_len(slot)
  var off       = snd_una - start_seq

  # FIN-only retransmit: snd_una sits at total_len (all data ACKed)
  # but snd_nxt is total_len+1 (FIN consumes 1 seq). Replay the FIN.
  if off >= total_len
    tcp_send(slot, snd_una, conn_rcv_nxt(slot), TCP_FLAG_FIN | TCP_FLAG_ACK, 0, 0)
    conn_set_last_tx_tick(slot, g_tick_count)
    g_tx_retransmits = g_tx_retransmits + 1
    return
  end

  var chunk = total_len - off
  if chunk > in_flight
    chunk = in_flight
  end
  var max_seg = 1400
  if chunk > max_seg
    chunk = max_seg
  end
  var src_ptr = 0
  if off < hdr_len
    if off + chunk > hdr_len
      chunk = hdr_len - off
    end
    src_ptr = conn_resp_scratch(slot) + off
  else
    src_ptr = conn_resp_body_ptr(slot) + (off - hdr_len)
  end
  tcp_send(slot, snd_una, conn_rcv_nxt(slot), TCP_FLAG_ACK | TCP_FLAG_PSH, src_ptr, chunk)
  conn_set_last_tx_tick(slot, g_tick_count)
  g_tx_retransmits = g_tx_retransmits + 1
end

# Walk the whole conn table once per serve-loop tick, firing any slot
# whose RTO has expired. Also refreshes g_tx_bytes_pending for the
# /api/stats.json live counter.
def tcp_retransmit_pass(): Void
  var bytes_pending = 0
  var i = 0
  while i < CONN_SLOTS
    var slot = conn_slot_addr(i)
    var state = conn_state(slot)
    if state == TCP_STATE_ESTAB
      tcp_retransmit_slot(slot)
    end
    if state == TCP_STATE_FIN_SENT
      tcp_retransmit_slot(slot)
    end
    if conn_resp_active(slot) == 1
      bytes_pending = bytes_pending + (conn_snd_nxt(slot) - conn_snd_una(slot))
    end
    i = i + 1
  end
  g_tx_bytes_pending = bytes_pending
end

# DEF-E-N1 phase 5: per-connection goroutine count + cumulative spawn
# tally. Each accepted SYN spawns one goroutine that owns the TCP
# state machine for that connection end-to-end (SYN_RCVD completion,
# ESTAB, data + response, FIN exchange, CLOSED). `g_conn_goroutine_spawn_total`
# is a cumulative counter exposed in /api/stats.json so a curl poll
# can watch the rate without needing goroutine_alive's live gauge.
var g_conn_goroutine_spawn_total = 0

# Process a single Ethernet frame for an owning slot. Contains the
# post-handshake TCP state machine — SYN_RCVD completion, ESTAB (with
# request absorption + response build), FIN_SENT wind-down, LAST_ACK.
# Runs inside the per-connection goroutine (see conn_body below); the
# frame bytes have already been copied out of the shared virtio RX
# buffer into slot-owned rx scratch by main's dispatcher, so this
# function can take arbitrary time (response building, memcpy, etc.)
# without blocking RX for other connections.
def conn_process_frame(slot: Int, eth: Int, eth_len: Int): Void
  if eth_len < 54
    return
  end
  if read_be16(eth, 12) != 0x0800
    return      # not IPv4
  end
  var ip = eth + 14
  if volatile_load<U8>(ip + 9) != 0x06
    return      # not TCP
  end
  var ihl = volatile_load<U8>(ip + 0) & 0xF
  var ip_total = read_be16(ip, 2)
  var tcp = ip + (ihl * 4)
  var tcp_seg_len = ip_total - (ihl * 4)

  var seg_seq  = read_be32(tcp, 4)
  var seg_ack  = read_be32(tcp, 8)
  var data_off = (volatile_load<U8>(tcp + 12) >> 4) & 0xF
  var flags    = volatile_load<U8>(tcp + 13)
  var seg_win  = read_be16(tcp, 14)
  var tcp_hdr_len = data_off * 4
  var data_len    = tcp_seg_len - tcp_hdr_len
  var data_addr   = tcp + tcp_hdr_len

  var state = conn_state(slot)
  if state == TCP_STATE_FREE
    return      # slot was closed under us — stale frame, drop
  end

  # Refresh the peer's advertised receive window from every segment
  # (the SLIRP / Linux-socket-buffer squeeze is communicated back to
  # us here). SYN_RCVD updates too so the first post-handshake push
  # sees an accurate window.
  conn_set_peer_win(slot, seg_win)

  # --- SYN_RCVD ------------------------------------------------
  if state == TCP_STATE_SYN_RCVD
    if (flags & TCP_FLAG_RST) != 0
      tcp_free_slot(slot)
      return
    end
    if (flags & TCP_FLAG_ACK) == 0
      return
    end
    if seg_ack != conn_snd_nxt(slot)
      return
    end
    conn_set_snd_una(slot, seg_ack)
    conn_set_state(slot, TCP_STATE_ESTAB)
    state = TCP_STATE_ESTAB
    uart_put_str("TCP: ESTABLISHED\n")
    # Fall through: a segment carrying ACK can also carry data or
    # FIN in the same packet.
    if data_len == 0
      if (flags & TCP_FLAG_FIN) == 0
        return
      end
    end
  end

  # --- ESTABLISHED ---------------------------------------------
  if state == TCP_STATE_ESTAB
    if (flags & TCP_FLAG_RST) != 0
      tcp_free_slot(slot)
      return
    end

    if (flags & TCP_FLAG_ACK) != 0
      var cur_una = conn_snd_una(slot)
      var cur_nxt = conn_snd_nxt(slot)
      if seg_ack > cur_una
        if seg_ack <= cur_nxt
          conn_set_snd_una(slot, seg_ack)
        end
      end
      if conn_resp_active(slot) == 1
        tcp_try_push(slot)
        # Userland-write completion signal. The userland async_tcp_write
        # blocks on SLOT_TX_DONE_CHAN; fire the signal when snd_una has
        # caught up to start_seq + total_len (all queued bytes ACKed by
        # peer). Also clear resp_active so the slot's SLOT_RESP_* state
        # is free for the next write.
        var start_seq = conn_resp_start_seq(slot)
        var total_len = conn_resp_total_len(slot)
        if conn_snd_una(slot) >= start_seq + total_len
          conn_set_resp_active(slot, 0)
          var done_ch = conn_tx_done_chan(slot)
          if done_ch != 0
            chan_try_send(done_ch, 1)
          end
        end
      end
    end

    if data_len > 0
      if seg_seq == conn_rcv_nxt(slot)
        # Deposit payload bytes into the slot's payload-rx ring
        # (lazy-allocated on first use), then signal the userland
        # consumer via the cap=1 signal channel. The HTTP-layer
        # goroutine spawned by http_dyn_gsup_spawn_one after tcp_accept
        # drains via async_tcp_read's freestanding body.
        conn_set_rcv_nxt(slot, seg_seq + data_len)
        var pay_scratch = conn_payload_rx_scratch(slot)
        if pay_scratch == 0
          pay_scratch = pmm_alloc_page()
          conn_set_payload_rx_scratch(slot, pay_scratch)
        end
        var pay_chan = conn_payload_rx_chan(slot)
        if pay_chan == 0
          pay_chan = chan_new(1)
          conn_set_payload_rx_chan(slot, pay_chan)
        end
        var w_off = conn_payload_rx_write_off(slot)
        var r_off = conn_payload_rx_read_off(slot)
        # Backpressure: if the ring would overrun the reader, drop the
        # excess. Peer retransmits via TCP-level recovery (we do NOT
        # bump rcv_nxt for dropped bytes, so the peer sees a gap and
        # resends). Simpler than zero-window-advertise; sufficient for
        # the small HTTP responses the kernel serves.
        var ring_used = w_off - r_off
        var ring_free = PAYLOAD_RX_RING_SIZE - ring_used
        var copy_len = data_len
        if copy_len > ring_free
          copy_len = ring_free
        end
        var i = 0
        while i < copy_len
          var dst_pos = (w_off + i) & (PAYLOAD_RX_RING_SIZE - 1)
          volatile_store<U8>(pay_scratch + dst_pos, volatile_load<U8>(data_addr + i))
          i = i + 1
        end
        conn_set_payload_rx_write_off(slot, w_off + copy_len)
        # Idempotent signal: cap=1 → second chan_try_send while one
        # token sits in the channel is a no-op, which is exactly the
        # "data available" semantic we want.
        chan_try_send(pay_chan, 1)
        # Send a bare ACK so the peer knows we accepted the data; the
        # response comes from the HTTP-layer goroutine's async_tcp_write.
        tcp_send(slot, conn_snd_nxt(slot), conn_rcv_nxt(slot), TCP_FLAG_ACK, 0, 0)
        return
      end
    end
    if (flags & TCP_FLAG_FIN) != 0
      if conn_resp_active(slot) == 0
        conn_set_rcv_nxt(slot, conn_rcv_nxt(slot) + 1)
        tcp_send(slot, conn_snd_nxt(slot), conn_rcv_nxt(slot), TCP_FLAG_ACK, 0, 0)
        tcp_send(slot, conn_snd_nxt(slot), conn_rcv_nxt(slot), TCP_FLAG_FIN | TCP_FLAG_ACK, 0, 0)
        conn_set_snd_nxt(slot, conn_snd_nxt(slot) + 1)
        conn_set_state(slot, TCP_STATE_LAST_ACK)
      end
    end
    return
  end

  # --- FIN_SENT (we sent our FIN after responding) --------------
  if state == TCP_STATE_FIN_SENT
    if (flags & TCP_FLAG_RST) != 0
      tcp_free_slot(slot)
      g_tcp_connections = g_tcp_connections + 1
      return
    end

    if (flags & TCP_FLAG_ACK) != 0
      var cur_una = conn_snd_una(slot)
      var cur_nxt = conn_snd_nxt(slot)
      if seg_ack > cur_una
        if seg_ack <= cur_nxt
          conn_set_snd_una(slot, seg_ack)
        end
      end
    end

    if (flags & TCP_FLAG_FIN) != 0
      conn_set_rcv_nxt(slot, conn_rcv_nxt(slot) + 1)
      tcp_send(slot, conn_snd_nxt(slot), conn_rcv_nxt(slot), TCP_FLAG_ACK, 0, 0)
      uart_put_str("HTTP: peer FIN -> CLOSED\n")
      g_tcp_connections = g_tcp_connections + 1
      tcp_free_slot(slot)
    end
    return
  end

  # --- LAST_ACK ------------------------------------------------
  if state == TCP_STATE_LAST_ACK
    if (flags & TCP_FLAG_RST) != 0
      tcp_free_slot(slot)
      g_tcp_connections = g_tcp_connections + 1
      return
    end
    if (flags & TCP_FLAG_ACK) == 0
      return
    end
    if seg_ack != conn_snd_nxt(slot)
      return
    end
    uart_put_str("TCP: CLOSED\n")
    g_tcp_connections = g_tcp_connections + 1
    tcp_free_slot(slot)
    return
  end
end

# Connection-goroutine entry point — the in-kernel TCP pump. Reads its
# owning slot ptr from TASK_USER_ARG (stashed by tcp_accept_syn right
# after go_fn), then loops on chan_recv to pull frames forwarded by
# main's dispatcher. Each payload encodes only the frame length — the
# actual Ethernet bytes sit in the slot's rx scratch ring at
# SLOT_RX_READ_IDX. On every iteration we:
#   1. chan_recv (blocks until main forwards a frame or closes).
#   2. Process that buffer[read_idx] via conn_process_frame.
#   3. Advance read_idx by 1 (mod SLOT_RX_CHAN_CAP).
#   4. Exit if the state machine reached FREE (connection CLOSED).
# Because goroutines run cooperatively (no preemption between
# chan_recv calls), main never races us on buffer[read_idx]: any
# overwrites of that slot wait until we loop back into chan_recv.
#
# conn_process_frame's ESTAB-data branch pumps the payload bytes into
# the slot's payload-rx ring and signals the userland HTTP goroutine
# that holds the fd via async_tcp_read.
def conn_body(): Void
  var my_task = sched_current()
  var slot = volatile_load<U64>(my_task + TASK_USER_ARG)
  var scratch = conn_rx_scratch(slot)
  var done = 0
  while done == 0
    var len = chan_recv(conn_rx_chan(slot))
    if len == 0
      # Channel closed & drained — connection tearing down.
      done = 1
    else
      var idx = conn_rx_read_idx(slot)
      var buf = scratch + (idx * SLOT_RX_SCRATCH_STRIDE)
      conn_process_frame(slot, buf, len)
      conn_set_rx_read_idx(slot, (idx + 1) & (SLOT_RX_CHAN_CAP - 1))
      if conn_state(slot) == TCP_STATE_FREE
        done = 1
      end
    end
  end
  task_exit()
end

# Main-side SYN acceptance: allocate conn slot + task, send SYN+ACK,
# transition to SYN_RCVD, spawn the connection goroutine. Runs
# synchronously in main because the response to SYN can happen
# before the goroutine has run for the first time. Returns the slot
# ptr on success, 0 if the conn table OR the task pool is full (drop
# the SYN — the peer will retransmit). The goroutine then takes over
# all further frames for this connection via its rx_chan.
#
# `listen_entry` is the matching listening-table entry (from
# kern_tcp_listen_lookup in tcp_handle_ipv4). The new conn slot's ptr
# is pushed onto the listener's accept channel so a parked
# kern_tcp_accept wakes up.
def tcp_accept_syn(eth: Int, ip: Int, tcp: Int,
                   peer_ip0: Int, peer_ip1: Int, peer_ip2: Int, peer_ip3: Int,
                   src_port: Int, seg_seq: Int, seg_win: Int, listen_entry: Int): Int
  var slot = tcp_find_free_slot()
  if slot == 0
    return 0
  end

  # Reserve the rx_chan if this slot has never had one (first use of
  # the slot since boot). Subsequent reuses reset the existing chan
  # so we don't leak PMM pages across churn.
  var ch = conn_rx_chan(slot)
  if ch == 0
    ch = chan_new(SLOT_RX_CHAN_CAP)
    conn_set_rx_chan(slot, ch)
  end
  chan_reset(ch)
  conn_set_rx_write_idx(slot, 0)
  conn_set_rx_read_idx(slot, 0)

  # Record the local-port from the matching listening entry so
  # tcp_find_slot can disambiguate connections that share a
  # peer-src-port but differ by dst-port (curl reusing ephemeral source
  # ports across different host-side hostfwd targets surfaces this).
  conn_set_local_port(slot, volatile_load<U64>(listen_entry + KERN_LISTEN_ENTRY_PORT))

  # Initialize the slot. Peer info from frame; seq/ack from SYN.
  volatile_store<U8>(slot + SLOT_PEER_MAC + 0, volatile_load<U8>(eth + 6))
  volatile_store<U8>(slot + SLOT_PEER_MAC + 1, volatile_load<U8>(eth + 7))
  volatile_store<U8>(slot + SLOT_PEER_MAC + 2, volatile_load<U8>(eth + 8))
  volatile_store<U8>(slot + SLOT_PEER_MAC + 3, volatile_load<U8>(eth + 9))
  volatile_store<U8>(slot + SLOT_PEER_MAC + 4, volatile_load<U8>(eth + 10))
  volatile_store<U8>(slot + SLOT_PEER_MAC + 5, volatile_load<U8>(eth + 11))
  volatile_store<U8>(slot + SLOT_PEER_IP + 0, peer_ip0)
  volatile_store<U8>(slot + SLOT_PEER_IP + 1, peer_ip1)
  volatile_store<U8>(slot + SLOT_PEER_IP + 2, peer_ip2)
  volatile_store<U8>(slot + SLOT_PEER_IP + 3, peer_ip3)
  conn_set_remote_port(slot, src_port)
  conn_set_rcv_nxt(slot, seg_seq + 1)       # SYN consumes 1
  conn_set_snd_una(slot, TCP_ISS)
  conn_set_snd_nxt(slot, TCP_ISS + 1)       # our SYN consumes 1
  conn_set_peer_win(slot, seg_win)
  conn_set_resp_active(slot, 0)
  conn_set_resp_fin_sent(slot, 0)
  conn_set_last_tx_tick(slot, g_tick_count)

  uart_put_str("TCP: SYN from ")
  uart_put_uint(peer_ip0)
  uart_putc(46)
  uart_put_uint(peer_ip1)
  uart_putc(46)
  uart_put_uint(peer_ip2)
  uart_putc(46)
  uart_put_uint(peer_ip3)
  uart_putc(58)
  uart_put_uint(src_port)
  uart_putc(10)

  tcp_send(slot, TCP_ISS, conn_rcv_nxt(slot), TCP_FLAG_SYN | TCP_FLAG_ACK, 0, 0)
  conn_set_state(slot, TCP_STATE_SYN_RCVD)

  # Spawn the per-connection goroutine. If the task pool is full,
  # roll back the slot allocation so the SYN retry falls on a clean
  # free slot (task pool freeing is on goroutine task_exit, which
  # takes a scheduler pump cycle; this path only fires under
  # extreme load).
  # HTTP-tier work — kernel TCP pump for this connection. Goes on the
  # global hi ring so heavy demo-task load on the normal rings can't
  # starve in-flight HTTP traffic. See [[feedback-supervised-vs-demo-task-starvation]].
  var t = go_fn_hi(conn_body)
  if t == 0
    tcp_free_slot(slot)
    return 0
  end
  volatile_store<U64>(t + TASK_USER_ARG, slot)
  conn_set_goroutine(slot, t)
  g_conn_goroutine_spawn_total = g_conn_goroutine_spawn_total + 1

  # Thread the accept-chan from the matching listening entry into the
  # new slot. Reset payload-rx cursors so a slot reused across
  # connections starts fresh. The payload-rx signal channel + ring are
  # lazy-allocated on first ESTAB-data deposit (conn_process_frame);
  # chan_reset clears the closed flag from any prior connection that
  # ran on this slot.
  conn_set_payload_rx_write_off(slot, 0)
  conn_set_payload_rx_read_off(slot, 0)
  var pay_chan = conn_payload_rx_chan(slot)
  if pay_chan != 0
    chan_reset(pay_chan)
  end
  var tx_chan = conn_tx_done_chan(slot)
  if tx_chan != 0
    chan_reset(tx_chan)
  end
  var accept_ch = volatile_load<U64>(listen_entry + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  if accept_ch != 0
    # cap = CONN_SLOTS = 64; the slot allocation we just did is the
    # backpressure gate, so chan_try_send cannot fail in practice.
    chan_try_send(accept_ch, slot)
  end
  return slot
end

# Forward a post-handshake frame to the slot's connection goroutine.
# Copies the Ethernet frame into the slot's rx-scratch ring at
# write_idx, bumps write_idx, and chan_try_sends the frame length.
# On chan-full (goroutine is behind — rare), the frame is dropped
# and the peer retransmits it (standard TCP behavior, no special
# handling needed on our side). Copy is load-bearing: main is about
# to virtio_net_rx_post() the shared RX buffer right after this
# returns, so anything we forward to a goroutine must live in
# slot-owned memory by then.
def tcp_forward_to_slot(slot: Int, eth: Int, eth_len: Int): Void
  var ch = conn_rx_chan(slot)
  if ch == 0
    return    # slot never spawned a goroutine (shouldn't happen after SYN)
  end
  if chan_count(ch) >= chan_cap(ch)
    return    # goroutine is behind; drop, peer retransmits
  end
  var idx = conn_rx_write_idx(slot)
  var dst = conn_rx_scratch(slot) + (idx * SLOT_RX_SCRATCH_STRIDE)
  var copy_len = eth_len
  if copy_len > SLOT_RX_SCRATCH_STRIDE
    copy_len = SLOT_RX_SCRATCH_STRIDE
  end
  var i = 0
  while i < copy_len
    volatile_store<U8>(dst + i, volatile_load<U8>(eth + i))
    i = i + 1
  end
  conn_set_rx_write_idx(slot, (idx + 1) & (SLOT_RX_CHAN_CAP - 1))
  chan_try_send(ch, copy_len)
end

# Main IPv4 dispatcher — called from the server loop with a frame in the
# virtio RX buffer. Parses Ethernet + IPv4 then routes by IP protocol byte
# to the appropriate L4 handler. TCP=6 → tcp_handle_ipv4 (the original
# Phase-5 architecture: main does minimal parse to route, synchronously
# handles new-peer SYNs by spawning a per-connection goroutine, forwards
# every other frame to the owning slot's rx_chan). UDP=17 → udp_handle_ipv4
# (added NET.1 Phase 1 for WireGuard). Other protocols are silently dropped.
#
# `buf_bytes` is the total bytes the virtio device wrote, INCLUDING the 10
# bytes of legacy virtio_net_hdr at the start of g_vnet_rx_buf. The thin
# wrapper around `ip_handle_frame_at` exists so the WG layer can re-enter
# the IP stack with a synthetic frame built into a different scratch buffer
# (decrypted inner-IP from a tunneled MSG_DATA — Step 2.6).
def ip_handle_frame(buf_bytes: Int): Void
  var hdr = 10
  if buf_bytes < hdr
    return
  end
  ip_handle_frame_at(g_vnet_rx_buf + hdr, buf_bytes - hdr)
end

# Same dispatcher as above, but takes an explicit (eth, eth_len) — i.e. the
# caller has already advanced past the virtio prelude (or never had one,
# as in the WG inner-IP injection path).
def ip_handle_frame_at(eth: Int, eth_len: Int): Void
  if eth_len < 34       # min: eth(14) + ipv4(20)
    return
  end
  if read_be16(eth, 12) != 0x0800
    return      # not IPv4 (leftover ARP / other)
  end
  # First IPv4 frame on the wire teaches us the gateway link-layer
  # address — we'll need it for any unsolicited outbound (WG keepalive,
  # rekey, MSG_INITIATION). Subsequent calls re-learn it cheaply, which
  # naturally tracks topology changes (gateway MAC rotates).
  if g_gateway_mac_known == 0
    g_gateway_mac0 = volatile_load<U8>(eth + 6)
    g_gateway_mac1 = volatile_load<U8>(eth + 7)
    g_gateway_mac2 = volatile_load<U8>(eth + 8)
    g_gateway_mac3 = volatile_load<U8>(eth + 9)
    g_gateway_mac4 = volatile_load<U8>(eth + 10)
    g_gateway_mac5 = volatile_load<U8>(eth + 11)
    g_gateway_mac_known = 1
  end
  var ip = eth + 14
  var proto = volatile_load<U8>(ip + 9)
  var ihl = volatile_load<U8>(ip + 0) & 0xF
  if proto == IP_PROTO_TCP
    if eth_len < 54     # eth(14) + ip(20) + tcp(20) min
      return
    end
    tcp_handle_ipv4(eth, ip, ihl, eth_len + 10)
  end
  if proto == IP_PROTO_UDP
    udp_handle_ipv4(eth, ip, ihl, eth_len + 10)
  end
end

# ============================================================================
# Kernel listening-port table (D.11 Phase 7 / Phase 8a step 2)
# ============================================================================
#
# Bridges std/net/tcp.qz's `@cfg(os: "unknown")` tcp_listen / tcp_close_listener
# freestanding bodies to a kernel-owned data structure. Slot ptr returned by
# kern_tcp_listen serves as the TcpListener.fd value in stdlib code — the
# fd ≡ slot ptr convention this whole bridge layer adopts.
#
# Entry layout (32 bytes; offsets 24..31 reserved):
#   +0  i64 active_flag      — 1 = listener live
#   +8  i64 port             — listening port
#   +16 i64 accept_chan_ptr  — cap=CONN_SLOTS channel; producer = tcp_accept_syn,
#                              consumer = kern_tcp_accept (the freestanding
#                              @cfg(os: "unknown") body of std/net/tcp's tcp_accept)
const KERN_LISTEN_TABLE_CAP            = 4
const KERN_LISTEN_ENTRY_SIZE           = 32
const KERN_LISTEN_ENTRY_ACTIVE         = 0
const KERN_LISTEN_ENTRY_PORT           = 8
const KERN_LISTEN_ENTRY_ACCEPT_CHAN    = 16

# Lazy-init pointer to the 128-byte table (a 4 KiB PMM page; only the
# first 128 bytes are used). Allocated on first call to kern_tcp_listen.
var g_kern_listen_table = 0

def _kern_listen_table_init(): Int
  if g_kern_listen_table != 0
    return g_kern_listen_table
  end
  var p = pmm_alloc_page()
  var i = 0
  while i < (KERN_LISTEN_TABLE_CAP * KERN_LISTEN_ENTRY_SIZE)
    volatile_store<U8>(p + i, 0)
    i = i + 1
  end
  g_kern_listen_table = p
  return p
end

# Register a listener for `port`. Returns the slot ptr (non-zero) on
# success; 0 on table-full. Linked from std/net/tcp.qz's freestanding
# `tcp_listen` via `extern "C" def kern_tcp_listen` — top-level `def` in
# this file emits the LLVM symbol `@kern_tcp_listen`. The one-arg ABI is
# load-bearing for the std/net/tcp.qz extern decl.
def kern_tcp_listen(port: Int): Int
  var base = _kern_listen_table_init()
  var i = 0
  while i < KERN_LISTEN_TABLE_CAP
    var entry = base + (i * KERN_LISTEN_ENTRY_SIZE)
    if volatile_load<U64>(entry + KERN_LISTEN_ENTRY_ACTIVE) == 0
      var ch = volatile_load<U64>(entry + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
      if ch == 0
        ch = chan_new(CONN_SLOTS)
        volatile_store<U64>(entry + KERN_LISTEN_ENTRY_ACCEPT_CHAN, ch)
      else
        chan_reset(ch)
      end
      volatile_store<U64>(entry + KERN_LISTEN_ENTRY_PORT, port)
      # Set ACTIVE last so a concurrent tcp_handle_ipv4 lookup sees a
      # fully-initialized entry or no entry at all.
      volatile_store<U64>(entry + KERN_LISTEN_ENTRY_ACTIVE, 1)
      return entry
    end
    i = i + 1
  end
  return 0
end

# Close a listener. `slot_ptr` is what kern_tcp_listen returned.
# Idempotent on already-closed slots (and on slot_ptr == 0). Closes the
# accept channel so any parked kern_tcp_accept wakes up and sees 0.
def kern_tcp_close_listener(slot_ptr: Int): Int
  if slot_ptr != 0
    var ch = volatile_load<U64>(slot_ptr + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
    if ch != 0
      chan_close(ch)
    end
    volatile_store<U64>(slot_ptr + KERN_LISTEN_ENTRY_ACTIVE, 0)
    volatile_store<U64>(slot_ptr + KERN_LISTEN_ENTRY_PORT, 0)
  end
  return 0
end

# Block the calling goroutine until a SYN arrives on the listener's
# port + tcp_accept_syn pushes the new conn slot onto the entry's
# accept channel. Returns the conn slot ptr; 0 if the listener was
# closed (chan_recv on a closed empty channel returns 0).
#
# Step 3 only. Linked from std/net/tcp.qz's freestanding `tcp_accept`
# via `extern "C" def kern_tcp_accept`. Single accept channel per
# listening entry; the consumer can be any goroutine that holds the
# TcpListener (typically the http_serve_supervised listener loop).
def kern_tcp_accept(listener_slot_ptr: Int): Int
  if listener_slot_ptr == 0
    return 0
  end
  var ch = volatile_load<U64>(listener_slot_ptr + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  if ch == 0
    return 0
  end
  return chan_recv(ch)
end

# Phase 8a step 5 — non-blocking accept for the freestanding
# TcpAcceptableSelectable.try_poll. Mirrors kern_tcp_accept's blocking
# shape but peeks the accept channel under CHAN_LOCK and only consumes
# when a pending conn slot is queued. Returns the conn slot ptr; 0 if
# the listener is closed, invalid, or the queue is empty.
#
# Same semantics as the hosted socket_accept(fd, 0, 0) on a non-blocking
# socket: returns a fresh fd on hit, 0 sentinel on EAGAIN. Linked from
# std/net/tcp.qz's freestanding _tcp_acceptable_try_poll helper via
# `extern "C" def kern_tcp_try_accept`.
def kern_tcp_try_accept(listener_slot_ptr: Int): Int
  if listener_slot_ptr == 0
    return 0
  end
  var ch = volatile_load<U64>(listener_slot_ptr + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  if ch == 0
    return 0
  end
  var lock = ch + CHAN_LOCK
  spinlock_lock(lock)
  if chan_count(ch) == 0
    spinlock_unlock(lock)
    return 0
  end
  spinlock_unlock(lock)
  return chan_recv(ch)
end

# Phase 8a step 5 — active-wake bridge for TcpAcceptableSelectable
# inside a select{} block. The accept channel itself is the waiter
# token: chan_send (from tcp_accept_syn's push of the new conn slot)
# already calls kernel_waiter_wake_all(ch) after enqueueing, so any
# select-arm parked via this register call will be woken without
# polling. Same shape as KRecvable.register_waker (B.5c).
#
# `frame` is the calling task handle, supplied by the select runtime
# (effect_argv contents). Linked from std/net/tcp.qz's freestanding
# _tcp_acceptable_register_waker helper.
def kern_tcp_acceptable_register_waker(listener_slot_ptr: Int, frame: Int): Void
  if listener_slot_ptr == 0
    return
  end
  var ch = volatile_load<U64>(listener_slot_ptr + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  if ch == 0
    return
  end
  kernel_waiter_register(ch, frame)
end

# Paired unregister. Idempotent on already-unregistered frames or
# closed listeners.
def kern_tcp_acceptable_unregister_waker(listener_slot_ptr: Int, frame: Int): Void
  if listener_slot_ptr == 0
    return
  end
  var ch = volatile_load<U64>(listener_slot_ptr + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  if ch == 0
    return
  end
  kernel_waiter_unregister(ch, frame)
end

# Phase 8a step 4 — userland async_tcp_read bridge. Drains up to
# `max_bytes` from the slot's payload-rx ring (populated by the TCP
# pump's ESTAB-data branch). Blocks via chan_recv on the cap=1 signal
# channel if the ring is empty. Returns the number of bytes copied to
# `buf`; 0 = EOF (peer closed and channel is closed empty), -1 on bad
# slot.
#
# Linked from std/net/tcp.qz's freestanding `async_tcp_read` via
# `extern "C" def kern_tcp_read`. The cursor + ring layout is private
# to the kernel; stdlib only sees this entry point.
def kern_tcp_read(slot: Int, buf: Int, max_bytes: Int): Int
  if slot == 0
    return -1
  end
  if max_bytes <= 0
    return 0
  end
  while true
    var w_off = conn_payload_rx_write_off(slot)
    var r_off = conn_payload_rx_read_off(slot)
    var avail = w_off - r_off
    if avail > 0
      var n = max_bytes
      if avail < n
        n = avail
      end
      var scratch = conn_payload_rx_scratch(slot)
      if scratch == 0
        return 0
      end
      var i = 0
      while i < n
        var src_pos = (r_off + i) & (PAYLOAD_RX_RING_SIZE - 1)
        volatile_store<U8>(buf + i, volatile_load<U8>(scratch + src_pos))
        i = i + 1
      end
      conn_set_payload_rx_read_off(slot, r_off + n)
      return n
    end
    # Ring empty. Park on the cap=1 signal channel (lazy-alloced on
    # the producer side). If the chan doesn't exist yet, allocate it
    # here so we have something to park on.
    var ch = conn_payload_rx_chan(slot)
    if ch == 0
      ch = chan_new(1)
      conn_set_payload_rx_chan(slot, ch)
    end
    var sig = chan_recv(ch)
    if sig == 0
      # Channel closed (peer FIN handled in conn_process_frame +
      # tcp_free_slot chained chan_close). One last avail check —
      # there may be unread bytes the producer deposited before
      # closing.
      var w_off2 = conn_payload_rx_write_off(slot)
      var r_off2 = conn_payload_rx_read_off(slot)
      if w_off2 == r_off2
        return 0
      end
      # Fall through to the avail > 0 path on next iteration.
    end
  end
  return 0
end

# Userland async_tcp_write bridge. Drives the SLOT_RESP_* state machine
# (response chunker) over the user-supplied buffer. Sets up the state
# then kicks tcp_try_push; the ACK-driven branch in conn_process_frame
# advances + re-pushes until snd_una catches the tail, at which point it
# signals SLOT_TX_DONE_CHAN. Returns `len` on success, -1 on bad slot,
# 0 if the connection closed mid-write (chan_recv returned 0).
#
# Buffer lifetime: held by direct reference on the slot for the duration
# of the call. Caller's buffer is in scope throughout because this
# function blocks until completion — no escape risk.
def kern_tcp_write(slot: Int, buf: Int, len: Int): Int
  if slot == 0
    return -1
  end
  if len <= 0
    return 0
  end
  # Lazy-alloc the tx-done signal channel.
  var ch = conn_tx_done_chan(slot)
  if ch == 0
    ch = chan_new(1)
    conn_set_tx_done_chan(slot, ch)
  else
    chan_reset(ch)
  end
  # Set up SLOT_RESP_* for tcp_try_push. hdr_len = 0 (no inline header
  # for userland writes — body bytes are the user buffer directly);
  # start_seq = snd_nxt (this write starts where the previous left off).
  conn_set_resp_body_ptr(slot, buf)
  conn_set_resp_body_len(slot, len)
  conn_set_resp_hdr_len(slot, 0)
  conn_set_resp_start_seq(slot, conn_snd_nxt(slot))
  conn_set_resp_fin_sent(slot, 0)
  conn_set_resp_active(slot, 1)
  conn_set_last_tx_tick(slot, g_tick_count)
  # Kick: send what fits in peer's window. Remaining bytes are emitted
  # by the ACK-driven tcp_try_push call in conn_process_frame as the
  # peer ACKs and the window slides forward.
  tcp_try_push(slot)
  # Block until ACK branch fires the completion signal. If the slot
  # closes mid-write (peer RST / FIN, tcp_free_slot path chan_closes
  # the channel), chan_recv returns 0 — surface that to the caller.
  var sig = chan_recv(ch)
  if sig == 0
    return 0
  end
  return len
end

# Phase 8a step 4 — userland tcp_close bridge. Sends FIN + transitions
# state to FIN_SENT; the existing TCP state machine handles the rest
# (FIN_ACK from peer → LAST_ACK → CLOSED → tcp_free_slot). Idempotent
# on already-closed or never-established slots.
def kern_tcp_close(slot: Int): Int
  if slot == 0
    return 0
  end
  var state = conn_state(slot)
  if state == TCP_STATE_ESTAB
    tcp_send(slot, conn_snd_nxt(slot), conn_rcv_nxt(slot), TCP_FLAG_FIN | TCP_FLAG_ACK, 0, 0)
    conn_set_snd_nxt(slot, conn_snd_nxt(slot) + 1)
    conn_set_state(slot, TCP_STATE_FIN_SENT)
  end
  return 0
end

# Lookup: is `port` currently registered? Returns the slot ptr on
# match, 0 otherwise. Called by tcp_handle_ipv4 to decide whether to
# accept SYNs for an incoming dst_port.
def kern_tcp_listen_lookup(port: Int): Int
  if g_kern_listen_table == 0
    return 0
  end
  var base = g_kern_listen_table
  var i = 0
  while i < KERN_LISTEN_TABLE_CAP
    var entry = base + (i * KERN_LISTEN_ENTRY_SIZE)
    if volatile_load<U64>(entry + KERN_LISTEN_ENTRY_ACTIVE) != 0
      if volatile_load<U64>(entry + KERN_LISTEN_ENTRY_PORT) == port
        return entry
      end
    end
    i = i + 1
  end
  return 0
end

# TCP-specific handling, factored out of the former tcp_handle_frame so
# ip_handle_frame can dispatch by protocol. SYN acceptance is gated on
# kern_tcp_listen_lookup against the listening-port table (populated by
# stdlib's freestanding `tcp_listen` body). The listening entry only
# gates NEW connections — established connections route to their slot
# regardless of listener status, so a userland tcp_close_listener
# mid-connection does NOT drop in-flight ACK/data frames for established
# slots.
def tcp_handle_ipv4(eth: Int, ip: Int, ihl: Int, buf_bytes: Int): Void
  var hdr = 10
  var tcp = ip + (ihl * 4)
  var dst_port = read_be16(tcp, 2)

  var src_port = read_be16(tcp, 0)
  var peer_ip0 = volatile_load<U8>(ip + 12)
  var peer_ip1 = volatile_load<U8>(ip + 13)
  var peer_ip2 = volatile_load<U8>(ip + 14)
  var peer_ip3 = volatile_load<U8>(ip + 15)

  var slot = tcp_find_slot(peer_ip0, peer_ip1, peer_ip2, peer_ip3, src_port, dst_port)
  if slot != 0
    # Existing slot — hand the whole Ethernet frame to its goroutine
    # regardless of current listener status. Routing for in-flight
    # connections must survive listener close. eth_len excludes the
    # 10-byte virtio_net_hdr; the goroutine re-parses eth+ip+tcp.
    tcp_forward_to_slot(slot, eth, buf_bytes - hdr)
    return
  end

  # No existing connection — only SYNs get to allocate a slot, and only
  # if there's a live listener for the destination port.
  var flags = volatile_load<U8>(tcp + 13)
  if (flags & TCP_FLAG_SYN) == 0
    return
  end
  var listen_entry = kern_tcp_listen_lookup(dst_port)
  if listen_entry == 0
    return      # no listener for this port
  end

  var seg_seq = read_be32(tcp, 4)
  var seg_win = read_be16(tcp, 14)
  tcp_accept_syn(eth, ip, tcp,
                 peer_ip0, peer_ip1, peer_ip2, peer_ip3,
                 src_port, seg_seq, seg_win, listen_entry)
end

# Parse an IPv4-encapsulated UDP datagram and dispatch by destination port.
# The IPv4 layer has validated proto=17; we trust it and parse the UDP
# header (8 bytes: src_port, dst_port, length, checksum). Routes to the
# bound handler. WireGuard hook (UDP_WG_PORT) is added by the WG layer
# when std/net/wireguard ships; until then UDP_ECHO_PORT is the only live
# binding (smoke test).
def udp_handle_ipv4(eth: Int, ip: Int, ihl: Int, buf_bytes: Int): Void
  var ip_total = read_be16(ip, 2)
  var udp = ip + (ihl * 4)
  var udp_total = ip_total - (ihl * 4)
  if udp_total < 8
    return    # truncated UDP header
  end
  var src_port = read_be16(udp, 0)
  var dst_port = read_be16(udp, 2)
  var udp_len  = read_be16(udp, 4)
  if udp_len < 8 or udp_len > udp_total
    return    # malformed length field
  end
  var payload     = udp + 8
  var payload_len = udp_len - 8

  g_udp_rx_total = g_udp_rx_total + 1

  # Route by destination port. Open-coded because Phase 1 has two
  # bindings (echo + WG); a real hash-table dispatch is overkill.
  if dst_port == UDP_ECHO_PORT
    udp_handle_echo(eth, ip, udp, payload, payload_len)
  end
  if dst_port == UDP_WG_PORT
    udp_handle_wg(eth, ip, udp, payload, payload_len)
  end
end

# RFC 862 echo: copy the payload back to the sender on the same port pair.
# Used as the NET.1 Phase 1 smoke test before WireGuard goes on top — it
# exercises the full UDP receive + send path with no crypto in the mix.
def udp_handle_echo(eth: Int, ip: Int, udp: Int, payload: Int, payload_len: Int): Void
  uart_put_str("UDP echo: ")
  uart_put_uint(payload_len)
  uart_put_str(" bytes\n")
  udp_send_reply(eth, ip, udp, payload, payload_len)
  g_udp_echo_total = g_udp_echo_total + 1
end

# Send a UDP datagram in reply to an incoming one, swapping MAC / IP / port
# from the inbound frame. Caller passes the inbound eth/ip/udp pointers
# (still inside the virtio RX buffer) plus the new outbound payload. This
# is the responder-only send path — sufficient for echo and for any UDP
# service that only speaks when spoken to (including WG-as-responder).
# Initiator-side send (us → unknown peer) requires ARP resolution and a
# generic udp_send_to(); deferred until WG initiator paths need it.
#
# UDP checksum is left zero — RFC 768 makes it optional in IPv4 and every
# real peer accepts zero. Saves the pseudo-header computation; matches
# what most embedded UDP stacks do.
def udp_send_reply(eth_in: Int, ip_in: Int, udp_in: Int, payload: Int, payload_len: Int): Void
  var buf = g_udp_tx_scratch
  var total_frame_len = 10 + 14 + 20 + 8 + payload_len   # virtio_hdr + eth + ip + udp + data

  # Zero header region (pmm pages are non-zeroed; later writes leave gaps).
  var j = 0
  while j < total_frame_len
    volatile_store<U8>(buf + j, 0)
    j = j + 1
  end

  # Ethernet: dst = peer's src MAC (was eth_in[0..6]), src = our MAC
  # (was eth_in[6..12], i.e. the dst from the inbound frame).
  var k = 0
  while k < 6
    volatile_store<U8>(buf + 10 + k, volatile_load<U8>(eth_in + 0 + k))   # dst = inbound src
    volatile_store<U8>(buf + 16 + k, volatile_load<U8>(eth_in + 6 + k))   # src = inbound dst (us)
    k = k + 1
  end
  volatile_store<U8>(buf + 22, 0x08)
  volatile_store<U8>(buf + 23, 0x00)   # ethertype = IPv4

  # IPv4 (20 bytes)
  var ip = buf + 24
  var ip_total = 20 + 8 + payload_len
  volatile_store<U8>(ip + 0, 0x45)        # ver=4, IHL=5
  write_be16(ip, 2, ip_total)
  volatile_store<U8>(ip + 6, 0x40)        # flags=DF
  volatile_store<U8>(ip + 8, 0x40)        # TTL=64
  volatile_store<U8>(ip + 9, IP_PROTO_UDP)
  # src IP = inbound dst (us); dst IP = inbound src (peer)
  k = 0
  while k < 4
    volatile_store<U8>(ip + 12 + k, volatile_load<U8>(ip_in + 16 + k))   # src = was-dst
    volatile_store<U8>(ip + 16 + k, volatile_load<U8>(ip_in + 12 + k))   # dst = was-src
    k = k + 1
  end
  write_be16(ip, 10, ip_checksum(ip, 20))

  # UDP (8 bytes header + payload)
  var udp = buf + 44
  write_be16(udp, 0, read_be16(udp_in, 2))   # src port = inbound dst
  write_be16(udp, 2, read_be16(udp_in, 0))   # dst port = inbound src
  write_be16(udp, 4, 8 + payload_len)
  write_be16(udp, 6, 0)                      # checksum = 0 (RFC 768 optional)
  k = 0
  while k < payload_len
    volatile_store<U8>(udp + 8 + k, volatile_load<U8>(payload + k))
    k = k + 1
  end

  virtio_net_tx_send(buf, total_frame_len)
end

# Initiator-side outbound UDP TX. Builds eth+ip+udp from scratch using the
# cached gateway MAC (link-layer dst for any non-on-link destination under
# QEMU SLIRP) and our hardcoded 10.0.2.15 source IP. Used by the WG layer
# for unsolicited packets (KEEPALIVE / REKEY / RETRANSMIT MSG_INITIATION)
# where there's no inbound frame to mirror like `udp_send_reply` does.
#
# Returns 0 on success, -1 if the gateway MAC hasn't been learned yet (we
# can't construct a link-layer frame without it) or if `payload_len` would
# exceed the single-page TX scratch.
def udp_send_to(dst_ip_be: Int, dst_port: Int, src_port: Int,
                payload: Int, payload_len: Int): Int
  if g_gateway_mac_known == 0
    return 0 - 1
  end
  var total_frame_len = 10 + 14 + 20 + 8 + payload_len
  if total_frame_len > 4096
    return 0 - 1    # one page per outbound datagram (PMM page = 4 KiB)
  end
  var buf = g_udp_tx_scratch

  var j = 0
  while j < total_frame_len
    volatile_store<U8>(buf + j, 0)
    j = j + 1
  end

  # Ethernet: dst = gateway MAC, src = our MAC, type = IPv4
  volatile_store<U8>(buf + 10, g_gateway_mac0)
  volatile_store<U8>(buf + 11, g_gateway_mac1)
  volatile_store<U8>(buf + 12, g_gateway_mac2)
  volatile_store<U8>(buf + 13, g_gateway_mac3)
  volatile_store<U8>(buf + 14, g_gateway_mac4)
  volatile_store<U8>(buf + 15, g_gateway_mac5)
  volatile_store<U8>(buf + 16, g_vnet_mac0)
  volatile_store<U8>(buf + 17, g_vnet_mac1)
  volatile_store<U8>(buf + 18, g_vnet_mac2)
  volatile_store<U8>(buf + 19, g_vnet_mac3)
  volatile_store<U8>(buf + 20, g_vnet_mac4)
  volatile_store<U8>(buf + 21, g_vnet_mac5)
  volatile_store<U8>(buf + 22, 0x08)
  volatile_store<U8>(buf + 23, 0x00)

  # IPv4 (20 bytes)
  var ip = buf + 24
  var ip_total = 20 + 8 + payload_len
  volatile_store<U8>(ip + 0, 0x45)         # ver=4, IHL=5
  write_be16(ip, 2, ip_total)
  volatile_store<U8>(ip + 6, 0x40)         # flags=DF
  volatile_store<U8>(ip + 8, 0x40)         # TTL=64
  volatile_store<U8>(ip + 9, IP_PROTO_UDP)
  # src = 10.0.2.15 (our SLIRP-assigned address — matches what we ARP for)
  volatile_store<U8>(ip + 12, 0x0A)
  volatile_store<U8>(ip + 13, 0x00)
  volatile_store<U8>(ip + 14, 0x02)
  volatile_store<U8>(ip + 15, 0x0F)
  # dst = caller-supplied (network byte order in `dst_ip_be`)
  volatile_store<U8>(ip + 16, dst_ip_be & 255)
  volatile_store<U8>(ip + 17, (dst_ip_be >> 8) & 255)
  volatile_store<U8>(ip + 18, (dst_ip_be >> 16) & 255)
  volatile_store<U8>(ip + 19, (dst_ip_be >> 24) & 255)
  write_be16(ip, 10, ip_checksum(ip, 20))

  # UDP (8 bytes header + payload)
  var udp = buf + 44
  write_be16(udp, 0, src_port)
  write_be16(udp, 2, dst_port)
  write_be16(udp, 4, 8 + payload_len)
  write_be16(udp, 6, 0)                    # checksum = 0 (RFC 768 optional)
  var k = 0
  while k < payload_len
    volatile_store<U8>(udp + 8 + k, volatile_load<U8>(payload + k))
    k = k + 1
  end

  virtio_net_tx_send(buf, total_frame_len)
  return 0
end

# --- WireGuard glue (NET.1 Phase 1, Step 2.5) -----------------------
# Bridges the std/net/wireguard userspace stack to the unikernel's UDP
# layer. The Device's static keypair is RDSEED/RDRAND-seeded at boot
# (rng_new_hw); from there everything else is platform-portable
# (`std/net/wireguard/*` works identically on POSIX and freestanding —
# the only delta is the entropy source).
#
# Phase 1 is responder-only: when an inbound MSG_INITIATION arrives
# from a peer whose static pubkey is in our table, we build the
# MSG_RESPONSE and ship it back via udp_send_reply (same eth/ip/udp
# header as the inbound, payload swapped). MSG_DATA gets decrypted +
# logged (a real implementation would inject the inner-IP packet
# back into the IP stack via `ip_handle_frame`; that wiring is Step
# 2.6 territory once interop validates the keys).

# Initialize the WG device. Called from main() once after the slab
# allocator + asset table are up. Safe to call before networking
# (just allocates and seeds the keypair). Fatal if RDSEED/RDRAND are
# both unavailable — better than booting WG with weak entropy.
def wg_init(): Void
  if g_wg_initialized == 1
    return
  end
  g_wg_msg_scratch = pmm_alloc_page()
  g_wg_inner_scratch = pmm_alloc_page()
  # The cookie src-addr scratch is 6 bytes; carve a 16-byte slot off the
  # tail of g_wg_inner_scratch (which is otherwise oversized at one PMM page
  # for ~1500-byte inner-IP injection). Keeps the per-page allocation count
  # constant.
  g_wg_src_addr_scratch = g_wg_inner_scratch + 4080
  g_wg_device = wg_device_new_hw()
  g_wg_initialized = 1
  # Dump the full 32-byte static_pub as 64 hex chars on its own line,
  # marker-prefixed so a host-side test harness can grep+slurp it. The
  # marker `WG_PUBKEY_HEX=` is load-bearing for `quake baremetal:qemu_wg_interop`.
  uart_put_str("WG_PUBKEY_HEX=")
  var pk = wg_device_static_pub(g_wg_device)
  var n = 0
  while n < 32
    uart_put_hex2(volatile_load<U8>(pk + n))
    n = n + 1
  end
  uart_putc(10)
  uart_put_str("WG: device initialized, listening on :")
  uart_put_uint(UDP_WG_PORT)
  uart_putc(10)
  # Run the operator-supplied peer config (Step 2.6). The default file
  # at tools/baremetal/wg_peer_config.qz is a no-op; the interop Quake
  # task replaces it with a real wg_device_add_peer call.
  wg_demo_install_peer()
end

# Inbound WG packet dispatcher. Called from udp_handle_ipv4 when
# dst_port == UDP_WG_PORT. Routes by the message-type byte and then
# by lookup into the device peer table.
def udp_handle_wg(eth: Int, ip: Int, udp: Int, payload: Int, payload_len: Int): Void
  if g_wg_initialized == 0
    g_wg_rx_dropped = g_wg_rx_dropped + 1
    return    # boot raced ahead of wg_init somehow; shouldn't happen
  end
  if payload_len < 1
    g_wg_rx_dropped = g_wg_rx_dropped + 1
    return
  end

  var msg_type = volatile_load<U8>(payload + 0)
  var now_ms = wg_now_ms()

  # Periodic cookie-secret rotation gets a chance every inbound packet so
  # the secret stays fresh even when wg_device_tick is starved.
  wg_device_rotate_cookie_secret_if_due(g_wg_device, now_ms)

  if msg_type == WG_MSG_INITIATION
    if payload_len != WG_INITIATION_LEN
      g_wg_rx_dropped = g_wg_rx_dropped + 1
      return
    end
    g_wg_rx_initiation = g_wg_rx_initiation + 1
    # Bump the per-second handshake-inbound counter for under-load auto-
    # detection; if 8+ within the same second, under_load flips to 1.
    wg_device_note_handshake_inbound(g_wg_device, now_ms)
    # Under-load DoS defense (WG paper §5.4.7). If the inbound's mac2 doesn't
    # validate against MAC(cookie(τ_R, src_addr), msg_α||mac1), reply with a
    # cookie reply and drop the inbound.
    _wg_extract_src_addr(g_wg_src_addr_scratch, ip, udp)
    if wg_device_should_cookie_reply(g_wg_device, payload, 116,
                                     g_wg_src_addr_scratch, 6, now_ms) == 1
      var ck_len = wg_device_emit_cookie_reply(g_wg_device, payload, 116,
                                               g_wg_src_addr_scratch, 6,
                                               g_wg_msg_scratch, now_ms)
      udp_send_reply(eth, ip, udp, g_wg_msg_scratch, ck_len)
      g_wg_tx_cookie = g_wg_tx_cookie + 1
      return
    end
    var peer_idx_init = wg_device_handle_initiation(g_wg_device, payload, g_wg_msg_scratch, now_ms)
    if peer_idx_init >= 0
      udp_send_reply(eth, ip, udp, g_wg_msg_scratch, WG_RESPONSE_LEN)
      g_wg_tx_response = g_wg_tx_response + 1
      _wg_capture_endpoint(peer_idx_init, ip, udp)
    else
      g_wg_rx_dropped = g_wg_rx_dropped + 1
    end
    return
  end

  if msg_type == WG_MSG_RESPONSE
    if payload_len != WG_RESPONSE_LEN
      g_wg_rx_dropped = g_wg_rx_dropped + 1
      return
    end
    g_wg_rx_response = g_wg_rx_response + 1
    wg_device_note_handshake_inbound(g_wg_device, now_ms)
    _wg_extract_src_addr(g_wg_src_addr_scratch, ip, udp)
    if wg_device_should_cookie_reply(g_wg_device, payload, 60,
                                     g_wg_src_addr_scratch, 6, now_ms) == 1
      var ck_len = wg_device_emit_cookie_reply(g_wg_device, payload, 60,
                                               g_wg_src_addr_scratch, 6,
                                               g_wg_msg_scratch, now_ms)
      udp_send_reply(eth, ip, udp, g_wg_msg_scratch, ck_len)
      g_wg_tx_cookie = g_wg_tx_cookie + 1
      return
    end
    var rc = wg_device_handle_response(g_wg_device, payload, now_ms)
    if rc != 0
      g_wg_rx_dropped = g_wg_rx_dropped + 1
    end
    return
  end

  if msg_type == WG_MSG_COOKIE
    if payload_len != WG_COOKIE_REPLY_LEN
      g_wg_rx_dropped = g_wg_rx_dropped + 1
      return
    end
    g_wg_rx_cookie = g_wg_rx_cookie + 1
    var ck_peer = wg_device_handle_cookie_reply(g_wg_device, payload, payload_len, now_ms)
    if ck_peer < 0
      g_wg_rx_dropped = g_wg_rx_dropped + 1
    end
    return
  end

  if msg_type == WG_MSG_DATA
    # Minimum data packet: 16-byte header + 16-byte tag. 32 is the floor
    # (zero-payload keepalive: header + tag, no ciphertext).
    if payload_len < 32
      g_wg_rx_dropped = g_wg_rx_dropped + 1
      return
    end
    var peer_idx_buf = g_wg_msg_scratch + (WG_MSG_SCRATCH_SIZE - 4)
    var pt_out = g_wg_msg_scratch
    var pt_len = wg_device_handle_data(g_wg_device, payload, payload_len, pt_out, peer_idx_buf, now_ms)
    if pt_len < 0
      g_wg_rx_dropped = g_wg_rx_dropped + 1
      return
    end
    g_wg_rx_data = g_wg_rx_data + 1
    # Endpoint-roaming (WG paper §6.2): every successfully decrypted
    # inbound packet refreshes the peer's last-known endpoint so any
    # subsequent unsolicited TX (keepalive, rekey) reaches the right
    # IP:port even if the peer roamed since handshake.
    var peer_idx_data = ptr_read_byte(peer_idx_buf) +
                        (ptr_read_byte(peer_idx_buf + 1) * 256) +
                        (ptr_read_byte(peer_idx_buf + 2) * 65536) +
                        (ptr_read_byte(peer_idx_buf + 3) * 16777216)
    _wg_capture_endpoint(peer_idx_data, ip, udp)
    # Inject the decrypted inner-IP packet back into our IP stack. A
    # zero-byte plaintext is a keepalive — no inner packet to forward;
    # the recv_data lifecycle hook already ran, that's all the keepalive
    # asks of us.
    _wg_inject_inner_ip(pt_out, pt_len)
    return
  end

  # Anything else is malformed.
  g_wg_rx_dropped = g_wg_rx_dropped + 1
end

# Source-address scratch for cookie reply (4-byte IPv4 + 2-byte port).
# Reused across calls.
var g_wg_src_addr_scratch = 0

# Build the 6-byte src addr buffer (IPv4 in network order || port in be16)
# for `wg_compute_cookie`. Format is implementation-internal — both should-
# reply and emit use the same buf, so the cookie value is consistent.
def _wg_extract_src_addr(out_6: Int, ip_in: Int, udp_in: Int): Void
  ptr_write_byte(out_6, volatile_load<U8>(ip_in + 12))
  ptr_write_byte(out_6 + 1, volatile_load<U8>(ip_in + 13))
  ptr_write_byte(out_6 + 2, volatile_load<U8>(ip_in + 14))
  ptr_write_byte(out_6 + 3, volatile_load<U8>(ip_in + 15))
  var port = read_be16(udp_in, 0)
  ptr_write_byte(out_6 + 4, (port >> 8) & 255)
  ptr_write_byte(out_6 + 5, port & 255)
end

# Wall-clock-ish millisecond reader for WG timer state. Phase 1 derives
# from g_tick_count (LAPIC timer; see APIC_REG_INITIAL programming for
# the actual rate — currently ~10 ms / tick under QEMU TCG). Coarse but
# adequate for WG's 5/10/120/180-second protocol timers. KERN.x will
# replace this with a TSC-backed monotonic reader.
def wg_now_ms(): Int
  return g_tick_count * 10
end

# Refresh peer.endpoint with the inbound frame's IP src + UDP src port.
# Called after every successfully validated inbound MSG_INITIATION /
# MSG_DATA. Implements WG roaming (paper §6.2): the peer's last-known
# endpoint always tracks where its packets are actually arriving from.
# The first call also gives outbound TX (keepalive, rekey) somewhere to
# send to — without this, a responder-mode boot has no peer endpoint at
# all.
def _wg_capture_endpoint(peer_idx: Int, ip_in: Int, udp_in: Int): Void
  if peer_idx < 0
    return
  end
  var ip_be = volatile_load<U8>(ip_in + 12) |
              (volatile_load<U8>(ip_in + 13) << 8) |
              (volatile_load<U8>(ip_in + 14) << 16) |
              (volatile_load<U8>(ip_in + 15) << 24)
  var port = read_be16(udp_in, 0)
  wg_device_update_endpoint(g_wg_device, peer_idx, ip_be, port)
end

# Inject a decrypted inner-IP packet back into the unikernel's IP stack.
# Builds a synthetic Ethernet header (dst = our MAC, src = gateway MAC,
# ethertype = IPv4) into g_wg_inner_scratch and re-enters via
# ip_handle_frame_at. Padding is stripped using the IP header's own
# total_length field — WG pads to 16-byte multiples but the IP layer
# carries its own length, so trailing pad bytes are harmless if we cap
# at total_length.
def _wg_inject_inner_ip(pt: Int, pt_len: Int): Void
  if pt_len <= 0
    return    # keepalive (zero-length plaintext) — nothing to forward
  end
  if pt_len < 20
    return    # not even a minimal IPv4 header
  end
  var ver = (volatile_load<U8>(pt + 0) >> 4) & 0xF
  if ver != 4
    return    # IPv6 in tunnel — Phase 2 (unikernel has no IPv6)
  end
  var inner_total = (volatile_load<U8>(pt + 2) << 8) | volatile_load<U8>(pt + 3)
  if inner_total < 20 or inner_total > pt_len
    return    # malformed — caller should not have decrypted in the first place
  end
  if g_gateway_mac_known == 0
    return    # haven't seen any inbound IP frame yet — no link-layer src to fake
  end
  var eth = g_wg_inner_scratch
  # dst = our MAC
  volatile_store<U8>(eth + 0, g_vnet_mac0)
  volatile_store<U8>(eth + 1, g_vnet_mac1)
  volatile_store<U8>(eth + 2, g_vnet_mac2)
  volatile_store<U8>(eth + 3, g_vnet_mac3)
  volatile_store<U8>(eth + 4, g_vnet_mac4)
  volatile_store<U8>(eth + 5, g_vnet_mac5)
  # src = gateway MAC (the synthetic frame "looks like" it came from
  # outside; the IP layer never reads link-layer src for routing).
  volatile_store<U8>(eth + 6, g_gateway_mac0)
  volatile_store<U8>(eth + 7, g_gateway_mac1)
  volatile_store<U8>(eth + 8, g_gateway_mac2)
  volatile_store<U8>(eth + 9, g_gateway_mac3)
  volatile_store<U8>(eth + 10, g_gateway_mac4)
  volatile_store<U8>(eth + 11, g_gateway_mac5)
  # ethertype = IPv4
  volatile_store<U8>(eth + 12, 0x08)
  volatile_store<U8>(eth + 13, 0x00)
  var k = 0
  while k < inner_total
    volatile_store<U8>(eth + 14 + k, volatile_load<U8>(pt + k))
    k = k + 1
  end
  g_wg_rx_inner_routed = g_wg_rx_inner_routed + 1
  ip_handle_frame_at(eth, 14 + inner_total)
end

# Periodic WG driver. Called once per serve-loop iteration. Walks the
# peer table, calls wg_timers_tick on each peer's timer block, and
# dispatches the returned action mask. Step 2.6 wires the outbound TX
# paths: SEND_KEEPALIVE / REKEY / RETRANSMIT now actually emit packets
# via udp_send_to using the peer's last-known endpoint (learned on each
# successful inbound recv — see `_wg_capture_endpoint`). GIVE_UP and
# REJECT_SESSION remain pure local-state transitions.
def wg_device_tick(now_ms: Int): Void
  if g_wg_initialized == 0
    return
  end
  # Rotate the cookie secret if it's been ≥120s. Per WG paper §5.4.7 +
  # §6.5: the previous secret stays valid for an additional 60s grace
  # window so initiators caching a fresh-but-rotating cookie don't get
  # bounced into a second cookie reply.
  wg_device_rotate_cookie_secret_if_due(g_wg_device, now_ms)
  var i = 0
  while i < g_wg_device.peers.size
    var dp = g_wg_device.peers[i]
    var actions = wg_timers_tick(dp.timers, now_ms)
    if (actions & WG_ACTION_GIVE_UP_HANDSHAKE) != 0
      wg_device_peer_drop_handshake(g_wg_device, i)
    end
    if (actions & WG_ACTION_REJECT_SESSION) != 0
      wg_device_peer_drop_session(g_wg_device, i)
    end
    if (actions & WG_ACTION_SEND_KEEPALIVE) != 0
      _wg_tick_send_keepalive(i, now_ms)
    end
    # Rekey vs retransmit: REKEY fires on the 120s anniversary of session
    # establishment (initiator only); RETRANSMIT fires every 5s while a
    # MSG_INITIATION is unanswered. Both shape an outbound MSG_INITIATION
    # via wg_device_initiate_handshake — the new session lands in the
    # peer's `next` slot until first send/recv promotes it (multi-session
    # generations, WG paper §6.5).
    if (actions & WG_ACTION_REKEY) != 0
      _wg_tick_rekey(i, now_ms)
    end
    if (actions & WG_ACTION_RETRANSMIT_HANDSHAKE) != 0
      _wg_tick_retransmit(i, now_ms)
    end
    # Reap stale `previous` (>= REJECT_AFTER_TIME). Drops the old
    # rekey-overlap session once it has aged out — bounds memory growth
    # in the long-idle case.
    wg_device_peer_gc_stale(g_wg_device, i, now_ms)
    i = i + 1
  end
end

# Send a zero-payload data packet (WG keepalive, paper §6.5). The
# wg_device_send_data path bails with -1 if there's no current/next
# session, so the explicit pre-check is unnecessary. On success, marks
# `keepalive_sent` on the timer block so duplicate fires within the 10s
# window are suppressed.
def _wg_tick_send_keepalive(peer_idx: Int, now_ms: Int): Void
  var dp = g_wg_device.peers[peer_idx]
  if dp.peer.endpoint.port == 0
    return
  end
  var wire_len = wg_device_send_data(g_wg_device, peer_idx, 0, 0,
                                     g_wg_msg_scratch, now_ms)
  if wire_len < 0
    return
  end
  if udp_send_to(dp.peer.endpoint.ip_be, dp.peer.endpoint.port,
                 UDP_WG_PORT, g_wg_msg_scratch, wire_len) != 0
    return
  end
  g_wg_tx_keepalive = g_wg_tx_keepalive + 1
  wg_device_peer_mark_keepalive_sent(g_wg_device, peer_idx, now_ms)
end

# Initiator-side rekey trigger (120s after session establishment, our
# side only). Builds a fresh MSG_INITIATION via wg_device_initiate_handshake
# and ships it. The new handshake state replaces any in-flight one. The
# old session stays live (in the `current` slot) and the new one will
# land in `next` once MSG_RESPONSE arrives — first send/recv on it
# promotes per WG paper §6.5.
def _wg_tick_rekey(peer_idx: Int, now_ms: Int): Void
  var dp = g_wg_device.peers[peer_idx]
  if dp.peer.endpoint.port == 0
    return    # no endpoint learned yet — can't initiate
  end
  var rc = wg_device_initiate_handshake(g_wg_device, peer_idx,
                                        g_wg_msg_scratch, now_ms)
  if rc < 0
    return
  end
  var dp2 = g_wg_device.peers[peer_idx]
  if udp_send_to(dp2.peer.endpoint.ip_be, dp2.peer.endpoint.port,
                 UDP_WG_PORT, g_wg_msg_scratch, WG_INITIATION_LEN) != 0
    return
  end
  g_wg_tx_rekey = g_wg_tx_rekey + 1
end

# RETRANSMIT_HANDSHAKE — peer didn't respond to our last MSG_INITIATION
# within REKEY_TIMEOUT (5s). Send a fresh one. The Noise IKpsk2 ephemeral
# is regenerated each attempt (constant-time discipline; reuse would leak
# entropy). The timer block re-arms via wg_timers_handshake_retransmitted
# inside wg_device_initiate_handshake's epilogue (the handshake_started
# hook does that for us — re-fired here).
def _wg_tick_retransmit(peer_idx: Int, now_ms: Int): Void
  var dp = g_wg_device.peers[peer_idx]
  if dp.peer.endpoint.port == 0
    return
  end
  var rc = wg_device_initiate_handshake(g_wg_device, peer_idx,
                                        g_wg_msg_scratch, now_ms)
  if rc < 0
    return
  end
  var dp2 = g_wg_device.peers[peer_idx]
  if udp_send_to(dp2.peer.endpoint.ip_be, dp2.peer.endpoint.port,
                 UDP_WG_PORT, g_wg_msg_scratch, WG_INITIATION_LEN) != 0
    return
  end
  g_wg_tx_rekey = g_wg_tx_rekey + 1
end

# Hex-dump the first received ethernet frame, skipping the legacy
# virtio_net_hdr (10 bytes — no num_buffers field in legacy). 16
# bytes per line. Truncates at 96 bytes to keep the serial log
# readable — that's enough to show eth header + ARP / ICMP headers
# which is what we'll actually care about debugging.
def virtio_net_dump_frame(buf_bytes: Int): Void
  var hdr_len = 10                    # legacy virtio_net_hdr
  var frame_len = buf_bytes - hdr_len
  uart_put_str("RX frame: ")
  uart_put_uint(frame_len)
  uart_put_str(" bytes\n")

  var cap = frame_len
  if cap > 96
    cap = 96
  end
  var i = 0
  while i < cap
    if (i & 15) == 0
      if i > 0
        uart_putc(10)
      end
      uart_put_str("  ")
    end
    var byte = volatile_load<U8>(g_vnet_rx_buf + hdr_len + i)
    uart_put_hex2(byte)
    uart_putc(32)   # ' '
    i = i + 1
  end
  uart_putc(10)
  if cap < frame_len
    uart_put_str("  ... (truncated)\n")
  end
end

# --- Physical memory manager (PMM) ---------------------------------
# Bump allocator over the 1 MiB .bss pool that boot_trampoline_x86.s
# reserves. Monotonic, no reclamation — a real kernel layers a buddy
# or freelist over the bump for startup, then retires the bump once
# the richer allocator is live.

def pmm_init(): Void
  # Idempotent: only initialize if pmm_alloc_page hasn't already
  # lazy-init'd via the auto-bootstrap below. SOUL.2 (2026-05-09)
  # made the pool bounds runtime-set instead of static-addressed,
  # which surfaced that some Quartz module initializers (notably
  # `g_wg_device.peers = vec_new<DevicePeer>()`) call malloc before
  # main runs. To handle that cleanly, pmm_alloc_page lazy-runs
  # pvh_probe_ram + sets g_pmm_next on first call. pmm_init is now
  # the explicit "I'm ready, init from main" entry point — but if
  # the lazy path beat it, we leave g_pmm_next where it is.
  if g_pmm_next == 0
    g_pmm_next = get_pmm_pool_start()
  end
end

# SOUL.2 (2026-05-09): find a usable PVH start_info struct.
#
# Strategy (in order of preference):
#   1. EBX-saved pointer from boot trampoline (PVH spec canonical)
#   2. EDI-saved pointer (some QEMU paths use this)
#   3. Scan low memory 0x1000..0x200000 in 16-byte steps for the
#      magic value 0x336EC578 — handles loaders that don't pass
#      the address in a register at all.
#
# Each candidate is validated: address must be in low memory (< 1 GiB)
# and 4-byte aligned, AND the magic field at offset 0 must match
# 0x336EC578 (per xen.git start_info.h). A wild dereference would
# triple-fault on QEMU `-no-reboot` and silently halt the VM with no
# diagnostic — hence the strict pre-validation.
#
# Note: the boot trampoline identity-maps up to 16 GiB (see
# boot_trampoline_x86.s — PDPT[0..15] using 2 MiB or 1 GiB huge pages),
# so much higher addresses are dereferenceable too. The 1 GiB bound
# here is intentionally conservative — qemu's PVH loader places the
# start_info struct in low memory (typically < 1 MiB), so anything
# above 1 GiB is overwhelmingly more likely to be a register containing
# garbage than a legitimate struct address.
#
# Returns the validated address, or 0 if no PVH struct found.
def pvh_find_start_info(): Int
  var pvh_magic = 0x336EC578
  var bound = 0x40000000   # 1 GiB — conservative low-memory check (see note above)

  # Candidate 1: EBX-saved (canonical PVH).
  var ebx = get_pvh_start_info()
  if ebx != 0 and ebx < bound and (ebx & 3) == 0
    if volatile_load<U32>(ebx + 0) == pvh_magic
      return ebx
    end
  end

  # Candidate 2: EDI-saved (some QEMU paths).
  var edi = get_pvh_start_info_alt()
  if edi != 0 and edi < bound and (edi & 3) == 0
    if volatile_load<U32>(edi + 0) == pvh_magic
      return edi
    end
  end

  # Candidate 3: scan low memory for the magic. The PVH start_info
  # is normally placed below 1 MiB by QEMU's loader. Scan 4 KiB
  # through 2 MiB in 16-byte steps (struct is 8-byte aligned per
  # spec; 16-byte step is conservative).
  var scan = 0x1000
  var scan_end = 0x200000
  while scan < scan_end
    if volatile_load<U32>(scan + 0) == pvh_magic
      return scan
    end
    scan = scan + 16
  end

  return 0
end

# SOUL.2: walk the PVH start_info memmap and configure the runtime
# PMM pool from the largest contiguous Type=1 (System RAM) region
# above the kernel-image floor. Total RAM (sum of all Type=1 region
# sizes) is also recorded for the dashboard "Detected RAM" card.
# Must be called BEFORE pmm_init.
#
# PVH start_info layout (xen/include/public/arch-x86/hvm/start_info.h):
#   +0   uint32 magic        = 0x336EC578 ("xEn?\0" with byte 1 = 0xC5)
#   +4   uint32 version
#   +8   uint32 flags
#   +12  uint32 nr_modules
#   +16  uint64 modlist_paddr
#   +24  uint64 cmdline_paddr
#   +32  uint64 rsdp_paddr
#   +40  uint64 memmap_paddr   (only present if version >= 1)
#   +48  uint32 memmap_entries
#
# memmap entry (24 bytes each — hvm_memmap_table_entry):
#   +0   uint64 addr
#   +8   uint64 size
#   +16  uint32 type   (1 = E820_RAM, the only one we use)
#
# Kernel floor: 16 MiB — conservative. Image loaded at 1 MiB; .text +
# .rodata + .data + page tables / IDT / stack in .bss totals well
# under 8 MiB. 16 MiB gives 8 MiB safety pad.
def pvh_probe_ram(): Void
  # PVH spec says start_info pointer is in EBX; some QEMU paths use
  # EDI; some place the struct at fixed low-memory addresses without
  # passing a register pointer. Try each candidate, validating the
  # address looks reasonable (within first 1 GiB identity-map and
  # 4-byte aligned) before dereferencing — a wild address would
  # triple-fault on the magic read and silently halt the VM.
  var info = pvh_find_start_info()
  if info == 0
    # No PVH start_info found. Install a conservative fallback pool
    # so the kernel can boot and we can debug from inside it: 64 MiB
    # starting at 16 MiB (matches the pre-SOUL.2 static pool size).
    pmm_set_pool_bounds(16 * 1024 * 1024, 80 * 1024 * 1024, 128 * 1024 * 1024)
    return
  end

  var memmap_paddr = volatile_load<U64>(info + 40)
  var memmap_entries = volatile_load<U32>(info + 48)

  var kernel_floor = 16 * 1024 * 1024
  var total_ram = 0
  var best_start = 0
  var best_size = 0

  var i = 0
  while i < memmap_entries
    var entry = memmap_paddr + (i * 24)
    var addr = volatile_load<U64>(entry + 0)
    var size = volatile_load<U64>(entry + 8)
    var rtype = volatile_load<U32>(entry + 16)
    if rtype == 1
      total_ram = total_ram + size
      # Trim the region to start at or above the kernel floor.
      var usable_start = addr
      var usable_end = addr + size
      if usable_start < kernel_floor
        usable_start = kernel_floor
      end
      if usable_end > usable_start
        var usable_size = usable_end - usable_start
        if usable_size > best_size
          best_start = usable_start
          best_size = usable_size
        end
      end
    end
    i = i + 1
  end

  if best_size == 0
    # Same fallback as the no-start_info case — let the kernel boot,
    # logs from main() will tell us what happened.
    pmm_set_pool_bounds(16 * 1024 * 1024, 80 * 1024 * 1024, 128 * 1024 * 1024)
    return
  end

  pmm_set_pool_bounds(best_start, best_start + best_size, total_ram)
end

# Print the post-probe PMM/RAM summary. Called from main() AFTER
# uart_init — pvh_probe_ram itself runs at module-init time when
# uart_putc would hang on an uninitialized 16550 LSR check.
def pvh_log_summary(): Void
  var ram = get_detected_ram_bytes()
  var pool_start = get_pmm_pool_start()
  var pool_end = get_pmm_pool_end()
  var pool_size = pool_end - pool_start
  if ram == 0
    uart_put_str("PVH: probe failed; using 64 MiB fallback pool at 16 MiB\n")
  else
    uart_put_str("PVH: detected #{ram / (1024 * 1024)} MiB RAM, PMM pool #{pool_size / (1024 * 1024)} MiB at ")
    uart_put_hex(pool_start)
    uart_put_str("\n")
  end
end

# How many bytes / pages have been handed out so far.
def pmm_used_bytes(): Int
  g_pmm_next - get_pmm_pool_start()
end

def pmm_used_pages(): Int
  pmm_used_bytes() / 4096
end

# Total pool capacity.
def pmm_total_bytes(): Int
  get_pmm_pool_end() - get_pmm_pool_start()
end

def pmm_total_pages(): Int
  pmm_total_bytes() / 4096
end

# Allocate one 4 KiB page. Panics (halts) on out-of-memory.
#
# Auto-bootstrap path (SOUL.2): if g_pmm_next is still 0, this is the
# first allocation in the kernel's lifetime — possibly from a Quartz
# module initializer running before main() (e.g. g_wg_device.peers =
# vec_new<DevicePeer>() at file scope). Lazy-run pvh_probe_ram and
# install the runtime pool bounds, then proceed. This makes the PMM
# self-correcting regardless of who calls first; pmm_init from main
# becomes idempotent housekeeping rather than a load-bearing init.
def pmm_alloc_page(): Int
  if g_pmm_next == 0
    pvh_probe_ram()
    g_pmm_next = get_pmm_pool_start()
  end
  # Path C.5.5 — under SMP, BSP (HTTP arena/slab refills) and APs (ss_refill on
  # task park) bump this cursor concurrently. Without the lock, two CPUs read
  # the same g_pmm_next and both return the same page → aliased physical memory.
  # The lock is 0 during early boot (before kern8_pcpu_init creates it), when
  # allocation is single-threaded — the guard skips locking then. Leaf lock:
  # the critical section calls nothing that takes another lock.
  var lk = g_pmm_lock
  if lk != 0
    spinlock_lock(lk)
  end
  if g_pmm_next + 4096 > get_pmm_pool_end()
    uart_putc(79)   # 'O'
    uart_putc(79)   # 'O'
    uart_putc(77)   # 'M'
    uart_putc(10)
    @c("cli; 1: hlt; jmp 1b")
  end
  var addr = g_pmm_next
  g_pmm_next = g_pmm_next + 4096
  if lk != 0
    spinlock_unlock(lk)
  end
  return addr
end

# Path C.5.5 — allocate `n` PHYSICALLY CONTIGUOUS 4 KiB pages in ONE
# atomic bump. Returns the base of the n-page run; the caller may treat
# [base, base + n*4096) as a single contiguous chunk.
#
# Why this exists: callers that record a multi-page allocation's size over
# the whole span (the libc multi-page bump allocator's `chosen->size`, the
# 16 KiB class-3 saved-stack chunk) REQUIRE the pages to be sequential. A
# per-page `pmm_alloc_page()` loop does NOT guarantee that under SMP: an AP
# bumping g_pmm_next (via ss_refill → pmm_alloc_page) between two iterations
# steals a middle page, so the "contiguous" chunk overlaps a page already
# handed to a parked task's saved-stack buffer → frame corruption → wild-RSP
# on resume (PATH_C_STACK_ON_DEMAND.md §12.8 #2, proven by the
# [PMM-NONCONTIG] detector). Taking g_pmm_lock ONCE across the whole bump
# makes the run atomic w.r.t. every other PMM consumer.
#
# Leaf PMM op: holds only g_pmm_lock (lock order TASKPOOL → SS → PMM; this
# is the PMM tail). Mirrors pmm_alloc_page's lazy-bootstrap + OOM-halt.
# n >= 1 required (n == 1 degenerates to a single-page bump, same as
# pmm_alloc_page).
def pmm_alloc_pages_contig(n: Int): Int
  if g_pmm_next == 0
    pvh_probe_ram()
    g_pmm_next = get_pmm_pool_start()
  end
  var lk = g_pmm_lock
  if lk != 0
    spinlock_lock(lk)
  end
  var span = n * 4096
  if g_pmm_next + span > get_pmm_pool_end()
    uart_putc(79)   # 'O'
    uart_putc(79)   # 'O'
    uart_putc(77)   # 'M'
    uart_putc(10)
    @c("cli; 1: hlt; jmp 1b")
  end
  var base = g_pmm_next
  g_pmm_next = g_pmm_next + span
  if lk != 0
    spinlock_unlock(lk)
  end
  return base
end

# Zero a whole 4 KiB page. No memset intrinsic on the freestanding
# path, so we do this by hand. 8-byte stores — 512 word writes per
# page instead of 4096 byte writes.
def pmm_zero_page(addr: Int): Void
  var i = 0
  while i < 512
    store(addr, i * 8, 0)
    i = i + 1
  end
end

# --- Context-switched task helpers ---------------------------------

# Address of task_rsp_table[idx]. Callers pass this to switch_to as the
# raw pointer to the saved-RSP slot.
def task_slot(idx: Int): Int
  return g_task_slot_addr + (idx * 8)
end

# Seed a fresh task's stack so that the first `switch_to` into it lands
# on `entry_fn`.
#
# switch_to's resume path pops six callee-saved regs (r15..rbx) then
# `ret`s. To bootstrap a task we lay down a fake frame that looks like
# the task was suspended mid-switch_to: seven qwords on its stack in
# the exact order the `ret` sequence expects to pop them, with `ret`
# popping `entry_fn` as its "return address".
#
# Alignment: x86-64 SysV ABI requires rsp to be 8 (mod 16) at function
# entry (i.e., right after a callq). pmm_alloc_page returns 4 KiB-
# aligned pages so `top = stack_base + 4096` is 16-aligned. We place
# entry_fn at address `top - 16` (also 16-aligned), so after switch_to's
# seeded `ret` pops it, rsp = top - 8 which is 8 (mod 16). The 8 bytes
# at `top - 8` become unused padding.
#
# Stack layout after seeding (high addr → low addr):
#   top:          <never read>
#   top -  8:     <padding>
#   top - 16:     entry_fn   ← `ret` target
#   top - 24:     0 (rbx)
#   top - 32:     0 (rbp)
#   top - 40:     0 (r12)
#   top - 48:     0 (r13)
#   top - 56:     0 (r14)
#   top - 64:     0 (r15)   ← saved rsp points here
def task_init_stack(stack_base: Int, entry_fn: Int): Int
  var top = stack_base + TASK_STACK_BYTES
  var sp = top - 16
  store(sp, 0, entry_fn)          # ret address popped by `retq`
  sp = sp - 8
  store(sp, 0, 0)                 # saved rbx
  sp = sp - 8
  store(sp, 0, 0)                 # saved rbp
  sp = sp - 8
  store(sp, 0, 0)                 # saved r12
  sp = sp - 8
  store(sp, 0, 0)                 # saved r13
  sp = sp - 8
  store(sp, 0, 0)                 # saved r14
  sp = sp - 8
  store(sp, 0, 0)                 # saved r15 — first popped by switch_to
  return sp
end

# Task A body — prints "A1 " .. "A5 " with a yield to the scheduler
# between each line. Each iteration's local `i` lives on task A's
# private 4 KiB stack, so if stacks collided or RSP save/restore were
# buggy, the sequence would lie.
def task_a_body(): Void
  var i = 1
  while i <= 5
    uart_put_str("A#{i} ")
    i = i + 1
    switch_to(task_slot(1), task_slot(0))
  end
  g_task_a_done = 1
  switch_to(task_slot(1), task_slot(0))
  # Unreachable — scheduler skips done tasks. Park defensively.
  @c("cli; 1: hlt; jmp 1b")
end

# Task B — mirror of task A, with '\n' after "B5 " so terminal output
# wraps before "sched done".
def task_b_body(): Void
  var i = 1
  while i <= 5
    uart_put_str("B#{i} ")
    i = i + 1
    switch_to(task_slot(2), task_slot(0))
  end
  uart_putc(10)
  g_task_b_done = 1
  switch_to(task_slot(2), task_slot(0))
  @c("cli; 1: hlt; jmp 1b")
end

# ====================================================================
# N-on-1 channels (DEF-E-N1 phase 2).
#
# Bounded FIFO channels with cooperative block-on-full/empty semantics.
# Senders full-block push their task onto send_waiters; receivers
# empty-block push onto recv_waiters. Every successful send wakes one
# recv waiter; every successful recv wakes one send waiter. Closing
# the channel wakes all recv waiters so they drain + return the
# "closed and empty" sentinel (0).
#
# Memory: each channel lives in a single 4 KiB PMM page — 40-byte
# header + up to ~506 U64 buffer slots. The caller picks cap at
# chan_new() time and must not exceed CHAN_BUFFER_MAX.
#
# Phase-2 limitation: payloads are U64; 0 is reserved as the "closed
# and drained" return for chan_recv, so don't send literal 0. Phase-3
# will introduce an Option-style return to remove that.
# Also: LIFO wait lists (not FIFO). Demos don't notice because only
# one waiter exists at a time; fix in a later phase if multi-waiter
# fairness matters.

const CHAN_CAP         = 0     # U32
const CHAN_COUNT       = 4     # U32 — current occupancy
const CHAN_HEAD        = 8     # U32 — dequeue index (wraps at cap)
const CHAN_TAIL        = 12    # U32 — enqueue index (wraps at cap)
const CHAN_CLOSED      = 16    # U8
# 17..23 padding
const CHAN_SEND_WAIT   = 24    # U64 — head of send-waiter list (LIFO)
const CHAN_RECV_WAIT   = 32    # U64 — head of recv-waiter list (LIFO)
# K8.6.4 — per-channel spinlock for SMP-safe send/recv. Block paths
# hold this lock through switch_to (Go's `gopark(unlockf, lock)` shape):
# the unlock happens in sched_post_switch AFTER the blocked task's
# SAVED_RSP is committed and the task ptr has been published to the
# waitq. Closes the lost-wakeup race the bug doc describes — a sender
# arriving mid-block is forced to spin on the lock until the receiver
# is on the waitq, so wake_one cannot miss the receiver.
const CHAN_LOCK        = 40    # U64 — spinlock_new() addr
const CHAN_HEADER_SIZE = 48
const CHAN_BUFFER_MAX  = 506   # (4096 - 48) / 8

const TASK_WAIT_NONE     = 0
const TASK_WAIT_YIELD    = 1
const TASK_WAIT_CHAN_S   = 2   # blocked in chan_send (buffer full)
const TASK_WAIT_CHAN_R   = 3   # blocked in chan_recv (buffer empty)

const TASK_STATE_BLOCKED = 3

def chan_cap(ch: Int): Int = volatile_load<U32>(ch + CHAN_CAP)
def chan_count(ch: Int): Int = volatile_load<U32>(ch + CHAN_COUNT)
def chan_head(ch: Int): Int = volatile_load<U32>(ch + CHAN_HEAD)
def chan_tail(ch: Int): Int = volatile_load<U32>(ch + CHAN_TAIL)
def chan_closed(ch: Int): Int = volatile_load<U8>(ch + CHAN_CLOSED)
def chan_send_wait(ch: Int): Int = volatile_load<U64>(ch + CHAN_SEND_WAIT)
def chan_recv_wait(ch: Int): Int = volatile_load<U64>(ch + CHAN_RECV_WAIT)
def chan_buffer(ch: Int): Int = ch + CHAN_HEADER_SIZE

def chan_set_count(ch: Int, v: Int): Void = volatile_store<U32>(ch + CHAN_COUNT, v)
def chan_set_head(ch: Int, v: Int): Void = volatile_store<U32>(ch + CHAN_HEAD, v)
def chan_set_tail(ch: Int, v: Int): Void = volatile_store<U32>(ch + CHAN_TAIL, v)
def chan_set_closed(ch: Int, v: Int): Void = volatile_store<U8>(ch + CHAN_CLOSED, v)
def chan_set_send_wait(ch: Int, t: Int): Void = volatile_store<U64>(ch + CHAN_SEND_WAIT, t)
def chan_set_recv_wait(ch: Int, t: Int): Void = volatile_store<U64>(ch + CHAN_RECV_WAIT, t)

# Allocate + initialize a new channel with the requested buffered
# capacity. cap == 0 is rendezvous (unsupported in phase 2 — callers
# should pass cap >= 1). Returns the channel ptr.
def chan_new(cap: Int): Int
  if cap < 1
    cap = 1
  end
  if cap > CHAN_BUFFER_MAX
    cap = CHAN_BUFFER_MAX
  end
  var ch = pmm_alloc_page()
  pmm_zero_page(ch)
  volatile_store<U32>(ch + CHAN_CAP, cap)
  # CHAN_LOCK is an EMBEDDED spinlock at offset 40 inside the channel
  # page — pmm_zero_page above leaves it at 0 (unlocked). Don't
  # heap-allocate a separate spinlock; the U64 slot IS the lock byte.
  return ch
end

# ---- B.5e actor runtime (freestanding fork of hosted __qz_actor_*) ----
# The hosted actor runtime (codegen_runtime.qz) uses a process-global
# clean-mark side-table guarded by a pthread mutex, plus a @__qz_current_actor_inbox
# TLS global for actor identity. The kernel has neither pthreads nor TLS, so
# B.5e forks both:
#   * actor identity → per-task TASK_ACTOR_INBOX slot (see actor_self_inbox_kernel).
#   * clean-mark     → an inbox-keyed side-table below. It MUST outlive the
#     actor task: the supervisor watcher calls actor_check_clean_kernel(inbox)
#     by inbox VALUE after the actor has already died and its task slot freed.
# Semantics mirror the hosted mark/check-consume exactly: mark is idempotent +
# silent-drop on full (→ supervisor sees CRASH, the safe default); check
# removes the entry on hit so a recycled inbox handle can't inherit a stale
# clean mark.
const ACTOR_CLEAN_TABLE_CAP = 256       # max concurrently clean-marked inboxes
const ACTOR_CLEAN_LOCK_OFF  = 2048      # spinlock slot, past the 256 × i64 entries

var g_actor_clean_table = 0

# Lazy-init the clean-mark table (one PMM page: 256 × 8 = 2048 bytes of entries
# + an embedded spinlock at +2048; the rest of the 4 KiB page is unused).
def _actor_clean_table_init(): Int
  if g_actor_clean_table != 0
    return g_actor_clean_table
  end
  var p = pmm_alloc_page()
  pmm_zero_page(p)
  g_actor_clean_table = p
  return p
end

# Record `inbox` as a clean exit. Idempotent; silent-drop on table-full.
# Emitted by MIR before channel_close on an actor poll loop's clean-exit paths.
def actor_mark_clean_kernel(inbox: Int): Void
  if inbox == 0
    return
  end
  var base = _actor_clean_table_init()
  spinlock_lock(base + ACTOR_CLEAN_LOCK_OFF)
  var i = 0
  var empty = 0
  var have_empty = 0
  while i < ACTOR_CLEAN_TABLE_CAP
    var e = volatile_load<U64>(base + (i * 8))
    if e == inbox
      spinlock_unlock(base + ACTOR_CLEAN_LOCK_OFF)
      return
    end
    if e == 0
      if have_empty == 0
        empty = i
        have_empty = 1
      end
    end
    i = i + 1
  end
  if have_empty == 1
    volatile_store<U64>(base + (empty * 8), inbox)
  end
  spinlock_unlock(base + ACTOR_CLEAN_LOCK_OFF)
end

# Check-and-consume: returns 1 if `inbox` was marked clean (and removes the
# entry), 0 otherwise. The supervisor watcher calls this on death detection;
# 1 = clean exit (no restart under Transient), 0 = crash.
def actor_check_clean_kernel(inbox: Int): Int
  if inbox == 0
    return 0
  end
  var base = _actor_clean_table_init()
  spinlock_lock(base + ACTOR_CLEAN_LOCK_OFF)
  var i = 0
  while i < ACTOR_CLEAN_TABLE_CAP
    if volatile_load<U64>(base + (i * 8)) == inbox
      volatile_store<U64>(base + (i * 8), 0)
      spinlock_unlock(base + ACTOR_CLEAN_LOCK_OFF)
      return 1
    end
    i = i + 1
  end
  spinlock_unlock(base + ACTOR_CLEAN_LOCK_OFF)
  return 0
end

# Per-task actor identity. self_inbox returns the running task's inbox (0
# outside an actor poll context); set is emitted by MIR at every actor $poll
# entry so transitive actor_self_inbox() calls read the correct inbox.
def actor_self_inbox_kernel(): Int = task_actor_inbox(sched_current())
def actor_set_self_inbox_kernel(inbox: Int): Void = task_set_actor_inbox(sched_current(), inbox)

# Reachability anchor for the actor_*_kernel helpers. They are reached ONLY
# through the codegen intrinsic redirect (actor_mark_clean → @actor_mark_clean_kernel
# etc.) — an edge the Quartz reachability pass cannot see, since it operates on
# the intrinsic name, not the emitted kernel symbol. Without a direct caller the
# helpers are pruned (not emitted), and llc fails with "use of undefined value".
# This is the same reason chan_send/chan_recv stay live via their direct kernel
# callers, and kern_tcp_* via std/net/tcp.qz's direct calls. Called unconditionally
# from kmain. Fully side-effect-free: inbox=0 makes mark/check no-ops (they return
# before touching the table), and the self get/set is guarded on a valid current
# task and round-trips the slot unchanged.
def _actor_kernel_dce_anchor(): Void
  var cur = sched_current()
  if cur != 0
    var prev = actor_self_inbox_kernel()
    actor_set_self_inbox_kernel(prev)
    # B.5e.7a — keep chan_try_recv + chan_try_recv_or_closed reachable past
    # --gc-sections. They are reached otherwise only via the codegen
    # try_recv→chan_try_recv / try_recv_or_closed→chan_try_recv_or_closed
    # redirects, edges the Quartz reachability pass can't see (same DCE hazard
    # as the actor helpers). Never executed at boot (sched_current==0 here).
    var _drain = chan_try_recv(prev)
    var _drain2 = chan_try_recv_or_closed(prev)
  end
  actor_mark_clean_kernel(0)
  if actor_check_clean_kernel(0) == 1
    actor_mark_clean_kernel(0)
  end
end

# ---- Wait-list primitives ----------------------------------------
# Tasks on a channel's wait list are singly-linked through
# TASK_NEXT_FREE (reused here as TASK_NEXT when the task is BLOCKED,
# not FREE). A task is only ever in one list at a time — ready queue,
# wait list, or freelist — so the field is unambiguous by state.

def wait_push(list_head_addr: Int, t: Int): Void
  var prev = volatile_load<U64>(list_head_addr)
  task_set_next_free(t, prev)
  volatile_store<U64>(list_head_addr, t)
end

def wait_pop(list_head_addr: Int): Int
  var head = volatile_load<U64>(list_head_addr)
  if head == 0
    return 0
  end
  var nxt = task_next_free(head)
  volatile_store<U64>(list_head_addr, nxt)
  task_set_next_free(head, 0)
  return head
end

# wake_one (LOCK-FREE variant — caller must hold the channel/mutex
# lock that protects this waitq). Pops one waiter from the list and
# returns the task ptr (or 0 if list empty). Caller is responsible for
# transitioning state + ready_push AFTER releasing the protecting lock
# — see chan_send / chan_recv / uk_mutex_unlock for the canonical
# sequence. Old call sites that did state+push under the same call
# now do them inline because the wake target may run on a different
# CPU than the waker.
def wake_one_locked(list_head_addr: Int): Int = wait_pop(list_head_addr)

# ---- Send / recv --------------------------------------------------

def chan_send(ch: Int, v: Int): Void
  # Loop because, even after waking, the slot we wanted may have been
  # grabbed by another sender. Each iteration re-acquires the channel
  # lock and re-checks count.
  var cap = chan_cap(ch)
  var lock = ch + CHAN_LOCK
  while 1 == 1
    spinlock_lock(lock)
    if chan_count(ch) < cap
      # Enqueue at tail under the lock.
      var tail = chan_tail(ch)
      var buf = chan_buffer(ch)
      volatile_store<U64>(buf + (tail * 8), v)
      tail = tail + 1
      if tail >= cap
        tail = 0
      end
      chan_set_tail(ch, tail)
      chan_set_count(ch, chan_count(ch) + 1)
      var woken = wake_one_locked(ch + CHAN_RECV_WAIT)
      spinlock_unlock(lock)
      # Wake target's state transition + ready_push happen AFTER
      # releasing the channel lock so the woken task doesn't block on
      # us if it's about to run a tight chan_recv loop on another CPU.
      if woken != 0
        task_set_state(woken, TASK_STATE_READY)
        ready_push(woken)
      end
      # B.5c — wake any KRecvable selectors parked on this channel.
      # Decoupled from wake_one_locked: select-arms register via the
      # waiter table, NOT via CHAN_RECV_WAIT (which is the blocking
      # chan_recv wait-list). Both wake paths fire in parallel —
      # whoever observes the buffer first wins.
      kernel_waiter_wake_all(ch)
      return
    end
    # Full. Park on the send-wait list, holding the channel lock
    # through switch_to (Go's gopark(unlockf, lock) shape).
    # sched_post_switch on this CPU's main frame will:
    #   1. wait_push(ch + CHAN_SEND_WAIT, cur)
    #   2. spinlock_unlock(ch + CHAN_LOCK)
    # in that exact order, after switch_to has committed SAVED_RSP.
    # A receiver arriving mid-park is forced to wait on the channel
    # lock until step 2 → can't miss the just-published sender.
    var cur = sched_current()
    if cur == 0
      uart_put_str("chan_send: called from main (deadlock) — halting\n")
      @c("cli; 1: hlt; jmp 1b")
    end
    task_set_state(cur, TASK_STATE_BLOCKED)
    volatile_store<U8>(cur + TASK_WAIT_REASON, TASK_WAIT_CHAN_S)
    volatile_store<U64>(cur + TASK_PENDING_WAITQ, ch + CHAN_SEND_WAIT)
    volatile_store<U64>(cur + TASK_PENDING_LOCK, lock)
    set_sched_current(0)
    switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
    # Woken; lock has been released by post_switch. Loop and retry.
  end
end

# Returns the value. Returns 0 if channel is closed and buffer empty
# (callers must not rely on 0 as a valid payload in phase 2).
def chan_recv(ch: Int): Int
  var lock = ch + CHAN_LOCK
  while 1 == 1
    spinlock_lock(lock)
    if chan_count(ch) > 0
      var head = chan_head(ch)
      var cap = chan_cap(ch)
      var buf = chan_buffer(ch)
      var v = volatile_load<U64>(buf + (head * 8))
      head = head + 1
      if head >= cap
        head = 0
      end
      chan_set_head(ch, head)
      chan_set_count(ch, chan_count(ch) - 1)
      var woken = wake_one_locked(ch + CHAN_SEND_WAIT)
      spinlock_unlock(lock)
      if woken != 0
        task_set_state(woken, TASK_STATE_READY)
        ready_push(woken)
      end
      # B.5c — wake any KSendable selectors parked on this channel
      # (buffer space freed). See chan_send for the parallel wake
      # design rationale.
      kernel_waiter_wake_all(ch)
      return v
    end
    if chan_closed(ch) == 1
      spinlock_unlock(lock)
      return 0
    end
    # Empty. Park on recv-wait. Same gopark(unlockf, lock) shape as
    # chan_send's full path.
    var cur = sched_current()
    if cur == 0
      uart_put_str("chan_recv: called from main (deadlock) — halting\n")
      @c("cli; 1: hlt; jmp 1b")
    end
    task_set_state(cur, TASK_STATE_BLOCKED)
    volatile_store<U8>(cur + TASK_WAIT_REASON, TASK_WAIT_CHAN_R)
    volatile_store<U64>(cur + TASK_PENDING_WAITQ, ch + CHAN_RECV_WAIT)
    volatile_store<U64>(cur + TASK_PENDING_LOCK, lock)
    set_sched_current(0)
    switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
    # Woken; loop to retry.
  end
  return 0
end

# B.5e.7a — non-blocking recv for the freestanding actor stop/cascade/crash
# drain loops (mir_emit_actor_poll_body). Returns a 16-byte Option struct
# [tag:i64, value:i64]: tag=0 (Some) + value=msg when a buffered message is
# available, tag=1 (None) when empty — even on a closed channel buffered
# messages drain first, then None. Matches the hosted `try_recv` Option
# contract exactly so the shared actor poll body works unchanged in the kernel.
def chan_try_recv(ch: Int): Int
  var opt = mem_alloc(16)
  var lock = ch + CHAN_LOCK
  spinlock_lock(lock)
  if chan_count(ch) > 0
    var head = chan_head(ch)
    var cap = chan_cap(ch)
    var buf = chan_buffer(ch)
    var v = volatile_load<U64>(buf + (head * 8))
    head = head + 1
    if head >= cap
      head = 0
    end
    chan_set_head(ch, head)
    chan_set_count(ch, chan_count(ch) - 1)
    var woken = wake_one_locked(ch + CHAN_SEND_WAIT)
    spinlock_unlock(lock)
    if woken != 0
      task_set_state(woken, TASK_STATE_READY)
      ready_push(woken)
    end
    kernel_waiter_wake_all(ch)
    volatile_store<U64>(opt + 0, 0)
    volatile_store<U64>(opt + 8, v)
    return opt
  end
  spinlock_unlock(lock)
  volatile_store<U64>(opt + 0, 1)
  volatile_store<U64>(opt + 8, 0)
  return opt
end

# B.5e.7a — atomic non-blocking recv-or-closed for the actor stop/method
# proxies (mir_lower_actor_stop / mir_lower_actor_async_proxies). The proxies
# busy-poll this + sched_yield to avoid the cascade-stop hang (a linked actor
# may close the inbox without replying). Contract matches the hosted
# `try_recv_or_closed`: returns >0 = Option ptr [tag:0, value:msg] (got a
# value), 0 = empty+open (caller retries), -1 = empty+closed (caller bails).
def chan_try_recv_or_closed(ch: Int): Int
  var lock = ch + CHAN_LOCK
  spinlock_lock(lock)
  if chan_count(ch) > 0
    var head = chan_head(ch)
    var cap = chan_cap(ch)
    var buf = chan_buffer(ch)
    var v = volatile_load<U64>(buf + (head * 8))
    head = head + 1
    if head >= cap
      head = 0
    end
    chan_set_head(ch, head)
    chan_set_count(ch, chan_count(ch) - 1)
    var woken = wake_one_locked(ch + CHAN_SEND_WAIT)
    spinlock_unlock(lock)
    if woken != 0
      task_set_state(woken, TASK_STATE_READY)
      ready_push(woken)
    end
    kernel_waiter_wake_all(ch)
    var opt = mem_alloc(16)
    volatile_store<U64>(opt + 0, 0)
    volatile_store<U64>(opt + 8, v)
    return opt
  end
  var closed = chan_closed(ch)
  spinlock_unlock(lock)
  if closed == 1
    return -1
  end
  return 0
end

# Close the channel. Sets the closed flag + wakes every blocked
# receiver so they observe the flag and return 0. Send-on-closed is
# undefined in phase 2 (Go panics; we block forever). Wakes are done
# under the channel lock to keep ordering with concurrent chan_send.
def chan_close(ch: Int): Void
  var lock = ch + CHAN_LOCK
  spinlock_lock(lock)
  chan_set_closed(ch, 1)
  var woken_list_head = volatile_load<U64>(ch + CHAN_RECV_WAIT)
  volatile_store<U64>(ch + CHAN_RECV_WAIT, 0)
  spinlock_unlock(lock)
  # Walk the unlinked list, transition each waiter and ready_push.
  var t = woken_list_head
  while t != 0
    var nxt = task_next_free(t)
    task_set_next_free(t, 0)
    task_set_state(t, TASK_STATE_READY)
    ready_push(t)
    t = nxt
  end
  # B.5e.8c — fire close-event active-wake. CHAN_RECV_WAIT above only holds
  # tasks blocked *in recv()*; a std/actor Supervisor watcher subscribes to a
  # child's death via kernel_waiter_register(inbox | CLOSE_EVENT_BIT, frame)
  # (CLOSE_EVENT_BIT = 2; channel handles are ≥16-byte aligned so bit 1 is free)
  # and then PARKS (sched_sleep → B.4 suspend). Without waking that key here, a
  # parked watcher never observes inbox closes after its initial scan — every
  # supervised crash past the first hangs. Mirrors the hosted channel_close,
  # which notify_all's the same `| CLOSE_EVENT_BIT` close key. Idempotent / lock-
  # internal / no-op when nothing is registered, so non-supervised closes pay
  # only a brief table scan.
  kernel_waiter_wake_all(ch | 2)
end

# Non-blocking send — returns 1 if enqueued, 0 if full. Phase-5 RX
# dispatcher calls this from main (which cannot block on chan_send
# without deadlocking — there is no other scheduler thread to drain
# the channel). A full channel means the connection goroutine hasn't
# caught up; we drop the frame and rely on the TCP peer to retransmit.
def chan_try_send(ch: Int, v: Int): Int
  var lock = ch + CHAN_LOCK
  spinlock_lock(lock)
  if chan_closed(ch) == 1
    spinlock_unlock(lock)
    return 0
  end
  var cap = chan_cap(ch)
  if chan_count(ch) >= cap
    spinlock_unlock(lock)
    return 0
  end
  var tail = chan_tail(ch)
  var buf = chan_buffer(ch)
  volatile_store<U64>(buf + (tail * 8), v)
  tail = tail + 1
  if tail >= cap
    tail = 0
  end
  chan_set_tail(ch, tail)
  chan_set_count(ch, chan_count(ch) + 1)
  var woken = wake_one_locked(ch + CHAN_RECV_WAIT)
  spinlock_unlock(lock)
  if woken != 0
    task_set_state(woken, TASK_STATE_READY)
    ready_push(woken)
  end
  return 1
end

# Reset a channel's mutable state so it can be reused for a fresh
# exchange without a new PMM allocation. Capacity field is preserved
# (that's a property of the allocation, not the conversation). Only
# safe when no task is waiting on the channel — the connection
# goroutine that last owned this channel has already task_exit'd
# before we get here, and no new goroutine is spawned until after
# this reset runs.
def chan_reset(ch: Int): Void
  chan_set_count(ch, 0)
  chan_set_head(ch, 0)
  chan_set_tail(ch, 0)
  chan_set_closed(ch, 0)
  chan_set_send_wait(ch, 0)
  chan_set_recv_wait(ch, 0)
end

# Producer body for chan_demo. Sends 100..1000 (avoiding the 0
# sentinel) into g_chan_demo, closes, exits.
var g_chan_demo = 0
def chan_demo_producer(): Void
  var i = 1
  while i <= 10
    chan_send(g_chan_demo, i * 100)
    i = i + 1
  end
  chan_close(g_chan_demo)
  task_exit()
end

# Consumer body for chan_demo. Pulls until the close-drain sentinel
# (0) arrives, logging each value. Exits.
def chan_demo_consumer(): Void
  uart_put_str("chan_demo: output: ")
  var v = chan_recv(g_chan_demo)
  while v != 0
    uart_put_str("#{v} ")
    v = chan_recv(g_chan_demo)
  end
  uart_putc(10)
  task_exit()
end

# Stage a bounded cap=3 channel, spawn producer + consumer, pump
# until drained. Exercises block-on-full (producer pauses 7× between
# batches of 3 enqueues), block-on-empty (consumer may pause if it
# outruns the producer), and close-drain wake-up.
def chan_demo(): Void
  g_chan_demo = chan_new(3)
  go_fn(chan_demo_producer)
  go_fn(chan_demo_consumer)
  sched_pump()
  uart_put_str("chan_demo: done\n")
end

# ====================================================================
# N-on-1 mutex (DEF-E-N1 phase 3).
#
# Simple cooperative mutex: one holder at a time, contenders block on
# an intrusive wait list reusing TASK_NEXT_FREE. Non-recursive: a
# task attempting to re-lock a mutex it already holds will deadlock
# (phase-3 doesn't track owner reentrancy — add later if needed).
# K8.6.5 — internal spinlock serializes all state mutations
# (HELD/OWNER/WAIT_HEAD), and the block path holds it through
# switch_to (gopark(unlockf, lock) shape). Closes the K8.7 commit's
# noted "non-atomic load+store TOCTOU on MTX_LOCKED" race.
#
# Layout (32 bytes, one PMM page per mutex):
#   +0   locked   (U8): 0 = free, 1 = held
#   +8   owner    (U64): task ptr holding the lock (debug/assertion)
#   +16  wait_head (U64): LIFO wait list
#   +24  guard_lock (U64): spinlock_new() addr — serializes the above

const MTX_LOCKED      = 0
const MTX_OWNER       = 8
const MTX_WAIT_HEAD   = 16
const MTX_GUARD_LOCK  = 24

def uk_mutex_new(): Int
  var m = pmm_alloc_page()
  pmm_zero_page(m)
  # MTX_GUARD_LOCK is an EMBEDDED spinlock at offset 24 inside the
  # mutex page — pmm_zero_page leaves it at 0 (unlocked). The slot
  # IS the lock byte; no heap allocation needed.
  return m
end

def uk_mutex_lock(m: Int): Void
  var lock = m + MTX_GUARD_LOCK
  while 1 == 1
    spinlock_lock(lock)
    if volatile_load<U8>(m + MTX_LOCKED) == 0
      volatile_store<U8>(m + MTX_LOCKED, 1)
      volatile_store<U64>(m + MTX_OWNER, sched_current())
      spinlock_unlock(lock)
      return
    end
    # Held by someone else. Park on wait list, holding guard lock
    # through switch_to. sched_post_switch will wait_push + unlock.
    var cur = sched_current()
    if cur == 0
      uart_put_str("uk_mutex_lock: called from main (deadlock) — halting\n")
      @c("cli; 1: hlt; jmp 1b")
    end
    task_set_state(cur, TASK_STATE_BLOCKED)
    volatile_store<U64>(cur + TASK_PENDING_WAITQ, m + MTX_WAIT_HEAD)
    volatile_store<U64>(cur + TASK_PENDING_LOCK, lock)
    set_sched_current(0)
    switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
    # Woken; lock released by post_switch. Loop and retry acquire.
  end
end

def uk_mutex_unlock(m: Int): Void
  var lock = m + MTX_GUARD_LOCK
  spinlock_lock(lock)
  volatile_store<U64>(m + MTX_OWNER, 0)
  volatile_store<U8>(m + MTX_LOCKED, 0)
  var woken = wake_one_locked(m + MTX_WAIT_HEAD)
  spinlock_unlock(lock)
  if woken != 0
    task_set_state(woken, TASK_STATE_READY)
    ready_push(woken)
  end
end

# Shared counter + mutex for the demo. Two goroutines each bump the
# counter 1000 times under the lock; final value must be exactly 2000
# with no torn reads / lost updates even though each task yields
# between read and write when it hits the lock-contention path.
var g_mutex_demo_counter = 0
var g_mutex_demo_mtx     = 0

def mutex_demo_body(): Void
  var i = 0
  while i < 1000
    uk_mutex_lock(g_mutex_demo_mtx)
    g_mutex_demo_counter = g_mutex_demo_counter + 1
    # Yield INSIDE the critical section every 100 iterations to force
    # lock hand-off between the two goroutines. Without this they'd
    # run sequentially (one finishes 1000, then the other).
    if (i % 100) == 0
      uk_mutex_unlock(g_mutex_demo_mtx)
      yield_now()
    else
      uk_mutex_unlock(g_mutex_demo_mtx)
    end
    i = i + 1
  end
  task_exit()
end

def mutex_demo(): Void
  g_mutex_demo_counter = 0
  g_mutex_demo_mtx = uk_mutex_new()
  go_fn(mutex_demo_body)
  go_fn(mutex_demo_body)
  sched_pump()
  uart_put_str("mutex_demo: counter=#{g_mutex_demo_counter} (expected 2000)\n")
end

# Body shared by all goroutines spawned in sched_demo(). Reads its own
# ID from this CPU's PCPU_CURRENT_TASK (set by sched_pump before
# switching into us). Prints "gN " three times, yielding between prints
# so the main loop can interleave the other goroutines. Exits explicitly
# — phase-1 task bodies are responsible for calling task_exit() as their
# last act.
def sched_demo_body(): Void
  var id = uk_task_id(sched_current())
  var i = 0
  while i < 3
    uart_put_str("g#{id} ")
    yield_now()
    i = i + 1
  end
  task_exit()
end

# Spawn five goroutines, pump the scheduler until the ready queue
# drains, verify the pool is empty. Ordering check: main sees "g0 g1
# g2 g3 g4" repeated three times, then "demo done" once.
def sched_demo(): Void
  uart_put_str("sched_demo: spawning goroutines: ")
  var i = 0
  while i < 5
    var t = go_fn(sched_demo_body)
    if t == 0
      uart_put_str(" [pool full at #{i}]")
      i = 5
    else
      i = i + 1
    end
  end
  uart_put_str("\nsched_demo: output: ")
  sched_pump()
  uart_putc(10)
  uart_put_str("sched_demo: done (alive=#{g_task_alive}, ready=#{sched_total_ready()})\n")
end

# ====================================================================
# N-on-1 goroutine runtime (DEF-E-N1, phase 1).
#
# Ports the N side of our M:N scheduler onto the unikernel's single-
# core cooperative switch_to machinery. No pthreads, no SMP — one
# worker (the main serve loop) runs any number of goroutines by
# context-switching cooperatively on yield_now / task_exit / future
# channel/mutex suspension points.
#
# Storage: a fixed pool of NUM_TASKS task structs (216 B each). Path C.5.2
# (2026-05-31) — copying stacks: there is NO per-slot running stack. Every
# RUNNING task's frames live on the single shared `g_active_stack_base`
# (16 KiB). On park the used portion is copied OUT to a right-sized per-task
# buffer (ss_alloc) and the active stack is freed; on resume it is copied
# back IN to the same virtual address. A parked task therefore costs ~its
# live frame bytes, not a whole stack — so millions can be parked cheaply.
# Spawn picks a free pool slot, records entry_fn, parks it READY; the
# scheduler seeds the active stack on first schedule-in. Exit frees the
# saved buffer (ss_free) and the slot (to the free list). The PMM bump
# allocator can't reclaim, so reusable slots + ss-allocator freelists (not
# per-spawn allocs) are load-bearing.
#
# Sequencing: main calls uk_sched_init() at boot, spawns tasks via
# go_fn(fn_ptr), drives execution via sched_pump(). Each goroutine
# runs until it yields (yield_now pushes self back to ready queue)
# or exits (task_exit marks DEAD + releases the pool slot). Main
# resumes from sched_pump when the ready queue drains.
#
# Future phases layer channels (Phase 2), mutex/rwlock (Phase 3),
# and TCP-serve integration (Phase 4 — one goroutine per accepted
# connection) on top of these primitives. The assembly-visible
# switch_to / task_init_stack routines are reused unchanged.

const NUM_TASKS          = 16777216 # Path C.6 2026-05-31: 4194304 → 16777216 (4×) — copying stacks (C.5.2) hold this in ~8 GB; 64 GiB trampoline covers it
# Soul-dashboard grid bucket — each cell in the pool-state grid summarises
# this many task slots. NUM_TASKS / SOUL_GRID_BUCKET = SOUL_GRID_CELLS cells
# emitted on /api/soul/tasks.json. Browser-side DOM cost is O(cells), and the
# grid emits exactly NUM_TASKS/SOUL_GRID_BUCKET chars into the response buffer,
# so the bucket scales WITH NUM_TASKS to keep that char count (and the buffer
# footprint) fixed. C.6 bumped bucket 1024 → 4096 alongside NUM_TASKS 4M → 16M
# so the emitted grid stays 4096 cells — byte-identical to the 4M/prod path.
const SOUL_GRID_BUCKET   = 4096
const SOUL_GRID_CELLS    = 4096  # = NUM_TASKS / SOUL_GRID_BUCKET
# D.11 Phase 7 / B.1.a — grew 80→192 to hold the per-task effect-stack
# snapshot (4 scalars + 7 ptr-bases + snapshot + reserve). Save/restore
# is the per-task isolation mechanism: scheduler save/restores the values
# of the process-global @__qz_effect_stack_* symbols to/from these slots
# at every context switch boundary. See
# docs/design/D11_FREESTANDING_EFFECT_BRIDGE.md §"Access strategy".
# Sized 200 (3.125 × 64 B cache lines — slight overhang into a 4th line for
# the second arena slot is acceptable since cooperative scheduling avoids
# cross-CPU cache contention on task struct fields). Pool cost at
# NUM_TASKS=32768: 6.25 MiB (was 6.0 MiB after 192, 2.5 MiB before 80→192).
# Headroom remains for B.5 park_deadline; place future slots at +200 or
# rebudget. SLAB.1 (2026-05-27) bumped 192 → 200 to add TASK_SLAB_ARENA_HEAD.
# Path C.5.2 (2026-05-31) bumped 200 → 216 to add the two saved-stack
# bookkeeping slots (LEN at 200, CAP at 208) for copying-stack scheduling.
# B.5e (2026-06-03) bumped 216 → 224 to add TASK_ACTOR_INBOX at 216 — the
# freestanding fork of the hosted @__qz_current_actor_inbox TLS global. Pure
# task memory (read via sched_current()+offset), so no context-switch
# save/restore is needed; zeroed in task_init like TASK_ARENA_HEAD. Mirror
# in libc_stubs.c (#define TASK_STRUCT_SIZE 224).
const TASK_STRUCT_SIZE   = 224
const TASK_STATE         = 0    # U8: 0=FREE, 1=READY, 2=RUNNING, 3=BLOCKED, 4=DEAD
const TASK_SAVED_RSP     = 8    # U64: switch_to writes here
# Path C.5.2 — was TASK_STACK_BASE (a per-task leased running-stack). In the
# copying-stack model there is no per-task running stack: every task runs on
# the single shared `g_active_stack_base`. This slot now holds the per-task
# SAVED-stack buffer — the heap chunk (from ss_alloc) that holds this task's
# parked frames while it is not RUNNING. 0 == no saved frames, which means
# either the task has never run (first-run seed at schedule-in) or it was
# freed (slot reuse). A task that has parked at least once and not yet exited
# holds a non-zero buffer even while RUNNING (the buffer is reused/grown on
# its next park, freed on exit). See docs/design/PATH_C_STACK_ON_DEMAND.md §10.
const TASK_SAVED_STACK_PTR = 16 # U64: heap buffer holding parked frames (0 = none)
const TASK_ENTRY_FN      = 24   # U64: read by schedule-in to seed a first-run frame
const TASK_USER_ARG      = 32   # U64: caller-supplied argument visible to the task body via sched_current()
const TASK_ID            = 40   # U32: slot index (0..NUM_TASKS-1); stable across reuse
# 44..47: reserved
const TASK_WAIT_REASON   = 48   # U8: reserved for channel/mutex blocking
const TASK_LAST_CPU      = 49   # U8: K8.9 — CPU id of the last sched_tick
# Scheduling priority. 0 = normal, 1 = high. Read by ready_push_to to
# decide which ready ring receives the task; persists across blocks
# (chan_recv wake puts the task back on whichever ring matches its
# priority). Set at spawn time by `go_fn_hi` / `kern_go_closure_hi`,
# cleared back to 0 on task_free so a slot reused for a demo body
# doesn't accidentally inherit HTTP-tier priority. Designed for the
# supervised HTTP server vs soul-demo-task starvation problem: at
# spawn-30K the demo tasks saturate the normal ring and the supervised
# goroutine + per-conn handlers stop getting CPU until the demos drain.
const TASK_PRIORITY      = 50   # U8: 0=normal, 1=high
                                # entry; surfaced via /api/soul/tasks.json
                                # to color the per-task drill-down by CPU.
# Path C.5.5 — home CPU for copying-stack pinning. A normal task pins to the
# CPU it first parks on (its saved frames carry absolute addresses into THAT
# CPU's active-stack VA, so it must always resume there — same-address-restore
# is per-CPU now). TASK_HOME_UNPINNED (255) = never parked ⟺ free to distribute
# to the least-loaded CPU at push time. Set to 255 on task_alloc, stamped to
# the running CPU in sched_park_active_stack, reset to 255 on task_free.
# Hi-priority tasks ignore this — they ride the global hi ring which only BSP
# consumes (ready_pop), so they always run on BSP. See ready_push / ready_pop.
const TASK_HOME_CPU      = 51   # U8: 0..g_cpu_count-1, or 255 = unpinned
# 52..55: reserved
const TASK_NEXT_FREE     = 56   # U64: intrusive freelist ptr
# K8.6.3 — defer-publish protocol. yield_now / task_exit set state but
# leave publication (ready_push / task_free) to sched_post_switch
# AFTER switch_to has committed SAVED_RSP. K8.6.4 / K8.6.5 extend the
# protocol to chan/mutex block paths via PENDING_WAITQ + PENDING_LOCK
# (Go's `gopark(unlockf, lock)` shape):
#   - PENDING_WAITQ != 0: sched_post_switch wait_pushes(t) onto waitq
#   - PENDING_LOCK  != 0: sched_post_switch spinlock_unlocks the lock
#     after the wait_push (closes the lost-wakeup hazard).
# K8.6.3 ships the slots zero; K8.6.4/5 populate them.
const TASK_PENDING_WAITQ = 64   # U64
const TASK_PENDING_LOCK  = 72   # U64
# D.11 Phase 7 / B.1.a — saved values of the per-process effect-runtime
# globals. Populated by codegen-emitted save/restore helpers (B.1.b)
# called from the kernel's switch_to entry/exit; for B.1.a these slots
# are inert (zero-init on alloc, never written in flight). The 7 ptr
# slots become non-zero once task_effect_strip_alloc has run; the strip
# they point into is reused across yield boundaries because the values
# don't change between installs.
const TASK_EFFECT_STACK_TOP          = 80    # i64 — top index of effect stack
const TASK_EFFECT_STACK_NAMES        = 88    # ptr — base of names[256]    inside strip
const TASK_EFFECT_STACK_HANDLERS     = 96    # ptr — base of handlers[256]
const TASK_EFFECT_STACK_BUFS         = 104   # ptr — base of bufs[256]
const TASK_EFFECT_STACK_OP_FILTERS   = 112   # ptr — base of op_filters[256]
const TASK_EFFECT_STACK_RESULTS      = 120   # ptr — base of results[256]
const TASK_EFFECT_STACK_STATE_SLOTS  = 128   # ptr — base of state_slots[256]
const TASK_EFFECT_STACK_RESUMED      = 136   # ptr — base of resumed[256]
const TASK_CURRENT_SCOPE             = 144   # i64 — saved @__qz_current_scope_handle
const TASK_SCOPED_CTX_TOP            = 152   # i64 — saved @__qz_scoped_ctx_top
const TASK_ALLOC_IN_HANDLER          = 160   # i64 — saved @__qz_alloc_in_handler
const TASK_EFFECT_SNAPSHOT           = 168   # i64 — spawn-time inherited snapshot ptr (B.x.0)
# D.11 Phase 7 / B.4 — park_rv. Transient sentinel set by suspend's caller
# (a kind=3 effect handler that called park) and read by __qz_effect_suspend
# to decide POLL_READY (1) vs negative-fd encoding. Lives in the reserved
# 176..191 range so TASK_STRUCT_SIZE stays at 192. MUST survive a context
# switch — suspend WILL fire mid-perform (kind=3 handler → suspend), and
# the strip's save/restore pair (B.1.b) restores park_rv alongside the
# other globals so the resumed task observes the value the handler wrote.
const TASK_PARK_RV                   = 176   # i64 — saved @__qz_effect_park_rv
# Per-task per-request arena slot (D.11 Phase 8b.2.c.7). Currently the only
# user of the 184..191 reserved range. Encodes:
#   0     → arena inactive
#   1     → arena active, empty chain (sentinel; chain ptrs are 16-byte aligned)
#   ptr   → arena active, head of multi-page chunk chain at ptr
# Read+written from C-side libc_stubs.c (qz_arena_begin/end/malloc_pages);
# Quartz never touches this slot directly. Relocate together with the C
# `#define TASK_ARENA_HEAD 184` if/when B.5 park_deadline wants this slot.
const TASK_ARENA_HEAD                = 184   # i64 — arena chain head encoding
# SLAB.1 (2026-05-27) — per-task slab arena chain head. Encoded:
#   0   → empty chain (no tracked slab chunks)
#   ptr → head of slab_arena_chain page linked list
# Active state is shared with TASK_ARENA_HEAD (slab tracking only fires
# when multipage arena is active). Read+written from libc_stubs.c
# (slab_alloc/slab_arena_drain); Quartz only zeroes it in task_alloc.
# Relocate together with the C `#define TASK_SLAB_ARENA_HEAD 192` if the
# layout changes.
const TASK_SLAB_ARENA_HEAD           = 192   # i64 — slab arena chain head
# Path C.5.2 — copying-stack bookkeeping. When a task parks (yield/block),
# the used portion of the single active stack is copied out into the buffer
# at TASK_SAVED_STACK_PTR; LEN records how many bytes are live there and CAP
# records the ss_alloc size-class of the buffer (so ss_free can route it back
# to the right freelist, and the next park can grow in place when len > cap).
# Both are 0 until the task's first park. Mirror in libc_stubs.c only if the
# C side ever needs them (today it does not — it reads neither slot).
const TASK_SAVED_STACK_LEN           = 200   # i64 — live bytes saved (active_top - saved_rsp)
const TASK_SAVED_STACK_CAP           = 208   # i64 — ss_alloc size-class of the saved buffer
# B.5e — running actor's inbox handle (0 = task is not in an actor poll
# context). Written by the `__actor_set_self_inbox` intrinsic at every actor
# $poll entry; read by `actor_self_inbox()` (used in std/actor.qz::actor_die).
# Freestanding analog of the hosted @__qz_current_actor_inbox TLS global.
const TASK_ACTOR_INBOX               = 216   # i64 — current actor inbox (per-task)

const TASK_STATE_FREE    = 0
const TASK_STATE_READY   = 1
const TASK_STATE_RUNNING = 2
const TASK_STATE_DEAD    = 4

# Per-task stack allocation. DEF-E-N1 phase 5 bumped this from 1 page
# (4 KiB) to 2 contiguous pages (8 KiB) once a connection goroutine
# was discovered to be pushing >4 KiB of call-frame + string-literal
# args through `http_build_landing` + descendants. At 64 tasks × 2
# pages × 4 KiB that's 512 KiB total — still trivial for a 64 MiB PMM
# pool, and it pays back in reliability under concurrent load.
#
# SLAB.1 burst race 2026-05-28 — qemu -d int evidence (RSP=0x18 at
# uart_put_str+8 entry, RSP=0xa0 at #UD in .rodata mid-string ` HTTP/1.1" `)
# pointed at a per-task stack overflow during _http_access_log's
# interpolation/concat chain (std/net/http_server.qz:2188 — 5 to_s()
# calls plus 6 constant string segments concat'd into one log line).
# Bumped 2→4 pages (8→16 KiB) plus added a stack canary at stack_base+0
# checked once per request in qz_arena_begin (libc_stubs.c) to make
# any future stack-overflow regression loud, not silent.
# 32K tasks × 4 × 4 KiB = 512 MiB stack budget (vs 256 MiB before);
# 6 GiB PMM pool absorbs that easily.
# See [[feedback-slab1-burst-race-root-cause]].
const TASK_STACK_PAGES   = 4
const TASK_STACK_BYTES   = TASK_STACK_PAGES * 4096
const TASK_STACK_CANARY  = 0xCAFEBABEDEADBEEF  # marker at stack_base+0;
                                                # overwrite = overflow

# Path C.5.2 (2026-05-31) — Copying stacks. There is exactly ONE running
# stack in the whole kernel: a single fixed 16-KiB region at a constant
# address `g_active_stack_base`. On a single CPU exactly one task is RUNNING,
# so one active stack suffices. Every task's frames are always built at this
# same address — which is what makes the copy model correct: saved frames
# contain absolute self-references (saved-RBP chain, &local borrows), and
# restoring them to the SAME virtual address (always active_top - len) keeps
# every absolute pointer valid.
#
# On park (yield/block) the used portion is copied OUT into a right-sized
# per-task buffer (ss_alloc) and the active stack is freed for the next task;
# on resume it is copied back IN. A parked task therefore costs ~its live
# frame bytes (a parked demo body ≈ 170 B), not a full 16-KiB stack — so 4M
# parked tasks ≈ 4M × ~192 B ≈ 0.8 GB instead of 64 GB.
#
# This also eliminates by construction the two failures the earlier pooled
# scheme (C.1) hit: there is no pool to exhaust, so no back-pressure spin, no
# HTTP starvation, no wave-draining. Every ready task can always run.
# See docs/design/PATH_C_STACK_ON_DEMAND.md §10.

# Path B (2026-05-29) introduced a fat/thin STACK split (4 KiB for demo
# bodies, 16 KiB for HTTP-tier) to shrink per-slot pre-reservation. Path C
# (2026-05-31) makes that obsolete for stacks: every task runs on the single
# 16-KiB active stack, sized on demand via the saved-stack allocator. What
# survives
# is only the TASK-STRUCT freelist partition below — slots 0..NUM_TASKS_FAT-1
# vs the rest, with separate freelists + a g_task_alive_thin counter. That
# partition no longer affects stack size (there is one shared active stack);
# it's vestigial, kept this commit only so the /api/soul/spawn headroom math and
# stats endpoints don't churn in the same high-blast-radius change. Path C.4
# collapses it to a single freelist. go_fn pulls fat slots, go_fn_thin pulls
# thin slots — behaviorally identical now apart from which counter ticks.
# Fat slots reserved for HTTP-tier + effects-installing work; 4096 is well
# above any concurrent-HTTP working set observed.
const NUM_TASKS_FAT      = 4096
const NUM_TASKS_THIN     = NUM_TASKS - NUM_TASKS_FAT

var g_task_pool          = 0    # base of NUM_TASKS × TASK_STRUCT_SIZE
var g_task_free_head     = 0    # head of FAT freelist (task struct ptr, 0 == empty)
var g_task_free_head_thin = 0   # head of THIN freelist (task struct ptr, 0 == empty)
var g_task_alive         = 0    # # tasks currently allocated (READY | RUNNING | DEAD-pending) — combined
var g_task_alive_thin    = 0    # # thin-pool slots currently allocated (subset of g_task_alive)
var g_task_alive_max     = 0    # high-water mark of g_task_alive (max concurrent ever observed; SOUL.4)
var g_task_spawn_total   = 0    # monotonic count of every task_alloc() success since boot (SOUL.4)
var g_task_exit_total    = 0    # monotonic count of every task_free() since boot (SOUL.4)

# Path C.5.5 — the active stack is per-CPU (one fixed 16-KiB region per CPU),
# allocated + canary-stamped in kern8_pcpu_init and stored at
# %gs:PCPU_ACTIVE_STACK_BASE. The RUNNING task's frames live on ITS CPU's
# active stack, growing DOWN from active_top. The canary (TASK_STACK_CANARY)
# is stamped once at base+0 and persists — a copy-in/out never touches base+0
# unless a frame overflows the full 16 KiB, which is exactly what the canary
# check in qz_arena_begin (reading %gs:PCPU_ACTIVE_STACK_BASE) detects. Each
# CPU's stack is at its own VA; tasks pin to a home CPU at first run and never
# migrate (C.5.5.2), so a task always resumes at the same VA — copy-stack's
# same-address-restore invariant holds per-CPU. See active_stack_base().

# Ready queues — K8.6 per-CPU ring per CPU. State lives in the per-CPU
# page at offsets PCPU_READY_*. Each ring is NUM_TASKS slots wide
# (sizing for the worst case where one CPU holds the whole pool); the
# global cap NUM_TASKS bounds total READY count, so per-CPU overflow
# is impossible. Initialized in uk_sched_init for every detected CPU
# (g_cpu_count is already populated by acpi_init at this point).

# Scheduler state — per-CPU since K8.MVP.
#
# `g_sched_current` lived as a single global through K8.5; under SMP each
# CPU needs its own "currently running task" because BSP and AP can run
# different goroutines simultaneously. The K8.2 per-CPU page reserved
# PCPU_CURRENT_TASK = 24 for exactly this. Reads/writes go through
# `sched_current()` / `set_sched_current(t)`.
#
# `g_sched_main_rsp_slot` likewise becomes per-CPU. switch_to needs a
# real memory address to save main's RSP into; PCPU_SCHED_MAIN_RSP = 32
# is an 8-byte slot inside the per-CPU page itself. `pcpu_main_rsp_slot()`
# returns that address for the calling CPU.
def sched_current(): Int = cpu_local_load(PCPU_CURRENT_TASK)
def set_sched_current(t: Int): Void = cpu_local_store(PCPU_CURRENT_TASK, t)
def pcpu_main_rsp_slot(): Int = pcpu_page_for(cpu_local_load(PCPU_CPU_ID)) + PCPU_SCHED_MAIN_RSP

# K8.8 — per-CPU "scheduler heartbeat" tick. Called from sched_pump /
# sched_pump_step right after a task transitions to RUNNING. Bumps
# PCPU_HEARTBEAT (+40 in the per-CPU page, reserved at K8.2) so
# `/api/soul/stats.json` can surface "is the scheduler alive on
# CPU N?" without per-task uart logging. Optionally also emits the
# UART trace under `KERN8_SCHED_TRACE`. The bump is always-on (very
# cheap — one cpu_local_load + one cpu_local_store + an add); the
# trace is the gated debug aid.
#
# Set KERN8_SCHED_TRACE=1 for SMP-correctness smoke runs that need to
# observe per-CPU task entries; default 0 keeps production quiet.
#
# Note: PCPU_HEARTBEAT is updated only by THIS CPU (via %gs:40), so
# there is no cross-CPU race on the counter itself. The known SMP
# scheduling race in yield_now/switch_to (filed as a K8.6 substrate
# follow-up) can cause a CPU's heartbeat to stop advancing if the CPU
# loses its task to a stale-RSP-tearing race — but that's the symptom
# this telemetry surfaces, not a bug it introduces.
const KERN8_SCHED_TRACE = 0
def sched_tick(next: Int): Void
  cpu_local_store(PCPU_HEARTBEAT, cpu_local_load(PCPU_HEARTBEAT) + 1)
  # K8.9 — stamp which CPU is about to run `next` so /api/soul/tasks.json
  # can color the per-task drill-down by last-CPU. One U8 store on the
  # hot path; surfaces SMP balance visually without per-task uart logs.
  volatile_store<U8>(next + TASK_LAST_CPU, cpu_local_load(PCPU_CPU_ID))
  if KERN8_SCHED_TRACE == 1
    uart_put_str("[sched] CPU")
    uart_put_uint(cpu_local_load(PCPU_CPU_ID))
    uart_put_str(" running task=")
    uart_put_uint(uk_task_id(next))
    uart_putc(10)
  end
end

def task_addr(idx: Int): Int = g_task_pool + (idx * TASK_STRUCT_SIZE)
def task_state(t: Int): Int = volatile_load<U8>(t + TASK_STATE)
def task_set_state(t: Int, s: Int): Void = volatile_store<U8>(t + TASK_STATE, s)
def task_saved_rsp(t: Int): Int = volatile_load<U64>(t + TASK_SAVED_RSP)
def task_set_saved_rsp(t: Int, v: Int): Void = volatile_store<U64>(t + TASK_SAVED_RSP, v)
# Path C.5.2 — saved-stack buffer accessors. PTR is the heap chunk holding
# parked frames (0 = none / first-run / freed); LEN is the live byte count;
# CAP is the buffer's ss_alloc size-class (for ss_free routing + grow checks).
def task_saved_stack_ptr(t: Int): Int = volatile_load<U64>(t + TASK_SAVED_STACK_PTR)
def task_set_saved_stack_ptr(t: Int, v: Int): Void = volatile_store<U64>(t + TASK_SAVED_STACK_PTR, v)
def task_saved_stack_len(t: Int): Int = volatile_load<U64>(t + TASK_SAVED_STACK_LEN)
def task_set_saved_stack_len(t: Int, v: Int): Void = volatile_store<U64>(t + TASK_SAVED_STACK_LEN, v)
def task_saved_stack_cap(t: Int): Int = volatile_load<U64>(t + TASK_SAVED_STACK_CAP)
def task_set_saved_stack_cap(t: Int, v: Int): Void = volatile_store<U64>(t + TASK_SAVED_STACK_CAP, v)
# B.5e — per-task actor inbox accessors (see TASK_ACTOR_INBOX).
def task_actor_inbox(t: Int): Int = volatile_load<U64>(t + TASK_ACTOR_INBOX)
def task_set_actor_inbox(t: Int, v: Int): Void = volatile_store<U64>(t + TASK_ACTOR_INBOX, v)
def uk_task_id(t: Int): Int = volatile_load<U32>(t + TASK_ID)
def task_last_cpu(t: Int): Int = volatile_load<U8>(t + TASK_LAST_CPU)
def task_set_entry_fn(t: Int, fn: Int): Void = volatile_store<U64>(t + TASK_ENTRY_FN, fn)
# Path C — entry_fn is load-bearing (was "for debugging"): schedule-in
# reads it to seed the active stack on a task's first run.
def task_entry_fn(t: Int): Int = volatile_load<U64>(t + TASK_ENTRY_FN)
def task_next_free(t: Int): Int = volatile_load<U64>(t + TASK_NEXT_FREE)
def task_set_next_free(t: Int, p: Int): Void = volatile_store<U64>(t + TASK_NEXT_FREE, p)

# Path C.5.5 — base + top of THIS CPU's active stack (read via %gs). Frames
# grow DOWN from active_stack_top(); a task's saved length is
# (active_stack_top() - its saved_rsp). Both read the current CPU's slot, so
# the schedule-in (ensure_active_stack) and schedule-out
# (sched_park_active_stack) paths — which always run on the CPU that owns the
# task — automatically address the right stack.
def active_stack_base(): Int = cpu_local_load(PCPU_ACTIVE_STACK_BASE)
def active_stack_top(): Int = active_stack_base() + TASK_STACK_BYTES

# ==========================================================================
# C.5.1 — Saved-stack allocator (for copying-stack scheduling, Path C §10)
# ==========================================================================
#
# Copying-stack scheduling parks a task by copying the USED portion of the
# single shared active stack into a right-sized per-task buffer (and freeing
# the active stack for the next task). Those buffers persist across yields
# for the task's whole parked lifetime — freed only on task_free, or replaced
# when a deeper park needs more room. This is a purpose-built size-classed
# sub-page allocator for exactly that.
#
# Why NOT the C `slab_alloc`: it caps at 512 B (a parked HTTP frame can reach
# 16 KiB) AND auto-tracks every allocation into the calling task's per-REQUEST
# arena (libc_stubs.c:313 slab_arena_track), which would sweep a saved buffer
# back to the freelist at request-end → use-after-free on the next resume.
#
# Classes span 0..TASK_STACK_BYTES (16 KiB), the most a saved frame can reach:
#   cls 0: 192 B   — a parked soul_demo_body is ~170 B; the common case.
#   cls 1: 1 KiB
#   cls 2: 4 KiB
#   cls 3: 16 KiB  — deepest HTTP-handler yield (one 4-page chunk).
# Intrusive freelists (free chunk's first 8 bytes = next-free ptr), refilled
# from the PMM bump on demand: classes 0-2 carve one 4 KiB page into
# floor(4096/size) chunks; class 3 is one 4-page chunk per refill.
#
# Single-CPU MVP — no lock (only the one scheduler allocs/frees, between
# switch boundaries). SMP needs a spinlock here, like the ready rings.
const SS_NUM_CLASSES = 4
const SS_CLASS_0 = 192
const SS_CLASS_1 = 1024
const SS_CLASS_2 = 4096
const SS_CLASS_3 = 16384   # == TASK_STACK_BYTES (the full active stack)

var g_ss_free_0 = 0
var g_ss_free_1 = 0
var g_ss_free_2 = 0
var g_ss_free_3 = 0
var g_ss_alloc_total = 0   # monotonic ss_alloc count
var g_ss_free_total  = 0   # monotonic ss_free count
var g_ss_live        = 0   # outstanding (alloc - free) — = sum of parked buffers
var g_ss_live_max    = 0   # high-water of live saved buffers (telemetry)
var g_ss_bytes       = 0   # PMM bytes consumed by ss refills (telemetry)
var g_ss_copy_max_len = 0  # C.5.2 — largest copy-out len seen (deepest parked frame, bytes)
var g_ss_copy_total   = 0  # C.5.2 — total copy-out (park) operations; ÷ wall-time = park rate

# Path C.5.5 — SMP allocator locks. Once APs pump (C.5.5.3), the bump PMM, the
# saved-stack allocator, and the task-pool freelists are touched concurrently
# by BSP + APs. Created once at single-threaded boot (kern8_pcpu_init, before
# any AP comes online); 0 until then so the heavy single-threaded boot
# allocation runs lock-free. Lock ORDER (acquire only in this direction to
# avoid deadlock): TASKPOOL → SS → PMM. ss_alloc → ss_refill → pmm_alloc_page
# is the only nested case (SS→PMM); task_free does ss_free + freelist work in
# SEPARATE critical sections (never nested), keeping g_taskpool_lock a leaf.
var g_pmm_lock      = 0    # guards g_pmm_next bump in pmm_alloc_page
var g_ss_lock       = 0    # guards g_ss_free_0..3 + ss counters in ss_alloc/ss_free
var g_taskpool_lock = 0    # guards g_task_free_head{,_thin} + alive/total counters

def ss_class_size(cls: Int): Int
  if cls == 0
    return SS_CLASS_0
  elsif cls == 1
    return SS_CLASS_1
  elsif cls == 2
    return SS_CLASS_2
  end
  return SS_CLASS_3
end

# Smallest class that fits `n` bytes. n is clamped to [0, 16384] by the
# caller (a saved frame can't exceed the 16 KiB active stack).
def ss_class_for(n: Int): Int
  if n <= SS_CLASS_0
    return 0
  elsif n <= SS_CLASS_1
    return 1
  elsif n <= SS_CLASS_2
    return 2
  end
  return 3
end

def ss_free_head(cls: Int): Int
  if cls == 0
    return g_ss_free_0
  elsif cls == 1
    return g_ss_free_1
  elsif cls == 2
    return g_ss_free_2
  end
  return g_ss_free_3
end

def ss_set_free_head(cls: Int, v: Int): Void
  if cls == 0
    g_ss_free_0 = v
  elsif cls == 1
    g_ss_free_1 = v
  elsif cls == 2
    g_ss_free_2 = v
  else
    g_ss_free_3 = v
  end
end

# Carve fresh PMM into chunks for class `cls`, pushed onto its freelist.
def ss_refill(cls: Int): Void
  if cls == 3
    # 16 KiB chunk = 4 CONTIGUOUS pages; one chunk per refill. The chunk is
    # used as a single 16 KiB saved-stack buffer (a frame memcpy'd in/out
    # spans the whole 16 KiB), so the 4 pages MUST be sequential. Under SMP
    # a per-page pmm_alloc_page() loop here would race a concurrent PMM
    # consumer (BSP malloc_pages, another CPU's ss_refill) stealing a middle
    # page → the "16 KiB" chunk overlaps live memory → wild-RSP. Same class
    # of bug as malloc_pages (PATH_C §12.8 #2). ss_refill already runs under
    # g_ss_lock; pmm_alloc_pages_contig adds g_pmm_lock for the bump (SS→PMM
    # order — the allowed nest). Lower probability than malloc_pages today
    # (class-3 only fires for frames > 4 KiB; the soul demo's copy_max_len is
    # 1368 → class-0), but the same latent break — fixed unconditionally.
    var base = pmm_alloc_pages_contig(4)
    volatile_store<U64>(base, g_ss_free_3)
    g_ss_free_3 = base
    g_ss_bytes = g_ss_bytes + 16384
    return
  end
  var size = ss_class_size(cls)
  var page = pmm_alloc_page()
  var per = 4096 / size
  var head = ss_free_head(cls)
  var i = 0
  while i < per
    var chunk = page + i * size
    volatile_store<U64>(chunk, head)
    head = chunk
    i = i + 1
  end
  ss_set_free_head(cls, head)
  g_ss_bytes = g_ss_bytes + 4096
end

# Allocate a buffer of at least `len` bytes. Returns the chunk base. The
# caller MUST record the class size (ss_class_size(ss_class_for(len))) so
# ss_free can route the chunk back to the right class.
def ss_alloc(len: Int): Int
  # Path C.5.5 — guard the freelists + counters; ss_refill nests pmm_alloc_page
  # (g_pmm_lock) under this lock (SS→PMM order). 0 before kern8_pcpu_init.
  var lk = g_ss_lock
  if lk != 0
    spinlock_lock(lk)
  end
  var cls = ss_class_for(len)
  if ss_free_head(cls) == 0
    ss_refill(cls)
  end
  var chunk = ss_free_head(cls)
  ss_set_free_head(cls, volatile_load<U64>(chunk))
  g_ss_alloc_total = g_ss_alloc_total + 1
  g_ss_live = g_ss_live + 1
  if g_ss_live > g_ss_live_max
    g_ss_live_max = g_ss_live
  end
  if lk != 0
    spinlock_unlock(lk)
  end
  return chunk
end

# Return a buffer to its class freelist. `cap` is the class SIZE recorded at
# alloc time (stored in TASK_SAVED_STACK_CAP), so ss_class_for(cap) recovers
# the exact class. No-op on a null ptr (task never parked).
def ss_free(ptr: Int, cap: Int): Void
  if ptr == 0
    return
  end
  # Path C.5.5 — guard the freelist push + counters. No nested locks (ss_free
  # never refills), so this is a leaf section.
  var lk = g_ss_lock
  if lk != 0
    spinlock_lock(lk)
  end
  var cls = ss_class_for(cap)
  volatile_store<U64>(ptr, ss_free_head(cls))
  ss_set_free_head(cls, ptr)
  g_ss_free_total = g_ss_free_total + 1
  g_ss_live = g_ss_live - 1
  if lk != 0
    spinlock_unlock(lk)
  end
end

# C.5.1 boot self-test. Exercises class selection, alloc/free round-trips,
# LIFO freelist reuse, and grow (free small + alloc large). Returns the
# count of passed checks out of SS_SMOKE_CHECKS. Pure — touches only the ss
# freelists (which the scheduler also uses post-C.5.2; running it at boot
# just pre-warms them with valid chunks).
const SS_SMOKE_CHECKS = 12
def ss_smoke(): Int
  var ok = 0
  # class boundaries (expression-if form: `if c then a else b end`)
  ok = ok + (if ss_class_for(1) == 0 then 1 else 0 end)
  ok = ok + (if ss_class_for(192) == 0 then 1 else 0 end)
  ok = ok + (if ss_class_for(193) == 1 then 1 else 0 end)
  ok = ok + (if ss_class_for(4096) == 2 then 1 else 0 end)
  ok = ok + (if ss_class_for(4097) == 3 then 1 else 0 end)
  ok = ok + (if ss_class_for(16384) == 3 then 1 else 0 end)
  # alloc returns a usable, distinct pair; write+read back through the chunk
  var a = ss_alloc(170)
  var b = ss_alloc(170)
  ok = ok + (if a != 0 then 1 else 0 end)
  ok = ok + (if b != 0 then 1 else 0 end)
  ok = ok + (if a != b then 1 else 0 end)
  store(a, 0, 0xABCD1234)
  store(b, 0, 0x5678BEEF)
  ok = ok + (if load(a, 0) == 0xABCD1234 then 1 else 0 end)
  # LIFO reuse: free b (cap=192) then a; next alloc(170) returns a (last freed)
  ss_free(b, 192)
  ss_free(a, 192)
  var c = ss_alloc(170)
  ok = ok + (if c == a then 1 else 0 end)
  ss_free(c, 192)
  # class 3 (16 KiB / 4-page refill path) — distinct region, read/write top.
  var d = ss_alloc(10000)
  store(d, 16376, 0xFEEDFACE)
  ok = ok + (if (d != 0) and (load(d, 16376) == 0xFEEDFACE) then 1 else 0 end)
  ss_free(d, 16384)
  return ok
end

# Initialize the task struct pool + the single active stack + ready ring.
#
# Path C.5.2 (2026-05-31) — stacks are NO LONGER pre-reserved one-per-slot,
# and there is NO stack pool either: a single 16-KiB active stack backs every
# RUNNING task, and parked tasks hold right-sized ss buffers. The pool slots
# cost only TASK_STRUCT_SIZE each (216 B). This is what decouples task
# capacity from RAM: at NUM_TASKS=4M the boot footprint is ~864 MB of task
# structs + 16 KiB of active stack, instead of ~16 GB of per-slot stacks.
# Saved-stack buffers grow on demand (≈192 B per parked demo body) and are
# bounded by the number of concurrently-parked tasks, not by capacity.
#
# At NUM_TASKS=4M: task pool ≈ 864 MiB (221185 pages), active stack = 16 KiB
# (4 pages), each ready ring = 32 MiB.
# The PMM bump allocator returns contiguous pages on consecutive calls, so
# each multi-page region is a sequence of pmm_alloc_page() calls — we keep
# the FIRST page address and let the bump advance. Freelists are built in
# reverse so task_alloc hands out slot 0 first (stable IDs ease serial logs).
def uk_sched_init(): Void
  # Pool: NUM_TASKS × TASK_STRUCT_SIZE bytes, page-rounded up.
  var pool_bytes = NUM_TASKS * TASK_STRUCT_SIZE
  var pool_pages = (pool_bytes + 4095) / 4096
  g_task_pool = pmm_alloc_page()
  var pi = 1
  while pi < pool_pages
    pmm_alloc_page()
    pi = pi + 1
  end

  # K8.6: per-CPU ring init lives in kern8_pcpu_init (rings come up
  # alongside the per-CPU page so APs entering ap_main pre-uk_sched_init
  # find valid empty rings, not null spinlocks).
  # K8.MVP: main_rsp slot lives inside the per-CPU page (PCPU_SCHED_MAIN_RSP = 32),
  # zero-filled by kern8_pcpu_init via pmm_zero_page. No separate alloc here.

  # Zero the task pool so stale bytes can't appear as bogus state.
  var zp = 0
  while zp < pool_pages
    pmm_zero_page(g_task_pool + zp * 4096)
    zp = zp + 1
  end

  # Path C — stamp each slot's stable identity. TASK_STATE is already
  # FREE from the pool zero above; TASK_SAVED_STACK_PTR is already 0 (no
  # saved frames — schedule-in seeds the active stack on first run). We only
  # need to write TASK_ID, the slot's permanent index (used for fat/thin
  # freelist routing in task_free + per-task telemetry in
  # /api/soul/tasks.json).
  var i = 0
  while i < NUM_TASKS
    volatile_store<U32>(task_addr(i) + TASK_ID, i)
    i = i + 1
  end

  # Path C.5.5 — the active stack is now PER-CPU, allocated + canary-stamped
  # in kern8_pcpu_init (which runs before this) and stored at
  # %gs:PCPU_ACTIVE_STACK_BASE for each CPU. uk_sched_init no longer owns a
  # single shared stack; see active_stack_base() / active_stack_top().

  # Build the FAT freelist in reverse so slot 0 ends up at head — stable
  # ID assignment makes serial logs easier to read.
  g_task_free_head = 0
  i = NUM_TASKS_FAT - 1
  while i >= 0
    var t = task_addr(i)
    task_set_next_free(t, g_task_free_head)
    g_task_free_head = t
    i = i - 1
  end

  # Build the THIN freelist in reverse so slot NUM_TASKS_FAT (the first
  # thin slot) ends up at head — keeps IDs ascending in spawn order.
  g_task_free_head_thin = 0
  i = NUM_TASKS - 1
  while i >= NUM_TASKS_FAT
    var t = task_addr(i)
    task_set_next_free(t, g_task_free_head_thin)
    g_task_free_head_thin = t
    i = i - 1
  end

  g_task_alive = 0
  g_task_alive_thin = 0
  # PCPU_CURRENT_TASK + per-CPU ring head/tail/count in each per-CPU
  # page are zero-initialized by pmm_zero_page in kern8_pcpu_init; the
  # K8.6 ring loop above only stamps RING_BASE + SPINLOCK on top of
  # that zeroed state.

  # D.11 Phase 7 / B.1.a — warm the per-task effect-stack strip pool
  # with 256 strips (4 MiB upfront PMM). Strips are 4 contiguous pages
  # (16 KiB) and back the 7 effect-stack arrays per task. SOUL.6 demo
  # bodies never install handlers (the 256 warm strips stay idle); the
  # pool exists to keep the path open for Phase 8 when the unikernel's
  # http_serve migration drives real `with`-block effects per
  # connection.
  effect_stack_pool_init()
  # B.5c — kernel waiter side-table for Selectable<Int>::register_waker.
  # Allocated AFTER effect_stack_pool_init so a PMM exhaustion fails
  # the higher-priority effect-stack init first (clearer failure mode).
  kernel_waiter_init()
  # D.11 Phase 8b.2.c.4 — high-priority ring for HTTP-tier goroutines
  # (supervised_server_body + per-conn handlers via kern_go_closure_hi
  # + conn_body kernel TCP pumps). Drained first by ready_pop; demo
  # bodies live on the normal per-CPU ring. Sized at NUM_TASKS slots
  # (worst case = every task is high prio). One global ring; lifts to
  # per-CPU when SMP lands.
  hi_ring_init()
end

# ============================================================================
# K8.6 followup — global high-priority ready ring
# ============================================================================
#
# Single global LIFO ring drained ahead of the normal per-CPU rings. Hosts
# supervised HTTP server + per-conn HTTP handler + per-slot TCP pump
# goroutines. The normal per-CPU rings host bulk worker tasks (soul demo
# bodies + sched/chan/mutex boot demos).
#
# Single-CPU MVP. When SMP lands (K8.x post-MVP), this lifts to a per-CPU
# hi ring just like the normal ring already is.

var g_hi_ring_base  = 0   # base addr of NUM_TASKS × 8 bytes
var g_hi_ring_head  = 0   # dequeue index (mod NUM_TASKS)
var g_hi_ring_tail  = 0   # enqueue index (mod NUM_TASKS)
var g_hi_ring_count = 0   # current occupancy
var g_hi_ring_lock  = 0   # spinlock addr

# Allocate ring + spinlock. Idempotent — called explicitly from
# uk_sched_init AND lazily on every push/pop. Defensive against the
# `var X = 0` module_init ordering hazard
# ([[feedback-qz-module-init-trivial-store-ordering]]): if
# `__qz_module_init` ever runs `store 0, @g_hi_ring_lock` after this
# function set it, every later spinlock_lock(g_hi_ring_lock) would
# #GP on a null deref — same shape that drove the PMM-cursor-C-side
# rescue. The lazy-init guard re-allocates on next push if it sees 0.
def hi_ring_init(): Void
  if g_hi_ring_lock != 0
    return
  end
  var ring_bytes = NUM_TASKS * 8
  var ring_pages = (ring_bytes + 4095) / 4096
  var base = pmm_alloc_page()
  var i = 1
  while i < ring_pages
    pmm_alloc_page()
    i = i + 1
  end
  var zp = 0
  while zp < ring_pages
    pmm_zero_page(base + zp * 4096)
    zp = zp + 1
  end
  g_hi_ring_base = base
  g_hi_ring_head = 0
  g_hi_ring_tail = 0
  g_hi_ring_count = 0
  # spinlock_new last so a partial init still leaves the lock 0 (the
  # lazy-init guard above keys on lock != 0).
  g_hi_ring_lock = spinlock_new()
end

# Push `t` onto the high-priority ring. NUM_TASKS bounds total ring
# occupancy across the system, so overflow is impossible as long as
# only pool-allocated tasks reach here.
def hi_ring_push(t: Int): Void
  if g_hi_ring_lock == 0
    hi_ring_init()
  end
  spinlock_lock(g_hi_ring_lock)
  var tail = g_hi_ring_tail
  volatile_store<U64>(g_hi_ring_base + (tail * 8), t)
  tail = tail + 1
  if tail >= NUM_TASKS
    tail = 0
  end
  g_hi_ring_tail = tail
  g_hi_ring_count = g_hi_ring_count + 1
  spinlock_unlock(g_hi_ring_lock)
end

# Pop from the high-priority ring. Returns 0 if empty.
def hi_ring_pop(): Int
  if g_hi_ring_lock == 0
    hi_ring_init()
  end
  spinlock_lock(g_hi_ring_lock)
  if g_hi_ring_count == 0
    spinlock_unlock(g_hi_ring_lock)
    return 0
  end
  var head = g_hi_ring_head
  var t = volatile_load<U64>(g_hi_ring_base + (head * 8))
  head = head + 1
  if head >= NUM_TASKS
    head = 0
  end
  g_hi_ring_head = head
  g_hi_ring_count = g_hi_ring_count - 1
  spinlock_unlock(g_hi_ring_lock)
  return t
end

def hi_ring_count(): Int = g_hi_ring_count

def task_priority(t: Int): Int = volatile_load<U8>(t + TASK_PRIORITY)
def task_set_priority(t: Int, p: Int): Void = volatile_store<U8>(t + TASK_PRIORITY, p)

# Path C.5.5 — copying-stack home-CPU pinning.
const TASK_HOME_UNPINNED = 255  # sentinel: task has never parked (free to migrate)
def task_home_cpu(t: Int): Int = volatile_load<U8>(t + TASK_HOME_CPU)
def task_set_home_cpu(t: Int, c: Int): Void = volatile_store<U8>(t + TASK_HOME_CPU, c)
def cpu_sched_online(cpu: Int): Int = volatile_load<U64>(pcpu_page_for(cpu) + PCPU_SCHED_ONLINE)

# Fairness counter for ready_pop. Increments on every hi-ring pop.
# When it hits SCHED_FAIRNESS_QUANTUM, the next pop forces a normal-
# ring drain (if non-empty) and the counter resets. Designed so a
# yielding hi-priority task doesn't busy-loop the hi ring and starve
# normal work — common shape is supervised listener's default-arm
# `sched_yield()` re-dispatching itself in a tight cycle.
#
# Ratio 4:1 (4 hi pops per 1 forced normal pop). The supervised
# listener loop busy-polls (default-arm `sched_yield()` instead of
# blocking on the accept_chan waker), so under steady state it floods
# the hi ring with self-yield events. Tuning history:
#   - 16:1 starved demos under 10K load (~1% per second).
#   - 1:1 (50/50 split) kept demos happy under 10K but starved HTTP
#     under 30K — the supervised listener and per-conn handlers
#     compete with self-yield events for only 50% of cycles, and the
#     per-poll HTTP latency on the soul dashboard pushed past a
#     minute during the 30K-demo spawn (2026-05-28 PM observation).
#   - 4:1 keeps HTTP polls under 10 ms during 10K-demo load AND
#     gives demos ~20% of CPU. Under 30K, per-demo CPU = ~7 µs/s,
#     enough for the demo busy-yield's elapsed-time check to fire
#     once per second; demos still drain within their 1-second
#     deadline. Reverted to 4 (from 1) to address the prod
#     observation.
# Filed-forward (KERN.PRIO.1): a properly-blocking supervised loop
# (drop the default arm under @cfg(os: "unknown") + rely on the
# tcp_acceptable waker) would eliminate the hi-ring busy-loop
# entirely and let the ratio go back to "strict hi preempts normal".
const SCHED_FAIRNESS_QUANTUM = 4
var g_sched_hi_streak = 0

def task_alloc(): Int
  # Path C.5.5 — guard the fat freelist pop + shared counters. Leaf section
  # (the per-task slot zeroing below operates on `t`, no longer shared once
  # popped, so it runs outside the lock).
  var lk = g_taskpool_lock
  if lk != 0
    spinlock_lock(lk)
  end
  var t = g_task_free_head
  if t == 0
    if lk != 0
      spinlock_unlock(lk)
    end
    return 0
  end
  g_task_free_head = task_next_free(t)
  g_task_alive = g_task_alive + 1
  g_task_spawn_total = g_task_spawn_total + 1
  if g_task_alive > g_task_alive_max
    g_task_alive_max = g_task_alive
  end
  if lk != 0
    spinlock_unlock(lk)
  end
  task_set_next_free(t, 0)
  # Path C.5.2 — belt-and-suspenders zero of the saved-stack slots. task_free
  # already zeros TASK_SAVED_STACK_PTR on return, but the SLAB.2 history shows
  # freed slots can be clobbered by stray writes between free and alloc; a
  # stale non-zero PTR here would make schedule-in take the resume copy-in
  # path (memcpy from a garbage buffer) instead of seeding a first-run frame.
  # Zero all three so first schedule-in always sees "never parked → seed."
  volatile_store<U64>(t + TASK_SAVED_STACK_PTR,     0)
  volatile_store<U64>(t + TASK_SAVED_STACK_LEN,     0)
  volatile_store<U64>(t + TASK_SAVED_STACK_CAP,     0)
  # Path C.5.5 — fresh task is unpinned: free to distribute to the least-loaded
  # CPU at first push. It pins to whichever CPU first parks it.
  task_set_home_cpu(t, TASK_HOME_UNPINNED)
  # B.1.a — zero the per-task effect-stack scalar snapshot slots.
  # Required because a freed task's bytes are NOT re-zeroed on alloc
  # (the pool is zeroed once at uk_sched_init); previous user may have
  # left stale scalar state. The 7 ptr-base slots are zeroed by
  # task_effect_strip_free in the task_free path, so they're already
  # 0 on a freshly-freed slot. New-from-init slots are 0 from
  # pmm_zero_page.
  volatile_store<U64>(t + TASK_EFFECT_STACK_TOP,    0)
  volatile_store<U64>(t + TASK_CURRENT_SCOPE,       0)
  volatile_store<U64>(t + TASK_SCOPED_CTX_TOP,      0)
  volatile_store<U64>(t + TASK_ALLOC_IN_HANDLER,    0)
  volatile_store<U64>(t + TASK_EFFECT_SNAPSHOT,     0)
  volatile_store<U64>(t + TASK_PARK_RV,             1)   # POLL_READY default
  # D.11 Phase 8b.2.c.7 — per-request arena slot. Must be zeroed on every
  # task_alloc so a reused slot does not inherit a stale arena chain
  # head from its previous occupant; without this, arena_begin's
  # "defensively drain a non-zero slot" branch walks a chain that points
  # into already-freed multi-page chunks and faults #GP in malloc_pages.
  volatile_store<U64>(t + TASK_ARENA_HEAD,          0)
  # SLAB.1 — same hazard as TASK_ARENA_HEAD: a stale slab chain head
  # would walk into freed chain pages on arena_begin's defensive drain
  # path. Zero it on every alloc.
  volatile_store<U64>(t + TASK_SLAB_ARENA_HEAD,     0)
  # B.5e — a reused slot must not inherit a stale actor inbox from its
  # previous occupant, or actor_self_inbox() would return a dead handle.
  volatile_store<U64>(t + TASK_ACTOR_INBOX,         0)
  # KERN.SLAB.2 — zero the 7 effect-stack ptr-base slots explicitly.
  # Previous comment claimed strip_free + pmm_zero_page kept them clean,
  # but the 2026-05-28 PM session showed task 40 reliably got
  # task[+88]=0x10005AFF0 (= &task[176]), task[+96]=0x100056008
  # (= task_slot(1)), task[+104]=0x11b4b6 (= a RA inside task_a_body).
  # These are the boot smoke test's stack-frame contents from
  # task_init_stack(stack_a, task_a_body): stack_a is one PMM page, but
  # task_init_stack uses `top = stack_a + TASK_STACK_BYTES` = stack_a +
  # 16384, so the seeded ret-frame lands at addresses 12 KB ABOVE
  # stack_a's actual allocation — INSIDE the task pool's first 2 pages
  # once uk_sched_init bump-allocates them. The pool zero loop SHOULD
  # cover those pages but didn't (filed forward for separate
  # investigation). Belt-and-suspenders: zero here so install /
  # strip_alloc / restore_names_check always start from a clean slate
  # regardless of upstream zero-out.
  volatile_store<U64>(t + TASK_EFFECT_STACK_NAMES,        0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_HANDLERS,     0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_BUFS,         0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_OP_FILTERS,   0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESULTS,      0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_STATE_SLOTS,  0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESUMED,      0)
  # Diagnostic barrier (still useful as a regression detector — if it
  # fires AFTER the explicit zeroing above, the writer has come from
  # somewhere even more surprising).
  qz_task_alloc_dirty_check(t)
  return t
end

# Path B (2026-05-29) — Thin-pool counterpart of `task_alloc`. Pops from
# `g_task_free_head_thin` (slot ids NUM_TASKS_FAT..NUM_TASKS-1, 1-page
# stacks). Returns 0 on thin-pool exhaustion — does NOT fall back to fat,
# because the only path that calls this is the bulk demo spawn and
# falling back would silently re-waste the budgeted memory savings on a
# slot that is 4× larger than required. Slot bookkeeping mirrors
# `task_alloc` exactly: combined `g_task_alive` counter, plus a
# thin-only `g_task_alive_thin` so the spawn handler can size its
# headroom against the thin pool directly.
def task_alloc_thin(): Int
  # Path C.5.5 — the hot concurrent allocator: the spawn handler (BSP) allocs
  # while demo bodies free on every CPU. Guard the thin freelist pop + counters.
  var lk = g_taskpool_lock
  if lk != 0
    spinlock_lock(lk)
  end
  var t = g_task_free_head_thin
  if t == 0
    if lk != 0
      spinlock_unlock(lk)
    end
    return 0
  end
  g_task_free_head_thin = task_next_free(t)
  g_task_alive = g_task_alive + 1
  g_task_alive_thin = g_task_alive_thin + 1
  g_task_spawn_total = g_task_spawn_total + 1
  if g_task_alive > g_task_alive_max
    g_task_alive_max = g_task_alive
  end
  if lk != 0
    spinlock_unlock(lk)
  end
  task_set_next_free(t, 0)
  # Zero the per-task effect-stack scalar snapshot slots + arena head
  # slots, same defense-in-depth as task_alloc. Demo bodies don't install
  # effects, but the slots are read by save/restore on every yield (via
  # the codegen-emitted per-task strip helpers), so leaving stale bytes
  # would put a freed task's last value into the resumed task's globals.
  # Path C.5.2 — zero the saved-stack slots so first schedule-in seeds a
  # first-run frame (see the matching note in task_alloc).
  volatile_store<U64>(t + TASK_SAVED_STACK_PTR,     0)
  volatile_store<U64>(t + TASK_SAVED_STACK_LEN,     0)
  volatile_store<U64>(t + TASK_SAVED_STACK_CAP,     0)
  # Path C.5.5 — unpinned until first park (see task_alloc).
  task_set_home_cpu(t, TASK_HOME_UNPINNED)
  volatile_store<U64>(t + TASK_EFFECT_STACK_TOP,    0)
  volatile_store<U64>(t + TASK_CURRENT_SCOPE,       0)
  volatile_store<U64>(t + TASK_SCOPED_CTX_TOP,      0)
  volatile_store<U64>(t + TASK_ALLOC_IN_HANDLER,    0)
  volatile_store<U64>(t + TASK_EFFECT_SNAPSHOT,     0)
  volatile_store<U64>(t + TASK_PARK_RV,             1)
  volatile_store<U64>(t + TASK_ARENA_HEAD,          0)
  volatile_store<U64>(t + TASK_SLAB_ARENA_HEAD,     0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_NAMES,        0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_HANDLERS,     0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_BUFS,         0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_OP_FILTERS,   0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESULTS,      0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_STATE_SLOTS,  0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESUMED,      0)
  qz_task_alloc_dirty_check(t)
  return t
end

def task_free(t: Int): Void
  # D.11 Phase 8b.2.c.7 — drain any in-flight per-request arena chain.
  # Catches the throw-unwind case where the per-conn loop never reached
  # `qz_arena_end` for its current iteration. Returns the chunks to the
  # multi-page freelist instead of leaving them stranded until the slot
  # is reused (which would zero the slot and silently drop the chunks).
  qz_arena_drain_task(t)
  # B.1.a — release the effect-stack strip back to the pool before
  # freeing the slot. Idempotent — no-op if this task never installed
  # any effects (TASK_EFFECT_STACK_NAMES still 0).
  task_effect_strip_free(t)
  # Path C.5.2 — free the task's saved-stack buffer (if it ever parked).
  # task_free runs from sched_post_switch's DEAD branch AFTER switch_to has
  # returned to main, so the dying task's frames (on the shared active stack)
  # are no longer needed and the saved buffer holds only stale pre-resume
  # bytes. This is the ONLY ss_free edge for a buffer's lifetime: a task
  # reuses+grows its buffer across every yield/block while alive, and frees
  # it exactly once here on exit. Guard on != 0: a slot freed without ever
  # parking (ran to completion on first quantum, or never scheduled) has no
  # buffer. Zero the slots too, so a reused slot can never inherit a stale
  # buffer ptr (same stale-pointer class as TASK_ARENA_HEAD / SLAB.2 history).
  var saved_buf = task_saved_stack_ptr(t)
  if saved_buf != 0
    var saved_cap = task_saved_stack_cap(t)
    volatile_store<U64>(t + TASK_SAVED_STACK_PTR, 0)
    volatile_store<U64>(t + TASK_SAVED_STACK_LEN, 0)
    volatile_store<U64>(t + TASK_SAVED_STACK_CAP, 0)
    ss_free(saved_buf, saved_cap)
  end
  # Clear scheduling priority so a slot reused for a normal-tier body
  # doesn't inherit the previous task's hi-priority. (task_alloc
  # doesn't re-zero this byte; the cleanup must happen on free.)
  task_set_priority(t, 0)
  # Path C.5.5 — reset home so a reused slot starts unpinned. task_alloc
  # also sets this, but reset on free too for defense-in-depth (same
  # stale-byte class as priority).
  task_set_home_cpu(t, TASK_HOME_UNPINNED)
  task_set_state(t, TASK_STATE_FREE)
  # Path B — route the slot back to its origin freelist by slot id.
  # TASK_ID was stamped at boot to the slot's pool index and never
  # changes across reuse, so it's a stable discriminator. Slots
  # 0..NUM_TASKS_FAT-1 = fat; rest = thin.
  # Path C.5.5 — guard the freelist push + counters. The cleanup above
  # (arena drain / strip free / ss_free) ran in their OWN critical sections,
  # so g_taskpool_lock stays a leaf (no nested locks) — no deadlock vs the
  # SS→PMM nest. `t` is unreachable by other CPUs until pushed here, so the
  # pre-lock slot writes (priority/home/state) don't race.
  var slot_id = uk_task_id(t)
  var lk = g_taskpool_lock
  if lk != 0
    spinlock_lock(lk)
  end
  if slot_id < NUM_TASKS_FAT
    task_set_next_free(t, g_task_free_head)
    g_task_free_head = t
  else
    task_set_next_free(t, g_task_free_head_thin)
    g_task_free_head_thin = t
    g_task_alive_thin = g_task_alive_thin - 1
  end
  g_task_alive = g_task_alive - 1
  g_task_exit_total = g_task_exit_total + 1
  if lk != 0
    spinlock_unlock(lk)
  end
end

# ==========================================================================
# D.11 Phase 7 / B.1.a — Per-task effect-stack strip pool
# ==========================================================================
#
# Each strip is 4 contiguous PMM pages (16 KiB) backing 7 arrays of
# 256 i64 slots each:
#   strip + 0     names[0..256)
#   strip + 2048  handlers[256..512)
#   strip + 4096  bufs[512..768)
#   strip + 6144  op_filters[768..1024)
#   strip + 8192  results[1024..1280)
#   strip + 10240 state_slots[1280..1536)
#   strip + 12288 resumed[1536..1792)
# Total live bytes = 14 336; the final 2 048 bytes are page-quantization
# padding (acceptable — 4-page granularity matches the PMM bump unit).
#
# The pool is an intrusive freelist: a strip's first u64 (offset 0)
# holds the next-strip pointer while free; on take(), the freelist link
# is overwritten by the actual `names[0]` slot.
#
# Pre-warm at uk_sched_init: 256 strips × 16 KiB = 4 MiB upfront PMM,
# enough headroom that SOUL.6 demo bursts (8/1000/N children) don't
# trigger fresh pmm_alloc_page hits during the demo run.
#
# At NUM_TASKS=32768 × 16 KiB = 512 MiB worst-case if every task ever
# installs an effect (filed forward at SOUL.5 v6+ — array-cell
# compaction). SOUL.6 today installs zero, paying only the 4 MiB warm.

const EFFECT_STRIP_BYTES        = 16384  # 4 pages × 4 KiB
const EFFECT_STRIP_ARRAY_BYTES  = 2048   # 256 × 8 bytes per sub-array
const EFFECT_STRIP_WARMUP_COUNT = 256

var g_effect_stack_pool         = 0  # head of intrusive freelist (0 = empty)
var g_effect_stack_pool_count   = 0  # current strips on freelist (soul/api telemetry)
var g_effect_stack_pool_lock    = 0  # spinlock for SMP-safe push/pop
var g_effect_stack_pool_take_total = 0  # monotonic take count
var g_effect_stack_pool_give_total = 0  # monotonic give count
var g_effect_stack_pool_pmm_fallback = 0  # take()s that hit pmm_alloc_page (pool was empty)

# Allocate one strip directly from the PMM bump — 4 contiguous pages.
# Caller owns the resulting 16 KiB block; bytes are zero-init thanks to
# pmm_zero_page invariants on bump-pool pages allocated through this
# path (every page subsequently used as a task stack is also zero-init
# from a prior pmm_alloc_page). Strictly speaking PMM bump itself doesn't
# zero — pmm_alloc_page just returns the next page; the zero-fill is a
# separate pmm_zero_page step done at known init sites. To be conservative,
# the take() path zeros the strip when it pulls from the freelist
# (freelist strips carry stale bytes from prior use); the PMM-fresh
# fallback path here also zeroes for symmetry.
def effect_strip_pmm_alloc(): Int
  var strip = pmm_alloc_page()
  if strip == 0
    # PMM exhausted — caller must handle 0 return as OOM. There's no
    # graceful recovery; subsequent effect installs on this task will
    # silently no-op (top stays 0, install skips via the cap=256 check
    # against an unallocated base ptr).
    return 0
  end
  var pg = 1
  while pg < 4
    var more = pmm_alloc_page()
    if more == 0
      # Partial allocation — we've consumed 1..pg pages from PMM and
      # the 4-page contiguity is broken. Bail. The leaked pages are
      # not recoverable (bump never reclaims) but the alternative is
      # an unterminated PMM walk.
      return 0
    end
    pg = pg + 1
  end
  # Zero the strip explicitly. 16384 / 8 = 2048 i64 stores.
  var p = 0
  while p < EFFECT_STRIP_BYTES
    volatile_store<U64>(strip + p, 0)
    p = p + 8
  end
  return strip
end

# Initialize the strip pool with EFFECT_STRIP_WARMUP_COUNT strips, threaded
# onto the freelist back-to-front so strip 0 (lowest-address) emerges
# first on the next take. Called once from uk_sched_init right after the
# task pool / stack init.
def effect_stack_pool_init(): Void
  g_effect_stack_pool_lock = spinlock_new()
  var i = 0
  while i < EFFECT_STRIP_WARMUP_COUNT
    var strip = effect_strip_pmm_alloc()
    if strip == 0
      # PMM exhausted during warmup — log and continue. Pool ends up
      # smaller than warmup_count; task_effect_strip_alloc will fall
      # back to fresh pmm_alloc_page on take()-empty.
      uart_put_str("[uk_sched] effect_stack_pool_init OOM at i=")
      uart_put_uint(i)
      uart_putc(10)
      i = EFFECT_STRIP_WARMUP_COUNT  # break
    else
      volatile_store<U64>(strip, g_effect_stack_pool)
      g_effect_stack_pool = strip
      g_effect_stack_pool_count = g_effect_stack_pool_count + 1
      i = i + 1
    end
  end
end

# Take one strip from the freelist; falls back to direct PMM allocation
# if the pool is empty. Returns 0 on PMM OOM. The returned strip is
# zero-filled (freelist strips are zeroed here on take; PMM-fresh strips
# are zeroed by effect_strip_pmm_alloc).
def effect_strip_take(): Int
  spinlock_lock(g_effect_stack_pool_lock)
  var strip = g_effect_stack_pool
  if strip != 0
    g_effect_stack_pool = volatile_load<U64>(strip)
    g_effect_stack_pool_count = g_effect_stack_pool_count - 1
    g_effect_stack_pool_take_total = g_effect_stack_pool_take_total + 1
    spinlock_unlock(g_effect_stack_pool_lock)
    # Zero the strip — its first u64 was the freelist-next ptr, and
    # subsequent bytes may carry stale handler/buf state from prior use.
    var p = 0
    while p < EFFECT_STRIP_BYTES
      volatile_store<U64>(strip + p, 0)
      p = p + 8
    end
    return strip
  end
  g_effect_stack_pool_pmm_fallback = g_effect_stack_pool_pmm_fallback + 1
  g_effect_stack_pool_take_total = g_effect_stack_pool_take_total + 1
  spinlock_unlock(g_effect_stack_pool_lock)
  return effect_strip_pmm_alloc()
end

# Return one strip to the freelist. NULL-safe (no-op on strip=0). The
# strip is NOT zeroed here — the take() path zeros on next use, which
# keeps give() short on the hot path. Stale bytes between give and the
# next take are harmless because the strip is unreachable from any task.
def effect_strip_give(strip: Int): Void
  if strip == 0
    return
  end
  spinlock_lock(g_effect_stack_pool_lock)
  volatile_store<U64>(strip, g_effect_stack_pool)
  g_effect_stack_pool = strip
  g_effect_stack_pool_count = g_effect_stack_pool_count + 1
  g_effect_stack_pool_give_total = g_effect_stack_pool_give_total + 1
  spinlock_unlock(g_effect_stack_pool_lock)
end

# Allocate a strip for this task (if not already allocated) and thread
# the 7 array-base pointers into the task's TASK_EFFECT_STACK_* slots.
# Idempotent — if the task already has a strip (NAMES != 0), this is a
# no-op. Called by the compiler-emitted runtime on first install for
# this task (B.1.b wires this up; B.1.a ships the substrate).
def task_effect_strip_alloc(t: Int): Void
  var names_base = volatile_load<U64>(t + TASK_EFFECT_STACK_NAMES)
  if names_base != 0
    return
  end
  var strip = effect_strip_take()
  if strip == 0
    # PMM OOM — the 7 base slots stay 0. Subsequent installs see the
    # all-zero state and silently skip (cap-check fails against a
    # null base). At install rate >> demand, this is a hard system
    # failure, but the kernel survives.
    return
  end
  volatile_store<U64>(t + TASK_EFFECT_STACK_NAMES,        strip + 0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_HANDLERS,     strip + EFFECT_STRIP_ARRAY_BYTES)
  volatile_store<U64>(t + TASK_EFFECT_STACK_BUFS,         strip + EFFECT_STRIP_ARRAY_BYTES * 2)
  volatile_store<U64>(t + TASK_EFFECT_STACK_OP_FILTERS,   strip + EFFECT_STRIP_ARRAY_BYTES * 3)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESULTS,      strip + EFFECT_STRIP_ARRAY_BYTES * 4)
  volatile_store<U64>(t + TASK_EFFECT_STACK_STATE_SLOTS,  strip + EFFECT_STRIP_ARRAY_BYTES * 5)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESUMED,      strip + EFFECT_STRIP_ARRAY_BYTES * 6)
end

# Release a task's strip back to the pool. Idempotent on tasks that
# never installed (NAMES still 0). Zeroes the 7 base slots so a future
# task_alloc → task_effect_strip_alloc cycle starts clean.
def task_effect_strip_free(t: Int): Void
  var names_base = volatile_load<U64>(t + TASK_EFFECT_STACK_NAMES)
  if names_base == 0
    return
  end
  # All 7 array bases share one 16 KiB strip; NAMES IS the strip head
  # (offset 0). Pass that back to the pool.
  effect_strip_give(names_base)
  volatile_store<U64>(t + TASK_EFFECT_STACK_NAMES,        0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_HANDLERS,     0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_BUFS,         0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_OP_FILTERS,   0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESULTS,      0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_STATE_SLOTS,  0)
  volatile_store<U64>(t + TASK_EFFECT_STACK_RESUMED,      0)
end

# D.11 Phase 7 / B.1.b — declarations of the compiler-emitted bridge
# helpers (codegen_runtime.qz freestanding emit block). The actual
# bodies live in compiler-generated IR; declaring them here as extern
# `def` lets Quartz call them through the normal call path. The bridge
# emits @__qz_effect_save_to_task and @__qz_effect_restore_from_task at
# freestanding compile (per-task save/restore of the 4 scalar +
# 7 ptr-base globals).
extern "C" def __qz_effect_save_to_task(t: Int): Void
extern "C" def __qz_effect_restore_from_task(t: Int): Void

# D.11 Phase 7 / B.1.b — strip ensurer.
# Called from the compiler-emitted @__qz_effect_handle_install at the
# top of every install. Idempotently:
#  1. Confirms a current task exists (no-op from main context).
#  2. Allocates this task's 16 KiB effect-stack strip from the pool if
#     not yet allocated.
#  3. Refreshes the process-global @__qz_effect_stack_* ptr-base symbols
#     from the task's slots (writing-globals dispatched via the
#     compiler-emitted __qz_effect_restore_from_task helper, which knows
#     the symbol names).
# Post-condition: @__qz_effect_stack_names is either non-null and points
# at THIS task's strip, OR null (main context / strip alloc OOM). The
# caller (compiler-emitted install body) checks for null and silently
# skips on null.
def __qz_eff_ensure_strip(): Void
  var cur = sched_current()
  if cur == 0
    # Main context — no strip, no save/restore. install silently no-ops.
    return
  end
  # Path C.5.5.6 — effect installs are confined to BSP (the process-global
  # effect stack is not SMP-safe; see eff_on_bsp). An effect install reaching
  # an AP means an AP task installed an effect — the BSP-only invariant is
  # violated at its source. Halt loudly rather than race the globals.
  if cpu_current_id() != 0
    uart_put_str("[EFFECT-AP-INSTALL] effect install on AP cpu=")
    uart_put_uint(cpu_current_id())
    uart_put_str(" task=")
    uart_put_uint(cur)
    uart_put_str(" — halting (C.5.5.6 BSP-only effect invariant violated)\n")
    @c("cli; 1: hlt; jmp 1b")
  end
  var names_base = volatile_load<U64>(cur + TASK_EFFECT_STACK_NAMES)
  if names_base != 0
    # Already alloc'd for this task; globals were refreshed by the
    # scheduler's restore_from_task call at the prior context-switch
    # boundary, so they already point at this strip. Cheap fall-through.
    return
  end
  # First install on this task: alloc the strip + refresh globals.
  task_effect_strip_alloc(cur)
  __qz_effect_restore_from_task(cur)
end

# D.11 Phase 7 / B.1.b — DCE keepalive for the bridge helpers.
# `__qz_eff_ensure_strip` is reached only from compiler-emitted IR
# (@__qz_effect_handle_install body); the Quartz-source-level call
# graph rooted at `main` doesn't see it, so Quartz's DCE prunes it
# before LLC, producing `undefined symbol: __qz_eff_ensure_strip` at
# link. Mirror the `ap_main_keepalive_guard` pattern: a never-true
# guard wrapping a call edge, called from main.
#
# task_effect_strip_alloc is reached only through __qz_eff_ensure_strip,
# so it'd be DCE'd too without the explicit edge here.
var g_b1b_keepalive = 0
def __qz_b1b_keepalive_guard(): Void
  if g_b1b_keepalive == 1
    __qz_eff_ensure_strip()
    task_effect_strip_alloc(0)
  end
end

# Path C.5.5.6 — BSP-only confinement of the process-global effect stack.
#
# The effect runtime keeps the "current effect stack" in PROCESS-GLOBAL symbols
# (@__qz_effect_stack_names / _handlers / …), refreshed by
# __qz_effect_{save,restore}_to/from_task on every context switch. That is not
# SMP-safe: if an AP refreshes the globals while BSP is mid-handler, it clobbers
# BSP's live effect state (a .rodata name ptr bleeds into a task slot — the
# [EFFECT-RESTORE-WILD-NAMES] prod wedge, §12.6).
#
# Fix (A): effect-USING tasks are all hi-priority HTTP, pinned to BSP (the hi
# ring is consumed by CPU 0 only, §12.1), so only BSP ever needs the globals.
# Gate every save/restore call site on this predicate — APs never read or write
# the process-globals, so BSP is the sole, single-threaded-with-itself owner and
# there is no cross-CPU race. At -smp 1 (prod) this is always true → behaviour is
# byte-identical to C.6. The durable fix (B) makes the globals per-CPU.
def eff_on_bsp(): Int = cpu_current_id() == 0

# Path C.5.5.6 guard — the BSP-only confinement is correct ONLY while no AP task
# carries effect state. That holds today (the soul demo bodies install nothing)
# but is fragile. If an AP is ever about to schedule a task whose effect strip is
# live (NAMES != 0), silently skipping its restore would corrupt BSP's globals on
# the next BSP restore; halt loudly instead so the violation is diagnosed, not
# hidden. Fix (B) removes this constraint.
def eff_guard_no_ap_strip(next: Int): Void
  var names = volatile_load<U64>(next + TASK_EFFECT_STACK_NAMES)
  if names != 0
    uart_put_str("[EFFECT-AP-STRIP] AP scheduling effect-carrying task=")
    uart_put_uint(next)
    uart_put_str(" names=")
    uart_put_uint(names)
    uart_put_str(" — halting (C.5.5.6 BSP-only effect invariant violated)\n")
    @c("cli; 1: hlt; jmp 1b")
  end
end

# D.11 Phase 7 / B.2 — boot-time setjmp/longjmp round-trip smoke.
# Lives in C (tools/baremetal/libc_stubs.c::setjmp_longjmp_smoke). Allocates
# a jmp_buf on its own frame, setjmp returns 0 → longjmp(env, 7) → setjmp
# returns 7. Wrapping in C keeps the returns_twice boundary inside one
# isolated frame with the right calling convention by construction.
extern "C" def setjmp_longjmp_smoke(): Int

# D.11 Phase 7 / B.3 — unhandled-effect kernel halt.
# Called from the compiler-emitted `@__qz_effect_unhandled` thunk (see
# codegen_runtime.qz freestanding emit block) when perform's stack scan
# completes without finding a handler for an op. Writes a diagnostic
# string to UART then halts the CPU. Resolved by the in-module define
# pattern (same as `__qz_eff_ensure_strip` — no forward `declare` in the
# emit block; llc rejects `declare`+`define` pairs).
#
# The eff/op args carry the requested effect-name + op-name as
# null-terminated c-strings; both are present in the program's string
# pool so the kernel can print them too. For B.3 the diagnostic is a
# fixed prefix + the effect name + ":" + op name + newline; richer
# diagnostics (call-site, task id, scope depth) land in a follow-up.
def __qz_eff_unhandled_halt(eff: Int, op: Int): Int
  uart_put_str("UNHANDLED EFFECT ")
  if eff != 0
    var i = 0
    while i < 64
      var c = volatile_load<U8>(eff + i)
      if c == 0
        i = 64
      else
        uart_putc(c)
        i = i + 1
      end
    end
  end
  uart_putc(46)  # '.'
  if op != 0
    var i = 0
    while i < 64
      var c = volatile_load<U8>(op + i)
      if c == 0
        i = 64
      else
        uart_putc(c)
        i = i + 1
      end
    end
  end
  uart_putc(10)
  @c("cli; 1: hlt; jmp 1b")
  return 0
end

# D.11 Phase 7 / B.3 — DCE keepalive extension.
# `__qz_eff_unhandled_halt` is reached only from compiler-emitted IR
# (the freestanding `@__qz_effect_unhandled` thunk). Same DCE-prune
# story as __qz_eff_ensure_strip — drop a guarded edge to keep the
# symbol alive through link.
var g_b3_keepalive = 0
def __qz_b3_keepalive_guard(): Void
  if g_b3_keepalive == 1
    __qz_eff_unhandled_halt(0, 0)
  end
end

# D.11 Phase 7 / B.4 — kernel-side __qz_effect_suspend + __qz_sched_wake.
#
# Compiler-emitted runtime declares both globals + the two access shims
# (@__qz_effect_park_rv_load / _store); the bodies below give the
# in-module define that llc resolves at link time. Same no-forward-declare
# pattern as __qz_eff_ensure_strip / __qz_eff_unhandled_halt.
extern "C" def __qz_effect_park_rv_load(): Int
extern "C" def __qz_effect_park_rv_store(v: Int): Void

# __qz_effect_suspend(): called by compiler-emitted IR at the trailing
# edge of every kind=3 perform (suspend opcode). Two return values:
#   1 (POLL_READY) — no park requested; perform's $poll caller treats as
#     a normal completion. The kind=3 handler that DOESN'T call
#     __qz_effect_park leaves @__qz_effect_park_rv at its default 1, so
#     a no-park path is just two loads + a return.
#   ANY OTHER VALUE — the kind=3 handler called __qz_effect_park(fd),
#     which stashed `-(fd+2)` into @__qz_effect_park_rv. In the freestanding
#     kernel we don't yet bridge fd→waiter — instead the caller (handler)
#     must have ALREADY wait_pushed itself onto the appropriate waitq
#     before returning from the perform. We park ourselves here:
#       1. Mark BLOCKED.
#       2. Drop the per-CPU current-task pointer.
#       3. switch_to(main rsp slot) — yields the CPU.
#       4. When we resume (someone called __qz_sched_wake on us), reset
#          park_rv to 1 and return 1.
def __qz_effect_suspend(): Int
  var cur = sched_current()
  if cur == 0
    # Main context — no per-task park machinery. Degenerate to POLL_READY;
    # main-context suspends are spurious (kind=3 handlers can't run there).
    return 1
  end
  var rv = __qz_effect_park_rv_load()
  if rv == 1
    return 1
  end
  # Park. The handler that wrote `rv` was responsible for wait_pushing
  # this task onto its target waitq BEFORE returning, so __qz_sched_wake
  # has a way back.
  task_set_state(cur, TASK_STATE_BLOCKED)
  set_sched_current(0)
  # Save effect-stack state before switching away. sched_pump's
  # __qz_effect_restore_from_task on resume reloads it. Mirrors yield_now.
  # Path C.5.5.6 — BSP-only: only BSP touches the process-global effect stack.
  if eff_on_bsp()
    __qz_effect_save_to_task(cur)
  end
  switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
  # Resumed. Reset park_rv to POLL_READY so a subsequent suspend on the
  # same task defaults to no-park. (The save/restore wiring already
  # restored park_rv from this task's slot; if a future handler wants to
  # park again it'll write a fresh negative sentinel.)
  __qz_effect_park_rv_store(1)
  return 1
end

# __qz_sched_wake(t): wake a parked task. Reuses the existing
# task_set_state + ready_push primitives — same path as the chan/mutex
# wake helpers (sched_post_switch in K8.6.4-5). Safe to call from any
# CPU; Path C.5.5 — a parked task is PINNED (it parked on a CPU, binding
# its frames to that CPU's active-stack VA), so ready_push routes it back
# to its home CPU's ring (cross-CPU enqueue + wake IPI if the waker is a
# different CPU). It resumes where it parked — never migrates.
#
# Caller invariants:
#   - `t` is in TASK_STATE_BLOCKED (the parked task). __qz_effect_suspend
#     transitioned it there before yielding.
#   - The wake-driver (channel send, scope cancel, deadline fire, etc.)
#     consumed `t` from its own waitq before this call; we don't unlink
#     here.
def __qz_sched_wake(t: Int): Void
  if t == 0
    return
  end
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
end

# DCE keepalive for the B.4 helpers. `__qz_effect_suspend` is reached
# only from compiler-emitted IR (the kind=3 perform's `call i64
# @__qz_effect_suspend()`); without an explicit edge from main's call
# graph Quartz's DCE prunes it before LLC. `__qz_sched_wake` is reached
# from Quartz-side wake drivers (B.4 smoke + future Selectable impls),
# but we mirror the same pattern for symmetry.
var g_b4_keepalive = 0
def __qz_b4_keepalive_guard(): Void
  if g_b4_keepalive == 1
    var b4ka_rv = __qz_effect_suspend()
    __qz_sched_wake(0)
    var b4ka_prv = __qz_effect_park_rv_load()
    __qz_effect_park_rv_store(b4ka_prv)
  end
end

# D.11 Phase 7 / B.3 — Throws-catch round-trip smoke (Quartz-only).
#
# Runs inside a goroutine so `sched_current() != 0` and the install path
# (via @__qz_eff_ensure_strip) actually provisions a per-task effect-stack
# strip. From main context the install would silently no-op — so a C-
# extern wrapper that bypassed the strip would have to fake-provision the
# globals, defeating the verification.
#
# Smoke shape:
#   1. b3_throws_handler — records (handler_ran=1) and returns 7.
#   2. b3_throws_body — `with Throws { throw: b3_throws_handler } do ->
#      throw("oops"); body_after_throw=1 end` — body_after_throw must
#      stay 0 because kind=2 unwind never returns to the throw site.
#   3. After the with-block exits via unwind, b3_done flips.
# Main waits via `yield_now` until b3_done==1, then prints the
# `[B.3] throws caught ...` UART line.
# (`import std/throws` at file top with the other stdlib imports.)
var g_b3_handler_ran = 0
var g_b3_body_after_throw = 0
var g_b3_done = 0

# D.11 Phase 8a step 3 — runtime accept-flow smoke. Boot main registers
# port 5559 via kern_tcp_listen (with userland_mode=1) and stashes the
# listener slot ptr here; an early-spawn goroutine `smoke_8a3_accept_body`
# blocks on kern_tcp_accept until a host curl against :5559 drives a SYN
# through the dispatcher → tcp_accept_syn → accept_chan push. Result is
# logged via UART and the listener is closed (idempotent). Single-shot
# (one accept then close); a separate Phase 8b smoke exercises the
# repeated-accept loop.
var g_smoke_8a3_listener = 0
var g_smoke_8a3_accepted = 0
var g_smoke_8a3_done     = 0

def b3_throws_handler(op_name: Int, argc: Int, argv: Int): Int
  g_b3_handler_ran = 1
  # Return value is stashed into the with-block's results slot by perform
  # before the longjmp; the with-block's catch-path picks it up. We use 7
  # so the kernel UART line can echo it as a sanity check.
  return 7
end

def b3_throws_body(): Void
  with Throws { throw: b3_throws_handler } do ->
    throw("oops")
    # If perform's kind=2 unwind worked, this line never executes.
    g_b3_body_after_throw = 1
  end
  g_b3_done = 1
  task_exit()
end

# D.11 Phase 8a step 3+4 — runtime accept + read + write + close
# round-trip smoke goroutine. Blocks on kern_tcp_accept (step 3 path)
# until the dispatcher pushes the new conn slot; then exercises the
# step 4 read/write/close bridges:
#   - kern_tcp_read drains the HTTP request from the payload-rx ring
#     (chan_recv parks until the TCP pump deposits bytes).
#   - kern_tcp_write piggybacks on tcp_try_push to send a fixed
#     "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"
#     response (~71 bytes; fits in one segment, no window-close path).
#   - kern_tcp_close sends FIN + transitions to FIN_SENT; peer's ACK
#     drives LAST_ACK → CLOSED → tcp_free_slot.
# Single-shot (one accept then close listener); Phase 8b's
# http_serve_supervised loop covers the repeated-accept case.
#
# Spawned by main right after scheduler bringup so kern_tcp_accept is
# parked when the host curl on :5559 fires.

# Fixed response — declared at file scope so it gets a stable global
# storage that survives the goroutine's stack lifetime. Bytes match
# what curl on :5559 should print to stdout after the round-trip.
var g_smoke_8a3_response = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"

def smoke_8a3_accept_body(): Void
  if g_smoke_8a3_listener == 0
    uart_put_str("[8a.3] SKIP: listener not registered\n")
    task_exit()
  end
  uart_put_str("[8a.3] tcp_accept blocking on slot=")
  uart_put_uint(g_smoke_8a3_listener)
  uart_putc(10)
  var accepted = kern_tcp_accept(g_smoke_8a3_listener)
  g_smoke_8a3_accepted = accepted
  uart_put_str("[8a.3] tcp_accept returned slot=")
  uart_put_uint(accepted)
  uart_putc(10)
  if accepted == 0
    kern_tcp_close_listener(g_smoke_8a3_listener)
    g_smoke_8a3_done = 1
    task_exit()
  end

  # Step 4: drain the request via kern_tcp_read into a scratch buf.
  # 1500 bytes is enough for any small curl request line + headers.
  var read_buf = pmm_alloc_page()
  var read_n = kern_tcp_read(accepted, read_buf, 1500)
  uart_put_str("[8a.4] tcp_read returned ")
  uart_put_uint(read_n)
  uart_put_str(" bytes\n")

  if read_n > 0
    # Step 4: write the response via kern_tcp_write. Materialize the
    # String into a PMM page (copy_str_to_pmm — string_to_cstr lowers
    # to @strdup which isn't in libc_stubs.c).
    var resp_len = str_byte_len(g_smoke_8a3_response)
    var resp_ptr = copy_str_to_pmm(g_smoke_8a3_response, resp_len)
    var write_n = kern_tcp_write(accepted, resp_ptr, resp_len)
    uart_put_str("[8a.4] tcp_write returned ")
    uart_put_uint(write_n)
    uart_put_str(" / ")
    uart_put_uint(resp_len)
    uart_putc(10)
    # Step 4: close — sends FIN, TCP state machine finishes from there.
    var close_rc = kern_tcp_close(accepted)
    uart_put_str("[8a.4] tcp_close rc=")
    uart_put_uint(close_rc)
    uart_putc(10)
  end

  kern_tcp_close_listener(g_smoke_8a3_listener)
  g_smoke_8a3_done = 1
  task_exit()
end

# D.11 Phase 7 / B.4 — park/wake round-trip smoke.
#
# A goroutine sets the kind=3 park sentinel (-2), calls __qz_effect_suspend,
# yields control back to main via switch_to(main). Main reads the
# published task handle, calls __qz_sched_wake on it, drives sched_pump.
# The goroutine resumes inside __qz_effect_suspend, records the round-trip
# TSC delta, and exits.
#
# Direct sentinel write here bypasses the kind=3 handler that produces
# the same effect in a real perform — the B.4 deliverable is the park/wake
# bridge primitive, which doesn't depend on a particular kind=3 handler
# implementation. B.5+ exercises the full perform→handler→park flow.
var g_b4_task_handle    = 0
var g_b4_done           = 0
var g_b4_start_tsc      = 0
var g_b4_end_tsc        = 0
var g_b4_suspend_rv     = 0

def b4_park_body(): Void
  # Publish own handle so main can wake us. Must happen before park.
  g_b4_task_handle = sched_current()
  g_b4_start_tsc = read_tsc()
  # Simulate a kind=3 handler stashing a park sentinel into park_rv.
  # Any non-1 value triggers suspend's park path. -2 mirrors hosted's
  # `-(fd+2)` encoding for fd=0 (specific value irrelevant — only the
  # !=1 test matters here).
  __qz_effect_park_rv_store(-2)
  g_b4_suspend_rv = __qz_effect_suspend()
  # Resumed by __qz_sched_wake. Record the wall-clock delta.
  g_b4_end_tsc = read_tsc()
  g_b4_done = 1
  task_exit()
end

# D.11 Phase 7 / B.5a — KernelAwaitable + Selectable<Int> impl.
#
# Kernel-side Path C answer to "awaitable a kernel task." Stdlib's
# std/sync/composition/awaitable::FutureSelectable hard-codes the hosted
# 16-byte heap task-frame layout (slot 0 = state -1, slot 1 = result) +
# the @__qz_waiters side-table; neither maps to the kernel's 192-byte
# pool slot with TASK_STATE at offset 0 (U8 READY=1/RUNNING=2/BLOCKED=3/
# DEAD=4) and no per-task result slot.
#
# KAwait wraps (task_handle, captured_task_id). The captured ID closes
# the recycle race: TASK_ID is set at task_alloc to the slot index, but
# the slot itself can be recycled after task_free. Without the ID
# check, polling try_poll after a DEAD task was freed and the slot
# realloc'd to a fresh task would observe READY state of the NEW task
# and incorrectly report "still running". With the check, ID mismatch
# means "the task we were watching is gone — treat as completed."
#
# B.5a is polling-only: register_waker/unregister_waker are no-ops.
# B.5c will add a side-table + hook in sched_post_switch's DEAD branch
# to do active wake via __qz_sched_wake. The trait dispatch (Quartz
# vtable through Selectable<Int>) is the milestone for B.5a; polling
# latency is a B.5c concern.
struct KAwait
  task_handle: Int    # pool slot pointer
  task_id: Int        # captured TASK_ID at await-time
end

extend KAwait with Selectable<Int>
  def try_poll(self): Option<Int>
    var cur_id = volatile_load<U32>(@task_handle + TASK_ID)
    if cur_id != @task_id
      # Slot was recycled — original task is gone, treat as completed.
      return option_some(0)
    end
    var state = volatile_load<U8>(@task_handle + TASK_STATE)
    if state == TASK_STATE_DEAD
      return option_some(0)
    end
    if state == TASK_STATE_FREE
      # Slot was freed but TASK_ID happened to match (race) — completed.
      return option_some(0)
    end
    return option_none()
  end

  def register_waker(self, frame: Int): Void
    # B.5c — side-table push of (task_handle, frame). sched_post_switch's
    # DEAD branch walks all waiters on task_handle and __qz_sched_wakes
    # each before task_free recycles the slot.
    kernel_waiter_register(@task_handle, frame)
  end

  def unregister_waker(self, frame: Int): Void
    kernel_waiter_unregister(@task_handle, frame)
  end

  def complete(self): Int
    # Kernel tasks have no per-task result slot; complete() returns 0.
    # Callers needing a return value should use a side-channel global
    # (mutex-protected if SMP). B.5c does NOT change this — the result
    # slot would be a separate B.x concern (struct TASK_RESULT @ 184?).
    return 0
  end
end

def kernel_awaitable(t: Int): KAwait
  if t == 0
    return KAwait { task_handle: 0, task_id: 0 }
  end
  return KAwait { task_handle: t, task_id: volatile_load<U32>(t + TASK_ID) }
end

# B.5e.8c — blocking await of a kernel task handle. The compiler's freestanding
# `await <handle>` lowering (mir_emit_completion_await) calls this. A handle from
# `async f()` / `go f()` is a kernel TASK pointer (go_fn / kern_go_closure),
# NOT an async Future frame, so "done" is task_state DEAD/FREE — or a recycled
# TASK_ID, meaning the slot was already reused by a later spawn (same staleness
# guard KAwait::try_poll uses). Busy-yields until done; the awaited task gets CPU
# on every yield_now, and once it dies the driver's await returns so sched_pump
# can drain. Returns 0 — kernel tasks carry no result slot (mirrors
# KAwait::complete). std/actor's supervisor_stop is the first caller (`await
# sup.watcher`). FOLLOW-UP: active-park via register_waker + the B.5c DEAD-branch
# wake would drop the busy-yield; polling is adequate for the short post-done
# window here.
def kern_await(t: Int): Int
  if t == 0
    return 0
  end
  var id = volatile_load<U32>(t + TASK_ID)
  while 1 == 1
    if volatile_load<U32>(t + TASK_ID) != id
      return 0
    end
    var s = task_state(t)
    if s == TASK_STATE_DEAD
      return 0
    end
    if s == TASK_STATE_FREE
      return 0
    end
    yield_now()
  end
  return 0
end

# B.5a smoke. Two polls: BEFORE sched_pump() the spawned task is in
# state READY (slot just allocated, never run) — try_poll returns None.
# AFTER sched_pump() drains the goroutine (task_exit → sched_post_switch
# DEAD branch → task_free → state=FREE), the next try_poll returns Some.
#
# UART: `[B.5a] awaitable pre_pending=1 post_done=1 ok`.
var g_b5a_pre  = 0
var g_b5a_post = 0
var g_b5a_iters = 0

def b5a_body(): Void
  # Yield a few times to burn some scheduler cycles. Confirms we're
  # actually doing work, not just instant-exiting before main can poll.
  var i = 0
  while i < 5
    g_b5a_iters = g_b5a_iters + 1
    i = i + 1
    yield_now()
  end
  task_exit()
end

# D.11 Phase 7 / B.5b — KRecvable + Selectable<Int> over kernel channels.
#
# Stdlib std/sync/communication/channel::RecvSelectable's codegen
# intrinsic emits raw pthread_mutex/pthread_cond — see
# [[feedback-stdlib-codegen-intrinsics-hosted-only]]. Path C answer:
# parallel kernel-side Selectable impl that uses the existing kernel
# chan_* primitives (chan_count for peek, chan_recv for consume).
#
# try_poll snapshots head value under CHAN_LOCK — non-destructive
# (head pointer not advanced). complete() calls chan_recv which retries
# under SMP race (another receiver consumed the slot between try_poll
# and complete). complete() MUST be called from a goroutine (chan_recv
# parks on empty) — that's the Selectable contract: try_poll says it's
# ready, complete consumes; if the slot is gone we re-park.
#
# B.5b is also polling-only; B.5c adds register_waker that wires into
# chan_send's existing wake path (wait_pop on CHAN_RECV_WAIT already
# wakes via __qz_sched_wake — just need the side-table to know which
# select-arm to wake).
struct KRecvable
  ch: Int
end

extend KRecvable with Selectable<Int>
  def try_poll(self): Option<Int>
    var lock = @ch + CHAN_LOCK
    spinlock_lock(lock)
    if chan_count(@ch) == 0
      spinlock_unlock(lock)
      return option_none()
    end
    var head = chan_head(@ch)
    var buf = chan_buffer(@ch)
    var v = volatile_load<U64>(buf + (head * 8))
    spinlock_unlock(lock)
    return option_some(v)
  end

  def register_waker(self, frame: Int): Void
    # B.5c — chan_send's wake-after-enqueue path walks waiters on the
    # channel pointer.
    kernel_waiter_register(@ch, frame)
  end

  def unregister_waker(self, frame: Int): Void
    kernel_waiter_unregister(@ch, frame)
  end

  def complete(self): Int
    # Race-tolerant: chan_recv loops on empty (parks the caller). Caller
    # is responsible for being in a goroutine context.
    return chan_recv(@ch)
  end
end

def kernel_recvable(ch: Int): KRecvable = KRecvable { ch: ch }

# Sendable mirror — try_poll = "buffer has room"; complete = chan_send.
struct KSendable
  ch: Int
  payload: Int
end

extend KSendable with Selectable<Int>
  def try_poll(self): Option<Int>
    var lock = @ch + CHAN_LOCK
    spinlock_lock(lock)
    var cnt = chan_count(@ch)
    var cap = chan_cap(@ch)
    spinlock_unlock(lock)
    if cnt < cap
      return option_some(0)  # sendable returns 0 marker — body's bind is unused
    end
    return option_none()
  end

  def register_waker(self, frame: Int): Void
    # B.5c — chan_recv's wake-after-dequeue path walks waiters on the
    # channel pointer (freeing buffer space).
    kernel_waiter_register(@ch, frame)
  end

  def unregister_waker(self, frame: Int): Void
    kernel_waiter_unregister(@ch, frame)
  end

  def complete(self): Int
    chan_send(@ch, @payload)
    return 0
  end
end

def kernel_sendable(ch: Int, v: Int): KSendable = KSendable { ch: ch, payload: v }

# D.11 Phase 7 / B.5c — kernel waiter side-table for active-wake.
#
# A flat array of (token, waiter_task) entries, spinlock-protected for
# SMP safety. Pool size NUM_WAITERS = 256 — bounded by the worst case
# of one waiter per task slot under the existing NUM_TASKS=64..32768
# (most select-arms hold ≤1 register at a time; the pool is sized for
# headroom on top of typical concurrent select counts).
#
# Token semantics are caller-defined: KAwait uses task_handle; KRecvable
# uses channel-base; KSendable likewise. Producer side calls
# kernel_waiter_wake_all(token) to wake every registered waiter for
# that token. Three integration points:
#
#   1. sched_post_switch's DEAD branch wakes waiters keyed on the
#      dying task's handle (BEFORE task_free, to avoid the slot-recycle
#      race — a waiter holding a stale slot pointer would race against
#      re-allocation if we waked after free).
#   2. chan_send's enqueue path wakes waiters keyed on the channel
#      handle (recvable selectors).
#   3. chan_recv's dequeue path wakes waiters keyed on the channel
#      handle (sendable selectors waiting for free buffer space).
#
# B.5c is the wake side; selector-side register_waker / unregister_waker
# bodies on KAwait / KRecvable / KSendable get filled in this same
# block. unregister_waker is called eagerly by Selectable's complete()
# wrapper (Plan A); after a wake the entry is cleared by wake_all so
# unregister_waker on an already-cleared entry is a no-op.

const NUM_KERNEL_WAITERS = 256
const KW_TOKEN  = 0   # U64 — opaque (task handle, channel pointer, etc.)
const KW_WAITER = 8   # U64 — waiter task pointer
const KW_ENTRY_BYTES = 16

var g_kw_table = 0     # base ptr of NUM_KERNEL_WAITERS * 16 bytes (pmm_alloc_page'd at init)
var g_kw_lock  = 0     # spinlock_new() addr
var g_kw_register_total   = 0  # monotonic for telemetry
var g_kw_unregister_total = 0
var g_kw_wake_total       = 0  # number of __qz_sched_wake calls triggered

# Initialize from uk_sched_init (next to effect_stack_pool_init).
def kernel_waiter_init(): Void
  # 256 * 16 = 4096 — fits in one pmm page.
  g_kw_table = pmm_alloc_page()
  if g_kw_table == 0
    uart_put_str("[uk_sched] kernel_waiter_init OOM\n")
    @c("cli; 1: hlt; jmp 1b")
  end
  # Zero the table (token=0 ⇒ "free slot").
  var i = 0
  while i < NUM_KERNEL_WAITERS
    var e = g_kw_table + (i * KW_ENTRY_BYTES)
    volatile_store<U64>(e + KW_TOKEN, 0)
    volatile_store<U64>(e + KW_WAITER, 0)
    i = i + 1
  end
  g_kw_lock = spinlock_new()
end

def kernel_waiter_register(token: Int, waiter: Int): Void
  if token == 0
    return
  end
  if waiter == 0
    return
  end
  spinlock_lock(g_kw_lock)
  # Idempotent: skip if (token, waiter) already in the table.
  var i = 0
  while i < NUM_KERNEL_WAITERS
    var e = g_kw_table + (i * KW_ENTRY_BYTES)
    var t = volatile_load<U64>(e + KW_TOKEN)
    if t == token
      var w = volatile_load<U64>(e + KW_WAITER)
      if w == waiter
        spinlock_unlock(g_kw_lock)
        return
      end
    end
    i = i + 1
  end
  # Find first free slot.
  var j = 0
  while j < NUM_KERNEL_WAITERS
    var e2 = g_kw_table + (j * KW_ENTRY_BYTES)
    if volatile_load<U64>(e2 + KW_TOKEN) == 0
      volatile_store<U64>(e2 + KW_TOKEN, token)
      volatile_store<U64>(e2 + KW_WAITER, waiter)
      g_kw_register_total = g_kw_register_total + 1
      spinlock_unlock(g_kw_lock)
      return
    end
    j = j + 1
  end
  # Table full. Silently drop — caller will fall back to polling.
  # In B.5c only the smoke registers; production code would have
  # bumped NUM_KERNEL_WAITERS or grown to multi-page if this fires.
  spinlock_unlock(g_kw_lock)
end

def kernel_waiter_unregister(token: Int, waiter: Int): Void
  if token == 0
    return
  end
  spinlock_lock(g_kw_lock)
  var i = 0
  while i < NUM_KERNEL_WAITERS
    var e = g_kw_table + (i * KW_ENTRY_BYTES)
    var t = volatile_load<U64>(e + KW_TOKEN)
    if t == token
      var w = volatile_load<U64>(e + KW_WAITER)
      if w == waiter
        volatile_store<U64>(e + KW_TOKEN, 0)
        volatile_store<U64>(e + KW_WAITER, 0)
        g_kw_unregister_total = g_kw_unregister_total + 1
        # Continue scanning — same (token, waiter) pair shouldn't
        # appear twice (register dedups) but be defensive.
      end
    end
    i = i + 1
  end
  spinlock_unlock(g_kw_lock)
end

# Wake every waiter registered on `token`. Walks the table under the
# spinlock, calling __qz_sched_wake inline for each match before
# clearing the entry. Safe under the lock because __qz_sched_wake's
# only effects (task_set_state + ready_push) don't touch the waiter
# table — no reentrancy hazard.
#
# Caller invariants:
#   - Token is producer-side stable: for tasks, called BEFORE task_free;
#     for channels, called while the channel handle is still alive.
def kernel_waiter_wake_all(token: Int): Void
  if token == 0
    return
  end
  if g_kw_table == 0
    return  # Not yet initialized.
  end
  spinlock_lock(g_kw_lock)
  var i = 0
  while i < NUM_KERNEL_WAITERS
    var e = g_kw_table + (i * KW_ENTRY_BYTES)
    var t = volatile_load<U64>(e + KW_TOKEN)
    if t == token
      var w = volatile_load<U64>(e + KW_WAITER)
      volatile_store<U64>(e + KW_TOKEN, 0)
      volatile_store<U64>(e + KW_WAITER, 0)
      if w != 0
        __qz_sched_wake(w)
        g_kw_wake_total = g_kw_wake_total + 1
      end
    end
    i = i + 1
  end
  spinlock_unlock(g_kw_lock)
end

# Smoke. Two goroutines:
#   target — does some yield-work, exits (task_exit → sched_post_switch's
#            DEAD branch → kernel_waiter_wake_all(target_handle))
#   waiter — captures target's handle + own start TSC, registers itself,
#            parks via __qz_effect_suspend, records end TSC, exits
# Main spawns both, drives sched_pump. Without the active wake hook the
# waiter would stay blocked forever; with it, the wake fires inside
# sched_post_switch's DEAD branch.
var g_b5c_target_handle = 0
var g_b5c_waiter_handle = 0
var g_b5c_waiter_start_tsc = 0
var g_b5c_waiter_end_tsc   = 0
var g_b5c_waiter_woke = 0
var g_b5c_target_done = 0

def b5c_target_body(): Void
  var i = 0
  while i < 3
    i = i + 1
    yield_now()
  end
  g_b5c_target_done = 1
  task_exit()
end

# D.11 Phase 7 / B.5d.1 — STDLIB channel_new/send/recv end-to-end in
# kernel context. Producer + consumer goroutines use the stdlib
# intrinsics directly; the B.5d compiler fork redirects them to
# @chan_new/@chan_send/@chan_recv at IR emission, and B.5d.1's PASS
# 1.2b+1.3 freestanding gate suppresses the __Future_X$poll wrappers
# that previously pulled in 243 undefined hosted-runtime symbols.
#
# Pre-B.5d.1 attempt link error: `use of undefined value '@__qz_current_frame'`
# (and dozens more after).
# Expected: `[B.5d1] stdlib chan recvd=3 sum=63 ok`.
var g_b5d1_ch     = 0
var g_b5d1_count  = 0
var g_b5d1_sum    = 0

def b5d1_producer_body(): Void
  send(g_b5d1_ch, 21)
  send(g_b5d1_ch, 21)
  send(g_b5d1_ch, 21)
  task_exit()
end

def b5d1_consumer_body(): Void
  var i = 0
  while i < 3
    var v = recv(g_b5d1_ch)
    g_b5d1_sum = g_b5d1_sum + v
    g_b5d1_count = g_b5d1_count + 1
    i = i + 1
  end
  task_exit()
end

# D.11 Phase 7 / B.5e.3 — arg-passing async freestanding spawn.
# Exercises the `async fn(args)` SURFACE (not go_fn directly), which on
# the kernel target lowers to a captured-args closure spawned via
# kern_go_closure (mir_lower.qz::_mir_fs_spawn_closure_with_args). The
# spawned bodies READ their captured args and write arg-derived values
# into a channel; main recvs + verifies the values arrived intact. This
# is the same lowering std/actor.qz's `async _supervisor_watcher(sup)`
# (1-arg) needs. Expected:
#   `[B.5e3] argpass one=107 two=40 recvd=2 ok`
var g_b5e3_ch = 0

# 1-arg worker: sends v + 100 into the channel, then exits. Proves a
# single captured arg arrives.
def b5e3_one_worker(v: Int): Void
  send(g_b5e3_ch, v + 100)
  task_exit()
end

# 2-arg worker: sends base * mult into the channel. Proves both captured
# args arrive in the right slots (order-sensitive: base*mult != mult*base
# would be caught by a different value, but we also assert the exact
# product).
def b5e3_two_worker(base: Int, mult: Int): Void
  send(g_b5e3_ch, base * mult)
  task_exit()
end

# B.5e.7a — REAL language-level actor running freestanding in the kernel.
# `actor Counter` lowers (freestanding) to a PLAIN `Counter$__poll(state)`
# goroutine fn (mir_lower_actor_poll_freestanding), spawned via kern_go_closure
# (mir_lower_actor_spawn), parking on `recv` through the B.4 suspend/wake bridge
# — NO hosted Future `$poll` state machine, no pthreads/waiters. This is the
# B.5 success criterion "Actor receives N messages" on the actual language
# surface. Expected: `[B.5e7] real actor count=3 ok`.
actor Counter
  var count: Int = 0
  def increment(): Void
    count += 1
  end
  def get_count(): Int
    return count
  end
end

var g_b5e7_done_ch = 0

# Driver goroutine — must run as a goroutine, not bare main: get_count() blocks
# on the actor's reply channel (chan_recv parks the goroutine) and stop()
# busy-polls try_recv_or_closed + sched_yield; both deadlock-halt from main.
def b5e7_driver(): Void
  var c = Counter()
  c.increment()
  c.increment()
  c.increment()
  var n = c.get_count()
  c.stop()
  send(g_b5e7_done_ch, n)
  task_exit()
end

# B.5e.8 — freestanding actor panic-RECOVERY. A handler that `panic`s must NOT
# halt the kernel. The freestanding actor poll (mir_emit_actor_poll_body) now
# installs a per-goroutine Throws boundary; B.5e.8a made `panic` perform a
# Throws.throw (kind=2) into it; the longjmp lands back at the poll's recv
# prologue, which drops the orphaned message and continues — recover-in-place,
# exactly mirroring the hosted scheduler's `pc_actor_restart`. The actor drops
# the poison message and keeps serving subsequent messages.
# Expected: `[B.5e8] actor survived panic count=3 ok`.
actor Recoverable
  var count: Int = 0
  def bump(): Void
    count += 1
  end
  def poison(): Void
    panic("poison pill")
  end
  def get_count(): Int
    return count
  end
end

var g_b5e8_done_ch = 0

# Driver goroutine (same rationale as b5e7_driver — get_count() parks on the
# reply channel, stop() busy-polls; both deadlock-halt from bare main).
# Sends in FIFO order: bump(1) → poison(panic, dropped) → bump(2) → bump(3).
# If the boundary works, get_count() returns 3 (the actor survived the panic).
def b5e8_driver(): Void
  var a = Recoverable()
  a.bump()           # count = 1
  a.poison()         # handler panics → boundary catches → msg dropped, actor LIVES
  a.bump()           # count = 2 (proves survival)
  a.bump()           # count = 3
  var n = a.get_count()
  a.stop()
  send(g_b5e8_done_ch, n)
  task_exit()
end

# B.5e.8c — REAL std/actor.qz Supervisor restart-on-crash, end-to-end in the
# kernel. This is the half of the B.5 success criterion that B.5e.8a/b only
# enabled (recover-in-place handles a panicking handler; the *supervisor*
# restart path is driven by inbox-close, a separate mechanism). Here we drive
# the actual stdlib `Supervisor`: its watcher goroutine (spawned via
# `async _supervisor_watcher(sup)` + sched_spawn) registers a close-event waker
# on each child inbox and, on detecting a crash (inbox closed WITHOUT a clean
# mark → `actor_check_clean` returns EXIT_CRASH), respawns the child via its
# spawn closure under RESTART_PERMANENT.
#
# The child crashes via `actor_die(0)` (C.14.7 self-escalation): closes its own
# inbox without marking clean → the watcher sees EXIT_CRASH → respawns. We crash
# it 3× and assert the supervisor counted 3 restarts.
#
# Uniquely-named methods (b5c_*) because supervisor_child returns the raw Int
# inbox handle and actor-method dispatch on a bare handle resolves by method
# name — a generic name like `tick` could collide with another actor in this
# kernel.
actor B5cChild
  var n: Int = 0
  def b5c_die(): Void
    actor_die(0)
  end
  def b5c_tick(): Void
    n += 1
  end
  def b5c_get(): Int = n
end

def spawn_b5c_child(): Int = B5cChild()

var g_b5e8c_done_ch = 0

# Driver goroutine. supervisor_child busy-polls via sched_yield during the
# restart gap, and supervisor_stop blocks on `await watcher` — both deadlock-halt
# from bare main, so this runs as its own goroutine (same rationale as the b5e7 /
# b5e8 drivers). Sends the restart count on the done channel BEFORE the
# (await-blocking) supervisor_stop so the smoke result is reported even if
# shutdown were to stall.
def b5e8c_driver(): Void
  var spawns = vec_new()
  spawns.push(spawn_b5c_child)
  var sup = supervisor_new(spawns, 5, 10000)
  var i = 0
  while i < 3
    var c = supervisor_child(sup, 0)
    c.b5c_die()        # actor_die → inbox closes (unclean) → watcher respawns
    # Wait for the watcher to observe the close (active-wake) and respawn.
    var attempts = 0
    while supervisor_restart_count(sup) < i + 1 and attempts < 5000000
      sched_yield()
      attempts = attempts + 1
    end
    i = i + 1
  end
  var rc = supervisor_restart_count(sup)
  send(g_b5e8c_done_ch, rc)
  supervisor_stop(sup)
  task_exit()
end

# B.5e — actor identity workers. Each sets its OWN inbox via the kernel helper
# (the surface-callable `__actor_set_self_inbox` is MIR-internal), then reads it
# back through the `actor_self_inbox()` intrinsic — which lowers to the
# freestanding fork @actor_self_inbox_kernel → TASK_ACTOR_INBOX. Two workers
# with distinct handles prove the slot is the RUNNING task's, not shared.
var g_b5e_w1_inbox = 0
var g_b5e_w2_inbox = 0
var g_b5e_self_ok  = 0

def b5e_worker1_body(): Void
  actor_set_self_inbox_kernel(0xB5E1)
  g_b5e_w1_inbox = actor_self_inbox()
  if g_b5e_w1_inbox == 0xB5E1
    g_b5e_self_ok = 1
  end
  task_exit()
end

def b5e_worker2_body(): Void
  actor_set_self_inbox_kernel(0xB5E2)
  g_b5e_w2_inbox = actor_self_inbox()
  task_exit()
end

def b5c_waiter_body(): Void
  g_b5c_waiter_handle = sched_current()
  g_b5c_waiter_start_tsc = read_tsc()
  # Wait for target's handle to be published. The waiter spawns AFTER
  # the target in main, but the scheduler may run waiter first. Yield
  # until handle is non-zero.
  while g_b5c_target_handle == 0
    yield_now()
  end
  # Register active-wake on the target's task handle.
  kernel_waiter_register(g_b5c_target_handle, g_b5c_waiter_handle)
  # Park via the B.4 suspend bridge. Set park_rv != 1 to enter park path.
  __qz_effect_park_rv_store(-2)
  var rv = __qz_effect_suspend()
  # Resumed by kernel_waiter_wake_all when target died.
  g_b5c_waiter_end_tsc = read_tsc()
  g_b5c_waiter_woke = 1
  task_exit()
end

# B.5b smoke. Producer goroutine sends 3 values into a buffered channel
# (cap=4 so the producer never blocks). Consumer goroutine uses
# kernel_recvable + Selectable<Int>::try_poll + ::complete to drain.
# Records each received value into globals.
#
# UART: `[B.5b] kchannel recvd=3 sum=42 ok` (10+15+17).
var g_b5b_ch     = 0
var g_b5b_count  = 0
var g_b5b_sum    = 0
var g_b5b_v0     = 0
var g_b5b_v1     = 0
var g_b5b_v2     = 0

def b5b_producer_body(): Void
  chan_send(g_b5b_ch, 10)
  chan_send(g_b5b_ch, 15)
  chan_send(g_b5b_ch, 17)
  task_exit()
end

def b5b_consumer_body(): Void
  var recv_sel = kernel_recvable(g_b5b_ch)
  var i = 0
  while i < 3
    var poll_opt = recv_sel.try_poll()
    if poll_opt.is_some()
      var v = recv_sel.complete()
      g_b5b_sum = g_b5b_sum + v
      g_b5b_count = g_b5b_count + 1
      if i == 0
        g_b5b_v0 = v
      end
      if i == 1
        g_b5b_v1 = v
      end
      if i == 2
        g_b5b_v2 = v
      end
      i = i + 1
    else
      yield_now()
    end
  end
  task_exit()
end

# K8.6 — push to a specific CPU's ring. Used directly by:
#   - ready_push() (caller's own CPU; the common path for go_fn,
#     yield-publish in K8.6.3, and chan/mutex wake-publish in
#     K8.6.4-5).
#   - cross-CPU wake paths that route to a remote ring deliberately.
# Owner pushes go through the same spinlock that stealers use; the
# lock is uncontested in the steady state because stealers only fire
# when their own ring is empty.
#
# NUM_TASKS bounds total ring occupancy across the system, so per-CPU
# overflow is impossible as long as we only push tasks alloc'd from
# the global pool.
def ready_push_to(cpu: Int, t: Int): Void
  var page = pcpu_page_for(cpu)
  var lock = volatile_load<U64>(page + PCPU_READY_SPINLOCK)
  spinlock_lock(lock)
  var ring = volatile_load<U64>(page + PCPU_READY_RING_BASE)
  var tail = volatile_load<U64>(page + PCPU_READY_TAIL)
  var count = volatile_load<U64>(page + PCPU_READY_COUNT)
  volatile_store<U64>(ring + (tail * 8), t)
  tail = tail + 1
  if tail >= NUM_TASKS
    tail = 0
  end
  volatile_store<U64>(page + PCPU_READY_TAIL, tail)
  volatile_store<U64>(page + PCPU_READY_COUNT, count + 1)
  var was_empty = (count == 0)
  spinlock_unlock(lock)
  # K8.6.2 — only broadcast IPI on a CROSS-CPU push that transitions
  # an empty ring to non-empty. A self-push (owner publishing back to
  # its own ring during a yield/wake cycle) doesn't need to wake
  # anyone: the owner is the next consumer of its own ring, and
  # broadcasting on every yield-cycle 0→1 saturates the system with
  # IPIs at hundreds of thousands per second on a long-running task
  # like the heartbeat goroutine. Cross-CPU pushes (e.g., wake-target
  # waiter pinned to a different CPU, or work-rebalance) DO need the
  # IPI to drop wake latency from ~100ms (LAPIC timer failsafe) to
  # nanoseconds. A pure self-push that the owner will pop in the
  # very next sched_pump iter doesn't.
  if was_empty
    if cpu != cpu_local_load(PCPU_CPU_ID)
      apic_broadcast_ipi(APIC_WAKE_IPI_VECTOR)
    end
  end
end

# Pop from a specific CPU's ring. Returns 0 if empty. Owner uses this
# on its own ring; K8.6.2's work-stealing uses it on victim rings.
def ready_pop_from(cpu: Int): Int
  var page = pcpu_page_for(cpu)
  var lock = volatile_load<U64>(page + PCPU_READY_SPINLOCK)
  spinlock_lock(lock)
  var count = volatile_load<U64>(page + PCPU_READY_COUNT)
  if count == 0
    spinlock_unlock(lock)
    return 0
  end
  var ring = volatile_load<U64>(page + PCPU_READY_RING_BASE)
  var head = volatile_load<U64>(page + PCPU_READY_HEAD)
  var t = volatile_load<U64>(ring + (head * 8))
  head = head + 1
  if head >= NUM_TASKS
    head = 0
  end
  volatile_store<U64>(page + PCPU_READY_HEAD, head)
  volatile_store<U64>(page + PCPU_READY_COUNT, count - 1)
  spinlock_unlock(lock)
  return t
end

# Pick the least-loaded CPU's ring as the publish target. Used by
# ready_push for load-balanced publication on yield/exit/wake. Tie
# goes to the calling CPU (sender locality wins ties).
def least_loaded_cpu(): Int
  var self_cpu = cpu_local_load(PCPU_CPU_ID)
  var target = self_cpu
  var min_count = volatile_load<U64>(pcpu_page_for(self_cpu) + PCPU_READY_COUNT)
  var i = 0
  while i < g_cpu_count
    # Path C.5.5 — only distribute to ONLINE CPUs (ones running sched_pump).
    # A brought-up-but-parked AP (pre-C.5.5.3) is offline, so work stays on
    # the pumping CPUs and never strands in a ring no one drains. The caller
    # is always an online CPU (it's pumping), so `self_cpu` is a valid default.
    if (i != self_cpu) and (cpu_sched_online(i) == 1)
      var c = volatile_load<U64>(pcpu_page_for(i) + PCPU_READY_COUNT)
      # Hysteresis (>= 2 fewer) avoids oscillation under near-equal
      # loads — without it, two CPUs trading every-other task would
      # ping-pong forever, wasting IPI bandwidth.
      if c + 1 < min_count
        min_count = c
        target = i
      end
    end
    i = i + 1
  end
  return target
end

# Push to the LEAST-LOADED CPU's ring (default load-aware policy at
# K8.6.7). When the system is balanced or near-balanced, this stays
# on the calling CPU (sender locality wins ties); under skew (e.g.,
# 30k tasks all spawned from BSP, AP idle), each yield migrates one
# task toward the under-loaded sibling, naturally rebalancing.
# Combined with cross-CPU IPI broadcast (K8.6.2 — was_empty + cpu !=
# self), the under-loaded sibling wakes within nanoseconds and chews
# through migrated work alongside the spawner.
## Push `t` onto the appropriate ready ring. Routing (Path C.5.5):
##   - TASK_PRIORITY == 1 ⇒ global hi ring. Only BSP consumes the hi ring
##     (ready_pop), so hi tasks always run on BSP — their copy-stack frames
##     bind to BSP's active-stack VA. (HTTP-tier work pinned to BSP, per
##     KERN.8 D7.) Persists across blocking — a chan_recv-parked hi task still
##     lands on the hi ring when woken.
##   - normal + PINNED (TASK_HOME_CPU != 255) ⇒ its home CPU's ring. A task
##     that has parked carries absolute addresses into its home CPU's
##     active-stack VA, so it MUST resume there (same-address-restore is
##     per-CPU). The waker may be a different CPU; ready_push_to handles the
##     cross-CPU enqueue + wake IPI.
##   - normal + UNPINNED (never parked) ⇒ least-loaded online CPU's ring. It
##     pins to whichever CPU first runs+parks it.
def ready_push(t: Int): Void
  if task_priority(t) == 1
    hi_ring_push(t)
    return
  end
  var home = task_home_cpu(t)
  if home != TASK_HOME_UNPINNED
    ready_push_to(home, t)
    return
  end
  ready_push_to(least_loaded_cpu(), t)
end

# Pop the next task to run on the calling CPU.
#
# Path C.5.5 — copying-stack scheduling REMOVES work-stealing. A parked task's
# frames carry absolute addresses into its home CPU's active-stack VA, so it
# can only ever be resumed on that CPU; stealing it to a sibling would copy-in
# to the wrong VA and corrupt the frame. Each CPU therefore drains ONLY its own
# normal ring. Load is balanced at PUSH time: least_loaded_cpu() spreads
# unpinned (never-parked) tasks across online CPUs, and a task pins to whichever
# CPU first parks it. (The pre-C.5.5 K8.6 stealer migrated parked tasks freely —
# safe under the old single-running-stack model, unsafe under per-CPU copying
# stacks. The migration-capable alternative is per-CPU page tables mapping every
# CPU's active stack to one shared VA; deferred — see PATH_C §10.5.)
#
# The global hi ring is consumed ONLY by BSP (CPU 0). Hi-priority tasks are the
# HTTP tier (supervised listener + per-conn handlers); confining them to BSP
# binds their frames to BSP's active-stack VA and matches KERN.8 D7 (HTTP
# pinned to BSP). APs never touch the hi ring or the fairness counter — they run
# their own normal ring exclusively.
def ready_pop(): Int
  var self_cpu = cpu_local_load(PCPU_CPU_ID)
  if self_cpu != 0
    # AP: own normal ring only. No hi ring, no stealing.
    return ready_pop_from(self_cpu)
  end
  # BSP: priority scheduler with fairness. The hi ring drains preferentially,
  # but every SCHED_FAIRNESS_QUANTUM hi pops the NEXT pop forces a normal-ring
  # drain if non-empty. Keeps the supervised listener + per-conn handlers fast
  # under heavy spawn load AND lets demo bodies make progress (the self-yielding
  # listener would otherwise flood the hi ring and starve normal work).
  var force_normal = 0
  if g_sched_hi_streak >= SCHED_FAIRNESS_QUANTUM
    force_normal = 1
  end
  if force_normal == 0
    var hi = hi_ring_pop()
    if hi != 0
      g_sched_hi_streak = g_sched_hi_streak + 1
      return hi
    end
  end
  g_sched_hi_streak = 0
  var t = ready_pop_from(self_cpu)
  if t != 0
    return t
  end
  # Forced-normal slot but normal empty: fall through to hi.
  if force_normal == 1
    var hi2 = hi_ring_pop()
    if hi2 != 0
      return hi2
    end
  end
  return 0
end

# Sum READY occupancy across all per-CPU rings. Best-effort snapshot
# (no global lock — readers may see slightly stale counts during
# concurrent push/pop). Used by stats endpoints + sched_demo's
# completion log line where exact correctness doesn't matter.
def sched_total_ready(): Int
  var sum = 0
  var i = 0
  while i < g_cpu_count
    sum = sum + volatile_load<U64>(pcpu_page_for(i) + PCPU_READY_COUNT)
    i = i + 1
  end
  return sum
end

# Spawn a new goroutine running `entry_fn`. Returns the task ptr, or
# 0 if the pool is full. entry_fn MUST call task_exit() as its last
# statement; otherwise it falls off the seeded stack and jumps to
# uninitialized memory. Later phases will wrap user closures in a
# compiler-generated trampoline that auto-calls task_exit, but for
# phase 1 the convention is explicit.
#
# Path C.5.2 — spawn no longer seeds a stack. The task is parked READY with
# only its entry_fn recorded; the scheduler seeds the single active stack on
# first schedule-in (ensure_active_stack). This is what lets spawn?n=4M
# enqueue 4M READY tasks while only one active stack exists.
def go_fn(entry_fn: Int): Int
  var t = task_alloc()
  if t == 0
    return 0
  end
  task_set_entry_fn(t, entry_fn)
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
  return t
end

## Thin-pool counterpart of `go_fn`. Pulls a slot from the thin task
## freelist (bumping g_task_alive_thin, which the /api/soul/spawn headroom
## math watches). Path C — the stack is identical to go_fn's (uniform 16
## KiB leased at schedule-in); the only remaining difference from go_fn is
## which freelist + counter. Used by /api/soul/spawn for the bulk demo body.
## The fat/thin task-pool split collapses in Path C.4.
def go_fn_thin(entry_fn: Int): Int
  var t = task_alloc_thin()
  if t == 0
    return 0
  end
  task_set_entry_fn(t, entry_fn)
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
  return t
end

## High-priority counterpart of `go_fn`. Same semantics, but stamps
## TASK_PRIORITY=1 before the ready-ring publish so the task lands on
## the global hi ring and stays there across blocks/wakes for the
## rest of its lifetime. Use for HTTP-tier work (supervised listener,
## per-slot TCP pump). task_free clears TASK_PRIORITY back to 0 on
## reclaim so a slot reused for a normal body doesn't inherit
## priority. See [[feedback-supervised-vs-demo-task-starvation]].
def go_fn_hi(entry_fn: Int): Int
  var t = task_alloc()
  if t == 0
    return 0
  end
  task_set_entry_fn(t, entry_fn)
  task_set_priority(t, 1)
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
  return t
end

# D.11 followup — kernel-side closure-aware goroutine spawn. Spawns a
# new task whose entry point invokes a Quartz closure value (tagged-
# pointer ABI documented in self-hosted/backend/codegen_runtime.qz:4208
# `@__qz_poll_closure`, dispatched via the C helper `__qz_invoke_closure`
# in libc_stubs.c). The closure value lives in TASK_USER_ARG; the
# trampoline reads it on first run and calls it via the C dispatch.
#
# Why: the stdlib supervised HTTP path (std/net/http_server.qz) calls
# http_dyn_gsup_spawn_one(sup, -> _http_supervised_per_conn_loop(...))
# where the body is a Quartz closure capturing fd/handler/config. The
# pre-existing freestanding shim ran the closure INLINE in the supervised
# goroutine, blocking the listener loop for the entire keep-alive
# lifetime. Replacing the inline call with kern_go_closure restores
# concurrent per-connection serving in freestanding. See
# [[feedback-soul7-prod-supervised-hang]] for the prod hang this closes.
#
# Returns the new task handle (passed to stdlib spawn_one's children
# Vec for liveness tracking), or 0 if the task pool is exhausted.
extern "C" def __qz_invoke_closure(clo: Int): Int

def _kern_closure_trampoline(): Void
  var my_task = sched_current()
  var clo = volatile_load<U64>(my_task + TASK_USER_ARG)
  var _ignore = __qz_invoke_closure(clo)
  task_exit()
end

def kern_go_closure(closure: Int): Int
  var t = task_alloc()
  if t == 0
    return 0
  end
  # Stash the closure value in TASK_USER_ARG BEFORE setting up entry
  # so the trampoline observes it on first run. K8.6.x scheduler
  # cooperation: the slot's READY transition + ready_push happen last.
  volatile_store<U64>(t + TASK_USER_ARG, closure)
  task_set_entry_fn(t, _kern_closure_trampoline)
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
  return t
end

## High-priority counterpart of `kern_go_closure`. Stamps
## TASK_PRIORITY=1 so per-conn HTTP handlers (spawned by stdlib's
## `http_dyn_gsup_spawn_one` freestanding) land on the hi ring. They
## stay there across chan_recv parks (in kern_tcp_read for the HTTP
## request body, in kern_tcp_write's tx_done wait) — the wake-side
## `ready_push` consults `task_priority` so the per-conn handler is
## ahead of any normal-ring demo task waiting to run.
def kern_go_closure_hi(closure: Int): Int
  var t = task_alloc()
  if t == 0
    return 0
  end
  volatile_store<U64>(t + TASK_USER_ARG, closure)
  task_set_entry_fn(t, _kern_closure_trampoline)
  task_set_priority(t, 1)
  task_set_state(t, TASK_STATE_READY)
  ready_push(t)
  return t
end

# Cooperative yield from the running task. Sets state to READY but
# DOES NOT publish to the ready ring — that's deferred to
# sched_post_switch which runs in main's frame on this CPU AFTER
# switch_to commits TASK_SAVED_RSP. See K8.6.3 / docs/bugs/
# UNIKERNEL_SMP_YIELD_RSP_RACE.md for the race the deferral closes.
# Safe to call from main (no-op).
def yield_now(): Void
  var cur = sched_current()
  if cur == 0
    return
  end
  task_set_state(cur, TASK_STATE_READY)
  set_sched_current(0)
  # D.11 Phase 7 / B.1.b — preserve this task's effect-stack state into
  # its per-task slots BEFORE switch_to. sched_pump's matching
  # restore_from_task on resume reloads it into the process-global
  # @__qz_effect_stack_* symbols. Through B.6, main context installs
  # nothing so the globals' state between switch_to and sched_post_switch
  # carries no meaningful information; the save/restore round-trip is
  # idempotent for tasks that never installed (zeros → zeros).
  # Path C.5.5.6 — BSP-only: only BSP touches the process-global effect stack.
  if eff_on_bsp()
    __qz_effect_save_to_task(cur)
  end
  # switch_to(from=*, to=*): save current rsp into cur's TASK_SAVED_RSP
  # slot, load rsp from this CPU's main-rsp slot. Control returns to
  # main's sched_pump (via main's saved RSP) — main then calls
  # sched_post_switch(cur), which observes state==READY and publishes
  # to the local ring with SAVED_RSP already committed.
  switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
end

# Terminate the running task. Sets state to DEAD but DOES NOT free
# the slot — sched_post_switch sees state==DEAD and calls task_free
# AFTER switch_to has committed (and crucially, after the dying
# stack is no longer in use). Calling from main halts the kernel
# (programmer error).
def task_exit(): Void
  var cur = sched_current()
  if cur == 0
    uart_put_str("sched: task_exit called from main — halting\n")
    @c("cli; 1: hlt; jmp 1b")
  end
  task_set_state(cur, TASK_STATE_DEAD)
  set_sched_current(0)
  switch_to(cur + TASK_SAVED_RSP, pcpu_main_rsp_slot())
  @c("cli; 1: hlt; jmp 1b")
end

# Path C.5.2 — copy the parked task's live frames OUT of the single active
# stack into its per-task saved buffer, freeing the active stack for the next
# task. Runs from sched_post_switch (main's frame) for the READY (yield) and
# BLOCKED edges; the DEAD edge needs no copy (the frames are dead — task_free
# frees the buffer instead). The buffer is grow-only: reuse it if its current
# size-class still fits `len`, else free the old chunk and allocate a larger
# class. `saved_rsp` is the RSP switch_to saved when the task yielded — it
# points into the active stack; `len` is everything from there up to
# active_top. Must complete BEFORE the task is published to a ready ring /
# waitq, since the next schedule-in of this task copies the buffer back IN.
def sched_park_active_stack(t: Int): Void
  # Path C.5.5 — pin: this task's frames are about to be copied off THIS CPU's
  # active stack, carrying absolute addresses into this CPU's active-stack VA.
  # It must always resume here, so stamp its home CPU. Runs on the CPU that ran
  # the task (sched_post_switch), so cpu_local_load gives the right id. Set
  # every park (idempotent — a pinned task only ever runs on its home CPU).
  task_set_home_cpu(t, cpu_local_load(PCPU_CPU_ID))
  var rsp = task_saved_rsp(t)
  var len = active_stack_top() - rsp
  # Path C.5.5.6 — copy-out overflow guard (independent of the contiguity
  # bug; a SECOND path to wild-RSP). `len` is the depth of live frames on
  # the active stack; ss_alloc caps a class-3 buffer at TASK_STACK_BYTES
  # (16 KiB == the full active stack). A frame deeper than that can only
  # arise from active-stack overflow — and the memcpy below would then write
  # PAST the ss buffer into an ADJACENT parked task's saved frame, corrupting
  # it (→ wild-RSP when THAT task resumes). The active-stack canary catches
  # overflow only while a task is RUNNING, not at copy-out. §11.3's deepest
  # observed frame is copy_max_len=1368 ≪ 16384, so this is latent today, but
  # a copying-stack park cannot back out, so loud-halt is the only safe
  # response. (cap < len already triggers re-alloc below; this guards the
  # case where even the max class-3 buffer cannot hold the frame.)
  if len > TASK_STACK_BYTES
    uart_put_str("[SS-OVERFLOW] park frame exceeds active stack: task=")
    uart_put_uint(t)
    uart_put_str(" len=")
    uart_put_uint(len)
    uart_put_str(" max=")
    uart_put_uint(TASK_STACK_BYTES)
    uart_put_str(" — halting (active-stack overflow on copy-out)\n")
    @c("cli; 1: hlt; jmp 1b")
  end
  # Telemetry — park rate (copy_total ÷ wall-time) + deepest frame, surfaced
  # on /api/soul/stats.json for the C.5.3 throughput-curve work.
  g_ss_copy_total = g_ss_copy_total + 1
  if len > g_ss_copy_max_len
    g_ss_copy_max_len = len
  end
  var buf = task_saved_stack_ptr(t)
  var cap = task_saved_stack_cap(t)
  if (buf == 0) or (cap < len)
    if buf != 0
      ss_free(buf, cap)
    end
    buf = ss_alloc(len)
    if buf == 0
      # Path C.5.5.6 — ss pool exhausted. The parked task's live frames have
      # nowhere to go; the old code fell through to memcpy(0, rsp, len),
      # silently corrupting low memory → the #UD/#PF wild-RSP failure mode
      # observed at >1M concurrent in a 14 GiB guest. A copying-stack park
      # cannot back out (the active stack is needed by the next task), so
      # halt loudly with a diagnostic rather than corrupt. Pre-existing hole,
      # NOT SMP-specific (same path runs single-CPU under C.6). Proper fix =
      # spawn-time back-pressure on ss headroom; filed PATH_C §12.8.
      uart_put_str("[SS-OOM] ss_alloc failed in park: task=")
      uart_put_uint(t)
      uart_put_str(" len=")
      uart_put_uint(len)
      uart_put_str(" — halting (ss pool exhausted; raise -m or add back-pressure)\n")
      @c("cli; 1: hlt; jmp 1b")
    end
    cap = ss_class_size(ss_class_for(len))
    task_set_saved_stack_ptr(t, buf)
    task_set_saved_stack_cap(t, cap)
  end
  memcpy(buf, rsp, len)
  task_set_saved_stack_len(t, len)
end

# K8.6.3 — runs in main's sched_pump frame on this CPU AFTER
# switch_to has committed `t`'s SAVED_RSP. Inspects t's state and
# completes the deferred publication.
#
# Cases:
#   READY   — yield_now path; copy frames out, publish to local ready ring.
#   DEAD    — task_exit path; return slot to freelist (task_free frees buf).
#   BLOCKED — chan/mutex block path; copy frames out, then K8.6.4 / K8.6.5
#             populate PENDING_WAITQ + PENDING_LOCK (the gopark(unlockf, lock)
#             shape); we wait_push then unlock. K8.6.3 ships these
#             slots zero, so older synchronous chan/mutex paths still
#             work — they wait_push themselves before switch_to and
#             this branch is a no-op for them. Once K8.6.4/5 land
#             those paths flip to defer.
#   RUNNING — programmer error (state should have been changed before
#             switch_to). Halt.
#   FREE    — likewise programmer error.
def sched_post_switch(t: Int): Void
  var s = task_state(t)
  # Path C.5.2 — both park edges (yield→READY, block→BLOCKED) retain live
  # frames on the active stack; copy them into the task's saved buffer before
  # the active stack is reused by the next task. DEAD needs no copy.
  if (s == TASK_STATE_READY) or (s == TASK_STATE_BLOCKED)
    sched_park_active_stack(t)
  end
  if s == TASK_STATE_READY
    # Yield/preempt path. `ready_push` honors TASK_PRIORITY: hi-priority
    # tasks (supervised listener, per-conn handlers, kernel TCP pumps)
    # land back on the global hi ring; normal tasks (demo bodies) go to
    # the per-CPU normal ring. Fairness is handled at the `ready_pop`
    # side via a fairness counter so a yielding hi task doesn't
    # busy-loop the hi ring and starve normal work.
    ready_push(t)
  elsif s == TASK_STATE_DEAD
    # B.5c — wake every Selectable waiter registered on this task's
    # handle BEFORE task_free recycles the slot. The waiter receives
    # __qz_sched_wake; on resume it polls KAwait::try_poll which sees
    # state DEAD (or FREE if the wake ran past sched_post_switch) and
    # returns Some, completing the select-arm.
    kernel_waiter_wake_all(t)
    task_free(t)
  elsif s == TASK_STATE_BLOCKED
    var waitq = volatile_load<U64>(t + TASK_PENDING_WAITQ)
    if waitq != 0
      var lock = volatile_load<U64>(t + TASK_PENDING_LOCK)
      volatile_store<U64>(t + TASK_PENDING_WAITQ, 0)
      volatile_store<U64>(t + TASK_PENDING_LOCK, 0)
      wait_push(waitq, t)
      if lock != 0
        spinlock_unlock(lock)
      end
    end
    # waitq==0 means the path published itself synchronously
    # pre-K8.6.4/5. Nothing to do.
  else
    # RUNNING / FREE / unknown — programmer error.
    uart_put_str("[sched] sched_post_switch: bad task state=")
    uart_put_uint(s)
    uart_putc(10)
    @c("cli; 1: hlt; jmp 1b")
  end
end

# Path C.5.2 — make the about-to-run task's frames live on the single shared
# active stack. Called from the pump path AFTER ready_pop but BEFORE the task
# is marked RUNNING. There is no pool to exhaust (one active stack), so this
# always succeeds — every ready task can always run (this is what kills the
# C.1 back-pressure / HTTP-starvation failure modes by construction).
#
#   First run  (TASK_SAVED_STACK_PTR == 0): the task has never parked ⟺ never
#     run. Seed the initial frame at the active stack's top via
#     task_init_stack(active_stack_base(), entry_fn) and commit SAVED_RSP. No
#     frames to restore.
#   Resume     (TASK_SAVED_STACK_PTR != 0): the task yielded/blocked mid-body
#     and its frames were copied OUT to its saved buffer. Copy them back IN to
#     active_top - len (the SAME virtual address they occupied originally —
#     the active stack base is constant, so every absolute self-reference in
#     the restored frames stays valid). Recommit SAVED_RSP to that address.
#     The buffer is KEPT (reused/grown on the next park, freed on exit).
def ensure_active_stack(next: Int): Void
  var saved = task_saved_stack_ptr(next)
  if saved != 0
    var len = task_saved_stack_len(next)
    var dest = active_stack_top() - len
    memcpy(dest, saved, len)
    task_set_saved_rsp(next, dest)
    return
  end
  var seeded_rsp = task_init_stack(active_stack_base(), task_entry_fn(next))
  task_set_saved_rsp(next, seeded_rsp)
end

# Drain the ready queue from main. Returns when no tasks are ready
# locally AND nothing can be stolen (K8.6.2). Every iteration: pop
# next ready, mark RUNNING, switch to it; when the task yields/exits,
# control resumes here and we loop. The caller (serve loop) decides
# how often to call this.
def sched_pump(): Void
  while 1 == 1
    var next = ready_pop()
    if next == 0
      return
    end
    # Path C.5.2 — seed (first run) or copy-in (resume) the task's frames
    # onto the single shared active stack before committing to run. Always
    # succeeds — no pool to exhaust.
    ensure_active_stack(next)
    task_set_state(next, TASK_STATE_RUNNING)
    set_sched_current(next)
    sched_tick(next)
    # D.11 Phase 7 / B.1.b — load `next`'s effect-stack state from its
    # per-task slots into the process-global @__qz_effect_stack_*
    # symbols. Paired with __qz_effect_save_to_task at the matching
    # yield_now / task_exit. First time `next` runs, all 11 slots are
    # zero (task_alloc cleared them) so the globals reset to "no strip,
    # no handlers"; the strip allocates lazily inside the first install.
    # Path C.5.5.6 — BSP owns the process-global effect stack. On an AP the
    # task carries no effect state (guard asserts it); skip the restore so the
    # globals BSP is mid-use are never written from another CPU.
    if eff_on_bsp()
      __qz_effect_restore_from_task(next)
    else
      eff_guard_no_ap_strip(next)
    end
    switch_to(pcpu_main_rsp_slot(), next + TASK_SAVED_RSP)
    # Resumes here when `next` yields / blocks / exits. SAVED_RSP for
    # `next` is now committed; sched_post_switch handles the deferred
    # publish (ready_push for READY, task_free for DEAD, K8.6.4/5
    # wait_push for BLOCKED).
    sched_post_switch(next)
  end
end

# Single-quantum variant of sched_pump, for drivers that must not
# block indefinitely. Runs at most ONE ready task until it yields,
# blocks, or exits; returns immediately if the ready queue is empty.
# The TCP serve loop calls this once per iteration so long-running
# goroutines (e.g. the uk_heartbeat background task) can't starve
# RX by re-enqueueing themselves forever — each serve-loop turn gets
# one RX poll + one goroutine quantum + one retransmit pass.
def sched_pump_step(): Void
  var next = ready_pop()
  if next == 0
    return
  end
  # Path C.5.2 — seed (first run) or copy-in (resume) onto the single active
  # stack before running. Always succeeds — no pool to exhaust.
  ensure_active_stack(next)
  task_set_state(next, TASK_STATE_RUNNING)
  set_sched_current(next)
  sched_tick(next)
  # D.11 Phase 7 / B.1.b — see sched_pump for the save/restore protocol.
  # Path C.5.5.6 — BSP owns the process-global effect stack (see sched_pump).
  if eff_on_bsp()
    __qz_effect_restore_from_task(next)
  else
    eff_guard_no_ap_strip(next)
  end
  switch_to(pcpu_main_rsp_slot(), next + TASK_SAVED_RSP)
  sched_post_switch(next)
end

# Long-running goroutine spawned once at boot. Loops forever:
# increment a heartbeat counter, yield. Serves as the "is the
# scheduler actually alive during serve loop" signal — if the counter
# stops advancing while the kernel is still serving HTTP, we know
# something jammed the ready queue. Exposed via /api/stats.json
# (`goroutine_heartbeat`) so a curl poll proves the scheduler is
# live without opening QEMU's serial.
var g_goroutine_heartbeat = 0
def uk_heartbeat_body(): Void
  while 1 == 1
    g_goroutine_heartbeat = g_goroutine_heartbeat + 1
    yield_now()
  end
end

# SOUL.5 generation counter for Cancel All. Each demo task captures
# the value at entry; the cancel endpoint bumps the counter; demo
# tasks notice on their next loop iteration and task_exit() early.
# v0/v1 of the demo cancel — supervised cancellation through the
# scope tree comes with B.7 Phase 4e + C.14 Supervisor.
var g_soul_cancel_gen = 0

# SOUL.4 v3 — TSC-backed wall-clock for task deadlines. read_tsc is
# the @ASM intrinsic in boot_trampoline_x86.s; g_tsc_at_boot is the
# baseline captured in main() right after uart_init.
#
# TSC_NS_PER_CYCLE_DENOM is hardcoded — production VPS is reasonably
# modern x86 (~2 GHz Skylake+ via -cpu max), so 2 cycles/ns is a
# defensible approximation; ns = cycles / 2. Real CPU frequency is
# 1-4 GHz on common hardware, so the approximation is within 2x of
# wall time. SOUL.4 v4 will calibrate this constant from an external
# time signal (e.g., HPET) at boot.
const TSC_NS_PER_CYCLE_DENOM = 2

# Soul demo task lifetime in approximate ns. 2_000_000_000 ns ≈ 2 sec
# at 2 GHz; 1 sec at 4 GHz; 4 sec at 1 GHz. All inside a usable demo
# window — long enough that the htop table catches the task across
# multiple polls, short enough that the pool drains promptly without
# Cancel All.
const SOUL_DEMO_LIFETIME_NS = 2000000000

var g_tsc_at_boot = 0

# Approximate elapsed nanoseconds since main() entered. Built on
# rdtsc with a hardcoded ~2 GHz frequency assumption (see
# TSC_NS_PER_CYCLE_DENOM). Caller-visible monotonicity is the same
# as TSC's: invariant under -cpu max, monotonic across power states.
#
# D.11 Phase 8b.2.b — also serves as the freestanding bridge for
# the runtime-emitted @__qz_time_mono_ns helper (codegen_runtime.qz's
# freestanding branch emits a one-line shim that calls uk_time_mono_ns
# directly). Same in-module-define resolution pattern as @kern_tcp_*.
def uk_time_mono_ns(): Int = (read_tsc() - g_tsc_at_boot) / TSC_NS_PER_CYCLE_DENOM

# SOUL.5 demo body. Each spawned task busy-yields against a wall-
# clock deadline (~2 sec via uk_time_mono_ns), then exits cleanly.
# SOUL.5 v2 added cancel-gen observation — task_exit()s early if
# g_soul_cancel_gen ticks while the task is in-flight.
#
# SOUL.4 v3 (this version) replaces the v0/v1 yield-count budget
# with a TSC wall-clock deadline. The yield-count budget had a load-
# dependent lifetime (more sibling tasks = longer per-task lifetime,
# because each task gets fewer cycles per wall-second). A wall-clock
# deadline gives a stable ~2 sec lifetime regardless of load, which
# is what users intuitively expect when they click Spawn.
#
# Unsupervised — restart strategies + scope-tree cancellation come
# with C.14 Actor + Supervisor. v2 just exits early on the global
# cancel-gen, which is enough for the BEAM-pitch cancel-cascade demo.
def soul_demo_body(): Void
  var start_gen = g_soul_cancel_gen
  var deadline_ns = uk_time_mono_ns() + SOUL_DEMO_LIFETIME_NS
  while uk_time_mono_ns() < deadline_ns
    if g_soul_cancel_gen != start_gen
      task_exit()
    end
    yield_now()
  end
  task_exit()
end

# ==========================================================================
# SOUL.6 — Structured-concurrency micro-demos (Phase 2)
# ==========================================================================
#
# Four small click-to-run experiments that visualize what Quartz's
# concurrency primitives *do*. Each ships its own /api/soul/demo/* HTTP
# endpoint plus a task-body function the endpoint spawns goroutines
# against. The endpoint runs synchronously (yields while waiting for
# the children to report), returns a JSON timing snapshot, and the
# Soul page renders that snapshot inline.
#
# What's mock today, what's real:
#
#   - Deadline propagation: the parent computes a wall-clock deadline,
#     all children read it. Real "propagation through a scope tree"
#     comes with D.11 — but the *behavior* (children unwind clustered
#     at the deadline) is real today.
#
#   - Cancel cascade: kernel-level g_demo_cascade_gen flag, all sleeping
#     tasks observe it on next yield. Real `sched_wake_interrupts_sleep`
#     active-wake from B.7 Phase 4e.8 ships in D.11's bridge. The
#     measured cascade latency you see is real.
#
#   - Select race: pre-determined per-racer finish times, first racer
#     to cross its line writes `winner`. Real `select { case x = future
#     => ... }` machinery (C.13) lands in D.11. The race shape is real.
#
#   - Supervisor restart: handler-side coordinator polls a "child
#     exited" flag and respawns with exponential backoff. Real
#     `Supervisor.start_child` (C.14) lands in D.11. The restart cadence
#     is real.
#
# Per-demo state lives in PMM-backed slot arrays. Each child claims a
# slot id via a spinlock-protected counter on entry, then writes only
# its own slot. Handler reads slots after spawn, scans non-zero slots
# to detect completion. No atomics on slot reads/writes — single-writer
# discipline + 8-byte aligned i64 stores are atomic on x86.

const SOUL_DEMO_DEADLINE_MAX_N = 16
const SOUL_DEMO_CASCADE_MAX_N = 4096
const SOUL_DEMO_RACE_MAX_N = 32
const SOUL_DEMO_RESTART_MAX_EVENTS = 16

# Demo 1 — deadline propagation.
# Parent sets target_ns; each child busy-yields against it; on exit
# records its actual unwind TSC into its slot. Drift = unwind - target.
var g_demo_deadline_lock = 0
var g_demo_deadline_unwind_ns = 0   # PMM page: SOUL_DEMO_DEADLINE_MAX_N × i64
var g_demo_deadline_target_ns = 0
var g_demo_deadline_next_id = 0

def soul_demo_deadline_init(): Void
  g_demo_deadline_lock = spinlock_new()
  g_demo_deadline_unwind_ns = pmm_alloc_page()
end

def soul_demo_deadline_body(): Void
  # Claim a slot id. With M children spawned in a tight loop and the
  # M:N scheduler interleaving them across CPUs, we need a lock to
  # serialize the read-modify-write on the counter.
  spinlock_lock(g_demo_deadline_lock)
  var my_id = g_demo_deadline_next_id
  g_demo_deadline_next_id = g_demo_deadline_next_id + 1
  spinlock_unlock(g_demo_deadline_lock)

  # Busy-yield against the shared deadline. The "propagation" is
  # conceptual: parent set it, children read it. Under D.11's scope
  # tree this loop becomes `while not scope_check_cancelled(): yield()`
  # and the deadline is implicit in the current scope.
  while uk_time_mono_ns() < g_demo_deadline_target_ns
    yield_now()
  end
  var unwind = uk_time_mono_ns()
  volatile_store<U64>(g_demo_deadline_unwind_ns + my_id * 8, unwind)
  task_exit()
end

# GET /api/soul/demo/deadline — run one deadline-propagation experiment
# and return the result. Spawns 8 children sharing a 200 ms deadline,
# polls until all have recorded their unwind time (or 100 ms after
# the deadline as a hard timeout), returns drift array + aggregates.
#
# Synchronous: the handler holds the TCP connection open for ~200 ms
# while waiting. Other requests continue to serve on the scheduler's
# other CPUs / between yield_now() points.
#
#   {"version":1,"deadline_ms":200,"spawned":8,"completed":8,
#    "max_drift_ns":156234,"min_drift_ns":12450,
#    "drifts_ns":[12450,34122,...]}
def http_build_soul_demo_deadline(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")

  var n = 8
  # Headroom check against THIN pool (Path B routes demo bodies through
  # go_fn_thin). Demos compete with each other, not with HTTP.
  if g_task_alive_thin + n + 4 > NUM_TASKS_THIN
    off = buf_write_str(buf, off, "{\"version\":1,\"error\":\"insufficient_pool_headroom\",\"alive\":")
    off = buf_write_dec(buf, off, g_task_alive_thin)
    off = buf_write_str(buf, off, ",\"capacity\":")
    off = buf_write_dec(buf, off, NUM_TASKS_THIN)
    off = buf_write_str(buf, off, "}\n")
    return off
  end

  # Reset slot array + counters. The lock protects nothing here
  # (handler is single-writer) but using it documents the invariant.
  spinlock_lock(g_demo_deadline_lock)
  var i = 0
  while i < SOUL_DEMO_DEADLINE_MAX_N
    volatile_store<U64>(g_demo_deadline_unwind_ns + i * 8, 0)
    i = i + 1
  end
  g_demo_deadline_next_id = 0
  g_demo_deadline_target_ns = uk_time_mono_ns() + 200000000
  spinlock_unlock(g_demo_deadline_lock)

  # Spawn n children on the thin pool. go_fn_thin returns 0 on
  # thin-pool exhaustion; bail early.
  var spawned = 0
  i = 0
  while i < n
    var t = go_fn_thin(soul_demo_deadline_body)
    if t == 0
      i = n
    else
      spawned = spawned + 1
      i = i + 1
    end
  end

  # Poll until every spawned child has reported (slot != 0) or we
  # hit the hard timeout (deadline + 100 ms grace). Yields between
  # checks so the scheduler runs the children.
  var hard_deadline = g_demo_deadline_target_ns + 100000000
  var done = 0
  while done < spawned and uk_time_mono_ns() < hard_deadline
    yield_now()
    done = 0
    var j = 0
    while j < spawned
      if volatile_load<U64>(g_demo_deadline_unwind_ns + j * 8) != 0
        done = done + 1
      end
      j = j + 1
    end
  end

  # Compute drift aggregates. Drift = unwind - target (positive means
  # overshoot, which is the normal case for a cooperative scheduler).
  var max_drift = 0
  var min_drift = 999999999999
  var k = 0
  while k < spawned
    var u = volatile_load<U64>(g_demo_deadline_unwind_ns + k * 8)
    if u != 0
      var d = u - g_demo_deadline_target_ns
      if d > max_drift
        max_drift = d
      end
      if d < min_drift
        min_drift = d
      end
    end
    k = k + 1
  end
  if done == 0
    min_drift = 0
  end

  off = buf_write_str(buf, off, "{\"version\":1,\"deadline_ms\":200,\"spawned\":")
  off = buf_write_dec(buf, off, spawned)
  off = buf_write_str(buf, off, ",\"completed\":")
  off = buf_write_dec(buf, off, done)
  off = buf_write_str(buf, off, ",\"max_drift_ns\":")
  off = buf_write_dec(buf, off, max_drift)
  off = buf_write_str(buf, off, ",\"min_drift_ns\":")
  off = buf_write_dec(buf, off, min_drift)
  off = buf_write_str(buf, off, ",\"drifts_ns\":[")
  var m = 0
  while m < spawned
    if m > 0
      off = buf_write_str(buf, off, ",")
    end
    var u2 = volatile_load<U64>(g_demo_deadline_unwind_ns + m * 8)
    var drift = 0
    if u2 != 0
      drift = u2 - g_demo_deadline_target_ns
    end
    off = buf_write_dec(buf, off, drift)
    m = m + 1
  end
  off = buf_write_str(buf, off, "]}\n")
  return off
end

# Demo 2 — cancel cascade.
# N children (default 1000, max SOUL_DEMO_CASCADE_MAX_N) all wait on a
# generation counter. Handler bumps the counter; children observe on
# next yield, record their TSC, exit. Aggregate per-child latency from
# bump to record gives the cascade-fan-out cost.
var g_demo_cascade_lock = 0
var g_demo_cascade_unwind_ns = 0    # PMM 8 pages: SOUL_DEMO_CASCADE_MAX_N × i64
var g_demo_cascade_signal_ts = 0
var g_demo_cascade_gen = 0
var g_demo_cascade_next_id = 0
# Registration barrier (Path C.5.2). Each body increments this AFTER it has
# captured start_gen; the handler waits for registered == spawned before
# bumping the generation. Without the barrier, a body that hasn't had its
# first run when the signal fires reads start_gen == the already-bumped gen
# and then waits for a NEXT bump that never comes — stranded forever. A fixed
# settle window (the old approach) was calibrated to a fast no-copy scheduler;
# copying-stack scheduling (C.5.2) adds a per-schedule memcpy, and the
# hi-priority self-yielding handler + 4:1 fairness mean only ~1/5 of schedules
# in the window are normal-ring (cascade-body) first-runs. The barrier is
# robust to any scheduler speed / fairness ratio. See PATH_C_STACK_ON_DEMAND.md.
var g_demo_cascade_registered = 0

def soul_demo_cascade_init(): Void
  g_demo_cascade_lock = spinlock_new()
  # 4096 slots × 8B = 32 KiB = 8 PMM pages. First page gives the base;
  # subsequent pages must be contiguously bump-allocated.
  g_demo_cascade_unwind_ns = pmm_alloc_page()
  var p = 1
  while p < 8
    pmm_alloc_page()
    p = p + 1
  end
end

def soul_demo_cascade_body(): Void
  spinlock_lock(g_demo_cascade_lock)
  var my_id = g_demo_cascade_next_id
  g_demo_cascade_next_id = g_demo_cascade_next_id + 1
  var start_gen = g_demo_cascade_gen
  # Registration barrier — count this body in AFTER start_gen is captured, so
  # the handler only signals once every body holds a valid pre-bump baseline.
  g_demo_cascade_registered = g_demo_cascade_registered + 1
  spinlock_unlock(g_demo_cascade_lock)

  # Wait for the cancel signal — a generation-counter bump. In D.11
  # this becomes `select { case _ = cancellable(current_scope()) => ... }`
  # with `sched_wake_interrupts_sleep` interrupting the wait on bump
  # (active-wake, ~0 ms vs the busy-yield's per-tick polling cost).
  while g_demo_cascade_gen == start_gen
    yield_now()
  end
  var unwind = uk_time_mono_ns()
  volatile_store<U64>(g_demo_cascade_unwind_ns + my_id * 8, unwind)
  task_exit()
end

# GET /api/soul/demo/cascade?n=N — spawn N sleeping tasks, signal cancel,
# measure aggregate fan-out latency.
#
#   {"version":1,"n":1000,"spawned":1000,"completed":1000,
#    "signal_to_first_ns":120000,"signal_to_last_ns":8400000,
#    "under_1ms":923,"under_10ms":1000}
def http_build_soul_demo_cascade(buf: Int, requested: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")

  # Default n=1000, cap at MAX_N, floor at 1.
  var n = requested
  if n <= 0
    n = 1000
  end
  if n > SOUL_DEMO_CASCADE_MAX_N
    n = SOUL_DEMO_CASCADE_MAX_N
  end
  if g_task_alive_thin + n + 4 > NUM_TASKS_THIN
    off = buf_write_str(buf, off, "{\"version\":1,\"error\":\"insufficient_pool_headroom\",\"alive\":")
    off = buf_write_dec(buf, off, g_task_alive_thin)
    off = buf_write_str(buf, off, ",\"capacity\":")
    off = buf_write_dec(buf, off, NUM_TASKS_THIN)
    off = buf_write_str(buf, off, "}\n")
    return off
  end

  # Reset slot array + bump the generation cursor so this run is
  # distinguishable from prior runs (children check g_demo_cascade_gen
  # against the value they captured at entry).
  spinlock_lock(g_demo_cascade_lock)
  var i = 0
  while i < n
    volatile_store<U64>(g_demo_cascade_unwind_ns + i * 8, 0)
    i = i + 1
  end
  g_demo_cascade_next_id = 0
  g_demo_cascade_registered = 0
  spinlock_unlock(g_demo_cascade_lock)

  var spawned = 0
  i = 0
  while i < n
    var t = go_fn_thin(soul_demo_cascade_body)
    if t == 0
      i = n
    else
      spawned = spawned + 1
      i = i + 1
    end
  end

  # Registration barrier — wait until every spawned body has had its first run
  # and captured start_gen before firing the signal. This replaces a fixed
  # 10 ms settle window that stranded bodies which hadn't run yet when the
  # signal fired (they'd read the already-bumped gen and wait forever). The
  # barrier is correct for any scheduler speed; the 2 s safety cap is a
  # backstop against a body that somehow never runs (then it proceeds and the
  # stragglers simply don't complete — surfaced as completed < spawned).
  var barrier_deadline = uk_time_mono_ns() + 2000000000
  while (g_demo_cascade_registered < spawned) and (uk_time_mono_ns() < barrier_deadline)
    yield_now()
  end

  # Fire the cancel signal.
  g_demo_cascade_signal_ts = uk_time_mono_ns()
  g_demo_cascade_gen = g_demo_cascade_gen + 1

  # Poll until all spawned children have reported (or 100 ms hard timeout
  # — n=4096 typically drains in single-digit ms under cooperative pump).
  var hard_deadline = g_demo_cascade_signal_ts + 100000000
  var done = 0
  while done < spawned and uk_time_mono_ns() < hard_deadline
    yield_now()
    done = 0
    var j = 0
    while j < spawned
      if volatile_load<U64>(g_demo_cascade_unwind_ns + j * 8) != 0
        done = done + 1
      end
      j = j + 1
    end
  end

  # Aggregates: first-completion latency, last-completion latency,
  # bucket counts (under 1ms, under 10ms). Cheaper than sorting for
  # percentiles, and the page is showing a histogram anyway.
  var first_ns = 999999999999
  var last_ns = 0
  var under_1ms = 0
  var under_10ms = 0
  var k = 0
  while k < spawned
    var u = volatile_load<U64>(g_demo_cascade_unwind_ns + k * 8)
    if u != 0
      var lat = u - g_demo_cascade_signal_ts
      if lat < first_ns
        first_ns = lat
      end
      if lat > last_ns
        last_ns = lat
      end
      if lat < 1000000
        under_1ms = under_1ms + 1
      end
      if lat < 10000000
        under_10ms = under_10ms + 1
      end
    end
    k = k + 1
  end
  if done == 0
    first_ns = 0
  end

  off = buf_write_str(buf, off, "{\"version\":1,\"n\":")
  off = buf_write_dec(buf, off, n)
  off = buf_write_str(buf, off, ",\"spawned\":")
  off = buf_write_dec(buf, off, spawned)
  off = buf_write_str(buf, off, ",\"completed\":")
  off = buf_write_dec(buf, off, done)
  off = buf_write_str(buf, off, ",\"signal_to_first_ns\":")
  off = buf_write_dec(buf, off, first_ns)
  off = buf_write_str(buf, off, ",\"signal_to_last_ns\":")
  off = buf_write_dec(buf, off, last_ns)
  off = buf_write_str(buf, off, ",\"under_1ms\":")
  off = buf_write_dec(buf, off, under_1ms)
  off = buf_write_str(buf, off, ",\"under_10ms\":")
  off = buf_write_dec(buf, off, under_10ms)
  off = buf_write_str(buf, off, "}\n")
  return off
end

# Demo 3 — select race.
# N racers (default 8, max SOUL_DEMO_RACE_MAX_N) each have a per-racer
# pre-determined finish deadline (LCG-seeded from start TSC, range
# 50–250 ms). First racer to reach its deadline writes `winner`; others
# observe `winner >= 0` and record a negative timestamp (= lost) then exit.
const SOUL_DEMO_RACE_MIN_MS = 50
const SOUL_DEMO_RACE_MAX_MS = 250

var g_demo_race_lock = 0
var g_demo_race_scheduled_ns = 0    # PMM page: SOUL_DEMO_RACE_MAX_N × i64
var g_demo_race_actual_ts = 0       # PMM page: SOUL_DEMO_RACE_MAX_N × i64
var g_demo_race_n = 0
var g_demo_race_winner = -1
var g_demo_race_start_ns = 0
var g_demo_race_next_id = 0

def soul_demo_race_init(): Void
  g_demo_race_lock = spinlock_new()
  g_demo_race_scheduled_ns = pmm_alloc_page()
  g_demo_race_actual_ts = pmm_alloc_page()
end

def soul_demo_race_body(): Void
  spinlock_lock(g_demo_race_lock)
  var my_id = g_demo_race_next_id
  g_demo_race_next_id = g_demo_race_next_id + 1
  spinlock_unlock(g_demo_race_lock)

  var my_deadline = g_demo_race_start_ns + volatile_load<U64>(g_demo_race_scheduled_ns + my_id * 8)
  # Race loop: either reach our own deadline first (win) or observe
  # the winner being set by a faster racer (lose). In D.11 this is the
  # body of a `select { case _ = deadline_ms(d) => ... case _ = cancellable(scope) => ... }`.
  while uk_time_mono_ns() < my_deadline
    if g_demo_race_winner >= 0
      # Negative TS marks "lost". 0 means "not yet recorded" so we
      # must not write 0 — uk_time_mono_ns() is always > 0 after boot.
      volatile_store<U64>(g_demo_race_actual_ts + my_id * 8, 0 - uk_time_mono_ns())
      task_exit()
    end
    yield_now()
  end
  # Reached our deadline. Try to claim the win (first-write-wins under
  # the lock; subsequent winners would race here without serialization).
  spinlock_lock(g_demo_race_lock)
  if g_demo_race_winner < 0
    g_demo_race_winner = my_id
  end
  spinlock_unlock(g_demo_race_lock)
  volatile_store<U64>(g_demo_race_actual_ts + my_id * 8, uk_time_mono_ns())
  task_exit()
end

# GET /api/soul/demo/race?n=N — pre-seed per-racer finish offsets,
# spawn, wait for outcome, return per-racer table + winner_id.
#
#   {"version":1,"n":8,"spawned":8,"completed":8,"winner_id":3,
#    "winner_finish_ms":65,"racers":[
#      {"id":0,"scheduled_ms":120,"actual_ms":120,"won":false},...]}
def http_build_soul_demo_race(buf: Int, requested: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")

  var n = requested
  if n <= 0
    n = 8
  end
  if n > SOUL_DEMO_RACE_MAX_N
    n = SOUL_DEMO_RACE_MAX_N
  end
  if g_task_alive_thin + n + 4 > NUM_TASKS_THIN
    off = buf_write_str(buf, off, "{\"version\":1,\"error\":\"insufficient_pool_headroom\"}\n")
    return off
  end

  spinlock_lock(g_demo_race_lock)
  g_demo_race_n = n
  g_demo_race_winner = -1
  g_demo_race_next_id = 0
  g_demo_race_start_ns = uk_time_mono_ns()
  # Seed scheduled offsets with a Knuth LCG over the start TSC. Quartz
  # Int is 64-bit signed; multiplication wraps and the high bits go
  # negative — mask the sign bit off before modulo so the result is
  # always positive. Modulo into [MIN_MS, MAX_MS] for the 50–250 ms range.
  var seed = g_demo_race_start_ns
  var span_ms = SOUL_DEMO_RACE_MAX_MS - SOUL_DEMO_RACE_MIN_MS
  var i = 0
  while i < n
    seed = seed * 6364136223846793005 + 1442695040888963407
    # Shift right 33 bits to discard the sign bit + low-quality low bits,
    # then modulo. Keeps the result strictly in [0, span_ms).
    var rand_ms = shr(seed, 33) % span_ms
    if rand_ms < 0
      rand_ms = 0 - rand_ms
    end
    var ms_off = SOUL_DEMO_RACE_MIN_MS + rand_ms
    volatile_store<U64>(g_demo_race_scheduled_ns + i * 8, ms_off * 1000000)
    volatile_store<U64>(g_demo_race_actual_ts + i * 8, 0)
    i = i + 1
  end
  spinlock_unlock(g_demo_race_lock)

  var spawned = 0
  i = 0
  while i < n
    var t = go_fn_thin(soul_demo_race_body)
    if t == 0
      i = n
    else
      spawned = spawned + 1
      i = i + 1
    end
  end

  # Wait until every racer has set actual_ts (positive=won, negative=lost).
  var hard_deadline = g_demo_race_start_ns + (SOUL_DEMO_RACE_MAX_MS * 2) * 1000000
  var done = 0
  while done < spawned and uk_time_mono_ns() < hard_deadline
    yield_now()
    done = 0
    var j = 0
    while j < spawned
      if volatile_load<U64>(g_demo_race_actual_ts + j * 8) != 0
        done = done + 1
      end
      j = j + 1
    end
  end

  var winner_finish_ms = 0
  if g_demo_race_winner >= 0
    var wts = volatile_load<U64>(g_demo_race_actual_ts + g_demo_race_winner * 8)
    if wts > 0
      winner_finish_ms = (wts - g_demo_race_start_ns) / 1000000
    end
  end

  off = buf_write_str(buf, off, "{\"version\":1,\"n\":")
  off = buf_write_dec(buf, off, n)
  off = buf_write_str(buf, off, ",\"spawned\":")
  off = buf_write_dec(buf, off, spawned)
  off = buf_write_str(buf, off, ",\"completed\":")
  off = buf_write_dec(buf, off, done)
  off = buf_write_str(buf, off, ",\"winner_id\":")
  off = buf_write_dec(buf, off, g_demo_race_winner)
  off = buf_write_str(buf, off, ",\"winner_finish_ms\":")
  off = buf_write_dec(buf, off, winner_finish_ms)
  off = buf_write_str(buf, off, ",\"racers\":[")
  var m = 0
  while m < spawned
    if m > 0
      off = buf_write_str(buf, off, ",")
    end
    var sched_ms = volatile_load<U64>(g_demo_race_scheduled_ns + m * 8) / 1000000
    var ts = volatile_load<U64>(g_demo_race_actual_ts + m * 8)
    var actual_ms = 0
    var won_str = "false"
    if ts > 0
      actual_ms = (ts - g_demo_race_start_ns) / 1000000
      if m == g_demo_race_winner
        won_str = "true"
      end
    elsif ts < 0
      actual_ms = (0 - ts - g_demo_race_start_ns) / 1000000
    end
    off = buf_write_str(buf, off, "{\"id\":")
    off = buf_write_dec(buf, off, m)
    off = buf_write_str(buf, off, ",\"scheduled_ms\":")
    off = buf_write_dec(buf, off, sched_ms)
    off = buf_write_str(buf, off, ",\"actual_ms\":")
    off = buf_write_dec(buf, off, actual_ms)
    off = buf_write_str(buf, off, ",\"won\":")
    off = buf_write_str(buf, off, won_str)
    off = buf_write_str(buf, off, "}")
    m = m + 1
  end
  off = buf_write_str(buf, off, "]}\n")
  return off
end

# Demo 4 — supervisor restart.
# Hand-rolled supervisor coordinator: spawn a fragile task that exits
# early on the first 3 attempts; on the 4th it sleeps then succeeds.
# Each event (spawn / exit / restart / success) is recorded with the
# wall-clock offset since run-start.
const SOUL_DEMO_RESTART_MAX_ATTEMPTS = 4
const SOUL_DEMO_RESTART_BACKOFF_BASE_NS = 20000000   # 20 ms × 2^(attempt-1)
const SOUL_DEMO_RESTART_SUCCESS_DELAY_NS = 10000000  # 10 ms before success

# Event kinds. Must match the JS render switch below.
const SOUL_DEMO_RESTART_KIND_SPAWN = 0
const SOUL_DEMO_RESTART_KIND_EXIT = 1
const SOUL_DEMO_RESTART_KIND_RESTART = 2
const SOUL_DEMO_RESTART_KIND_SUCCESS = 3

var g_demo_restart_event_t_ns = 0       # PMM page: SOUL_DEMO_RESTART_MAX_EVENTS × i64
var g_demo_restart_event_kind = 0        # same
var g_demo_restart_event_attempt = 0     # same
var g_demo_restart_event_count = 0
var g_demo_restart_attempt_idx = 0
var g_demo_restart_child_done = 0
var g_demo_restart_child_success = 0
var g_demo_restart_start_ns = 0

def soul_demo_restart_init(): Void
  g_demo_restart_event_t_ns = pmm_alloc_page()
  g_demo_restart_event_kind = pmm_alloc_page()
  g_demo_restart_event_attempt = pmm_alloc_page()
end

# Append one event to the timeline. No lock needed — only the handler
# thread writes (children flip child_done/child_success and exit;
# handler observes + writes events).
def soul_demo_restart_log(kind: Int, attempt: Int): Void
  var idx = g_demo_restart_event_count
  if idx >= SOUL_DEMO_RESTART_MAX_EVENTS
    return
  end
  volatile_store<U64>(g_demo_restart_event_t_ns + idx * 8, uk_time_mono_ns() - g_demo_restart_start_ns)
  volatile_store<U64>(g_demo_restart_event_kind + idx * 8, kind)
  volatile_store<U64>(g_demo_restart_event_attempt + idx * 8, attempt)
  g_demo_restart_event_count = idx + 1
end

# Fragile child body. Reads g_demo_restart_attempt_idx (set by
# supervisor before spawn), logs spawn event, exits early on attempts
# < MAX. On the MAX-th attempt yields for SUCCESS_DELAY_NS then logs
# success.
def soul_demo_restart_body(): Void
  var my_attempt = g_demo_restart_attempt_idx
  soul_demo_restart_log(SOUL_DEMO_RESTART_KIND_SPAWN, my_attempt)
  # Single yield so the scheduler observes us before we exit.
  yield_now()
  if my_attempt < SOUL_DEMO_RESTART_MAX_ATTEMPTS
    soul_demo_restart_log(SOUL_DEMO_RESTART_KIND_EXIT, my_attempt)
    g_demo_restart_child_done = 1
    task_exit()
  end
  # Attempt MAX: yield for SUCCESS_DELAY_NS, then succeed.
  var deadline = uk_time_mono_ns() + SOUL_DEMO_RESTART_SUCCESS_DELAY_NS
  while uk_time_mono_ns() < deadline
    yield_now()
  end
  soul_demo_restart_log(SOUL_DEMO_RESTART_KIND_SUCCESS, my_attempt)
  g_demo_restart_child_success = 1
  g_demo_restart_child_done = 1
  task_exit()
end

# GET /api/soul/demo/restart — run the supervisor loop, return event timeline.
#
#   {"version":1,"attempts":4,"success":true,"total_ms":75,
#    "events":[{"t_ms":0,"kind":"spawn","attempt":1},
#              {"t_ms":1,"kind":"exit","attempt":1},
#              {"t_ms":21,"kind":"restart","attempt":2},...
#              {"t_ms":74,"kind":"success","attempt":4}]}
def http_build_soul_demo_restart(buf: Int): Int
  var off = 0
  off = buf_write_str(buf, off, "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\nServer: Quartz-unikernel\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")

  if g_task_alive_thin + 4 > NUM_TASKS_THIN
    off = buf_write_str(buf, off, "{\"version\":1,\"error\":\"insufficient_pool_headroom\"}\n")
    return off
  end

  # Reset state.
  g_demo_restart_event_count = 0
  g_demo_restart_start_ns = uk_time_mono_ns()
  g_demo_restart_child_success = 0

  # Supervisor loop: spawn, wait for done, log restart + backoff,
  # repeat until success or attempt cap.
  var attempt = 1
  while attempt <= SOUL_DEMO_RESTART_MAX_ATTEMPTS
    g_demo_restart_attempt_idx = attempt
    g_demo_restart_child_done = 0
    var t = go_fn_thin(soul_demo_restart_body)
    if t == 0
      # Pool exhaustion — break and report whatever's logged.
      attempt = SOUL_DEMO_RESTART_MAX_ATTEMPTS + 1
    else
      # Wait for the child to set done (50 ms hard cap per attempt).
      var attempt_deadline = uk_time_mono_ns() + 50000000
      while g_demo_restart_child_done == 0 and uk_time_mono_ns() < attempt_deadline
        yield_now()
      end
      if g_demo_restart_child_success == 1
        # Done — break out of the loop.
        attempt = SOUL_DEMO_RESTART_MAX_ATTEMPTS + 1
      else
        # Restart with exponential backoff (20 ms × 2^(attempt-1)).
        var backoff = SOUL_DEMO_RESTART_BACKOFF_BASE_NS
        var bx = 0
        while bx < attempt - 1
          backoff = backoff * 2
          bx = bx + 1
        end
        var bo_until = uk_time_mono_ns() + backoff
        while uk_time_mono_ns() < bo_until
          yield_now()
        end
        soul_demo_restart_log(SOUL_DEMO_RESTART_KIND_RESTART, attempt + 1)
        attempt = attempt + 1
      end
    end
  end

  var total_ms = (uk_time_mono_ns() - g_demo_restart_start_ns) / 1000000
  var success_str = "false"
  if g_demo_restart_child_success == 1
    success_str = "true"
  end

  # Compute "attempts" — the highest attempt number we logged a spawn for.
  var attempts_made = 0
  var k = 0
  while k < g_demo_restart_event_count
    var kind = volatile_load<U64>(g_demo_restart_event_kind + k * 8)
    if kind == SOUL_DEMO_RESTART_KIND_SPAWN
      var a = volatile_load<U64>(g_demo_restart_event_attempt + k * 8)
      if a > attempts_made
        attempts_made = a
      end
    end
    k = k + 1
  end

  off = buf_write_str(buf, off, "{\"version\":1,\"attempts\":")
  off = buf_write_dec(buf, off, attempts_made)
  off = buf_write_str(buf, off, ",\"success\":")
  off = buf_write_str(buf, off, success_str)
  off = buf_write_str(buf, off, ",\"total_ms\":")
  off = buf_write_dec(buf, off, total_ms)
  off = buf_write_str(buf, off, ",\"events\":[")
  var e = 0
  while e < g_demo_restart_event_count
    if e > 0
      off = buf_write_str(buf, off, ",")
    end
    var t_ns = volatile_load<U64>(g_demo_restart_event_t_ns + e * 8)
    var kind2 = volatile_load<U64>(g_demo_restart_event_kind + e * 8)
    var att = volatile_load<U64>(g_demo_restart_event_attempt + e * 8)
    off = buf_write_str(buf, off, "{\"t_ms\":")
    off = buf_write_dec(buf, off, t_ns / 1000000)
    off = buf_write_str(buf, off, ",\"kind\":\"")
    if kind2 == SOUL_DEMO_RESTART_KIND_SPAWN
      off = buf_write_str(buf, off, "spawn")
    elsif kind2 == SOUL_DEMO_RESTART_KIND_EXIT
      off = buf_write_str(buf, off, "exit")
    elsif kind2 == SOUL_DEMO_RESTART_KIND_RESTART
      off = buf_write_str(buf, off, "restart")
    else
      off = buf_write_str(buf, off, "success")
    end
    off = buf_write_str(buf, off, "\",\"attempt\":")
    off = buf_write_dec(buf, off, att)
    off = buf_write_str(buf, off, "}")
    e = e + 1
  end
  off = buf_write_str(buf, off, "]}\n")
  return off
end

# Boot init for SOUL.6 — allocates the per-demo backing pages and
# spinlocks. Called from main() after recent_init().
def soul_demo_init(): Void
  soul_demo_deadline_init()
  soul_demo_cascade_init()
  soul_demo_race_init()
  soul_demo_restart_init()
end


def uart_put_uint(n: Int): Void
  if n == 0
    uart_putc(48)   # '0'
    return
  end
  var scale = 1
  var probe = n
  while probe >= 10
    scale = scale * 10
    probe = probe / 10
  end
  var remaining = n
  while scale > 0
    var digit = remaining / scale
    uart_putc(48 + digit)
    remaining = remaining - (digit * scale)
    scale = scale / 10
  end
end

def main(): Int
  uart_init()
  # SOUL.4 v3 — capture TSC immediately so all subsequent
  # uk_time_mono_ns() readings are relative to a stable boot baseline.
  g_tsc_at_boot = read_tsc()
  uart_putc(72)   # 'H'
  uart_putc(105)  # 'i'
  uart_putc(10)   # '\n'

  idt_install()

  # Fire a breakpoint exception *before* enabling hardware interrupts —
  # proves IDT dispatch + iret work on a software int in isolation.
  # Hardware pushes RIP/CS/RFLAGS/RSP/SS, dispatches through IDT[3] to
  # breakpoint_isr, which prints "TRAP\n" and iret's back here.
  @c("int3")

  # --- RAM discovery (SOUL.2, 2026-05-09) ------------------------
  # The PVH probe already ran at module-init time (lazily, from the
  # first pmm_alloc_page invocation). Here we just log the result —
  # we couldn't print from the probe itself because it ran before
  # uart_init. If the probe failed, the fallback 64 MiB pool is
  # already installed and the kernel is booting in degraded mode.
  pvh_log_summary()

  # --- PMM smoke test --------------------------------------------
  # Allocate a few pages, write a distinct marker to each, read them
  # back, and print the pass count. Exercises the runtime pool +
  # bump allocator + load/store round-trip through identity-mapped
  # RAM. pmm_init() reads the bounds pvh_probe_ram just installed.
  pmm_init()
  var p1 = pmm_alloc_page()
  var p2 = pmm_alloc_page()
  var p3 = pmm_alloc_page()
  var p4 = pmm_alloc_page()
  ptr_write_byte(p1, 0x11)
  ptr_write_byte(p2, 0x22)
  ptr_write_byte(p3, 0x33)
  ptr_write_byte(p4, 0x44)
  var ok = 0
  if ptr_read_byte(p1) == 0x11
    ok = ok + 1
  end
  if ptr_read_byte(p2) == 0x22
    ok = ok + 1
  end
  if ptr_read_byte(p3) == 0x33
    ok = ok + 1
  end
  if ptr_read_byte(p4) == 0x44
    ok = ok + 1
  end
  # Also write to a non-first byte of one page to exercise a larger
  # offset within the allocation.
  ptr_write_byte(p2 + 4095, 0xAB)
  if ptr_read_byte(p2 + 4095) == 0xAB
    ok = ok + 1
  end
  uart_put_str("PMM #{ok}/5 (#{pmm_used_pages()}/#{pmm_total_pages()} pgs)\n")

  # --- Vec<Int> smoke test ---------------------------------------
  # malloc/realloc/memcpy/memset in libc_stubs.c now route through
  # pmm_alloc_page, so Quartz's stdlib Vec<T> should work inside
  # the kernel. Push triggers realloc when capacity runs out — if
  # the 4,4,4,4 sum comes out right, both malloc and realloc paths
  # round-trip through the PMM correctly.
  var v = vec_new<Int>()
  v.push(7)
  v.push(11)
  v.push(13)
  v.push(17)
  var total = v[0] + v[1] + v[2] + v[3]
  uart_put_str("VEC #{v.size} sum=#{total}\n")

  # --- Map<Int, Int> smoke test ----------------------------------
  # Hash buckets + probing + rehash all ride on malloc/realloc/
  # memcpy/memset. If Vec worked, this should too — but Map
  # stresses alignment + rehash paths Vec doesn't.
  var m = map_new()
  map_set(m, 1, 100)
  map_set(m, 2, 200)
  map_set(m, 3, 300)
  map_set(m, 4, 400)
  map_set(m, 5, 500)
  var sum = 0
  if map_has(m, 1)
    sum = sum + 100
  end
  if map_has(m, 2)
    sum = sum + 200
  end
  if map_has(m, 3)
    sum = sum + 300
  end
  if map_has(m, 4)
    sum = sum + 400
  end
  if map_has(m, 5)
    sum = sum + 500
  end
  uart_put_str("MAP #{map_size(m)} sum=#{sum}\n")

  # --- Slab allocator smoke test ---------------------------------
  # Six power-of-2 size classes (16..512 B) layered over the bump PMM
  # by libc_stubs.c. Allocations <= 512 B route through slab; larger
  # ones keep the multi-page bump path. The smoke routine exercises
  # per-class round-trips, LIFO freelist ordering, and class-boundary
  # picks (15→0, 16→0, 17→1, 511→5, 512→5, 513→multi-page) — 15 checks
  # total.
  var slab_ok = slab_smoke()
  uart_put_str("SLAB #{slab_ok}/15 (cls16=#{slab_class_stat(0, 1)}/#{slab_class_stat(0, 2)} cls512=#{slab_class_stat(5, 1)}/#{slab_class_stat(5, 2)})\n")

  # --- C.5.1 saved-stack allocator smoke -------------------------
  # Exercises ss_alloc/ss_free class selection, round-trips, LIFO reuse,
  # and chunk read/write before the copying-stack scheduler (C.5.2)
  # depends on it. Pure — only touches the ss freelists.
  var ss_ok = ss_smoke()
  uart_put_str("SS #{ss_ok}/#{SS_SMOKE_CHECKS} (live=#{g_ss_live} max=#{g_ss_live_max} bytes=#{g_ss_bytes})\n")

  pic_disable()
  apic_init()
  uart_put_str("APIC enabled @ 0xFEE00000\n")

  # K8.1 — enumerate logical CPUs from ACPI MADT. With QEMU
  # `-machine microvm,acpi=on -smp N` this populates g_cpu_table
  # with N entries. Without acpi=on, kernel falls back to
  # single-CPU mode (g_cpu_count = 0). Pure detection — no AP
  # bringup until K8.3.
  acpi_init()

  # K8.2 — allocate per-CPU pages and load BSP's GS-base.
  # Subsequent code can read CPU-local fields via cpu_local_load(off).
  # APs perform the equivalent setup in their bringup trampoline
  # (K8.3); today's BSP-only init exercises the framework.
  kern8_pcpu_init()

  # K8.9 — wire std/sync/scheduler to live kernel state. From this
  # point on any user Quartz code (today: hello_x86.qz itself; later:
  # std/net/http_server in the D.11 capstone) can call
  # scheduler_current_cpu(), scheduler_cpu_count(), etc. and get real
  # SMP answers instead of single-CPU stubs.
  scheduler_register_pcpu_pages(g_pcpu_pages, g_cpu_count)

  # K8.3 — bring up each AP into long mode and park it in a halt
  # loop. APs identify themselves by LAPIC ID, load their per-CPU
  # GS-base, log alive, increment g_ap_alive_count, then halt.
  # K8.MVP replaces the halt with sched_pump.
  ap_main_keepalive_guard()  # Keep ap_main symbol alive past Quartz DCE
  kern8_ap_bringup()

  # --- virtio-net discovery + init + RX post ---------------------
  var vnet = virtio_find_net()
  if vnet != 0
    var vver = volatile_load<U32>(vnet + VIRTIO_REG_VERSION)
    uart_put_str("virtio-net @ ")
    uart_put_hex(vnet)
    uart_put_str(" (v=")
    uart_put_uint(vver)
    uart_put_str(")\n")
    virtio_net_init(vnet)

    # Warm-up: broadcast ARP WHO-HAS 10.0.2.2 and wait for SLIRP's
    # reply. This teaches SLIRP our MAC<->IP binding so it can later
    # deliver TCP frames addressed to us. Without the preamble SLIRP
    # keeps ARPing for 10.0.2.15 and never forwards anything.
    virtio_net_rx_post()
    virtio_net_tx_arp_request()
    var arp_len = virtio_net_rx_wait()
    if arp_len < 0
      uart_put_str("RX: no ARP reply (timeout)\n")
    else
      virtio_net_dump_frame(arp_len)
    end

    # Guest-initiated ICMP echo round-trip to 10.0.2.2, also the
    # KERN.3b milestone.
    virtio_net_rx_post()
    virtio_net_send_icmp_echo()
    var icmp_len = virtio_net_rx_wait()
    if icmp_len < 0
      uart_put_str("RX: no ICMP reply (timeout)\n")
    else
      virtio_net_parse_icmp_reply(icmp_len)
    end
  else
    uart_put_str("virtio-net: none found\n")
  end

  # Enable interrupts — LAPIC timer drives vector 0x20 → timer_isr →
  # g_tick_count++. The context-switched scheduler doesn't need the
  # timer for its own dispatch (tasks yield cooperatively via
  # switch_to), but the firing interrupts prove: (1) the APIC is
  # actually delivering on vector 0x20, and (2) interrupts landing on
  # a task's own 4 KiB stack don't corrupt the context-switch state.
  @c("sti")

  # --- Context-switched scheduler --------------------------------
  # Allocate the 3-slot RSP table + one 4 KiB stack per task, seed
  # each stack with a fake suspended frame pointing at the task's
  # entry function, then enter the task-dispatch loop.
  g_task_slot_addr = pmm_alloc_page()
  var stack_a = pmm_alloc_page()
  var stack_b = pmm_alloc_page()
  store(task_slot(1), 0, task_init_stack(stack_a, task_a_body))
  store(task_slot(2), 0, task_init_stack(stack_b, task_b_body))

  # Round-robin while either task is still live. switch_to saves this
  # loop's RSP into slot 0, so when the picked task yields back we
  # resume execution right after the switch_to call.
  while (g_task_a_done == 0) or (g_task_b_done == 0)
    if g_task_a_done == 0
      switch_to(task_slot(0), task_slot(1))
    end
    if g_task_b_done == 0
      switch_to(task_slot(0), task_slot(2))
    end
  end
  # Park until the LAPIC timer has fired at least a few times — this
  # is the evidence that the APIC path actually works. The scheduler
  # demo itself runs fast enough (pure register shuffling + a handful
  # of UART writes) to complete in microseconds, so without the wait
  # we'd often exit with ticks=0 even if the APIC were wired correctly.
  while g_tick_count < 3
    @c("hlt")
  end
  uart_put_str("sched done (ticks=#{g_tick_count})\n")

  # --- N-on-1 goroutine runtime demo (DEF-E-N1 phase 1) ----------
  # Initializes the task pool + ready queue, spawns 5 goroutines,
  # pumps them until exit. Proves the primitives (go_fn / yield_now
  # / task_exit / sched_pump) work end-to-end before Phase 2 layers
  # channels on top. Expected serial output: "g0 g1 g2 g3 g4" three
  # times interleaved, then "sched_demo: done (alive=0, ready=0)".
  uk_sched_init()
  # gs-base is now live on the BSP — safe for libc_stubs.c's arena code
  # to start consulting sched_current(). Pre-uk_sched_init mallocs (Vec
  # growth from module-init, channel ring init, etc.) ran through the
  # plain freelist+bump path with the arena code fully skipped; from
  # here on, allocations inside a `qz_arena_begin/end` pair are tracked
  # per-task. See [[feedback-multipage-bump-no-reclaim]].
  qz_arena_runtime_ready()
  # D.11 Phase 7 / B.1.b — keepalive + warmup confirmation.
  # The keepalive_guard is a never-true wrapper around a call edge that
  # keeps __qz_eff_ensure_strip + task_effect_strip_alloc alive past
  # Quartz DCE (they're reached only from compiler-emitted IR, invisible
  # to source-level call-graph analysis). Without it, link fails with
  # `undefined symbol: __qz_eff_ensure_strip`.
  __qz_b1b_keepalive_guard()
  uart_put_str("[B.1] effect_stack_pool: warm=")
  uart_put_uint(g_effect_stack_pool_count)
  uart_put_str(" take=")
  uart_put_uint(g_effect_stack_pool_take_total)
  uart_putc(10)

  # D.11 Phase 7 / B.2 — setjmp/longjmp round-trip via libc_stubs.c.
  # Expected output: `[B.2] setjmp round-trip 7 ok`. Any other value
  # means the inline asm is wrong or longjmp didn't unwind back through
  # setjmp — gates B.3's throw-unwind work.
  var b2_rc = setjmp_longjmp_smoke()
  uart_put_str("[B.2] setjmp round-trip ")
  uart_put_uint(b2_rc)
  uart_put_str(" ok\n")

  # D.11 Phase 7 / Phase 8a step 2 — kernel listening-table smoke.
  # Verifies kern_tcp_listen + kern_tcp_close_listener round-trip directly
  # (no stdlib involvement yet — Phase 8b imports std/net/tcp into the
  # kernel and exercises the full @cfg(os: "unknown") tcp_listen body
  # that calls these via extern "C").
  # Expected output: `[8a.2] kern_listen 80 -> <nonzero> close=0`
  var p8a2 = kern_tcp_listen(80)
  uart_put_str("[8a.2] kern_listen 80 -> ")
  uart_put_uint(p8a2)
  uart_put_str(" close=")
  uart_put_uint(kern_tcp_close_listener(p8a2))
  uart_putc(10)

  # D.11 Phase 7 / Phase 8a step 3 — kern_tcp_accept registration smoke
  # (no SYN involved). Re-registers port 80 (kern_tcp_listen reuses the
  # entry from 8a.2, allocates a fresh accept_chan + sets userland_mode=1),
  # verifies the entry layout is consistent: ACTIVE=1, accept_chan is
  # non-zero, userland_mode=1. The "does a SYN flow through?" assertion
  # is exercised by the runtime path — boot leaves the listener registered
  # on port 5559 (an ephemeral userland port distinct from TCP_LISTEN_PORT)
  # via the smoke goroutine spawned below, so a host curl against :5559
  # drives tcp_accept_syn → accept_chan push → kern_tcp_accept return →
  # uart log. The 8a.2 entry is closed before falling through to the
  # main HTTP boot path; TCP_LISTEN_PORT == 80 is registered later by
  # the supervised server via stdlib's `tcp_listen` body.
  kern_tcp_close_listener(p8a2)
  var p8a3 = kern_tcp_listen(5559)
  var p8a3_active = volatile_load<U64>(p8a3 + KERN_LISTEN_ENTRY_ACTIVE)
  var p8a3_achan = volatile_load<U64>(p8a3 + KERN_LISTEN_ENTRY_ACCEPT_CHAN)
  uart_put_str("[8a.3] kern_listen 5559 active=")
  uart_put_uint(p8a3_active)
  uart_put_str(" accept_chan=")
  if p8a3_achan != 0
    uart_put_str("nonzero\n")
  else
    uart_put_str("zero\n")
  end
  # Stash the listener slot ptr for the runtime smoke goroutine below.
  g_smoke_8a3_listener = p8a3

  # D.11 Phase 7 / B.3 — Throws-catch round-trip via the freestanding
  # @__qz_effect_perform dispatch. Spawns b3_throws_body as a goroutine
  # (need sched_current != 0 so install actually provisions a strip;
  # main context's install no-ops by design), pumps the scheduler until
  # the goroutine completes, then verifies all three flags via UART.
  #
  # Expected output: `[B.3] throws caught handler=1 unwound=1 ok`.
  # `handler=1` proves perform's dispatch found and called the user
  # handler; `unwound=1` proves kind=2 longjmp returned control past
  # the throw site (i.e. perform's `do_unwind` block did longjmp(b_ptr)
  # and our setjmp'd return path executed g_b3_done = 1 AFTER the
  # with-block exited via unwind). `body_after=0` is checked but not
  # printed; if it's ever 1 the kind=2 dispatch is broken.
  g_b3_handler_ran = 0
  g_b3_body_after_throw = 0
  g_b3_done = 0
  __qz_b3_keepalive_guard()
  var b3_task = go_fn(b3_throws_body)
  if b3_task == 0
    uart_put_str("[B.3] SKIP: task pool full at spawn\n")
  else
    sched_pump()
    var b3_unwound = 0
    if g_b3_done == 1
      if g_b3_body_after_throw == 0
        b3_unwound = 1
      end
    end
    uart_put_str("[B.3] throws caught handler=")
    uart_put_uint(g_b3_handler_ran)
    uart_put_str(" unwound=")
    uart_put_uint(b3_unwound)
    if g_b3_handler_ran == 1
      if b3_unwound == 1
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN-no-unwind\n")
      end
    else
      uart_put_str(" BROKEN-no-handler\n")
    end
  end

  # D.11 Phase 7 / B.4 — park/wake round-trip via __qz_effect_suspend +
  # __qz_sched_wake. Spawns b4_park_body, drives pump (it parks and
  # control returns to main), then wakes it explicitly and pumps again
  # (it resumes inside suspend, records end TSC, exits).
  #
  # Expected: `[B.4] park->wake N tsc ok`. N is the round-trip in TSC
  # ticks; for QEMU TCG that's roughly host wallclock × 1-2 GHz so the
  # absolute count varies — the assertion is that the goroutine resumed
  # at all (suspend_rv=1, done=1). A round-trip in the millions of ticks
  # is normal and reported but not failed.
  g_b4_task_handle = 0
  g_b4_done = 0
  g_b4_start_tsc = 0
  g_b4_end_tsc = 0
  g_b4_suspend_rv = 0
  __qz_b4_keepalive_guard()
  var b4_task = go_fn(b4_park_body)
  if b4_task == 0
    uart_put_str("[B.4] SKIP: task pool full at spawn\n")
  else
    sched_pump()
    if g_b4_task_handle == 0
      uart_put_str("[B.4] BROKEN: task handle not published\n")
    else
      __qz_sched_wake(g_b4_task_handle)
      sched_pump()
      if g_b4_done == 1
        var b4_delta = g_b4_end_tsc - g_b4_start_tsc
        uart_put_str("[B.4] park->wake ")
        uart_put_uint(b4_delta)
        uart_put_str(" tsc rv=")
        uart_put_uint(g_b4_suspend_rv)
        if g_b4_suspend_rv == 1
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-bad-rv\n")
        end
      else
        uart_put_str("[B.4] BROKEN: goroutine never completed after wake\n")
      end
    end
  end

  # D.11 Phase 7 / B.5a — Selectable<Int> dispatch through kernel struct.
  # Spawn a goroutine; before sched_pump() runs it, kernel_awaitable(t)
  # .try_poll() should return None (slot READY, body never ran). After
  # sched_pump() drains the body (task_exit → task_free → state=FREE),
  # try_poll() returns Some — recycle-race-safe via captured TASK_ID.
  #
  # Expected: `[B.5a] awaitable pre_pending=1 post_done=1 iters=5 ok`.
  g_b5a_pre = 0
  g_b5a_post = 0
  g_b5a_iters = 0
  var b5a_task = go_fn(b5a_body)
  if b5a_task == 0
    uart_put_str("[B.5a] SKIP: task pool full at spawn\n")
  else
    var b5a_sel = kernel_awaitable(b5a_task)
    var pre_opt = b5a_sel.try_poll()
    if pre_opt.is_none()
      g_b5a_pre = 1
    end
    sched_pump()
    var post_opt = b5a_sel.try_poll()
    if post_opt.is_some()
      g_b5a_post = 1
    end
    uart_put_str("[B.5a] awaitable pre_pending=")
    uart_put_uint(g_b5a_pre)
    uart_put_str(" post_done=")
    uart_put_uint(g_b5a_post)
    uart_put_str(" iters=")
    uart_put_uint(g_b5a_iters)
    if g_b5a_pre == 1
      if g_b5a_post == 1
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN-no-completion\n")
      end
    else
      uart_put_str(" BROKEN-not-pending\n")
    end
  end

  # D.11 Phase 7 / B.5b — KRecvable/KSendable Selectable<Int> on a
  # kernel channel. Producer goroutine sends 3 values; consumer
  # goroutine drains via try_poll + complete. Both goroutines + main's
  # sched_pump() drive the smoke.
  #
  # Expected: `[B.5b] kchannel recvd=3 sum=42 v0=10 v1=15 v2=17 ok`.
  g_b5b_count = 0
  g_b5b_sum = 0
  g_b5b_v0 = 0
  g_b5b_v1 = 0
  g_b5b_v2 = 0
  g_b5b_ch = chan_new(4)
  if g_b5b_ch == 0
    uart_put_str("[B.5b] SKIP: chan_new failed\n")
  else
    var b5b_prod = go_fn(b5b_producer_body)
    var b5b_cons = go_fn(b5b_consumer_body)
    if b5b_prod == 0
      uart_put_str("[B.5b] SKIP: producer spawn failed\n")
    elsif b5b_cons == 0
      uart_put_str("[B.5b] SKIP: consumer spawn failed\n")
    else
      sched_pump()
      uart_put_str("[B.5b] kchannel recvd=")
      uart_put_uint(g_b5b_count)
      uart_put_str(" sum=")
      uart_put_uint(g_b5b_sum)
      uart_put_str(" v0=")
      uart_put_uint(g_b5b_v0)
      uart_put_str(" v1=")
      uart_put_uint(g_b5b_v1)
      uart_put_str(" v2=")
      uart_put_uint(g_b5b_v2)
      if g_b5b_count == 3
        if g_b5b_sum == 42
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-bad-sum\n")
        end
      else
        uart_put_str(" BROKEN-count\n")
      end
    end
  end

  # D.11 Phase 7 / B.5c — kernel_waiter active-wake.
  # waiter parks via kernel_waiter_register + __qz_effect_suspend.
  # target exits; sched_post_switch's DEAD branch calls
  # kernel_waiter_wake_all(target) → __qz_sched_wake(waiter). Without
  # the active wake, waiter would stay parked forever (timer-IRQ-only
  # wake doesn't fire in kernel-main's sched_pump invocation).
  #
  # Expected: `[B.5c] kwait woke=1 wake_total≥1 reg=1 unreg=0 ok`.
  g_b5c_target_handle = 0
  g_b5c_waiter_handle = 0
  g_b5c_waiter_start_tsc = 0
  g_b5c_waiter_end_tsc = 0
  g_b5c_waiter_woke = 0
  g_b5c_target_done = 0
  var kw_reg_before = g_kw_register_total
  var kw_wake_before = g_kw_wake_total
  # Spawn waiter FIRST so it runs early and parks before target completes.
  var b5c_waiter_t = go_fn(b5c_waiter_body)
  # Now spawn target + publish its handle so waiter can register on it.
  var b5c_target_t = go_fn(b5c_target_body)
  g_b5c_target_handle = b5c_target_t
  if b5c_waiter_t == 0
    uart_put_str("[B.5c] SKIP: waiter spawn failed\n")
  elsif b5c_target_t == 0
    uart_put_str("[B.5c] SKIP: target spawn failed\n")
  else
    sched_pump()
    var kw_reg_delta  = g_kw_register_total - kw_reg_before
    var kw_wake_delta = g_kw_wake_total - kw_wake_before
    uart_put_str("[B.5c] kwait woke=")
    uart_put_uint(g_b5c_waiter_woke)
    uart_put_str(" wake_total_delta=")
    uart_put_uint(kw_wake_delta)
    uart_put_str(" reg_delta=")
    uart_put_uint(kw_reg_delta)
    uart_put_str(" target_done=")
    uart_put_uint(g_b5c_target_done)
    if g_b5c_waiter_woke == 1
      if kw_wake_delta >= 1
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN-no-wake-call\n")
      end
    else
      uart_put_str(" BROKEN-never-resumed\n")
    end
  end

  # D.11 Phase 7 / B.5d.1 — STDLIB channel_new + send + recv end-to-end.
  # Producer/consumer goroutines use stdlib intrinsics. B.5d compiler
  # fork redirects to @chan_new/@chan_send/@chan_recv; B.5d.1 PASS
  # 1.2b+1.3 gate suppresses Future wrappers in freestanding. If you
  # see this line, the whole stack is working — stdlib's surface API
  # is callable from kernel code with no Future-poll machinery emitted.
  g_b5d1_count = 0
  g_b5d1_sum = 0
  g_b5d1_ch = channel_new(4)
  if g_b5d1_ch == 0
    uart_put_str("[B.5d1] SKIP: channel_new returned 0\n")
  else
    var b5d1_prod = go_fn(b5d1_producer_body)
    var b5d1_cons = go_fn(b5d1_consumer_body)
    if b5d1_prod == 0
      uart_put_str("[B.5d1] SKIP: producer spawn failed\n")
    elsif b5d1_cons == 0
      uart_put_str("[B.5d1] SKIP: consumer spawn failed\n")
    else
      sched_pump()
      uart_put_str("[B.5d1] stdlib chan recvd=")
      uart_put_uint(g_b5d1_count)
      uart_put_str(" sum=")
      uart_put_uint(g_b5d1_sum)
      if g_b5d1_count == 3
        if g_b5d1_sum == 63
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-bad-sum\n")
        end
      else
        uart_put_str(" BROKEN-count\n")
      end
    end
  end

  # D.11 Phase 7 / B.5e.3 — arg-passing async freestanding spawn smoke.
  # `async fn(args)` lowers to kern_go_closure with the args captured in a
  # closure env; the spawned thunk reads them back and calls the target.
  g_b5e3_ch = channel_new(4)
  if g_b5e3_ch == 0
    uart_put_str("[B.5e3] SKIP: channel_new returned 0\n")
  else
    var b5e3_one = async b5e3_one_worker(7)
    var b5e3_two = async b5e3_two_worker(10, 4)
    if b5e3_one == 0
      uart_put_str("[B.5e3] SKIP: 1-arg spawn failed\n")
    elsif b5e3_two == 0
      uart_put_str("[B.5e3] SKIP: 2-arg spawn failed\n")
    else
      sched_pump()
      var b5e3_got_one = 0
      var b5e3_got_two = 0
      var b5e3_recvd = 0
      # Drain the two values. Either worker may run first, so classify by
      # value: the 1-arg worker emits 107 (7+100), the 2-arg emits 40.
      var b5e3_i = 0
      while b5e3_i < 2
        var b5e3_v = recv(g_b5e3_ch)
        if b5e3_v == 107
          b5e3_got_one = 107
        elsif b5e3_v == 40
          b5e3_got_two = 40
        end
        b5e3_recvd = b5e3_recvd + 1
        b5e3_i = b5e3_i + 1
      end
      uart_put_str("[B.5e3] argpass one=")
      uart_put_uint(b5e3_got_one)
      uart_put_str(" two=")
      uart_put_uint(b5e3_got_two)
      uart_put_str(" recvd=")
      uart_put_uint(b5e3_recvd)
      if b5e3_got_one == 107
        if b5e3_got_two == 40
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-2arg\n")
        end
      else
        uart_put_str(" BROKEN-1arg\n")
      end
    end
  end

  # B.5e (go-surface): `go fn(args)` must spawn via kern_go_closure and
  # return the kernel task handle WITHOUT a trailing perform(Async, spawn)
  # — the kernel has no Async/spawn effect handler, so the perform would
  # re-dispatch an already-running task through nothing. Same arg-passing
  # workers as the async block, go-surface this time, distinct values
  # (108 = 8+100, 42 = 6*7) so a stray value from the async block can't
  # masquerade as a pass. Proves the freestanding NODE_GO redirect.
  if g_b5e3_ch != 0
    var b5eg_one = go b5e3_one_worker(8)
    var b5eg_two = go b5e3_two_worker(6, 7)
    if b5eg_one == 0
      uart_put_str("[B.5e3-go] SKIP: 1-arg go spawn failed\n")
    elsif b5eg_two == 0
      uart_put_str("[B.5e3-go] SKIP: 2-arg go spawn failed\n")
    else
      sched_pump()
      var b5eg_got_one = 0
      var b5eg_got_two = 0
      var b5eg_recvd = 0
      var b5eg_i = 0
      while b5eg_i < 2
        var b5eg_v = recv(g_b5e3_ch)
        if b5eg_v == 108
          b5eg_got_one = 108
        elsif b5eg_v == 42
          b5eg_got_two = 42
        end
        b5eg_recvd = b5eg_recvd + 1
        b5eg_i = b5eg_i + 1
      end
      uart_put_str("[B.5e3-go] argpass one=")
      uart_put_uint(b5eg_got_one)
      uart_put_str(" two=")
      uart_put_uint(b5eg_got_two)
      uart_put_str(" recvd=")
      uart_put_uint(b5eg_recvd)
      if b5eg_got_one == 108
        if b5eg_got_two == 42
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-2arg\n")
        end
      else
        uart_put_str(" BROKEN-1arg\n")
      end
    end
  end

  # B.5e.5 (go-lambda surface): `go do ... end` must spawn the lambda body as a
  # real kernel goroutine via kern_go_closure with captures threaded through the
  # closure env (mir_lower.qz::_mir_fs_spawn_lambda) — NOT the hosted $new/$poll
  # state machine + perform(Async, spawn) (no kernel handler). The lambda bodies
  # capture locals and write capture-derived values into the channel; distinct
  # values (209 = 9+200 single-capture, 56 = 8*7 two-capture) so a stray value
  # from an earlier block can't masquerade as a pass.
  if g_b5e3_ch != 0
    var b5eL_c1 = 9
    var b5eL_one = go do ->
      send(g_b5e3_ch, b5eL_c1 + 200)
      task_exit()
    end
    var b5eL_c2 = 8
    var b5eL_c3 = 7
    var b5eL_two = go do ->
      send(g_b5e3_ch, b5eL_c2 * b5eL_c3)
      task_exit()
    end
    if b5eL_one == 0
      uart_put_str("[B.5e5-lambda] SKIP: 1-capture go-lambda spawn failed\n")
    elsif b5eL_two == 0
      uart_put_str("[B.5e5-lambda] SKIP: 2-capture go-lambda spawn failed\n")
    else
      sched_pump()
      var b5eL_got_one = 0
      var b5eL_got_two = 0
      var b5eL_recvd = 0
      var b5eL_i = 0
      while b5eL_i < 2
        var b5eL_v = recv(g_b5e3_ch)
        if b5eL_v == 209
          b5eL_got_one = 209
        elsif b5eL_v == 56
          b5eL_got_two = 56
        end
        b5eL_recvd = b5eL_recvd + 1
        b5eL_i = b5eL_i + 1
      end
      uart_put_str("[B.5e5-lambda] capture one=")
      uart_put_uint(b5eL_got_one)
      uart_put_str(" two=")
      uart_put_uint(b5eL_got_two)
      uart_put_str(" recvd=")
      uart_put_uint(b5eL_recvd)
      if b5eL_got_one == 209
        if b5eL_got_two == 56
          uart_put_str(" ok\n")
        else
          uart_put_str(" BROKEN-2capture\n")
        end
      else
        uart_put_str(" BROKEN-1capture\n")
      end
    end
  end

  # B.5e — actor runtime intrinsics (freestanding fork of the hosted
  # @__qz_actor_* runtime). The clean-mark side-table (actor_mark_clean /
  # actor_check_clean → @actor_*_clean_kernel) is inbox-keyed and global, so it
  # is exercised directly here: mark, check-consume (must return 1 then 0), and
  # a never-marked miss (must return 0). The per-task identity slot
  # (actor_self_inbox → @actor_self_inbox_kernel reading TASK_ACTOR_INBOX) is
  # exercised inside two spawned workers with distinct handles — proving the
  # slot is the running task's, not shared. The fourth redirect,
  # __actor_set_self_inbox, is MIR-internal (not surface-callable); the workers
  # seed via the kernel helper and the IR-level check covers that redirect.
  _actor_kernel_dce_anchor()   # keep all four actor_*_kernel symbols emitted
  var b5e_inbox = 0x5E0
  var b5e_other = 0x5E9
  actor_mark_clean(b5e_inbox)
  var b5e_mark_ok    = 0
  var b5e_consume_ok = 0
  var b5e_miss_ok    = 0
  if actor_check_clean(b5e_inbox) == 1
    b5e_mark_ok = 1
  end
  if actor_check_clean(b5e_inbox) == 0
    b5e_consume_ok = 1
  end
  if actor_check_clean(b5e_other) == 0
    b5e_miss_ok = 1
  end
  g_b5e_w1_inbox = 0
  g_b5e_w2_inbox = 0
  g_b5e_self_ok  = 0
  var b5e_w1 = go_fn(b5e_worker1_body)
  var b5e_w2 = go_fn(b5e_worker2_body)
  if b5e_w1 == 0
    uart_put_str("[B.5e] SKIP: worker1 spawn failed\n")
  elsif b5e_w2 == 0
    uart_put_str("[B.5e] SKIP: worker2 spawn failed\n")
  else
    sched_pump()
    uart_put_str("[B.5e] actor self_ok=")
    uart_put_uint(g_b5e_self_ok)
    uart_put_str(" w1=")
    uart_put_uint(g_b5e_w1_inbox)
    uart_put_str(" w2=")
    uart_put_uint(g_b5e_w2_inbox)
    uart_put_str(" mark=")
    uart_put_uint(b5e_mark_ok)
    uart_put_str(" consume=")
    uart_put_uint(b5e_consume_ok)
    uart_put_str(" miss=")
    uart_put_uint(b5e_miss_ok)
    var b5e_iso = 0
    if g_b5e_w1_inbox == 0xB5E1 and g_b5e_w2_inbox == 0xB5E2
      b5e_iso = 1
    end
    if g_b5e_self_ok == 1 and b5e_iso == 1 and b5e_mark_ok == 1 and b5e_consume_ok == 1 and b5e_miss_ok == 1
      uart_put_str(" ok\n")
    else
      uart_put_str(" BROKEN\n")
    end
  end

  # B.5e.7 — REAL `actor Counter` end-to-end in the kernel. Spawns the driver
  # goroutine which spawns the actor (real kernel goroutine), fires 3
  # increments, blocks on a request-response get_count, then synchronously
  # stops it. count must be 3 — proves the freestanding actor poll loop
  # receives messages, mutates state across the blocking recv (locals persist
  # on the goroutine's own stack), replies, and shuts down cleanly.
  g_b5e7_done_ch = channel_new(1)
  if g_b5e7_done_ch == 0
    uart_put_str("[B.5e7] SKIP: channel_new returned 0\n")
  else
    var b5e7_task = go b5e7_driver()
    if b5e7_task == 0
      uart_put_str("[B.5e7] SKIP: driver spawn failed\n")
    else
      sched_pump()
      var b5e7_n = recv(g_b5e7_done_ch)
      uart_put_str("[B.5e7] real actor count=")
      uart_put_uint(b5e7_n)
      if b5e7_n == 3
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN\n")
      end
    end
  end

  # B.5e.8 — actor panic-recovery: a handler panics; the actor must survive
  # (the freestanding Throws boundary catches + recovers in place) and keep
  # serving. count==3 proves the poison was dropped and the 3 bumps applied.
  g_b5e8_done_ch = channel_new(1)
  if g_b5e8_done_ch == 0
    uart_put_str("[B.5e8] SKIP: channel_new returned 0\n")
  else
    var b5e8_task = go b5e8_driver()
    if b5e8_task == 0
      uart_put_str("[B.5e8] SKIP: driver spawn failed\n")
    else
      sched_pump()
      var b5e8_n = recv(g_b5e8_done_ch)
      uart_put_str("[B.5e8] actor survived panic count=")
      uart_put_uint(b5e8_n)
      if b5e8_n == 3
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN\n")
      end
    end
  end

  # B.5e.8c — REAL std/actor.qz Supervisor end-to-end: child crashes via
  # actor_die 3×; the watcher goroutine must detect each crash and respawn.
  # restart_count==3 proves the full supervisor stack runs freestanding.
  g_b5e8c_done_ch = channel_new(1)
  if g_b5e8c_done_ch == 0
    uart_put_str("[B.5e8c] SKIP: channel_new returned 0\n")
  else
    var b5e8c_task = go b5e8c_driver()
    if b5e8c_task == 0
      uart_put_str("[B.5e8c] SKIP: driver spawn failed\n")
    else
      sched_pump()
      var b5e8c_n = recv(g_b5e8c_done_ch)
      uart_put_str("[B.5e8c] supervisor restarts=")
      uart_put_uint(b5e8c_n)
      if b5e8c_n == 3
        uart_put_str(" ok\n")
      else
        uart_put_str(" BROKEN\n")
      end
    end
  end

  sched_demo()
  chan_demo()
  mutex_demo()

  # Long-running background goroutine — one bump per serve-loop
  # iteration, exposed in /api/stats.json as `goroutine_heartbeat`.
  # Proves the scheduler is pumping during production traffic
  # without opening QEMU's serial log.
  go_fn(uk_heartbeat_body)

  # --- TCP HTTP server on port 80 --------------------------------
  # Perpetual serve loop. Each iteration posts an RX buffer, waits
  # for a frame, and hands it to the TCP dispatcher. Runs until the
  # host kills QEMU.
  #
  # Pre-allocate the reusable TX scratch pages ONCE, before the loop.
  # Without this every tcp_send call and every HTTP response would
  # bump the PMM pool by a page, exhausting 64 MiB in a few thousand
  # requests.
  g_tcp_tx_scratch = pmm_alloc_page()
  # Response scratch is now per-slot, allocated inside tcp_conn_table_init
  # (16 pages per slot, 64 slots, 4 MiB total). This is what retains
  # in-flight response bytes across retransmits without a shared-scratch
  # collision between slots.
  tcp_conn_table_init()

  # UDP TX scratch (NET.1 Phase 1). One page is enough — single max-MTU
  # datagram fits with eth/ip/udp headers and virtio prelude.
  g_udp_tx_scratch = pmm_alloc_page()
  uart_put_str("UDP: echo on :")
  uart_put_uint(UDP_ECHO_PORT)
  uart_putc(10)

  # NET.1 Phase 1, Step 2.5 — WireGuard responder bring-up. Seeds
  # the static keypair from RDSEED/RDRAND (rng_new_hw), allocates the
  # outbound packet scratch, registers the dispatcher on UDP_WG_PORT
  # via the udp_handle_ipv4 fast path. No peers are configured at boot
  # for Phase 1; Step 2.6 will add the operator-supplied peer table.
  wg_init()

  # Static asset table + boot-time registration of baked assets
  # (generated by `quake baremetal:bake_assets` into site_assets.qz,
  # concatenated at build time). Must run AFTER pmm init because each
  # asset_register copies path/mime/body bytes into fresh PMM pages.
  asset_table_init()
  assets_init()
  recent_init()
  soul_demo_init()
  uart_put_str("HTTP: ")
  uart_put_uint(g_asset_count)
  uart_put_str(" baked assets registered\n")

  # D.11 Phase 8a step 3 runtime accept-flow smoke: spawn the goroutine
  # that blocks on kern_tcp_accept(g_smoke_8a3_listener). It parks until
  # tcp_accept_syn pushes a slot for an incoming SYN on port 5559 (the
  # listener registered above). The main HTTP loop's sched_pump_step
  # drives it on the next iteration after the SYN arrives.
  # Trigger from host: `curl -sS -m 1 http://10.0.2.15:5559/` (the curl
  # will time out / fail because step 3 doesn't yet read or write — we
  # only care that tcp_accept returns the slot, which the UART log proves).
  if g_smoke_8a3_listener != 0
    var smoke_t = go_fn(smoke_8a3_accept_body)
    if smoke_t == 0
      uart_put_str("[8a.3] SKIP: accept-smoke spawn failed (task pool full)\n")
    end
  end

  # Spawn the supervised HTTP server on TCP_LISTEN_PORT (80).
  # `supervised_server_body` calls `http_serve_supervised(http_server_config(80),
  # kernel_router_handler)` and never returns. The handler dispatches the
  # 14 kernel routes (`/`, `/api/stats.json`, `/api/soul/{stats,tasks}.json`,
  # `/api/soul/spawn?n=N`, `/api/soul/cancel`, `/api/soul/demo/{deadline,
  # cascade,race,restart}`, `/api/recent.json`, `/health`, baked assets
  # with 304 short-circuit, 404) and returns body-only `Response` values;
  # the wire format (status line + headers) is owned by
  # `_async_http_write_response_timeout`. Spawn failure halts the kernel
  # boot — without the HTTP server, the unikernel has no purpose.
  uart_put_str("[supervised] spawning HTTP server on :")
  uart_put_uint(TCP_LISTEN_PORT)
  uart_putc(10)
  var sup_t = go_fn_hi(supervised_server_body)
  if sup_t == 0
    panic_halt("supervised HTTP spawn failed (task pool full)")
  end

  # K8.6.6 retired the K8.7 boot-time IPI gate. With per-CPU rings
  # (K8.6.1) + defer-publish (K8.6.3) + chan/mutex park-unlock
  # (K8.6.4 + K8.6.5), the cooperative paths the gate was protecting
  # are now SMP-safe; cross-CPU wake IPIs fire from boot.

  # Path C.5.5 — all cooperative boot demos + B-series effect tests + the
  # supervised-server / heartbeat spawns have run single-CPU on BSP by now.
  # Release the APs: each marks itself online and begins pumping its per-CPU
  # ready ring. From here, serve-time /api/soul/spawn distributes demo bodies
  # (least_loaded_cpu over online CPUs) across all cores — the multicore win.
  g_ap_sched_enabled = 1

  # Post exactly one RX descriptor at startup, then re-post only after
  # each completion. Naïvely re-posting every iteration inflates
  # avail.idx far past used.idx and eventually wraps the ring,
  # which the device handles weirdly.
  virtio_net_rx_post()
  var server_forever = 1
  while server_forever == 1
    var rx_len = virtio_net_rx_wait()
    if rx_len > 0
      ip_handle_frame(rx_len)
      virtio_net_rx_post()
    end
    # Drive RTO-based retransmits. virtio_net_rx_wait returns -1 on
    # spin-timeout (~20M iterations) so the retransmit pass runs on
    # roughly the same cadence as rx activity — fine for 1-second RTO.
    tcp_retransmit_pass()
    # WG periodic timer driver (NET.1 Phase 1, Step 2.5). Walks every
    # configured peer's PeerTimers, dispatches REKEY/RETRANSMIT/KEEPALIVE/
    # GIVE_UP/REJECT_SESSION actions. Phase 1 only runs cleanup paths
    # locally; outbound dispatch lands in Step 2.6 alongside the
    # ARP/peer-MAC table.
    wg_device_tick(wg_now_ms())
    # Run one goroutine quantum per serve-loop turn. Phase-4 cooperative
    # scheduling — the heartbeat (and future per-connection) goroutines
    # get one yield-bounded step while RX is idle.
    sched_pump_step()
  end
  # Unreachable — the kernel serves HTTP until the host kills QEMU.
  return 0
end
