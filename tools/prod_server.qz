## Quartz production HTTP server for mattkelly.io
## Runs behind Caddy reverse proxy (Caddy handles TLS)
## M:N scheduler, keepalive, static file serving + API

import std/net/http_server

def handler(req: Request): Response
  if req.path == "/api/info"
    return json_response("{\"server\": \"Quartz\", \"version\": \"5.25.0-alpha\", \"scheduler\": \"M:N\", \"workers\": \"auto\"}")
  elsif req.path == "/api/health"
    return json_response("{\"status\": \"ok\"}")
  end
  return not_found()
end

def main(): Int
  var config = http_server_config(8080)
  config.read_timeout_ms = 30000
  config.write_timeout_ms = 30000
  config.keepalive_max_requests = 1000
  config.keepalive_timeout_ms = 60000

  puts("Quartz production server — :8080 (behind Caddy)")
  http_serve_supervised(config, handler | with_static("/", "/var/www/quartz"))
  return 0
end
