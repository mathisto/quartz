##! # CST Corpus Round-Trip Checker — Formatter M1.3b coverage oracle
##!
##! Drives the lossless CST parser (`self-hosted/frontend/cst_parser.qz`) over a
##! list of real `.qz` corpus files and reports, per file, whether the verbatim
##! oracle (`cst_to_source_verbatim`) reproduces the original source byte-for-byte.
##!
##! ## Usage
##!
##!   <flags> tools/cst_roundtrip_check.qz FILELIST > /ll
##!   # FILELIST = a newline-separated list of file paths (one per line).
##!   # Generate it with e.g.:
##!   #   find self-hosted std examples tools spec -name '*.qz' > /tmp/corpus.txt
##!
##! It reads each path, parses it into a CST, serializes verbatim, and compares
##! to the original bytes. Prints a summary (total / pass / fail) plus, for each
##! failure, the path and the first byte-offset at which output diverges from the
##! input together with a short before/after snippet so the unhandled construct
##! can be localized.
##!
##! This tool is the M1.3b integration test: it measures corpus-wide losslessness
##! coverage and is re-run after each batch of grammar work to track progress
##! toward 100%.
##!
##! @see cst_parser.qz The CST driver + verbatim oracle under test.
##! @since 5.12.21-alpha (formatter epic)

import cst_parser

## Returns the byte offset of the first divergence between `a` and `b`, or -1 if
## they are byte-identical. (Compares min-length prefix; if the prefix matches
## but lengths differ, the divergence is at the shorter length.)
def first_divergence(a: String, b: String): Int
  var la = str_byte_len(a)
  var lb = str_byte_len(b)
  var n = la
  if lb < n
    n = lb
  end
  var i = 0
  while i < n
    if a.str_byte_at(i) != b.str_byte_at(i)
      return i
    end
    i = i + 1
  end
  if la != lb
    return n
  end
  return -1
end

## A short, single-line-safe snippet of `s` around byte offset `off`.
def snippet_at(s: String, off: Int): String
  var len = str_byte_len(s)
  var start = off - 12
  if start < 0
    start = 0
  end
  var stop = off + 24
  if stop > len
    stop = len
  end
  return str_byte_slice(s, start, stop)
end

def main(): Int
  if argc() < 2
    puts("usage: cst_roundtrip_check FILELIST")
    return 2
  end
  var list_path = argv(1)
  var listing = read_file(list_path)
  var paths = str_split(listing, "\n")

  var total = 0
  var passed = 0
  var failed = 0
  var structured = 0
  var unstructured = 0

  var i = 0
  while i < paths.size
    var path = paths[i]
    i = i + 1
    if str_byte_len(path) == 0
      continue
    end
    total = total + 1
    var src = read_file(path)
    var out = cst_parser::cst_roundtrip(src)
    var div = first_divergence(out, src)
    if div == -1
      passed = passed + 1
    else
      failed = failed + 1
      var inlen = str_byte_len(src)
      var outlen = str_byte_len(out)
      puts("LOSSY #{path}")
      puts("  diverge@#{div}  in_len=#{inlen} out_len=#{outlen}")
      puts("  want: #{snippet_at(src, div)}")
      puts("  got:  #{snippet_at(out, div)}")
    end
    # Structural-coverage probe: did the grammar recognize every construct, or
    # did it fall back to the verbatim force-consume path? The verbatim oracle
    # round-trips losslessly either way (correct token spans), so this is the
    # honest "is the tree structured / formattable" signal M1.3b drives to 100%.
    if cst_parser::cst_parse_fully_structured(src) == 1
      structured = structured + 1
    else
      unstructured = unstructured + 1
      var eline = cst_parser::cst_first_unstructured_line(src)
      var etok = cst_parser::cst_first_unstructured_token(src)
      puts("UNSTRUCTURED #{path}  first-fallback line=#{eline} tok=#{etok}")
    end
  end

  puts("")
  puts("=== CST corpus round-trip (verbatim losslessness GATE) ===")
  puts("total:   #{total}")
  puts("lossless: #{passed}")
  puts("lossy:    #{failed}")
  if total > 0
    var pct = (passed * 100) / total
    puts("losslessness: #{pct}%")
  end
  puts("")
  puts("=== CST structural coverage (fully-structured parse, no fallback) ===")
  puts("structured:   #{structured}")
  puts("unstructured: #{unstructured}")
  if total > 0
    var spct = (structured * 100) / total
    puts("structural coverage: #{spct}%")
  end
  if failed == 0
    return 0
  end
  return 1
end
