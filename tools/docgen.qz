# be-docgen: Documentation extractor for Be source files
# Extracts ## doc comments and outputs Markdown documentation

def char_at(s: String, i: Int): String
  return str_from_char(str_byte_at(s, i))
end

def is_space_code(code: Int): Int
  if code == ' ' or code == '\t'
    return 1
  end
  return 0
end

def trim_left(s: String): String
  var i = 0
  var len = str_byte_len(s)
  while i < len
    if is_space_code(str_byte_at(s, i)) == 0
      return str_byte_slice(s, i, len)
    end
    i = i + 1
  end
  return ""
end

def starts_with(s: String, prefix: String): Int
  var plen = str_byte_len(prefix)
  if str_byte_len(s) < plen
    return 0
  end
  if str_byte_slice(s, 0, plen) == prefix
    return 1
  end
  return 0
end

def extract_after(s: String, prefix: String): String
  var plen = str_byte_len(prefix)
  return str_byte_slice(s, plen, str_byte_len(s))
end

# Parse a doc comment block into structured parts
def print_doc_section(title: String, content: String): Void
  if str_byte_len(content) > 0
    puts("")
    puts("**" + title + "**: " + content)
  end
end

def process_doc_block(doc: String, name: String, kind: String): Void
  puts("")
  puts("## " + kind + ": `" + name + "`")
  puts("")
  
  # Split doc by newlines and categorize
  var lines = str_split(doc, "\n")
  var i = 0
  var count = lines.size
  var in_example = 0
  var description = ""
  
  while i < count
    var line = as_string(lines[i])
    var trimmed = trim_left(line)
    
    if starts_with(trimmed, "@param ")
      var rest = extract_after(trimmed, "@param ")
      puts("- **param** " + rest)
    elsif starts_with(trimmed, "@returns ")
      var rest = extract_after(trimmed, "@returns ")
      puts("- **returns** " + rest)
    elsif starts_with(trimmed, "@example")
      puts("")
      puts("**Example:**")
      puts("```be")
      in_example = 1
    elsif in_example
      if starts_with(trimmed, "@")
        puts("```")
        in_example = 0
        # Re-process this line
        i -= 1
      else
        puts(line)
      end
    else
      # Regular description line
      if str_byte_len(trimmed) > 0
        if str_byte_len(description) > 0
          description = description + " "
        end
        description = description + trimmed
      end
    end
    
    i = i + 1
  end
  
  if in_example
    puts("```")
  end
  
  if str_byte_len(description) > 0
    puts(description)
  end
end

def is_doc_comment_line(line: String): Int
  var trimmed = trim_left(line)
  return starts_with(trimmed, "##")
end

def extract_doc_content(line: String): String
  var trimmed = trim_left(line)
  if starts_with(trimmed, "## ")
    return extract_after(trimmed, "## ")
  elsif starts_with(trimmed, "##")
    return extract_after(trimmed, "##")
  end
  return ""
end

def is_def_line(line: String): Int
  var trimmed = trim_left(line)
  return starts_with(trimmed, "def ")
end

def is_struct_line(line: String): Int
  var trimmed = trim_left(line)
  return starts_with(trimmed, "struct ")
end

def is_enum_line(line: String): Int
  var trimmed = trim_left(line)
  return starts_with(trimmed, "enum ")
end

def extract_name(line: String, prefix: String): String
  var trimmed = trim_left(line)
  var rest = extract_after(trimmed, prefix)
  # Find end of name (space, paren, colon, or <)
  var i = 0
  var len = str_byte_len(rest)
  while i < len
    var c = str_byte_at(rest, i)
    if c == '(' or c == ':' or c == '<' or c == ' '
      return str_byte_slice(rest, 0, i)
    end
    i = i + 1
  end
  return rest
end

def main(): Int
  if argc() < 2
    puts("Usage: docgen <file.be>")
    puts("")
    puts("Extracts ## doc comments and generates Markdown documentation.")
    return 1
  end
  
  var filename = argv(1)
  var source = read_file(filename)
  
  if str_byte_len(source) == 0
    puts("Error: Could not read file: " + filename)
    return 1
  end
  
  puts("# Documentation: " + filename)
  puts("")
  puts("*Generated by be-docgen*")
  
  var lines = str_split(source, "\n")
  var count = lines.size
  var i = 0
  var current_doc = ""
  
  while i < count
    var line = as_string(lines[i])
    
    var is_doc = is_doc_comment_line(line)
    if is_doc
      # Accumulate doc comment
      var content = extract_doc_content(line)
      if str_byte_len(current_doc) > 0
        current_doc = current_doc + "\n"
      end
      current_doc = current_doc + content
    elsif is_def_line(line)
      if str_byte_len(current_doc) > 0
        var name = extract_name(line, "def ")
        process_doc_block(current_doc, name, "Function")
        current_doc = ""
      end
    elsif is_struct_line(line)
      if str_byte_len(current_doc) > 0
        var name = extract_name(line, "struct ")
        process_doc_block(current_doc, name, "Struct")
        current_doc = ""
      end
    elsif is_enum_line(line)
      if str_byte_len(current_doc) > 0
        var name = extract_name(line, "enum ")
        process_doc_block(current_doc, name, "Enum")
        current_doc = ""
      end
    else
      # Non-doc, non-definition line - reset doc accumulator
      var trimmed = trim_left(line)
      if str_byte_len(trimmed) > 0
        current_doc = ""
      end
    end
    
    i = i + 1
  end
  
  puts("")
  return 0
end
