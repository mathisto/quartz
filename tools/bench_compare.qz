## bench_compare — A/B comparison driver for std/bench JSONL files.
##
## Phase C.8 Phase 5. Loads two BENCHJSON-formatted JSONL files and
## compares them name-by-name, emitting a comparison summary on
## stderr and a non-zero exit code if any benchmark regressed.
##
## Usage:
##   bench_compare <baseline.jsonl> <current.jsonl>
##   bench_compare <baseline.jsonl> <current.jsonl> --quiet  # JSON only
##
## Exit codes:
##   0 — no regressions (some may have improved)
##   1 — one or more regressions detected
##   2 — argument / file error

import * from std/bench

def usage(): Void
  eputs("Usage: bench_compare <baseline.jsonl> <current.jsonl> [--quiet]")
end

def main(): Int
  var n = argc()
  if n < 3
    usage()
    return 2
  end
  var baseline_path = argv(1)
  var current_path = argv(2)
  var quiet = 0
  for i in 3..n
    if str_eq(argv(i), "--quiet")
      quiet = 1
    end
  end

  var baseline = bench_load_from_file(baseline_path)
  var current = bench_load_from_file(current_path)

  if baseline.size == 0
    eprint("[bench_compare] no entries loaded from baseline: ")
    eprint(baseline_path)
    eprint("\n")
    return 2
  end
  if current.size == 0
    eprint("[bench_compare] no entries loaded from current: ")
    eprint(current_path)
    eprint("\n")
    return 2
  end

  if quiet == 0
    eprint("[bench_compare] baseline=")
    eprint(baseline_path)
    eprint(" (")
    eprint(baseline.size.to_s())
    eprint(" entries) current=")
    eprint(current_path)
    eprint(" (")
    eprint(current.size.to_s())
    eprint(" entries)\n")
  end

  var any_regression = 0
  var matched = 0
  var only_current = 0

  for cur in current
    var base = bench_find_by_name(baseline, cur.name)
    if str_byte_len(base.name) == 0
      only_current = only_current + 1
      if quiet == 0
        eprint("[bench_compare ?] ")
        eprint(cur.name)
        eprint(": current only (no baseline entry)\n")
      end
    else
      matched = matched + 1
      var c = bench_compare(base, cur)
      if quiet == 0
        bench_emit_compare(c)
      end
      ## Emit machine-readable comparison line on stdout regardless of
      ## quiet mode — this is what CI consumes.
      var sb = sb_new()
      sb_append(sb, "BENCHCMP:{\"v\":1,\"name\":\"")
      sb_append(sb, c.name)
      sb_append(sb, "\",\"unit\":\"")
      sb_append(sb, c.unit)
      sb_append(sb, "\",\"baseline_median\":")
      sb_append(sb, c.baseline_median.to_s())
      sb_append(sb, ",\"current_median\":")
      sb_append(sb, c.current_median.to_s())
      sb_append(sb, ",\"pct_change_x100\":")
      sb_append(sb, c.pct_change_x100.to_s())
      sb_append(sb, ",\"verdict\":")
      sb_append(sb, c.verdict.to_s())
      sb_append(sb, ",\"mw_significant\":")
      if c.mw_significant
        sb_append(sb, "true")
      else
        sb_append(sb, "false")
      end
      sb_append(sb, "}")
      puts(sb_to_string(sb))
      if c.verdict == 1
        any_regression = 1
      end
    end
  end

  ## Find baseline entries that aren't in current (deleted bench).
  var only_baseline = 0
  for base in baseline
    var cur = bench_find_by_name(current, base.name)
    if str_byte_len(cur.name) == 0
      only_baseline = only_baseline + 1
      if quiet == 0
        eprint("[bench_compare -] ")
        eprint(base.name)
        eprint(": baseline only (entry removed from current)\n")
      end
    end
  end

  if quiet == 0
    eprint("[bench_compare] matched=")
    eprint(matched.to_s())
    eprint(" only_current=")
    eprint(only_current.to_s())
    eprint(" only_baseline=")
    eprint(only_baseline.to_s())
    eprint("\n")
  end

  return any_regression
end
