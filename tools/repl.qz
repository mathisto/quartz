## Quartz Interactive REPL (DEPRECATED)
##
## This standalone REPL has been superseded by the integrated REPL at
## self-hosted/shared/repl.qz, accessible via `quartz repl`.
## The integrated version provides raw-mode line editing, live syntax
## highlighting, tab completion, and history persistence.
##
## @deprecated Use `quartz repl` instead.
## @since 5.27.0

import time

# ============================================================================
# REPL State
# ============================================================================

## Accumulated definitions (functions, structs, enums, imports, type aliases)
var repl_preamble = ""

## Counter for temp file naming
var repl_counter = 0

## Path to the Quartz compiler binary
var repl_compiler = ""

## Path to the lli binary for JIT execution
var repl_lli = ""

# ============================================================================
# Input Classification
# ============================================================================

## Check if input is a definition (should be added to preamble)
def is_definition(input: String): Bool
  if str_starts_with(input, "def ") == 1
    return true
  end
  if str_starts_with(input, "struct ") == 1
    return true
  end
  if str_starts_with(input, "enum ") == 1
    return true
  end
  if str_starts_with(input, "import ") == 1
    return true
  end
  if str_starts_with(input, "type ") == 1
    return true
  end
  if str_starts_with(input, "trait ") == 1
    return true
  end
  if str_starts_with(input, "impl ") == 1
    return true
  end
  if str_starts_with(input, "const ") == 1
    return true
  end
  if str_starts_with(input, "extern ") == 1
    return true
  end
  if str_starts_with(input, "macro ") == 1
    return true
  end
  return false
end

## Check if input needs multi-line continuation
## Returns 1 if input has unclosed blocks, 0 otherwise
def needs_continuation(input: String): Int
  var depth = 0
  var lines = str_split(input, "\n")
  for i in 0..lines.size
    var line = str_trim(lines[i])
    # Openers
    if str_starts_with(line, "if ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "while ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "for ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "def ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "struct ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "enum ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "trait ") == 1
      depth = depth + 1
    end
    if str_starts_with(line, "impl ") == 1
      depth = depth + 1
    end
    if str_ends_with(line, " do ->") == 1
      depth = depth + 1
    end
    # Closers
    if line == "end"
      depth -= 1
    end
  end
  return depth
end

# ============================================================================
# Compilation and Execution
# ============================================================================

## Wrap input in a program and compile/run it
def repl_eval(input: String): String
  repl_counter = repl_counter + 1
  var src_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".qz"
  var ir_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".ll"
  var err_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".err"
  var out_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".out"

  # Build program source
  var sb = sb_new()
  if str_byte_len(repl_preamble) > 0
    sb_append(sb, repl_preamble)
    sb_append(sb, "\n")
  end
  sb_append(sb, "def main(): Int\n")
  sb_append(sb, "  ")
  sb_append(sb, input)
  sb_append(sb, "\n")
  sb_append(sb, "  return 0\n")
  sb_append(sb, "end\n")

  var source = sb_to_string(sb)
  var _w = write_file(src_path, source)

  # Compile
  var compile_cmd = repl_compiler + " -I std " + src_path + " > " + ir_path + " 2> " + err_path
  var compile_result = system(compile_cmd)

  if compile_result != 0
    # Compilation error — read and return error message
    var err = read_file(err_path)
    # Cleanup
    system("rm -f " + src_path + " " + ir_path + " " + err_path)
    return "Error: " + err
  end

  # Execute via lli
  var run_cmd = repl_lli + " " + ir_path + " > " + out_path + " 2>&1"
  var run_result = system(run_cmd)
  var output = read_file(out_path)

  # Cleanup
  system("rm -f " + src_path + " " + ir_path + " " + err_path + " " + out_path)

  if run_result != 0
    return "Runtime error (exit " + (run_result / 256).to_s() + ")"
  end

  return output
end

## Evaluate a definition (add to preamble)
def repl_eval_def(input: String): String
  # Try compiling with the definition
  repl_counter = repl_counter + 1
  var src_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".qz"
  var ir_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".ll"
  var err_path = "/tmp/_quartz_repl_" + repl_counter.to_s() + ".err"

  var sb = sb_new()
  if str_byte_len(repl_preamble) > 0
    sb_append(sb, repl_preamble)
    sb_append(sb, "\n")
  end
  sb_append(sb, input)
  sb_append(sb, "\n")
  sb_append(sb, "def main(): Int\n  return 0\nend\n")

  var source = sb_to_string(sb)
  var _w = write_file(src_path, source)

  var compile_cmd = repl_compiler + " -I std " + src_path + " > " + ir_path + " 2> " + err_path
  var compile_result = system(compile_cmd)

  # Cleanup
  system("rm -f " + src_path + " " + ir_path + " " + err_path)

  if compile_result != 0
    var err = read_file(err_path)
    return "Error: " + err
  end

  # Success — add to preamble
  repl_preamble = repl_preamble + input + "\n"
  return ""
end

# ============================================================================
# REPL Commands
# ============================================================================

def handle_command(cmd: String): Int
  if cmd == ":quit" or cmd == ":q"
    return -1
  end
  if cmd == ":clear"
    repl_preamble = ""
    puts("State cleared.")
    return 1
  end
  if cmd == ":help"
    puts("Quartz REPL Commands:")
    puts("  :help    — Show this help")
    puts("  :quit    — Exit the REPL (or :q)")
    puts("  :clear   — Clear accumulated state")
    puts("  :state   — Show accumulated definitions")
    puts("")
    puts("Enter expressions to evaluate, or definitions to accumulate.")
    puts("Multi-line input: blocks ending with 'do ->' or 'if'/'while'/'for'")
    puts("are accumulated until matching 'end'.")
    return 1
  end
  if cmd == ":state"
    if str_byte_len(repl_preamble) == 0
      puts("(no accumulated state)")
    else
      puts(repl_preamble)
    end
    return 1
  end
  puts("Unknown command: " + cmd)
  puts("Type :help for available commands.")
  return 1
end

# ============================================================================
# Main REPL Loop
# ============================================================================

def main(): Int
  # Find compiler
  repl_compiler = "self-hosted/bin/quartz"
  if file_exists(repl_compiler) == 0
    repl_compiler = "./self-hosted/bin/quartz"
    if file_exists(repl_compiler) == 0
      puts("Error: Cannot find Quartz compiler")
      return 1
    end
  end

  # Find lli
  repl_lli = env_get("QUARTZ_LLI")
  if str_byte_len(repl_lli) == 0
    # Try common paths (Homebrew on macOS, system on Linux)
    if file_exists("/opt/homebrew/opt/llvm/bin/lli") == 1
      repl_lli = "/opt/homebrew/opt/llvm/bin/lli"
    elsif file_exists("/opt/homebrew/opt/llvm@20/bin/lli") == 1
      repl_lli = "/opt/homebrew/opt/llvm@20/bin/lli"
    elsif file_exists("/usr/bin/lli") == 1
      repl_lli = "/usr/bin/lli"
    elsif file_exists("/usr/lib/llvm-20/bin/lli") == 1
      repl_lli = "/usr/lib/llvm-20/bin/lli"
    elsif file_exists("/usr/lib/llvm-19/bin/lli") == 1
      repl_lli = "/usr/lib/llvm-19/bin/lli"
    elsif file_exists("/usr/lib/llvm-18/bin/lli") == 1
      repl_lli = "/usr/lib/llvm-18/bin/lli"
    else
      puts("Error: Cannot find lli (LLVM interpreter)")
      puts("Set QUARTZ_LLI=/path/to/lli or install LLVM")
      return 1
    end
  end

  puts("Quartz REPL v0.1.0")
  puts("Type :help for commands, :quit to exit")
  puts("")

  var running = 1
  var multi_line_buf = ""
  var in_multi_line = 0

  while running == 1
    # Print prompt
    if in_multi_line == 1
      print("..> ")
    else
      print("qz> ")
    end

    # Read a line
    var line = readline()
    if str_byte_len(line) == 0
      if in_multi_line == 0
        continue
      end
    end

    # Multi-line accumulation
    if in_multi_line == 1
      multi_line_buf = multi_line_buf + "\n" + line
      if needs_continuation(multi_line_buf) <= 0
        # Block closed — process the accumulated input
        line = multi_line_buf
        multi_line_buf = ""
        in_multi_line = 0
      else
        continue
      end
    end

    # Handle commands
    if str_starts_with(line, ":") == 1
      var result = handle_command(line)
      if result < 0
        running = 0
      end
      continue
    end

    # Check for multi-line start
    if needs_continuation(line) > 0
      multi_line_buf = line
      in_multi_line = 1
      continue
    end

    # Process input
    if is_definition(line)
      var result = repl_eval_def(line)
      if str_byte_len(result) > 0
        puts(result)
      else
        puts("Defined.")
      end
    else
      # Try as expression — wrap with print_int for numeric results
      var result = repl_eval("print_int(" + line + ")")
      if str_starts_with(result, "Error:") == 1
        # Try as bare statement
        result = repl_eval(line)
      end
      if str_byte_len(result) > 0
        print(result)
      end
    end
  end

  puts("Goodbye!")
  return 0
end
