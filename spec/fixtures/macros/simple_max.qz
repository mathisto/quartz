# Test macro expansion - Phase 5.9.3
# A simple string template macro that computes the max of two values
# Note: Uses multi-line if syntax (not condensed) to support else

macro max(a, b) do
  "if ${a} > ${b}\n  ${a}\nelse\n  ${b}\nend"
end

def main(): Int
  result = $max(10, 5)
  return result
end
