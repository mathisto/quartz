; Async-lock drain panic helper
@.async_lock_drain_msg = private unnamed_addr constant [59 x i8] c"async lock freed while wait list non-empty (UAF imminent)\0A\00"
define void @qz_async_lock_drain_panic() noreturn nounwind {
