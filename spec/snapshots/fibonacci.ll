; Backtrace helper for panic stack traces
declare i32 @backtrace(ptr, i32)
declare void @backtrace_symbols_fd(ptr, i32, i32)
define void @qz_print_backtrace() nounwind {
  %buf = alloca [64 x ptr]
  %ptr = bitcast [64 x ptr]* %buf to ptr
  %n = call i32 @backtrace(ptr %ptr, i32 64)
  call void @backtrace_symbols_fd(ptr %ptr, i32 %n, i32 2)
  ret void
}

; Main entry point wrapper
define i32 @main(i32 %argc, ptr %argv) {
  %argc64 = sext i32 %argc to i64
  store i64 %argc64, ptr @qz_argc
  store ptr %argv, ptr @qz_argv
  ; effect runtime D.4 / P3.B / E.1.c: initialize + register default handlers (per-thread)
  call void @__qz_effect_install_defaults()
  %result = call i64 @qz_main()
  %result32 = trunc i64 %result to i32
  ret i32 %result32
}
