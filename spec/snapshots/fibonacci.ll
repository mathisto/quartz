entry:
  %hdr = inttoptr i64 %map to ptr
  %cap = load i64, ptr %hdr
  %mask = sub i64 %cap, 1
  %keys_p = getelementptr i64, ptr %hdr, i64 2
  %keys_i = load i64, ptr %keys_p
  %keys = inttoptr i64 %keys_i to ptr
  %hash = call i64 %hash_fn(i64 %key)
  %start = and i64 %hash, %mask
  br label %loop
loop:
  %idx = phi i64 [%start, %entry], [%next, %cont]
  %cnt = phi i64 [0, %entry], [%cntn, %cont]
  %done = icmp sge i64 %cnt, %cap
  br i1 %done, label %not_found, label %check
check:
  %slot = getelementptr i64, ptr %keys, i64 %idx
  %slotv = load i64, ptr %slot
  %is_empty = icmp eq i64 %slotv, 0
  br i1 %is_empty, label %not_found, label %check_tomb
check_tomb:
  %is_tomb = icmp eq i64 %slotv, 1
  br i1 %is_tomb, label %cont, label %compare
compare:
  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)
  %is_eq = icmp ne i64 %eq, 0
  br i1 %is_eq, label %found, label %cont
cont:
  %next_raw = add i64 %idx, 1
  %next = and i64 %next_raw, %mask
  %cntn = add i64 %cnt, 1
  br label %loop
found:
  ret i64 1
not_found:
  ret i64 0
}

define void @qz_map_custom_rehash(i64 %map, ptr %hash_fn) nounwind {
entry:
  %hdr = inttoptr i64 %map to ptr
  %old_cap = load i64, ptr %hdr
  %keys_p = getelementptr i64, ptr %hdr, i64 2
  %old_keys_i = load i64, ptr %keys_p
  %old_keys = inttoptr i64 %old_keys_i to ptr
  %vals_p = getelementptr i64, ptr %hdr, i64 3
  %old_vals_i = load i64, ptr %vals_p
  %old_vals = inttoptr i64 %old_vals_i to ptr
  %new_cap_raw = mul i64 %old_cap, 2
  %too_small = icmp slt i64 %new_cap_raw, 4
  %new_cap = select i1 %too_small, i64 4, i64 %new_cap_raw
  %new_mask = sub i64 %new_cap, 1
  %new_bytes = mul i64 %new_cap, 8
  %new_keys = call ptr @__qz_alloc(i64 %new_bytes)
  call void @memset(ptr %new_keys, i32 0, i64 %new_bytes)
  %new_vals = call ptr @__qz_alloc(i64 %new_bytes)
  br label %rh_loop
rh_loop:
  %ri = phi i64 [0, %entry], [%ri_next, %rh_cont]
  %rh_done = icmp sge i64 %ri, %old_cap
  br i1 %rh_done, label %rh_finish, label %rh_check
rh_check:
  %old_kslot = getelementptr i64, ptr %old_keys, i64 %ri
  %old_key = load i64, ptr %old_kslot
  %rh_valid = icmp ugt i64 %old_key, 1
  br i1 %rh_valid, label %rh_copy, label %rh_cont
rh_copy:
  %old_vslot = getelementptr i64, ptr %old_vals, i64 %ri
  %old_val = load i64, ptr %old_vslot
  %rh_hash = call i64 %hash_fn(i64 %old_key)
  %rh_start = and i64 %rh_hash, %new_mask
  br label %rh_probe
rh_probe:
  %rh_pi = phi i64 [%rh_start, %rh_copy], [%rh_pnext, %rh_probe_cont]
  %nk_slot = getelementptr i64, ptr %new_keys, i64 %rh_pi
  %nk_val = load i64, ptr %nk_slot
  %nk_empty = icmp eq i64 %nk_val, 0
  br i1 %nk_empty, label %rh_insert, label %rh_probe_cont
rh_probe_cont:
  %rh_pnext_raw = add i64 %rh_pi, 1
  %rh_pnext = and i64 %rh_pnext_raw, %new_mask
  br label %rh_probe
rh_insert:
  store i64 %old_key, ptr %nk_slot
  %nv_slot = getelementptr i64, ptr %new_vals, i64 %rh_pi
  store i64 %old_val, ptr %nv_slot
  br label %rh_cont
rh_cont:
  %ri_next = add i64 %ri, 1
  br label %rh_loop
rh_finish:
  store i64 %new_cap, ptr %hdr
  %new_keys_i = ptrtoint ptr %new_keys to i64
  store i64 %new_keys_i, ptr %keys_p
  %new_vals_i = ptrtoint ptr %new_vals to i64
  store i64 %new_vals_i, ptr %vals_p
  call void @__qz_dealloc(ptr %old_keys)
  call void @__qz_dealloc(ptr %old_vals)
  ret void
}

define void @qz_map_custom_set(i64 %map, i64 %key, i64 %val, ptr %hash_fn, ptr %eq_fn) nounwind {
entry:
  %hdr = inttoptr i64 %map to ptr
  %cap0 = load i64, ptr %hdr
  %size_p = getelementptr i64, ptr %hdr, i64 1
  %size0 = load i64, ptr %size_p
  %thresh = mul i64 %cap0, 3
  %thresh2 = sdiv i64 %thresh, 4
  %need_resize = icmp sge i64 %size0, %thresh2
  br i1 %need_resize, label %do_rehash, label %search
do_rehash:
  call void @qz_map_custom_rehash(i64 %map, ptr %hash_fn)
  br label %search
search:
  %cap = load i64, ptr %hdr
  %mask = sub i64 %cap, 1
  %keys_p = getelementptr i64, ptr %hdr, i64 2
  %keys_i = load i64, ptr %keys_p
  %keys = inttoptr i64 %keys_i to ptr
  %vals_pp = getelementptr i64, ptr %hdr, i64 3
  %vals_i = load i64, ptr %vals_pp
  %vals = inttoptr i64 %vals_i to ptr
  %hash = call i64 %hash_fn(i64 %key)
  %start = and i64 %hash, %mask
  br label %loop
loop:
  %idx = phi i64 [%start, %search], [%next, %cont]
  %pcnt = phi i64 [0, %search], [%pcntn, %cont]
  %pdone = icmp sge i64 %pcnt, %cap
  br i1 %pdone, label %done, label %check
check:
  %slot = getelementptr i64, ptr %keys, i64 %idx
  %slotv = load i64, ptr %slot
  %avail = icmp ule i64 %slotv, 1
  br i1 %avail, label %store, label %cmp
cmp:
  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)
  %is_eq = icmp ne i64 %eq, 0
  br i1 %is_eq, label %update, label %cont
cont:
  %next_raw = add i64 %idx, 1
  %next = and i64 %next_raw, %mask
  %pcntn = add i64 %pcnt, 1
  br label %loop
store:
  store i64 %key, ptr %slot
  %vslot = getelementptr i64, ptr %vals, i64 %idx
  store i64 %val, ptr %vslot
  %sz = load i64, ptr %size_p
  %sz1 = add i64 %sz, 1
  store i64 %sz1, ptr %size_p
  ret void
update:
  %uvslot = getelementptr i64, ptr %vals, i64 %idx
  store i64 %val, ptr %uvslot
  ret void
done:
  ret void
}

define void @qz_map_custom_delete(i64 %map, i64 %key, ptr %hash_fn, ptr %eq_fn) nounwind {
entry:
  %hdr = inttoptr i64 %map to ptr
  %cap = load i64, ptr %hdr
  %mask = sub i64 %cap, 1
  %size_p = getelementptr i64, ptr %hdr, i64 1
  %keys_p = getelementptr i64, ptr %hdr, i64 2
  %keys_i = load i64, ptr %keys_p
  %keys = inttoptr i64 %keys_i to ptr
  %hash = call i64 %hash_fn(i64 %key)
  %start = and i64 %hash, %mask
  br label %loop
loop:
  %idx = phi i64 [%start, %entry], [%next, %cont]
  %cnt = phi i64 [0, %entry], [%cntn, %cont]
  %done = icmp sge i64 %cnt, %cap
  br i1 %done, label %end, label %check
check:
  %slot = getelementptr i64, ptr %keys, i64 %idx
  %slotv = load i64, ptr %slot
  %is_empty = icmp eq i64 %slotv, 0
  br i1 %is_empty, label %end, label %check_tomb
check_tomb:
  %is_tomb = icmp eq i64 %slotv, 1
  br i1 %is_tomb, label %cont, label %compare
compare:
  %eq = call i64 %eq_fn(i64 %key, i64 %slotv)
  %is_eq = icmp ne i64 %eq, 0
  br i1 %is_eq, label %found, label %cont
cont:
  %next_raw = add i64 %idx, 1
  %next = and i64 %next_raw, %mask
  %cntn = add i64 %cnt, 1
  br label %loop
found:
  store i64 1, ptr %slot
  %sz = load i64, ptr %size_p
  %sz1 = sub i64 %sz, 1
  store i64 %sz1, ptr %size_p
  ret void
