}


; Bounds check panic helper
@.bounds_fmt = private unnamed_addr constant [42 x i8] c"index out of bounds: index %ld, size %ld\0A\00"
define void @qz_bounds_panic(i64 %index, i64 %size) noreturn nounwind {
  %buf = alloca [128 x i8]
  %ptr = getelementptr [128 x i8], [128 x i8]* %buf, i64 0, i64 0
  %fmt = getelementptr [42 x i8], [42 x i8]* @.bounds_fmt, i64 0, i64 0
  %len.i32 = call i32 (ptr, ptr, ...) @sprintf(ptr %ptr, ptr %fmt, i64 %index, i64 %size)
  %len = sext i32 %len.i32 to i64
  %wr = call i64 @write(i32 2, ptr %ptr, i64 %len)
  %jb = call ptr @__qz_panic_jmpbuf_get()
  %has_jb = icmp ne ptr %jb, null
  br i1 %has_jb, label %do_longjmp, label %do_abort
do_longjmp:
  call void @longjmp(ptr %jb, i32 1)
  unreachable
do_abort:
  call void @qz_print_backtrace()
  call void @abort()
  unreachable
}

