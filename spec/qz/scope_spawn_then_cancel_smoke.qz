## B.7 Phase 4b + 4e.8 smoke test: spawn-then-cancel scope inheritance
## with deterministic recheck via active-wake.
##
## Replaces the flaky qspec test that lived at
## `spec/qspec/scope_inheritance_spec.qz` as
## `it("spawn-then-cancel + yield — child observes on recheck")`.
## See `docs/bugs/done/SCOPE_INHERITANCE_SPAWN_THEN_CANCEL_FLAKE.md`
## for the original failure analysis. The qspec version used
## `sched_yield()` between checks, which is not a hard scheduling
## barrier — the parent's `scope_cancel + await` could race ahead of
## the child's recheck write. With Phase 4e.8's active-wake retrofit
## the child can park inside `scope_sleep_ms`, the parent calls
## `scope_cancel_with`, the cancel walker fires `sched_wake` on the
## parked task, the sleep throws via the unified Throws transport,
## the child catches and rechecks `scope_is_cancelled` —
## deterministic across runs.
##
## The child wraps its sleep in `scope_with(s, child_inner)` so the
## throw bridges through `_sw_catch` cleanly back to the outer
## `with Throws { throw: cap }`. (Direct `scope_sleep_ms` inside
## `with Throws` without `scope_with` doesn't reach cap — see the
## follow-up bug doc.)
##
## Standalone (not qspec): qspec describe/it lambdas treat `go fn()`
## as a Future created+polled inline (not a real worker-thread spawn),
## so the worker-blocks-then-cancel pattern can't be expressed there.

import * from std/sync/composition/scope
import * from std/throws

var first_check_observed_cancel = 0
var recheck_observed_cancel = 0
var cap_fired = 0
var caught_msg = ""
var s = 0

def cap(op_name: Int, argc: Int, argv: Int): Int
  cap_fired += 1
  caught_msg = as_type<String>(load(argv, 0))
  return 0
end

def child_inner(): Int
  scope_sleep_ms(5_000)
  return 0
end

def child(): Int
  if scope_is_cancelled(current_scope())
    first_check_observed_cancel = 1
  end
  with Throws { throw: cap } do ->
    scope_with(s, child_inner)
    0
  end
  if scope_is_cancelled(current_scope())
    recheck_observed_cancel = 1
  end
  return 0
end

def body(): Int
  var h = go child()
  sched_sleep(50)
  scope_cancel_with(s, "parent-cancel")
  await h
  return 0
end

def main(): Int
  s = scope_with_cancel(scope_root())
  scope_with(s, body)
  if first_check_observed_cancel != 0
    puts("FAIL: child observed cancel on first check (expected 0 — parent cancels after spawn)")
    return 1
  end
  if cap_fired != 1
    puts("FAIL: Throws handler did not fire (cap_fired=#{str_from_int(cap_fired)})")
    return 2
  end
  if caught_msg != "parent-cancel"
    puts("FAIL: expected throw msg 'parent-cancel', got '#{caught_msg}'")
    return 3
  end
  if recheck_observed_cancel != 1
    puts("FAIL: recheck did not observe cancel after active-wake")
    return 4
  end
  puts("OK: spawn-then-cancel scope-inheritance recheck observed deterministically via active-wake")
  return 0
end
