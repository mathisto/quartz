struct Point
  x: Int
end
# Record as Vec element via the binding annotation (the element type flows from
# `Vec<{ x: Int }>` on `v`). The turbofish `vec_new<{ x: Int }>()` form is a
# separate CST-parser gap (record type inside `<...>` mis-parses as a comparison
# → QZ0403); filed as a follow-on. The annotation-driven form exercises the full
# C3 record-element vertical slice: push a nominal Point (width-subtypes the
# record), read `v[0]` back through the record's flat value-layout.
def main(): Int
  var v: Vec<{ x: Int }> = vec_new()
  v.push(Point{ x: 7 })
  var e: { x: Int } = v[0]
  return e.x
end
