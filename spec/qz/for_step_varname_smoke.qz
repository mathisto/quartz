# Regression smoke for A2: `for step in 0..n` must NOT be miscompiled to a
# null-Vec iteration. The loop VARIABLE named `step` is not the optional
# `step EXPR` stride clause; the clause is only the `step` keyword AFTER `in`.
# Also asserts a GENUINE `for k in 0..N step 2` still honors its stride.
def main(): Int
  # (1) Loop var literally named `step`: sums 0+1+2+3+4 = 10.
  var sum = 0
  for step in 0..5
    sum += step
  end
  puts(str_from_int(sum))

  # (2) Genuine step clause with a non-`step` var: k = 0,2,4,6,8 → sum 20.
  var sum2 = 0
  for k in 0..10 step 2
    sum2 += k
  end
  puts(str_from_int(sum2))

  return 0
end
