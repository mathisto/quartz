## Deterministic bounded-capacity regression for supervisor lock ordering.

import * from std/net/http_dynamic_goroutine_sup

def backpressure_probe(sup: HttpDynamicGoroutineSup): Int
  sched_sleep(50)
  return http_dyn_gsup_spawn_count(sup)
end

def backpressure_body(): Int = 0

def main(): Int
  sched_init(2)
  var sup = http_dyn_gsup_new()
  sched_set_max_tasks(2)
  var blocker = async backpressure_probe(sup)
  sched_spawn(blocker)
  var child = http_dyn_gsup_spawn_one(sup, backpressure_body)
  sched_set_max_tasks(0)
  var observed = await blocker
  http_dyn_gsup_stop(sup)
  if child == 0 or observed != 1
    sched_shutdown()
    return 1
  end
  if http_dyn_gsup_spawn_count(sup) != 1 or http_dyn_gsup_completion_count(sup) != 1
    sched_shutdown()
    return 2
  end
  if http_dyn_gsup_alive(sup) != 0 or sched_task_count() != 0
    sched_shutdown()
    return 3
  end
  sched_shutdown()
  if sched_is_active() != 0
    return 4
  end
  puts("ALL OK")
  return 0
end
