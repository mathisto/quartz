# Test that E (second param) is correctly substituted, not T (first param)
# Before the fix, get_err would incorrectly return T instead of E

enum Result<T, E>
  Ok(value: T)
  Err(error: E)
end

def make_err(): Result<Int, Int>
  Result::Err(77)
end

def get_err<T, E>(r: Result<T, E>, fb: E): E
  match r
    Result::Ok(x) => fb
    Result::Err(e) => e
  end
end

def main(): Int
  err = make_err()
  
  # If fix is working, e should be 77 (from E position)
  e = get_err(err, 0)
  e
end
