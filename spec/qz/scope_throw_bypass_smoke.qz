## A.10 closure smoke for SCOPE_THROW_BYPASS_WITHOUT_SCOPE_WITH.
##
## Repros the PASS 0.99b auto-promotion gap that skipped scope_with's
## colorless promotion when the user's body fn was named anything other
## than "body" (matching scope_with's parameter name).
##
## Standalone (not qspec) for the same reason as scope_spawn_then_cancel_smoke
## — qspec describe/it inline-poll prevents real worker-thread spawn.

import * from std/sync/composition/scope
import * from std/throws

var s = 0
var cap_fired = 0
var caught_msg = ""

def cap(op_name: Int, argc: Int, argv: Int): Int
  cap_fired += 1
  caught_msg = as_type<String>(load(argv, 0))
  return 0
end

def child_inner(): Int
  scope_sleep_ms(5_000)
  return 0
end

def child(): Int
  with Throws { throw: cap } do ->
    scope_with(s, child_inner)
    0
  end
  return 0
end

## Body name DELIBERATELY not "body" — this is the failing shape from the
## bug doc. Pre-fix, PASS 0.99b couldn't see scope_with's `body()` call
## through the parameter (the user's "the_main" is never matched as the
## global "body"), so scope_with stayed synchronous and the throw chain
## broke at the sync/async boundary.
def the_main(): Int
  var h = go child()
  sched_sleep(50)
  scope_cancel_with(s, "parent-cancel")
  await h
  return 0
end

def main(): Int
  s = scope_with_cancel(scope_root())
  scope_with(s, the_main)
  if cap_fired != 1
    puts("FAIL: Throws handler did not fire (cap_fired=#{str_from_int(cap_fired)}, caught_msg='#{caught_msg}')")
    return 1
  end
  if caught_msg != "parent-cancel"
    puts("FAIL: expected throw msg 'parent-cancel', got '#{caught_msg}'")
    return 2
  end
  puts("OK: scope_with auto-promoted via Fn-typed param marker — throw chain works for any body fn name")
  return 0
end
