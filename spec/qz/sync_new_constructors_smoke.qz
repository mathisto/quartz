## spec/qz/sync_new_constructors_smoke.qz — D.10 Phase 1+2 verification.
##
## Verifies `Type.new()` canonical constructors for the synchronization
## primitives. Phase 1 (commit 4916079a): Mutex / RwLock / Spinlock /
## Channel. Phase 2 (this commit): AtomicInt / WaitGroup / OnceCell /
## CancelToken. Each constructor should be equivalent to its legacy
## free-function counterpart.
##
## Standalone smoke (not qspec) to avoid the spawn-inside-describe-lambda
## inline-poll path documented in CLAUDE.md "Spec authoring caveat".

import * from std/sync/exclusion/mutex
import * from std/sync/exclusion/rwlock
import * from std/sync/exclusion/spinlock
import * from std/sync/communication/channel
import * from std/sync/atomic/atomic_int
import * from std/sync/exclusion/waitgroup
import * from std/sync/composition/oncecell
import * from std/sync/composition/cancel_token
import * from std/sync/composition/scope

def main(): Int
  # ============================================================
  # Mutex.new(0)
  # ============================================================
  var m = Mutex.new(7)
  var m_observed = 0
  with m.lock do v ->
    m_observed = v
  end
  if m_observed != 7
    puts("FAIL: Mutex.new(7) — expected observed=7, got #{m_observed.to_s()}")
    return 1
  end
  puts("PASS: Mutex.new(7) acquired value 7")

  # ============================================================
  # RwLock.new(13)
  # ============================================================
  var rw = RwLock.new(13)
  var rw_read_observed = 0
  with rw.read do v ->
    rw_read_observed = v
  end
  if rw_read_observed != 13
    puts("FAIL: RwLock.new(13) — read expected 13, got #{rw_read_observed.to_s()}")
    return 2
  end
  puts("PASS: RwLock.new(13) read observed 13")

  # Write a new value, then read it back.
  with rw.write do v ->
    v = 21
  end
  with rw.read do v ->
    rw_read_observed = v
  end
  if rw_read_observed != 21
    puts("FAIL: RwLock.new write-back — expected 21, got #{rw_read_observed.to_s()}")
    return 3
  end
  puts("PASS: RwLock.new(13) write-back observed 21")

  # ============================================================
  # Spinlock.new()
  # ============================================================
  var s = Spinlock.new()
  if s.is_locked()
    puts("FAIL: Spinlock.new() initially locked")
    return 4
  end
  s.lock()
  if not s.is_locked()
    puts("FAIL: Spinlock after lock() not is_locked")
    return 5
  end
  s.unlock()
  if s.is_locked()
    puts("FAIL: Spinlock after unlock() still is_locked")
    return 6
  end
  # try_lock — should win on free lock, fail when held
  var first_try = s.try_lock()
  if not first_try
    puts("FAIL: Spinlock.try_lock() on free lock returned false")
    return 7
  end
  var second_try = s.try_lock()
  if second_try
    puts("FAIL: Spinlock.try_lock() on held lock returned true")
    return 8
  end
  s.unlock()
  puts("PASS: Spinlock.new() lock/unlock/try_lock/is_locked all green")

  # ============================================================
  # Channel.new(8) — bounded
  # ============================================================
  var ch: Channel = Channel.new(8)
  send(ch, 100)
  send(ch, 200)
  var first = recv(ch)
  var second = recv(ch)
  if first != 100 or second != 200
    puts("FAIL: Channel.new(8) send/recv — got #{first.to_s()}, #{second.to_s()}")
    return 9
  end
  ch.close()
  if not ch.closed()
    puts("FAIL: Channel.new(8) close() not observed by closed()")
    return 10
  end
  puts("PASS: Channel.new(8) send/recv/close all green")

  # ============================================================
  # Channel.new_unbounded()
  # ============================================================
  var chu: Channel = Channel.new_unbounded()
  send(chu, 42)
  var val = recv(chu)
  if val != 42
    puts("FAIL: Channel.new_unbounded() send/recv — got #{val.to_s()}")
    return 11
  end
  chu.close()
  puts("PASS: Channel.new_unbounded() works")

  # ============================================================
  # AtomicInt.new(0) — D.10 Phase 2
  # ============================================================
  var a = AtomicInt.new(0)
  if a.load() != 0
    puts("FAIL: AtomicInt.new(0) initial load — got #{a.load().to_s()}")
    return 12
  end
  a.add(7)
  if a.load() != 7
    puts("FAIL: AtomicInt.add(7) — load got #{a.load().to_s()}")
    return 13
  end
  a.store(42)
  if a.load() != 42
    puts("FAIL: AtomicInt.store(42) — load got #{a.load().to_s()}")
    return 14
  end
  var cas_won = a.cas(42, 100)
  if not cas_won
    puts("FAIL: AtomicInt.cas(42, 100) on matching value returned false")
    return 15
  end
  if a.load() != 100
    puts("FAIL: AtomicInt.cas(42, 100) — post-cas load got #{a.load().to_s()}")
    return 16
  end
  var cas_lost = a.cas(0, 999)
  if cas_lost
    puts("FAIL: AtomicInt.cas(0, 999) on non-matching value returned true")
    return 17
  end
  puts("PASS: AtomicInt.new(0) load/add/store/cas all green")

  # ============================================================
  # WaitGroup.new(N) — D.10 Phase 2
  # ============================================================
  # Single-threaded check: counter at 0 → wait() returns immediately.
  # Threading interactions are exercised by the existing concurrency
  # specs; this smoke just verifies the constructor + method dispatch.
  var wg = WaitGroup.new(2)
  wg.done()
  wg.done()
  wg.wait()
  puts("PASS: WaitGroup.new(2) done/done/wait all green")

  # ============================================================
  # OnceCell.new() — D.10 Phase 2
  # ============================================================
  var cell = OnceCell.new()
  var first = cell.get_or_init(_init_compute)
  if first != 84
    puts("FAIL: OnceCell.new().get_or_init — first call got #{first.to_s()}")
    return 18
  end
  var second = cell.get_or_init(_init_compute_alt)
  if second != 84
    puts("FAIL: OnceCell second get_or_init returned #{second.to_s()} (expected cached 84)")
    return 19
  end
  if cell.get() != 84
    puts("FAIL: OnceCell.get() after init — got #{cell.get().to_s()}")
    return 20
  end
  puts("PASS: OnceCell.new() get_or_init / get all green")

  # ============================================================
  # CancelToken.new() — D.10 Phase 2
  # ============================================================
  var tok = CancelToken.new()
  if tok.is_cancelled()
    puts("FAIL: CancelToken.new() initially cancelled")
    return 21
  end
  tok.cancel()
  if not tok.is_cancelled()
    puts("FAIL: CancelToken.cancel() — is_cancelled() still false")
    return 22
  end
  puts("PASS: CancelToken.new() cancel/is_cancelled all green")

  puts("D.10 Phase 1+2: all constructors green")
  return 0
end

## OnceCell init thunks. Top-level fns (not lambdas) so the wrapper
## passes a real Fn pointer; the second one only runs if `get_or_init`
## ever recomputes (it shouldn't — that would be a OnceCell bug).
def _init_compute(): Int = 84
def _init_compute_alt(): Int = 999
