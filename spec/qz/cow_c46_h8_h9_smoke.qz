# C4.6 (h8 + h9) standalone smoke — cow Map-value ownership + Option-unwrap readout.
# >16B (3-field) @value struct = cow-layout at gate 1.
#   h8 storage:      map.set(k, Triple{..}); map.get(k).unwrap() round-trips all 3 fields
#   h8/h9 independ.: r = map.get(k).unwrap(); r.a = 999 => stored value unchanged (read retained → make-unique fired)
#   h9 outlives:     r = map.get(k).unwrap(); map.free() => r still valid (r holds its own counted reference; no UAF)
# Run under ASan to confirm no use-after-free. INERT at gate 0 (no cow layout).

@value
struct Triple
  a: Int
  b: Int
  c: Int
end

def h8_storage_roundtrip(): Int
  var m = map_new<String, Triple>()
  m.set("k", Triple { a: 10, b: 20, c: 30 })
  var r = m.get("k").unwrap()
  if r.a != 10
    return 1
  end
  if r.b != 20
    return 2
  end
  if r.c != 30
    return 3
  end
  m.free()
  return 0
end

def h8_h9_independence(): Int
  var m = map_new<String, Triple>()
  m.set("k", Triple { a: 10, b: 20, c: 30 })
  var r = m.get("k").unwrap()
  r.a = 999
  # r mutation must NOT corrupt the stored value (read retained → rc>1 → make-unique on r.a write)
  var r2 = m.get("k").unwrap()
  if r2.a != 10
    return 1
  end
  if r.a != 999
    return 2
  end
  m.free()
  return 0
end

def h9_outlives_collection(): Int
  var m = map_new<String, Triple>()
  m.set("k", Triple { a: 7, b: 8, c: 9 })
  var r = m.get("k").unwrap()
  # Drop the map out from under r. r holds its own reference (h9 retain),
  # so the value buffer survives — no UAF.
  m.free()
  if r.a != 7
    return 1
  end
  if r.c != 9
    return 2
  end
  return 0
end

def main(): Int
  var rc = h8_storage_roundtrip()
  if rc != 0
    puts("FAIL h8_storage_roundtrip")
    return rc
  end
  puts("PASS h8_storage_roundtrip")
  rc = h8_h9_independence()
  if rc != 0
    puts("FAIL h8_h9_independence")
    return 10 + rc
  end
  puts("PASS h8_h9_independence")
  rc = h9_outlives_collection()
  if rc != 0
    puts("FAIL h9_outlives_collection")
    return 20 + rc
  end
  puts("PASS h9_outlives_collection")
  puts("ALL PASS")
  return 0
end
