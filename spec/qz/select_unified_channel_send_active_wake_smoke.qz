## C.13.6 kind-tag flip: SendSelectable active-wake smoke.
##
## This is the mirror of select_unified_channel_recv_active_wake_smoke —
## it validates the WRITE side of the kind-tagged waker registry.
##
## Pre-kind-tag (shared `@ch` key): SendSelectable.register_waker wrote
## to `@ch`. Every send on the channel woke its own SendSelectable arms
## spuriously. recv woke RecvSelectable arms spuriously.
##
## Post-kind-tag (split `@ch` / `@ch | 1` keys): SendSelectable writes
## to `@ch | 1`. Only recv / try_recv / try_recv_or_closed / close
## notify on `@ch | 1`. Send-side ops notify `@ch`, so a SendSelectable
## parked on a full channel waits cleanly until a recv frees a slot.
##
## Scenario:
##   1. Main fills a capacity-2 channel (no recv-side arms registered).
##   2. Main goes into select with `sendable(ch, 99)` as the arm.
##   3. Worker sleeps 50ms, then recv's one value (freeing one slot).
##   4. recv's notify_all(@ch | 1) wakes main's parked SendSelectable.
##   5. main's try_poll runs try_send, succeeds (slot just freed).
##   6. Assert recv→arm-fires latency < 30ms. Pre-kind-tag would still
##      pass (shared key would also have woken main), but this proves
##      the kind-tagged routing is in fact reaching the write-waiter.
##
## Standalone (not qspec): same rationale as the mutex_try / signal /
## recv_active_wake smokes — qspec lambdas treat `go fn()` as Future
## created+polled inline.

import * from std/sync/communication/channel
import * from std/sync/composition/scope

var ch_handle: Int = 0
var worker_recvd_ns: Int = 0

def worker(): Int
  # Wait, then drain ONE value from the buffer to free a slot.
  sched_sleep(50)
  worker_recvd_ns = time_mono_ns()
  var v = recv(ch_handle)
  return v
end

def main(): Int
  # cap=2 channel. Fill it so the SendSelectable will park.
  var ch = channel_new(2)
  ch_handle = ch
  send(ch, 10)
  send(ch, 20)

  var w = go worker()

  var arm_fired_ns = 0
  var deadline_fired = 0

  select
    case _ = sendable(ch, 99) =>
      arm_fired_ns = time_mono_ns()
    case _ = deadline_ms(1000) =>
      arm_fired_ns = time_mono_ns()
      deadline_fired = 1
  end

  if deadline_fired == 1
    puts("FAIL: deadline_ms(1000) fired before sendable — recv→write-waiter routing broken?")
    return 1
  end

  # Latency from worker's recv (slot freed) to main observing the arm fire.
  var latency_ms = (arm_fired_ns - worker_recvd_ns) / 1_000_000
  if latency_ms < 0
    puts("FAIL: negative latency #{str_from_int(latency_ms)}ms (clock skew?)")
    return 2
  end
  if latency_ms > 30
    puts("FAIL: recv->arm latency #{str_from_int(latency_ms)}ms exceeds 30ms bound (kind-tagged write-waiter not woken?)")
    return 3
  end

  puts("OK: recv->arm latency #{str_from_int(latency_ms)}ms (kind-tagged write-waiter fired)")
  return 0
end
