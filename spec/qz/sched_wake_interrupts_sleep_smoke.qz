## B.7 Phase 4e.8 Layer A smoke test: sched_wake interrupts sched_sleep.
## Pre-fix: parker slept full 2000ms despite wake at ~100ms.
## Post-fix: parker wakes within ~50ms of the sched_wake call.

def parker(): Int
  var t0 = time_mono_ns()
  sched_sleep(2000)
  var elapsed_ms = (time_mono_ns() - t0) / 1_000_000
  if elapsed_ms < 200
    puts("OK: parker woke after #{str_from_int(elapsed_ms)}ms (interrupted)")
    return 0
  end
  puts("FAIL: parker slept #{str_from_int(elapsed_ms)}ms (NOT interrupted)")
  return 1
end

def waker(victim_frame: Int): Int
  sched_sleep(100)
  sched_wake(victim_frame)
  return 0
end

def main(): Int
  var p = go parker()
  sched_sleep(50)
  var p_frame = as_int_generic(p)
  var w = go waker(p_frame)
  await p
  await w
  return 0
end
