## R2.1 (B3) — union widening at non-let coercion sites.
## VERIFIED here: RETURN (site 1) + CALL-ARG (site 2) + passthrough (no double-widen).
## Each widened value is recovered via B2 narrowing on an IDENT/param subject.
##   ret_u()      widens the returned bare Int into the Int|String return slot.
##   take_u(9)    widens the bare Int arg into the Int|String param, then narrows it.
##   passthrough  forwards an ALREADY-union param — must NOT double-widen.
## Sum: 7 (return) + 9 (call-arg) + 9 (passthrough) = 25.
##
## FIELD-STORE (site 3a) and ELEMENT-STORE (site 3b) widens ALSO land (the tagged
## cell is built + stored correctly — verified in IR), but their round-trip is blocked
## on B2 narrowing-completeness for NON-IDENT subjects (field-access `s.u`, element
## `v[i]`) which currently recover the cell pointer instead of payload@1; and vec_push
## of a bare arm into Vec<union> is rejected at typecheck (QZ0200). Both filed as
## follow-ons — see ledger.

def ret_u(): Int | String
  return 7
end

def take_u(x: Int | String): Int
  if x is Int
    return x
  end
  return -1
end

def passthrough(x: Int | String): Int
  return take_u(x)
end

def main(): Int
  var total = 0

  var r = ret_u()          # site 1: return-widen
  if r is Int
    total = total + r      # +7
  else
    return 1
  end

  var a = take_u(9)        # site 2: call-arg widen + narrow inside take_u
  if a == 9
    total = total + a      # +9
  else
    return 2
  end

  var p = passthrough(9)   # site 2: passthrough, no double-widen
  if p == 9
    total = total + p      # +9
  else
    return 3
  end

  puts("total #{str_from_int(total)}")
  return total
end
