# QZ1216 false-reject repro: reading a Copy-type field of `self` inside a
# `drop(self)` body and passing it to a call must NOT be rejected as a moved
# field. Int/Bool/... fields are COPIED by the read, not moved.
#
# BEFORE the fix: `error[QZ1216]: Use of moved field 'self.x'` on the second
# call-argument read of self.x.
# AFTER the fix: compiles + runs, prints the field twice, exits 0.

trait Drop
  def drop(self): Void
end

def show_int(n: Int): Void
  puts(n.to_s())
end

struct Widget
  x: Int
  flag: Bool
end

extend Widget with Drop
  def drop(self): Void
    # Two separate call-argument reads of Copy fields — the second read is the
    # one that historically tripped the bogus partial-move.
    show_int(self.x)
    show_int(self.x)
    puts(self.flag.to_s())
  end
end

def main(): Int
  var w = Widget { x: 42, flag: true }
  # w drops at end of scope, running drop(self) above.
  return 0
end
