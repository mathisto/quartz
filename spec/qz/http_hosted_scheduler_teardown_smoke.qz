## Hosted HTTP scheduler teardown regression. One total monotonic deadline is
## shared by supervisor drain and forced scheduler containment.

import * from std/net/http_dynamic_goroutine_sup
import * from std/net/http_server

extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt

def teardown_stuck(): Int
  sched_sleep(10000)
  return 0
end

def main(): Int
  sched_init(4)
  var blocked = http_dyn_gsup_new()
  var deadline_ms = _http_shutdown_deadline_ms(40)
  http_dyn_gsup_set_drain_timeout(blocked, _http_shutdown_remaining_ms(deadline_ms))
  # Publish a direct suspended task so this regression does not depend on the
  # closure-wrapper inline-poll caveat exercised separately by supervisor specs.
  var child = async teardown_stuck()
  _hdgs_lock(blocked.children_lock)
  blocked.children.push(child)
  blocked.spawn_count = 1
  _hdgs_unlock(blocked.children_lock)
  sched_spawn(child)
  var shutdown_started_ns = time_mono_ns()
  http_dyn_gsup_stop(blocked)
  write(1, string_to_cstr("STOP RETURNED\n"), 14)
  var forced_result = sched_shutdown_graceful(_http_shutdown_remaining_ms(deadline_ms))
  write(1, string_to_cstr("GRACEFUL RETURNED\n"), 18)
  sched_shutdown()
  write(1, string_to_cstr("SHUTDOWN RETURNED\n"), 18)
  var shutdown_elapsed_ms = (time_mono_ns() - shutdown_started_ns) / 1000000
  # Forced shutdown currently abandons suspended frames without unwinding them.
  # Assert containment only, never child completion or destructor cleanup.
  if forced_result != 1 or sched_is_active() != 0
    return 2
  end
  if shutdown_elapsed_ms > 250
    return 3
  end

  puts("ALL OK")
  return 0
end
