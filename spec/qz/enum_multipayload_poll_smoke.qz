## Multi-payload enum niche — async-suspend round-trip smoke (RFC §4 save-set
## soundness). SPILL-PATH-UNTIL-FLIP: runs under the tagged-box path today (gate
## mir_boxed_niche_multi_payload_live() == 0); locks behavior for the flip.
##
## A niche-multi enum value (the M1 2-boxed Result `Res`) is, post-flip, a SINGLE
## i64 word (`payload_ptr | tag`) — never a (pointer-alloca, tag-alloca) pair (the
## §4 / RFC ratification-question-7 HARD INVARIANT). When such a value is live
## across a `$poll` suspend and saved to the generator heap frame, the save-set
## spills the VALUE (the whole packed word), not a now-dangling pointer
## interpretation. This smoke constructs a Res, holds it across a sched_yield/
## sched_sleep suspend inside a real worker spawn (per the CLAUDE.md qspec-lambda
## go-fn caveat — qspec lambdas poll inline on the calling thread, so the worker-
## suspend pattern needs a standalone `def main` with a real `go`), then reads the
## variant + payload back after the resume and asserts they survived.
##
## Exit 0 = the variant tag AND the boxed payload field both survived the suspend
## for BOTH variants. Non-zero = a save-set / niche round-trip failure.

struct NodeA
  a: Int
end
struct NodeB
  b: Int
end

enum Res
  Ok(n: NodeA)
  Err(e: NodeB)
end

def res_code(r: Res): Int
  return match r
    Ok(n) => n.a
    Err(e) => 0 - e.b
  end
end

## Worker: build an Ok, suspend (the Res is live across the yield/sleep), then read
## it back. If the save-set spilled a stale pointer instead of the packed word the
## payload field read would be garbage / segfault.
def ok_worker(): Int
  var r = Res::Ok(NodeA { a: 4242 })
  sched_sleep(40)
  if (r is Ok) != 1
    return 1
  end
  if res_code(r) != 4242
    return 2
  end
  return 0
end

## Worker: same for the Err variant (the tag-bearing arm — post-flip its word is
## `ptr | 1`, so the suspend must preserve the low tag bit too).
def err_worker(): Int
  var r = Res::Err(NodeB { b: 77 })
  sched_sleep(40)
  if (r is Err) != 1
    return 3
  end
  if res_code(r) != (0 - 77)
    return 4
  end
  return 0
end

def main(): Int
  var w1 = go ok_worker()
  var w2 = go err_worker()
  var rc1 = await w1
  var rc2 = await w2
  var rc = as_int_generic(rc1) + as_int_generic(rc2)
  if rc == 0
    puts("OK: niche-multi Res survived suspend for both variants")
    return 0
  end
  puts("FAIL: niche-multi Res suspend round-trip rc=#{str_from_int(rc)}")
  return rc
end
