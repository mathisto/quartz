# NET.2 — Ed25519 + SHA-512 KAT runner.
#
# Standalone smoke driven from `quake crypto:smoke` after the existing
# Curve25519 / BLAKE2s / etc. checks. Verifies:
#
#  - SHA-512 against FIPS 180-4 §D vectors (5 cases).
#  - Ed25519 against RFC 8032 §7.1 test vectors (4 cases: TEST 1/2/3/SHA(abc)).
#    Each vector exercises secret_to_public + sign + verify-self + verify-rfc;
#    non-empty messages additionally test tamper rejection.
#
# Format mirrors spec/qz/crypto_ffi_smoke.qz so the smoke runners share idiom.

import * from ffi/socket
import * from std/core/crypto/secret  # Secret<Int> + secret_wrap (NET.4.1)
import * from std/core/crypto/sha512
import * from std/core/crypto/ed25519

def nibble_to_hex(n: Int): String
  if n < 10
    return n.to_s()
  end
  if n == 10 then return "a" end
  if n == 11 then return "b" end
  if n == 12 then return "c" end
  if n == 13 then return "d" end
  if n == 14 then return "e" end
  return "f"
end

def byte_to_hex(b: Int): String
  var sb = sb_new()
  sb_append(sb, nibble_to_hex(b / 16))
  sb_append(sb, nibble_to_hex(b & 15))
  return sb_to_string(sb)
end

def hex_format(p: Int, len: Int): String
  var sb = sb_new()
  var i = 0
  while i < len
    sb_append(sb, byte_to_hex(ptr_read_byte(p + i)))
    i += 1
  end
  return sb_to_string(sb)
end

def hex_nibble(c: Int): Int
  if (c >= 48) & (c <= 57) then return c - 48 end
  if (c >= 97) & (c <= 102) then return c - 97 + 10 end
  return c - 65 + 10
end

def hex_decode(hex: String): Int
  var n = str_byte_len(hex) / 2
  var buf = malloc(if n == 0 then 1 else n end)
  var i = 0
  while i < n
    var hi = hex_nibble(str_byte_at(hex, i * 2))
    var lo = hex_nibble(str_byte_at(hex, i * 2 + 1))
    ptr_write_byte(buf + i, (hi << 4) | lo)
    i += 1
  end
  return buf
end

def str_to_bytes(s: String): Int
  var n = str_byte_len(s)
  var p = malloc(if n == 0 then 1 else n end)
  var i = 0
  while i < n
    ptr_write_byte(p + i, str_byte_at(s, i))
    i += 1
  end
  return p
end

# Global passed / total trackers.
var g_total: Int = 0
var g_passed: Int = 0

def check_eq(label: String, got: String, want: String): Void
  g_total = g_total + 1
  if got == want
    g_passed = g_passed + 1
    puts("OK   " + label)
    return
  end
  puts("FAIL " + label)
  puts("       got:  " + got)
  puts("       want: " + want)
end

def check_true(label: String, cond: Int): Void
  g_total = g_total + 1
  if cond == 1
    g_passed = g_passed + 1
    puts("OK   " + label)
    return
  end
  puts("FAIL " + label)
end

# =============================================================================
# SHA-512 (FIPS 180-4 §D)
# =============================================================================

def test_sha512(): Void
  puts("--- SHA-512 ---")
  var out = malloc(64)

  var s = str_to_bytes("abc")
  sha512(s, 3, out)
  check_eq(
    "FIPS 180-4 'abc'",
    hex_format(out, 64),
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
  )
  free(s)

  var empty = malloc(1)
  sha512(empty, 0, out)
  check_eq(
    "empty",
    hex_format(out, 64),
    "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
  )
  free(empty)

  var s56 = str_to_bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  sha512(s56, 56, out)
  check_eq(
    "56-byte ABC",
    hex_format(out, 64),
    "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445"
  )
  free(s56)

  var s112 = str_to_bytes("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
  sha512(s112, 112, out)
  check_eq(
    "112-byte two-block",
    hex_format(out, 64),
    "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"
  )
  free(s112)

  # Streaming = one-shot equivalence on "abc".
  var ctx = sha512_new()
  var b = malloc(1)
  ptr_write_byte(b, 97); sha512_update(ctx, b, 1)
  ptr_write_byte(b, 98); sha512_update(ctx, b, 1)
  ptr_write_byte(b, 99); sha512_update(ctx, b, 1)
  sha512_finalize(ctx, out)
  free(b)
  check_eq(
    "streaming == one-shot",
    hex_format(out, 64),
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
  )

  free(out)
end

# =============================================================================
# Ed25519 (RFC 8032 §7.1)
# =============================================================================

def check_ed25519(label: String, priv_hex: String, pub_hex: String, msg_hex: String, sig_hex: String): Void
  var priv = hex_decode(priv_hex)
  var want_pub = hex_decode(pub_hex)
  var msg_len = str_byte_len(msg_hex) / 2
  var msg = hex_decode(msg_hex)
  var want_sig = hex_decode(sig_hex)

  # NET.4.1: seed (priv) wrapped once at the boundary; same Secret<Int> handle
  # flows into both ed25519_secret_to_public and ed25519_sign.
  var priv_secret: Secret<Int> = secret_wrap(priv)
  var got_pub = malloc(32)
  ed25519_secret_to_public(got_pub, priv_secret)
  check_eq(label + " pubkey", hex_format(got_pub, 32), pub_hex)

  var got_sig = malloc(64)
  ed25519_sign(got_sig, msg, msg_len, priv_secret, got_pub)
  check_eq(label + " sign",   hex_format(got_sig, 64), sig_hex)

  check_true(label + " verify-self", ed25519_verify(got_sig, msg, msg_len, got_pub))
  check_true(label + " verify-rfc",  ed25519_verify(want_sig, msg, msg_len, want_pub))

  if msg_len > 0
    var msg_bad = malloc(msg_len)
    memcpy(msg_bad, msg, msg_len)
    ptr_write_byte(msg_bad, ptr_read_byte(msg_bad) ^ 1)
    var rej = if ed25519_verify(want_sig, msg_bad, msg_len, want_pub) == 0 then 1 else 0 end
    check_true(label + " reject-tampered-msg", rej)
    free(msg_bad)
  end

  # Tamper signature: bit-flip last byte of S; verify must reject.
  var sig_bad = malloc(64)
  memcpy(sig_bad, want_sig, 64)
  ptr_write_byte(sig_bad + 63, ptr_read_byte(sig_bad + 63) ^ 1)
  var rej2 = if ed25519_verify(sig_bad, msg, msg_len, want_pub) == 0 then 1 else 0 end
  check_true(label + " reject-tampered-sig", rej2)
  free(sig_bad)

  free(priv); free(want_pub); free(msg); free(want_sig); free(got_pub); free(got_sig)
end

def test_ed25519(): Void
  puts("")
  puts("--- Ed25519 ---")

  # RFC 8032 §7.1 TEST 1 — empty message.
  check_ed25519(
    "TEST 1",
    "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
    "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
    "",
    "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155" + "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
  )

  # RFC 8032 §7.1 TEST 2 — single-byte message.
  check_ed25519(
    "TEST 2",
    "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
    "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
    "72",
    "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da" + "085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
  )

  # RFC 8032 §7.1 TEST 3 — two-byte message.
  check_ed25519(
    "TEST 3",
    "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
    "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
    "af82",
    "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac" + "18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
  )

  # RFC 8032 §7.1 TEST SHA(abc) — 64-byte message (SHA-512 of "abc").
  check_ed25519(
    "TEST SHA(abc)",
    "833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42",
    "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf",
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" + "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b589" + "09351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704"
  )

  # Edge case: S >= L (non-canonical scalar) — verify must reject.
  # Build a sig with the L bytes as S: 64 bytes = (any 32 R) || (L_bytes_as_S).
  var bogus_sig = malloc(64)
  memset(bogus_sig, 0, 64)
  ptr_write_byte(bogus_sig + 0,  237)   # R = anything; bytes 32..64 = L.
  # Bytes 32..64 = L (the group order, which is NOT a valid scalar).
  ptr_write_byte(bogus_sig + 32, 237)
  ptr_write_byte(bogus_sig + 33, 211)
  ptr_write_byte(bogus_sig + 34, 245)
  ptr_write_byte(bogus_sig + 35, 92)
  ptr_write_byte(bogus_sig + 36, 26)
  ptr_write_byte(bogus_sig + 37, 99)
  ptr_write_byte(bogus_sig + 38, 18)
  ptr_write_byte(bogus_sig + 39, 88)
  ptr_write_byte(bogus_sig + 40, 214)
  ptr_write_byte(bogus_sig + 41, 156)
  ptr_write_byte(bogus_sig + 42, 247)
  ptr_write_byte(bogus_sig + 43, 162)
  ptr_write_byte(bogus_sig + 44, 222)
  ptr_write_byte(bogus_sig + 45, 249)
  ptr_write_byte(bogus_sig + 46, 222)
  ptr_write_byte(bogus_sig + 47, 20)
  ptr_write_byte(bogus_sig + 63, 16)
  var pub_test1 = hex_decode("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
  var rej_nc = if ed25519_verify(bogus_sig, 0, 0, pub_test1) == 0 then 1 else 0 end
  check_true("non-canonical S rejected", rej_nc)
  free(bogus_sig); free(pub_test1)
end

def main(): Int
  test_sha512()
  test_ed25519()

  puts("")
  puts(to_str(g_passed) + "/" + to_str(g_total) + " checks green")
  if g_passed == g_total then return 0 end
  return 1
end
