# NET.5c.0 — SHA-256 + SHA-384 + HMAC + HKDF KAT runner.
#
# Standalone smoke driven from `quake sha2:smoke`. Verifies:
#
#   1. SHA-256 — FIPS 180-2 §D.1 single-block + multi-block KAT
#   2. SHA-384 — FIPS 180-2 §D.3 single-block + multi-block KAT
#   3. SHA-256 streaming = one-shot equivalence
#   4. HMAC-SHA-256 — RFC 4231 §4 test cases 1, 2, 3, 4
#   5. HMAC-SHA-384 — RFC 4231 §4 same test cases
#   6. HKDF-SHA-256 — RFC 5869 §A.1 (basic + ASCII inputs)
#   7. HKDF-SHA-384 — derived KAT (RFC 5869 §A doesn't include SHA-384;
#      we verify against a re-derived expected via our own substrate
#      consistency check)
#
# Format mirrors spec/qz/tls_handshake_smoke.qz.

import * from ffi/socket
import * from std/core/crypto/secret
import * from std/core/crypto/sha256
import * from std/core/crypto/sha384
import * from std/core/crypto/hmac
import * from std/core/crypto/hkdf

# =============================================================================
# Hex + buffer helpers
# =============================================================================

def nibble_to_hex(n: Int): String
  if n < 10 then return n.to_s() end
  if n == 10 then return "a" end
  if n == 11 then return "b" end
  if n == 12 then return "c" end
  if n == 13 then return "d" end
  if n == 14 then return "e" end
  return "f"
end

def byte_to_hex(b: Int): String
  var sb = sb_new()
  sb_append(sb, nibble_to_hex(b / 16))
  sb_append(sb, nibble_to_hex(b & 15))
  return sb_to_string(sb)
end

def hex_format(p: Int, len: Int): String
  var sb = sb_new()
  var i = 0
  while i < len
    sb_append(sb, byte_to_hex(ptr_read_byte(p + i)))
    i = i + 1
  end
  return sb_to_string(sb)
end

def hex_nibble(c: Int): Int
  if (c >= 48) & (c <= 57) then return c - 48 end
  if (c >= 97) & (c <= 102) then return c - 97 + 10 end
  return c - 65 + 10
end

def hex_decode(hex: String): Int
  var n = str_byte_len(hex) / 2
  var buf = malloc(if n == 0 then 1 else n end)
  var i = 0
  while i < n
    var hi = hex_nibble(str_byte_at(hex, i * 2))
    var lo = hex_nibble(str_byte_at(hex, i * 2 + 1))
    ptr_write_byte(buf + i, (hi << 4) | lo)
    i = i + 1
  end
  return buf
end

def hex_len(hex: String): Int = str_byte_len(hex) / 2

# Make a buffer from an ASCII string. Returns (buf, len) via separate calls.
def str_to_buf(s: String): Int
  var n = str_byte_len(s)
  var buf = malloc(if n == 0 then 1 else n end)
  var i = 0
  while i < n
    ptr_write_byte(buf + i, str_byte_at(s, i))
    i = i + 1
  end
  return buf
end

# =============================================================================
# Trackers
# =============================================================================

var g_total: Int = 0
var g_passed: Int = 0

def check_eq(label: String, got: String, want: String): Void
  g_total = g_total + 1
  if got == want
    g_passed = g_passed + 1
    puts("OK   " + label)
    return
  end
  puts("FAIL " + label)
  puts("       got:  " + got)
  puts("       want: " + want)
end

# =============================================================================
# 1. SHA-256 KAT
# =============================================================================

def test_sha256_kat(): Void
  puts("--- SHA-256 KAT ---")

  var out = malloc(32)

  # Empty input.
  sha256(0, 0, out)
  check_eq("sha256(\"\")", hex_format(out, 32),
           "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

  # "abc"
  var abc = str_to_buf("abc")
  sha256(abc, 3, out)
  check_eq("sha256(\"abc\")", hex_format(out, 32),
           "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  free(abc)

  # 56-byte input (forces a 2-block compression).
  var s56 = str_to_buf("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
  sha256(s56, 56, out)
  check_eq("sha256(56-byte abc-string)", hex_format(out, 32),
           "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  free(s56)

  free(out)
end

# Streaming == one-shot equivalence on the same input.
def test_sha256_streaming(): Void
  puts("--- SHA-256 streaming ---")

  # Feed "abc" as three separate 1-byte updates.
  var ctx = sha256_new()
  var a = str_to_buf("a")
  var b = str_to_buf("b")
  var c = str_to_buf("c")
  sha256_update(ctx, a, 1)
  sha256_update(ctx, b, 1)
  sha256_update(ctx, c, 1)
  var out = malloc(32)
  sha256_finalize(ctx, out)
  check_eq("streaming \"abc\" = one-shot", hex_format(out, 32),
           "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  free(a); free(b); free(c); free(out)
end

# =============================================================================
# 2. SHA-384 KAT
# =============================================================================

def test_sha384_kat(): Void
  puts("--- SHA-384 KAT ---")

  var out = malloc(48)

  sha384(0, 0, out)
  check_eq("sha384(\"\")", hex_format(out, 48),
           "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")

  var abc = str_to_buf("abc")
  sha384(abc, 3, out)
  check_eq("sha384(\"abc\")", hex_format(out, 48),
           "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
  free(abc)

  # 112-byte multi-block input.
  var s = str_to_buf("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
  sha384(s, 112, out)
  check_eq("sha384(112-byte)", hex_format(out, 48),
           "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
  free(s)

  free(out)
end

# =============================================================================
# 3. HMAC-SHA-256 KAT (RFC 4231 §4.2-4.4)
# =============================================================================

def test_hmac_sha256(): Void
  puts("--- HMAC-SHA-256 KAT ---")
  var out = malloc(32)

  # TC1: key = 0x0b * 20, data = "Hi There" (8 bytes)
  var k1 = malloc(20)
  var i = 0
  while i < 20
    ptr_write_byte(k1 + i, 0x0b)
    i = i + 1
  end
  var d1 = str_to_buf("Hi There")
  hmac_sha256(k1, 20, d1, 8, out)
  check_eq("HMAC-SHA-256 TC1", hex_format(out, 32),
           "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
  free(k1); free(d1)

  # TC2: key = "Jefe", data = "what do ya want for nothing?"
  var k2 = str_to_buf("Jefe")
  var d2 = str_to_buf("what do ya want for nothing?")
  hmac_sha256(k2, 4, d2, 28, out)
  check_eq("HMAC-SHA-256 TC2", hex_format(out, 32),
           "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  free(k2); free(d2)

  # TC3: key = 0xaa × 20, data = 0xdd × 50
  var k3 = malloc(20)
  i = 0
  while i < 20
    ptr_write_byte(k3 + i, 0xaa)
    i = i + 1
  end
  var d3 = malloc(50)
  i = 0
  while i < 50
    ptr_write_byte(d3 + i, 0xdd)
    i = i + 1
  end
  hmac_sha256(k3, 20, d3, 50, out)
  check_eq("HMAC-SHA-256 TC3", hex_format(out, 32),
           "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
  free(k3); free(d3)

  # TC4: key = 0x01..0x19 (25 bytes), data = 0xcd × 50
  var k4 = malloc(25)
  i = 0
  while i < 25
    ptr_write_byte(k4 + i, i + 1)
    i = i + 1
  end
  var d4 = malloc(50)
  i = 0
  while i < 50
    ptr_write_byte(d4 + i, 0xcd)
    i = i + 1
  end
  hmac_sha256(k4, 25, d4, 50, out)
  check_eq("HMAC-SHA-256 TC4", hex_format(out, 32),
           "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
  free(k4); free(d4)

  free(out)
end

# =============================================================================
# 4. HMAC-SHA-384 KAT (RFC 4231 §4.2-4.4)
# =============================================================================

def test_hmac_sha384(): Void
  puts("--- HMAC-SHA-384 KAT ---")
  var out = malloc(48)

  # TC1 same inputs as HMAC-SHA-256 TC1.
  var k1 = malloc(20)
  var i = 0
  while i < 20
    ptr_write_byte(k1 + i, 0x0b)
    i = i + 1
  end
  var d1 = str_to_buf("Hi There")
  hmac_sha384(k1, 20, d1, 8, out)
  check_eq("HMAC-SHA-384 TC1", hex_format(out, 48),
           "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
  free(k1); free(d1)

  # TC2
  var k2 = str_to_buf("Jefe")
  var d2 = str_to_buf("what do ya want for nothing?")
  hmac_sha384(k2, 4, d2, 28, out)
  check_eq("HMAC-SHA-384 TC2", hex_format(out, 48),
           "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
  free(k2); free(d2)

  # TC3
  var k3 = malloc(20)
  i = 0
  while i < 20
    ptr_write_byte(k3 + i, 0xaa)
    i = i + 1
  end
  var d3 = malloc(50)
  i = 0
  while i < 50
    ptr_write_byte(d3 + i, 0xdd)
    i = i + 1
  end
  hmac_sha384(k3, 20, d3, 50, out)
  check_eq("HMAC-SHA-384 TC3", hex_format(out, 48),
           "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27")
  free(k3); free(d3)

  free(out)
end

# =============================================================================
# 5. HKDF-SHA-256 KAT (RFC 5869 §A.1)
# =============================================================================

def test_hkdf_sha256(): Void
  puts("--- HKDF-SHA-256 KAT ---")

  # A.1: Basic test case with SHA-256.
  # IKM  = 0x0b × 22
  # salt = 0x000102030405060708090a0b0c (13 bytes)
  # info = 0xf0f1f2f3f4f5f6f7f8f9 (10 bytes)
  # L = 42
  # PRK = 077709362c2e32df0ddc3f0dc47bba63 90b6c73bb50f9c3122ec844ad7c2b3e5
  # OKM = 3cb25f25faacd57a90434f64d0362f2a 2d2d0a90cf1a5a4c5db02d56ecc4c5bf 34007208d5b887185865
  var ikm = malloc(22)
  var i = 0
  while i < 22
    ptr_write_byte(ikm + i, 0x0b)
    i = i + 1
  end
  var salt = hex_decode("000102030405060708090a0b0c")
  var info = hex_decode("f0f1f2f3f4f5f6f7f8f9")
  var prk = malloc(32)
  hkdf_extract_sha256(prk, salt, 13, secret_wrap<Int>(ikm), 22)
  check_eq("HKDF-SHA256 A.1 PRK", hex_format(prk, 32),
           "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")

  var okm = malloc(42)
  hkdf_expand_sha256(okm, secret_wrap<Int>(prk), info, 10, 42)
  check_eq("HKDF-SHA256 A.1 OKM", hex_format(okm, 42),
           "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
  free(okm); free(prk); free(info); free(salt); free(ikm)

  # A.2: longer inputs / outputs.
  # IKM  = 0x000102030405...4f (80 bytes)
  # salt = 0x606162...af (80)
  # info = 0xb0b1...ff (80)
  # L = 82
  # PRK = 06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244
  # OKM = b11e398dc80327a1c8e7f78c596a4934 4f012eda2d4efad8a050cc4c19afa97c 59045a99cac7827271cb41c65e590e09 da3275600c2f09b8367793a9aca3db71 cc30c58179ec3e87c14c01d5c1f3434f 1d87
  var ikm2 = malloc(80)
  i = 0
  while i < 80
    ptr_write_byte(ikm2 + i, i)
    i = i + 1
  end
  var salt2 = malloc(80)
  i = 0
  while i < 80
    ptr_write_byte(salt2 + i, 0x60 + i)
    i = i + 1
  end
  var info2 = malloc(80)
  i = 0
  while i < 80
    ptr_write_byte(info2 + i, 0xb0 + i)
    i = i + 1
  end
  var prk2 = malloc(32)
  hkdf_extract_sha256(prk2, salt2, 80, secret_wrap<Int>(ikm2), 80)
  check_eq("HKDF-SHA256 A.2 PRK", hex_format(prk2, 32),
           "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244")

  var okm2 = malloc(82)
  hkdf_expand_sha256(okm2, secret_wrap<Int>(prk2), info2, 80, 82)
  check_eq("HKDF-SHA256 A.2 OKM", hex_format(okm2, 82),
           "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87")
  free(okm2); free(prk2); free(info2); free(salt2); free(ikm2)

  # A.3: zero-length salt / info.
  # IKM  = 0x0b × 22
  # salt = (empty)
  # info = (empty)
  # L = 42
  # PRK = 19ef24a32c717b167f33a91d6f648bdf 96596776afdb6377ac434c1c293ccb04
  # OKM = 8da4e775a563c18f715f802a063c5a31 b8a11f5c5ee1879ec3454e5f3c738d2d 9d201395faa4b61a96c8
  var ikm3 = malloc(22)
  i = 0
  while i < 22
    ptr_write_byte(ikm3 + i, 0x0b)
    i = i + 1
  end
  var prk3 = malloc(32)
  hkdf_extract_sha256(prk3, 0, 0, secret_wrap<Int>(ikm3), 22)
  check_eq("HKDF-SHA256 A.3 PRK (empty salt)", hex_format(prk3, 32),
           "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")

  var okm3 = malloc(42)
  hkdf_expand_sha256(okm3, secret_wrap<Int>(prk3), 0, 0, 42)
  check_eq("HKDF-SHA256 A.3 OKM (empty info)", hex_format(okm3, 42),
           "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
  free(okm3); free(prk3); free(ikm3)
end

# =============================================================================
# 6. HKDF-SHA-384 consistency check
# =============================================================================
#
# RFC 5869 §A only specifies SHA-256 + SHA-1 vectors. For SHA-384 we verify
# substrate consistency: HKDF-Expand with N=1 (L ≤ 48) MUST equal HMAC-SHA-384
# (PRK, info || 0x01). This is the algorithm's literal definition.

def test_hkdf_sha384_consistency(): Void
  puts("--- HKDF-SHA-384 substrate consistency ---")

  var ikm = malloc(22)
  var i = 0
  while i < 22
    ptr_write_byte(ikm + i, 0x0b)
    i = i + 1
  end
  var info = hex_decode("f0f1f2f3f4f5f6f7f8f9")

  var prk = malloc(48)
  hkdf_extract_sha384(prk, 0, 0, secret_wrap<Int>(ikm), 22)

  # Expand to L=48 bytes — exactly N=1 iteration.
  var okm = malloc(48)
  hkdf_expand_sha384(okm, secret_wrap<Int>(prk), info, 10, 48)

  # Direct HMAC over (info || 0x01).
  var hmac_in = malloc(11)
  memcpy(hmac_in, info, 10)
  ptr_write_byte(hmac_in + 10, 0x01)
  var expected = malloc(48)
  hmac_sha384(prk, 48, hmac_in, 11, expected)

  check_eq("HKDF-SHA384 N=1 == HMAC(prk, info || 0x01)",
           hex_format(okm, 48), hex_format(expected, 48))

  # Expand to L=96 — N=2 iterations. T(1)||T(2) where T(i) = HMAC(prk, T(i-1)||info||i).
  var okm2 = malloc(96)
  hkdf_expand_sha384(okm2, secret_wrap<Int>(prk), info, 10, 96)

  # Compute T(1) and T(2) independently.
  var t1 = malloc(48)
  hmac_sha384(prk, 48, hmac_in, 11, t1)
  var t2_in = malloc(48 + 10 + 1)
  memcpy(t2_in, t1, 48)
  memcpy(t2_in + 48, info, 10)
  ptr_write_byte(t2_in + 58, 0x02)
  var t2 = malloc(48)
  hmac_sha384(prk, 48, t2_in, 59, t2)

  check_eq("HKDF-SHA384 L=96 T(1) matches", hex_format(okm2, 48), hex_format(t1, 48))
  check_eq("HKDF-SHA384 L=96 T(2) matches", hex_format(okm2 + 48, 48), hex_format(t2, 48))

  free(t2); free(t2_in); free(t1); free(expected); free(hmac_in); free(okm2); free(okm); free(prk); free(info); free(ikm)
end

# =============================================================================
# Entry point
# =============================================================================

def main(): Int
  test_sha256_kat()
  test_sha256_streaming()
  test_sha384_kat()
  test_hmac_sha256()
  test_hmac_sha384()
  test_hkdf_sha256()
  test_hkdf_sha384_consistency()

  puts("")
  puts(g_passed.to_s() + "/" + g_total.to_s() + " checks green")
  if g_passed == g_total then return 0 end
  return 1
end
