# NET.3a — SHA-3 family KAT runner.
#
# Standalone smoke driven from `quake sha3:smoke`. Verifies:
#
#  - SHA-3-256 against NIST CAVS vectors (empty, "abc", 200-byte 0xa3, "fox").
#  - SHA-3-512 against NIST CAVS vectors (empty, "abc").
#  - SHAKE128 / SHAKE256 against NIST FIPS 202 examples (empty input, fixed
#    output lengths).
#  - Streaming = one-shot equivalence on "abc" for all four variants.
#  - Multi-block absorb (200-byte 0xa3 spans >1 rate-block).
#
# Format mirrors spec/qz/ed25519_smoke.qz so the smoke runners share idiom.

import * from ffi/socket
import * from std/core/crypto/sha3

def nibble_to_hex(n: Int): String
  if n < 10
    return n.to_s()
  end
  if n == 10 then return "a" end
  if n == 11 then return "b" end
  if n == 12 then return "c" end
  if n == 13 then return "d" end
  if n == 14 then return "e" end
  return "f"
end

def byte_to_hex(b: Int): String
  var sb = sb_new()
  sb_append(sb, nibble_to_hex(b / 16))
  sb_append(sb, nibble_to_hex(b & 15))
  return sb_to_string(sb)
end

def hex_format(p: Int, len: Int): String
  var sb = sb_new()
  var i = 0
  while i < len
    sb_append(sb, byte_to_hex(ptr_read_byte(p + i)))
    i += 1
  end
  return sb_to_string(sb)
end

def str_to_bytes(s: String): Int
  var n = str_byte_len(s)
  var p = malloc(if n == 0 then 1 else n end)
  var i = 0
  while i < n
    ptr_write_byte(p + i, str_byte_at(s, i))
    i += 1
  end
  return p
end

# Global passed / total trackers.
var g_total: Int = 0
var g_passed: Int = 0

def check_eq(label: String, got: String, want: String): Void
  g_total = g_total + 1
  if got == want
    g_passed = g_passed + 1
    puts("OK   " + label)
    return
  end
  puts("FAIL " + label)
  puts("       got:  " + got)
  puts("       want: " + want)
end

# =============================================================================
# SHA-3-256 — NIST CAVS / FIPS 202 example vectors
# =============================================================================

def test_sha3_256(): Void
  puts("--- SHA-3-256 ---")
  var out = malloc(32)

  var empty = malloc(1)
  sha3_256(empty, 0, out)
  check_eq(
    "empty",
    hex_format(out, 32),
    "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"
  )
  free(empty)

  var s = str_to_bytes("abc")
  sha3_256(s, 3, out)
  check_eq(
    "'abc'",
    hex_format(out, 32),
    "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"
  )
  free(s)

  # 200-byte message of 0xa3 — exercises multi-block absorb (136 + 64 partial).
  var msg200 = malloc(200)
  memset(msg200, 163, 200)   # 0xa3 = 163
  sha3_256(msg200, 200, out)
  check_eq(
    "200×0xa3",
    hex_format(out, 32),
    "79f38adec5c20307a98ef76e8324afbfd46cfd81b22e3973c65fa1bd9de31787"
  )
  free(msg200)

  var fox = str_to_bytes("The quick brown fox jumps over the lazy dog")
  sha3_256(fox, 43, out)
  check_eq(
    "fox",
    hex_format(out, 32),
    "69070dda01975c8c120c3aada1b282394e7f032fa9cf32f4cb2259a0897dfc04"
  )
  free(fox)

  # Streaming = one-shot equivalence on "abc".
  var ctx = sha3_256_new()
  var b = malloc(1)
  ptr_write_byte(b, 97); sha3_256_update(ctx, b, 1)
  ptr_write_byte(b, 98); sha3_256_update(ctx, b, 1)
  ptr_write_byte(b, 99); sha3_256_update(ctx, b, 1)
  sha3_256_finalize(ctx, out)
  free(b)
  check_eq(
    "streaming == one-shot",
    hex_format(out, 32),
    "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"
  )

  free(out)
end

# =============================================================================
# SHA-3-512 — NIST CAVS / FIPS 202 example vectors
# =============================================================================

def test_sha3_512(): Void
  puts("")
  puts("--- SHA-3-512 ---")
  var out = malloc(64)

  var empty = malloc(1)
  sha3_512(empty, 0, out)
  check_eq(
    "empty",
    hex_format(out, 64),
    "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"
  )
  free(empty)

  var s = str_to_bytes("abc")
  sha3_512(s, 3, out)
  check_eq(
    "'abc'",
    hex_format(out, 64),
    "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
  )
  free(s)

  # Streaming = one-shot equivalence on "abc".
  var ctx = sha3_512_new()
  var b = malloc(1)
  ptr_write_byte(b, 97); sha3_512_update(ctx, b, 1)
  ptr_write_byte(b, 98); sha3_512_update(ctx, b, 1)
  ptr_write_byte(b, 99); sha3_512_update(ctx, b, 1)
  sha3_512_finalize(ctx, out)
  free(b)
  check_eq(
    "streaming == one-shot",
    hex_format(out, 64),
    "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
  )

  free(out)
end

# =============================================================================
# SHAKE128 — NIST FIPS 202 example
# =============================================================================

def test_shake128(): Void
  puts("")
  puts("--- SHAKE128 ---")
  var out64 = malloc(64)

  var empty = malloc(1)
  shake128(empty, 0, out64, 32)
  check_eq(
    "empty, 32B",
    hex_format(out64, 32),
    "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
  )

  # Squeeze 64 bytes — first 32 must match the 32-byte squeeze.
  shake128(empty, 0, out64, 64)
  check_eq(
    "empty, 64B (first 32 == 32B squeeze)",
    hex_format(out64, 32),
    "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
  )
  free(empty)

  # Streaming multi-squeeze: 16B + 16B should equal a single 32B squeeze.
  var ctx = shake128_new()
  var ones = malloc(1); ptr_write_byte(ones, 0)   # empty absorb (no-op for shake)
  shake128_finalize_absorb(ctx)
  var first16 = malloc(16)
  var second16 = malloc(16)
  shake128_squeeze(ctx, first16, 16)
  shake128_squeeze(ctx, second16, 16)
  shake128_free(ctx)
  memcpy(out64, first16, 16)
  memcpy(out64 + 16, second16, 16)
  check_eq(
    "streaming 16+16 == one-shot 32",
    hex_format(out64, 32),
    "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"
  )
  free(ones); free(first16); free(second16)

  free(out64)
end

# =============================================================================
# SHAKE256 — NIST FIPS 202 example
# =============================================================================

def test_shake256(): Void
  puts("")
  puts("--- SHAKE256 ---")
  var out = malloc(64)

  var empty = malloc(1)
  shake256(empty, 0, out, 64)
  check_eq(
    "empty, 64B",
    hex_format(out, 64),
    "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"
  )
  free(empty)

  # Streaming = one-shot equivalence on "abc".
  var ctx = shake256_new()
  var b = malloc(1)
  ptr_write_byte(b, 97); shake256_absorb(ctx, b, 1)
  ptr_write_byte(b, 98); shake256_absorb(ctx, b, 1)
  ptr_write_byte(b, 99); shake256_absorb(ctx, b, 1)
  shake256_finalize_absorb(ctx)
  var out2 = malloc(32)
  shake256_squeeze(ctx, out2, 32)
  shake256_free(ctx)
  free(b)

  var s = str_to_bytes("abc")
  var out_oneshot = malloc(32)
  shake256(s, 3, out_oneshot, 32)
  free(s)

  check_eq(
    "streaming == one-shot 'abc'",
    hex_format(out2, 32),
    hex_format(out_oneshot, 32)
  )
  free(out2); free(out_oneshot)

  free(out)
end

def main(): Int
  test_sha3_256()
  test_sha3_512()
  test_shake128()
  test_shake256()

  puts("")
  puts(to_str(g_passed) + "/" + to_str(g_total) + " checks green")
  if g_passed == g_total then return 0 end
  return 1
end
