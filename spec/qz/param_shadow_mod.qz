# Helper module for the param-shadow imported-module miscompile smoke.
#
# `foo` is a same-module free function. `check`/`Box.check` each take a PARAM
# named `foo` and return it. In an IMPORTED module the pass-2 rewrite used to
# rewrite the bareword `foo` (param) to the function-VALUE ref `mod$foo` — a
# code address — silently miscompiling the return to a huge pointer int.
# Innermost binding (the param) must win.

def foo(): Int = 99

# Free-function form.
def check(foo: Int): Int
  return foo
end

struct Box
  tag: Int
end

impl Box
  # Method form — param `foo` shadows the free function `foo`.
  def check_method(self, foo: Int): Int
    return foo
  end
end
