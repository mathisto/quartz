## GAP-B1 — aliased-condition narrowing. A const boolean bound to a guard
## (`c = opt.some?`) used as an `if` condition (`if c`) must narrow the subject
## `opt` inside the branch, exactly as `if opt.some?` would. Before B1 the
## classifier bails on the NODE_IDENT condition -> `opt` stays Option<Int> and the
## bare read is not payload-extracted.
##
## Compile + run:
##   ./self-hosted/bin/quartz spec/qz/gap_b1_aliased_condition_smoke.qz > /tmp/b1.ll
##   llc /tmp/b1.ll -filetype=obj -o /tmp/b1.o
##   clang /tmp/b1.o -o /tmp/b1 -lm -lpthread && /tmp/b1; echo "exit=$?"
## Expected: prints "aliased narrow 7" and exits 7.

def aliased_narrow(): Int
  opt: Option<Int> = option_some(7)   # const subject (const-by-default)
  c = opt.some?             # const alias to the guard boolean
  if c
    puts("aliased narrow #{str_from_int(opt)}")   # opt reads as inner Int (7)
    return opt
  end
  puts("FAIL: aliased condition did not narrow")
  return 99
end

def main(): Int
  return aliased_narrow()
end
