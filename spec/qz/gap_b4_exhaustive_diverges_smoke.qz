# B4-b1 — exhaustiveness-to-`never` divergence UNLOCKS guard-early-exit narrowing.
#
# The guard-early-exit narrowing path (typecheck_walk.qz:5518,
# `tc_stmt_diverges(then_node) == 1`) narrows the subject AFTER an `if <guard>`
# whose then-branch definitely diverges: control reaches the code after the `if`
# only on the guard-FALSE path, so the subject is proven to be the ELSE variant.
#
# TARGET shape: the then-branch is an EXHAUSTIVE `match` whose every arm
# `return`s (no bare `return`). Before B4-b1, `tc_stmt_diverges` had no
# NODE_MATCH arm, so this diverging match was NOT recognized → no narrow → the
# trailing `return opt` reads the wide Option (exit 64). B4-b1 stamps the total
# match (int_val==1 from tc_check_exhaustiveness, Maranget witness == -1) and the
# new NODE_MATCH arm reports it as diverging → `opt` narrows to `Some` after the
# `if` → `return opt` yields the inner Int (exit 42).
#
# RED  (pre-b1 golden self-hosted/bin/backups/quartz-pre-b4b1-golden): exit 64.
# GREEN (b1): exit 42.

enum E
  A
  B
end

def f(opt: Option<Int>, e: E): Int
  if opt.none?
    match e
      E::A => return 100
      E::B => return 100
    end
  end
  # Reached only when opt is Some (the diverging match proves the then-branch
  # cannot fall through). `opt` narrows to Some → this reads the inner Int.
  return opt
end

def main(): Int
  return f(option_some(42), E::A)  # narrowed: inner Int 42
end
