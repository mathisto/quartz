## Executable shutdown deadline and scheduler-capacity semantics without QSpec.

import * from std/net/http_server
import * from std/net/http_dynamic_goroutine_sup

def capacity_child(): Int
  sched_sleep(20)
  return 0
end

def main(): Int
  if _http_shutdown_timeout_ms(0) != 0 or _http_shutdown_timeout_ms(0 - 1) != 0
    return 1
  end
  if _http_shutdown_timeout_ms(25) != 25
    return 2
  end

  var immediate = _http_shutdown_deadline_ms(0)
  if _http_shutdown_remaining_ms(immediate) != 0
    return 3
  end
  var future = _http_shutdown_deadline_ms(100)
  var remaining = _http_shutdown_remaining_ms(future)
  if remaining <= 0 or remaining > 100
    return 4
  end
  if _http_shutdown_deadline_ms(9223372036854775807) != 9223372036854775807
    return 5
  end

  if _http_scheduler_task_cap(0) != 0
    return 6
  end
  if _http_scheduler_task_cap(1) != 3 or _http_scheduler_task_cap(20) != 22
    return 7
  end
  if _http_scheduler_task_cap(9223372036854775807) != 9223372036854775807
    return 8
  end

  # The configured connection count excludes permanent server tasks. With one
  # connection, the watcher and control reserve must leave publication runnable.
  sched_init(2)
  sched_set_max_tasks(_http_scheduler_task_cap(1))
  var sup = http_dyn_gsup_new()
  if http_dyn_gsup_spawn_one(sup, capacity_child) == 0
    sched_shutdown_graceful(100)
    sched_shutdown()
    return 9
  end
  http_dyn_gsup_stop(sup)
  if http_dyn_gsup_spawn_count(sup) != 1 or http_dyn_gsup_completion_count(sup) != 1
    sched_shutdown()
    return 10
  end
  sched_shutdown()

  puts("ALL OK")
  return 0
end
