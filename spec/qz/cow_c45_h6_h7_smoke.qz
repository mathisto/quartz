# C4.5 (h6 + h7) standalone smoke — cow collection-element ownership.
# >16B (3-field) @value struct = cow-layout at gate 1.
#   h6 independence:    var r = v[0]; r.a = 999  => v[0].a unchanged (read retained → make-unique fired)
#   h6 outlives-collec: var r = v[0]; v.free();   => r still valid (r holds its own counted reference)
#   h7 no-leak:         build Vec of cow structs, v.free() => every element buffer released (ASan: no leak)
#   h7 shared-rc:       var r = v[0]; v.free();    => buffer kept alive by r (rc 2→1, no free), r.free path on r-drop

@value
struct Triple
  a: Int
  b: Int
  c: Int
end

def h6_independence(): Int
  var v = vec_new<Triple>()
  v.push(Triple { a: 10, b: 20, c: 30 })
  var r = v[0]
  r.a = 999
  # r mutation must NOT corrupt v[0] (read retained → rc>1 → make-unique on r.a write)
  var r2 = v[0]
  if r2.a != 10
    return 1
  end
  if r.a != 999
    return 2
  end
  # Free the Vec (h7 releases the element buffer). r/r2 auto-release at scope exit.
  v.free()
  return 0
end

def h6_outlives_collection(): Int
  var v = vec_new<Triple>()
  v.push(Triple { a: 7, b: 8, c: 9 })
  var r = v[0]
  # Drop the collection out from under r. r holds its own reference (h6 retain),
  # so the element buffer survives (rc kept it alive) — no UAF. h7's vec_free decs
  # the shared element rc 2→1 (no free); r's scope-exit release frees it at rc 1→0.
  v.free()
  if r.a != 7
    return 1
  end
  if r.c != 9
    return 2
  end
  return 0
end

def h7_no_leak(): Int
  var v = vec_new<Triple>()
  for i in 0..16
    v.push(Triple { a: i, b: i * 2, c: i * 3 })
  end
  # Read one before dropping to confirm contents, then drop the whole Vec.
  var first = v[0]
  var last = v[15]
  v.free()
  # first/last still valid (each retained its own reference at read-out).
  if first.a != 0
    return 1
  end
  if last.c != 45
    return 2
  end
  return 0
end

def main(): Int
  var rc = 0
  rc = h6_independence()
  if rc != 0
    puts("FAIL h6_independence")
    return rc
  end
  puts("PASS h6_independence")

  rc = h6_outlives_collection()
  if rc != 0
    puts("FAIL h6_outlives_collection")
    return rc + 10
  end
  puts("PASS h6_outlives_collection")

  rc = h7_no_leak()
  if rc != 0
    puts("FAIL h7_no_leak")
    return rc + 20
  end
  puts("PASS h7_no_leak")

  puts("ALL PASS")
  return 0
end
