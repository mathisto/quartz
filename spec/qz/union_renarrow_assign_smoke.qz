# Renarrow-of-assigned-union-var — a union var bound from ANOTHER union var.
# `var y: Int | String = x` where `x: Int | String`: x is already a tagged
# `{tag, payload}` cell, so the union-LET widen must NOT re-wrap it (a double-wrap
# would store x's cell pointer under a bogus tag = hash of the whole "Int | String"
# spelling, and a later `y is Int` would compare the wrong tag word → false → 0).
# The widen is skipped by identity when the RHS itself infers to a union. main
# returns y's Int payload so a compile+run asserts 42 (was 0 before the fix).
def main(): Int
  var x: Int | String = 42
  var y: Int | String = x
  if y is Int
    return y
  end
  return 0
end
