## C.14.4 standalone smoke: restart types + PreRestart hook.
##
## Lives outside qspec because indirect-call actor lifecycles inline-poll
## in the qspec describe/it lambda context (sister to the May 3 2026
## qspec-async-lambda inline-poll caveat). Standalone main spawns the
## supervisor + actors as real worker tasks.
##
## All tests inline in `main()` with the FIRST DynamicSupervisor local
## literally named `dsup` (the parameter name of std/actor.qz's watcher).
## Without this discipline, the watcher's `dsup.done` reads the wrong
## struct offset and the watcher exits before observing any death — see
## feedback_dynamic_supervisor_param_name_shadow_bug.md for the latent
## typecheck bug.

import * from std/actor
import * from time

extern "C" def usleep(us: Int): Int

actor Worker
  var n: Int = 0
  def inc(): Void
    n += 1
  end
  def get(): Int = n
end

def spawn_worker(): Int = Worker()

# C.14.7: Suicide actor — calls actor_die(0) inside a method, which closes
# its own inbox without marking it clean. Supervisor sees EXIT_CRASH and
# routes through the restart-type policy (Permanent/Transient respawn,
# Temporary stays dead).
actor SuicideWorker
  def kill(): Void
    actor_die(0)
  end
end

def spawn_suicide(): Int = SuicideWorker()

# PreRestart-hook telemetry. Top-level vars so the hook closure can
# observe them across invocations.
var g_hook_invocations = 0
var g_last_hook_inbox = 0

def my_pre_restart(dead_inbox: Int): Void
  g_hook_invocations = g_hook_invocations + 1
  g_last_hook_inbox = dead_inbox
end

def main(): Int
  # ============================================================
  # Test 1: PERMANENT default — clean stop triggers respawn.
  # FIRST test MUST use `dsup` as the local name (see file header).
  # ============================================================
  var dsup = dynamic_supervisor_new(spawn_worker, 5, 10000)
  var w_perm = dynamic_supervisor_spawn(dsup)
  w_perm.stop()
  var a = 0
  while a < 200
    var total = dynamic_supervisor_restart_count(dsup) + dynamic_supervisor_skipped_count(dsup)
    if total >= 1
      a = 999
    else
      usleep(10000)
      a = a + 1
    end
  end
  if dynamic_supervisor_restart_count(dsup) != 1
    puts("FAIL[1]: Permanent restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup))} (expected 1)")
    return 1
  end
  if dynamic_supervisor_skipped_count(dsup) != 0
    puts("FAIL[1]: Permanent skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup))} (expected 0)")
    return 2
  end
  dynamic_supervisor_stop(dsup)
  puts("OK: RESTART_PERMANENT respawns on clean stop")

  # ============================================================
  # Test 2: TRANSIENT — clean stop is skipped, no respawn
  # ============================================================
  var dsup2 = dynamic_supervisor_new(spawn_worker, 5, 10000)
  dynamic_supervisor_set_restart_type(dsup2, RESTART_TRANSIENT)
  var w_trans = dynamic_supervisor_spawn(dsup2)
  w_trans.stop()
  var a2 = 0
  while a2 < 200
    var total2 = dynamic_supervisor_restart_count(dsup2) + dynamic_supervisor_skipped_count(dsup2)
    if total2 >= 1
      a2 = 999
    else
      usleep(10000)
      a2 = a2 + 1
    end
  end
  if dynamic_supervisor_skipped_count(dsup2) != 1
    puts("FAIL[2]: Transient skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup2))} (expected 1)")
    return 3
  end
  if dynamic_supervisor_restart_count(dsup2) != 0
    puts("FAIL[2]: Transient restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup2))} (expected 0)")
    return 4
  end
  dynamic_supervisor_stop(dsup2)
  puts("OK: RESTART_TRANSIENT skips respawn on clean stop")

  # ============================================================
  # Test 3: TEMPORARY — never respawn even on clean stop
  # ============================================================
  var dsup3 = dynamic_supervisor_new(spawn_worker, 5, 10000)
  dynamic_supervisor_set_restart_type(dsup3, RESTART_TEMPORARY)
  var w_temp = dynamic_supervisor_spawn(dsup3)
  w_temp.stop()
  var a3 = 0
  while a3 < 200
    var total3 = dynamic_supervisor_restart_count(dsup3) + dynamic_supervisor_skipped_count(dsup3)
    if total3 >= 1
      a3 = 999
    else
      usleep(10000)
      a3 = a3 + 1
    end
  end
  if dynamic_supervisor_skipped_count(dsup3) != 1
    puts("FAIL[3]: Temporary skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup3))} (expected 1)")
    return 5
  end
  if dynamic_supervisor_restart_count(dsup3) != 0
    puts("FAIL[3]: Temporary restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup3))} (expected 0)")
    return 6
  end
  dynamic_supervisor_stop(dsup3)
  puts("OK: RESTART_TEMPORARY never respawns")

  # ============================================================
  # Test 4: PreRestart hook fires once per respawn (Permanent default)
  # ============================================================
  g_hook_invocations = 0
  g_last_hook_inbox = 0
  var dsup4 = dynamic_supervisor_new(spawn_worker, 5, 10000)
  dynamic_supervisor_on_pre_restart(dsup4, my_pre_restart)
  var w_hook = dynamic_supervisor_spawn(dsup4)
  var dead_inbox_expected = w_hook
  w_hook.stop()
  var a4 = 0
  while a4 < 200
    var total4 = dynamic_supervisor_restart_count(dsup4) + dynamic_supervisor_skipped_count(dsup4)
    if total4 >= 1
      a4 = 999
    else
      usleep(10000)
      a4 = a4 + 1
    end
  end
  if g_hook_invocations != 1
    puts("FAIL[4]: hook invocations = #{str_from_int(g_hook_invocations)} (expected 1)")
    return 7
  end
  if g_last_hook_inbox != dead_inbox_expected
    puts("FAIL[4]: hook saw inbox #{str_from_int(g_last_hook_inbox)}, expected #{str_from_int(dead_inbox_expected)}")
    return 8
  end
  if dynamic_supervisor_pre_restart_count(dsup4) != 1
    puts("FAIL[4]: dsup4.pre_restart_count != 1")
    return 9
  end
  dynamic_supervisor_stop(dsup4)
  puts("OK: PreRestart hook fired with dead inbox handle on respawn")

  # ============================================================
  # Test 5: PreRestart hook does NOT fire on skipped restart
  # ============================================================
  g_hook_invocations = 0
  var dsup5 = dynamic_supervisor_new(spawn_worker, 5, 10000)
  dynamic_supervisor_set_restart_type(dsup5, RESTART_TRANSIENT)
  dynamic_supervisor_on_pre_restart(dsup5, my_pre_restart)
  var w_silent = dynamic_supervisor_spawn(dsup5)
  w_silent.stop()
  var a5 = 0
  while a5 < 200
    var total5 = dynamic_supervisor_restart_count(dsup5) + dynamic_supervisor_skipped_count(dsup5)
    if total5 >= 1
      a5 = 999
    else
      usleep(10000)
      a5 = a5 + 1
    end
  end
  if g_hook_invocations != 0
    puts("FAIL[5]: hook fired #{str_from_int(g_hook_invocations)} times on skipped restart (expected 0)")
    return 10
  end
  if dynamic_supervisor_pre_restart_count(dsup5) != 0
    puts("FAIL[5]: dsup5.pre_restart_count = #{str_from_int(dynamic_supervisor_pre_restart_count(dsup5))} (expected 0)")
    return 11
  end
  dynamic_supervisor_stop(dsup5)
  puts("OK: PreRestart skipped when Transient clean-exit doesn't respawn")

  # ============================================================
  # Test 6: Static Supervisor with per-child restart types
  # ============================================================
  var spawns = vec_new()
  spawns.push(spawn_worker)
  spawns.push(spawn_worker)
  spawns.push(spawn_worker)
  var sup = supervisor_new(spawns, 5, 10000)
  supervisor_set_restart_type(sup, 0, RESTART_PERMANENT)
  supervisor_set_restart_type(sup, 1, RESTART_TRANSIENT)
  supervisor_set_restart_type(sup, 2, RESTART_TEMPORARY)
  # Child 1 (Transient) — clean stop should skip
  var c1 = supervisor_child(sup, 1)
  c1.stop()
  var b1 = 0
  while b1 < 200
    var t1 = supervisor_restart_count(sup) + supervisor_skipped_count(sup)
    if t1 >= 1
      b1 = 999
    else
      usleep(10000)
      b1 = b1 + 1
    end
  end
  if supervisor_restart_count(sup) != 0
    puts("FAIL[6.1]: restart_count after Transient.stop = #{str_from_int(supervisor_restart_count(sup))} (expected 0)")
    return 12
  end
  if supervisor_skipped_count(sup) != 1
    puts("FAIL[6.1]: skipped_count = #{str_from_int(supervisor_skipped_count(sup))} (expected 1)")
    return 13
  end
  # Child 2 (Temporary) — clean stop should also skip
  var c2 = supervisor_child(sup, 2)
  c2.stop()
  var b2 = 0
  while b2 < 200
    var t2 = supervisor_restart_count(sup) + supervisor_skipped_count(sup)
    if t2 >= 2
      b2 = 999
    else
      usleep(10000)
      b2 = b2 + 1
    end
  end
  if supervisor_skipped_count(sup) != 2
    puts("FAIL[6.2]: skipped_count = #{str_from_int(supervisor_skipped_count(sup))} (expected 2)")
    return 14
  end
  # Child 0 (Permanent) — should respawn
  var c0 = supervisor_child(sup, 0)
  c0.stop()
  var b3 = 0
  while b3 < 200
    var t3 = supervisor_restart_count(sup) + supervisor_skipped_count(sup)
    if t3 >= 3
      b3 = 999
    else
      usleep(10000)
      b3 = b3 + 1
    end
  end
  if supervisor_restart_count(sup) != 1
    puts("FAIL[6.3]: restart_count = #{str_from_int(supervisor_restart_count(sup))} (expected 1)")
    return 15
  end
  supervisor_stop(sup)
  puts("OK: Supervisor per-child restart types route correctly")

  # ============================================================
  # C.14.7 Test 7: PERMANENT + actor_die — respawn (matches
  # clean-stop behavior; Permanent doesn't care about the reason)
  # ============================================================
  var dsup7 = dynamic_supervisor_new(spawn_suicide, 5, 10000)
  var w_perm_die = dynamic_supervisor_spawn(dsup7)
  w_perm_die.kill()
  var a7 = 0
  while a7 < 200
    var total7 = dynamic_supervisor_restart_count(dsup7) + dynamic_supervisor_skipped_count(dsup7)
    if total7 >= 1
      a7 = 999
    else
      usleep(10000)
      a7 = a7 + 1
    end
  end
  if dynamic_supervisor_restart_count(dsup7) != 1
    puts("FAIL[7]: Permanent+actor_die restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup7))} (expected 1)")
    return 16
  end
  if dynamic_supervisor_skipped_count(dsup7) != 0
    puts("FAIL[7]: Permanent+actor_die skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup7))} (expected 0)")
    return 17
  end
  dynamic_supervisor_stop(dsup7)
  puts("OK: RESTART_PERMANENT respawns on actor_die crash exit")

  # ============================================================
  # C.14.7 Test 8: TRANSIENT + actor_die — respawn (THIS IS THE
  # PROOF that Transient ≠ Permanent — Transient skips clean stop
  # but respawns on crash, observable only via actor_die).
  # ============================================================
  var dsup8 = dynamic_supervisor_new(spawn_suicide, 5, 10000)
  dynamic_supervisor_set_restart_type(dsup8, RESTART_TRANSIENT)
  var w_trans_die = dynamic_supervisor_spawn(dsup8)
  w_trans_die.kill()
  var a8 = 0
  while a8 < 200
    var total8 = dynamic_supervisor_restart_count(dsup8) + dynamic_supervisor_skipped_count(dsup8)
    if total8 >= 1
      a8 = 999
    else
      usleep(10000)
      a8 = a8 + 1
    end
  end
  if dynamic_supervisor_restart_count(dsup8) != 1
    puts("FAIL[8]: Transient+actor_die restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup8))} (expected 1)")
    return 18
  end
  if dynamic_supervisor_skipped_count(dsup8) != 0
    puts("FAIL[8]: Transient+actor_die skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup8))} (expected 0)")
    return 19
  end
  dynamic_supervisor_stop(dsup8)
  puts("OK: RESTART_TRANSIENT respawns on actor_die crash exit (≠ Permanent now visible)")

  # ============================================================
  # C.14.7 Test 9: TEMPORARY + actor_die — never respawn even on
  # crash (Temporary is unconditional)
  # ============================================================
  var dsup9 = dynamic_supervisor_new(spawn_suicide, 5, 10000)
  dynamic_supervisor_set_restart_type(dsup9, RESTART_TEMPORARY)
  var w_temp_die = dynamic_supervisor_spawn(dsup9)
  w_temp_die.kill()
  var a9 = 0
  while a9 < 200
    var total9 = dynamic_supervisor_restart_count(dsup9) + dynamic_supervisor_skipped_count(dsup9)
    if total9 >= 1
      a9 = 999
    else
      usleep(10000)
      a9 = a9 + 1
    end
  end
  if dynamic_supervisor_restart_count(dsup9) != 0
    puts("FAIL[9]: Temporary+actor_die restart_count = #{str_from_int(dynamic_supervisor_restart_count(dsup9))} (expected 0)")
    return 20
  end
  if dynamic_supervisor_skipped_count(dsup9) != 1
    puts("FAIL[9]: Temporary+actor_die skipped_count = #{str_from_int(dynamic_supervisor_skipped_count(dsup9))} (expected 1)")
    return 21
  end
  dynamic_supervisor_stop(dsup9)
  puts("OK: RESTART_TEMPORARY never respawns on actor_die crash exit")

  puts("ALL OK")
  return 0
end
