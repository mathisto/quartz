## B.7 Phase 4e.8 Layer A+B smoke test: scope_cancel actively wakes a
## task parked inside `scope_sleep_ms`.
##
## Pre-Phase 4e.8: scope_cancel(s) only sets the cancel flag; the worker
## task wakes when its current chunked-poll's sched_sleep timer fires
## (worst case SCOPE_SLEEP_CHUNK_MS = 50ms). Wall-clock cancel→throw
## latency was bounded at ~50ms.
##
## Post-Phase 4e.8: cancel walker calls sched_wake(worker_frame) for
## each registered waiter. Layer A makes sched_wake interrupt the
## worker's sched_sleep (cancel kqueue/epoll timer + atomic-claim
## io_map slot + re-enqueue). Wall-clock cancel→throw latency drops
## to single-digit ms (scheduler round-trip).
##
## This test asserts wall-clock latency < 30ms — well below the 50ms
## chunk floor of the pre-Phase 4e.8 implementation, demonstrably proving
## active-wake fired and was observed.
##
## Standalone (not qspec): qspec describe/it lambdas treat `go fn()` as
## a Future created+polled inline (not a real worker-thread spawn), so
## the worker-blocks-then-cancel pattern can't be expressed there. From
## `def main()` directly with the right shape, `go` spawns a real
## goroutine on a worker thread, and main runs in parallel.

import * from std/sync/composition/scope
import * from std/throws

var done = 0
var caught_msg = ""
var throw_observed_ns = 0

def cap(op_name: Int, argc: Int, argv: Int): Int
  caught_msg = as_type<String>(load(argv, 0))
  return 0
end

var s = 0

def body(): Int
  scope_sleep_ms(5_000)
  return 0
end

def worker(): Int
  with Throws { throw: cap } do ->
    scope_with(s, body)
    0
  end
  throw_observed_ns = time_mono_ns()
  done = 1
  return 0
end

def main(): Int
  s = scope_with_cancel(scope_root())
  var w = go worker()
  sched_sleep(50)
  var cancel_ns = time_mono_ns()
  scope_cancel_with(s, "test-cancel")
  var t0 = time_mono_ns()
  while done == 0
    sched_sleep(5)
    if (time_mono_ns() - t0) / 1_000_000 > 1_000
      puts("FAIL: worker did not finish within 1s of cancel")
      return 1
    end
  end
  var latency_ms = (throw_observed_ns - cancel_ns) / 1_000_000
  if caught_msg != "test-cancel"
    puts("FAIL: expected msg 'test-cancel', got '#{caught_msg}'")
    return 2
  end
  if latency_ms < 0
    puts("FAIL: negative latency #{str_from_int(latency_ms)}ms")
    return 3
  end
  if latency_ms > 30
    puts("FAIL: cancel->throw latency #{str_from_int(latency_ms)}ms exceeds 30ms bound (pre-Phase 4e.8 was ~50ms chunk floor)")
    return 4
  end
  puts("OK: cancel->throw latency #{str_from_int(latency_ms)}ms (well under 50ms chunk floor — active-wake fired)")
  return 0
end
