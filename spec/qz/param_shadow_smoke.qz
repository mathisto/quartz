# Red→green vehicle for the param-shadow imported-module miscompile.
# Golden binary (pre-fix): prints FAIL with a huge value (func address).
# Fixed binary: prints PASS.
import param_shadow_mod

def main(): Int
  var got = param_shadow_mod.check(2)

  if got == 2
    puts("PASS")
    return 0
  end
  puts("FAIL")
  print_int(got)
  return 1
end
