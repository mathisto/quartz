## Built-in `Result<&A,&B>` niche — async-suspend round-trip smoke (enum-niche M2).
## Design: docs/design/ENUM_NICHE_M2_RESULT.md §9 RatQ5 + MEMORY_MODEL_V3.md §14.10.
##
## Invariant #5 (RFC §4 / ratification Q5): a niche `Result` local must be EXACTLY
## one i64 SSA value (`payload_ptr | tag`), NEVER a (pointer-alloca, tag-alloca)
## decomposition — the $poll/save-set soundness depends on it. A two-alloca
## decomposition would spill only one half into the heap frame at suspend, so the
## resumed value would read garbage. This smoke holds a boxed `Result` live ACROSS a
## `sched_sleep` suspend inside a REAL worker-thread goroutine (`go worker()` from
## `def main()` spawns a real goroutine — unlike a qspec describe/it lambda, where
## `go fn()` is polled inline; see CLAUDE.md), then asserts BOTH the variant AND the
## payload survive the resume.
##
## GATE 0 (`mir_multi_niche_result_live()` == 0): the boxed `Result` rides the
## tagged-box SPILL path — this smoke locks the OBSERVABLE behavior so the gate flip
## (to the one-i64-SSA-value niche) is a differential oracle: it must still pass.
##
## Standalone (not qspec) so `go` is a real worker-thread spawn.

import * from std/throws

struct OkPayload
  a: Int
end
struct ErrPayload
  b: Int
end

def res_ok(n: Int): Result<OkPayload, ErrPayload> = Result::Ok(OkPayload { a: n })
def res_err(n: Int): Result<OkPayload, ErrPayload> = Result::Err(ErrPayload { b: n })

def res_code(r: Result<OkPayload, ErrPayload>): Int
  return match r
    Ok(n) => n.a
    Err(e) => 0 - e.b
  end
end

var done = 0
var ok_code = 0
var err_code = 0

## Worker: build a boxed Result, suspend across a sched_sleep (the save-set must
## round-trip the WHOLE packed word, not a stale half), then read it back.
def worker(): Int
  var ok = res_ok(42)
  var err = res_err(7)
  # Suspend: under $poll this spills the live `ok`/`err` locals into the heap frame.
  sched_sleep(20)
  # Resume: the locals must decode to the SAME variant + payload they held pre-suspend.
  ok_code = res_code(ok)
  err_code = res_code(err)
  done = 1
  return 0
end

def main(): Int
  var w = go worker()
  var t0 = time_mono_ns()
  while done == 0
    sched_sleep(5)
    if (time_mono_ns() - t0) / 1_000_000 > 2_000
      puts("FAIL: worker did not finish within 2s")
      return 1
    end
  end
  if ok_code != 42
    puts("FAIL: Ok payload did not survive suspend — got #{str_from_int(ok_code)}, want 42")
    return 2
  end
  if err_code != 0 - 7
    puts("FAIL: Err payload did not survive suspend — got #{str_from_int(err_code)}, want -7")
    return 3
  end
  puts("OK: niche-eligible Result (Ok+Err) survived async suspend/resume — one-i64-SSA-value invariant holds")
  return 0
end
