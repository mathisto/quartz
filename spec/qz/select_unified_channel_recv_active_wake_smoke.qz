## C.13.6: channel-waker active-wake smoke.
##
## Pre-C.13.6: RecvSelectable.register_waker was a stub returning Void.
## Pure-channel selects worked correctly via Phase 4a chunked-poll —
## try_recv every ~10ms (sched_yield cadence). Wall-clock send->arm
## latency: chunked-poll floor, typically tens of ms.
##
## Post-C.13.6: RecvSelectable.register_waker calls
## waiter_register(@ch, frame). Every send/recv/try_*/close on the
## channel calls __qz_waiter_notify_all(ch) which sched_wakes the
## polling frame. Latency: scheduler round-trip (~us, typically < 5ms
## wall).
##
## This test asserts wall-clock send->arm-fires latency < 30ms — well
## below the 50ms typical chunked-poll floor of polling-only designs,
## proving active-wake fired and was observed.
##
## Standalone (not qspec): same rationale as the mutex_try / signal
## smokes — qspec describe/it lambdas treat `go fn()` as a Future
## created+polled inline, so the worker-blocks-then-send pattern can't
## be expressed there. From `def main()` directly, `go` spawns a real
## goroutine on a worker thread.

import * from std/sync/communication/channel
import * from std/sync/composition/scope

var ch_handle: Int = 0
var worker_sent_ns: Int = 0

def worker(): Int
  # Sleep first, then send. Main is already parked in select by the
  # time we wake up — the send's waiter_notify_all walks the
  # registry and sched_wakes main.
  sched_sleep(50)
  worker_sent_ns = time_mono_ns()
  send(ch_handle, 99)
  return 0
end

def main(): Int
  var ch = channel_new(8)
  ch_handle = ch

  var w = go worker()

  var arm_fired_ns = 0
  var v_observed = 0
  var deadline_fired = 0

  select
    case v = recvable(ch) =>
      arm_fired_ns = time_mono_ns()
      v_observed = v
    case _ = deadline_ms(1000) =>
      arm_fired_ns = time_mono_ns()
      deadline_fired = 1
  end

  if deadline_fired == 1
    puts("FAIL: deadline_ms(1000) fired before recvable — worker either never sent or active-wake didn't observe")
    return 1
  end

  if v_observed != 99
    puts("FAIL: expected v=99 (worker's send value), got v=#{str_from_int(v_observed)}")
    return 2
  end

  # Latency from worker's send to main observing the arm fire.
  # Bound: 30ms. Pre-C.13.6 chunked-poll floor would be ~10ms+; a
  # polling design has no guarantee of observing the send within any
  # specific window without active-wake.
  var latency_ms = (arm_fired_ns - worker_sent_ns) / 1_000_000
  if latency_ms < 0
    puts("FAIL: negative latency #{str_from_int(latency_ms)}ms (clock skew?)")
    return 3
  end
  if latency_ms > 30
    puts("FAIL: send->arm latency #{str_from_int(latency_ms)}ms exceeds 30ms bound (active-wake not firing?)")
    return 4
  end

  puts("OK: send->arm latency #{str_from_int(latency_ms)}ms (active-wake fired)")
  return 0
end
