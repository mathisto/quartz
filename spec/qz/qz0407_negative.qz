# EXPECT: compile error QZ0407 (mutates self without &mut self). Compile directly, do NOT add to the qspec runner.
#
# WS4-b2 negative test for the &mut self enforcement diagnostic.
# `Counter.bump(self)` directly mutates `self.n` with a bare `self` receiver and
# NO `&mut self` — this MUST fail to compile with QZ0407 once enforcement is on.

struct Counter
  n: Int
end

def Counter.bump(self): Void
  self.n = self.n + 1
end

def main(): Int
  var c = Counter { n: 0 }
  c.bump()
  return c.n
end
