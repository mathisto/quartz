## Un-annotated `option_some(closure).unwrap()(...)` callability — standalone
## smoke (N3.2 follow-up #2, MEMORY_MODEL_V3 §14.7 hole #2).
##
## THE GAP: an UN-annotated local built from `option_some(closure)` —
## `var f = option_some(my_closure)` with NO `: Option<Fn(...)>` annotation —
## inferred `f: Option` with the payload type ERASED. A later `g = f.unwrap()`
## then yielded a non-callable type, so `g(args)` was rejected with QZ0200
## "Cannot call 'g': not a function". The fix mirrors the 49d76070 `nonzero_new`
## precedent: `option_some` carries the concrete payload type through, so
## `.unwrap()` narrows to it and a callable (Fn) payload becomes callable.
##
## STANDALONE (not qspec) ON PURPOSE: the construct/read local-type tracking that
## drives this inference is body-scoped, and a qspec `describe`/`it` `do ->` lambda
## body resolves it differently — the bug does NOT manifest inside a qspec lambda
## (it passes there on BOTH golden and fixed). The top-level `def main()` body is
## where the gap reproduces, so this is the valid regression lock. Representation-
## independent: behaves identically under tagged and niche layouts.
##
## Returns 0 on success; a distinct non-zero code per failed assertion.

def make_adder(n: Int): Fn(Int): Int
  # Captures `n` => env|1 tagged closure.
  return x: Int -> x + n
end

## §14.7 item 2 (5a): a BARE reference to a top-level `def` used as a VALUE
## must carry its `Fn(...): R` signature, not the signatureless scalar
## TYPE_FUNCTION. Pre-fix `option_some(named_def).unwrap()` lost the signature
## and the recovered value was rejected as "not a function" (QZ0200). The fix
## attaches a real Fn ptype at the NODE_IDENT site; the chained `.unwrap()`
## narrowing then recovers a callable. Cases 5–7 below lock this.
##
## NOTE: the higher-order-arg form `call_with(option_some(def).unwrap(), n)` is
## NOT exercised here — passing a BARE-def function value into a Fn-typed param
## inside top-level `def main()` hits a SEPARATE pre-existing codegen bug
## (spurious `@__Future_*` references → llc "use of undefined value"), present
## identically on the golden binary and orthogonal to this signature fix. The
## bare-def-via-option_some-unwrap callability that 5a fixes is fully locked by
## cases 5 (chained call) and 7 (concrete Vec<Option<Fn>> push/call) below.
def bare_inc(x: Int): Int = x + 1

def main(): Int
  # 1. §14.7 item 2 (5a) CORE — FIRST on purpose: a chained
  #    `option_some(bare_def).unwrap()` then call. RED pre-fix (golden binary:
  #    QZ0200 "Cannot call 'g1': not a function"). Placed before the lambda
  #    cases so the lock can't be masked by order-dependent inference priming.
  g1 = option_some(bare_inc).unwrap()
  if g1(5) != 6
    puts("FAIL[1]: bare-def option_some.unwrap call = #{str_from_int(g1(5))} (expected 6)")
    return 1
  end

  # 2. Split form: bind the option_some(bare_def), then unwrap + call.
  o2 = option_some(bare_inc)
  g2 = o2.unwrap()
  if g2(99) != 100
    puts("FAIL[2]: split bare-def unwrap call = #{str_from_int(g2(99))} (expected 100)")
    return 2
  end

  # 3. Regression guard R1: a bare `def` Some-pushed into a concretely-typed
  #    Vec<Option<Fn(...)>> must still compile + call (the concrete Fn payload
  #    must match the annotated element type — the 5a elem-match recursion).
  var vfn: Vec<Option<Fn(Int): Int>> = vec_new()
  vfn.push(option_some(bare_inc))
  vfn.push(option_none())
  e0 = vfn[0]
  g3 = e0.unwrap()
  if g3(40) != 41
    puts("FAIL[3a]: Vec<Option<Fn>> bare-def push/call = #{str_from_int(g3(40))} (expected 41)")
    return 3
  end
  if (vfn[1] is None) != 1
    puts("FAIL[3b]: Vec<Option<Fn>> None element not None")
    return 4
  end

  # 4. Separately-bound local lambda, un-annotated option_some, unwrap, call.
  add = (x: Int) -> x + 10
  f = option_some(add)
  g = f.unwrap()
  if g(5) != 15
    puts("FAIL[4]: g(5) = #{str_from_int(g(5))} (expected 15)")
    return 5
  end

  # 5. Closure from a Fn-returning function (make_adder), un-annotated.
  fa = option_some(make_adder(100))
  ga = fa.unwrap()
  if ga(5) != 105
    puts("FAIL[5]: ga(5) = #{str_from_int(ga(5))} (expected 105)")
    return 6
  end

  # 6. Inline lambda directly as the option_some argument.
  fi = option_some(x: Int -> x * 3)
  gi = fi.unwrap()
  if gi(14) != 42
    puts("FAIL[6]: gi(14) = #{str_from_int(gi(14))} (expected 42)")
    return 7
  end

  # 7. Two distinct un-annotated closures keep independent captured envs.
  ca = option_some(make_adder(1))
  cb = option_some(make_adder(1000))
  fca = ca.unwrap()
  fcb = cb.unwrap()
  if fca(10) + fcb(10) != 1021
    puts("FAIL[7]: env crosstalk — got #{str_from_int(fca(10) + fcb(10))} (expected 1021)")
    return 8
  end

  # 8. Item 5c — DIRECT APPLICATION of a call result (callee is itself a
  #    NODE_CALL). Pre-fix these QZ0401'd ("Undefined function") because neither
  #    typecheck nor mir_lower had a NODE_CALL-callee dispatch arm — only the
  #    bind-form (cases 1–7 above) worked. The fix adds paired arms in
  #    tc_expr_call + mir_lower_call gated on tc_fn_type_id(inner) >= 0.

  # 8a. Plain call-of-call, Option-independent: proves the node-kind arm alone.
  if make_adder(100)(5) != 105
    puts("FAIL[8a]: make_adder(100)(5) = #{str_from_int(make_adder(100)(5))} (expected 105)")
    return 9
  end

  # 8b. var-bound option_some + direct unwrap-and-apply.
  var f8 = option_some(bare_inc)
  if f8.unwrap()(5) != 6
    puts("FAIL[8b]: f8.unwrap()(5) = #{str_from_int(f8.unwrap()(5))} (expected 6)")
    return 10
  end

  # 8c. Named def, fully direct chain (no intermediate binding).
  if option_some(bare_inc).unwrap()(5) != 6
    puts("FAIL[8c]: option_some(bare_inc).unwrap()(5) != 6")
    return 11
  end

  # 8d. Inline lambda, fully direct chain.
  if option_some(x: Int -> x * 3).unwrap()(14) != 42
    puts("FAIL[8d]: option_some(lambda).unwrap()(14) != 42")
    return 12
  end

  puts("ALL OK")
  return 0
end
