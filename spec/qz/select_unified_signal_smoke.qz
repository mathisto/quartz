## C.13 Phase 5: SignalSelectable smoke test.
##
## Asserts: after raise(SIGUSR1()) by a worker thread, main's
## `case s = signalable(SIGUSR1()) =>` arm fires with s == SIGUSR1().
##
## Latency bound is loose (250ms) — Phase 5 ships SignalSelectable
## with a stub register_waker (the async-signal-safe trampoline
## cannot call sched_wake from signal context). try_poll observes
## the flag on the select's chunked-poll cadence — typically ~10ms,
## but allow 250ms slack for CI / overloaded machines.
##
## Uses raise(SIGUSR1()) from libc — SIGUSR1() is "harmless" (default
## action is process-terminate but we install a handler that just
## sets the flag, so the signal is caught and the process continues).
##
## Standalone (not qspec): same reason as scope_active_wake_smoke —
## qspec describe/it lambdas inline-poll `go` futures rather than
## spawning real workers, which doesn't compose with a
## sleep-then-raise pattern.

import * from std/sync/composition/signal
import * from std/sync/composition/scope

# libc raise(int) — sends a signal to the current process.
extern "C" def raise(sig: CInt): CInt

var raised_ns: Int = 0
var done_signaled: Int = 0

def worker(): Int
  # Give main a chance to enter the select first.
  sched_sleep(50)
  raised_ns = time_mono_ns()
  raise(SIGUSR1())
  done_signaled = 1
  return 0
end

def main(): Int
  var sigusr1 = signalable(SIGUSR1())

  var w = go worker()

  var arm_fired_ns = 0
  var sig_observed = 0
  var deadline_fired = 0

  select
    case s = sigusr1 =>
      arm_fired_ns = time_mono_ns()
      sig_observed = s
    case _ = deadline_ms(2000) =>
      arm_fired_ns = time_mono_ns()
      deadline_fired = 1
  end

  if deadline_fired == 1
    puts("FAIL: deadline_ms(2000) fired before signalable — signal not observed")
    return 1
  end

  if sig_observed != SIGUSR1()
    puts("FAIL: expected sig=#{str_from_int(SIGUSR1())}, got sig=#{str_from_int(sig_observed)}")
    return 2
  end

  if raised_ns == 0
    puts("FAIL: worker never raised the signal")
    return 3
  end

  # Wait for worker to drop done_signaled (loosely — best effort).
  var t0 = time_mono_ns()
  while done_signaled == 0
    sched_sleep(5)
    if (time_mono_ns() - t0) / 1_000_000 > 500
      break
    end
  end

  var latency_ms = (arm_fired_ns - raised_ns) / 1_000_000
  if latency_ms < 0
    puts("FAIL: negative latency #{str_from_int(latency_ms)}ms (clock skew?)")
    return 4
  end
  if latency_ms > 250
    puts("FAIL: signal->arm latency #{str_from_int(latency_ms)}ms exceeds 250ms bound")
    return 5
  end

  puts("OK: signal->arm latency #{str_from_int(latency_ms)}ms (Phase 5 stub register_waker, chunked-poll cadence)")
  return 0
end
