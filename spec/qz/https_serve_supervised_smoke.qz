## https_serve_supervised end-to-end smoke — D.11 Phase 4.
##
## Passive smoke: binds the supervised HTTPS server on :18743 with a
## self-signed cert/key at /tmp/qz_phase4_cert.pem + /tmp/qz_phase4_key.pem
## and waits for SIGTERM/SIGINT. Verified end-to-end with external
## `curl --insecure` (see the verification recipe below).
##
## Why passive (same rationale as http_serve_supervised_smoke.qz):
## `sched_spawn(async fn())` inline-polls the spawned function up to
## its first true suspension point. A driver goroutine that does
## `usleep(...)` blocks the spawning thread until the usleep completes —
## main thread can't enter https_serve_supervised in parallel; the
## listener loop never runs; the driver's requests get
## connection-refused. True multi-thread M:N concurrency for the
## driver pattern is filed for the future http_request_selectable /
## tls_recvable / tls_sendable unified-Selectable phase.
##
## Generate test cert/key (one-time, no passphrase):
##   openssl req -x509 -newkey rsa:2048 -nodes \
##     -keyout /tmp/qz_phase4_key.pem -out /tmp/qz_phase4_cert.pem \
##     -days 1 -subj "/CN=localhost"
##
## Build:
##   ./self-hosted/bin/quartz spec/qz/https_serve_supervised_smoke.qz \
##     | llc -filetype=obj -o /tmp/hsss.o
##   clang /tmp/hsss.o -o /tmp/hsss -lm -lpthread \
##     -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto
##
## Verify HTTP/1.1 path (in one shell):
##   /tmp/hsss
##
## In another shell:
##   curl --insecure -sv https://127.0.0.1:18743/
##   # → HTTP/1.1 200 OK / "ok-from-https-supervised"
##   curl --insecure -X POST -d 'hello' https://127.0.0.1:18743/echo
##   # → 200 / "ok-from-https-supervised"
##
## Verify HTTP/2 path (ALPN-negotiated):
##   curl --insecure -sv --http2 https://127.0.0.1:18743/
##   # → HTTP/2 200 / "ok-from-https-supervised"
##   # → curl's verbose output should show ALPN: server accepted h2
##
## Then SIGTERM the first shell (Ctrl+C or `kill -TERM <pid>`); the
## listener loop's top-of-iteration poll observes _http_shutdown_flag
## (set by signal_on_flag), drains in-flight connections via
## http_dyn_gsup_stop, then keeps SSL_CTX alive through scheduler containment
## before freeing it. A truly held blocked TLS connection currently requires
## the parked runtime cancellation/unwind fix documented in the conductor ledger.

import * from std/net/http_server

def smoke_https_handler(req: Request): Response
  return text_response("ok-from-https-supervised")
end

def main(): Int
  puts("https_serve_supervised — D.11 Phase 4 smoke")
  puts("Listening on :18743 — curl --insecure in another shell, then SIGTERM (Ctrl+C)")
  var config = http_server_config(18743)
  config.max_connections = 1
  config.shutdown_timeout_ms = 100
  var tls = HttpsTlsConfig {
    cert_file: "/tmp/qz_phase4_cert.pem",
    key_file: "/tmp/qz_phase4_key.pem"
  }
  return https_serve_supervised(config, tls, smoke_https_handler)
end
