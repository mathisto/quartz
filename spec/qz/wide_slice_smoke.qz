## Wide-element slice smoke test.
## Vec<RGB> has elem_width = 24 (3 i64 fields). Verifies the slice intrinsic
## reads elem_width from the source Vec, strides correctly, and that
## slice_get's wide-path returns a usable @value struct pointer.

@value
struct RGB
  r: Int
  g: Int
  b: Int
end

def main(): Int
  var pixels = vec_new<RGB>()
  pixels.push(RGB { r: 255, g: 0, b: 0 })
  pixels.push(RGB { r: 0, g: 255, b: 0 })
  pixels.push(RGB { r: 0, g: 0, b: 255 })

  var middle: Slice<RGB> = slice(pixels, 1, 2)
  if middle.size != 1
    return 100
  end
  var p = middle.get(0)
  if p.g != 255
    return 101
  end

  var two: Slice<RGB> = slice(pixels, 0, 2)
  if two.size != 2
    return 102
  end
  var p0 = two.get(0)
  var p1 = two.get(1)
  if p0.r != 255
    return 103
  end
  if p1.g != 255
    return 104
  end

  return 0
end
