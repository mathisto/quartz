# B4 niche inheritance round-trip: `NonZero | Nil`.
# NonZero has a spare inhabitant (0), so the union drops its tag word — the value
# stays payload-sized with 0 as the Nil discriminant. Must recover 7 via identity.
def main(): Int
  var x: NonZero | Nil = nonzero_new_unchecked(7)
  if x is Nil
    return 1          # must NOT hit
  end
  if x is NonZero
    return nonzero_get(x)   # recover 7 through niche, no payload@1 load
  end
  return 99
end
