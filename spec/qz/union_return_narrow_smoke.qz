# S2 — returning a flow-narrowed union member in identity position.
# `x: Int | String` narrowed by `if x is Int` to the Int arm, then `return x`.
# The ident narrowed-read extracts the bare arm scalar (42); the return-unwiden
# block must NOT extract a second time (would deref the scalar as a {tag,payload}
# cell pointer → SIGSEGV). main returns the payload so a compile+run asserts it.
def main(): Int
  var x: Int | String = 42
  if x is Int
    return x
  end
  return 0
end
