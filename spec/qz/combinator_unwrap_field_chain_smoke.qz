## Forward-lock regression smoke for chained `unwrap_*(combinator(...)).field`
## (filed item 8 / "5d").
##
## WHAT THIS LOCKS: reading a struct FIELD off the result of unwrapping a
## combinator (`result_map` / `option_map`) whose mapper produces a struct. The
## field read resolves through the A.45 generic-return field-resolution machinery
## (`mir_subst_return_type_for_call` binding bare-T returns from the concrete
## generic receiver). A design pass confirmed all forms below ALREADY WORK at
## HEAD; this smoke is the positive regression net so they can't silently break.
##
## STANDALONE (not qspec) ON PURPOSE: matches the body-scoped local-type tracking
## convention of the sibling `option_baredef_unwrap_call_smoke.qz` /
## `option_unannotated_closure_unwrap_smoke.qz` locks — top-level `def main()`
## body is the canonical reproduction context for chained-unwrap field resolution.
##
## UNIQUE struct/fn names (Cuf*) avoid the stale-/tmp-cache A/B footgun.
## Returns 0 on success; a distinct non-zero code per failed assertion.

struct CufBox
  field: Int
end

## Named mapper: Int -> struct. Drives the result_map / option_map combinator.
def cuf_mk(x: Int): CufBox
  return CufBox { field: x * 2 }
end

def main(): Int
  # 1. unwrap_ok(result_map(r, NAMED_fn)).field — free-function unwrap of a
  #    combinator over a named mapper, then field read.
  r1 = Result::Ok(21)
  v1 = unwrap_ok(result_map(r1, cuf_mk)).field
  if v1 != 42
    puts("FAIL[1]: unwrap_ok(result_map(r, cuf_mk)).field = #{str_from_int(v1)} (expected 42)")
    return 1
  end

  # 2. result_map(r, NAMED_fn).unwrap().field — method-style unwrap chain.
  r2 = Result::Ok(50)
  v2 = result_map(r2, cuf_mk).unwrap().field
  if v2 != 100
    puts("FAIL[2]: result_map(r, cuf_mk).unwrap().field = #{str_from_int(v2)} (expected 100)")
    return 2
  end

  # 3. option_map(o, NAMED_fn).unwrap().field — Option flavor, method chain.
  o3 = Option::Some(7)
  v3 = option_map(o3, cuf_mk).unwrap().field
  if v3 != 14
    puts("FAIL[3]: option_map(o, cuf_mk).unwrap().field = #{str_from_int(v3)} (expected 14)")
    return 3
  end

  # 4. unwrap_ok(result_map(r, LAMBDA-with-ELIDED-return)).field — the filed
  #    "harder" sub-case: an inline lambda mapper whose `: CufBox` return
  #    annotation is OMITTED, inferred from the struct literal body.
  r4 = Result::Ok(11)
  v4 = unwrap_ok(result_map(r4, x: Int -> CufBox { field: x * 2 })).field
  if v4 != 22
    puts("FAIL[4]: unwrap_ok(result_map(r, lambda)).field = #{str_from_int(v4)} (expected 22)")
    return 4
  end

  # 5. CONTRAST CONTROL — split-statement form: bind the unwrap result to a
  #    local, then read `.field` in a separate statement. Locks the simpler path
  #    alongside the chained ones so a divergence between them is visible.
  r5 = Result::Ok(33)
  s5 = unwrap_ok(result_map(r5, cuf_mk))
  v5 = s5.field
  if v5 != 66
    puts("FAIL[5]: split unwrap_ok(result_map(...)); s.field = #{str_from_int(v5)} (expected 66)")
    return 5
  end

  puts("ALL OK")
  return 0
end
