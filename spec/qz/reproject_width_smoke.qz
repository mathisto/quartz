# R2 (C1/§3.3) — record width-subtyping reprojecting copy at CALL ARG.
# A wider nominal struct (Point3D, >16B ⇒ COW buffer w/ refcount header at word 0)
# passed where a narrower structural record `{ x: Int, y: Int }` is expected must be
# reprojected into the record's flat canonical layout, else the callee's record-view
# reads the source's refcount header as field 0 (pre-fix: returned 2, not 42).
# This is the call-arg case the failing record_types_spec tests exercise (no LET
# annotation ⇒ p keeps its Point3D type). Expected exit: 42.
# REMAINDER (filed): the record-typed LET coercion site
# (`var p: { x: Int, y: Int } = Point3D { ... }`) is NOT yet reprojected.
struct Point3D
  x: Int
  y: Int
  z: Int
end
def get_xy(r: { x: Int, y: Int }): Int = r.x + r.y
def main(): Int
  p = Point3D { x: 40, y: 2, z: 99 }
  return get_xy(p)
end
