## C.14.3b scale smoke: DynamicSupervisor at 100k children.
##
## Validates the C.14.3a hashmap waiter table at the scale it was built
## for. Pre-C.14.3a (array @__qz_waiters, cap=256), this test would
## silently drop ~99.7% of registrations (table fills at 256, subsequent
## register calls no-op). With the hashmap (separate chaining, 64
## striped mutexes, splitmix64 hash), all 100k registrations succeed
## via O(1) bucket-prepend with grow rehashes at 75% load factor.
##
## What this smoke validates:
##   1. spawn x 100k completes in < 1 second (hashmap registers are O(1))
##   2. dynamic_supervisor_alive returns the full count (every channel
##      handle is reachable + open in the hashmap waiter table)
##   3. iter walks every child without dropping any (hashmap covers
##      all entries — no static-cap silent drops)
##
## What this smoke does NOT validate (pre-existing limitations):
##   - The watcher's restart-cascade throughput at scale. Empirically
##     observed: at N=100k K=50k, the watcher processes ~3 restarts in
##     30s before pthread_mutex contention (children_lock vs spawn
##     under-lock) starves it. See feedback_dynamic_supervisor_stop_
##     deadlock.md for the related stop-side hang.
##   - dynamic_supervisor_stop at scale (same root cause). This smoke
##     calls _exit(0) directly to bypass the cleanup deadlock.
##
## When the watcher-cascade and stop-protocol issues are fixed, this
## smoke should be extended to assert restart-count progress within a
## deadline. For now, it asserts the load-bearing C.14.3a hashmap
## prerequisite stays correct under headline-scale registration.
##
## Memory ceiling: 100k actor frames × ~hundreds of bytes each = ~50 MB
## peak. The headline 5M-task target lives on the unikernel deploy.

import * from std/actor
import * from time

extern "C" def fflush(stream: Int): Int
extern "C" def _exit(code: Int): Void

const N = 100000

actor LightWorker
  var n: Int = 0
  def noop(): Void
    n += 1
  end
end

def spawn_light(): Int = LightWorker()

def main(): Int
  puts("DynamicSupervisor scale smoke — N=#{str_from_int(N)} children")

  var dsup = dynamic_supervisor_new(spawn_light, N + 100, 60000)

  # Phase 1: spawn N children. Each spawn does waiter_register on the
  # close-event key — this is the hashmap insertion path under load.
  var t0 = time_mono_ns()
  var i = 0
  while i < N
    dynamic_supervisor_spawn(dsup)
    i = i + 1
  end
  var spawn_ms = (time_mono_ns() - t0) / 1_000_000
  puts("spawn x#{str_from_int(N)}: #{str_from_int(spawn_ms)}ms")

  # Phase 2: alive count must equal N. If the hashmap silently dropped
  # entries (the pre-C.14.3a array-cap behavior), this would fail.
  var alive_after_spawn = dynamic_supervisor_alive(dsup)
  if alive_after_spawn != N
    puts("FAIL: alive=#{str_from_int(alive_after_spawn)} (expected #{str_from_int(N)})")
    return 1
  end
  puts("alive() check: #{str_from_int(alive_after_spawn)}")

  # Phase 3: iter visits every child. Validates that the children Vec
  # itself isn't dropping pushes under concurrent watcher iteration.
  # Uses a heap Vec to count because lambda Int captures are by-value
  # (would orphan an outer `visited` counter on the stack).
  var visited_vec = vec_new<Int>()
  dynamic_supervisor_iter(dsup, ib -> visited_vec.push(ib))
  if visited_vec.size != N
    puts("FAIL: iter visited #{str_from_int(visited_vec.size)} (expected #{str_from_int(N)})")
    return 2
  end
  puts("iter visited: #{str_from_int(visited_vec.size)}")

  puts("ALL OK — hashmap waiter table scaled to #{str_from_int(N)} registrations")
  # Bypass dynamic_supervisor_stop (see header comment). _exit doesn't
  # flush stdio buffers, so flush stdout (NULL flushes all) before
  # bypassing the runtime's pthread cleanup that would otherwise block
  # waiting for 100k actor goroutines to terminate.
  fflush(0)
  _exit(0)
  return 0
end
