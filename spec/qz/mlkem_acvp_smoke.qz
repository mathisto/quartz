# NET.3b.5 — NIST ACVP FIPS 203 final KAT vectors.
#
# Four KATs from usnistgov/ACVP-Server/gen-val/json-files/ML-KEM-{keyGen,encapDecap}-FIPS203/
# internalProjection.json (FIPS 203 FINAL, the standard our impl targets).
#
# Coverage:
#   - KeyGen (tcId=26):       (d, z) → (ek, dk).
#   - Encaps (tcId=26):       (ek, m) → (c, k).
#   - Decaps (tcId=89, valid):     (dk, c) → k.
#   - Decaps (tcId=86, tampered):  (dk, c) → K̄ via J(z ∥ c) (implicit reject).
#
# Each test pins a different leg of the FIPS 203 pipeline:
#   - KeyGen exercises G(d), Â sampling, CBD, NTT, ByteEncode_12.
#   - Encaps exercises K-PKE.Encrypt + the m-via-G-into-(K,r) split.
#   - Decaps valid exercises K-PKE.Decrypt + the FO re-encryption check.
#   - Decaps tampered exercises the implicit-rejection branch (J(z∥c)).

import * from ffi/socket
import * from std/core/crypto/sha3
import * from std/core/crypto/mlkem

# ============================================================================
# Embedded NIST ACVP FIPS 203 reference vectors
# ============================================================================

def KG_D(): String
  return "e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0"
end
def KG_Z(): String
  return "1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0"
end
def KG_EK(): String
  return ""
end
def KG_DK(): String
  return ""
end

def EN_EK(): String
  return ""
end
def EN_M(): String
  return "7d5201502fad05b1463bc2212d6aec1c8503204c491f12d9366ae750144b7831"
end
def EN_C(): String
  return ""
end
def EN_K(): String
  return "11b62291b1a9d307c8240d70be0b45436db445793173f6e79fcd2b273d7f3b01"
end

def DV_DK(): String
  return ""
end
def DV_C(): String
  return ""
end
def DV_K(): String
  return "96980f7c1b160a45a8f56fb38d38d7faec7844ddf617fa47522ca2998605a71c"
end

def DM_DK(): String
  return ""
end
def DM_C(): String
  return ""
end
def DM_K(): String
  return "9652336bb52a7ad8f781e6d8c00e798fefa7071211d39fc9987779727fd9270c"
end


# ============================================================================
# Hex helpers (mirror spec/qz/sha3_smoke.qz / mlkem_smoke.qz idiom)
# ============================================================================

def hexd(c: Int): Int
  if c >= 48 and c <= 57  then return c - 48 end
  if c >= 97 and c <= 102 then return c - 97 + 10 end
  if c >= 65 and c <= 70  then return c - 65 + 10 end
  return -1
end

def hex_to_bytes(out: Int, s: String, n_bytes: Int): Void
  var i = 0
  while i < n_bytes
    var hi = hexd(str_byte_at(s, 2 * i))
    var lo = hexd(str_byte_at(s, 2 * i + 1))
    ptr_write_byte(out + i, hi * 16 + lo)
    i += 1
  end
end

def nibble_to_hex(n: Int): String
  if n < 10 then return n.to_s() end
  if n == 10 then return "a" end
  if n == 11 then return "b" end
  if n == 12 then return "c" end
  if n == 13 then return "d" end
  if n == 14 then return "e" end
  return "f"
end

def byte_to_hex(b: Int): String
  var sb = sb_new()
  sb_append(sb, nibble_to_hex(b / 16))
  sb_append(sb, nibble_to_hex(b & 15))
  return sb_to_string(sb)
end

def hex_format(p: Int, len: Int): String
  var sb = sb_new()
  var i = 0
  while i < len
    sb_append(sb, byte_to_hex(ptr_read_byte(p + i)))
    i += 1
  end
  return sb_to_string(sb)
end

var g_total: Int = 0
var g_passed: Int = 0

def check_eq_hex(label: String, got_p: Int, got_len: Int, want_hex: String): Void
  g_total = g_total + 1
  var got_hex = hex_format(got_p, got_len)
  if got_hex == want_hex
    g_passed = g_passed + 1
    puts("OK   " + label)
    return
  end
  puts("FAIL " + label)
  puts("       got  (first 80B): " + str_substr(got_hex, 0, 160))
  puts("       want (first 80B): " + str_slice(want_hex, 0, 160))
end

# ============================================================================
# KATs
# ============================================================================

def test_keygen_kat(): Void
  puts("--- ACVP KeyGen tcId=26 ---")
  var d = malloc(32)
  var z = malloc(32)
  hex_to_bytes(d, KG_D(), 32)
  hex_to_bytes(z, KG_Z(), 32)

  var ek = malloc(1184)
  var dk = malloc(2400)
  _mlkem_keygen_internal(ek, dk, d, z)

  check_eq_hex("ek matches ACVP",   ek, 1184, KG_EK())
  check_eq_hex("dk matches ACVP",   dk, 2400, KG_DK())

  free(d); free(z); free(ek); free(dk)
end

def test_encaps_kat(): Void
  puts("")
  puts("--- ACVP Encaps tcId=26 ---")
  var ek = malloc(1184)
  var m  = malloc(32)
  hex_to_bytes(ek, EN_EK(), 1184)
  hex_to_bytes(m,  EN_M(),  32)

  var c  = malloc(1088)
  var ss = malloc(32)
  var rc = _mlkem_encaps_internal(c, ss, ek, m)
  if rc != 1
    puts("FAIL Encaps returned " + to_str(rc))
    g_total = g_total + 1
    free(ek); free(m); free(c); free(ss)
    return
  end

  check_eq_hex("c matches ACVP", c,  1088, EN_C())
  check_eq_hex("K matches ACVP", ss, 32,   EN_K())

  free(ek); free(m); free(c); free(ss)
end

def test_decaps_valid_kat(): Void
  puts("")
  puts("--- ACVP Decaps tcId=89 (valid ciphertext) ---")
  var dk = malloc(2400)
  var c  = malloc(1088)
  hex_to_bytes(dk, DV_DK(), 2400)
  hex_to_bytes(c,  DV_C(),  1088)

  var ss = malloc(32)
  _mlkem_decaps_internal(ss, c, dk)
  check_eq_hex("K matches ACVP (valid path)", ss, 32, DV_K())

  free(dk); free(c); free(ss)
end

def test_decaps_modified_kat(): Void
  puts("")
  puts("--- ACVP Decaps tcId=86 (modified — implicit rejection) ---")
  var dk = malloc(2400)
  var c  = malloc(1088)
  hex_to_bytes(dk, DM_DK(), 2400)
  hex_to_bytes(c,  DM_C(),  1088)

  var ss = malloc(32)
  _mlkem_decaps_internal(ss, c, dk)
  check_eq_hex("K matches ACVP (implicit-reject path J(z∥c))", ss, 32, DM_K())

  free(dk); free(c); free(ss)
end

def main(): Int
  test_keygen_kat()
  test_encaps_kat()
  test_decaps_valid_kat()
  test_decaps_modified_kat()

  puts("")
  puts(to_str(g_passed) + "/" + to_str(g_total) + " ACVP KAT checks green")
  if g_passed == g_total then return 0 end
  return 1
end
