## Ownership regression for accepted connections rejected before publication.
## The supported supervisor API returns zero without taking fd ownership; the
## server-side caller must close the accepted fd exactly once.

import * from std/net/http_server
import * from std/net/http_dynamic_goroutine_sup

extern "C" def pipe(fds: CPtr): CInt
extern "C" def fcntl(fd: CInt, cmd: CInt, arg: CInt): CInt
extern "C" def close(fd: CInt): CInt

def main(): Int
  sched_init(2)
  var sup = http_dyn_gsup_new()
  var reservation = http_dyn_gsup_reserve(sup)
  if reservation == 0
    return 1
  end

  var fds = mem_alloc(16)
  if pipe(int_to_cptr(fds)) != 0
    return 2
  end
  var accepted_fd = load(fds, 0)
  var peer_fd = load(fds, 1)

  # Stop invalidates the still-available reservation, deterministically making
  # the same supported spawn API used by both accept loops reject publication.
  http_dyn_gsup_stop(sup)
  if http_dyn_gsup_spawn_reserved(sup, reservation, -> 0) != 0
    return 3
  end
  if close(accepted_fd) != 0
    return 4
  end
  # F_GETFD = 1. EBADF is returned as -1 after the caller closes ownership.
  if fcntl(accepted_fd, 1, 0) != -1
    return 5
  end
  if http_dyn_gsup_pending_constructors(sup) != 0
    return 6
  end
  if http_dyn_gsup_abort_claim(sup, reservation) != 0
    return 7
  end

  close(peer_fd)
  sched_shutdown()
  puts("ALL OK")
  return 0
end
