# Test for multi-param enum substitution (6.4.1)

enum TestResult<T, E>
  Ok(value: T)
  Err(error: E)
end

def make_ok(): TestResult<Int, Int>
  TestResult::Ok(42)
end

def make_err(): TestResult<Int, Int>
  TestResult::Err(99)
end

def get_ok<T, E>(r: TestResult<T, E>, fb: T): T
  match r
    TestResult::Ok(x) => x
    TestResult::Err(e) => fb
  end
end

def get_err<T, E>(r: TestResult<T, E>, fb: E): E
  match r
    TestResult::Ok(x) => fb
    TestResult::Err(e) => e
  end
end

def main(): Int
  ok = make_ok()
  err = make_err()
  
  # get_ok should return T (first type param)
  a = get_ok(ok, 0)
  
  # get_err should return E (second type param)
  e = get_err(err, 0)
  
  # Return the extracted values to prove types are correct
  a + e
end
