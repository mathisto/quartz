## Arena Allocator Tests
##
## Contract:
##   1. arena_new returns a non-zero handle.
##   2. arena_alloc returns non-zero pointer, bytes_used reflects allocation.
##   3. arena_reset zeroes bytes_used.
##   4. arena_destroy runs without crash.
##   5. Multiple allocations return distinct addresses.
##   6. @heap allocates struct on heap with accessible fields.
##   7. arena_capacity returns initial block size (65536).
##   8. arena_block_count starts at 1.
##   9. arena_alloc_count is a stub returning -1.
import * from qspec

@value
struct Point
  x: Int
  y: Int
end

def main(): Int
  describe("arenas") do ->
    it("creates new arena") do ->
      var a = arena_new()
      assert_ne(a, 0)
      arena_destroy(a)
    end

    it("allocates from arena") do ->
      var a = arena_new()
      var ptr = arena_alloc(a, 64)
      assert_ne(ptr, 0)
      assert_gt(arena_bytes_used(a), 63)
      arena_destroy(a)
    end

    it("resets arena freeing all allocations") do ->
      var a = arena_new()
      arena_alloc(a, 128)
      assert_gt(arena_bytes_used(a), 0)
      arena_reset(a)
      assert_eq(arena_bytes_used(a), 0)
      arena_destroy(a)
    end

    it("destroys arena") do ->
      var a = arena_new()
      arena_alloc(a, 32)
      arena_destroy(a)
      # If we get here without crashing, the test passes
      assert_eq(0, 0)
    end

    it("multiple allocations return different addresses") do ->
      var a = arena_new()
      var p1 = arena_alloc(a, 64)
      var p2 = arena_alloc(a, 64)
      assert_ne(p1, p2)
      arena_destroy(a)
    end

    it("@heap allocates struct") do ->
      var p = @heap Point { x: 10, y: 20 }
      assert_eq(p.x, 10)
      assert_eq(p.y, 20)
    end

    it("arena reports capacity") do ->
      var a = arena_new()
      assert_eq(arena_capacity(a), 65536)
      arena_destroy(a)
    end

    it("arena starts with one block") do ->
      var a = arena_new()
      assert_eq(arena_block_count(a), 1)
      arena_destroy(a)
    end

    it("bytes_used tracks multiple allocations") do ->
      var a = arena_new()
      arena_alloc(a, 8)
      arena_alloc(a, 16)
      # Each allocation is 8-byte aligned, so 8 + 16 = 24 bytes minimum
      assert_gt(arena_bytes_used(a), 23)
      arena_destroy(a)
    end

    it("reset allows reuse of arena space") do ->
      var a = arena_new()
      arena_alloc(a, 64)
      var used_before = arena_bytes_used(a)
      arena_reset(a)
      assert_eq(arena_bytes_used(a), 0)
      # After reset, we can allocate again from the same block
      arena_alloc(a, 64)
      var used_after = arena_bytes_used(a)
      assert_eq(used_before, used_after)
      arena_destroy(a)
    end

    it("arena_alloc_count tracks allocations and resets") do ->
      var a = arena_new()
      assert_eq(arena_alloc_count(a), 0)
      var p1 = arena_alloc(a, 16)
      assert_eq(arena_alloc_count(a), 1)
      var p2 = arena_alloc(a, 32)
      assert_eq(arena_alloc_count(a), 2)
      arena_reset(a)
      assert_eq(arena_alloc_count(a), 0)
      arena_destroy(a)
    end
  end

  return qspec_main()
end
