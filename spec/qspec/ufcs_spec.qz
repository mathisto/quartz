## UFCS (Uniform Function Call Syntax) Tests
##
## Contract:
##   1. Basic transformation.
##   2. Method chaining.
##   3. With structs.
##   4. With strings.
##   5. With vectors.
##   6. Edge cases.
##   7. With struct field access.
##   8. With builtins.

import * from qspec

struct UPoint
  x: Int
  y: Int
end

struct UContainer
  items: Vec
end

def main(): Int
  describe("basic transformation") do ->
    it("transforms x.f(y) into f(x, y)") do ->
      assert_output("15\n", ufcs_add_test)
    end

    it("transforms x.f() into f(x) for single-arg functions") do ->
      assert_output("42\n", ufcs_double_test)
    end

    it("works with variables as receiver") do ->
      assert_output("49\n", ufcs_square_test)
    end
  end

  describe("method chaining") do ->
    it("supports chained UFCS calls") do ->
      assert_output("11\n", ufcs_chain_test)
    end

    it("supports longer chains") do ->
      assert_output("10\n", ufcs_long_chain_test)
    end
  end

  describe("with structs") do ->
    it("enables method-like calls on structs") do ->
      assert_output("7\n", ufcs_struct_test)
    end
  end

  describe("with strings") do ->
    it("works with string builtins") do ->
      assert_output("5\n", ufcs_string_test)
    end
  end

  describe("with vectors") do ->
    it("enables fluent vector operations") do ->
      assert_output("3\n20\n", ufcs_vec_test)
    end
  end

  describe("edge cases") do ->
    it("works with complex expressions as receiver") do ->
      assert_output("10\n", ufcs_complex_receiver_test)
    end

    it("works with parenthesized expressions") do ->
      assert_output("14\n", ufcs_paren_test)
    end
  end

  describe("with struct field access") do ->
    it("allows UFCS on struct field containing Vec") do ->
      assert_output("42\n", ufcs_struct_field_vec_test)
    end
  end

  describe("with builtins") do ->
    it("allows UFCS on local vec from vec_new") do ->
      assert_output("1\n", ufcs_vec_push_size_test)
    end

    it("allows UFCS on local map from map_new") do ->
      assert_output("1\n", ufcs_map_test)
    end

    it("allows UFCS on local stringbuilder from sb_new") do ->
      assert_output("5\n", ufcs_sb_test)
    end
  end

  # ===========================================================================
  # UFCS advanced patterns (TEST.2 Phase 6)
  # ===========================================================================
  describe("UFCS advanced patterns") do ->
    it("UFCS chains with different return types") do ->
      # Int -> double -> add -> result (all Int)
      result = 5.ufcs_u_double().ufcs_u_add(3)
      assert_eq(result, 13)
    end

    it("UFCS on function call result") do ->
      result = ufcs_u_get_value().ufcs_u_double().ufcs_u_triple()
      assert_eq(result, 30)
    end

    it("UFCS on arithmetic expression") do ->
      result = (3 + 4).ufcs_u_double()
      assert_eq(result, 14)
    end
  end

  return qspec_main()
end

def ufcs_u_add(a: Int, b: Int): Int
  return a + b
end

def ufcs_u_double(x: Int): Int
  return x * 2
end

def ufcs_u_square(x: Int): Int
  return x * x
end

def ufcs_u_add_one(x: Int): Int
  return x + 1
end

def ufcs_u_triple(x: Int): Int
  return x * 3
end

def ufcs_u_get_value(): Int
  return 5
end

def ufcs_u_point_sum(p: UPoint): Int
  return p.x + p.y
end

def ufcs_add_test(): Void
  result = 10.ufcs_u_add(5)
  print_int(result)
end

def ufcs_double_test(): Void
  result = 21.ufcs_u_double()
  print_int(result)
end

def ufcs_square_test(): Void
  n = 7
  result = n.ufcs_u_square()
  print_int(result)
end

def ufcs_chain_test(): Void
  result = 5.ufcs_u_double().ufcs_u_add_one()
  print_int(result)
end

def ufcs_long_chain_test(): Void
  result = 1.ufcs_u_double().ufcs_u_triple().ufcs_u_add(4)
  print_int(result)
end

def ufcs_struct_test(): Void
  p = UPoint { x: 3, y: 4 }
  result = p.ufcs_u_point_sum()
  print_int(result)
end

def ufcs_string_test(): Void
  s = "hello"
  len = s.size
  print_int(len)
end

def ufcs_vec_test(): Void
  v = vec_new()
  v.vec_push(10)
  v.vec_push(20)
  v.vec_push(30)
  len = v.size
  print_int(len)
  val = v.vec_get(1)
  print_int(val)
end

def ufcs_complex_receiver_test(): Void
  result = ufcs_u_get_value().ufcs_u_double()
  print_int(result)
end

def ufcs_paren_test(): Void
  result = (3 + 4).ufcs_u_double()
  print_int(result)
end

def ufcs_struct_field_vec_test(): Void
  var c = UContainer { items: vec_new() }
  c.items.push(42)
  print_int(c.items[0])
end

def ufcs_vec_push_size_test(): Void
  var v = vec_new()
  v.push(42)
  print_int(v.size)
end

def ufcs_map_test(): Void
  var m = map_new()
  m.set("key", 42)
  print_int(m.size())
end

def ufcs_sb_test(): Void
  var sb = sb_new()
  sb_append(sb, "hello")
  print_int(sb_size(sb))
end
