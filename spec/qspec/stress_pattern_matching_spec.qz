## STRESS: Pattern Matching Edge Cases
##
## Adversarial tests probing match expression dark corners:
## many arms, nested match, complex destructuring, guards,
## generic enum matching, exhaustiveness, and edge cases.
##
## Contract:
##   1. Match: many arms.
##   2. Match: nested.
##   3. Match: enum destructuring.
##   4. Match: guards.
##   5. Match: generic enums.
##   6. Match: as expression.
##   7. Match: edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Many-Arm Match Statements
  # ===========================================================================
  describe("match: many arms") do ->
    it("match with 15 integer arms") do ->
      assert_run_exits("""
        def classify(x: Int): Int
          return match x
            1 => 100
            2 => 200
            3 => 300
            4 => 400
            5 => 500
            6 => 600
            7 => 700
            8 => 800
            9 => 900
            10 => 1000
            11 => 1100
            12 => 1200
            13 => 1300
            14 => 1400
            15 => 1500
            _ => 0
          end
        end
        def main(): Int
          if classify(7) == 700
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("match with string literal arms") do ->
      assert_run_exits("""
        def classify(s: String): Int
          return match s
            "hello" => 1
            "world" => 2
            "foo" => 3
            "bar" => 4
            "baz" => 5
            _ => 0
          end
        end
        def main(): Int
          if classify("world") == 2
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("match on boolean literals true/false") do ->
      assert_run_exits("""
        def main(): Int
          x = true
          result = match x
            true => 42
            false => 0
          end
          return result
        end
        """, 42)
    end

    it("match on boolean with false branch taken") do ->
      assert_run_exits("""
        def main(): Int
          x = false
          result = match x
            true => 0
            false => 42
          end
          return result
        end
        """, 42)
    end

    it("match boolean in function") do ->
      assert_run_exits("""
        def bool_to_int(b: Bool): Int
          return match b
            true => 1
            false => 0
          end
        end
        def main(): Int
          a = bool_to_int(true)
          b = bool_to_int(false)
          if a == 1
            if b == 0
              return 42
            end
          end
          return 0
        end
        """, 42)
    end

    it("match boolean with wildcard fallback") do ->
      assert_run_exits("""
        def main(): Int
          x = true
          result = match x
            false => 0
            _ => 42
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Nested Match
  # ===========================================================================
  describe("match: nested") do ->
    it("match inside match arm") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          y = 3
          result = match x
            1 => 0
            2 => match y
              1 => 10
              2 => 20
              3 => 42
              _ => 0
            end
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("three-level nested match") do ->
      assert_run_exits("""
        def main(): Int
          a = 1
          b = 2
          c = 3
          result = match a
            1 => match b
              2 => match c
                3 => 42
                _ => 0
              end
              _ => 0
            end
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match result used in outer match") do ->
      assert_run_exits("""
        def inner(x: Int): Int
          return match x
            1 => 10
            2 => 20
            _ => 0
          end
        end
        def main(): Int
          val = inner(2)
          result = match val
            10 => 0
            20 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Enum Destructuring
  # ===========================================================================
  describe("match: enum destructuring") do ->
    it("simple enum variant destructure") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Square(side: Int)
          Point
        end
        def main(): Int
          s = Shape::Circle(42)
          match s
            Shape::Circle(r) => return r
            Shape::Square(s) => return s
            Shape::Point => return 0
          end
        end
        """, 42)
    end

    it("enum with multiple payload fields") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Rectangle(width: Int, height: Int)
          Point
        end
        def main(): Int
          s = Shape::Rectangle(6, 7)
          match s
            Shape::Rectangle(w, h) => return w * h
            Shape::Circle(r) => return r
            Shape::Point => return 0
          end
        end
        """, 42)
    end

    it("enum with three payload fields") do ->
      assert_run_exits("""
        enum Triple
          Value(a: Int, b: Int, c: Int)
          Empty
        end
        def main(): Int
          t = Triple::Value(10, 20, 12)
          match t
            Triple::Value(a, b, c) => return a + b + c
            Triple::Empty => return 0
          end
        end
        """, 42)
    end

    it("wildcard in multi-field destructure") do ->
      assert_run_exits("""
        enum Pair
          Both(x: Int, y: Int)
          Neither
        end
        def main(): Int
          p = Pair::Both(99, 42)
          match p
            Pair::Both(_, y) => return y
            Pair::Neither => return 0
          end
        end
        """, 42)
    end

    it("mixed single and multi-field enum arms") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Rectangle(width: Int, height: Int)
          Point
        end
        def area(s: Shape): Int
          return match s
            Shape::Circle(r) => r * r * 3
            Shape::Rectangle(w, h) => w * h
            Shape::Point => 0
          end
        end
        def main(): Int
          if area(Shape::Rectangle(6, 7)) == 42
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("wildcard in enum match") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          c = Color::Green
          result = match c
            Color::Red => 0
            _ => 42
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Match with Guards
  # ===========================================================================
  describe("match: guards") do ->
    it("simple match guard") do ->
      assert_run_exits("""
        def main(): Int
          n = 50
          result = match n
            x if x > 40 => x
            _ => 0
          end
          return result
        end
        """, 50)
    end

    it("guard with computation") do ->
      assert_run_exits("""
        def main(): Int
          n = 7
          result = match n
            x if x * x > 40 => x
            _ => 0
          end
          return result
        end
        """, 7)
    end

    it("guard with multiple arms") do ->
      assert_run_exits("""
        def classify(n: Int): Int
          return match n
            x if x > 100 => 3
            x if x > 50 => 2
            x if x > 0 => 1
            _ => 0
          end
        end
        def main(): Int
          a = classify(200)
          b = classify(75)
          c = classify(25)
          d = classify(0)
          if a == 3
            if b == 2
              if c == 1
                if d == 0
                  return 42
                end
              end
            end
          end
          return 0
        end
        """, 42)
    end

    it("guard with wildcard binding") do ->
      assert_run_exits("""
        def main(): Int
          n = 42
          result = match n
            x if x == 42 => x
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Match on Generic Enum Types
  # ===========================================================================
  describe("match: generic enums") do ->
    it("match on Option<Int>") do ->
      assert_run_exits("""
        enum MyOption<T>
          MySome(value: T)
          MyNone
        end
        def main(): Int
          x = MyOption::MySome(42)
          match x
            MySome(v) => return v
            MyNone => return 0
          end
        end
        """, 42)
    end

    it("generic unwrap function") do ->
      assert_run_exits("""
        def my_unwrap<T>(opt: Option<T>): T
          match opt
            Some(v) => return v
            None => return 0
          end
          return 0
        end
        def main(): Int = my_unwrap(Option::Some(42))
      """, 42)
    end
  end

  # ===========================================================================
  # Category F: Match Expression as Value
  # ===========================================================================
  describe("match: as expression") do ->
    it("match expression assigned to variable") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          result = match x
            1 => 10
            2 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match expression in return") do ->
      assert_run_exits("""
        def compute(x: Int): Int
          return match x
            0 => 0
            1 => 1
            _ => 42
          end
        end
        def main(): Int
          return compute(5)
        end
        """, 42)
    end

    it("match expression in function argument") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          result = add(match 1
            1 => 20
            _ => 0
          end, 22)
          return result
        end
        """, 42)
    end

    it("match with multi-statement brace blocks") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          result = match x
            1 => 0
            2 => {
              var tmp = 20
              tmp = tmp + 22
              tmp
            }
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Edge Cases
  # ===========================================================================
  describe("match: edge cases") do ->
    it("match on 0 (falsy value)") do ->
      assert_run_exits("""
        def main(): Int
          x = 0
          result = match x
            0 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match inside while loop") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          var i = 0
          while i < 5
            val = match i
              0 => 10
              1 => 8
              2 => 12
              3 => 7
              _ => 5
            end
            sum = sum + val
            i = i + 1
          end
          return sum
        end
        """, 42)
    end

    it("match inside if branch") do ->
      assert_run_exits("""
        def main(): Int
          x = 1
          if x > 0
            result = match x
              1 => 42
              _ => 0
            end
            return result
          end
          return 0
        end
        """, 42)
    end
  end

  return qspec_main()
end
