import * from qspec
import * from bytes
import net/http2

# ============================================================================
# HTTP/2 Frame Tests
# ============================================================================

def test_parse_settings_frame(): Int
  # SETTINGS frame: type=4, flags=0, stream_id=0
  # Payload: MAX_CONCURRENT_STREAMS(3)=100
  # Setting: id=0x0003, value=0x00000064
  var data = Bytes { _data: [
    0x00, 0x00, 0x06,  # length = 6
    0x04,              # type = SETTINGS
    0x00,              # flags = 0
    0x00, 0x00, 0x00, 0x00,  # stream_id = 0
    0x00, 0x03,        # setting_id = MAX_CONCURRENT_STREAMS
    0x00, 0x00, 0x00, 0x64   # value = 100
  ] }
  var frame = h2_parse_frame(data, 0)
  if frame.length != 6
    return 0
  end
  if frame.frame_type != H2_SETTINGS()
    return 0
  end
  if frame.stream_id != 0
    return 0
  end
  var settings = h2_parse_settings(frame.payload)
  if settings.size != 1
    return 0
  end
  var s = settings[0]
  if s.id == H2_SETTINGS_MAX_CONCURRENT_STREAMS() and s.value == 100
    return 1
  end
  return 0
end

def test_serialize_roundtrip(): Int
  var frame = h2_data_frame(1, h2_string_to_bytes("Hello"), 1)
  var wire = h2_serialize_frame(frame)
  var parsed = h2_parse_frame(wire, 0)
  if parsed.frame_type != H2_DATA()
    return 0
  end
  if parsed.stream_id != 1
    return 0
  end
  if band(parsed.flags, H2_FLAG_END_STREAM()) == 0
    return 0
  end
  if h2_bytes_to_string(parsed.payload) != "Hello"
    return 0
  end
  return 1
end

def test_headers_frame_flags(): Int
  var block = Bytes { _data: [0x82, 0x84] }  # :method GET, :path /
  var frame = h2_headers_frame(3, block, 1, 1)
  if frame.stream_id != 3
    return 0
  end
  if band(frame.flags, H2_FLAG_END_STREAM()) == 0
    return 0
  end
  if band(frame.flags, H2_FLAG_END_HEADERS()) == 0
    return 0
  end
  if frame.payload.size() != 2
    return 0
  end
  return 1
end

def test_goaway_frame(): Int
  var frame = h2_goaway_frame(5, H2_NO_ERROR())
  var wire = h2_serialize_frame(frame)
  var parsed = h2_parse_frame(wire, 0)
  if parsed.frame_type != H2_GOAWAY()
    return 0
  end
  if parsed.length != 8
    return 0
  end
  # Extract last-stream-id from payload
  var p = parsed.payload
  var last_id = shl(band(p.get(0), 0x7F), 24) + shl(p.get(1), 16) + shl(p.get(2), 8) + p.get(3)
  var err = shl(p.get(4), 24) + shl(p.get(5), 16) + shl(p.get(6), 8) + p.get(7)
  if last_id == 5 and err == H2_NO_ERROR()
    return 1
  end
  return 0
end

def test_ping_frame(): Int
  var opaque = Bytes { _data: [1, 2, 3, 4, 5, 6, 7, 8] }
  var frame = h2_ping_frame(opaque, 0)
  if frame.length != 8 or frame.frame_type != H2_PING()
    return 0
  end
  var ack_frame = h2_ping_frame(opaque, 1)
  if band(ack_frame.flags, H2_FLAG_ACK()) == 0
    return 0
  end
  return 1
end

def test_window_update_frame(): Int
  var frame = h2_window_update_frame(7, 32768)
  var wire = h2_serialize_frame(frame)
  var parsed = h2_parse_frame(wire, 0)
  if parsed.frame_type != H2_WINDOW_UPDATE()
    return 0
  end
  if parsed.stream_id != 7
    return 0
  end
  var p = parsed.payload
  var increment = shl(band(p.get(0), 0x7F), 24) + shl(p.get(1), 16) + shl(p.get(2), 8) + p.get(3)
  if increment == 32768
    return 1
  end
  return 0
end

def test_rst_stream_frame(): Int
  var frame = h2_rst_stream_frame(3, H2_CANCEL())
  var wire = h2_serialize_frame(frame)
  var parsed = h2_parse_frame(wire, 0)
  if parsed.frame_type != H2_RST_STREAM() or parsed.stream_id != 3
    return 0
  end
  var p = parsed.payload
  var err = shl(p.get(0), 24) + shl(p.get(1), 16) + shl(p.get(2), 8) + p.get(3)
  if err == H2_CANCEL()
    return 1
  end
  return 0
end

def test_settings_ack(): Int
  var settings = vec_new<H2Setting>()
  var frame = h2_settings_frame(settings, 1)
  if frame.length == 0 and band(frame.flags, H2_FLAG_ACK()) != 0
    return 1
  end
  return 0
end

def test_preface_validation(): Int
  var preface = h2_preface_bytes()
  if h2_validate_preface(preface) == 1
    return 1
  end
  return 0
end

def test_bytes_string_roundtrip(): Int
  var s = "Hello, HTTP/2!"
  var b = h2_string_to_bytes(s)
  var s2 = h2_bytes_to_string(b)
  if s2 == s
    return 1
  end
  return 0
end

def test_frame_size(): Int
  var frame = h2_data_frame(1, h2_string_to_bytes("test"), 0)
  if h2_frame_size(frame) == 13
    return 1
  end
  return 0
end

def main(): Int
  describe("HTTP/2 Frames (RFC 9113)") do ->
    it("parses SETTINGS frame with MAX_CONCURRENT_STREAMS") do ->
      assert_eq(test_parse_settings_frame(), 1)
    end

    it("DATA frame serialize/parse round-trip") do ->
      assert_eq(test_serialize_roundtrip(), 1)
    end

    it("HEADERS frame flags (END_STREAM + END_HEADERS)") do ->
      assert_eq(test_headers_frame_flags(), 1)
    end

    it("GOAWAY frame with last-stream-id and error code") do ->
      assert_eq(test_goaway_frame(), 1)
    end

    it("PING frame with opaque data and ACK flag") do ->
      assert_eq(test_ping_frame(), 1)
    end

    it("WINDOW_UPDATE frame with increment") do ->
      assert_eq(test_window_update_frame(), 1)
    end

    it("RST_STREAM frame with error code") do ->
      assert_eq(test_rst_stream_frame(), 1)
    end

    it("SETTINGS ACK frame has zero length") do ->
      assert_eq(test_settings_ack(), 1)
    end

    it("connection preface validation") do ->
      assert_eq(test_preface_validation(), 1)
    end

    it("bytes↔string round-trip") do ->
      assert_eq(test_bytes_string_roundtrip(), 1)
    end

    it("frame size = 9 + payload length") do ->
      assert_eq(test_frame_size(), 1)
    end
  end

  return qspec_main()
end
