## QZ0220 — undefined type name in parameter position must produce a
## hard typecheck error, not silently erase to Int.
##
## HISTORY: std/toml/manifest.qz referenced `TomlTable` at 8 parameter
## sites without ever defining the name. The compiler accepted it and
## existentially erased the parameter to Int (the i64 universal handle).
## Filed at docs/bugs/TYPECHECK_ACCEPTS_UNDEFINED_TYPE_NAME_AS_PARAM.md.
##
## FIX: `tc_register_function_signature_named` now checks the parsed
## parameter (and return) type for the TYPE_ERROR sentinel; if the
## annotation looks like a simple `[A-Z][A-Za-z0-9_]*` identifier and
## isn't a tp-var of the enclosing function (or its inherited struct
## params for extend methods), the new diagnostic fires. The Map<K,V>
## alias was added to `std/toml/value.qz` so the original eight callsites
## now resolve.
##
## Contract:
##   1. A `def` whose param type is an undefined simple name errors.
##   2. A `def` whose return type is an undefined simple name errors.
##   3. A `def<T>` with a tp-var param compiles (no false positive).
##   4. Built-in primitive types resolve through this path (regression
##      guard for the `StringBuilder` gap surfaced during the fix).
##   5. `type Alias = ...` references resolve through this path.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ0220 undefined type name") do ->
    it("rejects undefined name in parameter position") do ->
      assert_compile_error("""
def takes_tbl(table: TomlTable): Int
  return 0
end

def main(): Int
  return takes_tbl(42)
end
""", "QZ0220")
    end

    it("rejects undefined name in return position") do ->
      assert_compile_error("""
def maker(): WhateverThing
  return 0
end

def main(): Int
  return 0
end
""", "QZ0220")
    end

    it("accepts a tp-var of the enclosing function") do ->
      assert_run_exits("""
def echo_t<T>(x: T): T
  return x
end

def main(): Int
  return echo_t(0)
end
""", 0)
    end

    it("accepts StringBuilder as a parameter type") do ->
      assert_run_exits("""
def write_hi(sb: StringBuilder): Void
  sb_append(sb, "hi")
end

def main(): Int
  var sb = sb_new()
  write_hi(sb)
  return 0
end
""", 0)
    end

    it("accepts a type alias as a parameter type") do ->
      assert_run_exits("""
type Tbl = Map<String, Int>

def takes_tbl(t: Tbl): Int
  return t.size
end

def main(): Int
  var m = map_new<String, Int>()
  m.set("k", 7)
  return takes_tbl(m) - 1
end
""", 0)
    end

  end
  return qspec_main()
end
