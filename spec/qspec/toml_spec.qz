## Toml Tests
##
## Contract:
##   1. Toml lexer.
##   2. Toml parser - scalars.
##   3. Toml parser - tables.
##   4. Toml parser - arrays.
##   5. Toml parser - inline tables.
##   6. Toml parser - advanced.
##   7. Toml parser - errors.
##   8. Toml parser - array of tables.
##   9. Toml parser - floats.
##   10. Toml parser - float lexer.
##   11. Toml Result API.
import * from qspec
import * from toml

def toml_ok_doc(source: String): Map<String, TomlValue>
  var result = toml_parse(source)
  match result
    Ok(doc) =>
      match doc
        TomlValue::Table(t) => return t
        _ => return map_new<String, TomlValue>()
      end
    _ => return map_new<String, TomlValue>()
  end
end

def main(): Int
  describe("toml lexer") do ->
    it("tokenizes punctuation") do ->
      tokens = toml_tokenize("[ ] { } = , .")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "'['")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "'{'")
      t4 = toml_get_token(tokens, 4)
      assert_eq_str(toml_token_kind_name(t4.kind), "'='")
      t5 = toml_get_token(tokens, 5)
      assert_eq_str(toml_token_kind_name(t5.kind), "','")
      t6 = toml_get_token(tokens, 6)
      assert_eq_str(toml_token_kind_name(t6.kind), "'.'")
    end
    it("tokenizes double brackets") do ->
      tokens = toml_tokenize("[[section]]")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "'[['")
      t1 = toml_get_token(tokens, 1)
      assert_eq_str(t1.value, "section")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "']]'")
    end
    it("tokenizes basic strings") do ->
      tokens = toml_tokenize("name = \"hello\"")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "string")
      assert_eq_str(t2.value, "hello")
    end
    it("processes string escape sequences") do ->
      tokens = toml_tokenize("val = \"hello\\nworld\"")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "string")
      assert_eq(str_byte_len(t2.value), 11)
    end
    it("tokenizes literal strings") do ->
      tokens = toml_tokenize("name = 'hello'")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "literal string")
      assert_eq_str(t2.value, "hello")
    end
    it("tokenizes integers") do ->
      tokens = toml_tokenize("port = 8080")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "integer")
      assert_eq_str(t2.value, "8080")
    end
    it("strips underscores from integers") do ->
      tokens = toml_tokenize("big = 1_000_000")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(t2.value, "1000000")
    end
    it("tokenizes booleans") do ->
      tokens = toml_tokenize("flag = true")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "boolean")
      assert_eq_str(t2.value, "true")
    end
    it("tokenizes identifiers") do ->
      tokens = toml_tokenize("my_key = 1")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "identifier")
      assert_eq_str(t0.value, "my_key")
    end
    it("skips comments") do ->
      tokens = toml_tokenize("# a comment\nkey = 1")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "newline")
      t1 = toml_get_token(tokens, 1)
      assert_eq_str(toml_token_kind_name(t1.kind), "identifier")
      assert_eq_str(t1.value, "key")
    end
    it("reports EOF") do ->
      tokens = toml_tokenize("")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "end of file")
    end
    it("reports errors for invalid characters") do ->
      tokens = toml_tokenize("@")
      t0 = toml_get_token(tokens, 0)
      assert_eq_str(toml_token_kind_name(t0.kind), "error")
    end
  end

  describe("toml parser - scalars") do ->
    it("parses string values") do ->
      var doc = toml_ok_doc("name = \"hello\"")
      assert_eq_str(toml_get_string(doc, "name"), "hello")
    end

    it("parses integer values") do ->
      var doc = toml_ok_doc("port = 8080")
      assert_eq(toml_get_int(doc, "port"), 8080)
    end

    it("parses boolean values") do ->
      var doc = toml_ok_doc("flag = true\noff = false")
      assert_eq(toml_get_bool(doc, "flag"), true)
      assert_eq(toml_get_bool(doc, "off"), false)
    end
  end

  describe("toml parser - tables") do ->
    it("parses table sections") do ->
      var doc = toml_ok_doc("[package]\nname = \"test\"\nversion = \"1.0\"")
      assert_eq_str(toml_get_string(doc, "package.name"), "test")
      assert_eq_str(toml_get_string(doc, "package.version"), "1.0")
    end

    it("parses nested tables") do ->
      var doc = toml_ok_doc("[a]\n[a.b]\nval = 42")
      assert_eq(toml_get_int(doc, "a.b.val"), 42)
    end

    it("parses multiple tables") do ->
      var doc = toml_ok_doc("[server]\nhost = \"localhost\"\n[database]\nport = 5432")
      assert_eq_str(toml_get_string(doc, "server.host"), "localhost")
      assert_eq(toml_get_int(doc, "database.port"), 5432)
    end
  end

  describe("toml parser - arrays") do ->
    it("parses simple arrays") do ->
      var doc = toml_ok_doc("nums = [1, 2, 3]")
      var path = toml_get_path(doc, "nums").unwrap()
      var arr = toml_as_array(path)
      assert_eq(vec_size(arr), 3)
    end

    it("parses string arrays") do ->
      var doc = toml_ok_doc("tags = [\"a\", \"b\"]")
      var path = toml_get_path(doc, "tags").unwrap()
      var arr = toml_as_array(path)
      assert_eq(vec_size(arr), 2)
    end

    it("handles trailing commas") do ->
      var doc = toml_ok_doc("items = [1, 2, 3,]")
      var path = toml_get_path(doc, "items").unwrap()
      var arr = toml_as_array(path)
      assert_eq(vec_size(arr), 3)
    end
  end

  describe("toml parser - inline tables") do ->
    it("parses inline tables") do ->
      var doc = toml_ok_doc("point = { x = 1, y = 2 }")
      assert_eq(toml_get_int(doc, "point.x"), 1)
      assert_eq(toml_get_int(doc, "point.y"), 2)
    end

    it("parses nested inline values") do ->
      var doc = toml_ok_doc("dep = { version = \"1.0\", features = [\"a\"] }")
      assert_eq_str(toml_get_string(doc, "dep.version"), "1.0")
    end
  end

  describe("toml parser - advanced") do ->
    it("parses dotted keys") do ->
      var doc = toml_ok_doc("a.b.c = 42")
      assert_eq(toml_get_int(doc, "a.b.c"), 42)
    end

    it("parses a full quartz.toml example") do ->
      var src = "[package]\nname = \"myapp\"\nversion = \"0.1.0\"\n\n[dependencies]\nfoo = \"1.0\""
      var doc = toml_ok_doc(src)
      assert_eq_str(toml_get_string(doc, "package.name"), "myapp")
      assert_eq_str(toml_get_string(doc, "package.version"), "0.1.0")
    end
  end

  describe("toml parser - errors") do ->
    it("reports missing value") do ->
      var result = toml_parse("key = ")
      assert_eq(is_err(result), true)
    end

    it("reports duplicate keys") do ->
      var result = toml_parse("name = \"a\"\nname = \"b\"\n")
      assert_eq(is_err(result), true)
    end
  end

  describe("toml parser - array of tables") do ->
    it("parses array of tables") do ->
      var src = "[[items]]\nname = \"a\"\n[[items]]\nname = \"b\"\n"
      var doc = toml_ok_doc(src)
      var path = toml_get_path(doc, "items").unwrap()
      var arr = toml_as_array(path)
      assert_eq(vec_size(arr), 2)
    end
  end

  describe("toml parser - floats") do ->
    it("parses float values") do ->
      var doc = toml_ok_doc("pi = 3.14")
      var val = toml_get_path(doc, "pi").unwrap()
      assert_eq(toml_is_float(val), true)
    end

    it("parses negative floats") do ->
      var doc = toml_ok_doc("temp = -2.5")
      var val = toml_get_path(doc, "temp").unwrap()
      assert_eq(toml_is_float(val), true)
    end

    it("parses scientific notation") do ->
      var doc = toml_ok_doc("big = 1e6")
      var val = toml_get_path(doc, "big").unwrap()
      assert_eq(toml_is_float(val), true)
    end

    it("distinguishes int from float") do ->
      var doc = toml_ok_doc("a = 42\nb = 3.14")
      assert_eq(toml_is_int(toml_get_path(doc, "a").unwrap()), true)
      assert_eq(toml_is_float(toml_get_path(doc, "b").unwrap()), true)
    end
  end

  describe("toml parser - float lexer") do ->
    it("tokenizes floats correctly") do ->
      tokens = toml_tokenize("val = 3.14")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "float")
      assert_eq_str(t2.value, "3.14")
    end

    it("tokenizes scientific notation") do ->
      tokens = toml_tokenize("val = 1.5e10")
      t2 = toml_get_token(tokens, 2)
      assert_eq_str(toml_token_kind_name(t2.kind), "float")
    end
  end

  describe("toml Result API") do ->
    it("returns Result::Ok for valid TOML") do ->
      var result = toml_parse("key = \"val\"")
      assert_eq(is_ok(result), true)
    end

    it("returns Result::Err with ParseError") do ->
      var result = toml_parse("key = ")
      assert_eq(is_err(result), true)
    end
  end

  return qspec_main()
end
