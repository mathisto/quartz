## MIR perform-op primitive — C.4 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.4).
##
## Verifies that effect-op invocations typed by the C.3 detection block
## lower to MIR_PERFORM_OP (not MIR_CALL), and that `with` blocks bracket
## the body with MIR_HANDLE_INSTALL / MIR_HANDLE_UNINSTALL. C.4 codegen
## stubs these to LLVM IR comments + a zero constant — C.5 will bind the
## evidence vtable. The IR comments (`; piezo: perform_op ...`) are the
## load-bearing assertion target so the tests stay meaningful even before
## runtime semantics land.
##
## Notes for future maintainers:
## - Handler claims use bare PascalCase idents (Throws, Log). Other
##   shapes fall through with an empty effect-name — by design, C.2's
##   narrowing convention.
## - These tests exercise the full pipeline: tc_expr_call C.3 block →
##   AST annotation → mir_lower NODE_CALL diversion → codegen stub. If
##   any layer regresses, the IR comment disappears.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("MIR perform-op primitive (piezo C.4)") do ->
    it("op call inside `can` row lowers to MIR_PERFORM_OP marker") do ->
      assert_ir_contains("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("x")
def main(): Int = risky()
""", "effect: perform_op effect=Throws op=throw")
    end

    it("op call inside `with` body lowers to MIR_PERFORM_OP marker") do ->
      assert_ir_contains("""
effect Throws
  def throw(msg: String): Int
end

def safe(): Int can = with Throws do ->
  throw("oops")
end

def main(): Int = safe()
""", "effect: perform_op effect=Throws op=throw")
    end

    it("`with H do -> body end` brackets body with install + uninstall markers") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def noisy(): Int can = with Log do ->
  emit("hi")
end

def main(): Int = noisy()
""", "effect: handle_install effect=Log")
    end

    it("handle_uninstall marker emitted after with-block body") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def noisy(): Int can = with Log do ->
  emit("hi")
end

def main(): Int = noisy()
""", "effect: handle_uninstall effect=Log")
    end

    it("nested with-blocks emit two install + two uninstall markers") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end
effect Throws
  def throw(msg: String): Int
end

def nested(): Int can = with Log do ->
  with Throws do ->
    emit("hi")
  end
end

def main(): Int = nested()
""", "effect: handle_install effect=Throws")
    end

    it("different op names produce distinct MIR_PERFORM_OP markers") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def noisy(): Int can Log = emit("a")
def main(): Int = noisy()
""", "effect: perform_op effect=Log op=emit")
    end

    it("op call with arguments still lowers via MIR_PERFORM_OP") do ->
      assert_ir_contains("""
effect Throws
  def throw(msg: String): Int
end

def multi(): Int can Throws = throw("panic")
def main(): Int = multi()
""", "effect: perform_op effect=Throws op=throw")
    end

    it("regular function call does NOT lower to MIR_PERFORM_OP") do ->
      assert_compile_succeeds("""
def helper(x: Int): Int = x + 1
def main(): Int = helper(41)
""")
    end
  end
  return qspec_main()
end
