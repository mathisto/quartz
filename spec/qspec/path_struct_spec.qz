## Path Struct Tests
##
## Contract:
##   1. Path_new.
##   2. Join.
##   3. Parent.
##   4. Filename.
##   5. Stem and extension.
##   6. Is_absolute / is_relative.
import * from qspec
import * from io/path

def main(): Int
  describe("path_new") do ->
    it("creates a path from string") do ->
      var p = path_new("/home/user")
      assert_eq_str(p.to_string(), "/home/user")
    end
  end

  describe("join") do ->
    it("joins path segments") do ->
      assert_eq_str(ps_join_test(), "/home/user/docs")
    end

    it("handles trailing slash") do ->
      assert_eq_str(ps_join_trailing(), "/home/user/docs")
    end
  end

  describe("parent") do ->
    it("returns parent directory") do ->
      assert_eq_str(ps_parent_test(), "/home/user")
    end

    it("returns / for root child") do ->
      var p = path_new("/usr")
      assert_eq_str(p.parent().to_string(), "/")
    end

    it("returns . for bare filename") do ->
      var p = path_new("file.txt")
      assert_eq_str(p.parent().to_string(), ".")
    end
  end

  describe("filename") do ->
    it("returns the last component") do ->
      var p = path_new("/home/user/file.txt")
      assert_eq_str(p.filename(), "file.txt")
    end
  end

  describe("stem and extension") do ->
    it("splits filename and extension") do ->
      assert_eq(ps_stem_ext_test(), 1)
    end

    it("returns empty extension for no dot") do ->
      var p = path_new("/home/user/Makefile")
      assert_eq_str(p.extension(), "")
    end
  end

  describe("is_absolute / is_relative") do ->
    it("detects absolute paths") do ->
      assert_eq(path_new("/usr/bin").is_absolute(), 1)
      assert_eq(path_new("src/main.qz").is_relative(), 1)
    end
  end

  return qspec_main()
end

def ps_join_test(): String
  var p = path_new("/home/user")
  return p.join("docs").to_string()
end

def ps_join_trailing(): String
  var p = path_new("/home/user/")
  return p.join("docs").to_string()
end

def ps_parent_test(): String
  var p = path_new("/home/user/docs")
  return p.parent().to_string()
end

def ps_stem_ext_test(): Int
  var p = path_new("/home/user/file.txt")
  if p.stem() == "file"
    if p.extension() == "txt"
      return 1
    end
  end
  return 0
end
