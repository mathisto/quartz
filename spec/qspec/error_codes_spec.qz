## Error Code Catalogue (TEST.2 Phase 0)
##
## Contract: Every compiler error code (QZ####) has at least one test
## validating it appears in stderr output. This file is the living
## specification for compiler diagnostics.
##
## 34 error codes, ~32 active tests + 2 pending (QZ0204, QZ1207).

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ==========================================================================
  # Parse Errors (QZ01xx)
  # ==========================================================================
  describe("parse errors") do ->
    it("QZ0101: missing end keyword") do ->
      assert_compile_error("""
        def main(): Int
          return 0
        """, "QZ0101")
    end

    it("QZ0101: unexpected token in expression") do ->
      assert_compile_error("""
        def main(): Int
          x = @@@
          return 0
        end
        """, "QZ0101")
    end
  end

  # ==========================================================================
  # Mutability / Exhaustiveness (QZ0106)
  # ==========================================================================
  describe("mutability and exhaustiveness") do ->
    it("QZ0106: reassign immutable variable") do ->
      assert_compile_error("""
        def main(): Int
          x = 5
          x = 10
          return x
        end
        """, "QZ0106")
    end

    it("QZ0107: non-exhaustive match on enum") do ->
      assert_compile_error("""
        enum Dir
          Up
          Down
          Left
          Right
        end
        def main(): Int
          match Dir::Up
            Dir::Up => return 1
            Dir::Down => return 2
          end
          return 0
        end
        """, "QZ0107")
    end
  end

  # ==========================================================================
  # Intersection Types (QZ015x)
  # ==========================================================================
  describe("intersection type errors") do ->
    it("QZ0150: impossible intersection type") do ->
      assert_compile_error("""
        def foo(x: Int & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end

    it("QZ0151: record intersection field conflict") do ->
      assert_compile_error("""
        def foo(r: { x: Int } & { x: String }): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0151")
    end
  end

  # ==========================================================================
  # impl Trait Errors (QZ016x)
  # ==========================================================================
  describe("impl Trait errors") do ->
    it("QZ0160: unknown trait in impl return type") do ->
      assert_compile_error("""
        def foo(): impl NonExistentTrait
          return 0
        end
        def main(): Int = 0
        """, "QZ0160")
    end

    it("QZ0161: impl return type conflict across branches") do ->
      assert_compile_error("""
        trait Showable
          def show(self): Int
            return 0
          end
        end
        struct A
          x: Int
        end
        extend A with Showable
          def show(self): Int = self.x
        end
        struct B
          y: Int
        end
        extend B with Showable
          def show(self): Int = self.y
        end
        def get(flag: Int): impl Showable
          if flag > 0
            return A { x: 1 }
          end
          return B { y: 2 }
        end
        def main(): Int = 0
        """, "QZ0161")
    end

    it("QZ0162: concrete type does not implement declared trait") do ->
      assert_compile_error("""
        trait Printable
          def show(self): Int
            return 0
          end
        end
        struct Plain
          x: Int
        end
        def make(): impl Printable
          return Plain { x: 1 }
        end
        def main(): Int = 0
        """, "QZ0162")
    end
  end

  # ==========================================================================
  # Type System Errors (QZ02xx)
  # ==========================================================================
  describe("type system errors") do ->
    it("QZ0200: return type mismatch") do ->
      assert_compile_error("""
        def foo(): Int
          return "hello"
        end
        def main(): Int = 0
        """, "QZ0200")
    end

    it("QZ0201: type mismatch in let binding") do ->
      assert_compile_error("""
        def main(): Int
          x: Int = "hello"
          return 0
        end
        """, "QZ0201")
    end

    it("QZ0202: match arm type mismatch") do ->
      assert_compile_error("""
        def main(): Int
          x = 1
          result = match x
            1 => 42
            _ => "hello"
          end
          return 0
        end
        """, "QZ0202")
    end

    it("QZ0203: type inference conflict in Vec") do ->
      assert_compile_error("""
        def main(): Int
          var v = vec_new()
          v.push(42)
          v.push("hello")
          return 0
        end
        """, "QZ0203")
    end

    it("QZ0204: ambiguous type inference") do ->
      assert_compile_error("""
        def main(): Int
          var x = phantom_fn()
          return 0
        end
        """, "QZ0204")
    end
  end

  # ==========================================================================
  # Name Resolution Errors (QZ03xx, QZ04xx)
  # ==========================================================================
  describe("name resolution errors") do ->
    it("QZ0301: unknown struct") do ->
      assert_compile_error("""
        def main(): Int
          p = NonExistent { x: 1 }
          return 0
        end
        """, "QZ0301")
    end

    it("QZ0302: unknown enum") do ->
      assert_compile_error("""
        def main(): Int
          x = NonExistent::Foo
          return 0
        end
        """, "QZ0302")
    end

    it("QZ0303: unknown field on struct — emitted as QZ0200") do ->
      assert_compile_error("""
        struct Pt
          x: Int
        end
        def main(): Int
          p = Pt { x: 1 }
          return p.z
        end
        """, "QZ0200")
    end

    it("QZ0401: undefined function") do ->
      assert_compile_error("""
        def main(): Int
          return nonexistent_func(42)
        end
        """, "QZ0401")
    end

    it("QZ0403: undefined variable") do ->
      assert_compile_error("""
        def main(): Int
          return nonexistent_var
        end
        """, "QZ0403")
    end
  end

  # ==========================================================================
  # Safety / Ownership Errors (QZ12xx)
  # ==========================================================================
  describe("safety: linear consumption") do ->
    it("QZ1201: linear value not consumed") do ->
      assert_compile_error("""
        linear struct Tok
          x: Int
        end
        def main(): Int
          var t = Tok { x: 1 }
          return 0
        end
        """, "QZ1201")
    end

    it("QZ1202: linear value consumed twice — emitted as QZ1203") do ->
      assert_compile_error("""
        linear struct Tok
          x: Int
        end
        def eat(t: Tok): Int = t.x
        def main(): Int
          var t = Tok { x: 1 }
          eat(t)
          eat(t)
          return 0
        end
        """, "QZ1203")
    end

    it("QZ1203: use of consumed linear value") do ->
      assert_compile_error("""
        linear struct Tok
          x: Int
        end
        def eat(t: Tok): Int = t.x
        def main(): Int
          var t = Tok { x: 1 }
          eat(t)
          var y = t.x
          return y
        end
        """, "QZ1203")
    end

    it("QZ1207: inconsistent linear consumption across branches") do ->
      assert_compile_error("""
        linear struct Tok
          x: Int
        end
        def eat(t: Tok): Int = t.x
        def main(): Int
          var t = Tok { x: 1 }
          if 1 > 0
            eat(t)
          end
          return 0
        end
        """, "QZ1207")
    end

    it("QZ1215: cannot implement both Copy and Drop") do ->
      assert_compile_error("""
        trait Copy
        end
        trait Drop
          def drop(self): Void
          end
        end
        struct Bad
          x: Int
        end
        extend Bad with Copy
        end
        extend Bad with Drop
          def drop(self): Void
          end
        end
        def main(): Int = 0
        """, "QZ1215")
    end
  end

  describe("safety: borrow checking") do ->
    it("QZ1204: borrow of consumed value — emitted as QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          consume(a)
          var r = &a
          return 0
        end
        """, "QZ1212")
    end

    it("QZ1205: conflicting exclusive borrow") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Res { x: 1 }
          var r1 = &mut a
          var r2 = &mut a
          return 0
        end
        """, "QZ1205")
    end

    it("QZ1206: shared borrow conflicts with exclusive borrow") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Res { x: 1 }
          var r1 = &mut a
          var r2 = &a
          return 0
        end
        """, "QZ1206")
    end

    it("QZ1208: mutable borrow of immutable binding") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          a = Res { x: 1 }
          var r = &mut a
          return 0
        end
        """, "QZ1208")
    end

    it("QZ1209: mutation while borrowed") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def use_ref(r: Int): Int = 0
        def main(): Int
          var a = Res { x: 1 }
          var r = &a
          a = Res { x: 2 }
          use_ref(r)
          return 0
        end
        """, "QZ1209")
    end

    it("QZ1210: return borrow of local variable") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def bad(): Int
          var a = Res { x: 1 }
          return &a
        end
        def main(): Int = 0
        """, "QZ1210")
    end

    it("QZ1211: store borrow in struct field") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Holder
          ref: Int
        end
        def main(): Int
          var a = Res { x: 1 }
          var h = Holder { ref: &a }
          return 0
        end
        """, "QZ1211")
    end

    it("QZ1218: dangling borrow — borrow outlives source") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var r = 0
          if 1 == 1
            var a = Res { x: 42 }
            r = &a
          end
          return 0
        end
        """, "QZ1218")
    end
  end

  describe("safety: move semantics") do ->
    it("QZ1212: use of moved value") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Res { x: 1 }
          var b = a
          var c = a
          return 0
        end
        """, "QZ1212")
    end

    it("QZ1214: inconsistent move across match arms") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end

    it("QZ1216: use of moved field — partial move") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Inner
          val: Int
        end
        extend Inner with Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Outer
          a: Inner
          b: Int
        end
        extend Outer with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(i: Inner): Int = i.val
        def main(): Int
          var o = Outer { a: Inner { val: 1 }, b: 2 }
          consume(o.a)
          var x = o.a
          return 0
        end
        """, "QZ1216")
    end
  end

  return qspec_main()
end
