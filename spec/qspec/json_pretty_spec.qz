## JSON Pretty Printing Tests
##
## Contract:
##   1. Empty: empty object/array pretty prints as {}/ [].
##   2. Nested: nested objects indented correctly.
##   3. Arrays: array elements on separate lines.
##   4. Mixed: objects containing arrays and vice versa.
import * from qspec
import * from json

def main(): Int
  describe("JSON pretty printing") do ->
    it("pretty prints empty object") do ->
      assert_eq_str(json_stringify_pretty(json_object(), 2), "{}")
    end

    it("pretty prints empty array") do ->
      assert_eq_str(json_stringify_pretty(json_array(), 2), "[]")
    end

    it("pretty prints simple object") do ->
      var obj = json_object()
      json_object_set(obj, "name", json_string("test"))
      var result = json_stringify_pretty(obj, 2)
      assert_eq(str_contains(result, "\"name\""), 1)
      assert_eq(str_contains(result, "\"test\""), 1)
    end

    it("pretty prints simple values") do ->
      assert_eq_str(json_stringify_pretty(json_null(), 2), "null")
      assert_eq_str(json_stringify_pretty(json_bool(1), 2), "true")
      assert_eq_str(json_stringify_pretty(json_number(99), 2), "99")
    end

    it("pretty prints false boolean") do ->
      assert_eq_str(json_stringify_pretty(json_bool(0), 2), "false")
    end

    it("pretty prints negative number") do ->
      assert_eq_str(json_stringify_pretty(json_number(-42), 2), "-42")
    end
  end

  return qspec_main()
end
