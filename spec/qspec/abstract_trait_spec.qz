## Abstract Trait Method Tests
##
## Contract:
##   1. Abstract methods (bodyless) parse correctly in trait blocks
##   2. Impl must provide all abstract methods — defaults not synthesized
##   3. Mix of abstract and default methods works
##   4. Abstract methods with Self type work
##   5. Abstract method with multiple params works
##   6. Trait with only abstract methods works

import * from qspec

# -- Trait with one abstract and one default --

struct AbsPoint
  x: Int
  y: Int
end

trait AbsDescribe
  def abs_label(self): String
  def abs_summary(self): String = "#{self.abs_label()}: done"
end

extend AbsPoint with AbsDescribe
  def abs_label(self): String = "(#{@x}, #{@y})"
end

# -- Trait with all abstract methods --

struct AbsRect
  w: Int
  h: Int
end

trait AbsShape
  def abs_area(self): Int
  def abs_perimeter(self): Int
  def abs_name(self): String
end

extend AbsRect with AbsShape
  def abs_area(self): Int = @w * @h
  def abs_perimeter(self): Int = 2 * (@w + @h)
  def abs_name(self): String = "rect"
end

# -- Abstract method with Self return type --

struct AbsCounter
  n: Int
end

trait AbsClonable
  def abs_clone(self): Self
end

extend AbsCounter with AbsClonable
  def abs_clone(self): Self = AbsCounter { n: @n }
end

# -- Abstract method with multiple params --

struct AbsPair
  a: Int
  b: Int
end

trait AbsCompare
  def abs_eq(self, other: Self): Bool
  def abs_neq(self, other: Self): Bool = not self.abs_eq(other)
end

extend AbsPair with AbsCompare
  def abs_eq(self, other: Self): Bool = @a == other.a and @b == other.b
end

# -- Trait with abstract + doc comments between methods --

struct AbsVec2
  x: Int
  y: Int
end

trait AbsMath
  ## Returns the magnitude squared
  def abs_mag2(self): Int
  ## Returns string form
  def abs_to_s(self): String
end

extend AbsVec2 with AbsMath
  def abs_mag2(self): Int = @x * @x + @y * @y
  def abs_to_s(self): String = "<#{@x}, #{@y}>"
end

# -- Helpers --

def abs_label_test(): String
  p = AbsPoint { x: 3, y: 4 }
  return p.abs_label()
end

def abs_summary_test(): String
  p = AbsPoint { x: 3, y: 4 }
  return p.abs_summary()
end

def abs_all_abstract_test(): Int
  r = AbsRect { w: 5, h: 3 }
  return r.abs_area() + r.abs_perimeter()
end

def abs_name_test(): String
  r = AbsRect { w: 1, h: 1 }
  return r.abs_name()
end

def abs_clone_test(): Int
  c = AbsCounter { n: 42 }
  d = c.abs_clone()
  return d.n
end

def abs_eq_test(): Int
  a = AbsPair { a: 1, b: 2 }
  b = AbsPair { a: 1, b: 2 }
  c = AbsPair { a: 3, b: 4 }
  var result = 0
  if a.abs_eq(b)
    result += 1
  end
  if a.abs_neq(c)
    result += 10
  end
  return result
end

def abs_doc_comment_test(): String
  v = AbsVec2 { x: 3, y: 4 }
  return v.abs_to_s()
end

def abs_mag2_test(): Int
  v = AbsVec2 { x: 3, y: 4 }
  return v.abs_mag2()
end

def main(): Int
  describe("abstract trait methods") do ->
    it("abstract method implemented correctly") do ->
      assert_eq_str(abs_label_test(), "(3, 4)")
    end

    it("default method calls abstract method") do ->
      assert_eq_str(abs_summary_test(), "(3, 4): done")
    end

    it("all-abstract trait fully implemented") do ->
      assert_eq(abs_all_abstract_test(), 31)
    end

    it("abstract method returning String") do ->
      assert_eq_str(abs_name_test(), "rect")
    end

    it("abstract method with Self return type") do ->
      assert_eq(abs_clone_test(), 42)
    end

    it("abstract + default mix with Self param") do ->
      assert_eq(abs_eq_test(), 11)
    end

    it("abstract methods with doc comments between") do ->
      assert_eq_str(abs_doc_comment_test(), "<3, 4>")
    end

    it("abstract method computing value") do ->
      assert_eq(abs_mag2_test(), 25)
    end
  end

  return qspec_main()
end
