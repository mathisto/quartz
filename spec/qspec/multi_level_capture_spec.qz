## Multi-level closure capture tests
## Covers: F.4 multi-level closure capture fix
##
## Contract:
##   1. Multi-level: 2/3/4-level closure capture chains.
##   2. Spawn: spawn with closure capture.
##   3. Intermediate: 3-level with intermediate local binding.
##   4. Multi-var: 3-level capturing multiple variables.
##   5. Shadow: nested closure with parameter shadowing.
##   6. Arithmetic: 2-level closure with arithmetic.
##   7. Chained: 3-level with chained operations.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Multi-level closure capture (was broken before fix)
  # ===========================================================================
  describe("multi-level closure capture") do ->
    it("2-level: lambda captures from enclosing function") do ->
      assert_run_exits("""
        def add2(x: Int): Int = x + 2
        def main(): Int
          var x = 40
          var f = -> { add2(x) }
          return f()
        end
        """, 42)
    end

    it("3-level: nested lambda captures from grandparent scope") do ->
      assert_run_exits("""
        def add2(x: Int): Int = x + 2
        def main(): Int
          var x = 40
          var outer = -> {
            var inner = -> { add2(x) }
            inner()
          }
          return outer()
        end
        """, 42)
    end

    it("4-level: deeply nested closure chain") do ->
      assert_run_exits("""
        def add4(x: Int): Int = x + 4
        def main(): Int
          var x = 38
          var a = -> {
            var b = -> {
              var c = -> { add4(x) }
              c()
            }
            b()
          }
          return a()
        end
        """, 42)
    end

    it("3-level with intermediate local binding") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          var outer = -> {
            var y = x + 20
            var inner = -> { y + 12 }
            inner()
          }
          return outer()
        end
        """, 42)
    end

    it("3-level capturing multiple variables") do ->
      assert_run_exits("""
        def main(): Int
          var a = 10
          var b = 20
          var outer = -> {
            var inner = -> { a + b + 12 }
            inner()
          }
          return outer()
        end
        """, 42)
    end

    it("nested closure with parameter shadowing") do ->
      assert_run_exits("""
        def main(): Int
          var x = 100
          var outer = -> {
            var inner = y -> { y + x }
            inner(-58)
          }
          return outer()
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Spawn with closure capture
  # ===========================================================================
  describe("spawn with closure capture") do ->
    it("spawn captures local variable") do ->
      assert_run_exits("""
        def work(x: Int): Int = x + 2
        def main(): Int
          var x = 40
          var h = go (-> { work(x) })
          return await h
        end
        """, 42)
    end
  end

  describe("additional capture patterns") do ->
    it("2-level closure with arithmetic") do ->
      assert_run_exits("""
        def main(): Int
          var a = 20
          var b = 22
          var f = -> { a + b }
          return f()
        end
        """, 42)
    end

    it("3-level with chained operations") do ->
      assert_run_exits("""
        def main(): Int
          var x = 7
          var outer = -> {
            var y = x * 2
            var inner = -> { y * 3 }
            inner()
          }
          return outer()
        end
        """, 42)
    end
  end

  return qspec_main()
end
