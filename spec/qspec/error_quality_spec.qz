## Error Message Quality Tests (TEST.2 Phase 4)
##
## Contract: Error messages are not just correct but *helpful*.
## Tests match on specific content beyond the error code —
## variable names, suggestions, struct names, specific context.
## Message changes ARE spec changes.
##
##   1. "Did you mean?" suggestions.
##   2. Variable names in type mismatch errors.
##   3. Struct/field names in field errors.
##   4. Specific move/borrow error context.
##   5. Arity mismatch format.
##   6. Non-exhaustive match names missing variant.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ==========================================================================
  # Did You Mean Suggestions
  # ==========================================================================
  describe("did-you-mean suggestions") do ->
    it("unknown struct suggests similar name") do ->
      assert_compile_error("""
        struct Point
          x: Int
        end
        def main(): Int
          p = Piont { x: 1 }
          return 0
        end
        """, "Point")
    end

    it("unknown function includes function name in error") do ->
      assert_compile_error("""
        def main(): Int
          return frobnicate(42)
        end
        """, "frobnicate")
    end

    it("undefined variable includes variable name") do ->
      assert_compile_error("""
        def main(): Int
          return nonexistent_var
        end
        """, "nonexistent_var")
    end

    it("transposition typo in fn call suggests via edit distance") do ->
      assert_compile_error("""
        def validate(x: Int): Int = x + 1
        def main(): Int
          return vaildate(5)
        end
        """, "Did you mean 'validate'?")
    end

    it("unknown type annotation suggests similar type") do ->
      assert_compile_error("""
        def main(): Int
          var x: Integr = 5
          return x
        end
        """, "Did you mean 'Int'?")
    end

    it("undefined variable suggests in-scope binding") do ->
      assert_compile_error("""
        def main(): Int
          username = 42
          return usernme
        end
        """, "Did you mean 'username'?")
    end

    it("unknown method suggests near-miss method on receiver type") do ->
      assert_compile_error("""
        struct P
          x: Int
        end
        impl P
          def magnitude(self): Int
            return self.x * self.x
          end
        end
        def main(): Int
          p = P { x: 3 }
          return p.magnitutde()
        end
        """, "Did you mean 'magnitude'?")
    end
  end

  # ==========================================================================
  # Type Mismatch Details
  # ==========================================================================
  describe("type mismatch details") do ->
    it("type mismatch mentions expected type") do ->
      assert_compile_error("""
        def foo(): Int
          return "hello"
        end
        def main(): Int = 0
        """, "Int")
    end

    it("type mismatch mentions actual type") do ->
      assert_compile_error("""
        def foo(): Int
          return "hello"
        end
        def main(): Int = 0
        """, "String")
    end

    it("match arm mismatch mentions both types") do ->
      assert_compile_error("""
        def main(): Int
          x = 1
          result = match x
            1 => 42
            _ => "hello"
          end
          return 0
        end
        """, "mismatch")
    end

    # A1: the QZ0201 expected/found note branch used to search for "but got "
    # which never matched the annotation-conflict message family, so the note
    # was DEAD. It must now render `= expected: <ann>` / `= found: <inferred>`.
    it("annotation conflict renders the expected note (A1, was dead)") do ->
      assert_compile_error("""
        def main(): Int
          x: Int = "hello"
          return 0
        end
        """, "expected: Int")
    end

    it("annotation conflict renders the found note (A1, was dead)") do ->
      assert_compile_error("""
        def main(): Int
          x: Int = "hello"
          return 0
        end
        """, "found:    String")
    end

    # A7: codes with a rich `--explain` entry (QZ0201 has one) get an inline
    # pointer note so users discover the detailed docs. The central emit loop
    # keys the pointer on the explain table's own lookup, so it renders the
    # actual code in the message.
    it("code with an explain entry gets a --explain pointer (A7)") do ->
      assert_compile_error("""
        def main(): Int
          x: Int = "hello"
          return 0
        end
        """, "quartz --explain QZ0201")
    end
  end

  # ==========================================================================
  # Struct and Field Error Details
  # ==========================================================================
  describe("struct and field error details") do ->
    it("unknown struct name appears in error") do ->
      assert_compile_error("""
        def main(): Int
          p = FooBarBaz { x: 1 }
          return 0
        end
        """, "FooBarBaz")
    end

    it("unknown field name appears in error") do ->
      assert_compile_error("""
        struct Pt
          x: Int
          y: Int
        end
        def main(): Int
          p = Pt { x: 1, y: 2 }
          return p.z
        end
        """, "z")
    end

    it("unknown enum name appears in error") do ->
      assert_compile_error("""
        def main(): Int
          x = FakeEnum::Variant
          return 0
        end
        """, "FakeEnum")
    end

    # A2: the caret span now underlines the offending name (its full length)
    # for QZ0303/QZ0200/QZ0106 instead of a single `^`. Caret WIDTH is a layout
    # property that assert_compile_error (substring match) cannot check — that
    # is verified by eye in the implementer's report. These arms only pin that
    # the message shape the span-extractor keys on is still emitted.
    it("no-method error names the method (A2 span keys on this shape)") do ->
      assert_compile_error("""
        struct P
          x: Int
        end
        def main(): Int
          p = P { x: 1 }
          return p.frobnicate()
        end
        """, "has no method 'frobnicate'")
    end
  end

  # ==========================================================================
  # Move and Borrow Error Specificity
  # ==========================================================================
  describe("move error specificity") do ->
    it("QZ1212 mentions the moved variable name") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Obj
          val: Int
        end
        extend Obj with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var myobj = Obj { val: 1 }
          var other = myobj
          var again = myobj
          return 0
        end
        """, "myobj")
    end

    it("QZ1201 mentions the unconsumed variable name") do ->
      assert_compile_error("""
        linear struct Token
          id: Int
        end
        def main(): Int
          var tok = Token { id: 42 }
          return 0
        end
        """, "tok")
    end
  end

  # ==========================================================================
  # Arity Mismatch
  # ==========================================================================
  describe("arity mismatch details") do ->
    it("wrong argument count mentions the function name") do ->
      assert_compile_error("""
        def foo(a: Int, b: Int): Int = a + b
        def main(): Int = foo(1)
        """, "foo")
    end

    it("too many arguments includes count context") do ->
      assert_compile_error("""
        def bar(x: Int): Int = x
        def main(): Int = bar(1, 2, 3)
        """, "bar")
    end

    # A3: a fixed-arity function must NOT say "at least" (implies variadic/
    # default params) — it says "requires N arguments".
    it("fixed-arity under-application says 'requires N arguments' (A3)") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int = add(1)
        """, "requires 2 arguments")
    end

    # A3: the error carries a signature note reconstructed from the recorded
    # param names + annotations.
    it("under-application carries a signature note (A3)") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int = add(1)
        """, "add is defined as add(a: Int, b: Int)")
    end

    it("too many arguments also carries a signature note (A3)") do ->
      assert_compile_error("""
        def bar(x: Int): Int = x
        def main(): Int = bar(1, 2, 3)
        """, "bar is defined as bar(x: Int)")
    end
  end

  # ==========================================================================
  # Non-Exhaustive Match
  # ==========================================================================
  describe("non-exhaustive match specificity") do ->
    it("QZ0107 mentions the missing variant name") do ->
      assert_compile_error("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          match Color::Red
            Color::Red => 1
            Color::Green => 2
          end
          return 0
        end
        """, "Blue")
    end

    it("QZ0107 offers a catch-all fix-it (A4)") do ->
      assert_compile_error("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          match Color::Red
            Color::Red => 1
            Color::Green => 2
          end
          return 0
        end
        """, "catch-all")
    end
  end

  # ==========================================================================
  # impl Trait Error Details
  # ==========================================================================
  describe("impl Trait error specificity") do ->
    it("QZ0160 mentions the unknown trait name") do ->
      assert_compile_error("""
        def foo(): impl Quuxable
          return 0
        end
        def main(): Int = 0
        """, "Quuxable")
    end

    it("QZ0162 mentions the concrete type") do ->
      assert_compile_error("""
        trait Showable
          def show(self): Int
            return 0
          end
        end
        struct Opaque
          x: Int
        end
        def make(): impl Showable
          return Opaque { x: 1 }
        end
        def main(): Int = 0
        """, "Opaque")
    end

    it("QZ0162 trait-bound offers an impl fix-it (A6)") do ->
      assert_compile_error("""
        trait Showable
          def show(self): Int
            return 0
          end
        end
        struct Opaque
          x: Int
        end
        def make(): impl Showable
          return Opaque { x: 1 }
        end
        def main(): Int = 0
        """, "add 'impl")
    end
  end

  # ==========================================================================
  # Intersection Type Error Details
  # ==========================================================================
  describe("intersection type error details") do ->
    it("QZ0150 mentions the impossible type annotation") do ->
      assert_compile_error("""
        def foo(x: Bool & String): Int
          return 0
        end
        def main(): Int = 0
        """, "Bool")
    end
  end

  # ==========================================================================
  # Hallucinated-keyword parse diagnostics (top newcomer traps)
  # ==========================================================================
  describe("hallucinated-keyword parse diagnostics") do ->
    it("'->' return-type arrow points to ':'") do ->
      assert_compile_error("""
        def main() -> Int
          return 0
        end
        """, "is not a return-type separator")
    end

    it("'let' binding suggests const/var forms") do ->
      assert_compile_error("""
        def main(): Int
          let x = 5
          return x
        end
        """, "Quartz has no 'let'")
    end

    it("'fn' function keyword suggests 'def'") do ->
      assert_compile_error("""
        fn main(): Int
          return 0
        end
        """, "use `def` to define a function")
    end

    it("'mut x = 5' suggests var (#5)") do ->
      assert_compile_error("""
        def main(): Int
          mut x = 5
          return 0
        end
        """, "use `var x = 5` for a mutable binding")
    end

    it("'import a::b' suggests '/' separator (#6)") do ->
      assert_compile_error("""
        import a::b
        def main(): Int
          return 0
        end
        """, "import paths use '/' not '::'")
    end

    # #7: a leading `*ident` (Rust/C deref) at expression-start gets a targeted
    # note that Quartz has no dereference operator. Only the `*ident` shape is
    # handled — the `|x|` pipe-lambda half is deliberately NOT implemented.
    it("'*x' deref gets a no-dereference-operator note (#7)") do ->
      assert_compile_error("""
        def main(): Int
          x = 5
          y = *x
          return 0
        end
        """, "no dereference operator")
    end
  end

  # ==========================================================================
  # Missing-return fix-it (A5)
  # ==========================================================================
  describe("missing-return diagnostics") do ->
    # A5: a function that declares a non-Void return but has no return
    # statement gets an actionable fix-it note.
    it("missing return carries a fix-it help note (A5)") do ->
      assert_compile_error("""
        def foo(): Int
          x = 5
        end
        def main(): Int = 0
        """, "add 'return <expr>', or change the return type to Void")
    end
  end

  return qspec_main()
end
