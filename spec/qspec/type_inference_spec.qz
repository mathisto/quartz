## Type Inference Tests
##
## Contract:
##   1. Literal inference: Int from integer, String from string, Bool from comparison.
##   2. Chain inference: type flows through variable assignment chain.
##   3. Binary operation inference: `a + b` infers from operand types.
##   4. Mutable variable inference: `var x = expr` infers type.
##   5. Loop variable inference: counter variables inferred in while loops.
##   6. Parameter inference: param types inferred from usage (arithmetic, etc.).
##   7. Return type inference: body expression determines return type.
##   8. Polymorphic calls: same function called with multiple concrete types.
##   9. Array inference: element type inferred from literal array.
##  10. Mixed annotations: some params explicit, some inferred.
##  11. Control flow inference: if/while bodies infer types.
##  12. Higher-order function inference: Fn type params.
##  13. Struct field inference: field access type inferred from struct definition.
##  14. Match expression inference: scrutinee and arm types.
##  15. Error: type mismatch in inferred code produces compile error.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("basic inference") do ->
    it("infers Int from integer literal") do ->
      x = 42
      assert_eq(x, 42)
    end

    it("infers String from string literal") do ->
      s = "hello"
      assert_eq(s.size, 5)
    end

    it("infers Bool from comparison") do ->
      b = 5 > 3
      if b
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("infers type through variable chain") do ->
      x = 42
      y = x
      z = y
      assert_eq(z, 42)
    end

    it("infers type from binary operation") do ->
      a = 20
      b = 22
      c = a + b
      assert_eq(c, 42)
    end

    it("infers mutable variable type (var)") do ->
      var x = 42
      x = x + 1
      assert_eq(x, 43)
    end

    it("infers mutable variable used in loop") do ->
      var sum = 0
      var i = 1
      while i <= 10
        sum += i
        i += 1
      end
      assert_eq(sum, 55)
    end
  end

  describe("function parameter inference") do ->
    it("infers parameter types from usage (multiply)") do ->
      assert_eq(ti_double(21), 42)
    end

    it("infers parameter types from addition") do ->
      assert_eq(ti_add(20, 22), 42)
    end

    it("infers identity function") do ->
      assert_eq(ti_identity(42), 42)
    end

    it("infers through nested calls") do ->
      assert_eq(ti_double_inc(40), 42)
    end
  end

  describe("return type inference") do ->
    it("infers return type from body") do ->
      assert_eq(ti_answer(), 42)
    end

    it("infers return type from parameter operation") do ->
      assert_eq(ti_double(21), 42)
    end
  end

  describe("polymorphic functions") do ->
    it("allows same function with Int") do ->
      a = ti_identity(42)
      assert_eq(a, 42)
    end

    it("allows same function with different types (polymorphic)") do ->
      a = ti_identity(42)
      b = ti_identity(7)
      assert_eq(a + b, 49)
    end
  end

  describe("array inference") do ->
    it("infers array element type from literals") do ->
      arr = [1, 2, 3]
      assert_eq(arr[0], 1)
    end

    it("infers array type from usage") do ->
      nums = [20, 22, 100]
      assert_eq(ti_sum_first_two(nums), 42)
    end
  end

  describe("mixed explicit and inferred") do ->
    it("works with partial param annotations") do ->
      assert_eq(ti_add_explicit(20, 22), 42)
    end

    it("works with explicit return, inferred params") do ->
      assert_eq(ti_multiply(6, 7), 42)
    end

    it("explicit param overrides inference") do ->
      assert_eq(ti_use_int(41), 42)
    end
  end

  describe("control flow inference") do ->
    it("infers through if expression") do ->
      assert_eq(ti_max(42, 10), 42)
    end

    it("infers through while loop") do ->
      assert_eq(ti_count_to(42), 42)
    end
  end

  describe("higher-order functions") do ->
    it("infers function parameter type") do ->
      assert_eq(ti_apply(ti_hof_double, 21), 42)
    end
  end

  describe("struct inference") do ->
    it("infers struct field access type") do ->
      pt = TIPoint { x: 42, y: 10 }
      assert_eq(ti_get_x(pt), 42)
    end
  end

  # ===========================================================================
  # Match expression inference
  # ===========================================================================
  describe("match expression inference") do ->
    it("infers type from match arm values") do ->
      result = match 1
        1 => 42
        _ => 0
      end
      assert_eq(result, 42)
    end

    it("infers through match with integer patterns") do ->
      assert_eq(ti_match_val(1), 10)
      assert_eq(ti_match_val(2), 20)
    end
  end

  # ===========================================================================
  # Struct construction inference
  # ===========================================================================
  describe("struct construction inference") do ->
    it("infers struct type from construction") do ->
      p = TIPoint { x: 10, y: 32 }
      assert_eq(p.x + p.y, 42)
    end
  end

  # ===========================================================================
  # Nested call chain inference
  # ===========================================================================
  describe("nested call chain inference") do ->
    it("infers through deeply nested function calls") do ->
      assert_eq(ti_add(ti_double(10), ti_inc(ti_identity(11))), 32)
    end
  end

  # ===========================================================================
  # Negation inference
  # ===========================================================================
  describe("negation inference") do ->
    it("infers type from unary negation") do ->
      x = 42
      y = 0 - x
      assert_eq(y, -42)
    end
  end

  # ===========================================================================
  # Error: conflicting types
  # ===========================================================================
  describe("inference error cases") do ->
    it("Int + String auto-coerces via to_s") do ->
      # String ergonomics: Int + String now wraps Int in to_str()
      assert_run_exits("def main(): Int\n  var x = 42\n  var y = \"hello\"\n  var z = x + y\n  return 0\nend\n", 0)
    end

    it("rejects wrong return type from inferred function") do ->
      assert_compile_error("""
        def bad(): Int
          return "hello"
        end
        def main(): Int
          return 0
        end
        """, "Return type mismatch")
    end
  end

  # ===========================================================================
  # Inference through complex expressions (TEST.2 Phase 6)
  # ===========================================================================
  describe("inference through complex expressions") do ->
    it("infers type through match expression result") do ->
      x = 3
      result = match x
        1 => 10
        2 => 20
        _ => 30
      end
      assert_eq(result, 30)
    end

    it("infers type through if-else expression") do ->
      flag = true
      result = if flag
        42
      else
        0
      end
      assert_eq(result, 42)
    end

    it("infers type through function composition") do ->
      result = ti_double(ti_add(10, 11))
      assert_eq(result, 42)
    end

    it("infers type through nested function calls") do ->
      result = ti_apply(ti_hof_double, 21)
      assert_eq(result, 42)
    end

    it("infers struct field type from definition") do ->
      p = TIPoint { x: 10, y: 20 }
      sum = p.x + p.y
      assert_eq(sum, 30)
    end
  end

  return qspec_main()
end

struct TIPoint
  x: Int
  y: Int
end

def ti_double(x): Int
  return x * 2
end

def ti_add(a, b): Int
  return a + b
end

def ti_identity(x): Int
  return x
end

def ti_inc(x): Int
  return x + 1
end

def ti_double_inc(x): Int
  return ti_inc(ti_inc(x))
end

def ti_answer(): Int
  return 42
end

def ti_triple(x): Int
  return x * 3
end

def ti_sum_first_two(arr): Int
  return arr[0] + arr[1]
end

def ti_add_explicit(x: Int, y): Int
  return x + y
end

def ti_multiply(a, b): Int
  return a * b
end

def ti_use_int(x: Int): Int
  return x + 1
end

def ti_max(a, b): Int
  if a > b
    return a
  end
  return b
end

def ti_count_to(n): Int
  var i = 0
  while i < n
    i += 1
  end
  return i
end

def ti_apply(f: Fn(Int): Int, x): Int
  return f(x)
end

def ti_hof_double(n: Int): Int
  return n * 2
end

def ti_get_x(p: TIPoint): Int
  return p.x
end

def ti_match_val(x): Int
  return match x
    1 => 10
    2 => 20
    _ => 0
  end
end
