## Cross-Module Types Tests - Verifies struct field access across module boundaries
## Tests for Bug 3 (cross-module struct field SIGSEGV)
##
## Contract:
##   1. First field: read first field of cross-module struct.
##   2. Second field: read second field of cross-module struct.
##   3. Wildcard: struct via wildcard import.
##   4. Re-export: struct via re-export chain.
##   5. Parameter: struct as cross-module function parameter.
##   6. Write: struct field write cross-module.
##   7. Three-field: three-field struct across modules.
##   8. Computed: computed expression on cross-module struct fields.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("cross-module struct field access (Bug 3)") do ->
    it("read first field of cross-module struct") do ->
      var files: Vec = vec_new()
      files.push(as_int("types.qz"))
      vec_push(files, as_int("""
        struct Point
          x: Int
          y: Int
        end
        def make_point(a: Int, b: Int): Point
          return Point{x: a, y: b}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import types
        def main(): Int
          var p = types::make_point(10, 20)
          return p.x
        end
        """))
      assert_multi_run_exits(files, 1, 10)
    end

    it("read second field of cross-module struct") do ->
      var files: Vec = vec_new()
      files.push(as_int("types.qz"))
      vec_push(files, as_int("""
        struct Point
          x: Int
          y: Int
        end
        def make_point(a: Int, b: Int): Point
          return Point{x: a, y: b}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import types
        def main(): Int
          var p = types::make_point(10, 20)
          return p.y
        end
        """))
      assert_multi_run_exits(files, 1, 20)
    end

    it("struct via wildcard import") do ->
      var files: Vec = vec_new()
      files.push(as_int("types.qz"))
      vec_push(files, as_int("""
        struct Pair
          a: Int
          b: Int
        end
        def make_pair(x: Int, y: Int): Pair
          return Pair{a: x, b: y}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from types
        def main(): Int
          var p = make_pair(3, 7)
          return p.a + p.b
        end
        """))
      assert_multi_run_exits(files, 1, 10)
    end

    it("struct via re-export chain") do ->
      var files: Vec = vec_new()
      files.push(as_int("token.qz"))
      vec_push(files, as_int("""
        struct Tok
          kind: Int
          val: Int
        end
        def tok_new(k: Int, v: Int): Tok
          return Tok{kind: k, val: v}
        end
        """))
      files.push(as_int("lexer.qz"))
      vec_push(files, as_int("""
        import * from token
        def lex_num(): Tok
          return tok_new(1, 42)
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import lexer
        def main(): Int
          var t = lexer::lex_num()
          return t.val
        end
        """))
      assert_multi_run_exits(files, 2, 42)
    end

    it("struct as function parameter cross-module") do ->
      var files: Vec = vec_new()
      files.push(as_int("data.qz"))
      vec_push(files, as_int("""
        struct Box
          val: Int
        end
        def make_box(n: Int): Box
          return Box{val: n}
        end
        def unbox(b: Box): Int
          return b.val
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import data
        def main(): Int
          var b = data::make_box(55)
          return data::unbox(b)
        end
        """))
      assert_multi_run_exits(files, 1, 55)
    end

    it("struct field write cross-module") do ->
      var files: Vec = vec_new()
      files.push(as_int("data.qz"))
      vec_push(files, as_int("""
        struct Cell
          val: Int
        end
        def make_cell(n: Int): Cell
          return Cell{val: n}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import data
        def main(): Int
          var c = data::make_cell(10)
          c.val = 99
          return c.val
        end
        """))
      assert_multi_run_exits(files, 1, 99)
    end

    it("three-field struct across modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("types.qz"))
      vec_push(files, as_int("""
        struct Vec3
          x: Int
          y: Int
          z: Int
        end
        def make_vec3(a: Int, b: Int, c: Int): Vec3
          return Vec3{x: a, y: b, z: c}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import types
        def main(): Int
          var v = types::make_vec3(10, 20, 12)
          return v.x + v.y + v.z
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end

    it("computed expression on cross-module fields") do ->
      var files: Vec = vec_new()
      files.push(as_int("types.qz"))
      vec_push(files, as_int("""
        struct Rect
          w: Int
          h: Int
        end
        def make_rect(a: Int, b: Int): Rect
          return Rect{w: a, h: b}
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import types
        def main(): Int
          var r = types::make_rect(6, 7)
          return r.w * r.h
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  return qspec_main()
end
