## QSpec coverage for the runtime-blessed Cache default handler (Phase A.3 Pass 1).
##
## Locks in the prelude install + typecheck blessed-relaxation:
##   - `cache_op_lookup(module, hash)` works at module level WITHOUT
##     explicit `with Cache do ... end` ceremony or `can Cache` annotation
##     — analogous to Intern's blessed default.
##   - The runtime default forwards to `build_cache::cache_lookup`, which
##     returns "" when the cache is disabled (no `cache_open` call) —
##     so the spec sees "" without any disk side effects.
##   - User `with Cache { cache_op_lookup: h } do body end` still
##     overrides the default (top-down handler-stack scan).
##
## Out of scope:
##   - End-to-end test-handler value prop with mock interception around
##     `compile()` — that's the Pass 2 spec (cache_effect_pass2_spec.qz),
##     which exercises the migrated callsite at quartz.qz:504.
##   - The other 5 ops (cache_op_store / cache_op_save_pool / etc) — they
##     declare correctly but their default-handler branches are stubs in
##     Pass 1; Phase 3 fleshes them out alongside their consumer
##     migrations.

import * from qspec
import std/cache

# --- Test 1: module-level cache_op_lookup works without with-block, and
#     returns "" on cache miss (cache is disabled by default).

def t1_use(): String
  return cache_op_lookup("nonexistent_module", "deadbeefdeadbeef")
end

def t1_run(): Void
  var result = t1_use()
  if result.eq("")
    puts("miss")
  else
    puts("hit=#{result}")
  end
end

# --- Test 2: user `with Cache { cache_op_lookup: h } do body end`
#     overrides the prelude default. The mock returns a synthetic hit.

var _t2_calls = 0

def t2_mock_lookup(op_name: Int, argc: Int, argv: Int): Int
  _t2_calls = _t2_calls + 1
  return as_int("MOCK_IR_BODY")
end

var _t2_result = ""

def t2_run(): Void
  _t2_calls = 0
  with Cache { cache_op_lookup: t2_mock_lookup } do ->
    _t2_result = cache_op_lookup("any_module", "any_hash")
  end
  puts("result=#{_t2_result} calls=#{_t2_calls}")
end

# --- Test 3: post-with calls return to the prelude default. After the
#     wrap exits, the mock counter does NOT advance and the lookup falls
#     through to build_cache::cache_lookup (returns "").

def t3_run(): Void
  _t2_calls = 0
  with Cache { cache_op_lookup: t2_mock_lookup } do ->
    var inside = cache_op_lookup("m1", "h1")
    puts("inside=#{inside}")
  end
  var outside = cache_op_lookup("m2", "h2")
  if outside.eq("")
    puts("outside=miss calls=#{_t2_calls}")
  else
    puts("outside=hit calls=#{_t2_calls}")
  end
end

def main(): Int
  describe("Cache blessed-default install (A.3 Pass 1)") do ->
    it("cache_op_lookup works at module level without with-block") do ->
      assert_output("miss\n", t1_run)
    end

    it("user with Cache handlers override the prelude default") do ->
      assert_output("result=MOCK_IR_BODY calls=1\n", t2_run)
    end

    it("post-with calls fall through to the prelude default") do ->
      assert_output("inside=MOCK_IR_BODY\noutside=miss calls=1\n", t3_run)
    end
  end
  return qspec_main()
end
