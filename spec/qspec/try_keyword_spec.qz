## try Prefix Keyword (Operation Piezoelectric Effects, Milestone A)
##
## Verifies the new `try EXPR` prefix form that replaces the retired
## `$try(EXPR)` macro. The lookahead-after-body branch on `catch` is
## preserved so the legacy `try EXPR catch PAT HANDLER end` form still
## parses (exercised separately by try_catch_spec.qz).

import * from qspec

## Struct-payload coverage (B.15 §11.25): `try e` must yield the payload type
## `T` of `e`'s `Result<T,E>`/`Option<T>`, not a bare Int. The operand is a call
## to an annotated-return function (the json_parse shape the fix targets), so the
## inner type is a real ptype whose arg1 is the struct id — `tc_expr_try` reads it
## back instead of collapsing to Int.
struct TryPoint
  x: Int
  y: Int
end

def make_try_ok(): Result<TryPoint, String>
  return Result::Ok(TryPoint { x: 3, y: 4 })
end

def make_try_some(): Option<TryPoint>
  return Option::Some(TryPoint { x: 10, y: 20 })
end

def piezo_try_struct_ok(): Result<TryPoint, String>
  var p = try make_try_ok()
  return Result::Ok(TryPoint { x: p.x + 1, y: p.y + 1 })
end

def piezo_try_struct_some(): Option<TryPoint>
  var p = try make_try_some()
  return Option::Some(TryPoint { x: p.x * 2, y: p.y * 2 })
end

def piezo_try_some_extract(): Option<Int>
  var val = try Option::Some(42)
  return Option::Some(val + 1)
end

def piezo_try_none_propagates(): Option<Int>
  var val = try Option::None
  return Option::Some(val + 100)
end

def piezo_try_ok_extract(): Result<Int, String>
  var val = try Result::Ok(10)
  return Result::Ok(val * 2)
end

def piezo_try_err_propagates(): Result<Int, String>
  var val = try Result::Err("boom")
  return Result::Ok(val * 2)
end

def piezo_try_chain(): Option<Int>
  var a = try Option::Some(3)
  var b = try Option::Some(4)
  return Option::Some(a * b)
end

def main(): Int
  describe("try prefix keyword (piezo)") do ->
    it("unwraps Some and continues") do ->
      assert_eq(piezo_try_some_extract().unwrap(), 43)
    end

    it("propagates None early") do ->
      assert_eq(piezo_try_none_propagates().is_none(), true)
    end

    it("unwraps Ok and continues") do ->
      assert_eq(piezo_try_ok_extract().unwrap(), 20)
    end

    it("propagates Err early") do ->
      assert_eq(piezo_try_err_propagates().is_ok(), false)
    end

    it("chains through multiple trys") do ->
      assert_eq(piezo_try_chain().unwrap(), 12)
    end

    it("preserves struct payload type through try (Result)") do ->
      var p = piezo_try_struct_ok().unwrap()
      assert_eq(p.x, 4)
      assert_eq(p.y, 5)
    end

    it("preserves struct payload type through try (Option)") do ->
      var p = piezo_try_struct_some().unwrap()
      assert_eq(p.x, 20)
      assert_eq(p.y, 40)
    end
  end
  return qspec_main()
end
