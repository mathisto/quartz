## scope inheritance across `go` (B.7 Phase 4b)
##
## Contract:
##   1. `go fn()` outside any scope_with — the spawned task sees
##      scope_root() via current_scope().
##   2. `go fn()` inside `scope_with(s, body)` — the spawned task sees
##      `s` via current_scope() (snapshot at spawn time, applied to TLS
##      at every poll dispatch).
##   3. Two siblings spawned in the same scope_with body both see the
##      same scope.
##   4. Nested scope_with: spawn inside the inner block sees the inner
##      scope (not the outer, not root).
##   5. If the parent cancels its scope before spawning, the child task
##      observes is_cancelled(current_scope()) == true.
##
## Spawn-then-cancel-then-recheck (the 6th historical contract) moved
## to spec/qz/scope_spawn_then_cancel_smoke.qz — see that file's
## header for the rationale.

import * from qspec
import * from std/sync/composition/scope

# Per-test capture slots — module globals so spawned tasks can write them
# (closure capture across goroutine boundaries is more brittle than
# global mutation for this test shape).
var si_child_seen = 0
var si_child_seen_a = 0
var si_child_seen_b = 0
var si_child_inner_seen = 0
var si_parent_inner_seen = 0
var si_child_outer_seen = 0
var si_parent_outer_seen = 0
var si_child_cancel_before = 0

def si_record_seen(): Int
  si_child_seen = current_scope()
  return 0
end

def si_record_a(): Int
  si_child_seen_a = current_scope()
  return 0
end

def si_record_b(): Int
  si_child_seen_b = current_scope()
  return 0
end

def si_inner_body(): Int
  si_parent_inner_seen = current_scope()
  var h = go si_record_inner()
  await h
  return 0
end

def si_record_inner(): Int
  si_child_inner_seen = current_scope()
  return 0
end

def si_outer_body(): Int
  si_parent_outer_seen = current_scope()
  scope_with(scope_with_cancel(current_scope()), si_inner_body)
  return 0
end

def si_record_outer(): Int
  si_child_outer_seen = current_scope()
  return 0
end

def si_two_siblings_body(): Int
  var ha = go si_record_a()
  var hb = go si_record_b()
  await ha
  await hb
  return 0
end

def si_one_child_body(): Int
  var h = go si_record_seen()
  await h
  return 0
end

def si_record_cancel_before(): Int
  if scope_is_cancelled(current_scope())
    si_child_cancel_before = 1
  end
  return 0
end

def si_cancel_then_spawn_body(): Int
  scope_cancel(current_scope())
  var h = go si_record_cancel_before()
  await h
  return 0
end

def main(): Int
  describe("scope inheritance across `go` (B.7 Phase 4b)") do ->

    it("go fn() outside scope_with — child sees root") do ->
      si_child_seen = 0
      var h = go si_record_seen()
      await h
      assert_eq(si_child_seen, scope_root())
    end

    it("go fn() inside scope_with — child sees the scope") do ->
      si_child_seen = 0
      var s = scope_with_cancel(scope_root())
      scope_with(s, si_one_child_body)
      assert_eq(si_child_seen, s)
    end

    it("two siblings in same scope both see that scope") do ->
      si_child_seen_a = 0
      si_child_seen_b = 0
      var s = scope_with_cancel(scope_root())
      scope_with(s, si_two_siblings_body)
      assert_eq(si_child_seen_a, s)
      assert_eq(si_child_seen_b, s)
    end

    it("nested scope_with — spawn inside inner sees inner") do ->
      si_parent_outer_seen = 0
      si_parent_inner_seen = 0
      si_child_inner_seen = 0
      var outer = scope_with_cancel(scope_root())
      scope_with(outer, si_outer_body)
      # Outer body recorded outer.
      assert_eq(si_parent_outer_seen, outer)
      # Inner body recorded a fresh child of outer.
      var inner_is_child_of_outer = 0
      if si_parent_inner_seen != outer and si_parent_inner_seen != 0 and si_parent_inner_seen != scope_root()
        inner_is_child_of_outer = 1
      end
      assert_eq(inner_is_child_of_outer, 1)
      # Goroutine spawned inside inner observed inner — NOT outer, NOT root.
      assert_eq(si_child_inner_seen, si_parent_inner_seen)
    end

    it("cancel-before-spawn — child observes is_cancelled") do ->
      si_child_cancel_before = 0
      var s = scope_with_cancel(scope_root())
      scope_with(s, si_cancel_then_spawn_body)
      assert_eq(si_child_cancel_before, 1)
    end

    # Spawn-then-cancel-then-recheck moved to spec/qz/scope_spawn_then_cancel_smoke.qz
    # because qspec describe/it lambdas treat `go fn()` as inline-polled futures
    # (not real worker-thread spawns), which makes the worker-blocks-then-cancel
    # pattern fundamentally racy here. The standalone smoke test uses
    # scope_sleep_ms + scope_with + active-wake (Phase 4e.8) to assert the same
    # contract deterministically.

  end

  return qspec_main()
end
