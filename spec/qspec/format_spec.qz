## Format Tests
##
## Contract:
##   1. Single: `format1("Hello, {}!", "world")` substitutes.
##   2. Two: `format2("{} + {} = 3", "1", "2")` substitutes.
##   3. Three: `format3("{}, {}, {}", ...)` substitutes.
##   4. None: no `{}` in template leaves string unchanged.
##   5. Adjacent: `{}{}` substitutes without separator.
##   6. Int: `str_from_int` integration with format.
##   7. Excess: extra args ignored when fewer `{}`.
##   8. Trailing: `{}` at end of template string.
import * from qspec

def main(): Int
  describe("string formatting") do ->
    it("single placeholder") do ->
      assert_output("Hello, world!\n", fmt_single)
    end
    it("two placeholders") do ->
      assert_output("1 + 2 = 3\n", fmt_two)
    end
    it("three placeholders") do ->
      assert_output("a, b, c\n", fmt_three)
    end
    it("no placeholders") do ->
      assert_output("no placeholders\n", fmt_none)
    end
    it("adjacent placeholders") do ->
      assert_output("ab\n", fmt_adjacent)
    end
    it("with str_from_int") do ->
      assert_output("count: 42\n", fmt_int)
    end
    it("excess args ignored") do ->
      assert_output("only one\n", fmt_excess)
    end
    it("placeholder at end of string") do ->
      assert_output("value: 99\n", fmt_trailing)
    end
  end
  return qspec_main()
end

def format1(template: String, a: String): String
  var sb = sb_new()
  var len = template.size
  var i = 0
  var used = 0
  while i < len
    var c = str_byte_at(template, i)
    if c == '{' and i + 1 < len and str_byte_at(template, i + 1) == '}'
      if used == 0
        sb_append(sb, a)
        used = 1
      end
      i += 2
    else
      sb_append_char(sb, c)
      i += 1
    end
  end
  return sb_to_string(sb)
end

def format2(template: String, a: String, b: String): String
  var sb = sb_new()
  var len = template.size
  var i = 0
  var arg_idx = 0
  while i < len
    var c = str_byte_at(template, i)
    if c == '{' and i + 1 < len and str_byte_at(template, i + 1) == '}'
      if arg_idx == 0
        sb_append(sb, a)
      elsif arg_idx == 1
        sb_append(sb, b)
      end
      arg_idx += 1
      i += 2
    else
      sb_append_char(sb, c)
      i += 1
    end
  end
  return sb_to_string(sb)
end

def format3(template: String, a: String, b: String, c: String): String
  var sb = sb_new()
  var len = template.size
  var i = 0
  var arg_idx = 0
  while i < len
    var ch = str_byte_at(template, i)
    if ch == '{' and i + 1 < len and str_byte_at(template, i + 1) == '}'
      if arg_idx == 0
        sb_append(sb, a)
      elsif arg_idx == 1
        sb_append(sb, b)
      elsif arg_idx == 2
        sb_append(sb, c)
      end
      arg_idx += 1
      i += 2
    else
      sb_append_char(sb, ch)
      i += 1
    end
  end
  return sb_to_string(sb)
end

def fmt_single(): Void = puts(format1("Hello, {}!", "world"))
def fmt_two(): Void = puts(format2("{} + {} = 3", "1", "2"))
def fmt_three(): Void = puts(format3("{}, {}, {}", "a", "b", "c"))
def fmt_none(): Void = puts(format1("no placeholders", "ignored"))
def fmt_adjacent(): Void = puts(format2("{}{}", "a", "b"))
def fmt_int(): Void = puts(format1("count: {}", "#{42}"))
def fmt_excess(): Void = puts(format2("only {}", "one", "extra"))
def fmt_trailing(): Void = puts(format1("value: {}", "99"))
