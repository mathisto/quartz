## Operator Overloading Tests
##
## Contract:
##   1. op_add: `a + b` dispatches to `op_add(other)` method.
##   2. op_eq: `a == b` dispatches to `op_eq(other)` method.
##   3. op_mul: `a * b` dispatches to `op_mul(other)` method.
##   4. op_lt: `a < b` dispatches to `op_lt(other)` method.
##   5. Chaining: `a + b + c` left-to-right operator chaining.
##   6. Direct call: `Type$op_add(a, b)` bypasses operator syntax.

import * from qspec

struct OPoint
  x: Int
  y: Int
end

extend OPoint
  def op_add(other: OPoint): OPoint
    return OPoint { x: self.x + other.x, y: self.y + other.y }
  end
  def op_eq(other: OPoint): Bool
    if self.x == other.x and self.y == other.y
      return true
    end
    return false
  end
end

struct Num
  val: Int
end

extend Num
  def op_mul(other: Num): Num
    return Num { val: self.val * other.val }
  end
end

struct OVal
  n: Int
end

extend OVal
  def op_add(other: OVal): OVal
    return OVal { n: self.n + other.n }
  end
end

struct Score
  pts: Int
end

extend Score
  def op_lt(other: Score): Bool
    if self.pts < other.pts
      return true
    end
    return false
  end
end

struct OPair
  a: Int
  b: Int
end

extend OPair
  def op_add(other: OPair): OPair
    return OPair { a: self.a + other.a, b: self.b + other.b }
  end
end

def main(): Int
  describe("operator overloading") do ->
    it("overloads + for a struct") do ->
      a = OPoint { x: 1, y: 2 }
      b = OPoint { x: 3, y: 4 }
      c = a + b
      assert_eq(c.x, 4)
      assert_eq(c.y, 6)
    end
    it("overloads == for a struct") do ->
      a = OPoint { x: 10, y: 20 }
      b = OPoint { x: 10, y: 20 }
      c = OPoint { x: 10, y: 30 }
      assert_eq(a == b, true)
      assert_eq(a == c, false)
    end
    it("overloads * for a struct") do ->
      a = Num { val: 6 }
      b = Num { val: 7 }
      c = a * b
      assert_eq(c.val, 42)
    end
    it("chains overloaded operators") do ->
      a = OVal { n: 10 }
      b = OVal { n: 20 }
      c = OVal { n: 30 }
      d = a + b + c
      assert_eq(d.n, 60)
    end
    it("overloads < for a struct") do ->
      a = Score { pts: 10 }
      b = Score { pts: 20 }
      assert_eq(a < b, true)
    end
    it("allows direct call of overloaded method") do ->
      x = OPair { a: 1, b: 2 }
      y = OPair { a: 3, b: 4 }
      z = OPair::op_add(x, y)
      assert_eq(z.a, 4)
      assert_eq(z.b, 6)
    end
    it("< returns false when not less") do ->
      a = Score { pts: 30 }
      b = Score { pts: 20 }
      assert_eq(a < b, false)
    end
    it("* with identity value") do ->
      a = Num { val: 42 }
      b = Num { val: 1 }
      c = a * b
      assert_eq(c.val, 42)
    end
  end

  return qspec_main()
end
