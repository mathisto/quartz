## Effect-Row Function Attachment — B.3 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.3).
## Verifies the parser captures `can` clauses on function signatures and
## the typecheck pre-pass attaches an effect row to each `def`.
##
## Behavior is observed via the `--dump-effect-rows` flag, which prints
## one stable line per registered function to stderr post-typecheck:
##
##     EFFECT_ROW fn=<name> row=<id> labels=<csv> tail=<name>
##
## row = -1 means untracked (no `can` clause). Every `can` clause — even an
## explicitly-empty closed one — allocates a fresh row > 0 in
## row_label_lists/row_tail_vars.
##
## Each user function is registered twice during typecheck (once during
## the pre-pass, once during incremental re-registration) — the assertions
## here use `_contains` matchers so the duplicate lines don't trip them.

import * from qspec
import * from qspec/subprocess

def _row_dump(src: String): SubResult = subprocess_compile_with_flags(src, "--dump-effect-rows")

def _assert_contains(haystack: String, needle: String): Void
  _inc_assertions()
  if not str_contains(haystack, needle)
    var sb = sb_new()
    sb.append("Expected stderr to contain '")
    sb.append(needle)
    sb.append("' but got: ")
    sb.append(haystack)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("`can` clause attaches an effect row to NODE_FUNCTION") do ->
    it("untracked function has row -1") do ->
      var r = _row_dump("""
def f_untracked(): Int = 1
def main(): Int = f_untracked()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content,"EFFECT_ROW fn=f_untracked row=-1 labels= tail=")
    end

    it("bare `can` allocates a fresh empty + closed row") do ->
      var r = _row_dump("""
def f_bare_can(): Int can = 2
def main(): Int = f_bare_can()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content,"EFFECT_ROW fn=f_bare_can row=1 labels= tail=")
    end

    it("`can L` allocates a 1-label row") do ->
      var r = _row_dump("""
def f_one_label(): Int can L = 3
def main(): Int = f_one_label()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content,"EFFECT_ROW fn=f_one_label row=1 labels=L tail=")
    end

    it("`can L1, L2` allocates a 2-label row") do ->
      var r = _row_dump("""
def f_two_labels(): Int can L1, L2 = 4
def main(): Int = f_two_labels()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content,"EFFECT_ROW fn=f_two_labels row=1 labels=L1,L2 tail=")
    end

    it("`can L | r` allocates an open-tail row") do ->
      var r = _row_dump("""
def f_open_tail(): Int can L | r = 5
def main(): Int = f_open_tail()
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content,"EFFECT_ROW fn=f_open_tail row=1 labels=L tail=ρ3")
    end
  end
  return qspec_main()
end
