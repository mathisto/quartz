## Arrays Tests
##
## Contract:
##   1. Array literals.
##   2. Array indexing.
##   3. Array index assignment.
##   4. Arr_len builtin.
##   5. Arrays with loops.
##   6. Arrays with functions.
##   7. Arrays of strings.
##   8. Nested arrays.

import * from qspec

def main(): Int
  describe("array literals") do ->
    it("creates an empty array") do ->
      arr = []
      assert_eq(arr.size, 0)
    end

    it("creates an array with integer elements") do ->
      arr = [10, 20, 30]
      assert_eq(arr.size, 3)
    end

    it("creates an array with expression elements") do ->
      x = 5
      arr = [x, x + 1, x * 2]
      assert_eq(arr.size, 3)
    end

    it("creates a single-element array") do ->
      arr = [42]
      assert_eq(arr.size, 1)
    end
  end

  describe("array indexing") do ->
    it("accesses first element") do ->
      arr = [42, 10, 20]
      assert_eq(arr[0], 42)
    end

    it("accesses middle element") do ->
      arr = [10, 42, 30]
      assert_eq(arr[1], 42)
    end

    it("accesses last element") do ->
      arr = [10, 20, 42]
      assert_eq(arr[2], 42)
    end

    it("accesses with variable index") do ->
      arr = [10, 20, 42]
      i = 2
      assert_eq(arr[i], 42)
    end

    it("accesses with expression index") do ->
      arr = [10, 42, 30]
      assert_eq(arr[2 - 1], 42)
    end

    it("uses indexed value in expression") do ->
      arr = [10, 20, 30]
      assert_eq(arr[0] + arr[1] + arr[2] - 18, 42)
    end
  end

  describe("array index assignment") do ->
    it("assigns to first element") do ->
      arr = [0, 0, 0]
      arr[0] = 42
      assert_eq(arr[0], 42)
    end

    it("assigns to middle element") do ->
      arr = [0, 0, 0]
      arr[1] = 42
      assert_eq(arr[1], 42)
    end

    it("assigns with variable index") do ->
      arr = [0, 0, 0]
      i = 2
      arr[i] = 42
      assert_eq(arr[i], 42)
    end

    it("assigns expression value") do ->
      arr = [0, 0, 0]
      x = 40
      arr[1] = x + 2
      assert_eq(arr[1], 42)
    end

    it("preserves other elements after assignment") do ->
      arr = [10, 20, 30]
      arr[1] = 99
      assert_eq(arr[0] + arr[2] - arr[1] + 101, 42)
    end
  end

  describe("arr_size builtin") do ->
    it("returns length of empty array") do ->
      arr = []
      assert_eq(arr_size(arr), 0)
    end
    it("returns length of single-element array") do ->
      arr = [42]
      assert_eq(arr_size(arr), 1)
    end
    it("returns length of multi-element array") do ->
      arr = [10, 20, 30]
      assert_eq(arr_size(arr), 3)
    end
    it("works in expressions") do ->
      arr = [1, 2, 3, 4, 5]
      assert_eq(arr_size(arr) * 2 + 32, 42)
    end
  end

  describe("arrays with loops") do ->
    it("iterates with while loop") do ->
      arr = [10, 20, 12]
      var sum = 0
      var i = 0
      while i < arr_size(arr)
        sum += arr[i]
        i += 1
      end
      assert_eq(sum, 42)
    end
    it("iterates with for loop") do ->
      arr = [10, 20, 12]
      var sum = 0
      for i in 0..arr_size(arr)
        sum += arr[i]
      end
      assert_eq(sum, 42)
    end

    it("builds array in loop") do ->
      arr = [0, 0, 0, 0, 0]
      for i in 0..5
        arr[i] = i * 10
      end
      assert_eq(arr[0] + arr[1] + arr[2] + arr[3] + arr[4] - 58, 42)
    end
  end

  describe("arrays with functions") do ->
    it("passes array to function") do ->
      nums = [20, 22, 99]
      assert_eq(arr_sum_first_two(nums), 42)
    end

    it("returns array from function") do ->
      arr = arr_make()
      assert_eq(arr[0] + arr[1], 42)
    end

    it("modifies array in function (pass by pointer)") do ->
      var arr = [10, 20, 30]
      arr_set_first(arr, 42)
      assert_eq(arr[0], 42)
    end
  end

  describe("arrays of strings") do ->
    it("creates array of strings") do ->
      words = ["hello", "world"]
      assert_eq(words[0].size, 5)
      assert_eq(words[1].size, 5)
    end

    it("accesses string array elements") do ->
      words = ["short", "much longer string"]
      assert_eq(words[1].size - words[0].size + 29, 42)
    end
  end

  describe("nested arrays") do ->
    it("creates nested array") do ->
      matrix = [[1, 2], [3, 4]]
      assert_eq(matrix[0][0] + matrix[1][1] - matrix[0][1] + 39, 42)
    end

    it("modifies nested array") do ->
      matrix = [[0, 0], [0, 0]]
      matrix[1][0] = 42
      assert_eq(matrix[1][0], 42)
    end
  end

  return qspec_main()
end

def arr_sum_first_two(arr: Array): Int
  return arr[0] + arr[1]
end

def arr_make(): Array
  return [10, 32, 50]
end

def arr_set_first(arr: Array, val: Int): Void
  arr[0] = val
end
