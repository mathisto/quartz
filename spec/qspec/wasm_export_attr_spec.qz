## WASM @export Attribute Tests
##
## The `@export def foo()` attribute surfaces user functions under
## their source name in the WASM binary's export section, so JS /
## wasmtime hosts can invoke them directly. Exercises the
## parser → AST → MIR → codegen_wasm plumbing added alongside the
## CHIP-8 demo stack.

import * from qspec
import * from qspec/subprocess

extern "C" def getpid(): CInt

var _we_tid = 0

def _we_compile(source: String): String
  _we_tid += 1
  var pid = getpid()
  var src = "/tmp/_we_#{pid}_#{_we_tid}.qz"
  var wasm = "/tmp/_we_#{pid}_#{_we_tid}.wasm"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return ""
  end
  return wasm
end

def _we_dump_exports(wasm_path: String): String
  var out = "/tmp/_we_dump_#{getpid()}_#{_we_tid}.txt"
  var cr = system("wasm-objdump -x #{wasm_path} > #{out} 2>/dev/null")
  if cr != 0
    return "OBJDUMP_FAILED"
  end
  return read_file(out)
end

def _we_invoke(wasm_path: String, fn: String, args: String): Int
  var out = "/tmp/_we_inv_#{getpid()}_#{_we_tid}.txt"
  var cr = system("wasmtime --invoke #{fn} #{wasm_path} #{args} > #{out} 2>/dev/null")
  if cr != 0
    return -1
  end
  return str_to_int(str_trim(read_file(out)))
end

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature wasm`,
  # so `--backend wasm` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_wasm() == false
    describe("WASM @export (A.28: suite compiler lacks --feature wasm)") do ->
      it_pending("`--backend wasm` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("WASM @export attribute") do ->
    it("surfaces a zero-arg @export function in the export section") do ->
      var s = """
        @export def answer(): Int = 42
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      assert_ne(str_byte_len(wasm), 0)
      var dump = _we_dump_exports(wasm)
      assert_eq(str_contains(dump, "<answer> -> \"answer\""), 1)
    end

    it("surfaces multiple @export functions") do ->
      var s = """
        @export def a(): Int = 1
        @export def b(): Int = 2
        @export def c(): Int = 3
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      var dump = _we_dump_exports(wasm)
      assert_eq(str_contains(dump, "\"a\""), 1)
      assert_eq(str_contains(dump, "\"b\""), 1)
      assert_eq(str_contains(dump, "\"c\""), 1)
      assert_eq(str_contains(dump, "Export[5]:"), 1)
    end

    it("preserves memory + _start alongside user exports") do ->
      var s = """
        @export def pi(): Int = 314
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      var dump = _we_dump_exports(wasm)
      assert_eq(str_contains(dump, "\"memory\""), 1)
      assert_eq(str_contains(dump, "\"_start\""), 1)
      assert_eq(str_contains(dump, "\"pi\""), 1)
    end

    it("lets the host invoke a zero-arg export") do ->
      var s = """
        @export def answer(): Int = 42
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      assert_eq(_we_invoke(wasm, "answer", ""), 42)
    end

    it("lets the host invoke an export with args") do ->
      var s = """
        @export def mul(a: Int, b: Int): Int = a * b
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      assert_eq(_we_invoke(wasm, "mul", "6 7"), 42)
    end

    it("does not export functions without @export") do ->
      var s = """
        def helper(): Int = 99
        @export def public_fn(): Int = 1
        def main(): Int = 0
        """
      var wasm = _we_compile(s)
      var dump = _we_dump_exports(wasm)
      assert_eq(str_contains(dump, "\"public_fn\""), 1)
      # Helper funcs still appear in Code[] listings, but NOT in Export[].
      # Check that the export line `-> "helper"` (with the arrow prefix)
      # doesn't show up.
      assert_eq(str_contains(dump, "-> \"helper\""), 0)
    end
  end
  return qspec_main()
end
