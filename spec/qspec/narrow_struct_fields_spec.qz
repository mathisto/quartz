## Narrow Struct Fields Tests
##
## Contract:
##   1. All-i64 struct still works.
##   2. Assigns to a u8.
##   3. Handles mixed field types.
##   4. Nested struct with narrow.
##   5. Passes struct with narrow.
##   6. Reads all u8 fields.
import * from qspec

struct Pixel
  r: U8
  g: U8
  b: U8
  a: U8
end

struct WrapU8
  val: U8
end

struct WrapI8
  val: I8
end

struct WrapU16
  val: U16
end

struct WrapI16
  val: I16
end

struct WrapU32
  val: U32
end

struct WrapI32
  val: I32
end

struct MixedFields
  flag: U8
  count: Int
  id: U16
end

struct Color
  r: U8
  g: U8
  b: U8
end

struct NarrowInner
  val: U8
end

struct NarrowOuter
  inner: NarrowInner
  extra: U8
end

def main(): Int
  describe("narrow struct fields") do ->
    it("round-trips a U8 field") do ->
      var p = Pixel { r: 200, g: 100, b: 50, a: 127 }
      assert_eq(p.r, 200)
    end
    it("reads all U8 fields correctly") do ->
      var p = Pixel { r: 10, g: 20, b: 5, a: 7 }
      assert_eq(p.r + p.g + p.b + p.a, 42)
    end
    it("truncates values exceeding U8 range") do ->
      var w = WrapU8 { val: 300 }
      assert_eq(w.val, 44)
    end
    it("sign-extends I8 field values") do ->
      var w = WrapI8 { val: 200 }
      assert_eq(w.val + 100, 44)
    end
    it("round-trips a U16 value") do ->
      var w = WrapU16 { val: 250 }
      assert_eq(w.val, 250)
    end
    it("truncates values exceeding U16 range") do ->
      assert_output("4464\n", nsf_u16_trunc)
    end
    it("round-trips large U16 value") do ->
      assert_output("60000\n", nsf_u16_large)
    end
    it("sign-extends I16 field values") do ->
      var w = WrapI16 { val: 40000 }
      assert_eq(w.val + 25600, 64)
    end
    it("round-trips a U32 value") do ->
      var w = WrapU32 { val: 200 }
      assert_eq(w.val, 200)
    end
    it("round-trips large U32 value") do ->
      assert_output("100000\n", nsf_u32_large)
    end
    it("round-trips I32 field value") do ->
      var w = WrapI32 { val: 42 }
      assert_eq(w.val, 42)
    end
    it("handles mixed field types") do ->
      var m = MixedFields { flag: 1, count: 42, id: 100 }
      assert_eq(m.flag + m.count + m.id, 143)
    end
    it("assigns to a U8 field") do ->
      var w = WrapU8 { val: 10 }
      w.val = 200
      assert_eq(w.val, 200)
    end
    it("truncates on field assignment") do ->
      var w = WrapU8 { val: 0 }
      w.val = 300
      assert_eq(w.val, 44)
    end
    it("all-i64 struct still works") do ->
      assert_eq(nsf_all_i64(), 42)
    end
    it("passes struct with narrow fields to function") do ->
      var c = Color { r: 10, g: 20, b: 12 }
      assert_eq(nsf_brightness(c), 42)
    end
    it("nested struct with narrow field") do ->
      var i = NarrowInner { val: 30 }
      var o = NarrowOuter { inner: i, extra: 12 }
      assert_eq(o.inner.val + o.extra, 42)
    end
  end
  return qspec_main()
end

def nsf_u16_trunc(): Void
  var w = WrapU16 { val: 70000 }
  print_int(w.val)
end

def nsf_u16_large(): Void
  var w = WrapU16 { val: 60000 }
  print_int(w.val)
end

def nsf_u32_large(): Void
  var w = WrapU32 { val: 100000 }
  print_int(w.val)
end

struct NsfPoint
  x: Int
  y: Int
end

def nsf_all_i64(): Int
  var p = NsfPoint { x: 10, y: 32 }
  return p.x + p.y
end

def nsf_brightness(c: Color): Int = c.r + c.g + c.b
