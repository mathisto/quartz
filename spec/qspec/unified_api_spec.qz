## Unified API UFCS Methods Tests
##
## Contract:
##   1. String ufcs.
##   2. Vec ufcs.
##   3. Map ufcs.
##   4. Set ufcs.
##   5. Stringbuilder ufcs.
##   6. Int ufcs.
##   7. Float ufcs.

import * from qspec

def ua_downcase(): Void
  s = "HELLO"
  puts(s.downcase())
end

def ua_upcase(): Void
  s = "hello"
  puts(s.upcase())
end

def ua_to_i(): Int
  s = "42"
  return s.to_i()
end

def ua_hash(): Int
  s = "hello"
  h = s.hash()
  if h != 0
    return 1
  end
  return 0
end

def ua_get_unchecked(): Int
  var v = vec_new()
  v.push(42)
  return v.get_unchecked(0)
end

def ua_set_unchecked(): Int
  var v = vec_new()
  v.push(0)
  v.set_unchecked(0, 99)
  return v[0]
end

def ua_hm_get(): Int
  var m = map_new()
  m.set("x", 42)
  match m.get("x")
    Some(v) => return v
    _ => return 0
  end
end

def ua_hm_set(): Int
  var m = map_new()
  m.set("key", 77)
  match m.get("key")
    Some(v) => return v
    _ => return 0
  end
end

def ua_sb_append(): Void
  var sb = sb_new()
  sb.append("hello")
  sb.append(" world")
  puts(sb_to_string(sb))
end

def ua_sb_append_int(): Void
  var sb = sb_new()
  sb.append("val=")
  sb.append_int(42)
  puts(sb_to_string(sb))
end

def ua_sb_append_char(): Void
  var sb = sb_new()
  sb.append("ab")
  sb.append_char(99)
  puts(sb_to_string(sb))
end

def ua_vec_free(): Int
  var v = vec_new()
  v.push(1)
  v.push(2)
  v.free()
  return 1
end

def ua_hm_free(): Int
  var m = map_new()
  m.set("k", 1)
  m.free()
  return 1
end

def ua_sb_free(): Int
  var sb = sb_new()
  sb.append("test")
  sb.free()
  return 1
end

def ua_sb_size(): Int
  var sb = sb_new()
  sb.append("hello")
  sb.append(" world")
  return sb.size()
end

def ua_int_to_s(): Void
  n = 42
  puts(n.to_s())
end

def ua_int_to_f64(): Int
  n = 42
  f = n.to_f64()
  return to_int(f)
end

def ua_str_to_f(): Int
  s = "3.14"
  f = s.to_f()
  if to_int(f) == 3
    return 1
  end
  return 0
end

def ua_f64_to_i(): Int
  f = 42.7
  return f.to_i()
end

def ua_f64_to_s(): Void
  f = 3.14
  puts(f.to_s())
end

def ua_set_has(): Int
  var s = set_new()
  set_add(s, 42)
  if s.has(42)
    return 1
  end
  return 0
end

def ua_set_delete(): Int
  var s = set_new()
  set_add(s, 10)
  set_add(s, 20)
  s.delete(10)
  if set_size(s) == 1
    return 1
  end
  return 0
end

def main(): Int
  describe("String UFCS") do ->
    it("s.downcase() converts to lowercase") do ->
      assert_output("hello\n", ua_downcase)
    end

    it("s.upcase() converts to uppercase") do ->
      assert_output("HELLO\n", ua_upcase)
    end

    it("s.to_f() converts string to float") do ->
      assert_eq(ua_str_to_f(), 1)
    end

    it("s.hash() returns integer hash") do ->
      assert_eq(ua_hash(), 1)
    end

    it("s.to_i() converts string to integer") do ->
      assert_eq(ua_to_i(), 42)
    end
  end

  describe("Vec UFCS") do ->
    it("v.free() frees vector") do ->
      assert_eq(ua_vec_free(), 1)
    end

    it("v.get_unchecked(i) reads without bounds check") do ->
      assert_eq(ua_get_unchecked(), 42)
    end

    it("v.set_unchecked(i, val) writes without bounds check") do ->
      assert_eq(ua_set_unchecked(), 99)
    end
  end

  describe("Map UFCS") do ->
    it("m.get(k) retrieves value") do ->
      assert_eq(ua_hm_get(), 42)
    end

    it("m.set(k, v) stores value") do ->
      assert_eq(ua_hm_set(), 77)
    end

    it("m.free() frees map") do ->
      assert_eq(ua_hm_free(), 1)
    end
  end

  describe("Set UFCS") do ->
    it("s.has(x) checks membership") do ->
      assert_eq(ua_set_has(), 1)
    end
    it("s.delete(x) removes element") do ->
      assert_eq(ua_set_delete(), 1)
    end
  end

  describe("StringBuilder UFCS") do ->
    it("sb.append(s) appends string") do ->
      assert_output("hello world\n", ua_sb_append)
    end

    it("sb.append_int(n) appends integer") do ->
      assert_output("val=42\n", ua_sb_append_int)
    end

    it("sb.append_char(c) appends char") do ->
      assert_output("abc\n", ua_sb_append_char)
    end

    it("sb.free() frees builder") do ->
      assert_eq(ua_sb_free(), 1)
    end

    it("sb.size() returns builder length") do ->
      assert_eq(ua_sb_size(), 11)
    end
  end

  describe("Int UFCS") do ->
    it("n.to_s() converts to string") do ->
      assert_output("42\n", ua_int_to_s)
    end

    it("n.to_f64() converts to float") do ->
      assert_eq(ua_int_to_f64(), 42)
    end
  end

  describe("Float UFCS") do ->
    it("f.to_i() converts to integer") do ->
      assert_eq(ua_f64_to_i(), 42)
    end
    it("f.to_s() converts to string") do ->
      assert_output("3.14\n", ua_f64_to_s)
    end
  end

  return qspec_main()
end
