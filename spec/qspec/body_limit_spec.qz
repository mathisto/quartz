## Body Limit Spec — Tests for payload_too_large and HttpServerConfig.max_body_size
##
## Tests the response constructor and config defaults. Actual enforcement
## is tested via integration (requires live server).

import * from qspec
import std/net/http_server

# =============================================================================
# Test helpers
# =============================================================================

def print_413_status(): Void
  var resp = payload_too_large()
  puts(str_from_int(resp.status))
end

def print_413_body(): Void
  var resp = payload_too_large()
  puts(resp.body)
end

def print_status_text_413(): Void
  puts(status_text(413))
end

def print_config_default_body_size(): Void
  var config = http_server_config(8080)
  puts(str_from_int(config.max_body_size))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("payload_too_large response") do ->
    it("returns 413 status") do ->
      assert_output("413\n", print_413_status)
    end

    it("returns descriptive body") do ->
      assert_output("413 Payload Too Large\n", print_413_body)
    end

    it("status_text returns Payload Too Large") do ->
      assert_output("Payload Too Large\n", print_status_text_413)
    end
  end

  describe("HttpServerConfig.max_body_size") do ->
    it("defaults to 1MB (1048576)") do ->
      assert_output("1048576\n", print_config_default_body_size)
    end
  end

  return qspec_main()
end
