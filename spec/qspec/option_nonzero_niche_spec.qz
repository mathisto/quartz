# Runtime round-trip coverage for B.10 Phase 4 N2 — niche-layout `Option<NonZero>`.
# NonZero is a nominal i64 scalar (value != 0); `Option<NonZero>` lays out as the
# bare payload via the §14.3 niche {0,1} at 0 — `Some(nz)` IS `nz`, `None` IS the
# niche const 0, no heap box, no tag word. This proves the wired codegen: a NonZero
# value flows as a bare i64, constructs (via the checked `nonzero_new` and the
# explicit `nonzero_new_unchecked`) and reads back correctly across every
# discriminant form, AND the nominal wall holds (a bare Int can't reach a NonZero
# slot — that negative is a compile-fail, covered out-of-band, not here).
# Helpers are top-level named functions so the constructions exercise the
# let-init, return, and expression-body paths. See MEMORY_MODEL_V3 §14.5.

import * from qspec

# --- construction surfaces ---
def mk_pos_expr(): Option<NonZero> = nonzero_new(7)          # expression-body, nonzero
def mk_zero_expr(): Option<NonZero> = nonzero_new(0)         # nonzero_new(0) ⇒ None
def mk_neg_expr(): Option<NonZero> = nonzero_new(-3)         # negatives are nonzero ⇒ Some
def mk_pos_ret(): Option<NonZero>                            # block-return
  return nonzero_new(42)
end

# --- read surfaces (each takes Option<NonZero> by value = the niche scalar) ---
def via_match(o: Option<NonZero>): Int
  match o
    Option::Some(nz) => { return nonzero_get(nz) }
    Option::None => { return -999 }
  end
end

def via_iflet(o: Option<NonZero>): Int
  if Option::Some(nz) = o
    return nonzero_get(nz)
  end
  return -999
end

def via_is_some(o: Option<NonZero>): Int
  return 1 if o is Some
  return 0
end

def some_pred(o: Option<NonZero>): Int
  return 1 if o.some?
  return 0
end

def none_pred(o: Option<NonZero>): Int
  return 1 if o.none?
  return 0
end

def is_some_method(o: Option<NonZero>): Int
  return 1 if o.is_some()
  return 0
end

def unwrap_to_int(o: Option<NonZero>): Int
  return nonzero_get(o.unwrap())
end

# unchecked mint + accessor
def roundtrip_unchecked(x: Int): Int
  u: NonZero = nonzero_new_unchecked(x)
  return nonzero_get(u)
end

# UNANNOTATED reads — the subject is the `nonzero_new(x)` call directly (no
# let/param annotation). Regression-locks the construct-niche/read-spill SIGSEGV:
# the read recovers "Option<NonZero>" from the builtin's inferred return type
# (mir_intrinsic_return_type), so it niche-decodes instead of spill-loading the
# scalar (which crashed before the fix).
def unann_match(x: Int): Int
  match nonzero_new(x)
    Option::Some(nz) => { return nonzero_get(nz) }
    Option::None => { return -999 }
  end
end

def unann_is_some(x: Int): Int
  return 1 if nonzero_new(x) is Some
  return 0
end

def unann_some_pred(x: Int): Int
  return 1 if nonzero_new(x).some?
  return 0
end

def main(): Int
  describe("niche Option<NonZero> round-trip (B.10 §14 N2)") do ->
    it("match: Some(nonzero) / None") do ->
      assert_eq(via_match(mk_pos_expr()), 7)
      assert_eq(via_match(mk_neg_expr()), -3)
      assert_eq(via_match(mk_zero_expr()), -999)   # nonzero_new(0) ⇒ None
      assert_eq(via_match(mk_pos_ret()), 42)
    end

    it("if-let binds the niche payload") do ->
      assert_eq(via_iflet(mk_pos_expr()), 7)
      assert_eq(via_iflet(mk_zero_expr()), -999)
    end

    it("is-predicate (bottom niche at 0)") do ->
      assert_eq(via_is_some(mk_pos_expr()), 1)
      assert_eq(via_is_some(mk_zero_expr()), 0)
    end

    it("some? / none? predicates") do ->
      assert_eq(some_pred(mk_pos_expr()), 1)
      assert_eq(some_pred(mk_zero_expr()), 0)
      assert_eq(none_pred(mk_pos_expr()), 0)
      assert_eq(none_pred(mk_zero_expr()), 1)
    end

    it("is_some() method (prelude wrapper) is niche-aware") do ->
      assert_eq(is_some_method(mk_pos_expr()), 1)
      assert_eq(is_some_method(mk_zero_expr()), 0)
    end

    it("unwrap returns the bare payload (identity)") do ->
      assert_eq(unwrap_to_int(mk_pos_expr()), 7)
      assert_eq(unwrap_to_int(mk_neg_expr()), -3)
    end

    it("nonzero_new_unchecked + nonzero_get round-trip") do ->
      assert_eq(roundtrip_unchecked(99), 99)
      assert_eq(roundtrip_unchecked(-1), -1)
    end

    it("unannotated match/is/some? on nonzero_new (no SIGSEGV)") do ->
      assert_eq(unann_match(7), 7)
      assert_eq(unann_match(0), -999)
      assert_eq(unann_is_some(7), 1)
      assert_eq(unann_is_some(0), 0)
      assert_eq(unann_some_pred(7), 1)
      assert_eq(unann_some_pred(0), 0)
    end
  end

  return qspec_main()
end
