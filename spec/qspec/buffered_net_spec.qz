## Buffered Network I/O Spec — Tests for std/net/buffered_net
##
## Tests buffered reader/writer for network sockets.
## Uses TCP loopback (127.0.0.1) for reliable local testing.
##
## Contract:
##   1. BufferedNetReader — TCP.
##   2. BufferedNetWriter — TCP.
##   3. BufferedNetReader — TLS.

import * from qspec
import std/net/tcp
import std/net/tls
import std/net/buffered_net

# =============================================================================
# Helpers
# =============================================================================

def start_echo_server(): TcpListener
  match tcp_listen(0)
    Ok(listener) => listener
    Err(e) => {
      puts(str_concat("FATAL: cannot start echo server: ", e.message))
      exit(1)
      return TcpListener { fd: -1, _host: "", port: 0, active: 0 }
    }
  end
end

# Void wrappers for tcp_close/tcp_close_listener (which return Int)
def _close(s: TcpStream): Void
  var _r = tcp_close(s)
end

def _close_listener(s: TcpListener): Void
  var _r = tcp_close_listener(s)
end

def _run_readline_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      tcp_write(server_conn, "hello world\n")
      tcp_close(server_conn)
      var reader = net_reader_new_tcp(client.fd)
      var line = net_reader_read_line(reader)
      if line == "hello world"
        puts("readline_ok")
      else
        puts("readline_got: " + line)
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts("accept_error")
    }
  end
end

def print_buffered_readline(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_readline_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

def _run_read_n_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      tcp_write(server_conn, "0123456789")
      tcp_close(server_conn)
      var reader = net_reader_new_tcp(client.fd)
      var first = net_reader_read_n(reader, 5)
      var second = net_reader_read_n(reader, 5)
      if first == "01234" and second == "56789"
        puts("read_n_ok")
      else
        puts("read_n_got: [" + first + "] [" + second + "]")
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts("accept_error")
    }
  end
end

def print_buffered_read_n(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_read_n_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

def _run_multiline_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      tcp_write(server_conn, "line1\nline2\nline3\n")
      tcp_close(server_conn)
      var reader = net_reader_new_tcp(client.fd)
      var l1 = net_reader_read_line(reader)
      var l2 = net_reader_read_line(reader)
      var l3 = net_reader_read_line(reader)
      if l1 == "line1" and l2 == "line2" and l3 == "line3"
        puts("multiline_ok")
      else
        puts("multiline_got: [" + l1 + "] [" + l2 + "] [" + l3 + "]")
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts("accept_error")
    }
  end
end

def print_buffered_multiline(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_multiline_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

def _run_writer_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      var writer = net_writer_new_tcp(client.fd)
      net_writer_write(writer, "hello ")
      net_writer_write(writer, "world")
      net_writer_flush(writer)
      match tcp_read(server_conn, 1024)
        Ok(data) => {
          if data == "hello world"
            puts("writer_ok")
          else
            puts("writer_got: " + data)
          end
        }
        Err(e) => {
          puts("read_error")
        }
      end
      net_writer_close(writer)
      var _r = tcp_close(server_conn)
    }
    Err(e) => {
      puts("accept_error")
      var _r2 = 0
    }
  end
end

def print_buffered_writer_flush(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_writer_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

def _run_eof_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      tcp_write(server_conn, "data")
      tcp_close(server_conn)
      var reader = net_reader_new_tcp(client.fd)
      var data = net_reader_read_n(reader, 4)
      var eof = net_reader_is_eof(reader)
      if data == "data" and eof
        puts("eof_ok")
      else
        puts("eof_fail")
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts("accept_error")
    }
  end
end

def print_buffered_eof(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_eof_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

def _run_large_test(server: TcpListener, client: TcpStream): Void
  match tcp_accept(server)
    Ok(server_conn) => {
      var sb = sb_new()
      for i in 0..10000
        sb_append(sb, "A")
      end
      var big_data = sb_to_string(sb)
      tcp_write_all(server_conn, big_data)
      tcp_close(server_conn)
      var reader = net_reader_new_tcp(client.fd)
      var result = net_reader_read_all(reader)
      if result.size == 10000
        puts("large_ok")
      else
        puts("large_got_" + str_from_int(result.size))
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts("accept_error")
    }
  end
end

def print_buffered_large_read(): Void
  var server = start_echo_server()
  match tcp_connect("127.0.0.1", server.port)
    Ok(client) => {
      _run_large_test(server, client)
      _close(client)
    }
    Err(e) => {
      puts("connect_error")
    }
  end
  _close_listener(server)
end

# =============================================================================
# TLS buffered reader helpers (spawn/await concurrency)
# =============================================================================

def _bn_gen_certs(): Void
  var _r = system("openssl req -x509 -newkey rsa:2048 -keyout /tmp/_qspec_bn_key.pem -out /tmp/_qspec_bn_cert.pem -days 1 -nodes -subj '/CN=localhost' 2>/dev/null")
end

def _bn_wait_port(atom: Int): Int
  var port = 0
  while port == 0
    sleep_ms(1)
    port = atomic_load(atom)
  end
  return port
end

# TLS server: accept, send a line, close
def _bn_tls_srv_sendline(atom: Int, cert: String, key: String): Int
  var ctx = tls_ctx_new_server()
  tls_ctx_load_cert(ctx, cert)
  tls_ctx_load_key(ctx, key)
  match tcp_listen(0)
    Ok(listener) => {
      atomic_store(atom, listener.port)
      match tcp_accept(listener)
        Ok(conn) => {
          match tls_accept(ctx, conn.fd)
            Ok(stream) => {
              tls_write(stream, "hello world\n")
              tls_close(stream)
              0
            }
            Err(e) => 0
          end
        }
        Err(e) => 0
      end
      tcp_close_listener(listener)
    }
    Err(e) => 0
  end
  tls_ctx_free(ctx)
  return 0
end

# TLS server: accept, send HTTP response, close
def _bn_tls_srv_sendhttp(atom: Int, cert: String, key: String): Int
  var ctx = tls_ctx_new_server()
  tls_ctx_load_cert(ctx, cert)
  tls_ctx_load_key(ctx, key)
  match tcp_listen(0)
    Ok(listener) => {
      atomic_store(atom, listener.port)
      match tcp_accept(listener)
        Ok(conn) => {
          match tls_accept(ctx, conn.fd)
            Ok(stream) => {
              tls_write(stream, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
              tls_close(stream)
              0
            }
            Err(e) => 0
          end
        }
        Err(e) => 0
      end
      tcp_close_listener(listener)
    }
    Err(e) => 0
  end
  tls_ctx_free(ctx)
  return 0
end

def print_tls_readline(): Void
  _bn_gen_certs()
  atom = atomic_new(0)
  h = go _bn_tls_srv_sendline(atom, "/tmp/_qspec_bn_cert.pem", "/tmp/_qspec_bn_key.pem")
  var port = _bn_wait_port(atom)
  var ctx = tls_ctx_new_client()
  tls_ctx_disable_verify(ctx)
  match tls_connect_noverify(ctx, "127.0.0.1", port)
    Ok(stream) => {
      var reader = net_reader_new_tls(stream.ssl, stream.fd)
      var line = net_reader_read_line(reader)
      if line == "hello world"
        puts("tls_readline_ok")
      else
        puts("tls_readline_got: " + line)
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts(str_concat("connect_error: ", e.message))
    }
  end
  tls_ctx_free(ctx)
  var _a = await h
end

def print_tls_headers(): Void
  _bn_gen_certs()
  atom = atomic_new(0)
  h = go _bn_tls_srv_sendhttp(atom, "/tmp/_qspec_bn_cert.pem", "/tmp/_qspec_bn_key.pem")
  var port = _bn_wait_port(atom)
  var ctx = tls_ctx_new_client()
  tls_ctx_disable_verify(ctx)
  match tls_connect_noverify(ctx, "127.0.0.1", port)
    Ok(stream) => {
      var reader = net_reader_new_tls(stream.ssl, stream.fd)
      var status_line = net_reader_read_line(reader)
      if str_starts_with(status_line, "HTTP/1.1")
        puts("tls_headers_ok")
      else
        puts("tls_headers_got: " + status_line)
      end
      net_reader_close(reader)
    }
    Err(e) => {
      puts(str_concat("connect_error: ", e.message))
    }
  end
  tls_ctx_free(ctx)
  var _a = await h
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("BufferedNetReader — TCP") do ->
    it("reads a line from buffered TCP stream") do ->
      assert_output("readline_ok\n", print_buffered_readline)
    end

    it("reads exact N bytes from buffered stream") do ->
      assert_output("read_n_ok\n", print_buffered_read_n)
    end

    it("reads multiple lines from single buffer fill") do ->
      assert_output("multiline_ok\n", print_buffered_multiline)
    end

    it("detects EOF after peer closes connection") do ->
      assert_output("eof_ok\n", print_buffered_eof)
    end

    it("reads data larger than buffer size") do ->
      assert_output("large_ok\n", print_buffered_large_read)
    end
  end

  describe("BufferedNetWriter — TCP") do ->
    it("buffers writes and flushes to socket") do ->
      assert_output("writer_ok\n", print_buffered_writer_flush)
    end
  end

  describe("BufferedNetReader — TLS") do ->
    it("reads a line from buffered TLS stream") do ->
      assert_output("tls_readline_ok\n", print_tls_readline)
    end

    it("reads HTTP headers from TLS connection") do ->
      assert_output("tls_headers_ok\n", print_tls_headers)
    end
  end

  return qspec_main()
end
