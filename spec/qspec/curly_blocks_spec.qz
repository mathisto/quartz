## Curly Block Syntax Tests
##
## Contract:
##   1. Single-param: `{ x -> expr }` as block argument.
##   2. Nullary: `{ -> expr }` for no-param blocks.
##   3. Multi-param: `{ x, y -> expr }` for multiple params.
##   4. UFCS: curly works with method-style calls.
##   5. Equivalence: curly and do...end produce same result.
##   6. Struct literal: `{ x -> expr }` distinguished from struct.
##   7. Multi-statement: curly with multiple statements.
##   8. Nested: curly block result used in outer expression.

import * from qspec

def apply_int(x: Int, f: Fn(Int): Int): Int
  return f(x)
end

def run_fn(f: Fn(): Int): Int
  return f()
end

def combine(a: Int, b: Int, f: Fn(Int, Int): Int): Int
  return f(a, b)
end

struct CPoint
  x: Int
  y: Int
end

def main(): Int
  describe("basic curly blocks") do ->
    it("parses { x -> expr } as block argument") do ->
      assert_eq(apply_int(21) { x -> x * 2 }, 42)
    end

    it("parses { -> expr } for nullary blocks") do ->
      assert_eq(run_fn() { -> 42 }, 42)
    end

    it("parses { x, y -> expr } for multiple params") do ->
      assert_eq(combine(20, 22) { x, y -> x + y }, 42)
    end
  end

  describe("curly blocks with UFCS") do ->
    it("works with method-style calls") do ->
      assert_eq(21.apply_int() { x -> x * 2 }, 42)
    end
  end

  describe("curly vs do...end equivalence") do ->
    it("curly produces same result as do...end") do ->
      a = apply_int(10) { x -> x + 1 }
      b = apply_int(10) do x -> x + 1 end
      assert_eq(a, b)
      assert_eq(a + b, 22)
    end
  end

  describe("curly blocks with struct literals") do ->
    it("distinguishes { x -> expr } from struct literal") do ->
      p = CPoint { x: 10, y: 20 }
      doubled = apply_int(p.x) { n -> n * 2 }
      assert_eq(doubled + p.y, 40)
    end
  end

  describe("convention: curly for one-liners") do ->
    it("allows multi-statement curly blocks") do ->
      result = apply_int(20) { x ->
        y = x + 1
        z = y + 1
        z * 2
      }
      assert_eq(result, 44)
    end

    it("curly block result used in outer expression") do ->
      a = apply_int(10) { x -> x + 5 }
      b = apply_int(a) { x -> x * 2 }
      assert_eq(b, 30)
    end
  end

  return qspec_main()
end
