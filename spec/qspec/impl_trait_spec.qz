## impl Trait Return Type Tests (LF2.7)
##
## Contract:
##   1. Basic: function with impl Trait return type compiles and runs.
##   2. Endless-def: single-expression form works.
##   3. UFCS dispatch: methods on impl Trait results dispatch correctly.
##   4. Variable binding: assign impl Trait result to variable, call methods.
##   5. Multiple functions: two functions returning impl Trait with different concrete types.
##   6. Same concrete: multiple return paths with same concrete type.
##   7. Trait verification: concrete type must implement declared trait.
##   8. Generic trait: impl Trait<Int> with generic type parameter.
import * from qspec
import * from qspec/subprocess
import nmutp_xmod_module
import value_xmod_module

# --- Test infrastructure ---

trait ITGreeter
  def it_greet(self): Int
    return 0
  end
end

struct ITHello
  val: Int
end

extend ITHello with ITGreeter
  def it_greet(self): Int = @val
end

struct ITWorld
  val: Int
end

extend ITWorld with ITGreeter
  def it_greet(self): Int = @val * 10
end

# Trait with a method that takes a parameter
trait ITCounter
  def it_count(self): Int
    return 0
  end
  def it_next_count(self, step: Int): Int
    return 0
  end
end

struct ITSimpleCounter
  n: Int
end

extend ITSimpleCounter with ITCounter
  def it_count(self): Int = @n
  def it_next_count(self, step: Int): Int = @n + step
end

# --- Functions returning impl Trait ---

def make_greeter(): impl ITGreeter = ITHello { val: 42 }

def make_world_greeter(): impl ITGreeter = ITWorld { val: 7 }

def make_counter(start: Int): impl ITCounter
  return ITSimpleCounter { n: start }
end

def make_greeter_conditional(use_hello: Int): impl ITGreeter
  if use_hello == 1
    return ITHello { val: 99 }
  end
  return ITHello { val: 0 }
end

# --- Test functions ---

def test_basic_impl_return(): Void
  var g = make_greeter()
  assert_eq(g.it_greet(), 42)
end

def test_endless_def_impl_return(): Void
  # make_greeter uses endless def form
  var g = make_greeter()
  assert_eq(g.it_greet(), 42)
end

def test_ufcs_dispatch(): Void
  var g = make_greeter()
  assert_eq(g.it_greet(), 42)
end

def test_variable_binding(): Void
  var c = make_counter(10)
  assert_eq(c.it_count(), 10)
  assert_eq(c.it_next_count(5), 15)
end

def test_multiple_return_functions(): Void
  var hello = make_greeter()
  var world = make_world_greeter()
  assert_eq(hello.it_greet(), 42)
  assert_eq(world.it_greet(), 70)
end

def test_same_concrete_multiple_paths(): Void
  var g1 = make_greeter_conditional(1)
  var g2 = make_greeter_conditional(0)
  assert_eq(g1.it_greet(), 99)
  assert_eq(g2.it_greet(), 0)
end

def test_block_form_with_return(): Void
  var c = make_counter(100)
  assert_eq(c.it_count(), 100)
end

def test_chained_call(): Void
  # Call method directly on function result without intermediate variable
  assert_eq(make_greeter().it_greet(), 42)
end

# --- Phase 1: probe 2 regression — impl Trait return → bounded generic ----
# Before the fix, the specialization mangler baked the literal string
# "impl ITGreeter" (with a space) into symbol names, producing e.g.
# `@take_three_greeters$1$impl ITGreeter` which llc rejects. The fix stamps
# the function's return annotation with the concrete type after impl-return
# inference so MIR lowering sees the resolved struct name.

def take_three_greeters<T: ITGreeter>(src: T): Int
  var s = src
  return s.it_greet() + s.it_greet() + s.it_greet()
end

def test_impl_return_feeds_bounded_generic(): Void
  var g = make_greeter()
  assert_eq(take_three_greeters(g), 126)
end

def test_impl_return_inline_feeds_bounded_generic(): Void
  assert_eq(take_three_greeters(make_greeter()), 126)
end

def test_impl_return_feeds_bounded_generic_distinct(): Void
  # Two different impl Trait–returning functions in one program, each feeding
  # a bounded generic. Ensures the stamped concrete types are per-function.
  var h = make_greeter()
  var w = make_world_greeter()
  assert_eq(take_three_greeters(h) + take_three_greeters(w), 336)
end

# --- Phase 2: argument-position impl Trait (probe 5 regression) -----------
# Without the resolver desugar pass, `def drain(src: impl ITGreeter)` treats
# the annotation as literal and silently dispatches to whichever impl it
# resolved first — so two distinct callers collapse into one monomorphic
# body and both return the wrong sum. The fix rewrites the signature to
# `def drain<_impl_0: ITGreeter>(src: _impl_0)` in the resolver so the
# existing monomorphization pipeline emits two specialized copies.

def drain_greeter_twice(src: impl ITGreeter): Int
  var s = src
  return s.it_greet() + s.it_greet()
end

def test_argpos_impl_trait_single_impl(): Void
  # Baseline: one impl in scope, one caller.
  var h = ITHello { val: 10 }
  assert_eq(drain_greeter_twice(h), 20)
end

def test_argpos_impl_trait_two_impls(): Void
  # Probe 5: two impls in scope, two callers. Must NOT collapse.
  var h = ITHello { val: 10 }  # it_greet returns @val = 10
  var w = ITWorld { val: 5 }   # it_greet returns @val * 10 = 50
  # Before fix: both drains dispatch to whichever impl was resolved first,
  # returning 2*10 + 2*10 = 40 or 2*50 + 2*50 = 200. Correct: 20 + 100 = 120.
  assert_eq(drain_greeter_twice(h) + drain_greeter_twice(w), 120)
end

# Coexistence: explicit type param alongside argument-position impl Trait.
# Synthesizer must append the synthetic _impl_N param without disturbing T.
def zip_greeter_with<T>(tag: T, src: impl ITGreeter): Int
  return src.it_greet()
end

def test_argpos_impl_trait_with_explicit_type_param(): Void
  var h = ITHello { val: 42 }
  assert_eq(zip_greeter_with(0, h), 42)
end

# Two argument-position impl Trait params on one function. Each must get a
# distinct synthesized type param (_impl_0, _impl_1).
def combine_two_greeters(a: impl ITGreeter, b: impl ITGreeter): Int
  return a.it_greet() + b.it_greet()
end

def test_argpos_impl_trait_two_params(): Void
  var h = ITHello { val: 7 }    # 7
  var w = ITWorld { val: 3 }    # 30
  assert_eq(combine_two_greeters(h, w), 37)
end

# --- Phase 3: trait-bound satisfaction through impl Trait -----------------
# When the argument is a direct call expression whose callee returns
# `impl Trait`, tc_validate_trait_bounds must resolve through the
# impl-return registry so the bound check sees the real struct.

def bounded_consumer<T: ITGreeter>(x: T): Int = x.it_greet()

def test_bound_through_direct_call(): Void
  # Before Phase 3 fix, the arg was a NODE_CALL and concrete_type stayed
  # empty, so the bound check silently passed regardless of whether the
  # concrete type actually satisfied ITGreeter. This test verifies the
  # positive case still works end-to-end.
  assert_eq(bounded_consumer(make_greeter()), 42)
end

def test_bound_through_direct_call_world(): Void
  assert_eq(bounded_consumer(make_world_greeter()), 70)
end

# --- Phase 5: bounded generic struct fields -------------------------------
# `struct Wrapper<C: Counter> { inner: C }` used to hang the parser in an
# infinite loop on the colon (`ps_expect(TOK_COMMA)` fired without
# advancing). The parser now handles bounds, and struct instantiation
# validates each concrete type against the declared bound.

trait ITBoundCounter
  def itbc_tick(self): Int
end

struct ITBoundCell
  val: Int
end

extend ITBoundCell with ITBoundCounter
  def itbc_tick(self): Int = @val + 1
end

struct ITBoundWrap<C: ITBoundCounter>
  inner: C
end

# Inherent method that goes through an inherent-UFCS dispatch on the bounded field
extend ITBoundWrap<ITBoundCell>
  def itbw_bump(self): Int = @inner.itbc_tick() + 1
end

def test_bounded_struct_field_dispatches(): Void
  var w = ITBoundWrap<ITBoundCell> { inner: ITBoundCell { val: 40 } }
  assert_eq(w.itbw_bump(), 42)
end

def test_bounded_struct_field_direct_access(): Void
  var w = ITBoundWrap<ITBoundCell> { inner: ITBoundCell { val: 10 } }
  assert_eq(w.inner.itbc_tick(), 11)
end

# --- Generic-impl-on-generic-struct monomorphization regression -----------
# Before the fix, UFCS dispatch on a variable bound to a parameterized type
# (PTYPE) skipped the struct/enum branch because `first_type2 == TYPE_STRUCT`
# was compared against the raw PTYPE id rather than its base kind. The call
# fell through to the wrong dispatch path and emitted bare method symbols
# that downstream codegen mis-dispatched to the nearest type prefix — e.g.
# `l.g_next()` on `Lift<Base>` calling `@Base$g_next(v4)` and returning
# garbage memory (96, 192, etc.). Fix: resolve through `tc_base_kind` before
# comparing.

trait ITGen
  def itg_go(self): Int
end

struct ITBase
  val: Int
end

extend ITBase with ITGen
  def itg_go(self): Int = @val * 2
end

struct ITLift<I>
  source: I
end

extend ITLift<T> with ITGen
  def itg_go(self): Int = @source.itg_go() + 1
end

def it_make_lift<I: ITGen>(src: I): ITLift<I>
  return ITLift<I> { source: src }
end

def test_generic_impl_on_generic_struct_direct_init(): Void
  # Direct init path: var l = ITLift<ITBase> { source: b }
  var b = ITBase { val: 20 }
  var l = ITLift<ITBase> { source: b }
  assert_eq(l.itg_go(), 41)
end

def test_generic_impl_on_generic_struct_through_gen_fn(): Void
  # Generic-wrapper path: var l = it_make_lift(b). This previously returned
  # garbage because the UFCS dispatch on `l.itg_go()` used the raw PTYPE id
  # (not tc_base_kind) and silently fell through.
  var b = ITBase { val: 20 }
  var l = it_make_lift(b)
  assert_eq(l.itg_go(), 41)
end

# STRUCT-GENERIC-ARG-INFERENCE regression test:
# Implicit type-arg inference must recover the concrete struct name from the
# field initializer, not the generic kind name "Struct". Before the fix,
# `Wrapper { inner: Cell { val: 41 } }` (no explicit `<Cell>`) bound `w` with
# type `Wrapper<Struct>`, and downstream `w.inner.val` failed with
# `QZ0301: Unknown struct: Struct`.
def test_struct_generic_arg_inference_from_struct_init(): Void
  var b = ITBase { val: 41 }
  # Note: no explicit <ITBase> — the type arg must be inferred from the field.
  var l = ITLift { source: b }
  assert_eq(l.source.val, 41)
end

# --- Phase 9 additions: design-doc cases 2, 13, 22, plus match-arm bonus ---

# Case 2: Multi-return unification — 4 branches, all the same concrete type.
# Existing `make_greeter_conditional` exercises only 2 branches; this case
# stresses tc_collect_impl_returns walking deeper into nested if blocks and
# unifying every return statement against the first one without bailing.
struct ITMru
  v: Int
end

extend ITMru with ITGreeter
  def it_greet(self): Int = @v
end

def make_mru(n: Int): impl ITGreeter
  if n == 0
    return ITMru { v: 1 }
  end
  if n == 1
    return ITMru { v: 2 }
  end
  if n == 2
    return ITMru { v: 4 }
  end
  return ITMru { v: 8 }
end

def test_multi_return_unification(): Void
  assert_eq(make_mru(0).it_greet() + make_mru(1).it_greet() +
            make_mru(2).it_greet() + make_mru(7).it_greet(), 15)
end

# Bonus: impl Trait return inferred from match-arm return statements.
# Not in the 22-case matrix but a natural-fit regression catch — if
# tc_collect_impl_returns fails to walk match arms, both paths collapse.
enum IT9Tag
  Lo
  Hi
end

def picker_match(t: IT9Tag): impl ITGreeter
  match t
    Lo => return ITMru { v: 10 }
    Hi => return ITMru { v: 20 }
  end
  return ITMru { v: 0 }
end

def test_match_arm_impl_return(): Void
  assert_eq(picker_match(IT9Tag::Lo).it_greet() +
            picker_match(IT9Tag::Hi).it_greet(), 30)
end

# Case 13: Generic impl Trait — fn iter<T>(): impl ITTrait<T>.
# Verifies that the synthesizer threads the function's own type parameter
# through the impl Trait return, monomorphizes the concrete return type per
# instantiation, and the registry indexes by mangled name so each
# instantiation gets its own concrete type.
trait ITGen13<T>
  def gen_get(self): T
    return 0
  end
end

struct ITBox13<T>
  inner: T
end

extend ITBox13<Int> with ITGen13<Int>
  def gen_get(self): Int = @inner
end

def make_box13<T>(x: T): impl ITGen13<T>
  return ITBox13<T> { inner: x }
end

def test_generic_impl_trait_with_type_param(): Void
  var b = make_box13(42)
  assert_eq(b.gen_get(), 42)
end

# Case 22: Trait bound propagation through two layers of generics.
# `outer<T: ITGreeter>` calls `inner<T: ITGreeter>` with its own T. The
# bound check on the inner call must accept T as already satisfying the
# bound (transitively) without re-resolving the impl, and the value
# threaded all the way down must come from an impl Trait return at the
# top level.
def it_inner_bp<T: ITGreeter>(x: T): Int = x.it_greet()

def it_outer_bp<T: ITGreeter>(x: T): Int = it_inner_bp(x)

def test_trait_bound_propagation_two_layers(): Void
  assert_eq(it_outer_bp(make_greeter()), 42)
  assert_eq(it_outer_bp(make_world_greeter()), 70)
end

# ============================================================================
# Phase 11 — RPITIT (Return-position impl Trait in trait methods)
# ============================================================================
#
# Tests that `impl Trait` in a TRAIT METHOD's return position works:
# the trait method declaration is `def m(self): impl OtherTrait`, and each
# `impl Trait for Type` block provides a concrete return type which is
# inferred at the impl site (the same way as a free `def f(): impl Trait`).
# Call-site dispatch must route through the per-impl concrete so methods on
# the returned value resolve to the correct concrete type.
#
# Coverage:
#   1. Single-impl baseline: one impl of an RPITIT trait, direct receiver.
#   2. Multi-impl dispatch: two structs implement the same RPITIT trait with
#      DIFFERENT concrete returns. This is the load-bearing case — the bug
#      this phase fixes is that the bare method name `make` collides in the
#      typecheck registry across both impls, so dispatch always picked the
#      first impl's concrete return type.
#   3. Generic RPITIT trait: `trait Container<T> { def fetch(self): impl Wrapper<T> }`.
#
# NOT covered (filed as follow-up): bounded-generic dispatch
# `def use_src<S: Source>(s: S): Int = s.make().g()` — the bug is in the
# NESTED-MONO-UFCS-TYPE-PARAM area (the `<S: Source>` body needs to re-dispatch
# `s.make()` through the concrete impl at each monomorphization). Tracked
# separately in the impl-Trait sprint handoff.

# Case 1: single-impl baseline.
trait ITRpititGreet
  def rg(self): Int
end

struct ITRpititAValue
  v: Int
end

extend ITRpititAValue with ITRpititGreet
  def rg(self): Int = @v
end

trait ITRpititSourceA
  def make_a(self): impl ITRpititGreet
end

struct ITRpititAOuter
  seed: Int
end

extend ITRpititAOuter with ITRpititSourceA
  def make_a(self): impl ITRpititGreet = ITRpititAValue { v: @seed * 2 }
end

def test_rpitit_single_impl(): Void
  var b = ITRpititAOuter { seed: 21 }
  assert_eq(b.make_a().rg(), 42)
end

# Case 2: multi-impl dispatch — the load-bearing test for the Phase 11 fix.
struct ITRpititHi
  v: Int
end

extend ITRpititHi with ITRpititGreet
  def rg(self): Int = @v
end

struct ITRpititWow
  v: Int
end

extend ITRpititWow with ITRpititGreet
  def rg(self): Int = @v * 10
end

trait ITRpititSourceMulti
  def make_m(self): impl ITRpititGreet
end

struct ITRpititBoxA
  seed: Int
end

extend ITRpititBoxA with ITRpititSourceMulti
  def make_m(self): impl ITRpititGreet = ITRpititHi { v: @seed }
end

struct ITRpititBoxB
  seed: Int
end

extend ITRpititBoxB with ITRpititSourceMulti
  def make_m(self): impl ITRpititGreet = ITRpititWow { v: @seed }
end

def test_rpitit_multi_impl_distinct_dispatch(): Void
  var a = ITRpititBoxA { seed: 5 }
  var b = ITRpititBoxB { seed: 4 }
  # a.make_m() must dispatch to ITRpititBoxA$make_m → ITRpititHi → rg = @v = 5
  # b.make_m() must dispatch to ITRpititBoxB$make_m → ITRpititWow → rg = @v * 10 = 40
  # Total: 45. Before the fix, both call sites picked the same concrete (whichever
  # was registered first), so this test would return 9 (5 + 4) instead of 45.
  assert_eq(a.make_m().rg() + b.make_m().rg(), 45)
end

# Case 3: generic RPITIT trait.
trait ITRpititWrapper<T>
  def get_wrapped(self): T
end

struct ITRpititIntWrap
  inner: Int
end

extend ITRpititIntWrap with ITRpititWrapper<Int>
  def get_wrapped(self): Int = @inner
end

trait ITRpititContainer<T>
  def fetch_wrapped(self): impl ITRpititWrapper<T>
end

struct ITRpititIntContainer
  data: Int
end

extend ITRpititIntContainer with ITRpititContainer<Int>
  def fetch_wrapped(self): impl ITRpititWrapper<Int> = ITRpititIntWrap { inner: @data }
end

def test_rpitit_generic_trait(): Void
  var c = ITRpititIntContainer { data: 42 }
  assert_eq(c.fetch_wrapped().get_wrapped(), 42)
end

# ============================================================================
# NESTED-MONO-UFCS-TYPE-PARAM regression
# ============================================================================
#
# A bounded generic function like `def sink<I: Iter>(src: I): Int` that makes
# a UFCS method call on a variable whose struct type contains the type
# parameter (`MapDoubler<I>`) used to dispatch to the wrong method: the
# specialization would track `src`'s type as the raw declared return type
# `MapDoubler<I>` from the generic wrapper, leaking `I` into the spec symbol
# name (`sink$1$MapDoubler$I`) and causing the trait-rewriting path to dispatch
# `it.i_next()` to `RangeSrc$i_next` (the inner source) instead of
# `MapDoubler$i_next`. Phase 6 of the impl-Trait sprint blocked on this bug.
#
# Fix: `mir_subst_return_type_for_call` substitutes type parameters through
# the caller's inferred arg types when tracking call-result variables, and the
# A8 trait-rewriting block now consults `mir_ctx_get_var_type` + strips the
# generic angle-bracket suffix before building the mangled method name.
trait NMUTPIter
  def nmutp_next(self): Option<Int>
end

struct NMUTPRangeSrc
  current: Int
  stop: Int
end

extend NMUTPRangeSrc with NMUTPIter
  def nmutp_next(&mut self): Option<Int>
    if @current < @stop
      var v = @current
      self.current = v + 1
      return Option::Some(v)
    end
    return Option::None
  end
end

struct NMUTPMapDoubler<I: NMUTPIter>
  source: I
end

extend NMUTPMapDoubler<T> with NMUTPIter
  def nmutp_next(self): Option<Int>
    match @source.nmutp_next()
      Some(v) => return Option::Some(v * 2)
      None => return Option::None
    end
  end
end

def nmutp_map_doubler<I: NMUTPIter>(src: I): NMUTPMapDoubler<I>
  return NMUTPMapDoubler<I> { source: src }
end

def nmutp_sink<I: NMUTPIter>(src: I): Int
  var it = src
  var total = 0
  var guard = 0
  while guard < 100
    match it.nmutp_next()
      Some(v) => total += v
      None => return total
    end
    guard += 1
  end
  return total
end

def test_nmutp_direct_struct_init(): Void
  # Baseline: directly constructing the generic struct with explicit type args
  # was already working before the fix — included here to catch regressions.
  var r = NMUTPRangeSrc { current: 1, stop: 4 }
  var d = NMUTPMapDoubler<NMUTPRangeSrc> { source: r }
  assert_eq(nmutp_sink(d), 12)
end

def test_nmutp_wrapped_generic_call(): Void
  # Failing case before the fix: the generic wrapper `nmutp_map_doubler(r)`
  # returns `NMUTPMapDoubler<I>`, and tracking that raw return type leaked `I`
  # into downstream specialization of `nmutp_sink`.
  var r = NMUTPRangeSrc { current: 1, stop: 4 }
  var d = nmutp_map_doubler(r)
  assert_eq(nmutp_sink(d), 12)
end

# NESTED-MONO-UFCS-TYPE-PARAM cross-module regression (Phase 6 sprint).
#
# Before the fix: when the bounded generic wrapper + terminal live in an
# imported module, the A8 trait-rewrite block in `mir_lower_expr_handlers.qz`
# built mangled method names without the module prefix, so the `it.xm_next()`
# dispatch inside `xm_sum` missed `nmutp_xmod_module$XMDouble$xm_next` and
# fell through to `nmutp_xmod_module$XMRange$xm_next` (the inner source's
# impl). Sum returned 15 instead of 30 — the inner range, not doubled.
#
# The fix: mir_lower_specialized_function extracts the module prefix from
# base_name and stores it in MirGenericState.spec_current_module_prefix.
# The A8 block now tries `{module}${Type}${func}` candidates when the plain
# form misses. Same story for the spec_current_type fallback branch.
def test_nmutp_xmod_wrapped_generic_call(): Void
  var r = nmutp_xmod_module::xm_range(1, 6)
  var d = nmutp_xmod_module::xm_double(r)
  # r emits 1,2,3,4,5; d doubles → 2,4,6,8,10; sum = 30.
  assert_eq(nmutp_xmod_module::xm_sum(d), 30)
end

# item 32b — cross-module @value generic-wrapper dispatch regression.
#
# Identical chain to the test above but the inner range is `@value` (the
# `value_xmod_module` fixture). Before the fix this SIGSEGV'd: the wrapper's
# module-prefixed type-param registration (`value_xmod_module$VXDouble`) was
# missed by the bare-name lookup in the monomorphization router, so the
# extend-method lowered un-monomorphized and read the inlined 16B @value source
# through a boxed pointer-deref. The fix added a suffix fallback to
# `mir_get_struct_type_params`. r emits 1..5; d doubles → 2,4,6,8,10; sum = 30.
def test_value_xmod_wrapped_generic_call(): Void
  var r = value_xmod_module::vx_range(1, 6)
  var d = value_xmod_module::vx_double(r)
  assert_eq(value_xmod_module::vx_sum(d), 30)
end

# GENERIC-TRAIT-BOUND-HANG regression (Phase 6 sprint).
#
# Before the fix: `def f<I: GtbIter<Int>>(src: I)` hung the typechecker
# at ~40 GB RSS forever. The parser's bound-list loop consumed only a
# bare TOK_IDENT for the trait name, then bailed back to the outer
# `while ps_check(TOK_GT) == 0` loop with the cursor still parked on
# the unconsumed `<` of `Iter<Int>`. ps_expect on a mismatch does not
# advance, so the loop spun forever, allocating a fresh string on every
# iteration.
#
# Fix: a new `ps_parse_trait_bound_name` helper consumes the optional
# `<...>` after the trait IDENT (handling `>>` like ps_parse_type does),
# and the function-bound and where-clause sites both call it. A safety
# break in the function-version's outer loop guards against any future
# infinite loops on malformed bound input. The MIR-side iterator-bound
# detector (`mir_has_only_iterator_bounds`) and the typecheck-side
# `tc_validate_trait_bounds` strip generic args from the trait name
# before lookup so `Iterator<Int>` resolves to the `Iterator` impl
# registry.
trait GtbIter<T>
  def gtb_next(self): Option<T>
end

struct GtbSource
  val: Int
end

extend GtbSource with GtbIter<Int>
  def gtb_next(self): Option<Int>
    return Option::Some(@val)
  end
end

def gtb_use<I: GtbIter<Int>>(src: I): Int
  match src.gtb_next()
    Some(v) => return v
    None => return -1
  end
end

def test_gtb_parameterized_bound_compiles(): Void
  var s = GtbSource { val: 7 }
  assert_eq(gtb_use(s), 7)
end

# Two-arg parameterized bound: ensures comma inside `<K, V>` doesn't
# break downstream splitters. Picks Int/Int to keep impl resolution
# trivial.
trait GtbPair<K, V>
  def gtb_pair_first(self): K
  def gtb_pair_second(self): V
end

struct GtbBox
  a: Int
  b: Int
end

extend GtbBox with GtbPair<Int, Int>
  def gtb_pair_first(self): Int = @a
  def gtb_pair_second(self): Int = @b
end

def gtb_sum<P: GtbPair<Int, Int>>(p: P): Int
  return p.gtb_pair_first() + p.gtb_pair_second()
end

def test_gtb_two_arg_parameterized_bound(): Void
  var b = GtbBox { a: 4, b: 5 }
  assert_eq(gtb_sum(b), 9)
end

# ============================================================================
# Phase 4 — Iterable<T> (RPITIT in stdlib)
# ============================================================================
#
# `trait Iterable<T> { def iter(self): impl Iterator<T> }` is now a real
# stdlib RPITIT trait — each collection auto-satisfies it via its inherent
# `iter()`. Tests live in `iterable_trait_spec.qz`. They were split out of
# this file because importing `collections/{stack,queue,deque,...}` here
# alongside `qspec/subprocess` was triggering an order-dependent variant of
# the PSQ-4 Vec<T> element-type-loss bug — `def push` from collections/stack
# was bleeding into pipe_create's typecheck inside std/ffi/socket.qz and
# emitting a closure call against a non-existent %push local. A dedicated
# spec file with a minimal import set sidesteps the collision.

# ============================================================================
# Phase 7 — Opacity enforcement (QZ0167, QZ0168)
# ============================================================================
#
# Positive: dropping the type annotation on an `impl Trait`-returning call
# binds correctly and dispatches to the concrete type's method. Same as the
# baseline cases — re-asserted here under the opacity heading so a regression
# in display-type propagation has a focused failure.
def test_opacity_positive_no_annotation(): Void
  var g = make_greeter()
  assert_eq(g.it_greet(), 42)
end

# Positive: passing an opaque-typed value to a bounded generic still satisfies
# the bound through the resolved concrete type.
def test_opacity_positive_bounded_generic(): Void
  assert_eq(it_outer_bp(make_greeter()), 42)
end

# Positive: chained let-bindings preserve the opaque marker through one
# `var b = a` hop. Method dispatch still resolves through the concrete.
def test_opacity_positive_chained_binding(): Void
  var a = make_greeter()
  var b = a
  assert_eq(b.it_greet(), 42)
end

# Refactor safety (Phase 7 payoff): the "before" version of the helper.
# The caller binds a value of `impl ITGreeter` and dispatches a trait method.
# Concrete type is `ITHello`.
def refactor_iter_before(): impl ITGreeter = ITHello { val: 42 }
def use_refactor_iter_before(): Int
  var g = refactor_iter_before()
  return g.it_greet()
end

# Refactor safety: the "after" version. The author swapped the concrete return
# from `ITHello` to `ITWorld`. The caller is unchanged because it never named
# the concrete type. This test is the proof that opacity makes the refactor a
# non-breaking change.
def refactor_iter_after(): impl ITGreeter = ITWorld { val: 7 }
def use_refactor_iter_after(): Int
  var g = refactor_iter_after()
  return g.it_greet()
end

def test_opacity_refactor_safety(): Void
  assert_eq(use_refactor_iter_before(), 42)
  # `ITWorld.it_greet` returns @val * 10 — see the impl block at the top of
  # this file. The caller did not need editing to absorb the change.
  assert_eq(use_refactor_iter_after(), 70)
end

def main(): Int
  describe("impl Trait returns (LF2.7)") do ->
    it("basic impl return type compiles and runs") do -> test_basic_impl_return() end
    it("endless-def form works") do -> test_endless_def_impl_return() end
    it("UFCS dispatch resolves correctly") do -> test_ufcs_dispatch() end
    it("variable binding with method calls") do -> test_variable_binding() end
    it("multiple functions with different concrete types") do -> test_multiple_return_functions() end
    it("same concrete type across multiple return paths") do -> test_same_concrete_multiple_paths() end
    it("block form with explicit return") do -> test_block_form_with_return() end
    it("chained method call on function result") do -> test_chained_call() end
  end

  # ===========================================================================
  # Advanced impl Trait patterns (TEST.2 Phase 6)
  # ===========================================================================
  describe("advanced impl Trait patterns") do ->
    it("different functions return different concrete types for same trait") do ->
      var g1 = make_greeter()
      var g2 = make_world_greeter()
      assert_eq(g1.it_greet() + g2.it_greet(), 112)
    end

    it("impl Trait return with conditional same-type branches") do ->
      var g = make_greeter_conditional(1)
      assert_eq(g.it_greet(), 99)
      var g2 = make_greeter_conditional(0)
      assert_eq(g2.it_greet(), 0)
    end

    it("impl Trait with multi-method trait") do ->
      var c = make_counter(5)
      assert_eq(c.it_count(), 5)
      assert_eq(c.it_next_count(10), 15)
    end
  end

  # ===========================================================================
  # Phase 1: monomorphization + mangler fixes (probe 2 regression)
  # ===========================================================================
  describe("impl Trait feeds bounded generics") do ->
    it("probe 2: let-bound impl Trait result passed to <T: Trait>") do ->
      test_impl_return_feeds_bounded_generic()
    end

    it("probe 2 inline: call expression passed directly to <T: Trait>") do ->
      test_impl_return_inline_feeds_bounded_generic()
    end

    it("two distinct impl Trait origins, each feeds the same bounded generic") do ->
      test_impl_return_feeds_bounded_generic_distinct()
    end
  end

  # ===========================================================================
  # Phase 2: argument-position impl Trait desugar (probe 5 regression)
  # ===========================================================================
  describe("argument-position impl Trait") do ->
    it("probe 4: single impl in scope, single call site") do ->
      test_argpos_impl_trait_single_impl()
    end

    it("probe 5: two impls, two call sites — MUST dispatch distinctly") do ->
      test_argpos_impl_trait_two_impls()
    end

    it("coexists with an explicit type parameter on the same function") do ->
      test_argpos_impl_trait_with_explicit_type_param()
    end

    it("two impl Trait params on one function get distinct synthesized type params") do ->
      test_argpos_impl_trait_two_params()
    end
  end

  # ===========================================================================
  # Phase 3: trait bound satisfaction through impl Trait
  # ===========================================================================
  describe("trait bound propagation") do ->
    it("direct call returning impl Trait passes bounded generic type check") do ->
      test_bound_through_direct_call()
    end

    it("second impl-returning function also passes bounded generic type check") do ->
      test_bound_through_direct_call_world()
    end
  end

  # ===========================================================================
  # Phase 5: bounded struct type params (BOUNDED-STRUCT-FIELD-HANG)
  # ===========================================================================
  describe("bounded generic struct fields") do ->
    it("bounded struct field dispatches trait methods through an inherent method") do ->
      test_bounded_struct_field_dispatches()
    end

    it("bounded struct field supports direct UFCS method calls") do ->
      test_bounded_struct_field_direct_access()
    end
  end

  describe("generic impl on generic struct") do ->
    it("direct init dispatches correctly") do ->
      test_generic_impl_on_generic_struct_direct_init()
    end

    it("init via generic wrapper function dispatches correctly (tc_base_kind fix)") do ->
      test_generic_impl_on_generic_struct_through_gen_fn()
    end

    it("STRUCT-GENERIC-ARG-INFERENCE: implicit type arg recovers struct name from field init") do ->
      test_struct_generic_arg_inference_from_struct_init()
    end
  end

  # ===========================================================================
  # NESTED-MONO-UFCS-TYPE-PARAM — bounded generic body does UFCS dispatch on a
  # receiver whose struct type itself contains the type parameter. Was the
  # final Phase 6 blocker for std/iter.qz modernization.
  # ===========================================================================
  describe("nested-mono UFCS on type-parameter receiver") do ->
    it("direct struct init dispatches through nested Iter layers") do ->
      test_nmutp_direct_struct_init()
    end

    it("generic wrapper function result dispatches through nested Iter layers") do ->
      test_nmutp_wrapped_generic_call()
    end

    it("cross-module generic wrapper dispatches through nested Iter layers") do ->
      test_nmutp_xmod_wrapped_generic_call()
    end

    it("cross-module @value generic wrapper receiver reads inline (item 32b)") do ->
      test_value_xmod_wrapped_generic_call()
    end
  end

  describe("GENERIC-TRAIT-BOUND-HANG (parameterized trait as bound)") do ->
    it("def f<I: GtbIter<Int>>(src: I) typechecks and dispatches") do ->
      test_gtb_parameterized_bound_compiles()
    end

    it("def f<P: GtbPair<Int, Int>>(p: P) — two-arg parameterized bound") do ->
      test_gtb_two_arg_parameterized_bound()
    end
  end

  # ===========================================================================
  # Phase 9: design-doc test matrix gap-fill (cases 2, 13, 22 + match-arm)
  # ===========================================================================
  describe("impl Trait — design-doc matrix coverage") do ->
    # Case 2: multi-return unification across 4 if/else branches.
    it("case 2: 4-branch multi-return unification with one concrete type") do ->
      test_multi_return_unification()
    end

    # Bonus (not in 22-case matrix): impl Trait return inferred via match arms.
    it("bonus: impl Trait return inferred from match arms") do ->
      test_match_arm_impl_return()
    end

    # Case 13: generic impl Trait — `def f<T>(): impl Trait<T>`.
    it("case 13: generic impl Trait carries the function's type parameter") do ->
      test_generic_impl_trait_with_type_param()
    end

    # Case 22: trait bound propagation through two layers of generic functions
    # plus an impl-Trait-returning origin at the top.
    it("case 22: trait bound propagates through two generic layers") do ->
      test_trait_bound_propagation_two_layers()
    end
  end

  # ===========================================================================
  # Phase 11: RPITIT (Return-position impl Trait in trait methods)
  # ===========================================================================
  describe("RPITIT — impl Trait in trait method returns") do ->
    it("single-impl baseline: trait method returning impl Trait dispatches correctly") do ->
      test_rpitit_single_impl()
    end

    it("multi-impl distinct dispatch: two impls of the same RPITIT trait route to different concretes") do ->
      test_rpitit_multi_impl_distinct_dispatch()
    end

    it("generic RPITIT trait: impl Wrapper<T> in a trait method works") do ->
      test_rpitit_generic_trait()
    end
  end

  # ===========================================================================
  # Phase 7: opacity enforcement
  # ===========================================================================
  describe("impl Trait opacity (Phase 7)") do ->
    it("opacity: dropping the annotation binds and dispatches correctly") do ->
      test_opacity_positive_no_annotation()
    end

    it("opacity: passing an opaque value to a bounded generic still works") do ->
      test_opacity_positive_bounded_generic()
    end

    it("opacity: chained `var b = a` preserves the opaque marker") do ->
      test_opacity_positive_chained_binding()
    end

    it("opacity refactor safety: changing the concrete return type does not break the caller") do ->
      test_opacity_refactor_safety()
    end

    # QZ0167: the user can't write the concrete type in an explicit annotation
    # next to an `impl Trait`-returning call. The opaque identity is hidden.
    it("QZ0167: explicit annotation naming the concrete type is rejected") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        struct W
          v: Int
        end

        extend W with IT
          def go(self): Int = @v
        end

        def make_it(): impl IT = W { v: 42 }

        def main(): Int
          var x: W = make_it()
          return x.go()
        end
        """, "QZ0167")
    end

    # QZ0168: two `impl Trait`-returning functions produce distinct opaque
    # identities even when the underlying concrete types match. They cannot
    # be unified at a join point.
    it("QZ0168: cross-origin opaque types do not unify in if/else branches") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        struct W
          v: Int
        end

        extend W with IT
          def go(self): Int = @v
        end

        def make_a(): impl IT = W { v: 1 }
        def make_b(): impl IT = W { v: 2 }

        def main(): Int
          var c = true
          var x = if c then make_a() else make_b() end
          return x.go()
        end
        """, "QZ0168")
    end
  end

  # ===========================================================================
  # Phase 8: error diagnostics polish (QZ0163, QZ0165)
  # ===========================================================================
  #
  # Reserved error codes (no check logic yet, explain entries only):
  #   - QZ0166: trait with `impl Trait` return method used in dyn-trait-like
  #     position. Reserved for the future `dyn Trait` feature. Quartz has no
  #     `dyn Trait` today so the check is a no-op.
  #   - QZ0167: opaque type cannot be assigned to an explicit concrete
  #     annotation. Reserved for the Phase 7 opacity work.
  #   - QZ0168: opaque types from different origins compared or unified.
  #     Reserved for the Phase 7 opacity work.
  #
  # See `quartz --explain QZ0166` (etc.) for the reserved explain entries.
  describe("impl Trait error diagnostics") do ->
    it("QZ0163: directly self-recursive impl Trait function is rejected") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        struct W
          v: Int
        end

        extend W with IT
          def go(self): Int = @v
        end

        def make(n: Int): impl IT
          if n <= 0
            return W { v: 0 }
          end
          return make(n - 1)
        end

        def main(): Int = 0
        """, "QZ0163")
    end

    it("QZ0165: impl Trait function with no return statements is rejected") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        def make(): impl IT = panic("todo")

        def main(): Int = 0
        """, "QZ0165")
    end

    # Case 3: multi-return conflict — two distinct concrete types in one body.
    it("QZ0161: impl Trait return type conflict between concrete types") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        struct A
          v: Int
        end

        extend A with IT
          def go(self): Int = @v
        end

        struct B
          v: Int
        end

        extend B with IT
          def go(self): Int = @v * 2
        end

        def make(n: Int): impl IT
          if n == 0
            return A { v: 1 }
          end
          return B { v: 2 }
        end

        def main(): Int = 0
        """, "QZ0161")
    end

    # Case 5: trait violation — concrete return type does not implement trait.
    it("QZ0162: concrete return type does not implement declared trait") do ->
      assert_compile_error("""
        trait IT
          def go(self): Int
            return 0
          end
        end

        struct W
          v: Int
        end

        def make(): impl IT
          return W { v: 0 }
        end

        def main(): Int = 0
        """, "QZ0162")
    end
  end

  return qspec_main()
end
