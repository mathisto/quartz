## QSpec coverage for Phase B.4 — `with Alloc.with_budget(N) do ... end`.
##
## Single-slot remaining-budget pattern: state_slot[install_idx] tracks
## bytes still permitted; each alloc subtracts size from remaining and
## throws via Throws when the request exceeds remaining. Init env (the
## user's budget arg N) becomes the initial remaining. Sequential and
## nested with_budget blocks each get an independent state slot, so
## isolation is automatic — the per-install env substrate (B.0c) is the
## load-bearing piece of the design.
##
## Dealloc is a no-op for budget purposes (cumulative-allocation
## semantics, mirroring A.5's counter_*_handler — programs that need
## live-bytes accounting should write a custom handler).
##
## NOTE on triple-quoted snippet strings: `"""..."""` interpolates
## `#{...}` at SPEC compile time, not subprocess runtime. Snippets below
## avoid runtime interpolation in their assertion-relevant outputs. Like
## B.3, tests avoid allocating BETWEEN a recovered Throws catch and the
## verification puts to sidestep the filed "stack-top mis-restore on
## cross-scope longjmp" bug (Phase B followups).

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# B4.1 — basic under-budget: multiple allocations summing to <= budget all
# succeed; the program exits 0.
# -----------------------------------------------------------------------------

var _UNDER_BUDGET: String = """import std/alloc

def main(): Int
  with Alloc.with_budget(128) do ->
    var p = alloc(32)
    var q = alloc(48)
    var r = alloc(48)
    store(p, 0, 1)
    store(q, 0, 2)
    store(r, 0, 3)
  end
  puts(\"ok\")
  return 0
end
"""

# -----------------------------------------------------------------------------
# B4.2 — over-budget: an alloc that would exceed remaining throws via
# Throws → exit 66 + diagnostic on stderr.
# -----------------------------------------------------------------------------

var _OVER_BUDGET_THROWS: String = """import std/alloc

def main(): Int
  with Alloc.with_budget(64) do ->
    var p = alloc(32)
    var q = alloc(16)
    var r = alloc(20)
    puts(\"should_not_print\")
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B4.3 — sequential isolation: two distinct with_budget(N) scopes each
# get their own remaining counter — the second scope's allocs don't
# observe the first's consumption.
# -----------------------------------------------------------------------------

var _SEQUENTIAL_INDEPENDENT: String = """import std/alloc

var g_seen_a = 0
var g_seen_b = 0

def my_throws_a(op_name: Int, argc: Int, argv: Int): Int
  g_seen_a = 1
  return 0
end

def my_throws_b(op_name: Int, argc: Int, argv: Int): Int
  g_seen_b = 1
  return 0
end

def main(): Int
  with Throws { throw: my_throws_a } do ->
    with Alloc.with_budget(32) do ->
      var p = alloc(64)
    end
  end
  with Throws { throw: my_throws_b } do ->
    with Alloc.with_budget(64) do ->
      var q = alloc(128)
    end
  end
  if g_seen_a == 1 and g_seen_b == 1
    puts(\"both_tripped\")
  else
    puts(\"a=\" + str_from_int(g_seen_a) + \" b=\" + str_from_int(g_seen_b))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B4.4 — nested: outer budget large, inner budget small. Inner trips
# first; outer would have allowed the request. Locks in that nested
# state slots are read independently per install index.
# -----------------------------------------------------------------------------

var _NESTED_INNER_TRIPS: String = """import std/alloc

var g_value = 0
var g_caught = 0

def my_throws(op_name: Int, argc: Int, argv: Int): Int
  g_caught = 1
  return 0
end

def main(): Int
  with Throws { throw: my_throws } do ->
    with Alloc.with_budget(1024) do ->
      var p = alloc(64)
      store(p, 0, 7777)
      g_value = load(p, 0)
      with Alloc.with_budget(16) do ->
        var q = alloc(32)
        puts(\"unreachable\")
      end
    end
  end
  if g_caught == 1
    puts(\"caught_value=\" + str_from_int(g_value))
  else
    puts(\"miss\")
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B4.5 — Vec push inside with_budget: internal Vec storage allocation is
# observed by the budget. A small budget that fits the initial vec_new
# struct but not the growing element buffer trips on push.
# -----------------------------------------------------------------------------

var _VEC_PUSH_INTERCEPTED: String = """import std/alloc

def main(): Int
  with Alloc.with_budget(64) do ->
    var v = vec_new<Int>()
    var i = 0
    while i < 1000
      v.push(i)
      i += 1
    end
    puts(\"should_not_print\")
  end
  return 0
end
"""

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("Phase B.4 — Alloc.with_budget(N) sugar") do ->

    it("under budget — multiple allocs summing to <= N all succeed") do ->
      assert_run_stdout_eq(_UNDER_BUDGET, "ok\n")
    end

    it("over budget — request exceeding remaining throws + exits 66") do ->
      assert_run_panics(_OVER_BUDGET_THROWS, "budget exceeded")
    end

    it("sequential — two with_budget scopes have independent counters") do ->
      assert_run_stdout_eq(_SEQUENTIAL_INDEPENDENT, "both_tripped\n")
    end

    it("nested — inner budget trips first; outer's slot unaffected") do ->
      assert_run_stdout_eq(_NESTED_INNER_TRIPS,
        "caught_value=7777\n")
    end

    it("Vec push intercepted — internal allocs route through budget") do ->
      assert_run_panics(_VEC_PUSH_INTERCEPTED, "budget exceeded")
    end

  end
  return qspec_main()
end
