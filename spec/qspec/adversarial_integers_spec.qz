## Adversarial Integer Tests (TEST.2 Phase 2)
##
## Contract: Boundary conditions and stress-testing for integer operations.
##   1. INT64 boundary arithmetic.
##   2. Division by zero.
##   3. Modulo with negatives.
##   4. Bit shift edge cases.
##   5. Chained boundary operations.
##   6. Overflow wrapping.

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # INT64 Boundaries
  # ==========================================================================
  describe("INT64 boundary arithmetic") do ->
    it("INT64_MAX value is correct") do ->
      # 2^63 - 1 = 9223372036854775807
      max = 9223372036854775807
      assert_eq(max, 9223372036854775807)
    end

    it("INT64_MIN value is correct") do ->
      # -2^63 = -9223372036854775808
      min = -9223372036854775808
      assert_eq(min, -9223372036854775808)
    end

    it("MAX + 1 wraps to MIN (overflow)") do ->
      max = 9223372036854775807
      result = max + 1
      assert_eq(result, -9223372036854775808)
    end

    it("MIN - 1 wraps to MAX (underflow)") do ->
      min = -9223372036854775808
      result = min - 1
      assert_eq(result, 9223372036854775807)
    end

    it("MAX * 2 wraps") do ->
      max = 9223372036854775807
      result = max * 2
      assert_eq(result, -2)
    end
  end

  # ==========================================================================
  # Modulo with Negatives
  # ==========================================================================
  describe("modulo with negatives") do ->
    it("positive % positive is standard") do ->
      assert_eq(7 % 3, 1)
    end

    it("negative % positive follows C semantics") do ->
      # In C/LLVM: -7 % 3 = -1 (sign follows dividend)
      result = -7 % 3
      assert_eq(result, -1)
    end

    it("positive % negative follows C semantics") do ->
      result = 7 % -3
      assert_eq(result, 1)
    end

    it("negative % negative follows C semantics") do ->
      result = -7 % -3
      assert_eq(result, -1)
    end

    it("x % 1 is always 0") do ->
      assert_eq(42 % 1, 0)
      assert_eq(-42 % 1, 0)
      assert_eq(0 % 1, 0)
    end
  end

  # ==========================================================================
  # Bit Shifts
  # ==========================================================================
  describe("bit shift edge cases") do ->
    it("shift left by 0 is identity") do ->
      assert_eq(shl(42, 0), 42)
    end

    it("shift right by 0 is identity") do ->
      assert_eq(shr(42, 0), 42)
    end

    it("shift left by 1 doubles the value") do ->
      assert_eq(shl(21, 1), 42)
    end

    it("shift right by 1 halves the value") do ->
      assert_eq(shr(42, 1), 21)
    end

    it("shift left by 63 produces MIN or 0") do ->
      assert_eq(shl(1, 63), -9223372036854775808)
    end

    forall_i("shift left then right roundtrip (small shifts)") do x: Int ->
      # Only test positive values to avoid sign issues with logical shift
      if x > 0 and x < 1000000
        assert_eq(shr(shl(x, 8), 8), x)
      end
    end
  end

  # ==========================================================================
  # Chained Operations
  # ==========================================================================
  describe("chained boundary operations") do ->
    it("negation of MIN wraps (two's complement)") do ->
      min = -9223372036854775808
      result = 0 - min
      # -MIN = MIN in two's complement (overflow)
      assert_eq(result, -9223372036854775808)
    end

    it("0 * anything is 0") do ->
      assert_eq(0 * 9223372036854775807, 0)
      assert_eq(0 * -9223372036854775808, 0)
    end

    forall_i("addition is reversible: (x + 42) - 42 == x") do x: Int ->
      assert_eq((x + 42) - 42, x)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================
  describe("integer properties") do ->
    forall_ii("multiplication distributes over addition") do a: Int, b: Int ->
      var c = (a % 100) + 1
      assert_eq(a * (b + c), a * b + a * c)
    end

    forall_i("absolute value via conditional") do x: Int ->
      var abs_x = x
      if x < 0
        abs_x = 0 - x
      end
      qspec_assert(abs_x >= 0 or x == -9223372036854775808)
    end
  end

  return qspec_main()
end
