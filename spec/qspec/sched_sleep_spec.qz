## Scheduler-aware sleep (P28 Timers)
##
## sched_sleep(ms) suspends a go-task for ms milliseconds via kqueue/timerfd,
## yielding the worker thread to other tasks. Non-blocking to the scheduler.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("sched_sleep") do ->
    it("basic sleep in go-task completes") do ->
      var src = """
        def worker(): Void
          sched_sleep(10)
          puts("done")
        end
        def main(): Int
          go worker()
          sched_shutdown()
          return 0
        end
        """
      assert_run_stdout_eq(src, "done\n")
    end

    it("sleep does not block other tasks") do ->
      var src = """
        def slow(ch: Int): Void
          sched_sleep(100)
          send(ch, 2)
        end
        def fast(ch: Int): Void
          send(ch, 1)
        end
        def main(): Int
          var ch = channel_new(2)
          go slow(ch)
          go fast(ch)
          var first = recv(ch)
          var second = recv(ch)
          puts(first.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n")
    end

    it("sleep ordering: shorter wakes first") do ->
      var src = """
        def sleeper(ch: Int, ms: Int, val: Int): Void
          sched_sleep(ms)
          send(ch, val)
        end
        def main(): Int
          var ch = channel_new(2)
          go sleeper(ch, 80, 2)
          go sleeper(ch, 20, 1)
          var first = recv(ch)
          var second = recv(ch)
          puts(first.to_s())
          puts(second.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n")
    end

    it("go-lambda with sched_sleep") do ->
      var src = """
        def main(): Int
          var ch = channel_new(1)
          go do ->
            sched_sleep(10)
            send(ch, 42)
          end
          sched_shutdown()
          var v = recv(ch)
          puts(v.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end

    it("multiple concurrent sleeps") do ->
      var src = """
        def worker(ch: Int, val: Int): Void
          sched_sleep(10)
          send(ch, val)
        end
        def main(): Int
          var ch = channel_new(5)
          go worker(ch, 1)
          go worker(ch, 2)
          go worker(ch, 3)
          var a = recv(ch)
          var b = recv(ch)
          var c = recv(ch)
          puts((a + b + c).to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "6\n")
    end

    it("sched_sleep non-async fallback") do ->
      var src = """
        def main(): Int
          sched_sleep(10)
          puts("ok")
          return 0
        end
        """
      assert_run_stdout_eq(src, "ok\n")
    end

    it("sched_sleep(0) returns immediately") do ->
      var src = """
        def worker(): Void
          sched_sleep(0)
          puts("instant")
        end
        def main(): Int
          go worker()
          sched_shutdown()
          return 0
        end
        """
      assert_run_stdout_eq(src, "instant\n")
    end

    it("timer precision: 50ms sleep fires within 200ms") do ->
      var src = """
        def main(): Int
          var start = time_mono_ns()
          var ch = channel_new(1)
          go do ->
            sched_sleep(50)
            send(ch, 1)
          end
          recv(ch)
          var elapsed = (time_mono_ns() - start) / 1000000
          if elapsed < 200
            puts("ok")
          else
            puts(elapsed.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "ok\n")
    end
  end

  describe("sched_timeout") do ->
    it("returns Some when function completes before deadline") do ->
      var src = """
        def fast(): Int = 42
        def do_timeout(ms: Int, f: Fn(): Int): Int
          var ch = channel_new(1)
          go do ->
            send(ch, f())
          end
          var result = 0
          select
            case v = recv(ch) => result = option_some(v)
            case _ = timeout(ms) => result = option_none()
          end
          return result
        end
        def main(): Int
          var opt = do_timeout(5000, fast)
          if option_is_some(opt) == 1
            puts(option_get(opt).to_s())
          else
            puts("none")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end

    it("returns None when function exceeds deadline") do ->
      var src = """
        def slow(): Int
          sched_sleep(500)
          return 99
        end
        def do_timeout(ms: Int, f: Fn(): Int): Int
          var ch = channel_new(1)
          go do ->
            send(ch, f())
          end
          var result = 0
          select
            case v = recv(ch) => result = option_some(v)
            case _ = timeout(ms) => result = option_none()
          end
          return result
        end
        def main(): Int
          var opt = do_timeout(10, slow)
          if option_is_some(opt) == 1
            puts("some")
          else
            puts("none")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "none\n")
    end
  end

  return qspec_main()
end
