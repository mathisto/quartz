## Concurrency Stress Tests — T3b.4 + T3b.5

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("stress: scale") do ->
    it("100 tasks all complete") do ->
      assert_run_exits_timeout(scale_100_src(), 0)
    end
  end
  describe("stress: producer-consumer") do ->
    it("10 channels with producer-consumer pairs") do ->
      assert_run_exits_timeout(prod_cons_src(), 0)
    end
  end
  describe("stress: fairness") do ->
    it("all tasks make progress") do ->
      assert_run_exits_timeout(fairness_src(), 0)
    end
  end
  describe("stress: cancel") do ->
    it("cancelled tasks don't block shutdown") do ->
      assert_run_exits_timeout(cancel_src(), 0)
    end
  end
  describe("stress: channel close") do ->
    it("close under contention doesn't deadlock") do ->
      assert_run_exits_timeout(channel_close_src(), 0)
    end
  end
  describe("stress: for-await scale") do ->
    it("for-await with many producers") do ->
      assert_run_exits_timeout(for_await_scale_src(), 0)
    end
  end
  return qspec_main()
end

def scale_100_src(): String = """
  def work(id: Int): Int
    return id
  end
  def main(): Int
    sched_init(4)
    var tasks = vec_new()
    for i in 0..100
      var t = async work(i)
      sched_spawn(t)
      tasks.push(t)
    end
    var sum = 0
    for i in 0..100
      var r = await tasks[i]
      sum += r
    end
    sched_shutdown()
    if sum == 4950
      return 0
    end
    return 1
  end
  """

def prod_cons_src(): String = """
  def producer(ch: Int, start: Int): Int
    for i in 0..10
      send(ch, start + i)
    end
    channel_close(ch)
    return 0
  end
  def consumer(ch: Int): Int
    var sum = 0
    for await x in ch
      sum += x
    end
    return sum
  end
  def main(): Int
    sched_init(4)
    var total = 0
    for c in 0..10
      var ch = channel_new(16)
      go (-> producer(ch, c * 10))
      var t = async consumer(ch)
      sched_spawn(t)
      var s = await t
      total += s
      channel_free(ch)
    end
    sched_shutdown()
    if total == 4950
      return 0
    end
    return 1
  end
  """

def fairness_src(): String = """
  def work(counter: Int, iterations: Int): Int
    var i = 0
    while i < iterations
      i += 1
    end
    atomic_add(counter, 1)
    return 0
  end
  def main(): Int
    sched_init(4)
    var counter = atomic_new(0)
    var tasks = vec_new()
    for i in 0..10
      var t = async work(counter, (i + 1) * 100)
      sched_spawn(t)
      tasks.push(t)
    end
    for i in 0..10
      await tasks[i]
    end
    sched_shutdown()
    var total = atomic_load(counter)
    if total == 10
      return 0
    end
    return 1
  end
  """

def cancel_src(): String = """
  def work(val: Int): Int
    return val
  end
  def main(): Int
    sched_init(2)
    var t1 = async work(1)
    sched_spawn(t1)
    var t2 = async work(2)
    sched_spawn(t2)
    var r1 = await t1
    var r2 = await t2
    sched_shutdown()
    if r1 == 1 and r2 == 2
      return 0
    end
    return 1
  end
  """

def channel_close_src(): String = """
  def producer(ch: Int): Int
    for i in 0..5
      send(ch, i)
    end
    channel_close(ch)
    return 0
  end
  def consumer(ch: Int): Int
    var sum = 0
    for await x in ch
      sum += x
    end
    return sum
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    go (-> producer(ch))
    var t = async consumer(ch)
    sched_spawn(t)
    var sum = await t
    sched_shutdown()
    channel_free(ch)
    if sum == 10
      return 0
    end
    return 1
  end
  """

def for_await_scale_src(): String = """
  def producer(ch: Int, val: Int): Int
    for i in 0..10
      send(ch, val)
    end
    return 0
  end
  def consumer(ch: Int): Int
    var sum = 0
    for await x in ch
      sum += x
    end
    return sum
  end
  def main(): Int
    sched_init(4)
    var ch = channel_new(64)
    for i in 0..5
      go (-> producer(ch, i + 1))
    end
    go (-> { sched_yield(); sched_yield(); sched_yield(); sched_yield(); sched_yield(); channel_close(ch); return 0 })
    var t = async consumer(ch)
    sched_spawn(t)
    var sum = await t
    sched_shutdown()
    channel_free(ch)
    if sum == 150
      return 0
    end
    return 1
  end
  """
