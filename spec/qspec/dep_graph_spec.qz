## Dep Graph Tests
##
## Contract:
##   1. Adds and deduplicates edges.
##   2. Content hash storage.
##   3. Early cutoff: interface unchanged.
##   4. Graph construction and query.
##   5. Invalidation: linear chain and.
##   6. Save and load round-trips.
import * from qspec
import * from dep_graph

# -- Test helpers --

def test_construction_and_query(): Void
  depgraph_new()
  var idx_a = depgraph_add_node("A", "/path/a.qz")
  var idx_b = depgraph_add_node("B", "/path/b.qz")
  assert_eq(idx_a, 0)
  assert_eq(idx_b, 1)
  assert_eq(depgraph_node_count(), 2)
  # Find by name
  assert_eq(depgraph_find_node("A"), 0)
  assert_eq(depgraph_find_node("B"), 1)
  assert_eq(depgraph_find_node("C"), -1)
  # Get name/path
  assert_eq_str(depgraph_get_name(0), "A")
  assert_eq_str(depgraph_get_path(1), "/path/b.qz")
end

def test_updates_existing_module(): Void
  depgraph_new()
  var idx1 = depgraph_add_node("X", "/old/x.qz")
  var idx2 = depgraph_add_node("X", "/new/x.qz")
  # Same index returned, path updated
  assert_eq(idx1, idx2)
  assert_eq(depgraph_node_count(), 1)
  assert_eq_str(depgraph_get_path(0), "/new/x.qz")
end

def test_edges_and_dedup(): Void
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  # A depends on B, B depends on C
  depgraph_add_dep("A", "B")
  depgraph_add_dep("B", "C")
  # Duplicate edge should be ignored
  depgraph_add_dep("A", "B")
  # Check deps
  var a_deps = depgraph_get_deps("A")
  assert_eq(a_deps.size, 1)
  assert_eq_str(a_deps[0], "B")
  # Check reverse deps (dependents)
  var c_deps = depgraph_get_dependents("C")
  assert_eq(c_deps.size, 1)
  assert_eq_str(c_deps[0], "B")
end

def test_topo_sort_linear(): Void
  # C -> B -> A (A depends on B, B depends on C)
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("B", "C")
  var order = depgraph_topo_sort()
  assert_eq(order.size, 3)
  # C must come before B, B before A
  assert_eq_str(order[0], "C")
  assert_eq_str(order[1], "B")
  assert_eq_str(order[2], "A")
end

def test_topo_sort_diamond(): Void
  # Diamond: A depends on B and C, both B and C depend on D
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_node("D", "/d.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("A", "C")
  depgraph_add_dep("B", "D")
  depgraph_add_dep("C", "D")
  var order = depgraph_topo_sort()
  assert_eq(order.size, 4)
  # D must come first (no dependencies)
  assert_eq_str(order[0], "D")
  # A must come last (depends on B and C)
  assert_eq_str(order[3], "A")
end

def test_invalidate_linear(): Void
  # A -> B -> C: invalidating C should propagate to B then A
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("B", "C")
  var changed = vec_new<String>()
  changed.push("C")
  var result = depgraph_invalidate(changed)
  assert_eq(result.size, 3)
  # C is first (seed), then B (direct dependent), then A (transitive)
  assert_eq_str(result[0], "C")
  assert_eq_str(result[1], "B")
  assert_eq_str(result[2], "A")
end

def test_invalidate_diamond(): Void
  # Diamond: invalidate D -> B,C,A all recompile
  # Invalidate B -> only A,B recompile
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_node("D", "/d.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("A", "C")
  depgraph_add_dep("B", "D")
  depgraph_add_dep("C", "D")
  # Invalidate D -> everything
  var changed_d = vec_new<String>()
  changed_d.push("D")
  var result_d = depgraph_invalidate(changed_d)
  assert_eq(result_d.size, 4)
  # Invalidate B -> only B and A
  var changed_b = vec_new<String>()
  changed_b.push("B")
  var result_b = depgraph_invalidate(changed_b)
  assert_eq(result_b.size, 2)
  assert_eq_str(result_b[0], "B")
  assert_eq_str(result_b[1], "A")
end

def test_early_cutoff(): Void
  # A -> B -> C: C changes but interface unchanged
  # Seed modules (C) always propagate to direct dependents (B) because MIR
  # may inline function bodies. B's interface is unchanged -> A does NOT recompile.
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("B", "C")
  # Set current interface hashes
  depgraph_set_interface_hash("C", "hash_c_v1")
  depgraph_set_interface_hash("B", "hash_b_v1")
  depgraph_set_interface_hash("A", "hash_a_v1")
  # Previous hashes: same as current (interface unchanged)
  var prev = vec_new<String>()
  prev.push("hash_a_v1")  # idx 0 = A
  prev.push("hash_b_v1")  # idx 1 = B
  prev.push("hash_c_v1")  # idx 2 = C
  var changed = vec_new<String>()
  changed.push("C")
  var result = depgraph_invalidate_with_cutoff(changed, prev)
  # C and B should be in result: C is seed (always propagates), B is direct dependent.
  # A is cut off because B's interface is unchanged.
  assert_eq(result.size, 2)
  assert_eq_str(result[0], "C")
  assert_eq_str(result[1], "B")
end

def test_early_cutoff_propagation(): Void
  # A -> B -> C: C changes AND interface changes -> B recompiles
  # But B's interface is unchanged -> A does NOT recompile
  depgraph_new()
  depgraph_add_node("A", "/a.qz")
  depgraph_add_node("B", "/b.qz")
  depgraph_add_node("C", "/c.qz")
  depgraph_add_dep("A", "B")
  depgraph_add_dep("B", "C")
  # Current: C interface changed, B interface unchanged
  depgraph_set_interface_hash("C", "hash_c_v2")
  depgraph_set_interface_hash("B", "hash_b_v1")
  depgraph_set_interface_hash("A", "hash_a_v1")
  var prev = vec_new<String>()
  prev.push("hash_a_v1")
  prev.push("hash_b_v1")
  prev.push("hash_c_v1")  # C was v1, now v2 -> changed
  var changed = vec_new<String>()
  changed.push("C")
  var result = depgraph_invalidate_with_cutoff(changed, prev)
  # C recompiles (changed), B recompiles (C's interface changed), A does NOT (B's interface unchanged)
  assert_eq(result.size, 2)
  assert_eq_str(result[0], "C")
  assert_eq_str(result[1], "B")
end

def test_save_and_load(): Void
  depgraph_new()
  depgraph_add_node("mod_a", "/src/a.qz")
  depgraph_add_node("mod_b", "/src/b.qz")
  depgraph_add_node("mod_c", "/src/c.qz")
  depgraph_add_dep("mod_a", "mod_b")
  depgraph_add_dep("mod_b", "mod_c")
  depgraph_set_content_hash("mod_a", "aaa111")
  depgraph_set_content_hash("mod_b", "bbb222")
  depgraph_set_interface_hash("mod_a", "iface_a")
  # Save
  depgraph_save("/tmp/qz_depgraph_test.txt")
  # Load into fresh graph
  var ok = depgraph_load("/tmp/qz_depgraph_test.txt")
  assert_eq(ok, 1)
  assert_eq(depgraph_node_count(), 3)
  assert_eq(depgraph_find_node("mod_a"), 0)
  assert_eq_str(depgraph_get_path(0), "/src/a.qz")
  assert_eq_str(depgraph_get_content_hash("mod_a"), "aaa111")
  assert_eq_str(depgraph_get_interface_hash("mod_a"), "iface_a")
  # Verify edges survived round-trip
  var deps = depgraph_get_deps("mod_a")
  assert_eq(deps.size, 1)
  assert_eq_str(deps[0], "mod_b")
  # Verify invalidation works after load
  var changed = vec_new<String>()
  changed.push("mod_c")
  var result = depgraph_invalidate(changed)
  assert_eq(result.size, 3)
end

def test_content_hash_storage(): Void
  depgraph_new()
  depgraph_add_node("X", "/x.qz")
  depgraph_set_content_hash("X", "abc123")
  assert_eq_str(depgraph_get_content_hash("X"), "abc123")
  # Nonexistent module returns ""
  assert_eq_str(depgraph_get_content_hash("Z"), "")
end

def main(): Int
  describe("dep_graph module") do ->
    it("graph construction and query") do ->
      test_construction_and_query()
    end

    it("updates existing module") do ->
      test_updates_existing_module()
    end

    it("adds and deduplicates edges") do ->
      test_edges_and_dedup()
    end

    it("topological sort linear chain") do ->
      test_topo_sort_linear()
    end

    it("topological sort diamond") do ->
      test_topo_sort_diamond()
    end

    it("invalidation: linear chain and diamond") do ->
      test_invalidate_linear()
      test_invalidate_diamond()
    end

    it("early cutoff: interface unchanged stops propagation") do ->
      test_early_cutoff()
      test_early_cutoff_propagation()
    end

    it("save and load round-trips") do ->
      test_save_and_load()
    end

    it("content hash storage") do ->
      test_content_hash_storage()
    end
  end

  return qspec_main()
end
