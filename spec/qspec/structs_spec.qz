## Structs Tests
##
## Contract:
##   1. Struct definition and instantiation.
##   2. Struct literal field ordering.
##   3. Struct with different field types.
##   4. Passing structs to functions.
##   5. Nested field access.
##   6. Multiple struct definitions.
##   7. Struct with typed fields.
##   8. Nested structs.
##   9. Struct from factory function.

import * from qspec

struct SPoint
  x: Int
  y: Int
end

struct SPair
  first: Int
  second: Int
end

struct SCounter
  value: Int
end

struct SVec2
  x: Int
  y: Int
end

struct SData
  a: Int
  b: Int
  c: Int
end

struct SFlags
  enabled: Int
  visible: Int
end

struct SBox
  value: Int
end

struct SRect
  width: Int
  height: Int
end

struct SScore
  points: Int
end

struct SA
  val: Int
end

struct SB
  num: Int
end

struct STriple
  a: Int
  b: Int
  c: Int
end

struct SQuad
  w: Int
  x: Int
  y: Int
  z: Int
end

struct SPerson
  name: String
  age: Int
end

struct SInner
  value: Int
end

struct SOuter
  inner: SInner
end

struct SLevel3
  val: Int
end

struct SLevel2
  l3: SLevel3
end

struct SLevel1
  l2: SLevel2
end

struct SLine
  start: SPoint
  finish: SPoint
end

struct SConfig
  width: Int
  height: Int
  depth: Int
end

struct SVec3
  x: Int
  y: Int
  z: Int
end

def main(): Int
  describe("struct definition and instantiation") do ->
    it("defines a simple struct and creates an instance") do ->
      assert_eq(st_point_sum(), 30)
    end

    it("accesses struct fields") do ->
      p = SPair { first: 5, second: 3 }
      assert_eq(p.first - p.second, 2)
    end

    it("modifies struct fields") do ->
      c = SCounter { value: 0 }
      c.value = 42
      assert_eq(c.value, 42)
    end

    it("supports multiple field assignments") do ->
      v = SVec2 { x: 0, y: 0 }
      v.x = 10
      v.y = 5
      assert_eq(v.x * v.y, 50)
    end
  end

  describe("struct literal field ordering") do ->
    it("handles fields in different order than definition") do ->
      var p = SPoint { y: 99, x: 88 }
      assert_eq(p.x, 88)
    end

    it("handles fields in definition order") do ->
      var p = SPoint { x: 10, y: 20 }
      assert_eq(p.y, 20)
    end

    it("handles three fields in reversed order") do ->
      var t = STriple { c: 3, b: 2, a: 1 }
      assert_eq(t.a * 100 + t.b * 10 + t.c, 123)
    end

    it("handles mixed order with multiple fields") do ->
      var q = SQuad { z: 4, w: 1, y: 3, x: 2 }
      assert_eq(q.w * 64 + q.x * 16 + q.y * 4 + q.z, 112)
    end
  end

  describe("struct with different field types") do ->
    it("stores integers") do ->
      d = SData { a: 1, b: 2, c: 3 }
      assert_eq(d.a + d.b + d.c, 6)
    end

    it("stores booleans as integers") do ->
      f = SFlags { enabled: 1, visible: 0 }
      if f.enabled == 1
        assert_eq(10, 10)
      else
        assert_eq(0, 10)
      end
    end
  end

  describe("passing structs to functions") do ->
    it("passes struct to function and reads fields") do ->
      p = SPoint { x: 10, y: 32 }
      assert_eq(st_sum_point(p), 42)
    end

    it("returns modified struct from function") do ->
      b = SBox { value: 10 }
      var b2 = st_double_box(b)
      assert_eq(b2.value, 20)
    end
  end

  describe("nested field access") do ->
    it("accesses fields in expressions") do ->
      r = SRect { width: 6, height: 7 }
      assert_eq(r.width * r.height, 42)
    end

    it("uses field in comparison") do ->
      s = SScore { points: 100 }
      if s.points >= 50
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("multiple struct definitions") do ->
    it("defines and uses multiple structs") do ->
      a = SA { val: 10 }
      b = SB { num: 20 }
      assert_eq(a.val + b.num, 30)
    end
  end

  describe("struct with typed fields") do ->
    it("correctly types String fields") do ->
      p = SPerson { name: "Alice", age: 30 }
      assert_eq(p.age, 30)
    end
  end

  describe("nested structs") do ->
    it("accesses field of nested struct") do ->
      o = SOuter { inner: SInner { value: 42 } }
      assert_eq(o.inner.value, 42)
    end

    it("accesses deeply nested struct fields") do ->
      obj = SLevel1 { l2: SLevel2 { l3: SLevel3 { val: 99 } } }
      assert_eq(obj.l2.l3.val, 99)
    end

    it("assigns to nested struct field via intermediate") do ->
      var inner = SInner { value: 0 }
      inner.value = 77
      o = SOuter { inner: inner }
      assert_eq(o.inner.value, 77)
    end

    it("uses nested struct fields in expressions") do ->
      s = SPoint { x: 1, y: 2 }
      f = SPoint { x: 4, y: 6 }
      line = SLine { start: s, finish: f }
      dx = line.finish.x - line.start.x
      dy = line.finish.y - line.start.y
      assert_eq(dx + dy, 7)
    end
  end

  describe("struct from factory function") do ->
    it("assigns to non-first field of struct returned by function") do ->
      var c = st_make_config()
      c.depth = 99
      assert_eq(c.width + c.height + c.depth, 129)
    end

    it("assigns to second field without clobbering first") do ->
      var p = st_make_pair(10, 20)
      p.second = 42
      assert_eq(p.first, 10)
    end

    it("assigns multiple fields of factory-returned struct") do ->
      var v = st_zero_vec()
      v.x = 1
      v.y = 2
      v.z = 3
      assert_eq((v.x + v.y * 10 + v.z * 100) % 256, 65)
    end

    it("reads fields before and after assignment") do ->
      var p = st_origin()
      var before_y = p.y
      p.y = 5
      assert_eq(before_y + p.y + p.x, 5)
    end
  end

  return qspec_main()
end

def st_point_sum(): Int
  p = SPoint { x: 10, y: 20 }
  return p.x + p.y
end

def st_make_config(): SConfig
  return SConfig { width: 10, height: 20, depth: 30 }
end

def st_make_pair(a: Int, b: Int): SPair
  return SPair { first: a, second: b }
end

def st_zero_vec(): SVec3
  return SVec3 { x: 0, y: 0, z: 0 }
end

def st_origin(): SPoint
  return SPoint { x: 0, y: 0 }
end

def st_sum_point(p: SPoint): Int
  return p.x + p.y
end

def st_double_box(b: SBox): SBox
  return SBox { value: b.value * 2 }
end
