## B.10 Vec-pack — packed inline storage for narrow-field @value structs + GC firewall.
##
## Contract:
##   1. Narrow @value structs (RGBA 4×U8, Pixel 3×U8+Int) store INLINE-PACKED in a
##      Vec backing at the true sizeof(%struct.Name) per element (typed-GEP stride),
##      yet read/write/mutate/grow all preserve every field at its correct byte
##      offset (proves the packed stride matches the field-access GEPs).
##   2. Growth past the initial capacity (realloc + memcpy) preserves packed data.
##   3. set() replaces a packed element in place.
##   4. A MIXED scalar+pointer @value struct (Int + String) in a Vec falls back to
##      the BOXED storage path (GC firewall) and still round-trips correct values.
import * from qspec

@value
struct RGBA
  r: U8
  g: U8
  b: U8
  a: U8
end

@value
struct Pixel
  r: U8
  g: U8
  b: U8
  a: Int
end

@value
struct Tagged
  id: Int
  name: String
end

# -- Helpers --

def mk_rgba(rr: U8, gg: U8, bb: U8, aa: U8): RGBA
  return RGBA { r: rr, g: gg, b: bb, a: aa }
end

def mk_pixel(rr: U8, gg: U8, bb: U8, aa: Int): Pixel
  return Pixel { r: rr, g: gg, b: bb, a: aa }
end

def test_rgba_push_get(): Void
  var v = vec_new<RGBA>()
  v.push(mk_rgba(1, 2, 3, 4))
  v.push(mk_rgba(10, 20, 30, 40))
  v.push(mk_rgba(100, 110, 120, 130))
  var c0 = v[0]
  var c1 = v[1]
  var c2 = v[2]
  assert_eq(c0.r, 1)
  assert_eq(c0.g, 2)
  assert_eq(c0.b, 3)
  assert_eq(c0.a, 4)
  assert_eq(c1.r, 10)
  assert_eq(c1.b, 30)
  assert_eq(c2.r, 100)
  assert_eq(c2.g, 110)
  assert_eq(c2.b, 120)
  assert_eq(c2.a, 130)
end

def test_pixel_narrow_plus_wide(): Void
  # Narrow fields BEFORE a wide Int — the Int is NOT at flat index*8 once the three
  # U8s pack ahead of it. Correct read proves the packed stride lines up with the
  # %struct.Pixel field-access GEPs.
  var v = vec_new<Pixel>()
  v.push(mk_pixel(11, 22, 33, 1000))
  v.push(mk_pixel(44, 55, 66, 2000))
  var p0 = v[0]
  var p1 = v[1]
  assert_eq(p0.r, 11)
  assert_eq(p0.g, 22)
  assert_eq(p0.b, 33)
  assert_eq(p0.a, 1000)
  assert_eq(p1.r, 44)
  assert_eq(p1.g, 55)
  assert_eq(p1.b, 66)
  assert_eq(p1.a, 2000)
end

def test_packed_set(): Void
  var v = vec_new<Pixel>()
  v.push(mk_pixel(1, 2, 3, 10))
  v.push(mk_pixel(4, 5, 6, 20))
  v.set(0, mk_pixel(70, 80, 90, 999))
  var r0 = v[0]
  var r1 = v[1]
  assert_eq(r0.r, 70)
  assert_eq(r0.g, 80)
  assert_eq(r0.b, 90)
  assert_eq(r0.a, 999)
  # Neighbor unchanged — proves set wrote exactly one packed element.
  assert_eq(r1.r, 4)
  assert_eq(r1.b, 6)
  assert_eq(r1.a, 20)
end

def test_packed_growth(): Void
  # Grow well past the initial capacity (8) so the realloc + grow-memcpy run on the
  # packed backing. Every field of every element must survive.
  var v = vec_new<RGBA>()
  for i in 0..40
    v.push(mk_rgba(narrow_u8(i), narrow_u8(i + 1), narrow_u8(i + 2), narrow_u8(i + 3)))
  end
  assert_eq(v.size, 40)
  for i in 0..40
    var c = v[i]
    assert_eq(c.r, i)
    assert_eq(c.g, i + 1)
    assert_eq(c.b, i + 2)
    assert_eq(c.a, i + 3)
  end
end

def narrow_u8(n: Int): U8
  return n
end

def test_mixed_struct_boxed(): Void
  # GC firewall: a scalar+pointer @value struct must NOT inline a raw String pointer
  # into the Vec backing. It falls back to the boxed path; values still round-trip.
  var v = vec_new<Tagged>()
  v.push(Tagged { id: 1, name: "alpha" })
  v.push(Tagged { id: 2, name: "beta" })
  v.push(Tagged { id: 3, name: "gamma" })
  var t0 = v[0]
  var t1 = v[1]
  var t2 = v[2]
  assert_eq(t0.id, 1)
  assert_eq_str(t0.name, "alpha")
  assert_eq(t1.id, 2)
  assert_eq_str(t1.name, "beta")
  assert_eq(t2.id, 3)
  assert_eq_str(t2.name, "gamma")
end

def test_packed_fill(): Void
  # vec_new_filled broadcasts a single narrow @value element N times into the
  # packed inline backing. Every copy must carry every field at its packed offset.
  var v = vec_new_filled<RGBA>(7, mk_rgba(9, 18, 27, 36))
  assert_eq(v.size, 7)
  for i in 0..7
    var c = v[i]
    assert_eq(c.r, 9)
    assert_eq(c.g, 18)
    assert_eq(c.b, 27)
    assert_eq(c.a, 36)
  end
end

def test_packed_extend(): Void
  # extend appends one packed @value Vec onto another at the shared packed stride
  # (read from header[3]). Force a grow by extending past the small initial Vec.
  var a = vec_new<RGBA>()
  a.push(mk_rgba(1, 2, 3, 4))
  a.push(mk_rgba(5, 6, 7, 8))
  var b = vec_new<RGBA>()
  for i in 0..30
    b.push(mk_rgba(narrow_u8(i + 100), narrow_u8(i + 101), narrow_u8(i + 102), narrow_u8(i + 103)))
  end
  a.extend(b)
  assert_eq(a.size, 32)
  # Original elements survive the realloc.
  var a0 = a[0]
  var a1 = a[1]
  assert_eq(a0.r, 1)
  assert_eq(a0.a, 4)
  assert_eq(a1.r, 5)
  assert_eq(a1.a, 8)
  # Appended elements land at the correct packed offsets.
  for i in 0..30
    var c = a[i + 2]
    assert_eq(c.r, (i + 100) % 256)
    assert_eq(c.g, (i + 101) % 256)
    assert_eq(c.b, (i + 102) % 256)
    assert_eq(c.a, (i + 103) % 256)
  end
end

def test_mixed_fill_boxed(): Void
  # vec_new_filled on a mixed scalar+pointer @value struct uses the boxed path
  # (one i64 heap pointer per slot, GC-safe); each slot must round-trip the fill.
  var v = vec_new_filled<Tagged>(4, Tagged { id: 77, name: "fillz" })
  assert_eq(v.size, 4)
  for i in 0..4
    var t = v[i]
    assert_eq(t.id, 77)
    assert_eq_str(t.name, "fillz")
  end
end

def main(): Int
  describe("B.10 Vec-pack — narrow @value packed inline storage + GC firewall") do ->
    it("packs an all-narrow RGBA (4×U8) struct and round-trips every field") do ->
      test_rgba_push_get()
    end

    it("packs a narrow-then-wide Pixel (3×U8 + Int) at correct byte offsets") do ->
      test_pixel_narrow_plus_wide()
    end

    it("set() replaces exactly one packed element") do ->
      test_packed_set()
    end

    it("growth past initial capacity preserves all packed elements") do ->
      test_packed_growth()
    end

    it("a mixed scalar+pointer @value struct round-trips via the boxed path") do ->
      test_mixed_struct_boxed()
    end

    it("vec_new_filled broadcasts a narrow @value element into packed storage") do ->
      test_packed_fill()
    end

    it("extend appends a packed @value Vec (with growth) at the shared stride") do ->
      test_packed_extend()
    end

    it("vec_new_filled on a mixed @value struct round-trips via the boxed path") do ->
      test_mixed_fill_boxed()
    end
  end

  return qspec_main()
end
