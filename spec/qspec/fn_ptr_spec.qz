## Function Pointer Tests
##
## Contract:
##   1. fn_to_int: named function → Int pointer.
##   2. fn_to_int: lambda → Int pointer.
##   3. call_fn: calls with 0, 1, 2, 3 arguments.
##   4. Vec storage: fn pointers in Vec, callable later.
##   5. Roundtrip: fn_to_int → call_fn = same result as direct call.
##   6. Identity: identity function pointer roundtrips value.
##   7. Negate: negation function via pointer.

import * from qspec

def main(): Int
  describe("fn_to_int") do ->
    it("can store a named function as Int and call it") do ->
      ptr = fn_to_int(fp_double)
      result = call_fn(ptr, 21)
      assert_eq(result, 42)
    end

    it("can store a lambda as Int and call it") do ->
      f = (x: Int) -> x + 10
      ptr = fn_to_int(f)
      result = call_fn(ptr, 32)
      assert_eq(result, 42)
    end
  end

  describe("call_fn") do ->
    it("works with nullary functions") do ->
      ptr = fn_to_int(fp_forty_two)
      result = call_fn(ptr)
      assert_eq(result, 42)
    end

    it("can pass many arguments") do ->
      ptr = fn_to_int(fp_sum3)
      result = call_fn(ptr, 10, 20, 12)
      assert_eq(result, 42)
    end
  end

  describe("storing functions in vectors") do ->
    it("can store functions in a Vec and call them") do ->
      var v = vec_new()
      v.push(fn_to_int(fp_double))
      v.push(fn_to_int(fp_triple))
      r1 = call_fn(v[0], 5)
      r2 = call_fn(v[1], 5)
      assert_eq(r1 + r2, 25)
    end
  end

  describe("roundtrip") do ->
    it("fn_to_int then call_fn matches direct call") do ->
      direct = fp_sum3(10, 20, 12)
      ptr = fn_to_int(fp_sum3)
      via_ptr = call_fn(ptr, 10, 20, 12)
      assert_eq(direct, via_ptr)
    end

    it("call_fn with 2 args") do ->
      ptr = fn_to_int(fp_add)
      assert_eq(call_fn(ptr, 20, 22), 42)
    end
  end

  describe("additional fn_ptr tests") do ->
    it("identity function pointer roundtrips value") do ->
      ptr = fn_to_int(fp_identity)
      assert_eq(call_fn(ptr, 99), 99)
    end

    it("negation function via pointer") do ->
      ptr = fn_to_int(fp_negate)
      assert_eq(call_fn(ptr, 42), -42)
    end
  end

  return qspec_main()
end

def fp_double(x: Int): Int = x * 2
def fp_triple(x: Int): Int = x * 3
def fp_forty_two(): Int = 42
def fp_sum3(a: Int, b: Int, c: Int): Int = a + b + c
def fp_add(a: Int, b: Int): Int = a + b
def fp_identity(x: Int): Int = x
def fp_negate(x: Int): Int = 0 - x
