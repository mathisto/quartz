## Binary DSL — Phase 2 Track B end-to-end roundtrip coverage.
##
## TCP options are the canonical discriminated-union payload. Each test
## constructs a typed `TcpOption` value with a particular discriminator,
## encodes it, decodes the bytes, and asserts the decoded arm fields
## equal the originals. Invalid-discriminant and short-buffer cases
## verify the error branches.
##
## See: docs/design/BINARY_DSL.md

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — union roundtrip") do ->

    it("NOP arm (tag=1, empty body) encodes to 1 byte and decodes back") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }

        def main(): Int
          nop = TcpOption { kind: 1, mss: 0, tsval: 0, tsecr: 0 }
          b = nop.encode()
          return 42 if b.size() != 1
          return 43 if b.get(0) != 1
          r = match TcpOption.decode(b)
            Ok(got) => if got.kind == 1 then 0 else 70 end
            Err(e) => 80
          end
          return r
        end
        """, 0)
    end

    it("MSS arm (tag=2, u16be) roundtrips mss=1460") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }

        def main(): Int
          mss_o = TcpOption { kind: 2, mss: 1460, tsval: 0, tsecr: 0 }
          b = mss_o.encode()
          return 42 if b.size() != 3
          return 43 if b.get(0) != 2
          return 44 if b.get(1) != 5
          return 45 if b.get(2) != 180
          r = match TcpOption.decode(b)
            Ok(got) => if got.kind == 2 and got.mss == 1460 then 0 else 70 end
            Err(e) => 80
          end
          return r
        end
        """, 0)
    end

    it("Timestamps arm (tag=8, two u32be) roundtrips byte-identically") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }

        def main(): Int
          ts = TcpOption { kind: 8, mss: 0, tsval: 100, tsecr: 200 }
          b = ts.encode()
          return 42 if b.size() != 9
          return 43 if b.get(0) != 8
          r = match TcpOption.decode(b)
            Ok(got) => if got.kind == 8 and got.tsval == 100 and got.tsecr == 200 then 0 else 70 end
            Err(e) => 80
          end
          return r
        end
        """, 0)
    end

    it("Invalid discriminant (kind=99) returns Err(InvalidDiscriminant)") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }

        def main(): Int
          v = vec_new<Int>()
          v.push(99)
          bad = Bytes { _data: v }
          r = match TcpOption.decode(bad)
            Ok(got) => 80
            Err(InvalidDiscriminant) => 0
            Err(_) => 81
          end
          return r
        end
        """, 0)
    end

    it("Short buffer (zero-length) returns Err(UnexpectedEof)") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            2 => { mss: u16be }
          end
        }

        def main(): Int
          v = vec_new<Int>()
          short = Bytes { _data: v }
          r = match TcpOption.decode(short)
            Ok(got) => 80
            Err(UnexpectedEof) => 0
            Err(_) => 81
          end
          return r
        end
        """, 0)
    end

    it("Short buffer (kind=2 with missing mss bytes) returns Err(UnexpectedEof)") do ->
      assert_run_exits("""
        import * from std/bytes
        import * from std/binary

        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            2 => { mss: u16be }
          end
        }

        def main(): Int
          v = vec_new<Int>()
          v.push(2)
          truncated = Bytes { _data: v }
          r = match TcpOption.decode(truncated)
            Ok(got) => 80
            Err(UnexpectedEof) => 0
            Err(_) => 81
          end
          return r
        end
        """, 0)
    end

  end
  return qspec_main()
end
