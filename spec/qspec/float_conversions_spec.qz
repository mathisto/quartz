## Float Conversions Tests
##
## Contract:
##   1. Truncate: `to_int(3.7)` → 3.
##   2. Negative truncate: `to_int(-3.7)` → -3.
##   3. Int to float: `to_f64(42)` → 42.0.
##   4. Round-trip: `to_int(to_f64(100))` → 100.
##   5. NaN: `nan != nan` is true.
##   6. Inf: `inf > 999999.0` is true.
##   7. Zero: `to_f64(0)` → 0.0, `to_int(0.0)` → 0.
##   8. Large: `to_int(1000.9)` → 1000.
import * from qspec

def main(): Int
  describe("float conversions") do ->
    it("to_int truncates float") do ->
      assert_eq(fc_trunc(), 3)
    end
    it("to_int on negative float") do ->
      assert_eq(fc_neg_trunc(), 1)
    end
    it("to_f64 converts int to float") do ->
      assert_eq(fc_int_to_f64(), 1)
    end
    it("round-trip to_f64 then to_int") do ->
      assert_eq(fc_roundtrip(), 100)
    end
    it("NaN != NaN") do ->
      assert_eq(fc_nan(), 0)
    end
    it("Inf > any finite") do ->
      assert_eq(fc_inf(), 1)
    end
    it("to_f64(0) and to_int(0.0) roundtrip") do ->
      assert_eq(fc_zero(), 1)
    end
    it("to_int on large float truncates") do ->
      assert_eq(fc_large(), 1000)
    end
    it("as_f64 reinterprets bits — round-trips through as_int") do ->
      assert_eq(fc_as_f64_roundtrip(), 1)
    end
    it("as_f64 result is float-typed — arithmetic uses fsub") do ->
      assert_eq(fc_as_f64_arith(), 1)
    end
    it("as_f64 round-trips a double through 8 little-endian bytes") do ->
      assert_eq(fc_as_f64_bytes(), 1)
    end
  end
  return qspec_main()
end

# as_f64 is a bit-faithful Int->F64 reinterpret (the inverse of as_int on a
# float), NOT a numeric conversion. as_int(x) then as_f64(...) must recover x
# exactly. Regression coverage for the HB-DOG.8-era F64-bits work.
def fc_as_f64_roundtrip(): Int
  x: F64 = 3.14159265358979
  if as_f64(as_int(x)) == x
    return 1
  end
  return 0
end

# An as_f64 result must be float-typed so arithmetic lowers to fsub, not an
# integer sub of the IEEE-754 bit patterns.
def fc_as_f64_arith(): Int
  a: F64 = 50.0
  b: F64 = 10.0
  d = as_f64(as_int(a)) - as_f64(as_int(b))
  if d == 40.0
    return 1
  end
  return 0
end

# The state.bin serialization pattern: F64 -> 8 LE bytes -> F64.
def fc_as_f64_bytes(): Int
  x: F64 = 0.0 - 2.5
  bits = as_int(x)
  var reassembled = 0
  var i = 0
  while i < 8
    byte = (bits >> (i * 8)) & 255
    reassembled = reassembled | (byte << (i * 8))
    i += 1
  end
  if as_f64(reassembled) == x
    return 1
  end
  return 0
end

def fc_trunc(): Int
  x: F64 = 3.7
  return to_int(x)
end
def fc_neg_trunc(): Int
  x: F64 = -3.7
  y = to_int(x)
  if y == -3
    return 1
  end
  return 0
end
def fc_int_to_f64(): Int
  x = to_f64(42)
  if x == 42.0
    return 1
  end
  return 0
end
def fc_roundtrip(): Int
  x = to_f64(100)
  return to_int(x)
end
def fc_nan(): Int
  nan: F64 = 0.0 / 0.0
  if nan == nan
    return 1
  end
  return 0
end
def fc_inf(): Int
  inf: F64 = 1.0 / 0.0
  if inf > 999999.0
    return 1
  end
  return 0
end
def fc_zero(): Int
  x: F64 = to_f64(0)
  y = to_int(x)
  if y == 0
    return 1
  end
  return 0
end
def fc_large(): Int
  x: F64 = 1000.9
  return to_int(x)
end

