## Union Types Tests
##
## Contract:
##   1. Union types — basic.
##   2. Union types — advanced.
##
## NOTE: Test function names MUST NOT be "f" or "g" — they shadow parameter
## names in prelude functions (result_and_then, option_and_then) and cause
## false QZ0202 errors. Use descriptive names like "uf_xxx" instead.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("union types — basic") do ->
    it("union param accepts first member type") do ->
      assert_run_exits(ut_first_member(), 42)
    end
    it("union param accepts second member type") do ->
      assert_run_exits(ut_second_member(), 43)
    end
    it("union in return type annotation") do ->
      assert_run_exits(ut_return_type(), 44)
    end
    it("union with 3+ members") do ->
      assert_run_exits(ut_three_members(), 45)
    end
    it("named union via type alias") do ->
      assert_run_exits(ut_named_alias(), 46)
    end
  end

  describe("union types — advanced") do ->
    it("union param in multiple functions") do ->
      assert_run_exits(ut_multi_func(), 10)
    end
    it("union type used as local variable type") do ->
      assert_run_exits(ut_local_var(), 50)
    end
    it("union with Bool member") do ->
      assert_run_exits(ut_bool_member(), 1)
    end
    it("function returning union called from another function") do ->
      assert_run_exits(ut_chain_call(), 77)
    end
    it("union parameter with default value") do ->
      assert_run_exits(ut_with_default(), 99)
    end
    it("union in if condition") do ->
      assert_run_exits(ut_in_condition(), 5)
    end
    it("union alias reused across functions") do ->
      assert_run_exits(ut_alias_reuse(), 30)
    end
    it("union with Nil member type") do ->
      assert_run_exits(ut_nil_member(), 0)
    end
    it("nested function calls with union params") do ->
      assert_run_exits(ut_nested_calls(), 20)
    end
    it("union with 4 members") do ->
      assert_run_exits(ut_four_members(), 55)
    end
  end

  return qspec_main()
end

def ut_first_member(): String = """
  def accept_val(x: Int | String): Int
    return 42
  end
  def main(): Int
    return accept_val(10)
  end
  """

def ut_second_member(): String = """
  def accept_val(x: Int | String): Int
    return 43
  end
  def main(): Int
    return accept_val("hello")
  end
  """

def ut_return_type(): String = """
  def get_value(): Int | String
    return 44
  end
  def main(): Int
    return get_value()
  end
  """

def ut_three_members(): String = """
  def accept_val(x: Int | String | Bool): Int
    return 45
  end
  def main(): Int
    return accept_val(true)
  end
  """

def ut_named_alias(): String = """
  type Value = Int | String
  def accept_val(x: Value): Int
    return 46
  end
  def main(): Int
    return accept_val(10)
  end
  """

def ut_multi_func(): String = """
  def uf_inner(x: Int | String): Int
    return 10
  end
  def uf_outer(x: Int | String): Int
    return uf_inner(x)
  end
  def main(): Int
    return uf_outer(5)
  end
  """

def ut_local_var(): String = """
  def uf_process(x: Int | String): Int
    return 50
  end
  def main(): Int
    var v = 42
    return uf_process(v)
  end
  """

def ut_bool_member(): String = """
  def uf_check(x: Int | Bool): Int
    return 1
  end
  def main(): Int
    return uf_check(true)
  end
  """

def ut_chain_call(): String = """
  def make_val(): Int | String
    return 77
  end
  def use_val(x: Int | String): Int
    return x
  end
  def main(): Int
    return use_val(make_val())
  end
  """

def ut_with_default(): String = """
  def uf_default(x: Int | String = 99): Int
    return x
  end
  def main(): Int
    return uf_default()
  end
  """

def ut_in_condition(): String = """
  def uf_cond(x: Int | String): Int
    if x
      return 5
    end
    return 0
  end
  def main(): Int
    return uf_cond(1)
  end
  """

def ut_alias_reuse(): String = """
  type V = Int | String
  def uf_one(x: V): Int
    return 10
  end
  def uf_two(x: V): Int
    return 20
  end
  def main(): Int
    return uf_one(1) + uf_two(2)
  end
  """

def ut_nil_member(): String = """
  def uf_nil(x: Int | Nil): Int
    return 0
  end
  def main(): Int
    return uf_nil(nil)
  end
  """

def ut_nested_calls(): String = """
  def uf_deep(x: Int | String): Int
    return 20
  end
  def uf_wrap(x: Int | String): Int
    return uf_deep(x)
  end
  def main(): Int
    return uf_wrap(5)
  end
  """

def ut_four_members(): String = """
  def uf_poly(x: Int | String | Bool | Nil): Int
    return 55
  end
  def main(): Int
    return uf_poly(nil)
  end
  """
