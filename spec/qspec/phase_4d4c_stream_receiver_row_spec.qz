## Phase 4D.4c — Stream<T, body_row> receiver-row propagation at call sites.
##
## Verifies that calling a UFCS method on a Stream-typed receiver widens
## the caller's effect row by the receiver's body_row. Builds on 4D.4b's
## ptype synthesis: at tc_function, generator-fn return types upgrade
## from bare TYPE_STRUCT to Stream<T, body_row>; this phase wires the
## consumer side at typecheck_expr_handlers.qz:tc_expr_call so the
## body_row propagates to caller_row at every `.next()` (or future
## Stream method) callsite.
##
## What this pins down:
##
##   1. Pure sync `def gen(): impl Iterator<Int>` carries body_row=-1; a
##      pure caller's `.next()` widens by nothing (no `can` widening; no
##      QZ0610). Identical to pre-4D.4c behavior.
##   2. Row-poly `def gen(): impl Iterator<Int> can Async` carries
##      body_row={Async}; a caller declaring `can Async` calls `.next()`
##      cleanly (no QZ0610 — handler covers it).
##   3. Same row-poly source from a caller declaring an UNRELATED `can`
##      row (e.g. `can Throws`) emits QZ0610 because the receiver's
##      Async row isn't covered. This is the visible-behavior win — the
##      typesystem now catches the missed effect at the call site
##      instead of waiting for runtime.
##   4. Explicit `def gen(): impl AsyncIterator<Int>` produces the same
##      Stream<T, {Async}> ptype via the implicit-Async fallback in
##      tc_function (when is_async_generator==true and no `can` suffix
##      was found). Symmetric behavior with row-poly form.
##   5. Sync gen consumed via `.next()` from a caller with a tracked
##      row (e.g. `can Throws`) does NOT emit QZ0610 (sync's body_row=-1
##      means no labels to propagate).
##
## Out of scope (covered by 4D.4d / 4D.5b):
##
##   - For-in widening through the static type. F.3c at typecheck_walk.qz:3411
##     stays load-bearing for `for v in src`-of-async-iter.
##   - Async-gen MIR constructor wrapping in Stream<T>. Direct .next()
##     on async-typed bindings still hits the frame_ptr return — this
##     phase only protects the typecheck side.
##   - Chained NODE_CALL receivers (`my_async_gen().next()`). Only
##     NODE_IDENT receivers carry the binding; chained needs recursive
##     tc_expr to read the type and isn't covered here.
##
## Note: the QZ0610 error message currently shows a garbled label name
## (e.g., "missing my_async" instead of "missing Async"). This is a
## pre-existing tc.interner-vs-intern_global mismatch — same bug affects
## all B.7 row checks (typecheck_expr_handlers.qz:1505) and is unrelated
## to 4D.4c. Filed for separate cleanup.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.4c — Stream receiver-row propagation at call sites") do ->
    it("sync gen .next() from pure caller — no QZ0610, no widening") do ->
      assert_compile_succeeds("""
def three(): impl Iterator<Int>
  yield 1
  yield 2
end

def main(): Int
  var s = three()
  var v = s.next()
  return 0
end
""")
    end

    it("async row-poly gen .next() from `can Async` caller — passes") do ->
      assert_compile_succeeds("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Async
  var s = my_async()
  var v = s.next()
end

def main(): Int
  return 0
end
""")
    end

    it("async row-poly gen .next() from caller with unrelated `can` — QZ0610") do ->
      assert_compile_error("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Throws
  var s = my_async()
  var v = s.next()
end

def main(): Int
  return 0
end
""", "QZ0610")
    end

    it("explicit AsyncIterator .next() from `can Async` caller — passes") do ->
      assert_compile_succeeds("""
def my_async(): impl AsyncIterator<Int>
  yield 42
end

def caller() can Async
  var s = my_async()
  var v = s.next()
end

def main(): Int
  return 0
end
""")
    end

    it("sync gen .next() from `can Throws` caller — no QZ0610 (body_row=-1)") do ->
      assert_compile_succeeds("""
def three(): impl Iterator<Int>
  yield 7
end

def caller() can Throws
  var s = three()
  var v = s.next()
end

def main(): Int
  return 0
end
""")
    end
  end

  return qspec_main()
end
