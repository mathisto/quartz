## Phase 4D.5b — async-generator + `can Yield` helper interleaving.
##
## Operation Piezoelectric Effects, Phase 4D.5b followup spec.
##
## What this spec pins down:
##
## A `def helper(...): Void can Yield<Int>` callable from an async-generator
## body (`def gen(): impl AsyncIterator<Int>`) interleaves correctly with
## the generator's own yields. Each `yield` inside the helper propagates
## through the async-gen's `$poll` state machine to the consumer's
## `for await` loop one value at a time.
##
## Pre-4D.5b history:
##
## The Phase 4 retrospective (`docs/design/PHASE_4_GENERATORS_RETRO.md` §4)
## flagged "async-gen + helper interleaving" as broken pending the row-poly
## Stream consolidation. The producer-side $poll merge in 4D.5b
## (`mir_lower_async_generator` no longer emits `$poll` body inline; both
## sync gens and async gens go through `mir_lower_async_poll`'s state
## machine) incidentally unblocked the case: with the body-lowering paths
## unified, helper composition inside an async generator follows the same
## kind=3 routing as helper composition inside a sync generator (covered
## by `generators_p4b8_modular_helpers_spec.qz`).
##
## This spec mirrors the 4.B.8 sync-gen helper tests against async-gen
## consumers, plus a few cross-row composition cases (sync helper called
## from async gen, async-aware consumer driving the result).
##
## Why this spec lives at 4D.5b and not 4D.7:
##
## 4D.7 (per design memo §4D.7) is the end-to-end spec for the full
## row-poly Stream story — including consumer-side merge semantics that
## are still open. This spec is narrower: it pins down the helper-
## interleaving capability that the producer-side merge alone delivered.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.5b — async-generator + can Yield helper interleaving") do ->

    it("single-yield helper called from async generator yields the value") do ->
      assert_run_stdout_eq("""
def emit_one(v: Int): Void can Yield<Int>
  yield v
end

def gen_one(): impl AsyncIterator<Int>
  emit_one(42)
end

def main(): Int
  for await x in gen_one()
    puts(x.to_s())
  end
  return 0
end
""", "42\n")
    end

    it("multi-yield helper called twice from async generator yields all values in order") do ->
      assert_run_stdout_eq("""
def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def two_pairs(): impl AsyncIterator<Int>
  emit_pair(1, 2)
  emit_pair(3, 4)
end

def main(): Int
  for await x in two_pairs()
    puts(x.to_s())
  end
  return 0
end
""", "1\n2\n3\n4\n")
    end

    it("helper with conditional yield in while loop preserves loop state across async-gen suspends") do ->
      assert_run_stdout_eq("""
def emit_evens(lo: Int, hi: Int): Void can Yield<Int>
  var x = lo
  while x <= hi
    if x % 2 == 0
      yield x
    end
    x = x + 1
  end
end

def evens_gen(): impl AsyncIterator<Int>
  emit_evens(1, 10)
end

def main(): Int
  var sum = 0
  for await x in evens_gen()
    sum = sum + x
  end
  puts(sum.to_s())
  return 0
end
""", "30\n")
    end

    it("helper-calls-helper composition inside async generator") do ->
      assert_run_stdout_eq("""
def emit_one(v: Int): Void can Yield<Int>
  yield v
end

def emit_three(a: Int, b: Int, c: Int): Void can Yield<Int>
  emit_one(a)
  emit_one(b)
  emit_one(c)
end

def gen_three(): impl AsyncIterator<Int>
  emit_three(100, 200, 300)
end

def main(): Int
  var sum = 0
  for await x in gen_three()
    sum = sum + x
  end
  puts(sum.to_s())
  return 0
end
""", "600\n")
    end

    it("mixed direct yield + helper call in async generator body") do ->
      assert_run_stdout_eq("""
def emit_one(v: Int): Void can Yield<Int>
  yield v
end

def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def mixed(): impl AsyncIterator<Int>
  yield 1
  emit_one(2)
  yield 3
  emit_pair(4, 5)
end

def main(): Int
  var sum = 0
  for await x in mixed()
    sum = sum + x
  end
  puts(sum.to_s())
  return 0
end
""", "15\n")
    end

    it("parameterized helper preserves params across async-gen suspends") do ->
      assert_run_stdout_eq("""
def emit_n(start: Int, count: Int): Void can Yield<Int>
  var i = 0
  while i < count
    yield start + i
    i = i + 1
  end
end

def gen_seq(): impl AsyncIterator<Int>
  emit_n(10, 3)
  emit_n(100, 2)
end

def main(): Int
  for await x in gen_seq()
    puts(x.to_s())
  end
  return 0
end
""", "10\n11\n12\n100\n101\n")
    end

    it("for-in (NODE_FOR) consumer also drives async-gen + helper interleaving") do ->
      # 4D.4d's type-driven for-in row widening lets `for x in async_gen()`
      # work alongside `for await`. Same helper-interleaving must apply.
      assert_run_stdout_eq("""
def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def gen(): impl AsyncIterator<Int>
  emit_pair(7, 8)
  emit_pair(9, 10)
end

def main(): Int
  for x in gen()
    puts(x.to_s())
  end
  return 0
end
""", "7\n8\n9\n10\n")
    end

    it("row-poly form (impl Iterator<T> can Async) interleaves with helper") do ->
      # 4D.3's row-poly surface form should behave identically to explicit
      # impl AsyncIterator. The helper composition path is the same.
      assert_run_stdout_eq("""
def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def gen(): impl Iterator<Int> can Async
  emit_pair(1, 2)
  emit_pair(3, 4)
end

def main(): Int
  var sum = 0
  for await x in gen()
    sum = sum + x
  end
  puts(sum.to_s())
  return 0
end
""", "10\n")
    end
  end
  return qspec_main()
end
