## Function Type Registry Tests (Phase F-Beta)
## Tests Fn(A, B): C type tracking, Task<T> return type preservation,
## and function type annotation validation.
##
## Contract:
##   1. Fn type in function parameters.
##   2. Fn type as return type.
##   3. Fn type variable binding.
##   4. Task<T> return type from spawn.

import * from qspec
import * from qspec/subprocess

def main(): Int
  ## =========================================================================
  ## 1. Fn type annotations in function params
  ## =========================================================================
  describe("Fn type in function parameters") do ->
    it("Fn(Int): Int param accepts named function") do ->
      assert_run_exits(ftr_fn_param_named_src(), 42)
    end

    it("Fn(Int, Int): Int param accepts binary function") do ->
      assert_run_exits(ftr_fn_param_binary_src(), 42)
    end

    it("Fn(): Int param accepts zero-arg function") do ->
      assert_run_exits(ftr_fn_param_nullary_src(), 42)
    end

    it("Fn(Int): Void param accepts void function") do ->
      assert_run_exits(ftr_fn_param_void_src(), 0)
    end
  end

  ## =========================================================================
  ## 2. Fn type as return type
  ## =========================================================================
  describe("Fn type as return type") do ->
    it("function returning Fn(Int): Int") do ->
      assert_run_exits(ftr_fn_return_type_src(), 42)
    end

    it("function returning Fn(Int, Int): Int") do ->
      assert_run_exits(ftr_fn_return_binary_src(), 42)
    end
  end

  ## =========================================================================
  ## 3. Fn type variable assignment
  ## =========================================================================
  describe("Fn type variable binding") do ->
    it("variable with Fn(Int): Int annotation") do ->
      assert_run_exits(ftr_fn_var_annotation_src(), 42)
    end

    it("Fn-typed variable callable") do ->
      assert_run_exits(ftr_fn_var_callable_src(), 42)
    end
  end

  ## =========================================================================
  ## 4. Task<T> type preservation
  ## =========================================================================
  describe("Task<T> return type from go") do ->
    it("go -> Int creates Task<Int>") do ->
      assert_run_exits(ftr_task_int_src(), 42)
    end

    it("go -> String preserves String type") do ->
      assert_run_exits(ftr_task_string_src(), 5)
    end
  end

  return qspec_main()
end

## =============================================================================
## Helper source generators
## =============================================================================

def ftr_fn_param_named_src(): String = """
  def double(n: Int): Int = n * 2
  def apply(f: Fn(Int): Int, x: Int): Int = f(x)
  def main(): Int
    return apply(double, 21)
  end
  """

def ftr_fn_param_binary_src(): String = """
  def add(a: Int, b: Int): Int = a + b
  def apply2(f: Fn(Int, Int): Int, x: Int, y: Int): Int = f(x, y)
  def main(): Int
    return apply2(add, 20, 22)
  end
  """

def ftr_fn_param_nullary_src(): String = """
  def get42(): Int = 42
  def run(f: Fn(): Int): Int = f()
  def main(): Int
    return run(get42)
  end
  """

def ftr_fn_param_void_src(): String = """
  def noop(x: Int): Void
    return
  end
  def run_void(f: Fn(Int): Void, x: Int): Int
    f(x)
    return 0
  end
  def main(): Int
    return run_void(noop, 1)
  end
  """

def ftr_fn_return_type_src(): String = """
  def double(n: Int): Int = n * 2
  def get_doubler(): Fn(Int): Int = double
  def main(): Int
    f = get_doubler()
    return f(21)
  end
  """

def ftr_fn_return_binary_src(): String = """
  def add(a: Int, b: Int): Int = a + b
  def get_adder(): Fn(Int, Int): Int = add
  def main(): Int
    f = get_adder()
    return f(20, 22)
  end
  """

def ftr_fn_var_annotation_src(): String = """
  def double(n: Int): Int = n * 2
  def main(): Int
    var f: Fn(Int): Int = double
    return f(21)
  end
  """

def ftr_fn_var_callable_src(): String = """
  def add(a: Int, b: Int): Int = a + b
  def main(): Int
    var f: Fn(Int, Int): Int = add
    return f(20, 22)
  end
  """

def ftr_task_int_src(): String = """
  def main(): Int
    t = go (-> 42)
    return await t
  end
  """

def ftr_task_string_src(): String = """
  def main(): Int
    t = go (-> "hello")
    s = await t
    return str_size(s)
  end
  """
