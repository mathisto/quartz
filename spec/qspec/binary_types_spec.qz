## Binary DSL — Sub-phase 1.4 STEP 1: type-name resolution.
##
## Verifies that `type Foo = binary { ... }` and `packed struct(uN) Bar`
## register the type name in the typechecker so:
##   - `var h: Foo` typechecks
##   - `Foo { field: value, ... }` struct-literal construction works
##   - `h.field` field access works
##   - `Bar { field: value }` works for packed structs
##
## Method synthesis (.encode/.decode/as) is STEP 2.
## MIR lowering is STEP 3. Real codegen is STEP 4.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — type-name resolution (STEP 1)") do ->

    it("registers binary block as a constructible type") do ->
      assert_run_exits("""
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var h = PngIhdr {
            width: 1920, height: 1080,
            bit_depth: 8, color_type: 2,
            compression: 0, filter: 0, interlace: 0,
          }
          return h.width - 1920 + h.bit_depth
        end
        """, 8)
    end

    it("allows field access on binary block value") do ->
      assert_run_exits("""
        type IntMapHeader = binary {
          cap:  u64le
          len:  u64le
          keys: u64le
          vals: u64le
          used: u64le
        }
        def main(): Int
          var h = IntMapHeader { cap: 16, len: 3, keys: 0, vals: 0, used: 0 }
          return h.cap - h.len
        end
        """, 13)
    end

    it("registers packed struct as a constructible type") do ->
      assert_run_exits("""
        packed struct(u32) GpioModer
          pin0_mode:  2
          pin1_mode:  2
          pin2_mode:  2
          pin3_mode:  2
          pin4_mode:  2
          pin5_mode:  2
          pin6_mode:  2
          pin7_mode:  2
          pin8_mode:  2
          pin9_mode:  2
          pin10_mode: 2
          pin11_mode: 2
          pin12_mode: 2
          pin13_mode: 2
          pin14_mode: 2
          pin15_mode: 2
        end
        def main(): Int
          var m = GpioModer {
            pin0_mode: 1, pin1_mode: 0, pin2_mode: 0, pin3_mode: 0,
            pin4_mode: 0, pin5_mode: 1, pin6_mode: 1, pin7_mode: 0,
            pin8_mode: 0, pin9_mode: 0, pin10_mode: 0, pin11_mode: 0,
            pin12_mode: 0, pin13_mode: 0, pin14_mode: 0, pin15_mode: 0,
          }
          return m.pin5_mode + m.pin6_mode + m.pin0_mode
        end
        """, 3)
    end

    it("pad fields are not accessible on binary blocks") do ->
      # `_` fields are padding — they should not appear as accessible fields.
      assert_compile_error("""
        type Padded = binary {
          flags: u4
          count: u3
          _:     u1
        }
        def main(): Int
          var p = Padded { flags: 0, count: 0 }
          return p._
        end
        """, "")
    end

    it("binary block field types match the decoded widths (u8 fits in Int)") do ->
      assert_run_exits("""
        type BleAdvHeader = binary {
          pdu_type:  u4
          rfu:       u2
          tx_addr:   u1
          rx_addr:   u1
          length:    u8
        }
        def main(): Int
          var h = BleAdvHeader {
            pdu_type: 0b0010, rfu: 0b00, tx_addr: 1, rx_addr: 0,
            length: 42,
          }
          return h.length + h.pdu_type + h.tx_addr
        end
        """, 45)
    end
  end

  return qspec_main()
end
