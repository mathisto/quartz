## SURF.FLOW S1 — flow-narrowing INVALIDATION on a `&mut self` method call, plus
## the two previously-UNSPEC'd sound invalidations (GAP-A0): `&mut x` free-fn arg
## DOES invalidate, and a `&x` (shared) borrow does NOT.
##
## THE HOLE (audit §3): the narrowing engine drops a refinement on `x = e` reassign,
## `&mut x` borrow, and mutable-closure capture — but a method call `x.foo()` whose
## callee takes `&mut self` was NOT invalidated. `foo` can flip `x`'s union cell to a
## different member IN PLACE (`self.u = "boom"`), so a bare read of the narrowed
## subject AFTER the call read the STALE member → unsound. The fix routes a
## `&mut self` receiver through `tc_narrow_invalidate_rooted` (rooted at the
## receiver path, so a narrowing on `s.u` is dropped by a `&mut self` call on `s`).
##
## Observable idiom (proven by spec/qz/gap_b2_field_narrow_smoke.qz): a FIELD-access
## UNION member narrows — `if s.u is Int` recovers the Int MEMBER (payload@1 of the
## tagged `{tag@0, payload@1}` cell), so `use_int(s.u)=142`. An UN-narrowed read of
## `s.u` reads the union CELL word, a large garbage integer, NOT the member. (This is
## the union-field path; Option-FIELD `is Some` narrowing does NOT fire — the reason
## the earlier draft's control was vacuous.)
##
## Each S1 test is TWO-SIDED:
##   - CONTROL (no `&mut self` call) proves union-field narrowing actually FIRES
##     (== 142) — so "invalidated" can't pass vacuously.
##   - the S1 case (with the `&mut self` call) proves it is DROPPED (!= 142).
## The `&self` pin proves we did NOT over-invalidate (narrowing SURVIVES a shared
## method call).
##
## A/B: golden reads the stale narrowed member after a `&mut self` call (142); the
## fixed compiler invalidates → the post-call read is the raw un-narrowed cell word.
import * from qspec

def use_int(x: Int): Int = x + 100

# A cell owning a `Int | String` union field, with an explicit `&mut self` mutator
# that flips the member to String (variant change) and a `&self` reader that only
# reads. `u` is a `var` field so the `&mut self` reassignment is legal.
struct UCell
  u: Int | String
end

extend UCell
  # `&mut self`: reassigns the union cell to the String member → any narrowing on
  # `self.u` (proven `is Int` at the guard) is now stale.
  def flip(&mut self): Void
    self.u = "boom"
  end
  # `&self`: reads without mutating → narrowing on `self.u` must SURVIVE.
  def peek(&self): Int
    return 0
  end
end

# --- CONTROL: union-field narrowing on `c.u is Int` fires (recovers the member). ---
def control_field_narrows(): Int
  var c = UCell { u: 0 }
  c.u = 42
  var r = 0
  if c.u is Int
    r = use_int(c.u)   # narrowed → member 42 → 142
  end
  return r
end

# --- S1: a `&mut self` call inside the narrowed region DROPS the narrowing. ---
# After flip() (which sets self.u = "boom"), a bare read of c.u must be un-narrowed
# (raw union cell word), NOT the narrowed 142. If S1 were unfixed the stale narrow
# would still take payload@1 → a (now bogus) narrowed read.
def s1_mut_self_flip_invalidates(): Int
  var c = UCell { u: 0 }
  c.u = 42
  var r = 0
  if c.u is Int
    c.flip()           # &mut self → invalidate narrowing on c.u
    r = use_int(c.u)   # invalidated: garbage; broken: 142
  end
  return r
end

# --- PIN: a `&self` (shared) method call does NOT invalidate — narrowing SURVIVES. ---
# peek() cannot mutate the cell, so dropping the narrowing here would be a needless
# over-rejection. The read after peek() must STILL be narrowed → 142.
def shared_self_keeps_narrowing(): Int
  var c = UCell { u: 0 }
  c.u = 42
  var r = 0
  if c.u is Int
    var _p = c.peek()  # &self → narrowing preserved
    r = use_int(c.u)   # still narrowed → 142
  end
  return r
end

# --- A0 PIN: `&mut x` free-fn arg DOES invalidate (code exists at walk:1698). ---
def touch_mut(o: &mut Option<Int>): Void = nop()
def nop(): Void = ()

# narrow `o`, then hand out `&mut o`; the bare read after must be un-narrowed.
def mut_borrow_invalidates(): Int
  var o: Option<Int> = option_some(42)
  var r = 0
  if o.some?
    touch_mut(&mut o)  # &mut x → invalidate narrowing on o
    r = use_int(o)     # invalidated: garbage; broken: 142
  end
  return r
end

# --- A0 PIN: a shared borrow `&o` does NOT invalidate — narrowing SURVIVES. ---
def read_shared(o: &Option<Int>): Int = 0

def shared_borrow_keeps_narrowing(): Int
  var o: Option<Int> = option_some(42)
  var r = 0
  if o.some?
    var _s = read_shared(&o)   # &x shared → narrowing preserved
    r = use_int(o)             # still narrowed → 142
  end
  return r
end

def main(): Int
  describe("SURF.FLOW S1 — &mut self method-call invalidation") do ->
    it("CONTROL: c.u narrows in `if c.u is Int` (union-field narrowing fires)") do ->
      assert_eq(control_field_narrows(), 142)
    end
    it("drops narrowing after a `&mut self` call that flips self.u to String") do ->
      assert_eq(s1_mut_self_flip_invalidates() == 142, false)
    end
    it("does NOT invalidate on a `&self` (shared) method call — narrowing survives") do ->
      assert_eq(shared_self_keeps_narrowing(), 142)
    end
  end

  describe("SURF.FLOW A0 — pin the sound borrow invalidations") do ->
    it("`&mut x` free-fn arg invalidates narrowing on x") do ->
      assert_eq(mut_borrow_invalidates() == 142, false)
    end
    it("`&x` shared borrow does NOT invalidate — narrowing survives") do ->
      assert_eq(shared_borrow_keeps_narrowing(), 142)
    end
  end

  return qspec_main()
end
