## Binary DSL — Sub-phase 1.1 parse coverage.
##
## These tests cover ONLY the parser surface. Typechecker validation
## (width-sum, alignment, sub-byte types outside binary blocks) lands
## in sub-phase 1.2. Real codegen lands in sub-phase 1.4.
##
## See: docs/design/BINARY_DSL.md

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — parser") do ->

    it("parses IPv4 header with sub-byte + multi-byte + bytes fields") do ->
      assert_compile_succeeds("""
        type IPv4Header = binary {
          version:    u4
          ihl:        u4
          tos:        u8
          total:      u16be
          id:         u16be
          flags:      u3
          frag_off:   u13be
          ttl:        u8
          proto:      u8
          checksum:   u16be
          src:        u32be
          dst:        u32be
          payload:    bytes
        }
        def main(): Int = 0
        """)
    end

    it("parses BLE advertising header (sub-byte heavy)") do ->
      assert_compile_succeeds("""
        type BleAdvHeader = binary {
          pdu_type:  u4
          rfu:       u2
          tx_addr:   u1
          rx_addr:   u1
          length:    u8
        }
        def main(): Int = 0
        """)
    end

    it("parses PNG IHDR chunk (mixed widths, big-endian)") do ->
      assert_compile_succeeds("""
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int = 0
        """)
    end

    it("parses IntMapHeader (dogfooding example, u64le fields)") do ->
      assert_compile_succeeds("""
        type IntMapHeader = binary {
          cap:    u64le
          len:    u64le
          keys:   u64le
          vals:   u64le
          used:   u64le
        }
        def main(): Int = 0
        """)
    end

    it("parses packed struct(u32) GpioModer with 16 two-bit fields") do ->
      assert_compile_succeeds("""
        packed struct(u32) GpioModer
          pin0_mode:  2
          pin1_mode:  2
          pin2_mode:  2
          pin3_mode:  2
          pin4_mode:  2
          pin5_mode:  2
          pin6_mode:  2
          pin7_mode:  2
          pin8_mode:  2
          pin9_mode:  2
          pin10_mode: 2
          pin11_mode: 2
          pin12_mode: 2
          pin13_mode: 2
          pin14_mode: 2
          pin15_mode: 2
        end
        def main(): Int = 0
        """)
    end

    it("parses packed struct with u8 / u16 / u64 backing widths") do ->
      assert_compile_succeeds("""
        packed struct(u8) Flags8
          enabled: 1
          role:    3
          _:       4
        end
        packed struct(u16) Flags16
          a: 4
          b: 4
          c: 8
        end
        packed struct(u64) Big
          a: 32
          b: 32
        end
        def main(): Int = 0
        """)
    end

    it("parses empty binary block (typecheck rejects in 1.2 with QZ0950)") do ->
      assert_compile_error("""
        type Empty = binary {}
        def main(): Int = 0
        """, "QZ0950")
    end

    it("parses binary array fields — fixed, count-prefixed, rest-of-stream") do ->
      assert_compile_succeeds("""
        type Proto = binary {
          count:   u16be
          fixed:   [u8; 8]
          dyn:     [u8; count]
          rest:    [u8]
        }
        def main(): Int = 0
        """)
    end

    it("parses string-family fields: bytes(n), cstring, pstring(uN)") do ->
      assert_compile_succeeds("""
        type Msg = binary {
          tag:    u8
          name:   cstring
          short:  pstring(u8)
          medium: pstring(u16le)
          blob:   bytes(16)
        }
        def main(): Int = 0
        """)
    end

    it("accepts underscore pad fields inside binary block") do ->
      assert_compile_succeeds("""
        type Padded = binary {
          flags: u4
          count: u3
          _:     u1
        }
        def main(): Int = 0
        """)
    end

    it("rejects packed struct with non-integer backing width") do ->
      assert_compile_error("""
        packed struct(Int) Bad
          a: 4
        end
        def main(): Int = 0
        """, "backing type must be u8, u16, u32, or u64")
    end

    it("rejects packed struct field missing bit width") do ->
      assert_compile_error("""
        packed struct(u8) Bad
          a: u4
        end
        def main(): Int = 0
        """, "bare bit-width integer")
    end

    it("rejects [T; n] array type outside binary block") do ->
      assert_compile_error("""
        def main(): Int
          x: [u8; 10] = 0
          return x
        end
        """, "Expected type name")
    end

    it("rejects unclosed binary block") do ->
      assert_compile_error("""
        type Oops = binary {
          flags: u8
        def main(): Int = 0
        """, "")
    end

  end
  return qspec_main()
end
