## Stack Tests
##
## Contract:
##   1. New: `stack_new` creates empty stack with size 0.
##   2. LIFO: pop returns elements in reverse push order.
##   3. Empty pop: popping empty stack returns None.
##   4. Peek: returns top without removing, size unchanged.
##   5. Empty peek: peeking empty stack returns None.
##   6. Clear: removes all elements, stack is empty.
##   7. Size: size increments after each push.
##   8. Multi-pop: consecutive pops drain stack correctly.
import * from qspec
import * from collections/stack

def main(): Int
  describe("stack_new") do ->
    it("creates an empty stack") do ->
      var s = stack_new()
      assert_eq(s.size(), 0)
      assert_eq(s.is_empty(), 1)
      s.free()
    end
  end

  describe("push and pop") do ->
    it("pops in LIFO order") do ->
      assert_eq(stack_lifo(), 1)
    end

    it("returns None when popping empty stack") do ->
      var s = stack_new()
      assert(s.pop().none?)
      s.free()
    end
  end

  describe("peek") do ->
    it("returns top without removing") do ->
      assert_eq(stack_peek_test(), 1)
    end

    it("returns None on empty stack") do ->
      var s = stack_new()
      assert(s.peek().none?)
      s.free()
    end
  end

  describe("clear") do ->
    it("removes all elements") do ->
      assert_eq(stack_clear_test(), 1)
    end
  end

  describe("size tracking") do ->
    it("size increments after each push") do ->
      var s = stack_new()
      assert_eq(s.size(), 0)
      s.push(1)
      assert_eq(s.size(), 1)
      s.push(2)
      assert_eq(s.size(), 2)
      s.free()
    end

    it("push then pop then push tracks size") do ->
      var s = stack_new()
      s.push(10)
      s.push(20)
      s.pop()
      assert_eq(s.size(), 1)
      s.push(30)
      assert_eq(s.size(), 2)
      s.free()
    end
  end

  return qspec_main()
end

def stack_lifo(): Int
  var s = stack_new()
  s.push(10)
  s.push(20)
  s.push(30)
  var a = 0
  var b = 0
  var c = 0
  match s.pop()
    Some(v) => a = v
    _ => return 0
  end
  match s.pop()
    Some(v) => b = v
    _ => return 0
  end
  match s.pop()
    Some(v) => c = v
    _ => return 0
  end
  s.free()
  if a == 30
    if b == 20
      if c == 10
        return 1
      end
    end
  end
  return 0
end

def stack_peek_test(): Int
  var s = stack_new()
  s.push(42)
  var p = 0
  match s.peek()
    Some(v) => p = v
    _ => return 0
  end
  var sz = s.size()
  s.free()
  if p == 42
    if sz == 1
      return 1
    end
  end
  return 0
end

def stack_clear_test(): Int
  var s = stack_new()
  s.push(1)
  s.push(2)
  s.push(3)
  s.clear()
  var sz = s.size()
  var empty = s.is_empty()
  s.free()
  if sz == 0
    if empty
      return 1
    end
  end
  return 0
end
