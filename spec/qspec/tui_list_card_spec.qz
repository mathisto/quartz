## v0.3.3 step 2 — Multi-row card delegate behavior tests
##
## Sister spec to tui_list_spec.qz. Covers ItemDelegate.height>1: each
## item produces delegate.height visible rows; selection styling spans
## the whole item; cursor indicator only on row 0; offset math scrolls
## by visible_items_count = view_height / item_height; pad/truncate of
## show() output to item_height; degenerate height clamps.
##
## NOTE: lives in a separate file because tui_list_spec.qz is currently
## blocked by a tuple-field-access typecheck regression at commit
## 38714497 (filed as TUPLE_FIELD_ACCESS_PRESERVES_TYPE_ERROR_INNER).
## This spec uses `as_int(handle)` workaround only where necessary.

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/list as ls
import std/tui/layout as ly

enum CardSpecMsg
  Noop
end

## A 3-row card render: name on row 0, body on row 1, cost on row 2.
def show_card3(s: String): String
  return s + "\nbody line\n  cost: 1"
end

## A 2-row card render: name + cost.
def show_card2(s: String): String = s + "\n  cost: 1"

## A 1-line render that overflows when delegate height is 1 (no \n).
def show_one(s: String): String = s

## Builders return Int handles; a typed binding sits on the caller's side.
def make_3row_list(): Int
  var v = vec_new<String>()
  vec_push(v, "Strike")
  vec_push(v, "Defend")
  vec_push(v, "Bash")
  vec_push(v, "Cleave")
  var l = ls::list_new(v, ls::item_delegate_card(show_card3, 3))
  l = ls::list_with_size(l, 30, 9)   # 9 rows / 3 per item = 3 visible items
  return as_int(l)
end

# ============================================================
# Factory clamp + delegate fields
# ============================================================

def test_card_factory_height_set(): Void
  var d = ls::item_delegate_card(show_card3, 3)
  assert_eq(d.height, 3)
end

def test_card_factory_zero_clamps_to_one(): Void
  var d = ls::item_delegate_card(show_card3, 0)
  assert_eq(d.height, 1)
end

def test_card_factory_negative_clamps_to_one(): Void
  var d = ls::item_delegate_card(show_card3, -5)
  assert_eq(d.height, 1)
end

def test_simple_factory_height_is_one(): Void
  var d = ls::item_delegate_simple(show_one)
  assert_eq(d.height, 1)
end

# ============================================================
# Multi-row rendering — line count
# ============================================================

def test_view_renders_view_height_rows(): Void
  var l: ls::List<String> = as_type<ls::List<String>>(make_3row_list())
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 9)   # 9 rows total (3 items × 3 rows each)
end

def test_visible_items_round_down(): Void
  # height=10, item_height=3 → visible_items=3 (10/3=3, last row blank)
  var v = vec_new<String>()
  vec_push(v, "A")
  vec_push(v, "B")
  vec_push(v, "C")
  vec_push(v, "D")
  var l = ls::list_new(v, ls::item_delegate_card(show_card3, 3))
  l = ls::list_with_size(l, 30, 10)
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 10)  # window is exactly 10 rows
end

# ============================================================
# Cursor indicator and selection styling
# ============================================================

def test_indicator_only_on_first_row_of_selected(): Void
  var l: ls::List<String> = as_type<ls::List<String>>(make_3row_list())
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  # selected = 0 by default; row 0 has ▶, rows 1+2 should NOT
  if str_byte_at(lines[0], 0) == 0xE2 and str_byte_at(lines[0], 1) == 0x96
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  assert_eq(str_byte_at(lines[1], 0), ' ')
  assert_eq(str_byte_at(lines[1], 1), ' ')
  assert_eq(str_byte_at(lines[2], 0), ' ')
  assert_eq(str_byte_at(lines[2], 1), ' ')
end

def test_continuation_rows_have_blank_gutter(): Void
  # selected = 0 (Strike, rows 0..2). row 3 starts unselected Defend.
  var l: ls::List<String> = as_type<ls::List<String>>(make_3row_list())
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(str_byte_at(lines[3], 0), ' ')
  assert_eq(str_byte_at(lines[3], 1), ' ')
end

# ============================================================
# Offset math: scrolling with multi-row items
# ============================================================

def test_select_below_window_scrolls_in_items(): Void
  # 4 items in a 9-row view (3 visible items). Select item 3 (last).
  var l: ls::List<String> = as_type<ls::List<String>>(make_3row_list())
  l = ls::list_set_selected(l, 3)
  # offset should be 1 (so items 1,2,3 are visible: 9 rows)
  assert_eq(ls::list_offset(l), 1)
end

def test_page_down_advances_by_visible_items(): Void
  # 4 items, view shows 3. Ctrl-F advances by visible_items (=3).
  var l: ls::List<String> = as_type<ls::List<String>>(make_3row_list())
  var msg: tui::FrameMsg<CardSpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_CTRL_F(), modifiers: 0 })
  var triple = ls::list_update(l, msg)
  l = as_type<ls::List<String>>(as_int(triple).0)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 3)   # 0 + 3 (page=visible_items)
    None      => assert_eq(0, 1)
  end
end

# ============================================================
# show() output mismatching delegate.height
# ============================================================

def test_short_show_output_pads_with_blank(): Void
  # 2-row delegate, but show returns only 1 line → row 1 blank
  var v = vec_new<String>()
  vec_push(v, "Solo")
  var l = ls::list_new(v, ls::item_delegate_card(show_one, 2))
  l = ls::list_with_size(l, 20, 4)
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  # row 0 = "Solo" content with indicator; row 1 = padding (mostly spaces)
  assert_eq(lines.size, 4)
  # row 1's body (after gutter) should be all spaces
  var row1 = lines[1]
  var row1_inner = str_byte_slice(row1, 2, str_byte_len(row1))
  var i = 0
  var all_spaces = true
  while i < str_byte_len(row1_inner)
    if str_byte_at(row1_inner, i) != ' '
      all_spaces = false
    end
    i = i + 1
  end
  assert_eq(if all_spaces then 1 else 0 end, 1)
end

def test_long_show_output_truncates(): Void
  # 1-row delegate but show returns 3 lines — height=1 keeps just the
  # whole rendered string (no split). The wide line gets clip_to_width
  # applied; \n inside breaks the row layout — accept current behavior:
  # height=1 doesn't split. Confirm that height=1 default still works.
  var v = vec_new<String>()
  vec_push(v, "Solo")
  var l = ls::list_new(v, ls::item_delegate_simple(show_one))
  l = ls::list_with_size(l, 20, 3)
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 3)
end

def main(): Int
  describe("ItemDelegate factory") do ->
    it("item_delegate_card sets height") do ->
      test_card_factory_height_set()
    end
    it("height=0 clamps to 1") do ->
      test_card_factory_zero_clamps_to_one()
    end
    it("negative height clamps to 1") do ->
      test_card_factory_negative_clamps_to_one()
    end
    it("item_delegate_simple has height=1") do ->
      test_simple_factory_height_is_one()
    end
  end

  describe("multi-row rendering") do ->
    it("renders view_height rows total") do ->
      test_view_renders_view_height_rows()
    end
    it("visible items rounds down (partial last item hidden)") do ->
      test_visible_items_round_down()
    end
  end

  describe("cursor and gutter") do ->
    it("indicator only on first row of selected") do ->
      test_indicator_only_on_first_row_of_selected()
    end
    it("unselected rows have blank gutter") do ->
      test_continuation_rows_have_blank_gutter()
    end
  end

  describe("offset math") do ->
    it("selecting below window scrolls by items") do ->
      test_select_below_window_scrolls_in_items()
    end
    it("page-down advances by visible_items") do ->
      test_page_down_advances_by_visible_items()
    end
  end

  describe("show output sizing") do ->
    it("padding when show output shorter than height") do ->
      test_short_show_output_pads_with_blank()
    end
    it("default height-1 delegate still works") do ->
      test_long_show_output_truncates()
    end
  end

  return qspec_main()
end
