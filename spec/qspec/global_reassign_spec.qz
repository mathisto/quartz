import * from qspec

var _counter = 0
var _name = "initial"
var _items = vec_new<String>()

def reset_state(): Void
  _counter = 0
  _name = "reset"
end

def increment(): Void
  _counter = _counter + 1
end

def set_name(n: String): Void
  _name = n
end

def reinit_items(): Void
  _items = vec_new<String>()
  _items.push("fresh")
end

def get_counter(): Int = _counter
def get_name(): String = _name
def get_items(): Vec<String> = _items

def main(): Int
  describe("global reassignment") do ->
    it("reads initial int value") do ->
      assert_eq(get_counter(), 0)
    end

    it("increments global int") do ->
      increment()
      increment()
      increment()
      assert_eq(get_counter(), 3)
    end

    it("resets global int to zero") do ->
      reset_state()
      assert_eq(get_counter(), 0)
    end

    it("reassigns string global") do ->
      set_name("hello")
      assert_eq_str(get_name(), "hello")
    end

    it("reinitializes vec global") do ->
      reinit_items()
      var items = get_items()
      assert_eq(items.size, 1)
      assert_eq_str(items[0], "fresh")
    end

    it("reset_state sets name to reset") do ->
      reset_state()
      assert_eq_str(get_name(), "reset")
    end

    it("multiple increments accumulate") do ->
      reset_state()
      for i in 0..10
        increment()
      end
      assert_eq(get_counter(), 10)
    end
  end
  return qspec_main()
end
