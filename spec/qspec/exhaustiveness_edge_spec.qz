## Exhaustiveness Edge Cases: Bool and Result
##
## Contract:
##   1. Match on Bool with only 'true' arm → error missing 'false'
##   2. Match on Bool with both arms → passes
##   3. Match on Bool with wildcard → passes
##   4. Match on Result with only Ok → error missing 'Err'
##   5. Match on Result with both arms → passes

import * from qspec

# -- Bool exhaustiveness: both branches present --

def bool_both(b: Bool): Int
  match b
    true => 1
    false => 0
  end
end

# -- Bool exhaustiveness: wildcard --

def bool_wildcard(b: Bool): Int
  match b
    true => 1
    _ => 0
  end
end

# -- Result exhaustiveness: both branches present --

def result_both(r: Result<Int, String>): Int
  match r
    Result::Ok(v) => v
    Result::Err(e) => 99
  end
end

# -- Result exhaustiveness: wildcard --

def result_wildcard(r: Result<Int, String>): Int
  match r
    Result::Ok(v) => v
    _ => 0
  end
end

def main(): Int
  describe("exhaustiveness edge cases") do ->
    it("Bool match with both true and false compiles") do ->
      assert_eq(bool_both(true), 1)
      assert_eq(bool_both(false), 0)
    end

    it("Bool match with wildcard compiles") do ->
      assert_eq(bool_wildcard(true), 1)
      assert_eq(bool_wildcard(false), 0)
    end

    it("Result match with Ok and Err compiles") do ->
      assert_eq(result_both(Result::Ok(42)), 42)
      assert_eq(result_both(Result::Err("oops")), 99)
    end

    it("Result match with wildcard compiles") do ->
      assert_eq(result_wildcard(Result::Ok(42)), 42)
      assert_eq(result_wildcard(Result::Err("oops")), 0)
    end
  end

  return qspec_main()
end
