## Type Errors Tests
##
## Contract:
##   1. Type Errors.
##   2. Return type mismatches.
##   3. Function argument mismatches.
##   4. Undefined identifiers.
##   5. Operator type mismatches.
##   6. Assignment type mismatches.
##   7. Struct type errors.
##   8. Enum type errors.
##   9. Did you mean suggestions.
##   10. Valid code passes type checking.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Type Errors") do ->
    describe("return type mismatches") do ->
      it("rejects returning String when Int expected") do ->
        assert_compile_error("""
          def main(): Int
            return "hello"
          end
        """, "error[QZ")
      end

      it("rejects returning Void when Int expected") do ->
        assert_compile_error("""
          def nothing(): Void
            return
          end

          def main(): Int
            return nothing()
          end
        """, "error[QZ")
      end
    end

    describe("function argument mismatches") do ->
      it("rejects wrong number of arguments") do ->
        assert_compile_error("""
          def add(a: Int, b: Int): Int
            return a + b
          end

          def main(): Int
            return add(1)
          end
        """, "error[QZ")
      end

      # R2.3 arg-type soundness (QZ0201): positive-flag scalar mismatch.
      it("rejects String argument where Int expected") do ->
        assert_compile_error("""
          def add(a: Int, b: Int): Int
            return a + b
          end

          def main(): Int
            return add("hello", 3)
          end
        """, "QZ0201")
      end

      it("rejects Float argument where Int expected") do ->
        assert_compile_error("""
          def add(a: Int, b: Int): Int
            return a + b
          end

          def main(): Int
            return add(3.5, 3)
          end
        """, "QZ0201")
      end

      it("rejects Int argument where Float expected") do ->
        assert_compile_error("""
          def addf(a: F64, b: F64): F64
            return a + b
          end

          def main(): Int
            var z = addf(3, 3.0)
            return 0
          end
        """, "QZ0201")
      end

      it("permits a newtype value where the wrapped scalar is expected") do ->
        assert_compile_succeeds("""
          newtype Handle = Int
          def use_h(h: Int): Int
            return h + 1
          end
          def main(): Int
            var h: Handle = 5
            return use_h(h)
          end
        """)
      end
    end

    describe("undefined identifiers") do ->
      it("rejects undefined variables") do ->
        assert_compile_error("""
          def main(): Int
            return undefined_var
          end
        """, "error[QZ")
      end

      it("rejects undefined functions") do ->
        assert_compile_error("""
          def main(): Int
            return undefined_func()
          end
        """, "error[QZ")
      end
    end

    describe("operator type mismatches") do ->
      it("allows string + int via auto-coercion") do ->
        assert_compile_succeeds("""
          def main(): Int
            var s = "a" + 1
            return 0
          end
        """)
      end
      it("rejects string subtraction") do ->
        assert_compile_error("""
          def main(): Int
            var s = "a" - 1
            return 0
          end
        """, "can't do math with a String")
      end
      it("rejects string division") do ->
        assert_compile_error("""
          def main(): Int
            var s = "a" / 2
            return 0
          end
        """, "can't do math with a String")
      end
    end

    describe("assignment type mismatches") do ->
      it("rejects assigning String to Int variable") do ->
        assert_compile_error("""
          def main(): Int
            x = 42
            x = "hello"
            return x
          end
        """, "error[QZ")
      end

      # WS2.1 assign-side scalar soundness (QZ0201 family). Reassignment `x = e`
      # of an existing var is parsed as NODE_LET and previously did NO RHS scalar
      # check (C-bootstrap dynamic-retyping parity), so `Int ← String` printed ptr
      # bits and `String ← Int` SIGSEGV'd. Same narrow predicate as the R2.3
      # call-site check.
      it("rejects reassigning a String literal into an Int var") do ->
        assert_compile_error("""
          def main(): Int
            var x: Int = 5
            x = "hello"
            return x
          end
        """, "QZ0201")
      end

      it("rejects reassigning an Int literal into a String var") do ->
        assert_compile_error("""
          def main(): Int
            var s: String = "hi"
            s = 42
            return 0
          end
        """, "QZ0201")
      end

      it("rejects reassigning a Float literal into an Int var") do ->
        assert_compile_error("""
          def main(): Int
            var x: Int = 5
            x = 3.5
            return x
          end
        """, "QZ0201")
      end

      it("rejects a String compound-assigned into an Int var") do ->
        assert_compile_error("""
          def main(): Int
            var n = 5
            n += "x"
            return 0
          end
        """, "QZ0201")
      end

      # `s += 1` on a String is valid string+int concat (auto-coercion, same as
      # the `"a" + 1` operator rule) — the compound-assign check must NOT flag it.
      it("permits an Int compound-assigned into a String var (concat)") do ->
        assert_compile_succeeds("""
          def main(): Int
            var s = "hi"
            s += 1
            return 0
          end
        """)
      end

      # Erasure-safety carve-out: reading a String out of a Vec<String> and
      # assigning it into a String var must NOT false-flag — the element read
      # degrades to a TYPE_INT existential at the type level but holds a real
      # String pointer at runtime. The check flags String←Int ONLY for genuine
      # Int LITERAL RHS (see tc_assign_scalar_mismatch).
      it("permits a String var reassigned from a Vec<String> element read") do ->
        assert_compile_succeeds("""
          def main(): Int
            var strs = ["a", "b"]
            var s: String = ""
            s = strs[0]
            puts(s)
            return 0
          end
        """)
      end
    end

    describe("field-store type mismatches (WS2.1)") do ->
      # Struct construction (`P { x: "s" }`) was checked at init but the STORE
      # `p.x = "s"` was never type-checked — silent miscompile / SIGSEGV. QZ0201
      # family, narrow scalar predicate.
      it("rejects storing a String literal into an Int field") do ->
        assert_compile_error("""
          struct P
            x: Int
          end
          def main(): Int
            var p = P { x: 1 }
            p.x = "hello"
            return 0
          end
        """, "QZ0201")
      end

      it("rejects storing an Int literal into a String field") do ->
        assert_compile_error("""
          struct S
            name: String
          end
          def main(): Int
            var s = S { name: "a" }
            s.name = 42
            return 0
          end
        """, "QZ0201")
      end

      it("rejects storing an Int literal into an F64 field") do ->
        assert_compile_error("""
          struct F
            v: F64
          end
          def main(): Int
            var f = F { v: 1.0 }
            f.v = 42
            return 0
          end
        """, "QZ0201")
      end

      it("permits storing a matching-type value into a field") do ->
        assert_compile_succeeds("""
          struct P
            x: Int
            tag: String
          end
          def main(): Int
            var p = P { x: 1, tag: "a" }
            p.x = 99
            p.tag = "b"
            return p.x
          end
        """)
      end
    end

    describe("struct type errors") do ->
      it("rejects unknown struct type") do ->
        assert_compile_error("""
          def main(): Int
            p = UnknownStruct { x: 1 }
            return 0
          end
        """, "error[QZ")
      end

      it("rejects wrong field type in struct init") do ->
        assert_compile_error("""
          struct Point
            x: Int
            y: Int
          end

          def main(): Int
            p = Point { x: 1, y: "hello" }
            return 0
          end
        """, "expected Int, got String")
      end

      it("rejects unknown field name in struct init") do ->
        assert_compile_error("""
          struct Point
            x: Int
            y: Int
          end

          def main(): Int
            p = Point { x: 1, z: 2 }
            return 0
          end
        """, "has no field z")
      end
    end

    describe("enum type errors") do ->
      it("rejects unknown enum type") do ->
        assert_compile_error("""
          def main(): Int
            c = UnknownEnum::Variant
            return 0
          end
        """, "error[QZ")
      end

      it("rejects unknown variant") do ->
        assert_compile_error("""
          enum Color
            Red
            Green
          end

          def main(): Int
            c = Color::Blue
            return 0
          end
        """, "error[QZ")
      end
    end

    describe("Did you mean suggestions") do ->
      it("suggests similar function names for typos") do ->
        assert_compile_error("""
          def calculate(x: Int): Int = x * 2

          def main(): Int
            return calculte(5)
          end
        """, "Did you mean")
      end

      it("suggests similar variable names for typos") do ->
        assert_compile_error("""
          def main(): Int
            var counter = 42
            return counte
          end
        """, "Did you mean")
      end

      it("does not suggest for completely different names") do ->
        assert_compile_fails("""
          def main(): Int
            xyz_completely_unknown()
            return 0
          end
        """)
      end
    end

    describe("valid code passes type checking") do ->
      it("accepts well-typed return") do ->
        assert_run_exits("""
          def main(): Int
            return 42
          end
        """, 42)
      end

      it("accepts enum as Int") do ->
        assert_run_exits("""
          enum Status
            Ok
            Error
          end

          def main(): Int
            return Status::Ok
          end
        """, 0)
      end
    end
  end

  return qspec_main()
end
