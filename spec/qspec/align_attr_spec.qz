## @align(N) Struct Attribute Tests (EPIC SYS.1 item 4, partial)
##
## Contract:
##   1. `@align(N)` on a struct definition records N as the requested
##      alignment. N must be a power of 2, strictly positive.
##   2. The alignment is stored on the AST struct node (via a global
##      side-table) and propagated to MIR at struct-registration time.
##   3. Codegen reads the registered alignment and emits `align N`
##      on the hoisted @value-struct alloca, replacing the default
##      `align 8`.
##   4. `@align` on a non-struct declaration (function / enum / type
##      alias / newtype / global var / extern) is rejected at parse
##      time.
##   5. Non-positive or non-power-of-2 values are rejected at parse
##      time.
##
## SCOPE + CURRENT LIMITATION:
##   The codegen change at codegen.qz only fires for non-escaped
##   MIR_ALLOC_STACK instances. In the current compiler, @value
##   structs in most testable patterns are flagged as escaped by
##   the escape analyzer and heap-promoted (malloc i64 N) — including
##   the examples in spec/qspec/stack_alloc_return_spec.qz. The
##   IR-level `alloca [N x i64], align M` emission only manifests
##   when the escape analyzer leaves a @value struct non-escaped.
##
##   This is not a regression introduced by @align — it's the
##   pre-existing state of @value escape promotion. The @align
##   plumbing (parser → AST → MIR → codegen) is complete and ready
##   to honor alignment the moment a @value struct stays on the
##   stack. Tightening the escape analyzer (so more @value structs
##   stay non-escaped) is a separate effect-plan / kernel-epic item.
##
##   For now this spec covers the observable parser-level surface:
##   attribute acceptance, validation, and reject-on-wrong-target.
##   The codegen path has been verified correct by manual inspection
##   (see the commit message for the exact alloca-emission site).
import * from qspec

def main(): Int
  describe("@align(N) struct attribute (SYS.1 item 4, partial)") do ->
    it("@align(64) on struct parses cleanly") do ->
      # Smoke: the full attribute chain (@align + @value + struct def)
      # compiles without error. We don't assert on the generated IR
      # here because the codegen-level alignment only surfaces for
      # non-escaped @value structs — see header comment.
      assert_ir_contains("""
@align(64) @value
struct Padded
  x: Int
  y: Int
end

def main(): Int
  var p = Padded { x: 1, y: 2 }
  return p.x
end
""", "define i64 @qz_main")
    end

    it("@align(4096) parses — kernel page-size alignment") do ->
      assert_ir_contains("""
@align(4096) @value
struct PageFrame
  w0: Int
  w1: Int
end

def main(): Int
  var pf = PageFrame { w0: 0, w1: 0 }
  return pf.w0
end
""", "define i64 @qz_main")
    end

    it("@align on a function definition is rejected") do ->
      assert_compile_error("""
@align(64)
def foo(): Int = 0

def main(): Int = foo()
""", "@align can only be applied to struct definitions")
    end

    it("@align(0) is rejected at parse time") do ->
      assert_compile_error("""
@align(0)
struct Bad
  x: Int
end

def main(): Int = 0
""", "must be positive")
    end

    it("non-power-of-2 @align is rejected") do ->
      assert_compile_error("""
@align(7)
struct Bad
  x: Int
end

def main(): Int = 0
""", "power of 2")
    end

    it("@align requires an integer argument") do ->
      assert_compile_error("""
@align()
struct Bad
  x: Int
end

def main(): Int = 0
""", "requires an integer literal")
    end
  end

  return qspec_main()
end
