## Binary DSL — Sub-phase 1.4 STEP 2: method synthesis + MIR diversion.
##
## Verifies that `.encode()` and `Type.decode(bytes)` method signatures
## are synthesized on binary blocks, and that calls to them lower to
## MIR_BINARY_PACK / MIR_BINARY_UNPACK opcodes (rather than ordinary
## function calls that would fail to link).
##
## Real shift/mask codegen is STEP 4 — the stub dispatcher still emits
## `%vD = add i64 0, 0` for the opcodes, so the test checks compile +
## link + clean exit, and IR content for the BINARY DSL stub markers.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — method synthesis (STEP 2)") do ->

    it("TypeName.decode(bytes) compiles and allocates output struct") do ->
      assert_ir_contains("""
        import * from binary
        import * from bytes
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var b = Bytes { _data: vec_new() }
          var _r = PngIhdr.decode(b)
          return 0
        end
        """, "call ptr @malloc")
    end

    it("value.encode() compiles and performs byte-level stores") do ->
      assert_ir_contains("""
        import * from bytes
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var h = PngIhdr {
            width: 1920, height: 1080,
            bit_depth: 8, color_type: 2,
            compression: 0, filter: 0, interlace: 0,
          }
          var _b = h.encode()
          return 0
        end
        """, "store i64")
    end

    it("encode/decode runtime chain links (stub returns 0)") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type IntMapHeader = binary {
          cap:  u64le
          len:  u64le
          keys: u64le
          vals: u64le
          used: u64le
        }
        def main(): Int
          var h = IntMapHeader { cap: 16, len: 3, keys: 0, vals: 0, used: 0 }
          var _e = h.encode()
          var b = Bytes { _data: vec_new() }
          var _d = IntMapHeader.decode(b)
          return 0
        end
        """, 0)
    end

  end

  return qspec_main()
end
