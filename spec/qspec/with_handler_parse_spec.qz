## with-handler Block Parse (Operation Piezoelectric Effects, Milestone A)
##
## Verifies `with HANDLER do -> body end` syntax parses. Milestone A is
## parse-only: the handler expression is parsed (for syntactic validation)
## and discarded; the body is evaluated eagerly as a block. Milestone D
## replaces this with a real NODE_WITH that installs the handler on the
## evidence chain.

import * from qspec

def piezo_dummy_handler(): Int = 0
def piezo_other_handler(x: Int): Int = x

def piezo_with_body_value(): Int
  return with piezo_dummy_handler() do ->
    42
  end
end

def piezo_with_multi_stmt(): Int
  return with piezo_dummy_handler() do ->
    var a = 10
    var b = 20
    a + b
  end
end

def piezo_with_no_arrow(): Int
  return with piezo_dummy_handler() do
    7
  end
end

def piezo_with_handler_call(): Int
  return with piezo_other_handler(99) do ->
    5
  end
end

def main(): Int
  describe("with-handler block (piezo)") do ->
    it("returns body tail-expression value") do ->
      assert_eq(piezo_with_body_value(), 42)
    end

    it("multiple body statements") do ->
      assert_eq(piezo_with_multi_stmt(), 30)
    end

    it("arrow is optional") do ->
      assert_eq(piezo_with_no_arrow(), 7)
    end

    it("handler can be a call expression") do ->
      assert_eq(piezo_with_handler_call(), 5)
    end
  end
  return qspec_main()
end
