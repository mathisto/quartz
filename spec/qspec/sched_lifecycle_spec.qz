## Regression tests for B2 — scheduler state machine + free-without-zero audit.
##
## HISTORY: ROADMAP row "Free-without-zero pattern in `__qz_sched_shutdown`"
## (Apr 12, 2026). Recurring shape: global scheduler slots were `free()`'d
## without being zeroed, leaving dangling pointers that codegen treated as
## "scheduler still alive" via `ptr != 0` proxy checks. The April 2026 sprint
## closed iomap / completion_map / task_locals slots, but priority queues
## (slots 20, 24, 28) and priority table (slot 32) and task_registry were
## NEVER freed at all, plus several slots (0, 1, 6, 7, 17, @__qz_timer_peers,
## @__qz_pidfd_set) were freed-without-zeroed.
##
## B2 fix (Apr 14, 2026 Batch A+B sprint):
## 1. Added `@__qz_sched_state` atomic state word (UNINIT=0, RUNNING=1,
##    STOPPING=2, STOPPED=3) as the single source of truth for scheduler
##    lifecycle. Transitions are atomic seq_cst stores.
## 2. Rewrote `sched_is_active()` intrinsic to read this word instead of
##    the `completion_map[3] != 0` pointer proxy. Matches Go runtime's
##    scheduler state machine, Tokio's worker State atomic, libuv's
##    loop_alive predicate.
## 3. Added zero-after-free for slots 0, 1, 6, 7, 17, @__qz_timer_peers,
##    @__qz_pidfd_set.
## 4. Added the missing `free()` calls for priority queues (slots 20, 24,
##    28), priority table (slot 32), task_registry. Previously leaked
##    ~4.5 MB per shutdown cycle (3×524 KB pq + 524 KB ptbl + 2 MB registry).
##
## Contract:
##   1. sched_is_active() returns 0 before scheduler is initialized.
##   2. After sched_init(0), sched_is_active() returns 1.
##   3. After sched_shutdown(), sched_is_active() returns 0.
##   4. Double-shutdown is a no-op (second call sees UNINIT → skips).
##   5. Re-init after shutdown works — state returns to RUNNING cleanly.
##   6. Double-init is idempotent (second call sees RUNNING → skips).
##
## Note: the `spawn` keyword uses the legacy pthread path and does NOT
## trigger the M:N scheduler. These tests use `sched_init` / `sched_shutdown`
## directly to exercise the state machine. The M:N scheduler is activated
## by explicit `sched_init` or by go-task / async-aware primitives.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("scheduler lifecycle state machine") do ->

    it("sched_is_active returns 0 before sched_init") do ->
      assert_run_exits("""
        def main(): Int
          return 0 if sched_is_active() == 0
          return 1
        end
        """, 0)
    end

    it("sched_is_active returns 1 after sched_init") do ->
      assert_run_exits("""
        def main(): Int
          sched_init(0)
          var r = sched_is_active()
          sched_shutdown()
          return 0 if r == 1
          return 1
        end
        """, 0)
    end

    it("sched_is_active returns 0 after sched_shutdown") do ->
      assert_run_exits("""
        def main(): Int
          sched_init(0)
          sched_shutdown()
          return 0 if sched_is_active() == 0
          return 1
        end
        """, 0)
    end

    it("double sched_shutdown is a no-op (no crash, no hang)") do ->
      assert_run_exits("""
        def main(): Int
          sched_init(0)
          sched_shutdown()
          sched_shutdown()
          return 0 if sched_is_active() == 0
          return 1
        end
        """, 0)
    end

    it("shutdown without init is a no-op") do ->
      assert_run_exits("""
        def main(): Int
          sched_shutdown()
          return 0 if sched_is_active() == 0
          return 1
        end
        """, 0)
    end

    it("re-init after shutdown works — state machine cycles cleanly") do ->
      assert_run_exits("""
        def main(): Int
          sched_init(0)
          var r1 = sched_is_active()
          sched_shutdown()
          var r2 = sched_is_active()
          sched_init(0)
          var r3 = sched_is_active()
          sched_shutdown()
          var r4 = sched_is_active()
          return 0 if r1 == 1 and r2 == 0 and r3 == 1 and r4 == 0
          return 1
        end
        """, 0)
    end

    it("double sched_init is idempotent (second call sees RUNNING)") do ->
      assert_run_exits("""
        def main(): Int
          sched_init(0)
          sched_init(0)
          var r = sched_is_active()
          sched_shutdown()
          return 0 if r == 1
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
