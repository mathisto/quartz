## API Unification Tests
##
## Contract:
##   1. Vec sort: `v.sort()` sorts in place.
##   2. Vec sort_by: `v.sort_by(cmp)` sorts with comparator.
##   3. Set contains: `s.contains(x)` works as alias.
##   4. Set remove: `s.remove(x)` works as alias.
##   5. Map size: `m.size()` returns element count.
##   6. Map contains: `m.contains(k)` checks key.
##   7. Deprecated: `map_delete` still works.
##   8. Map get: `m.get(k)` returns value.
##   9. Set add+size: set tracks size correctly.

import * from qspec

def au_sort(): Int
  var v = vec_new()
  v.push(3)
  v.push(1)
  v.push(2)
  v.sort()
  return v[0] * 100 + v[1] * 10 + v[2]
end

def au_cmp(a: Int, b: Int): Int = b - a

def au_sort_by(): Int
  var v = vec_new()
  v.push(1)
  v.push(3)
  v.push(2)
  v.sort_by(au_cmp)
  return v[0] * 9 + v[1] * 3 + v[2]
end

def au_set_has(): Int
  var s = set_new()
  set_add(s, 42)
  if s.has(42)
    return 1
  end
  return 0
end

def au_set_delete(): Int
  var s = set_new()
  set_add(s, 10)
  s.delete(10)
  return s.size()
end

def au_hm_size(): Int
  var m = map_new()
  m.set("a", 1)
  m.set("b", 2)
  m.set("c", 3)
  return m.size()
end

def au_hm_contains(): Int
  var m = map_new()
  m.set("x", 99)
  if m.contains("x")
    return 1
  end
  return 0
end

def au_hm_del(): Int
  var m = map_new()
  m.set("a", 42)
  m.delete("a")
  return m.size()
end

def main(): Int
  describe("Vec UFCS methods") do ->
    it("v.sort() sorts in place") do ->
      assert_eq(au_sort(), 123)
    end

    it("v.sort_by(cmp) sorts with comparator") do ->
      assert_eq(au_sort_by(), 34)
    end
  end

  describe("Set UFCS methods") do ->
    it("s.has(x) checks membership") do ->
      assert_eq(au_set_has(), 1)
    end

    it("s.delete(x) removes element") do ->
      assert_eq(au_set_delete(), 0)
    end
  end

  describe("Map UFCS additions") do ->
    it("m.size() returns element count") do ->
      assert_eq(au_hm_size(), 3)
    end

    it("m.contains(k) checks key presence") do ->
      assert_eq(au_hm_contains(), 1)
    end
  end

  describe("deprecated aliases still work") do ->
    it("map_delete still works") do ->
      assert_eq(au_hm_del(), 0)
    end
  end

  describe("additional UFCS coverage") do ->
    it("m.get(k) retrieves stored value") do ->
      var m = map_new()
      m.set("key", 42)
      match m.get("key")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("set tracks size after adds") do ->
      var s = set_new()
      set_add(s, 1)
      set_add(s, 2)
      set_add(s, 3)
      assert_eq(s.size(), 3)
    end
  end

  return qspec_main()
end
