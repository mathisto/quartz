## std/tui/widgets/toast behaviour tests.
##
## Coverage:
##   - Constructor defaults (ttl 2500, bottom-right, auto_color on)
##   - Builders (with_ttl, with_position, with_styles, with_auto_color)
##   - Level → colour mapping (toast_level_color)
##   - View contains message; auto_color emits SGR for non-Info levels
##   - View with auto_color off uses styles.body
##   - Multi-line message preserves line count
##   - Overlay has non-zero dimensions
##   - show_cmd returns Cmd::After with the toast's ttl

import * from qspec
import std/tui/runtime as tui
import std/tui/widgets/toast as tt
import std/tui/widgets/overlay as ov
import style

enum TTMsg
  Noop
end

# ============================================================
# Constructors / builders
# ============================================================

def test_new_defaults(): Void
  var t = tt::toast_new("hello", tt::ToastLevel::Info)
  assert_eq_str(t.message, "hello")
  assert_eq(t.ttl_ms, 2500)
  assert_eq(t.position, ov::POS_BOTTOM_RIGHT())
  if t.auto_color
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_with_ttl_overrides(): Void
  var t = tt::toast_with_ttl(tt::toast_new("x", tt::ToastLevel::Info), 800)
  assert_eq(t.ttl_ms, 800)
end

def test_with_position_overrides(): Void
  var t = tt::toast_with_position(tt::toast_new("x", tt::ToastLevel::Info), ov::POS_CENTER())
  assert_eq(t.position, ov::POS_CENTER())
end

def test_with_styles_replaces(): Void
  var custom = tt::ToastStyles { body: Style.new().italic() }
  var t = tt::toast_with_styles(tt::toast_new("x", tt::ToastLevel::Info), custom)
  # auto_color stays unchanged after with_styles
  if t.auto_color
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_with_auto_color_off(): Void
  var t = tt::toast_with_auto_color(tt::toast_new("x", tt::ToastLevel::Info), false)
  if t.auto_color
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

# ============================================================
# Level → colour
# ============================================================

def test_level_color_info_is_none(): Void
  assert_eq(tt::toast_level_color(tt::ToastLevel::Info), style::COLOR_NONE())
end

def test_level_color_success_is_green(): Void
  assert_eq(tt::toast_level_color(tt::ToastLevel::Success), style::Green())
end

def test_level_color_warning_is_yellow(): Void
  assert_eq(tt::toast_level_color(tt::ToastLevel::Warning), style::Yellow())
end

def test_level_color_error_is_red(): Void
  assert_eq(tt::toast_level_color(tt::ToastLevel::Error), style::Red())
end

# ============================================================
# View
# ============================================================

def test_view_contains_message_text(): Void
  # Non-TTY context strips SGR escapes (Style.render uses
  # term_color_depth which returns 0 when stdout is not a TTY).
  # We assert text shape only — colour behaviour is covered by
  # toast_level_color() and the auto_color flag tests.
  var t = tt::toast_new("Played Defend", tt::ToastLevel::Success)
  var v = tt::toast_view(t)
  if str_contains(v, "Played Defend")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_view_short_message_single_line(): Void
  # Short message (no \n) renders as: leading space + icon + space +
  # message + trailing space. Info level icon is ℹ. Non-TTY context
  # strips SGR escapes so the output is plain text.
  var t = tt::toast_new("hi", tt::ToastLevel::Info)
  assert_eq_str(tt::toast_view(t), " ℹ hi ")
end

def test_view_multiline_indents_continuation_lines(): Void
  # Line 0 has the icon prefix; subsequent lines indent by three
  # spaces so the message text aligns with line 0's body content
  # (space + icon + space).
  var t = tt::toast_new("line1\nline2", tt::ToastLevel::Info)
  var v = tt::toast_view(t)
  assert_eq_str(v, " ℹ line1 \n   line2 ")
end

def test_view_uses_level_icon(): Void
  # Success → ✓, Warning → ⚠, Error → ✗.
  var ts = tt::toast_new("done", tt::ToastLevel::Success)
  if str_contains(tt::toast_view(ts), "✓")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  var tw = tt::toast_new("careful", tt::ToastLevel::Warning)
  if str_contains(tt::toast_view(tw), "⚠")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  var te = tt::toast_new("nope", tt::ToastLevel::Error)
  if str_contains(tt::toast_view(te), "✗")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Overlay + Cmd
# ============================================================

def test_overlay_has_nonzero_dimensions(): Void
  var t = tt::toast_new("hi", tt::ToastLevel::Info)
  var o = tt::toast_overlay(t)
  if o.width > 0 and o.height > 0
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_overlay_uses_toast_position(): Void
  var t0 = tt::toast_new("hi", tt::ToastLevel::Info)
  var t = tt::toast_with_position(t0, ov::POS_CENTER())
  var o = tt::toast_overlay(t)
  assert_eq(o.position, ov::POS_CENTER())
end

def expire_thunk(): tui::FrameMsg<TTMsg>
  return tui::FrameMsg::App(TTMsg::Noop)
end

def test_show_cmd_is_after_with_toast_ttl(): Void
  var t = tt::toast_with_ttl(tt::toast_new("x", tt::ToastLevel::Info), 1500)
  var cmd: tui::Cmd<TTMsg> = tt::toast_show_cmd<TTMsg>(t, expire_thunk)
  match cmd
    tui::Cmd::After(ms, _) =>
      assert_eq(ms, 1500)
    _ =>
      assert_eq(0, 1)
  end
end

def main(): Int
  describe("constructors and builders") do ->
    it("new() defaults to ttl 2500, bottom-right, auto_color on") do ->
      test_new_defaults()
    end
    it("with_ttl overrides ttl_ms") do ->
      test_with_ttl_overrides()
    end
    it("with_position overrides position") do ->
      test_with_position_overrides()
    end
    it("with_styles preserves auto_color flag") do ->
      test_with_styles_replaces()
    end
    it("with_auto_color(false) flips the flag") do ->
      test_with_auto_color_off()
    end
  end

  describe("level to colour mapping") do ->
    it("Info maps to COLOR_NONE") do ->
      test_level_color_info_is_none()
    end
    it("Success maps to green") do ->
      test_level_color_success_is_green()
    end
    it("Warning maps to yellow") do ->
      test_level_color_warning_is_yellow()
    end
    it("Error maps to red") do ->
      test_level_color_error_is_red()
    end
  end

  describe("view") do ->
    it("contains the message text") do ->
      test_view_contains_message_text()
    end
    it("short message renders with icon prefix on a single padded line") do ->
      test_view_short_message_single_line()
    end
    it("multi-line message indents continuation lines under message column") do ->
      test_view_multiline_indents_continuation_lines()
    end
    it("view embeds level-derived icon") do ->
      test_view_uses_level_icon()
    end
  end

  describe("overlay and Cmd") do ->
    it("overlay has non-zero width and height") do ->
      test_overlay_has_nonzero_dimensions()
    end
    it("overlay uses the toast's position") do ->
      test_overlay_uses_toast_position()
    end
    it("show_cmd returns Cmd::After with toast's ttl") do ->
      test_show_cmd_is_after_with_toast_ttl()
    end
  end

  return qspec_main()
end
