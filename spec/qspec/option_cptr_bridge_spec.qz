## B.15b — the CPtr ⇆ Option<CPtr> FFI bridge (std/ffi/ptr).
import * from qspec
import * from ffi/ptr

def main(): Int
  describe("cptr <-> Option bridge") do ->
    it("cptr_to_option: NULL -> None") do ->
      assert_eq(cptr_to_option(int_to_cptr(0)).is_none(), true)
    end

    it("cptr_to_option: non-null -> Some") do ->
      assert_eq(cptr_to_option(int_to_cptr(42)).is_some(), true)
    end

    it("cptr_to_option: Some holds the pointer") do ->
      p = cptr_to_option(int_to_cptr(42)).unwrap()
      assert_eq(cptr_to_int(p), 42)
    end

    it("cptr_from_option: None -> NULL") do ->
      var n: Option<CPtr> = Option::None
      assert_eq(cptr_to_int(cptr_from_option(n)), 0)
    end

    it("cptr_from_option: Some(p) -> p") do ->
      back = cptr_from_option(cptr_to_option(int_to_cptr(7)))
      assert_eq(cptr_to_int(back), 7)
    end

    it("round-trips a non-null pointer CPtr -> Option -> CPtr") do ->
      orig = int_to_cptr(123)
      back = cptr_from_option(cptr_to_option(orig))
      assert_eq(cptr_to_int(back), 123)
    end
  end

  return qspec_main()
end
