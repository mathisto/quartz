## R1.2 (PF1) — GC-firewall exclusion for the F4 value-DEFAULT flip.
##
## The F4 flip is LIVE (`mir_default_struct_value_live()` == 1): a PLAIN struct
## (no `@value` annotation) is value-layout by DEFAULT when it is eligible. The
## GC-firewall invariant this spec locks in: a plain struct that mixes raw-bit
## SCALAR slots (Int/Bool/narrow ints/floats) with tracked-POINTER slots
## (String, Vec, ... heap) must STAY BOXED (reference layout) — it must NOT flip
## to value-layout. A value-layout struct is copied/decomposed by value; if it
## embedded a String while flipped, by-value copies would break the String's
## refcount (double-free / dangling / corruption).
##
## Enforced by `mir_struct_fields_mixed_firewall` (self-hosted/backend/mir.qz),
## consulted by `mir_default_struct_value_eligible` / its prog-side twin
## `mir_prog_struct_value_eligible`. These specs assert BEHAVIORAL correctness:
## the String field survives intact across Vec-store + by-value extract + copy —
## a value-flip miscompile of a mixed struct would corrupt/crash here.
##
## Unlike value_struct_gc_firewall_spec.qz (which annotates `@value`), these
## structs are PLAIN — exercising the default-flip path that only became live
## at the F4 flip. Control cases confirm value-layout still works for the eligible
## (pure-scalar / all-pointer) structs.

import * from qspec
import * from qspec/subprocess

# firewall.a — PLAIN mixed scalar+pointer (Int + String), stored in a Vec, each
# element copied out by value; the String field must survive all three copies.
var _MIXED_VEC: String = """struct Mixed
  n: Int
  s: String
end

def main(): Int
  var v = vec_new<Mixed>()
  v.push(Mixed { n: 1, s: \"hello\" })
  v.push(Mixed { n: 2, s: \"world\" })
  v.push(Mixed { n: 3, s: \"firewall\" })
  var m0 = v[0]
  var m1 = v[1]
  var m2 = v[2]
  # Alias-copy m1 then confirm BOTH copies keep the String intact (a by-value
  # decompose of a mixed struct would corrupt one of them).
  var alias = m1
  puts(m0.s + \",\" + str_from_int(m0.n))
  puts(m1.s + \",\" + str_from_int(m1.n))
  puts(m2.s + \",\" + str_from_int(m2.n))
  puts(alias.s + \",\" + str_from_int(alias.n))
  return 0
end
"""

# firewall.b — PLAIN struct embedding a reference-layout (String-bearing) struct.
# The OUTER struct mixes an Int scalar with a pointer-bearing inner ⇒ must box.
var _NESTED_REF: String = """struct Inner
  label: String
end

struct Outer
  tag: Int
  inner: Inner
end

def main(): Int
  var o = Outer { tag: 99, inner: Inner { label: \"deep\" } }
  var copy = o
  puts(str_from_int(copy.tag) + \",\" + copy.inner.label)
  puts(str_from_int(o.tag) + \",\" + o.inner.label)
  return 0
end
"""

# control.c — PURE-value struct (Int+Int+Int, >16B). MUST flip to value-layout
# and still round-trip correctly across a copy.
var _PURE_VALUE: String = """struct PureVal
  a: Int
  b: Int
  c: Int
end

def main(): Int
  var v = vec_new<PureVal>()
  v.push(PureVal { a: 10, b: 20, c: 30 })
  v.push(PureVal { a: 40, b: 50, c: 60 })
  var p = v[1]
  var pc = p
  puts(str_from_int(p.a + p.b + p.c))
  puts(str_from_int(pc.a + pc.b + pc.c))
  return 0
end
"""

# control.d — all-POINTER plain struct (String + String). Homogeneous ⇒ NOT
# firewall-mixed ⇒ eligible for value-layout; the bit-copied String handles stay
# shared (refcount-safe), so both fields survive a copy.
var _ALL_PTR: String = """struct AllPtr
  first: String
  second: String
end

def main(): Int
  var ap = AllPtr { first: \"left\", second: \"right\" }
  var apc = ap
  puts(apc.first + \"-\" + apc.second)
  puts(ap.first + \"-\" + ap.second)
  return 0
end
"""

def main(): Int
  describe("R1.2 GC firewall — plain mixed scalar+pointer structs stay BOXED under the F4 value-default flip") do ->
    it("PLAIN Mixed{Int,String} in a Vec: String survives store + by-value extract + copy") do ->
      assert_run_stdout_eq(_MIXED_VEC, "hello,1\nworld,2\nfirewall,3\nworld,2\n")
    end

    it("PLAIN Outer{Int, Inner{String}} embedding a reference struct: nested String survives copy") do ->
      assert_run_stdout_eq(_NESTED_REF, "99,deep\n99,deep\n")
    end

    it("control: PURE-value PureVal{Int,Int,Int} flips to value-layout and round-trips") do ->
      assert_run_stdout_eq(_PURE_VALUE, "150\n150\n")
    end

    it("control: all-pointer AllPtr{String,String} value-layout, both Strings survive copy") do ->
      assert_run_stdout_eq(_ALL_PTR, "left-right\nleft-right\n")
    end
  end
  return qspec_main()
end
