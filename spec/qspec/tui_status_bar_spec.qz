## std/tui/widgets/status_bar behaviour tests.
##
## Coverage:
##   - Position constants are distinct
##   - Segment constructors set align correctly
##   - status_segment_with_style replaces only the style slot
##   - Status bar constructor / builders
##   - View padding, overflow truncation, empty-bar fill
##   - Three-segment layout: lefts pack at column 0, rights pack at
##     the right edge, centers center between them
##   - Multi-segment same-alignment groups separate by a single space
##   - Styled segments (auto-color) embed SGR escapes inside the line
##   - Striping segments via strip_styles recovers the plain layout

import * from qspec
import std/tui/widgets/status_bar as sb
import std/tui/layout as ly
import style

# ============================================================
# Position constants
# ============================================================

def test_pos_top_and_bottom_distinct(): Void
  if sb::POS_TOP() != sb::POS_BOTTOM()
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# StatusSegment constructors
# ============================================================

def test_segment_left_align(): Void
  var s = sb::status_segment_left("hello")
  assert_eq(s.align, ly::ALIGN_LEFT())
  assert_eq_str(s.content, "hello")
end

def test_segment_center_align(): Void
  var s = sb::status_segment_center("middle")
  assert_eq(s.align, ly::ALIGN_CENTER())
end

def test_segment_right_align(): Void
  var s = sb::status_segment_right("end")
  assert_eq(s.align, ly::ALIGN_RIGHT())
end

def test_segment_with_style_replaces_only_style(): Void
  var s0 = sb::status_segment_left("hi")
  var s = sb::status_segment_with_style(s0, Style.new().bold())
  assert_eq_str(s.content, "hi")
  assert_eq(s.align, ly::ALIGN_LEFT())
end

# ============================================================
# StatusBar constructor / builders
# ============================================================

def test_new_starts_empty_at_top(): Void
  var b = sb::status_bar_new()
  assert_eq(b.segments.size, 0)
  assert_eq(b.position, sb::POS_TOP())
end

def test_with_segments_replaces_list(): Void
  var segs = vec_new<sb::StatusSegment>()
  vec_push(segs, sb::status_segment_left("A"))
  vec_push(segs, sb::status_segment_right("B"))
  var b = sb::status_bar_with_segments(sb::status_bar_new(), segs)
  assert_eq(b.segments.size, 2)
end

def test_with_position_overrides(): Void
  var b = sb::status_bar_with_position(sb::status_bar_new(), sb::POS_BOTTOM())
  assert_eq(b.position, sb::POS_BOTTOM())
end

def test_with_styles_replaces_styles(): Void
  var custom = sb::StatusBarStyles { body: Style.new().italic() }
  var b = sb::status_bar_with_styles(sb::status_bar_new(), custom)
  # styles slot gets replaced — we don't peek into Style internals
  # here, the layout view tests cover the visible side.
  assert_eq(b.segments.size, 0)
end

def test_append_grows_segment_list(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("x"))
  b = sb::status_bar_append(b, sb::status_segment_right("y"))
  assert_eq(b.segments.size, 2)
end

# ============================================================
# View — empty / zero-width
# ============================================================

def test_view_empty_bar_pads_to_width(): Void
  var line = sb::status_bar_view(sb::status_bar_new(), 10)
  assert_eq_str(line, "          ")
end

def test_view_zero_width_returns_empty(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("hi"))
  assert_eq_str(sb::status_bar_view(b, 0), "")
end

# ============================================================
# View — single-alignment layouts
# ============================================================

def test_view_left_only_pads_with_trailing_spaces(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("hi"))
  # Plain Style render in non-TTY is the raw string — matches
  # toast_view's spec convention. visible_width 2 + 8 trailing.
  assert_eq_str(sb::status_bar_view(b, 10), "hi        ")
end

def test_view_right_only_pads_with_leading_spaces(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_right("hi"))
  assert_eq_str(sb::status_bar_view(b, 10), "        hi")
end

def test_view_center_only_centers_within_width(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_center("hi"))
  # ideal_start = (10 - 2) / 2 = 4 → 4 leading, 4 trailing.
  assert_eq_str(sb::status_bar_view(b, 10), "    hi    ")
end

# ============================================================
# View — multi-segment same alignment
# ============================================================

def test_view_two_left_segments_separated_by_one_space(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("AA"))
  b = sb::status_bar_append(b, sb::status_segment_left("BB"))
  # "AA BB" is 5 cells; pad to 10 = 5 trailing.
  assert_eq_str(sb::status_bar_view(b, 10), "AA BB     ")
end

def test_view_two_right_segments_separated_by_one_space(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_right("AA"))
  b = sb::status_bar_append(b, sb::status_segment_right("BB"))
  # "AA BB" is 5 cells; pad to 10 = 5 leading.
  assert_eq_str(sb::status_bar_view(b, 10), "     AA BB")
end

# ============================================================
# View — three-pane layout
# ============================================================

def test_view_left_center_right_lays_out_correctly(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("L"))
  b = sb::status_bar_append(b, sb::status_segment_center("C"))
  b = sb::status_bar_append(b, sb::status_segment_right("R"))
  # TW=11, lw=1, cw=1, rw=1.
  # ideal_start = (11 - 1) / 2 = 5. lpad = 5 - 1 = 4.
  # rpad = 11 - 1 - 4 - 1 - 1 = 4.
  # Result: "L" + 4*" " + "C" + 4*" " + "R" = "L    C    R"
  assert_eq_str(sb::status_bar_view(b, 11), "L    C    R")
end

def test_view_left_right_no_center_filler_between(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("L"))
  b = sb::status_bar_append(b, sb::status_segment_right("R"))
  # TW=10, lw=1, rw=1, filler = 10 - 1 - 1 = 8.
  assert_eq_str(sb::status_bar_view(b, 10), "L        R")
end

# ============================================================
# View — overflow truncation
# ============================================================

def test_view_truncates_when_content_exceeds_width(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("0123456789"))
  # 10-cell content into 5 cells → first 5 cells.
  assert_eq_str(sb::status_bar_view(b, 5), "01234")
end

def test_view_three_pane_overflow_keeps_lefts_drops_rights(): Void
  var b = sb::status_bar_append(sb::status_bar_new(),
                                sb::status_segment_left("AAAAAA"))
  b = sb::status_bar_append(b, sb::status_segment_center("BBBBBB"))
  b = sb::status_bar_append(b, sb::status_segment_right("CCCCCC"))
  var line = sb::status_bar_view(b, 8)
  # Lefts at column 0; truncate cuts the rest. We assert prefix
  # rather than exact shape — squeezed layout depends on the centring
  # math, but lefts always start at col 0.
  if str_byte_len(line) <= 8 and str_starts_with(line, "AAAAAA")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# View — styled content
# ============================================================

def test_view_strip_styles_recovers_plain_layout(): Void
  # Apply a non-trivial Style to one segment; Style.render in non-TTY
  # context is a no-op (term_color_depth == 0), so the visible bytes
  # are identical to the plain case. We assert that strip_styles is
  # an idempotent no-op on this output — a regression here would
  # signal that render started producing escapes in non-TTY mode,
  # which would be a surprise to every other widget too.
  var muted: Style = Style.muted()
  var b = sb::status_bar_append(sb::status_bar_new(),
            sb::status_segment_with_style(
              sb::status_segment_left("HELLO"), muted))
  var line = sb::status_bar_view(b, 10)
  assert_eq_str(ly::strip_styles(line), line)
end

# ============================================================
# View — deckbuilder header shape (canonical consumer)
# ============================================================

def test_view_deckbuilder_header_shape(): Void
  # Mirrors the deckbuilder migration — three muted segments
  # arranged left/center/right within a 60-cell inner width.
  var muted: Style = Style.muted()
  var b = sb::status_bar_append(sb::status_bar_new(),
            sb::status_segment_with_style(
              sb::status_segment_left("Combat — Turn 1"), muted))
  b = sb::status_bar_append(b,
            sb::status_segment_with_style(
              sb::status_segment_center("Fights won: 0"), muted))
  b = sb::status_bar_append(b,
            sb::status_segment_with_style(
              sb::status_segment_right("[?] help"), muted))
  var line = sb::status_bar_view(b, 60)
  # Plain content visible_width totals: 16 + 13 + 8 = 37, plus we
  # added a single non-styled assertion that the rendered byte
  # length covers the whole 60 cells (or less, given multi-byte
  # UTF-8 in "—"). Strip styles, then check the visible length
  # matches the requested width.
  var plain = ly::strip_styles(line)
  if ly::visible_width(plain) == 60
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  # Lefts pack at col 0; centers center; rights pack at the right.
  if str_starts_with(plain, "Combat — Turn 1")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if str_ends_with(plain, "[?] help")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("position constants") do ->
    it("POS_TOP and POS_BOTTOM are distinct") do ->
      test_pos_top_and_bottom_distinct()
    end
  end

  describe("StatusSegment constructors") do ->
    it("status_segment_left sets ALIGN_LEFT") do ->
      test_segment_left_align()
    end
    it("status_segment_center sets ALIGN_CENTER") do ->
      test_segment_center_align()
    end
    it("status_segment_right sets ALIGN_RIGHT") do ->
      test_segment_right_align()
    end
    it("status_segment_with_style replaces only the style") do ->
      test_segment_with_style_replaces_only_style()
    end
  end

  describe("StatusBar constructor and builders") do ->
    it("status_bar_new starts empty at POS_TOP") do ->
      test_new_starts_empty_at_top()
    end
    it("with_segments replaces the list") do ->
      test_with_segments_replaces_list()
    end
    it("with_position overrides position") do ->
      test_with_position_overrides()
    end
    it("with_styles replaces styles") do ->
      test_with_styles_replaces_styles()
    end
    it("append grows the segment list") do ->
      test_append_grows_segment_list()
    end
  end

  describe("view — empty / zero-width") do ->
    it("empty bar pads to term_width with spaces") do ->
      test_view_empty_bar_pads_to_width()
    end
    it("zero term_width returns empty string") do ->
      test_view_zero_width_returns_empty()
    end
  end

  describe("view — single-alignment layouts") do ->
    it("left-only pads with trailing spaces") do ->
      test_view_left_only_pads_with_trailing_spaces()
    end
    it("right-only pads with leading spaces") do ->
      test_view_right_only_pads_with_leading_spaces()
    end
    it("center-only centers within width") do ->
      test_view_center_only_centers_within_width()
    end
  end

  describe("view — multi-segment same alignment") do ->
    it("two left segments separated by one space") do ->
      test_view_two_left_segments_separated_by_one_space()
    end
    it("two right segments separated by one space") do ->
      test_view_two_right_segments_separated_by_one_space()
    end
  end

  describe("view — three-pane layout") do ->
    it("left + center + right lay out with even fills") do ->
      test_view_left_center_right_lays_out_correctly()
    end
    it("left + right with no center share filler between") do ->
      test_view_left_right_no_center_filler_between()
    end
  end

  describe("view — overflow") do ->
    it("truncates content exceeding term_width") do ->
      test_view_truncates_when_content_exceeds_width()
    end
    it("three-pane overflow keeps lefts at column 0") do ->
      test_view_three_pane_overflow_keeps_lefts_drops_rights()
    end
  end

  describe("view — styled content") do ->
    it("strip_styles is a no-op on non-TTY render") do ->
      test_view_strip_styles_recovers_plain_layout()
    end
  end

  describe("view — canonical deckbuilder header") do ->
    it("three-muted-segment header lays out across 60 cells") do ->
      test_view_deckbuilder_header_shape()
    end
  end

  return qspec_main()
end
