## v0.3.2 Step 1 — FocusRing<Id> behavior tests
##
## Contract:
##   - focus_ring_new(empty) → current None
##   - focus_ring_new(non-empty) → current Some(0)
##   - focus_ring_with_initial(present) → current Some(idx)
##   - focus_ring_with_initial(absent) → current None
##   - focus_ring_current returns Some(id) or None
##   - focus_ring_next/prev wrap around
##   - focus_ring_next/prev on empty is no-op
##   - focus_ring_next/prev from None on non-empty focuses first
##   - focus_ring_set(present) moves focus
##   - focus_ring_set(absent) is no-op
##   - focus_ring_clear sets current None
##   - focus_ring_is_focused matches the focused id only

import * from qspec
import * from std/traits
import std/tui/widgets/focus as fr

# Unit-variant enum used as Id throughout the spec. Three variants cover
# wrap-around without being noisy.
enum F
  A
  B
  C
end

extend F with Eq
  def op_eq(self, other: Self): Bool
    match self
      A => return other is A
      B => return other is B
      C => return other is C
    end
  end
end

# Builders — the spec creates fresh rings inside each `it` so state
# doesn't leak between cases.

def make_ids_abc(): Vec<F>
  var ids = vec_new()
  vec_push(ids, F::A)
  vec_push(ids, F::B)
  vec_push(ids, F::C)
  return ids
end

def make_ids_a_only(): Vec<F>
  var ids = vec_new()
  vec_push(ids, F::A)
  return ids
end

def make_ids_empty(): Vec<F> = vec_new()

# Bool-coerce-to-Int helper for assert_eq — qspec's assert_eq is Int-only.
def _b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end

# ----- focus_ring_new -----

def test_new_empty_has_no_focus(): Void
  var r = fr::focus_ring_new(make_ids_empty())
  assert_eq(_b2i(r.current is None), 1)
end

def test_new_non_empty_focuses_first(): Void
  var r = fr::focus_ring_new(make_ids_abc())
  match fr::focus_ring_current(r)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)  # fail
  end
end

# ----- focus_ring_with_initial -----

def test_with_initial_present_focuses_that_id(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::B)
  match fr::focus_ring_current(r)
    Some(id) => assert_eq(_b2i(id == F::B), 1)
    None     => assert_eq(0, 1)
  end
end

def test_with_initial_absent_yields_none(): Void
  # Build a ring of A only, then ask for B (not in ring) — current is None.
  var r = fr::focus_ring_with_initial(make_ids_a_only(), F::B)
  assert_eq(_b2i(r.current is None), 1)
end

# ----- focus_ring_current -----

def test_current_none_when_cleared(): Void
  var r = fr::focus_ring_clear(fr::focus_ring_new(make_ids_abc()))
  assert_eq(_b2i(fr::focus_ring_current(r) is None), 1)
end

# ----- focus_ring_next -----

def test_next_advances_by_one(): Void
  var r = fr::focus_ring_next(fr::focus_ring_new(make_ids_abc()))
  match fr::focus_ring_current(r)
    Some(id) => assert_eq(_b2i(id == F::B), 1)
    None     => assert_eq(0, 1)
  end
end

def test_next_wraps_at_last(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::C)
  var wrapped = fr::focus_ring_next(r)
  match fr::focus_ring_current(wrapped)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

def test_next_on_empty_is_noop(): Void
  var r = fr::focus_ring_new(make_ids_empty())
  var n = fr::focus_ring_next(r)
  assert_eq(_b2i(n.current is None), 1)
  assert_eq(fr::focus_ring_size(n), 0)
end

def test_next_from_none_focuses_first(): Void
  var r = fr::focus_ring_clear(fr::focus_ring_new(make_ids_abc()))
  var n = fr::focus_ring_next(r)
  match fr::focus_ring_current(n)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

# ----- focus_ring_prev -----

def test_prev_moves_backward(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::B)
  var p = fr::focus_ring_prev(r)
  match fr::focus_ring_current(p)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

def test_prev_wraps_at_first(): Void
  var r = fr::focus_ring_new(make_ids_abc())  # focused on A
  var wrapped = fr::focus_ring_prev(r)
  match fr::focus_ring_current(wrapped)
    Some(id) => assert_eq(_b2i(id == F::C), 1)
    None     => assert_eq(0, 1)
  end
end

def test_prev_on_empty_is_noop(): Void
  var r = fr::focus_ring_new(make_ids_empty())
  var p = fr::focus_ring_prev(r)
  assert_eq(_b2i(p.current is None), 1)
end

# ----- focus_ring_set -----

def test_set_to_present_id_moves_focus(): Void
  var r = fr::focus_ring_new(make_ids_abc())
  var s = fr::focus_ring_set(r, F::C)
  match fr::focus_ring_current(s)
    Some(id) => assert_eq(_b2i(id == F::C), 1)
    None     => assert_eq(0, 1)
  end
end

def test_set_to_absent_id_is_noop(): Void
  # Ring of A only; setting to B should leave A focused.
  var r = fr::focus_ring_new(make_ids_a_only())
  var s = fr::focus_ring_set(r, F::B)
  match fr::focus_ring_current(s)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

# ----- focus_ring_clear -----

def test_clear_yields_no_focus(): Void
  var r = fr::focus_ring_clear(fr::focus_ring_new(make_ids_abc()))
  assert_eq(_b2i(fr::focus_ring_current(r) is None), 1)
end

# ----- focus_ring_is_focused -----

def test_is_focused_returns_true_for_focused_id(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::B)
  assert_eq(_b2i(fr::focus_ring_is_focused(r, F::B)), 1)
end

def test_is_focused_returns_false_for_other_id(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::B)
  assert_eq(_b2i(fr::focus_ring_is_focused(r, F::A)), 0)
end

def test_is_focused_returns_false_when_no_focus(): Void
  var r = fr::focus_ring_clear(fr::focus_ring_new(make_ids_abc()))
  assert_eq(_b2i(fr::focus_ring_is_focused(r, F::A)), 0)
end

# ----- focus_ring_size -----

def test_size_returns_id_count(): Void
  var r = fr::focus_ring_new(make_ids_abc())
  assert_eq(fr::focus_ring_size(r), 3)
end

def test_size_zero_for_empty(): Void
  var r = fr::focus_ring_new(make_ids_empty())
  assert_eq(fr::focus_ring_size(r), 0)
end

# ----- single-element edge cases -----

def test_single_element_next_stays(): Void
  var r = fr::focus_ring_new(make_ids_a_only())
  var n = fr::focus_ring_next(r)
  match fr::focus_ring_current(n)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

def test_single_element_prev_stays(): Void
  var r = fr::focus_ring_new(make_ids_a_only())
  var p = fr::focus_ring_prev(r)
  match fr::focus_ring_current(p)
    Some(id) => assert_eq(_b2i(id == F::A), 1)
    None     => assert_eq(0, 1)
  end
end

# ----- next-prev round trip -----

def test_next_then_prev_returns_to_original(): Void
  var r = fr::focus_ring_with_initial(make_ids_abc(), F::B)
  var rt = fr::focus_ring_prev(fr::focus_ring_next(r))
  match fr::focus_ring_current(rt)
    Some(id) => assert_eq(_b2i(id == F::B), 1)
    None     => assert_eq(0, 1)
  end
end

def main(): Int
  describe("focus_ring_new") do ->
    it("empty Vec yields no focus") do ->
      test_new_empty_has_no_focus()
    end
    it("non-empty Vec focuses first id") do ->
      test_new_non_empty_focuses_first()
    end
  end

  describe("focus_ring_with_initial") do ->
    it("focuses the named id when present") do ->
      test_with_initial_present_focuses_that_id()
    end
    it("falls back to None when id not in ring") do ->
      test_with_initial_absent_yields_none()
    end
  end

  describe("focus_ring_current") do ->
    it("returns None after clear") do ->
      test_current_none_when_cleared()
    end
  end

  describe("focus_ring_next") do ->
    it("advances by one") do ->
      test_next_advances_by_one()
    end
    it("wraps at last back to first") do ->
      test_next_wraps_at_last()
    end
    it("is no-op on empty ring") do ->
      test_next_on_empty_is_noop()
    end
    it("focuses first when current is None") do ->
      test_next_from_none_focuses_first()
    end
  end

  describe("focus_ring_prev") do ->
    it("moves backward by one") do ->
      test_prev_moves_backward()
    end
    it("wraps at first back to last") do ->
      test_prev_wraps_at_first()
    end
    it("is no-op on empty ring") do ->
      test_prev_on_empty_is_noop()
    end
  end

  describe("focus_ring_set") do ->
    it("moves focus to a present id") do ->
      test_set_to_present_id_moves_focus()
    end
    it("is no-op when id is absent") do ->
      test_set_to_absent_id_is_noop()
    end
  end

  describe("focus_ring_clear") do ->
    it("yields no-focus state") do ->
      test_clear_yields_no_focus()
    end
  end

  describe("focus_ring_is_focused") do ->
    it("returns true for the focused id") do ->
      test_is_focused_returns_true_for_focused_id()
    end
    it("returns false for a different id") do ->
      test_is_focused_returns_false_for_other_id()
    end
    it("returns false when no widget is focused") do ->
      test_is_focused_returns_false_when_no_focus()
    end
  end

  describe("focus_ring_size") do ->
    it("returns the id count") do ->
      test_size_returns_id_count()
    end
    it("returns 0 for an empty ring") do ->
      test_size_zero_for_empty()
    end
  end

  describe("single-element ring") do ->
    it("next stays on the same id") do ->
      test_single_element_next_stays()
    end
    it("prev stays on the same id") do ->
      test_single_element_prev_stays()
    end
  end

  describe("round-trip") do ->
    it("next then prev returns to the original id") do ->
      test_next_then_prev_returns_to_original()
    end
  end

  return qspec_main()
end
