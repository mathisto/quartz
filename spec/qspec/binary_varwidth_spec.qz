## Binary DSL — Phase 1.5 STEP 1: variable-width fields.
##
## Covers: bytes(n) fixed, bytes rest-of-stream, cstring,
## pstring(u8|u16le|u32le). Arrays ([T;n], [T;field], [T]) are
## deferred to STEP 1 follow-up in the handoff.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — variable-width fields (STEP 1)") do ->

    it("bytes(n) fixed-length blob round-trips") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type MacFrame = binary {
          dst: bytes(6)
          src: bytes(6)
          et:  u16be
        }
        def main(): Int
          var d = Bytes { _data: vec_new() }
          var s = Bytes { _data: vec_new() }
          var i = 0
          while i < 6
            d.push(0xaa)
            s.push(0xbb)
            i = i + 1
          end
          var h = MacFrame { dst: d, src: s, et: 0x0800 }
          var b = h.encode()
          return 90 if b.size() != 14
          return 91 if b.get(0) != 0xaa
          return 92 if b.get(5) != 0xaa
          return 93 if b.get(6) != 0xbb
          return 94 if b.get(11) != 0xbb
          return 95 if b.get(12) != 0x08
          return 96 if b.get(13) != 0x00
          match MacFrame.decode(b)
            Ok(h2) => {
              return 1 if h2.dst.size() != 6
              return 2 if h2.dst.get(0) != 0xaa
              return 3 if h2.src.size() != 6
              return 4 if h2.src.get(0) != 0xbb
              return 5 if h2.et != 0x0800
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("bytes rest-of-stream round-trips") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Packet = binary {
          hdr:     u16be
          payload: bytes
        }
        def main(): Int
          var p = Bytes { _data: vec_new() }
          p.push(0x11)
          p.push(0x22)
          p.push(0x33)
          p.push(0x44)
          var h = Packet { hdr: 0xcafe, payload: p }
          var b = h.encode()
          return 90 if b.size() != 6
          return 91 if b.get(0) != 0xca
          return 92 if b.get(1) != 0xfe
          return 93 if b.get(2) != 0x11
          return 94 if b.get(5) != 0x44
          match Packet.decode(b)
            Ok(h2) => {
              return 1 if h2.hdr != 0xcafe
              return 2 if h2.payload.size() != 4
              return 3 if h2.payload.get(0) != 0x11
              return 4 if h2.payload.get(3) != 0x44
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("cstring round-trips with NUL terminator") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Named = binary {
          kind: u8
          name: cstring
        }
        def main(): Int
          var h = Named { kind: 7, name: "hi" }
          var b = h.encode()
          return 90 if b.size() != 4
          return 91 if b.get(0) != 7
          return 92 if b.get(1) != 104
          return 93 if b.get(2) != 105
          return 94 if b.get(3) != 0
          match Named.decode(b)
            Ok(h2) => {
              return 1 if h2.kind != 7
              return 2 if str_byte_len(h2.name) != 2
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("pstring(u8) round-trips with single-byte length prefix") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Greeting = binary {
          msg: pstring(u8)
        }
        def main(): Int
          var h = Greeting { msg: "hello" }
          var b = h.encode()
          return 90 if b.size() != 6
          return 91 if b.get(0) != 5
          return 92 if b.get(1) != 104
          return 93 if b.get(5) != 111
          match Greeting.decode(b)
            Ok(h2) => {
              return 1 if str_byte_len(h2.msg) != 5
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("pstring(u16le) round-trips with 16-bit LE length prefix") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Greeting16 = binary {
          msg: pstring(u16le)
        }
        def main(): Int
          var h = Greeting16 { msg: "abc" }
          var b = h.encode()
          return 90 if b.size() != 5
          return 91 if b.get(0) != 3
          return 92 if b.get(1) != 0
          return 93 if b.get(2) != 97
          return 94 if b.get(4) != 99
          match Greeting16.decode(b)
            Ok(h2) => {
              return 1 if str_byte_len(h2.msg) != 3
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

  end

  return qspec_main()
end
