## Chained `m.get(k).unwrap().field` on a niche-struct-valued Map (N3.2 follow-up #2).
##
## The VALUE-construction hole (#1) is fixed by map_option_value_niche_spec; this is
## the symmetric READ-INFERENCE hole. `m.get(k)` inferred bare "Option" (V erased),
## so the chained-unwrap niche binder couldn't thread V and `.field` fell through to
## the GLOBAL field-name→offset table. With a struct value type that shares a field
## name with another struct (here `a`), the global table resolves `.a` to the WRONG
## struct's offset → wrong value read (a CORRECTNESS bug, masked whenever the field
## name is unique because the global table happens to pick the only entry).
##
## The fix flips map_get's INFERENCE (→ Option<V>) and CONSTRUCTION (→ __map_get_raw
## raw-niche word) ATOMICALLY for niche-eligible V, so the chained unwrap reads the
## bare value word as the struct pointer and resolves `.field` against the concrete V.
## Representation-agnostic intent: under the niche layout map_get returns the raw word
## directly; the read identity-binds it.
import * from qspec

struct Other
  zzz: Int
  a: Int
end

struct SomeStruct
  a: Int
  b: Int
end

def main(): Int
  describe("chained m.get(k).unwrap().field on niche struct Map") do ->
    it("reads correct field offset (was Other.a offset — the bug)") do ->
      var m = map_new()
      m.set("k", SomeStruct { a: 22, b: 7 })
      var v = m.get("k").unwrap()
      assert_eq(v.a, 22)
      assert_eq(v.b, 7)
    end

    it("Other resolves its own .a") do ->
      var o = map_new()
      o.set("x", Other { zzz: 9, a: 5 })
      assert_eq(o.get("x").unwrap().a, 5)
    end

    it("non-niche Option<Int> map value round-trips (spill path stays correct)") do ->
      var mi: Map<String, Option<Int>> = map_new()
      mi.set("k", Option::Some(99))
      var inner: Option<Int> = mi.get("k").unwrap()
      assert_eq(inner.unwrap(), 99)
    end

    # R1.6: explicitly-typed `map_new<K, V>()` chained unwrap bound to a var.
    # The unwrap result's value type V (a struct) was lost when the receiver was
    # a CALL (`m.get(k)`) rather than a bound var — `unwrap`'s bare-`T` return fell
    # to Int and `.field` raised `QZ0301: Unknown struct: T`. Covers BOTH binding
    # forms: un-annotated (struct-name recovered from the call node's str2 stamp)
    # and explicitly annotated (struct-name from the binding annotation).
    it("typed map_new<K,V> chained unwrap — un-annotated binding resolves V") do ->
      var m = map_new<String, SomeStruct>()
      m.set("k", SomeStruct { a: 11, b: 33 })
      c = m.get("k").unwrap()
      assert_eq(c.a, 11)
      assert_eq(c.b, 33)
    end

    it("typed map_new<K,V> chained unwrap — annotated binding resolves V") do ->
      var m = map_new<String, SomeStruct>()
      m.set("k", SomeStruct { a: 44, b: 55 })
      h: SomeStruct = m.get("k").unwrap()
      assert_eq(h.a, 44)
      assert_eq(h.b, 55)
    end
  end

  return qspec_main()
end
