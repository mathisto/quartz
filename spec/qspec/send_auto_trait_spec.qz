## Regression tests for B1 — IMPL-TRAIT-SEND-AUTO: Send/Sync auto-trait
## propagation through `impl Trait + Send` bounds without an explicit
## `impl Send for T`.
##
## HISTORY: The handoff from the April 2026 impl Trait sprint flagged
## IMPL-TRAIT-SEND-AUTO as a pending gap. Before this fix,
## `tc_check_trait_bound` only consulted `tc_lookup_impl`, so a function
## bounded by `<T: SomeTrait + Send>` would reject any concrete T that
## lacked an explicit `impl Send for T` — even when T was structurally
## Send (all fields Send).
##
## Fix: when the bound is `Send` or `Sync` and no explicit impl exists,
## fall through to `tc_type_is_send` / `tc_type_is_sync`. These helpers
## already implement coinductive cycle detection via the
## `g_send_checking` / `g_sync_checking` global stacks, so recursive
## types like `Node { next: Option<Box<Node>> }` correctly prove Send
## via structural induction.
##
## See RFC 0458 for the "structural, not nominal" design rationale.
##
## Contract:
##   1. A struct with only primitive fields auto-satisfies Send.
##   2. A struct with a container field of a Send element auto-satisfies.
##   3. A struct with a CPtr field does NOT auto-satisfy Send.
##   4. Explicit `impl Send for T` still wins (backwards compat).
##   5. Sync auto-trait works identically.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Send/Sync auto-trait bound satisfaction") do ->

    it("struct with Int fields auto-satisfies Send bound") do ->
      assert_run_exits("""
        trait SG
          def sg_go(self): Int
        end
        struct SP
          x: Int
          y: Int
        end
        extend SP with SG
          def sg_go(self): Int = @x + @y
        end
        def accept_s<T: SG + Send>(v: T): Int = v.sg_go()
        def main(): Int
          var p = SP { x: 10, y: 32 }
          return 0 if accept_s(p) == 42
          return 1
        end
        """, 0)
    end

    it("struct with Vec<Int> field auto-satisfies Send bound") do ->
      assert_run_exits("""
        trait SG
          def sg_go(self): Int
        end
        struct SV
          items: Vec<Int>
        end
        extend SV with SG
          def sg_go(self): Int
            var t = 0
            for x in @items
              t += x
            end
            return t
          end
        end
        def accept_s<T: SG + Send>(v: T): Int = v.sg_go()
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(1)
          v.push(2)
          v.push(3)
          var sv = SV { items: v }
          return 0 if accept_s(sv) == 6
          return 1
        end
        """, 0)
    end

    it("unknown-trait bound with Send still rejects if trait missing") do ->
      ## Negative path: the Send auto-derivation is additive — a missing
      ## main-trait impl must still fail the bound check even with Send
      ## passing structurally. Guards against the fallthrough masking
      ## unrelated trait-bound failures.
      assert_compile_error("""
        trait SG
          def sg_go(self): Int
        end
        struct SU
          x: Int
        end
        ## Intentionally NO impl SG for SU
        def accept_s<T: SG + Send>(v: T): Int = v.sg_go()
        def main(): Int
          var s = SU { x: 1 }
          return 0 if accept_s(s) == 1
          return 1
        end
        """, "SG")
    end

    it("nested struct with all-Send fields auto-satisfies") do ->
      ## Exercises the coinductive cycle-safe walker: nested struct
      ## field where the inner struct also has only Send fields.
      assert_run_exits("""
        trait SG
          def sg_go(self): Int
        end
        struct Inner
          n: Int
        end
        struct Outer
          i: Inner
          extra: Int
        end
        extend Outer with SG
          def sg_go(self): Int = @i.n + @extra
        end
        def accept_s<T: SG + Send>(v: T): Int = v.sg_go()
        def main(): Int
          var o = Outer { i: Inner { n: 5 }, extra: 37 }
          return 0 if accept_s(o) == 42
          return 1
        end
        """, 0)
    end

    it("Sync auto-trait works identically — Int-only struct passes") do ->
      assert_run_exits("""
        trait SG
          def sg_go(self): Int
        end
        struct SY
          n: Int
        end
        extend SY with SG
          def sg_go(self): Int = @n
        end
        def accept_sy<T: SG + Sync>(v: T): Int = v.sg_go()
        def main(): Int
          var s = SY { n: 99 }
          return 0 if accept_sy(s) == 99
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
