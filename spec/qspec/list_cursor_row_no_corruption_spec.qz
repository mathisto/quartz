## Regression: cursor row's render+render concat must NOT trigger
## STYLE_RENDER_CONCAT_CORRUPTION.
##
## Before fix: `_list_render_item_row` returned
##   `s_cursor.render(indicator) + s_text.render(padded)`
## which is the documented STYLE_RENDER_CONCAT_CORRUPTION trigger
## pattern (see `docs/bugs/STYLE_RENDER_CONCAT_CORRUPTION.md`). The
## corruption appeared as silently-overwritten trailing bytes —
## downstream `border_with` lost the right `│` on the cursor row,
## the bottom border vanished, and any rows after wide-char content
## also lost their right border (deckbuilder Phase 1.x dogfood,
## 2026-05-05).
##
## Fix replaced `+` with `sb_new() / sb_append / sb_to_string`
## (matching the pattern used in text_input, form, viewport).
##
## This spec verifies that a list with a selected item produces the
## full expected styled row including stable trailing content. The
## color-depth-zero codepath is exercised via `assert_eq_str` —
## with no styling, the output is just "▶ <content>" / "  <content>"
## but the structural integrity (no truncation, no garbage bytes) is
## still observable.

import * from qspec
import std/tui/widgets/list as ls

enum ListCursorMsg
  Noop
end

def show_str(s: String): String = s

def main(): Int
  describe("list cursor row — no STYLE_RENDER_CONCAT_CORRUPTION") do ->
    it("selected row preserves trailing content (workaround active)") do ->
      ## Build a 3-item list, viewport 1 row, item 0 selected.
      var v = vec_new<String>()
      vec_push(v, "AAAA")
      vec_push(v, "BBBB")
      vec_push(v, "CCCC")
      var l = ls::list_new(v, ls::item_delegate_simple(show_str))
      l = ls::list_with_size(l, 20, 3)
      ## list_view emits all visible rows joined with \n. The first
      ## row is the cursor row (idx 0 selected by default). Each row
      ## is `▶ <padded-to-18>` (20 width - 2 indicator gutter = 18).
      var output = ls::list_view(l, true)
      ## Stripped (no styling — depth=0 in non-TTY): the cursor row
      ## must end with "AAAA" followed by exactly 14 spaces (18 - 4 = 14).
      ## If the bug fires, the trailing content gets clobbered.
      var lines = str_split(output, "\n")
      assert_eq(lines.size, 3)
      ## Cursor row has exact expected shape — total visible width 20.
      assert_eq_str(lines[0], "▶ AAAA              ")
      ## Non-cursor rows have indicator "  ", same total width.
      assert_eq_str(lines[1], "  BBBB              ")
      assert_eq_str(lines[2], "  CCCC              ")
    end

    it("non-selected rows also preserve trailing content") do ->
      ## Same shape; this verifies the non-selected branch's
      ## render+render concat is also routed through the workaround.
      var v = vec_new<String>()
      vec_push(v, "Hello")
      vec_push(v, "World")
      var l = ls::list_new(v, ls::item_delegate_simple(show_str))
      l = ls::list_with_size(l, 15, 2)
      var output = ls::list_view(l, false)
      var lines = str_split(output, "\n")
      assert_eq(lines.size, 2)
      ## When _focused=false, cursor indicator stays "▶ " on the
      ## selected row; both rows have their full padded content.
      ## Width 15 - 2 indicator = 13 inner. "Hello" = 5, padding = 8.
      assert_eq_str(lines[0], "▶ Hello        ")
      assert_eq_str(lines[1], "  World        ")
    end
  end

  return qspec_main()
end
