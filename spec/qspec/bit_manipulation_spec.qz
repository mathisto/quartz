## Bit Manipulation Tests
##
## Contract:
##   1. Bswap round-trips correctly.
##   2. Bswap swaps bytes of.
##   3. Clz counts leading zeros.
##   4. Clz returns 0 for.
##   5. Clz returns 64 for.
##   6. Ctz counts trailing zeros.
import * from qspec

def main(): Int
  describe("bit manipulation") do ->
    it("popcount counts set bits") do ->
      assert_eq(popcount(170), 4)
    end
    it("popcount returns 0 for zero") do ->
      assert_eq(popcount(0), 0)
    end
    it("popcount counts all bits set (255)") do ->
      assert_eq(popcount(255), 8)
    end
    it("clz counts leading zeros for 1") do ->
      assert_eq(clz(1), 63)
    end
    it("clz returns 64 for zero") do ->
      assert_eq(clz(0), 64)
    end
    it("clz returns 0 for high bit set") do ->
      assert_eq(clz(-1), 0)
    end
    it("ctz counts trailing zeros") do ->
      assert_eq(ctz(8), 3)
    end
    it("ctz returns 0 for odd numbers") do ->
      assert_eq(ctz(7), 0)
    end
    it("ctz returns 64 for zero") do ->
      assert_eq(ctz(0), 64)
    end
    it("bswap round-trips correctly") do ->
      assert_eq(bm_bswap_roundtrip(), 1)
    end
    it("bswap swaps bytes of small value") do ->
      assert_eq(bm_bswap_small(), 1)
    end
    it("rotl rotates left by 1") do ->
      assert_eq(rotl(1, 1), 2)
    end
    it("rotl rotates left by 0 is identity") do ->
      assert_eq(rotl(42, 0), 42)
    end
    it("rotr rotates right by 1") do ->
      assert_eq(rotr(2, 1), 1)
    end
    it("rotr rotates right by 0 is identity") do ->
      assert_eq(rotr(42, 0), 42)
    end
    it("popcount and rotl preserve bit count") do ->
      assert_eq(bm_popcount_rotl(), 1)
    end
  end
  return qspec_main()
end

def bm_bswap_roundtrip(): Int
  x = 12345678
  if bswap(bswap(x)) == x
    return 1
  end
  return 0
end
def bm_bswap_small(): Int
  if bswap(1) == 1
    return 0
  end
  return 1
end
def bm_popcount_rotl(): Int
  x = 170
  rotated = rotl(x, 13)
  if popcount(x) == popcount(rotated)
    return 1
  end
  return 0
end
