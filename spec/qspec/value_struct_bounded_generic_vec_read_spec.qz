## item 48-b — value-layout element INLINE READ inside a de-erased bounded-generic body.
##
## 48-a fixed DISPATCH (per-type monomorphization of `total_area<T: Area>(Vec<T>)`
## so each element type gets its own body with the right method). 48-b fixes
## LAYOUT: inside the de-erased body, `shapes[i]` must read a value-layout (@value)
## element INLINE / by-address at the element's field stride — not as a boxed
## pointer. Pre-fix the index read loaded the element's first field word as a
## scalar then `inttoptr`'d it (treating the integer field value as an address) →
## SIGSEGV for a ≤16B decomposed @value element.
##
## ROOT/FIX (mir_lower.qz):
##   HOOK #2: a `Vec<T>`-shaped param annotation never equals the bare type-param
##   name, so T was never bound in the body and `mir_infer_expr_type(shapes[i])`
##   could not resolve the concrete value-layout element. Bind `T -> <concrete
##   element>` (de-erased from the arg's `Vec<Circle>` type, 48-a) GATED on the
##   element being value-layout.
##   Plus: resolve the NODE_INDEX element annotation through the specialization
##   context (handling the erased `"error"` sentinel via mir_infer_expr_type) so
##   codegen's inline by-address read fires.
##
## GATE-0-INERT: reference-struct elements (8B boxed) read correctly via the
## boxed-pointer path and produce byte-identical IR (verified A/B golden vs new).
##
## Exercised at gate-0 via `@value` (value-layout today; no default-flip needed).
## Covers ≤16B (decomposed) AND >16B (cow) element widths.

import * from qspec

trait Area
  def area(self): Int
    return 0
  end
end

# ≤16B @value (2 Int = 16B) — decomposed-register element read.
@value
struct SmallShape
  r: Int
  k: Int
end

extend SmallShape with Area
  def area(self): Int = @r * @k
end

# >16B @value (5 Int = 40B) — cow-layout element read.
@value
struct BigShape
  r: Int
  k: Int
  a: Int
  b: Int
  c: Int
end

extend BigShape with Area
  def area(self): Int = @r * @k
end

# Bounded generic over Vec<T>: index-read + method dispatch on the element.
def total_area<T: Area>(shapes: Vec<T>): Int
  var sum = 0
  for i in 0..shapes.size
    sum += shapes[i].area()
  end
  return sum
end

def small_total(): Int
  var cs = vec_new<SmallShape>()
  cs.push(SmallShape { r: 3, k: 2 })   # area 6
  cs.push(SmallShape { r: 5, k: 4 })   # area 20
  return total_area(cs)
end

def big_total(): Int
  var cs = vec_new<BigShape>()
  cs.push(BigShape { r: 3, k: 2, a: 0, b: 0, c: 0 })   # area 6
  cs.push(BigShape { r: 5, k: 4, a: 0, b: 0, c: 0 })   # area 20
  return total_area(cs)
end

def main(): Int
  describe("@value bounded-generic Vec element inline read (item 48-b)") do ->
    it("reads a <=16B decomposed @value element inline (method dispatch)") do ->
      # Pre-fix: SIGSEGV (inttoptr of field-0 scalar). Want 6 + 20 = 26.
      assert_eq(small_total(), 26)
    end

    it("reads a >16B cow @value element inline (method dispatch)") do ->
      assert_eq(big_total(), 26)
    end
  end

  return qspec_main()
end
