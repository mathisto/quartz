## Option<dataless-enum> niche-representation tests (B.10 §14 N3 item 6.4d).
##
## A DATALESS enum (`enum Color { Red, Green, Blue }`) is scalar-represented: the
## value IS its tag (0..K-1). So `Option<Color>` has a clean TOP NICHE — `None` = K
## (the variant count), every valid `Color` is < K. This sits ABOVE the tags
## exactly like `Bool`'s {2,254}, so there is NO nil=0 collision: sound BY
## CONSTRUCTION (the niche is the variant count, not 0).
##
## *** RUNS UNDER THE SPILL PATH ***
## The dataless-enum niche machinery is SCAFFOLDED but GATED OFF
## (`mir_boxed_niche_dataless_enum_live()` returns 0 in self-hosted/backend/mir.qz).
## Until that gate is flipped (a SUPERVISED one-way door — it rebases the compiler's
## own emitted IR), `Option<dataless-enum>` uses the byte-identical tagged-box SPILL
## layout. These tests pass under that spill path TODAY; they exist to LOCK the
## observable behavior so the eventual flip is a differential oracle: identical
## source, identical behavior, regardless of physical representation.
##
## Coverage:
##   - Some(Color) round-trip: is Some / match Some(c) => / .unwrap()
##   - None of Option<Color>: is None / .is_none() / match None =>
##   - None != any Color variant (the K-above-tags soundness property)
##   - round-trip through a function arg + return (call-arg/return slots)
##   - a K-variant enum (K=4) — niche is at the variant count, not hardwired
##   - NESTED Option<Option<Color>>: Some(None) must differ from None
##   - Vec<Option<Color>> round-trip (broke String/struct in 6.4a/6.4b — lock it)
import * from qspec

enum Color
  Red
  Green
  Blue
end

# A 4-variant enum: confirms the niche follows the variant count K, not a constant.
enum Dir
  North
  South
  East
  West
end

def main(): Int
  describe("Option<Color> niche — Some round-trip") do ->
    it("is Some for a constructed Some(Color)") do ->
      opt = Option::Some(Color::Green)
      assert_eq(opt is Some, 1)
    end
    it("is_some() true / is_none() false for Some") do ->
      opt = Option::Some(Color::Green)
      assert_eq(opt.is_some(), 1)
    end
    it("matches Some(c) and recovers the variant") do ->
      opt = Option::Some(Color::Blue)
      v = match opt
        Some(c) => if c is Blue then 1 else 0 end
        None => -1
      end
      assert_eq(v, 1)
    end
    it("unwrap() returns the payload variant") do ->
      opt = Option::Some(Color::Red)
      c = opt.unwrap()
      assert_eq(c is Red, 1)
    end
    it("Some(Red) — tag-0 variant round-trips (not confused with None)") do ->
      # Red is variant tag 0; under a TOP niche (None=K) tag 0 stays Some.
      opt = Option::Some(Color::Red)
      assert_eq(opt is Some, 1)
      assert_eq(opt is None, 0)
    end
  end

  describe("Option<Color> niche — None") do ->
    it("is None for an explicit None") do ->
      opt = none_color()
      assert_eq(opt is None, 1)
    end
    it("is_none() true / is_some() false for None") do ->
      opt = none_color()
      assert_eq(opt.is_none(), 1)
      assert_eq(opt.is_some(), 0)
    end
    it("matches the None arm") do ->
      opt = none_color()
      v = match opt
        Some(c) => 1
        None => 0
      end
      assert_eq(v, 0)
    end
  end

  describe("Option<Color> niche — None distinct from every variant") do ->
    it("None != Some(Red) (tag 0)") do ->
      assert_eq(disc(none_color()), disc_none())
      assert_eq(disc(Option::Some(Color::Red)), disc_some())
    end
    it("None != Some(Green) (tag 1)") do ->
      assert_eq(disc(Option::Some(Color::Green)), disc_some())
    end
    it("None != Some(Blue) (tag K-1)") do ->
      assert_eq(disc(Option::Some(Color::Blue)), disc_some())
    end
  end

  describe("Option<Dir> niche — K=4 variant enum") do ->
    it("Some(West) — highest tag (K-1) stays Some") do ->
      opt = Option::Some(Dir::West)
      v = match opt
        Some(d) => if d is West then 1 else 0 end
        None => -1
      end
      assert_eq(v, 1)
    end
    it("None of Option<Dir> is None") do ->
      assert_eq(none_dir() is None, 1)
    end
  end

  describe("Option<Color> niche — round-trip through call boundary") do ->
    it("passes Some(Color) as arg and returns it, variant intact") do ->
      opt = rt_color(Option::Some(Color::Blue))
      v = match opt
        Some(c) => if c is Blue then 7 else 0 end
        None => -1
      end
      assert_eq(v, 7)
    end
    it("passes None through arg+return as None") do ->
      opt = rt_color(none_color())
      assert_eq(opt is None, 1)
    end
  end

  describe("Option<Option<Color>> nested — soundness catch-net") do ->
    it("Some(None) is outer-Some (distinguishable from outer-None)") do ->
      opt = co_some_none()
      assert_eq(opt is Some, 1)
    end
    it("Some(None): inner is None") do ->
      opt = co_some_none()
      inner_is_none = match opt
        Some(inner) => if inner is None then 1 else 0 end
        None => -1
      end
      assert_eq(inner_is_none, 1)
    end
    it("outer None is distinct from Some(None)") do ->
      assert_eq(co_outer_none() is None, 1)
    end
    it("Some(Some(Color)) reaches the inner variant") do ->
      opt = co_some_some()
      v = match opt
        Some(inner) => match inner
          Some(c) => if c is Green then 5 else 0 end
          None => -2
        end
        None => -1
      end
      assert_eq(v, 5)
    end
  end

  describe("Vec<Option<Color>> round-trip") do ->
    it("stores Some/None elements and reads them back") do ->
      v = vec_new<Option<Color>>()
      v.push(Option::Some(Color::Red))
      v.push(none_color())
      v.push(Option::Some(Color::Blue))
      assert_eq(v.size, 3)
      assert_eq(v[0] is Some, 1)
      assert_eq(v[1] is None, 1)
      assert_eq(v[2] is Some, 1)
    end
    it("recovers the variant from a Some element") do ->
      v = vec_new<Option<Color>>()
      v.push(Option::Some(Color::Green))
      first = v[0]
      r = match first
        Some(c) => if c is Green then 9 else 0 end
        None => -1
      end
      assert_eq(r, 9)
    end
  end

  return qspec_main()
end

def none_color(): Option<Color>
  return Option::None
end

def none_dir(): Option<Dir>
  return Option::None
end

def rt_color(o: Option<Color>): Option<Color>
  return o
end

# Discriminant helpers: 0 for None, 1 for Some — used to assert None != any Some.
def disc(o: Option<Color>): Int
  return match o
    Some(c) => 1
    None => 0
  end
end
def disc_none(): Int = 0
def disc_some(): Int = 1

def co_some_none(): Option<Option<Color>>
  return Option::Some(none_color())
end

def co_outer_none(): Option<Option<Color>>
  return Option::None
end

def co_some_some(): Option<Option<Color>>
  return Option::Some(Option::Some(Color::Green))
end
