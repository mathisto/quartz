## Simd Convert Tests
##
## Contract:
##   1. F32x4 to i32x4 conversion.
##   2. I32x4 to f32x4 conversion.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("SIMD Convert") do ->
    it("f32x4 to i32x4 conversion") do ->
      assert_ir_contains_with_flags("""
        def main(): Int
          var v = simd_f32x4_splat(1.5)
          var result = simd_convert_f32x4_to_i32x4(v)
          return 0
        end
      """, "fptosi", "")
    end

    it("i32x4 to f32x4 conversion") do ->
      assert_ir_contains_with_flags("""
        def main(): Int
          var v = simd_i32x4_splat(42)
          var result = simd_convert_i32x4_to_f32x4(v)
          return 0
        end
      """, "sitofp", "")
    end
  end

  return qspec_main()
end
