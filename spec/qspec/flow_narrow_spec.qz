## SURF.FLOW Phase 1 — flow-narrowing (smart-cast) MVP.
##
## After a presence guard (`if x.some?` / `if x.is_some()` / `if x is Some`)
## proves a CONST `x: Option<T>` is present, `x` itself reads as the inner `T`
## inside the then-branch ONLY — no explicit `.unwrap()`. const-only,
## bare-identifier-only, then-branch-only, Option-only (FLOW_NARROWING.md §5/§6).
##
## The narrowed read lowers through the proven niche/spill Option payload-extract
## (identity for niche `Option<String>`, `option_get` load for spill `Option<Int>`),
## so the value observed inside the branch is the payload, NOT the Option word.
##
## The NEGATIVE cases are the point: narrowing must not leak past `end`, must not
## apply to `var`, and must not fire on a non-presence condition.
import * from qspec

# --- Positive: narrowed const read used directly as inner T ---

## spill Option<Int> via `.some?` — narrowed `o` reads as Int (42), +100 = 142.
def spill_some_q(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o.some?
    r = use_int(o)
  end
  return r
end

## spill Option<Int> via `.is_some()` UFCS — narrowed `o` reads as Int.
def spill_is_some(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o.is_some()
    r = use_int(o)
  end
  return r
end

## spill Option<Int> via `is Some` — narrowed `o` reads as Int.
def spill_is_keyword(): Int
  o: Option<Int> = option_some(42)
  var r = 0
  if o is Some
    r = use_int(o)
  end
  return r
end

## niche Option<String> via `.some?` — narrowed `os` reads as String.
def niche_some_str(): String
  os: Option<String> = option_some("payload")
  var r = "MISS"
  if os.some?
    r = use_str(os)
  end
  return r
end

## nested then-blocks — both subjects narrowed simultaneously.
def nested_narrow(): Int
  o: Option<Int> = option_some(40)
  o2: Option<Int> = option_some(2)
  var r = 0
  if o.some?
    if o2.some?
      r = use_int_raw(o) + use_int_raw(o2)
    end
  end
  return r
end

# --- Negative / soundness: these define the safety boundary ---

## Narrowing must NOT leak past `end`. After the `if`, `o` is Option<Int> again
## and the present value can only be read via explicit `.unwrap()` — which still
## yields the correct payload. (If narrowing leaked, the post-`if` bare read would
## also be a payload; we assert the explicit-unwrap path is what reaches it.)
def no_leak_after_if(): Int
  o: Option<Int> = option_some(7)
  if o.some?
    # in-branch: narrowed
  end
  # after the if: NOT narrowed — must unwrap to read the inner value
  return o.unwrap()
end

## A `var` Option is NOT narrowed in Phase 1 — the present value inside the
## then-branch is still reached via explicit `.unwrap()`. (Bare-`var` narrowing
## would be unsound without reassignment tracking; Phase 1 refuses it.)
def var_not_narrowed(): Int
  var vo: Option<Int> = option_some(9)
  var r = 0
  if vo.some?
    r = vo.unwrap()
  end
  return r
end

## A non-presence condition does not narrow — control still depends on a plain
## bool, and the Option is read via explicit unwrap.
def non_presence_no_narrow(): Int
  cond = true
  o: Option<Int> = option_some(3)
  var r = 0
  if cond
    r = o.unwrap()
  end
  return r
end

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

def main(): Int
  describe("SURF.FLOW Phase 1 — const Option then-branch narrowing") do ->
    it("narrows const Option in then-branch") do ->
      assert_eq(spill_some_q(), 142)
    end

    it("narrows via .is_some()") do ->
      assert_eq(spill_is_some(), 142)
    end

    it("narrows via `is Some`") do ->
      assert_eq(spill_is_keyword(), 142)
    end

    it("narrows a niche Option<String> to its payload") do ->
      assert_eq_str(niche_some_str(), "payload")
    end

    it("narrows both subjects in nested then-blocks") do ->
      assert_eq(nested_narrow(), 42)
    end
  end

  describe("SURF.FLOW Phase 1 — soundness boundary") do ->
    it("does not leak narrowing past the if's end") do ->
      assert_eq(no_leak_after_if(), 7)
    end

    it("does not narrow a var Option in Phase 1") do ->
      assert_eq(var_not_narrowed(), 9)
    end

    it("does not narrow on a non-presence condition") do ->
      assert_eq(non_presence_no_narrow(), 3)
    end
  end

  return qspec_main()
end
