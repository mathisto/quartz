## Match Exhaustiveness Tests
##
## Contract:
##   1. Enum matching.
##   2. Option enum.
##   3. Exhaustiveness checking.
##   4. Match arm type consistency.

import * from qspec
import * from qspec/subprocess

enum MEColor
  Red
  Green
  Blue
end

enum MEDirection
  North
  South
  East
  West
end

enum MESize
  Small
  Medium
  Large
  XLarge
end

enum MECoin
  Heads
  Tails
end

def main(): Int
  describe("enum matching") do ->
    it("compiles and runs exhaustive match with all variants") do ->
      assert_eq(me_color_value(MEColor::Green), 2)
    end

    it("compiles and runs match with wildcard catch-all") do ->
      assert_eq(me_is_red(MEColor::Blue), 0)
    end
  end

  describe("Option enum") do ->
    it("compiles and runs exhaustive Option match") do ->
      assert_eq(me_option_match(Option::Some(42)), 1)
      assert_eq(me_option_match(Option::None), 0)
    end

    it("extracts value from Some variant") do ->
      assert_eq(me_option_extract(Option::Some(42)), 42)
      assert_eq(me_option_extract(Option::None), -1)
    end
  end

  describe("exhaustiveness checking") do ->
    it("warns on missing enum variant") do ->
      assert_compile_error("""
enum Color
  Red
  Green
  Blue
end
def main(): Int
  c = Color::Red
  return match c
    Color::Red => 1
    Color::Green => 2
  end
end
""", "non-exhaustive")
    end

    it("accepts when all enum variants are covered") do ->
      assert_eq(me_to_deg(MEDirection::West), 270)
    end

    it("accepts match with wildcard pattern") do ->
      assert_eq(me_is_small(MESize::Large), 0)
    end

    it("warns for Int match without wildcard") do ->
      assert_compile_error("def main(): Int\n  x = 42\n  return match x\n    1 => 10\n    2 => 20\n  end\nend\n", "non-exhaustive")
    end

    it("accepts Int match with wildcard") do ->
      assert_eq(me_classify(42), 99)
    end

    it("warns for String match without wildcard") do ->
      assert_compile_error("def main(): Int\n  s = \"hello\"\n  return match s\n    \"a\" => 1\n    \"b\" => 2\n  end\nend\n", "non-exhaustive")
    end
  end

  describe("match arm type consistency") do ->
    it("rejects match arms with incompatible types (compile error)") do ->
      assert_compile_error("def main(): Int\n  var x = 1\n  var result = match x\n    1 => \"hello\"\n    _ => 42\n  end\n  return 0\nend\n", "Match arm type mismatch")
    end

    it("accepts match arms with consistent types") do ->
      assert_eq(me_flip_value(MECoin::Tails), 2)
    end

    it("shows related span pointing to first arm (compile error)") do ->
      assert_compile_error("def main(): Int\n  var x = 1\n  var result = match x\n    1 => \"hello\"\n    _ => 42\n  end\n  return 0\nend\n", "first arm at line 4")
    end
  end

  return qspec_main()
end

def me_color_value(c: MEColor): Int
  match c
    MEColor::Red => return 1
    MEColor::Green => return 2
    MEColor::Blue => return 3
  end
end

def me_is_red(c: MEColor): Int
  match c
    MEColor::Red => return 1
    _ => return 0
  end
end

def me_to_deg(d: MEDirection): Int
  match d
    MEDirection::North => return 0
    MEDirection::East => return 90
    MEDirection::South => return 180
    MEDirection::West => return 270
  end
end

def me_is_small(s: MESize): Int
  match s
    MESize::Small => 1
    _ => 0
  end
end

def me_classify(n: Int): Int
  match n
    0 => return 10
    1 => return 20
    _ => return 99
  end
end

def me_flip_value(c: MECoin): Int
  match c
    MECoin::Heads => return 1
    MECoin::Tails => return 2
  end
end

def me_option_match(o: Int): Int
  return match o
    Some(v) => 1
    None => 0
    _ => -1
  end
end

def me_option_extract(o: Int): Int
  return match o
    Some(v) => v
    None => -1
    _ => -2
  end
end

