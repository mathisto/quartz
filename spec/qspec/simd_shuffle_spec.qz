## Simd Shuffle Tests
##
## Contract:
##   1. Simd_f32x4_shuffle reverses lanes.
##   2. Simd_f64x2_shuffle swaps lanes.
##   3. Simd_i32x4_shuffle broadcasts lane 0.
import * from qspec

def main(): Int
  describe("SIMD shuffle") do ->
    it("simd_f32x4_shuffle reverses lanes") do ->
      assert_output("shuffle ok\n", ss_f32x4_shuffle)
    end
    it("simd_f64x2_shuffle swaps lanes") do ->
      assert_output("f64x2 shuffle ok\n", ss_f64x2_shuffle)
    end
    it("simd_i32x4_shuffle broadcasts lane 0") do ->
      assert_output("42\n42\n", ss_i32x4_shuffle)
    end
  end
  return qspec_main()
end

def ss_f32x4_shuffle(): Void
  splat_one = simd_f32x4_splat(1.0)
  splat_four = simd_f32x4_splat(4.0)
  result = simd_f32x4_shuffle(splat_one, splat_four, 0, 0, 0, 4)
  lane_zero = simd_f32x4_extract(result, 0)
  lane_three = simd_f32x4_extract(result, 3)
  if lane_zero == 1.0
    if lane_three == 4.0
      puts("shuffle ok")
    else
      puts("shuffle fail lane3")
    end
  else
    puts("shuffle fail lane0")
  end
end
def ss_f64x2_shuffle(): Void
  a = simd_f64x2_splat(10.0)
  b = simd_f64x2_splat(20.0)
  r = simd_f64x2_shuffle(a, b, 2, 0)
  val0 = simd_f64x2_extract(r, 0)
  val1 = simd_f64x2_extract(r, 1)
  if val0 == 20.0
    if val1 == 10.0
      puts("f64x2 shuffle ok")
    else
      puts("f64x2 shuffle fail lane1")
    end
  else
    puts("f64x2 shuffle fail lane0")
  end
end
def ss_i32x4_shuffle(): Void
  a = simd_i32x4_splat(42)
  b = simd_i32x4_splat(99)
  r = simd_i32x4_shuffle(a, b, 0, 0, 0, 0)
  print_int(simd_i32x4_extract(r, 0))
  print_int(simd_i32x4_extract(r, 3))
end
