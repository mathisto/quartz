## URL Encoding Spec — Tests for std/net/url
##
## Tests url_decode and url_encode covering:
##   - Basic percent-decoding
##   - Plus-to-space conversion
##   - Roundtrip encode/decode
##   - Malformed sequences
##   - Empty strings
##   - Special characters

import * from qspec
import std/net/url

# =============================================================================
# Decode helpers
# =============================================================================

def print_decode_basic(): Void
  puts(url_decode("hello%20world"))
end

def print_decode_plus(): Void
  puts(url_decode("hello+world"))
end

def print_decode_multiple(): Void
  puts(url_decode("a%20b%20c"))
end

def print_decode_hex_lower(): Void
  puts(url_decode("%2f%3a"))
end

def print_decode_empty(): Void
  var result = url_decode("")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_decode_no_encoding(): Void
  puts(url_decode("hello"))
end

def print_decode_malformed_short(): Void
  puts(url_decode("abc%2"))
end

def print_decode_malformed_nonhex(): Void
  puts(url_decode("abc%GGdef"))
end

def print_decode_special(): Void
  puts(url_decode("key%3Dvalue%26other%3D2"))
end

# =============================================================================
# Encode helpers
# =============================================================================

def print_encode_space(): Void
  puts(url_encode("hello world"))
end

def print_encode_special(): Void
  puts(url_encode("a=b&c=d"))
end

def print_encode_unreserved(): Void
  puts(url_encode("hello-world_v1.0~test"))
end

def print_encode_empty(): Void
  var result = url_encode("")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

# =============================================================================
# Roundtrip helper
# =============================================================================

def print_roundtrip(): Void
  var original = "hello world/foo?bar=baz&x=1"
  var encoded = url_encode(original)
  var decoded = url_decode(encoded)
  puts(decoded)
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("url_decode") do ->
    it("decodes %20 to space") do ->
      assert_output("hello world\n", print_decode_basic)
    end

    it("decodes + to space") do ->
      assert_output("hello world\n", print_decode_plus)
    end

    it("decodes multiple percent sequences") do ->
      assert_output("a b c\n", print_decode_multiple)
    end

    it("decodes lowercase hex digits") do ->
      assert_output("/:\n", print_decode_hex_lower)
    end

    it("returns empty for empty string") do ->
      assert_output("empty\n", print_decode_empty)
    end

    it("passes through unencoded strings") do ->
      assert_output("hello\n", print_decode_no_encoding)
    end

    it("passes through malformed short sequence") do ->
      assert_output("abc%2\n", print_decode_malformed_short)
    end

    it("passes through malformed non-hex sequence") do ->
      assert_output("abc%GGdef\n", print_decode_malformed_nonhex)
    end

    it("decodes special chars (= & etc)") do ->
      assert_output("key=value&other=2\n", print_decode_special)
    end
  end

  describe("url_encode") do ->
    it("encodes space as %20") do ->
      assert_output("hello%20world\n", print_encode_space)
    end

    it("encodes special characters") do ->
      assert_output("a%3Db%26c%3Dd\n", print_encode_special)
    end

    it("passes through unreserved characters") do ->
      assert_output("hello-world_v1.0~test\n", print_encode_unreserved)
    end

    it("returns empty for empty string") do ->
      assert_output("empty\n", print_encode_empty)
    end
  end

  describe("URL roundtrip") do ->
    it("encode then decode is identity") do ->
      assert_output("hello world/foo?bar=baz&x=1\n", print_roundtrip)
    end
  end

  return qspec_main()
end
