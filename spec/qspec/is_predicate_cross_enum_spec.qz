## IS_PREDICATE_CROSS_ENUM_TAG_COLLISION regression spec.
##
## The `is X` predicate must dispatch by (enum_identity, tag) — not by tag
## alone. Two known surfaces of the same compiler bug:
##
##   A) `is None` on a non-Option user enum SIGSEGVs at runtime when the
##      pre-fix global variant search resolves `None` to Option::None and
##      mir_get_enum_tag emits the Option-shaped tag-load against an
##      unrelated layout. (Memory-feedback: is_none_non_option_segfault.)
##
##   B) Cross-enum same-named-variant collision: `is Quit` against a
##      `Cmd::After(...)` value matched because FrameMsg::Quit and
##      Cmd::After share tag 4. (Bug doc:
##      docs/bugs/IS_PREDICATE_CROSS_ENUM_TAG_COLLISION.md.)
##
## The fix (May 6 2026):
##   - Typecheck rejects `subject is X` when X isn't a variant of the
##     subject's static enum (QZ0231).
##   - MIR-lower's NODE_IS_CHECK paths resolve the enum from the subject's
##     static type, falling back to the legacy global search only when the
##     type is unknown (Int-erased generics).

import * from qspec

def main(): Int
  describe("is predicate — cross-enum tag collision") do ->

    # Surface A — was SIGSEGV pre-fix (is_none_non_option_segfault).
    it("is None on user enum with payload-enum sibling does not crash") do ->
      assert_run_exits("""
        enum E
          None
          Other
        end

        def main(): Int
          var e = E::None
          if e is None
            return 7
          end
          return 0
        end
        """, 7)
    end

    it("is None on user enum returns false when value isn't the None variant") do ->
      assert_run_exits("""
        enum E
          None
          Other
        end

        def main(): Int
          var e = E::Other
          if e is None
            return 1
          end
          return 0
        end
        """, 0)
    end

    # Surface B — cross-enum same-named-variant tag collision.
    # FrameMsg::Quit at tag 4 and Cmd::After at tag 4 — pre-fix `c is Quit`
    # against a `Cmd::After(_, _)` returned true.
    it("is Quit on Cmd does not match Cmd::After when FrameMsg::Quit shares the tag") do ->
      assert_run_exits("""
        enum FrameMsg
          Key(code: Int)
          Resize(cols: Int)
          Tick(t: Int)
          App(m: Int)
          Quit
        end

        enum Cmd
          Nope
          Quit
          Batch(things: Int)
          Run(thunk: Int)
          After(ms: Int, thunk: Int)
          Every(ms: Int, thunk: Int)
        end

        def main(): Int
          var c: Cmd = Cmd::After(100, 0)
          if c is Quit
            return 1
          end
          return 0
        end
        """, 0)
    end

    # And the positive case still works on the SAME shape — `is Quit` does
    # match an actual `Cmd::Quit` value.
    it("is Quit matches the right enum's Quit when both enums declare Quit") do ->
      assert_run_exits("""
        enum FrameMsg
          Key(code: Int)
          Resize(cols: Int)
          Tick(t: Int)
          App(m: Int)
          Quit
        end

        enum Cmd
          Nope
          Quit
          Batch(things: Int)
          Run(thunk: Int)
          After(ms: Int, thunk: Int)
          Every(ms: Int, thunk: Int)
        end

        def main(): Int
          var c: Cmd = Cmd::Quit
          if c is Quit
            return 9
          end
          return 0
        end
        """, 9)
    end

    # Typecheck-time rejection: `is X` where X isn't a variant of the
    # subject's static enum is now a compile error (QZ0231).
    it("rejects is X when X is not a variant of the subject enum") do ->
      assert_compile_error("""
        enum FrameMsg
          Key
          Quit
        end

        enum Cmd
          Run
          Wait
        end

        def main(): Int
          var c: Cmd = Cmd::Wait
          if c is Quit
            return 1
          end
          return 0
        end
        """, "QZ0231")
    end

  end

  return qspec_main()
end
