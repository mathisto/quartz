## Extend block fixture for cross-module extend/impl tests

struct ExtPoint
  x: Int
  y: Int
end

def ext_square(n: Int): Int = n * n

extend ExtPoint
  def magnitude_sq(self: ExtPoint): Int
    return ext_square(self.x) + ext_square(self.y)
  end
  def translate_x(self: ExtPoint, dx: Int): ExtPoint
    return ExtPoint { x: self.x + dx, y: self.y }
  end
end

## Wrapper functions for cross-module testing (UFCS doesn't dispatch across modules)
def ext_test_mag_sq(x: Int, y: Int): Int
  p = ExtPoint { x: x, y: y }
  return p.magnitude_sq()
end

def ext_test_translate(x: Int, y: Int, dx: Int): Int
  p = ExtPoint { x: x, y: y }
  q = p.translate_x(dx)
  return q.x
end
