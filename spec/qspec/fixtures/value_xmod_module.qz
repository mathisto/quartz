## item 32b regression fixture — cross-module @value generic-wrapper dispatch.
##
## Twin of `nmutp_xmod_module.qz`, but the inner range struct is `@value`
## (16B all-scalar = value-layout). The generic wrapper `VXDouble<I>` embeds
## the @value source INLINE; the terminal `vx_sum` drains it through the
## wrapper's `vx_next()`.
##
## Before the item-32b fix: `mir_get_struct_type_params` looked up the wrapper
## by its BARE name (`VXDouble`, parsed off the receiver instantiation), but a
## struct defined in an IMPORTED module registers under the MODULE-PREFIXED key
## (`value_xmod_module$VXDouble`). The bare lookup missed ⇒ the
## `_mir_try_struct_method_spec` router saw a non-generic struct ⇒ no spec was
## queued ⇒ the extend-method `VXDouble$vx_next` lowered un-monomorphized ⇒ the
## `@source` value-field receiver read took the BOXED inttoptr+GEP+load branch on
## the inlined 16B value, derefing field-word-0 (an integer) as a pointer ⇒
## SIGSEGV. The fix gives `mir_get_struct_type_params` a `mir_resolve_struct_name`
## -style suffix fallback so the router resolves the module-prefixed registration.

trait VXIter
  def vx_next(self): Option<Int>
end

@value
struct VXRange
  current: Int
  stop: Int
end

extend VXRange with VXIter
  def vx_next(&mut self): Option<Int>
    if @current < @stop
      var v = @current
      self.current = v + 1
      return Option::Some(v)
    end
    return Option::None
  end
end

struct VXDouble<I: VXIter>
  source: I
end

extend VXDouble<T> with VXIter
  def vx_next(self): Option<Int>
    match @source.vx_next()
      Some(v) => return Option::Some(v * 2)
      None => return Option::None
    end
  end
end

def vx_range(s: Int, e: Int): VXRange
  return VXRange { current: s, stop: e }
end

def vx_double<I: VXIter>(src: I): VXDouble<I>
  return VXDouble<I> { source: src }
end

def vx_sum<I: VXIter>(src: I): Int
  var it = src
  var t = 0
  var g = 0
  while g < 100
    match it.vx_next()
      Some(v) => t = t + v
      None => return t
    end
    g = g + 1
  end
  return t
end
