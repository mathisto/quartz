## Fixture module for NESTED-MONO-UFCS-TYPE-PARAM cross-module regression test.
##
## Exercises the exact shape from std/iter.qz Phase 6 modernization: a bounded
## generic wrapper struct + bounded generic terminal, both defined in this
## module, called from a main file that imports them. Before the A8 fix added
## in mir_lower_expr_handlers.qz's spec_current_module_prefix lookup, the
## terminal's `it.next()` dispatched to the wrong specialized method because
## the candidate lookup ignored the module prefix and fell through to the
## wrong concrete impl.

trait XMIter
  def xm_next(self): Option<Int>
end

struct XMRange
  current: Int
  stop: Int
end

extend XMRange with XMIter
  def xm_next(&mut self): Option<Int>
    if @current < @stop
      var v = @current
      self.current = v + 1
      return Option::Some(v)
    end
    return Option::None
  end
end

struct XMDouble<I: XMIter>
  source: I
end

extend XMDouble<T> with XMIter
  def xm_next(self): Option<Int>
    match @source.xm_next()
      Some(v) => return Option::Some(v * 2)
      None => return Option::None
    end
  end
end

def xm_range(s: Int, e: Int): XMRange
  return XMRange { current: s, stop: e }
end

def xm_double<I: XMIter>(src: I): XMDouble<I>
  return XMDouble<I> { source: src }
end

def xm_sum<I: XMIter>(src: I): Int
  var it = src
  var t = 0
  var g = 0
  while g < 100
    match it.xm_next()
      Some(v) => t = t + v
      None => return t
    end
    g = g + 1
  end
  return t
end
