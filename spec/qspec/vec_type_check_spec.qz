## Vec Type Checking Tests
##
## Contract:
##   1. Typed push: correct type accepted into Vec<T>.
##   2. Typed index: bracket access infers element type.
##   3. UFCS push: .push() type inferred from Vec<T>.
##   4. Rejection: wrong type into Vec<String> = compile error.
##   5. Rejection: wrong type into Vec<Int> = compile error.
##   6. vec_set: wrong value type rejected.

import * from qspec
import * from qspec/subprocess

def vtc_push_inferred(): Int
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  return v.size
end

def vtc_push_size(): Int
  var v: Vec<Int> = vec_new()
  v.push(100)
  v.push(200)
  return v.size
end

def main(): Int
  describe("Vec type checking") do ->
    it("accepts pushing correct type into typed Vec with bracket access") do ->
      assert_eq(vtc_bracket_push(), 10)
    end
    it("infers correct element type from bracket index") do ->
      assert_eq(vtc_bracket_get(), 20)
    end

    it("accepts UFCS push with inferred type") do ->
      assert_eq(vtc_push_inferred(), 2)
    end

    it("accepts Vec<Int> with int value") do ->
      assert_eq(vtc_push_size(), 2)
    end

    it("rejects pushing wrong type into Vec<String>") do ->
      assert_compile_error(vtc_wrong_str_src(), "vec_push: expected element type")
    end
    it("rejects pushing wrong type into Vec<Int>") do ->
      assert_compile_error(vtc_wrong_int_src(), "vec_push: expected element type")
    end
    it("rejects vec_set with wrong value type") do ->
      assert_compile_error(vtc_wrong_set_src(), "vec_set: expected element type")
    end
    it("rejects UFCS push type mismatch") do ->
      assert_compile_error(vtc_ufcs_mismatch_src(), "vec_push: expected element type")
    end
  end

  return qspec_main()
end

def vtc_bracket_push(): Int
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  return v[0]
end

def vtc_bracket_get(): Int
  var v = vec_new()
  v.push(10)
  v.push(20)
  return v[1]
end

def vtc_wrong_str_src(): String
  return "def main(): Int\n  var v: Vec<String> = vec_new()\n  vec_push(v, 42)\n  return 0\nend\n"
end

def vtc_wrong_int_src(): String
  return "def main(): Int\n  var v: Vec<Int> = vec_new()\n  vec_push(v, \"hello\")\n  return 0\nend\n"
end

def vtc_wrong_set_src(): String
  return "def main(): Int\n  var v: Vec<Int> = vec_new()\n  vec_push(v, 1)\n  vec_set(v, 0, \"wrong\")\n  return 0\nend\n"
end

def vtc_ufcs_mismatch_src(): String
  return "def main(): Int\n  var v: Vec<String> = vec_new()\n  v.push(42)\n  return 0\nend\n"
end
