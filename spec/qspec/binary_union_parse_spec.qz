## Binary DSL — Phase 2 Track B (discriminated unions) parser coverage.
##
## These tests cover ONLY the parser surface. Typechecker validation
## (discriminator must be prior primitive integer field, non-overlapping
## tag values) lands in STEP B2. Codegen lands in STEP B3/B4.
##
## See: docs/design/BINARY_DSL.md and
##      docs/handoff/overnight-binary-dsl-phase-2-trackb-kickoff.md

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — union parser") do ->

    it("parses a union with empty, single-field, and multi-field arms") do ->
      assert_compile_succeeds("""
        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }
        def main(): Int = 0
        """)
    end

    it("parses a union whose discriminator is u16be") do ->
      assert_compile_succeeds("""
        type Tlv = binary {
          kind: u16be
          match kind
            1 => { v: u32be }
            2 => { s: pstring(u8) }
          end
        }
        def main(): Int = 0
        """)
    end

    it("parses a union with no arms (typecheck will reject later)") do ->
      assert_compile_succeeds("""
        type Weird = binary {
          kind: u8
          match kind
          end
        }
        def main(): Int = 0
        """)
    end

    it("rejects a union missing the discriminator identifier") do ->
      assert_compile_error("""
        type Bad = binary {
          kind: u8
          match
            0 => { }
          end
        }
        def main(): Int = 0
        """, "")
    end

    it("rejects a union arm with no fat arrow") do ->
      assert_compile_error("""
        type Bad = binary {
          kind: u8
          match kind
            0 { }
          end
        }
        def main(): Int = 0
        """, "")
    end

    it("rejects a union arm whose tag is not an integer literal") do ->
      assert_compile_error("""
        type Bad = binary {
          kind: u8
          match kind
            foo => { }
          end
        }
        def main(): Int = 0
        """, "")
    end

  end
  return qspec_main()
end
