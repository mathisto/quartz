## Puts Auto-Coercion Tests
## Tests that puts() automatically coerces non-String arguments via to_str().

import * from qspec

def test_puts_int(): Void
  puts(42)
end

def test_puts_neg(): Void
  puts(-1)
end

def test_puts_zero(): Void
  puts(0)
end

def test_puts_str(): Void
  puts("hello")
end

def test_puts_expr(): Void
  var x = 10
  puts(x + 5)
end

def main(): Int
  describe("puts auto-coercion") do ->
    it("puts(42) prints integer as string") do ->
      assert_output("42\n", test_puts_int)
    end

    it("puts(-1) prints negative") do ->
      assert_output("-1\n", test_puts_neg)
    end

    it("puts(0) prints zero") do ->
      assert_output("0\n", test_puts_zero)
    end

    it("puts(string) still works") do ->
      assert_output("hello\n", test_puts_str)
    end

    it("puts(expr) coerces expression result") do ->
      assert_output("15\n", test_puts_expr)
    end
  end

  return qspec_main()
end
