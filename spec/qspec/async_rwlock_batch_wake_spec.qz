import * from qspec

# ============================================================================
# Async RwLock batch-wake for queued readers (Tier 3 #15a item 2)
# ============================================================================
# Before this fix, `async_rwlock_write_unlock` woke a single head waiter.
# A chain of readers queued behind a writer therefore serialized —
# only the head reader woke on write-unlock, and each subsequent reader
# waited for the previous reader's unlock (state 1→0) to trigger another
# wake. Throughput was pinned to one-reader-at-a-time.
#
# With the fix, after the popped head's frame is woken, write_unlock
# peeks the new head's mode (wait node [2] = 0 reader, 1 writer) and
# keeps popping + waking readers until the list is empty or a writer is
# at the head. Writers are never batched — they always run exclusive.
# ============================================================================

# --- Parallelism proof: N readers queued behind a writer; each reader
# tracks concurrency via an atomic counter. Without batching, only one
# reader runs at a time and the observed max concurrency is 1. With
# batching, all N readers wake together and max concurrency is N.

var g_rw = 0
var g_concurrent = 0
var g_max_concurrent = 0

def bp_reader(): Int
  async_rwlock_read(g_rw)
  var now = atomic_add(g_concurrent, 1) + 1
  # Loop-CAS on max_concurrent — racy lose-but-retry is fine for a
  # peak observation.
  var cur_max = atomic_load(g_max_concurrent)
  while now > cur_max
    if atomic_cas(g_max_concurrent, cur_max, now) == 1
      cur_max = now
    else
      cur_max = atomic_load(g_max_concurrent)
    end
  end
  # Hold the read lock long enough for the rest of the batch to acquire
  # concurrently — without a hold window, serial cascade can be hard
  # to distinguish from parallel batch because each reader decrements
  # and releases before the next is observed.
  var i = 0
  while i < 500
    sched_yield()
    i = i + 1
  end
  atomic_add(g_concurrent, -1)
  async_rwlock_read_unlock(g_rw)
  return 0
end

def bp_writer(): Int
  var v = async_rwlock_write(g_rw)
  # Hold long enough for all 5 readers to park behind us. The stagger
  # in the spawn path (100 yields × 4 gaps) places a lower bound ≈ 500
  # yields; 2000 is the empirically-tuned safety margin that keeps the
  # parallelism observation stable under scheduler jitter.
  var i = 0
  while i < 2000
    sched_yield()
    i = i + 1
  end
  async_rwlock_write_unlock(g_rw, v + 1)
  return 0
end

def test_readers_parallel_after_writer(): Int
  g_rw = async_rwlock_new(0)
  g_concurrent = atomic_new(0)
  g_max_concurrent = atomic_new(0)
  sched_init(6)
  var hw = go bp_writer()
  # Let the writer acquire before any readers arrive.
  var i = 0
  while i < 30
    sched_yield()
    i = i + 1
  end
  # Stagger readers with yields between spawns so each definitely
  # observes state=-1 and parks before the next arrives. Without these
  # pauses, a later reader can fast-path past a freshly-woken earlier
  # reader while others are still parked, which inflates max-concurrent
  # without actually exercising batch-wake.
  var h1 = go bp_reader()
  i = 0
  while i < 100
    sched_yield()
    i = i + 1
  end
  var h2 = go bp_reader()
  i = 0
  while i < 100
    sched_yield()
    i = i + 1
  end
  var h3 = go bp_reader()
  i = 0
  while i < 100
    sched_yield()
    i = i + 1
  end
  var h4 = go bp_reader()
  i = 0
  while i < 100
    sched_yield()
    i = i + 1
  end
  var h5 = go bp_reader()
  await hw
  await h1
  await h2
  await h3
  await h4
  await h5
  sched_shutdown()
  var mx = atomic_load(g_max_concurrent)
  async_rwlock_free(g_rw)
  return mx
end

# --- Regression: writer → N readers after unlock (writer never queued
# with readers; readers acquire fast-path). Ensures the batch-wake path
# doesn't break the trivial "writer released, then readers" case.

var g_rw2 = 0
var g_sum2 = 0

def cv_reader(): Int
  var v = async_rwlock_read(g_rw2)
  atomic_add(g_sum2, v)
  async_rwlock_read_unlock(g_rw2)
  return 0
end

def cv_writer(): Int
  var v = async_rwlock_write(g_rw2)
  async_rwlock_write_unlock(g_rw2, v + 100)
  return 0
end

def test_writer_then_readers(): Int
  g_rw2 = async_rwlock_new(0)
  g_sum2 = atomic_new(0)
  sched_init(4)
  var hw = go cv_writer()
  await hw
  var h1 = go cv_reader()
  var h2 = go cv_reader()
  var h3 = go cv_reader()
  var h4 = go cv_reader()
  await h1
  await h2
  await h3
  await h4
  sched_shutdown()
  var r = atomic_load(g_sum2)
  async_rwlock_free(g_rw2)
  return r
end

# --- Regression: correctness of queued-reader batch. All readers must
# see the same post-unlock value (no "some read stale value" failure).

var g_rw3 = 0
var g_acc3 = 0

def cs_reader(): Int
  var v = async_rwlock_read(g_rw3)
  atomic_add(g_acc3, v)
  async_rwlock_read_unlock(g_rw3)
  return 0
end

def cs_writer(): Int
  var v = async_rwlock_write(g_rw3)
  var i = 0
  while i < 200
    sched_yield()
    i = i + 1
  end
  async_rwlock_write_unlock(g_rw3, v + 11)
  return 0
end

def test_queued_readers_value_correctness(): Int
  g_rw3 = async_rwlock_new(0)
  g_acc3 = atomic_new(0)
  sched_init(4)
  var hw = go cs_writer()
  var i = 0
  while i < 30
    sched_yield()
    i = i + 1
  end
  var h1 = go cs_reader()
  var h2 = go cs_reader()
  var h3 = go cs_reader()
  var h4 = go cs_reader()
  var h5 = go cs_reader()
  await hw
  await h1
  await h2
  await h3
  await h4
  await h5
  sched_shutdown()
  var r = atomic_load(g_acc3)
  async_rwlock_free(g_rw3)
  return r
end

def main(): Int
  describe("async_rwlock batch-wake") do ->
    it("queued readers run in parallel after write-unlock") do ->
      # Empirical over 50 runs: pre-fix (single wake per write_unlock)
      # shows max ≤ 3 every time; post-fix (batch-wake) shows max ≥ 4
      # every time. Floor of 4 is a clean discriminator — any future
      # regression that re-serializes reader wakes fails this 100%.
      var mx = test_readers_parallel_after_writer()
      assert_eq(mx >= 4, true)
    end

    it("5 queued readers all see post-unlock value (5 * 11 = 55)") do ->
      assert_eq(test_queued_readers_value_correctness(), 55)
    end

    it("writer then 4 fresh readers: all acquire fast-path") do ->
      assert_eq(test_writer_then_readers(), 400)
    end
  end

  return qspec_main()
end
