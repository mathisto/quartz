## Cross-Feature: Generics × Closures (TEST.2 Phase 3)
##
## Contract: Interactions between generic functions and closures.
##   1. Generic function taking closure parameter.
##   2. Closure capturing values.
##   3. Pipeline with generic functions.
##   4. Higher-order patterns.

import * from qspec

def main(): Int
  # ==========================================================================
  # Generic Function with Closure Parameter
  # ==========================================================================
  describe("generic function with closure parameter") do ->
    it("apply takes function and argument") do ->
      assert_eq(gc_apply(gc_double, 21), 42)
    end

    it("apply works with lambda") do ->
      assert_eq(gc_apply(x -> x + 10, 32), 42)
    end

    it("apply with identity function") do ->
      assert_eq(gc_apply(x -> x, 99), 99)
    end
  end

  # ==========================================================================
  # Closure Capturing Values
  # ==========================================================================
  describe("closure capturing values") do ->
    it("closure captures outer variable and applies") do ->
      offset = 100
      f = x -> x + offset
      assert_eq(gc_apply(f, 42), 142)
    end

    it("closure factory creates specialized closures") do ->
      add5 = gc_adder(5)
      add10 = gc_adder(10)
      assert_eq(add5(7), 12)
      assert_eq(add10(7), 17)
    end

    it("nested closure captures") do ->
      base = 10
      f = x -> x + base
      g = y -> f(y) * 2
      assert_eq(g(5), 30)
    end
  end

  # ==========================================================================
  # Pipeline with Functions
  # ==========================================================================
  describe("pipeline with functions") do ->
    it("chaining function applications") do ->
      result = gc_apply(gc_double, gc_apply(gc_increment, 20))
      assert_eq(result, 42)
    end

    it("composing closures") do ->
      f = gc_compose(gc_double, gc_increment)
      assert_eq(f(20), 42)
    end
  end

  # ==========================================================================
  # Higher-Order Patterns
  # ==========================================================================
  describe("higher-order patterns") do ->
    it("map-like operation on values") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var result = gc_map_vec(v, gc_square)
      assert_eq(result[0], 1)
      assert_eq(result[1], 4)
      assert_eq(result[2], 9)
    end

    it("filter-like operation") do ->
      var v = vec_new()
      for i in 0..10
        v.push(i)
      end
      var evens = gc_filter_vec(v, gc_is_even)
      assert_eq(evens.size, 5)
      assert_eq(evens[0], 0)
      assert_eq(evens[4], 8)
    end
  end

  return qspec_main()
end

# --- Helpers ---

def gc_double(x: Int): Int = x * 2
def gc_increment(x: Int): Int = x + 1
def gc_square(x: Int): Int = x * x
def gc_is_even(x: Int): Int
  if x % 2 == 0
    return 1
  end
  return 0
end

def gc_apply(f: Fn(Int): Int, x: Int): Int = f(x)

def gc_adder(n: Int): Fn(Int): Int = x -> x + n

def gc_compose(f: Fn(Int): Int, g: Fn(Int): Int): Fn(Int): Int
  return x -> f(g(x))
end

def gc_map_vec(v: Vec, f: Fn(Int): Int): Vec
  var result = vec_new()
  for i in 0..v.size
    result.push(f(v[i]))
  end
  return result
end

def gc_filter_vec(v: Vec, pred: Fn(Int): Int): Vec
  var result = vec_new()
  for i in 0..v.size
    if pred(v[i]) != 0
      result.push(v[i])
    end
  end
  return result
end
