## Queue Tests
##
## Contract:
##   1. New: `queue_new` creates empty queue with size 0.
##   2. FIFO: dequeue returns elements in enqueue order.
##   3. Empty dequeue: dequeuing empty queue returns None.
##   4. Peek: returns front without removing, size unchanged.
##   5. Empty peek: peeking empty queue returns None.
##   6. Compaction: compacts internal buffer after many dequeues.
##   7. Size: size increments after each enqueue.
##   8. Re-enqueue: enqueue after dequeue tracks correctly.
import * from qspec
import * from collections/queue

def main(): Int
  describe("queue_new") do ->
    it("creates an empty queue") do ->
      var q = queue_new()
      assert_eq(q.size(), 0)
      assert_eq(q.is_empty(), 1)
      q.free()
    end
  end

  describe("enqueue and dequeue") do ->
    it("dequeues in FIFO order") do ->
      assert_eq(queue_fifo(), 1)
    end

    it("returns None when dequeuing empty queue") do ->
      var q = queue_new()
      assert(q.dequeue().none?)
      q.free()
    end
  end

  describe("peek") do ->
    it("returns front without removing") do ->
      assert_eq(queue_peek_test(), 1)
    end

    it("returns None on empty queue") do ->
      var q = queue_new()
      assert(q.peek().none?)
      q.free()
    end
  end

  describe("compaction") do ->
    it("compacts after many dequeues") do ->
      assert_eq(queue_compact_test(), 1)
    end
  end

  describe("size tracking") do ->
    it("size increments after each enqueue") do ->
      var q = queue_new()
      assert_eq(q.size(), 0)
      q.enqueue(1)
      assert_eq(q.size(), 1)
      q.enqueue(2)
      assert_eq(q.size(), 2)
      q.free()
    end

    it("enqueue after dequeue tracks size") do ->
      var q = queue_new()
      q.enqueue(10)
      q.enqueue(20)
      q.dequeue()
      assert_eq(q.size(), 1)
      q.enqueue(30)
      assert_eq(q.size(), 2)
      q.free()
    end
  end

  return qspec_main()
end

def queue_fifo(): Int
  var q = queue_new()
  q.enqueue(10)
  q.enqueue(20)
  q.enqueue(30)
  var a = 0
  var b = 0
  var c = 0
  match q.dequeue()
    Some(v) => a = v
    _ => return 0
  end
  match q.dequeue()
    Some(v) => b = v
    _ => return 0
  end
  match q.dequeue()
    Some(v) => c = v
    _ => return 0
  end
  q.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def queue_peek_test(): Int
  var q = queue_new()
  q.enqueue(42)
  q.enqueue(99)
  var p = 0
  match q.peek()
    Some(v) => p = v
    _ => return 0
  end
  var sz = q.size()
  q.free()
  if p == 42
    if sz == 2
      return 1
    end
  end
  return 0
end

def queue_compact_test(): Int
  var q = queue_new()
  # Enqueue several items then dequeue most of them to trigger compaction
  q.enqueue(1)
  q.enqueue(2)
  q.enqueue(3)
  q.enqueue(4)
  q.dequeue()
  q.dequeue()
  q.dequeue()
  # At this point head=3, size=1, compaction should have triggered
  var val = 0
  match q.peek()
    Some(v) => val = v
    _ => return 0
  end
  var sz = q.size()
  q.free()
  if val == 4
    if sz == 1
      return 1
    end
  end
  return 0
end
