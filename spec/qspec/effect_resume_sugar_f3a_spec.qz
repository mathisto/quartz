## Effect `resume(v)` sugar — Milestone F.3a acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone F (chunk F.3a).
##
## F.2 shipped the kind=2 classifier; F.3a gives `resume(v)` semantics.
## Scope: tail-resume only — `resume(v)` lowers to `return v` from the
## enclosing function (typically a user handler). Per memo §2.2 this is
## the "function kind" fast path: the op call site receives `v` via
## D.5b's handler-return ABI. Non-tail resume (continuation reification
## via state-machine CPS) is F.3c.
##
## The check: a user handler that uses `resume(v)` instead of `return v`
## must produce identical behavior to the D.5b baseline. `resume` is
## parsed as a plain identifier-call; typecheck short-circuits it to
## TYPE_NEVER, MIR lowers it to a terminator return.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect resume(v) sugar (piezo F.3a)") do ->
    it("handler using resume(v) returns v to the op call site") do ->
      assert_run_stdout_eq("""
effect Double
  def dbl(x: Int): Int
end

def my_dbl(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) * 2)
end

def main(): Int
  with Double { dbl: my_dbl } do ->
    var r = dbl(21)
    puts(str_from_int(r))
  end
  return 0
end
""", "42\n")
    end

    it("resume(v) is equivalent to return v in tail position") do ->
      # Two handlers, one uses return, one uses resume. Same output.
      assert_run_stdout_eq("""
effect Echo
  def echo(x: Int): Int
end

def h_return(op_name: Int, argc: Int, argv: Int): Int
  return load(argv, 0) + 1
end

def h_resume(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with Echo { echo: h_return } do ->
    puts(str_from_int(echo(10)))
  end
  with Echo { echo: h_resume } do ->
    puts(str_from_int(echo(10)))
  end
  return 0
end
""", "11\n11\n")
    end

    it("IR emits a ret terminator at the resume call site") do ->
      # The MIR_RETURN from F.3a must reach codegen as an `ret i64`
      # in the handler function, not as a call to @resume.
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 100)
end

def main(): Int
  with E { op: h } do ->
    op(1)
  end
  return 0
end
""", "ret i64")
    end

    it("IR does NOT call a function named @resume") do ->
      # F.3a's correctness hinge: `resume` must NOT lower to a direct
      # call instruction. If this assertion ever trips, we regressed
      # into treating resume as an undefined ordinary function.
      assert_ir_not_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "@resume(")
    end

    it("resume inside a nested if branch still returns from handler") do ->
      # Even a non-tail AST position (resume under if) compiles as
      # early return. This is F.3a's intentional simplification —
      # F.3c will add real continuation semantics.
      assert_run_stdout_eq("""
effect Classify
  def classify(n: Int): Int
end

def classifier(op_name: Int, argc: Int, argv: Int): Int
  if load(argv, 0) > 0
    resume(1)
  end
  if load(argv, 0) < 0
    resume(0 - 1)
  end
  resume(0)
end

def main(): Int
  with Classify { classify: classifier } do ->
    puts(str_from_int(classify(10)))
    puts(str_from_int(classify(0 - 5)))
    puts(str_from_int(classify(0)))
  end
  return 0
end
""", "1\n-1\n0\n")
    end

    it("resume(v) carries a String value through the arg slot") do ->
      assert_run_stdout_eq("""
effect Wrap
  def wrap(s: String): String
end

def my_wrap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  var wrapped = "[" + s + "]"
  resume(wrapped)
end

def main(): Int
  with Wrap { wrap: my_wrap } do ->
    var r = wrap("hi")
    puts(as_string(r))
  end
  return 0
end
""", "[hi]\n")
    end
  end
  return qspec_main()
end
