## Duration + ISO-8601 + HTTP-Date tests (backlog B3 / roadmap R6.1 scoped).
##
## Covers:
##   - Duration constructors / accessors / arithmetic / comparisons
##   - ISO-8601 parse of valid forms (with and without trailing 'Z') + errors
##   - HTTP-Date (RFC 7231 IMF-fixdate) parse of a valid date + errors
##   - Round-trip formatting (format_iso8601 / format_http_date)
##
## Booleans and Option<Int> results are folded to Int via named helpers so
## they can be checked with assert_eq (the qspec Int matcher). String
## round-trips use assert_eq_str.

import * from qspec
import time

# ---------------------------------------------------------------------------
# Helpers: fold Option<Int> to Int (-1 sentinel for None) and Bool to Int.
# ---------------------------------------------------------------------------

def opt_or_neg1(o: Option<Int>): Int
  match o
    Option::Some(v) => return v
    Option::None => return -1
  end
end

def b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def main(): Int
  describe("Duration constructors and accessors") do ->
    it("from_secs and to_millis") do ->
      assert_eq(duration_to_millis(duration_from_secs(3)), 3000)
    end

    it("from_millis and to_nanos") do ->
      assert_eq(duration_to_nanos(duration_from_millis(2)), 2000000)
    end

    it("from_minutes and to_secs") do ->
      assert_eq(duration_to_secs(duration_from_minutes(2)), 120)
    end

    it("from_hours and to_minutes") do ->
      assert_eq(duration_to_minutes(duration_from_hours(3)), 180)
    end

    it("from_nanos round-trips through to_nanos") do ->
      assert_eq(duration_to_nanos(duration_from_nanos(42)), 42)
    end

    it("as_millis UFCS accessor") do ->
      var d = duration_from_secs(5)
      assert_eq(d.as_millis, 5000)
    end

    it("as_secs UFCS accessor") do ->
      var d = duration_from_hours(1)
      assert_eq(d.as_secs, 3600)
    end

    it("as_hours UFCS accessor") do ->
      var d = duration_from_minutes(150)
      assert_eq(d.as_hours, 2)
    end
  end

  describe("Duration arithmetic") do ->
    it("add") do ->
      var sum = duration_add(duration_from_secs(1), duration_from_millis(500))
      assert_eq(duration_to_millis(sum), 1500)
    end

    it("sub") do ->
      var diff = duration_sub(duration_from_secs(2), duration_from_millis(250))
      assert_eq(duration_to_millis(diff), 1750)
    end

    it("mul scales the span") do ->
      var scaled = duration_mul(duration_from_millis(3), 4)
      assert_eq(duration_to_millis(scaled), 12)
    end

    it("is_zero on zero duration") do ->
      assert_eq(b2i(duration_is_zero(duration_zero())), 1)
    end

    it("is_zero on nonzero duration") do ->
      assert_eq(b2i(duration_is_zero(duration_from_nanos(1))), 0)
    end
  end

  describe("Duration comparisons") do ->
    it("eq") do ->
      assert_eq(b2i(duration_eq(duration_from_secs(1), duration_from_millis(1000))), 1)
    end

    it("lt") do ->
      assert_eq(b2i(duration_lt(duration_from_secs(1), duration_from_secs(2))), 1)
    end

    it("lt is false when greater") do ->
      assert_eq(b2i(duration_lt(duration_from_secs(3), duration_from_secs(2))), 0)
    end

    it("le boundary (equal)") do ->
      assert_eq(b2i(duration_le(duration_from_secs(2), duration_from_secs(2))), 1)
    end

    it("gt") do ->
      assert_eq(b2i(duration_gt(duration_from_secs(3), duration_from_secs(2))), 1)
    end

    it("ge boundary (equal)") do ->
      assert_eq(b2i(duration_ge(duration_from_secs(2), duration_from_secs(2))), 1)
    end

    it("cmp returns -1 / 0 / 1") do ->
      assert_eq(duration_cmp(duration_from_secs(1), duration_from_secs(2)), -1)
      assert_eq(duration_cmp(duration_from_secs(2), duration_from_secs(2)), 0)
      assert_eq(duration_cmp(duration_from_secs(3), duration_from_secs(2)), 1)
    end
  end

  describe("Civil <-> epoch calendar math") do ->
    it("epoch 0 is 1970-01-01") do ->
      assert_eq(days_from_civil(1970, 1, 1), 0)
    end

    it("civil_to_epoch matches a known UTC timestamp") do ->
      # 1994-11-06 08:49:37 UTC == 784111777
      assert_eq(civil_to_epoch(1994, 11, 6, 8, 49, 37), 784111777)
    end

    it("leap day 2000-02-29 is valid") do ->
      # 951782400 seconds since the epoch (verified against system date)
      assert_eq(civil_to_epoch(2000, 2, 29, 0, 0, 0), 951782400)
    end

    it("days_from_civil is negative before the epoch") do ->
      assert_eq(days_from_civil(1969, 12, 31), -1)
    end
  end

  describe("ISO-8601 parsing") do ->
    it("parses YYYY-MM-DDTHH:MM:SSZ") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1994-11-06T08:49:37Z")), 784111777)
    end

    it("parses without trailing Z") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1994-11-06T08:49:37")), 784111777)
    end

    it("accepts lowercase t separator") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1970-01-01t00:00:00Z")), 0)
    end

    it("parses a valid leap day") do ->
      assert_eq(opt_or_neg1(parse_iso8601("2000-02-29T00:00:00Z")), 951782400)
    end

    it("rejects Feb 29 in a non-leap year (None)") do ->
      assert_eq(opt_or_neg1(parse_iso8601("2001-02-29T00:00:00Z")), -1)
    end

    it("rejects a bad separator (None)") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1994-11-06 08:49:37")), -1)
    end

    it("rejects an out-of-range month (None)") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1994-13-06T08:49:37Z")), -1)
    end

    it("rejects a too-short string (None)") do ->
      assert_eq(opt_or_neg1(parse_iso8601("1994-11-06")), -1)
    end

    it("rejects non-digit fields (None)") do ->
      assert_eq(opt_or_neg1(parse_iso8601("19x4-11-06T08:49:37Z")), -1)
    end
  end

  describe("ISO-8601 formatting round-trip") do ->
    it("formats epoch 0") do ->
      assert_eq_str(format_iso8601(0), "1970-01-01T00:00:00Z")
    end

    it("formats a known timestamp") do ->
      assert_eq_str(format_iso8601(784111777), "1994-11-06T08:49:37Z")
    end

    it("round-trips parse . format") do ->
      var e = opt_or_neg1(parse_iso8601("2023-06-15T12:34:56Z"))
      assert_eq_str(format_iso8601(e), "2023-06-15T12:34:56Z")
    end
  end

  describe("HTTP-Date (RFC 7231 IMF-fixdate) parsing") do ->
    it("parses a valid IMF-fixdate") do ->
      assert_eq(opt_or_neg1(parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT")), 784111777)
    end

    it("rejects a bad month name (None)") do ->
      assert_eq(opt_or_neg1(parse_http_date("Sun, 06 Xyz 1994 08:49:37 GMT")), -1)
    end

    it("rejects a non-GMT zone (None)") do ->
      assert_eq(opt_or_neg1(parse_http_date("Sun, 06 Nov 1994 08:49:37 UTC")), -1)
    end

    it("rejects the wrong length (None)") do ->
      assert_eq(opt_or_neg1(parse_http_date("Sun, 6 Nov 1994 08:49:37 GMT")), -1)
    end

    it("rejects a non-digit day field (None)") do ->
      assert_eq(opt_or_neg1(parse_http_date("Sun, xx Nov 1994 08:49:37 GMT")), -1)
    end
  end

  describe("HTTP-Date formatting round-trip") do ->
    it("formats a known epoch with correct weekday") do ->
      assert_eq_str(format_http_date(784111777), "Sun, 06 Nov 1994 08:49:37 GMT")
    end

    it("formats epoch 0 (Thursday)") do ->
      assert_eq_str(format_http_date(0), "Thu, 01 Jan 1970 00:00:00 GMT")
    end

    it("round-trips parse . format") do ->
      var e = opt_or_neg1(parse_http_date("Fri, 15 Aug 2025 23:59:59 GMT"))
      assert_eq_str(format_http_date(e), "Fri, 15 Aug 2025 23:59:59 GMT")
    end
  end

  return qspec_main()
end
