## Cross Platform Stdlib Tests
##
## Contract:
##   1. Cross-Platform Stdlib.
##   2. Socket constants.
##   3. Platform detection.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Cross-Platform Stdlib") do ->
    describe("socket constants") do ->
      it("emits macOS SOL_SOCKET value on macOS target") do ->
        var flags = "--target aarch64-apple-macosx"
        var src = """
          @cfg(os: "macos")
          def SOL_SOCKET(): Int = 0xFFFF

          @cfg(os: "linux")
          def SOL_SOCKET(): Int = 1

          def main(): Int = SOL_SOCKET()
        """
        assert_ir_contains_with_flags(src, "65535", flags)
      end

      it("emits Linux SOL_SOCKET value with linux target") do ->
        var flags = "--target x86_64-unknown-linux-gnu"
        var src = """
          @cfg(os: "macos")
          def SOL_SOCKET(): Int = 0xFFFF

          @cfg(os: "linux")
          def SOL_SOCKET(): Int = 1

          def main(): Int = SOL_SOCKET()
        """
        assert_ir_contains_with_flags(src, "add i64 0, 1", flags)
      end
    end

    describe("platform detection") do ->
      it("macos target selects macos cfg") do ->
        var flags = "--target aarch64-apple-macosx"
        var src = """
          @cfg(os: "macos")
          def get_os(): Int = 1

          @cfg(os: "linux")
          def get_os(): Int = 2

          def main(): Int = get_os()
        """
        assert_ir_contains_with_flags(src, "add i64 0, 1", flags)
      end

      it("linux target selects linux cfg") do ->
        var flags = "--target x86_64-unknown-linux-gnu"
        var src = """
          @cfg(os: "macos")
          def get_os(): Int = 1

          @cfg(os: "linux")
          def get_os(): Int = 2

          def main(): Int = get_os()
        """
        assert_ir_contains_with_flags(src, "add i64 0, 2", flags)
      end
    end
  end

  return qspec_main()
end
