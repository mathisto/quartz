## Phase 4D.4d — For-in row widening via Stream<T, body_row> static type.
##
## Verifies that `for v in src` widens the caller's effect row by the
## iter source's body_row when src's static type is a synthesized
## Stream<T, body_row> ptype. Type-driven analog of F.3c at the for-in
## site: F.3c (typecheck_walk.qz:3411) handles only NODE_IDENT iter
## sources via annotation-string prefix scan ("impl AsyncIterator<");
## 4D.4d uses tc_expr's resolved type, so it covers ALL iter source
## kinds — NODE_IDENT (var bound to a generator call), NODE_CALL (direct
## generator call as the iter), and any other expression that resolves
## to a Stream ptype.
##
## What this pins down:
##
##   1. Pure sync `def gen(): impl Iterator<Int>` carries body_row=-1; a
##      pure caller's for-in widens by nothing (no `can` widening; no
##      QZ0610). Identical to pre-4D.4d behavior.
##   2. Row-poly `def gen(): impl Iterator<Int> can Async` consumed via
##      NODE_IDENT (`var s = my_async(); for v in s`) widens caller by
##      Async; a `can Async` caller compiles cleanly.
##   3. Same row-poly source consumed via NODE_IDENT from a caller with
##      an UNRELATED `can` row (e.g. `can Throws`) emits QZ0610. F.3c's
##      string-scan fallback ALSO catches this case via NODE_IDENT, so
##      the test verifies behavior parity rather than exclusive coverage.
##   4. Same row-poly source consumed via NODE_CALL (`for v in my_async()`)
##      widens caller by Async — this is the case F.3c MISSED (its scan
##      was NODE_IDENT-only). The 4D.4d type-driven path catches it.
##   5. NODE_CALL form from caller with an unrelated `can` emits QZ0610
##      via the same type-driven path.
##   6. Explicit `def gen(): impl AsyncIterator<Int>` consumed via
##      for-in produces the same widening through the implicit-Async
##      fallback in 4D.4b synthesis. Symmetric with row-poly form.
##   7. Sync gen consumed via for-in from a caller with a tracked row
##      (e.g. `can Throws`) does NOT emit QZ0610 (sync's body_row=-1
##      means no labels to propagate).
##
## Out of scope (deferred):
##
##   - Parameter Stream<T, e> coverage. Today only var bindings + call
##     results pick up the synthesized ptype; param annotations parse
##     via tc_parse_type which returns bare TYPE_STRUCT for
##     "Stream<T, e>" annotations and "impl AsyncIterator<T>". The F.3c
##     block (which scans the annotation string) is what covers the
##     param case for now and is intentionally NOT deleted in this
##     phase. Filed as 4D.4d follow-on.
##   - F.3c block deletion. Deletion is gated on parameter coverage.
##     This phase only ADDS the type-driven widening; it does not
##     remove the F.3c fallback.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.4d — for-in row widening via Stream<T, body_row> static type") do ->
    it("sync gen for-in from pure caller — no widening, no QZ0610") do ->
      assert_compile_succeeds("""
def three(): impl Iterator<Int>
  yield 1
  yield 2
  yield 3
end

def main(): Int
  var sum = 0
  for v in three()
    sum += v
  end
  return 0
end
""")
    end

    it("row-poly async gen via NODE_IDENT — `can Async` caller passes") do ->
      assert_compile_succeeds("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Async
  var s = my_async()
  var sum = 0
  for v in s
    sum += v
  end
end

def main(): Int
  return 0
end
""")
    end

    it("row-poly async gen via NODE_IDENT — `can Throws` caller hits QZ0610") do ->
      assert_compile_error("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Throws
  var s = my_async()
  var sum = 0
  for v in s
    sum += v
  end
end

def main(): Int
  return 0
end
""", "QZ0610")
    end

    it("row-poly async gen via NODE_CALL — `can Async` caller passes (F.3c-missed case)") do ->
      assert_compile_succeeds("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Async
  var sum = 0
  for v in my_async()
    sum += v
  end
end

def main(): Int
  return 0
end
""")
    end

    it("row-poly async gen via NODE_CALL — `can Throws` caller hits QZ0610") do ->
      assert_compile_error("""
def my_async(): impl Iterator<Int> can Async
  yield 42
end

def caller() can Throws
  var sum = 0
  for v in my_async()
    sum += v
  end
end

def main(): Int
  return 0
end
""", "QZ0610")
    end

    it("explicit impl AsyncIterator<T> via for-in — `can Async` caller passes") do ->
      assert_compile_succeeds("""
def my_async(): impl AsyncIterator<Int>
  yield 42
end

def caller() can Async
  var s = my_async()
  var sum = 0
  for v in s
    sum += v
  end
end

def main(): Int
  return 0
end
""")
    end

    it("sync gen via for-in from `can Throws` caller — no widening, no QZ0610") do ->
      assert_compile_succeeds("""
def three(): impl Iterator<Int>
  yield 7
end

def caller() can Throws
  var sum = 0
  for v in three()
    sum += v
  end
end

def main(): Int
  return 0
end
""")
    end
  end

  return qspec_main()
end
