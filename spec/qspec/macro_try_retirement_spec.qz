## `$try` retirement regression spec (Phase 5)
##
## `$try` was promoted from a builtin macro to the `try` prefix keyword
## during Piezo Milestone A (`86e0f906`). Any leftover `$try(expr)` usage
## must now emit QZ0503 with a migration hint pointing at the keyword
## form. This spec backstops that against accidental re-introduction of
## a `$try` builtin dispatch.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("`$try` retirement (P5)") do ->
    it("emits QZ0503 on `$try(...)` usage") do ->
      assert_compile_error(mtr_try_usage_src(), "QZ0503")
    end

    it("error hint points at the prefix `try` keyword") do ->
      assert_compile_error(mtr_try_usage_src(), "prefix keyword")
    end

    it("the replacement `try expr` prefix syntax compiles") do ->
      assert_compile_succeeds(mtr_try_keyword_src())
    end
  end

  return qspec_main()
end

def mtr_try_usage_src(): String = """
def main(): Int
  var x = $try(42)
  return 0
end
"""

def mtr_try_keyword_src(): String = """
def get_val(): Option<Int>
  return Option::Some(42)
end

def unwrap_it(): Option<Int>
  var v = try get_val()
  return Option::Some(v + 1)
end

def main(): Int
  return 0
end
"""
