## Macro expansion-chain diagnostic regression spec — Tier 2 #8b-followup P2.
##
## P1.a (d7cc5b08) added the expansion-provenance schema to AstStorage +
## ast.qz. P1.b (ad3ecf31) taught macro_expand to push a record per call
## and stamp every synthesized node. P2 (this spec's feature) renders the
## parent chain as `note: in expansion of macro $X (defined at Y:L:C)`
## per level on any diagnostic whose expansion_idx is non-zero.
##
## What this guards against
## -----------------------
##
## 1. The "silent synthetic location" failure mode: a user writes
##    `$wrap(42)` and the macro body references a bogus param. Without
##    the chain, the error cites the call-site line/col with no hint
##    that the problem is INSIDE the macro definition. P2 re-anchors
##    the reader to the macro with the `defined at` breadcrumb.
##
## 2. Nested expansions. `$outer($inner(x))` where $inner expansion
##    errors should surface BOTH levels — innermost first (that's the
##    expansion whose body contains the bug) followed by its caller.
##
## 3. No false chain on top-level unknown-macro errors. `$not_a_thing()`
##    at call site should NOT render a chain, because its expansion
##    never started. The `_cur_expansion_idx == 0` early-out in
##    `_macro_emit_error` is what keeps it clean.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("macro expansion chain diagnostics") do ->
    it("renders single-level chain when expansion body errors") do ->
      assert_compile_error("""
        macro wrap(x) do
          quote do
            unquote(not_a_param) + unquote(x)
          end
        end
        def main(): Int
          return $wrap(42)
        end
        """, "in expansion of macro '$wrap'")
    end

    it("chain note cites def-site line:col") do ->
      assert_compile_error("""
        macro wrap(x) do
          quote do
            unquote(nope) + unquote(x)
          end
        end
        def main(): Int
          return $wrap(1)
        end
        """, "defined at 1:1")
    end

    it("chain note cites call-site line:col") do ->
      assert_compile_error("""
        macro wrap(x) do
          quote do
            unquote(nope) + unquote(x)
          end
        end
        def main(): Int
          return $wrap(1)
        end
        """, "called at 7:10")
    end

    it("nested expansion renders innermost macro") do ->
      assert_compile_error("""
        macro inner(q) do
          quote do
            unquote(q) * unquote(wrong)
          end
        end
        macro outer(p) do
          quote do
            unquote(p) + 99
          end
        end
        def main(): Int
          return $outer($inner(5))
        end
        """, "in expansion of macro '$inner'")
    end

    it("nested expansion also renders outer macro") do ->
      assert_compile_error("""
        macro inner(q) do
          quote do
            unquote(q) * unquote(wrong)
          end
        end
        macro outer(p) do
          quote do
            unquote(p) + 99
          end
        end
        def main(): Int
          return $outer($inner(5))
        end
        """, "in expansion of macro '$outer'")
    end

    it("top-level unknown macro has no expansion chain") do ->
      assert_compile_error("""
        def main(): Int
          return $not_a_real_macro(1)
        end
        """, "unknown macro '$not_a_real_macro'")
    end

    # P2.c — typecheck errors born from a macro expansion also carry
    # the chain now. The migration is opt-in per site (big surface area),
    # but the "Undefined function" path in tc_expr_call is wired so any
    # macro body calling a missing function gets its chain rendered.
    it("tc undefined-function error inside expansion renders chain") do ->
      assert_compile_error("""
        macro call_missing() do
          quote do
            no_such_function(42)
          end
        end
        def main(): Int
          return $call_missing()
        end
        """, "in expansion of macro '$call_missing'")
    end
  end
  return qspec_main()
end
