## Standard Library: Time Tests
## Comprehensive tests for calendar arithmetic
##
## Contract:
##   1. Time_epoch.
##   2. Time_elapsed.
##   3. Is_leap_year.
##   4. Days_in_month.
##   5. Days_in_year.
##   6. Epoch_to_year.
##   7. Epoch_to_month.
##   8. Epoch_to_day.
##   9. Epoch_to_hour/minute/second.
##   10. Day_of_week.
##   11. Time_year.
##   12. Time_month.
##   13. Time_day.

import * from qspec
import time

def main(): Int
  describe("time_epoch") do ->
    it("returns positive value") do ->
      var now = time_epoch()
      assert(now > 0)
    end

    it("returns reasonable epoch value") do ->
      # After 2024-01-01 = 1704067200
      var now = time_epoch()
      assert(now > 1704067200)
    end

    it("time is monotonically increasing") do ->
      var t1 = time_epoch()
      var t2 = time_epoch()
      assert(t2 >= t1)
    end
  end

  describe("time_elapsed") do ->
    it("computes non-negative elapsed time") do ->
      var start = time_epoch()
      var stop = time_epoch()
      assert(time_elapsed(start, stop) >= 0)
    end
  end

  describe("is_leap_year") do ->
    it("2000 is a leap year (div by 400)") do ->
      assert(is_leap_year(2000))
    end

    it("1900 is NOT a leap year (div by 100 but not 400)") do ->
      assert(is_leap_year(1900) == false)
    end

    it("2024 is a leap year (div by 4)") do ->
      assert(is_leap_year(2024))
    end

    it("2100 is NOT a leap year (div by 100)") do ->
      assert(is_leap_year(2100) == false)
    end

    it("2023 is NOT a leap year") do ->
      assert(is_leap_year(2023) == false)
    end

    it("1600 is a leap year (div by 400)") do ->
      assert(is_leap_year(1600))
    end

    it("1970 is NOT a leap year") do ->
      assert(is_leap_year(1970) == false)
    end
  end

  describe("days_in_month") do ->
    it("January has 31 days") do ->
      assert_eq(days_in_month(1, 2024), 31)
    end

    it("February has 28 days in non-leap year") do ->
      assert_eq(days_in_month(2, 2023), 28)
    end

    it("February has 29 days in leap year") do ->
      assert_eq(days_in_month(2, 2024), 29)
    end

    it("April has 30 days") do ->
      assert_eq(days_in_month(4, 2024), 30)
    end

    it("December has 31 days") do ->
      assert_eq(days_in_month(12, 2024), 31)
    end
  end

  describe("days_in_year") do ->
    it("leap year has 366 days") do ->
      assert_eq(days_in_year(2024), 366)
    end

    it("non-leap year has 365 days") do ->
      assert_eq(days_in_year(2023), 365)
    end
  end

  describe("epoch_to_year") do ->
    it("epoch 0 = 1970") do ->
      assert_eq(epoch_to_year(0), 1970)
    end

    it("last second of 1970") do ->
      # 1970 has 365 days = 31536000 seconds
      assert_eq(epoch_to_year(31535999), 1970)
    end

    it("first second of 1971") do ->
      assert_eq(epoch_to_year(31536000), 1971)
    end

    it("Y2K: 946684800 = 2000") do ->
      assert_eq(epoch_to_year(946684800), 2000)
    end

    it("2001-09-09: 1000000000 = 2001") do ->
      assert_eq(epoch_to_year(1000000000), 2001)
    end
  end

  describe("epoch_to_month") do ->
    it("epoch 0 = January") do ->
      assert_eq(epoch_to_month(0), 1)
    end

    it("Feb 1, 1970: day 31 = February") do ->
      # 31 days * 86400 = 2678400
      assert_eq(epoch_to_month(2678400), 2)
    end

    it("Y2K: 946684800 = January") do ->
      assert_eq(epoch_to_month(946684800), 1)
    end

    it("1000000000 = September") do ->
      assert_eq(epoch_to_month(1000000000), 9)
    end
  end

  describe("epoch_to_day") do ->
    it("epoch 0 = day 1") do ->
      assert_eq(epoch_to_day(0), 1)
    end

    it("epoch 86399 = still day 1") do ->
      assert_eq(epoch_to_day(86399), 1)
    end

    it("epoch 86400 = day 2") do ->
      assert_eq(epoch_to_day(86400), 2)
    end

    it("Y2K: 946684800 = day 1") do ->
      assert_eq(epoch_to_day(946684800), 1)
    end

    it("1000000000 = September 9") do ->
      assert_eq(epoch_to_day(1000000000), 9)
    end
  end

  describe("epoch_to_hour/minute/second") do ->
    it("epoch 0 = 00:00:00") do ->
      assert_eq(epoch_to_hour(0), 0)
      assert_eq(epoch_to_minute(0), 0)
      assert_eq(epoch_to_second(0), 0)
    end

    it("epoch 3661 = 01:01:01") do ->
      assert_eq(epoch_to_hour(3661), 1)
      assert_eq(epoch_to_minute(3661), 1)
      assert_eq(epoch_to_second(3661), 1)
    end

    it("epoch 86399 = 23:59:59") do ->
      assert_eq(epoch_to_hour(86399), 23)
      assert_eq(epoch_to_minute(86399), 59)
      assert_eq(epoch_to_second(86399), 59)
    end
  end

  describe("day_of_week") do ->
    it("epoch 0 = Thursday (4)") do ->
      assert_eq(day_of_week(0), 4)
    end

    it("epoch 86400 = Friday (5)") do ->
      # 1970-01-02 is Friday
      assert_eq(day_of_week(86400), 5)
    end

    it("epoch 259200 = Sunday (0)") do ->
      # 1970-01-04 is Sunday
      assert_eq(day_of_week(259200), 0)
    end

    it("Y2K: 946684800 = Saturday (6)") do ->
      # 2000-01-01 is Saturday
      assert_eq(day_of_week(946684800), 6)
    end
  end

  describe("time_year") do ->
    it("returns a reasonable year") do ->
      var year = time_year()
      assert(year >= 2025)
      assert(year <= 2100)
    end
  end

  describe("time_month") do ->
    it("returns 1-12") do ->
      var month = time_month()
      assert(month >= 1)
      assert(month <= 12)
    end
  end

  describe("time_day") do ->
    it("returns 1-31") do ->
      var day = time_day()
      assert(day >= 1)
      assert(day <= 31)
    end
  end

  return qspec_main()
end
