## Comparisons Tests
##
## Contract:
##   1. Equality (==).
##   2. Inequality (!=).
##   3. Less than (<).
##   4. Greater than (>).
##   5. Less than or equal (<=).
##   6. Greater than or equal (>=).
##   7. Comparison with expressions.
##   8. Comparison result as value.
##   9. Chained comparisons in control flow.
##   10. Edge cases.
##   11. Comparison properties.

import * from qspec
import * from qspec/property

def main(): Int
  describe("equality (==)") do ->
    it("returns 1 when equal") do ->
      x = 42
      assert_eq(x == 42, 1)
    end

    it("returns 0 when not equal") do ->
      x = 42
      assert_eq(x == 43, 0)
    end

    it("compares variables") do ->
      a = 10
      b = 10
      assert_eq(a == b, 1)
    end

    it("compares zero") do ->
      x = 0
      assert_eq(x == 0, 1)
    end

    it("compares negative result to zero") do ->
      x = 5 - 5
      assert_eq(x == 0, 1)
    end
  end

  describe("inequality (!=)") do ->
    it("returns 1 when not equal") do ->
      assert_eq(42 != 43, 1)
    end

    it("returns 0 when equal") do ->
      assert_eq(42 != 42, 0)
    end

    it("compares variables") do ->
      a = 10
      b = 20
      assert_eq(a != b, 1)
    end
  end

  describe("less than (<)") do ->
    it("returns 1 when less") do ->
      assert_eq(5 < 10, 1)
    end

    it("returns 0 when equal") do ->
      assert_eq(10 < 10, 0)
    end

    it("returns 0 when greater") do ->
      assert_eq(15 < 10, 0)
    end

    it("works with negative conceptual values") do ->
      x = 3 - 10
      assert_eq(x < 0, 1)
    end
  end

  describe("greater than (>)") do ->
    it("returns 1 when greater") do ->
      assert_eq(10 > 5, 1)
    end

    it("returns 0 when equal") do ->
      assert_eq(10 > 10, 0)
    end

    it("returns 0 when less") do ->
      assert_eq(5 > 10, 0)
    end
  end

  describe("less than or equal (<=)") do ->
    it("returns 1 when less") do ->
      assert_eq(5 <= 10, 1)
    end

    it("returns 1 when equal") do ->
      assert_eq(10 <= 10, 1)
    end

    it("returns 0 when greater") do ->
      assert_eq(15 <= 10, 0)
    end
  end

  describe("greater than or equal (>=)") do ->
    it("returns 1 when greater") do ->
      assert_eq(10 >= 5, 1)
    end

    it("returns 1 when equal") do ->
      assert_eq(10 >= 10, 1)
    end

    it("returns 0 when less") do ->
      assert_eq(5 >= 10, 0)
    end
  end

  describe("comparison with expressions") do ->
    it("compares computed values") do ->
      assert_eq(2 + 3 == 5, 1)
    end

    it("compares function results") do ->
      assert_eq(double(5), 10)
    end

    it("compares complex expressions") do ->
      assert_eq((3 * 4) + 2 > 10 + 3, 1)
    end
  end

  describe("comparison result as value") do ->
    it("returns comparison result directly") do ->
      result = 5 < 10
      assert_eq(result, 1)
    end

    it("returns false comparison result") do ->
      result = 10 < 5
      assert_eq(result, 0)
    end

    it("uses comparison result in arithmetic") do ->
      bonus = 5 > 3
      assert_eq(41 + bonus, 42)
    end
  end

  describe("chained comparisons in control flow") do ->
    it("uses multiple comparisons with and") do ->
      x = 5
      if x > 0 and x < 10
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("uses multiple comparisons with or") do ->
      x = 15
      if x < 5 or x > 10
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("combines different comparison operators") do ->
      a = 5
      b = 5
      c = 10
      if a == b and b < c and c >= 10
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("edge cases") do ->
    it("compares max small int") do ->
      assert_eq(255 == 255, 1)
    end

    it("compares with zero result") do ->
      x = 10 - 10
      assert_eq(x == 0, 1)
    end

    it("compares results of division") do ->
      assert_eq(10 / 2 == 5, 1)
    end

    it("compares modulo results") do ->
      assert_eq(17 % 5 == 2, 1)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("comparison properties") do ->
    forall_ii("trichotomy: exactly one of <, ==, > holds") do x: Int, y: Int ->
      var lt = x < y
      var eq = x == y
      var gt = x > y
      assert_eq(lt + eq + gt, 1)
    end

    forall_i("reflexivity: x == x") do x: Int ->
      assert_eq(x == x, 1)
    end

    forall_i("irreflexivity of <: not (x < x)") do x: Int ->
      assert_eq(x < x, 0)
    end

    forall_ii("antisymmetry: x <= y and y <= x implies x == y") do x: Int, y: Int ->
      if x <= y and y <= x
        assert_eq(x == y, 1)
      else
        assert_eq(1, 1)
      end
    end
  end

  return qspec_main()
end

def double(x: Int): Int
  return x * 2
end
