## Stack Trace Tests
##
## Contract:
##   1. Compile error includes source.
##   2. Duplicate function definition is.
##   3. Error code format includes.
##   4. Error message contains file.
##   5. Error on missing end.
##   6. Error on unmatched end.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Stack Trace") do ->
    it("compile error includes source location") do ->
      assert_compile_error("""
        def main(): Int
          undefined_var
        end
      """, "error[QZ")
    end

    it("error message contains file path info") do ->
      assert_compile_error("""
        def main(): Int
          undefined_var
        end
      """, "-->")
    end

    it("undefined function error detected") do ->
      assert_compile_error("""
        def main(): Int
          return nonexistent_function()
        end
      """, "error")
    end

    it("missing return type annotation is error") do ->
      assert_compile_error("""
        def foo()
          return 0
        end
        def main(): Int
          return foo()
        end
      """, "error")
    end

    it("wrong arity error detected") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return add(1)
        end
      """, "error")
    end

    it("duplicate function definition is error") do ->
      assert_compile_error("""
        def foo(): Int = 1
        def foo(): Int = 2
        def main(): Int
          return foo()
        end
      """, "error")
    end

    it("error on unmatched end") do ->
      assert_compile_error("""
        def main(): Int
          return 0
        end
        end
      """, "error")
    end

    it("error on missing end") do ->
      assert_compile_error("""
        def main(): Int
          if true
            return 1
        end
      """, "error")
    end

    it("valid program produces no errors") do ->
      assert_compile_succeeds("""
        def main(): Int
          var x = 42
          return x
        end
      """)
    end

    it("error code format includes QZ prefix") do ->
      assert_compile_error("""
        def main(): Int
          undefined_var
        end
      """, "QZ")
    end

    it("nested function error has location") do ->
      assert_compile_error("""
        def helper(): Int
          unknown_call()
        end
        def main(): Int
          return helper()
        end
      """, "error")
    end

    it("runtime panic prints message to stderr") do ->
      assert_run_stderr_contains("""
        def main(): Int
          panic("test crash message")
          return 0
        end
      """, "test crash message")
    end
    it("panic output includes colored prefix") do ->
      assert_run_stderr_contains("""
        def main(): Int
          panic("colored test")
          return 0
        end
      """, "panic:")
    end
  end

  return qspec_main()
end

