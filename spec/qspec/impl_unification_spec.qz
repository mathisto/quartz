## Impl Unification Tests
##
## Contract:
##   1. @field: `@x` works in impl methods.
##   2. Basic: inherent impl basic method dispatches.
##   3. Endless: inherent impl endless def syntax.
##   4. Param: inherent impl method with extra param.
##   5. Multi-struct: inherent impl on different struct.
##   6. Trait compat: trait impl backward compatibility.
##   7. Computed: method returning computed @field expression.
##   8. Multi-impl: multiple impl blocks on same struct.
import * from qspec

## Test struct for inherent impl
struct IUPoint
  x: Int
  y: Int
end

## Inherent impl — methods with self injection and @field syntax
extend IUPoint
  def sum(): Int
    return @x + @y
  end

  def scale(factor: Int): Int
    return @x * factor + @y * factor
  end

  def x_val(): Int = @x
  def y_val(): Int = @y
end

## Test struct for generic inherent impl
struct IUBox
  value: Int
end

extend IUBox
  def get(): Int = @value
  def set_val(v: Int): Int
    return v
  end
end

## Test that trait impls still work (backward compat)
trait IUFormattable
  def iu_format(self): String
    return ""
  end
end

extend IUPoint with IUFormattable
  def iu_format(self): String = "point"
end

## Test struct for @field in impl with self.field fallback
struct IUCounter
  count: Int
end

extend IUCounter
  def increment(): Int = @count + 1
  def value(): Int = @count
end

def test_inherent_impl_basic(): Void
  var p = IUPoint { x: 3, y: 4 }
  assert_eq(p.sum(), 7)
end

def test_inherent_impl_with_param(): Void
  var p = IUPoint { x: 2, y: 3 }
  assert_eq(p.scale(10), 50)
end

def test_inherent_impl_endless_def(): Void
  var p = IUPoint { x: 42, y: 7 }
  assert_eq(p.x_val(), 42)
  assert_eq(p.y_val(), 7)
end

def test_inherent_impl_box(): Void
  var b = IUBox { value: 99 }
  assert_eq(b.get(), 99)
end

def test_trait_impl_still_works(): Void
  var p = IUPoint { x: 1, y: 2 }
  assert_eq_str(p.iu_format(), "point")
end

def test_at_field_in_impl(): Void
  var c = IUCounter { count: 10 }
  assert_eq(c.value(), 10)
  assert_eq(c.increment(), 11)
end

def main(): Int
  describe("impl unification") do ->
    it("inherent impl basic method") do -> test_inherent_impl_basic() end
    it("inherent impl method with extra param") do -> test_inherent_impl_with_param() end
    it("inherent impl endless def") do -> test_inherent_impl_endless_def() end
    it("inherent impl on another struct") do -> test_inherent_impl_box() end
    it("trait impl backward compat") do -> test_trait_impl_still_works() end
    it("@field works in impl methods") do -> test_at_field_in_impl() end
    it("method returning computed @field expression") do ->
      var p = IUPoint { x: 5, y: 3 }
      assert_eq(p.scale(2), 16)
    end
    it("multiple impl blocks on same struct") do ->
      var b = IUBox { value: 42 }
      assert_eq(b.get(), 42)
      assert_eq(b.set_val(99), 99)
    end
  end
  return qspec_main()
end
