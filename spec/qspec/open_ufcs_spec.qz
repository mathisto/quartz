## Open UFCS Tests
##
## Contract:
##   1. Any function f(x, ...) callable as x.f(...)
##   2. Multi-arg: x.f(y) rewrites to f(x, y)
##   3. Chaining: x.f().g() works
##   4. Struct receiver: p.describe() where describe(p: Point)
##   5. Precedence: impl methods win over free functions

import * from qspec

struct OuPoint
  x: Int
  y: Int
end

extend OuPoint
  def magnitude(self): Int = @x + @y
end

# Free functions for open UFCS
def ou_double(n: Int): Int = n * 2
def ou_add(a: Int, b: Int): Int = a + b
def ou_negate(n: Int): Int = 0 - n
def ou_describe(p: OuPoint): String = "(#{p.x}, #{p.y})"
def ou_translate(p: OuPoint, dx: Int, dy: Int): OuPoint
  return OuPoint { x: p.x + dx, y: p.y + dy }
end

# For precedence test: free function with same name as impl method
def magnitude(p: OuPoint): Int = 999

def ou_basic(): Int = 5.ou_double()
def ou_multi(): Int = 5.ou_add(3)
def ou_chain(): Int = 5.ou_double().ou_double()
def ou_neg_chain(): Int = 10.ou_negate().ou_negate()
def ou_struct(): String = OuPoint { x: 3, y: 4 }.ou_describe()
def ou_struct_multi(): Int
  p = OuPoint { x: 1, y: 2 }
  q = p.ou_translate(10, 20)
  return q.x + q.y
end
# Precedence: impl method should win over free function
def ou_precedence(): Int
  p = OuPoint { x: 3, y: 4 }
  return p.magnitude()
end

def main(): Int
  describe("open UFCS") do ->
    it("basic: x.f() rewrites to f(x)") do ->
      assert_eq(ou_basic(), 10)
    end

    it("multi-arg: x.f(y) rewrites to f(x, y)") do ->
      assert_eq(ou_multi(), 8)
    end

    it("chaining: x.f().g()") do ->
      assert_eq(ou_chain(), 20)
    end

    it("negate chain round-trips") do ->
      assert_eq(ou_neg_chain(), 10)
    end

    it("struct receiver") do ->
      assert_eq_str(ou_struct(), "(3, 4)")
    end

    it("struct with extra args") do ->
      assert_eq(ou_struct_multi(), 33)
    end

    it("impl method wins over free function") do ->
      assert_eq(ou_precedence(), 7)
    end
  end

  return qspec_main()
end
