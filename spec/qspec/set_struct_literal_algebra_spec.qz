## Set<Struct> literals + algebra value-compare (WS3)
##
## Contract:
##   1. A set LITERAL `{Point{1,2}, Point{1,2}}` collapses equal-valued value-layout
##      struct elements (routes through the field-deep @qz_map_custom_* path, not the
##      identity intmap path).
##   2. Set ALGEBRA (union/intersection/difference/is_subset) respects VALUE equality
##      for value-layout struct sets (via the @qz_set_custom_* runtime helpers).
##   3. Int-Set literals + algebra are UNCHANGED (identity == value for ints).
import * from qspec

struct Point
  x: Int
  y: Int
end

struct Vec3
  a: Int
  b: Int
  c: Int
end

def main(): Int
  describe("Set<Struct> literal + algebra value-compare") do ->
    # ---- literals collapse equal-valued struct elements ----
    it("≤16B struct literal collapses two equal-valued elements") do ->
      assert_eq(point_literal_dedup(), 1)
    end
    it("≤16B struct literal keeps three distinct elements") do ->
      assert_eq(point_literal_distinct(), 3)
    end
    it(">16B struct literal collapses equal-valued elements") do ->
      assert_eq(vec3_literal_dedup(), 1)
    end

    # ---- struct-set algebra respects value equality ----
    it("union of struct sets dedups by value") do ->
      assert_eq(point_union_size(), 3)
    end
    it("intersection of struct sets matches by value") do ->
      assert_eq(point_intersection_size(), 1)
    end
    it("difference of struct sets matches by value") do ->
      assert_eq(point_difference_size(), 1)
    end
    it("is_subset true for a value-equal subset") do ->
      assert_eq(point_is_subset_true(), 1)
    end
    it("is_subset false when an element is absent by value") do ->
      assert_eq(point_is_subset_false(), 0)
    end

    # ---- Int-Set controls (unchanged) ----
    it("Int-Set literal dedup control") do ->
      assert_eq(int_literal_dedup(), 3)
    end
    it("Int-Set union control") do ->
      assert_eq(int_union_size(), 4)
    end
    it("Int-Set intersection control") do ->
      assert_eq(int_intersection_size(), 2)
    end
  end
  return qspec_main()
end

# ---- literal dedup ----

def point_literal_dedup(): Int
  var s = {Point{x: 1, y: 2}, Point{x: 1, y: 2}}
  return set_size(s)
end

def point_literal_distinct(): Int
  var s = {Point{x: 1, y: 1}, Point{x: 2, y: 2}, Point{x: 3, y: 3}}
  return set_size(s)
end

def vec3_literal_dedup(): Int
  var s = {Vec3{a: 1, b: 2, c: 3}, Vec3{a: 1, b: 2, c: 3}}
  return set_size(s)
end

# ---- algebra ----
# `Set` is unparameterized (no `Set<T>` annotation), so the element type of an
# algebra operand can't come from a static type. It is recovered from the per-
# function side-table populated by each operand's struct `set_add`s — so the
# operands must be LOCAL sets built with set_new + add in the same function (the
# common case). Cross-function set returns aren't tracked (filed). Free-function
# form `set_union(a, b)` is used (unambiguous element-annotation dispatch).

def point_union_size(): Int
  var a = set_new()
  a.add(Point{x: 1, y: 1})
  a.add(Point{x: 2, y: 2})
  var b = set_new()
  b.add(Point{x: 2, y: 2})
  b.add(Point{x: 3, y: 3})
  var u = set_union(a, b)
  return set_size(u)
end

def point_intersection_size(): Int
  var a = set_new()
  a.add(Point{x: 1, y: 1})
  a.add(Point{x: 2, y: 2})
  var b = set_new()
  b.add(Point{x: 2, y: 2})
  b.add(Point{x: 3, y: 3})
  var i = set_intersection(a, b)
  return set_size(i)
end

def point_difference_size(): Int
  var a = set_new()
  a.add(Point{x: 1, y: 1})
  a.add(Point{x: 2, y: 2})
  var b = set_new()
  b.add(Point{x: 2, y: 2})
  b.add(Point{x: 3, y: 3})
  var d = set_difference(a, b)
  return set_size(d)
end

def point_is_subset_true(): Int
  var a = set_new()
  a.add(Point{x: 1, y: 1})
  var b = set_new()
  b.add(Point{x: 1, y: 1})
  b.add(Point{x: 2, y: 2})
  return set_is_subset(a, b)
end

def point_is_subset_false(): Int
  var a = set_new()
  a.add(Point{x: 1, y: 1})
  a.add(Point{x: 9, y: 9})
  var b = set_new()
  b.add(Point{x: 1, y: 1})
  b.add(Point{x: 2, y: 2})
  return set_is_subset(a, b)
end

# ---- Int controls ----

def int_literal_dedup(): Int
  var s = {1, 2, 2, 3}
  return set_size(s)
end

def int_union_size(): Int
  var a = {1, 2}
  var b = {2, 3, 4}
  var u = set_union(a, b)
  return set_size(u)
end

def int_intersection_size(): Int
  var a = {1, 2, 3}
  var b = {2, 3, 4}
  var i = set_intersection(a, b)
  return set_size(i)
end
