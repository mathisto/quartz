## Adversarial String Equality Test Suite
##
## Tests that == and != on strings do CONTENT comparison, not pointer comparison.
## Every test creates strings from different memory allocations that have the
## same content. Uses subprocess testing to avoid closure SIGSEGV limit.
##
## Contract:
##   1. == with str_concat.
##   2. == with str_split.
##   3. == with str_slice.
##   4. == with function returns.
##   5. == with function parameters.
##   6. == with struct fields.
##   7. == with Vec<String> elements.
##   8. != with dynamic strings.
##   9. == edge cases.
##   10. == with to_s results.
##   11. == with replace and trim.
##   12. == in compound scenarios.
##   13. == in realistic compiler scenarios.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ==========================================================================
  # Category 1: str_concat results
  # ==========================================================================

  describe("== with str_concat") do ->
    it("concat result equals identical literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_concat("hel", "lo")
          if s == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("two different concats with same content are equal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("he", "llo")
          var b = str_concat("hel", "lo")
          if a == b
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("chained concat equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_concat(str_concat("a", "b"), "c")
          if s == "abc"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("concat with empty string equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("", "hello")
          var b = str_concat("hello", "")
          var ok = 1
          if a != "hello"
            ok = 0
          end
          if b != "hello"
            ok = 0
          end
          puts(ok.to_s())
          return 0
        end
      """, "1\n")
    end
  end

  # ==========================================================================
  # Category 2: str_split results (classic bug source)
  # ==========================================================================

  describe("== with str_split") do ->
    it("split elements equal their literals") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var parts = str_split("hello,world,foo", ",")
          var ok = 1
          if parts[0] != "hello"
            ok = 0
          end
          if parts[1] != "world"
            ok = 0
          end
          if parts[2] != "foo"
            ok = 0
          end
          puts(ok.to_s())
          return 0
        end
      """, "1\n")
    end

    it("split elements compared across different splits") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_split("x,hello", ",")
          var b = str_split("y,hello", ",")
          if a[1] == b[1]
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("split element not equal to wrong literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var parts = str_split("hello,world", ",")
          if parts[0] == "world"
            puts("no")
          else
            puts("yes")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 3: str_slice results
  # ==========================================================================

  describe("== with str_slice") do ->
    it("slice equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_slice("XXhelloYY", 2, 7)
          if s == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("slice equals concat with same content") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_slice("hello world", 0, 5)
          var b = str_concat("hel", "lo")
          if a == b
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 4: Function return values
  # ==========================================================================

  describe("== with function returns") do ->
    it("function returning concat equals literal") do ->
      assert_run_stdout_eq("""
        def make_hello(): String = str_concat("hel", "lo")
        def main(): Int
          if make_hello() == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("two function calls returning same content are equal") do ->
      assert_run_stdout_eq("""
        def make_hello(): String = str_concat("hel", "lo")
        def main(): Int
          if make_hello() == make_hello()
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("conditional return values equal their literals") do ->
      assert_run_stdout_eq("""
        def pick(flag: Int): String
          if flag
            return "alpha"
          end
          return "beta"
        end
        def main(): Int
          var a = pick(1)
          var b = pick(0)
          var ok = 1
          if a != "alpha"
            ok = 0
          end
          if b != "beta"
            ok = 0
          end
          puts(ok.to_s())
          return 0
        end
      """, "1\n")
    end
  end

  # ==========================================================================
  # Category 5: Function parameters
  # ==========================================================================

  describe("== with function parameters") do ->
    it("string param compared to literal inside function") do ->
      assert_run_stdout_eq("""
        def check(s: String): Int
          if s == "hello"
            return 1
          end
          return 0
        end
        def main(): Int
          puts(check(str_concat("hel", "lo")).to_s())
          return 0
        end
      """, "1\n")
    end

    it("two string params compared to each other") do ->
      assert_run_stdout_eq("""
        def eq_check(a: String, b: String): Int
          if a == b
            return 1
          end
          return 0
        end
        def main(): Int
          var x = str_concat("hel", "lo")
          var y = str_concat("he", "llo")
          puts(eq_check(x, y).to_s())
          return 0
        end
      """, "1\n")
    end
  end

  # ==========================================================================
  # Category 6: Struct fields
  # ==========================================================================

  describe("== with struct fields") do ->
    it("struct field equals literal") do ->
      assert_run_stdout_eq("""
        struct Holder
          name: String
        end
        def main(): Int
          var h = Holder { name: str_concat("hel", "lo") }
          if h.name == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("two struct fields with same content are equal") do ->
      assert_run_stdout_eq("""
        struct Holder
          name: String
        end
        def main(): Int
          var a = Holder { name: str_concat("he", "llo") }
          var b = Holder { name: str_concat("hel", "lo") }
          if a.name == b.name
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 7: Vec elements
  # ==========================================================================

  describe("== with Vec<String> elements") do ->
    it("vec element equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var v = vec_new<String>()
          v.push(str_concat("hel", "lo"))
          if v[0] == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("vec element via function return") do ->
      assert_run_stdout_eq("""
        def head(v: Vec<String>): String = v[0]
        def main(): Int
          var v = vec_new<String>()
          v.push(str_concat("hel", "lo"))
          if head(v) == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 8: != (inequality)
  # ==========================================================================

  describe("!= with dynamic strings") do ->
    it("different dynamic strings are !=") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("hel", "lo")
          var b = str_concat("wor", "ld")
          if a != b
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("same content dynamic strings are not !=") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("hel", "lo")
          var b = str_concat("he", "llo")
          if a != b
            puts("no")
          else
            puts("yes")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 9: Edge cases
  # ==========================================================================

  describe("== edge cases") do ->
    it("empty dynamic strings are equal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("", "")
          var b = str_slice("hello", 0, 0)
          var ok = 1
          if a != ""
            ok = 0
          end
          if b != ""
            ok = 0
          end
          if a != b
            ok = 0
          end
          puts(ok.to_s())
          return 0
        end
      """, "1\n")
    end

    it("almost-equal strings differ") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("hell", "o")
          var b = str_concat("hell", "p")
          if a == b
            puts("no")
          else
            puts("yes")
          end
          return 0
        end
      """, "yes\n")
    end

    it("long equal strings") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_concat("abcdefghijklmnop", "qrstuvwxyz012345")
          var b = str_concat("abcdefghijklmnop", "qrstuvwxyz012345")
          if a == b
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("single character dynamic strings") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_slice("hello", 0, 1)
          if a == "h"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 10: to_s / str_from_int
  # ==========================================================================

  describe("== with to_s results") do ->
    it("int to_s equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = 42.to_s()
          if s == "42"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("two to_s calls with same value are equal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = 42.to_s()
          var b = 42.to_s()
          if a == b
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 11: str_replace / str_trim
  # ==========================================================================

  describe("== with replace and trim") do ->
    it("replace result equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_replace("hello", "ell", "ELL")
          if s == "hELLo"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("trim result equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_trim("  hello  ")
          if s == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end
  end

  # ==========================================================================
  # Category 12: Compound / nested scenarios
  # ==========================================================================

  describe("== in compound scenarios") do ->
    it("concat of slices equals literal") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var a = str_slice("hello world", 0, 5)
          var b = str_slice("hello world", 5, 11)
          var c = str_concat(a, b)
          if c == "hello world"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("string == in if condition controls flow correctly") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_concat("hel", "lo")
          var result = 0
          if s == "hello"
            result = 1
          end
          puts(result.to_s())
          return 0
        end
      """, "1\n")
    end

    it("string != in while loop condition works") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var s = str_concat("n", "o")
          var count = 0
          while s != "yes"
            count += 1
            if count == 1
              s = str_concat("ye", "s")
            end
          end
          puts(count.to_s())
          return 0
        end
      """, "1\n")
    end

    it("nested function calls with dynamic strings") do ->
      assert_run_stdout_eq("""
        def identity(s: String): String = s
        def make(): String = str_concat("hel", "lo")
        def main(): Int
          if identity(make()) == "hello"
            puts("yes")
          else
            puts("no")
          end
          return 0
        end
      """, "yes\n")
    end

    it("string == used as value (returns 0 or 1)") do ->
      assert_run_stdout_eq("""
        def show_bool(b: Int): Void
          if b
            puts("1")
          else
            puts("0")
          end
        end
        def main(): Int
          var a = str_concat("hel", "lo")
          var eq_val = 0
          if a == "hello"
            eq_val = 1
          end
          var ne_val = 0
          if a == "world"
            ne_val = 1
          end
          show_bool(eq_val)
          show_bool(ne_val)
          return 0
        end
      """, "1\n0\n")
    end
  end

  # ==========================================================================
  # Category 13: Realistic derive-like scenarios
  # ==========================================================================

  describe("== in realistic compiler scenarios") do ->
    it("dispatching on split elements (derive pattern)") do ->
      assert_run_stdout_eq("""
        def dispatch(name: String): String
          if name == "Eq"
            return "eq_impl"
          elsif name == "Hash"
            return "hash_impl"
          elsif name == "Show"
            return "show_impl"
          end
          return "unknown"
        end
        def main(): Int
          var traits = str_split("Eq,Hash,Show", ",")
          var i = 0
          while i < traits.size
            puts(dispatch(traits[i]))
            i += 1
          end
          return 0
        end
      """, "eq_impl\nhash_impl\nshow_impl\n")
    end

    it("Map key lookup with dynamic string") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var m = map_new<String, Int>()
          m.set("hello", 42)
          var key = str_concat("hel", "lo")
          if key == "hello"
            puts("key matches")
          else
            puts("key fails")
          end
          return 0
        end
      """, "key matches\n")
    end
  end

  return qspec_main()
end
