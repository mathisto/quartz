## HB-DOG.10 — user identifiers must not collide with codegen-internal
## SSA register namespaces.
##
## Codegen names a function's incoming parameters positionally —
## `%p0`, `%p1`, … — and its SSA temporaries `%v0`, `%v1`, …. A user
## variable or parameter spelled `p<digits>` / `v<digits>` would emit
## an `alloca` of the same name and collide ("multiple definition of
## local value named 'p1'" at `llc`). `cg_sanitize_var_name` mangles
## both with a `_u.` prefix the codegen never generates itself.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("HB-DOG.10 — pN parameter / positional-register collision") do ->

    it("two parameters named p1/p2 compile and run") do ->
      assert_run_exits("""
        def files_equal(p1: String, p2: String): Bool
          return p1 == p2
        end
        def main(): Int
          return 0 if files_equal("a", "a")
          return 1
        end
        """, 0)
    end

    it("a parameter named p0 carries its value correctly") do ->
      assert_run_exits("""
        def take_first(p0: Int, p1: Int): Int = p0
        def main(): Int = take_first(7, 9) - 7
        """, 0)
    end

    it("a local variable named p1 does not collide with a param") do ->
      assert_run_exits("""
        def add_one(p0: Int): Int
          var p1 = p0 + 1
          return p1
        end
        def main(): Int = add_one(40) - 41
        """, 0)
    end

  end

  describe("the existing v<digits> mangle still holds") do ->
    it("a parameter named v0 compiles and runs") do ->
      assert_run_exits("""
        def echo(v0: Int): Int = v0
        def main(): Int = echo(0)
        """, 0)
    end
  end

  return qspec_main()
end
