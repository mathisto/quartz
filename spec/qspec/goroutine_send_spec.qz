## A.5c — Goroutine Send check regression spec (QZ1409 + QZ1301 cohesion).
##
## A.5c Phase 1 (`typecheck_capture.qz` walker fix, 2026-05-02): the
## `tc_collect_captures_walk` NODE_LET branch read its init handle from
## the wrong AST slot (right vs. left), so QZ1301 silently passed for
## the most common shape `var q = captured_thing`. Pre-fix, only bare
## expressions like `(-> { p })` triggered the check.
##
## A.5c Phase 2 (QZ1409 in `typecheck_concurrency.qz`, same date): direct
## arguments to `go fn(args)` where the callee is a named top-level
## function were never Send-checked. QZ1409 closes that hole — each
## identifier-typed argument is checked against `tc_type_is_send`.
##
## Together these close the goroutine-spawn Send surface: lambda
## captures (QZ1301), closure-variable callees (QZ1302), and direct
## arguments (QZ1409).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("A.5c — goroutine Send check") do ->

    it("QZ1409: direct CPtr arg crosses spawn boundary") do ->
      assert_compile_error("""
extern "C" def malloc(size: Int): CPtr
def use_ptr(p: CPtr): Int = 0

def main(): Int
  var p: CPtr = malloc(64)
  go use_ptr(p)
  return 0
end
""", "QZ1409")
    end

    it("Phase 1: QZ1301 fires on lambda var-binding capture (was silently passing)") do ->
      assert_compile_error("""
extern "C" def malloc(size: Int): CPtr

def main(): Int
  var p: CPtr = malloc(64)
  go (-> {
    var q = p
    return 0
  })()
  return 0
end
""", "QZ1301")
    end

    it("QZ1301 still fires on bare-expr lambda capture (regression of Phase 1 fix)") do ->
      assert_compile_error("""
extern "C" def malloc(size: Int): CPtr

def main(): Int
  var p: CPtr = malloc(64)
  go (-> { p })()
  return 0
end
""", "QZ1301")
    end

    it("QZ1409: passing CPtr-bearing struct as arg fires Send error") do ->
      assert_compile_error("""
struct Holder
  raw: CPtr
end
extern "C" def malloc(size: Int): CPtr

def use_holder(h: Holder): Int = 0

def main(): Int
  var h = Holder { raw: malloc(64) }
  go use_holder(h)
  return 0
end
""", "QZ1409")
    end

    it("Send pass: Int / Vec<Int> / String args compile clean") do ->
      assert_compile_succeeds("""
def use_int(x: Int): Int = x * 2
def use_vec(v: Vec<Int>): Int = v.size
def use_str(s: String): Int = s.size

def main(): Int
  var v = vec_new<Int>()
  v.push(1); v.push(2)
  var s = "hello"
  go use_int(42)
  go use_vec(v)
  go use_str(s)
  return 0
end
""")
    end

    it("Send pass: lambda capturing Vec<Int> is fine (Vec<Int> is Send)") do ->
      assert_compile_succeeds("""
def main(): Int
  var v = vec_new<Int>()
  v.push(1)
  go (-> {
    var q = v
    return q.size
  })()
  return 0
end
""")
    end

    it("Send pass: Mutex<Int> arg compiles (Mutex is Send)") do ->
      assert_compile_succeeds("""
def consume_mtx(m: Int): Int = 0

def main(): Int
  var m = mutex_new(0)
  go consume_mtx(m)
  return 0
end
""")
    end

    it("QZ1302: closure-variable callee still rejected (regression)") do ->
      assert_compile_error("""
def main(): Int
  var f = (-> { return 1 })
  go f()
  return 0
end
""", "QZ1302")
    end

  end
  return qspec_main()
end
