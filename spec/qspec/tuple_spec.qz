## Tuple Spec — First-class tuple construction, access, and type checking
##
## Contract:
##   1. Tuple construction.
##   2. Tuple return values.
##   3. Mixed-type tuples.
##   4. Nested tuples.
##   5. Tuple variable binding.
##   6. Tuple with expressions.
##   7. Unit tuple.

import * from qspec

def main(): Int
  # =========================================================================
  # Basic tuple construction and access
  # =========================================================================

  describe("tuple construction") do ->
    it("creates a 2-tuple and accesses elements") do ->
      var pair = (10, 20)
      assert_eq(pair.0, 10)
      assert_eq(pair.1, 20)
    end

    it("creates a 3-tuple and accesses elements") do ->
      var triple = (1, 2, 3)
      assert_eq(triple.0, 1)
      assert_eq(triple.1, 2)
      assert_eq(triple.2, 3)
    end

    it("creates a 4-tuple") do ->
      var quad = (10, 20, 30, 40)
      assert_eq(quad.0, 10)
      assert_eq(quad.3, 40)
    end
  end

  # =========================================================================
  # Tuple as function return value
  # =========================================================================

  describe("tuple return values") do ->
    it("function returns a 2-tuple") do ->
      var result = divmod(17, 5)
      assert_eq(result.0, 3)
      assert_eq(result.1, 2)
    end

    it("function returns a 3-tuple") do ->
      var rgb = make_color()
      assert_eq(rgb.0, 255)
      assert_eq(rgb.1, 128)
      assert_eq(rgb.2, 0)
    end
  end

  # =========================================================================
  # Tuple with mixed types
  # =========================================================================

  describe("mixed-type tuples") do ->
    it("tuple of int and string") do ->
      var pair = (42, "hello")
      assert_eq(pair.0, 42)
      assert_eq_str(pair.1, "hello")
    end

    it("tuple of string and int") do ->
      var pair = ("world", 99)
      assert_eq_str(pair.0, "world")
      assert_eq(pair.1, 99)
    end

    it("tuple of bool and int") do ->
      var t = (true, 42)
      assert_eq(t.0, 1)
      assert_eq(t.1, 42)
    end
  end

  # =========================================================================
  # Nested tuples
  # =========================================================================

  describe("nested tuples") do ->
    it("tuple containing a tuple") do ->
      var inner = (1, 2)
      var outer = (inner, 3)
      assert_eq(outer.1, 3)
    end

    it("2x2 nested tuples") do ->
      var t = ((10, 20), (30, 40))
      var first = t.0
      var second = t.1
      assert_eq(first.0, 10)
      assert_eq(first.1, 20)
      assert_eq(second.0, 30)
      assert_eq(second.1, 40)
    end
  end

  # =========================================================================
  # Tuple in variable binding
  # =========================================================================

  describe("tuple variable binding") do ->
    it("assign tuple to variable") do ->
      t = (5, 10)
      assert_eq(t.0, 5)
      assert_eq(t.1, 10)
    end

    it("pass tuple to function") do ->
      var pair = (3, 7)
      assert_eq(tuple_sum(pair), 10)
    end
  end

  # =========================================================================
  # Tuple with expressions
  # =========================================================================

  describe("tuple with expressions") do ->
    it("tuple elements from expressions") do ->
      var a = 5
      var b = 10
      var t = (a + b, a * b)
      assert_eq(t.0, 15)
      assert_eq(t.1, 50)
    end

    it("tuple with function call elements") do ->
      var t = (double(5), double(10))
      assert_eq(t.0, 10)
      assert_eq(t.1, 20)
    end
  end

  # =========================================================================
  # Unit tuple
  # =========================================================================

  describe("unit tuple") do ->
    it("empty parens produce zero (unit)") do ->
      var u = ()
      assert_eq(u, 0)
    end
  end

  return qspec_main()
end

# Helper functions

def divmod(a: Int, b: Int): (Int, Int) = (a / b, a % b)

def make_color(): (Int, Int, Int) = (255, 128, 0)

def tuple_sum(pair: Int): Int = pair.0 + pair.1

def double(x: Int): Int = x * 2
