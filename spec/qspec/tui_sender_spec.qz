## std/tui/runtime — Sender<M> external-send API tests.
##
## Covers the Sender struct construction and sender_send dispatch path
## without requiring program_run (which needs a TTY). The end-to-end
## "external goroutine pushes into a running program" verification is
## the dogfood: any TUI app that wires up a Cmd::Run + Sender via
## program_run_with_sender. Specs here exercise the value-level pieces.
##
## @since 5.28.x

import * from qspec
import std/tui/runtime as tui

# A minimal app-message type for the parametric Sender / FrameMsg
# instances used in the specs below. Made-up for testing — has no
# runtime semantics.
enum AppMsg
  Tick
  Data(value: Int)
  Quit
end

# ============================================================
# Sender construction
# ============================================================

def test_sender_holds_channel_handle(): Void
  ## Senders are constructed from a raw channel handle. We synthesise
  ## one via channel_new (the same primitive program_run uses) and
  ## verify the field round-trips. No actual send/recv exercised here
  ## — that path is exercised by `test_sender_send_into_channel` below.
  var ch = channel_new(8)
  var s: tui::Sender<AppMsg> = tui::Sender { ch: ch }
  assert_eq(s.ch, ch)
end

def test_sender_send_into_channel(): Void
  ## Push a FrameMsg through sender_send and recv it back. Exercises
  ## the value path (sender struct → scope_send → channel queue → recv).
  ## No runtime / tty involvement.
  var ch = channel_new(8)
  var s: tui::Sender<AppMsg> = tui::Sender { ch: ch }
  var msg: tui::FrameMsg<AppMsg> = tui::FrameMsg::App(AppMsg::Tick)
  var rc = tui::sender_send(s, msg)
  assert_eq(rc, 0)
  ## recv should return the same value (semantics: channel is FIFO,
  ## bounded, single-element here so order is trivial).
  var raw = recv(ch)
  var got: tui::FrameMsg<AppMsg> = as_type<tui::FrameMsg<AppMsg>>(raw)
  if got is App
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_sender_send_quit_msg(): Void
  ## Confirm Quit variant round-trips identically — same path, different
  ## variant. Catches bugs where a specific variant is dropped or
  ## mis-dispatched through scope_send's serialisation.
  var ch = channel_new(8)
  var s: tui::Sender<AppMsg> = tui::Sender { ch: ch }
  tui::sender_send(s, tui::FrameMsg::Quit)
  var raw = recv(ch)
  var got: tui::FrameMsg<AppMsg> = as_type<tui::FrameMsg<AppMsg>>(raw)
  if got is Quit
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_sender_send_payload_msg(): Void
  ## Payload-carrying variants (App with a nested struct/enum) round-trip
  ## with their inner values intact. Catches bugs where the outer
  ## envelope serialises but the payload's bits get truncated.
  var ch = channel_new(8)
  var s: tui::Sender<AppMsg> = tui::Sender { ch: ch }
  tui::sender_send(s, tui::FrameMsg::App(AppMsg::Data(42)))
  var raw = recv(ch)
  var got: tui::FrameMsg<AppMsg> = as_type<tui::FrameMsg<AppMsg>>(raw)
  match got
    tui::FrameMsg::App(app) =>
      match app
        AppMsg::Data(v) =>
          assert_eq(v, 42)
        _ =>
          assert_eq(0, 1)
      end
    _ =>
      assert_eq(0, 1)
  end
end

# ============================================================
# Sender — multiple sends
# ============================================================

def test_sender_send_multiple_messages_in_order(): Void
  ## Channel is bounded but unordered guarantees only at receive-side
  ## from concurrent senders. With ONE sender pushing multiple messages,
  ## FIFO order is preserved.
  var ch = channel_new(16)
  var s: tui::Sender<AppMsg> = tui::Sender { ch: ch }
  tui::sender_send(s, tui::FrameMsg::App(AppMsg::Data(1)))
  tui::sender_send(s, tui::FrameMsg::App(AppMsg::Data(2)))
  tui::sender_send(s, tui::FrameMsg::App(AppMsg::Data(3)))
  var v1 = _data_of(recv(ch))
  var v2 = _data_of(recv(ch))
  var v3 = _data_of(recv(ch))
  assert_eq(v1, 1)
  assert_eq(v2, 2)
  assert_eq(v3, 3)
end

def _data_of(raw: Int): Int
  var msg: tui::FrameMsg<AppMsg> = as_type<tui::FrameMsg<AppMsg>>(raw)
  match msg
    tui::FrameMsg::App(app) =>
      match app
        AppMsg::Data(v) => v
        _               => -1
      end
    _ => -1
  end
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("Sender construction") do ->
    it("holds the channel handle") do ->
      test_sender_holds_channel_handle()
    end
  end

  describe("sender_send dispatch") do ->
    it("pushes an App-payload message into the channel") do ->
      test_sender_send_into_channel()
    end
    it("round-trips a Quit message") do ->
      test_sender_send_quit_msg()
    end
    it("preserves App payload integers") do ->
      test_sender_send_payload_msg()
    end
    it("preserves FIFO order across multiple sends") do ->
      test_sender_send_multiple_messages_in_order()
    end
  end

  return qspec_main()
end
