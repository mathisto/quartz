## Cross-Feature: Iterators × Match (TEST.2 Phase 3)
##
## Contract: Interactions between iteration and pattern matching.
##   1. For-in with match inside body.
##   2. Match on loop counter.
##   3. List comprehension with conditional.
##   4. Accumulation with match-based dispatch.
##   5. Nested for-in with match filter.

import * from qspec

def main(): Int
  # ==========================================================================
  # For-In with Match Inside Body
  # ==========================================================================
  describe("for-in with match inside body") do ->
    it("match dispatches on each iteration value") do ->
      var sum = 0
      for i in 0..5
        sum += match i
          0 => 10
          1 => 20
          2 => 30
          _ => 0
        end
      end
      assert_eq(sum, 60)
    end

    it("match with range-based classification") do ->
      var even_count = 0
      var odd_count = 0
      for i in 0..10
        if i % 2 == 0
          even_count += 1
        else
          odd_count += 1
        end
      end
      assert_eq(even_count, 5)
      assert_eq(odd_count, 5)
    end

    it("match result accumulated across iterations") do ->
      var result = im_classify_sum(10)
      # 0..10: 0,3,6,9 are multiples of 3 (4 items, contribute 100 each = 400)
      # 1,2,4,5,7,8 are not (6 items, contribute 1 each = 6)
      assert_eq(result, 406)
    end
  end

  # ==========================================================================
  # Vec Operations with Match
  # ==========================================================================
  describe("Vec operations with match") do ->
    it("build Vec via match-based transform") do ->
      var v = vec_new()
      for i in 0..5
        v.push(match i
          0 => 100
          1 => 200
          _ => i
        end)
      end
      assert_eq(v[0], 100)
      assert_eq(v[1], 200)
      assert_eq(v[2], 2)
      assert_eq(v.size, 5)
    end

    it("filter Vec elements with match") do ->
      var source = vec_new()
      for i in 0..10
        source.push(i)
      end
      var filtered = vec_new()
      for i in 0..source.size
        var keep = match source[i] % 3
          0 => 1
          _ => 0
        end
        if keep == 1
          filtered.push(source[i])
        end
      end
      # 0,3,6,9 are multiples of 3
      assert_eq(filtered.size, 4)
      assert_eq(filtered[0], 0)
      assert_eq(filtered[3], 9)
    end
  end

  # ==========================================================================
  # Loop Control Flow with Match
  # ==========================================================================
  describe("loop control flow with match") do ->
    it("break from loop based on match result") do ->
      var result = 0
      for i in 0..100
        result = match i
          42 => -1
          _ => i
        end
        if result == -1
          break
        end
      end
      assert_eq(result, -1)
    end

    it("while loop with match-based state machine") do ->
      var state = 0
      var steps = 0
      while state != 3
        state = match state
          0 => 1
          1 => 2
          2 => 3
          _ => 3
        end
        steps += 1
      end
      assert_eq(steps, 3)
    end
  end

  # ==========================================================================
  # Nested Iteration with Match
  # ==========================================================================
  describe("nested iteration with match") do ->
    it("nested for-in with match-based accumulation") do ->
      var total = 0
      for i in 0..3
        for j in 0..3
          total += match i + j
            0 => 1
            1 => 2
            2 => 3
            _ => 4
          end
        end
      end
      # i=0: j=0->1, j=1->2, j=2->3 = 6
      # i=1: j=0->2, j=1->3, j=2->4 = 9
      # i=2: j=0->3, j=1->4, j=2->4 = 11
      assert_eq(total, 26)
    end
  end

  return qspec_main()
end

# --- Helpers ---

def im_classify_sum(n: Int): Int
  var sum = 0
  for i in 0..n
    sum += match i % 3
      0 => 100
      _ => 1
    end
  end
  return sum
end
