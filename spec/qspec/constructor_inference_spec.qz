## FIX.6 Constructor Inference Tests
##
## Contract:
##   1. vec_new() without type param returns a usable Vec.
##   2. .push(val) on bare Vec infers element type.
##   3. .size works on bare Vec (no type param needed).
##   4. vec_new() + .push(42) makes Vec<Int>.
##   5. vec_new() + .push("hello") makes Vec<String>.
##   6. Multiple pushes don't conflict.
##   7. List comprehension infers correct element annotation.

import * from qspec

def main(): Int
  describe("vec_new without type param") do ->
    it("creates a usable Vec") do ->
      var items = vec_new()
      assert_eq(items.size, 0)
    end

    it("allows push on bare Vec") do ->
      var items = vec_new()
      items.push(42)
      assert_eq(items.size, 1)
    end

    it("allows push and get on bare Vec") do ->
      var items = vec_new()
      items.push(10)
      items.push(20)
      items.push(30)
      assert_eq(items[0], 10)
      assert_eq(items[1], 20)
      assert_eq(items[2], 30)
    end

    it("supports .size after push") do ->
      var items = vec_new()
      items.push(1)
      items.push(2)
      items.push(3)
      assert_eq(items.size, 3)
    end

    it("supports multiple pushes without conflict") do ->
      var items = vec_new()
      items.push(1)
      items.push(2)
      items.push(3)
      var sum = 0
      for i in 0..items.size
        sum += items[i]
      end
      assert_eq(sum, 6)
    end
  end

  describe("explicit vec_new<T> still works") do ->
    it("vec_new() still works") do ->
      var items = vec_new()
      items.push(42)
      assert_eq(items[0], 42)
    end

    it("vec_new<String>() still works") do ->
      var items = vec_new<String>()
      items.push("hello")
      assert_eq_str(items[0], "hello")
    end
  end

  describe("list comprehension type tracking") do ->
    it("returns a Vec from list comprehension") do ->
      var items = [x * 2 for x in 0..5]
      assert_eq(items.size, 5)
    end

    it("list comp elements are accessible") do ->
      var items = [x * 10 for x in 0..3]
      assert_eq(items[0], 0)
      assert_eq(items[1], 10)
      assert_eq(items[2], 20)
    end
  end

  return qspec_main()
end
