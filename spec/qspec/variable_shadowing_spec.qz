## Variable Shadowing Tests
##
## Contract:
##   1. Function scope isolation.
##   2. Parameter scoping.
##   3. Loop variable scoping.
##   4. Closure variable capture.
##   5. Const vs var.
##   6. Struct field access.
import * from qspec

struct VSPoint
  x: Int
  y: Int
end

def main(): Int
  describe("function scope isolation") do ->
    it("variables in different functions are independent") do ->
      assert_eq(vs_f1() + vs_f2(), 30)
    end
  end

  describe("parameter scoping") do ->
    it("function parameter is visible in body") do ->
      assert_eq(vs_double(21), 42)
    end

    it("multiple parameters each scoped independently") do ->
      assert_eq(vs_add(13, 29), 42)
    end
  end

  describe("loop variable scoping") do ->
    it("for loop iterator is scoped to loop body") do ->
      assert_eq(vs_loop_sum(), 10)
    end
  end

  describe("closure variable capture") do ->
    it("closure captures variable from enclosing scope") do ->
      f = vs_make_capture(42)
      assert_eq(f(), 42)
    end

    it("closure parameter shadows captured variable") do ->
      f = vs_make_shadow(100)
      assert_eq(f(5), 5)
    end

    it("multiple closures capture same variable") do ->
      a = vs_make_capture(10)
      b = vs_make_capture(10)
      assert_eq(a() + b(), 20)
    end
  end

  describe("const vs var") do ->
    it("const binding cannot be reassigned") do ->
      assert_compile_error("def main(): Int\n  x = 5\n  x = 10\n  return x\nend\n", "Cannot assign to immutable")
    end

    it("var binding can be reassigned") do ->
      assert_eq(vs_var_reassign(), 10)
    end

    it("var persists changes through control flow") do ->
      assert_eq(vs_var_control_flow(), 2)
    end

    it("var accumulates in loop") do ->
      assert_eq(vs_var_loop_accum(), 10)
    end

    it("compound assignment works with var") do ->
      assert_eq(vs_compound_assign(), 30)
    end
  end

  describe("struct field access") do ->
    it("struct fields are accessible") do ->
      var p = VSPoint { x: 3, y: 4 }
      assert_eq(p.x + p.y, 7)
    end
  end

  return qspec_main()
end

def vs_f1(): Int
  var x = 10
  return x
end

def vs_f2(): Int
  var x = 20
  return x
end

def vs_double(x: Int): Int
  return x * 2
end

def vs_add(a: Int, b: Int): Int
  return a + b
end

def vs_loop_sum(): Int
  var sum = 0
  for i in 1..5
    sum = sum + i
  end
  return sum
end

## closure syntax || not supported by self-hosted parser
## def vs_closure_capture()
## def vs_multi_closure()

def vs_var_reassign(): Int
  var x = 5
  x = 10
  return x
end

def vs_var_control_flow(): Int
  var x = 1
  if true
    x = 2
  end
  return x
end

def vs_var_loop_accum(): Int
  var sum = 0
  for i in 1..5
    sum = sum + i
  end
  return sum
end

def vs_compound_assign(): Int
  var x = 10
  x = x + 5
  x = x * 2
  return x
end

def vs_make_capture(val: Int): Fn(): Int
  return -> val
end

def vs_make_shadow(val: Int): Fn(Int): Int
  return (x: Int) -> x
end
