## Nested Generics Comprehensive Tests
##
## Contract:
##   1. Cptr<vec<int>> in type annotation.
##   2. Function param map<string, vec<int>>.
##   3. Function param vec<vec<int>>.
##   4. Function return vec<vec<int>>.
##   5. Generic struct with vec<t>.
##   6. Map<string, vec<int>> index m[key].
import * from qspec

def main(): Int
  describe("nested generics comprehensive") do ->
    # ── Vec<Vec<Int>> basic operations ──────────────────────────────
    it("Vec<Vec<Int>> push inner vec and get it back") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var inner: Vec<Int> = vec_new()
      inner.push(10)
      inner.push(20)
      inner.push(30)
      outer.push(inner)
      row = outer[0]
      assert_eq(row[0], 10)
      assert_eq(row[1], 20)
      assert_eq(row[2], 30)
    end

    it("Vec<Vec<Int>> multiple rows") do ->
      var matrix: Vec<Vec<Int>> = vec_new()
      var r0: Vec<Int> = vec_new()
      var r1: Vec<Int> = vec_new()
      r0.push(1)
      r0.push(2)
      r1.push(3)
      r1.push(4)
      matrix.push(r0)
      matrix.push(r1)
      assert_eq(matrix.size, 2)
      assert_eq(matrix[0][0], 1)
      assert_eq(matrix[1][1], 4)
    end

    it("Vec<Vec<Int>> index access v[i]") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var inner: Vec<Int> = vec_new()
      inner.push(42)
      outer.push(inner)
      row = outer[0]
      assert_eq(row[0], 42)
    end

    # ── Vec<Vec<String>> ───────────────────────────────────────────
    it("Vec<Vec<String>> nested string vectors") do ->
      var names: Vec<Vec<String>> = vec_new()
      var group: Vec<String> = vec_new()
      group.push("alpha")
      group.push("beta")
      names.push(group)
      g = names[0]
      assert_eq_str(g[0], "alpha")
      assert_eq_str(g[1], "beta")
    end

    # ── Map<String, Vec<Int>> value type propagation ───────────
    it("Map<String, Vec<Int>> set and get preserves Vec type") do ->
      var m: Map<String, Vec<Int>> = map_new()
      var vals: Vec<Int> = vec_new()
      vals.push(100)
      vals.push(200)
      m.set("data", vals)
      match m.get("data")
        Some(result) => {
          assert_eq(result[0], 100)
          assert_eq(result[1], 200)
        }
        _ => assert_eq(0, 1)
      end
    end

    it("Map<String, Vec<Int>> index m[key] preserves Vec type") do ->
      var m: Map<String, Vec<Int>> = map_new()
      var vals: Vec<Int> = vec_new()
      vals.push(77)
      m.set("items", vals)
      var got = m["items"]
      assert_eq(got[0], 77)
    end

    # ── 3-level nesting ────────────────────────────────────────────
    it("Vec<Vec<Vec<Int>>> three levels deep") do ->
      var cube: Vec<Vec<Vec<Int>>> = vec_new()
      var plane: Vec<Vec<Int>> = vec_new()
      var row: Vec<Int> = vec_new()
      row.push(99)
      plane.push(row)
      cube.push(plane)
      p = cube[0]
      r = p[0]
      assert_eq(r[0], 99)
    end

    # ── Vec<Map<String, Int>> nested container ─────────────────
    it("Vec<Map<String, Int>> stores maps in vec") do ->
      var records: Vec<Map<String, Int>> = vec_new()
      var entry: Map<String, Int> = map_new()
      entry.set("age", 30)
      entry.set("score", 95)
      records.push(entry)
      e = records[0]
      match e.get("age")
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
      match e.get("score")
        Some(v) => assert_eq(v, 95)
        _ => assert_eq(0, 1)
      end
    end

    # ── Function params with nested generics ───────────────────────
    it("function param Vec<Vec<Int>>") do ->
      var m: Vec<Vec<Int>> = vec_new()
      var r: Vec<Int> = vec_new()
      r.push(5)
      r.push(6)
      m.push(r)
      assert_eq(ngc_sum_first_row(m), 11)
    end

    it("function return Vec<Vec<Int>>") do ->
      var m = ngc_make_identity_2x2()
      assert_eq(m.size, 2)
      r0 = m[0]
      r1 = m[1]
      assert_eq(r0[0], 1)
      assert_eq(r0[1], 0)
      assert_eq(r1[0], 0)
      assert_eq(r1[1], 1)
    end

    it("function param Map<String, Vec<Int>>") do ->
      var m: Map<String, Vec<Int>> = map_new()
      var v: Vec<Int> = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      m.set("data", v)
      assert_eq(ngc_sum_map_values(m, "data"), 60)
    end

    # ── UFCS chains on nested generics ─────────────────────────────
    it("UFCS .push and .size on Vec<Vec<Int>>") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      assert_eq(outer.size, 0)
      var inner: Vec<Int> = vec_new()
      inner.push(1)
      outer.push(inner)
      assert_eq(outer.size, 1)
    end

    it("nested vec_size through vec_get") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var inner: Vec<Int> = vec_new()
      inner.push(10)
      inner.push(20)
      outer.push(inner)
      assert_eq(outer[0].size, 2)
    end

    # ── CPtr<Vec<Int>> ─────────────────────────────────────────────
    it("CPtr<Vec<Int>> in type annotation") do ->
      var v: Vec<Int> = vec_new()
      v.push(42)
      # Just verify the type annotation parses correctly
      assert_eq(v[0], 42)
    end

    it("generic struct with Vec<T> field where T=Vec<Int>") do ->
      var v: Vec<Int> = vec_new()
      v.push(42)
      var h = NGCHolder<Vec<Int>> { data: v }
      assert_eq(h.data[0], 42)
    end
  end
  return qspec_main()
end

# Helper struct for generic struct + nested container test
struct NGCHolder<T>
  data: T
end

# Helper functions for function param/return tests
def ngc_sum_first_row(matrix: Vec<Vec<Int>>): Int
  row = matrix[0]
  var total = 0
  for i in 0..row.size
    total += row[i]
  end
  return total
end

def ngc_make_identity_2x2(): Vec<Vec<Int>>
  var m: Vec<Vec<Int>> = vec_new()
  var r0: Vec<Int> = vec_new()
  r0.push(1)
  r0.push(0)
  var r1: Vec<Int> = vec_new()
  r1.push(0)
  r1.push(1)
  m.push(r0)
  m.push(r1)
  return m
end

def ngc_sum_map_values(m: Map<String, Vec<Int>>, key: String): Int
  var vals: Vec<Int> = vec_new()
  match m.get(key)
    Some(v) => vals = v
    _ => return 0
  end
  var total = 0
  for i in 0..vals.size
    total += vals[i]
  end
  return total
end
