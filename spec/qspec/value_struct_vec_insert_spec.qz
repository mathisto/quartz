## Vec value-element insert / delete Tests (item 49)
##
## Regression for the item-49 bug: `vec.insert(i, <@value struct>)` and
## `vec.delete(i)` over a value-layout element went through the stride-1/boxed
## qz_vec_insert / qz_vec_remove runtime helpers, which grow by *8, shift single
## i64 words, and store %val as a boxed pointer. For a value-layout element the
## slots are `ew` bytes wide (fc*8 or packed sizeof) and %val is a POINTER to the
## source struct, so the boxed path corrupted the vec.
##
## Fix: cg_intrinsic_vec now emits an inline ew-aware insert/delete for
## value-layout elements (reads ew from header[3], grows by count*ew, shifts by
## memcpy of ew bytes, stores the inserted element by memcpy of ew bytes from the
## source pointer). Non-value-layout (Int/String/reference) elements keep the
## unchanged runtime call.
##
## Covers ≤16B inline (2xInt) AND >16B cow (5xInt).
import * from qspec

@value
struct P2
  a: Int
  b: Int
end

@value
struct P5
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
end

def main(): Int
  describe("value-struct vec insert/delete (item 49)") do ->
    it("inserts a 16B @value element at an interior index") do ->
      assert_output("10\n34\n30\n", ins16_interior)
    end

    it("inserts a 16B @value element preserving all fields") do ->
      assert_output("10\n11\n34\n35\n30\n31\n", ins16_fields)
    end

    it("inserts a >16B (40B) @value element at an interior index") do ->
      assert_output("10\n34\n30\n", ins40_interior)
    end

    it("inserts a >16B @value element preserving all 5 fields") do ->
      assert_output("34\n35\n36\n37\n38\n", ins40_fields)
    end

    it("deletes a 16B @value element and shifts the tail down") do ->
      assert_output("10\n30\n", del16_shift)
    end

    it("deletes a >16B @value element and shifts the tail down") do ->
      assert_output("10\n30\n", del40_shift)
    end
  end

  return qspec_main()
end

def ins16_interior(): Void
  var v = vec_new<P2>()
  v.push(P2 { a: 10, b: 11 })
  v.push(P2 { a: 30, b: 31 })
  v.insert(1, P2 { a: 34, b: 35 })
  print_int(v[0].a)
  print_int(v[1].a)
  print_int(v[2].a)
end

def ins16_fields(): Void
  var v = vec_new<P2>()
  v.push(P2 { a: 10, b: 11 })
  v.push(P2 { a: 30, b: 31 })
  v.insert(1, P2 { a: 34, b: 35 })
  print_int(v[0].a)
  print_int(v[0].b)
  print_int(v[1].a)
  print_int(v[1].b)
  print_int(v[2].a)
  print_int(v[2].b)
end

def ins40_interior(): Void
  var v = vec_new<P5>()
  v.push(P5 { a: 10, b: 11, c: 12, d: 13, e: 14 })
  v.push(P5 { a: 30, b: 31, c: 32, d: 33, e: 34 })
  v.insert(1, P5 { a: 34, b: 35, c: 36, d: 37, e: 38 })
  print_int(v[0].a)
  print_int(v[1].a)
  print_int(v[2].a)
end

def ins40_fields(): Void
  var v = vec_new<P5>()
  v.push(P5 { a: 10, b: 11, c: 12, d: 13, e: 14 })
  v.push(P5 { a: 30, b: 31, c: 32, d: 33, e: 34 })
  v.insert(1, P5 { a: 34, b: 35, c: 36, d: 37, e: 38 })
  print_int(v[1].a)
  print_int(v[1].b)
  print_int(v[1].c)
  print_int(v[1].d)
  print_int(v[1].e)
end

def del16_shift(): Void
  var v = vec_new<P2>()
  v.push(P2 { a: 10, b: 11 })
  v.push(P2 { a: 20, b: 21 })
  v.push(P2 { a: 30, b: 31 })
  v.delete(1)
  print_int(v[0].a)
  print_int(v[1].a)
end

def del40_shift(): Void
  var v = vec_new<P5>()
  v.push(P5 { a: 10, b: 11, c: 12, d: 13, e: 14 })
  v.push(P5 { a: 20, b: 21, c: 22, d: 23, e: 24 })
  v.push(P5 { a: 30, b: 31, c: 32, d: 33, e: 34 })
  v.delete(1)
  print_int(v[0].a)
  print_int(v[1].a)
end
