## Type Inference Edge Cases Tests
##
## Contract:
##   1. HOF with typed Fn param: explicit Fn type accepted.
##   2. Struct field access: field type inferred from struct definition.
##   3. Call site checking: argument types checked against annotations.
##   4. Recursive calls: return type inferred through recursive call chain.
##   5. Struct field chain: nested struct field access inferred.
##   6. If-expression unification: both branches must agree on type.
##   7. Wrong arity: calling with wrong arg count produces error.
##   8. Void return: function returning nothing inferred as Void.
import * from qspec
import * from qspec/subprocess

struct TIPoint
  x: Int
  y: Int
end

def main(): Int
  describe("HOF with typed Fn param") do ->
    it("compiles HOF with explicit Fn type") do ->
      assert_eq(ti_apply(ti_double, 21), 42)
    end
  end

  describe("struct field access with typed param") do ->
    it("accesses struct fields on typed parameter") do ->
      var p = TIPoint { x: 42, y: 10 }
      assert_eq(ti_get_x(p), 42)
    end

    it("accesses multiple struct fields") do ->
      var p = TIPoint { x: 32, y: 10 }
      assert_eq(ti_sum_fields(p), 42)
    end
  end

  describe("basic type checking at call sites") do ->
    it("accepts matching argument types") do ->
      assert_eq(ti_add(20, 22), 42)
    end

    it("accepts string operations") do ->
      var s = ti_greet("world")
      assert_eq(s.size + 31, 42)
    end
  end

  # ===========================================================================
  # Recursive call inference
  # ===========================================================================
  describe("recursive call site inference") do ->
    it("infers return type through recursive function") do ->
      assert_eq(ti_factorial(5), 120)
    end
  end

  # ===========================================================================
  # Struct field chain
  # ===========================================================================
  describe("struct field chain inference") do ->
    it("infers nested struct field access") do ->
      var inner = TIPoint { x: 42, y: 10 }
      assert_eq(inner.x + inner.y, 52)
    end
  end

  # ===========================================================================
  # If-expression type unification
  # ===========================================================================
  describe("if-expression type inference") do ->
    it("infers result type from if-expression branches") do ->
      var x = if true
        42
      else
        0
      end
      assert_eq(x, 42)
    end
  end

  # ===========================================================================
  # Wrong arity detection
  # ===========================================================================
  describe("wrong arity detection") do ->
    it("rejects wrong number of arguments") do ->
      assert_compile_error("""
        def foo(x: Int): Int = x
        def main(): Int
          return foo(1, 2)
        end
        """, "accepts at most")
    end
  end

  # ===========================================================================
  # Void return inference
  # ===========================================================================
  describe("void return inference") do ->
    it("function with no explicit return infers Void") do ->
      assert_compile_succeeds("""
        def do_nothing(): Void
        end
        def main(): Int
          do_nothing()
          return 0
        end
        """)
    end
  end

  # ===========================================================================
  # Array element access inference
  # ===========================================================================
  describe("array element access") do ->
    it("index access type inferred from array type") do ->
      arr = [10, 20, 12]
      result = arr[0] + arr[2]
      assert_eq(result, 22)
    end
  end

  return qspec_main()
end

def ti_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def ti_double(n: Int): Int
  return n * 2
end

def ti_get_x(p: TIPoint): Int
  return p.x
end

def ti_sum_fields(p: TIPoint): Int
  return p.x + p.y
end

def ti_add(x: Int, y: Int): Int
  return x + y
end

def ti_greet(name: String): String
  return "hello " + name
end

def ti_factorial(n: Int): Int
  if n <= 1
    return 1
  end
  return n * ti_factorial(n - 1)
end
