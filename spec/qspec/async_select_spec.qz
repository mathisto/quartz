## Async Select Tests — Phase 4 Multi-Wait

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("async select") do ->
    it("async_select returns index of first completed task") do ->
      assert_run_exits(select_first_src(), 0)
    end
    it("async_select with fast task at index 0") do ->
      assert_run_exits(select_fast_first_src(), 0)
    end
    it("async_race returns result of winner") do ->
      assert_run_exits(race_winner_src(), 0)
    end
    it("async_race cancels losing tasks") do ->
      assert_run_exits(race_cancels_losers_src(), 0)
    end
  end
  return qspec_main()
end

def select_prefix(): String = """
  def async_select(tasks: Vec<Int>): Int
    var n = vec_size(tasks)
    while true
      var i = 0
      while i < n
        var frame = vec_get(tasks, i)
        if load(frame, 0) == -1
          return i
        end
        i += 1
      end
      sched_yield()
    end
    return 0
  end
  def async_race(tasks: Vec<Int>): Int
    var winner_idx = async_select(tasks)
    var winner = vec_get(tasks, winner_idx)
    var result = load(winner, 1)
    var n = vec_size(tasks)
    var i = 0
    while i < n
      if i != winner_idx
        var loser = vec_get(tasks, i)
        var cancel_tok = load(loser, 3)
        if cancel_tok > 0
          cancel_token_cancel(cancel_tok)
        end
      end
      i += 1
    end
    return result
  end
  """

def select_first_src(): String
  return select_prefix() + "\n" + """
    def fast(): Int
      return 99
    end
    def slow(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      var f1 = async slow()
      sched_spawn(f1)
      vec_push(tasks, f1)
      var f2 = async fast()
      sched_spawn(f2)
      vec_push(tasks, f2)
      var idx = async_select(tasks)
      sched_shutdown()
      if idx == 1
        return 0
      end
      return 1
    end
    """
end

def select_fast_first_src(): String
  return select_prefix() + "\n" + """
    def fast(): Int
      return 77
    end
    def slow(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      var f1 = async fast()
      sched_spawn(f1)
      vec_push(tasks, f1)
      var f2 = async slow()
      sched_spawn(f2)
      vec_push(tasks, f2)
      var idx = async_select(tasks)
      sched_shutdown()
      if idx == 0
        return 0
      end
      return 1
    end
    """
end

def race_winner_src(): String
  return select_prefix() + "\n" + """
    def fast(): Int
      return 99
    end
    def slow(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      var f1 = async slow()
      sched_spawn(f1)
      vec_push(tasks, f1)
      var f2 = async fast()
      sched_spawn(f2)
      vec_push(tasks, f2)
      var result = async_race(tasks)
      sched_shutdown()
      if result == 99
        return 0
      end
      return 1
    end
    """
end

def race_cancels_losers_src(): String
  return select_prefix() + "\n" + """
    def fast(): Int
      return 99
    end
    def slow(): Int
      var i = 0
      while i < 1000
        sched_yield()
        i += 1
      end
      return 42
    end
    def main(): Int
      sched_init(2)
      var tok = cancel_token_new()
      var tasks = vec_new<Int>()
      var f1 = async slow()
      store(f1, 3, tok)
      sched_spawn(f1)
      vec_push(tasks, f1)
      var f2 = async fast()
      sched_spawn(f2)
      vec_push(tasks, f2)
      var result = async_race(tasks)
      sched_shutdown()
      var r1 = load(f1, 1)
      cancel_token_free(tok)
      if result == 99
        if r1 == -1
          return 0
        end
      end
      return 1
    end
    """
end
