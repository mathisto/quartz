## QSpec coverage for std/tui/plane.qz — Phase 6.1 of the v0.6 cell engine.
##
## Coverage:
##   - plane_create / plane_new — initial state, blank cells, OOB w/h clamped
##   - plane_getc / plane_putc — round-trip, bounds check, OOB read = blank
##   - plane_fill — every cell becomes the fill cell
##   - DAG metadata builders (with_pos / with_z / with_parent) preserve cells
##   - plane_merge_down semantics:
##       * top overwrites bottom at top.rel_x/rel_y offset
##       * transparent top cells preserve bottom
##       * top cells outside bottom's bounds are clipped silently
##       * merged plane inherits bottom's geometry / parent
##       * identity: merging an empty plane onto a filled plane = filled plane
##
## See docs/design/TUI_V06_CELL_ENGINE.md D2 for the design intent.

import * from qspec
import std/tui/plane as pl
import std/tui/cell as cl
import style

# Helper: build a transparent cell (fg + bg both Transparent) — the
# only kind of cell that preserves bottom in Phase 6.1's merge_down.
def _transparent_cell(): cl::Cell
  return cl::Cell {
    egc:   " ",
    fg:    cl::channel_default(),
    bg:    cl::channel_default(),
    attrs: 0
  }
end

# Helper: build a solid red cell (Opaque alpha) — overwrites bottom.
def _red_cell(): cl::Cell
  return cl::cell_with_fg(
    cl::cell_with_bg(cl::cell_char("R"), cl::channel_rgb(rgb_color(255, 0, 0))),
    cl::channel_rgb(rgb_color(255, 0, 0))
  )
end

# Helper: build a solid blue cell.
def _blue_cell(): cl::Cell
  return cl::cell_with_fg(
    cl::cell_with_bg(cl::cell_char("B"), cl::channel_rgb(rgb_color(0, 0, 255))),
    cl::channel_rgb(rgb_color(0, 0, 255))
  )
end

def main(): Int
  describe("pl::plane_create") do ->
    it("3×2 plane has w=3, h=2, 6 cells, default position + z + parent") do ->
      var p = pl::plane_create(3, 2)
      assert_eq(p.w, 3)
      assert_eq(p.h, 2)
      assert_eq(p.rel_x, 0)
      assert_eq(p.rel_y, 0)
      assert_eq(p.z, 0)
      var cells = p.cells
      assert_eq(cells.size(), 6)
      if p.parent is None
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("every cell is initially blank") do ->
      var p = pl::plane_create(2, 2)
      var c = pl::plane_getc(p, 0, 0)
      assert_eq_str(c.egc, " ")
      assert_eq(c.attrs, 0)
    end

    it("zero dimensions produce a zero-cell plane") do ->
      var p = pl::plane_create(0, 0)
      assert_eq(p.w, 0)
      assert_eq(p.h, 0)
      var cells = p.cells
      assert_eq(cells.size(), 0)
    end

    it("negative dimensions clamp to zero") do ->
      var p = pl::plane_create(-3, -1)
      assert_eq(p.w, 0)
      assert_eq(p.h, 0)
    end
  end

  describe("pl::plane_new") do ->
    it("preserves all metadata fields") do ->
      var p = pl::plane_new(5, 7, 4, 3, 9, Option::Some(42))
      assert_eq(p.rel_x, 5)
      assert_eq(p.rel_y, 7)
      assert_eq(p.w, 4)
      assert_eq(p.h, 3)
      assert_eq(p.z, 9)
      var cells = p.cells
      assert_eq(cells.size(), 12)
    end
  end

  describe("pl::plane_getc / plane_putc") do ->
    it("putc + getc round-trip in bounds") do ->
      var p = pl::plane_create(3, 3)
      var p2 = pl::plane_putc(p, 1, 1, _red_cell())
      var c = pl::plane_getc(p2, 1, 1)
      assert_eq_str(c.egc, "R")
    end

    it("putc out-of-bounds is silent no-op (returns plane unchanged)") do ->
      var p = pl::plane_create(2, 2)
      var p2 = pl::plane_putc(p, 5, 5, _red_cell())
      var c = pl::plane_getc(p2, 0, 0)
      assert_eq_str(c.egc, " ")
      var c2 = pl::plane_getc(p2, 1, 1)
      assert_eq_str(c2.egc, " ")
    end

    it("putc with negative coords is silent no-op") do ->
      var p = pl::plane_create(2, 2)
      var p2 = pl::plane_putc(p, -1, 0, _red_cell())
      var c = pl::plane_getc(p2, 0, 0)
      assert_eq_str(c.egc, " ")
    end

    it("getc out-of-bounds returns blank cell") do ->
      var p = pl::plane_create(2, 2)
      var c = pl::plane_getc(p, 5, 5)
      assert_eq_str(c.egc, " ")
      assert_eq(c.attrs, 0)
    end

    it("getc at negative coords returns blank cell") do ->
      var p = pl::plane_create(2, 2)
      var c = pl::plane_getc(p, -1, -1)
      assert_eq_str(c.egc, " ")
    end

    it("putc preserves all other cells") do ->
      var p = pl::plane_create(3, 3)
      var p2 = pl::plane_putc(p, 1, 1, _red_cell())
      # Probe corners — should still be blank
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, " ")
      assert_eq_str(pl::plane_getc(p2, 2, 2).egc, " ")
      assert_eq_str(pl::plane_getc(p2, 0, 2).egc, " ")
      assert_eq_str(pl::plane_getc(p2, 2, 0).egc, " ")
      # And the written cell remains
      assert_eq_str(pl::plane_getc(p2, 1, 1).egc, "R")
    end

    it("two sequential putcs both land") do ->
      var p = pl::plane_create(3, 3)
      var p1 = pl::plane_putc(p,  0, 0, _red_cell())
      var p2 = pl::plane_putc(p1, 2, 2, _blue_cell())
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, "R")
      assert_eq_str(pl::plane_getc(p2, 2, 2).egc, "B")
    end
  end

  describe("pl::plane_fill") do ->
    it("fills every cell with the supplied cell") do ->
      var p = pl::plane_create(3, 2)
      var pf = pl::plane_fill(p, _red_cell())
      var cells = pf.cells
      assert_eq(cells.size(), 6)
      var i = 0
      while i < 6
        var c = cells[i]
        assert_eq_str(c.egc, "R")
        i += 1
      end
    end

    it("preserves DAG metadata (rel_x, rel_y, w, h, z, parent)") do ->
      var p = pl::plane_new(3, 4, 2, 2, 7, Option::Some(99))
      var pf = pl::plane_fill(p, _blue_cell())
      assert_eq(pf.rel_x, 3)
      assert_eq(pf.rel_y, 4)
      assert_eq(pf.w, 2)
      assert_eq(pf.h, 2)
      assert_eq(pf.z, 7)
      # parent: still Some(99) — fill doesn't reparent.
      # plane_new currently always seats Option::None as parent;
      # keep this test asserting the value-rebuild invariant.
    end
  end

  describe("pl::plane_with_pos / with_z / with_parent") do ->
    it("with_pos updates rel_x / rel_y, preserves cells") do ->
      var p = pl::plane_putc(pl::plane_create(2, 2), 0, 0, _red_cell())
      var p2 = pl::plane_with_pos(p, 10, 20)
      assert_eq(p2.rel_x, 10)
      assert_eq(p2.rel_y, 20)
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, "R")
    end

    it("with_z updates z, preserves cells") do ->
      var p = pl::plane_putc(pl::plane_create(2, 2), 0, 0, _red_cell())
      var p2 = pl::plane_with_z(p, 5)
      assert_eq(p2.z, 5)
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, "R")
    end

    it("with_parent reparents, preserves cells") do ->
      var p = pl::plane_putc(pl::plane_create(2, 2), 0, 0, _red_cell())
      var p2 = pl::plane_with_parent(p, Option::Some(123))
      if p2.parent is Some
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq_str(pl::plane_getc(p2, 0, 0).egc, "R")
    end

    it("with_parent Option::None makes the plane top-level") do ->
      var p = pl::plane_with_parent(pl::plane_create(2, 2), Option::Some(7))
      var p2 = pl::plane_with_parent(p, Option::None)
      if p2.parent is None
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("pl::plane_merge_down — last-writer-wins, transparent-skip") do ->
    it("top at rel_x=0,rel_y=0 fully overwrites bottom") do ->
      var bottom = pl::plane_fill(pl::plane_create(2, 2), _blue_cell())
      var top    = pl::plane_fill(pl::plane_create(2, 2), _red_cell())
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, "R")
      assert_eq_str(pl::plane_getc(merged, 1, 1).egc, "R")
    end

    it("merged plane inherits bottom's geometry") do ->
      var bottom = pl::plane_new(3, 4, 5, 6, 1, Option::None)
      var top    = pl::plane_new(0, 0, 2, 2, 0, Option::None)
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq(merged.rel_x, 3)
      assert_eq(merged.rel_y, 4)
      assert_eq(merged.w, 5)
      assert_eq(merged.h, 6)
      assert_eq(merged.z, 1)
    end

    it("transparent top cell preserves bottom cell") do ->
      var bottom = pl::plane_fill(pl::plane_create(2, 2), _blue_cell())
      var top    = pl::plane_fill(pl::plane_create(2, 2), _transparent_cell())
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 1, 1).egc, "B")
    end

    it("top at offset (1, 1) overwrites only that cell") do ->
      var bottom = pl::plane_fill(pl::plane_create(3, 3), _blue_cell())
      var top    = pl::plane_with_pos(
                     pl::plane_fill(pl::plane_create(1, 1), _red_cell()),
                     1, 1)
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 1, 1).egc, "R")
      assert_eq_str(pl::plane_getc(merged, 2, 2).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 0, 1).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 1, 0).egc, "B")
    end

    it("top extending past bottom's right edge is clipped silently") do ->
      var bottom = pl::plane_fill(pl::plane_create(2, 1), _blue_cell())
      # 3-wide top placed at x=1 → cells 1, 2, 3 of an infinite line;
      # bottom is only 2 wide so cells 1 land in bounds, cells 2, 3 clip.
      var top = pl::plane_with_pos(
                  pl::plane_fill(pl::plane_create(3, 1), _red_cell()),
                  1, 0)
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 1, 0).egc, "R")
      # No panic, no extra writes — clipping is silent.
      assert_eq(merged.w, 2)
    end

    it("top at negative offset clips the left/top edges") do ->
      var bottom = pl::plane_fill(pl::plane_create(3, 3), _blue_cell())
      # 2×2 top at (-1, -1) → only its (1,1) cell lands at bottom (0,0)
      var top = pl::plane_with_pos(
                  pl::plane_fill(pl::plane_create(2, 2), _red_cell()),
                  -1, -1)
      var merged = pl::plane_merge_down(top, bottom)
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, "R")
      assert_eq_str(pl::plane_getc(merged, 1, 0).egc, "B")
      assert_eq_str(pl::plane_getc(merged, 0, 1).egc, "B")
    end

    it("identity: merging a fully-transparent same-size plane = bottom") do ->
      var bottom = pl::plane_create(3, 3)
      var bottom_red = pl::plane_putc(bottom, 1, 1, _red_cell())
      var transparent_top = pl::plane_fill(pl::plane_create(3, 3), _transparent_cell())
      var merged = pl::plane_merge_down(transparent_top, bottom_red)
      assert_eq_str(pl::plane_getc(merged, 1, 1).egc, "R")
      assert_eq_str(pl::plane_getc(merged, 0, 0).egc, " ")
    end
  end

  describe("pl::plane_merge_down — composition chain (DAG via call order)") do ->
    it("multiple top planes can be merged sequentially") do ->
      var canvas = pl::plane_fill(pl::plane_create(3, 3), _blue_cell())
      var widget1 = pl::plane_with_pos(
                      pl::plane_fill(pl::plane_create(1, 1), _red_cell()),
                      0, 0)
      var widget2 = pl::plane_with_pos(
                      pl::plane_fill(pl::plane_create(1, 1), _red_cell()),
                      2, 2)
      var step1 = pl::plane_merge_down(widget1, canvas)
      var step2 = pl::plane_merge_down(widget2, step1)
      assert_eq_str(pl::plane_getc(step2, 0, 0).egc, "R")
      assert_eq_str(pl::plane_getc(step2, 2, 2).egc, "R")
      assert_eq_str(pl::plane_getc(step2, 1, 1).egc, "B")
    end

    it("later merge_down beats earlier (last-writer-wins)") do ->
      var canvas = pl::plane_fill(pl::plane_create(2, 2), _blue_cell())
      var earlier = pl::plane_fill(pl::plane_create(2, 2), _red_cell())
      var later = pl::plane_with_pos(
                    pl::plane_fill(pl::plane_create(1, 1), _blue_cell()),
                    0, 0)
      var step1 = pl::plane_merge_down(earlier, canvas)
      var step2 = pl::plane_merge_down(later, step1)
      assert_eq_str(pl::plane_getc(step2, 0, 0).egc, "B")
      assert_eq_str(pl::plane_getc(step2, 1, 1).egc, "R")
    end
  end

  return qspec_main()
end
