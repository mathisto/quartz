## User handler expressions — Milestone D.5 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D (chunk D.5).
##
## Verifies the `with EffectName { op: my_handler } do ... end` record-
## literal handler shape. When a user-provided handler is installed on
## the stack, `__qz_effect_perform` finds it before the blessed default
## handler (D.4) and dispatches through the user fn pointer. After the
## `with` body exits, MIR_HANDLE_UNINSTALL pops the user handler and
## the default becomes live again.
##
## D.5 MVP restrictions (documented in the handoff):
##   - Handler record must have at least one field.
##   - First field's value must be a bare identifier naming a user fn.
##   - Handler fn signature: `fn(op_name: Int): Int`. The Int param is
##     a raw C-string pointer to the op name (NOT a Quartz String — the
##     length prefix conversion lands in a follow-up milestone).
##   - Multi-op dispatch (user writes separate handlers per op in one
##     record) lands with D.6 resumable ops or a D.5b dispatch shim.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("user handler expressions (piezo D.5)") do ->
    it("user throw handler overrides default (exits 0, not 66)") do ->
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def my_throw(op_name: Int): Int
  puts("custom throw fired")
  return -1
end

def main(): Int
  with Throws { throw: my_throw } do ->
    throw("test")
  end
  return 0
end
""", 0)
    end

    it("user throw handler writes to stdout (not the default stderr line)") do ->
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def my_throw(op_name: Int): Int
  puts("custom throw fired")
  return -1
end

def main(): Int
  with Throws { throw: my_throw } do ->
    throw("test")
  end
  return 0
end
""", "custom throw fired\n")
    end

    it("user Log handler overrides default") do ->
      assert_run_stdout_eq("""
effect Log
  def emit(s: String): Int
end

def my_emit(op_name: Int): Int
  puts("captured log")
  return 0
end

def main(): Int
  with Log { emit: my_emit } do ->
    emit("whatever")
  end
  return 0
end
""", "captured log\n")
    end

    it("uninstall pops user handler — default takes back over after with") do ->
      # Inside `with`, custom handler runs (prints to stdout). OUTSIDE
      # the with, the default Throws handler fires (writes to stderr +
      # exit 66). So we expect exit 66 AND "custom throw fired" on
      # stdout from the first call.
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def my_throw(op_name: Int): Int
  puts("custom throw fired")
  return -1
end

def main(): Int
  with Throws { throw: my_throw } do ->
    throw("first — overridden")
  end
  throw("second — default handler, exits 66")
  return 0
end
""", 66)
    end

    it("uninstall-restore: first throw captured by user, second by default") do ->
      assert_run_stderr_contains("""
effect Throws
  def throw(msg: String): Int
end

def my_throw(op_name: Int): Int
  puts("custom captured")
  return -1
end

def main(): Int
  with Throws { throw: my_throw } do ->
    throw("first — overridden")
  end
  throw("second — default handler, exits 66")
  return 0
end
""", "second — default handler, exits 66")
    end

    it("QZ0613 still fires when struct-init handler names a non-effect") do ->
      assert_compile_error("""
def my_throw(op_name: Int): Int = 0

def main(): Int
  with NotAnEffect { throw: my_throw } do ->
    return 0
  end
  return 0
end
""", "QZ0613")
    end

    it("narrowing works for struct-init handlers (can Throws inside with)") do ->
      # The `risky()` callee has `can Throws`. Inside `with Throws {...}`,
      # the effect is considered handled and the bare `def main(): Int`
      # (no `can` row) can call `risky()` without needing `can Throws`.
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("boom")

def my_throw(op_name: Int): Int
  puts("caught")
  return 0
end

def main(): Int
  with Throws { throw: my_throw } do ->
    risky()
  end
  return 0
end
""", 0)
    end

    it("nested handlers: inner user handler wins while on stack") do ->
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def outer(op_name: Int): Int
  puts("outer")
  return 0
end

def inner(op_name: Int): Int
  puts("inner")
  return 0
end

def main(): Int
  with Throws { throw: outer } do ->
    with Throws { throw: inner } do ->
      throw("nested")
    end
    throw("back to outer")
  end
  return 0
end
""", "inner\nouter\n")
    end

    it("handler fn ptr appears in compiled IR") do ->
      assert_ir_contains("""
effect Throws
  def throw(msg: String): Int
end

def my_throw(op_name: Int): Int = 0

def main(): Int
  with Throws { throw: my_throw } do ->
    throw("x")
  end
  return 0
end
""", "ptrtoint ptr @my_throw to i64")
    end

    it("bare NODE_IDENT handler still lowers to null install (D.3 path)") do ->
      # Regression gate: the pre-D.5 handler shape (bare effect ident)
      # must still work — null install, default handler fires. This
      # guards against D.5 accidentally breaking the C.2/D.3 path.
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def main(): Int
  with Throws do ->
    throw("bare")
  end
  return 0
end
""", 66)
    end
  end
  return qspec_main()
end
