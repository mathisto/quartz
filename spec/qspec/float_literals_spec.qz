## Float Literals Tests
##
## Contract:
##   1. Adds two floats.
##   2. Compares floats with !=.
##   3. Compares floats with <.
##   4. Compares floats with <=.
##   5. Compares floats with ==.
##   6. Compares floats with >.
import * from qspec

def main(): Int
  describe("float literals") do ->
    it("parses simple float literal") do ->
      assert_eq(fl_simple(), 0)
    end
    it("parses float with no integer part") do ->
      assert_eq(fl_no_int(), 0)
    end
    it("parses float with exponent notation") do ->
      assert_eq(fl_exp_dot(), 1)
    end
    it("parses integer-like exponent as float") do ->
      assert_eq(fl_exp_int(), 1)
    end
    it("adds two floats") do ->
      assert_eq(fl_add(), 1)
    end
    it("subtracts two floats") do ->
      assert_eq(fl_sub(), 1)
    end
    it("multiplies two floats") do ->
      assert_eq(fl_mul(), 1)
    end
    it("divides two floats") do ->
      assert_eq(fl_div(), 1)
    end
    it("negates a float") do ->
      assert_eq(fl_neg(), 1)
    end
    it("compares floats with ==") do ->
      assert_eq(fl_eq(), 1)
    end
    it("compares floats with !=") do ->
      assert_eq(fl_ne(), 1)
    end
    it("compares floats with <") do ->
      assert_eq(fl_lt(), 1)
    end
    it("compares floats with >") do ->
      assert_eq(fl_gt(), 1)
    end
    it("compares floats with <=") do ->
      assert_eq(fl_le(), 1)
    end
    it("compares floats with >=") do ->
      assert_eq(fl_ge(), 1)
    end
    it("false comparison returns 0") do ->
      assert_eq(fl_false_cmp(), 0)
    end
    it("passes float as argument and returns it") do ->
      assert_eq(fl_pass_arg(), 1)
    end
    it("distinguishes 3 from 3.0") do ->
      assert_eq(fl_int_lit(), 3)
    end
    it("integer range still works") do ->
      assert_eq(fl_range(), 10)
    end
  end
  return qspec_main()
end

def fl_simple(): Int
  x = 3.14
  return 0
end
def fl_no_int(): Int
  x = 0.5
  return 0
end
def fl_add(): Int
  x = 3.0
  y = 2.0
  z = x + y
  if z == 5.0
    return 1
  end
  return 0
end
def fl_sub(): Int
  x = 5.0
  y = 3.0
  z = x - y
  if z == 2.0
    return 1
  end
  return 0
end
def fl_mul(): Int
  x = 3.0
  y = 4.0
  z = x * y
  if z == 12.0
    return 1
  end
  return 0
end
def fl_div(): Int
  x = 10.0
  y = 4.0
  z = x / y
  if z == 2.5
    return 1
  end
  return 0
end
def fl_neg(): Int
  x = 3.0
  y = -x
  if y == -3.0
    return 1
  end
  return 0
end
def fl_eq(): Int
  if 1.0 == 1.0
    return 1
  end
  return 0
end
def fl_ne(): Int
  if 1.0 != 2.0
    return 1
  end
  return 0
end
def fl_lt(): Int
  if 1.0 < 2.0
    return 1
  end
  return 0
end
def fl_gt(): Int
  if 3.0 > 2.0
    return 1
  end
  return 0
end
def fl_le(): Int
  if 2.0 <= 2.0
    return 1
  end
  return 0
end
def fl_ge(): Int
  if 2.0 >= 2.0
    return 1
  end
  return 0
end
def fl_false_cmp(): Int
  if 1.0 > 2.0
    return 1
  end
  return 0
end
def fl_double_it(x: F64): F64 = x + x
def fl_pass_arg(): Int
  r = fl_double_it(2.5)
  if r == 5.0
    return 1
  end
  return 0
end
def fl_int_lit(): Int
  x = 3
  return x
end
def fl_exp_dot(): Int
  x = 1.5e3
  if x == 1500.0
    return 1
  end
  return 0
end
def fl_exp_int(): Int
  x = 1e5
  if x == 100000.0
    return 1
  end
  return 0
end
def fl_range(): Int
  var sum = 0
  for i in 0..5
    sum += i
  end
  return sum
end
