## Sched-effect Sync regression spec — Phase C+D acceptance.
##
## PSQ-6 / Sched effect (`docs/design/SCHED_EFFECT_THREAD_SAFETY.md`).
##
## Phase B's call-site QZ1408 check (`sched_idle_hook_set` requires its
## first-arg callback to declare `can Sched`) is exercised by the
## existing `_live_idle_render` annotation in std/progress.qz.
##
## Phase C's body-walk Sync check fires QZ1408 inside any `can Sched`
## function body when a captured/global non-Sync binding is read.
## Wrapped reads via `mutex_lock` + `as_type<T>` to a fresh local are
## exempt — the canonical fix that closes PSQ-6 in std/progress.qz.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Sched effect — body-walk Sync check (Phase C)") do ->

    it("D.4 negative: bare Vec<Int> global read inside `can Sched` body fires QZ1408") do ->
      assert_compile_error("""
import std/sched

var g_data: Vec<Int> = vec_new<Int>()

def reader(): Void can Sched
  var sz = g_data.size
  puts("\#{sz}")
end

def main(): Int
  reader()
  return 0
end
""", "QZ1408")
    end

    it("D.1 positive: Mutex slot + lock + as_type<Vec<Int>> compiles clean") do ->
      assert_compile_succeeds("""
import std/sched

var g_data_mtx: Int = mutex_new(0)

def reader(): Void can Sched
  var raw = mutex_lock(g_data_mtx)
  if raw == 0
    mutex_unlock(g_data_mtx, 0)
    return
  end
  var data: Vec<Int> = as_type<Vec<Int>>(raw)
  var sz = data.size
  puts("\#{sz}")
  mutex_unlock(g_data_mtx, as_int(data))
end

def main(): Int
  reader()
  return 0
end
""")
    end

    it("D.6 edge: immutable String global read inside `can Sched` body is exempt") do ->
      assert_compile_succeeds("""
import std/sched

var g_label: String = "hello"

def reader(): Void can Sched
  puts(g_label)
end

def main(): Int
  reader()
  return 0
end
""")
    end

    it("function-pointer reads exempt: pass-by-name across Sched body is fine") do ->
      assert_compile_succeeds("""
import std/sched

def helper(): Int = 42

def reader(): Void can Sched
  var f = helper
  puts("ok")
end

def main(): Int
  reader()
  return 0
end
""")
    end

    it("inline lambda passed to `sched_idle_hook_set` capturing !Sync global fires QZ1408") do ->
      assert_compile_error("""
import std/sched

var g_data: Vec<Int> = vec_new<Int>()

def main(): Int
  sched_idle_hook_set(() -> {
    var sz = g_data.size
    puts("\#{sz}")
  })
  return 0
end
""", "QZ1408")
    end

    it("inline lambda passed to `sched_idle_hook_set` using Mutex compiles clean") do ->
      assert_compile_succeeds("""
import std/sched

var g_data_mtx: Int = mutex_new(0)

def main(): Int
  sched_idle_hook_set(() -> {
    var raw = mutex_lock(g_data_mtx)
    if raw == 0
      mutex_unlock(g_data_mtx, 0)
      return
    end
    var data: Vec<Int> = as_type<Vec<Int>>(raw)
    var sz = data.size
    puts("\#{sz}")
    mutex_unlock(g_data_mtx, as_int(data))
  })
  return 0
end
""")
    end

    it("inline lambda with no captures compiles clean") do ->
      assert_compile_succeeds("""
import std/sched

def main(): Int
  sched_idle_hook_set(() -> {
    puts("tick")
  })
  return 0
end
""")
    end

    it("D.3 positive: @thread_local Vec<Int> global read inside `can Sched` body is exempt") do ->
      assert_compile_succeeds("""
import std/sched

@thread_local
var g_data: Vec<Int> = vec_new<Int>()

def reader(): Void can Sched
  var sz = g_data.size
  puts("\#{sz}")
end

def main(): Int
  reader()
  return 0
end
""")
    end

    it("@thread_local Map<String, Int> global read inside `can Sched` body is exempt") do ->
      assert_compile_succeeds("""
import std/sched

@thread_local
var g_counts: Map<String, Int> = map_new<String, Int>()

def reader(): Void can Sched
  var n = g_counts.size
  puts("\#{n}")
end

def main(): Int
  reader()
  return 0
end
""")
    end

    it("Fn-typed local with `can Sched` annotation passed to sched_idle_hook_set compiles clean") do ->
      assert_compile_succeeds("""
import std/sched

def my_render(): Void can Sched
  puts("ok")
end

def main(): Int
  var f: Fn(): Void can Sched = my_render
  sched_idle_hook_set(f)
  return 0
end
""")
    end

    it("Fn-typed local without `can Sched` annotation passed to sched_idle_hook_set fires QZ1408") do ->
      assert_compile_error("""
import std/sched

def bare_render(): Void
  puts("ok")
end

def main(): Int
  var f: Fn(): Void = bare_render
  sched_idle_hook_set(f)
  return 0
end
""", "QZ1408")
    end

    it("Fn-typed local with `can OtherEffect` (wrong label) fires QZ1408") do ->
      assert_compile_error("""
import std/sched

effect OtherEff
  def __m(): Int = 0
end

def my_render(): Void can OtherEff
  puts("ok")
end

def main(): Int
  var f: Fn(): Void can OtherEff = my_render
  sched_idle_hook_set(f)
  return 0
end
""", "QZ1408")
    end

  end

  return qspec_main()
end
