import * from qspec

# ============================================================================
# Backpressure E2E — P24
#
# High-water mark intrinsics + try_send HWM signal.
# channel_set_high_water(ch, percent), channel_get_high_water(ch)
# try_send returns 2 when at or above HWM.
# ============================================================================

def test_set_get_hwm(): Int
  var ch = channel_new(100)
  channel_set_high_water(ch, 80)
  var hwm = channel_get_high_water(ch)
  if hwm == 80
    return 1
  end
  return 0
end

def test_hwm_default_zero(): Int
  var ch = channel_new(10)
  var hwm = channel_get_high_water(ch)
  if hwm == 0
    return 1
  end
  return 0
end

def test_try_send_no_hwm_returns_1(): Int
  var ch = channel_new(10)
  var r = try_send(ch, 42)
  if r == 1
    return 1
  end
  return 0
end

def test_try_send_below_hwm_returns_1(): Int
  # channel_new rounds to power-of-2 → cap=8
  var ch = channel_new(8)
  channel_set_high_water(ch, 80)
  # Fill to 25% (2 items)
  for i in 0..2
    send(ch, i)
  end
  # Send 3rd item — pressure = (3*100)/8 = 37%, below 80% HWM → returns 1
  var r = try_send(ch, 99)
  if r == 1
    return 1
  end
  return 0
end

def test_try_send_at_hwm_returns_2(): Int
  # channel_new rounds to power-of-2 → cap=8
  var ch = channel_new(8)
  channel_set_high_water(ch, 75)
  # Fill to 62.5% (5 items)
  for i in 0..5
    send(ch, i)
  end
  # Send 6th item — pressure = (6*100)/8 = 75%, HWM = 75% → at HWM → returns 2
  var r = try_send(ch, 99)
  if r == 2
    return 1
  end
  return 0
end

def test_try_send_above_hwm_returns_2(): Int
  # channel_new rounds to power-of-2 → cap=8
  var ch = channel_new(8)
  channel_set_high_water(ch, 50)
  # Fill to 50% (4 items)
  for i in 0..4
    send(ch, i)
  end
  # Send 5th item — pressure = (5*100)/8 = 62%, HWM = 50% → above HWM → returns 2
  var r = try_send(ch, 99)
  if r == 2
    return 1
  end
  return 0
end

def test_try_send_full_returns_0(): Int
  var ch = channel_new(4)
  channel_set_high_water(ch, 50)
  for i in 0..4
    send(ch, i)
  end
  # Channel full — try_send returns 0
  var r = try_send(ch, 99)
  if r == 0
    return 1
  end
  return 0
end

def test_hwm_unbounded_no_signal(): Int
  var ch = channel_new_unbounded()
  channel_set_high_water(ch, 50)
  # Unbounded channels always return 1 (no HWM check, infinite capacity)
  for i in 0..100
    send(ch, i)
  end
  var r = try_send(ch, 99)
  if r == 1
    return 1
  end
  return 0
end

def test_hwm_100_only_when_full(): Int
  var ch = channel_new(4)
  channel_set_high_water(ch, 100)
  # Fill to 75% (3 items)
  for i in 0..3
    send(ch, i)
  end
  # Send 4th item — pressure = 100%, HWM = 100% → at HWM → returns 2
  var r = try_send(ch, 99)
  if r == 2
    return 1
  end
  return 0
end

def main(): Int
  describe("P24 Backpressure E2E") do ->
    it("channel_set/get_high_water round-trip") do ->
      assert_eq(test_set_get_hwm(), 1)
    end

    it("default HWM is 0 (disabled)") do ->
      assert_eq(test_hwm_default_zero(), 1)
    end

    it("try_send returns 1 when no HWM set") do ->
      assert_eq(test_try_send_no_hwm_returns_1(), 1)
    end

    it("try_send returns 1 when below HWM") do ->
      assert_eq(test_try_send_below_hwm_returns_1(), 1)
    end

    it("try_send returns 2 when at HWM threshold") do ->
      assert_eq(test_try_send_at_hwm_returns_2(), 1)
    end

    it("try_send returns 2 when above HWM") do ->
      assert_eq(test_try_send_above_hwm_returns_2(), 1)
    end

    it("try_send returns 0 when full (even with HWM)") do ->
      assert_eq(test_try_send_full_returns_0(), 1)
    end

    it("unbounded channel ignores HWM (always returns 1)") do ->
      assert_eq(test_hwm_unbounded_no_signal(), 1)
    end

    it("HWM=100 only triggers when channel completely full") do ->
      assert_eq(test_hwm_100_only_when_full(), 1)
    end
  end

  return qspec_main()
end
