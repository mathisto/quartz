## v0.3.3 step 2-3 — Form skeleton + builders
##
## Step 2: form_new + struct shape.
## Step 3: form_with_field, form_with_validator, form_with_styles,
##         form_with_size.
##
## Update / view / accessors land in subsequent steps.

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/form as form
import std/tui/widgets/text_input as ti
import std/tui/layout as ly

enum SpecMsg
  Noop
end

def make_key_msg(code: Int): tui::FrameMsg<SpecMsg>
  return tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
end

# Build a 3-field form named a/b/c, all empty, validators Allow.
def make_3field_form(): form::Form
  var f = form::form_new()
  f = form::form_with_field(f, "a", "A", ti::text_input_new())
  f = form::form_with_field(f, "b", "B", ti::text_input_new())
  f = form::form_with_field(f, "c", "C", ti::text_input_new())
  return f
end

def state_is_editing(s: form::FormState): Int
  match s
    Editing => return 1
    _       => return 0
  end
end

def is_validator_required(v: form::Validator): Int
  match v
    Required => return 1
    _        => return 0
  end
end

def is_validator_min_len(v: form::Validator, expected: Int): Int
  match v
    MinLen(n) =>
      if n == expected
        return 1
      end
      return 0
    _ => return 0
  end
end

def main(): Int
  describe("Form skeleton (v0.3.3 step 2)") do ->

    it("form_new constructs an empty Form in Editing state") do ->
      var f = form::form_new()
      assert_eq(state_is_editing(f.state), 1)
      assert_eq(f.fields.size, 0)
      assert_eq(f.labels.size, 0)
      assert_eq(f.keys.size, 0)
      assert_eq(f.validators.size, 0)
      assert_eq(f.last_errors.size, 0)
    end

    it("form_new starts with width 0 and height 0 (auto)") do ->
      var f = form::form_new()
      assert_eq(f.width, 0)
      assert_eq(f.height, 0)
    end

  end

  describe("Form builders (v0.3.3 step 3)") do ->

    it("form_with_field appends a field with default Allow validator") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      assert_eq(f.fields.size, 1)
      assert_eq(f.labels.size, 1)
      assert_eq(f.keys.size, 1)
      assert_eq(f.validators.size, 1)
      assert_eq(f.last_errors.size, 1)
      assert_eq_str(f.keys[0], "name")
      assert_eq_str(f.labels[0], "Name")
    end

    it("first added field becomes focused") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L", ti::text_input_new())
      match f.focus.current
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)  # fail
      end
    end

    it("subsequent fields preserve initial focus") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      f = form::form_with_field(f, "b", "B", ti::text_input_new())
      f = form::form_with_field(f, "c", "C", ti::text_input_new())
      assert_eq(f.fields.size, 3)
      match f.focus.current
        Some(idx) => assert_eq(idx, 0)  # still on first
        None      => assert_eq(0, 1)
      end
    end

    it("form_with_validator sets validator by key") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_validator(f, "name", form::Validator::Required)
      assert_eq(is_validator_required(f.validators[0]), 1)
    end

    it("form_with_validator with payload preserves the payload") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_validator(f, "name", form::Validator::MinLen(5))
      assert_eq(is_validator_min_len(f.validators[0], 5), 1)
    end

    it("form_with_validator on missing key is no-op") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_validator(f, "missing", form::Validator::Required)
      # original Allow validator preserved
      assert_eq(is_validator_required(f.validators[0]), 0)
    end

    it("form_with_size sets width and height") do ->
      var f = form::form_new()
      f = form::form_with_size(f, 80, 24)
      assert_eq(f.width, 80)
      assert_eq(f.height, 24)
    end

    it("multiple fields keep parallel Vecs in sync") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_field(f, "seed", "Seed", ti::text_input_new())
      f = form::form_with_validator(f, "seed", form::Validator::Numeric)
      assert_eq(f.fields.size, 2)
      assert_eq(f.labels.size, 2)
      assert_eq(f.keys.size, 2)
      assert_eq(f.validators.size, 2)
      assert_eq(f.last_errors.size, 2)
      assert_eq_str(f.keys[0], "name")
      assert_eq_str(f.keys[1], "seed")
    end

  end

  describe("Form accessors + state setters (v0.3.3 step 4)") do ->

    it("form_field_count tracks the field Vec size") do ->
      var f = form::form_new()
      assert_eq(form::form_field_count(f), 0)
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      assert_eq(form::form_field_count(f), 1)
      f = form::form_with_field(f, "b", "B", ti::text_input_new())
      assert_eq(form::form_field_count(f), 2)
    end

    it("form_state returns the current state") do ->
      var f = form::form_new()
      assert_eq(state_is_editing(form::form_state(f)), 1)
    end

    it("form_focused_index returns Some(0) after first field") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L", ti::text_input_new())
      match form::form_focused_index(f)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
    end

    it("form_focused_index returns None for empty form") do ->
      var f = form::form_new()
      match form::form_focused_index(f)
        Some(_) => assert_eq(0, 1)
        None    => assert_eq(0, 0)
      end
    end

    it("form_get returns empty string for missing key") do ->
      var f = form::form_new()
      assert_eq_str(form::form_get(f, "nope"), "")
    end

    it("form_get returns empty string for newly-added field") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L", ti::text_input_new())
      assert_eq_str(form::form_get(f, "k"), "")
    end

    it("form_get_at returns empty string for out-of-range idx") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L", ti::text_input_new())
      assert_eq_str(form::form_get_at(f, 5), "")
      assert_eq_str(form::form_get_at(f, -1), "")
    end

    it("form_set_state transitions to Submitted") do ->
      var f = form::form_new()
      f = form::form_set_state(f, form::FormState::Submitted)
      match form::form_state(f)
        FormState::Submitted => assert_eq(0, 0)
        _                    => assert_eq(0, 1)
      end
    end

    it("form_set_focus moves focus by index") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      f = form::form_with_field(f, "b", "B", ti::text_input_new())
      f = form::form_with_field(f, "c", "C", ti::text_input_new())
      f = form::form_set_focus(f, 2)
      match form::form_focused_index(f)
        Some(idx) => assert_eq(idx, 2)
        None      => assert_eq(0, 1)
      end
    end

    it("form_set_focus is no-op for out-of-range idx") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      f = form::form_set_focus(f, 5)
      # focus stays on 0
      match form::form_focused_index(f)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
    end

    it("form_clear resets state to Editing and focus to 0") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      f = form::form_with_field(f, "b", "B", ti::text_input_new())
      f = form::form_set_focus(f, 1)
      f = form::form_set_state(f, form::FormState::Cancelled)
      f = form::form_clear(f)
      assert_eq(state_is_editing(form::form_state(f)), 1)
      match form::form_focused_index(f)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
      assert_eq(form::form_field_count(f), 2)  # fields preserved
    end

    it("form_errors is parallel to fields after construction") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "a", "A", ti::text_input_new())
      f = form::form_with_field(f, "b", "B", ti::text_input_new())
      var errs = form::form_errors(f)
      assert_eq(errs.size, 2)
    end

  end

  describe("Form validators (v0.3.3 step 5)") do ->

    # Build a form with a single field with the given validator and the
    # given pre-set value, then run form_validate and return the error
    # for the only field.
    # The factory is hoisted so the lambda has stable capture shape.
    it("Allow validator always returns None") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), ""))
      f = form::form_with_validator(f, "k", form::Validator::Allow)
      f = form::form_validate(f)
      match form::form_errors(f)[0]
        Some(_) => assert_eq(0, 1)
        None    => assert_eq(0, 0)
      end
      assert_eq(_b2i(form::form_is_valid(f)), 1)
    end

    it("Required rejects empty, accepts non-empty") do ->
      var fe = form::form_new()
      fe = form::form_with_field(fe, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), ""))
      fe = form::form_with_validator(fe, "k", form::Validator::Required)
      assert_eq(_b2i(form::form_is_valid(fe)), 0)

      var fn = form::form_new()
      fn = form::form_with_field(fn, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "ok"))
      fn = form::form_with_validator(fn, "k", form::Validator::Required)
      assert_eq(_b2i(form::form_is_valid(fn)), 1)
    end

    it("MinLen rejects short, accepts long") do ->
      var fe = form::form_new()
      fe = form::form_with_field(fe, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "ab"))
      fe = form::form_with_validator(fe, "k", form::Validator::MinLen(3))
      assert_eq(_b2i(form::form_is_valid(fe)), 0)

      var fn = form::form_new()
      fn = form::form_with_field(fn, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abc"))
      fn = form::form_with_validator(fn, "k", form::Validator::MinLen(3))
      assert_eq(_b2i(form::form_is_valid(fn)), 1)
    end

    it("MaxLen rejects long, accepts short") do ->
      var fe = form::form_new()
      fe = form::form_with_field(fe, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abcde"))
      fe = form::form_with_validator(fe, "k", form::Validator::MaxLen(3))
      assert_eq(_b2i(form::form_is_valid(fe)), 0)

      var fn = form::form_new()
      fn = form::form_with_field(fn, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abc"))
      fn = form::form_with_validator(fn, "k", form::Validator::MaxLen(3))
      assert_eq(_b2i(form::form_is_valid(fn)), 1)
    end

    it("LenRange enforces both bounds") do ->
      var fmin = form::form_new()
      fmin = form::form_with_field(fmin, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "ab"))
      fmin = form::form_with_validator(fmin, "k", form::Validator::LenRange(3, 5))
      assert_eq(_b2i(form::form_is_valid(fmin)), 0)

      var fmax = form::form_new()
      fmax = form::form_with_field(fmax, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abcdef"))
      fmax = form::form_with_validator(fmax, "k", form::Validator::LenRange(3, 5))
      assert_eq(_b2i(form::form_is_valid(fmax)), 0)

      var fok = form::form_new()
      fok = form::form_with_field(fok, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abcd"))
      fok = form::form_with_validator(fok, "k", form::Validator::LenRange(3, 5))
      assert_eq(_b2i(form::form_is_valid(fok)), 1)
    end

    it("Numeric accepts integers, rejects letters") do ->
      var fok = form::form_new()
      fok = form::form_with_field(fok, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "12345"))
      fok = form::form_with_validator(fok, "k", form::Validator::Numeric)
      assert_eq(_b2i(form::form_is_valid(fok)), 1)

      var fbad = form::form_new()
      fbad = form::form_with_field(fbad, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abc"))
      fbad = form::form_with_validator(fbad, "k", form::Validator::Numeric)
      assert_eq(_b2i(form::form_is_valid(fbad)), 0)

      var fneg = form::form_new()
      fneg = form::form_with_field(fneg, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "-42"))
      fneg = form::form_with_validator(fneg, "k", form::Validator::Numeric)
      assert_eq(_b2i(form::form_is_valid(fneg)), 1)
    end

    it("IntRange enforces parsed-and-in-range") do ->
      var fok = form::form_new()
      fok = form::form_with_field(fok, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "50"))
      fok = form::form_with_validator(fok, "k", form::Validator::IntRange(1, 100))
      assert_eq(_b2i(form::form_is_valid(fok)), 1)

      var flow = form::form_new()
      flow = form::form_with_field(flow, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "0"))
      flow = form::form_with_validator(flow, "k", form::Validator::IntRange(1, 100))
      assert_eq(_b2i(form::form_is_valid(flow)), 0)

      var fhigh = form::form_new()
      fhigh = form::form_with_field(fhigh, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "101"))
      fhigh = form::form_with_validator(fhigh, "k", form::Validator::IntRange(1, 100))
      assert_eq(_b2i(form::form_is_valid(fhigh)), 0)

      var fparse = form::form_new()
      fparse = form::form_with_field(fparse, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abc"))
      fparse = form::form_with_validator(fparse, "k", form::Validator::IntRange(1, 100))
      assert_eq(_b2i(form::form_is_valid(fparse)), 0)
    end

    it("NonWhitespace rejects all-spaces") do ->
      var fbad = form::form_new()
      fbad = form::form_with_field(fbad, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "   "))
      fbad = form::form_with_validator(fbad, "k", form::Validator::NonWhitespace)
      assert_eq(_b2i(form::form_is_valid(fbad)), 0)

      var fok = form::form_new()
      fok = form::form_with_field(fok, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), " a "))
      fok = form::form_with_validator(fok, "k", form::Validator::NonWhitespace)
      assert_eq(_b2i(form::form_is_valid(fok)), 1)
    end

    it("StartsWith / EndsWith / Equals match exactly") do ->
      var fst = form::form_new()
      fst = form::form_with_field(fst, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "ironclad-2025"))
      fst = form::form_with_validator(fst, "k", form::Validator::StartsWith("ironclad"))
      assert_eq(_b2i(form::form_is_valid(fst)), 1)

      var fend = form::form_new()
      fend = form::form_with_field(fend, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "save.json"))
      fend = form::form_with_validator(fend, "k", form::Validator::EndsWith(".json"))
      assert_eq(_b2i(form::form_is_valid(fend)), 1)

      var feq = form::form_new()
      feq = form::form_with_field(feq, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "yes"))
      feq = form::form_with_validator(feq, "k", form::Validator::Equals("yes"))
      assert_eq(_b2i(form::form_is_valid(feq)), 1)

      var fbad = form::form_new()
      fbad = form::form_with_field(fbad, "k", "L",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "no"))
      fbad = form::form_with_validator(fbad, "k", form::Validator::Equals("yes"))
      assert_eq(_b2i(form::form_is_valid(fbad)), 0)
    end

    it("form_validate populates last_errors with messages") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name",
        ti::text_input_set_value_unchecked(ti::text_input_new(), ""))
      f = form::form_with_field(f, "seed", "Seed",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "abc"))
      f = form::form_with_validator(f, "name", form::Validator::Required)
      f = form::form_with_validator(f, "seed", form::Validator::Numeric)
      f = form::form_validate(f)
      var errs = form::form_errors(f)
      match errs[0]
        Some(_) => assert_eq(0, 0)
        None    => assert_eq(0, 1)
      end
      match errs[1]
        Some(_) => assert_eq(0, 0)
        None    => assert_eq(0, 1)
      end
    end

    it("form_is_valid short-circuits on first failure") do ->
      # All fields valid → true
      var fok = form::form_new()
      fok = form::form_with_field(fok, "a", "A",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "hello"))
      fok = form::form_with_field(fok, "b", "B",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "42"))
      fok = form::form_with_validator(fok, "a", form::Validator::Required)
      fok = form::form_with_validator(fok, "b", form::Validator::Numeric)
      assert_eq(_b2i(form::form_is_valid(fok)), 1)

      # First field invalid → false, regardless of second
      var fbad = form::form_new()
      fbad = form::form_with_field(fbad, "a", "A",
        ti::text_input_set_value_unchecked(ti::text_input_new(), ""))
      fbad = form::form_with_field(fbad, "b", "B",
        ti::text_input_set_value_unchecked(ti::text_input_new(), "42"))
      fbad = form::form_with_validator(fbad, "a", form::Validator::Required)
      fbad = form::form_with_validator(fbad, "b", form::Validator::Numeric)
      assert_eq(_b2i(form::form_is_valid(fbad)), 0)
    end

  end

  describe("Form update — Tab / Esc / Enter / forward (v0.3.3 step 6)") do ->

    it("Tab cycles focus forward, emits FieldFocused") do ->
      var f = make_3field_form()
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_TAB()))
      var f2 = triple.0
      var ev = triple.2
      match form::form_focused_index(f2)
        Some(idx) => assert_eq(idx, 1)
        None      => assert_eq(0, 1)
      end
      match ev
        FieldFocused(idx) => assert_eq(idx, 1)
        _                 => assert_eq(0, 1)
      end
    end

    it("Tab on last field wraps to first") do ->
      var f = make_3field_form()
      f = form::form_set_focus(f, 2)
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_TAB()))
      var f2 = triple.0
      match form::form_focused_index(f2)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
    end

    it("Tab on empty form is Idle") do ->
      var f = form::form_new()
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_TAB()))
      var ev = triple.2
      match ev
        FormEvent::Idle => assert_eq(0, 0)
        _               => assert_eq(0, 1)
      end
    end

    it("Esc transitions to Cancelled and emits Cancelled") do ->
      var f = make_3field_form()
      var triple = form::form_update<SpecMsg>(f, make_key_msg(27))
      var f2 = triple.0
      var ev = triple.2
      match form::form_state(f2)
        FormState::Cancelled => assert_eq(0, 0)
        _                    => assert_eq(0, 1)
      end
      match ev
        FormEvent::Cancelled => assert_eq(0, 0)
        _                    => assert_eq(0, 1)
      end
    end

    it("Enter on valid non-last advances to next field") do ->
      var f = make_3field_form()
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_ENTER()))
      var f2 = triple.0
      match form::form_focused_index(f2)
        Some(idx) => assert_eq(idx, 1)
        None      => assert_eq(0, 1)
      end
    end

    it("Enter on invalid non-last stays + emits FieldChanged + sets error") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_field(f, "next", "Next", ti::text_input_new())
      f = form::form_with_validator(f, "name", form::Validator::Required)
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_ENTER()))
      var f2 = triple.0
      var ev = triple.2
      # Focus should not have advanced
      match form::form_focused_index(f2)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
      # FieldChanged(0) emitted
      match ev
        FieldChanged(idx) => assert_eq(idx, 0)
        _                 => assert_eq(0, 1)
      end
      # Error populated for field 0
      match form::form_errors(f2)[0]
        Some(_) => assert_eq(0, 0)
        None    => assert_eq(0, 1)
      end
    end

    it("Enter on last with all valid transitions to Submitted") do ->
      var f = make_3field_form()
      f = form::form_set_focus(f, 2)
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_ENTER()))
      var f2 = triple.0
      var ev = triple.2
      match form::form_state(f2)
        FormState::Submitted => assert_eq(0, 0)
        _                    => assert_eq(0, 1)
      end
      match ev
        FormEvent::Submitted => assert_eq(0, 0)
        _                    => assert_eq(0, 1)
      end
    end

    it("Enter on last with some invalid focuses first invalid") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name", ti::text_input_new())
      f = form::form_with_field(f, "tail", "Tail", ti::text_input_new())
      f = form::form_with_validator(f, "name", form::Validator::Required)
      f = form::form_set_focus(f, 1)
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_ENTER()))
      var f2 = triple.0
      # State stays Editing
      assert_eq(state_is_editing(form::form_state(f2)), 1)
      # Focus jumps to first invalid (idx 0)
      match form::form_focused_index(f2)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
    end

    it("Once state is Submitted, further updates return Idle (absorbing)") do ->
      var f = make_3field_form()
      f = form::form_set_state(f, form::FormState::Submitted)
      var triple = form::form_update<SpecMsg>(f, make_key_msg(terminal::KEY_TAB()))
      var ev = triple.2
      match ev
        FormEvent::Idle => assert_eq(0, 0)
        _               => assert_eq(0, 1)
      end
      # Focus didn't advance
      match form::form_focused_index(triple.0)
        Some(idx) => assert_eq(idx, 0)
        None      => assert_eq(0, 1)
      end
    end

    it("Printable keys forward to focused field, emit FieldChanged") do ->
      var f = make_3field_form()
      var triple = form::form_update<SpecMsg>(f, make_key_msg(65))   # 'A'
      var f2 = triple.0
      var ev = triple.2
      assert_eq_str(form::form_get_at(f2, 0), "A")
      match ev
        FieldChanged(idx) => assert_eq(idx, 0)
        _                 => assert_eq(0, 1)
      end
    end

    it("Forwarding re-runs validator on changed value") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "n", "N", ti::text_input_new())
      f = form::form_with_validator(f, "n", form::Validator::Numeric)
      # Type 'a' — value becomes "a", which fails Numeric.
      var triple = form::form_update<SpecMsg>(f, make_key_msg(97))
      var f2 = triple.0
      match form::form_errors(f2)[0]
        Some(_) => assert_eq(0, 0)
        None    => assert_eq(0, 1)
      end
    end

  end

  describe("Form view + set_size (v0.3.3 step 7-8)") do ->

    it("empty form renders empty string") do ->
      var f = form::form_new()
      assert_eq_str(form::form_view(f, true), "")
    end

    it("view contains all field labels") do ->
      var f = make_3field_form()
      var v = ly::strip_styles(form::form_view(f, true))
      # Labels A, B, C should all appear
      var has_a = false
      var has_b = false
      var has_c = false
      var i = 0
      while i < v.size
        var c = v[i]
        if c == 65
          has_a = true
        end
        if c == 66
          has_b = true
        end
        if c == 67
          has_c = true
        end
        i = i + 1
      end
      assert_eq(_b2i(has_a), 1)
      assert_eq(_b2i(has_b), 1)
      assert_eq(_b2i(has_c), 1)
    end

    it("view shows error line when last_errors is populated") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "name", "Name",
        ti::text_input_set_value_unchecked(ti::text_input_new(), ""))
      f = form::form_with_validator(f, "name", form::Validator::Required)
      f = form::form_validate(f)
      var v = ly::strip_styles(form::form_view(f, true))
      # "required" error should appear in rendered output
      var has_required = false
      # search for byte sequence "required"
      var target = "required"
      var i = 0
      while i + target.size <= v.size
        var match_here = true
        var j = 0
        while j < target.size
          if v[i + j] != target[j]
            match_here = false
          end
          j = j + 1
        end
        if match_here
          has_required = true
        end
        i = i + 1
      end
      assert_eq(_b2i(has_required), 1)
    end

    it("view with focused=false renders no focused field") do ->
      var f = make_3field_form()
      var styled = form::form_view(f, false)
      # When focused is false, no field is "focused" — but render
      # still produces output. We just assert non-empty.
      assert_eq(_b2i(styled.size > 0), 1)
    end

    it("form_set_size sets width and height fields") do ->
      var f = form::form_new()
      f = form::form_with_field(f, "k", "L", ti::text_input_new())
      f = form::form_set_size(f, 80, 24)
      assert_eq(f.width, 80)
      assert_eq(f.height, 24)
    end

  end

  return qspec_main()
end

# Helper: bool → int for assert_eq.
def _b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end
