## PSQ-5 regression: `eputs` auto-appends a newline like `puts`.
##
## The stdlib contract is: `puts`/`eputs` write their argument followed
## by a single `\n` to stdout/stderr respectively. Passing a string
## that already ends in `\n` produces two newlines in the output — this
## is expected, not a bug, but it burned the progress sprint when a
## caller assumed `eputs` behaved like `fprintf(stderr, "%s", s)`.
##
## Lock in the auto-newline contract so nobody accidentally "fixes"
## eputs to not append a newline — that would silently break every
## caller that currently relies on the behavior.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("eputs/puts auto-newline contract") do ->
    it("eputs without trailing newline writes exactly one newline to stderr") do ->
      assert_run_stderr_contains("""
        def main(): Int
          eputs("hello")
          return 0
        end
      """, "hello\n")
    end

    it("eputs with trailing newline writes two newlines (expected, not a bug)") do ->
      assert_run_stderr_contains("""
        def main(): Int
          eputs("line1\\n")
          return 0
        end
      """, "line1\n\n")
    end

    it("puts without trailing newline writes exactly one newline to stdout") do ->
      assert_run_stdout_eq("""
        def main(): Int
          puts("hi")
          return 0
        end
      """, "hi\n")
    end
  end

  return qspec_main()
end
