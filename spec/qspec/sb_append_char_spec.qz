## sb_append_char UTF-8 Encoding Tests
##
## Verifies that sb_append_char correctly encodes codepoints as UTF-8,
## not just truncating to a single byte. This was a compiler bug where
## `trunc i64 to i8` discarded all bits above 7.

import * from qspec
import * from unicode
import traits

def print_ascii(): Void
  var sb = sb_new()
  sb_append_char(sb, 65)
  puts(sb_to_string(sb))
end

def print_2byte_len(): Void
  var sb = sb_new()
  sb_append_char(sb, 233)
  puts(str_from_int(str_byte_len(sb_to_string(sb))))
end

def print_3byte_len(): Void
  var sb = sb_new()
  sb_append_char(sb, 0x4E2D)
  puts(str_from_int(str_byte_len(sb_to_string(sb))))
end

def print_4byte_len(): Void
  var sb = sb_new()
  sb_append_char(sb, 0x1F600)
  puts(str_from_int(str_byte_len(sb_to_string(sb))))
end

def main(): Int
  describe("sb_append_char UTF-8 encoding") do ->
    it("encodes ASCII (1 byte)") do ->
      var sb = sb_new()
      sb_append_char(sb, 65)
      var s = sb_to_string(sb)
      assert_eq(str_byte_len(s), 1)
      assert_eq(str_byte_at(s, 0), 65)
    end

    it("encodes 2-byte codepoint (U+00E9)") do ->
      var sb = sb_new()
      sb_append_char(sb, 233)
      var s = sb_to_string(sb)
      assert_eq(str_byte_len(s), 2)
      assert_eq(str_byte_at(s, 0), 0xC3)
      assert_eq(str_byte_at(s, 1), 0xA9)
    end

    it("encodes 3-byte codepoint (U+4E2D)") do ->
      var sb = sb_new()
      sb_append_char(sb, 0x4E2D)
      var s = sb_to_string(sb)
      assert_eq(str_byte_len(s), 3)
      assert_eq(str_byte_at(s, 0), 0xE4)
      assert_eq(str_byte_at(s, 1), 0xB8)
      assert_eq(str_byte_at(s, 2), 0xAD)
    end

    it("encodes 4-byte codepoint (U+1F600)") do ->
      var sb = sb_new()
      sb_append_char(sb, 0x1F600)
      var s = sb_to_string(sb)
      assert_eq(str_byte_len(s), 4)
      assert_eq(str_byte_at(s, 0), 0xF0)
      assert_eq(str_byte_at(s, 1), 0x9F)
      assert_eq(str_byte_at(s, 2), 0x98)
      assert_eq(str_byte_at(s, 3), 0x80)
    end

    it("round-trips through codepoint iteration") do ->
      var sb = sb_new()
      sb_append_char(sb, 233)
      var s = sb_to_string(sb)
      var cps = vec_new()
      for cp in str_codepoints(s)
        cps.push(cp)
      end
      assert_eq(cps.size, 1)
      assert_eq(cps[0], 233)
    end

    it("output matches") do ->
      assert_output("A\n", print_ascii)
      assert_output("2\n", print_2byte_len)
      assert_output("3\n", print_3byte_len)
      assert_output("4\n", print_4byte_len)
    end
  end

  return qspec_main()
end
