## Value Types Tests — Memory Model V2
## Validates that @value structs use stack alloca instead of malloc.
##
## Contract:
##   1. Create+read: @value struct fields readable.
##   2. 3-field: @value struct with 3 fields works.
##   3. Multiple: multiple @value structs in same function.
##   4. Field assign: @value struct field assignment works.
##   5. Pair access: Pair struct field access works.
##   6. Backward compat: regular structs still use heap.
##   7. Computed fields: @value struct with computed field values.
##   8. Zero fields: @value struct fields initialized to 0.

import * from qspec

# === @value struct definitions ===

@value
struct Point
  x: Int
  y: Int
end

@value
struct Color
  r: Int
  g: Int
  b: Int
end

@value
struct Pair
  first: Int
  second: Int
end

# Regular struct (heap-allocated, for backward compat testing)
struct HeapPoint
  x: Int
  y: Int
end

# === Tests ===

def vt_create_and_read(): Int
  var p = Point { x: 10, y: 20 }
  return p.x + p.y  # 30
end

def vt_three_fields(): Int
  var c = Color { r: 255, g: 128, b: 0 }
  return c.r + c.g + c.b  # 383
end

def vt_pass_to_function(p: Int): Int
  var pt = as_point(p)
  return pt.x * pt.y
end

def as_point(p: Int): Point
  # This is a workaround — in FAF, struct pointers are just i64s
  # We create and return to test passing
  return Point { x: 0, y: 0 }
end

def vt_create_multiple(): Int
  var a = Point { x: 1, y: 2 }
  var b = Point { x: 3, y: 4 }
  return a.x + a.y + b.x + b.y  # 10
end

def vt_field_assign(): Int
  var p = Point { x: 5, y: 10 }
  p.x = 100
  return p.x + p.y  # 110
end

def vt_heap_still_works(): Int
  var p = HeapPoint { x: 42, y: 58 }
  return p.x + p.y  # 100
end

def vt_nested_access(): Int
  var p = Pair { first: 7, second: 11 }
  var sum = p.first + p.second  # 18
  return sum
end

def main(): Int
  describe("@value struct creation") do ->
    it("creates and reads fields") do ->
      assert_eq(vt_create_and_read(), 30)
    end

    it("works with 3 fields") do ->
      assert_eq(vt_three_fields(), 383)
    end
  end

  describe("@value struct operations") do ->
    it("supports multiple structs in same function") do ->
      assert_eq(vt_create_multiple(), 10)
    end

    it("supports field assignment") do ->
      assert_eq(vt_field_assign(), 110)
    end

    it("supports field access on Pair") do ->
      assert_eq(vt_nested_access(), 18)
    end
  end

  describe("backward compatibility") do ->
    it("regular structs still use heap allocation") do ->
      assert_eq(vt_heap_still_works(), 100)
    end
  end

  describe("computed values") do ->
    it("@value struct with computed field values") do ->
      var a = 3
      var b = 4
      var p = Point { x: a * a, y: b * b }
      assert_eq(p.x + p.y, 25)
    end

    it("@value struct fields initialized to zero") do ->
      var p = Point { x: 0, y: 0 }
      assert_eq(p.x + p.y, 0)
    end
  end

  return qspec_main()
end
