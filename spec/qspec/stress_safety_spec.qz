## STRESS Wave 2: Safety Adversarial Tests
##
## Push the borrow checker, move semantics, and Drop system to their limits.
## Extends SAH (Wave 1) with deeper nesting, more complex control flow,
## and cross-feature interactions.
##
## Bugs found during stress testing:
##   1. FIXED: Re-init after move — binary was stale (SAH Bug D fix was in
##      source but not compiled in). Rebuild activates re-init reset in
##      NODE_LET reassignment handler (move_states[i] = 2→1).
##   2. FIXED: Match arm move tracking — added per-arm snapshot/restore of
##      move states with N-way merge after all arms. QZ1214 for inconsistent
##      moves, consistent moves allowed.
##   3. FIXED: Re-init in if-branch works correctly — the re-init resets
##      move state within the branch, so merge sees Live in both branches.
##
## Contract:
##   1. Moves: deeply nested control flow.
##   2. Moves: function call sequences.
##   3. Borrows: stress.
##   4. Drop: control flow interaction.
##   5. NLL: edge cases.
##   6. Copy: trait interaction.
##   7. Moves: in match arms.
##   8. Moves: struct field access after move.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Deeply Nested Move Tracking
  # ===========================================================================
  describe("moves: deeply nested control flow") do ->
    it("move inside 3-level nested if/else is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def use_it(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          if 1
            if 1
              if 1
                consume(a)
              end
            end
          end
          use_it(a)
          return 0
        end
        """, "QZ1214")
    end

    it("move in both branches of 3-level nested if is OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          if 1
            if 1
              if 1
                return consume(a)
              else
                return consume(a)
              end
            else
              return consume(a)
            end
          else
            return consume(a)
          end
        end
        """, 42)
    end

    it("move in if-branch, re-init in if-branch, use after if is OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 10 }
          if 1
            consume(a)
            a = Res { x: 42 }
          end
          return consume(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Move + Function Call Sequences
  # ===========================================================================
  describe("moves: function call sequences") do ->
    it("function takes ownership, caller cannot use value after") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          consume(a)
          return a.x
        end
        """, "QZ1212")
    end

    it("sequential moves to different functions are rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def head_of(r: Res): Int = r.x
        def second(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          head_of(a)
          second(a)
          return 0
        end
        """, "QZ1212")
    end

    it("re-init between sequential calls is allowed") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def head_of(r: Res): Int = r.x
        def second(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 10 }
          head_of(a)
          a = Res { x: 42 }
          return second(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Borrow Checker Stress
  # ===========================================================================
  describe("borrows: stress") do ->
    it("multiple shared borrows of same value are allowed") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r1 = &x
          var r2 = &x
          var r3 = &x
          return r1 + r2 + r3 - 42 - 42
        end
        """, 42)
    end

    it("shared borrow + mutation attempt is rejected (QZ1209)") do ->
      assert_compile_error("""
        def main(): Int
          var x = 10
          var r = &x
          x = 20
          return r + 0
        end
        """, "QZ1209")
    end

    it("&mut borrow then shared borrow is rejected") do ->
      assert_compile_error("""
        def main(): Int
          var x = 10
          var r = &mut x
          var r2 = &x
          return 0
        end
        """, "QZ1206")
    end

    it("borrow inside loop, loop iteration releases previous") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          var i = 0
          while i < 5
            var r = &x
            var v = r + 0
            i = i + 1
          end
          x = 42
          return x
        end
        """, 42)
    end

    it("return borrow of local is rejected (QZ1210)") do ->
      assert_compile_error("""
        def bad(): Int
          var local = 42
          return &local
        end
        def main(): Int
          return bad()
        end
        """, "QZ1210")
    end

    it("borrow of function parameter is allowed") do ->
      assert_run_exits("""
        def use_ref(x: Int): Int
          var r = &x
          return r + 0
        end
        def main(): Int
          return use_ref(42)
        end
        """, 42)
    end

    it("borrow in outer scope, use in inner if-scope") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var r = &x
          if 1
            return r + 0
          end
          return 0
        end
        """, 42)
    end

    it("compound assignment while borrowed is rejected") do ->
      assert_compile_error("""
        def main(): Int
          var x = 10
          var r = &x
          x += 5
          return r + 0
        end
        """, "QZ1209")
    end
  end

  # ===========================================================================
  # Category D: Drop Interaction with Control Flow
  # ===========================================================================
  describe("drop: control flow interaction") do ->
    it("moved value is not double-dropped (drop count = 1)") do ->
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def consume(r: Tracked): Int = r.x
        def main(): Int
          var a = Tracked { x: 1 }
          consume(a)
          return drop_count
        end
        """, 1)
    end

    it("value not consumed has drop_count = 0 at return") do ->
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def main(): Int
          var a = Tracked { x: 1 }
          return drop_count
        end
        """, 0)
    end

    it("two Drop values consumed in same call") do ->
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def consume_both(a: Tracked, b: Tracked): Int = a.x + b.x
        def main(): Int
          var a = Tracked { x: 1 }
          var b = Tracked { x: 2 }
          return consume_both(a, b) + 39
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: NLL Edge Cases
  # ===========================================================================
  describe("NLL: edge cases") do ->
    it("borrow used only in first half, mutation in second half — NLL allows") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          var r = &x
          var v = r + 0
          ## r's last use is above — NLL releases the borrow
          x = 42
          return x
        end
        """, 42)
    end

    it("borrow in if-branch only, mutation after if — NLL allows") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          if 1
            var r = &x
            var v = r + 0
          end
          x = 42
          return x
        end
        """, 42)
    end

    it("last use of borrow in function call argument") do ->
      assert_run_exits("""
        def use_val(v: Int): Int = v
        def main(): Int
          var x = 10
          var r = &x
          var v = use_val(r + 0)
          ## r's last use was in the call above
          x = 42
          return x
        end
        """, 42)
    end

    it("borrow outlives its last use — mutation between uses rejected") do ->
      assert_compile_error("""
        def main(): Int
          var x = 10
          var r = &x
          x = 20
          return r + 0
        end
        """, "QZ1209")
    end

    it("NLL released borrow allows subsequent mutation and re-borrow") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          var r1 = &x
          var v1 = r1 + 0
          ## r1 released by NLL
          x = 42
          var r2 = &x
          return r2 + 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Copy Trait Interaction
  # ===========================================================================
  describe("Copy: trait interaction") do ->
    it("Copy+Drop conflict is rejected (QZ1215)") do ->
      assert_compile_error("""
        trait Copy end
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Bad
          x: Int
        end
        extend Bad with Copy
        end
        extend Bad with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int = 0
        """, "QZ1215")
    end

    it("Copy type can be used after 'move' (copy semantics)") do ->
      assert_run_exits("""
        trait Copy end
        struct CopyVal
          x: Int
        end
        extend CopyVal with Copy
        end
        def consume(v: CopyVal): Int = v.x
        def main(): Int
          var a = CopyVal { x: 42 }
          consume(a)
          return consume(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Move in Match Arms
  # ===========================================================================
  describe("moves: in match arms") do ->
    it("value moved in every match arm, no use after — OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var result = 0
          match 1
            1 => result = consume(a)
            2 => result = consume(a)
            _ => result = consume(a)
          end
          return result
        end
        """, 42)
    end

    it("value moved in one arm only — QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end

    it("match on integer with no move tracking is OK") do ->
      assert_run_exits("""
        def main(): Int
          var x = 7
          match x
            7 => return 42
            _ => return 0
          end
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category H: Struct Field Access After Move
  # ===========================================================================
  describe("moves: struct field access after move") do ->
    it("field access on moved struct is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1, y: 2 }
          consume(a)
          return a.y
        end
        """, "QZ1212")
    end

    it("field move (partial move) tracked correctly") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def use_res(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1, y: 2 }
          consume(a.x)
          use_res(a)
          return 0
        end
        """, "QZ1216")
    end
  end

  return qspec_main()
end
