## Regex Tests
##
## Contract:
##   1. !~ returns false on.
##   2. !~ returns true on.
##   3. =~ returns false on.
##   4. =~ returns true on.
##   5. =~ with regex variable.
##   6. =~ with string variable.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("regex") do ->
    it("parses regex literal") do ->
      assert_run_exits("def main(): Int\n  var x = \"hello\" =~ ~r\"hello\"\n  return x\nend\n", 1)
    end
    it("parses regex with groups") do ->
      assert_run_exits("def main(): Int\n  var x = \"abcabc\" =~ ~r\"(abc)+\"\n  return x\nend\n", 1)
    end
    it("parses regex with character classes") do ->
      assert_run_exits("def main(): Int\n  var x = \"abc123\" =~ ~r\"[0-9]+\"\n  return x\nend\n", 1)
    end
    it("parses regex with quantifiers") do ->
      assert_run_exits("def main(): Int\n  var x = \"aaab\" =~ ~r\"a+b\"\n  return x\nend\n", 1)
    end
    it("stores regex in variable") do ->
      assert_run_exits("def main(): Int\n  var r = ~r\"hello\"\n  var x = \"hello world\" =~ r\n  return x\nend\n", 1)
    end
    it("passes regex to function") do ->
      assert_run_exits("def check(r: Regex, s: String): Int = s =~ r\ndef main(): Int = check(~r\"test\", \"this is a test\")\n", 1)
    end
    it("=~ returns true on match") do ->
      assert_run_stdout_eq("def main(): Int\n  print_int(\"hello\" =~ ~r\"hello\")\n  return 0\nend\n", "1\n")
    end
    it("=~ returns false on no match") do ->
      assert_run_stdout_eq("def main(): Int\n  print_int(\"hello\" =~ ~r\"xyz\")\n  return 0\nend\n", "0\n")
    end
    it("=~ with string variable") do ->
      assert_run_stdout_eq("def main(): Int\n  var s = \"hello\"\n  print_int(s =~ ~r\"hello\")\n  return 0\nend\n", "1\n")
    end
    it("=~ with regex variable") do ->
      assert_run_stdout_eq("def main(): Int\n  var r = ~r\"hello\"\n  print_int(\"hello\" =~ r)\n  return 0\nend\n", "1\n")
    end
    it("!~ returns true on no match") do ->
      assert_run_stdout_eq("def main(): Int\n  print_int(\"hello\" !~ ~r\"xyz\")\n  return 0\nend\n", "1\n")
    end
    it("!~ returns false on match") do ->
      assert_run_stdout_eq("def main(): Int\n  print_int(\"hello\" !~ ~r\"hello\")\n  return 0\nend\n", "0\n")
    end
    it("matches literal characters") do ->
      assert_eq(rx_literal_chars(), 0)
    end
    it("matches . any character") do ->
      assert_eq(rx_dot_any(), 0)
    end
    it("matches * zero or more") do ->
      assert_eq(rx_star(), 0)
    end
    it("matches + one or more") do ->
      assert_eq(rx_plus(), 0)
    end
    it("matches ? zero or one") do ->
      assert_eq(rx_question(), 0)
    end
    it("matches ^ start anchor") do ->
      assert_eq(rx_anchor_start(), 0)
    end
    it("matches $ end anchor") do ->
      assert_eq(rx_anchor_end(), 0)
    end
    it("matches character class") do ->
      assert_eq(rx_char_class(), 0)
    end
    it("matches negated class") do ->
      assert_eq(rx_neg_class(), 0)
    end
    it("matches character range") do ->
      assert_eq(rx_char_range(), 0)
    end
    it("matches | alternation") do ->
      assert_eq(rx_alternation(), 0)
    end
    it("matches () grouping") do ->
      assert_eq(rx_grouping(), 0)
    end
    it("handles empty string") do ->
      assert_eq(rx_empty_string(), 0)
    end
    it("handles escaped special chars") do ->
      assert_eq(rx_escaped_chars(), 0)
    end
    it("regex_replace replaces first match") do ->
      assert_eq(rx_replace(), 0)
    end
    it("regex_replace_all replaces all matches") do ->
      assert_eq(rx_replace_all(), 0)
    end
    it("regex_count counts occurrences") do ->
      assert_eq(rx_count(), 0)
    end
  end
  return qspec_main()
end

## Test: literal characters match exactly
def rx_literal_chars(): Int
  var c = regex_count("hello world", "hello")
  if c != 1
    return 1
  end
  # non-match
  var d = regex_count("hello world", "xyz")
  if d != 0
    return 2
  end
  return 0
end

## Test: . matches any single character
def rx_dot_any(): Int
  var c = regex_count("abc", "a.c")
  if c != 1
    return 1
  end
  # dot should not match across missing chars
  var d = regex_count("ac", "^a.c$")
  if d != 0
    return 2
  end
  return 0
end

## Test: * matches zero or more of preceding element
def rx_star(): Int
  # zero occurrences
  var a = regex_count("b", "^a*b$")
  if a != 1
    return 1
  end
  # multiple occurrences
  var b = regex_count("aaab", "^a*b$")
  if b != 1
    return 2
  end
  return 0
end

## Test: + matches one or more of preceding element
def rx_plus(): Int
  # one occurrence
  var a = regex_count("ab", "^a+b$")
  if a != 1
    return 1
  end
  # zero occurrences should not match
  var b = regex_count("b", "^a+b$")
  if b != 0
    return 2
  end
  return 0
end

## Test: ? matches zero or one of preceding element
def rx_question(): Int
  # with optional char present
  var a = regex_count("colour", "colou?r")
  if a != 1
    return 1
  end
  # without optional char
  var b = regex_count("color", "colou?r")
  if b != 1
    return 2
  end
  return 0
end

## Test: ^ anchors to start of string
def rx_anchor_start(): Int
  var a = regex_count("hello world", "^hello")
  if a != 1
    return 1
  end
  # should not match in middle
  var b = regex_count("say hello", "^hello")
  if b != 0
    return 2
  end
  return 0
end

## Test: $ anchors to end of string
def rx_anchor_end(): Int
  var a = regex_count("hello world", "world$")
  if a != 1
    return 1
  end
  # should not match in middle
  var b = regex_count("world hello", "world$")
  if b != 0
    return 2
  end
  return 0
end

## Test: [...] character class
def rx_char_class(): Int
  var a = regex_count("abc123", "[0-9]+")
  if a != 1
    return 1
  end
  # no digits
  var b = regex_count("abcdef", "^[0-9]+$")
  if b != 0
    return 2
  end
  return 0
end

## Test: [^...] negated character class
def rx_neg_class(): Int
  # non-digit chars match
  var a = regex_count("abc", "[^0-9]+")
  if a != 1
    return 1
  end
  # all digits should not match negated digit class
  var b = regex_count("123", "^[^0-9]+$")
  if b != 0
    return 2
  end
  return 0
end

## Test: [a-z] character range
def rx_char_range(): Int
  var a = regex_count("hello", "^[a-z]+$")
  if a != 1
    return 1
  end
  # uppercase should not match lowercase range
  var b = regex_count("HELLO", "^[a-z]+$")
  if b != 0
    return 2
  end
  return 0
end

## Test: | alternation
def rx_alternation(): Int
  var a = regex_count("cat", "cat|dog")
  if a != 1
    return 1
  end
  var b = regex_count("dog", "cat|dog")
  if b != 1
    return 2
  end
  var c = regex_count("fish", "^(cat|dog)$")
  if c != 0
    return 3
  end
  return 0
end

## Test: () grouping
def rx_grouping(): Int
  var a = regex_count("abcabc", "(abc)+")
  if a != 1
    return 1
  end
  # verify grouped quantifier
  var s = regex_replace("ababab", "(ab)+", "X")
  if s != "X"
    return 2
  end
  return 0
end

## Test: empty string handling
def rx_empty_string(): Int
  var a = regex_count("", "^$")
  if a != 1
    return 1
  end
  # empty string should not match non-empty pattern
  var b = regex_count("", "^.+$")
  if b != 0
    return 2
  end
  return 0
end

## Test: escaped special characters
def rx_escaped_chars(): Int
  # escaped dot matches literal dot
  var a = regex_count("a.b", "a\\.b")
  if a != 1
    return 1
  end
  # unescaped dot matches any char
  var b = regex_count("aXb", "a.b")
  if b != 1
    return 2
  end
  # escaped dot should NOT match any char
  var c = regex_count("aXb", "^a\\.b$")
  if c != 0
    return 3
  end
  return 0
end

def rx_replace(): Int
  var s = regex_replace("foo bar baz", "bar", "qux")
  if s != "foo qux baz"
    return 1
  end
  return 0
end

def rx_replace_all(): Int
  var s = regex_replace_all("foo bar bar", "bar", "qux")
  if s != "foo qux qux"
    return 1
  end
  return 0
end

def rx_count(): Int
  var c = regex_count("ababa", "a")
  if c != 3
    return 1
  end
  return 0
end
