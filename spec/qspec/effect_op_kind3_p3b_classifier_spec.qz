## kind=3 classifier — Phase 3 Milestone P3.0b acceptance spec.
##
## Operation Piezoelectric Effects, Phase 3, Milestone P3.0b.
##
## Validates the three-kind classifier split between:
##
##   * kind=2 (tail resume — unwind/abort): endless-def body matching
##     exactly the `= resume(expr)` shape. Today's Throws.throw and
##     ParseError.parse_error are canonical examples.
##
##   * kind=3 (non-tail resume — continuation-preserving): any body with
##     a resume call that is NOT at the trivial endless-def tail. This
##     is P3.0's new classification; the $poll state-machine lowering
##     for kind=3 ops lands in P3.0c.
##
## Classifier logic in `typecheck_walk.qz:tc_body_is_endless_def_tail_resume`:
## strictly matches NODE_BLOCK → NODE_RETURN → NODE_CALL(resume). Any
## deviation (multi-statement body, expression-wrapped resume, nested
## control flow, etc.) falls through to kind=3.
##
## Kind=3 ALSO triggers a suspendable-leaf recording in
## `mir_lower_expr_handlers.qz`: any function that performs a kind=3 op
## gets marked so `_suspendable_funcs` fixed-point propagates $poll
## lowering to transitive callers. P3.0c consumes that marking.

import * from qspec
import * from qspec/subprocess

def _decl_dump(src: String): SubResult = subprocess_compile_with_flags(src, "--dump-effect-decls")

def _assert_contains(haystack: String, needle: String): Void
  _inc_assertions()
  if not str_contains(haystack, needle)
    var sb = sb_new()
    sb.append("Expected stderr to contain '")
    sb.append(needle)
    sb.append("' but got: ")
    sb.append(haystack)
    _record_failure(sb.to_string())
  end
end

def _assert_not_contains(haystack: String, needle: String): Void
  _inc_assertions()
  if str_contains(haystack, needle)
    var sb = sb_new()
    sb.append("Expected stderr NOT to contain '")
    sb.append(needle)
    sb.append("' but stderr was: ")
    sb.append(haystack)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("classifier kind=2 vs kind=3 split (P3.0b)") do ->
    it("endless-def `= resume(0)` classifies kind=2 (unwind)") do ->
      var r = _decl_dump("""
effect TailOnly
  def abort(x: Int): Int = resume(0)
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=TailOnly op=abort kind=2")
      _assert_not_contains(r.stderr_content, "op=abort kind=3")
    end

    it("multi-statement body with resume not at last-stmt classifies kind=3") do ->
      var r = _decl_dump("""
effect NonTail
  def middle_resume(x: Int): Int
    resume(0)
    return 0
  end
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=NonTail op=middle_resume kind=3")
    end

    it("body wrapping resume in an expression classifies kind=3") do ->
      # `= resume(0) + 1` — resume is buried under the + operator, not
      # a bare tail call. Strictly-match rule rejects it → kind=3.
      var r = _decl_dump("""
effect Wrapped
  def plus_one(x: Int): Int = resume(0) + 1
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=Wrapped op=plus_one kind=3")
    end

    it("body with no resume classifies kind=1 (function, default)") do ->
      var r = _decl_dump("""
effect NoResume
  def just_ret(x: Int): Int
    return x + 1
  end
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=NoResume op=just_ret kind=1")
    end

    it("bodyless signature with 0 params classifies kind=0 (value)") do ->
      var r = _decl_dump("""
effect ZeroArg
  def query(): Int
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=ZeroArg op=query kind=0")
    end

    it("bodyless signature with params classifies kind=1 (function default)") do ->
      var r = _decl_dump("""
effect OneArg
  def ask(x: Int): Int
end

def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=OneArg op=ask kind=1")
    end

    it("pre-existing Throws remains kind=2 (regression guard)") do ->
      # If classifier accidentally promoted existing ops, Throws would
      # flip to kind=3 and break Phase 1's unwind semantics.
      var r = _decl_dump("""
import std/parse
def main(): Int = 0
""")
      assert_eq(r.exit_code, 0)
      _assert_contains(r.stderr_content, "EFFECT_DECL effect=ParseError op=parse_error kind=2")
    end
  end
  return qspec_main()
end
