## String Methods Tests
##
## Contract:
##   1. S[i] char access.
##   2. String slicing.
##   3. S.size property.
##   4. S.find method.
##   5. Conversion methods.

import * from qspec

def main(): Int
  describe("s[i] char access") do ->
    it("returns char code at index") do ->
      s = "hello"
      ## 'h' = 104
      assert_eq(str_codepoint_nth(s, 0), 104)
    end

    it("returns 0 for out of bounds") do ->
      s = "hi"
      assert_eq(str_codepoint_nth(s, 100), 0)
    end
  end

  describe("string slicing") do ->
    it("str_slice extracts substring") do ->
      s = "hello world"
      sub = str_slice(s, 0, 5)
      assert_eq_str(sub, "hello")
    end

    it("str_slice mid-string") do ->
      s = "hello world"
      sub = str_slice(s, 6, 11)
      assert_eq_str(sub, "world")
    end

    ## s[i:j] / s[:j] / s[i:] slice syntax requires parser support
    ## These are pending until slice syntax is verified in QSpec context
    it("s[0:5] slice syntax via str_slice") do ->
      s = "hello world"
      sub = str_slice(s, 0, 5)
      assert_eq_str(sub, "hello")
    end

    it("s[:3] omitted start via str_slice") do ->
      s = "hello"
      sub = str_slice(s, 0, 3)
      assert_eq_str(sub, "hel")
    end

    it("s[2:] omitted end via str_slice") do ->
      s = "hello"
      sub = str_slice(s, 2, 5)
      assert_eq_str(sub, "llo")
    end
  end

  describe("string range-index s[a..b]") do ->
    ## Regression: s[a..b] used to be mis-lowered to str_codepoint_nth(s, range)
    ## and silently returned Int 0. The TYPE_STRING index arm was missing the
    ## TYPE_RANGE sub-branch; it now routes to str_slice (codepoint range [a,b)).
    it("s[0..5] returns leading substring") do ->
      s = "hello world"
      assert_eq_str(s[0..5], "hello")
    end

    it("s[6..11] returns mid/trailing substring") do ->
      s = "hello world"
      assert_eq_str(s[6..11], "world")
    end

    it("s[6..] open end slices to string length") do ->
      s = "hello world"
      assert_eq_str(s[6..], "world")
    end

    it("s[..5] open start slices from zero") do ->
      s = "hello world"
      assert_eq_str(s[..5], "hello")
    end

    it("s[2..2] empty range returns empty string") do ->
      s = "hello"
      assert_eq_str(s[2..2], "")
    end

    it("s[a..b] is codepoint-indexed (matches s[i] semantics)") do ->
      u = "héllo"
      assert_eq_str(u[0..2], "hé")
    end
  end

  describe("s.size property") do ->
    it("returns string length") do ->
      s = "hello"
      assert_eq(s.size, 5)
    end

    it("returns 0 for empty string") do ->
      s = ""
      assert_eq(s.size, 0)
    end
  end

  describe("s.find method") do ->
    it("finds substring position") do ->
      s = "hello world"
      match s.find("world")
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end

    it("returns None for not found") do ->
      s = "hello"
      assert(s.find("xyz").none?)
    end
  end

  describe("conversion methods") do ->
    it("str_to_int converts string to int") do ->
      s = "42"
      assert_eq(str_to_int(s), 42)
    end

    it("str_from_int converts int to string") do ->
      n = 123
      assert_eq_str(str_from_int(n), "123")
    end

    it("negative int to string") do ->
      n = -42
      assert_eq_str(str_from_int(n), "-42")
    end
  end

  return qspec_main()
end
