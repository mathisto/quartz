## Expressions Tests
##
## Contract:
##   1. Operator precedence.
##   2. Parentheses.
##   3. Unary negation.
##   4. Complex arithmetic expressions.
##   5. Comparison precedence.
##   6. Boolean precedence.
##   7. Function calls in expressions.
##   8. Variables in expressions.
##   9. Edge cases.
##   10. Expression properties.

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Operator precedence
  # ==========================================================================

  describe("operator precedence") do ->
    it("multiplication before addition") do ->
      assert_eq(2 + 3 * 4, 14)
    end

    it("multiplication before subtraction") do ->
      assert_eq(50 - 2 * 4, 42)
    end

    it("division before addition") do ->
      assert_eq(40 + 10 / 5, 42)
    end

    it("modulo before addition") do ->
      assert_eq(40 + 17 % 5, 42)
    end

    it("left-to-right for same precedence") do ->
      assert_eq(100 - 50 - 8, 42)
    end

    it("multiplication and division left-to-right") do ->
      assert_eq(100 / 2 * 2, 100)
    end
  end

  # ==========================================================================
  # Parentheses
  # ==========================================================================

  describe("parentheses") do ->
    it("overrides precedence") do ->
      assert_eq((2 + 3) * 4, 20)
    end

    it("nested parentheses") do ->
      assert_eq((2 + 3) * (4 + 2), 30)
    end

    it("deeply nested") do ->
      assert_eq((((1 + 1) * 2) + 1) * 10 + 2, 52)
    end

    it("unnecessary parentheses") do ->
      assert_eq(((((42)))), 42)
    end

    it("parentheses around terms") do ->
      assert_eq((2) + (3) * (4), 14)
    end
  end

  # ==========================================================================
  # Unary negation
  # ==========================================================================

  describe("unary negation") do ->
    it("negates a number") do ->
      assert_eq(50 + (-8), 42)
    end

    it("double subtraction pattern") do ->
      x = -42
      assert_eq(-x, 42)
    end

    it("negation in expression") do ->
      assert_eq(100 + (-50) + (-8), 42)
    end
  end

  # ==========================================================================
  # Complex arithmetic expressions
  # ==========================================================================

  describe("complex arithmetic expressions") do ->
    it("mixed operations") do ->
      assert_eq(2 * 3 + 4 * 5 + 6 * 2, 38)
    end

    it("chained multiplications") do ->
      assert_eq(2 * 3 * 7, 42)
    end

    it("chained additions") do ->
      assert_eq(1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 + 6, 42)
    end

    it("all four basic operations") do ->
      assert_eq(10 + 20 * 2 - 30 / 3 + 2, 42)
    end

    it("modulo in complex expression") do ->
      assert_eq(100 % 50 + 42, 42)
    end
  end

  # ==========================================================================
  # Comparison precedence
  # ==========================================================================

  describe("comparison precedence") do ->
    it("arithmetic before comparison") do ->
      if 2 + 3 == 5
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("both sides computed before comparison") do ->
      if 2 * 3 < 4 * 2
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("comparison before and") do ->
      if 5 > 3 and 10 > 5
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("comparison before or") do ->
      if 5 < 3 or 10 > 5
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Boolean precedence
  # ==========================================================================

  describe("boolean precedence") do ->
    it("and before or") do ->
      if 1 or 0 and 0
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("multiple and operators") do ->
      if 1 and 1 and 1 and 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("multiple or operators") do ->
      if 0 or 0 or 0 or 42
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("complex boolean chain") do ->
      if 1 and 0 or 0 and 1 or 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Function calls in expressions
  # ==========================================================================

  describe("function calls in expressions") do ->
    it("function call as operand") do ->
      assert_eq(6 * seven(), 42)
    end

    it("multiple function calls") do ->
      assert_eq(a_fn() + b_fn(), 42)
    end

    it("function call with expression argument") do ->
      assert_eq(double(10 + 11), 42)
    end

    it("nested function calls") do ->
      assert_eq(inc(inc(inc(39))), 42)
    end

    it("function call in complex expression") do ->
      assert_eq(sq(2) + sq(3) + sq(4) + sq(1) + 12, 42)
    end
  end

  # ==========================================================================
  # Variables in expressions
  # ==========================================================================

  describe("variables in expressions") do ->
    it("variables as operands") do ->
      a = 6
      b = 7
      assert_eq(a * b, 42)
    end

    it("expression with mixed vars and literals") do ->
      x = 10
      assert_eq(x * 4 + 2, 42)
    end

    it("complex expression with all variable operands") do ->
      a = 2
      b = 3
      c = 4
      d = 5
      assert_eq(a * b + c * d + a + b + c + d, 40)
    end
  end

  # ==========================================================================
  # Edge cases
  # ==========================================================================

  describe("edge cases") do ->
    it("division by computed divisor") do ->
      assert_eq(84 / (1 + 1), 42)
    end

    it("modulo with computed operands") do ->
      assert_eq((100 + 42) % 100, 42)
    end

    it("chained comparisons with and") do ->
      x = 5
      if 0 < x and x < 10
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("expression as function argument") do ->
      assert_eq(add(10 * 2, 11 * 2), 42)
    end

    it("comparison result in arithmetic") do ->
      bonus = 10 > 5
      assert_eq(41 + bonus, 42)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("expression properties") do ->
    forall_ii("addition is associative: (a+b)+c == a+(b+c)") do a: Int, b: Int ->
      var c = a % 100
      assert_eq((a + b) + c, a + (b + c))
    end

    forall_ii("multiplication is associative for small values") do a: Int, b: Int ->
      var x = a % 100
      var y = b % 100
      var z = (a + b) % 100
      assert_eq((x * y) * z, x * (y * z))
    end

    forall_i("double(x) == x + x") do x: Int ->
      assert_eq(expr_double(x), x + x)
    end

    forall_i("sq(x) == x * x") do x: Int ->
      var small = x % 1000
      assert_eq(sq(small), small * small)
    end
  end

  return qspec_main()
end

def expr_double(x: Int): Int = x * 2

def seven(): Int
  return 7
end

def a_fn(): Int
  return 10
end

def b_fn(): Int
  return 32
end

def double(x: Int): Int
  return x * 2
end

def inc(x: Int): Int
  return x + 1
end

def sq(x: Int): Int
  return x * x
end

def add(a: Int, b: Int): Int
  return a + b
end
