## C.13 Phase 3+4a — RecvSelectable round-trip through real Selectable
## trait dispatch. Exercises:
##   - Parser op_kind=5 fall-through for `case x = recvable(ch) => ...`
##   - Typecheck `Selectable` impl lookup + struct-name stamp
##   - MIR-lower op_kind=5 branch: try_poll → option_is_some → complete +
##     bind from option payload
##   - std/sync/communication/channel.qz `RecvSelectable` impl + `recvable(ch)` factory
##
## The "default short-circuit" tests confirm the new dispatch path
## composes correctly with existing default + timeout arms.

import * from qspec
import * from std/sync/communication/channel

def test_recvable_fires_on_ready_channel(): Int
  var ch = channel_new(1)
  send(ch, 42)
  var result = 0
  select
    case v = recvable(ch) => result = v
    default => result = -1
  end
  return result
end

def test_recvable_default_when_empty(): Int
  var ch = channel_new(1)
  var result = 0
  select
    case v = recvable(ch) => result = v
    default => result = 99
  end
  return result
end

def test_recvable_loses_to_default_when_empty(): Int
  var ch = channel_new(1)
  var result = -1
  select
    case v = recvable(ch) => result = v
    default => result = 7
  end
  return result
end

def test_recvable_zero_value(): Int
  var ch = channel_new(1)
  send(ch, 0)
  var result = -1
  select
    case v = recvable(ch) => result = 1000 + v
    default => result = -1
  end
  return result
end

def test_recvable_underscore_binding(): Int
  var ch = channel_new(1)
  send(ch, 555)
  var result = 0
  select
    case _ = recvable(ch) => result = 11
    default => result = 22
  end
  return result
end

def main(): Int
  describe("select unified — RecvSelectable trait dispatch") do ->
    it("recvable arm fires when channel has a value") do ->
      assert_eq(test_recvable_fires_on_ready_channel(), 42)
    end
    it("default arm fires when recvable channel is empty") do ->
      assert_eq(test_recvable_default_when_empty(), 99)
    end
    it("recvable + default — default wins on empty channel") do ->
      assert_eq(test_recvable_loses_to_default_when_empty(), 7)
    end
    it("recvable arm receives value 0 (not confused with None)") do ->
      assert_eq(test_recvable_zero_value(), 1000)
    end
    it("recvable arm with `_` wildcard binding fires the body") do ->
      assert_eq(test_recvable_underscore_binding(), 11)
    end
  end

  return qspec_main()
end
