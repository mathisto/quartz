## Fuzz Spec — Tests for std/fuzz/gen and std/fuzz/oracle
##
## Verifies that the grammar-guided program generator produces compilable
## Quartz programs and that the oracle system correctly detects issues.
##
## Contract:
##   1. Fuzz/gen — program generator.
##   2. Fuzz/oracle — crash detection.

import * from qspec
import * from qspec/subprocess
import std/fuzz/gen

# =============================================================================
# Helpers
# =============================================================================

def print_generates_nonempty(): Void
  rand_seed_op(42)
  source = fuzz_generate(fuzz_config_default())
  if source.size > 0
    puts("nonempty")
  else
    puts("empty")
  end
end

def print_has_main(): Void
  rand_seed_op(42)
  source = fuzz_generate(fuzz_config_default())
  if str_contains(source, "def main(): Int")
    puts("has_main")
  else
    puts("no_main")
  end
end

def print_has_return(): Void
  rand_seed_op(42)
  source = fuzz_generate(fuzz_config_default())
  if str_contains(source, "return 0")
    puts("has_return")
  else
    puts("no_return")
  end
end

def print_has_end(): Void
  rand_seed_op(42)
  source = fuzz_generate(fuzz_config_default())
  if str_contains(source, "end")
    puts("has_end")
  else
    puts("no_end")
  end
end

def print_deterministic(): Void
  rand_seed_op(100)
  s1 = fuzz_generate(fuzz_config_default())
  rand_seed_op(100)
  s2 = fuzz_generate(fuzz_config_default())
  if s1 == s2
    puts("deterministic")
  else
    puts("nondeterministic")
  end
end

def print_different_seeds(): Void
  rand_seed_op(1)
  s1 = fuzz_generate(fuzz_config_default())
  rand_seed_op(2)
  s2 = fuzz_generate(fuzz_config_default())
  if s1 == s2
    puts("same")
  else
    puts("different")
  end
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("fuzz/gen — program generator") do ->
    it("generates non-empty source") do ->
      assert_output("nonempty\n", print_generates_nonempty)
    end

    it("generated program has main function") do ->
      assert_output("has_main\n", print_has_main)
    end

    it("generated program has return 0") do ->
      assert_output("has_return\n", print_has_return)
    end

    it("generated program has end keyword") do ->
      assert_output("has_end\n", print_has_end)
    end

    it("same seed produces same output") do ->
      assert_output("deterministic\n", print_deterministic)
    end

    it("different seeds produce different output") do ->
      assert_output("different\n", print_different_seeds)
    end

    it("generated programs compile (seed 42)") do ->
      assert_compile_succeeds(_gen_program(42))
    end

    it("generated programs compile (seed 100)") do ->
      assert_compile_succeeds(_gen_program(100))
    end

    it("generated programs compile (seed 7)") do ->
      assert_compile_succeeds(_gen_program(7))
    end

    it("generated programs compile (seed 999)") do ->
      assert_compile_succeeds(_gen_program(999))
    end

    it("generated programs compile (seed 12345)") do ->
      assert_compile_succeeds(_gen_program(12345))
    end
  end

  describe("fuzz/oracle — crash detection") do ->
    it("detects compilation of invalid syntax") do ->
      assert_compile_error("def main(: Int\n  return 0\nend\n", "error")
    end

    it("valid program compiles without error") do ->
      assert_compile_succeeds("def main(): Int\n  return 0\nend\n")
    end
  end

  return qspec_main()
end

def _gen_program(seed: Int): String
  rand_seed_op(seed)
  return fuzz_generate(fuzz_config_default())
end
