## Import Regression Tests - One test per known module system bug
## Ensures all fixed bugs stay fixed
##
## Contract:
##   1. Regression: Bug 1 — no double-prefix.
##   2. Regression: Bug 2 — re-export chain.
##   3. Regression: Bug 3 — cross-module struct field.
##   4. Regression: Bug 4 — private forward-ref.
##   5. Regression: Bug 8 — visibility section.
##   6. Regression: pending bugs.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("regression: Bug 1 — no double-prefix") do ->
    it("intra-module call is not double-prefixed") do ->
      var files: Vec = vec_new()
      files.push(as_int("mymod.qz"))
      vec_push(files, as_int("def helper(): Int = 42\ndef caller(): Int\n  return helper()\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import mymod\ndef main(): Int\n  return mymod::caller()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("regression: Bug 2 — re-export chain") do ->
    it("wildcard re-exported fn is direct call") do ->
      var files: Vec = vec_new()
      files.push(as_int("base.qz"))
      files.push(as_int("def base_fn(): Int = 77"))
      files.push(as_int("mid.qz"))
      vec_push(files, as_int("import * from base\ndef use_base(): Int\n  return base_fn()\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import mid\ndef main(): Int\n  return mid::use_base()\nend"))
      assert_multi_run_exits(files, 2, 77)
    end
  end

  describe("regression: Bug 3 — cross-module struct field") do ->
    it("struct field access across modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("data.qz"))
      vec_push(files, as_int("struct Item\n  val: Int\nend\ndef make_item(n: Int): Item\n  return Item{val: n}\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import data\ndef main(): Int\n  var item = data::make_item(33)\n  return item.val\nend"))
      assert_multi_run_exits(files, 1, 33)
    end
  end

  describe("regression: Bug 4 — private forward-ref") do ->
    it("public fn calls private fn defined later") do ->
      var files: Vec = vec_new()
      files.push(as_int("fmod.qz"))
      vec_push(files, as_int("def api_fn(n: Int): Int\n  return priv_fn(n)\nend\nprivate\ndef priv_fn(x: Int): Int = x * 2"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import fmod\ndef main(): Int\n  return fmod::api_fn(25)\nend"))
      assert_multi_run_exits(files, 1, 50)
    end
  end

  describe("regression: Bug 8 — visibility section") do ->
    it("fn after struct in private section is private") do ->
      var files: Vec = vec_new()
      files.push(as_int("vmod.qz"))
      vec_push(files, as_int("def public_fn(): Int = 1\nprivate\nstruct Hidden\n  x: Int\nend\ndef secret(): Int = 99"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import vmod\ndef main(): Int\n  return vmod::secret()\nend"))
      assert_multi_compile_error(files, 1, "has no function")
    end
  end

  describe("regression: pending bugs") do ->
    it("Bug 6: arity-overloaded functions across modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("helper.qz"))
      vec_push(files, as_int("def greet(): Int\n  puts(\"hello\")\n  return 0\nend\ndef greet(name: String): Int\n  puts(name)\n  return 1\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from helper\ndef main(): Int\n  greet()\n  greet(\"world\")\n  return 0\nend"))
      assert_multi_run_output(files, 1, "hello\nworld\n")
    end
    it("Bug 7: variable named v1 compiles") do ->
      var files: Vec = vec_new()
      files.push(as_int("vmod.qz"))
      vec_push(files, as_int("def compute(): Int\n  var v1 = 42\n  return v1\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import vmod\ndef main(): Int\n  return vmod::compute()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  return qspec_main()
end
