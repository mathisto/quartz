## Crypto subtle helpers — branchless equality, selection, comparison.

import * from qspec
import std/core/crypto/subtle

def main(): Int
  describe("ct_eq_byte") do ->
    it("returns 0xFF when low bytes equal") do ->
      assert_eq(ct_eq_byte(0, 0), 255)
      assert_eq(ct_eq_byte(42, 42), 255)
      assert_eq(ct_eq_byte(255, 255), 255)
    end

    it("returns 0 when low bytes differ") do ->
      assert_eq(ct_eq_byte(0, 1), 0)
      assert_eq(ct_eq_byte(254, 255), 0)
      assert_eq(ct_eq_byte(0, 255), 0)
    end

    it("ignores bits above byte 0") do ->
      # 0x01FF and 0xFF agree in low byte → equal.
      assert_eq(ct_eq_byte(511, 255), 255)
      # 0x0100 vs 0x0000 agree in low byte → equal.
      assert_eq(ct_eq_byte(256, 0), 255)
    end
  end

  describe("ct_eq_u32") do ->
    it("returns 0xFFFFFFFF when low 32 equal") do ->
      assert_eq(ct_eq_u32(0, 0), 4294967295)
      assert_eq(ct_eq_u32(123456, 123456), 4294967295)
      assert_eq(ct_eq_u32(4294967295, 4294967295), 4294967295)
    end

    it("returns 0 when low 32 differ") do ->
      assert_eq(ct_eq_u32(0, 1), 0)
      assert_eq(ct_eq_u32(4294967294, 4294967295), 0)
    end

    it("ignores bits above bit 31") do ->
      # (1 << 32) | 7 vs 7: low 32 equal → 0xFFFFFFFF.
      assert_eq(ct_eq_u32(4294967303, 7), 4294967295)
    end
  end

  describe("ct_eq_int") do ->
    it("returns -1 when 64-bit values equal") do ->
      assert_eq(ct_eq_int(0, 0), 0 - 1)
      assert_eq(ct_eq_int(123456789012345, 123456789012345), 0 - 1)
      assert_eq(ct_eq_int(0 - 1, 0 - 1), 0 - 1)
    end

    it("returns 0 when 64-bit values differ") do ->
      assert_eq(ct_eq_int(0, 1), 0)
      assert_eq(ct_eq_int(0 - 1, 1), 0)
      # Differs only in high bit:
      assert_eq(ct_eq_int(0, 0 - 9223372036854775808), 0)
    end
  end

  describe("ct_select_byte") do ->
    it("picks a when mask is 0xFF") do ->
      assert_eq(ct_select_byte(255, 0xAB, 0xCD), 0xAB)
      assert_eq(ct_select_byte(255, 0, 99), 0)
    end

    it("picks b when mask is 0") do ->
      assert_eq(ct_select_byte(0, 0xAB, 0xCD), 0xCD)
      assert_eq(ct_select_byte(0, 99, 0), 0)
    end
  end

  describe("ct_select_u32") do ->
    it("picks a when mask is 0xFFFFFFFF") do ->
      assert_eq(ct_select_u32(4294967295, 1234567, 9876543), 1234567)
    end

    it("picks b when mask is 0") do ->
      assert_eq(ct_select_u32(0, 1234567, 9876543), 9876543)
    end
  end

  describe("ct_select_int") do ->
    it("picks a when mask is -1") do ->
      assert_eq(ct_select_int(0 - 1, 100, 200), 100)
    end

    it("picks b when mask is 0") do ->
      assert_eq(ct_select_int(0, 100, 200), 200)
    end
  end

  describe("ct_less_u32") do ->
    it("returns 0xFFFFFFFF when a < b unsigned 32-bit") do ->
      assert_eq(ct_less_u32(0, 1), 4294967295)
      assert_eq(ct_less_u32(4294967294, 4294967295), 4294967295)
    end

    it("returns 0 when a >= b") do ->
      assert_eq(ct_less_u32(1, 0), 0)
      assert_eq(ct_less_u32(5, 5), 0)
      assert_eq(ct_less_u32(4294967295, 4294967294), 0)
    end
  end

  describe("ct_eq_bytes") do ->
    it("returns 1 when equal") do ->
      var a = ptr_alloc(2)
      var b = ptr_alloc(2)
      var i = 0
      while i < 16
        ptr_write_byte(a + i, i)
        ptr_write_byte(b + i, i)
        i += 1
      end
      assert_eq(ct_eq_bytes(a, b, 16), 1)
    end

    it("returns 0 when first byte differs") do ->
      var a = ptr_alloc(2)
      var b = ptr_alloc(2)
      ptr_write_byte(a, 0)
      ptr_write_byte(b, 1)
      var i = 1
      while i < 16
        ptr_write_byte(a + i, i)
        ptr_write_byte(b + i, i)
        i += 1
      end
      assert_eq(ct_eq_bytes(a, b, 16), 0)
    end

    it("returns 0 when last byte differs") do ->
      var a = ptr_alloc(2)
      var b = ptr_alloc(2)
      var i = 0
      while i < 15
        ptr_write_byte(a + i, i)
        ptr_write_byte(b + i, i)
        i += 1
      end
      ptr_write_byte(a + 15, 99)
      ptr_write_byte(b + 15, 100)
      assert_eq(ct_eq_bytes(a, b, 16), 0)
    end

    it("returns 1 for empty length") do ->
      var a = ptr_alloc(1)
      var b = ptr_alloc(1)
      assert_eq(ct_eq_bytes(a, b, 0), 1)
    end
  end

  describe("ct_copy_if_byte") do ->
    it("copies all bytes when mask is 0xFF") do ->
      var dst = ptr_alloc(2)
      var src = ptr_alloc(2)
      var i = 0
      while i < 16
        ptr_write_byte(dst + i, 0)
        ptr_write_byte(src + i, i + 1)
        i += 1
      end
      ct_copy_if_byte(255, dst, src, 16)
      i = 0
      while i < 16
        assert_eq(ptr_read_byte(dst + i), i + 1)
        i += 1
      end
    end

    it("leaves dst unchanged when mask is 0") do ->
      var dst = ptr_alloc(2)
      var src = ptr_alloc(2)
      var i = 0
      while i < 16
        ptr_write_byte(dst + i, 100)
        ptr_write_byte(src + i, i + 1)
        i += 1
      end
      ct_copy_if_byte(0, dst, src, 16)
      i = 0
      while i < 16
        assert_eq(ptr_read_byte(dst + i), 100)
        i += 1
      end
    end
  end

  return qspec_main()
end
