## Adversarial String Tests (TEST.2 Phase 2)
##
## Contract: Boundary conditions for string operations.
##   1. Empty string operations.
##   2. Single-character strings.
##   3. String concatenation edge cases.
##   4. String slicing boundaries.
##   5. String interpolation with special values.
##   6. Property-based string laws.

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Empty String
  # ==========================================================================
  describe("empty string operations") do ->
    it("empty string has length 0") do ->
      assert_eq(str_byte_len(""), 0)
    end

    it("concatenation with empty string is identity") do ->
      assert_eq_str("hello" + "", "hello")
      assert_eq_str("" + "hello", "hello")
    end

    it("empty + empty is empty") do ->
      assert_eq_str("" + "", "")
      assert_eq(str_byte_len("" + ""), 0)
    end

    it("str_repeat with count 0 returns empty") do ->
      assert_eq_str(str_repeat("abc", 0), "")
    end

    it("str_repeat with count 1 returns same string") do ->
      assert_eq_str(str_repeat("abc", 1), "abc")
    end

    it("str_repeat empty string returns empty") do ->
      assert_eq_str(str_repeat("", 5), "")
    end
  end

  # ==========================================================================
  # Single-Character Strings
  # ==========================================================================
  describe("single-character strings") do ->
    it("single char has length 1") do ->
      assert_eq(str_byte_len("x"), 1)
    end

    it("single char string identity") do ->
      s = "x"
      assert_eq_str(s, "x")
    end

    it("comparing identical single chars") do ->
      qspec_assert("a" == "a")
      qspec_assert("z" == "z")
    end

    it("comparing different single chars") do ->
      qspec_assert("a" != "b")
    end
  end

  # ==========================================================================
  # String Concatenation Edge Cases
  # ==========================================================================
  describe("string concatenation edge cases") do ->
    it("concatenation of many short strings") do ->
      var result = ""
      for i in 0..10
        result = result + "x"
      end
      assert_eq(str_byte_len(result), 10)
    end

    it("string with special characters") do ->
      s = "hello\nworld\ttab"
      qspec_assert(str_byte_len(s) > 0)
    end

    it("string with escaped quotes") do ->
      s = "he said \"hi\""
      qspec_assert(str_byte_len(s) > 0)
    end
  end

  # ==========================================================================
  # String Interpolation Edge Cases
  # ==========================================================================
  describe("string interpolation edge cases") do ->
    it("interpolation with zero") do ->
      x = 0
      assert_eq_str("val=#{x}", "val=0")
    end

    it("interpolation with negative number") do ->
      x = -42
      assert_eq_str("n=#{x}", "n=-42")
    end

    it("interpolation with empty string expression") do ->
      s = ""
      assert_eq_str("pre#{s}post", "prepost")
    end

    it("multiple interpolations in one string") do ->
      a = 1
      b = 2
      assert_eq_str("#{a}+#{b}=#{a + b}", "1+2=3")
    end

    it("nested arithmetic in interpolation") do ->
      assert_eq_str("result=#{(2 + 3) * 4}", "result=20")
    end
  end

  # ==========================================================================
  # String Comparison
  # ==========================================================================
  describe("string comparison edge cases") do ->
    it("empty strings are equal") do ->
      qspec_assert("" == "")
    end

    it("string equality is case-sensitive") do ->
      qspec_assert("Hello" != "hello")
    end

    it("string with trailing space differs") do ->
      qspec_assert("hello" != "hello ")
    end

    it("shorter string differs from longer prefix") do ->
      qspec_assert("ab" != "abc")
    end
  end

  return qspec_main()
end
