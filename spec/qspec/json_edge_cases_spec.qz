## Json Edge Cases Tests
##
## Contract:
##   1. Json unicode escapes.
##   2. Json trailing commas.
import * from qspec
import * from json

def jec_ok(source: String): JsonValue
  var result = json_parse(source)
  match result
    Ok(v) => return v
    _ => return json_null()
  end
end

def main(): Int
  describe("json unicode escapes") do ->
    it("parses ascii unicode escape") do ->
      var v = jec_ok("\"\\u0041\"")
      assert_eq(json_is_string(v), true)
      assert_eq_str(json_as_string(v), "A")
    end

    it("parses 2-byte unicode escape") do ->
      var v = jec_ok("\"\\u00E9\"")
      assert_eq(json_is_string(v), true)
      assert_eq(json_as_string(v).size, 2)
    end

    it("parses 3-byte unicode escape") do ->
      var v = jec_ok("\"\\u4E16\"")
      assert_eq(json_is_string(v), true)
      assert_eq(json_as_string(v).size, 3)
    end

    it("rejects invalid hex in unicode escape") do ->
      var result = json_parse("\"\\u00GG\"")
      assert_eq(is_err(result), true)
    end

    it("rejects lone high surrogate") do ->
      var result = json_parse("\"\\uD800\"")
      assert_eq(is_err(result), true)
    end

    it("rejects lone low surrogate") do ->
      var result = json_parse("\"\\uDC00\"")
      assert_eq(is_err(result), true)
    end
  end

  describe("json trailing commas") do ->
    it("rejects trailing comma in array") do ->
      var result = json_parse("[1,2,3,]")
      assert_eq(is_err(result), true)
    end

    it("rejects trailing comma in object") do ->
      var result = json_parse("{\"a\":1,}")
      assert_eq(is_err(result), true)
    end
  end

  return qspec_main()
end
