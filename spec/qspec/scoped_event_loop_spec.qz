## Scoped EventLoop — B.8 Phase 5 (capstone).
##
## Contract:
##   1. `with event_loop_scoped(el) do fd -> body end` binds fd = el.fd;
##      closes el (via event_loop_close) on normal AND throw block exit.
##   2. Sequential event_loop_scoped blocks reuse fds without leaks.
##   3. EventLoop's underlying fd (kqueue on macOS, epoll on Linux) is
##      released by the OS on close — no special drain handling needed.

import * from qspec
import * from std/net/event_loop
import * from std/throws

# --- Test 1: normal exit closes the event loop fd. ----------------------

def b8_eloop_normal_exit(): Int
  var el = event_loop_new()
  if el.fd < 0
    return -1
  end
  var fd_observed = 0
  with event_loop_scoped(el) do fd ->
    fd_observed = fd
  end
  if fd_observed > 0
    return 1
  end
  return 0
end

# --- Test 2: sequential event_loop_scoped blocks open + close cleanly. -

def b8_eloop_sequential(): Int
  var el1 = event_loop_new()
  if el1.fd < 0
    return -1
  end
  with event_loop_scoped(el1) do fd ->
    var x = 1
  end
  var el2 = event_loop_new()
  if el2.fd < 0
    return -2
  end
  with event_loop_scoped(el2) do fd ->
    var x = 2
  end
  return 2
end

# --- Phase 4b throw-safety tests ----------------------------------------

var b8_eloop_caught = 0

def b8_eloop_capture_throw(op_name: Int, argc: Int, argv: Int): Int
  b8_eloop_caught += 1
  return 0
end

# --- Test 3: throw inside event_loop_scoped fires release_on_throw. -----

def b8_eloop_throw_releases(): Int
  var el = event_loop_new()
  if el.fd < 0
    return -1
  end
  with Throws { throw: b8_eloop_capture_throw } do ->
    with event_loop_scoped(el) do fd ->
      throw("eloop-boom")
    end
    0
  end
  # release_on_throw should have closed el. Open a fresh loop.
  var el2 = event_loop_new()
  if el2.fd < 0
    return -2
  end
  var ignore = event_loop_close(el2)
  return 1
end

# --- Test 4: panic inside event_loop_scoped fires release_on_throw. -----

def b8_eloop_panic_releases(): Int
  var el = event_loop_new()
  if el.fd < 0
    return -1
  end
  with Throws { throw: b8_eloop_capture_throw } do ->
    with event_loop_scoped(el) do fd ->
      panic("eloop-kaboom")
    end
    0
  end
  return 1
end

def main(): Int
  describe("Scoped EventLoop — B.8 Phase 5 (capstone)") do ->
    it("event_loop_scoped opens + closes on normal exit") do ->
      assert_eq(b8_eloop_normal_exit(), 1)
    end

    it("sequential event_loop_scoped blocks reuse fds") do ->
      assert_eq(b8_eloop_sequential(), 2)
    end

    it("throw in event_loop_scoped fires release_on_throw") do ->
      assert_eq(b8_eloop_throw_releases(), 1)
    end

    it("panic in event_loop_scoped fires release_on_throw") do ->
      assert_eq(b8_eloop_panic_releases(), 1)
    end
  end

  return qspec_main()
end
