## P3.F.3 — effect polymorphism over collection-traversing combinators.
##
## A polymorphic `map_vec<T, U, e>` takes a pure Vec source and a
## callback declared `can e`. The callback's row flows through the
## combinator's `can e`; each call site binds e fresh so pure and async
## callers of the same combinator don't collide.
##
## Trait-method row storage (the infrastructure added in F.3) is not
## exercised by this spec directly — Vec's iteration uses concrete
## methods, not trait dispatch. Full `impl Iterator<T, e>` polymorphism
## arrives in F.3b/c.

import * from qspec

def map_vec<T, U, e>(xs: Vec<Int>, f: Fn(Int): Int can e): Vec<Int> can e
  var out = vec_new<Int>()
  for v in xs
    out.push(f(v))
  end
  return out
end

def dbl(x: Int): Int = x * 2
def dbl_async(x: Int): Int can Async = x * 2

def pure_map_result(): Int
  var src = vec_new<Int>()
  src.push(5)
  src.push(7)
  var a = map_vec(src, dbl)
  return a[0] + a[1]
end

def async_map_result(): Int can Async
  var src = vec_new<Int>()
  src.push(5)
  src.push(7)
  var a = map_vec(src, dbl_async)
  return a[0] + a[1]
end

def main(): Int
  describe("effect polymorphism over collection combinators") do ->
    it("pure callback: map_vec<e={}> over Vec<Int>") do ->
      assert_eq(pure_map_result(), 24)
    end

    it("async callback: map_vec<e={Async}> over Vec<Int>") do ->
      assert_eq(async_map_result(), 24)
    end
  end
  return qspec_main()
end
