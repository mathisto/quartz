## FIX.2 Unicode Awareness — Byte-level intrinsics tests
##
## Contract:
##   1. str_byte_len returns byte count (O(1))
##   2. str_byte_at returns byte value at byte index
##   3. str_byte_slice returns substring by byte range
##   4. str_bytes returns Vec of byte values
##   5. str_byte_find returns byte offset of substring
##   6. str_is_valid_utf8 validates UTF-8 encoding

import * from qspec

# ---- str_byte_len ----

def test_byte_len_ascii(): Void
  assert_eq(str_byte_len("hello"), 5)
end

def test_byte_len_empty(): Void
  assert_eq(str_byte_len(""), 0)
end

def test_byte_len_2byte(): Void
  # e-acute (U+00E9) is 2 bytes in UTF-8
  var s = str_from_codepoint(233)
  assert_eq(str_byte_len(s), 2)
end

def test_byte_len_3byte(): Void
  # CJK character (U+4E2D) is 3 bytes in UTF-8
  var s = str_from_codepoint(20013)
  assert_eq(str_byte_len(s), 3)
end

def test_byte_len_4byte(): Void
  # Emoji (U+1F600) is 4 bytes in UTF-8
  var s = str_from_codepoint(128512)
  assert_eq(str_byte_len(s), 4)
end

# ---- str_byte_at ----

def test_byte_at_ascii(): Void
  assert_eq(str_byte_at("hello", 0), 104)
  assert_eq(str_byte_at("hello", 4), 111)
end

def test_byte_at_oob(): Void
  assert_eq(str_byte_at("hi", 5), 0)
end

def test_byte_at_negative(): Void
  assert_eq(str_byte_at("hi", -1), 0)
end

def test_byte_at_2byte_char(): Void
  # e-acute (U+00E9) = 0xC3 0xA9
  var s = str_from_codepoint(233)
  assert_eq(str_byte_at(s, 0), 195)
  assert_eq(str_byte_at(s, 1), 169)
end

# ---- str_byte_slice ----

def test_byte_slice_ascii(): Void
  assert_eq_str(str_byte_slice("hello", 1, 4), "ell")
end

def test_byte_slice_full(): Void
  assert_eq_str(str_byte_slice("hello", 0, 5), "hello")
end

def test_byte_slice_empty(): Void
  assert_eq_str(str_byte_slice("hello", 2, 2), "")
end

# ---- str_bytes ----

def print_bytes_hello(): Void
  var bytes = str_bytes("Hi")
  var i = 0
  while i < vec_size(bytes)
    print_int(bytes[i])
    i += 1
  end
end

def test_bytes_ascii(): Void
  assert_output("72\n105\n", print_bytes_hello)
end

# ---- str_byte_find ----

def test_byte_find_found(): Void
  var result = str_byte_find("hello world", "world")
  assert_eq(option_is_some(result), 1)
  assert_eq(option_get(result), 6)
end

def test_byte_find_not_found(): Void
  var result = str_byte_find("hello", "xyz")
  assert_eq(option_is_some(result), 0)
end

def test_byte_find_at_start(): Void
  var result = str_byte_find("hello", "hel")
  assert_eq(option_is_some(result), 1)
  assert_eq(option_get(result), 0)
end

# ---- str_is_valid_utf8 ----

def test_valid_utf8_ascii(): Void
  assert_eq(str_is_valid_utf8("hello"), 1)
end

def test_valid_utf8_empty(): Void
  assert_eq(str_is_valid_utf8(""), 1)
end

def test_valid_utf8_2byte(): Void
  var s = str_from_codepoint(233)
  assert_eq(str_is_valid_utf8(s), 1)
end

def test_valid_utf8_3byte(): Void
  var s = str_from_codepoint(20013)
  assert_eq(str_is_valid_utf8(s), 1)
end

def test_valid_utf8_4byte(): Void
  var s = str_from_codepoint(128512)
  assert_eq(str_is_valid_utf8(s), 1)
end

def main(): Int
  describe("str_byte_len") do ->
    it("returns byte count for ASCII") do ->
      test_byte_len_ascii()
    end

    it("returns 0 for empty string") do ->
      test_byte_len_empty()
    end

    it("returns 2 for 2-byte UTF-8") do ->
      test_byte_len_2byte()
    end

    it("returns 3 for 3-byte UTF-8") do ->
      test_byte_len_3byte()
    end

    it("returns 4 for 4-byte UTF-8") do ->
      test_byte_len_4byte()
    end
  end

  describe("str_byte_at") do ->
    it("returns ASCII byte values") do ->
      test_byte_at_ascii()
    end

    it("returns 0 for out of bounds") do ->
      test_byte_at_oob()
    end

    it("returns 0 for negative index") do ->
      test_byte_at_negative()
    end

    it("returns raw bytes of multi-byte chars") do ->
      test_byte_at_2byte_char()
    end
  end

  describe("str_byte_slice") do ->
    it("slices ASCII by byte offsets") do ->
      test_byte_slice_ascii()
    end

    it("returns full string when 0..len") do ->
      test_byte_slice_full()
    end

    it("returns empty string for equal indices") do ->
      test_byte_slice_empty()
    end
  end

  describe("str_bytes") do ->
    it("returns Vec of byte values") do ->
      test_bytes_ascii()
    end
  end

  describe("str_byte_find") do ->
    it("finds substring and returns byte offset") do ->
      test_byte_find_found()
    end

    it("returns None when not found") do ->
      test_byte_find_not_found()
    end

    it("returns 0 for match at start") do ->
      test_byte_find_at_start()
    end
  end

  describe("str_is_valid_utf8") do ->
    it("validates ASCII") do ->
      test_valid_utf8_ascii()
    end

    it("validates empty string") do ->
      test_valid_utf8_empty()
    end

    it("validates 2-byte UTF-8") do ->
      test_valid_utf8_2byte()
    end

    it("validates 3-byte UTF-8") do ->
      test_valid_utf8_3byte()
    end

    it("validates 4-byte UTF-8") do ->
      test_valid_utf8_4byte()
    end
  end

  return qspec_main()
end
