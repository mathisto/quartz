## Send/Sync Type Safety Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Send/Sync basics") do ->
    it("primitives are Send — spawn with Int capture succeeds") do ->
      assert_run_exits(ss_int_capture_src(), 42)
    end
    it("named function calls always work (no captures)") do ->
      assert_run_exits(ss_named_fn_src(), 42)
    end
    it("struct with Send fields is Send") do ->
      assert_run_exits(ss_send_struct_src(), 42)
    end
  end

  describe("Send violations") do ->
    it("CPtr is not Send — spawn with CPtr capture -> QZ1301") do ->
      assert_compile_error(ss_cptr_capture_src(), "QZ1301")
    end
    it("struct with CPtr field is not Send -> QZ1301") do ->
      assert_compile_error(ss_cptr_struct_src(), "QZ1301")
    end
    it("nested struct with CPtr is not Send -> QZ1301") do ->
      assert_compile_error(ss_nested_cptr_src(), "QZ1301")
    end
  end

  describe("Send-but-not-Sync (force-move)") do ->
    it("Vec capture in spawn succeeds (force-move)") do ->
      assert_run_exits(ss_vec_capture_src(), 42)
    end
    it("taskgroup_spawn enforces Send/Sync") do ->
      assert_compile_error(ss_taskgroup_cptr_src(), "QZ1301")
    end
  end

  describe("go keyword Send/Sync") do ->
    it("go with named function succeeds") do ->
      assert_run_exits(ss_go_named_src(), 0)
    end
    it("go with CPtr-capturing closure -> QZ1302") do ->
      assert_compile_error(ss_go_lambda_cptr_src(), "QZ1302")
    end
    it("go with closure variable -> QZ1302") do ->
      assert_compile_error(ss_go_closure_var_src(), "QZ1302")
    end
  end

  describe("concurrency-safe types are Send+Sync") do ->
    it("AtomicInt is Send — shared across threads") do ->
      assert_run_exits(ss_atomic_send_src(), 0)
    end
    it("Mutex is Send — shared across threads") do ->
      assert_run_exits(ss_mutex_send_src(), 0)
    end
    it("Channel is Send — shared across threads") do ->
      assert_run_exits(ss_channel_send_src(), 0)
    end
  end

  return qspec_main()
end

def ss_int_capture_src(): String = """
  def main(): Int
    x = 21
    h = go (-> x * 2)
    return await h
  end
  """

def ss_named_fn_src(): String = """
  def work(): Int = 42
  def main(): Int
    h = go work()
    return await h
  end
  """

def ss_send_struct_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_sum(p: Point): Int = p.x + p.y
  def main(): Int
    p = Point { x: 20, y: 22 }
    h = go get_sum(p)
    return await h
  end
  """

def ss_cptr_capture_src(): String = """
  extern "C" def malloc(n: Int): CPtr
  def main(): Int
    p = malloc(8)
    h = go (-> as_int(p))
    return await h
  end
  """

def ss_cptr_struct_src(): String = """
  extern "C" def malloc(n: Int): CPtr
  struct Wrapper
    p: CPtr
  end
  def main(): Int
    w = Wrapper { p: malloc(8) }
    h = go (-> as_int(w.p))
    return await h
  end
  """

def ss_nested_cptr_src(): String = """
  extern "C" def malloc(n: Int): CPtr
  struct Inner
    p: CPtr
  end
  struct Outer
    inner: Inner
  end
  def main(): Int
    o = Outer { inner: Inner { p: malloc(8) } }
    h = go (-> as_int(o.inner.p))
    return await h
  end
  """

def ss_vec_capture_src(): String = """
  def main(): Int
    var v = vec_new()
    vec_push(v, 42)
    h = go (-> vec_get(v, 0))
    return await h
  end
  """

def ss_taskgroup_cptr_src(): String = """
  extern "C" def malloc(n: Int): CPtr
  def main(): Int
    p = malloc(8)
    task_group |g|
      taskgroup_spawn(g, -> as_int(p))
    end
    return 0
  end
  """

def ss_atomic_send_src(): String = """
  def worker(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    a = atomic_new(0)
    h1 = go worker(a)
    h2 = go worker(a)
    await h1
    await h2
    result = atomic_load(a)
    if result == 2
      return 0
    end
    return 1
  end
  """

def ss_mutex_send_src(): String = """
  def worker(mx: Int): Int
    val = mutex_lock(mx)
    mutex_unlock(mx, val + 1)
    return 0
  end
  def main(): Int
    mx = mutex_new(0)
    h1 = go worker(mx)
    h2 = go worker(mx)
    await h1
    await h2
    final = mutex_lock(mx)
    mutex_unlock(mx, final)
    if final == 2
      return 0
    end
    return 1
  end
  """

def ss_channel_send_src(): String = """
  def sender(ch: Int): Int
    send(ch, 42)
    return 0
  end
  def main(): Int
    ch = channel_new(1)
    h = go sender(ch)
    val = recv(ch)
    await h
    if val == 42
      return 0
    end
    return 1
  end
  """

def ss_go_named_src(): String = """
  def work(x: Int): Int = x * 2
  def main(): Int
    sched_init(2)
    go work(21)
    sched_shutdown()
    return 0
  end
  """

def ss_go_lambda_cptr_src(): String = """
  extern "C" def malloc(n: Int): CPtr
  def main(): Int
    sched_init(2)
    p = malloc(8)
    f = -> as_int(p)
    go f()
    sched_shutdown()
    return 0
  end
  """

def ss_go_closure_var_src(): String = """
  def main(): Int
    sched_init(2)
    f = x -> x * 2
    go f(21)
    sched_shutdown()
    return 0
  end
  """
