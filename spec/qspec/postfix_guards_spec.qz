## Postfix Guards Tests
##
## Contract:
##   1. Return if.
##   2. Return unless.
##   3. Break if/unless.
##   4. Continue if/unless.
##   5. Expression statements.
import * from qspec

def main(): Int
  describe("return if") do ->
    it("returns value when condition is true") do ->
      assert_eq(pg_return_if_true(), 42)
    end

    it("continues execution when condition is false") do ->
      assert_eq(pg_return_if_false(), 42)
    end

    it("works with equality comparison") do ->
      assert_eq(pg_return_if_eq(), 42)
    end

    it("works with complex expressions") do ->
      assert_eq(pg_return_if_complex(), 30)
    end

    it("works in helper functions") do ->
      assert_eq(pg_check(75), 2)
    end
  end

  describe("return unless") do ->
    it("returns value when condition is false") do ->
      assert_eq(pg_return_unless_false(), 42)
    end

    it("continues execution when condition is true") do ->
      assert_eq(pg_return_unless_true(), 42)
    end

    it("works with equality") do ->
      assert_eq(pg_return_unless_eq(), 42)
    end

    it("works for early exit on nil-like value") do ->
      assert_eq(pg_process(0) + pg_process(21), 41)
    end
  end

  describe("break if/unless") do ->
    it("breaks loop when condition is true") do ->
      assert_eq(pg_break_if(), 10)
    end

    it("breaks loop when condition is false (unless)") do ->
      assert_eq(pg_break_unless(), 5)
    end
  end

  describe("continue if/unless") do ->
    it("skips iteration when condition is true") do ->
      assert_eq(pg_continue_if(), 25)
    end

    it("skips iteration when condition is false (unless)") do ->
      assert_eq(pg_continue_unless(), 20)
    end
  end

  describe("expression statements") do ->
    it("calls function conditionally with if") do ->
      assert_eq(pg_conditional_call_if(1), 42)
      assert_eq(pg_conditional_call_if(0), 0)
    end

    it("calls function conditionally with unless") do ->
      assert_eq(pg_conditional_call_unless(0), 42)
      assert_eq(pg_conditional_call_unless(1), 0)
    end
  end

  return qspec_main()
end

def pg_return_if_true(): Int
  var x = 10
  return 42 if x > 0
  return 0
end

def pg_return_if_false(): Int
  var x = 0
  return 99 if x > 0
  return 42
end

def pg_return_if_eq(): Int
  var x = 5
  return 42 if x == 5
  return 0
end

def pg_return_if_complex(): Int
  var x = 10
  var y = 20
  return x + y if x > 0 and y > 0
  return 0
end

def pg_check(x: Int): Int
  return 1 if x > 100
  return 2 if x > 50
  return 3 if x > 0
  return 0
end

def pg_return_unless_false(): Int
  var x = 0
  return 42 unless x > 0
  return 0
end

def pg_return_unless_true(): Int
  var x = 10
  return 99 unless x > 0
  return 42
end

def pg_return_unless_eq(): Int
  var x = 5
  return 42 unless x == 0
  return 0
end

def pg_process(val: Int): Int
  return -1 unless val > 0
  return val * 2
end

def pg_conditional_call_if(flag: Int): Int
  var result = 0
  result = 42 if flag > 0
  return result
end

def pg_conditional_call_unless(flag: Int): Int
  var result = 0
  result = 42 unless flag > 0
  return result
end

def pg_break_if(): Int
  var i = 0
  var sum = 0
  while i < 100
    sum = sum + i
    i = i + 1
    break if i == 5
  end
  return sum
end

def pg_break_unless(): Int
  var i = 0
  while i < 100
    i = i + 1
    break unless i < 5
  end
  return i
end

def pg_continue_if(): Int
  var sum = 0
  for i in 0..10
    continue if i % 2 == 0
    sum = sum + i
  end
  return sum
end

def pg_continue_unless(): Int
  var sum = 0
  for i in 0..10
    continue unless i % 2 == 0
    sum = sum + i
  end
  return sum
end
