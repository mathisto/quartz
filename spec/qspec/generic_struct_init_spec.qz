## Generic struct init tests (STR2-1)
## Verifies GBox<T> { field: val } works in generic and non-generic contexts.
##
## Contract:
##   1. Concrete: `GBox<Int> { value: 42 }` constructs generic struct.
##   2. Generic fn: `GBox<T> { value: v }` inside generic function.
##   3. Multi-field: `Pair<A, B> { first:, second: }`.
##   4. Inferred: `GBox { value: 7 }` infers type arg.
##   5. Error wrong count: wrong field count is compile error.
##   6. Error unknown: unknown struct name is compile error.
##   7. Mixed types: `Pair<Int, Int>` with different values.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic struct initialization") do ->
    it("initializes generic struct with concrete type args") do ->
      assert_run_exits(gsi_concrete_src(), 42)
    end

    it("initializes generic struct inside generic function") do ->
      assert_run_exits(gsi_generic_fn_src(), 99)
    end

    it("initializes multi-field generic struct") do ->
      assert_run_exits(gsi_multi_field_src(), 30)
    end

    it("infers type args from field values") do ->
      assert_run_exits(gsi_infer_src(), 7)
    end

    it("rejects wrong field count on generic struct") do ->
      assert_compile_error(gsi_wrong_count_src(), "fields but got")
    end

    it("rejects unknown struct name with type args") do ->
      assert_compile_error(gsi_unknown_src(), "Unknown struct")
    end

    it("multi-field generic with different values") do ->
      assert_run_exits(gsi_mixed_values_src(), 42)
    end
  end

  return qspec_main()
end

## =============================================================================
## Source generators
## =============================================================================

def gsi_concrete_src(): String = """
  struct GBox<T>
    value: T
  end
  def main(): Int
    var b = GBox<Int> { value: 42 }
    return b.value
  end
  """

def gsi_generic_fn_src(): String = """
  struct GBox<T>
    value: T
  end
  def make_box<T>(v: T): Int
    var b = GBox<T> { value: v }
    return b.value
  end
  def main(): Int
    return make_box(99)
  end
  """

def gsi_multi_field_src(): String = """
  struct Pair<A, B>
    first: A
    second: B
  end
  def main(): Int
    var p = Pair<Int, Int> { first: 10, second: 20 }
    return p.first + p.second
  end
  """

def gsi_infer_src(): String = """
  struct GBox<T>
    value: T
  end
  def main(): Int
    var b = GBox { value: 7 }
    return b.value
  end
  """

def gsi_wrong_count_src(): String = """
  struct GBox<T>
    value: T
  end
  def main(): Int
    var b = GBox<Int> { value: 1, extra: 2 }
    return 0
  end
  """

def gsi_unknown_src(): String = """
  def main(): Int
    var b = Nonexistent<Int> { x: 1 }
    return 0
  end
  """

def gsi_mixed_values_src(): String = """
  struct Pair<A, B>
    first: A
    second: B
  end
  def main(): Int
    var p = Pair<Int, Int> { first: 40, second: 2 }
    return p.first + p.second
  end
  """

def gsi_return_generic_src(): String = """
  struct GBox<T>
    value: T
  end
  def wrap(x: Int): GBox<Int>
    return GBox<Int> { value: x }
  end
  def main(): Int
    var b = wrap(42)
    return b.value
  end
  """
