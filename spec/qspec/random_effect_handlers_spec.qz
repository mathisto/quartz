## QSpec coverage for the Random test-handler factories
## (Phase A.8 Phase 4): random_seeded_handler, random_constant_handler,
## random_capture_handler.
##
## 4 ops × 3 handlers + cross-cutting tests for state isolation
## and forwarding semantics.

import * from qspec
import * from std/random

# --- Seeded handler: independent xoshiro256** stream ---
# Asserts determinism (same seed → same sequence) and isolation
# (the seeded handler's stream is independent of the global qz_rand_int).

def t_seeded_deterministic(): Void
  random_seeded_reset(42)
  var a1 = 0
  var a2 = 0
  var a3 = 0
  with Random {
    rand_int_op: random_seeded_handler
  } do ->
    a1 = rand_int_op()
    a2 = rand_int_op()
    a3 = rand_int_op()
  end
  random_seeded_reset(42)
  var b1 = 0
  var b2 = 0
  var b3 = 0
  with Random {
    rand_int_op: random_seeded_handler
  } do ->
    b1 = rand_int_op()
    b2 = rand_int_op()
    b3 = rand_int_op()
  end
  if a1 == b1 and a2 == b2 and a3 == b3
    puts("deterministic")
  else
    puts("a1=#{a1} b1=#{b1} a2=#{a2} b2=#{b2} a3=#{a3} b3=#{b3}")
  end
end

def t_seeded_independent(): Void
  # Set global state to a known seed, take a sample.
  rand_seed_op(99)
  var global_before = rand_int_op()
  # Inside seeded handler, run several ops — should NOT affect global
  # state.
  random_seeded_reset(42)
  with Random {
    rand_int_op: random_seeded_handler,
    rand_range_op: random_seeded_handler
  } do ->
    rand_int_op()
    rand_range_op(0, 100)
    rand_int_op()
  end
  # Re-seed global to 99 again; next sample should match global_before.
  rand_seed_op(99)
  var global_after = rand_int_op()
  if global_before == global_after
    puts("isolated")
  else
    puts("leaked before=#{global_before} after=#{global_after}")
  end
end

def t_seeded_range_bounds(): Void
  random_seeded_reset(7)
  var ok = 1
  with Random {
    rand_range_op: random_seeded_handler
  } do ->
    for i in 0..100
      var v = rand_range_op(10, 30)
      if v < 10 or v >= 30
        ok = 0
      end
    end
  end
  if ok == 1
    puts("range_ok")
  else
    puts("range_violated")
  end
end

def t_seeded_reseed_op(): Void
  # rand_seed_op INSIDE the with-block routes to random_seeded_reset.
  # Asserts that seeding via the effect resets the local stream.
  var x1 = 0
  var x2 = 0
  with Random {
    rand_seed_op: random_seeded_handler,
    rand_int_op: random_seeded_handler
  } do ->
    rand_seed_op(123)
    x1 = rand_int_op()
    rand_seed_op(123)
    x2 = rand_int_op()
  end
  if x1 == x2
    puts("reseed_resets")
  else
    puts("reseed_no_op x1=#{x1} x2=#{x2}")
  end
end

# --- Constant handler: returns a fixed value for every op ---

def t_constant_basic(): Void
  random_constant_set(777)
  var a = 0
  var b = 0
  var c = 0
  with Random {
    rand_int_op: random_constant_handler,
    rand_range_op: random_constant_handler
  } do ->
    a = rand_int_op()
    b = rand_range_op(0, 1000000)
    c = rand_range_op(-50, -10)  # constant ignores bounds
  end
  puts("a=#{a} b=#{b} c=#{c}")
end

def t_constant_seed_noop(): Void
  # Constant handler returns 0 for rand_seed_op (the op is Void from
  # caller's perspective; handler ABI returns Int but caller discards).
  random_constant_set(42)
  with Random {
    rand_seed_op: random_constant_handler
  } do ->
    rand_seed_op(100)
    rand_seed_op(200)
  end
  puts("seed_noop")
end

# --- Capture handler: log + forward ---
# Each op call appends to _rcap_log AND forwards to the bare intrinsic
# so observable behavior is preserved.

def t_capture_logs_calls(): Void
  random_capture_reset()
  with Random {
    rand_seed_op: random_capture_handler,
    rand_int_op: random_capture_handler,
    rand_range_op: random_capture_handler
  } do ->
    rand_seed_op(42)
    rand_int_op()
    rand_range_op(0, 100)
  end
  var log = random_capture_log()
  for entry in log
    puts(entry)
  end
end

def t_capture_preserves_determinism(): Void
  # Forwarding semantics: same seed → same intrinsic stream → same
  # values. Captures don't perturb the underlying PRNG.
  random_capture_reset()
  var a = 0
  var b = 0
  with Random {
    rand_seed_op: random_capture_handler,
    rand_int_op: random_capture_handler
  } do ->
    rand_seed_op(42)
    a = rand_int_op()
  end
  random_capture_reset()
  with Random {
    rand_seed_op: random_capture_handler,
    rand_int_op: random_capture_handler
  } do ->
    rand_seed_op(42)
    b = rand_int_op()
  end
  if a == b
    puts("capture_preserves_determinism")
  else
    puts("a=#{a} b=#{b}")
  end
end

def t_capture_reset(): Void
  random_capture_reset()
  with Random {
    rand_int_op: random_capture_handler
  } do ->
    rand_int_op()
    rand_int_op()
  end
  var size_before = random_capture_log().size
  random_capture_reset()
  var size_after = random_capture_log().size
  puts("before=#{size_before} after=#{size_after}")
end

def main(): Int
  describe("Random test-handler factories (A.8 Phase 4)") do ->
    describe("random_seeded_handler") do ->
      it("same seed produces same sequence") do ->
        assert_output("deterministic\n", t_seeded_deterministic)
      end

      it("local stream is independent of global PRNG state") do ->
        assert_output("isolated\n", t_seeded_independent)
      end

      it("rand_range_op respects [lo, hi) bounds under seeded handler") do ->
        assert_output("range_ok\n", t_seeded_range_bounds)
      end

      it("rand_seed_op routes through reset → reproducible stream") do ->
        assert_output("reseed_resets\n", t_seeded_reseed_op)
      end
    end

    describe("random_constant_handler") do ->
      it("returns the configured constant for int + range ops") do ->
        assert_output("a=777 b=777 c=777\n", t_constant_basic)
      end

      it("rand_seed_op is a no-op") do ->
        assert_output("seed_noop\n", t_constant_seed_noop)
      end
    end

    describe("random_capture_handler") do ->
      it("logs every op call in order") do ->
        assert_output("rand_seed_op 42\nrand_int_op\nrand_range_op 0 100\n", t_capture_logs_calls)
      end

      it("forwarding preserves PRNG determinism") do ->
        assert_output("capture_preserves_determinism\n", t_capture_preserves_determinism)
      end

      it("random_capture_reset clears the log") do ->
        assert_output("before=2 after=0\n", t_capture_reset)
      end
    end
  end
  return qspec_main()
end
