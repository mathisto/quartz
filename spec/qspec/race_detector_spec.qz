## Phase 11: Race Detector Tests
##
## Tests for --race flag: compile-time instrumentation of memory accesses.
## Shadow memory with vector clocks for happens-before detection.
## Exit code 66 on race detection (TSan/Go standard).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("race detector") do ->
    it("--race produces valid executable for simple program") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          puts("race ok")
          return 0
        end
        """, 0, "--race --no-cache")
    end

    it("--race program with alloc/store/load exits 0") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          var x = mem_alloc(1)
          store(x, 0, 42)
          var v = load(x, 0)
          return v - 42
        end
        """, 0, "--race --no-cache")
    end

    it("--race program with multiple stores exits correctly") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          var a = mem_alloc(3)
          store(a, 0, 10)
          store(a, 1, 20)
          store(a, 2, 30)
          var sum = load(a, 0) + load(a, 1) + load(a, 2)
          return sum - 60
        end
        """, 0, "--race --no-cache")
    end

    it("program without --race still works") do ->
      assert_run_exits("""
        def main(): Int
          var x = mem_alloc(1)
          store(x, 0, 42)
          return load(x, 0) - 42
        end
        """, 0)
    end

    it("channel-synchronized access does not false positive") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          var ch = channel_new(1)
          var data = mem_alloc(1)
          store(data, 0, 42)
          send(ch, data)
          var d2 = recv(ch)
          var v = load(d2, 0)
          return v - 42
        end
        """, 0, "--race --no-cache")
    end

    it("sequential access to same address does not false positive") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          var x = mem_alloc(1)
          store(x, 0, 1)
          store(x, 0, 2)
          store(x, 0, 3)
          var v = load(x, 0)
          return v - 3
        end
        """, 0, "--race --no-cache")
    end

    it("race detected on unsynchronized concurrent writes — exit 66") do ->
      var src = """
        var g_data = mem_alloc(1)
        var g_done = channel_new(1)
        def writer(): Int
          store(g_data, 0, 42)
          send(g_done, 1)
          return 0
        end
        def main(): Int
          store(g_data, 0, 0)
          var t = go writer()
          store(g_data, 0, 99)
          recv(g_done)
          return 0
        end
        """
      assert_run_exits_with_flags(src, 66, "--race --no-cache")
    end
  end

  return qspec_main()
end
