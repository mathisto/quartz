## Result Predicates Tests
##
## Contract:
##   1. is_ok: true for Ok, false for Err.
##   2. is_err: true for Err, false for Ok.
##   3. UFCS: `.ok?` and `.err?` predicate syntax.
##   4. Guard: check predicate before unwrap.
import * from qspec

def main(): Int
  describe("result predicates") do ->
    it("is_ok returns true for Ok variant") do ->
      r = Result::Ok(42)
      if is_ok(r)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("is_ok returns false for Err variant") do ->
      r = Result::Err(99)
      if is_ok(r)
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("is_err returns true for Err variant") do ->
      r = Result::Err(99)
      if is_err(r)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("is_err returns false for Ok variant") do ->
      r = Result::Ok(42)
      if is_err(r)
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("result.ok? UFCS predicate") do ->
      r = Result::Ok(42)
      if r.ok?
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("result.err? UFCS predicate") do ->
      r = Result::Err(99)
      if r.err?
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("ok? then unwrap pattern") do ->
      r = Result::Ok(42)
      var val = 0
      if r.ok?
        val = $unwrap(r)
      end
      assert_eq(val, 42)
    end

    it("is_ok and is_err are complementary") do ->
      r = Result::Ok(1)
      if is_ok(r) and not is_err(r)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end
