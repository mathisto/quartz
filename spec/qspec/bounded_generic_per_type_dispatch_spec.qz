## item 48-a — per-type monomorphization of bounded generics.
##
## A bounded generic `def total_area<T: Area>(shapes: Vec<T>)` was monomorphized
## into a SINGLE shared body keyed `total_area$1$Vec` — the element type T was
## ERASED from the monomorph key. So `Vec<Circle>` and `Vec<Square>` collapsed to
## the same body, which froze the FIRST instantiation's method dispatch
## (`Circle$area`) for every element type. Calling `total_area` over a
## `Vec<Square>` therefore ran `Circle$area` → wrong result.
##
## HOOK #1 de-eraseS the Vec element type into the monomorph key
## (`total_area$1$Vec$Circle` vs `$Vec$Square`) so each element type gets its own
## body with correct per-type dispatch. This spec asserts the two-type collision
## now dispatches correctly (it printed `6` then `10` on the pre-fix binary, where
## `10` = Circle$area applied to the Square; correct is `500` = Square$area).

import * from qspec

trait Area
  def area(self): Int
    return 0
  end
end

struct PtCircle
  a: Int
end

struct PtSquare
  b: Int
end

extend PtCircle with Area
  def area(self): Int = @a * 2
end

extend PtSquare with Area
  def area(self): Int = @b * 100
end

def pt_total_area<T: Area>(shapes: Vec<T>): Int
  var sum = 0
  for i in 0..shapes.size
    sum += shapes[i].area()
  end
  return sum
end

def pt_circle_total(): Int
  var cs = vec_new<PtCircle>()
  cs.push(PtCircle { a: 3 })
  cs.push(PtCircle { a: 4 })
  return pt_total_area(cs)
end

def pt_square_total(): Int
  var sq = vec_new<PtSquare>()
  sq.push(PtSquare { b: 5 })
  return pt_total_area(sq)
end

def main(): Int
  describe("bounded generic per-type dispatch (item 48-a)") do ->
    it("dispatches Circle$area for Vec<PtCircle>") do ->
      # (3*2) + (4*2) = 14
      assert_eq(pt_circle_total(), 14)
    end

    it("dispatches Square$area for Vec<PtSquare> (not the frozen Circle$area)") do ->
      # 5*100 = 500. Pre-fix this returned 5*2 = 10 (Circle$area collision).
      assert_eq(pt_square_total(), 500)
    end

    it("both element types resolve independently in the same program") do ->
      assert_eq(pt_circle_total() + pt_square_total(), 514)
    end
  end

  return qspec_main()
end
