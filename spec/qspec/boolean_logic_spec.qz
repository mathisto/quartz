## Boolean Logic Tests
##
## Contract:
##   1. And operator.
##   2. Or operator.
##   3. Precedence: and binds tighter than or.
##   4. With comparisons.
##   5. Truthiness.
##   6. Boolean as values.
##   7. Not operator.
##   8. Complex boolean expressions.
##   9. Ufcs predicate rewriting.

import * from qspec

def main(): Int
  # ==========================================================================
  # AND operator
  # ==========================================================================

  describe("and operator") do ->
    it("returns truthy when both are truthy") do ->
      if 1 and 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("returns falsy when left is falsy") do ->
      if 0 and 1
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("returns falsy when right is falsy") do ->
      if 1 and 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("returns falsy when both are falsy") do ->
      if 0 and 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("short-circuits on falsy left") do ->
      var x = 42
      if 0 and side_effect()
        x = 99
      end
      assert_eq(x, 42)
    end

    it("evaluates right when left is truthy") do ->
      if 1 and 42
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # OR operator
  # ==========================================================================

  describe("or operator") do ->
    it("returns truthy when left is truthy") do ->
      if 1 or 0
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("returns truthy when right is truthy") do ->
      if 0 or 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("returns truthy when both are truthy") do ->
      if 1 or 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("returns falsy when both are falsy") do ->
      if 0 or 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("short-circuits on truthy left") do ->
      if 1 or side_effect_zero()
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates right when left is falsy") do ->
      if 0 or 42
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Precedence: and binds tighter than or
  # ==========================================================================

  describe("precedence: and binds tighter than or") do ->
    it("or with and on right") do ->
      ## 1 or (0 and 0) => 1 or 0 => 1
      if 1 or 0 and 0
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("or with and on left") do ->
      ## (0 and 0) or 1 => 0 or 1 => 1
      if 0 and 0 or 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("complex precedence") do ->
      ## 0 or 1 and 1 or 0 => 0 or (1 and 1) or 0 => 0 or 1 or 0 => 1
      if 0 or 1 and 1 or 0
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("all and operators") do ->
      if 1 and 1 and 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("all or operators") do ->
      if 0 or 0 or 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # With comparisons
  # ==========================================================================

  describe("with comparisons") do ->
    it("and with comparisons") do ->
      x = 5
      if x > 0 and x < 10
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("or with comparisons") do ->
      x = 15
      if x < 0 or x > 10
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("mixed and/or with comparisons") do ->
      x = 5
      y = 10
      if x == 5 and y == 10 or x == 0
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("range check pattern") do ->
      if in_range(42, 0, 100)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Truthiness
  # ==========================================================================

  describe("truthiness") do ->
    it("zero is falsy") do ->
      if 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("positive integers are truthy") do ->
      if 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("large positive integers are truthy") do ->
      if 999
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("true literal is truthy") do ->
      if true
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("false literal is falsy") do ->
      if false
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("comparison result is truthy when true") do ->
      cmp = 5 > 3
      if cmp
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("comparison result is falsy when false") do ->
      cmp = 3 > 5
      if cmp
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("string pointer is truthy in condition") do ->
      s = "hello"
      if s
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("while loop accepts arbitrary type condition") do ->
      var count = 3
      while count
        count = count - 1
      end
      assert_eq(count, 0)
    end

    it("function return used directly in condition") do ->
      if get_value(5)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Boolean as values
  # ==========================================================================

  describe("boolean as values") do ->
    it("true equals 1") do ->
      x = true
      assert_eq(x, 1)
    end

    it("false equals 0") do ->
      x = false
      assert_eq(x, 0)
    end

    it("can do arithmetic with booleans") do ->
      a = true
      b = true
      assert_eq(a + b + 40, 42)
    end

    it("and returns 1 when both truthy (normalized boolean)") do ->
      x = 5 and 42
      assert_eq(x + 41, 42)
    end

    it("or returns 1 when either truthy (normalized boolean)") do ->
      x = 0 or 42
      assert_eq(x + 41, 42)
    end
  end

  # ==========================================================================
  # NOT operator
  # ==========================================================================

  describe("not operator") do ->
    it("negates truthy to falsy") do ->
      if not true
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("negates falsy to truthy") do ->
      if not false
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("not true equals false") do ->
      x = not true
      assert_eq(x, 0)
    end

    it("not false equals true") do ->
      x = not false
      assert_eq(x, 1)
    end

    it("double negation restores value") do ->
      if not not true
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("works with comparisons") do ->
      x = 5
      if not (x == 10)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("works with variables") do ->
      flag = false
      if not flag
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("precedence: not binds tighter than and") do ->
      if not false and true
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("precedence: not binds tighter than or") do ->
      if not true or true
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("not with function call") do ->
      if not is_zero_bool(5)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Complex boolean expressions
  # ==========================================================================

  describe("complex boolean expressions") do ->
    it("nested and/or") do ->
      a = 1
      b = 0
      c = 1
      if a and b or c
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("multiple conditions in loop") do ->
      var i = 0
      var found = 0
      while i < 100 and found == 0
        if i == 42
          found = 1
        end
        i += 1
      end
      assert_eq(i, 43)
    end

    it("boolean function return") do ->
      if is_adult(21)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("combining boolean functions") do ->
      n = 42
      if positive(n) and even(n)
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # UFCS predicate rewriting
  # ==========================================================================

  describe("UFCS predicate rewriting") do ->
    it("Vec.empty? returns true for empty vector") do ->
      v = vec_new()
      if v.empty?
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("Vec.empty? returns false for non-empty vector") do ->
      v = vec_new()
      v.push(1)
      if v.empty?
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("Vec.empty? works in boolean expressions") do ->
      v = vec_new()
      v.push(1)
      if not v.empty?
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("String.empty? returns true for empty string") do ->
      s = ""
      if s.empty?
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("String.empty? returns false for non-empty string") do ->
      s = "hello"
      if s.empty?
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("Map.empty? returns true for empty map") do ->
      m = map_new()
      if m.empty?
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("Map.empty? returns false for non-empty map") do ->
      m = map_new()
      m.set("key", 1)
      if m.empty?
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("Option.some? returns true for Some value") do ->
      opt = Option::Some(42)
      if opt.some?
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Option.some? returns false for none") do ->
      opt = Option::None
      if opt.some?
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("Option.some? works in boolean expressions") do ->
      opt = Option::Some(10)
      result = opt.some? and 1 == 1
      if result
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Option.none? returns true for none") do ->
      opt = Option::None
      if opt.none?
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Option.none? returns false for Some value") do ->
      opt = Option::Some(7)
      if opt.none?
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("Option.none? works with nested match on predicate") do ->
      opt = Option::Some(99)
      var val = 0
      if opt.some?
        val = 1
      end
      if opt.none?
        val = 2
      end
      assert_eq(val, 1)
    end
  end

  return qspec_main()
end

def side_effect(): Int
  return 1
end

def side_effect_zero(): Int
  return 0
end

def in_range(x: Int, lo: Int, hi: Int): Int
  if x >= lo and x <= hi
    return 1
  end
  return 0
end

def get_value(x: Int): Int
  return x
end

def is_zero_bool(x: Int): Bool
  return x == 0
end

def is_adult(age: Int): Int
  return age >= 18
end

def positive(x: Int): Int
  return x > 0
end

def even(x: Int): Int
  return x % 2 == 0
end
