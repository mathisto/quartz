## Resolver Full Scope Tracking Tests
##
## Contract: local bindings (var/const/let, for-loop iter vars, lambda params,
## destructured bindings) shadow module names in UFCS dispatch. A method call
## `name.method()` where `name` is in scope as a local binding must NOT be
## rewritten to `name$method()` — it must stay as UFCS `method(name)`.
##
## See ROADMAP Tier 3 #11 — prior to this feature, only function parameters
## were tracked in `_ufcs_current_params`. Local lets shadowing a module name
## silently rewrote to `module$method(...)`, which is wrong.

import * from qspec
import scope_test_mod

## Local `var` shadows the `string` module. `string.size()` must resolve
## via UFCS to `size("hello")`, not `string$size("hello")` (which doesn't
## exist as a standalone free function).
def local_var_shadows_module(): Int
  var string = "hello"
  return string.size()
end

## `const`-by-default binding.
def local_const_shadows_module(): Int
  var str = "abcd"
  return str.size()
end

## For-loop iter var shadows a module name. `for string in v` binds
## `string` inside the loop body, and `string.size()` must dispatch via UFCS.
def for_loop_iter_shadows_module(): Int
  var v = vec_new<String>()
  v.push("ab")
  v.push("cde")
  v.push("f")
  var total = 0
  for string in v
    total = total + string.size()
  end
  return total
end

## Lambda param shadows a module name. Inside the lambda body, `string`
## refers to the param, not the module.
def lambda_param_shadows_module(): Int
  var items = vec_new<String>()
  items.push("x")
  items.push("yy")
  items.push("zzz")
  var lengths = items.map(string: String -> string.size())
  var sum = 0
  for n in lengths
    sum = sum + n
  end
  return sum
end

## Nested block scoping: inner `var string` shadows outer, and both shadow
## the module. Both must use UFCS.
def nested_block_shadowing(): Int
  var string = "outer"
  var outer_len = string.size()
  var inner_len = 0
  if true
    var string = "in"
    inner_len = string.size()
  end
  return outer_len + inner_len
end

## Definitive module-collision test: `scope_test_mod` is an imported module
## that exports `double(n: Int): Int`. A local `var scope_test_mod = 10`
## shadows the module. The call `scope_test_mod.double()` must stay as UFCS
## `double(10)` → resolves to `scope_test_mod$double(10)` = 20. Under the
## OLD resolver (which only checked param names), this rewrote to
## `scope_test_mod$double()` (0 args), causing an arity mismatch error.
def module_collision_definitive(): Int
  var scope_test_mod = 10
  return scope_test_mod.double()
end

def main(): Int
  describe("resolver full scope tracking") do ->
    it("local var shadows module name in UFCS") do ->
      assert_eq(local_var_shadows_module(), 5)
    end

    it("local const shadows module name in UFCS") do ->
      assert_eq(local_const_shadows_module(), 4)
    end

    it("for-loop iter var shadows module name in UFCS") do ->
      assert_eq(for_loop_iter_shadows_module(), 6)
    end

    it("lambda param shadows module name in UFCS") do ->
      assert_eq(lambda_param_shadows_module(), 6)
    end

    it("nested block shadowing still uses UFCS") do ->
      assert_eq(nested_block_shadowing(), 7)
    end

    it("local var shadows imported module name — definitive collision") do ->
      assert_eq(module_collision_definitive(), 20)
    end
  end

  return qspec_main()
end
