## Option Result Tests
##
## Contract:
##   1. Option.
##   2. Result.
##   3. Is_some / is_none / is_ok / is_err.
##   4. Option map.
import * from qspec

def main(): Int
  describe("Option") do ->
    it("constructs Some with payload") do ->
      opt = Option::Some(42)
      v = match opt
        Some(x) => x
        None => 0
      end
      assert_eq(v, 42)
    end
    it("constructs None") do ->
      opt = Option::None
      v = match opt
        Some(x) => x
        None => 99
      end
      assert_eq(v, 99)
    end
    it("implements unwrap_or") do ->
      a = or_unwrap_some(42)
      b = or_unwrap_none()
      assert_eq(a + b, 141)
    end
    it("passes Option through function calls") do ->
      assert_eq(or_double_or_zero(Option::Some(21)), 42)
    end
    it("double_or_zero returns 0 for None") do ->
      assert_eq(or_double_or_zero(Option::None), 0)
    end
  end

  describe("Result") do ->
    it("constructs Ok with payload") do ->
      r = Result::Ok(42)
      v = match r
        Ok(x) => x
        Err(e) => 0
      end
      assert_eq(v, 42)
    end
    it("constructs Err with payload") do ->
      r = Result::Err(99)
      v = match r
        Ok(x) => 0
        Err(e) => e
      end
      assert_eq(v, 99)
    end
    it("safe_div returns Ok for valid division") do ->
      assert_eq(or_safe_div_unwrap(42, 2), 21)
    end
    it("safe_div returns Err for division by zero") do ->
      assert_eq(or_safe_div_unwrap(10, 0), -1)
    end
  end

  describe("is_some / is_none / is_ok / is_err") do ->
    it("is_some returns true for Some") do ->
      assert_eq(is_some(Option::Some(1)), 1)
    end
    it("is_some returns false for None") do ->
      assert_eq(is_some(Option::None), 0)
    end
    it("is_none returns true for None") do ->
      assert_eq(is_none(Option::None), 1)
    end
    it("is_none returns false for Some") do ->
      assert_eq(is_none(Option::Some(1)), 0)
    end
    it("is_ok returns true for Ok") do ->
      assert_eq(is_ok(Result::Ok(1)), 1)
    end
    it("is_err returns true for Err") do ->
      assert_eq(is_err(Result::Err(1)), 1)
    end
  end

  describe("Option map") do ->
    it("maps Some value") do ->
      opt = Option::Some(21)
      mapped = or_opt_map(opt)
      assert_eq(or_extract(mapped, 0), 42)
    end
    it("maps None to None") do ->
      mapped = or_opt_map(Option::None)
      assert_eq(or_extract(mapped, 99), 99)
    end
  end

  return qspec_main()
end
def or_unwrap_some(val: Int): Int
  opt = Option::Some(val)
  return match opt
    Some(x) => x
    None => 0
  end
end
def or_unwrap_none(): Int
  opt = Option::None
  return match opt
    Some(x) => x
    None => 99
  end
end
def or_double_or_zero(opt: Int): Int
  return match opt
    Some(x) => x * 2
    None => 0
    _ => 0
  end
end
def or_safe_div(a: Int, b: Int): Int
  if b == 0
    return Result::Err(0)
  end
  return Result::Ok(a / b)
end
def or_safe_div_unwrap(a: Int, b: Int): Int
  r = or_safe_div(a, b)
  return match r
    Ok(v) => v
    Err(e) => -1
    _ => -1
  end
end
def or_extract(opt: Int, fallback: Int): Int
  return match opt
    Some(x) => x
    None => fallback
    _ => fallback
  end
end
def or_opt_map(opt: Int): Int
  return match opt
    Some(x) => Option::Some(x * 2)
    None => Option::None
    _ => Option::None
  end
end
