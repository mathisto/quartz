## UTF-8 Awareness Tests
##
## Contract:
##   1. str_size — codepoint count.
##   2. str_codepoint_at(s, byte_idx) — decode at byte offset (O(1)).
##   3. str_codepoint_byte_len(s, byte_idx) — UTF-8 stride (1/2/3/4).
##   4. str_codepoint_nth(s, cp_idx) — n-th codepoint, O(n) walk.
##   5. str_from_codepoint(cp) — encode codepoint as UTF-8 string.

import * from qspec

def utf_ascii_len(): Int
  return str_size("hello")
end

def utf_empty_len(): Int
  return str_size("")
end

def utf_codepoint_at(): Int
  return str_codepoint_at("hello", 0)
end

def utf_from_codepoint(): Int
  var s = str_from_codepoint(65)
  if s == "A"
    return 1
  end
  return 0
end

def utf_roundtrip(): Int
  var cp = 104
  var s = str_from_codepoint(cp)
  var cp2 = str_codepoint_at(s, 0)
  if cp2 == cp
    return 1
  end
  return 0
end

def utf_2byte_len(): Int
  var s = str_from_codepoint(233)
  return str_byte_len(s)
end

def utf_2byte_utf8_len(): Int
  var s = str_from_codepoint(233)
  return str_size(s)
end

def utf_2byte_roundtrip(): Int
  var s = str_from_codepoint(233)
  return str_codepoint_at(s, 0)
end

def main(): Int
  describe("str_size") do ->
    it("counts ASCII correctly") do ->
      assert_eq(utf_ascii_len(), 5)
    end

    it("returns 0 for empty string") do ->
      assert_eq(utf_empty_len(), 0)
    end

    it("counts 2-byte characters as 1") do ->
      assert_eq(utf_2byte_utf8_len(), 1)
    end
  end

  describe("str_codepoint_at") do ->
    it("returns ASCII value") do ->
      assert_eq(utf_codepoint_at(), 104)
    end

    it("round-trips 2-byte character") do ->
      assert_eq(utf_2byte_roundtrip(), 233)
    end
  end

  describe("str_from_codepoint") do ->
    it("creates ASCII character") do ->
      assert_eq(utf_from_codepoint(), 1)
    end

    it("round-trip codepoint to string and back") do ->
      assert_eq(utf_roundtrip(), 1)
    end

    it("handles 2-byte character (byte length)") do ->
      assert_eq(utf_2byte_len(), 2)
    end
  end

  describe("str_codepoint_at — byte-offset semantics") do ->
    # Mixed string: │ (3 bytes) + space (1) + 🍪 (4) + space (1) + a (1) + b (1) + c (1) + space (1) + │ (3) = 16 bytes
    it("decodes 3-byte codepoint at byte 0") do ->
      var s = "│ 🍪 abc │"
      assert_eq(str_codepoint_at(s, 0), 0x2502)
    end

    it("decodes ASCII at byte 3 (after a 3-byte cp)") do ->
      var s = "│ 🍪 abc │"
      assert_eq(str_codepoint_at(s, 3), 0x20)
    end

    it("decodes 4-byte emoji codepoint at byte 4") do ->
      var s = "│ 🍪 abc │"
      assert_eq(str_codepoint_at(s, 4), 0x1F36A)
    end

    it("decodes ASCII after a 4-byte cp (byte 8)") do ->
      var s = "│ 🍪 abc │"
      assert_eq(str_codepoint_at(s, 8), 0x20)
      assert_eq(str_codepoint_at(s, 9), 0x61)
      assert_eq(str_codepoint_at(s, 10), 0x62)
    end

    it("returns 0 for out-of-bounds byte index") do ->
      var s = "abc"
      assert_eq(str_codepoint_at(s, 99), 0)
    end
  end

  describe("str_codepoint_byte_len — UTF-8 stride") do ->
    it("returns 1 for ASCII") do ->
      assert_eq(str_codepoint_byte_len("hello", 0), 1)
    end

    it("returns 2 for 2-byte codepoint (Latin-1 supplement)") do ->
      assert_eq(str_codepoint_byte_len(str_from_codepoint(0xE9), 0), 2)
    end

    it("returns 3 for 3-byte codepoint (BMP)") do ->
      assert_eq(str_codepoint_byte_len(str_from_codepoint(0x2502), 0), 3)
    end

    it("returns 4 for 4-byte codepoint (emoji)") do ->
      assert_eq(str_codepoint_byte_len(str_from_codepoint(0x1F36A), 0), 4)
    end

    it("walks a mixed string by stride") do ->
      var s = "🍪x"
      var i = 0
      var n = 0
      while i < str_byte_len(s)
        i = i + str_codepoint_byte_len(s, i)
        n = n + 1
      end
      assert_eq(n, 2)
    end
  end

  describe("str_codepoint_nth — ordinal access") do ->
    it("returns the n-th codepoint by index, not byte offset") do ->
      var s = "🍪x"
      assert_eq(str_codepoint_nth(s, 0), 0x1F36A)
      assert_eq(str_codepoint_nth(s, 1), 0x78)
    end

    it("returns 0 when codepoint index is past end") do ->
      var s = "abc"
      assert_eq(str_codepoint_nth(s, 99), 0)
    end
  end

  return qspec_main()
end
