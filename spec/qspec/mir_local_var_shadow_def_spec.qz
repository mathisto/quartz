## Regression: a top-level `def f` MUST NOT be directly dispatched when
## `f(...)` is called at a site where `f` names a local variable or
## function parameter holding a fn pointer.
##
## Pre-fix symptom: `mir_lower_call` looked up the call name globally
## first; the global `def f` (0 params) was returned, codegen emitted a
## direct MIR_CALL "f" with one arg, and `cg_emit_call_ops` panicked
## on `mir_func_get_param_type_name(0)` (callee has 0 params, code
## reads index 0). Crash was: SIGSEGV with "index out of bounds:
## index 0, size 0".
##
## The bug surfaced via `import * from std/gen` because `Stream.next`
## contains `var f = self.step; ...; f(self.frame)`. Any user
## program that defined a top-level `def f` triggered the crash on
## tiny programs once the prelude was auto-included.
##
## The repros below MUST be NAMED `f` AND have a parameter / local
## also named `f` AND a same-named top-level `def f` — that's the
## exact collision shape. Renaming the global breaks the regression.
##
## See `docs/bugs/done/CAN_E_TINY_PROGRAM_SIGSEGV.md`.

import * from qspec
import * from qspec/subprocess

def _compile_and_run(src: String): SubResult = subprocess_run(src)

def main(): Int
  describe("local var / param shadows same-named top-level def at call site") do ->
    it("function parameter `f` shadows top-level `def f`") do ->
      var r = _compile_and_run("""
def f(): Int = 42

def call_it(f: Fn(): Int): Int = f()

def main(): Int
  return call_it(-> 13)
end
""")
      assert_eq(r.exit_code, 13)
    end

    it("local `var f` shadows top-level `def f`") do ->
      var r = _compile_and_run("""
def f(): Int = 42

def main(): Int
  var f = -> 7
  return f()
end
""")
      assert_eq(r.exit_code, 7)
    end

    it("the original tiny-program repro: top-level `def f` + auto-prelude") do ->
      var r = _compile_and_run("""
def f(): Int = 1

def main(): Int
  return 0
end
""")
      assert_eq(r.exit_code, 0)
    end
  end
  return qspec_main()
end
