## Extern Def Tests
##
## Contract:
##   1. Extern c abs handles.
##   2. Extern c abs returns.
##   3. Extern c def calls.
##   4. Extern c function generates.
##   5. Extern c function with.
##   6. Extern def body is.
##   7. Multi-arg extern calls.
##   8. CPtr extern params.
##   9. Intrinsic name collision — extern wins.
##  10. Non-variadic call has no ... in signature.
##  11. Variadic extern still works.
##  12. Multi-module extern call.
import * from qspec
import * from qspec/subprocess

extern "C" def abs(x: Int): Int

def test_extern_def(): Void = assert_eq(abs(-42), 42)

def main(): Int
  describe("extern def syntax") do ->
    it("extern C def calls C function") do -> test_extern_def() end

    it("extern C abs returns positive for negative input") do ->
      assert_eq(abs(-1), 1)
    end

    it("extern C abs returns zero for zero") do ->
      assert_eq(abs(0), 0)
    end

    it("extern C abs returns positive for positive input") do ->
      assert_eq(abs(42), 42)
    end

    it("extern C abs handles large negative values") do ->
      assert_eq(abs(-1000000), 1000000)
    end

    it("extern C function with fn keyword compiles") do ->
      assert_compile_succeeds("""
        extern "C" def abs(x: Int): Int
        def main(): Int
          return abs(-5)
        end
      """)
    end

    it("extern C function generates correct IR declaration") do ->
      assert_ir_contains("""
        extern "C" def abs(x: Int): Int
        def main(): Int
          return abs(-1)
        end
      """, "declare i64 @abs(i64)")
    end

    it("extern def without C convention is an error") do ->
      assert_compile_error("""
        extern def abs(x: Int): Int
        def main(): Int
          return 0
        end
      """, "error")
    end

    it("multiple extern defs compile together") do ->
      assert_compile_succeeds("""
        extern "C" def abs(x: Int): Int
        extern "C" def strlen(s: CPtr): Int
        def main(): Int
          return abs(-1)
        end
      """)
    end

    it("extern def with CPtr parameter compiles") do ->
      assert_compile_succeeds("""
        extern "C" def strlen(s: CPtr): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("extern def with CInt return type compiles") do ->
      assert_compile_succeeds("""
        extern "C" def getpid(): CInt
        def main(): Int
          return 0
        end
      """)
    end

    it("extern def with Void return type compiles") do ->
      assert_compile_succeeds("""
        extern "C" def free(ptr: CPtr): Void
        def main(): Int
          return 0
        end
      """)
    end

    it("extern def with multiple parameters compiles") do ->
      assert_compile_succeeds("""
        extern "C" def memcpy(dest: CPtr, src: CPtr, n: Int): CPtr
        def main(): Int
          return 0
        end
      """)
    end

    it("extern def with body compiles as C-convention function") do ->
      assert_compile_succeeds("""
        extern "C" def my_abs(x: Int): CInt
          if x < 0
            return 0 - x
          end
          return x
        end
        def main(): Int
          return 0
        end
      """)
    end

  end

  describe("multi-arg extern calls") do ->
    it("multi-arg non-variadic extern runs correctly") do ->
      assert_run_exits("""
        extern "C" def abs(x: Int): Int
        def main(): Int
          var r = abs(-99)
          if r == 99
            return 0
          end
          return 1
        end
      """, 0)
    end

    it("CPtr parameter extern runs correctly") do ->
      assert_run_exits("""
        extern "C" def strlen(s: CPtr): Int
        def main(): Int
          var s = "hello"
          var len = strlen(str_to_ptr(s))
          if len == 5
            return 0
          end
          return 1
        end
      """, 0)
    end

    it("intrinsic-name collision — extern wins when imported") do ->
      # 'exit' collides with Quartz intrinsic; extern declaration should win
      assert_run_exits("""
        extern "C" def exit(status: Int): Void
        def main(): Int
          exit(0)
          return 1
        end
      """, 0)
    end

    it("non-variadic extern call IR has no ellipsis") do ->
      assert_ir_not_contains("""
        extern "C" def abs(x: Int): Int
        def main(): Int
          return abs(-1)
        end
      """, "...) @abs")
    end

    it("variadic extern printf still works") do ->
      assert_compile_succeeds("""
        extern "C" def printf(fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("multi-module extern call resolves cross-module") do ->
      var files: Vec = vec_new()
      files.push(as_int("ffi_mod.qz"))
      files.push(as_int("extern \"C\" def abs(x: Int): Int"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import ffi_mod\ndef main(): Int\n  return ffi_mod::abs(-7)\nend"))
      assert_multi_run_exits(files, 1, 7)
    end
  end

  return qspec_main()
end

