## Regression tests for A5 — lambda capture walker rejecting legitimate
## outer-scope bindings that shadow stdlib intrinsic names.
##
## HISTORY: The April 2026 impl Trait sprint's Phase 6 sub-agent hit a
## "closure synthesis scope bug" where a lambda parameter/outer variable
## named `first` produced IR referencing `%first` in a lambda function
## that never allocated it. Workaround at the time: rename the variable.
##
## Root cause found April 14 during Batch A+B sprint: the capture walker
## in `mir_collect_captures_walk` checked `mir_is_intrinsic(name)` BEFORE
## checking `mir_ctx_lookup_var(name)`. Names like `first`, `sum`, `map`,
## `take` are registered as collection intrinsics (v.first() etc.), and
## when a user-level local variable happened to share one of those names,
## the intrinsic check short-circuited before the walker could realize
## the name was a legitimate local that needed to be captured. The
## lambda body then emitted a load against an un-allocated slot.
##
## Fix: remove the pre-lookup intrinsic gate. `mir_ctx_lookup_var(ctx, name)
## >= 0` is the authoritative signal — if the name is bound as a local in
## the outer scope, it MUST be captured regardless of whether an
## intrinsic also exists with that name. The intrinsic is only reached
## at call sites, where no local binding exists.
##
## Contract:
##   1. Lambda capturing an outer variable named `first` works.
##   2. Lambda capturing an outer variable named `sum` works.
##   3. Lambda param named `first` (shadowing outer `first`) works —
##      the param takes precedence inside the lambda body.
##   4. Nested lambdas with shared names at 3 depths work.
##   5. Lambda passed as a higher-order arg, capturing outer named after
##      an intrinsic, works.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("lambda capture across intrinsic name shadow") do ->

    it("captures outer 'first' named after collection intrinsic") do ->
      assert_run_exits("""
        def capturer(): Int
          var first = 100
          var g = x -> first + x
          g(10)
        end
        def main(): Int
          return 0 if capturer() == 110
          return 1
        end
        """, 0)
    end

    it("captures outer 'sum' named after collection intrinsic") do ->
      assert_run_exits("""
        def capturer(): Int
          var sum = 50
          var g = x -> sum + x
          g(25)
        end
        def main(): Int
          return 0 if capturer() == 75
          return 1
        end
        """, 0)
    end

    it("lambda param 'first' shadowing outer 'first'") do ->
      assert_run_exits("""
        def adder(): Int
          var first = 100
          var f = first -> first + 1
          f(10)
        end
        def main(): Int
          return 0 if adder() == 11
          return 1
        end
        """, 0)
    end

    it("nested lambdas with shared 'x' name at 3 depths") do ->
      assert_run_exits("""
        def run_nested(): Int
          var x = 1
          var f = x -> {
            var g = x -> {
              var h = x -> x + 1
              h(x * 10)
            }
            g(x * 100)
          }
          f(10)
        end
        def main(): Int
          return 0 if run_nested() == 10001
          return 1
        end
        """, 0)
    end

    it("captures both outer 'first' AND 'sum' in same lambda") do ->
      assert_run_exits("""
        def both_caps(): Int
          var first = 100
          var sum = 5
          var g = x -> first + sum + x
          g(10)
        end
        def main(): Int
          return 0 if both_caps() == 115
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
