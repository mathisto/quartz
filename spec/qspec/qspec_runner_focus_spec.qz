## QSpec focus selection must not depend on declaration order.
import * from qspec

var focus_regular_bodies = 0
var focus_trace = ""

def regular_body(): Void
  focus_regular_bodies += 1
end

def first_focus_body(): Void
  focus_trace += "F"
  assert_eq(focus_regular_bodies, 0)
end

def second_focus_body(): Void
  focus_trace += "G"
  assert_eq_str(focus_trace, "FG")
end

def register_focus_cases(): Void
  it("ordinary before focus", regular_body)
  fit("focused first", first_focus_body)
  it("ordinary between focus", regular_body)
  fit("focused second", second_focus_body)
  it("ordinary after focus", regular_body)
end

def main(): Int
  describe("QSpec focus", register_focus_cases)
  if focus_regular_bodies != 0 or focus_trace != ""
    return 80
  end

  var failures = qspec_run()
  if failures != 0
    return 81
  end
  if focus_regular_bodies != 0 or focus_trace != "FG"
    return 82
  end
  if qspec_total() != 5 or qspec_passed() != 2 or qspec_skipped() != 3
    return 83
  end
  if qspec_assertions() != 2
    return 84
  end
  return qspec_main()
end
