## QSpec coverage for Phase B.1 — `with Alloc.in_arena(arena) do ... end`.
##
## Locks in the call-form sugar that replaces the A.5 module-global
## handler pattern with per-install state. Each `with Alloc.in_arena(a)`
## block installs the env-aware handlers (`arena_alloc_handler_e` /
## `arena_dealloc_handler_e`) and threads `a` through state_slots so
## `__qz_effect_state_get()` resolves the right arena per current
## install. Nested or sequential uses get independent state — the bug
## the A.5 module-global pattern leaves open.
##
## NOTE on triple-quoted snippet strings: `"""..."""` interpolates
## `#{...}` at SPEC compile time, not subprocess runtime. Snippets below
## build runtime output via `str_from_int` + concat to keep variables
## in-snippet.

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# B1.1 — basic install: alloc inside the with-block routes to the arena.
# -----------------------------------------------------------------------------

var _BASIC: String = """import std/alloc
import std/memory

var g_bytes = 0

def main(): Int
  var ar = arena_new(4096)
  with Alloc.in_arena(ar) do ->
    var p = alloc(64)
    store(p, 0, 42)
    g_bytes = arena_bytes_used(ar)
  end
  puts(\"bytes=\" + str_from_int(g_bytes))
  arena_destroy(ar)
  return 0
end
"""

# -----------------------------------------------------------------------------
# B1.2 — nesting: inner arena gets the inner alloc, outer recovers after.
# -----------------------------------------------------------------------------

var _NEST_INDEPENDENT: String = """import std/alloc
import std/memory

var g_outer_pre = 0
var g_inner = 0
var g_outer_post = 0

def main(): Int
  var a1 = arena_new(4096)
  var a2 = arena_new(4096)
  with Alloc.in_arena(a1) do ->
    var p1 = alloc(8)
    g_outer_pre = arena_bytes_used(a1)
    with Alloc.in_arena(a2) do ->
      var p2 = alloc(16)
      g_inner = arena_bytes_used(a2)
    end
    var p3 = alloc(32)
    g_outer_post = arena_bytes_used(a1)
  end
  puts(\"outer_pre=\" + str_from_int(g_outer_pre) +
       \" inner=\" + str_from_int(g_inner) +
       \" outer_post=\" + str_from_int(g_outer_post))
  arena_destroy(a1)
  arena_destroy(a2)
  return 0
end
"""

# -----------------------------------------------------------------------------
# B1.3 — sequential scopes have independent state.
# -----------------------------------------------------------------------------

var _SEQUENTIAL_INDEPENDENT: String = """import std/alloc
import std/memory

var g_a = 0
var g_b = 0
var g_c = 0

def main(): Int
  var ar_a = arena_new(4096)
  var ar_b = arena_new(4096)
  var ar_c = arena_new(4096)
  with Alloc.in_arena(ar_a) do ->
    var p = alloc(8)
    g_a = arena_bytes_used(ar_a)
  end
  with Alloc.in_arena(ar_b) do ->
    var p = alloc(16)
    g_b = arena_bytes_used(ar_b)
  end
  with Alloc.in_arena(ar_c) do ->
    var p = alloc(24)
    g_c = arena_bytes_used(ar_c)
  end
  puts(\"a=\" + str_from_int(g_a) +
       \" b=\" + str_from_int(g_b) +
       \" c=\" + str_from_int(g_c))
  arena_destroy(ar_a)
  arena_destroy(ar_b)
  arena_destroy(ar_c)
  return 0
end
"""

# -----------------------------------------------------------------------------
# B1.4 — arena_reset between with-blocks — arena lifecycle survives.
# -----------------------------------------------------------------------------

var _RESET_REUSE: String = """import std/alloc
import std/memory

var g_pre = 0
var g_post_reset = 0
var g_post_reuse = 0

def main(): Int
  var ar = arena_new(4096)
  with Alloc.in_arena(ar) do ->
    var p = alloc(64)
    g_pre = arena_bytes_used(ar)
  end
  arena_reset(ar)
  g_post_reset = arena_bytes_used(ar)
  with Alloc.in_arena(ar) do ->
    var q = alloc(32)
    g_post_reuse = arena_bytes_used(ar)
  end
  puts(\"pre=\" + str_from_int(g_pre) +
       \" reset=\" + str_from_int(g_post_reset) +
       \" reuse=\" + str_from_int(g_post_reuse))
  arena_destroy(ar)
  return 0
end
"""

# -----------------------------------------------------------------------------
# B1.5 — Vec push inside the with-block routes through the arena
# (post Phase A.7 every allocation routes — the universal coverage hook).
# -----------------------------------------------------------------------------

var _VEC_ROUTES_TO_ARENA: String = """import std/alloc
import std/memory

var g_used = 0

def main(): Int
  var ar = arena_new(8192)
  with Alloc.in_arena(ar) do ->
    var v = vec_new<Int>()
    v.push(1)
    v.push(2)
    v.push(3)
    g_used = arena_bytes_used(ar)
  end
  if g_used > 0
    puts(\"arena_observed_vec_alloc\")
  else
    puts(\"arena_bypass\")
  end
  arena_destroy(ar)
  return 0
end
"""

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("Phase B.1 — Alloc.in_arena(arena) sugar") do ->

    it("basic install — alloc(N) inside with-block routes to the arena") do ->
      assert_run_stdout_eq(_BASIC, "bytes=64\n")
    end

    it("nesting — inner arena observes inner alloc, outer recovers after") do ->
      # Byte counts reflect 16-byte alignment: alloc(8)=16, alloc(16)=16,
      # alloc(32)=32 → outer = 16 + 32 = 48; inner = 16.
      assert_run_stdout_eq(_NEST_INDEPENDENT,
        "outer_pre=16 inner=16 outer_post=48\n")
    end

    it("sequential scopes — each in_arena(ar) has independent state") do ->
      # alloc(8)=16, alloc(16)=16, alloc(24)=32.
      assert_run_stdout_eq(_SEQUENTIAL_INDEPENDENT,
        "a=16 b=16 c=32\n")
    end

    it("arena_reset between in_arena scopes — same arena reused") do ->
      assert_run_stdout_eq(_RESET_REUSE,
        "pre=64 reset=0 reuse=32\n")
    end

    it("Vec push inside in_arena — arena observes Vec storage allocation") do ->
      assert_run_stdout_eq(_VEC_ROUTES_TO_ARENA, "arena_observed_vec_alloc\n")
    end

  end
  return qspec_main()
end
