## QSpec coverage for the test-handler factories shipped in
## `std/quake.qz` Phase A.7 Phase 6:
##
##   - exec_recording_handler  — append every cmd to a module log
##   - exec_replaying_handler  — look up cmd in a pre-seeded result map
##
## Recording handler tests cover the full `sh*` surface (sh, sh_maybe,
## sh_capture, sh_buffered, sh_quiet) to prove every wrapper routes
## through `exec(cmd, opts)` cleanly. Replaying handler tests cover
## canned-result return + missing-key failure path. Composition test
## proves recording-innermost + replaying-outermost interleaves.
##
## See docs/design/EXEC_EFFECT_PLAN.md for the migration plan and
## std/quake.qz:233-309 for the factory implementations.

import * from qspec
import * from quake

# ============================================================
# Group 1: exec_recording_handler — cmd-log accumulator
# ============================================================
#
# Each test resets the log, runs one sh*-family call inside the
# recording-handler with-block, and asserts the captured cmd matches
# the expected wrapped form.

def t_record_sh(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _r = sh("echo hello")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  puts("0=#{log[0]}")
end

def t_record_sh_maybe(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _r = sh_maybe("ls -la")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  puts("0=#{log[0]}")
end

def t_record_sh_capture(): Void
  exec_recording_reset()
  var captured: String = ""
  with Exec { exec: exec_recording_handler } do ->
    captured = sh_capture("printf hi")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  puts("0=#{log[0]}")
  puts("captured=#{captured}")
end

def t_record_sh_buffered(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _r = sh_buffered("make build", "build")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  puts("0=#{log[0]}")
end

# sh_quiet wraps the cmd with `> /dev/null 2>&1`; the recorded entry
# reflects the wrapped form. This is the canonical way to assert a
# task uses sh_quiet (vs plain sh) without inspecting source.
def t_record_sh_quiet(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _r = sh_quiet("dangerous --tool")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  puts("0=#{log[0]}")
end

# Multi-call accumulation — three sh-shaped calls in sequence should
# produce three log entries in call order.
def t_record_multi(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _a = sh("first")
    var _b = sh_maybe("second")
    var _c = sh("third")
  end
  var log = exec_recording_log()
  puts("size=#{log.size}")
  for cmd in log
    puts(cmd)
  end
end

def t_record_reset(): Void
  exec_recording_reset()
  with Exec { exec: exec_recording_handler } do ->
    var _a = sh("before-reset")
  end
  puts("pre=#{exec_recording_log().size}")
  exec_recording_reset()
  puts("post=#{exec_recording_log().size}")
  with Exec { exec: exec_recording_handler } do ->
    var _b = sh("after-reset")
  end
  puts("re-record=#{exec_recording_log().size}")
end

# ============================================================
# Group 2: exec_replaying_handler — canned-result map
# ============================================================

# Register a cmd → ExecResult with non-zero exit code. sh_maybe
# returns that exit code without forking. Different cmds get
# different canned results.
def t_replay_basic(): Void
  exec_replaying_reset()
  exec_replaying_register("ok-cmd", 0, "", "")
  exec_replaying_register("fail-cmd", 17, "", "")
  with Exec { exec: exec_replaying_handler } do ->
    var ok = sh_maybe("ok-cmd")
    var bad = sh_maybe("fail-cmd")
    puts("ok=#{ok}")
    puts("bad=#{bad}")
  end
end

# sh_capture under replaying handler returns the canned stdout.
# Exit-code-0 + non-empty stdout is the typical "captured config /
# tool version" shape.
def t_replay_capture(): Void
  exec_replaying_reset()
  exec_replaying_register("git rev-parse HEAD", 0, "abc1234\n", "")
  with Exec { exec: exec_replaying_handler } do ->
    var sha = sh_capture("git rev-parse HEAD")
    puts("sha=#{sha}")
  end
end

# Missing-cmd path — replaying handler with no registration falls
# through to fail("no replay registered for: ..."). Throws install
# captures the message instead of exit(1).
def t_replay_missing(): Void
  exec_replaying_reset()
  with Throws { throw: capture_throw } do ->
    with Exec { exec: exec_replaying_handler } do ->
      var _r = sh_maybe("never-registered")
    end
  end
  puts("captured=#{_replay_throw_msg}")
end

# Helper for the missing-cmd test: capture the throw msg into a
# module-level slot so the test can assert on it after the with-block
# unwinds.
var _replay_throw_msg: String = ""

def capture_throw(op_name: Int, argc: Int, argv: Int): Int
  _replay_throw_msg = as_string(load(argv, 0))
  return 0
end

def t_replay_reset(): Void
  exec_replaying_reset()
  exec_replaying_register("rm -rf /", 0, "", "")
  with Exec { exec: exec_replaying_handler } do ->
    var r1 = sh_maybe("rm -rf /")
    puts("first=#{r1}")
  end
  exec_replaying_reset()
  with Throws { throw: capture_throw } do ->
    with Exec { exec: exec_replaying_handler } do ->
      var _r = sh_maybe("rm -rf /")
    end
  end
  puts("post-reset-msg=#{_replay_throw_msg}")
end

# ============================================================
# Group 3: composition — recording innermost, replaying outermost
# ============================================================
#
# Innermost install wins on each `exec` perform, so the recording
# handler intercepts every cmd. The outermost replay table is
# unused — but proves that the two factories don't interfere with
# each other when stacked.

def t_compose_record_inside_replay(): Void
  exec_recording_reset()
  exec_replaying_reset()
  exec_replaying_register("any", 99, "outer-stdout", "")
  with Exec { exec: exec_replaying_handler } do ->
    with Exec { exec: exec_recording_handler } do ->
      var rc = sh_maybe("any")
      puts("rc=#{rc}")
    end
  end
  puts("recorded=#{exec_recording_log().size}")
  puts("0=#{exec_recording_log()[0]}")
end

def main(): Int
  describe("Exec effect: test-handler factories (A.7 Phase 6)") do ->

    it("recording: sh() captures cmd verbatim") do ->
      assert_output("size=1\n0=echo hello\n", t_record_sh)
    end
    it("recording: sh_maybe() captures cmd verbatim") do ->
      assert_output("size=1\n0=ls -la\n", t_record_sh_maybe)
    end
    it("recording: sh_capture() captures cmd; returns empty stdout") do ->
      assert_output("size=1\n0=printf hi\ncaptured=\n", t_record_sh_capture)
    end
    it("recording: sh_buffered() captures cmd (step_name discarded)") do ->
      assert_output("size=1\n0=make build\n", t_record_sh_buffered)
    end
    it("recording: sh_quiet() captures the wrapped cmd") do ->
      assert_output("size=1\n0=dangerous --tool > /dev/null 2>&1\n", t_record_sh_quiet)
    end
    it("recording: multi-call accumulation in call order") do ->
      assert_output("size=3\nfirst\nsecond\nthird\n", t_record_multi)
    end
    it("recording: reset clears the log between blocks") do ->
      assert_output("pre=1\npost=0\nre-record=1\n", t_record_reset)
    end

    it("replaying: registered cmds return canned exit codes") do ->
      assert_output("ok=0\nbad=17\n", t_replay_basic)
    end
    it("replaying: sh_capture returns canned stdout") do ->
      assert_output("sha=abc1234\n\n", t_replay_capture)
    end
    it("replaying: missing cmd fails loudly with explanatory message") do ->
      assert_output("captured=no replay registered for: never-registered\n", t_replay_missing)
    end
    it("replaying: reset clears registrations") do ->
      assert_output("first=0\npost-reset-msg=no replay registered for: rm -rf /\n", t_replay_reset)
    end

    it("composition: recording-inside-replaying — inner handler wins") do ->
      assert_output("rc=0\nrecorded=1\n0=any\n", t_compose_record_inside_replay)
    end

  end
  return qspec_main()
end
