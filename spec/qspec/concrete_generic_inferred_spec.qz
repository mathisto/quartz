## Regression spec for concrete generic instantiations on the inference-only
## call path (CONCRETE_GENERIC_INFERRED_TYPE_ARGS_REJECTED).
##
## Sister to concrete_generic_at_annot_spec.qz which closed the explicit-args
## variant. Pre-fix, calling a generic function WITHOUT spelling the type args
## (`make<String>()`) left the call's TypeId carrying TYPE_ERROR for the
## generic's inner arg, so any consumer annotating `Generic<Concrete>` at a
## struct field, var binding, or return type produced
## `QZ0200: expected unknown, got unknown`. The closed fix only ran the
## param→concrete substitution when the call carried explicit type args; this
## regression guards the inferred-args path that infers T from argument types.

import * from qspec

struct CGIBox<T>
  v: Vec<T>
end

def cgibox_from<T>(seed: T): CGIBox<T>
  var v = vec_new<T>()
  vec_push(v, seed)
  return CGIBox<T> { v: v }
end

struct CGIState
  cards: CGIBox<String>
  status: String
end

def cgistate_status(): String
  var s = CGIState { cards: cgibox_from("hello"), status: "ok" }
  return s.status
end

def cgibox_inferred_var_size(): Int
  var c: CGIBox<String> = cgibox_from("hi")
  return c.v.size
end

def cgibox_str_returned_inferred(): CGIBox<String>
  return cgibox_from("hi")
end

def main(): Int
  describe("concrete generic instantiations on the inference-only call path") do ->

    it("compiles a struct field of Generic<Concrete> from an inferred-args call") do ->
      assert_eq_str(cgistate_status(), "ok")
    end

    it("compiles a var annotation Generic<Concrete> from an inferred-args call") do ->
      assert_eq(cgibox_inferred_var_size(), 1)
    end

    it("compiles a return-type Generic<Concrete> from an inferred-args call") do ->
      var b = cgibox_str_returned_inferred()
      assert_eq(b.v.size, 1)
    end

  end
  return qspec_main()
end
