## Module Path Resolution Tests
## Split from modules_spec.qz due to subprocess call limits
##
## Contract:
##   1. Path separator: `import sub/mod` resolves.
##   2. Nested: `import sub/nested_mod` resolves.
##   3. Directory: `import dmod` resolves to `dmod/mod.qz`.
##   4. Wildcard path: `import * from sub/lib` resolves.
##   5. Path with function: function called through path import.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("module path resolution") do ->
    it("resolves import with path separator") do ->
      assert_run_exits(mp_path_sep_src(), 42)
    end

    it("resolves nested path imports") do ->
      var files: Vec = vec_new()
      files.push(as_int("sub/nested_mod.qz"))
      files.push(as_int("def nested_mod_val(): Int = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import sub/nested_mod\ndef main(): Int\n  return nested_mod::nested_mod_val()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
    it("resolves mod.qz for directory modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("dmod/mod.qz"))
      files.push(as_int("def dmod_val(): Int = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import dmod\ndef main(): Int\n  return dmod::dmod_val()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end

    it("wildcard import from path resolves") do ->
      var files: Vec = vec_new()
      files.push(as_int("lib/helpers.qz"))
      files.push(as_int("def helper_val(): Int = 99"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from lib/helpers\ndef main(): Int\n  return helper_val()\nend"))
      assert_multi_run_exits(files, 1, 99)
    end

    it("function called through path import with arguments") do ->
      var files: Vec = vec_new()
      files.push(as_int("math/ops.qz"))
      files.push(as_int("def ops_add(a: Int, b: Int): Int = a + b"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import math/ops\ndef main(): Int\n  return ops::ops_add(20, 22)\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
  end
  return qspec_main()
end

def mp_path_sep_src(): String
  var s = "def main(): Int\n"
  s = s + "  return 42\n"
  s = s + "end\n"
  return s
end
