## Generic UFCS Dispatch Tests
## Tests closure-based dispatch for Iterator-bounded generic functions.
## When a function has <T: Iterator> bounds, the compiler transforms
## Iterator params into closures and auto-synthesizes closures at call sites.
##
## Contract:
##   1. Generic UFCS dispatch — Iterator closure synthesis.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic UFCS dispatch — Iterator closure synthesis") do ->
    it("basic sum via for-in in bounded generic") do ->
      assert_run_exits(gud_counter_src() + """
        def sum_iter<T: Iterator>(iter: T): Int
          var total = 0
          for x in iter
            total = total + x
          end
          return total
        end
        def main(): Int
          c = Counter { current: 0, limit: 10 }
          return sum_iter(c)
        end
        """, 45)
    end

    it("count elements via for-in in bounded generic") do ->
      assert_run_exits(gud_counter_src() + """
        def count_iter<T: Iterator>(iter: T): Int
          var count = 0
          for x in iter
            count += 1
          end
          return count
        end
        def main(): Int
          c = Counter { current: 0, limit: 10 }
          return count_iter(c)
        end
        """, 10)
    end

    it("for-in inside bounded generic sums correctly") do ->
      assert_run_exits(gud_counter_src() + """
        def total<T: Iterator>(iter: T): Int
          var sum = 0
          for x in iter
            sum = sum + x
          end
          return sum
        end
        def main(): Int
          c = Counter { current: 5, limit: 10 }
          return total(c)
        end
        """, 35)
    end

    it("break from for-in inside bounded generic") do ->
      assert_run_exits(gud_counter_src() + """
        def sum_until<T: Iterator>(iter: T, max: Int): Int
          var total = 0
          for x in iter
            if x > max
              break
            end
            total = total + x
          end
          return total
        end
        def main(): Int
          c = Counter { current: 0, limit: 10 }
          return sum_until(c, 4)
        end
        """, 10)
    end

    it("continue in for-in inside bounded generic") do ->
      assert_run_exits(gud_counter_src() + """
        def sum_odd<T: Iterator>(iter: T): Int
          var total = 0
          for x in iter
            if x % 2 == 0
              continue
            end
            total = total + x
          end
          return total
        end
        def main(): Int
          c = Counter { current: 0, limit: 10 }
          return sum_odd(c)
        end
        """, 25)
    end

    it("call with two different Iterator types") do ->
      assert_run_exits(gud_counter_src() + gud_down_counter_src() + """
        def sum_iter<T: Iterator>(iter: T): Int
          var total = 0
          for x in iter
            total = total + x
          end
          return total
        end
        def main(): Int
          c1 = Counter { current: 0, limit: 5 }
          c2 = DownCounter { current: 5 }
          a = sum_iter(c1)
          b = sum_iter(c2)
          return a + b
        end
        """, 20)
    end

    it("empty iterator returns 0") do ->
      assert_run_exits(gud_counter_src() + """
        def sum_iter<T: Iterator>(iter: T): Int
          var total = 0
          for x in iter
            total = total + x
          end
          return total
        end
        def main(): Int
          c = Counter { current: 0, limit: 0 }
          return sum_iter(c)
        end
        """, 0)
    end

    it("adapter chain (MapIter) passed to bounded generic") do ->
      assert_run_exits(gud_counter_src() + """
        struct MapIter
          inner: Counter
        end
        extend MapIter with Iterator<Int>
          def next(self): Option<Int>
            result = Counter::next(self.inner)
            match result
              Some(v) => return Option::Some(v * 2)
              None => return Option::None
            end
          end
        end
        def sum_iter<T: Iterator>(iter: T): Int
          var total = 0
          for x in iter
            total = total + x
          end
          return total
        end
        def main(): Int
          c = Counter { current: 0, limit: 10 }
          m = MapIter { inner: c }
          return sum_iter(m)
        end
        """, 90)
    end
  end

  return qspec_main()
end

def gud_counter_src(): String = """
  import traits
  struct Counter
    current: Int
    limit: Int
  end
  extend Counter with Iterator<Int>
    def next(&mut self): Option<Int>
      if self.current >= self.limit
        return Option::None
      end
      var val = self.current
      self.current = val + 1
      return Option::Some(val)
    end
  end
  """ + "\n"

def gud_down_counter_src(): String = """
  struct DownCounter
    current: Int
  end
  extend DownCounter with Iterator<Int>
    def next(&mut self): Option<Int>
      if self.current <= 0
        return Option::None
      end
      self.current -= 1
      return Option::Some(self.current)
    end
  end
  """ + "\n"
