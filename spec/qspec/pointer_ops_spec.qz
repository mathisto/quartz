import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("ptr_read") do ->
    it("reads an Int from a pointer") do ->
      var p = ptr_alloc(1)
      ptr_write(p, 42)
      var val = ptr_read(p)
      assert_eq(val, 42)
    end

    it("works with pointer arithmetic") do ->
      var p = ptr_alloc(2)
      ptr_write(p, 10)
      ptr_write(p + 8, 20)
      var v0 = ptr_read(p)
      var v1 = ptr_read(p + 8)
      assert_eq(v0, 10)
      assert_eq(v1, 20)
    end
  end

  describe("ptr_write") do ->
    it("writes an Int to a pointer") do ->
      var p = ptr_alloc(1)
      ptr_write(p, 99)
      var val = ptr_read(p)
      assert_eq(val, 99)
    end

    it("combined read and write") do ->
      var p = ptr_alloc(2)
      ptr_write(p, 5)
      ptr_write(p + 8, 10)
      var sum = ptr_read(p) + ptr_read(p + 8)
      assert_eq(sum, 15)
    end
  end

  describe("type safety") do ->
    it("ptr_read requires exactly 1 argument") do ->
      assert_compile_error("""
        def main(): Int
          var p = ptr_alloc(1)
          return ptr_read(p, 99)
        end
      """, "at most 1")
    end

    it("ptr_write requires exactly 2 arguments") do ->
      assert_compile_error("""
        def main(): Int
          var p = ptr_alloc(1)
          ptr_write(p)
          return 0
        end
      """, "at least 2")
    end
  end

  describe("advanced pointer ops") do ->
    it("ptr_write at computed offset then read") do ->
      var p = ptr_alloc(4)
      var i = 2
      var offset = i * 8
      ptr_write(p + offset, 77)
      var val = ptr_read(p + offset)
      assert_eq(val, 77)
    end

    it("multiple writes then reads") do ->
      var p = ptr_alloc(4)
      ptr_write(p, 100)
      ptr_write(p + 8, 200)
      ptr_write(p + 16, 300)
      ptr_write(p + 24, 400)
      var v0 = ptr_read(p)
      var v1 = ptr_read(p + 8)
      var v2 = ptr_read(p + 16)
      var v3 = ptr_read(p + 24)
      assert_eq(v0, 100)
      assert_eq(v1, 200)
      assert_eq(v2, 300)
      assert_eq(v3, 400)
    end
  end

  return qspec_main()
end
