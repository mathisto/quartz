## Vec<Option<struct>> niche round-trip tests (item 6.4a).
##
## Repro for the collection-element / vec_push None niche hole:
##   v.push(Some(P{..})); v.push(None); then v[1] is Some must be 0 (None),
##   and match v[1] { Some(p) => ; None => } must fire the None arm.
##
## Representation-agnostic: must pass under tagged and niche layouts alike.
import * from qspec

struct Point
  x: Int
  y: Int
end

def main(): Int
  describe("Vec<Option<Point>> — push Some then None, read back") do ->
    it("v[1] is None after push(None) following push(Some)") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 10, y: 20 }))
      v.push(Option::None)
      assert_eq(v[1] is None, 1)
    end
    it("v[1] is Some returns 0 for the pushed None") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 10, y: 20 }))
      v.push(Option::None)
      assert_eq(v[1] is Some, 0)
    end
    it("v[0] is Some for the pushed Some") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 10, y: 20 }))
      v.push(Option::None)
      assert_eq(v[0] is Some, 1)
    end
    it("match v[0] reads the Some payload fields") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 10, y: 20 }))
      v.push(Option::None)
      r = match v[0]
        Some(p) => p.x + p.y
        None => -1
      end
      assert_eq(r, 30)
    end
    it("match v[1] fires the None arm") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 10, y: 20 }))
      v.push(Option::None)
      r = match v[1]
        Some(p) => p.x + p.y
        None => -99
      end
      assert_eq(r, -99)
    end
  end

  describe("Vec<Option<Point>> — None first then Some") do ->
    it("v[0] is None, v[1] is Some") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::None)
      v.push(Option::Some(Point { x: 1, y: 2 }))
      assert_eq(v[0] is None, 1)
      assert_eq(v[1] is Some, 1)
    end
  end

  describe("Vec<Option<Point>> — unwrap roundtrip") do ->
    it("v[0].unwrap().x reads payload") do ->
      var v: Vec<Option<Point>> = vec_new()
      v.push(Option::Some(Point { x: 7, y: 99 }))
      p = v[0].unwrap()
      assert_eq(p.x, 7)
    end
  end

  return qspec_main()
end
