## recv_timeout Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("recv_timeout") do ->
    it("returns Some when data arrives before timeout") do ->
      assert_run_exits(rt_some_src(), 0)
    end
    it("returns None when timeout expires") do ->
      assert_run_exits(rt_none_src(), 0)
    end
    it("returns None on closed empty channel") do ->
      assert_run_exits(rt_closed_src(), 0)
    end
    it("zero timeout behaves like try_recv") do ->
      assert_run_exits(rt_zero_src(), 0)
    end
  end
  return qspec_main()
end

def rt_some_src(): String = """
  def sender(ch: Int): Int
    send(ch, 42)
    return 0
  end
  def main(): Int
    ch = channel_new(1)
    h = go sender(ch)
    result = recv_timeout(ch, 5000)
    tag = load(result, 0)
    val = load(result, 1)
    await h
    if tag == 0 and val == 42
      return 0
    end
    return 1
  end
  """

def rt_none_src(): String = """
  def main(): Int
    ch = channel_new(1)
    result = recv_timeout(ch, 100)
    tag = load(result, 0)
    if tag == 1
      return 0
    end
    return 1
  end
  """

def rt_closed_src(): String = """
  def main(): Int
    ch = channel_new(1)
    channel_close(ch)
    result = recv_timeout(ch, 1000)
    tag = load(result, 0)
    if tag == 1
      return 0
    end
    return 1
  end
  """

def rt_zero_src(): String = """
  def main(): Int
    ch = channel_new(1)
    result = recv_timeout(ch, 0)
    tag = load(result, 0)
    if tag == 1
      return 0
    end
    return 1
  end
  """
