## Option Returns Tests
##
## Contract:
##   1. Regex match with unwrap_or.
##   2. Regex_match_end found returns some.
##   3. Regex_match_end not found returns.
##   4. Regex_match_end with pattern.
##   5. Regex_match_start found returns some.
##   6. Regex_match_start not found returns.
import * from qspec

def main(): Int
  describe("Option<T> returns") do ->

    ## vec_index_of returns Option<Int>
    it("vec_index_of found returns Some") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var result = vec_index_of(v, 20)
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
    end

    it("vec_index_of not found returns None") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      var result = vec_index_of(v, 99)
      assert(result.none?)
    end

    it("vec_index_of empty vec returns None") do ->
      var v = vec_new()
      var result = vec_index_of(v, 1)
      assert(result.none?)
    end

    it("vec_index_of first element") do ->
      var v = vec_new()
      v.push(42)
      v.push(43)
      var result = vec_index_of(v, 42)
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
    end

    it("vec_index_of UFCS .index_of") do ->
      var v = vec_new()
      v.push(5)
      v.push(10)
      var result = v.index_of(10)
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
    end

    it("vec_index_of with match") do ->
      var v = vec_new()
      v.push(100)
      var idx = match vec_index_of(v, 100)
        Some(i) => i
        None => -1
      end
      assert_eq(idx, 0)
    end

    ## regex_match_start returns Option<Int>
    it("regex_match_start found returns Some") do ->
      var result = regex_match_start("hello world", "world")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end

    it("regex_match_start not found returns None") do ->
      var result = regex_match_start("hello", "xyz")
      assert(result.none?)
    end

    it("regex_match_start with pattern") do ->
      var result = regex_match_start("abc123def", "[0-9]+")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
    end

    ## regex_match_end returns Option<Int>
    it("regex_match_end found returns Some") do ->
      var result = regex_match_end("hello world", "world")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 11)
        _ => assert_eq(0, 1)
      end
    end

    it("regex_match_end not found returns None") do ->
      var result = regex_match_end("hello", "xyz")
      assert(result.none?)
    end

    it("regex_match_end with pattern") do ->
      var result = regex_match_end("abc123def", "[0-9]+")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end

    ## match on Option returns
    it("regex match with unwrap_or") do ->
      var start = match regex_match_start("hello", "xyz")
        Some(i) => i
        None => -1
      end
      assert_eq(start, -1)
    end

  end

  return qspec_main()
end
