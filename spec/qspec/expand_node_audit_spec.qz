## D1 regression tests — macro expansion must recurse into every AST slot
## that can contain a macro call.
##
## Background: `expand_node` in self-hosted/frontend/macro_expand.qz walks
## the AST after parsing and replaces NodeMacroCall with the macro body.
## If a branch reads/writes the wrong slot, macros in that position are
## silently dropped. This is how B4-UNWRAP-IN-LOOP was born (NODE_ASSIGN
## read `right` when the constructor stored the RHS in `left`).
##
## D1 applied the C5 lesson preemptively to every branch in expand_node:
##   - NODE_UNARY: was reading right, fixed to left (operand slot)
##   - NODE_FOR: was missing iterable recursion
##   - NODE_FOR_AWAIT: was missing channel recursion
##   - NODE_TRY_CATCH: was missing pattern recursion
##   - NODE_TRY_EXPR/DEFER/YIELD/ASYNC_CALL/GO/IS_CHECK: added (left slot)
##
## Each spec below places `$unwrap(opt)` (equivalent to `opt!`) in the
## position under test and verifies the macro actually runs.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("expand_node slot coverage") do ->

    # ---- Assign-shape coverage ----

    it("macro in plain assignment RHS") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(42)
          var x = 0
          x = opt!
          return 0 if x == 42
          return 1
        end
        """, 0)
    end

    it("macro in compound assignment RHS (regression lock)") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(5)
          var sum = 0
          sum += opt!
          return 0 if sum == 5
          return 1
        end
        """, 0)
    end

    it("macro in index assignment value") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(99)
          var v = [0, 0, 0]
          v[1] = opt!
          return 0 if v[1] == 99
          return 1
        end
        """, 0)
    end

    # ---- Unary operand (was wrong slot) ----

    it("macro as unary operand") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(7)
          var neg = -(opt!)
          return 0 if neg == -7
          return 1
        end
        """, 0)
    end

    # ---- For / For-await iterable slot ----

    it("macro as for-loop iterable") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some([1, 2, 3])
          var total = 0
          for x in opt!
            total += x
          end
          return 0 if total == 6
          return 1
        end
        """, 0)
    end

    # ---- If / Match conditions ----

    it("macro in if condition") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(1)
          if opt! == 1
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("macro in return value") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(0)
          return opt!
        end
        """, 0)
    end

  end
  return qspec_main()
end
