## LookupResult Dogfooding Tests
##
## Contract:
##   1. Scanning: vector-scanning lookup returning LookupResult.
##   2. Guard: guard-clause pattern at call sites.
##   3. Is_found: `lookup_is_found` helper pattern.
##   4. Unwrap: `lookup_unwrap` helper pattern.
##   5. First item: lookup finding first element.
##   6. Empty: lookup on empty vec returns NotFound.

import * from qspec

enum LookupResult
  Found(value: Int)
  NotFound
end

def lr_lookup_by_name(names: Vec<String>, target: String): LookupResult
  var count = names.size
  var i = 0
  while i < count
    var name = names[i]
    if name == target
      return LookupResult::Found(i)
    end
    i = i + 1
  end
  return LookupResult::NotFound
end

def lr_lookup_is_found(r: LookupResult): Int
  var out = match r
    LookupResult::Found(v) => 1
    LookupResult::NotFound => 0
  end
  return out
end

def lr_lookup_unwrap(r: LookupResult): Int
  var out = match r
    LookupResult::Found(v) => v
    LookupResult::NotFound => -1
  end
  return out
end

def lr_find_rect(): Int
  var names: Vec<String> = vec_new()
  names.push("Point")
  names.push("Rect")
  names.push("Circle")
  var result = lr_lookup_by_name(names, "Rect")
  var idx = match result
    LookupResult::Found(i) => i
    LookupResult::NotFound => 99
  end
  return idx
end

def lr_find_missing(): Int
  var names: Vec<String> = vec_new()
  names.push("Point")
  names.push("Rect")
  var result = lr_lookup_by_name(names, "Triangle")
  var idx = match result
    LookupResult::Found(i) => i
    LookupResult::NotFound => 77
  end
  return idx
end

def lr_guard_found(): Int
  var names: Vec<String> = vec_new()
  var types: Vec<Int> = vec_new()
  names.push("Point")
  types.push(42)
  names.push("Rect")
  types.push(55)
  var result = lr_lookup_by_name(names, "Rect")
  var idx = match result
    LookupResult::Found(v) => v
    LookupResult::NotFound => -1
  end
  if idx == -1
    return 0
  end
  return types[idx]
end

def lr_guard_not_found(): Int
  var names: Vec<String> = vec_new()
  var types: Vec<Int> = vec_new()
  names.push("Point")
  types.push(42)
  var result = lr_lookup_by_name(names, "Missing")
  var idx = match result
    LookupResult::Found(v) => v
    LookupResult::NotFound => -1
  end
  if idx == -1
    return 88
  end
  return types[idx]
end

def lr_is_found_test(): Int
  var names: Vec<String> = vec_new()
  names.push("Point")
  names.push("Rect")
  var r1 = lr_lookup_by_name(names, "Point")
  var r2 = lr_lookup_by_name(names, "Unknown")
  var a = 0
  if lr_lookup_is_found(r1)
    a = 7
  end
  var b = 0
  if lr_lookup_is_found(r2)
    b = 7
  end
  return a + b
end

def lr_unwrap_test(): Int
  var names: Vec<String> = vec_new()
  names.push("Alpha")
  names.push("Beta")
  names.push("Gamma")
  var result = lr_lookup_by_name(names, "Gamma")
  return lr_lookup_unwrap(result)
end

def main(): Int
  describe("vector-scanning lookup returning LookupResult") do ->
    it("finds item by name in parallel vectors") do ->
      assert_eq(lr_find_rect(), 1)
    end

    it("returns NotFound for missing name") do ->
      assert_eq(lr_find_missing(), 77)
    end
  end

  describe("guard-clause pattern at call sites") do ->
    it("uses match to guard and extract index") do ->
      assert_eq(lr_guard_found(), 55)
    end

    it("early returns on NotFound in guard clause") do ->
      assert_eq(lr_guard_not_found(), 88)
    end
  end

  describe("lookup_is_found helper pattern") do ->
    it("checks existence without extracting value") do ->
      assert_eq(lr_is_found_test(), 7)
    end
  end

  describe("lookup_unwrap helper pattern") do ->
    it("unwraps Found value for further use") do ->
      assert_eq(lr_unwrap_test(), 2)
    end
  end

  describe("lookup edge cases") do ->
    it("finds first element at index 0") do ->
      var names: Vec<String> = vec_new()
      names.push("Alpha")
      names.push("Beta")
      var r = lr_lookup_by_name(names, "Alpha")
      assert_eq(lr_lookup_unwrap(r), 0)
    end

    it("returns NotFound on empty vec") do ->
      var names: Vec<String> = vec_new()
      var r = lr_lookup_by_name(names, "anything")
      assert_eq(lr_lookup_is_found(r), 0)
    end
  end

  return qspec_main()
end
