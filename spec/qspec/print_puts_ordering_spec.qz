## Regression: `print` (no newline) and `puts` (newline) must interleave in
## program order, even when stdout is buffered (a pipe or file).
##
## `print` previously emitted a raw `write(1, ...)` syscall — unbuffered, so
## it flushed immediately — while `puts`/`print_int` go through libc's
## buffered FILE* stdout, which (on a non-tty) only flushes at exit. Mixing
## the two scrambled output: every `print` raced ahead of every `puts`.
## The fix routes `print` through libc `printf("%s", ...)`, sharing the one
## stdout buffer. The subprocess harness captures stdout to a file (buffered),
## so this spec reproduces the original failure. See A.44.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("print/puts output ordering") do ->
    it("interleaved print and puts stay in program order") do ->
      assert_run_stdout_eq(interleave_src(), "AAA\n[B]CCC\n[D]EEE\n")
    end

    it("print before puts is not reordered after it") do ->
      assert_run_stdout_eq(print_then_puts_src(), "xyEND\n")
    end

    it("print interleaves with print_int in order") do ->
      # print_int appends its own newline (@.fmt.int = "%ld\n"); the point
      # here is ordering — `n=` (print) precedes `42` (print_int) precedes
      # ` done` (puts), none reordered by buffering.
      assert_run_stdout_eq(print_int_mix_src(), "n=42\n done\n")
    end
  end

  return qspec_main()
end

def interleave_src(): String = """
  def show(label: String): Void
    print(label)
  end
  def main(): Int
    puts("AAA")
    show("[B]")
    puts("CCC")
    show("[D]")
    puts("EEE")
    return 0
  end
  """

def print_then_puts_src(): String = """
  def main(): Int
    print("x")
    print("y")
    puts("END")
    return 0
  end
  """

def print_int_mix_src(): String = """
  def main(): Int
    print("n=")
    print_int(42)
    puts(" done")
    return 0
  end
  """
