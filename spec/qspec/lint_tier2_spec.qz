## Lint Tier 2 (AST-based) Rule Tests
##
## Tests QZ7004 (unused variable), QZ7203 (variable shadowing),
## QZ7204 (redundant return), inline suppression, and LintConfig.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("lint helper assertion accounting") do ->
    it("counts pass and failure paths exactly once") do ->
      var compiler = _sub_compiler_str
      var base = matcher_assertion_count()
      var base_failures = matcher_failure_count()
      _sub_compiler_str = "/usr/bin/true"
      assert_lint_clean("def main(): Int = 0\n")
      var clean_pass = matcher_assertion_count() == base + 1 and matcher_failure_count() == 0
      assert_lint_warns("def main(): Int = 0\n", "QZ7999")
      var warns_fail = matcher_assertion_count() == base + 2 and matcher_failure_count() > 0
      _matcher_restore(matcher_assertion_count(), base_failures)
      _sub_compiler_str = "/usr/bin/ruby"
      assert_lint_warns("def main(): Int = 0\n", "LoadError")
      var warns_pass = matcher_assertion_count() == base + 3 and matcher_failure_count() == 0
      assert_lint_clean("def main(): Int = 0\n")
      var clean_fail = matcher_assertion_count() == base + 4 and matcher_failure_count() > 0
      _matcher_restore(matcher_assertion_count(), base_failures)
      _sub_compiler_str = compiler
      if not clean_pass or not warns_fail or not warns_pass or not clean_fail
        _record_failure("lint helpers must count exactly once on pass and failure")
      end
    end
  end

  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint tier2 (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("QZ7004: Unused variables") do ->

    it("detects unused let binding") do ->
      assert_lint_warns("def main(): Int\n  var x = 42\n  return 0\nend\n", "QZ7004")
    end

    it("ignores used variable") do ->
      assert_lint_clean("def main(): Int\n  var x = 42\n  return x\nend\n")
    end

    it("ignores underscore-prefixed variable") do ->
      src = "def main(): Int\n  var _unused = 42\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("QZ7004 should not fire on _unused")
      end
    end

    it("detects multiple unused variables") do ->
      src = "def main(): Int\n  var a = 1\n  var b = 2\n  return 0\nend\n"
      r = subprocess_lint(src)
      assert_eq(str_contains(r.stderr_content, "QZ7004"), true)
    end

    it("does not flag variables used in nested blocks") do ->
      src = "def main(): Int\n  var x = 1\n  if true\n    return x\n  end\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("QZ7004 should not fire when var used in nested block")
      end
    end
  end

  describe("QZ7203: Variable shadowing") do ->

    it("detects shadowed variable in nested block") do ->
      src = "def main(): Int\n  var x = 1\n  if true\n    var x = 2\n    return x\n  end\n  return x\nend\n"
      assert_lint_warns(src, "QZ7203")
    end

    it("does not flag different names in nested block") do ->
      src = "def main(): Int\n  var x = 1\n  if true\n    var y = 2\n    return y\n  end\n  return x\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7203")
        _record_failure("QZ7203 should not fire for different variable names")
      end
    end

    it("detects parameter shadowing") do ->
      src = "def foo(x: Int): Int\n  if true\n    var x = 2\n    return x\n  end\n  return x\nend\n"
      assert_lint_warns(src, "QZ7203")
    end

    it("ignores underscore-prefixed shadows") do ->
      src = "def main(): Int\n  var _x = 1\n  if true\n    var _x = 2\n    return _x\n  end\n  return _x\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7203")
        _record_failure("QZ7203 should not fire on _ prefixed variables")
      end
    end
  end

  describe("QZ7204: Redundant return") do ->

    it("detects single-return function") do ->
      src = "def foo(): Int\n  return 42\nend\n"
      assert_lint_warns(src, "QZ7204")
    end

    it("does not flag multi-statement function") do ->
      src = "def foo(): Int\n  var x = 1\n  return x\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7204")
        _record_failure("QZ7204 should not fire on multi-statement body")
      end
    end

    it("does not flag endless def") do ->
      src = "def foo(): Int = 42\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7204")
        _record_failure("QZ7204 should not fire on already-endless def")
      end
    end
  end

  describe("Inline suppression") do ->

    it("suppresses with previous-line comment") do ->
      src = "def main(): Int\n  # lint:disable QZ7004\n  var x = 42\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("QZ7004 should be suppressed by inline comment")
      end
    end

    it("suppresses with end-of-line comment") do ->
      src = "def main(): Int\n  var x = 42  # lint:disable QZ7004\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("QZ7004 should be suppressed by end-of-line comment")
      end
    end

    it("wrong code does not suppress") do ->
      src = "def main(): Int\n  # lint:disable QZ7999\n  var x = 42\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7004")
    end

    it("suppresses all with lint:disable all") do ->
      src = "def main(): Int\n  # lint:disable all\n  var x = 42\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7004")
        _record_failure("lint:disable all should suppress QZ7004")
      end
    end
  end

  return qspec_main()
end
