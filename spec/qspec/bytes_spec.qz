## Bytes Tests
##
## Contract:
##   1. Bytereader reads sequential values.
##   2. Bytereader u16be reads 2.
##   3. Bytes struct init and.
##   4. Custom index on bytes.
##   5. Custom index set on.
##   6. Push appends bytes.
import * from qspec
import * from bytes
import * from bytes_reader

def main(): Int
  describe("bytes type") do ->
    it("Bytes struct init and size") do ->
      b = make_test_bytes_3()
      assert_eq(b.size(), 3)
    end
    it("custom index on Bytes") do ->
      b = make_test_bytes_3()
      assert_eq(b[0], 72)
      assert_eq(b[1], 101)
      assert_eq(b[2], 108)
    end
    it("custom index set on Bytes") do ->
      var b = make_test_bytes_3()
      b[1] = 42
      assert_eq(b[1], 42)
    end
    it("read_u8 returns single byte") do ->
      b = make_test_bytes_3()
      assert_eq(b.read_u8(0), 72)
      assert_eq(b.read_u8(2), 108)
    end
    it("read_u16be reads big-endian u16") do ->
      b = make_test_bytes_u16()
      assert_eq(b.read_u16be(0), 300)
    end
    it("read_u16le reads little-endian u16") do ->
      b = make_test_bytes_u16()
      assert_eq(b.read_u16le(0), 11265)
    end
    it("read_u32be reads 4 bytes big-endian") do ->
      b = make_test_bytes_u32()
      assert_eq(b.read_u32be(0), 256)
    end
    it("push appends bytes") do ->
      var d = vec_new()
      var b = Bytes { _data: d }
      assert_eq(b.size(), 0)
      b.push(10)
      assert_eq(b.size(), 1)
      b.push(20)
      assert_eq(b.size(), 2)
      assert_eq(b[0], 10)
      assert_eq(b[1], 20)
    end
    it("ByteReader reads sequential values") do ->
      b = make_test_bytes_3()
      assert_eq(br_read_seq(b), 72101)
    end
    it("ByteReader u16be reads 2 bytes and advances") do ->
      b = make_test_bytes_u16()
      assert_eq(br_read_u16(b), 300)
    end
  end
  return qspec_main()
end

def make_test_bytes_3(): Bytes
  var d = vec_new()
  d.push(72)
  d.push(101)
  d.push(108)
  return Bytes { _data: d }
end

def make_test_bytes_u16(): Bytes
  var d = vec_new()
  d.push(1)
  d.push(44)
  return Bytes { _data: d }
end

def br_read_seq(b: Bytes): Int
  var r = ByteReader { _data: b, _pos: 0 }
  a = r.u8()
  c = r.u8()
  return a * 1000 + c
end

def br_read_u16(b: Bytes): Int
  var r = ByteReader { _data: b, _pos: 0 }
  return r.u16be()
end

def make_test_bytes_u32(): Bytes
  var d = vec_new()
  d.push(0)
  d.push(0)
  d.push(1)
  d.push(0)
  return Bytes { _data: d }
end
