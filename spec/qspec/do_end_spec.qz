## Do...End Block Syntax Tests
##
## Contract:
##   1. Basic blocks.
##   2. Multi-statement blocks.
##   3. Closures.
##   4. Nested blocks.
##   5. Typed parameters.
##   6. Explicit nullary arrow syntax.
##   7. Control flow in blocks.
##   8. Block with existing arguments.
import * from qspec

def main(): Int
  describe("basic blocks") do ->
    it("passes block as last argument to function") do ->
      result = de_apply(10) do x ->
        x * 2
      end
      assert_eq(result, 20)
    end

    it("works with nullary blocks") do ->
      result = de_run() do ->
        42
      end
      assert_eq(result, 42)
    end

    it("works with multiple block parameters") do ->
      result = de_apply2(10, 20) do x, y ->
        x + y
      end
      assert_eq(result, 30)
    end
  end

  describe("multi-statement blocks") do ->
    it("supports multiple statements in block body") do ->
      result = de_apply(5) do x ->
        var doubled = x * 2
        var tripled = x * 3
        doubled + tripled
      end
      assert_eq(result, 25)
    end
  end

  describe("closures") do ->
    it("captures variables from outer scope") do ->
      var factor = 7
      result = de_apply(6) do x ->
        x * factor
      end
      assert_eq(result, 42)
    end
  end

  describe("nested blocks") do ->
    it("supports nested do...end blocks") do ->
      result = de_apply(3) do x ->
        de_apply(x) do y ->
          y * y
        end
      end
      assert_eq(result, 9)
    end
  end

  describe("typed parameters") do ->
    it("supports type annotations on block parameters") do ->
      result = de_apply(21) do x: Int ->
        x * 2
      end
      assert_eq(result, 42)
    end

    it("supports multiple typed parameters") do ->
      result = de_apply2(10, 32) do x: Int, y: Int ->
        x + y
      end
      assert_eq(result, 42)
    end
  end

  describe("explicit nullary arrow syntax") do ->
    it("supports do -> for explicit nullary blocks") do ->
      result = de_run() do ->
        21 * 2
      end
      assert_eq(result, 42)
    end
  end

  describe("control flow in blocks") do ->
    it("supports if expressions as return value") do ->
      result = de_apply(5) do x ->
        if x > 3
          return 100
        end
        return 0
      end
      assert_eq(result, 100)
    end
  end

  describe("block with existing arguments") do ->
    it("appends block to function with other args") do ->
      result = de_transform("test", 3) do s, n ->
        str_size(s) + n
      end
      assert_eq(result, 7)
    end
  end

  return qspec_main()
end

def de_apply(x: Int, f: Fn(Int): Int): Int
  return f(x)
end

def de_run(f: Fn(): Int): Int
  return f()
end

def de_apply2(x: Int, y: Int, f: Fn(Int, Int): Int): Int
  return f(x, y)
end

def de_transform(s: String, n: Int, f: Fn(String, Int): Int): Int
  return f(s, n)
end
