## Qualified Call Syntax Tests (::)
##
## Contract:
##   1. Type::method() works for extension methods (rewritten to Type::method call)
##   2. Enum::Variant still works (not rewritten)
##   3. Mixed usage in one program
##   4. Backward compatibility: Type::method() still works
##   5. Pattern matching unaffected by :: rewrite

import * from qspec

extend Int
  def triple(): Int = self * 3
  def double(): Int = self * 2
end

enum QCColor
  Red
  Green
  Blue
end

enum QCShape
  Circle(radius: Int)
  Rect(w: Int, h: Int)
end

def qc_color_to_int(c: QCColor): Int
  match c
    QCColor::Red => 1
    QCColor::Green => 2
    QCColor::Blue => 3
  end
end

def qc_shape_area(s: QCShape): Int
  match s
    QCShape::Circle(r) => r * r
    QCShape::Rect(w, h) => w * h
  end
end

def print_21(): Void = puts("21")
def print_42(): Void = puts("42")

def main(): Int
  describe("qualified call syntax (::)") do ->
    it("calls extension method via Type::method") do ->
      assert_eq(Int::triple(7), 21)
    end

    it("calls multiple extension methods via ::") do ->
      assert_eq(Int::double(5), 10)
      assert_eq(Int::triple(5), 15)
    end

    it("enum construction still works with ::") do ->
      assert_eq(qc_color_to_int(QCColor::Red), 1)
      assert_eq(qc_color_to_int(QCColor::Green), 2)
      assert_eq(qc_color_to_int(QCColor::Blue), 3)
    end

    it("enum with payload still works with ::") do ->
      assert_eq(qc_shape_area(QCShape::Circle(5)), 25)
      assert_eq(qc_shape_area(QCShape::Rect(3, 4)), 12)
    end

    it("Option::Some and Option::None work") do ->
      a = Option::Some(42)
      b = Option::None
      va = match a
        Some(v) => v
        None => 0
      end
      vb = match b
        Some(v) => v
        None => -1
      end
      assert_eq(va, 42)
      assert_eq(vb, -1)
    end

    it("mixes enum :: and type :: in one program") do ->
      assert_eq(Int::triple(7), 21)
      assert_eq(qc_color_to_int(QCColor::Blue), 3)
    end

    it("backward compat: Type::method still works") do ->
      assert_eq(Int::triple(7), 21)
      assert_eq(Int::double(5), 10)
    end

    it("pattern matching with :: unaffected") do ->
      s = QCShape::Circle(6)
      result = match s
        QCShape::Circle(r) => r * r
        QCShape::Rect(w, h) => w * h
      end
      assert_eq(result, 36)
    end

    it(":: call result used in expression") do ->
      assert_eq(Int::triple(3) + Int::double(4), 17)
    end

    it(":: call as function argument") do ->
      assert_eq(Int::triple(Int::double(3)), 18)
    end

    it(":: call in assert_output") do ->
      assert_output("21\n", print_21)
    end
  end

  return qspec_main()
end
