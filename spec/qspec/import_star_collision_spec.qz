## Regression for IMPORT_STAR_COLLISION_SILENT_SHADOW.
##
## When two modules are wildcard-imported and both define a function with the
## same name (`ic_shared` in import_collide_a.qz → 111, import_collide_b.qz →
## 222), the bare→canonical alias map used to be flat first-wins. That silently
## redirected EVERY bare call — including each module's call to its OWN
## `ic_shared` — to whichever module registered first. So `ic_from_b()` (which
## calls `ic_shared` inside module b) returned 111 instead of 222. This is the
## SHA-256 miscompile shape: sha256.qz's internal `_compress` got wired to
## sha512.qz's.
##
## Fix: `mir_resolve_canonical` resolves a bare callee against the CURRENT
## module's own definitions first (module-local precedence), falling back to
## the flat map only for genuine cross-module calls. A genuinely-ambiguous
## consumer-scope call is a HARD ERROR (QZ0405) — compilation fails and the
## user must disambiguate (qualified import / `as` rename). Escalated from a
## warning 2026-07-07 (ESCALATE_QZ0405_TO_ERROR).
##
## Uses subprocess compilation with `-I spec/qspec/fixtures` so the two
## colliding modules resolve.

import * from qspec
import * from qspec/subprocess

def _fixtures_flag(): String = "-I spec/qspec/fixtures"

## Consumer that calls each module's wrapper — exercises module-LOCAL
## resolution. Pre-fix output was "111\n111\n"; correct is "111\n222\n".
def _consumer_local_src(): String = """
import * from import_collide_a
import * from import_collide_b

def main(): Int
  puts(to_str(ic_from_a()))
  puts(to_str(ic_from_b()))
  return 0
end
"""

## Consumer that calls the colliding name DIRECTLY (bare) — genuinely
## ambiguous, must FAIL to compile with QZ0405 (escalated from warning).
def _consumer_ambiguous_src(): String = """
import * from import_collide_a
import * from import_collide_b

def main(): Int
  puts(to_str(ic_shared()))
  return 0
end
"""

def main(): Int
  describe("import-star collision — module-local resolution (Problem 1)") do ->
    it("each module's internal call resolves to its OWN function") do ->
      var r = subprocess_run_with_flags(_consumer_local_src(), _fixtures_flag())
      # Pre-fix: "111\n111\n" (module b's ic_shared call hijacked by module a).
      assert_eq_str(r.stdout_content, "111\n222\n")
    end
  end

  describe("import-star collision — ambiguous consumer call (Problem 2)") do ->
    it("bare ambiguous call errors QZ0405 at compile time") do ->
      var r = subprocess_compile_with_flags(_consumer_ambiguous_src(), _fixtures_flag())
      assert_eq(str_contains(r.stderr_content, "QZ0405"), true)
    end

    it("ambiguous call now FAILS to compile (hard error)") do ->
      var r = subprocess_compile_with_flags(_consumer_ambiguous_src(), _fixtures_flag())
      assert_eq(r.exit_code != 0, true)
    end
  end

  return qspec_main()
end
