def fixture_result_record(cases: Int, passed: Int, case_failures: Int, framework_failures: Int, pending: Int, skipped: Int, assertions: Int, duration_us: Int): String
  var run_id = getenv("QSPEC_RESULT_RUN_ID")
  var file_id = getenv("QSPEC_RESULT_FILE_ID")
  var token = getenv("QSPEC_RESULT_TOKEN")
  return "QSPEC_RESULT_V3 {\"schema\":3,\"authority\":\"test_reported\",\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"#{token}\",\"cases\":#{cases},\"passed\":#{passed},\"case_failures\":#{case_failures},\"framework_failures\":#{framework_failures},\"pending\":#{pending},\"skipped\":#{skipped},\"assertions\":#{assertions},\"duration_us\":#{duration_us}}\n"
end

def append_fixture_result(record: String): Void
  file.file_append(getenv("QSPEC_RESULT_PATH"), record)
end
import io/file
