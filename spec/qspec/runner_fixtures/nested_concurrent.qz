import * from qspec

var _nested_concurrent_ok = atomic_new(0)

def _nested_concurrent_call(): Int
  var argv = vec_new<String>(); argv.push("/usr/bin/true")
  var result = subprocess_exec_argv("nested-concurrent", argv)
  if result.exit_code == 0 and result.outcome == "exit" and result.signal == 0 and result.timed_out == false
    atomic_add(_nested_concurrent_ok, 1)
  end
  return 0
end

def main(): Int
  var a = go _nested_concurrent_call()
  var b = go _nested_concurrent_call()
  var c = go _nested_concurrent_call()
  var d = go _nested_concurrent_call()
  var e = go _nested_concurrent_call()
  var f = go _nested_concurrent_call()
  var g = go _nested_concurrent_call()
  var h = go _nested_concurrent_call()
  await a
  await b
  await c
  await d
  await e
  await f
  await g
  await h

  describe("concurrent nested subprocess calls") do ->
    it("publishes every distinct result") do ->
      assert_eq(atomic_load(_nested_concurrent_ok), 8)
    end
  end
  return qspec_main()
end
