import io/file

def main(): Int
  var run_id = getenv("QSPEC_RESULT_RUN_ID")
  var file_id = getenv("QSPEC_RESULT_FILE_ID")
  var record = "QSPEC_RESULT_V3 {\"schema\":3,\"authority\":\"test_reported\",\"run_id\":\"#{run_id}\",\"file_id\":\"#{file_id}\",\"token\":\"spoofed\",\"cases\":1,\"passed\":1,\"case_failures\":0,\"framework_failures\":0,\"pending\":0,\"skipped\":0,\"assertions\":1,\"duration_us\":1}\n"
  file.file_append(getenv("QSPEC_RESULT_PATH"), record)
  return 0
end
