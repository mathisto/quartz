import * from qspec

def main(): Int
  describe("SubResult source compatibility") do ->
    it("allows the original three-field direct constructor") do ->
      var result = SubResult { exit_code: 7, stdout_content: "out", stderr_content: "err" }
      assert_eq(result.exit_code, 7)
      assert_eq_str(result.outcome, "exit")
      assert_eq(result.signal, 0)
      assert_eq(result.timed_out, false)
      assert_eq_str(result.supervision, "")
    end
  end
  return qspec_main()
end
