import * from qspec

def main(): Int
  describe("nested subprocess supervision") do ->
    it("runs a nested compile, llc, link, and executable") do ->
      var result = subprocess_run("def main(): Int\n  return 0\nend\n")
      assert_eq(result.exit_code, 0)
      assert_eq(str_contains(result.supervision, "QSS2\tnested-compile\t"), 1)
      assert_eq(str_contains(result.supervision, "QSS2\tnested-llc\t"), 1)
      assert_eq(str_contains(result.supervision, "QSS2\tnested-link\t"), 1)
      assert_eq(str_contains(result.supervision, "QSS2\tnested-run\t"), 1)
    end
    it("preserves argv stage evidence and command failures") do ->
      var pass_argv = vec_new<String>(); pass_argv.push("/usr/bin/true")
      var pass_result = subprocess_exec_argv("nested-validate", pass_argv)
      assert_eq(pass_result.exit_code, 0)
      assert_eq(str_contains(pass_result.supervision, "QSS2\tnested-validate\t"), 1)

      var fail_argv = vec_new<String>(); fail_argv.push("/usr/bin/false")
      var fail_result = subprocess_exec_argv("nested-validate", fail_argv)
      assert_ne(fail_result.exit_code, 0)
      assert_eq(str_contains(fail_result.supervision, "QSS2\tnested-validate\t"), 1)
    end
    it("rejects traversal, absolute, and metacharacter paths") do ->
      var traversal = vec_new()
      traversal.push("../escape.qz")
      traversal.push("def main(): Int\n  return 0\nend\n")
      assert_eq(-1, subprocess_compile_multi(traversal, 0).exit_code)

      var absolute = vec_new()
      absolute.push("/tmp/escape.qz")
      absolute.push("def main(): Int\n  return 0\nend\n")
      assert_eq(-1, subprocess_compile_multi(absolute, 0).exit_code)

      var injected = vec_new()
      injected.push("evil;touch.qz")
      injected.push("def main(): Int\n  return 0\nend\n")
      assert_eq(-1, subprocess_compile_multi(injected, 0).exit_code)
    end
    it("preserves structured outcome identity") do ->
      var expected = getenv("QSPEC_SUB_EXPECT_OUTCOME")
      if str_byte_len(expected) > 0
        var argv = vec_new<String>(); argv.push("/usr/bin/true")
        var result = subprocess_exec_argv("nested-outcome", argv)
        assert_eq_str(result.outcome, expected)
        if expected == "exit"
          assert_eq(result.exit_code, 124)
          assert_eq(result.signal, 0)
          assert_eq(result.timed_out, false)
        elsif expected == "signal"
          assert_eq(result.signal, 2)
          assert_eq(result.timed_out, false)
        elsif expected == "timeout"
          assert_eq(result.timed_out, true)
          assert_eq(result.signal, 0)
        elsif expected == "orphan"
          assert_eq(result.orphan, true)
        elsif expected == "cancelled"
          assert_eq(result.cancelled, true)
        elsif expected == "spawn_failure"
          assert_eq(str_byte_len(result.spawn_error) > 0, true)
        end
      else
        assert_eq(1, 1)
      end
    end
    it("can ignore a nested result without hiding gate evidence") do ->
      if getenv("QSPEC_SUB_IGNORE_RESULT") == "1"
        var argv = vec_new<String>(); argv.push("/usr/bin/true")
        var _ignored = subprocess_exec_argv("nested-ignored", argv)
      end
      assert_eq(1, 1)
    end
    it("retains more than 64 issued stages") do ->
      if getenv("QSPEC_SUB_BULK") == "1"
        var i = 0
        while i < 70
          var argv = vec_new<String>(); argv.push("/usr/bin/true")
          var result = subprocess_exec_argv("nested-bulk", argv)
          assert_eq(result.exit_code, 0)
          i += 1
        end
      else
        assert_eq(1, 1)
      end
    end
    it("enforces the nested stage publication budget") do ->
      if getenv("QSPEC_SUB_CAP") == "1"
        var i = 0
        while i < 4100
          var argv = vec_new<String>(); argv.push("/usr/bin/true")
          var _result = subprocess_exec_argv("nested-cap", argv)
          i += 1
        end
      else
        assert_eq(1, 1)
      end
    end
  end
  return qspec_main()
end
