import * from qspec

def main(): Int
  describe("runner recovery fixture") do ->
    it("fails once then passes") do ->
      var marker = getenv("QSPEC_RECOVERY_MARKER")
      if file_exists(marker) == 0
        write_file(marker, "initial failure\n")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end
  end
  return qspec_main()
end
