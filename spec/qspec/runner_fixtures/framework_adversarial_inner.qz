import * from qspec
import std/throws

var adversarial_trace = ""
var caught_skip_continued = 0
var adversarial_body_count = 0
var dynamic_callback_count = 0

def swallow_throw(op_name: Int, argc_l: Int, argv_l: Int): Int = 0
def raw_sentinel_body(): Void
  adversarial_body_count += 1
  throw("__qspec_skip__")
end
def caught_skip_body(): Void
  adversarial_body_count += 1
  with Throws { throw: swallow_throw } do ->
    skip("caught by a public Throws handler")
    0
  end
  caught_skip_continued = 1
end
def cleanup_body(): Void
  adversarial_body_count += 1
  adversarial_trace += "C"
end
def dynamic_callback(): Void
  dynamic_callback_count += 1
end
def nested_declaration_body(): Void
  adversarial_body_count += 1
  adversarial_trace += "D"
  it("dynamic it", dynamic_callback)
  fit("dynamic fit", dynamic_callback)
  it_pending("dynamic pending")
  xit("dynamic xit", dynamic_callback)
  describe("dynamic describe", dynamic_callback)
  context("dynamic context", dynamic_callback)
  test("dynamic flat test", dynamic_callback)
  before(dynamic_callback)
  after(dynamic_callback)
end
def outer_cleanup(): Void
  adversarial_trace += "O"
end
def inner_cleanup_last(): Void
  adversarial_trace += "L"
end
def inner_cleanup_one(): Void
  adversarial_trace += "X"
  throw("cleanup one")
end
def inner_cleanup_two(): Void
  adversarial_trace += "Y"
  throw("cleanup two")
end
def register_cleanup_case(): Void
  after(inner_cleanup_last)
  after(inner_cleanup_one)
  after(inner_cleanup_two)
  it("continues cleanup after throwing hooks", cleanup_body)
end
def register_adversarial_cases(): Void
  after(outer_cleanup)
  it("does not accept a forged skip sentinel", raw_sentinel_body)
  it("fails when public Throws intercepts skip", caught_skip_body)
  describe("isolated cleanup", register_cleanup_case)
  it("rejects declarations during execution", nested_declaration_body)
end

def main(): Int
  describe("QSpec adversarial semantics", register_adversarial_cases)
  var failures = qspec_run()
  if failures != 4 or qspec_total() != 4 or qspec_failed() != 4 or caught_skip_continued != 1
    return 80
  end
  if adversarial_trace != "OOCYXLODO" or matcher_failure_count() != 9
    return 81
  end
  var roots = qspec_root_suites()
  var root_entries = qspec_suite_entries(vec_get(roots, 0))
  var cleanup_suite = vec_get(root_entries, 2)
  var cleanup_entries = qspec_suite_entries(cleanup_suite)
  if qspec_test_failure_count(vec_get(cleanup_entries, 0)) != 2
    return 82
  end
  var dynamic_test = vec_get(root_entries, 3)
  if qspec_test_failure_count(dynamic_test) != 9
    return 83
  end
  var declaration_failure = qspec_test_failure_struct_at(dynamic_test, 0)
  if not str_contains(declaration_failure.message, "unsupported after qspec_run has started")
    return 84
  end
  if adversarial_body_count != 4 or dynamic_callback_count != 0
    return 85
  end
  if qspec_run() != 4 or adversarial_body_count != 4 or adversarial_trace != "OOCYXLODO"
    return 86
  end
  return 0
end
