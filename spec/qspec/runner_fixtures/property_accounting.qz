import * from qspec
import * from qspec/property

def pass_i(x: Int): Void = assert_eq(x, x)
def pass_ii(x: Int, y: Int): Void = assert_eq(x + y, x + y)
def fail_i(x: Int): Void = assert_eq(x, x + 1)
def fail_ii(x: Int, y: Int): Void = assert_eq(x + y, x + y + 1)
def prior_failure(): Void = assert_eq(1, 2)

def main(): Int
  describe("passing property accounting") do ->
    forall_i("counts forall_i once", pass_i)
    forall_ii("counts forall_ii once", pass_ii)
  end
  describe("failing property accounting") do ->
    forall_i("reports matcher failure for forall_i", fail_i)
    forall_ii("reports matcher failure for forall_ii", fail_ii)
  end
  describe("pre-existing matcher failures") do ->
    before(prior_failure)
    forall_i("preserves failure before forall_i", pass_i)
    forall_ii("preserves failure before forall_ii", pass_ii)
  end

  var failures = qspec_run()
  if failures != 4 or qspec_total() != 6 or qspec_passed() != 2 or qspec_case_failed() != 4 or qspec_assertions() != 8
    return 70
  end

  var roots = qspec_root_suites()
  var failing_tests = qspec_suite_tests(vec_get(roots, 1))
  var prior_tests = qspec_suite_tests(vec_get(roots, 2))
  var failing_i = vec_get(failing_tests, 0)
  var failing_ii = vec_get(failing_tests, 1)
  var prior_i = vec_get(prior_tests, 0)
  var prior_ii = vec_get(prior_tests, 1)
  var failing_i_record = qspec_test_failure_struct_at(failing_i, 0)
  var failing_ii_record = qspec_test_failure_struct_at(failing_ii, 0)
  var prior_i_record = qspec_test_failure_struct_at(prior_i, 0)
  var prior_ii_record = qspec_test_failure_struct_at(prior_ii, 0)
  if qspec_test_status(failing_i) != 2 or qspec_test_failure_count(failing_i) != 1 or not str_contains(failing_i_record.message, "Property failed")
    return 71
  end
  if qspec_test_status(failing_ii) != 2 or qspec_test_failure_count(failing_ii) != 1 or not str_contains(failing_ii_record.message, "Property failed")
    return 72
  end
  if qspec_test_status(prior_i) != 2 or qspec_test_failure_count(prior_i) != 1 or prior_i_record.matcher != "assert_eq"
    return 73
  end
  if qspec_test_status(prior_ii) != 2 or qspec_test_failure_count(prior_ii) != 1 or prior_ii_record.matcher != "assert_eq"
    return 74
  end
  return 0
end
