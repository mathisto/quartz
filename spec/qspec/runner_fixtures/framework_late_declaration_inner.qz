import * from qspec

var late_body_count = 0
var late_callback_count = 0

def ordinary_body(): Void
  late_body_count += 1
end
def late_callback(): Void
  late_callback_count += 1
end
def register_ordinary_case(): Void = it("runs an ordinary declaration", ordinary_body)

def main(): Int
  describe("QSpec late declarations", register_ordinary_case)
  if qspec_run() != 0 or late_body_count != 1
    return 80
  end
  it("late test", late_callback)
  after(late_callback)
  if qspec_framework_failure_count() != 2
    return 81
  end
  if not str_contains(qspec_framework_failure_message(0), "QSpec it declaration is unsupported")
    return 82
  end
  if not str_contains(qspec_framework_failure_message(1), "QSpec after declaration is unsupported")
    return 83
  end
  if qspec_run() != 1 or qspec_failed() != 1
    return 84
  end
  if qspec_main() != 1 or qspec_main() != 1
    return 85
  end
  if late_body_count != 1 or late_callback_count != 0 or qspec_total() != 1
    return 86
  end
  return 0
end
