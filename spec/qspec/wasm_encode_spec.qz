import * from qspec
import wasm_encode

def main(): Int
  describe("wasm_encode") do ->
    it("emits 8-byte header") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_header(buf)
      assert_eq(buf.size, 8)
    end

    it("LEB128 u32: 0 is 1 byte") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_u32(buf, 0)
      assert_eq(buf.size, 1)
      assert_eq(buf[0], 0)
    end

    it("LEB128 u32: 127 is 1 byte") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_u32(buf, 127)
      assert_eq(buf.size, 1)
      assert_eq(buf[0], 127)
    end

    it("LEB128 u32: 128 is 2 bytes") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_u32(buf, 128)
      assert_eq(buf.size, 2)
      assert_eq(buf[0], 128)
      assert_eq(buf[1], 1)
    end

    it("LEB128 u32: 624485 is 3 bytes") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_u32(buf, 624485)
      assert_eq(buf.size, 3)
      assert_eq(buf[0], 229)
      assert_eq(buf[1], 142)
      assert_eq(buf[2], 38)
    end

    it("LEB128 i64: 0 is 1 byte") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_i64(buf, 0)
      assert_eq(buf.size, 1)
      assert_eq(buf[0], 0)
    end

    it("LEB128 i64: -1 is 1 byte 0x7F") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_i64(buf, -1)
      assert_eq(buf.size, 1)
      assert_eq(buf[0], 127)
    end

    it("LEB128 i64: 42 is 1 byte") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_i64(buf, 42)
      assert_eq(buf.size, 1)
      assert_eq(buf[0], 42)
    end

    it("LEB128 i64: -128 is 2 bytes") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_i64(buf, -128)
      assert_eq(buf.size, 2)
      assert_eq(buf[0], 128)
      assert_eq(buf[1], 127)
    end

    it("section wraps content with id and size") do ->
      var content = vec_new<Int>()
      content.push(42)
      content.push(43)
      var out = vec_new<Int>()
      wasm_encode::wasm_emit_section(out, wasm_encode::WASM_SECTION_TYPE, content)
      assert_eq(out.size, 4)
      assert_eq(out[0], 1)
      assert_eq(out[1], 2)
      assert_eq(out[2], 42)
      assert_eq(out[3], 43)
    end

    it("name encoding: length + bytes") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_name(buf, "env")
      assert_eq(buf.size, 4)
      assert_eq(buf[0], 3)
      assert_eq(buf[1], 101)
      assert_eq(buf[2], 110)
      assert_eq(buf[3], 118)
    end

    it("func_type: (i64,i64)->i64") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_func_type(buf, 2, 1)
      assert_eq(buf.size, 6)
      assert_eq(buf[0], 96)
      assert_eq(buf[1], 2)
      assert_eq(buf[2], 126)
      assert_eq(buf[3], 126)
      assert_eq(buf[4], 1)
      assert_eq(buf[5], 126)
    end

    it("func_type: ()->void") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_func_type(buf, 0, 0)
      assert_eq(buf.size, 3)
      assert_eq(buf[0], 96)
      assert_eq(buf[1], 0)
      assert_eq(buf[2], 0)
    end
  end

  describe("wasm module") do ->
    it("emits valid WASM header") do ->
      var buf = vec_new<Int>()
      wasm_encode::wasm_emit_header(buf)
      # \0asm version 1
      assert_eq(buf[0], 0)
      assert_eq(buf[1], 97)   # 'a'
      assert_eq(buf[2], 115)  # 's'
      assert_eq(buf[3], 109)  # 'm'
      assert_eq(buf[4], 1)    # version
      assert_eq(buf[5], 0)
      assert_eq(buf[6], 0)
      assert_eq(buf[7], 0)
    end

    it("opcode constants are correct") do ->
      assert_eq(wasm_encode::WASM_I64_CONST, 66)
      assert_eq(wasm_encode::WASM_I64_ADD, 124)
      assert_eq(wasm_encode::WASM_CALL, 16)
      assert_eq(wasm_encode::WASM_LOCAL_GET, 32)
      assert_eq(wasm_encode::WASM_LOCAL_SET, 33)
      assert_eq(wasm_encode::WASM_END, 11)
      assert_eq(wasm_encode::WASM_RETURN, 15)
      assert_eq(wasm_encode::WASM_I32_WRAP_I64, 167)
    end
  end

  return qspec_main()
end
