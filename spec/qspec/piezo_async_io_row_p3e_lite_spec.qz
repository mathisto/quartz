## Piezo P3.E — Async row widening for scheduler intrinsics.
##
## Calls to `io_suspend`, `io_suspend_timeout`, `sched_yield`,
## `sched_sleep`, and `proc_suspend` widen the caller's effect row with
## `Async`. Regression coverage: programs using these intrinsics
## compile and run cleanly, explicit `can Async` is idempotent, and
## the blessed-effect relaxation lets non-Async `can` rows tolerate
## the widening.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("P3.E — Async row widening for scheduler intrinsics") do ->
    it("sched_yield in a loop runs to completion") do ->
      var src = """
def counter(): Int
  var i = 0
  while i < 3
    i += 1
    sched_yield()
  end
  return i
end

def main(): Int
  sched_init(1)
  var h = async counter()
  sched_spawn(h)
  sched_shutdown()
  puts("r=" + load(h, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=3\n")
    end

    it("explicit `can Async` annotation is idempotent") do ->
      var src = """
def worker(): Int can Async
  sched_yield()
  return 42
end

def main(): Int
  sched_init(1)
  var h = async worker()
  sched_spawn(h)
  sched_shutdown()
  puts("r=" + load(h, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=42\n")
    end

    it("caller with non-Async `can` row (Throws) tolerates sched_yield") do ->
      var src = """
def worker(): Int can Throws
  sched_yield()
  return 7
end

def main(): Int
  sched_init(1)
  var h = async worker()
  sched_spawn(h)
  sched_shutdown()
  puts("r=" + load(h, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=7\n")
    end

    it("io_suspend-backed channel recv works end-to-end") do ->
      var src = """
def producer(ch: Int): Int
  send(ch, 11)
  send(ch, 22)
  return 0
end

def main(): Int
  sched_init(1)
  var ch = channel_new(1)
  var h = async producer(ch)
  sched_spawn(h)
  var a = recv(ch)
  var b = recv(ch)
  sched_shutdown()
  puts("a=" + a.to_s() + " b=" + b.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "a=11 b=22\n")
    end
  end
  return qspec_main()
end
