## Labeled Loops Tests
##
## Contract:
##   1. Labeled while: `break :label` exits named outer loop.
##   2. Labeled while: `continue :label` restarts named outer loop.
##   3. Unlabeled in labeled: inner `break` only breaks inner loop.
##   4. Labeled for: break/continue outer for loop.
##   5. Deeply nested: break to middle or outermost loop.
##   6. Mixed types: for-in inside labeled while and vice versa.
##   7. Error: undefined label, non-enclosing label, duplicate label.
##   8. Scoping: same label in different functions, label reuse after loop.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("labeled while loops") do ->
    it("breaks outer loop with label") do ->
      assert_eq(ll_break_outer_while(), 12)
    end

    it("continues outer loop with label") do ->
      assert_eq(ll_continue_outer_while(), 9)
    end

    it("unlabeled break still works in labeled loop") do ->
      assert_eq(ll_unlabeled_break(), 5)
    end
  end

  describe("labeled for loops") do ->
    it("breaks outer for loop with label") do ->
      assert_eq(ll_break_outer_for(), 4)
    end

    it("continues outer for loop with label") do ->
      assert_eq(ll_continue_outer_for(), 6)
    end
  end

  describe("deeply nested loops") do ->
    it("breaks to middle loop") do ->
      assert_eq(ll_break_middle(), 4)
    end

    it("breaks outermost from triple nest") do ->
      assert_eq(ll_break_outermost(), 13)
    end
  end

  describe("mixed loop types") do ->
    it("breaks from for to labeled while") do ->
      assert_eq(ll_break_for_to_while(), 7)
    end

    it("continues from while to labeled for") do ->
      assert_eq(ll_continue_while_to_for(), 8)
    end
  end

  describe("error cases") do ->
    it("errors on undefined label") do ->
      assert_compile_error("""
        def main(): Int
          var i = 0
          while i < 5
            break :nonexistent
            i += 1
          end
          return 0
        end
        """, "Undefined loop label")
    end

    it("errors when label references non-enclosing loop") do ->
      assert_compile_error("""
        def foo(): Void
          :outer while true
            break :outer
          end
        end
        def main(): Int
          var i = 0
          while i < 5
            break :outer
            i += 1
          end
          return 0
        end
        """, "Undefined loop label")
    end

    it("errors on duplicate labels in same scope") do ->
      assert_compile_error("""
        def main(): Int
          var i = 0
          :dup while i < 5
            var j = 0
            :dup while j < 5
              j += 1
            end
            i += 1
          end
          return 0
        end
        """, "Duplicate loop label")
    end
  end

  describe("label scoping") do ->
    it("allows same label in different functions") do ->
      assert_eq(ll_foo() + ll_bar(), 10)
    end

    it("allows reusing label after loop ends") do ->
      assert_eq(ll_reuse_label(), 11)
    end
  end

  return qspec_main()
end

def ll_break_outer_while(): Int
  var total = 0
  var i = 0
  :outer while i < 5
    var j = 0
    while j < 5
      if i == 2 and j == 2
        break :outer
      end
      total += 1
      j += 1
    end
    i = i + 1
  end
  return total
end

def ll_continue_outer_while(): Int
  var total = 0
  var i = 0
  :outer while i < 4
    i = i + 1
    var j = 0
    while j < 3
      j += 1
      if i == 2
        continue :outer
      end
      total += 1
    end
  end
  return total
end

def ll_unlabeled_break(): Int
  var count = 0
  :outer while true
    count += 1
    if count == 5
      break
    end
  end
  return count
end

def ll_break_outer_for(): Int
  var total = 0
  arr1 = [1, 2, 3]
  arr2 = [10, 20, 30]
  :outer for x in arr1
    for y in arr2
      if x == 2 and y == 20
        break :outer
      end
      total += 1
    end
  end
  return total
end

def ll_continue_outer_for(): Int
  var total = 0
  arr1 = [1, 2, 3]
  arr2 = [10, 20, 30]
  :outer for x in arr1
    for y in arr2
      if y == 20
        continue :outer
      end
      total += x
    end
  end
  return total
end

def ll_break_middle(): Int
  var total = 0
  var a = 0
  while a < 2
    var b = 0
    :middle while b < 3
      var c = 0
      while c < 4
        if c == 2
          break :middle
        end
        total += 1
        c = c + 1
      end
      b = b + 1
    end
    a = a + 1
  end
  return total
end

def ll_break_outermost(): Int
  var total = 0
  :outer for a in [1, 2, 3]
    for b in [1, 2, 3]
      for c in [1, 2, 3]
        if a == 2 and b == 2 and c == 2
          break :outer
        end
        total += 1
      end
    end
  end
  return total
end

def ll_break_for_to_while(): Int
  var total = 0
  var i = 0
  :outer while i < 3
    for x in [1, 2, 3, 4, 5]
      if i == 1 and x == 3
        break :outer
      end
      total += 1
    end
    i = i + 1
  end
  return total
end

def ll_continue_while_to_for(): Int
  var total = 0
  :outer for x in [1, 2, 3]
    var i = 0
    while i < 4
      i = i + 1
      if x == 2
        continue :outer
      end
      total += 1
    end
  end
  return total
end

def ll_foo(): Int
  var total = 0
  :loop while total < 5
    total += 1
    if total == 3
      break :loop
    end
  end
  return total
end

def ll_bar(): Int
  var total = 0
  :loop while total < 10
    total += 1
    if total == 7
      break :loop
    end
  end
  return total
end

def ll_reuse_label(): Int
  var total = 0

  :loop for x in [1, 2, 3]
    if x == 2
      break :loop
    end
    total += x
  end

  :loop for x in [10, 20, 30]
    if x == 20
      break :loop
    end
    total += x
  end

  return total
end
