## Struct Destructure Tests
##
## Contract:
##   1. Struct destructuring.
##   2. Vec destructuring.
##   3. Destructuring in for-in.
import * from qspec

@value
struct Point
  x: Int
  y: Int
end

@value
struct Point3D
  x: Int
  y: Int
  z: Int
end

@value
struct Line
  x1: Int
  y1: Int
  x2: Int
  y2: Int
end

# -- Helpers --

def make_point(x: Int, y: Int): Point = Point { x: x, y: y }
def make_point3d(x: Int, y: Int, z: Int): Point3D = Point3D { x: x, y: y, z: z }

def print_sum_xy(): Void
  Point { x, y } = make_point(10, 20)
  puts(str_from_int(x + y))
end

def print_mutable_destr(): Void
  var Point { x, y } = make_point(3, 4)
  x = x * 10
  puts(str_from_int(x + y))
end

def print_inferred_destr(): Void
  var { x, y } = make_point(5, 6)
  puts(str_from_int(x + y))
end

def print_rename_destr(): Void
  Point { x: px, y: py } = make_point(7, 8)
  puts(str_from_int(px + py))
end

def print_partial_destr(): Void
  Point3D { x, .. } = make_point3d(42, 99, 1)
  puts(str_from_int(x))
end

def print_match_struct(): Void
  var p = make_point(100, 200)
  var result = match p
    Point { x, y } => x + y
  end
  puts(str_from_int(result))
end

def print_match_inferred(): Void
  var p = make_point(11, 22)
  var result = match p
    { x, y } => x + y
  end
  puts(str_from_int(result))
end

def print_vec_destr(): Void
  var v = vec_new()
  v.push(10)
  v.push(20)
  v.push(30)
  [a, b, c] = v
  puts(str_from_int(a + b + c))
end

def print_vec_rest(): Void
  var v = vec_new()
  v.push(1)
  v.push(2)
  v.push(3)
  v.push(4)
  [head, ..tail] = v
  puts(str_from_int(head))
  puts(str_from_int(tail.size))
end

def print_vec_head_only(): Void
  var v = vec_new()
  v.push(99)
  v.push(0)
  [first, ..] = v
  puts(str_from_int(first))
end

def print_for_struct(): Void
  var points = vec_new()
  points.push(make_point(1, 2))
  points.push(make_point(3, 4))
  var total = 0
  for Point { x, y } in points
    total = total + x + y
  end
  puts(str_from_int(total))
end

def print_mutable_vec(): Void
  var v = vec_new()
  v.push(5)
  v.push(10)
  var [a, b] = v
  a = a * 100
  puts(str_from_int(a + b))
end

# -- Tests --

def main(): Int
  describe("struct destructuring") do ->
    it("basic struct destructuring") do ->
      assert_output("30\n", print_sum_xy)
    end
    it("mutable struct destructuring") do ->
      assert_output("34\n", print_mutable_destr)
    end
    it("inferred type struct destructuring") do ->
      assert_output("11\n", print_inferred_destr)
    end
    it("field renaming") do ->
      assert_output("15\n", print_rename_destr)
    end
    it("partial destructuring with ..") do ->
      assert_output("42\n", print_partial_destr)
    end
    it("struct pattern in match") do ->
      assert_output("300\n", print_match_struct)
    end
    it("inferred struct pattern in match") do ->
      assert_output("33\n", print_match_inferred)
    end
  end

  describe("vec destructuring") do ->
    it("basic vec destructuring") do ->
      assert_output("60\n", print_vec_destr)
    end
    it("vec with ..rest binding") do ->
      assert_output("1\n3\n", print_vec_rest)
    end
    it("vec head only with ..") do ->
      assert_output("99\n", print_vec_head_only)
    end
    it("mutable vec destructuring") do ->
      assert_output("510\n", print_mutable_vec)
    end
  end

  describe("destructuring in for-in") do ->
    it("struct destructuring in for-in") do ->
      assert_output("10\n", print_for_struct)
    end
  end

  return qspec_main()
end
