## Enum Discriminant Sizing Tests
##
## Contract:
##   1. Narrow storage: simple enums (no payload) stored as i8 in Vec.
##   2. Push/get roundtrip: values survive narrow storage.
##   3. Set: mutation works with narrow storage.
##   4. Match after get: narrowed value dispatchable in match.
##   5. Growth: values survive Vec reallocation.
##   6. new_filled: bulk initialization with narrow storage.
##   7. Payload enum: not narrowed (retains full layout).
import * from qspec

## Simple enum with 3 variants (fits in 1 byte)
enum Color
  Red
  Green
  Blue
end

## Simple enum with 5 variants (still fits in 1 byte)
enum Direction
  North
  South
  East
  West
  Center
end

## Payload enum — should NOT use narrow storage
enum Shape
  Circle(radius: Int)
  Square(side: Int)
end

# -- Test helpers --

def test_vec_color_push_get(): Void
  var v = vec_new<Color>()
  v.push(Color::Red)
  v.push(Color::Green)
  v.push(Color::Blue)
  assert_eq(v[0], Color::Red)
  assert_eq(v[1], Color::Green)
  assert_eq(v[2], Color::Blue)
  assert_eq(v.size, 3)
end

def test_vec_color_set(): Void
  var v = vec_new<Color>()
  v.push(Color::Red)
  v.push(Color::Green)
  v.push(Color::Blue)
  v.set(1, Color::Blue)
  assert_eq(v[0], Color::Red)
  assert_eq(v[1], Color::Blue)
  assert_eq(v[2], Color::Blue)
end

def test_vec_color_roundtrip(): Void
  var v = vec_new<Color>()
  for i in 0..20
    if i % 3 == 0
      v.push(Color::Red)
    elsif i % 3 == 1
      v.push(Color::Green)
    else
      v.push(Color::Blue)
    end
  end
  assert_eq(v.size, 20)
  assert_eq(v[0], Color::Red)
  assert_eq(v[1], Color::Green)
  assert_eq(v[2], Color::Blue)
  assert_eq(v[3], Color::Red)
  assert_eq(v[19], Color::Green)
end

def test_vec_direction(): Void
  var v = vec_new<Direction>()
  v.push(Direction::North)
  v.push(Direction::South)
  v.push(Direction::East)
  v.push(Direction::West)
  v.push(Direction::Center)
  assert_eq(v[0], Direction::North)
  assert_eq(v[1], Direction::South)
  assert_eq(v[2], Direction::East)
  assert_eq(v[3], Direction::West)
  assert_eq(v[4], Direction::Center)
end

def test_vec_color_match(): Void
  var v = vec_new<Color>()
  v.push(Color::Red)
  v.push(Color::Green)
  v.push(Color::Blue)
  var count = 0
  for i in 0..3
    var c = v[i]
    match c
      Color::Red => count += 1
      Color::Green => count += 10
      Color::Blue => count += 100
    end
  end
  assert_eq(count, 111)
end

def test_vec_color_growth(): Void
  var v = vec_new<Color>()
  # Push enough to trigger reallocation (initial cap=8)
  for i in 0..50
    v.push(Color::Green)
  end
  assert_eq(v.size, 50)
  # Verify all elements survived reallocation
  for i in 0..50
    assert_eq(v[i], Color::Green)
  end
end

def test_vec_color_new_filled(): Void
  var v = vec_new_filled<Color>(10, Color::Red)
  assert_eq(v.size, 10)
  for i in 0..10
    assert_eq(v[i], Color::Red)
  end
end

def test_vec_payload_enum_unaffected(): Void
  # Payload enums should still work (not narrowed)
  var v = vec_new<Shape>()
  v.push(Shape::Circle(5))
  v.push(Shape::Square(10))
  # Just verify size — payload enum layout is separate concern
  assert_eq(v.size, 2)
end

def main(): Int
  describe("enum discriminant sizing") do ->
    it("Vec<Color> push and get") do ->
      test_vec_color_push_get()
    end

    it("Vec<Color> set") do ->
      test_vec_color_set()
    end

    it("Vec<Color> roundtrip with 20 elements") do ->
      test_vec_color_roundtrip()
    end

    it("Vec<Direction> with 5 variants") do ->
      test_vec_direction()
    end

    it("Vec<Color> match after narrow get") do ->
      test_vec_color_match()
    end

    it("Vec<Color> growth past initial capacity") do ->
      test_vec_color_growth()
    end

    it("Vec<Color> new_filled") do ->
      test_vec_color_new_filled()
    end

    it("payload enum not narrowed") do ->
      test_vec_payload_enum_unaffected()
    end
  end

  return qspec_main()
end
