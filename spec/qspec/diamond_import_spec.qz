## Diamond Import Tests - Verifies diamond dependency pattern works correctly
##
## Contract:
##   1. Basic diamond: A→B→D + A→C→D both work.
##   2. Wildcard: diamond with `import * from` works.
##   3. Three-level: root → mid1/mid2 → top → main resolves.
##   4. Mixed import: qualified + wildcard imports in diamond.
##   5. Data passing: diamond with functions returning values.
##   6. Diamond global: shared global var accessed through diamond.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("diamond import pattern") do ->
    it("A->B->D + A->C->D both work") do ->
      var files: Vec = vec_new()
      files.push(as_int("shared.qz"))
      files.push(as_int("def shared_fn(): Int = 5"))
      files.push(as_int("left.qz"))
      vec_push(files, as_int("import shared\ndef left_fn(): Int\n  return shared::shared_fn() + 1\nend"))
      files.push(as_int("right.qz"))
      vec_push(files, as_int("import shared\ndef right_fn(): Int\n  return shared::shared_fn() + 2\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import left\nimport right\ndef main(): Int\n  return left::left_fn() + right::right_fn()\nend"))
      assert_multi_run_exits(files, 3, 13)
    end

    it("diamond with wildcard imports") do ->
      var files: Vec = vec_new()
      files.push(as_int("core.qz"))
      files.push(as_int("def core_val(): Int = 10"))
      files.push(as_int("branch1.qz"))
      vec_push(files, as_int("import * from core\ndef b1(): Int\n  return core_val() + 1\nend"))
      files.push(as_int("branch2.qz"))
      vec_push(files, as_int("import * from core\ndef b2(): Int\n  return core_val() + 2\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import branch1\nimport branch2\ndef main(): Int\n  return branch1::b1() + branch2::b2()\nend"))
      assert_multi_run_exits(files, 3, 23)
    end

    it("three-level diamond") do ->
      var files: Vec = vec_new()
      files.push(as_int("root.qz"))
      files.push(as_int("def root_val(): Int = 1"))
      files.push(as_int("mid1.qz"))
      vec_push(files, as_int("import root\ndef m1(): Int\n  return root::root_val()\nend"))
      files.push(as_int("mid2.qz"))
      vec_push(files, as_int("import root\ndef m2(): Int\n  return root::root_val()\nend"))
      files.push(as_int("top.qz"))
      vec_push(files, as_int("import mid1\nimport mid2\ndef top_fn(): Int\n  return mid1::m1() + mid2::m2()\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import top\ndef main(): Int\n  return top::top_fn()\nend"))
      assert_multi_run_exits(files, 4, 2)
    end

    it("diamond with mixed import forms") do ->
      var files: Vec = vec_new()
      files.push(as_int("base.qz"))
      files.push(as_int("def base_val(): Int = 8"))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("import base\ndef q_fn(): Int\n  return base::base_val()\nend"))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("import * from base\ndef w_fn(): Int\n  return base_val()\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import qual\nimport wild\ndef main(): Int\n  return qual::q_fn() + wild::w_fn()\nend"))
      assert_multi_run_exits(files, 3, 16)
    end

    it("diamond with functions returning computed values") do ->
      var files: Vec = vec_new()
      files.push(as_int("math.qz"))
      files.push(as_int("def double(x: Int): Int = x * 2"))
      files.push(as_int("a.qz"))
      vec_push(files, as_int("import math\ndef a_fn(): Int\n  return math::double(5)\nend"))
      files.push(as_int("b.qz"))
      vec_push(files, as_int("import math\ndef b_fn(): Int\n  return math::double(10)\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import a\nimport b\ndef main(): Int\n  return a::a_fn() + b::b_fn()\nend"))
      assert_multi_run_exits(files, 3, 30)
    end

    it("diamond with shared global var") do ->
      var files: Vec = vec_new()
      files.push(as_int("config.qz"))
      files.push(as_int("var SETTING = 7"))
      files.push(as_int("reader1.qz"))
      vec_push(files, as_int("import config\ndef r1(): Int\n  return config::SETTING\nend"))
      files.push(as_int("reader2.qz"))
      vec_push(files, as_int("import config\ndef r2(): Int\n  return config::SETTING\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import reader1\nimport reader2\ndef main(): Int\n  return reader1::r1() + reader2::r2()\nend"))
      assert_multi_run_exits(files, 3, 14)
    end
  end

  return qspec_main()
end
