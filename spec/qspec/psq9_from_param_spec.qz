## PSQ-9 regression: `from` / `as` / `where` / `private` / `public` at
## a binding site must emit QZ0530, not infinite-loop the parser.
##
## Origin: KERN.1 context-switching scheduler sprint, Apr 18 2026.
## An `extern "C" def switch_to(from: Int, to: Int): Void` header wedged
## the parser's param loop (TOK_FROM didn't match TOK_IDENT, ps_error
## didn't advance, the outer while loop re-checked TOK_RPAREN forever).
## The compiler ate 30 GB over 30+ min before OOM-kill.
##
## Fix (Apr 19 2026): add TOK_FROM/AS/WHERE/PRIVATE/PUBLIC to
## `_ps_is_reserved_ident_token`, and route extern-fn param parsing
## through `ps_expect_binding_name` instead of a raw `ps_expect(TOK_IDENT)`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("PSQ-9 — reserved keyword at extern-fn param position") do ->

    it("extern \"C\" def fn(from: Int) rejects 'from' with QZ0530") do ->
      assert_compile_error("""
        extern "C" def switch_to(from: Int, to: Int): Void
        def main(): Int
          return 0
        end
      """, "QZ0530")
    end

    it("extern \"C\" def fn(as: Int) rejects 'as' with QZ0530") do ->
      assert_compile_error("""
        extern "C" def cast_to(as: Int): Int
        def main(): Int
          return 0
        end
      """, "QZ0530")
    end

    it("def fn(from: Int) rejects 'from' with QZ0530") do ->
      assert_compile_error("""
        def transfer(from: Int, to: Int): Int
          return from + to
        end
        def main(): Int = transfer(1, 2)
      """, "QZ0530")
    end

    it("var from = ... rejects 'from' with QZ0530") do ->
      assert_compile_error("""
        def main(): Int
          var from = 5
          return from
        end
      """, "QZ0530")
    end
  end

  return qspec_main()
end
