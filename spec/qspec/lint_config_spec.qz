## Lint Config File Tests (Phase 8)
##
## Tests .quartzlint config loading and rule disable/threshold.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint config (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("Config: disable rules") do ->

    it("disables a rule via --config") do ->
      src = """
        def main(): Int
          var x = 42
          return 0
        end
        """
      # Without config, QZ7004 should fire
      assert_lint_warns(src, "QZ7004")
    end

    it("config disables QZ7004") do ->
      # Write config to temp file
      var cfg_path = "/tmp/qz_lint_test_cfg"
      write_file(cfg_path, """
        [rules]
        disable = ["QZ7004"]
        """)
      # Write source to temp file
      var src_path = "/tmp/qz_lint_test_src.qz"
      write_file(src_path, """
        def main(): Int
          var x = 42
          return 0
        end
        """)
      # Run lint with config
      _sub_init()
      var compiler = _sub_compiler_str
      var out_path = "/tmp/qz_lint_test_out"
      var err_path = "/tmp/qz_lint_test_err"
      var cmd = compiler + " lint --config " + cfg_path + " " + src_path + " > " + out_path + " 2> " + err_path
      system(cmd)
      var err = read_file(err_path)
      if str_contains(err, "QZ7004")
        _record_failure("QZ7004 should be disabled by config")
      end
      file_delete(cfg_path)
      file_delete(src_path)
      file_delete(out_path)
      file_delete(err_path)
    end
  end

  describe("Config: thresholds") do ->

    it("respects nesting_depth threshold") do ->
      # Default nesting_depth is 4. With depth 6, 5-deep nesting should pass.
      # This test verifies the config parameter reaches the rule.
      var cfg_path = "/tmp/qz_lint_nd_cfg"
      write_file(cfg_path, """
        [thresholds]
        nesting_depth = 8
        """)
      var src_path = "/tmp/qz_lint_nd_src.qz"
      # 5-level nesting (should warn at default 4, but not at 8)
      write_file(src_path, """
        def main(): Int
          if true
            if true
              if true
                if true
                  if true
                    return 1
                  end
                end
              end
            end
          end
          return 0
        end
        """)
      _sub_init()
      var compiler = _sub_compiler_str
      var out_path = "/tmp/qz_lint_nd_out"
      var err_path = "/tmp/qz_lint_nd_err"
      var cmd = compiler + " lint --config " + cfg_path + " " + src_path + " > " + out_path + " 2> " + err_path
      system(cmd)
      var err = read_file(err_path)
      if str_contains(err, "QZ7202")
        _record_failure("QZ7202 should not fire with nesting_depth 8 on 5 levels")
      end
      file_delete(cfg_path)
      file_delete(src_path)
      file_delete(out_path)
      file_delete(err_path)
    end
  end

  describe("Config: comments and blank lines") do ->

    it("handles comments and blank lines in config") do ->
      var cfg_path = "/tmp/qz_lint_cmnt_cfg"
      write_file(cfg_path, """
        # This is a comment

        [rules]
        disable = ["QZ7004"]

        # Another comment
        """)
      var src_path = "/tmp/qz_lint_cmnt_src.qz"
      write_file(src_path, """
        def main(): Int
          var x = 42
          return 0
        end
        """)
      _sub_init()
      var compiler = _sub_compiler_str
      var out_path = "/tmp/qz_lint_cmnt_out"
      var err_path = "/tmp/qz_lint_cmnt_err"
      var cmd = compiler + " lint --config " + cfg_path + " " + src_path + " > " + out_path + " 2> " + err_path
      system(cmd)
      var err = read_file(err_path)
      if str_contains(err, "QZ7004")
        _record_failure("QZ7004 should be disabled even with comments in config")
      end
      file_delete(cfg_path)
      file_delete(src_path)
      file_delete(out_path)
      file_delete(err_path)
    end
  end

  return qspec_main()
end
