## Error Types Tests
##
## Contract:
##   1. SimpleError.
##   2. IoError.
##   3. ParseError.
##   4. ValueError.
##   5. FormatError.
##   6. WrappedError.
import * from qspec
import * from error

def main(): Int
  describe("SimpleError") do ->
    it("has correct message") do ->
      var e = simple_error("bad thing happened")
      assert_eq_str(e.message(), "bad thing happened")
    end
    it("has kind Error") do ->
      var e = simple_error("oops")
      assert_eq_str(e.kind(), "Error")
    end
  end

  describe("IoError") do ->
    it("has correct message") do ->
      var e = io_error("file not found", "/tmp/missing.txt")
      assert_eq_str(e.message(), "file not found")
    end
    it("has kind IoError") do ->
      var e = io_error("read failed", "/dev/null")
      assert_eq_str(e.kind(), "IoError")
    end
    it("stores path") do ->
      var e = io_error("not found", "/etc/config")
      assert_eq_str(e.path(), "/etc/config")
    end
    it("stores error code") do ->
      var e = io_error_with_code("permission denied", "/root/secret", 13)
      assert_eq(e.code(), 13)
    end
  end

  describe("ParseError") do ->
    it("has correct message") do ->
      var e = parse_error("unexpected token", 5, 12)
      assert_eq_str(e.message(), "unexpected token")
    end
    it("has kind ParseError") do ->
      var e = parse_error("bad syntax", 1, 1)
      assert_eq_str(e.kind(), "ParseError")
    end
    it("stores line and column") do ->
      var e = parse_error("error here", 42, 7)
      assert_eq(e.line(), 42)
      assert_eq(e.column(), 7)
    end
    it("stores source") do ->
      var e = parse_error_with_source("fail", 1, 1, "json")
      assert_eq_str(e.source(), "json")
    end
  end

  describe("ValueError") do ->
    it("has correct message") do ->
      var e = value_error("type mismatch", "Int", "String")
      assert_eq_str(e.message(), "type mismatch")
    end
    it("has kind ValueError") do ->
      var e = value_error("bad", "Int", "Bool")
      assert_eq_str(e.kind(), "ValueError")
    end
    it("stores expected and got") do ->
      var e = value_error("wrong type", "Number", "String")
      assert_eq_str(e.expected(), "Number")
      assert_eq_str(e.got(), "String")
    end
  end

  describe("FormatError") do ->
    it("has correct message") do ->
      var e = format_error("cannot serialize", "json")
      assert_eq_str(e.message(), "cannot serialize")
    end
    it("has kind FormatError") do ->
      var e = format_error("bad format", "toml")
      assert_eq_str(e.kind(), "FormatError")
    end
    it("stores format name") do ->
      var e = format_error("fail", "csv")
      assert_eq_str(e.format(), "csv")
    end
  end

  describe("WrappedError") do ->
    it("has correct message") do ->
      var e = wrap_error("high level failure", "low level cause", "IoError")
      assert_eq_str(e.message(), "high level failure")
    end
    it("has kind WrappedError") do ->
      var e = wrap_error("wrapper", "inner", "ParseError")
      assert_eq_str(e.kind(), "WrappedError")
    end
    it("stores cause message and kind") do ->
      var e = wrap_error("failed to load config", "file not found", "IoError")
      assert_eq_str(e.cause_message(), "file not found")
      assert_eq_str(e.cause_kind(), "IoError")
    end
  end

  return qspec_main()
end
