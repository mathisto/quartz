## Vec Bounds Check Tests — OOB access panics with descriptive message

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("vec_get OOB panic") do ->
    it("panics on vec_get past end") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          vec_push(v, 30)
          puts(str_from_int(vec_get(v, 5)))
          return 0
        end
        """, "index out of bounds")
    end

    it("panics on vec_set past end") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_set(v, 5, 99)
          return 0
        end
        """, "index out of bounds")
    end

    it("panics on v[i] read OOB") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          puts(str_from_int(v[3]))
          return 0
        end
        """, "index out of bounds")
    end

    it("panics on v[i] = x write OOB") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          v[3] = 99
          return 0
        end
        """, "index out of bounds")
    end

    it("panics on empty vec access") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          puts(str_from_int(v[0]))
          return 0
        end
        """, "index out of bounds")
    end

    it("panics on negative index") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          puts(str_from_int(vec_get(v, -1)))
          return 0
        end
        """, "index out of bounds")
    end
  end

  describe("boundary conditions") do ->
    it("last valid index succeeds") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[2], 30)
    end

    it("first invalid index panics") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          vec_push(v, 30)
          puts(str_from_int(vec_get(v, 3)))
          return 0
        end
        """, "index out of bounds")
    end

    it("index 0 on size-1 vec succeeds") do ->
      var v = vec_new()
      v.push(99)
      assert_eq(v[0], 99)
    end
  end

  describe("unchecked access") do ->
    it("vec_get_unchecked does not panic") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          x = vec_get_unchecked(v, 100)
          return 0
        end
        """, 0)
    end
  end

  describe("HB-DOG.7 — panic aborts cleanly without the scheduler") do ->
    # A program that never starts the scheduler (no `go`) leaves the
    # per-thread panic jmpbuf's pthread_key uncreated. Pre-fix,
    # `__qz_panic_jmpbuf_get` called `pthread_getspecific(0)` — UB; on
    # macOS key 0 is libc-reserved TSD and returns a non-null garbage
    # pointer, so the bounds-panic helper `longjmp`'d into garbage and
    # the process died with SIGSEGV (exit 139) instead of a clean
    # abort. The fix makes `_get` ensure the key exists first, so it
    # reads back NULL and the panic aborts cleanly (SIGABRT, exit 134).
    it("OOB index in a no-scheduler program exits 134 (SIGABRT), not 139 (SIGSEGV)") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          return v[5]
        end
        """, 134)
    end
  end

  describe("in-bounds access") do ->
    it("sequential vec_get returns correct values") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[0], 10)
      assert_eq(v[1], 20)
      assert_eq(v[2], 30)
    end

    it("vec_set within bounds updates value") do ->
      var v = vec_new()
      v.push(0)
      v.set(0, 42)
      assert_eq(v[0], 42)
    end

    it("v[i] within bounds returns correct value") do ->
      var v = vec_new()
      v.push(100)
      v.push(200)
      assert_eq(v[0], 100)
      assert_eq(v[1], 200)
    end

    it("v[i] = x within bounds updates value") do ->
      var v = vec_new()
      v.push(0)
      v[0] = 99
      assert_eq(v[0], 99)
    end
  end

  return qspec_main()
end
