## STRESS: Parser/Type Checker Error Recovery
##
## Adversarial tests probing error recovery:
## multiple errors in same function, error cascades, recovery after
## missing end, type mismatch in complex expressions, and invalid syntax.
##
## Contract:
##   1. Errors: expected rejections.
##   2. Errors: syntax recovery.
##   3. Errors: type checking.
##   4. Errors: borrow checker.
##   5. Errors: additional edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Expected Compile Errors
  # ===========================================================================
  describe("errors: expected rejections") do ->
    it("type mismatch: String where Int expected") do ->
      assert_compile_error("""
        def foo(): Int
          return "hello"
        end
        def main(): Int = 0
        """, "Return type mismatch")
    end

    it("undefined variable") do ->
      assert_compile_error("""
        def main(): Int
          return undefined_var
        end
        """, "QZ")
    end

    it("wrong number of arguments") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return add(1)
        end
        """, "QZ")
    end

    it("missing return in non-Void function") do ->
      assert_compile_error("""
        def foo(): Int
          var x = 42
        end
        def main(): Int = 0
        """, "no return statement")
    end

    it("duplicate function definition") do ->
      assert_compile_error("""
        def foo(): Int = 1
        def foo(): Int = 2
        def main(): Int = foo()
        """, "QZ")
    end

    it("unknown type in annotation") do ->
      assert_compile_error("""
        def main(): Int
          var x: Nonexistent = 42
          return x
        end
        """, "Unknown type")
    end
  end

  # ===========================================================================
  # Category B: Syntax Error Recovery
  # ===========================================================================
  describe("errors: syntax recovery") do ->
    it("missing end keyword") do ->
      assert_compile_error("""
        def main(): Int
          if 1
            return 42
        """, "QZ")
    end

    it("unexpected token") do ->
      assert_compile_error("""
        def main(): Int
          return ??? 42
        end
        """, "QZ")
    end

    it("missing closing parenthesis") do ->
      assert_compile_error("""
        def main(): Int
          return (42
        end
        """, "QZ")
    end

    it("invalid struct syntax") do ->
      assert_compile_error("""
        struct Bad
          : Int
        end
        def main(): Int = 0
        """, "QZ")
    end

    it("assignment to non-var binding") do ->
      assert_compile_error("""
        def main(): Int
          x = 42
          x = 99
          return x
        end
        """, "QZ")
    end
  end

  # ===========================================================================
  # Category C: Type Check Errors
  # ===========================================================================
  describe("errors: type checking") do ->
    it("struct field type mismatch") do ->
      assert_compile_error("""
        struct Foo
          x: Int
        end
        def main(): Int
          f = Foo { x: "hello" }
          return 0
        end
        """, "expected Int, got String")
    end

    it("unknown struct field") do ->
      assert_compile_error("""
        struct Point
          x: Int
        end
        def main(): Int
          p = Point { x: 1 }
          return p.z
        end
        """, "QZ")
    end

    it("calling a non-function value produces clear error") do ->
      assert_compile_error("""
        def main(): Int
          x = 5
          x(42)
          return 0
        end
        """, "not a function")
    end

    ## FIXED (f07895e): Enum variant payload count is now validated.
    it("enum variant with wrong arg count is rejected") do ->
      assert_compile_error("""
        enum Color
          Red
          Blue
        end
        def main(): Int
          var c = Color::Red(42)
          return 0
        end
        """, "expects 0 argument")
    end
  end

  # ===========================================================================
  # Category D: Borrow Checker Errors
  # ===========================================================================
  describe("errors: borrow checker") do ->
    it("mutating while borrowed — QZ1209") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var r = &x
          x = 99
          return r + 0
        end
        """, "QZ1209")
    end

    it("returning borrow of local — QZ1210") do ->
      assert_compile_error("""
        def bad(): Int
          var x = 42
          return &x
        end
        def main(): Int = 0
        """, "QZ1210")
    end

    it("exclusive borrow conflict — QZ1205") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var a = &mut x
          var b = &mut x
          return a + b
        end
        """, "QZ1205")
    end

    it("shared + exclusive conflict — QZ1206") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var a = &x
          var b = &mut x
          return a + b
        end
        """, "QZ1206")
    end

    it("mutable borrow of immutable — QZ1208") do ->
      assert_compile_error("""
        def main(): Int
          x = 42
          var p = &mut x
          return p + 0
        end
        """, "QZ1208")
    end
  end

  # ===========================================================================
  # Category E: Additional Error Recovery Edge Cases
  # ===========================================================================
  describe("errors: additional edge cases") do ->
    it("multiple errors: undefined var + wrong arg count") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return add(unknown_var)
        end
        """, "QZ")
    end

    it("deeply nested expression with undefined var") do ->
      assert_compile_error("""
        def main(): Int
          return 1 + (2 * (3 + undefined_var))
        end
        """, "QZ")
    end

    it("assignment to non-var in loop body") do ->
      assert_compile_error("""
        def main(): Int
          x = 10
          for i in 0..5
            x = i
          end
          return x
        end
        """, "QZ")
    end

    it("duplicate struct definition") do ->
      assert_compile_error("""
        struct Foo
          x: Int
        end
        struct Foo
          y: Int
        end
        def main(): Int = 0
        """, "Duplicate struct definition")
    end

    it("return borrow of local in nested scope — QZ1210") do ->
      assert_compile_error("""
        def bad(): Int
          if 1
            var x = 42
            return &x
          end
          return 0
        end
        def main(): Int = 0
        """, "QZ1210")
    end
  end

  return qspec_main()
end
