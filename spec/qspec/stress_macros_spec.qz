## STRESS: Macro Expansion Edge Cases
##
## Adversarial tests probing macro dark corners:
## nested macro invocations, macros with complex expressions,
## variadic macros, quote/unquote depth, template string macros,
## macros in different contexts, and builtin macro edge cases.
##
## Template macros use ${param} syntax (not #{param}, which
## conflicts with string interpolation).
##
## Contract:
##   1. Macros: basic expansion.
##   2. Macros: expression contexts.
##   3. Macros: nested calls.
##   4. Macros: variadic.
##   5. Macros: builtins.
##   6. Macros: hygiene.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Basic Macro Expansion
  # ===========================================================================
  describe("macros: basic expansion") do ->
    it("simple template macro") do ->
      assert_run_exits("""
        macro double(x) do
          "${x} + ${x}"
        end
        def main(): Int
          return $double(21)
        end
        """, 42)
    end

    it("macro with multiple parameters") do ->
      assert_run_exits("""
        macro add3(a, b, c) do
          "${a} + ${b} + ${c}"
        end
        def main(): Int
          return $add3(10, 20, 12)
        end
        """, 42)
    end

    it("quote/unquote macro") do ->
      assert_run_exits("""
        macro double(x) do
          quote do
            unquote(x) * 2
          end
        end
        def main(): Int
          return $double(21)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Macro in Expression Contexts
  # ===========================================================================
  describe("macros: expression contexts") do ->
    it("macro result used in arithmetic") do ->
      assert_run_exits("""
        macro ten(x) do
          "${x} * 10"
        end
        def main(): Int
          result = $ten(4) + 2
          return result
        end
        """, 42)
    end

    it("macro result used in comparison") do ->
      assert_run_exits("""
        macro square(n) do
          "${n} * ${n}"
        end
        def main(): Int
          if $square(6) == 36
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("macro in function argument") do ->
      assert_run_exits("""
        macro inc(x) do
          "${x} + 1"
        end
        def check(n: Int): Int
          return n
        end
        def main(): Int
          return check($inc(41))
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Nested Macro Calls
  # ===========================================================================
  describe("macros: nested calls") do ->
    it("macro result used in subsequent macro call") do ->
      assert_run_exits("""
        macro double(x) do
          "${x} + ${x}"
        end
        macro inc(x) do
          "${x} + 1"
        end
        def main(): Int
          d = $double(20)
          return $inc(d)
        end
        """, 41)
    end

    it("same macro used multiple times") do ->
      assert_run_exits("""
        macro triple(x) do
          "${x} + ${x} + ${x}"
        end
        def main(): Int
          a = $triple(10)
          b = $triple(4)
          return a + b
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Variadic Macros
  # ===========================================================================
  describe("macros: variadic") do ->
    it("variadic sum macro") do ->
      assert_run_exits("""
        macro sum(args...) do
          quote do
            unquote_each(args, " + ")
          end
        end
        def main(): Int
          return $sum(10, 20, 12)
        end
        """, 42)
    end

    it("variadic macro with single argument") do ->
      assert_run_exits("""
        macro identity(args...) do
          quote do
            unquote_each(args, " + ")
          end
        end
        def main(): Int
          return $identity(42)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Builtin Macro Edge Cases
  # ===========================================================================
  describe("macros: builtins") do ->
    it("$assert with true condition succeeds") do ->
      assert_run_exits("""
        def main(): Int
          $assert(1 == 1)
          return 0
        end
        """, 0)
    end

    it("$assert with complex expression") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          $assert(x > 0)
          $assert(x < 100)
          $assert(x == 42)
          return 0
        end
        """, 0)
    end

    it("$debug returns the value") do ->
      assert_run_exits("""
        def main(): Int
          x = $debug(42)
          return x - 42
        end
        """, 0)
    end

    it("$unwrap on Some succeeds") do ->
      assert_run_exits("""
        def main(): Int
          opt = Option::Some(42)
          val = $unwrap(opt)
          return val - 42
        end
        """, 0)
    end

    it("$try on Some unwraps") do ->
      assert_run_exits("""
        def get_val(): Option<Int>
          return Option::Some(42)
        end
        def process(): Option<Int>
          val = try get_val()
          return Option::Some(val)
        end
        def main(): Int
          result = process()
          match result
            Some(v) => return v - 42
            None => return 1
          end
        end
        """, 0)
    end

    it("$try on None returns None") do ->
      assert_run_exits("""
        def get_nothing(): Option<Int>
          return Option::None
        end
        def process(): Option<Int>
          val = try get_nothing()
          return Option::Some(val + 100)
        end
        def main(): Int
          result = process()
          match result
            Some(v) => return 1
            None => return 0
          end
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category F: Macro Hygiene
  # ===========================================================================
  describe("macros: hygiene") do ->
    it("macro doesn't pollute caller scope") do ->
      assert_run_exits("""
        macro get_val(x) do
          quote do
            unquote(x) + 1
          end
        end
        def main(): Int
          x = 41
          result = $get_val(x)
          if result == 42
            if x == 41
              return 0
            end
          end
          return 1
        end
        """, 0)
    end

    it("multiple template macro calls don't interfere") do ->
      assert_run_exits("""
        macro double(x) do
          "${x} + ${x}"
        end
        def main(): Int
          a = $double(10)
          b = $double(5)
          c = $double(1)
          return a + b + c
        end
        """, 32)
    end
  end

  return qspec_main()
end

