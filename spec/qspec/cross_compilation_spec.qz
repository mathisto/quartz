## Cross Compilation Tests
##
## Contract:
##   1. Compiles with aarch64 target.
##   2. Compiles with x86_64 target.
##   3. Default target emits standard.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Cross Compilation") do ->
    it("compiles with aarch64 target triple") do ->
      assert_ir_contains_with_flags("""
        def main(): Int
          return 42
        end
      """, "aarch64", "--target aarch64-unknown-none")
    end

    it("compiles with x86_64 target triple") do ->
      assert_ir_contains_with_flags("""
        def main(): Int
          return 42
        end
      """, "x86_64", "--target x86_64-unknown-linux-gnu")
    end

    it("default target emits standard declarations") do ->
      assert_compile_succeeds("""
        def main(): Int
          return 0
        end
      """)
    end
  end

  return qspec_main()
end
