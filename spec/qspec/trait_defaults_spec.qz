## Trait Default Method Tests
##
## Contract:
##   1. Default methods with self work
##   2. Default methods calling other trait methods work
##   3. Partial impl inherits defaults
##   4. Override replaces default
##   5. Default with Self return type

import * from qspec

# -- Trait with default that uses self field access --

struct DfWidget
  value: Int
end

trait DfDescribable
  def df_label(self): String
    return "widget"
  end
  def df_value(self): Int
    return 0
  end
  def df_summary(self): String
    return "#{self.df_label()}: #{self.df_value()}"
  end
end

extend DfWidget with DfDescribable
  def df_label(self): String = "w"
  def df_value(self): Int = @value
  # df_summary inherited as default — calls df_label() and df_value()
end

# -- Trait with default neq calling eq --

struct DfPair
  a: Int
  b: Int
end

trait DfEq
  def df_eq(self, other: Self): Bool
    return false
  end
  def df_neq(self, other: Self): Bool = not self.df_eq(other)
end

extend DfPair with DfEq
  def df_eq(self, other: Self): Bool
    return @a == other.a and @b == other.b
  end
  # df_neq inherited — calls self.df_eq(other) then negates
end

# -- Trait with default returning Self --

struct DfCounter
  count: Int
end

trait DfIncrementable
  def df_inc(self): Self
    return self
  end
  def df_add(self, n: Int): Self
    return self
  end
end

extend DfCounter with DfIncrementable
  def df_inc(self): Self
    return DfCounter { count: @count + 1 }
  end
  # df_add inherited as default (returns self unchanged)
end

# -- Override replaces default --

struct DfBox
  size: Int
end

trait DfSizable
  def df_size_label(self): String = "unknown"
  def df_report(self): String = "size: #{self.df_size_label()}"
end

extend DfBox with DfSizable
  def df_size_label(self): String
    if @size > 10
      return "large"
    end
    return "small"
  end
  def df_report(self): String = "box(#{@size}): #{self.df_size_label()}"
end

# -- Helpers --

def df_summary_test(): String
  w = DfWidget { value: 42 }
  return w.df_summary()
end

def df_neq_test(): Int
  a = DfPair { a: 1, b: 2 }
  b = DfPair { a: 1, b: 2 }
  c = DfPair { a: 3, b: 4 }
  var result = 0
  if a.df_eq(b)
    result += 1
  end
  if a.df_neq(c)
    result += 10
  end
  if not a.df_neq(b)
    result += 100
  end
  return result
end

def df_inc_test(): Int
  c = DfCounter { count: 5 }
  d = c.df_inc()
  return d.count
end

def df_add_default_test(): Int
  c = DfCounter { count: 5 }
  d = c.df_add(10)
  return d.count
end

def main(): Int
  describe("trait default methods") do ->
    it("default calls overridden methods via self") do ->
      assert_eq_str(df_summary_test(), "w: 42")
    end

    it("default neq calls overridden eq") do ->
      assert_eq(df_neq_test(), 111)
    end

    it("overridden method with Self return") do ->
      assert_eq(df_inc_test(), 6)
    end

    it("inherited default returns self unchanged") do ->
      assert_eq(df_add_default_test(), 5)
    end

    it("fully overridden default") do ->
      b = DfBox { size: 20 }
      assert_eq_str(b.df_report(), "box(20): large")
    end

    it("small box overridden default") do ->
      b = DfBox { size: 3 }
      assert_eq_str(b.df_report(), "box(3): small")
    end
  end

  return qspec_main()
end
