## Enums Tests
##
## Contract:
##   1. Enum definition: simple and single-variant enums compile.
##   2. Sequential values: variants assigned 0, 1, 2, ... automatically.
##   3. Enum variables: can store, reassign, read enum values.
##   4. Comparison: enum values comparable with `==` and `!=`.
##   5. Functions: enums passable as args and returnable.
##   6. Multiple enums: separate namespaces, composable.
##   7. Data structures: enums storable in arrays and vectors.
##   8. Match: enums dispatchable in match expressions.

import * from qspec

enum EColor
  Red
  Green
  Blue
end

enum EUnit
  Value
end

enum EStatus
  Active
  Inactive
end

enum EDirection
  North
  South
  East
  West
end

enum EFirst
  A
  B
  C
end

enum ESecond
  A
  B
end

enum ESize
  Small
  Large
end

enum EOkErr
  Ok
  Error
end

def main(): Int
  describe("enum definition") do ->
    it("defines a simple enum") do ->
      assert_eq(EColor::Red, 0)
    end

    it("defines enum with single variant") do ->
      assert_eq(EUnit::Value, 0)
    end
  end

  describe("enum values") do ->
    it("assigns sequential integer values starting at 0") do ->
      assert_eq(EColor::Red, 0)
    end

    it("assigns correct values to all variants") do ->
      assert_eq(EColor::Green, 1)
    end

    it("handles third variant") do ->
      assert_eq(EColor::Blue, 2)
    end
  end

  describe("enum variables") do ->
    it("stores enum value in variable") do ->
      s = EStatus::Active
      assert_eq(s, 0)
    end

    it("reassigns enum variable") do ->
      var s = EStatus::Active
      s = EStatus::Inactive
      assert_eq(s, 1)
    end
  end

  describe("enum comparison") do ->
    it("compares enum values for equality") do ->
      c = EColor::Red
      if c == EColor::Red
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("compares enum values for inequality") do ->
      c = EColor::Green
      if c == EColor::Red
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("uses enum in if-else") do ->
      assert_eq(enum_direction_test(EDirection::East), 3)
    end
  end

  describe("enum in functions") do ->
    it("passes enum as function argument") do ->
      assert_eq(enum_color_value(EColor::Blue), 2)
    end

    it("returns enum from function") do ->
      s = enum_get_status()
      if s == EOkErr::Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("multiple enums") do ->
    it("supports multiple enum definitions") do ->
      c = EColor::Green
      s = ESize::Large
      assert_eq(c + s, 2)
    end

    it("keeps enum namespaces separate") do ->
      assert_eq(EFirst::C + ESecond::B, 3)
    end
  end

  describe("enum in data structures") do ->
    it("stores enum in array") do ->
      colors = [EColor::Red, EColor::Green, EColor::Blue]
      assert_eq(colors[1], 1)
    end

    it("stores enum in struct field") do ->
      var v = vec_new()
      v.push(EColor::Red)
      v.push(EColor::Blue)
      assert_eq(v[0], 0)
      assert_eq(v[1], 2)
    end
  end

  # ===========================================================================
  # Enum in match expression
  # ===========================================================================
  describe("enum in match expression") do ->
    it("dispatches all color variants via match") do ->
      assert_eq(enum_match_color(EColor::Red), 10)
      assert_eq(enum_match_color(EColor::Green), 20)
      assert_eq(enum_match_color(EColor::Blue), 30)
    end
  end

  # ===========================================================================
  # Enum round-trip through function
  # ===========================================================================
  describe("enum round-trip") do ->
    it("passes enum value through function and back") do ->
      s = enum_get_status()
      assert_eq(enum_is_ok(s), 1)
    end
  end

  # ===========================================================================
  # Enum variant count
  # ===========================================================================
  describe("enum variant numbering") do ->
    it("4-variant enum has correct values 0-3") do ->
      assert_eq(EDirection::North, 0)
      assert_eq(EDirection::South, 1)
      assert_eq(EDirection::East, 2)
      assert_eq(EDirection::West, 3)
    end
  end

  return qspec_main()
end

def enum_direction_test(dir: Int): Int
  if dir == EDirection::North
    return 1
  else
    if dir == EDirection::South
      return 2
    else
      if dir == EDirection::East
        return 3
      else
        return 4
      end
    end
  end
end

def enum_color_value(c: Int): Int
  return c
end

def enum_get_status(): Int
  return EOkErr::Ok
end

def enum_match_color(c: EColor): Int
  return match c
    EColor::Red => 10
    EColor::Green => 20
    EColor::Blue => 30
  end
end

def enum_is_ok(s: Int): Int
  if s == EOkErr::Ok
    return 1
  end
  return 0
end
