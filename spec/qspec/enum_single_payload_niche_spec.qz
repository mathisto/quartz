## General single-payload + K-dataless enum niche tests (enum-niche workstream —
## Rust-parity generalization of the Option niche).
##
## The Option niche (Some(p)=p / None=0) generalizes to ANY enum with exactly ONE
## payload-carrying variant + K dataless variants. For a payload variant carrying a
## boxed type P and dataless variants D_0..D_{K-1}:
##   - the payload variant IS the pointer (a valid boxed P, never 0..K-1)
##   - dataless variant D_j is the integer j (the BOTTOM niche {0..K-1})
## Read by a range test: value < K ⇒ dataless variant j=value, else ⇒ payload.
## This subsumes Option as the K=1 case (None=0=D_0).
##
## These tests lock OBSERVABLE behavior identically regardless of physical
## representation: they pass under the tagged-box SPILL path (current golden) AND
## under the niche path (after the flip), so they are a differential oracle.
##
## Coverage:
##   - K=1 (Cons(NodePtr) | Nil) — essentially Option-shaped
##   - K=2 (Ok(Box) | Eof | Err) — 1 payload + 2 dataless
##   - K=3 (Lit(Box) | A | B | C) — 1 payload + 3 dataless
##   - construct each variant, `is` checks, match, payload unwrap round-trip
##   - dataless variants are mutually distinct AND distinct from the payload
##   - round-trip through a function arg + return (call-arg/return slots)
##   - a NESTED case (enum holding the enum)
##   - Vec<thatenum> round-trip (the element-slot threading regression lock)
import * from qspec

# A boxed payload struct (non-@value ⇒ niche-eligible boxed pointer).
struct Box
  v: Int
end

# K=1 — single payload + single dataless (Option-shaped; Cons/Nil).
enum LL
  Cons(box: Box)
  Nil
end

# K=2 — single payload Ok + two dataless Eof/Err.
enum Parse
  Done(box: Box)
  Eof
  Bad
end

# K=3 — single payload Lit + three dataless A/B/C. Payload variant NOT first.
enum Tok
  A
  Lit(box: Box)
  B
  C
end

# SOUNDNESS CARVE-OUT: a single-payload enum whose payload is a DATALESS ENUM must
# NOT niche — a dataless enum's values are small scalar tags {0..M-1}, which would
# COLLIDE with the bottom niche {0..K-1} (`Wrap(Inner::Zero)`=0 == `Empty`'s niche
# 0). The compiler must keep this on the tagged-box SPILL path. This case round-
# trips correctly (locks the carve-out): the regression that motivated it segfaulted
# (nested_qualified_variant_pattern_spec) when the payload was wrongly niched.
enum Inner
  Zero
  One
  Two
end

enum Wrap
  Carry(i: Inner)
  Empty
end

def wrap_code(w: Wrap): Int
  return match w
    Carry(i) => match i
      Zero => 0
      One => 1
      Two => 2
    end
    Empty => -1
  end
end

# Holds a Parse — a nested-enum case (Parse inside a struct that the read sees).
struct Holder
  p: Parse
end

def mk_box(n: Int): Box = Box { v: n }

def parse_ok(n: Int): Parse = Parse::Done(mk_box(n))
def parse_eof(): Parse = Parse::Eof
def parse_err(): Parse = Parse::Bad

def parse_payload_or(p: Parse, dflt: Int): Int
  return match p
    Done(b) => b.v
    Eof => -10
    Bad => -20
  end
end

def main(): Int
  describe("LL (K=1) — Cons payload + Nil dataless") do ->
    it("is Cons for a constructed Cons") do ->
      x = LL::Cons(mk_box(7))
      assert_eq(x is Cons, 1)
      assert_eq(x is Nil, 0)
    end
    it("is Nil for a constructed Nil") do ->
      x = LL::Nil
      assert_eq(x is Nil, 1)
      assert_eq(x is Cons, 0)
    end
    it("matches Cons(b) and recovers the boxed payload") do ->
      x = LL::Cons(mk_box(42))
      v = match x
        Cons(b) => b.v
        Nil => -1
      end
      assert_eq(v, 42)
    end
    it("matches Nil") do ->
      x = LL::Nil
      v = match x
        Cons(b) => b.v
        Nil => 99
      end
      assert_eq(v, 99)
    end
  end

  describe("Parse (K=2) — Ok payload + Eof/Err dataless") do ->
    it("is Ok / not Eof / not Err for Ok") do ->
      p = parse_ok(5)
      assert_eq(p is Done, 1)
      assert_eq(p is Eof, 0)
      assert_eq(p is Bad, 0)
    end
    it("is Eof for Eof, distinct from Err and Ok") do ->
      p = parse_eof()
      assert_eq(p is Eof, 1)
      assert_eq(p is Bad, 0)
      assert_eq(p is Done, 0)
    end
    it("is Err for Err, distinct from Eof and Ok") do ->
      p = parse_err()
      assert_eq(p is Bad, 1)
      assert_eq(p is Eof, 0)
      assert_eq(p is Done, 0)
    end
    it("match recovers the Ok payload") do ->
      assert_eq(parse_payload_or(parse_ok(13), 0), 13)
    end
    it("match selects Eof arm") do ->
      assert_eq(parse_payload_or(parse_eof(), 0), -10)
    end
    it("match selects Err arm") do ->
      assert_eq(parse_payload_or(parse_err(), 0), -20)
    end
    it("the two dataless variants are mutually distinct") do ->
      # Eof and Err must read back as different variants.
      e = parse_eof()
      r = parse_err()
      assert_eq(e is Eof, 1)
      assert_eq(r is Eof, 0)
      assert_eq(e is Bad, 0)
      assert_eq(r is Bad, 1)
    end
  end

  describe("Tok (K=3) — payload variant NOT declared first") do ->
    it("is Lit for Lit, recovers payload") do ->
      t = Tok::Lit(mk_box(8))
      assert_eq(t is Lit, 1)
      v = match t
        A => -1
        Lit(b) => b.v
        B => -2
        C => -3
      end
      assert_eq(v, 8)
    end
    it("three dataless A/B/C are mutually distinct and != Lit") do ->
      a = Tok::A
      b = Tok::B
      c = Tok::C
      assert_eq(a is A, 1)
      assert_eq(a is B, 0)
      assert_eq(a is C, 0)
      assert_eq(a is Lit, 0)
      assert_eq(b is B, 1)
      assert_eq(b is A, 0)
      assert_eq(c is C, 1)
      assert_eq(c is B, 0)
    end
    it("match selects each dataless arm correctly") do ->
      assert_eq(tok_code(Tok::A), 1)
      assert_eq(tok_code(Tok::B), 2)
      assert_eq(tok_code(Tok::C), 3)
      assert_eq(tok_code(Tok::Lit(mk_box(0))), 0)
    end
  end

  describe("soundness carve-out — dataless-enum payload must NOT niche (spill)") do ->
    it("Carry(Inner) round-trips each inner variant — no niche collision") do ->
      # If Wrap wrongly niched, Carry(Inner::Zero)=0 would collide with Empty's
      # niche scalar 0 ⇒ Carry(Zero) misreads as Empty. Must round-trip distinctly.
      assert_eq(wrap_code(Wrap::Carry(Inner::Zero)), 0)
      assert_eq(wrap_code(Wrap::Carry(Inner::One)), 1)
      assert_eq(wrap_code(Wrap::Carry(Inner::Two)), 2)
      assert_eq(wrap_code(Wrap::Empty), -1)
    end
    it("Carry(Inner::Zero) is Carry, not Empty") do ->
      w = Wrap::Carry(Inner::Zero)
      assert_eq(w is Carry, 1)
      assert_eq(w is Empty, 0)
    end
    it("Empty is Empty, distinct from Carry(Zero)") do ->
      w = Wrap::Empty
      assert_eq(w is Empty, 1)
      assert_eq(w is Carry, 0)
    end
    it("nested qualified pattern Carry(Inner::Two) dispatches correctly") do ->
      w = Wrap::Carry(Inner::Two)
      v = match w
        Carry(Inner::Zero) => 100
        Carry(Inner::One)  => 101
        Carry(Inner::Two)  => 102
        Empty              => -1
      end
      assert_eq(v, 102)
    end
  end

  describe("nested + collection round-trips") do ->
    it("Parse inside a struct field round-trips") do ->
      h = Holder { p: parse_ok(77) }
      assert_eq(h.p is Done, 1)
      v = match h.p
        Done(b) => b.v
        Eof => -1
        Bad => -2
      end
      assert_eq(v, 77)
    end
    it("Parse Eof inside a struct field round-trips") do ->
      h = Holder { p: parse_eof() }
      assert_eq(h.p is Eof, 1)
      assert_eq(h.p is Done, 0)
    end
    it("Vec<Parse> round-trips each variant") do ->
      var vs = vec_new<Parse>()
      vs.push(parse_ok(1))
      vs.push(parse_eof())
      vs.push(parse_err())
      vs.push(parse_ok(2))
      assert_eq(vs[0] is Done, 1)
      assert_eq(vs[1] is Eof, 1)
      assert_eq(vs[2] is Bad, 1)
      assert_eq(vs[3] is Done, 1)
      assert_eq(parse_payload_or(vs[0], 0), 1)
      assert_eq(parse_payload_or(vs[3], 0), 2)
      assert_eq(parse_payload_or(vs[1], 0), -10)
    end
  end

  return qspec_main()
end

def tok_code(t: Tok): Int
  return match t
    A => 1
    Lit(b) => 0
    B => 2
    C => 3
  end
end
