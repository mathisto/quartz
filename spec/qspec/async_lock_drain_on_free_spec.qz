import * from qspec

# ============================================================================
# Async lock drain-on-free defensive abort (Tier 3 #15a item 1)
# ============================================================================
# async_mutex_free / async_rwlock_free abort when the wait list is non-empty.
# Freeing a lock with parked waiters leaves their wait nodes dangling in
# memory the runtime will soon reclaim, priming the next waker/unlock for
# use-after-free on the freed struct. The assertion is defensive — it
# surfaces the misuse at the free site instead of crashing at the next
# wake, where the root cause is much harder to see.
# ============================================================================

def main(): Int
  describe("async_mutex_free drain-on-free assertion") do ->
    it("aborts when freed while a waiter is parked") do ->
      assert_run_panics("""
        var g_mtx = 0

        def holder(): Int
          var v = async_mutex_lock(g_mtx)
          # Hold forever — yield so contender gets CPU and parks on the mutex
          var i = 0
          while i < 1000
            sched_yield()
            i = i + 1
          end
          return v
        end

        def contender(): Int
          # Will park — holder never releases
          return async_mutex_lock(g_mtx)
        end

        def main(): Int
          g_mtx = async_mutex_new(0)
          sched_init(2)
          var ha = go holder()
          # Let holder acquire
          var i = 0
          while i < 50
            sched_yield()
            i = i + 1
          end
          var hb = go contender()
          # Let contender park on mutex
          i = 0
          while i < 50
            sched_yield()
            i = i + 1
          end
          async_mutex_free(g_mtx)
          return 0
        end
      """, "async lock freed while wait list non-empty")
    end
  end

  describe("async_rwlock_free drain-on-free assertion") do ->
    it("aborts when freed while a reader is parked") do ->
      assert_run_panics("""
        var g_rw = 0

        def writer(): Int
          var v = async_rwlock_write(g_rw)
          # Hold write lock — never release
          var i = 0
          while i < 1000
            sched_yield()
            i = i + 1
          end
          return v
        end

        def reader(): Int
          # Parks — writer holds exclusive
          return async_rwlock_read(g_rw)
        end

        def main(): Int
          g_rw = async_rwlock_new(0)
          sched_init(2)
          var hw = go writer()
          var i = 0
          while i < 50
            sched_yield()
            i = i + 1
          end
          var hr = go reader()
          i = 0
          while i < 50
            sched_yield()
            i = i + 1
          end
          async_rwlock_free(g_rw)
          return 0
        end
      """, "async lock freed while wait list non-empty")
    end
  end

  return qspec_main()
end
