## Piezo P3.C — NODE_AWAIT → `perform(Async, await, handle)` migration.
##
## NODE_AWAIT in a $poll-lowered function routes through
## `perform(Async, await, handle)`. The default Async handler
## busy-polls the future, loads the result when ready, and calls
## `__qz_effect_resume_cont(result)` — the kind=3 re-entry delivers
## the result back into the calling $poll, which runs the body to
## completion and returns normally.
##
## Outside-$poll awaits are not covered here — they still flow through
## the pthread_join MIR_AWAIT fallback and will migrate when the
## `spawn`/`await`-on-pthread surface follows.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("P3.C — NODE_AWAIT → perform(Async, await, handle)") do ->
    it("await inside $poll-lowered caller returns the awaited value") do ->
      var src = """
def work(): Int = 42

def awaiter(h: Int): Int
  var v = await h
  return v + 1
end

def main(): Int
  sched_init(2)
  var h = async work()
  var aw = async awaiter(h)
  sched_spawn(aw)
  sched_shutdown()
  var r = load(aw, 1)
  puts("r=" + r.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=43\n")
    end

    it("chained awaits in a single $poll function") do ->
      var src = """
def work(x: Int): Int = x * 10

def chained(a: Int, b: Int): Int
  var va = await a
  var vb = await b
  return va + vb
end

def main(): Int
  sched_init(2)
  var h1 = async work(3)
  var h2 = async work(5)
  var aw = async chained(h1, h2)
  sched_spawn(aw)
  sched_shutdown()
  puts("r=" + load(aw, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=80\n")
    end

    it("nested async pyramid: await chained through two suspendable layers") do ->
      var src = """
def leaf(): Int = 100

def mid(h: Int): Int
  var v = await h
  return v + 10
end

def top(h: Int): Int
  var v = await h
  return v + 1
end

def main(): Int
  sched_init(2)
  var h_leaf = async leaf()
  var h_mid = async mid(h_leaf)
  sched_spawn(h_mid)
  var h_top = async top(h_mid)
  sched_spawn(h_top)
  sched_shutdown()
  puts("r=" + load(h_top, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=111\n")
    end

    it("eager-done future hits the handler's fast path") do ->
      var src = """
def trivial(): Int = 99

def awaiter(h: Int): Int
  var v = await h
  return v + 1
end

def main(): Int
  sched_init(2)
  var h = async trivial()
  var aw = async awaiter(h)
  sched_spawn(aw)
  sched_shutdown()
  puts("r=" + load(aw, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=100\n")
    end

    it("user override: `with Async { await: my_h } do ... end` intercepts") do ->
      var src = """
import std/async

def work(): Int = 7

def my_await(op: Int, argc: Int, argv: Int): Int
  puts("user await fired")
  resume(999)
end

def awaiter(h: Int): Int
  var v = await h
  return v
end

def main(): Int
  sched_init(2)
  var h = async work()
  var aw = async awaiter(h)
  with Async { await: my_await } do ->
    sched_spawn(aw)
    sched_shutdown()
  end
  puts("r=" + load(aw, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "user await fired\nr=999\n")
    end
  end
  return qspec_main()
end
