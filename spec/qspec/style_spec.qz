## Style API Tests
##
## Tests the composable Style API: construction, chaining,
## ANSI output, color degradation, semantic presets, stripping.
import * from qspec
import * from style

def main(): Int
  describe("Style builder") do ->
    it("new() creates empty style") do ->
      s = Style.new()
      assert_eq_str(s.render_at("hello", 16), "hello")
    end

    it("bold renders SGR 1") do ->
      s = Style.new().bold()
      assert_eq_str(s.render_at("hi", 16), "\x1b[1mhi\x1b[0m")
    end

    it("dim renders SGR 2") do ->
      s = Style.new().dim()
      assert_eq_str(s.render_at("hi", 16), "\x1b[2mhi\x1b[0m")
    end

    it("italic renders SGR 3") do ->
      s = Style.new().italic()
      assert_eq_str(s.render_at("hi", 16), "\x1b[3mhi\x1b[0m")
    end

    it("underline renders SGR 4") do ->
      s = Style.new().underline()
      assert_eq_str(s.render_at("hi", 16), "\x1b[4mhi\x1b[0m")
    end

    it("inverse renders SGR 7") do ->
      s = Style.new().inverse()
      assert_eq_str(s.render_at("hi", 16), "\x1b[7mhi\x1b[0m")
    end

    it("strikethrough renders SGR 9") do ->
      s = Style.new().strikethrough()
      assert_eq_str(s.render_at("hi", 16), "\x1b[9mhi\x1b[0m")
    end
  end

  describe("Style foreground colors") do ->
    it("basic fg color (Red = 1)") do ->
      s = Style.new().fg(Red())
      assert_eq_str(s.render_at("x", 16), "\x1b[31mx\x1b[0m")
    end

    it("bright fg color (BrightCyan = 14)") do ->
      s = Style.new().fg(BrightCyan())
      assert_eq_str(s.render_at("x", 16), "\x1b[96mx\x1b[0m")
    end

    it("256-color fg") do ->
      s = Style.new().fg(ansi256_color(202))
      assert_eq_str(s.render_at("x", 256), "\x1b[38;5;202mx\x1b[0m")
    end

    it("RGB fg at truecolor depth") do ->
      s = Style.new().fg(rgb_color(255, 128, 0))
      assert_eq_str(s.render_at("x", 16777216), "\x1b[38;2;255;128;0mx\x1b[0m")
    end

    it("fg_rgb shorthand") do ->
      s = Style.new().fg_rgb(100, 200, 50)
      assert_eq_str(s.render_at("x", 16777216), "\x1b[38;2;100;200;50mx\x1b[0m")
    end
  end

  describe("Style background colors") do ->
    it("basic bg color (Blue = 4)") do ->
      s = Style.new().bg(Blue())
      assert_eq_str(s.render_at("x", 16), "\x1b[44mx\x1b[0m")
    end

    it("bright bg color (BrightGreen = 10)") do ->
      s = Style.new().bg(BrightGreen())
      assert_eq_str(s.render_at("x", 16), "\x1b[102mx\x1b[0m")
    end

    it("RGB bg at truecolor depth") do ->
      s = Style.new().bg(rgb_color(0, 128, 255))
      assert_eq_str(s.render_at("x", 16777216), "\x1b[48;2;0;128;255mx\x1b[0m")
    end
  end

  describe("Style chaining") do ->
    it("bold + fg combines codes") do ->
      s = Style.new().bold().fg(Red())
      assert_eq_str(s.render_at("x", 16), "\x1b[1;31mx\x1b[0m")
    end

    it("bold + italic + underline + fg + bg") do ->
      s = Style.new().bold().italic().underline().fg(Green()).bg(Black())
      assert_eq_str(s.render_at("x", 16), "\x1b[1;3;4;32;40mx\x1b[0m")
    end

    it("chaining is immutable — original unchanged") do ->
      base = Style.new().bold()
      derived = base.fg(Red())
      assert_eq_str(base.render_at("x", 16), "\x1b[1mx\x1b[0m")
      assert_eq_str(derived.render_at("x", 16), "\x1b[1;31mx\x1b[0m")
    end
  end

  describe("Style semantic presets") do ->
    it("error is bold red") do ->
      s = Style.error()
      assert_eq_str(s.render_at("!", 16), "\x1b[1;31m!\x1b[0m")
    end

    it("success is bold green") do ->
      s = Style.success()
      assert_eq_str(s.render_at("!", 16), "\x1b[1;32m!\x1b[0m")
    end

    it("warning is bold yellow") do ->
      s = Style.warning()
      assert_eq_str(s.render_at("!", 16), "\x1b[1;33m!\x1b[0m")
    end

    it("info is blue (not bold)") do ->
      s = Style.info()
      assert_eq_str(s.render_at("!", 16), "\x1b[34m!\x1b[0m")
    end

    it("muted is gray (bright black)") do ->
      s = Style.muted()
      assert_eq_str(s.render_at("!", 16), "\x1b[90m!\x1b[0m")
    end

    it("heading is bold underline cyan") do ->
      s = Style.heading()
      assert_eq_str(s.render_at("!", 16), "\x1b[1;4;36m!\x1b[0m")
    end
  end

  describe("Style color degradation") do ->
    it("depth 0 strips all styling") do ->
      s = Style.new().bold().fg(Red()).bg(Blue())
      assert_eq_str(s.render_at("hi", 0), "hi")
    end

    it("RGB degrades to 256 at depth 256") do ->
      s = Style.new().fg(rgb_color(255, 0, 0))
      result = s.render_at("x", 256)
      assert_eq_str(result, "\x1b[38;5;196mx\x1b[0m")
    end

    it("RGB degrades to 16 at depth 16") do ->
      s = Style.new().fg(rgb_color(255, 0, 0))
      result = s.render_at("x", 16)
      assert_eq_str(result, "\x1b[91mx\x1b[0m")
    end

    it("256-color degrades to 16 at depth 16") do ->
      s = Style.new().fg(ansi256_color(196))
      result = s.render_at("x", 16)
      assert_eq_str(result, "\x1b[91mx\x1b[0m")
    end
  end

  describe("Style hex colors") do ->
    it("hex_color parses #RRGGBB") do ->
      s = Style.new().fg(hex_color("#FF8000"))
      assert_eq_str(s.render_at("x", 16777216), "\x1b[38;2;255;128;0mx\x1b[0m")
    end

    it("hex_color parses without #") do ->
      s = Style.new().fg(hex_color("00FF00"))
      assert_eq_str(s.render_at("x", 16777216), "\x1b[38;2;0;255;0mx\x1b[0m")
    end
  end

  describe("Style ANSI stripping") do ->
    it("strips bold+color from styled text") do ->
      styled = Style.new().bold().fg(Red()).render_at("hello", 16)
      assert_eq_str(style_strip_ansi(styled), "hello")
    end

    it("visible_len returns text length without ANSI") do ->
      styled = Style.new().bold().fg(Red()).render_at("hello", 16)
      assert_eq(style_visible_len(styled), 5)
    end

    it("plain text passes through strip unchanged") do ->
      assert_eq_str(style_strip_ansi("hello world"), "hello world")
    end
  end

  describe("Style is_empty") do ->
    it("new style is empty") do ->
      assert_eq(style_check_empty(), 1)
    end

    it("styled style is not empty") do ->
      assert_eq(style_check_bold_not_empty(), 1)
    end
  end

  return qspec_main()
end

## Helper functions for is_empty tests (avoid Bool-to-Int issues in assert_eq)
def style_check_empty(): Int
  s = Style.new()
  if s.is_empty()
    return 1
  end
  return 0
end

def style_check_bold_not_empty(): Int
  s = Style.new().bold()
  if s.is_empty()
    return 0
  end
  return 1
end
