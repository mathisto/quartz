## Memory Tests
##
## Contract:
##   1. Accumulates sum in memory.
##   2. Allocates memory and returns.
##   3. Allocates multiple words.
##   4. Allocates zero words.
##   5. Builds a simple linked.
##   6. Builds a two-node chain.
import * from qspec

def main(): Int
  describe("memory operations") do ->
    it("allocates memory and returns pointer") do ->
      assert_eq(mem_alloc_basic(), 0)
    end
    it("allocates multiple words") do ->
      assert_eq(mem_alloc_multi(), 0)
    end
    it("allocates zero words") do ->
      assert_eq(mem_alloc_zero(), 0)
    end
    it("stores and loads single value") do ->
      assert_eq(mem_store_load(), 42)
    end
    it("stores and loads at different offsets") do ->
      assert_eq(mem_store_offsets(), 60)
    end
    it("overwrites values") do ->
      assert_eq(mem_overwrite(), 42)
    end
    it("stores computed values") do ->
      assert_eq(mem_computed(), 42)
    end
    it("loads into expressions") do ->
      assert_eq(mem_load_expr(), 42)
    end
    it("uses memory in a loop") do ->
      assert_eq(mem_loop(), 60)
    end
    it("uses memory with conditionals") do ->
      assert_eq(mem_conditional(), 42)
    end
    it("accumulates sum in memory") do ->
      assert_eq(mem_accumulate(), 55)
    end
    it("passes pointer to function") do ->
      assert_eq(mem_pass_ptr(), 42)
    end
    it("returns pointer from function") do ->
      assert_eq(mem_return_ptr(), 42)
    end
    it("modifies memory through pointer") do ->
      assert_eq(mem_modify_ptr(), 42)
    end
    it("handles large offset") do ->
      assert_eq(mem_large_offset(), 42)
    end
    it("handles negative values") do ->
      assert_eq(mem_negative(), 42)
    end
    it("handles zero value") do ->
      assert_eq(mem_zero(), 0)
    end
    it("stores boolean-like values") do ->
      assert_eq(mem_booleans(), 42)
    end
    it("builds a simple linked node") do ->
      assert_eq(mem_linked_node(), 42)
    end
    it("builds a two-node chain") do ->
      assert_eq(mem_two_node(), 42)
    end
    it("builds array with length prefix") do ->
      assert_eq(mem_array_prefix(), 42)
    end
  end
  return qspec_main()
end

def mem_alloc_basic(): Int
  ptr = mem_alloc(1)
  if ptr
    return 0
  else
    return 1
  end
end

def mem_alloc_multi(): Int
  ptr = mem_alloc(10)
  if ptr
    return 0
  else
    return 1
  end
end

def mem_alloc_zero(): Int
  ptr = mem_alloc(0)
  return 0
end

def mem_store_load(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, 42)
  val = load(ptr, 0)
  return val
end

def mem_store_offsets(): Int
  ptr = mem_alloc(3)
  store(ptr, 0, 10)
  store(ptr, 1, 20)
  store(ptr, 2, 30)
  a = load(ptr, 0)
  b = load(ptr, 1)
  c = load(ptr, 2)
  return a + b + c
end

def mem_overwrite(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, 100)
  store(ptr, 0, 42)
  return load(ptr, 0)
end

def mem_computed(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, 6 * 7)
  return load(ptr, 0)
end

def mem_load_expr(): Int
  ptr = mem_alloc(2)
  store(ptr, 0, 20)
  store(ptr, 1, 22)
  return load(ptr, 0) + load(ptr, 1)
end

def mem_loop(): Int
  arr = mem_alloc(5)
  var i = 0
  while i < 5
    store(arr, i, i * 10)
    i = i + 1
  end
  return load(arr, 2) + load(arr, 4)
end

def mem_conditional(): Int
  ptr = mem_alloc(1)
  x = 1
  if x
    store(ptr, 0, 42)
  else
    store(ptr, 0, 0)
  end
  return load(ptr, 0)
end

def mem_accumulate(): Int
  sum_ptr = mem_alloc(1)
  store(sum_ptr, 0, 0)
  var i = 1
  while i <= 10
    old = load(sum_ptr, 0)
    store(sum_ptr, 0, old + i)
    i = i + 1
  end
  return load(sum_ptr, 0)
end

def mem_set_value(ptr: Int, val: Int): Int
  store(ptr, 0, val)
  return 0
end

def mem_pass_ptr(): Int
  ptr = mem_alloc(1)
  mem_set_value(ptr, 42)
  return load(ptr, 0)
end

def mem_make_pair(a: Int, b: Int): Int
  ptr = mem_alloc(2)
  store(ptr, 0, a)
  store(ptr, 1, b)
  return ptr
end

def mem_return_ptr(): Int
  pair = mem_make_pair(10, 32)
  return load(pair, 0) + load(pair, 1)
end

def mem_increment(ptr: Int): Int
  val = load(ptr, 0)
  store(ptr, 0, val + 1)
  return 0
end

def mem_modify_ptr(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, 41)
  mem_increment(ptr)
  return load(ptr, 0)
end

def mem_large_offset(): Int
  ptr = mem_alloc(100)
  store(ptr, 99, 42)
  return load(ptr, 99)
end

def mem_negative(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, -42)
  val = load(ptr, 0)
  return -val
end

def mem_zero(): Int
  ptr = mem_alloc(1)
  store(ptr, 0, 0)
  return load(ptr, 0)
end

def mem_booleans(): Int
  ptr = mem_alloc(2)
  store(ptr, 0, 1)
  store(ptr, 1, 0)
  a = load(ptr, 0)
  b = load(ptr, 1)
  if a and (b == 0)
    return 42
  else
    return 0
  end
end

def mem_linked_node(): Int
  node = mem_alloc(2)
  store(node, 0, 42)
  store(node, 1, 0)
  return load(node, 0)
end

def mem_two_node(): Int
  node1 = mem_alloc(2)
  node2 = mem_alloc(2)
  store(node2, 0, 32)
  store(node2, 1, 0)
  store(node1, 0, 10)
  store(node1, 1, node2)
  val1 = load(node1, 0)
  next_ptr = load(node1, 1)
  val2 = load(next_ptr, 0)
  return val1 + val2
end

def mem_array_prefix(): Int
  arr = mem_alloc(4)
  store(arr, 0, 3)
  store(arr, 1, 10)
  store(arr, 2, 20)
  store(arr, 3, 12)
  len = load(arr, 0)
  var sum = 0
  var i = 0
  while i < len
    sum = sum + load(arr, i + 1)
    i = i + 1
  end
  return sum
end
