## Multi-line Function Signature Tests
##
## Contract:
##   1. Parameters can span multiple lines inside parentheses
##   2. Return type annotation can be on next line after )
##   3. Type annotation after : can be on next line
##   4. Endless def with multi-line params works
##   5. Single-line signatures still work (regression check)

import * from qspec

# -- Multi-line parameter list --

def ml_add(
  a: Int,
  b: Int
): Int
  return a + b
end

# -- Return type on next line after ) --

def ml_multiply(x: Int, y: Int)
  : Int
  return x * y
end

# -- Complex: params + return type multi-line --

def ml_compute(
  x: Int,
  y: Int,
  z: Int
)
  : Int
  return x * y + z
end

# -- Endless def with multi-line params --

def ml_sum(
  a: Int,
  b: Int
): Int = a + b

# -- Single-line still works (regression) --

def ml_double(n: Int): Int = n * 2

# -- Trailing comma --

def ml_max(
  a: Int,
  b: Int,
): Int
  if a > b
    return a
  end
  return b
end

# -- Helpers for testing --

def test_add(): Int = ml_add(3, 4)
def test_multiply(): Int = ml_multiply(5, 6)
def test_compute(): Int = ml_compute(2, 3, 4)
def test_sum(): Int = ml_sum(10, 20)
def test_double(): Int = ml_double(7)
def test_max(): Int = ml_max(42, 17)

def main(): Int
  describe("multi-line function signatures") do ->
    it("multi-line parameter list") do ->
      assert_eq(test_add(), 7)
    end

    it("return type on next line") do ->
      assert_eq(test_multiply(), 30)
    end

    it("complex multi-line params + return") do ->
      assert_eq(test_compute(), 10)
    end

    it("endless def with multi-line params") do ->
      assert_eq(test_sum(), 30)
    end

    it("single-line still works (regression)") do ->
      assert_eq(test_double(), 14)
    end

    it("trailing comma in parameter list") do ->
      assert_eq(test_max(), 42)
    end
  end

  return qspec_main()
end
