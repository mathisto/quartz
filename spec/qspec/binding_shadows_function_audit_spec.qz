## Regression: name-binding-introduction sites must register the binding
## (mir_ctx_alloc_slot + mir_ctx_bind_var) BEFORE lowering the body, so a
## same-named free function in scope is shadowed by the binding.
##
## These are siblings of the enum-payload miscompile (mir.qz
## mir_ctx_apply_pending_bind, fixed 30d37c96): each site emitted a
## STORE_VAR for the bound name but never called mir_ctx_bind_var. In the
## body the NODE_IDENT lowering's mir_ctx_lookup_var(name) missed and fell
## through to mir_lookup_function(name), emitting `ptrtoint @name` — a
## FUNCTION POINTER where the bound value was expected (silent miscompile,
## garbage/SIGSEGV).
##
## Sites fixed:
##   - match-EXPR wildcard-with-guard binding   (mir_lower_expr_handlers.qz)
##   - match-STMT wildcard-with-guard binding   (mir_lower_stmt_handlers.qz)
##   - try/catch error-payload binding          (mir_lower_expr_handlers.qz)

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binding-introduction sites shadow same-named free functions") do ->
    it("match-EXPR wildcard-with-guard binding returns the subject, not a func ref") do ->
      assert_run_stdout_eq("""
def n(): Int = 999

def classify(x: Int): Int
  var r = match x
    0 => 0
    n if n > 5 => n
    _ => 1
  end
  return r
end

def main(): Int
  puts(str_from_int(classify(42)))
  return 0
end
""", "42\n")
    end

    it("match-STMT wildcard-with-guard binding prints the subject, not a func ref") do ->
      assert_run_stdout_eq("""
def n(): Int = 999

def classify(x: Int): Void
  match x
    0 => puts("zero")
    n if n > 5 => puts(str_from_int(n))
    _ => puts("small")
  end
end

def main(): Int
  classify(42)
  return 0
end
""", "42\n")
    end

    it("try/catch error binding returns the payload, not a func ref") do ->
      assert_run_stdout_eq("""
def e(): Int = 777

def risky(flag: Int): Result<Int, Int>
  return Result::Err(55) if flag == 0
  return Result::Ok(99)
end

def run(flag: Int): Int
  var v = try risky(flag) catch e e
  return v
end

def main(): Int
  puts(str_from_int(run(0)))
  return 0
end
""", "55\n")
    end
  end

  return qspec_main()
end
