## F4 item-44b regression — single-field (fc=1) @value struct stored in a Vec.
##
## A 1-field value-layout struct was excluded from the Vec INLINE-storage path
## (cg_vec_inline_field_count / cg_idx_inline_field_count gated `fc <= 1`), so its
## element was stored BOXED as a pointer to the construction temp (a stack alloca),
## which DANGLES once the Vec escapes the construction scope → garbage / SIGSEGV on
## read. Multi-field (fc>1) value structs were already stored inline. This aligns
## fc=1 with the rest of the value-layout machinery (mir_is_value_layout_type has no
## fc<=1 exclusion). These cases SIGSEGV on the pre-fix compiler.

import * from qspec

@value
struct SfCell
  r: Int
end

@value
struct SfNarrow
  x: I32
end

@value
struct SfPair
  a: Int
  b: Int
end

trait SfArea
  def area(self): Int
    return 0
  end
end

extend SfCell with SfArea
  def area(self): Int = @r * @r
end

def mk(): Vec<SfCell>
  var v = vec_new<SfCell>()
  v.push(SfCell { r: 3 })
  v.push(SfCell { r: 4 })
  v.push(SfCell { r: 5 })
  return v
end

# cross-function for-in + trait method on a single-field @value element
def sum_area(v: Vec<SfCell>): Int
  var s = 0
  for i in 0..v.size
    s += v[i].area()
  end
  return s
end

# cross-function for-in + field read
def sum_field(v: Vec<SfCell>): Int
  var s = 0
  for i in 0..v.size
    s += v[i].r
  end
  return s
end

# cross-function binding for-in
def sum_forin(v: Vec<SfCell>): Int
  var s = 0
  for c in v
    s += c.r
  end
  return s
end

def x_method(): Int
  return sum_area(mk())
end

def x_field(): Int
  return sum_field(mk())
end

def x_forin(): Int
  return sum_forin(mk())
end

def x_map(): Int
  var v = mk()
  var m = v.map(c -> c.r * 10)
  return m[0] + m[1] + m[2]
end

def x_arr_lit(): Int
  var v = [SfCell { r: 7 }, SfCell { r: 8 }]
  return v[0].r + v[1].r
end

def x_narrow(): Int
  var v = vec_new<SfNarrow>()
  v.push(SfNarrow { x: 11 })
  v.push(SfNarrow { x: 22 })
  return v[0].x + v[1].x
end

# item 44c — value-layout Vec element STORE (vec[i] = x) must go inline, not boxed.
def x_set_fc1(): Int
  var v = vec_new<SfCell>()
  v.push(SfCell { r: 1 })
  v.push(SfCell { r: 2 })
  v[0] = SfCell { r: 9 }
  return v[0].r * 10 + v[1].r
end

def x_set_fc2(): Int
  var v = vec_new<SfPair>()
  v.push(SfPair { a: 1, b: 2 })
  v.push(SfPair { a: 3, b: 4 })
  v[1] = SfPair { a: 7, b: 8 }
  return v[0].a * 1000 + v[0].b * 100 + v[1].a * 10 + v[1].b
end

def x_pop_fc2(): Int
  var v = vec_new<SfPair>()
  v.push(SfPair { a: 1, b: 2 })
  v.push(SfPair { a: 5, b: 6 })
  match v.pop()
    Some(c) => return c.a * 10 + c.b
    None => return -1
  end
end

def main(): Int
  describe("single-field @value Vec element (item 44b)") do ->
    it("cross-fn for-in trait method") do ->
      assert_eq(x_method(), 50)
    end
    it("cross-fn for-in field read") do ->
      assert_eq(x_field(), 12)
    end
    it("cross-fn for-in binding") do ->
      assert_eq(x_forin(), 12)
    end
    it("map over single-field element") do ->
      assert_eq(x_map(), 120)
    end
    it("array-literal single-field element") do ->
      assert_eq(x_arr_lit(), 15)
    end
    it("narrow single-field element") do ->
      assert_eq(x_narrow(), 33)
    end
    it("store single-field element (vec[i]=x)") do ->
      assert_eq(x_set_fc1(), 92)
    end
    it("store multi-field element (vec[i]=x)") do ->
      assert_eq(x_set_fc2(), 1278)
    end
    it("pop multi-field element") do ->
      assert_eq(x_pop_fc2(), 56)
    end
  end

  return qspec_main()
end
