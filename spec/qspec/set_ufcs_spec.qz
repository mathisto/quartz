## Set Ufcs Tests
##
## Contract:
##   1. S.add(x) adds element.
##   2. S.add(x) does not add.
##   3. S.clear() ufcs.
##   4. S.delete(x) ufcs.
##   5. S.empty? ufcs predicate.
##   6. S.has(x) ufcs.
import * from qspec

def main(): Int
  describe("set UFCS methods") do ->
    it("s.add(x) adds element") do ->
      s = set_new()
      s.add(42)
      s.add(99)
      assert_eq(set_size(s), 2)
    end
    it("s.add(x) does not add duplicate") do ->
      s = set_new()
      s.add(1)
      s.add(1)
      s.add(1)
      assert_eq(set_size(s), 1)
    end
    it("set_delete removes element") do ->
      var s = {1, 2, 3}
      set_delete(s, 2)
      assert_eq(set_size(s), 2)
    end
    it("set_delete is no-op for non-existent") do ->
      var s = {1, 2, 3}
      set_delete(s, 99)
      assert_eq(set_size(s), 3)
    end
    it("set_has returns 1 if element exists") do ->
      var s = {1, 2, 3}
      assert_eq(set_has(s, 2), 1)
    end
    it("set_has returns 0 if element absent") do ->
      var s = {1, 2, 3}
      assert_eq(set_has(s, 99), 0)
    end
    it("set_has on larger set") do ->
      var s = {10, 20, 30}
      assert_eq(set_has(s, 20), 1)
    end
    it("set_size returns set size") do ->
      var s = {1, 2, 3, 4, 5}
      assert_eq(set_size(s), 5)
    end
    it("set_size returns 0 for empty set") do ->
      s = set_new()
      assert_eq(set_size(s), 0)
    end
    it("set_clear empties set") do ->
      var s = {1, 2, 3}
      set_clear(s)
      assert_eq(set_size(s), 0)
    end
    it("set_members returns vec of elements") do ->
      assert_eq(set_members_test(), 1)
    end
    it("s.delete(x) UFCS") do ->
      var s = set_new()
      s.add(1)
      s.add(2)
      s.add(3)
      s.delete(2)
      assert_eq(set_size(s), 2)
      assert_eq(set_has(s, 2), 0)
    end
    it("s.has(x) UFCS") do ->
      var s = set_new()
      s.add(42)
      assert_eq(s.has(42), 1)
      assert_eq(s.has(99), 0)
    end
    it("s.size() UFCS") do ->
      var s = set_new()
      s.add(1)
      s.add(2)
      s.add(3)
      assert_eq(s.size(), 3)
    end
    it("s.clear() UFCS") do ->
      var s = set_new()
      s.add(1)
      s.add(2)
      s.add(3)
      s.clear()
      assert_eq(set_size(s), 0)
    end
    it("s.members() UFCS") do ->
      assert_eq(set_members_ufcs_test(), 1)
    end
    it("s.empty? UFCS predicate") do ->
      assert_eq(set_empty_new(), 1)
    end
    # R3.4 regression: backing store grows/rehashes past the old fixed
    # initial capacity (16) instead of writing out of bounds.
    it("grows past initial capacity without OOB (200 distinct)") do ->
      assert_eq(set_grow_200(), 200)
    end
    it("dedups past initial capacity") do ->
      assert_eq(set_dedup_past_cap(), 100)
    end
    it("has() correct for all elements past capacity") do ->
      assert_eq(set_has_all_past_cap(), 1)
    end
    it("stores element value 0 and 1 (no sentinel collision)") do ->
      var s = set_new()
      s.add(0)
      s.add(1)
      assert_eq(set_has(s, 0), 1)
      assert_eq(set_has(s, 1), 1)
      assert_eq(set_has(s, 2), 0)
      assert_eq(set_size(s), 2)
    end
    it("clear then reuse does not resurrect old members") do ->
      var s = set_new()
      var i = 0
      while i < 50
        s.add(i)
        i = i + 1
      end
      set_clear(s)
      assert_eq(set_size(s), 0)
      assert_eq(set_has(s, 7), 0)
      s.add(7)
      assert_eq(set_has(s, 7), 1)
      assert_eq(set_has(s, 8), 0)
      assert_eq(set_size(s), 1)
    end
  end
  return qspec_main()
end

def set_grow_200(): Int
  var s = set_new()
  var i = 0
  while i < 200
    s.add(i)
    i = i + 1
  end
  return set_size(s)
end

def set_dedup_past_cap(): Int
  var s = set_new()
  var round = 0
  while round < 3
    var i = 0
    while i < 100
      s.add(i)
      i = i + 1
    end
    round = round + 1
  end
  return set_size(s)
end

def set_has_all_past_cap(): Int
  var s = set_new()
  var i = 0
  while i < 150
    s.add(i * 3)
    i = i + 1
  end
  var ok = 1
  var j = 0
  while j < 150
    if set_has(s, j * 3) != 1
      ok = 0
    end
    if set_has(s, j * 3 + 1) != 0
      ok = 0
    end
    j = j + 1
  end
  return ok
end

def set_members_test(): Int
  var s = {10, 20, 30}
  var members = set_members(s)
  if members.size == 3
    return 1
  end
  return 0
end

def set_members_ufcs_test(): Int
  var s = set_new()
  s.add(10)
  s.add(20)
  s.add(30)
  var members = s.members()
  if members.size == 3
    return 1
  end
  return 0
end

def set_empty_new(): Int
  s = set_new()
  if s.empty?
    return 1
  end
  return 0
end
