## Set Literals Tests
##
## Contract:
##   1. Adds new element to.
##   2. Creates empty set with.
##   3. Creates set with multiple.
##   4. Creates set with single.
##   5. Deduplicates elements during creation.
##   6. Does not add duplicate.
import * from qspec

def main(): Int
  describe("set literals") do ->
    it("creates empty set with set_new") do ->
      s = set_new()
      assert_eq(set_size(s), 0)
    end
    it("creates set with single element") do ->
      s = {42}
      assert_eq(set_size(s), 1)
    end
    it("creates set with multiple elements") do ->
      s = {1, 2, 3}
      assert_eq(set_size(s), 3)
    end
    it("deduplicates elements during creation") do ->
      s = {1, 2, 1, 3, 2, 1}
      assert_eq(set_size(s), 3)
    end
    it("finds element in set") do ->
      s = {10, 20, 30}
      if set_has(s, 20)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
    it("returns false for missing element") do ->
      s = {10, 20, 30}
      if set_has(s, 99)
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end
    it("adds new element to literal set") do ->
      s = {1, 2}
      set_add(s, 3)
      assert_eq(set_size(s), 3)
    end
    it("does not add duplicate element") do ->
      s = {1, 2, 3}
      set_add(s, 2)
      assert_eq(set_size(s), 3)
    end
    it("removes element from set") do ->
      s = {1, 2, 3}
      set_delete(s, 2)
      assert_eq(set_size(s), 2)
    end
    it("delete is no-op for non-existent element") do ->
      s = {1, 2, 3}
      set_delete(s, 99)
      assert_eq(set_size(s), 3)
    end
    it("passes set literal to function") do ->
      assert_eq(sl_count({1, 2, 3, 4, 5}), 5)
    end
    it("returns set literal from function") do ->
      s = sl_make()
      assert_eq(set_size(s), 3)
    end
    it("includes variables in set literal") do ->
      x = 10
      y = 20
      s = {x, y, 30}
      assert_eq(set_size(s), 3)
    end
  end
  return qspec_main()
end
def sl_count(s: Int): Int = set_size(s)
def sl_make(): Int = {10, 20, 30}
