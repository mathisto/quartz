## Regression tests for B4 — `step!` (macro $unwrap) inside a `while` loop
## when `step` is reassigned each iteration.
##
## HISTORY: The April 2026 impl Trait sprint flagged "is Some + ! unwrap
## inside while loop miscompile" as a pending bug. Empirical behavior
## confirmed April 14, 2026:
##
##   var step = Option::Some(10)
##   var sum = 0
##   var i = 0
##   while i < 3
##     sum += step!              # ← miscompiles
##     step = Option::Some(i+100)
##     i += 1
##   end
##
## Expected sum=211. Observed sum=0 (constant) — `step!` isn't loading
## from step's slot at all; the MIR match lowering substitutes a cached
## constant for the match result.
##
## Workarounds that ALL work:
##   - Explicit match: `var v = match step { Some(x) => x; None => 0; end }`
##   - Inline explicit match: `sum += match step { Some(x) => x; ... end }`
##   - No loop: `var a = step!; step = ...; var b = step!`
##
## The bug is SPECIFICALLY: (1) the `$unwrap` macro expansion (2) inside a
## `while` loop body (3) with the subject reassigned each iteration. Any
## one of those three missing and it works.
##
## Diagnosis so far:
##   - The `$unwrap` macro in `macro_expand.qz:1220` expands to a 3-arm
##     match: `Some(gensym) => gensym; None => panic; _ => panic`.
##   - Same shape written manually (or via explicit qualified match) works.
##   - The macro uses `payloads = vec_new()` where the parser uses `0`
##     (sentinel). Changing the macro to use `0` did NOT fix it.
##   - Wrapping the match subject in a `var subj = expr` block did NOT fix
##     it either — suggesting the bug is deeper than subject caching.
##
## Filed as B4-UNWRAP-IN-LOOP in ROADMAP for a dedicated future session.
## The match-lowering path for macro-generated matches needs a thorough
## comparison against the parser-generated match path at the MIR level.
##
## This spec locks in what currently works so nothing regresses further,
## and `it_pending` documents the broken case so the bug is visible.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("unwrap (!) semantics") do ->

    it("step! outside a loop with reassignment works") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(10)
          var a = step!
          step = Option::Some(20)
          var b = step!
          return 0 if a == 10 and b == 20
          return 1
        end
        """, 0)
    end

    it("explicit match in loop body with reassignment works") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(10)
          var sum = 0
          var i = 0
          while i < 3
            sum += match step
              Option::Some(x) => x
              Option::None => 0
            end
            step = Option::Some(i + 100)
            i += 1
          end
          return 0 if sum == 211
          return 1
        end
        """, 0)
    end

    it("inline match (not bound to var) in loop body works") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(10)
          var sum = 0
          var i = 0
          while i < 3
            sum += match step
              Option::Some(x) => x
              Option::None => 0
            end
            step = Option::Some(i + 100)
            i += 1
          end
          return 0 if sum == 211
          return 1
        end
        """, 0)
    end

    it("step! inside while loop with reassignment (B4-UNWRAP-IN-LOOP)") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(10)
          var sum = 0
          var i = 0
          while i < 3
            sum += step!
            step = Option::Some(i + 100)
            i += 1
          end
          return 0 if sum == 211
          return 1
        end
        """, 0)
    end

    it("step! inside for loop with reassignment") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(1)
          var sum = 0
          for i in 0..3
            sum += step!
            step = Option::Some(i + 10)
          end
          return 0 if sum == 1 + 10 + 11
          return 1
        end
        """, 0)
    end

    it("step! inside nested while loops") do ->
      assert_run_exits("""
        def main(): Int
          var step = Option::Some(5)
          var sum = 0
          var i = 0
          while i < 2
            var j = 0
            while j < 2
              sum += step!
              j += 1
            end
            step = Option::Some(step! + 10)
            i += 1
          end
          return 0 if sum == 30
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
