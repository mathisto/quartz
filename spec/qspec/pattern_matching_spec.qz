## Pattern Matching Tests
##
## Contract:
##   1. Enum matching: each variant dispatches to correct arm.
##   2. Wildcard pattern: `_` catches unmatched variants.
##   3. Match as expression: match result usable as value.
##   4. Integer matching: literal integer patterns.
##   5. Match in functions: callable with match inside.
##   6. Multiple enums: separate namespaces, combinable.
##   7. Nested match: match inside if, match result as fn arg.
##   8. Match with Option: payload destructuring.
##   9. Sequential arms: first matching arm wins.

import * from qspec

enum PMColor
  Red
  Green
  Blue
end

enum PMStatus
  Ok
  Error
  Unknown
end

enum PMDirection
  North
  South
  East
  West
end

enum PMSize
  Small
  Medium
  Large
end

enum PMLevel
  Low
  High
end

def main(): Int
  describe("basic enum matching") do ->
    it("matches first variant") do ->
      assert_eq(pm_color_match(PMColor::Red), 1)
    end

    it("matches second variant") do ->
      assert_eq(pm_color_match(PMColor::Green), 2)
    end

    it("matches third variant") do ->
      assert_eq(pm_color_match(PMColor::Blue), 3)
    end
  end

  describe("wildcard pattern") do ->
    it("matches wildcard when no other pattern matches") do ->
      assert_eq(pm_status_match(PMStatus::Unknown), 99)
    end

    it("does not match wildcard when earlier pattern matches") do ->
      assert_eq(pm_status_ok(PMStatus::Ok), 1)
    end

    it("uses wildcard as catch-all") do ->
      assert_eq(pm_direction_north(PMDirection::West), 0)
    end
  end

  describe("match as expression") do ->
    it("returns value from match arm") do ->
      assert_eq(pm_color_expr(PMColor::Red), 1)
      assert_eq(pm_color_expr(PMColor::Green), 2)
      assert_eq(pm_color_expr(PMColor::Blue), 3)
    end

    it("uses match result in arithmetic") do ->
      assert_eq(pm_size_expr(PMSize::Small), 10)
      assert_eq(pm_size_expr(PMSize::Medium), 20)
      assert_eq(pm_size_expr(PMSize::Large), 30)
    end
  end

  describe("integer matching") do ->
    it("matches integer literal") do ->
      assert_eq(pm_int_match(2), 20)
    end

    it("matches zero") do ->
      assert_eq(pm_int_zero(0), 1)
    end

    it("falls through to wildcard for unmatched integer") do ->
      assert_eq(pm_int_wildcard(42), 99)
    end
  end

  describe("match in functions") do ->
    it("uses match in helper function") do ->
      assert_eq(pm_color_value(PMColor::Blue), 2)
    end

    it("returns match expression from function") do ->
      assert_eq(pm_color_expr(PMColor::Red), 1)
      assert_eq(pm_color_expr(PMColor::Blue), 3)
    end
  end

  describe("complex scenarios") do ->
    it("handles multiple enums in same function") do ->
      assert_eq(pm_multi_enum(PMColor::Red, PMSize::Small), 11)
      assert_eq(pm_multi_enum(PMColor::Blue, PMSize::Large), 33)
    end

    it("nests match inside if") do ->
      assert_eq(pm_nested_match(1, PMStatus::Ok), 10)
    end

    it("uses match result as function argument") do ->
      assert_eq(pm_match_arg(PMLevel::Low), 20)
      assert_eq(pm_match_arg(PMLevel::High), 200)
    end
  end

  # ===========================================================================
  # Option payload destructuring
  # ===========================================================================
  describe("Option destructuring in match") do ->
    it("destructures Some payload") do ->
      opt = Option::Some(42)
      val = match opt
        Some(x) => x
        None => 0
      end
      assert_eq(val, 42)
    end

    it("matches None variant") do ->
      opt = Option::None
      val = match opt
        Some(x) => x
        None => 99
      end
      assert_eq(val, 99)
    end
  end

  # ===========================================================================
  # Sequential arm ordering (first match wins)
  # ===========================================================================
  describe("arm ordering") do ->
    it("first matching arm wins over later wildcard") do ->
      assert_eq(pm_first_wins(1), 10)
      assert_eq(pm_first_wins(99), 0)
    end
  end

  # ===========================================================================
  # Match returning different value per variant
  # ===========================================================================
  describe("match value dispatch") do ->
    it("maps all 4 direction variants to distinct values") do ->
      assert_eq(pm_direction_value(PMDirection::North), 1)
      assert_eq(pm_direction_value(PMDirection::South), 2)
      assert_eq(pm_direction_value(PMDirection::East), 3)
      assert_eq(pm_direction_value(PMDirection::West), 4)
    end
  end

  return qspec_main()
end

def pm_color_match(c: PMColor): Int
  match c
    PMColor::Red => return 1
    PMColor::Green => return 2
    PMColor::Blue => return 3
  end
end

def pm_status_match(s: PMStatus): Int
  match s
    PMStatus::Ok => return 1
    PMStatus::Error => return 2
    _ => return 99
  end
end

def pm_status_ok(s: PMStatus): Int
  match s
    PMStatus::Ok => return 1
    _ => return 99
  end
end

def pm_direction_north(d: PMDirection): Int
  match d
    PMDirection::North => return 1
    _ => return 0
  end
end

def pm_color_expr(c: PMColor): Int
  var result = match c
    PMColor::Red => 1
    PMColor::Green => 2
    PMColor::Blue => 3
  end
  return result
end

def pm_size_expr(s: PMSize): Int
  var base = match s
    PMSize::Small => 1
    PMSize::Medium => 2
    PMSize::Large => 3
  end
  return base * 10
end

def pm_int_match(x: Int): Int
  match x
    1 => return 10
    2 => return 20
    3 => return 30
    _ => return 0
  end
  return 99
end

def pm_int_zero(x: Int): Int
  match x
    0 => return 1
    _ => return 0
  end
  return 99
end

def pm_int_wildcard(x: Int): Int
  match x
    1 => return 10
    2 => return 20
    _ => return 99
  end
  return 0
end

def pm_color_value(c: PMColor): Int
  match c
    PMColor::Red => return 0
    PMColor::Green => return 1
    PMColor::Blue => return 2
  end
end

def pm_multi_enum(c: PMColor, s: PMSize): Int
  var cv = match c
    PMColor::Red => 1
    PMColor::Green => 2
    PMColor::Blue => 3
  end
  var sv = match s
    PMSize::Small => 1
    PMSize::Medium => 2
    PMSize::Large => 3
  end
  return cv * 10 + sv
end

def pm_nested_match(flag: Int, s: PMStatus): Int
  if flag
    match s
      PMStatus::Ok => return 10
      PMStatus::Error => return 20
      PMStatus::Unknown => return 30
    end
  end
  return 0
end

def pm_match_arg(lvl: PMLevel): Int
  var val = match lvl
    PMLevel::Low => 10
    PMLevel::High => 100
  end
  return pm_double(val)
end

def pm_double(x: Int): Int
  return x * 2
end

def pm_first_wins(x: Int): Int
  match x
    1 => return 10
    2 => return 20
    _ => return 0
  end
end

def pm_direction_value(d: PMDirection): Int
  return match d
    PMDirection::North => 1
    PMDirection::South => 2
    PMDirection::East => 3
    PMDirection::West => 4
  end
end
