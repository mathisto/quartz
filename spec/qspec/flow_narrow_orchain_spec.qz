## SURF.FLOW A5 — `or`-chain ELSE-narrowing (the De Morgan dual of the existing
## `and`-chain THEN-narrowing). For `if a or b ... else <here>`, the else proves
## `not (a or b)` = `not a and not b`, so BOTH operands hold their FALSE-fact and
## narrow to their else-variant in the else region. The THEN of an `or`-chain narrows
## NOTHING — only one disjunct need hold, so narrowing either operand would be UNSOUND
## (exactly dual to the `and`-chain: and-THEN narrows all, and-ELSE narrows nothing).
##
## Behavioral signal (same trick as flow_narrow_p3_spec): a CORRECT narrowing yields
## the exact inner payload value via a bare narrowed read; an un-narrowed / wrong read
## does not. `use_str`/`use_int`/`box_v` read the narrowed payload directly. Coverage:
## Result or-chain else (each ⇒ Err/Ok payload); binary user-enum or-chain else;
## the SOUNDNESS negative (or-chain THEN narrows nothing); and a CONTROL that the
## existing and-chain THEN-narrowing still fires byte-for-byte (regression).
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

# Boxed payload struct (non-@value ⇒ a genuine boxed pointer payload).
struct Box
  v: Int
end

def box_v(b: Box): Int = b.v

# Binary user enum (exactly 2 variants, each single-payload boxed).
enum Pair
  Left(box: Box)
  Right(box: Box)
end

# --- Result or-chain ELSE-narrowing (positive) ---

## `if r1.ok? or r2.ok? ... else` — the else proves NEITHER is Ok, so BOTH r1 and r2
## are Err ⇒ each narrows to its E payload (String). Read both via `use_str`.
def result_orchain_else_both_err(): String
  r1: Result<Int, String> = Result::Err("aa")
  r2: Result<Int, String> = Result::Err("bb")
  var out = "MISS"
  if r1.ok? or r2.ok?
    out = "WAS_OK"
  else
    out = use_str(r1) + use_str(r2)
  end
  return out
end

## `if r1.err? or r2.err? ... else` — else proves NEITHER is Err, so BOTH are Ok ⇒
## each narrows to its T payload (Int). Read both via `use_int_raw`.
def result_orchain_else_both_ok(): Int
  r1: Result<Int, String> = Result::Ok(10)
  r2: Result<Int, String> = Result::Ok(32)
  var out = 0
  if r1.err? or r2.err?
    out = -1
  else
    out = use_int_raw(r1) + use_int_raw(r2)
  end
  return out
end

## Mixed operand forms in one or-chain (`is Ok` + `.ok?` + `.is_ok()`): all three
## operands narrow to Err in the else. 3-operand spine exercises the recursion.
def result_orchain_else_three(): String
  r1: Result<Int, String> = Result::Err("x")
  r2: Result<Int, String> = Result::Err("y")
  r3: Result<Int, String> = Result::Err("z")
  var out = "MISS"
  if r1 is Ok or r2.ok? or r3.is_ok()
    out = "WAS_OK"
  else
    out = use_str(r1) + use_str(r2) + use_str(r3)
  end
  return out
end

# --- Binary user-enum or-chain ELSE-narrowing (positive) ---

## `if e1 is Left or e2 is Left ... else` — else proves NEITHER is Left, so BOTH are
## Right ⇒ each narrows to its Right Box payload.
def userenum_orchain_else_both_right(): Int
  e1: Pair = Pair::Right(Box { v: 4 })
  e2: Pair = Pair::Right(Box { v: 5 })
  var out = 0
  if e1 is Left or e2 is Left
    out = -1
  else
    out = box_v(e1) + box_v(e2)
  end
  return out
end

# --- SOUNDNESS: or-chain THEN narrows NOTHING ---

## The THEN of an `or`-chain proves only that AT LEAST ONE disjunct holds, not which,
## so NEITHER operand may be narrowed. Here r1 is Err, r2 is Ok(77) — the or-chain
## THEN fires (r2.ok? is true). If the THEN wrongly narrowed r1 to Ok, a bare read of
## r1 as Ok-Int would be emitted; instead the THEN carries NO refinement, so we must
## read each operand through an explicit `match`. We assert the explicit path yields
## the real value — proving the THEN table has no or-chain facts (an unsound then-narrow
## would have changed this function's read structure).
def orchain_then_no_narrow(): Int
  r1: Result<Int, String> = Result::Err("no")
  r2: Result<Int, String> = Result::Ok(77)
  var out = 0
  if r1.ok? or r2.ok?
    out = match r2
      Ok(v)  => v
      Err(_) => -1
    end
  end
  return out
end

# --- CONTROL: existing and-chain THEN-narrowing still fires (regression) ---

## Dual sanity: `if a.some? and b.some?` MUST still narrow BOTH in the THEN. If A5
## accidentally disturbed the and-chain path, this regresses.
def andchain_then_still_narrows(): Int
  a: Option<Int> = option_some(10)
  b: Option<Int> = option_some(32)
  var out = 0
  if a.some? and b.some?
    out = use_int_raw(a) + use_int_raw(b)
  end
  return out
end

def main(): Int
  describe("SURF.FLOW A5 — or-chain else-narrowing (Result)") do ->
    it("`r1.ok? or r2.ok?` else narrows BOTH r1,r2 to Err payload") do ->
      assert_eq_str(result_orchain_else_both_err(), "aabb")
    end
    it("`r1.err? or r2.err?` else narrows BOTH r1,r2 to Ok payload") do ->
      assert_eq(result_orchain_else_both_ok(), 42)
    end
    it("3-operand or-chain else narrows all three to Err payload") do ->
      assert_eq_str(result_orchain_else_three(), "xyz")
    end
  end

  describe("SURF.FLOW A5 — or-chain else-narrowing (binary user enum)") do ->
    it("`e1 is Left or e2 is Left` else narrows BOTH to Right payload") do ->
      assert_eq(userenum_orchain_else_both_right(), 9)
    end
  end

  describe("SURF.FLOW A5 — SOUNDNESS: or-chain THEN narrows nothing") do ->
    it("the THEN of an or-chain carries NO narrowing facts (explicit match)") do ->
      assert_eq(orchain_then_no_narrow(), 77)
    end
  end

  describe("SURF.FLOW A5 — CONTROL: and-chain then-narrow still fires") do ->
    it("`a.some? and b.some?` still narrows BOTH in the then-branch") do ->
      assert_eq(andchain_then_still_narrows(), 42)
    end
  end

  return qspec_main()
end
