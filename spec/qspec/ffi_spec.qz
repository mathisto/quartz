## Ffi Tests
##
## Contract:
##   1. FFI Basic.
##   2. FFI Memory.
##   3. FFI Strings.
##   4. FFI Advanced.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("FFI Basic") do ->
    it("extern function declaration compiles") do ->
      assert_compile_succeeds(ffi_basic_extern())
    end

    it("IR contains extern declaration") do ->
      assert_ir_contains(ffi_ir_extern(), "declare i64 @puts(ptr)")
    end

    it("extern with body compiles as C-convention function") do ->
      assert_compile_succeeds(ffi_extern_with_body())
    end

    it("multiple extern declarations compile") do ->
      assert_compile_succeeds(ffi_multi_extern())
    end

    it("extern with CPtr return type compiles") do ->
      assert_compile_succeeds(ffi_cptr_return())
    end

    it("extern with void return compiles") do ->
      assert_compile_succeeds(ffi_void_return())
    end
  end

  describe("FFI Memory") do ->
    it("malloc/free pattern compiles") do ->
      assert_compile_succeeds(ffi_malloc_free())
    end

    it("alloc and free pattern runs") do ->
      assert_run_exits(ffi_alloc_run(), 0)
    end
  end

  describe("FFI Strings") do ->
    it("CPtr string passing compiles") do ->
      assert_compile_succeeds(ffi_cptr_string())
    end

    it("extern strlen compiles") do ->
      assert_compile_succeeds(ffi_strlen())
    end
  end

  describe("FFI Advanced") do ->
    it("extern with Int param compiles") do ->
      assert_compile_succeeds(ffi_int_param())
    end

    it("extern with multiple params compiles") do ->
      assert_compile_succeeds(ffi_multi_params())
    end

    it("extern function called in expression compiles") do ->
      assert_compile_succeeds(ffi_in_expr())
    end

    it("extern var declaration compiles") do ->
      assert_compile_succeeds(ffi_extern_var())
    end

    it("multiple extern in same file compiles") do ->
      assert_compile_succeeds(ffi_many_externs())
    end
  end

  describe("FFI Float ABI (HB-DOG.14)") do ->
    it("F64-returning extern declares as double") do ->
      assert_ir_contains(ffi_f64_sqrt(), "declare double @sqrt(double)")
    end

    it("F64-returning extern call is typed double") do ->
      assert_ir_contains(ffi_f64_sqrt(), "call double (double) @sqrt")
    end

    it("F32-returning extern declares as float") do ->
      assert_ir_contains(ffi_f32_sqrtf(), "declare float @sqrtf(float)")
    end

    it("F64 extern return reads the FP register") do ->
      # to_int(sqrt(16.0)) == 4 — exit code is the result. Before the fix
      # the call read the integer register and the result was garbage.
      assert_run_exits(ffi_f64_sqrt(), 4)
    end

    it("F64 extern args + return round-trip") do ->
      # to_int(pow(2.0, 5.0)) == 32 — declared double params bitcast in.
      assert_run_exits(ffi_f64_pow(), 32)
    end

    it("F32 extern return reads the FP register") do ->
      # to_int(sqrtf(to_f32(81))) == 9
      assert_run_exits(ffi_f32_sqrtf(), 9)
    end
  end

  return qspec_main()
end

def ffi_f64_sqrt(): String
  return "extern \"C\" def sqrt(x: F64): F64\ndef main(): Int\n  return to_int(sqrt(16.0))\nend\n"
end

def ffi_f64_pow(): String
  return "extern \"C\" def pow(b: F64, e: F64): F64\ndef main(): Int\n  return to_int(pow(2.0, 5.0))\nend\n"
end

def ffi_f32_sqrtf(): String
  return "extern \"C\" def sqrtf(x: F32): F32\ndef main(): Int\n  return to_int(sqrtf(to_f32(81)))\nend\n"
end

def ffi_basic_extern(): String
  return "extern \"C\" def puts(s: CPtr): Int\nextern \"C\" def strlen(s: CPtr): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_ir_extern(): String
  return "extern \"C\" def puts(s: CPtr): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_extern_with_body(): String
  return "extern \"C\" def bad(x: Int): Int\n  return x\nend\ndef main(): Int\n  return 0\nend\n"
end

def ffi_multi_extern(): String
  return "extern \"C\" def puts(s: CPtr): Int\nextern \"C\" def strlen(s: CPtr): Int\nextern \"C\" def malloc(size: Int): Int\nextern \"C\" def free(ptr: Int): Void\ndef main(): Int\n  return 0\nend\n"
end

def ffi_cptr_return(): String
  return "extern \"C\" def getenv(name: CPtr): CPtr\ndef main(): Int\n  return 0\nend\n"
end

def ffi_void_return(): String
  return "extern \"C\" def free(ptr: Int): Void\ndef main(): Int\n  return 0\nend\n"
end

def ffi_malloc_free(): String
  return "extern \"C\" def malloc(size: Int): Int\nextern \"C\" def free(ptr: Int): Void\ndef main(): Int\n  return 0\nend\n"
end

def ffi_alloc_run(): String
  return "def main(): Int\n  var p = mem_alloc(64)\n  qz_free(p)\n  return 0\nend\n"
end

def ffi_cptr_string(): String
  return "extern \"C\" def strlen(s: CPtr): Int\nextern \"C\" def puts(s: CPtr): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_strlen(): String
  return "extern \"C\" def strlen(s: CPtr): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_int_param(): String
  return "extern \"C\" def abs(x: Int): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_multi_params(): String
  return "extern \"C\" def write(fd: Int, buf: CPtr, count: Int): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_in_expr(): String
  return "extern \"C\" def abs(x: Int): Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_extern_var(): String
  return "extern var errno: Int\ndef main(): Int\n  return 0\nend\n"
end

def ffi_many_externs(): String
  return "extern \"C\" def puts(s: CPtr): Int\nextern \"C\" def strlen(s: CPtr): Int\nextern \"C\" def malloc(size: Int): Int\nextern \"C\" def free(ptr: Int): Void\nextern \"C\" def abs(x: Int): Int\ndef main(): Int\n  return 0\nend\n"
end
