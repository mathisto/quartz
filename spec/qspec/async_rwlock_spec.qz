import * from qspec

# ============================================================================
# Async RwLock — scheduler-aware reader/writer lock
# ============================================================================

# --- Test 1: Single reader ---
def test_single_read(): Int
  var rw = async_rwlock_new(42)
  var val = async_rwlock_read(rw)
  async_rwlock_read_unlock(rw)
  async_rwlock_free(rw)
  return val
end

# --- Test 2: Multiple concurrent readers ---
def test_multi_read(): Int
  var rw = async_rwlock_new(100)
  # Two simultaneous read locks
  var v1 = async_rwlock_read(rw)
  var v2 = async_rwlock_read(rw)
  async_rwlock_read_unlock(rw)
  async_rwlock_read_unlock(rw)
  async_rwlock_free(rw)
  return v1 + v2
end

# --- Test 3: Write lock ---
def test_write(): Int
  var rw = async_rwlock_new(10)
  var val = async_rwlock_write(rw)
  async_rwlock_write_unlock(rw, val + 5)
  var result = async_rwlock_get(rw)
  async_rwlock_free(rw)
  return result
end

# --- Test 4: Read then write ---
def test_read_write_sequence(): Int
  var rw = async_rwlock_new(0)
  var r1 = async_rwlock_read(rw)
  async_rwlock_read_unlock(rw)
  var w1 = async_rwlock_write(rw)
  async_rwlock_write_unlock(rw, w1 + 10)
  var r2 = async_rwlock_read(rw)
  async_rwlock_read_unlock(rw)
  async_rwlock_free(rw)
  return r2
end

# --- Test 5: Concurrent readers + writer (scheduler) ---
var g_rw5 = 0
var g_read_sum = 0

def reader_task(): Int
  var val = async_rwlock_read(g_rw5)
  atomic_add(g_read_sum, val)
  async_rwlock_read_unlock(g_rw5)
  return 0
end

def writer_task(): Int
  var val = async_rwlock_write(g_rw5)
  async_rwlock_write_unlock(g_rw5, val + 100)
  return 0
end

def test_concurrent(): Int
  g_rw5 = async_rwlock_new(0)
  g_read_sum = atomic_new(0)
  sched_init(4)
  # Writer goes first
  var hw = go writer_task()
  await hw
  # Then readers
  var h1 = go reader_task()
  var h2 = go reader_task()
  var h3 = go reader_task()
  await h1
  await h2
  await h3
  sched_shutdown()
  # Writer set value to 100, all 3 readers read 100 → sum = 300
  var result = atomic_load(g_read_sum)
  async_rwlock_free(g_rw5)
  return result
end

# --- Test 6: Stress — multiple writers ---
var g_rw6 = 0

def write_increment(): Int
  var val = async_rwlock_write(g_rw6)
  async_rwlock_write_unlock(g_rw6, val + 1)
  return 0
end

def test_write_stress(): Int
  g_rw6 = async_rwlock_new(0)
  sched_init(4)
  var n = 20
  var handles = vec_new()
  var i = 0
  while i < n
    handles.push(go write_increment())
    i = i + 1
  end
  i = 0
  while i < n
    await handles[i]
    i = i + 1
  end
  sched_shutdown()
  var result = async_rwlock_get(g_rw6)
  async_rwlock_free(g_rw6)
  return result
end

# --- Main ---

def main(): Int
  describe("async rwlock") do ->
    it("single reader") do ->
      assert_eq(test_single_read(), 42)
    end

    it("multiple concurrent readers") do ->
      assert_eq(test_multi_read(), 200)
    end

    it("write lock + unlock") do ->
      assert_eq(test_write(), 15)
    end

    it("read → write → read sequence") do ->
      assert_eq(test_read_write_sequence(), 10)
    end

    it("concurrent readers + writer") do ->
      assert_eq(test_concurrent(), 300)
    end

    it("write stress: 20 sequential increments") do ->
      assert_eq(test_write_stress(), 20)
    end
  end

  return qspec_main()
end
