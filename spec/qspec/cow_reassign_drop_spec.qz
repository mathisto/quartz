## COW reassign-drop regression — B.10 §14.12.8 (C4 reassign-fix)
##
## A local binding REUSED across two cow-layout @value buffers (or a cow value then
## a non-cow value) in ONE scope must not corrupt drop bookkeeping. Before the fix,
## a bare `e = Big{…}` REBIND of a >16B @value (cow-layout) routed through the same
## mir_lower_stmt_let body as a fresh `var`, which:
##   (a) pushed a SECOND droppable entry for `e` ⇒ scope exit emitted TWO cow_releases
##       both loading e's CURRENT value ⇒ double-free of the new buffer (SIGABRT), and
##   (b) never released the OLD buffer ⇒ leak.
## The fix releases the old cow buffer at the rebind and retargets the single
## droppable entry to the new value, so scope exit releases exactly the current
## buffer once. The crash only surfaced when the function was CALLED MORE THAN ONCE
## (the second invocation hit the corrupted refcount); these tests call each shape
## repeatedly to exercise that path.

import * from qspec

@value
struct Big          # 3 Int = 24B > 16B => cow-layout
  a: Int
  b: Int
  c: Int
end

@value
struct Small        # 2 Int = 16B => inline, non-cow
  x: Int
  y: Int
end

# Reassign across two DIFFERENT cow buffers in one scope.
def reassign_two_cow(): Int
  var e = Big { a: 10, b: 20, c: 30 }
  var saved = e.a + e.b + e.c       # 60
  e = Big { a: 100, b: 200, c: 300 }  # rebind: old buffer released, new tracked
  return saved + e.a + e.b + e.c    # 60 + 600 = 660
end

# Reuse a cow binding as a loop variable across iterations (rebind each pass).
def reassign_loop_cow(): Int
  var total = 0
  var i = 0
  var e = Big { a: 1, b: 1, c: 1 }
  while i < 4
    e = Big { a: i, b: i, c: i }
    total = total + e.a
    i = i + 1
  end
  return total                       # 0+1+2+3 = 6
end

# A cow read-out bound then reused (read out of a Vec, value semantics retained).
def reassign_after_struct(): Int
  var e = Big { a: 5, b: 6, c: 7 }   # 18
  var first = e.a + e.b + e.c
  e = Big { a: 1, b: 2, c: 3 }       # rebind -> 6
  var second = e.a + e.b + e.c
  return first + second              # 18 + 6 = 24
end

def main(): Int
  describe("COW reassign drop bookkeeping") do ->
    it("reassigns across two cow buffers (computes correctly)") do ->
      assert_eq(reassign_two_cow(), 660)
    end

    it("survives repeated invocation (no double-free / refcount corruption)") do ->
      # Pre-fix this aborted on the SECOND call (corrupted refcount from the
      # first call's double-free). Three calls must all return 660.
      assert_eq(reassign_two_cow() + reassign_two_cow() + reassign_two_cow(), 1980)
    end

    it("reuses a cow binding as a loop variable") do ->
      assert_eq(reassign_loop_cow(), 6)
    end

    it("reuses a cow binding repeatedly across struct rebinds") do ->
      assert_eq(reassign_after_struct(), 24)
    end

    it("loop-reuse is stable across repeated invocation") do ->
      assert_eq(reassign_loop_cow() + reassign_loop_cow(), 12)
    end
  end

  return qspec_main()
end
