import * from qspec
import * from qspec/subprocess

def test_timeout_fires(): Int
  var ch = channel_new(1)
  var result = 0
  select
    case v = recv(ch) => result = v
    case _ = timeout(10) => result = 42
  end
  return result
end

def test_channel_beats_timeout(): Int
  var ch = channel_new(1)
  send(ch, 99)
  var result = 0
  select
    case v = recv(ch) => result = v
    case _ = timeout(5000) => result = -1
  end
  return result
end

def test_timeout_zero(): Int
  var ch = channel_new(1)
  var result = 0
  select
    case v = recv(ch) => result = v
    case _ = timeout(0) => result = 77
  end
  return result
end

def test_timeout_with_default(): Int
  var ch = channel_new(1)
  var result = 0
  select
    case v = recv(ch) => result = v
    default => result = 11
    case _ = timeout(100) => result = 22
  end
  return result
end

def main(): Int
  describe("select timeout") do ->
    it("timeout fires when no channel ready") do ->
      assert_eq(test_timeout_fires(), 42)
    end
    it("ready channel beats long timeout") do ->
      assert_eq(test_channel_beats_timeout(), 99)
    end
    it("timeout(0) fires immediately on empty channel") do ->
      assert_eq(test_timeout_zero(), 77)
    end
    it("default takes priority over timeout") do ->
      assert_eq(test_timeout_with_default(), 11)
    end
  end

  describe("select timeout in go-tasks") do ->
    it("timeout fires in go-task") do ->
      var src = """
        def worker(out: Int): Void
          var ch = channel_new(1)
          var result = 0
          select
            case v = recv(ch) => result = v
            case _ = timeout(10) => result = 42
          end
          send(out, result)
        end
        def main(): Int
          var out = channel_new(1)
          go worker(out)
          var v = recv(out)
          puts(v.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end

    it("channel beats timeout in go-task") do ->
      var src = """
        def worker(ch: Int, out: Int): Void
          var result = 0
          select
            case v = recv(ch) => result = v
            case _ = timeout(5000) => result = -1
          end
          send(out, result)
        end
        def main(): Int
          var ch = channel_new(1)
          var out = channel_new(1)
          send(ch, 99)
          go worker(ch, out)
          var v = recv(out)
          puts(v.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "99\n")
    end

    it("select timeout with multiple recv arms") do ->
      var src = """
        def main(): Int
          var ch1 = channel_new(1)
          var ch2 = channel_new(1)
          var result = 0
          select
            case v = recv(ch1) => result = v
            case v = recv(ch2) => result = v
            case _ = timeout(10) => result = 42
          end
          puts(result.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end

    it("select timeout with send arm") do ->
      var src = """
        def main(): Int
          var ch = channel_new(0)
          var result = 0
          select
            case _ = send(ch, 1) => result = 10
            case _ = timeout(10) => result = 42
          end
          puts(result.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end
  end

  return qspec_main()
end
