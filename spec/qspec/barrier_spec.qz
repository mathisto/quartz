import * from qspec
import * from std/sync/exclusion/barrier
import * from std/sync/composition/go

var g_c = 0
var g_l = 0

def bw(b: Int): Int
  atomic_add(g_c, 1)
  var r = barrier_wait(b)
  if r == 1
    atomic_add(g_l, 1)
  end
  return 0
end

def all_tests(): Int
  g_c = atomic_new(0)
  g_l = atomic_new(0)
  sched_init(4)
  var b = barrier_new(3)
  var h1 = go bw(b)
  var h2 = go bw(b)
  var h3 = go bw(b)
  await h1
  await h2
  await h3
  sched_shutdown()
  var c = atomic_load(g_c)
  var l = atomic_load(g_l)
  if c == 3 and l == 1
    return 1
  end
  return 0
end

def main(): Int
  describe("barrier") do ->
    it("single-thread returns leader") do ->
      var b = barrier_new(1)
      assert_eq(barrier_wait(b), 1)
    end
    it("3-thread sync with 1 leader") do ->
      assert_eq(all_tests(), 1)
    end
  end
  return qspec_main()
end
