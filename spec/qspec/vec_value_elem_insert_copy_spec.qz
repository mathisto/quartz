## Vec value-element insert-copy Tests
##
## Regression for the V2d collection-insert value-copy bug (csv/toml de-erase
## item, 2026-06-26). A `@value` struct pushed into a `Vec<S>` from a helper that
## takes it as a BY-VALUE (decomposed) param re-boxes the element onto the helper's
## OWN stack frame; without the V2d value-copy at the vec_push site the stored
## element is a pointer to that dead frame → dangling → SIGSEGV / garbage on read.
##
## The V2d copy was wrongly coupled to the niche `_ci_value_idx`, which is reset to
## -1 for non-Option/Result element types — so a `Vec<@value-struct>` element insert
## never got copied. Fixed by giving V2d its own `_v2d_value_idx`. This is exactly
## the `csv_document_add_row(doc, row)` / `vec_push(doc.rows, row)` shape that
## SIGSEGV'd under value layout.
##
## Contract:
##   1. A value-struct pushed via a by-value-param helper round-trips correctly.
##   2. The stored element is independent of the helper's stack frame.
##   3. A 1-field value struct (the CsvRow shape) round-trips.
import * from qspec

@value
struct V2dCell
  v: Int
end

@value
struct V2dPair
  a: Int
  b: Int
end

# Push a value-struct received BY VALUE (decomposed param) — the element must be
# value-COPIED into the vec, not stored as a pointer to this frame's re-box.
def add_cell(v: Vec<V2dCell>, c: V2dCell): Void
  vec_push(v, c)
end

def add_pair(v: Vec<V2dPair>, p: V2dPair): Void
  vec_push(v, p)
end

def build_cells(): Vec<V2dCell>
  var v = vec_new<V2dCell>()
  add_cell(v, V2dCell { v: 11 })
  add_cell(v, V2dCell { v: 22 })
  add_cell(v, V2dCell { v: 33 })
  return v
end

def build_pairs(): Vec<V2dPair>
  var v = vec_new<V2dPair>()
  add_pair(v, V2dPair { a: 1, b: 2 })
  add_pair(v, V2dPair { a: 3, b: 4 })
  return v
end

def main(): Int
  describe("vec value-element insert copy") do ->
    it("round-trips a 1-field value struct pushed via by-value helper") do ->
      var v = build_cells()
      assert_eq(vec_size(v), 3)
      var c0 = vec_get(v, 0)
      var c1 = vec_get(v, 1)
      var c2 = vec_get(v, 2)
      assert_eq(c0.v, 11)
      assert_eq(c1.v, 22)
      assert_eq(c2.v, 33)
    end

    it("round-trips a 2-field value struct pushed via by-value helper") do ->
      var v = build_pairs()
      assert_eq(vec_size(v), 2)
      var p0 = vec_get(v, 0)
      var p1 = vec_get(v, 1)
      assert_eq(p0.a, 1)
      assert_eq(p0.b, 2)
      assert_eq(p1.a, 3)
      assert_eq(p1.b, 4)
    end

    it("stored element is independent of a later mutation of the source") do ->
      var v = vec_new<V2dCell>()
      var c = V2dCell { v: 100 }
      add_cell(v, c)
      c.v = 999
      var r = vec_get(v, 0)
      assert_eq(r.v, 100)
    end
  end

  return qspec_main()
end
