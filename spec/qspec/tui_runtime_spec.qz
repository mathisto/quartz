# QSpec coverage for std/tui/runtime data types and contracts.
#
# Per the design memo (docs/design/TUI_RUNTIME.md "Acceptance for v0.1"):
#   - pure update functions
#   - Cmd enum construction
#   - FrameMsg pattern exhaustiveness
#   - program_new defaults to no_recorder
#   - program_with_recorder swaps the hook
#
# Runtime loop (program_run) is dogfood-tested via examples/tui/counter
# and examples/tui/counter_recorder, NOT unit-tested — the loop blocks
# on read(0, ...) and is hard to stub cleanly. The recorder-fires-once
# contract is verified by counter_recorder under piped stdin.

import * from qspec
import std/tui/runtime as tui
import std/terminal

struct St
  n: Int
end

enum Msg
  Inc
  Dec
end

def upd(m: tui::FrameMsg<Msg>, s: St): (St, tui::Cmd<Msg>)
  match m
    tui::FrameMsg::App(am) =>
      match am
        Inc => return (St { n: s.n + 1 }, tui::Cmd::None)
        Dec => return (St { n: s.n - 1 }, tui::Cmd::None)
      end
    _ => return (s, tui::Cmd::None)
  end
end

def vw(s: St): String = "n=#{s.n}"

# Module-level counter for the recorder swap test. Reset before each
# test that uses it.
var _qspec_recorder_calls = 0

def counting_recorder(m: tui::FrameMsg<Msg>): Void
  _qspec_recorder_calls = _qspec_recorder_calls + 1
end

# Closure thunk for Cmd::Run construction tests.
def make_inc_msg(): tui::FrameMsg<Msg>
  return tui::FrameMsg::App(Msg::Inc)
end

# Replay test fixture: build a Vec<FrameMsg<Msg>> from N App(Inc)
# messages followed by an explicit Quit. Replay should walk the count
# up by N and stop at Quit regardless of any messages that follow.
def _build_inc_quit_log(n: Int): Vec<tui::FrameMsg<Msg>>
  var msgs = vec_new()
  var i = 0
  while i < n
    vec_push(msgs, tui::FrameMsg::App(Msg::Inc))
    i = i + 1
  end
  vec_push(msgs, tui::FrameMsg::Quit)
  return msgs
end

def main(): Int
  describe("tui::Cmd construction") do ->
    it("Cmd::None constructs and matches") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::None
      var hit = 0
      match c
        tui::Cmd::None => hit = 1
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("Cmd::Quit constructs and matches") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::Quit
      var hit = 0
      match c
        tui::Cmd::Quit => hit = 1
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("Cmd::Run constructs with closure-typed payload") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::Run(make_inc_msg)
      var hit = 0
      match c
        tui::Cmd::Run(thunk) => hit = 1
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("Cmd::Run thunk produces a FrameMsg::App") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::Run(make_inc_msg)
      var hit = 0
      match c
        tui::Cmd::Run(thunk) =>
          var m = thunk()
          match m
            tui::FrameMsg::App(am) => hit = 1
            _ => hit = 0
          end
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("Cmd::Batch constructs with Vec payload") do ->
      var children = vec_new()
      vec_push(children, tui::Cmd::None)
      vec_push(children, tui::Cmd::Quit)
      var c: tui::Cmd<Msg> = tui::Cmd::Batch(children)
      # The bound `cs` from a generic-enum payload extraction has its
      # Vec element type erased — `cs.size` reads field offset 0 of
      # the wrong struct (the enum payload box). Use vec_size on the
      # raw handle instead. Filed as a project quirk in memory.
      var size = 0
      match c
        tui::Cmd::Batch(cs) => size = vec_size(cs)
        _ => size = -1
      end
      assert_eq(size, 2)
    end
  end

  describe("tui::FrameMsg construction") do ->
    it("FrameMsg::Key carries a KeyEvent") do ->
      var k = tui::key_event(65, 0)
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::Key(k)
      var code = -1
      match m
        tui::FrameMsg::Key(ev) => code = ev.code
        _ => code = -2
      end
      assert_eq(code, 65)
    end

    it("FrameMsg::Quit constructs and matches") do ->
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::Quit
      var hit = 0
      match m
        tui::FrameMsg::Quit => hit = 1
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("FrameMsg::App carries the user msg") do ->
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::App(Msg::Inc)
      var hit = 0
      match m
        tui::FrameMsg::App(am) =>
          match am
            Inc => hit = 1
            Dec => hit = 0
          end
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end

    it("`is` keyword works on FrameMsg variants") do ->
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::Quit
      var hit = 0
      if m is Quit
        hit = 1
      end
      assert_eq(hit, 1)
    end
  end

  describe("tui::Program construction") do ->
    it("program_new produces a Program with the supplied initial state") do ->
      var p = tui::program_new(St { n: 7 }, upd, vw)
      var s_initial: St = p.initial
      assert_eq(s_initial.n, 7)
    end

    it("program_new defaults recorder to a no-op (callable, returns Void)") do ->
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var rec_fn: Fn(tui::FrameMsg<Msg>): Void = p.recorder
      # If no_recorder is broken this either crashes or counts.
      # The test passes if the call returns cleanly.
      rec_fn(tui::FrameMsg::Quit)
      assert_eq(1, 1)
    end

    it("program_with_recorder attaches the supplied hook") do ->
      _qspec_recorder_calls = 0
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var p2 = tui::program_with_recorder(p, counting_recorder)
      var rec_fn: Fn(tui::FrameMsg<Msg>): Void = p2.recorder
      rec_fn(tui::FrameMsg::Quit)
      rec_fn(tui::FrameMsg::Quit)
      rec_fn(tui::FrameMsg::Quit)
      assert_eq(_qspec_recorder_calls, 3)
    end

    it("program_with_recorder leaves the original Program unchanged") do ->
      _qspec_recorder_calls = 0
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var p2 = tui::program_with_recorder(p, counting_recorder)
      # Original p still uses no_recorder — calling it should not bump
      # the counter that p2's recorder mutates.
      var orig_rec: Fn(tui::FrameMsg<Msg>): Void = p.recorder
      orig_rec(tui::FrameMsg::Quit)
      orig_rec(tui::FrameMsg::Quit)
      assert_eq(_qspec_recorder_calls, 0)
    end
  end

  describe("tui::Cmd::After / Cmd::Every / replay surface (v0.2)") do ->
    it("Cmd::After constructs and matches with payload") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::After(100, make_inc_msg)
      var ms = -1
      match c
        tui::Cmd::After(t, thunk) => ms = t
        _ => ms = -2
      end
      assert_eq(ms, 100)
    end

    it("Cmd::Every constructs and matches with payload") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::Every(50, make_inc_msg)
      var ms = -1
      match c
        tui::Cmd::Every(t, thunk) => ms = t
        _ => ms = -2
      end
      assert_eq(ms, 50)
    end

    it("Cmd::After thunk produces a FrameMsg::App") do ->
      var c: tui::Cmd<Msg> = tui::Cmd::After(0, make_inc_msg)
      var hit = 0
      match c
        tui::Cmd::After(t, thunk) =>
          var m = thunk()
          match m
            tui::FrameMsg::App(am) => hit = 1
            _ => hit = 0
          end
        _ => hit = 0
      end
      assert_eq(hit, 1)
    end
  end

  describe("tui::program_replay determinism") do ->
    it("replay walks state forward exactly like the original session") do ->
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var msgs = _build_inc_quit_log(7)
      var final_state = tui::program_replay(p, msgs)
      assert_eq(final_state.n, 7)
    end

    it("replay is deterministic — same msgs produce same final state") do ->
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var msgs = _build_inc_quit_log(13)
      var s1 = tui::program_replay(p, msgs)
      var s2 = tui::program_replay(p, msgs)
      var s3 = tui::program_replay(p, msgs)
      assert_eq(s1.n, s2.n)
      assert_eq(s2.n, s3.n)
      assert_eq(s1.n, 13)
    end

    it("replay terminates on FrameMsg::Quit and ignores subsequent msgs") do ->
      var p = tui::program_new(St { n: 0 }, upd, vw)
      var msgs = vec_new()
      vec_push(msgs, tui::FrameMsg::App(Msg::Inc))
      vec_push(msgs, tui::FrameMsg::Quit)
      vec_push(msgs, tui::FrameMsg::App(Msg::Inc))
      vec_push(msgs, tui::FrameMsg::App(Msg::Inc))
      var final_state = tui::program_replay(p, msgs)
      # n=1 after the first Inc; Quit terminates; subsequent Incs are
      # never delivered to update.
      assert_eq(final_state.n, 1)
    end

    it("replay returns initial state when msgs is empty") do ->
      var p = tui::program_new(St { n: 42 }, upd, vw)
      var msgs = vec_new()
      var final_state = tui::program_replay(p, msgs)
      assert_eq(final_state.n, 42)
    end
  end

  describe("update purity") do ->
    it("identical inputs produce identical outputs") do ->
      var s = St { n: 5 }
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::App(Msg::Inc)
      var pair1 = upd(m, s)
      var pair2 = upd(m, s)
      assert_eq(pair1.0.n, pair2.0.n)
    end

    it("update does not mutate its input state") do ->
      var s = St { n: 0 }
      var m: tui::FrameMsg<Msg> = tui::FrameMsg::App(Msg::Inc)
      var i = 0
      while i < 50
        var _p = upd(m, s)
        i = i + 1
      end
      # s.n must still be 0 — TEA contract says update returns a NEW
      # state, never mutates its input.
      assert_eq(s.n, 0)
    end

    it("Inc and Dec walk the count up and down deterministically") do ->
      var s = St { n: 0 }
      var inc: tui::FrameMsg<Msg> = tui::FrameMsg::App(Msg::Inc)
      var dec: tui::FrameMsg<Msg> = tui::FrameMsg::App(Msg::Dec)
      var p1 = upd(inc, s)
      var p2 = upd(inc, p1.0)
      var p3 = upd(inc, p2.0)
      var p4 = upd(dec, p3.0)
      assert_eq(p4.0.n, 2)
    end
  end

  return qspec_main()
end
