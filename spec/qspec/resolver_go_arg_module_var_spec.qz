## Regression spec for the resolver-rewrite hole on `go fn(modvar)`.
##
## Pre-fix: `resolve_rewrite_node` had cases for NODE_CALL (kind=9) and
## NODE_BINARY/NODE_LET/etc. but no case for NODE_GO (kind=85) or
## NODE_ASYNC_CALL (kind=84). When a module imported via an alias
## (`import M as A`) binds its globals as `A$name` and a function inside
## M then writes `go fn(_modvar)`, the bare ident `_modvar` inside the
## go-arg list was never rewritten to `A$_modvar`, so typecheck's
## scope lookup failed with QZ0403 — but only when the consuming driver
## actually pulled M into its dep graph (state-dependent across specs).
##
## Filed as docs/bugs/GO_CALL_ARG_MODULE_VAR_QZ0403.md and the sister
## doc MODULE_VAR_NONCONST_INIT_INVISIBLE.md (rediagnosed as same bug
## — non-const init was a red herring).
##
## Fix: resolver.qz adds NODE_GO + NODE_ASYNC_CALL + a few siblings
## (NODE_AWAIT, NODE_YIELD, NODE_TUPLE_LITERAL, NODE_WITH) to the
## resolve_rewrite_node dispatch so the rewrite reaches every position
## that can hold a bare module-var ident.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("resolver rewrites bare module-vars inside go args") do ->

    it("compiles `go fn(_modvar)` when module is imported with alias") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("store.qz"))
      var store_src = """
var _flag = 0

def worker(x: Int): Int
  return x
end

def caller(): Int
  if _flag == 0
    _flag = 42
  end
  go worker(_flag)
  return _flag
end
"""
      vec_push(files, as_int(store_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import store as st
def main(): Int = st::caller()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("compiles `go fn(_modvar)` inside a generic function body") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("store.qz"))
      var store_src = """
var _flag = 0

def worker(x: Int): Int
  return x
end

def caller<S, M>(seed: S): Int
  if _flag == 0
    _flag = 99
  end
  go worker(_flag)
  return _flag
end
"""
      vec_push(files, as_int(store_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import store as st
def main(): Int = st::caller<Int, Int>(0)
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 99)
    end

    it("compiles `go fn(_modvar)` after a sibling read of the same var") do ->
      ## Mirrors the std/tui/runtime.qz shape that originally surfaced
      ## the bug: a regular call reading the module-var (which the rewrite
      ## DID handle) followed by a `go` call passing the same var as an
      ## arg (which the rewrite missed). Both must pass post-fix.
      var files: Vec = vec_new()
      vec_push(files, as_int("store.qz"))
      var store_src = """
var _flag = 0

def reader(x: Int): Int
  return x + 1
end

def worker(x: Int): Int
  return x
end

def caller(): Int
  if _flag == 0
    _flag = 7
  end
  reader(_flag)
  go worker(_flag)
  return _flag
end
"""
      vec_push(files, as_int(store_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import store as st
def main(): Int = st::caller()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 7)
    end

  end
  return qspec_main()
end
