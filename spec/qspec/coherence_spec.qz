## Coherence Rules Tests
##
## Contract:
##   1. Duplicate impl (same trait + same type) is an error
##   2. Single impl per trait+type is allowed
##   3. Same trait for different types is allowed
##   4. Different traits for same type is allowed

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("coherence: duplicate impl detection") do ->
    it("rejects duplicate impl of same trait for same type") do ->
      assert_compile_error("""
        trait CohEq
          def coh_eq(self): Int
            return 0
          end
        end
        struct CohPoint
          x: Int
        end
        extend CohPoint with CohEq
          def coh_eq(self): Int = @x
        end
        extend CohPoint with CohEq
          def coh_eq(self): Int = @x + 1
        end
        def main(): Int = 0
        """, "Conflicting impl")
    end

    it("allows single impl per trait+type") do ->
      assert_run_exits("""
        trait CohShow
          def coh_show(self): Int
            return 0
          end
        end
        struct CohItem
          v: Int
        end
        extend CohItem with CohShow
          def coh_show(self): Int = @v
        end
        def main(): Int
          i = CohItem { v: 42 }
          return i.coh_show()
        end
        """, 42)
    end

    it("allows same trait for different types") do ->
      assert_run_exits("""
        trait CohVal
          def coh_val(self): Int
            return 0
          end
        end
        struct CohA
          x: Int
        end
        struct CohB
          y: Int
        end
        extend CohA with CohVal
          def coh_val(self): Int = @x
        end
        extend CohB with CohVal
          def coh_val(self): Int = @y * 10
        end
        def main(): Int
          a = CohA { x: 3 }
          b = CohB { y: 4 }
          return a.coh_val() + b.coh_val()
        end
        """, 43)
    end

    it("allows different traits for same type") do ->
      assert_run_exits("""
        trait CohAlpha
          def coh_alpha(self): Int
            return 0
          end
        end
        trait CohBeta
          def coh_beta(self): Int
            return 0
          end
        end
        struct CohWidget
          n: Int
        end
        extend CohWidget with CohAlpha
          def coh_alpha(self): Int = @n
        end
        extend CohWidget with CohBeta
          def coh_beta(self): Int = @n * 2
        end
        def main(): Int
          w = CohWidget { n: 5 }
          return w.coh_alpha() + w.coh_beta()
        end
        """, 15)
    end
  end

  return qspec_main()
end
