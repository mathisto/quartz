## Lexer byte-offset + full-fidelity trivia tests (Formatter M1.1)
##
## Verifies two additive lexer features that found the lossless CST:
##   1. Per-token byte offsets (parallel byte_starts / byte_ends vectors,
##      half-open [start, end) into the original source bytes).
##   2. Full-fidelity trivia mode (lexer_set_full_fidelity) emitting regular
##      comments as TOK_COMMENT — and proving they are ABSENT when the flag
##      is off (additivity / gating).
##
## Invariants tested:
##   - source[byte_start..byte_end] == lexeme for verbatim tokens
##     (idents, int literals, operators).
##   - byte offsets are monotonically non-decreasing in emission order.
##   - default (flag-off) stream contains no TOK_COMMENT (unchanged behavior).

import * from qspec
import lexer
import token_constants
import string_intern

# ---- helpers -------------------------------------------------------------

## Find the index of the first token whose resolved lexeme equals `want`.
## Returns -1 if not found.
def find_token(res: LexerResult, want: String): Int
  var interner = res.get_interner()
  var lexemes = res.get_lexemes()
  var n = res.token_count()
  var i = 0
  while i < n
    var lx = intern_resolve_int(interner, lexemes[i])
    if str_eq(lx, want)
      return i
    end
    i += 1
  end
  return -1
end

## Assert that slicing the source by [byte_start, byte_end) for the token whose
## lexeme is `tok` reproduces `tok` exactly. Returns 1 on success, 0 on failure.
def slice_matches(source: String, res: LexerResult, tok: String): Int
  var idx = find_token(res, tok)
  if idx < 0
    return 0
  end
  var starts = res.get_byte_starts()
  var ends = res.get_byte_ends()
  var slice = str_byte_slice(source, starts[idx], ends[idx])
  if str_eq(slice, tok)
    return 1
  end
  return 0
end

## Returns 1 if byte offsets are monotonically non-decreasing across all tokens
## (start[i] >= start[i-1]) and each span is well-formed (end >= start).
def offsets_monotonic(res: LexerResult): Int
  var starts = res.get_byte_starts()
  var ends = res.get_byte_ends()
  var n = res.token_count()
  var prev = 0
  var i = 0
  while i < n
    if ends[i] < starts[i]
      return 0
    end
    if starts[i] < prev
      return 0
    end
    prev = starts[i]
    i += 1
  end
  return 1
end

## Count tokens of a given type in the stream.
def count_type(res: LexerResult, want_type: Int): Int
  var types = res.get_types()
  var n = res.token_count()
  var c = 0
  var i = 0
  while i < n
    if types[i] == want_type
      c += 1
    end
    i += 1
  end
  return c
end

# ---- specs ---------------------------------------------------------------

def main(): Int
  describe("lexer per-token byte offsets") do ->
    it("slices source by [start,end) to reproduce an identifier lexeme") do ->
      var src = "x = 42"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(slice_matches(src, res, "x"), 1)
    end

    it("slices source to reproduce an integer literal lexeme") do ->
      var src = "x = 42"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(slice_matches(src, res, "42"), 1)
    end

    it("slices source to reproduce an operator lexeme") do ->
      var src = "a + b"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(slice_matches(src, res, "+"), 1)
    end

    it("slices source to reproduce a keyword lexeme") do ->
      var src = "def f()"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(slice_matches(src, res, "def"), 1)
    end

    it("offsets are monotonically non-decreasing") do ->
      var src = "def add(a, b)\n  return a + b\nend\n"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(offsets_monotonic(res), 1)
    end

    it("the parallel byte-offset vectors are populated for every token") do ->
      var src = "x = 42\n"
      var res = lexer_tokenize(src, intern_new())
      var n = res.token_count()
      assert_eq(res.get_byte_starts().size, n)
      assert_eq(res.get_byte_ends().size, n)
    end

    it("first ident starts at byte offset 0") do ->
      var src = "foo bar"
      var res = lexer_tokenize(src, intern_new())
      var idx = find_token(res, "foo")
      var starts = res.get_byte_starts()
      assert_eq(starts[idx], 0)
    end
  end

  describe("lexer full-fidelity trivia mode") do ->
    it("does NOT emit TOK_COMMENT by default (additivity)") do ->
      lexer_set_preserve_comments(0)
      lexer_set_full_fidelity(0)
      var src = "x = 1  # a comment\ny = 2\n"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(count_type(res, token_constants::TOK_COMMENT), 0)
    end

    it("emits TOK_COMMENT for regular comments in full-fidelity mode") do ->
      lexer_set_full_fidelity(1)
      var src = "x = 1  # a comment\ny = 2\n"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(count_type(res, token_constants::TOK_COMMENT), 1)
      # reset global flag so it cannot leak into later specs
      lexer_set_full_fidelity(0)
      lexer_set_preserve_comments(0)
    end

    it("doc-comments are present regardless of full-fidelity flag") do ->
      lexer_set_full_fidelity(0)
      lexer_set_preserve_comments(0)
      var src = "## doc line\ndef f()\nend\n"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(count_type(res, token_constants::TOK_DOC_COMMENT), 1)
    end

    it("newlines (incl. blank lines) are present as TOK_NEWLINE") do ->
      lexer_set_full_fidelity(1)
      # x=1, blank line, y=2  -> at least 3 newline tokens (one is the blank line)
      var src = "x = 1\n\ny = 2\n"
      var res = lexer_tokenize(src, intern_new())
      var nls = count_type(res, token_constants::TOK_NEWLINE)
      assert_gt(nls, 2)
      lexer_set_full_fidelity(0)
      lexer_set_preserve_comments(0)
    end

    it("full-fidelity offsets stay monotonic with trivia in the stream") do ->
      lexer_set_full_fidelity(1)
      var src = "x = 1  # c\n\ny = 2\n"
      var res = lexer_tokenize(src, intern_new())
      assert_eq(offsets_monotonic(res), 1)
      lexer_set_full_fidelity(0)
      lexer_set_preserve_comments(0)
    end
  end

  return qspec_main()
end
