## STRESS: Memory Ownership/Borrowing Edge Cases
##
## Adversarial tests probing ownership dark corners:
## move+reinit in loops, NLL sequences, partial moves,
## drop order with scopes, defer+drop interaction, and multi-field borrows.
##
## Contract:
##   1. Memory: move + reinit in loop.
##   2. Memory: NLL release then move.
##   3. Memory: partial moves.
##   4. Memory: drop order.
##   5. Memory: defer + drop.
##   6. Memory: multiple borrows.
##   7. Memory: Copy vs Move.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Move Then Re-Init in Loop
  # ===========================================================================
  describe("memory: move + reinit in loop") do ->
    it("move in loop body without reinit is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          var i = 0
          while i < 3
            consume(a)
            i = i + 1
          end
          return 0
        end
        """, "QZ1212")
    end

    it("move and re-init in loop body is allowed") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 0 }
          var i = 0
          var last = 0
          while i < 5
            last = consume(a)
            a = Res { x: i + 1 }
            i = i + 1
          end
          return consume(a) + 37
        end
        """, 42)
    end

    it("move in for-range loop body is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          for i in 0..3
            consume(a)
          end
          return 0
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Category B: Borrow, Release via NLL, Then Move
  # ===========================================================================
  describe("memory: NLL release then move") do ->
    it("borrow then NLL release then move — allowed") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var r = &a
          var val = r + 0
          ## r's last use above — NLL releases borrow
          return consume(a)
        end
        """, 42)
    end

    it("borrow still live when move attempted — rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          var r = &a
          var b = a
          var val = r + 0
          return 0
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Category C: Partial Moves
  # ===========================================================================
  describe("memory: partial moves") do ->
    it("partial move of struct field is tracked") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Pair
          x: Int
          y: Int
        end
        extend Pair with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume_int(v: Int): Int = v
        def use_pair(p: Pair): Int = p.x
        def main(): Int
          var p = Pair { x: 1, y: 2 }
          consume_int(p.x)
          use_pair(p)
          return 0
        end
        """, "QZ1216")
    end

    it("both fields moved separately — full struct moved") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Pair
          x: Int
          y: Int
        end
        extend Pair with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume_int(v: Int): Int = v
        def use_pair(p: Pair): Int = p.x
        def main(): Int
          var p = Pair { x: 1, y: 2 }
          consume_int(p.x)
          consume_int(p.y)
          use_pair(p)
          return 0
        end
        """, "QZ1216")
    end
  end

  # ===========================================================================
  # Category D: Drop Order With Nested Scopes
  # ===========================================================================
  describe("memory: drop order") do ->
    it("values dropped in reverse declaration order") do ->
      assert_run_exits("""
        var drop_order = 0
        trait Drop
          def drop(self: Int): Void
            drop_order = drop_order + 1
            return
          end
        end
        struct Tracked
          id: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            drop_order = drop_order + 1
            return
          end
        end
        def main(): Int
          var a = Tracked { id: 1 }
          var b = Tracked { id: 2 }
          var c = Tracked { id: 3 }
          return 42 - drop_order
        end
        """, 42)
    end

    it("inner scope values dropped before outer") do ->
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        struct Tracked
          id: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def inner(): Int
          var x = Tracked { id: 1 }
          return 0
        end
        def main(): Int
          inner()
          return 42 - drop_count + 1
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Defer + Drop Interaction
  # ===========================================================================
  describe("memory: defer + drop") do ->
    it("defer runs at function exit") do ->
      assert_run_exits("""
        var counter = 0
        def inc_counter(): Void
          counter = counter + 1
          return
        end
        def do_work(): Int
          defer inc_counter()
          return 41
        end
        def main(): Int
          var result = do_work()
          return result + counter
        end
        """, 42)
    end
    it("multiple defers run in LIFO order") do ->
      assert_run_exits("""
        var last_run = 0
        def set_last(v: Int): Void
          last_run = v
          return
        end
        def do_work(): Void
          defer set_last(1)
          defer set_last(2)
          defer set_last(3)
          return
        end
        def main(): Int
          do_work()
          if last_run
            return 42
          end
          return 0
        end
        """, 42)
    end
    it("defer runs on early return") do ->
      assert_run_exits("""
        var counter = 0
        def inc_counter(): Void
          counter = counter + 1
          return
        end
        def do_work(flag: Int): Int
          defer inc_counter()
          if flag > 0
            return 10
          end
          return 20
        end
        def main(): Int
          var a = do_work(1)
          var b = do_work(0)
          if counter == 2
            return 42
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Multiple Borrows of Different Variables
  # ===========================================================================
  describe("memory: multiple borrows") do ->
    it("borrows of two different variables coexist") do ->
      assert_run_exits("""
        def main(): Int
          var x = 20
          var y = 22
          var rx = &x
          var ry = &y
          return rx + ry
        end
        """, 42)
    end

    it ("shared borrows of same variable coexist") do ->
      assert_run_exits("""
        def main(): Int
          var x = 14
          var r1 = &x
          var r2 = &x
          var r3 = &x
          return r1 + r2 + r3
        end
        """, 42)
    end

    it("borrow of function parameter as local") do ->
      assert_run_exits("""
        def use_ref(x: Int): Int
          var r = &x
          return r + 0
        end
        def main(): Int
          return use_ref(42)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Copy vs Move Interaction
  # ===========================================================================
  describe("memory: Copy vs Move") do ->
    it("Copy type allows use after pass") do ->
      assert_run_exits("""
        trait Copy end
        struct CopyVal
          x: Int
        end
        extend CopyVal with Copy
        end
        def consume(v: CopyVal): Int = v.x
        def main(): Int
          var a = CopyVal { x: 21 }
          consume(a)
          return consume(a) + 21
        end
        """, 42)
    end

    it("Copy+Drop conflict rejected") do ->
      assert_compile_error("""
        trait Copy end
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Bad
          x: Int
        end
        extend Bad with Copy
        end
        extend Bad with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int = 0
        """, "QZ1215")
    end
  end

  return qspec_main()
end
