## Interprocedural Borrow Summary Tests (T3c.2)
##
## Tests that BorrowSummary generation from annotations works correctly
## and that call-site enforcement catches interprocedural borrow violations.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("borrow summary generation") do ->
    it("no borrow params generates no summary (no behavioral change)") do ->
      assert_run_exits("""
        def add(x: Int, y: Int): Int = x + y
        def main(): Int
          var result = add(1, 2)
          return result - 3
        end
        """, 0)
    end

    it("shared borrow param (&T) compiles and runs") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def read_x(p: &Point): Int = p.x
        def main(): Int
          var pt = Point { x: 10, y: 20 }
          var v = read_x(&pt)
          return v - 10
        end
        """, 0)
    end

    it("exclusive borrow param (&mut T) compiles and runs") do ->
      assert_run_exits("""
        struct Counter
          val: Int
        end
        def increment(c: &mut Counter): Void
          c.val = c.val + 1
        end
        def main(): Int
          var c = Counter { val: 0 }
          increment(&mut c)
          return c.val - 1
        end
        """, 0)
    end

    it("mixed borrow and non-borrow params compile") do ->
      assert_run_exits("""
        struct Box
          value: Int
        end
        def add_to(b: &mut Box, amount: Int): Void
          b.value = b.value + amount
        end
        def main(): Int
          var b = Box { value: 5 }
          add_to(&mut b, 10)
          return b.value - 15
        end
        """, 0)
    end

    it("function with borrow return annotation compiles") do ->
      assert_run_exits("""
        def identity(x: Int): Int = x
        def main(): Int
          var a = 42
          var v = identity(a)
          return v - 42
        end
        """, 0)
    end

    it("multiple shared borrow params compile") do ->
      assert_run_exits("""
        struct Vec2
          x: Int
          y: Int
        end
        def dot(a: &Vec2, b: &Vec2): Int = a.x * b.x + a.y * b.y
        def main(): Int
          var a = Vec2 { x: 1, y: 2 }
          var b = Vec2 { x: 3, y: 4 }
          var d = dot(&a, &b)
          return d - 11
        end
        """, 0)
    end

    it("ephemeral release still works for non-summary functions") do ->
      ## Functions without borrow annotations use the old ephemeral release path
      assert_run_exits("""
        def use_ref(x: Int): Int = x
        def main(): Int
          var a = 5
          var r = use_ref(a)
          return r - 5
        end
        """, 0)
    end

    it("borrow released after call allows reborrow") do ->
      assert_run_exits("""
        struct Data
          val: Int
        end
        def read_val(d: &Data): Int = d.val
        def main(): Int
          var d = Data { val: 7 }
          var v1 = read_val(&d)
          var v2 = read_val(&d)
          return v1 + v2 - 14
        end
        """, 0)
    end

    it("exclusive borrow released after call allows reborrow") do ->
      assert_run_exits("""
        struct Acc
          total: Int
        end
        def add_one(a: &mut Acc): Void
          a.total = a.total + 1
        end
        def main(): Int
          var a = Acc { total: 0 }
          add_one(&mut a)
          add_one(&mut a)
          return a.total - 2
        end
        """, 0)
    end
  end

  describe("elision rules") do ->
    it("no borrow output with borrow input — no return tracking") do ->
      assert_run_exits("""
        struct Bx
          val: Int
        end
        def read_val(b: &Bx): Int = b.val
        def main(): Int
          var b = Bx { val: 99 }
          var v = read_val(&b)
          return v - 99
        end
        """, 0)
    end

    it("zero borrow params with non-borrow return — trivial summary") do ->
      assert_run_exits("""
        def make_int(): Int = 42
        def main(): Int
          return make_int() - 42
        end
        """, 0)
    end
  end

  return qspec_main()
end
