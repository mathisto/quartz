## Cross-Feature: Match × Safety (TEST.2 Phase 3)
##
## Contract: Interactions between pattern matching and safety/ownership.
##   1. Match arm that moves a linear value.
##   2. Pattern matching with ownership transfer.
##   3. Non-exhaustive match + move interaction.
##   4. Match on enum with Drop types.
##   5. Consistent consumption across match arms.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ==========================================================================
  # Match Arms with Move Semantics
  # ==========================================================================
  describe("match arms with moves") do ->
    it("moving value in all match arms is valid") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          result = match 1
            1 => consume(a)
            _ => consume(a)
          end
          return result
        end
        """, 42)
    end

    it("QZ1214: moving in some match arms but not others is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end

    it("QZ1212: using value after match that consumed it") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            _ => consume(a)
          end
          var b = a
          return 0
        end
        """, "QZ1212")
    end
  end

  # ==========================================================================
  # Match on Enum with Safety
  # ==========================================================================
  describe("match on enum with owned types") do ->
    it("matching enum variants with owned data compiles") do ->
      assert_run_exits("""
        enum Action
          Start
          Stop
        end
        def handle(a: Action): Int
          return match a
            Start => 1
            Stop => 0
          end
        end
        def main(): Int
          return handle(Action::Start)
        end
        """, 1)
    end

    it("match with wildcard and Drop types") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 99 }
          result = match 1
            _ => consume(a)
          end
          return result
        end
        """, 99)
    end
  end

  # ==========================================================================
  # Borrow Inside Match
  # ==========================================================================
  describe("borrows inside match arms") do ->
    it("creating shared borrow inside match arm is valid") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def main(): Int
          p = Pt { x: 42 }
          result = match 1
            1 => p.x
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  # ==========================================================================
  # Non-Exhaustive Match + Safety Interaction
  # ==========================================================================
  describe("non-exhaustive match interactions") do ->
    it("QZ0107: non-exhaustive match detected") do ->
      assert_compile_error("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          var c = Color::Red
          match c
            Color::Red => return 1
          end
          return 0
        end
        """, "non-exhaustive")
    end
  end

  return qspec_main()
end
