## C Backend Tests
##
## Contract:
##   1. C Backend.
##   2. Basic programs.
##   3. Control flow.
##   4. Functions.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("C Backend") do ->
    describe("basic programs") do ->
      it("compiles hello world to C") do ->
        assert_ir_contains_with_flags("""
          def main(): Int
            puts("hello world")
            return 0
          end
        """, "puts", "--backend c")
      end

      it("returns exit code via C") do ->
        assert_ir_contains_with_flags("""
          def main(): Int
            return 42
          end
        """, "return", "--backend c")
      end

      it("performs arithmetic in C output") do ->
        assert_ir_contains_with_flags("""
          def main(): Int
            return 10 + 3
          end
        """, "int64_t", "--backend c")
      end
    end

    describe("control flow") do ->
      it("handles if/else in C output") do ->
        assert_ir_contains_with_flags("""
          def main(): Int
            var x = 1
            if x > 0
              return 1
            else
              return 0
            end
            return 0
          end
        """, "if", "--backend c")
      end

      it("handles while loop in C output") do ->
        assert_ir_contains_with_flags("""
          def main(): Int
            var i = 0
            while i < 10
              i = i + 1
            end
            return i
          end
        """, "goto", "--backend c")
      end
    end

    describe("functions") do ->
      it("emits function definitions in C") do ->
        assert_ir_contains_with_flags("""
          def double(x: Int): Int = x * 2
          def main(): Int
            return double(21)
          end
        """, "double", "--backend c")
      end
    end
  end

  return qspec_main()
end
