## @weak Function Attribute Tests (EPIC SYS.1 item 5)
##
## Contract:
##   1. A function annotated `@weak` emits with LLVM `weak` linkage,
##      so a non-weak definition at link time overrides it.
##   2. A function without the annotation emits with default linkage
##      (no `weak` keyword).
##   3. The annotation does not change the function's runtime behavior
##      when not overridden at link time.
##   4. Applying `@weak` to a non-function definition is a compile error.
##
## This attribute is the kernel-side primitive for overridable stubs
## (panic_handler, scheduler hooks, allocator slots). LLVM `weak`
## linkage is the well-known mechanism; Rust spells this #[linkage="weak"],
## Zig spells it `linkage(.weak)`, C uses `__attribute__((weak))`.
import * from qspec

def main(): Int
  describe("@weak function attribute") do ->
    it("@weak function still runs correctly when not overridden") do ->
      assert_eq(weak_caller(), 43)
    end

    it("@weak functions emit with LLVM weak linkage") do ->
      assert_ir_contains("""
@weak
def stub(): Int = 7

def main(): Int = stub()
""", "define weak i64 @stub")
    end

    it("non-@weak functions do NOT emit weak linkage") do ->
      assert_ir_not_contains("""
def plain(): Int = 7

def main(): Int = plain()
""", "define weak i64 @plain")
    end

    it("@weak with arguments preserves function signature") do ->
      assert_ir_contains("""
@weak
def multiply(a: Int, b: Int): Int = a * b

def main(): Int = multiply(3, 4)
""", "define weak i64 @multiply")
    end

    it("@weak on struct is rejected") do ->
      assert_compile_error("""
@weak
struct Foo
  x: Int
end

def main(): Int = 0
""", "@weak can only be applied to function definitions")
    end

    it("@weak on enum is rejected") do ->
      assert_compile_error("""
@weak
enum Bar
  A
  B
end

def main(): Int = 0
""", "@weak can only be applied to function definitions")
    end
  end

  return qspec_main()
end

## @weak helper — returns a constant. At link time, a strong
## definition of `weak_stub` (if one existed) would override this.
@weak
def weak_stub(): Int = 42

## Caller that exercises the weak stub. If @weak codegen is broken
## (e.g., the function wasn't emitted, or the symbol didn't resolve),
## this would SIGSEGV or return a different value.
def weak_caller(): Int = weak_stub() + 1
