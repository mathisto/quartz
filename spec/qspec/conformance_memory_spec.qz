## MEMORY_MODEL.md Conformance Test Suite
## Maps every section of the formal memory/ownership specification to QSpec tests.
## Each describe block is tagged with the spec section reference.
## Uses assert_compile_error for rejection tests, assert_run_exits for behavior tests.
##
## Contract:
##   1. MEM §2.1: Owned values.
##   2. MEM §3.1: Move semantics [MOVE].
##   3. MEM §3.2: Copy trait [COPY].
##   4. MEM §3.3: Move in loops.
##   5. MEM §3.5: Re-initialization after move.
##   6. MEM §4.1: Borrow rules — multiple shared borrows OK.
##   7. MEM §4.1: Borrow rules — dual exclusive rejected (QZ1205).
##   8. MEM §4.1: Borrow rules — shared+exclusive conflict (QZ1206).
##   9. MEM §4.1: Borrow rules — no mutate while borrowed (QZ1209).
##   10. MEM §4.1: Borrow rules — &mut requires var (QZ1208).
##   11. MEM §4.2: NLL-lite borrow lifetimes.
##   12. MEM §4.3: Ephemeral borrows.
##   13. MEM §4.4: Reassignment releases borrows.
##   14. MEM §4.5: Borrows cannot escape.
##   15. MEM §5.1: Automatic drop [DROP].
##   16. MEM §5.2: Drop order — LIFO.
##   17. MEM §5.3: Drop and moves.
##   18. MEM §5.5: Defer and drop interaction.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # §2.1 Owned Values
  # ===========================================================================
  describe("MEM §2.1: Owned values") do ->
    it("every value has exactly one owner") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          p = Point{x: 10, y: 32}
          return p.x + p.y
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.1 Move Semantics
  # ===========================================================================
  describe("MEM §3.1: Move semantics [MOVE]") do ->
    it("use after move of Drop type is QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          consume(r)
          return r.x
        end
        """, "QZ1212")
    end

    it("move to function transfers ownership") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          return consume(r)
        end
        """, 42)
    end

    it("move to variable transfers ownership") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var r1 = Res{x: 42}
          var r2 = r1
          return r1.x
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # §3.2 Copy Trait
  # ===========================================================================
  describe("MEM §3.2: Copy trait [COPY]") do ->
    it("Int values are implicitly copied, not moved") do ->
      assert_run_exits("""
        def consume(n: Int): Int = n
        def main(): Int
          var x = 42
          consume(x)
          return x
        end
        """, 42)
    end

    it("non-Drop struct values can be used after pass") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def use_point(p: Point): Int = p.x
        def main(): Int
          p = Point{x: 42, y: 0}
          use_point(p)
          return p.x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.3 Move in Loops
  # ===========================================================================
  describe("MEM §3.3: Move in loops") do ->
    it("move in loop body without reinit is rejected (QZ1212)") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var i = 0
          while i < 2
            consume(r)
            i += 1
          end
          return 0
        end
        """, "QZ1212")
    end

    it("move in loop body with reinit is accepted") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 1}
          var total = 0
          var i = 0
          while i < 3
            total += consume(r)
            r = Res{x: (i + 1) * 10}
            i += 1
          end
          return total
        end
        """, 31)
    end
  end

  # ===========================================================================
  # §3.5 Re-initialization After Move
  # ===========================================================================
  describe("MEM §3.5: Re-initialization after move") do ->
    it("re-initialized variable is valid again") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 1}
          consume(r)
          r = Res{x: 42}
          return consume(r)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §4.1 Borrow Rules
  # ===========================================================================
  describe("MEM §4.1: Borrow rules — multiple shared borrows OK") do ->
    it("multiple &x on same variable is allowed [Rule 1]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          a = &x
          b = &x
          return 0
        end
        """, 0)
    end
  end

  describe("MEM §4.1: Borrow rules — dual exclusive rejected (QZ1205)") do ->
    it("two &mut on same variable is QZ1205 [Rule 2]") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          a = &mut x
          b = &mut x
          return a + b
        end
        """, "QZ1205")
    end
  end

  describe("MEM §4.1: Borrow rules — shared+exclusive conflict (QZ1206)") do ->
    it("& and &mut on same variable is QZ1206 [Rule 3]") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          a = &x
          b = &mut x
          return a + b
        end
        """, "QZ1206")
    end
  end

  describe("MEM §4.1: Borrow rules — no mutate while borrowed (QZ1209)") do ->
    it("assignment while borrowed is QZ1209 [Rule 4]") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          r = &x
          x = 99
          return r
        end
        """, "QZ1209")
    end
  end

  describe("MEM §4.1: Borrow rules — &mut requires var (QZ1208)") do ->
    it("&mut on immutable binding is QZ1208 [Rule 5]") do ->
      assert_compile_error("""
        def main(): Int
          x = 42
          r = &mut x
          return 0
        end
        """, "QZ1208")
    end
  end

  # ===========================================================================
  # §4.2 NLL-lite Borrow Lifetimes
  # ===========================================================================
  describe("MEM §4.2: NLL-lite borrow lifetimes") do ->
    it("borrow expires at last use, allowing subsequent mutation") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          r = &x
          var y = r + 1
          x = 99
          return x
        end
        """, 99)
    end

    it("borrow live after conflicting mutation is error") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          r = &x
          x = 99
          return r
        end
        """, "QZ1209")
    end
  end

  # ===========================================================================
  # §4.3 Ephemeral Borrows
  # ===========================================================================
  describe("MEM §4.3: Ephemeral borrows") do ->
    it("borrow passed as arg released after call") do ->
      assert_compile_succeeds("""
        def peek(r: Int): Int = 0
        def main(): Int
          var x = 42
          peek(x)
          return 0
        end
        """)
    end
  end

  # ===========================================================================
  # §4.4 Reassignment Releases Borrows
  # ===========================================================================
  describe("MEM §4.4: Reassignment releases borrows") do ->
    it("reassigning borrow holder releases old borrow") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var p = &x
          p = 0
          var q = &mut x
          return 0
        end
        """, 0)
    end
  end

  # ===========================================================================
  # §4.5 Borrows Cannot Escape
  # ===========================================================================
  describe("MEM §4.5: Borrows cannot escape") do ->
    it("return borrow of local is QZ1210") do ->
      assert_compile_error("""
        def bad(): Int
          var x = 42
          return &x
        end
        def main(): Int
          return bad()
        end
        """, "QZ1210")
    end
  end

  # ===========================================================================
  # §5.1-5.3 Drop Semantics
  # ===========================================================================
  describe("MEM §5.1: Automatic drop [DROP]") do ->
    it("Drop trait method called on scope exit") do ->
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def make_res(): Void
          var r = Res{x: 1}
          return
        end
        def main(): Int
          make_res()
          return drop_count
        end
        """, 1)
    end
  end

  describe("MEM §5.2: Drop order — LIFO") do ->
    it("values dropped in reverse declaration order") do ->
      ## Drop count simply verifies drops are called
      assert_run_exits("""
        var drop_count = 0
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          id: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            drop_count = drop_count + 1
            return
          end
        end
        def stacked(): Void
          var a = Res{id: 1}
          var b = Res{id: 2}
          var c = Res{id: 3}
          return
        end
        def main(): Int
          stacked()
          return drop_count
        end
        """, 3)
    end
  end

  describe("MEM §5.3: Drop and moves") do ->
    it("moved values are not dropped at origin scope") do ->
      ## When a value is moved (consumed), the drop should happen
      ## in the callee, not the caller. Verify the value makes it
      ## to the callee correctly.
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          return consume(r)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §5.5 Defer and Drop Interaction
  # ===========================================================================
  describe("MEM §5.5: Defer and drop interaction") do ->
    it("defer runs in scope exit") do ->
      assert_run_exits("""
        var order = 0
        def record(n: Int): Void
          order = order + n
        end
        def test_fn(): Void
          defer record(42)
          return
        end
        def main(): Int
          test_fn()
          return order
        end
        """, 42)
    end
  end

  return qspec_main()
end
