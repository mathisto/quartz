## Set Algebra Tests
##
## Contract:
##   1. Union: `set_union(a,b)` returns union of two sets.
##   2. Intersection: `set_intersection(a,b)` returns common elements.
##   3. Difference: `set_difference(a,b)` returns elements in a not in b.
##   4. Subset yes: `set_is_subset` returns 1 when a ⊆ b.
##   5. Subset no: `set_is_subset` returns 0 when a ⊄ b.
##   6. Free: `set_free` does not crash.
##   7. Empty: union with empty set returns original set.
##   8. Disjoint: union of disjoint sets has size = sum of sizes.
import * from qspec

def main(): Int
  describe("set algebra") do ->
    it("set_union returns union of two sets") do ->
      assert_output("3\n", sa_union_test)
    end
    it("set_intersection returns common elements") do ->
      assert_output("2\n", sa_intersection_test)
    end
    it("set_difference returns elements in a not in b") do ->
      assert_output("1\n", sa_difference_test)
    end
    it("set_is_subset returns 1 when subset") do ->
      assert_output("1\n", sa_subset_yes_test)
    end
    it("set_is_subset returns 0 when not subset") do ->
      assert_output("0\n", sa_subset_no_test)
    end
    it("set_free does not crash") do ->
      var s = set_new()
      set_add(s, 42)
      set_free(s)
      assert_eq(0, 0)
    end
    it("union with empty set returns original") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      var empty = set_new()
      var c = set_union(a, empty)
      assert_eq(set_size(c), 2)
    end
    it("union of disjoint sets has combined size") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      var b = set_new()
      set_add(b, 3)
      set_add(b, 4)
      var c = set_union(a, b)
      assert_eq(set_size(c), 4)
    end
  end
  return qspec_main()
end
def sa_union_test(): Void
  var a = set_new()
  set_add(a, 1)
  set_add(a, 2)
  var b = set_new()
  set_add(b, 2)
  set_add(b, 3)
  var c = set_union(a, b)
  print_int(set_size(c))
end
def sa_intersection_test(): Void
  var a = set_new()
  set_add(a, 1)
  set_add(a, 2)
  set_add(a, 3)
  var b = set_new()
  set_add(b, 2)
  set_add(b, 3)
  set_add(b, 4)
  var c = set_intersection(a, b)
  print_int(set_size(c))
end
def sa_difference_test(): Void
  var a = set_new()
  set_add(a, 1)
  set_add(a, 2)
  set_add(a, 3)
  var b = set_new()
  set_add(b, 2)
  set_add(b, 3)
  var c = set_difference(a, b)
  print_int(set_size(c))
end
def sa_subset_yes_test(): Void
  var a = set_new()
  set_add(a, 1)
  set_add(a, 2)
  var b = set_new()
  set_add(b, 1)
  set_add(b, 2)
  set_add(b, 3)
  print_int(set_is_subset(a, b))
end
def sa_subset_no_test(): Void
  var a = set_new()
  set_add(a, 1)
  set_add(a, 4)
  var b = set_new()
  set_add(b, 1)
  set_add(b, 2)
  print_int(set_is_subset(a, b))
end
