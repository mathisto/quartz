## Str To F64 Tests
##
## Contract:
##   1. Converts float to string.
##   2. Converts fractional float to.
##   3. Parses fractional scientific notation.
##   4. Parses integer string as.
##   5. Parses negative float.
##   6. Parses scientific notation.
import * from qspec

def main(): Int
  describe("str_to_f64") do ->
    it("parses simple float") do ->
      assert_eq(sf_parse_simple(), 31)
    end
    it("parses zero") do ->
      assert_eq(to_int(str_to_f64("0.0")), 0)
    end
    it("parses negative float") do ->
      assert_eq(sf_parse_neg(), 15)
    end
    it("parses scientific notation") do ->
      assert_eq(to_int(str_to_f64("1e2")), 100)
    end
    it("parses integer string as float") do ->
      assert_eq(to_int(str_to_f64("42")), 42)
    end
    it("parses fractional scientific notation") do ->
      assert_eq(to_int(str_to_f64("2.5e1")), 25)
    end
    it("converts float to string") do ->
      assert_output("42\n", sf_float_to_str)
    end
    it("converts fractional float to string") do ->
      assert_output("3.14\n", sf_frac_to_str)
    end
    it("roundtrips float through string") do ->
      assert_eq(sf_roundtrip(), 25)
    end
  end
  return qspec_main()
end

def sf_parse_simple(): Int
  f = str_to_f64("3.14")
  return to_int(f * 10.0)
end
def sf_parse_neg(): Int
  f = str_to_f64("-1.5")
  neg10 = -10.0
  return to_int(f * neg10)
end
def sf_float_to_str(): Void
  f = to_f64(42)
  s = f64_to_str(f)
  puts(s)
end
def sf_frac_to_str(): Void
  f = str_to_f64("3.14")
  s = f64_to_str(f)
  puts(s)
end
def sf_roundtrip(): Int
  f = str_to_f64("2.5")
  s = f64_to_str(f)
  f2 = str_to_f64(s)
  return to_int(f2 * 10.0)
end
