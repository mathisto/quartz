import * from qspec

# Cache-ro regression: operator-syntax predicates (.empty?, .nil?, .some?,
# .whitespace?) on values whose type is resolved from a let-binding init
# expression. TC rewrites these field-access predicates into canonical
# forms at typecheck_expr_handlers.qz:630, 1446, etc. Under `--cache-ro`,
# body-TC is skipped for cached modules, and the rewrite never fires.
#
# Phase 4 target: new tc_remark_predicate_rewrites_in_module pass that
# walks NODE_FIELD_ACCESS for predicate names, rewrites to canonical form
# (str_empty(s), opt_is_some(o), etc.). Idempotent.
#
# This spec exercises the predicates in shapes that would surface the bug
# if applied to a function inside a cached module. The spec module itself
# is body-TC'd so the rewrite happens normally for the spec's own bodies;
# the regression target is more subtle (cross-module call into a cached
# helper that uses predicates). For now, verify the predicate shapes
# compile and run correctly — the deeper test (cross-module) requires
# Phase 4 to be in place plus a helper module to be added at that time.

def main(): Int
  describe("cache-ro operator predicates") do ->
    it(".empty? on String literal") do ->
      var s = "hello"
      assert_eq(s.empty?, false)
      var e = ""
      assert_eq(e.empty?, true)
    end

    it(".empty? on Vec") do ->
      var v = vec_new<Int>()
      assert_eq(v.empty?, true)
      v.push(1)
      assert_eq(v.empty?, false)
    end
  end
  return qspec_main()
end
