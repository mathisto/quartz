## Request Context Spec — Tests for request context API
##
## Tests context_set, context_get, context_has using manually constructed
## Request structs.

import * from qspec
import std/net/http_server

# =============================================================================
# Test helpers
# =============================================================================

def print_context_set_get(): Void
  var req = empty_request()
  context_set(req, "user_id", "42")
  puts(context_get(req, "user_id"))
end

def print_context_missing(): Void
  var req = empty_request()
  var result = context_get(req, "missing")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_context_has_true(): Void
  var req = empty_request()
  context_set(req, "auth", "bearer")
  if context_has(req, "auth")
    puts("true")
  else
    puts("false")
  end
end

def print_context_has_false(): Void
  var req = empty_request()
  if context_has(req, "missing")
    puts("true")
  else
    puts("false")
  end
end

def print_context_overwrite(): Void
  var req = empty_request()
  context_set(req, "role", "user")
  context_set(req, "role", "admin")
  puts(context_get(req, "role"))
end

def print_context_multiple(): Void
  var req = empty_request()
  context_set(req, "user_id", "42")
  context_set(req, "role", "admin")
  context_set(req, "org", "acme")
  puts(context_get(req, "user_id"))
  puts(context_get(req, "role"))
  puts(context_get(req, "org"))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("request context") do ->
    it("sets and gets a context value") do ->
      assert_output("42\n", print_context_set_get)
    end

    it("returns empty for missing key") do ->
      assert_output("empty\n", print_context_missing)
    end

    it("context_has returns true for set key") do ->
      assert_output("true\n", print_context_has_true)
    end

    it("context_has returns false for missing key") do ->
      assert_output("false\n", print_context_has_false)
    end

    it("overwrites existing key") do ->
      assert_output("admin\n", print_context_overwrite)
    end

    it("handles multiple context values") do ->
      assert_output("42\nadmin\nacme\n", print_context_multiple)
    end
  end

  return qspec_main()
end
