## D3 — Reserved keywords at binding sites must produce QZ0530,
## not cascading parser garbage.
##
## Before D3: `var end = 42` produced a stream of unrelated errors
## because the parser emitted "Expected variable name" and then
## kept trying to parse the keyword as part of the surrounding
## expression.
##
## After D3: the parser emits exactly one clean diagnostic:
##   QZ0530: 'end' is a reserved keyword and cannot be used as
##   an identifier in <context>
##
## Covers the four binding sites that consume an identifier:
##   1. var/let bindings
##   2. function parameters
##   3. for-loop variables
##   4. match pattern bindings

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ0530 — reserved keyword at binding site") do ->

    it("var end = 42 rejects 'end' as identifier") do ->
      assert_compile_error("""
        def main(): Int
          var end = 42
          return end
        end
        """, "QZ0530")
    end

    it("var if = 1 rejects 'if' as identifier") do ->
      assert_compile_error("""
        def main(): Int
          var if = 1
          return if
        end
        """, "QZ0530")
    end

    it("function param named 'end' rejected") do ->
      assert_compile_error("""
        def f(end: Int): Int = end
        def main(): Int = f(3)
        """, "QZ0530")
    end

    it("for-loop variable named 'match' rejected") do ->
      assert_compile_error("""
        def main(): Int
          for match in 0..3
            puts("hi")
          end
          return 0
        end
        """, "QZ0530")
    end

    it("match arm pattern binding named 'end' rejected") do ->
      assert_compile_error("""
        def main(): Int
          var x = Option::Some(42)
          var r = match x
            Option::Some(end) => end
            Option::None => 0
          end
          return r
        end
        """, "QZ0530")
    end

    it("'endpoint' is fine — not a reserved keyword") do ->
      assert_run_exits("""
        def main(): Int
          var endpoint = 42
          return 0 if endpoint == 42
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
