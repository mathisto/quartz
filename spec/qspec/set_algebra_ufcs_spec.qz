## Set Algebra UFCS Tests
##
## Contract: Set algebra operations work with dot syntax.

import * from qspec

def main(): Int
  describe("Set algebra UFCS") do ->
    it("s.union(t) combines sets") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      set_add(a, 3)
      var b = set_new()
      set_add(b, 3)
      set_add(b, 4)
      set_add(b, 5)
      var u = a.union(b)
      assert_eq(set_size(u), 5)
    end

    it("s.intersection(t) finds common") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      set_add(a, 3)
      set_add(a, 4)
      var b = set_new()
      set_add(b, 3)
      set_add(b, 4)
      set_add(b, 5)
      set_add(b, 6)
      var i = a.intersection(b)
      assert_eq(set_size(i), 2)
    end

    it("s.difference(t) removes shared") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      set_add(a, 3)
      set_add(a, 4)
      var b = set_new()
      set_add(b, 3)
      set_add(b, 4)
      set_add(b, 5)
      var d = a.difference(b)
      assert_eq(set_size(d), 2)
    end

    it("s.is_subset(t) checks containment") do ->
      var a = set_new()
      set_add(a, 1)
      set_add(a, 2)
      var b = set_new()
      set_add(b, 1)
      set_add(b, 2)
      set_add(b, 3)
      set_add(b, 4)
      assert_eq(a.is_subset(b), true)
      assert_eq(b.is_subset(a), false)
    end
  end

  return qspec_main()
end
