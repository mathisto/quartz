## Cross-module async codegen tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("cross-module async") do ->
    it("async call to function in another module") do ->
      var files: Vec = vec_new()
      files.push(as_int("worker.qz"))
      vec_push(files, as_int("""
        def compute(x: Int): Int
          return x * 3
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import worker
        def main(): Int
          sched_init(2)
          var t = async worker::compute(14)
          sched_spawn(t)
          var r = await t
          sched_shutdown()
          return r
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end

    it("same-module async call still works (regression)") do ->
      assert_run_exits_timeout(same_module_async_src(), 0)
    end

    it("cross-module async with multiple tasks") do ->
      var files: Vec = vec_new()
      files.push(as_int("math.qz"))
      vec_push(files, as_int("""
        def add(a: Int, b: Int): Int
          return a + b
        end
        def mul(a: Int, b: Int): Int
          return a * b
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import math
        def main(): Int
          sched_init(2)
          var t1 = async math::add(10, 20)
          sched_spawn(t1)
          var t2 = async math::mul(5, 6)
          sched_spawn(t2)
          var r1 = await t1
          var r2 = await t2
          sched_shutdown()
          return r1 + r2
        end
        """))
      assert_multi_run_exits(files, 1, 60)
    end
  end

  return qspec_main()
end

def same_module_async_src(): String = """
  def work(x: Int): Int
    return x + 1
  end
  def main(): Int
    sched_init(2)
    var t = async work(41)
    sched_spawn(t)
    var r = await t
    sched_shutdown()
    if r == 42
      return 0
    end
    return 1
  end
  """
