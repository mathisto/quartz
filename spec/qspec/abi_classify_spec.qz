# QSpec coverage for self-hosted/backend/abi_classify.qz — the Phase 3 C-ABI
# struct classifier (B.10 §13). Pure core: given a target + a struct's field-type
# names, decide register-coerce vs byval/sret. Tested standalone (no MirProgram).
#
# Matrix mirrors MEMORY_MODEL_V3.md §13.9: small int aggregates, float/SSE
# eightbytes, HFA (AArch64-only win), 16-byte boundary, >16 MEMORY/indirect,
# narrow-int packing, and the host-vs-deploy dispatch divergence.

import * from qspec
import abi_classify as abi

def main(): Int
  describe("abi_classify — System V AMD64 (x86_64 / deploy)") do ->
    it("empty struct → DIRECT") do ->
      var r = abi::abi_classify_fields_sysv([], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_DIRECT)
    end

    it("{Int} (8B) → coerce i64, 1 reg") do ->
      var r = abi::abi_classify_fields_sysv(["Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_COERCE)
      assert_eq_str(abi::abi_info_coerce_type(r), "i64")
      assert_eq(abi::abi_info_n_regs(r), 1)
    end

    it("{Int,Int} (16B) → coerce {i64, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["Int", "Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_COERCE)
      assert_eq_str(abi::abi_info_coerce_type(r), "{i64, i64}")
      assert_eq(abi::abi_info_n_regs(r), 2)
    end

    it("{F64,F64} (16B, all-SSE) → coerce {double, double}") do ->
      var r = abi::abi_classify_fields_sysv(["F64", "F64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{double, double}")
    end

    it("{Int,F64} → mixed {i64, double}") do ->
      var r = abi::abi_classify_fields_sysv(["Int", "F64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{i64, double}")
    end

    it("{F64,Int} → mixed {double, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["F64", "Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{double, i64}")
    end

    # P3.4b — SSE eightbyte float typing. Verified vs clang -emit-llvm
    # --target=x86_64: two packed floats → <2 x float>, one float alone → float,
    # a double → double, mixed int+float → i64 (INTEGER dominates SSE).
    it("{F32,F32} (8B, two packed floats) → coerce <2 x float>") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "F32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "<2 x float>")
      assert_eq(abi::abi_info_n_regs(r), 1)
    end

    it("{F32,F32,F32} (Vec3f, 12B) → {<2 x float>, float}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "F32", "F32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{<2 x float>, float}")
      assert_eq(abi::abi_info_n_regs(r), 2)
    end

    it("{F32,F32,F32,F32} (Vec4f, 16B) → {<2 x float>, <2 x float>}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "F32", "F32", "F32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{<2 x float>, <2 x float>}")
    end

    # I32+F32 share one 8-byte eightbyte (4+4); INTEGER dominates SSE → i64.
    # (Quartz `Int` is 8 bytes, so {F32,Int} would be 16B/two eightbytes — use
    # I32 for clang's C-`int`-sized {int,float} = one-eightbyte mixed case.)
    it("{I32,F32} (Mixf, int+float one eightbyte) → i64 (INTEGER dominates)") do ->
      var r = abi::abi_classify_fields_sysv(["I32", "F32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i64")
    end

    it("{F32,I32} (MixIF) → i64 (INTEGER dominates)") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "I32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i64")
    end

    it("{F32,Int} (float eb0, 8-byte Int eb1) → {float, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{float, i64}")
    end

    it("{F32,I64} (FMix, float alone in eb0) → {float, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "I64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{float, i64}")
    end

    it("{F32,F32,I64} (FF_I) → {<2 x float>, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "F32", "I64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{<2 x float>, i64}")
    end

    it("{F32,F64} (float+double, two eightbytes) → {float, double}") do ->
      var r = abi::abi_classify_fields_sysv(["F32", "F64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{float, double}")
    end

    it("{U8,U8,U8,Int} (16B, narrow packed) → {i64, i64}") do ->
      var r = abi::abi_classify_fields_sysv(["U8", "U8", "U8", "Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{i64, i64}")
    end

    # P3.4a — sub-8-byte trailing INTEGER eightbyte sizes to its used bytes
    # (clang getIntegerTypeAtOffset), not i64. Verified vs clang -emit-llvm.
    it("{U8,U8,U8,U8} (4B) → coerce i32 (not i64)") do ->
      var r = abi::abi_classify_fields_sysv(["U8", "U8", "U8", "U8"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i32")
      assert_eq(abi::abi_info_n_regs(r), 1)
    end

    it("{I16,I16} (4B) → coerce i32") do ->
      var r = abi::abi_classify_fields_sysv(["I16", "I16"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i32")
    end

    it("{I32,I32} (8B) → coerce i64") do ->
      var r = abi::abi_classify_fields_sysv(["I32", "I32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i64")
    end

    it("{I32,I32,I32} (Tri, 12B) → {i64, i32} (partial trailing eightbyte)") do ->
      var r = abi::abi_classify_fields_sysv(["I32", "I32", "I32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "{i64, i32}")
      assert_eq(abi::abi_info_n_regs(r), 2)
    end

    it("{U16} (2B) → coerce i16") do ->
      var r = abi::abi_classify_fields_sysv(["U16"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i16")
    end

    it("{U8} (1B) → coerce i8") do ->
      var r = abi::abi_classify_fields_sysv(["U8"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i8")
    end

    it("{Int,Int,Int} (24B > 16) arg → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_sysv(["Int", "Int", "Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end

    it("{Int,Int,Int} (24B > 16) return → INDIRECT_SRET") do ->
      var r = abi::abi_classify_fields_sysv(["Int", "Int", "Int"], 1)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_SRET)
    end

    it("{Int,Int,Int,Int} (Quad, 32B) arg → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_sysv(["Int", "Int", "Int", "Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end

    it("{Int,F64,Int} (M3, 24B mixed) arg → BYVAL, return → SRET") do ->
      var a = abi::abi_classify_fields_sysv(["Int", "F64", "Int"], 0)
      var r = abi::abi_classify_fields_sysv(["Int", "F64", "Int"], 1)
      assert_eq(abi::abi_info_kind(a), abi::ABI_INDIRECT_BYVAL)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_SRET)
    end

    it("6 doubles (Big6, 48B) arg → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_sysv(["F64", "F64", "F64", "F64", "F64", "F64"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end
  end

  describe("abi_classify — AArch64 AAPCS64 (arm64 / host)") do ->
    it("{F64,F64} → HFA [2 x double]") do ->
      var r = abi::abi_classify_fields_aapcs(["F64", "F64"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_COERCE)
      assert_eq_str(abi::abi_info_coerce_type(r), "[2 x double]")
      assert_eq(abi::abi_info_n_regs(r), 2)
    end

    it("{F32,F32,F32} → HFA [3 x float]") do ->
      var r = abi::abi_classify_fields_aapcs(["F32", "F32", "F32"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "[3 x float]")
    end

    it("{F64,F64,F64} (24B but HFA) → [3 x double], NOT memory") do ->
      var r = abi::abi_classify_fields_aapcs(["F64", "F64", "F64"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_COERCE)
      assert_eq_str(abi::abi_info_coerce_type(r), "[3 x double]")
    end

    it("{Int} → coerce i64") do ->
      var r = abi::abi_classify_fields_aapcs(["Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "i64")
    end

    it("{Int,Int} → coerce [2 x i64]") do ->
      var r = abi::abi_classify_fields_aapcs(["Int", "Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "[2 x i64]")
    end

    it("{F64,Int} (mixed, not HFA) → [2 x i64]") do ->
      var r = abi::abi_classify_fields_aapcs(["F64", "Int"], 0)
      assert_eq_str(abi::abi_info_coerce_type(r), "[2 x i64]")
    end

    it("{Int,Int,Int} (24B, not HFA) arg → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_aapcs(["Int", "Int", "Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end

    it("5 floats (> 4) not HFA, 20B > 16 → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_aapcs(["F32", "F32", "F32", "F32", "F32"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end

    it("{Int,Int,Int} (24B, not HFA) return → INDIRECT_SRET") do ->
      var r = abi::abi_classify_fields_aapcs(["Int", "Int", "Int"], 1)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_SRET)
    end

    it("6 doubles (Big6, 48B, > 4 ⇒ not HFA) arg → INDIRECT_BYVAL") do ->
      var r = abi::abi_classify_fields_aapcs(["F64", "F64", "F64", "F64", "F64", "F64"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_INDIRECT_BYVAL)
    end
  end

  describe("abi_classify — target dispatch divergence") do ->
    it("{F64,F64} classifies differently on x86_64 vs arm64") do ->
      var sysv = abi::abi_classify_fields("x86_64-unknown-linux-gnu", ["F64", "F64"], 0)
      var aapcs = abi::abi_classify_fields("aarch64-apple-macosx", ["F64", "F64"], 0)
      assert_eq_str(abi::abi_info_coerce_type(sysv), "{double, double}")
      assert_eq_str(abi::abi_info_coerce_type(aapcs), "[2 x double]")
    end

    it("x86_64 target recognized") do ->
      assert_eq(abi::abi_target_is_x86_64("x86_64-unknown-linux-gnu"), 1)
      assert_eq(abi::abi_target_is_aarch64("x86_64-unknown-linux-gnu"), 0)
    end

    it("arm64 targets recognized (linux + apple)") do ->
      assert_eq(abi::abi_target_is_aarch64("aarch64-unknown-linux-gnu"), 1)
      assert_eq(abi::abi_target_is_aarch64("arm64-apple-macosx14.0.0"), 1)
    end

    it("unknown target → DIRECT fallback (no regression)") do ->
      var r = abi::abi_classify_fields("wasm32-wasi", ["Int", "Int"], 0)
      assert_eq(abi::abi_info_kind(r), abi::ABI_DIRECT)
    end
  end

  return qspec_main()
end
