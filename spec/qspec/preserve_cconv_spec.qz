## preserve_all / preserve_most Calling Conventions (SYS.1 item 8)
##
## Contract:
##   1. `extern "preserve_all" def ...` emits `define preserve_allcc`
##      on the function. The callee saves almost all registers across
##      the call — used by slow-path helpers invoked from fast paths
##      where the caller doesn't want its register state disturbed.
##   2. `extern "preserve_most" def ...` emits `define preserve_mostcc`.
##      Similar but leaves the first few argument registers free;
##      standard for trap / fault trampolines that tail-call a
##      normal-cconv handler after minimal arg setup.
##   3. Neither cconv imposes the Void-return or body-required
##      restrictions that `x86-interrupt` does. They're regular
##      user-callable functions that happen to save more registers.
##   4. `extern "C"` continues to emit no cconv keyword (default ccc).
##
## Pairs with commit 57386a19 (extern "x86-interrupt") which introduced
## the cross-cconv parser + codegen plumbing. This slice extends that
## plumbing with two more named cconvs.
##
## NOTE: multi-line `extern "X" <newline> def ...` hits a pre-existing
## parser hang (filed in commit 57386a19). Spec inputs use single-line
## headers throughout.
import * from qspec

def main(): Int
  describe("preserve_all / preserve_most calling conventions") do ->
    it("extern \"preserve_all\" emits preserve_allcc keyword") do ->
      assert_ir_contains("""
extern "preserve_all" def slow_path(x: Int): Int
  return x + 1
end

def main(): Int = slow_path(5)
""", "define preserve_allcc")
    end

    it("extern \"preserve_most\" emits preserve_mostcc keyword") do ->
      assert_ir_contains("""
extern "preserve_most" def trap_tramp(x: Int): Int
  return x + 1
end

def main(): Int = trap_tramp(5)
""", "define preserve_mostcc")
    end

    it("extern \"preserve_all\" does NOT emit preserve_mostcc") do ->
      # Regression check — swapped codegen branch would silently
      # use the wrong cconv keyword. Both work with LLVM but
      # generate different prologue/epilogue saves.
      assert_ir_not_contains("""
extern "preserve_all" def slow_path(x: Int): Int
  return x + 1
end

def main(): Int = slow_path(5)
""", "preserve_mostcc")
    end

    it("extern \"C\" still emits default (no cconv keyword)") do ->
      # Regression: existing extern "C" path untouched by this slice.
      assert_ir_not_contains("""
extern "C" def libc_wrapper(x: Int): Int
  return x * 2
end

def main(): Int = libc_wrapper(5)
""", "preserve_allcc")
    end

    it("preserve_allcc function still returns a real value") do ->
      # Unlike x86_intrcc which is forced void, preserve_all
      # preserves the declared return type. Verify i64 return
      # is emitted for an Int-returning preserve_all fn.
      assert_ir_contains("""
extern "preserve_all" def slow_path(x: Int): Int
  return x + 1
end

def main(): Int = slow_path(5)
""", "define preserve_allcc i64 @slow_path")
    end
  end

  return qspec_main()
end
