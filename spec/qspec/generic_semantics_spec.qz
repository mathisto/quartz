## Generic Semantics Tests
##
## Contract:
##   1. Pair<T,U>: access first and second fields.
##   2. Box<T>: single-param generic struct.
##   3. Triple<A,B,C>: three type parameters.
##   4. Tagged<T>: non-generic field alongside generic.
##   5. Arithmetic: operations on generic struct fields.
##   6. Explicit type args: construct with explicit types.
import * from qspec

struct GSPair<T, U>
  first: T
  second: U
end

struct GSBox<T>
  value: T
end

struct GSTriple<A, B, C>
  x: A
  y: B
  z: C
end

struct GSTagged<T>
  tag: Int
  value: T
end

def main(): Int
  describe("generic semantics") do ->
    it("accesses first field of Pair<Int, String>") do ->
      var p = GSPair<Int, String> { first: 42, second: "hello" }
      assert_eq(p.first, 42)
    end

    it("accesses second Int field of Pair<String, Int>") do ->
      var p = GSPair<String, Int> { first: "hello", second: 7 }
      assert_eq(p.second, 7)
    end

    it("accesses field of single-param Box<T>") do ->
      var b = GSBox<Int> { value: 99 }
      assert_eq(b.value, 99)
    end

    it("constructs with explicit type arguments") do ->
      var b = GSBox<Int> { value: 5 }
      assert_eq(b.value + 10, 15)
    end

    it("constructs with multiple fields Triple") do ->
      var t = GSTriple<Int, Int, Int> { x: 1, y: 2, z: 3 }
      assert_eq(t.z, 3)
    end

    it("accesses non-generic field alongside generic") do ->
      var t = GSTagged<String> { tag: 10, value: "hi" }
      assert_eq(t.tag, 10)
    end

    it("arithmetic on Pair fields") do ->
      var p = GSPair<Int, Int> { first: 20, second: 22 }
      assert_eq(p.first + p.second, 42)
    end

    it("Triple field sum") do ->
      var t = GSTriple<Int, Int, Int> { x: 10, y: 20, z: 12 }
      assert_eq(t.x + t.y + t.z, 42)
    end
  end
  return qspec_main()
end
