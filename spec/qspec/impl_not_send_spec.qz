## Regression tests for IMPL-NOT-SEND (Batch C sprint C3).
##
## `impl !Send for X end` and `impl !Sync for X end` let users explicitly
## opt out of Send/Sync auto-derivation. The negative impl always wins —
## it's consulted first in tc_type_is_send / tc_type_is_sync /
## tc_check_trait_bound, before any structural walker or positive impl.
##
## Reference: Rust RFC 0019 (negative impls) + rustc's
## `ImplPolarity::Negative` design. Quartz's implementation is a
## lightweight registry of (trait_name, for_type) pairs consulted at
## bound-check time.
##
## Contract:
##   1. `impl !Send for X` rejects X at a `T: Send` bound site.
##   2. Without the negative impl, the same type auto-derives Send
##      structurally (B1 regression lock — structural derivation
##      still works for types without negative impls).
##   3. `impl !Sync for X` rejects X at a `T: Sync` bound site.
##   4. Negative impls accept payload-free bodies (`impl !Send for X end`).
##   5. A negative impl on a type with only Send fields still wins — the
##      structural walker is never consulted.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("impl !Send / impl !Sync negative impls") do ->

    it("impl !Send for X rejects X at a T: Send bound site") do ->
      assert_compile_error("""
        struct NS
          n: Int
        end
        extend NS end without Send
        def accept<T: Send>(v: T): Int = 0
        def main(): Int
          return accept(NS { n: 1 })
        end
        """, "Send")
    end

    it("without !Send, the same type auto-derives Send structurally") do ->
      assert_run_exits("""
        struct NS
          n: Int
        end
        def accept<T: Send>(v: T): Int = 0
        def main(): Int
          return accept(NS { n: 1 })
        end
        """, 0)
    end

    it("impl !Sync for X rejects X at a T: Sync bound site") do ->
      assert_compile_error("""
        struct NY
          n: Int
        end
        extend NY end without Sync
        def accept_sync<T: Sync>(v: T): Int = 0
        def main(): Int
          return accept_sync(NY { n: 1 })
        end
        """, "Sync")
    end

    it("negative impl on all-primitive-fields struct still wins") do ->
      ## B1's structural walker would derive Send for this type because
      ## every field is a Send primitive. The negative impl must still
      ## reject — this proves neg_impls is consulted BEFORE the walker.
      assert_compile_error("""
        struct AllSend
          i: Int
          b: Bool
          s: String
        end
        extend AllSend end without Send
        def accept<T: Send>(v: T): Int = 0
        def main(): Int
          return accept(AllSend { i: 1, b: true, s: "x" })
        end
        """, "Send")
    end

    it("unrelated positive impl for same type does not affect negative") do ->
      ## impl SomeOther for X alongside impl !Send for X — the Send bound
      ## still fails even though another trait impl exists on the type.
      assert_compile_error("""
        trait Greet
          def greet(self): Int
        end
        struct GN
          n: Int
        end
        extend GN with Greet
          def greet(self): Int = @n
        end
        extend GN end without Send
        def accept<T: Send>(v: T): Int = 0
        def main(): Int
          return accept(GN { n: 1 })
        end
        """, "Send")
    end

  end
  return qspec_main()
end
