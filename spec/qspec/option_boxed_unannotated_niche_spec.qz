## Option<boxed struct> niche — UN-ANNOTATED local from the bare option_some/
## option_none INTRINSIC (N3 item 6.3c, the 5th asymmetry).
##
## The hazard this regresses against: for `var u = option_some(Struct{..})` with
## NO `: Option<Struct>` annotation, the CONSTRUCTION side niches via the arg's
## inferred type, but the READ side gates on mir_infer_expr_type(u). Before the
## 6.3c fix, that inference resolved the intrinsic's bare return type ("Option"),
## losing the concrete payload P, so the read defaulted to SPILL and mis-decoded
## the niche identity-pointer as a tagged box → 0/None. The 6.3c fix recovers
## Option<P> for the un-annotated local from the SAME mir_option_intrinsic_payload
## the construction side uses, so construct/read agree for EVERY read position.
##
## Representation-agnostic: these MUST pass under both tagged and niche layouts —
## a differential oracle across the flip. Deterministic repro for 6.3c:
##   var u = option_some(User{age:42}); u?.age ?? 0  →  42 (was 0 under niche).
import * from qspec

struct User
  age: Int
  name: String
end

def main(): Int
  describe("un-annotated option_some local — safe navigation (?.)") do ->
    it("u?.age recovers the payload field (the 6.3c repro)") do ->
      var u = option_some(User { age: 42, name: "ada" })
      assert_eq(u?.age ?? 0, 42)
    end
    it("u?.age on an un-annotated option_none yields the default") do ->
      var u = option_none()
      assert_eq(u?.age ?? 7, 7)
    end
  end

  describe("un-annotated option_some local — nil-coalescing (??)") do ->
    it("Some unwraps through ??") do ->
      var u = option_some(User { age: 13, name: "lin" })
      var v = u ?? User { age: -1, name: "fallback" }
      assert_eq(v.age, 13)
    end
  end

  describe("un-annotated option_some local — .unwrap() / .some? / .none?") do ->
    it(".unwrap() returns the payload") do ->
      var u = option_some(User { age: 99, name: "max" })
      assert_eq(u.unwrap().age, 99)
    end
    it(".some? true for a constructed Some") do ->
      var u = option_some(User { age: 1, name: "z" })
      assert_eq(u.some?, 1)
    end
    it(".none? true for an un-annotated option_none") do ->
      var u: Option<User> = option_none()
      assert_eq(u.none?, 1)
    end
  end

  describe("un-annotated option_some local — try") do ->
    it("try unwraps a Some payload") do ->
      assert_eq(try_age().unwrap(), 55)
    end
  end

  describe("un-annotated option_some local — match") do ->
    it("matches Some(p) and reads the field") do ->
      var u = option_some(User { age: 8, name: "q" })
      var r = match u
        Some(p) => p.age
        None => -1
      end
      assert_eq(r, 8)
    end
  end

  return qspec_main()
end

# `try` requires an Option-returning function context.
def try_age(): Option<Int>
  var u = option_some(User { age: 55, name: "tryer" })
  var p = try u
  return Option::Some(p.age)
end
