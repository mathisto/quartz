## v0.3.2 Step 5 — List<Item> behavior tests
##
## Coverage:
##   - Construction: list_new with empty/non-empty items, default selection
##   - Items management: list_set_items clamping
##   - Accessors: selected_index, selected_item, size
##   - State setters: select_first/last/next/prev, set_selected clamping
##   - wrap_around: next at last → first; prev at first → last
##   - Update: Up/Down → Highlighted, Enter → Selected, Idle elsewhere
##   - View: produces height lines, selected row has indicator

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/list as ls
import std/tui/layout as ly

enum SpecMsg
  Noop
end

def show(s: String): String = s

def feed_key(l: ls::List<String>, code: Int): ls::List<String>
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = ls::list_update(l, msg)
  return triple.0
end

def feed_event(l: ls::List<String>, code: Int): ls::ListEvent<String>
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = ls::list_update(l, msg)
  return triple.2
end

# No explicit ls::List<String> return type — Quartz's generic
# struct return-type checker rejects them with "expected unknown
# but got unknown". Inferred return works fine.

def make_list()
  var items = vec_new<String>()
  vec_push(items, "alpha")
  vec_push(items, "bravo")
  vec_push(items, "charlie")
  vec_push(items, "delta")
  vec_push(items, "echo")
  var l = ls::list_new(items, ls::item_delegate_simple(show))
  return ls::list_with_size(l, 30, 3)
end

def make_empty_list()
  var empty = vec_new<String>()
  var l = ls::list_new(empty, ls::item_delegate_simple(show))
  return ls::list_with_size(l, 30, 3)
end

# ============================================================
# Construction
# ============================================================

def test_new_with_items_selects_first(): Void
  var l = make_list()
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 0)
    None      => assert_eq(0, 1)
  end
end

def test_new_empty_has_no_selection(): Void
  var l = make_empty_list()
  match ls::list_selected_index(l)
    Some(_idx) => assert_eq(0, 1)
    None       => assert_eq(1, 1)
  end
end

def test_size_returns_item_count(): Void
  var l = make_list()
  assert_eq(ls::list_size(l), 5)
end

# ============================================================
# Items management
# ============================================================

def test_set_items_clamps_selection(): Void
  var l = make_list()
  l = ls::list_set_selected(l, 4)  # last
  var smaller = vec_new()
  vec_push(smaller, "x")
  vec_push(smaller, "y")
  l = ls::list_set_items(l, smaller)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 1)  # clamped to size-1
    None      => assert_eq(0, 1)
  end
end

def test_set_items_empty_clears_selection(): Void
  var l = make_list()
  l = ls::list_set_items(l, vec_new())
  match ls::list_selected_index(l)
    Some(_idx) => assert_eq(0, 1)
    None       => assert_eq(1, 1)
  end
end

# ============================================================
# Accessors
# ============================================================

def test_selected_item_returns_some(): Void
  var l = make_list()
  match ls::list_selected_item(l)
    Some(s) => assert_eq_str(s, "alpha")
    None    => assert_eq(0, 1)
  end
end

def test_selected_item_returns_none_on_empty(): Void
  var l = make_empty_list()
  match ls::list_selected_item(l)
    Some(_s) => assert_eq(0, 1)
    None     => assert_eq(1, 1)
  end
end

# ============================================================
# State setters
# ============================================================

def test_select_first(): Void
  var l = make_list()
  l = ls::list_set_selected(l, 3)
  l = ls::list_select_first(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 0)
    None      => assert_eq(0, 1)
  end
end

def test_select_last(): Void
  var l = make_list()
  l = ls::list_select_last(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 4)
    None      => assert_eq(0, 1)
  end
end

def test_select_next_advances(): Void
  var l = make_list()
  l = ls::list_select_next(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 1)
    None      => assert_eq(0, 1)
  end
end

def test_select_prev_retreats(): Void
  var l = ls::list_set_selected(make_list(), 2)
  l = ls::list_select_prev(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 1)
    None      => assert_eq(0, 1)
  end
end

def test_select_next_at_last_no_wrap(): Void
  var l = ls::list_select_last(make_list())
  l = ls::list_select_next(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 4)  # stays at last
    None      => assert_eq(0, 1)
  end
end

def test_select_prev_at_first_no_wrap(): Void
  var l = make_list()  # at index 0
  l = ls::list_select_prev(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 0)
    None      => assert_eq(0, 1)
  end
end

def test_select_next_at_last_wraps_when_on(): Void
  var l = ls::list_with_wrap_around(make_list(), true)
  l = ls::list_select_last(l)
  l = ls::list_select_next(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 0)
    None      => assert_eq(0, 1)
  end
end

def test_select_prev_at_first_wraps_when_on(): Void
  var l = ls::list_with_wrap_around(make_list(), true)
  l = ls::list_select_prev(l)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 4)
    None      => assert_eq(0, 1)
  end
end

def test_set_selected_clamps_negative(): Void
  var l = ls::list_set_selected(make_list(), -10)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 0)
    None      => assert_eq(0, 1)
  end
end

def test_set_selected_clamps_overflow(): Void
  var l = ls::list_set_selected(make_list(), 100)
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 4)
    None      => assert_eq(0, 1)
  end
end

# ============================================================
# Update events
# ============================================================

def test_down_emits_highlighted(): Void
  var l = make_list()
  var ev = feed_event(l, terminal::KEY_DOWN())
  match ev
    Highlighted(item) => assert_eq_str(item, "bravo")
    _ => assert_eq(0, 1)
  end
end

def test_enter_emits_selected(): Void
  var l = ls::list_set_selected(make_list(), 2)
  var ev = feed_event(l, terminal::KEY_ENTER())
  match ev
    Selected(item) => assert_eq_str(item, "charlie")
    _ => assert_eq(0, 1)
  end
end

def test_unknown_key_emits_idle(): Void
  var l = make_list()
  var ev = feed_event(l, 'x')
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_down_at_last_no_wrap_emits_idle(): Void
  var l = ls::list_select_last(make_list())
  var ev = feed_event(l, terminal::KEY_DOWN())
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_home_emits_highlighted(): Void
  var l = ls::list_set_selected(make_list(), 3)
  var ev = feed_event(l, terminal::KEY_HOME())
  match ev
    Highlighted(item) => assert_eq_str(item, "alpha")
    _ => assert_eq(0, 1)
  end
end

def test_end_emits_highlighted(): Void
  var l = make_list()
  var ev = feed_event(l, terminal::KEY_END())
  match ev
    Highlighted(item) => assert_eq_str(item, "echo")
    _ => assert_eq(0, 1)
  end
end

def test_ctrl_f_pages_down(): Void
  var l = make_list()
  l = feed_key(l, terminal::KEY_CTRL_F())
  match ls::list_selected_index(l)
    Some(idx) => assert_eq(idx, 3)  # 0 + height(3)
    None      => assert_eq(0, 1)
  end
end

# ============================================================
# View
# ============================================================

def test_view_renders_height_lines(): Void
  var l = make_list()
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 3)
end

def test_view_selected_row_has_cursor_indicator(): Void
  var l = make_list()  # selected = 0
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  # Selected row starts with "▶ "
  if str_byte_at(lines[0], 0) == 0xE2 and str_byte_at(lines[0], 1) == 0x96
    assert_eq(1, 1)  # ▶ is U+25B6 = 0xE2 0x96 0xB6
  else
    assert_eq(0, 1)
  end
end

def test_view_unselected_row_has_two_space_gutter(): Void
  var l = make_list()  # selected = 0
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  # Row 1 (bravo) is unselected — gutter is "  "
  assert_eq(str_byte_at(lines[1], 0), ' ')
  assert_eq(str_byte_at(lines[1], 1), ' ')
end

def test_view_empty_list_renders_blank_window(): Void
  var l = make_empty_list()
  var view = ls::list_view(l, true)
  var stripped = ly::strip_styles(view)
  var lines = str_split(stripped, "\n")
  assert_eq(lines.size, 3)
end

# ============================================================
# Scroll viewport with selection
# ============================================================

def test_select_below_window_scrolls_offset(): Void
  var l = make_list()  # height=3, items=5
  l = ls::list_set_selected(l, 4)  # last item
  # offset should be 2 (so item 4 is bottom of window)
  assert_eq(ls::list_offset(l), 2)
end

def main(): Int
  describe("construction") do ->
    it("with items selects first") do ->
      test_new_with_items_selects_first()
    end
    it("empty has no selection") do ->
      test_new_empty_has_no_selection()
    end
    it("size returns item count") do ->
      test_size_returns_item_count()
    end
  end

  describe("items management") do ->
    it("set_items clamps selection on shrink") do ->
      test_set_items_clamps_selection()
    end
    it("set_items empty clears selection") do ->
      test_set_items_empty_clears_selection()
    end
  end

  describe("accessors") do ->
    it("selected_item returns Some") do ->
      test_selected_item_returns_some()
    end
    it("selected_item returns None on empty") do ->
      test_selected_item_returns_none_on_empty()
    end
  end

  describe("state setters") do ->
    it("select_first") do ->
      test_select_first()
    end
    it("select_last") do ->
      test_select_last()
    end
    it("select_next advances") do ->
      test_select_next_advances()
    end
    it("select_prev retreats") do ->
      test_select_prev_retreats()
    end
    it("select_next at last is no-op without wrap") do ->
      test_select_next_at_last_no_wrap()
    end
    it("select_prev at first is no-op without wrap") do ->
      test_select_prev_at_first_no_wrap()
    end
    it("select_next at last wraps with wrap_around") do ->
      test_select_next_at_last_wraps_when_on()
    end
    it("select_prev at first wraps with wrap_around") do ->
      test_select_prev_at_first_wraps_when_on()
    end
    it("set_selected clamps negative to 0") do ->
      test_set_selected_clamps_negative()
    end
    it("set_selected clamps overflow to size-1") do ->
      test_set_selected_clamps_overflow()
    end
  end

  describe("update events") do ->
    it("Down emits Highlighted") do ->
      test_down_emits_highlighted()
    end
    it("Enter emits Selected") do ->
      test_enter_emits_selected()
    end
    it("unknown key emits Idle") do ->
      test_unknown_key_emits_idle()
    end
    it("Down at last (no wrap) emits Idle") do ->
      test_down_at_last_no_wrap_emits_idle()
    end
    it("Home emits Highlighted") do ->
      test_home_emits_highlighted()
    end
    it("End emits Highlighted") do ->
      test_end_emits_highlighted()
    end
    it("Ctrl-F pages down") do ->
      test_ctrl_f_pages_down()
    end
  end

  describe("view") do ->
    it("renders exactly `height` lines") do ->
      test_view_renders_height_lines()
    end
    it("selected row has ▶ cursor indicator") do ->
      test_view_selected_row_has_cursor_indicator()
    end
    it("unselected row has two-space gutter") do ->
      test_view_unselected_row_has_two_space_gutter()
    end
    it("empty list renders blank window") do ->
      test_view_empty_list_renders_blank_window()
    end
  end

  describe("scroll") do ->
    it("selecting below window scrolls offset") do ->
      test_select_below_window_scrolls_offset()
    end
  end

  return qspec_main()
end
