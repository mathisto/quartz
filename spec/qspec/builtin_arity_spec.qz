## PSQ-8 regression lock: typechecker rejects wrong-arity builtin calls at
## diagnostic stage instead of crashing in codegen with "index out of bounds".
##
## HISTORY: Before Apr 15 2026, builtins were registered via tc_register_builtin
## without arity bounds, so tc_expr_call skipped the arity check and passed
## through to the codegen handler, which read args[0] on an empty args vec and
## crashed the compiler. Fix: use tc_register_builtin_with_arity for every
## concurrency primitive and let the existing arity check in tc_expr_call
## emit a clean QZ0200 diagnostic.
##
## These tests lock in that the wrong-arity forms produce compile errors
## (not compiler crashes) and that the correct-arity forms still compile.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("builtin arity — concurrency primitives") do ->

    describe("mutex_new") do ->
      it("0-arg form rejected with QZ0200") do ->
        assert_compile_error("""
          def main(): Int
            var m = mutex_new()
            return 0
          end
          """, "requires 1")
      end
      it("1-arg form accepted") do ->
        assert_run_exits("""
          def main(): Int
            var m = mutex_new(0)
            mutex_free(m)
            return 0
          end
          """, 0)
      end
    end

    describe("mutex_lock / mutex_unlock") do ->
      it("mutex_lock 0-arg rejected") do ->
        assert_compile_error("""
          def main(): Int
            var m = mutex_new(0)
            mutex_lock()
            return 0
          end
          """, "requires 1")
      end
      it("mutex_unlock 1-arg rejected (needs 2)") do ->
        assert_compile_error("""
          def main(): Int
            var m = mutex_new(0)
            var v = mutex_lock(m)
            mutex_unlock(m)
            return 0
          end
          """, "requires 2")
      end
      it("mutex_unlock 2-arg accepted") do ->
        assert_run_exits("""
          def main(): Int
            var m = mutex_new(0)
            var v = mutex_lock(m)
            mutex_unlock(m, v + 1)
            mutex_free(m)
            return 0
          end
          """, 0)
      end
    end

    describe("rwlock_new / rwlock_*") do ->
      it("rwlock_new 0-arg rejected") do ->
        assert_compile_error("""
          def main(): Int
            var rw = rwlock_new()
            return 0
          end
          """, "requires 1")
      end
      it("rwlock_write_unlock 1-arg rejected (needs 2)") do ->
        assert_compile_error("""
          def main(): Int
            var rw = rwlock_new(0)
            var v = rwlock_write(rw)
            rwlock_write_unlock(rw)
            return 0
          end
          """, "requires 2")
      end
    end

    describe("channel_new") do ->
      it("0-arg form rejected (needs cap)") do ->
        assert_compile_error("""
          def main(): Int
            var ch = channel_new()
            return 0
          end
          """, "requires 1")
      end
      it("1-arg form accepted") do ->
        assert_run_exits("""
          def main(): Int
            var ch = channel_new(10)
            channel_free(ch)
            return 0
          end
          """, 0)
      end
      it("channel_new_unbounded 0-arg accepted") do ->
        assert_run_exits("""
          def main(): Int
            var ch = channel_new_unbounded()
            channel_free(ch)
            return 0
          end
          """, 0)
      end
    end

  end
  return qspec_main()
end
