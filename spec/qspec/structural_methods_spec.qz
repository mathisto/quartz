## Structural Method Constraints - Compile-Time Duck Typing Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("basic structural method dispatch") do ->
    it("calls extend method on untyped parameter") do ->
      assert_run_exits("""
        struct Dog
          name: Int
        end
        extend Dog {
          def speak(): Int = 1
        }
        def make_sound(animal): Int = animal.speak()
        def main(): Int
          d = Dog { name: 0 }
          return make_sound(d)
        end
        """, 1)
    end
  end

  describe("error messages for failed constraints") do ->
    it("errors when type is missing required method") do ->
      assert_compile_error("""
        struct Empty
          x: Int
        end
        def call_it(thing): Int = thing.speak()
        def main(): Int
          e = Empty { x: 1 }
          return call_it(e)
        end
        """, "speak")
    end

    it("error mentions the missing method name") do ->
      assert_compile_error("""
        struct Widget
          x: Int
        end
        def process(w): Int = w.transform()
        def main(): Int
          w = Widget { x: 1 }
          return process(w)
        end
        """, "transform")
    end

    it("errors when type is missing one of multiple required methods") do ->
      assert_compile_error("""
        struct Partial
          n: Int
        end
        extend Partial {
          def foo(): Int = self.n
        }
        def both(t): Int = t.foo() + t.bar()
        def main(): Int
          p = Partial { n: 1 }
          return both(p)
        end
        """, "bar")
    end
  end

  return qspec_main()
end
