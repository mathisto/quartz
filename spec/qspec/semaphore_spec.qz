import * from qspec
import * from std/sync/exclusion/semaphore

def test_sem_initial_count(): Void
  var sem = semaphore_new(3)
  puts(to_str(semaphore_available(sem)))
end

def test_sem_acquire_release(): Void
  var sem = semaphore_new(2)
  semaphore_acquire(sem)
  var after_acq = semaphore_available(sem)
  semaphore_release(sem)
  var after_rel = semaphore_available(sem)
  puts("#{to_str(after_acq)} #{to_str(after_rel)}")
end

def test_sem_try_acquire(): Void
  var sem = semaphore_new(1)
  var first = semaphore_try_acquire(sem)
  var second = semaphore_try_acquire(sem)
  if first and not second
    puts("ok")
  else
    puts("fail")
  end
  semaphore_release(sem)
end

def test_sem_exhaust_and_release(): Void
  var sem = semaphore_new(2)
  semaphore_acquire(sem)
  semaphore_acquire(sem)
  var empty = semaphore_available(sem)
  semaphore_release(sem)
  semaphore_release(sem)
  var full = semaphore_available(sem)
  puts("#{to_str(empty)} #{to_str(full)}")
end

var g_sem_max_concurrent = 0
var g_sem_current = 0

def sem_rate_limited_task(sem: Int): Int
  semaphore_acquire(sem)
  var cur = atomic_add(g_sem_current, 1)
  # Track max concurrency
  var max = atomic_load(g_sem_max_concurrent)
  if cur + 1 > max
    atomic_store(g_sem_max_concurrent, cur + 1)
  end
  sched_yield()
  sched_yield()
  atomic_sub(g_sem_current, 1)
  semaphore_release(sem)
  return 0
end

def test_sem_rate_limiting(): Void
  g_sem_max_concurrent = atomic_new(0)
  g_sem_current = atomic_new(0)
  var sem = semaphore_new(2)
  sched_init(4)
  var handles = vec_new()
  var i = 0
  while i < 6
    handles.push(go sem_rate_limited_task(sem))
    i += 1
  end
  i = 0
  while i < 6
    await handles[i]
    i += 1
  end
  sched_shutdown()
  var max = atomic_load(g_sem_max_concurrent)
  if max <= 2
    puts("rate limited to #{to_str(max)}")
  else
    puts("exceeded: #{to_str(max)}")
  end
end

def main(): Int
  describe("semaphore") do ->

    it("initial permits count") do ->
      assert_output("3\n", test_sem_initial_count)
    end

    it("acquire decrements, release restores") do ->
      assert_output("1 2\n", test_sem_acquire_release)
    end

    it("try_acquire succeeds then fails when exhausted") do ->
      assert_output("ok\n", test_sem_try_acquire)
    end

    it("exhaust all permits then release all") do ->
      assert_output("0 2\n", test_sem_exhaust_and_release)
    end

    it("rate limits concurrent tasks to permit count") do ->
      assert_output_contains("rate limited", test_sem_rate_limiting)
    end

  end

  return qspec_main()
end
