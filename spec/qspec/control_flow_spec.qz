## Control Flow Tests
##
## Contract:
##   1. If statements: truthy/falsy dispatch, comparisons, equality.
##   2. If-else: both branches reachable, variable conditions.
##   3. Elsif chains: multi-way branching, fallthrough to else.
##   4. Nested if: 2-3 levels, nested if-else.
##   5. While loops: iteration, skip on false, accumulation, countdown.
##   6. Break: early exit, immediate break, inner-loop only.
##   7. Continue: skip iteration, multiple skips, inner-loop only.
##   8. Nested while: 2-level nesting, triangular accumulation.
##   9. If inside while: filtering, early exit pattern.
##  10. While inside if: conditional loop execution.
##  11. Functions: if/while inside functions, complex control flow (Collatz).
##  12. Boolean literals: true/false as conditions.
##  13. For loops: exclusive range, non-zero start, expression bounds, nested.

import * from qspec

def main(): Int
  # ==========================================================================
  # If statements
  # ==========================================================================

  describe("if statements") do ->
    it("executes then branch when condition is true") do ->
      if 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("skips then branch when condition is false") do ->
      if 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("uses comparison as condition") do ->
      if 5 > 3
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("uses equality as condition") do ->
      x = 10
      if x == 10
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # If-else statements
  # ==========================================================================

  describe("if-else statements") do ->
    it("executes else when condition is false") do ->
      if 0
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("executes then when condition is true") do ->
      if 1
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("uses variable in condition") do ->
      flag = 0
      if flag
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("computes in both branches") do ->
      x = 5
      var result = 0
      if x > 10
        result = x * 2
      else
        result = x + 37
      end
      assert_eq(result, 42)
    end
  end

  # ==========================================================================
  # Elsif statements
  # ==========================================================================

  describe("elsif statements") do ->
    it("handles simple elsif chain") do ->
      x = 2
      var result = 0
      if x == 1
        result = 10
      elsif x == 2
        result = 20
      else
        result = 0
      end
      assert_eq(result, 20)
    end

    it("matches first elsif branch") do ->
      x = 1
      var result = 0
      if x == 1
        result = 10
      elsif x == 2
        result = 20
      elsif x == 3
        result = 30
      else
        result = 0
      end
      assert_eq(result, 10)
    end

    it("matches middle elsif branch") do ->
      x = 3
      var result = 0
      if x == 1
        result = 10
      elsif x == 2
        result = 20
      elsif x == 3
        result = 30
      else
        result = 0
      end
      assert_eq(result, 30)
    end

    it("falls through to else when no match") do ->
      x = 99
      var result = 0
      if x == 1
        result = 10
      elsif x == 2
        result = 20
      else
        result = 42
      end
      assert_eq(result, 42)
    end

    it("handles elsif without else") do ->
      x = 2
      var result = 0
      if x == 1
        result = 10
      elsif x == 2
        result = 20
      end
      assert_eq(result, 20)
    end

    it("handles elsif with complex conditions") do ->
      x = 15
      var result = 0
      if x < 10
        result = 1
      elsif x < 20
        result = 2
      elsif x < 30
        result = 3
      else
        result = 4
      end
      assert_eq(result, 2)
    end

    it("handles elsif with logical operators") do ->
      x = 5
      y = 10
      var result = 0
      if x > 10 and y > 10
        result = 1
      elsif x < 10 and y > 5
        result = 2
      else
        result = 3
      end
      assert_eq(result, 2)
    end
  end

  # ==========================================================================
  # Nested if statements
  # ==========================================================================

  describe("nested if statements") do ->
    it("handles two levels of nesting") do ->
      x = 5
      var result = 0
      if x > 0
        if x < 10
          result = 42
        end
      end
      assert_eq(result, 42)
    end

    it("handles three levels of nesting") do ->
      a = 1
      b = 2
      c = 3
      var result = 0
      if a == 1
        if b == 2
          if c == 3
            result = 42
          end
        end
      end
      assert_eq(result, 42)
    end

    it("handles nested if-else") do ->
      x = 5
      var result = 0
      if x > 10
        result = 1
      else
        if x > 3
          result = 42
        else
          result = 3
        end
      end
      assert_eq(result, 42)
    end

    it("handles deeply nested else branches") do ->
      x = 100
      var result = 0
      if x < 10
        result = 1
      else
        if x < 50
          result = 2
        else
          if x < 200
            result = 42
          else
            result = 4
          end
        end
      end
      assert_eq(result, 42)
    end
  end

  # ==========================================================================
  # While loops
  # ==========================================================================

  describe("while loops") do ->
    it("executes body multiple times") do ->
      var count = 0
      while count < 42
        count += 1
      end
      assert_eq(count, 42)
    end

    it("skips body when condition is initially false") do ->
      var x = 42
      while 0
        x = 99
      end
      assert_eq(x, 42)
    end

    it("accumulates values") do ->
      var sum = 0
      var i = 1
      while i <= 10
        sum = sum + i
        i = i + 1
      end
      assert_eq(sum, 55)
    end

    it("computes factorial iteratively") do ->
      var n = 5
      var result = 1
      while n > 1
        result = result * n
        n = n - 1
      end
      assert_eq(result, 120)
    end

    it("counts down") do ->
      var x = 50
      while x > 42
        x = x - 1
      end
      assert_eq(x, 42)
    end
  end

  # ==========================================================================
  # Break statement
  # ==========================================================================

  describe("break statement") do ->
    it("exits loop early") do ->
      var i = 0
      var sum = 0
      while i < 10
        i = i + 1
        if i == 5
          break
        end
        sum = sum + i
      end
      assert_eq(sum, 10)
    end

    it("exits immediately when break is first statement") do ->
      var count = 0
      while true
        break
        count += 1
      end
      assert_eq(count, 0)
    end

    it("only breaks innermost loop") do ->
      var total = 0
      var i = 0
      while i < 3
        var j = 0
        while j < 10
          if j == 2
            break
          end
          total = total + 1
          j += 1
        end
        i = i + 1
      end
      assert_eq(total, 6)
    end
  end

  # ==========================================================================
  # Continue statement
  # ==========================================================================

  describe("continue statement") do ->
    it("skips to next iteration") do ->
      var i = 0
      var sum = 0
      while i < 10
        i = i + 1
        if i == 5
          continue
        end
        sum = sum + i
      end
      assert_eq(sum, 50)
    end

    it("skips multiple values") do ->
      var i = 0
      var sum = 0
      while i < 10
        i = i + 1
        if i == 3 or i == 6 or i == 9
          continue
        end
        sum = sum + i
      end
      assert_eq(sum, 37)
    end

    it("only continues innermost loop") do ->
      var total = 0
      var i = 0
      while i < 3
        var j = 0
        while j < 4
          j += 1
          if j == 2
            continue
          end
          total = total + 1
        end
        i = i + 1
      end
      assert_eq(total, 9)
    end
  end

  # ==========================================================================
  # Nested while loops
  # ==========================================================================

  describe("nested while loops") do ->
    it("handles two levels of nesting") do ->
      var total = 0
      var i = 0
      while i < 3
        var j = 0
        while j < 4
          total = total + 1
          j += 1
        end
        i = i + 1
      end
      assert_eq(total, 12)
    end

    it("handles outer loop with inner accumulation") do ->
      var sum = 0
      var i = 1
      while i <= 3
        var j = 1
        while j <= i
          sum = sum + j
          j += 1
        end
        i = i + 1
      end
      assert_eq(sum, 10)
    end
  end

  # ==========================================================================
  # If inside while
  # ==========================================================================

  describe("if inside while") do ->
    it("filters values in loop") do ->
      var sum = 0
      var i = 1
      while i <= 10
        if i % 2 == 0
          sum = sum + i
        end
        i = i + 1
      end
      assert_eq(sum, 30)
    end

    it("early exit pattern with flag") do ->
      var i = 0
      var found = 0
      while i < 100
        if i == 42
          found = i
        end
        i = i + 1
      end
      assert_eq(found, 42)
    end

    it("uses else in loop") do ->
      var evens = 0
      var odds = 0
      var i = 1
      while i <= 10
        if i % 2 == 0
          evens = evens + 1
        else
          odds = odds + 1
        end
        i = i + 1
      end
      assert_eq(evens + odds, 10)
    end
  end

  # ==========================================================================
  # While inside if
  # ==========================================================================

  describe("while inside if") do ->
    it("conditionally runs a loop") do ->
      x = 1
      var result = 0
      if x == 1
        var count = 0
        while count < 42
          count += 1
        end
        result = count
      end
      assert_eq(result, 42)
    end

    it("skips loop in else branch") do ->
      flag = 0
      var result = 0
      if flag
        var i = 0
        while i < 100
          i = i + 1
        end
        result = i
      else
        result = 42
      end
      assert_eq(result, 42)
    end
  end

  # ==========================================================================
  # Control flow with functions
  # ==========================================================================

  describe("control flow with functions") do ->
    it("if inside function") do ->
      assert_eq(abs_val(-42), 42)
    end

    it("while inside function") do ->
      assert_eq(sum_to(9), 45)
    end

    it("function with complex control flow") do ->
      assert_eq(collatz_steps(7), 16)
    end
  end

  # ==========================================================================
  # Boolean true/false literals
  # ==========================================================================

  describe("boolean true/false literals") do ->
    it("treats true as truthy") do ->
      if true
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("treats false as falsy") do ->
      if false
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("uses true/false in else") do ->
      var result = 0
      if false
        result = 1
      else
        result = 42
      end
      assert_eq(result, 42)
    end
  end

  # ==========================================================================
  # For loops
  # ==========================================================================

  describe("for loops") do ->
    it("iterates from start to end (exclusive)") do ->
      var sum = 0
      for i in 0..5
        sum = sum + i
      end
      assert_eq(sum, 10)
    end

    it("works with non-zero start") do ->
      var sum = 0
      for i in 3..6
        sum = sum + i
      end
      assert_eq(sum, 12)
    end

    it("works with expression bounds") do ->
      n = 4
      var sum = 0
      for i in 1..n + 1
        sum = sum + i
      end
      assert_eq(sum, 10)
    end

    it("does not execute when start >= end") do ->
      var sum = 99
      for i in 5..3
        sum = 0
      end
      assert_eq(sum, 99)
    end

    it("supports nested for loops") do ->
      var sum = 0
      for i in 0..3
        for j in 0..3
          sum = sum + 1
        end
      end
      assert_eq(sum, 9)
    end
  end

  return qspec_main()
end

def abs_val(x: Int): Int
  if x < 0
    return -x
  end
  return x
end

def sum_to(n: Int): Int
  var sum = 0
  var i = 1
  while i <= n
    sum = sum + i
    i = i + 1
  end
  return sum
end

def collatz_steps(n: Int): Int
  var steps = 0
  while n != 1
    if n % 2 == 0
      n = n / 2
    else
      n = n * 3 + 1
    end
    steps = steps + 1
  end
  return steps
end
