## Arena Blocks Tests — subprocess compilation of arena programs
##
## Contract:
##   1. Scoped: basic arena alloc/destroy.
##   2. Block: allocations tracked by bytes_used.
##   3. Free: reset zeros bytes_used.
##   4. Nesting: nested arena blocks.
##   5. Defer: arena blocks with defer.
##   6. Param: function accepts arena handle parameter.
##   7. Alloc: allocates using passed arena.
##   8. Reset: arena reset zeros used bytes.
##   9. Multi-alloc: multiple allocs grow arena.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("arena blocks") do ->
    it("scoped arena block") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          var p = arena_alloc(a, 8)
          arena_destroy(a)
          return 42
        end
        """, 42)
    end
    it("allocations in block use arena") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          var p1 = arena_alloc(a, 16)
          var p2 = arena_alloc(a, 32)
          var used = arena_bytes_used(a)
          arena_destroy(a)
          if used >= 48
            return 42
          end
          return 1
        end
        """, 42)
    end
    it("frees when block exits") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          var p = arena_alloc(a, 100)
          var before = arena_bytes_used(a)
          arena_reset(a)
          var after = arena_bytes_used(a)
          arena_destroy(a)
          if before > 0
            if after == 0
              return 42
            end
          end
          return 1
        end
        """, 42)
    end
    it("nested arena blocks") do ->
      assert_run_exits("""
        def main(): Int
          var outer = arena_new()
          var p1 = arena_alloc(outer, 16)
          var inner = arena_new()
          var p2 = arena_alloc(inner, 32)
          var inner_used = arena_bytes_used(inner)
          arena_destroy(inner)
          var outer_used = arena_bytes_used(outer)
          arena_destroy(outer)
          if inner_used >= 32
            if outer_used >= 16
              return 42
            end
          end
          return 1
        end
        """, 42)
    end
    it("arena blocks with defer") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          defer arena_destroy(a)
          var p = arena_alloc(a, 64)
          var used = arena_bytes_used(a)
          if used >= 64
            return 42
          end
          return 1
        end
        """, 42)
    end
    it("function accepts arena handle parameter") do ->
      assert_run_exits("""
        def allocate_in(a: Int, size: Int): Int
          return arena_alloc(a, size)
        end
        def main(): Int
          var a = arena_new()
          var p = allocate_in(a, 32)
          var used = arena_bytes_used(a)
          arena_destroy(a)
          if used >= 32
            return 42
          end
          return 1
        end
        """, 42)
    end
    it("allocates using passed arena") do ->
      assert_run_exits("""
        def alloc_and_check(a: Int): Int
          var before = arena_bytes_used(a)
          var ptr = arena_alloc(a, 64)
          var after = arena_bytes_used(a)
          if after > before
            if ptr > 0
              return 42
            end
          end
          return 1
        end
        def main(): Int
          var a = arena_new()
          defer arena_destroy(a)
          return alloc_and_check(a)
        end
        """, 42)
    end
    it("arena reset zeros used bytes") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          var p = arena_alloc(a, 128)
          arena_reset(a)
          var used = arena_bytes_used(a)
          arena_destroy(a)
          return used
        end
        """, 0)
    end
    it("multiple allocs grow arena") do ->
      assert_run_exits("""
        def main(): Int
          var a = arena_new()
          var p1 = arena_alloc(a, 16)
          var p2 = arena_alloc(a, 16)
          var p3 = arena_alloc(a, 16)
          var used = arena_bytes_used(a)
          arena_destroy(a)
          if used >= 48
            return 42
          end
          return 1
        end
        """, 42)
    end
  end
  return qspec_main()
end
