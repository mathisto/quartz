## QSpec coverage for std/tui/light.qz — Phase 6.4 of the v0.6 cell engine.
##
## Coverage:
##   - Light + LightBuffer construction:
##       * light_new field round-trip
##       * light_torch / light_miners / light_torch_flicker preset shapes
##       * light_buffer_new sets ambient on every cell
##       * shadow_flags initialized true everywhere
##   - Flag bitset:
##       * LIGHT_FLAG_MAINTAIN_SHADOWS / MAGICAL / FLICKER are distinct bits
##       * light_flag_has tests bits correctly
##   - Paint with no obstructions:
##       * radius=0 light is a no-op
##       * cell at origin gets full multiplier (color contribution)
##       * cell at radius edge gets fade_to_pct multiplier
##       * cell beyond radius gets no contribution (still ambient)
##       * fade_to_pct=100 = constant disk (no falloff)
##       * fade_to_pct=0 = full falloff (zero at edge)
##   - Paint with obstructions:
##       * cell behind a wall (LOS blocked) gets no contribution
##       * wall cell itself does get contribution (walls reflect light)
##   - MAINTAIN_SHADOWS flag:
##       * paint without flag clears shadow_flags for lit cells
##       * paint with flag preserves shadow_flags
##   - Light composition:
##       * two paint calls additively accumulate at overlap cells
##       * accumulation clamps at 255
##   - Apply:
##       * default-color cells get the buffer's RGB substituted
##       * truecolor cells get additive blend with clamping
##       * palette cells pass through unchanged (v0.6.4 limitation)
##       * apply preserves egc, attrs, alpha
##       * out-of-buffer cells pass through unchanged
##   - Flicker:
##       * FLICKER set + frame=N produces deterministic jitter
##       * different frames produce different multipliers
##       * FLICKER clear ignores frame value
##
## See docs/design/TUI_V06_CELL_ENGINE.md D4 for the design rationale.

import * from qspec
import std/tui/light as lt
import std/tui/cell as cl
import std/tui/plane as pl
import style

# =============================================================================
# Helpers — blocks_light predicates and cell builders
# =============================================================================

## Open field: no cell blocks light.
def _block_none(x: Int, y: Int): Bool = false

## Wall at (3, 3) — used to test LOS occlusion of cells at (4, 4)+.
def _block_at_3_3(x: Int, y: Int): Bool = x == 3 and y == 3

## Wall column at x=4 — used for shadow-cone tests.
def _block_col_4(x: Int, y: Int): Bool = x == 4

## A truecolor RGB int from r/g/b components (0-255 each).
def _rgb(r: Int, g: Int, b: Int): Int
  return 0x1000000 | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF)
end

## Extract R from a packed truecolor Int. -1 / palette / ANSI16
## return -1 (sentinel, easy to spot in assertions).
def _r_of(c: Int): Int
  if c < 0x1000000
    return -1
  end
  return (c >> 16) & 0xFF
end

def _g_of(c: Int): Int
  if c < 0x1000000
    return -1
  end
  return (c >> 8) & 0xFF
end

def _b_of(c: Int): Int
  if c < 0x1000000
    return -1
  end
  return c & 0xFF
end

# =============================================================================
# Spec body
# =============================================================================

def main(): Int
  describe("Light — construction") do ->
    it("light_new round-trips field values") do ->
      var l = lt::light_new(7, 11, 200, 100, 50, 5, 30, 6, 12)
      assert_eq(l.origin_x, 7)
      assert_eq(l.origin_y, 11)
      assert_eq(l.color_r, 200)
      assert_eq(l.color_g, 100)
      assert_eq(l.color_b, 50)
      assert_eq(l.radius, 5)
      assert_eq(l.fade_to_pct, 30)
      assert_eq(l.flags, 6)
      assert_eq(l.flicker_pct, 12)
    end

    it("light_torch is mundane (no flags) with warm RGB") do ->
      var l = lt::light_torch(2, 3, 4)
      assert_eq(l.origin_x, 2)
      assert_eq(l.origin_y, 3)
      assert_eq(l.radius, 4)
      assert_eq(l.flags, 0)
      assert_eq(l.color_r, 255)
      assert_eq(l.color_g, 180)
      assert_eq(l.color_b, 80)
    end

    it("light_miners sets MAINTAIN_SHADOWS") do ->
      var l = lt::light_miners(0, 0, 6)
      var has = lt::light_flag_has(l.flags, lt::LIGHT_FLAG_MAINTAIN_SHADOWS())
      if has
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("light_torch_flicker sets FLICKER and flicker_pct=15") do ->
      var l = lt::light_torch_flicker(0, 0, 4)
      var has = lt::light_flag_has(l.flags, lt::LIGHT_FLAG_FLICKER())
      if has
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(l.flicker_pct, 15)
    end
  end

  describe("Light flag bits — distinct values") do ->
    it("MAINTAIN_SHADOWS / MAGICAL / FLICKER are distinct") do ->
      var a = lt::LIGHT_FLAG_MAINTAIN_SHADOWS()
      var b = lt::LIGHT_FLAG_MAGICAL()
      var c = lt::LIGHT_FLAG_FLICKER()
      if a == b
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      if a == c
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      if b == c
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("light_flag_has detects set bits") do ->
      var combined = lt::LIGHT_FLAG_MAINTAIN_SHADOWS() | lt::LIGHT_FLAG_FLICKER()
      var has_ms = lt::light_flag_has(combined, lt::LIGHT_FLAG_MAINTAIN_SHADOWS())
      var has_fl = lt::light_flag_has(combined, lt::LIGHT_FLAG_FLICKER())
      var has_mg = lt::light_flag_has(combined, lt::LIGHT_FLAG_MAGICAL())
      if has_ms and has_fl and not has_mg
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("LightBuffer — construction") do ->
    it("light_buffer_new sets dimensions") do ->
      var buf = lt::light_buffer_new(8, 4, 10, 20, 30)
      assert_eq(buf.width, 8)
      assert_eq(buf.height, 4)
      assert_eq(buf.ambient_r, 10)
      assert_eq(buf.ambient_g, 20)
      assert_eq(buf.ambient_b, 30)
    end

    it("every cell starts at ambient") do ->
      var buf = lt::light_buffer_new(3, 3, 11, 22, 33)
      assert_eq(lt::light_buffer_get_r(buf, 0, 0), 11)
      assert_eq(lt::light_buffer_get_g(buf, 0, 0), 22)
      assert_eq(lt::light_buffer_get_b(buf, 0, 0), 33)
      assert_eq(lt::light_buffer_get_r(buf, 2, 2), 11)
      assert_eq(lt::light_buffer_get_b(buf, 1, 1), 33)
    end

    it("every cell starts in shadow") do ->
      var buf = lt::light_buffer_new(3, 3, 0, 0, 0)
      var s = lt::light_buffer_in_shadow(buf, 1, 1)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("OOB queries return 0 / true (defensive)") do ->
      var buf = lt::light_buffer_new(2, 2, 50, 60, 70)
      assert_eq(lt::light_buffer_get_r(buf, -1, 0), 0)
      assert_eq(lt::light_buffer_get_r(buf, 2, 0), 0)
      assert_eq(lt::light_buffer_get_g(buf, 0, -1), 0)
      var s = lt::light_buffer_in_shadow(buf, 99, 99)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("light_buffer_clear resets to ambient") do ->
      var buf0 = lt::light_buffer_new(3, 3, 5, 5, 5)
      var torch = lt::light_torch(1, 1, 2)
      var buf1 = lt::light_buffer_paint(buf0, torch, 0, _block_none)
      var buf2 = lt::light_buffer_clear(buf1)
      # After clear: every cell back to ambient (5,5,5).
      assert_eq(lt::light_buffer_get_r(buf2, 1, 1), 5)
      assert_eq(lt::light_buffer_get_g(buf2, 1, 1), 5)
      var s = lt::light_buffer_in_shadow(buf2, 1, 1)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("light_buffer_paint — no obstructions") do ->
    it("radius=0 is a no-op") do ->
      var buf0 = lt::light_buffer_new(5, 5, 10, 10, 10)
      var l = lt::light_new(2, 2, 100, 100, 100, 0, 0, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      assert_eq(lt::light_buffer_get_r(buf1, 2, 2), 10)
      var s = lt::light_buffer_in_shadow(buf1, 2, 2)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("origin gets full color (multiplier=100)") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      # color (200, 100, 50), radius 4, fade_to_pct=0 (full falloff).
      var l = lt::light_new(2, 2, 200, 100, 50, 4, 0, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # At origin: distance=0, multiplier=100, contribution=(200,100,50).
      assert_eq(lt::light_buffer_get_r(buf1, 2, 2), 200)
      assert_eq(lt::light_buffer_get_g(buf1, 2, 2), 100)
      assert_eq(lt::light_buffer_get_b(buf1, 2, 2), 50)
    end

    it("fade_to_pct=100 produces constant intensity in disk") do ->
      var buf0 = lt::light_buffer_new(7, 7, 0, 0, 0)
      var l = lt::light_new(3, 3, 50, 50, 50, 3, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # Origin: full intensity = (50, 50, 50).
      assert_eq(lt::light_buffer_get_r(buf1, 3, 3), 50)
      # Cell at (3, 4): distance=1, multiplier=100 (no falloff).
      assert_eq(lt::light_buffer_get_r(buf1, 3, 4), 50)
      # Cell at (5, 3): distance=2, still 100.
      assert_eq(lt::light_buffer_get_r(buf1, 5, 3), 50)
    end

    it("fade_to_pct=0 fades to zero at radius edge") do ->
      var buf0 = lt::light_buffer_new(7, 7, 0, 0, 0)
      var l = lt::light_new(3, 3, 100, 0, 0, 3, 0, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # Cell at distance 3 (edge of radius): multiplier=0 → contribution=0.
      assert_eq(lt::light_buffer_get_r(buf1, 0, 3), 0)
      assert_eq(lt::light_buffer_get_r(buf1, 6, 3), 0)
      # Cell at distance ~1 (3,4): multiplier ≈ 67, contribution ≈ 67.
      var r_close = lt::light_buffer_get_r(buf1, 3, 4)
      if r_close > 50 and r_close < 80
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("cells beyond radius are not lit") do ->
      var buf0 = lt::light_buffer_new(20, 20, 0, 0, 0)
      var l = lt::light_new(10, 10, 100, 100, 100, 3, 0, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # Way outside the radius — still ambient (0).
      assert_eq(lt::light_buffer_get_r(buf1, 0, 0), 0)
      assert_eq(lt::light_buffer_get_r(buf1, 19, 19), 0)
      var s = lt::light_buffer_in_shadow(buf1, 0, 0)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("origin near edge of buffer clips silently") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_new(0, 0, 80, 80, 80, 3, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # Cells outside the buffer don't crash; in-bounds cells are lit.
      assert_eq(lt::light_buffer_get_r(buf1, 0, 0), 80)
      assert_eq(lt::light_buffer_get_r(buf1, 1, 0), 80)
    end
  end

  describe("light_buffer_paint — obstructions") do ->
    it("LOS blocked: cell behind wall not lit") do ->
      # Light at (1, 1), radius 5, wall at (3, 3). Cell at (5, 5) is
      # behind the wall on the diagonal — Bresenham line passes
      # through (3, 3) → blocked.
      var buf0 = lt::light_buffer_new(8, 8, 0, 0, 0)
      var l = lt::light_new(1, 1, 100, 100, 100, 6, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_at_3_3)
      assert_eq(lt::light_buffer_get_r(buf1, 5, 5), 0)
      # Wall cell itself IS lit (walls reflect / are visible).
      assert_eq(lt::light_buffer_get_r(buf1, 3, 3), 100)
    end

    it("LOS clear: cell on un-occluded path is lit") do ->
      var buf0 = lt::light_buffer_new(8, 8, 0, 0, 0)
      var l = lt::light_new(1, 1, 100, 100, 100, 6, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_at_3_3)
      # Cell at (1, 5) — straight south from origin, no occluder.
      assert_eq(lt::light_buffer_get_r(buf1, 1, 5), 100)
    end

    it("wall column casts shadow cone") do ->
      var buf0 = lt::light_buffer_new(10, 5, 0, 0, 0)
      var l = lt::light_new(2, 2, 50, 50, 50, 6, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_col_4)
      # Wall cells (x=4) themselves are lit.
      assert_eq(lt::light_buffer_get_r(buf1, 4, 2), 50)
      # Cells past the wall (x=6, 7) are NOT lit.
      assert_eq(lt::light_buffer_get_r(buf1, 6, 2), 0)
      assert_eq(lt::light_buffer_get_r(buf1, 7, 2), 0)
    end
  end

  describe("MAINTAIN_SHADOWS flag") do ->
    it("paint without flag clears shadow_flags") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_torch(2, 2, 2)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var s = lt::light_buffer_in_shadow(buf1, 2, 2)
      if s
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("paint with flag preserves shadow_flags") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_miners(2, 2, 2)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var s = lt::light_buffer_in_shadow(buf1, 2, 2)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("unlit cell remains in shadow regardless of flag") do ->
      var buf0 = lt::light_buffer_new(10, 10, 0, 0, 0)
      var l = lt::light_torch(1, 1, 2)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      # Cell (8, 8) is way outside the torch — still in shadow.
      var s = lt::light_buffer_in_shadow(buf1, 8, 8)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("Light composition — additive accumulation") do ->
    it("two lights at same cell sum contributions") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l1 = lt::light_new(2, 2, 50, 0, 0, 1, 100, 0, 0)
      var l2 = lt::light_new(2, 2, 30, 0, 0, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l1, 0, _block_none)
      var buf2 = lt::light_buffer_paint(buf1, l2, 0, _block_none)
      # 50 + 30 = 80.
      assert_eq(lt::light_buffer_get_r(buf2, 2, 2), 80)
    end

    it("accumulation clamps at 255") do ->
      var buf0 = lt::light_buffer_new(3, 3, 0, 0, 0)
      var bright = lt::light_new(1, 1, 200, 200, 200, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, bright, 0, _block_none)
      var buf2 = lt::light_buffer_paint(buf1, bright, 0, _block_none)
      assert_eq(lt::light_buffer_get_r(buf2, 1, 1), 255)
      assert_eq(lt::light_buffer_get_g(buf2, 1, 1), 255)
      assert_eq(lt::light_buffer_get_b(buf2, 1, 1), 255)
    end
  end

  describe("light_buffer_apply — plane composition") do ->
    it("default-color cell takes buffer RGB substituted") do ->
      var buf0 = lt::light_buffer_new(3, 3, 0, 0, 0)
      var l = lt::light_new(1, 1, 120, 80, 40, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var pa = pl::plane_create(3, 3)
      var pb = lt::light_buffer_apply(buf1, pa)
      var c = pl::plane_getc(pb, 1, 1)
      assert_eq(_r_of(c.bg.color), 120)
      assert_eq(_g_of(c.bg.color), 80)
      assert_eq(_b_of(c.bg.color), 40)
      var d_color = c.bg.default_color
      if d_color
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("truecolor cell additive blend with buffer") do ->
      var buf0 = lt::light_buffer_new(3, 3, 0, 0, 0)
      var l = lt::light_new(1, 1, 30, 30, 30, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var pa = pl::plane_create(3, 3)
      # Place a cell with truecolor bg = (40, 60, 80).
      var bg_chan = cl::channel_rgb(_rgb(40, 60, 80))
      var lit_cell = cl::cell_with_bg(cl::cell_char("X"), bg_chan)
      var pb = pl::plane_putc(pa, 1, 1, lit_cell)
      var pc = lt::light_buffer_apply(buf1, pb)
      var c = pl::plane_getc(pc, 1, 1)
      # 40+30=70, 60+30=90, 80+30=110.
      assert_eq(_r_of(c.bg.color), 70)
      assert_eq(_g_of(c.bg.color), 90)
      assert_eq(_b_of(c.bg.color), 110)
    end

    it("truecolor blend clamps at 255") do ->
      var buf0 = lt::light_buffer_new(3, 3, 0, 0, 0)
      var l = lt::light_new(1, 1, 200, 200, 200, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var pa = pl::plane_create(3, 3)
      var bright = cl::channel_rgb(_rgb(200, 200, 200))
      var lit_cell = cl::cell_with_bg(cl::cell_char("X"), bright)
      var pb = pl::plane_putc(pa, 1, 1, lit_cell)
      var pc = lt::light_buffer_apply(buf1, pb)
      var c = pl::plane_getc(pc, 1, 1)
      assert_eq(_r_of(c.bg.color), 255)
      assert_eq(_g_of(c.bg.color), 255)
      assert_eq(_b_of(c.bg.color), 255)
    end

    it("apply preserves egc and attrs") do ->
      var buf0 = lt::light_buffer_new(3, 3, 0, 0, 0)
      var l = lt::light_torch(1, 1, 2)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var pa = pl::plane_create(3, 3)
      var c0 = cl::cell_add_attr(cl::cell_char("@"), cl::CELL_ATTR_BOLD())
      var pb = pl::plane_putc(pa, 1, 1, c0)
      var pc = lt::light_buffer_apply(buf1, pb)
      var c = pl::plane_getc(pc, 1, 1)
      assert_eq_str(c.egc, "@")
      var has_bold = cl::cell_attr_has(c.attrs, cl::CELL_ATTR_BOLD())
      if has_bold
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("ambient buffer tints default-color cells") do ->
      # No lights painted — apply just substitutes ambient onto
      # default-color cells.
      var buf = lt::light_buffer_new(2, 2, 25, 35, 45)
      var pa = pl::plane_create(2, 2)
      var pb = lt::light_buffer_apply(buf, pa)
      var c = pl::plane_getc(pb, 0, 0)
      assert_eq(_r_of(c.bg.color), 25)
      assert_eq(_g_of(c.bg.color), 35)
      assert_eq(_b_of(c.bg.color), 45)
    end
  end

  describe("Flicker — deterministic per-frame jitter") do ->
    it("FLICKER set: different frames produce different multipliers") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_new(2, 2, 100, 100, 100, 3, 100,
                            lt::LIGHT_FLAG_FLICKER(), 20)
      var f1 = lt::light_buffer_paint(buf0, l, 1, _block_none)
      var f2 = lt::light_buffer_paint(buf0, l, 2, _block_none)
      var v1 = lt::light_buffer_get_r(f1, 2, 2)
      var v2 = lt::light_buffer_get_r(f2, 2, 2)
      # They should differ (deterministic but frame-keyed).
      if v1 == v2
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("FLICKER set: same frame reproduces same jitter") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_new(2, 2, 100, 100, 100, 3, 100,
                            lt::LIGHT_FLAG_FLICKER(), 20)
      var a = lt::light_buffer_paint(buf0, l, 42, _block_none)
      var b = lt::light_buffer_paint(buf0, l, 42, _block_none)
      var va = lt::light_buffer_get_r(a, 2, 2)
      var vb = lt::light_buffer_get_r(b, 2, 2)
      assert_eq(va, vb)
    end

    it("FLICKER clear: frame is ignored") do ->
      var buf0 = lt::light_buffer_new(5, 5, 0, 0, 0)
      var l = lt::light_new(2, 2, 100, 100, 100, 3, 100, 0, 0)
      var f1 = lt::light_buffer_paint(buf0, l, 1, _block_none)
      var f2 = lt::light_buffer_paint(buf0, l, 99999, _block_none)
      var v1 = lt::light_buffer_get_r(f1, 2, 2)
      var v2 = lt::light_buffer_get_r(f2, 2, 2)
      assert_eq(v1, v2)
    end
  end

  describe("End-to-end pipeline") do ->
    it("ambient + paint + apply produces lit plane") do ->
      # Build a 5x3 plane filled with default-color blank cells, light
      # the middle column with a torch, apply, verify center column got
      # the warm RGB and edges stayed at ambient.
      var buf0 = lt::light_buffer_new(5, 3, 10, 10, 20)
      var l = lt::light_new(2, 1, 200, 100, 50, 1, 100, 0, 0)
      var buf1 = lt::light_buffer_paint(buf0, l, 0, _block_none)
      var pa = pl::plane_create(5, 3)
      var pb = lt::light_buffer_apply(buf1, pa)
      var center = pl::plane_getc(pb, 2, 1)
      # Center: ambient (10,10,20) + light (200,100,50) = (210,110,70).
      assert_eq(_r_of(center.bg.color), 210)
      assert_eq(_g_of(center.bg.color), 110)
      assert_eq(_b_of(center.bg.color), 70)
      # Edge: still ambient.
      var edge = pl::plane_getc(pb, 0, 0)
      assert_eq(_r_of(edge.bg.color), 10)
      assert_eq(_g_of(edge.bg.color), 10)
      assert_eq(_b_of(edge.bg.color), 20)
    end
  end

  return qspec_main()
end
