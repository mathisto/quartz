## scope_with + current_scope (B.7 Phase 3)
##
## Contract:
##   1. current_scope() returns root when nothing has been pushed.
##   2. Inside scope_with(s, body), current_scope() returns s.
##   3. After scope_with returns, current_scope() is restored to the
##      previous value.
##   4. scope_with auto-cancels s on normal exit.
##   5. scope_with auto-cancels s on throw exit (cleanup is throw-safe).
##   6. A throw inside body propagates past scope_with to the next outer
##      `with Throws { throw: handler }`.
##   7. Nested scope_with composes: inner restores intermediate, outer
##      restores root; auto-cancel fires for each.
##   8. scope_check inside body throws the cancel reason; caught by an
##      outer `with Throws`.

import * from qspec
import * from std/sync/composition/scope
import * from std/throws

# Captures for handler-driven assertions.
var sw_caught_msg = ""
var sw_caught_count = 0

def sw_capture(op_name: Int, argc: Int, argv: Int): Int
  sw_caught_msg = as_type<String>(load(argv, 0))
  sw_caught_count += 1
  return 0
end

# Test bodies (named functions to keep closure shapes simple).
var sw_body_observed = 0
var sw_outer_observed_inside = 0
var sw_outer_observed_after_inner = 0
var sw_inner_scope = 0
var sw_outer_scope = 0

def sw_body_records_current(): Int
  sw_body_observed = current_scope()
  return 7
end

def sw_body_throws(): Int
  throw("boom-from-body")
  return 0
end

def sw_inner_body(): Int
  sw_inner_scope = current_scope()
  return 0
end

def sw_outer_body(): Int
  sw_outer_observed_inside = current_scope()
  scope_with(scope_with_cancel(scope_outer_for_nest), sw_inner_body)
  sw_outer_observed_after_inner = current_scope()
  return 0
end

# Used by the nesting test to give the outer body a fixed parent.
var scope_outer_for_nest = 0

def sw_self_check_body(): Int
  scope_cancel_with(current_scope(), "kicked")
  scope_check(current_scope())
  return 99   # NOT reached — check throws via Throws
end

def main(): Int
  describe("scope_with + current_scope (B.7 Phase 3)") do ->

    it("current_scope() defaults to root when nothing pushed") do ->
      assert_eq(current_scope(), scope_root())
    end

    it("scope_with installs s as the current scope inside body") do ->
      sw_body_observed = 0
      var s = scope_with_cancel(scope_root())
      var r = scope_with(s, sw_body_records_current)
      assert_eq(r, 7)
      assert_eq(sw_body_observed, s)
    end

    it("scope_with restores the previous current scope after body") do ->
      var s = scope_with_cancel(scope_root())
      var before = current_scope()
      scope_with(s, sw_body_records_current)
      assert_eq(current_scope(), before)
    end

    it("scope_with auto-cancels s on normal exit") do ->
      var s = scope_with_cancel(scope_root())
      assert_eq(scope_is_cancelled(s), false)
      scope_with(s, sw_body_records_current)
      assert_eq(scope_is_cancelled(s), true)
      assert_eq_str(scope_cancel_reason(s), "cancelled")
    end

    it("scope_with auto-cancels s even when body throws") do ->
      sw_caught_msg = ""
      sw_caught_count = 0
      var s = scope_with_cancel(scope_root())
      var r = with Throws { throw: sw_capture } do ->
        scope_with(s, sw_body_throws)
        # If the throw escapes scope_with as designed, this assignment
        # is unreached and the with-block resolves via sw_capture's
        # return (0).
        99
      end
      assert_eq(r, 0)
      assert_eq_str(sw_caught_msg, "boom-from-body")
      assert_eq(sw_caught_count, 1)
      # Critical: scope MUST have been cancelled even though body threw.
      assert_eq(scope_is_cancelled(s), true)
    end

    it("scope_with restores current_scope even when body throws") do ->
      sw_caught_msg = ""
      var s = scope_with_cancel(scope_root())
      var before = current_scope()
      var _r = with Throws { throw: sw_capture } do ->
        scope_with(s, sw_body_throws)
        0
      end
      assert_eq(current_scope(), before)
    end

    it("nested scope_with composes — inner restores to intermediate") do ->
      sw_inner_scope = 0
      sw_outer_observed_inside = 0
      sw_outer_observed_after_inner = 0
      scope_outer_for_nest = scope_with_cancel(scope_root())
      var inner_observed_after = 0
      scope_with(scope_outer_for_nest, sw_outer_body)
      assert_eq(sw_outer_observed_inside, scope_outer_for_nest)
      # Inner pushed a child of outer; inside inner_body we recorded its handle.
      var inner_is_child_of_outer = 0
      if sw_inner_scope != scope_outer_for_nest and sw_inner_scope != 0
        inner_is_child_of_outer = 1
      end
      assert_eq(inner_is_child_of_outer, 1)
      # After inner returned, outer is current again.
      assert_eq(sw_outer_observed_after_inner, scope_outer_for_nest)
      # After outer returned, root again.
      assert_eq(current_scope(), scope_root())
      # Both scopes cancelled.
      assert_eq(scope_is_cancelled(scope_outer_for_nest), true)
      assert_eq(scope_is_cancelled(sw_inner_scope), true)
    end

    it("scope_check inside body throws — caught by outer with-Throws") do ->
      sw_caught_msg = ""
      var s = scope_with_cancel(scope_root())
      var _r = with Throws { throw: sw_capture } do ->
        scope_with(s, sw_self_check_body)
        0
      end
      assert_eq_str(sw_caught_msg, "kicked")
      assert_eq(scope_is_cancelled(s), true)
    end
  end

  return qspec_main()
end
