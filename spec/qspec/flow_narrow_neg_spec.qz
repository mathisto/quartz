## SURF.FLOW A1 — general negation narrowing `not (x is T)` / `!pred`.
## The guard classifier treats a logical negation (NODE_UNARY op=13 / OpNot) of a
## classifiable guard as a THEN/ELSE swap of the inner guard's proven facts. The
## complement of a SOUND guard is sound (FLOW_NARROWING §3.3):
##   - `not (o is Some)`  → THEN proves None (no payload), ELSE narrows o to Some (T).
##   - `!o.some?`         → same complement (some? then=Some/else="" ⇒ swap: else=Some).
##   - `not (r is Ok)`    → THEN narrows r to Err (E readable), ELSE narrows r to Ok (T).
##   - 3-variant `not (e is A)` → inner is THEN-only (then=A/else="") ⇒ swap yields
##     ELSE-only (then=""/else=A): the negated-false/else branch narrows to A; the
##     negated-true branch narrows nothing (e could be B or C). Sound.
##   - negation of a NON-narrowing condition (`not (a > b)`) narrows nothing.
##
## Behavioral signal (same as flow_narrow_p2/p3): a CORRECT narrowing makes a bare
## read yield the exact inner payload (42 → use_int → 142); an un-narrowed read passes
## the raw enum word (≠ the payload). So a determinate `== value` proves narrowing
## fired; the negative case proves no bogus narrowing corrupted control flow.
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x
def use_str(s: String): String = s

struct Box
  v: Int
end

def box_v(b: Box): Int = b.v

# --- Option: `not (o is Some)` else-narrows to Some's T ---

## `if not (o is Some) ... else <o narrowed to Some>` — else narrows o to inner Int.
def not_is_some_else_narrows(): Int
  o: Option<Int> = option_some(42)
  var out = 0
  if not (o is Some)
    out = -1
  else
    out = use_int(o)   # o narrowed to Some payload (Int) in the else
  end
  return out
end

## `if !o.some? ... else <o narrowed>` — `!pred` else-narrows to Some's T.
def bang_some_pred_else_narrows(): Int
  o: Option<Int> = option_some(42)
  var out = 0
  if !o.some?
    out = -1
  else
    out = use_int(o)
  end
  return out
end

## `not (o is None)` THEN-narrows to Some (double complement of a negative guard):
## inner `is None` gives then=""/else=Some ⇒ swap ⇒ then=Some/else="". So the THEN
## branch narrows o to Some's T.
def not_is_none_then_narrows(): Int
  o: Option<Int> = option_some(42)
  var out = 0
  if not (o is None)
    out = use_int(o)   # o narrowed to Some in the THEN branch
  end
  return out
end

# --- Result: `not (r is Ok)` THEN-narrows to Err (E), ELSE-narrows to Ok (T) ---

## `if not (r is Ok)` — THEN narrows r to Err's E (String); the swap makes the
## negated-true branch the Err branch.
def not_is_ok_then_narrows_err(): String
  r: Result<Int, String> = Result::Err("boom")
  var out = "MISS"
  if not (r is Ok)
    out = use_str(r)   # r narrowed to Err payload (String) in the THEN branch
  end
  return out
end

## `if not (r is Ok) ... else <r narrowed to Ok>` — the else narrows r to Ok's T.
def not_is_ok_else_narrows_ok(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if not (r is Ok)
    out = -1
  else
    out = use_int(r)   # r narrowed to Ok payload (Int) in the else
  end
  return out
end

## `!r.ok?` else-narrows r to Ok's T (predicate form).
def bang_ok_pred_else_narrows(): Int
  r: Result<Int, String> = Result::Ok(42)
  var out = 0
  if !r.ok?
    out = -1
  else
    out = use_int(r)
  end
  return out
end

## guard-style: `if not (r is Ok) return end; use(r as T)` — after the diverging
## THEN, r narrows to Ok (the else fact) in the enclosing scope.
def not_is_ok_guard_style(): Int
  r: Result<Int, String> = Result::Ok(42)
  if not (r is Ok)
    return -1
  end
  return use_int(r)   # r narrowed to Ok-T after the guard
end

# --- 3-variant user enum: `not (e is A)` ELSE-narrows to A ---

enum Tri
  A(box: Box)
  B(box: Box)
  C
end

## `if not (e is A) ... else <e narrowed to A>` — inner `is A` is THEN-only
## (then=A/else="") ⇒ swap ⇒ ELSE-only (then=""/else=A). The else narrows e to A's
## Box payload; the THEN narrows nothing (e could be B or C).
def not_is_a_else_narrows_a(): Int
  e: Tri = Tri::A(Box { v: 11 })
  var out = 0
  if not (e is A)
    out = -1
  else
    out = box_v(e)   # e narrowed to A's Box in the else
  end
  return out
end

## SOUNDNESS: the THEN branch of `not (e is A)` narrows NOTHING (e is B or C). We
## prove it by taking the THEN branch on a B value and reading it via an explicit
## match — a bogus narrow-to-A would have been observable, but the THEN table has no
## refinement, so the explicit match is the only way to read the payload.
def not_is_a_then_no_narrow(): Int
  e: Tri = Tri::B(Box { v: 13 })
  var out = 0
  if not (e is A)
    out = match e
      A(b) => box_v(b)
      B(b) => box_v(b)
      C    => -2
    end
  end
  return out
end

# --- NEGATIVE: negating a non-narrowing condition narrows nothing ---

## `not (a > b)` classifies to no subject → the NOT branch bails (inner subj < 0) →
## no narrowing fires. We prove control flow is uncorrupted: the else reads a real
## Option value via explicit unwrap (a bogus narrow would not have applied to `o` at
## all, but this pins that negating an arbitrary boolean does not spuriously narrow
## an in-scope Option). o really is Some(77).
def not_of_comparison_no_narrow(): Int
  a: Int = 1
  b: Int = 2
  o: Option<Int> = option_some(77)
  var out = 0
  if not (a > b)
    out = o.unwrap()   # a > b is false ⇒ THEN fires; o unwrapped explicitly = 77
  else
    out = -1
  end
  return out
end

def main(): Int
  describe("SURF.FLOW A1 — negation narrowing (Option)") do ->
    it("`not (o is Some)` else-narrows o to Some's T") do ->
      assert_eq(not_is_some_else_narrows(), 142)
    end
    it("`!o.some?` else-narrows o to Some's T") do ->
      assert_eq(bang_some_pred_else_narrows(), 142)
    end
    it("`not (o is None)` then-narrows o to Some's T") do ->
      assert_eq(not_is_none_then_narrows(), 142)
    end
  end

  describe("SURF.FLOW A1 — negation narrowing (Result)") do ->
    it("`not (r is Ok)` then-narrows r to Err's E") do ->
      assert_eq_str(not_is_ok_then_narrows_err(), "boom")
    end
    it("`not (r is Ok)` else-narrows r to Ok's T") do ->
      assert_eq(not_is_ok_else_narrows_ok(), 142)
    end
    it("`!r.ok?` else-narrows r to Ok's T") do ->
      assert_eq(bang_ok_pred_else_narrows(), 142)
    end
    it("guard-style `if not (r is Ok) return end` narrows r to Ok-T after") do ->
      assert_eq(not_is_ok_guard_style(), 142)
    end
  end

  describe("SURF.FLOW A1 — negation narrowing (3-variant enum, sound)") do ->
    it("`not (e is A)` else-narrows e to A's payload") do ->
      assert_eq(not_is_a_else_narrows_a(), 11)
    end
    it("`not (e is A)` THEN narrows nothing (3-variant sound)") do ->
      assert_eq(not_is_a_then_no_narrow(), 13)
    end
  end

  describe("SURF.FLOW A1 — negation narrowing (soundness: no bogus narrow)") do ->
    it("negating a non-narrowing condition narrows nothing") do ->
      assert_eq(not_of_comparison_no_narrow(), 77)
    end
  end

  return qspec_main()
end
