## Toml Stringify Tests
##
## Contract:
##   1. Scalar: stringifies String, Int, Bool, Array values.
##   2. Table: stringifies table with key-value pairs.
##   3. UFCS predicates: `.is_string()`, `.is_int()`, `.is_bool()` via dot syntax.
##   4. Negative predicates: wrong type returns false.
import * from qspec
import * from toml/value
import * from toml/stringify

def main(): Int
  describe("toml stringify") do ->
    it("stringifies scalar values") do ->
      assert_eq_str(toml_stringify_value(TomlValue::String("hi")), "\"hi\"")
      assert_eq_str(toml_stringify_value(TomlValue::Int(42)), "42")
      assert_eq_str(toml_stringify_value(TomlValue::Bool(true)), "true")
      assert_eq_str(toml_stringify_value(TomlValue::Bool(false)), "false")
      var items = vec_new<TomlValue>()
      items.push(TomlValue::Int(1))
      items.push(TomlValue::Int(2))
      assert_eq_str(toml_stringify_value(TomlValue::Array(items)), "[1, 2]")
    end

    it("stringifies table with key-value pairs") do ->
      var tbl = toml_table_new()
      toml_table_set(tbl, "name", TomlValue::String("test"))
      toml_table_set(tbl, "port", TomlValue::Int(8080))
      var output = toml_stringify(TomlValue::Table(tbl))
      assert_eq(str_contains(output, "name = \"test\""), true)
      assert_eq(str_contains(output, "port = 8080"), true)
    end
  end

  describe("toml UFCS predicates") do ->
    it("type checks via dot syntax") do ->
      assert_eq(TomlValue::String("hi").is_string(), true)
      assert_eq(TomlValue::Int(42).is_int(), true)
      assert_eq(TomlValue::Bool(true).is_bool(), true)
      assert_eq(TomlValue::Int(42).is_string(), false)
      assert_eq(TomlValue::String("hi").is_int(), false)
    end

    it("negative: Bool is not Int") do ->
      assert_eq(TomlValue::Bool(true).is_int(), false)
      assert_eq(TomlValue::Bool(false).is_string(), false)
    end
  end

  return qspec_main()
end
