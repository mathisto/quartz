## Sliceable Tests
##
## Contract:
##   1. Exclusive slice elements have.
##   2. For loop with range.
##   3. Full slice v[0..len] returns.
##   4. Inclusive slice elements have.
##   5. Negative indexing still works.
##   6. Normal indexing still works.
import * from qspec

def main(): Int
  describe("sliceable trait") do ->
    it("v[1..3] returns correct length") do ->
      assert_eq(sla_exclusive_len(), 2)
    end
    it("exclusive slice elements have correct values") do ->
      assert_eq(sla_exclusive_vals(), 90)
    end
    it("v[1...3] returns correct length") do ->
      assert_eq(sla_inclusive_len(), 3)
    end
    it("inclusive slice elements have correct values") do ->
      assert_eq(sla_inclusive_vals(), 90)
    end
    it("full slice v[0..len] returns copy") do ->
      assert_eq(sla_full_slice(), 36)
    end
    it("single element slice v[2..3]") do ->
      assert_eq(sla_single_elem(), 130)
    end
    it("normal indexing still works") do ->
      assert_eq(sla_normal_index(), 20)
    end
    it("negative indexing still works") do ->
      assert_eq(sla_negative_index(), 30)
    end
    it("for loop with range still works") do ->
      assert_eq(sla_for_range(), 10)
    end
  end
  return qspec_main()
end

def sla_exclusive_len(): Int
  var v = [10, 20, 30, 40, 50]
  var s = v[1..3]
  return s.size
end

def sla_exclusive_vals(): Int
  var v = [10, 20, 30, 40, 50]
  var s = v[1..4]
  return s[0] + s[1] + s[2]
end

def sla_inclusive_len(): Int
  var v = [10, 20, 30, 40, 50]
  var s = v[1...3]
  return s.size
end

def sla_inclusive_vals(): Int
  var v = [10, 20, 30, 40, 50]
  var s = v[1...3]
  return s[0] + s[1] + s[2]
end

def sla_full_slice(): Int
  var v = [1, 2, 3]
  var s = v[0..3]
  return s.size * 10 + s[0] + s[1] + s[2]
end

def sla_single_elem(): Int
  var v = [10, 20, 30, 40, 50]
  var s = v[2..3]
  return s.size * 100 + s[0]
end

def sla_normal_index(): Int
  var v = [10, 20, 30]
  return v[1]
end

def sla_negative_index(): Int
  var v = [10, 20, 30]
  return v[-1]
end

def sla_for_range(): Int
  var sum = 0
  for i in 0..5
    sum = sum + i
  end
  return sum
end
