## B.10 P2.3 — GC firewall for the by-value @value return ABI.
##
## A @value struct that mixes raw-bit SCALAR slots (Int/Bool/narrow ints/floats)
## and tracked-POINTER slots (String, Vec, ... heap) in one block cannot ride the
## unboxed `ret {i64 x N}` aggregate: a future GC scanning the reconstructed block
## cannot tell pointers from bits without a scan_map. Until then, mixed structs
## fall back to the conservative boxed (__qz_alloc) return; homogeneous structs
## (all-scalar, all-pointer) stay on the byval path.
##
## These tests assert BEHAVIORAL correctness — values round-trip out of a
## by-value return regardless of which ABI path the struct takes:
##   firewall.a — MIXED (Int + String): rides the boxed fallback, values correct.
##   firewall.b — all-scalar (Int + Int + Bool): byval path, values correct.
##   firewall.c — all-pointer (String + String): byval path, values correct.
##   firewall.d — MIXED with a narrow int + String: boxed fallback, values correct.

import * from qspec
import * from qspec/subprocess

# firewall.a — MIXED scalar+pointer (Int + String). Boxed fallback path.
var _MIXED: String = """@value
struct Tagged
  id: Int
  name: String
end

def make_tagged(i: Int, n: String): Tagged
  return Tagged { id: i, name: n }
end

def main(): Int
  t = make_tagged(42, \"hello\")
  puts(str_from_int(t.id) + \",\" + t.name)
  return 0
end
"""

# firewall.b — all-scalar (Int + Int + Bool). Byval path.
var _ALL_SCALAR: String = """@value
struct Triple
  a: Int
  b: Int
  c: Bool
end

def make_triple(x: Int, y: Int, z: Bool): Triple
  return Triple { a: x, b: y, c: z }
end

def main(): Int
  t = make_triple(7, 13, true)
  var flag = 0
  flag = 1 if t.c
  puts(str_from_int(t.a) + \",\" + str_from_int(t.b) + \",\" + str_from_int(flag))
  return 0
end
"""

# firewall.c — all-pointer (String + String). Byval path.
var _ALL_PTR: String = """@value
struct Pair
  first: String
  second: String
end

def make_pair(a: String, b: String): Pair
  return Pair { first: a, second: b }
end

def main(): Int
  p = make_pair(\"foo\", \"bar\")
  puts(p.first + \"-\" + p.second)
  return 0
end
"""

# firewall.d — MIXED narrow int + String. Boxed fallback path.
var _MIXED_NARROW: String = """@value
struct Labeled
  code: U8
  label: String
end

def make_labeled(c: U8, l: String): Labeled
  return Labeled { code: c, label: l }
end

def main(): Int
  x = make_labeled(200, \"ok\")
  puts(str_from_int(x.code) + \",\" + x.label)
  return 0
end
"""

def main(): Int
  describe("B.10 P2.3 GC firewall — mixed scalar+pointer @value structs return correct values via boxed fallback") do ->
    it("MIXED (Int + String) round-trips correct values") do ->
      assert_run_stdout_eq(_MIXED, "42,hello\n")
    end

    it("all-scalar (Int + Int + Bool) round-trips correct values (byval path)") do ->
      assert_run_stdout_eq(_ALL_SCALAR, "7,13,1\n")
    end

    it("all-pointer (String + String) round-trips correct values (byval path)") do ->
      assert_run_stdout_eq(_ALL_PTR, "foo-bar\n")
    end

    it("MIXED narrow (U8 + String) round-trips correct values") do ->
      assert_run_stdout_eq(_MIXED_NARROW, "200,ok\n")
    end
  end
  return qspec_main()
end
