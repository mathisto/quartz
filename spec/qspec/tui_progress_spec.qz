## std/tui/widgets/progress behavior tests.
##
## Coverage:
##   - Constructor / builder shape
##   - progress_bar_view output (non-TTY context: SGR-stripped text)
##     - empty bar (current=0)
##     - full bar (current=max)
##     - partial fill (50%)
##     - current > max clamps to max
##     - current < 0 clamps to 0
##     - max <= 0 returns ""
##     - width == 0 produces "[] cur/max"
##     - width < 0 also produces "[] cur/max"
##   - progress_bar_percent
##   - progress_bar_gradient_color thresholds (red <25 / yellow <50 / green ≥50)
##   - auto_gradient toggle preserves through builders
##
## View assertions compare against plain ASCII / UTF-8. To make these
## robust whether the spec runs piped (no-TTY → depth 0) or interactively
## (TTY → depth > 0), `main()` sets NO_COLOR=1 before any test body runs.
## `term_color_depth` is uninitialised at module load so its first call
## picks up the post-setenv environment; `Style.render` then returns
## text unchanged regardless of how the binary was invoked.

import * from qspec
import std/tui/widgets/progress as pg
import style

# ============================================================
# Constructors / builders
# ============================================================

def test_progress_new_defaults(): Void
  var p = pg::progress_bar_new(50, 100)
  assert_eq(p.current, 50)
  assert_eq(p.max, 100)
  assert_eq(p.width, 20)
  if p.auto_gradient
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_progress_with_size_updates_width(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(0, 10), 32)
  assert_eq(p.width, 32)
end

def test_progress_set_updates_current(): Void
  var p = pg::progress_bar_set(pg::progress_bar_new(0, 10), 7)
  assert_eq(p.current, 7)
  assert_eq(p.max, 10)
end

def test_progress_with_auto_gradient_off(): Void
  var p = pg::progress_bar_with_auto_gradient(pg::progress_bar_new(0, 10), false)
  if p.auto_gradient
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_progress_with_styles_preserves_auto_gradient(): Void
  var custom = pg::ProgressBarStyles {
    fill:   Style.new().fg(style::Cyan()),
    empty:  Style.new(),
    border: Style.new()
  }
  var base = pg::progress_bar_new(5, 10)
  var p = pg::progress_bar_with_styles(base, custom)
  if p.auto_gradient
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# View — exact text output (non-TTY: render returns text verbatim)
# ============================================================

def test_view_full_bar(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(10, 10), 10)
  assert_eq_str(pg::progress_bar_view(p), "[██████████] 10/10")
end

def test_view_empty_bar(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(0, 10), 10)
  assert_eq_str(pg::progress_bar_view(p), "[░░░░░░░░░░] 0/10")
end

def test_view_half_bar(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(5, 10), 10)
  assert_eq_str(pg::progress_bar_view(p), "[█████░░░░░] 5/10")
end

def test_view_current_above_max_clamps(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(15, 10), 10)
  # current saturates to max (10) for fill purposes; count uses
  # the clamped current too so the rendered fraction never reads >max.
  assert_eq_str(pg::progress_bar_view(p), "[██████████] 10/10")
end

def test_view_current_negative_clamps(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(-5, 10), 10)
  assert_eq_str(pg::progress_bar_view(p), "[░░░░░░░░░░] 0/10")
end

def test_view_max_zero_returns_empty(): Void
  var p = pg::progress_bar_new(0, 0)
  assert_eq_str(pg::progress_bar_view(p), "")
end

def test_view_max_negative_returns_empty(): Void
  var p = pg::progress_bar_new(5, -3)
  assert_eq_str(pg::progress_bar_view(p), "")
end

def test_view_width_zero_brackets_only(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(50, 100), 0)
  assert_eq_str(pg::progress_bar_view(p), "[] 50/100")
end

def test_view_width_negative_treated_as_zero(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(50, 100), -8)
  assert_eq_str(pg::progress_bar_view(p), "[] 50/100")
end

# ============================================================
# Sub-cell precision (eighth-block leading edge)
# ============================================================
#
# Bar fill resolves to eighths-of-a-cell. With width=1 and max=8,
# each unit of `current` corresponds to one eighth-block glyph.
# Codepoint table: U+258F (1/8) ▏, U+258E (2/8) ▎, U+258D (3/8) ▍,
# U+258C (4/8) ▌, U+258B (5/8) ▋, U+258A (6/8) ▊, U+2589 (7/8) ▉,
# U+2588 (8/8) █.

def test_view_one_eighth(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(1, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▏] 1/8")
end

def test_view_two_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(2, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▎] 2/8")
end

def test_view_three_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(3, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▍] 3/8")
end

def test_view_four_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(4, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▌] 4/8")
end

def test_view_five_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(5, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▋] 5/8")
end

def test_view_six_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(6, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▊] 6/8")
end

def test_view_seven_eighths(): Void
  var p = pg::progress_bar_with_size(pg::progress_bar_new(7, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▉] 7/8")
end

def test_view_eighth_after_full_cells(): Void
  # 9/16 over width=2 = 9/8 cells = 1 full + 1/8 partial.
  var p = pg::progress_bar_with_size(pg::progress_bar_new(9, 16), 2)
  assert_eq_str(pg::progress_bar_view(p), "[█▏] 9/16")
end

def test_view_eighth_three_cells_in(): Void
  # 27/32 over width=4 = 27*4*8/32 = 27 eighths = 3 full + 3/8 partial.
  var p = pg::progress_bar_with_size(pg::progress_bar_new(27, 32), 4)
  assert_eq_str(pg::progress_bar_view(p), "[███▍] 27/32")
end

def test_view_subpixel_does_not_overflow_track(): Void
  # 7/8 over width=1 → 7 eighths → ▉ + 0 track cells (track was 1, -1 for partial).
  var p = pg::progress_bar_with_size(pg::progress_bar_new(7, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[▉] 7/8")
end

def test_view_full_via_eighths_no_partial(): Void
  # 8/8 over width=1 → 8 eighths = exactly 1 full cell, no partial.
  var p = pg::progress_bar_with_size(pg::progress_bar_new(8, 8), 1)
  assert_eq_str(pg::progress_bar_view(p), "[█] 8/8")
end

# ============================================================
# Accessors
# ============================================================

def test_progress_percent_zero(): Void
  assert_eq(pg::progress_bar_percent(pg::progress_bar_new(0, 10)), 0)
end

def test_progress_percent_full(): Void
  assert_eq(pg::progress_bar_percent(pg::progress_bar_new(10, 10)), 100)
end

def test_progress_percent_clamps_above_max(): Void
  assert_eq(pg::progress_bar_percent(pg::progress_bar_new(50, 10)), 100)
end

def test_progress_percent_clamps_below_zero(): Void
  assert_eq(pg::progress_bar_percent(pg::progress_bar_new(-5, 10)), 0)
end

def test_progress_percent_max_zero_returns_zero(): Void
  assert_eq(pg::progress_bar_percent(pg::progress_bar_new(7, 0)), 0)
end

# ============================================================
# Gradient thresholds — red <25 / yellow [25, 50) / green ≥50
# ============================================================

def test_gradient_below_25_is_red(): Void
  assert_eq(pg::progress_bar_gradient_color(0), style::Red())
  assert_eq(pg::progress_bar_gradient_color(24), style::Red())
end

def test_gradient_25_to_49_is_yellow(): Void
  assert_eq(pg::progress_bar_gradient_color(25), style::Yellow())
  assert_eq(pg::progress_bar_gradient_color(49), style::Yellow())
end

def test_gradient_50_and_above_is_green(): Void
  assert_eq(pg::progress_bar_gradient_color(50), style::Green())
  assert_eq(pg::progress_bar_gradient_color(100), style::Green())
end

def main(): Int
  ## Force Style.render to plain text regardless of TTY detection so
  ## the byte-exact view assertions below work under any invocation.
  var _se = setenv("NO_COLOR", "1")

  describe("constructors and builders") do ->
    it("progress_bar_new sets defaults") do ->
      test_progress_new_defaults()
    end
    it("progress_bar_with_size updates width") do ->
      test_progress_with_size_updates_width()
    end
    it("progress_bar_set updates current only") do ->
      test_progress_set_updates_current()
    end
    it("progress_bar_with_auto_gradient toggles flag") do ->
      test_progress_with_auto_gradient_off()
    end
    it("progress_bar_with_styles preserves auto_gradient") do ->
      test_progress_with_styles_preserves_auto_gradient()
    end
  end

  describe("progress_bar_view boundary cases") do ->
    it("renders a full bar") do ->
      test_view_full_bar()
    end
    it("renders an empty bar") do ->
      test_view_empty_bar()
    end
    it("renders a half-filled bar") do ->
      test_view_half_bar()
    end
    it("clamps current > max for fill and count") do ->
      test_view_current_above_max_clamps()
    end
    it("clamps current < 0 for fill") do ->
      test_view_current_negative_clamps()
    end
    it("returns empty when max == 0") do ->
      test_view_max_zero_returns_empty()
    end
    it("returns empty when max < 0") do ->
      test_view_max_negative_returns_empty()
    end
    it("renders brackets only when width == 0") do ->
      test_view_width_zero_brackets_only()
    end
    it("renders brackets only when width < 0") do ->
      test_view_width_negative_treated_as_zero()
    end
  end

  describe("progress_bar_view sub-cell precision (eighth-blocks)") do ->
    it("renders 1/8 fill as ▏") do ->
      test_view_one_eighth()
    end
    it("renders 2/8 fill as ▎") do ->
      test_view_two_eighths()
    end
    it("renders 3/8 fill as ▍") do ->
      test_view_three_eighths()
    end
    it("renders 4/8 fill as ▌") do ->
      test_view_four_eighths()
    end
    it("renders 5/8 fill as ▋") do ->
      test_view_five_eighths()
    end
    it("renders 6/8 fill as ▊") do ->
      test_view_six_eighths()
    end
    it("renders 7/8 fill as ▉") do ->
      test_view_seven_eighths()
    end
    it("renders eighth-block after a full cell") do ->
      test_view_eighth_after_full_cells()
    end
    it("renders eighth-block after multiple full cells") do ->
      test_view_eighth_three_cells_in()
    end
    it("partial cell consumes one track slot, not zero") do ->
      test_view_subpixel_does_not_overflow_track()
    end
    it("exact full at 8/8 has no partial cell") do ->
      test_view_full_via_eighths_no_partial()
    end
  end

  describe("progress_bar_percent") do ->
    it("returns 0 when current is 0") do ->
      test_progress_percent_zero()
    end
    it("returns 100 when current == max") do ->
      test_progress_percent_full()
    end
    it("clamps above max to 100") do ->
      test_progress_percent_clamps_above_max()
    end
    it("clamps below 0 to 0") do ->
      test_progress_percent_clamps_below_zero()
    end
    it("returns 0 when max == 0") do ->
      test_progress_percent_max_zero_returns_zero()
    end
  end

  describe("progress_bar_gradient_color thresholds") do ->
    it("returns Red below 25%") do ->
      test_gradient_below_25_is_red()
    end
    it("returns Yellow at [25%, 50%)") do ->
      test_gradient_25_to_49_is_yellow()
    end
    it("returns Green at >= 50%") do ->
      test_gradient_50_and_above_is_green()
    end
  end

  return qspec_main()
end
