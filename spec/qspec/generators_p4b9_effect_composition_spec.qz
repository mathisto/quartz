## Phase 4.B.9 — generator effect composition (Throws + State).
##
## Operation Piezoelectric Effects, Phase 4 Path B, Milestone 4.B.9.
##
## With colorless lift in place (4.B.8), `can Yield` helpers compose
## naturally with the rest of the effect zoo. This spec pins down the
## two compositions that work today out of the box (no new MIR or
## codegen changes needed beyond 4.B.8):
##
## - `Yield + Throws`: a helper can yield values OR throw to abort the
##   whole iteration. Default Throws handler exits 66 with a stderr
##   message; user `with Throws { throw: h } do -> ... end` overrides
##   per H-delegate.
## - `Yield + State<S>`: state mutations from inside the helper persist
##   across yield suspensions — the State evidence slot survives the
##   cooperative kind=3 round-trip through the generator's `$poll`.
##
## What this spec pins down:
##
## - `def helper(): Void can Yield<Int>, Throws` yields its values
##   under normal execution.
## - The same helper's throw path triggers the default Throws handler
##   (exit 66 + stderr message), not a partial yield.
## - `def helper(): Void can Yield<Int>, State<Int>` reads/writes
##   shared State across yield suspensions; final state observed by
##   caller after iteration matches expected counter value.
## - Mixed: helper that yields N values then throws — first N values
##   delivered to consumer before the throw triggers.
##
## NOT in this spec (filed as known limitations):
##
## - Generic `def helper<T>(...): can Yield<T>` — pre-existing
##   `GENERIC_HELPER_FOR_IN_SCOPE.md` typecheck bug. Workaround:
##   concrete element types.
## - Row polymorphism — `def map<ε, A, B>(src: impl Iterator<A>,
##   f: Fn(A): B can ε): impl Iterator<B> can ε` — needs row-poly
##   Stream surface; deferred to 4.B.10 architectural work.
##
## Slice 2 (2026-04-25): the for-loop-state-preservation bug
## (`FOR_LOOP_STATE_NOT_PRESERVED_IN_POLL.md`) is FIXED, so for-in
## inside helpers and generators now works without the manual-while
## workaround. The last test in this spec demonstrates it directly;
## see `for_loop_state_in_poll_spec.qz` for the focused regression
## battery.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4.B.9 — generator effect composition") do ->

    it("Yield + Throws helper yields values under normal path") do ->
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def parse_token(valid: Int): Void can Yield<Int>, Throws
  if valid == 0
    throw("invalid")
    return
  end
  yield 1
  yield 2
end

def gen_tokens(): impl Iterator<Int>
  parse_token(1)
end

def main(): Int
  for x in gen_tokens()
    puts(x.to_s())
  end
  return 0
end
""", "1\n2\n")
    end

    it("Yield + Throws helper throw path triggers default Throws handler") do ->
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def parse_token(valid: Int): Void can Yield<Int>, Throws
  if valid == 0
    throw("invalid")
    return
  end
  yield 1
end

def gen_tokens(): impl Iterator<Int>
  parse_token(0)
end

def main(): Int
  puts("start")
  for x in gen_tokens()
    puts(x.to_s())
  end
  puts("unreachable")
  return 0
end
""", 66)
    end

    it("Yield + Throws — partial yield then throw delivers values before throw fires") do ->
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def emit_then_throw(): Void can Yield<Int>, Throws
  yield 10
  yield 20
  throw("boom")
end

def gen_partial(): impl Iterator<Int>
  emit_then_throw()
end

def main(): Int
  for x in gen_partial()
    puts(x.to_s())
  end
  return 0
end
""", "10\n20\n")
    end

    it("Yield + State<Int> — state survives kind=3 yield suspension") do ->
      assert_run_stdout_eq("""
import std/state

def emit_with_count(): Void can Yield<Int>, State<Int>
  set(get() + 1)
  yield 1
  set(get() + 1)
  yield 2
  set(get() + 1)
  yield 3
end

def gen_with_state(): impl Iterator<Int>
  emit_with_count()
end

def main(): Int
  var final_count = with State(0) do ->
    for x in gen_with_state()
      puts(x.to_s())
    end
    get()
  end
  puts(final_count.to_s())
  return 0
end
""", "1\n2\n3\n3\n")
    end

    it("Yield + State<Int> — state read between yields reflects all prior writes") do ->
      assert_run_stdout_eq("""
import std/state

def emit_state_progression(): Void can Yield<Int>, State<Int>
  set(get() + 100)
  yield get()
  set(get() + 100)
  yield get()
  set(get() + 100)
  yield get()
end

def gen_progression(): impl Iterator<Int>
  emit_state_progression()
end

def main(): Int
  with State(0) do ->
    for x in gen_progression()
      puts(x.to_s())
    end
  end
  return 0
end
""", "100\n200\n300\n")
    end

    it("Yield + State — multiple helpers sharing the same State<Int>") do ->
      assert_run_stdout_eq("""
import std/state

def emit_a(): Void can Yield<Int>, State<Int>
  set(get() + 1)
  yield get()
end

def emit_b(): Void can Yield<Int>, State<Int>
  set(get() * 10)
  yield get()
end

def gen_chain(): impl Iterator<Int>
  emit_a()
  emit_b()
  emit_a()
end

def main(): Int
  with State(5) do ->
    for x in gen_chain()
      puts(x.to_s())
    end
  end
  return 0
end
""", "6\n60\n61\n")
    end

    it("Yield + State helper using for-in over Vec (post-fix idiomatic form)") do ->
      assert_run_stdout_eq("""
import std/state

def emit_each(items: Vec<Int>): Void can Yield<Int>, State<Int>
  for x in items
    set(get() + x)
    yield x
  end
end

def gen_n(): impl Iterator<Int>
  var v: Vec<Int> = vec_new()
  v.push(0)
  v.push(1)
  v.push(2)
  v.push(4)
  emit_each(v)
end

def main(): Int
  with State(0) do ->
    for x in gen_n()
      puts(x.to_s())
    end
    puts(get().to_s())
  end
  return 0
end
""", "0\n1\n2\n4\n7\n")
    end
  end
  return qspec_main()
end
