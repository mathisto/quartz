##! # Map<String, V> with NUL-byte-containing keys
##!
##! Regression: before the qz_str_eq landing, `Map<String, V>` used C
##! `@strcmp` to compare keys inside a bucket. Two keys that differ
##! after an embedded `\x00` byte both appear "empty" to strcmp and
##! would alias to the same slot — silently dropping entries on
##! insert and returning wrong values on lookup.
##!
##! The original surfacing was
##! `docs/bugs/UNIKERNEL_NULL_BYTE_STRLIT.md`: a 14 076-byte
##! `\x00`-starting literal in a baked asset aliased to the pre-
##! interned empty string id 0, cascading into bogus "Duplicate loop
##! label :" typecheck errors on every WHILE node in the program.

import * from qspec

def _count_missing(): Int
  var m = map_new<String, Int>()
  map_set(m, "", 999)
  var i = 0
  while i < 100
    var k = "\x00" + i.to_s()
    map_set(m, k, i + 1)
    i = i + 1
  end
  var missing = 0
  if m.size != 101
    missing = 999
  end
  if m.get("").unwrap_or(-1) != 999
    missing = missing + 1000
  end
  var j = 0
  while j < 100
    var k2 = "\x00" + j.to_s()
    if m.get(k2).unwrap_or(-1) != j + 1
      missing = missing + 1
    end
    j = j + 1
  end
  return missing
end

def main(): Int
  describe("Map<String, V> with NUL-containing keys") do ->
    it("distinguishes two NUL-prefixed keys") do ->
      var m = map_new<String, Int>()
      map_set(m, "\x00A", 1)
      map_set(m, "\x00B", 2)
      assert_eq(m.size, 2)
      assert_eq(m.get("\x00A").unwrap_or(0), 1)
      assert_eq(m.get("\x00B").unwrap_or(0), 2)
    end

    it("distinguishes NUL-only key from empty string") do ->
      var m = map_new<String, Int>()
      map_set(m, "", 10)
      map_set(m, "\x00", 20)
      assert_eq(m.size, 2)
      assert_eq(m.get("").unwrap_or(0), 10)
      assert_eq(m.get("\x00").unwrap_or(0), 20)
    end

    it("stores 100 NUL-prefixed keys + empty without aliasing") do ->
      assert_eq(_count_missing(), 0)
    end

    it("has_key distinguishes NUL-containing keys") do ->
      var m = map_new<String, Int>()
      map_set(m, "\x00alpha", 1)
      assert_eq(map_has(m, "\x00alpha"), true)
      assert_eq(map_has(m, "\x00beta"), false)
      assert_eq(map_has(m, ""), false)
    end

    it("overwrites same NUL-containing key") do ->
      var m = map_new<String, Int>()
      map_set(m, "\x00dup", 1)
      map_set(m, "\x00dup", 42)
      assert_eq(m.size, 1)
      assert_eq(m.get("\x00dup").unwrap_or(0), 42)
    end
  end

  return qspec_main()
end
