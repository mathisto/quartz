## Map Iteration Tests
## Tests `for k in map` which desugars to `for k in hashmap_keys(m)`.
## Loop variable is bound to each key.

import * from qspec

def print_empty_map(): Void
  var m = map_new()
  for k in m
    puts("should not print")
  end
  puts("done")
end

def print_map_sum(): Void
  var m = map_new()
  m.set("a", 1)
  m.set("b", 2)
  m.set("c", 3)
  var total = 0
  for k in m
    total += m.get(k).unwrap()
  end
  puts(total.to_s())
end

def print_break_map(): Void
  var m = map_new()
  m.set("x", 10)
  m.set("y", 20)
  var count = 0
  for k in m
    count += 1
    break
  end
  puts(count.to_s())
end

def main(): Int
  describe("map iteration") do ->
    it("iterates over map keys") do ->
      var m = map_new()
      m.set("alpha", 1)
      m.set("beta", 2)
      var count = 0
      for k in m
        count += 1
      end
      assert_eq(count, 2)
    end

    it("empty map produces zero iterations") do ->
      assert_output("done\n", print_empty_map)
    end

    it("can access values via key in body") do ->
      assert_output("6\n", print_map_sum)
    end

    it("supports break") do ->
      assert_output("1\n", print_break_map)
    end

    it("works with single-entry map") do ->
      var m = map_new()
      m.set("only", 42)
      var count = 0
      for k in m
        count += 1
      end
      assert_eq(count, 1)
    end
  end

  return qspec_main()
end
