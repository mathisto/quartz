## Duration Type Tests — TDD spec
##
## Tests: constructors, accessors, arithmetic, comparison, zero.
##
## Contract:
##   1. Duration constructors.
##   2. Duration accessors.
##   3. Duration arithmetic.
##   4. Duration comparison.

import * from qspec
import * from time

def main(): Int
  describe("Duration constructors") do ->
    it("from_secs creates correct nanos") do ->
      var d = duration_from_secs(1)
      assert_eq(duration_to_nanos(d), 1000000000)
    end

    it("from_millis creates correct nanos") do ->
      var d = duration_from_millis(500)
      assert_eq(duration_to_nanos(d), 500000000)
    end

    it("from_micros creates correct nanos") do ->
      var d = duration_from_micros(1000)
      assert_eq(duration_to_nanos(d), 1000000)
    end

    it("from_nanos is identity") do ->
      var d = duration_from_nanos(42)
      assert_eq(duration_to_nanos(d), 42)
    end

    it("duration_zero has zero nanos") do ->
      var d = duration_zero()
      assert_eq(duration_to_nanos(d), 0)
    end
  end

  describe("Duration accessors") do ->
    it("to_secs truncates correctly") do ->
      var d = duration_from_millis(2500)
      assert_eq(duration_to_secs(d), 2)
    end

    it("to_millis truncates correctly") do ->
      var d = duration_from_micros(2500)
      assert_eq(duration_to_millis(d), 2)
    end

    it("to_micros truncates correctly") do ->
      var d = duration_from_nanos(2500)
      assert_eq(duration_to_micros(d), 2)
    end

    it("roundtrip secs") do ->
      var d = duration_from_secs(10)
      assert_eq(duration_to_secs(d), 10)
    end

    it("roundtrip millis") do ->
      var d = duration_from_millis(750)
      assert_eq(duration_to_millis(d), 750)
    end
  end

  describe("Duration arithmetic") do ->
    it("add 1s + 500ms = 1500ms") do ->
      var a = duration_from_secs(1)
      var b = duration_from_millis(500)
      var c = duration_add(a, b)
      assert_eq(duration_to_millis(c), 1500)
    end

    it("sub 2s - 500ms = 1500ms") do ->
      var a = duration_from_secs(2)
      var b = duration_from_millis(500)
      var c = duration_sub(a, b)
      assert_eq(duration_to_millis(c), 1500)
    end

    it("mul 100ms * 3 = 300ms") do ->
      var d = duration_from_millis(100)
      var r = duration_mul(d, 3)
      assert_eq(duration_to_millis(r), 300)
    end
  end

  describe("Duration comparison") do ->
    it("cmp 1s < 2s returns -1") do ->
      var a = duration_from_secs(1)
      var b = duration_from_secs(2)
      assert_eq(duration_cmp(a, b), -1)
    end

    it("cmp 2s == 2s returns 0") do ->
      var a = duration_from_secs(2)
      var b = duration_from_secs(2)
      assert_eq(duration_cmp(a, b), 0)
    end

    it("cmp 3s > 2s returns 1") do ->
      var a = duration_from_secs(3)
      var b = duration_from_secs(2)
      assert_eq(duration_cmp(a, b), 1)
    end

    it("is_zero for zero duration") do ->
      var d = duration_zero()
      assert_eq(duration_is_zero(d), true)
    end

    it("is_zero for non-zero duration") do ->
      var d = duration_from_nanos(1)
      assert_eq(duration_is_zero(d), false)
    end
  end

  return qspec_main()
end
