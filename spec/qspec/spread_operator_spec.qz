## Spread Operator Tests
##
## Contract:
##   1. Concatenates two vecs.
##   2. Copies a vec with.
##   3. Empty spread with surrounding.
##   4. Large spread.
##   5. Mixes plain elements and.
##   6. Multiple empty spreads.
import * from qspec

def sum_vec(v: Vec<Int>): Int
  var total = 0
  for i in 0..v.size
    total += v[i]
  end
  return total
end

def main(): Int
  describe("spread operator") do ->
    it("copies a vec with single spread") do ->
      a = [1, 2, 3]
      b = [...a]
      assert_eq(b.size, 3)
      assert_eq(b[0], 1)
      assert_eq(b[1], 2)
      assert_eq(b[2], 3)
    end

    it("concatenates two vecs") do ->
      a = [1, 2]
      b = [3, 4]
      c = [...a, ...b]
      assert_eq(c.size, 4)
      assert_eq(c[0], 1)
      assert_eq(c[1], 2)
      assert_eq(c[2], 3)
      assert_eq(c[3], 4)
    end

    it("mixes plain elements and spreads") do ->
      a = [10, 20]
      b = [40, 50]
      c = [1, ...a, 30, ...b, 60]
      assert_eq(c.size, 7)
      assert_eq(c[0], 1)
      assert_eq(c[1], 10)
      assert_eq(c[2], 20)
      assert_eq(c[3], 30)
      assert_eq(c[4], 40)
      assert_eq(c[5], 50)
      assert_eq(c[6], 60)
    end

    it("spreads an empty vec") do ->
      a = vec_new()
      b = [...a]
      assert_eq(b.size, 0)
    end

    it("empty spread with surrounding elements") do ->
      empty = vec_new()
      c = [1, ...empty, 2]
      assert_eq(c.size, 2)
      assert_eq(c[0], 1)
      assert_eq(c[1], 2)
    end

    it("spread at start") do ->
      a = [10, 20, 30]
      b = [...a, 99]
      assert_eq(b.size, 4)
      assert_eq(b[0], 10)
      assert_eq(b[3], 99)
    end

    it("spread at end") do ->
      a = [10, 20, 30]
      b = [0, ...a]
      assert_eq(b.size, 4)
      assert_eq(b[0], 0)
      assert_eq(b[1], 10)
      assert_eq(b[3], 30)
    end

    it("spread single-element vec") do ->
      a = [42]
      b = [...a]
      assert_eq(b.size, 1)
      assert_eq(b[0], 42)
    end

    it("value semantics — modifying original doesn't affect copy") do ->
      var a = [1, 2, 3]
      b = [...a]
      a[0] = 999
      assert_eq(b[0], 1)
      assert_eq(a[0], 999)
    end

    it("preserves element order") do ->
      a = [5, 4, 3, 2, 1]
      b = [...a]
      assert_eq(b[0], 5)
      assert_eq(b[1], 4)
      assert_eq(b[2], 3)
      assert_eq(b[3], 2)
      assert_eq(b[4], 1)
    end

    it("spread result used in function call") do ->
      a = [10, 20, 30]
      b = [5, ...a, 40]
      assert_eq(sum_vec(b), 105)
    end

    it("spread result in variable binding") do ->
      a = [1, 2]
      var result = [...a, 3]
      assert_eq(result.size, 3)
      assert_eq(result[2], 3)
    end

    it("multiple empty spreads") do ->
      e1 = vec_new()
      e2 = vec_new()
      c = [...e1, ...e2]
      assert_eq(c.size, 0)
    end

    it("nested array literal spreads") do ->
      c = [...[1, 2], ...[3, 4]]
      assert_eq(c.size, 4)
      assert_eq(c[0], 1)
      assert_eq(c[1], 2)
      assert_eq(c[2], 3)
      assert_eq(c[3], 4)
    end

    it("large spread") do ->
      var a = vec_new()
      for i in 0..100
        a.push(i)
      end
      b = [...a]
      assert_eq(b.size, 100)
      assert_eq(b[0], 0)
      assert_eq(b[99], 99)
    end
  end
  return qspec_main()
end
