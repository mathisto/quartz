## IS_PRED_VEC_ELEM_NO_ENUM_NAME regression spec.
##
## Sister to IS_PREDICATE_CROSS_ENUM_TAG_COLLISION (closed 2026-05-06):
## that fix made `is X` type-aware when the operand binding carries
## an enum identity (struct_name slot). Bare `var msg = vec[i]` over
## a `Vec<E>` lost the element type — typecheck couldn't validate
## `msg is Variant` and MIR-lower fell back to a global variant
## search, picking the wrong enum on same-named-variant collisions.
##
## Fix: typecheck_walk.qz NODE_LET handler — when the init is a
## NODE_INDEX with str2 set (which tc_expr_index already stamps
## with the Vec element struct/enum name), look up enum identity
## alongside struct identity and propagate to the binding.

import * from qspec

def main(): Int
  describe("is predicate — Vec<Enum> element binding") do ->

    # Surface: bare `var msg = msgs[0]` over Vec<FrameMsg> must carry
    # the FrameMsg identity into the binding so that `is Variant`
    # validates against FrameMsg's variant table — not a global search.
    it("rejects is X when X isn't in the Vec element enum (QZ0231)") do ->
      assert_compile_error("""
        enum FrameMsg
          Key
          ZB
        end

        enum Cmd
          Quit
          Run
        end

        def main(): Int
          var msgs: Vec<FrameMsg> = vec_new<FrameMsg>()
          msgs.push(FrameMsg::Key)
          var msg = msgs[0]
          if msg is Quit
            return 1
          end
          return 0
        end
        """, "QZ0231")
    end

    # Positive case: `is Variant` matches when the Variant IS in the
    # element enum, with no annotation on the local binding.
    it("matches is Variant on Vec<Enum> element with no annotation") do ->
      assert_run_exits("""
        enum FrameMsg
          Key
          Quit
        end

        def main(): Int
          var msgs: Vec<FrameMsg> = vec_new<FrameMsg>()
          msgs.push(FrameMsg::Quit)
          var msg = msgs[0]
          if msg is Quit
            return 9
          end
          return 0
        end
        """, 9)
    end

    # Cross-enum same-named-variant tag collision via Vec<E>: pre-fix
    # `is Quit` on a Vec<FrameMsg> element falls back to Cmd::Quit's
    # tag (1) and matches FrameMsg::ZB (also tag 1). Post-fix: the
    # FrameMsg identity reaches typecheck and QZ0231 fires before
    # the wrong-enum tag is even considered.
    it("does not silent-match cross-enum same-tag siblings via Vec<E>") do ->
      assert_compile_error("""
        enum FrameMsg
          Key
          ZB
        end

        enum Cmd
          Quit
          Run
        end

        def main(): Int
          var msgs: Vec<FrameMsg> = vec_new<FrameMsg>()
          msgs.push(FrameMsg::ZB)
          var msg = msgs[0]
          if msg is Quit
            return 1
          end
          return 0
        end
        """, "QZ0231")
    end

  end

  return qspec_main()
end
