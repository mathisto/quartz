## Milestone C integration spec — typecheck layer golden gate.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.8).
##
## One end-to-end spec verifying the full typecheck + MIR + codegen
## pipeline holds together for the piezoelectric-effects epic's
## Milestone C deliverable ("typecheck layer done"). If any earlier
## chunk (C.1 NODE_WITH, C.2 handler narrowing, C.3 op detection,
## C.4 MIR perform-op markers, C.7 kind classification) regresses,
## at least one test here fails. These tests are intentionally
## coarser than the per-chunk specs — their job is to catch
## cross-chunk breakage (cache restore bugs, registry churn, stale
## dispatch) that per-chunk tests miss by scope.
##
## End-of-Milestone-C demo (single source file, compiled to IR):
## declares two effects with mixed-kind ops, uses `can` rows,
## narrows via `with`, calls an op both inside and outside a
## handler, classifies the kinds — all end-to-end.
##
## Milestone D picks up the runtime story: MIR_PERFORM_OP gets wired
## to a real dispatch table, MIR_HANDLE_INSTALL allocates handler
## structs, default handlers land for blessed effects. The IR markers
## from C.4 become the load-bearing shape that Milestone D's codegen
## reads to emit dispatch calls — so the assertions below will need
## to be loosened when D lands (comments → real call instructions),
## but the typecheck-level assertions should remain stable.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("piezo Milestone C integration — typecheck layer end-to-end") do ->
    it("single source declares effects, uses can rows, with-narrows, op-calls, all pipelines green") do ->
      var src = """
effect Throws
  def throw(msg: String): Int
end
effect Pure
  def now(): Int
end
effect Log
  def emit(s: String): Int
end

def risky(): Int can Throws = throw("boom")
def timed(): Int can Pure = now()
def loud(): Int can = with Log do ->
  emit("tick")
end

def composite(): Int can Throws, Log = with Log do ->
  throw("after-log")
end

def main(): Int
  return risky() + timed() + loud() + composite()
end
"""
      assert_compile_succeeds(src)
    end

    it("Milestone C pipeline produces expected MIR_PERFORM_OP markers") do ->
      var src = """
effect Throws
  def throw(msg: String): Int
end
effect Log
  def emit(s: String): Int
end

def danger(): Int can Throws = throw("bang")
def noisy(): Int can = with Log do ->
  emit("hi")
end
def main(): Int = danger() + noisy()
"""
      assert_ir_contains(src, "effect: perform_op effect=Throws op=throw")
    end

    it("Milestone C pipeline emits handle_install + handle_uninstall in pairs") do ->
      var src = """
effect Log
  def emit(s: String): Int
end

def noisy(): Int can = with Log do ->
  emit("hello")
end
def main(): Int = noisy()
"""
      assert_ir_contains(src, "effect: handle_install effect=Log")
    end

    it("Milestone C pipeline classifies mixed-kind ops correctly") do ->
      var src = """
effect Clock
  def now(): Int
  def sleep(ms: Int): Int
end
effect Output
  def print(msg: String): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Clock op=now kind=0")
        _record_failure("Expected Clock.now kind=0")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Clock op=sleep kind=1")
        _record_failure("Expected Clock.sleep kind=1")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Output op=print kind=1")
        _record_failure("Expected Output.print kind=1")
      end
    end

    it("Milestone C QZ0610/QZ0611/QZ0612/QZ0613 diagnostics all wired") do ->
      # QZ0611: uncovered op call for non-blessed effect. D.4 registers
      # default handlers for Throws + Log so those don't fire QZ0611;
      # user-declared effects like Panic still need explicit coverage.
      assert_compile_error("""
effect Panic
  def raise(msg: String): Int
end
def main(): Int = raise("no-handler")
""", "QZ0611")
    end

    it("Milestone C QZ0613 fires on unknown handler ident (PascalCase)") do ->
      assert_compile_error("""
def main(): Int = with NonExistentEffect do ->
  42
end
""", "QZ0613")
    end

    it("Milestone C QZ0612 fires on duplicate effect declaration") do ->
      assert_compile_error("""
effect Dup
  def a(): Int
end
effect Dup
  def b(): Int
end
def main(): Int = 0
""", "QZ0612")
    end

    it("nested with-blocks correctly compose handler narrowing") do ->
      assert_compile_succeeds("""
effect Log
  def emit(s: String): Int
end
effect Throws
  def throw(msg: String): Int
end

def nested(): Int can = with Log do ->
  with Throws do ->
    throw("inside")
  end
end
def main(): Int = nested()
""")
    end

    it("open-tail row absorbs arbitrary effects via subsumption") do ->
      assert_compile_succeeds("""
effect Log
  def emit(s: String): Int
end
effect Throws
  def throw(msg: String): Int
end

def flexible(): Int can | r = emit("hi")
def also_flexible(): Int can | r = throw("x")
def main(): Int = flexible() + also_flexible()
""")
    end

    it("row subsumption test flag (--test-row-subsume) still passes post-integration") do ->
      # Light-touch check that B.6's primitive hasn't bitrotted under
      # C's additions — the embedded unit test suite still runs clean.
      var src = """
def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--test-row-subsume")
      # Match `: FAIL` (result column), not `FAIL` literal — some
      # subsume test NAMES include the token "_FAIL" for negative cases.
      if str_contains(r.stderr_content, ": FAIL")
        _record_failure(str_concat("tc_row_subsume regression: ", r.stderr_content))
      end
    end
  end
  return qspec_main()
end
