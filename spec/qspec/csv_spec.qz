## Csv Tests
##
## Contract:
##   1. Csv parsing.
##   2. Csv writing.
import * from qspec
import * from csv

def csv_ok(source: String): CsvDocument
  var result = csv_parse(source)
  match result
    Ok(doc) => return doc
    _ => return csv_document_new()
  end
end

def main(): Int
  describe("csv parsing") do ->
    it("parses simple CSV with headers") do ->
      var doc = csv_ok("name,age\nAlice,30\nBob,25")
      assert_eq(doc.has_headers, true)
      assert_eq(csv_document_row_count(doc), 2)
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 0), 0), "Alice")
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 0), 1), "30")
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 1), 0), "Bob")
    end

    it("parses quoted fields") do ->
      var doc = csv_ok("a,b\n\"hello, world\",42")
      assert_eq(csv_document_row_count(doc), 1)
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 0), 0), "hello, world")
    end

    it("parses escaped quotes") do ->
      var doc = csv_ok("a\n\"say \"\"hi\"\"\"")
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 0), 0), "say \"hi\"")
    end

    it("parses empty fields") do ->
      var doc = csv_ok("a,b,c\n,,")
      assert_eq(csv_row_len(csv_document_get_row(doc, 0)), 3)
      assert_eq_str(csv_row_get(csv_document_get_row(doc, 0), 0), "")
    end

    it("parses empty input") do ->
      var result = csv_parse("")
      assert_eq(is_ok(result), true)
    end

    it("looks up by column name") do ->
      var doc = csv_ok("name,age\nAlice,30")
      assert_eq_str(csv_document_get_field(doc, 0, "name"), "Alice")
      assert_eq_str(csv_document_get_field(doc, 0, "age"), "30")
    end
  end

  describe("csv writing") do ->
    it("stringifies simple document") do ->
      var headers = vec_new()
      headers.push("name")
      headers.push("age")
      var doc = csv_document_with_headers(headers)
      var row = csv_row_new()
      csv_row_push(row, "Alice")
      csv_row_push(row, "30")
      csv_document_add_row(doc, row)
      var output = csv_stringify(doc)
      assert_eq(str_contains(output, "name,age"), true)
      assert_eq(str_contains(output, "Alice,30"), true)
    end

    it("escapes fields with commas") do ->
      var row = csv_row_new()
      csv_row_push(row, "hello, world")
      var output = csv_stringify_row(row)
      assert_eq_str(output, "\"hello, world\"")
    end

    it("escapes fields with quotes") do ->
      var row = csv_row_new()
      csv_row_push(row, "say \"hi\"")
      var output = csv_stringify_row(row)
      assert_eq_str(output, "\"say \"\"hi\"\"\"")
    end
  end

  return qspec_main()
end
