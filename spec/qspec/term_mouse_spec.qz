## SGR mouse decoder spec — drives _term_decode_sgr_mouse with
## synthetic button/col/row triplets and verifies the decoded
## MouseEvent values via term_last_mouse_event().
##
## Doesn't drive the byte parser (would need terminal stdin); the
## byte-parser is small and the synthetic decoder covers the
## interesting bit-fiddling.

import * from qspec
import std/terminal

def main(): Int
  describe("SGR mouse decoder — buttons") do ->
    it("button 0 + M → left press") do ->
      _term_decode_sgr_mouse(0, 10, 5, 77)   # 'M'
      var ev = term_last_mouse_event()
      assert_eq(ev.col, 10)
      assert_eq(ev.row, 5)
      var is_press = 0
      if ev.kind is Press
        is_press = 1
      end
      assert_eq(is_press, 1)
      var is_left = 0
      if ev.button is Left
        is_left = 1
      end
      assert_eq(is_left, 1)
    end

    it("button 0 + m → left release") do ->
      _term_decode_sgr_mouse(0, 10, 5, 109)   # 'm'
      var ev = term_last_mouse_event()
      var is_release = 0
      if ev.kind is Release
        is_release = 1
      end
      assert_eq(is_release, 1)
    end

    it("button 1 → middle") do ->
      _term_decode_sgr_mouse(1, 1, 1, 77)
      var ev = term_last_mouse_event()
      var is_middle = 0
      if ev.button is Middle
        is_middle = 1
      end
      assert_eq(is_middle, 1)
    end

    it("button 2 → right") do ->
      _term_decode_sgr_mouse(2, 1, 1, 77)
      var ev = term_last_mouse_event()
      var is_right = 0
      if ev.button is Right
        is_right = 1
      end
      assert_eq(is_right, 1)
    end
  end

  describe("SGR mouse decoder — drag and scroll") do ->
    it("button 32 (0x20) → drag, NoButton") do ->
      _term_decode_sgr_mouse(0x20, 5, 5, 77)
      var ev = term_last_mouse_event()
      var is_drag = 0
      if ev.kind is Drag
        is_drag = 1
      end
      assert_eq(is_drag, 1)
    end

    it("button 64 (0x40) → ScrollUp") do ->
      _term_decode_sgr_mouse(0x40, 8, 8, 77)
      var ev = term_last_mouse_event()
      var is_up = 0
      if ev.kind is ScrollUp
        is_up = 1
      end
      assert_eq(is_up, 1)
    end

    it("button 65 (0x41) → ScrollDown") do ->
      _term_decode_sgr_mouse(0x41, 8, 8, 77)
      var ev = term_last_mouse_event()
      var is_down = 0
      if ev.kind is ScrollDown
        is_down = 1
      end
      assert_eq(is_down, 1)
    end
  end

  describe("SGR mouse decoder — modifiers") do ->
    it("shift bit (0x04)") do ->
      _term_decode_sgr_mouse(0x04, 1, 1, 77)
      var ev = term_last_mouse_event()
      assert_eq(ev.shift, true)
      assert_eq(ev.alt, false)
      assert_eq(ev.ctrl, false)
    end

    it("alt bit (0x08)") do ->
      _term_decode_sgr_mouse(0x08, 1, 1, 77)
      var ev = term_last_mouse_event()
      assert_eq(ev.alt, true)
    end

    it("ctrl bit (0x10)") do ->
      _term_decode_sgr_mouse(0x10, 1, 1, 77)
      var ev = term_last_mouse_event()
      assert_eq(ev.ctrl, true)
    end

    it("ctrl+shift+left-press") do ->
      _term_decode_sgr_mouse(0x04 | 0x10, 7, 9, 77)
      var ev = term_last_mouse_event()
      assert_eq(ev.shift, true)
      assert_eq(ev.ctrl, true)
      assert_eq(ev.alt, false)
      assert_eq(ev.col, 7)
      assert_eq(ev.row, 9)
      var is_left = 0
      if ev.button is Left
        is_left = 1
      end
      assert_eq(is_left, 1)
    end
  end

  describe("KEY_MOUSE_EVENT sentinel") do ->
    it("is well above byte range and key constants") do ->
      assert_eq(KEY_MOUSE_EVENT(), 2000)
    end
  end

  return qspec_main()
end
