## STRESS: Cross-Module Interaction
##
## Adversarial tests probing module boundaries:
## re-exported types, UFCS from imported modules, generic types
## across modules, global variables, and visibility.
##
## Contract:
##   1. Modules: import patterns.
##   2. Modules: UFCS with imports.
##   3. Modules: globals.
##   4. Modules: visibility edge cases.
##   5. Modules: type aliases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Module Import Patterns
  # ===========================================================================
  describe("modules: import patterns") do ->
    it("basic function defined and used in same file") do ->
      assert_run_exits("""
        def helper(): Int = 42
        def main(): Int
          return helper()
        end
        """, 42)
    end

    it("inline Option enum with Some/None") do ->
      assert_run_exits("""
        enum Option
          Some(val: Int)
          None
        end
        def main(): Int
          var o = Option::Some(42)
          match o
            Some(v) => return v
            None => return 0
          end
          return 0
        end
      """, 42)
    end

    it("multiple function definitions used together") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def mul(a: Int, b: Int): Int = a * b
        def compute(x: Int): Int = add(mul(x, x), 6)
        def main(): Int
          return compute(6)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: UFCS With Imported Functions
  # ===========================================================================
  describe("modules: UFCS with imports") do ->
    it("Vec UFCS methods from builtin") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          return v[0]
        end
        """, 42)
    end

    it("String UFCS methods from builtin") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello"
          return s.size + 37
        end
        """, 42)
    end

    it("chained UFCS on Vec with push and size") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(10)
          v.push(20)
          v.push(12)
          return v.size + 39
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Global Variables Across Functions
  # ===========================================================================
  describe("modules: globals") do ->
    it("global variable accessed from multiple functions") do ->
      assert_run_exits("""
        var counter = 0
        def inc(): Void
          counter = counter + 1
          return
        end
        def get(): Int = counter
        def main(): Int
          inc()
          inc()
          inc()
          return get() + 39
        end
        """, 42)
    end

    it("global var modified in if branch") do ->
      assert_run_exits("""
        var flag = 0
        def set_flag(v: Int): Void
          flag = v
          return
        end
        def main(): Int
          if 1
            set_flag(42)
          end
          return flag
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Visibility/Privacy Edge Cases
  # ===========================================================================
  describe("modules: visibility edge cases") do ->
    it("priv function access from same file") do ->
      assert_run_exits("""
        priv def helper(): Int = 42
        def main(): Int
          return helper()
        end
        """, 42)
    end

    it("priv struct used in same module") do ->
      assert_run_exits("""
        priv struct Internal
          value: Int
        end
        def main(): Int
          x = Internal { value: 42 }
          return x.value
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Type Aliases Across Boundaries
  # ===========================================================================
  describe("modules: type aliases") do ->
    it("type alias used in function signature") do ->
      assert_run_exits("""
        type Num = Int
        def add_nums(a: Num, b: Num): Num = a + b
        def main(): Int
          return add_nums(20, 22)
        end
        """, 42)
    end

    it("type alias to generic type") do ->
      assert_run_exits("""
        type IntVec = Vec<Int>
        def main(): Int
          var v: IntVec = vec_new()
          v.push(42)
          return v[0]
        end
        """, 42)
    end
  end

  return qspec_main()
end
