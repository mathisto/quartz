## Collection Iterators Tests
##
## Contract:
##   1. Stack iterator.
##   2. Queue iterator.
##   3. Deque iterator.
##   4. LinkedList iterator.
##   5. PriorityQueue iterator.
##   6. SortedMap iterator.
##   7. Iterator adapter integration.
import * from qspec
import collections/stack
import collections/queue
import collections/deque
import collections/linked_list
import collections/priority_queue
import collections/sorted_map
import iter

def main(): Int
  describe("Stack iterator") do ->
    it("iterates bottom to top") do ->
      var s = stack_new()
      s.push(10)
      s.push(20)
      s.push(30)
      var it = s.iter()
      match it.next()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      s.free()
    end
    it("empty stack yields None immediately") do ->
      var s = stack_new()
      var it = s.iter()
      assert(it.next().none?)
      s.free()
    end
  end

  describe("Queue iterator") do ->
    it("iterates front to back") do ->
      var q = queue_new()
      q.enqueue(1)
      q.enqueue(2)
      q.enqueue(3)
      var it = q.iter()
      match it.next()
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      q.free()
    end
    it("iterates after dequeue") do ->
      var q = queue_new()
      q.enqueue(10)
      q.enqueue(20)
      q.enqueue(30)
      q.dequeue()
      var it = q.iter()
      match it.next()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      q.free()
    end
  end

  describe("Deque iterator") do ->
    it("iterates front to back") do ->
      var d = deque_new()
      d.push_back(1)
      d.push_back(2)
      d.push_back(3)
      var it = d.iter()
      match it.next()
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      d.free()
    end
    it("iterates after push_front") do ->
      var d = deque_new()
      d.push_back(2)
      d.push_front(1)
      d.push_back(3)
      var it = d.iter()
      match it.next()
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      d.free()
    end
  end

  describe("LinkedList iterator") do ->
    it("iterates head to tail") do ->
      var ll = ll_new()
      ll.push_back(10)
      ll.push_back(20)
      ll.push_back(30)
      var it = ll.iter()
      match it.next()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      ll.free()
    end
    it("iterates after push_front") do ->
      var ll = ll_new()
      ll.push_back(2)
      ll.push_front(1)
      var it = ll.iter()
      match it.next()
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      ll.free()
    end
    it("empty list yields None") do ->
      var ll = ll_new()
      var it = ll.iter()
      assert(it.next().none?)
      ll.free()
    end
  end

  describe("PriorityQueue iterator") do ->
    it("iterates over elements (array order)") do ->
      var pq = pq_new()
      pq.push(30)
      pq.push(10)
      pq.push(20)
      var it = pq.iter()
      # Min-heap: root is 10, children are 30 and 20
      match it.next()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      # Remaining are 30 and 20 in some array order
      var second = 0
      var third = 0
      match it.next()
        Some(v) => second = v
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => third = v
        _ => assert_eq(0, 1)
      end
      assert_eq(second + third, 50)
      assert(it.next().none?)
      pq.free()
    end
  end

  describe("SortedMap iterator") do ->
    it("iterates keys in sorted order") do ->
      var m = sorted_map_new()
      m.set(3, 30)
      m.set(1, 10)
      m.set(2, 20)
      var it = m.iter()
      match it.next()
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match it.next()
        Some(v) => assert_eq(v, 3)
        _ => assert_eq(0, 1)
      end
      assert(it.next().none?)
      m.free()
    end
    it("iter_values yields values in key order") do ->
      var m = sorted_map_new()
      m.set(3, 30)
      m.set(1, 10)
      m.set(2, 20)
      var vit = m.iter_values()
      match vit.next()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match vit.next()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      match vit.next()
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
      assert(vit.next().none?)
      m.free()
    end
  end

  describe("Iterator adapter integration") do ->
    it("iter_collect on stack iterator") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      var it = s.iter()
      var collected = iter_collect(-> it.next())
      assert_eq(collected.size, 3)
      assert_eq(collected[0], 1)
      assert_eq(collected[1], 2)
      assert_eq(collected[2], 3)
      collected.free()
      s.free()
    end
    it("iter_sum on queue iterator") do ->
      var q = queue_new()
      q.enqueue(10)
      q.enqueue(20)
      q.enqueue(30)
      var it = q.iter()
      var total = iter_sum(-> it.next())
      assert_eq(total, 60)
      q.free()
    end
    it("iter_count on linked list iterator") do ->
      var ll = ll_new()
      ll.push_back(1)
      ll.push_back(2)
      ll.push_back(3)
      ll.push_back(4)
      var it = ll.iter()
      var n = iter_count(-> it.next())
      assert_eq(n, 4)
      ll.free()
    end
  end

  return qspec_main()
end
