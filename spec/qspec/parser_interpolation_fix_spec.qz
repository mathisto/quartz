## Parser Interpolation Fix Tests
## Confirms that #{} string interpolation works correctly in all closure contexts.
## These are regression/confirmation tests for F.1 parser completion.
##
## NOTE: Source strings containing #{} use \#{} to prevent the outer compiler
## from processing them as interpolation.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("interpolation in arrow lambdas") do ->
    it("interpolates a variable in arrow lambda") do ->
      var src = """
        def apply_str(f: Fn(Int): String, x: Int): String = f(x)
        def main(): Int
          var result = apply_str(x -> "value: \#{x}", 42)
          if result == "value: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end

    it("interpolates an expression in arrow lambda") do ->
      var src = """
        def apply_str(f: Fn(Int): String, x: Int): String = f(x)
        def main(): Int
          var result = apply_str(x -> "doubled: \#{x * 2}", 21)
          if result == "doubled: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end

    it("stores arrow lambda with interpolation in variable") do ->
      var src = """
        def main(): Int
          var f = (x: Int) -> "got \#{x}"
          var result = f(99)
          if result == "got 99"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end
  end

  describe("interpolation in do..end blocks") do ->
    it("interpolates in do..end block body") do ->
      var src = """
        def apply_str(x: Int, f: Fn(Int): String): String = f(x)
        def main(): Int
          var result = apply_str(42) do n ->
            "number: \#{n}"
          end
          if result == "number: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end

    it("interpolates expression in do..end multi-statement block") do ->
      var src = """
        def apply_str(x: Int, f: Fn(Int): String): String = f(x)
        def main(): Int
          var result = apply_str(7) do n ->
            var sq = n * n
            "\#{n} squared is \#{sq}"
          end
          if result == "7 squared is 49"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end
  end

  describe("interpolation in curly block closures") do ->
    it("interpolates in curly block closure") do ->
      var src = """
        def apply_str(x: Int, f: Fn(Int): String): String = f(x)
        def main(): Int
          var result = apply_str(42) { n -> "val: \#{n}" }
          if result == "val: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end
  end

  describe("interpolation with function calls in closures") do ->
    it("handles function call inside interpolation in closure") do ->
      var src = """
        def double(n: Int): Int = n * 2
        def apply_str(x: Int, f: Fn(Int): String): String = f(x)
        def main(): Int
          var result = apply_str(21) do n ->
            "result: \#{double(n)}"
          end
          if result == "result: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end
  end

  describe("interpolation with captured variables in closures") do ->
    it("interpolates captured variable in closure") do ->
      var src = """
        def apply_str(f: Fn(Int): String, x: Int): String = f(x)
        def main(): Int
          var label = "count"
          var f = (x: Int) -> "\#{label}: \#{x}"
          var result = f(42)
          if result == "count: 42"
            return 0
          end
          return 1
        end
        """
      assert_run_exits(src, 0)
    end
  end

  return qspec_main()
end
