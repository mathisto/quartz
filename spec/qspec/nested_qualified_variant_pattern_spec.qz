## Regression spec for nested qualified-variant patterns in match arms.
##
## PATTERN_PARSER_REJECTS_QUALIFIED_VARIANT sub-bug (b): when a nested
## constructor pattern like `Some(Focus::SaveList)` appeared in a match arm,
## the parser degraded the inner qualified variant to `_` (wildcard) and
## the codegen emitted only an outer-tag comparison — meaning every arm
## with the same outer constructor pattern dispatched to the FIRST arm
## regardless of the inner variant. The Maranget exhaustiveness pass also
## flagged subsequent arms as unreachable (QZ0108) since they appeared
## syntactically identical.
##
## Fix (sub-bug b):
##   - Parser stores sub-pattern AST nodes in the children/payloads slot
##     of NODE_ENUM_ACCESS, in parallel with the existing bound_names Vec.
##     Nested constructor patterns are preserved as inner NODE_ENUM_ACCESS
##     sub-pat nodes; bare bindings stay as NODE_IDENT; wildcards as
##     NODE_WILDCARD.
##   - Maranget conversion (mx_pat_from_ast) recurses on each NODE_ENUM_ACCESS
##     sub-pat to produce a discriminating variant ctor instead of a wildcard,
##     so distinct inner variants register as distinct constructors.
##   - Maranget completeness check (mx_is_useful + mx_find_witness) recovers
##     the inner enum_name by searching for an enum that holds the seen
##     variant names when col_enum_name is empty — required because the
##     algorithm threads col_type/col_enum_name as a pair and the col_type
##     defaulted to TYPE_INT for pre-fix sub-pats.
##   - Codegen (mir_lower_expr_handlers and mir_lower_stmt_handlers) emits
##     additional inner tag-equality comparisons for each NODE_ENUM_ACCESS
##     sub-pat, AND-ed into the outer tag comparison. Inner payload is
##     loaded from offset i+1 of the outer subject value.

import * from qspec

enum SubFocus
  SubA
  SubB
  SubC
end

enum SubMaybe
  SubJust(f: SubFocus)
  SubNothing
end

# Match used as a STATEMENT (each arm returns) — exercises
# mir_lower_stmt_handlers.qz:1677.
def show_stmt(m: SubMaybe): String
  match m
    SubJust(SubFocus::SubA) => return "a-stmt"
    SubJust(SubFocus::SubB) => return "b-stmt"
    SubJust(SubFocus::SubC) => return "c-stmt"
    SubNothing              => return "nothing-stmt"
  end
  return "fallthrough"
end

# Match used as an EXPRESSION (assigned to a value) — exercises
# mir_lower_expr_handlers.qz:3613.
def show_expr(m: SubMaybe): String
  var label = match m
    SubJust(SubFocus::SubA) => "a-expr"
    SubJust(SubFocus::SubB) => "b-expr"
    SubJust(SubFocus::SubC) => "c-expr"
    SubNothing              => "nothing-expr"
  end
  return label
end

# Mixed shapes in one match: qualified nested + bare-binding fallback.
def show_mixed(m: SubMaybe): String
  match m
    SubJust(SubFocus::SubA) => return "a-mixed"
    SubJust(_)              => return "other-mixed"
    SubNothing              => return "nothing-mixed"
  end
  return "fallthrough"
end

def main(): Int
  describe("nested qualified-variant patterns dispatch on inner variant") do ->

    it("statement-context match dispatches each variant correctly") do ->
      assert_eq_str(show_stmt(SubMaybe::SubJust(SubFocus::SubA)), "a-stmt")
      assert_eq_str(show_stmt(SubMaybe::SubJust(SubFocus::SubB)), "b-stmt")
      assert_eq_str(show_stmt(SubMaybe::SubJust(SubFocus::SubC)), "c-stmt")
      assert_eq_str(show_stmt(SubMaybe::SubNothing), "nothing-stmt")
    end

    it("expression-context match dispatches each variant correctly") do ->
      assert_eq_str(show_expr(SubMaybe::SubJust(SubFocus::SubA)), "a-expr")
      assert_eq_str(show_expr(SubMaybe::SubJust(SubFocus::SubB)), "b-expr")
      assert_eq_str(show_expr(SubMaybe::SubJust(SubFocus::SubC)), "c-expr")
      assert_eq_str(show_expr(SubMaybe::SubNothing), "nothing-expr")
    end

    it("mixed qualified and wildcard arms select the right branch") do ->
      assert_eq_str(show_mixed(SubMaybe::SubJust(SubFocus::SubA)), "a-mixed")
      assert_eq_str(show_mixed(SubMaybe::SubJust(SubFocus::SubB)), "other-mixed")
      assert_eq_str(show_mixed(SubMaybe::SubJust(SubFocus::SubC)), "other-mixed")
      assert_eq_str(show_mixed(SubMaybe::SubNothing), "nothing-mixed")
    end

  end
  return qspec_main()
end
