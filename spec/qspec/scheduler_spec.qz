## M:N Scheduler tests
## Subprocess-isolated tests for sched_init/sched_spawn/sched_shutdown/go/sched_yield.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("M:N Scheduler") do ->
    it("init, shutdown, zero-workers, double-shutdown") do ->
      assert_run_exits(sched_lifecycle_src(), 0)
    end
    it("spawn async task and go keyword") do ->
      assert_run_exits(sched_spawn_go_src(), 0)
    end
  end

  describe("I/O integration") do ->
    it("pipe-based async task wakes via I/O poller") do ->
      assert_run_exits(sched_pipe_io_src(), 0)
    end
  end

  describe("work stealing (B.3)") do ->
    it("1000 tasks + yield re-enqueues") do ->
      assert_run_exits(sched_stress_src(), 0)
    end
  end

  return qspec_main()
end

def sched_lifecycle_src(): String = """
  def main(): Int
    sched_init(2)
    sched_shutdown()
    sched_init(0)
    sched_shutdown()
    sched_shutdown()
    return 0
  end
  """

def sched_spawn_go_src(): String = """
  def work(): Int
    return 42
  end
  def double(x: Int): Int
    return x * 2
  end
  def main(): Int
    sched_init(4)
    var t = async work()
    sched_spawn(t)
    go double(1)
    go double(2)
    go double(3)
    go double(4)
    go double(5)
    sched_shutdown()
    return 0
  end
  """

def sched_pipe_io_src(): String = """
  extern "C" def pipe(fds: CPtr): CInt
  extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt
  def read_i32(p: Int): Int
    var b0 = ptr_read_byte(p)
    var b1 = ptr_read_byte(ptr_add(p, 1))
    var b2 = ptr_read_byte(ptr_add(p, 2))
    var b3 = ptr_read_byte(ptr_add(p, 3))
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
  end
  def reader(fd: Int): Int
    io_suspend(fd)
    return 1
  end
  def awaiter(handle: Int): Int
    var result = await handle
    return result
  end
  def main(): Int
    sched_init(2)
    var fds = mem_alloc(8)
    pipe(fds)
    var rfd = read_i32(fds)
    var wfd = read_i32(ptr_add(fds, 4))
    var reader_frame = async reader(rfd)
    var awaiter_frame = async awaiter(reader_frame)
    sched_spawn(awaiter_frame)
    var buf = mem_alloc(1)
    store(buf, 0, 65)
    write(wfd, buf, 1)
    sched_shutdown()
    if load(awaiter_frame, 0) == -1
      if load(awaiter_frame, 1) == 1
        return 0
      end
    end
    return 1
  end
  """

def sched_stress_src(): String = """
  def double(x: Int): Int
    return x * 2
  end
  def work(): Int
    sched_yield()
    return 1
  end
  def main(): Int
    sched_init(4)
    var i = 0
    while i < 1000
      var t = async double(i)
      sched_spawn(t)
      i += 1
    end
    var t2 = async work()
    sched_spawn(t2)
    sched_shutdown()
    return 0
  end
  """
