## Overflow Detection Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("integer overflow detection") do ->
    it("panics on addition overflow") do ->
      assert_run_panics_with_flags("""
        def main(): Int
          x = 9223372036854775807
          y = x + 1
          return 0
        end
        """, "integer overflow", "--overflow-check")
    end
    it("panics on subtraction overflow") do ->
      assert_run_panics_with_flags("""
        def main(): Int
          var x = -4611686018427387904
          x = x - 4611686018427387904
          y = x - 1
          return 0
        end
        """, "integer overflow", "--overflow-check")
    end
    it("panics on multiplication overflow") do ->
      assert_run_panics_with_flags("""
        def main(): Int
          x = 9223372036854775807
          y = x * 2
          return 0
        end
        """, "integer overflow", "--overflow-check")
    end
    it("normal arithmetic works fine with flag") do ->
      assert_run_exits_with_flags("""
        def main(): Int
          x = 100 + 200
          return 0
        end
        """, 0, "--overflow-check")
    end
    it("without flag wrapping behavior works") do ->
      assert_run_exits("""
        def main(): Int
          x = 9223372036854775807
          y = x + 1
          return 0
        end
        """, 0)
    end
    it("emits overflow intrinsics in IR with flag") do ->
      assert_ir_contains_with_flags("""
        def main(): Int
          x = 10 + 20
          return 0
        end
        """, "llvm.sadd.with.overflow", "--overflow-check")
    end
  end

  return qspec_main()
end
