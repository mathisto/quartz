## Regression spec for module-aliased enum variant access.
##
## Pre-fix bug: parser concatenated all `::`-separated segments after a
## lowercase LHS into one mangled name without knowing whether the LHS was
## a real module path or a user-supplied import-as alias. So
## `tui::Cmd::None` mangled to `tui$Cmd$None` and the resolver couldn't
## find it (enum variants register globally as `EnumName$VariantName`,
## never with a module/alias prefix).
##
## Naive fix attempt (drop ALL lowercase prefixes when next IDENT is
## uppercase) broke the compiler's self-build because cross-module
## function/constant access like `token_constants::TOK_COMMA` follows the
## same surface shape but DOES rely on `module_path$function` mangling.
##
## Fix: ParserState now tracks `import_aliases: Vec<String>`, populated
## during ps_parse_import. When the ident-expression parser sees a
## lowercase LHS followed by `::Uppercase…`, it drops the prefix only if
## the LHS is in the alias set. Real module paths still concatenate.
##
## The other half — calls and Type::method dispatch through aliased
## modules — are already covered by `modules_spec.qz` (alias_mod test).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("module-aliased enum variant access") do ->

    it("constructs a no-payload variant in expression position") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("enums.qz"))
      var enums_src = """
enum Foo
  A
  B
  C(value: Int)
end
"""
      vec_push(files, as_int(enums_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import enums as e
def main(): Int
  var f: e::Foo = e::Foo::A
  return 0
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 0)
    end

    it("constructs a payload variant and matches it") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("enums.qz"))
      var enums_src = """
enum Foo
  A
  B
  C(value: Int)
end
"""
      vec_push(files, as_int(enums_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import enums as e
def main(): Int
  var f: e::Foo = e::Foo::C(42)
  match f
    Foo::A => return 100
    Foo::B => return 101
    Foo::C(v) => return v
  end
end
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("matches aliased variants in pattern position") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("enums.qz"))
      var enums_src = """
enum Foo
  A
  B
  C(value: Int)
end
"""
      vec_push(files, as_int(enums_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import enums as e
def classify(f: e::Foo): Int
  match f
    e::Foo::A => return 0
    e::Foo::B => return 1
    e::Foo::C(v) => return v
  end
end
def main(): Int = classify(e::Foo::C(7))
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 7)
    end

    it("does not regress lowercase module-prefixed function calls") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("hp.qz"))
      var hp_src = """
def helper(): Int = 99
"""
      vec_push(files, as_int(hp_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import hp as h
def main(): Int = h::helper()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 99)
    end

    it("does not regress UPPERCASE_CONST cross-module access from non-alias paths") do ->
      ## Regression for the failed first fix attempt: `module_path::CONST`
      ## (e.g. `token_constants::TOK_COMMA` in the compiler) is NOT an
      ## alias — it's a real imported module path with no `as` clause.
      ## The parser must still concatenate this shape to `module$CONST`.
      var files: Vec = vec_new()
      vec_push(files, as_int("constants.qz"))
      var constants_src = """
def MAGIC_NUMBER(): Int = 137
"""
      vec_push(files, as_int(constants_src))
      vec_push(files, as_int("main.qz"))
      var main_src = """
import constants
def main(): Int = constants::MAGIC_NUMBER()
"""
      vec_push(files, as_int(main_src))
      assert_multi_run_exits(files, 1, 137)
    end

  end
  return qspec_main()
end
