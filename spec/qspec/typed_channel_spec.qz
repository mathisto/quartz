import * from qspec

# --- Test: Channel returns Channel type ---

def test_channel_new(): Void
  var ch = channel_new(10)
  send(ch, 42)
  var val = recv(ch)
  puts(to_str(val))
  channel_close(ch)
end

# --- Test: Channel with typed operations ---

def test_channel_send_recv(): Void
  var ch: Channel = channel_new(5)
  send(ch, 100)
  send(ch, 200)
  var a = recv(ch)
  var b = recv(ch)
  puts(to_str(a + b))
  channel_close(ch)
end

# --- Test: UFCS on channels ---

def test_channel_ufcs(): Void
  var ch = channel_new(3)
  ch.send(99)
  var val = ch.recv()
  puts(to_str(val))
  ch.close()
end

# --- Test: backward compat with bare channels ---

def test_bare_channel(): Void
  var ch = channel_new(1)
  send(ch, 7)
  puts(to_str(recv(ch)))
  channel_close(ch)
end

# --- Test: channel_new<Int>(capacity) explicit type ---

def test_channel_new_typed(): Void
  var ch = channel_new<Int>(1)
  send(ch, 42)
  var val = recv(ch)
  puts(to_str(val))
  channel_close(ch)
end

# --- Test: type inference from first send ---

def test_channel_type_inference(): Void
  var ch = channel_new(1)
  send(ch, 99)
  var val = recv(ch)
  puts(to_str(val))
  channel_close(ch)
end

# --- Test: channel_new<Int> with UFCS ---

def test_typed_channel_ufcs(): Void
  var ch = channel_new<Int>(2)
  ch.send(10)
  ch.send(20)
  var a = ch.recv()
  var b = ch.recv()
  puts(to_str(a + b))
  ch.close()
end

def main(): Int
  describe("typed channels") do ->

    it("channel_new returns Channel type") do ->
      assert_output("42\n", test_channel_new)
    end

    it("send/recv work on Channel type") do ->
      assert_output("300\n", test_channel_send_recv)
    end

    it("UFCS methods work on channels") do ->
      assert_output("99\n", test_channel_ufcs)
    end

    it("bare channels still work (backward compat)") do ->
      assert_output("7\n", test_bare_channel)
    end

    it("channel_new<Int>(cap) creates typed channel") do ->
      assert_output("42\n", test_channel_new_typed)
    end

    it("type inference from first send") do ->
      assert_output("99\n", test_channel_type_inference)
    end

    it("UFCS works on channel_new<Int> channels") do ->
      assert_output("30\n", test_typed_channel_ufcs)
    end

  end

  return qspec_main()
end
