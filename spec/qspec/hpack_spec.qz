import * from qspec
import * from bytes
import net/hpack

# ============================================================================
# HPACK Tests — RFC 7541
# ============================================================================

def test_static_table_size(): Int
  hpack_static_init()
  if hpack_static_size() == 61
    return 1
  end
  return 0
end

def test_static_table_method_get(): Int
  hpack_static_init()
  if hpack_static_name(2) == ":method" and hpack_static_value(2) == "GET"
    return 1
  end
  return 0
end

def test_static_table_status_200(): Int
  hpack_static_init()
  if hpack_static_name(8) == ":status" and hpack_static_value(8) == "200"
    return 1
  end
  return 0
end

def test_int_decode_small(): Int
  # RFC 7541 §C.1.1: encode 10 with 5-bit prefix = 0x0A
  var data = Bytes { _data: [10] }
  var result = hpack_decode_int(data, 0, 5)
  if result[0] == 10 and result[1] == 1
    return 1
  end
  return 0
end

def test_int_decode_multi(): Int
  # RFC 7541 §C.1.2: encode 1337 with 5-bit prefix = 0x1F 0x9A 0x0A
  var data = Bytes { _data: [0x1F, 0x9A, 0x0A] }
  var result = hpack_decode_int(data, 0, 5)
  if result[0] == 1337 and result[1] == 3
    return 1
  end
  return 0
end

def test_int_encode_small(): Int
  var encoded = hpack_encode_int(10, 5, 0)
  if encoded.size() == 1 and encoded.get(0) == 10
    return 1
  end
  return 0
end

def test_int_encode_multi(): Int
  var encoded = hpack_encode_int(1337, 5, 0)
  if encoded.size() == 3 and encoded.get(0) == 0x1F and encoded.get(1) == 0x9A and encoded.get(2) == 0x0A
    return 1
  end
  return 0
end

def test_int_roundtrip(): Int
  var i = 0
  while i < 500
    var encoded = hpack_encode_int(i, 5, 0)
    var decoded = hpack_decode_int(encoded, 0, 5)
    if decoded[0] != i
      return 0
    end
    i = i + 1
  end
  return 1
end

def test_raw_string_decode(): Int
  # Raw string "custom-key" = 0x0A (len=10, H=0) + bytes
  var data = Bytes { _data: [10, 99, 117, 115, 116, 111, 109, 45, 107, 101, 121] }
  var result = hpack_decode_string(data, 0)
  var s = as_type<String>(result[0])
  if s == "custom-key" and result[1] == 11
    return 1
  end
  return 0
end

def test_dyn_table_insert_and_lookup(): Int
  var t = hpack_dyn_new(4096)
  hpack_dyn_insert(t, "custom-key", "custom-value")
  if hpack_dyn_count(t) == 1 and hpack_dyn_name(t, 0) == "custom-key" and hpack_dyn_value(t, 0) == "custom-value"
    return 1
  end
  return 0
end

def test_dyn_table_eviction(): Int
  # Create table with very small max size (64 bytes)
  # Each entry = name_len + value_len + 32 overhead
  # "ab" + "cd" = 2 + 2 + 32 = 36 bytes
  var t = hpack_dyn_new(72)
  hpack_dyn_insert(t, "ab", "cd")  # 36 bytes, fits
  hpack_dyn_insert(t, "ef", "gh")  # 36 bytes, total 72, fits
  if hpack_dyn_count(t) != 2
    return 0
  end
  hpack_dyn_insert(t, "ij", "kl")  # 36 bytes, total would be 108 > 72, evicts oldest
  if hpack_dyn_count(t) != 2
    return 0
  end
  # Newest should be "ij"/"kl", next should be "ef"/"gh" (oldest "ab"/"cd" evicted)
  if hpack_dyn_name(t, 0) == "ij" and hpack_dyn_name(t, 1) == "ef"
    return 1
  end
  return 0
end

def test_unified_lookup(): Int
  hpack_static_init()
  var t = hpack_dyn_new(4096)
  hpack_dyn_insert(t, "my-header", "my-value")
  # Static index 2 = :method GET
  if hpack_lookup_name(t, 2) != ":method"
    return 0
  end
  # Dynamic index 62 = first dynamic entry (62 = 61 + 1)
  if hpack_lookup_name(t, 62) != "my-header"
    return 0
  end
  return 1
end

def test_encode_indexed_header(): Int
  hpack_static_init()
  # Encode :method GET (static index 2) → should be indexed (0x82)
  var headers = vec_new<HpackHeader>()
  headers.push(HpackHeader { name: ":method", value: "GET" })
  var encoded = hpack_encode_block(headers)
  if encoded.size() == 1 and encoded.get(0) == 0x82
    return 1
  end
  return 0
end

def test_encode_decode_roundtrip(): Int
  hpack_static_init()
  var headers = vec_new<HpackHeader>()
  headers.push(HpackHeader { name: ":status", value: "200" })
  headers.push(HpackHeader { name: "content-type", value: "text/html" })
  headers.push(HpackHeader { name: "server", value: "quartz" })
  var encoded = hpack_encode_block(headers)
  var table = hpack_dyn_new(4096)
  var decoded = hpack_decode_block(encoded, table)
  if decoded.size != 3
    return 0
  end
  var h0 = decoded[0]
  var h1 = decoded[1]
  var h2 = decoded[2]
  if h0.name != ":status" or h0.value != "200"
    return 0
  end
  if h1.name != "content-type" or h1.value != "text/html"
    return 0
  end
  if h2.name != "server" or h2.value != "quartz"
    return 0
  end
  return 1
end

## Huffman string decode: "test" = t(01001) e(00101) s(01000) t(01001) + pad(1111)
## Bytes: [0x49, 0x50, 0x9F]
def test_huffman_string_decode(): Int
  # HPACK string: Huffman flag (0x80) + length 3, then 3 Huffman bytes
  var data = Bytes { _data: [0x83, 0x49, 0x50, 0x9F] }
  var result = hpack_decode_string(data, 0)
  var s = as_type<String>(result[0])
  var consumed = result[1]
  if s == "test" and consumed == 4
    return 1
  end
  eputs("huffman decode: got '#{s}' consumed=#{consumed}")
  return 0
end

## Huffman string decode: "www" = w(1111000) w(1111000) w(1111000) + pad(111)
## Bytes: [0xF1, 0xE3, 0xC7]
def test_huffman_www_decode(): Int
  var data = Bytes { _data: [0x83, 0xF1, 0xE3, 0xC7] }
  var result = hpack_decode_string(data, 0)
  var s = as_type<String>(result[0])
  var consumed = result[1]
  if s == "www" and consumed == 4
    return 1
  end
  eputs("huffman www: got '#{s}' consumed=#{consumed}")
  return 0
end

## Huffman decode: single char "0" = 00000 + pad(111) = 0x07
def test_huffman_single_char(): Int
  var data = Bytes { _data: [0x81, 0x07] }
  var result = hpack_decode_string(data, 0)
  var s = as_type<String>(result[0])
  if s == "0"
    return 1
  end
  eputs("huffman single: got '#{s}'")
  return 0
end

## Full HPACK block with Huffman values:
## :method GET (indexed 0x82) + :authority "test" (literal+index 0x41, Huffman)
def test_huffman_block_decode(): Int
  hpack_static_init()
  var data = Bytes { _data: [0x82, 0x41, 0x83, 0x49, 0x50, 0x9F] }
  var table = hpack_dyn_new(4096)
  var decoded = hpack_decode_block(data, table)
  if decoded.size != 2
    eputs("huffman block: got #{decoded.size} headers")
    return 0
  end
  var h0 = decoded[0]
  var h1 = decoded[1]
  if h0.name != ":method" or h0.value != "GET"
    eputs("huffman block h0: #{h0.name}=#{h0.value}")
    return 0
  end
  if h1.name != ":authority" or h1.value != "test"
    eputs("huffman block h1: #{h1.name}=#{h1.value}")
    return 0
  end
  return 1
end

## Simulate curl-like HPACK block: indexed + multiple Huffman literals
## :method GET (0x82), :scheme https (0x87), :path / (0x84),
## :authority "0" (literal+index 1, Huffman "0" = 0x07),
## accept */* (literal+index 19, Huffman)
## "*/*" = *(11111001) /(11000) *(11111001) + pad(1) = 0xFC, 0x7E, 0x4F
## Wait: * = sym 42 = 0xf9 = 11111001 (8 bits)
##        / = sym 47 = 0x18 = 011000 (6 bits)
##        * = sym 42 = 0xf9 = 11111001 (8 bits)
##   Total: 22 bits → 3 bytes, pad = 2 bits (11)
##   Bits: 11111001 01100011 11100111
##   Bytes: 0xF9, 0x63, 0xE7... wait, let me recompute.
##   11111001|011000|11111001|11  →
##   byte0: 11111001 = 0xF9
##   byte1: 01100011 = 0x63
##   byte2: 11100111 = 0xE7
def test_huffman_curl_like_block(): Int
  hpack_static_init()
  # :method GET, :scheme https, :path /, :authority "0" (Huffman), accept */* (Huffman)
  var data = Bytes { _data: [
    0x82,                   # :method GET (indexed 2)
    0x87,                   # :scheme https (indexed 7)
    0x84,                   # :path / (indexed 4)
    0x41, 0x81, 0x07,       # :authority: "0" (literal+index 1, Huffman len=1)
    0x53, 0x83, 0xF9, 0x63, 0xE7  # accept: "*/*" (literal+index 19, Huffman len=3)
  ] }
  var table = hpack_dyn_new(4096)
  var decoded = hpack_decode_block(data, table)
  if decoded.size != 5
    eputs("curl-like: got #{decoded.size} headers, expected 5")
    return 0
  end
  var h0 = decoded[0]
  var h1 = decoded[1]
  var h2 = decoded[2]
  var h3 = decoded[3]
  var h4 = decoded[4]
  if h0.name != ":method" or h0.value != "GET"
    eputs("curl-like h0: #{h0.name}=#{h0.value}")
    return 0
  end
  if h1.name != ":scheme" or h1.value != "https"
    eputs("curl-like h1: #{h1.name}=#{h1.value}")
    return 0
  end
  if h2.name != ":path" or h2.value != "/"
    eputs("curl-like h2: #{h2.name}=#{h2.value}")
    return 0
  end
  if h3.name != ":authority"
    eputs("curl-like h3: #{h3.name}=#{h3.value}")
    return 0
  end
  if h4.name != "accept"
    eputs("curl-like h4: #{h4.name}=#{h4.value}")
    return 0
  end
  return 1
end

## Realistic curl HPACK block: :method GET, :scheme https, :path /,
## :authority 127.0.0.1:8443 (Huffman), user-agent curl/7.81.0 (Huffman),
## accept */* (raw). Hand-computed Huffman from RFC 7541 Appendix B.
def test_huffman_realistic_curl(): Int
  hpack_static_init()
  var data = Bytes { _data: [
    0x82,                                                                     # :method GET (indexed 2)
    0x87,                                                                     # :scheme https (indexed 7)
    0x84,                                                                     # :path / (indexed 4)
    0x41, 0x8B, 0x08, 0x9D, 0x5C, 0x0B, 0x81, 0x70, 0xDC, 0x79, 0xA6, 0x99, 0xFF,  # :authority "127.0.0.1:8443" Huffman 11 bytes
    0x7A, 0x88, 0x25, 0xB6, 0x50, 0xC3, 0xAB, 0xBC, 0x15, 0xC1,             # user-agent "curl/7.81.0" Huffman 8 bytes
    0x53, 0x03, 0x2A, 0x2F, 0x2A                                             # accept "*/*" raw 3 bytes
  ] }
  var table = hpack_dyn_new(4096)
  var decoded = hpack_decode_block(data, table)
  if decoded.size != 6
    eputs("realistic curl: got #{decoded.size} headers, expected 6")
    var i = 0
    while i < decoded.size
      var h = decoded[i]
      eputs("  [#{i}] #{h.name}: #{h.value}")
      i = i + 1
    end
    return 0
  end
  var h0 = decoded[0]
  var h1 = decoded[1]
  var h2 = decoded[2]
  var h3 = decoded[3]
  var h4 = decoded[4]
  var h5 = decoded[5]
  if h0.name != ":method" or h0.value != "GET"
    eputs("h0: #{h0.name}=#{h0.value}")
    return 0
  end
  if h1.name != ":scheme" or h1.value != "https"
    eputs("h1: #{h1.name}=#{h1.value}")
    return 0
  end
  if h2.name != ":path" or h2.value != "/"
    eputs("h2: #{h2.name}=#{h2.value}")
    return 0
  end
  if h3.name != ":authority" or h3.value != "127.0.0.1:8443"
    eputs("h3: #{h3.name}=#{h3.value}")
    return 0
  end
  if h4.name != "user-agent" or h4.value != "curl/7.81.0"
    eputs("h4: #{h4.name}=#{h4.value}")
    return 0
  end
  if h5.name != "accept" or h5.value != "*/*"
    eputs("h5: #{h5.name}=#{h5.value}")
    return 0
  end
  return 1
end

## Exact Huffman bytes curl sends for "/json": 63 a2 0f 57
## From server log: HPACK block byte 1 = 0x04 (literal, name idx 4 = :path),
##   byte 2 = 0x84 (Huffman + len 4), bytes 3-6 = 63 a2 0f 57
def test_huffman_json_path(): Int
  # Decode the HPACK block fragment: literal without indexing, name idx 4, Huffman value
  hpack_static_init()
  var data = Bytes { _data: [0x04, 0x84, 0x63, 0xA2, 0x0F, 0x57] }
  var table = hpack_dyn_new(4096)
  var decoded = hpack_decode_block(data, table)
  if decoded.size != 1
    eputs("json path: got #{decoded.size} headers")
    return 0
  end
  var h = decoded[0]
  if h.name != ":path"
    eputs("json path name: '#{h.name}'")
    return 0
  end
  if h.value != "/json"
    eputs("json path value: '#{h.value}' (len=#{str_byte_len(h.value)})")
    # Dump bytes
    var i = 0
    while i < str_byte_len(h.value)
      eputs("  byte[#{i}] = #{str_codepoint_at(h.value, i)}")
      i = i + 1
    end
    return 0
  end
  return 1
end

def main(): Int
  describe("HPACK (RFC 7541)") do ->
    it("static table has 61 entries") do ->
      assert_eq(test_static_table_size(), 1)
    end

    it("static entry 2 = :method GET") do ->
      assert_eq(test_static_table_method_get(), 1)
    end

    it("static entry 8 = :status 200") do ->
      assert_eq(test_static_table_status_200(), 1)
    end

    it("integer decode: 10 with 5-bit prefix") do ->
      assert_eq(test_int_decode_small(), 1)
    end

    it("integer decode: 1337 with 5-bit prefix (multi-byte)") do ->
      assert_eq(test_int_decode_multi(), 1)
    end

    it("integer encode: 10 with 5-bit prefix") do ->
      assert_eq(test_int_encode_small(), 1)
    end

    it("integer encode: 1337 with 5-bit prefix (multi-byte)") do ->
      assert_eq(test_int_encode_multi(), 1)
    end

    it("integer encode/decode round-trip 0-499") do ->
      assert_eq(test_int_roundtrip(), 1)
    end

    it("raw string decode: 'custom-key'") do ->
      assert_eq(test_raw_string_decode(), 1)
    end

    it("dynamic table insert and lookup") do ->
      assert_eq(test_dyn_table_insert_and_lookup(), 1)
    end

    it("dynamic table eviction on overflow") do ->
      assert_eq(test_dyn_table_eviction(), 1)
    end

    it("unified lookup: static + dynamic") do ->
      assert_eq(test_unified_lookup(), 1)
    end

    it("encode indexed header (:method GET → 0x82)") do ->
      assert_eq(test_encode_indexed_header(), 1)
    end

    it("encode/decode round-trip with mixed headers") do ->
      assert_eq(test_encode_decode_roundtrip(), 1)
    end

    it("Huffman string decode: 'test'") do ->
      assert_eq(test_huffman_string_decode(), 1)
    end

    it("Huffman string decode: 'www'") do ->
      assert_eq(test_huffman_www_decode(), 1)
    end

    it("Huffman single char decode: '0'") do ->
      assert_eq(test_huffman_single_char(), 1)
    end

    it("Huffman block decode: indexed + literal") do ->
      assert_eq(test_huffman_block_decode(), 1)
    end

    it("Huffman curl-like block: multi-header with Huffman values") do ->
      assert_eq(test_huffman_curl_like_block(), 1)
    end

    it("Huffman realistic curl: 6 headers with Huffman authority + user-agent") do ->
      assert_eq(test_huffman_realistic_curl(), 1)
    end

    it("Huffman decode '/json' from curl bytes") do ->
      assert_eq(test_huffman_json_path(), 1)
    end
  end

  return qspec_main()
end
