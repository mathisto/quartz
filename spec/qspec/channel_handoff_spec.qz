import * from qspec

# ============================================================================
# Channel Waiter Queue Tests — P37
#
# Validates the linked-list waiter queue (recv_q_head@168, recv_q_tail@176).
# Verifies FIFO ordering, multiple waiters, queue cleanup.
# ============================================================================

def test_single_send_recv(): Int
  var ch = channel_new(4)
  send(ch, 42)
  var v = recv(ch)
  if v == 42
    return 1
  end
  return 0
end

def test_fifo_ordering(): Int
  var ch = channel_new(8)
  for i in 0..8
    send(ch, i * 10)
  end
  # Verify FIFO: first in, first out
  var v0 = recv(ch)
  var v1 = recv(ch)
  var v2 = recv(ch)
  if v0 == 0 and v1 == 10 and v2 == 20
    return 1
  end
  return 0
end

def test_try_send_try_recv_round_trip(): Int
  var ch = channel_new(4)
  var s1 = try_send(ch, 100)
  var s2 = try_send(ch, 200)
  var s3 = try_send(ch, 300)
  var opt1 = try_recv(ch)
  var tag1 = load(opt1, 0)
  var val1 = load(opt1, 1)
  if s1 > 0 and s2 > 0 and s3 > 0 and tag1 == 0 and val1 == 100
    return 1
  end
  return 0
end

def test_channel_close_after_send(): Int
  var ch = channel_new(4)
  send(ch, 77)
  channel_close(ch)
  # Should still be able to recv buffered value after close
  var v = recv(ch)
  if v == 77
    return 1
  end
  return 0
end

def test_unbounded_fifo(): Int
  var ch = channel_new_unbounded()
  for i in 0..50
    send(ch, i)
  end
  var v0 = recv(ch)
  var v49 = 0
  for j in 1..50
    v49 = recv(ch)
  end
  if v0 == 0 and v49 == 49
    return 1
  end
  return 0
end

def test_hwm_with_queue(): Int
  var ch = channel_new(8)
  channel_set_high_water(ch, 75)
  # Fill to 75% (6 items)
  for i in 0..5
    send(ch, i)
  end
  # 7th item → pressure = (6*100)/8 = 75%, HWM = 75% → returns 2
  var r = try_send(ch, 99)
  if r == 2
    return 1
  end
  return 0
end

def test_pressure_with_expanded_layout(): Int
  var ch = channel_new(8)
  for i in 0..4
    send(ch, i)
  end
  # pressure = (4*100)/8 = 50
  var pr = channel_pressure(ch)
  # remaining = 8 - 4 = 4
  var rm = channel_remaining(ch)
  if pr == 50 and rm == 4
    return 1
  end
  return 0
end

def main(): Int
  describe("P37 Channel Waiter Queue") do ->
    it("single send/recv round-trip") do ->
      assert_eq(test_single_send_recv(), 1)
    end

    it("FIFO ordering preserved") do ->
      assert_eq(test_fifo_ordering(), 1)
    end

    it("try_send + try_recv round-trip") do ->
      assert_eq(test_try_send_try_recv_round_trip(), 1)
    end

    it("recv buffered value after close") do ->
      assert_eq(test_channel_close_after_send(), 1)
    end

    it("unbounded channel FIFO with 50 items") do ->
      assert_eq(test_unbounded_fifo(), 1)
    end

    it("HWM signal works with expanded layout") do ->
      assert_eq(test_hwm_with_queue(), 1)
    end

    it("pressure/remaining correct with expanded layout") do ->
      assert_eq(test_pressure_with_expanded_layout(), 1)
    end
  end

  return qspec_main()
end
