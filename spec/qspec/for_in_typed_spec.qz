## For-In Type Flow Tests — Hardened
##
## Contract:
##   1. For-in range.
##   2. For-in Vec.
##   3. For-in control flow.
import * from qspec

def main(): Int
  describe("for-in range") do ->
    it("iterates over range with correct sum") do ->
      assert_eq(for_in_range_sum(), 45)
    end

    it("empty range 0..0 does not execute body") do ->
      assert_eq(for_in_empty_range(), 0)
    end

    it("single element range 0..1") do ->
      assert_eq(for_in_single_range(), 0)
    end

    it("range with large bound") do ->
      assert_eq(for_in_large_range(), 4950)
    end

    it("range accumulates correctly") do ->
      assert_eq(for_in_accumulate(), 55)
    end

    it("nested for-in ranges") do ->
      assert_eq(for_in_nested(), 100)
    end
  end

  describe("for-in Vec") do ->
    it("iterates over Vec<Int> with correct type") do ->
      assert_eq(for_in_vec_sum(), 42)
    end

    it("empty vec does not execute body") do ->
      assert_eq(for_in_empty_vec(), 0)
    end

    it("single element vec") do ->
      assert_eq(for_in_single_vec(), 99)
    end

    it("for-in vec with side effect counter") do ->
      assert_eq(for_in_vec_count(), 5)
    end
  end

  describe("for-in control flow") do ->
    it("break exits for-in loop") do ->
      assert_eq(for_in_break(), 3)
    end

    it("continue skips iteration") do ->
      assert_eq(for_in_continue(), 20)
    end

    it("for-in as function body") do ->
      assert_eq(for_in_func_body(), 20)
    end

    it("for-in with compound assignment") do ->
      assert_eq(for_in_compound(), 45)
    end

    it("for-in range exclusive upper bound") do ->
      assert_eq(for_in_exclusive(), 6)
    end
  end

  return qspec_main()
end

def for_in_range_sum(): Int
  var sum = 0
  for i in 0..10
    sum = sum + i
  end
  return sum
end

def for_in_empty_range(): Int
  var sum = 0
  for i in 0..0
    sum = sum + 1
  end
  return sum
end

def for_in_single_range(): Int
  var sum = 0
  for i in 0..1
    sum = sum + i
  end
  return sum
end

def for_in_large_range(): Int
  var sum = 0
  for i in 0..100
    sum = sum + i
  end
  return sum
end

def for_in_accumulate(): Int
  var sum = 0
  for i in 1..11
    sum = sum + i
  end
  return sum
end

def for_in_nested(): Int
  var count = 0
  for i in 0..10
    for j in 0..10
      count += 1
    end
  end
  return count
end

def for_in_vec_sum(): Int
  var v = vec_new()
  v.push(10)
  v.push(20)
  v.push(12)
  var sum = 0
  for x in v
    sum = sum + x
  end
  return sum
end

def for_in_empty_vec(): Int
  var v = vec_new()
  var sum = 0
  for x in v
    sum = sum + 1
  end
  return sum
end

def for_in_single_vec(): Int
  var v = vec_new()
  v.push(99)
  var sum = 0
  for x in v
    sum = sum + x
  end
  return sum
end

def for_in_vec_count(): Int
  var v = [10, 20, 30, 40, 50]
  var count = 0
  for x in v
    count += 1
  end
  return count
end

def for_in_break(): Int
  var sum = 0
  for i in 0..10
    if i == 3
      break
    end
    sum = sum + 1
  end
  return sum
end

def for_in_continue(): Int
  var sum = 0
  for i in 0..10
    if i % 2 == 1
      continue
    end
    sum = sum + i
  end
  return sum
end

def for_in_func_body(): Int
  var sum = 0
  for i in 0..5
    sum = sum + double_val(i)
  end
  return sum
end

def double_val(x: Int): Int = x + x

def for_in_compound(): Int
  var sum = 0
  for i in 0..10
    sum += i
  end
  return sum
end

def for_in_exclusive(): Int
  # 0..4 should be 0, 1, 2, 3 -> sum = 6
  var sum = 0
  for i in 0..4
    sum += i
  end
  return sum
end
