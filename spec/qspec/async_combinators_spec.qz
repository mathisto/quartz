## Async Combinator Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("async_all") do ->
    it("collects results from go handles") do ->
      assert_run_exits(ac_all_go_src(), 0)
    end
    it("awaits tasks in order") do ->
      assert_run_exits(ac_all_order_src(), 0)
    end
  end

  describe("async_race") do ->
    it("returns first completed async result") do ->
      assert_run_exits(ac_race_src(), 0)
    end
  end

  describe("async_map") do ->
    it("applies function to each element in parallel") do ->
      assert_run_exits(ac_map_src(), 0)
    end
  end

  describe("async_timeout") do ->
    it("returns result before deadline") do ->
      assert_run_exits(ac_timeout_ok_src(), 0)
    end
    it("returns None on timeout") do ->
      assert_run_exits(ac_timeout_expire_src(), 0)
    end
  end

  return qspec_main()
end

def ac_async_all_def(): String = """
  def async_all(tasks: Vec<Int>): Vec<Int>
    var results = vec_new<Int>()
    var i = 0
    while i < vec_size(tasks)
      var handle = vec_get(tasks, i)
      var result = await handle
      vec_push(results, result)
      i += 1
    end
    return results
  end
  """

def ac_all_go_src(): String
  return ac_async_all_def() + "\n" + """
    def work_x(): Int = 5
    def work_y(): Int = 15
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      vec_push(tasks, go work_x())
      vec_push(tasks, go work_y())
      results = async_all(tasks)
      sched_shutdown()
      a = vec_get(results, 0)
      b = vec_get(results, 1)
      if a == 5 and b == 15
        return 0
      end
      return 1
    end
    """
end

def ac_all_order_src(): String
  return ac_async_all_def() + "\n" + """
    def w1(): Int = 10
    def w2(): Int = 20
    def w3(): Int = 30
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      vec_push(tasks, go w1())
      vec_push(tasks, go w2())
      vec_push(tasks, go w3())
      results = async_all(tasks)
      sched_shutdown()
      sum = vec_get(results, 0) + vec_get(results, 1) + vec_get(results, 2)
      if sum == 60
        return 0
      end
      return 1
    end
    """
end

def ac_race_src(): String = """
  def async_race(tasks: Vec<Int>): Int
    var n = vec_size(tasks)
    while true
      var i = 0
      while i < n
        var frame = vec_get(tasks, i)
        if load(frame, 0) == -1
          return load(frame, 1)
        end
        i += 1
      end
      sched_yield()
    end
    return 0
  end
  def fast(): Int = 42
  def main(): Int
    sched_init(2)
    var tasks = vec_new<Int>()
    t1 = async fast()
    vec_push(tasks, t1)
    result = async_race(tasks)
    sched_shutdown()
    if result == 42
      return 0
    end
    return 1
  end
  """

def ac_map_src(): String = """
  def double(n: Int): Int = n * 2
  def worker(n: Int): Int = double(n)
  def main(): Int
    sched_init(4)
    var tasks = vec_new<Int>()
    vec_push(tasks, go worker(10))
    vec_push(tasks, go worker(20))
    vec_push(tasks, go worker(30))
    var results = vec_new<Int>()
    var i = 0
    while i < vec_size(tasks)
      var handle = vec_get(tasks, i)
      var result = await handle
      vec_push(results, result)
      i += 1
    end
    sched_shutdown()
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    c = vec_get(results, 2)
    if a == 20 and b == 40 and c == 60
      return 0
    end
    return 1
  end
  """

def ac_timeout_ok_src(): String = """
  def timeout_worker(ch: Int): Int
    send(ch, 99)
    return 99
  end
  def main(): Int
    var ch = channel_new(1)
    go timeout_worker(ch)
    var opt = recv_timeout(ch, 5000)
    tag = load(opt, 0)
    if tag == 0
      val = load(opt, 1)
      if val == 99
        channel_free(ch)
        return 0
      end
    end
    channel_free(ch)
    return 1
  end
  """

def ac_timeout_expire_src(): String = """
  extern "C" def usleep(us: Int): Int
  def slow_worker(ch: Int): Int
    usleep(500000)
    send(ch, 99)
    return 99
  end
  def main(): Int
    var ch = channel_new(1)
    go slow_worker(ch)
    var opt = recv_timeout(ch, 50)
    tag = load(opt, 0)
    channel_free(ch)
    if tag == 1
      return 0
    end
    return 1
  end
  """
