import * from qspec

def main(): Int
  describe("unsigned integer comparisons") do ->
    it("U8 basic less-than") do ->
      var a = 100_u8
      var b = 200_u8
      assert_eq(a < b, true)
      assert_eq(b < a, false)
    end

    it("U8 basic greater-than") do ->
      var a = 200_u8
      var b = 100_u8
      assert_eq(a > b, true)
      assert_eq(b > a, false)
    end

    it("U8 high values use unsigned semantics") do ->
      var high = 200_u8
      var low = 100_u8
      assert_eq(high > low, true)
      assert_eq(high >= low, true)
      assert_eq(low < high, true)
      assert_eq(low <= high, true)
    end

    it("U16 comparisons") do ->
      var a = 50000_u16
      var b = 30000_u16
      assert_eq(a > b, true)
      assert_eq(b < a, true)
    end

    it("U32 comparisons") do ->
      var a = 3000000000_u32
      var b = 1000000000_u32
      assert_eq(a > b, true)
      assert_eq(b < a, true)
    end

    it("unsigned equality") do ->
      var a = 255_u8
      var b = 255_u8
      assert_eq(a == b, true)
      assert_eq(a != b, false)
    end

    it("unsigned less-than-or-equal") do ->
      var a = 100_u8
      var b = 100_u8
      assert_eq(a <= b, true)
      assert_eq(a >= b, true)
    end
  end

  return qspec_main()
end
