## QSpec coverage for std/algo/grid_bfs.qz — B.3 of post-v0.6 roadmap.
##
## Coverage:
##   - Empty grid: bfs_step picks any valid first step toward target
##   - Wall-column grid forces detour; verified via path length
##   - No path: source surrounded by blocks → -1 / empty Vec
##   - Source == target: -1 from bfs_step, single-element [source] from bfs_path
##   - Out of bounds: -1 / empty
##   - Path reconstruction: source-first, target-last, monotonic, length matches
##   - Diagonal endpoint length = Manhattan + 1

import * from qspec
import std/algo/grid_bfs as gb

# =============================================================================
# Block predicates
# =============================================================================

## Open field: no cell is blocked.
def _open(x: Int, y: Int): Bool = false

## Vertical wall along x=1, but with a gap at y=4 so a path exists.
def _wall_x1_gap_y4(x: Int, y: Int): Bool
  if x == 1 and y != 4
    return true
  end
  return false
end

## Source at (0,0) surrounded: (1,0) and (0,1) blocked. Off-grid handles
## the other two sides — bfs_step must conclude no path.
def _seal_origin(x: Int, y: Int): Bool
  if x == 1 and y == 0
    return true
  end
  if x == 0 and y == 1
    return true
  end
  return false
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("bfs_step — open grid") do ->
    it("picks a valid first step on a 5x5 open grid (0,0) -> (4,4)") do ->
      var d = gb::bfs_step(5, 5, 0, 0, 4, 4, _open)
      # Must be one of E (1) or S (3) on this layout — both valid first
      # moves toward (4, 4) since BFS produces shortest paths in any
      # tie-broken order.
      var ok = d == 1 or d == 3
      assert_eq(ok, true)
    end

    it("east-only path returns DIR_EAST") do ->
      var d = gb::bfs_step(5, 5, 0, 0, 4, 0, _open)
      assert_eq(d, gb::DIR_EAST())
    end

    it("south-only path returns DIR_SOUTH") do ->
      var d = gb::bfs_step(5, 5, 0, 0, 0, 4, _open)
      assert_eq(d, gb::DIR_SOUTH())
    end

    it("west-only path returns DIR_WEST") do ->
      var d = gb::bfs_step(5, 5, 4, 0, 0, 0, _open)
      assert_eq(d, gb::DIR_WEST())
    end

    it("north-only path returns DIR_NORTH") do ->
      var d = gb::bfs_step(5, 5, 4, 4, 4, 0, _open)
      assert_eq(d, gb::DIR_NORTH())
    end
  end

  describe("bfs_step — degenerate cases") do ->
    it("source == target returns -1") do ->
      var d = gb::bfs_step(5, 5, 2, 2, 2, 2, _open)
      assert_eq(d, -1)
    end

    it("source out of bounds returns -1") do ->
      var d = gb::bfs_step(5, 5, -1, 0, 4, 4, _open)
      assert_eq(d, -1)
    end

    it("target out of bounds returns -1") do ->
      var d = gb::bfs_step(5, 5, 0, 0, 5, 5, _open)
      assert_eq(d, -1)
    end

    it("source surrounded by blocks returns -1") do ->
      var d = gb::bfs_step(5, 5, 0, 0, 4, 4, _seal_origin)
      assert_eq(d, -1)
    end
  end

  describe("bfs_step — wall detour") do ->
    it("wall column at x=1 with gap at y=4 forces south then east") do ->
      # From (0, 0), the only path to (2, 0) goes south to y=4, east
      # through the gap, then north back. First step must be south.
      var d = gb::bfs_step(5, 5, 0, 0, 2, 0, _wall_x1_gap_y4)
      assert_eq(d, gb::DIR_SOUTH())
    end
  end

  describe("bfs_path — open grid") do ->
    it("east-only path: (0,0) -> (4,0) on 5x5 open is 5 cells") do ->
      var path = gb::bfs_path(5, 5, 0, 0, 4, 0, _open)
      assert_eq(path.size, 5)
      var first = path[0]
      var last = path[4]
      assert_eq(first.0, 0)
      assert_eq(first.1, 0)
      assert_eq(last.0, 4)
      assert_eq(last.1, 0)
    end

    it("diagonal endpoint: (0,0) -> (4,4) on empty grid is 9 cells") do ->
      # Manhattan distance is 8, path length is 8 + 1 = 9.
      var path = gb::bfs_path(5, 5, 0, 0, 4, 4, _open)
      assert_eq(path.size, 9)
      var first = path[0]
      var last = path[8]
      assert_eq(first.0, 0)
      assert_eq(first.1, 0)
      assert_eq(last.0, 4)
      assert_eq(last.1, 4)
    end

    it("path is monotonic — adjacent cells differ by exactly one in x or y") do ->
      var path = gb::bfs_path(7, 7, 0, 0, 6, 6, _open)
      assert_eq(path.size, 13)
      var i = 1
      var ok = true
      while i < path.size
        var a = path[i - 1]
        var b = path[i]
        var dx = b.0 - a.0
        var dy = b.1 - a.1
        if dx < 0
          dx = 0 - dx
        end
        if dy < 0
          dy = 0 - dy
        end
        var step_ok = (dx == 1 and dy == 0) or (dx == 0 and dy == 1)
        if not step_ok
          ok = false
        end
        i += 1
      end
      assert_eq(ok, true)
    end
  end

  describe("bfs_path — degenerate cases") do ->
    it("source == target returns single-element path") do ->
      var path = gb::bfs_path(5, 5, 2, 2, 2, 2, _open)
      assert_eq(path.size, 1)
      var only = path[0]
      assert_eq(only.0, 2)
      assert_eq(only.1, 2)
    end

    it("source out of bounds returns empty Vec") do ->
      var path = gb::bfs_path(5, 5, -1, 0, 4, 4, _open)
      assert_eq(path.size, 0)
    end

    it("target out of bounds returns empty Vec") do ->
      var path = gb::bfs_path(5, 5, 0, 0, 5, 5, _open)
      assert_eq(path.size, 0)
    end

    it("source surrounded by blocks returns empty Vec") do ->
      var path = gb::bfs_path(5, 5, 0, 0, 4, 4, _seal_origin)
      assert_eq(path.size, 0)
    end
  end

  describe("bfs_path — wall detour") do ->
    it("wall column at x=1 with gap at y=4: (0,0) -> (2,0)") do ->
      # Forced detour: south 4, east 2, north 4 = 11 cells (10 steps + 1).
      var path = gb::bfs_path(5, 5, 0, 0, 2, 0, _wall_x1_gap_y4)
      assert_eq(path.size, 11)
      var first = path[0]
      var last = path[10]
      assert_eq(first.0, 0)
      assert_eq(first.1, 0)
      assert_eq(last.0, 2)
      assert_eq(last.1, 0)
    end
  end

  return qspec_main()
end
