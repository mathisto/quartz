## Bool Narrowing Tests
##
## Contract:
##   1. And short-circuit.
##   2. Bool constant false.
##   3. Bool constant true.
##   4. Bool in counted loop.
##   5. Bool in if/else select.
##   6. Chained comparison.
import * from qspec

# Helper functions for assert_output
def print_true(): Void = puts("true")
def print_false(): Void = puts("false")
def print_one(): Void = puts("1")
def print_zero(): Void = puts("0")

# Bool comparison helpers
def is_less(a: Int, b: Int): Int
  if a < b
    return 1
  end
  return 0
end

def is_equal(a: Int, b: Int): Int
  if a == b
    return 1
  end
  return 0
end

def is_greater(a: Int, b: Int): Int
  if a > b
    return 1
  end
  return 0
end

def both_true(a: Int, b: Int): Int
  if a > 0 and b > 0
    return 1
  end
  return 0
end

def either_true(a: Int, b: Int): Int
  if a > 0 or b > 0
    return 1
  end
  return 0
end

def chained_comparison(a: Int, b: Int, c: Int): Int
  if a < b and b < c
    return 1
  end
  return 0
end

def bool_in_select(x: Int): Int
  var result = 0
  if x > 0
    result = 42
  else
    result = 99
  end
  return result
end

def bool_from_const_true(): Int
  if true
    return 1
  end
  return 0
end

def bool_from_const_false(): Int
  if false
    return 1
  end
  return 0
end

def bool_as_int_arg(x: Int, y: Int): Int
  # Comparison result used as arithmetic operand
  var cmp = is_less(x, y)
  return cmp + 10
end

def nested_bool(a: Int, b: Int, c: Int, d: Int): Int
  var x = a < b
  var y = c < d
  if x and y
    return 1
  end
  return 0
end

def bool_in_loop(n: Int): Int
  var count = 0
  for i in 0..n
    if i > 5
      count += 1
    end
  end
  return count
end

def float_comparison(a: F64, b: F64): Int
  if a < b
    return 1
  end
  return 0
end

def bool_return_chain(x: Int): Int
  if x > 100
    return 3
  end
  if x > 50
    return 2
  end
  if x > 0
    return 1
  end
  return 0
end

def main(): Int
  describe("bool narrowing (i1 optimization)") do ->
    it("less-than comparison") do ->
      assert_eq(is_less(5, 10), 1)
      assert_eq(is_less(10, 5), 0)
      assert_eq(is_less(5, 5), 0)
    end

    it("equality comparison") do ->
      assert_eq(is_equal(5, 5), 1)
      assert_eq(is_equal(5, 10), 0)
    end

    it("greater-than comparison") do ->
      assert_eq(is_greater(10, 5), 1)
      assert_eq(is_greater(5, 10), 0)
    end

    it("AND short-circuit") do ->
      assert_eq(both_true(1, 1), 1)
      assert_eq(both_true(1, 0), 0)
      assert_eq(both_true(0, 1), 0)
      assert_eq(both_true(0, 0), 0)
    end

    it("OR short-circuit") do ->
      assert_eq(either_true(1, 1), 1)
      assert_eq(either_true(1, 0), 1)
      assert_eq(either_true(0, 1), 1)
      assert_eq(either_true(0, 0), 0)
    end

    it("chained comparison") do ->
      assert_eq(chained_comparison(1, 2, 3), 1)
      assert_eq(chained_comparison(1, 3, 2), 0)
      assert_eq(chained_comparison(3, 2, 1), 0)
    end

    it("bool in if/else select") do ->
      assert_eq(bool_in_select(1), 42)
      assert_eq(bool_in_select(0), 99)
      assert_eq(bool_in_select(-1), 99)
    end

    it("bool constant true") do ->
      assert_eq(bool_from_const_true(), 1)
    end

    it("bool constant false") do ->
      assert_eq(bool_from_const_false(), 0)
    end

    it("comparison result as i64 arithmetic operand") do ->
      assert_eq(bool_as_int_arg(1, 10), 11)
      assert_eq(bool_as_int_arg(10, 1), 10)
    end

    it("nested bool variables in AND") do ->
      assert_eq(nested_bool(1, 2, 3, 4), 1)
      assert_eq(nested_bool(2, 1, 3, 4), 0)
      assert_eq(nested_bool(1, 2, 4, 3), 0)
    end

    it("bool in counted loop") do ->
      assert_eq(bool_in_loop(10), 4)
      assert_eq(bool_in_loop(6), 0)
      assert_eq(bool_in_loop(20), 14)
    end

    it("float comparison") do ->
      assert_eq(float_comparison(1.0, 2.0), 1)
      assert_eq(float_comparison(2.0, 1.0), 0)
    end

    it("multiple return paths with comparisons") do ->
      assert_eq(bool_return_chain(150), 3)
      assert_eq(bool_return_chain(75), 2)
      assert_eq(bool_return_chain(25), 1)
      assert_eq(bool_return_chain(-5), 0)
    end
  end

  return qspec_main()
end
