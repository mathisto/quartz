import * from qspec
import * from std/sync/communication/channel
import * from std/sync/communication/broadcast

# --- broadcast tests ---

def test_broadcast_single(): Void
  var bcast = broadcast_new()
  var sub = broadcast_subscribe(bcast)
  broadcast_send(bcast, 10)
  broadcast_send(bcast, 20)
  broadcast_send(bcast, 30)
  var a = recv(sub)
  var b = recv(sub)
  var c = recv(sub)
  puts(to_str(a + b + c))
  broadcast_close(bcast)
end

def test_broadcast_multi(): Void
  var bcast = broadcast_new()
  var s1 = broadcast_subscribe(bcast)
  var s2 = broadcast_subscribe(bcast)
  broadcast_send(bcast, 42)
  var v1 = recv(s1)
  var v2 = recv(s2)
  puts("#{to_str(v1)} #{to_str(v2)}")
  broadcast_close(bcast)
end

def test_broadcast_close(): Void
  var bcast = broadcast_new()
  var s1 = broadcast_subscribe(bcast)
  var s2 = broadcast_subscribe(bcast)
  broadcast_close(bcast)
  var c1 = channel_closed(s1)
  var c2 = channel_closed(s2)
  if c1 and c2
    puts("all closed")
  else
    puts("not all closed")
  end
end

def test_broadcast_late_sub(): Void
  var bcast = broadcast_new()
  broadcast_send(bcast, 1)
  var sub = broadcast_subscribe(bcast)
  broadcast_send(bcast, 2)
  var val = recv(sub)
  puts(to_str(val))
  broadcast_close(bcast)
end

def test_broadcast_send_closed(): Void
  var bcast = broadcast_new()
  broadcast_close(bcast)
  var result = broadcast_send(bcast, 99)
  puts(to_str(result))
end

def test_broadcast_count(): Void
  var bcast = broadcast_new()
  var c0 = broadcast_subscriber_count(bcast)
  var s1 = broadcast_subscribe(bcast)
  var c1 = broadcast_subscriber_count(bcast)
  var s2 = broadcast_subscribe(bcast)
  var c2 = broadcast_subscriber_count(bcast)
  puts("#{to_str(c0)} #{to_str(c1)} #{to_str(c2)}")
  broadcast_close(bcast)
end

def test_broadcast_cross_thread(): Void
  var bcast = broadcast_new()
  var sub = broadcast_subscribe(bcast)
  var h = go broadcast_send(bcast, 77)
  var val = recv(sub)
  await h
  puts(to_str(val))
  broadcast_close(bcast)
end

def main(): Int
  describe("broadcast channels") do ->

    it("single subscriber receives all messages") do ->
      assert_output("60\n", test_broadcast_single)
    end

    it("multiple subscribers each receive all messages") do ->
      assert_output("42 42\n", test_broadcast_multi)
    end

    it("close closes all subscriber channels") do ->
      assert_output("all closed\n", test_broadcast_close)
    end

    it("late subscriber only gets future messages") do ->
      assert_output("2\n", test_broadcast_late_sub)
    end

    it("send on closed broadcast returns -1") do ->
      assert_output("-1\n", test_broadcast_send_closed)
    end

    it("subscriber count tracking") do ->
      assert_output("0 1 2\n", test_broadcast_count)
    end

    it("cross-thread broadcast") do ->
      assert_output("77\n", test_broadcast_cross_thread)
    end

  end

  return qspec_main()
end
