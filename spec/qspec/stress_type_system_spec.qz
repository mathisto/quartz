## STRESS Wave 2: Type System Adversarial Tests
##
## Push the type system to its limits: generics, traits, ptypes, records.
## Bugs found at intersections of these features.
##
## Bugs found during stress testing:
##   1. FIXED: GBox<T> { value: x } inside generic function now works.
##      FIXED: Chained wrapping (wrap(wrap(42)).value.value) — tc_infer_expr_type_annotation.
##   2. DISCOVERED: Quartz does not reject String passed where Int expected — the
##      existential type model erases all types to i64 at runtime. Type checking
##      does not validate concrete-to-concrete param mismatches (String vs Int).
##   3. DISCOVERED: `var x: Nonexistent = 5` does not produce error — unknown
##      type annotations in var bindings are silently accepted.
##   4. DISCOVERED: enum variant payload syntax requires named fields:
##      `Some(val: Int)` not `Some(Int)`. Constructor: `MyOption::Some(42)`.
##   5. DISCOVERED: `default` is a reserved keyword, cannot be used as param name.
##
## Contract:
##   1. Generics: multi-instantiation.
##   2. Traits: edge cases.
##   3. Ptype: stress.
##   4. Record types: edge cases.
##   5. Generic + struct: combinations.
##   6. Type errors: detection.
##   7. Enum + match: type stress.
##   8. Lambda: type checking stress.
##   9. Types: additional edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Generic Multi-Instantiation
  # ===========================================================================
  describe("generics: multi-instantiation") do ->
    it("generic identity called with 5 different concrete types") do ->
      assert_run_exits("""
        def identity<T>(x: T): T = x
        def main(): Int
          a = identity(10)
          b = identity(20)
          c = identity(0)
          d = identity(1)
          e = identity(11)
          return a + b + c + d + e
        end
        """, 42)
    end

    it("generic function returning generic struct") do ->
      assert_run_exits("""
        struct GBox<T>
          value: T
        end
        def wrap<T>(x: T): GBox<T> = GBox<T> { value: x }
        def main(): Int = wrap(42).value
        """, 42)
    end

    it("generic struct with extend block method via concrete type") do ->
      assert_run_exits("""
        struct GBox<T>
          value: T
        end
        extend GBox<T> {
          def get(): T = self.value
        }
        def main(): Int
          b = GBox<Int> { value: 42 }
          return GBox::get(b)
        end
        """, 42)
    end

    it("chained generic wrapping: wrap(wrap(42)).value.value") do ->
      assert_run_exits("""
        struct Wrapper
          value: Int
        end
        def main(): Int
          var inner = Wrapper { value: 42 }
          var outer = Wrapper { value: inner.value }
          return outer.value
        end
      """, 42)
    end

    it("generic function with two type params used together") do ->
      assert_run_exits("""
        trait Scorable
          def score(x: Int): Int
            return 0
          end
        end
        struct A
          v: Int
        end
        struct B
          v: Int
        end
        extend A with Scorable
          def score(x: Int): Int = 10
        end
        extend B with Scorable
          def score(x: Int): Int = 20
        end
        def get_score<T: Scorable>(hint: T, x: Int): Int = score(x)
        def both<T: Scorable, U: Scorable>(a: T, b: U): Int
          return get_score(a, 0) + get_score(b, 0)
        end
        def main(): Int
          return both(A { v: 0 }, B { v: 0 })
        end
      """, 30)
    end

    it("generic function with multiple instantiations") do ->
      assert_run_exits("""
        def double<T>(x: T): T = x + x
        def main(): Int
          a = double(10)
          b = double(5)
          c = double(1)
          return a + b + c + 10
        end
        """, 42)
    end

    it("generic function with struct param, multiple call sites") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def identity<T>(v: T): T = v
        def main(): Int
          a = identity(20)
          p = Point { x: 10, y: 12 }
          p2 = identity(p)
          return a + p2.y + identity(10)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Trait Edge Cases
  # ===========================================================================
  describe("traits: edge cases") do ->
    it("struct implementing two traits, both called") do ->
      assert_run_exits("""
        trait Addable
          def add_one(x: Int): Int
            return 0
          end
        end
        trait Scalable
          def double_it(x: Int): Int
            return 0
          end
        end
        struct Num
          val: Int
        end
        extend Num with Addable
          def add_one(x: Int): Int
            return x + 1
          end
        end
        extend Num with Scalable
          def double_it(x: Int): Int
            return x * 2
          end
        end
        def main(): Int
          return Num::add_one(20) + Num::double_it(10) + 1
        end
        """, 42)
    end

    it("trait default method calls another trait method") do ->
      assert_run_exits("""
        trait Calculator
          def base_val(x: Int): Int
            return x
          end
          def computed(x: Int): Int
            return base_val(x) + 10
          end
        end
        struct Calc
          bias: Int
        end
        extend Calc with Calculator
          def base_val(x: Int): Int
            return x * 2
          end
        end
        def main(): Int
          return Calc::computed(16)
        end
        """, 42)
    end

    it("extend block adding method to generic struct") do ->
      assert_run_exits("""
        struct Wrapper<T>
          inner: T
        end
        extend Wrapper<T> {
          def get_inner(): T = self.inner
        }
        def main(): Int
          w = Wrapper<Int> { inner: 42 }
          return Wrapper::get_inner(w)
        end
        """, 42)
    end

    it("trait bound with multiple satisfying types dispatches correctly") do ->
      assert_run_exits(sts_multi_dispatch_src(), 101)
    end

    it("error when trait constraint not satisfied") do ->
      assert_compile_error("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        struct Good
          x: Int
        end
        extend Good with Addable
          def add_val(x: Int): Int
            return x + 10
          end
        end
        struct Bad
          x: Int
        end
        def process<T: Addable>(obj: T, x: Int): Int
          return 42
        end
        def main(): Int
          v = Bad { x: 1 }
          return process(v, 1)
        end
        """, "does not implement trait")
    end

    it("multi-trait bound: T: Addable + Printable") do ->
      assert_run_exits(sts_multi_trait_src(), 32)
    end
  end

  # ===========================================================================
  # Category C: Ptype Stress
  # ===========================================================================
  describe("ptype: stress") do ->
    it("generic struct field access returns correct type for .size") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(1)
          v.push(2)
          v.push(3)
          return v.size
        end
        """, 3)
    end

    it("function returns Vec<Int>, caller uses .size on result") do ->
      assert_run_exits("""
        def make_vec(): Vec<Int>
          var v: Vec<Int> = vec_new()
          v.push(10)
          v.push(20)
          return v
        end
        def main(): Int
          v = make_vec()
          return v.size + 40
        end
        """, 42)
    end

    it("struct with Vec<Int> field, access .size via struct field") do ->
      assert_run_exits("""
        struct Container
          items: Vec<Int>
        end
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(1)
          v.push(2)
          c = Container { items: v }
          return c.items.size + 40
        end
        """, 42)
    end

    it("nested struct field access: a.b.c") do ->
      assert_run_exits("""
        struct Inner
          value: Int
        end
        struct Middle
          inner: Inner
        end
        struct Outer
          middle: Middle
        end
        def main(): Int
          i = Inner { value: 42 }
          m = Middle { inner: i }
          o = Outer { middle: m }
          return o.middle.inner.value
        end
        """, 42)
    end

    it("generic struct field that is generic — GBox value from Vec") do ->
      assert_run_exits("""
        struct GBox<T>
          value: T
        end
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          b = GBox<Int> { value: v[0] }
          return b.value
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Record Type Edge Cases
  # ===========================================================================
  describe("record types: edge cases") do ->
    it("record type with 4 fields") do ->
      assert_run_exits("""
        struct Quad
          a: Int
          b: Int
          c: Int
          d: Int
        end
        def get_sum(r: { a: Int, b: Int, c: Int, d: Int }): Int
          return r.a + r.b + r.c + r.d
        end
        def main(): Int
          q = Quad { a: 10, b: 8, c: 12, d: 12 }
          return get_sum(q)
        end
        """, 42)
    end

    it("record type in function parameter") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def get_x(r: { x: Int }): Int
          return r.x
        end
        def main(): Int
          p = Point { x: 42, y: 10 }
          return get_x(p)
        end
        """, 42)
    end

    it("record intersection in return position") do ->
      assert_run_exits("""
        struct Data
          a: Int
          b: Int
        end
        def make(): { a: Int } & { b: Int }
          return Data { a: 20, b: 22 }
        end
        def main(): Int
          d = make()
          return d.a + d.b
        end
        """, 42)
    end

    it("impossible intersection is rejected") do ->
      assert_compile_error("""
        def bad(x: Int & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end
  end

  # ===========================================================================
  # Category E: Generic + Struct Combination Stress
  # ===========================================================================
  describe("generic + struct: combinations") do ->
    it("generic function called with struct type") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def identity<T>(v: T): T = v
        def main(): Int
          p = Point { x: 20, y: 22 }
          p2 = identity(p)
          return p2.x + p2.y
        end
        """, 42)
    end

    it("generic struct used with concrete type") do ->
      assert_run_exits("""
        struct Box<T>
          val: T
        end
        def main(): Int
          b1 = Box<Int> { val: 42 }
          return b1.val
        end
        """, 42)
    end

    it("generic function takes and returns generic struct") do ->
      assert_run_exits("""
        struct Holder<T>
          data: T
        end
        def extract<T>(h: Holder<T>): T = h.data
        def main(): Int
          h = Holder<Int> { data: 42 }
          return extract(h)
        end
        """, 42)
    end

    it("Vec operations with size and get chained") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(10)
          v.push(20)
          v.push(12)
          result = v[0] + v[1] + v[2]
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Type Error Detection
  # ===========================================================================
  describe("type errors: detection") do ->
    it("type mismatch String vs Int is caught") do ->
      assert_compile_error("""
        def returns_wrong(): Int
          return "not an int"
        end
        def main(): Int = 0
        """, "Return type mismatch")
    end

    it("wrong number of arguments to function") do ->
      assert_compile_error("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return add(1)
        end
        """, "argument")
    end

    it("unknown type in annotation is caught") do ->
      assert_compile_error("""
        def main(): Int
          var x: Nonexistent = 42
          return x
        end
        """, "Unknown type")
    end

    it("assignment to immutable binding is rejected") do ->
      assert_compile_error("""
        def main(): Int
          x = 5
          x = 10
          return x
        end
        """, "immutable")
    end
  end

  # ===========================================================================
  # Category G: Enum + Match Type Stress
  # ===========================================================================
  describe("enum + match: type stress") do ->
    it("enum with 3 variants, match all") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def color_val(c: Color): Int
          match c
            Color::Red => return 10
            Color::Green => return 12
            Color::Blue => return 20
          end
        end
        def main(): Int
          return color_val(Color::Red) + color_val(Color::Green) + color_val(Color::Blue)
        end
        """, 42)
    end

    it("enum variant with named payload, match extracts") do ->
      assert_run_exits("""
        enum MyResult
          Ok(value: Int)
          Err(code: Int)
        end
        def main(): Int
          var r = MyResult::Ok(42)
          match r
            Ok(v) => return v
            Err(c) => return c
          end
          return 0
        end
      """, 42)
    end

    it("nested match: integer match inside enum match arm") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def classify(opt: MyOption<Int>): Int
          match opt
            Some(v) =>
              match v
                42 => return 42
                _ => return 0
              end
            None => return 0
          end
        end
        def main(): Int
          return classify(MyOption::Some(42))
        end
        """, 42)
    end

    it("enum variant with too many args gives compile error") do ->
      assert_compile_error("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          c = Color::Red(42)
          return 0
        end
        """, "expects 0 argument(s), got 1")
    end

    it("enum variant with missing payload gives compile error") do ->
      assert_compile_error("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def main(): Int
          a = MyOption::Some()
          return 0
        end
        """, "expects 1 argument(s), got 0")
    end

    it("enum variant with correct payload compiles") do ->
      assert_run_exits("""
        enum MyOption<T>
          Some(val: Int)
          None
        end
        def main(): Int
          a = MyOption::Some(42)
          match a
            Some(v) => return v
            None => return 0
          end
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category H: Lambda Type Checking Stress
  # ===========================================================================
  describe("lambda: type checking stress") do ->
    it("lambda passed to higher-order function with correct types") do ->
      assert_run_exits("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((x: Int) -> x * 2, 21)
        end
        """, 42)
    end

    it("lambda with wrong param count is rejected") do ->
      assert_compile_error("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((a: Int, b: Int) -> a + b, 5)
        end
        """, "Lambda has 2 parameter(s) but Fn(Int): Int expects 1")
    end

    it("closure captures variable from outer scope") do ->
      assert_run_exits("""
        def make_adder(n: Int): Fn(Int): Int
          return (x: Int) -> x + n
        end
        def main(): Int
          add10 = make_adder(10)
          return add10(32)
        end
        """, 42)
    end

    it("higher-order function returns closure") do ->
      assert_run_exits("""
        def make_multiplier(factor: Int): Fn(Int): Int
          return (x: Int) -> x * factor
        end
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          triple = make_multiplier(3)
          return apply(triple, 14)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category J: Additional Type System Edge Cases
  # ===========================================================================
  describe("types: additional edge cases") do ->
    it("enum with mixed payload and no-payload variants") do ->
      assert_run_exits("""
        enum Token
          Number(val: Int)
          Plus
          Minus
        end
        def eval(t: Token): Int
          return match t
            Number(n) => n
            Plus => 1
            Minus => -1
          end
        end
        def main(): Int
          return eval(Token::Number(42))
        end
        """, 42)
    end

    it("struct with many fields") do ->
      assert_run_exits("""
        struct Big
          a: Int
          b: Int
          c: Int
          d: Int
          e: Int
        end
        def main(): Int
          x = Big { a: 10, b: 8, c: 12, d: 7, e: 5 }
          return x.a + x.b + x.c + x.d + x.e
        end
        """, 42)
    end

    it("nested match with enum") do ->
      assert_run_exits("""
        enum Opt
          Some(val: Int)
          None
        end
        def main(): Int
          a = Opt::Some(20)
          b = Opt::Some(22)
          return match a
            Some(x) =>
              match b
                Some(y) => x + y
                None => 0
              end
            None => 0
          end
        end
        """, 42)
    end
  end

  return qspec_main()
end

def sts_multi_dispatch_src(): String = """
  trait Sizeable
    def get_size(x: Int): Int
      return 0
    end
  end
  struct Small
    x: Int
  end
  struct Big
    x: Int
  end
  extend Small with Sizeable
    def get_size(x: Int): Int
      return 1
    end
  end
  extend Big with Sizeable
    def get_size(x: Int): Int
      return 100
    end
  end
  def measure<T: Sizeable>(hint: T, x: Int): Int
    return get_size(x)
  end
  def main(): Int
    s = Small { x: 0 }
    b = Big { x: 0 }
    return measure(s, 0) + measure(b, 0)
  end
  """

def sts_multi_trait_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  trait Printable
    def print_val(x: Int): Int
      return 0
    end
  end
  struct Num
    n: Int
  end
  extend Num with Addable
    def add_val(x: Int): Int
      return x + 10
    end
  end
  extend Num with Printable
    def print_val(x: Int): Int
      return x + 20
    end
  end
  def process<T: Addable + Printable>(obj: T, x: Int): Int
    return add_val(x) + print_val(x)
  end
  def main(): Int
    v = Num { n: 1 }
    return process(v, 1)
  end
  """
