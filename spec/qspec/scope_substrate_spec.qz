## scope substrate (B.7 Phase 2)
##
## Contract:
##   1. `scope_root()` is non-zero, idempotent, never cancelled.
##   2. `scope_with_cancel(parent)` creates an uncancelled child.
##   3. `scope_cancel(s)` flips is_cancelled to true; cancelled_at_ns is
##      a monotonic timestamp; cancel_reason defaults to "cancelled".
##   4. `scope_cancel(s)` is idempotent — second call is a no-op.
##   5. Cancelling a parent propagates to children AND grandchildren.
##   6. Sibling cancellation does NOT propagate across siblings.
##   7. `scope_cancel_with(s, "reason")` stores the user-supplied reason.
##   8. `scope_timeout(parent, ms)` creates a child with deadline; the
##      remaining-ms reading is positive when ms > 0.
##   9. A scope whose deadline has passed lazy-fires on next is_cancelled
##      with reason "deadline_exceeded" and a real cancelled_at_ns.
##  10. `scope_supervised(parent)` sets the supervisor flag.
##  11. Parent deadline caps child deadlines (min derivation).
##  12. `scope_check(s)` throws when cancelled, no-ops otherwise.
##  13. Root is uncancellable — scope_cancel(root) is silently ignored.

import * from qspec
import * from std/sync/composition/scope
import * from std/throws

# Module-level capture for handler-based throw assertions.
var sb_caught = ""

def sb_capture(op_name: Int, argc: Int, argv: Int): Int
  sb_caught = as_type<String>(load(argv, 0))
  return 0
end

def sb_check_under_throws(s: Int): Int
  with Throws { throw: sb_capture } do ->
    scope_check(s)
    1   # reached only if check did NOT throw
  end
end

def main(): Int
  describe("scope substrate (B.7 Phase 2)") do ->

    it("scope_root() is non-zero and idempotent") do ->
      var r1 = scope_root()
      var r2 = scope_root()
      assert_eq(r1, r2)
      # not zero
      var nonzero = 0
      if r1 != 0
        nonzero = 1
      end
      assert_eq(nonzero, 1)
    end

    it("root scope is never cancelled") do ->
      var r = scope_root()
      assert_eq(scope_is_cancelled(r), false)
    end

    it("root scope is uncancellable — scope_cancel(root) is a no-op") do ->
      var r = scope_root()
      scope_cancel(r)
      assert_eq(scope_is_cancelled(r), false)
    end

    it("scope_with_cancel creates a non-cancelled child") do ->
      var s = scope_with_cancel(scope_root())
      assert_eq(scope_is_cancelled(s), false)
      assert_eq(scope_cancelled_at(s), -1)
      assert_eq_str(scope_cancel_reason(s), "")
    end

    it("scope_cancel flips is_cancelled and stamps cancelled_at_ns") do ->
      var s = scope_with_cancel(scope_root())
      var before = time_mono_ns()
      scope_cancel(s)
      var after = time_mono_ns()
      assert_eq(scope_is_cancelled(s), true)
      var at = scope_cancelled_at(s)
      var in_range = 0
      if at >= before and at <= after
        in_range = 1
      end
      assert_eq(in_range, 1)
      assert_eq_str(scope_cancel_reason(s), "cancelled")
    end

    it("scope_cancel is idempotent — second call doesn't move cancelled_at") do ->
      var s = scope_with_cancel(scope_root())
      scope_cancel(s)
      var first_at = scope_cancelled_at(s)
      scope_cancel(s)
      var second_at = scope_cancelled_at(s)
      assert_eq(first_at, second_at)
    end

    it("scope_cancel_with stores the user-supplied reason") do ->
      var s = scope_with_cancel(scope_root())
      scope_cancel_with(s, "user kicked it")
      assert_eq(scope_is_cancelled(s), true)
      assert_eq_str(scope_cancel_reason(s), "user kicked it")
    end

    it("cancelling a parent propagates to children") do ->
      var p = scope_with_cancel(scope_root())
      var c1 = scope_with_cancel(p)
      var c2 = scope_with_cancel(p)
      assert_eq(scope_is_cancelled(c1), false)
      assert_eq(scope_is_cancelled(c2), false)
      scope_cancel(p)
      assert_eq(scope_is_cancelled(c1), true)
      assert_eq(scope_is_cancelled(c2), true)
      assert_eq_str(scope_cancel_reason(c1), "cancelled")
    end

    it("cancellation propagates to grandchildren") do ->
      var p = scope_with_cancel(scope_root())
      var c = scope_with_cancel(p)
      var gc = scope_with_cancel(c)
      assert_eq(scope_is_cancelled(gc), false)
      scope_cancel(p)
      assert_eq(scope_is_cancelled(gc), true)
    end

    it("sibling cancellation does NOT propagate across siblings") do ->
      var p = scope_with_cancel(scope_root())
      var a = scope_with_cancel(p)
      var b = scope_with_cancel(p)
      scope_cancel(a)
      assert_eq(scope_is_cancelled(a), true)
      assert_eq(scope_is_cancelled(b), false)
      assert_eq(scope_is_cancelled(p), false)
    end

    it("scope_timeout sets a positive deadline_remaining_ms") do ->
      var s = scope_timeout(scope_root(), 60_000)
      var rem = scope_deadline_remaining_ms(s)
      var ok = 0
      if rem > 0 and rem <= 60_000
        ok = 1
      end
      assert_eq(ok, 1)
    end

    it("scope_with_cancel reports deadline_remaining_ms == -1") do ->
      var s = scope_with_cancel(scope_root())
      assert_eq(scope_deadline_remaining_ms(s), -1)
    end

    it("a passed deadline lazy-fires with reason deadline_exceeded") do ->
      # 0ms timeout: deadline = now → already past on first read
      var s = scope_timeout(scope_root(), 0)
      assert_eq(scope_is_cancelled(s), true)
      assert_eq_str(scope_cancel_reason(s), "deadline_exceeded")
      var at = scope_cancelled_at(s)
      var have_stamp = 0
      if at > 0
        have_stamp = 1
      end
      assert_eq(have_stamp, 1)
    end

    it("parent deadline caps child deadlines (min derivation)") do ->
      var parent = scope_timeout(scope_root(), 100)        # 100ms parent
      var child  = scope_timeout(parent, 60_000)           # 60s child request
      var rem = scope_deadline_remaining_ms(child)
      # Child's effective deadline is parent's (smaller), so remaining ≤ 100ms.
      var capped = 0
      if rem >= 0 and rem <= 100
        capped = 1
      end
      assert_eq(capped, 1)
    end

    it("scope_supervised sets the supervisor flag") do ->
      var s = scope_supervised(scope_root())
      assert_eq(scope_is_supervised(s), true)
      var s2 = scope_with_cancel(scope_root())
      assert_eq(scope_is_supervised(s2), false)
    end

    it("scope_check no-ops on a non-cancelled scope") do ->
      var s = scope_with_cancel(scope_root())
      var r = sb_check_under_throws(s)
      assert_eq(r, 1)   # reached past scope_check
    end

    it("scope_check throws the cancellation reason") do ->
      sb_caught = ""
      var s = scope_with_cancel(scope_root())
      scope_cancel_with(s, "user_reason_xyz")
      var r = sb_check_under_throws(s)
      assert_eq(r, 0)   # handler returned 0; with-block value is 0
      assert_eq_str(sb_caught, "user_reason_xyz")
    end

    it("scope_check throws deadline_exceeded on lazy-fired deadline") do ->
      sb_caught = ""
      var s = scope_timeout(scope_root(), 0)
      var _r = sb_check_under_throws(s)
      assert_eq_str(sb_caught, "deadline_exceeded")
    end
  end

  return qspec_main()
end
