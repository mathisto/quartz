## Random Number Generation Tests
##
## Contract:
##   1. Rand_seed and rand_int.
##   2. Rand_range.
##   3. Rand_float.
##   4. Rand edge cases.
##
## Migrated to Random effect ops in A.8 Pass 3 (2026-05-01).
## `rand_seed_op` / `rand_int_op` / `rand_range_op` / `rand_crypto_op`
## dispatch through the blessed default handler which forwards to the
## existing `qz_rand_*` runtime helpers — same xoshiro256** behavior,
## now overridable via `with Random {...}`. `rand_float` stays as a
## bare intrinsic (no effect op — handler ABI is i64-only).

import * from qspec
import * from std/random

def rng_deterministic(): Int
  rand_seed_op(42)
  var a = rand_int_op()
  rand_seed_op(42)
  var b = rand_int_op()
  if a == b
    return 1
  end
  return 0
end

def rng_range_valid(): Int
  rand_seed_op(123)
  var ok = 1
  var i = 0
  while i < 100
    var r = rand_range_op(0, 10)
    if r < 0
      ok = 0
    end
    if r >= 10
      ok = 0
    end
    i = i + 1
  end
  return ok
end

def main(): Int
  describe("rand_seed and rand_int") do ->
    it("produces deterministic output with same seed") do ->
      assert_eq(rng_deterministic(), 1)
    end

    it("different seeds produce different values") do ->
      rand_seed_op(1)
      var a = rand_int_op()
      rand_seed_op(2)
      var b = rand_int_op()
      ## Different seeds should produce different values (probabilistic but highly likely)
      assert_eq(a != b, true)
    end

    it("sequential calls produce different values") do ->
      rand_seed_op(42)
      var a = rand_int_op()
      var b = rand_int_op()
      var c = rand_int_op()
      ## Three sequential calls should not all be equal
      var all_same = (a == b) and (b == c)
      assert_eq(all_same, false)
    end

    it("re-seeding resets the sequence") do ->
      rand_seed_op(100)
      var a1 = rand_int_op()
      var a2 = rand_int_op()
      rand_seed_op(100)
      var b1 = rand_int_op()
      var b2 = rand_int_op()
      assert_eq(a1, b1)
      assert_eq(a2, b2)
    end
  end

  describe("rand_range") do ->
    it("returns values in range") do ->
      assert_eq(rng_range_valid(), 1)
    end

    it("range with min 0 max 1 returns 0") do ->
      rand_seed_op(42)
      var ok = 1
      for i in 0..50
        var r = rand_range_op(0, 1)
        if r != 0
          ok = 0
        end
      end
      assert_eq(ok, 1)
    end

    it("range with larger bounds stays in range") do ->
      rand_seed_op(42)
      var ok = 1
      for i in 0..100
        var r = rand_range_op(100, 200)
        if r < 100 or r >= 200
          ok = 0
        end
      end
      assert_eq(ok, 1)
    end

    it("range with negative bounds stays in range") do ->
      rand_seed_op(42)
      var ok = 1
      for i in 0..100
        var r = rand_range_op(-10, 10)
        if r < -10 or r >= 10
          ok = 0
        end
      end
      assert_eq(ok, 1)
    end
  end

  describe("rand_float") do ->
    it("returns values in [0, 1)") do ->
      rand_seed_op(42)
      # to_int truncates — rand_float() in [0,1) always truncates to 0
      assert_eq(to_int(rand_float()), 0)
      assert_eq(to_int(rand_float()), 0)
      assert_eq(to_int(rand_float()), 0)
    end

    it("float values are non-negative") do ->
      rand_seed_op(789)
      var ok = 1
      for i in 0..100
        var f = rand_float()
        ## truncating a value in [0,1) should always yield 0
        if to_int(f) != 0
          ok = 0
        end
      end
      assert_eq(ok, 1)
    end

    it("float values vary with seed") do ->
      rand_seed_op(1)
      var a = rand_float()
      rand_seed_op(2)
      var b = rand_float()
      ## Different seeds should give different floats (very high probability)
      assert_eq(to_int(a * 1000000.0) != to_int(b * 1000000.0), true)
    end
  end

  describe("rand edge cases") do ->
    it("seed with 0 works") do ->
      rand_seed_op(0)
      var r = rand_int_op()
      ## Just verify it doesn't crash
      assert_eq(r == r, true)
    end

    it("seed with large value works") do ->
      rand_seed_op(999999999)
      var r = rand_int_op()
      assert_eq(r == r, true)
    end

    it("cryptographically secure random") do ->
      var a = rand_crypto_op()
      var b = rand_crypto_op()
      # Two crypto random values should (almost certainly) differ
      assert_eq(a != b, true)
    end
  end

  return qspec_main()
end

