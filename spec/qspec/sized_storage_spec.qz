## Sized Storage Tests
##
## Contract:
##   1. Chain of narrow calls.
##   2. I16 local variable.
##   3. I16 passes through function.
##   4. I32 local variable.
##   5. I32 param with i8.
##   6. I32 passes through function.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("sized storage") do ->
    it("I32 passes through function") do ->
      assert_eq(ss_i32_passthrough(42), 42)
    end
    it("I32 truncates exceeding range") do ->
      assert_eq(ss_i32_passthrough(4294967296), 0)
    end
    it("I8 passes through function") do ->
      assert_eq(ss_i8_passthrough(7), 7)
    end
    it("I8 sign-extends values") do ->
      assert_eq(ss_i8_signext(), 1)
    end
    it("I8 truncates 256 to 0") do ->
      assert_eq(ss_i8_passthrough(256), 0)
    end
    it("I16 passes through function") do ->
      assert_eq(ss_i16_passthrough(100), 100)
    end
    it("U8 passes through function") do ->
      assert_eq(ss_u8_passthrough(200), 200)
    end
    it("U8 zero-extends values") do ->
      assert_eq(ss_u8_passthrough(200), 200)
    end
    it("U16 passes through function") do ->
      assert_eq(ss_u16_passthrough(50), 50)
    end
    it("U32 passes through function") do ->
      assert_eq(ss_u32_passthrough(50), 50)
    end
    it("I8 param with I32 return") do ->
      assert_eq(ss_i8_to_i32(42), 42)
    end
    it("I32 param with I8 return") do ->
      assert_eq(ss_i32_to_i8(42), 42)
    end
    it("narrow param with Int return") do ->
      assert_eq(ss_i8_to_int(99), 99)
    end
    it("Int param with narrow return") do ->
      assert_eq(ss_int_to_i32(77), 77)
    end
    it("chain of narrow calls") do ->
      assert_eq(ss_double_i8(5), 12)
    end
    it("I32 local variable") do ->
      assert_eq(ss_i32_local(), 42)
    end
    it("I8 local truncates to 8 bits") do ->
      assert_run_exits(ss_i8_local_trunc_src(), 44)
    end
    it("I8 local sign-extends") do ->
      assert_eq(ss_i8_local_signext(), -56)
    end
    it("U8 local zero-extends") do ->
      assert_eq(ss_u8_local(), 200)
    end
    it("I16 local variable") do ->
      assert_eq(ss_i16_local(), 99)
    end
    it("U32 local variable") do ->
      assert_eq(ss_u32_local(), 77)
    end
    it("narrow local reassignment") do ->
      assert_eq(ss_i32_reassign(), 42)
    end
    it("narrow local with function call") do ->
      assert_eq(ss_i32_local_call(), 42)
    end
    it("mixed narrow and regular locals") do ->
      assert_eq(ss_mixed_locals(), 42)
    end
    it("regular Int functions still work") do ->
      assert_eq(ss_regular_add(20, 22), 42)
    end
    it("narrow local uses i32 alloca (IR test)") do ->
      assert_ir_contains("""
def main(): Int
  var x: I32 = 42
  return x
end
""", "alloca i32")
    end
  end
  return qspec_main()
end

def ss_i32_passthrough(x: I32): I32 = x
def ss_i8_passthrough(x: I8): I8 = x
def ss_i16_passthrough(x: I16): I16 = x
def ss_u8_passthrough(x: U8): U8 = x
def ss_u16_passthrough(x: U16): U16 = x
def ss_u32_passthrough(x: U32): U32 = x

def ss_i8_signext(): Int
  var val = ss_i8_passthrough(255)
  return val + 2
end

def ss_i8_to_i32(x: I8): I32 = x
def ss_i32_to_i8(x: I32): I8 = x
def ss_i8_to_int(x: I8): Int = x
def ss_int_to_i32(x: Int): I32 = x

def ss_add_one_i8(x: I8): I8 = x + 1
def ss_double_i8(x: I8): I8 = ss_add_one_i8(x) + ss_add_one_i8(x)

def ss_i32_local(): Int
  var x: I32 = 42
  return x
end

def ss_u8_local(): Int
  var x: U8 = 200
  return x
end

def ss_i16_local(): Int
  var x: I16 = 99
  return x
end

def ss_u32_local(): Int
  var x: U32 = 77
  return x
end

def ss_i32_reassign(): Int
  var x: I32 = 10
  x = 42
  return x
end

def ss_add_i32(a: I32, b: I32): I32 = a + b

def ss_i32_local_call(): Int
  var x: I32 = 20
  var y: I32 = 22
  return ss_add_i32(x, y)
end

def ss_mixed_locals(): Int
  var narrow_val: I8 = 10
  var regular = 32
  return narrow_val + regular
end

def ss_regular_add(a: Int, b: Int): Int = a + b

def ss_i8_local_trunc(): Int
  var x: I8 = 300
  return x
end

def ss_i8_local_trunc_src(): String
  var s = "def main(): Int\n"
  s = s + "  var x: I8 = 300\n"
  s = s + "  return x\n"
  s = s + "end\n"
  return s
end

def ss_i8_local_signext(): Int
  var x: I8 = 200
  return x
end
