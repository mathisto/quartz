## Wildcard Routes Spec — Tests for *path catch-all route matching

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers
# =============================================================================

def extract_and_get(pattern: String, path: String, name: String): String
  var params = map_new()
  _extract_params(pattern, path, params)
  match params.get(name)
    Some(v) => return v
    _ => return ""
  end
end

# =============================================================================
# Test helpers
# =============================================================================

def print_wildcard_match(): Void
  puts(str_from_int(route_matches("/files/*path", "/files/a/b/c")))
end

def print_wildcard_no_match(): Void
  puts(str_from_int(route_matches("/files/*path", "/other/a/b")))
end

def print_wildcard_extract(): Void
  puts(extract_and_get("/files/*path", "/files/a/b/c", "path"))
end

def print_wildcard_single_segment(): Void
  puts(extract_and_get("/assets/*rest", "/assets/style.css", "rest"))
end

def print_wildcard_empty_remainder(): Void
  # When path exactly matches prefix, wildcard gets empty string
  var result = extract_and_get("/files/*path", "/files/", "path")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_mixed_param_wildcard(): Void
  var params = map_new()
  _extract_params("/api/:version/*rest", "/api/v2/users/list", params)
  match params.get("version")
    Some(v) => puts(v)
    _ => puts("")
  end
  match params.get("rest")
    Some(v) => puts(v)
    _ => puts("")
  end
end

def print_wildcard_encoded(): Void
  puts(extract_and_get("/dl/*file", "/dl/my%20doc.pdf", "file"))
end

def print_route_param_wildcard(): Void
  puts(route_param("/files/*path", "/files/a/b/c", "path"))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("wildcard route matching") do ->
    it("matches wildcard pattern") do ->
      assert_output("1\n", print_wildcard_match)
    end

    it("does not match wrong prefix") do ->
      assert_output("0\n", print_wildcard_no_match)
    end
  end

  describe("wildcard param extraction") do ->
    it("extracts rest of path as param") do ->
      assert_output("a/b/c\n", print_wildcard_extract)
    end

    it("extracts single segment") do ->
      assert_output("style.css\n", print_wildcard_single_segment)
    end

    it("extracts empty for trailing slash") do ->
      assert_output("empty\n", print_wildcard_empty_remainder)
    end

    it("works with :param before *wildcard") do ->
      assert_output("v2\nusers/list\n", print_mixed_param_wildcard)
    end

    it("URL-decodes wildcard value") do ->
      assert_output("my doc.pdf\n", print_wildcard_encoded)
    end

    it("works via route_param legacy API") do ->
      assert_output("a/b/c\n", print_route_param_wildcard)
    end
  end

  return qspec_main()
end
