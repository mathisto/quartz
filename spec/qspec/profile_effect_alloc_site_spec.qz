## QSpec coverage for the prof_alloc_site op + accumulator
## (Phase B.1 Phase 1, 2026-05-01).
##
## Locks in the substrate that lets Phase 2 instrument suspected
## codegen hot sites:
##   - Default handler is gated on `_profile_alloc_track_enabled`;
##     OFF (default) = no-op fast path; ON = accumulate (bytes,
##     count) per label.
##   - Reset/setter/reporter API works from spec scope.
##   - Top-N reporter sorts descending by total bytes.
##   - User `with Profile { prof_alloc_site: h }` overrides the
##     default; capture/silent/ndjson factories handle the new op.
##
## Out of scope:
##   - Compiler-source instrumentation. That's Phase 2.
##   - --alloc-track CLI flag. That's Phase 2.

import * from qspec
import std/profile

# --- Test 1: default handler is a no-op when track flag is off.
#     Calls accumulate nothing; total_bytes/total_calls stay 0.

def t1_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(0)
  prof_alloc_site("ir_buffer", 1024)
  prof_alloc_site("ir_buffer", 2048)
  prof_alloc_site("mir_instr", 512)
  puts("track=#{profile_get_alloc_track()}")
  puts("total_bytes=#{profile_alloc_total_bytes()}")
  puts("total_calls=#{profile_alloc_total_calls()}")
end

# --- Test 2: track flag ON; accumulator sums bytes per label and
#     counts calls.

def t2_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(1)
  prof_alloc_site("ir_buffer", 1024)
  prof_alloc_site("ir_buffer", 2048)
  prof_alloc_site("mir_instr", 512)
  puts("total_bytes=#{profile_alloc_total_bytes()}")
  puts("total_calls=#{profile_alloc_total_calls()}")
  profile_set_alloc_track(0)
end

# --- Test 3: profile_alloc_reset clears the accumulator without
#     touching the gate flag.

def t3_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(1)
  prof_alloc_site("a", 100)
  prof_alloc_site("b", 200)
  puts("before_reset_bytes=#{profile_alloc_total_bytes()}")
  profile_alloc_reset()
  puts("after_reset_bytes=#{profile_alloc_total_bytes()}")
  puts("after_reset_track=#{profile_get_alloc_track()}")
  profile_set_alloc_track(0)
end

# --- Test 4: user `with Profile { prof_alloc_site: h }` overrides
#     the default. Capture handler appends to log, default
#     accumulator does NOT see the call.

var _t4_calls = 0

def t4_mock_handler(op_name: Int, argc: Int, argv: Int): Int
  _t4_calls = _t4_calls + 1
  return 42
end

def t4_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(1)
  _t4_calls = 0
  with Profile { prof_alloc_site: t4_mock_handler } do ->
    var rv = prof_alloc_site("foo", 99)
    puts("rv=#{rv}")
  end
  puts("calls=#{_t4_calls}")
  puts("default_bytes=#{profile_alloc_total_bytes()}")
  profile_set_alloc_track(0)
end

# --- Test 5: post-with calls fall back to the prelude default.

def t5_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(1)
  _t4_calls = 0
  with Profile { prof_alloc_site: t4_mock_handler } do ->
    prof_alloc_site("inside", 10)
  end
  prof_alloc_site("outside", 20)
  puts("mock_calls=#{_t4_calls}")
  puts("default_bytes=#{profile_alloc_total_bytes()}")
  profile_set_alloc_track(0)
end

# --- Test 6: capture handler factory sees prof_alloc_site.

def t6_body(): Void
  prof_alloc_site("ir_buffer", 1024)
  prof_alloc_site("mir_instr", 256)
end

def t6_run(): Void
  profile_capture_reset()
  with Profile { prof_alloc_site: profile_capture_handler } do ->
    t6_body()
  end
  var log = profile_capture_log()
  for entry in log
    puts(entry)
  end
end

# --- Test 7: silent handler factory drops prof_alloc_site (no
#     observable output and returns 0).

def t7_run(): Void
  with Profile { prof_alloc_site: profile_silent_handler } do ->
    var rv = prof_alloc_site("ignored", 4096)
    puts("silent_rv=#{rv}")
  end
end

# --- Test 8: ndjson handler factory emits NDJSON for prof_alloc_site.
#     Note: ndjson handler emits to stderr via eputs, but also returns
#     0 — assert_output captures stdout only, so we just observe the
#     return value via puts.

def t8_run(): Void
  with Profile { prof_alloc_site: profile_ndjson_handler } do ->
    var rv = prof_alloc_site("test_label", 123)
    puts("ndjson_rv=#{rv}")
  end
end

# --- Test 9: top_n reporter sorts descending and emits to stderr
#     (stderr not captured here — we only assert the in-memory state
#     it summarizes via the totals API). Behavioral coverage of the
#     sort path is implicit via accumulator correctness.

def t9_run(): Void
  profile_alloc_reset()
  profile_set_alloc_track(1)
  prof_alloc_site("small", 100)
  prof_alloc_site("large", 5000)
  prof_alloc_site("medium", 1500)
  prof_alloc_site("large", 5000)  # double-tap large to test count tracking
  puts("total_bytes=#{profile_alloc_total_bytes()}")
  puts("total_calls=#{profile_alloc_total_calls()}")
  profile_set_alloc_track(0)
end

def main(): Int
  describe("Profile prof_alloc_site (B.1 Phase 1)") do ->
    it("is a no-op when track flag is off") do ->
      assert_output("track=0\ntotal_bytes=0\ntotal_calls=0\n", t1_run)
    end

    it("accumulates bytes + calls per label when on") do ->
      assert_output("total_bytes=3584\ntotal_calls=3\n", t2_run)
    end

    it("profile_alloc_reset clears accumulator, leaves gate flag") do ->
      assert_output("before_reset_bytes=300\nafter_reset_bytes=0\nafter_reset_track=1\n", t3_run)
    end

    it("user with-block overrides default accumulator") do ->
      assert_output("rv=42\ncalls=1\ndefault_bytes=0\n", t4_run)
    end

    it("post-with calls fall back to default accumulator") do ->
      assert_output("mock_calls=1\ndefault_bytes=20\n", t5_run)
    end

    it("capture handler factory dispatches alloc_site") do ->
      assert_output("alloc-site ir_buffer bytes=1024\nalloc-site mir_instr bytes=256\n", t6_run)
    end

    it("silent handler drops alloc_site and returns 0") do ->
      assert_output("silent_rv=0\n", t7_run)
    end

    it("ndjson handler returns 0 for alloc_site") do ->
      assert_output("ndjson_rv=0\n", t8_run)
    end

    it("accumulator handles multi-call same-label correctly") do ->
      assert_output("total_bytes=11600\ntotal_calls=4\n", t9_run)
    end
  end
  return qspec_main()
end
