## Map Hashable Key Validation
##
## Verifies that the compiler rejects non-hashable types as Map keys
## at compile time with clear error messages.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Map hashable key validation") do ->
    it("accepts Int keys") do ->
      assert_compile_succeeds(hashable_int_src())
    end

    it("accepts String keys") do ->
      assert_compile_succeeds(hashable_string_src())
    end

    it("accepts Bool keys") do ->
      assert_compile_succeeds(hashable_bool_src())
    end

    it("accepts Symbol keys via map literal") do ->
      assert_compile_succeeds(hashable_symbol_src())
    end

    it("rejects Float key in map_new<F64, Int>") do ->
      assert_compile_error(unhashable_float_src(), "not hashable")
    end

    it("rejects Float key in type annotation Map<F64, Int>") do ->
      assert_compile_error(unhashable_float_ann_src(), "not hashable")
    end

    it("rejects Vec key in map_new<Vec<Int>, Int>") do ->
      assert_compile_error(unhashable_vec_src(), "not hashable")
    end

    it("rejects Set key in map_new<Set<Int>, Int>") do ->
      assert_compile_error(unhashable_set_src(), "not hashable")
    end
  end

  describe("Map struct key support") do ->
    it("accepts struct with all-Int fields as key") do ->
      assert_compile_succeeds(hashable_struct_src())
    end

    it("accepts struct with String fields as key") do ->
      assert_compile_succeeds(hashable_struct_string_src())
    end

    it("rejects struct with Float field as key") do ->
      assert_compile_error(unhashable_struct_float_src(), "not hashable")
    end
  end

  return qspec_main()
end

# --- Accepted key types ---

def hashable_int_src(): String = """
  def main(): Int
    var m = map_new<Int, Int>()
    m.set(42, 100)
    return 0
  end
  """

def hashable_string_src(): String = """
  def main(): Int
    var m = map_new<String, Int>()
    map_set(m, "key", 100)
    return 0
  end
  """

def hashable_bool_src(): String = """
  def main(): Int
    var m = map_new<Bool, Int>()
    m.set(true, 1)
    return 0
  end
  """

def hashable_symbol_src(): String = """
  def main(): Int
    var m = {:ok => 1, :err => 0}
    return 0
  end
  """

# --- Rejected key types ---

def unhashable_float_src(): String = """
  def main(): Int
    var m = map_new<F64, Int>()
    return 0
  end
  """

def unhashable_float_ann_src(): String = """
  def main(): Int
    var m: Map<F64, Int> = map_new()
    return 0
  end
  """

def unhashable_vec_src(): String = """
  def main(): Int
    var m = map_new<Vec<Int>, Int>()
    return 0
  end
  """

def unhashable_set_src(): String = """
  def main(): Int
    var m = map_new<Set<Int>, Int>()
    return 0
  end
  """

# --- Struct key tests ---

def hashable_struct_src(): String = """
  struct Point
    x: Int
    y: Int
  end

  def main(): Int
    var m = map_new<Point, Int>()
    return 0
  end
  """

def hashable_struct_string_src(): String = """
  struct User
    name: String
    age: Int
  end

  def main(): Int
    var m = map_new<User, Int>()
    return 0
  end
  """

def unhashable_struct_float_src(): String = """
  struct Coord
    x: F64
    y: F64
  end

  def main(): Int
    var m = map_new<Coord, Int>()
    return 0
  end
  """
