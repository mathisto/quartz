## WASM Core Language Tests
##
## Tests for basic language features: exit codes, variables, functions,
## control flow, recursion, stdout, comparisons, structs, globals,
## pattern matching, for-in loops, unary ops.

import * from qspec
import * from qspec/subprocess

extern "C" def getpid(): CInt

var _wc_tid = 0

def _wc_run(source: String): Int
  _wc_tid += 1
  var pid = getpid()
  var src = "/tmp/_wc_#{pid}_#{_wc_tid}.qz"
  var wasm = "/tmp/_wc_#{pid}_#{_wc_tid}.wasm"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var compile_argv = vec_new<String>(); compile_argv.push(compiler); compile_argv.push("--backend"); compile_argv.push("wasm"); compile_argv.push("--no-cache"); compile_argv.push("-I"); compile_argv.push("."); compile_argv.push("-I"); compile_argv.push("std"); compile_argv.push(src); compile_argv.push("-o"); compile_argv.push(wasm)
  var compile_result = subprocess_exec_argv("nested-compile", compile_argv)
  file_delete(src)
  if compile_result.exit_code != 0
    file_delete(wasm)
    return -1
  end
  var run_argv = vec_new<String>(); run_argv.push("wasmtime"); run_argv.push(wasm)
  var run_result = subprocess_exec_argv("nested-run", run_argv)
  file_delete(wasm)
  return run_result.exit_code
end

def _wc_capture(source: String): String
  _wc_tid += 1
  var pid = getpid()
  var src = "/tmp/_wc_#{pid}_#{_wc_tid}.qz"
  var wasm = "/tmp/_wc_#{pid}_#{_wc_tid}.wasm"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var compile_argv = vec_new<String>(); compile_argv.push(compiler); compile_argv.push("--backend"); compile_argv.push("wasm"); compile_argv.push("--no-cache"); compile_argv.push("-I"); compile_argv.push("."); compile_argv.push("-I"); compile_argv.push("std"); compile_argv.push(src); compile_argv.push("-o"); compile_argv.push(wasm)
  var compile_result = subprocess_exec_argv("nested-compile", compile_argv)
  file_delete(src)
  if compile_result.exit_code != 0
    file_delete(wasm)
    return "COMPILE_FAILED"
  end
  var run_argv = vec_new<String>(); run_argv.push("wasmtime"); run_argv.push(wasm)
  var run_result = subprocess_exec_argv("nested-run", run_argv)
  file_delete(wasm)
  if run_result.exit_code != 0
    return "RUNTIME_FAILED"
  end
  return run_result.stdout_content
end

def main(): Int
  if qspec_feature_wasm() == false
    puts("[skip] wasm_core_spec: set QUARTZ_COMPILER to a --feature wasm build to run")
    return qspec_exclude_feature("wasm")
  end
  describe("WASM exit codes") do ->
    it("return 0") do ->
      var s = """
        def main(): Int
          return 0
        end
        """
      assert_eq(_wc_run(s), 0)
    end
    it("return 42") do ->
      var s = """
        def main(): Int
          return 42
        end
        """
      assert_eq(_wc_run(s), 42)
    end
    it("arithmetic") do ->
      var s = """
        def main(): Int
          return (10 + 5) * 2 - 3
        end
        """
      assert_eq(_wc_run(s), 27)
    end
  end

  describe("WASM variables") do ->
    it("local vars") do ->
      var s = """
        def main(): Int
          var x = 40
          var y = 2
          return x + y
        end
        """
      assert_eq(_wc_run(s), 42)
    end
    it("reassignment") do ->
      var s = """
        def main(): Int
          var x = 10
          x += 5
          return x
        end
        """
      assert_eq(_wc_run(s), 15)
    end
  end

  describe("WASM functions") do ->
    it("call with return") do ->
      var s = """
        def add(a: Int, b: Int): Int
          return a + b
        end
        def main(): Int
          return add(40, 2)
        end
        """
      assert_eq(_wc_run(s), 42)
    end
    it("nested calls") do ->
      var s = """
        def double(x: Int): Int
          return x * 2
        end
        def main(): Int
          return double(double(5)) + 2
        end
        """
      assert_eq(_wc_run(s), 22)
    end
  end

  describe("WASM control flow") do ->
    it("if true branch") do ->
      var s = """
        def main(): Int
          if 1 == 1
            return 10
          end
          return 20
        end
        """
      assert_eq(_wc_run(s), 10)
    end
    it("if false branch") do ->
      var s = """
        def main(): Int
          if 1 == 2
            return 10
          end
          return 20
        end
        """
      assert_eq(_wc_run(s), 20)
    end
    it("while loop sum") do ->
      var s = """
        def main(): Int
          var s = 0
          var i = 1
          while i <= 10
            s += i
            i += 1
          end
          return s
        end
        """
      assert_eq(_wc_run(s), 55)
    end
    it("param branching") do ->
      var s = """
        def check(n: Int): Int
          if n > 5
            return 1
          end
          return 0
        end
        def main(): Int
          return check(10)
        end
        """
      assert_eq(_wc_run(s), 1)
    end
  end

  describe("WASM recursion") do ->
    it("factorial") do ->
      var s = """
        def fact(n: Int): Int
          if n <= 1
            return 1
          end
          return n * fact(n - 1)
        end
        def main(): Int
          return fact(5)
        end
        """
      assert_eq(_wc_run(s), 120)
    end
    it("fibonacci") do ->
      var s = """
        def fib(n: Int): Int
          if n <= 1
            return n
          end
          return fib(n - 1) + fib(n - 2)
        end
        def main(): Int
          return fib(10)
        end
        """
      assert_eq(_wc_run(s), 55)
    end
  end

  describe("WASM stdout") do ->
    it("puts") do ->
      var s = """
        def main(): Int
          puts("hello")
          return 0
        end
        """
      assert_eq_str(_wc_capture(s), "hello\n")
    end
    it("multiple puts") do ->
      var s = """
        def main(): Int
          puts("a")
          puts("b")
          return 0
        end
        """
      assert_eq_str(_wc_capture(s), "a\nb\n")
    end
  end

  describe("WASM comparisons") do ->
    it("less than true") do ->
      var s = """
        def main(): Int
          if 3 < 5
            return 1
          end
          return 0
        end
        """
      assert_eq(_wc_run(s), 1)
    end
    it("greater than true") do ->
      var s = """
        def main(): Int
          if 10 > 5
            return 1
          end
          return 0
        end
        """
      assert_eq(_wc_run(s), 1)
    end
    it("not equal") do ->
      var s = """
        def main(): Int
          if 3 != 5
            return 1
          end
          return 0
        end
        """
      assert_eq(_wc_run(s), 1)
    end
    it("less equal") do ->
      var s = """
        def main(): Int
          if 5 <= 5
            return 1
          end
          return 0
        end
        """
      assert_eq(_wc_run(s), 1)
    end
  end

  describe("WASM structs") do ->
    it("field init and access") do ->
      var s = """
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          var p = Point { x: 10, y: 32 }
          return p.x + p.y
        end
        """
      assert_eq(_wc_run(s), 42)
    end
    it("nested struct access") do ->
      var s = """
        struct Pair
          a: Int
          b: Int
        end
        def sum_pair(p: Pair): Int
          return p.a + p.b
        end
        def main(): Int
          var p = Pair { a: 20, b: 22 }
          return sum_pair(p)
        end
        """
      assert_eq(_wc_run(s), 42)
    end
  end

  describe("WASM globals") do ->
    it("global counter") do ->
      var s = """
        var counter = 0
        def bump(): Int
          counter += 1
          return counter
        end
        def main(): Int
          bump()
          bump()
          bump()
          return counter
        end
        """
      assert_eq(_wc_run(s), 3)
    end
    it("global with init value") do ->
      var s = """
        var x = 10
        def main(): Int
          x += 5
          return x
        end
        """
      assert_eq(_wc_run(s), 15)
    end
    it("string global") do ->
      var s = """
        var msg = "hello world"
        def main(): Int
          puts(msg)
          return 0
        end
        """
      assert_eq_str(_wc_capture(s), "hello world\n")
    end
  end

  describe("WASM pattern matching") do ->
    it("match with wildcard") do ->
      var s = """
        def classify(n: Int): Int
          match n
            0 => return 0
            1 => return 10
            _ => return 99
          end
        end
        def main(): Int
          return classify(1)
        end
        """
      assert_eq(_wc_run(s), 10)
    end
  end

  describe("WASM for-in loops") do ->
    it("range sum") do ->
      var s = """
        def main(): Int
          var s = 0
          for i in 0..10
            s += i
          end
          return s
        end
        """
      assert_eq(_wc_run(s), 45)
    end
  end

  describe("WASM unary ops") do ->
    it("negation") do ->
      var s = """
        def main(): Int
          var x = 42
          var y = -x
          return -y
        end
        """
      assert_eq(_wc_run(s), 42)
    end
  end

  return qspec_main()
end
