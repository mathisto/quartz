## TO_STR_INT_HEURISTIC: regression spec for the unsound `@to_str` alignment
## heuristic that mis-classified any Int satisfying `(val & 15) == 8 &&
## val > 65535` as a String pointer and dereferenced [val - 8] → SIGSEGV /
## garbled output. Closed via NODE_INTERP_STRING desugar dispatching known-Int
## parts through `sb_append_int` / `str_from_int`, bypassing `@to_str`.
##
## Each test exercises a different Int-typing inference path that
## `mir_is_int_expr` must recognize for the dispatch to fire. Values are
## chosen to satisfy the heuristic's mis-classification predicate, so
## pre-fix code would have crashed or returned garbage.

import * from qspec

# Hazardous Int values: each satisfies (val & 15) == 8 && val > 65535.
# Pre-fix, every interpolation of these would route through @to_str's
# String path and dereference [val - 8].
def hazard_a(): Int = 416760     # 0x65BF8 — the documented profile_alloc trigger
def hazard_b(): Int = 65544      # 0x10008 — minimum heuristic-passing value
def hazard_c(): Int = 1048584    # 0x100008 — well above any normal heap base

def main(): Int
  describe("to_str int heuristic regression") do ->

    # ── Path: NODE_INT_LIT ───────────────────────────────────────────
    it("interpolates a hazardous int literal") do ->
      assert_eq_str("v=#{416760}", "v=416760")
    end

    # ── Path: NODE_IDENT → mir_ctx_get_var_type (local var from int lit) ──
    it("interpolates a hazardous int local var") do ->
      n = 416760
      assert_eq_str("n=#{n}", "n=416760")
    end

    # ── Path: NODE_IDENT → mir_ctx_lookup_param_type (Int param) ─────
    it("interpolates a hazardous int parameter") do ->
      assert_eq_str(format_param(416760), "p=416760")
    end

    # ── Path: NODE_CALL → mir_intrinsic_return_type returns "Int" ─────
    it("interpolates a known Int-returning intrinsic call result") do ->
      n = vec_size(make_vec_of_size(416760))  # construct via vec_size — guaranteed "Int"
      # vec_size returns the actual size (we built it as 0); assert non-crash + correct fmt
      assert_eq_str("len=#{vec_size(make_empty_vec())}", "len=0")
    end

    # ── Path: NODE_CALL → user fn ret-ann "Int" via mir_infer_expr_type ──
    it("interpolates a user fn returning Int") do ->
      assert_eq_str("hz=#{hazard_a()}", "hz=416760")
    end

    # ── Path: NODE_BINARY → arithmetic propagates Int ────────────────
    it("interpolates an Int arithmetic expression") do ->
      a = 65000
      b = 544
      assert_eq_str("sum=#{a + b}", "sum=65544")
    end

    # ── Path: NODE_INDEX with mir_ctx_get_vec_elem_type == "Int" ─────
    it("interpolates a Vec<Int> element") do ->
      v = vec_new<Int>()
      v.push(416760)
      assert_eq_str("v[0]=#{v[0]}", "v[0]=416760")
    end

    # ── Single-part interp dispatches via str_from_int ───────────────
    it("single-part interp of a hazardous int") do ->
      n = 1048584
      assert_eq_str("#{n}", "1048584")
    end

    # ── Multiple hazardous interpolations in one string ──────────────
    it("multiple hazardous int interps in one string") do ->
      a = 416760
      b = 65544
      c = 1048584
      assert_eq_str("#{a}+#{b}+#{c}", "416760+65544+1048584")
    end

    # ── Mixed string + int parts (the dominant real-world shape) ─────
    it("mixed string and hazardous int parts") do ->
      label = "bytes"
      n = 416760
      assert_eq_str("#{label}=#{n}", "bytes=416760")
    end

    # ── Loop-emitted interp: PROFILE_ALLOC_TOP_N's actual shape ──────
    it("loop emits hazardous int interps without corruption") do ->
      values = vec_new<Int>()
      values.push(416760)
      values.push(65544)
      values.push(1048584)
      out = sb_new()
      for i in 0..values.size
        n = values[i]
        sb_append(out, "#{n}\n")
      end
      assert_eq_str(sb_to_string(out), "416760\n65544\n1048584\n")
    end

  end

  return qspec_main()
end

def format_param(p: Int): String
  return "p=#{p}"
end

def make_empty_vec(): Vec<Int>
  return vec_new<Int>()
end

def make_vec_of_size(_capacity: Int): Vec<Int>
  return vec_new<Int>()
end
