## Intersection Types Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("intersection types") do ->
    it("record intersection merges two record types") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def get_sum(r: { x: Int } & { y: Int }): Int
          return r.x + r.y
        end
        def main(): Int
          p = Point { x: 20, y: 22 }
          return get_sum(p)
        end
        """, 42)
    end

    it("record intersection merges three record types") do ->
      assert_run_exits("""
        struct Vec3
          x: Int
          y: Int
          z: Int
        end
        def get_sum(r: { x: Int } & { y: Int } & { z: Int }): Int
          return r.x + r.y + r.z
        end
        def main(): Int
          p = Vec3 { x: 10, y: 12, z: 20 }
          return get_sum(p)
        end
        """, 42)
    end

    it("record intersection with overlapping compatible fields") do ->
      assert_run_exits("""
        struct ABC
          a: Int
          b: Int
          c: Int
        end
        def get_sum(r: { a: Int, b: Int } & { b: Int, c: Int }): Int
          return r.a + r.b + r.c
        end
        def main(): Int
          p = ABC { a: 10, b: 12, c: 20 }
          return get_sum(p)
        end
        """, 42)
    end

    it("record intersection with disjoint fields") do ->
      assert_run_exits("""
        struct Pair
          a: Int
          b: Int
        end
        def get_sum(r: { a: Int } & { b: Int }): Int
          return r.a + r.b
        end
        def main(): Int
          p = Pair { a: 20, b: 22 }
          return get_sum(p)
        end
        """, 42)
    end

    it("trait intersection type registers and compiles") do ->
      assert_run_exits("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        trait Scalable
          def scale(x: Int): Int
            return 0
          end
        end
        struct MyNum
          val: Int
        end
        extend MyNum with Addable
          def add_val(x: Int): Int
            return x + 1
          end
        end
        extend MyNum with Scalable
          def scale(x: Int): Int
            return x * 2
          end
        end
        def main(): Int
          n = MyNum { val: 42 }
          return n.val
        end
        """, 42)
    end

    it("Int & String produces impossible intersection warning") do ->
      assert_compile_error("""
        def foo(x: Int & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end

    it("Bool & String produces impossible intersection warning") do ->
      assert_compile_error("""
        def foo(x: Bool & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end

    it("Int & Int is idempotent - not impossible") do ->
      assert_run_exits("""
        def foo(x: Int): Int
          return x
        end
        def main(): Int
          return foo(42)
        end
        """, 42)
    end

    it("F64 & String produces impossible intersection warning") do ->
      assert_compile_error("""
        def foo(x: F64 & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end

    it("intersection type is interned - same & produces same type") do ->
      assert_run_exits("""
        def main(): Int
          return 42
        end
        """, 42)
    end

    it("record intersection with conflicting field types emits warning") do ->
      assert_compile_error("""
        def foo(r: { x: Int } & { x: String }): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0151")
    end

    it("mixed record + trait intersection registers without error") do ->
      assert_run_exits("""
        trait Printable
          def to_s(): Int
            return 0
          end
        end
        struct Named
          name: Int
        end
        extend Named with Printable
          def to_s(): Int
            return 1
          end
        end
        def main(): Int
          n = Named { name: 42 }
          return n.name
        end
        """, 42)
    end

    it("intersection with Never type produces Never") do ->
      assert_compile_error("""
        def foo(x: Int & String): Int
          return 0
        end
        def main(): Int = 0
        """, "QZ0150")
    end

    it("returns intersection of two record types") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def make(): { x: Int } & { y: Int }
          p = Point { x: 20, y: 22 }
          return p
        end
        def main(): Int
          r = make()
          return r.x + r.y
        end
        """, 42)
    end

    it("function with intersection return type compiles") do ->
      assert_run_exits("""
        struct Data
          a: Int
          b: Int
        end
        def get_data(): { a: Int } & { b: Int }
          return Data { a: 40, b: 2 }
        end
        def main(): Int
          d = get_data()
          return d.a + d.b
        end
        """, 42)
    end

    it("multi-trait bounds validated at call site") do ->
      assert_run_exits("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        trait Scalable
          def scale(x: Int): Int
            return 0
          end
        end
        def process<T: Addable + Scalable>(x: T): Int
          return 42
        end
        def main(): Int = 42
        """, 42)
    end

    it("negative constraint rejects type missing one trait in multi-bound") do ->
      assert_compile_error("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        trait Scalable
          def scale(x: Int): Int
            return 0
          end
        end
        struct Partial
          x: Int
        end
        extend Partial with Addable
          def add_val(x: Int): Int
            return x + 1
          end
        end
        def process<T: Addable + Scalable>(obj: T, x: Int): Int
          return 42
        end
        def main(): Int
          v = Partial { x: 1 }
          return process(v, 1)
        end
        """, "does not implement trait")
    end
  end
  return qspec_main()
end
