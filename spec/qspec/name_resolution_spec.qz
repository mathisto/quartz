## Name Resolution Tests - Verifies correct function lookup across modules
##
## Contract:
##   1. Disambiguation: same fn name in two modules resolved via qualified.
##   2. Shadowing: local fn shadows wildcard import.
##   3. Global access: global var accessed across modules.
##   4. Chain: nested module call chain (inner→outer→main).
##   5. Re-export: function reachable through intermediate module.
##   6. Arithmetic: cross-module function result used in arithmetic.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("name resolution across modules") do ->
    it("same fn name in two modules disambiguated") do ->
      var files: Vec = vec_new()
      files.push(as_int("mod_a.qz"))
      files.push(as_int("def get_val(): Int = 10"))
      files.push(as_int("mod_b.qz"))
      files.push(as_int("def get_val(): Int = 20"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import mod_a\nimport mod_b\ndef main(): Int\n  return mod_a::get_val() + mod_b::get_val()\nend"))
      assert_multi_run_exits(files, 2, 30)
    end

    it("local fn shadows wildcard import") do ->
      var files: Vec = vec_new()
      files.push(as_int("helper.qz"))
      files.push(as_int("def get_val(): Int = 10"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import * from helper\ndef get_val(): Int = 42\ndef main(): Int\n  return get_val()\nend"))
      assert_multi_run_exits(files, 1, 42)
    end
    it("global var access across modules") do ->
      var files: Vec = vec_new()
      files.push(as_int("state.qz"))
      files.push(as_int("var SHARED_COUNT = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import state\ndef main(): Int\n  return state::SHARED_COUNT\nend"))
      assert_multi_run_exits(files, 1, 42)
    end

    it("nested module call chain") do ->
      var files: Vec = vec_new()
      files.push(as_int("inner.qz"))
      files.push(as_int("def inner_val(): Int = 7"))
      files.push(as_int("outer.qz"))
      vec_push(files, as_int("import inner\ndef outer_val(): Int\n  return inner::inner_val() * 3\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import outer\ndef main(): Int\n  return outer::outer_val()\nend"))
      assert_multi_run_exits(files, 2, 21)
    end

    it("re-exported function reachable through intermediate") do ->
      var files: Vec = vec_new()
      files.push(as_int("util.qz"))
      files.push(as_int("def util_add(a: Int, b: Int): Int = a + b"))
      files.push(as_int("facade.qz"))
      vec_push(files, as_int("import util\ndef facade_add(a: Int, b: Int): Int\n  return util::util_add(a, b)\nend"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import facade\ndef main(): Int\n  return facade::facade_add(20, 22)\nend"))
      assert_multi_run_exits(files, 2, 42)
    end

    it("cross-module function result used in local arithmetic") do ->
      var files: Vec = vec_new()
      files.push(as_int("nums.qz"))
      files.push(as_int("def get_ten(): Int = 10"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import nums\ndef main(): Int\n  x = nums::get_ten()\n  return x * x\nend"))
      assert_multi_run_exits(files, 1, 100)
    end
  end

  return qspec_main()
end
