## STRESS: Concurrency Edge Cases
##
## Adversarial tests probing concurrency dark corners:
## many spawns, channel pressure, atomics under contention,
## spawn-in-spawn, task return value propagation,
## mutex contention patterns, and buffered channel edge cases.
##
## Contract:
##   1. Concurrency: spawn/await basics.
##   2. Concurrency: channels.
##   3. Concurrency: atomics.
##   4. Concurrency: mutex.
##   5. Concurrency: many tasks.
##   6. Concurrency: spawn with closures.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Basic Spawn/Await
  # ===========================================================================
  describe("concurrency: spawn/await basics") do ->
    it("spawn returns correct value") do ->
      assert_run_exits("""
        def worker(): Int = 42
        def main(): Int
          h = go worker()
          result = await h
          if result == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("multiple spawns return independently") do ->
      assert_run_exits("""
        def work(n: Int): Int = n * 2
        def main(): Int
          h1 = go work(10)
          h2 = go work(20)
          h3 = go work(30)
          a = await h1
          b = await h2
          c = await h3
          if a == 20
            if b == 40
              if c == 60
                return 0
              end
            end
          end
          return 1
        end
        """, 0)
    end

    it("spawn with zero return") do ->
      assert_run_exits("""
        def noop(): Int = 0
        def main(): Int
          h = go noop()
          return await h
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category B: Channel Basics
  # ===========================================================================
  describe("concurrency: channels") do ->
    it("send then recv single value") do ->
      assert_run_exits("""
        def sender(ch: Int): Int
          send(ch, 42)
          return 0
        end
        def main(): Int
          ch = channel_new(1)
          h = go sender(ch)
          val = recv(ch)
          await h
          if val == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("multiple sends, multiple recvs") do ->
      assert_run_exits("""
        def producer(ch: Int): Int
          send(ch, 10)
          send(ch, 20)
          send(ch, 30)
          return 0
        end
        def main(): Int
          ch = channel_new(3)
          h = go producer(ch)
          a = recv(ch)
          b = recv(ch)
          c = recv(ch)
          await h
          if a + b + c == 60
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("channel close signaling") do ->
      assert_run_exits("""
        def sender(ch: Int): Int
          send(ch, 1)
          channel_close(ch)
          return 0
        end
        def main(): Int
          ch = channel_new(1)
          h = go sender(ch)
          val = recv(ch)
          await h
          if channel_closed(ch)
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category C: Atomic Operations
  # ===========================================================================
  describe("concurrency: atomics") do ->
    it("atomic_add from multiple threads") do ->
      assert_run_exits("""
        def adder(atom: Int): Int
          var i = 0
          while i < 100
            atomic_add(atom, 1)
            i = i + 1
          end
          return 0
        end
        def main(): Int
          atom = atomic_new(0)
          h1 = go adder(atom)
          h2 = go adder(atom)
          await h1
          await h2
          val = atomic_load(atom)
          if val == 200
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("atomic_sub works correctly") do ->
      assert_run_exits("""
        def main(): Int
          atom = atomic_new(100)
          atomic_sub(atom, 58)
          val = atomic_load(atom)
          if val == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("atomic_store overwrites value") do ->
      assert_run_exits("""
        def main(): Int
          atom = atomic_new(0)
          atomic_store(atom, 42)
          if atomic_load(atom) == 42
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category D: Mutex Patterns
  # ===========================================================================
  describe("concurrency: mutex") do ->
    it("mutex lock/unlock preserves value") do ->
      assert_run_exits("""
        def main(): Int
          mx = mutex_new(42)
          val = mutex_lock(mx)
          mutex_unlock(mx, val)
          final = mutex_lock(mx)
          mutex_unlock(mx, final)
          if final == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("mutex increment from multiple threads") do ->
      assert_run_exits("""
        def inc(mx: Int): Int
          var i = 0
          while i < 50
            val = mutex_lock(mx)
            mutex_unlock(mx, val + 1)
            i = i + 1
          end
          return 0
        end
        def main(): Int
          mx = mutex_new(0)
          h1 = go inc(mx)
          h2 = go inc(mx)
          await h1
          await h2
          final = mutex_lock(mx)
          mutex_unlock(mx, final)
          if final == 100
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category E: Spawn Many Tasks
  # ===========================================================================
  describe("concurrency: many tasks") do ->
    it("spawn 10 tasks and collect results") do ->
      assert_run_exits("""
        def work(n: Int): Int = n * n
        def main(): Int
          var handles = vec_new()
          var i = 0
          while i < 10
            h = go work(i)
            handles.push(h)
            i = i + 1
          end
          var sum = 0
          i = 0
          while i < 10
            sum = sum + await handles[i]
            i = i + 1
          end
          if sum == 285
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("pass data through channel pipeline") do ->
      assert_run_exits("""
        def stage(in_ch: Int, out_ch: Int, add: Int): Int
          val = recv(in_ch)
          send(out_ch, val + add)
          return 0
        end
        def main(): Int
          ch1 = channel_new(1)
          ch2 = channel_new(1)
          ch3 = channel_new(1)
          h1 = go stage(ch1, ch2, 10)
          h2 = go stage(ch2, ch3, 20)
          send(ch1, 12)
          result = recv(ch3)
          await h1
          await h2
          if result == 42
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category F: Spawn with Closures
  # ===========================================================================
  describe("concurrency: spawn with closures") do ->
    it("spawned function captures argument") do ->
      assert_run_exits("""
        def make_worker(base: Int): Int = base + 2
        def main(): Int
          h = go make_worker(40)
          if await h == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("spawn function that does computation") do ->
      assert_run_exits("""
        def fib(n: Int): Int
          if n < 2
            return n
          end
          return fib(n - 1) + fib(n - 2)
        end
        def main(): Int
          h = go fib(10)
          if await h == 55
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  return qspec_main()
end
