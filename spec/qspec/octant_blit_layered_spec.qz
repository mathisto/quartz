## QSpec coverage for octant_pattern_at + octant_blit_layered (B.2).
##
## Coverage:
##   - octant_pattern_at: direct pattern extraction at known coords
##   - octant_blit_layered single-blitter: equivalent to octant_blit_to_plane
##   - octant_blit_layered two-blitter: layout from one, color from picker
##     using both blitters' patterns
##   - octant_blit_layered empty Vec: no-op
##   - octant_blit_layered OOB layout_blitter_idx: no-op
##
## See docs/design/POST_V06_ROADMAP.md §B.2.

import * from qspec
import std/tui/octant as oc
import std/tui/plane as pl
import std/tui/cell as cl

# =============================================================================
# Helpers
# =============================================================================

## Build a 2x4 (= 1 cell) blitter with the 8 bits of `pat` set.
def _blitter_with_pattern(pat: Int): oc::OctantBlitter
  var b = oc::octant_blitter_new(2, 4)
  if (pat & 1) != 0
    b = oc::octant_set(b, 0, 0, true)
  end
  if (pat & 2) != 0
    b = oc::octant_set(b, 1, 0, true)
  end
  if (pat & 4) != 0
    b = oc::octant_set(b, 0, 1, true)
  end
  if (pat & 8) != 0
    b = oc::octant_set(b, 1, 1, true)
  end
  if (pat & 16) != 0
    b = oc::octant_set(b, 0, 2, true)
  end
  if (pat & 32) != 0
    b = oc::octant_set(b, 1, 2, true)
  end
  if (pat & 64) != 0
    b = oc::octant_set(b, 0, 3, true)
  end
  if (pat & 128) != 0
    b = oc::octant_set(b, 1, 3, true)
  end
  return b
end

# Truecolor RGB ints (≥ 0x1000000 to set the truecolor sentinel bit).
def _red(): Int = 0x1FF0000
def _green(): Int = 0x100FF00
def _blue(): Int = 0x10000FF
def _grey(): Int = 0x1808080

## Picker that ignores blitter patterns and always returns red.
def _fixed_red(cx: Int, cy: Int, pats: Vec<Int>): Int
  return _red()
end

## Picker that returns red iff blitter[1] (the FOV blitter) has any
## pixel set at this cell, grey otherwise. Models the brogue-tribute
## minimap idiom.
def _layered_picker(cx: Int, cy: Int, pats: Vec<Int>): Int
  if pats[1] != 0
    return _red()
  end
  return _grey()
end

# =============================================================================
# Spec body
# =============================================================================

def main(): Int
  describe("octant_pattern_at — public pattern extraction") do ->
    it("single top-left pixel produces pattern 0x01") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_set(b, 0, 0, true)
      assert_eq(oc::octant_pattern_at(b2, 0, 0), 0x01)
    end

    it("single bottom-right pixel produces pattern 0x80") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_set(b, 1, 3, true)
      assert_eq(oc::octant_pattern_at(b2, 0, 0), 0x80)
    end

    it("all pixels on produces pattern 0xFF") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_fill(b, true)
      assert_eq(oc::octant_pattern_at(b2, 0, 0), 0xFF)
    end

    it("empty blitter pattern is 0") do ->
      var b = oc::octant_blitter_new(2, 4)
      assert_eq(oc::octant_pattern_at(b, 0, 0), 0)
    end

    it("multi-cell blitter — pattern at (1,0) reads pixels (2..3, 0..3)") do ->
      var b = oc::octant_blitter_new(4, 4)
      # Set pixel (2, 0) — that's the top-left of cell (1, 0), so bit 0.
      var b2 = oc::octant_set(b, 2, 0, true)
      assert_eq(oc::octant_pattern_at(b2, 1, 0), 0x01)
      # Cell (0, 0) should be empty.
      assert_eq(oc::octant_pattern_at(b2, 0, 0), 0x00)
    end

    it("OOB cell coords: pattern 0 (octant_get clamps each pixel)") do ->
      var b = oc::octant_blitter_new(2, 4)
      var b2 = oc::octant_fill(b, true)
      assert_eq(oc::octant_pattern_at(b2, 5, 5), 0)
      assert_eq(oc::octant_pattern_at(b2, -1, 0), 0)
    end
  end

  describe("octant_blit_layered — single-blitter equivalence") do ->
    it("single blitter + fixed picker == octant_blit_to_plane glyph") do ->
      var b = _blitter_with_pattern(0xFF)
      # Reference: octant_blit_to_plane with explicit channels.
      var ref_plane = pl::plane_create(1, 1)
      var fg = cl::channel_rgb(_red())
      var bg = cl::channel_rgb(_blue())
      var ref_out = oc::octant_blit_to_plane(
        b, ref_plane, 0, 0,
        oc::OctantQuality::Quadrant, fg, bg
      )
      var ref_cell = pl::plane_getc(ref_out, 0, 0)

      # Layered: one-blitter Vec, fixed-red picker.
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b)
      var lay_plane = pl::plane_create(1, 1)
      var lay_out = oc::octant_blit_layered(
        blitters, 0, _fixed_red, bg, lay_plane, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var lay_cell = pl::plane_getc(lay_out, 0, 0)

      # Glyph identical (full block).
      assert_eq_str(lay_cell.egc, ref_cell.egc)
      assert_eq_str(lay_cell.egc, "█")
      # Fg color identical (red truecolor).
      assert_eq(lay_cell.fg.color, _red())
      assert_eq(lay_cell.fg.color, ref_cell.fg.color)
      # Bg identical.
      assert_eq(lay_cell.bg.color, _blue())
      # attrs cleared.
      assert_eq(lay_cell.attrs, 0)
    end

    it("dst_x / dst_y offsets respected") do ->
      var b = _blitter_with_pattern(0xFF)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b)
      var p = pl::plane_create(3, 3)
      var bg = cl::channel_rgb(_blue())
      var out = oc::octant_blit_layered(
        blitters, 0, _fixed_red, bg, p, 1, 2,
        oc::OctantQuality::Quadrant
      )
      var c_target = pl::plane_getc(out, 1, 2)
      assert_eq_str(c_target.egc, "█")
      # The (0, 0) cell should still be the plane's blank.
      var c_origin = pl::plane_getc(out, 0, 0)
      if str_eq(c_origin.egc, "█")
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end
  end

  describe("octant_blit_layered — two-blitter color picking") do ->
    it("layout from b1, color from picker over (b1, b2)") do ->
      # b1 (layout): full block — pattern 0xFF everywhere → glyph "█".
      var b1 = _blitter_with_pattern(0xFF)
      # b2 (color signal): empty — pattern 0x00 → picker returns grey.
      var b2 = _blitter_with_pattern(0x00)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b1)
      blitters.push(b2)
      var p = pl::plane_create(1, 1)
      var bg = cl::channel_rgb(_blue())
      var out = oc::octant_blit_layered(
        blitters, 0, _layered_picker, bg, p, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var c = pl::plane_getc(out, 0, 0)
      # Glyph from b1 (layout).
      assert_eq_str(c.egc, "█")
      # Color from picker — b2 was empty so grey path taken.
      assert_eq(c.fg.color, _grey())
    end

    it("b2 set → picker returns red") do ->
      var b1 = _blitter_with_pattern(0xFF)
      var b2 = _blitter_with_pattern(0xFF)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b1)
      blitters.push(b2)
      var p = pl::plane_create(1, 1)
      var bg = cl::channel_rgb(_blue())
      var out = oc::octant_blit_layered(
        blitters, 0, _layered_picker, bg, p, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var c = pl::plane_getc(out, 0, 0)
      assert_eq_str(c.egc, "█")
      assert_eq(c.fg.color, _red())
    end

    it("layout from b2 (idx=1), color picker reads both") do ->
      # b1 is empty (pattern 0x00); b2 is full (pattern 0xFF).
      # If layout_blitter_idx = 1, glyph driven by b2 = "█".
      var b1 = _blitter_with_pattern(0x00)
      var b2 = _blitter_with_pattern(0xFF)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b1)
      blitters.push(b2)
      var p = pl::plane_create(1, 1)
      var bg = cl::channel_rgb(_blue())
      var out = oc::octant_blit_layered(
        blitters, 1, _layered_picker, bg, p, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var c = pl::plane_getc(out, 0, 0)
      # Glyph from b2 (full block).
      assert_eq_str(c.egc, "█")
      # Picker reads pats[1] (= b2 = 0xFF), nonzero → red.
      assert_eq(c.fg.color, _red())
    end
  end

  describe("octant_blit_layered — degenerate cases") do ->
    it("empty blitters Vec: no-op, plane returned unchanged") do ->
      var blitters = vec_new<oc::OctantBlitter>()
      var p = pl::plane_create(2, 2)
      var blank = cl::Cell {
        egc:   "X",
        fg:    cl::channel_default(),
        bg:    cl::channel_default(),
        attrs: 0
      }
      var pre = pl::plane_fill(p, blank)
      var bg = cl::channel_rgb(_blue())
      var post = oc::octant_blit_layered(
        blitters, 0, _fixed_red, bg, pre, 0, 0,
        oc::OctantQuality::Quadrant
      )
      # Every cell should still be the original "X" — nothing was written.
      var c00 = pl::plane_getc(post, 0, 0)
      var c11 = pl::plane_getc(post, 1, 1)
      assert_eq_str(c00.egc, "X")
      assert_eq_str(c11.egc, "X")
    end

    it("layout_blitter_idx out of range: no-op") do ->
      var b = _blitter_with_pattern(0xFF)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b)
      var p = pl::plane_create(1, 1)
      var blank = cl::Cell {
        egc:   "Z",
        fg:    cl::channel_default(),
        bg:    cl::channel_default(),
        attrs: 0
      }
      var pre = pl::plane_fill(p, blank)
      var bg = cl::channel_rgb(_blue())
      # idx = 5 is out of range (only one blitter).
      var post = oc::octant_blit_layered(
        blitters, 5, _fixed_red, bg, pre, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var c = pl::plane_getc(post, 0, 0)
      assert_eq_str(c.egc, "Z")
    end

    it("negative layout_blitter_idx: no-op") do ->
      var b = _blitter_with_pattern(0xFF)
      var blitters = vec_new<oc::OctantBlitter>()
      blitters.push(b)
      var p = pl::plane_create(1, 1)
      var blank = cl::Cell {
        egc:   "Z",
        fg:    cl::channel_default(),
        bg:    cl::channel_default(),
        attrs: 0
      }
      var pre = pl::plane_fill(p, blank)
      var bg = cl::channel_rgb(_blue())
      var post = oc::octant_blit_layered(
        blitters, -1, _fixed_red, bg, pre, 0, 0,
        oc::OctantQuality::Quadrant
      )
      var c = pl::plane_getc(post, 0, 0)
      assert_eq_str(c.egc, "Z")
    end
  end

  return qspec_main()
end
