## QSpec coverage for Phase B.3 — `with Alloc.deny_all() do ... end`.
##
## Locks in the call-form sugar that installs `deny_alloc_handler` +
## `deny_dealloc_handler` for the lexical extent of the body. Every
## allocation inside the block (including stdlib-internal Vec/String/Map
## allocations under post-A.7 universal coverage) throws via Throws
## with the canonical "allocation denied (sandbox)" message.
##
## The deny handler is stateless — no env needed — so B.3 reuses A.5's
## existing `deny_alloc_handler` / `deny_dealloc_handler` via the
## method-dispatch registry without an `_e` suffix variant.
##
## NOTE on triple-quoted snippet strings: `"""..."""` interpolates
## `#{...}` at SPEC compile time, not subprocess runtime. Snippets below
## avoid runtime interpolation in their assertion-relevant outputs.

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# B3.1 — basic: alloc inside the with-block throws + process exits 66.
# -----------------------------------------------------------------------------

var _BASIC_DENY: String = """import std/alloc

def main(): Int
  with Alloc.deny_all() do ->
    var p = alloc(8)
    puts(\"should_not_print\")
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B3.2 — outer Throws frame catches the deny — body resumes after recovery.
# -----------------------------------------------------------------------------

var _USER_THROWS_RECOVERS: String = """import std/alloc

def my_throws(op_name: Int, argc: Int, argv: Int): Int
  puts(\"caught\")
  return 0
end

def main(): Int
  with Throws { throw: my_throws } do ->
    with Alloc.deny_all() do ->
      var p = alloc(16)
      puts(\"should_not_print_inside\")
    end
  end
  puts(\"after\")
  return 0
end
"""

# -----------------------------------------------------------------------------
# B3.3 — sequential isolation: two distinct deny scopes each catch
# their own throw via independent outer Throws frames. Avoids
# allocating BETWEEN the catches because the filed "stack-top
# mis-restore on cross-scope longjmp" bug (see ALLOC_EFFECT_PLAN.md
# Phase B followups) leaves inner Alloc entries dangling on the
# effect stack; until that lands, post-catch allocations may re-trip
# deny.
# -----------------------------------------------------------------------------

var _SEQUENTIAL_INDEPENDENT: String = """import std/alloc

var g_seen_a = 0
var g_seen_b = 0

def my_throws_a(op_name: Int, argc: Int, argv: Int): Int
  g_seen_a = 1
  return 0
end

def my_throws_b(op_name: Int, argc: Int, argv: Int): Int
  g_seen_b = 1
  return 0
end

def main(): Int
  with Throws { throw: my_throws_a } do ->
    with Alloc.deny_all() do ->
      var p = alloc(8)
    end
  end
  with Throws { throw: my_throws_b } do ->
    with Alloc.deny_all() do ->
      var q = alloc(16)
    end
  end
  if g_seen_a == 1 and g_seen_b == 1
    puts(\"both_caught\")
  else
    puts(\"a=\" + str_from_int(g_seen_a) + \" b=\" + str_from_int(g_seen_b))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B3.4 — pre-deny allocations stay valid across the inner deny refusal.
# A `var p = alloc(16)` in the outer in_arena scope is reachable BEFORE
# the inner deny throws; recovering via outer Throws and reading p back
# proves arena memory survived the cross-scope longjmp. Like B3.3, this
# avoids allocating between the catch and the verification puts.
# -----------------------------------------------------------------------------

var _PRE_DENY_VALUE_PRESERVED: String = """import std/alloc
import std/memory

var g_value = 0
var g_caught = 0

def my_throws(op_name: Int, argc: Int, argv: Int): Int
  g_caught = 1
  return 0
end

def main(): Int
  var ar = arena_new(4096)
  var p = arena_alloc(ar, 8)
  store(p, 0, 1234)
  with Throws { throw: my_throws } do ->
    with Alloc.in_arena(ar) do ->
      var q = alloc(16)
      store(q, 0, 99)
      with Alloc.deny_all() do ->
        var r = alloc(8)
        puts(\"unreachable\")
      end
    end
  end
  g_value = load(p, 0)
  if g_caught == 1
    puts(\"caught_value=\" + str_from_int(g_value))
  else
    puts(\"miss\")
  end
  arena_destroy(ar)
  return 0
end
"""

# -----------------------------------------------------------------------------
# B3.5 — Vec push inside deny_all → throws (post-A.7 universal coverage).
# -----------------------------------------------------------------------------

var _DENY_VEC_PUSH: String = """import std/alloc

def main(): Int
  with Alloc.deny_all() do ->
    var v = vec_new<Int>()
    v.push(1)
    puts(\"should_not_print\")
  end
  return 0
end
"""

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("Phase B.3 — Alloc.deny_all() sugar") do ->

    it("basic — alloc inside deny_all throws + exits 66 with denial msg") do ->
      assert_run_panics(_BASIC_DENY, "allocation denied")
    end

    it("user `with Throws` catches the deny — control recovers") do ->
      assert_run_stdout_eq(_USER_THROWS_RECOVERS, "caught\nafter\n")
    end

    it("sequential — two distinct deny scopes each catch independently") do ->
      assert_run_stdout_eq(_SEQUENTIAL_INDEPENDENT, "both_caught\n")
    end

    it("pre-deny arena allocation survives the inner deny refusal") do ->
      assert_run_stdout_eq(_PRE_DENY_VALUE_PRESERVED,
        "caught_value=1234\n")
    end

    it("Vec push inside deny_all → universal coverage routes to denial") do ->
      assert_run_panics(_DENY_VEC_PUSH, "allocation denied")
    end

  end
  return qspec_main()
end
