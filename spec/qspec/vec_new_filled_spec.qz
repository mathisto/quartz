## Vec New Filled — Scalar Broadcast Tests
##
## Contract:
##   vec_new_filled<T>(n, v) produces N copies of the actual fill value v for
##   every scalar element width. Regression guard for the bug where multi-byte
##   scalars (ew >= 2: Int/I32/I16/F64/F32) were memset to 0 instead of being
##   broadcast with the runtime fill value.
##
## 1-byte fills (U8/I8/Bool) broadcast via byte-memset; multi-byte fills
## broadcast via a counted store loop. The fill value is a runtime SSA value, so
## 0 cannot be special-cased — the 0-fill case must also be exercised (the
## compiler's own escape-analysis arrays rely on vec_new_filled<Int>(n, 0)).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("vec_new_filled multi-byte scalar broadcast") do ->
    it("broadcasts a nonzero Int fill (ew 8)") do ->
      var v = vec_new_filled<Int>(3, 7)
      assert_eq(v[0], 7)
      assert_eq(v[1], 7)
      assert_eq(v[2], 7)
      assert_eq(v.size, 3)
    end

    it("broadcasts a nonzero I32 fill, including negatives (ew 4)") do ->
      var v = vec_new_filled<I32>(4, -5)
      assert_eq(v[0], -5)
      assert_eq(v[1], -5)
      assert_eq(v[2], -5)
      assert_eq(v[3], -5)
    end

    it("broadcasts a nonzero I16 fill (ew 2)") do ->
      var v = vec_new_filled<I16>(3, 1234)
      assert_eq(v[0], 1234)
      assert_eq(v[1], 1234)
      assert_eq(v[2], 1234)
    end

    it("broadcasts a 1-byte U8 fill (memset path)") do ->
      var v = vec_new_filled<U8>(3, 200)
      assert_eq(v[0], 200)
      assert_eq(v[1], 200)
      assert_eq(v[2], 200)
    end

    it("still produces zeros for an explicit 0 fill (escape-analysis case)") do ->
      var v = vec_new_filled<Int>(3, 0)
      assert_eq(v[0], 0)
      assert_eq(v[1], 0)
      assert_eq(v[2], 0)
    end
  end

  # Subprocess probes compile --no-cache, so they are immune to cache-ro masking
  # of a golden-vs-fixed regression. These assert the actual stdout broadcast.
  # NOTE: the embedded snippet must NOT use "#{}" — it would interpolate at SPEC
  # compile time. Each element is printed on its own line via str_from_int.
  describe("vec_new_filled broadcast (subprocess, --no-cache)") do ->
    it("Int 7 7 7") do ->
      assert_run_stdout_eq("""
        def main(): Int
          a = vec_new_filled<Int>(3, 7)
          puts(str_from_int(a[0]))
          puts(str_from_int(a[1]))
          puts(str_from_int(a[2]))
          return 0
        end
        """, "7\n7\n7\n")
    end

    it("U8 200 200 200") do ->
      assert_run_stdout_eq("""
        def main(): Int
          b = vec_new_filled<U8>(3, 200)
          puts(str_from_int(b[0]))
          puts(str_from_int(b[1]))
          puts(str_from_int(b[2]))
          return 0
        end
        """, "200\n200\n200\n")
    end

    it("I32 -5 -5 -5 -5") do ->
      assert_run_stdout_eq("""
        def main(): Int
          c = vec_new_filled<I32>(4, -5)
          puts(str_from_int(c[0]))
          puts(str_from_int(c[1]))
          puts(str_from_int(c[2]))
          puts(str_from_int(c[3]))
          return 0
        end
        """, "-5\n-5\n-5\n-5\n")
    end
  end

  return qspec_main()
end
