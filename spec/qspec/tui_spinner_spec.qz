## std/tui/widgets/spinner behaviour tests.
##
## Coverage:
##   - alternative frame cycles: dots (6), line (4)
##   - octant frame cycles: rotor (8), pulse (4), scan (4)
##   - spinner_new defaults: octant rotor frames, index 0, supplied label
##   - spinner_with_frames replaces frames + resets index
##   - spinner_with_styles replaces styles
##   - spinner_with_label replaces label
##   - spinner_tick advances index
##   - spinner_tick wraps from last → 0
##   - spinner_tick on empty frame cycle is a no-op
##   - spinner_view with label: `{frame} {label}`
##   - spinner_view without label: just `{frame}`
##   - spinner_view with empty frames + label: just label
##   - spinner_view with empty frames + empty label: ""
##   - spinner_view at advanced index renders the right frame
##   - spinner_view out-of-range index falls back to 0
##   - spinner_styles_default returns sane defaults
##
## View assertions compare against plain text. To make them robust
## whether the spec runs piped (no-TTY → depth 0) or interactively
## (TTY → depth > 0), `main()` sets NO_COLOR=1 before any test body
## runs. `Style.render` then returns text unchanged regardless of
## how the binary was invoked.

import * from qspec
import std/tui/widgets/spinner as sp
import style

# ============================================================
# Frame cycles
# ============================================================

def test_dots_has_6_frames(): Void
  assert_eq(sp::spinner_dots().size, 6)
end

def test_line_has_4_frames(): Void
  assert_eq(sp::spinner_line().size, 4)
end

# ============================================================
# Octant frame cycles
# ============================================================

def test_octant_rotor_has_8_frames(): Void
  assert_eq(sp::spinner_octant_rotor().size, 8)
end

def test_octant_pulse_has_4_frames(): Void
  assert_eq(sp::spinner_octant_pulse().size, 4)
end

def test_octant_scan_has_4_frames(): Void
  assert_eq(sp::spinner_octant_scan().size, 4)
end

def test_octant_pulse_frame_0_is_empty(): Void
  ## Pattern 0x00 → space (U+0020) per octant.qz codepoint table.
  var frames = sp::spinner_octant_pulse()
  assert_eq_str(frames[0], " ")
end

def test_octant_pulse_frame_2_is_full_block(): Void
  ## Pattern 0xFF → full block U+2588.
  var frames = sp::spinner_octant_pulse()
  assert_eq_str(frames[2], "█")
end

def test_octant_pulse_is_ping_pong(): Void
  ## Frame 1 == Frame 3 (both are mid-rows pattern 0x3C).
  var frames = sp::spinner_octant_pulse()
  assert_eq_str(frames[1], frames[3])
end

def test_octant_rotor_frames_distinct(): Void
  ## Each rotor frame is a single different sub-pixel — every frame
  ## differs from its neighbours. Test a few representative pairs.
  var frames = sp::spinner_octant_rotor()
  ## Frames 0 and 1 differ (TL vs TR sub-pixels).
  if str_eq(frames[0], frames[1])
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
  ## Frames 0 and 4 differ (TL vs BR — opposite corners).
  if str_eq(frames[0], frames[4])
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_octant_rotor_no_empty_frame(): Void
  ## None of the 8 rotor frames is a space — each has at least one
  ## sub-pixel on. Empty = pattern 0x00 = U+0020 single byte = " ".
  var frames = sp::spinner_octant_rotor()
  var i = 0
  while i < frames.size
    if str_eq(frames[i], " ")
      assert_eq(0, 1)
    end
    i = i + 1
  end
  assert_eq(1, 1)
end

def test_octant_scan_frames_distinct(): Void
  ## Four sequential row-sweep patterns, all distinct.
  var frames = sp::spinner_octant_scan()
  if str_eq(frames[0], frames[1])
    assert_eq(0, 1)
  end
  if str_eq(frames[1], frames[2])
    assert_eq(0, 1)
  end
  if str_eq(frames[2], frames[3])
    assert_eq(0, 1)
  end
  assert_eq(1, 1)
end

def test_view_with_octant_rotor(): Void
  ## spinner_view should pass octant frames through unchanged. Pick a
  ## concrete frame (frame 0 of rotor = pattern 0x01 = TL sub-pixel)
  ## and assert spinner_view returns frame 0 of the cycle.
  var s = sp::spinner_with_frames(sp::spinner_new(""), sp::spinner_octant_rotor())
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[0])
end

def test_octant_rotor_tick_advances(): Void
  ## After tick, view should render frame 1.
  var s = sp::spinner_with_frames(sp::spinner_new(""), sp::spinner_octant_rotor())
  s = sp::spinner_tick(s)
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[1])
end

def test_octant_rotor_wraps_at_8(): Void
  ## After 8 ticks of an 8-frame cycle, index returns to 0.
  var s = sp::spinner_with_frames(sp::spinner_new(""), sp::spinner_octant_rotor())
  var i = 0
  while i < 8
    s = sp::spinner_tick(s)
    i = i + 1
  end
  assert_eq(s.index, 0)
end

# ============================================================
# Constructors + builders
# ============================================================

def test_spinner_new_defaults(): Void
  var s = sp::spinner_new("Loading")
  ## Default is the 8-frame octant rotor.
  assert_eq(s.frames.size, 8)
  assert_eq(s.index, 0)
  assert_eq_str(s.label, "Loading")
end

def test_spinner_with_frames_replaces_frames_and_resets_index(): Void
  var s = sp::spinner_new("ok")
  s = sp::spinner_tick(s)
  s = sp::spinner_tick(s)
  ## Now index = 2. Replace frames; index must reset to 0.
  s = sp::spinner_with_frames(s, sp::spinner_line())
  assert_eq(s.frames.size, 4)
  assert_eq(s.index, 0)
end

def test_spinner_with_label_replaces_label(): Void
  var s = sp::spinner_with_label(sp::spinner_new("a"), "b")
  assert_eq_str(s.label, "b")
end

def test_spinner_with_styles_replaces_styles(): Void
  var custom = sp::SpinnerStyles {
    frame: Style.new().fg(style::Cyan()),
    label: Style.new()
  }
  var s = sp::spinner_with_styles(sp::spinner_new(""), custom)
  ## The styles slot is opaque — assert it didn't blow up + view
  ## still renders frame 0 of the default rotor.
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[0])
end

# ============================================================
# Frame advance
# ============================================================

def test_spinner_tick_advances_index(): Void
  var s = sp::spinner_tick(sp::spinner_new(""))
  assert_eq(s.index, 1)
end

def test_spinner_tick_wraps_to_zero(): Void
  var s = sp::spinner_new("")
  var i = 0
  while i < 8
    s = sp::spinner_tick(s)
    i = i + 1
  end
  ## After 8 ticks of an 8-frame cycle, index returns to 0.
  assert_eq(s.index, 0)
end

def test_spinner_tick_empty_frames_is_noop(): Void
  var s = sp::spinner_new("hi")
  s = sp::spinner_with_frames(s, vec_new<String>())
  s = sp::spinner_tick(s)
  assert_eq(s.index, 0)
  assert_eq(s.frames.size, 0)
end

# ============================================================
# View
# ============================================================

def test_view_with_label(): Void
  var s = sp::spinner_new("Loading")
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[0] + " Loading")
end

def test_view_without_label(): Void
  var s = sp::spinner_new("")
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[0])
end

def test_view_at_advanced_index_renders_correct_frame(): Void
  var s = sp::spinner_new("")
  s = sp::spinner_tick(s)
  s = sp::spinner_tick(s)
  ## index=2 → 3rd frame of the default rotor cycle.
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[2])
end

def test_view_out_of_range_index_falls_back_to_zero(): Void
  ## Construct a Spinner with index out of range manually.
  var s = sp::Spinner {
    frames: sp::spinner_octant_rotor(),
    index:  999,
    label:  "",
    styles: sp::spinner_styles_default()
  }
  var frames = sp::spinner_octant_rotor()
  assert_eq_str(sp::spinner_view(s), frames[0])
end

def test_view_empty_frames_returns_label(): Void
  var s = sp::spinner_with_frames(sp::spinner_new("just label"), vec_new<String>())
  assert_eq_str(sp::spinner_view(s), "just label")
end

def test_view_empty_frames_and_empty_label_returns_empty(): Void
  var s = sp::spinner_with_frames(sp::spinner_new(""), vec_new<String>())
  assert_eq_str(sp::spinner_view(s), "")
end

def test_view_with_line_frames(): Void
  var s = sp::spinner_with_frames(sp::spinner_new(""), sp::spinner_line())
  assert_eq_str(sp::spinner_view(s), "|")
  s = sp::spinner_tick(s)
  assert_eq_str(sp::spinner_view(s), "/")
end

def test_styles_default_label_is_muted(): Void
  var d = sp::spinner_styles_default()
  ## Muted style fg is BrightBlack — exposed via _fg field.
  assert_eq(d.label._fg, style::BrightBlack())
end

def main(): Int
  ## Force Style.render to plain text regardless of TTY detection so
  ## the byte-exact view assertions below work under any invocation.
  var _se = setenv("NO_COLOR", "1")

  describe("frame cycles") do ->
    it("dots has 6 frames") do ->
      test_dots_has_6_frames()
    end
    it("line has 4 frames") do ->
      test_line_has_4_frames()
    end
  end

  describe("octant frame cycles") do ->
    it("rotor has 8 frames") do ->
      test_octant_rotor_has_8_frames()
    end
    it("pulse has 4 frames") do ->
      test_octant_pulse_has_4_frames()
    end
    it("scan has 4 frames") do ->
      test_octant_scan_has_4_frames()
    end
    it("pulse frame 0 is empty (space)") do ->
      test_octant_pulse_frame_0_is_empty()
    end
    it("pulse frame 2 is full block (█)") do ->
      test_octant_pulse_frame_2_is_full_block()
    end
    it("pulse is symmetric (frame 1 == frame 3)") do ->
      test_octant_pulse_is_ping_pong()
    end
    it("rotor frames are distinct") do ->
      test_octant_rotor_frames_distinct()
    end
    it("rotor has no empty frame") do ->
      test_octant_rotor_no_empty_frame()
    end
    it("scan frames are distinct") do ->
      test_octant_scan_frames_distinct()
    end
    it("spinner_view renders octant rotor frame 0") do ->
      test_view_with_octant_rotor()
    end
    it("spinner_tick advances through octant rotor frames") do ->
      test_octant_rotor_tick_advances()
    end
    it("rotor wraps at 8 ticks") do ->
      test_octant_rotor_wraps_at_8()
    end
  end

  describe("constructors and builders") do ->
    it("spinner_new defaults to octant rotor + index 0 + supplied label") do ->
      test_spinner_new_defaults()
    end
    it("spinner_with_frames replaces frames and resets index") do ->
      test_spinner_with_frames_replaces_frames_and_resets_index()
    end
    it("spinner_with_label replaces the label") do ->
      test_spinner_with_label_replaces_label()
    end
    it("spinner_with_styles replaces the styles") do ->
      test_spinner_with_styles_replaces_styles()
    end
  end

  describe("frame advance") do ->
    it("spinner_tick advances index") do ->
      test_spinner_tick_advances_index()
    end
    it("spinner_tick wraps from last frame to 0") do ->
      test_spinner_tick_wraps_to_zero()
    end
    it("spinner_tick on empty frames is a no-op") do ->
      test_spinner_tick_empty_frames_is_noop()
    end
  end

  describe("view") do ->
    it("renders {frame} {label} with a label") do ->
      test_view_with_label()
    end
    it("renders just {frame} with no label") do ->
      test_view_without_label()
    end
    it("renders the correct frame at an advanced index") do ->
      test_view_at_advanced_index_renders_correct_frame()
    end
    it("falls back to frame 0 for out-of-range index") do ->
      test_view_out_of_range_index_falls_back_to_zero()
    end
    it("with empty frames + label returns just the label") do ->
      test_view_empty_frames_returns_label()
    end
    it("with empty frames + empty label returns \"\"") do ->
      test_view_empty_frames_and_empty_label_returns_empty()
    end
    it("renders ASCII line frames") do ->
      test_view_with_line_frames()
    end
  end

  describe("styles") do ->
    it("default label uses BrightBlack (muted)") do ->
      test_styles_default_label_is_muted()
    end
  end

  return qspec_main()
end
