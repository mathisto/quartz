## QSpec coverage for std/tui/blend.qz + Phase 6.2 plane.qz extensions.
##
## Coverage:
##   - BlendMode enum identity (10 variants — None, Alpha(pct), Add,
##     Multiply, Screen, Lighten, Darken, Overlay, Burn, Dodge)
##   - Per-channel blend math via blend_colors:
##       * None → top wins
##       * Alpha(0)   → bottom; Alpha(100) → top; Alpha(50) → average
##       * Add        → channel-wise sum, clamped at 255
##       * Multiply   → channel-wise (top * bottom) / 255
##       * Screen     → 255 - ((255-top) * (255-bottom)) / 255
##       * Lighten    → max per channel
##       * Darken     → min per channel
##       * Overlay    → multiply if dark / screen if light per channel
##       * Burn       → contrast-darken
##       * Dodge      → contrast-brighten
##   - Non-truecolor input fallback (top wins) for ANSI16 / 256 / -1
##   - plane_merge_down_with — None equivalent to plane_merge_down
##   - plane_blit — sub-rect copy at offset, clipping at src/dst bounds,
##     identity (BlendMode::None blit one cell == single putc)
##
## See docs/design/TUI_V06_CELL_ENGINE.md D3 for the design rationale.

import * from qspec
import std/tui/blend as bl
import std/tui/cell as cl
import std/tui/plane as pl
import style

# Helper: build a cell with a specific fg color and Opaque alpha.
def _cell_fg(rgb: Int): cl::Cell
  return cl::cell_with_fg(cl::cell_char("X"), cl::channel_rgb(rgb))
end

def main(): Int
  describe("bl::BlendMode — variant identity") do ->
    it("None / Add / Multiply / Screen are distinguishable") do ->
      var n = bl::BlendMode::None
      var a = bl::BlendMode::Add
      var m = bl::BlendMode::Multiply
      var s = bl::BlendMode::Screen
      if n is None
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if a is Add
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if m is Multiply
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if s is Screen
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Lighten / Darken / Overlay / Burn / Dodge distinguishable") do ->
      var l = bl::BlendMode::Lighten
      var d = bl::BlendMode::Darken
      var o = bl::BlendMode::Overlay
      var b = bl::BlendMode::Burn
      var dd = bl::BlendMode::Dodge
      if l is Lighten
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if d is Darken
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if o is Overlay
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if b is Burn
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if dd is Dodge
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Alpha carries an Int payload") do ->
      var a = bl::BlendMode::Alpha(50)
      if a is Alpha
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("bl::blend_colors — None") do ->
    it("returns top regardless of bottom") do ->
      var top = rgb_color(255, 0, 0)
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::None), top)
    end
  end

  describe("bl::blend_colors — Alpha(pct)") do ->
    it("Alpha(0) returns bottom") do ->
      var top = rgb_color(255, 0, 0)
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Alpha(0)), bot)
    end

    it("Alpha(100) returns top") do ->
      var top = rgb_color(255, 0, 0)
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Alpha(100)), top)
    end

    it("Alpha(50) averages channels") do ->
      var top = rgb_color(200, 100, 0)
      var bot = rgb_color(0, 100, 200)
      var out = bl::blend_colors(top, bot, bl::BlendMode::Alpha(50))
      # (200*50 + 0*50)/100 = 100; (100+100)/2 = 100; (0+200)/2 = 100
      assert_eq(out, rgb_color(100, 100, 100))
    end

    it("Alpha(-50) clamps to 0 (= bottom)") do ->
      var top = rgb_color(255, 0, 0)
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Alpha(-50)), bot)
    end

    it("Alpha(150) clamps to 100 (= top)") do ->
      var top = rgb_color(255, 0, 0)
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Alpha(150)), top)
    end
  end

  describe("bl::blend_colors — Add (lighting primitive)") do ->
    it("adds channels and clamps at 255") do ->
      var top = rgb_color(100, 0, 50)
      var bot = rgb_color(50, 100, 250)
      var out = bl::blend_colors(top, bot, bl::BlendMode::Add)
      # 100+50 = 150; 0+100 = 100; 50+250 = 300 → clamped to 255
      assert_eq(out, rgb_color(150, 100, 255))
    end

    it("Add(black, white) = white") do ->
      var top = rgb_color(0, 0, 0)
      var bot = rgb_color(255, 255, 255)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Add), rgb_color(255, 255, 255))
    end

    it("Add(black, black) = black") do ->
      var black = rgb_color(0, 0, 0)
      assert_eq(bl::blend_colors(black, black, bl::BlendMode::Add), black)
    end
  end

  describe("bl::blend_colors — Multiply (dimming primitive)") do ->
    it("Multiply(white, c) = c (white preserves)") do ->
      var white = rgb_color(255, 255, 255)
      var c = rgb_color(100, 50, 200)
      assert_eq(bl::blend_colors(white, c, bl::BlendMode::Multiply), c)
    end

    it("Multiply(black, c) = black (black absorbs)") do ->
      var black = rgb_color(0, 0, 0)
      var c = rgb_color(100, 50, 200)
      assert_eq(bl::blend_colors(black, c, bl::BlendMode::Multiply), black)
    end

    it("Multiply(50%, 100%) ≈ 50%") do ->
      # 128 * 255 / 255 = 128
      var half = rgb_color(128, 128, 128)
      var full = rgb_color(255, 255, 255)
      assert_eq(bl::blend_colors(half, full, bl::BlendMode::Multiply), half)
    end
  end

  describe("bl::blend_colors — Screen (brightening overlay)") do ->
    it("Screen(black, c) = c (black preserves)") do ->
      var black = rgb_color(0, 0, 0)
      var c = rgb_color(100, 50, 200)
      assert_eq(bl::blend_colors(black, c, bl::BlendMode::Screen), c)
    end

    it("Screen(white, c) = white (white saturates)") do ->
      var white = rgb_color(255, 255, 255)
      var c = rgb_color(100, 50, 200)
      assert_eq(bl::blend_colors(white, c, bl::BlendMode::Screen), white)
    end
  end

  describe("bl::blend_colors — Lighten / Darken") do ->
    it("Lighten picks max per channel") do ->
      var a = rgb_color(200, 50, 100)
      var b = rgb_color(100, 200, 50)
      assert_eq(bl::blend_colors(a, b, bl::BlendMode::Lighten),
                rgb_color(200, 200, 100))
    end

    it("Darken picks min per channel") do ->
      var a = rgb_color(200, 50, 100)
      var b = rgb_color(100, 200, 50)
      assert_eq(bl::blend_colors(a, b, bl::BlendMode::Darken),
                rgb_color(100, 50, 50))
    end
  end

  describe("bl::blend_colors — Overlay / Burn / Dodge") do ->
    it("Overlay returns within [0, 255] and produces valid channels") do ->
      var top = rgb_color(128, 64, 200)
      var bot = rgb_color(64, 200, 128)
      var out = bl::blend_colors(top, bot, bl::BlendMode::Overlay)
      # Just sanity check the result is truecolor packed
      if out >= 0x1000000
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("Burn(top=0, bot=anything) → black per channel") do ->
      var top = rgb_color(0, 0, 0)
      var bot = rgb_color(100, 200, 50)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Burn),
                rgb_color(0, 0, 0))
    end

    it("Dodge(top=255, bot=anything) → white per channel") do ->
      var top = rgb_color(255, 255, 255)
      var bot = rgb_color(100, 200, 50)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Dodge),
                rgb_color(255, 255, 255))
    end
  end

  describe("bl::blend_colors — non-truecolor fallback") do ->
    it("ANSI 16 top → top wins (no blending)") do ->
      var top = Red()                  # 1 — not truecolor
      var bot = rgb_color(0, 255, 0)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Add), top)
    end

    it("256-palette bottom → top wins") do ->
      var top = rgb_color(0, 255, 0)
      var bot = ansi256_color(214)
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Multiply), top)
    end

    it("-1 sentinel either side → top wins") do ->
      var top = rgb_color(0, 255, 0)
      var bot = -1
      assert_eq(bl::blend_colors(top, bot, bl::BlendMode::Screen), top)
    end
  end

  describe("pl::plane_merge_down_with") do ->
    it("None mode is equivalent to plane_merge_down (last-writer-wins)") do ->
      var bottom = pl::plane_fill(pl::plane_create(2, 2),
                                  _cell_fg(rgb_color(0, 0, 255)))
      var top = pl::plane_fill(pl::plane_create(2, 2),
                               _cell_fg(rgb_color(255, 0, 0)))
      var with_none = pl::plane_merge_down_with(top, bottom, bl::BlendMode::None)
      var orig = pl::plane_merge_down(top, bottom)
      var c1 = pl::plane_getc(with_none, 0, 0)
      var c2 = pl::plane_getc(orig, 0, 0)
      assert_eq(c1.fg.color, c2.fg.color)
    end

    it("Add mode produces additive composition") do ->
      var bottom = pl::plane_fill(pl::plane_create(1, 1),
                                  _cell_fg(rgb_color(50, 50, 50)))
      var top = pl::plane_fill(pl::plane_create(1, 1),
                               _cell_fg(rgb_color(100, 100, 100)))
      var merged = pl::plane_merge_down_with(top, bottom, bl::BlendMode::Add)
      var c = pl::plane_getc(merged, 0, 0)
      assert_eq(c.fg.color, rgb_color(150, 150, 150))
    end

    it("Multiply mode dims") do ->
      var bottom = pl::plane_fill(pl::plane_create(1, 1),
                                  _cell_fg(rgb_color(255, 255, 255)))
      var top = pl::plane_fill(pl::plane_create(1, 1),
                               _cell_fg(rgb_color(128, 128, 128)))
      var merged = pl::plane_merge_down_with(top, bottom, bl::BlendMode::Multiply)
      var c = pl::plane_getc(merged, 0, 0)
      assert_eq(c.fg.color, rgb_color(128, 128, 128))
    end

    it("transparent top cell preserves bottom regardless of blend mode") do ->
      var bottom = pl::plane_fill(pl::plane_create(1, 1),
                                  _cell_fg(rgb_color(50, 50, 50)))
      var transparent = pl::plane_fill(pl::plane_create(1, 1), cl::cell_blank())
      var merged = pl::plane_merge_down_with(transparent, bottom, bl::BlendMode::Add)
      var c = pl::plane_getc(merged, 0, 0)
      assert_eq(c.fg.color, rgb_color(50, 50, 50))
    end
  end

  describe("pl::plane_blit") do ->
    it("copies a 1×1 src cell onto dst at offset") do ->
      var dst = pl::plane_fill(pl::plane_create(3, 3),
                               _cell_fg(rgb_color(0, 0, 255)))
      var src = pl::plane_fill(pl::plane_create(1, 1),
                               _cell_fg(rgb_color(255, 0, 0)))
      var out = pl::plane_blit(src, dst, 0, 0, 1, 1, 1, 1, bl::BlendMode::None)
      var c = pl::plane_getc(out, 1, 1)
      assert_eq(c.fg.color, rgb_color(255, 0, 0))
      # Other cells unchanged
      var c2 = pl::plane_getc(out, 0, 0)
      assert_eq(c2.fg.color, rgb_color(0, 0, 255))
    end

    it("blit with sub-rect copies only the requested region") do ->
      # 3×3 src, take only the (1,1)-(2,2) bottom-right 2×2 quadrant.
      var src_blue = pl::plane_fill(pl::plane_create(3, 3),
                                    _cell_fg(rgb_color(0, 0, 255)))
      var src = pl::plane_putc(src_blue, 1, 1,
                               _cell_fg(rgb_color(255, 0, 0)))
      var dst = pl::plane_create(2, 2)
      var out = pl::plane_blit(src, dst, 1, 1, 1, 1, 0, 0, bl::BlendMode::None)
      var c = pl::plane_getc(out, 0, 0)
      assert_eq(c.fg.color, rgb_color(255, 0, 0))
    end

    it("blit clipping past dst right edge is silent") do ->
      var dst = pl::plane_fill(pl::plane_create(2, 1),
                               _cell_fg(rgb_color(0, 0, 255)))
      var src = pl::plane_fill(pl::plane_create(3, 1),
                               _cell_fg(rgb_color(255, 0, 0)))
      # Blit src's whole 3 cells starting at dst (1, 0). Cell at dst (1, 0)
      # gets src (0,0). Cells at dst (2, 0) and (3, 0) are out of dst bounds.
      var out = pl::plane_blit(src, dst, 0, 0, 3, 1, 1, 0, bl::BlendMode::None)
      var c0 = pl::plane_getc(out, 0, 0)
      var c1 = pl::plane_getc(out, 1, 0)
      assert_eq(c0.fg.color, rgb_color(0, 0, 255))   # dst (0,0) unchanged
      assert_eq(c1.fg.color, rgb_color(255, 0, 0))   # dst (1,0) overwritten
      assert_eq(out.w, 2)
    end

    it("blit with Add blends src+dst additively") do ->
      var dst = pl::plane_fill(pl::plane_create(1, 1),
                               _cell_fg(rgb_color(50, 50, 50)))
      var src = pl::plane_fill(pl::plane_create(1, 1),
                               _cell_fg(rgb_color(100, 100, 100)))
      var out = pl::plane_blit(src, dst, 0, 0, 1, 1, 0, 0, bl::BlendMode::Add)
      var c = pl::plane_getc(out, 0, 0)
      assert_eq(c.fg.color, rgb_color(150, 150, 150))
    end

    it("blit returns dst unchanged when sw=0 / sh=0") do ->
      var dst = pl::plane_fill(pl::plane_create(2, 2),
                               _cell_fg(rgb_color(0, 0, 255)))
      var src = pl::plane_fill(pl::plane_create(2, 2),
                               _cell_fg(rgb_color(255, 0, 0)))
      var out = pl::plane_blit(src, dst, 0, 0, 0, 0, 0, 0, bl::BlendMode::None)
      var c = pl::plane_getc(out, 0, 0)
      assert_eq(c.fg.color, rgb_color(0, 0, 255))
    end
  end

  return qspec_main()
end
