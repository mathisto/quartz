## Turbofish disambiguation tests
##
## Contract: at the postfix `<` position, the parser must decide between a
## turbofish typed-call (`f<Type>(...)`) and a comparison operator (`a < b`).
##
##   1. NEGATIVE — these forms MUST stay comparisons (never commit to turbofish).
##   2. POSITIVE — these turbofish forms MUST compile and run, including
##      nested 2-arg inner generics (`Map<String,Int>`, `Result<A,B>`) which
##      previously hung / parse-errored on the inner comma.
##
## Regression target: VEC_NEW_NESTED_GENERIC_RESULT_ARG_HANGS — the hand-rolled
## turbofish type-arg scanner could not consume a nested 2-arg inner generic
## (the inner comma was left unconsumed), wedging or erroring the compiler.
## Fix: delegate type-arg consumption to ps_parse_type, with an alias-drop
## pre-check preserving `alias::Type` -> bare-Type semantics.

import * from qspec

def vid(x: Int): Int = x

def main(): Int
  describe("turbofish disambiguation — negatives stay comparisons") do ->
    it("a < b is a comparison") do ->
      a = 1
      b = 2
      assert_eq(a < b, 1)
    end

    it("1 < 2 > 0 left-assoc chain") do ->
      # (1 < 2) > 0  ==  1 > 0  ==  1
      assert_eq(1 < 2 > 0, 1)
    end

    it("x < y and p > q") do ->
      x = 1
      y = 2
      p = 5
      q = 3
      var both = 0
      if x < y and p > q
        both = 1
      end
      assert_eq(both, 1)
    end

    it("vid(2) < vid(9) — calls around <") do ->
      assert_eq(vid(2) < vid(9), 1)
    end

    it("arr[i] < arr[j] — index around <") do ->
      arr = [3, 7]
      assert_eq(arr[0] < arr[1], 1)
    end

    it("a < 2 + 5") do ->
      a = 1
      assert_eq(a < 2 + 5, 1)
    end

    it("a < (b + c) parenthesized RHS") do ->
      a = 1
      b = 2
      c = 3
      assert_eq(a < (b + c), 1)
    end

    it("a < b * 2") do ->
      a = 1
      b = 2
      assert_eq(a < b * 2, 1)
    end

    it("a < -b negative RHS") do ->
      a = 1
      b = 0 - 5
      # b is -5, so a < -5 is false
      assert_eq(a < b, 0)
    end
  end

  describe("turbofish disambiguation — positives compile and run") do ->
    it("vec_new<Int>() single type arg") do ->
      var v = vec_new<Int>()
      v.push(7)
      assert_eq(v[0], 7)
    end

    it("vec_new<Vec<Int>>() nested single-arg generic") do ->
      var v = vec_new<Vec<Int>>()
      var inner = vec_new<Int>()
      inner.push(3)
      v.push(inner)
      assert_eq(v[0][0], 3)
    end

    it("vec_new<Map<String,Int>>() nested 2-arg generic") do ->
      var v = vec_new<Map<String,Int>>()
      var m: Map<String, Int> = map_new()
      map_set(m, "k", 9)
      v.push(m)
      var got = 0
      match map_get(v[0], "k")
        Some(x) => got = x
        _ => got = 0
      end
      assert_eq(got, 9)
    end
  end

  return qspec_main()
end
