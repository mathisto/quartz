## Vec Sort Tests
##
## Contract:
##   1. Custom comparator with identity.
##   2. Preserves size after sort.
##   3. Sorts already sorted vec.
##   4. Sorts and verifies full.
##   5. Sorts empty vec without.
##   6. Sorts integers ascending.
import * from qspec

def main(): Int
  describe("vec_sort") do ->
    it("sorts integers ascending") do ->
      var v = [3, 1, 4, 1, 5, 9, 2, 6]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[1], 1)
      assert_eq(v[2], 2)
    end

    it("sorts and verifies full order") do ->
      var v = [5, 3, 1, 4, 2]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[1], 2)
      assert_eq(v[2], 3)
      assert_eq(v[3], 4)
      assert_eq(v[4], 5)
    end

    it("sorts single element") do ->
      var v = [42]
      vec_sort(v)
      assert_eq(v[0], 42)
    end

    it("sorts empty vec without crashing") do ->
      var v = vec_new()
      vec_sort(v)
      assert_eq(v.size, 0)
    end

    it("sorts already sorted vec") do ->
      var v = [1, 2, 3, 4, 5]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[4], 5)
    end

    it("sorts reverse sorted vec") do ->
      var v = [5, 4, 3, 2, 1]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[4], 5)
    end

    it("sorts vec with all duplicates") do ->
      var v = [7, 7, 7, 7]
      vec_sort(v)
      assert_eq(v[0], 7)
      assert_eq(v[3], 7)
    end

    it("sorts two elements (swap case)") do ->
      var v = [9, 1]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[1], 9)
    end

    it("sorts two elements (no swap)") do ->
      var v = [1, 9]
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[1], 9)
    end

    it("sorts with negative values") do ->
      var v = [3, -1, -5, 2, -3]
      vec_sort(v)
      assert_eq(v[0], -5)
      assert_eq(v[1], -3)
      assert_eq(v[2], -1)
      assert_eq(v[3], 2)
      assert_eq(v[4], 3)
    end

    it("sorts large vec") do ->
      var v = vec_new()
      var i = 100
      while i > 0
        v.push(i)
        i = i - 1
      end
      vec_sort(v)
      assert_eq(v[0], 1)
      assert_eq(v[99], 100)
    end

    it("preserves size after sort") do ->
      var v = [3, 1, 4, 1, 5]
      vec_sort(v)
      assert_eq(v.size, 5)
    end

    it("sorts with custom comparator descending") do ->
      var v = [1, 5, 3, 2, 4]
      vec_sort_by(v, vs_desc)
      assert_eq(v[0], 5)
      assert_eq(v[4], 1)
    end

    it("custom comparator with identity") do ->
      var v = [3, 1, 2]
      vec_sort_by(v, vs_asc)
      assert_eq(v[0], 1)
      assert_eq(v[2], 3)
    end

    it("UFCS style v.vec_sort()") do ->
      var v = [3, 1, 2]
      v.vec_sort()
      assert_eq(v[0], 1)
      assert_eq(v[2], 3)
    end

    it("sorts vec with zeros") do ->
      var v = [0, 3, 0, 1, 0]
      vec_sort(v)
      assert_eq(v[0], 0)
      assert_eq(v[1], 0)
      assert_eq(v[2], 0)
      assert_eq(v[3], 1)
      assert_eq(v[4], 3)
    end
  end

  describe("Vec verb-pair UFCS — sorted/reversed copy variants") do ->
    it("v.sorted() returns a new sorted vec without mutating original") do ->
      var v = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
      var s = v.sorted()
      # New vec is sorted
      assert_eq(s[0], 1)
      assert_eq(s[s.size - 1], 9)
      # Original is unchanged
      assert_eq(v[0], 3)
      assert_eq(v[1], 1)
      assert_eq(v[2], 4)
    end

    it("v.reversed() returns a new reversed vec without mutating original") do ->
      var v = [1, 2, 3, 4, 5]
      var r = v.reversed()
      # New vec is reversed
      assert_eq(r[0], 5)
      assert_eq(r[1], 4)
      assert_eq(r[4], 1)
      # Original is unchanged
      assert_eq(v[0], 1)
      assert_eq(v[4], 5)
    end

    it("v.sorted() preserves size") do ->
      var v = [3, 1, 4, 1, 5]
      assert_eq(v.sorted().size, 5)
    end

    it("v.reversed() preserves size") do ->
      var v = [3, 1, 4, 1, 5]
      assert_eq(v.reversed().size, 5)
    end

    it("v.sorted().reversed() chains for descending sort") do ->
      var v = [3, 1, 4, 1, 5]
      var d = v.sorted().reversed()
      assert_eq(d[0], 5)
      assert_eq(d[d.size - 1], 1)
      # Original still untouched
      assert_eq(v[0], 3)
    end
  end

  return qspec_main()
end

def vs_desc(a: Int, b: Int): Int = b - a
def vs_asc(a: Int, b: Int): Int = a - b
