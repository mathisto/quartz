## Buffered Io Tests
##
## Contract:
##   1. Close_file returns 0 on.
##   2. File_read_line returns empty at.
##   3. File_write_line writes text to.
##   4. Open_file returns 0 for.
##   5. Open_file returns non-zero handle.
##   6. Round-trip write then read.
import * from qspec

def main(): Int
  describe("buffered I/O") do ->
    it("open_file returns non-zero handle for write") do ->
      assert_eq(bio_open_write(), 1)
    end
    it("file_write_line writes text to a file") do ->
      assert_eq(bio_write_read(), 1)
    end
    it("round-trip write then read back") do ->
      assert_eq(bio_round_trip(), 3)
    end
    it("file_read_line returns empty at EOF") do ->
      assert_eq(bio_eof(), 0)
    end
    it("close_file returns 0 on success") do ->
      assert_eq(bio_close_ret(), 0)
    end
    it("open_file returns 0 for nonexistent read") do ->
      assert_eq(bio_noexist(), 1)
    end
  end
  return qspec_main()
end

def bio_open_write(): Int
  var h = open_file("/tmp/qz_qspec_bio1.txt", "w")
  if h != 0
    close_file(h)
    return 1
  end
  return 0
end

def bio_write_read(): Int
  var h = open_file("/tmp/qz_qspec_bio2.txt", "w")
  file_write_line(h, "hello\n")
  close_file(h)
  var r = open_file("/tmp/qz_qspec_bio2.txt", "r")
  var line = file_read_line(r)
  close_file(r)
  if line == "hello"
    return 1
  end
  return 0
end

def bio_round_trip(): Int
  var h = open_file("/tmp/qz_qspec_bio3.txt", "w")
  file_write_line(h, "alpha\n")
  file_write_line(h, "beta\n")
  file_write_line(h, "gamma\n")
  close_file(h)
  var r = open_file("/tmp/qz_qspec_bio3.txt", "r")
  var l1 = file_read_line(r)
  var l2 = file_read_line(r)
  var l3 = file_read_line(r)
  close_file(r)
  if l1 == "alpha"
    if l2 == "beta"
      if l3 == "gamma"
        return 3
      end
    end
  end
  return 0
end

def bio_eof(): Int
  var h = open_file("/tmp/qz_qspec_bio4.txt", "w")
  file_write_line(h, "only\n")
  close_file(h)
  var r = open_file("/tmp/qz_qspec_bio4.txt", "r")
  var l1 = file_read_line(r)
  var l2 = file_read_line(r)
  close_file(r)
  return l2.size
end

def bio_close_ret(): Int
  var h = open_file("/tmp/qz_qspec_bio5.txt", "w")
  var ret = close_file(h)
  return ret
end

def bio_noexist(): Int
  var h = open_file("/tmp/qz_nonexistent_file_xyz.txt", "r")
  if h == 0
    return 1
  end
  close_file(h)
  return 0
end
