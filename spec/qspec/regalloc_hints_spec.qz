## Regalloc Hints Tests
##
## Contract:
##   1. Compiles many-variable function correctly.
##   2. Register pressure does not corrupt results.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Register Allocation Hints") do ->
    it("compiles many-variable function correctly") do ->
      assert_compile_succeeds("""
        def many_vars(a: Int, b: Int, c: Int, d: Int): Int
          var x = a + b
          var y = c + d
          var z = x * y
          return z
        end

        def main(): Int
          many_vars(1, 2, 3, 4)
        end
      """)
    end

    it("register pressure does not corrupt results") do ->
      assert_run_exits("""
        def pressure(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int): Int
          var v1 = a + b
          var v2 = c + d
          var v3 = e + f
          var v4 = v1 * v2
          var v5 = v3 + v4
          return v5
        end

        def main(): Int
          pressure(1, 2, 3, 4, 5, 6)
        end
      """, 32)
    end
  end

  return qspec_main()
end
