## Void Match Arm Tests
##
## Contract:
##   1. Do...end block with expression.
##   2. Integer pattern matching.
##   3. Match with enum patterns.
##   4. Match with function call.
##   5. Nested match expressions.
##   6. Single expression returning int.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("void match arms") do ->
    it("single expression returning Int works") do ->
      c = 1
      v = match c
        1 => 42
        _ => 0
      end
      assert_eq(v, 42)
    end
    it("match with function call returning Int") do ->
      c = 1
      v = match c
        1 => vma_compute()
        _ => 0
      end
      assert_eq(v, 42)
    end
    it("integer pattern matching") do ->
      assert_eq(vma_handle(0), 10)
      assert_eq(vma_handle(1), 20)
      assert_eq(vma_handle(2), 30)
    end
    it("wildcard pattern catches remaining") do ->
      assert_eq(vma_handle(99), 99)
    end
    it("do...end block with expression as last statement") do ->
      assert_run_exits("""
        def main(): Int
          c = 1
          v = match c
            1 => do
              x = 20
              y = 22
              x + y
            end
            _ => 0
          end
          return v
        end
        """, 42)
    end
    it("match with enum patterns") do ->
      assert_eq(vma_option_val(Option::Some(42)), 42)
      assert_eq(vma_option_val(Option::None), 0)
    end
    it("nested match expressions") do ->
      assert_eq(vma_nested(1, Option::Some(21)), 42)
      assert_eq(vma_nested(2, Option::None), 99)
    end
  end
  return qspec_main()
end
def vma_compute(): Int = 42
def vma_handle(x: Int): Int
  return match x
    0 => 10
    1 => 20
    2 => 30
    _ => 99
  end
end
def vma_option_val(opt: Int): Int
  return match opt
    Some(v) => v
    None => 0
    _ => 0
  end
end
def vma_nested(flag: Int, opt: Int): Int
  return match flag
    1 => match opt
      Some(v) => v * 2
      None => 0
      _ => 0
    end
    _ => 99
  end
end

