## Unknown type annotation tests (STR2-2)

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("unknown type annotations") do ->
    it("rejects unknown type in var annotation") do ->
      assert_compile_error(unk_var_src(), "Unknown type")
    end
    it("rejects unknown type in struct field") do ->
      assert_compile_error(unk_field_src(), "Unknown type")
    end
    it("accepts known types (Int, String, Bool)") do ->
      assert_compile_succeeds(known_types_src())
    end
    it("accepts generic type params in functions") do ->
      assert_run_exits(generic_param_src(), 42)
    end
    it("accepts generic type params in struct fields") do ->
      assert_run_exits(generic_struct_src(), 42)
    end
    it("accepts multi-param generic struct fields") do ->
      assert_run_exits(multi_generic_struct_src(), 42)
    end
    it("accepts Vec<Int> as known type") do ->
      assert_run_exits(vec_known_src(), 42)
    end
    it("accepts Bool in struct field") do ->
      assert_run_exits(bool_field_src(), 1)
    end
  end
  return qspec_main()
end

def unk_var_src(): String = """
  def main(): Int
    var x: Nonexistent = 5
    return x
  end
  """

def unk_field_src(): String = """
  struct Bad
    x: Nonexistent
  end
  def main(): Int = 0
  """

def known_types_src(): String = """
  def main(): Int
    var a: Int = 5
    var b: String = "hello"
    var c: Bool = true
    return a
  end
  """

def generic_param_src(): String = """
  def identity<T>(x: T): T = x
  def main(): Int = identity(42)
  """

def generic_struct_src(): String = """
  struct GBox<T>
    value: T
  end
  def main(): Int
    b = GBox<Int> { value: 42 }
    return b.value
  end
  """

def multi_generic_struct_src(): String = """
  struct Pair<A, B>
    first: A
    second: B
  end
  def main(): Int
    p = Pair<Int, Int> { first: 10, second: 32 }
    return p.first + p.second
  end
  """

def vec_known_src(): String = """
  def main(): Int
    var v: Vec<Int> = vec_new()
    vec_push(v, 42)
    return vec_get(v, 0)
  end
  """

def bool_field_src(): String = """
  struct Flags
    active: Bool
  end
  def main(): Int
    var f = Flags { active: true }
    if f.active
      return 1
    end
    return 0
  end
  """
