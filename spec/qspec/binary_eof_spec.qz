## Binary DSL — Phase 1.5 STEP 3: UnexpectedEof bounds check in UNPACK.
##
## `Type.decode(bytes)` must return Err(ParseError::UnexpectedEof) when
## the input buffer is smaller than the layout's fixed minimum. The check
## fires before any field reads — a short buffer never produces garbage.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — UnexpectedEof bounds check (STEP 3)") do ->

    it("short PngIhdr buffer returns Err(UnexpectedEof)") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var b = Bytes { _data: vec_new() }
          var i = 0
          while i < 5
            b.push(0)
            i = i + 1
          end
          match PngIhdr.decode(b)
            Ok(_)  => return 1
            Err(e) => {
              return 2 if not (e is UnexpectedEof)
              return 0
            }
          end
        end
        """, 0)
    end

    it("exact-length PngIhdr buffer decodes Ok") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var b = Bytes { _data: vec_new() }
          var i = 0
          while i < 13
            b.push(0)
            i = i + 1
          end
          match PngIhdr.decode(b)
            Ok(_)  => return 0
            Err(_) => return 1
          end
        end
        """, 0)
    end

    it("short IntMapHeader buffer returns Err(UnexpectedEof)") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type IntMapHeader = binary {
          cap:  u64le
          len:  u64le
          keys: u64le
          vals: u64le
          used: u64le
        }
        def main(): Int
          var b = Bytes { _data: vec_new() }
          var i = 0
          while i < 39
            b.push(0)
            i = i + 1
          end
          match IntMapHeader.decode(b)
            Ok(_)  => return 1
            Err(e) => {
              return 2 if not (e is UnexpectedEof)
              return 0
            }
          end
        end
        """, 0)
    end

    it("layout with variable tail enforces fixed-prefix minimum") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Packet = binary {
          hdr:     u16be
          payload: bytes
        }
        def main(): Int
          var b = Bytes { _data: vec_new() }
          b.push(0xca)
          match Packet.decode(b)
            Ok(_)  => return 1
            Err(e) => {
              return 2 if not (e is UnexpectedEof)
              return 0
            }
          end
        end
        """, 0)
    end

  end

  return qspec_main()
end
