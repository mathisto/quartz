## Traits Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("trait declaration") do ->
    it("declares a simple trait with one method") do ->
      assert_run_exits("""
        trait Eq
          def eq(a: Int, b: Int): Int
            return 0
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("declares a trait with multiple methods") do ->
      assert_run_exits("""
        trait Printable
          def to_str(x: Int): Int
            return 0
          end
          def print_it(x: Int): Void
            puts("default")
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("declares a trait with generic type parameter") do ->
      assert_run_exits("""
        trait Container<T>
          def get_item(idx: Int): Int
            return 0
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("declares a trait with multiple type parameters") do ->
      assert_run_exits("""
        trait Mapper<K, V>
          def lookup(k: Int): Int
            return 0
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("declares a trait with Self type in method signatures") do ->
      assert_run_exits("""
        trait Eq
          def eq(self: Self, other: Self): Int
            return 0
          end
        end
        def main(): Int = 0
        """, 0)
    end
  end

  describe("impl blocks") do ->
    it("implements a trait for a struct") do ->
      assert_run_exits("""
        trait Valuable
          def get_val(x: Int): Int
            return 0
          end
        end
        struct Coin
          worth: Int
        end
        extend Coin with Valuable
          def get_val(x: Int): Int
            return 42
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("implements a trait for an enum") do ->
      assert_run_exits("""
        trait Valuable
          def get_val(x: Int): Int
            return 0
          end
        end
        enum Color
          Red
          Blue
        end
        extend Color with Valuable
          def get_val(x: Int): Int
            return 7
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("implements a trait with generic parameters") do ->
      assert_run_exits(tr_generic_impl_src(), 42)
    end

    it("errors when impl references unknown trait") do ->
      assert_compile_error("""
        extend Int with Nonexistent
          def foo(): Int = 0
        end
        def main(): Int = 0
        """, "Unknown trait")
    end

    it("partial impl uses default methods from trait") do ->
      assert_run_exits("""
        trait Greetable
          def greet(x: Int): Int
            return 0
          end
          def farewell(x: Int): Int
            return 99
          end
        end
        struct Bot
          id: Int
        end
        extend Bot with Greetable
          def greet(x: Int): Int
            return 42
          end
        end
        def main(): Int
          return Bot::farewell(0)
        end
        """, 99)
    end

    it("errors when impl method has wrong signature") do ->
      assert_compile_error("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Addable
          def add_val(x: Int, y: Int): Int
            return x + y
          end
        end
        def main(): Int = 0
        """, "wrong number of parameters")
    end
  end

  describe("trait constraints") do ->
    it("constrains generic parameter with single trait") do ->
      assert_run_exits(tr_single_bound_src(), 42)
    end

    it("constrains generic parameter with multiple traits using +") do ->
      assert_run_exits(tr_multi_bound_src(), 32)
    end

    it("errors when argument does not satisfy trait constraint") do ->
      assert_compile_error(tr_unsatisfied_constraint_src(), "does not implement trait")
    end

    it("allows where clause for complex constraints") do ->
      assert_run_exits("""
        trait Addable
          def add_val(x: Int): Int
            return 0
          end
        end
        struct Num
          n: Int
        end
        extend Num with Addable
          def add_val(x: Int): Int
            return x + 10
          end
        end
        def process(obj: Num, x: Int): Int where Num: Addable
          return add_val(x)
        end
        def main(): Int
          v = Num { n: 1 }
          return process(v, 32)
        end
        """, 42)
    end

    it("supports inline bounds on multiple type params") do ->
      assert_run_exits(tr_multi_type_params_src(), 32)
    end
  end

  describe("standard traits library") do ->
    it("imports std/traits and uses Eq") do ->
      assert_run_exits(tr_std_eq_src(), 1)
    end
    it("imports std/traits and uses Ord with Eq") do ->
      assert_run_exits(tr_std_ord_src(), 2)
    end
    it("uses Hash trait for hash maps") do ->
      assert_run_exits(tr_std_hash_src(), 42)
    end
    it("uses Show trait for string representation") do ->
      assert_run_exits(tr_std_show_src(), 0)
    end
    it("uses Clone trait for value copying") do ->
      assert_run_exits(tr_std_clone_src(), 42)
    end
  end

  describe("default implementations") do ->
    it("provides default method implementation in trait") do ->
      assert_run_exits("""
        trait HasDefault
          def get_default(x: Int): Int
            return 99
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("allows impl to override default implementation") do ->
      assert_run_exits(tr_override_default_src(), 49)
    end

    it("default impl can call other trait methods") do ->
      assert_run_exits("""
        trait Describable
          def name_len(s: Int): Int = s
          def describe(s: Int): Int = name_len(s) + 10
        end
        struct Item
          x: Int
        end
        extend Item with Describable
          def name_len(s: Int): Int = 32
        end
        def main(): Int
          return Item::describe(5)
        end
        """, 42)
    end
  end

  describe("trait inheritance") do ->
    it("parses trait inheriting from another trait") do ->
      assert_run_exits(tr_trait_inherit_parse_src(), 0)
    end

    it("requires super-trait to be implemented") do ->
      assert_compile_error("""
        trait Eq
          def eq(a: Int, b: Int): Int
            return 0
          end
        end
        trait Ord: Eq
          def lt(a: Int, b: Int): Int
            return 0
          end
        end
        struct MyInt
          val: Int
        end
        extend MyInt with Ord
          def lt(a: Int, b: Int): Int
            if a < b
              return 1
            end
            return 0
          end
        end
        def main(): Int = 0
        """, "requires super-trait")
    end

    it("allows impl when super-trait is also implemented") do ->
      assert_run_exits(tr_both_impls_src(), 2)
    end
  end

  describe("trait method dispatch") do ->
    it("calls trait method on implementing type") do ->
      assert_run_exits("""
        trait Valuable
          def get_val(x: Int): Int
            return 0
          end
        end
        struct Coin
          worth: Int
        end
        extend Coin with Valuable
          def get_val(x: Int): Int
            return 42
          end
        end
        def main(): Int
          c = Coin { worth: 10 }
          return Coin::get_val(c)
        end
        """, 42)
    end

    it("calls impl method that returns computed value") do ->
      assert_run_exits(tr_computed_dispatch_src(), 42)
    end

    it("calls trait method through generic function") do ->
      assert_run_exits(tr_generic_dispatch_src(), 42)
    end

    it("resolves correct impl when multiple types implement same trait") do ->
      assert_run_exits(tr_multi_impl_dispatch_src(), 101)
    end

    it("UFCS dispatch with computed value") do ->
      assert_run_exits("""
        trait Doubler
          def dbl(x: Int): Int
            return 0
          end
        end
        struct Num
          val: Int
        end
        extend Num with Doubler
          def dbl(x: Int): Int
            return x * 2
          end
        end
        def main(): Int
          return Num::dbl(21)
        end
        """, 42)
    end

    it("two different types implement same trait") do ->
      assert_run_exits("""
        trait Sizeable
          def get_size(x: Int): Int
            return 0
          end
        end
        struct Small
          x: Int
        end
        struct Big
          x: Int
        end
        extend Small with Sizeable
          def get_size(x: Int): Int
            return 1
          end
        end
        extend Big with Sizeable
          def get_size(x: Int): Int
            return 100
          end
        end
        def main(): Int
          return Small::get_size(0) + Big::get_size(0)
        end
        """, 101)
    end
  end

  describe("primitive type trait impls") do ->
    it("implements Eq for Int") do ->
      assert_run_exits("""
        trait Eq
          def eq(a: Int, b: Int): Int
            return 0
          end
        end
        extend Int with Eq
          def eq(a: Int, b: Int): Int
            if a == b
              return 1
            end
            return 0
          end
        end
        def main(): Int
          return Int::eq(42, 42)
        end
        """, 1)
    end

    it("implements Ord for Int with all comparisons") do ->
      assert_run_exits("""
        trait Ord
          def lt(a: Int, b: Int): Int
            return 0
          end
          def le(a: Int, b: Int): Int
            return 0
          end
        end
        extend Int with Ord
          def lt(a: Int, b: Int): Int
            if a < b
              return 1
            end
            return 0
          end
          def le(a: Int, b: Int): Int
            if a <= b
              return 1
            end
            return 0
          end
        end
        def main(): Int
          return Int::lt(1, 2) + Int::le(2, 2)
        end
        """, 2)
    end

    it("supports max<T: Ord> pattern for generic algorithms") do ->
      assert_run_exits(tr_max_pattern_src(), 42)
    end
  end

  describe("Ord trait with Eq supertrait") do ->
    it("uses Eq supertrait and Ord defaults via bounded generic function") do ->
      assert_run_exits(tr_ord_defaults_src(), 1)
    end
  end

  return qspec_main()
end

def tr_generic_impl_src(): String = """
  trait Container<T>
    def get_item(idx: Int): Int
      return 0
    end
  end
  struct IntBox
    val: Int
  end
  extend IntBox with Container<Int>
    def get_item(idx: Int): Int
      return 42
    end
  end
  def main(): Int
    return IntBox::get_item(0)
  end
  """

def tr_multi_bound_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  trait Printable
    def print_val(x: Int): Int
      return 0
    end
  end
  struct Num
    n: Int
  end
  extend Num with Addable
    def add_val(x: Int): Int
      return x + 10
    end
  end
  extend Num with Printable
    def print_val(x: Int): Int
      return x + 20
    end
  end
  def process<T: Addable + Printable>(obj: T, x: Int): Int
    return add_val(x) + print_val(x)
  end
  def main(): Int
    v = Num { n: 1 }
    return process(v, 1)
  end
  """

def tr_unsatisfied_constraint_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  struct Good
    x: Int
  end
  extend Good with Addable
    def add_val(x: Int): Int
      return x + 10
    end
  end
  struct Bad
    x: Int
  end
  def process<T: Addable>(obj: T, x: Int): Int
    return 42
  end
  def main(): Int
    v = Bad { x: 1 }
    return process(v, 1)
  end
  """

def tr_multi_type_params_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  trait Printable
    def print_val(x: Int): Int
      return 0
    end
  end
  struct Num
    n: Int
  end
  extend Num with Addable
    def add_val(x: Int): Int
      return x + 10
    end
  end
  extend Num with Printable
    def print_val(x: Int): Int
      return x + 20
    end
  end
  def process<A: Addable, B: Printable>(a: A, b: B, x: Int): Int
    return add_val(x) + print_val(x)
  end
  def main(): Int
    v = Num { n: 1 }
    return process(v, v, 1)
  end
  """

def tr_std_eq_src(): String = """
  import traits
  struct MyNum
    val: Int
  end
  extend MyNum with Eq
    def op_eq(a: Int, b: Int): Bool
      if a == b
        return true
      end
      return false
    end
  end
  def main(): Int
    return MyNum::op_eq(42, 42)
  end
  """

def tr_std_ord_src(): String = """
  import traits
  struct MyNum
    val: Int
  end
  extend MyNum with Eq
    def op_eq(a: Int, b: Int): Bool
      if a == b
        return true
      end
      return false
    end
  end
  extend MyNum with Ord
    def op_lt(a: Int, b: Int): Bool
      if a < b
        return true
      end
      return false
    end
  end
  def main(): Int
    return MyNum::op_eq(42, 42) + MyNum::op_lt(1, 2)
  end
  """

def tr_std_hash_src(): String = """
  import traits
  struct Val
    n: Int
  end
  extend Val with Hash
    def hash(x: Int): Int
      return x
    end
  end
  def main(): Int
    return Val::hash(42)
  end
  """

def tr_std_show_src(): String = """
  import traits
  struct Point
    x: Int
    y: Int
  end
  extend Point with Show
    def show(x: Int): String
      return "Point"
    end
  end
  def main(): Int
    s = Point::show(0)
    if str_size(s) > 0
      return 0
    end
    return 1
  end
  """

def tr_std_clone_src(): String = """
  import traits
  struct Val
    n: Int
  end
  extend Val with Clone
    def clone(x: Int): Int
      return x
    end
  end
  def main(): Int
    return Val::clone(42)
  end
  """

def tr_trait_inherit_parse_src(): String = """
  trait Eq
    def eq(a: Int, b: Int): Int
      return 0
    end
  end
  trait Ord: Eq
    def lt(a: Int, b: Int): Int
      return 0
    end
  end
  def main(): Int = 0
  """

def tr_both_impls_src(): String = """
  trait Eq
    def eq(a: Int, b: Int): Int
      return 0
    end
  end
  trait Ord: Eq
    def lt(a: Int, b: Int): Int
      return 0
    end
  end
  struct MyInt
    val: Int
  end
  extend MyInt with Eq
    def eq(a: Int, b: Int): Int
      if a == b
        return 1
      end
      return 0
    end
  end
  extend MyInt with Ord
    def lt(a: Int, b: Int): Int
      if a < b
        return 1
      end
      return 0
    end
  end
  def main(): Int
    return MyInt::eq(5, 5) + MyInt::lt(1, 2)
  end
  """

def tr_max_pattern_src(): String = """
  trait Ord
    def lt(a: Int, b: Int): Int
      return 0
    end
  end
  struct MyInt
    val: Int
  end
  extend MyInt with Ord
    def lt(a: Int, b: Int): Int
      if a < b
        return 1
      end
      return 0
    end
  end
  def my_max<T: Ord>(hint: T, a: Int, b: Int): Int
    if lt(a, b)
      return b
    end
    return a
  end
  def main(): Int
    m = MyInt { val: 0 }
    return my_max(m, 20, 42)
  end
  """

def tr_single_bound_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  struct Num
    n: Int
  end
  extend Num with Addable
    def add_val(x: Int): Int
      return x + 10
    end
  end
  def process<T: Addable>(obj: T, x: Int): Int
    return add_val(x)
  end
  def main(): Int
    v = Num { n: 1 }
    return process(v, 32)
  end
  """

def tr_override_default_src(): String = """
  trait Greetable
    def greet(x: Int): Int
      return 0
    end
    def farewell(x: Int): Int
      return 99
    end
  end
  struct Bot
    id: Int
  end
  extend Bot with Greetable
    def greet(x: Int): Int
      return 42
    end
    def farewell(x: Int): Int
      return 7
    end
  end
  def use_trait<T: Greetable>(obj: T, x: Int): Int
    return greet(x) + farewell(x)
  end
  def main(): Int
    b = Bot { id: 1 }
    return use_trait(b, 5)
  end
  """

def tr_computed_dispatch_src(): String = """
  trait Doubler
    def dbl(x: Int): Int
      return 0
    end
  end
  struct Num
    val: Int
  end
  extend Num with Doubler
    def dbl(x: Int): Int
      return x * 2
    end
  end
  def apply_dbl<T: Doubler>(obj: T, x: Int): Int
    return dbl(x)
  end
  def main(): Int
    n = Num { val: 0 }
    return apply_dbl(n, 21)
  end
  """

def tr_generic_dispatch_src(): String = """
  trait Valuable
    def get_val(x: Int): Int
      return 0
    end
  end
  struct Coin
    worth: Int
  end
  extend Coin with Valuable
    def get_val(x: Int): Int
      return 42
    end
  end
  def extract<T: Valuable>(obj: T, x: Int): Int
    return get_val(x)
  end
  def main(): Int
    c = Coin { worth: 10 }
    return extract(c, 0)
  end
  """

def tr_multi_impl_dispatch_src(): String = """
  trait Sizeable
    def get_size(x: Int): Int
      return 0
    end
  end
  struct Small
    x: Int
  end
  struct Big
    x: Int
  end
  extend Small with Sizeable
    def get_size(x: Int): Int
      return 1
    end
  end
  extend Big with Sizeable
    def get_size(x: Int): Int
      return 100
    end
  end
  def measure<T: Sizeable>(obj: T, x: Int): Int
    return get_size(x)
  end
  def main(): Int
    s = Small { x: 0 }
    b = Big { x: 0 }
    return measure(s, 0) + measure(b, 0)
  end
  """

def tr_ord_defaults_src(): String = """
  trait Eq
    def eq(a: Int, b: Int): Int
      return 0
    end
  end
  trait Ord: Eq
    def lt(a: Int, b: Int): Int
      return 0
    end
    def le(a: Int, b: Int): Int
      if lt(a, b)
        return 1
      end
      return eq(a, b)
    end
  end
  struct MyInt
    val: Int
  end
  extend MyInt with Eq
    def eq(a: Int, b: Int): Int
      if a == b
        return 1
      end
      return 0
    end
  end
  extend MyInt with Ord
    def lt(a: Int, b: Int): Int
      if a < b
        return 1
      end
      return 0
    end
  end
  def check_le<T: Ord>(hint: T, a: Int, b: Int): Int
    return le(a, b)
  end
  def main(): Int
    m = MyInt { val: 0 }
    return check_le(m, 5, 5)
  end
  """
