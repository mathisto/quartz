## Phase 6.1.f — CorsConfig acceptance spec.
##
## Operation Piezoelectric Effects, Phase 6 (user-tool dogfooding),
## subphase 6.1.f. Promotes `with_cors` from a hardcoded permissive
## middleware to a configurable one, parametrized by `CorsConfig`.
##
## What this spec covers:
## - **`cors_default()` baseline**: confirms the permissive defaults
##   (`*` origin, the five common methods, `Content-Type +
##   Authorization` headers, `Max-Age` omitted) match the pre-6.1.f
##   shipped behavior — no behavioral regression for callers that
##   pass `cors_default()` and ignore the rest.
## - **Custom origin on non-OPTIONS**: `with_cors(cfg, h)` with a
##   tightened origin emits the configured `Access-Control-Allow-Origin`
##   on the wrapped handler's response.
## - **Custom origin on OPTIONS preflight**: same configured origin
##   emitted on the 204 preflight response, alongside the configured
##   methods and headers.
## - **`Max-Age` opt-in**: when `cfg.max_age > 0`, the preflight
##   response includes `Access-Control-Max-Age: N`. When 0 (the
##   default), the header is omitted entirely.
##
## What this spec does NOT cover:
## - Live network round-trip with a browser. The spec exercises the
##   middleware as a pure `Fn(Request): Response` — header values are
##   read off the returned struct's `extra_header_keys`/`vals` vectors.
## - Origin reflection (echo the `Origin` request header verbatim).
##   Filed as a v2 feature if a customer asks for it; the v1 surface
##   is per-server-config, not per-request-derived.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("CorsConfig (Phase 6.1.f)") do ->

    it("cors_default() returns the documented permissive baseline") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def main(): Int
  var cfg = cors_default()
  puts(cfg.origin)
  puts(cfg.methods)
  puts(cfg.headers)
  puts(str_from_int(cfg.max_age))
  return 0
end
""", "*\nGET, POST, PUT, DELETE, OPTIONS\nContent-Type, Authorization\n0\n")
    end

    it("with_cors(default, h) injects '*' origin on a non-OPTIONS response") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def hello(req: Request): Response
  return text_response("hi")
end

def find_header(resp: Response, key: String): String
  for i in 0..resp.extra_header_keys.size
    if resp.extra_header_keys[i].eq(key)
      return resp.extra_header_vals[i]
    end
  end
  return ""
end

def main(): Int
  var wrapped = with_cors(cors_default(), hello)
  var req = Request {
    method: "GET", path: "/", query_string: "", body: "",
    raw_path: "/",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var resp = wrapped(req)
  puts(str_from_int(resp.status))
  puts(resp.body)
  puts(find_header(resp, "Access-Control-Allow-Origin"))
  return 0
end
""", "200\nhi\n*\n")
    end

    it("custom origin propagates to non-OPTIONS responses") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def hello(req: Request): Response
  return text_response("hi")
end

def find_header(resp: Response, key: String): String
  for i in 0..resp.extra_header_keys.size
    if resp.extra_header_keys[i].eq(key)
      return resp.extra_header_vals[i]
    end
  end
  return ""
end

def main(): Int
  var cfg = cors_default()
  cfg.origin = "https://app.example.com"
  var wrapped = with_cors(cfg, hello)
  var req = Request {
    method: "GET", path: "/", query_string: "", body: "",
    raw_path: "/",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var resp = wrapped(req)
  puts(find_header(resp, "Access-Control-Allow-Origin"))
  return 0
end
""", "https://app.example.com\n")
    end

    it("OPTIONS preflight emits 204 with all configured headers") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def hello(req: Request): Response
  return text_response("hi")
end

def find_header(resp: Response, key: String): String
  for i in 0..resp.extra_header_keys.size
    if resp.extra_header_keys[i].eq(key)
      return resp.extra_header_vals[i]
    end
  end
  return ""
end

def main(): Int
  var cfg = cors_default()
  cfg.origin = "https://app.example.com"
  cfg.methods = "GET, POST"
  cfg.headers = "Content-Type, X-Request-Id"
  var wrapped = with_cors(cfg, hello)
  var req = Request {
    method: "OPTIONS", path: "/", query_string: "", body: "",
    raw_path: "/",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var resp = wrapped(req)
  puts(str_from_int(resp.status))
  puts(find_header(resp, "Access-Control-Allow-Origin"))
  puts(find_header(resp, "Access-Control-Allow-Methods"))
  puts(find_header(resp, "Access-Control-Allow-Headers"))
  return 0
end
""", "204\nhttps://app.example.com\nGET, POST\nContent-Type, X-Request-Id\n")
    end

    it("max_age=0 omits Access-Control-Max-Age; max_age>0 emits it") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def hello(req: Request): Response
  return text_response("hi")
end

def find_header(resp: Response, key: String): String
  for i in 0..resp.extra_header_keys.size
    if resp.extra_header_keys[i].eq(key)
      return resp.extra_header_vals[i]
    end
  end
  return "<absent>"
end

def main(): Int
  var req = Request {
    method: "OPTIONS", path: "/", query_string: "", body: "",
    raw_path: "/",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }

  var cfg0 = cors_default()
  var w0 = with_cors(cfg0, hello)
  var resp0 = w0(req)
  puts(find_header(resp0, "Access-Control-Max-Age"))

  var cfg600 = cors_default()
  cfg600.max_age = 600
  var w600 = with_cors(cfg600, hello)
  var resp600 = w600(req)
  puts(find_header(resp600, "Access-Control-Max-Age"))
  return 0
end
""", "<absent>\n600\n")
    end

  end
  return qspec_main()
end
