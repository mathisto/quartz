## Multiline String Tests
##
## Contract:
##   1. Triple-quoted: `"""..."""` contains embedded newlines.
##   2. Indentation: common leading whitespace stripped.
##   3. Trailing newline: no extra trailing newline added.
##   4. Interpolation: #{} works inside triple-quoted strings.

import * from qspec

def main(): Int
  describe("triple-quoted strings") do ->
    it("basic triple-quoted string contains embedded newline") do ->
      var s = """hello
world"""
      assert_eq(s.size, 11)
    end

    it("strips leading newline after opening triple-quote") do ->
      var s = """
hello"""
      assert_eq(s.size, 5)
      assert_eq_str(s, "hello")
    end

    it("strips trailing newline before closing triple-quote") do ->
      var s = """hello
"""
      assert_eq(s.size, 5)
    end

    it("allows embedded double quotes") do ->
      var s = """say "hello" here"""
      assert_eq_str(s, "say \"hello\" here")
    end

    it("empty triple-quoted string") do ->
      var s = """"""
      assert_eq(s.size, 0)
    end

    it("interpolation in triple-quoted string") do ->
      assert_eq_str(mls_interp_test(), "hello 42 world")
    end
  end

  describe("indentation stripping") do ->
    it("strips common indentation based on closing delimiter") do ->
      assert_eq_str(mls_indent_basic(), "hello\nworld")
    end

    it("preserves relative indentation between lines") do ->
      assert_eq_str(mls_indent_relative(), "outer\n  inner\nouter")
    end

    it("handles empty lines in indented content") do ->
      assert_eq_str(mls_indent_empty_lines(), "line1\n\nline2")
    end

    it("no stripping when closing delimiter is not on own line") do ->
      var s = """  hello  """
      assert_eq_str(s, "  hello  ")
    end

    it("backward compatible with column-1 closing delimiter") do ->
      assert_eq_str(mls_indent_col1(), "  hello\n  world")
    end

    it("strips indentation with deeper nesting") do ->
      assert_eq_str(mls_indent_deep(), "def main(): Int\n  return 0\nend")
    end
  end

  return qspec_main()
end

def mls_interp_test(): String
  x = 42
  return """hello #{x} world"""
end

def mls_indent_basic(): String
  return """
    hello
    world
    """
end

def mls_indent_relative(): String
  return """
    outer
      inner
    outer
    """
end

def mls_indent_empty_lines(): String
  return """
    line1

    line2
    """
end

def mls_indent_col1(): String
  return """
  hello
  world
"""
end

def mls_indent_deep(): String
  return """
    def main(): Int
      return 0
    end
    """
end
