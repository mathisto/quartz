## Map Index Syntax Tests
##
## Contract:
##   1. Map get syntax m[key] (panicking subscript via map_fetch).
##   2. Map set syntax m[key] = value.
##   3. Map methods.

import * from qspec

def main(): Int
  describe("map get syntax m[key]") do ->
    it("reads value by string key") do ->
      m = map_new()
      m.set("answer", 42)
      assert_eq(m["answer"], 42)
    end
    it("reads value by variable key") do ->
      m = map_new()
      key = "hello"
      m.set(key, 99)
      assert_eq(m[key], 99)
    end
    it("m.get returns None for missing key") do ->
      m = map_new()
      m.set("a", 1)
      match m.get("missing")
        Some(v) => assert_eq(0, 1)
        _ => assert_eq(1, 1)
      end
    end
  end

  describe("map set syntax m[key] = value") do ->
    it("writes value by string key") do ->
      var m = map_new()
      m["key"] = 100
      assert_eq(m["key"], 100)
    end
    it("overwrites existing value") do ->
      var m = map_new()
      m.set("x", 1)
      m["x"] = 2
      assert_eq(m["x"], 2)
    end
  end

  describe("map methods") do ->
    it("m.has(key) checks existence") do ->
      m = map_new()
      m.set("exists", 1)
      h = m.has("exists")
      assert_eq(h, 1)
    end

    it("m.has(key) returns 0 for missing key") do ->
      m = map_new()
      m.set("other", 1)
      h = m.has("missing")
      assert_eq(h, 0)
    end

    it("map_delete removes entry") do ->
      m = map_new()
      m.set("key", 42)
      m.delete("key")
      assert_eq(m.has("key"), 0)
    end

    it("map_size returns count") do ->
      m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      assert_eq(m.size(), 2)
    end
  end

  return qspec_main()
end
