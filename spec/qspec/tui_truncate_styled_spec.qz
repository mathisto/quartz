## std/tui/layout::truncate behaviour around ANSI styles.
##
## Coverage:
##   - plain truncate (no SGR involved) — unchanged from pre-style work
##   - line within bounds with SGR — passes through, no reset added
##   - truncate after styled prefix — `\x1b[0m` appended
##   - truncate inside a styled span — `\x1b[0m` appended
##   - truncate at exactly the cut boundary — works
##   - line with only a reset SGR (no non-reset) — no extra reset

import * from qspec
import std/tui/layout as ly

def test_plain_truncate_no_reset(): Void
  ## No SGR at all → no `\x1b[0m` appended.
  var out = ly::truncate("hello world", 5)
  assert_eq_str(out, "hello")
end

def test_within_bounds_passthrough_with_sgr(): Void
  ## Line fits → returned unchanged, no reset added.
  var input = "\x1b[31mhi\x1b[0m"
  assert_eq_str(ly::truncate(input, 10), input)
end

def test_truncate_after_styled_prefix_appends_reset(): Void
  ## `\x1b[31mAB\x1b[0m CD` truncated to 3 cells → "\x1b[31mAB\x1b[0m " is
  ## within budget; cut would happen at "C". Kept prefix saw a non-reset
  ## SGR (\x1b[31m), so a closing reset is appended.
  var input = "\x1b[31mAB\x1b[0m CD"
  var out = ly::truncate(input, 3)
  if str_contains(out, "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_truncate_inside_styled_span_appends_reset(): Void
  ## Styled span longer than max — cut lands inside the span. The kept
  ## prefix has the opener with no closer; we must append \x1b[0m so the
  ## terminal doesn't bleed.
  var input = "\x1b[31mhello world\x1b[0m"
  var out = ly::truncate(input, 5)
  ## End of out should be `\x1b[0m`. Look for the suffix.
  var len = str_byte_len(out)
  if len >= 4
    var tail = str_byte_slice(out, len - 4, len)
    assert_eq_str(tail, "\x1b[0m")
  else
    assert_eq(0, 1)
  end
end

def test_truncate_only_reset_sgr_no_extra_reset(): Void
  ## Line contains only a reset SGR `\x1b[0m` (no non-reset SGR).
  ## Truncation must not append a second reset.
  var input = "AB\x1b[0mCDEF"
  var out = ly::truncate(input, 3)
  ## Visible width is 6 (A, B, C, D, E, F), so truncate to 3 cuts at
  ## the 4th codepoint. Output should be "AB\x1b[0mC" with no extra
  ## reset.
  if str_contains(out, "\x1b[0m\x1b[0m")
    assert_eq(0, 1)
  else
    assert_eq(1, 1)
  end
end

def test_truncate_at_boundary_no_cut(): Void
  ## Visible width exactly equals max_width — no truncation, content
  ## passes through unchanged including any SGR escapes.
  var input = "\x1b[1mhello\x1b[0m"
  assert_eq_str(ly::truncate(input, 5), input)
end

def test_truncate_styled_multi_line(): Void
  ## Each line truncated independently. Line 1 has styled content
  ## that gets cut; line 2 is plain and short.
  var input = "\x1b[31mhello world\x1b[0m\nok"
  var out = ly::truncate(input, 5)
  ## After split: line 1 cut + reset; line 2 unchanged.
  if str_contains(out, "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if str_contains(out, "\nok")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def main(): Int
  describe("truncate plain") do ->
    it("no SGR involved → no reset appended") do ->
      test_plain_truncate_no_reset()
    end
  end

  describe("truncate within bounds") do ->
    it("line with SGR within bounds passes through unchanged") do ->
      test_within_bounds_passthrough_with_sgr()
    end
    it("line whose visible width == max_width is unchanged") do ->
      test_truncate_at_boundary_no_cut()
    end
  end

  describe("truncate cuts styled content") do ->
    it("after a styled prefix appends \\x1b[0m") do ->
      test_truncate_after_styled_prefix_appends_reset()
    end
    it("inside a styled span appends \\x1b[0m") do ->
      test_truncate_inside_styled_span_appends_reset()
    end
    it("multi-line: styled cut + plain short tail both handled") do ->
      test_truncate_styled_multi_line()
    end
  end

  describe("truncate reset-only") do ->
    it("only-reset SGR → no extra reset appended") do ->
      test_truncate_only_reset_sgr_no_extra_reset()
    end
  end

  return qspec_main()
end
