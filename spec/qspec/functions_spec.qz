## Functions Tests
##
## Contract:
##   1. Basic function definition.
##   2. Multiple functions.
##   3. Function parameters.
##   4. Recursion.
##   5. Mutual recursion.
##   6. Forward references.
##   7. Parameters as mutable locals.
##   8. First-class functions.
##   9. Many parameters.
##   10. Generic functions.
##   11. Function references.
##   12. Generic return types.
##   13. Function properties.

import * from qspec
import * from qspec/property
import * from qspec/subprocess

def main(): Int
  describe("basic function definition") do ->
    it("defines and calls main") do ->
      assert_eq(0, 0)
    end

    it("returns a value from main") do ->
      assert_eq(99, 99)
    end
  end

  describe("multiple functions") do ->
    it("calls a helper function") do ->
      assert_eq(fn_answer(), 42)
    end

    it("calls multiple helper functions") do ->
      assert_eq(fn_ten() + fn_twenty(), 30)
    end

    it("chains function calls") do ->
      assert_eq(fn_c(), 6)
    end
  end

  describe("function parameters") do ->
    it("accepts one parameter") do ->
      assert_eq(fn_identity(42), 42)
    end

    it("accepts two parameters") do ->
      assert_eq(fn_add(17, 25), 42)
    end

    it("accepts three parameters") do ->
      assert_eq(fn_sum3(10, 20, 12), 42)
    end

    it("uses parameters in expressions") do ->
      assert_eq(fn_compute(6, 10), 42)
    end

    it("passes expressions as arguments") do ->
      assert_eq(fn_double(10 + 11), 42)
    end

    it("passes function results as arguments") do ->
      assert_eq(fn_double(fn_five()), 10)
    end
  end

  describe("recursion") do ->
    it("computes factorial") do ->
      assert_eq(fn_factorial(5), 120)
    end

    it("computes fibonacci") do ->
      assert_eq(fn_fib(10), 55)
    end

    it("handles deep recursion") do ->
      assert_eq(fn_countdown(100), 0)
    end
  end

  describe("mutual recursion") do ->
    it("calls functions that call each other") do ->
      assert_eq(fn_is_even(10), 1)
    end

    it("validates odd numbers") do ->
      assert_eq(fn_is_odd(7), 1)
    end
  end

  describe("forward references") do ->
    it("calls a function defined later") do ->
      assert_eq(fn_helper(), 42)
    end

    it("main calls late-defined function with params") do ->
      assert_eq(fn_add(20, 22), 42)
    end
  end

  describe("parameters as mutable locals") do ->
    it("can reassign parameters") do ->
      assert_eq(fn_modify(32), 42)
    end

    it("parameter changes do not affect caller") do ->
      val = 42
      fn_try_modify(val)
      assert_eq(val, 42)
    end
  end

  describe("first-class functions") do ->
    it("passes named function as argument") do ->
      assert_eq(fn_apply(fn_double, 21), 42)
    end

    it("stores named function in variable") do ->
      f = fn_triple
      assert_eq(f(14), 42)
    end

    it("passes multi-arg function as argument") do ->
      assert_eq(fn_apply2(fn_add, 20, 22), 42)
    end

    it("returns named function from function") do ->
      f = fn_get_square()
      assert_eq(f(6), 36)
    end
  end

  describe("many parameters") do ->
    it("accepts 6 parameters") do ->
      assert_eq(fn_sum6(1, 2, 3, 4, 5, 6), 21)
    end

    it("accepts 8 parameters") do ->
      assert_eq(fn_sum8(1, 2, 3, 4, 5, 6, 7, 8), 36)
    end
  end

  describe("generic functions") do ->
    ## Generic functions can't be called from closures — use named helpers
    it("defines a single type parameter function") do ->
      assert_eq(fn_test_gen_identity(), 42)
    end
    it("defines multiple type parameter function") do ->
      assert_eq(fn_test_first(), 42)
    end
    it("uses type params in function body") do ->
      assert_eq(fn_test_wrap(), 42)
    end
    it("calls generic function multiple times with different types") do ->
      assert_eq(fn_test_gen_multi(), 1)
    end
    it("parses generic type annotations in parameters") do ->
      assert_eq(fn_test_passthrough(), 42)
    end
    it("parses nested generic type annotations") do ->
      assert_run_exits(fn_nested_generic_src(), 42)
    end
  end

  describe("function references") do ->
    it("creates a reference to a function with &") do ->
      f = &fn_double
      assert_eq(f(21), 42)
    end

    it("passes function reference as argument") do ->
      assert_eq(fn_apply(&fn_double, 21), 42)
    end

    it("calls function reference with multiple arguments") do ->
      f = &fn_add
      assert_eq(f(20, 22), 42)
    end

    it("stores and calls zero-arg function reference") do ->
      f = &fn_answer
      assert_eq(f(), 42)
    end

    it("returns function reference from function") do ->
      f = fn_get_multiplier(1)
      assert_eq(f(21), 42)
    end

    it("uses function reference with higher-order function") do ->
      assert_eq(fn_apply_twice(&fn_increment, 40), 42)
    end
  end

  describe("generic return types") do ->
    it("returns struct from generic function") do ->
      assert_run_exits("""
        struct Box<T>
          value: T
        end
        def make<T>(v: T): Box<T>
          return Box { value: v }
        end
        def main(): Int
          var b = make(42)
          return b.value
        end
        """, 42)
    end

    it("calls function with multiple type args at call site") do ->
      assert_run_exits(fn_multi_type_args_src(), 42)
    end

    it("passes generic Fn type through generic function") do ->
      assert_run_exits(fn_generic_fn_type_src(), 42)
    end

    it("returns struct from trait-bounded generic function") do ->
      assert_run_exits("""
        trait Describable
          def describe_val(): Int
            return 0
          end
        end
        struct DBox
          value: Int
        end
        extend DBox with Describable
          def describe_val(): Int
            return 42
          end
        end
        def make_box(): DBox
          return DBox { value: 42 }
        end
        def main(): Int
          b = make_box()
          return b.value
        end
        """, 42)
    end

    it("user-defined 'first' shadows intrinsic") do ->
      assert_compile_error("""
        def first(x: Int): Int
          return x + 10
        end
        def main(): Int
          return first(32)
        end
        """, "shadows a builtin intrinsic")
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("function properties") do ->
    forall_i("identity(x) == x") do x: Int ->
      assert_eq(fn_identity(x), x)
    end

    forall_ii("add(a, b) == add(b, a)") do a: Int, b: Int ->
      assert_eq(fn_add(a, b), fn_add(b, a))
    end

    forall_i("double(x) == x + x") do x: Int ->
      assert_eq(fn_double(x), x + x)
    end

    forall_i("apply(identity, x) == x") do x: Int ->
      assert_eq(fn_apply(fn_identity, x), x)
    end

    forall_i("apply(double, x) == 2*x") do x: Int ->
      assert_eq(fn_apply(fn_double, x), x * 2)
    end

    forall_i("apply_twice(increment, x) == x + 2") do x: Int ->
      assert_eq(fn_apply_twice(fn_increment, x), x + 2)
    end
  end

  return qspec_main()
end

def fn_answer(): Int
  return 42
end

def fn_ten(): Int
  return 10
end

def fn_twenty(): Int
  return 20
end

def fn_a(): Int
  return 1
end

def fn_b(): Int
  return fn_a() + 2
end

def fn_c(): Int
  return fn_b() + 3
end

def fn_identity(x: Int): Int
  return x
end

def fn_add(a: Int, b: Int): Int
  return a + b
end

def fn_sum3(a: Int, b: Int, c: Int): Int
  return a + b + c
end

def fn_compute(x: Int, y: Int): Int
  return x * 2 + y * 3
end

def fn_double(x: Int): Int
  return x * 2
end

def fn_five(): Int
  return 5
end

def fn_factorial(n: Int): Int
  if n <= 1
    return 1
  end
  return n * fn_factorial(n - 1)
end

def fn_fib(n: Int): Int
  if n <= 1
    return n
  end
  return fn_fib(n - 1) + fn_fib(n - 2)
end

def fn_countdown(n: Int): Int
  if n == 0
    return 0
  end
  return fn_countdown(n - 1)
end

def fn_is_even(n: Int): Int
  if n == 0
    return 1
  end
  return fn_is_odd(n - 1)
end

def fn_is_odd(n: Int): Int
  if n == 0
    return 0
  end
  return fn_is_even(n - 1)
end

def fn_helper(): Int
  return 42
end

def fn_modify(x: Int): Int
  x = x + 10
  return x
end

def fn_try_modify(x: Int): Int
  x = 999
  return x
end

def fn_triple(x: Int): Int
  return x * 3
end

def fn_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def fn_apply2(f: Fn(Int, Int): Int, x: Int, y: Int): Int
  return f(x, y)
end

def fn_square(x: Int): Int
  return x * x
end

def fn_get_square(): Fn(Int): Int
  return fn_square
end

def fn_sum6(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int): Int
  return a + b + c + d + e + f
end

def fn_sum8(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int): Int
  return a + b + c + d + e + f + g + h
end

def fn_gen_identity<T>(x: T): T
  return x
end

def fn_first<T, U>(a: T, b: U): T
  return a
end

def fn_wrap<T>(x: T): T
  y = x
  return y
end

def fn_passthrough<T>(x: T): T
  return x
end

def fn_increment(x: Int): Int
  return x + 1
end

def fn_get_multiplier(use_double: Int): Fn(Int): Int
  if use_double
    return &fn_double
  end
  return &fn_triple
end

def fn_apply_twice(f: Fn(Int): Int, x: Int): Int
  return f(f(x))
end

## Named helpers for generic function tests (can't call generics from closures)
def fn_test_gen_identity(): Int = fn_gen_identity(42)
def fn_test_first(): Int = fn_first(42, 99)
def fn_test_wrap(): Int = fn_wrap(42)
def fn_test_passthrough(): Int = fn_passthrough(42)
def fn_test_gen_multi(): Int
  a = fn_gen_identity(42)
  b = fn_gen_identity(99)
  if a == 42 and b == 99
    return 1
  end
  return 0
end

def fn_nested_generic_src(): String = """
  def wrap<T>(x: T): T
    return x
  end
  def apply_fn<T>(f: Fn(T): T, x: T): T
    return f(x)
  end
  def double(x: Int): Int = x * 2
  def main(): Int
    return apply_fn(double, 21)
  end
  """

def fn_multi_type_args_src(): String = """
  def first_of<T, U>(a: T, b: U): T
    return a
  end
  def main(): Int
    return first_of(42, 99)
  end
  """

def fn_generic_fn_type_src(): String = """
  def apply_fn<T>(f: Fn(T): T, x: T): T
    return f(x)
  end
  def double(x: Int): Int = x * 2
  def main(): Int
    return apply_fn(double, 21)
  end
  """

def fn_ret_struct_generic_src(): String = """
  struct GBox<T>
    value: T
  end
  def make_gbox<T>(v: T): GBox<T>
    return GBox { value: v }
  end
  def main(): Int
    var b = make_gbox(42)
    return b.value
  end
  """

def fn_ret_option_generic_src(): String = """
  def make_some<T>(v: T): Int
    return Option::Some(v)
  end
  def main(): Int
    x = make_some(42)
    result = match x
      Some(val) => val
      None => 0
      _ => 0
    end
    return result
  end
  """
