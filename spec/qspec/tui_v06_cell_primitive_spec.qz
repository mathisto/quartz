## QSpec coverage for std/tui/cell.qz and std/tui/theme.qz — the v0.6
## Phase 6.0 foundation block.
##
## Cell primitive surface:
##   - AlphaMode enum (4 variants — Opaque / Blend / Transparent / HighContrast)
##   - Cell + Channel struct construction via every constructor
##   - Channel encoding round-trips through the std/style.qz color scheme
##   - Cell attribute bitset: set / clear / has across the 7 attribute bits
##   - Cell builder mutators (with_fg, with_bg, with_attrs, add_attr) preserve
##     other slots
##
## Theme surface:
##   - Theme struct construction
##   - All 12 semantic accessors return their documented base slot
##   - theme_accent dispatch for all 8 accent slots + out-of-range guard
##   - Catppuccin Mocha bundled values match the canonical Catppuccin
##     palette (https://catppuccin.com)
##
## See docs/design/TUI_V06_CELL_ENGINE.md and
## docs/design/TUI_V06_OPEN_QUESTIONS.md for the design rationale.

import * from qspec
import std/tui/cell as cl
import std/tui/theme as th
import style

def main(): Int
  describe("cl::AlphaMode") do ->
    it("Opaque is distinct from Blend / Transparent / HighContrast") do ->
      var a = cl::AlphaMode::Opaque
      if a is Opaque
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if a is Blend
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("Transparent + HighContrast are distinguishable") do ->
      var t = cl::AlphaMode::Transparent
      var h = cl::AlphaMode::HighContrast
      if t is Transparent
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if h is HighContrast
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::channel_default") do ->
    it("uses terminal default color, transparent alpha, rgb=-1") do ->
      var c = cl::channel_default()
      assert_eq(c.color, -1)
      if c.alpha is Transparent
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if c.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if c.palette
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end
  end

  describe("cl::channel_rgb") do ->
    it("stores packed truecolor with Opaque alpha") do ->
      var rgb = rgb_color(255, 128, 0)
      var c = cl::channel_rgb(rgb)
      assert_eq(c.color, rgb)
      if c.alpha is Opaque
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if c.default_color
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("interoperates with std/style.qz hex_color encoding") do ->
      var hex_int = hex_color("#FF8000")
      var c = cl::channel_rgb(hex_int)
      assert_eq(c.color, hex_int)
      assert_eq(c.color, rgb_color(255, 128, 0))
    end

    it("accepts ANSI 16 color values") do ->
      var c = cl::channel_rgb(Red())
      assert_eq(c.color, 1)
      if c.alpha is Opaque
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::channel_palette") do ->
    it("stores palette index with Opaque alpha and palette flag set") do ->
      var c = cl::channel_palette(214)
      assert_eq(c.color, 214)
      if c.alpha is Opaque
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if c.palette
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::channel_with_alpha") do ->
    it("replaces alpha and preserves rgb / flags") do ->
      var c = cl::channel_rgb(rgb_color(10, 20, 30))
      var blended = cl::channel_with_alpha(c, cl::AlphaMode::Blend)
      assert_eq(blended.color, c.color)
      if blended.alpha is Blend
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if blended.default_color == c.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::cell_blank") do ->
    it("renders a single space with default fg / bg, no attrs") do ->
      var c = cl::cell_blank()
      assert_eq_str(c.egc, " ")
      assert_eq(c.attrs, 0)
      if c.fg.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if c.bg.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::cell_char") do ->
    it("captures the egc verbatim") do ->
      var c = cl::cell_char("X")
      assert_eq_str(c.egc, "X")
      assert_eq(c.attrs, 0)
    end

    it("preserves multi-codepoint clusters") do ->
      # "é" is two UTF-8 bytes but one grapheme cluster
      var c = cl::cell_char("é")
      assert_eq_str(c.egc, "é")
    end
  end

  describe("cl::cell_with_fg / cell_with_bg") do ->
    it("with_fg replaces fg, preserves egc / bg / attrs") do ->
      var base = cl::cell_char("A")
      var red = cl::channel_rgb(rgb_color(255, 0, 0))
      var out = cl::cell_with_fg(base, red)
      assert_eq_str(out.egc, "A")
      assert_eq(out.fg.color, rgb_color(255, 0, 0))
      if out.bg.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(out.attrs, 0)
    end

    it("with_bg replaces bg, preserves egc / fg / attrs") do ->
      var base = cl::cell_char("B")
      var blue = cl::channel_rgb(rgb_color(0, 0, 255))
      var out = cl::cell_with_bg(base, blue)
      assert_eq(out.bg.color, rgb_color(0, 0, 255))
      if out.fg.default_color
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cl::cell_with_attrs / cell_add_attr") do ->
    it("with_attrs replaces the bitset wholesale") do ->
      var c = cl::cell_with_attrs(cl::cell_blank(), cl::CELL_ATTR_BOLD())
      assert_eq(c.attrs, cl::CELL_ATTR_BOLD())
    end

    it("add_attr ORs onto existing bitset") do ->
      var c = cl::cell_with_attrs(cl::cell_blank(), cl::CELL_ATTR_BOLD())
      var c2 = cl::cell_add_attr(c, cl::CELL_ATTR_UNDER())
      var expected = cl::CELL_ATTR_BOLD() | cl::CELL_ATTR_UNDER()
      assert_eq(c2.attrs, expected)
    end
  end

  describe("cl::cell_attr_has / set / clear") do ->
    it("has detects the present bit") do ->
      var attrs = cl::CELL_ATTR_BOLD() | cl::CELL_ATTR_ITALIC()
      if cl::cell_attr_has(attrs, cl::CELL_ATTR_BOLD())
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      if cl::cell_attr_has(attrs, cl::CELL_ATTR_DIM())
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("set adds a bit; clear removes it") do ->
      var a0 = 0
      var a1 = cl::cell_attr_set(a0, cl::CELL_ATTR_REVERSE())
      assert_eq(a1, cl::CELL_ATTR_REVERSE())
      var a2 = cl::cell_attr_clear(a1, cl::CELL_ATTR_REVERSE())
      assert_eq(a2, 0)
    end

    it("all 7 attribute bits are distinct powers of two") do ->
      assert_eq(cl::CELL_ATTR_BOLD(),    1)
      assert_eq(cl::CELL_ATTR_DIM(),     2)
      assert_eq(cl::CELL_ATTR_ITALIC(),  4)
      assert_eq(cl::CELL_ATTR_UNDER(),   8)
      assert_eq(cl::CELL_ATTR_STRIKE(),  16)
      assert_eq(cl::CELL_ATTR_REVERSE(), 32)
      assert_eq(cl::CELL_ATTR_BLINK(),   64)
    end
  end

  describe("th::Theme — Catppuccin Mocha bundled defaults") do ->
    it("name + author + variant are populated") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq_str(t.name, "Catppuccin Mocha")
      assert_eq_str(t.author, "Catppuccin Team")
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("base00 is #1E1E2E (Catppuccin base background)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base00, hex_color("1E1E2E"))
    end

    it("base05 is #CDD6F4 (Catppuccin text foreground)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base05, hex_color("CDD6F4"))
    end

    it("base08 is #F38BA8 (Catppuccin red)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base08, hex_color("F38BA8"))
    end

    it("base0B is #A6E3A1 (Catppuccin green)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base0B, hex_color("A6E3A1"))
    end

    it("base0D is #89B4FA (Catppuccin blue)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base0D, hex_color("89B4FA"))
    end

    it("base0E is #CBA6F7 (Catppuccin mauve)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(t.base0E, hex_color("CBA6F7"))
    end

    it("base10_17 (Base24 extension) is None — Catppuccin is Base16") do ->
      var t = th::theme_catppuccin_mocha()
      if t.base10_17 is None
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("th::semantic accessors map to documented base slots") do ->
    it("theme_bg returns base00") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_bg(t), t.base00)
    end

    it("theme_fg returns base05") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_fg(t), t.base05)
    end

    it("theme_dim returns base03") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_dim(t), t.base03)
    end

    it("theme_selection_bg returns base02") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_selection_bg(t), t.base02)
    end

    it("theme_status_bar_bg returns base01") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_status_bar_bg(t), t.base01)
    end

    it("theme_status_bar_fg returns base04") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_status_bar_fg(t), t.base04)
    end

    it("theme_error returns base08") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_error(t), t.base08)
    end

    it("theme_warning returns base09") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_warning(t), t.base09)
    end

    it("theme_info returns base0D") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_info(t), t.base0D)
    end

    it("theme_success returns base0B") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_success(t), t.base0B)
    end

    it("theme_special returns base0E") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_special(t), t.base0E)
    end
  end

  describe("th::theme_accent dispatch") do ->
    it("ACCENT_RED → base08") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_RED()), t.base08)
    end

    it("ACCENT_ORANGE → base09") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_ORANGE()), t.base09)
    end

    it("ACCENT_YELLOW → base0A") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_YELLOW()), t.base0A)
    end

    it("ACCENT_GREEN → base0B") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_GREEN()), t.base0B)
    end

    it("ACCENT_CYAN → base0C") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_CYAN()), t.base0C)
    end

    it("ACCENT_BLUE → base0D") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_BLUE()), t.base0D)
    end

    it("ACCENT_PURPLE → base0E") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_PURPLE()), t.base0E)
    end

    it("ACCENT_BROWN → base0F") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, th::ACCENT_BROWN()), t.base0F)
    end

    it("out-of-range slot falls back to base05 (default fg)") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_accent(t, 99), t.base05)
      assert_eq(th::theme_accent(t, -1), t.base05)
    end
  end

  describe("Theme + Channel interop") do ->
    it("theme.base05 round-trips through channel_rgb") do ->
      var t = th::theme_catppuccin_mocha()
      var c = cl::channel_rgb(th::theme_fg(t))
      assert_eq(c.color, t.base05)
    end

    it("theme.base08 (error) and theme_error agree") do ->
      var t = th::theme_catppuccin_mocha()
      assert_eq(th::theme_error(t), t.base08)
    end
  end

  return qspec_main()
end
