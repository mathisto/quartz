## std/tui/layout::clamp_to_terminal_width — coverage of the three
## clamp regimes. Forces each branch by picking min/max that make the
## actual terminal width fall on a known side of the bound:
##
##   - terminal-narrower-than-min: min set far above any real terminal
##   - terminal-wider-than-max:    max set to 1
##   - terminal-in-range:          permissive [1, 9999], result equals
##                                 term_get_width - 2 within bounds

import * from qspec
import std/tui/layout as ly
import std/terminal

def main(): Int
  describe("clamp_to_terminal_width") do ->
    it("returns `min` when the terminal is narrower than min") do ->
      var w = ly::clamp_to_terminal_width(9999, 10000)
      assert_eq(w, 9999)
    end

    it("returns `max` when the terminal is wider than max") do ->
      var w = ly::clamp_to_terminal_width(0, 1)
      assert_eq(w, 1)
    end

    it("returns the terminal width minus 2 when in range") do ->
      var w = ly::clamp_to_terminal_width(1, 9999)
      var expected = terminal::term_get_width() - 2
      assert_eq(w, expected)
    end

    it("clamps min == max to that exact value") do ->
      var w = ly::clamp_to_terminal_width(42, 42)
      assert_eq(w, 42)
    end
  end

  return qspec_main()
end
