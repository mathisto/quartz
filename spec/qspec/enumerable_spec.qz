## Enumerable Tests
##
## Contract:
##   1. Stack enumerable.
##   2. Queue enumerable.
##   3. Deque enumerable.
##   4. LinkedList enumerable.
##   5. PriorityQueue enumerable.
##   6. SortedMap enumerable.
import * from qspec
import * from collections/stack
import * from collections/queue
import * from collections/deque
import * from collections/linked_list
import * from collections/priority_queue
import * from collections/sorted_map

# Named helpers for multi-param closures
def add_ints(a: Int, b: Int): Int = a + b
def mul_ints(a: Int, b: Int): Int = a * b
def sum_kv(acc: Int, k: Int, v: Int): Int = acc + v
def kv_val_gt15(k: Int, v: Int): Bool = v > 15
def kv_key_eq3(k: Int, v: Int): Bool = k == 3
def kv_key_eq5(k: Int, v: Int): Bool = k == 5
def kv_val_gt0(k: Int, v: Int): Bool = v > 0
def kv_val_gte20(k: Int, v: Int): Bool = v >= 20
def kv_sum(k: Int, v: Int): Int = k + v
def main(): Int
  describe("Stack enumerable") do ->
    it("map doubles values") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      var result = s.map { it * 2 }
      assert_eq(result[0], 2)
      assert_eq(result[1], 4)
      assert_eq(result[2], 6)
    end

    it("filter keeps matching") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      s.push(4)
      var evens = s.filter { it % 2 == 0 }
      assert_eq(evens.size, 2)
      assert_eq(evens[0], 2)
      assert_eq(evens[1], 4)
    end

    it("reduce sums values") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      var total = s.reduce(0, add_ints)
      assert_eq(total, 6)
    end

    it("find returns first match") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      var found = s.find { it > 1 }
      assert_eq(found, 2)
    end

    it("any and all") do ->
      var s = stack_new()
      s.push(2)
      s.push(4)
      s.push(6)
      assert_eq(s.any? { it == 4 }, true)
      assert_eq(s.any? { it == 5 }, false)
      assert_eq(s.all? { it % 2 == 0 }, true)
      assert_eq(s.all? { it > 3 }, false)
    end

    it("count and to_vec") do ->
      var s = stack_new()
      s.push(1)
      s.push(2)
      s.push(3)
      s.push(4)
      assert_eq(s.count { it > 2 }, 2)
      var v = s.to_vec()
      assert_eq(v.size, 4)
      assert_eq(v[0], 1)
    end
  end

  describe("Queue enumerable") do ->
    it("map and filter") do ->
      var q = queue_new()
      q.enqueue(10)
      q.enqueue(20)
      q.enqueue(30)
      var doubled = q.map { it * 2 }
      assert_eq(doubled[0], 20)
      assert_eq(doubled[1], 40)
      assert_eq(doubled[2], 60)
      var big = q.filter { it > 15 }
      assert_eq(big.size, 2)
    end

    it("reduce and find") do ->
      var q = queue_new()
      q.enqueue(5)
      q.enqueue(10)
      q.enqueue(15)
      assert_eq(q.reduce(0, add_ints), 30)
      assert_eq(q.find { it >= 10 }, 10)
    end
  end

  describe("Deque enumerable") do ->
    it("map after push_front and push_back") do ->
      var d = deque_new()
      d.push_back(2)
      d.push_back(3)
      d.push_front(1)
      var result = d.map { it * 10 }
      assert_eq(result[0], 10)
      assert_eq(result[1], 20)
      assert_eq(result[2], 30)
    end

    it("filter and reduce") do ->
      var d = deque_new()
      d.push_back(1)
      d.push_back(2)
      d.push_back(3)
      d.push_back(4)
      var odds = d.filter { it % 2 == 1 }
      assert_eq(odds.size, 2)
      assert_eq(d.reduce(1, mul_ints), 24)
    end
  end

  describe("LinkedList enumerable") do ->
    it("map traverses head to tail") do ->
      var ll = ll_new()
      ll.push_back(10)
      ll.push_back(20)
      ll.push_back(30)
      var result = ll.map { it + 1 }
      assert_eq(result[0], 11)
      assert_eq(result[1], 21)
      assert_eq(result[2], 31)
    end

    it("filter and count") do ->
      var ll = ll_new()
      ll.push_back(1)
      ll.push_back(2)
      ll.push_back(3)
      ll.push_back(4)
      ll.push_back(5)
      var evens = ll.filter { it % 2 == 0 }
      assert_eq(evens.size, 2)
      assert_eq(ll.count { it > 3 }, 2)
    end
  end

  describe("PriorityQueue enumerable") do ->
    it("map and filter on heap data") do ->
      var pq = pq_new()
      pq.push(30)
      pq.push(10)
      pq.push(20)
      var doubled = pq.map { it * 2 }
      assert_eq(doubled.size, 3)
      var big = pq.filter { it >= 20 }
      assert_eq(big.size, 2)
    end

    it("reduce sums all") do ->
      var pq = pq_new()
      pq.push(5)
      pq.push(10)
      pq.push(15)
      assert_eq(pq.reduce(0, add_ints), 30)
    end
  end

  describe("SortedMap enumerable") do ->
    it("keys and values") do ->
      var m = sorted_map_new()
      m.set(3, 30)
      m.set(1, 10)
      m.set(2, 20)
      var ks = m.keys()
      assert_eq(ks.size, 3)
      assert_eq(ks[0], 1)
      assert_eq(ks[1], 2)
      assert_eq(ks[2], 3)
      var vs = m.values()
      assert_eq(vs[0], 10)
      assert_eq(vs[1], 20)
      assert_eq(vs[2], 30)
    end

    it("map over key-value pairs") do ->
      var m = sorted_map_new()
      m.set(1, 100)
      m.set(2, 200)
      var sums = m.map(kv_sum)
      assert_eq(sums[0], 101)
      assert_eq(sums[1], 202)
    end

    it("filter returns matching keys") do ->
      var m = sorted_map_new()
      m.set(1, 10)
      m.set(2, 20)
      m.set(3, 30)
      var big_val_keys = m.filter(kv_val_gt15)
      assert_eq(big_val_keys.size, 2)
      assert_eq(big_val_keys[0], 2)
      assert_eq(big_val_keys[1], 3)
    end

    it("reduce folds key-value pairs") do ->
      var m = sorted_map_new()
      m.set(1, 10)
      m.set(2, 20)
      m.set(3, 30)
      var total = m.reduce(0, sum_kv)
      assert_eq(total, 60)
    end

    it("find any? all? count") do ->
      var m = sorted_map_new()
      m.set(1, 10)
      m.set(2, 20)
      m.set(3, 30)
      assert_eq(m.find(kv_val_gt15), 2)
      assert_eq(m.any?(kv_key_eq3), true)
      assert_eq(m.any?(kv_key_eq5), false)
      assert_eq(m.all?(kv_val_gt0), true)
      assert_eq(m.all?(kv_val_gt15), false)
      assert_eq(m.count(kv_val_gte20), 2)
    end
  end

  return qspec_main()
end
