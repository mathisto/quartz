## TCP Spec — Tests for std/net/tcp
##
## Tests TCP client/server lifecycle: listen, connect, accept, read, write, close.
## Uses loopback (127.0.0.1) with ephemeral ports for reliable local testing.
##
## Contract:
##   1. TCP listen.
##   2. TCP connect.
##   3. TCP accept.
##   4. TCP write and read.
##   5. TCP socket options.
##   6. TCP error handling.

import * from qspec
import std/net/tcp

# =============================================================================
# Helpers
# =============================================================================

def _close(s: TcpStream): Void
  var _r = tcp_close(s)
end

def _close_listener(s: TcpListener): Void
  var _r = tcp_close_listener(s)
end

# --- Listen tests ---

def print_listen_ok(): Void
  match tcp_listen(0)
    Ok(server) => {
      if server.port > 0
        puts("listen_ok")
      else
        puts("bad_port")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

# --- Connect tests ---

def print_connect_ok(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          puts("connect_ok")
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

def print_connect_bad_host(): Void
  match tcp_connect("nonexistent.invalid", 80)
    Ok(client) => {
      puts("unexpected")
      _close(client)
    }
    Err(e) => puts("connect_refused")
  end
end

# --- Accept tests ---

def print_accept_ok(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              puts("accept_ok")
              _close(server_conn)
            }
            Err(e) => puts("accept_error")
          end
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

# --- Write/Read tests ---

def print_write_read(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              match tcp_write(client, "hello")
                Ok(n) => {
                  match tcp_read(server_conn, 1024)
                    Ok(data) => {
                      if data == "hello"
                        puts("write_read_ok")
                      else
                        puts("wrong_data")
                      end
                    }
                    Err(e) => puts("read_error")
                  end
                }
                Err(e) => puts("write_error")
              end
              _close(server_conn)
            }
            Err(e) => puts("accept_error")
          end
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

def print_bidirectional(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              # Client sends, server reads
              tcp_write(client, "ping")
              match tcp_read(server_conn, 1024)
                Ok(data) => {
                  if data == "ping"
                    # Server sends back, client reads
                    tcp_write(server_conn, "pong")
                    match tcp_read(client, 1024)
                      Ok(reply) => {
                        if reply == "pong"
                          puts("bidirectional_ok")
                        else
                          puts("wrong_reply")
                        end
                      }
                      Err(e) => puts("read_reply_error")
                    end
                  else
                    puts("wrong_data")
                  end
                }
                Err(e) => puts("read_error")
              end
              _close(server_conn)
            }
            Err(e) => puts("accept_error")
          end
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

def print_write_all(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              # Build a string larger than typical socket buffer
              var sb = sb_new()
              for i in 0..5000
                sb_append(sb, "A")
              end
              var big = sb_to_string(sb)
              match tcp_write_all(client, big)
                Ok(n) => {
                  _close(client)
                  # Read all from server side
                  var total_sb = sb_new()
                  var done = 0
                  while done == 0
                    match tcp_read(server_conn, 4096)
                      Ok(data) => {
                        if data.size == 0
                          done = 1
                        else
                          sb_append(total_sb, data)
                          0
                        end
                      }
                      Err(e) => {
                        done = 1
                      }
                    end
                  end
                  var total = sb_to_string(total_sb)
                  if total.size == 5000
                    puts("write_all_ok")
                  else
                    puts("write_all_short")
                  end
                }
                Err(e) => {
                  puts("write_all_error")
                  _close(client)
                }
              end
              _close(server_conn)
            }
            Err(e) => {
              puts("accept_error")
              _close(client)
            }
          end
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

def print_write_bytes_count(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              match tcp_write(client, "12345")
                Ok(n) => {
                  if n == 5
                    puts("bytes_count_ok")
                  else
                    puts("wrong_count")
                  end
                }
                Err(e) => puts("write_error")
              end
              _close(server_conn)
            }
            Err(e) => puts("accept_error")
          end
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

# --- Connect timeout test ---

def print_connect_timeout(): Void
  # Use non-routable IP to force a real timeout (not just connection refused)
  match tcp_connect_timeout("10.255.255.1", 80, 200)
    Ok(client) => {
      puts("unexpected")
      _close(client)
    }
    Err(e) => puts("timeout_or_refused")
  end
end

# --- Nodelay test ---

def print_nodelay(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          var r = tcp_set_nodelay(client)
          if r == 0
            puts("nodelay_ok")
          else
            puts("nodelay_failed")
          end
          _close(client)
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

# --- Closed stream tests ---

def print_write_closed(): Void
  match tcp_listen(0)
    Ok(server) => {
      match tcp_connect("127.0.0.1", server.port)
        Ok(client) => {
          match tcp_accept(server)
            Ok(server_conn) => {
              _close(server_conn)
              0
            }
            Err(e) => 0
          end
          _close(client)
          # Stream is now closed (connected=0 after close)
          # Create a fresh stream struct with connected=0 to test the guard
          var closed = TcpStream { fd: -1, host: "", port: 0, connected: 0 }
          match tcp_write(closed, "test")
            Ok(n) => puts("unexpected")
            Err(e) => puts("write_closed_ok")
          end
        }
        Err(e) => puts("connect_error")
      end
      _close_listener(server)
    }
    Err(e) => puts("listen_error")
  end
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("TCP listen") do ->
    it("listens on ephemeral port and returns port > 0") do ->
      assert_output("listen_ok\n", print_listen_ok)
    end
  end

  describe("TCP connect") do ->
    it("connects to a listening server on loopback") do ->
      assert_output("connect_ok\n", print_connect_ok)
    end

    it("returns error for non-existent host") do ->
      assert_output("connect_refused\n", print_connect_bad_host)
    end

    it("returns error with timeout on refused connection") do ->
      assert_output("timeout_or_refused\n", print_connect_timeout)
    end
  end

  describe("TCP accept") do ->
    it("accepts a connection from a client") do ->
      assert_output("accept_ok\n", print_accept_ok)
    end
  end

  describe("TCP write and read") do ->
    it("writes data from client and reads on server side") do ->
      assert_output("write_read_ok\n", print_write_read)
    end

    it("supports bidirectional communication") do ->
      assert_output("bidirectional_ok\n", print_bidirectional)
    end

    it("returns correct byte count from write") do ->
      assert_output("bytes_count_ok\n", print_write_bytes_count)
    end

    it("writes and reads large data with tcp_write_all") do ->
      assert_output("write_all_ok\n", print_write_all)
    end
  end

  describe("TCP socket options") do ->
    it("sets TCP_NODELAY successfully") do ->
      assert_output("nodelay_ok\n", print_nodelay)
    end
  end

  describe("TCP error handling") do ->
    it("returns error writing to closed stream") do ->
      assert_output("write_closed_ok\n", print_write_closed)
    end
  end

  return qspec_main()
end
