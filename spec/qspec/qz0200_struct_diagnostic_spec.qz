## Regression spec for QZ0200_DIAG_FORMATS_STRUCT_PTYPES_AS_UNKNOWN.
##
## Pre-fix, QZ0200 type-mismatch diagnostics that involved a TYPE_STRUCT
## ptype on either side rendered the type as the literal string "unknown",
## producing useless messages like:
##
##   error[QZ0200]: Field b: expected unknown, got unknown
##
## Post-fix, the formatter reads the cached struct name from the ptype
## (stamped at typecheck.qz user-struct-ptype creation) and renders the
## type as "Box<Inner>", so the user can see what actually mismatched.
import * from qspec

def main(): Int
  describe("QZ0200 diagnostic formatting for struct ptypes") do ->
    it("renders generic-struct field-init mismatch with struct name + type args") do ->
      assert_compile_error("""
        struct Box<T>
          val: T
        end

        struct Container
          b: Box<Int>
        end

        def main(): Int
          var b: Box<String> = Box { val: "hello" }
          var c = Container { b: b }
          return 0
        end
        """, "Box<Int>")
    end

    it("renders the actual-side struct name in QZ0200 messages") do ->
      assert_compile_error("""
        struct Box<T>
          val: T
        end

        struct Container
          b: Box<Int>
        end

        def main(): Int
          var b: Box<String> = Box { val: "hello" }
          var c = Container { b: b }
          return 0
        end
        """, "Box<String>")
    end

    it("never falls back to the literal 'unknown' for struct ptypes") do ->
      # Negative assertion: the bad-message text must NOT appear.
      # We piggyback on the same repro and just check the "expected unknown"
      # tautology is gone — assert_compile_error matches a substring that
      # MUST be present, so we use the non-presence pattern by asserting
      # the corrected text is present.
      assert_compile_error("""
        struct Box<T>
          val: T
        end

        struct Container
          b: Box<Int>
        end

        def main(): Int
          var b: Box<String> = Box { val: "hello" }
          var c = Container { b: b }
          return 0
        end
        """, "expected Box<Int>, got Box<String>")
    end
  end

  return qspec_main()
end
