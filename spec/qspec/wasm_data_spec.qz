## WASM Data Structure & Operations Tests
##
## Tests for closures, string ops, vec ops, string builder,
## option ops, map ops, char classification, bitwise ops.

import * from qspec

extern "C" def getpid(): CInt

var _wd_tid = 0

def _wd_run(source: String): Int
  _wd_tid += 1
  var pid = getpid()
  var src = "/tmp/_wd_#{pid}_#{_wd_tid}.qz"
  var wasm = "/tmp/_wd_#{pid}_#{_wd_tid}.wasm"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return -1
  end
  var rr = system("wasmtime #{wasm} 2>/dev/null")
  return rr / 256
end

def _wd_capture(source: String): String
  _wd_tid += 1
  var pid = getpid()
  var src = "/tmp/_wd_#{pid}_#{_wd_tid}.qz"
  var wasm = "/tmp/_wd_#{pid}_#{_wd_tid}.wasm"
  var out = "/tmp/_wd_#{pid}_#{_wd_tid}.out"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return "COMPILE_FAILED"
  end
  var rr = system("wasmtime #{wasm} >#{out} 2>/dev/null")
  return read_file(out)
end

def _wd_wasm_available(): Bool
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var pid = getpid()
  var probe = "/tmp/_wd_probe_#{pid}.qz"
  var probe_wasm = "/tmp/_wd_probe_#{pid}.wasm"
  write_file(probe, "def main(): Int = 0\n")
  var rc = system("#{compiler} --backend wasm --no-cache -I . -I std #{probe} -o #{probe_wasm} 2>/dev/null")
  return rc == 0
end

def main(): Int
  if _wd_wasm_available() == false
    puts("[skip] wasm_data_spec: set QUARTZ_COMPILER to a --feature wasm build to run")
    return qspec_exclude_feature("wasm")
  end
  describe("WASM closures") do ->
    it("function reference via call_indirect") do ->
      var s = """
        def double(x: Int): Int
          return x * 2
        end
        def apply(f: Fn(Int): Int, x: Int): Int
          return f(x)
        end
        def main(): Int
          return apply(double, 21)
        end
        """
      assert_eq(_wd_run(s), 42)
    end
    it("closure captures variable") do ->
      var s = """
        def make_adder(n: Int): Fn(Int): Int
          return x -> x + n
        end
        def main(): Int
          var add5 = make_adder(5)
          return add5(37)
        end
        """
      assert_eq(_wd_run(s), 42)
    end
    it("function composition") do ->
      var s = """
        def compose(f: Fn(Int): Int, g: Fn(Int): Int): Fn(Int): Int
          return x -> f(g(x))
        end
        def double(x: Int): Int = x * 2
        def inc(x: Int): Int = x + 1
        def main(): Int
          var f = compose(double, inc)
          return f(20)
        end
        """
      assert_eq(_wd_run(s), 42)
    end
  end

  describe("WASM bitwise ops") do ->
    it("and/or/xor") do ->
      var s = """
        def main(): Int
          var a = band(255, 15)
          var b = bor(a, 32)
          return b
        end
        """
      assert_eq(_wd_run(s), 47)
    end
    it("shift left/right") do ->
      var s = """
        def main(): Int
          var a = shl(1, 5)
          var b = shr(a, 3)
          return b
        end
        """
      assert_eq(_wd_run(s), 4)
    end
  end

  describe("WASM string ops") do ->
    it("str_concat") do ->
      var s = """
        def main(): Int
          puts(str_concat("hello ", "world"))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "hello world\n")
    end
    it("to_str positive") do ->
      var s = """
        def main(): Int
          puts(to_str(42))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "42\n")
    end
    it("to_str negative") do ->
      var s = """
        def main(): Int
          puts(to_str(-99))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "-99\n")
    end
    it("to_str zero") do ->
      var s = """
        def main(): Int
          puts(to_str(0))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "0\n")
    end
    it("str_eq true") do ->
      var s = """
        def main(): Int
          if str_eq("abc", "abc")
            return 1
          end
          return 0
        end
        """
      assert_eq(_wd_run(s), 1)
    end
    it("str_eq false") do ->
      var s = """
        def main(): Int
          if str_eq("abc", "xyz")
            return 1
          end
          return 0
        end
        """
      assert_eq(_wd_run(s), 0)
    end
    it("str_starts_with") do ->
      var s = """
        def main(): Int
          if str_starts_with("hello world", "hello")
            return 1
          end
          return 0
        end
        """
      assert_eq(_wd_run(s), 1)
    end
    it("str_from_char") do ->
      var s = """
        def main(): Int
          puts(str_from_char(65))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "A\n")
    end
    it("str_is_empty true") do ->
      var s = """
        def main(): Int
          if str_is_empty("")
            return 1
          end
          return 0
        end
        """
      assert_eq(_wd_run(s), 1)
    end
  end

  describe("WASM vec ops") do ->
    it("new + push + get") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          return vec_get(v, 0)
        end
        """
      assert_eq(_wd_run(s), 42)
    end
    it("size after pushes") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 1)
          vec_push(v, 2)
          vec_push(v, 3)
          return vec_size(v)
        end
        """
      assert_eq(_wd_run(s), 3)
    end
    it("pop") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          var x = vec_pop(v)
          return x + vec_size(v)
        end
        """
      assert_eq(_wd_run(s), 21)
    end
    it("contains") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          return vec_contains(v, 20)
        end
        """
      assert_eq(_wd_run(s), 1)
    end
  end

  describe("WASM string builder") do ->
    it("sb basic") do ->
      var s = """
        def main(): Int
          var sb = sb_new()
          sb_append(sb, "hello")
          sb_append(sb, " world")
          puts(sb_to_string(sb))
          return 0
        end
        """
      assert_eq_str(_wd_capture(s), "hello world\n")
    end
  end

  describe("WASM option ops") do ->
    it("option_some + get") do ->
      var s = """
        def main(): Int
          var opt = option_some(42)
          return option_get(opt)
        end
        """
      assert_eq(_wd_run(s), 42)
    end
    it("option_is_some") do ->
      var s = """
        def main(): Int
          var s = option_some(1)
          var n = option_none()
          return option_is_some(s) + option_is_some(n)
        end
        """
      assert_eq(_wd_run(s), 1)
    end
  end

  describe("WASM map ops") do ->
    it("set + get") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set("x", 42)
          return m.get("x")
        end
        """
      assert_eq(_wd_run(s), 42)
    end
    it("has + size") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set("a", 1)
          m.set("b", 2)
          return m.has("a") + m.size()
        end
        """
      assert_eq(_wd_run(s), 3)
    end
    it("del") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set("k", 10)
          m.delete("k")
          return m.has("k")
        end
        """
      assert_eq(_wd_run(s), 0)
    end
    it("overwrite") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set("x", 1)
          m.set("x", 99)
          return m.get("x")
        end
        """
      assert_eq(_wd_run(s), 99)
    end
  end

  describe("WASM char class") do ->
    it("is_digit") do ->
      var s = """
        def main(): Int
          return is_digit(48) + is_digit(65)
        end
        """
      assert_eq(_wd_run(s), 1)
    end
    it("is_alpha") do ->
      var s = """
        def main(): Int
          return is_alpha(65) + is_alpha(97) + is_alpha(48)
        end
        """
      assert_eq(_wd_run(s), 2)
    end
  end

  return qspec_main()
end
