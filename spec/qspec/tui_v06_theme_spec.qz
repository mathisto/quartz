## QSpec coverage for std/tui/theme.qz Phase 6.8 — Base16/Base24 YAML
## loader + bundled themes.
##
## Phase 6.0 already covered the Theme struct, the 12 semantic accessors,
## and `theme_catppuccin_mocha`. This spec adds:
##
##   - 10 new bundled theme constructors (Catppuccin Latte, Gruvbox
##     Dark/Light Hard, Tokyo Night Dark, Nord, Dracula, Solarized
##     Dark/Light, Rosé Pine Moon, Everforest Dark) — verified against
##     canonical tinted-theming/schemes Base16 YAMLs.
##   - YAML parser surface: `theme_from_string` round-trips a canonical
##     Catppuccin Mocha document to the same Theme as the bundled
##     constructor.
##   - Parser handles spec-0.11 (palette-block) and spec-0.10 (flat)
##     layouts, comments, quoted hex values, missing slots, bad hex.
##   - Base24 extension acceptance + rejection of partial sets.
##
## See docs/design/TUI_V06_CELL_ENGINE.md D8 for the canonical scheme
## sources. Hex values match github.com/tinted-theming/schemes/base16.

import * from qspec
import std/tui/theme as th
import style

# =============================================================================
# Sample YAML documents
# =============================================================================
# Each helper returns the canonical YAML (or a deliberate variant) as a
# String. Using helpers instead of inline triple-quoted heredocs avoids
# the spec-time interpolation pitfall recorded in
# `feedback_triple_quoted_interp_in_specs.md`.

def yaml_catppuccin_mocha_palette(): String
  var sb = sb_new()
  sb.append("system: \"base16\"\n")
  sb.append("name: \"Catppuccin Mocha\"\n")
  sb.append("author: \"Catppuccin Team\"\n")
  sb.append("variant: \"dark\"\n")
  sb.append("palette:\n")
  sb.append("  base00: \"#1e1e2e\" # base\n")
  sb.append("  base01: \"#181825\" # mantle\n")
  sb.append("  base02: \"#313244\" # surface0\n")
  sb.append("  base03: \"#45475a\" # surface1\n")
  sb.append("  base04: \"#585b70\" # surface2\n")
  sb.append("  base05: \"#cdd6f4\" # text\n")
  sb.append("  base06: \"#f5e0dc\" # rosewater\n")
  sb.append("  base07: \"#b4befe\" # lavender\n")
  sb.append("  base08: \"#f38ba8\" # red\n")
  sb.append("  base09: \"#fab387\" # peach\n")
  sb.append("  base0A: \"#f9e2af\" # yellow\n")
  sb.append("  base0B: \"#a6e3a1\" # green\n")
  sb.append("  base0C: \"#94e2d5\" # teal\n")
  sb.append("  base0D: \"#89b4fa\" # blue\n")
  sb.append("  base0E: \"#cba6f7\" # mauve\n")
  sb.append("  base0F: \"#f2cdcd\" # flamingo\n")
  return sb.to_string()
end

def yaml_flat_minimal(): String
  # spec-0.10 flat layout (no palette: block), unquoted hex without leading #.
  var sb = sb_new()
  sb.append("name: Flat Test\n")
  sb.append("variant: light\n")
  sb.append("base00: f0f0f0\n")
  sb.append("base01: e0e0e0\n")
  sb.append("base02: d0d0d0\n")
  sb.append("base03: c0c0c0\n")
  sb.append("base04: b0b0b0\n")
  sb.append("base05: a0a0a0\n")
  sb.append("base06: 909090\n")
  sb.append("base07: 808080\n")
  sb.append("base08: ff0000\n")
  sb.append("base09: ff8800\n")
  sb.append("base0A: ffff00\n")
  sb.append("base0B: 00ff00\n")
  sb.append("base0C: 00ffff\n")
  sb.append("base0D: 0088ff\n")
  sb.append("base0E: 8800ff\n")
  sb.append("base0F: 884400\n")
  return sb.to_string()
end

def yaml_with_base24(): String
  # Adds the optional Base24 extension to the flat minimal palette.
  var sb = sb_new()
  sb.append(yaml_flat_minimal())
  sb.append("base10: ff4444\n")
  sb.append("base11: ffaa44\n")
  sb.append("base12: ffff44\n")
  sb.append("base13: 44ff44\n")
  sb.append("base14: 44ffff\n")
  sb.append("base15: 44aaff\n")
  sb.append("base16: aa44ff\n")
  sb.append("base17: aa6644\n")
  return sb.to_string()
end

def yaml_partial_base24(): String
  # Sets only some Base24 slots — must be rejected.
  var sb = sb_new()
  sb.append(yaml_flat_minimal())
  sb.append("base10: ff4444\n")
  sb.append("base11: ffaa44\n")
  return sb.to_string()
end

def yaml_missing_base05(): String
  var sb = sb_new()
  sb.append("name: Missing\n")
  sb.append("variant: dark\n")
  sb.append("base00: 111111\n")
  sb.append("base01: 222222\n")
  sb.append("base02: 333333\n")
  sb.append("base03: 444444\n")
  sb.append("base04: 555555\n")
  # base05 deliberately omitted
  sb.append("base06: 777777\n")
  sb.append("base07: 888888\n")
  sb.append("base08: aaaaaa\n")
  sb.append("base09: bbbbbb\n")
  sb.append("base0A: cccccc\n")
  sb.append("base0B: dddddd\n")
  sb.append("base0C: eeeeee\n")
  sb.append("base0D: ffffff\n")
  sb.append("base0E: 00aabb\n")
  sb.append("base0F: ccddee\n")
  return sb.to_string()
end

def yaml_bad_hex(): String
  var sb = sb_new()
  sb.append("name: BadHex\n")
  sb.append("variant: dark\n")
  sb.append("base00: \"zzzzzz\"\n")
  return sb.to_string()
end

def yaml_short_hex(): String
  var sb = sb_new()
  sb.append("name: ShortHex\n")
  sb.append("variant: dark\n")
  sb.append("base00: \"abc\"\n")
  return sb.to_string()
end

# =============================================================================
# Spec body
# =============================================================================

def main(): Int
  describe("th::theme_catppuccin_latte") do ->
    it("name + Light variant + canonical hex slots") do ->
      var t = th::theme_catppuccin_latte()
      assert_eq_str(t.name, "Catppuccin Latte")
      if t.variant is Light
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("eff1f5"))
      assert_eq(t.base05, hex_color("4c4f69"))
      assert_eq(t.base08, hex_color("d20f39"))
      assert_eq(t.base0B, hex_color("40a02b"))
      assert_eq(t.base0D, hex_color("1e66f5"))
      assert_eq(t.base0E, hex_color("8839ef"))
    end
  end

  describe("th::theme_gruvbox_dark_hard") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_gruvbox_dark_hard()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("1d2021"))
      assert_eq(t.base05, hex_color("d5c4a1"))
      assert_eq(t.base08, hex_color("fb4934"))
      assert_eq(t.base0B, hex_color("b8bb26"))
      assert_eq(t.base0F, hex_color("d65d0e"))
    end
  end

  describe("th::theme_gruvbox_light_hard") do ->
    it("Light variant + canonical hex slots") do ->
      var t = th::theme_gruvbox_light_hard()
      if t.variant is Light
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("f9f5d7"))
      assert_eq(t.base05, hex_color("504945"))
      assert_eq(t.base08, hex_color("9d0006"))
    end
  end

  describe("th::theme_tokyo_night_dark") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_tokyo_night_dark()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("1A1B26"))
      assert_eq(t.base05, hex_color("A9B1D6"))
      assert_eq(t.base0E, hex_color("BB9AF7"))
    end
  end

  describe("th::theme_nord") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_nord()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("2E3440"))
      assert_eq(t.base08, hex_color("BF616A"))
      assert_eq(t.base0D, hex_color("81A1C1"))
    end
  end

  describe("th::theme_dracula") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_dracula()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("282a36"))
      assert_eq(t.base05, hex_color("f8f8f2"))
      assert_eq(t.base08, hex_color("ff5555"))
      assert_eq(t.base0E, hex_color("ff79c6"))
    end
  end

  describe("th::theme_solarized_dark") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_solarized_dark()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("002b36"))
      assert_eq(t.base05, hex_color("93a1a1"))
      assert_eq(t.base0D, hex_color("268bd2"))
    end
  end

  describe("th::theme_solarized_light") do ->
    it("Light variant + base00/base07 inversion vs dark") do ->
      var t = th::theme_solarized_light()
      if t.variant is Light
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var dark = th::theme_solarized_dark()
      # The 8 neutrals are inverted (00↔07, 01↔06, 02↔05, 03↔04) in the
      # light/dark pair; the 8 accents are identical.
      assert_eq(t.base00, dark.base07)
      assert_eq(t.base07, dark.base00)
      assert_eq(t.base08, dark.base08)
    end
  end

  describe("th::theme_rose_pine_moon") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_rose_pine_moon()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("232136"))
      assert_eq(t.base05, hex_color("e0def4"))
      assert_eq(t.base08, hex_color("eb6f92"))
    end
  end

  describe("th::theme_everforest_dark") do ->
    it("Dark variant + canonical hex slots") do ->
      var t = th::theme_everforest_dark()
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("2d353b"))
      assert_eq(t.base05, hex_color("d3c6aa"))
      assert_eq(t.base0B, hex_color("a7c080"))
    end
  end

  describe("th::theme_from_string — palette-block (spec-0.11)") do ->
    it("round-trips canonical Catppuccin Mocha YAML to the bundled theme") do ->
      var yaml = yaml_catppuccin_mocha_palette()
      var res = th::theme_from_string(yaml)
      if res is Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var t = res.unwrap_ok()
      var bundled = th::theme_catppuccin_mocha()
      assert_eq_str(t.name, "Catppuccin Mocha")
      if t.variant is Dark
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Every base slot equals the bundled constant — the YAML is the
      # canonical source the bundled constructor was transcribed from.
      assert_eq(t.base00, bundled.base00)
      assert_eq(t.base01, bundled.base01)
      assert_eq(t.base02, bundled.base02)
      assert_eq(t.base03, bundled.base03)
      assert_eq(t.base04, bundled.base04)
      assert_eq(t.base05, bundled.base05)
      assert_eq(t.base06, bundled.base06)
      assert_eq(t.base07, bundled.base07)
      assert_eq(t.base08, bundled.base08)
      assert_eq(t.base09, bundled.base09)
      assert_eq(t.base0A, bundled.base0A)
      assert_eq(t.base0B, bundled.base0B)
      assert_eq(t.base0C, bundled.base0C)
      assert_eq(t.base0D, bundled.base0D)
      assert_eq(t.base0E, bundled.base0E)
      assert_eq(t.base0F, bundled.base0F)
      if t.base10_17 is None
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("th::theme_from_string — flat (spec-0.10)") do ->
    it("accepts unquoted hex without leading # and Light variant") do ->
      var res = th::theme_from_string(yaml_flat_minimal())
      if res is Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var t = res.unwrap_ok()
      assert_eq_str(t.name, "Flat Test")
      if t.variant is Light
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      assert_eq(t.base00, hex_color("f0f0f0"))
      assert_eq(t.base08, hex_color("ff0000"))
      assert_eq(t.base0F, hex_color("884400"))
    end
  end

  describe("th::theme_from_string — Base24 extension") do ->
    it("populates base10_17 when all 8 ext slots are present") do ->
      var res = th::theme_from_string(yaml_with_base24())
      if res is Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var t = res.unwrap_ok()
      if t.base10_17 is Some
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var ext = t.base10_17.unwrap()
      assert_eq(ext.base10, hex_color("ff4444"))
      assert_eq(ext.base17, hex_color("aa6644"))
    end

    it("rejects a partial Base24 set as a parse error") do ->
      var res = th::theme_from_string(yaml_partial_base24())
      if res is Err
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("th::theme_from_string — error paths") do ->
    it("rejects a YAML missing a required base slot") do ->
      var res = th::theme_from_string(yaml_missing_base05())
      if res is Err
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("rejects a YAML with non-hex characters in a base value") do ->
      var res = th::theme_from_string(yaml_bad_hex())
      if res is Err
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("rejects a YAML with a hex value that isn't 6 chars") do ->
      var res = th::theme_from_string(yaml_short_hex())
      if res is Err
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("th::theme_from_string — comment + quote handling") do ->
    it("strips end-of-line comments outside quoted strings") do ->
      # Hex value inside quotes must NOT be cut off as a comment.
      var sb = sb_new()
      sb.append("name: Comments # this is a name comment\n")
      sb.append("variant: dark\n")
      sb.append("palette:\n")
      sb.append("  base00: \"#101010\" # background\n")
      sb.append("  base01: \"#202020\"\n")
      sb.append("  base02: \"#303030\"\n")
      sb.append("  base03: \"#404040\"\n")
      sb.append("  base04: \"#505050\"\n")
      sb.append("  base05: \"#606060\"\n")
      sb.append("  base06: \"#707070\"\n")
      sb.append("  base07: \"#808080\"\n")
      sb.append("  base08: \"#900000\"\n")
      sb.append("  base09: \"#a00000\"\n")
      sb.append("  base0A: \"#b00000\"\n")
      sb.append("  base0B: \"#c00000\"\n")
      sb.append("  base0C: \"#d00000\"\n")
      sb.append("  base0D: \"#e00000\"\n")
      sb.append("  base0E: \"#f00000\"\n")
      sb.append("  base0F: \"#0000f0\"\n")
      var res = th::theme_from_string(sb.to_string())
      if res is Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      var t = res.unwrap_ok()
      assert_eq_str(t.name, "Comments")
      assert_eq(t.base00, hex_color("101010"))
    end
  end

  describe("th::_theme_base_slot_index — internal slot key parser") do ->
    # These exercise the internal helper through the parser surface (not
    # exported directly). Indirect via a YAML doc that uses `base17` —
    # the highest valid Base24 slot.
    it("treats base17 as a valid slot (extension upper bound)") do ->
      var res = th::theme_from_string(yaml_with_base24())
      if res is Ok
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("th::theme_from_string — trailing semantic accessor parity") do ->
    it("YAML-loaded theme works through theme_fg / theme_error / theme_info") do ->
      var res = th::theme_from_string(yaml_catppuccin_mocha_palette())
      var t = res.unwrap_ok()
      var bundled = th::theme_catppuccin_mocha()
      assert_eq(th::theme_fg(t),    th::theme_fg(bundled))
      assert_eq(th::theme_error(t), th::theme_error(bundled))
      assert_eq(th::theme_info(t),  th::theme_info(bundled))
      assert_eq(th::theme_special(t), th::theme_special(bundled))
    end
  end

  return qspec_main()
end
