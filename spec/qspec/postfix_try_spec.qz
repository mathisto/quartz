## $try() Macro Tests
## Tests try-unwrap via the $try() macro on Option and Result types.
## Postfix `?` was deliberately removed in v5.12.27 in favor of $try() —
## the lexer rule that glues `?` into identifiers (which makes predicate
## methods like `.some?`/`.none?`/`.empty?` work) is incompatible with
## a standalone postfix `?` operator. The $try() macro is the canonical
## try-unwrap form. This spec also verifies the predicate methods still
## work alongside it.

import * from qspec

def try_option(opt: Option<Int>): Option<Int>
  var val = try opt
  return Option::Some(val * 2)
end

def try_result(res: Result<Int, String>): Result<Int, String>
  var val = try res
  return Result::Ok(val + 1)
end

def print_try_some(): Void
  var opt = Option::Some(42)
  var result = try_option(opt)
  puts(result.unwrap().to_s())
end

def print_try_none(): Void
  var opt = Option::None
  var result = try_option(opt)
  if result.is_none()
    puts("none")
  else
    puts("unexpected")
  end
end

def main(): Int
  describe("$try() try-unwrap") do ->
    it("unwraps Some and continues") do ->
      assert_output("84\n", print_try_some)
    end

    it("short-circuits on None") do ->
      assert_output("none\n", print_try_none)
    end

    it("works with Result Ok") do ->
      var res = try_result(Result::Ok(10))
      assert_eq(res.unwrap(), 11)
    end
  end

  describe("predicate methods still work") do ->
    it("v.empty? on empty vec") do ->
      var v = vec_new()
      assert_eq(v.empty?, true)
    end

    it("v.empty? on non-empty vec") do ->
      var v = [1, 2, 3]
      assert_eq(v.empty?, false)
    end

    it("opt.some? on Some") do ->
      var opt = Option::Some(42)
      assert_eq(opt.some?, true)
    end

    it("opt.none? on None") do ->
      var opt = Option::None
      assert_eq(opt.none?, true)
    end

    it("ch.digit? on digit") do ->
      assert_eq('5'.digit?, true)
    end

    it("ch.alpha? on letter") do ->
      assert_eq('A'.alpha?, true)
    end
  end

  return qspec_main()
end
