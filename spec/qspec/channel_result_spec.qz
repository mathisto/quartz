import * from qspec
import * from std/sync/communication/channel

# --- recv_safe tests ---

def test_recv_safe_ok(): Void
  var ch = channel_new(1)
  send(ch, 42)
  var r = recv_safe(ch)
  match r
    Ok(v) => puts(to_str(v))
    Err(e) => puts("err")
  end
  channel_close(ch)
end

def test_recv_safe_closed(): Void
  var ch = channel_new(1)
  channel_close(ch)
  var r = recv_safe(ch)
  match r
    Ok(v) => puts("unexpected")
    Err(e) => puts("closed #{to_str(e)}")
  end
end

def test_try_recv_safe_empty(): Void
  var ch = channel_new(1)
  var r = try_recv_safe(ch)
  match r
    Ok(v) => puts("unexpected")
    Err(e) => puts("would-block #{to_str(e)}")
  end
  channel_close(ch)
end

def test_recv_safe_neg1(): Void
  var ch = channel_new(1)
  send(ch, -1)
  var r = recv_safe(ch)
  match r
    Ok(v) => puts(to_str(v))
    Err(e) => puts("err")
  end
  channel_close(ch)
end

def test_recv_safe_zero(): Void
  var ch = channel_new(1)
  send(ch, 0)
  var r = recv_safe(ch)
  match r
    Ok(v) => puts("ok #{to_str(v)}")
    Err(e) => puts("err")
  end
  channel_close(ch)
end

def async_recv_producer(ch: Int): Int
  send(ch, 88)
  return 0
end

def test_async_recv_safe_ok(): Void
  sched_init(0)
  var ch = channel_new(1)
  var h = go async_recv_producer(ch)
  var r = async_recv_safe(ch)
  await h
  sched_shutdown()
  match r
    Ok(v) => puts(to_str(v))
    Err(e) => puts("err")
  end
  channel_close(ch)
end

def main(): Int
  describe("Result-based channel recv") do ->

    it("recv_safe returns Ok on success") do ->
      assert_output("42\n", test_recv_safe_ok)
    end

    it("recv_safe returns Err(0) on closed") do ->
      assert_output("closed 0\n", test_recv_safe_closed)
    end

    it("try_recv_safe returns Err(1) on empty") do ->
      assert_output("would-block 1\n", test_try_recv_safe_empty)
    end

    it("recv_safe handles value -1 correctly") do ->
      assert_output("-1\n", test_recv_safe_neg1)
    end

    it("recv_safe handles value 0 correctly") do ->
      assert_output("ok 0\n", test_recv_safe_zero)
    end

    it("async_recv_safe returns Ok from scheduler task") do ->
      assert_output("88\n", test_async_recv_safe_ok)
    end

  end

  return qspec_main()
end
