## Effect-Op Call Detection + QZ0611 — C.3 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.3).
## Verifies that calls whose name matches a registered effect
## declaration's operation are intercepted as op invocations rather
## than regular function calls. The op's effect label must be present
## in the caller's `can` row OR on the handler-effect stack; otherwise
## QZ0611 fires.
##
## Detection rule (C.3): `tc_lookup_effect_op(tc, name)` scans all
## registered effect decls' op-name tables. First-match wins. Ops take
## precedence over regular function dispatch. Untracked callers (no
## `can`) calling an op outside any handler → QZ0611 (conservative
## pending C.6's default main-handler injection).
##
## This spec covers the 5 cases from B.7's original deferred list plus
## 2 extras (open-tail caller absorbs op effect; untracked caller
## without handler fires QZ0611).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect-op call detection (piezo C.3) — QZ0611") do ->
    it("bare op inside `can` that covers it — compiles") do ->
      assert_compile_succeeds("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("x")
def main(): Int = risky()
""")
    end

    it("bare op inside `with` that handles it — compiles") do ->
      assert_compile_succeeds("""
effect Throws
  def throw(msg: String): Int
end

def safe(): Int can = with Throws do ->
  throw("x")
end

def main(): Int = safe()
""")
    end

    it("op call outside both `can` and `with` — QZ0611") do ->
      # D.4 registered default handlers for the blessed set (Throws, Log),
      # so those effects no longer fire QZ0611 on uncovered calls. This
      # test uses a non-blessed effect (Panic) to exercise the QZ0611
      # path — user-declared effects still need explicit coverage.
      assert_compile_error("""
effect Panic
  def raise(msg: String): Int
end

def leaky(): Int can = raise("x")
def main(): Int = leaky()
""", "QZ0611")
    end

    it("op call at top-level untracked main — QZ0611 for non-blessed effect") do ->
      # After D.4: blessed effects (Throws, Log) are covered by default
      # handlers and don't fire QZ0611 here. Non-blessed effects (like
      # Panic) still do.
      assert_compile_error("""
effect Panic
  def raise(msg: String): Int
end

def main(): Int = raise("x")
""", "QZ0611")
    end

    it("nested `with`s — inner op covered by outer handler") do ->
      assert_compile_succeeds("""
effect Log
  def emit(s: String): Int
end
effect Throws
  def throw(msg: String): Int
end

def nested(): Int can = with Log do ->
  with Throws do ->
    emit("hi")
  end
end

def main(): Int = nested()
""")
    end

    it("open-tail caller absorbs op's effect via row extension") do ->
      assert_compile_succeeds("""
effect Log
  def emit(s: String): Int
end

def chatty(): Int can | r = emit("hello")
def main(): Int = chatty()
""")
    end

    it("closed caller with wrong effect — QZ0611 on uncovered op") do ->
      # Uses non-blessed effect names (Left/Right) so D.4's blessed-set
      # relaxation doesn't absorb the negative case.
      assert_compile_error("""
effect Left
  def lop(): Int
end
effect Right
  def rop(): Int
end

def confused(): Int can Left = rop()
def main(): Int = confused()
""", "QZ0611")
    end

    it("op call inside `with OtherEffect` but op's effect is not handled — QZ0611") do ->
      # Non-blessed effects again — blessed effects get absorbed by
      # the D.4 default-handler relaxation and don't fire QZ0611.
      assert_compile_error("""
effect Alpha
  def aop(): Int
end
effect Beta
  def bop(): Int
end

def misdirected(): Int can = with Alpha do ->
  bop()
end
def main(): Int = misdirected()
""", "QZ0611")
    end
  end
  return qspec_main()
end
