## Property-Based Laws (TEST.2 Phase 5)
##
## Contract: Algebraic laws and invariants as executable specifications.
## Each test checks a mathematical property over random inputs.
##
##   1. Arithmetic laws (commutativity, identity, annihilator).
##   2. String laws (length additivity).
##   3. Vec laws (push/get roundtrip, size monotonicity).
##   4. Option laws (some/none unwrap).
##   5. Boolean laws (De Morgan, double negation).
##   6. Bitwise laws (complement, XOR).
##   7. Map laws (set/get roundtrip).

import * from qspec
import * from qspec/property

def main(): Int
  # ==========================================================================
  # Arithmetic Laws
  # ==========================================================================
  describe("arithmetic laws") do ->
    it("isolates property matcher accounting for both arities") do ->
      var result = subprocess_run(read_file("spec/qspec/runner_fixtures/property_accounting.qz"))
      if result.exit_code != 0
        puts(result.stderr_content + result.stdout_content)
      end
      assert_eq(result.exit_code, 0)
    end

    property_commutative("addition is commutative", prop_add)
    property_commutative("multiplication is commutative", prop_mul)
    property_identity("additive identity: n + 0 = n", prop_add, 0)
    property_identity("multiplicative identity: n * 1 = n", prop_mul, 1)

    forall_i("multiplicative annihilator: n * 0 = 0") do x: Int ->
      assert_eq(x * 0, 0)
    end

    forall_ii("distributive: a * (b + c) = a*b + a*c") do a: Int, b: Int ->
      var c = a % 97 + 1
      assert_eq(a * (b + c), a * b + a * c)
    end

    forall_i("subtraction self-inverse: n - n = 0") do x: Int ->
      assert_eq(x - x, 0)
    end

    forall_i("double via addition: n + n = 2 * n") do x: Int ->
      assert_eq(x + x, 2 * x)
    end
  end

  # ==========================================================================
  # String Laws
  # ==========================================================================
  describe("string laws") do ->
    it("length of concatenation is sum of lengths") do ->
      a = "hello"
      b = "world"
      assert_eq(str_byte_len(a + b), str_byte_len(a) + str_byte_len(b))
    end

    it("empty string is identity for concatenation") do ->
      s = "test"
      assert_eq_str(s + "", s)
      assert_eq_str("" + s, s)
    end

    it("empty string has length 0") do ->
      assert_eq(str_byte_len(""), 0)
    end
  end

  # ==========================================================================
  # Vec Laws
  # ==========================================================================
  describe("vec laws") do ->
    it("push/get roundtrip preserves value") do ->
      var v = vec_new()
      v.push(42)
      assert_eq(v[0], 42)
    end

    it("push increases size by 1") do ->
      var v = vec_new()
      assert_eq(v.size, 0)
      v.push(1)
      assert_eq(v.size, 1)
      v.push(2)
      assert_eq(v.size, 2)
    end

    forall_i("push/get roundtrip: vec[0] == pushed value") do x: Int ->
      var v = vec_new()
      v.push(x)
      assert_eq(v[0], x)
    end

    forall_i("size monotonicity: push always increases size") do x: Int ->
      var v = vec_new()
      var before = v.size
      v.push(x)
      qspec_assert(v.size > before)
    end
  end

  # ==========================================================================
  # Option Laws
  # ==========================================================================
  describe("option laws") do ->
    forall_i("some(x) ?? d == x") do x: Int ->
      assert_eq(option_some(x) ?? 0, x)
    end

    it("none() ?? d == d") do ->
      assert_eq(option_none() ?? 99, 99)
    end

    forall_i("option_is_some(option_some(x)) is true") do x: Int ->
      qspec_assert(option_is_some(option_some(x)) == 1)
    end

    it("option_is_some(option_none()) is false") do ->
      assert_eq(option_is_some(option_none()), 0)
    end
  end

  # ==========================================================================
  # Boolean Laws
  # ==========================================================================
  describe("boolean laws") do ->
    it("double negation: not(not(x)) == x") do ->
      qspec_assert(not not true == true)
      qspec_assert(not not false == false)
    end

    it("De Morgan: not(a and b) == (not a) or (not b)") do ->
      prop_demorgan(true, true)
      prop_demorgan(true, false)
      prop_demorgan(false, true)
      prop_demorgan(false, false)
    end

    it("De Morgan: not(a or b) == (not a) and (not b)") do ->
      prop_demorgan2(true, true)
      prop_demorgan2(true, false)
      prop_demorgan2(false, true)
      prop_demorgan2(false, false)
    end

    it("identity: x and true == x") do ->
      qspec_assert((true and true) == true)
      qspec_assert((false and true) == false)
    end

    it("annihilator: x and false == false") do ->
      qspec_assert((true and false) == false)
      qspec_assert((false and false) == false)
    end
  end

  # ==========================================================================
  # Bitwise Laws
  # ==========================================================================
  describe("bitwise laws") do ->
    forall_i("x AND NOT x == 0") do x: Int ->
      assert_eq(band(x, bnot(x)), 0)
    end

    forall_i("x OR NOT x == -1") do x: Int ->
      assert_eq(bor(x, bnot(x)), -1)
    end

    forall_i("x XOR x == 0") do x: Int ->
      assert_eq(bxor(x, x), 0)
    end

    forall_i("double NOT is identity: ~~x == x") do x: Int ->
      assert_eq(bnot(bnot(x)), x)
    end

    forall_ii("XOR is commutative") do a: Int, b: Int ->
      assert_eq(bxor(a, b), bxor(b, a))
    end
  end

  # ==========================================================================
  # Map Laws
  # ==========================================================================
  describe("map laws") do ->
    it("set/get roundtrip with string key") do ->
      var m = map_new()
      m.set("key1", 42)
      match m.get("key1")
        Some(v) => assert_eq(v, 42)
        None => assert_eq(0, 1)
      end
    end

    it("has after set is true") do ->
      var m = map_new()
      m.set("test", 42)
      qspec_assert(m.has("test") == 1)
    end

    it("get on missing key returns None") do ->
      var m = map_new()
      m.set("exists", 1)
      match m.get("missing")
        Some(v) => assert_eq(0, 1)
        None => assert_eq(1, 1)
      end
    end

    it("overwrite replaces value") do ->
      var m = map_new()
      m.set("k", 10)
      m.set("k", 20)
      match m.get("k")
        Some(v) => assert_eq(v, 20)
        None => assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end

def prop_add(a: Int, b: Int): Int = a + b
def prop_mul(a: Int, b: Int): Int = a * b

def prop_demorgan(a: Bool, b: Bool): Void
  qspec_assert(not (a and b) == (not a or not b))
end

def prop_demorgan2(a: Bool, b: Bool): Void
  qspec_assert(not (a or b) == (not a and not b))
end
