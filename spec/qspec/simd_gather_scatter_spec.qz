## Simd Gather Scatter Tests
##
## Contract:
##   1. IR contains gather intrinsic.
##   2. IR contains scatter intrinsic.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("SIMD Gather Scatter") do ->
    it("IR contains gather intrinsic") do ->
      assert_ir_contains("""
        def main(): Int
          var offsets = simd_i32x4_splat(0)
          var mask = simd_i32x4_splat(1)
          var result = simd_f32x4_gather(0, offsets, mask)
          return 0
        end
      """, "llvm.masked.gather")
    end

    it("IR contains scatter intrinsic") do ->
      assert_ir_contains("""
        def main(): Int
          var values = simd_f32x4_splat(1.0)
          var offsets = simd_i32x4_splat(0)
          var mask = simd_i32x4_splat(1)
          simd_f32x4_scatter(values, 0, offsets, mask)
          return 0
        end
      """, "llvm.masked.scatter")
    end
  end

  return qspec_main()
end
