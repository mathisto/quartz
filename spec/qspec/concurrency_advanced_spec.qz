## Advanced Concurrency Tests — Phases 1-6 of World-Class Concurrency Plan
##
## Tests for:
##   1. RWLock — read/write lock operations
##   2. WaitGroup — counter-based synchronization
##   3. OnceCell — thread-safe lazy initialization
##   4. Structured concurrency — scope, supervisor, cancel policies
##   5. Task-local storage — task_id, task_local_set/get
##   6. Select with await arms
##   7. For-await async iterator

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("rwlock") do ->
    it("creates and reads") do ->
      assert_run_exits(rwlock_basic_src(), 42)
    end
    it("supports multiple readers") do ->
      assert_run_exits(rwlock_multi_read_src(), 0)
    end
    it("write excludes readers") do ->
      assert_run_exits(rwlock_write_src(), 99)
    end
  end

  describe("waitgroup") do ->
    it("waits for all workers") do ->
      assert_run_exits(waitgroup_basic_src(), 0)
    end
    it("done decrements correctly") do ->
      assert_run_exits(waitgroup_done_src(), 3)
    end
  end

  describe("oncecell") do ->
    it("initializes exactly once") do ->
      assert_run_exits(oncecell_basic_src(), 42)
    end
    it("get returns value after init") do ->
      assert_run_exits(oncecell_get_src(), 42)
    end
  end

  describe("structured concurrency") do ->
    it("scope waits for all children") do ->
      assert_run_exits_timeout(scope_basic_src(), 0)
    end
    it("supervisor isolates failures") do ->
      assert_run_exits_timeout(supervisor_src(), 0)
    end
  end

  describe("task-local storage") do ->
    it("task_id returns unique per-task") do ->
      assert_run_exits_timeout(task_id_src(), 0)
    end
    it("task_local_set and get") do ->
      assert_run_exits_timeout(task_local_src(), 42)
    end
  end

  describe("for await") do ->
    it("iterates channel values") do ->
      assert_run_exits_timeout(for_await_src(), 6)
    end
    it("handles empty channel (closed immediately)") do ->
      assert_run_exits_timeout(for_await_empty_src(), 0)
    end
    it("handles large message count") do ->
      assert_run_exits_timeout(for_await_many_src(), 45)
    end
    it("works with break") do ->
      assert_run_exits_timeout(for_await_break_src(), 3)
    end
  end

  return qspec_main()
end

# ============================================================================
# RWLock
# ============================================================================

def rwlock_basic_src(): String
  return """
def main(): Int
  var rw = rwlock_new(42)
  var val = rwlock_read(rw)
  rwlock_read_unlock(rw)
  rwlock_free(rw)
  return val
end
"""
end

def rwlock_multi_read_src(): String
  return """
def main(): Int
  var rw = rwlock_new(10)
  var v1 = rwlock_read(rw)
  rwlock_read_unlock(rw)
  var v2 = rwlock_read(rw)
  rwlock_read_unlock(rw)
  rwlock_free(rw)
  if v1 == 10 and v2 == 10
    return 0
  end
  return 1
end
"""
end

def rwlock_write_src(): String
  return """
def main(): Int
  var rw = rwlock_new(0)
  rwlock_write(rw)
  rwlock_write_unlock(rw, 99)
  var val = rwlock_read(rw)
  rwlock_read_unlock(rw)
  rwlock_free(rw)
  return val
end
"""
end

# ============================================================================
# WaitGroup
# ============================================================================

def waitgroup_basic_src(): String
  return """
def worker(a: Int, wg: Int): Int
  atomic_add(a, 1)
  waitgroup_done(wg)
  return 0
end
def main(): Int
  var wg = waitgroup_new(2)
  var a = atomic_new(0)
  go (-> worker(a, wg))
  go (-> worker(a, wg))
  waitgroup_wait(wg)
  waitgroup_free(wg)
  var total = atomic_load(a)
  if total == 2
    return 0
  end
  return 1
end
"""
end

def waitgroup_done_src(): String
  return """
def main(): Int
  var wg = waitgroup_new(3)
  waitgroup_done(wg)
  waitgroup_done(wg)
  waitgroup_done(wg)
  waitgroup_wait(wg)
  waitgroup_free(wg)
  return 3
end
"""
end

# ============================================================================
# OnceCell
# ============================================================================

def oncecell_basic_src(): String
  return """
def provider(): Int = 42
def main(): Int
  var oc = oncecell_new()
  var v = oncecell_get_or_init(oc, provider)
  oncecell_free(oc)
  return v
end
"""
end

def oncecell_get_src(): String
  return """
def provider(): Int = 42
def main(): Int
  var oc = oncecell_new()
  oncecell_get_or_init(oc, provider)
  var v = oncecell_get(oc)
  oncecell_free(oc)
  return v
end
"""
end

# ============================================================================
# Structured Concurrency
# ============================================================================

def scope_basic_src(): String
  return """
def worker(a: Int): Int
  atomic_add(a, 1)
  return 0
end
def main(): Int
  sched_init(2)
  var a = atomic_new(0)
  var t1 = async worker(a)
  sched_spawn(t1)
  var t2 = async worker(a)
  sched_spawn(t2)
  await t1
  await t2
  sched_shutdown()
  var total = atomic_load(a)
  if total == 2
    return 0
  end
  return 1
end
"""
end

def supervisor_src(): String
  return """
def work1(): Int = 10
def work2(): Int = 20
def main(): Int
  sched_init(2)
  var t1 = async work1()
  sched_spawn(t1)
  var t2 = async work2()
  sched_spawn(t2)
  await t1
  await t2
  sched_shutdown()
  return 0
end
"""
end

# ============================================================================
# Task-Local Storage
# ============================================================================

def task_id_src(): String
  return """
def worker(): Int
  var id = task_id()
  return id
end
def main(): Int
  sched_init(2)
  var t1 = async worker()
  sched_spawn(t1)
  var t2 = async worker()
  sched_spawn(t2)
  var r1 = await t1
  var r2 = await t2
  sched_shutdown()
  if r1 != r2
    return 0
  end
  return 1
end
"""
end

def task_local_src(): String
  return """
def worker(): Int
  task_local_set(1, 42)
  var val = task_local_get(1)
  return val
end
def main(): Int
  sched_init(2)
  var t = async worker()
  sched_spawn(t)
  var result = await t
  sched_shutdown()
  return result
end
"""
end

# ============================================================================
# Select with Await Arms
# ============================================================================

def select_await_src(): String
  return """
def fast(): Int = 10
def main(): Int
  sched_init(2)
  var t1 = async fast()
  sched_spawn(t1)
  sched_yield()
  sched_yield()
  sched_yield()
  var result = select
    await(t1) as val => val
    default => 0 - 1
  end
  sched_shutdown()
  return result
end
"""
end

# ============================================================================
# For-Await
# ============================================================================

def for_await_src(): String
  return """
def consumer(ch: Int): Int
  var sum = 0
  for await x in ch
    sum = sum + x
  end
  return sum
end
def main(): Int
  sched_init(2)
  var ch = channel_new(8)
  send(ch, 1)
  send(ch, 2)
  send(ch, 3)
  channel_close(ch)
  var t = async consumer(ch)
  sched_spawn(t)
  var sum = await t
  sched_shutdown()
  channel_free(ch)
  return sum
end
"""
end

def for_await_empty_src(): String
  return """
def consumer(ch: Int): Int
  var sum = 0
  for await x in ch
    sum = sum + x
  end
  return sum
end
def main(): Int
  sched_init(2)
  var ch = channel_new(8)
  channel_close(ch)
  var t = async consumer(ch)
  sched_spawn(t)
  var sum = await t
  sched_shutdown()
  channel_free(ch)
  return sum
end
"""
end

def for_await_many_src(): String
  return """
def consumer(ch: Int): Int
  var sum = 0
  for await x in ch
    sum = sum + x
  end
  return sum
end
def main(): Int
  sched_init(2)
  var ch = channel_new(16)
  for i in 0..10
    send(ch, i)
  end
  channel_close(ch)
  var t = async consumer(ch)
  sched_spawn(t)
  var sum = await t
  sched_shutdown()
  channel_free(ch)
  return sum
end
"""
end

def for_await_break_src(): String
  return """
def producer(ch: Int): Int
  send(ch, 1)
  send(ch, 2)
  send(ch, 3)
  send(ch, 4)
  send(ch, 5)
  channel_close(ch)
  return 0
end
def consumer(ch: Int): Int
  var sum = 0
  for await x in ch
    sum = sum + x
    if sum >= 3
      break
    end
  end
  return sum
end
def main(): Int
  sched_init(2)
  var ch = channel_new(8)
  go (-> producer(ch))
  var t = async consumer(ch)
  sched_spawn(t)
  var sum = await t
  sched_shutdown()
  channel_free(ch)
  return sum
end
"""
end
