## String += Compound Assignment Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("string += compound assignment") do ->
    it("basic string +=") do ->
      var src = """
        def main(): Int
          var s = "hello"
          s += " world"
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "hello world\n")
    end

    it("multiple string +=") do ->
      var src = """
        def main(): Int
          var s = "a"
          s += "b"
          s += "c"
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "abc\n")
    end

    it("string += with variable") do ->
      var src = """
        def main(): Int
          var s = "hello"
          var t = " world"
          s += t
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "hello world\n")
    end

    it("string += with interpolation") do ->
      var hash = "#"
      var src = "def main(): Int\n  var n = 42\n  var s = \"value: \"\n  s += \"" + hash + "{n}\"\n  puts(s)\n  return 0\nend\n"
      assert_run_stdout_eq(src, "value: 42\n")
    end

    it("+= on immutable string is error") do ->
      var src = """
        def main(): Int
          s = "hello"
          s += " world"
          return 0
        end
        """
      assert_compile_error(src, "immutable")
    end

    it("+= from empty string") do ->
      var src = """
        def main(): Int
          var s = ""
          s += "hello"
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "hello\n")
    end

    it("three += appends chained") do ->
      var src = """
        def main(): Int
          var s = "x"
          s += "y"
          s += "z"
          s += "!"
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "xyz!\n")
    end

    it("+= with single character") do ->
      var src = """
        def main(): Int
          var s = "abc"
          s += "d"
          puts(s)
          return 0
        end
        """
      assert_run_stdout_eq(src, "abcd\n")
    end

    it("+= does not modify the rhs variable") do ->
      var src = """
        def main(): Int
          var s = "hello"
          var t = " world"
          s += t
          puts(s)
          puts(t)
          return 0
        end
        """
      assert_run_stdout_eq(src, "hello world\n world\n")
    end
  end

  return qspec_main()
end
