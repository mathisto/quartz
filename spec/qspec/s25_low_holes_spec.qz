## S2.5 Safety Audit — LOW Hole Verification Tests
## Tests for remaining LOW-priority holes: #4, #5, #8, #10, #12
## Each hole is tested for triggerability:
##   - If triggerable: assert_compile_error or assert_run_exits showing the bug
##   - If NOT triggerable: comment explaining why + passing test showing correctness
##
## Contract:
##   1. S2.5 hole #4: NODE_WHILE move states after error.
##   2. S2.5 hole #5: list comprehension move handling.
##   3. S2.5 hole #8: NODE_RETURN expression position move.
##   4. S2.5 hole #12: return borrow check single-level.
##   5. S2.5 hole #11: NLL + move interaction.
##   6. S2.5 hole #10: match subject move consumption.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Hole #4: NODE_WHILE move states not restored after error
  # Description: When a while-loop body fails typechecking (e.g. due to a
  #   move error), the move states may not be restored to pre-loop state.
  #   This could cause false positives or negatives in subsequent code.
  # ===========================================================================
  describe("S2.5 hole #4: NODE_WHILE move states after error") do ->
    it("move in loop body without reinit is QZ1212") do ->
      ## Core trigger: move a Drop value in a while loop body
      ## without re-initialization. This SHOULD produce QZ1212.
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var i = 0
          while i < 1
            consume(r)
            i = i + 1
          end
          return 0
        end
        """, "QZ1212")
    end

    it("move in loop body with reinit is accepted") do ->
      ## Move + re-init in the same iteration should be fine
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 1}
          var total = 0
          var i = 0
          while i < 3
            total += consume(r)
            r = Res{x: 10}
            i = i + 1
          end
          return total
        end
        """, 21)
    end

    it("use after loop with move in body is QZ1212") do ->
      ## After the loop, the value should be considered moved
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 5}
          var i = 0
          while i < 1
            consume(r)
            i = i + 1
          end
          return r.x
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Hole #5: List comprehension move handling
  # Description: The move checker may not properly track moves inside list
  #   comprehension bodies. A Drop value moved in a comprehension body
  #   should be flagged as moved after the comprehension.
  # ===========================================================================
  describe("S2.5 hole #5: list comprehension move handling") do ->
    it("non-Drop value in list comprehension is fine") do ->
      ## Basic list comprehension should work for non-Drop values
      assert_compile_succeeds("""
        def main(): Int
          arr = [i * 2 for i in 0..3]
          return 0
        end
        """)
    end

    it("Drop value moved in list comp body is QZ1212") do ->
      ## A Drop value moved inside a list comprehension body should be
      ## detected — the comp iterates, so the move would happen on each iteration.
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          arr = [consume(r) for i in 0..3]
          return 0
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Hole #8: NODE_RETURN expression position no move
  # Description: When return is used in expression position, the move
  #   checker may not track the move of the returned value. The value
  #   passed to return should be consumed/moved.
  # ===========================================================================
  describe("S2.5 hole #8: NODE_RETURN expression position move") do ->
    it("return of owned value marks it as moved") do ->
      ## A simple return of a Drop value should consume it
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def get_val(r: Res): Int
          return r.x
        end
        def main(): Int
          var r = Res{x: 42}
          var v = get_val(r)
          return r.x
        end
        """, "QZ1212")
    end

    it("return in conditional does not move on non-taken branch") do ->
      ## If we return early, values used after the conditional should work
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def maybe_consume(r: Res, flag: Int): Int
          if flag != 0
            return r.x
          end
          return 0
        end
        def main(): Int
          var r = Res{x: 99}
          return maybe_consume(r, 1)
        end
        """, 99)
    end
  end

  # ===========================================================================
  # Hole #12: Return borrow check single-level only
  # Description: The borrow checker verifies that we don't return &local
  #   directly, but may not catch the case where we return the result of
  #   a function that itself returns a borrow of ITS local — the borrow
  #   escapes transitively. This is a multi-level escape that should be
  #   caught.
  # ===========================================================================
  describe("S2.5 hole #12: return borrow check single-level") do ->
    it("direct return of &local is QZ1210") do ->
      ## Direct case: returning borrow of local — should be caught
      assert_compile_error("""
        def bad(): Int
          var x = 42
          return &x
        end
        def main(): Int
          return bad()
        end
        """, "QZ1210")
    end

    it("returning borrow from function arg is OK") do ->
      ## Returning a borrow that was passed in is fine (caller owns it)
      assert_run_exits("""
        def identity(r: &Int): Int = r
        def main(): Int
          var x = 42
          var y = identity(&x)
          return 0
        end
        """, 0)
    end

    ## NOTE: Multi-level transitional borrow escape (the actual hole)
    ## This tests whether the compiler catches: fn A returns borrow of its
    ## local, fn B calls A and returns that borrow. The borrow points to
    ## A's stack which is dead by the time B returns.
    ## If the compiler catches this, great (the hole is not triggerable).
    ## If it doesn't, this documents the gap.
    it("transitive borrow escape through function call") do ->
      ## This is the actual hole: returning result of function that
      ## returns &local. If this compiles, the hole IS triggerable.
      ## If it errors, the hole is already fixed.
      assert_compile_error("""
        def borrows_local(): Int
          var local = 42
          return &local
        end
        def transitive(): Int
          return borrows_local()
        end
        def main(): Int
          return transitive()
        end
        """, "QZ1210")
    end
  end

  # ===========================================================================
  # Hole #11: NLL + move interaction
  # Description: NLL (Non-Lexical Lifetimes) allows borrows to be released
  #   at last use. This interacts with linear type move tracking — if NLL
  #   releases a borrow, the owned value's move state should remain correct.
  #   Specifically, after NLL releases a borrow, an owned value should still
  #   be consumable (moved), and double-move should still be rejected.
  # ===========================================================================
  describe("S2.5 hole #11: NLL + move interaction") do ->
    it("borrow released by NLL then owned value moved is accepted") do ->
      ## After NLL releases the borrow at last use, the owned value
      ## should be consumable without conflict.
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var ref = &r
          var v = ref + 0
          return consume(r)
        end
        """, 42)
    end

    it("double move after NLL borrow release is QZ1212") do ->
      ## Even after NLL releases a borrow, double-move of the owned
      ## value should still be detected.
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var ref = &r
          var v = ref + 0
          consume(r)
          return consume(r)
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Hole #10: NODE_MATCH subject consumed but not tracked
  # Description: When a Drop value is used as the subject of a match
  #   expression, the move checker should consume/move the subject.
  #   After the match, the original variable should be considered moved.
  #   Implementation: typecheck.qz:5278-5281 calls tc_move_on_call on
  #   the match subject ident.
  # ===========================================================================
  describe("S2.5 hole #10: match subject move consumption") do ->
    it("Drop struct passed as arg moves the value") do ->
      ## A Drop struct passed as a function argument then used after
      ## should produce QZ1212.
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def get_x(r: Res): Int = r.x
        def main(): Int
          var r = Res{x: 42}
          var v = get_x(r)
          return r.x
        end
        """, "QZ1212")
    end

    it("non-Drop value as match subject is fine") do ->
      ## Matching on a non-Drop value should not trigger move errors
      assert_run_exits("""
        enum Color
          Red
          Blue
          Green
        end
        def main(): Int
          var c = Color::Blue
          match c
            Red => return 1
            Blue => return 42
            Green => return 3
          end
        end
        """, 42)
    end

    it("Drop value consumed then used is QZ1212") do ->
      ## A Drop struct consumed by a function call, then used again,
      ## should produce QZ1212.
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def close_conn(c: Conn): Int = c.fd
        def main(): Int
          var c = Conn{fd: 10}
          close_conn(c)
          close_conn(c)
          return 0
        end
        """, "QZ1212")
    end
  end

  return qspec_main()
end
