import * from qspec
import * from std/sync/composition/parallel

@pure
def double(x: Int): Int = x * 2

@pure
def square(x: Int): Int = x * x

def add(a: Int, b: Int): Int = a + b

def test_parallel_map_basic(): Void
  var items = vec_new()
  items.push(1)
  items.push(2)
  items.push(3)
  items.push(4)
  var results = parallel_map(items, double)
  for i in 0..results.size
    puts(to_str(results[i]))
  end
end

def test_parallel_map_empty(): Void
  var items = vec_new()
  var results = parallel_map(items, double)
  puts(to_str(results.size))
end

def test_parallel_map_single(): Void
  var items = vec_new()
  items.push(21)
  var results = parallel_map(items, double)
  puts(to_str(results[0]))
end

def test_parallel_reduce(): Void
  var items = vec_new()
  items.push(1)
  items.push(2)
  items.push(3)
  items.push(4)
  var sum = parallel_reduce(items, 0, add)
  puts(to_str(sum))
end

def main(): Int
  describe("automatic parallelism") do ->

    it("parallel_map doubles each element") do ->
      assert_output("2\n4\n6\n8\n", test_parallel_map_basic)
    end

    it("parallel_map handles empty input") do ->
      assert_output("0\n", test_parallel_map_empty)
    end

    it("parallel_map handles single element") do ->
      assert_output("42\n", test_parallel_map_single)
    end

    it("parallel_reduce sums elements") do ->
      assert_output("10\n", test_parallel_reduce)
    end

  end

  return qspec_main()
end
