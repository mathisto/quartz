## Compiler Quality Tests — CQ.1-CQ.6
##
## Verifies fixes for resolver/TC constraints that affected cross-module
## mutable state, extern dedup, and readline alias.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("CQ.2 — NK_ASSIGN target rewriting") do ->
    it("module-level var assigned inside function") do ->
      var files: Vec = vec_new()
      files.push(as_int("counter.qz"))
      vec_push(files, as_int("""
        var _count = 0
        def bump(): Int
          _count += 1
          return _count
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from counter
        def main(): Int
          return bump() + bump()
        end
        """))
      assert_multi_run_exits(files, 1, 3)
    end

    it("compound assignment += on module-level var") do ->
      var files: Vec = vec_new()
      files.push(as_int("state.qz"))
      vec_push(files, as_int("""
        var _total = 10
        def add(n: Int): Int
          _total += n
          return _total
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from state
        def main(): Int
          return add(5) + add(3)
        end
        """))
      assert_multi_run_exits(files, 1, 33)
    end

    it("compound -= on module-level var") do ->
      var files: Vec = vec_new()
      files.push(as_int("dec.qz"))
      vec_push(files, as_int("""
        var _val = 100
        def sub(n: Int): Int
          _val -= n
          return _val
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from dec
        def main(): Int
          return sub(30)
        end
        """))
      assert_multi_run_exits(files, 1, 70)
    end
  end

  describe("CQ.6 — Vec var reassignment") do ->
    it("module-level Vec var reassigned inside function") do ->
      var files: Vec = vec_new()
      files.push(as_int("vmod.qz"))
      vec_push(files, as_int("""
        var _buf = vec_new<Int>()
        def reset(): Void
          _buf = vec_new<Int>()
        end
        def add(x: Int): Void
          vec_push(_buf, x)
        end
        def total(): Int
          var s = 0
          for i in 0.._buf.size
            s += _buf[i]
          end
          return s
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from vmod
        def main(): Int
          add(10)
          add(20)
          reset()
          add(5)
          return total()
        end
        """))
      assert_multi_run_exits(files, 1, 5)
    end
  end

  describe("CQ.3 — many module-level vars") do ->
    it("15+ module-level vars all work") do ->
      var files: Vec = vec_new()
      files.push(as_int("many.qz"))
      vec_push(files, as_int("""
        var _a = 1
        var _b = 2
        var _c = 3
        var _d = 4
        var _e = 5
        var _f = 6
        var _g = 7
        var _h = 8
        var _i = 9
        var _j = 10
        var _k = 11
        var _l = 12
        var _m = 13
        var _n = 14
        var _o = 15
        def bump_all(): Int
          _a += 1
          _b += 1
          _c += 1
          _d += 1
          _e += 1
          _f += 1
          _g += 1
          _h += 1
          _i += 1
          _j += 1
          _k += 1
          _l += 1
          _m += 1
          _n += 1
          _o += 1
          return _a + _b + _c + _d + _e + _f + _g + _h + _i + _j + _k + _l + _m + _n + _o
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from many
        def main(): Int
          return bump_all()
        end
        """))
      ## 15 vars: (1+1)+(2+1)+...+(15+1) = 2+3+...+16 = 135
      assert_multi_run_exits(files, 1, 135)
    end
  end

  describe("CQ.4 — extern dedup") do ->
    it("two modules extern the same C function") do ->
      var files: Vec = vec_new()
      files.push(as_int("mod_a.qz"))
      vec_push(files, as_int("""
        extern "C" def abs(x: Int): Int
        def abs_a(x: Int): Int = abs(x)
        """))
      files.push(as_int("mod_b.qz"))
      vec_push(files, as_int("""
        extern "C" def abs(x: Int): Int
        def abs_b(x: Int): Int = abs(x)
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from mod_a
        import * from mod_b
        def main(): Int
          return abs_a(-5) + abs_b(-3)
        end
        """))
      assert_multi_run_exits(files, 2, 8)
    end
  end

  describe("CQ.5 — readline alias") do ->
    it("readline compiles as intrinsic") do ->
      assert_compile_succeeds("""
        def main(): Int
          var s = readline()
          return 0
        end
        """)
    end
  end

  describe("CQ.1 — cross-directory import") do ->
    it("module imports work with include paths") do ->
      var files: Vec = vec_new()
      files.push(as_int("utils.qz"))
      vec_push(files, as_int("""
        TOK_EOF = 0
        TOK_INT = 3
        def tok_name(t: Int): Int = t
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from utils
        def main(): Int
          return TOK_EOF + TOK_INT + tok_name(5)
        end
        """))
      assert_multi_run_exits(files, 1, 8)
    end
  end

  return qspec_main()
end
