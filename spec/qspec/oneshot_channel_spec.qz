import * from qspec
import * from std/sync/communication/channel

# --- oneshot tests ---

def test_oneshot_basic(): Void
  var ch = oneshot_new()
  oneshot_send(ch, 42)
  var val = oneshot_recv(ch)
  puts(to_str(val))
end

def test_oneshot_auto_close(): Void
  var ch = oneshot_new()
  oneshot_send(ch, 99)
  var closed = channel_closed(ch)
  if closed
    puts("auto-closed")
  else
    puts("still open")
  end
end

def test_oneshot_recv_safe(): Void
  var ch = oneshot_new()
  oneshot_send(ch, 77)
  var r = oneshot_recv_safe(ch)
  match r
    Ok(v) => puts(to_str(v))
    Err(e) => puts("err")
  end
end

def test_oneshot_second_send(): Void
  var ch = oneshot_new()
  oneshot_send(ch, 1)
  var result = oneshot_send(ch, 2)
  puts(to_str(result))
end

def test_oneshot_cross_thread(): Void
  var ch = oneshot_new()
  var h = go oneshot_send(ch, 55)
  var val = oneshot_recv(ch)
  await h
  puts(to_str(val))
end

def main(): Int
  describe("oneshot channels") do ->

    it("basic send/recv") do ->
      assert_output("42\n", test_oneshot_basic)
    end

    it("auto-close after send") do ->
      assert_output("auto-closed\n", test_oneshot_auto_close)
    end

    it("oneshot_recv_safe returns Ok") do ->
      assert_output("77\n", test_oneshot_recv_safe)
    end

    it("second send fails (channel closed)") do ->
      assert_output("-1\n", test_oneshot_second_send)
    end

    it("cross-thread oneshot pattern") do ->
      assert_output("55\n", test_oneshot_cross_thread)
    end

  end

  return qspec_main()
end
