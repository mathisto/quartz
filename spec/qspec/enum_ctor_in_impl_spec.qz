## Regression tests for OPTION-CTOR-IN-IMPL-BODY.
##
## HISTORY: The April 2026 overnight sprint reported a bug where bare
## `None` / `Some(x)` inside trait impl method bodies compiled cleanly through
## the typechecker and emitted `%None undef` / `%Some undef` in LLVM IR. This
## reached llc as "use of undefined value", surfacing as a confusing build
## error. Root cause was never pinned down — the bug turned out to not
## reproduce on current trunk after a clean `.quartz-cache` rebuild on
## April 14. The most likely fix paths were commit 39a984ca (UNKNOWN-VARIANT-MATCH
## validation) and commit 1c68b67c (unqualified variant payload type fix), both
## from the April 13 sprint.
##
## These tests LOCK IN the correct current behavior as a regression guard.
## If any of them start failing with %None/%Some undef, the underlying bug has
## returned.
##
## Contract:
##   1. Bare `None` inside an impl method body is a typecheck error (QZ0403).
##      Must not silently emit %None undef.
##   2. Bare `Some(v)` inside an impl method body is a typecheck error (QZ0401).
##      Must not silently emit %Some undef.
##   3. `Option::None` qualified form inside an impl method body compiles
##      correctly — produces real Option variant IR with tag=1.
##   4. `Option::Some(v)` qualified form inside an impl method body compiles
##      correctly — produces real Option variant IR with tag=0, payload=v.
##   5. With `import traits`, bare `None` / `Some` STILL errors (traits module
##      doesn't magically export variant constructors into local scope).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("enum constructors in impl method body") do ->

    ## Contract 1: bare None inside impl body is a typecheck error.
    it("bare None in trait impl method is QZ0403") do ->
      assert_compile_error("""
        trait GetOpt
          def get_none(self): Option<Int>
        end
        struct ECounter
          val: Int
        end
        extend ECounter with GetOpt
          def get_none(self): Option<Int>
            return None
          end
        end
        def main(): Int = 0
        """, "QZ0403")
    end

    ## Contract 2: bare Some(v) inside impl body is a typecheck error.
    it("bare Some(v) in trait impl method is QZ0401") do ->
      assert_compile_error("""
        trait GetOpt
          def get_some(self): Option<Int>
        end
        struct ECounter
          val: Int
        end
        extend ECounter with GetOpt
          def get_some(self): Option<Int>
            return Some(42)
          end
        end
        def main(): Int = 0
        """, "QZ0401")
    end

    ## Contract 3: qualified Option::None inside impl body compiles + runs.
    it("Option::None in trait impl method runs correctly") do ->
      assert_run_exits("""
        trait GetOpt
          def get_none(self): Option<Int>
        end
        struct ECounter
          val: Int
        end
        extend ECounter with GetOpt
          def get_none(self): Option<Int>
            return Option::None
          end
        end
        def main(): Int
          c = ECounter { val: 42 }
          opt = c.get_none()
          return 0 if opt is None
          return 1
        end
        """, 0)
    end

    ## Contract 4: qualified Option::Some(v) inside impl body compiles + runs.
    it("Option::Some(v) in trait impl method runs correctly") do ->
      assert_run_exits("""
        trait GetOpt
          def get_some(self): Option<Int>
        end
        struct ECounter
          val: Int
        end
        extend ECounter with GetOpt
          def get_some(self): Option<Int>
            return Option::Some(@val)
          end
        end
        def main(): Int
          c = ECounter { val: 42 }
          opt = c.get_some()
          ## Must unwrap to 42.
          return 0 if opt is Some and opt! == 42
          return 1
        end
        """, 0)
    end

    ## Contract 5: `import traits` does not magically open variant scope.
    ## This locks in the behavior that the `custom_iterator_spec.qz` workaround
    ## (`import traits` + qualified `Option::None`) is no longer required for
    ## correctness — qualified names work without it. The import is still
    ## needed to get the Iterator trait itself into scope.
    it("bare Some/None with import traits still errors") do ->
      assert_compile_error("""
        import traits
        trait GetOpt
          def get_some(self): Option<Int>
        end
        struct ECounter
          val: Int
        end
        extend ECounter with GetOpt
          def get_some(self): Option<Int>
            return Some(42)
          end
        end
        def main(): Int = 0
        """, "QZ0401")
    end

  end
  return qspec_main()
end
