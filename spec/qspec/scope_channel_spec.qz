## scope-aware channel recv/send (B.7 Phase 4e.2)
##
## scope_recv and scope_send are the second and third scope-integrated
## blocking primitives (after scope_sleep_ms in Phase 4e.1). They share
## the same chunked-poll-first recipe: under root scope, route to a
## tight blocking loop; under a real scope, alternate try_recv_or_closed
## / try_send with sched_sleep(min(chunk, deadline_remaining_ms)) and
## scope_check between chunks.
##
## Contract:
##   1. Under root scope, scope_recv on a closed+empty channel returns
##      Result::Err(0) without throwing.
##   2. Under root scope, scope_recv on a non-empty channel returns
##      Result::Ok(value) without throwing.
##   3. Under root scope, scope_send to a non-full channel returns
##      without throwing; the value is observable via try_recv afterwards.
##   4. Under a scope with a deadline closer than recv would wait, the
##      deadline fires and scope_recv throws "deadline_exceeded" within
##      ~chunk_size + slack ms. The deadline timer (Phase 4d) is what
##      wakes the recv loop's chunked sleep.
##   5. Under a scope already cancelled at entry, scope_recv throws
##      immediately with the user-supplied reason (preflight check).
##   6. Under a scope, scope_recv on a pre-filled channel returns
##      Ok(value) without throwing — the loop never enters the
##      chunked-poll path because try_recv_or_closed succeeds on the
##      first iteration.
##   7. Under a scope with a deadline closer than scope_send would wait
##      on a full bounded channel, the deadline fires and scope_send
##      throws "deadline_exceeded".
##   8. Under a scope already cancelled at entry, scope_send throws
##      immediately with the user-supplied reason.

import * from qspec
import * from std/sync/composition/scope
import * from std/throws

# Capture for handler-driven assertions.
var sc_caught_msg = ""
var sc_caught_count = 0

def sc_capture(op_name: Int, argc: Int, argv: Int): Int
  sc_caught_msg = as_type<String>(load(argv, 0))
  sc_caught_count += 1
  return 0
end

def is_in_range(v: Int, lo: Int, hi: Int): Int
  if v >= lo and v <= hi
    return 1
  end
  return 0
end

# Per-test channel slot — module global so test bodies can address it
# without juggling closure capture across `with Throws` boundaries.
var sc_ch = 0
var sc_recv_was_ok = 0
var sc_recv_val = 0
var sc_recv_was_err = 0
var sc_send_ok = 0

def sc_recv_into_globals(): Int
  var r = scope_recv(sc_ch)
  if is_ok(r)
    sc_recv_was_ok = 1
    sc_recv_val = unwrap_ok(r)
  end
  if is_err(r)
    sc_recv_was_err = 1
  end
  return 0
end

def sc_send_42_into_global(): Int
  scope_send(sc_ch, 42)
  sc_send_ok = 1
  return 0
end

def sc_send_99_into_global(): Int
  scope_send(sc_ch, 99)
  sc_send_ok = 1
  return 0
end

def main(): Int
  describe("scope_recv / scope_send (B.7 Phase 4e.2)") do ->

    it("under root, scope_recv on a closed+empty channel returns Err(0)") do ->
      var ch = channel_new(1)
      channel_close(ch)
      var r = scope_recv(ch)
      assert_eq(is_err(r), true)
    end

    it("under root, scope_recv on a non-empty channel returns Ok(value)") do ->
      var ch = channel_new(2)
      send(ch, 7)
      var r = scope_recv(ch)
      assert_eq(is_ok(r), true)
      assert_eq(unwrap_ok(r), 7)
    end

    it("under root, scope_send to non-full channel succeeds + value is readable") do ->
      var ch = channel_new(2)
      scope_send(ch, 13)
      var opt = try_recv(ch)
      var read = -1
      if option_is_some(opt)
        read = load(opt, 1)
      end
      assert_eq(read, 13)
    end

    it("under a scope, scope_recv on a pre-filled channel returns Ok without throwing") do ->
      sc_ch = channel_new(2)
      send(sc_ch, 5)
      sc_recv_was_ok = 0
      sc_recv_val = -1
      sc_recv_was_err = 0
      sc_caught_count = 0
      var s = scope_timeout(scope_root(), 5_000)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_recv_into_globals)
        0
      end
      assert_eq(sc_caught_count, 0)
      assert_eq(sc_recv_was_ok, 1)
      assert_eq(sc_recv_val, 5)
    end

    it("scope_recv with deadline fires deadline_exceeded on empty channel") do ->
      sc_ch = channel_new(1)
      sc_recv_was_ok = 0
      sc_recv_was_err = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var start_ns = time_mono_ns()
      var s = scope_timeout(scope_root(), 50)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_recv_into_globals)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      # Deadline 50ms; chunk granularity adds up to ~50ms of slack.
      assert_eq(is_in_range(elapsed_ms, 45, 300), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "deadline_exceeded")
      # Body never reached either result branch.
      assert_eq(sc_recv_was_ok, 0)
      assert_eq(sc_recv_was_err, 0)
    end

    it("scope_recv throws preflight when scope is already cancelled at entry") do ->
      sc_ch = channel_new(1)
      sc_recv_was_ok = 0
      sc_recv_was_err = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var s = scope_with_cancel(scope_root())
      scope_cancel_with(s, "user_aborted_recv")
      var start_ns = time_mono_ns()
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_recv_into_globals)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      # No sched_sleep should run; only the entry scope_check fires.
      assert_eq(is_in_range(elapsed_ms, 0, 50), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "user_aborted_recv")
      assert_eq(sc_recv_was_ok, 0)
    end

    it("scope_send with deadline fires deadline_exceeded on full bounded channel") do ->
      sc_ch = channel_new(1)
      send(sc_ch, 1)
      sc_send_ok = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var start_ns = time_mono_ns()
      var s = scope_timeout(scope_root(), 50)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_send_99_into_global)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      assert_eq(is_in_range(elapsed_ms, 45, 300), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "deadline_exceeded")
      # Send body never completed.
      assert_eq(sc_send_ok, 0)
    end

    it("scope_send throws preflight when scope is already cancelled at entry") do ->
      sc_ch = channel_new(1)
      send(sc_ch, 1)
      sc_send_ok = 0
      sc_caught_msg = ""
      sc_caught_count = 0
      var s = scope_with_cancel(scope_root())
      scope_cancel_with(s, "user_aborted_send")
      var start_ns = time_mono_ns()
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_send_99_into_global)
        0
      end
      var elapsed_ms = (time_mono_ns() - start_ns) / 1_000_000
      assert_eq(is_in_range(elapsed_ms, 0, 50), 1)
      assert_eq(sc_caught_count, 1)
      assert_eq_str(sc_caught_msg, "user_aborted_send")
      assert_eq(sc_send_ok, 0)
    end

    it("scope_send to non-full channel under a scope succeeds without throwing") do ->
      sc_ch = channel_new(2)
      sc_send_ok = 0
      sc_caught_count = 0
      var s = scope_timeout(scope_root(), 5_000)
      with Throws { throw: sc_capture } do ->
        scope_with(s, sc_send_42_into_global)
        0
      end
      assert_eq(sc_caught_count, 0)
      assert_eq(sc_send_ok, 1)
      var opt = try_recv(sc_ch)
      var read = -1
      if option_is_some(opt)
        read = load(opt, 1)
      end
      assert_eq(read, 42)
    end

  end
  return qspec_main()
end
