## extern "x86-interrupt" Calling Convention Tests (EPIC SYS.1 item 8)
##
## Contract:
##   1. `extern "x86-interrupt" def <name>(frame: Int): Void ... end`
##      parses cleanly and emits `define x86_intrcc void @<name>(...)`.
##   2. LLVM's `x86_intrcc` is the interrupt-handler calling
##      convention; the backend emits the interrupt prologue/epilogue
##      and `iret` instead of `ret`. Required for IDT entries.
##   3. Return type is forced to `void` — LLVM rejects interrupt
##      handlers with any other return type. Parser enforces at
##      source; codegen asserts at emission.
##   4. `extern "x86-interrupt"` without a body is a compile error
##      (interrupt handlers are definitions, not imported symbols).
##   5. `extern "C"` continues to work exactly as before (no
##      `x86_intrcc` keyword in its emission).
##
## This is a kernel-only feature: userspace code never writes an
## interrupt handler. Quartz doesn't verify the signature beyond
## "return is Void" — the user is responsible for the `frame: Int`
## parameter shape matching what the CPU pushes. LLVM will catch
## grossly wrong signatures at verify time.
##
## NOTE ON SPEC INPUT LAYOUT: the `extern "X" def ...` header MUST
## be on a single line. Putting `extern "X"` on its own line above
## the `def` triggers a pre-existing grammar-ambiguity hang in the
## parser's has_body indentation heuristic (reproduces on both the
## current and prior-generation compiler binaries). Pre-existing
## bug, not introduced by this slice.
import * from qspec

def main(): Int
  describe("extern \"x86-interrupt\" calling convention") do ->
    it("emits x86_intrcc keyword on the define statement") do ->
      assert_ir_contains("""
extern "x86-interrupt" def timer_isr(frame: Int): Void
  var x = 1
end

def main(): Int = 0
""", "define x86_intrcc void @timer_isr")
    end

    it("forces void return type") do ->
      # Even though Quartz's default return type emits `i64`,
      # x86_intrcc functions must emit `void`. Verify the emitted
      # IR has `x86_intrcc void` (not `x86_intrcc i64`).
      assert_ir_not_contains("""
extern "x86-interrupt" def divide_error(frame: Int): Void
  var x = 1
end

def main(): Int = 0
""", "x86_intrcc i64")
    end

    it("extern \"C\" does NOT get x86_intrcc emission") do ->
      # Regression check — the existing extern "C" path is untouched.
      assert_ir_not_contains("""
extern "C" def libc_wrapper(x: Int): Int
  return x * 2
end

def main(): Int = libc_wrapper(5)
""", "x86_intrcc")
    end

    it("bodyless extern \"x86-interrupt\" is rejected") do ->
      assert_compile_error("""
extern "x86-interrupt" def stranded_isr(frame: Int): Void

def main(): Int = 0
""", "requires a body")
    end

    it("non-Void return on extern \"x86-interrupt\" is rejected") do ->
      assert_compile_error("""
extern "x86-interrupt" def bad_isr(frame: Int): Int
  return 0
end

def main(): Int = 0
""", "must return Void")
    end
  end

  return qspec_main()
end
