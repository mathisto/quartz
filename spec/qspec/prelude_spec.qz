## Prelude Tests
##
## Contract:
##   1. Is_err function works.
##   2. Is_none function works.
##   3. Is_ok function works.
##   4. Is_some function works.
##   5. Option::none is available without.
##   6. Option::some is available without.
import * from qspec

def main(): Int
  describe("prelude") do ->
    it("Option::Some is available without explicit import") do ->
      opt = Option::Some(42)
      v = match opt
        Some(x) => x
        None => 0
      end
      assert_eq(v, 42)
    end
    it("Option::None is available without explicit import") do ->
      opt = Option::None
      v = match opt
        Some(x) => x
        None => 99
      end
      assert_eq(v, 99)
    end
    it("Result::Ok is available without explicit import") do ->
      r = Result::Ok(42)
      v = match r
        Ok(x) => x
        Err(e) => 0
      end
      assert_eq(v, 42)
    end
    it("Result::Err is available without explicit import") do ->
      r = Result::Err(99)
      v = match r
        Ok(x) => 0
        Err(e) => e
      end
      assert_eq(v, 99)
    end
    it("is_some function works") do ->
      assert_eq(is_some(Option::Some(1)), 1)
      assert_eq(is_some(Option::None), 0)
    end
    it("is_none function works") do ->
      assert_eq(is_none(Option::None), 1)
      assert_eq(is_none(Option::Some(1)), 0)
    end
    it("is_ok function works") do ->
      assert_eq(is_ok(Result::Ok(1)), 1)
      assert_eq(is_ok(Result::Err(1)), 0)
    end
    it("is_err function works") do ->
      assert_eq(is_err(Result::Err(1)), 1)
      assert_eq(is_err(Result::Ok(1)), 0)
    end
  end
  return qspec_main()
end
