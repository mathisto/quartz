## Vec Index Syntax Tests
##
## Contract:
##   1. Vec get syntax v[i].
##   2. Vec set syntax v[i] = x.
##   3. Type inference.

import * from qspec
import * from qspec/subprocess

def make_vec(): Vec
  var v = vec_new()
  v.push(99)
  return v
end

## A non-@value (heap reference) struct with >1 field — exercises the
## `vec_get` reference-struct read path (formerly a by-value deep copy).
struct Ref
  a: Int
  b: Int
  c: Int
end

def ref_index_of(v: Vec<Ref>, target: Ref): Int
  for i in 0..v.size
    if as_int_generic(v[i]) == as_int_generic(target)
      return i
    end
  end
  return -1
end

def main(): Int
  describe("vec get syntax v[i]") do ->
    it("reads element at index") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[1], 20)
    end

    it("works with variable index") do ->
      var v = vec_new()
      v.push(100)
      v.push(200)
      i = 1
      assert_eq(v[i], 200)
    end

    it("works with expression index") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      assert_eq(v[1 + 1], 3)
    end

    it("panics on out of bounds") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          puts(str_from_int(v[100]))
          return 0
        end
        """, "index out of bounds")
    end

    it("chains with function calls") do ->
      assert_eq(make_vec()[0], 99)
    end
  end

  describe("vec set syntax v[i] = x") do ->
    it("writes element at index") do ->
      var v = vec_new()
      v.push(0)
      v[0] = 42
      assert_eq(v[0], 42)
    end

    it("works with expression on RHS") do ->
      var v = vec_new()
      v.push(0)
      v[0] = 20 + 22
      assert_eq(v[0], 42)
    end

    it("allows chained assignment") do ->
      var v = vec_new()
      v.push(0)
      v.push(0)
      v[0] = v[1] = 42
      assert_eq(v[0], 42)
      assert_eq(v[1], 42)
    end
  end

  # B.15d/N3.1 step-4a-3 regression: reading a non-@value (heap reference)
  # struct from a Vec must return the STORED HANDLE, not a by-value deep copy.
  # The old `vec_get`/`vec_get_unchecked` codegen memcpy'd multi-field
  # reference structs into a fresh stack slot and returned the copy's address,
  # silently breaking pointer identity (e.g. `as_int_generic(v[i])` could never
  # equal the originally-pushed handle). `Ref` below has >1 field to exercise
  # exactly that path. See docs/design/B15_NIL_ELIMINATION.md §11.18.
  describe("Vec of reference struct preserves identity") do ->
    it("returns the same handle, not a copy (as_int_generic identity)") do ->
      var r = Ref { a: 1, b: 2, c: 3 }
      var v = vec_new<Ref>()
      v.push(r)
      assert_eq(as_int_generic(v[0]), as_int_generic(r))
    end

    it("aliases the stored object (mutation through a read is visible)") do ->
      var r = Ref { a: 10, b: 0, c: 0 }
      var v = vec_new<Ref>()
      v.push(r)
      var got = v[0]
      got.b = 77
      assert_eq(v[0].b, 77)
    end

    it("finds a pushed element by identity in a loop") do ->
      var v = vec_new<Ref>()
      var i = 0
      while i < 6
        v.push(Ref { a: i, b: 0, c: 0 })
        i = i + 1
      end
      var target = v[5]
      assert_eq(ref_index_of(v, target), 5)
    end
  end

  describe("type inference") do ->
    it("infers element type from Vec type") do ->
      var v = vec_new()
      v.push(42)
      x = v[0]
      assert_eq(x, 42)
    end

    it("errors on type mismatch") do ->
      assert_compile_error("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 1)
          x = v["bad"]
          return 0
        end
        """, "Array index must be Int")
    end
  end

  return qspec_main()
end
