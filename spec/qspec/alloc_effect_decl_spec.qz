## QSpec coverage for the Alloc effect declaration (Phase A.1).
##
## These tests lock in the declaration shape — that the effect parses,
## that `can Alloc` propagates correctly, and that custom handlers
## installed via `with Alloc { alloc, dealloc } do ... end` fire on
## both ops with the expected ABI.
##
## Out of scope (defer to A.6 — full spec coverage):
##   - Default-handler behavior (Phase A.2/A.3 ships the runtime hook).
##   - Nested handlers, isolation between installs.
##   - Recursion-bypass for handlers that themselves allocate.
##   - Throw-on-deny composition with std/throws.
##   - Pervasive interception of mem_alloc/mem_free at every call site.

import * from qspec
import std/alloc

# --- Test 1: handler intercepts alloc and receives size argument

def t1_handler_alloc(op: Int, argc: Int, argv: Int): Int
  var size = load(argv, 0)
  puts("h-alloc:#{size}")
  return mem_alloc(size)
end

def t1_handler_dealloc(op: Int, argc: Int, argv: Int): Int
  var ptr = load(argv, 0)
  mem_free(ptr)
  return 0
end

def t1_use(): Int can Alloc
  # A.3.c byte-semantics: alloc(N) allocates N bytes (was N slots × 8).
  # 8 bytes = one i64 slot for store(p, 0, 11).
  var p = alloc(8)
  store(p, 0, 11)
  var v = load(p, 0)
  dealloc(p)
  return v
end

var _t1_v = 0

def t1_run(): Void
  with Alloc { alloc: t1_handler_alloc, dealloc: t1_handler_dealloc } do ->
    _t1_v = t1_use()
  end
  # puts() is OUTSIDE the with-block so its internal str_from_int/concat
  # allocations route through the blessed default, not the t1 handler.
  # Post Phase A.7 every allocation is routed through Alloc; pre-A.7 only
  # user-visible alloc/dealloc calls were observed.
  puts("v=#{_t1_v}")
end

# --- Test 2: round-trip — multiple allocations + reads through handler

def t2_handler_alloc(op: Int, argc: Int, argv: Int): Int
  var size = load(argv, 0)
  return mem_alloc(size)
end

def t2_handler_dealloc(op: Int, argc: Int, argv: Int): Int
  var ptr = load(argv, 0)
  mem_free(ptr)
  return 0
end

def t2_use(): Int can Alloc
  # A.3.c byte-semantics: 8 bytes = one i64 slot.
  var p1 = alloc(8)
  var p2 = alloc(8)
  store(p1, 0, 100)
  store(p2, 0, 200)
  var sum = load(p1, 0) + load(p2, 0)
  dealloc(p2)
  dealloc(p1)
  return sum
end

def t2_run(): Void
  with Alloc { alloc: t2_handler_alloc, dealloc: t2_handler_dealloc } do ->
    var s = t2_use()
    puts("sum=#{s}")
  end
end

# --- Test 3: handler counts dealloc invocations via a TLS counter

var _t3_dealloc_count = 0

def t3_handler_alloc(op: Int, argc: Int, argv: Int): Int
  var size = load(argv, 0)
  return mem_alloc(size)
end

def t3_handler_dealloc(op: Int, argc: Int, argv: Int): Int
  var ptr = load(argv, 0)
  _t3_dealloc_count = _t3_dealloc_count + 1
  mem_free(ptr)
  return 0
end

def t3_use(): Int can Alloc
  var p1 = alloc(1)
  var p2 = alloc(1)
  var p3 = alloc(1)
  dealloc(p1)
  dealloc(p2)
  dealloc(p3)
  return 0
end

def t3_run(): Void
  _t3_dealloc_count = 0
  with Alloc { alloc: t3_handler_alloc, dealloc: t3_handler_dealloc } do ->
    var _ignored = t3_use()
    puts("count=#{_t3_dealloc_count}")
  end
end

def main(): Int
  describe("Alloc effect declaration (A.1)") do ->
    it("handler intercepts alloc and receives size") do ->
      assert_output("h-alloc:8\nv=11\n", t1_run)
    end

    it("round-trips through handler-allocated memory") do ->
      assert_output("sum=300\n", t2_run)
    end

    it("dealloc handler fires once per dealloc call") do ->
      assert_output("count=3\n", t3_run)
    end
  end
  return qspec_main()
end
