## Global Variables Tests
##
## Contract:
##   1. Shared: global var mutations visible across functions.
##   2. Initial: global initialized with literal value.
##   3. Multiple: multiple globals are independent and composable.
##   4. Reset: mutation from function modifies global.
##   5. IR: `@global_NAME` in generated IR.
##   6. Arithmetic: global var used in arithmetic expressions.
##   7. Composed: global var modified by multiple function calls.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("cross-module global variables") do ->
    it("cross-module var is shared between functions (globals not linked)") do ->
      assert_run_exits("""
        var counter = 0
        def inc_counter(): Int
          counter = counter + 1
          return counter
        end
        def get_counter(): Int
          return counter
        end
        def main(): Int
          inc_counter()
          inc_counter()
          return get_counter() + 8
        end
        """, 10)
    end
    it("cross-module var with initial value (globals not linked)") do ->
      var files: Vec = vec_new()
      files.push(as_int("gmod2.qz"))
      files.push(as_int("""
        var value = 42
        def get_value(): Int
          return value
        end
        """))
      files.push(as_int("main.qz"))
      files.push(as_int("""
        import gmod2
        def main(): Int
          return gmod2::get_value()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
    it("multiple global vars in one module (globals not linked)") do ->
      var files: Vec = vec_new()
      files.push(as_int("gmod3.qz"))
      files.push(as_int("""
        var ga = 10
        var gb = 20
        def get_sum(): Int
          return ga + gb
        end
        """))
      files.push(as_int("main.qz"))
      files.push(as_int("""
        import gmod3
        def main(): Int
          return gmod3::get_sum()
        end
        """))
      assert_multi_run_exits(files, 1, 30)
    end
    it("global var reset and read (globals not linked)") do ->
      assert_run_exits("""
        var g = 50
        def reset_g(): Void
          g = 55
        end
        def main(): Int
          reset_g()
          return g
        end
        """, 55)
    end
    it("global var IR has correct global declaration (IR test)") do ->
      assert_ir_contains("""
var g = 42
def main(): Int
  return g
end
""", "@global_g")
    end
    it("global var used in arithmetic") do ->
      assert_run_exits("""
        var total = 100
        def subtract(n: Int): Void
          total = total - n
        end
        def main(): Int
          subtract(58)
          return total
        end
        """, 42)
    end
    it("global var modified by multiple function calls") do ->
      assert_run_exits("""
        var acc = 0
        def add_five(): Void
          acc = acc + 5
        end
        def add_ten(): Void
          acc = acc + 10
        end
        def main(): Int
          add_five()
          add_ten()
          add_five()
          return acc
        end
        """, 20)
    end
  end

  return qspec_main()
end
