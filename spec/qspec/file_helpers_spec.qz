## File Helpers Tests
##
## Contract:
##   1. File_write_all / file_read_all.
##   2. File_read_lines.
##   3. File_append.
##   4. File_copy.
##   5. File_exists_at.
##   6. FileHandle.
import * from qspec
import * from io/file

def main(): Int
  describe("file_write_all / file_read_all") do ->
    it("writes and reads back content") do ->
      assert_eq(fh_write_read_test(), 1)
    end
  end

  describe("file_read_lines") do ->
    it("splits file into lines") do ->
      assert_eq(fh_read_lines_test(), 1)
    end
  end

  describe("file_append") do ->
    it("appends to existing file") do ->
      assert_eq(fh_append_test(), 1)
    end
  end

  describe("file_copy") do ->
    it("copies file contents") do ->
      assert_eq(fh_copy_test(), 1)
    end
  end

  describe("file_exists_at") do ->
    it("returns true for existing file") do ->
      assert_eq(fh_exists_test(), 1)
    end

    it("returns false for nonexistent file") do ->
      assert_eq(file_exists_at("/tmp/qz_nonexistent_xyz.txt"), 0)
    end
  end

  describe("FileHandle") do ->
    it("opens and writes via handle") do ->
      assert_eq(fh_handle_test(), 1)
    end

    it("reports is_open correctly") do ->
      assert_eq(fh_is_open_test(), 1)
    end
  end

  return qspec_main()
end

def fh_write_read_test(): Int
  file_write_all("/tmp/qz_fh_wr.txt", "hello world")
  var content = file_read_all("/tmp/qz_fh_wr.txt")
  file_delete("/tmp/qz_fh_wr.txt")
  if content == "hello world"
    return 1
  end
  return 0
end

def fh_read_lines_test(): Int
  file_write_all("/tmp/qz_fh_lines.txt", "alpha\nbeta\ngamma")
  var lines = file_read_lines("/tmp/qz_fh_lines.txt")
  file_delete("/tmp/qz_fh_lines.txt")
  if lines.size == 3
    return 1
  end
  return 0
end

def fh_append_test(): Int
  file_write_all("/tmp/qz_fh_app.txt", "hello")
  file_append("/tmp/qz_fh_app.txt", " world")
  var content = file_read_all("/tmp/qz_fh_app.txt")
  file_delete("/tmp/qz_fh_app.txt")
  if content == "hello world"
    return 1
  end
  return 0
end

def fh_copy_test(): Int
  file_write_all("/tmp/qz_fh_src.txt", "copy me")
  file_copy("/tmp/qz_fh_src.txt", "/tmp/qz_fh_dst.txt")
  var content = file_read_all("/tmp/qz_fh_dst.txt")
  file_delete("/tmp/qz_fh_src.txt")
  file_delete("/tmp/qz_fh_dst.txt")
  if content == "copy me"
    return 1
  end
  return 0
end

def fh_exists_test(): Int
  file_write_all("/tmp/qz_fh_exist.txt", "x")
  var exists = file_exists_at("/tmp/qz_fh_exist.txt")
  file_delete("/tmp/qz_fh_exist.txt")
  if exists
    return 1
  end
  return 0
end

def fh_handle_test(): Int
  var fh = file_open("/tmp/qz_fh_handle.txt", "w")
  fh.write_str("via handle")
  fh.close()
  var content = file_read_all("/tmp/qz_fh_handle.txt")
  file_delete("/tmp/qz_fh_handle.txt")
  if content == "via handle"
    return 1
  end
  return 0
end

def fh_is_open_test(): Int
  var fh = file_open("/tmp/qz_fh_isopen.txt", "w")
  var open_before = fh.is_open()
  fh.close()
  var open_after = fh.is_open()
  file_delete("/tmp/qz_fh_isopen.txt")
  if open_before
    if open_after == false
      return 1
    end
  end
  return 0
end
