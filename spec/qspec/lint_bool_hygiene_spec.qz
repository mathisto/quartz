## Lint Bool Hygiene Checker Tests
##
## Tests the bool hygiene checking logic from tools/lint.qz.
## Functions are inlined here because tools/ is not on the
## standard import path for QSpec test files.
##
## Contract:
##   1. Counts multiple warnings on.
##   2. Detects != false.
##   3. Detects != true.
##   4. Detects == false.
##   5. Detects == true.
##   6. Detects file_exists() == 0.

import * from qspec

# ========================================================================
# Inlined helpers from tools/lint.qz
# ========================================================================

def _bhyg_strip(line: String): String
  var result = ""
  var pos = 0
  len = line.size
  while pos < len
    c = line.str_byte_at(pos)
    if c == '#'
      return result
    elsif c == '"'
      pos += 1
      while pos < len
        sc = line.str_byte_at(pos)
        if sc == '\\'
          pos += 2
        elsif sc == '"'
          pos += 1
          break
        else
          pos += 1
        end
      end
    else
      result = result + str_from_char(c)
      pos += 1
    end
  end
  return result
end

def _bhyg_has_pred(text: String): Bool
  return str_contains(text, "is_") or str_contains(text, "has_") or
         str_contains(text, "contains(") or str_contains(text, "starts_with(") or
         str_contains(text, "ends_with(") or str_contains(text, "_eq(") or
         str_contains(text, "exists(") or str_contains(text, "closed(")
end

def check_bool_hygiene(source: String): Int
  var warnings = 0
  var line_num = 1
  var pos = 0
  len = source.size
  var line_start = 0

  while pos <= len
    if pos == len or source.str_byte_at(pos) == '\n'
      var line = str_byte_slice(source, line_start, pos)
      var clean = _bhyg_strip(line)

      if str_contains(clean, "== true")
        warnings += 1
      elsif str_contains(clean, "!= false")
        warnings += 1
      elsif str_contains(clean, "== false")
        warnings += 1
      elsif str_contains(clean, "!= true")
        warnings += 1
      end

      if str_contains(clean, ") == 1") or str_contains(clean, ") == 0")
        if _bhyg_has_pred(clean)
          warnings += 1
        end
      end

      line_num += 1
      line_start = pos + 1
    end
    pos += 1
  end

  return warnings
end

# ========================================================================
# Tests
# ========================================================================

def main(): Int
  describe("check_bool_hygiene") do ->

    # =====================================================================
    # Tier 1: literal boolean comparisons
    # =====================================================================

    it("detects == true") do ->
      source = "if x == true\n  do_thing()\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects == false") do ->
      source = "if x == false\n  do_thing()\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects != true") do ->
      source = "if x != true\n  do_thing()\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects != false") do ->
      source = "if x != false\n  do_thing()\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("ignores == true inside string literal") do ->
      source = "x = \"if y == true\"\n"
      assert_eq(check_bool_hygiene(source), 0)
    end

    it("ignores == false inside comment") do ->
      source = "# if x == false\ndo_thing()\n"
      assert_eq(check_bool_hygiene(source), 0)
    end

    it("returns 0 for clean code") do ->
      source = "if x\n  do_thing()\nend\nif not y\n  other()\nend\n"
      assert_eq(check_bool_hygiene(source), 0)
    end

    it("counts multiple warnings on different lines") do ->
      source = "if a == true\nend\nif b == false\nend\n"
      assert_eq(check_bool_hygiene(source), 2)
    end

    # =====================================================================
    # Tier 2: known predicates with == 1 / == 0
    # =====================================================================

    it("detects is_empty() == 1") do ->
      source = "if is_empty(x) == 1\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects str_contains() == 0") do ->
      source = "if str_contains(s, \"a\") == 0\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects str_eq() == 1") do ->
      source = "if str_eq(a, b) == 1\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("detects file_exists() == 0") do ->
      source = "if file_exists(path) == 0\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 1)
    end

    it("ignores unknown_func() == 1") do ->
      source = "if compute(x) == 1\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 0)
    end

    it("ignores numeric count == 1") do ->
      source = "if count == 1\n  return\nend\n"
      assert_eq(check_bool_hygiene(source), 0)
    end
  end

  return qspec_main()
end
