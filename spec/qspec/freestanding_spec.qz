## Freestanding Tests
##
## Contract:
##   1. Freestanding Target.
##   2. Aarch64-unknown-none.
##   3. X86_64-unknown-none-elf.
##   4. Extern var.
import * from qspec
import * from qspec/subprocess

def _freestanding_ir_find_after(haystack: String, needle: String, start: Int): Int
  var i = start
  var last = str_byte_len(haystack) - str_byte_len(needle)
  while i <= last
    var j = 0
    while j < str_byte_len(needle) and str_byte_at(haystack, i + j) == str_byte_at(needle, j)
      j = j + 1
    end
    if j == str_byte_len(needle)
      return i
    end
    i = i + 1
  end
  return -1
end

def _freestanding_ir_find_between(haystack: String, needle: String, start: Int, limit: Int): Int
  var needle_len = str_byte_len(needle)
  var haystack_len = str_byte_len(haystack)
  if start < 0 or limit < start or limit > haystack_len or needle_len > limit - start
    return -1
  end
  var i = start
  var last = limit - needle_len
  while i <= last
    var j = 0
    while j < needle_len and str_byte_at(haystack, i + j) == str_byte_at(needle, j)
      j = j + 1
    end
    if j == needle_len
      return i
    end
    i = i + 1
  end
  return -1
end

def main(): Int
  describe("Freestanding Target") do ->
    describe("aarch64-unknown-none") do ->
      it("emits no OS / I/O libc declarations") do ->
        # I/O + threading are hard-absent for freestanding — no kernel has
        # printf / pthread / write / puts. The few C-ABI symbols that
        # *are* declared (malloc/free/memcpy/memset/qsort) are link-time
        # extern declarations the user resolves with their own
        # allocator + mem helpers. See "emits link-time allocator extern
        # declarations" for the positive case.
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_not_contains_with_flags(src, "declare i64 @puts", flags)
        assert_ir_not_contains_with_flags(src, "declare i64 @printf", flags)
        assert_ir_not_contains_with_flags(src, "declare i64 @write", flags)
        assert_ir_not_contains_with_flags(src, "@pthread", flags)
      end

      it("emits link-time allocator / mem helper extern declarations") do ->
        # Rust no_std pattern: the compiler emits `extern "C"` declarations
        # for `malloc` / `free` / `memcpy` / `memset` / `qsort`; the
        # downstream consumer (kernel, embedded project) supplies them
        # at link time from their own bump / slab allocator + compiler-rt
        # mem helpers + sort implementation. Without these declarations,
        # LLC rejects any non-trivial freestanding IR with
        # `use of undefined value '@malloc'`.
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_contains_with_flags(src, "declare noalias ptr @malloc(i64)", flags)
        assert_ir_contains_with_flags(src, "declare void @free(ptr)", flags)
        assert_ir_contains_with_flags(src, "declare ptr @memcpy", flags)
        assert_ir_contains_with_flags(src, "declare void @memset", flags)
        assert_ir_contains_with_flags(src, "declare void @qsort", flags)
      end

      it("does not emit @main wrapper") do ->
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "define i32 @main", flags)
        assert_ir_not_contains_with_flags(src, "@qz_argc", flags)
        assert_ir_not_contains_with_flags(src, "@qz_argv", flags)
      end

      it("emits correct aarch64 target triple") do ->
        assert_ir_contains_with_flags("def main(): Int = 0", "aarch64-unknown-none", "--target aarch64-unknown-none")
      end

      it("still emits user functions for freestanding") do ->
        var flags = "--target aarch64-unknown-none"
        var src = """
          def helper(): Int = 42
          def main(): Int = helper()
        """
        assert_ir_contains_with_flags(src, "@helper", flags)
        assert_ir_contains_with_flags(src, "@qz_main", flags)
      end

      it("compiles bare metal program with volatile_store") do ->
        var flags = "--target aarch64-unknown-none"
        var src = """
          const UART_BASE = 0x09000000

          def uart_putc(c: Int): Void
            volatile_store<U8>(UART_BASE, c)
          end

          def main(): Int
            uart_putc(72)
            return 0
          end
        """
        assert_ir_contains_with_flags(src, "store volatile i8", flags)
        assert_ir_not_contains_with_flags(src, "declare i64 @puts", flags)
      end
    end

    describe("x86_64-unknown-none-elf") do ->
      it("emits correct x86_64 freestanding triple") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "x86_64-unknown-none-elf", flags)
        assert_ir_not_contains_with_flags(src, "declare i64 @puts", flags)
        assert_ir_not_contains_with_flags(src, "define i32 @main", flags)
      end
    end

    describe("panic + backtrace helpers are stub-only (no libc)") do ->
      # Hosted builds emit libc-backed versions of qz_overflow_panic /
      # qz_bounds_panic / qz_map_key_panic / qz_print_backtrace that call
      # @write / @sprintf / @longjmp / @abort / @backtrace / etc. Those
      # symbols don't exist in a freestanding target, so the helpers
      # must be stub-only (unreachable body for panics, ret void for
      # backtrace). A follow-up will route panics through @panic_handler
      # when one is registered; the stub form is load-bearing for the
      # ELF link TODAY.
      it("qz_bounds_panic is a freestanding stub") do ->
        # The hosted qz_bounds_panic body formats an index/size error
        # message via sprintf into an `@.bounds_fmt` constant, writes it
        # to stderr, then conditionally longjmp's or abort's. The
        # freestanding stub is `unreachable` only — no @.bounds_fmt
        # constant, no sprintf call (unrelated prelude-panic paths may
        # still reference @longjmp, which is a separate blocker for the
        # full freestanding-link story; this test scopes to
        # qz_bounds_panic-body structure only).
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_contains_with_flags(src, "define void @qz_bounds_panic", flags)
        assert_ir_not_contains_with_flags(src, "@.bounds_fmt", flags)
        assert_ir_not_contains_with_flags(src, "@sprintf", flags)
      end

      it("qz_print_backtrace is a no-op for freestanding (no @backtrace ref)") do ->
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_contains_with_flags(src, "define void @qz_print_backtrace", flags)
        assert_ir_not_contains_with_flags(src, "@backtrace_symbols_fd", flags)
        assert_ir_not_contains_with_flags(src, "declare i32 @backtrace", flags)
      end

      it("@abort is defined (not just declared) for freestanding") do ->
        # Intrinsic handlers for unwrap / unreachable / assert emit
        # inline `call void @abort()` in their panic paths. Freestanding
        # must define @abort itself as `noreturn + unreachable` so the
        # linker is happy without libc.
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_contains_with_flags(src, "define void @abort() noreturn", flags)
      end
    end

    describe("fuel_check instrumentation is suppressed") do ->
      # BEAM-style reduction counting via fuel_check() calls
      # `@__qz_fuel_refill` and reads/writes `@__qz_sched_fuel`. Those
      # symbols are userspace-scheduler-only; `cg_emit_runtime_decls`
      # skips their definitions for freestanding targets. Leaving the
      # instrumentation in place makes LLC reject the IR with
      # `use of undefined value '@__qz_fuel_refill'`. MIR lowering
      # must skip the instrumentation entirely for freestanding.
      it("does not emit @__qz_fuel_refill calls for aarch64-unknown-none") do ->
        var flags = "--target aarch64-unknown-none"
        var src = """
          def helper(x: Int): Int = x + 1
          def main(): Int
            var acc = 0
            for i in 0..10
              acc = acc + helper(i)
            end
            return acc
          end
        """
        assert_ir_not_contains_with_flags(src, "@__qz_fuel_refill", flags)
        assert_ir_not_contains_with_flags(src, "@__qz_sched_fuel", flags)
      end

      it("does not emit @__qz_fuel_refill calls for x86_64-unknown-none-elf") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = """
          def helper(x: Int): Int = x + 1
          def main(): Int
            var acc = 0
            for i in 0..10
              acc = acc + helper(i)
            end
            return acc
          end
        """
        assert_ir_not_contains_with_flags(src, "@__qz_fuel_refill", flags)
        assert_ir_not_contains_with_flags(src, "@__qz_sched_fuel", flags)
      end

      it("STILL emits @__qz_fuel_refill for hosted builds (regression check)") do ->
        # Fuel_check is load-bearing for the userspace M:N scheduler's
        # cooperative preemption. The freestanding skip must not leak
        # into hosted builds.
        var src = """
          def helper(x: Int): Int = x + 1
          def main(): Int
            var acc = 0
            for i in 0..10
              acc = acc + helper(i)
            end
            return acc
          end
        """
        assert_ir_contains(src, "@__qz_sched_fuel")
      end
    end

    describe("prelude panic path is suppressed for freestanding (no @.newline / @__qz_panic_jmpbuf_get / @write)") do ->
      # Without this skip, the auto-emitted prelude functions (unwrap,
      # assert, panic) would emit the libc panic path — write + strlen
      # + @.newline + @.panic.prefix + __qz_panic_jmpbuf_get + longjmp +
      # exit — and LLC would reject the IR with `use of undefined value
      # '@.newline'`. Freestanding + no @panic_handler = plain
      # `unreachable`.
      #
      # Pre-B.3 this also asserted `not_contains "call void @longjmp"`.
      # B.3 made `@__qz_effect_perform`'s `do_unwind` block a legitimate
      # longjmp-via-libc_stubs.c emit site (kind=2 algebraic-effect unwind,
      # not the panic path). The remaining @.newline / @.panic.prefix /
      # @__qz_panic_jmpbuf_get / @write checks pin down the *panic-path*
      # leak we actually care about.
      it("trivial freestanding program does not reference libc panic globals") do ->
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_not_contains_with_flags(src, "@.newline", flags)
        assert_ir_not_contains_with_flags(src, "@.panic.prefix", flags)
        assert_ir_not_contains_with_flags(src, "@__qz_panic_jmpbuf_get", flags)
        assert_ir_not_contains_with_flags(src, "call i64 @write", flags)
      end

      it("freestanding emits sort + reverse helpers (libc-free, prelude needs)") do ->
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        # These two helpers are referenced by the auto-emitted prelude
        # `sorted()` and `reversed()` functions. Without the
        # freestanding-branch emission, LLC rejects with `use of
        # undefined value '@qz_sort_cmp_asc'` / '@qz_vec_sort' /
        # '@qz_vec_reverse'.
        assert_ir_contains_with_flags(src, "define private i32 @qz_sort_cmp_asc", flags)
        assert_ir_contains_with_flags(src, "define void @qz_vec_sort", flags)
        assert_ir_contains_with_flags(src, "define void @qz_vec_reverse", flags)
      end

      it("freestanding declares @realloc as extern") do ->
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 42"
        assert_ir_contains_with_flags(src, "declare noalias ptr @realloc(ptr, i64)", flags)
      end
    end

    describe("extern var") do ->
      it("supports extern var declarations") do ->
        var src = """
          extern var UART_BASE: Int
          def main(): Int = 0
        """
        assert_ir_contains(src, "external global i64")
      end
    end

    describe("D.11 Phase 7 / B.1.b — per-task effect-stack bridge") do ->
      # Freestanding now backs the effect-stack arrays per-task via
      # process-global ptr-base symbols whose values are save/restored
      # to/from Task slots on every context switch. Through B.1.b:
      # install/uninstall/save/restore are real (no longer no-op stubs);
      # perform/suspend/gen_stash/take/scoped_* are still stubs (B.3
      # makes perform real, B.4 makes suspend real).

      it("emits the 4 scalar globals as process-global i64 zero-init") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_top = internal global i64 0", flags)
        assert_ir_contains_with_flags(src, "@__qz_current_scope_handle = internal global i64 0", flags)
        assert_ir_contains_with_flags(src, "@__qz_scoped_ctx_top = internal global i64 0", flags)
        assert_ir_contains_with_flags(src, "@__qz_alloc_in_handler = internal global i64 0", flags)
      end

      it("emits the 7 array-base globals as ptr null (strip backs the pointer)") do ->
        # Pre-B.1.b emitted only @__qz_effect_stack_results as
        # `[256 x i64] zeroinitializer`; B.1.b changes all 7 to
        # `ptr null` so the per-task 16 KiB strip from
        # task_effect_strip_alloc backs the actual storage.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_names = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_handlers = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_bufs = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_op_filters = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_results = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_state_slots = internal global ptr null", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_stack_resumed = internal global ptr null", flags)
        # Negative: the pre-B.1.b `[256 x i64]` form must no longer appear
        # for results (the symbol the prior stub block actually emitted).
        assert_ir_not_contains_with_flags(src, "@__qz_effect_stack_results = internal global [256 x i64]", flags)
      end

      it("install body calls __qz_eff_ensure_strip and GEPs through loaded base") do ->
        # The compiler-emitted install body must (1) call the kernel-side
        # strip ensurer up front, (2) check the names base is non-null
        # (skip if main context / strip-alloc failed), (3) bounds-check
        # top against cap=256, (4) load each array base from its global
        # and GEP through it. No `[256 x i64]` indexing — that's the
        # pre-B.1.b TLS-array shape.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_handle_install", flags)
        assert_ir_contains_with_flags(src, "call i64 @__qz_eff_ensure_strip()", flags)
        assert_ir_contains_with_flags(src, "load ptr, ptr @__qz_effect_stack_names", flags)
        assert_ir_contains_with_flags(src, "getelementptr inbounds i64, ptr %names, i64 %top", flags)
        # Negative: no TLS-array-style indexing through the global
        # (`getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names`).
        assert_ir_not_contains_with_flags(src, "getelementptr inbounds [256 x i64], ptr @__qz_effect_stack_names", flags)
      end

      it("uninstall body decrements top (no strip access needed)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_handle_uninstall", flags)
        # Old asymmetry preserved: pop just decrements top.
        assert_ir_contains_with_flags(src, "load i64, ptr @__qz_effect_stack_top", flags)
      end

      it("emits __qz_effect_save_to_task with the 11-slot shape") do ->
        # Save copies the 4 scalar + 7 ptr-base globals into the
        # caller-supplied task's TASK_EFFECT_STACK_* slots. Task offsets
        # 80/88/.../160 must match hello_x86.qz constants. Guards
        # against t==0 (main context).
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_save_to_task(i64 %t)", flags)
        assert_ir_contains_with_flags(src, "%is_zero = icmp eq i64 %t, 0", flags)
        # Each task-slot GEP at the documented offset.
        assert_ir_contains_with_flags(src, "getelementptr inbounds i8, ptr %t_p, i64 80", flags)
        assert_ir_contains_with_flags(src, "getelementptr inbounds i8, ptr %t_p, i64 88", flags)
        assert_ir_contains_with_flags(src, "getelementptr inbounds i8, ptr %t_p, i64 144", flags)
        assert_ir_contains_with_flags(src, "getelementptr inbounds i8, ptr %t_p, i64 160", flags)
        # Round-trip: save loads scalars and writes them through the slot ptrs.
        assert_ir_contains_with_flags(src, "load i64, ptr @__qz_effect_stack_top", flags)
        assert_ir_contains_with_flags(src, "load ptr, ptr @__qz_effect_stack_names", flags)
      end

      it("emits __qz_effect_restore_from_task as the inverse of save") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_restore_from_task(i64 %t)", flags)
        # Restore writes through the global symbols.
        assert_ir_contains_with_flags(src, "store i64 %v_top, ptr @__qz_effect_stack_top", flags)
        assert_ir_contains_with_flags(src, "store ptr %v_names, ptr @__qz_effect_stack_names", flags)
        assert_ir_contains_with_flags(src, "store i64 %v_scope, ptr @__qz_current_scope_handle", flags)
      end

      it("perform / gen_stash / take / scoped_ctx_{push,pop} still defined post-B.4") do ->
        # B.1.b only flipped install/uninstall + save/restore; B.3 made
        # perform real; B.4 moved suspend out of the runtime emit into a
        # kernel-side Quartz def. The remaining stubs stay so any IR
        # mir-lowering emits still links.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_perform", flags)
        assert_ir_contains_with_flags(src, "define void @__qz_gen_stash", flags)
        assert_ir_contains_with_flags(src, "define i64 @__qz_gen_take_stashed", flags)
        assert_ir_contains_with_flags(src, "define void @__qz_scoped_ctx_push", flags)
        assert_ir_contains_with_flags(src, "define void @__qz_scoped_ctx_pop", flags)
        # Post-B.4: @__qz_effect_suspend is NOT defined in the runtime emit
        # block. The kernel's `def __qz_effect_suspend(): Int` in
        # tools/baremetal/hello_x86.qz provides the symbol at link time
        # (same in-module-define pattern as @__qz_eff_ensure_strip).
        assert_ir_not_contains_with_flags(src, "define i64 @__qz_effect_suspend()", flags)
      end

      it("does NOT forward-declare __qz_eff_ensure_strip (kernel emits the define)") do ->
        # llc rejects `declare i64 @f()` + `define i64 @f()` in the
        # same module ("invalid redefinition"). The kernel's
        # `def __qz_eff_ensure_strip(): Void` already emits a `define i64`;
        # the freestanding bridge must NOT emit a competing `declare`.
        # Call resolves from the in-module define without it.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "declare i64 @__qz_eff_ensure_strip", flags)
        assert_ir_not_contains_with_flags(src, "declare void @__qz_eff_ensure_strip", flags)
      end
    end

    describe("D.11 Phase 7 / B.2 — real setjmp/longjmp via libc_stubs.c") do ->
      # Pre-B.2 emitted no-op `define i32 @setjmp { ret 0 }` and
      # `define void @longjmp { unreachable }` definitions in the
      # freestanding block. With B.3's real `__qz_effect_perform` coming,
      # those stubs would silently swallow throws. B.2 swaps them for
      # extern declarations resolved at link to the x86_64 SysV inline-asm
      # implementations in tools/baremetal/libc_stubs.c.

      it("emits setjmp as a returns_twice extern (not a stub define)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "declare i32 @setjmp(ptr) returns_twice nounwind", flags)
        # Negative: the pre-B.2 stub define must no longer appear.
        assert_ir_not_contains_with_flags(src, "define i32 @setjmp(ptr %buf) returns_twice nounwind", flags)
      end

      it("emits longjmp as a noreturn extern (not a stub define)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "declare void @longjmp(ptr, i32) noreturn nounwind", flags)
        # Negative: the pre-B.2 stub define must no longer appear.
        assert_ir_not_contains_with_flags(src, "define void @longjmp(ptr %buf, i32 %v) noreturn nounwind", flags)
      end

      it("aarch64 also gets the declare-shape (no stub define lingers)") do ->
        # The setjmp/longjmp emit is shared across all freestanding
        # targets; aarch64 must not regress to the pre-B.2 stub form
        # even though baremetal:verify_hello_aarch64 currently can't
        # exercise the runtime (libc_stubs.c rdtsc break, pre-existing
        # since commit 31dd4ff4).
        var flags = "--target aarch64-unknown-none"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "declare i32 @setjmp(ptr) returns_twice nounwind", flags)
        assert_ir_contains_with_flags(src, "declare void @longjmp(ptr, i32) noreturn nounwind", flags)
        assert_ir_not_contains_with_flags(src, "define i32 @setjmp(ptr %buf) returns_twice nounwind", flags)
        assert_ir_not_contains_with_flags(src, "define void @longjmp(ptr %buf, i32 %v) noreturn nounwind", flags)
      end
    end

    describe("D.11 Phase 7 / B.3 — real __qz_effect_perform dispatch") do ->
      # Pre-B.3 emitted `define i64 @__qz_effect_perform ... ret i64 0` —
      # a stub that swallowed every perform with no diagnostic. B.3 lifts
      # the hosted kind 0/1/2/3 dispatch into a ptr-deref shape (array
      # bases loaded from per-task strip pointers, not from TLS array
      # symbols). Three new scalar globals, two new const strings, a
      # cstr_eq helper, an unhandled-halt thunk, and a real argv_load
      # round out the emit.

      it("emits the 3 new perform-dispatch scalar globals") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@__qz_effect_current_install_idx = internal global i64 -1, align 8", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_current_kind = internal global i64 0, align 8", flags)
        # park_rv defaults to POLL_READY (1) so the kind=3 dispatch reads
        # "handler aborted" by default — same convention as hosted.
        assert_ir_contains_with_flags(src, "@__qz_effect_park_rv = internal global i64 1, align 8", flags)
      end

      it("emits @__qz_eff_name_alloc and @__qz_effect_unhandled_msg constants") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@__qz_eff_name_alloc = internal unnamed_addr constant [6 x i8] c\"Alloc\\00\"", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_unhandled_msg = internal unnamed_addr constant [27 x i8]", flags)
      end

      it("emits @__qz_effect_cstr_eq (byte-by-byte null-terminated compare)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i1 @__qz_effect_cstr_eq(ptr %a, ptr %b) nounwind", flags)
      end

      it("emits @__qz_effect_unhandled thunk into kernel halt") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_unhandled(ptr %eff, ptr %op) noreturn nounwind", flags)
        # Calls the kernel-provided extern (no forward `declare`).
        assert_ir_contains_with_flags(src, "call i64 @__qz_eff_unhandled_halt(ptr %eff, ptr %op)", flags)
        # And: no competing `declare` for the kernel extern (would crash llc).
        assert_ir_not_contains_with_flags(src, "declare i64 @__qz_eff_unhandled_halt", flags)
      end

      it("emits real @__qz_effect_perform body (not the pre-B.3 stub)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        # The new body has labelled basic blocks; the pre-B.3 stub had
        # one trivial `ret i64 0` instruction. We sniff for two markers
        # uniquely produced by the new dispatch.
        assert_ir_contains_with_flags(src, "%names_base = load ptr, ptr @__qz_effect_stack_names, align 8", flags)
        assert_ir_contains_with_flags(src, "%is_k3 = icmp eq i64 %kind, 3", flags)
        # The bypass-during-handler save/restore is the Alloc-aware
        # gate; absent only if we accidentally re-emit the stub.
        assert_ir_contains_with_flags(src, "%is_alloc.a3b = call i1 @__qz_effect_cstr_eq(ptr %eff, ptr @__qz_eff_name_alloc)", flags)
      end

      it("emits real @__qz_effect_argv_load body (not the pre-B.3 stub)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        # The pre-B.3 stub returned 0 unconditionally. The real body
        # gep+loads the slot — sniff the load.
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_argv_load(i64 %argv, i64 %i) nounwind", flags)
        assert_ir_contains_with_flags(src, "%slot = getelementptr inbounds i64, ptr %p, i64 %i", flags)
      end

      it("@__qz_effect_suspend define lives in kernel, not runtime emit") do ->
        # Post-B.4: the runtime emit declines to emit @__qz_effect_suspend
        # itself — the kernel's `def __qz_effect_suspend(): Int` provides
        # the symbol. When the consumer compiles a program without the
        # kernel def, a `declare` is auto-emitted to satisfy llc — that's
        # expected and correct LLVM behavior. The assertion is just that
        # no `define` is emitted from the runtime block.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "define i64 @__qz_effect_suspend()", flags)
      end
    end

    describe("D.11 Phase 7 / B.4 — kernel-side __qz_effect_suspend + park/wake") do ->
      # B.4 moves @__qz_effect_suspend from a runtime-emitted stub into a
      # kernel-side Quartz def, and adds three pieces of plumbing in the
      # runtime emit block: (a) two Quartz-callable shims for the
      # park_rv global (`_load` / `_store`), (b) TASK_PARK_RV slot (i64
      # at offset 176) saved/restored alongside the other 11 globals,
      # (c) the suspend stub define is gone.

      it("emits @__qz_effect_park_rv_load shim (Quartz-callable)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_park_rv_load() nounwind", flags)
        assert_ir_contains_with_flags(src, "load i64, ptr @__qz_effect_park_rv, align 8", flags)
      end

      it("emits @__qz_effect_park_rv_store shim (Quartz-callable)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_park_rv_store(i64 %v) nounwind", flags)
        assert_ir_contains_with_flags(src, "store i64 %v, ptr @__qz_effect_park_rv, align 8", flags)
      end

      it("save_to_task includes TASK_PARK_RV (offset 176)") do ->
        # Park_rv is the 12th saved item — the only new one B.4 adds.
        # The kind=3 handler that called __qz_effect_park stashes a
        # negative sentinel; suspend reads it. Without save/restore the
        # sentinel would leak to the next task scheduled on the slot.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "%s_park_rv = getelementptr inbounds i8, ptr %t_p, i64 176", flags)
        assert_ir_contains_with_flags(src, "%v_park_rv = load i64, ptr @__qz_effect_park_rv, align 8", flags)
        assert_ir_contains_with_flags(src, "store i64 %v_park_rv, ptr %s_park_rv, align 8", flags)
      end

      it("restore_from_task includes TASK_PARK_RV (offset 176)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        # The restore side loads from the slot then stores into the
        # global @__qz_effect_park_rv — the inverse of save.
        assert_ir_contains_with_flags(src, "store i64 %v_park_rv, ptr @__qz_effect_park_rv, align 8", flags)
      end

      it("no leftover B.3-era @__qz_effect_suspend stub define") do ->
        # The pre-B.4 define was `define i64 @__qz_effect_suspend() nounwind { ret i64 1 }`.
        # Verify both the open and the body are gone.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "define i64 @__qz_effect_suspend() nounwind {", flags)
      end
    end

    describe("D.11 Phase 7 / B.5d — Path A: @cfg-aware channel codegen") do ->
      # Stdlib channel intrinsics (channel_new, send, recv, channel_close,
      # channel_closed, channel_size, channel_capacity, channel_is_empty,
      # channel_is_full) lower to direct calls of the kernel's bare
      # chan_* surface (chan_new, chan_send, chan_recv, chan_close,
      # chan_closed, chan_count, chan_cap) when target is freestanding.
      # The hosted path keeps raw pthread_*/inline-ABI emission untouched.
      #
      # Kernel-side integration smoke is deferred to B.5d.1 — auto-
      # synthesized __Future_*$poll wrappers (PASS 1.3 in mir_lower)
      # pull in hosted-runtime symbols (@__qz_current_frame, pthread_*,
      # @__qz_waiter_notify_all, etc.) for ANY EFFECT_SUSPEND function;
      # those wrappers are dead code in kernel context (kernel uses
      # go_fn + seeded stacks, not Future-poll machinery) but the
      # linker still resolves them. B.5d.1 will gate PASS 1.3 on
      # freestanding to skip wrapper synthesis entirely. Tracked in
      # docs/design/D11_FREESTANDING_EFFECT_BRIDGE.md B.5 section.

      it("channel_new emits @chan_new call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(8)\n  return ch\nend"
        assert_ir_contains_with_flags(src, "; freestanding channel_new → kernel chan_new", flags)
        assert_ir_contains_with_flags(src, "call i64 @chan_new(i64 ", flags)
        # Negative: hosted pthread_mutex_init should NOT appear
        assert_ir_not_contains_with_flags(src, "call i32 @pthread_mutex_init", flags)
      end

      it("send emits @chan_send call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(8)\n  send(ch, 42)\n  return 0\nend"
        assert_ir_contains_with_flags(src, "; freestanding send → kernel chan_send", flags)
        assert_ir_contains_with_flags(src, "call i64 @chan_send(i64 ", flags)
        # Negative: hosted pthread-cond signal path should NOT appear
        assert_ir_not_contains_with_flags(src, "call i32 @pthread_cond_signal", flags)
      end

      it("recv emits @chan_recv call (when not wrapped in async target)") do ->
        # NOTE: A bare `def main(): Int = recv(ch)` works because main isn't
        # an EFFECT_SUSPEND-registerable target. Goroutine bodies that
        # use bare `recv` trigger __Future_*$poll wrapper synthesis —
        # that's B.5d.1's scope.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(8)\n  send(ch, 42)\n  return recv(ch)\nend"
        assert_ir_contains_with_flags(src, "; freestanding recv → kernel chan_recv", flags)
        assert_ir_contains_with_flags(src, "call i64 @chan_recv(i64 ", flags)
      end

      it("channel_close emits @chan_close call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(4)\n  channel_close(ch)\n  return 0\nend"
        assert_ir_contains_with_flags(src, "call i64 @chan_close(i64 ", flags)
      end

      it("channel_closed emits @chan_closed call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(4)\n  return channel_closed(ch)\nend"
        assert_ir_contains_with_flags(src, "call i64 @chan_closed(i64 ", flags)
      end

      it("channel_size emits @chan_count call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(4)\n  return channel_size(ch)\nend"
        assert_ir_contains_with_flags(src, "call i64 @chan_count(i64 ", flags)
      end

      it("channel_capacity emits @chan_cap call") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var ch = channel_new(4)\n  return channel_capacity(ch)\nend"
        assert_ir_contains_with_flags(src, "call i64 @chan_cap(i64 ", flags)
      end

      it("channel_is_empty + channel_is_full derive from chan_count/cap") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src1 = "def main(): Int\n  var ch = channel_new(4)\n  if channel_is_empty(ch)\n    return 1\n  end\n  return 0\nend"
        assert_ir_contains_with_flags(src1, "; freestanding channel_is_empty → chan_count == 0", flags)
        var src2 = "def main(): Int\n  var ch = channel_new(4)\n  if channel_is_full(ch)\n    return 1\n  end\n  return 0\nend"
        assert_ir_contains_with_flags(src2, "; freestanding channel_is_full → chan_count == chan_cap", flags)
      end

      it("hosted target keeps pthread emit (no kernel chan_* calls)") do ->
        # Negative-direction smoke — verify the fork doesn't accidentally
        # fire on hosted. No --target flag = hosted default.
        var src = "def main(): Int\n  var ch = channel_new(8)\n  return ch\nend"
        # Hosted emits pthread_mutex_init; freestanding marker comment is absent.
        assert_ir_contains(src, "call i32 @pthread_mutex_init")
        assert_ir_not_contains(src, "; freestanding channel_new")
      end

      it("freestanding still has NO pthread/wrapper-dead-code symbols") do ->
        # Regression check: an early B.5d draft added dead-code link
        # stubs (@pthread_mutex_lock etc.) to satisfy auto-emitted
        # __Future_*$poll wrapper bodies. That broke the existing
        # "emits no OS / I/O libc declarations" + "does not emit
        # @__qz_sched_fuel" invariants in this same spec. The stubs
        # were reverted because they only partially mitigated the
        # blocker; full fix is B.5d.1 (gate PASS 1.3 wrapper synthesis
        # on freestanding). Keeps this assertion as a tripwire against
        # another stub-block attempt.
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_not_contains_with_flags(src, "define i32 @pthread_mutex_lock", flags)
        assert_ir_not_contains_with_flags(src, "@__qz_current_frame = internal global", flags)
        assert_ir_not_contains_with_flags(src, "@__qz_waiter_notify_all", flags)
      end
    end

    describe("D.11 Phase 7 / Phase 8a step 2 — kernel TCP listening-table fd-emulation") do ->
      # std/net/tcp.qz now has @cfg(os: "unknown") freestanding bodies
      # for tcp_listen / tcp_close_listener that delegate to kernel-side
      # `extern "C"` symbols `kern_tcp_listen` / `kern_tcp_close_listener`
      # (defined in tools/baremetal/hello_x86.qz). Freestanding IR must
      # call those externs, not POSIX socket/bind/listen/close.

      it("freestanding tcp_listen body calls @kern_tcp_listen") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => return tcp_close_listener(l)\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_listen", flags)
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_close_listener", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_listen", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_close_listener", flags)
      end

      it("freestanding tcp_listen body does NOT call POSIX socket/bind/listen") do ->
        # The hosted body (POSIX socket()/bind()/listen()/setsockopt) is
        # @cfg(not: os: "unknown")-gated; freestanding must replace the
        # whole call path with the kernel adapter. If any POSIX socket
        # call slips through, the freestanding link would fail (no
        # `socket` / `bind` / `listen` in libc_stubs.c).
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => return tcp_close_listener(l)\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, i64, i64) @socket", flags)
        assert_ir_not_contains_with_flags(src, "call i64 (i64, ptr, i64) @bind", flags)
        assert_ir_not_contains_with_flags(src, "call i64 (i64, i64) @listen", flags)
      end

      it("hosted tcp_listen keeps the POSIX path (regression check)") do ->
        # Negative-direction smoke: the @cfg(not: os: "unknown") gate
        # must NOT accidentally fire on hosted (where os: "macos" /
        # "linux" / "windows" should still take the POSIX body).
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => return tcp_close_listener(l)\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        # Hosted body's bind() call is signature-distinctive.
        assert_ir_contains(src, "@bind")
        assert_ir_not_contains(src, "@kern_tcp_listen")
      end
    end

    describe("D.11 Phase 7 / Phase 8a step 3 — kernel tcp_accept fd-emulation") do ->
      # std/net/tcp.qz now has an @cfg(os: "unknown") tcp_accept body
      # that delegates to extern "C" kern_tcp_accept (defined in
      # tools/baremetal/hello_x86.qz). Freestanding IR must call that
      # extern, not POSIX accept/socket_accept.

      it("freestanding tcp_accept body calls @kern_tcp_accept") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => match tcp_accept(l)\n      AcceptResult::Ok(s) => return tcp_close_listener(l)\n      AcceptResult::Err(e) => return -2\n    end\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_accept", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_accept", flags)
      end

      it("freestanding tcp_accept body does NOT call POSIX accept") do ->
        # The hosted body (POSIX socket_accept → accept syscall) is
        # @cfg(not: os: "unknown")-gated; freestanding replaces the
        # whole path with kern_tcp_accept. If accept slips through,
        # the freestanding link fails (no `accept` in libc_stubs.c).
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => match tcp_accept(l)\n      AcceptResult::Ok(s) => return tcp_close_listener(l)\n      AcceptResult::Err(e) => return -2\n    end\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, i64, i64) @accept", flags)
      end

      it("hosted tcp_accept keeps the POSIX accept path (regression check)") do ->
        # Negative-direction smoke: @cfg(not: os: "unknown") gate must
        # NOT fire on hosted. The hosted body calls socket_accept which
        # bottoms out at @accept in libc.
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  match tcp_listen(80)\n    ListenResult::Ok(l) => match tcp_accept(l)\n      AcceptResult::Ok(s) => return tcp_close_listener(l)\n      AcceptResult::Err(e) => return -2\n    end\n    ListenResult::Err(e) => return -1\n  end\nend\n"
        assert_ir_contains(src, "@accept")
        assert_ir_not_contains(src, "@kern_tcp_accept")
      end
    end

    describe("D.11 Phase 7 / Phase 8a step 4 — kernel async_tcp_read/write/tcp_close fd-emulation") do ->
      # std/net/tcp.qz now has @cfg(os: "unknown") freestanding bodies
      # for async_tcp_read / async_tcp_write / tcp_close that delegate to
      # kern_tcp_{read,write,close} (defined in tools/baremetal/hello_x86.qz).
      # Hosted async_tcp_read/write were @cfg(not: os: "wasi") in step 3;
      # step 4 swaps to an explicit OS list so freestanding gets its own
      # @cfg(os: "unknown") branch instead of falling through the negation.

      it("freestanding async_tcp_read body calls @kern_tcp_read") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int = async_tcp_read(0, 0, 1500)\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_read", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64, i64, i64) @kern_tcp_read", flags)
      end

      it("freestanding async_tcp_write body calls @kern_tcp_write") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int = async_tcp_write(0, 0, 22)\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_write", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64, i64, i64) @kern_tcp_write", flags)
      end

      it("freestanding async_tcp_read body does NOT call POSIX recvfrom or io_suspend") do ->
        # The hosted body (socket_recv → recvfrom; io_suspend on EAGAIN)
        # is @cfg(not: os: "unknown")-gated; freestanding must replace
        # the whole path with kern_tcp_read. (`declare @recvfrom` is
        # still emitted as a forward-decl from std/ffi/socket.qz — the
        # negative assertion targets the `call` site only.)
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int = async_tcp_read(0, 0, 1500)\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, ptr, i64, i64, ptr, ptr) @recvfrom", flags)
        assert_ir_not_contains_with_flags(src, "call void (i64) @io_suspend", flags)
      end

      it("freestanding async_tcp_write body does NOT call POSIX sendto") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int = async_tcp_write(0, 0, 22)\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, ptr, i64, i64, ptr, i64) @sendto", flags)
      end

      it("hosted async_tcp_read keeps the POSIX recvfrom path (regression check)") do ->
        var src = "import * from std/net/tcp\n\ndef main(): Int = async_tcp_read(0, 0, 1500)\n"
        # On macOS the hosted body's socket_recv lowers to recvfrom.
        assert_ir_contains(src, "@recvfrom")
        assert_ir_not_contains(src, "@kern_tcp_read")
      end

      it("freestanding tcp_close body calls @kern_tcp_close") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_stream(0, \"x\", 0)\n  return tcp_close(s)\nend\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_close", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_close", flags)
      end

      it("freestanding tcp_close body does NOT call POSIX shutdown/close") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_stream(0, \"x\", 0)\n  return tcp_close(s)\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, i64) @shutdown", flags)
      end

      it("hosted tcp_close keeps the POSIX shutdown path (regression check)") do ->
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_stream(0, \"x\", 0)\n  return tcp_close(s)\nend\n"
        assert_ir_contains(src, "@shutdown")
        assert_ir_not_contains(src, "@kern_tcp_close")
      end
    end

    describe("D.11 Phase 7 / Phase 8a step 5 — tcp_acceptable + nonblock + signal_on_flag") do ->
      # Step 5 closes Phase 8a's fd-emulation layer. Three deliverables:
      #   1. tcp_acceptable Selectable: @cfg-branched helper bodies wire
      #      to kern_tcp_try_accept + kern_tcp_acceptable_register_waker
      #      (kernel side-table active-wake) under freestanding.
      #   2. tcp_listener_set_nonblocking / socket::socket_set_nonblock /
      #      socket_set_blocking are no-ops in freestanding (kernel TCP
      #      is always non-blocking).
      #   3. signal_on_flag intrinsic is a no-op at the codegen-emit
      #      site under freestanding (no libc signal(); kernel routes
      #      shutdown via uart_shutdown → scope_cancel(root)).

      it("freestanding _tcp_acceptable_try_poll calls @kern_tcp_try_accept") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_acceptable(0)\n  match s.try_poll()\n    Some(_fd) => return 0\n    None => return 1\n  end\nend\n"
        assert_ir_contains_with_flags(src, "declare i64 @kern_tcp_try_accept", flags)
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_try_accept", flags)
      end

      it("freestanding _tcp_acceptable_try_poll does NOT call POSIX accept") do ->
        # The hosted body (socket_accept → accept) is @cfg(not: os:
        # "unknown")-gated; freestanding replaces the whole path with
        # kern_tcp_try_accept. (`declare @accept` is still emitted as a
        # forward-decl from std/ffi/socket.qz — negative assertion
        # targets call sites only.)
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_acceptable(0)\n  match s.try_poll()\n    Some(_fd) => return 0\n    None => return 1\n  end\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 (i64, ptr, ptr) @accept", flags)
      end

      it("freestanding _tcp_acceptable_register_waker calls kernel waker bridge") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_acceptable(0)\n  s.register_waker(0)\n  return 0\nend\n"
        assert_ir_contains_with_flags(src, "declare void @kern_tcp_acceptable_register_waker", flags)
        assert_ir_contains_with_flags(src, "call void (i64, i64) @kern_tcp_acceptable_register_waker", flags)
      end

      it("freestanding _tcp_acceptable_unregister_waker calls kernel teardown bridge") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_acceptable(0)\n  s.unregister_waker(0)\n  return 0\nend\n"
        assert_ir_contains_with_flags(src, "declare void @kern_tcp_acceptable_unregister_waker", flags)
        assert_ir_contains_with_flags(src, "call void (i64, i64) @kern_tcp_acceptable_unregister_waker", flags)
      end

      it("hosted _tcp_acceptable_try_poll keeps the POSIX accept path (regression check)") do ->
        var src = "import * from std/net/tcp\n\ndef main(): Int\n  var s = tcp_acceptable(0)\n  match s.try_poll()\n    Some(_fd) => return 0\n    None => return 1\n  end\nend\n"
        # On macOS the hosted body's socket_accept lowers to @accept.
        assert_ir_contains(src, "@accept")
        assert_ir_not_contains(src, "@kern_tcp_try_accept")
      end

      it("freestanding socket_set_nonblock body is a no-op (does NOT call @fcntl)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/ffi/socket\n\ndef main(): Int = socket_set_nonblock(0)\n"
        assert_ir_not_contains_with_flags(src, "call i32 (i32, i32, ...) @fcntl", flags)
      end

      it("hosted socket_set_nonblock keeps the fcntl path (regression check)") do ->
        var src = "import * from std/ffi/socket\n\ndef main(): Int = socket_set_nonblock(0)\n"
        assert_ir_contains(src, "@fcntl")
      end

      it("freestanding signal_on_flag emit is a no-op (does NOT call @qz_signal_on_flag)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "var g = atomic_new(0)\ndef main(): Int\n  signal_on_flag(15, g)\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "call void @qz_signal_on_flag", flags)
        # The mir-lowering still synthesizes the dest-slot zeroing
        # `add i64 0, 0`; the negative assertion alone is what proves
        # the gate works.
      end

      it("hosted signal_on_flag keeps the libc signal() path (regression check)") do ->
        var src = "var g = atomic_new(0)\ndef main(): Int\n  signal_on_flag(15, g)\n  return 0\nend\n"
        assert_ir_contains(src, "call void @qz_signal_on_flag")
      end
    end

    describe("D.11 Phase 7 / Phase 8b step 1 — http_server.qz freestanding @cfg branches") do ->
      # Step 8b.1 makes std/net/http_server.qz typecheck under
      # `--target x86_64-unknown-none-elf` AND replaces the POSIX
      # call paths reachable from `http_serve_supervised` with
      # kernel-bridge equivalents (async_tcp_read / async_tcp_write /
      # kern_tcp_close). Link-side residue (sprintf via str_from_int,
      # dead-code POSIX externs) is deferred to step 8b.2.
      #
      # Compiler-side: sched_yield intrinsic now lowers to
      # `call void @yield_now()` under freestanding (kernel's
      # task park/wake substrate), instead of `@usleep(i32 1)`.

      it("freestanding _async_http_recv body calls @tcp$async_tcp_read") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/http_server\n\ndef main(): Int = _async_http_recv(0, 0, 1500)\n"
        # Direct delegation tail-calls async_tcp_read; codegen emits
        # `tail call i64 @tcp$async_tcp_read(...)` not a non-tail call.
        # async_tcp_read lives in std/net/tcp, so the symbol carries the
        # `tcp$` module prefix (the mangling convention for free functions).
        assert_ir_contains_with_flags(src, "tail call i64 @tcp$async_tcp_read", flags)
      end

      it("freestanding _async_http_send body calls @tcp$async_tcp_write") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/http_server\n\ndef main(): Int = _async_http_send(0, 0, 22)\n"
        assert_ir_contains_with_flags(src, "tail call i64 @tcp$async_tcp_write", flags)
      end

      it("freestanding set_nonblocking is a no-op") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/http_server\n\ndef main(): Int = set_nonblocking(0)\n"
        # No POSIX fcntl call in the body — the @cfg(os: "unknown")
        # branch is `def set_nonblocking(fd: Int): Int = 0`.
        assert_ir_not_contains_with_flags(src, "call i32 (i32, i32, ...) @fcntl", flags)
      end

      it("freestanding _http_close_fd body calls @kern_tcp_close") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/http_server\n\ndef main(): Int = _http_close_fd(0)\n"
        assert_ir_contains_with_flags(src, "call i64 (i64) @kern_tcp_close", flags)
      end

      it("freestanding sched_yield lowers to @yield_now") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  sched_yield()\n  return 0\nend\n"
        assert_ir_contains_with_flags(src, "call void @yield_now()", flags)
        assert_ir_not_contains_with_flags(src, "call i32 @usleep(i32 1)", flags)
      end

      it("hosted sched_yield keeps the @usleep(i32 1) path (regression check)") do ->
        var src = "def main(): Int\n  sched_yield()\n  return 0\nend\n"
        assert_ir_contains(src, "call i32 @usleep(i32 1)")
        assert_ir_not_contains(src, "call void @yield_now()")
      end

      it("uses atomic spinlocking around freestanding supervisor publication") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "import * from std/net/http_dynamic_goroutine_sup\n\ndef probe_body(): Int = 0\n\ndef main(): Int\n  var sup = http_dyn_gsup_new()\n  var reservation = http_dyn_gsup_reserve(sup)\n  return http_dyn_gsup_spawn_reserved(sup, reservation, probe_body)\nend\n"
        var compiled = subprocess_compile_with_flags(src, flags)
        assert_eq(compiled.exit_code, 0)
        if compiled.exit_code == 0
          var ir = compiled.stdout_content
          var lock_new_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$_hdgs_lock_new").unwrap_or(-1)
          var lock_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$_hdgs_lock(i64").unwrap_or(-1)
          var unlock_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$_hdgs_unlock(i64").unwrap_or(-1)
          var tombstone_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$_hdgs_tombstone()").unwrap_or(-1)
          var spin_lock_start = str_find(ir, "define i64 @spinlock$spinlock_lock(i64").unwrap_or(-1)
          var spin_unlock_start = str_find(ir, "define i64 @spinlock$spinlock_unlock(i64").unwrap_or(-1)
          var supervisor_new_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_new()").unwrap_or(-1)
          var reserve_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_reserve(i64").unwrap_or(-1)
          var claim_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_claim(i64").unwrap_or(-1)
          var release_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_release(i64").unwrap_or(-1)
          var abort_claim_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_abort_claim(i64").unwrap_or(-1)
          var claim_end = abort_claim_start
          if release_start > claim_start and release_start < abort_claim_start
            claim_end = release_start
          end
          var function_start = str_find(ir, "define i64 @http_dynamic_goroutine_sup$http_dyn_gsup_spawn_reserved").unwrap_or(-1)
          var function_end = str_find(ir, "define i64 @__lambda_0(i64").unwrap_or(-1)
          var lock_new_end = lock_start
          var lock_end = unlock_start
          var unlock_end = tombstone_start
          var spin_lock_end = spin_unlock_start
          var spin_unlock_end = lock_new_start
          assert_gt(lock_new_start, -1)
          assert_gt(lock_new_end, lock_new_start)
          assert_gt(lock_start, -1)
          assert_gt(lock_end, lock_start)
          assert_gt(unlock_start, -1)
          assert_gt(unlock_end, unlock_start)
          assert_gt(tombstone_start, unlock_start)
          assert_gt(spin_lock_start, -1)
          assert_gt(spin_lock_end, spin_lock_start)
          assert_gt(spin_unlock_start, -1)
          assert_gt(spin_unlock_end, spin_unlock_start)
          assert_gt(supervisor_new_start, -1)
          assert_gt(reserve_start, supervisor_new_start)
          assert_gt(claim_start, reserve_start)
          assert_gt(abort_claim_start, claim_start)
          assert_gt(function_start, -1)
          assert_gt(function_end, function_start)
          if lock_new_end > lock_new_start and lock_end > lock_start and unlock_end > unlock_start and spin_lock_end > spin_lock_start and spin_unlock_end > spin_unlock_start and reserve_start > supervisor_new_start and claim_start > reserve_start and abort_claim_start > claim_start and function_end > function_start
            assert_gt(_freestanding_ir_find_between(ir, "call i64 @spinlock", lock_new_start, lock_new_end), lock_new_start)
            assert_gt(_freestanding_ir_find_between(ir, "call i64 @spinlock", lock_start, lock_end), lock_start)
            assert_gt(_freestanding_ir_find_between(ir, "cmpxchg ptr", spin_lock_start, spin_lock_end), spin_lock_start)
            assert_gt(_freestanding_ir_find_between(ir, "call i64 @spinlock", unlock_start, unlock_end), unlock_start)
            assert_gt(_freestanding_ir_find_between(ir, "store atomic i64", spin_unlock_start, spin_unlock_end), spin_unlock_start)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_new", lock_new_start, lock_new_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_lock", lock_start, lock_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_unlock", unlock_start, unlock_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_new", function_start, function_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_lock", function_start, function_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_unlock", function_start, function_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_new", supervisor_new_start, reserve_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_lock", supervisor_new_start, reserve_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_unlock", supervisor_new_start, reserve_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_new", reserve_start, claim_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_lock", reserve_start, claim_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_unlock", reserve_start, claim_start), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_new", claim_start, claim_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_lock", claim_start, claim_end), -1)
            assert_eq(_freestanding_ir_find_between(ir, "mutex_unlock", claim_start, claim_end), -1)

            var publication_lock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_lock(i64", function_start, function_end)
            var publishing = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_reservation_publishing()", publication_lock, function_end)
            var publication_unlock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_unlock(i64", publishing, function_end)
            var kernel_spawn = _freestanding_ir_find_between(ir, "call i64 (i64) @kern_go_closure_hi", publication_unlock, function_end)
            assert_gt(publication_lock, function_start)
            assert_gt(publishing, publication_lock)
            assert_gt(publication_unlock, publishing)
            assert_gt(kernel_spawn, publication_unlock)
            var rollback_lock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_lock(i64", kernel_spawn, function_end)
            var success_lock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_lock(i64", rollback_lock + 1, function_end)
            var rollback = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_reservation_claimed()", success_lock, function_end)
            var rollback_unlock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_unlock(i64", rollback, function_end)
            var abort_claim = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$http_dyn_gsup_abort_claim", rollback_unlock, function_end)
            var success_check = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_reservation_publishing()", rollback, function_end)
            var consumed = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_reservation_free()", success_check, function_end)
            var success_unlock = _freestanding_ir_find_between(ir, "call i64 @http_dynamic_goroutine_sup$_hdgs_unlock(i64", consumed, function_end)
            assert_gt(rollback_lock, kernel_spawn)
            assert_gt(success_lock, rollback_lock)
            assert_gt(rollback, success_lock)
            assert_gt(rollback_unlock, rollback)
            assert_gt(abort_claim, rollback_unlock)
            assert_gt(success_check, success_lock)
            assert_gt(consumed, success_check)
            assert_gt(success_unlock, consumed)
            assert(str_contains(ir, "publishing rollback invariant violated"))
            assert(str_contains(ir, "successful publication invariant violated"))
          end
        end
      end
    end

    describe("D.11 Phase 7 / Phase 8b step 2 — str_from_int freestanding pure-IR") do ->
      # Step 8b.2 reroutes the str_from_int intrinsic emit for
      # freestanding to call @qz_int_to_str — the pure-IR i64→decimal
      # helper already emitted by cg_emit_int_to_str_helper inside the
      # freestanding branch of cg_emit_runtime_decls. Hosted keeps the
      # libc sprintf-based path (`@sprintf` + `@.fmt.int.noln` +
      # `@qz_wrap_cstr`).
      #
      # str_from_int is reached on the http_serve_supervised hot path
      # via `http_error_format` (BindFailed/ListenFailed messages) and
      # `_async_http_write_response_timeout` (status line + Content-
      # Length headers). Phase 8b can't dogfood http_server.qz in the
      # kernel without this.

      it("freestanding str_from_int calls @qz_int_to_str") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  var s = str_from_int(42)\n  return 0\nend\n"
        assert_ir_contains_with_flags(src, "call i64 @qz_int_to_str(i64", flags)
        assert_ir_not_contains_with_flags(src, "@sprintf", flags)
        assert_ir_not_contains_with_flags(src, "@.fmt.int.noln", flags)
      end

      it("hosted str_from_int keeps the @sprintf path (regression check)") do ->
        var src = "def main(): Int\n  var s = str_from_int(42)\n  return 0\nend\n"
        assert_ir_contains(src, "call i32 (ptr, ptr, ...) @sprintf")
        assert_ir_contains(src, "@.fmt.int.noln")
      end
    end

    describe("D.11 Phase 7 / Phase 8b step 2.b — print-class intrinsics are no-ops in freestanding") do ->
      # Step 8b.2.b first sub-fix: puts/eputs/print/eprint/print_int/
      # eprint_int all emit no-op IR (`%v<d> = add i64 0, 0`) under
      # freestanding instead of calling libc @puts / @fprintf / @write
      # / @__stderrp / @stderr / @.fmt.sn / @print_int / @eprint_int.
      #
      # Surfaced first by std/net/hpack.qz's `eputs("[hpack] invalid
      # index 0 in lookup_name")` diagnostic which referenced
      # @.fmt.sn — a format-string global that the freestanding emit
      # block at codegen_runtime.qz:3474 doesn't define (it returns
      # early before reaching the hosted format-string emission at
      # codegen_runtime.qz:10044). llc bailed with `use of undefined
      # value '@.fmt.sn'`. Same pattern would have surfaced once any
      # of `print`/`eputs`/`print_int` got reached from kernel code.
      #
      # Diagnostic prints in stdlib are not load-bearing for kernel
      # builds — the kernel's debug surface is `uart_*` (kernel-side
      # Quartz functions), not libc fprintf/write/puts. This matches
      # the existing freestanding precedent — `qz_print_backtrace` is
      # a no-op and panic helpers are stubs (see
      # cg_emit_freestanding_panic_stubs).

      it("freestanding eputs emits no-op (no @fprintf, no @.fmt.sn, no @__stderrp/stderr)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  eputs(\"diag msg\")\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "@fprintf", flags)
        assert_ir_not_contains_with_flags(src, "@.fmt.sn", flags)
        assert_ir_not_contains_with_flags(src, "@__stderrp", flags)
        assert_ir_not_contains_with_flags(src, "@stderr", flags)
      end

      it("freestanding puts emits no-op (no @puts, no @printf, no @.fmt.s)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  puts(\"hello\")\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 @puts", flags)
        assert_ir_not_contains_with_flags(src, "@printf", flags)
      end

      it("freestanding print emits no-op (no @write to stdout)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  print(\"hello\")\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 @write(i32 1", flags)
      end

      it("freestanding eprint emits no-op (no @write to stderr)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  eprint(\"hello\")\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "call i64 @write(i32 2", flags)
      end

      it("freestanding print_int emits no-op (no @print_int helper call)") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int\n  print_int(42)\n  return 0\nend\n"
        assert_ir_not_contains_with_flags(src, "call void @print_int", flags)
      end

      it("hosted puts keeps the libc @puts path (regression check)") do ->
        var src = "def main(): Int\n  puts(\"hello\")\n  return 0\nend\n"
        assert_ir_contains(src, "call i64 @puts(ptr")
      end

      it("hosted eputs keeps the libc @fprintf path (regression check)") do ->
        var src = "def main(): Int\n  eputs(\"diag msg\")\n  return 0\nend\n"
        assert_ir_contains(src, "@fprintf")
      end
    end

    describe("D.11 Phase 7 / Phase 8b step 2.b — kind=3 continuation runtime helpers") do ->
      # Step 8b.2.b second sub-fix: emit the four kind=3 continuation
      # helpers (and their two TLS-equivalent globals) in the freestanding
      # effect-runtime block. Mirrors codegen_runtime.qz:1431-1446 / 1529-1541
      # in the hosted path.
      #
      # Async-future `$poll` wrappers (emitted by PASS 1.2a /
      # mir_lower_async_poll for any `async f()` call site that resolves
      # to a named function) reference these four helpers around every
      # kind=3 perform site:
      #
      #   %prev_cont = call i64 @__qz_effect_get_cont_frame()
      #   call void @__qz_effect_set_cont_frame(i64 %my_frame)
      #   call void @__qz_effect_park_reset()
      #   call i64 @__qz_effect_perform(... kind=3 ...)
      #   %rv = call i64 @__qz_effect_park_get_rv()
      #   call void @__qz_effect_set_cont_frame(i64 %prev_cont)
      #
      # Pre-Phase-8b.2.b, llc bailed with
      # `use of undefined value '@__qz_effect_get_cont_frame'` the
      # moment any user code included a stdlib import whose call graph
      # reached an explicit `async fn`. http_server.qz's
      # http_dynamic_goroutine_sup module (`async _http_dyn_gsup_watcher`
      # / `async _http_dyn_gsup_body_wrapper`) was the surfacer.
      #
      # `@__qz_effect_resume_cont` ships as a defensive stub returning
      # the resume value unchanged — no `with Async { resume: ... }` is
      # installed in any current kernel code path; perform falls through
      # to `@__qz_effect_unhandled` before resume_cont would fire.

      it("freestanding emits __qz_effect_get_cont_frame definition") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_get_cont_frame()", flags)
      end

      it("freestanding emits __qz_effect_set_cont_frame definition") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_set_cont_frame(i64 %f)", flags)
      end

      it("freestanding emits __qz_effect_get_resume_val definition") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_get_resume_val()", flags)
      end

      it("freestanding emits __qz_effect_park_reset definition") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define void @__qz_effect_park_reset()", flags)
      end

      it("freestanding emits __qz_effect_park_get_rv definition") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_park_get_rv()", flags)
      end

      it("freestanding emits __qz_effect_resume_cont stub") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "define i64 @__qz_effect_resume_cont(i64 %v)", flags)
      end

      it("freestanding emits the two cont-frame TLS-equivalent globals") do ->
        var flags = "--target x86_64-unknown-none-elf"
        var src = "def main(): Int = 0"
        assert_ir_contains_with_flags(src, "@__qz_effect_current_cont_frame = internal global i64 0", flags)
        assert_ir_contains_with_flags(src, "@__qz_effect_current_resume_val = internal global i64 0", flags)
      end
    end
  end

  return qspec_main()
end
