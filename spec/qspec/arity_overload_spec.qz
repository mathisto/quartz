## Arity-Based Function Overloading Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("basic arity overloading") do ->
    it("allows two functions with same name but different arities") do ->
      assert_run_stdout_eq("""
        def greet(): Int = 1
        def greet(n: Int): Int = n
        def main(): Int
          print_int(greet())
          print_int(greet(42))
          return 0
        end
        """, "1\n42\n")
    end

    it("resolves calls by argument count") do ->
      assert_run_stdout_eq("""
        def add(): Int = 0
        def add(a: Int): Int = a
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          print_int(add())
          print_int(add(10))
          print_int(add(10, 20))
          return 0
        end
        """, "0\n10\n30\n")
    end
  end

  describe("arity overloading with generics") do ->
    it("allows generic functions with different arities") do ->
      assert_run_exits("""
        def wrap<T>(x: T): T = x
        def wrap<T, U>(x: T, y: U): T = x
        def main(): Int
          a = wrap(10)
          b = wrap(32, 99)
          return a + b
        end
        """, 42)
    end

    it("different generic arities with same param count are distinct") do ->
      assert_eq(ao_wrap(42), 42)
    end
  end

  describe("error messages") do ->
    it("shows arity in undefined function error when overloads exist") do ->
      assert_compile_error("""
        def foo(): Int = 1
        def foo(a: Int): Int = a
        def main(): Int = foo(1, 2)
        """, "accepts at most")
    end

    it("single-arity function errors do not mention arity") do ->
      assert_compile_error("""
        def foo(a: Int): Int = a
        def main(): Int = foo(1, 2)
        """, "accepts at most")
    end
  end

  describe("UFCS with arity overloading") do ->
    it("resolves UFCS calls with correct arity") do ->
      assert_run_exits("""
        def inc(x: Int): Int = x + 1
        def inc(x: Int, y: Int): Int = x + y
        def main(): Int
          var a = 5.inc()
          var b = 5.inc(10)
          return a + b
        end
        """, 21)
    end
  end

  describe("duplicate arity detection") do ->
    it("rejects two functions with same name and same arity (compile-error test)") do ->
      assert_compile_error("""
        def foo(x: Int): Int = x + 1
        def foo(y: Int): Int = y * 2
        def main(): Int = foo(5)
        """, "duplicate function definition")
    end
  end

  return qspec_main()
end

def ao_wrap(x: Int): Int = x
