## P21: Preemptive Scheduling Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("preemptive scheduling") do ->
    it("tight loop task yields CPU to other tasks") do ->
      assert_run_exits_timeout(preempt_tight_loop_src(), 0)
    end
    it("fuel resets after channel recv") do ->
      assert_run_exits_timeout(preempt_fuel_reset_src(), 0)
    end
    it("multiple tight-loop tasks cooperate") do ->
      assert_run_exits_timeout(preempt_multi_loop_src(), 0)
    end
    it("@no_preempt function compiles and runs") do ->
      assert_run_exits(no_preempt_attr_src(), 0)
    end
  end
  return qspec_main()
end

def preempt_tight_loop_src(): String = """
  def main(): Int
    var ch = channel_new(1)
    go do ->
      var x = 0
      while x >= 0
        x += 1
      end
    end
    go do ->
      send(ch, 42)
    end
    var val = recv(ch)
    if val == 42
      return 0
    end
    return 1
  end
  """

def preempt_fuel_reset_src(): String = """
  def busy_work(n: Int): Int
    var sum = 0
    for i in 0..n
      sum += i
    end
    return sum
  end
  def main(): Int
    var ch = channel_new(1)
    go do ->
      send(ch, 1)
    end
    var a = busy_work(100)
    var v = recv(ch)
    var b = busy_work(100)
    if v == 1 and a + b > 0
      return 0
    end
    return 1
  end
  """

def preempt_multi_loop_src(): String = """
  def main(): Int
    var ch = channel_new(1)
    go do ->
      var x = 0
      while x >= 0
        x += 1
      end
    end
    go do ->
      var y = 0
      while y >= 0
        y += 1
      end
    end
    go do ->
      var z = 0
      for i in 0..1000
        z += 1
      end
      send(ch, z)
    end
    var result = recv(ch)
    if result == 1000
      return 0
    end
    return 1
  end
  """

def no_preempt_attr_src(): String = """
  @no_preempt
  def hot_loop(n: Int): Int
    var sum = 0
    for i in 0..n
      sum += i
    end
    return sum
  end
  def main(): Int
    var r = hot_loop(100)
    if r == 4950
      return 0
    end
    return 1
  end
  """
