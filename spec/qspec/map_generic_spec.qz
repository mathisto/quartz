## Map Generic Tests
##
## Contract:
##   1. Map_new<k,v>.
##   2. Type safety.
##   3. Map_get return type.
##   4. Map_has.
##   5. Map_keys and map_values.
##   6. Map_size.
##   7. Different key types.
##   8. Type inference via assignment.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("map_new<K,V>") do ->
    it("creates a Map with explicit type parameters") do ->
      assert_eq(hg_explicit_type_params(), 42)
    end
    it("returns Int for backward compat when no type arg") do ->
      assert_eq(hg_no_type_arg(), 7)
    end
    it("requires both type parameters") do ->
      assert_compile_error(hg_single_type_param_src(), "map_new requires two type parameters")
    end
  end

  describe("type safety") do ->
    it("rejects wrong key type in map_set") do ->
      assert_compile_error(hg_wrong_key_set_src(), "map_set: expected key type")
    end
    it("rejects wrong value type in map_set") do ->
      assert_compile_error(hg_wrong_val_set_src(), "map_set: expected value type")
    end
    it("rejects wrong key type in map_get") do ->
      assert_compile_error(hg_wrong_key_get_src(), "map_get: expected key type")
    end
    it("rejects wrong key type in map_has") do ->
      assert_compile_error(hg_wrong_key_has_src(), "map_has: expected key type")
    end
    it("rejects wrong key type in map_delete") do ->
      assert_compile_error(hg_wrong_key_del_src(), "map_delete: expected key type")
    end
  end

  describe("map_get return type") do ->
    it("returns the value type for String values") do ->
      assert_eq(hg_get_string_val(), 42)
    end
    it("returns Int when map has Int value type") do ->
      assert_eq(hg_get_int_val(), 99)
    end
  end

  describe("map_has") do ->
    it("returns Bool true when key exists") do ->
      assert_eq(hg_has_true(), 1)
    end
    it("returns Bool false when key does not exist") do ->
      assert_eq(hg_has_false(), 1)
    end
  end

  describe("map_keys and map_values") do ->
    it("map_keys returns Vec<K> with correct length") do ->
      assert_eq(hg_keys_len(), 3)
    end
    it("map_values returns Vec<V> with correct sum") do ->
      assert_eq(hg_values_sum(), 60)
    end
  end

  describe("map_size") do ->
    it("returns Int count of entries") do ->
      assert_eq(hg_size_count(), 3)
    end
  end

  describe("different key types") do ->
    it("type checks Int keys correctly") do ->
      assert_compile_succeeds(hg_int_keys_src())
    end
  end

  describe("type inference via assignment") do ->
    it("uses explicit type arguments for Map type") do ->
      assert_eq(hg_explicit_assignment(), 42)
    end
  end

  describe("Map<K, V> with generic type-params on the function") do ->
    it("compiles when both K and V are generic params") do ->
      assert_compile_succeeds(hg_generic_kv_src())
    end
    it("compiles and executes with concrete types passed in") do ->
      assert_eq(hg_generic_kv_executes(), 2)
    end
  end

  return qspec_main()
end

## Named helper functions for Map generic tests.
## Assertions use named helpers for clarity and to keep closure count manageable.

def hg_explicit_type_params(): Int
  var m: Map<String, Int> = map_new()
  m.set("x", 42)
  match m.get("x")
    Some(v) => return v
    _ => return 0
  end
end

def hg_no_type_arg(): Int
  var m = map_new()
  m.set("key", 7)
  match m.get("key")
    Some(v) => return v
    _ => return 0
  end
end

def hg_get_string_val(): Int
  var m: Map<String, Int> = map_new()
  m.set("answer", 42)
  match m.get("answer")
    Some(v) => return v
    _ => return 0
  end
end

def hg_get_int_val(): Int
  var m = map_new()
  m.set("score", 99)
  match m.get("score")
    Some(v) => return v
    _ => return 0
  end
end

def hg_has_true(): Int
  var m = map_new()
  m.set("present", 1)
  return m.has("present")
end

def hg_has_false(): Int
  var m = map_new()
  m.set("only", 1)
  if not m.has("missing")
    return 1
  end
  return 0
end

def hg_keys_len(): Int
  var m = map_new()
  m.set("a", 10)
  m.set("b", 20)
  m.set("c", 30)
  var keys = m.keys()
  return keys.size
end

def hg_values_sum(): Int
  var m = map_new()
  m.set("a", 10)
  m.set("b", 20)
  m.set("c", 30)
  var vals = m.values()
  var sum = 0
  var i = 0
  while i < vals.size
    sum = sum + vals[i]
    i = i + 1
  end
  return sum
end

def hg_size_count(): Int
  var m = map_new()
  m.set("x", 1)
  m.set("y", 2)
  m.set("z", 3)
  return m.size()
end

def hg_explicit_assignment(): Int
  var m: Map<String, Int> = map_new()
  m.set("val", 42)
  match m.get("val")
    Some(v) => return v
    _ => return 0
  end
end

def hg_int_keys_src(): String
  return "def main(): Int\n  var m: Map<Int, Int> = map_new()\n  m.set(10, 30)\n  return 0\nend\n"
end

def hg_single_type_param_src(): String
  return "def main(): Int\n  var m = map_new<String>()\n  return 0\nend\n"
end

def hg_wrong_key_set_src(): String
  return "def main(): Int\n  var m: Map<String, Int> = map_new()\n  m.set(42, 10)\n  return 0\nend\n"
end

def hg_wrong_val_set_src(): String
  return "def main(): Int\n  var m: Map<String, Int> = map_new()\n  map_set(m, \"k\", \"v\")\n  return 0\nend\n"
end

def hg_wrong_key_get_src(): String
  return "def main(): Int\n  var m: Map<String, Int> = map_new()\n  map_set(m, \"k\", 1)\n  m.get(42)\n  return 0\nend\n"
end

def hg_wrong_key_has_src(): String
  return "def main(): Int\n  var m: Map<String, Int> = map_new()\n  map_set(m, \"k\", 1)\n  m.has(42)\n  return 0\nend\n"
end

def hg_wrong_key_del_src(): String
  return "def main(): Int\n  var m: Map<String, Int> = map_new()\n  map_set(m, \"k\", 1)\n  m.delete(42)\n  return 0\nend\n"
end

def hg_generic_kv_src(): String
  return "def use_map<K, V>(m: Map<K, V>): Int\n  return 0\nend\ndef main(): Int = 0\n"
end

def hg_use_map_size<K, V>(m: Map<K, V>): Int
  return m.size()
end

def hg_generic_kv_executes(): Int
  var m: Map<String, Int> = map_new()
  m.set("a", 1)
  m.set("b", 2)
  return hg_use_map_size(m)
end
