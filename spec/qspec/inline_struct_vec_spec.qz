## Inline Struct Vec Tests
##
## Contract:
##   1. Growth: growth preserves inline data.
##   2. Loop: loop push and access.
##   3. Mixed: mixed positive/negative/zero values.
##   4. Push/get: push and get with 2/3-field struct.
##   5. Set: set replaces inline element.
##   6. Size: size tracks correctly.
##   7. Set+get: vec_get after vec_set returns updated value.
##   8. 3-field: push/get with 3-field struct.
import * from qspec

@value
struct Point
  x: Int
  y: Int
end

@value
struct Triple
  a: Int
  b: Int
  c: Int
end

# -- Test helpers --

def test_push_get_2field(): Void
  var v = vec_new<Point>()
  var p1 = Point { x: 10, y: 20 }
  var p2 = Point { x: 30, y: 40 }
  v.push(p1)
  v.push(p2)
  var r1 = v[0]
  var r2 = v[1]
  assert_eq(r1.x, 10)
  assert_eq(r1.y, 20)
  assert_eq(r2.x, 30)
  assert_eq(r2.y, 40)
end

def test_push_get_3field(): Void
  var v = vec_new<Triple>()
  var t = Triple { a: 100, b: 200, c: 300 }
  v.push(t)
  var r = v[0]
  assert_eq(r.a, 100)
  assert_eq(r.b, 200)
  assert_eq(r.c, 300)
end

def test_set_2field(): Void
  var v = vec_new<Point>()
  var p1 = Point { x: 1, y: 2 }
  var p2 = Point { x: 3, y: 4 }
  var p3 = Point { x: 99, y: 88 }
  v.push(p1)
  v.push(p2)
  v.set(0, p3)
  var r = v[0]
  assert_eq(r.x, 99)
  assert_eq(r.y, 88)
  # Second element unchanged
  var r2 = v[1]
  assert_eq(r2.x, 3)
  assert_eq(r2.y, 4)
end

def test_value_semantics(): Void
  var v = vec_new<Point>()
  var p = Point { x: 10, y: 20 }
  v.push(p)
  # Modify the returned struct
  var r = v[0]
  r.x = 999
  # Original Vec element should be unchanged (value copy)
  var r2 = v[0]
  assert_eq(r2.x, 10)
  assert_eq(r2.y, 20)
end

def test_growth(): Void
  var v = vec_new<Point>()
  # Push more than initial capacity (8 elements = 8 * 16 = 128 bytes)
  for i in 0..20
    var p = Point { x: i, y: i * 10 }
    v.push(p)
  end
  assert_eq(v.size, 20)
  # Verify all elements survived reallocation
  for i in 0..20
    var r = v[i]
    assert_eq(r.x, i)
    assert_eq(r.y, i * 10)
  end
end

def test_size(): Void
  var v = vec_new<Point>()
  assert_eq(v.size, 0)
  var p = Point { x: 1, y: 2 }
  v.push(p)
  assert_eq(v.size, 1)
  v.push(p)
  v.push(p)
  assert_eq(v.size, 3)
end

def test_mixed_field_values(): Void
  var v = vec_new<Point>()
  var p1 = Point { x: 0, y: 0 }
  var p2 = Point { x: -1, y: 2147483647 }
  var p3 = Point { x: 42, y: -42 }
  v.push(p1)
  v.push(p2)
  v.push(p3)
  var r1 = v[0]
  var r2 = v[1]
  var r3 = v[2]
  assert_eq(r1.x, 0)
  assert_eq(r1.y, 0)
  assert_eq(r2.x, -1)
  assert_eq(r2.y, 2147483647)
  assert_eq(r3.x, 42)
  assert_eq(r3.y, -42)
end

def test_loop_access(): Void
  var v = vec_new<Point>()
  for i in 0..5
    var p = Point { x: i + 1, y: (i + 1) * 2 }
    v.push(p)
  end
  var sum_x = 0
  var sum_y = 0
  for i in 0..5
    var r = v[i]
    sum_x += r.x
    sum_y += r.y
  end
  # sum_x = 1+2+3+4+5 = 15, sum_y = 2+4+6+8+10 = 30
  assert_eq(sum_x, 15)
  assert_eq(sum_y, 30)
end


def test_set_get(): Void
  var v = vec_new<Point>()
  var p = Point { x: 1, y: 2 }
  v.push(p)
  var updated = Point { x: 42, y: 84 }
  v.set(0, updated)
  var r = v[0]
  assert_eq(r.x, 42)
  assert_eq(r.y, 84)
end

# C3.6 (h5): extend a Vec of a >16B (cow-eligible) @value struct with another.
# Both vecs must read correct values after the append. For cow elements the slot
# is a shared buffer pointer; the extend retains each shared buffer (cow_rc_inc)
# so the refcount matches the true reference count.
def test_extend_3field(): Void
  var a = vec_new<Triple>()
  a.push(Triple { a: 1, b: 2, c: 3 })
  a.push(Triple { a: 4, b: 5, c: 6 })
  var b = vec_new<Triple>()
  b.push(Triple { a: 7, b: 8, c: 9 })
  b.push(Triple { a: 10, b: 11, c: 12 })
  a.extend(b)
  assert_eq(a.size, 4)
  var r0 = a[0]
  var r2 = a[2]
  var r3 = a[3]
  assert_eq(r0.a, 1)
  assert_eq(r2.a, 7)
  assert_eq(r2.c, 9)
  assert_eq(r3.a, 10)
  assert_eq(r3.c, 12)
  # Source Vec b still reads the appended values correctly (shared buffers retained).
  var s0 = b[0]
  var s1 = b[1]
  assert_eq(s0.a, 7)
  assert_eq(s1.a, 10)
  assert_eq(s1.c, 12)
end

# F4-PRE-2 regression: `for item in v` over a Vec of a multi-word INLINE @value
# struct (2-word Point, fc=2) must bind each element BY ADDRESS (data + i*fc) so
# `item.field` reads the right word — NOT a stride-1 single-i64 value-load (which
# loaded only field 0, then inttoptr'd that scalar → SIGSEGV). Mirror of the
# already-correct index path test_loop_access above, but exercising the for-in
# iterator desugar that previously miscompiled.
def test_forin_inline_2field(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 10, y: 20 })
  v.push(Point { x: 30, y: 22 })
  var sum_x = 0
  var sum_y = 0
  for item in v
    sum_x += item.x
    sum_y += item.y
  end
  assert_eq(sum_x, 40)
  assert_eq(sum_y, 42)
end

# 3-field inline (fc=3) for-in: Triple is >16B but at the cow gate it is cow-layout
# (boxed), so for-in must keep the untyped handle path; reading .a/.c through the
# stored buffer pointer must still be correct (no over-fire from the F4-PRE-2 fix).
def test_forin_inline_3field(): Void
  var v = vec_new<Triple>()
  v.push(Triple { a: 1, b: 2, c: 3 })
  v.push(Triple { a: 4, b: 5, c: 6 })
  var sum_a = 0
  var sum_c = 0
  for item in v
    sum_a += item.a
    sum_c += item.c
  end
  assert_eq(sum_a, 5)
  assert_eq(sum_c, 9)
end

# Scalar Vec<Int> for-in must stay on the untyped value-load path (predicate 0).
def test_forin_scalar(): Void
  var v = vec_new<Int>()
  v.push(7)
  v.push(35)
  var t = 0
  for item in v
    t += item
  end
  assert_eq(t, 42)
end

# ---- R3.4: contains / index_of / dedup over value-layout struct elements ----
# Before R3.4 these three ops scanned at an 8-byte stride and compared one i64
# word against the query POINTER (always false). They now stride by `ew` and
# compare field-deep via @qz_eq_<Name>. Cover ≤16B (Point) + >16B/CoW (Triple).

def test_contains_2field_present(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 1, y: 2 })
  v.push(Point { x: 3, y: 4 })
  assert_eq(bool_to_int(v.contains(Point { x: 3, y: 4 })), 1)
  assert_eq(bool_to_int(v.contains(Point { x: 1, y: 2 })), 1)
end

def test_contains_2field_absent(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 1, y: 2 })
  v.push(Point { x: 3, y: 4 })
  assert_eq(bool_to_int(v.contains(Point { x: 9, y: 9 })), 0)
  # Shares first word (x=3) with element [1] but differs in y — must be absent.
  assert_eq(bool_to_int(v.contains(Point { x: 3, y: 999 })), 0)
end

def test_contains_3field_cow(): Void
  var v = vec_new<Triple>()
  v.push(Triple { a: 1, b: 2, c: 3 })
  v.push(Triple { a: 1, b: 2, c: 9 })
  v.push(Triple { a: 7, b: 8, c: 9 })
  assert_eq(bool_to_int(v.contains(Triple { a: 1, b: 2, c: 9 })), 1)
  assert_eq(bool_to_int(v.contains(Triple { a: 7, b: 8, c: 9 })), 1)
  # Shares a,b with elements 0 and 1 but differs in c.
  assert_eq(bool_to_int(v.contains(Triple { a: 1, b: 2, c: 100 })), 0)
  assert_eq(bool_to_int(v.contains(Triple { a: 5, b: 5, c: 5 })), 0)
end

def test_index_of_2field(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 1, y: 2 })
  v.push(Point { x: 3, y: 4 })
  v.push(Point { x: 5, y: 6 })
  var i0 = v.index_of(Point { x: 1, y: 2 })
  var i2 = v.index_of(Point { x: 5, y: 6 })
  # Distinct struct sharing first word (x=3) must not be confused with element 1.
  var iabsent = v.index_of(Point { x: 3, y: 999 })
  assert_eq(option_unwrap_or(i0, -7), 0)
  assert_eq(option_unwrap_or(i2, -7), 2)
  assert_eq(option_unwrap_or(iabsent, -7), -7)
end

def test_index_of_3field_cow(): Void
  var v = vec_new<Triple>()
  v.push(Triple { a: 1, b: 2, c: 3 })
  v.push(Triple { a: 7, b: 8, c: 9 })
  var i1 = v.index_of(Triple { a: 7, b: 8, c: 9 })
  var iabsent = v.index_of(Triple { a: 1, b: 2, c: 100 })
  assert_eq(option_unwrap_or(i1, -7), 1)
  assert_eq(option_unwrap_or(iabsent, -7), -7)
end

def test_dedup_2field(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 1, y: 2 })
  v.push(Point { x: 1, y: 2 })   # dup
  v.push(Point { x: 1, y: 9 })   # distinct, SAME first word as prev
  v.push(Point { x: 1, y: 9 })   # dup
  v.push(Point { x: 3, y: 4 })
  v.dedup()
  assert_eq(v.size, 3)
  assert_eq(v[0].x, 1)
  assert_eq(v[0].y, 2)
  assert_eq(v[1].x, 1)
  assert_eq(v[1].y, 9)
  assert_eq(v[2].x, 3)
  assert_eq(v[2].y, 4)
end

def test_dedup_3field_cow(): Void
  var v = vec_new<Triple>()
  v.push(Triple { a: 1, b: 1, c: 1 })
  v.push(Triple { a: 1, b: 1, c: 1 })   # dup
  v.push(Triple { a: 1, b: 1, c: 2 })   # distinct, shares a,b
  v.push(Triple { a: 7, b: 8, c: 9 })
  v.dedup()
  assert_eq(v.size, 3)
  assert_eq(v[0].c, 1)
  assert_eq(v[1].c, 2)
  assert_eq(v[2].a, 7)
  assert_eq(v[2].c, 9)
end

# Control: Vec<Int> contains/index_of/dedup stay on the byte-identical i64 path.
def test_int_contains_index_dedup(): Void
  var v = vec_new<Int>()
  v.push(5)
  v.push(5)
  v.push(7)
  v.push(7)
  v.push(9)
  assert_eq(bool_to_int(v.contains(7)), 1)
  assert_eq(bool_to_int(v.contains(8)), 0)
  assert_eq(option_unwrap_or(v.index_of(9), -7), 4)
  assert_eq(option_unwrap_or(v.index_of(42), -7), -7)
  v.dedup()
  assert_eq(v.size, 3)
  assert_eq(v[0], 5)
  assert_eq(v[1], 7)
  assert_eq(v[2], 9)
end

def bool_to_int(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def option_unwrap_or(o: Option<Int>, dflt: Int): Int
  if o is Some(v)
    return v
  end
  return dflt
end

def main(): Int
  describe("Vec<Point> inline struct storage") do ->
    it("push and get with 2-field struct") do ->
      test_push_get_2field()
    end

    it("push and get with 3-field struct") do ->
      test_push_get_3field()
    end

    it("set replaces inline element") do ->
      test_set_2field()
    end

    it("growth preserves inline data") do ->
      test_growth()
    end

    it("size tracks correctly") do ->
      test_size()
    end

    it("mixed positive/negative/zero values") do ->
      test_mixed_field_values()
    end

    it("loop push and access") do ->
      test_loop_access()
    end

    it("vec_get after vec_set returns updated value") do ->
      test_set_get()
    end

    it("extend appends another vec's cow-eligible elements") do ->
      test_extend_3field()
    end

    it("for-in over 2-field inline element reads fields by-address") do ->
      test_forin_inline_2field()
    end

    it("for-in over 3-field cow element reads fields correctly") do ->
      test_forin_inline_3field()
    end

    it("for-in over scalar Vec<Int> is unchanged") do ->
      test_forin_scalar()
    end

    it("contains finds a present 2-field struct element") do ->
      test_contains_2field_present()
    end

    it("contains rejects absent + same-first-word 2-field struct") do ->
      test_contains_2field_absent()
    end

    it("contains over a 3-field cow struct compares field-deep") do ->
      test_contains_3field_cow()
    end

    it("index_of returns the correct index for 2-field structs") do ->
      test_index_of_2field()
    end

    it("index_of over a 3-field cow struct is field-deep") do ->
      test_index_of_3field_cow()
    end

    it("dedup keeps distinct same-first-word 2-field structs") do ->
      test_dedup_2field()
    end

    it("dedup over a 3-field cow struct is field-deep") do ->
      test_dedup_3field_cow()
    end

    it("Vec<Int> contains/index_of/dedup stay correct (control)") do ->
      test_int_contains_index_dedup()
    end
  end

  return qspec_main()
end
