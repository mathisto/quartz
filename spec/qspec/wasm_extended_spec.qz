## WASM Extended Runtime Tests
##
## Tests for Phase 7 functions: extended strings, float math, bit ops,
## char classification, map, vec_clone/slice, str_cmp, unwrap_or.

import * from qspec

extern "C" def getpid(): CInt

var _we_tid = 0

def _we_run(source: String): Int
  _we_tid += 1
  var pid = getpid()
  var src = "/tmp/_we_#{pid}_#{_we_tid}.qz"
  var wasm = "/tmp/_we_#{pid}_#{_we_tid}.wasm"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return -1
  end
  var rr = system("wasmtime #{wasm} 2>/dev/null")
  return rr / 256
end

def _we_capture(source: String): String
  _we_tid += 1
  var pid = getpid()
  var src = "/tmp/_we_#{pid}_#{_we_tid}.qz"
  var wasm = "/tmp/_we_#{pid}_#{_we_tid}.wasm"
  var out = "/tmp/_we_#{pid}_#{_we_tid}.out"
  write_file(src, source)
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var cr = system("#{compiler} --backend wasm --no-cache -I . -I std #{src} -o #{wasm} 2>/dev/null")
  if cr != 0
    return "COMPILE_FAILED"
  end
  var rr = system("wasmtime #{wasm} >#{out} 2>/dev/null")
  return read_file(out)
end

def _we_wasm_available(): Bool
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    compiler = "self-hosted/bin/quartz"
  end
  var pid = getpid()
  var probe = "/tmp/_we_probe_#{pid}.qz"
  var probe_wasm = "/tmp/_we_probe_#{pid}.wasm"
  write_file(probe, "def main(): Int = 0\n")
  var rc = system("#{compiler} --backend wasm --no-cache -I . -I std #{probe} -o #{probe_wasm} 2>/dev/null")
  return rc == 0
end

def main(): Int
  if _we_wasm_available() == false
    puts("[skip] wasm_extended_spec: set QUARTZ_COMPILER to a --feature wasm build to run")
    return qspec_exclude_feature("wasm")
  end
  # =========================================================================
  # Char classification (is_alnum, is_whitespace, is_upper, is_lower)
  # =========================================================================
  describe("WASM char classification extended") do ->
    it("is_alnum: digits + letters") do ->
      var s = """
        def main(): Int
          # '0'=48 digit, 'A'=65 upper, 'z'=122 lower, ' '=32 none
          return is_alnum(48) + is_alnum(65) + is_alnum(122) + is_alnum(32)
        end
        """
      assert_eq(_we_run(s), 3)
    end
    it("is_whitespace: space/tab/lf/cr") do ->
      var s = """
        def main(): Int
          return is_whitespace(32) + is_whitespace(9) + is_whitespace(10) + is_whitespace(13) + is_whitespace(65)
        end
        """
      assert_eq(_we_run(s), 4)
    end
    it("is_upper + is_lower") do ->
      var s = """
        def main(): Int
          return is_upper(65) + is_upper(90) + is_upper(97) + is_lower(97) + is_lower(122) + is_lower(65)
        end
        """
      assert_eq(_we_run(s), 4)
    end
  end

  # =========================================================================
  # String trim operations
  # =========================================================================
  describe("WASM str_trim") do ->
    it("trim both sides") do ->
      var s = """
        def main(): Int
          puts(str_trim("  hello  "))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "hello\n")
    end
    it("trim_left only") do ->
      var s = """
        def main(): Int
          puts(str_trim_left("  hello  "))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "hello  \n")
    end
    it("trim_right only") do ->
      var s = """
        def main(): Int
          puts(str_trim_right("  hello  "))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "  hello\n")
    end
    it("trim empty + no whitespace") do ->
      var s = """
        def main(): Int
          var a = str_trim("")
          var b = str_trim("abc")
          return str_byte_len(a) + str_byte_len(b)
        end
        """
      assert_eq(_we_run(s), 3)
    end
  end

  # =========================================================================
  # String case conversion
  # =========================================================================
  describe("WASM str_downcase/upcase") do ->
    it("downcase") do ->
      var s = """
        def main(): Int
          puts(str_downcase("Hello World"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "hello world\n")
    end
    it("upcase") do ->
      var s = """
        def main(): Int
          puts(str_upcase("Hello World"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "HELLO WORLD\n")
    end
    it("case preserves non-alpha") do ->
      var s = """
        def main(): Int
          puts(str_downcase("ABC 123 !@#"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "abc 123 !@#\n")
    end
  end

  # =========================================================================
  # String repeat
  # =========================================================================
  describe("WASM str_repeat") do ->
    it("repeat 3 times") do ->
      var s = """
        def main(): Int
          puts(str_repeat("ab", 3))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "ababab\n")
    end
    it("repeat 0 times") do ->
      var s = """
        def main(): Int
          var s = str_repeat("abc", 0)
          return str_byte_len(s)
        end
        """
      assert_eq(_we_run(s), 0)
    end
  end

  # =========================================================================
  # String comparison
  # =========================================================================
  describe("WASM str_cmp") do ->
    it("equal strings return 0") do ->
      var s = """
        def main(): Int
          var r = str_cmp("abc", "abc")
          if r == 0
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
    it("less than returns negative") do ->
      var s = """
        def main(): Int
          var r = str_cmp("abc", "abd")
          if r < 0
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
    it("shorter string is less") do ->
      var s = """
        def main(): Int
          var r = str_cmp("ab", "abc")
          if r < 0
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
  end

  # =========================================================================
  # Vec clone and slice
  # =========================================================================
  describe("WASM vec_clone") do ->
    it("clone preserves elements") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          var c = vec_clone(v)
          return vec_get(c, 0) + vec_get(c, 1)
        end
        """
      assert_eq(_we_run(s), 30)
    end
    it("clone is independent") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 1)
          var c = vec_clone(v)
          vec_push(v, 2)
          return vec_size(c)
        end
        """
      assert_eq(_we_run(s), 1)
    end
  end

  describe("WASM vec_slice") do ->
    it("slice sub-range") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, 10)
          vec_push(v, 20)
          vec_push(v, 30)
          var s = vec_slice(v, 1, 3)
          return vec_get(s, 0) + vec_get(s, 1)
        end
        """
      assert_eq(_we_run(s), 50)
    end
  end

  # =========================================================================
  # unwrap_or
  # =========================================================================
  describe("WASM unwrap_or") do ->
    it("Some returns payload") do ->
      var s = """
        def main(): Int
          var opt = option_some(42)
          return unwrap_or(opt, 0)
        end
        """
      assert_eq(_we_run(s), 42)
    end
    it("None returns default") do ->
      var s = """
        def main(): Int
          var opt = option_none()
          return unwrap_or(opt, 99)
        end
        """
      assert_eq(_we_run(s), 99)
    end
  end

  # =========================================================================
  # Float math (native WASM f64 ops)
  # =========================================================================
  describe("WASM float math") do ->
    it("f64_abs") do ->
      # f64_abs(-1.0) should give 1.0; we check via bit pattern
      # -1.0 as i64 = -4616189618054758400 (0xBFF0000000000000)
      #  1.0 as i64 =  4607182418800017408 (0x3FF0000000000000)
      var s = """
        def main(): Int
          var neg_one = -4616189618054758400
          var result = f64_abs(neg_one)
          if result == 4607182418800017408
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
    it("f64_neg double negation") do ->
      # f64_neg(f64_neg(x)) == x for any x
      var s = """
        def main(): Int
          var x = 4607182418800017408
          var y = f64_neg(f64_neg(x))
          if y == x
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
  end

  # =========================================================================
  # Bit manipulation
  # =========================================================================
  describe("WASM bit ops") do ->
    it("bnot") do ->
      var s = """
        def main(): Int
          var x = bnot(0)
          if x == -1
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
    it("popcount") do ->
      # popcount(7) = 3 (binary 111)
      var s = """
        def main(): Int
          return popcount(7)
        end
        """
      assert_eq(_we_run(s), 3)
    end
    it("clz") do ->
      # clz(1) = 63 for i64
      var s = """
        def main(): Int
          return clz(1)
        end
        """
      assert_eq(_we_run(s), 63)
    end
    it("ctz") do ->
      # ctz(8) = 3 (binary 1000)
      var s = """
        def main(): Int
          return ctz(8)
        end
        """
      assert_eq(_we_run(s), 3)
    end
  end

  # =========================================================================
  # Map (proper integer hashing, not string hashing)
  # =========================================================================
  describe("WASM map") do ->
    it("set + get") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set(42, 100)
          return m.get(42)
        end
        """
      assert_eq(_we_run(s), 100)
    end
    it("has + size") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set(1, 10)
          m.set(2, 20)
          return m.has(1) + m.size()
        end
        """
      assert_eq(_we_run(s), 3)
    end
    it("del") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set(5, 50)
          m.delete(5)
          return m.has(5)
        end
        """
      assert_eq(_we_run(s), 0)
    end
    it("overwrite") do ->
      var s = """
        def main(): Int
          var m = map_new()
          m.set(1, 10)
          m.set(1, 99)
          return m.get(1)
        end
        """
      assert_eq(_we_run(s), 99)
    end
    it("multiple keys with rehash") do ->
      # 20 entries triggers rehash (75% of 16). Verify post-rehash lookup.
      # WASI exit codes must be < 126, so compare instead of returning value directly.
      var s = """
        def main(): Int
          var m = map_new()
          var i = 0
          while i < 20
            m.set(i, i * 10)
            i += 1
          end
          if m.get(15) == 150
            return 1
          end
          return 0
        end
        """
      assert_eq(_we_run(s), 1)
    end
  end

  # =========================================================================
  # str_replace
  # =========================================================================
  describe("WASM str_replace") do ->
    it("replace substring") do ->
      var s = """
        def main(): Int
          puts(str_replace("hello world", "world", "quartz"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "hello quartz\n")
    end
    it("replace multiple occurrences") do ->
      var s = """
        def main(): Int
          puts(str_replace("abcabc", "ab", "X"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "XcXc\n")
    end
  end

  # =========================================================================
  # str_split + str_join
  # =========================================================================
  describe("WASM str_split") do ->
    it("split by delimiter") do ->
      var s = """
        def main(): Int
          var parts = str_split("a,b,c", ",")
          return vec_size(parts)
        end
        """
      assert_eq(_we_run(s), 3)
    end
    it("split content correct") do ->
      var s = """
        def main(): Int
          var parts = str_split("hello world", " ")
          puts(vec_get(parts, 0))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "hello\n")
    end
  end

  describe("WASM str_join") do ->
    it("join with separator") do ->
      var s = """
        def main(): Int
          var v = vec_new()
          vec_push(v, "a")
          vec_push(v, "b")
          vec_push(v, "c")
          puts(str_join(v, "-"))
          return 0
        end
        """
      assert_eq_str(_we_capture(s), "a-b-c\n")
    end
  end

  return qspec_main()
end
