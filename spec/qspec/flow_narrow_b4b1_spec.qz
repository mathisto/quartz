## SURF.FLOW B4-b1 — exhaustive-match divergence unlocks guard-style narrowing.
##
## The guard-style early-exit narrowing path (typecheck_walk.qz, the
## `tc_stmt_diverges(then_node) == 1` gate) proves the subject is the ELSE variant
## AFTER an `if <guard>` whose then-branch definitely diverges — control reaches
## the code after the `if` only on the guard-FALSE path.
##
## B4-b1 extends `tc_stmt_diverges` with a NODE_MATCH arm: a match that is TOTAL
## (int_val==1 stamp set by tc_check_exhaustiveness when the Maranget witness is
## -1) AND all of whose arm bodies diverge is itself a diverging statement. This
## makes an EXHAUSTIVE `match` whose every arm `return`s a valid guard-early-exit
## then-branch — exactly like a bare `return`.
##
## POSITIVE: `if o.none? <exhaustive-diverging match on e>` narrows `o` to Some
## after the `if` (inner value reachable via a bare read).
## SOUNDNESS BOUNDARIES (must NOT narrow):
##   - a NON-total match (one Int arm, no `_`) can fall through → no narrow.
##   - a total match with ONE non-diverging arm yields a value on that path → no
##     narrow.
## Both boundaries are asserted via the `.unwrap()` wide path compiling and
## returning the present value (if narrowing wrongly fired, the bare read would be
## inner T and `.unwrap()` would trip QZ0406 → compile failure).
import * from qspec

enum Sig
  Go
  Stop
end

def use_int_b4(x: Int): Int = x + 100
def use_int_raw_b4(x: Int): Int = x

## POSITIVE: exhaustive match, both arms return → then-branch diverges → `o`
## narrows to Some after the `if`. Bare read reaches inner Int (13).
def diverging_match_guard_narrows(o: Option<Int>, s: Sig): Int
  if o.none?
    match s
      Sig::Go => return 0
      Sig::Stop => return 1
    end
  end
  # reached only when `o` is Some — narrowed bare read → inner Int.
  return use_int_raw_b4(o)
end

## POSITIVE via `+ 100` shaping to make the narrow observable end-to-end.
def diverging_match_guard_shaped(o: Option<Int>, s: Sig): Int
  if o.none?
    match s
      Sig::Go => return 0
      Sig::Stop => return 1
    end
  end
  return use_int_b4(o)
end

## SOUNDNESS: a total match with ONE non-diverging arm (Sig::Go just falls
## through the match) does NOT diverge → the then-branch can fall through → no
## narrow. `o` stays wide Option; value reached only via `.unwrap()`.
def partial_diverge_match_no_narrow(o: Option<Int>, s: Sig): Int
  var side = 0
  if o.none?
    match s
      Sig::Go => side = 1
      Sig::Stop => return 1
    end
  end
  return o.unwrap()
end

def main(): Int
  describe("SURF.FLOW B4-b1 — exhaustive-match divergence unlocks narrowing") do ->
    it("narrows the subject after an all-arms-return exhaustive match guard") do ->
      assert_eq(diverging_match_guard_narrows(option_some(13), Sig::Go), 13)
    end

    it("narrowed value shapes through a downstream call (+100)") do ->
      assert_eq(diverging_match_guard_shaped(option_some(42), Sig::Stop), 142)
    end
  end

  describe("SURF.FLOW B4-b1 — soundness boundary (must not narrow)") do ->
    it("does not narrow when one match arm falls through (match not diverging)") do ->
      assert_eq(partial_diverge_match_no_narrow(option_some(7), Sig::Go), 7)
    end
  end

  return qspec_main()
end
