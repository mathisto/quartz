## Map (Int keys) Tests
##
## Contract:
##   1. Creates a map with int keys.
##   2. Handles multiple keys.
##   3. Map_delete removes keys.
##   4. Map_free frees map.
##   5. Map_has returns false for missing keys.
##   6. Map_has returns true for existing keys.
##   7. map_get returns Option (v5.27).
##   8. for-in iterates int keys via intmap_keys (not hashmap_keys).
import * from qspec

# Helper functions for int-key iteration tests.
# Kept at top-level (not inline in `it` blocks) to avoid a pre-existing
# typechecker crash on for-in statements inside `it() do -> ... end` lambdas.
def count_int_map_keys(): Void
  var m = map_new<Int, Int>()
  m.set(10, 100)
  m.set(20, 200)
  m.set(30, 300)
  var count = 0
  for k in m
    count += 1
  end
  puts(count.to_s())
end

def sum_int_map_keys(): Void
  # Valid int keys can include 0 and 1 — intmap_keys uses the occupancy
  # bitmap, not the key value, to detect live slots.
  var m = map_new<Int, Int>()
  m.set(1, 0)
  m.set(2, 0)
  m.set(3, 0)
  m.set(4, 0)
  var total = 0
  for k in m
    total += k
  end
  puts(total.to_s())
end

def iter_int_map_values(): Void
  var m = map_new<Int, Int>()
  m.set(100, 7)
  m.set(200, 11)
  m.set(300, 13)
  var total = 0
  for k in m
    total += m.get(k).unwrap()
  end
  puts(total.to_s())
end

def main(): Int
  describe("map (int keys)") do ->
    it("creates a map with int keys") do ->
      m = map_new<Int, Int>()
      assert_ne(m, 0)
    end
    it("stores and retrieves values") do ->
      m = map_new<Int, Int>()
      m.set(42, 100)
      v = m.get(42).unwrap()
      assert_eq(v, 100)
    end
    it("handles multiple keys") do ->
      m = map_new<Int, Int>()
      m.set(1, 10)
      m.set(2, 20)
      m.set(3, 30)
      sum = m.get(1).unwrap() + m.get(2).unwrap() + m.get(3).unwrap()
      assert_eq(sum, 60)
    end
    it("overwrites existing keys") do ->
      m = map_new<Int, Int>()
      m.set(5, 100)
      m.set(5, 200)
      v = m.get(5).unwrap()
      assert_eq(v, 200)
    end
    it("map_get returns Some for existing keys") do ->
      m = map_new<Int, Int>()
      m.set(99, 1)
      result = m.get(99)
      assert(result.some?)
      assert_eq(result.unwrap(), 1)
    end
    it("map_get returns None for missing keys") do ->
      m = map_new<Int, Int>()
      m.set(1, 100)
      result = m.get(2)
      assert(result.none?)
    end
    it("map_has returns true for existing keys") do ->
      m = map_new<Int, Int>()
      m.set(99, 1)
      h = m.has(99)
      if h
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
    it("map_has returns false for missing keys") do ->
      m = map_new<Int, Int>()
      m.set(1, 100)
      h = m.has(2)
      if h
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end
    it("map_delete removes keys") do ->
      m = map_new<Int, Int>()
      m.set(10, 100)
      m.set(20, 200)
      m.delete(10)
      h = m.has(10)
      if h
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end
    it("map_free frees map") do ->
      m = map_new<Int, Int>()
      m.set(1, 10)
      m.free()
      assert_eq(1, 1)
    end
    it("for-in counts int map keys via intmap_keys") do ->
      assert_output("3\n", count_int_map_keys)
    end
    it("for-in sums int map keys directly") do ->
      assert_output("10\n", sum_int_map_keys)
    end
    it("for-in iterates int keys for value lookup") do ->
      assert_output("31\n", iter_int_map_values)
    end
  end
  return qspec_main()
end
