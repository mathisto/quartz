## Phase 4.B.2 — typechecker: `can Yield` helpers + generator scope
##
## Operation Piezoelectric Effects, Phase 4 Path B, Milestone 4.B.2.
##
## Path B routes generators through the kind=3 effect machinery. The
## typechecker-side payoff of this milestone is two new shapes that
## wouldn't typecheck before:
##
##   1. Modular yield helpers — `def emit(v): Void can Yield<Int>` with a
##      `yield v` body, callable from another function.
##   2. Such a helper called from inside a generator function
##      (`impl Iterator<T>` return) — the generator's implicit `with Yield`
##      handler-stack push (added by 4.B.2 in tc_function) subsumes the
##      helper's `can Yield` row.
##
## Scope of this milestone (typecheck only, no MIR yet):
##   - `yield` inside a function declaring `can Yield` is accepted.
##   - A generator body calling a `can Yield` helper typechecks clean.
##   - `yield` outside any generator / `can Yield` / `with Yield` scope
##     still emits QZ0170 (preserved until 4.B.7 unifies with QZ0611).
##
## Runtime behavior for the modular-helper case lands in 4.B.3
## (NODE_YIELD → kind=3 perform); today's MIR lowering rejects `yield`
## outside `mir_lower_generator`'s own scope, so we only subprocess-
## compile these programs, not run them.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4.B.2 — can Yield typecheck surface") do ->
    it("a helper with `can Yield<Int>` + `yield v` typechecks") do ->
      # Yield is provided by prelude (`import * from std/gen`).
      var src = """
def emit(v: Int): Void can Yield<Int>
  yield v
end

def main(): Int = 0
"""
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("generator body can call a `can Yield` helper") do ->
      var src = """
def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def my_gen(): impl Iterator<Int>
  emit_pair(1, 2)
  emit_pair(3, 4)
end

def main(): Int = 0
"""
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("`yield` with no generator scope AND no can Yield still fails (QZ0170)") do ->
      assert_compile_error("""
def bad(): Void
  yield 42
end

def main(): Int = 0
""", "QZ0170")
    end

    it("existing `impl Iterator<Int>` generator still typechecks (regression)") do ->
      var src = """
def nums(): impl Iterator<Int>
  yield 1
  yield 2
  yield 3
end

def main(): Int = 0
"""
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end

    it("existing `impl AsyncIterator<Int>` generator still typechecks (regression)") do ->
      var src = """
def anums(): impl AsyncIterator<Int>
  yield 10
  yield 20
end

def main(): Int = 0
"""
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end
  end
  return qspec_main()
end
