## Json Ufcs Tests
##
## Contract:
##   1. Predicates: `.is_null()`, `.is_number()`, `.is_bool()`, `.is_string()`, `.is_array()`, `.is_object()`.
##   2. Int extractors: `.as_number()`, `.as_bool()` via dot syntax.
##   3. Operations: `.has()` on object, `.size()` on array, `.get_at()` on array.
##   4. Negative predicates: wrong type returns false.
import * from qspec
import * from json

def main(): Int
  describe("json UFCS predicates") do ->
    it("type checks via dot syntax") do ->
      assert_eq(json_null().is_null(), true)
      assert_eq(json_null().is_string(), false)
      assert_eq(json_number(42).is_number(), true)
      assert_eq(json_bool(1).is_bool(), true)
      assert_eq(json_string("hi").is_string(), true)
      assert_eq(json_array().is_array(), true)
      assert_eq(json_object().is_object(), true)
    end
  end

  describe("json UFCS int extractors") do ->
    it("as_number and as_bool via dot syntax") do ->
      assert_eq(json_number(99).as_number(), 99)
      assert_eq(json_bool(1).as_bool(), 1)
      assert_eq(json_bool(0).as_bool(), 0)
    end
  end

  describe("json UFCS operations") do ->
    it("object .has() and array .size()") do ->
      var obj = json_object()
      json_object_set(obj, "k", json_string("v"))
      assert_eq(obj.has("k"), true)
      assert_eq(obj.has("z"), false)
      var arr = json_array()
      arr.push(json_number(10))
      arr.push(json_number(20))
      assert_eq(arr.size(), 2)
      assert_eq(arr.get_at(0).as_number(), 10)
    end
  end

  describe("json UFCS negative predicates") do ->
    it("wrong type predicates return false") do ->
      assert_eq(json_number(1).is_string(), false)
      assert_eq(json_string("x").is_number(), false)
      assert_eq(json_null().is_array(), false)
    end
  end

  return qspec_main()
end
