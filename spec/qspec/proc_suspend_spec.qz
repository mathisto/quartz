## proc_suspend(pid) — async wait for child process exit
##
## Verifies the new pidfd (Linux) / EVFILT_PROC (macOS) intrinsic that
## suspends a Quartz async task until a child process exits, integrated
## with the M:N scheduler's I/O poller. Tests cover:
##   1. Basic wake-on-exit — fork a child that sleeps + exits, parent's
##      proc_suspend wakes promptly.
##   2. Already-exited child — a pid that already exited before
##      sched_register_proc runs should immediately re-enqueue the task.
##   3. Cooperative concurrency — proc_suspend yields cleanly so other
##      tasks (idle hook in particular) keep running while we wait.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("proc_suspend") do ->
    it("wakes when child exits after a brief sleep") do ->
      var src = """
        extern "C" def fork(): CInt
        extern "C" def usleep(usec: CInt): CInt
        extern "C" def _exit(status: CInt): Void
        extern "C" def waitpid(pid: CInt, status: CPtr, options: CInt): CInt

        def child_then_exit(): Int
          # 50 ms sleep then exit cleanly
          usleep(50000)
          _exit(0)
          return 0
        end

        def wait_for_child(pid: Int): Int
          proc_suspend(pid)
          return 1
        end

        def main(): Int
          var pid = fork()
          if pid == 0
            child_then_exit()
            return 0
          end
          var task = go wait_for_child(pid)
          var ok = await task
          var status_buf = mem_alloc(16)
          waitpid(pid, status_buf, 0)
          if ok == 1
            puts("woke")
          else
            puts("nope")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "woke\n")
    end

    it("re-enqueues immediately when the child has already exited") do ->
      var src = """
        extern "C" def fork(): CInt
        extern "C" def usleep(usec: CInt): CInt
        extern "C" def _exit(status: CInt): Void
        extern "C" def waitpid(pid: CInt, status: CPtr, options: CInt): CInt

        def wait_for_child(pid: Int): Int
          proc_suspend(pid)
          return 7
        end

        def main(): Int
          var pid = fork()
          if pid == 0
            _exit(0)
            return 0
          end
          # Give the child a head start so it exits before proc_suspend runs
          usleep(30000)
          var task = go wait_for_child(pid)
          var rc = await task
          var status_buf = mem_alloc(16)
          waitpid(pid, status_buf, 0)
          puts("rc=" + rc.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "rc=7\n")
    end

    it("idle hook keeps firing while a proc_suspend task is parked") do ->
      var src = """
        extern "C" def fork(): CInt
        extern "C" def usleep(usec: CInt): CInt
        extern "C" def _exit(status: CInt): Void
        extern "C" def waitpid(pid: CInt, status: CPtr, options: CInt): CInt

        var _ticks: Int = 0
        def tick(): Void can Sched
          _ticks = _ticks + 1
        end

        def wait_for_child(pid: Int): Int
          proc_suspend(pid)
          return 0
        end

        def main(): Int
          var pid = fork()
          if pid == 0
            usleep(150000)
            _exit(0)
            return 0
          end
          sched_idle_hook_set(tick)
          var task = go wait_for_child(pid)
          var rc = await task
          sched_idle_hook_clear()
          var status_buf = mem_alloc(16)
          waitpid(pid, status_buf, 0)
          if _ticks > 5
            puts("animated")
          else
            puts("stalled")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "animated\n")
    end
  end

  return qspec_main()
end
