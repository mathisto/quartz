## Default Async handler (scheduler) — Phase 3 Milestone P3.B spec.
##
## Operation Piezoelectric Effects, Phase 3, Milestone P3.B.
##
## Validates the prelude-installed default handler for the `Async`
## effect. The handler has the D.4/E(post) ABI
## `i64 (ptr %op, i64 %argc, ptr %argv)` and dispatches on op name:
##
##   * `yield` — calls `@usleep(1)` (matches existing `sched_yield`
##     semantics) and returns 0.
##   * `await` / `spawn` / `suspend` / other — returns 0 stub. P3.C
##     replaces these stubs with real scheduler delegation when
##     NODE_AWAIT / NODE_GO / io_suspend are migrated to
##     `perform(Async, ...)`.
##
## Observations asserted at IR level (post-codegen text of the main
## wrapper + runtime block). A full behavioral check for `yield()` would
## need keyword-at-expression-position support (async keywords `yield` /
## `await` are still reserved at expression position); the runtime
## wiring itself is proven end-to-end via IR shape + install call
## presence + no regression on existing smoke/spec suites.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("default Async handler is installed in every program's main prelude") do ->
    it("runtime emits the Async effect-name constant") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "@__qz_eff_name_async")
    end

    it("runtime emits the default Async handler function") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "@__qz_default_async_handler(ptr %op, i64 %argc, ptr %argv)")
    end

    it("runtime emits the 'yield' op-name constant for dispatch") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "@__qz_eff_op_yield")
    end

    it("main prelude installs the Async default handler") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "call void @__qz_effect_handle_install(ptr @__qz_eff_name_async,")
    end

    it("default Async handler calls @usleep for the yield op") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "call i32 @usleep(i32 1)")
    end

    it("programs with zero Async mention still compile + run cleanly") do ->
      # Regression guard: the mere presence of the Async default must
      # not perturb programs that never import std/async. If prelude
      # install ever crashes or alters libc exit path, this fires.
      assert_run_exits("""
def main(): Int
  puts("no async here")
  return 0
end
""", 0)
    end

    it("programs that import std/async still compile + run cleanly") do ->
      # Dormancy test. Importing std/async must not force any Async ops
      # to be performed, must not alter exit behavior, and must not trip
      # the default handler on startup.
      assert_run_exits("""
import std/async

def main(): Int
  puts("imported but silent")
  return 0
end
""", 0)
    end
  end
  return qspec_main()
end
