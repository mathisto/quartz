## Unicode Normalization Tests (NFD/NFC)
##
## Contract:
##   1. NFD decomposes precomposed characters.
##   2. NFC recomposes to precomposed form.
##   3. Canonical equivalence comparison.
##   4. Combining mark reordering.
##   5. Hangul syllable handling.

import * from qspec
import * from unicode
import * from unicode/normalize

## Build e-acute as precomposed (U+00E9) — NFC form
def build_e_acute_nfc(): String
  return str_from_codepoint(0xE9)
end

## Build e-acute as decomposed (U+0065 + U+0301) — NFD form
def build_e_acute_nfd(): String
  var sb = sb_new()
  sb_append(sb, "e")
  sb_append(sb, str_from_codepoint(0x0301))
  return sb_to_string(sb)
end

## Build string with two combining marks: e + combining below (U+0323) + combining above (U+0301)
def build_two_marks(): String
  var sb = sb_new()
  sb_append(sb, "e")
  sb_append(sb, str_from_codepoint(0x0323))
  sb_append(sb, str_from_codepoint(0x0301))
  return sb_to_string(sb)
end

## Build Hangul syllable "ga" (U+AC00 = U+1100 + U+1161)
def build_hangul_ga(): String
  return str_from_codepoint(0xAC00)
end

def main(): Int
  describe("unicode_ccc") do ->
    it("returns 0 for starters") do ->
      assert_eq(unicode_ccc(65), 0)
      assert_eq(unicode_ccc(0xE9), 0)
    end

    it("returns non-zero for combining marks") do ->
      ## U+0301 (combining acute) has CCC 230
      var ccc = unicode_ccc(0x0301)
      assert_eq(ccc > 0, true)
    end

    it("returns different CCC for below vs above") do ->
      ## U+0323 (combining dot below) has CCC 220
      ## U+0301 (combining acute above) has CCC 230
      var below = unicode_ccc(0x0323)
      var above = unicode_ccc(0x0301)
      assert_eq(below < above, true)
    end
  end

  describe("unicode_nfd") do ->
    it("decomposes precomposed e-acute") do ->
      var nfc = build_e_acute_nfc()
      var nfd = unicode_nfd(nfc)
      ## Should be 2 codepoints: e (U+0065) + combining acute (U+0301)
      assert_eq(str_size(nfd), 2)
      assert_eq(str_codepoint_nth(nfd, 0), 0x65)
      assert_eq(str_codepoint_nth(nfd, 1), 0x0301)
    end

    it("leaves ASCII unchanged") do ->
      assert_eq_str(unicode_nfd("hello"), "hello")
    end

    it("leaves already-decomposed unchanged") do ->
      var nfd = build_e_acute_nfd()
      assert_eq_str(unicode_nfd(nfd), nfd)
    end

    it("decomposes Hangul syllable") do ->
      var ga = build_hangul_ga()
      var nfd = unicode_nfd(ga)
      ## AC00 -> 1100 + 1161
      assert_eq(str_size(nfd), 2)
      assert_eq(str_codepoint_nth(nfd, 0), 0x1100)
      assert_eq(str_codepoint_nth(nfd, 1), 0x1161)
    end

    it("handles empty string") do ->
      assert_eq_str(unicode_nfd(""), "")
    end

    it("reorders combining marks by CCC") do ->
      ## e + combining above (230) + combining below (220)
      ## Should reorder to: e + combining below (220) + combining above (230)
      var sb = sb_new()
      sb_append(sb, "e")
      sb_append(sb, str_from_codepoint(0x0301))
      sb_append(sb, str_from_codepoint(0x0323))
      var input = sb_to_string(sb)
      var nfd = unicode_nfd(input)
      assert_eq(str_codepoint_nth(nfd, 0), 0x65)
      assert_eq(str_codepoint_nth(nfd, 1), 0x0323)
      assert_eq(str_codepoint_nth(nfd, 2), 0x0301)
    end
  end

  describe("unicode_nfc") do ->
    it("composes decomposed e-acute") do ->
      var nfd = build_e_acute_nfd()
      var nfc = unicode_nfc(nfd)
      ## Should be single precomposed e-acute (U+00E9)
      assert_eq(str_size(nfc), 1)
      assert_eq(str_codepoint_nth(nfc, 0), 0xE9)
    end

    it("preserves precomposed form") do ->
      var original = build_e_acute_nfc()
      var nfc = unicode_nfc(original)
      assert_eq(str_size(nfc), 1)
      assert_eq(str_codepoint_nth(nfc, 0), 0xE9)
    end

    it("leaves ASCII unchanged") do ->
      assert_eq_str(unicode_nfc("hello"), "hello")
    end

    it("composes Hangul jamo to syllable") do ->
      ## U+1100 + U+1161 -> U+AC00
      var sb = sb_new()
      sb_append(sb, str_from_codepoint(0x1100))
      sb_append(sb, str_from_codepoint(0x1161))
      var input = sb_to_string(sb)
      var nfc = unicode_nfc(input)
      assert_eq(str_size(nfc), 1)
      assert_eq(str_codepoint_nth(nfc, 0), 0xAC00)
    end
  end

  describe("unicode_eq_canonical") do ->
    it("treats NFC and NFD as equivalent") do ->
      var nfc = build_e_acute_nfc()
      var nfd = build_e_acute_nfd()
      assert_eq(unicode_eq_canonical(nfc, nfd), true)
    end

    it("rejects non-equivalent strings") do ->
      assert_eq(unicode_eq_canonical("hello", "world"), false)
    end

    it("handles ASCII identity") do ->
      assert_eq(unicode_eq_canonical("test", "test"), true)
    end
  end

  return qspec_main()
end
