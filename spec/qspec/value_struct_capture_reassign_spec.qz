import * from qspec

# WS1a/WS1b — bare-reassignment capture: crash fix (Phase A) + value-struct
# whole-var-reassignment PERSISTENCE (Phase B).
#
# A bare reassignment `a = expr` inside a closure lowers to NODE_LET int_val==0
# (the CST's cps_assign_kind_for_lhs classifies a bare-ident `= expr` as a const
# binding — it cannot know syntactically that `a` is an outer capture). The MIR
# capture walker used to (a) push ANY NODE_LET name into its non-capture shadow
# scope with no int_val guard, treating the reassigned OUTER var `a` as a fresh
# local, and (b) walk only the RHS of a NODE_LET, so a WRITE-ONLY `{ a = ... }`
# whose RHS never references `a` never saw `a` as an IDENT either. Net effect: `a`
# was DROPPED from the capture set → no env slot → lost mutation, or (on a later
# uninitialized value-layout read that touches `handle+8`) a SIGSEGV.
#
# Phase A (WS1a) collected the reassigned outer name as a capture (crash gone).
# Phase B (WS1b) removes the value-layout exclusion from the by-ref eligibility
# gate for the WHOLE-VAR reassignment case, so a value-layout captured var that is
# reassigned uses the SAME ref-var machinery as scalars: the env holds the ADDRESS
# of the caller's single-word handle slot (borrow-not-own, no value_copy), and a
# whole-var reassignment write-throughs the NEW handle into the caller's slot — so
# the mutation PERSISTS. (Field/index writes on a captured value-struct are WS2,
# still by-value.)

# --- scalar write-only reassignment: mutation must PERSIST (Phase A) ---

def scalar_write_only_persists(): Void
  var n = 0
  [1].each { n = 7 }
  print(n.to_s())
  print("\n")
end

# --- <=16B value-struct whole-var reassignment: mutation must PERSIST (Phase B) ---

@value
struct P
  x: Int
  y: Int
end

def value_write_only_persists(): Void
  var a = P { x: 0, y: 0 }
  [1].each { a = P { x: 5, y: 6 } }
  # Phase B: the reassignment write-throughs the new handle into the caller's slot,
  # so `a` now reads the closure-constructed value.
  print(a.x.to_s())
  print("\n")
end

# --- <=16B accumulate form: closure READS and REASSIGNS the captured value ---
# The read stays a deref of the LIVE caller slot (current handle); the write
# persists. `10.triple`-style accumulation across two elements.

@value
struct Acc
  t: Int
  u: Int
end

def value_accumulate_persists(): Void
  var acc = Acc { t: 0, u: 0 }
  [10, 20].each { acc = Acc { t: acc.t + it, u: 0 } }
  print(acc.t.to_s())
  print("\n")
end

# --- >16B value-struct with a String field: touches handle+8; must PERSIST (Phase B) ---
# The CoW-layout (buffer-handle) shape — the write-through stores the new buffer
# handle into the caller's slot. Read after the closure returns the persisted a-field.

@value
struct Big
  a: Int
  b: Int
  c: Int
  name: String
end

def big_value_write_only_persists(): Void
  var g = Big { a: 0, b: 0, c: 0, name: "init" }
  [1].each { g = Big { a: 1, b: 2, c: 3, name: "set" } }
  print(g.a.to_s())
  print("\n")
end

def main(): Int
  describe("closure bare-reassignment capture (WS1a/WS1b)") do ->
    it("scalar write-only reassignment inside a closure persists") do ->
      assert_output("7\n", scalar_write_only_persists)
    end

    it("<=16B value-struct whole-var reassignment persists") do ->
      assert_output("5\n", value_write_only_persists)
    end

    it("<=16B value-struct accumulate (read+reassign) persists") do ->
      assert_output("30\n", value_accumulate_persists)
    end

    it(">16B value-struct (String field) whole-var reassignment persists") do ->
      assert_output("1\n", big_value_write_only_persists)
    end
  end

  return qspec_main()
end
