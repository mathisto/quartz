## Scoped RwLock — B.8 Phase 5 (RwLockReadGuard + RwLockWriteGuard)
##
## Contract:
##   1. `with rw.read do v -> body end` calls Scoped::acquire, binds the
##      read-locked snapshot to v, and calls Scoped::release on normal
##      exit. release_on_throw fires the same unlock on throw-unwind.
##   2. `with rw.write do v -> body end` similarly grabs the exclusive
##      write lock; release writes the (possibly mutated) v back as the
##      new protected value, and release_on_throw does the same.
##   3. Sequential read locks acquire/release independently.
##   4. Multiple read locks are NOT exercised here (would require a
##      second goroutine); the contract is single-threaded acquire +
##      release fires correctly.
##   5. Throws inside a read or write Scoped block release the lock —
##      a subsequent acquire succeeds rather than deadlocking.
##   6. Write-lock body that mutates v writes back the new value.

import * from qspec
import * from std/sync/exclusion/rwlock
import * from std/throws

# --- Test 1: read lock + normal exit. -----------------------------------

def b8_rw_read_normal_exit(): Int
  var rw = rwlock(7)
  var captured = 0
  with rw.read do v ->
    captured = v
  end
  return captured
end

# --- Test 2: write lock + normal exit. ----------------------------------

def b8_rw_write_normal_exit(): Int
  var rw = rwlock(10)
  var captured = 0
  with rw.write do v ->
    captured = v
  end
  # release wrote v back unchanged (body didn't reassign).
  return captured
end

# --- Test 3: sequential reader blocks. ----------------------------------

def b8_rw_sequential_reads(): Int
  var rw = rwlock(0)
  var t1 = 0
  var t2 = 0
  with rw.read do v ->
    t1 = v + 100
  end
  with rw.read do v ->
    t2 = v + 200
  end
  return t1 + t2
end

# --- Test 4: read followed by write followed by read. -------------------

def b8_rw_read_write_read(): Int
  var rw = rwlock(1)
  var first = 0
  var middle = 0
  var last = 0
  with rw.read do v ->
    first = v
  end
  with rw.write do v ->
    middle = v
  end
  with rw.read do v ->
    last = v
  end
  # All three observe v=1 (no mutation). Sum = 3.
  return first + middle + last
end

# --- Test 5: nested read on different rwlocks. --------------------------

def b8_rw_nested_reads_distinct(): Int
  var rw1 = rwlock(3)
  var rw2 = rwlock(4)
  var sum = 0
  with rw1.read do a ->
    with rw2.read do b ->
      sum = a + b
    end
  end
  return sum
end

# --- Phase 4b throw-safety tests ----------------------------------------

var b8_rw_caught = 0

def b8_rw_capture_throw(op_name: Int, argc: Int, argv: Int): Int
  b8_rw_caught += 1
  return 0
end

# --- Test 6: throw inside read lock fires release_on_throw. -------------

def b8_rw_throw_read_releases(): Int
  var rw = rwlock(7)
  with Throws { throw: b8_rw_capture_throw } do ->
    with rw.read do v ->
      throw("boom-r")
    end
    0
  end
  # If lock leaked, the next read would deadlock. Prove unlock by
  # taking a write lock (write requires NO outstanding readers).
  var sentinel = 0
  with rw.write do v ->
    sentinel = v
  end
  return sentinel
end

# --- Test 7: throw inside write lock fires release_on_throw. ------------

def b8_rw_throw_write_releases(): Int
  var rw = rwlock(11)
  with Throws { throw: b8_rw_capture_throw } do ->
    with rw.write do v ->
      throw("boom-w")
    end
    0
  end
  # Re-acquire write to prove the write lock released. Note: per
  # release_on_throw semantics, the bound v's contents at throw time
  # ARE written back; here v was untouched after acquire (still == 11).
  var seen = 0
  with rw.write do v ->
    seen = v
  end
  return seen
end

# --- Test 8: panic inside write lock releases (parity with mutex). ------

def b8_rw_panic_write_releases(): Int
  var rw = rwlock(42)
  with Throws { throw: b8_rw_capture_throw } do ->
    with rw.write do v ->
      panic("kaboom-rw")
    end
    0
  end
  var seen = 0
  with rw.read do v ->
    seen = v
  end
  return seen
end

def main(): Int
  describe("Scoped RwLock — B.8 Phase 5") do ->
    it("read lock acquires and releases on normal exit") do ->
      assert_eq(b8_rw_read_normal_exit(), 7)
    end

    it("write lock acquires and releases on normal exit") do ->
      assert_eq(b8_rw_write_normal_exit(), 10)
    end

    it("sequential read locks bind and release independently") do ->
      assert_eq(b8_rw_sequential_reads(), 300)
    end

    it("read + write + read roundtrip observes consistent value") do ->
      assert_eq(b8_rw_read_write_read(), 3)
    end

    it("nested read locks on distinct rwlocks bind separately") do ->
      assert_eq(b8_rw_nested_reads_distinct(), 7)
    end

    it("throw in read lock fires release_on_throw, lock released") do ->
      assert_eq(b8_rw_throw_read_releases(), 7)
    end

    it("throw in write lock fires release_on_throw, lock released") do ->
      assert_eq(b8_rw_throw_write_releases(), 11)
    end

    it("panic in write lock fires release_on_throw, lock released") do ->
      assert_eq(b8_rw_panic_write_releases(), 42)
    end
  end

  return qspec_main()
end
