## Set<Struct> value-compare (WS1)
##
## Contract:
##   1. A Set of a value-layout hashable struct compares members BY VALUE
##      (field-deep), not by pointer identity: two distinct instances with
##      equal fields are ONE member.
##   2. has() finds a distinct-but-equal instance.
##   3. Works for a <=16B struct (Point, 2 fields) AND a >16B struct
##      (Vec3, 3 fields).
##   4. delete() removes by value.
##   5. Int-Set control case is UNCHANGED (identity == value for ints).
import * from qspec

struct Point
  x: Int
  y: Int
end

struct Vec3
  a: Int
  b: Int
  c: Int
end

def main(): Int
  describe("Set<Struct> value-compare") do ->
    # ---- <=16B struct (Point) ----
    it("two equal-valued Point instances collapse to one member") do ->
      assert_eq(point_dedup_size(), 1)
    end
    it("has() finds a distinct-but-equal Point instance") do ->
      assert_eq(point_has_equal(), 1)
    end
    it("has() returns 0 for a different Point value") do ->
      assert_eq(point_has_absent(), 0)
    end
    it("three distinct Point values are three members") do ->
      assert_eq(point_three_distinct(), 3)
    end
    it("delete() removes a Point by value") do ->
      assert_eq(point_delete_size(), 1)
    end

    # ---- >16B struct (Vec3, 3 fields) ----
    it("two equal-valued Vec3 instances collapse to one member") do ->
      assert_eq(vec3_dedup_size(), 1)
    end
    it("mixed equal + distinct Vec3 values dedup correctly") do ->
      assert_eq(vec3_mixed_size(), 2)
    end
    it("has() finds a distinct-but-equal Vec3 instance") do ->
      assert_eq(vec3_has_equal(), 1)
    end

    # ---- Int-Set control (identity behavior unchanged) ----
    it("Int-Set dedup control still correct") do ->
      assert_eq(int_dedup_size(), 3)
    end
    it("Int-Set has control still correct") do ->
      assert_eq(int_has_control(), 1)
    end
  end
  return qspec_main()
end

def point_dedup_size(): Int
  var s = set_new()
  var p1 = Point{x: 1, y: 2}
  var p2 = Point{x: 1, y: 2}
  s.add(p1)
  s.add(p2)
  return set_size(s)
end

def point_has_equal(): Int
  var s = set_new()
  s.add(Point{x: 3, y: 4})
  var probe = Point{x: 3, y: 4}
  return set_has(s, probe)
end

def point_has_absent(): Int
  var s = set_new()
  s.add(Point{x: 3, y: 4})
  var probe = Point{x: 9, y: 9}
  return set_has(s, probe)
end

def point_three_distinct(): Int
  var s = set_new()
  s.add(Point{x: 1, y: 1})
  s.add(Point{x: 2, y: 2})
  s.add(Point{x: 3, y: 3})
  return set_size(s)
end

def point_delete_size(): Int
  var s = set_new()
  s.add(Point{x: 1, y: 2})
  s.add(Point{x: 5, y: 6})
  set_delete(s, Point{x: 1, y: 2})
  return set_size(s)
end

def vec3_dedup_size(): Int
  var s = set_new()
  var a1 = Vec3{a: 1, b: 2, c: 3}
  var a2 = Vec3{a: 1, b: 2, c: 3}
  s.add(a1)
  s.add(a2)
  return set_size(s)
end

def vec3_mixed_size(): Int
  var s = set_new()
  s.add(Vec3{a: 1, b: 2, c: 3})
  s.add(Vec3{a: 1, b: 2, c: 3})
  s.add(Vec3{a: 4, b: 5, c: 6})
  return set_size(s)
end

def vec3_has_equal(): Int
  var s = set_new()
  s.add(Vec3{a: 7, b: 8, c: 9})
  var probe = Vec3{a: 7, b: 8, c: 9}
  return set_has(s, probe)
end

def int_dedup_size(): Int
  var s = set_new()
  s.add(1)
  s.add(2)
  s.add(2)
  s.add(3)
  return set_size(s)
end

def int_has_control(): Int
  var s = set_new()
  s.add(42)
  return set_has(s, 42)
end
