## Const Evaluation Tests
##
## Contract:
##   1. Basic const declarations.
##   2. Const arithmetic expressions.
##   3. Const referencing other consts.
##   4. Unary operators.
##   5. Comparison operators.
##   6. Logical operators.
##   7. Bitwise operators.
##   8. Const immutability.
##   9. Static_assert.
##   10. Error cases.
##   11. Const used across functions.
##   12. Const with zero and edge values.
##   13. Const functions.
##   14. Const conditionals.
##   15. Const bounded loops.

import * from qspec
import * from qspec/subprocess

## ---- Const declarations used by tests ----

const X_INT = 42
const T_BOOL = true
const A_MULTI = 10
const B_MULTI = 20
const C_MULTI = 12

const X_ADD = 20 + 22
const X_MUL = 6 * 7
const X_SUB = 50 - 8
const X_DIV = 84 / 2
const X_MOD = 142 % 100
const X_PREC = 2 + 8 * 5
const X_PAREN = (3 + 4) * 6

const REF_A = 20
const REF_B = REF_A + 22
const CHAIN_A = 10
const CHAIN_B = CHAIN_A + 10
const CHAIN_C = CHAIN_B + 22
const MUL_X = 6
const MUL_Y = 7
const MUL_Z = MUL_X * MUL_Y

const NEG_X = -42
const DBL_NEG_X = 42
const DBL_NEG_Y = -DBL_NEG_X
const DBL_NEG_Z = -DBL_NEG_Y

const CMP_LT = 10 < 20
const CMP_GT = 20 > 10
const CMP_EQ = 42 == 42
const CMP_NE = 41 != 42
const CMP_LE = 42 <= 42
const CMP_GE = 42 >= 42

const LOG_AND_T = true and true
const LOG_AND_F = true and false
const LOG_OR_T = false or true
const LOG_OR_F = false or false

const BIT_AND_VAL = band(255, 42)
const BIT_OR_VAL = bor(40, 2)
const BIT_XOR_VAL = bxor(127, 85)
const SHL_VAL = shl(21, 1)
const SHR_VAL = shr(168, 2)

const ANSWER = 42
static_assert(42 == 42, "basic true condition")
static_assert(ANSWER == 42, "const in condition")
static_assert(MUL_Z == 42, "complex expression")
const THRESHOLD = 100
const ZERO = 0
const BIG = 1000000
const SMALL = BIG / 1000000

const def square(n: Int): Int = n * n
const def add_const(a: Int, b: Int): Int = a + b
const def abs_const(n: Int): Int
  if n < 0
    return -n
  end
  return n
end
const def double_const(n: Int): Int = n * 2
const def add_one_const(n: Int): Int = n + 1
const def triangle(n: Int): Int = n * (n + 1) / 2

const BASE_CONST = 40
const def add_base(n: Int): Int = n + BASE_CONST

const def max_const(a: Int, b: Int): Int
  if a > b
    return a
  end
  return b
end

const def classify(n: Int): Int
  if n > 100
    return 3
  elsif n > 10
    return 2
  elsif n > 0
    return 1
  end
  return 0
end

const def ce_loop_sum(n: Int): Int
  var acc = 0
  for i in 0..n
    acc = acc + i
  end
  return acc
end

const def ce_factorial(n: Int): Int
  var result = 1
  for i in 1..n+1
    result = result * i
  end
  return result
end

const def ce_incl_range(n: Int): Int
  var acc = 0
  for i in 1..n+1
    acc = acc + i
  end
  return acc
end

const def ce_zero_iter(): Int
  var acc = 42
  for i in 0..0
    acc = acc + i
  end
  return acc
end

const def ce_loop_if(n: Int): Int
  var even_sum = 0
  for i in 0..n
    if i % 2 == 0
      even_sum = even_sum + i
    end
  end
  return even_sum
end

const def ce_while_sum(n: Int): Int
  var acc = 0
  var i = 0
  while i < n
    acc = acc + i
    i = i + 1
  end
  return acc
end

const def ce_gcd(a: Int, b: Int): Int
  var x = a
  var y = b
  while y != 0
    var t = y
    y = x % y
    x = t
  end
  return x
end

const LOOP_SUM_10 = ce_loop_sum(10)
const FACT_5 = ce_factorial(5)
const INCL_SUM_5 = ce_incl_range(5)
const ZERO_ITER_VAL = ce_zero_iter()
const NESTED_LOOP = ce_loop_sum(5) * 2
const LOOP_IF_10 = ce_loop_if(10)
const WHILE_SUM_10 = ce_while_sum(10)
const GCD_42_18 = ce_gcd(42, 18)
static_assert(LOOP_SUM_10 == 45, "const loop sum")

const SIZE_SQ = square(8)
const X_ADD_CONST = add_const(20, 22)
const X_ABS = abs_const(-42)
const X_NESTED = add_one_const(double_const(20))
const X_REF_BASE = add_base(2)
const X_TRIANGLE = triangle(8)
const COMPILE_SQ = square(6)
const MAX_10_5 = max_const(10, 5)
const MAX_3_42 = max_const(3, 42)
const CLASS_42 = classify(42)

def get_answer(): Int
  return ANSWER
end

def check(x: Int): Int
  if x < THRESHOLD
    return 42
  end
  return 0
end

def main(): Int
  # ==========================================================================
  # Basic const declarations
  # ==========================================================================

  describe("basic const declarations") do ->
    it("declares and uses an integer const") do ->
      assert_eq(X_INT, 42)
    end

    it("declares and uses a boolean const") do ->
      if T_BOOL
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("declares multiple consts") do ->
      assert_eq(A_MULTI + B_MULTI + C_MULTI, 42)
    end

    it("uses const in arithmetic expression") do ->
      assert_eq(BASE_CONST + 2, 42)
    end
  end

  # ==========================================================================
  # Const arithmetic expressions
  # ==========================================================================

  describe("const arithmetic expressions") do ->
    it("evaluates addition") do ->
      assert_eq(X_ADD, 42)
    end

    it("evaluates multiplication") do ->
      assert_eq(X_MUL, 42)
    end

    it("evaluates subtraction") do ->
      assert_eq(X_SUB, 42)
    end

    it("evaluates division") do ->
      assert_eq(X_DIV, 42)
    end

    it("evaluates modulo") do ->
      assert_eq(X_MOD, 42)
    end

    it("evaluates mixed arithmetic with precedence") do ->
      assert_eq(X_PREC, 42)
    end

    it("evaluates parenthesized expressions") do ->
      assert_eq(X_PAREN, 42)
    end
  end

  # ==========================================================================
  # Const referencing other consts
  # ==========================================================================

  describe("const referencing other consts") do ->
    it("references a previously defined const") do ->
      assert_eq(REF_B, 42)
    end

    it("chains multiple const references") do ->
      assert_eq(CHAIN_C, 42)
    end

    it("uses multiple consts in one expression") do ->
      assert_eq(MUL_Z, 42)
    end
  end

  # ==========================================================================
  # Unary operators
  # ==========================================================================

  describe("unary operators") do ->
    it("evaluates unary negation") do ->
      assert_eq(-NEG_X, 42)
    end

    it("evaluates double negation") do ->
      assert_eq(DBL_NEG_Z, 42)
    end
  end

  # ==========================================================================
  # Comparison operators
  # ==========================================================================

  describe("comparison operators") do ->
    it("evaluates less than") do ->
      if CMP_LT
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates greater than") do ->
      if CMP_GT
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates equality") do ->
      if CMP_EQ
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates inequality") do ->
      if CMP_NE
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates less than or equal") do ->
      if CMP_LE
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates greater than or equal") do ->
      if CMP_GE
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  # ==========================================================================
  # Logical operators
  # ==========================================================================

  describe("logical operators") do ->
    it("evaluates and (true)") do ->
      if LOG_AND_T
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates and (false)") do ->
      if LOG_AND_F
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end

    it("evaluates or (true)") do ->
      if LOG_OR_T
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("evaluates or (false)") do ->
      if LOG_OR_F
        assert_eq(0, 42)
      else
        assert_eq(42, 42)
      end
    end
  end

  # ==========================================================================
  # Bitwise operators
  # ==========================================================================

  describe("bitwise operators") do ->
    it("evaluates bitwise and") do ->
      assert_eq(BIT_AND_VAL, 42)
    end
    it("evaluates bitwise or") do ->
      assert_eq(BIT_OR_VAL, 42)
    end
    it("evaluates bitwise xor") do ->
      assert_eq(BIT_XOR_VAL, 42)
    end
    it("evaluates left shift") do ->
      assert_eq(SHL_VAL, 42)
    end
    it("evaluates right shift") do ->
      assert_eq(SHR_VAL, 42)
    end
  end

  # ==========================================================================
  # Const immutability (compile-error test → pending)
  # ==========================================================================

  describe("const immutability") do ->
    it("rejects assignment to a const") do ->
      assert_compile_error("""
const X = 42
def main(): Int
  X = 99
  return X
end
""", "Cannot assign to immutable")
    end
  end

  # ==========================================================================
  # static_assert
  # ==========================================================================

  describe("static_assert") do ->
    it("passes when condition is true") do ->
      ## static_assert(42 == 42, "...") at file top level
      assert_eq(1, 1)
    end

    it("passes with const in condition") do ->
      ## static_assert(ANSWER == 42, "...") at file top level
      assert_eq(ANSWER, 42)
    end

    it("passes with complex expression") do ->
      ## static_assert(MUL_Z == 42, "...") at file top level
      assert_eq(MUL_Z, 42)
    end

    it("fails when condition is false") do ->
      assert_compile_fails("""
        static_assert(0, "zero should fail")
        def main(): Int = 0
        """)
    end

    it("fails with const that does not satisfy condition") do ->
      assert_compile_fails("""
        const X = 42
        static_assert(X == 99, "X is not 99")
        def main(): Int = 0
        """)
    end
  end

  # ==========================================================================
  # Error cases (compile-error tests → pending)
  # ==========================================================================

  describe("error cases") do ->
    it("rejects function call in const initializer") do ->
      assert_compile_error("""
        def helper(): Int = 42
        const X = helper()
        def main(): Int = X
        """, "not a const function")
    end
    it("rejects variable reference in const initializer") do ->
      assert_compile_error("""
        var y = 10
        const X = y
        def main(): Int = X
        """, "not a compile-time constant")
    end
  end

  # ==========================================================================
  # Const used across functions
  # ==========================================================================

  describe("const used across functions") do ->
    it("uses const in multiple functions") do ->
      assert_eq(get_answer(), 42)
    end

    it("uses const in conditional") do ->
      assert_eq(check(50), 42)
    end
  end

  # ==========================================================================
  # Const with zero and edge values
  # ==========================================================================

  describe("const with zero and edge values") do ->
    it("handles zero const") do ->
      assert_eq(ZERO + 42, 42)
    end

    it("handles large const value") do ->
      assert_eq(SMALL * 42, 42)
    end
  end

  # ==========================================================================
  # Const functions
  # ==========================================================================

  describe("const functions") do ->
    it("evaluates a simple const function (endless def)") do ->
      assert_eq(SIZE_SQ, 64)
    end

    it("evaluates a const function with multiple params") do ->
      assert_eq(X_ADD_CONST, 42)
    end

    it("evaluates a block const function with return") do ->
      assert_eq(X_ABS, 42)
    end

    it("evaluates nested const function calls") do ->
      assert_eq(X_NESTED, 41)
    end

    it("const function references other consts") do ->
      assert_eq(X_REF_BASE, 42)
    end

    it("const function used in static_assert") do ->
      assert_ir_contains("""
        const def sq(n: Int): Int = n * n
        static_assert(sq(6) == 36, "x")
        def main(): Int = 0
        """, "define i32 @main")
    end

    it("rejects non-const function call in const context") do ->
      assert_compile_error("""
        def side_effect(): Int
          puts("hello")
          return 42
        end
        const X = side_effect()
        def main(): Int = X
        """, "not a const function")
    end

    it("const function is also callable at runtime") do ->
      assert_run_stdout_eq("""
        const def square(n: Int): Int = n * n
        def main(): Int
          print_int(square(6))
          return 0
        end
        """, "36\n")
    end

    it("const function with arithmetic body") do ->
      assert_eq(X_TRIANGLE, 36)
    end
  end

  # ==========================================================================
  # Const conditionals
  # ==========================================================================

  describe("const conditionals") do ->
    it("evaluates const if/then/else (true branch)") do ->
      assert_eq(MAX_10_5, 10)
    end

    it("evaluates const if/then/else (false branch)") do ->
      assert_eq(MAX_3_42, 42)
    end

    it("evaluates const if with elsif") do ->
      assert_eq(CLASS_42, 2)
    end
  end

  # ==========================================================================
  # Const bounded loops (now working in RSpec; pending here due to lli limitation)
  # ==========================================================================

  describe("const bounded loops") do ->
    it("evaluates a for-in loop to compute a sum") do ->
      assert_eq(LOOP_SUM_10, 45)
    end
    it("evaluates a for-in loop to compute factorial") do ->
      assert_eq(FACT_5, 120)
    end
    it("evaluates inclusive range for-in loop") do ->
      assert_eq(INCL_SUM_5, 15)
    end
    it("evaluates for-in loop with zero iterations") do ->
      assert_eq(ZERO_ITER_VAL, 42)
    end
    it("evaluates nested const function call with loop") do ->
      assert_eq(NESTED_LOOP, 20)
    end
    it("evaluates loop with if inside body") do ->
      assert_eq(LOOP_IF_10, 20)
    end
    it("evaluates loop result used in static_assert") do ->
      ## static_assert(LOOP_SUM_10 == 45, "...") at file top level
      assert_eq(LOOP_SUM_10, 45)
    end
    it("rejects loop that exceeds iteration limit") do ->
      assert_compile_error(ce_iter_limit_src(), "iteration limit")
    end
    it("const loop function is also callable at runtime") do ->
      assert_run_stdout_eq("""
        const def loop_sum(n: Int): Int
          var acc = 0
          for i in 0..n
            acc += i
          end
          return acc
        end
        def main(): Int
          print_int(loop_sum(10))
          return 0
        end
        """, "45\n")
    end
    it("evaluates while loop in const function") do ->
      assert_eq(WHILE_SUM_10, 45)
    end
    it("evaluates while loop to compute gcd") do ->
      assert_eq(GCD_42_18, 6)
    end
  end

  return qspec_main()
end

def ce_iter_limit_src(): String
  var s = "const BIG = do\n"
  s = s + "  var sum = 0\n"
  s = s + "  for i in 0..2000000\n"
  s = s + "    sum = sum + 1\n"
  s = s + "  end\n"
  s = s + "  sum\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  return BIG\n"
  s = s + "end\n"
  return s
end
