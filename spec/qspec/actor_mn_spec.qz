## Phase 9: Actor M:N — actors run as scheduler tasks, not OS threads.
## recv/send inside actor loops use colorblind async (try + io_suspend).
## Actors scale from thousands (pthread) to millions (scheduler tasks).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("actor M:N") do ->
    it("basic actor on scheduler") do ->
      var src = """
        actor Counter
          var count: Int = 0
          def increment(): Void
            count += 1
          end
          def get(): Int
            return count
          end
        end
        def main(): Int
          var c = Counter()
          c.increment()
          c.increment()
          c.increment()
          var val = c.get()
          c.stop()
          sched_shutdown()
          puts(val.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "3\n")
    end

    it("actor with parameters") do ->
      var src = """
        actor Counter
          var count: Int = 0
          def add(n: Int): Void
            count += n
          end
          def get(): Int
            return count
          end
        end
        def main(): Int
          var c = Counter(100)
          c.add(20)
          c.add(3)
          var val = c.get()
          c.stop()
          sched_shutdown()
          puts(val.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "123\n")
    end

    it("multiple actors on scheduler") do ->
      var src = """
        actor Pinger
          var count: Int = 0
          def ping(): Void
            count += 1
          end
          def get(): Int
            return count
          end
        end
        def main(): Int
          var a = Pinger()
          var b = Pinger()
          a.ping()
          b.ping()
          a.ping()
          var va = a.get()
          var vb = b.get()
          a.stop()
          b.stop()
          sched_shutdown()
          puts(va.to_s())
          puts(vb.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "2\n1\n")
    end

    it("actor stop is clean") do ->
      var src = """
        actor Worker
          var done: Int = 0
          def work(): Void
            done = 1
          end
          def status(): Int
            return done
          end
        end
        def main(): Int
          var w = Worker()
          w.work()
          var s = w.status()
          w.stop()
          sched_shutdown()
          puts(s.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n")
    end

    it("five actors interleaved") do ->
      var src = """
        actor Acc
          var total: Int = 0
          def add(n: Int): Void
            total += n
          end
          def get(): Int
            return total
          end
        end
        def main(): Int
          var a = Acc()
          var b = Acc()
          var c = Acc()
          var d = Acc()
          var e = Acc()
          a.add(1)
          b.add(2)
          c.add(3)
          d.add(4)
          e.add(5)
          var sum = a.get() + b.get() + c.get() + d.get() + e.get()
          a.stop()
          b.stop()
          c.stop()
          d.stop()
          e.stop()
          sched_shutdown()
          puts(sum.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "15\n")
    end

    it("actor fire-and-forget messages") do ->
      var src = """
        actor Logger
          var count: Int = 0
          def log(msg: Int): Void
            count += 1
          end
          def total(): Int
            return count
          end
        end
        def main(): Int
          var l = Logger()
          l.log(1)
          l.log(2)
          l.log(3)
          l.log(4)
          l.log(5)
          l.log(6)
          l.log(7)
          l.log(8)
          l.log(9)
          l.log(10)
          var t = l.total()
          l.stop()
          sched_shutdown()
          puts(t.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n")
    end

    it("actors no longer use OS threads") do ->
      var src = """
        actor Tick
          var v: Int = 0
          def tick(): Void
            v += 1
          end
          def val(): Int
            return v
          end
        end
        def main(): Int
          var a = Tick()
          var b = Tick()
          var c = Tick()
          var d = Tick()
          var e = Tick()
          var f = Tick()
          var g = Tick()
          var h = Tick()
          var j = Tick()
          var k = Tick()
          a.tick()
          b.tick()
          c.tick()
          d.tick()
          e.tick()
          f.tick()
          g.tick()
          h.tick()
          j.tick()
          k.tick()
          var sum = a.val() + b.val() + c.val() + d.val() + e.val() + f.val() + g.val() + h.val() + j.val() + k.val()
          a.stop()
          b.stop()
          c.stop()
          d.stop()
          e.stop()
          f.stop()
          g.stop()
          h.stop()
          j.stop()
          k.stop()
          sched_shutdown()
          puts(sum.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n")
    end
  end
  return qspec_main()
end
