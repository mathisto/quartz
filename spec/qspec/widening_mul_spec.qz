## Wide-multiply / carry-chain intrinsics
##
## NET.1 Phase 1, Step 1.4. Six split intrinsics for u64 bignum arithmetic:
##   widening_mul_{lo,hi}      — u64 × u64 → 128-bit product, halves
##   carrying_add_{sum,carry}  — three-operand u64 add with carry-out
##   borrowing_sub_{diff,borrow} — three-operand u64 sub with borrow-out
##
## Semantics: unsigned wraparound u64. Quartz's existential Int erases to
## i64 at runtime; "negative" literals are just high-bit-set u64 values.
import * from qspec

def main(): Int
  describe("widening_mul_lo / widening_mul_hi") do ->
    it("0 * 0 = (0, 0)") do ->
      assert_eq(widening_mul_lo(0, 0), 0)
      assert_eq(widening_mul_hi(0, 0), 0)
    end
    it("1 * 1 = (1, 0)") do ->
      assert_eq(widening_mul_lo(1, 1), 1)
      assert_eq(widening_mul_hi(1, 1), 0)
    end
    it("small * small fits in low half") do ->
      # 12345 * 67890 = 838_102_050 — fits in 32 bits, no overflow.
      assert_eq(widening_mul_lo(12345, 67890), 838102050)
      assert_eq(widening_mul_hi(12345, 67890), 0)
    end
    it("2^32 * 2^32 = 2^64 — straddles the boundary exactly") do ->
      # (1 << 32) * (1 << 32) = 1 << 64 → low=0, high=1.
      var x = shl(1, 32)
      assert_eq(widening_mul_lo(x, x), 0)
      assert_eq(widening_mul_hi(x, x), 1)
    end
    it("max(u64) * 1 — high half is zero") do ->
      # -1 as i64 = 0xFFFFFFFFFFFFFFFF when interpreted as u64.
      assert_eq(widening_mul_lo(-1, 1), -1)
      assert_eq(widening_mul_hi(-1, 1), 0)
    end
    it("max(u64) * 2 — high half is 1, low half is -2 (=2^64-2)") do ->
      assert_eq(widening_mul_lo(-1, 2), -2)
      assert_eq(widening_mul_hi(-1, 2), 1)
    end
    it("max(u64) * max(u64) = (1, -2) per (2^64-1)^2 = 2^128 - 2^65 + 1") do ->
      # (2^64 - 1)^2 = 2^128 - 2*2^64 + 1
      # → high = 2^64 - 2 = 0xFFFFFFFFFFFFFFFE = -2
      # → low  = 1
      assert_eq(widening_mul_lo(-1, -1), 1)
      assert_eq(widening_mul_hi(-1, -1), -2)
    end
    it("commutativity") do ->
      assert_eq(widening_mul_lo(7, 13), widening_mul_lo(13, 7))
      assert_eq(widening_mul_hi(7, 13), widening_mul_hi(13, 7))
    end
  end

  describe("carrying_add_sum / carrying_add_carry") do ->
    it("0 + 0 + 0 = (0, 0)") do ->
      assert_eq(carrying_add_sum(0, 0, 0), 0)
      assert_eq(carrying_add_carry(0, 0, 0), 0)
    end
    it("1 + 2 + 3 = (6, 0) — no overflow") do ->
      assert_eq(carrying_add_sum(1, 2, 3), 6)
      assert_eq(carrying_add_carry(1, 2, 3), 0)
    end
    it("max + 1 + 0 wraps to (0, 1)") do ->
      assert_eq(carrying_add_sum(-1, 1, 0), 0)
      assert_eq(carrying_add_carry(-1, 1, 0), 1)
    end
    it("max + 0 + 1 wraps to (0, 1) — carry-in path") do ->
      assert_eq(carrying_add_sum(-1, 0, 1), 0)
      assert_eq(carrying_add_carry(-1, 0, 1), 1)
    end
    it("max + max + 1 = (max, 1) — both adds overflow") do ->
      # 2^64-1 + 2^64-1 + 1 = 2^65 - 1 → low = 2^64 - 1 = -1, high = 1
      assert_eq(carrying_add_sum(-1, -1, 1), -1)
      assert_eq(carrying_add_carry(-1, -1, 1), 1)
    end
    it("max + 0 + 0 = (max, 0) — no overflow even at the edge") do ->
      assert_eq(carrying_add_sum(-1, 0, 0), -1)
      assert_eq(carrying_add_carry(-1, 0, 0), 0)
    end
  end

  describe("borrowing_sub_diff / borrowing_sub_borrow") do ->
    it("0 - 0 - 0 = (0, 0)") do ->
      assert_eq(borrowing_sub_diff(0, 0, 0), 0)
      assert_eq(borrowing_sub_borrow(0, 0, 0), 0)
    end
    it("5 - 3 - 0 = (2, 0) — straightforward") do ->
      assert_eq(borrowing_sub_diff(5, 3, 0), 2)
      assert_eq(borrowing_sub_borrow(5, 3, 0), 0)
    end
    it("0 - 1 - 0 borrows: low = max, borrow = 1") do ->
      assert_eq(borrowing_sub_diff(0, 1, 0), -1)
      assert_eq(borrowing_sub_borrow(0, 1, 0), 1)
    end
    it("0 - 0 - 1 borrows: low = max, borrow = 1") do ->
      assert_eq(borrowing_sub_diff(0, 0, 1), -1)
      assert_eq(borrowing_sub_borrow(0, 0, 1), 1)
    end
    it("1 - max - 0 borrows: low = 2, borrow = 1 (1 - (2^64-1) = -(2^64-2))") do ->
      # In u64 wraparound: 1 - (2^64 - 1) = 2 (mod 2^64), borrow = 1.
      assert_eq(borrowing_sub_diff(1, -1, 0), 2)
      assert_eq(borrowing_sub_borrow(1, -1, 0), 1)
    end
    it("0 - max - 1 = (0, 1) — both subs underflow, borrow stays 1") do ->
      # 0 - (2^64 - 1) = 1 (mod 2^64), borrow=1; then 1 - 1 = 0, borrow=0;
      # final borrow OR-s the two = 1.
      assert_eq(borrowing_sub_diff(0, -1, 1), 0)
      assert_eq(borrowing_sub_borrow(0, -1, 1), 1)
    end
  end

  describe("multi-limb chain sanity") do ->
    it("two-limb add: (a=[1, 2^64-1]) + (b=[1, 0]) = (sum=[2, 0], final_carry=1)") do ->
      # Bignum addition: low limb a0=1, high limb a1=-1 (=2^64-1)
      #                  low limb b0=1, high limb b1=0
      # Low limb:  carrying_add(1, 1, 0) = sum=2, carry=0
      # High limb: carrying_add(-1, 0, 0) = sum=-1, carry=0
      var s0 = carrying_add_sum(1, 1, 0)
      var c0 = carrying_add_carry(1, 1, 0)
      var s1 = carrying_add_sum(-1, 0, c0)
      var c1 = carrying_add_carry(-1, 0, c0)
      assert_eq(s0, 2)
      assert_eq(s1, -1)
      assert_eq(c1, 0)
    end
    it("two-limb add carry-out at the top: (a=[0, max]) + (b=[1, 1]) = (sum=[1, 0], carry=1)") do ->
      # Low limb: 0 + 1 + 0 = 1, carry=0
      # High limb: max + 1 + 0 = 0, carry=1
      var s0 = carrying_add_sum(0, 1, 0)
      var c0 = carrying_add_carry(0, 1, 0)
      var s1 = carrying_add_sum(-1, 1, c0)
      var c1 = carrying_add_carry(-1, 1, c0)
      assert_eq(s0, 1)
      assert_eq(s1, 0)
      assert_eq(c1, 1)
    end
    it("multiply-then-add primitive (Schoolbook bignum step)") do ->
      # acc = a*b + c — the Curve25519/Poly1305 inner loop step.
      # a=2^32, b=2^32, c=42 → product=2^64 → low=0, high=1
      # low + c = 42, carry=0
      # high + 0 + carry = 1
      var x = shl(1, 32)
      var lo = widening_mul_lo(x, x)
      var hi = widening_mul_hi(x, x)
      var sum0 = carrying_add_sum(lo, 42, 0)
      var car0 = carrying_add_carry(lo, 42, 0)
      var sum1 = carrying_add_sum(hi, 0, car0)
      assert_eq(sum0, 42)
      assert_eq(sum1, 1)
    end
  end

  return qspec_main()
end
