## Wrap-block break/continue regression spec.
##
## Followup to the Diag wrap-block teardown leak fix (commit ec90e98f,
## docs/bugs/done/DIAG_WRAP_BLOCK_LEAK_248_ENTRIES_AT_PEAK.md). The original
## fix added MIR_EFFECT_POP_N drains for early `return` from inside a
## `with E {...} do -> body end` block; this followup covers `break` and
## `continue` from inside such blocks.
##
## Symptom (pre-fix): break/continue out of an inner `with` skips the
## inner's runtime `__qz_effect_handle_uninstall`. The inner handler stays
## installed on the runtime effect-stack — subsequent `perform` calls in
## the enclosing wrap fire the leaked inner handler instead of the outer.
##
## Black-box assertion: install distinct outer + inner handlers around a
## loop with break/continue out of the inner wrap; perform an op AFTER the
## loop (still inside the outer wrap). Expect the outer handler to fire.
## Pre-fix: the inner handler fires (leak shadows the outer).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("wrap-block break/continue teardown") do ->
    it("for + break inside `with E {} do -> end` — outer wrap survives") do ->
      assert_run_stdout_eq("""
import std/diag

def cap_outer(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("OUTER:" + msg)
  return 0
end

def cap_inner(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("INNER:" + msg)
  return 0
end

def main(): Int
  with Diag { error: cap_outer, warn: cap_outer } do ->
    for i in 0..1
      with Diag { error: cap_inner, warn: cap_inner } do ->
        if i == 0
          break
        end
      end
    end
    error("after-loop", 0, 0)
  end
  return 0
end
""", "OUTER:after-loop\n")
    end

    it("while + continue inside `with E {} do -> end` — outer wrap survives") do ->
      assert_run_stdout_eq("""
import std/diag

def cap_outer(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("OUTER:" + msg)
  return 0
end

def cap_inner(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("INNER:" + msg)
  return 0
end

def main(): Int
  with Diag { error: cap_outer, warn: cap_outer } do ->
    var i = 0
    while i < 2
      with Diag { error: cap_inner, warn: cap_inner } do ->
        if i == 0
          i = 1
          continue
        end
        i = 2
        error("from-inner", 0, 0)
      end
    end
    error("after-loop", 0, 0)
  end
  return 0
end
""", "INNER:from-inner\nOUTER:after-loop\n")
    end

    it("labelled break across nested loops — drains inner wrap, outer survives") do ->
      assert_run_stdout_eq("""
import std/diag

def cap_outer(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("OUTER:" + msg)
  return 0
end

def cap_inner(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("INNER:" + msg)
  return 0
end

def main(): Int
  with Diag { error: cap_outer, warn: cap_outer } do ->
      :outer for i in 0..3
      with Diag { error: cap_inner, warn: cap_inner } do ->
        for j in 0..3
          if i == 1
            break :outer
          end
        end
      end
    end
    error("after-loop", 0, 0)
  end
  return 0
end
""", "OUTER:after-loop\n")
    end

    it("plain break with no enclosing wrap is a no-op (regression guard)") do ->
      assert_run_stdout_eq("""
import std/diag

def cap_outer(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts("OUTER:" + msg)
  return 0
end

def main(): Int
  with Diag { error: cap_outer, warn: cap_outer } do ->
    for i in 0..3
      if i == 1
        break
      end
    end
    error("after-loop", 0, 0)
  end
  return 0
end
""", "OUTER:after-loop\n")
    end
  end
  return qspec_main()
end
