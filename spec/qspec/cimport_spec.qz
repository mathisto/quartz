## Cimport Tests
##
## Contract:
##   1. Cimport declaration compiles.
##   2. Cimport does not conflict.
##   3. Cimport generates ir include.
##   4. Cimport math.h compiles.
##   5. Cimport stdlib.h compiles.
##   6. Cimport string.h compiles.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("C Import") do ->
    it("cimport declaration compiles") do ->
      assert_compile_succeeds("""
        cimport "stdio.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("unknown cimport produces error") do ->
      assert_compile_error("""
        cimport "nonexistent.h"
        def main(): Int
          return 0
        end
      """, "QZ0552")
    end

    it("cimport stdlib.h compiles") do ->
      assert_compile_succeeds("""
        cimport "stdlib.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("cimport string.h compiles") do ->
      assert_compile_succeeds("""
        cimport "string.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("cimport math.h compiles") do ->
      assert_compile_succeeds("""
        cimport "math.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("multiple cimport declarations compile") do ->
      assert_compile_succeeds("""
        cimport "stdio.h"
        cimport "stdlib.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("cimport with extern def compiles") do ->
      assert_compile_succeeds("""
        cimport "stdlib.h"
        extern "C" def abs(x: Int): Int
        def main(): Int
          return abs(-5)
        end
      """)
    end

    it("cimport generates IR include comment") do ->
      assert_ir_contains("""
        cimport "stdio.h"
        def main(): Int
          return 0
        end
      """, "@qz_main")
    end

    it("cimport with empty string is an error") do ->
      assert_compile_error("""
        cimport ""
        def main(): Int
          return 0
        end
      """, "error")
    end

    it("cimport with path traversal is an error") do ->
      assert_compile_error("""
        cimport "../../../etc/passwd"
        def main(): Int
          return 0
        end
      """, "QZ0552")
    end

    it("cimport with absolute path is an error") do ->
      assert_compile_error("""
        cimport "/usr/include/stdio.h"
        def main(): Int
          return 0
        end
      """, "QZ0552")
    end

    it("cimport does not conflict with import") do ->
      assert_compile_succeeds("""
        cimport "stdio.h"
        def main(): Int
          return 0
        end
      """)
    end

    it("duplicate cimport compiles") do ->
      assert_compile_succeeds("""
        cimport "stdio.h"
        cimport "stdio.h"
        def main(): Int
          return 0
        end
      """)
    end

  end

  return qspec_main()
end

