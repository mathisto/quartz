## Ufcs Constants Tests
##
## Contract:
##   1. UFCS on uppercase constants.
##   2. UFCS on uppercase local bindings.
##   3. Associated functions still work.
import * from qspec

GREETING = "hello"

def main(): Int
  describe("UFCS on uppercase constants") do ->
    it("String constant .concat()") do ->
      var result = GREETING + " world"
      assert_eq_str(result, "hello world")
    end

    it("String constant .find()") do ->
      var idx = 0
      match GREETING.find("llo")
        Some(v) => idx = v
        _ => assert_eq(0, 1)
      end
      assert_eq(idx, 2)
    end

    it("String constant .size") do ->
      var len = GREETING.size
      assert_eq(len, 5)
    end

    it("String constant .slice()") do ->
      var sub = GREETING.slice(1, 4)
      assert_eq_str(sub, "ell")
    end

    it("String constant .starts_with()") do ->
      var result = GREETING.starts_with("hel")
      assert_eq(result, 1)
    end

    it("String constant .eq()") do ->
      var result = GREETING.eq("hello")
      assert_eq(result, 1)
    end
  end

  describe("UFCS on uppercase local bindings") do ->
    it("uppercase local .concat()") do ->
      MSG = "hi"
      var result = MSG + " there"
      assert_eq_str(result, "hi there")
    end

    it("PascalCase local .find()") do ->
      Greeting = "world"
      var idx = 0
      match Greeting.find("rld")
        Some(v) => idx = v
        _ => assert_eq(0, 1)
      end
      assert_eq(idx, 2)
    end
  end

  describe("associated functions still work") do ->
    it("Type.method() syntax") do ->
      var p = assert_output_helper_origin()
      assert_eq(p, 0)
    end
  end

  return qspec_main()
end

struct TestPoint
  x: Int
  y: Int
end

def TestPoint.origin(): TestPoint = TestPoint { x: 0, y: 0 }

def assert_output_helper_origin(): Int
  var p = TestPoint.origin()
  return p.x
end
