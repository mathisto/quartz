## UFCS Complete Spec - Verify all type alias UFCS rewrites work
##
## Tests the tc_get_type_alias prefix fallback added in Phase 2:
## Map, Range, Arena, Pool, ArenaPool UFCS method-style calls.
##
## Contract:
##   1. Map UFCS.
##   2. Range UFCS.
##   3. Vec UFCS.
##   4. String UFCS.
##   5. Map UFCS.

import * from qspec

def main(): Int
  # =========================================================================
  # Map UFCS
  # =========================================================================

  describe("Map UFCS") do ->
    it("creates and uses map via UFCS") do ->
      var m = map_new()
      m.set(42, 100)
      assert_eq(m.get(42).unwrap(), 100)
      assert_eq(m.has(42), 1)
      assert_eq(m.has(99), 0)
    end

    it("deletes via UFCS") do ->
      var m = map_new()
      m.set(1, 10)
      m.set(2, 20)
      m.delete(1)
      assert_eq(m.has(1), 0)
      assert_eq(m.get(2).unwrap(), 20)
    end


  end

  # =========================================================================
  # Range UFCS
  # =========================================================================

  describe("Range UFCS") do ->
    it("iterates range with for-in") do ->
      var sum = 0
      for i in 0..5
        sum += i
      end
      assert_eq(sum, 10)
    end

    it("range with variables") do ->
      var start = 1
      var finish = 4
      var sum = 0
      for i in start..finish
        sum += i
      end
      assert_eq(sum, 6)
    end
  end

  # =========================================================================
  # Vec UFCS (already tested elsewhere, but verify UFCS specifically)
  # =========================================================================

  describe("Vec UFCS") do ->
    it("push and size via UFCS") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v.size, 3)
    end

    it("bracket indexing") do ->
      var v = vec_new()
      v.push(42)
      v.push(99)
      assert_eq(v[0], 42)
      assert_eq(v[1], 99)
    end

    it("bracket assignment") do ->
      var v = vec_new()
      v.push(0)
      v[0] = 42
      assert_eq(v[0], 42)
    end
  end

  # =========================================================================
  # String UFCS
  # =========================================================================

  describe("String UFCS") do ->
    it("size via UFCS") do ->
      var s = "hello"
      assert_eq(s.size(), 5)
    end

    it("downcase via UFCS") do ->
      assert_eq_str("HELLO".downcase(), "hello")
    end

    it("upcase via UFCS") do ->
      assert_eq_str("hello".upcase(), "HELLO")
    end

    it("trim via UFCS") do ->
      assert_eq_str("  hello  ".trim(), "hello")
    end

    it("replace via UFCS") do ->
      assert_eq_str("hello world".replace("world", "quartz"), "hello quartz")
    end

    it("is_empty via UFCS") do ->
      assert_eq("hello".is_empty(), 0)
      assert_eq("".is_empty(), 1)
    end

    it("substr via UFCS") do ->
      assert_eq_str("hello world".substr(6, 5), "world")
    end

    it("trim_left via UFCS") do ->
      assert_eq_str("  hello".trim_left(), "hello")
    end

    it("trim_right via UFCS") do ->
      assert_eq_str("hello  ".trim_right(), "hello")
    end

    it("pad_left via UFCS") do ->
      assert_eq_str("42".pad_left(5, "0"), "00042")
    end

    it("pad_right via UFCS") do ->
      assert_eq_str("hi".pad_right(5, "."), "hi...")
    end

    it("chars via UFCS") do ->
      var cs = "abc".chars()
      assert_eq(cs.size, 3)
      # chars() yields Vec<Int> of codepoints (runtime qz_str_chars_utf8).
      assert_eq(cs[0], 97)
      assert_eq(cs[1], 98)
      assert_eq(cs[2], 99)
    end
  end

  # =========================================================================
  # Map UFCS
  # =========================================================================

  describe("Map UFCS") do ->
    it("set and get via UFCS") do ->
      var m = map_new()
      m.set("key", 42)
      match m.get("key")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("has via UFCS") do ->
      var m = map_new()
      m.set("x", 1)
      assert_eq(m.has("x"), 1)
      assert_eq(m.has("y"), 0)
    end
  end

  return qspec_main()
end
