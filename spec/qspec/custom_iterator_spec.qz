## Custom Iterator Protocol Tests
## Tests both the original $next protocol and the formal Iterator<T> trait.
##
## Contract:
##   1. Basic iteration.
##   2. Control flow.
##   3. Break safety.
##   4. Advanced usage.

import * from qspec
import traits

struct CICounter
  current: Int
  stop: Int
end

extend CICounter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.current < self.stop
      var val = self.current
      self.current = self.current + 1
      return Option::Some(val)
    end
    return Option::None
  end
end

## 14A regression — for-in over a @VALUE custom iterator. A @value struct whose
## `next` mutates `self.field` to advance is value-layout (and, at <=16B / 1-3
## fields, register-decomposable). If `next`'s receiver were decomposed into scalar
## args it would rebuild a LOCAL copy and mutate that — the advance is lost → the
## `for x in c` loop never terminates (infinite loop). The fix excludes the `*$next`
## receiver from value-param decomposition so it is passed by construct-buffer
## pointer and mutates the live `__citer` slot in place — same as a plain
## (reference-layout) iterator. These cases would HANG before the fix.
@value
struct CIValCounter
  current: Int
  stop: Int
end

extend CIValCounter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.current < self.stop
      var val = self.current
      self.current = self.current + 1
      return Option::Some(val)
    end
    return Option::None
  end
end

def val_iter_sum(): Int
  var c = CIValCounter { current: 0, stop: 5 }
  var sum = 0
  for x in c
    sum += x
  end
  return sum
end

def val_iter_break(): Int
  var c = CIValCounter { current: 0, stop: 100 }
  var sum = 0
  for x in c
    sum += x
    if x == 4
      break
    end
  end
  return sum
end

## Helper functions for assert_output

def ci_print_0_1_2(): Void
  var c = CICounter { current: 0, stop: 3 }
  for x in c
    print_int(x)
  end
end

def main(): Int
  describe("basic iteration") do ->
    it("iterates over a custom struct with $next method") do ->
      var c = CICounter { current: 0, stop: 5 }
      var sum = 0
      for x in c
        sum += x
      end
      ## 0 + 1 + 2 + 3 + 4 = 10
      assert_eq(sum, 10)
    end

    it("handles empty iterator (body never executes)") do ->
      var c = CICounter { current: 5, stop: 5 }
      var sum = 0
      for x in c
        sum += x
      end
      assert_eq(sum, 0)
    end

    it("handles single element") do ->
      var c = CICounter { current: 0, stop: 1 }
      var sum = 0
      for x in c
        sum += x
      end
      assert_eq(sum, 0)
    end
  end

  describe("control flow") do ->
    it("continue skips to next iteration") do ->
      var c = CICounter { current: 0, stop: 6 }
      var sum = 0
      for x in c
        if x == 3
          continue
        end
        sum += x
      end
      ## 0 + 1 + 2 + 4 + 5 = 12
      assert_eq(sum, 12)
    end
  end

  describe("break safety") do ->
    it("break from first iteration") do ->
      var c = CICounter { current: 0, stop: 5 }
      var result = 0
      for x in c
        break
      end
      result = 42
      assert_eq(result, 42)
    end

    it("break from middle iteration") do ->
      var c = CICounter { current: 0, stop: 10 }
      var sum = 0
      for x in c
        sum += x
        if x == 4
          break
        end
      end
      ## 0 + 1 + 2 + 3 + 4 = 10
      assert_eq(sum, 10)
    end

    it("break with nested custom iterators does not corrupt outer") do ->
      var outer = CICounter { current: 0, stop: 3 }
      var sum = 0
      for i in outer
        var inner = CICounter { current: 0, stop: 5 }
        for j in inner
          if j == 2
            break
          end
          sum += 1
        end
      end
      ## Each outer iteration: j=0,1 then break (2 per outer), 3 outer = 6
      assert_eq(sum, 6)
    end

    it("continue then break in same loop") do ->
      var c = CICounter { current: 0, stop: 10 }
      var sum = 0
      for x in c
        if x == 3
          continue
        end
        if x == 6
          break
        end
        sum += x
      end
      ## 0 + 1 + 2 + (skip 3) + 4 + 5 = 12
      assert_eq(sum, 12)
    end
  end

  describe("advanced usage") do ->
    it("nested custom iterators") do ->
      var outer = CICounter { current: 0, stop: 3 }
      var sum = 0
      for i in outer
        var inner = CICounter { current: 0, stop: 3 }
        for j in inner
          sum += 1
        end
      end
      ## 3 * 3 = 9
      assert_eq(sum, 9)
    end

    it("custom iterator with print") do ->
      assert_output("0\n1\n2\n", ci_print_0_1_2)
    end

    it("for-in over @value custom iterator advances (no hang)") do ->
      ## 0+1+2+3+4 = 10 — @value receiver mutated in place, not in a lost copy.
      assert_eq(val_iter_sum(), 10)
    end

    it("break is safe with @value custom iterator") do ->
      ## 0+1+2+3+4 = 10 before break at x==4 (stop=100 would hang if unfixed).
      assert_eq(val_iter_break(), 10)
    end

    it("labeled break from nested custom iterator") do ->
      var outer = CICounter { current: 0, stop: 10 }
      var sum = 0
      :outer for i in outer
        var inner = CICounter { current: 0, stop: 10 }
        for j in inner
          if i + j >= 5
            break :outer
          end
          sum += 1
        end
      end
      ## i=0: j=0,1,2,3,4 (5 iterations) then j=5 breaks outer
      assert_eq(sum, 5)
    end
  end

  return qspec_main()
end
