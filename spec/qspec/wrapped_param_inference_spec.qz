## Regression spec for wrapped-param type inference
## (INFER_TYPE_PARAM_MAPPING_WRAPPED_PARAMS).
##
## Sister to concrete_generic_inferred_spec.qz which closed the bare-param
## case (`def f<T>(x: T)`). Pre-fix, wrapped-param annotations like
## `Vec<T>`, `HashMap<K, V>`, and nested `Vec<Box<T>>` skipped the type-arg
## inference entirely — the call's return TypeId stayed at TYPE_ERROR for
## the inner generic, and any consumer annotating `Generic<Concrete>` hit
## `QZ0200: expected unknown, got unknown`.
##
## tc_infer_type_param_mapping (typecheck_generics.qz:338) now recursively
## unifies pa_name against arg_ann via tc_unify_param_ann.

import * from qspec

# Vec<T> bare — generic over element type.
def first_or_default<T>(v: Vec<T>, fallback: T): T
  return fallback if v.size == 0
  return v[0]
end

def vec_param_inferred_string(): String
  var v = vec_new<String>()
  vec_push(v, "hi")
  return first_or_default(v, "x")
end

def vec_param_inferred_int(): Int
  var v = vec_new<Int>()
  vec_push(v, 42)
  return first_or_default(v, 0)
end

# HashMap<K, V> — two type params, comma at depth 1 inside the wrapped
# param annotation. Exercises the depth-aware param-annotation splitter.
# Helper returns its fallback so we don't depend on generic-body indexing
# dispatch (a separate, pre-existing UFCS limitation: a generic body sees
# its receiver erased to Int, so `m[k]` falls back to Vec semantics).
# Inference of K and V is what we're testing here.
def map_size_or<K, V>(m: HashMap<K, V>, fallback: V): Int
  return map_size(m)
end

def hashmap_two_params_inferred(): Int
  var m = map_new<String, Int>()
  map_set(m, "a", 100)
  map_set(m, "b", 200)
  return map_size_or(m, 0)
end

# Nested generics: outer Vec wraps inner HashMap. Exercises recursive
# unification two levels deep — pa_name = "Vec<HashMap<K, V>>",
# arg_ann = "Vec<HashMap<String, Int>>".
def vec_of_maps_size<K, V>(v: Vec<HashMap<K, V>>, fallback: V): Int
  return v.size
end

def nested_wrap_inferred(): Int
  var m = map_new<String, Int>()
  map_set(m, "a", 99)
  var v = vec_new()
  vec_push(v, m)
  return vec_of_maps_size(v, 0)
end

# Mixed: one wrapped param + one bare param in the same function. Both
# type params should resolve correctly even though they appear in different
# annotation shapes.
def vec_and_seed<T>(xs: Vec<T>, seed: T): Vec<T>
  vec_push(xs, seed)
  return xs
end

def mixed_wrapped_and_bare_inferred(): Int
  var xs = vec_new<Int>()
  vec_push(xs, 1)
  vec_push(xs, 2)
  var ys = vec_and_seed(xs, 3)
  return ys.size
end

def main(): Int
  describe("wrapped-param type inference") do ->

    it("infers T from a Vec<T> param against a Vec<String> arg") do ->
      assert_eq_str(vec_param_inferred_string(), "hi")
    end

    it("infers T from a Vec<T> param against a Vec<Int> arg") do ->
      assert_eq(vec_param_inferred_int(), 42)
    end

    it("infers K and V from a HashMap<K, V> param (depth-aware split)") do ->
      assert_eq(hashmap_two_params_inferred(), 2)
    end

    it("infers nested generics recursively (Vec<HashMap<K, V>>)") do ->
      assert_eq(nested_wrap_inferred(), 1)
    end

    it("infers T from mixed wrapped+bare params in the same function") do ->
      assert_eq(mixed_wrapped_and_bare_inferred(), 3)
    end

  end
  return qspec_main()
end
