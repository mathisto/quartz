## Generic bounded loop guard tests (F.2 Gap #1)

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("bounded generic monomorphization") do ->
    it("single bounded generic with trait impl compiles") do ->
      assert_run_exits(gbl_single_src(), 1)
    end
    it("cascading bounded generics compile") do ->
      assert_run_exits(gbl_cascade_src(), 10)
    end
    it("bounded generic on generic struct impl compiles") do ->
      assert_run_exits(gbl_generic_struct_src(), 7)
    end
    it("mutual bounded generic calls compile") do ->
      assert_run_exits(gbl_mutual_src(), 20)
    end
    it("bounded generic with multiple impls compiles") do ->
      assert_run_exits(gbl_multi_impl_src(), 30)
    end
  end
  return qspec_main()
end

def gbl_single_src(): String = """
  trait Eq
    def eq(a: Int, b: Int): Int
      return 0
    end
  end
  struct MyInt
    val: Int
  end
  extend MyInt with Eq
    def eq(a: Int, b: Int): Int
      if a == b
        return 1
      end
      return 0
    end
  end
  def are_equal<T: Eq>(hint: T, a: Int, b: Int): Int
    return eq(a, b)
  end
  def main(): Int
    m = MyInt { val: 0 }
    return are_equal(m, 42, 42)
  end
  """

def gbl_cascade_src(): String = """
  trait Addable
    def add_val(x: Int): Int
      return 0
    end
  end
  struct Num
    n: Int
  end
  extend Num with Addable
    def add_val(x: Int): Int
      return x + 5
    end
  end
  def step1<T: Addable>(hint: T, x: Int): Int
    return add_val(x)
  end
  def step2<T: Addable>(hint: T, x: Int): Int
    return step1(hint, x)
  end
  def main(): Int
    n = Num { n: 0 }
    return step2(n, 5)
  end
  """

def gbl_generic_struct_src(): String = """
  trait Measurable
    def measure(x: Int): Int
      return 0
    end
  end
  struct Box
    size: Int
  end
  extend Box with Measurable
    def measure(x: Int): Int
      return x + 7
    end
  end
  def get_measure<T: Measurable>(hint: T, x: Int): Int
    return measure(x)
  end
  def main(): Int
    b = Box { size: 3 }
    return get_measure(b, 0)
  end
  """

def gbl_mutual_src(): String = """
  trait Computable
    def compute(x: Int): Int
      return 0
    end
  end
  struct Val
    n: Int
  end
  extend Val with Computable
    def compute(x: Int): Int
      return x + 5
    end
  end
  def do_a<T: Computable>(hint: T, x: Int): Int
    return compute(x)
  end
  def do_b<T: Computable>(hint: T, x: Int): Int
    return do_a(hint, x) + compute(x)
  end
  def main(): Int
    v = Val { n: 0 }
    return do_b(v, 5)
  end
  """

def gbl_multi_impl_src(): String = """
  trait Scorable
    def score(x: Int): Int
      return 0
    end
  end
  struct Player
    pts: Int
  end
  struct Enemy
    pts: Int
  end
  extend Player with Scorable
    def score(x: Int): Int
      return 10
    end
  end
  extend Enemy with Scorable
    def score(x: Int): Int
      return 20
    end
  end
  def get_score<T: Scorable>(hint: T, x: Int): Int
    return score(x)
  end
  def main(): Int
    p = Player { pts: 0 }
    e = Enemy { pts: 0 }
    return get_score(p, 0) + get_score(e, 0)
  end
  """
