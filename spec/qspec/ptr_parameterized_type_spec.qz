## Ptr Parameterized Type Tests
##
## Contract:
##   1. Multiple params: multiple `Ptr<Int>` parameters.
##   2. Param type: `Ptr<Int>` as parameter type.
##   3. Return type: `Ptr<Int>` as return type.
##   4. Struct field: `Ptr<Int>` as struct field.
##   5. Fn return: `Ptr<Int>` from function returning `Ptr<Int>`.
##   6. Backward compat: unparameterized `Ptr` still works.
##   7. Arithmetic: `Ptr<Int>` with ptr arithmetic.
##   8. Chain: `Ptr<Int>` passed through two functions.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Ptr<T> parameterized type") do ->
    it("Ptr<Int> as parameter type") do ->
      assert_run_exits(ptr_param_src(), 42)
    end
    it("multiple Ptr<Int> parameters") do ->
      assert_run_exits(ptr_multi_param_src(), 42)
    end
    it("Ptr<Int> as return type") do ->
      assert_run_exits(ptr_return_src(), 42)
    end
    it("Ptr<Int> as struct field type") do ->
      assert_run_exits(ptr_struct_field_src(), 12)
    end
    it("unparameterized Ptr backward compat") do ->
      assert_run_exits(ptr_unparameterized_src(), 42)
    end
    it("Ptr<Int> from function returning Ptr<Int>") do ->
      assert_run_exits(ptr_fn_return_src(), 42)
    end
    it("Ptr<Int> with write and read arithmetic") do ->
      assert_run_exits(ptr_arith_src(), 42)
    end
    it("Ptr<Int> passed through two functions") do ->
      assert_run_exits(ptr_chain_src(), 42)
    end
  end
  return qspec_main()
end

def ptr_param_src(): String
  var s = "def set_val(p: Ptr<Int>, val: Int): Void\n"
  s = s + "  ptr_write(p, val)\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  set_val(p, 42)\n"
  s = s + "  return ptr_read(p)\n"
  s = s + "end\n"
  return s
end

def ptr_multi_param_src(): String
  var s = "def swap(a: Ptr<Int>, b: Ptr<Int>): Void\n"
  s = s + "  var tmp = ptr_read(a)\n"
  s = s + "  ptr_write(a, ptr_read(b))\n"
  s = s + "  ptr_write(b, tmp)\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var a = ptr_alloc(1)\n"
  s = s + "  var b = ptr_alloc(1)\n"
  s = s + "  ptr_write(a, 10)\n"
  s = s + "  ptr_write(b, 42)\n"
  s = s + "  swap(a, b)\n"
  s = s + "  return ptr_read(a)\n"
  s = s + "end\n"
  return s
end

def ptr_return_src(): String
  var s = "def make_ptr(val: Int): Ptr<Int>\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  ptr_write(p, val)\n"
  s = s + "  return p\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var p = make_ptr(42)\n"
  s = s + "  return ptr_read(p)\n"
  s = s + "end\n"
  return s
end

def ptr_struct_field_src(): String
  var s = "struct Buffer\n"
  s = s + "  data: Ptr<Int>\n"
  s = s + "  len: Int\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var buf = Buffer { data: ptr_alloc(2), len: 2 }\n"
  s = s + "  ptr_write(buf.data, 10)\n"
  s = s + "  return ptr_read(buf.data) + buf.len\n"
  s = s + "end\n"
  return s
end

def ptr_unparameterized_src(): String
  var s = "def main(): Int\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  ptr_write(p, 42)\n"
  s = s + "  return ptr_read(p)\n"
  s = s + "end\n"
  return s
end

def ptr_fn_return_src(): String
  var s = "def alloc_and_set(val: Int): Ptr<Int>\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  ptr_write(p, val)\n"
  s = s + "  return p\n"
  s = s + "end\n"
  s = s + "def read_from(p: Ptr<Int>): Int\n"
  s = s + "  return ptr_read(p)\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var p = alloc_and_set(42)\n"
  s = s + "  return read_from(p)\n"
  s = s + "end\n"
  return s
end

def ptr_arith_src(): String
  var s = "def main(): Int\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  ptr_write(p, 40)\n"
  s = s + "  return ptr_read(p) + 2\n"
  s = s + "end\n"
  return s
end

def ptr_chain_src(): String
  var s = "def make(v: Int): Ptr<Int>\n"
  s = s + "  var p = ptr_alloc(1)\n"
  s = s + "  ptr_write(p, v)\n"
  s = s + "  return p\n"
  s = s + "end\n"
  s = s + "def pass_through(p: Ptr<Int>): Ptr<Int>\n"
  s = s + "  return p\n"
  s = s + "end\n"
  s = s + "def main(): Int\n"
  s = s + "  var p = make(42)\n"
  s = s + "  var q = pass_through(p)\n"
  s = s + "  return ptr_read(q)\n"
  s = s + "end\n"
  return s
end
