## v0.3.1 Unicode width — wcwidth-style cell-count tests
##
## Contract:
##   1. ASCII printable → 1 cell
##   2. Control chars (C0 + DEL) → 0 cells
##   3. Combining marks (Mn / Me) → 0 cells
##   4. Zero-width controls (ZWJ, ZWNJ, ZWSP, BOM) → 0 cells
##   5. CJK ideographs / Hangul syllables / full-width forms → 2 cells
##   6. Emoji_Presentation → 2 cells
##   7. East Asian Ambiguous → 1 by default, 2 after locale override

import * from qspec
import std/unicode

def test_ascii_letter(): Void
  # 'A' (U+0041) — 1 cell
  assert_eq(unicode_width(65), 1)
end

def test_ascii_digit(): Void
  # '0' (U+0030) — 1 cell
  assert_eq(unicode_width(48), 1)
end

def test_ascii_space(): Void
  # ' ' (U+0020) — 1 cell (lowest printable)
  assert_eq(unicode_width(32), 1)
end

def test_control_null(): Void
  # NUL (U+0000)
  assert_eq(unicode_width(0), 0)
end

def test_control_tab(): Void
  # TAB (U+0009) — terminal expands; per-codepoint width is 0
  assert_eq(unicode_width(9), 0)
end

def test_control_newline(): Void
  # LF (U+000A)
  assert_eq(unicode_width(10), 0)
end

def test_control_del(): Void
  # DEL (U+007F)
  assert_eq(unicode_width(127), 0)
end

def test_combining_acute(): Void
  # COMBINING ACUTE ACCENT (U+0301) — Mn, width 0
  assert_eq(unicode_width(0x0301), 0)
end

def test_combining_grave(): Void
  # COMBINING GRAVE ACCENT (U+0300) — Mn, width 0
  assert_eq(unicode_width(0x0300), 0)
end

def test_zwj(): Void
  # ZERO WIDTH JOINER (U+200D)
  assert_eq(unicode_width(0x200D), 0)
end

def test_zwnj(): Void
  # ZERO WIDTH NON-JOINER (U+200C)
  assert_eq(unicode_width(0x200C), 0)
end

def test_zwsp(): Void
  # ZERO WIDTH SPACE (U+200B)
  assert_eq(unicode_width(0x200B), 0)
end

def test_bom(): Void
  # ZERO WIDTH NO-BREAK SPACE / BOM (U+FEFF)
  assert_eq(unicode_width(0xFEFF), 0)
end

def test_cjk_zhong(): Void
  # 中 (U+4E2D)
  assert_eq(unicode_width(0x4E2D), 2)
end

def test_cjk_ichi(): Void
  # 一 (U+4E00)
  assert_eq(unicode_width(0x4E00), 2)
end

def test_cjk_kan(): Void
  # 漢 (U+6F22)
  assert_eq(unicode_width(0x6F22), 2)
end

def test_fullwidth_zero(): Void
  # FULLWIDTH DIGIT ZERO (U+FF10)
  assert_eq(unicode_width(0xFF10), 2)
end

def test_fullwidth_nine(): Void
  # FULLWIDTH DIGIT NINE (U+FF19)
  assert_eq(unicode_width(0xFF19), 2)
end

def test_hangul_syllable(): Void
  # 가 (U+AC00) — Hangul Syllable
  assert_eq(unicode_width(0xAC00), 2)
end

def test_hangul_jamo_initial(): Void
  # ᄀ (U+1100) — Hangul Jamo Choseong (initial), 2 cells standalone
  assert_eq(unicode_width(0x1100), 2)
end

def test_hangul_jamo_medial(): Void
  # ᅡ (U+1161) — Hangul Jamo Jungseong (medial vowel), 0 cells
  assert_eq(unicode_width(0x1161), 0)
end

def test_emoji_cookie(): Void
  # 🍪 (U+1F36A)
  assert_eq(unicode_width(0x1F36A), 2)
end

def test_emoji_rocket(): Void
  # 🚀 (U+1F680)
  assert_eq(unicode_width(0x1F680), 2)
end

def test_emoji_watch(): Void
  # ⌚ (U+231A) — Emoji_Presentation but EAW=N; should still be 2
  assert_eq(unicode_width(0x231A), 2)
end

def test_emoji_hourglass(): Void
  # ⏳ (U+23F3) — Emoji_Presentation
  assert_eq(unicode_width(0x23F3), 2)
end

def test_ambiguous_alpha_default(): Void
  # α (U+03B1) — EAW=A, default width 1
  uc_set_east_asian_ambiguous_width(1)
  assert_eq(unicode_width(0x03B1), 1)
end

def test_ambiguous_omega_default(): Void
  # Ω (U+03A9) — EAW=A, default width 1
  uc_set_east_asian_ambiguous_width(1)
  assert_eq(unicode_width(0x03A9), 1)
end

def test_ambiguous_locale_override(): Void
  # CJK locale: ambiguous → 2
  uc_set_east_asian_ambiguous_width(2)
  assert_eq(unicode_width(0x03B1), 2)
  # Restore default for subsequent tests in any process
  uc_set_east_asian_ambiguous_width(1)
end

def test_ambiguous_setter_roundtrip(): Void
  uc_set_east_asian_ambiguous_width(2)
  assert_eq(uc_east_asian_ambiguous_width(), 2)
  uc_set_east_asian_ambiguous_width(1)
  assert_eq(uc_east_asian_ambiguous_width(), 1)
end

def main(): Int
  describe("ASCII") do ->
    it("letter is 1 cell") do ->
      test_ascii_letter()
    end
    it("digit is 1 cell") do ->
      test_ascii_digit()
    end
    it("space is 1 cell") do ->
      test_ascii_space()
    end
  end

  describe("Control characters") do ->
    it("NUL is 0 cells") do ->
      test_control_null()
    end
    it("TAB is 0 cells") do ->
      test_control_tab()
    end
    it("LF is 0 cells") do ->
      test_control_newline()
    end
    it("DEL is 0 cells") do ->
      test_control_del()
    end
  end

  describe("Combining marks (zero width)") do ->
    it("acute accent is 0 cells") do ->
      test_combining_acute()
    end
    it("grave accent is 0 cells") do ->
      test_combining_grave()
    end
  end

  describe("Zero-width controls") do ->
    it("ZWJ is 0 cells") do ->
      test_zwj()
    end
    it("ZWNJ is 0 cells") do ->
      test_zwnj()
    end
    it("ZWSP is 0 cells") do ->
      test_zwsp()
    end
    it("BOM is 0 cells") do ->
      test_bom()
    end
  end

  describe("CJK ideographs (wide)") do ->
    it("中 is 2 cells") do ->
      test_cjk_zhong()
    end
    it("一 is 2 cells") do ->
      test_cjk_ichi()
    end
    it("漢 is 2 cells") do ->
      test_cjk_kan()
    end
  end

  describe("Fullwidth forms") do ->
    it("０ is 2 cells") do ->
      test_fullwidth_zero()
    end
    it("９ is 2 cells") do ->
      test_fullwidth_nine()
    end
  end

  describe("Hangul") do ->
    it("syllable 가 is 2 cells") do ->
      test_hangul_syllable()
    end
    it("Jamo initial ᄀ is 2 cells") do ->
      test_hangul_jamo_initial()
    end
    it("Jamo medial ᅡ is 0 cells") do ->
      test_hangul_jamo_medial()
    end
  end

  describe("Emoji_Presentation") do ->
    it("cookie 🍪 is 2 cells") do ->
      test_emoji_cookie()
    end
    it("rocket 🚀 is 2 cells") do ->
      test_emoji_rocket()
    end
    it("watch ⌚ is 2 cells (EAW=N + Emoji_Presentation)") do ->
      test_emoji_watch()
    end
    it("hourglass ⏳ is 2 cells") do ->
      test_emoji_hourglass()
    end
  end

  describe("East Asian Ambiguous") do ->
    it("α defaults to 1 cell") do ->
      test_ambiguous_alpha_default()
    end
    it("Ω defaults to 1 cell") do ->
      test_ambiguous_omega_default()
    end
    it("locale override flips ambiguous to 2 cells") do ->
      test_ambiguous_locale_override()
    end
    it("setter roundtrip") do ->
      test_ambiguous_setter_roundtrip()
    end
  end

  return qspec_main()
end
