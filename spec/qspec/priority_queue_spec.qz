## Priority Queue Tests
##
## Contract:
##   1. New: `pq_new` creates empty min-heap with size 0.
##   2. Min-heap: pops smallest first.
##   3. Duplicates: handles duplicate values correctly.
##   4. Empty pop: popping empty heap returns None.
##   5. Max-heap: `pq_new_max` pops largest first.
##   6. Peek: returns top without removing, size unchanged.
##   7. Empty peek: peeking empty heap returns None.
##   8. Clear: removes all elements.
##   9. Size: size tracks push/pop.
##   10. Single: single element push then pop returns it.
import * from qspec
import * from collections/priority_queue

def main(): Int
  describe("pq_new") do ->
    it("creates an empty min-heap") do ->
      var pq = pq_new()
      assert_eq(pq.size(), 0)
      assert_eq(pq.is_empty(), 1)
      pq.free()
    end
  end

  describe("min-heap") do ->
    it("pops smallest first") do ->
      assert_eq(pq_min_test(), 1)
    end

    it("handles duplicates") do ->
      assert_eq(pq_dup_test(), 1)
    end

    it("returns None on empty pop") do ->
      var pq = pq_new()
      assert(pq.pop().none?)
      pq.free()
    end
  end

  describe("max-heap") do ->
    it("pops largest first") do ->
      assert_eq(pq_max_test(), 1)
    end
  end

  describe("peek") do ->
    it("returns top without removing") do ->
      assert_eq(pq_peek_test(), 1)
    end

    it("returns None on empty") do ->
      var pq = pq_new()
      assert(pq.peek().none?)
      pq.free()
    end
  end

  describe("clear") do ->
    it("removes all elements") do ->
      assert_eq(pq_clear_test(), 1)
    end
  end

  describe("size tracking") do ->
    it("size tracks push and pop") do ->
      var pq = pq_new()
      pq.push(10)
      assert_eq(pq.size(), 1)
      pq.push(20)
      assert_eq(pq.size(), 2)
      pq.pop()
      assert_eq(pq.size(), 1)
      pq.free()
    end

    it("single element push then pop") do ->
      var pq = pq_new()
      pq.push(42)
      var val = 0
      match pq.pop()
        Some(v) => val = v
        _ => val = -1
      end
      assert_eq(val, 42)
      assert_eq(pq.size(), 0)
      pq.free()
    end
  end

  return qspec_main()
end

def pq_min_test(): Int
  var pq = pq_new()
  pq.push(30)
  pq.push(10)
  pq.push(20)
  pq.push(5)
  pq.push(15)
  var a = 0
  var b = 0
  var c = 0
  match pq.pop()
    Some(v) => a = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => b = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => c = v
    _ => return 0
  end
  pq.free()
  if a == 5
    if b == 10
      if c == 15
        return 1
      end
    end
  end
  return 0
end

def pq_dup_test(): Int
  var pq = pq_new()
  pq.push(5)
  pq.push(5)
  pq.push(5)
  var a = 0
  var b = 0
  var c = 0
  match pq.pop()
    Some(v) => a = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => b = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => c = v
    _ => return 0
  end
  pq.free()
  if a == 5
    if b == 5
      if c == 5
        return 1
      end
    end
  end
  return 0
end

def pq_max_test(): Int
  var pq = pq_new_max()
  pq.push(10)
  pq.push(30)
  pq.push(20)
  pq.push(5)
  var a = 0
  var b = 0
  var c = 0
  match pq.pop()
    Some(v) => a = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => b = v
    _ => return 0
  end
  match pq.pop()
    Some(v) => c = v
    _ => return 0
  end
  pq.free()
  if a == 30
    if b == 20
      if c == 10
        return 1
      end
    end
  end
  return 0
end

def pq_peek_test(): Int
  var pq = pq_new()
  pq.push(42)
  pq.push(7)
  var p = 0
  match pq.peek()
    Some(v) => p = v
    _ => return 0
  end
  var sz = pq.size()
  pq.free()
  if p == 7
    if sz == 2
      return 1
    end
  end
  return 0
end

def pq_clear_test(): Int
  var pq = pq_new()
  pq.push(1)
  pq.push(2)
  pq.push(3)
  pq.clear()
  var sz = pq.size()
  var empty = pq.is_empty()
  pq.free()
  if sz == 0
    if empty
      return 1
    end
  end
  return 0
end
