import * from qspec
import * from std/sync/communication/channel
import * from std/sync/scheduler

def test_chan_inspect(): Void
  var ch = channel_new(10)
  send(ch, 1)
  send(ch, 2)
  send(ch, 3)
  chan_inspect(ch)
  channel_close(ch)
end

def test_chan_inspect_empty(): Void
  var ch = channel_new(5)
  chan_inspect(ch)
  channel_close(ch)
end

def test_chan_inspect_closed(): Void
  var ch = channel_new(1)
  channel_close(ch)
  chan_inspect(ch)
end

def test_sched_dashboard(): Void
  sched_init(2)
  sched_dashboard()
  sched_shutdown()
end

def test_task_tree(): Void
  sched_init(2)
  sched_task_tree()
  sched_shutdown()
  puts("task tree ok")
end

def main(): Int
  describe("observability") do ->

    it("chan_inspect shows capacity and length") do ->
      assert_output("Channel: capacity=10, len=3, status=open\n", test_chan_inspect)
    end

    it("chan_inspect on empty channel") do ->
      assert_output("Channel: capacity=5, len=0, status=open\n", test_chan_inspect_empty)
    end

    it("chan_inspect on closed channel") do ->
      assert_output("Channel: capacity=1, len=0, status=closed\n", test_chan_inspect_closed)
    end

    it("sched_dashboard shows scheduler state") do ->
      assert_output("Scheduler: workers=2, active_tasks=0, queue_depth=0\n", test_sched_dashboard)
    end

    it("sched_task_tree runs without crash") do ->
      assert_output("task tree ok\n", test_task_tree)
    end

  end

  return qspec_main()
end
