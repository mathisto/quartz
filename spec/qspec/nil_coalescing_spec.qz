## Nil Coalescing and Safe Navigation Tests
##
## Contract:
##   1. Nil coalescing basic usage.
##   2. Chained usage.
##   3. With function calls.
##   4. Safe navigation operator.
##   5. Spacing validation.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("nil coalescing basic usage") do ->
    it("returns value from Some") do ->
      x = option_some(42)
      assert_eq(x ?? 0, 42)
    end

    it("returns default from None") do ->
      x = option_none()
      assert_eq(x ?? 99, 99)
    end

    it("works with variable as default") do ->
      x = option_none()
      fallback = 55
      assert_eq(x ?? fallback, 55)
    end

    it("works with expression as default") do ->
      x = option_none()
      assert_eq(x ?? 6 * 7, 42)
    end
  end

  describe("chained usage") do ->
    it("chains multiple ?? operators") do ->
      a = option_none()
      b = option_none()
      assert_eq(a ?? b ?? 42, 42)
    end

    it("short-circuits on first Some") do ->
      a = option_some(10)
      b = option_some(20)
      assert_eq(a ?? b ?? 99, 10)
    end
  end

  describe("with function calls") do ->
    it("works with function returning Option") do ->
      assert_eq(get_some() ?? 0, 42)
      assert_eq(get_none() ?? 99, 99)
    end

    it("evaluates default only when needed") do ->
      x = option_some(42)
      assert_eq(x ?? 0, 42)
    end
  end

  describe("safe navigation operator") do ->
    it("returns Some(field) when value is Some") do ->
      assert_run_exits("""
        struct Usr
          age: Int
        end
        def main(): Int
          var u = option_some(Usr { age: 42 })
          return u?.age ?? 0
        end
        """, 42)
    end
    it("returns None when value is None") do ->
      assert_run_exits("""
        struct Usr
          age: Int
        end
        def main(): Int
          var u = option_none()
          return u?.age ?? 99
        end
        """, 99)
    end
    it("chains with regular field access") do ->
      assert_run_exits("""
        struct Inner
          val: Int
        end
        struct Outer
          inner: Inner
        end
        def get_val(o: Outer): Int = o.inner.val
        def main(): Int
          var x = option_some(Outer { inner: Inner { val: 42 } })
          return get_val(x ?? Outer { inner: Inner { val: 0 } })
        end
        """, 42)
    end
    it("combines ?. and ??") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def main(): Int
          var a = option_some(Pt { x: 42 })
          var b = option_none()
          r1 = a?.x ?? 0
          r2 = b?.x ?? 99
          return r1 + r2
        end
        """, 141)
    end
  end

  describe("spacing validation") do ->
    it("rejects ?? without space before") do ->
      assert_compile_fails("""
        def main(): Int
          x = option_some(42)
          return x?? 0
        end
        """)
    end

    it("rejects ?? without space after") do ->
      assert_compile_fails("""
        def main(): Int
          x = option_some(42)
          return x ??10
        end
        """)
    end

    it("rejects ?? without any spaces") do ->
      assert_compile_fails("""
        def main(): Int
          x = option_some(42)
          return x??0
        end
        """)
    end

    it("accepts ?? with proper spaces") do ->
      x = option_some(42)
      assert_eq(x ?? 0, 42)
    end

    it("accepts ?? with closing paren after") do ->
      assert_eq(nc_paren(option_some(10)), 10)
      assert_eq(nc_paren(option_none()), 99)
    end
  end

  return qspec_main()
end

def get_some(): Int
  return option_some(42)
end

def get_none(): Int
  return option_none()
end

def nc_paren(x: Int): Int
  return x ?? 99
end
