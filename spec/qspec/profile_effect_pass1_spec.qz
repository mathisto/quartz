## QSpec coverage for the runtime-blessed Profile default handler
## (Phase A.6 Pass 1).
##
## Locks in the prelude install + typecheck blessed-relaxation:
##   - `prof_phase`, `prof_sample`, and `prof_span_*` work at module
##     level WITHOUT explicit `with Profile do ... end` ceremony or
##     `can Profile` annotation — analogous to Cache's blessed default.
##   - The runtime default is gate-and-emit: with both flags off,
##     emission is a no-op (the spec asserts no stderr noise via
##     bare `puts` checks).
##   - User `with Profile { prof_phase: h } do body end` still
##     overrides the default (top-down handler-stack scan).
##   - `prof_span_begin`/`prof_span_end` always return real timestamps
##     even with default emission disabled (bench framework substrate).
##
## Out of scope:
##   - End-to-end value prop with default-handler emission ON. The
##     stderr capture story for assert_output() captures stdout only;
##     the prof_phase emission goes to stderr. That coverage lives in
##     Pass 2 / Phase 4 with explicit user-handler captures.

import * from qspec
import std/profile

# --- Test 1: module-level prof_phase works without with-block, returns
#     0, no observable side effect when both gates are off.

def t1_use(): Int
  return prof_phase("init")
end

def t1_run(): Void
  var result = t1_use()
  puts("phase=#{result}")
end

# --- Test 2: user `with Profile { prof_phase: h } do body end`
#     overrides the prelude default. The mock counts invocations and
#     returns a sentinel.

var _t2_calls = 0

def t2_mock_phase(op_name: Int, argc: Int, argv: Int): Int
  _t2_calls = _t2_calls + 1
  return 99
end

var _t2_result = 0

def t2_run(): Void
  _t2_calls = 0
  with Profile { prof_phase: t2_mock_phase } do ->
    _t2_result = prof_phase("lex")
  end
  puts("result=#{_t2_result} calls=#{_t2_calls}")
end

# --- Test 3: post-with calls return to the prelude default. After the
#     wrap exits, the mock counter does NOT advance.

def t3_run(): Void
  _t2_calls = 0
  with Profile { prof_phase: t2_mock_phase } do ->
    var inside = prof_phase("m1")
    puts("inside=#{inside}")
  end
  var outside = prof_phase("m2")
  puts("outside=#{outside} calls=#{_t2_calls}")
end

# --- Test 4: span begin/end always return real timestamps regardless
#     of output gate. The end value (elapsed ns) is non-negative.

def t4_run(): Void
  var begin = prof_span_begin("compile")
  # Some quick work to ensure monotonic clock advances.
  var sum = 0
  for i in 0..100
    sum = sum + i
  end
  var elapsed = prof_span_end(begin, "compile")
  if elapsed >= 0
    puts("elapsed_nonnegative")
  else
    puts("elapsed_negative=#{elapsed}")
  end
  if begin > 0
    puts("begin_set")
  else
    puts("begin_zero")
  end
end

# --- Test 5: prof_sample works at module level, returns 0.

def t5_run(): Void
  var v = prof_sample("functions", 2437)
  puts("sample=#{v}")
end

def main(): Int
  describe("Profile blessed-default install (A.6 Pass 1)") do ->
    it("prof_phase works at module level without with-block") do ->
      assert_output("phase=0\n", t1_run)
    end

    it("user with Profile handlers override the prelude default") do ->
      assert_output("result=99 calls=1\n", t2_run)
    end

    it("post-with calls fall through to the prelude default") do ->
      assert_output("inside=99\noutside=0 calls=1\n", t3_run)
    end

    it("span begin/end always return real timestamps") do ->
      assert_output("elapsed_nonnegative\nbegin_set\n", t4_run)
    end

    it("prof_sample works at module level") do ->
      assert_output("sample=0\n", t5_run)
    end
  end
  return qspec_main()
end
