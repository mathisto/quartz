## build_cache × FileIo — P5.4.b testability-pattern spec.
##
## Operation Piezoelectric Effects, Phase 5, Milestone 5.4.b.
##
## The actual self-hosted/shared/build_cache.qz migration is verified
## by the compiler's fixpoint + smoke test + cache-roundtrip checks
## run at guard time (gen1==gen2 byte-identical, style_demo/brainfuck
## green, second compile produces identical IR and populates
## .quartz-cache/manifest correctly). The qspec harness runs snippets
## without -I self-hosted/shared, so it cannot import `build_cache`
## directly.
##
## This spec demonstrates the testability *pattern* the build_cache
## migration unlocks: a cache-like subsystem that routes every fs
## access through FileIo, and a mock handler that satisfies its reads
## and captures its writes from an in-memory backing map — zero disk.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("FileIo testability pattern (piezo 5.4.b)") do ->
    it("mock handler captures writes and satisfies reads — simulated cache roundtrip") do ->
      assert_run_stdout_eq("""
import std/file_io

# In-memory backing map: parallel vecs of (path, content).
var _fake_paths = vec_new<String>()
var _fake_contents = vec_new<String>()

def fake_write(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  var content = as_string(load(argv, 1))
  _fake_paths.push(path)
  _fake_contents.push(content)
  return 0
end

def fake_read(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  for i in 0.._fake_paths.size
    if _fake_paths[i] == path
      return as_int(_fake_contents[i])
    end
  end
  return as_int("")
end

def fake_exists(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  for i in 0.._fake_paths.size
    if _fake_paths[i] == path
      return 1
    end
  end
  return 0
end

# Simulated cache_store — mirrors build_cache.qz's shape.
def mini_cache_store(path: String, ir: String): Void
  with FileIo { fio_write: fake_write } do ->
    var _wr = fio_write(path, ir)
  end
end

# Simulated cache_lookup — mirrors build_cache.qz's shape.
def mini_cache_lookup(path: String): String
  return with FileIo { fio_read: fake_read, fio_exists: fake_exists } do ->
    var result = ""
    if fio_exists(path)
      result = fio_read(path)
    end
    result
  end
end

def main(): Int
  mini_cache_store("mod_a.qz", "; IR for mod a")
  mini_cache_store("mod_b.qz", "; IR for mod b")

  puts(mini_cache_lookup("mod_a.qz"))
  puts(mini_cache_lookup("mod_b.qz"))
  puts(mini_cache_lookup("unknown.qz"))

  return 0
end
""", "; IR for mod a\n; IR for mod b\n\n")
    end

    it("deny-all handler sandboxes all fs access") do ->
      assert_run_stdout_eq("""
import std/file_io

# Sandbox: every fs op returns the empty/false equivalent, nothing is
# read or written. Simulates a capability-denied runtime.
def deny_read(op_name: Int, argc: Int, argv: Int): Int
  return as_int("")
end

def deny_exists(op_name: Int, argc: Int, argv: Int): Int
  return 0
end

def deny_write(op_name: Int, argc: Int, argv: Int): Int
  return 0 - 1
end

def try_access(p: String): String can FileIo
  if fio_exists(p)
    return fio_read(p)
  end
  return ""
end

def main(): Int
  with FileIo { fio_read: deny_read, fio_exists: deny_exists, fio_write: deny_write } do ->
    var r = try_access("/etc/passwd")
    if str_byte_len(r) == 0
      puts("DENIED")
    else
      puts("LEAK")
    end
  end
  return 0
end
""", "DENIED\n")
    end

    it("readback-after-write via in-memory map preserves content") do ->
      assert_run_stdout_eq("""
import std/file_io

var _slots = vec_new<String>()
var _keys = vec_new<String>()

def m_write(op_name: Int, argc: Int, argv: Int): Int
  _keys.push(as_string(load(argv, 0)))
  _slots.push(as_string(load(argv, 1)))
  return 0
end

def m_read(op_name: Int, argc: Int, argv: Int): Int
  var k = as_string(load(argv, 0))
  var found = as_int("")
  for i in 0.._keys.size
    if _keys[i] == k
      found = as_int(_slots[i])
    end
  end
  return found
end

def m_exists(op_name: Int, argc: Int, argv: Int): Int
  return 1
end

def do_writes(): Void can FileIo
  var _w1 = fio_write("alpha", "A")
  var _w2 = fio_write("beta", "B")
  var _w3 = fio_write("gamma", "C")
end

def do_reads(): Void can FileIo
  puts(fio_read("alpha"))
  puts(fio_read("beta"))
  puts(fio_read("gamma"))
end

def main(): Int
  with FileIo { fio_write: m_write, fio_read: m_read, fio_exists: m_exists } do ->
    do_writes()
    do_reads()
  end
  return 0
end
""", "A\nB\nC\n")
    end
  end
  return qspec_main()
end
