## Binary DSL — Sub-phase 1.5 roundtrip coverage.
##
## For each worked example from docs/design/BINARY_DSL.md, construct a
## typed value, `.encode()` it to Bytes, `.decode()` back, and assert
## every field round-trips unchanged.
##
## Phase 1.5 scope: all 5 worked examples — byte-aligned, single-byte
## sub-byte, multi-byte straddling sub-byte, and variable-width fields.
## GpioModer uses the `as` bitcast path rather than encode/decode
## (packed struct, design decision #12).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — roundtrip coverage (Phase 1.5)") do ->

    it("PngIhdr: 7 byte-aligned fields, big-endian") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type PngIhdr = binary {
          width:       u32be
          height:      u32be
          bit_depth:   u8
          color_type:  u8
          compression: u8
          filter:      u8
          interlace:   u8
        }
        def main(): Int
          var h = PngIhdr {
            width: 1920, height: 1080,
            bit_depth: 8, color_type: 2,
            compression: 0, filter: 0, interlace: 1,
          }
          var b = h.encode()
          if b.size() != 13
            return 90
          end
          match PngIhdr.decode(b)
            Ok(h2) => {
              return 1 if h2.width != 1920
              return 2 if h2.height != 1080
              return 3 if h2.bit_depth != 8
              return 4 if h2.color_type != 2
              return 5 if h2.compression != 0
              return 6 if h2.filter != 0
              return 7 if h2.interlace != 1
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("IntMapHeader: 5 u64le fields") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type IntMapHeader = binary {
          cap:  u64le
          len:  u64le
          keys: u64le
          vals: u64le
          used: u64le
        }
        def main(): Int
          var h = IntMapHeader { cap: 16, len: 3, keys: 1000, vals: 2000, used: 3000 }
          var b = h.encode()
          if b.size() != 40
            return 90
          end
          match IntMapHeader.decode(b)
            Ok(h2) => {
              return 1 if h2.cap != 16
              return 2 if h2.len != 3
              return 3 if h2.keys != 1000
              return 4 if h2.vals != 2000
              return 5 if h2.used != 3000
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("BleAdvHeader: sub-byte + u8") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type BleAdvHeader = binary {
          pdu_type: u4
          rfu:      u2
          tx_addr:  u1
          rx_addr:  u1
          length:   u8
        }
        def main(): Int
          var h = BleAdvHeader {
            pdu_type: 0b0010, rfu: 0, tx_addr: 1, rx_addr: 0,
            length: 42,
          }
          var b = h.encode()
          if b.size() != 2
            return 90
          end
          # MSB-first byte 0: pdu_type=0b0010<<4 | rfu=0<<2 | tx=1<<1 | rx=0 = 0b00100010 = 34
          if b.get(0) != 34
            return 91
          end
          if b.get(1) != 42
            return 92
          end
          match BleAdvHeader.decode(b)
            Ok(h2) => {
              return 1 if h2.pdu_type != 2
              return 2 if h2.rfu != 0
              return 3 if h2.tx_addr != 1
              return 4 if h2.rx_addr != 0
              return 5 if h2.length != 42
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("GpioModer: packed struct bitcast roundtrip (16 × u2 → u32)") do ->
      assert_run_exits("""
        packed struct(u32) GpioModer
          pin0_mode:  2
          pin1_mode:  2
          pin2_mode:  2
          pin3_mode:  2
          pin4_mode:  2
          pin5_mode:  2
          pin6_mode:  2
          pin7_mode:  2
          pin8_mode:  2
          pin9_mode:  2
          pin10_mode: 2
          pin11_mode: 2
          pin12_mode: 2
          pin13_mode: 2
          pin14_mode: 2
          pin15_mode: 2
        end
        def main(): Int
          var m = GpioModer {
            pin0_mode: 3, pin1_mode: 0, pin2_mode: 1, pin3_mode: 2,
            pin4_mode: 0, pin5_mode: 1, pin6_mode: 1, pin7_mode: 0,
            pin8_mode: 2, pin9_mode: 3, pin10_mode: 0, pin11_mode: 1,
            pin12_mode: 0, pin13_mode: 3, pin14_mode: 0, pin15_mode: 1,
          }
          var raw = m as u32
          var m2 = raw as GpioModer
          return 1 if m2.pin0_mode != 3
          return 2 if m2.pin1_mode != 0
          return 3 if m2.pin2_mode != 1
          return 4 if m2.pin3_mode != 2
          return 5 if m2.pin5_mode != 1
          return 6 if m2.pin9_mode != 3
          return 7 if m2.pin13_mode != 3
          return 8 if m2.pin15_mode != 1
          return 0
        end
        """, 0)
    end

    it("IPv4Header: sub-byte + straddle + variable-width payload") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type IPv4Header = binary {
          version:    u4
          ihl:        u4
          tos:        u8
          total:      u16be
          id:         u16be
          flags:      u3
          frag_off:   u13be
          ttl:        u8
          proto:      u8
          checksum:   u16be
          src:        u32be
          dst:        u32be
          payload:    bytes
        }
        def main(): Int
          var p = Bytes { _data: vec_new() }
          var i = 0
          while i < 4
            p.push(42)
            i = i + 1
          end
          var h = IPv4Header {
            version: 4, ihl: 5, tos: 0, total: 24, id: 0x1234,
            flags: 0b010, frag_off: 0x1abc, ttl: 64, proto: 6,
            checksum: 0x9abc, src: 0x0a000001, dst: 0x0a000002,
            payload: p,
          }
          var b = h.encode()
          return 90 if b.size() != 24
          # Byte 6 = flags<<5 | frag_off[12..8]. flags=0b010, frag_off high 5 = 0b11010
          # → 0b01011010 = 90.
          return 91 if b.get(6) != 90
          return 92 if b.get(7) != 0xbc
          match IPv4Header.decode(b)
            Ok(h2) => {
              return 1 if h2.version != 4
              return 2 if h2.ihl != 5
              return 3 if h2.total != 24
              return 4 if h2.flags != 2
              return 5 if h2.frag_off != 0x1abc
              return 6 if h2.src != 0x0a000001
              return 7 if h2.dst != 0x0a000002
              return 8 if h2.payload.size() != 4
              return 9 if h2.payload.get(0) != 42
              return 10 if h2.payload.get(3) != 42
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end
  end

  return qspec_main()
end
