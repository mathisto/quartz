## Async I/O Integration Tests
##
## End-to-end tests for the full async I/O pipeline:
##   async func() -> io_suspend(fd) -> scheduler fd registration -> kqueue/epoll -> task resume

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("async I/O integration") do ->
    it("dynamic await suspends properly in async context") do ->
      assert_run_exits(dynamic_await_src(), 0)
    end

    it("multi-level async chain propagates suspension") do ->
      assert_run_exits(multi_level_src(), 0)
    end

    it("concurrent async I/O tasks multiplex on scheduler") do ->
      assert_run_exits(concurrent_io_src(), 0)
    end

    it("pipe-based async echo via scheduler") do ->
      assert_run_exits(pipe_echo_src(), 0)
    end

    it("dynamic await on already-completed future loads result immediately") do ->
      assert_run_exits(dynamic_await_eager_src(), 0)
    end

    it("dynamic await in loop collects multiple results") do ->
      assert_run_exits(dynamic_await_loop_src(), 0)
    end
  end

  return qspec_main()
end

def dynamic_await_src(): String
  return """
    extern "C" def pipe(fds: CPtr): CInt
    extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt
    def read_i32(p: Int): Int
      var b0 = ptr_read_byte(p)
      var b1 = ptr_read_byte(ptr_add(p, 1))
      var b2 = ptr_read_byte(ptr_add(p, 2))
      var b3 = ptr_read_byte(ptr_add(p, 3))
      return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    end
    def reader(fd: Int): Int
      io_suspend(fd)
      return 42
    end
    def awaiter(handle: Int): Int
      var result = await handle
      return result
    end
    def main(): Int
      sched_init(2)
      var fds = mem_alloc(8)
      pipe(fds)
      var rfd = read_i32(fds)
      var wfd = read_i32(ptr_add(fds, 4))
      var reader_frame = async reader(rfd)
      var awaiter_frame = async awaiter(reader_frame)
      sched_spawn(awaiter_frame)
      var buf = mem_alloc(1)
      store(buf, 0, 65)
      write(wfd, buf, 1)
      sched_shutdown()
      if load(awaiter_frame, 0) == -1
        if load(awaiter_frame, 1) == 42
          return 0
        end
      end
      return 1
    end
    """
end

def multi_level_src(): String
  return """
    extern "C" def pipe(fds: CPtr): CInt
    extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt
    def read_i32(p: Int): Int
      var b0 = ptr_read_byte(p)
      var b1 = ptr_read_byte(ptr_add(p, 1))
      var b2 = ptr_read_byte(ptr_add(p, 2))
      var b3 = ptr_read_byte(ptr_add(p, 3))
      return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    end
    def leaf(fd: Int): Int
      io_suspend(fd)
      return 10
    end
    def middle(handle: Int): Int
      var result = await handle
      return result + 20
    end
    def outer(handle: Int): Int
      var result = await handle
      return result + 30
    end
    def main(): Int
      sched_init(2)
      var fds = mem_alloc(8)
      pipe(fds)
      var rfd = read_i32(fds)
      var wfd = read_i32(ptr_add(fds, 4))
      var l = async leaf(rfd)
      var m = async middle(l)
      var o = async outer(m)
      sched_spawn(o)
      var buf = mem_alloc(1)
      store(buf, 0, 65)
      write(wfd, buf, 1)
      sched_shutdown()
      if load(o, 0) == -1
        if load(o, 1) == 60
          return 0
        end
      end
      return 1
    end
    """
end

def concurrent_io_src(): String
  return """
    extern "C" def pipe(fds: CPtr): CInt
    extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt
    def read_i32(p: Int): Int
      var b0 = ptr_read_byte(p)
      var b1 = ptr_read_byte(ptr_add(p, 1))
      var b2 = ptr_read_byte(ptr_add(p, 2))
      var b3 = ptr_read_byte(ptr_add(p, 3))
      return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    end
    def io_reader(fd: Int): Int
      io_suspend(fd)
      return fd
    end
    def forwarder(handle: Int): Int
      var result = await handle
      return result
    end
    def main(): Int
      sched_init(4)
      var fds1 = mem_alloc(8)
      var fds2 = mem_alloc(8)
      var fds3 = mem_alloc(8)
      pipe(fds1)
      pipe(fds2)
      pipe(fds3)
      var rfd1 = read_i32(fds1)
      var wfd1 = read_i32(ptr_add(fds1, 4))
      var rfd2 = read_i32(fds2)
      var wfd2 = read_i32(ptr_add(fds2, 4))
      var rfd3 = read_i32(fds3)
      var wfd3 = read_i32(ptr_add(fds3, 4))
      var r1 = async io_reader(rfd1)
      var r2 = async io_reader(rfd2)
      var r3 = async io_reader(rfd3)
      var f1 = async forwarder(r1)
      var f2 = async forwarder(r2)
      var f3 = async forwarder(r3)
      sched_spawn(f1)
      sched_spawn(f2)
      sched_spawn(f3)
      var buf = mem_alloc(1)
      store(buf, 0, 65)
      write(wfd1, buf, 1)
      write(wfd2, buf, 1)
      write(wfd3, buf, 1)
      sched_shutdown()
      var ok = 1
      if load(f1, 0) != -1
        ok = 0
      end
      if load(f2, 0) != -1
        ok = 0
      end
      if load(f3, 0) != -1
        ok = 0
      end
      if ok == 1
        return 0
      end
      return 1
    end
    """
end

def pipe_echo_src(): String
  return """
    extern "C" def pipe(fds: CPtr): CInt
    extern "C" def write(fd: CInt, buf: CPtr, n: CInt): CInt
    extern "C" def read(fd: CInt, buf: CPtr, n: CInt): CInt
    def read_i32(p: Int): Int
      var b0 = ptr_read_byte(p)
      var b1 = ptr_read_byte(ptr_add(p, 1))
      var b2 = ptr_read_byte(ptr_add(p, 2))
      var b3 = ptr_read_byte(ptr_add(p, 3))
      return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    end
    def async_read_byte(fd: Int): Int
      io_suspend(fd)
      var buf = mem_alloc(1)
      read(fd, buf, 1)
      return ptr_read_byte(buf)
    end
    def read_proxy(handle: Int): Int
      var result = await handle
      return result
    end
    def main(): Int
      sched_init(2)
      var fds = mem_alloc(8)
      pipe(fds)
      var rfd = read_i32(fds)
      var wfd = read_i32(ptr_add(fds, 4))
      var reader = async async_read_byte(rfd)
      var proxy = async read_proxy(reader)
      sched_spawn(proxy)
      var buf = mem_alloc(1)
      store(buf, 0, 77)
      write(wfd, buf, 1)
      sched_shutdown()
      if load(proxy, 0) == -1
        if load(proxy, 1) == 77
          return 0
        end
      end
      return 1
    end
    """
end

def dynamic_await_eager_src(): String
  return """
    def pure_fn(): Int
      return 99
    end
    def awaiter(handle: Int): Int
      var result = await handle
      return result
    end
    def main(): Int
      sched_init(2)
      var f = async pure_fn()
      var a = async awaiter(f)
      sched_spawn(a)
      sched_shutdown()
      if load(a, 0) == -1
        if load(a, 1) == 99
          return 0
        end
      end
      return 1
    end
    """
end

def dynamic_await_loop_src(): String
  return """
    def work_a(): Int = 10
    def work_b(): Int = 20
    def work_c(): Int = 30
    def collector(tasks: Vec<Int>): Int
      var sum = 0
      var i = 0
      while i < vec_size(tasks)
        var handle = vec_get(tasks, i)
        var result = await handle
        sum += result
        i += 1
      end
      return sum
    end
    def main(): Int
      sched_init(2)
      var tasks = vec_new<Int>()
      vec_push(tasks, go work_a())
      vec_push(tasks, go work_b())
      vec_push(tasks, go work_c())
      var c = async collector(tasks)
      sched_spawn(c)
      sched_shutdown()
      if load(c, 0) == -1
        if load(c, 1) == 60
          return 0
        end
      end
      return 1
    end
    """
end
