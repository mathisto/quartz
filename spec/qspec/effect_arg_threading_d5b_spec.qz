## Effect op arg threading — E(post) argc/argv acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone E(post).
##
## Extends D.5b's single-arg0 threading with full argc/argv. Runtime
## ABI is now:
##
##   i64 @__qz_effect_perform(ptr %eff, ptr %op, i64 %argc, ptr %argv, i64 %kind)
##   handler: i64 (ptr %op, i64 %argc, ptr %argv)
##
## argv points to a stack-allocated `[argc x i64]` array. Each slot
## carries one op argument as an i64 (Quartz values are all i64-sized
## at runtime — String/struct ptrs, Ints/Bools/Chars inline). Zero-arg
## ops pass argc=0 with argv=null. User handlers decode args via
## `load(argv, idx)`; String args round-trip through `as_string()`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect op argc/argv threading (piezo E(post))") do ->
    it("user handler receives string arg0 via argv and can decode it") do ->
      assert_run_stdout_eq("""
effect Log
  def emit(s: String): Int
end

def my_log(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  puts(s)
  return 0
end

def main(): Int
  with Log { emit: my_log } do ->
    emit("hello from effect!")
  end
  return 0
end
""", "hello from effect!\n")
    end

    it("different single-arg invocations yield different stdout") do ->
      assert_run_stdout_eq("""
effect Log
  def emit(s: String): Int
end

def my_log(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  puts(s)
  return 0
end

def main(): Int
  with Log { emit: my_log } do ->
    emit("first")
    emit("second")
    emit("third")
  end
  return 0
end
""", "first\nsecond\nthird\n")
    end

    it("zero-arg op still dispatches; argc=0 and argv=null") do ->
      assert_run_stdout_eq("""
effect Bell
  def signal(): Int
end

def ring(op_name: Int, argc: Int, argv: Int): Int
  puts("ding")
  return 0
end

def main(): Int
  with Bell { signal: ring } do ->
    signal()
  end
  return 0
end
""", "ding\n")
    end

    it("IR emits call to handler with (op, argc, argv) — G.2 static fast path") do ->
      # Piezo G.2: lexically-resolved perform calls the handler fn directly
      # (no runtime stack scan). The 5-param `__qz_effect_perform` signature
      # still exists (exercised by dynamic paths — see the runtime decl
      # assertion below) but this lexical perform bypasses it.
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def handler(op_name: Int, argc: Int, argv: Int): Int = 0

def main(): Int
  with Log { emit: handler } do ->
    emit("x")
  end
  return 0
end
""", "call i64 @handler(ptr ")
    end

    it("runtime declares 5-param perform signature (argc + argv + F.3b kind)") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "define i64 @__qz_effect_perform(ptr %eff, ptr %op, i64 %argc, ptr %argv, i64 %kind)")
    end

    it("default handler signature takes argc + argv") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "define i64 @__qz_default_throws_handler(ptr %op, i64 %argc, ptr %argv)")
    end

    it("arg-passing works across intermediate can-rowed function") do ->
      # info() has `can Log`, calls emit(prefixed) with a concatenated
      # string. The user handler must see the FULL prefixed string,
      # proving argv is populated at the op-call site (not at the with).
      assert_run_stdout_eq("""
effect Log
  def emit(s: String): Int
end

def info(msg: String): Int can Log
  var p = "[INFO] "
  p = p + msg
  return emit(p)
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  puts(s)
  return 0
end

def main(): Int
  with Log { emit: cap } do ->
    info("loading")
  end
  return 0
end
""", "[INFO] loading\n")
    end
  end
  return qspec_main()
end
