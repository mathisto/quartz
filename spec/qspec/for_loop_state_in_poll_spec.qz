## For-loop synthetic locals must be saved/restored across kind=3 yield
## suspensions inside generator `$poll` bodies.
##
## Pre-fix bug: `for x in v` inside a generator body (or `can Yield`
## helper invoked from one) emits anonymous `__for_iter_N` /
## `__for_idx_N` allocas that were NOT registered with the generator
## frame layout via `mir_gen_register_dynamic_local`. After the first
## yield, `$poll` re-enters at a resume block; the alloca slots are
## fresh stack memory (NULL Vec / index 0), so iteration either
## restarts at element 0 forever, stops at element 0, or SIGSEGVs
## dereferencing a NULL Vec header.
##
## Pre-existing — surfaced 2026-04-25 during Phase 4.B.9 effect
## composition exploration. Filed in
## `docs/bugs/FOR_LOOP_STATE_NOT_PRESERVED_IN_POLL.md`.
##
## Fix: every iteration-lowering site in `mir_lower_iter.qz` that
## emits a synthetic `__for_*` / `__citer_*` / `__copt_*` / `__cl_iter`
## slot now calls `mir_lower_gen::mir_gen_register_dynamic_local(name)`
## immediately after `gen_for_temp(...)`, mirroring what
## `lower_custom_iteration` and `_lower_async_gen_iter_impl` already do.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("for-loop state preservation across kind=3 yield in $poll") do ->

    it("for x in Vec inside generator body — direct yields") do ->
      # NOTE: Vec is bound with an explicit type annotation
      # (`var v: Vec<Int> = vec_new()`) rather than the type-arg-on-call form
      # (`var v = vec_new<Int>()`); the type-arg form crashes the compiler in
      # this exact context (impl Iterator + inline Vec + yield), independently
      # of for-loop state preservation. Push count is held to 2 because a
      # separate pre-existing deterministic compiler crash fires at exactly
      # 3 pushes (1, 2, 4 all compile). Both compiler-crash quirks are filed
      # for separate investigation; the for-loop-state semantics under test
      # here are fully exercised regardless.
      assert_run_stdout_eq("""
def gen_from_vec(): impl Iterator<Int>
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  for x in v
    yield x
  end
end

def main(): Int
  for x in gen_from_vec()
    puts(x.to_s())
  end
  return 0
end
""", "10\n20\n")
    end

    it("for x in Vec inside `can Yield` helper called from generator") do ->
      assert_run_stdout_eq("""
def emit_each(items: Vec<Int>): Void can Yield<Int>
  for x in items
    yield x
  end
end

def gen_from_vec(): impl Iterator<Int>
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  v.push(30)
  emit_each(v)
end

def main(): Int
  for x in gen_from_vec()
    puts(x.to_s())
  end
  return 0
end
""", "10\n20\n30\n")
    end

    it("for i in Range inside generator body — already worked, regression guard") do ->
      assert_run_stdout_eq("""
def gen_range(): impl Iterator<Int>
  for i in 0..3
    yield i * 10
  end
end

def main(): Int
  for x in gen_range()
    puts(x.to_s())
  end
  return 0
end
""", "0\n10\n20\n")
    end

    it("nested for x in Vec inside generator body — both loops survive yield") do ->
      assert_run_stdout_eq("""
def gen_pairs(): impl Iterator<Int>
  var outer: Vec<Int> = vec_new()
  outer.push(1)
  outer.push(2)
  var inner: Vec<Int> = vec_new()
  inner.push(10)
  inner.push(20)
  for a in outer
    for b in inner
      yield a * 100 + b
    end
  end
end

def main(): Int
  for x in gen_pairs()
    puts(x.to_s())
  end
  return 0
end
""", "110\n120\n210\n220\n")
    end

    it("for x in Vec inside generator — partial consumption then break") do ->
      assert_run_stdout_eq("""
def gen_from_vec(): impl Iterator<Int>
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  v.push(30)
  v.push(40)
  for x in v
    yield x
  end
end

def main(): Int
  var seen = 0
  for x in gen_from_vec()
    puts(x.to_s())
    seen = seen + 1
    if seen >= 2
      break
    end
  end
  return 0
end
""", "10\n20\n")
    end

    it("for x in Vec mixed with side-effecting State across yields") do ->
      assert_run_stdout_eq("""
import std/state

def emit_with_state(items: Vec<Int>): Void can Yield<Int>, State<Int>
  for x in items
    set(get() + x)
    yield x
  end
end

def gen_run(): impl Iterator<Int>
  var items: Vec<Int> = vec_new()
  items.push(1)
  items.push(2)
  items.push(3)
  emit_with_state(items)
end

def main(): Int
  with State(0) do ->
    for x in gen_run()
      puts(x.to_s())
    end
    puts(get().to_s())
  end
  return 0
end
""", "1\n2\n3\n6\n")
    end

  end
  return qspec_main()
end
