## String Utilities Tests
##
## Contract:
##   1. str_reverse: reverses character order.
##   2. str_repeat: repeats string N times, 0 = empty.
##   3. str_count: counts non-overlapping substring occurrences.
##   4. UFCS: `.reverse()`, `.repeat()`, `.count()` dot-call.

import * from qspec

def main(): Int
  describe("str_reverse") do ->
    it("reverses a string") do ->
      assert_eq_str(str_reverse("hello"), "olleh")
    end
  end

  describe("str_repeat") do ->
    it("repeats a string n times") do ->
      assert_eq_str(str_repeat("ab", 3), "ababab")
    end

    it("returns empty string for 0 repeats") do ->
      r = str_repeat("x", 0)
      assert_eq(r.size, 0)
    end
  end

  describe("str_count") do ->
    it("counts occurrences of substring") do ->
      assert_eq(str_count("abcabc", "bc"), 2)
    end

    it("returns 0 when not found") do ->
      assert_eq(str_count("hello", "xyz"), 0)
    end
  end

  describe("UFCS methods") do ->
    it("s.reverse()") do ->
      assert_eq_str("abc".reverse(), "cba")
    end

    it("s.repeat(n)") do ->
      assert_eq_str("ha".repeat(3), "hahaha")
    end

    it("single char reverse is identity") do ->
      assert_eq_str(str_reverse("x"), "x")
    end

    it("repeat 1 returns original") do ->
      assert_eq_str(str_repeat("hello", 1), "hello")
    end

    it("count with no matches") do ->
      assert_eq(str_count("aaa", "b"), 0)
    end
  end

  return qspec_main()
end
