## STRESS: String Operations Edge Cases
##
## Adversarial tests probing string dark corners:
## empty strings, length-prefixed behavior, chained operations,
## string equality, interpolation edge cases, slicing boundaries,
## StringBuilder stress, and character operations.
##
## Contract:
##   1. Strings: empty string ops.
##   2. Strings: equality edge cases.
##   3. Strings: slicing boundaries.
##   4. Strings: StringBuilder stress.
##   5. Strings: interpolation edge cases.
##   6. Strings: chained operations.
##   7. Strings: character operations.
##   8. Strings: size consistency.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Empty String Operations
  # ===========================================================================
  describe("strings: empty string ops") do ->
    it("empty string has size 0") do ->
      assert_run_exits("""
        def main(): Int
          s = ""
          if s.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("concatenating two empty strings") do ->
      assert_run_exits("""
        def main(): Int
          a = ""
          b = ""
          c = a + b
          if c.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("empty string + non-empty") do ->
      assert_run_exits("""
        def main(): Int
          s = "" + "hello"
          if s.size == 5
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("non-empty + empty string") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello" + ""
          if s.size == 5
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("find in empty string returns None") do ->
      assert_run_exits("""
        def main(): Int
          s = ""
          if not str_contains(s, "x")
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("slice of empty string") do ->
      assert_run_exits("""
        def main(): Int
          s = ""
          t = str_slice(s, 0, 0)
          if t.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category B: String Equality
  # ===========================================================================
  describe("strings: equality edge cases") do ->
    it("identical string literals are equal") do ->
      assert_run_exits("""
        def main(): Int
          a = "hello"
          b = "hello"
          if a == b
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("different strings are not equal") do ->
      assert_run_exits("""
        def main(): Int
          a = "hello"
          b = "world"
          if a != b
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("empty strings are equal") do ->
      assert_run_exits("""
        def main(): Int
          a = ""
          b = ""
          if a == b
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("string equality is case-sensitive") do ->
      assert_run_exits("""
        def main(): Int
          if "ABC" != "abc"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("strings equal by content, not identity") do ->
      assert_run_exits("""
        def main(): Int
          a = "he" + "llo"
          b = "hel" + "lo"
          if a == b
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category C: String Slicing Boundaries
  # ===========================================================================
  describe("strings: slicing boundaries") do ->
    it("slice entire string") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello"
          t = str_slice(s, 0, 5)
          if t == "hello"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("single character slice") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello"
          t = str_slice(s, 0, 1)
          if t == "h"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("slice from middle") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello world"
          t = str_slice(s, 6, 11)
          if t == "world"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("zero-length slice") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello"
          t = str_slice(s, 2, 2)
          if t.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category D: StringBuilder Stress
  # ===========================================================================
  describe("strings: StringBuilder stress") do ->
    it("many small appends") do ->
      assert_run_exits("""
        def main(): Int
          var sb = sb_new()
          var i = 0
          while i < 1000
            sb_append(sb, "x")
            i = i + 1
          end
          s = sb_to_string(sb)
          if s.size == 1000
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("append_int builds correct string") do ->
      assert_run_exits("""
        def main(): Int
          var sb = sb_new()
          sb.append("n=")
          sb.append_int(42)
          s = sb.to_string()
          if s == "n=42"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("clear and reuse StringBuilder") do ->
      assert_run_exits("""
        def main(): Int
          var sb = sb_new()
          sb.append("first")
          sb.clear()
          sb.append("second")
          s = sb.to_string()
          if s == "second"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("append_char builds correct string") do ->
      assert_run_exits("""
        def main(): Int
          var sb = sb_new()
          sb_append_char(sb, 72)
          sb_append_char(sb, 105)
          s = sb_to_string(sb)
          if s == "Hi"
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category E: String Interpolation Edge Cases
  # ===========================================================================
  describe("strings: interpolation edge cases") do ->
    it("interpolation with zero") do ->
      assert_run_exits("""
        def main(): Int
          x = 0
          s = "value: \#{x}"
          if s == "value: 0"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("back-to-back interpolations") do ->
      assert_run_exits("""
        def main(): Int
          a = 1
          b = 2
          s = "\#{a}\#{b}"
          if s == "12"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("interpolation with expression") do ->
      assert_run_exits("""
        def main(): Int
          x = 20
          s = "doubled: \#{x * 2}"
          if s == "doubled: 40"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("nested function call in interpolation") do ->
      assert_run_exits("""
        def square(n: Int): Int = n * n
        def main(): Int
          s = "sq: \#{square(7)}"
          if s == "sq: 49"
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category F: Chained String Operations
  # ===========================================================================
  describe("strings: chained operations") do ->
    it("concat chain preserves order") do ->
      assert_run_exits("""
        def main(): Int
          s = "a" + "b" + "c" + "d" + "e"
          if s == "abcde"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("find after concat") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello" + " " + "world"
          if str_contains(s, "world")
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("slice then concat") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello world"
          a = str_slice(s, 0, 5)
          b = str_slice(s, 6, 11)
          c = a + "-" + b
          if c == "hello-world"
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("split and rejoin") do ->
      assert_run_exits("""
        def main(): Int
          s = "a,b,c"
          parts = str_split(s, ",")
          if parts.size == 3
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category G: Character Operations
  # ===========================================================================
  describe("strings: character operations") do ->
    it("char_at returns correct ASCII values") do ->
      assert_run_exits("""
        def main(): Int
          s = "ABC"
          if s.char_at(0) == 65
            if s.char_at(1) == 66
              if s.char_at(2) == 67
                return 0
              end
            end
          end
          return 1
        end
        """, 0)
    end

    it("char predicates on digits") do ->
      assert_run_exits("""
        def main(): Int
          c = 48
          if c.digit?
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("char predicates on letters") do ->
      assert_run_exits("""
        def main(): Int
          c = 65
          if c.alpha?
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("str_from_char roundtrip") do ->
      assert_run_exits("""
        def main(): Int
          s = str_from_char(88)
          if s == "X"
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category H: String Size / Length Consistency
  # ===========================================================================
  describe("strings: size consistency") do ->
    it("size increases with concatenation") do ->
      assert_run_exits("""
        def main(): Int
          s1 = "abc"
          s2 = "def"
          s3 = s1 + s2
          if s3.size == 6
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("size reflects actual content after slice") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello world"
          t = str_slice(s, 0, 5)
          if t.size == 5
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("str_from_int produces correct size") do ->
      assert_run_exits("""
        def main(): Int
          s = str_from_int(12345)
          if s.size == 5
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  return qspec_main()
end
