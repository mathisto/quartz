import * from qspec
import * from qspec/subprocess

def run_adversarial_inner(): Void
  var result = subprocess_run(read_file("spec/qspec/runner_fixtures/framework_adversarial_inner.qz"))
  if result.exit_code != 0
    puts("isolated adversarial framework harness failed: " + result.stderr_content + result.stdout_content)
  end
  assert_eq(result.exit_code, 0)
end

def repeated_subprocess_init_is_single_service(): Void
  _sub_init()
  var ready_path = getenv("QSPEC_SUB_ROOT") + "/.qspec-supervisor.ready"
  var initial_ready = read_file(ready_path)
  for i in 0..29
    _sub_init()
  end
  assert_eq_str(read_file(ready_path), initial_ready)
  var result = subprocess_compile("def main(): Int\n  return 0\nend\n")
  assert_eq(result.exit_code, 0)
  assert_eq_str(read_file(ready_path), initial_ready)
  assert_eq(str_split(str_trim(result.supervision), "\n").size, 1)
  assert_eq(str_contains(result.supervision_containment, "detached descendants unknown"), 1)
end

def bounded_supervisor_telemetry_scale(): Void
  _sub_init()
  _sub_begin_result()
  var failures = 0
  for i in 0..1000
    var argv = vec_new<String>(); argv.push("/usr/bin/true")
    var status = _sub_supervised("nested-run", 10000 + i, argv, vec_new<String>(), vec_new<String>(), "", "/dev/null", false)
    if not status.valid or status.exit_code != 0 or status.orphan
      failures += 1
    end
  end
  assert_eq(failures, 0)
  assert_eq(str_split(str_trim(_sub_records_string(_sub_supervision_records)), "\n").size, 64)
  assert_eq(str_split(str_trim(_sub_records_string(_sub_supervision_timing_records)), "\n").size, 64)
end

def main(): Int
  describe("QSpec adversarial framework harness") do ->
    it("keeps repeated subprocess initialization on one ready service", repeated_subprocess_init_is_single_service)
    if getenv("QSPEC_SUB_SCALE_TEST") == "1"
      it("bounds request-local supervisor telemetry under load", bounded_supervisor_telemetry_scale)
    end
    it("validates failure and cleanup semantics in an isolated process", run_adversarial_inner)
  end
  return qspec_main()
end
