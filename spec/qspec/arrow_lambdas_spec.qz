## Arrow Lambdas Tests
##
## Contract:
##   1. Inline arrow lambdas.
##   2. Arrow lambda as value.
##   3. Curly block arrow syntax.
##   4. Do...end arrow syntax.
##   5. Edge cases.
##   6. Type checking.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("inline arrow lambdas") do ->
    it("supports nullary arrow lambda: -> expr") do ->
      assert_eq(al_call(-> 42), 42)
    end

    it("supports single untyped param: x -> expr") do ->
      assert_eq(al_apply(x -> x * 2, 21), 42)
    end

    it("supports single typed param: x: Int -> expr") do ->
      assert_eq(al_apply((x: Int) -> x * 2, 21), 42)
    end

    it("supports multiple typed params") do ->
      assert_eq(al_apply2((x: Int, y: Int) -> x + y, 30, 12), 42)
    end

    it("supports parenthesized multi untyped params") do ->
      assert_eq(al_apply2((x, y) -> x + y, 20, 22), 42)
    end

    it("supports parenthesized typed params") do ->
      assert_eq(al_apply2((x: Int, y: Int) -> x + y, 20, 22), 42)
    end

    it("supports parenthesized single param") do ->
      assert_eq(al_apply((x) -> x * 2, 21), 42)
    end

    it("supports parenthesized nullary: () -> expr") do ->
      assert_eq(al_call(() -> 42), 42)
    end

    it("supports block body") do ->
      result = al_apply_last(5) do n ->
        a = n * 2
        b = a + 1
        b
      end
      assert_eq(result, 11)
    end

    it("supports control flow in block body") do ->
      result = al_apply_last(3) do n ->
        if n > 2
          n * 10
        else
          n
        end
      end
      assert_eq(result, 30)
    end
  end

  describe("arrow lambda as value") do ->
    it("stores arrow lambda in typed variable") do ->
      f = (x: Int) -> x + 10
      assert_eq(f(32), 42)
    end

    it("returns arrow lambda from function") do ->
      add5 = al_make_adder(5)
      assert_eq(add5(37), 42)
    end

    it("captures variables from outer scope") do ->
      multiplier = 7
      assert_eq(al_apply(n -> n * multiplier, 6), 42)
    end
  end

  describe("curly block arrow syntax") do ->
    it("parses { x -> expr } as block argument") do ->
      assert_eq(al_apply_last(21) { x -> x * 2 }, 42)
    end

    it("parses { -> expr } for nullary blocks") do ->
      assert_eq(al_run() { -> 99 }, 99)
    end

    it("parses { x, y -> expr } for multiple params") do ->
      assert_eq(al_combine(10, 5) { x, y -> x + y }, 15)
    end

    it("parses { x: Int -> expr } with typed params") do ->
      assert_eq(al_apply_last(7) { n: Int -> n * 6 }, 42)
    end

    it("parses typed multi params with typed params") do ->
      assert_eq(al_combine(20, 22) { x: Int, y: Int -> x + y }, 42)
    end

    it("supports multi-statement curly blocks with arrow") do ->
      result = al_apply_last(5) { n ->
        doubled = n * 2
        doubled + 1
      }
      assert_eq(result, 11)
    end

    it("works with UFCS method calls") do ->
      assert_eq(10.al_apply_last() { n -> n * 3 }, 30)
    end
  end

  describe("do...end arrow syntax") do ->
    it("supports do x -> expr end") do ->
      result = al_apply_last(21) do x ->
        x * 2
      end
      assert_eq(result, 42)
    end

    it("supports do -> expr end for nullary") do ->
      result = al_run() do ->
        99
      end
      assert_eq(result, 99)
    end

    it("supports do x, y -> expr end for multiple params") do ->
      result = al_combine(10, 5) do x, y ->
        x + y
      end
      assert_eq(result, 15)
    end

    it("supports do x: Int -> expr end with typed params") do ->
      result = al_apply_last(7) do n ->
        n * 6
      end
      assert_eq(result, 42)
    end

    it("supports multi-statement do-end blocks with arrow") do ->
      result = al_apply_last(5) do n ->
        doubled = n * 2
        doubled + 1
      end
      assert_eq(result, 11)
    end

    it("supports if expression as return value in arrow do-block") do ->
      result = al_apply_last(10) do n ->
        if n > 5
          100
        else
          0
        end
      end
      assert_eq(result, 100)
    end

    it("supports match expression in arrow do-block") do ->
      result = al_apply_last(2) do n ->
        var v = match n
          1 => 10
          2 => 20
          _ => 99
        end
        v
      end
      assert_eq(result, 20)
    end

    it("supports UFCS with do-end arrow blocks") do ->
      result = 10.al_apply_last() do n ->
        n * 3
      end
      assert_eq(result, 30)
    end

    it("captures closure variables in arrow do-block") do ->
      multiplier = 7
      result = al_apply_last(6) do n ->
        n * multiplier
      end
      assert_eq(result, 42)
    end
  end

  describe("edge cases") do ->
    it("supports nested arrow lambdas") do ->
      result = al_run() do ->
        al_apply_last(5) do n ->
          n * 4
        end
      end
      assert_eq(result, 20)
    end

    it("supports chained UFCS ending in arrow block") do ->
      result = 5.al_dbl().al_apply_last() do n ->
        n + 1
      end
      assert_eq(result, 11)
    end

    it("distinguishes { x -> expr } from struct literals") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def apply(f: Fn(Int): Int, val: Int): Int = f(val)
        def main(): Int
          p = Point { x: 10, y: 20 }
          f = { n -> n * 2 }
          result = apply(f, p.x)
          return result + p.y
        end
        """, 40)
    end

    it("supports arrow lambda with block appended to existing args") do ->
      result = al_process(3, 4) do n ->
        n + 2
      end
      assert_eq(result, 14)
    end
  end

  describe("type checking") do ->
    it("rejects arrow lambda with wrong parameter count") do ->
      assert_compile_error("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((a, b) -> a + b, 5)
        end
        """, "Lambda has 2 parameter(s) but Fn(Int): Int expects 1")
    end
    it("rejects arrow lambda with wrong return type") do ->
      assert_compile_error("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply(x -> "hello", 5)
        end
        """, "return type mismatch")
    end
  end

  return qspec_main()
end

def al_call(f: Fn(): Int): Int
  return f()
end

def al_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def al_apply2(f: Fn(Int, Int): Int, a: Int, b: Int): Int
  return f(a, b)
end

def al_make_adder(n: Int): Fn(Int): Int
  return x -> x + n
end

def al_apply_last(x: Int, f: Fn(Int): Int): Int
  return f(x)
end

def al_run(f: Fn(): Int): Int
  return f()
end

def al_combine(a: Int, b: Int, f: Fn(Int, Int): Int): Int
  return f(a, b)
end

def al_dbl(x: Int): Int
  return x * 2
end

def al_process(base: Int, multiplier: Int, f: Fn(Int): Int): Int
  return f(base * multiplier)
end

