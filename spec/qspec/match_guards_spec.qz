## Match Guards Tests
##
## Contract:
##   1. Falls through when payload.
##   2. Matches arm with passing.
##   3. Matches wildcard only when.
##   4. Skips arm when guard.
##   5. Supports function calls in.
##   6. Supports logical operators in.
import * from qspec

enum MGSResult
  Ok(value: Int)
  Err(code: Int)
end

def main(): Int
  describe("match guards") do ->
    it("matches arm with passing guard") do ->
      assert_eq(guard_pass(10), 1)
    end

    it("skips arm when guard fails") do ->
      assert_eq(guard_pass(3), 0)
    end

    it("tries next arm when guard fails") do ->
      assert_eq(guard_chain(5), 2)
      assert_eq(guard_chain(15), 1)
      assert_eq(guard_chain(1), 3)
      assert_eq(guard_chain(0), 4)
    end

    it("uses extracted payload in guard") do ->
      assert_eq(guard_payload_s(MGSResult::Ok(42)), 42)
    end

    it("falls through when payload guard fails") do ->
      assert_eq(guard_payload_s(MGSResult::Ok(5)), 0)
      assert_eq(guard_payload_s(MGSResult::Err(1)), -1)
    end
    it("works with multi-statement arms") do ->
      assert_eq(guard_do_block(15), 30)
      assert_eq(guard_do_block(3), 0)
    end

    it("supports function calls in guards") do ->
      assert_eq(guard_fn_call(6), 1)
      assert_eq(guard_fn_call(7), 0)
    end

    it("supports logical operators in guards") do ->
      assert_eq(guard_logic(15), 1)
      assert_eq(guard_logic(5), 0)
      assert_eq(guard_logic(25), 0)
    end

    it("matches wildcard only when guard passes") do ->
      assert_eq(guard_wildcard(15), 1)
      assert_eq(guard_wildcard(8), 2)
      assert_eq(guard_wildcard(1), 3)
    end
  end
  return qspec_main()
end

def guard_pass(x: Int): Int
  match x
    n if n > 5 => return 1
    _ => return 0
  end
  return 99
end

def guard_chain(x: Int): Int
  match x
    n if n > 10 => return 1
    n if n > 3 => return 2
    n if n > 0 => return 3
    _ => return 4
  end
  return 99
end

def guard_fn_call(x: Int): Int
  match x
    n if is_even_g(n) => return 1
    _ => return 0
  end
  return 99
end

def guard_logic(x: Int): Int
  match x
    n if n > 10 and n < 20 => return 1
    _ => return 0
  end
  return 99
end

def guard_wildcard(x: Int): Int
  match x
    _ if x > 10 => return 1
    _ if x > 5 => return 2
    _ => return 3
  end
  return 99
end

def guard_do_block(x: Int): Int
  match x
    n if n > 10 =>
      var doubled = n * 2
      return doubled
    _ => return 0
  end
  return 99
end

def guard_payload_s(r: Int): Int
  match r
    MGSResult::Ok(v) if v > 10 => return v
    Ok(v) => return 0
    _ => return -1
  end
  return 99
end

def is_even_g(n: Int): Int
  return n % 2 == 0
end
