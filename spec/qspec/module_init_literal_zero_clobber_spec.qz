import * from qspec

# Regression for the `__qz_module_init` literal-zero clobber hazard.
# PASS 1.5 iterates global_init_nodes in declaration order; pre-fix it
# emitted a `store 0, @global_g_sentinel` AFTER `_lazy_init_sentinel`
# had already mutated g_sentinel via `var g_witness = ...`. The store
# silently reset the lazy-init value. PMM bump cursor hit this in
# D.11 Phase 8c.1 (see [[feedback-supervised-per-conn-second-request-gp]]
# + [[feedback-qz-module-init-trivial-store-ordering]]).
#
# Fix: PASS 1.5 skips the runtime store when init_node is NODE_INT_LIT —
# the LLVM static initializer at @global_X = <literal> already covers
# it, so the runtime store is redundant AND clobber-prone.
#
# IMPORTANT: g_witness MUST be declared BEFORE g_sentinel so PASS 1.5
# lowers the complex init first and the literal-zero store second.

var g_witness = _lazy_init_sentinel()
var g_sentinel = 0

def _lazy_init_sentinel(): Int
  if g_sentinel == 0
    g_sentinel = 42
  end
  return 99
end

def main(): Int
  describe("__qz_module_init: literal-zero clobber regression") do ->
    it("`var X = 0` does NOT clobber a complex init's lazy-init of X") do ->
      assert_eq(g_sentinel, 42)
    end
    it("the complex init's return value is intact") do ->
      assert_eq(g_witness, 99)
    end
  end
  return qspec_main()
end
