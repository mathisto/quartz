## STRESS: Generic Type System Edge Cases
##
## Adversarial tests probing the dark corners of Quartz's generic type system:
## deep nesting, cross-function generic calls, generic structs with methods,
## inference across boundaries, generic enums, generics+closures, generic UFCS.
##
## Contract:
##   1. Generics: deep nesting.
##   2. Generics: cross-function calls.
##   3. Generics: structs with methods.
##   4. Generics: type inference.
##   5. Generics: enums.
##   6. Generics: with closures.
##   7. Generics: UFCS dispatch.
##   8. Generics: edge cases.
##   9. Generics: additional edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Deeply Nested Generics
  # ===========================================================================
  describe("generics: deep nesting") do ->
    it("nested generic struct: Box<Box<Int>>") do ->
      assert_run_exits("""
        struct Box<T>
          value: T
        end
        def main(): Int
          inner = Box<Int> { value: 42 }
          outer = Box<Int> { value: inner.value }
          return outer.value
        end
        """, 42)
    end

    it("triple nested generic access: Box<Box<Box<Int>>>") do ->
      assert_run_exits("""
        struct Box<T>
          value: T
        end
        def main(): Int
          a = Box<Int> { value: 42 }
          b = Box<Int> { value: a.value }
          c = Box<Int> { value: b.value }
          return c.value
        end
        """, 42)
    end

    it("generic identity called 5 times in chain") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          return id(id(id(id(id(42)))))
        end
        """, 42)
    end

    it("generic function applied to its own result") do ->
      assert_run_exits("""
        def inc<T>(x: T): T = x + 1
        def main(): Int
          return inc(inc(inc(inc(inc(37)))))
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Generic Functions Calling Other Generic Functions
  # ===========================================================================
  describe("generics: cross-function calls") do ->
    it("generic function calls another generic function") do ->
      assert_run_exits("""
        def identity<T>(x: T): T = x
        def wrap<T>(x: T): T = identity(x)
        def main(): Int
          return wrap(42)
        end
        """, 42)
    end

    it("two-level generic delegation") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def pass<T>(x: T): T = id(x)
        def relay<T>(x: T): T = pass(x)
        def main(): Int
          return relay(42)
        end
        """, 42)
    end

    it("generic function calling non-generic with concrete type") do ->
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def apply_double<T>(x: T): T = double(x)
        def main(): Int
          return apply_double(21)
        end
        """, 42)
    end

    it("generic function used with multiple concrete types") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          a = id(10)
          b = id(20)
          c = id(12)
          return a + b + c
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Generic Structs with Methods
  # ===========================================================================
  describe("generics: structs with methods") do ->
    it("generic struct with associated function (Box::make creates Box)") do ->
      assert_run_exits("""
        struct Box
          value: Int
        end
        extend Box
          def make(v: Int): Box = Box { value: v }
        end
        def main(): Int
          var b = Box::make(42)
          return b.value
        end
      """, 42)
    end


    it("extend block on generic struct") do ->
      assert_run_exits("""
        struct Wrapper<T>
          inner: T
        end
        extend Wrapper<T> {
          def get(): T = self.inner
        }
        def main(): Int
          w = Wrapper<Int> { inner: 42 }
          return w.get()
        end
        """, 42)
    end

    it("generic struct with two type parameters") do ->
      assert_run_exits("""
        struct Pair<A, B>
          first: A
          second: B
        end
        def main(): Int
          p = Pair<Int, Int> { first: 20, second: 22 }
          return p.first + p.second
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Type Inference Across Generic Boundaries
  # ===========================================================================
  describe("generics: type inference") do ->
    it("infer generic type from argument") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          x = id(42)
          return x
        end
        """, 42)
    end

    it("infer through let-binding chain") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          a = 42
          b = id(a)
          return b
        end
        """, 42)
    end

    it("generic return used in arithmetic") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          return id(20) + id(22)
        end
        """, 42)
    end

    it("generic used in if condition") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          if id(1)
            return 42
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Generic Enums
  # ===========================================================================
  describe("generics: enums") do ->
    it("generic Option-like enum with match") do ->
      assert_run_exits("""
        enum Maybe<T>
          Just(value: T)
          Nothing
        end
        def main(): Int
          x = Maybe::Just(42)
          match x
            Maybe::Just(v) => return v
            Maybe::Nothing => return 0
          end
        end
        """, 42)
    end

    it("generic enum function: unwrap_or") do ->
      assert_run_exits("""
        enum Maybe<T>
          Just(value: T)
          Nothing
        end
        def maybe_unwrap_or<T>(m: Maybe<T>, default_val: T): T
          return match m
            Just(value) => value
            Nothing => default_val
          end
        end
        def main(): Int
          var x = Maybe::Just(42)
          return maybe_unwrap_or(x, 0)
        end
        """, 42)
    end

    it("nested generic enum: Maybe<Maybe<Int>>") do ->
      assert_run_exits("""
        enum Maybe<T>
          Just(value: T)
          Nothing
        end
        def main(): Int
          inner = Maybe::Just(42)
          match inner
            Maybe::Just(v) => return v
            Maybe::Nothing => return 0
          end
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Generics + Closures
  # ===========================================================================
  describe("generics: with closures") do ->
    it("generic function taking a closure argument") do ->
      assert_run_exits("""
        def apply<T>(f: Fn(T): T, x: T): T = f(x)
        def main(): Int
          return apply(x -> x + 1, 41)
        end
        """, 42)
    end

    it("generic map-like function") do ->
      assert_run_exits("""
        def transform<T>(x: T, f: Fn(T): T): T = f(x)
        def main(): Int
          result = transform(21, x -> x * 2)
          return result
        end
        """, 42)
    end

    it("closure capturing generic function result") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          val = id(42)
          f = -> val
          return f()
        end
        """, 42)
    end

    it("higher-order generic: apply twice") do ->
      assert_run_exits("""
        def apply<T>(f: Fn(T): T, x: T): T = f(x)
        def main(): Int
          inc = (x: Int) -> x + 1
          return apply(inc, apply(inc, 40))
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Generic UFCS Dispatch
  # ===========================================================================
  describe("generics: UFCS dispatch") do ->
    it("UFCS with generic function") do ->
      assert_run_exits("""
        def double<T>(x: T): T = x * 2
        def main(): Int
          return 21.double()
        end
        """, 42)
    end

    it("UFCS chain with generic functions") do ->
      assert_run_exits("""
        def inc<T>(x: T): T = x + 1
        def double<T>(x: T): T = x * 2
        def main(): Int
          return 20.inc().double()
        end
        """, 42)
    end

    it("generic struct field access via UFCS") do ->
      assert_run_exits("""
        struct Box<T>
          value: T
        end
        def extract<T>(b: Box<T>): T = b.value
        def main(): Int
          b = Box<Int> { value: 42 }
          return extract(b)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category H: Generic Edge Cases & Stress
  # ===========================================================================
  describe("generics: edge cases") do ->
    it("generic function with unused type parameter") do ->
      assert_run_exits("""
        def constant<T>(x: T): Int = 42
        def main(): Int
          return constant(0)
        end
        """, 42)
    end

    it("generic with same-named local variables in different instantiations") do ->
      assert_run_exits("""
        def process<T>(x: T): T
          var result = x
          result = result + 1
          return result
        end
        def main(): Int
          a = process(20)
          b = process(21)
          return a + b - 1
        end
        """, 42)
    end

    it("generic function in while loop") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          var sum = 0
          var i = 0
          while i < 7
            sum = sum + id(i)
            i = i + 1
          end
          return sum + 21
        end
        """, 42)
    end

    it("generic function with default return path") do ->
      assert_run_exits("""
        def choose<T>(cond: Int, a: T, b: T): T
          if cond
            return a
          end
          return b
        end
        def main(): Int
          return choose(1, 42, 0)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category H: Additional Generic Edge Cases
  # ===========================================================================
  describe("generics: additional edge cases") do ->
    it("generic function with three type parameters") do ->
      assert_run_exits("""
        def pick_third<A, B, C>(a: A, b: B, c: C): C = c
        def main(): Int
          return pick_third(10, 20, 42)
        end
        """, 42)
    end

    it("generic function returning generic enum variant") do ->
      assert_run_exits("""
        enum Maybe<T>
          Just(value: T)
          Nothing
        end
        def make_just<T>(x: T): Maybe<T> = Maybe::Just(x)
        def main(): Int
          m = make_just(42)
          return match m
            Just(v) => v
            Nothing => 0
          end
        end
        """, 42)
    end

    it("two generic structs composed") do ->
      assert_run_exits("""
        struct Wrapper<T>
          inner: T
        end
        struct Holder<T>
          value: T
        end
        def main(): Int
          h = Holder<Int> { value: 42 }
          w = Wrapper<Int> { inner: h.value }
          return w.inner
        end
        """, 42)
    end

    it("generic identity applied to different types") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          a = id(40)
          b = id(2)
          return a + b
        end
        """, 42)
    end

    it("generic function with arithmetic on type param") do ->
      assert_run_exits("""
        def add_one<T>(x: T): T = x + 1
        def main(): Int
          return add_one(41)
        end
        """, 42)
    end

    it("generic struct with method via extend block") do ->
      assert_run_exits("""
        struct Container<T>
          val: T
        end
        extend Container<T> {
          def get(self: Container<T>): T = self.val
          def doubled(self: Container<T>): T = self.val * 2
        }
        def main(): Int
          c = Container<Int> { val: 21 }
          return c.doubled()
        end
        """, 42)
    end

    it("generic enum with multiple variants carrying payloads") do ->
      assert_run_exits("""
        enum Either<A, B>
          Left(a: A)
          Right(b: B)
        end
        def main(): Int
          var e = Either::Left(42)
          var result = match e
            Either::Left(v) => v
            Either::Right(v) => v
          end
          return result
        end
        """, 42)
    end

    it("nested generic function calls: id(id(id(42)))") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          return id(id(id(42)))
        end
        """, 42)
    end
  end

  return qspec_main()
end
