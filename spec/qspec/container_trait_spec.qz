## Container Trait + Auto-Satisfaction Tests
##
## Contract:
##   1. Empty impl blocks auto-satisfy traits from inherent impl methods
##   2. Auto-satisfied methods dispatch correctly
##   3. Default methods work with auto-satisfied abstract methods
##   4. Bounded generics work with auto-satisfied impls
##   5. All four collection types satisfy Container

import * from qspec
import * from traits
import * from collections/queue
import * from collections/stack
import * from collections/deque
import * from collections/linked_list
import * from collections/priority_queue
import * from collections/sorted_map

# -- Bounded generic using Container trait --

def get_size<T: Container>(c: T): Int = c.size()
def check_empty<T: Container>(c: T): Bool = c.is_empty()

# -- Test helpers --

def queue_size_test(): Int
  var q = queue_new()
  q.enqueue(10)
  q.enqueue(20)
  q.enqueue(30)
  return q.size()
end

def queue_empty_test(): Int
  var q = queue_new()
  var result = 0
  if q.is_empty()
    result += 1
  end
  q.enqueue(1)
  if q.is_empty() == false
    result += 10
  end
  return result
end

def queue_clear_test(): Int
  var q = queue_new()
  q.enqueue(1)
  q.enqueue(2)
  q.clear()
  return q.size()
end

def stack_size_test(): Int
  var s = stack_new()
  s.push(10)
  s.push(20)
  return s.size()
end

def deque_size_test(): Int
  var d = deque_new()
  d.push_back(1)
  d.push_back(2)
  d.push_back(3)
  d.push_back(4)
  return d.size()
end

def linked_list_size_test(): Int
  var ll = linked_list_new()
  ll.push_back(1)
  ll.push_back(2)
  ll.push_back(3)
  return ll.size()
end

def priority_queue_size_test(): Int
  var pq = priority_queue_new<Int>()
  pq.push(5)
  pq.push(3)
  pq.push(8)
  pq.push(1)
  return pq.size()
end

def sorted_map_size_test(): Int
  var m = sorted_map_new()
  m.set(1, 10)
  m.set(2, 20)
  return m.size()
end

def priority_queue_bounded_test(): Int
  var pq = priority_queue_new<Int>()
  pq.push(42)
  pq.push(7)
  return get_size(pq)
end

def sorted_map_bounded_test(): Int
  var m = sorted_map_new()
  m.set(99, 100)
  return get_size(m)
end

def bounded_generic_test(): Int
  var q = queue_new()
  q.enqueue(1)
  q.enqueue(2)
  return get_size(q)
end

def bounded_empty_test(): Int
  var q = queue_new()
  var result = 0
  if check_empty(q)
    result += 1
  end
  q.enqueue(42)
  if check_empty(q) == false
    result += 10
  end
  return result
end

def main(): Int
  describe("Container trait auto-satisfaction") do ->
    it("Queue.size() works with auto-satisfied impl") do ->
      assert_eq(queue_size_test(), 3)
    end

    it("Queue.is_empty() works (default calling auto-satisfied size)") do ->
      assert_eq(queue_empty_test(), 11)
    end

    it("Queue.clear() works (auto-satisfied)") do ->
      assert_eq(queue_clear_test(), 0)
    end

    it("Stack satisfies Container") do ->
      assert_eq(stack_size_test(), 2)
    end

    it("Deque satisfies Container") do ->
      assert_eq(deque_size_test(), 4)
    end

    it("LinkedList satisfies Container") do ->
      assert_eq(linked_list_size_test(), 3)
    end

    it("PriorityQueue satisfies Container") do ->
      assert_eq(priority_queue_size_test(), 4)
    end

    it("SortedMap satisfies Container") do ->
      assert_eq(sorted_map_size_test(), 2)
    end

    it("bounded generic with Container bound") do ->
      assert_eq(bounded_generic_test(), 2)
    end

    it("bounded generic is_empty with Container") do ->
      assert_eq(bounded_empty_test(), 11)
    end

    it("PriorityQueue works with Container-bounded generic") do ->
      assert_eq(priority_queue_bounded_test(), 2)
    end

    it("SortedMap works with Container-bounded generic") do ->
      assert_eq(sorted_map_bounded_test(), 1)
    end
  end

  return qspec_main()
end
