## Generic Edge Cases Tests
##
## Contract:
##   1. Apply function with lambda.
##   2. Apply function with named.
##   3. Apply_twice pattern.
##   4. Generic function called with.
##   5. Generic function with multiple.
##   6. Generic identity function.
import * from qspec
import * from qspec/subprocess

struct GPoint
  x: Int
  y: Int
end

def main(): Int
  describe("generic edge cases") do ->
    it("struct field access") do ->
      p = GPoint { x: 3, y: 4 }
      assert_eq(p.x + p.y, 7)
    end
    it("struct passed to function") do ->
      p = GPoint { x: 10, y: 20 }
      assert_eq(ge_sum_point(p), 30)
    end
    it("apply function with lambda") do ->
      dbl = (n: Int) -> n * 2
      assert_eq(ge_apply(dbl, 21), 42)
    end
    it("apply function with named function") do ->
      assert_eq(ge_apply(ge_double, 21), 42)
    end
    it("apply_twice pattern") do ->
      dbl = (n: Int) -> n * 2
      assert_eq(ge_apply_twice(dbl, 3), 12)
    end
    it("generic identity function") do ->
      assert_run_exits("def identity<T>(x: T): T = x\ndef main(): Int = identity(42)\n", 42)
    end
    it("generic function with multiple type params") do ->
      assert_run_exits("def pick_a<T, U>(a: T, b: U): T = a\ndef main(): Int = pick_a(7, 99)\n", 7)
    end
    it("generic function called with different types") do ->
      assert_run_exits("""
        def identity<T>(x: T): T = x
        def main(): Int
          a = identity(10)
          b = identity(32)
          return a + b
        end
        """, 42)
    end
    it("generic swap function") do ->
      assert_run_stdout_eq("""
        def gswap<T>(a: T, b: T): T = b
        def main(): Int
          puts(str_from_int(gswap(1, 2)))
          return 0
        end
        """, "2\n")
    end
  end
  return qspec_main()
end
def ge_sum_point(p: GPoint): Int = p.x + p.y
def ge_double(n: Int): Int = n * 2
def ge_apply(f: Fn(Int): Int, x: Int): Int = f(x)
def ge_apply_twice(f: Fn(Int): Int, x: Int): Int = f(f(x))
