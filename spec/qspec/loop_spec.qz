## Loop Keyword Tests
##
## Contract:
##   1. Basic loop: `loop ... break ... end` counted iteration.
##   2. Labeled: `loop ... break :label` exits named loop.
##   3. Continue: `loop ... continue` skips to next iteration.
##   4. Nested: inner break only breaks inner loop.
##   5. Immediate break: exits without executing body.
##   6. Search: loop as search pattern (break on condition).
import * from qspec

def main(): Int
  describe("loop keyword") do ->
    it("basic loop with counter and break") do ->
      assert_eq(loop_basic_break(), 5)
    end

    it("labeled loop with break") do ->
      assert_eq(loop_labeled_break(), 42)
    end

    it("loop with continue") do ->
      assert_eq(loop_with_continue(), 25)
    end

    it("nested loops") do ->
      assert_eq(loop_nested(), 9)
    end

    it("loop with immediate break exits immediately") do ->
      var x = 0
      loop
        x = 1
        break
      end
      assert_eq(x, 1)
    end

    it("loop counts to exactly N") do ->
      var count = 0
      loop
        count += 1
        if count == 100
          break
        end
      end
      assert_eq(count, 100)
    end

    it("loop accumulates sum") do ->
      var sum = 0
      var i = 0
      loop
        i = i + 1
        if i > 10
          break
        end
        sum = sum + i
      end
      assert_eq(sum, 55)
    end

    it("loop with continue skips even numbers") do ->
      var sum = 0
      var i = 0
      loop
        i = i + 1
        if i > 6
          break
        end
        if i % 2 == 0
          continue
        end
        sum = sum + i
      end
      ## 1 + 3 + 5 = 9
      assert_eq(sum, 9)
    end

    it("loop can be used to search for value") do ->
      var target = 7
      var found_at = -1
      var i = 0
      loop
        if i == target
          found_at = i
          break
        end
        i = i + 1
        if i > 100
          break
        end
      end
      assert_eq(found_at, 7)
    end

    it("nested loop with inner break only breaks inner") do ->
      var outer_count = 0
      var inner_total = 0
      var i = 0
      loop
        i = i + 1
        if i > 3
          break
        end
        outer_count = outer_count + 1
        var j = 0
        loop
          j += 1
          if j > 2
            break
          end
          inner_total = inner_total + 1
        end
      end
      assert_eq(outer_count, 3)
      assert_eq(inner_total, 6)
    end

    it("loop with multiple break conditions") do ->
      var i = 0
      var found_special = 0
      loop
        i = i + 1
        if i == 5
          found_special = 1
          break
        end
        if i > 100
          break
        end
      end
      assert_eq(found_special, 1)
      assert_eq(i, 5)
    end

    it("loop counter starts from arbitrary value") do ->
      var i = 50
      loop
        i = i + 1
        if i >= 55
          break
        end
      end
      assert_eq(i, 55)
    end

    it("labeled continue for nested loops") do ->
      assert_eq(loop_labeled_continue(), 3)
    end
    it("loop as expression with break VALUE") do ->
      assert_run_exits("""
        def main(): Int
          var i = 0
          var x = loop
            i = i + 1
            if i == 10
              break i * 4
            end
          end
          return x
        end
        """, 40)
    end
  end

  return qspec_main()
end

def loop_basic_break(): Int
  var i = 0
  loop
    i = i + 1
    if i == 5
      break
    end
  end
  return i
end

def loop_with_continue(): Int
  var sum = 0
  var i = 0
  loop
    i = i + 1
    if i > 10
      break
    end
    if i % 2 == 0
      continue
    end
    sum = sum + i
  end
  return sum
end

def loop_labeled_break(): Int
  var result = 0
  :outer loop
    var i = 0
    loop
      i = i + 1
      if i == 3
        result = 42
        break :outer
      end
    end
  end
  return result
end

def loop_nested(): Int
  var count = 0
  var i = 0
  loop
    i = i + 1
    if i > 3
      break
    end
    var j = 0
    loop
      j += 1
      if j > 3
        break
      end
      count += 1
    end
  end
  return count
end

def loop_labeled_continue(): Int
  var total = 0
  var outer_i = 0
  :outer loop
    outer_i = outer_i + 1
    if outer_i > 3
      break
    end
    var j = 0
    loop
      j += 1
      if j == 2
        continue :outer
      end
      total = total + j
      if j > 5
        break
      end
    end
  end
  return total
end

