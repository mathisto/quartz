## Import Order Tests - Verifies that import order doesn't affect resolution
##
## Contract:
##   1. AB order: import A then B works.
##   2. BA order: import B then A produces same result.
##   3. Wildcard first: wildcard before qualified resolves.
##   4. Qualified first: qualified before wildcard resolves.
##   5. Three modules: different import orders produce same result.
##   6. Four modules: all four imported in reverse order.
##   7. Mixed wildcards: multiple wildcard imports coexist.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("import order independence") do ->
    it("import A then B same as B then A") do ->
      var files: Vec = vec_new()
      files.push(as_int("mod_a.qz"))
      files.push(as_int("def a_val(): Int = 10"))
      files.push(as_int("mod_b.qz"))
      files.push(as_int("def b_val(): Int = 20"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mod_a
        import mod_b
        def main(): Int
          return mod_a::a_val() + mod_b::b_val()
        end
        """))
      assert_multi_run_exits(files, 2, 30)
    end

    it("import B then A same result") do ->
      var files: Vec = vec_new()
      files.push(as_int("mod_a.qz"))
      files.push(as_int("def a_val(): Int = 10"))
      files.push(as_int("mod_b.qz"))
      files.push(as_int("def b_val(): Int = 20"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mod_b
        import mod_a
        def main(): Int
          return mod_a::a_val() + mod_b::b_val()
        end
        """))
      assert_multi_run_exits(files, 2, 30)
    end

    it("wildcard before qualified") do ->
      var files: Vec = vec_new()
      files.push(as_int("wmod.qz"))
      files.push(as_int("def wfn(): Int = 5"))
      files.push(as_int("qmod.qz"))
      files.push(as_int("def qfn(): Int = 7"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from wmod
        import qmod
        def main(): Int
          return wfn() + qmod::qfn()
        end
        """))
      assert_multi_run_exits(files, 2, 12)
    end

    it("qualified before wildcard") do ->
      var files: Vec = vec_new()
      files.push(as_int("wmod.qz"))
      files.push(as_int("def wfn(): Int = 5"))
      files.push(as_int("qmod.qz"))
      files.push(as_int("def qfn(): Int = 7"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import qmod
        import * from wmod
        def main(): Int
          return wfn() + qmod::qfn()
        end
        """))
      assert_multi_run_exits(files, 2, 12)
    end

    it("three modules different orders") do ->
      var files: Vec = vec_new()
      files.push(as_int("x.qz"))
      files.push(as_int("def xv(): Int = 1"))
      files.push(as_int("y.qz"))
      files.push(as_int("def yv(): Int = 2"))
      files.push(as_int("z.qz"))
      files.push(as_int("def zv(): Int = 3"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import z
        import x
        import y
        def main(): Int
          return x::xv() + y::yv() + z::zv()
        end
        """))
      assert_multi_run_exits(files, 3, 6)
    end

    it("four modules imported in reverse order") do ->
      var files: Vec = vec_new()
      files.push(as_int("a.qz"))
      files.push(as_int("def av(): Int = 1"))
      files.push(as_int("b.qz"))
      files.push(as_int("def bv(): Int = 2"))
      files.push(as_int("c.qz"))
      files.push(as_int("def cv(): Int = 3"))
      files.push(as_int("d.qz"))
      files.push(as_int("def dv(): Int = 4"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import d
        import c
        import b
        import a
        def main(): Int
          return a::av() + b::bv() + c::cv() + d::dv()
        end
        """))
      assert_multi_run_exits(files, 4, 10)
    end

    it("multiple wildcard imports coexist") do ->
      var files: Vec = vec_new()
      files.push(as_int("w1.qz"))
      files.push(as_int("def w1_fn(): Int = 10"))
      files.push(as_int("w2.qz"))
      files.push(as_int("def w2_fn(): Int = 20"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from w2
        import * from w1
        def main(): Int
          return w1_fn() + w2_fn()
        end
        """))
      assert_multi_run_exits(files, 2, 30)
    end
  end

  return qspec_main()
end
