## Sync Primitive Tests — RWLock, WaitGroup, OnceCell

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("RWLock") do ->
    it("read lock returns value and unlock releases") do ->
      assert_run_exits(sp_rwlock_read_src(), 0)
    end
    it("write lock updates value") do ->
      assert_run_exits(sp_rwlock_write_src(), 0)
    end
    it("multiple concurrent readers succeed") do ->
      assert_run_exits(sp_rwlock_multi_read_src(), 0)
    end
  end

  describe("WaitGroup") do ->
    it("wait returns immediately when count is zero") do ->
      assert_run_exits(sp_wg_zero_src(), 0)
    end
    it("done decrements and wait blocks until zero") do ->
      assert_run_exits(sp_wg_basic_src(), 0)
    end
    it("multiple done calls from spawned threads") do ->
      assert_run_exits(sp_wg_multi_src(), 0)
    end
  end

  describe("OnceCell") do ->
    it("get_or_init runs initializer and returns value") do ->
      assert_run_exits(sp_once_init_src(), 0)
    end
    it("get_or_init on filled cell skips initializer") do ->
      assert_run_exits(sp_once_skip_src(), 0)
    end
    it("get after init returns cached value") do ->
      assert_run_exits(sp_once_get_after_init_src(), 0)
    end
  end

  return qspec_main()
end

def sp_rwlock_read_src(): String = """
  def main(): Int
    rw = rwlock_new(42)
    val = rwlock_read(rw)
    rwlock_read_unlock(rw)
    rwlock_free(rw)
    if val == 42
      return 0
    end
    return 1
  end
  """

def sp_rwlock_write_src(): String = """
  def main(): Int
    rw = rwlock_new(42)
    val = rwlock_write(rw)
    rwlock_write_unlock(rw, 99)
    val2 = rwlock_read(rw)
    rwlock_read_unlock(rw)
    rwlock_free(rw)
    if val == 42 and val2 == 99
      return 0
    end
    return 1
  end
  """

def sp_rwlock_multi_read_src(): String = """
  def reader(rw: Int): Int
    val = rwlock_read(rw)
    rwlock_read_unlock(rw)
    return val
  end
  def main(): Int
    rw = rwlock_new(42)
    h1 = go reader(rw)
    h2 = go reader(rw)
    h3 = go reader(rw)
    r1 = await h1
    r2 = await h2
    r3 = await h3
    rwlock_free(rw)
    if r1 == 42 and r2 == 42 and r3 == 42
      return 0
    end
    return 1
  end
  """

def sp_wg_zero_src(): String = """
  def main(): Int
    wg = waitgroup_new(0)
    waitgroup_wait(wg)
    waitgroup_free(wg)
    return 0
  end
  """

def sp_wg_basic_src(): String = """
  def worker(wg: Int, atom: Int): Int
    atomic_add(atom, 1)
    waitgroup_done(wg)
    return 0
  end
  def main(): Int
    wg = waitgroup_new(1)
    atom = atomic_new(0)
    h = go worker(wg, atom)
    waitgroup_wait(wg)
    result = atomic_load(atom)
    await h
    waitgroup_free(wg)
    if result == 1
      return 0
    end
    return 1
  end
  """

def sp_wg_multi_src(): String = """
  def worker(wg: Int, atom: Int): Int
    atomic_add(atom, 1)
    waitgroup_done(wg)
    return 0
  end
  def main(): Int
    wg = waitgroup_new(3)
    atom = atomic_new(0)
    h1 = go worker(wg, atom)
    h2 = go worker(wg, atom)
    h3 = go worker(wg, atom)
    waitgroup_wait(wg)
    result = atomic_load(atom)
    await h1
    await h2
    await h3
    waitgroup_free(wg)
    if result == 3
      return 0
    end
    return 1
  end
  """

def sp_once_init_src(): String = """
  def init_val(): Int = 42
  def main(): Int
    cell = oncecell_new()
    val = oncecell_get_or_init(cell, init_val)
    oncecell_free(cell)
    if val == 42
      return 0
    end
    return 1
  end
  """

def sp_once_skip_src(): String = """
  def init_first(): Int = 42
  def init_second(): Int = 99
  def main(): Int
    cell = oncecell_new()
    val1 = oncecell_get_or_init(cell, init_first)
    val2 = oncecell_get_or_init(cell, init_second)
    oncecell_free(cell)
    if val1 == 42 and val2 == 42
      return 0
    end
    return 1
  end
  """

def sp_once_get_after_init_src(): String = """
  def init_val(): Int = 42
  def main(): Int
    cell = oncecell_new()
    oncecell_get_or_init(cell, init_val)
    val = oncecell_get(cell)
    oncecell_free(cell)
    if val == 42
      return 0
    end
    return 1
  end
  """
