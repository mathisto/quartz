## Or-Pattern Tests — LF2.1
##
## Contract:
##   1. Integer or-patterns: `1 | 2 | 3 =>` matches any alternative.
##   2. String or-patterns: `"hello" | "hi" =>` matches either.
##   3. Bool or-patterns: `true | false =>` exhaustive.
##   4. Enum variant or-patterns: qualified and unqualified.
##   5. Or-pattern + wildcard: wildcard catches remainder.
##   6. Or-pattern + guard: guard filters matching alternatives.
##   7. Expression position: or-pattern in value-producing match.
##   8. Nested match: or-pattern in outer, any pattern in inner.
##   9. Multiple or-pattern arms: combinable in same match.
##  10. Exhaustive enum: or-patterns cover all variants.
##  11. Return in arm: or-pattern arm with return statement.
import * from qspec

enum Color
  Red
  Green
  Blue
  Yellow
end

enum Shape
  Circle
  Square
  Triangle
end

def classify_int(x: Int): String
  return match x
    1 | 2 | 3 => "small"
    4 | 5 => "medium"
    _ => "large"
  end
end

def classify_five(x: Int): String
  return match x
    1 | 2 | 3 | 4 | 5 => "one-to-five"
    _ => "other"
  end
end

def classify_string(s: String): String
  return match s
    "hello" | "hi" => "greeting"
    _ => "other"
  end
end

def classify_bool(b: Bool): String
  return match b
    true | false => "boolean"
  end
end

def classify_color(c: Color): String
  return match c
    Color::Red | Color::Blue => "primary"
    Color::Green => "secondary"
    _ => "other"
  end
end

def classify_color_unqual(c: Color): String
  return match c
    Red | Blue => "primary"
    Green => "secondary"
    _ => "other"
  end
end

def or_with_wildcard(x: Int): String
  return match x
    1 | 2 => "small"
    _ => "rest"
  end
end

def or_with_guard(x: Int): String
  return match x
    1 | 2 | 3 if x < 3 => "small-filtered"
    1 | 2 | 3 => "small-unfiltered"
    _ => "large"
  end
end

def or_expr_position(x: Int): Int
  var r = match x
    1 | 2 => 10
    3 | 4 => 20
    _ => 30
  end
  return r
end

def or_nested_match(x: Int, y: Int): String
  return match x
    1 | 2 => match y
      10 | 20 => "inner-match"
      _ => "inner-other"
    end
    _ => "outer-other"
  end
end

def or_multiple_arms(x: Int): String
  return match x
    1 | 2 => "first-group"
    3 | 4 => "second-group"
    5 => "five"
    _ => "other"
  end
end

def or_exhaustive_enum(c: Color): String
  return match c
    Red | Blue => "rb"
    Green | Yellow => "gy"
  end
end

def or_single_value(x: Int): String
  return match x
    1 => "one"
    _ => "other"
  end
end

def or_mixed_arms(x: Int): String
  return match x
    1 | 2 => "or-arm"
    3 => "normal-arm"
    _ => "wildcard"
  end
end

def or_return_in_arm(x: Int): Int
  match x
    1 | 2 => return 42
    _ => return 0
  end
  return -1
end

# Named helper functions for assert_output
def print_or_int_1(): Void = puts("#{classify_int(1)}")
def print_or_int_2(): Void = puts("#{classify_int(2)}")
def print_or_int_3(): Void = puts("#{classify_int(3)}")
def print_or_int_4(): Void = puts("#{classify_int(4)}")
def print_or_int_9(): Void = puts("#{classify_int(9)}")
def print_or_five_3(): Void = puts("#{classify_five(3)}")
def print_or_five_7(): Void = puts("#{classify_five(7)}")
def print_str_hello(): Void
  var s = classify_string("hello")
  puts(s)
end
def print_str_hi(): Void
  var s = classify_string("hi")
  puts(s)
end
def print_str_bye(): Void
  var s = classify_string("bye")
  puts(s)
end
def print_bool_true(): Void = puts("#{classify_bool(true)}")
def print_color_red(): Void = puts("#{classify_color(Color::Red)}")
def print_color_blue(): Void = puts("#{classify_color(Color::Blue)}")
def print_color_green(): Void = puts("#{classify_color(Color::Green)}")
def print_color_yellow(): Void = puts("#{classify_color(Color::Yellow)}")
def print_color_unqual_red(): Void = puts("#{classify_color_unqual(Color::Red)}")
def print_wildcard(): Void = puts("#{or_with_wildcard(1)}")
def print_guard_1(): Void = puts("#{or_with_guard(1)}")
def print_guard_3(): Void = puts("#{or_with_guard(3)}")
def print_guard_9(): Void = puts("#{or_with_guard(9)}")
def print_expr_1(): Void = puts("#{or_expr_position(1)}")
def print_expr_3(): Void = puts("#{or_expr_position(3)}")
def print_nested(): Void = puts("#{or_nested_match(1, 10)}")
def print_multi_1(): Void = puts("#{or_multiple_arms(1)}")
def print_multi_3(): Void = puts("#{or_multiple_arms(3)}")
def print_exhaustive_red(): Void = puts("#{or_exhaustive_enum(Color::Red)}")
def print_exhaustive_green(): Void = puts("#{or_exhaustive_enum(Color::Green)}")
def print_single(): Void = puts("#{or_single_value(1)}")
def print_mixed_1(): Void = puts("#{or_mixed_arms(1)}")
def print_mixed_3(): Void = puts("#{or_mixed_arms(3)}")
def print_mixed_9(): Void = puts("#{or_mixed_arms(9)}")
def print_return_1(): Void = puts("#{or_return_in_arm(1)}")
def print_return_9(): Void = puts("#{or_return_in_arm(9)}")

def main(): Int
  describe("or-patterns") do ->
    # Integer or-patterns
    it("matches first alternative") do ->
      assert_output("small\n", print_or_int_1)
    end
    it("matches second alternative") do ->
      assert_output("small\n", print_or_int_2)
    end
    it("matches third alternative") do ->
      assert_output("small\n", print_or_int_3)
    end
    it("falls through to next arm") do ->
      assert_output("medium\n", print_or_int_4)
    end
    it("falls through to wildcard") do ->
      assert_output("large\n", print_or_int_9)
    end

    # Many alternatives
    it("five alternatives") do ->
      assert_output("one-to-five\n", print_or_five_3)
    end
    it("five alternatives fallthrough") do ->
      assert_output("other\n", print_or_five_7)
    end

    # String or-patterns
    it("string match first") do ->
      assert_output("greeting\n", print_str_hello)
    end
    it("string match second") do ->
      assert_output("greeting\n", print_str_hi)
    end
    it("string fallthrough") do ->
      assert_output("other\n", print_str_bye)
    end

    # Bool or-pattern
    it("bool or-pattern") do ->
      assert_output("boolean\n", print_bool_true)
    end

    # Enum variant or-patterns (qualified)
    it("enum first variant") do ->
      assert_output("primary\n", print_color_red)
    end
    it("enum second variant") do ->
      assert_output("primary\n", print_color_blue)
    end
    it("enum non-or arm") do ->
      assert_output("secondary\n", print_color_green)
    end
    it("enum wildcard fallthrough") do ->
      assert_output("other\n", print_color_yellow)
    end

    # Unqualified enum variants
    it("unqualified enum or-pattern") do ->
      assert_output("primary\n", print_color_unqual_red)
    end

    # Or-pattern + wildcard arm
    it("or-pattern before wildcard") do ->
      assert_output("small\n", print_wildcard)
    end

    # Or-pattern + guard
    it("guard passes") do ->
      assert_output("small-filtered\n", print_guard_1)
    end
    it("guard fails falls to next") do ->
      assert_output("small-unfiltered\n", print_guard_3)
    end
    it("guard arm skipped") do ->
      assert_output("large\n", print_guard_9)
    end

    # Expression position
    it("expr position first") do ->
      assert_output("10\n", print_expr_1)
    end
    it("expr position second") do ->
      assert_output("20\n", print_expr_3)
    end

    # Nested match
    it("nested match with or-patterns") do ->
      assert_output("inner-match\n", print_nested)
    end

    # Multiple or-pattern arms
    it("multiple or arms first") do ->
      assert_output("first-group\n", print_multi_1)
    end
    it("multiple or arms second") do ->
      assert_output("second-group\n", print_multi_3)
    end

    # Exhaustiveness with or-patterns
    it("exhaustive red") do ->
      assert_output("rb\n", print_exhaustive_red)
    end
    it("exhaustive green") do ->
      assert_output("gy\n", print_exhaustive_green)
    end

    # Single-value regression
    it("single value still works") do ->
      assert_output("one\n", print_single)
    end

    # Mixed arm types
    it("mixed or-arm") do ->
      assert_output("or-arm\n", print_mixed_1)
    end
    it("mixed normal arm") do ->
      assert_output("normal-arm\n", print_mixed_3)
    end
    it("mixed wildcard") do ->
      assert_output("wildcard\n", print_mixed_9)
    end

    # Return in or-pattern arm
    it("return from or-pattern") do ->
      assert_output("42\n", print_return_1)
    end
    it("return from wildcard") do ->
      assert_output("0\n", print_return_9)
    end
  end

  return qspec_main()
end
