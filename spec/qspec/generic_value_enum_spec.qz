## Generic-over-@value enum payloads — B.10 §12.10
##
## Validates that an enum payload of a @value-layout type carries the value
## INLINE in the enum's payload area (single indirection), instead of storing a
## pointer to a heap/stack-boxed value (double indirection).
##
## Contract (correctness — holds on both the boxed and the inline path; the
## inline-ness itself is verified separately via IR inspection, mirroring how
## generic_value_struct_spec checks §12.9):
##   1. Option<@value P>: Some construct + match-bind + field read.
##   2. Option<@value P>: None arm.
##   3. Result<@value P, E>: Ok and Err arms, field read on the @value payload.
##   4. Nested Option<Option<@value P>>.
##   5. Boxed payloads unchanged: Option<Int>, Option<String> still correct.
##
## Until §12.10 lands, every assertion below ALSO passes on the boxed path
## (boxing yields correct values, just slowly) — this spec is the correctness
## regression net that must stay green across the de-boxing change.

import * from qspec

@value
struct GVEPoint
  x: Int
  y: Int
end

# 14C — a 3-field (>16B) @value struct is COW-layout: its buffer carries a
# refcount header at word 0 with the fields at words 1..N. The fc<=2 GVEPoint
# above is a flat header-less inline struct, so it coincidentally read correctly
# even before 14C. This 3-field struct exercises the construct-side header skip:
# the enum payload must copy FIELD words (1,2,3), not buffer words (0,1,2), or
# every field shifts by one (doc.a reads the tag, the last field is dropped).
@value
struct GVEDoc
  a: Int
  b: Int
  c: Int
end

struct GVEBoxed
  a: Int
  b: Int
end

struct GVEBoxed3
  a: Int
  b: Int
  c: Int
end

# === Option<@value P> — Some/None ===

def gve_opt_some_x(): Int
  o: Option<GVEPoint> = Option::Some(GVEPoint { x: 11, y: 22 })
  match o
    Option::Some(p) => return p.x
    Option::None => return -1
  end
end

def gve_opt_some_sum(): Int
  o: Option<GVEPoint> = Option::Some(GVEPoint { x: 100, y: 250 })
  match o
    Option::Some(p) => return p.x + p.y
    Option::None => return -1
  end
end

def gve_opt_none(): Int
  o: Option<GVEPoint> = Option::None
  match o
    Option::Some(p) => return p.x + p.y
    Option::None => return 777
  end
end

# === Result<@value P, E> — Ok/Err, @value payload on the Ok side ===

def gve_result_ok_sum(): Int
  r: Result<GVEPoint, Int> = Result::Ok(GVEPoint { x: 3, y: 4 })
  match r
    Result::Ok(p) => return p.x + p.y
    Result::Err(e) => return -1
  end
end

def gve_result_err(): Int
  r: Result<GVEPoint, Int> = Result::Err(99)
  match r
    Result::Ok(p) => return p.x + p.y
    Result::Err(e) => return e
  end
end

# === Nested Option<Option<@value P>> ===

def gve_extract_inner(mid: Option<GVEPoint>): Int
  match mid
    Option::Some(p) => return p.x + p.y
    Option::None => return -2
  end
end

def gve_opt_nested(): Int
  inner: Option<GVEPoint> = Option::Some(GVEPoint { x: 5, y: 6 })
  o: Option<Option<GVEPoint>> = Option::Some(inner)
  match o
    Option::Some(mid) => return gve_extract_inner(mid)
    Option::None => return -1
  end
end

# === Boxed payloads unchanged ===

def gve_opt_int(): Int
  o: Option<Int> = Option::Some(42)
  match o
    Option::Some(v) => return v
    Option::None => return -1
  end
end

def gve_print_opt_string(): Void
  o: Option<String> = Option::Some("hello")
  match o
    Option::Some(s) => puts(s)
    Option::None => puts("none")
  end
end

# === Boxed (non-@value) struct payload still boxes correctly ===

def gve_opt_boxed_struct(): Int
  o: Option<GVEBoxed> = Option::Some(GVEBoxed { a: 30, b: 300 })
  match o
    Option::Some(s) => return s.a + s.b
    Option::None => return -1
  end
end

# === if-let `if Some(p) = o` over an inline @value payload ===
def gve_iflet_some(): Int
  o: Option<GVEPoint> = Option::Some(GVEPoint { x: 8, y: 9 })
  if Option::Some(p) = o
    return p.x + p.y
  end
  return -1
end

# === is-check `if o is Some(p)` over an inline @value payload ===
def gve_is_some(): Int
  o: Option<GVEPoint> = Option::Some(GVEPoint { x: 40, y: 2 })
  if o is Some(p)
    return p.x + p.y
  end
  return -1
end

# === 14C — Result/Option<@value fc=3 (COW-layout) P> field reads ===

def gve_result_doc_fields(): Int
  r: Result<GVEDoc, String> = Result::Ok(GVEDoc { a: 11, b: 22, c: 33 })
  match r
    Result::Ok(doc) => return doc.a * 10000 + doc.b * 100 + doc.c
    Result::Err(e) => return -1
  end
end

def gve_option_doc_fields(): Int
  o: Option<GVEDoc> = Option::Some(GVEDoc { a: 44, b: 55, c: 66 })
  match o
    Option::Some(doc) => return doc.a * 10000 + doc.b * 100 + doc.c
    Option::None => return -1
  end
end

# Over-fire guard: a boxed (non-@value) fc=3 payload must still box (one word per
# field), NOT route through the 14C inline header-skip. Built via fn-return so the
# Result carries its ambient type the same way the @value cases above do.
def gve_mk_boxed3(): Result<GVEBoxed3, String>
  return Result::Ok(GVEBoxed3 { a: 1, b: 2, c: 3 })
end

def gve_result_boxed3_fields(): Int
  match gve_mk_boxed3()
    Result::Ok(s) => return s.a * 100 + s.b * 10 + s.c
    Result::Err(e) => return -1
  end
end

# item 42 — de-erased Result/Option combinators over value-layout payloads.
# The erased prelude combinators read the Ok/Some payload slot as a boxed pointer;
# for an inline @value payload the slot holds field words ⇒ SIGSEGV. These helpers
# exercise the call-site interception (Part 1), the unwrap_ok intercept (Part 2),
# and the consumer U-inference (Part 3) for BOTH ≤16B (GVEPoint) and >16B COW
# (GVEDoc) payloads. Pre-item42 these SIGSEGV at gate 0; gate-0-inert (no @value
# Result/Option payload exists in the compiler/std ⇒ byte-identical self-host).
def gve_ok_point(n: Int): Result<GVEPoint, Int> = Result::Ok(GVEPoint { x: n, y: n + 1 })
def gve_map_point(p: GVEPoint): GVEPoint = GVEPoint { x: p.x * 10, y: p.y * 10 }
def gve_combinator_map_unwrap(): Int
  var r = result_map(gve_ok_point(3), gve_map_point)
  var u = unwrap_ok(r)
  return u.x + u.y
end

def gve_ok_doc(): Result<GVEDoc, Int> = Result::Ok(GVEDoc { a: 1, b: 2, c: 3 })
def gve_map_doc(d: GVEDoc): GVEDoc = GVEDoc { a: d.a + 10, b: d.b + 20, c: d.c + 30 }
def gve_combinator_map_unwrap_cow(): Int
  var r = result_map(gve_ok_doc(), gve_map_doc)
  var u = unwrap_ok(r)
  return u.a * 100 + u.b * 10 + u.c
end

def gve_unwrap_ok_literal(): Int
  var r: Result<GVEPoint, Int> = Result::Ok(GVEPoint { x: 8, y: 9 })
  var u = unwrap_ok(r)
  return u.x * 100 + u.y
end

def gve_chain_point(p: GVEPoint): Result<GVEPoint, Int> = Result::Ok(GVEPoint { x: p.x + 5, y: p.y + 5 })
def gve_combinator_and_then(): Int
  var r = result_and_then(gve_ok_point(2), gve_chain_point)
  var u = unwrap_ok(r)
  return u.x * 100 + u.y
end

def gve_some_point(n: Int): Option<GVEPoint> = Option::Some(GVEPoint { x: n, y: n * 2 })
def gve_omap_point(p: GVEPoint): GVEPoint = GVEPoint { x: p.x + 100, y: p.y + 200 }
def gve_unwrap_opt_point(o: Option<GVEPoint>): Int
  match o
    Option::Some(p) => return p.x * 1000 + p.y
    Option::None => return -1
  end
end
def gve_combinator_option_map(): Int
  var o = option_map(gve_some_point(4), gve_omap_point)
  return gve_unwrap_opt_point(o)
end

# item 42b — de-erased UNWRAP-WITH-FALLBACK combinators over value-layout payloads.
# unwrap_or_ok/result_or (Result) and unwrap_or/option_or (Option) return the bare Ok/
# Some payload `T` on the present branch, else the `fallback` (also `T`). The erased
# prelude bodies read the present payload via the BOXED spill layout — for an inline
# @value payload the slot holds field words ⇒ the consumer deref's a field VALUE as a
# pointer ⇒ SIGSEGV (the gate-1 result_niche crash). The item-42b intercept selects the
# FLAT interior address (`box+8`) on the present branch and the FLAT fallback (skip the
# COW header for >16B) on the else branch. Both branches + ≤16B (GVEPoint) + >16B COW
# (GVEDoc). Pre-item42b these SIGSEGV at gate 0; gate-0-inert (no @value Result/Option
# payload exists in the compiler/std ⇒ byte-identical self-host).

# unwrap_or_ok (Result) — Ok / Err branches, ≤16B + >16B
def gve_uoo_ok_point(): Int
  var u = unwrap_or_ok(gve_ok_point(7), GVEPoint { x: -1, y: -1 })
  return u.x * 100 + u.y
end
def gve_uoo_err_point(): Int
  var r: Result<GVEPoint, Int> = Result::Err(99)
  var u = unwrap_or_ok(r, GVEPoint { x: 5, y: 6 })
  return u.x * 100 + u.y
end
def gve_uoo_ok_doc(): Int
  var u = unwrap_or_ok(gve_ok_doc(), GVEDoc { a: -1, b: -1, c: -1 })
  return u.a * 10000 + u.b * 100 + u.c
end
def gve_uoo_err_doc(): Int
  var r: Result<GVEDoc, Int> = Result::Err(7)
  var u = unwrap_or_ok(r, GVEDoc { a: 4, b: 5, c: 6 })
  return u.a * 10000 + u.b * 100 + u.c
end

# result_or (Result alias) — Ok ≤16B, Err fallback >16B
def gve_ror_ok_point(): Int
  var u = result_or(gve_ok_point(8), GVEPoint { x: -1, y: -1 })
  return u.x * 100 + u.y
end
def gve_ror_err_doc(): Int
  var r: Result<GVEDoc, Int> = Result::Err(1)
  var u = result_or(r, GVEDoc { a: 1, b: 1, c: 1 })
  return u.a * 10000 + u.b * 100 + u.c
end

# unwrap_or (Option) — Some / None, ≤16B + >16B
def gve_some_doc(n: Int): Option<GVEDoc> = Option::Some(GVEDoc { a: n, b: n + 1, c: n + 2 })
def gve_uor_some_point(): Int
  var u = unwrap_or(gve_some_point(20), GVEPoint { x: -1, y: -1 })
  return u.x * 1000 + u.y
end
def gve_uor_none_point(): Int
  var o: Option<GVEPoint> = Option::None
  var u = unwrap_or(o, GVEPoint { x: 7, y: 8 })
  return u.x * 100 + u.y
end
def gve_uor_some_doc(): Int
  var u = unwrap_or(gve_some_doc(2), GVEDoc { a: -1, b: -1, c: -1 })
  return u.a * 10000 + u.b * 100 + u.c
end
def gve_uor_none_doc(): Int
  var o: Option<GVEDoc> = Option::None
  var u = unwrap_or(o, GVEDoc { a: 9, b: 8, c: 7 })
  return u.a * 10000 + u.b * 100 + u.c
end

# option_or (Option alias) — Some >16B, None fallback ≤16B
def gve_oor_some_doc(): Int
  var u = option_or(gve_some_doc(5), GVEDoc { a: -1, b: -1, c: -1 })
  return u.a * 10000 + u.b * 100 + u.c
end
def gve_oor_none_point(): Int
  var o: Option<GVEPoint> = Option::None
  var u = option_or(o, GVEPoint { x: 3, y: 4 })
  return u.x * 100 + u.y
end

# item 42b — ok()/err() CONVERSION over a value-layout payload. ok(): Result<@value,E>
# → Option<@value>; err(): Result<T,@value> → Option<@value>. The erased body dropped
# every field but the first (audit miscompile 1000/10000); the conversion intercept
# inline-embeds the FLAT payload words into the produced Option box.
def gve_ok_conv_le16(): Int
  var o = ok(gve_ok_point(10))
  match o
    Option::Some(p) => return p.x * 100 + p.y
    Option::None => return -1
  end
end
def gve_ok_conv_cow(): Int
  var o = ok(gve_ok_doc())
  match o
    Option::Some(d) => return d.a * 10000 + d.b * 100 + d.c
    Option::None => return -1
  end
end
def gve_ok_conv_none(): Int
  var r: Result<GVEPoint, Int> = Result::Err(5)
  var o = ok(r)
  match o
    Option::Some(p) => return p.x
    Option::None => return 777
  end
end
@value
struct GVEErr2
  code: Int
  sev: Int
end
def gve_mk_err2(): Result<Int, GVEErr2> = Result::Err(GVEErr2 { code: 42, sev: 9 })
def gve_mk_ok2(): Result<Int, GVEErr2> = Result::Ok(100)
def gve_err_conv_le16(): Int
  var o = err(gve_mk_err2())
  match o
    Option::Some(e) => return e.code * 100 + e.sev
    Option::None => return -1
  end
end
def gve_err_conv_none(): Int
  var o = err(gve_mk_ok2())
  match o
    Option::Some(e) => return e.code
    Option::None => return 777
  end
end

# item 42c — the `try`/`?` OPERATOR over a value-layout payload. `var inner = try r`
# extracts the Ok/Some payload (early-returning Err/None otherwise). The try desugar
# is lowered SEPARATELY from match-arms (mir_lower_try, NODE_TRY_EXPR), so item 40's
# match-arm value-layout-awareness did NOT cover it: the legacy spill extract bound
# the INLINE field word as a payload POINTER ⇒ `inner.a` deref'd a field VALUE ⇒
# SIGSEGV (the gate-1 result_niche try_double crash). The fix returns the INTERIOR
# ADDRESS `box+8` on the Ok/Some arm (arena-marked at the bind site so field reads
# stay flat offset+0), for BOTH ≤16B (GVEPoint) and >16B COW (GVEDoc). The Err/None
# early-return carries the value-layout carrier through unchanged. Pre-item42c these
# SIGSEGV at gate 0; gate-0-inert (no @value Result/Option payload exists in the
# compiler/std ⇒ byte-identical self-host).

# Result `?` — Ok-propagate, ≤16B
def gve_try_ok_point(r: Result<GVEPoint, Int>): Result<GVEPoint, Int>
  var inner = try r
  return Result::Ok(GVEPoint { x: inner.x * 2, y: inner.y * 2 })
end
def gve_try_ok_point_run(): Int
  var out = gve_try_ok_point(gve_ok_point(7))
  var u = unwrap_ok(out)
  return u.x * 100 + u.y
end

# Result `?` — Err short-circuit (value-layout Err payload propagates unchanged), ≤16B.
# The Err carrier (a spill Result with the @value GVEErr2 fields inlined) is propagated
# verbatim by the try early-return; read it back via a match arm (item-40 covered) to
# assert the inlined Err fields survived the short-circuit.
def gve_try_err_short(r: Result<Int, GVEErr2>): Result<Int, GVEErr2>
  var inner = try r
  return Result::Ok(inner + 1)
end
def gve_try_err_short_run(): Int
  var out = gve_try_err_short(gve_mk_err2())
  match out
    Result::Ok(v) => return -1
    Result::Err(e) => return e.code * 100 + e.sev
  end
end

# Result `?` — Ok-propagate, >16B COW
def gve_try_ok_doc(r: Result<GVEDoc, Int>): Result<GVEDoc, Int>
  var inner = try r
  return Result::Ok(GVEDoc { a: inner.a + 10, b: inner.b + 20, c: inner.c + 30 })
end
def gve_try_ok_doc_run(): Int
  var out = gve_try_ok_doc(gve_ok_doc())
  var u = unwrap_ok(out)
  return u.a * 10000 + u.b * 100 + u.c
end

# Option `?` — Some-propagate, ≤16B
def gve_try_some_point(o: Option<GVEPoint>): Option<GVEPoint>
  var inner = try o
  return Option::Some(GVEPoint { x: inner.x + 1, y: inner.y + 1 })
end
def gve_try_some_point_run(): Int
  var out = gve_try_some_point(gve_some_point(5))
  match out
    Option::Some(p) => return p.x * 1000 + p.y
    Option::None => return -1
  end
end

# Option `?` — Some-propagate, >16B COW
def gve_try_some_doc(o: Option<GVEDoc>): Option<GVEDoc>
  var inner = try o
  return Option::Some(GVEDoc { a: inner.a + 1, b: inner.b + 1, c: inner.c + 1 })
end
def gve_try_some_doc_run(): Int
  var out = gve_try_some_doc(gve_some_doc(2))
  match out
    Option::Some(d) => return d.a * 10000 + d.b * 100 + d.c
    Option::None => return -1
  end
end

# item 42d — unwrap_err over a value-layout ERR payload (`Result<T, @value>`). The
# item-42 Part-2 unwrap_ok/unwrap_err intercept gated BOTH sides on the Ok-side
# predicate, so `unwrap_err` over a `Result<scalar, @value>` read the inline Err field
# word as a boxed pointer ⇒ the item-23 SIGSEGV. The fix selects the Err-side predicate
# (mir_result_subject_err_is_inline_value) + the Err payload type for `unwrap_err`,
# returning the Err payload's INTERIOR address `box+8` (FLAT for both ≤16B and >16B).
# ≤16B uses GVEErr2 (gve_mk_err2 above); >16B uses GVEErr3 (COW-layout) below.
@value
struct GVEErr3
  code: Int
  sev: Int
  ctx: Int
end
def gve_mk_err3(): Result<Int, GVEErr3> = Result::Err(GVEErr3 { code: 7, sev: 8, ctx: 9 })
def gve_unwrap_err_le16(): Int
  var e = unwrap_err(gve_mk_err2())
  return e.code * 100 + e.sev
end
def gve_unwrap_err_cow(): Int
  var e = unwrap_err(gve_mk_err3())
  return e.code * 10000 + e.sev * 100 + e.ctx
end

# item 42e — flow-narrowing field-access (`if r is Ok; r.a`) over a value-layout payload.
# `if r is Ok` keeps the narrow stamp on the field-access base `r` (it does not flow
# whole into a wide slot), so the narrowed read fires; the spill `load box[word1]` reads
# the first INLINE FIELD VALUE which the field-access consumer deref'd as a pointer ⇒
# SIGSEGV. The fix returns the INTERIOR address `box+8` from mir_emit_narrowed_read for
# a value-layout Ok/Some payload, so `r.a` reads the field flat (offset+0), ≤16B + >16B.
def gve_narrow_field_point(): Int
  var r: Result<GVEPoint, Int> = Result::Ok(GVEPoint { x: 7, y: 9 })
  if r is Ok
    return r.x * 100 + r.y
  end
  return -1
end
def gve_narrow_field_doc(): Int
  var r: Result<GVEDoc, Int> = Result::Ok(GVEDoc { a: 4, b: 5, c: 6 })
  if r is Ok
    return r.a * 10000 + r.b * 100 + r.c
  end
  return -1
end
def gve_narrow_field_some_point(): Int
  var o: Option<GVEPoint> = Option::Some(GVEPoint { x: 3, y: 8 })
  if o is Some
    return o.x * 100 + o.y
  end
  return -1
end
def gve_narrow_field_some_doc(): Int
  var o: Option<GVEDoc> = Option::Some(GVEDoc { a: 1, b: 2, c: 3 })
  if o is Some
    return o.a * 10000 + o.b * 100 + o.c
  end
  return -1
end

# item 42f — result_map_err over a value-layout ERR payload, plus value-layout Err
# PROPAGATION through result_map / result_and_then. The item-42 combinator intercept
# only mapped the Ok side; result_map_err maps the ERR payload — the erased
# `Result::Err(f(e))` body read the inline Err field word as a boxed pointer ⇒ `e.b`
# deref'd a field VALUE ⇒ SIGSEGV (the gate-1 result_niche box_map_err crash). The fix
# reads the Err payload at the interior address box+8, calls f, and inline-embeds the
# value-layout output F in the new Err box; the Ok arm passes the box through. The
# consumer U-inference is extended (Part 3) to refine result_map_err's erased
# `Result<T,F>` to the concrete F AND to carry a value-layout Err propagated through
# result_map/result_and_then whose Ok output is scalar. Pre-item42f these SIGSEGV at
# gate 0; gate-0-inert (no @value Result Err payload exists in the compiler/std ⇒
# byte-identical self-host). ≤16B uses GVEErr2; >16B COW uses GVEErr3 (both above).
@value
struct GVEMapped
  m: Int
end
@value
struct GVEMapped3
  m: Int
  n: Int
  o: Int
end
def gve_mk_err_p(n: Int): Result<Int, GVEErr2> = Result::Err(GVEErr2 { code: n, sev: n + 1 })
def gve_map_err_fn(e: GVEErr2): GVEMapped = GVEMapped { m: e.code * 100 + e.sev }
# result_map_err over an Err (≤16B): maps the @value Err payload to a new @value Err.
def gve_map_err_le16(): Int
  var r = result_map_err(gve_mk_err_p(5), gve_map_err_fn)
  match r
    Result::Ok(v) => return -1
    Result::Err(me) => return me.m
  end
end
# result_map_err over an Ok: the Ok payload passes through unchanged.
def gve_map_err_ok_passthrough(): Int
  var r = result_map_err(gve_mk_ok2(), gve_map_err_fn)
  match r
    Result::Ok(v) => return v
    Result::Err(me) => return -1
  end
end
# result_map_err over an Err (>16B COW): maps GVEErr3 → GVEMapped3.
def gve_mk_err3_p(n: Int): Result<Int, GVEErr3> = Result::Err(GVEErr3 { code: n, sev: n + 1, ctx: n + 2 })
def gve_map_err_fn3(e: GVEErr3): GVEMapped3 = GVEMapped3 { m: e.code * 10, n: e.sev, o: e.ctx }
def gve_map_err_cow(): Int
  var r = result_map_err(gve_mk_err3_p(3), gve_map_err_fn3)
  match r
    Result::Ok(v) => return -1
    Result::Err(me) => return me.m * 10000 + me.n * 100 + me.o
  end
end
# result_map propagating a value-layout Err unchanged (Ok scalar mapped, Err @value).
def gve_ok_inc(x: Int): Int = x + 1
def gve_map_propagate_err(): Int
  var r = result_map(gve_mk_err_p(9), gve_ok_inc)
  match r
    Result::Ok(v) => return -1
    Result::Err(e) => return e.code * 100 + e.sev
  end
end
# result_and_then propagating a value-layout Err unchanged.
def gve_chain_ok(x: Int): Result<Int, GVEErr2> = Result::Ok(x * 2)
def gve_and_then_propagate_err(): Int
  var r = result_and_then(gve_mk_err_p(4), gve_chain_ok)
  match r
    Result::Ok(v) => return -1
    Result::Err(e) => return e.code * 100 + e.sev
  end
end

def main(): Int
  describe("item 42f — result_map_err / Err-propagation over @value Err payload") do ->
    it("result_map_err maps the @value Err payload (≤16B)") do ->
      assert_eq(gve_map_err_le16(), 506)
    end
    it("result_map_err Ok arm passes the Ok payload through") do ->
      assert_eq(gve_map_err_ok_passthrough(), 100)
    end
    it("result_map_err maps the @value Err payload (>16B COW)") do ->
      assert_eq(gve_map_err_cow(), 300405)
    end
    it("result_map propagates a value-layout Err unchanged") do ->
      assert_eq(gve_map_propagate_err(), 910)
    end
    it("result_and_then propagates a value-layout Err unchanged") do ->
      assert_eq(gve_and_then_propagate_err(), 405)
    end
  end

  describe("item 42d — unwrap_err over @value Err payload") do ->
    it("unwrap_err extracts the @value Err payload (≤16B)") do ->
      assert_eq(gve_unwrap_err_le16(), 4209)
    end
    it("unwrap_err extracts the @value Err payload (>16B COW)") do ->
      assert_eq(gve_unwrap_err_cow(), 70809)
    end
  end

  describe("item 42e — flow-narrowed field-access over @value payload") do ->
    it("`if r is Ok; r.a` reads the @value Ok field (≤16B)") do ->
      assert_eq(gve_narrow_field_point(), 709)
    end
    it("`if r is Ok; r.a` reads the @value Ok fields (>16B COW)") do ->
      assert_eq(gve_narrow_field_doc(), 40506)
    end
    it("`if o is Some; o.a` reads the @value Some field (≤16B)") do ->
      assert_eq(gve_narrow_field_some_point(), 308)
    end
    it("`if o is Some; o.a` reads the @value Some fields (>16B COW)") do ->
      assert_eq(gve_narrow_field_some_doc(), 10203)
    end
  end

  describe("item 42b — unwrap-with-fallback over @value payload") do ->
    it("unwrap_or_ok Ok branch (≤16B)") do ->
      assert_eq(gve_uoo_ok_point(), 708)
    end
    it("unwrap_or_ok Err branch returns fallback (≤16B)") do ->
      assert_eq(gve_uoo_err_point(), 506)
    end
    it("unwrap_or_ok Ok branch (>16B COW)") do ->
      assert_eq(gve_uoo_ok_doc(), 10203)
    end
    it("unwrap_or_ok Err branch returns fallback (>16B COW)") do ->
      assert_eq(gve_uoo_err_doc(), 40506)
    end
    it("result_or Ok branch (≤16B)") do ->
      assert_eq(gve_ror_ok_point(), 809)
    end
    it("result_or Err branch returns fallback (>16B COW)") do ->
      assert_eq(gve_ror_err_doc(), 10101)
    end
    it("unwrap_or Some branch (≤16B)") do ->
      assert_eq(gve_uor_some_point(), 20040)
    end
    it("unwrap_or None branch returns fallback (≤16B)") do ->
      assert_eq(gve_uor_none_point(), 708)
    end
    it("unwrap_or Some branch (>16B COW)") do ->
      assert_eq(gve_uor_some_doc(), 20304)
    end
    it("unwrap_or None branch returns fallback (>16B COW)") do ->
      assert_eq(gve_uor_none_doc(), 90807)
    end
    it("option_or Some branch (>16B COW)") do ->
      assert_eq(gve_oor_some_doc(), 50607)
    end
    it("option_or None branch returns fallback (≤16B)") do ->
      assert_eq(gve_oor_none_point(), 304)
    end
    it("ok() conversion present arm (≤16B)") do ->
      assert_eq(gve_ok_conv_le16(), 1011)
    end
    it("ok() conversion present arm (>16B COW)") do ->
      assert_eq(gve_ok_conv_cow(), 10203)
    end
    it("ok() conversion None arm (Err input)") do ->
      assert_eq(gve_ok_conv_none(), 777)
    end
    it("err() conversion present arm (≤16B)") do ->
      assert_eq(gve_err_conv_le16(), 4209)
    end
    it("err() conversion None arm (Ok input)") do ->
      assert_eq(gve_err_conv_none(), 777)
    end
  end

  describe("item 42c — try/? operator over @value payload") do ->
    it("Result `?` propagates Ok payload (≤16B)") do ->
      assert_eq(gve_try_ok_point_run(), 1416)
    end
    it("Result `?` short-circuits on Err, value-layout Err propagates (≤16B)") do ->
      assert_eq(gve_try_err_short_run(), 4209)
    end
    it("Result `?` propagates Ok payload (>16B COW)") do ->
      assert_eq(gve_try_ok_doc_run(), 112233)
    end
    it("Option `?` propagates Some payload (≤16B)") do ->
      assert_eq(gve_try_some_point_run(), 6011)
    end
    it("Option `?` propagates Some payload (>16B COW)") do ->
      assert_eq(gve_try_some_doc_run(), 30405)
    end
  end

  describe("14C — Result/Option<@value fc=3 COW-layout> payload") do ->
    it("Result::Ok(@value fc=3) reads all three fields unshifted") do ->
      assert_eq(gve_result_doc_fields(), 112233)
    end

    it("Option::Some(@value fc=3) reads all three fields unshifted") do ->
      assert_eq(gve_option_doc_fields(), 445566)
    end

    it("Result::Ok(boxed fc=3) (non-@value) still correct — no over-fire") do ->
      assert_eq(gve_result_boxed3_fields(), 123)
    end
  end

  describe("Option<@value P> payload") do ->
    it("Some binds and reads the inline @value field") do ->
      assert_eq(gve_opt_some_x(), 11)
    end

    it("Some reads both @value fields (sum)") do ->
      assert_eq(gve_opt_some_sum(), 350)
    end

    it("None arm is taken correctly") do ->
      assert_eq(gve_opt_none(), 777)
    end
  end

  describe("Result<@value P, E> payload") do ->
    it("Ok binds and reads the @value payload") do ->
      assert_eq(gve_result_ok_sum(), 7)
    end

    it("Err binds the scalar payload") do ->
      assert_eq(gve_result_err(), 99)
    end
  end

  describe("nested @value enum payloads") do ->
    it("Option<Option<@value P>> reads through both layers") do ->
      assert_eq(gve_opt_nested(), 11)
    end
  end

  describe("boxed payloads unchanged") do ->
    it("Option<Int> still correct") do ->
      assert_eq(gve_opt_int(), 42)
    end

    it("Option<String> still correct") do ->
      assert_output("hello\n", gve_print_opt_string)
    end

    it("Option<boxed struct> still correct") do ->
      assert_eq(gve_opt_boxed_struct(), 330)
    end
  end

  describe("item 42 — de-erased combinators over @value payload") do ->
    it("result_map + unwrap_ok (≤16B inline)") do ->
      assert_eq(gve_combinator_map_unwrap(), 70)
    end

    it("result_map + unwrap_ok (>16B COW)") do ->
      assert_eq(gve_combinator_map_unwrap_cow(), 1353)
    end

    it("Result::Ok(@value) literal + unwrap_ok (pre-existing crash)") do ->
      assert_eq(gve_unwrap_ok_literal(), 809)
    end

    it("result_and_then over @value") do ->
      assert_eq(gve_combinator_and_then(), 708)
    end

    it("option_map over @value") do ->
      assert_eq(gve_combinator_option_map(), 104208)
    end
  end

  describe("non-match binding sites over @value payload") do ->
    it("if-let `if Some(p) = o` reads the inline field") do ->
      assert_eq(gve_iflet_some(), 17)
    end

    it("is-check `if o is Some(p)` reads the inline field") do ->
      assert_eq(gve_is_some(), 42)
    end
  end

  return qspec_main()
end
