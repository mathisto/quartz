## QSpec coverage for the migrated mem_report("init") callsite
## (Phase A.6 Pass 2). Pass 2 routes the first phase-marker site
## (self-hosted/quartz.qz line ~256, the `init` boundary) through
## the Profile effect.
##
## This spec validates the test-handler value prop end-to-end:
## installing a custom handler that captures phase events, then
## invoking a function that calls prof_phase, then asserting the
## captured data matches expectations.

import * from qspec
import std/profile

# --- Module-level state captured by the mock handler.
var _captured_phases = vec_new<String>()
var _capture_calls = 0

def _reset_capture(): Void
  _captured_phases = vec_new<String>()
  _capture_calls = 0
end

def _capture_handler(op_name: Int, argc: Int, argv: Int): Int
  _capture_calls = _capture_calls + 1
  var op = as_string(op_name)
  if op.eq("prof_phase")
    var name = as_string(load(argv, 0))
    _captured_phases.push(name)
  end
  return 0
end

# Function under test — simulates the phase-boundary call shape that
# self-hosted/quartz.qz line ~256 now uses post-A.6 Pass 2.
def _phase_caller(): Int
  prof_phase("init")
  prof_phase("lex")
  prof_phase("parse")
  return 0
end

# --- Test 1: capture handler intercepts every prof_phase call.

def t1_run(): Void
  _reset_capture()
  with Profile { prof_phase: _capture_handler } do ->
    _phase_caller()
  end
  puts("calls=#{_capture_calls}")
  for p in _captured_phases
    puts(p)
  end
end

# --- Test 2: post-with calls fall through to default (no-op when
#     gates off). The capture-call counter does NOT advance after
#     the with-block exits.

def t2_run(): Void
  _reset_capture()
  with Profile { prof_phase: _capture_handler } do ->
    prof_phase("inside")
  end
  prof_phase("outside")
  prof_phase("outside2")
  puts("calls=#{_capture_calls}")
  puts("captured=#{_captured_phases.size}")
end

# --- Test 3: span begin/end work alongside phase capture; the
#     default handler always returns real timestamps.

def t3_run(): Void
  var begin = prof_span_begin("compile")
  var sum = 0
  for i in 0..50
    sum = sum + i
  end
  var elapsed = prof_span_end(begin, "compile")
  if begin > 0 and elapsed >= 0
    puts("span_ok")
  else
    puts("span_bad")
  end
end

def main(): Int
  describe("Profile Pass 2 — migrated init phase boundary") do ->
    it("custom handler captures every prof_phase call") do ->
      assert_output("calls=3\ninit\nlex\nparse\n", t1_run)
    end

    it("post-with calls fall through to no-op default") do ->
      assert_output("calls=1\ncaptured=1\n", t2_run)
    end

    it("span begin/end return real timestamps") do ->
      assert_output("span_ok\n", t3_run)
    end
  end
  return qspec_main()
end
