## Vec<String> Operations Tests
##
## Contract:
##   1. str_split: splits string on delimiter, returns Vec<String>.
##   2. Element access: vec_get returns String type directly.
##   3. String operations: .size works on split elements.
##   4. Regex split: PCRE2-dependent (permanently pending).

import * from qspec
import * from qspec/subprocess

def vs_split_count(): Int
  parts = str_split("hello.world.foo", ".")
  return parts.size
end

def vs_split_str_ops(): Int
  parts = str_split("hello.world", ".")
  first = parts[0]
  return first.size
end

def vs_split_multi_get(): Int
  parts = str_split("a.bb.ccc", ".")
  second = parts[1]
  third = parts[2]
  return second.size * 10 + third.size
end

## regex_split removed — regex_split_pattern C runtime not available in lli

def main(): Int
  describe("str_split") do ->
    it("returns Vec<String> with correct element count") do ->
      assert_eq(vs_split_count(), 3)
    end

    it("allows direct string operations on elements without cast") do ->
      assert_eq(vs_split_str_ops(), 5)
    end

    it("vec_get returns String type directly") do ->
      assert_eq(vs_split_multi_get(), 23)
    end

    it("single element no split") do ->
      parts = str_split("hello", ".")
      assert_eq(parts.size, 1)
      first = parts[0]
      assert_eq(first.size, 5)
    end

    it("split produces correct first and last") do ->
      parts = str_split("a:b:c:d", ":")
      assert_eq(parts.size, 4)
      first = parts[0]
      last = parts[3]
      assert_eq(first.size, 1)
      assert_eq(last.size, 1)
    end
  end

  describe("regex_split") do ->
    it("Vec<String> regex_split via subprocess") do ->
      assert_run_stdout_eq("""
        def main(): Int
          var parts = regex_split("one::two::three", "::")
          puts(to_str(parts.size))
          puts(as_string(vec_get(parts, 0)))
          puts(as_string(vec_get(parts, 1)))
          puts(as_string(vec_get(parts, 2)))
          return 0
        end
        """, "3\none\ntwo\nthree\n")
    end
  end

  return qspec_main()
end
