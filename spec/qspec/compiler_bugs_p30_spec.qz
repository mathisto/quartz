import * from qspec
import * from qspec/subprocess

def test_cint_multi_return(): String = """
  extern "C" def abs(x: Int): Int
  def cint_branch(x: Int): CInt
    if x > 0
      return 1
    end
    return 0
  end
  def main(): Int
    var r = cint_branch(5)
    return r
  end
  """

def test_cint_three_returns(): String = """
  extern "C" def abs(x: Int): Int
  def classify(x: Int): CInt
    if x > 0
      return 1
    end
    if x < 0
      return -1
    end
    return 0
  end
  def main(): Int
    var r = classify(5)
    return r
  end
  """

def print_map_keys(): Void
  var m = map_new()
  m.set(10, 100)
  m.set(20, 200)
  var keys = m.keys()
  puts(keys.size.to_s())
end

def print_map_values(): Void
  var m = map_new()
  m.set(10, 100)
  m.set(20, 200)
  var vals = m.values()
  puts(vals.size.to_s())
end

def test_extern_c_endless(): String = """
  extern "C" def my_zero(): CInt = 0
  def main(): Int
    return 0
  end
  """

def test_extern_c_block(): String = """
  extern "C" def my_callback(x: Int): CInt
    if x > 0
      return 1
    end
    return 0
  end
  def main(): Int
    return 0
  end
  """

def test_extern_c_body_with_vars(): String = """
  extern "C" def my_fn(x: Int): CInt
    var result = 0
    if x > 10
      result = 1
    end
    return result
  end
  def main(): Int
    return 0
  end
  """

def test_extern_c_bodyless_then_var(): String = """
  extern "C" def getpid(): CInt
  var counter = 0
  def main(): Int
    return 0
  end
  """

def main(): Int
  describe("P30 compiler bug fixes") do ->
    it("Bug 3: CInt return with two return paths compiles") do ->
      assert_compile_succeeds(test_cint_multi_return())
    end
    it("Bug 3: CInt return with three return paths compiles") do ->
      assert_compile_succeeds(test_cint_three_returns())
    end
    it("Bug 3: CInt multi-return returns correct value") do ->
      assert_run_exits(test_cint_multi_return(), 1)
    end
    it("Bug 2: map_keys returns correct count") do ->
      assert_output("2\n", print_map_keys)
    end
    it("Bug 2: map_values returns correct count") do ->
      assert_output("2\n", print_map_values)
    end
    it("Bug 1: extern C endless def compiles") do ->
      assert_compile_succeeds(test_extern_c_endless())
    end
    it("Bug 1: extern C block def compiles") do ->
      assert_compile_succeeds(test_extern_c_block())
    end
    it("Bug 1: extern C body with local vars compiles") do ->
      assert_compile_succeeds(test_extern_c_body_with_vars())
    end
    it("Bug 1: bodyless extern followed by global var compiles") do ->
      assert_compile_succeeds(test_extern_c_bodyless_then_var())
    end
  end

  return qspec_main()
end
