## Effect-Row Propagation (Subsumption) — B.6 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.6).
## Verifies tc_row_subsume implements callee ⊆ caller subsumption per
## Leijen 2014 evidence-passing: a function annotated `can <row>` may
## only call functions whose `can` row is a sub-row of its own (or whose
## extra labels can be absorbed by an open tail).
##
## Acceptance is via the `--test-row-subsume` developer flag, which
## prints `ROW_SUBSUME <slug>: PASS|FAIL` per case to stderr. The actual
## wiring of tc_row_subsume into `tc_expr_call` (so a real Quartz program
## emits QZ0610 on a mismatch) lands in B.7 — this chunk ships only the
## primitive + acceptance tests.

import * from qspec
import * from qspec/subprocess

extern "C" def system(cmd: CString): CInt

def _run_subsume_tests(): SubResult
  _sub_init()
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    return SubResult { exit_code: -1, stdout_content: "", stderr_content: "QUARTZ_COMPILER not set" }
  end
  var sb = sb_new()
  sb.append(compiler)
  sb.append(" --test-row-subsume > /tmp/_qspec_row_subsume.out 2> /tmp/_qspec_row_subsume.err")
  var raw = system(sb.to_string())
  var exit_code = band(shr(raw, 8), 255)
  return SubResult {
    exit_code: exit_code,
    stdout_content: read_file("/tmp/_qspec_row_subsume.out"),
    stderr_content: read_file("/tmp/_qspec_row_subsume.err")
  }
end

def _assert_pass(stderr: String, slug: String): Void
  _inc_assertions()
  var needle = "ROW_SUBSUME #{slug}: PASS"
  if not str_contains(stderr, needle)
    var sb = sb_new()
    sb.append("Expected '#{needle}' in stderr but got: ")
    sb.append(stderr)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("tc_row_subsume — callee row must be sub-row of caller") do ->
    var r = _run_subsume_tests()

    it("caller `can L` calls callee `can L` (closed equal)") do ->
      _assert_pass(r.stderr_content, "caller_L_calls_callee_L")
    end

    it("caller `can L, M` calls callee `can L` (subset)") do ->
      _assert_pass(r.stderr_content, "caller_LM_calls_callee_L_subset")
    end

    it("caller `can L` calls callee `can L, M` — caller can't (FAIL)") do ->
      _assert_pass(r.stderr_content, "caller_L_calls_callee_LM_FAIL")
    end

    it("caller `can` (empty) calls callee `can L` (FAIL)") do ->
      _assert_pass(r.stderr_content, "caller_empty_calls_callee_L_FAIL")
    end

    it("caller open with no labels absorbs callee's labels (ok)") do ->
      _assert_pass(r.stderr_content, "caller_open_calls_callee_L")
    end

    it("caller `can L | ρ` calls callee `can L, M` — extends ρ with M") do ->
      _assert_pass(r.stderr_content, "caller_L_open_calls_callee_LM_extends")
    end
  end
  return qspec_main()
end
