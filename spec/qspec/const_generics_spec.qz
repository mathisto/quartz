## Const Generics Tests
##
## Contract:
##   1. Array_new creates fixed-size stack array.
##   2. Array elements are zero-initialized.
##   3. Array can be passed to functions.
##   4. Array with different sizes.
##   5. Backward compatibility.

import * from qspec

def sum_first_two(arr: Int): Int
  return array_get(arr, 0) + array_get(arr, 1)
end

def main(): Int
  describe("array_new creates fixed-size stack array") do ->
    it("creates array and sets/gets an element") do ->
      var arr = array_new<Int, 5>()
      array_set(arr, 0, 42)
      assert_eq(array_get(arr, 0), 42)
    end

    it("stores multiple elements at different indices") do ->
      var arr = array_new<Int, 4>()
      array_set(arr, 0, 10)
      array_set(arr, 1, 20)
      array_set(arr, 2, 30)
      array_set(arr, 3, 40)
      assert_eq(array_get(arr, 0) + array_get(arr, 3), 50)
    end

    it("array_size returns the compile-time size N") do ->
      var arr = array_new<Int, 8>()
      assert_eq(array_size(arr), 8)
    end

    it("array of size 1 works") do ->
      var arr = array_new<Int, 1>()
      array_set(arr, 0, 99)
      assert_eq(array_get(arr, 0), 99)
    end
  end

  describe("array elements are zero-initialized") do ->
    it("unset elements are zero") do ->
      var arr = array_new<Int, 3>()
      assert_eq(array_get(arr, 0) + array_get(arr, 1) + array_get(arr, 2), 0)
    end
  end

  describe("array can be passed to functions") do ->
    it("function reads from array passed as argument") do ->
      var arr = array_new<Int, 3>()
      array_set(arr, 0, 15)
      array_set(arr, 1, 27)
      assert_eq(sum_first_two(arr), 42)
    end
  end

  describe("array with different sizes") do ->
    it("size 10 array") do ->
      var arr = array_new<Int, 10>()
      var i = 0
      while i < 10
        array_set(arr, i, i * i)
        i = i + 1
      end
      assert_eq(array_get(arr, 9), 81)
    end

    it("size 100 array") do ->
      var arr = array_new<Int, 100>()
      array_set(arr, 99, 77)
      assert_eq(array_get(arr, 99) + array_size(arr), 177)
    end
  end

  describe("backward compatibility") do ->
    it("Vec operations still work after adding array support") do ->
      var v = vec_new()
      v.push(42)
      x = v[0]
      assert_eq(x, 42)
    end

    it("typed Vec still works") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      sum = v[0] + v[1]
      assert_eq(sum, 30)
    end
  end

  return qspec_main()
end
