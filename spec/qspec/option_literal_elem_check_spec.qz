## option_some(<literal>) payload type-safety (enum-niche tail, item 10)
##
## Contract:
##   `option_some(x)` carries a CONCRETE payload type (`Option<typeof x>`)
##   instead of the erased bare `Option`. This closes a hole where a
##   mismatched literal was wrongly accepted into a typed `Vec<Option<T>>`
##   (or returned from a typed `Option<T>` function).
##
## Tightening fix — the risk is OVER-tightening (rejecting valid programs).
## Guards under test:
##   - `Option<Int>` into `Vec<Option<Int>>` still accepts (exact match).
##   - i64-compatible payloads (Bool into Option<Int>) still match, on BOTH
##     the element path (vec_push) and the return path (Option<Int> fn).
##   - String into Option<Int> (and vice versa) correctly rejects.
##   - Unannotated `var o = option_some(42)` still narrows to Option<Int>.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("option_some(literal) — mismatched element rejected") do ->
    it("rejects option_some(Int) pushed into Vec<Option<String>>") do ->
      assert_compile_error(
        "def main(): Int\n  var v: Vec<Option<String>> = vec_new<Option<String>>()\n  v.push(option_some(42))\n  return 0\nend\n",
        "expected element type")
    end

    it("rejects option_some(String) pushed into Vec<Option<Int>>") do ->
      assert_compile_error(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  v.push(option_some(\"s\"))\n  return 0\nend\n",
        "expected element type")
    end

    it("rejects option_some(String) returned from Option<Int> function") do ->
      assert_compile_error(
        "def f(): Option<Int>\n  return option_some(\"hello\")\nend\ndef main(): Int\n  return 0\nend\n",
        "Return type mismatch")
    end
  end

  describe("option_some(literal) — matching element accepted") do ->
    it("accepts option_some(Int) pushed into Vec<Option<Int>>") do ->
      assert_compile_succeeds(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  v.push(option_some(42))\n  return 0\nend\n")
    end

    it("accepts i64-compatible Bool payload into Vec<Option<Int>> (no over-tighten)") do ->
      assert_compile_succeeds(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  var b = true\n  v.push(option_some(b))\n  return 0\nend\n")
    end

    it("accepts option_some(Bool) returned from Option<Int> function (no over-tighten)") do ->
      assert_compile_succeeds(
        "def f(b: Bool): Option<Int>\n  return option_some(b)\nend\ndef main(): Int\n  return 0\nend\n")
    end
  end

  describe("option_some(literal) — unannotated inference") do ->
    it("narrows var o = option_some(42) to Option<Int> and computes") do ->
      var o = option_some(42)
      assert_eq(o.unwrap() + 1, 43)
    end

    it("un-annotated struct-literal payload still compiles (no over-tighten)") do ->
      # Guard against carrying the BARE TYPE_STRUCT placeholder: wrapping it would
      # yield an unresolvable Option<Struct> and break the 6.3c niche read path
      # (error[QZ0301]: Unknown struct: Struct). Bare aggregate bases stay loose.
      var u = option_some(OleUser { age: 42, name: "ada" })
      assert_eq(u.unwrap().age, 42)
    end
  end

  return qspec_main()
end

struct OleUser
  age: Int
  name: String
end
