## Bitwise Operator Typecheck Tests
##
## Verifies that bitwise operators (&, |, ^, <<, >>) produce Int type
## in named functions (not just main/impl blocks). This was a compiler
## bug where opcodes 16-20 were missing from the tc_expr match.

import * from qspec

def bitwise_and(a: Int, b: Int): Int
  var x = a & b
  return x
end

def bitwise_or(a: Int, b: Int): Int
  var x = a | b
  return x
end

def bitwise_xor(a: Int, b: Int): Int
  var x = a ^ b
  return x
end

def shift_left(a: Int, n: Int): Int
  var x = a << n
  return x
end

def shift_right(a: Int, n: Int): Int
  var x = a >> n
  return x
end

def bitwise_in_if(a: Int, b: Int): Int
  if a > 0
    var x = a | b
    return x
  end
  return 0
end

def print_and(): Void = puts(str_from_int(bitwise_and(0xFF, 0x0F)))
def print_or(): Void = puts(str_from_int(bitwise_or(0xF0, 0x0F)))
def print_xor(): Void = puts(str_from_int(bitwise_xor(0xFF, 0x0F)))
def print_shl(): Void = puts(str_from_int(shift_left(1, 8)))
def print_shr(): Void = puts(str_from_int(shift_right(256, 4)))
def print_in_if(): Void = puts(str_from_int(bitwise_in_if(5, 3)))

def main(): Int
  describe("Bitwise operators in named functions") do ->
    it("& returns Int") do ->
      assert_eq(bitwise_and(0xFF, 0x0F), 15)
    end

    it("| returns Int") do ->
      assert_eq(bitwise_or(0xF0, 0x0F), 255)
    end

    it("^ returns Int") do ->
      assert_eq(bitwise_xor(0xFF, 0x0F), 240)
    end

    it("<< returns Int") do ->
      assert_eq(shift_left(1, 8), 256)
    end

    it(">> returns Int") do ->
      assert_eq(shift_right(256, 4), 16)
    end

    it("works inside if blocks") do ->
      assert_eq(bitwise_in_if(5, 3), 7)
    end

    it("output matches") do ->
      assert_output("15\n", print_and)
      assert_output("255\n", print_or)
      assert_output("240\n", print_xor)
      assert_output("256\n", print_shl)
      assert_output("16\n", print_shr)
      assert_output("7\n", print_in_if)
    end
  end

  return qspec_main()
end
