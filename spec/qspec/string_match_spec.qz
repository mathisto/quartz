## String Match Tests
##
## Contract:
##   1. Basic string matching.
##   2. Statement form.
##   3. String match with function parameters.
##   4. String match as expression.
##   5. String match with str_concat subject.
##   6. Exhaustiveness.

import * from qspec

def main(): Int
  describe("basic string matching") do ->
    it("matches first string literal") do ->
      assert_eq(match_hello_world("hello"), 42)
    end

    it("matches second string literal") do ->
      assert_eq(match_hello_world("world"), 1)
    end

    it("falls through to wildcard") do ->
      assert_eq(match_hello_world("other"), 0)
    end

    it("matches empty string") do ->
      assert_eq(match_empty(""), 42)
    end
  end

  describe("statement form") do ->
    it("matches string in statement context") do ->
      assert_eq(match_hello_world("world"), 1)
    end

    it("falls through to wildcard in statement form") do ->
      assert_eq(match_hello_world("unknown"), 0)
    end
  end

  describe("string match with function parameters") do ->
    it("matches parameter string") do ->
      assert_eq(classify_str("if"), 3)
    end

    it("handles many arms correctly") do ->
      assert_eq(keyword_id("match"), 9)
    end
  end

  describe("string match as expression") do ->
    it("returns value from matched arm") do ->
      assert_eq(classify_yn("no"), 2)
    end
  end

  describe("string match with str_concat subject") do ->
    it("matches dynamically built string") do ->
      a = "hel"
      b = "lo"
      s = a + b
      assert_eq(match_hello_world(s), 42)
    end
  end

  describe("guards on string arms") do ->
    it("guard passes on matching arm") do ->
      assert_eq(match_with_guard("hello", true), 42)
    end

    it("guard fails, falls to wildcard") do ->
      assert_eq(match_with_guard("hello", false), 0)
    end
  end

  describe("char literal patterns") do ->
    it("matches char literal 'A'") do ->
      assert_eq(classify_char('A'), 1)
    end

    it("matches char literal 'Z'") do ->
      assert_eq(classify_char('Z'), 2)
    end

    it("matches newline escape char") do ->
      assert_eq(classify_char('\n'), 3)
    end

    it("wildcard for unmatched char") do ->
      assert_eq(classify_char('x'), 0)
    end
  end

  describe("negative integer patterns") do ->
    it("matches -1") do ->
      assert_eq(classify_sign(-1), 1)
    end

    it("matches -42") do ->
      assert_eq(classify_sign(-42), 2)
    end

    it("matches 0") do ->
      assert_eq(classify_sign(0), 3)
    end

    it("wildcard for other values") do ->
      assert_eq(classify_sign(99), 0)
    end
  end

  describe("exhaustiveness") do ->
    it("requires wildcard for string match") do ->
      assert_compile_error("""
        def main(): Int
          s = "hello"
          match s
            "hello" => return 1
          end
          return 0
        end
        """, "non-exhaustive")
    end
  end

  return qspec_main()
end

def match_hello_world(s: String): Int
  match s
    "hello" => return 42
    "world" => return 1
    _ => return 0
  end
  return 99
end

def match_empty(s: String): Int
  match s
    "" => return 42
    "hello" => return 1
    _ => return 0
  end
  return 99
end

def classify_str(s: String): Int
  match s
    "def" => return 1
    "end" => return 2
    "if" => return 3
    _ => return 0
  end
  return 99
end

def keyword_id(s: String): Int
  match s
    "def" => return 1
    "end" => return 2
    "if" => return 3
    "else" => return 4
    "elsif" => return 5
    "while" => return 6
    "for" => return 7
    "return" => return 8
    "match" => return 9
    "enum" => return 10
    _ => return 0
  end
  return 99
end

def classify_yn(s: String): Int
  match s
    "yes" => return 1
    "no" => return 2
    _ => return 0
  end
  return 99
end

def match_with_guard(s: String, flag: Bool): Int
  match s
    "hello" if flag => return 42
    _ => return 0
  end
  return 99
end

def classify_char(c: Int): Int
  match c
    'A' => return 1
    'Z' => return 2
    '\n' => return 3
    _ => return 0
  end
  return 99
end

def classify_sign(n: Int): Int
  match n
    -1 => return 1
    -42 => return 2
    0 => return 3
    _ => return 0
  end
  return 99
end
