## Effect-Row Call-Site Subsumption (QZ0610) — B.7 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.7).
## Verifies the actual integration of B.6's `tc_row_subsume` primitive
## into `tc_expr_call`: the caller's `can` row must subsume the
## callee's `can` row, otherwise QZ0610 fires.
##
## The handler-narrowing half of the original B.7 plan (`with H do ->
## body end` body-row subtraction + per-op label-add) is FOLLOW-UP work
## once the parser emits a real `NODE_WITH` AST node. Milestone A
## currently parses `with` into a plain `ast_block` (handler expression
## discarded). That AST surgery is its own chunk; B.7 ships the
## call-site half cleanly.
##
## All assertions go through `subprocess_compile`; the spec is a pure
## front-end check that the right diagnostic does (or does not) fire
## for each row arrangement.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("call-site row subsumption (B.7) — QZ0610") do ->
    it("caller `can L` calls callee `can L` (closed equal): compiles") do ->
      assert_compile_succeeds("""
def callee(): Int can L = 1
def caller(): Int can L = callee()
def main(): Int = caller()
""")
    end

    it("caller `can L, M` calls callee `can L` (subset): compiles") do ->
      assert_compile_succeeds("""
def callee(): Int can L = 1
def caller(): Int can L, M = callee()
def main(): Int = caller()
""")
    end

    it("caller `can L` calls callee `can L, M` (extra): QZ0610") do ->
      assert_compile_error("""
def callee(): Int can L, M = 1
def caller(): Int can L = callee()
def main(): Int = caller()
""", "QZ0610")
    end

    it("caller `can` (empty closed) calls callee `can L`: QZ0610") do ->
      assert_compile_error("""
def callee(): Int can L = 1
def caller(): Int can = callee()
def main(): Int = caller()
""", "QZ0610")
    end

    it("untracked caller calls callee `can L`: compiles (no row check)") do ->
      assert_compile_succeeds("""
def callee(): Int can L = 1
def caller(): Int = callee()
def main(): Int = caller()
""")
    end

    it("caller `can L | r` calls callee `can L, M`: ρ extends with M") do ->
      assert_compile_succeeds("""
def callee(): Int can L, M = 1
def caller(): Int can L | r = callee()
def main(): Int = caller()
""")
    end
  end
  return qspec_main()
end
