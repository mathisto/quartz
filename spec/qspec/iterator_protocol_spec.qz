## Iterator Protocol Tests — Phase 7
## Tests the formal Iterator<T> trait, lazy adapters, terminal operations,
## and composable iteration chains.
##
## All tests run inline using direct QSpec assertions (no subprocess compilation).
## A shared Counter struct implements Iterator<Int> for most tests.
##
## STATUS: 38 active tests, 0 pending.
## $try bug in adapter struct next() methods fixed — macro expansion now runs
## on imported module impl blocks.
##
## Contract:
##   1. Iterator<T> trait basics.
##   2. Adapter: MapIter.
##   3. Adapter: FilterIter.
##   4. Adapter: TakeIter.
##   5. Adapter: SkipIter.
##   6. Adapter: TakeWhileIter.
##   7. Adapter chaining.
##   8. Terminal: iter_collect.
##   9. Terminal: iter_sum.
##   10. Terminal: iter_count.
##   11. Terminal: iter_fold.
##   12. Terminal: iter_any / iter_all.
##   13. Terminal: iter_find.
##   14. Terminal: iter_min / iter_max.
##   15. Collection iterators.
##   16. Composition stress.

import * from qspec
import traits
import iter

struct Counter
  current: Int
  stop: Int
end

extend Counter with Iterator<Int>
  def next(&mut self): Option<Int>
    if self.current < self.stop
      var val = self.current
      self.current = self.current + 1
      return Option::Some(val)
    end
    return Option::None
  end
end

def main(): Int
  # ===========================================================================
  # 1. Iterator<T> trait basics
  # ===========================================================================
  describe("Iterator<T> trait basics") do ->
    it("impl Iterator<Int> for a struct with next()") do ->
      var c = Counter { current: 0, stop: 5 }
      var sum = 0
      match c.next()
        Some(v) => sum = sum + v
        _ => {}
      end
      match c.next()
        Some(v) => sum = sum + v
        _ => {}
      end
      match c.next()
        Some(v) => sum = sum + v
        _ => {}
      end
      match c.next()
        Some(v) => sum = sum + v
        _ => {}
      end
      match c.next()
        Some(v) => sum = sum + v
        _ => {}
      end
      assert_eq(sum, 10)
    end

    it("empty iterator returns None immediately") do ->
      var c = Counter { current: 5, stop: 5 }
      match c.next()
        Some(v) => assert_eq(1, 0)
        None => assert_eq(0, 0)
      end
    end

    it("for-in works with trait-based iterator") do ->
      var c = Counter { current: 0, stop: 5 }
      var sum = 0
      for x in c
        sum += x
      end
      assert_eq(sum, 10)
    end

    it("break works with trait-based iterator") do ->
      var c = Counter { current: 0, stop: 10 }
      var sum = 0
      for x in c
        if x >= 3
          break
        end
        sum += x
      end
      assert_eq(sum, 3)
    end

    it("continue works with trait-based iterator") do ->
      var c = Counter { current: 0, stop: 6 }
      var sum = 0
      for x in c
        if x == 3
          continue
        end
        sum += x
      end
      assert_eq(sum, 12)
    end
  end

  # ===========================================================================
  # 2. Adapter: MapIter
  # ===========================================================================
  describe("adapter: MapIter") do ->
    it("transforms each element") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x * 2)
      var m_next: Fn(): Option<Int> = -> m.next()
      assert_eq(iter_sum(m_next), 20)
    end

    it("identity transform") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x)
      var m_next: Fn(): Option<Int> = -> m.next()
      assert_eq(iter_sum(m_next), 10)
    end

    it("map on empty iterator") do ->
      var c = Counter { current: 5, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x * 10)
      var m_next: Fn(): Option<Int> = -> m.next()
      assert_eq(iter_sum(m_next), 0)
    end
  end

  # ===========================================================================
  # 3. Adapter: FilterIter
  # ===========================================================================
  describe("adapter: FilterIter") do ->
    it("keeps matching elements") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var f = iter_filter(c_next, x -> x % 2 == 0)
      var f_next: Fn(): Option<Int> = -> f.next()
      assert_eq(iter_sum(f_next), 6)
    end

    it("filter all (nothing matches)") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var f = iter_filter(c_next, x -> x > 100)
      var f_next: Fn(): Option<Int> = -> f.next()
      assert_eq(iter_count(f_next), 0)
    end

    it("filter none (everything matches)") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var f = iter_filter(c_next, x -> x >= 0)
      var f_next: Fn(): Option<Int> = -> f.next()
      assert_eq(iter_sum(f_next), 10)
    end
  end

  # ===========================================================================
  # 4. Adapter: TakeIter
  # ===========================================================================
  describe("adapter: TakeIter") do ->
    it("takes first N elements") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var t = iter_take(c_next, 3)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 3)
    end

    it("take more than available") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var t = iter_take(c_next, 100)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 10)
    end

    it("take 0") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var t = iter_take(c_next, 0)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 0)
    end
  end

  # ===========================================================================
  # 5. Adapter: SkipIter
  # ===========================================================================
  describe("adapter: SkipIter") do ->
    it("skips first N elements") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var s = iter_skip(c_next, 3)
      var s_next: Fn(): Option<Int> = -> s.next()
      assert_eq(iter_sum(s_next), 7)
    end

    it("skip all") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var s = iter_skip(c_next, 10)
      var s_next: Fn(): Option<Int> = -> s.next()
      assert_eq(iter_sum(s_next), 0)
    end
  end

  # ===========================================================================
  # 6. Adapter: TakeWhileIter
  # ===========================================================================
  describe("adapter: TakeWhileIter") do ->
    it("takes while predicate holds") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var tw = iter_take_while(c_next, x -> x < 4)
      var tw_next: Fn(): Option<Int> = -> tw.next()
      assert_eq(iter_sum(tw_next), 6)
    end
  end

  # ===========================================================================
  # 7. Adapter chaining
  # ===========================================================================
  describe("adapter chaining") do ->
    it("map then filter") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x * 2)
      var m_next: Fn(): Option<Int> = -> m.next()
      var f = iter_filter(m_next, x -> x > 4)
      var f_next: Fn(): Option<Int> = -> f.next()
      assert_eq(iter_sum(f_next), 84)
    end

    it("filter then take") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var f = iter_filter(c_next, x -> x % 2 == 0)
      var f_next: Fn(): Option<Int> = -> f.next()
      var t = iter_take(f_next, 2)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 2)
    end

    it("map then take then sum") do ->
      var c = Counter { current: 0, stop: 10 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x * 2)
      var m_next: Fn(): Option<Int> = -> m.next()
      var t = iter_take(m_next, 3)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 6)
    end
  end

  # ===========================================================================
  # 8. Terminal: iter_collect
  # ===========================================================================
  describe("terminal: iter_collect") do ->
    it("collects into Vec") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var v = iter_collect(c_next)
      var sum = 0
      for i in 0..v.size
        sum += v[i]
      end
      assert_eq(sum, 10)
    end
  end

  # ===========================================================================
  # 9. Terminal: iter_sum
  # ===========================================================================
  describe("terminal: iter_sum") do ->
    it("sums elements") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var sum = iter_sum(c_next)
      assert_eq(sum, 10)
    end

    it("sum of empty") do ->
      var c = Counter { current: 5, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var sum = iter_sum(c_next)
      assert_eq(sum, 0)
    end
  end

  # ===========================================================================
  # 10. Terminal: iter_count
  # ===========================================================================
  describe("terminal: iter_count") do ->
    it("counts elements") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var n = iter_count(c_next)
      assert_eq(n, 5)
    end
  end

  # ===========================================================================
  # 11. Terminal: iter_fold
  # ===========================================================================
  describe("terminal: iter_fold") do ->
    it("folds with accumulator") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_fold(c_next, 0, acc: Int, x: Int -> acc + x)
      assert_eq(result, 10)
    end

    it("fold product") do ->
      var c = Counter { current: 1, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_fold(c_next, 1, acc: Int, x: Int -> acc * x)
      assert_eq(result, 24)
    end
  end

  # ===========================================================================
  # 12. Terminal: iter_any / iter_all
  # ===========================================================================
  describe("terminal: iter_any / iter_all") do ->
    it("any finds a match") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      if iter_any(c_next, x -> x == 3)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("any with no match") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      if iter_any(c_next, x -> x > 100)
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("all with all matching") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      if iter_all(c_next, x -> x < 10)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("all with one failing") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      if iter_all(c_next, x -> x < 3)
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end
  end

  # ===========================================================================
  # 13. Terminal: iter_find
  # ===========================================================================
  describe("terminal: iter_find") do ->
    it("finds first matching element") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_find(c_next, x -> x == 3)
      match result
        Some(v) => assert_eq(v, 3)
        None => assert_eq(0, 1)
      end
    end

    it("find with no match returns None") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_find(c_next, x -> x > 100)
      match result
        Some(v) => assert_eq(1, 0)
        None => assert_eq(0, 0)
      end
    end
  end

  # ===========================================================================
  # 14. Terminal: iter_min / iter_max
  # iter_min works; iter_max returns garbage ($try codegen issue).
  # ===========================================================================
  describe("terminal: iter_min / iter_max") do ->
    it("finds minimum") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_min(c_next)
      match result
        Some(v) => assert_eq(v, 0)
        None => assert_eq(0, 1)
      end
    end

    it("finds maximum") do ->
      var c = Counter { current: 0, stop: 5 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var result = iter_max(c_next)
      match result
        Some(v) => assert_eq(v, 4)
        None => assert_eq(0, 1)
      end
    end
  end

  # ===========================================================================
  # 15. Collection iterators
  # ===========================================================================
  describe("collection iterators") do ->
    it("VecIter iterates over Vec elements") do ->
      var v: Vec<Int> = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      var vi = vec_iter(v)
      var vi_next: Fn(): Option<Int> = -> vi.next()
      var sum = iter_sum(vi_next)
      assert_eq(sum, 15)
    end

    it("RangeIter iterates over range") do ->
      var ri = range_iter(0, 10)
      var ri_next: Fn(): Option<Int> = -> ri.next()
      var sum = iter_sum(ri_next)
      assert_eq(sum, 45)
    end

    it("VecIter with for-in") do ->
      var v: Vec<Int> = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      var vi = vec_iter(v)
      var sum = 0
      for x in vi
        sum += x
      end
      assert_eq(sum, 6)
    end
  end

  # ===========================================================================
  # 16. Composition stress
  # ===========================================================================
  describe("composition stress") do ->
    it("3+ adapters chained then collected") do ->
      var c = Counter { current: 0, stop: 20 }
      var c_next: Fn(): Option<Int> = -> c.next()
      var m = iter_map(c_next, x -> x * 3)
      var m_next: Fn(): Option<Int> = -> m.next()
      var f = iter_filter(m_next, x -> x % 2 == 0)
      var f_next: Fn(): Option<Int> = -> f.next()
      var t = iter_take(f_next, 5)
      var t_next: Fn(): Option<Int> = -> t.next()
      assert_eq(iter_sum(t_next), 60)
    end
  end

  # ===========================================================================
  # 17. Phase 6: bounded-generic public API — concrete iterators in, no
  #     `Fn(): Option<Int>` boilerplate at the call site.
  # ===========================================================================
  describe("Phase 6: bounded-generic adapter/terminal API") do ->
    it("iter_sum takes a concrete iterator directly") do ->
      var c = Counter { current: 0, stop: 5 }
      assert_eq(iter_sum(c), 10)
    end

    it("iter_collect takes a concrete iterator directly") do ->
      var c = Counter { current: 1, stop: 4 }
      var v = iter_collect(c)
      assert_eq(v.size, 3)
      assert_eq(v[0], 1)
      assert_eq(v[1], 2)
      assert_eq(v[2], 3)
    end

    it("iter_count takes a concrete iterator directly") do ->
      var c = Counter { current: 0, stop: 7 }
      assert_eq(iter_count(c), 7)
    end

    it("iter_fold takes a concrete iterator directly") do ->
      var c = Counter { current: 1, stop: 6 }
      assert_eq(iter_fold(c, 1, (a, b) -> a * b), 120)
    end

    it("iter_map then iter_sum, no closure boilerplate") do ->
      var c = Counter { current: 0, stop: 5 }
      var m = iter_map(c, x -> x * 2)
      assert_eq(iter_sum(m), 20)
    end

    it("iter_filter then iter_sum, no closure boilerplate") do ->
      var c = Counter { current: 0, stop: 10 }
      var f = iter_filter(c, x -> x % 2 == 0)
      assert_eq(iter_sum(f), 20)
    end

    it("iter_take then iter_sum, no closure boilerplate") do ->
      var c = Counter { current: 0, stop: 100 }
      var t = iter_take(c, 5)
      assert_eq(iter_sum(t), 10)
    end

    it("3-deep chain: sum(filter(map(vec, *10), >20)) — design doc example") do ->
      var v: Vec<Int> = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      var vi = vec_iter(v)
      var t = iter_sum(iter_filter(iter_map(vi, x -> x * 10), x -> x > 20))
      assert_eq(t, 120)
    end

    it("4-deep chain: take(filter(map(range, *3), even), 5).sum") do ->
      var r = range_iter(0, 20)
      var m = iter_map(r, x -> x * 3)
      var f = iter_filter(m, x -> x % 2 == 0)
      var t = iter_take(f, 5)
      assert_eq(iter_sum(t), 60)
    end

    it("iter_any takes a concrete iterator directly") do ->
      var c = Counter { current: 0, stop: 10 }
      assert(iter_any(c, x -> x == 7))
    end

    it("iter_all takes a concrete iterator directly") do ->
      var c = Counter { current: 1, stop: 6 }
      assert(iter_all(c, x -> x > 0))
    end

    it("iter_find returns first match") do ->
      var c = Counter { current: 0, stop: 10 }
      var found = iter_find(c, x -> x == 4)
      match found
        Some(v) => assert_eq(v, 4)
        _ => assert_eq(0, 1)
      end
    end

    it("iter_min on bounded-generic API") do ->
      var v: Vec<Int> = vec_new()
      v.push(5)
      v.push(2)
      v.push(7)
      v.push(3)
      var m = iter_min(vec_iter(v))
      match m
        Some(x) => assert_eq(x, 2)
        _ => assert_eq(0, 1)
      end
    end

    it("iter_max on bounded-generic API") do ->
      var v: Vec<Int> = vec_new()
      v.push(5)
      v.push(2)
      v.push(7)
      v.push(3)
      var m = iter_max(vec_iter(v))
      match m
        Some(x) => assert_eq(x, 7)
        _ => assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end
