## Vec Mutation Intrinsics Tests
##
## Contract: vec_capacity, vec_truncate, vec_dedup, vec_retain, vec_extend

import * from qspec

def is_even(x: Int): Bool = x % 2 == 0
def is_positive(x: Int): Bool = x > 0

def main(): Int
  describe("vec_capacity") do ->
    it("returns capacity of new vec") do ->
      var v = vec_new<Int>()
      assert_eq(v.capacity() >= 0, true)
    end

    it("capacity grows after pushes") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      assert_eq(v.capacity() >= 5, true)
    end
  end

  describe("vec_truncate") do ->
    it("truncates to smaller size") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.truncate(2)
      assert_eq(v.size, 2)
      assert_eq(v[0], 1)
      assert_eq(v[1], 2)
    end

    it("no-op when n >= size") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.truncate(10)
      assert_eq(v.size, 2)
    end

    it("truncate to 0 empties vec") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.truncate(0)
      assert_eq(v.size, 0)
    end
  end

  describe("vec_dedup") do ->
    it("removes consecutive duplicates") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(1)
      v.push(2)
      v.push(2)
      v.push(3)
      v.dedup()
      assert_eq(v.size, 3)
      assert_eq(v[0], 1)
      assert_eq(v[1], 2)
      assert_eq(v[2], 3)
    end

    it("no-op on empty vec") do ->
      var v = vec_new<Int>()
      v.dedup()
      assert_eq(v.size, 0)
    end

    it("no-op on single element") do ->
      var v = vec_new<Int>()
      v.push(42)
      v.dedup()
      assert_eq(v.size, 1)
    end

    it("preserves non-consecutive duplicates") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(1)
      v.dedup()
      assert_eq(v.size, 3)
    end
  end

  describe("vec_retain") do ->
    it("keeps matching elements") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.retain(is_even)
      assert_eq(v.size, 2)
      assert_eq(v[0], 2)
      assert_eq(v[1], 4)
    end

    it("retains all when all match") do ->
      var v = vec_new<Int>()
      v.push(2)
      v.push(4)
      v.retain(is_even)
      assert_eq(v.size, 2)
    end

    it("retains none when none match") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(3)
      v.retain(is_even)
      assert_eq(v.size, 0)
    end

    it("works with lambda") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(-5)
      v.push(20)
      v.push(-1)
      v.retain(x -> x > 0)
      assert_eq(v.size, 2)
      assert_eq(v[0], 10)
      assert_eq(v[1], 20)
    end
  end

  describe("vec_extend") do ->
    it("appends all elements from v2") do ->
      var v1 = vec_new<Int>()
      v1.push(1)
      v1.push(2)
      var v2 = vec_new<Int>()
      v2.push(3)
      v2.push(4)
      v1.extend(v2)
      assert_eq(v1.size, 4)
      assert_eq(v1[0], 1)
      assert_eq(v1[1], 2)
      assert_eq(v1[2], 3)
      assert_eq(v1[3], 4)
    end

    it("extend with empty vec is no-op") do ->
      var v1 = vec_new<Int>()
      v1.push(1)
      var v2 = vec_new<Int>()
      v1.extend(v2)
      assert_eq(v1.size, 1)
    end

    it("extend empty vec copies all") do ->
      var v1 = vec_new<Int>()
      var v2 = vec_new<Int>()
      v2.push(10)
      v2.push(20)
      v1.extend(v2)
      assert_eq(v1.size, 2)
      assert_eq(v1[0], 10)
    end

    it("extend triggers growth") do ->
      var v1 = vec_new<Int>()
      v1.push(1)
      var v2 = vec_new<Int>()
      for i in 0..20
        v2.push(i)
      end
      v1.extend(v2)
      assert_eq(v1.size, 21)
      assert_eq(v1[0], 1)
      assert_eq(v1[20], 19)
    end
  end

  return qspec_main()
end
