## Shovel Operator (<<) Tests
##
## Contract: << pushes/adds/appends based on LHS type.
##   Vec << val  → v.push(val)
##   Set << val  → set_add(s, val)
##   StringBuilder << str → sb_append(sb, str)

import * from qspec

def main(): Int
  describe("shovel operator on Vec") do ->
    it("pushes single element") do ->
      var v = vec_new<Int>()
      v << 42
      assert_eq(v.size, 1)
      assert_eq(v[0], 42)
    end

    it("pushes multiple elements") do ->
      var v = vec_new<Int>()
      v << 1
      v << 2
      v << 3
      assert_eq(v.size, 3)
      assert_eq(v[2], 3)
    end

    it("works with expressions") do ->
      var v = vec_new<Int>()
      v << (5 + 10)
      assert_eq(v[0], 15)
    end
  end

  describe("shovel operator on Set") do ->
    it("adds element to set") do ->
      var s = set_new()
      s << 10
      s << 20
      s << 10
      assert_eq(set_size(s), 2)
    end
  end

  describe("shovel operator on StringBuilder") do ->
    it("appends string to builder") do ->
      var sb = sb_new()
      sb << "hello"
      sb << " world"
      assert_eq_str(sb.to_string(), "hello world")
    end
  end

  describe("left-shift still works on Int") do ->
    it("1 << 3 is 8") do ->
      assert_eq(1 << 3, 8)
    end

    it("bitshift in expressions") do ->
      var x = 4
      assert_eq(x << 2, 16)
    end
  end

  return qspec_main()
end
