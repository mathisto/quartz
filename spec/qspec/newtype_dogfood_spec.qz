## Newtype dogfooding smoke test — verifies patterns needed for compiler type hygiene
## Vec<NewtypeId>, struct fields, arithmetic, cross-type rejection
##
## Contract:
##   1. Vec<NewtypeId>.
##   2. Newtype in struct field.
##   3. Newtype arithmetic.
##   4. Cross-newtype rejection.
##   5. Newtype function composition.

import * from qspec
import * from qspec/subprocess

newtype TestId = Int
newtype OtherId = Int

struct TestHolder
  id: TestId
  name: String
end

def make_holder(id: TestId, name: String): TestHolder
  return TestHolder { id: id, name: name }
end

def get_holder_id(h: TestHolder): TestId = h.id

def main(): Int
  describe("Vec<NewtypeId>") do ->
    it("push newtype values into untyped Vec") do ->
      var ids = vec_new()
      var a: TestId = 10
      var b: TestId = 20
      ids.push(a)
      ids.push(b)
      assert_eq(ids.size, 2)
      assert_eq(ids[0], 10)
      assert_eq(ids[1], 20)
    end

    it("Vec<TestId> rejects Int literals (type safety)") do ->
      assert_compile_error("""
        newtype TestId = Int
        def main(): Int
          var ids = vec_new<TestId>()
          ids.push(42)
          return 0
        end
        """, "expected element type")
    end

    it("Vec<Int> rejects TestId values (type safety)") do ->
      assert_compile_error("""
        newtype TestId = Int
        def main(): Int
          var ids = vec_new<Int>()
          var t: TestId = 10
          ids.push(t)
          return 0
        end
        """, "expected element type")
    end
  end

  describe("newtype in struct field") do ->
    it("stores and retrieves newtype from struct field") do ->
      var h = make_holder(42, "test")
      assert_eq(get_holder_id(h), 42)
    end

    it("accesses newtype field directly") do ->
      var h = TestHolder { id: 99, name: "direct" }
      assert_eq(h.id, 99)
    end
  end

  describe("newtype arithmetic") do ->
    it("supports arithmetic with Int") do ->
      var id: TestId = 10
      var result = id + 5
      assert_eq(result, 15)
    end

    it("supports comparison") do ->
      var a: TestId = 10
      var b: TestId = 10
      if a == b
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("cross-newtype rejection") do ->
    it("rejects mixing TestId and OtherId") do ->
      assert_compile_error("""
        newtype TestId = Int
        newtype OtherId = Int
        def main(): Int
          var a: TestId = 10
          var b: OtherId = a
          return b
        end
        """, "Type mismatch")
    end
  end

  describe("newtype function composition") do ->
    it("returns newtype from function") do ->
      var id: TestId = 42
      result = get_holder_id(make_holder(id, "test"))
      assert_eq(result, 42)
    end

    it("passes multiple distinct newtypes as params") do ->
      assert_compile_error("""
        newtype Meters = Int
        newtype Seconds = Int
        def speed(d: Meters, t: Seconds): Int = d / t
        def main(): Int
          var d: Meters = 100
          return speed(d, d)
        end
        """, "Type mismatch")
    end

    it("newtype preserves value through arithmetic chain") do ->
      var a: TestId = 10
      var b: TestId = 20
      result = a + b
      assert_eq(result, 30)
    end
  end

  return qspec_main()
end
