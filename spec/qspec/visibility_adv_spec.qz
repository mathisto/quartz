## Advanced Visibility Tests - Verifies priv section + per-item visibility
##
## Contract:
##   1. Private section: function after `private` keyword is private.
##   2. Per-item: `priv def` marks single function private.
##   3. Public access: functions before `private` are public.
##   4. Struct in section: struct after `private` keyword is private.
##   5. Next public: function after `priv def` is public.
##   6. Chain: fn after struct in private section stays private.
##   7. Priv enum: `priv enum` not accessible cross-module.
##   8. Multiple priv: multiple `priv def` coexist.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("private section visibility") do ->
    it("function after private keyword is private") do ->
      assert_multi_compile_error(priv_section_access(), 1, "has no function")
    end

    it("struct after private keyword is private") do ->
      assert_multi_compile_error(priv_section_struct(), 1, "Unknown struct")
    end

    it("function after struct in private section stays private") do ->
      assert_multi_compile_error(priv_section_fn_after_struct(), 1, "has no function")
    end
  end

  describe("per-item priv prefix") do ->
    it("priv def marks single function private") do ->
      assert_multi_compile_error(priv_prefix_single(), 1, "has no function")
    end

    it("function after priv def is public") do ->
      assert_multi_run_exits(priv_prefix_next_public(), 1, 42)
    end
  end

  describe("public access still works") do ->
    it("functions before private are public") do ->
      assert_multi_run_exits(public_before_private(), 1, 10)
    end
  end

  describe("priv enum and multi-priv") do ->
    it("priv enum is not accessible cross-module") do ->
      assert_multi_compile_error(priv_enum_cross_module(), 1, "Unknown enum")
    end

    it("multiple priv def coexist") do ->
      assert_multi_run_exits(multi_priv_coexist(), 1, 42)
    end
  end

  return qspec_main()
end

def priv_section_access(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib.qz"))
  vec_push(files, as_int("def public_fn(): Int = 10\nprivate\ndef secret(): Int = 42"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib\ndef main(): Int\n  return mylib::secret()\nend"))
  return files
end

def priv_section_struct(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib2.qz"))
  vec_push(files, as_int("def public_fn(): Int = 10\nprivate\nstruct Secret\n  val: Int\nend"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib2\ndef main(): Int\n  var s = mylib2::Secret { val: 1 }\n  return 0\nend"))
  return files
end

def priv_section_fn_after_struct(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib3.qz"))
  vec_push(files, as_int("def public_fn(): Int = 10\nprivate\nstruct Hidden\n  val: Int\nend\ndef also_hidden(): Int = 99"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib3\ndef main(): Int\n  return mylib3::also_hidden()\nend"))
  return files
end

def priv_prefix_single(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib4.qz"))
  vec_push(files, as_int("priv def secret(): Int = 42\ndef public_fn(): Int = 10"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib4\ndef main(): Int\n  return mylib4::secret()\nend"))
  return files
end

def priv_prefix_next_public(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib5.qz"))
  vec_push(files, as_int("priv def secret(): Int = 99\ndef get_val(): Int = 42"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib5\ndef main(): Int\n  return mylib5::get_val()\nend"))
  return files
end

def public_before_private(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib6.qz"))
  vec_push(files, as_int("def get_val(): Int = 10\nprivate\ndef secret(): Int = 42"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib6\ndef main(): Int\n  return mylib6::get_val()\nend"))
  return files
end

def priv_enum_cross_module(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib7.qz"))
  vec_push(files, as_int("priv enum Color\n  Red\n  Blue\nend\ndef public_fn(): Int = 10"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib7\ndef main(): Int\n  var c = mylib7::Color::Red\n  return 0\nend"))
  return files
end

def multi_priv_coexist(): Vec
  var files: Vec = vec_new()
  files.push(as_int("mylib8.qz"))
  vec_push(files, as_int("priv def secret1(): Int = 10\npriv def secret2(): Int = 32\ndef get_answer(): Int = 42"))
  files.push(as_int("main.qz"))
  vec_push(files, as_int("import mylib8\ndef main(): Int\n  return mylib8::get_answer()\nend"))
  return files
end
