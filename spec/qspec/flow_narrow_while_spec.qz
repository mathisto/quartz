## SURF.FLOW B2 — `while (x.some?)` loop-BODY narrowing (Phase 4, bounded).
##
## The `while` condition is re-evaluated at the top of EVERY iteration, so when the
## body executes the condition was JUST proven true — the then-fact holds at body-TOP,
## exactly like an `if`-then. This spec pins the BODY-ONLY narrowing:
##   - inside `while (o.some?) ... end`, a bare read of `o` in the body reads the
##     Option payload (the real inner value), not the raw Option word;
##   - `and`-chains narrow every conjunct in the body;
##   - the narrowing is BODY-ONLY — after `end` the subject is NOT narrowed (a `while`'s
##     after-loop state is not the negation: `break` can exit with the subject still
##     present, and normal exit only means the LAST condition eval was false);
##   - a mid-body MUTATION of the subject (reassignment) drops the fact mid-body via
##     the same invalidation hooks the if-then body uses.
##
## Behavioral signal (same as flow_narrow_p2_spec): no must-not-compile harness exists;
## the typechecker permissively accepts `Option<T>` where `T` is expected and produces a
## garbage raw-word at runtime. A CORRECT narrowing yields the exact inner value
## (payload); a CORRECT invalidation / no-narrow yields the raw garbage word (≠ payload).
## Tests assert determinate values where narrowing must fire, and `!= narrowed_value`
## where narrowing must be absent.
import * from qspec

def use_int(x: Int): Int = x + 100
def use_int_raw(x: Int): Int = x

# --- basic: `while (o.some?)` narrows o in the body; mutate to None to terminate ---

## Body reads o narrowed (payload), then reassigns o = None to terminate. One iteration:
## the read fires BEFORE the reassignment, so it sees the inner Int (7). Returns the
## narrowed read result; loop terminates because o becomes None.
def use_rec_basic(): Int
  var o: Option<Int> = option_some(7)
  var seen = 0
  while o.some?
    seen = use_int(o)          # o narrowed to Int → 7 + 100 = 107
    o = option_none()          # reassign terminates loop AND invalidates the fact
  end
  return seen
end

## Multi-iteration: decrement a payload each pass; body reads o narrowed each iteration.
## Start Some(3); each iter reads payload, accumulates, then rebuilds Some(payload-1)
## until payload hits 0 → set None. Accumulator proves the body-top read fired on every
## iteration with the correct (re-proven) payload.
def use_rec_multi(): Int
  var o: Option<Int> = option_some(3)
  var acc = 0
  while o.some?
    var p = use_int_raw(o)     # narrowed payload: 3, then 2, then 1
    acc = acc + p
    if p <= 1
      o = option_none()
    else
      o = option_some(p - 1)
    end
  end
  return acc                   # 3 + 2 + 1 = 6
end

## `while (o.some?)` where o is a niche Option<String>. Narrowed read passes the payload
## String; un-narrowed would pass a garbage pointer-ish word. Concatenate to prove the
## payload is the real inner string, then terminate.
def use_rec_niche_str(): String
  var os: Option<String> = option_some("hi")
  var r = "MISS"
  while os.some?
    r = os                     # os narrowed to String
    os = option_none()
  end
  return r
end

# --- and-chain: `while a.some? and b.some?` narrows BOTH in the body ---

## Both a and b are narrowed in the body; sum their payloads, then set a=None to
## terminate. Proves the and-chain THEN-facts compose for the while body.
def use_rec_and_chain(): Int
  var a: Option<Int> = option_some(10)
  var b: Option<Int> = option_some(20)
  var r = 0
  while a.some? and b.some?
    r = use_int_raw(a) + use_int_raw(b)   # 10 + 20 = 30
    a = option_none()
  end
  return r
end

# --- NEGATIVE: after the loop, x is NOT narrowed (body-only, no leak past `end`) ---

## After a `while (o.some?) ... end`, o is NOT narrowed. If we DON'T touch o inside the
## body except to terminate, then read o after `end`, the read must be the raw Option
## word, NOT the payload. Here o stays Some(42) across the (single) iteration but the
## loop terminates via a separate flag; after `end`, reading o as a bare Int must NOT
## equal the narrowed value 142 (use_int of the payload). Proves no after-loop narrow.
def use_rec_no_leak_after(): Int
  var o: Option<Int> = option_some(42)
  var run = true
  while run
    run = false                # terminate without touching o
  end
  # o is Some(42) here but the enclosing scope has NO narrow fact for it — the read is
  # the raw Option word, which for a spill Option<Int> is a garbage integer ≠ 142.
  return use_int(o)
end

## Sharper negative: the narrow lives ONLY in the while body. A read of o AFTER the loop
## must not see the payload. Same shape but the loop condition IS the guard (o.some?),
## and o is set None inside to terminate; after `end` o is None and un-narrowed — reading
## it as a bare Int is garbage, must NOT equal 100 (use_int of a 0 payload) nor the
## in-body narrowed 107.
def use_rec_after_guard_not_narrowed(): Int
  var o: Option<Int> = option_some(7)
  while o.some?
    o = option_none()
  end
  # after the loop o is None; there is NO after-loop narrow fact. use_int(o) reads the
  # raw None word (garbage), which must NOT equal the in-body narrowed value 107.
  return use_int(o)
end

# --- CONTROL: mid-body mutation invalidates within the same iteration ---

## Read o narrowed at body-top (107), then reassign o to Some(99), then read AGAIN. The
## second read must NOT reuse the stale body-top fact — the reassignment fires the
## invalidation hook, so the second read is the raw (un-narrowed) Option word, NOT 199.
## We terminate after one pass. Return 1 iff the second read did NOT equal 199 (i.e.
## invalidation fired), else 0.
def use_rec_midbody_invalidate(): Int
  var o: Option<Int> = option_some(7)
  var r = 0
  while o.some?
    var first = use_int(o)     # narrowed at body-top → 107 (sanity, not asserted here)
    o = option_some(99)        # reassignment MUST drop the narrow fact mid-body
    var second = use_int(o)    # must be the raw Option word, NOT 99 + 100 = 199
    if second == 199
      r = 0                    # stale fact reused → soundness bug
    else
      r = 1                    # invalidation fired correctly
    end
    o = option_none()          # terminate
  end
  return r
end

def main(): Int
  describe("SURF.FLOW B2 — while loop-body narrowing (basic)") do ->
    it("narrows o in the body of `while o.some?`") do ->
      assert_eq(use_rec_basic(), 107)
    end
    it("re-proves the payload each iteration (multi-pass)") do ->
      assert_eq(use_rec_multi(), 6)
    end
    it("narrows a niche Option<String> in the body") do ->
      assert_eq_str(use_rec_niche_str(), "hi")
    end
  end

  describe("SURF.FLOW B2 — while and-chain narrows both conjuncts in body") do ->
    it("narrows both a and b in `while a.some? and b.some?`") do ->
      assert_eq(use_rec_and_chain(), 30)
    end
  end

  describe("SURF.FLOW B2 — SOUNDNESS: body-only, no after-loop narrow") do ->
    it("does NOT narrow o after the loop (untouched subject)") do ->
      # raw Option word must not equal the narrowed value 142
      assert_eq(use_rec_no_leak_after() == 142, false)
    end
    it("does NOT narrow o after a `while o.some?` guard loop") do ->
      # after-loop read of a None subject must not equal the in-body narrowed 107
      assert_eq(use_rec_after_guard_not_narrowed() == 107, false)
    end
  end

  describe("SURF.FLOW B2 — CONTROL: mid-body mutation invalidates") do ->
    it("drops the narrow fact after a mid-body reassignment") do ->
      assert_eq(use_rec_midbody_invalidate(), 1)
    end
  end

  return qspec_main()
end
