import * from qspec

def main(): Int
  describe("sched_shutdown_graceful") do ->
    it("returns 0 when all tasks complete before timeout") do ->
      assert_eq(gs_clean_shutdown(), 0)
    end

    it("returns 0 immediately when no tasks are active") do ->
      assert_eq(gs_empty_shutdown(), 0)
    end

    it("returns 1 when CPU-bound task exceeds timeout") do ->
      assert_eq(gs_cpu_timeout(), 1)
    end
  end

  describe("sched_shutdown_on_signal") do ->
    it("installs signal handlers without crashing") do ->
      assert_eq(gs_signal_install(), 1)
    end

    it("sched_shutdown_requested returns 0 before signal") do ->
      assert_eq(gs_no_signal(), 0)
    end
  end

  describe("draining flag") do ->
    it("draining prevents new spawns after graceful") do ->
      assert_eq(gs_draining(), 42)
    end
  end

  return qspec_main()
end

def gs_clean_shutdown(): Int
  sched_init(2)
  var ch = channel_new(1)
  go do ->
    send(ch, 42)
  end
  var val = recv(ch)
  var result = sched_shutdown_graceful(5000)
  sched_shutdown()
  return result
end

def gs_empty_shutdown(): Int
  sched_init(2)
  var result = sched_shutdown_graceful(1000)
  sched_shutdown()
  return result
end

def gs_cpu_timeout(): Int
  sched_init(2)
  go do ->
    var i = 0
    for j in 0..1000000000
      i = i + 1
    end
  end
  # Note: sched_shutdown() after graceful timeout currently hangs
  # when tasks are still running — see P22 TODO for force-cancel mechanism
  return sched_shutdown_graceful(50)
end

def gs_signal_install(): Int
  sched_init(2)
  sched_shutdown_on_signal()
  sched_shutdown()
  return 1
end

def gs_no_signal(): Int
  sched_init(2)
  sched_shutdown_on_signal()
  var result = sched_shutdown_requested()
  sched_shutdown()
  return result
end

def gs_draining(): Int
  sched_init(2)
  var ch = channel_new(10)
  go do ->
    send(ch, 42)
  end
  var val = recv(ch)
  sched_shutdown_graceful(500)
  # After graceful, draining flag prevents new spawns
  go do ->
    send(ch, 99)
  end
  sched_shutdown()
  return val
end
