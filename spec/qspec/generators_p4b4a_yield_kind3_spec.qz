## Phase 4.B.4.a — NODE_YIELD routing through kind=3 effect machinery
##
## Operation Piezoelectric Effects, Phase 4 Path B, Milestone 4.B.4.a.
##
## This milestone routes `yield v` surface syntax through the kind=3
## effect dispatch when the enclosing function is a `can Yield<T>` helper
## (not an `impl Iterator<T>` generator — that lowering lands in 4.B.4.c).
## Originally landed under the `--piezo-gen-b` feature flag; the flag
## was retired in 4.B.6 and Path B is now the sole code path.
##
## What this spec pins down:
##
##   1. IR shape: `yield v` inside a `can Yield<Int>` helper emits
##      `__qz_effect_perform` with "yield" + "Yield" keys at the kind=3
##      dispatch site. Suspendable-leaf registration lifts the helper
##      through PASS 1.2a's `$poll` generation once `go` registers it
##      as an async target.
##   2. Runtime e2e: a helper that yields values under a user-installed
##      `with Yield { yield: h }` handler observes each value in order,
##      via `go + await` driving. The handler parks between yields using
##      `__qz_effect_suspend()` (the 4.B.3 primitive); scheduler reenqueues
##      the task; each subsequent poll advances one resume state. Body's
##      final return reaches the awaiter.
##
## Out of scope (covered by sibling 4.B.4.b/c/5/6 specs):
##
##   - `Stream<T>` struct + `.next()` consumer-drive surface (4.B.4.b).
##   - `impl Iterator<T>` $poll dispatch (4.B.4.c).
##   - `for-in` unification (4.B.5).
##   - Modular yield helpers called from inside impl-Iterator generators.
##
## Precedent: 4.B.3's `generators_p4b3_suspend_spec.qz` proved the
## primitive. This spec proves the surface syntax routes through it.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4.B.4.a — yield surface syntax through kind=3") do ->
    it("`yield v` in a `can Yield<Int>` helper emits __qz_effect_perform with op \"yield\"") do ->
      # A non-impl-Iterator helper with `can Yield<Int>` routes yield
      # through the kind=3 perform path. IR references the runtime
      # perform dispatcher and the "yield" op cstring.
      assert_ir_contains("""
def my_helper(): Int can Yield<Int>
  yield 42
  return 0
end

def main(): Int
  return 0
end
""", "__qz_effect_perform")
    end

    it("helper's effect-op key registered as \"yield\"") do ->
      # The op name cstring must reach codegen — grep the string table.
      assert_ir_contains("""
def my_helper(): Int can Yield<Int>
  yield 99
  return 0
end

def main(): Int
  return 0
end
""", "yield")
    end

    it("scheduler-driven yield + suspend observes every value in order") do ->
      # The runtime acceptance. `my_gen` declares `can Yield<Int>`; its
      # body yields 10, 20, 30 then returns 777. Handler `yield_capture`
      # stashes each value and parks via `__qz_effect_suspend()` (4.B.3
      # primitive, POLL_SUSPENDED=0). Scheduler reenqueues between yields;
      # each poll advances one resume state. Final return 777 lands via
      # task_done; awaiter reads body_rv.
      assert_run_stdout_eq("""
var _collected: Vec<Int> = vec_new<Int>()

def yield_capture(op_name: Int, argc: Int, argv: Int): Int
  var v = load(argv, 0)
  _collected.push(v)
  return __qz_effect_suspend()
end

def my_gen(): Int can Yield<Int>
  yield 10
  yield 20
  yield 30
  return 777
end

def my_gen_with_handler(): Int
  with Yield { yield: yield_capture } do ->
    return my_gen()
  end
end

def main(): Int
  sched_init(2)
  # Phase E.1.c: handler must be installed INSIDE the goroutine body.
  # Each scheduler worker has its own TLS effect stack; installing
  # `with Yield { yield: yield_capture }` on main isn't visible to
  # the worker that runs the goroutine. Wrap the call in a helper
  # that installs the handler before invoking my_gen — the install
  # then happens on the worker thread, where the perform-scan finds it.
  var fut = go my_gen_with_handler()
  var r = await fut
  puts(str_from_int(r))
  for v in _collected
    puts(str_from_int(v))
  end
  return 0
end
""", "777\n10\n20\n30\n")
    end
  end
  return qspec_main()
end
