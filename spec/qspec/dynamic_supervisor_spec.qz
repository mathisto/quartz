import * from qspec
import * from std/actor
import * from time

# ============================================================================
# C.14.3b — DynamicSupervisor (std/actor.qz)
#
# Spawn-on-demand supervised workers. Builds on the C.14.3a hashmap waiter
# table for scale: each spawn registers (@inbox | CLOSE_EVENT_BIT,
# watcher_frame) on the side-table, so any child's inbox close wakes the
# watcher within microseconds.
#
# Strategy is fixed `one_for_one` (per Elixir/Broadway — `one_for_all` at
# 5M children is a denial-of-service primitive).
#
# qspec lambda caveat: indirect actor-constructor calls
# (`var f = dsup.spawn_fn; f()` where f is a Fn(): Int closing over an
# actor constructor) inline-poll the actor's poll loop on the calling
# thread instead of spawning it as a real worker — sister to the
# `go fn()` qspec-lambda caveat (May 3 2026). Tests below cover the
# functional surface that does NOT depend on the spawned actor
# processing messages (alive counts, iter walks, stop semantics,
# intensity escalation). Full message-passing roundtrips +
# scale-to-100k live in spec/qz/dynamic_supervisor_smoke.qz +
# spec/qz/dynamic_supervisor_scale_smoke.qz, which run from
# `def main()` directly.
# ============================================================================

actor DynWorker
  var n: Int = 0
  def inc(): Void
    n += 1
  end
  def get(): Int = n
end

def spawn_dyn_worker(): Int = DynWorker()

def _qspec_is_slow(): Int = 1

def main(): Int
  describe("DynamicSupervisor (Phase 3 — one_for_one, spawn-on-demand)") do ->
    it("dynamic_supervisor_alive counts active (non-closed) children") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      assert_eq(dynamic_supervisor_alive(dsup), 0)
      dynamic_supervisor_spawn(dsup)
      dynamic_supervisor_spawn(dsup)
      dynamic_supervisor_spawn(dsup)
      assert_eq(dynamic_supervisor_alive(dsup), 3)
      dynamic_supervisor_stop(dsup)
      assert_eq(dynamic_supervisor_alive(dsup), 0)
    end

    it("dynamic_supervisor_iter walks every current child inbox") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      var inboxes = vec_new<Int>()
      inboxes.push(dynamic_supervisor_spawn(dsup))
      inboxes.push(dynamic_supervisor_spawn(dsup))
      inboxes.push(dynamic_supervisor_spawn(dsup))
      var visited = vec_new<Int>()
      dynamic_supervisor_iter(dsup, inbox -> visited.push(inbox))
      assert_eq(visited.size, 3)
      # Each visited handle should match one of the spawned inboxes.
      var matched = 0
      var i = 0
      while i < visited.size
        var v = visited[i]
        var j = 0
        while j < inboxes.size
          if v == inboxes[j]
            matched = matched + 1
          end
          j = j + 1
        end
        i = i + 1
      end
      assert_eq(matched, 3)
      dynamic_supervisor_stop(dsup)
    end

    it("dynamic_supervisor_alive is 1 while active, 0 after stop") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      dynamic_supervisor_spawn(dsup)
      assert_eq(dynamic_supervisor_alive(dsup), 1)
      dynamic_supervisor_stop(dsup)
      assert_eq(dynamic_supervisor_alive(dsup), 0)
    end

    it("dynamic_supervisor_stop is idempotent") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      dynamic_supervisor_spawn(dsup)
      dynamic_supervisor_stop(dsup)
      dynamic_supervisor_stop(dsup)  # second call: no-op
      assert_eq(dynamic_supervisor_alive(dsup), 0)
    end

    it("post-stop spawn returns 0 (rejected)") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      dynamic_supervisor_stop(dsup)
      assert_eq(dynamic_supervisor_spawn(dsup), 0)
    end

    it("restart_count is 0 immediately after construction") do ->
      var dsup = dynamic_supervisor_new(spawn_dyn_worker, 5, 10000)
      assert_eq(dynamic_supervisor_restart_count(dsup), 0)
      dynamic_supervisor_stop(dsup)
    end

    # Tests below would exercise the full message-passing + restart cycle
    # but require the spawned actors' poll loops to actually run on
    # worker threads — see qspec lambda caveat above. Pinned here as
    # documentation; covered in spec/qz/dynamic_supervisor_smoke.qz.
    it_pending("spawn returns fresh actor inbox (covered in spec/qz/dynamic_supervisor_smoke)")
    it_pending("on .stop() of a child, supervisor respawns into the same slot (covered in spec/qz/dynamic_supervisor_smoke)")
    it_pending("intensity escalation with real child deaths (covered in spec/qz/dynamic_supervisor_smoke)")
    it_pending("scale: 100k children spawned, alive==100k (covered in spec/qz/dynamic_supervisor_scale_smoke)")
  end
  return qspec_main()
end
