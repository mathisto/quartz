## Multi-arg effect ops — Milestone E(post) acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone E(post).
##
## D.5b threaded only arg0 through the runtime; E(post) extends to
## full argc/argv. Each call site stack-allocates a fresh
## `[argc x i64]` array, stores the evaluated Quartz arg registers,
## and passes (argc, argv_ptr) through `__qz_effect_perform` to the
## handler. User handlers decode via `load(argv, i)`.
##
## This spec covers:
##   - 2-arg ops (String + Int)
##   - 3-arg ops (Int + Int + Int)
##   - argc reported correctly to handler
##   - mixed-kind argv (String at [0], Int at [1]) roundtrips

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("multi-arg effect ops (piezo E(post))") do ->
    it("2-arg op: string + int, both readable by handler") do ->
      assert_run_stdout_eq("""
effect Log
  def emit2(s: String, n: Int): Int
end

def my_log(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  var n = load(argv, 1)
  puts("msg=" + s + " n=" + n.to_s())
  return 0
end

def main(): Int
  with Log { emit2: my_log } do ->
    emit2("hello", 42)
  end
  return 0
end
""", "msg=hello n=42\n")
    end

    it("3-arg op: ints threaded in the right order") do ->
      assert_run_stdout_eq("""
effect M
  def tri(a: Int, b: Int, c: Int): Int
end

def handler(op_name: Int, argc: Int, argv: Int): Int
  var a = load(argv, 0)
  var b = load(argv, 1)
  var c = load(argv, 2)
  puts("a=" + a.to_s() + " b=" + b.to_s() + " c=" + c.to_s())
  return 0
end

def main(): Int
  with M { tri: handler } do ->
    tri(10, 20, 30)
  end
  return 0
end
""", "a=10 b=20 c=30\n")
    end

    it("argc is reported correctly to handler") do ->
      assert_run_stdout_eq("""
effect Ar
  def op3(a: Int, b: Int, c: Int): Int
end

def handler(op_name: Int, argc: Int, argv: Int): Int
  puts("argc=" + argc.to_s())
  return 0
end

def main(): Int
  with Ar { op3: handler } do ->
    op3(1, 2, 3)
  end
  return 0
end
""", "argc=3\n")
    end

    it("multiple calls with different args all roundtrip") do ->
      assert_run_stdout_eq("""
effect Log
  def emit2(s: String, n: Int): Int
end

def my_log(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  var n = load(argv, 1)
  puts(s + ":" + n.to_s())
  return 0
end

def main(): Int
  with Log { emit2: my_log } do ->
    emit2("a", 1)
    emit2("b", 2)
    emit2("c", 3)
  end
  return 0
end
""", "a:1\nb:2\nc:3\n")
    end

    it("IR emits alloca for argv on a 2-arg op") do ->
      assert_ir_contains("""
effect Log
  def emit2(s: String, n: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int = 0

def main(): Int
  with Log { emit2: h } do ->
    emit2("x", 1)
  end
  return 0
end
""", ".argv = alloca i64, i64 2")
    end

    it("zero-arg op passes ptr null for argv") do ->
      # Piezo G.2 static fast path: direct handler call is
      # `@h(ptr <op_name>, i64 0, ptr null)` — no trailing kind arg
      # since the handler ABI doesn't need it (runtime uses kind for
      # longjmp routing; lexical sites know the kind at emit time).
      assert_ir_contains("""
effect Bell
  def signal(): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int = 0

def main(): Int
  with Bell { signal: h } do ->
    signal()
  end
  return 0
end
""", ", i64 0, ptr null)")
    end

    it("multi-arg op inside a multi-op handler record (H + E(post))") do ->
      # Exercises the intersection of Milestone H (multi-op dispatch
      # shim) and E(post) (multi-arg). The shim must forward argc+argv
      # to whichever user handler matches the op name.
      assert_run_stdout_eq("""
effect E
  def one(a: Int): Int
  def two(a: Int, b: Int): Int
end

def h_one(op_name: Int, argc: Int, argv: Int): Int
  puts("one:" + load(argv, 0).to_s())
  return 0
end

def h_two(op_name: Int, argc: Int, argv: Int): Int
  var a = load(argv, 0)
  var b = load(argv, 1)
  puts("two:" + a.to_s() + "," + b.to_s())
  return 0
end

def main(): Int
  with E { one: h_one, two: h_two } do ->
    one(7)
    two(11, 13)
  end
  return 0
end
""", "one:7\ntwo:11,13\n")
    end
  end
  return qspec_main()
end
