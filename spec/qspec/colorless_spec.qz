import * from qspec

# --- Test functions ---

def greet_async(): Int
  puts("async greet")
  return 42
end

def compute_value(x: Int): Int = x * 2

def print_go_func(): Void
  sched_init(2)
  var h = go greet_async()
  sched_shutdown()
end

def print_go_block(): Void
  sched_init(2)
  go do ->
    puts("from go block")
  end
  sched_shutdown()
end

def print_go_block_captures(): Void
  var msg = "captured value"
  sched_init(2)
  go do ->
    puts(msg)
  end
  sched_shutdown()
end

def print_effect_dump(): Void
  puts(to_str(compute_value(21)))
end

def main(): Int
  describe("colorless concurrency") do ->

    it("go func() with auto-registered targets") do ->
      assert_output("async greet\n", print_go_func)
    end

    it("go do ... end block syntax") do ->
      assert_output("from go block\n", print_go_block)
    end

    it("go do ... end captures outer variables") do ->
      assert_output("captured value\n", print_go_block_captures)
    end

    it("pure functions have no state machine overhead") do ->
      assert_eq(compute_value(21), 42)
    end

    it("auto-registered functions produce correct results") do ->
      assert_output("42\n", print_effect_dump)
    end

  end

  return qspec_main()
end
