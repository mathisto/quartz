## String-Keyed Map Tests
##
## Contract:
##   1. Basic string keys.
##   2. Complex string keys.
##   3. Computed string keys.

import * from qspec

def main(): Int
  describe("basic string keys") do ->
    it("supports single string key") do ->
      m = {"hello" => 42}
      match m.get("hello")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("supports multiple string keys") do ->
      m = {"hello" => 42, "world" => 99}
      var x = 0
      var y = 0
      match m.get("hello")
        Some(v) => x = v
        _ => assert_eq(0, 1)
      end
      match m.get("world")
        Some(v) => y = v
        _ => assert_eq(0, 1)
      end
      assert_eq(x + y - 100, 41)
    end

    it("supports three or more string keys") do ->
      m = {"a" => 1, "b" => 2, "c" => 3}
      var x = 0
      var y = 0
      var z = 0
      match m.get("a")
        Some(v) => x = v
        _ => assert_eq(0, 1)
      end
      match m.get("b")
        Some(v) => y = v
        _ => assert_eq(0, 1)
      end
      match m.get("c")
        Some(v) => z = v
        _ => assert_eq(0, 1)
      end
      assert_eq(x + y + z, 6)
    end
  end

  describe("complex string keys") do ->
    it("supports string keys with spaces") do ->
      m = {"hello world" => 42}
      match m.get("hello world")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("supports string keys with dashes") do ->
      m = {"key-with-dashes" => 42}
      match m.get("key-with-dashes")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end
  end

  describe("computed string keys") do ->
    it("supports variable as key") do ->
      key = "hello"
      m = {key => 42}
      match m.get("hello")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("supports function call as key") do ->
      m = {get_map_key() => 42}
      match m.get("hello")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end

    it("supports string concatenation as key") do ->
      m = {"hel" + "lo" => 42}
      match m.get("hello")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end

def get_map_key(): String
  return "hello"
end
