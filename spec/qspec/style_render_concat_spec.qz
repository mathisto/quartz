## Regression: STYLE_RENDER_CONCAT_CORRUPTION
##
## Two `Style.<preset>().render(...)` results concatenated directly with
## `+` SEGV'd or returned garbage before the fix. Root cause: typecheck
## rewrote the cross-module method-call's callee to bare `Style$render`
## but the registered function name is `style$Style$render`. MIR's
## `mir_infer_expr_type` exact-matched the bare name, missed the
## registration, and reported the var's type as unknown — causing the
## binary `+` to lower as raw `add i64` instead of `qz_str_concat`,
## which dereferenced the strings as pointers + corrupted the length
## prefix.
##
## Fixed in mir.qz `mir_infer_expr_type` by suffix-searching all_funcs
## when an already-qualified name doesn't exact-match — mirrors
## `mir_lower_call`'s existing fallback. Filed at
## `docs/bugs/done/STYLE_RENDER_CONCAT_CORRUPTION.md`.

import * from qspec
import * from style

def main(): Int
  describe("Style render concat (cross-module method-call type tracking)") do ->
    it("two Style.<preset>().render() concatenated directly preserves length") do ->
      var s1 = Style.success().render_at("AAA", 0)
      var s2 = Style.muted().render_at("BBB", 0)
      var s3 = s1 + s2
      # Pre-fix: this asserted 0 (silent) or SEGV'd (with TTY/depth).
      # Post-fix: correct concat — 6 bytes ("AAA" + "BBB").
      assert_eq(str_byte_len(s3), 6)
    end

    it("two Style.<preset>().render() concat through hoisted vars") do ->
      var sty1 = Style.success()
      var s1 = sty1.render_at("hello", 0)
      var sty2 = Style.muted()
      var s2 = sty2.render_at("world", 0)
      var s3 = s1 + s2
      assert_eq(str_byte_len(s3), 10)
    end

    it("Style.new().render() concat") do ->
      var s1 = Style.new().render_at("foo", 0)
      var s2 = Style.new().render_at("bar", 0)
      var s3 = s1 + s2
      assert_eq(str_byte_len(s3), 6)
    end

    it("four Style.<preset>().render() concatenated") do ->
      var s1 = Style.success().render_at("a", 0)
      var s2 = Style.warning().render_at("b", 0)
      var s3 = Style.error().render_at("c", 0)
      var s4 = Style.info().render_at("d", 0)
      var combined = s1 + s2 + s3 + s4
      assert_eq(str_byte_len(combined), 4)
    end

    it("render concat content matches when depth=0 (passthrough)") do ->
      var s1 = Style.success().render_at("hello", 0)
      var s2 = Style.muted().render_at("world", 0)
      var s3 = s1 + s2
      assert_eq_str(s3, "helloworld")
    end
  end

  return qspec_main()
end
