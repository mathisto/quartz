## @panic_handler Hook Tests (EPIC SYS.1 item 6)
##
## Contract:
##   1. A function annotated `@panic_handler` is registered in the
##      compiled program as the target for all panic sites. At each
##      panic call the compiler emits `call i64 @<handler>(i64 %msg)`
##      followed by `unreachable`, bypassing the libc-based
##      write/longjmp/exit path.
##   2. When NO @panic_handler is present, panic sites continue to
##      emit the default libc path (regression check for non-kernel
##      builds — host code must keep working).
##   3. Applying @panic_handler to a non-function definition is a
##      compile error.
##
## The kernel / unikernel / embedded use case is: define a handler
## that writes to UART / halts the CPU / cycles an LED, and the
## compiler routes every Quartz panic site to it. No libc needed.
import * from qspec

def main(): Int
  describe("@panic_handler hook") do ->
    it("panic call routes to registered handler when @panic_handler is set") do ->
      assert_ir_contains("""
@panic_handler
def my_handler(msg: String): Void
end

def main(): Int
  panic("oops")
  return 0
end
""", "call i64 @my_handler")
    end

    it("panic site emits unreachable after the handler call") do ->
      # The handler is noreturn by contract; the compiler marks
      # control flow after the call as unreachable so LLVM can
      # optimize / the verifier is satisfied.
      assert_ir_contains("""
@panic_handler
def my_handler(msg: String): Void
end

def main(): Int
  panic("oops")
  return 0
end
""", "unreachable")
    end

    it("libc panic path is SKIPPED when @panic_handler is set") do ->
      # The `panic_longjmp_` label is unique to the default panic
      # emission body — it exists nowhere else in the runtime or
      # prelude. With a handler registered, every panic site routes
      # to the handler, so this label must not appear. (Checking the
      # global `@.panic.prefix` or the `__qz_panic_jmpbuf_get` call
      # would give false positives: the former is an unconditional
      # runtime constant declaration, the latter is also used by the
      # scheduler's frame-level panic capture path.)
      assert_ir_not_contains("""
@panic_handler
def my_handler(msg: String): Void
end

def main(): Int
  panic("oops")
  return 0
end
""", "panic_longjmp_")
    end

    it("WITHOUT @panic_handler, default libc panic path is emitted") do ->
      # Regression check — host / non-kernel builds must continue
      # to use the existing panic path. The `panic_longjmp_` label
      # should appear at every panic site in the prelude and in
      # user code.
      assert_ir_contains("""
def main(): Int
  panic("oops")
  return 0
end
""", "panic_longjmp_")
    end

    it("@panic_handler on struct is rejected") do ->
      assert_compile_error("""
@panic_handler
struct Foo
  x: Int
end

def main(): Int = 0
""", "@panic_handler can only be applied to function definitions")
    end

    it("@panic_handler on enum is rejected") do ->
      assert_compile_error("""
@panic_handler
enum Bar
  A
  B
end

def main(): Int = 0
""", "@panic_handler can only be applied to function definitions")
    end
  end

  return qspec_main()
end
