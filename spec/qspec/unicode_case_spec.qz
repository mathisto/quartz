## Unicode Case Conversion and Classification Tests
##
## Contract:
##   1. Single-codepoint case conversion.
##   2. Full string case conversion (including 1-to-many).
##   3. Case-insensitive comparison.
##   4. Unicode character classification.

import * from qspec
import * from unicode

def main(): Int
  describe("unicode_uppercase / unicode_lowercase") do ->
    it("maps ASCII lowercase to uppercase") do ->
      assert_eq(unicode_uppercase(97), 65)
      assert_eq(unicode_uppercase(122), 90)
    end

    it("maps ASCII uppercase to lowercase") do ->
      assert_eq(unicode_lowercase(65), 97)
      assert_eq(unicode_lowercase(90), 122)
    end

    it("maps e-acute to E-acute") do ->
      assert_eq(unicode_uppercase(0xE9), 0xC9)
    end

    it("maps E-acute to e-acute") do ->
      assert_eq(unicode_lowercase(0xC9), 0xE9)
    end

    it("leaves digits unchanged") do ->
      assert_eq(unicode_uppercase(48), 48)
      assert_eq(unicode_lowercase(48), 48)
    end

    it("maps Greek lowercase to uppercase") do ->
      ## alpha U+03B1 -> U+0391
      assert_eq(unicode_uppercase(0x03B1), 0x0391)
      ## omega U+03C9 -> U+03A9
      assert_eq(unicode_uppercase(0x03C9), 0x03A9)
    end
  end

  describe("unicode_to_upper") do ->
    it("converts ASCII string") do ->
      assert_eq_str(unicode_to_upper("hello"), "HELLO")
    end

    it("converts Latin-1 accented string") do ->
      ## "café" -> "CAFÉ"
      var sb = sb_new()
      sb_append(sb, "caf")
      sb_append_char(sb, 0xE9)
      var input = sb_to_string(sb)

      var sb2 = sb_new()
      sb_append(sb2, "CAF")
      sb_append(sb2, str_from_codepoint(0xC9))
      var expected = sb_to_string(sb2)

      assert_eq_str(unicode_to_upper(input), expected)
    end

    it("handles sharp s to SS (1-to-many)") do ->
      ## ß (U+00DF) -> SS
      var input = str_from_codepoint(0xDF)
      assert_eq_str(unicode_to_upper(input), "SS")
    end

    it("preserves already-uppercase") do ->
      assert_eq_str(unicode_to_upper("ABC"), "ABC")
    end

    it("handles empty string") do ->
      assert_eq_str(unicode_to_upper(""), "")
    end
  end

  describe("unicode_to_lower") do ->
    it("converts ASCII string") do ->
      assert_eq_str(unicode_to_lower("HELLO"), "hello")
    end

    it("converts Latin-1 accented string") do ->
      var sb = sb_new()
      sb_append(sb, "CAF")
      sb_append_char(sb, 0xC9)
      var input = sb_to_string(sb)

      var sb2 = sb_new()
      sb_append(sb2, "caf")
      sb_append(sb2, str_from_codepoint(0xE9))
      var expected = sb_to_string(sb2)

      assert_eq_str(unicode_to_lower(input), expected)
    end

    it("preserves already-lowercase") do ->
      assert_eq_str(unicode_to_lower("abc"), "abc")
    end
  end

  describe("unicode_eq_ignore_case") do ->
    it("matches same-case strings") do ->
      assert_eq(unicode_eq_ignore_case("hello", "hello"), true)
    end

    it("matches different-case ASCII") do ->
      assert_eq(unicode_eq_ignore_case("Hello", "hELLO"), true)
    end

    it("matches different-case with accents") do ->
      var sb1 = sb_new()
      sb_append(sb1, "caf")
      sb_append(sb1, str_from_codepoint(0xE9))
      var lower = sb_to_string(sb1)

      var sb2 = sb_new()
      sb_append(sb2, "CAF")
      sb_append(sb2, str_from_codepoint(0xC9))
      var upper = sb_to_string(sb2)

      assert_eq(unicode_eq_ignore_case(lower, upper), true)
    end

    it("rejects different strings") do ->
      assert_eq(unicode_eq_ignore_case("hello", "world"), false)
    end
  end

  describe("unicode classification") do ->
    it("identifies alphabetic characters") do ->
      assert_eq(unicode_is_alphabetic(65), true)
      assert_eq(unicode_is_alphabetic(122), true)
      assert_eq(unicode_is_alphabetic(0xE9), true)
      assert_eq(unicode_is_alphabetic(48), false)
      assert_eq(unicode_is_alphabetic(32), false)
    end

    it("identifies numeric digits") do ->
      assert_eq(unicode_is_numeric(48), true)
      assert_eq(unicode_is_numeric(57), true)
      assert_eq(unicode_is_numeric(65), false)
      ## Arabic-Indic digit 1 (U+0661)
      assert_eq(unicode_is_numeric(0x0661), true)
    end

    it("identifies whitespace") do ->
      assert_eq(unicode_is_whitespace(32), true)
      assert_eq(unicode_is_whitespace(9), true)
      assert_eq(unicode_is_whitespace(10), true)
      assert_eq(unicode_is_whitespace(13), true)
      assert_eq(unicode_is_whitespace(65), false)
    end

    it("identifies uppercase characters") do ->
      assert_eq(unicode_is_uppercase(65), true)
      assert_eq(unicode_is_uppercase(90), true)
      assert_eq(unicode_is_uppercase(97), false)
      assert_eq(unicode_is_uppercase(0xC9), true)
    end

    it("identifies lowercase characters") do ->
      assert_eq(unicode_is_lowercase(97), true)
      assert_eq(unicode_is_lowercase(122), true)
      assert_eq(unicode_is_lowercase(65), false)
      assert_eq(unicode_is_lowercase(0xE9), true)
    end

    it("identifies alphanumeric") do ->
      assert_eq(unicode_is_alphanumeric(65), true)
      assert_eq(unicode_is_alphanumeric(48), true)
      assert_eq(unicode_is_alphanumeric(32), false)
    end
  end

  return qspec_main()
end
