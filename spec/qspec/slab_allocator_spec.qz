## Slab Allocator Tests
##
## Contract:
##   1. Allocates non-zero pointer.
##   2. Builds linked list using.
##   3. Creates an allocator.
##   4. Destroy does not crash.
##   5. Grows when slab is.
##   6. Returns distinct pointers.
import * from qspec

struct SlabAllocator
  first_slab: Int
  block_size: Int
  blocks_per_slab: Int
  total_allocs: Int
  total_frees: Int
end

def slab_init_chunk(block_size: Int, blocks_per_slab: Int): Int
  var words = 5 + block_size * blocks_per_slab
  var chunk = mem_alloc(words * 8)
  store(chunk, 0, 0)
  store(chunk, 1, blocks_per_slab)
  store(chunk, 2, block_size)
  store(chunk, 4, 0)
  var data_base = chunk + 5 * 8
  var i = 0
  while i < blocks_per_slab
    var block_ptr = data_base + i * block_size * 8
    if i + 1 < blocks_per_slab
      var next_block = data_base + (i + 1) * block_size * 8
      store(block_ptr, 0, next_block)
    else
      store(block_ptr, 0, 0)
    end
    i += 1
  end
  store(chunk, 3, data_base)
  return chunk
end

def slab_new(block_size: Int, blocks_per_slab: Int): SlabAllocator
  var chunk = slab_init_chunk(block_size, blocks_per_slab)
  return SlabAllocator { first_slab: chunk, block_size: block_size, blocks_per_slab: blocks_per_slab, total_allocs: 0, total_frees: 0 }
end

extend SlabAllocator
  def alloc(&mut self): Int
    var chunk = self.first_slab
    while chunk != 0
      var free_head = load(chunk, 3)
      if free_head != 0
        var next_free = load(free_head, 0)
        store(chunk, 3, next_free)
        var used = load(chunk, 4)
        store(chunk, 4, used + 1)
        self.total_allocs = self.total_allocs + 1
        return free_head
      end
      chunk = load(chunk, 0)
    end
    var new_chunk = slab_init_chunk(self.block_size, self.blocks_per_slab)
    store(new_chunk, 0, self.first_slab)
    self.first_slab = new_chunk
    var free_head2 = load(new_chunk, 3)
    var next_free2 = load(free_head2, 0)
    store(new_chunk, 3, next_free2)
    store(new_chunk, 4, 1)
    self.total_allocs = self.total_allocs + 1
    return free_head2
  end

  def free(&mut self, ptr: Int): Void
    var chunk = self.first_slab
    while chunk != 0
      var data_base = chunk + 5 * 8
      var cap = load(chunk, 1)
      var bsz = load(chunk, 2)
      var data_end = data_base + cap * bsz * 8
      if ptr >= data_base
        if ptr < data_end
          var old_head = load(chunk, 3)
          store(ptr, 0, old_head)
          store(chunk, 3, ptr)
          var used = load(chunk, 4)
          store(chunk, 4, used - 1)
          self.total_frees = self.total_frees + 1
          return
        end
      end
      chunk = load(chunk, 0)
    end
  end

  def stats_allocated(self): Int = self.total_allocs
  def stats_freed(self): Int = self.total_frees
  def stats_in_use(self): Int = self.total_allocs - self.total_frees

  def stats_slab_count(self): Int
    var count = 0
    var chunk = self.first_slab
    while chunk != 0
      count += 1
      chunk = load(chunk, 0)
    end
    return count
  end

  def destroy(&mut self): Void
    self.first_slab = 0
  end
end

def main(): Int
  describe("slab allocator") do ->
    it("creates an allocator") do ->
      assert_output("1\n", sl_create_test)
    end
    it("allocates non-zero pointer") do ->
      assert_output("1\n", sl_nonzero_test)
    end
    it("returns distinct pointers") do ->
      assert_output("1\n", sl_distinct_test)
    end
    it("reuses freed blocks (LIFO)") do ->
      assert_output("1\n", sl_lifo_test)
    end
    it("grows when slab is exhausted") do ->
      assert_output("2\n", sl_grow_test)
    end
    it("writes and reads through allocated blocks") do ->
      assert_output("1000\n", sl_readwrite_test)
    end
    it("tracks allocation stats") do ->
      assert_output("3 1 2", sl_stats_test)
    end
    it("survives 100 alloc/free cycles") do ->
      assert_output("100 100", sl_cycles_test)
    end
    it("builds linked list using slab nodes") do ->
      assert_output("15\n", sl_linked_list_test)
    end
    it("destroy does not crash") do ->
      assert_output("ok\n", sl_destroy_test)
    end
  end
  return qspec_main()
end

def sl_create_test(): Void
  var s = slab_new(4, 8)
  print_int(s.stats_slab_count())
end

def sl_nonzero_test(): Void
  var s = slab_new(4, 8)
  var ptr = s.alloc()
  if ptr != 0
    print_int(1)
  else
    print_int(0)
  end
end

def sl_distinct_test(): Void
  var s = slab_new(4, 8)
  var a = s.alloc()
  var b = s.alloc()
  var c = s.alloc()
  if a != b
    if b != c
      if a != c
        print_int(1)
        return
      end
    end
  end
  print_int(0)
end

def sl_lifo_test(): Void
  var s = slab_new(4, 8)
  var a = s.alloc()
  s.free(a)
  var b = s.alloc()
  if a == b
    print_int(1)
  else
    print_int(0)
  end
end

def sl_grow_test(): Void
  var s = slab_new(2, 4)
  s.alloc()
  s.alloc()
  s.alloc()
  s.alloc()
  var ptr = s.alloc()
  if ptr != 0
    print_int(s.stats_slab_count())
  else
    print_int(0)
  end
end

def sl_readwrite_test(): Void
  var s = slab_new(4, 8)
  var ptr = s.alloc()
  store(ptr, 0, 100)
  store(ptr, 1, 200)
  store(ptr, 2, 300)
  store(ptr, 3, 400)
  var sum = load(ptr, 0) + load(ptr, 1) + load(ptr, 2) + load(ptr, 3)
  print_int(sum)
end

def sl_stats_test(): Void
  var s = slab_new(2, 4)
  s.alloc()
  s.alloc()
  var ptr = s.alloc()
  s.free(ptr)
  print("#{s.stats_allocated()}")
  print(" ")
  print("#{s.stats_freed()}")
  print(" ")
  print("#{s.stats_in_use()}")
end

def sl_cycles_test(): Void
  var s = slab_new(2, 8)
  var i = 0
  while i < 100
    var ptr = s.alloc()
    store(ptr, 0, i)
    store(ptr, 1, i * 2)
    if load(ptr, 0) != i
      print_int(-1)
      return
    end
    s.free(ptr)
    i += 1
  end
  print("#{s.stats_allocated()}")
  print(" ")
  print("#{s.stats_freed()}")
end

def sl_linked_list_test(): Void
  var s = slab_new(2, 16)
  var head = 0
  var i = 1
  while i <= 5
    var node = s.alloc()
    store(node, 0, i)
    store(node, 1, head)
    head = node
    i += 1
  end
  var sum = 0
  var cur = head
  while cur != 0
    sum += load(cur, 0)
    cur = load(cur, 1)
  end
  print_int(sum)
end

def sl_destroy_test(): Void
  var s = slab_new(4, 8)
  s.alloc()
  s.alloc()
  s.destroy()
  puts("ok")
end
