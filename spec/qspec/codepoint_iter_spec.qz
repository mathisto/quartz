## Codepoint Iterator Tests
##
## Contract:
##   1. CodepointIter — zero-allocation lazy codepoint iteration.
##   2. CharIndexIter — byte offset + codepoint pairs.
##   3. Accessor helpers for packed values.
##
import * from qspec
import * from unicode
import traits

## Build "h" + U+00E9 (e-acute) + "llo" = 5 codepoints, 6 bytes
def build_hello(): String
  var sb = sb_new()
  sb_append(sb, "h")
  sb_append_char(sb, 233)
  sb_append(sb, "llo")
  return sb_to_string(sb)
end

## Build mixed-width string: A(1 byte) + e-acute(2) + CJK(3) + emoji(4)
def build_mixed(): String
  var sb = sb_new()
  sb_append(sb, "A")
  sb_append_char(sb, 233)
  sb_append_char(sb, 0x4E2D)
  sb_append_char(sb, 0x1F600)
  return sb_to_string(sb)
end

def main(): Int
  describe("CodepointIter") do ->
    it("iterates ASCII codepoints") do ->
      var cps = vec_new()
      for cp in str_codepoints("ABC")
        cps.push(cp)
      end
      assert_eq(cps.size, 3)
      assert_eq(cps[0], 65)
      assert_eq(cps[1], 66)
      assert_eq(cps[2], 67)
    end

    it("iterates 2-byte UTF-8 codepoints") do ->
      var s = build_hello()
      var cps = vec_new()
      for cp in str_codepoints(s)
        cps.push(cp)
      end
      assert_eq(cps.size, 5)
      assert_eq(cps[0], 104)
      assert_eq(cps[1], 233)
      assert_eq(cps[2], 108)
      assert_eq(cps[3], 108)
      assert_eq(cps[4], 111)
    end

    it("iterates 3-byte UTF-8 codepoints") do ->
      var s = str_from_codepoint(0x4E2D)
      var cps = vec_new()
      for cp in str_codepoints(s)
        cps.push(cp)
      end
      assert_eq(cps.size, 1)
      assert_eq(cps[0], 0x4E2D)
    end

    it("iterates 4-byte UTF-8 codepoints") do ->
      var s = str_from_codepoint(0x1F600)
      var cps = vec_new()
      for cp in str_codepoints(s)
        cps.push(cp)
      end
      assert_eq(cps.size, 1)
      assert_eq(cps[0], 0x1F600)
    end

    it("handles empty string") do ->
      var count = 0
      for cp in str_codepoints("")
        count += 1
      end
      assert_eq(count, 0)
    end

    it("iterates mixed byte-widths") do ->
      var s = build_mixed()
      var cps = vec_new()
      for cp in str_codepoints(s)
        cps.push(cp)
      end
      assert_eq(cps.size, 4)
      assert_eq(cps[0], 65)
      assert_eq(cps[1], 233)
      assert_eq(cps[2], 0x4E2D)
      assert_eq(cps[3], 0x1F600)
    end

    it("break mid-iteration") do ->
      var count = 0
      for cp in str_codepoints("ABCDEF")
        count += 1
        if count == 3
          break
        end
      end
      assert_eq(count, 3)
    end

    it("count matches str_size") do ->
      var s = build_hello()
      var count = 0
      for cp in str_codepoints(s)
        count += 1
      end
      assert_eq(count, str_size(s))
    end
  end

  describe("CharIndexIter") do ->
    it("yields correct byte offsets for ASCII") do ->
      var offsets = vec_new()
      for pair in str_char_indices("ABC")
        offsets.push(char_index_offset(pair))
      end
      assert_eq(offsets.size, 3)
      assert_eq(offsets[0], 0)
      assert_eq(offsets[1], 1)
      assert_eq(offsets[2], 2)
    end

    it("yields correct byte offsets for multibyte") do ->
      ## A(1 byte) + e-acute(2) + CJK(3) + emoji(4) = offsets 0,1,3,6
      var s = build_mixed()
      var offsets = vec_new()
      var cps = vec_new()
      for pair in str_char_indices(s)
        offsets.push(char_index_offset(pair))
        cps.push(char_index_codepoint(pair))
      end
      assert_eq(offsets.size, 4)
      assert_eq(offsets[0], 0)
      assert_eq(offsets[1], 1)
      assert_eq(offsets[2], 3)
      assert_eq(offsets[3], 6)
      assert_eq(cps[0], 65)
      assert_eq(cps[1], 233)
      assert_eq(cps[2], 0x4E2D)
      assert_eq(cps[3], 0x1F600)
    end

    it("accessor round-trips packed value") do ->
      var packed = (5 << 21) | 233
      assert_eq(char_index_offset(packed), 5)
      assert_eq(char_index_codepoint(packed), 233)
    end

    it("handles empty string") do ->
      var count = 0
      for pair in str_char_indices("")
        count += 1
      end
      assert_eq(count, 0)
    end
  end

  return qspec_main()
end
