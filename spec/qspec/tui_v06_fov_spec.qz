## QSpec coverage for std/tui/fov.qz — Phase 6.5 of the v0.6 cell engine.
##
## Coverage:
##   - fov_int_sqrt: 0, perfect squares, non-perfect, large values
##   - Origin always visited at distance 0
##   - radius=0 visits origin only (1 cell)
##   - radius=-1 visits nothing (defensive)
##   - radius=1 in open field visits exactly 5 cells
##     (origin + 4 cardinals; diagonals at distance √2 are outside)
##   - radius=2 in open field visits exactly 13 cells
##   - Each cell visited exactly once (no diagonal duplicates between
##     adjacent quadrants — the property that broke many naive
##     4-quadrant FOV implementations before Albert Ford 2019)
##   - Wall at (3, 3) hides cell (5, 5) on the same SE diagonal
##   - Wall column casts a shadow cone behind it
##   - Distance values match integer-truncated Euclidean distance
##   - Symmetric: A sees B iff B sees A
##
## See docs/design/TUI_V06_CELL_ENGINE.md D5 for the design rationale,
## and Albert Ford's 2019 article "Symmetric Shadowcasting" for the
## algorithm.

import * from qspec
import std/tui/fov as fv

# =============================================================================
# Helpers — blocks predicates and accumulator state
# =============================================================================

## Open field: no cell blocks light.
def _block_none(x: Int, y: Int): Bool = false

## Single wall at (3, 3) — used to test SE-diagonal occlusion.
def _block_at_3_3(x: Int, y: Int): Bool = x == 3 and y == 3

## Wall column at x=4 — used for shadow-cone tests.
def _block_col_4(x: Int, y: Int): Bool = x == 4

# Module-level accumulators — set/reset per `it` block by helper
# functions and read after the FOV walk. Module-level state is the
# canonical Quartz pattern for collecting closure callback results
# (closures can mutate but cannot return out of the FOV walker).

var __fov_count = 0
var __fov_keys = vec_new<Int>()
var __fov_distances = vec_new<Int>()

def _fov_reset(): Void
  __fov_count = 0
  __fov_keys = vec_new<Int>()
  __fov_distances = vec_new<Int>()
end

def _key(x: Int, y: Int): Int
  # Pack (x, y) into a single Int. x, y in [-1000, 1000] for tests.
  return (x + 10000) * 100000 + (y + 10000)
end

def _visit(x: Int, y: Int, d: Int): Void
  __fov_count += 1
  __fov_keys.push(_key(x, y))
  __fov_distances.push(d)
end

def _has_key(k: Int): Bool
  var n = __fov_keys.size
  var i = 0
  while i < n
    if __fov_keys[i] == k
      return true
    end
    i += 1
  end
  return false
end

def _seen(x: Int, y: Int): Bool
  return _has_key(_key(x, y))
end

def _count_key(k: Int): Int
  var n = __fov_keys.size
  var i = 0
  var cnt = 0
  while i < n
    if __fov_keys[i] == k
      cnt += 1
    end
    i += 1
  end
  return cnt
end

# =============================================================================
# Spec body
# =============================================================================

def main(): Int
  describe("fov_int_sqrt — integer Newton's method") do ->
    it("0, 1, 4 perfect squares") do ->
      assert_eq(fv::fov_int_sqrt(0), 0)
      assert_eq(fv::fov_int_sqrt(1), 1)
      assert_eq(fv::fov_int_sqrt(4), 2)
      assert_eq(fv::fov_int_sqrt(9), 3)
      assert_eq(fv::fov_int_sqrt(16), 4)
      assert_eq(fv::fov_int_sqrt(25), 5)
      assert_eq(fv::fov_int_sqrt(100), 10)
    end

    it("non-perfect squares truncate") do ->
      assert_eq(fv::fov_int_sqrt(2), 1)
      assert_eq(fv::fov_int_sqrt(3), 1)
      assert_eq(fv::fov_int_sqrt(15), 3)
      assert_eq(fv::fov_int_sqrt(99), 9)
    end

    it("negative input returns 0") do ->
      assert_eq(fv::fov_int_sqrt(-1), 0)
      assert_eq(fv::fov_int_sqrt(-100), 0)
    end
  end

  describe("fov_for_each_visible — origin behavior") do ->
    it("radius=0 visits exactly origin") do ->
      _fov_reset()
      fv::fov_for_each_visible(5, 5, 0, _block_none, _visit)
      assert_eq(__fov_count, 1)
      var s = _seen(5, 5)
      if s
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("radius=-1 visits nothing") do ->
      _fov_reset()
      fv::fov_for_each_visible(5, 5, -1, _block_none, _visit)
      assert_eq(__fov_count, 0)
    end

    it("origin reported with distance 0") do ->
      _fov_reset()
      fv::fov_for_each_visible(7, 7, 5, _block_none, _visit)
      # First call should be origin, distance 0.
      assert_eq(__fov_distances[0], 0)
      assert_eq(__fov_keys[0], _key(7, 7))
    end
  end

  describe("fov_for_each_visible — open field disk shape") do ->
    it("radius=1 visits exactly 5 cells (origin + 4 cardinals)") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 1, _block_none, _visit)
      assert_eq(__fov_count, 5)
      # Check the 5 expected cells are seen.
      var checks = _seen(0, 0) and _seen(1, 0) and _seen(-1, 0) and _seen(0, 1) and _seen(0, -1)
      if checks
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Diagonals NOT seen (distance √2 > 1).
      var ne = _seen(1, 1)
      var nw = _seen(-1, 1)
      var se = _seen(1, -1)
      var sw = _seen(-1, -1)
      if ne or nw or se or sw
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("radius=2 visits exactly 13 cells") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 2, _block_none, _visit)
      # Expected: dist² ≤ 4. Cells: (0,0)=0, ±cardinal=1 (4), ±diagonal=2 (4),
      # ±2-cardinal=4 (4). Total 1+4+4+4 = 13.
      assert_eq(__fov_count, 13)
      # No cell visited twice.
      var n = __fov_keys.size
      var i = 0
      var max_count = 1
      while i < n
        var c = _count_key(__fov_keys[i])
        if c > max_count
          max_count = c
        end
        i += 1
      end
      assert_eq(max_count, 1)
    end

    it("each cell visited exactly once at radius=4") do ->
      _fov_reset()
      fv::fov_for_each_visible(10, 10, 4, _block_none, _visit)
      # Verify no duplicates by checking each key appears exactly once.
      var n = __fov_keys.size
      var i = 0
      var max_count = 1
      while i < n
        var c = _count_key(__fov_keys[i])
        if c > max_count
          max_count = c
        end
        i += 1
      end
      assert_eq(max_count, 1)
    end

    it("cells beyond Euclidean radius not visited") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 3, _block_none, _visit)
      # (3, 3) at distance √18 ≈ 4.24 > 3 → not visited.
      var s33 = _seen(3, 3)
      if s33
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      # (3, 0) at distance 3 IS visited (boundary).
      var s30 = _seen(3, 0)
      if s30
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("fov_for_each_visible — distance reporting") do ->
    it("distance is integer-truncated Euclidean") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 5, _block_none, _visit)
      # Find specific cells and check distances.
      var n = __fov_keys.size
      var i = 0
      var dist_3_4 = -1   # cell (3, 4): d² = 25, d = 5
      var dist_2_2 = -1   # cell (2, 2): d² = 8, d = 2 (truncated)
      var dist_1_0 = -1   # cell (1, 0): d² = 1, d = 1
      while i < n
        var k = __fov_keys[i]
        if k == _key(3, 4)
          dist_3_4 = __fov_distances[i]
        end
        if k == _key(2, 2)
          dist_2_2 = __fov_distances[i]
        end
        if k == _key(1, 0)
          dist_1_0 = __fov_distances[i]
        end
        i += 1
      end
      assert_eq(dist_3_4, 5)
      assert_eq(dist_2_2, 2)
      assert_eq(dist_1_0, 1)
    end
  end

  describe("fov_for_each_visible — wall occlusion") do ->
    it("wall at (3,3) hides cell (5,5) on SE diagonal") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 8, _block_at_3_3, _visit)
      # The wall itself IS visible.
      var w = _seen(3, 3)
      if w
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Cells past the wall on the SE diagonal are NOT visible.
      var s44 = _seen(4, 4)
      var s55 = _seen(5, 5)
      if s44 or s55
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
    end

    it("wall column blocks cells past it") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 8, _block_col_4, _visit)
      # Wall column itself visible (cells at x=4).
      var s40 = _seen(4, 0)
      if s40
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      # Cells past column not visible.
      var s50 = _seen(5, 0)
      var s60 = _seen(6, 0)
      if s50 or s60
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      # Cells in front of column ARE visible.
      var s30 = _seen(3, 0)
      var s20 = _seen(2, 0)
      if s30 and s20
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("fov_for_each_visible — symmetry property") do ->
    # The defining property of Albert Ford's 2019 algorithm: A sees B
    # iff B sees A. We test this by running FOV from a few different
    # origins and checking that every visible cell, when used as
    # origin, can see the previous origin back.
    it("A sees B iff B sees A — open field") do ->
      _fov_reset()
      fv::fov_for_each_visible(5, 5, 4, _block_none, _visit)
      # Capture cells visible from (5, 5).
      var visible_from_5_5 = vec_new<Int>()
      var n = __fov_keys.size
      var i = 0
      while i < n
        visible_from_5_5.push(__fov_keys[i])
        i += 1
      end
      # For each visible cell, run FOV from it and verify (5, 5) is in result.
      var pass = true
      var j = 0
      var m = visible_from_5_5.size
      while j < m
        var k = visible_from_5_5[j]
        var bx = (k / 100000) - 10000
        var by = (k % 100000) - 10000
        _fov_reset()
        fv::fov_for_each_visible(bx, by, 4, _block_none, _visit)
        var sees_back = _seen(5, 5)
        if not sees_back
          pass = false
        end
        j += 1
      end
      if pass
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("A sees B iff B sees A — with wall at (3, 3)") do ->
      _fov_reset()
      fv::fov_for_each_visible(0, 0, 6, _block_at_3_3, _visit)
      var visible_from_origin = vec_new<Int>()
      var n = __fov_keys.size
      var i = 0
      while i < n
        visible_from_origin.push(__fov_keys[i])
        i += 1
      end
      var pass = true
      var j = 0
      var m = visible_from_origin.size
      while j < m
        var k = visible_from_origin[j]
        var bx = (k / 100000) - 10000
        var by = (k % 100000) - 10000
        _fov_reset()
        fv::fov_for_each_visible(bx, by, 6, _block_at_3_3, _visit)
        var sees_back = _seen(0, 0)
        if not sees_back
          pass = false
        end
        j += 1
      end
      if pass
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  return qspec_main()
end
