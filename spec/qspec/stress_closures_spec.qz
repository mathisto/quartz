## STRESS: Closure Edge Cases
##
## Adversarial tests probing closure dark corners:
## capturing many variables, nested closures, closures as struct fields,
## passing through call layers, interaction with move semantics and borrows.
##
## Contract:
##   1. Closures: many captures.
##   2. Closures: nesting.
##   3. Closures: as struct fields.
##   4. Closures: through call layers.
##   5. Closures: capture semantics.
##   6. Closures: higher-order stress.
##   7. Closures: control flow interaction.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Closures Capturing Many Variables
  # ===========================================================================
  describe("closures: many captures") do ->
    it("closure capturing 5 variables") do ->
      assert_run_exits("""
        def make_fn(a: Int, b: Int, c: Int, d: Int, e: Int): Fn(): Int
          return -> a + b + c + d + e
        end
        def main(): Int
          f = make_fn(10, 8, 12, 7, 5)
          return f()
        end
        """, 42)
    end

    it("closure capturing 8 variables") do ->
      assert_run_exits("""
        def make_fn(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int): Fn(): Int
          return -> a + b + c + d + e + f + g + h
        end
        def main(): Int
          f = make_fn(1, 2, 3, 4, 5, 6, 7, 14)
          return f()
        end
        """, 42)
    end

    it("closure with mixed capture and parameter") do ->
      assert_run_exits("""
        def make_adder(base: Int): Fn(Int): Int
          return (x: Int) -> base + x
        end
        def main(): Int
          add20 = make_adder(20)
          return add20(22)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Nested Closures
  # ===========================================================================
  describe("closures: nesting") do ->
    it("closure capturing another closure") do ->
      assert_run_exits("""
        def main(): Int
          inner = -> 42
          outer = -> inner()
          return outer()
        end
        """, 42)
    end

    it("two-level nested closure: outer captures local") do ->
      assert_run_exits("""
        def make_nested(x: Int): Fn(): Int
          inner = -> x + 1
          return -> inner() + 1
        end
        def main(): Int
          f = make_nested(40)
          return f()
        end
        """, 42)
    end

    it("three-level nested closure chain") do ->
      assert_run_exits("""
        def main(): Int
          x = 40
          f1 = -> x + 1
          f2 = -> f1() + 1
          return f2()
        end
        """, 42)
    end

    it("closure returned from function, called in another scope") do ->
      assert_run_exits("""
        def make_counter(start: Int): Fn(): Int
          return -> start
        end
        def main(): Int
          get_val = make_counter(42)
          return get_val()
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Closures as Struct Fields
  # ===========================================================================
  describe("closures: as struct fields") do ->
    it("struct with Fn field, called via dot syntax") do ->
      assert_run_exits("""
        struct Callback
          action: Fn(): Int
        end
        def main(): Int
          cb = Callback { action: -> 42 }
          return cb.action()
        end
        """, 42)
    end

    it("struct with Fn(Int): Int field") do ->
      assert_run_exits("""
        struct Transform
          apply: Fn(Int): Int
        end
        def main(): Int
          t = Transform { apply: (x: Int) -> x * 2 }
          return t.apply(21)
        end
        """, 42)
    end

    it("struct with closure that captures") do ->
      assert_run_exits("""
        struct Adder
          add: Fn(Int): Int
        end
        def main(): Int
          base = 20
          a = Adder { add: (x: Int) -> x + base }
          return a.add(22)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Closures Through Multiple Call Layers
  # ===========================================================================
  describe("closures: through call layers") do ->
    it("closure passed through one function layer") do ->
      assert_run_exits("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply((x: Int) -> x + 1, 41)
        end
        """, 42)
    end

    it("closure passed through two function layers") do ->
      assert_run_exits("""
        def inner_apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def outer_apply(f: Fn(Int): Int, x: Int): Int = inner_apply(f, x)
        def main(): Int
          return outer_apply((x: Int) -> x * 2, 21)
        end
        """, 42)
    end

    it("closure stored then applied later") do ->
      assert_run_exits("""
        def store_and_apply(f: Fn(Int): Int, x: Int): Int
          var stored = f
          return stored(x)
        end
        def main(): Int
          return store_and_apply((x: Int) -> x + 2, 40)
        end
        """, 42)
    end

    it("two closures passed into same function") do ->
      assert_run_exits("""
        def combine(f: Fn(Int): Int, g: Fn(Int): Int, x: Int): Int
          return f(x) + g(x)
        end
        def main(): Int
          return combine((x: Int) -> x + 1, (x: Int) -> x - 1, 21)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Capture Semantics
  # ===========================================================================
  describe("closures: capture semantics") do ->
    it("captures value at time of creation, not mutation") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          f = -> x
          x = 99
          return f()
        end
        """, 42)
    end

    it("multiple closures capture same variable independently") do ->
      assert_run_exits("""
        def main(): Int
          x = 20
          f1 = -> x + 1
          f2 = -> x + 2
          return f1() + f2() - 1
        end
        """, 42)
    end

    it("closure captures loop variable value at creation") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          var i = 0
          while i < 5
            adder = (n: Int) -> n + i
            sum = sum + adder(0)
            i = i + 1
          end
          return sum + 32
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Higher-Order Pattern Stress
  # ===========================================================================
  describe("closures: higher-order stress") do ->
    it("curried addition") do ->
      assert_run_exits("""
        def make_adder(n: Int): Fn(Int): Int
          return (x: Int) -> x + n
        end
        def main(): Int
          add20 = make_adder(20)
          return add20(22)
        end
        """, 42)
    end

    it("function composition") do ->
      assert_run_exits("""
        def apply_twice(f: Fn(Int): Int, x: Int): Int = f(f(x))
        def main(): Int
          inc = (x: Int) -> x + 1
          return apply_twice(inc, 40)
        end
        """, 42)
    end

    it("closure as map callback with accumulate") do ->
      assert_run_exits("""
        def apply_to_range(f: Fn(Int): Int, n: Int): Int
          var sum = 0
          var i = 0
          while i < n
            sum = sum + f(i)
            i = i + 1
          end
          return sum
        end
        def main(): Int
          result = apply_to_range((x: Int) -> x * 2, 5)
          return result + 22
        end
        """, 42)
    end

    it("named function passed as closure argument") do ->
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply(double, 21)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Closure + Control Flow Interaction
  # ===========================================================================
  describe("closures: control flow interaction") do ->
    it("closure inside if branch") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          if 1
            f = -> x
            return f()
          end
          return 0
        end
        """, 42)
    end

    it("closure created in while loop, used after") do ->
      assert_run_exits("""
        def main(): Int
          var last_fn: Fn(): Int = -> 0
          var i = 0
          while i < 5
            val = i + 38
            last_fn = -> val
            i = i + 1
          end
          return last_fn()
        end
        """, 42)
    end

    it("closure in match arm") do ->
      assert_run_exits("""
        def main(): Int
          x = 1
          f = match x
            1 => -> 42
            _ => -> 0
          end
          return f()
        end
        """, 42)
    end

    it("do-end block closure with multiple statements") do ->
      assert_run_exits("""
        def apply(f: Fn(): Int): Int = f()
        def main(): Int
          return apply() do ->
            var x = 20
            var y = 22
            x + y
          end
        end
        """, 42)
    end
  end

  return qspec_main()
end
