## Phase 6.1.b commit 2 — TLS init Throws migration spec.
##
## Operation Piezoelectric Effects, Phase 6 (user-tool dogfooding),
## subphase 6.1.b commit 2.
##
## Validates the migration of TLS-specific init failure sites in
## std/net/http_server.qz (the TLS-init paths that today live under
## `https_serve_supervised`; in the original Phase 6.1.b they lived
## under `http_serve_tls` / `http_serve_tls_opts`, which D.11 Phase 6
## removed) from `log::error("..."); SSL_CTX_free(ssl_ctx); return 1`
## to typed `throw(http_error_format(HttpError::Ssl*Failed*(...)))`.
##
## TLS HttpError variants added in commit 2:
## - SslContextCreateFailed         — SSL_CTX_new returned null.
## - SslCertLoadFailed(String)      — SSL_CTX_use_certificate_file failed; carries the file path.
## - SslKeyLoadFailed(String)       — SSL_CTX_use_PrivateKey_file failed; carries the file path.
## - SslKeyMismatch                 — SSL_CTX_check_private_key disagreed cert/key.
##
## Resource cleanup runs BEFORE each throw at every TLS site so the
## OpenSSL state machine doesn't leak ssl_ctx pointers on the unwind
## path (design memo R2 mitigation). The SSL_CTX_free precedes throw
## inline at every site; verified by source review during migration.
##
## What this spec does NOT cover:
## - Live OpenSSL-handshake error injection — too environment-dependent
##   for a unit spec. Manual smoke required (cert-path mismatch, etc.).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("HTTPS server TLS-init Throws migration (Phase 6.1.b commit 2)") do ->

    it("HttpError TLS variants format correctly") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def main(): Int
  puts(http_error_format(HttpError::SslContextCreateFailed))
  puts(http_error_format(HttpError::SslCertLoadFailed("/etc/ssl/cert.pem")))
  puts(http_error_format(HttpError::SslKeyLoadFailed("/etc/ssl/key.pem")))
  puts(http_error_format(HttpError::SslKeyMismatch))
  return 0
end
""", "Failed to create SSL context\nFailed to load certificate: /etc/ssl/cert.pem\nFailed to load private key: /etc/ssl/key.pem\nCertificate and private key do not match\n")
    end

    it("SslCertLoadFailed default Throws handler emits the path on stderr") do ->
      assert_run_stderr_contains("""
import std/net/http_server

def main(): Int
  throw(http_error_format(HttpError::SslCertLoadFailed("missing.pem")))
  return 0
end
""", "Failed to load certificate: missing.pem")
    end

    it("SslKeyMismatch default Throws handler exits 66") do ->
      assert_run_exits("""
import std/net/http_server

def main(): Int
  throw(http_error_format(HttpError::SslKeyMismatch))
  return 0
end
""", 66)
    end

    it("custom `with Throws` overrides TLS errors — handler captures the message") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts("captured: " + as_string(load(argv, 0)))
  return 1
end

def main(): Int
  with Throws { throw: cap } do ->
    throw(http_error_format(HttpError::SslContextCreateFailed))
  end
  return 0
end
""", "captured: Failed to create SSL context\n")
    end

    it("TLS variants pattern-match in user code with payload extraction") do ->
      assert_run_stdout_eq("""
import std/net/http_server

def classify(e: HttpError): String
  match e
    SslContextCreateFailed => "ctx"
    SslCertLoadFailed(path) => "cert:" + path
    SslKeyLoadFailed(path) => "key:" + path
    SslKeyMismatch => "mismatch"
    SocketCreateFailed => "socket"
    BindFailed(p) => "bind:" + str_from_int(p)
    ListenFailed => "listen"
  end
end

def main(): Int
  puts(classify(HttpError::SslCertLoadFailed("/tmp/c.pem")))
  puts(classify(HttpError::SslKeyLoadFailed("/tmp/k.pem")))
  puts(classify(HttpError::SslKeyMismatch))
  puts(classify(HttpError::SslContextCreateFailed))
  return 0
end
""", "cert:/tmp/c.pem\nkey:/tmp/k.pem\nmismatch\nctx\n")
    end
  end
  return qspec_main()
end
