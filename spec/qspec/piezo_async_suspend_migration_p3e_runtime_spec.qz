## Piezo P3.E-runtime — io_suspend / sched_yield / sched_sleep /
## proc_suspend / io_suspend_timeout migrate through perform(Async,
## suspend, [fd]) at kind=3.
##
## The load-bearing extension is the kind=3 perform epilogue: after
## mir_emit_kind3_perform_suspend emits the perform call, it reads the
## @__qz_effect_park_rv TLS and `ret %tls_rv` instead of hard-coded
## POLL_READY. Default handler's do_suspend calls @__qz_effect_park(fd)
## which encodes `-(fd+2)` into TLS. The scheduler interprets the
## negative sentinel identically to the pre-migration io_suspend return —
## extract fd, dispatch on pre-set TLS flags (io_set_pending_proc /
## timeout / sleep / events).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("P3.E-runtime — scheduler intrinsics → perform at kind=3") do ->
    it("sched_yield loop completes with correct count") do ->
      var src = """
def counter(): Int
  var i = 0
  while i < 5
    i += 1
    sched_yield()
  end
  return i
end

def main(): Int
  sched_init(1)
  var h = async counter()
  sched_spawn(h)
  sched_shutdown()
  puts("r=" + load(h, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=5\n")
    end

    it("channel recv via io_suspend delivers all messages") do ->
      var src = """
def producer(ch: Int): Int
  send(ch, 11)
  send(ch, 22)
  send(ch, 33)
  return 0
end

def main(): Int
  sched_init(2)
  var ch = channel_new(1)
  var h = async producer(ch)
  sched_spawn(h)
  var sum = recv(ch) + recv(ch) + recv(ch)
  sched_shutdown()
  puts("sum=" + sum.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "sum=66\n")
    end

    it("multi-producer + multi-consumer via channels") do ->
      var src = """
def worker(ch: Int, base: Int): Int
  var i = 0
  while i < 3
    send(ch, base + i)
    i += 1
  end
  return 0
end

def main(): Int
  sched_init(2)
  var ch = channel_new(2)
  var a = async worker(ch, 100)
  var b = async worker(ch, 200)
  sched_spawn(a)
  sched_spawn(b)
  var total = 0
  var n = 0
  while n < 6
    total += recv(ch)
    n += 1
  end
  sched_shutdown()
  puts("total=" + total.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      # 100+101+102 + 200+201+202 = 906
      assert_eq_str(r.stdout_content, "total=906\n")
    end

    it("await via kind=3 still delivers result normally") do ->
      var src = """
def work(): Int = 42

def awaiter(h: Int): Int
  var v = await h
  return v + 1
end

def main(): Int
  sched_init(2)
  var h = async work()
  var aw = async awaiter(h)
  sched_spawn(aw)
  sched_shutdown()
  puts("r=" + load(aw, 1).to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=43\n")
    end

    it("go (kind=1) composes with kind=3 suspend primitives") do ->
      var src = """
def triple(x: Int): Int = x * 3

def main(): Int
  var h = go triple(14)
  var r = await h
  puts("r=" + r.to_s())
  return 0
end
"""
      var r = subprocess_run(src)
      assert_eq(r.exit_code, 0)
      assert_eq_str(r.stdout_content, "r=42\n")
    end
  end
  return qspec_main()
end
