## Progress library tests
##
## Covers column construction, builder chaining, template parsing,
## open registry, and Progress lifecycle. Render output is intentionally
## not asserted byte-for-byte — it depends on monotonic time and live
## terminal width. Tests focus on deterministic surface area.

import * from qspec
import * from progress

def main(): Int
  describe("Col constructors") do ->
    it("Col.spinner returns COL_SPINNER kind") do ->
      var c = Col.spinner()
      assert_eq(c.kind, COL_SPINNER())
    end

    it("Col.bar(40) sets width and COL_BAR kind") do ->
      var c = Col.bar(40)
      assert_eq(c.kind, COL_BAR())
      assert_eq(c.width, 40)
    end

    it("Col.pos returns COL_POS kind") do ->
      assert_eq(Col.pos().kind, COL_POS())
    end

    it("Col.percent returns COL_PERCENT kind") do ->
      assert_eq(Col.percent().kind, COL_PERCENT())
    end

    it("Col.eta returns COL_ETA kind") do ->
      assert_eq(Col.eta().kind, COL_ETA())
    end

    it("Col.text holds the literal string") do ->
      var c = Col.text("hello")
      assert_eq(c.kind, COL_TEXT())
      assert_eq_str(c.text, "hello")
    end

    it("Col.spinner_named maps name to spinner id") do ->
      var c = Col.spinner_named("moon")
      assert_eq(c.kind, COL_SPINNER())
      assert_eq(c.spinner_id, SPIN_MOON())
    end

    it("Col.spinner_named falls back to dots for unknown") do ->
      var c = Col.spinner_named("nonsense")
      assert_eq(c.spinner_id, SPIN_DOTS())
    end
  end

  describe("Col styling chain") do ->
    it("cyan() sets fg") do ->
      var c = Col.spinner().cyan()
      assert_eq(c.fg_color, Cyan())
    end

    it("red() sets fg") do ->
      var c = Col.spinner().red()
      assert_eq(c.fg_color, Red())
    end

    it("bold() sets the bold attr bit") do ->
      var c = Col.text("x").bold()
      assert_eq(c.attrs & 1, 1)
    end

    it("dim() sets the dim attr bit") do ->
      var c = Col.text("x").dim()
      assert_eq(c.attrs & 2, 2)
    end

    it("chaining is immutable — base unchanged") do ->
      var base = Col.spinner()
      var derived = base.cyan().bold()
      assert_eq(base.fg_color, COLOR_NONE())
      assert_eq(derived.fg_color, Cyan())
      assert_eq(derived.attrs & 1, 1)
    end

    it("preserves kind through styling") do ->
      var c = Col.bar(20).green().bold()
      assert_eq(c.kind, COL_BAR())
      assert_eq(c.width, 20)
    end
  end

  describe("Template parser") do ->
    it("plain text becomes single text column") do ->
      var cols = progress_parse_template("hello world")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_TEXT())
      assert_eq_str(c.text, "hello world")
    end

    it("{spinner} becomes a spinner column") do ->
      var cols = progress_parse_template("{spinner}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_SPINNER())
    end

    it("{bar:40} sets the bar width") do ->
      var cols = progress_parse_template("{bar:40}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_BAR())
      assert_eq(c.width, 40)
    end

    it("text + placeholder + text") do ->
      var cols = progress_parse_template("[{spinner}]")
      assert_eq(cols.size, 3)
      var c0: Col = cols[0]
      var c1: Col = cols[1]
      var c2: Col = cols[2]
      assert_eq(c0.kind, COL_TEXT())
      assert_eq_str(c0.text, "[")
      assert_eq(c1.kind, COL_SPINNER())
      assert_eq(c2.kind, COL_TEXT())
      assert_eq_str(c2.text, "]")
    end

    it("{bar:40.cyan} parses fg color") do ->
      var cols = progress_parse_template("{bar:40.cyan}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_BAR())
      assert_eq(c.width, 40)
      assert_eq(c.fg_color, Cyan())
    end

    it("{bar:40.red/blue} parses fg and bg") do ->
      var cols = progress_parse_template("{bar:40.red/blue}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.fg_color, Red())
      assert_eq(c.bg_color, Blue())
    end

    it("full template parses to expected column count") do ->
      var cols = progress_parse_template("{spinner} [{bar:30.cyan}] {pos}/{len} ({eta})")
      # Expected: spinner, " [", bar, "] ", pos, "/", len, " (", eta, ")"
      assert_eq(cols.size, 10)
      var c0: Col = cols[0]
      var c2: Col = cols[2]
      var c4: Col = cols[4]
      var c6: Col = cols[6]
      var c8: Col = cols[8]
      assert_eq(c0.kind, COL_SPINNER())
      assert_eq(c2.kind, COL_BAR())
      assert_eq(c4.kind, COL_POS())
      assert_eq(c6.kind, COL_LEN())
      assert_eq(c8.kind, COL_ETA())
    end

    it("aliases {pct} = percent") do ->
      var cols = progress_parse_template("{pct}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_PERCENT())
    end

    it("alias {total} = len") do ->
      var cols = progress_parse_template("{total}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_LEN())
    end

    it("unknown key renders as literal placeholder") do ->
      var cols = progress_parse_template("{nonsense_key}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_TEXT())
      assert_eq_str(c.text, "{nonsense_key}")
    end
  end

  describe("Open registry") do ->
    it("registered column resolves through template parser") do ->
      progress_register_column("custom_test", custom_render_helper)
      var cols = progress_parse_template("{custom_test}")
      assert_eq(cols.size, 1)
      var c: Col = cols[0]
      assert_eq(c.kind, COL_CUSTOM())
    end
  end

  describe("Progress lifecycle") do ->
    it("new(100) starts at pos 0") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      assert_eq(p.task.pos, 0)
      assert_eq(p.task.total, 100)
    end

    it("inc advances pos") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.inc(25)
      assert_eq(p.task.pos, 25)
      p.inc(25)
      assert_eq(p.task.pos, 50)
    end

    it("set assigns pos directly") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.set(75)
      assert_eq(p.task.pos, 75)
    end

    it("percent computes correctly") do ->
      var p = Progress.new(200).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.set(50)
      assert_eq(p.percent(), 25)
    end

    it("finish marks done and snaps pos to total") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.set(50)
      p.finish()
      assert_eq(p.task.pos, 100)
      assert_eq(p.task.status, STATUS_OK())
    end

    it("fail marks status as FAIL") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.fail("oops")
      assert_eq(p.task.status, STATUS_FAIL())
    end

    it("done() returns true after finish") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.finish()
      assert_eq(progress_done_int(p), 1)
    end

    it("label() sets task label") do ->
      var p = Progress.new(100).label("downloading")
      assert_eq_str(p.task.label, "downloading")
    end

    it("template() replaces columns") do ->
      var p = Progress.new(100).template("{spinner} {pos}")
      assert_eq(p.cols.size, 3)
      assert_eq(p.cols[0].kind, COL_SPINNER())
      assert_eq(p.cols[2].kind, COL_POS())
    end

    it("indeterminate spinner has total 0") do ->
      var p = Progress.spinner_only().label("loading")
      assert_eq(p.task.total, 0)
    end
  end

  describe("Spring physics") do ->
    it("smoothed_pos starts at 0") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      assert_eq(p.task.smoothed_pos, 0)
    end

    it("smoothed_pos advances toward target on render") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.set(100)
      # Force several render ticks to advance smoothing
      var i = 0
      while i < 20
        p._render_force()
        i += 1
      end
      # Should have advanced significantly toward target
      assert_eq(p.task.smoothed_pos > 50, true)
    end

    it("smoothed_pos reaches target on finish") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      p.start()
      p.finish()
      assert_eq(p.task.smoothed_pos, 100)
    end
  end

  describe("Output mode detection") do ->
    it("AUTO is the default mode") do ->
      var p = Progress.new(100)
      assert_eq(p.mode, PROGRESS_MODE_AUTO())
    end

    it("OFF mode is settable") do ->
      var p = Progress.new(100).mode_set(PROGRESS_MODE_OFF())
      assert_eq(p.mode, PROGRESS_MODE_OFF())
    end
  end

  describe("Presets") do ->
    it("download preset has spinner + bar + bytes columns") do ->
      var p = Progress.download(1024)
      assert_eq(p.task.total, 1024)
      assert_eq(p.cols.size > 5, true)
    end

    it("test_preset uses pos_len column") do ->
      var p = Progress.test_preset(50)
      assert_eq(p.task.total, 50)
    end

    it("install preset is indeterminate (total 0)") do ->
      var p = Progress.install()
      assert_eq(p.task.total, 0)
    end
  end

  describe("Spinner frames") do ->
    it("dots has 10 frames") do ->
      var f = _spin_frames(SPIN_DOTS())
      assert_eq(f.size, 10)
    end

    it("line has 4 frames") do ->
      var f = _spin_frames(SPIN_LINE())
      assert_eq(f.size, 4)
    end

    it("moon has 8 frames") do ->
      var f = _spin_frames(SPIN_MOON())
      assert_eq(f.size, 8)
    end

    it("dots interval is 80ms") do ->
      assert_eq(_spin_interval(SPIN_DOTS()), 80)
    end
  end

  describe("Live surface") do ->
    it("Live.new starts with no bars") do ->
      var live = Live.new()
      assert_eq(live.bars.size, 0)
      assert_eq(live.max_rows, 10)
    end

    it("add(p) appends a bar and silences its mode") do ->
      var live = Live.new()
      var p = Progress.new(50)
      live.add(p)
      assert_eq(live.bars.size, 1)
      assert_eq(p.mode, PROGRESS_MODE_OFF())
    end

    it("max_active sets the row cap") do ->
      var live = Live.new().max_active(5)
      assert_eq(live.max_rows, 5)
    end

    it("with_global enables the header") do ->
      var live = Live.new().with_global("running", 10)
      assert_eq(progress_bool_int(live.has_global), 1)
      assert_eq(live.global_total, 10)
    end

    it("done_count reflects finished bars") do ->
      var live = Live.new().mode_set(PROGRESS_MODE_OFF())
      var a = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var b = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      live.add(a)
      live.add(b)
      a.start()
      a.finish()
      assert_eq(live.done_count(), 1)
    end

    it("stats counts done/failed/running/total") do ->
      var live = Live.new().mode_set(PROGRESS_MODE_OFF())
      var a = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var b = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var c = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      live.add(a)
      live.add(b)
      live.add(c)
      a.start()
      a.finish()
      b.start()
      b.fail("nope")
      var s = live.stats()
      assert_eq(s[0], 1)  # done
      assert_eq(s[1], 1)  # failed
      assert_eq(s[2], 1)  # running
      assert_eq(s[3], 3)  # total
    end

    it("_top_active returns up to max_rows running bars") do ->
      var live = Live.new().max_active(2).mode_set(PROGRESS_MODE_OFF())
      var a = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var b = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var c = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      live.add(a)
      live.add(b)
      live.add(c)
      var top = live._top_active()
      assert_eq(top.size, 2)
    end

    it("_top_active skips finished bars") do ->
      var live = Live.new().mode_set(PROGRESS_MODE_OFF())
      var a = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      var b = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      live.add(a)
      live.add(b)
      a.start()
      a.finish()
      var top = live._top_active()
      assert_eq(top.size, 1)
    end

    it("all_done returns true when total is met") do ->
      var live = Live.new().mode_set(PROGRESS_MODE_OFF())
      var a = Progress.new(10).mode_set(PROGRESS_MODE_OFF())
      live.add(a)
      a.start()
      a.finish()
      assert_eq(progress_bool_int(live.all_done()), 1)
    end
  end

  return qspec_main()
end

def progress_bool_int(b: Bool): Int
  if b
    return 1
  end
  return 0
end

def custom_render_helper(t: Task, w: Int): String
  return "custom"
end

def progress_done_int(p: Progress): Int
  if p.done()
    return 1
  end
  return 0
end
