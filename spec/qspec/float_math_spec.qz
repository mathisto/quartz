## Float Math Tests
##
## Contract:
##   1. Abs via ufcs.
##   2. F64_abs computes absolute value.
##   3. F64_atan2(0, 1) is 0.
##   4. F64_ceil computes ceil.
##   5. F64_cos(0) is 1.
##   6. F64_exp(0) is 1.
import * from qspec

def main(): Int
  describe("float math builtins") do ->
    it("f64_sqrt computes square root") do ->
      assert_eq(to_int(f64_sqrt(to_f64(4))), 2)
    end
    it("f64_sqrt via UFCS") do ->
      assert_eq(fm_sqrt_ufcs(), 3)
    end
    it("f64_floor computes floor") do ->
      assert_eq(to_int(f64_floor(to_f64(3))), 3)
    end
    it("f64_ceil computes ceil") do ->
      assert_eq(to_int(f64_ceil(to_f64(3))), 3)
    end
    it("f64_round rounds to nearest") do ->
      assert_eq(to_int(f64_round(to_f64(3))), 3)
    end
    it("f64_abs computes absolute value") do ->
      assert_eq(to_int(f64_abs(to_f64(5))), 5)
    end
    it("f64_sin(0) is 0") do ->
      assert_eq(to_int(f64_sin(to_f64(0))), 0)
    end
    it("f64_cos(0) is 1") do ->
      assert_eq(to_int(f64_cos(to_f64(0))), 1)
    end
    it("f64_log(1) is 0") do ->
      assert_eq(to_int(f64_log(to_f64(1))), 0)
    end
    it("f64_exp(0) is 1") do ->
      assert_eq(to_int(f64_exp(to_f64(0))), 1)
    end
    it("f64_pow(2, 10) = 1024") do ->
      assert_eq(to_int(f64_pow(to_f64(2), to_f64(10))), 1024)
    end
    it("f64_min returns minimum") do ->
      assert_eq(to_int(f64_min(to_f64(3), to_f64(7))), 3)
    end
    it("f64_max returns maximum") do ->
      assert_eq(to_int(f64_max(to_f64(3), to_f64(7))), 7)
    end
    it("f64_atan2(0, 1) is 0") do ->
      assert_eq(to_int(f64_atan2(to_f64(0), to_f64(1))), 0)
    end
    it("sqrt via UFCS (16)") do ->
      assert_eq(fm_sqrt_ufcs_16(), 4)
    end
    it("abs via UFCS") do ->
      assert_eq(fm_abs_ufcs(), 5)
    end
    it("floor via UFCS") do ->
      assert_eq(fm_floor_ufcs(), 3)
    end
    it("pow via UFCS") do ->
      assert_eq(fm_pow_ufcs(), 1024)
    end
  end
  return qspec_main()
end

def fm_sqrt_ufcs(): Int
  var x = to_f64(9)
  var r = x.sqrt()
  return to_int(r)
end
def fm_sqrt_ufcs_16(): Int
  var x = to_f64(16)
  return to_int(x.sqrt())
end
def fm_abs_ufcs(): Int
  var x = to_f64(5)
  return to_int(x.abs())
end
def fm_floor_ufcs(): Int
  var x = to_f64(3)
  return to_int(x.floor())
end
def fm_pow_ufcs(): Int
  var x = to_f64(2)
  return to_int(x.pow(to_f64(10)))
end
