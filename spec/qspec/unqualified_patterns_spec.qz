## Unqualified Patterns Tests
##
## Contract:
##   1. Unqualified match: `Active(code) =>` resolves against scrutinee type.
##   2. Payload extraction: binding captures payload data.
##   3. No-payload match: `Inactive =>` matches without data.
##   4. Zero/negative values: edge cases in payload data.
##   5. Simple enum: variants without payloads dispatchable.
##   6. Wildcard: `_ =>` catches remaining variants.
##   7. Expression position: match result usable in arithmetic.
##   8. Function return: match inside function body.
##   9. Large values: payload data with large integers.

import * from qspec

enum UPStatus
  Active(code: Int)
  Inactive
end

enum UPColor
  Red
  Green
  Blue
end

def main(): Int
  describe("unqualified patterns") do ->
    it("enum variant can be tested with match") do ->
      assert_eq(up_match_status(), 42)
    end

    it("matches variant without data") do ->
      var s = UPStatus::Inactive
      var result = match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => 99
      end
      assert_eq(result, 99)
    end

    it("extracts data from enum variant") do ->
      var s = UPStatus::Active(7)
      var result = match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => 0
      end
      assert_eq(result, 7)
    end

    it("matches enum with zero data value") do ->
      var s = UPStatus::Active(0)
      var result = match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => -1
      end
      assert_eq(result, 0)
    end

    it("matches enum with negative data value") do ->
      var s = UPStatus::Active(-100)
      var result = match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => 0
      end
      assert_eq(result, -100)
    end

    it("matches simple enum without payload") do ->
      var c = UPColor::Red
      var result = match c
        UPColor::Red => 1
        UPColor::Green => 2
        UPColor::Blue => 3
      end
      assert_eq(result, 1)
    end

    it("matches second simple enum variant") do ->
      var c = UPColor::Green
      var result = match c
        UPColor::Red => 1
        UPColor::Green => 2
        UPColor::Blue => 3
      end
      assert_eq(result, 2)
    end

    it("matches third simple enum variant") do ->
      var c = UPColor::Blue
      var result = match c
        UPColor::Red => 1
        UPColor::Green => 2
        UPColor::Blue => 3
      end
      assert_eq(result, 3)
    end

    it("wildcard catches unmatched variant") do ->
      var s = UPStatus::Inactive
      var result = match s
        UPStatus::Active(code) => code
        _ => 999
      end
      assert_eq(result, 999)
    end

    it("match result can be used in expression") do ->
      var s = UPStatus::Active(10)
      var doubled = 2 * match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => 0
      end
      assert_eq(doubled, 20)
    end

    it("match can return from function") do ->
      assert_eq(up_match_and_return(UPStatus::Active(55)), 55)
      assert_eq(up_match_and_return(UPStatus::Inactive), 0)
    end

    it("match works in if condition") do ->
      var s = UPStatus::Active(1)
      var result = match s
        UPStatus::Active(code) => code
        _ => 0
      end
      if result > 0
        assert_eq(result, 1)
      else
        assert_eq(0, 1) ## should not reach
      end
    end

    it("match with large variant data") do ->
      var s = UPStatus::Active(999999)
      var result = match s
        UPStatus::Active(code) => code
        UPStatus::Inactive => 0
      end
      assert_eq(result, 999999)
    end

    it("exhaustive pattern checking produces error") do ->
      assert_compile_error("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          var c = Color::Red
          match c
            Color::Red => return 1
            Color::Green => return 2
          end
          return 0
        end
      """, "non-exhaustive")
    end

    it("guard clauses in match arms") do ->
      # Value guard: v > 10 selects second arm
      var x = 42
      var r1 = match x
        v if v > 100 => 1
        v if v > 10 => 2
        _ => 3
      end
      assert_eq(r1, 2)

      # Enum guard: code > 50 fails, falls through to next arm
      var s = UPStatus::Active(42)
      var r2 = match s
        UPStatus::Active(code) if code > 50 => 1
        UPStatus::Active(code) => code
        UPStatus::Inactive => 0
      end
      assert_eq(r2, 42)
    end
  end

  return qspec_main()
end

def up_match_status(): Int
  s = UPStatus::Active(42)
  return match s
    UPStatus::Active(code) => code
    UPStatus::Inactive => 0
  end
end

def up_match_and_return(s: UPStatus): Int
  return match s
    UPStatus::Active(code) => code
    UPStatus::Inactive => 0
  end
end

