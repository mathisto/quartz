## Bounded Generic Dispatch Tests
##
## Contract:
##   1. x.method() works inside def f<T: Trait>(x: T)
##   2. Multiple bounds: T: Trait1 + Trait2
##   3. Multiple impls dispatch correctly per concrete type
##   4. Bare function calls still work in bounded generics

import * from qspec

# -- Basic bounded dispatch --

trait BdShowable
  def bd_show(self): Int
    return 0
  end
end

struct BdCoin
  worth: Int
end

struct BdGem
  sparkle: Int
end

extend BdCoin with BdShowable
  def bd_show(self): Int = @worth
end

extend BdGem with BdShowable
  def bd_show(self): Int = @sparkle * 10
end

def bd_display<T: BdShowable>(x: T): Int
  return x.bd_show()
end

# -- Multiple bounds --

trait BdMeasurable
  def bd_measure(self): Int
    return 0
  end
end

extend BdCoin with BdMeasurable
  def bd_measure(self): Int = @worth * 2
end

def bd_show_and_measure<T: BdShowable + BdMeasurable>(x: T): Int
  return x.bd_show() + x.bd_measure()
end

# -- Bare function calls still work --

trait BdValuable
  def bd_get_val(self): Int
    return 0
  end
end

extend BdCoin with BdValuable
  def bd_get_val(self): Int = @worth
end

def bd_extract<T: BdValuable>(obj: T): Int
  return obj.bd_get_val()
end

# -- Self in bounded generic impl --

trait BdCloneable
  def bd_dup(self): Self
    return self
  end
end

extend BdCoin with BdCloneable
  def bd_dup(self): Self
    return BdCoin { worth: @worth }
  end
end

def bd_clone_value<T: BdCloneable + BdShowable>(x: T): Int
  copy = x.bd_dup()
  return copy.bd_show()
end

def main(): Int
  describe("bounded generic dispatch") do ->
    it("basic: x.method() dispatches through trait bound") do ->
      c = BdCoin { worth: 42 }
      assert_eq(bd_display(c), 42)
    end

    it("dispatches to correct impl per type") do ->
      c = BdCoin { worth: 5 }
      g = BdGem { sparkle: 3 }
      assert_eq(bd_display(c), 5)
      assert_eq(bd_display(g), 30)
    end

    it("multiple bounds: T: Show + Measure") do ->
      c = BdCoin { worth: 10 }
      assert_eq(bd_show_and_measure(c), 30)
    end

    it("UFCS in bounded generic works") do ->
      c = BdCoin { worth: 99 }
      assert_eq(bd_extract(c), 99)
    end

    it("clone through bounded generic preserves value") do ->
      c = BdCoin { worth: 7 }
      assert_eq(bd_clone_value(c), 7)
    end
  end

  return qspec_main()
end
