## Ring Buffer Tests
##
## Contract:
##   1. Cas contention: 3 threads.
##   2. Count tracks through push/pop.
##   3. Creates with correct initial.
##   4. Handles wrap-around correctly.
##   5. Mpmc push with cas.
##   6. Pops in fifo order.
import * from qspec

struct RingBuffer
  buffer: Int
  capacity: Int
  head: Int
  tail: Int
  count: Int
end

def rb_new(capacity: Int): RingBuffer
  var buf = mem_alloc(capacity * 8)
  var head = atomic_new(0)
  var tail = atomic_new(0)
  var count = atomic_new(0)
  return RingBuffer { buffer: buf, capacity: capacity, head: head, tail: tail, count: count }
end

def rb_count(rb: RingBuffer): Int = atomic_load(rb.count)

def rb_is_empty(rb: RingBuffer): Int
  if atomic_load(rb.count) == 0
    return 1
  end
  return 0
end

def rb_is_full(rb: RingBuffer): Int
  if atomic_load(rb.count) == rb.capacity
    return 1
  end
  return 0
end

def rb_push(rb: RingBuffer, value: Int): Int
  var cnt = atomic_load(rb.count)
  if cnt >= rb.capacity
    return 0
  end
  var t = atomic_load(rb.tail)
  var idx = t % rb.capacity
  store(rb.buffer, idx, value)
  atomic_store(rb.tail, t + 1)
  atomic_add(rb.count, 1)
  return 1
end

def rb_pop(rb: RingBuffer): Int
  var cnt = atomic_load(rb.count)
  if cnt <= 0
    return -1
  end
  var h = atomic_load(rb.head)
  var idx = h % rb.capacity
  var val = load(rb.buffer, idx)
  atomic_store(rb.head, h + 1)
  atomic_sub(rb.count, 1)
  return val
end

def main(): Int
  describe("ring buffer") do ->
    it("creates with correct initial state") do ->
      assert_output("8 0 1 0", rb_init_test)
    end
    it("pushes and pops single element") do ->
      assert_output("42\n", rb_single_test)
    end
    it("pops in FIFO order") do ->
      assert_output("10 20 30", rb_fifo_test)
    end
    it("rejects push into full buffer") do ->
      assert_output("1 1 0", rb_full_test)
    end
    it("returns -1 when popping empty buffer") do ->
      assert_output("-1\n", rb_empty_pop_test)
    end
    it("handles wrap-around correctly") do ->
      assert_output("30 40 50 60", rb_wrap_test)
    end
    it("count tracks through push/pop") do ->
      assert_output("3 2 0", rb_count_test)
    end
    it("survives 25 fill-drain cycles") do ->
      assert_output("126250\n", rb_cycles_test)
    end
    it("SPSC producer-consumer") do ->
      assert_eq(rb_spsc_test(), 5050)
    end
    it("MPMC push with CAS contention") do ->
      assert_eq(rb_mpmc_2x100(), 20100)
    end
    it("CAS contention: 3 threads to 300") do ->
      assert_eq(rb_mpmc_3x100(), 45150)
    end
    it("stress: 2 producers x 500 drain") do ->
      assert_eq(rb_mpmc_2x500(), 500500)
    end
  end
  return qspec_main()
end

def rb_init_test(): Void
  var rb = rb_new(8)
  print("#{rb.capacity}")
  print(" ")
  print("#{rb_count(rb)}")
  print(" ")
  print("#{rb_is_empty(rb)}")
  print(" ")
  print("#{rb_is_full(rb)}")
end

def rb_single_test(): Void
  var rb = rb_new(4)
  rb_push(rb, 42)
  print_int(rb_pop(rb))
end

def rb_fifo_test(): Void
  var rb = rb_new(4)
  rb_push(rb, 10)
  rb_push(rb, 20)
  rb_push(rb, 30)
  print("#{rb_pop(rb)}")
  print(" ")
  print("#{rb_pop(rb)}")
  print(" ")
  print("#{rb_pop(rb)}")
end

def rb_full_test(): Void
  var rb = rb_new(2)
  var a = rb_push(rb, 1)
  var b = rb_push(rb, 2)
  var c = rb_push(rb, 3)
  print("#{a}")
  print(" ")
  print("#{b}")
  print(" ")
  print("#{c}")
end

def rb_empty_pop_test(): Void
  var rb = rb_new(4)
  print_int(rb_pop(rb))
end

def rb_wrap_test(): Void
  var rb = rb_new(4)
  rb_push(rb, 10)
  rb_push(rb, 20)
  rb_push(rb, 30)
  rb_push(rb, 40)
  rb_pop(rb)
  rb_pop(rb)
  rb_push(rb, 50)
  rb_push(rb, 60)
  print("#{rb_pop(rb)}")
  print(" ")
  print("#{rb_pop(rb)}")
  print(" ")
  print("#{rb_pop(rb)}")
  print(" ")
  print("#{rb_pop(rb)}")
end

def rb_count_test(): Void
  var rb = rb_new(8)
  rb_push(rb, 10)
  rb_push(rb, 20)
  rb_push(rb, 30)
  print("#{rb_count(rb)}")
  print(" ")
  rb_pop(rb)
  print("#{rb_count(rb)}")
  print(" ")
  rb_pop(rb)
  rb_pop(rb)
  print("#{rb_count(rb)}")
end

def rb_spsc_prod(rb: RingBuffer): Int
  var i = 0
  while i < 100
    rb_push(rb, i + 1)
    i = i + 1
  end
  return 0
end

def rb_spsc_test(): Int
  var rb = rb_new(100)
  h = go rb_spsc_prod(rb)
  await h
  var sum = 0
  var j = 0
  while j < 100
    sum = sum + rb_pop(rb)
    j += 1
  end
  return sum
end

def rb_cycles_test(): Void
  var rb = rb_new(100)
  var total = 0
  var cycle = 0
  while cycle < 25
    var i = 1
    while i <= 100
      rb_push(rb, i)
      i = i + 1
    end
    var sum = 0
    var j = 0
    while j < 100
      sum = sum + rb_pop(rb)
      j += 1
    end
    total = total + sum
    cycle = cycle + 1
  end
  print_int(total)
end

## CAS-safe ring buffer operations for MPMC

def rb_push_cas(rb: RingBuffer, value: Int): Int
  var spins = 0
  while spins < 10000
    var cnt = atomic_load(rb.count)
    if cnt >= rb.capacity
      return 0
    end
    var t = atomic_load(rb.tail)
    var swapped = atomic_cas(rb.tail, t, t + 1)
    if swapped
      var idx = t % rb.capacity
      store(rb.buffer, idx, value)
      atomic_add(rb.count, 1)
      return 1
    end
    spins = spins + 1
  end
  return 0
end

def rb_pop_cas(rb: RingBuffer): Int
  var spins = 0
  while spins < 10000
    var cnt = atomic_load(rb.count)
    if cnt <= 0
      return -1
    end
    var h = atomic_load(rb.head)
    var swapped = atomic_cas(rb.head, h, h + 1)
    if swapped
      var idx = h % rb.capacity
      var val = load(rb.buffer, idx)
      atomic_sub(rb.count, 1)
      return val
    end
    spins = spins + 1
  end
  return -1
end

## MPMC test helpers

def rb_mpmc_prod(rb: RingBuffer, start: Int, count: Int): Int
  var i = 0
  while i < count
    var pushed = 0
    while pushed == 0
      pushed = rb_push_cas(rb, start + i + 1)
    end
    i = i + 1
  end
  return 0
end

def rb_mpmc_prod_a100(rb: RingBuffer): Int
  return rb_mpmc_prod(rb, 0, 100)
end

def rb_mpmc_prod_b100(rb: RingBuffer): Int
  return rb_mpmc_prod(rb, 100, 100)
end

def rb_mpmc_2x100(): Int
  var rb = rb_new(256)
  h1 = go rb_mpmc_prod_a100(rb)
  h2 = go rb_mpmc_prod_b100(rb)
  await h1
  await h2
  var sum = 0
  var j = 0
  while j < 200
    sum = sum + rb_pop_cas(rb)
    j += 1
  end
  return sum
end

def rb_mpmc_prod_c100(rb: RingBuffer): Int
  return rb_mpmc_prod(rb, 200, 100)
end

def rb_mpmc_3x100(): Int
  var rb = rb_new(512)
  h1 = go rb_mpmc_prod_a100(rb)
  h2 = go rb_mpmc_prod_b100(rb)
  h3 = go rb_mpmc_prod_c100(rb)
  await h1
  await h2
  await h3
  var sum = 0
  var j = 0
  while j < 300
    sum = sum + rb_pop_cas(rb)
    j += 1
  end
  return sum
end

def rb_mpmc_prod_a500(rb: RingBuffer): Int
  return rb_mpmc_prod(rb, 0, 500)
end

def rb_mpmc_prod_b500(rb: RingBuffer): Int
  return rb_mpmc_prod(rb, 500, 500)
end

def rb_mpmc_2x500(): Int
  var rb = rb_new(1024)
  h1 = go rb_mpmc_prod_a500(rb)
  h2 = go rb_mpmc_prod_b500(rb)
  await h1
  await h2
  var sum = 0
  var j = 0
  while j < 1000
    sum = sum + rb_pop_cas(rb)
    j += 1
  end
  return sum
end
