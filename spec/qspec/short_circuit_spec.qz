## Short-Circuit And/Or Tests
##
## Contract:
##   1. And short-circuits.
##   2. Or short-circuits.
##   3. Chained short-circuit.
##   4. Result normalization.
##   5. Short-circuit properties.
import * from qspec
import * from qspec/property

def main(): Int
  describe("and short-circuits") do ->
    it("does not evaluate RHS when LHS is false") do ->
      var arr = [0]
      var r = false and sc_side_effect(arr)
      assert_eq(arr[0], 0)
    end

    it("evaluates RHS when LHS is true") do ->
      var arr = [0]
      var r = true and sc_side_effect(arr)
      assert_eq(arr[0], 1)
    end
  end

  describe("or short-circuits") do ->
    it("does not evaluate RHS when LHS is true") do ->
      var arr = [0]
      var r = true or sc_side_effect(arr)
      assert_eq(arr[0], 0)
    end

    it("evaluates RHS when LHS is false") do ->
      var arr = [0]
      var r = false or sc_side_effect(arr)
      assert_eq(arr[0], 1)
    end
  end

  describe("chained short-circuit") do ->
    it("a and b and c: stops at first false") do ->
      var arr = [0, 0, 0]
      var r = sc_track(arr, 0) and sc_track_false(arr, 1) and sc_track(arr, 2)
      assert_eq(arr[0], 1)
      assert_eq(arr[1], 1)
      assert_eq(arr[2], 0)
    end

    it("a or b or c: stops at first true") do ->
      var arr = [0, 0, 0]
      var r = sc_track_false(arr, 0) or sc_track(arr, 1) or sc_track(arr, 2)
      assert_eq(arr[0], 1)
      assert_eq(arr[1], 1)
      assert_eq(arr[2], 0)
    end
  end

  describe("result normalization") do ->
    it("and returns 1 for truthy operands") do ->
      var x = 5 and 42
      assert_eq(x, 1)
    end

    it("and returns 0 for falsy left") do ->
      var x = 0 and 42
      assert_eq(x, 0)
    end

    it("or returns 1 for truthy left") do ->
      var x = 5 or 0
      assert_eq(x, 1)
    end

    it("or returns 0 for both falsy") do ->
      var x = 0 or 0
      assert_eq(x, 0)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("short-circuit properties") do ->
    forall_i("x and 0 == 0 (false annihilator)") do x: Int ->
      var r = x and 0
      assert_eq(r, 0)
    end

    forall_i("x or 1 == 1 (true annihilator)") do x: Int ->
      var r = x or 1
      assert_eq(r, 1)
    end

    forall_i("0 and x == 0 (short-circuit false)") do x: Int ->
      var r = 0 and x
      assert_eq(r, 0)
    end

    forall_i("1 or x == 1 (short-circuit true)") do x: Int ->
      var r = 1 or x
      assert_eq(r, 1)
    end
  end

  return qspec_main()
end

def sc_side_effect(arr: Array): Int
  arr[0] = 1
  return 1
end

def sc_track(arr: Array, idx: Int): Int
  arr[idx] = 1
  return 1
end

def sc_track_false(arr: Array, idx: Int): Int
  arr[idx] = 1
  return 0
end
