import * from qspec

# Regression for the UFCS-rewrite fallback when a module-level global's
# receiver type is recoverable from its init expression but NOT from its
# source-level annotation (which the user omitted).
#
# Pre-fix shape: `_state = vec_new<Int>()` at module scope produces a
# NODE_LET with `str2 == ""` (no `: Vec<Int>` annotation written). PASS
# 0.6 in mir_lower.qz stored that empty string into the global-type
# registry verbatim. Under `--cache-ro`, when TC body-walk is skipped
# for the owning module, the AST still carries the raw `_state.push(1)`
# (un-rewritten by TC's `push` → `vec_push` rewrite at
# typecheck_expr_handlers.qz:2345). The fallback at
# mir_lower_expr_handlers.qz:1480-1498 looks up the receiver's type via
# `mir_ctx_lookup_global_type("_state")` — which returned "" — and the
# canonical rewrite was skipped. The call fell through to
# `LoadVar("push") + CallIndirect`, emitting `load i64, ptr %push` with
# no alloca for %push — llc rejects with `use of undefined value
# '%push'`.
#
# Fix: PASS 0.6 now infers the global's type from its init expression
# when str2 is empty. For `vec_new<Int>()`, that's "Vec" via
# `mir_intrinsic_return_type` — exactly what
# `mir_ufcs_canonical("Vec", "push")` matches against.
#
# This spec exercises the post-fix path under qspec's `--cache-ro`
# default: if the fix regresses, the prewarmed cache will cause this
# spec to fail to compile (llc undefined %push), surfacing immediately.

# Module-level Vec global with NO type annotation. Mirrors std/colors.qz:1.
_ufcs_witness = vec_new<Int>()

# Equivalent to colors$_init_state — UFCS dot-method on the untyped global.
def _init_ufcs_witness(): Void
  if _ufcs_witness.empty?
    _ufcs_witness.push(1)
    _ufcs_witness.push(2)
    _ufcs_witness.push(3)
  end
end

def main(): Int
  describe("UFCS rewrite fallback: untyped Vec global") do ->
    it("`.push(...)` on untyped Vec global lowers to vec_push") do ->
      _init_ufcs_witness()
      assert_eq(_ufcs_witness.size, 3)
    end
    it("idempotent — second call doesn't double-push") do ->
      _init_ufcs_witness()
      assert_eq(_ufcs_witness.size, 3)
    end
    it("element values survive the dispatch") do ->
      assert_eq(_ufcs_witness[0], 1)
      assert_eq(_ufcs_witness[1], 2)
      assert_eq(_ufcs_witness[2], 3)
    end
  end
  return qspec_main()
end
