## @cfg Arity Mangling Tests
##
## Contract:
##   1. Same-module @cfg: gated function callable from same file.
##   2. Cross-module @cfg: gated function callable from importer.
##   3. Non-@cfg overload: regular arity overloads still work.
##   4. @cfg different arities: different param counts per platform.
##   5. Platform value: returns correct value for active @cfg.
##   6. Inactive branch: @cfg excludes inactive platform branch.
##   7. @cfg on structs: conditional struct definitions.

import * from qspec
import * from qspec/subprocess

@cfg(os: "macos")
def ca_platform_value(): Int = 42

@cfg(os: "linux")
def ca_platform_value(): Int = 99

@cfg(os: "macos")
def ca_platform_calc(x: Int): Int = x + 10

@cfg(os: "linux")
def ca_platform_calc(x: Int, y: Int): Int = x + y

def main(): Int
  describe("@cfg arity mangling") do ->
    it("same-module call to @cfg-gated function works") do ->
      assert_eq(ca_platform_value(), 42)
    end

    it("cross-module call to @cfg-gated function works") do ->
      var files: Vec = vec_new()
      files.push(as_int("cfg_xmod.qz"))
      vec_push(files, as_int("@cfg(os: \"macos\")\ndef cfg_xmod_val(): Int = 42\n@cfg(os: \"linux\")\ndef cfg_xmod_val(): Int = 99\n"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("import cfg_xmod\ndef main(): Int = cfg_xmod::cfg_xmod_val()\n"))
      assert_multi_run_exits(files, 1, 42)
    end

    it("non-@cfg overloaded functions still arity-mangle") do ->
      assert_run_exits("def greet(): Int = 1\ndef greet(x: Int): Int = x + 1\ndef main(): Int = greet() + greet(10)\n", 12)
    end

    it("@cfg with different arities") do ->
      assert_eq(ca_platform_calc(32), 42)
    end

    it("@cfg function returns correct platform value") do ->
      ## On macOS this should be 42, on Linux 99
      var v = ca_platform_value()
      assert_eq(v > 0, true)
    end

    it("@cfg gated function compiles in source") do ->
      assert_compile_succeeds("""
        @cfg(os: "macos")
        def plat(): Int = 1
        @cfg(os: "linux")
        def plat(): Int = 2
        def main(): Int
          return plat()
        end
      """)
    end

    it("@cfg with string value compiles") do ->
      assert_compile_succeeds("""
        @cfg(os: "macos")
        def target(): String = "darwin"
        @cfg(os: "linux")
        def target(): String = "linux"
        def main(): Int
          return 0
        end
      """)
    end

    it("@cfg does not leak inactive branch") do ->
      ## On macOS, the linux branch should not be compiled
      assert_compile_succeeds("""
        @cfg(os: "macos")
        def cfg_only(): Int = 1
        @cfg(os: "linux")
        def cfg_only(): Int = 2
        def main(): Int
          return cfg_only()
        end
      """)
    end

    it("multiple @cfg-gated functions coexist") do ->
      assert_compile_succeeds("""
        @cfg(os: "macos")
        def fn_a(): Int = 1
        @cfg(os: "linux")
        def fn_a(): Int = 2
        @cfg(os: "macos")
        def fn_b(): Int = 10
        @cfg(os: "linux")
        def fn_b(): Int = 20
        def main(): Int
          return fn_a() + fn_b()
        end
      """)
    end

    it("@cfg can gate struct definitions") do ->
      assert_compile_succeeds("""
        @cfg(os: "macos")
        struct PlatData
          mac_field: Int
        end
        @cfg(os: "linux")
        struct PlatData
          linux_field: Int
        end
        def main(): Int
          return 0
        end
      """)
    end

    it("non-cfg function alongside cfg functions works") do ->
      assert_run_exits("""
        @cfg(os: "macos")
        def plat_val(): Int = 10
        @cfg(os: "linux")
        def plat_val(): Int = 20
        def common_val(): Int = 5
        def main(): Int
          return common_val()
        end
      """, 5)
    end

    it("@cfg with arch attribute") do ->
      assert_compile_succeeds("""
        @cfg(arch: "aarch64")
        def arch_fn(): Int = 1
        @cfg(arch: "x86_64")
        def arch_fn(): Int = 2
        def main(): Int = arch_fn()
      """)
    end

    it("@cfg with compound conditions (all:)") do ->
      assert_compile_succeeds("""
        @cfg(all: os: "macos", arch: "aarch64")
        def combo(): Int = 1
        @cfg(all: os: "linux", arch: "x86_64")
        def combo(): Int = 2
        @cfg(all: os: "linux", arch: "aarch64")
        def combo(): Int = 3
        @cfg(all: os: "macos", arch: "x86_64")
        def combo(): Int = 4
        def main(): Int = combo()
      """)
    end

    it("@cfg with not: condition") do ->
      assert_compile_succeeds("""
        @cfg(not: os: "windows")
        def not_win(): Int = 1
        def main(): Int = not_win()
      """)
    end
  end

  return qspec_main()
end

