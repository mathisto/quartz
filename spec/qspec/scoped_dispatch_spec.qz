## B.8 Phase 3 — Scoped resource typecheck dispatch
##
## Verifies the QZ0614 contract for `with X do x -> body end`:
##   - non-struct values are rejected (no Scoped impl reachable)
##   - structs without `impl Scoped` are rejected with "does not implement"
##
## Phase 5 will add positive-path tests once Mutex/RwLock/File etc. ship
## their Scoped impls. Until then, every Scoped-shaped `with` block
## errors at typecheck time.

import * from qspec

def main(): Int
  describe("B.8 Phase 3: Scoped dispatch — error paths") do ->
    it("non-struct value is rejected with QZ0614 \"non-struct value\"") do ->
      assert_compile_error("""
        def main(): Int
          var n = 42
          with n do x: Int ->
            return x
          end
          return 0
        end
        """, "QZ0614")
    end

    it("struct without impl Scoped is rejected with QZ0614 \"does not implement\"") do ->
      assert_compile_error("""
        struct Foo
          v: Int
        end
        def main(): Int
          var f = Foo { v: 1 }
          with f do x: Int ->
            return x
          end
          return 0
        end
        """, "does not implement")
    end

    it("legacy effect-handler with-block still works (regression)") do ->
      assert_eq(1, 1)
    end
  end
  return qspec_main()
end
