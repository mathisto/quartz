## C.13 Phase 5 — MutexTrySelectable trait dispatch. Mirrors the shape
## of select_unified_recv_spec for the basic Selectable invariants
## (synchronous, non-contended cases). The active-wake contended test
## lives in spec/qz/select_unified_mutex_try_active_wake_smoke.qz
## (standalone — qspec describe/it lambdas can't express the
## worker-blocks-then-unlock pattern; see CLAUDE.md caveat).

import * from qspec
import * from std/sync/exclusion/mutex

def test_try_lockable_fires_on_unlocked_mutex(): Int
  var m = mutex(42)
  var result = 0
  select
    case v = try_lockable(m) =>
      result = v
      mutex_unlock(m.handle, v)
    default => result = -1
  end
  return result
end

def test_try_lockable_default_when_held(): Int
  var m = mutex(42)
  mutex_lock(m.handle)
  var result = 0
  select
    case v = try_lockable(m) =>
      result = v
      mutex_unlock(m.handle, v)
    default => result = 99
  end
  mutex_unlock(m.handle, 42)
  return result
end

def test_try_lockable_zero_protected_value(): Int
  var m = mutex(0)
  var result = -1
  select
    case v = try_lockable(m) =>
      # Distinguish v==0 (real value) from default short-circuit.
      result = 1000 + v
      mutex_unlock(m.handle, v)
    default => result = -1
  end
  return result
end

def test_try_lockable_underscore_binding(): Int
  var m = mutex(7)
  var result = 0
  select
    case _ = try_lockable(m) =>
      result = 11
      mutex_unlock(m.handle, 7)
    default => result = 22
  end
  return result
end

def test_try_lockable_with_explicit_value_writeback(): Int
  var m = mutex(10)
  select
    case v = try_lockable(m) =>
      # Acquire, mutate, release with new value.
      mutex_unlock(m.handle, v + 5)
    default => 0
  end
  # Second select: observe the new value.
  var result = 0
  select
    case v = try_lockable(m) =>
      result = v
      mutex_unlock(m.handle, v)
    default => result = -1
  end
  return result
end

def main(): Int
  describe("select unified — MutexTrySelectable trait dispatch") do ->
    it("try_lockable arm fires when mutex is unlocked") do ->
      assert_eq(test_try_lockable_fires_on_unlocked_mutex(), 42)
    end
    it("default arm fires when mutex is already held by current thread") do ->
      assert_eq(test_try_lockable_default_when_held(), 99)
    end
    it("try_lockable arm receives value 0 (not confused with None)") do ->
      assert_eq(test_try_lockable_zero_protected_value(), 1000)
    end
    it("try_lockable arm with `_` wildcard binding fires the body") do ->
      assert_eq(test_try_lockable_underscore_binding(), 11)
    end
    it("try_lockable acquires lock; arm body can mutate via unlock") do ->
      assert_eq(test_try_lockable_with_explicit_value_writeback(), 15)
    end
  end

  return qspec_main()
end
