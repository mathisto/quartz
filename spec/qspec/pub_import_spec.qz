import * from qspec
import pi_outer
import pi_deep
import pi_selective
import pi_rename

# ============================================================================
# `pub import` re-export semantics (Tier 3 #14)
# ============================================================================
# When a module M does `pub import X`, every public symbol of X becomes
# accessible as if it were a public symbol of M. Private symbols of X
# remain private. Transitivity is full: if A pub imports B and B pub
# imports C, consumers of A see C's surface through A.
#
# Design memo: docs/design/REEXPORTS_14.md
# ============================================================================

def test_basic_reexport(): Int
  # pi_outer pub-imports pi_inner, which defines pi_greet and pi_square.
  # Consumer reaches both via pi_outer's prefix.
  var g = pi_outer::pi_greet("be")
  if g == "hello, be!"
    return pi_outer::pi_square(6)
  end
  return -1
end

def test_outer_local_still_works(): Int
  # pi_outer's own function — re-export must not break the module's own defs.
  return pi_outer::pi_outer_local()
end

def test_transitivity(): Int
  # pi_deep pub-imports pi_outer, which pub-imports pi_inner.
  # pi_deep::pi_greet should reach pi_inner.pi_greet.
  var g = pi_deep::pi_greet("q")
  if g == "hello, q!"
    return pi_deep::pi_square(9)
  end
  return -1
end

def test_selective_reexport(): Int
  # pi_selective does `pub from pi_inner import pi_greet`. Only pi_greet
  # comes through under pi_selective's prefix; pi_square stays behind.
  var g = pi_selective::pi_greet("be")
  if g == "hello, be!"
    return 42
  end
  return -1
end

def test_selective_rename(): Int
  # pi_rename does `pub from pi_inner import pi_greet as greet_alias,
  # pi_square as squared`. The renamed names are what consumers see.
  var g = pi_rename::greet_alias("q")
  if g == "hello, q!"
    return pi_rename::squared(11)
  end
  return -1
end

def main(): Int
  describe("pub import") do ->
    it("re-exports public symbols of the imported module") do ->
      assert_eq(test_basic_reexport(), 36)
    end

    it("does not affect the re-exporting module's own definitions") do ->
      assert_eq(test_outer_local_still_works(), 7)
    end

    it("is transitive — A pub imports B pub imports C, A.c_symbol works") do ->
      assert_eq(test_transitivity(), 81)
    end

    it("selective `pub from X import a, b` re-exports only listed names") do ->
      assert_eq(test_selective_reexport(), 42)
    end

    it("rename `pub from X import a as b, c as d` publishes renamed names") do ->
      assert_eq(test_selective_rename(), 121)
    end
  end

  return qspec_main()
end
