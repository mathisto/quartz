# QSpec coverage for std/tui/layout.qz — Lipgloss-shaped composition
# primitives.
#
# Golden-string assertions for each public function: border (5
# styles), pad (4 directions + uniform helpers), align (left/center/
# right), join_vertical / join_horizontal (composition invariants),
# visible_width / line_count (measurement), truncate (codepoint-aware).

import * from qspec
import std/tui/layout as ly

def main(): Int
  describe("ly::visible_width") do ->
    it("returns 0 for empty string") do ->
      assert_eq(ly::visible_width(""), 0)
    end

    it("counts ASCII codepoints in a single line") do ->
      assert_eq(ly::visible_width("hello"), 5)
    end

    it("returns max-line width for multi-line content") do ->
      assert_eq(ly::visible_width("hi\nworld"), 5)
    end

    it("counts codepoints not bytes for multi-byte UTF-8") do ->
      # "héllo" = 5 codepoints (h, é, l, l, o); é is 2 bytes UTF-8
      assert_eq(ly::visible_width("héllo"), 5)
    end
  end

  describe("ly::line_count") do ->
    it("returns 0 for empty string") do ->
      assert_eq(ly::line_count(""), 0)
    end

    it("returns 1 for content with no newlines") do ->
      assert_eq(ly::line_count("hi"), 1)
    end

    it("counts newlines + 1") do ->
      assert_eq(ly::line_count("a\nb\nc"), 3)
    end
  end

  describe("ly::pad / pad_uniform / pad_horizontal / pad_vertical") do ->
    it("pad_uniform(1) wraps single line in 1 cell on all sides") do ->
      var out = ly::pad_uniform("hi", 1)
      # Expected:
      #   "    \n hi \n    "
      # 4-wide blank, then " hi " (left 1 + content + right 1), then 4-wide blank.
      assert_eq_str(out, "    \n hi \n    ")
    end

    it("pad_horizontal adds spaces left+right per line, no extra rows") do ->
      var out = ly::pad_horizontal("hi", 2)
      assert_eq_str(out, "  hi  ")
    end

    it("pad_vertical adds blank lines top+bottom") do ->
      var out = ly::pad_vertical("hi", 1)
      # First and last lines are 2-wide blanks (matches content width).
      assert_eq_str(out, "  \nhi\n  ")
    end

    it("pad aligns short lines to content width before applying right pad") do ->
      var out = ly::pad("ab\nx", 0, 1, 0, 0)
      # Content width 2; 'x' gets padded to 'x ' before the right pad of 1 space.
      assert_eq_str(out, "ab \nx  ")
    end
  end

  describe("ly::border / border_with") do ->
    it("BORDER_NONE returns content unchanged") do ->
      assert_eq_str(ly::border_with("hi", ly::BORDER_NONE()), "hi")
    end

    it("default thin border wraps single line") do ->
      assert_eq_str(ly::border("hi"), "┌──┐\n│hi│\n└──┘")
    end

    it("thick border uses heavy box-drawing characters") do ->
      assert_eq_str(ly::border_with("hi", ly::BORDER_THICK()), "┏━━┓\n┃hi┃\n┗━━┛")
    end

    it("rounded border uses curved corners") do ->
      assert_eq_str(ly::border_with("hi", ly::BORDER_ROUNDED()), "╭──╮\n│hi│\n╰──╯")
    end

    it("double border uses double-line characters") do ->
      assert_eq_str(ly::border_with("hi", ly::BORDER_DOUBLE()), "╔══╗\n║hi║\n╚══╝")
    end

    it("multi-line content aligns to the widest line before bordering") do ->
      var out = ly::border("ab\nxyzw")
      # Width 4; first line gets right-padded to "ab  ".
      assert_eq_str(out, "┌────┐\n│ab  │\n│xyzw│\n└────┘")
    end
  end

  describe("ly::align_left / align_center / align_right") do ->
    it("align_left right-pads to width") do ->
      assert_eq_str(ly::align_left("hi", 6), "hi    ")
    end

    it("align_right left-pads to width") do ->
      assert_eq_str(ly::align_right("hi", 6), "    hi")
    end

    it("align_center splits surplus, biases extra to the right") do ->
      # "hi" in width 6: 2 chars used, 4 surplus → 2 left + 2 right
      assert_eq_str(ly::align_center("hi", 6), "  hi  ")
      # Odd surplus: width 5, "hi" → 1 left + 2 right (biased right)
      assert_eq_str(ly::align_center("hi", 5), " hi  ")
    end

    it("align is a no-op when content already at or beyond width") do ->
      assert_eq_str(ly::align_left("hello", 3), "hello")
    end
  end

  describe("ly::join_vertical") do ->
    it("returns empty string for empty parts") do ->
      var parts = vec_new()
      assert_eq_str(ly::join_vertical(parts), "")
    end

    it("returns sole part unchanged when only one") do ->
      var parts = vec_new()
      vec_push(parts, "hi")
      assert_eq_str(ly::join_vertical(parts), "hi")
    end

    it("stacks parts left-aligned to widest part's width") do ->
      var parts = vec_new()
      vec_push(parts, "ab")
      vec_push(parts, "xyzw")
      vec_push(parts, "qq")
      # Widest is "xyzw" (4 chars); shorter parts get right-padded to 4.
      assert_eq_str(ly::join_vertical(parts), "ab  \nxyzw\nqq  ")
    end
  end

  describe("ly::join_horizontal") do ->
    it("concatenates single-line parts side-by-side") do ->
      var parts = vec_new()
      vec_push(parts, "ab")
      vec_push(parts, "xy")
      assert_eq_str(ly::join_horizontal(parts), "abxy")
    end

    it("pads short parts with their own width when others are taller") do ->
      var parts = vec_new()
      vec_push(parts, "a\nb\nc")     # 1 wide, 3 tall
      vec_push(parts, "xy")          # 2 wide, 1 tall
      # Row 0: "a" + "xy" → "axy"
      # Row 1: "b" + "  " (filler at xy's width) → "b  "
      # Row 2: "c" + "  " → "c  "
      assert_eq_str(ly::join_horizontal(parts), "axy\nb  \nc  ")
    end
  end

  describe("ly::truncate") do ->
    it("returns content unchanged when within bounds") do ->
      assert_eq_str(ly::truncate("hello", 10), "hello")
    end

    it("clamps each line to max_width codepoints") do ->
      assert_eq_str(ly::truncate("hello\nworld", 3), "hel\nwor")
    end

    it("preserves multi-byte codepoints (counts as 1, not byte length)") do ->
      # "héllo" = 5 codepoints; truncate to 3 → "hél"
      assert_eq_str(ly::truncate("héllo", 3), "hél")
    end
  end

  return qspec_main()
end
