## Index Chaining Tests
##
## Contract:
##   1. Vec get: `v[i]` reads elements by index.
##   2. UFCS size: `v.size` returns element count.
##   3. UFCS push: `v.push(x)` appends and increments size.
##   4. Bracket: `v[i]` reads elements via bracket syntax.
##   5. For loop: `v[i]` inside for loop accumulates sum.
##   6. StringBuilder: `sb_append` + `sb_to_string` works.
##   7. Literal bracket: vec literal `[...]` + bracket indexing.
##   8. Bracket set: `v[i] = x` assigns via bracket.
##   9. Struct UFCS: `vec[i].method()` dispatches UFCS on indexed struct.
##  10. Struct field: `vec[i].field` accesses field on indexed struct.
##  11. Cross-index arithmetic: `vec[i].field + vec[j].field`.
##  12. UFCS in loop: `for i in 0..v.size; v[i].method(); end`.
import * from qspec

struct IcPoint
  x: Int
  y: Int
end

def ic_point_sum(p: IcPoint): Int = p.x + p.y
def ic_point_scale(p: IcPoint, factor: Int): Int = (p.x + p.y) * factor

def ic_show_point_sum(p: IcPoint): Void
  var s = to_str(ic_point_sum(p))
  puts(s)
end

def main(): Int
  describe("index chaining") do ->
    it("indexes into a vector") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[0], 10)
      assert_eq(v[1], 20)
      assert_eq(v[2], 30)
    end
    it("supports v.size UFCS") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      assert_eq(v.size, 3)
    end
    it("supports v.push() UFCS") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v.size, 3)
      assert_eq(v[1], 20)
    end
    it("supports bracket indexing") do ->
      var v = [10, 20, 30, 40, 50]
      assert_eq(v[0], 10)
      assert_eq(v[4], 50)
    end
    it("indexes in for loop") do ->
      var v = [1, 2, 3, 4, 5]
      var sum = 0
      for i in 0..v.size
        sum = sum + v[i]
      end
      assert_eq(sum, 15)
    end
    it("supports sb_append and sb_to_string") do ->
      var sb = sb_new()
      sb_append(sb, "hello ")
      sb_append(sb, "world")
      assert_eq_str(sb_to_string(sb), "hello world")
    end
    it("vec literal with bracket indexing") do ->
      var v = [100, 200, 300]
      assert_eq(v[0] + v[2], 400)
    end
    it("bracket assignment") do ->
      var v = [1, 2, 3]
      v[1] = 99
      assert_eq(v[1], 99)
    end
  end

  describe("UFCS on vector-indexed structs") do ->
    it("calls UFCS method on indexed struct element") do ->
      var points = vec_new()
      points.push(IcPoint { x: 10, y: 20 })
      points.push(IcPoint { x: 30, y: 40 })
      assert_eq(points[0].ic_point_sum(), 30)
      assert_eq(points[1].ic_point_sum(), 70)
    end

    it("accesses field on indexed struct element") do ->
      var points = vec_new()
      points.push(IcPoint { x: 5, y: 15 })
      points.push(IcPoint { x: 25, y: 35 })
      assert_eq(points[0].x, 5)
      assert_eq(points[0].y, 15)
      assert_eq(points[1].x, 25)
      assert_eq(points[1].y, 35)
    end

    it("cross-index field arithmetic") do ->
      var points = vec_new()
      points.push(IcPoint { x: 10, y: 20 })
      points.push(IcPoint { x: 30, y: 40 })
      assert_eq(points[0].x + points[1].y, 50)
      assert_eq(points[1].x - points[0].y, 10)
    end

    it("UFCS method with extra args on indexed struct") do ->
      var points = vec_new()
      points.push(IcPoint { x: 3, y: 7 })
      assert_eq(points[0].ic_point_scale(5), 50)
    end

    it("UFCS in loop over indexed structs") do ->
      var points = vec_new()
      points.push(IcPoint { x: 1, y: 2 })
      points.push(IcPoint { x: 3, y: 4 })
      points.push(IcPoint { x: 5, y: 6 })
      var total = 0
      for i in 0..points.size
        total = total + points[i].ic_point_sum()
      end
      assert_eq(total, 21)
    end

    it("assert_output with UFCS on indexed struct") do ->
      assert_output("30\n", ic_show_first)
    end
  end

  return qspec_main()
end

def ic_make_points(): Vec<IcPoint>
  var points = vec_new<IcPoint>()
  points.push(IcPoint { x: 10, y: 20 })
  return points
end

def ic_show_first(): Void
  var points = ic_make_points()
  ic_show_point_sum(points[0])
end
