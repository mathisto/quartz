## Standard Library: Math Tests
##
## Contract:
##   1. Math_abs.
##   2. Math_min and math_max.
##   3. Math_pow.
##   4. Math_clamp.
##   5. Math_sign.
##   6. Math_gcd.
##   7. Math_lcm.
##   8. Math_is_even and math_is_odd.

import * from qspec
import math

def main(): Int
  describe("math_abs") do ->
    it("returns positive for negative") do ->
      assert_eq(math_abs(-42), 42)
    end

    it("returns same for positive") do ->
      assert_eq(math_abs(42), 42)
    end

    it("returns 0 for 0") do ->
      assert_eq(math_abs(0), 0)
    end
  end

  describe("math_min and math_max") do ->
    it("returns minimum of two ints") do ->
      assert_eq(math_min(3, 7), 3)
      assert_eq(math_min(7, 3), 3)
    end

    it("returns maximum of two ints") do ->
      assert_eq(math_max(3, 7), 7)
      assert_eq(math_max(7, 3), 7)
    end

    it("handles equal values") do ->
      assert_eq(math_min(5, 5), 5)
      assert_eq(math_max(5, 5), 5)
    end

    it("handles negative values") do ->
      assert_eq(math_min(-3, -7), -7)
      assert_eq(math_max(-3, -7), -3)
    end
  end

  describe("math_pow") do ->
    it("computes basic powers") do ->
      assert_eq(math_pow(2, 10), 1024)
      assert_eq(math_pow(3, 3), 27)
    end

    it("handles zero exponent") do ->
      assert_eq(math_pow(42, 0), 1)
    end

    it("handles one exponent") do ->
      assert_eq(math_pow(42, 1), 42)
    end

    it("handles base 1") do ->
      assert_eq(math_pow(1, 100), 1)
    end

    it("handles base 0") do ->
      assert_eq(math_pow(0, 5), 0)
    end
  end

  describe("math_clamp") do ->
    it("clamps below range") do ->
      assert_eq(math_clamp(-5, 0, 10), 0)
    end

    it("clamps above range") do ->
      assert_eq(math_clamp(15, 0, 10), 10)
    end

    it("returns value within range") do ->
      assert_eq(math_clamp(5, 0, 10), 5)
    end
  end

  describe("math_sign") do ->
    it("returns 1 for positive") do ->
      assert_eq(math_sign(42), 1)
    end

    it("returns -1 for negative") do ->
      assert_eq(math_sign(-42), -1)
    end

    it("returns 0 for zero") do ->
      assert_eq(math_sign(0), 0)
    end
  end

  describe("math_gcd") do ->
    it("computes GCD of two numbers") do ->
      assert_eq(math_gcd(12, 8), 4)
      assert_eq(math_gcd(15, 25), 5)
    end

    it("handles coprime numbers") do ->
      assert_eq(math_gcd(7, 13), 1)
    end

    it("handles one being zero") do ->
      assert_eq(math_gcd(0, 5), 5)
    end
  end

  describe("math_lcm") do ->
    it("computes LCM of two numbers") do ->
      assert_eq(math_lcm(4, 6), 12)
      assert_eq(math_lcm(3, 5), 15)
    end

    it("handles one being zero") do ->
      assert_eq(math_lcm(0, 5), 0)
    end
  end

  describe("math_is_even and math_is_odd") do ->
    it("checks even correctly") do ->
      assert(math_is_even(4))
      assert(math_is_even(0))
      assert(not math_is_even(3))
    end

    it("checks odd correctly") do ->
      assert(math_is_odd(3))
      assert(math_is_odd(1))
      assert(not math_is_odd(4))
    end
  end

  return qspec_main()
end
