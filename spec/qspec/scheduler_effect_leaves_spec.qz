## D5 — PSQ-7 scheduler-effect leaves audit
##
## For each suspendable-effect leaf intrinsic, constructing a minimal
## program that uses the leaf from a non-async `main()` with no explicit
## `sched_init()` call must still pull in the full runtime declarations
## (@__qz_sched*, @__qz_completion*) so the program compiles, links,
## and runs end-to-end.
##
## Before D5, only NODE_AWAIT's non-async path had been verified to
## flip `uses_scheduler` correctly (fixed in commit 1a60633c). D5
## audited every remaining suspendable leaf and locked the results here
## as regressions. Result: all leaves propagate correctly; no IR-level
## undefined-symbol gaps remain. Two non-atomic reads of slots 8
## (shutdown) and 34 (drain) in worker/spawn paths were also upgraded
## to atomic acquire to pair with their writers.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("PSQ-7 — suspendable effect leaves propagate uses_scheduler") do ->

    it("channel send/recv from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          var ch = channel_new(4)
          send(ch, 42)
          var v = recv(ch)
          return 0 if v == 42
          return 1
        end
        """, 0)
    end

    it("recv_timeout from bare main() compiles and runs") do ->
      # Semantics-agnostic: we only verify the intrinsic pulls in the
      # runtime correctly. Return value semantics are covered elsewhere.
      assert_run_exits("""
        def main(): Int
          var ch = channel_new(4)
          send(ch, 7)
          var v = recv_timeout(ch, 100)
          return 0
        end
        """, 0)
    end

    it("try_recv/try_send from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          var ch = channel_new(4)
          var r = try_send(ch, 99)
          var got = try_recv(ch)
          return 0
        end
        """, 0)
    end

    it("unbounded channel from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          var ch = channel_new_unbounded()
          send(ch, 1)
          send(ch, 2)
          var a = recv(ch)
          var b = recv(ch)
          return 0 if a == 1 and b == 2
          return 1
        end
        """, 0)
    end

    it("mutex_lock/mutex_unlock from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          var m = mutex_new(10)
          var v = mutex_lock(m)
          mutex_unlock(m, v + 5)
          var v2 = mutex_lock(m)
          mutex_unlock(m, v2)
          return 0 if v2 == 15
          return 1
        end
        """, 0)
    end

    it("rwlock ops from bare main() compile and run") do ->
      assert_run_exits("""
        def main(): Int
          var rw = rwlock_new(42)
          var v = rwlock_read(rw)
          rwlock_read_unlock(rw)
          return 0 if v == 42
          return 1
        end
        """, 0)
    end

    it("sched_yield from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          sched_yield()
          return 0
        end
        """, 0)
    end

    it("sched_idle_hook_set/clear from bare main() compiles and runs") do ->
      assert_run_exits("""
        def main(): Int
          sched_idle_hook_set() { puts("idle") }
          sched_idle_hook_clear()
          return 0
        end
        """, 0)
    end

  end
  return qspec_main()
end
