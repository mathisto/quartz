## Safety Audit Tests
##
## Tests for holes found during move/borrow system audit.
## Each test covers a specific gap that was identified and fixed.
##
## Contract:
##   1. For loop: move detection.
##   2. Borrow: partial move check.
##   3. If expression: move tracking.
##   4. List comp: move detection.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # HOLE 2: NODE_FOR move detection (mirrors NODE_WHILE)
  # ===========================================================================
  describe("for loop: move detection") do ->
    it("move inside for loop body is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          for i in 0..3
            consume(a)
          end
          return 0
        end
        """, "QZ1212")
    end

    it("no move in for loop body — variable usable after") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          for i in 0..3
            var dummy = 0
          end
          return consume(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # HOLE 10: Borrow of partially-moved value
  # ===========================================================================
  describe("borrow: partial move check") do ->
    it("borrow of partially-moved struct is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
          y: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(v: Int): Int = v
        def main(): Int
          var r = Res { x: 1, y: 2 }
          consume(r.x)
          var b = &r
          return 0
        end
        """, "QZ1216")
    end
  end

  # ===========================================================================
  # HOLE 1: NODE_IF in expression position — move state handling
  # ===========================================================================
  describe("if expression: move tracking") do ->
    it("move in if-expr then-branch only — QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          if 1
            consume(a)
          end
          return a.x
        end
        """, "QZ1214")
    end
  end

  # ===========================================================================
  # HOLE 5: List comprehension move tracking
  # ===========================================================================
  describe("list comp: move detection") do ->
    it("move inside list comprehension body is rejected") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          var items = vec_new()
          items.push(1)
          var result = [consume(a) for i in items]
          return 0
        end
        """, "QZ1212")
    end

    it("no move in list comp body — outer value usable after") do ->
      assert_run_exits("""
        def main(): Int
          var items = vec_new()
          items.push(10)
          items.push(20)
          var result = [i * 2 for i in items]
          return result[0]
        end
        """, 20)
    end
  end

  return qspec_main()
end
