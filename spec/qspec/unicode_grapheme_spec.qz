## Unicode Grapheme Cluster Tests (UAX #29)
##
## Contract:
##   1. ASCII — each char is one grapheme.
##   2. Combining marks — e + accent = 1 grapheme.
##   3. Regional indicators — flag pairs = 1 grapheme.
##   4. Emoji ZWJ sequences.
##   5. CRLF = 1 grapheme.
##   6. Grapheme count.

import * from qspec
import * from unicode
import * from unicode/grapheme

def main(): Int
  describe("str_grapheme_count") do ->
    it("ASCII: each char is one grapheme") do ->
      assert_eq(str_grapheme_count("hello"), 5)
    end

    it("empty string has 0 graphemes") do ->
      assert_eq(str_grapheme_count(""), 0)
    end

    it("single char is 1 grapheme") do ->
      assert_eq(str_grapheme_count("A"), 1)
    end

    it("precomposed e-acute is 1 grapheme") do ->
      var s = str_from_codepoint(0xE9)
      assert_eq(str_grapheme_count(s), 1)
    end

    it("e + combining acute is 1 grapheme") do ->
      var sb = sb_new()
      sb_append(sb, "e")
      sb_append(sb, str_from_codepoint(0x0301))
      var s = sb_to_string(sb)
      assert_eq(str_grapheme_count(s), 1)
    end

    it("e + two combining marks is 1 grapheme") do ->
      var sb = sb_new()
      sb_append(sb, "e")
      sb_append(sb, str_from_codepoint(0x0301))
      sb_append(sb, str_from_codepoint(0x0323))
      var s = sb_to_string(sb)
      assert_eq(str_grapheme_count(s), 1)
    end

    it("CRLF is 1 grapheme") do ->
      var sb = sb_new()
      sb_append(sb, str_from_codepoint(0x0D))
      sb_append(sb, str_from_codepoint(0x0A))
      var s = sb_to_string(sb)
      assert_eq(str_grapheme_count(s), 1)
    end

    it("flag emoji (2 regional indicators) is 1 grapheme") do ->
      ## U+1F1FA U+1F1F8 = US flag
      var sb = sb_new()
      sb_append(sb, str_from_codepoint(0x1F1FA))
      sb_append(sb, str_from_codepoint(0x1F1F8))
      var s = sb_to_string(sb)
      assert_eq(str_grapheme_count(s), 1)
    end

    it("4 regional indicators = 2 graphemes (2 flags)") do ->
      var sb = sb_new()
      sb_append(sb, str_from_codepoint(0x1F1FA))
      sb_append(sb, str_from_codepoint(0x1F1F8))
      sb_append(sb, str_from_codepoint(0x1F1EB))
      sb_append(sb, str_from_codepoint(0x1F1F7))
      var s = sb_to_string(sb)
      assert_eq(str_grapheme_count(s), 2)
    end
  end

  describe("str_graphemes iterator") do ->
    it("splits ASCII into individual chars") do ->
      var graphemes = vec_new()
      for gi in str_graphemes("ABC")
        var g = as_string(gi)
        graphemes.push(str_byte_len(g))
      end
      assert_eq(graphemes.size, 3)
      assert_eq(graphemes[0], 1)
      assert_eq(graphemes[1], 1)
      assert_eq(graphemes[2], 1)
    end

    it("keeps combining mark with base") do ->
      ## "e" + combining acute (2 codepoints, 1 grapheme)
      var sb = sb_new()
      sb_append(sb, "e")
      sb_append(sb, str_from_codepoint(0x0301))
      var s = sb_to_string(sb)
      var count = 0
      for gi in str_graphemes(s)
        var g = as_string(gi)
        count += 1
        ## The grapheme should be 3 bytes (e=1 + combining acute=2)
        assert_eq(str_byte_len(g), 3)
      end
      assert_eq(count, 1)
    end

    it("mixed text with combining marks") do ->
      ## "ae" + combining acute + "bc" = 4 graphemes
      ## a | e+combining | b | c
      var sb = sb_new()
      sb_append(sb, "ae")
      sb_append(sb, str_from_codepoint(0x0301))
      sb_append(sb, "bc")
      var s = sb_to_string(sb)
      var count = 0
      for gi in str_graphemes(s)
        count += 1
      end
      assert_eq(count, 4)
    end

    it("break works mid-iteration") do ->
      var count = 0
      for gi in str_graphemes("ABCDEF")
        count += 1
        if count == 3
          break
        end
      end
      assert_eq(count, 3)
    end
  end

  return qspec_main()
end
