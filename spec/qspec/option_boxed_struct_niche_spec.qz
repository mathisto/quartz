## Option<boxed struct> niche-representation tests (N3 item 6.3, Phase 3).
##
## Contract under the niche flip:
##   None  = null pointer (0); Some(p) = the pointer p (single word, no tag).
##   Discriminant: None <=> value == 0, Some <=> value != 0.
##
## These tests are representation-agnostic at the source level — they MUST pass
## under both the old tagged layout and the new niche layout. Their value is as a
## differential oracle across the flip: identical source, identical observable
## behavior, regardless of which physical representation Option<Point> uses.
##
## Coverage:
##   - Some(Point{..}) round-trip: is Some / match Some(p) => / .unwrap().x
##   - None of Option<Point>: is None / .is_none() / match None =>
##   - round-trip through a function arg and return (call-arg/return niche slots)
##   - NESTED Option<Option<Point>>: Some(None) must differ from None (soundness)
##   - NON-niche locks: Option<Int> and Option<CPtr> stay correct (tagged)
import * from qspec

struct Point
  x: Int
  y: Int
end

def main(): Int
  describe("Option<Point> niche — Some round-trip") do ->
    it("is Some for a constructed Some(Point)") do ->
      opt = Option::Some(Point { x: 10, y: 20 })
      assert_eq(opt is Some, 1)
    end
    it("matches Some(p) and reads fields") do ->
      opt = Option::Some(Point { x: 10, y: 20 })
      sum = match opt
        Some(p) => p.x + p.y
        None => -1
      end
      assert_eq(sum, 30)
    end
    it("unwrap().x returns the payload field") do ->
      opt = Option::Some(Point { x: 7, y: 99 })
      p = opt.unwrap()
      assert_eq(p.x, 7)
    end
  end

  describe("Option<Point> niche — None") do ->
    it("is None for an explicit None") do ->
      opt = none_point()
      assert_eq(opt is None, 1)
    end
    it("is_none() true / is_some() false for None") do ->
      opt = none_point()
      assert_eq(opt.is_none(), 1)
    end
    it("matches the None arm") do ->
      opt = none_point()
      v = match opt
        Some(p) => 1
        None => 0
      end
      assert_eq(v, 0)
    end
  end

  describe("Option<Point> niche — round-trip through call boundary") do ->
    it("passes Some(Point) as arg and returns it, fields intact") do ->
      opt = roundtrip(Option::Some(Point { x: 3, y: 4 }))
      r = match opt
        Some(p) => p.x * 100 + p.y
        None => -1
      end
      assert_eq(r, 304)
    end
    it("passes None through arg+return as None") do ->
      opt = roundtrip(none_point())
      assert_eq(opt is None, 1)
    end
  end

  describe("Option<Option<Point>> nested — soundness catch-net") do ->
    it("Some(None) is outer-Some (distinguishable from outer-None)") do ->
      opt = some_none()
      assert_eq(opt is Some, 1)
    end
    it("Some(None): inner is None") do ->
      opt = some_none()
      inner_is_none = match opt
        Some(inner) => if inner is None then 1 else 0 end
        None => -1
      end
      assert_eq(inner_is_none, 1)
    end
    it("outer None is distinct from Some(None)") do ->
      opt = outer_none()
      assert_eq(opt is None, 1)
    end
    it("Some(Some(Point)) reaches the inner payload") do ->
      opt = some_some()
      v = match opt
        Some(inner) => match inner
          Some(p) => p.x
          None => -2
        end
        None => -1
      end
      assert_eq(v, 42)
    end
  end

  describe("generic Option<T> return de-erases the payload (Phase 2)") do ->
    it("first_of<Point> Some(p) => p.x reads the field (was runtime SIGSEGV)") do ->
      ps = vec_new<Point>()
      ps.push(Point { x: 42, y: 7 })
      v = match first_of<Point>(ps)
        Some(p) => p.x
        None => -1
      end
      assert_eq(v, 42)
    end
    it("first_of<Point> on an empty vec matches the None arm") do ->
      ps = vec_new<Point>()
      v = match first_of<Point>(ps)
        Some(p) => p.x
        None => -1
      end
      assert_eq(v, -1)
    end
    # PENDING (Phase 2 tail): inferred `first_of(ps)` with NO explicit type-arg
    # still erases — Path B must infer T from the ARGUMENT's type, but the local
    # `ps = vec_new<Point>()` is not tracked as `Vec<Point>` at the call site, so
    # T binds nothing and the payload stays erased (runtime SIGSEGV, same as pre-
    # Phase-2). This is the local/construction concrete-tracking gap (sibling of
    # the inferred-inline nested-construction crash), filed for the Phase 2 tail.
    it_pending("inferred first_of(ps) (no explicit type arg) de-erases via arg type")
  end

  describe("non-niche locks stay tagged + correct") do ->
    it("Option<Int> Some round-trips") do ->
      opt = Option::Some(123)
      v = match opt
        Some(x) => x
        None => -1
      end
      assert_eq(v, 123)
    end
    it("Option<Int> None round-trips") do ->
      opt = none_int()
      v = match opt
        Some(x) => x
        None => 777
      end
      assert_eq(v, 777)
    end
    it("Option<CPtr> Some round-trips (non-null)") do ->
      opt = Option::Some(cptr_one())
      assert_eq(opt is Some, 1)
    end
    it("Option<CPtr> None round-trips") do ->
      opt = none_cptr()
      assert_eq(opt is None, 1)
    end
  end

  return qspec_main()
end

def none_point(): Option<Point>
  return Option::None
end

## Phase 2 payload de-erasure oracle: a generic function whose payload `T` is
## carried ONLY inside a wrapped param (`Vec<T>`) and returned as `Option<T>`.
## Pre-fix, mir_subst_return_type_for_call bound `T` only from a param annotated
## EXACTLY `T`, so `Vec<T>` left the return erased to `Option<T>` → the Some-bind
## read a scalar as a pointer → `p.x` segfaulted.
def first_of<T>(v: Vec<T>): Option<T>
  return Option::None if v.size == 0
  return Option::Some(v[0])
end

def roundtrip(o: Option<Point>): Option<Point>
  return o
end

def some_none(): Option<Option<Point>>
  return Option::Some(none_point())
end

def outer_none(): Option<Option<Point>>
  return Option::None
end

def some_some(): Option<Option<Point>>
  return Option::Some(Option::Some(Point { x: 42, y: 0 }))
end

def none_int(): Option<Int>
  return Option::None
end

def cptr_one(): CPtr
  return int_to_cptr(1)
end

def none_cptr(): Option<CPtr>
  return Option::None
end
