## Vec Unchecked Tests
##
## Contract:
##   1. Get: `vec_get_unchecked` reads elements without bounds check.
##   2. Set: `vec_set_unchecked` writes elements without bounds check.
##   3. Loop: works correctly in tight loops (performance path).
##   4. Mixed: checked and unchecked access interoperate.
##   5. Overwrite: unchecked set then unchecked get roundtrip.
import * from qspec

def main(): Int
  describe("vec unchecked ops") do ->
    it("vec_get_unchecked reads correctly") do ->
      var v = [10, 20, 30]
      assert_eq(vec_get_unchecked(v, 0), 10)
      assert_eq(vec_get_unchecked(v, 1), 20)
      assert_eq(vec_get_unchecked(v, 2), 30)
    end
    it("vec_set_unchecked writes correctly") do ->
      var v = [0, 0]
      vec_set_unchecked(v, 0, 42)
      vec_set_unchecked(v, 1, 99)
      assert_eq(v[0], 42)
      assert_eq(v[1], 99)
    end
    it("works in tight loop") do ->
      var v = vec_new()
      for i in 0..100
        v.push(i)
      end
      var sum = 0
      for i in 0..100
        sum = sum + vec_get_unchecked(v, i)
      end
      assert_eq(sum, 4950)
    end
    it("mixed checked and unchecked access") do ->
      var v = vec_new()
      for i in 0..5
        v.push(i * 10)
      end
      vec_set_unchecked(v, 2, 999)
      assert_eq(v[2], 999)
      assert_eq(vec_get_unchecked(v, 0), 0)
    end

    it("unchecked set then unchecked get roundtrip") do ->
      var v = [0, 0, 0]
      vec_set_unchecked(v, 0, 11)
      vec_set_unchecked(v, 1, 22)
      vec_set_unchecked(v, 2, 33)
      assert_eq(vec_get_unchecked(v, 0) + vec_get_unchecked(v, 1) + vec_get_unchecked(v, 2), 66)
    end
  end
  return qspec_main()
end
