## Macro Hygiene Tests — Phase 3 (Tier 2 #8b-followup)
##
## Contract:
##   1. Negative: macro body locals don't collide with caller-scope names.
##   2. Positive: `$caller(name)` escape hatch reaches caller scope.
##   3. Error paths: `$caller` with missing binding and wrong arg shape.
##
## Backstop for the P3 sprint. Before alpha-rename landed (P3.d), a
## body-local `var tmp` in an expansion would silently shadow the caller's
## `var tmp` at the codegen level — even after P3.b/P3.c stamped scope
## sets at the AST and typecheck layers. Each test below would have failed
## on the pre-P3.d compiler; they're preserved here to catch regressions
## on the rename pass and the escape-hatch flow.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("macro hygiene — body locals don't collide with caller scope") do ->
    it("body `var tmp = 99` doesn't overwrite caller's `var tmp = 1`") do ->
      assert_run_exits(mh_no_collision_src(), 1)
    end

    it("body assigns to its own `tmp`, caller's `tmp` survives") do ->
      assert_run_exits(mh_body_assign_isolated_src(), 1)
    end

    it("distinct expansions get distinct hygiene scopes") do ->
      assert_run_exits(mh_two_expansions_src(), 42)
    end
  end

  describe("macro hygiene — `$caller(name)` escape hatch") do ->
    it("`$caller(x)` reaches past body-local `var x`") do ->
      assert_run_exits(mh_caller_reaches_out_src(), 42)
    end

    it("`$caller(x)` reads the caller's current value") do ->
      assert_run_exits(mh_caller_reads_src(), 7)
    end
  end

  describe("macro hygiene — error paths") do ->
    it("`$caller` with missing caller binding errors at typecheck") do ->
      assert_compile_error(mh_caller_missing_src(), "Undefined")
    end

    it("`$caller` with non-ident arg emits QZ0510") do ->
      assert_compile_error(mh_caller_non_ident_src(), "QZ0510")
    end
  end

  describe("macro hygiene — non-NODE_LET binder categories (P3.f/g/h)") do ->
    it("for-loop var doesn't collide with caller's same-named var") do ->
      assert_run_exits(mh_for_loop_src(), 0)
    end

    it("tuple destructure bindings don't leak into caller scope") do ->
      assert_run_exits(mh_tuple_destructure_src(), 0)
    end

    it("is-check bound name doesn't collide with caller's binding") do ->
      assert_run_exits(mh_is_check_src(), 0)
    end
  end

  return qspec_main()
end

# Body binds its own `tmp = 99`. Caller's `var tmp = 1` must survive
# the expansion intact; `return tmp` should yield the caller's value.
def mh_no_collision_src(): String = """
macro make_tmp() do
  quote do
    var tmp = 99
  end
end

def main(): Int
  var tmp = 1
  $make_tmp()
  return tmp
end
"""

# Body mutates its own `tmp`. The caller has a same-named `tmp` but
# the mutation inside the body must not leak out. `return tmp` must
# still see the caller's original value.
def mh_body_assign_isolated_src(): String = """
macro touch() do
  quote do
    var tmp = 0
    tmp = 999
  end
end

def main(): Int
  var tmp = 1
  $touch()
  return tmp
end
"""

# Two separate expansions of the same macro in one function must not
# collide with each other. Each expansion allocates its own hygiene
# scope, so their body-local `tmp`s are distinct at the rename level.
# Caller's `tmp = 42` survives both invocations; program returns 42.
def mh_two_expansions_src(): String = """
macro shadow_and_drop() do
  quote do
    var tmp = 0
    tmp = 100
  end
end

def main(): Int
  var tmp = 42
  $shadow_and_drop()
  $shadow_and_drop()
  return tmp
end
"""

# `$caller(x)` inside the body reaches PAST the body-local `var x = 99`
# to the caller's binding. Return value proves it: body's sum expression
# evaluates to 0 (arg) + 42 (caller's x), returned straight out.
def mh_caller_reaches_out_src(): String = """
macro leak(x) do
  quote do
    var x = 99
    unquote(x) + $caller(x)
  end
end

def main(): Int
  var x = 42
  return $leak(0)
end
"""

# The caller can mutate its binding between declaration and the macro's
# expansion point; `$caller` sees the most recent value, not a snapshot.
def mh_caller_reads_src(): String = """
macro add_caller_n() do
  quote do
    $caller(n) + 5
  end
end

def main(): Int
  var n = 2
  return $add_caller_n()
end
"""

# `$caller(missing)` emits a NODE_IDENT with the caller's scope set.
# When no such binding exists in the caller, typecheck fails with
# "Undefined variable". The test checks just the "Undefined" substring
# so the exact message can evolve without flaking this spec.
def mh_caller_missing_src(): String = """
macro get_missing() do
  quote do
    $caller(nonexistent)
  end
end

def main(): Int
  return $get_missing()
end
"""

# `$caller` must be invoked with a NODE_IDENT argument; a literal or
# expression is rejected with QZ0510.
def mh_caller_non_ident_src(): String = """
macro get_bad() do
  quote do
    $caller(42)
  end
end

def main(): Int
  return $get_bad()
end
"""

# P3.f: for-loop variable is a body-local binder. Caller's `i` and
# `total` must survive the expansion unchanged.
def mh_for_loop_src(): String = """
macro run_loop() do
  quote do
    var total = 0
    for i in 0..5
      total = total + i
    end
  end
end

def main(): Int
  var i = 77
  var total = 100
  $run_loop()
  return i + total - 177
end
"""

# P3.g: tuple destructure in a macro body must not shadow caller-scope
# bindings of the same names. Caller keeps `a=1, b=2, sum=7`.
def mh_tuple_destructure_src(): String = """
macro use_tuple() do
  quote do
    var (a, b) = (10, 20)
    var sum = a + b
  end
end

def main(): Int
  var a = 1
  var b = 2
  var sum = 7
  $use_tuple()
  return a + b + sum - 10
end
"""

# P3.h: `is` pattern binds a payload name that must not shadow the
# caller's same-named var. Body's `payload` lives entirely inside its
# rename; caller's `payload = 500` is untouched.
def mh_is_check_src(): String = """
enum Opt
  Some(Int),
  None
end

macro unwrap_into(x) do
  quote do
    var payload = 0
    if unquote(x) is Some(payload)
      payload = payload + 1
    end
  end
end

def main(): Int
  var payload = 500
  var opt = Opt.Some(42)
  $unwrap_into(opt)
  return payload - 500
end
"""
