## Argparse Tests

import * from qspec

def main(): Int
  describe("argparse stdlib") do ->
    it("detects a flag") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_flag(p, "-v", "--verbose")
          var argv = vec_new<String>()
          vec_push(argv, "--verbose")
          var args = argparser_parse(p, argv)
          print_int(argparse_has(args, "--verbose"))
          return 0
        end
        """, "1\n")
    end

    it("detects a short flag") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_flag(p, "-v", "--verbose")
          var argv = vec_new<String>()
          vec_push(argv, "-v")
          var args = argparser_parse(p, argv)
          print_int(argparse_has(args, "--verbose"))
          return 0
        end
        """, "1\n")
    end

    it("parses option with value") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_option(p, "-o", "--output")
          var argv = vec_new<String>()
          vec_push(argv, "--output")
          vec_push(argv, "build/out.ll")
          var args = argparser_parse(p, argv)
          puts(argparse_get(args, "--output"))
          return 0
        end
        """, "build/out.ll\n")
    end

    it("returns 0 for unknown flag") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_flag(p, "-v", "--verbose")
          var argv = vec_new<String>()
          var args = argparser_parse(p, argv)
          print_int(argparse_has(args, "--verbose"))
          return 0
        end
        """, "0\n")
    end

    it("returns empty string for missing option") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_option(p, "-o", "--output")
          var argv = vec_new<String>()
          var args = argparser_parse(p, argv)
          var val = argparse_get(args, "--output")
          print_int(str_size(val))
          return 0
        end
        """, "0\n")
    end

    it("handles multiple flags and options") do ->
      assert_run_stdout_eq("""
        import * from argparse
        def main(): Int
          var p = argparser_new()
          argparser_flag(p, "-v", "--verbose")
          argparser_flag(p, "-d", "--debug")
          argparser_option(p, "-o", "--output")
          var argv = vec_new<String>()
          vec_push(argv, "-v")
          vec_push(argv, "--output")
          vec_push(argv, "a.ll")
          vec_push(argv, "-d")
          var args = argparser_parse(p, argv)
          print_int(argparse_has(args, "--verbose"))
          print_int(argparse_has(args, "--debug"))
          puts(argparse_get(args, "--output"))
          return 0
        end
        """, "1\n1\na.ll\n")
    end
  end
  return qspec_main()
end
