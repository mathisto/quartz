## Multi-Level Borrow Tracking Tests — QZ1217
##
## Contract:
##   1. Re-borrow protection: `c = &b` where `b = &a` → `a` protected from mutation.
##   2. Chain release: releasing `c`, then `b` → `a` unprotected, mutable.
##   3. N-level chain: 3+ levels all protect the root.
##   4. Shared re-borrow: multiple `&` along chain OK.
##   5. Mut re-borrow: `&mut` in chain prevents `&` of ancestor.
##   6. Chain release restores mutability of root.
##   7. Shared + shared chain: multiple shared borrows stacking.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("multi-level borrows: QZ1217") do ->
    it("re-borrow protects ancestor from mutation") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var b = &x
          var c = &b
          x = 99
          return 0
        end
        """, "QZ1209")
    end

    it("releasing re-borrow unprotects ancestor") do ->
      assert_compile_succeeds("""
        def main(): Int
          var x = 42
          var b = &x
          var c = &b
          c = 0
          b = 0
          x = 99
          return x
        end
        """)
    end

    it("3-level borrow chain protects all ancestors") do ->
      assert_compile_error("""
        def main(): Int
          var a = 42
          var b = &a
          var c = &b
          var d = &c
          a = 99
          return 0
        end
        """, "QZ1209")
    end

    it("shared re-borrow allows multiple shared borrows of ancestor") do ->
      assert_compile_succeeds("""
        def main(): Int
          var x = 42
          var b1 = &x
          var b2 = &x
          var c = &b1
          return 0
        end
        """)
    end

    it("mut re-borrow prevents shared borrow of ancestor") do ->
      assert_compile_error("""
        def main(): Int
          var x = 42
          var b = &mut x
          var c = &b
          var d = &x
          return 0
        end
        """, "QZ1206")
    end
  end

  # ===========================================================================
  # Chain release and restoration
  # ===========================================================================
  describe("multi-level borrows: chain release") do ->
    it("release re-borrow, then middle, then mutate root OK") do ->
      assert_compile_succeeds("""
        def main(): Int
          var a = 42
          var b = &a
          var c = &b
          c = 0
          b = 0
          a = 99
          return a
        end
        """)
    end

    it("shared + shared chain allows mutation after full release") do ->
      assert_run_exits("""
        def main(): Int
          var a = 42
          var b = &a
          var c = &a
          var d = &b
          d = 0
          c = 0
          b = 0
          a = 99
          return a
        end
        """, 99)
    end

    it("mut borrow in chain prevents mutation of root") do ->
      assert_compile_error("""
        def main(): Int
          var a = 42
          var b = &mut a
          var c = &b
          a = 99
          return 0
        end
        """, "QZ1209")
    end

    it("3-level chain: full release restores mutability") do ->
      assert_run_exits("""
        def main(): Int
          var a = 42
          var b = &a
          var c = &b
          var d = &c
          d = 0
          c = 0
          b = 0
          a = 99
          return a
        end
        """, 99)
    end
  end

  return qspec_main()
end
