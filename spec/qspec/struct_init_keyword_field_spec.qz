## Reserved keywords as struct-literal / effect-op-filter field names.
##
## Filed bug: `docs/bugs/PIEZO_AWAIT_KEYWORD_WITH_BLOCK_HANG.md` (fixed).
##
## Before the fix, a field key that lexed as a reserved keyword (e.g.
## `await`, `async`, `go`) caused the struct-init parser's while-loop
## to spin forever — `ps_expect(TOK_IDENT, ...)` emitted an error
## without advancing the position, and the loop's exit condition
## (`ps_check(TOK_RBRACE)`) never triggered.
##
## The fix accepts reserved-keyword tokens as legal identifiers in
## field-name position (they're always safe here — the only
## ambiguity-free interpretation of `{ await: h }` is "field named
## `await`"). Uses the existing `_ps_is_reserved_ident_token` helper.
## Non-identifier tokens in the slot still error — and now have an
## explicit break to avoid the same hang on genuinely malformed
## input.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("struct-literal reserved-keyword field names (post parser-hang fix)") do ->
    it("`with Eff { await: h }` handler map parses without hanging") do ->
      # The minimal repro from the bug file. Pre-fix this hung the
      # compiler at 99% CPU with unbounded RAM; post-fix it compiles
      # and runs cleanly.
      assert_run_exits("""
effect MyEff
  def await(h: Int): Int
end

def my_await(op: Int, argc: Int, argv: Int): Int = 999

def main(): Int
  with MyEff { await: my_await } do ->
    puts("inside")
  end
  return 0
end
""", 0)
    end

    it("`async` as field name in a with-block's op-filter map") do ->
      # Same fix path covers all reserved-keyword tokens, not just
      # `await`. Uses `async` as the op name — the lexer classifies
      # `async` as TOK_ASYNC which was also blocked by the same parser
      # bug.
      assert_run_exits("""
effect Foo
  def async(x: Int): Int
end

def my_async(op: Int, argc: Int, argv: Int): Int = 0

def main(): Int
  with Foo { async: my_async } do ->
    puts("ok")
  end
  return 0
end
""", 0)
    end

    it("genuinely malformed struct field errors with advancement, not hang") do ->
      # Regression guard for the break-on-unexpected fix: without the
      # explicit break, any unparseable token would have resurrected
      # the hang. Integer `42` in field-name position must fire a
      # diagnostic and terminate parsing — compile fails, no hang.
      assert_compile_error("""
struct Point
  x: Int
  y: Int
end

def main(): Int
  var p = Point { 42: 1, y: 2 }
  return 0
end
""", "Expected field name")
    end
  end
  return qspec_main()
end
