## Binary DSL — Sub-phase 1.2 typecheck coverage.
##
## Enforces the invariants locked in `docs/design/BINARY_DSL.md`:
##   QZ0950  binary {} total bit width must be a positive multiple of 8
##   QZ0951  packed struct(uN) field widths must sum to exactly N
##   QZ0952  multi-byte fields must start at byte-aligned bit offsets
##   QZ0953  sub-byte types (u1..u7, i1..i7) only legal inside the DSL
##
## Sub-phase 1.3 wires MIR opcodes; sub-phase 1.4 ships real codegen.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ0950 — binary {} total width multiple of 8") do ->

    it("accepts IPv4 header (160 bits)") do ->
      assert_compile_succeeds("""
        type IPv4Header = binary {
          version: u4
          ihl:     u4
          tos:     u8
          total:   u16be
          id:      u16be
          flags:   u3
          frag_off: u13be
          ttl:     u8
          proto:   u8
          checksum: u16be
          src:     u32be
          dst:     u32be
          payload: bytes
        }
        def main(): Int = 0
        """)
    end

    it("rejects 7-bit binary block") do ->
      assert_compile_error("""
        type BadAlign = binary {
          flags: u4
          count: u3
        }
        def main(): Int = 0
        """, "QZ0950")
    end

    it("rejects empty binary block") do ->
      assert_compile_error("""
        type Empty = binary {}
        def main(): Int = 0
        """, "QZ0950")
    end

    it("accepts 8-bit binary block with explicit u1 pad") do ->
      assert_compile_succeeds("""
        type GoodAlign = binary {
          flags: u4
          count: u3
          _:     u1
        }
        def main(): Int = 0
        """)
    end

    it("error message suggests the correct pad width") do ->
      assert_compile_error("""
        type OddWidth = binary {
          a: u3
        }
        def main(): Int = 0
        """, "_: u5")
    end
  end

  describe("QZ0951 — packed struct(uN) widths sum to exactly N") do ->

    it("accepts packed struct(u32) with 16 two-bit fields") do ->
      assert_compile_succeeds("""
        packed struct(u32) GpioModer
          a: 2
          b: 2
          c: 2
          d: 2
          e: 2
          f: 2
          g: 2
          h: 2
          i: 2
          j: 2
          k: 2
          l: 2
          m: 2
          n: 2
          o: 2
          p: 2
        end
        def main(): Int = 0
        """)
    end

    it("rejects packed struct(u32) with only 20 bits of fields") do ->
      assert_compile_error("""
        packed struct(u32) Bad
          a: 10
          b: 10
        end
        def main(): Int = 0
        """, "QZ0951")
    end

    it("rejects packed struct(u8) that overflows to 10 bits") do ->
      assert_compile_error("""
        packed struct(u8) Over
          a: 5
          b: 5
        end
        def main(): Int = 0
        """, "QZ0951")
    end

    it("accepts packed struct(u8) with explicit pad") do ->
      assert_compile_succeeds("""
        packed struct(u8) Flags8
          enabled: 1
          role:    3
          _:       4
        end
        def main(): Int = 0
        """)
    end
  end

  describe("QZ0952 — multi-byte fields must start byte-aligned") do ->

    it("rejects u16be after u4 without pad") do ->
      assert_compile_error("""
        type Misaligned = binary {
          a: u4
          b: u16be
          c: u4
        }
        def main(): Int = 0
        """, "QZ0952")
    end

    it("suggests correct pad width in QZ0952 message") do ->
      assert_compile_error("""
        type Misaligned = binary {
          a: u3
          b: u32be
        }
        def main(): Int = 0
        """, "_: u5")
    end

    it("accepts u16be after u4 + u4 (byte-aligned)") do ->
      assert_compile_succeeds("""
        type Aligned = binary {
          a: u4
          b: u4
          c: u16be
          d: u8
        }
        def main(): Int = 0
        """)
    end

    it("rejects bytes field after sub-byte without pad") do ->
      assert_compile_error("""
        type BadBytes = binary {
          a: u4
          rest: bytes
        }
        def main(): Int = 0
        """, "QZ0952")
    end
  end

  describe("QZ0953 — sub-byte types outside DSL blocks") do ->

    it("rejects var x: u4 at top level") do ->
      assert_compile_error("""
        def main(): Int
          var x: u4 = 0
          return x
        end
        """, "QZ0953")
    end

    it("rejects i3 return-type annotation") do ->
      assert_compile_error("""
        def tiny(): i3 = 0
        def main(): Int = 0
        """, "QZ0953")
    end

    it("rejects u7 function parameter") do ->
      assert_compile_error("""
        def f(x: u7): Int = 0
        def main(): Int = f(0)
        """, "QZ0953")
    end

    it("accepts u4 inside a binary block") do ->
      assert_compile_succeeds("""
        type Header = binary {
          version: u4
          ihl:     u4
        }
        def main(): Int = 0
        """)
    end

    it("accepts bare bit-width inside packed struct") do ->
      assert_compile_succeeds("""
        packed struct(u8) Flags
          a: 4
          b: 4
        end
        def main(): Int = 0
        """)
    end
  end

  describe("ParseError enum is importable") do ->

    it("std/binary.qz exposes ParseError with three variants") do ->
      assert_run_exits("""
        import * from binary
        def main(): Int
          var e1: ParseError = ParseError::UnexpectedEof
          var e2: ParseError = ParseError::InvalidValue("f", "ok", 42)
          var e3: ParseError = ParseError::LengthOverflow("n", 10, 3)
          return 0 if e1 is UnexpectedEof and e2 is InvalidValue and e3 is LengthOverflow
          return 1
        end
        """, 0)
    end
  end

  return qspec_main()
end
