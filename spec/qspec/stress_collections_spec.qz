## STRESS: Collection Edge Cases
##
## Adversarial tests probing collection dark corners:
## empty collections, single-element, grow/shrink cycles,
## nested collections, Vec edge cases, Map edge cases,
## Set operations, and collection interaction patterns.
##
## Contract:
##   1. Collections: empty operations.
##   2. Collections: Vec grow/shrink.
##   3. Collections: Vec indexing.
##   4. Collections: Map edge cases.
##   5. Collections: Set operations.
##   6. Collections: iteration patterns.
##   7. Collections: Vec of strings.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Empty Collection Operations
  # ===========================================================================
  describe("collections: empty operations") do ->
    it("empty Vec has size 0") do ->
      assert_run_exits("""
        def main(): Int
          v = vec_new()
          if v.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("empty Map has size 0") do ->
      assert_run_exits("""
        def main(): Int
          m = map_new()
          if m.size() == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("empty Vec literal") do ->
      assert_run_exits("""
        def main(): Int
          v = []
          if v.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("pop from single-element Vec returns element") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(42)
          match v.pop()
            Some(val) => {
              if val == 42
                if v.size == 0
                  return 0
                end
              end
            }
            _ => {}
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category B: Vec Grow/Shrink Cycles
  # ===========================================================================
  describe("collections: Vec grow/shrink") do ->
    it("push many then pop all") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          var i = 0
          while i < 100
            v.push(i)
            i = i + 1
          end
          if v.size != 100
            return 1
          end
          var j = 0
          while j < 100
            v.pop()
            j += 1
          end
          if v.size == 0
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("interleaved push/pop maintains consistency") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          var i = 0
          while i < 50
            v.push(i)
            v.push(i + 100)
            v.pop()
            i = i + 1
          end
          if v.size == 50
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("Vec clear then repopulate") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(1)
          v.push(2)
          v.push(3)
          v.clear()
          if v.size != 0
            return 1
          end
          v.push(10)
          v.push(20)
          if v.size == 2
            if v[0] == 10
              return 0
            end
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category C: Vec Index Edge Cases
  # ===========================================================================
  describe("collections: Vec indexing") do ->
    it("first and last element access") do ->
      assert_run_exits("""
        def main(): Int
          v = [10, 20, 30]
          if v[0] == 10
            if v[2] == 30
              return 0
            end
          end
          return 1
        end
        """, 0)
    end

    it("set then get at same index") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(0)
          v.push(0)
          v.push(0)
          v.set(1, 42)
          if v[1] == 42
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("Vec with single element") do ->
      assert_run_exits("""
        def main(): Int
          v = [99]
          if v.size == 1
            if v[0] == 99
              return 0
            end
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category D: Map Edge Cases
  # ===========================================================================
  describe("collections: Map edge cases") do ->
    it("overwrite existing key") do ->
      assert_run_exits("""
        def main(): Int
          var m = map_new()
          m.set("key", 10)
          m.set("key", 42)
          match m.get("key")
            Some(v) => {
              if v == 42
                return 0
              end
            }
            _ => {}
          end
          return 1
        end
        """, 0)
    end

    it("get non-existent key returns None") do ->
      assert_run_exits("""
        def main(): Int
          m = map_new()
          match m.get("missing")
            Some(v) => return 1
            _ => return 0
          end
        end
        """, 0)
    end

    it("has returns 0 for missing key") do ->
      assert_run_exits("""
        def main(): Int
          m = map_new()
          m.set("a", 1)
          if not m.has("b")
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("delete then has returns 0") do ->
      assert_run_exits("""
        def main(): Int
          var m = map_new()
          m.set("key", 42)
          m.delete("key")
          if not m.has("key")
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("many inserts trigger resize correctly") do ->
      assert_run_exits("""
        def main(): Int
          var m = map_new()
          var i = 0
          while i < 200
            m.set(str_from_int(i), i)
            i = i + 1
          end
          var ok = 1
          i = 0
          while i < 200
            match m.get(str_from_int(i))
              Some(v) => {
                if v != i
                  ok = 0
                end
              }
              _ => ok = 0
            end
            i = i + 1
          end
          if ok
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category E: Set Operations
  # ===========================================================================
  describe("collections: Set operations") do ->
    it("add and check membership") do ->
      assert_run_exits("""
        def main(): Int
          var s = set_new()
          set_add(s, 42)
          if set_has(s, 42)
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("remove element") do ->
      assert_run_exits("""
        def main(): Int
          var s = set_new()
          set_add(s, 10)
          set_delete(s, 10)
          if not set_has(s, 10)
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("set deduplicates") do ->
      assert_run_exits("""
        def main(): Int
          var s = set_new()
          set_add(s, 5)
          set_add(s, 5)
          set_add(s, 5)
          if set_size(s) == 1
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("set literal with set_size and set_has") do ->
      assert_run_exits("""
        def main(): Int
          s = {10, 20, 30}
          if set_size(s) == 3
            if set_has(s, 20)
              if not set_has(s, 99)
                return 0
              end
            end
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category F: Collection Iteration Patterns
  # ===========================================================================
  describe("collections: iteration patterns") do ->
    it("for-in over Vec") do ->
      assert_run_exits("""
        def main(): Int
          v = [10, 20, 30]
          var sum = 0
          for x in v
            sum = sum + x
          end
          if sum == 60
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("for-in with index range on Vec") do ->
      assert_run_exits("""
        def main(): Int
          v = [5, 10, 15, 20, 25]
          var sum = 0
          for i in 0..v.size
            sum = sum + v[i]
          end
          if sum == 75
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("list comprehension") do ->
      assert_run_exits("""
        def main(): Int
          v = [10, 20, 30]
          doubled = [x * 2 for x in v]
          if doubled.size == 3
            if doubled[0] == 20
              if doubled[2] == 60
                return 0
              end
            end
          end
          return 1
        end
        """, 0)
    end

    it("filtered list comprehension") do ->
      assert_run_exits("""
        def main(): Int
          v = [1, 2, 3, 4, 5, 6]
          evens = [x for x in v if x % 2 == 0]
          if evens.size == 3
            if evens[0] == 2
              if evens[2] == 6
                return 0
              end
            end
          end
          return 1
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category G: Vec of Strings
  # ===========================================================================
  describe("collections: Vec of strings") do ->
    it("push and retrieve strings") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(as_int("hello"))
          v.push(as_int("world"))
          if v.size == 2
            s = as_string(v[0])
            if s == "hello"
              return 0
            end
          end
          return 1
        end
        """, 0)
    end

    it("string split returns correct parts") do ->
      assert_run_exits("""
        def main(): Int
          parts = str_split("a:b:c", ":")
          if parts.size == 3
            return 0
          end
          return 1
        end
        """, 0)
    end
  end

  return qspec_main()
end
