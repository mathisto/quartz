## Binary DSL — Phase 2 Track B (discriminated unions) typecheck coverage.
##
## Validates the typechecker's variant-registration, position rules, and
## conflict detection on discriminated unions inside `binary {}` blocks.
## Codegen lands in STEPs B3 / B4.
##
## See: docs/design/BINARY_DSL.md

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — union typecheck") do ->

    it("accepts a union whose discriminator is a prior u8 field") do ->
      assert_compile_succeeds("""
        import * from std/bytes
        type TcpOption = binary {
          kind: u8
          match kind
            0 => { }
            1 => { }
            2 => { mss: u16be }
            8 => { tsval: u32be; tsecr: u32be }
          end
        }
        def main(): Int = 0
        """)
    end

    it("accepts a union whose discriminator is a u16be field") do ->
      assert_compile_succeeds("""
        import * from std/bytes
        type Tlv = binary {
          kind: u16be
          match kind
            1 => { v: u32be }
            2 => { s: pstring(u8) }
          end
        }
        def main(): Int = 0
        """)
    end

    it("rejects a union with no prior discriminator field") do ->
      assert_compile_error("""
        import * from std/bytes
        type Bad = binary {
          match kind
            0 => { }
          end
        }
        def main(): Int = 0
        """, "QZ0954")
    end

    it("rejects a union whose discriminator names a variable-width field") do ->
      assert_compile_error("""
        import * from std/bytes
        type Bad = binary {
          kind: bytes
          match kind
            0 => { }
          end
        }
        def main(): Int = 0
        """, "QZ0955")
    end

    it("rejects a union with duplicate arm tags") do ->
      assert_compile_error("""
        import * from std/bytes
        type Bad = binary {
          kind: u8
          match kind
            1 => { }
            1 => { mss: u16be }
          end
        }
        def main(): Int = 0
        """, "QZ0956")
    end

    it("rejects cross-arm field-name collision with different types") do ->
      assert_compile_error("""
        import * from std/bytes
        type Bad = binary {
          kind: u8
          match kind
            1 => { data: u16be }
            2 => { data: u32be }
          end
        }
        def main(): Int = 0
        """, "QZ0957")
    end

    it("accepts cross-arm field-name collision when types match") do ->
      assert_compile_succeeds("""
        import * from std/bytes
        type Mergeable = binary {
          kind: u8
          match kind
            1 => { shared: u16be }
            2 => { shared: u16be; extra: u32be }
          end
        }
        def main(): Int = 0
        """)
    end

  end
  return qspec_main()
end
