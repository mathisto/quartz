## REPL Internal Algorithm Tests
##
## Tests the REPL's internal algorithms (ANSI stripping, word
## boundaries, history search, elapsed formatting) using standalone
## reimplementations. The repl module can't be imported directly
## because it depends on lexer (not in QSpec include paths).

import * from qspec

# === Standalone reimplementations of REPL algorithms ===

def strip_ansi(s: String): String
  var sb = sb_new()
  var i = 0
  var len = str_byte_len(s)
  while i < len
    var c = str_byte_at(s, i)
    if c == 27 and i + 1 < len and str_byte_at(s, i + 1) == '['
      i = i + 2
      while i < len
        var ch = str_byte_at(s, i)
        i = i + 1
        if (ch >= 'A' and ch <= 'Z') or (ch >= 'a' and ch <= 'z')
          break
        end
      end
    else
      sb_append_char(sb, c)
      i = i + 1
    end
  end
  return sb_to_string(sb)
end

def vlen(s: String): Int = str_byte_len(strip_ansi(s))

# Word boundary: find position after skipping back over word
def word_back_pos(buf: Vec<Int>, cursor: Int): Int
  var c = cursor
  while c > 0 and buf[c - 1] == ' '
    c -= 1
  end
  while c > 0 and buf[c - 1] != ' '
    c -= 1
  end
  return c
end

# Word boundary: find position after skipping forward over word
def word_fwd_pos(buf: Vec<Int>, cursor: Int): Int
  var c = cursor
  while c < buf.size and buf[c] != ' '
    c += 1
  end
  while c < buf.size and buf[c] == ' '
    c += 1
  end
  return c
end

# History search: find last entry containing query at or before start_idx
def search_find(history: Vec<String>, query: String, start_idx: Int): Int
  if str_byte_len(query) == 0
    return -1
  end
  var i = start_idx
  while i >= 0
    if str_contains(history[i], query) == 1
      return i
    end
    i = i - 1
  end
  return -1
end

# Elapsed time formatting
def format_elapsed(ns: Int): String
  if ns < 1000000
    return ""
  end
  var ms = ns / 1000000
  return str_from_int(ms) + "ms"
end

# Helper: make a Vec<Int> from a string
def str_to_buf(s: String): Vec<Int>
  var buf = vec_new<Int>()
  var i = 0
  while i < str_byte_len(s)
    buf.push(str_byte_at(s, i))
    i = i + 1
  end
  return buf
end

def main(): Int
  describe("ANSI stripping") do ->
    it("returns plain text unchanged") do ->
      assert_eq_str(strip_ansi("hello world"), "hello world")
    end

    it("strips single color code") do ->
      var colored = str_from_char(27) + "[32mhello" + str_from_char(27) + "[0m"
      assert_eq_str(strip_ansi(colored), "hello")
    end

    it("strips multiple color codes") do ->
      var s = str_from_char(27) + "[1m" + str_from_char(27) + "[94mdef" + str_from_char(27) + "[0m foo"
      assert_eq_str(strip_ansi(s), "def foo")
    end

    it("handles empty string") do ->
      assert_eq_str(strip_ansi(""), "")
    end

    it("handles string with no escape sequences") do ->
      assert_eq_str(strip_ansi("abc123"), "abc123")
    end

    it("computes visual length correctly") do ->
      var colored = str_from_char(27) + "[36mtest" + str_from_char(27) + "[0m"
      assert_eq(vlen(colored), 4)
    end
  end

  describe("word navigation") do ->
    it("word_back from end of single word") do ->
      var buf = str_to_buf("hello")
      assert_eq(word_back_pos(buf, 5), 0)
    end

    it("word_back skips trailing spaces") do ->
      var buf = str_to_buf("hello world")
      assert_eq(word_back_pos(buf, 11), 6)
    end

    it("word_back from middle of second word") do ->
      var buf = str_to_buf("hello world")
      assert_eq(word_back_pos(buf, 8), 6)
    end

    it("word_back at beginning stays at 0") do ->
      var buf = str_to_buf("hello")
      assert_eq(word_back_pos(buf, 0), 0)
    end

    it("word_fwd from beginning of first word") do ->
      var buf = str_to_buf("hello world")
      assert_eq(word_fwd_pos(buf, 0), 6)
    end

    it("word_fwd from space between words") do ->
      var buf = str_to_buf("hello world")
      assert_eq(word_fwd_pos(buf, 5), 6)
    end

    it("word_fwd at end stays at end") do ->
      var buf = str_to_buf("hello")
      assert_eq(word_fwd_pos(buf, 5), 5)
    end

    it("word_fwd with multiple spaces") do ->
      var buf = str_to_buf("a  b  c")
      assert_eq(word_fwd_pos(buf, 0), 3)
    end
  end

  describe("history search") do ->
    it("finds exact match") do ->
      var h = vec_new<String>()
      h.push("def foo(): Int = 42")
      h.push("puts(hello)")
      h.push("var x = 10")
      assert_eq(search_find(h, "foo", 2), 0)
    end

    it("finds most recent match first") do ->
      var h = vec_new<String>()
      h.push("var x = 1")
      h.push("var y = 2")
      h.push("var z = 3")
      assert_eq(search_find(h, "var", 2), 2)
    end

    it("searches backward from start_idx") do ->
      var h = vec_new<String>()
      h.push("var x = 1")
      h.push("var y = 2")
      h.push("var z = 3")
      assert_eq(search_find(h, "var", 1), 1)
    end

    it("returns -1 for no match") do ->
      var h = vec_new<String>()
      h.push("hello")
      h.push("world")
      assert_eq(search_find(h, "xyz", 1), -1)
    end

    it("returns -1 for empty query") do ->
      var h = vec_new<String>()
      h.push("hello")
      assert_eq(search_find(h, "", 0), -1)
    end
  end

  describe("elapsed formatting") do ->
    it("returns empty for sub-millisecond") do ->
      assert_eq_str(format_elapsed(500000), "")
    end

    it("formats milliseconds") do ->
      assert_eq_str(format_elapsed(5000000), "5ms")
    end

    it("formats large times") do ->
      assert_eq_str(format_elapsed(1234000000), "1234ms")
    end

    it("returns empty for zero") do ->
      assert_eq_str(format_elapsed(0), "")
    end
  end

  return qspec_main()
end
