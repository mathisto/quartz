## Thread Pool Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("nested task_groups") do ->
    it("nested groups complete without deadlock") do ->
      assert_run_exits(tp_nested_src(), 10)
    end
  end

  describe("parallel_map") do ->
    it("maps function over array in parallel") do ->
      assert_run_exits(tp_parallel_map_src(), 0)
    end
  end

  describe("large batch") do ->
    it("handles 64 tasks via pool") do ->
      assert_run_exits(tp_64_tasks_src(), 0)
    end
  end

  describe("parallel_for") do ->
    it("executes side effects in parallel") do ->
      assert_run_exits(tp_side_effects_src(), 0)
    end
  end

  return qspec_main()
end

def tp_nested_src(): String = """
  def inner_work(): Int = 10
  def outer_work(): Int
    inner = task_group |g2|
      taskgroup_spawn(g2, -> inner_work())
      taskgroup_collect(g2)
    end
    return vec_get(inner, 0)
  end
  def main(): Int
    outer = task_group |g1|
      taskgroup_spawn(g1, -> outer_work())
      taskgroup_collect(g1)
    end
    return vec_get(outer, 0)
  end
  """

def tp_parallel_map_src(): String = """
  def double(n: Int): Int = n * 2
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> double(1))
      taskgroup_spawn(g, -> double(2))
      taskgroup_spawn(g, -> double(3))
      taskgroup_spawn(g, -> double(4))
      taskgroup_collect(g)
    end
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    c = vec_get(results, 2)
    d = vec_get(results, 3)
    if a == 2 and b == 4 and c == 6 and d == 8
      return 0
    end
    return 1
  end
  """

def tp_64_tasks_src(): String = """
