      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 64
      return 0
    end
    return 1
  end
  """

def tp_side_effects_src(): String = """
  def add_one(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    task_group |g|
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 10
      return 0
    end
    return 1
  end
  """
