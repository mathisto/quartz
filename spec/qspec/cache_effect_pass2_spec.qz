## QSpec coverage for the migrated cache_op_lookup callsite (Phase A.3 Pass 2).
##
## Pass 2 of the two-pass fixpoint dance migrated `quartz.qz:504` from
## `build_cache::cache_lookup(filename, cache_key)` to the effect-routed
## form `cache_op_lookup(filename, cache_key)`. This spec validates the
## end-to-end test-handler value prop unlocked by that migration: a user
## can install a mock handler around any caller of cache_op_lookup and
## intercept its (module_path, content_hash) args.
##
## Conceptually mirrors what a future spec around `compile()` would do:
##
##   with Cache { cache_op_lookup: my_mock } do ->
##     var ir = compile("foo.qz", ...)  # internally calls cache_op_lookup
##     ...
##   end
##
## Out of scope (deferred to Phase 3):
##   - Migration of the remaining 5 ops (cache_op_store / save_pool /
##     load_pool / save_ast / load_ast).
##   - Migration of the ~30 callsites in quartz.qz / resolver.qz /
##     codegen_separate.qz that still call `build_cache::*` directly.
##   - Test-handler factories (`Cache.in_memory`, `Cache.disabled`,
##     `Cache.tracing`) shipped alongside the full migration.

import * from qspec
import std/cache

# --- Test 1: mock handler captures realistic-looking (module_path,
#     content_hash) arg pairs and can return a synthetic cache hit.

var _t1_captured_modules = vec_new<String>()
var _t1_captured_hashes = vec_new<String>()
var _t1_returned_ir = "; mock cached IR for #{0}"

def t1_recording_lookup(op_name: Int, argc: Int, argv: Int): Int
  var module = as_string(load(argv, 0))
  var hash = as_string(load(argv, 1))
  _t1_captured_modules.push(module)
  _t1_captured_hashes.push(hash)
  return as_int("CACHED_IR")
end

def t1_run(): Void
  _t1_captured_modules = vec_new<String>()
  _t1_captured_hashes = vec_new<String>()
  with Cache { cache_op_lookup: t1_recording_lookup } do ->
    var r1 = cache_op_lookup("self-hosted/lexer.qz", "abc123def456")
    var r2 = cache_op_lookup("std/file_io.qz", "feedfacedeadbeef")
    puts("r1=#{r1}")
    puts("r2=#{r2}")
  end
  puts("modules=#{_t1_captured_modules.size}")
  puts("first_module=#{_t1_captured_modules[0]}")
  puts("first_hash=#{_t1_captured_hashes[0]}")
  puts("second_module=#{_t1_captured_modules[1]}")
  puts("second_hash=#{_t1_captured_hashes[1]}")
end

# --- Test 2: handler stack pops cleanly. Calls outside the wrap don't
#     bump the recorder; they fall back to the prelude default.

def t2_run(): Void
  _t1_captured_modules = vec_new<String>()
  with Cache { cache_op_lookup: t1_recording_lookup } do ->
    var inside = cache_op_lookup("inside.qz", "innerhash")
    puts("inside=#{inside} captured=#{_t1_captured_modules.size}")
  end
  var outside_count_before = _t1_captured_modules.size
  var outside = cache_op_lookup("outside.qz", "outerhash")
  if outside.eq("")
    puts("outside=miss captured_delta=#{_t1_captured_modules.size - outside_count_before}")
  else
    puts("outside=hit captured_delta=#{_t1_captured_modules.size - outside_count_before}")
  end
end

# --- Test 3: nested wraps follow top-down handler scan. The inner mock
#     wins inside its scope; after it pops, the outer mock takes over.

var _t3_outer_calls = 0
var _t3_inner_calls = 0

def t3_outer_lookup(op_name: Int, argc: Int, argv: Int): Int
  _t3_outer_calls = _t3_outer_calls + 1
  return as_int("OUTER")
end

def t3_inner_lookup(op_name: Int, argc: Int, argv: Int): Int
  _t3_inner_calls = _t3_inner_calls + 1
  return as_int("INNER")
end

def t3_run(): Void
  _t3_outer_calls = 0
  _t3_inner_calls = 0
  with Cache { cache_op_lookup: t3_outer_lookup } do ->
    var r1 = cache_op_lookup("a.qz", "h1")
    with Cache { cache_op_lookup: t3_inner_lookup } do ->
      var r2 = cache_op_lookup("b.qz", "h2")
      puts("r1=#{r1} r2=#{r2}")
    end
    var r3 = cache_op_lookup("c.qz", "h3")
    puts("r3=#{r3} outer=#{_t3_outer_calls} inner=#{_t3_inner_calls}")
  end
end

def main(): Int
  describe("Cache effect: end-to-end mock interception (A.3 Pass 2)") do ->
    it("mock handler captures (module, hash) arg pairs across calls") do ->
      assert_output("r1=CACHED_IR\nr2=CACHED_IR\nmodules=2\nfirst_module=self-hosted/lexer.qz\nfirst_hash=abc123def456\nsecond_module=std/file_io.qz\nsecond_hash=feedfacedeadbeef\n", t1_run)
    end

    it("handler stack pops cleanly after the wrap exits") do ->
      assert_output("inside=CACHED_IR captured=1\noutside=miss captured_delta=0\n", t2_run)
    end

    it("nested wraps follow top-down handler scan") do ->
      assert_output("r1=OUTER r2=INNER\nr3=OUTER outer=2 inner=1\n", t3_run)
    end
  end
  return qspec_main()
end
