## Arity-aware dispatch between builtin intrinsic and user extern (Path A).
##
## When a builtin intrinsic (e.g., channel `send(ch, val)`) and a user
## `extern "C" def` (e.g., ws2_32 `send(s, buf, len, flags)` on Windows)
## share a name, dispatch is arity-based. The builtin wins when arg_count
## matches its declared arity; the extern wins when arg_count matches
## the extern's parameter count.
##
## HISTORY: Surfaced 2026-05-23 during the TUI Windows backend wave
## (TUI.W). Symptom on Windows builds:
##
##   error[QZ0200]: Function send requires at least 4 arguments, got 2
##     --> std/sync/composition/scope.qz:808:5
##         send(ch, val)
##
## `scope_send(ch, val)` calls the channel-send intrinsic with 2 args.
## The `@cfg(os: "windows")` ws2_32 `extern "C" def send(s, buf, len,
## flags)` from std/ffi/socket got brought into the same typecheck unit
## and shadowed the intrinsic's arity. Before the fix, the typechecker's
## type lookup picked the builtin (TYPE_VOID) at the call site but the
## arity check picked the registry's 4-arg extern — inconsistent. After
## the fix, both lookups agree by arity.
##
## See feedback_channel_send_vs_ws2_send_name_clash.md.
##
## Contract:
##   1. 2-arg `send(ch, val)` co-existing with a 4-arg `extern "C" def
##      send` typechecks AND emits channel-intrinsic IR (no `call @send`
##      against the extern signature).
##   2. 4-arg `send(s, buf, len, flags)` co-existing with the same extern
##      emits `call ... @send(...)` against the extern symbol.
##   3. Same shape for `recv` (1-arg channel-recv vs 4-arg ws2_32 recv).
##   4. The arity-error diagnostic for `channel_new()` (missing required
##      arg) is preserved — the gate must not surface "Undefined
##      function" when the registry has no competing entry.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("intrinsic-vs-extern arity-aware dispatch") do ->

    it("2-arg channel send co-existing with 4-arg extern compiles") do ->
      assert_compile_succeeds("""
@cfg(os: "windows")
extern "C" def send(s: Int, buf: CPtr, len: Int, flags: Int): Int

def main(): Int
  var ch = channel_new(8)
  send(ch, 42)
  return 0
end
""")
    end

    it("4-arg send dispatches to extern (Windows target IR)") do ->
      assert_ir_contains_with_flags("""
@cfg(os: "windows")
extern "C" def send(s: Int, buf: CPtr, len: Int, flags: Int): Int

def main(): Int
  var dummy: Int = 0
  return send(dummy, int_to_cptr(0), 0, 0)
end
""", "call i64 (i64, ptr, i64, i64) @send", "--target x86_64-pc-windows-gnu")
    end

    it("2-arg send does not dispatch to extern (Windows target IR)") do ->
      assert_ir_not_contains_with_flags("""
@cfg(os: "windows")
extern "C" def send(s: Int, buf: CPtr, len: Int, flags: Int): Int

def main(): Int
  var ch = channel_new(8)
  send(ch, 42)
  return 0
end
""", "call i64 (i64, ptr, i64, i64) @send(", "--target x86_64-pc-windows-gnu")
    end

    it("1-arg channel recv co-existing with 4-arg extern compiles") do ->
      assert_compile_succeeds("""
@cfg(os: "windows")
extern "C" def recv(s: Int, buf: CPtr, len: Int, flags: Int): Int

def main(): Int
  var ch = channel_new(8)
  send(ch, 7)
  var v = recv(ch)
  return v
end
""")
    end

    it("missing-arg diagnostic preserved when no competing extern") do ->
      assert_compile_error("""
def main(): Int
  var ch = channel_new()
  return 0
end
""", "requires 1")
    end

    it("channel send/recv round-trip works on native target") do ->
      assert_run_exits("""
def main(): Int
  var ch = channel_new(8)
  send(ch, 99)
  var v = recv(ch)
  if v == 99
    return 0
  end
  return 1
end
""", 0)
    end

  end
  return qspec_main()
end
