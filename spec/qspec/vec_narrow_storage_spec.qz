## Vec Narrow Storage Tests — Memory Model V2
## Validates that Vec<U8>, Vec<I16>, Vec<U32> use width-aware
## load/store (1, 2, 4 bytes per element) instead of i64 everywhere.
##
## Contract:
##   1. Vec<U8> narrow storage.
##   2. Vec<I16> narrow storage.
##   3. Vec<U32> narrow storage.
##   4. Vec<Int> backward compatibility.

import * from qspec

# === Vec<U8> tests ===

def narrow_u8_push_get(): Int
  var v: Vec<U8> = vec_new<U8>()
  v.push(42)
  v.push(255)
  v.push(0)
  return v[1]
end

def narrow_u8_roundtrip(): Int
  var v: Vec<U8> = vec_new<U8>()
  var i = 0
  while i < 10
    v.push(i)
    i = i + 1
  end
  # Check all values round-trip correctly
  var sum = 0
  i = 0
  while i < 10
    sum = sum + v[i]
    i = i + 1
  end
  return sum  # 0+1+2+...+9 = 45
end

def narrow_u8_index_assign(): Int
  var v: Vec<U8> = vec_new<U8>()
  v.push(10)
  v.push(20)
  v.push(30)
  v[1] = 99
  return v[0] + v[1] + v[2]  # 10 + 99 + 30 = 139
end

def narrow_u8_boundary(): Int
  var v: Vec<U8> = vec_new<U8>()
  v.push(0)
  v.push(127)
  v.push(255)
  return v[0] + v[1] + v[2]  # 0 + 127 + 255 = 382
end

# === Vec<I16> tests ===

def narrow_i16_push_get(): Int
  var v: Vec<I16> = vec_new<I16>()
  v.push(1000)
  v.push(-500)
  v.push(32767)
  return v[0] + v[1]  # 1000 + (-500) = 500
end

def narrow_i16_negative(): Int
  var v: Vec<I16> = vec_new<I16>()
  v.push(-1)
  return v[0]  # Should be -1 (sign-extended from i16)
end

# === Vec<U32> tests ===

def narrow_u32_push_get(): Int
  var v: Vec<U32> = vec_new<U32>()
  v.push(100000)
  v.push(200000)
  return v[0] + v[1]  # 300000
end

# === Vec<Int> fallback (i64, original behavior) ===

def wide_int_still_works(): Int
  var v = vec_new()
  v.push(1000000000)
  v.push(2000000000)
  return v[0] + v[1]  # 3000000000
end

def wide_vec_int_typed(): Int
  var v: Vec<Int> = vec_new()
  v.push(42)
  v.push(99)
  return v[0] + v[1]  # 141
end

# === Many elements (triggers realloc) ===

def narrow_u8_many(): Int
  var v: Vec<U8> = vec_new<U8>()
  var i = 0
  while i < 100
    v.push(i % 256)
    i = i + 1
  end
  # Check first and last
  return v[0] + v[99]  # 0 + 99 = 99
end

def main(): Int
  describe("Vec<U8> narrow storage") do ->
    it("push and get single byte values") do ->
      assert_eq(narrow_u8_push_get(), 255)
    end

    it("round-trips 10 byte values correctly") do ->
      assert_eq(narrow_u8_roundtrip(), 45)
    end

    it("supports index assignment") do ->
      assert_eq(narrow_u8_index_assign(), 139)
    end

    it("handles boundary values 0, 127, 255") do ->
      assert_eq(narrow_u8_boundary(), 382)
    end

    it("handles 100 elements (triggers realloc)") do ->
      assert_eq(narrow_u8_many(), 99)
    end
  end

  describe("Vec<I16> narrow storage") do ->
    it("stores and retrieves i16 values") do ->
      assert_eq(narrow_i16_push_get(), 500)
    end

    it("sign-extends negative i16 values") do ->
      assert_eq(narrow_i16_negative(), -1)
    end
  end

  describe("Vec<U32> narrow storage") do ->
    it("stores and retrieves u32 values") do ->
      assert_eq(narrow_u32_push_get(), 300000)
    end
  end

  describe("Vec<Int> backward compatibility") do ->
    it("unparameterized vec still works") do ->
      assert_eq(wide_int_still_works(), 3000000000)
    end

    it("Vec<Int> uses i64 path") do ->
      assert_eq(wide_vec_int_typed(), 141)
    end
  end

  return qspec_main()
end
