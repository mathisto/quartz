## Option/Result method spec (item 2d).
##
## Positive coverage for the Option/Result-exclusive methods that the item-2d
## typecheck gate (QZ0406) protects: `unwrap`, `unwrap_or`, `is_some`,
## `is_none`, `is_ok`, `is_err`, `unwrap_err`. These MUST keep working on real
## Option<T> / Result<T, E> receivers — the gate only rejects them on other
## receiver types. The negative side (QZ0406 on a non-Option/Result receiver)
## is validated by standalone compile in the item-2d acceptance harness, not
## here (the qspec negative-runner is intentionally avoided).
import * from qspec

def opt_of(n: Int): Option<Int>
  if n > 0
    return Option::Some(n)
  end
  return Option::None
end

def res_of(n: Int): Result<Int, String>
  if n > 0
    return Result::Ok(n)
  end
  return Result::Err("neg")
end

def main(): Int
  describe("Option methods") do ->
    it("is_some / is_none on Some") do ->
      o = opt_of(5)
      assert_eq(bool_to_int(o.is_some()), 1)
      assert_eq(bool_to_int(o.is_none()), 0)
    end

    it("is_some / is_none on None") do ->
      o = opt_of(0)
      assert_eq(bool_to_int(o.is_some()), 0)
      assert_eq(bool_to_int(o.is_none()), 1)
    end

    it("unwrap on Some") do ->
      o = opt_of(7)
      assert_eq(o.unwrap(), 7)
    end

    it("unwrap_or falls back on None") do ->
      o = opt_of(0)
      assert_eq(o.unwrap_or(42), 42)
    end
  end

  describe("Result methods") do ->
    it("is_ok / is_err on Ok") do ->
      r = res_of(9)
      assert_eq(bool_to_int(r.is_ok()), 1)
      assert_eq(bool_to_int(r.is_err()), 0)
    end

    it("is_ok / is_err on Err") do ->
      r = res_of(0)
      assert_eq(bool_to_int(r.is_ok()), 0)
      assert_eq(bool_to_int(r.is_err()), 1)
    end

    it("unwrap on Ok") do ->
      r = res_of(11)
      assert_eq(r.unwrap(), 11)
    end
  end

  return qspec_main()
end

def bool_to_int(b: Bool): Int
  if b
    return 1
  end
  return 0
end
