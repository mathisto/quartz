## Request JSON Spec — Tests for request_json helper
##
## Tests Content-Type validation and JSON body parsing.

import * from qspec
import std/net/http_server
import std/json

# =============================================================================
# Helpers
# =============================================================================

def make_json_request(body: String, content_type: String): Request
  var hkeys = vec_new<String>()
  var hvals = vec_new<String>()
  if str_byte_len(content_type) > 0
    hkeys.push("Content-Type")
    hvals.push(content_type)
  end
  return Request {
    method: "POST", path: "/api", query_string: "", body: body,
    raw_path: "/api",
    header_keys: hkeys, header_vals: hvals,
    params: map_new(), query: map_new(), context: map_new()
  }
end

# =============================================================================
# Test helpers
# =============================================================================

def print_json_valid(): Void
  var req = make_json_request("{\"name\":\"alice\"}", "application/json")
  match request_json(req)
    Ok(v) => puts(json_get_string(v, "name"))
    Err(e) => puts("error: " + e.message())
  end
end

def print_json_wrong_ct(): Void
  var req = make_json_request("{\"name\":\"alice\"}", "text/plain")
  match request_json(req)
    Ok(v) => puts("ok")
    Err(e) => puts(e.message())
  end
end

def print_json_no_ct(): Void
  var req = make_json_request("{\"name\":\"alice\"}", "")
  match request_json(req)
    Ok(v) => puts("ok")
    Err(e) => puts(e.message())
  end
end

def print_json_empty_body(): Void
  var req = make_json_request("", "application/json")
  match request_json(req)
    Ok(v) => puts("ok")
    Err(e) => puts(e.message())
  end
end

def print_json_ct_with_charset(): Void
  var req = make_json_request("{\"x\":1}", "application/json; charset=utf-8")
  match request_json(req)
    Ok(v) => puts(str_from_int(json_get_number(v, "x")))
    Err(e) => puts("error: " + e.message())
  end
end

def print_json_invalid(): Void
  var req = make_json_request("{invalid json", "application/json")
  match request_json(req)
    Ok(v) => puts("ok")
    Err(e) => puts("parse error")
  end
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("request_json") do ->
    it("parses valid JSON with correct Content-Type") do ->
      assert_output("alice\n", print_json_valid)
    end

    it("rejects wrong Content-Type") do ->
      assert_output("Content-Type is not application/json\n", print_json_wrong_ct)
    end

    it("rejects missing Content-Type") do ->
      assert_output("Missing Content-Type header\n", print_json_no_ct)
    end

    it("rejects empty body") do ->
      assert_output("Empty request body\n", print_json_empty_body)
    end

    it("accepts Content-Type with charset parameter") do ->
      assert_output("1\n", print_json_ct_with_charset)
    end

    it("returns parse error for invalid JSON") do ->
      assert_output("parse error\n", print_json_invalid)
    end
  end

  return qspec_main()
end
