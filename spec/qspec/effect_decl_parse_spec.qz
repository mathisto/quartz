## Effect Declaration Parsing (Operation Piezoelectric Effects, Milestone A)
##
## Verifies `effect Name<T> ... end` blocks are accepted by the parser.
## Milestone A discards the parsed decl (emits a top-level no-op); this
## spec therefore validates "parse succeeded" by confirming that code
## adjacent to the effect block compiles and runs as expected.

import * from qspec

effect PiezoEffectA
  def op_a(x: Int): Int
  def op_b(s: String): Int
end

effect PiezoEffectB<E>
  def throw_op(e: E): Int
end

effect PiezoEffectEmpty
end

def piezo_decl_seven(): Int = 7

def piezo_decl_double(x: Int): Int = x * 2

def main(): Int
  describe("effect declaration parses") do ->
    it("multi-method effect accepted") do ->
      assert_eq(piezo_decl_seven(), 7)
    end

    it("parameterized effect accepted") do ->
      assert_eq(piezo_decl_double(5), 10)
    end

    it("empty effect body accepted") do ->
      assert_eq(piezo_decl_seven() + 1, 8)
    end
  end
  return qspec_main()
end
