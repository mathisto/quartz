## Wildcard & Selective Imports Tests
##
## Contract:
##   1. From module import *.
##   2. Import * from module.
##   3. From module import a, b (selective).
##   4. Regular import (prefixed).

import * from qspec
import * from qspec/subprocess
import * from math_helper
import * from struct_module

def main(): Int
  describe("from module import *") do ->
    it("makes functions available without module prefix") do ->
      assert_eq(math_add(20, 22), 42)
    end

    it("makes structs available without module prefix") do ->
      r = ModRect { width: 6, height: 7 }
      assert_eq(mod_rect_area(r), 42)
    end

    it("makes multiple functions available") do ->
      assert_eq(math_multiply(6, 7), 42)
      assert_eq(math_square(5), 25)
      assert_eq(math_abs(-42), 42)
    end
  end

  describe("import * from module") do ->
    it("makes functions available without module prefix") do ->
      assert_eq(math_add(1, 2), 3)
    end

    it("supports hierarchical module paths (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("sub/nested.qz"))
      files.push(as_int("def wc_nested_val(): Int = 42"))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from sub/nested
        def main(): Int
          return wc_nested_val()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("from module import a, b (selective)") do ->
    it("makes only listed functions available (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("sel_mod.qz"))
      vec_push(files, as_int("""
        def wc_sel_a(): Int = 10
        def wc_sel_b(): Int = 32
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        from sel_mod import wc_sel_a, wc_sel_b
        def main(): Int
          return wc_sel_a() + wc_sel_b()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
    it("rejects non-imported functions (compile-error test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("sel_rej.qz"))
      vec_push(files, as_int("""
        def wc_rej_ok(): Int = 42
        def wc_rej_no(): Int = 99
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        from sel_rej import wc_rej_ok
        def main(): Int
          return wc_rej_no()
        end
        """))
      assert_multi_compile_error(files, 1, "Undefined function")
    end
    it("supports importing multiple symbols (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("sel_multi.qz"))
      vec_push(files, as_int("""
        def wc_multi_x(): Int = 6
        def wc_multi_y(): Int = 7
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        from sel_multi import wc_multi_x, wc_multi_y
        def main(): Int
          return wc_multi_x() * wc_multi_y()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("regular import (prefixed)") do ->
    it("still works with UFCS dot-notation") do ->
      var files: Vec = vec_new()
      files.push(as_int("ufcs_wc_mod.qz"))
      vec_push(files, as_int("""
        def ufcs_wc_double(x: Int): Int = x * 2
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from ufcs_wc_mod
        def main(): Int = 21.ufcs_wc_double()
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  return qspec_main()
end
