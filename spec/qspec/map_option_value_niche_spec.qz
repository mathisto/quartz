## Map<K, Option<V>> value-position niche round-trip tests (N3.2 follow-up #1).
##
## Repro for the map_set value-position None niche hole (MEMORY_MODEL_V3.md §14.7).
## Before the fix, `m.set(k, None)` on a `Map<String, Option<Point>>` SPILLED the
## inner None to a tagged (non-null) box because the map_set seam carried only the
## KEY type, not V. The niche-aware read side then range-tested that non-null box
## as Some — so a stored None read back as **Some** (a CORRECTNESS bug, §14.4
## construct-spill / read-niche mismatch — not merely a missed alloc-elision as
## originally filed). The fix threads the Map's V type to the value-arg
## None-construct site so it builds the niche null word, agreeing with the read.
##
## map_get returns Option<V>, so a get on Map<String, Option<Point>> yields
## Option<Option<Point>>. The intermediate Options are explicitly annotated to
## isolate the VALUE-construction path under test from the separate un-annotated
## chained-read inference gap (follow-up #2). Representation-agnostic: passes under
## tagged and niche layouts alike.
import * from qspec

struct Point
  x: Int
  y: Int
end

## Opaque boundary: forces a genuine map load + Option slot load on the value
## read path. An in-line `m.get(k).unwrap() is None` can be flow-narrowed to a
## compile-time constant that never loads the slot, hiding a construct-side spill
## (lesson from item 5b). Routing the read through a non-inlined function defeats
## that narrowing so the niche null word actually round-trips.
def read_inner_point(m: Map<String, Option<Point>>, k: String): Option<Point>
  var outer: Option<Option<Point>> = m.get(k)
  return outer.unwrap()
end

def read_inner_str(m: Map<String, Option<String>>, k: String): Option<String>
  var outer: Option<Option<String>> = m.get(k)
  return outer.unwrap()
end

def read_inner_int(m: Map<String, Option<Int>>, k: String): Option<Int>
  var outer: Option<Option<Int>> = m.get(k)
  return outer.unwrap()
end

def main(): Int
  describe("Map<String, Option<Point>> — set None then read back") do ->
    it("a key set to None reads back as None (was Some — the bug)") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("a", Option::Some(Point { x: 10, y: 20 }))
      m.set("b", Option::None)
      var outer_b: Option<Option<Point>> = m.get("b")
      var inner_b: Option<Point> = outer_b.unwrap()
      assert_eq(inner_b is None, 1)
    end
    it("a key set to None is not Some") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("b", Option::None)
      var outer_b: Option<Option<Point>> = m.get("b")
      var inner_b: Option<Point> = outer_b.unwrap()
      assert_eq(inner_b is Some, 0)
    end
    it("a key set to Some reads back as Some") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("a", Option::Some(Point { x: 10, y: 20 }))
      var outer_a: Option<Option<Point>> = m.get("a")
      var inner_a: Option<Point> = outer_a.unwrap()
      assert_eq(inner_a is Some, 1)
    end
    it("match on the Some inner value reads its payload fields") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("a", Option::Some(Point { x: 10, y: 20 }))
      var outer_a: Option<Option<Point>> = m.get("a")
      var inner_a: Option<Point> = outer_a.unwrap()
      r = match inner_a
        Some(p) => p.x + p.y
        None => -1
      end
      assert_eq(r, 30)
    end
    it("match on the None inner value fires the None arm") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("b", Option::None)
      var outer_b: Option<Option<Point>> = m.get("b")
      var inner_b: Option<Point> = outer_b.unwrap()
      r = match inner_b
        Some(p) => p.x + p.y
        None => -99
      end
      assert_eq(r, -99)
    end
  end

  describe("Map<String, Option<Point>> — overwrite semantics") do ->
    it("overwriting a None key with Some reads back as Some") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("k", Option::None)
      m.set("k", Option::Some(Point { x: 1, y: 2 }))
      var outer: Option<Option<Point>> = m.get("k")
      var inner: Option<Point> = outer.unwrap()
      assert_eq(inner is Some, 1)
    end
    it("overwriting a Some key with None reads back as None") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("k", Option::Some(Point { x: 1, y: 2 }))
      m.set("k", Option::None)
      var outer: Option<Option<Point>> = m.get("k")
      var inner: Option<Point> = outer.unwrap()
      assert_eq(inner is None, 1)
    end
  end

  describe("Map<String, Option<Point>> — value-construct niche across an opaque boundary") do ->
    it("None stored, read through a function, is None (not the spilled-box Some)") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("none", Option::None)
      m.set("some", Option::Some(Point { x: 4, y: 5 }))
      assert_eq(read_inner_point(m, "none") is None, 1)
    end
    it("Some stored, read through a function, is Some with intact payload") do ->
      var m: Map<String, Option<Point>> = map_new()
      m.set("some", Option::Some(Point { x: 4, y: 5 }))
      var inner: Option<Point> = read_inner_point(m, "some")
      r = match inner
        Some(p) => p.x + p.y
        None => -1
      end
      assert_eq(r, 9)
    end
  end

  describe("Map<String, Option<String>> — niche-eligible String value across an opaque boundary") do ->
    it("None reads back as None") do ->
      var m: Map<String, Option<String>> = map_new()
      m.set("n", Option::None)
      m.set("s", Option::Some("hi"))
      assert_eq(read_inner_str(m, "n") is None, 1)
    end
    it("Some reads back as Some with intact payload") do ->
      var m: Map<String, Option<String>> = map_new()
      m.set("s", Option::Some("hi"))
      var inner: Option<String> = read_inner_str(m, "s")
      r = match inner
        Some(v) => str_byte_len(v)
        None => -1
      end
      assert_eq(r, 2)
    end
  end

  describe("Map<String, Option<Int>> — non-niche double-Option control (stays spill, still correct)") do ->
    # Option<Int> is not boxed, so the value never niches; the value-construct seam
    # is inert here (the gating leaves niche-expected unset). The round-trip must
    # still be correct under the tagged representation.
    it("None reads back as None") do ->
      var m: Map<String, Option<Int>> = map_new()
      m.set("n", Option::None)
      m.set("s", Option::Some(99))
      assert_eq(read_inner_int(m, "n") is None, 1)
    end
    it("Some reads back as Some with intact payload") do ->
      var m: Map<String, Option<Int>> = map_new()
      m.set("s", Option::Some(99))
      var inner: Option<Int> = read_inner_int(m, "s")
      r = match inner
        Some(v) => v
        None => -1
      end
      assert_eq(r, 99)
    end
  end

  describe("Map<String, Int> — non-Option value control (no niche path engaged)") do ->
    # Pure non-Option value type: the value-construct niche seam must not engage
    # at all. Correctness sanity only — the byte-identical-IR claim is structural
    # (the seam sets _ci_value_idx = -1 for non-Option/Result element types).
    it("plain Int values round-trip") do ->
      var m: Map<String, Int> = map_new()
      m.set("a", 1)
      m.set("b", 2)
      assert_eq(m.get("a").unwrap() + m.get("b").unwrap(), 3)
    end
  end

  return qspec_main()
end
