# QSpec coverage for std/tui/runtime::program_run_raw — non-TEA helper
# that owns the raw-mode + scope + input-pump + tick-pump scaffolding
# so apps using a custom render loop (cell-engine / diff-renderer
# pattern, e.g. brogue-tribute) don't re-implement it.
#
# Live-loop coverage (real goroutines + wall-clock cadence + scope
# cancel teardown) lives in spec/qz/program_run_raw_smoke.qz —
# qspec inline `go` doesn't spawn real worker-thread tasks, so the
# tick-pump-fires-N-times timing test must be standalone (see
# `feedback` memory entry "go fn() inside qspec lambdas").
#
# This file covers what qspec CAN test: type-level shape, signature
# accessibility as a Fn-typed value, FrameMsg<Void> construction +
# match for the channel-traffic shape the body is expected to handle,
# and the tick-msg payload shape.

import * from qspec
import std/tui/runtime as tui
import std/terminal

# Body callback signature: takes (msg_ch, scope), returns Int. This
# binding verifies the helper exists and that program_run_raw is
# callable as a value with the documented signature.
def _noop_body(msg_ch: Int, scope: Int): Int
  return 42
end

def _zero_body(msg_ch: Int, scope: Int): Int
  return 0
end

def main(): Int
  describe("program_run_raw signature") do ->
    it("program_run_raw is a Fn(Int, Fn(Int, Int): Int): Int — accessible as a value") do ->
      # Bind the function as a value to verify the type signature
      # parses + type-checks. We don't invoke it (would enter raw
      # mode + spawn goroutines, neither safe in qspec).
      var f: Fn(Int, Fn(Int, Int): Int): Int = tui::program_run_raw
      # If we got here, the function exists at the documented type.
      # Touching `f` keeps the binding from being DCE'd.
      var nonzero = 1
      if f == 0
        nonzero = 0
      end
      assert_eq(nonzero, 1)
    end

    it("body callback is Fn(Int, Int): Int — channel handle + scope handle") do ->
      var body_fn: Fn(Int, Int): Int = _noop_body
      var rc = body_fn(0, 0)
      assert_eq(rc, 42)
    end

    it("body return value flows through (mock)") do ->
      var body_fn: Fn(Int, Int): Int = _zero_body
      var rc = body_fn(0, 0)
      assert_eq(rc, 0)
    end
  end

  describe("FrameMsg<Void> channel-traffic shape") do ->
    # The raw runtime delivers FrameMsg<Void> on the channel: Key,
    # Tick, Quit, Resize. The body's recv loop materialises via
    # as_type<FrameMsg<Void>> and matches on variants.

    it("FrameMsg::Key carries a KeyEvent at the documented shape") do ->
      var k = tui::key_event(106, 0)  # 'j'
      var m: tui::FrameMsg<Void> = tui::FrameMsg::Key(k)
      var code = -1
      match m
        tui::FrameMsg::Key(ev) => code = ev.code
        _ => code = -2
      end
      assert_eq(code, 106)
    end

    it("FrameMsg::Tick carries an epoch_ms Int") do ->
      var m: tui::FrameMsg<Void> = tui::FrameMsg::Tick(123456789)
      var got = -1
      match m
        tui::FrameMsg::Tick(ms) => got = ms
        _ => got = -2
      end
      assert_eq(got, 123456789)
    end

    it("FrameMsg::Quit constructs and matches at <Void>") do ->
      var m: tui::FrameMsg<Void> = tui::FrameMsg::Quit
      var hit = 0
      if m is Quit
        hit = 1
      end
      assert_eq(hit, 1)
    end

    it("FrameMsg::Resize carries cols + rows") do ->
      var m: tui::FrameMsg<Void> = tui::FrameMsg::Resize(80, 24)
      var cols = -1
      var rows = -1
      match m
        tui::FrameMsg::Resize(c, r) =>
          cols = c
          rows = r
        _ => cols = -2
      end
      assert_eq(cols, 80)
      assert_eq(rows, 24)
    end
  end

  describe("tick_ms == 0 contract — no tick pump spawned") do ->
    # We can't directly observe the (non-)spawn from qspec, but the
    # documented contract is that tick_ms == 0 means the helper
    # skips the tick goroutine entirely (zero overhead, no
    # FrameMsg::Tick traffic). This is enforced by the
    # `if tick_ms > 0` gate in program_run_raw. The spec file
    # `spec/qz/program_run_raw_smoke.qz` covers the active path
    # (tick_ms > 0 → ticks fire at cadence).
    it("0 is a valid tick_ms (compile-time check)") do ->
      var tick: Int = 0
      assert_eq(tick, 0)
    end
  end

  return qspec_main()
end
