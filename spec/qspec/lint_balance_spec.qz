## Lint Balance Checker Tests
##
## Tests the block balance checking logic from tools/lint.qz.
## Functions are inlined here because tools/ is not on the
## standard import path for QSpec test files.
##
## Exercises: balanced programs, missing end, extra end,
## else-if nesting, strings, comments, and elsif.
##
## Contract:
##   1. Accepts comment-only input.
##   2. Accepts empty input.
##   3. Deeply nested.
##   4. Detects extra end keywords.
##   5. Detects missing end for.
##   6. Else if with proper.

import * from qspec

# ========================================================================
# Inlined helpers from tools/lint.qz
# ========================================================================

def KIND_DEF(): Int = 1
def KIND_IF(): Int = 2
def KIND_WHILE(): Int = 3
def KIND_FOR(): Int = 4
def KIND_STRUCT(): Int = 5
def KIND_ENUM(): Int = 6
def KIND_MATCH(): Int = 7

def kind_to_str(kind: Int): String
  if kind == KIND_DEF()
    return "def"
  elsif kind == KIND_IF()
    return "if"
  elsif kind == KIND_WHILE()
    return "while"
  elsif kind == KIND_FOR()
    return "for"
  elsif kind == KIND_STRUCT()
    return "struct"
  elsif kind == KIND_ENUM()
    return "enum"
  elsif kind == KIND_MATCH()
    return "match"
  end
  return "unknown"
end

def keyword_to_kind(word: String): Int
  if word == "def"
    return KIND_DEF()
  elsif word == "if"
    return KIND_IF()
  elsif word == "while"
    return KIND_WHILE()
  elsif word == "for"
    return KIND_FOR()
  elsif word == "struct"
    return KIND_STRUCT()
  elsif word == "enum"
    return KIND_ENUM()
  elsif word == "match"
    return KIND_MATCH()
  end
  return 0
end

def lint_char_at(s: String, i: Int): String = str_from_char(s.str_byte_at(i))

def is_word_char(c: Int): Bool
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or (c >= '0' and c <= '9')
end

def lint_read_word(source: String, pos: Int): String
  len = source.size
  var p = pos
  var word = ""
  while p < len
    c = source.str_byte_at(p)
    if is_word_char(c)
      word = word + str_from_char(c)
      p += 1
    else
      return word
    end
  end
  return word
end

def skip_line_comment(source: String, pos: Int): Int
  len = source.size
  var p = pos
  while p < len and lint_char_at(source, p) != "\n"
    p += 1
  end
  return p
end

def skip_string_literal(source: String, pos: Int): Int
  len = source.size
  var p = pos + 1
  while p < len
    c = lint_char_at(source, p)
    if c == "\\"
      p += 2
    elsif c == "\""
      return p + 1
    else
      p += 1
    end
  end
  return p
end

def skip_spaces(source: String, pos: Int): Int
  len = source.size
  var p = pos
  while p < len
    c = lint_char_at(source, p)
    if c == " " or c == "\t"
      p += 1
    else
      return p
    end
  end
  return p
end

def check_balance(source: String): Int
  len = source.size
  var pos = 0
  var end_count = 0
  var line = 1
  var errors = 0
  var open_kinds = vec_new()
  var open_lines = vec_new()

  while pos < len
    c = lint_char_at(source, pos)

    if c == "\n"
      line += 1
      pos += 1
    elsif c == " " or c == "\t" or c == "\r"
      pos += 1
    elsif c == "#"
      pos = skip_line_comment(source, pos)
    elsif c == "\""
      pos = skip_string_literal(source, pos)
    else
      word = lint_read_word(source, pos)
      word_len = word.size

      if word_len > 0
        kind = keyword_to_kind(word)

        if kind > 0
          open_kinds.push(kind)
          open_lines.push(line)
        elsif word == "else"
          after_else = pos + 4
          after_spaces = skip_spaces(source, after_else)
          next_word = lint_read_word(source, after_spaces)
          if next_word == "if"
            open_kinds.push(KIND_IF())
            open_lines.push(line)
            pos = after_spaces + 2
          end
        elsif word == "end"
          end_count += 1
          if open_kinds.size > 0
            open_kinds.pop()
            open_lines.pop()
          end
        end
        pos += word_len
      else
        pos += 1
      end
    end
  end

  errors = open_kinds.size
  open_kinds.free()
  open_lines.free()
  return errors
end

def check_extra_ends(source: String): Int
  len = source.size
  var pos = 0
  var open_count = 0
  var end_count = 0

  while pos < len
    c = lint_char_at(source, pos)

    if c == "\n" or c == " " or c == "\t" or c == "\r"
      pos += 1
    elsif c == "#"
      pos = skip_line_comment(source, pos)
    elsif c == "\""
      pos = skip_string_literal(source, pos)
    else
      word = lint_read_word(source, pos)
      word_len = word.size

      if word_len > 0
        kind = keyword_to_kind(word)
        if kind > 0
          open_count += 1
        elsif word == "else"
          after_else = pos + 4
          after_spaces = skip_spaces(source, after_else)
          next_word = lint_read_word(source, after_spaces)
          if next_word == "if"
            open_count += 1
            pos = after_spaces + 2
          end
        elsif word == "end"
          end_count += 1
        end
        pos += word_len
      else
        pos += 1
      end
    end
  end

  if end_count > open_count
    return end_count - open_count
  end
  return 0
end

# ========================================================================
# Tests
# ========================================================================

def main(): Int
  describe("check_balance") do ->

    # =====================================================================
    # Balanced programs — 0 errors
    # =====================================================================

    it("simple def/end") do ->
      source = """
        def foo(): Int
          return 1
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("nested if inside def") do ->
      source = """
        def f(): Int
          if x > 0
            return 1
          end
          return 0
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("while loop inside def") do ->
      source = """
        def g(): Void
          while x > 0
            x -= 1
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("for loop inside def") do ->
      source = """
        def h(): Void
          for i in 0..10
            puts(i)
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("struct definition") do ->
      assert_eq(check_balance("""
        struct Point
          x: Int
        end
        """), 0)
    end

    it("enum definition") do ->
      assert_eq(check_balance("""
        enum Color
          Red
          Green
        end
        """), 0)
    end

    it("match expression") do ->
      source = """
        def g(): Int
          match x
            0 => 1
            _ => 2
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("deeply nested") do ->
      source = """
        def a(): Int
          if x
            while y
              for i in 0..10
                match z
                  0 => 1
                end
              end
            end
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("multiple top-level defs") do ->
      source = """
        def a(): Int
        end
        def b(): Int
        end
        """
      assert_eq(check_balance(source), 0)
    end

    # =====================================================================
    # elsif does NOT add nesting
    # =====================================================================

    it("if/elsif/else/end is one block") do ->
      source = """
        def g(): Int
          if x > 0
            return 1
          elsif x < 0
            return 2
          else
            return 0
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("multiple elsif branches") do ->
      source = """
        def g(): Int
          if a
            1
          elsif b
            2
          elsif c
            3
          else
            4
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    # =====================================================================
    # else if DOES add nesting
    # =====================================================================

    it("else if with proper extra end") do ->
      source = """
        def g(): Int
          if a
            1
          else if b
            2
          end
          end
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("detects missing end for else if") do ->
      source = """
        def g(): Int
          if a
            1
          else if b
            2
          end
        end
        """
      errors = check_balance(source)
      assert_eq(errors > 0, true)
    end

    # =====================================================================
    # Missing end
    # =====================================================================

    it("missing end for def") do ->
      assert_eq(check_balance("""
        def foo(): Int
          return 1
        """), 1)
    end

    it("missing end for if") do ->
      source = """
        def f(): Int
          if x > 0
            return 1
        end
        """
      assert_eq(check_balance(source), 1)
    end

    it("multiple unclosed constructs") do ->
      assert_eq(check_balance("""
        def f(): Int
          if x > 0
            while y
        """), 3)
    end

    # =====================================================================
    # Extra end
    # =====================================================================

    it("detects extra end keywords") do ->
      source = """
        def f(): Int
        end
        end
        """
      assert_eq(check_extra_ends(source), 1)
    end

    # =====================================================================
    # String literal skipping
    # =====================================================================

    it("ignores keywords inside strings") do ->
      source = """
        def f(): String
          return "if end while"
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("ignores end inside string") do ->
      source = """
        def f(): String
          x = "the end"
          return x
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("handles escaped quotes") do ->
      source = """
        def f(): String
          return "she said \\"end\\" loudly"
        end
        """
      assert_eq(check_balance(source), 0)
    end

    # =====================================================================
    # Comment skipping
    # =====================================================================

    it("ignores keywords in comments") do ->
      source = """
        def f(): Int
          # if while for match
          return 1
        end
        """
      assert_eq(check_balance(source), 0)
    end

    it("ignores end in comments") do ->
      source = """
        def f(): Int
          # end end end
          return 1
        end
        """
      assert_eq(check_balance(source), 0)
    end

    # =====================================================================
    # Edge cases
    # =====================================================================

    it("accepts empty input") do ->
      assert_eq(check_balance(""), 0)
    end

    it("accepts comment-only input") do ->
      assert_eq(check_balance("""
        # just a comment
        """), 0)
    end
  end

  return qspec_main()
end
