## CST verbatim round-trip / losslessness tests (Formatter M1.3 part 1)
##
## Proves the losslessness GATE for the CST parser (frontend/cst_parser.qz):
##   cst_to_source_verbatim(cst_parse_source(x), x) == x  byte-for-byte
## over a curated set of crafted sources exercising the COVERED core grammar.
##
## The oracle (`cst_roundtrip`) parses a source string into a lossless CST and
## reconstructs the original bytes from the tree's token + trivia byte spans.
## Each `it` asserts the reconstruction equals the input string exactly via
## assert_eq_str (so a failure prints the in/out diff).
##
## COVERED (round-trips losslessly):
##   - function defs: block (`def f() ... end`) and endless (`def f() = e`)
##   - statements: var-decl (`var x [:T] = e`), const-binding (`x = e`),
##     return (with and without value), if/elsif/else, while, expr-stmt
##   - expressions: int/float/string/bool/nil literals, idents, parenthesized
##     grouping, unary (-/not/!), binary (arith/compare/eq/and/or with full
##     precedence), calls, method calls, field access, indexing
##   - trivia: line comments (leading + same-line trailing), doc-comments,
##     single newlines, blank-line RUNS, no-trailing-newline files,
##     leading-blank-line files
##   - D4 trailing commas on arg lists and param lists
##
## NOT-YET-COVERED (documented as it_pending → coverage gaps are visible, not
## hidden; these are the follow-up work to full-corpus losslessness): for-in,
## match, structs/enums/traits/impls, lambdas, interpolated strings, ranges,
## comprehensions, imports, generics in expression position, compound assign,
## index/field assignment, with/select/try-catch, decorators, visibility.
##
## NOTE: test bodies live in NAMED top-level functions called from thin `it`
## closures (CLAUDE.md spec-authoring footgun: complex bodies inlined inside
## many `do ->` closures blow up compile time).

import * from qspec
import cst_parser

# ---- oracle assertion helper ---------------------------------------------

## Assert that `src` round-trips byte-for-byte through the CST verbatim oracle.
def assert_roundtrips(src: String): Void
  assert_eq_str(cst_parser::cst_roundtrip(src), src)
end

## Assert that `src` parses FULLY STRUCTURED (no verbatim `had_error` fallback)
## AND still round-trips byte-for-byte. Both are required: a construct that
## structures but corrupts bytes is a FAIL, and a construct that round-trips only
## via the verbatim escape hatch is not yet formattable. Used by the M1.3b-tail
## tests to lock the newly-structured grammar.
def assert_structured(src: String): Void
  assert_eq_str(cst_parser::cst_roundtrip(src), src)
  assert_eq(cst_parser::cst_parse_fully_structured(src), 1)
end

# ---- function definitions ------------------------------------------------

def rt_endless_def(): Void = assert_roundtrips("def f() = 1\n")

def rt_block_def(): Void = assert_roundtrips("def f()\n  return 1\nend\n")

def rt_two_defs_blank(): Void = assert_roundtrips("def f() = 1\n\ndef g() = 2\n")

def rt_typed_sig(): Void = assert_roundtrips("def f(a: Int, b: String): Int\n  return a\nend\n")

def rt_no_trailing_newline(): Void = assert_roundtrips("def f() = 1")

# ---- statements -----------------------------------------------------------

def rt_var_decl(): Void = assert_roundtrips("def f()\n  var x = 1 + 2 * 3\n  return x\nend\n")

def rt_typed_var(): Void = assert_roundtrips("def f()\n  var x: Int = 5\n  return x\nend\n")

def rt_const_binding(): Void = assert_roundtrips("x = 1 + 2\n")

def rt_return_bare(): Void = assert_roundtrips("def f()\n  return\nend\n")

def rt_if_elsif_else(): Void = assert_roundtrips("def f(a)\n  if a\n    return 1\n  elsif a\n    return 2\n  else\n    return 3\n  end\nend\n")

def rt_while(): Void = assert_roundtrips("def f()\n  var i = 0\n  while i < 10\n    i = i + 1\n  end\nend\n")

# ---- expressions ----------------------------------------------------------

def rt_parens(): Void = assert_roundtrips("def f() = (1 + 2) * 3\n")

def rt_comparisons(): Void = assert_roundtrips("def f(a, b)\n  return a == b and a != b or a < b\nend\n")

def rt_unary(): Void = assert_roundtrips("def f(a) = not -a\n")

def rt_postfix_chain(): Void = assert_roundtrips("def f(r)\n  return r.a(b)[c].d\nend\n")

def rt_nested_calls(): Void = assert_roundtrips("def f() = g(h(1), k(2, 3))\n")

def rt_string_lit(): Void = assert_roundtrips("def f() = \"hello world\"\n")

# ---- trivia ---------------------------------------------------------------

def rt_leading_comment(): Void = assert_roundtrips("# top\ndef f() = 1\n")

def rt_inline_comment(): Void = assert_roundtrips("def f()\n  var x = 1  # inline\n  return x\nend\n")

def rt_comment_only_line(): Void = assert_roundtrips("def f()\n  # only a comment\n  return 1\nend\n")

def rt_doc_comment(): Void = assert_roundtrips("## doc\ndef f() = 1\n")

def rt_blank_run(): Void = assert_roundtrips("def f()\n\n\n  return 1\nend\n")

def rt_leading_blank_lines(): Void = assert_roundtrips("\n\ndef f() = 1\n")

# ---- D4 trailing commas ---------------------------------------------------

def rt_trailing_comma(): Void = assert_roundtrips("def f(a, b,)\n  return g(1, 2,)\nend\n")

# ---- M1.3b: full-grammar constructs (now structured + round-tripping) ------

def rt_for_in(): Void = assert_roundtrips("def f(xs)\n  for x in xs\n    g(x)\n  end\nend\n")

def rt_for_in_range(): Void = assert_roundtrips("def f()\n  for i in 0..10\n    g(i)\n  end\nend\n")

def rt_match(): Void = assert_roundtrips("def f(x)\n  match x\n    Some(v) => v\n    None => 0\n  end\nend\n")

def rt_match_guard(): Void = assert_roundtrips("def f(n)\n  match n\n    x if x > 5 => 1\n    _ => 0\n  end\nend\n")

def rt_struct_def(): Void = assert_roundtrips("struct Point\n  x: Int\n  y: Int\nend\n")

def rt_enum_def(): Void = assert_roundtrips("enum Color\n  Red\n  Green\n  Blue\nend\n")

def rt_trait_def(): Void = assert_roundtrips("trait Show\n  def show(self): String\nend\n")

def rt_impl_block(): Void = assert_roundtrips("extend Point\n  def mag(self): Int = self.x\nend\n")

def rt_lambda_arrow(): Void = assert_roundtrips("def f() = g(x -> x + 1)\n")

def rt_lambda_typed_arrow(): Void = assert_roundtrips("def f(xs) = each(xs, x: Int -> g(x))\n")

def rt_lambda_do_block(): Void = assert_roundtrips("def f(xs)\n  xs.each do x ->\n    g(x)\n  end\nend\n")

# NOTE: the interpolation hole is built via concatenation so the SPEC source
# itself is not interpolated by the compiler — the test DATA must contain a
# literal `#{n}` for the CST parser to round-trip.
def rt_interp_string(): Void
  var hash = str_from_char(35)  # '#'
  var src = "def f(n) = \"val=" + hash + "{n} ok\"\n"
  assert_roundtrips(src)
end

def rt_range_excl(): Void = assert_roundtrips("def f() = 0..10\n")

def rt_range_incl(): Void = assert_roundtrips("def f() = 0...10\n")

def rt_array_lit(): Void = assert_roundtrips("def f() = [1, 2, 3]\n")

def rt_map_lit(): Void = assert_roundtrips("def f() = {a: 1, b: 2}\n")

def rt_list_comp(): Void = assert_roundtrips("def f(xs) = [x * 2 for x in xs]\n")

def rt_import(): Void = assert_roundtrips("import a/b\nimport * from c\nfrom d import e, f\n")

def rt_compound_assign(): Void = assert_roundtrips("def f()\n  var x = 0\n  x += 1\n  x *= 2\nend\n")

def rt_index_field_assign(): Void = assert_roundtrips("def f(r, a)\n  r.field = 1\n  a[0] = 2\nend\n")

def rt_is_expr(): Void = assert_roundtrips("def f(x) = x is Some\n")

def rt_struct_init(): Void = assert_roundtrips("def f() = Point { x: 1, y: 2 }\n")

def rt_decorator(): Void = assert_roundtrips("@inline\ndef f() = 1\n")

def rt_visibility(): Void = assert_roundtrips("priv def secret() = 1\n")

def rt_break_continue(): Void = assert_roundtrips("def f(xs)\n  for x in xs\n    break if x\n    continue\n  end\nend\n")

def rt_defer(): Void = assert_roundtrips("def f()\n  defer cleanup()\n  work()\nend\n")

def rt_yield(): Void = assert_roundtrips("def f()\n  yield 1\n  yield 2\nend\n")

def rt_postfix_guard(): Void = assert_roundtrips("def f(x)\n  return 1 if x\n  g() unless x\nend\n")

def rt_symbol_char(): Void = assert_roundtrips("def f() = h(:ok, 'a')\n")

def rt_generic_call(): Void = assert_roundtrips("def f() = vec_new<Int>()\n")

def rt_nested_generic(): Void = assert_roundtrips("def f(v) = as_type<Vec<Int>>(v)\n")

def rt_tuple_destructure(): Void = assert_roundtrips("def f(p)\n  var (a, b) = p\n  return a\nend\n")

def rt_with_block(): Void = assert_roundtrips("def f()\n  with Log { emit: h } do ->\n    work()\n  end\nend\n")

def rt_try_expr(): Void = assert_roundtrips("def f()\n  var x = try get()\n  return x\nend\n")

def rt_match_with_comment(): Void = assert_roundtrips("def f(x)\n  match x\n    # the some case\n    Some(v) => v\n    None => 0\n  end\nend\n")

# ---- M1.3b-tail: edge-case constructs (now structured) --------------------

## select block with `case <bind> = <Selectable> => body` arms + a `default`
## arm. Each arm body is a structured CST_BLOCK; verifies the unified C.13 arm
## grammar parses without a verbatim fallback.
def rt_select_case_arms(): Void = assert_structured("def f(ch)\n  select\n    case v = recvable(ch) => g(v)\n    case _ = deadline_ms(10) => 0\n    default => h()\n  end\nend\n")

## select arm whose body is a multi-statement block terminated by the next arm.
def rt_select_multi_stmt_body(): Void = assert_structured("def f(ch)\n  select\n    case v = recvable(ch) =>\n      a(v)\n      b(v)\n    case _ = deadline_ms(5) => 0\n  end\nend\n")

## Named (keyword) call arguments `name: value` mixed with positional args.
def rt_named_args(): Void = assert_structured("def f(env) = eval_expr(num(99), env, depth: 5)\n")

## A named-arg value that is itself an expression must NOT be confused with a
## typed-arrow lambda (`x: T -> body`); the lambda still wins.
def rt_named_arg_vs_lambda(): Void = assert_structured("def f(xs) = each(xs, x: Int -> g(x))\n")

## Zero-param arrow lambda `-> body` (no params) as a call argument.
def rt_bare_arrow_lambda(): Void = assert_structured("def f() = it(name, -> run(name))\n")

## `do … end` block expression in value position (the block's last expr is its
## value).
def rt_do_block_expr(): Void = assert_structured("def f()\n  var r = do\n    var acc = 0\n    acc\n  end\n  return r\nend\n")

## `go do -> … end` block-form goroutine spawn as the RHS of a binding.
def rt_go_do_block(): Void = assert_structured("def f(ch)\n  var t = go do ->\n    send(ch, 1)\n  end\n  return t\nend\n")

## `when <guard>` clause on a multi-clause pattern-matched endless def.
def rt_when_guard_def(): Void = assert_structured("def classify(n: Int): String when n < 0 = \"neg\"\ndef classify(n: Int): String = \"pos\"\n")

## extern definition WITH a block body (special calling convention), vs a plain
## bodyless extern declaration on the next line.
def rt_extern_with_body(): Void = assert_structured("extern \"x86-interrupt\" def isr(frame: Int): Void\n  uart(84)\nend\n")

## A bodyless extern declaration followed by a top-level `var` — the abstract /
## bodyless boundary must not run the block consumer into the rest of the file.
def rt_extern_decl_then_var(): Void = assert_structured("extern \"C\" def puts(s: Int): Int\nvar x = 0\n")

## effect block whose LAST abstract method is followed (after the trait-closing
## `end`) by an UNRELATED top-level item. The `end`-column rule must classify the
## method as abstract instead of swallowing the rest of the module. (Regression:
## std/profile.qz ran the block consumer to EOF before the column fix.)
def rt_effect_last_abstract(): Void = assert_structured("effect Log\n  def emit(name: String): Int\nend\n\nvar gate = 0\n")

# ---- spec entry -----------------------------------------------------------

def main(): Int
  describe("CST verbatim round-trip — function definitions") do ->
    it("endless def round-trips") do -> rt_endless_def() end
    it("block def round-trips") do -> rt_block_def() end
    it("two defs with a blank line between round-trip") do -> rt_two_defs_blank() end
    it("typed signature (params + return type) round-trips") do -> rt_typed_sig() end
    it("file with no trailing newline round-trips") do -> rt_no_trailing_newline() end
  end

  describe("CST verbatim round-trip — statements") do ->
    it("var-decl with binary init round-trips") do -> rt_var_decl() end
    it("typed var-decl round-trips") do -> rt_typed_var() end
    it("top-level const binding round-trips") do -> rt_const_binding() end
    it("bare return round-trips") do -> rt_return_bare() end
    it("if/elsif/else round-trips") do -> rt_if_elsif_else() end
    it("while loop round-trips") do -> rt_while() end
  end

  describe("CST verbatim round-trip — expressions") do ->
    it("parenthesized grouping round-trips") do -> rt_parens() end
    it("comparison/equality/and/or precedence round-trips") do -> rt_comparisons() end
    it("unary operators round-trip") do -> rt_unary() end
    it("postfix call/field/index chain round-trips") do -> rt_postfix_chain() end
    it("nested calls round-trip") do -> rt_nested_calls() end
    it("string literal round-trips") do -> rt_string_lit() end
  end

  describe("CST verbatim round-trip — trivia (Roslyn EOL rule)") do ->
    it("leading own-line comment round-trips") do -> rt_leading_comment() end
    it("same-line trailing comment round-trips") do -> rt_inline_comment() end
    it("comment-only body line round-trips") do -> rt_comment_only_line() end
    it("doc-comment round-trips") do -> rt_doc_comment() end
    it("blank-line run round-trips") do -> rt_blank_run() end
    it("leading blank lines round-trip") do -> rt_leading_blank_lines() end
  end

  describe("CST verbatim round-trip — D4 trailing commas") do ->
    it("trailing commas on param + arg lists round-trip") do -> rt_trailing_comma() end
  end

  describe("CST verbatim round-trip — M1.3b full-grammar constructs") do ->
    it("for-in loop round-trips") do -> rt_for_in() end
    it("for-in over a range round-trips") do -> rt_for_in_range() end
    it("match expression round-trips") do -> rt_match() end
    it("match arm with `if` guard round-trips") do -> rt_match_guard() end
    it("struct definition round-trips") do -> rt_struct_def() end
    it("enum definition round-trips") do -> rt_enum_def() end
    it("trait with abstract method round-trips") do -> rt_trait_def() end
    it("extend block with endless method round-trips") do -> rt_impl_block() end
    it("arrow lambda round-trips") do -> rt_lambda_arrow() end
    it("typed single-param arrow lambda round-trips") do -> rt_lambda_typed_arrow() end
    it("trailing do/end block lambda round-trips") do -> rt_lambda_do_block() end
    it("interpolated string round-trips") do -> rt_interp_string() end
    it("exclusive range round-trips") do -> rt_range_excl() end
    it("inclusive range round-trips") do -> rt_range_incl() end
    it("array literal round-trips") do -> rt_array_lit() end
    it("map literal round-trips") do -> rt_map_lit() end
    it("list comprehension round-trips") do -> rt_list_comp() end
    it("import statements round-trip") do -> rt_import() end
    it("compound assignment round-trips") do -> rt_compound_assign() end
    it("index / field assignment round-trips") do -> rt_index_field_assign() end
    it("`is` variant test round-trips") do -> rt_is_expr() end
    it("struct-init literal round-trips") do -> rt_struct_init() end
    it("decorator round-trips") do -> rt_decorator() end
    it("visibility marker round-trips") do -> rt_visibility() end
    it("break/continue with postfix guard round-trip") do -> rt_break_continue() end
    it("defer round-trips") do -> rt_defer() end
    it("yield round-trips") do -> rt_yield() end
    it("postfix if/unless guards round-trip") do -> rt_postfix_guard() end
    it("symbol + char literals round-trip") do -> rt_symbol_char() end
    it("generic call (turbofish) round-trips") do -> rt_generic_call() end
    it("nested generic turbofish (>>) round-trips") do -> rt_nested_generic() end
    it("tuple destructuring var-decl round-trips") do -> rt_tuple_destructure() end
    it("with-block round-trips") do -> rt_with_block() end
    it("try expression round-trips") do -> rt_try_expr() end
    it("match with an interior comment round-trips") do -> rt_match_with_comment() end
  end

  describe("CST structural coverage — M1.3b-tail edge-case constructs") do ->
    # These assert FULL structure (no verbatim fallback) AND byte-exact
    # round-trip — the constructs that the M1.3b-tail pass closed (select
    # `case = Selectable` arms, named call args, bare/`go do` lambdas, do-block
    # expressions, `when` guards, extern bodies, abstract-method `end` columns).
    it("select `case = Selectable` arms + default structure") do -> rt_select_case_arms() end
    it("select arm with a multi-statement block body structures") do -> rt_select_multi_stmt_body() end
    it("named (keyword) call arguments structure") do -> rt_named_args() end
    it("named-arg value vs typed-arrow lambda disambiguates") do -> rt_named_arg_vs_lambda() end
    it("zero-param `-> body` arrow lambda argument structures") do -> rt_bare_arrow_lambda() end
    it("`do … end` block expression in value position structures") do -> rt_do_block_expr() end
    it("`go do -> … end` block-form spawn structures") do -> rt_go_do_block() end
    it("`when` guard on a pattern-matched endless def structures") do -> rt_when_guard_def() end
    it("extern definition with a block body structures") do -> rt_extern_with_body() end
    it("bodyless extern decl then top-level var structures") do -> rt_extern_decl_then_var() end
    it("effect's last abstract method (end-column rule) structures") do -> rt_effect_last_abstract() end
  end

  return qspec_main()
end
