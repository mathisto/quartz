## Dce Tests
##
## Contract:
##   1. Preserves used: live variables retained.
##   2. Dead chain: unused var chain eliminated.
##   3. Side effects: print_int preserved even if result unused.
##   4. After CSE: duplicate computation eliminated.
##   5. Branches: dead code in if/else branches handled.
##   6. Iterative: transitively dead code removed.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Dead Code Elimination") do ->
    it("preserves used variable") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          x
        end
      """, 42)
    end

    it("eliminates chain of dead computations - program still works") do ->
      assert_run_exits("""
        def main(): Int
          var a = 1
          var b = a + 2
          var c = b * 3
          7
        end
      """, 7)
    end

    it("preserves side-effecting call even if result unused") do ->
      assert_run_stdout_eq("""
        def side_effect(x: Int): Int
          print_int(x)
          x
        end

        def main(): Int
          var unused = side_effect(42)
          0
        end
      """, "42\n")
    end

    it("DCE after CSE removes duplicate computation") do ->
      assert_run_exits("""
        def compute(a: Int, b: Int): Int
          var x = a + b
          var y = a + b
          x + y
        end

        def main(): Int
          compute(10, 11)
        end
      """, 42)
    end

    it("handles dead code in branches correctly") do ->
      assert_run_exits("""
        def main(): Int
          var x = 1
          if x > 0
            var dead = 99
            42
          else
            var dead2 = 100
            0
          end
        end
      """, 42)
    end

    it("iterative DCE removes transitively dead code") do ->
      assert_run_exits("""
        def main(): Int
          var a = 10
          var b = a + 20
          var c = b + 30
          var d = c + 40
          5
        end
      """, 5)
    end
  end

  return qspec_main()
end
