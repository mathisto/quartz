## Vectors Tests
##
## Contract:
##   1. Vec_new.
##   2. Vec_push and vec_size.
##   3. Vec_get.
##   4. Vec_set.
##   5. Vector growth.
##   6. Vectors with loops.
##   7. Vectors with functions.
##   8. Vector properties.

import * from qspec
import * from qspec/property
import * from qspec/subprocess

def main(): Int
  describe("vec_new") do ->
    it("creates an empty vector") do ->
      var v = vec_new()
      assert_eq(v.size, 0)
    end
  end

  describe("vec_push and vec_size") do ->
    it("returns 0 for empty vector") do ->
      var v = vec_new()
      assert_eq(v.size, 0)
    end

    it("pushes one element and returns length 1") do ->
      var v = vec_new()
      v.push(42)
      assert_eq(v.size, 1)
    end

    it("pushes multiple elements") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v.size, 3)
    end
  end

  describe("vec_get") do ->
    it("gets first element") do ->
      var v = vec_new()
      v.push(42)
      assert_eq(v[0], 42)
    end

    it("gets elements at different indices") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(v[0], 10)
      assert_eq(v[1], 20)
      assert_eq(v[2], 30)
    end

    it("panics on out of bounds index") do ->
      assert_run_panics("""
        def main(): Int
          var v = vec_new()
          vec_push(v, 42)
          puts(str_from_int(vec_get(v, 5)))
          return 0
        end
        """, "index out of bounds")
    end
  end

  describe("vec_set") do ->
    it("sets element at index") do ->
      var v = vec_new()
      v.push(0)
      v.set(0, 42)
      assert_eq(v[0], 42)
    end

    it("sets multiple elements") do ->
      var v = vec_new()
      v.push(0)
      v.push(0)
      v.push(0)
      v.set(0, 10)
      v.set(1, 20)
      v.set(2, 30)
      assert_eq(v[0], 10)
      assert_eq(v[1], 20)
      assert_eq(v[2], 30)
    end

    it("preserves other elements after set") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      v.set(1, 99)
      assert_eq(v[0], 10)
      assert_eq(v[1], 99)
      assert_eq(v[2], 30)
    end
  end

  describe("vector growth") do ->
    it("grows beyond initial capacity") do ->
      var v = vec_new()
      for i in 0..20
        v.push(i * 10)
      end
      assert_eq(v.size, 20)
      assert_eq(v[0], 0)
      assert_eq(v[19], 190)
    end
  end

  describe("vectors with loops") do ->
    it("iterates with while loop") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      var sum = 0
      var i = 0
      while i < v.size
        sum = sum + v[i]
        i = i + 1
      end
      assert_eq(sum, 60)
    end

    it("builds vector in loop") do ->
      var v = vec_new()
      for i in 0..5
        v.push(i * i)
      end
      assert_eq(v.size, 5)
      assert_eq(v[0], 0)
      assert_eq(v[4], 16)
    end
  end

  describe("vectors with functions") do ->
    it("passes vector to function") do ->
      var v = vec_new()
      v.push(10)
      v.push(20)
      v.push(30)
      assert_eq(vec_sum(v), 60)
    end

    it("modifies vector in function") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      vec_double_all(v)
      assert_eq(v[0], 2)
      assert_eq(v[1], 4)
      assert_eq(v[2], 6)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("vector properties") do ->
    forall_i("push increases length by 1") do x: Int ->
      var v = vec_new()
      v.push(x)
      assert_eq(v.size, 1)
    end

    forall_i("push then get returns pushed value") do x: Int ->
      var v = vec_new()
      v.push(x)
      assert_eq(v[0], x)
    end

    forall_ii("set then get roundtrip") do x: Int, y: Int ->
      var v = vec_new()
      v.push(0)
      v.push(0)
      var idx = 0
      if x > 0
        idx = 1
      end
      v.set(idx, y)
      assert_eq(v[idx], y)
    end
  end

  return qspec_main()
end

def vec_sum(v: Vec): Int
  var sum = 0
  var i = 0
  while i < v.size
    sum = sum + v[i]
    i = i + 1
  end
  return sum
end

def vec_double_all(v: Vec): Void
  var i = 0
  while i < v.size
    v.set(i, v[i] * 2)
    i = i + 1
  end
end
