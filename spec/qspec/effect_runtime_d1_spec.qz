## Effect dispatch runtime — Milestone D.1/D.2/D.3 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D (chunks D.1-D.3).
##
## Verifies that MIR_PERFORM_OP / MIR_HANDLE_INSTALL / MIR_HANDLE_UNINSTALL
## codegen to real runtime calls — not just LLVM IR comments — and that
## the resulting programs actually compile, link, and execute.
##
## Since D.4 (default handler registration) has not landed, ANY program
## that actually invokes an effect op at runtime exits with code 66
## (sysexit EX_NOINPUT, our convention for "unhandled effect"). This is
## observable behavior: previously (under C.4 stub codegen) the op call
## silently returned 0 and the program continued.
##
## D.5 (user handlers) and D.4 (default handlers) will change the
## expected output of programs that install a handler. These tests
## exercise the UNHANDLED path — the guard rail that surfaces missing
## handler installations — and should stay stable as D.4/D.5 land
## (unless an installed handler catches Throws/Log, in which case the
## tests need the handler elided).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect dispatch runtime (piezo D.1-D.3)") do ->
    it("IR contains the __qz_effect_perform runtime helper") do ->
      var src = """
def main(): Int = 0
"""
      assert_ir_contains(src, "define i64 @__qz_effect_perform")
    end

    it("IR contains the __qz_effect_handle_install runtime helper") do ->
      var src = """
def main(): Int = 0
"""
      assert_ir_contains(src, "define void @__qz_effect_handle_install")
    end

    it("IR contains the __qz_effect_handle_uninstall runtime helper") do ->
      var src = """
def main(): Int = 0
"""
      assert_ir_contains(src, "define void @__qz_effect_handle_uninstall")
    end

    it("IR contains the __qz_effect_unhandled runtime helper") do ->
      var src = """
def main(): Int = 0
"""
      assert_ir_contains(src, "define void @__qz_effect_unhandled")
    end

    it("op call lowers to call @__qz_effect_perform (not stubbed add 0,0)") do ->
      assert_ir_contains("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("boom")
def main(): Int = risky()
""", "call i64 @__qz_effect_perform")
    end

    it("with-block lowers to call @__qz_effect_handle_install") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def noisy(): Int can = with Log do ->
  emit("hi")
end
def main(): Int = noisy()
""", "call void @__qz_effect_handle_install")
    end

    it("with-block lowers to call @__qz_effect_handle_uninstall") do ->
      assert_ir_contains("""
effect Log
  def emit(s: String): Int
end

def noisy(): Int can = with Log do ->
  emit("hi")
end
def main(): Int = noisy()
""", "call void @__qz_effect_handle_uninstall")
    end

    it("program that calls an unhandled op exits 66 at runtime") do ->
      # No `with` wrapping the op call at the point where it's invoked,
      # so the handler stack walk falls through to __qz_effect_unhandled.
      # Expected behavior: exit(66).
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("boom")
def main(): Int = risky()
""", 66)
    end

    it("unhandled op writes diagnostic to stderr (via D.4 default Throws handler)") do ->
      # D.4 registers a default Throws handler at main prelude that
      # prints "default throws fired" and exits. The __qz_effect_unhandled
      # path (fallback for non-blessed effects) is no longer reachable
      # from typechecked programs — any non-blessed op hits QZ0611 at
      # typecheck. This test verifies the default-handler stderr tag
      # instead; the unhandled path is exercised by the runtime helper
      # presence tests above.
      assert_run_stderr_contains("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("boom")
def main(): Int = risky()
""", "boom")
    end

    it("program without any effect ops runs cleanly (exit 0)") do ->
      # Regression gate: the effect runtime helpers are dead code when
      # a program doesn't use any op, so emitting them should not
      # change runtime behavior of non-effect programs.
      assert_run_exits("""
def main(): Int = 0
""", 0)
    end

    it("install/uninstall with empty handler still hits unhandled path") do ->
      # C.4 convention: `with Effect do -> body end` installs a NULL
      # handler (D.5 will bind real handlers once user-syntax lands).
      # A null handler dispatch falls through to __qz_effect_unhandled
      # — same exit 66 as if no handler were installed.
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can = with Throws do ->
  throw("inside with but handler is null")
end
def main(): Int = risky()
""", 66)
    end
  end
  return qspec_main()
end
