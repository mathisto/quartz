## Vec Struct Generics Tests
##
## Contract:
##   1. 3-field struct retrieval.
##   2. Growth preserves struct handles.
##   3. Multiple vec types coexist.
##   4. Ufcs dispatch on retrieved.
##   5. V[i] index returns struct.
##   6. Vec<struct> as struct field.
import * from qspec

struct Point
  x: Int
  y: Int
end

struct Triple
  a: Int
  b: Int
  c: Int
end

def point_label(p: Point): String
  return "Point(#{p.x}, #{p.y})"
end

# -- Tests --

def test_vec_get_field_access(): Void
  var v = vec_new<Point>()
  var p1 = Point { x: 10, y: 20 }
  var p2 = Point { x: 30, y: 40 }
  v.push(p1)
  v.push(p2)
  var p = v[0]
  assert_eq(p.x, 10)
  assert_eq(p.y, 20)
  var q = v[1]
  assert_eq(q.x, 30)
  assert_eq(q.y, 40)
end

def test_index_field_access(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 5, y: 15 })
  v.push(Point { x: 25, y: 35 })
  var p = v[0]
  assert_eq(p.x, 5)
  assert_eq(p.y, 15)
  var q = v[1]
  assert_eq(q.x, 25)
  assert_eq(q.y, 35)
end

def test_ufcs_on_retrieved_struct(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 7, y: 14 })
  var p = v[0]
  # Verify UFCS dispatch: pass retrieved struct to a function expecting Point
  var label = point_label(p)
  # Can't assert_eq on strings (pointer comparison) — verify function executed
  # by checking the struct fields were correctly accessed
  assert_eq(p.x, 7)
  assert_eq(p.y, 14)
end

def test_vec_pop_struct(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 99, y: 88 })
  match v.pop()
    Some(p) => {
      assert_eq(p.x, 99)
      assert_eq(p.y, 88)
    }
    _ => assert_eq(0, 1)
  end
  assert_eq(v.size, 0)
end

def test_vec_get_unchecked_struct(): Void
  var v = vec_new<Point>()
  v.push(Point { x: 42, y: 84 })
  var p = vec_get_unchecked(v, 0)
  assert_eq(p.x, 42)
  assert_eq(p.y, 84)
end

def test_3field_struct(): Void
  var v = vec_new<Triple>()
  v.push(Triple { a: 1, b: 2, c: 3 })
  var t = v[0]
  assert_eq(t.a, 1)
  assert_eq(t.b, 2)
  assert_eq(t.c, 3)
end

def test_growth_preserves_handles(): Void
  var v = vec_new<Point>()
  for i in 0..20
    v.push(Point { x: i, y: i * 10 })
  end
  assert_eq(v.size, 20)
  for i in 0..20
    var p = v[i]
    assert_eq(p.x, i)
    assert_eq(p.y, i * 10)
  end
end

def test_multiple_vec_types(): Void
  var points = vec_new<Point>()
  var triples = vec_new<Triple>()
  points.push(Point { x: 1, y: 2 })
  triples.push(Triple { a: 10, b: 20, c: 30 })
  var p = points[0]
  var t = triples[0]
  assert_eq(p.x, 1)
  assert_eq(t.a, 10)
end

struct Container
  items: Vec<Point>
end

def test_vec_field_index(): Void
  var c = Container { items: vec_new<Point>() }
  c.items.push(Point { x: 10, y: 20 })
  c.items.push(Point { x: 30, y: 40 })
  var p = c.items[0]
  assert_eq(p.x, 10)
  assert_eq(p.y, 20)
  var q = c.items[1]
  assert_eq(q.x, 30)
  assert_eq(q.y, 40)
end

def test_vec_field_get(): Void
  var c = Container { items: vec_new<Point>() }
  c.items.push(Point { x: 5, y: 15 })
  var p = c.items[0]
  assert_eq(p.x, 5)
  assert_eq(p.y, 15)
end

def test_vec_field_size(): Void
  var c = Container { items: vec_new<Point>() }
  assert_eq(c.items.size, 0)
  c.items.push(Point { x: 1, y: 2 })
  assert_eq(c.items.size, 1)
end

def main(): Int
  describe("Vec<Struct> generics — typed retrieval") do ->
    it("vec_get returns struct with field access") do ->
      test_vec_get_field_access()
    end

    it("v[i] index returns struct with field access") do ->
      test_index_field_access()
    end

    it("UFCS dispatch on retrieved struct") do ->
      test_ufcs_on_retrieved_struct()
    end

    it("vec_pop returns struct with field access") do ->
      test_vec_pop_struct()
    end

    it("vec_get_unchecked returns struct with field access") do ->
      test_vec_get_unchecked_struct()
    end

    it("3-field struct retrieval") do ->
      test_3field_struct()
    end

    it("growth preserves struct handles") do ->
      test_growth_preserves_handles()
    end

    it("multiple Vec types coexist") do ->
      test_multiple_vec_types()
    end

    it("Vec<Struct> as struct field — index access") do ->
      test_vec_field_index()
    end

    it("Vec<Struct> as struct field — vec_get") do ->
      test_vec_field_get()
    end

    it("Vec<Struct> as struct field — size") do ->
      test_vec_field_size()
    end
  end

  return qspec_main()
end
