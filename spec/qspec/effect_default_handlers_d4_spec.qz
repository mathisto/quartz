## Default main-handler injection — Milestone D.4 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone D (chunk D.4).
##
## Verifies that blessed effects (Throws, Log) get default handlers
## installed at `main` entry via the codegen main-wrapper prelude.
## Programs that call these effects from untracked top-level main
## (no `can` row, no enclosing `with`) no longer fire QZ0611 — instead
## the default handler runs, producing observable output and controlling
## the exit code.
##
## Blessed set for D.4: Throws (fatal — writes the actual thrown message +
## newline to stderr, exits 66) and Log (non-fatal — writes the actual
## message + newline to stderr, returns 0, execution continues). Extending
## the blessed set to more effects (Clock, Random, IO) is D.7 stdlib work.
##
## These tests exercise a Milestone D codegen path that previous
## milestones couldn't: compile, link, execute a program that uses
## algebraic effect ops and observe the runtime dispatch result.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("default main-handler injection (piezo D.4)") do ->
    it("bare throw from untracked main fires default handler (exit 66)") do ->
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def main(): Int = throw("boom")
""", 66)
    end

    it("bare throw from untracked main writes the actual message to stderr") do ->
      assert_run_stderr_contains("""
effect Throws
  def throw(msg: String): Int
end

def main(): Int = throw("boom")
""", "boom")
    end

    it("bare emit from untracked main is non-fatal (exit 0)") do ->
      assert_run_exits("""
effect Log
  def emit(s: String): Int
end

def main(): Int
  emit("hi")
  return 0
end
""", 0)
    end

    it("multiple emit calls all run (Log is non-fatal)") do ->
      assert_run_stderr_contains("""
effect Log
  def emit(s: String): Int
end

def main(): Int
  emit("one")
  emit("two")
  return 0
end
""", "two")
    end

    it("throw through a can-rowed function reaches default handler") do ->
      # Caller has `can Throws`; since nothing is installed on the
      # handler stack between main and risky() for Throws, the default
      # handler (registered at main prelude) catches the op.
      assert_run_exits("""
effect Throws
  def throw(msg: String): Int
end

def risky(): Int can Throws = throw("boom")
def main(): Int = risky()
""", 66)
    end

    it("non-blessed effect still requires explicit coverage (QZ0611)") do ->
      # Coverage relaxation in C.3 is deliberate only for the blessed
      # set. User-declared effects without default handlers still get
      # QZ0611 at typecheck time.
      assert_compile_error("""
effect Custom
  def op(): Int
end

def main(): Int = op()
""", "QZ0611")
    end

    it("default handler IR is present in compiled output") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "define i64 @__qz_default_throws_handler")
    end

    it("Log default handler IR is present") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "define i64 @__qz_default_log_handler")
    end

    it("main wrapper calls effect init + default installs") do ->
      assert_ir_contains("""
def main(): Int = 0
""", "call void @__qz_effect_init()")
    end

    it("program without any effects still exits cleanly (runtime no-op)") do ->
      # Regression gate: default handler install runs unconditionally
      # in the main prelude, but doesn't perturb the exit code of a
      # program that never calls any op.
      assert_run_exits("""
def main(): Int = 0
""", 0)
    end
  end
  return qspec_main()
end
