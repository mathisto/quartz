## priv Keyword Tests
##
## Contract:
##   1. Inline priv: `priv def` callable from same module.
##   2. Struct: `priv struct` usable from same module.
##   3. Cross-module: priv items not accessible from importers.
##   4. Coexistence: priv works alongside private section.
##   5. Body var: `priv` not a keyword inside function bodies.
##   6. Enum: `priv enum` supported.
##   7. Computed: priv function return value used in expression.
##   8. Struct field: priv struct field access.

import * from qspec

priv def pk_helper(): Int = 42

priv struct PkSecret
  value: Int
end

priv enum PkColor
  Red
  Blue
end

def pk_public_fn(): Int = 10
priv def pk_priv_helper(): Int = 20

def pk_combined(): Void
  print_int(pk_public_fn() + pk_priv_helper())
end

def pk_helper_prints(): Void
  print_int(pk_helper())
end

def pk_struct_prints(): Void
  s = PkSecret { value: 99 }
  print_int(s.value)
end

def pk_enum_prints(): Void
  c = PkColor::Red
  match c
    PkColor::Red => print_int(1)
    PkColor::Blue => print_int(2)
  end
end

def main(): Int
  describe("priv keyword") do ->
    it("allows priv def callable from same module") do ->
      assert_output("42\n", pk_helper_prints)
    end

    it("allows priv struct usable from same module") do ->
      assert_output("99\n", pk_struct_prints)
    end

    it("prevents priv def from being called by importing module (multi-file test)") do ->
      assert_compile_error_with_fixtures("import math_helper\ndef main(): Int\n  return math_helper::math_internal()\nend\n", "has no function")
    end

    it("works alongside private section") do ->
      assert_output("30\n", pk_combined)
    end

    it("priv is not recognized in function bodies (variable named priv)") do ->
      assert_output("42\n", pk_priv_var)
    end

    it("supports priv enum") do ->
      assert_output("1\n", pk_enum_prints)
    end

    it("priv function return value used in expression") do ->
      assert_eq(pk_helper() + 8, 50)
    end

    it("priv struct field access within module") do ->
      s = PkSecret { value: 77 }
      assert_eq(s.value, 77)
    end
  end

  return qspec_main()
end

def pk_priv_var(): Void
  priv = 42
  print_int(priv)
end
