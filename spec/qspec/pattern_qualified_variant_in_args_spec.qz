## Regression spec for nested qualified-variant patterns in match arms.
##
## Pre-fix bug (PATTERN_PARSER_REJECTS_QUALIFIED_VARIANT, sub-bug a):
## the pattern parser at parser.qz:5306 explicitly accepted only IDENT,
## UNDERSCORE, or reserved-keyword inside a constructor's argument list
## (`Some(x)`, `Some(_)`, etc). A nested qualified variant like
## `Some(Focus::NameInput)` cascaded `Expected ')'` + `Expected '=>'` +
## `Expected expression` because `::` was not in the accepted set.
##
## Fix: extracted the binding-slot logic into a helper
## `_ps_parse_pattern_arg_binding` that recognises and consumes
## `IDENT (::IDENT)+ (...)?`, degrading the binding to `_` (wildcard).
## Sub-bug (b) — true variant-discriminator dispatch — remains open;
## the Maranget exhaustiveness pass (QZ0108) flags subsequent arms as
## unreachable, just as it does for the unqualified `Some(NameInput)`
## workaround.

import * from qspec

enum PQFocus
  PQNameInput
  PQSaveList
end

enum PQMaybe
  PQJust(f: PQFocus)
  PQNothing
end

def take_just_qualified(): String
  var m: PQMaybe = PQMaybe::PQJust(PQFocus::PQNameInput)
  match m
    PQJust(PQFocus::PQNameInput) => return "first-arm"
    PQJust(PQFocus::PQSaveList)  => return "second-arm"
    PQNothing                    => return "nothing-arm"
  end
  return "fallthrough"
end

def take_just_bound(): Int
  var m: PQMaybe = PQMaybe::PQJust(PQFocus::PQSaveList)
  match m
    PQJust(x)   => return 1
    PQNothing   => return 0
  end
  return -1
end

def take_just_wildcard(): Int
  var m: PQMaybe = PQMaybe::PQJust(PQFocus::PQNameInput)
  match m
    PQJust(_)   => return 1
    PQNothing   => return 0
  end
  return -1
end

def main(): Int
  describe("nested qualified-variant patterns in match arms") do ->

    it("parses Some(Type::Variant) without QZ0101 cascade") do ->
      ## Pre-fix this would have failed to compile.
      assert_eq_str(take_just_qualified(), "first-arm")
    end

    it("does not regress unqualified bound pattern Just(x)") do ->
      assert_eq(take_just_bound(), 1)
    end

    it("does not regress wildcard pattern Just(_)") do ->
      assert_eq(take_just_wildcard(), 1)
    end

  end
  return qspec_main()
end
