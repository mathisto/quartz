## User Macro Tests — Hardened
##
## Contract:
##   1. User-defined macros — basic.
##   2. User-defined macros — advanced.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("user-defined macros — basic") do ->
    it("expands a quote/unquote macro") do ->
      assert_run_stdout_eq(um_quote_src(), "42\n")
    end

    it("expands a quote macro with addition") do ->
      assert_run_stdout_eq(um_template_src(), "42\n")
    end

    it("expands macro without affecting caller scope") do ->
      assert_run_stdout_eq(um_scope_src(), "21\n7\n")
    end

    it("handles multiple macro invocations") do ->
      assert_run_stdout_eq(um_multi_src(), "11\n21\n31\n")
    end

    it("supports multiple different macros") do ->
      assert_run_stdout_eq(um_two_macros_src(), "11\n20\n")
    end
  end

  describe("user-defined macros — advanced") do ->
    it("macro with zero args") do ->
      assert_run_stdout_eq(um_zero_args_src(), "42\n")
    end

    it("macro used in expression context") do ->
      assert_run_stdout_eq(um_expr_context_src(), "52\n")
    end

    it("macro used in if condition") do ->
      assert_run_exits(um_if_condition_src(), 1)
    end

    it("macro result used in variable") do ->
      assert_run_stdout_eq(um_var_assign_src(), "100\n")
    end

    it("macro invocation in return") do ->
      assert_run_exits(um_return_src(), 42)
    end

    it("macro with subtraction") do ->
      assert_run_stdout_eq(um_sub_src(), "8\n")
    end

    it("macro with nested arithmetic") do ->
      assert_run_stdout_eq(um_nested_arith_src(), "30\n")
    end

    it("macro called multiple times same line") do ->
      assert_run_stdout_eq(um_same_line_src(), "12\n")
    end

    it("macro with multiplication") do ->
      assert_run_stdout_eq(um_mul_src(), "50\n")
    end

    it("macro unquote preserves value") do ->
      assert_run_stdout_eq(um_preserve_src(), "7\n")
    end
  end

  return qspec_main()
end

def um_quote_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  print_int($double(21))
  return 0
end
"""
end

def um_template_src(): String
  return """
macro add_ten(x) do
  quote do
    unquote(x) + 10
  end
end

def main(): Int
  print_int($add_ten(32))
  return 0
end
"""
end

def um_scope_src(): String
  return """
macro triple(x) do
  quote do
    unquote(x) + unquote(x) + unquote(x)
  end
end

def main(): Int
  var a = 7
  print_int($triple(a))
  print_int(a)
  return 0
end
"""
end

def um_multi_src(): String
  return """
macro inc(x) do
  quote do
    unquote(x) + 1
  end
end

def main(): Int
  print_int($inc(10))
  print_int($inc(20))
  print_int($inc(30))
  return 0
end
"""
end

def um_two_macros_src(): String
  return """
macro add1(x) do
  quote do
    unquote(x) + 1
  end
end

macro mul2(x) do
  quote do
    unquote(x) * 2
  end
end

def main(): Int
  print_int($add1(10))
  print_int($mul2(10))
  return 0
end
"""
end

def um_zero_args_src(): String
  return """
macro meaning() do
  quote do
    42
  end
end

def main(): Int
  print_int($meaning())
  return 0
end
"""
end

def um_expr_context_src(): String
  return """
macro add_ten(x) do
  quote do
    unquote(x) + 10
  end
end

def main(): Int
  var result = $add_ten(42)
  print_int(result)
  return 0
end
"""
end

def um_if_condition_src(): String
  return """
macro is_pos(x) do
  quote do
    unquote(x) > 0
  end
end

def main(): Int
  if $is_pos(5)
    return 1
  end
  return 0
end
"""
end

def um_var_assign_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  var v = $double(50)
  print_int(v)
  return 0
end
"""
end

def um_return_src(): String
  return """
macro meaning() do
  quote do
    42
  end
end

def main(): Int
  return $meaning()
end
"""
end

def um_sub_src(): String
  return """
macro sub_two(x) do
  quote do
    unquote(x) - 2
  end
end

def main(): Int
  print_int($sub_two(10))
  return 0
end
"""
end

def um_nested_arith_src(): String
  return """
macro add_ten(x) do
  quote do
    unquote(x) + 10
  end
end

def main(): Int
  print_int($add_ten(10) + 10)
  return 0
end
"""
end

def um_same_line_src(): String
  return """
macro inc(x) do
  quote do
    unquote(x) + 1
  end
end

def main(): Int
  print_int($inc(5) + $inc(5))
  return 0
end
"""
end

def um_mul_src(): String
  return """
macro times5(x) do
  quote do
    unquote(x) * 5
  end
end

def main(): Int
  print_int($times5(10))
  return 0
end
"""
end

def um_preserve_src(): String
  return """
macro identity(x) do
  quote do
    unquote(x)
  end
end

def main(): Int
  print_int($identity(7))
  return 0
end
"""
end
