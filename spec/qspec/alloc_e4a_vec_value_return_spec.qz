## QSpec coverage for Phase E.4.a slice 2 — Vec<8-byte-element-T> returns
## from goroutines.
##
## Phase E.4.a slice 1 (2026-04-28) extended the auto-arena gate to accept
## `String` returns via `arena_promote_string`. Slice 2 (this spec) extends
## further to cover `Vec<T>` returns where T is an 8-byte-element-typed
## scalar (Int / Float / Char / CPtr / Symbol / Int64 / UInt64 / Float64).
##
## Narrow-element Vec types (Vec<Bool>, Vec<I8>/U8, Vec<I16>/U16,
## Vec<I32>/U32/F32) are NOT covered by slice 2 — their Vec layout uses
## 1/2/4-byte element stride per `shared/elem_width.qz:elem_byte_width`,
## while `arena_promote_vec_value` is hardcoded to 8-byte stride via its
## `Vec<Int>` signature. Narrow-element Vec returns from goroutines fall
## through the gate to libc-heap fallback (the path slice 1 used for
## reference types pre-E.4.a). Width-aware promote ships in slice 2.b /
## slice 4.
##
## What these tests prove:
##
##   E4a.s2.a — `go fn(): Vec<Int>`: per-task arena absorbs the body's
##              push-loop allocations; promote at task-end deep-copies
##              the Vec into the parent's heap; size + contents survive.
##   E4a.s2.b — Multi-worker (sched_init(0)): parallel Vec<Int>-returning
##              goroutines, each in its own per-task arena, results
##              correct, no cross-task leakage.
##   E4a.s2.c — Lifetime regression: 100 sequential spawn+await cycles
##              with growing Vec<Int> bodies; per-task arenas freed
##              eagerly between iterations.
##   E4a.s2.d — Vec<Float>: 8-byte-element float Vec also works through
##              the same promote helper (existential type uniformity at
##              runtime for 8-byte slots).

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# E4a.s2.a — Vec<Int> with growing body: per-task arena absorbs all the
# push-loop allocations; final Vec is deep-copied to parent's heap via
# arena_promote_vec_value.
# -----------------------------------------------------------------------------

var _VEC_INT_BASIC: String = """import * from std/sync/composition/go
import * from std/alloc

def make_squares(): Vec<Int>
  var v = vec_new<Int>()
  for i in 0..10
    v.push(i * i)
  end
  return v
end

def main(): Int
  sched_init(1)
  var fut = go make_squares()
  var v = await fut
  var ok = 1
  if v.size != 10
    ok = 0
  end
  for i in 0..10
    if v[i] != i * i
      ok = 0
    end
  end
  if ok == 1
    puts(\"vec-int-ok\")
  else
    puts(\"FAIL:size=\" + str_from_int(v.size))
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s2.b — parallel Vec<Int>-returning goroutines on multi-worker.
# Each per-task arena is per-worker, freed before next task on that worker.
# -----------------------------------------------------------------------------

var _VEC_INT_PARALLEL: String = """import * from std/sync/composition/go
import * from std/alloc

def burst(n: Int): Vec<Int>
  var v = vec_new<Int>()
  for i in 0..n
    v.push(i * 7)
  end
  return v
end

def main(): Int
  sched_init(0)
  var f1 = go burst(3)
  var f2 = go burst(5)
  var f3 = go burst(7)
  var v1 = await f1
  var v2 = await f2
  var v3 = await f3
  if v1.size == 3 and v2.size == 5 and v3.size == 7 and v1[2] == 14 and v2[4] == 28 and v3[6] == 42
    puts(\"vec-parallel-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s2.c — 100 sequential spawn+await cycles with growing Vec<Int> body.
# Per-task arenas freed eagerly via arena_destroy after each await. RSS
# stays bounded.
# -----------------------------------------------------------------------------

var _VEC_INT_LIFETIME: String = """import * from std/sync/composition/go
import * from std/alloc

def gen_seq(n: Int): Vec<Int>
  var v = vec_new<Int>()
  for i in 0..n
    v.push(i)
  end
  return v
end

def main(): Int
  sched_init(1)
  var ok_count = 0
  for iter in 0..100
    var fut = go gen_seq(20)
    var v = await fut
    if v.size == 20 and v[0] == 0 and v[19] == 19
      ok_count = ok_count + 1
    end
  end
  if ok_count == 100
    puts(\"vec-lifetime-ok\")
  else
    puts(\"FAIL:ok=\" + str_from_int(ok_count))
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s2.d — Vec<Float> works through the same 8-byte-stride promote helper.
# Float is an 8-byte type (defaults to F64 / Float64); existentially i64
# at runtime so the same arena_promote_vec_value handles it.
# -----------------------------------------------------------------------------

var _VEC_FLOAT: String = """import * from std/sync/composition/go
import * from std/alloc

def make_floats(): Vec<Float>
  var v = vec_new<Float>()
  v.push(1.5)
  v.push(2.5)
  v.push(3.5)
  return v
end

def main(): Int
  sched_init(1)
  var fut = go make_floats()
  var v = await fut
  if v.size == 3 and v[0] == 1.5 and v[1] == 2.5 and v[2] == 3.5
    puts(\"vec-float-ok\")
  else
    puts(\"FAIL:size=\" + str_from_int(v.size))
  end
  sched_shutdown()
  return 0
end
"""

def main(): Int
  describe("Phase E.4.a slice 2 — Vec<8-byte-element-T> returns from goroutines via per-task arena + promote") do ->
    it("Vec<Int> body absorbed by per-task arena; size + contents preserved across await") do ->
      assert_run_stdout_eq(_VEC_INT_BASIC, "vec-int-ok\n")
    end

    it("parallel Vec<Int>-returning goroutines under multi-worker scheduler (sched_init(0))") do ->
      assert_run_stdout_eq(_VEC_INT_PARALLEL, "vec-parallel-ok\n")
    end

    it("100 sequential spawn+await cycles — per-task arenas freed eagerly between iterations") do ->
      assert_run_stdout_eq(_VEC_INT_LIFETIME, "vec-lifetime-ok\n")
    end

    it("Vec<Float> via the same 8-byte-stride promote helper (existential type uniformity)") do ->
      assert_run_stdout_eq(_VEC_FLOAT, "vec-float-ok\n")
    end
  end
  return qspec_main()
end
