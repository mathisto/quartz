## Leading Dot Continuation Tests
##
## Verifies that method-chaining across line breaks works correctly.
## The parser should allow:
##   x
##     .method()
##     .another()
##
## Contract:
##   1. Allows field access on.
##   2. Allows method call on.
##   3. Allows multi-line chaining.
##   4. Deeply indented chain works.
##   5. Mixed field and method.
##   6. Same-line dot still works.

import * from qspec

def main(): Int
  describe("leading dot continuation") do ->
    it("allows method call on next line") do ->
      assert_eq(dot_next_line(), 10)
    end

    it("allows multi-line chaining") do ->
      assert_eq(dot_multi_chain(), 14)
    end

    it("allows field access on next line") do ->
      assert_eq(dot_field_next_line(), 42)
    end

    it("works with UFCS method calls") do ->
      assert_eq(dot_ufcs_chain(), 3)
    end

    it("works after parenthesized expression") do ->
      assert_eq(dot_after_parens(), 14)
    end

    it("same-line dot still works") do ->
      assert_eq(dot_same_line(), 10)
    end

    it("deeply indented chain works") do ->
      assert_eq(dot_deep_chain(), 24)
    end

    it("mixed field and method access across lines") do ->
      assert_eq(dot_mixed_access(), 7)
    end
  end

  return qspec_main()
end

## Helper functions

def dot_u_double(x: Int): Int = x * 2
def dot_u_add_one(x: Int): Int = x + 1
def dot_u_triple(x: Int): Int = x * 3

struct DotPoint
  x: Int
  y: Int
end

def dot_u_sum(p: DotPoint): Int = p.x + p.y

## Test: basic leading dot on next line
def dot_next_line(): Int
  var result = 5
    .dot_u_double()
  return result
end

## Test: multi-line chain with 3 calls
def dot_multi_chain(): Int
  return 2
    .dot_u_double()
    .dot_u_triple()
    .dot_u_add_one()
    .dot_u_add_one()
end

## Test: field access on next line
def dot_field_next_line(): Int
  var p = DotPoint { x: 42, y: 99 }
  var val = p
    .x
  return val
end

## Test: UFCS method chain (vec operations)
def dot_ufcs_chain(): Int
  var v = vec_new()
  v.push(10)
  v
    .push(20)
  v
    .push(30)
  return v.size
end

## Test: leading dot after parenthesized expression
def dot_after_parens(): Int
  return (3 + 4)
    .dot_u_double()
end

## Test: same-line dot still works (regression)
def dot_same_line(): Int
  return 5.dot_u_double()
end

## Test: deeply indented chain
def dot_deep_chain(): Int
  return 1
    .dot_u_add_one()
    .dot_u_double()
    .dot_u_add_one()
    .dot_u_double()
    .dot_u_add_one()
    .dot_u_double()
    .dot_u_add_one()
    .dot_u_add_one()
end

## Test: mixed field access and method calls
def dot_mixed_access(): Int
  var p = DotPoint { x: 3, y: 4 }
  return p
    .dot_u_sum()
end
