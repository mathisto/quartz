## Cookie Spec — Tests for cookie parsing and setting
##
## Tests request_cookie, request_has_cookie, set_cookie, delete_cookie
## using manually constructed Request/Response structs.

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers — construct Request with Cookie header
# =============================================================================

def make_req_with_cookie(cookie_header: String): Request
  var hkeys = vec_new<String>()
  var hvals = vec_new<String>()
  hkeys.push("Cookie")
  hvals.push(cookie_header)
  return Request {
    method: "GET", path: "/", query_string: "", body: "",
    raw_path: "/",
    header_keys: hkeys, header_vals: hvals,
    params: map_new(), query: map_new(), context: map_new()
  }
end

# =============================================================================
# Test helpers
# =============================================================================

def print_cookie_basic(): Void
  var req = make_req_with_cookie("session=abc123")
  puts(request_cookie(req, "session"))
end

def print_cookie_multiple(): Void
  var req = make_req_with_cookie("session=abc; theme=dark; lang=en")
  puts(request_cookie(req, "theme"))
end

def print_cookie_missing(): Void
  var req = make_req_with_cookie("session=abc")
  var result = request_cookie(req, "missing")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_cookie_no_header(): Void
  var req = empty_request()
  var result = request_cookie(req, "session")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_has_cookie_true(): Void
  var req = make_req_with_cookie("session=abc; theme=dark")
  if request_has_cookie(req, "theme")
    puts("true")
  else
    puts("false")
  end
end

def print_has_cookie_false(): Void
  var req = make_req_with_cookie("session=abc")
  if request_has_cookie(req, "missing")
    puts("true")
  else
    puts("false")
  end
end

def print_set_cookie_basic(): Void
  var resp = text_response("ok")
  var opts = cookie_opts()
  resp = set_cookie(resp, "session", "abc123", opts)
  # Check that Set-Cookie header was added
  puts(resp.extra_header_keys[0])
  puts(resp.extra_header_vals[0])
end

def print_set_cookie_attrs(): Void
  var resp = text_response("ok")
  var opts = cookie_opts()
  opts.http_only = 1
  opts.secure = 1
  opts.max_age = 3600
  opts.same_site = "Strict"
  resp = set_cookie(resp, "token", "xyz", opts)
  puts(resp.extra_header_vals[0])
end

def print_delete_cookie(): Void
  var resp = text_response("ok")
  resp = delete_cookie(resp, "session")
  var header = resp.extra_header_vals[0]
  # Should contain Max-Age=-1
  puts(header)
end

def print_cookie_encoded_value(): Void
  var req = make_req_with_cookie("data=hello%20world")
  puts(request_cookie(req, "data"))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("request_cookie") do ->
    it("reads a single cookie") do ->
      assert_output("abc123\n", print_cookie_basic)
    end

    it("reads cookie from multiple cookies") do ->
      assert_output("dark\n", print_cookie_multiple)
    end

    it("returns empty for missing cookie") do ->
      assert_output("empty\n", print_cookie_missing)
    end

    it("returns empty when no Cookie header") do ->
      assert_output("empty\n", print_cookie_no_header)
    end

    it("decodes percent-encoded cookie value") do ->
      assert_output("hello world\n", print_cookie_encoded_value)
    end
  end

  describe("request_has_cookie") do ->
    it("returns true for existing cookie") do ->
      assert_output("true\n", print_has_cookie_true)
    end

    it("returns false for missing cookie") do ->
      assert_output("false\n", print_has_cookie_false)
    end
  end

  describe("set_cookie") do ->
    it("adds Set-Cookie header with defaults") do ->
      assert_output("Set-Cookie\nsession=abc123; Path=/; SameSite=Lax\n", print_set_cookie_basic)
    end

    it("includes all attributes") do ->
      assert_output("token=xyz; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Strict\n", print_set_cookie_attrs)
    end
  end

  describe("delete_cookie") do ->
    it("sets Max-Age=-1") do ->
      assert_output_contains("Max-Age=-1", print_delete_cookie)
    end
  end

  return qspec_main()
end
