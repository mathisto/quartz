## v0.3.2 Step 2 — strip_styles behavior tests
##
## Contract:
##   - empty string passes through unchanged
##   - plain text passes through unchanged
##   - simple SGR (color, reset) is stripped
##   - multi-arg SGR (bold + color) is stripped
##   - cursor positioning (H, J, K) is stripped
##   - mixed text + escapes preserves text in order
##   - lone ESC byte is dropped (defensive)

import * from qspec
import std/tui/layout as ly

def test_empty_passthrough(): Void
  assert_eq_str(ly::strip_styles(""), "")
end

def test_plain_text_passthrough(): Void
  assert_eq_str(ly::strip_styles("hello world"), "hello world")
end

def test_simple_sgr_stripped(): Void
  # \x1b[31mhello\x1b[0m → "hello"
  var input = "\x1b[31mhello\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "hello")
end

def test_multi_arg_sgr_stripped(): Void
  # \x1b[1;31;42mtext\x1b[0m → "text"
  var input = "\x1b[1;31;42mtext\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "text")
end

def test_truecolor_sgr_stripped(): Void
  # 24-bit foreground: \x1b[38;2;255;128;0mORANGE\x1b[0m
  var input = "\x1b[38;2;255;128;0mORANGE\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "ORANGE")
end

def test_cursor_positioning_stripped(): Void
  # \x1b[H = cursor home; \x1b[2J = clear screen.
  var input = "\x1b[H\x1b[2Jhello"
  assert_eq_str(ly::strip_styles(input), "hello")
end

def test_mixed_preserves_text_order(): Void
  # "[" + RED + "hello" + RESET + " " + GREEN + "world" + RESET + "]"
  var input = "[\x1b[31mhello\x1b[0m \x1b[32mworld\x1b[0m]"
  assert_eq_str(ly::strip_styles(input), "[hello world]")
end

def test_unicode_passthrough_when_styled(): Void
  # CJK + emoji should survive style stripping intact.
  var input = "\x1b[1m中\x1b[0m \x1b[32m🍪\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "中 🍪")
end

def test_lone_esc_is_dropped(): Void
  # ESC alone (not followed by `[`) — drop the ESC byte, keep rest.
  var input = "before\x1bafter"
  assert_eq_str(ly::strip_styles(input), "beforeafter")
end

def test_consecutive_sgr_stripped(): Void
  # Back-to-back style codes with no text between them.
  var input = "\x1b[1m\x1b[31m\x1b[42mboom\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "boom")
end

def test_newlines_preserved(): Void
  # Newlines are not part of SGR — they must survive.
  var input = "\x1b[31mline1\x1b[0m\nline2\n\x1b[32mline3\x1b[0m"
  assert_eq_str(ly::strip_styles(input), "line1\nline2\nline3")
end

def test_trailing_styled_no_reset(): Void
  # Style applied at the end with no reset — strip cleanly anyway.
  var input = "plain\x1b[31mred"
  assert_eq_str(ly::strip_styles(input), "plainred")
end

def main(): Int
  describe("strip_styles passthrough") do ->
    it("empty string") do ->
      test_empty_passthrough()
    end
    it("plain text") do ->
      test_plain_text_passthrough()
    end
    it("text with newlines") do ->
      test_newlines_preserved()
    end
  end

  describe("strip_styles SGR") do ->
    it("simple color + reset") do ->
      test_simple_sgr_stripped()
    end
    it("multi-arg SGR") do ->
      test_multi_arg_sgr_stripped()
    end
    it("24-bit truecolor SGR") do ->
      test_truecolor_sgr_stripped()
    end
    it("consecutive SGR codes") do ->
      test_consecutive_sgr_stripped()
    end
    it("trailing styled with no reset") do ->
      test_trailing_styled_no_reset()
    end
  end

  describe("strip_styles cursor / erase") do ->
    it("cursor home + clear screen") do ->
      test_cursor_positioning_stripped()
    end
  end

  describe("strip_styles mixed content") do ->
    it("preserves text order across multiple SGR pairs") do ->
      test_mixed_preserves_text_order()
    end
    it("preserves CJK + emoji codepoints") do ->
      test_unicode_passthrough_when_styled()
    end
  end

  describe("strip_styles defensive") do ->
    it("drops lone ESC byte") do ->
      test_lone_esc_is_dropped()
    end
  end

  return qspec_main()
end
