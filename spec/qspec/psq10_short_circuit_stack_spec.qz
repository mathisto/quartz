## PSQ-10 regression: `and`/`or` short-circuit lowering must not heap-alloc.
##
## Origin: KERN.3a virtio-net wait loop, Apr 18 2026.
## A tight poll loop with `and` as its condition dripped one 8-byte
## malloc per iteration — 200_000_000 spins ≈ 1.5 GiB of heap, which
## OOM-killed the freestanding kernel in milliseconds.
##
## Fix (Apr 19 2026): use `mir_emit_alloc_stack(1, "")` instead of
## `mir_emit_alloc(1)` in `mir_lower_expr_handlers.qz` for OP_AND /
## OP_OR. The escape analyzer proves the result slot is function-local,
## so it lowers to a single fn-entry alloca reused across iterations.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("PSQ-10 — short-circuit and/or uses stack slot, not heap") do ->

    it("`and` in loop condition does not heap-alloc per iteration") do ->
      # Compile a loop that evaluates `and` 1000 times in its condition.
      # Verify the generated IR has exactly one alloca for the result
      # slot (hoisted to fn entry) and no `call .* @malloc` inside the
      # while_cond/while_body blocks. A regression would re-introduce
      # the per-iter `malloc(8)`.
      var r = subprocess_compile("""
        def main(): Int
          var i = 0
          var stop = 1000
          var x = 0
          while x == 0 and i < stop
            i = i + 1
          end
          return i
        end
      """)
      _inc_assertions()
      if r.exit_code != 0
        _record_failure("compile failed: #{r.stderr_content}")
        return
      end
      # Extract the qz_main body from IR, check no malloc inside.
      # stdout is IR when subprocess_compile is used without -o; we look
      # at r.stdout_content lines between `define .* @qz_main(` and the
      # matching `^}`.
      var ir = r.stdout_content
      var in_main = 0
      var malloc_count = 0
      var alloca_count = 0
      var lines = str_split(ir, "\n")
      for line in lines
        if str_contains(line, "define ") and str_contains(line, "@qz_main(")
          in_main = 1
          continue
        end
        if in_main == 1
          if str_starts_with(line, "}")
            in_main = 0
            continue
          end
          if str_contains(line, "call") and str_contains(line, "@malloc(")
            malloc_count = malloc_count + 1
          end
          if str_contains(line, " = alloca ")
            alloca_count = alloca_count + 1
          end
        end
      end
      assert_eq(malloc_count, 0)
      # There should be at least one alloca (for the result slot plus
      # locals like i, stop, x). 4+ expected; just assert > 0.
      if alloca_count < 1
        _record_failure("expected >=1 alloca in qz_main, got #{str_from_int(alloca_count)}")
      end
    end

    it("`or` in loop condition does not heap-alloc per iteration") do ->
      var r = subprocess_compile("""
        def main(): Int
          var i = 0
          var stop = 1000
          var found = 0
          while found == 1 or i < stop
            i = i + 1
          end
          return i
        end
      """)
      _inc_assertions()
      if r.exit_code != 0
        _record_failure("compile failed: #{r.stderr_content}")
        return
      end
      var ir = r.stdout_content
      var in_main = 0
      var malloc_count = 0
      var lines = str_split(ir, "\n")
      for line in lines
        if str_contains(line, "define ") and str_contains(line, "@qz_main(")
          in_main = 1
          continue
        end
        if in_main == 1
          if str_starts_with(line, "}")
            in_main = 0
            continue
          end
          if str_contains(line, "call") and str_contains(line, "@malloc(")
            malloc_count = malloc_count + 1
          end
        end
      end
      assert_eq(malloc_count, 0)
    end

    it("and/or still short-circuit correctly (no semantic regression)") do ->
      # Verify short-circuit still works: RHS should NOT evaluate when
      # LHS determines the answer. We detect this via a function with
      # a side effect (increments a global) — if `false and side()`
      # evaluated `side`, the counter would be 1.
      assert_run_exits("""
        var counter = 0
        def side(): Int
          counter = counter + 1
          return 1
        end
        def main(): Int
          # `false and side()` — RHS must NOT run
          var a = 0
          if a == 1 and side() == 1
            return 99
          end
          # `true or side()` — RHS must NOT run
          var b = 1
          if b == 1 or side() == 1
            return counter
          end
          return 99
        end
      """, 0)
    end
  end

  return qspec_main()
end
