## String Interner Tests
##
## Tests for the string interning infrastructure.
## Since self-hosted/shared is not in the QSpec include path,
## the interner is defined inline here for testing.
##
## Contract:
##   1. Intern construction.
##   2. Intern deduplication.
##   3. Intern resolve.
##   4. Intern_eq.
##   5. Intern count.
##   6. Bulk interning.

import * from qspec

# ---- Inline StringInterner (copy of shared/string_intern.qz) ----

newtype InternId = Int

struct StringInterner
  strings: Vec<String>
  lookup: Map<String, Int>
end

def si_new(): StringInterner
  var interner = StringInterner {
    strings: vec_new<String>(),
    lookup: map_new<String, Int>()
  }
  si_intern(interner, "")
  return interner
end

def si_intern(interner: StringInterner, s: String): InternId
  match interner.lookup.get(s)
    Some(existing_id) => return existing_id
    _ => {}
  end
  if interner.strings.size > 0 and s == ""
    return 0
  end
  var id = interner.strings.size
  interner.strings.push(s)
  interner.lookup.set(s, id)
  return id
end

def si_resolve(interner: StringInterner, id: InternId): String
  return interner.strings[id]
end

def si_eq(a: InternId, b: InternId): Int
  if a == b
    return 1
  end
  return 0
end

def si_count(interner: StringInterner): Int
  return interner.strings.size
end

# ---- Tests ----

def main(): Int
  describe("intern construction") do ->
    it("creates interner with empty string at ID 0") do ->
      var interner = si_new()
      var empty_id = si_intern(interner, "")
      assert_eq(empty_id, 0)
    end

    it("pre-interns keywords with stable IDs") do ->
      var interner = si_new()
      si_intern(interner, "def")
      si_intern(interner, "end")
      var def_id = si_intern(interner, "def")
      var end_id = si_intern(interner, "end")
      assert(def_id > 0)
      assert(end_id > 0)
      assert(def_id != end_id)
    end
  end

  describe("intern deduplication") do ->
    it("returns same ID for same string") do ->
      var interner = si_new()
      var id1 = si_intern(interner, "hello")
      var id2 = si_intern(interner, "hello")
      assert_eq(id1, id2)
    end

    it("returns different IDs for different strings") do ->
      var interner = si_new()
      var id1 = si_intern(interner, "foo")
      var id2 = si_intern(interner, "bar")
      assert(id1 != id2)
    end

    it("handles empty string correctly") do ->
      var interner = si_new()
      var id = si_intern(interner, "")
      assert_eq(id, 0)
    end
  end

  describe("intern resolve") do ->
    it("resolves interned string back to original") do ->
      var interner = si_new()
      var id = si_intern(interner, "test_string")
      var resolved = si_resolve(interner, id)
      assert_eq_str(resolved, "test_string")
    end

    it("resolves empty string at ID 0") do ->
      var interner = si_new()
      var resolved = si_resolve(interner, 0)
      assert_eq_str(resolved, "")
    end

    it("round-trips builtin type names") do ->
      var interner = si_new()
      var id = si_intern(interner, "Int")
      assert_eq_str(si_resolve(interner, id), "Int")
    end
  end

  describe("intern_eq") do ->
    it("returns 1 for same-string IDs") do ->
      var interner = si_new()
      var id1 = si_intern(interner, "same")
      var id2 = si_intern(interner, "same")
      assert_eq(si_eq(id1, id2), 1)
    end

    it("returns 0 for different-string IDs") do ->
      var interner = si_new()
      var id1 = si_intern(interner, "one")
      var id2 = si_intern(interner, "two")
      assert_eq(si_eq(id1, id2), 0)
    end
  end

  describe("intern count") do ->
    it("starts with 1 for empty string") do ->
      var interner = si_new()
      assert_eq(si_count(interner), 1)
    end

    it("grows when new strings are interned") do ->
      var interner = si_new()
      var before = si_count(interner)
      si_intern(interner, "brand_new_xyz")
      assert_eq(si_count(interner), before + 1)
    end

    it("does not grow for duplicate strings") do ->
      var interner = si_new()
      si_intern(interner, "dup")
      var before = si_count(interner)
      si_intern(interner, "dup")
      assert_eq(si_count(interner), before)
    end
  end

  describe("bulk interning") do ->
    it("handles many unique strings") do ->
      var interner = si_new()
      si_intern(interner, "alpha")
      si_intern(interner, "beta")
      si_intern(interner, "gamma")
      si_intern(interner, "delta")
      si_intern(interner, "epsilon")
      si_intern(interner, "zeta")
      si_intern(interner, "eta")
      si_intern(interner, "theta")
      si_intern(interner, "iota")
      si_intern(interner, "kappa")
      var id_a = si_intern(interner, "alpha")
      var id_k = si_intern(interner, "kappa")
      assert_eq_str(si_resolve(interner, id_a), "alpha")
      assert_eq_str(si_resolve(interner, id_k), "kappa")
      assert(id_a != id_k)
    end
  end

  return qspec_main()
end
