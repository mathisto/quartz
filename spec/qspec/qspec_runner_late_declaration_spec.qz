import * from qspec
import * from qspec/subprocess

def run_late_declaration_inner(): Void
  var result = subprocess_run(read_file("spec/qspec/runner_fixtures/framework_late_declaration_inner.qz"))
  if result.exit_code != 0
    puts("isolated late-declaration framework harness failed: " + result.stderr_content + result.stdout_content)
  end
  assert_eq(result.exit_code, 0)
end

def main(): Int
  describe("QSpec late-declaration framework harness") do ->
    it("cannot suppress or fabricate the outer machine result", run_late_declaration_inner)
  end
  return qspec_main()
end
