## Drop trait (RAII) tests
## All Drop tests use subprocess since impl Drop requires self-hosted compiler

import * from qspec
import * from qspec/subprocess

struct DropPlain
  x: Int
end

struct DropNonDroppable
  value: Int
end

def main(): Int
  describe("Drop trait (RAII)") do ->
    it("calls drop at end of scope") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Foo
          x: Int
        end
        extend Foo with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def main(): Int
          f = Foo { x: 1 }
          puts("alive")
          return 0
        end
        """, "alive\ndropped\n")
    end

    it("calls drop before return") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            puts("cleaned")
          end
        end
        def work(): Int
          r = Res { x: 5 }
          return 42
        end
        def main(): Int
          work()
          puts("done")
          return 0
        end
        """, "cleaned\ndone\n")
    end

    it("calls drop on early return") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Guard
          x: Int
        end
        extend Guard with Drop
          def drop(self: Int): Void
            puts("guard dropped")
          end
        end
        def maybe(flag: Int): Int
          g = Guard { x: 1 }
          if flag == 1
            return 10
          end
          return 20
        end
        def main(): Int
          maybe(1)
          puts("after")
          return 0
        end
        """, "guard dropped\nafter\n")
    end

    it("calls drop in reverse order (LIFO)") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct A
          x: Int
        end
        struct B
          x: Int
        end
        extend A with Drop
          def drop(self: Int): Void
            puts("drop A")
          end
        end
        extend B with Drop
          def drop(self: Int): Void
            puts("drop B")
          end
        end
        def main(): Int
          a = A { x: 1 }
          b = B { x: 2 }
          return 0
        end
        """, "drop B\ndrop A\n")
    end

    it("drops inner scope before outer") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Outer
          x: Int
        end
        struct Inner
          x: Int
        end
        extend Outer with Drop
          def drop(self: Int): Void
            puts("outer")
          end
        end
        extend Inner with Drop
          def drop(self: Int): Void
            puts("inner")
          end
        end
        def main(): Int
          o = Outer { x: 1 }
          if 1
            n = Inner { x: 2 }
          end
          puts("after")
          return 0
        end
        """, "inner\nafter\nouter\n")
    end

    it("handles multiple nested scopes") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct L1
          x: Int
        end
        struct L2
          x: Int
        end
        struct L3
          x: Int
        end
        extend L1 with Drop
          def drop(self: Int): Void
            puts("L1")
          end
        end
        extend L2 with Drop
          def drop(self: Int): Void
            puts("L2")
          end
        end
        extend L3 with Drop
          def drop(self: Int): Void
            puts("L3")
          end
        end
        def main(): Int
          a = L1 { x: 1 }
          if 1
            b = L2 { x: 2 }
            if 1
              c = L3 { x: 3 }
            end
          end
          return 0
        end
        """, "L3\nL2\nL1\n")
    end

    it("drops at end of each loop iteration") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Iter
          x: Int
        end
        extend Iter with Drop
          def drop(self: Int): Void
            puts("iter drop")
          end
        end
        def main(): Int
          var i = 0
          while i < 3
            t = Iter { x: i }
            i = i + 1
          end
          return 0
        end
        """, "iter drop\niter drop\niter drop\n")
    end

    it("drops on break") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Iter
          x: Int
        end
        extend Iter with Drop
          def drop(self: Int): Void
            puts("iter drop")
          end
        end
        def main(): Int
          var i = 0
          while i < 5
            t = Iter { x: i }
            i = i + 1
            if i == 2
              break
            end
          end
          return 0
        end
        """, "iter drop\niter drop\n")
    end

    it("drops on continue") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Iter
          x: Int
        end
        extend Iter with Drop
          def drop(self: Int): Void
            puts("iter drop")
          end
        end
        def main(): Int
          var i = 0
          while i < 3
            t = Iter { x: i }
            i = i + 1
            if i == 2
              continue
            end
          end
          return 0
        end
        """, "iter drop\niter drop\niter drop\n")
    end

    it("no drop for types without Drop impl") do ->
      assert_output("42\n", drop_non_droppable)
    end

    it("mixes droppable and non-droppable") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Tracked
          x: Int
        end
        struct Plain
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            puts("tracked")
          end
        end
        def main(): Int
          p = Plain { x: 1 }
          t = Tracked { x: 2 }
          puts("ok")
          return 0
        end
        """, "ok\ntracked\n")
    end

    it("allows defining Drop trait") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int = 0
        """, 0)
    end

    it("drops before jumping to match exit") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct MGuard
          x: Int
        end
        extend MGuard with Drop
          def drop(self: Int): Void
            puts("guard drop")
          end
        end
        def main(): Int
          g = MGuard { x: 1 }
          r = match g.x
            1 => 42
            _ => 0
          end
          return r
        end
        """, "guard drop\n")
    end

    it("drops on early return via match") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct ResGuard
          x: Int
        end
        extend ResGuard with Drop
          def drop(self: Int): Void
            puts("res drop")
          end
        end
        def maybe_fail(flag: Int): Int
          g = ResGuard { x: 1 }
          match flag
            0 => return 10
            _ => return 20
          end
          return 30
        end
        def main(): Int
          maybe_fail(0)
          puts("after")
          return 0
        end
        """, "res drop\nafter\n")
    end

    it("drops nested fields with Drop impl") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Inner
          x: Int
        end
        struct Outer
          inner: Inner
          y: Int
        end
        extend Inner with Drop
          def drop(self: Int): Void
            puts("inner dropped")
          end
        end
        def main(): Int
          o = Outer { inner: Inner { x: 1 }, y: 2 }
          return 0
        end
        """, "inner dropped\n")
    end

    it("drops deeply nested fields") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct L3
          x: Int
        end
        struct L2
          inner: L3
        end
        struct L1
          inner: L2
          y: Int
        end
        extend L3 with Drop
          def drop(self: Int): Void
            puts("L3 dropped")
          end
        end
        def main(): Int
          o = L1 { inner: L2 { inner: L3 { x: 1 } }, y: 2 }
          return 0
        end
        """, "L3 dropped\n")
    end

    it("defer interacts with Drop") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct DGuard
          x: Int
        end
        extend DGuard with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def main(): Int
          g = DGuard { x: 1 }
          defer puts("deferred")
          puts("alive")
          return 0
        end
        """, "alive\ndeferred\ndropped\n")
    end

    it("drops match arm locals exactly once") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct AG
          x: Int
        end
        extend AG with Drop
          def drop(self: Int): Void
            puts("ag drop")
          end
        end
        def main(): Int
          var x = 1
          match x
            1 =>
              g = AG { x: 10 }
              puts("arm 1")
            _ =>
              puts("default")
          end
          puts("after")
          return 0
        end
        """, "arm 1\nag drop\nafter\n")
    end

    it("drops match arm locals in non-first arm") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct BG
          x: Int
        end
        extend BG with Drop
          def drop(self: Int): Void
            puts("bg drop")
          end
        end
        def main(): Int
          var x = 2
          match x
            1 =>
              puts("arm 1")
            2 =>
              g = BG { x: 20 }
              puts("arm 2")
            _ =>
              puts("default")
          end
          puts("after")
          return 0
        end
        """, "arm 2\nbg drop\nafter\n")
    end

    it("drops match arm locals with outer droppable") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct OG
          x: Int
        end
        extend OG with Drop
          def drop(self: Int): Void
            puts("og drop")
          end
        end
        def main(): Int
          outer = OG { x: 99 }
          var x = 1
          match x
            1 =>
              inner = OG { x: 10 }
              puts("arm 1")
            _ =>
              puts("default")
          end
          puts("after")
          return 0
        end
        """, "arm 1\nog drop\nafter\nog drop\n")
    end

    it("drops both outer and inner in nested struct") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct InnerD
          x: Int
        end
        struct OuterD
          inner: InnerD
          y: Int
        end
        extend InnerD with Drop
          def drop(self: Int): Void
            puts("inner")
          end
        end
        extend OuterD with Drop
          def drop(self: Int): Void
            puts("outer")
          end
        end
        def main(): Int
          o = OuterD { inner: InnerD { x: 1 }, y: 2 }
          puts("alive")
          return 0
        end
        """, "alive\nouter\ninner\n")
    end

    it("drops multiple droppable fields") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Lk
          id: Int
        end
        struct Hd
          fd: Int
        end
        struct Rsrc
          lock: Lk
          handle: Hd
          name: Int
        end
        extend Lk with Drop
          def drop(self: Int): Void
            puts("lock")
          end
        end
        extend Hd with Drop
          def drop(self: Int): Void
            puts("handle")
          end
        end
        def main(): Int
          r = Rsrc { lock: Lk { id: 1 }, handle: Hd { fd: 42 }, name: 0 }
          puts("using")
          return 0
        end
        """, "using\nlock\nhandle\n")
    end

    it("drops only arm-local on return in match arm") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct RG
          x: Int
        end
        extend RG with Drop
          def drop(self: Int): Void
            puts("rg drop")
          end
        end
        def work(val: Int): Int
          match val
            1 =>
              g = RG { x: 10 }
              return 1
            2 =>
              g2 = RG { x: 20 }
              return 2
            _ =>
              return 0
          end
          return 99
        end
        def main(): Int
          work(1)
          puts("---")
          work(2)
          puts("---")
          work(99)
          return 0
        end
        """, "rg drop\n---\nrg drop\n---\n")
    end

    it("drops wildcard arm locals exactly once") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct WG
          x: Int
        end
        extend WG with Drop
          def drop(self: Int): Void
            puts("wg drop")
          end
        end
        def main(): Int
          var x = 99
          match x
            1 =>
              puts("arm 1")
            _ =>
              g = WG { x: 50 }
              puts("wildcard")
          end
          puts("after")
          return 0
        end
        """, "wildcard\nwg drop\nafter\n")
    end

    it("drops on implicit void return") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct IR
          x: Int
        end
        extend IR with Drop
          def drop(self: Int): Void
            puts("implicit drop")
          end
        end
        def work(): Void
          g = IR { x: 1 }
          puts("working")
        end
        def main(): Int
          work()
          puts("done")
          return 0
        end
        """, "working\nimplicit drop\ndone\n")
    end

    it("drops old value on reassignment") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct RD
          x: Int
        end
        extend RD with Drop
          def drop(self: Int): Void
            puts("drop RD")
          end
        end
        def main(): Int
          var g = RD { x: 1 }
          g = RD { x: 2 }
          return 0
        end
        """, "drop RD\ndrop RD\n")
    end

    it("drops parameter struct at function exit") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct PD
          x: Int
        end
        extend PD with Drop
          def drop(self: Int): Void
            puts("param drop")
          end
        end
        def consume(p: PD): Int
          puts("using")
          return p.x
        end
        def main(): Int
          var r = consume(PD { x: 42 })
          puts("done")
          return 0
        end
        """, "using\nparam drop\ndone\n")
    end

    it("defers and drops interleave on implicit return") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct ID
          x: Int
        end
        extend ID with Drop
          def drop(self: Int): Void
            puts("drop")
          end
        end
        def work(): Void
          defer puts("defer 1")
          g = ID { x: 1 }
          defer puts("defer 2")
          puts("working")
        end
        def main(): Int
          work()
          return 0
        end
        """, "working\ndefer 2\ndefer 1\ndrop\n")
    end

    it("defer + drop + reassignment") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct RR
          x: Int
        end
        extend RR with Drop
          def drop(self: Int): Void
            puts("drop RR")
          end
        end
        def work(): Int
          defer puts("cleanup")
          var g = RR { x: 1 }
          g = RR { x: 2 }
          return 0
        end
        def main(): Int
          work()
          return 0
        end
        """, "cleanup\ndrop RR\ndrop RR\n")
    end

    it("drop in for-in range loop") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct FL
          x: Int
        end
        extend FL with Drop
          def drop(self: Int): Void
            puts("fl drop")
          end
        end
        def main(): Int
          for i in 0..3
            t = FL { x: i }
          end
          puts("done")
          return 0
        end
        """, "fl drop\nfl drop\nfl drop\ndone\n")
    end

    it("drops old value on reassignment multiple times") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct RD2
          x: Int
        end
        extend RD2 with Drop
          def drop(self: Int): Void
            puts("drop RD2")
          end
        end
        def main(): Int
          var g = RD2 { x: 1 }
          g = RD2 { x: 2 }
          g = RD2 { x: 3 }
          return 0
        end
        """, "drop RD2\ndrop RD2\ndrop RD2\n")
    end

    it("lambda does not double-drop parent droppable vars") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct LG
          x: Int
        end
        extend LG with Drop
          def drop(self: Int): Void
            puts("lg drop")
          end
        end
        def apply(f: Fn(): Int): Int = f()
        def main(): Int
          g = LG { x: 1 }
          var r = apply(-> 42)
          puts("done")
          return 0
        end
        """, "done\nlg drop\n")
    end

    it("mem_forget suppresses drop") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct MF
          x: Int
        end
        extend MF with Drop
          def drop(self: Int): Void
            puts("mf drop")
          end
        end
        def main(): Int
          a = MF { x: 1 }
          b = MF { x: 2 }
          mem_forget(a)
          puts("done")
          return 0
        end
        """, "done\nmf drop\n")
    end

    it("mem_forget only affects specified variable") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct MF2
          x: Int
        end
        extend MF2 with Drop
          def drop(self: Int): Void
            puts("mf2 drop")
          end
        end
        def main(): Int
          a = MF2 { x: 1 }
          b = MF2 { x: 2 }
          c = MF2 { x: 3 }
          mem_forget(b)
          return 0
        end
        """, "mf2 drop\nmf2 drop\n")
    end
  end
  return qspec_main()
end

def drop_non_droppable(): Void
  var p = DropPlain { x: 42 }
  print_int(p.x)
end
