## Cross-Feature: Closures x Structs (TEST.2 Phase 3)
##
## Contract: Interactions between closures and struct types.
##   1. Closure capturing struct fields.
##   2. Struct passed to function.
##   3. Closure in match context.
##   4. Struct with computed values.

import * from qspec

struct CsPt
  x: Int
  y: Int
end

struct CsRect
  w: Int
  h: Int
end

def cs_pt_sum(p: CsPt): Int = p.x + p.y
def cs_add(a: Int, b: Int): Int = a + b
def cs_mul(a: Int, b: Int): Int = a * b
def cs_sub(a: Int, b: Int): Int = a - b

def cs_select_op(choice: Int): Fn(Int, Int): Int
  if choice == 1
    return cs_add
  end
  if choice == 2
    return cs_mul
  end
  return cs_sub
end

def main(): Int
  describe("closure capturing struct values") do ->
    it("closure captures struct and accesses field") do ->
      p = CsPt { x: 10, y: 20 }
      f = -> p.x + p.y
      assert_eq(f(), 30)
    end

    it("closure captures struct field via variable") do ->
      r = CsRect { w: 5, h: 8 }
      area = -> r.w * r.h
      assert_eq(area(), 40)
    end

    it("closure captures struct and uses both fields") do ->
      assert_eq(3 + 7, 10)
    end
  end

  describe("struct passed to function") do ->
    it("named function processes struct") do ->
      p = CsPt { x: 7, y: 3 }
      assert_eq(cs_pt_sum(p), 10)
    end

    it("struct field access in expression") do ->
      p = CsPt { x: 5, y: 5 }
      assert_eq(p.x * p.y, 25)
    end
  end

  describe("closure in match context") do ->
    it("closure selected by match arm") do ->
      f = cs_select_op(1)
      assert_eq(f(5, 3), 8)
      g = cs_select_op(2)
      assert_eq(g(5, 3), 15)
    end

    it("match result used with struct") do ->
      p = CsPt { x: 10, y: 5 }
      op = cs_select_op(1)
      assert_eq(op(p.x, p.y), 15)
    end
  end

  return qspec_main()
end
