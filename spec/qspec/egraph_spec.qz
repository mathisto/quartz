## E-Graph Equality Saturation Tests
##
## Contract:
##   1. Multi-step reassociation: (x + 3) + 5 → x + 8.
##   2. Commutativity CSE: a + b and b + a deduplicated.
##   3. Strength reduction via GVN: x * 4 → x << 2.
##   4. Constant propagation chains.
##   5. Reassociation with multiplication.
##   6. Nested reassociation.
##   7. Self-compilation correctness (fixpoint).
##   8. E-graph extraction: multi-step constant fold via saturation.
##   9. Cross-block value preservation.
##  10. No regressions on variable-heavy programs.

import * from qspec

# --- Multi-step reassociation ---

def esat_reassoc_add(x: Int): Int = (x + 3) + 5

def esat_reassoc_sub(x: Int): Int = (x - 3) - 5

def esat_reassoc_mul(x: Int): Int = (x * 3) * 5

# --- Commutativity CSE ---

def esat_comm_helper(a: Int, b: Int): Int
  var x = a + b
  var y = b + a
  return x + y
end

def esat_comm_mul_helper(a: Int, b: Int): Int
  var x = a * b
  var y = b * a
  return x + y
end

# --- Strength reduction ---

def esat_str_red_4(x: Int): Int = x * 4
def esat_str_red_8(x: Int): Int = x * 8
def esat_str_red_16(x: Int): Int = x * 16

# --- Constant propagation chains ---

def esat_const_chain(): Int
  var a = 3
  var b = a + 2
  var c = b * 2
  return c
end

# --- Reassociation + constant fold ---

def esat_add_triple(x: Int): Int
  var t1 = x + 10
  var t2 = t1 + 20
  return t2
end

# --- E-graph extraction: multi-step fold via saturation ---

# (a + 2) + (b + 3) where a=5, b=10 — saturation can reassociate + fold
def esat_extract_multi(a: Int, b: Int): Int
  var t1 = a + 2
  var t2 = b + 3
  return t1 + t2
end

# Nested reassociation: ((x + 1) + 2) + 3 → x + 6
def esat_extract_nested(x: Int): Int
  var t1 = x + 1
  var t2 = t1 + 2
  var t3 = t2 + 3
  return t3
end

# Cross-block value preservation: values defined outside block survive
def esat_cross_block(x: Int): Int
  var a = x + 5
  var b = 0
  if x > 0
    b = a + 10
  else
    b = a + 20
  end
  return b
end

# Variable-heavy: ensure multiple vars don't get corrupted
def esat_multi_var(): Int
  var a = 10
  var b = 20
  var c = 30
  var d = 40
  return a + b + c + d
end

# --- Phase 3: Dominator-aware extraction ---

# Sibling branches: same expression in non-dominating blocks must NOT be CSE'd
def esat_sibling_branches(x: Int): Int
  var a = 0
  var b = 0
  if x > 0
    a = x + 7
  else
    a = x + 7
  end
  return a
end

# Cross-block CSE: expression in entry block used in branch should survive
def esat_entry_cse(x: Int): Int
  var a = x * 3
  var b = 0
  if x > 10
    b = a + 1
  else
    b = a + 2
  end
  return b
end

# Deep reassociation: ((((x + 1) + 2) + 3) + 4) → x + 10
def esat_deep_reassoc(x: Int): Int
  var t1 = x + 1
  var t2 = t1 + 2
  var t3 = t2 + 3
  var t4 = t3 + 4
  return t4
end

# Many locals: stress test that optimizer doesn't corrupt unrelated vars
def esat_many_locals(): Int
  var a = 1
  var b = 2
  var c = 3
  var d = 4
  var e = 5
  var f = 6
  var g = 7
  var h = 8
  var sum = a + b + c + d + e + f + g + h
  return sum
end

# Strength reduction through branches: x * 8 in different blocks
def esat_str_red_branch(x: Int): Int
  var result = 0
  if x > 0
    result = x * 8
  else
    result = x * 16
  end
  return result
end

def print_sibling_pos(): Void = print_int(esat_sibling_branches(5))
def print_sibling_neg(): Void = print_int(esat_sibling_branches(-3))
def print_entry_cse_pos(): Void = print_int(esat_entry_cse(20))
def print_entry_cse_neg(): Void = print_int(esat_entry_cse(5))
def print_deep_reassoc(): Void = print_int(esat_deep_reassoc(100))
def print_many_locals(): Void = print_int(esat_many_locals())
def print_str_branch_pos(): Void = print_int(esat_str_red_branch(5))
def print_str_branch_neg(): Void = print_int(esat_str_red_branch(-3))

def print_reassoc_add(): Void = print_int(esat_reassoc_add(100))
def print_reassoc_sub(): Void = print_int(esat_reassoc_sub(100))
def print_reassoc_mul(): Void = print_int(esat_reassoc_mul(2))
def print_comm(): Void = print_int(esat_comm_helper(5, 3))
def print_comm_mul(): Void = print_int(esat_comm_mul_helper(5, 3))
def print_str4(): Void = print_int(esat_str_red_4(10))
def print_str8(): Void = print_int(esat_str_red_8(10))
def print_str16(): Void = print_int(esat_str_red_16(10))
def print_const_chain(): Void = print_int(esat_const_chain())
def print_add_triple(): Void = print_int(esat_add_triple(100))
def print_extract_multi(): Void = print_int(esat_extract_multi(5, 10))
def print_extract_nested(): Void = print_int(esat_extract_nested(100))
def print_cross_block_pos(): Void = print_int(esat_cross_block(5))
def print_cross_block_neg(): Void = print_int(esat_cross_block(-5))
def print_multi_var(): Void = print_int(esat_multi_var())

def main(): Int
  describe("multi-step reassociation") do ->
    it("reassociates (x + 3) + 5 to x + 8") do ->
      assert_output("108\n", print_reassoc_add)
    end

    it("reassociates (x - 3) - 5 to x - 8") do ->
      assert_output("92\n", print_reassoc_sub)
    end

    it("reassociates (x * 3) * 5 to x * 15") do ->
      assert_output("30\n", print_reassoc_mul)
    end

    it("folds (x + 10) + 20 to x + 30") do ->
      assert_output("130\n", print_add_triple)
    end
  end

  describe("commutativity CSE") do ->
    it("deduplicates a + b and b + a") do ->
      assert_output("16\n", print_comm)
    end

    it("deduplicates a * b and b * a") do ->
      assert_output("30\n", print_comm_mul)
    end
  end

  describe("strength reduction") do ->
    it("reduces x * 4 to x << 2") do ->
      assert_output("40\n", print_str4)
    end

    it("reduces x * 8 to x << 3") do ->
      assert_output("80\n", print_str8)
    end

    it("reduces x * 16 to x << 4") do ->
      assert_output("160\n", print_str16)
    end
  end

  describe("constant propagation") do ->
    it("propagates through chain: a=3, b=a+2, c=b*2 → 10") do ->
      assert_output("10\n", print_const_chain)
    end
  end

  describe("e-graph extraction") do ->
    it("folds (a+2) + (b+3) with a=5, b=10 to 20") do ->
      assert_output("20\n", print_extract_multi)
    end

    it("folds ((x+1)+2)+3 to x+6 via nested reassociation") do ->
      assert_output("106\n", print_extract_nested)
    end

    it("preserves cross-block values (positive branch)") do ->
      assert_output("20\n", print_cross_block_pos)
    end

    it("preserves cross-block values (negative branch)") do ->
      assert_output("20\n", print_cross_block_neg)
    end

    it("preserves multiple variables: 10+20+30+40=100") do ->
      assert_output("100\n", print_multi_var)
    end
  end

  describe("dominator-aware extraction") do ->
    it("sibling branches: same expr in non-dominating blocks (positive)") do ->
      assert_output("12\n", print_sibling_pos)
    end

    it("sibling branches: same expr in non-dominating blocks (negative)") do ->
      assert_output("4\n", print_sibling_neg)
    end

    it("cross-block: entry value used in true branch") do ->
      assert_output("61\n", print_entry_cse_pos)
    end

    it("cross-block: entry value used in false branch") do ->
      assert_output("17\n", print_entry_cse_neg)
    end

    it("deep reassociation: ((((x+1)+2)+3)+4) = x+10") do ->
      assert_output("110\n", print_deep_reassoc)
    end

    it("many locals: 1+2+3+4+5+6+7+8 = 36") do ->
      assert_output("36\n", print_many_locals)
    end

    it("strength reduction in true branch: 5*8 = 40") do ->
      assert_output("40\n", print_str_branch_pos)
    end

    it("strength reduction in false branch: -3*16 = -48") do ->
      assert_output("-48\n", print_str_branch_neg)
    end
  end

  return qspec_main()
end
