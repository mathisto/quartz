## Record Types Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("record types") do ->
    it("record type in function parameter") do ->
      assert_run_exits(rt_param_src(), 42)
    end

    it("record type in return type") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def make(): { x: Int }
          return Point { x: 42, y: 10 }
        end
        def main(): Int
          p = make()
          return p.x
        end
        """, 42)
    end

    it("width subtyping - extra fields OK") do ->
      assert_run_exits(rt_width_src(), 42)
    end

    it("merges two record types via &") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def get_xy(r: { x: Int } & { y: Int }): Int
          return r.x + r.y
        end
        def main(): Int
          p = Point { x: 20, y: 22 }
          return get_xy(p)
        end
        """, 42)
    end

    it("merges overlapping compatible fields") do ->
      assert_run_exits("""
        struct ABC
          a: Int
          b: Int
          c: Int
        end
        def get_abc(r: { a: Int, b: Int } & { b: Int, c: Int }): Int
          return r.a + r.b + r.c
        end
        def main(): Int
          p = ABC { a: 10, b: 12, c: 20 }
          return get_abc(p)
        end
        """, 42)
    end

    it("merges three record types via &") do ->
      assert_run_exits("""
        struct Vec3
          x: Int
          y: Int
          z: Int
        end
        def get_xyz(r: { x: Int } & { y: Int } & { z: Int }): Int
          return r.x + r.y + r.z
        end
        def main(): Int
          p = Vec3 { x: 10, y: 12, z: 20 }
          return get_xyz(p)
        end
        """, 42)
    end

    it("per-field type resolution - String field") do ->
      assert_run_exits(rt_string_field_src(), 5)
    end

    it("per-field type resolution - multiple typed fields") do ->
      assert_run_exits(rt_multi_field_src(), 42)
    end

    it("unknown field produces compile error") do ->
      assert_compile_error(rt_bad_field_src(), "has no field 'z'")
    end

    it("rejects struct missing a required record field (return position)") do ->
      assert_compile_error(rt_missing_field_return_src(), "missing field 'y'")
    end

    it("rejects struct field of wrong type into record (depth)") do ->
      assert_compile_error(rt_wrong_type_field_return_src(), "has type 'String', expected 'Int'")
    end

    it("record LET from >16B nominal source (direct) reads correct fields") do ->
      assert_run_exits(rt_let_bigsrc_src(), 42)
    end

    it("struct returned into narrower record (>16B width subtyping) reads correct field") do ->
      assert_run_exits(rt_return_width_src(), 7)
    end

    it("unannotated LET from record-returning call reads correct field") do ->
      assert_run_exits(rt_let_infer_call_src(), 7)
    end

    it("accepts struct literal with extra fields into narrower record param (arg-pass width)") do ->
      assert_run_exits(rt_argpass_accept_src(), 42)
    end

    it("rejects struct literal missing a required field into record param (arg-pass)") do ->
      assert_compile_error(rt_argpass_reject_missing_src(), "missing field 'y'")
    end

    it("rejects struct literal wrong-typed field into record param (arg-pass depth)") do ->
      assert_compile_error(rt_argpass_reject_wrongtype_src(), "has type 'String', expected 'Int'")
    end

    it("accepts struct literal with extra fields pushed into Vec<narrower record> (elem-store width)") do ->
      assert_run_exits(rt_push_accept_src(), 42)
    end

    it("rejects struct literal missing a required field pushed into Vec<record> (elem-store)") do ->
      assert_compile_error(rt_push_reject_missing_src(), "missing field 'y'")
    end

    it("rejects struct literal wrong-typed field pushed into Vec<record> (elem-store depth)") do ->
      assert_compile_error(rt_push_reject_wrongtype_src(), "has type 'String', expected 'Int'")
    end

    it("accepts struct VARIABLE with extra fields into record param (var-form width)") do ->
      assert_run_exits(rt_var_accept_src(), 42)
    end

    it("rejects struct VARIABLE missing a field into record param (var-form arg)") do ->
      assert_compile_error(rt_var_reject_arg_src(), "missing field 'y'")
    end

    it("rejects struct VARIABLE missing a field returned into record (var-form return)") do ->
      assert_compile_error(rt_var_reject_return_src(), "missing field 'y'")
    end

    it("rejects struct VARIABLE missing a field pushed into Vec<record> (var-form elem)") do ->
      assert_compile_error(rt_var_reject_push_src(), "missing field 'y'")
    end
  end
  return qspec_main()
end

def rt_var_accept_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def use_rec(r: { x: Int }): Int
    return r.x
  end
  def main(): Int
    var b = Point { x: 42, y: 10 }
    return use_rec(b)
  end
  """

def rt_var_reject_arg_src(): String = """
  struct Narrow
    x: Int
  end
  def use_rec(r: { x: Int, y: Int }): Int
    return r.x
  end
  def main(): Int
    var b = Narrow { x: 1 }
    return use_rec(b)
  end
  """

def rt_var_reject_return_src(): String = """
  struct Narrow
    x: Int
  end
  def make_rec(): { x: Int, y: Int }
    var b = Narrow { x: 1 }
    return b
  end
  def main(): Int
    var r = make_rec()
    return 0
  end
  """

def rt_var_reject_push_src(): String = """
  struct Narrow
    x: Int
  end
  def main(): Int
    var v: Vec<{ x: Int, y: Int }> = vec_new()
    var b = Narrow { x: 1 }
    v.push(b)
    return 0
  end
  """

def rt_argpass_accept_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def use_rec(r: { x: Int }): Int
    return r.x
  end
  def main(): Int
    return use_rec(Point { x: 42, y: 10 })
  end
  """

def rt_argpass_reject_missing_src(): String = """
  struct Narrow
    x: Int
  end
  def use_rec(r: { x: Int, y: Int }): Int
    return r.x
  end
  def main(): Int
    return use_rec(Narrow { x: 1 })
  end
  """

def rt_argpass_reject_wrongtype_src(): String = """
  struct Mistyped
    x: String
    y: Int
  end
  def use_rec(r: { x: Int, y: Int }): Int
    return r.x
  end
  def main(): Int
    return use_rec(Mistyped { x: "no", y: 2 })
  end
  """

def rt_push_accept_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def main(): Int
    var v: Vec<{ x: Int }> = vec_new()
    v.push(Point { x: 42, y: 10 })
    return v[0].x
  end
  """

def rt_push_reject_missing_src(): String = """
  struct Narrow
    x: Int
  end
  def main(): Int
    var v: Vec<{ x: Int, y: Int }> = vec_new()
    v.push(Narrow { x: 1 })
    return 0
  end
  """

def rt_push_reject_wrongtype_src(): String = """
  struct Mistyped
    x: String
    y: Int
  end
  def main(): Int
    var v: Vec<{ x: Int, y: Int }> = vec_new()
    v.push(Mistyped { x: "no", y: 2 })
    return 0
  end
  """

def rt_let_infer_call_src(): String = """
  struct Wide
    x: Int
    y: Int
    z: Int
  end
  def f(): { x: Int }
    return Wide { x: 7, y: 2, z: 3 }
  end
  def main(): Int
    var w = f()
    return w.x
  end
  """

def rt_let_bigsrc_src(): String = """
  struct Big3
    x: Int
    y: Int
    z: Int
  end
  def main(): Int
    var p: { x: Int, y: Int } = Big3 { x: 40, y: 2, z: 99 }
    return p.x + p.y
  end
  """

def rt_return_width_src(): String = """
  struct Wide
    x: Int
    y: Int
    z: Int
  end
  def f(): { x: Int }
    return Wide { x: 7, y: 2, z: 3 }
  end
  def main(): Int
    var r: { x: Int } = f()
    return r.x
  end
  """

def rt_wrong_type_field_return_src(): String = """
  struct Mistyped
    x: String
    y: Int
  end
  def rc(): { x: Int, y: Int }
    return Mistyped { x: "no", y: 2 }
  end
  def main(): Int
    n = rc()
    return 0
  end
  """

def rt_missing_field_return_src(): String = """
  struct Narrow
    x: Int
  end
  def rc(): { x: Int, y: Int }
    return Narrow { x: 1 }
  end
  def main(): Int
    n = rc()
    return 0
  end
  """

def rt_param_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_x(r: { x: Int }): Int
    return r.x
  end
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_x(p)
  end
  """

def rt_width_src(): String = """
  struct Point3D
    x: Int
    y: Int
    z: Int
  end
  def get_x(r: { x: Int }): Int
    return r.x
  end
  def main(): Int
    p = Point3D { x: 42, y: 10, z: 5 }
    return get_x(p)
  end
  """

def rt_string_field_src(): String = """
  struct Named
    name: String
    age: Int
  end
  def get_name(r: { name: String }): String
    return r.name
  end
  def main(): Int
    p = Named { name: "hello", age: 30 }
    return str_size(get_name(p))
  end
  """

def rt_multi_field_src(): String = """
  struct Pair
    x: Int
    y: Int
  end
  def sum_xy(r: { x: Int, y: Int }): Int
    return r.x + r.y
  end
  def main(): Int
    p = Pair { x: 20, y: 22 }
    return sum_xy(p)
  end
  """

def rt_bad_field_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  def get_z(r: { x: Int }): Int
    return r.z
  end
  def main(): Int
    p = Point { x: 42, y: 10 }
    return get_z(p)
  end
  """
