## Multi-line Struct Literals Tests
##
## Contract:
##   1. Trailing comma: multi-line struct with trailing comma.
##   2. No trailing: multi-line struct without trailing comma.
##   3. Single-line trailing: trailing comma on single line.
##   4. Nested: multi-line struct containing multi-line struct.
##   5. Field access: fields accessible after multi-line.
##   6. 3-field: multi-line struct with 3 fields.
##   7. Field mutation: field assignment after multi-line construction.
##   8. Computed fields: multi-line struct with computed field values.

import * from qspec

struct MLPoint
  x: Int
  y: Int
end

struct MLPoint3
  x: Int
  y: Int
  z: Int
end

struct MLInner
  value: Int
end

struct MLOuter
  inner: MLInner
  name: String
end

def main(): Int
  describe("with trailing commas") do ->
    it("parses multi-line struct with trailing comma") do ->
      assert_output("10\n20\n", ml_trailing_comma)
    end

    it("parses multi-line struct without trailing comma") do ->
      assert_output("6\n", ml_no_trailing_comma)
    end

    it("parses single-line struct with trailing comma") do ->
      assert_output("12\n", ml_single_line_trailing)
    end

    it("handles deeply nested multi-line structs") do ->
      assert_output("42\ntest\n", ml_nested)
    end

    it("field access after multi-line construction") do ->
      p = MLPoint {
        x: 21,
        y: 21,
      }
      assert_eq(p.x + p.y, 42)
    end

    it("3-field struct multi-line") do ->
      p = MLPoint3 {
        x: 10,
        y: 20,
        z: 12,
      }
      assert_eq(p.x + p.y + p.z, 42)
    end

    it("field mutation after multi-line construction") do ->
      var p = MLPoint {
        x: 10,
        y: 20,
      }
      p.x = 100
      assert_eq(p.x + p.y, 120)
    end

    it("computed fields in multi-line struct") do ->
      var a = 7
      p = MLPoint {
        x: a * 3,
        y: a * 3,
      }
      assert_eq(p.x + p.y, 42)
    end
  end

  return qspec_main()
end

def ml_trailing_comma(): Void
  p = MLPoint {
    x: 10,
    y: 20,
  }
  puts("#{p.x}")
  puts("#{p.y}")
end

def ml_no_trailing_comma(): Void
  p = MLPoint3 {
    x: 1,
    y: 2,
    z: 3
  }
  puts("#{p.x + p.y + p.z}")
end

def ml_single_line_trailing(): Void
  p = MLPoint { x: 5, y: 7, }
  puts("#{p.x + p.y}")
end

def ml_nested(): Void
  o = MLOuter {
    inner: MLInner {
      value: 42,
    },
    name: "test",
  }
  puts("#{o.inner.value}")
  puts(o.name)
end
