## QSpec coverage for Phase B.2 — `with TestAlloc do ... end`.
##
## TestAlloc is a bare-IDENT alias for an Alloc install backed by a
## singleton test arena. At install time, `test_alloc_arena_acquire()`
## lazy-creates the arena on first call and resets it on every
## subsequent call — sequential `with TestAlloc` blocks each see a
## fresh arena, with no leak across blocks.
##
## Typecheck: bare `TestAlloc` claims `Alloc` via the
## `tc_with_handler_begin` alias rule, so body code with `can Alloc`
## rows is satisfied without a separate effect declaration.
##
## Codegen: bare-IDENT path in mir_lower's NODE_WITH branch redirects
## `nw_eff_name = "Alloc"`, pushes the env-aware arena handler entries,
## and threads the acquire-call's return through state_slot as env.
##
## Limitation: nested `with TestAlloc` blocks share the singleton; the
## inner reset wipes outer's allocations. Test-framework integration
## (one TestAlloc per `it` block) avoids this naturally; per-scope
## arena lifecycles await a per-install teardown substrate (filed as a
## Phase B followup).
##
## NOTE on triple-quoted snippet strings: `"""..."""` interpolates
## `#{...}` at SPEC compile time, not subprocess runtime.

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# B2.1 — basic: alloc inside `with TestAlloc do ... end` succeeds and
# the value round-trips through the arena-backed pointer.
# -----------------------------------------------------------------------------

var _BASIC: String = """import std/alloc

def main(): Int
  with TestAlloc do ->
    var p = alloc(64)
    store(p, 0, 42)
    var v = load(p, 0)
    puts(\"v=\" + str_from_int(v))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B2.2 — sequential isolation: between two `with TestAlloc` blocks, the
# arena is reset so the second block starts fresh. Exposed via a peek
# at bytes_used between blocks (drops back to ~0 after acquire-reset).
# Captures into module globals to keep the puts outside the with-blocks
# so format-string allocs don't perturb the post-block reading.
# -----------------------------------------------------------------------------

var _SEQUENTIAL_RESET: String = """import std/alloc
import std/memory

var g_first = 0
var g_after_second = 0

def main(): Int
  with TestAlloc do ->
    var p = alloc(64)
    g_first = arena_bytes_used(test_alloc_arena_peek())
  end
  with TestAlloc do ->
    var q = alloc(16)
    g_after_second = arena_bytes_used(test_alloc_arena_peek())
  end
  if g_first >= 64 and g_after_second < g_first
    puts(\"reset_observed\")
  else
    puts(\"first=\" + str_from_int(g_first) +
         \" after_second=\" + str_from_int(g_after_second))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B2.3 — multi-alloc routing: every user-visible alloc(N) inside
# TestAlloc routes to the test arena. Captures bytes-used at the end
# of the with-block to prove the arena absorbed all three. Vec.push
# coverage lives in `alloc_realloc_a3d_spec.qz` (the realloc bypass
# was closed in Phase A.3.d).
# -----------------------------------------------------------------------------

var _MULTI_ALLOC_ROUTES: String = """import std/alloc
import std/memory

var g_used = 0

def main(): Int
  with TestAlloc do ->
    var p1 = alloc(64)
    var p2 = alloc(128)
    var p3 = alloc(32)
    store(p1, 0, 1)
    store(p2, 0, 2)
    store(p3, 0, 3)
    g_used = arena_bytes_used(test_alloc_arena_peek())
  end
  if g_used >= 224
    puts(\"all_routed\")
  else
    puts(\"used=\" + str_from_int(g_used))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B2.4 — large allocation capacity: arena_new(8192) starts with one
# 8 KB block; allocating > 8 KB triggers chain growth (mmap'd
# additional blocks). Confirms TestAlloc isn't capped at the initial
# block size.
# -----------------------------------------------------------------------------

var _LARGE_ALLOC: String = """import std/alloc

def main(): Int
  with TestAlloc do ->
    var p = alloc(32768)
    store(p, 0, 7777)
    store(p, 4095, 8888)
    var v0 = load(p, 0)
    var v1 = load(p, 4095)
    puts(\"v0=\" + str_from_int(v0) +
         \" v1=\" + str_from_int(v1))
  end
  return 0
end
"""

# -----------------------------------------------------------------------------
# B2.5 — claim satisfies Alloc row: code that performs alloc directly
# inside `with TestAlloc do body end` doesn't need explicit `can Alloc`
# annotations. Exercises the typecheck alias rule
# (tc_with_handler_begin maps TestAlloc → Alloc lookup).
# -----------------------------------------------------------------------------

var _CLAIMS_ALLOC: String = """import std/alloc

def helper(): Int can Alloc
  var p = alloc(8)
  store(p, 0, 99)
  var v = load(p, 0)
  return v
end

def main(): Int
  with TestAlloc do ->
    var v = helper()
    puts(\"helper_v=\" + str_from_int(v))
  end
  return 0
end
"""

# =============================================================================
# Spec entry point
# =============================================================================

def main(): Int
  describe("Phase B.2 — TestAlloc bare-IDENT sugar") do ->

    it("basic — alloc inside TestAlloc block returns a usable pointer") do ->
      assert_run_stdout_eq(_BASIC, "v=42\n")
    end

    it("sequential — arena resets between blocks (no carry-over)") do ->
      assert_run_stdout_eq(_SEQUENTIAL_RESET, "reset_observed\n")
    end

    it("multi-alloc routing — every alloc(N) inside lands in test arena") do ->
      assert_run_stdout_eq(_MULTI_ALLOC_ROUTES, "all_routed\n")
    end

    it("large allocation > initial block size triggers arena growth") do ->
      assert_run_stdout_eq(_LARGE_ALLOC,
        "v0=7777 v1=8888\n")
    end

    it("TestAlloc claim satisfies a `can Alloc`-rowed helper") do ->
      assert_run_stdout_eq(_CLAIMS_ALLOC, "helper_v=99\n")
    end

  end
  return qspec_main()
end
