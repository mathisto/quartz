## std/tui/widgets/overlay.overlay_compose_string behaviour tests.
##
## Coverage:
##   - All five POS_* anchor points (top-left, top-right, bottom-left,
##     bottom-right, center) splice at the right visible column
##   - ANSI styled base content survives splicing intact before/after
##     the overlay region
##   - Overlay narrower / wider / taller than base
##   - Empty base / empty overlay
##   - line_count + visible_width invariants on the result
##   - overlay_compose_safe == overlay_compose_string

import * from qspec
import std/tui/widgets/overlay as ov
import std/tui/layout as ly

# ============================================================
# Builders
# ============================================================

def _ov(body: String, position: Int): ov::Overlay
  return ov::overlay_new(body, position, ly::BORDER_NONE())
end

# 5x3 plain ASCII base. visible_width 5, line_count 3.
def _plain_base(): String =
  "AAAAA\nBBBBB\nCCCCC"

# 3x2 plain ASCII overlay body — "ov1" / "ov2".
def _plain_overlay_body(): String = "ov1\nov2"

# Big base: 8x4. visible_width 8, line_count 4.
def _big_base(): String =
  "12345678\n23456789\n34567890\n45678901"

# ============================================================
# Anchor positions
# ============================================================

def test_top_left_splices_at_origin(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_TOP_LEFT())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "ov145678")
  assert_eq_str(lines[1], "ov256789")
  assert_eq_str(lines[2], "34567890")
  assert_eq_str(lines[3], "45678901")
end

def test_top_right_aligns_to_right_edge(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_TOP_RIGHT())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "12345ov1")
  assert_eq_str(lines[1], "23456ov2")
  assert_eq_str(lines[2], "34567890")
  assert_eq_str(lines[3], "45678901")
end

def test_bottom_left_aligns_to_bottom(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_BOTTOM_LEFT())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "12345678")
  assert_eq_str(lines[1], "23456789")
  assert_eq_str(lines[2], "ov167890")
  assert_eq_str(lines[3], "ov278901")
end

def test_bottom_right_aligns_to_corner(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_BOTTOM_RIGHT())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "12345678")
  assert_eq_str(lines[1], "23456789")
  assert_eq_str(lines[2], "34567ov1")
  assert_eq_str(lines[3], "45678ov2")
end

def test_center_splices_in_the_middle(): Void
  ## 8x4 base, 3x2 overlay. _overlay_origin: row = (4-2)/2+1 = 2,
  ## col = (8-3)/2+1 = 3. So overlay rows 2-3 (1-indexed), col 3.
  var o = _ov(_plain_overlay_body(), ov::POS_CENTER())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "12345678")
  assert_eq_str(lines[1], "23ov1789")
  assert_eq_str(lines[2], "34ov2890")
  assert_eq_str(lines[3], "45678901")
end

# ============================================================
# ANSI styling preservation
# ============================================================

def test_styled_base_preserves_ansi_around_splice(): Void
  ## Base: red HELLO + reset. visible_width 5 — "HELLO".
  ## Splice 2-cell overlay "OV" at left_col 2. Expected stripped
  ## visible: "HOVLO". The leading red-on escape and trailing reset
  ## must survive on the prefix and suffix sides respectively.
  var base = "\x1b[31mHELLO\x1b[0m"
  var o = _ov("OV", ov::POS_TOP_LEFT())
  var moved = ov::overlay_with_position(o, ov::POS_TOP_LEFT())
  ## Override origin to col 2 by using a manual splice — POS_CENTER
  ## centres a 2x1 overlay in a 5x1 base at col (5-2)/2+1 = 2.
  var centred = ov::overlay_with_position(o, ov::POS_CENTER())
  var out = ov::overlay_compose_string(base, centred)
  ## Visible content should be H + OV + LO = "HOVLO".
  assert_eq_str(ly::strip_styles(out), "HOVLO")
  ## ANSI red sequence must still appear in the output.
  if str_contains(out, "\x1b[31m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if str_contains(out, "\x1b[0m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_overlay_narrower_than_base_preserves_tail(): Void
  ## 8-wide base, 3-wide overlay at POS_TOP_LEFT. Tail "45678" must
  ## remain on row 0.
  var o = _ov("ABC", ov::POS_TOP_LEFT())
  var out = ov::overlay_compose_string(_big_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "ABC45678")
end

# ============================================================
# Boundary conditions
# ============================================================

def test_overlay_wider_than_base_clamps_to_origin(): Void
  ## Base 5x3, overlay 9x1 at any anchor — _overlay_origin clamps
  ## to (1,1). Overlay overflows the base width on the right.
  var o = _ov("ABCDEFGHI", ov::POS_TOP_RIGHT())
  var out = ov::overlay_compose_string(_plain_base(), o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "ABCDEFGHI")
  assert_eq_str(lines[1], "BBBBB")
  assert_eq_str(lines[2], "CCCCC")
end

def test_overlay_taller_than_base_appends_extra_rows(): Void
  ## Base 5x3, overlay 3x5 at POS_TOP_LEFT. Origin clamps to (1,1).
  ## Rows 0-2 splice over base rows; rows 3-4 are appended as new
  ## lines past the base's height.
  var body = "AAA\nBBB\nCCC\nDDD\nEEE"
  var o = _ov(body, ov::POS_BOTTOM_LEFT())
  var out = ov::overlay_compose_string(_plain_base(), o)
  var lines = str_split(out, "\n")
  assert_eq(lines.size, 5)
  assert_eq_str(lines[0], "AAAAA")
  assert_eq_str(lines[1], "BBBBB")
  assert_eq_str(lines[2], "CCCCC")
  ## Origin clamped: top_row 1, left_col 1 — overlay rows 4-5 fall
  ## past the base's 3 rows and append.
end

def test_overlay_equal_in_size_to_base_fully_replaces(): Void
  var body = "OO\nOO"
  var o = _ov(body, ov::POS_TOP_LEFT())
  var base = "AB\nCD"
  var out = ov::overlay_compose_string(base, o)
  assert_eq_str(out, "OO\nOO")
end

def test_empty_base_emits_only_overlay(): Void
  var o = _ov("XY", ov::POS_TOP_LEFT())
  var out = ov::overlay_compose_string("", o)
  ## With empty base and overlay 2x1: origin (1,1), prefix is "",
  ## suffix is "", row 0 is the overlay row.
  assert_eq_str(out, "XY")
end

def test_zero_size_overlay_returns_base_unchanged(): Void
  ## Hand-construct an Overlay with zero width/height to bypass
  ## overlay_new (which computes width/height from the body).
  var o = ov::Overlay {
    content:  "",
    width:    0,
    height:   0,
    position: ov::POS_TOP_LEFT(),
    dim_base: false
  }
  var base = _plain_base()
  var out = ov::overlay_compose_string(base, o)
  assert_eq_str(out, base)
end

# ============================================================
# Result invariants
# ============================================================

def test_result_line_count_matches_base_when_overlay_fits(): Void
  ## 8x4 base, 3x2 overlay — result should have line_count 4.
  var o = _ov(_plain_overlay_body(), ov::POS_CENTER())
  var out = ov::overlay_compose_string(_big_base(), o)
  assert_eq(ly::line_count(out), 4)
end

def test_result_visible_width_equals_base_width(): Void
  ## Same dims — splice replaces 3 visible cells, yields same width.
  var o = _ov(_plain_overlay_body(), ov::POS_CENTER())
  var out = ov::overlay_compose_string(_big_base(), o)
  assert_eq(ly::visible_width(out), 8)
end

# ============================================================
# overlay_compose_safe parity
# ============================================================

def test_safe_matches_string_at_top_left(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_TOP_LEFT())
  var a = ov::overlay_compose_string(_big_base(), o)
  var b = ov::overlay_compose_safe(_big_base(), o)
  assert_eq_str(a, b)
end

def test_safe_matches_string_at_center(): Void
  var o = _ov(_plain_overlay_body(), ov::POS_CENTER())
  var a = ov::overlay_compose_string(_big_base(), o)
  var b = ov::overlay_compose_safe(_big_base(), o)
  assert_eq_str(a, b)
end

# ============================================================
# Extra cases
# ============================================================

def test_pad_short_base_row_with_spaces_before_splice(): Void
  ## Base row 0 is shorter than left_col-1 — must be space-padded
  ## before the overlay splices in.
  var base = "AB\nCDEFGHIJ\nKLMNOPQR"
  ## Base is jagged; line_count 3, visible_width 8 (longest row).
  ## Overlay 2x1 at POS_TOP_RIGHT — col = 8-2+1 = 7. Row 0 is "AB"
  ## (2 cells); we need to pad to col 6 (4 spaces), then splice "XY".
  var o = _ov("XY", ov::POS_TOP_RIGHT())
  var out = ov::overlay_compose_string(base, o)
  var lines = str_split(out, "\n")
  assert_eq_str(lines[0], "AB    XY")
end

def test_overlay_with_internal_ansi_emits_through(): Void
  ## Overlay carries its own SGR; that SGR must appear in the output
  ## (verbatim — we don't strip overlay styling).
  var ov_body = "\x1b[33mYY\x1b[0m"
  var o = _ov(ov_body, ov::POS_CENTER())
  var out = ov::overlay_compose_string("...", o)
  if str_contains(out, "\x1b[33m")
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  ## Stripped output: the centred YY replaces 2 cells of "..." (3
  ## wide). Origin: col (3-2)/2+1 = 1. Splice at col 1 → "YY.".
  assert_eq_str(ly::strip_styles(out), "YY.")
end

def test_multibyte_codepoint_base_aligns_at_visible_columns(): Void
  ## Base contains a multibyte codepoint (✓ is U+2713, 3 UTF-8 bytes,
  ## visible width 1). Overlay splice at col 2 must land at the right
  ## VISIBLE column, not byte column.
  var base = "✓abc"
  var o = _ov("X", ov::POS_TOP_LEFT())
  var moved = ov::overlay_with_position(o, ov::POS_TOP_LEFT())
  var out = ov::overlay_compose_string(base, moved)
  ## POS_TOP_LEFT splices at col 1 → replaces ✓ with X. Result "Xabc".
  assert_eq_str(out, "Xabc")
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("anchor positions") do ->
    it("POS_TOP_LEFT splices at origin") do ->
      test_top_left_splices_at_origin()
    end
    it("POS_TOP_RIGHT aligns to right edge") do ->
      test_top_right_aligns_to_right_edge()
    end
    it("POS_BOTTOM_LEFT aligns to bottom") do ->
      test_bottom_left_aligns_to_bottom()
    end
    it("POS_BOTTOM_RIGHT aligns to corner") do ->
      test_bottom_right_aligns_to_corner()
    end
    it("POS_CENTER splices in the middle") do ->
      test_center_splices_in_the_middle()
    end
  end

  describe("ANSI styling") do ->
    it("preserves base ANSI around the splice region") do ->
      test_styled_base_preserves_ansi_around_splice()
    end
    it("preserves base tail past the overlay region") do ->
      test_overlay_narrower_than_base_preserves_tail()
    end
    it("emits overlay-internal SGR through verbatim") do ->
      test_overlay_with_internal_ansi_emits_through()
    end
  end

  describe("boundary conditions") do ->
    it("clamps to origin when overlay is wider than base") do ->
      test_overlay_wider_than_base_clamps_to_origin()
    end
    it("appends extra rows when overlay is taller than base") do ->
      test_overlay_taller_than_base_appends_extra_rows()
    end
    it("fully replaces base when sizes match") do ->
      test_overlay_equal_in_size_to_base_fully_replaces()
    end
    it("emits only the overlay when base is empty") do ->
      test_empty_base_emits_only_overlay()
    end
    it("returns base unchanged for zero-size overlay") do ->
      test_zero_size_overlay_returns_base_unchanged()
    end
    it("pads short base rows with spaces before splicing") do ->
      test_pad_short_base_row_with_spaces_before_splice()
    end
    it("aligns at visible columns past multibyte codepoints") do ->
      test_multibyte_codepoint_base_aligns_at_visible_columns()
    end
  end

  describe("result invariants") do ->
    it("preserves base line_count when the overlay fits") do ->
      test_result_line_count_matches_base_when_overlay_fits()
    end
    it("preserves base visible_width") do ->
      test_result_visible_width_equals_base_width()
    end
  end

  describe("overlay_compose_safe parity") do ->
    it("matches overlay_compose_string at POS_TOP_LEFT") do ->
      test_safe_matches_string_at_top_left()
    end
    it("matches overlay_compose_string at POS_CENTER") do ->
      test_safe_matches_string_at_center()
    end
  end

  return qspec_main()
end
