## Effect + generic composition audit — Milestone K acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone K.
##
## Audit to confirm that effect rows (B-era typecheck layer) still
## compose cleanly with generic functions under the D+E(post) runtime
## (argc/argv dispatch). Each test isolates one dimension of the
## composition:
##
##   - Bounded generic with `can Throws` row
##   - Generic caller passing a concrete fn through to op
##   - Multi-arg op invoked from a `can`-rowed generic
##   - Nested generics where outer row subsumes inner row
##
## If any test fails, we have a regression somewhere between B (row
## typecheck) and E(post) (multi-arg runtime). The diagnostic is whether
## the failure shows up at compile time (row mismatch — B-side) or at
## runtime (wrong value in argv — E(post)-side).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect + generic composition (piezo K)") do ->
    it("generic function with `can Throws` row typechecks and dispatches") do ->
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def invoke<T>(f: Fn(Int): T, x: Int): T can Throws
  return f(x)
end

def double(n: Int): Int = n * 2

def capture(op_name: Int, argc: Int, argv: Int): Int
  puts("captured")
  return 0
end

def main(): Int
  with Throws { throw: capture } do ->
    var r = invoke(double, 21)
    puts(r.to_s())
  end
  return 0
end
""", "42\n")
    end

    it("generic `can`-rowed function invokes multi-arg op correctly") do ->
      assert_run_stdout_eq("""
effect Log
  def emit2(s: String, n: Int): Int
end

def log_at<T>(level: Int, msg: String): Int can Log
  emit2(msg, level)
  return 0
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  var lvl = load(argv, 1)
  puts(lvl.to_s() + ": " + s)
  return 0
end

def main(): Int
  with Log { emit2: cap } do ->
    log_at<Int>(1, "first")
    log_at<Int>(2, "second")
  end
  return 0
end
""", "1: first\n2: second\n")
    end

    it("generic fn that calls op inherits the row without annotation") do ->
      # The caller's `can Throws` is propagated to main via the with
      # block. Generic substitution doesn't lose the effect row.
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: String): Int
end

def pass_through<T>(x: T): T can Throws
  throw("check")
  return x
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  puts("caught: " + s)
  return 0
end

def main(): Int
  with Throws { throw: cap } do ->
    var r = pass_through<Int>(42)
    puts(r.to_s())
  end
  return 0
end
""", "caught: check\n42\n")
    end

    it("row mismatch in generic call fires QZ0611 (B-era diagnostic still live)") do ->
      # Confirm that a non-covered effect in a generic body is still
      # caught by the B-era row check under D+E(post) runtime.
      assert_compile_error("""
effect Custom
  def op(): Int
end

def call_op<T>(x: T): T
  op()
  return x
end

def main(): Int = call_op<Int>(0)
""", "QZ0611")
    end

    it("two-generic-param function with row carrying multi-arg op") do ->
      assert_run_stdout_eq("""
effect Log
  def emit2(s: String, n: Int): Int
end

def log_kv<K, V>(key: String, val: Int): Int can Log
  emit2(key, val)
  return 0
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var s = as_string(load(argv, 0))
  var n = load(argv, 1)
  puts(s + "=" + n.to_s())
  return 0
end

def main(): Int
  with Log { emit2: cap } do ->
    log_kv<String, Int>("count", 5)
    log_kv<String, Int>("depth", 10)
  end
  return 0
end
""", "count=5\ndepth=10\n")
    end
  end
  return qspec_main()
end
