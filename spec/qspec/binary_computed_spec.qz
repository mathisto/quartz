## Binary DSL — Phase 2 Track A: computed fields.
##
## Semantics (v1):
##   - `name: type = <expr>` declares a computed field.
##   - On encode: the expression is evaluated and WRITTEN to the bit slot,
##     overriding whatever value the user supplied at construction.
##   - On decode: the field is read from the wire like any other field
##     (v1 trusts the incoming value; v2 may validate).
##   - The expression may reference other fields via `self.field_name`.
##
## Coverage: constant, self-access, payload-length, arithmetic.
## Variable-width interaction and decode-validation are later phases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — computed fields (Phase 2 Track A)") do ->

    it("constant expression overrides the user-supplied value on encode") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type CstComputed = binary {
          tag:   u8 = 42
          value: u8
        }
        def main(): Int
          var c = CstComputed { tag: 0, value: 99 }
          var b = c.encode()
          return 90 if b.size() != 2
          return 91 if b.get(0) != 42
          return 92 if b.get(1) != 99
          match CstComputed.decode(b)
            Ok(c2) => {
              return 1 if c2.tag != 42
              return 2 if c2.value != 99
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("expression references prior field via self.*") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type DoubleHdr = binary {
          base:    u8
          doubled: u8 = self.base * 2
        }
        def main(): Int
          var d = DoubleHdr { base: 17, doubled: 0 }
          var b = d.encode()
          return 90 if b.size() != 2
          return 91 if b.get(0) != 17
          return 92 if b.get(1) != 34
          return 0
        end
        """, 0)
    end

    it("expression references a later-in-block field via self.*") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type FwdRef = binary {
          a: u8 = self.b + 3
          b: u8
        }
        def main(): Int
          var f = FwdRef { a: 0, b: 10 }
          var b = f.encode()
          return 90 if b.size() != 2
          return 91 if b.get(0) != 13
          return 92 if b.get(1) != 10
          return 0
        end
        """, 0)
    end

    it("arithmetic across multiple self.* references") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Arith = binary {
          lo:  u8
          hi:  u8
          sum: u16be = self.lo + self.hi
        }
        def main(): Int
          var a = Arith { lo: 100, hi: 200, sum: 0 }
          var b = a.encode()
          return 90 if b.size() != 4
          return 91 if b.get(0) != 100
          return 92 if b.get(1) != 200
          return 93 if b.get(2) != 1      # (100 + 200) = 300 = 0x012c → hi byte
          return 94 if b.get(3) != 0x2c   # lo byte
          return 0
        end
        """, 0)
    end

    it("computed field precedes a variable-width tail") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type WithLen = binary {
          magic:   u16be = 0xcafe
          value:   u8
          payload: bytes
        }
        def main(): Int
          var p = Bytes { _data: vec_new() }
          p.push(0xaa)
          p.push(0xbb)
          p.push(0xcc)
          var h = WithLen { magic: 0, value: 7, payload: p }
          var b = h.encode()
          return 90 if b.size() != 6
          return 91 if b.get(0) != 0xca
          return 92 if b.get(1) != 0xfe
          return 93 if b.get(2) != 7
          return 94 if b.get(3) != 0xaa
          return 95 if b.get(5) != 0xcc
          return 0
        end
        """, 0)
    end

    it("computed fields are recomputed fresh on every encode") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Fresh = binary {
          counter: u8
          checksum: u8 = self.counter * 3
        }
        def main(): Int
          var f = Fresh { counter: 1, checksum: 0 }
          var b1 = f.encode()
          return 90 if b1.get(1) != 3
          var g = Fresh { counter: 5, checksum: 99 }
          var b2 = g.encode()
          return 91 if b2.get(1) != 15
          return 0
        end
        """, 0)
    end

  end
  return qspec_main()
end
