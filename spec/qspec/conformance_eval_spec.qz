## EVAL_SEMANTICS.md Conformance Test Suite
## Maps every section of the formal evaluation semantics to QSpec tests.
## Each describe block is tagged with the spec section reference.
##
## Contract:
##   1. EVAL §2.1: Literals.
##   2. EVAL §2.2: Variables.
##   3. EVAL §2.3: Binary operations [E-BINOP].
##   4. EVAL §2.3: Short-circuit AND [E-AND-SHORT].
##   5. EVAL §2.3: Short-circuit OR [E-OR-SHORT].
##   6. EVAL §2.4: Unary operations.
##   7. EVAL §2.5: Function calls [E-CALL].
##   8. EVAL §2.5: Closure calls [E-CLOSURE-CALL].
##   9. EVAL §2.6: UFCS [DESUGAR-UFCS].
##   10. EVAL §2.7: Struct construction [E-STRUCT].
##   11. EVAL §2.8: Field access [E-FIELD].
##   12. EVAL §2.9: Lambda/closure construction [E-LAMBDA].
##   13. EVAL §3.1: Variable binding.
##   14. EVAL §3.2: If/else.
##   15. EVAL §3.3: While loop.
##   16. EVAL §3.4: For-in range.
##   17. EVAL §3.5: Match expression [E-MATCH].
##   18. EVAL §3.6: Return, break, continue.
##   19. EVAL §3.7: Defer [S-DEFER-EXIT].
##   20. EVAL §4: Enum semantics.
##   21. EVAL §5: Desugaring rules.
##   22. EVAL §6: Program execution model.
##   23. EVAL §7: Generic instantiation.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # §2.1 Literals
  # ===========================================================================
  describe("EVAL §2.1: Literals") do ->
    it("integer literal evaluates to itself [E-INT]") do ->
      assert_run_exits("""
        def main(): Int
          return 42
        end
        """, 42)
    end

    it("true evaluates to 1 [E-TRUE]") do ->
      assert_run_exits("""
        def main(): Int
          x = true
          if x
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("false evaluates to 0 [E-FALSE]") do ->
      assert_run_exits("""
        def main(): Int
          x = false
          if x
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("nil evaluates to 0 [E-NIL]") do ->
      assert_run_exits("""
        def main(): Int
          x = nil
          if x
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("negative integer literal") do ->
      assert_run_exits("""
        def main(): Int
          x = -200
          return x + 210
        end
        """, 10)
    end

    it("zero") do ->
      assert_run_exits("""
        def main(): Int
          return 0
        end
        """, 0)
    end
  end

  # ===========================================================================
  # §2.2 Variables
  # ===========================================================================
  describe("EVAL §2.2: Variables") do ->
    it("variable reads bound value [E-VAR]") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          return x
        end
        """, 42)
    end

    it("variable reads updated mutable value") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          x = 42
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §2.3 Binary Operations
  # ===========================================================================
  describe("EVAL §2.3: Binary operations [E-BINOP]") do ->
    it("addition") do ->
      assert_run_exits("""
        def main(): Int
          return 20 + 22
        end
        """, 42)
    end

    it("subtraction") do ->
      assert_run_exits("""
        def main(): Int
          return 50 - 8
        end
        """, 42)
    end

    it("multiplication") do ->
      assert_run_exits("""
        def main(): Int
          return 6 * 7
        end
        """, 42)
    end

    it("division") do ->
      assert_run_exits("""
        def main(): Int
          return 84 / 2
        end
        """, 42)
    end

    it("modulo") do ->
      assert_run_exits("""
        def main(): Int
          return 47 % 5
        end
        """, 2)
    end

    it("equality true") do ->
      assert_run_exits("""
        def main(): Int
          if 5 == 5
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("equality false") do ->
      assert_run_exits("""
        def main(): Int
          if 5 == 6
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("not-equal") do ->
      assert_run_exits("""
        def main(): Int
          if 5 != 6
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("less than") do ->
      assert_run_exits("""
        def main(): Int
          if 3 < 5
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("greater than") do ->
      assert_run_exits("""
        def main(): Int
          if 5 > 3
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("left-to-right evaluation order") do ->
      assert_run_exits("""
        var g = 0
        def inc(): Int
          g = g + 1
          return g
        end
        def main(): Int
          g = 0
          a = inc()
          b = inc()
          return a * 10 + b
        end
        """, 12)
    end
  end

  # ===========================================================================
  # §2.3 Short-Circuit Evaluation
  # ===========================================================================
  describe("EVAL §2.3: Short-circuit AND [E-AND-SHORT]") do ->
    it("false && expr does not evaluate expr") do ->
      assert_run_exits("""
        var side_effect = 0
        def set_flag(): Int
          side_effect = 1
          return 1
        end
        def main(): Int
          if false and set_flag()
            return 99
          end
          return side_effect
        end
        """, 0)
    end

    it("true && expr evaluates expr [E-AND-EVAL]") do ->
      assert_run_exits("""
        def main(): Int
          if true and true
            return 1
          end
          return 0
        end
        """, 1)
    end
  end

  describe("EVAL §2.3: Short-circuit OR [E-OR-SHORT]") do ->
    it("true || expr does not evaluate expr") do ->
      assert_run_exits("""
        var side_effect = 0
        def set_flag(): Int
          side_effect = 1
          return 1
        end
        def main(): Int
          if true or set_flag()
            return side_effect
          end
          return 99
        end
        """, 0)
    end

    it("false || expr evaluates expr") do ->
      assert_run_exits("""
        def main(): Int
          if false or true
            return 1
          end
          return 0
        end
        """, 1)
    end
  end

  # ===========================================================================
  # §2.4 Unary Operations
  # ===========================================================================
  describe("EVAL §2.4: Unary operations") do ->
    it("negation [E-NEG]") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          y = -x
          return y + 52
        end
        """, 10)
    end

    it("logical not [E-NOT]: !0 = 1") do ->
      assert_run_exits("""
        def main(): Int
          if not false
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("logical not [E-NOT]: !nonzero = 0") do ->
      assert_run_exits("""
        def main(): Int
          if not true
            return 1
          end
          return 0
        end
        """, 0)
    end
  end

  # ===========================================================================
  # §2.5 Function Calls
  # ===========================================================================
  describe("EVAL §2.5: Function calls [E-CALL]") do ->
    it("simple function call") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int
          return a + b
        end
        def main(): Int
          return add(20, 22)
        end
        """, 42)
    end

    it("nested function calls") do ->
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def inc(x: Int): Int = x + 1
        def main(): Int
          return inc(double(20))
        end
        """, 41)
    end

    it("recursive function call") do ->
      assert_run_exits("""
        def fib(n: Int): Int
          if n < 2
            return n
          end
          return fib(n - 1) + fib(n - 2)
        end
        def main(): Int
          return fib(10)
        end
        """, 55)
    end

    it("arguments evaluated left to right") do ->
      assert_run_exits("""
        var counter = 0
        def next(): Int
          counter = counter + 1
          return counter
        end
        def pair(a: Int, b: Int): Int = a * 10 + b
        def main(): Int
          counter = 0
          return pair(next(), next())
        end
        """, 12)
    end
  end

  # ===========================================================================
  # §2.5 Closure Calls
  # ===========================================================================
  describe("EVAL §2.5: Closure calls [E-CLOSURE-CALL]") do ->
    it("closure captures and uses environment") do ->
      assert_run_exits("""
        def make_adder(n: Int): Fn(Int): Int
          return x -> x + n
        end
        def main(): Int
          add5 = make_adder(5)
          return add5(37)
        end
        """, 42)
    end

    it("closure environment is separate from caller") do ->
      assert_run_exits("""
        def make_closure(): Fn(): Int
          var x = 42
          return -> x
        end
        def main(): Int
          f = make_closure()
          var x = 99
          return f()
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §2.6 UFCS
  # ===========================================================================
  describe("EVAL §2.6: UFCS [DESUGAR-UFCS]") do ->
    it("e.f(args) rewrites to f(e, args)") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return 40.add(2)
        end
        """, 42)
    end

    it("UFCS chaining") do ->
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def inc(x: Int): Int = x + 1
        def main(): Int
          return 20.double().inc()
        end
        """, 41)
    end
  end

  # ===========================================================================
  # §2.7 Struct Construction
  # ===========================================================================
  describe("EVAL §2.7: Struct construction [E-STRUCT]") do ->
    it("struct fields are initialized via heap allocation") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          p = Point{x: 10, y: 32}
          return p.x + p.y
        end
        """, 42)
    end

    it("struct field expressions evaluated left to right") do ->
      assert_run_exits("""
        var counter = 0
        def next(): Int
          counter = counter + 1
          return counter
        end
        struct Pair
          a: Int
          b: Int
        end
        def main(): Int
          counter = 0
          p = Pair{a: next(), b: next()}
          return p.a * 10 + p.b
        end
        """, 12)
    end
  end

  # ===========================================================================
  # §2.8 Field Access
  # ===========================================================================
  describe("EVAL §2.8: Field access [E-FIELD]") do ->
    it("reads field at correct offset") do ->
      assert_run_exits("""
        struct Triple
          a: Int
          b: Int
          c: Int
        end
        def main(): Int
          t = Triple{a: 10, b: 20, c: 12}
          return t.a + t.b + t.c
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §2.9 Lambda / Closure Construction
  # ===========================================================================
  describe("EVAL §2.9: Lambda/closure construction [E-LAMBDA]") do ->
    it("capture by value semantics") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          f = -> x
          x = 99
          return f()
        end
        """, 10)
    end

    it("multiple captures") do ->
      assert_run_exits("""
        def main(): Int
          a = 10
          b = 32
          f = -> a + b
          return f()
        end
        """, 42)
    end

    it("nested closures capture transitively") do ->
      assert_run_exits("""
        def make_outer(x: Int): Fn(): Int
          return -> x
        end
        def main(): Int
          f = make_outer(42)
          return f()
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.1 Variable Binding
  # ===========================================================================
  describe("EVAL §3.1: Variable binding") do ->
    it("immutable binding [S-LET]") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          return x
        end
        """, 42)
    end

    it("mutable binding [S-VAR]") do ->
      assert_run_exits("""
        def main(): Int
          var y = 10
          y = 42
          return y
        end
        """, 42)
    end

    it("immutable reassignment is compile error") do ->
      assert_compile_error("""
        def main(): Int
          x = 5
          x = 10
          return x
        end
        """, "immutable")
    end

    it("compound assignment desugars [DESUGAR-COMPOUND]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 40
          x += 2
          return x
        end
        """, 42)
    end

    it("compound subtraction") do ->
      assert_run_exits("""
        def main(): Int
          var x = 50
          x -= 8
          return x
        end
        """, 42)
    end

    it("compound multiplication") do ->
      assert_run_exits("""
        def main(): Int
          var x = 21
          x *= 2
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.2 If/Else
  # ===========================================================================
  describe("EVAL §3.2: If/else") do ->
    it("true branch taken [S-IF-TRUE]") do ->
      assert_run_exits("""
        def main(): Int
          if true
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("false branch taken [S-IF-FALSE]") do ->
      assert_run_exits("""
        def main(): Int
          if false
            return 0
          else
            return 42
          end
        end
        """, 42)
    end

    it("truthiness: nonzero is truthy") do ->
      assert_run_exits("""
        def main(): Int
          if 99
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("truthiness: zero is falsy") do ->
      assert_run_exits("""
        def main(): Int
          if 0
            return 1
          end
          return 0
        end
        """, 0)
    end

    it("elsif chain") do ->
      assert_run_exits("""
        def classify(n: Int): Int
          if n > 0
            return 1
          elsif n < 0
            return 2
          else
            return 3
          end
        end
        def main(): Int
          return classify(0) * 10 + classify(5)
        end
        """, 31)
    end
  end

  # ===========================================================================
  # §3.3 While Loop
  # ===========================================================================
  describe("EVAL §3.3: While loop") do ->
    it("condition false initially [S-WHILE-DONE]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          while false
            x = 99
          end
          return x
        end
        """, 0)
    end

    it("loop body executes until condition false [S-WHILE-CONT]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          while x < 42
            x = x + 1
          end
          return x
        end
        """, 42)
    end

    it("break exits loop [S-WHILE-BREAK]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          while true
            x = x + 1
            if x == 42
              break
            end
          end
          return x
        end
        """, 42)
    end

    it("continue skips to next iteration [S-WHILE-CONTINUE]") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          var i = 0
          while i < 10
            i = i + 1
            if i % 2 == 0
              continue
            end
            sum = sum + i
          end
          return sum
        end
        """, 25)
    end
  end

  # ===========================================================================
  # §3.4 For-In Range
  # ===========================================================================
  describe("EVAL §3.4: For-in range") do ->
    it("exclusive range [DESUGAR-FOR-RANGE]") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0..10
            sum = sum + i
          end
          return sum
        end
        """, 45)
    end

    it("inclusive range [DESUGAR-FOR-RANGE-INCL]") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0...4
            sum = sum + i
          end
          return sum
        end
        """, 10)
    end

    it("empty range produces zero iterations") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 5..5
            sum = sum + 1
          end
          return sum
        end
        """, 0)
    end
  end

  # ===========================================================================
  # §3.5 Match Expression
  # ===========================================================================
  describe("EVAL §3.5: Match expression [E-MATCH]") do ->
    it("integer literal match") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          result = match x
            1 => 10
            2 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("wildcard always matches") do ->
      assert_run_exits("""
        def main(): Int
          x = 999
          result = match x
            _ => 42
          end
          return result
        end
        """, 42)
    end

    it("variable pattern binds value") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          result = match x
            _ => x
          end
          return result
        end
        """, 42)
    end

    it("enum variant pattern destructuring") do ->
      assert_run_exits("""
        enum Either
          Left(val: Int)
          Right(val: Int)
        end
        def main(): Int
          e = Either::Left(42)
          result = match e
            Either::Left(v) => v
            Either::Right(v) => v + 100
          end
          return result
        end
        """, 42)
    end

    it("first matching arm is selected") do ->
      assert_run_exits("""
        def main(): Int
          x = 5
          result = match x
            _ => 42
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.6 Return, Break, Continue
  # ===========================================================================
  describe("EVAL §3.6: Return, break, continue") do ->
    it("return produces Return(v) [S-RETURN]") do ->
      assert_run_exits("""
        def compute(): Int
          return 42
        end
        def main(): Int
          return compute()
        end
        """, 42)
    end

    it("early return skips remaining body") do ->
      assert_run_exits("""
        def early(x: Int): Int
          if x > 0
            return 42
          end
          return 0
        end
        def main(): Int
          return early(1)
        end
        """, 42)
    end

    it("break exits innermost loop [S-BREAK]") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          while true
            while true
              break
            end
            x = x + 1
            if x == 42
              break
            end
          end
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §3.7 Defer
  # ===========================================================================
  describe("EVAL §3.7: Defer [S-DEFER-EXIT]") do ->
    it("defer runs on normal exit") do ->
      assert_run_exits("""
        var g = 0
        def set_g(n: Int): Void
          g = n
        end
        def deferred(): Void
          defer set_g(42)
        end
        def main(): Int
          deferred()
          return g
        end
        """, 42)
    end

    it("defer runs on early return") do ->
      assert_run_exits("""
        var g = 0
        def set_g(n: Int): Void
          g = n
        end
        def early_ret(flag: Int): Int
          defer set_g(42)
          if flag != 0
            return 1
          end
          return 0
        end
        def main(): Int
          early_ret(1)
          return g
        end
        """, 42)
    end

    it("multiple defers execute in LIFO order") do ->
      ## Defers run in reverse declaration order: 3, 2, 1
      ## Exit codes are 8-bit (mod 256), so keep sum < 256
      ## defer1 = +1, defer2 = +20, defer3 = +100 => LIFO: 100+20+1=121
      assert_run_exits("""
        var result = 0
        def add_to_result(n: Int): Void
          result = result + n
        end
        def stacked(): Void
          defer add_to_result(1)
          defer add_to_result(20)
          defer add_to_result(100)
        end
        def main(): Int
          stacked()
          return result
        end
        """, 121)
    end
  end

  # ===========================================================================
  # §4 Enum Semantics
  # ===========================================================================
  describe("EVAL §4: Enum semantics") do ->
    it("enum construction with payload [E-ENUM-CTOR]") do ->
      assert_run_exits("""
        enum Wrapper
          Val(n: Int)
          None
        end
        def main(): Int
          w = Wrapper::Val(42)
          result = match w
            Wrapper::Val(n) => n
            Wrapper::None => 0
          end
          return result
        end
        """, 42)
    end

    it("enum tag distinguishes variants") do ->
      assert_run_exits("""
        enum AB
          A(val: Int)
          B(val: Int)
        end
        def extract(e: AB): Int
          match e
            AB::A(v) => v
            AB::B(v) => v + 100
          end
        end
        def main(): Int
          a = AB::A(42)
          b = AB::B(42)
          return extract(a) + extract(b)
        end
        """, 184)
    end

    it("enum with multiple payload fields") do ->
      assert_run_exits("""
        enum Wrap
          Val(n: Int)
          None
        end
        def main(): Int
          a = Wrap::Val(20)
          b = Wrap::Val(22)
          va = match a
            Wrap::Val(n) => n
            Wrap::None => 0
          end
          vb = match b
            Wrap::Val(n) => n
            Wrap::None => 0
          end
          return va + vb
        end
        """, 42)
    end

    it("simple enum without payload") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def to_num(c: Color): Int
          match c
            Color::Red => 1
            Color::Green => 2
            Color::Blue => 3
          end
        end
        def main(): Int
          return to_num(Color::Red) + to_num(Color::Blue) * 10
        end
        """, 31)
    end
  end

  # ===========================================================================
  # §5 Desugaring Rules
  # ===========================================================================
  describe("EVAL §5: Desugaring rules") do ->
    it("UFCS: e.f(args) desugars to f(e, args)") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          return 40.add(2)
        end
        """, 42)
    end

    it("compound assignment desugars to binop + assign") do ->
      assert_run_exits("""
        def main(): Int
          var x = 20
          x += 22
          return x
        end
        """, 42)
    end

    it("for-in exclusive range desugars to while") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 1..6
            sum += i
          end
          return sum
        end
        """, 15)
    end

    it("nil coalescing: a ?? b") do ->
      assert_run_exits("""
        def main(): Int
          var x = 0
          if x == 0
            x = 42
          end
          return x
        end
        """, 42)
    end

    it("nil coalescing: non-nil left side") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          if x != 0
            return x
          end
          return 99
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §6 Program Execution Model
  # ===========================================================================
  describe("EVAL §6: Program execution model") do ->
    it("exit code is main() return value [§6.3]") do ->
      assert_run_exits("""
        def main(): Int
          return 42
        end
        """, 42)
    end

    it("exit code 0 for success") do ->
      assert_run_exits("""
        def main(): Int
          return 0
        end
        """, 0)
    end

    it("global variables initialized before main [§6.1]") do ->
      assert_run_exits("""
        g = 42
        def main(): Int
          return g
        end
        """, 42)
    end

    it("local functions shadow imports [§6.2]") do ->
      assert_run_exits("""
        def double(n: Int): Int = n * 2
        def main(): Int
          return double(21)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # §7 Generic Instantiation
  # ===========================================================================
  describe("EVAL §7: Generic instantiation") do ->
    it("generic function works with type erasure [§7.1]") do ->
      assert_run_exits("""
        def identity<T>(x: T): T = x
        def main(): Int
          return identity(42)
        end
        """, 42)
    end

    it("generic function with multiple call sites") do ->
      assert_run_exits("""
        def identity<T>(x: T): T = x
        def main(): Int
          a = identity(20)
          b = identity(22)
          return a + b
        end
        """, 42)
    end

    it("trait dispatch via mangled names [§7.3]") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        extend Point {
          def sum(): Int = self.x + self.y
        }
        def main(): Int
          p = Point{x: 20, y: 22}
          return p.sum()
        end
        """, 42)
    end
  end

  return qspec_main()
end
