## Scheduler idle hook intrinsic
##
## sched_idle_hook_set(fn) registers a Quartz Fn(): Void called once per
## I/O poll iteration in the scheduler's poller thread. Replaces the
## previously-shipped polling go-task ticker for Live progress UIs.
## sched_idle_hook_clear() removes the hook.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("sched_idle_hook") do ->
    it("set + clear without firing in between is a no-op") do ->
      var src = """
        def noop(): Void can Sched
        end
        def main(): Int
          sched_idle_hook_set(noop)
          sched_idle_hook_clear()
          puts("ok")
          return 0
        end
        """
      assert_run_stdout_eq(src, "ok\n")
    end

    it("hook fires while main task sleeps") do ->
      var src = """
        var _hook_count: Int = 0
        def bump(): Void can Sched
          _hook_count = _hook_count + 1
        end
        def main(): Int
          sched_idle_hook_set(bump)
          sched_sleep(60)
          sched_idle_hook_clear()
          if _hook_count > 0
            puts("fired")
          else
            puts("never")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "fired\n")
    end

    it("clear stops further hook fires") do ->
      var src = """
        var _hook_count: Int = 0
        def bump(): Void can Sched
          _hook_count = _hook_count + 1
        end
        def main(): Int
          sched_idle_hook_set(bump)
          sched_sleep(40)
          sched_idle_hook_clear()
          var snapshot = _hook_count
          sched_sleep(40)
          if _hook_count == snapshot
            puts("stopped")
          else
            puts("leaked")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "stopped\n")
    end

    it("clear before set is a safe no-op") do ->
      var src = """
        def main(): Int
          sched_idle_hook_clear()
          puts("ok")
          return 0
        end
        """
      assert_run_stdout_eq(src, "ok\n")
    end

    it("re-set replaces the previous hook") do ->
      var src = """
        var _a: Int = 0
        var _b: Int = 0
        def hook_a(): Void can Sched
          _a = _a + 1
        end
        def hook_b(): Void can Sched
          _b = _b + 1
        end
        def main(): Int
          sched_idle_hook_set(hook_a)
          sched_sleep(40)
          sched_idle_hook_set(hook_b)
          var a_at_swap = _a
          sched_sleep(40)
          sched_idle_hook_clear()
          if _a == a_at_swap and _b > 0
            puts("swapped")
          else
            puts("leaked")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "swapped\n")
    end
  end

  return qspec_main()
end
