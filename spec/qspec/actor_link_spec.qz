import * from qspec

# ============================================================================
# Process Links & Monitors — Phase 10
#
# Tests for bidirectional links, unidirectional monitors, unlink, demonitor.
# ============================================================================

extern "C" def usleep(us: Int): Int

## Spin-wait for a channel to be closed (up to ~100ms).
def wait_closed(ch: Int): Int
  for i in 0..100
    if channel_closed(ch) == 1
      return 1
    end
    usleep(1000)
  end
  return 0
end

actor Pinger
  var count: Int = 0

  def ping(): Void
    count += 1
  end

  def get(): Int
    return count
  end
end

actor Crasher
  var n: Int = 0

  def bump(): Void
    n += 1
  end

  def get(): Int
    return n
  end

  def crash(): Void
    var v = vec_new()
    var bad = v[999]
  end
end

def _qspec_is_slow(): Int = 1

def main(): Int
  describe("process links") do ->
    it("a.link(b), b.stop() cascades to a") do ->
      var a = Pinger()
      var b = Pinger()
      a.link(b)
      b.stop()
      assert_eq(wait_closed(a), 1)
    end

    it("a.link(b), a.stop() cascades to b") do ->
      var a = Pinger()
      var b = Pinger()
      a.link(b)
      a.stop()
      assert_eq(wait_closed(b), 1)
    end

    it("unlink: a.link(b), a.unlink(b), b.stop() — a stays alive") do ->
      var a = Pinger()
      var b = Pinger()
      a.link(b)
      # Ensure link-add messages are processed before unlink
      usleep(5000)
      a.unlink(b)
      # Ensure unlink messages are processed before stop
      usleep(5000)
      b.stop()
      usleep(10000)
      # a should still be alive
      a.ping()
      assert_eq(a.get(), 1)
      a.stop()
    end

    it("chain: a→b→c, c.stop() cascades through") do ->
      var a = Pinger()
      var b = Pinger()
      var c = Pinger()
      a.link(b)
      b.link(c)
      c.stop()
      assert_eq(wait_closed(b), 1)
      assert_eq(wait_closed(a), 1)
    end

    it("a.link(b): both functional before stop") do ->
      var a = Pinger()
      var b = Pinger()
      a.ping()
      a.ping()
      b.ping()
      a.link(b)
      assert_eq(a.get(), 2)
      assert_eq(b.get(), 1)
      b.stop()
      assert_eq(wait_closed(a), 1)
    end

    it("multiple links: a linked to b and c, b.stop() cascades to a") do ->
      var a = Pinger()
      var b = Pinger()
      var c = Pinger()
      a.link(b)
      a.link(c)
      b.stop()
      assert_eq(wait_closed(a), 1)
      # c may cascade from a, clean up if alive
      usleep(10000)
      if channel_closed(c) == 0
        c.stop()
      end
    end

    it("link to self is safe") do ->
      var a = Pinger()
      a.link(a)
      a.stop()
      assert_eq(wait_closed(a), 1)
    end
  end

  describe("process monitors") do ->
    it("a.monitor(b), b.stop() — a stays alive") do ->
      var a = Pinger()
      var b = Pinger()
      a.monitor(b)
      b.stop()
      usleep(10000)
      a.ping()
      a.ping()
      assert_eq(a.get(), 2)
      a.stop()
    end

    it("demonitor: a.monitor(b), a.demonitor(b), b.stop() — a alive") do ->
      var a = Pinger()
      var b = Pinger()
      a.monitor(b)
      usleep(5000)
      a.demonitor(b)
      usleep(5000)
      b.stop()
      usleep(10000)
      a.ping()
      assert_eq(a.get(), 1)
      a.stop()
    end
  end

  describe("link + crash (supervision)") do ->
    it("a.link(b), b panics — b restarts, a stays alive (crash is informational)") do ->
      var a = Pinger()
      var b = Crasher()
      a.link(b)
      usleep(5000)
      b.crash()
      usleep(20000)
      # a should still be alive (tag -2 is informational, not cascading)
      a.ping()
      assert_eq(a.get(), 1)
      # b should have restarted
      b.bump()
      assert_eq(b.get(), 1)
      a.stop()
      b.stop()
    end
  end

  return qspec_main()
end
