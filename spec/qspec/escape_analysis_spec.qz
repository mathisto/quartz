## Escape Analysis Tests
##
## Contract:
##   1. Allows @value struct in.
##   2. Allows @value struct inside.
##   3. Allows field assignment on.
##   4. Allows local use of.
##   5. Allows multiple @value structs.
##   6. Allows passing @value struct.
import * from qspec

@value
struct EscPoint
  x: Int
  y: Int
end

struct HeapBox
  val: Int
end

@value
struct EscInner
  a: Int
end

@value
struct EscOuter
  inner: EscInner
end

# Heap struct that holds an @value struct
struct EscHolder
  pt: EscPoint
end

# -- Tests that should succeed (no escape, stays on stack) --

def ea_local_use(): Int
  var p = EscPoint { x: 10, y: 20 }
  return p.x + p.y
end

def ea_field_assign(): Int
  var p = EscPoint { x: 5, y: 10 }
  p.x = 100
  return p.x + p.y
end

def ea_pass_to_function(): Int
  var p = EscPoint { x: 3, y: 7 }
  return ea_compute(p)
end

def ea_compute(p: EscPoint): Int
  return p.x + p.y
end

def ea_value_in_value(): Int
  var inner = EscInner { a: 42 }
  var outer = EscOuter { inner: inner }
  return outer.inner.a
end

def ea_multiple_locals(): Int
  var a = EscPoint { x: 1, y: 2 }
  var b = EscPoint { x: 3, y: 4 }
  return a.x + a.y + b.x + b.y
end

# -- Tests for heap-promoted escapes --

def ea_make_point(): EscPoint
  var p = EscPoint { x: 42, y: 58 }
  return p
end

def ea_test_return_escape(): Int
  var p = ea_make_point()
  return p.x + p.y
end

def ea_make_literal(): EscPoint
  return EscPoint { x: 7, y: 13 }
end

def ea_test_return_literal(): Int
  var p = ea_make_literal()
  return p.x + p.y
end

def ea_test_struct_field(): Int
  var p = EscPoint { x: 11, y: 22 }
  var h = EscHolder { pt: p }
  return h.pt.x + h.pt.y
end

def ea_test_closure_capture(): Int
  var p = EscPoint { x: 100, y: 200 }
  var f = -> p.x + p.y
  return f()
end

def ea_test_value_copy_not_escape(): Int
  # Passing to a function is a value copy, not an escape
  var p = EscPoint { x: 50, y: 50 }
  var sum = ea_compute(p)
  # p should still be accessible after the call
  return sum + p.x
end

def test_vec_push_allowed(): Int
  # @value structs in Vec use inline storage (Phase 5)
  var v = vec_new<EscPoint>()
  var p = EscPoint { x: 10, y: 20 }
  v.push(p)
  var q = v[0]
  return q.x + q.y
end

def main(): Int
  describe("@value escape analysis") do ->
    it("allows local use of @value struct") do ->
      assert_eq(ea_local_use(), 30)
    end

    it("allows field assignment on @value struct") do ->
      assert_eq(ea_field_assign(), 110)
    end

    it("allows passing @value struct to function") do ->
      assert_eq(ea_pass_to_function(), 10)
    end

    it("allows @value struct inside @value struct") do ->
      assert_eq(ea_value_in_value(), 42)
    end

    it("allows multiple @value structs in same scope") do ->
      assert_eq(ea_multiple_locals(), 10)
    end

    it("heap-promotes @value struct returned from function") do ->
      assert_eq(ea_test_return_escape(), 100)
    end

    it("heap-promotes @value struct stored in heap struct field") do ->
      assert_eq(ea_test_struct_field(), 33)
    end

    it("heap-promotes @value struct captured by closure") do ->
      assert_eq(ea_test_closure_capture(), 300)
    end

    it("allows @value struct in Vec (inline storage)") do ->
      assert_eq(test_vec_push_allowed(), 30)
    end

    it("heap-promotes @value struct literal returned from function") do ->
      assert_eq(ea_test_return_literal(), 20)
    end

    it("value copy is not an escape (pass by value)") do ->
      assert_eq(ea_test_value_copy_not_escape(), 150)
    end
  end

  return qspec_main()
end
