## Phase 4.B.4.b — Stream<T> + .next() consumer-drive surface
##
## Operation Piezoelectric Effects, Phase 4 Path B, Milestone 4.B.4.b.
##
## This milestone shipped the user-facing consumer-drive surface for
## generators. Callers can write
##
##     var s = three()
##     var a = s.next()      # Some(1)
##     var b = s.next()      # Some(2)
##     var c = s.next()      # Some(3)
##     var d = s.next()      # None
##
## instead of the `go my_helper() + await + with Yield { yield: ... }`
## ceremony that 4.B.4.a exercised. Originally landed under the
## `--piezo-gen-b` feature flag; the flag was retired in 4.B.6 and Path
## B is now the sole code path.
##
## What this spec pins down:
##
##   - `std/gen` declares `struct Stream<T>` with frame + step fields.
##   - `std/gen` declares `Stream<T>.next(self): Option<T>` that
##     dispatches to the generator's $poll function under a `with Yield
##     { yield: __qz_gen_yield_capture } do ->` install.
##   - A `def three(): impl Iterator<Int>` callsite returns a
##     `Stream<Int>` value. Its `.next()` method returns `Some(v)`
##     while the body yields and `None` once the body completes.
##
## Out of scope (covered by 4.B.5):
##
##   - `for-in` desugar unification.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4.B.4.b — Stream<T> + .next() consumer-drive surface") do ->
    it("var s = three(); s.next() returns Some(1), Some(2), Some(3), None in order") do ->
      assert_run_stdout_eq("""
def three(): impl Iterator<Int>
  yield 1
  yield 2
  yield 3
end

def main(): Int
  var s = three()
  var a = s.next()
  var b = s.next()
  var c = s.next()
  var d = s.next()
  if a is Some
    puts(str_from_int(a.unwrap()))
  end
  if b is Some
    puts(str_from_int(b.unwrap()))
  end
  if c is Some
    puts(str_from_int(c.unwrap()))
  end
  if d is None
    puts("done")
  end
  return 0
end
""", "1\n2\n3\ndone\n")
    end

    it("Stream<T>.next() works inside explicit loop + match on Option<T>") do ->
      assert_run_stdout_eq("""
def counted(): impl Iterator<Int>
  yield 10
  yield 20
  yield 30
end

def main(): Int
  var s = counted()
  var sum = 0
  var done = 0
  while done == 0
    var opt = s.next()
    match opt
      Some(v) => sum = sum + v
      None => done = 1
    end
  end
  puts(str_from_int(sum))
  return 0
end
""", "60\n")
    end
  end
  return qspec_main()
end
