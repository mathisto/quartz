## std/net/http_connection_handler spec (D.11 Phase 1).
##
## Validates the ConnectionHandler trait + DefaultConnectionHandler impl.
## Trait dispatch surface (on_open / handle_request / on_keepalive_timeout
## / on_terminate) verified end-to-end. No network I/O — the handler is
## called directly; Phase 2 will wire it into the keep-alive loop.

import * from qspec
import std/net/http_server
import std/net/http_connection_handler

# Test 1: the handler function captured by default_connection_handler is
# what handle_request invokes. Uses a free function so qspec lambda
# capture caveats don't apply.
def _test_handler_static_response(req: http_server::Request): http_server::Response
  return http_server::Response {
    status: 200,
    body: "static response body",
    content_type: "text/plain",
    extra_header_keys: vec_new<String>(),
    extra_header_vals: vec_new<String>(),
    body_ptr: 0,
    body_len: 0
  }
end

# Test 2: a handler that echoes back the request method, used to verify
# the request actually flows through the trait dispatch.
def _test_handler_echo_method(req: http_server::Request): http_server::Response
  return http_server::Response {
    status: 200,
    body: req.method,
    content_type: "text/plain",
    extra_header_keys: vec_new<String>(),
    extra_header_vals: vec_new<String>(),
    body_ptr: 0,
    body_len: 0
  }
end

def main(): Int
  describe("ConnectionHandler trait + DefaultConnectionHandler") do ->
    it("default_connection_handler returns a struct holding the fn") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_static_response)
      # If construction succeeded the struct's handler_fn slot holds a
      # callable; we exercise it via handle_request below.
      assert_eq(1, 1)
    end

    it("handle_request delegates to the wrapped function") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_static_response)
      var req = http_server::empty_request()
      var resp = h.handle_request(req)
      assert_eq(resp.status, 200)
      assert_eq_str(resp.body, "static response body")
      assert_eq_str(resp.content_type, "text/plain")
    end

    it("handle_request flows the request through to the function") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_echo_method)
      var req = http_server::empty_request()
      req.method = "POST"
      var resp = h.handle_request(req)
      assert_eq(resp.status, 200)
      assert_eq_str(resp.body, "POST")
    end

    it("on_open is a no-op (returns cleanly with any fd)") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_static_response)
      h.on_open(42)        # arbitrary fd; impl ignores it
      h.on_open(0)         # edge value
      h.on_open(0 - 1)     # invalid fd; impl still ignores
      assert_eq(1, 1)      # if any threw, we wouldn't get here
    end

    it("on_keepalive_timeout is a no-op") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_static_response)
      h.on_keepalive_timeout()
      assert_eq(1, 1)
    end

    it("on_terminate is a no-op for every reason convention") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_static_response)
      h.on_terminate("close")
      h.on_terminate("timeout")
      h.on_terminate("shutdown")
      h.on_terminate("crash:test")
      h.on_terminate("")
      assert_eq(1, 1)
    end

    it("a fresh handler per call returns independent instances") do ->
      var h1 = http_connection_handler::default_connection_handler(_test_handler_static_response)
      var h2 = http_connection_handler::default_connection_handler(_test_handler_echo_method)
      var req = http_server::empty_request()
      req.method = "GET"
      var r1 = h1.handle_request(req)
      var r2 = h2.handle_request(req)
      # h1 returns the static body regardless; h2 echoes the method
      assert_eq_str(r1.body, "static response body")
      assert_eq_str(r2.body, "GET")
    end

    it("full lifecycle sequence runs cleanly") do ->
      var h = http_connection_handler::default_connection_handler(_test_handler_echo_method)
      h.on_open(7)
      var req = http_server::empty_request()
      req.method = "PUT"
      var resp = h.handle_request(req)
      assert_eq_str(resp.body, "PUT")
      h.on_keepalive_timeout()
      h.on_terminate("close")
      assert_eq(1, 1)
    end
  end
  return qspec_main()
end
