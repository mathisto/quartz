## Regex Find All Tests (Vec<String> return)
##
## Contract:
##   1. Basic functionality.
##   2. While loop iteration.
##   3. Pattern types.
##   4. Edge cases.
##   5. Capture groups.

import * from qspec

def main(): Int
  describe("basic functionality") do ->
    it("returns empty vec when no matches") do ->
      assert_eq(rm_empty_vec(), 0)
    end
    it("returns single match") do ->
      assert_eq(rm_single_match(), 0)
    end
    it("returns multiple matches") do ->
      assert_eq(rm_multiple_matches(), 0)
    end
    it("returns multi-character matches") do ->
      assert_eq(rm_multi_char(), 0)
    end
  end

  describe("while loop iteration") do ->
    it("iterates over matches with while loop") do ->
      assert_eq(rm_while_loop(), 0)
    end
    it("accumulates match strings") do ->
      assert_eq(rm_accumulate(), 0)
    end
    it("can break out of match iteration") do ->
      assert_eq(rm_break_loop(), 0)
    end
  end

  describe("pattern types") do ->
    it("works with word patterns") do ->
      assert_eq(rm_word_patterns(), 0)
    end
    it("works with anchored patterns") do ->
      assert_eq(rm_anchored(), 0)
    end
    it("works with overlapping potential matches") do ->
      assert_eq(rm_overlapping(), 0)
    end
  end

  describe("edge cases") do ->
    it("handles empty string") do ->
      assert_eq(rm_empty_string(), 0)
    end
    it("handles pattern that matches empty string") do ->
      assert_eq(rm_empty_pattern(), 0)
    end
    it("handles invalid regex gracefully") do ->
      assert_eq(rm_invalid_regex(), 0)
    end
  end

  describe("capture groups") do ->
    it("returns full match not capture groups") do ->
      assert_eq(rm_full_match(), 0)
    end
  end

  return qspec_main()
end

def rm_empty_vec(): Int
  var matches = regex_find_all("hello world", "[0-9]+")
  if matches.size == 0
    return 0
  end
  return 1
end

def rm_single_match(): Int
  var matches = regex_find_all("hello123world", "[0-9]+")
  if matches.size != 1
    return 1
  end
  var m = as_string(matches[0])
  if m == "123"
    return 0
  end
  return 2
end

def rm_multiple_matches(): Int
  var matches = regex_find_all("a1b2c3d4", "[0-9]")
  if matches.size != 4
    return 1
  end
  if as_string(matches[0]) == "1"
    if as_string(matches[1]) == "2"
      if as_string(matches[2]) == "3"
        if as_string(matches[3]) == "4"
          return 0
        end
      end
    end
  end
  return 2
end

def rm_multi_char(): Int
  var matches = regex_find_all("abc123def456ghi789", "[0-9]+")
  if matches.size != 3
    return 1
  end
  if as_string(matches[0]) == "123"
    if as_string(matches[1]) == "456"
      if as_string(matches[2]) == "789"
        return 0
      end
    end
  end
  return 2
end

def rm_while_loop(): Int
  var matches = regex_find_all("a1b2c3", "[0-9]")
  var count = 0
  var i = 0
  while i < matches.size
    count += 1
    i += 1
  end
  if count == 3
    return 0
  end
  return 1
end

def rm_accumulate(): Int
  var matches = regex_find_all("x10y20z30", "[0-9]+")
  var total = 0
  var i = 0
  while i < matches.size
    total += str_to_int(as_string(matches[i]))
    i += 1
  end
  if total == 60
    return 0
  end
  return 1
end

def rm_break_loop(): Int
  var matches = regex_find_all("a1b2c3d4e5", "[0-9]")
  var count = 0
  var i = 0
  while i < matches.size
    count += 1
    if count == 3
      break
    end
    i += 1
  end
  if count == 3
    return 0
  end
  return 1
end

def rm_word_patterns(): Int
  var matches = regex_find_all("one two three", "[a-z]+")
  if matches.size == 3
    return 0
  end
  return 1
end

def rm_anchored(): Int
  var matches = regex_find_all("abc def ghi", "^[a-z]+")
  if matches.size == 1
    return 0
  end
  return 1
end

def rm_overlapping(): Int
  var matches = regex_find_all("aaaa", "aa")
  if matches.size == 2
    return 0
  end
  return 1
end

def rm_empty_string(): Int
  var matches = regex_find_all("", "[0-9]+")
  if matches.size == 0
    return 0
  end
  return 1
end

def rm_empty_pattern(): Int
  var matches = regex_find_all("a b c", "[a-z]*")
  # Should not hang and return something >= 0
  if matches.size >= 0
    return 0
  end
  return 1
end

def rm_invalid_regex(): Int
  var matches = regex_find_all("test", "[abc")
  if matches.size == 0
    return 0
  end
  return 1
end

def rm_full_match(): Int
  var matches = regex_find_all("abc123def456", "([a-z]+)([0-9]+)")
  if matches.size != 2
    return 1
  end
  if as_string(matches[0]) == "abc123"
    if as_string(matches[1]) == "def456"
      return 0
    end
  end
  return 2
end
