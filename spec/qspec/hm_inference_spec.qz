## Hindley-Milner Type Inference Tests (T3c.1)
##
## Phase 1: Infrastructure — type variable primitives on TypecheckState.
## Phase 2: Constraint-based tc_expr — type vars, annotation cross-check, operators, branches.
## Phase 3: Let-polymorphism — structured fn types + generalize/instantiate.
## Phase 4: Lambda parameter inference — already working via bidirectional injection.
##
## Contract:
##   1. Type inference from literals and operators.
##   2. Annotation cross-checking (T3c.4).
##   3. Function call context inference.
##   4. Branch type unification.
##   5. Lambda parameter inference.
##   6. Let-polymorphism.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("type inference — basic literal inference") do ->
    it("infers Int from integer literal") do ->
      assert_run_exits("""
        def main(): Int
          x = 42
          return x
        end
        """, 42)
    end

    it("infers Int from arithmetic expression") do ->
      assert_run_exits("""
        def main(): Int
          x = 5
          y = x + 10
          return y
        end
        """, 15)
    end

    it("infers Bool from comparison") do ->
      assert_run_exits("""
        def main(): Int
          x = 5
          flag = x > 3
          if flag
            return 1
          end
          return 0
        end
        """, 1)
    end
  end

  describe("type inference — annotation cross-checking") do ->
    it("rejects annotation that conflicts with inferred type") do ->
      assert_compile_error("""
        def main(): Int
          var y: String = 42
          return 0
        end
        """, "conflicts with inferred type")
    end

    it("rejects Bool annotation on Int literal") do ->
      assert_compile_error("""
        def main(): Int
          var b: Bool = 42
          return 0
        end
        """, "conflicts with inferred type")
    end

    it("accepts annotation that matches inferred type") do ->
      assert_run_exits("""
        def main(): Int
          var x: Int = 42
          return x
        end
        """, 42)
    end

    it("accepts Vec ptype annotation on vec_new") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          return v[0]
        end
        """, 42)
    end

    it("accepts struct annotation on struct init") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          var p: Point = Point { x: 20, y: 22 }
          return p.x + p.y
        end
        """, 42)
    end
  end

  describe("type inference — function call context") do ->
    it("passes inferred variable to function") do ->
      assert_run_exits("""
        def double(n: Int): Int = n * 2
        def main(): Int
          x = 21
          return double(x)
        end
        """, 42)
    end

    it("passes expression result to function") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def main(): Int
          x = 20
          y = 22
          return add(x, y)
        end
        """, 42)
    end
  end

  describe("type inference — branch unification") do ->
    it("unifies if/else branch types") do ->
      assert_run_exits("""
        def main(): Int
          x = if true then 42 else 0 end
          return x
        end
        """, 42)
    end

    it("if-expression returns correct branch value") do ->
      assert_run_exits("""
        def main(): Int
          a = 5
          b = if a > 3 then 42 else 0 end
          return b
        end
        """, 42)
    end
  end

  describe("type inference — lambda parameter inference") do ->
    it("infers lambda param type from Fn parameter annotation") do ->
      assert_run_exits("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply(x -> x * 2, 21)
        end
        """, 42)
    end

    it("infers multi-param lambda types from Fn annotation") do ->
      assert_run_exits("""
        def apply2(f: Fn(Int, Int): Int, a: Int, b: Int): Int = f(a, b)
        def main(): Int
          return apply2((x, y) -> x + y, 20, 22)
        end
        """, 42)
    end

    it("standalone lambda with inferred types from operator context") do ->
      assert_run_exits("""
        def main(): Int
          double = x -> x * 2
          return double(21)
        end
        """, 42)
    end
  end

  describe("type inference — let-polymorphism") do ->
    it("identity function used polymorphically") do ->
      assert_run_exits("""
        def main(): Int
          id = x -> x
          a = id(42)
          b = id("hello")
          return a
        end
        """, 42)
    end

    it("polymorphic function with arithmetic body") do ->
      assert_run_exits("""
        def main(): Int
          double = x -> x * 2
          return double(21)
        end
        """, 42)
    end

    it("polymorphic const function") do ->
      assert_run_exits("""
        def main(): Int
          always_42 = x -> 42
          a = always_42(0)
          b = always_42("ignored")
          return a
        end
        """, 42)
    end

    it("lambda with two params used polymorphically") do ->
      assert_run_exits("""
        def apply2(f: Fn(Int, Int): Int, a: Int, b: Int): Int = f(a, b)
        def main(): Int
          add = (a, b) -> a + b
          return apply2(add, 20, 22)
        end
        """, 42)
    end

    it("nested polymorphic usage") do ->
      assert_run_exits("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          id = x -> x
          return apply(id, 42)
        end
        """, 42)
    end

    it("constrained lambda is monomorphic (operator narrows type)") do ->
      assert_run_exits("""
        def main(): Int
          inc = x -> x + 1
          return inc(41)
        end
        """, 42)
    end

    it("mutable binding is monomorphic (value restriction)") do ->
      assert_run_exits("""
        def main(): Int
          var f = x -> x
          a = f(42)
          return a
        end
        """, 42)
    end

    it("multiple independent instantiations") do ->
      assert_run_exits("""
        def main(): Int
          id = x -> x
          a = id(10)
          b = id(20)
          c = id(12)
          return a + b + c
        end
        """, 42)
    end
  end

  return qspec_main()
end
