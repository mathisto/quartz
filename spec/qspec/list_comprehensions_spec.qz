## List Comprehensions Tests
##
## Contract:
##   1. Double: `[x*2 for x in arr]` doubles each element.
##   2. Identity: `[x for x in arr]` copies elements.
##   3. Squares: `[x*x for x in arr]` squares elements.
##   4. Filter: `[x for x in arr if x > 5]` filters.
##   5. Transform+filter: combined filter and transform.
##   6. Empty: filter matching nothing returns empty.
##   7. Function call: `[f(x) for x in arr]` calls function.
##   8. Single: list comp on single-element vec.
import * from qspec

def main(): Int
  describe("list comprehensions") do ->
    it("doubles each element") do ->
      arr = [1, 2, 3]
      doubled = [x * 2 for x in arr]
      assert_eq(doubled[0] + doubled[1] + doubled[2], 12)
    end
    it("identity expression") do ->
      arr = [10, 20]
      copy = [x for x in arr]
      assert_eq(copy[0] + copy[1], 30)
    end
    it("arithmetic in expression") do ->
      arr = [1, 2, 3]
      squares = [x * x for x in arr]
      assert_eq(squares[0] + squares[1] + squares[2], 14)
    end
    it("filters with if condition") do ->
      arr = [3, 7, 5, 9]
      big = [x for x in arr if x > 5]
      assert_eq(big.size, 2)
    end
    it("filters and transforms") do ->
      arr = [1, 2, 3]
      result = [x * 2 for x in arr if x > 1]
      assert_eq(result[0] + result[1], 10)
    end
    it("returns empty when no elements match filter") do ->
      arr = [1, 2]
      empty = [x for x in arr if x > 100]
      assert_eq(empty.size, 0)
    end
    it("calls function in expression") do ->
      arr = [5, 10]
      result = [lc_double(x) for x in arr]
      assert_eq(result[0] + result[1], 30)
    end

    it("single element list comprehension") do ->
      arr = [42]
      result = [x * 10 for x in arr]
      assert_eq(result.size, 1)
      assert_eq(result[0], 420)
    end

  end
  return qspec_main()
end
def lc_double(n: Int): Int = n * 2
