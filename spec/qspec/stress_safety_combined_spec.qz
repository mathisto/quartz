## STRESS: Combined Safety Features
##
## Adversarial tests probing interactions between safety features:
## move + borrow, drop + defer, partial moves through match,
## conditional ownership, struct field moves, enum variant moves,
## and multi-feature interaction patterns.
##
## Contract:
##   1. Safety: move basics.
##   2. Safety: drop + defer.
##   3. Safety: match + move.
##   4. Safety: struct field patterns.
##   5. Safety: ownership + control flow.
##   6. Safety: multi-feature combos.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Move Semantics Basics
  # ===========================================================================
  describe("safety: move basics") do ->
    it("simple move transfers ownership") do ->
      assert_run_exits("""
        struct Res
          id: Int
        end
        def consume(r: Res): Int = r.id
        def main(): Int
          r = Res { id: 42 }
          return consume(r)
        end
        """, 42)
    end

    it("move into function, then use return") do ->
      assert_run_exits("""
        struct Data
          val: Int
        end
        def transform(d: Data): Data
          return Data { val: d.val * 2 }
        end
        def main(): Int
          d = Data { val: 21 }
          d2 = transform(d)
          return d2.val
        end
        """, 42)
    end

    it("conditional move: only one branch moves") do ->
      assert_run_exits("""
        struct Obj
          n: Int
        end
        def use_obj(o: Obj): Int = o.n
        def main(): Int
          o = Obj { n: 42 }
          x = 1
          if x
            return use_obj(o)
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Drop / Defer Interaction
  # ===========================================================================
  describe("safety: drop + defer") do ->
    it("defer runs cleanup on normal return") do ->
      assert_run_exits("""
        def cleanup(): Void
          puts("cleaned")
        end
        def main(): Int
          defer cleanup()
          return 0
        end
        """, 0)
    end

    it("multiple defers run in LIFO order") do ->
      assert_run_exits("""
        var order = vec_new()

        def record1(): Void
          order.push(1)
        end

        def record2(): Void
          order.push(2)
        end

        def record3(): Void
          order.push(3)
        end

        def run(): Int
          defer record1()
          defer record2()
          defer record3()
          return 0
        end

        def main(): Int
          run()
          if order.size == 3
            if order[0] == 3
              if order[1] == 2
                if order[2] == 1
                  return 0
                end
              end
            end
          end
          return 1
        end
        """, 0)
    end

    it("defer with function call captures value at registration") do ->
      assert_run_exits("""
        def report(n: Int): Void
          puts(str_from_int(n))
        end
        def main(): Int
          var x = 42
          defer report(x)
          x = 99
          return 0
        end
        """, 0)
    end
  end

  # ===========================================================================
  # Category C: Pattern Match with Moves
  # ===========================================================================
  describe("safety: match + move") do ->
    it("match destructures and moves payload") do ->
      assert_run_exits("""
        enum Container
          Full(value: Int)
          Empty
        end
        def main(): Int
          c = Container::Full(42)
          match c
            Container::Full(v) => return v
            Container::Empty => return 0
          end
        end
        """, 42)
    end

    it("match with multiple variants and field access") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Rect(w: Int, h: Int)
        end
        def area(s: Shape): Int
          match s
            Shape::Circle(r) => return r * r * 3
            Shape::Rect(w, h) => return w * h
          end
        end
        def main(): Int
          return area(Shape::Rect(6, 7))
        end
        """, 42)
    end

    it("nested match with enum") do ->
      assert_run_exits("""
        enum Maybe
          Just(v: Int)
          Nothing
        end
        def double_maybe(m: Maybe): Maybe
          match m
            Maybe::Just(v) => return Maybe::Just(v * 2)
            Maybe::Nothing => return Maybe::Nothing
          end
        end
        def main(): Int
          x = Maybe::Just(21)
          y = double_maybe(x)
          match y
            Maybe::Just(v) => return v
            Maybe::Nothing => return 0
          end
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Struct Field Access Patterns
  # ===========================================================================
  describe("safety: struct field patterns") do ->
    it("access field of returned struct") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def make_point(x: Int, y: Int): Point
          return Point { x: x, y: y }
        end
        def main(): Int
          p = make_point(20, 22)
          return p.x + p.y
        end
        """, 42)
    end

    it("pass struct field to function") do ->
      assert_run_exits("""
        struct Pair
          a: Int
          b: Int
        end
        def add(x: Int, y: Int): Int = x + y
        def main(): Int
          p = Pair { a: 20, b: 22 }
          return add(p.a, p.b)
        end
        """, 42)
    end

    it("nested struct field access") do ->
      assert_run_exits("""
        struct Inner
          val: Int
        end
        struct Outer
          inner: Inner
        end
        def main(): Int
          o = Outer { inner: Inner { val: 42 } }
          return o.inner.val
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Ownership Through Control Flow
  # ===========================================================================
  describe("safety: ownership + control flow") do ->
    it("ownership through if/else branches") do ->
      assert_run_exits("""
        struct Res
          val: Int
        end
        def main(): Int
          cond = 1
          if cond
            r = Res { val: 42 }
            return r.val
          else
            r = Res { val: 0 }
            return r.val
          end
        end
        """, 42)
    end

    it("ownership through while loop") do ->
      assert_run_exits("""
        struct Counter
          count: Int
        end
        def main(): Int
          var sum = 0
          var i = 0
          while i < 5
            c = Counter { count: i }
            sum = sum + c.count
            i += 1
          end
          return sum + 32
        end
        """, 42)
    end

    it("struct created in loop, used after") do ->
      assert_run_exits("""
        struct Accum
          val: Int
        end
        def main(): Int
          var a = Accum { val: 0 }
          var i = 0
          while i < 42
            a = Accum { val: i + 1 }
            i += 1
          end
          return a.val
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Multi-Feature Combinations
  # ===========================================================================
  describe("safety: multi-feature combos") do ->
    it("struct + match + function call") do ->
      assert_run_exits("""
        struct Config
          mode: Int
        end
        def process(c: Config): Int
          match c.mode
            1 => return 42
            2 => return 84
            _ => return 0
          end
        end
        def main(): Int
          c = Config { mode: 1 }
          return process(c)
        end
        """, 42)
    end

    it("enum + struct + closure interaction") do ->
      assert_run_exits("""
        struct Wrapper
          val: Int
        end
        enum Action
          Add(n: Int)
          Mul(n: Int)
        end
        def apply_action(w: Wrapper, a: Action): Int
          match a
            Action::Add(n) => return w.val + n
            Action::Mul(n) => return w.val * n
          end
        end
        def main(): Int
          w = Wrapper { val: 20 }
          a = Action::Add(22)
          return apply_action(w, a)
        end
        """, 42)
    end

    it("defer + struct + early return") do ->
      assert_run_exits("""
        def cleanup(): Void
          puts("cleanup")
        end
        struct Data
          val: Int
        end
        def process(d: Data): Int
          defer cleanup()
          if d.val > 0
            return d.val
          end
          return 0
        end
        def main(): Int
          d = Data { val: 42 }
          return process(d)
        end
        """, 42)
    end

    it("generic + enum + match combined with default param name") do ->
      assert_run_exits("""
        enum Color
          Red
          Blue
          Green
        end
        def pick(default: Int, choice: Int): Int
          match choice
            0 => return default
            1 => return default + 10
            _ => return 0
          end
        end
        def main(): Int
          return pick(32, 1)
        end
        """, 42)
    end
  end

  return qspec_main()
end
