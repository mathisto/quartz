## Tuples Tests
##
## Contract:
##   1. Create+access: `(1,2,3)` and `.0`, `.1`, `.2`.
##   2. Two-element: `(10, 20)` works.
##   3. Return: tuple returned from function.
##   4. Nest: `((1,2), 3)` nests correctly.
##   5. Single: `(42,)` trailing comma creates single tuple.
##   6. Expression: `t.0 + t.1` evaluates correctly.
##   7. Arithmetic: `t.0 * t.1` computes product.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("tuples") do ->
    it("creates tuple and accesses elements") do ->
      assert_output("1\n2\n3\n", tp_create_test)
    end
    it("two-element tuple") do ->
      assert_output("10\n20\n", tp_two_test)
    end
    it("returns tuple from function") do ->
      assert_run_exits("""
        def get_pair(): Int
          return (10, 32)
        end
        def main(): Int
          p = get_pair()
          return p.0 + p.1
        end
        """, 42)
    end
    it("nests tuples") do ->
      assert_output("1\n2\n3\n", tp_nest_test)
    end
    it("single-element tuple with trailing comma") do ->
      assert_output("42\n", tp_single_test)
    end
    it("tuple in expression context") do ->
      assert_output("30\n", tp_expr_test)
    end
    it("tuple field arithmetic product") do ->
      assert_output("42\n", tp_product_test)
    end
  end
  return qspec_main()
end

def tp_create_test(): Void
  t = (1, 2, 3)
  print_int(t.0)
  print_int(t.1)
  print_int(t.2)
end

def tp_two_test(): Void
  t = (10, 20)
  print_int(t.0)
  print_int(t.1)
end

def tp_nest_test(): Void
  t = ((1, 2), 3)
  inner = t.0
  print_int(inner.0)
  print_int(inner.1)
  print_int(t.1)
end

def tp_single_test(): Void
  t = (42,)
  print_int(t.0)
end

def tp_expr_test(): Void
  t = (10, 20)
  result = t.0 + t.1
  print_int(result)
end

def tp_product_test(): Void
  t = (6, 7)
  result = t.0 * t.1
  print_int(result)
end


