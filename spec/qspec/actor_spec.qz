import * from qspec

# ============================================================================
# Language-Level Actors — V4 Phase 4
#
# 11 active tests + 5 pending. Actor calls work directly inside describe/it
# closures — the effect graph filtering prevents spurious async $poll generation.
# ============================================================================

actor Counter
  var count: Int = 0

  def increment(): Void
    count += 1
  end

  def get_count(): Int
    return count
  end

  def add(n: Int): Void
    count += n
  end

  def add_range(n: Int): Void
    for i in 0..n
      count += 1
    end
  end

  def add_and_get(n: Int): Int
    count += n
    return count
  end
end

actor Accumulator
  var total: Int = 0

  def deposit(amount: Int): Void
    total += amount
  end

  def withdraw(amount: Int): Void
    total -= amount
  end

  def balance(): Int
    return total
  end
end

def _qspec_is_slow(): Int = 1

def main(): Int
  describe("language-level actors") do ->
    it("spawn actor and get initial state (0)") do ->
      var c = Counter()
      assert_eq(c.get_count(), 0)
      c.stop()
    end

    it("fire-and-forget: 3 increments = 3") do ->
      var c = Counter()
      c.increment()
      c.increment()
      c.increment()
      assert_eq(c.get_count(), 3)
      c.stop()
    end

    it("parameterized method: add(42) = 42") do ->
      var c = Counter()
      c.add(42)
      assert_eq(c.get_count(), 42)
      c.stop()
    end

    it("request-response: add(10)+add(20)+add(12) = 42") do ->
      var c = Counter()
      c.add(10)
      c.add(20)
      c.add(12)
      assert_eq(c.get_count(), 42)
      c.stop()
    end

    it("mixed: increment+add(5)+increment+add(3) = 10") do ->
      var c = Counter()
      c.increment()
      c.add(5)
      c.increment()
      c.add(3)
      assert_eq(c.get_count(), 10)
      c.stop()
    end

    it("two independent actors: 11+22 = 33") do ->
      var c1 = Counter()
      var c2 = Counter()
      c1.add(10)
      c2.add(20)
      c1.increment()
      c2.increment()
      c2.increment()
      var v1 = c1.get_count()
      var v2 = c2.get_count()
      assert_eq(v1 + v2, 33)
      c1.stop()
      c2.stop()
    end

    it("multi-actor pipeline: Counter to Accumulator = 6") do ->
      var c = Counter()
      c.increment()
      c.increment()
      c.increment()
      var count_val = c.get_count()
      c.stop()

      var acc = Accumulator()
      acc.deposit(count_val)
      acc.deposit(count_val)
      assert_eq(acc.balance(), 6)
      acc.stop()
    end

    it("accumulator: 100+50-30 = 120") do ->
      var acc = Accumulator()
      acc.deposit(100)
      acc.deposit(50)
      acc.withdraw(30)
      assert_eq(acc.balance(), 120)
      acc.stop()
    end

    it("10K message stress test") do ->
      var c = Counter()
      for i in 0..10000
        c.increment()
      end
      assert_eq(c.get_count(), 10000)
      c.stop()
    end

    it("loop inside actor method body: add_range(50) = 50") do ->
      var c = Counter()
      c.add_range(50)
      assert_eq(c.get_count(), 50)
      c.stop()
    end

    it("stop() synchronous shutdown") do ->
      var c = Counter()
      c.add(99)
      var val = c.get_count()
      c.stop()
      assert_eq(val, 99)
    end

    it("actor with init params: Counter(42) sets initial state") do ->
      var c = Counter(42)
      assert_eq(c.get_count(), 42)
      c.increment()
      assert_eq(c.get_count(), 43)
      c.stop()
    end

    it("methods on stopped actor return 0 (no deadlock)") do ->
      var c = Counter()
      c.add(10)
      var before = c.get_count()
      c.stop()
      # After stop: fire-and-forget is no-op, request-response returns 0
      c.increment()
      var after = c.get_count()
      c.stop()  # idempotent
      assert_eq(before, 10)
      assert_eq(after, 0)
    end

    it("actor isolation: state fields not accessible from outside") do ->
      assert_compile_error("""
        actor Foo
          var x: Int = 42
          def get_x(): Int
            return x
          end
        end
        def main(): Int
          var f = Foo()
          return f.x
        end
        """, "has no field")
    end

    it("actor supervision: panic recovery, state preserved") do ->
      assert_run_exits("""
        actor R
          var count: Int = 0
          def inc(): Void
            count += 1
          end
          def get(): Int
            return count
          end
          def crash(): Void
            var v = vec_new()
            var bad = v[999]
          end
        end
        def main(): Int
          var r = R()
          r.inc()
          r.inc()
          r.inc()
          r.crash()
          r.inc()
          r.inc()
          return r.get()
        end
        """, 5)
    end
    it("generic actor: Box<T> with T in params and return") do ->
      assert_run_exits("""
        actor Box<T>
          var value: Int = 0
          def set(v: T): Void
            value = v
          end
          def get(): T
            return value
          end
        end
        def main(): Int
          var b = Box()
          b.set(42)
          var r: Int = b.get()
          b.stop()
          return r
        end
        """, 42)
    end

    it("Send validation: CPtr field rejected at compile time") do ->
      assert_compile_error("""
        actor Bad
          var ptr: CPtr = 0
          def get(): Int
            return 0
          end
        end
        def main(): Int
          return 0
        end
        """, "QZ1303")
    end

    it("async proxy: get_count_async returns reply channel for select") do ->
      var c1 = Counter()
      var c2 = Counter()
      c1.add(10)
      c2.add(20)
      # Async: send requests, get reply channel handles (non-blocking)
      var ch1 = c1.get_count_async()
      var ch2 = c2.get_count_async()
      # Collect replies
      var v1 = recv(ch1)
      var v2 = recv(ch2)
      c1.stop()
      c2.stop()
      assert_eq(v1 + v2, 30)
    end

    it("method with both params and return: add_and_get(10)") do ->
      var c = Counter()
      c.add(5)
      var result = c.add_and_get(10)
      assert_eq(result, 15)
      c.stop()
    end

    it("async proxy with params: add_and_get_async(10)") do ->
      var c = Counter()
      c.add(5)
      var ch = c.add_and_get_async(10)
      var result = recv(ch)
      assert_eq(result, 15)
      c.stop()
    end

    it("panic in request-response: caller gets 0, actor survives") do ->
      assert_run_exits("""
        actor R
          var n: Int = 0
          def inc(): Void
            n += 1
          end
          def crash_get(): Int
            var v = vec_new()
            var bad = v[999]
            return n
          end
          def get(): Int
            return n
          end
        end
        def main(): Int
          var r = R()
          r.inc()
          r.inc()
          var x = r.crash_get()
          r.inc()
          return r.get()
        end
        """, 3)
    end
  end

  return qspec_main()
end
