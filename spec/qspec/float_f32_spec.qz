## Float F32 Tests
##
## Contract:
##   1. Accepts f32 parameter and.
##   2. Adds two f32 values.
##   3. Compares f32 with !=.
##   4. Compares f32 with <.
##   5. Compares f32 with <=.
##   6. Compares f32 with ==.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("F32 type") do ->
    it("declares variable with F32 annotation") do ->
      assert_eq(f32_declare(), 0)
    end
    it("infers F32 from function return") do ->
      assert_eq(f32_infer(), 0)
    end
    it("accepts F32 parameter and returns F32") do ->
      assert_eq(f32_param(), 0)
    end
    it("passes F32 between functions") do ->
      assert_eq(f32_pass(), 1)
    end
    it("adds two F32 values") do ->
      assert_eq(f32_add(), 1)
    end
    it("subtracts two F32 values") do ->
      assert_eq(f32_sub(), 1)
    end
    it("multiplies two F32 values") do ->
      assert_eq(f32_mul(), 1)
    end
    it("divides two F32 values") do ->
      assert_eq(f32_divide(), 1)
    end
    it("negates an F32 value") do ->
      assert_eq(f32_neg(), 1)
    end
    it("compares F32 with ==") do ->
      assert_eq(f32_eq(), 1)
    end
    it("compares F32 with !=") do ->
      assert_eq(f32_ne(), 1)
    end
    it("compares F32 with <") do ->
      assert_eq(f32_lt(), 1)
    end
    it("compares F32 with >") do ->
      assert_eq(f32_gt(), 1)
    end
    it("compares F32 with <=") do ->
      assert_eq(f32_le(), 1)
    end
    it("compares F32 with >=") do ->
      assert_eq(f32_ge(), 1)
    end
    it("to_f32 converts F64 to F32") do ->
      assert_eq(f32_from_f64(), 0)
    end
    it("to_f64 converts F32 to F64") do ->
      assert_eq(f32_to_f64(), 1)
    end
    it("to_int truncates F32 to Int") do ->
      assert_eq(f32_to_int(), 7)
    end
    it("round-trip F32 -> F64 -> F32") do ->
      assert_eq(f32_roundtrip(), 1)
    end
    it("F32 has less precision than F64") do ->
      assert_eq(f32_precision(), 1)
    end
    it("rejects mixed F32 + F64 arithmetic") do ->
      assert_compile_error("def main(): Int\n  x: F32 = 1.0\n  y: F64 = 2.0\n  z = x + y\n  return 0\nend\n", "F64")
    end
    it("rejects mixed F32 + Int arithmetic") do ->
      assert_compile_error("def main(): Int\n  x: F32 = 1.0\n  z = x + 1\n  return 0\nend\n", "F32 vs Int")
    end
  end
  return qspec_main()
end

def f32_declare(): Int
  x: F32 = 3.14
  return 0
end
def f32_get(): F32 = to_f32(1.5)
def f32_infer(): Int
  x = f32_get()
  return 0
end
def f32_identity(x: F32): F32 = x
def f32_param(): Int
  r = f32_identity(2.5)
  return 0
end
def f32_double(x: F32): F32 = x + x
def f32_pass(): Int
  r = f32_double(2.5)
  if r == 5.0
    return 1
  end
  return 0
end
def f32_add(): Int
  x: F32 = 3.0
  y: F32 = 2.0
  z = x + y
  if z == 5.0
    return 1
  end
  return 0
end
def f32_sub(): Int
  x: F32 = 5.0
  y: F32 = 3.0
  z = x - y
  if z == 2.0
    return 1
  end
  return 0
end
def f32_mul(): Int
  x: F32 = 3.0
  y: F32 = 4.0
  z = x * y
  if z == 12.0
    return 1
  end
  return 0
end
def f32_divide(): Int
  x: F32 = 10.0
  y: F32 = 2.0
  z = x / y
  if z == 5.0
    return 1
  end
  return 0
end
def f32_neg(): Int
  x: F32 = 3.5
  zero: F32 = 0.0
  y = zero - x
  z = y + x
  if z == 0.0
    return 1
  end
  return 0
end
def f32_eq(): Int
  x: F32 = 1.0
  y: F32 = 1.0
  if x == y
    return 1
  end
  return 0
end
def f32_ne(): Int
  x: F32 = 1.0
  y: F32 = 2.0
  if x != y
    return 1
  end
  return 0
end
def f32_lt(): Int
  x: F32 = 1.0
  y: F32 = 2.0
  if x < y
    return 1
  end
  return 0
end
def f32_gt(): Int
  x: F32 = 3.0
  y: F32 = 2.0
  if x > y
    return 1
  end
  return 0
end
def f32_le(): Int
  x: F32 = 2.0
  y: F32 = 2.0
  if x <= y
    return 1
  end
  return 0
end
def f32_ge(): Int
  x: F32 = 2.0
  y: F32 = 2.0
  if x >= y
    return 1
  end
  return 0
end
def f32_from_f64(): Int
  x: F64 = 3.14
  y: F32 = to_f32(x)
  return 0
end
def f32_to_f64(): Int
  x: F32 = 2.5
  y: F64 = to_f64(x)
  if y == 2.5
    return 1
  end
  return 0
end
def f32_to_int(): Int
  x: F32 = 7.9
  return to_int(x)
end
def f32_roundtrip(): Int
  x: F32 = 1.5
  y: F64 = to_f64(x)
  z: F32 = to_f32(y)
  if z == x
    return 1
  end
  return 0
end
def f32_precision(): Int
  y: F32 = 1.00000005
  f32_one: F32 = 1.0
  if y == f32_one
    return 1
  end
  return 0
end
