## Simd F32X4 Tests
##
## Contract:
##   1. Adds two vectors element-wise.
##   2. Divides two vectors element-wise.
##   3. Dot product of two.
##   4. Emits <4 x float>.
##   5. Extracts all four lanes.
##   6. Loads 4 floats from.
import * from qspec

def main(): Int
  describe("SIMD F32x4") do ->
    it("splat and extract lane 0") do ->
      assert_eq(sf4_splat_extract(), 3)
    end
    it("extracts all four lanes from splat") do ->
      assert_eq(sf4_all_lanes(), 28)
    end
    it("adds two vectors element-wise") do ->
      assert_eq(sf4_add(), 15)
    end
    it("subtracts two vectors element-wise") do ->
      assert_eq(sf4_sub(), 13)
    end
    it("multiplies two vectors element-wise") do ->
      assert_eq(sf4_mul(), 42)
    end
    it("divides two vectors element-wise") do ->
      assert_eq(sf4_div(), 25)
    end
    it("sums all four lanes") do ->
      assert_eq(sf4_sum(), 20)
    end
    it("loads 4 floats from f32_vec") do ->
      assert_eq(sf4_load(), 10)
    end
    it("stores SIMD register back into f32_vec") do ->
      assert_eq(sf4_store(), 36)
    end
    it("dot product of two 4-element vectors") do ->
      assert_eq(sf4_dot(), 70)
    end
    it("emits <4 x float> vector instructions (IR test)") do ->
      assert_ir_contains("""
def main(): Int
  v = simd_f32x4_splat(1.0)
  return to_int(simd_f32x4_extract(v, 0))
end
""", "insertelement <4 x float>")
    end
  end
  return qspec_main()
end

def sf4_splat_extract(): Int
  var v = simd_f32x4_splat(3.0)
  return to_int(simd_f32x4_extract(v, 0))
end
def sf4_all_lanes(): Int
  var v = simd_f32x4_splat(7.0)
  var a = to_int(simd_f32x4_extract(v, 0))
  var b = to_int(simd_f32x4_extract(v, 1))
  var c = to_int(simd_f32x4_extract(v, 2))
  var d = to_int(simd_f32x4_extract(v, 3))
  return a + b + c + d
end
def sf4_add(): Int
  var a = simd_f32x4_splat(10.0)
  var b = simd_f32x4_splat(5.0)
  var c = simd_f32x4_add(a, b)
  return to_int(simd_f32x4_extract(c, 0))
end
def sf4_sub(): Int
  var a = simd_f32x4_splat(20.0)
  var b = simd_f32x4_splat(7.0)
  var c = simd_f32x4_sub(a, b)
  return to_int(simd_f32x4_extract(c, 2))
end
def sf4_mul(): Int
  var a = simd_f32x4_splat(6.0)
  var b = simd_f32x4_splat(7.0)
  var c = simd_f32x4_mul(a, b)
  return to_int(simd_f32x4_extract(c, 1))
end
def sf4_div(): Int
  var a = simd_f32x4_splat(100.0)
  var b = simd_f32x4_splat(4.0)
  var c = simd_f32x4_div(a, b)
  return to_int(simd_f32x4_extract(c, 3))
end
def sf4_sum(): Int
  var v = simd_f32x4_splat(5.0)
  return to_int(simd_f32x4_sum(v))
end
def sf4_load(): Int
  var v = vec_new<F32>()
  v.push(1.0)
  v.push(2.0)
  v.push(3.0)
  v.push(4.0)
  var s = simd_f32x4_load(v, 0)
  var a = to_int(simd_f32x4_extract(s, 0))
  var b = to_int(simd_f32x4_extract(s, 1))
  var c = to_int(simd_f32x4_extract(s, 2))
  var d = to_int(simd_f32x4_extract(s, 3))
  return a + b + c + d
end
def sf4_store(): Int
  var v = vec_new<F32>()
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  v.push(0.0)
  var s = simd_f32x4_splat(9.0)
  simd_f32x4_store(s, v, 0)
  var a = to_int(v[0])
  var b = to_int(v[1])
  var c = to_int(v[2])
  var d = to_int(v[3])
  return a + b + c + d
end
def sf4_dot(): Int
  var a = vec_new<F32>()
  a.push(1.0)
  a.push(2.0)
  a.push(3.0)
  a.push(4.0)
  var b = vec_new<F32>()
  b.push(5.0)
  b.push(6.0)
  b.push(7.0)
  b.push(8.0)
  var va = simd_f32x4_load(a, 0)
  var vb = simd_f32x4_load(b, 0)
  var prod = simd_f32x4_mul(va, vb)
  return to_int(simd_f32x4_sum(prod))
end
