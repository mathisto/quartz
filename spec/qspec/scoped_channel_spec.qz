## Scoped Channel — B.8 Phase 5 (close-on-scope-exit; throw-safe).
##
## Contract:
##   1. `with chan_scope(ch) do h -> body end` binds h = ch and closes
##      the channel on normal block exit.
##   2. After block exit, `channel_closed(ch)` is true and a fresh
##      receive observes EOF.
##   3. On throw inside the body, the channel is still closed —
##      release_on_throw mirrors release for channels (both close).
##   4. Sequential `with`-blocks against distinct channels don't leak
##      handles — each is closed at its own block boundary.
##   5. Sending values inside the block, then closing-on-exit, lets
##      a same-thread try_recv drain the queued values then observe
##      the closed flag.

import * from qspec
import * from std/sync/communication/channel
import * from std/throws

# --- Test 1: normal exit closes the channel. ----------------------------

def b8_chan_normal_exit_closes(): Int
  var ch = channel_new(4)
  with chan_scope(ch) do h ->
    send(h, 7)
  end
  # After block exit, the channel must be closed.
  if channel_closed(ch)
    return 1
  end
  return 0
end

# --- Test 2: queued values drain after close. ---------------------------

def b8_chan_drain_after_close(): Int
  var ch = channel_new(4)
  with chan_scope(ch) do h ->
    send(h, 100)
    send(h, 200)
    send(h, 300)
  end
  # Channel is closed, but the 3 queued values should still drain via
  # try_recv (which returns Option<Int>).
  var sum = 0
  var opt = try_recv(ch)
  while option_is_some(opt)
    sum = sum + load(opt, 1)
    opt = try_recv(ch)
  end
  return sum
end

# --- Test 3: sequential channels close independently. -------------------

def b8_chan_sequential_independent(): Int
  var c1 = channel_new(2)
  var c2 = channel_new(2)
  with chan_scope(c1) do h1 ->
    send(h1, 1)
  end
  # c1 closed; c2 still open.
  if channel_closed(c2)
    return -1
  end
  with chan_scope(c2) do h2 ->
    send(h2, 2)
  end
  # Both closed.
  var c1_closed = 0
  var c2_closed = 0
  if channel_closed(c1)
    c1_closed = 1
  end
  if channel_closed(c2)
    c2_closed = 1
  end
  return c1_closed + c2_closed
end

# --- Phase 4b throw-safety tests ----------------------------------------

var b8_chan_caught = 0

def b8_chan_capture_throw(op_name: Int, argc: Int, argv: Int): Int
  b8_chan_caught += 1
  return 0
end

# --- Test 4: throw inside Scoped fires channel_close. -------------------

def b8_chan_throw_closes_channel(): Int
  var ch = channel_new(4)
  with Throws { throw: b8_chan_capture_throw } do ->
    with chan_scope(ch) do h ->
      send(h, 42)
      throw("mid-stream")
    end
    0
  end
  # Channel should be closed; queued values still drain.
  if not channel_closed(ch)
    return -1
  end
  var opt = try_recv(ch)
  if not option_is_some(opt)
    return -2
  end
  return load(opt, 1)
end

# --- Test 5: panic inside Scoped fires channel_close. -------------------

def b8_chan_panic_closes_channel(): Int
  var ch = channel_new(2)
  with Throws { throw: b8_chan_capture_throw } do ->
    with chan_scope(ch) do h ->
      send(h, 99)
      panic("kaboom-chan")
    end
    0
  end
  if not channel_closed(ch)
    return -1
  end
  var opt = try_recv(ch)
  if not option_is_some(opt)
    return -2
  end
  return load(opt, 1)
end

def main(): Int
  describe("Scoped Channel — B.8 Phase 5") do ->
    it("normal exit closes the channel") do ->
      assert_eq(b8_chan_normal_exit_closes(), 1)
    end

    it("queued values drain after close-on-exit") do ->
      assert_eq(b8_chan_drain_after_close(), 600)
    end

    it("sequential channels close independently") do ->
      assert_eq(b8_chan_sequential_independent(), 2)
    end

    it("throw inside Scoped fires channel_close; queued value drains") do ->
      assert_eq(b8_chan_throw_closes_channel(), 42)
    end

    it("panic inside Scoped fires channel_close; queued value drains") do ->
      assert_eq(b8_chan_panic_closes_channel(), 99)
    end
  end

  return qspec_main()
end
