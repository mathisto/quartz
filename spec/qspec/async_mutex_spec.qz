import * from qspec

# ============================================================================
# Async Mutex — scheduler-aware, non-blocking mutual exclusion
# ============================================================================

# --- Test 1: Single task lock/unlock ---

def test_single_lock(): Int
  var mtx = async_mutex_new(100)
  var val = async_mutex_lock(mtx)
  async_mutex_unlock(mtx, val + 1)
  var result = async_mutex_get(mtx)
  async_mutex_free(mtx)
  return result
end

# --- Test 2: try_lock semantics ---

def test_try_lock(): Int
  var mtx = async_mutex_new(0)
  # First try_lock should succeed
  var ok1 = async_mutex_try_lock(mtx)
  # Second try_lock should fail (already locked)
  var ok2 = async_mutex_try_lock(mtx)
  async_mutex_unlock(mtx, 0)
  # Third try_lock should succeed (unlocked)
  var ok3 = async_mutex_try_lock(mtx)
  async_mutex_unlock(mtx, 0)
  async_mutex_free(mtx)
  # ok1=1, ok2=0, ok3=1 → 1+0+1 = 2
  return ok1 + ok2 + ok3
end

# --- Test 3: Value-carrying mutex ---

def test_value_carrying(): Int
  var mtx = async_mutex_new(10)
  var v1 = async_mutex_lock(mtx)
  async_mutex_unlock(mtx, v1 * 2)
  var v2 = async_mutex_lock(mtx)
  async_mutex_unlock(mtx, v2 + 5)
  var result = async_mutex_get(mtx)
  async_mutex_free(mtx)
  return result
end

# --- Test 4: Two tasks contending — one parks, other completes, parked wakes ---

var g_mtx4 = 0
var g_result4 = 0

def contender_a(): Int
  var val = async_mutex_lock(g_mtx4)
  # Hold lock briefly, increment value
  async_mutex_unlock(g_mtx4, val + 10)
  return 0
end

def contender_b(): Int
  var val = async_mutex_lock(g_mtx4)
  async_mutex_unlock(g_mtx4, val + 20)
  return 0
end

def test_two_contenders(): Int
  g_mtx4 = async_mutex_new(0)
  sched_init(2)
  var ha = go contender_a()
  var hb = go contender_b()
  await ha
  await hb
  sched_shutdown()
  var result = async_mutex_get(g_mtx4)
  async_mutex_free(g_mtx4)
  return result
end

# --- Test 5: N tasks contending — all eventually acquire and release ---

var g_mtx5 = 0

def increment_worker(): Int
  var val = async_mutex_lock(g_mtx5)
  async_mutex_unlock(g_mtx5, val + 1)
  return 0
end

def test_n_contenders(): Int
  g_mtx5 = async_mutex_new(0)
  sched_init(4)
  var n = 10
  var handles = vec_new()
  var i = 0
  while i < n
    handles.push(go increment_worker())
    i = i + 1
  end
  i = 0
  while i < n
    await handles[i]
    i = i + 1
  end
  sched_shutdown()
  var result = async_mutex_get(g_mtx5)
  async_mutex_free(g_mtx5)
  return result
end

# --- Test 6: Stress test — many tasks, many lock/unlock cycles ---

var g_mtx6 = 0

def stress_worker(cycles: Int): Int
  var i = 0
  while i < cycles
    var val = async_mutex_lock(g_mtx6)
    async_mutex_unlock(g_mtx6, val + 1)
    i = i + 1
  end
  return 0
end

def test_stress(): Int
  g_mtx6 = async_mutex_new(0)
  var num_tasks = 8
  var cycles = 50
  sched_init(4)
  var handles = vec_new()
  var i = 0
  while i < num_tasks
    handles.push(go stress_worker(cycles))
    i = i + 1
  end
  i = 0
  while i < num_tasks
    await handles[i]
    i = i + 1
  end
  sched_shutdown()
  var result = async_mutex_get(g_mtx6)
  async_mutex_free(g_mtx6)
  return result
end

# --- Test 7: Lock two different mutexes in same function (name collision regression) ---

var g_mtx7a = 0
var g_mtx7b = 0

def double_lock_worker(): Int
  var va = async_mutex_lock(g_mtx7a)
  var vb = async_mutex_lock(g_mtx7b)
  async_mutex_unlock(g_mtx7b, vb + 1)
  async_mutex_unlock(g_mtx7a, va + 10)
  return 0
end

def test_double_lock(): Int
  g_mtx7a = async_mutex_new(100)
  g_mtx7b = async_mutex_new(200)
  sched_init(2)
  var h = go double_lock_worker()
  await h
  sched_shutdown()
  var ra = async_mutex_get(g_mtx7a)
  var rb = async_mutex_get(g_mtx7b)
  async_mutex_free(g_mtx7a)
  async_mutex_free(g_mtx7b)
  return ra + rb
end

# --- Test 8: Mixed park/wake + async_mutex (interop test) ---

var g_mtx8 = 0
var g_parked8 = 0

def mutex_then_park(): Int
  var val = async_mutex_lock(g_mtx8)
  async_mutex_unlock(g_mtx8, val + 1)
  # Now park ourselves — waker will resume us
  atomic_store(g_parked8, task_frame())
  sched_park()
  return 0
end

def wake_parked8(): Int
  # Wait for parked task
  var frame = 0
  while frame == 0
    frame = atomic_load(g_parked8)
    sched_yield()
  end
  sched_wake(frame)
  return 0
end

def test_mutex_plus_park(): Int
  g_mtx8 = async_mutex_new(0)
  g_parked8 = atomic_new(0)
  sched_init(2)
  var h1 = go mutex_then_park()
  var h2 = go wake_parked8()
  await h1
  await h2
  sched_shutdown()
  var result = async_mutex_get(g_mtx8)
  async_mutex_free(g_mtx8)
  return result
end

# --- Main ---

def main(): Int
  describe("async mutex") do ->
    it("single task lock/unlock") do ->
      assert_eq(test_single_lock(), 101)
    end

    it("try_lock semantics") do ->
      assert_eq(test_try_lock(), 2)
    end

    it("value-carrying: lock returns value, unlock stores new") do ->
      assert_eq(test_value_carrying(), 25)
    end

    it("two tasks contending") do ->
      assert_eq(test_two_contenders(), 30)
    end

    it("N=10 tasks contending") do ->
      assert_eq(test_n_contenders(), 10)
    end

    it("stress: 8 tasks x 50 cycles = 400 increments") do ->
      assert_eq(test_stress(), 400)
    end

    it("lock two different mutexes in same function") do ->
      assert_eq(test_double_lock(), 311)
    end

    it("async_mutex + sched_park interop") do ->
      assert_eq(test_mutex_plus_park(), 1)
    end
  end

  return qspec_main()
end
