## Endless Def Tests
##
## Contract:
##   1. Endless def: `def f(x): T = expr` single-expression body.
##   2. Type inference: return type matches body expression.
##   3. Composition: endless defs calling other endless defs.
##   4. Coexistence: endless and block defs interchangeable.

import * from qspec

def main(): Int
  describe("basic endless def") do ->
    it("parses single expression body") do ->
      assert_eq(ed_double(21), 42)
    end

    it("supports string concatenation") do ->
      assert_eq(ed_len("hello"), 5)
    end

    it("supports function calls in body") do ->
      assert_eq(ed_compute(20), 41)
    end

    it("works with zero parameters") do ->
      assert_eq(ed_answer(), 42)
    end

    it("coexists with block defs") do ->
      assert_eq(ed_quick(20) + ed_verbose(20), 42)
    end
  end

  describe("type checking") do ->
    it("infers return matches declared type") do ->
      if ed_is_positive(5)
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end
  end

  describe("endless def edge cases") do ->
    it("multiple parameters") do ->
      assert_eq(ed_add(20, 22), 42)
    end

    it("chain of endless defs") do ->
      assert_eq(ed_mul(ed_add(3, 4), ed_double(3)), 42)
    end

    it("boolean endless def") do ->
      assert_eq(ed_is_positive(42), true)
      assert_eq(ed_is_positive(-1), false)
    end
  end

  return qspec_main()
end

def ed_double(x: Int): Int = x * 2
def ed_len(s: String): Int = s.size
def ed_add(a: Int, b: Int): Int = a + b
def ed_mul(a: Int, b: Int): Int = a * b
def ed_compute(x: Int): Int = ed_add(ed_mul(x, 2), 1)
def ed_answer(): Int = 42

def ed_quick(x: Int): Int = x + 1

def ed_verbose(x: Int): Int
  var result = x
  result = result + 1
  return result
end

def ed_is_positive(x: Int): Bool = x > 0
