## Named Arguments Tests — LF2.4
##
## Contract:
##   1. All defaults no args.
##   2. All defaults provide all.
##   3. All defaults provide one.
##   4. All named in order.
##   5. All named reordered.
##   6. Mixed positional and named.

import * from qspec

def na_add(a: Int, b: Int): Int = a + b

def na_three(x: Int, y: Int = 10, z: Int = 20): Int = x + y + z

def na_all_defaults(a: Int = 1, b: Int = 2, c: Int = 3): Int = a + b + c

def na_mixed(first: Int, second: Int = 0, third: Int = 0): Int
  return first * 100 + second * 10 + third
end

def na_greet(name: String, greeting: String): String
  return "#{greeting}, #{name}!"
end

# Helpers for assert_output
def print_named_greet(): Void = puts(na_greet(name: "Alice", greeting: "Hey"))
def print_reordered_greet(): Void = puts(na_greet(greeting: "Yo", name: "Bob"))
def print_mixed_greet(): Void = puts(na_greet("Charlie", greeting: "Sup"))
def print_nested(): Void = puts("#{na_add(a: na_add(b: 3, a: 1), b: 2)}")  # (1+3) + 2 = 6

def main(): Int
  describe("Named arguments") do ->

    it("all named in order") do ->
      assert_eq(na_add(a: 5, b: 7), 12)
    end

    it("all named reordered") do ->
      assert_eq(na_add(b: 20, a: 10), 30)
    end

    it("mixed positional and named") do ->
      assert_eq(na_add(10, b: 20), 30)
    end

    it("skip middle default") do ->
      assert_eq(na_three(1, z: 30), 41)
    end

    it("skip trailing default via name") do ->
      assert_eq(na_three(1, y: 5), 26)
    end

    it("named fills only non-default") do ->
      assert_eq(na_three(x: 100), 130)
    end

    it("all defaults provide one by name") do ->
      assert_eq(na_all_defaults(c: 30), 33)
    end

    it("all defaults provide all reordered") do ->
      assert_eq(na_all_defaults(c: 30, a: 10, b: 20), 60)
    end

    it("mixed with gap in middle") do ->
      assert_eq(na_mixed(5, third: 3), 503)
    end

    it("named string args in order") do ->
      assert_output("Hey, Alice!\n", print_named_greet)
    end

    it("named string args reordered") do ->
      assert_output("Yo, Bob!\n", print_reordered_greet)
    end

    it("mixed positional and named string") do ->
      assert_output("Sup, Charlie!\n", print_mixed_greet)
    end

    it("pure positional still works") do ->
      assert_eq(na_add(1, 2), 3)
    end

    it("positional with defaults still works") do ->
      assert_eq(na_three(1), 31)
    end

    it("positional with some defaults") do ->
      assert_eq(na_three(1, 2), 23)
    end

    it("nested named arg calls") do ->
      assert_output("6\n", print_nested)
    end

    it("named arg with expression") do ->
      assert_eq(na_add(a: 2 + 3, b: 4 * 5), 25)
    end

    it("all defaults no args") do ->
      assert_eq(na_all_defaults(), 6)
    end

  end

  return qspec_main()
end
