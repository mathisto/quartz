##! Regression for `__map_get_raw` — internal sentinel lookup intrinsic.
##!
##! Exercises both key-type-specialized codegen paths:
##!   - String keys → __hashmap_get_sentinel (cg_intrinsic_data.qz)
##!   - Int keys    → intmap_get_sentinel    (cg_intrinsic_intmap.qz)
##!
##! Returns the raw value on hit, 0 on miss, with no Option wrap.
##! Used internally by dedup caches that exclude 0 from their value space.

import * from qspec

def main(): Int
  describe("__map_get_raw — string keys (hashmap path)") do ->
    it("returns raw value on hit") do ->
      var m = map_new<String, Int>()
      m.set("alpha", 100)
      m.set("beta", 200)
      assert_eq(__map_get_raw(m, "alpha"), 100)
      assert_eq(__map_get_raw(m, "beta"), 200)
    end

    it("returns 0 sentinel on miss") do ->
      var m = map_new<String, Int>()
      m.set("present", 42)
      assert_eq(__map_get_raw(m, "absent"), 0)
    end

    it("returns 0 on empty map") do ->
      var m = map_new<String, Int>()
      assert_eq(__map_get_raw(m, "anything"), 0)
    end
  end

  describe("__map_get_raw — int keys (intmap path)") do ->
    it("returns raw value on hit") do ->
      var m = map_new<Int, Int>()
      m.set(1, 100)
      m.set(42, 4200)
      assert_eq(__map_get_raw(m, 1), 100)
      assert_eq(__map_get_raw(m, 42), 4200)
    end

    it("returns 0 sentinel on miss") do ->
      var m = map_new<Int, Int>()
      m.set(1, 100)
      assert_eq(__map_get_raw(m, 999), 0)
    end

    it("returns 0 on empty map") do ->
      var m = map_new<Int, Int>()
      assert_eq(__map_get_raw(m, 0), 0)
      assert_eq(__map_get_raw(m, 7), 0)
    end

    it("probes correctly through collisions") do ->
      # Exercises both pre-resize and post-resize paths.
      # Default cap is 16; resize triggers at 12 (3/4 load factor) and
      # doubles. With 64 inserts the table grows ≥ 16 → 32 → 64 → 128.
      var m = map_new<Int, Int>()
      var i = 0
      while i < 64
        m.set(i, i * 10)
        i = i + 1
      end
      i = 0
      while i < 64
        assert_eq(__map_get_raw(m, i), i * 10)
        i = i + 1
      end
      assert_eq(__map_get_raw(m, 100), 0)
    end

    it("survives many inserts without hanging (resize works)") do ->
      var m = map_new<Int, Int>()
      var i = 0
      while i < 256
        m.set(i, i + 1000)
        i = i + 1
      end
      assert_eq(__map_get_raw(m, 0), 1000)
      assert_eq(__map_get_raw(m, 100), 1100)
      assert_eq(__map_get_raw(m, 255), 1255)
      assert_eq(__map_get_raw(m, 999), 0)
    end
  end

  return qspec_main()
end
