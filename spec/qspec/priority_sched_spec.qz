import * from qspec

def _qspec_is_slow(): Int = 1

def main(): Int
  describe("priority scheduling") do ->
    it("go with sched_init: basic spawn and recv") do ->
      sched_init(0)
      var ch = channel_new(1)
      go do -> send(ch, 42) end
      assert_eq(recv(ch), 42)
      sched_shutdown()
    end

    it("multiple tasks: all priority levels complete") do ->
      sched_init(0)
      var ch = channel_new(10)
      go do -> send(ch, 1) end
      go do -> send(ch, 2) end
      go do -> send(ch, 3) end
      var sum = recv(ch) + recv(ch) + recv(ch)
      sched_shutdown()
      assert_eq(sum, 6)
    end
  end
  return qspec_main()
end
