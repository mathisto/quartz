## Is Binding Tests

import * from qspec

def main(): Int
  describe("is with bindings") do ->
    it("binds Some payload") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(42)
          if opt is Some(x)
            return x
          end
          return 0
        end
        """, 42)
    end

    it("skips None with binding pattern") do ->
      assert_run_exits("""
        def main(): Int
          var opt = option_none()
          var result = 99
          if opt is Some(x)
            result = x
          end
          return result
        end
        """, 99)
    end

    it("binds Ok payload") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Ok(7)
          if r is Ok(v)
            return v
          end
          return 0
        end
        """, 7)
    end

    it("binds Err payload") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Err(42)
          if r is Err(e)
            return e
          end
          return 0
        end
        """, 42)
    end

    it("works with else branch") do ->
      assert_run_exits("""
        def is_bind_with_else(opt: Int): Int
          if opt is Some(x)
            return x
          else
            return 99
          end
        end
        def main(): Int
          var a = is_bind_with_else(Option::Some(10))
          var b = is_bind_with_else(option_none())
          return a + b
        end
        """, 109)
    end

    it("binding not visible after if") do ->
      assert_compile_error("""
        def main(): Int
          var opt = Option::Some(42)
          if opt is Some(x)
            puts("got")
          end
          return x
        end
        """, "Undefined variable: x")
    end

    it("works with user-defined payload enum") do ->
      assert_run_exits("""
        enum Shape
          Circle(radius: Int)
          Rect(w: Int, h: Int)
        end
        def main(): Int
          var s = Shape::Circle(7)
          if s is Circle(r)
            return r
          end
          return 0
        end
        """, 7)
    end

    it("wildcard binding discards payload") do ->
      assert_run_exits("""
        def main(): Int
          var opt = Option::Some(42)
          if opt is Some(_)
            return 1
          end
          return 0
        end
        """, 1)
    end

    it("non-matching variant with binding skips body") do ->
      assert_run_exits("""
        def main(): Int
          var r = Result::Err(99)
          if r is Ok(v)
            return v
          end
          return 55
        end
        """, 55)
    end
  end

  return qspec_main()
end
