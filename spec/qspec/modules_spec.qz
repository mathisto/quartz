## Modules Tests
##
## Contract:
##   1. Private visibility.
##   2. Import statement parsing.
##   3. File resolution.
##   4. Circular dependency detection.
##   5. Visibility across modules.
##   6. Cross-module generic types.
##   7. Path imports.
##   8. Impl/extend blocks across modules.
##   9. Cross-module enum access.

import * from qspec
import math_helper
import enum_module

def mod_helper(): Int
  return 42
end

def mod_secret(): Int
  return 99
end

def mod_api(): Int
  return mod_secret()
end

def mod_public_func(): Int
  return 1
end

def mod_internal(): Int
  return 2
end

def mod_a(): Int
  return 1
end

def mod_b(): Int
  return 2
end

def mod_c(): Int
  return 3
end

def mod_multi_api(): Int
  return mod_a() + mod_b() + mod_c()
end

def main(): Int
  describe("private visibility") do ->
    it("allows calling functions before private marker") do ->
      assert_eq(mod_helper(), 42)
    end

    it("allows calling functions after private marker from same module") do ->
      assert_eq(mod_api(), 99)
    end

    it("parses private as section marker not expression") do ->
      assert_eq(mod_public_func() + mod_internal(), 3)
    end

    it("allows multiple functions after private") do ->
      assert_eq(mod_multi_api(), 6)
    end

    it("works with no private section") do ->
      assert_eq(mod_helper(), 42)
    end

    it("works with private at end of file") do ->
      assert_eq(42, 42)
    end
  end

  describe("import statement parsing") do ->
    it("lexes and parses import without error") do ->
      assert_eq(math_helper::math_add(1, 1), 2)
    end

    it("parses import with alias") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("alias_mod.qz"))
      var alias_mod_src = """
def alias_val(): Int = 42
"""
      vec_push(files, as_int(alias_mod_src))
      vec_push(files, as_int("main.qz"))
      var alias_main_src = """
import alias_mod as am
def main(): Int
  return am::alias_val()
end
"""
      vec_push(files, as_int(alias_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("parses from import star") do ->
      assert_eq(0, 0)
    end

    it("parses from import with multiple names") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("mmod_ab.qz"))
      var mmod_ab_src = """
def mmod_fn_a(): Int = 10
def mmod_fn_b(): Int = 32
"""
      vec_push(files, as_int(mmod_ab_src))
      vec_push(files, as_int("main.qz"))
      var mmod_ab_main_src = """
from mmod_ab import mmod_fn_a, mmod_fn_b
def main(): Int
  return mmod_fn_a() + mmod_fn_b()
end
"""
      vec_push(files, as_int(mmod_ab_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("parses from import with specific symbol") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("mmod_sym.qz"))
      var mmod_sym_src = """
def mmod_sym_val(): Int = 42
def mmod_sym_other(): Int = 99
"""
      vec_push(files, as_int(mmod_sym_src))
      vec_push(files, as_int("main.qz"))
      var mmod_sym_main_src = """
from mmod_sym import mmod_sym_val
def main(): Int
  return mmod_sym_val()
end
"""
      vec_push(files, as_int(mmod_sym_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("allows multiple import statements") do ->
      assert_eq(math_helper::math_add(1, 1), 2)
    end
  end

  describe("file resolution") do ->
    it("resolves import from fixtures directory") do ->
      assert_eq(math_helper::math_add(1, 2), 3)
    end
    it("calls multiple functions from imported module") do ->
      assert_eq(math_helper::math_multiply(6, 7), 42)
    end
    it("resolves qualified call syntax") do ->
      assert_eq(math_helper::math_square(5), 25)
    end
    it("supports module.function() dot syntax (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("dotmod.qz"))
      vec_push(files, as_int("def dot_val(): Int = 42"))
      vec_push(files, as_int("main.qz"))
      var dotmod_main_src = """
import dotmod
def main(): Int
  return dotmod.dot_val()
end
"""
      vec_push(files, as_int(dotmod_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("module.func() dot syntax in var assignment") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("dotmod2.qz"))
      vec_push(files, as_int("def dot_compute(): Int = 42"))
      vec_push(files, as_int("main.qz"))
      var dotmod2_main_src = """
import dotmod2
def main(): Int
  var result = dotmod2.dot_compute()
  return result
end
"""
      vec_push(files, as_int(dotmod2_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("resolves from import with specific symbol (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("calc_sel.qz"))
      var calc_sel_src = """
def calc_sel_double(x: Int): Int = x * 2
def calc_sel_triple(x: Int): Int = x * 3
"""
      vec_push(files, as_int(calc_sel_src))
      vec_push(files, as_int("main.qz"))
      var calc_sel_main_src = """
from calc_sel import calc_sel_double
def main(): Int
  return calc_sel_double(21)
end
"""
      vec_push(files, as_int(calc_sel_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("resolves import with alias (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("calcmod.qz"))
      vec_push(files, as_int("def calc_double(x: Int): Int = x * 2"))
      vec_push(files, as_int("main.qz"))
      var calcmod_main_src = """
import calcmod as c
def main(): Int
  return c::calc_double(21)
end
"""
      vec_push(files, as_int(calcmod_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("errors when imported module not found") do ->
      var err_src = """
import nonexistent_module
def main(): Int
  return 0
end
"""
      assert_compile_error(err_src, "cannot find module")
    end
    it("resolves directory module with mod.qz (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("dirmod/mod.qz"))
      vec_push(files, as_int("def dirmod_val(): Int = 42"))
      vec_push(files, as_int("main.qz"))
      var dirmod_main_src = """
import dirmod
def main(): Int
  return dirmod::dirmod_val()
end
"""
      vec_push(files, as_int(dirmod_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("resolves chained imports (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("chain_c.qz"))
      vec_push(files, as_int("def chain_val(): Int = 42"))
      vec_push(files, as_int("chain_b.qz"))
      var chain_b_src = """
import chain_c
def chain_get(): Int
  return chain_c::chain_val()
end
"""
      vec_push(files, as_int(chain_b_src))
      vec_push(files, as_int("chain_a.qz"))
      var chain_a_src = """
import chain_b
def chain_result(): Int
  return chain_b::chain_get()
end
"""
      vec_push(files, as_int(chain_a_src))
      vec_push(files, as_int("main.qz"))
      var chain_main_src = """
import chain_a
def main(): Int
  return chain_a::chain_result()
end
"""
      vec_push(files, as_int(chain_main_src))
      assert_multi_run_exits(files, 3, 42)
    end
  end

  describe("mutual imports") do ->
    it("allows direct circular import") do ->
      var circ_src = """
import circ_a
def main(): Int
  return 0
end
"""
      var r = subprocess_compile_with_fixtures(circ_src)
      assert_eq(r.exit_code, 0)
    end
    it("allows self-import") do ->
      var self_src = """
import self_importer
def main(): Int
  return 0
end
"""
      var r = subprocess_compile_with_fixtures(self_src)
      assert_eq(r.exit_code, 0)
    end
  end

  describe("visibility across modules") do ->
    it("can call public functions from imported module") do ->
      assert_eq(math_helper::math_abs(-5), 5)
    end
    it("errors when calling private function from another module") do ->
      var priv_err_src = """
import math_helper
def main(): Int
  return math_helper::math_internal()
end
"""
      assert_compile_error_with_fixtures(priv_err_src, "has no function")
    end
  end

  describe("cross-module generic types") do ->
    it("supports module.Type in return position (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("shapes.qz"))
      var shapes_src = """
struct ShBox
  w: Int
  h: Int
end
def sh_make(w: Int, h: Int): ShBox
  return ShBox { w: w, h: h }
end
def sh_area(b: ShBox): Int
  return b.w * b.h
end
"""
      vec_push(files, as_int(shapes_src))
      vec_push(files, as_int("main.qz"))
      var shapes_main_src = """
import shapes
def get_box(): shapes::ShBox
  return shapes::sh_make(6, 7)
end
def main(): Int
  return shapes::sh_area(get_box())
end
"""
      vec_push(files, as_int(shapes_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
    it("supports module.Enum<T> generic return types (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("enummod.qz"))
      var enummod_src = """
enum MyOption<T>
  Some(val: Int)
  None
end
def make_some(x: Int): MyOption<Int>
  return MyOption::Some(x)
end
"""
      vec_push(files, as_int(enummod_src))
      vec_push(files, as_int("main.qz"))
      var enummod_main_src = """
import enummod
def main(): Int
  var r = enummod::make_some(42)
  match r
    Some(v) => return v
    None => return 0
  end
end
"""
      vec_push(files, as_int(enummod_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("path imports") do ->
    ## Path resolution tests moved to modules_path_spec.qz (SIGSEGV limit)
  end

  describe("impl/extend blocks across modules") do ->
    it("supports impl method calling module-internal helper") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("helper_mod.qz"))
      var helper_mod_src = """
struct Point
  x: Int
  y: Int
end
def point_sum_helper(a: Int, b: Int): Int
  return a + b
end
trait Summable
  def total(p: Int): Int
    return 0
  end
end
extend Point with Summable
  def total(p: Int): Int
    return point_sum_helper(10, 32)
  end
end
"""
      vec_push(files, as_int(helper_mod_src))
      vec_push(files, as_int("main.qz"))
      var helper_main_src = """
import helper_mod
def main(): Int
  p = Point { x: 10, y: 32 }
  return helper_mod::Point::total(p)
end
"""
      vec_push(files, as_int(helper_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("supports impl method calling private helper (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("priv_mod.qz"))
      var priv_mod_src = """
struct PPoint
  x: Int
  y: Int
end
trait PSummable
  def ptotal(p: Int): Int
    return 0
  end
end
extend PPoint with PSummable
  def ptotal(p: Int): Int
    return priv_add(10, 32)
  end
end
priv
def priv_add(a: Int, b: Int): Int
  return a + b
end
"""
      vec_push(files, as_int(priv_mod_src))
      vec_push(files, as_int("main.qz"))
      var priv_main_src = """
import priv_mod
def main(): Int
  p = PPoint { x: 10, y: 32 }
  return priv_mod::PPoint::ptotal(p)
end
"""
      vec_push(files, as_int(priv_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("supports extend method calling module-internal helper (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("ext_mod.qz"))
      var ext_mod_src = """
struct ExtBox
  val: Int
end
def ext_helper(a: Int, b: Int): Int
  return a + b
end
extend ExtBox
  def ext_compute(): Int
    return ext_helper(self.val, 2)
  end
end
"""
      vec_push(files, as_int(ext_mod_src))
      vec_push(files, as_int("main.qz"))
      var ext_main_src = """
import ext_mod
def main(): Int
  b = ExtBox { val: 40 }
  return ext_mod::ExtBox::ext_compute(b)
end
"""
      vec_push(files, as_int(ext_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("supports impl method calling another top-level function with args (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("calc_mod.qz"))
      var calc_mod_src = """
struct CalcBox
  value: Int
end
trait Calculable
  def cb_calc(s: Int, x: Int): Int
    return 0
  end
end
def cb_helper(a: Int, b: Int): Int
  return a + b
end
extend CalcBox with Calculable
  def cb_calc(s: Int, x: Int): Int
    return cb_helper(x, 2)
  end
end
"""
      vec_push(files, as_int(calc_mod_src))
      vec_push(files, as_int("main.qz"))
      var calc_main_src = """
import calc_mod
def main(): Int
  c = CalcBox { value: 0 }
  return calc_mod::CalcBox::cb_calc(c, 40)
end
"""
      vec_push(files, as_int(calc_main_src))
      assert_multi_run_exits(files, 1, 42)
    end

    it("supports top-level function calling impl method in same module (multi-file test)") do ->
      var files: Vec = vec_new()
      vec_push(files, as_int("api_mod.qz"))
      var api_mod_src = """
struct ApiObj
  val: Int
end
trait ApiValuable
  def api_get_val(x: Int): Int
    return 0
  end
end
extend ApiObj with ApiValuable
  def api_get_val(x: Int): Int
    return 42
  end
end
def api_extract(obj: ApiObj): Int
  return ApiObj::api_get_val(obj)
end
"""
      vec_push(files, as_int(api_mod_src))
      vec_push(files, as_int("main.qz"))
      var api_main_src = """
import api_mod
def main(): Int
  a = ApiObj { val: 1 }
  return api_mod::api_extract(a)
end
"""
      vec_push(files, as_int(api_main_src))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("cross-module enum access") do ->
    it("accesses enum variant from imported module") do ->
      assert_eq(mod_test_enum_variant(), 4)
    end
    it("uses internal functions with cross-module enums") do ->
      assert_eq(mod_test_enum_func(), 3)
    end
  end

  return qspec_main()
end

def mod_test_enum_variant(): Int
  s = ModShape::Square
  return enum_module::mod_shape_sides(s)
end

def mod_test_enum_func(): Int
  t = ModShape::Triangle
  return enum_module::mod_shape_sides(t)
end
