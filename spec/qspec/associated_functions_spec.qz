## Associated Functions Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Type.method syntax") do ->
    it("defines and calls a static associated function") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def Point.origin(): Int = 0
        def main(): Int = Point.origin()
        """, 0)
    end

    it("defines and calls an associated function with args") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def Point.new(x: Int, y: Int): Int = x + y
        def main(): Int = Point.new(20, 22)
        """, 42)
    end

    it("defines instance method with self parameter") do ->
      assert_run_exits("""
        struct Foo
          x: Int
        end
        def Foo.get_x(self: Foo): Int = self.x
        def main(): Int
          f = Foo { x: 42 }
          return Foo.get_x(f)
        end
        """, 42)
    end

    it("supports multiple associated functions per type") do ->
      assert_run_exits("""
        struct Vec2
          x: Int
          y: Int
        end
        def Vec2.zero(): Int = 0
        def Vec2.add(a: Int, b: Int): Int = a + b
        def main(): Int
          return Vec2.zero() + Vec2.add(20, 22)
        end
        """, 42)
    end

    it("calls instance method with dot syntax using lowercase receiver") do ->
      assert_run_exits("""
        struct Foo
          x: Int
        end
        def Foo.get_x(self: Foo): Int = self.x
        def main(): Int
          f = Foo { x: 42 }
          return f.get_x()
        end
        """, 42)
    end

    it("distinguishes Type.method from instance.field") do ->
      assert_run_exits("""
        struct Pair
          x: Int
          y: Int
        end
        def Pair.sum(self: Pair): Int = self.x + self.y
        def main(): Int
          p = Pair { x: 20, y: 22 }
          return p.sum()
        end
        """, 42)
    end

    it("static function returns computed value") do ->
      assert_run_exits("""
        struct Box
          val: Int
        end
        def Box.make(n: Int): Int = n * 2
        def main(): Int = Box.make(21)
        """, 42)
    end

    it("instance method accesses multiple fields") do ->
      assert_run_exits("""
        struct Vec3
          x: Int
          y: Int
          z: Int
        end
        def Vec3.magnitude_sq(self: Vec3): Int = self.x * self.x + self.y * self.y + self.z * self.z
        def main(): Int
          v = Vec3 { x: 1, y: 2, z: 3 }
          return v.magnitude_sq()
        end
        """, 14)
    end

    ## item 38 regression — an ASSOCIATED (receiver-less, `Type::fn`) constructor
    ## in an `extend` block on a `@value` struct that RETURNS the struct. The
    ## registry injects a phantom leading `self`; when the struct is value-layout
    ## that phantom param 0 used to be register-DECOMPOSED → `inttoptr 0; load f0`
    ## → SIGSEGV. The decompose predicates now exclude an associated fn's phantom
    ## self (mir.qz assoc_phantom_self), so this returns the field cleanly.
    it("associated constructor on @value struct in extend block (item 38)") do ->
      assert_run_exits("""
        @value
        struct Box
          value: Int
        end
        extend Box
          def make(v: Int): Box = Box { value: v }
        end
        def main(): Int
          var b = Box::make(42)
          return b.value
        end
        """, 42)
    end
  end

  return qspec_main()
end
