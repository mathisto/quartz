## Option<Tuple> niche-representation tests (B.10 §14 N3 item 6.4e).
##
## A Quartz tuple literal is a FLAT heap allocation (`mir_lower.qz`
## NODE_TUPLE_LITERAL: `tuple_ptr = mir_emit_alloc(slots)`) returning a non-null,
## header-less pointer — structurally identical to a boxed struct. No valid tuple
## is 0, so `0`/`nil` is a free extra inhabitant ⇒ `Option<(A, B)>` can reuse `0`
## for `None` (none_const = 0, a boxed-pointer null niche — NOT a top niche K).
##
## *** NICHE IS LIVE ***
## The Tuple niche machinery is ENABLED: `mir_boxed_niche_tuple_live()` returns 1
## in self-hosted/backend/mir.qz, so `Option<(A, B)>` uses the zero-cost
## boxed-pointer null niche (None == 0/nil, Some(p) == the tuple's heap pointer)
## — NOT the tagged-box spill layout. These tests lock the observable behavior of
## the live niche: identical source must read identically regardless of the
## physical representation.
##
## Coverage:
##   - Some((A, B)) round-trip: is Some / .is_some() / match Some(t) => / .unwrap()
##   - None of Option<(A, B)>: is None / .is_none() / match None =>
##   - None distinct from any Some((A, B)) (the nil=0 boxed-niche soundness property)
##   - round-trip through a function arg + return (call-arg/return slots)
##   - mixed-type tuples ((Int, String)) and arity-3 tuples
##   - nested tuples inside the Option ((( Int, Int), Int))
##   - NESTED Option<Option<(A, B)>>: Some(None) must differ from outer None
##   - Vec<Option<(A, B)>> round-trip (the seam that broke String/struct in 6.4a/b)
##   - STRUCT-FIELD seams (6.4b regression net): Vec<Option<(A, B)>> as a struct
##     field (field.push / field[i]=) and a direct Option<(A, B)> field assign
##     (`obj.opt = Option::None`) — the exact non-IDENT-receiver niche_expected
##     seam that SIGSEGV'd when String was niched (cce7ef78). Type-agnostic, so it
##     SHOULD already carry tuple payloads; these tests prove it.
import * from qspec

def main(): Int
  describe("Option<(Int, Int)> niche — Some round-trip") do ->
    it("is Some for a constructed Some((Int, Int))") do ->
      opt = Option::Some((3, 4))
      assert_eq(opt is Some, 1)
    end
    it("is_some() true / is_none() false for Some") do ->
      opt = Option::Some((3, 4))
      assert_eq(opt.is_some(), 1)
      assert_eq(opt.is_none(), 0)
    end
    it("matches Some(t) and recovers both elements") do ->
      opt = Option::Some((11, 22))
      v = match opt
        Some(t) => t.0 + t.1
        None => -1
      end
      assert_eq(v, 33)
    end
    it("unwrap() returns the payload tuple") do ->
      opt = Option::Some((7, 8))
      t = opt.unwrap()
      assert_eq(t.0, 7)
      assert_eq(t.1, 8)
    end
    it("Some((0, 0)) — all-zero element tuple is still a non-null box ⇒ Some") do ->
      # The element VALUES are 0, but the tuple is a heap pointer (non-null), so
      # under the boxed-pointer null niche it stays Some, never aliasing None=nil.
      opt = Option::Some((0, 0))
      assert_eq(opt is Some, 1)
      assert_eq(opt is None, 0)
      t = opt.unwrap()
      assert_eq(t.0 + t.1, 0)
    end
  end

  describe("Option<(Int, Int)> niche — None") do ->
    it("is None for an explicit None") do ->
      opt = none_pair()
      assert_eq(opt is None, 1)
    end
    it("is_none() true / is_some() false for None") do ->
      opt = none_pair()
      assert_eq(opt.is_none(), 1)
      assert_eq(opt.is_some(), 0)
    end
    it("matches the None arm") do ->
      opt = none_pair()
      v = match opt
        Some(t) => t.0
        None => 0
      end
      assert_eq(v, 0)
    end
  end

  describe("Option<(Int, Int)> niche — None distinct from every Some") do ->
    it("None != Some((0, 0)) (the nil=0 collision catch-net)") do ->
      assert_eq(disc(none_pair()), 0)
      assert_eq(disc(Option::Some((0, 0))), 1)
    end
    it("None != Some((1, 2))") do ->
      assert_eq(disc(Option::Some((1, 2))), 1)
    end
  end

  describe("Option<(Int, String)> niche — mixed-type tuple") do ->
    it("Some((Int, String)) round-trips both fields") do ->
      opt = Option::Some((42, "hello"))
      v = match opt
        Some(t) => if t.0 == 42 and t.1 == "hello" then 1 else 0 end
        None => -1
      end
      assert_eq(v, 1)
    end
    it("None of Option<(Int, String)> is None") do ->
      assert_eq(none_mixed() is None, 1)
    end
  end

  describe("Option<(Int, Int, Int)> niche — arity-3 tuple") do ->
    it("Some((a, b, c)) recovers all three") do ->
      opt = Option::Some((10, 20, 30))
      t = opt.unwrap()
      assert_eq(t.0 + t.1 + t.2, 60)
    end
  end

  describe("Option<((Int, Int), Int)> niche — nested tuple payload") do ->
    it("Some of a tuple-containing-tuple round-trips") do ->
      opt = Option::Some(((1, 2), 3))
      t = opt.unwrap()
      inner = t.0
      assert_eq(inner.0 + inner.1 + t.1, 6)
    end
  end

  describe("Option<(Int, Int)> niche — round-trip through call boundary") do ->
    it("passes Some((Int, Int)) as arg and returns it, elements intact") do ->
      opt = rt_pair(Option::Some((5, 9)))
      v = match opt
        Some(t) => t.0 + t.1
        None => -1
      end
      assert_eq(v, 14)
    end
    it("passes None through arg+return as None") do ->
      opt = rt_pair(none_pair())
      assert_eq(opt is None, 1)
    end
  end

  describe("Option<Option<(Int, Int)>> nested — soundness catch-net") do ->
    it("Some(None) is outer-Some (distinguishable from outer-None)") do ->
      opt = op_some_none()
      assert_eq(opt is Some, 1)
    end
    it("Some(None): inner is None") do ->
      opt = op_some_none()
      inner_is_none = match opt
        Some(inner) => if inner is None then 1 else 0 end
        None => -1
      end
      assert_eq(inner_is_none, 1)
    end
    it("outer None is distinct from Some(None)") do ->
      assert_eq(op_outer_none() is None, 1)
    end
    it("Some(Some((Int, Int))) reaches the inner tuple") do ->
      opt = op_some_some()
      v = match opt
        Some(inner) => match inner
          Some(t) => t.0 + t.1
          None => -2
        end
        None => -1
      end
      assert_eq(v, 7)
    end
  end

  describe("Vec<Option<(Int, Int)>> round-trip") do ->
    it("stores Some/None elements and reads them back") do ->
      # The `vec_new<Option<(Int, Int)>>()` explicit-type-arg form does not parse
      # (nested tuple inside the generic angle brackets), so annotate the binding.
      var v: Vec<Option<(Int, Int)>> = vec_new()
      v.push(Option::Some((1, 2)))
      v.push(none_pair())
      v.push(Option::Some((3, 4)))
      assert_eq(v.size, 3)
      assert_eq(v[0] is Some, 1)
      assert_eq(v[1] is None, 1)
      assert_eq(v[2] is Some, 1)
    end
    it("recovers the tuple from a Some element") do ->
      var v: Vec<Option<(Int, Int)>> = vec_new()
      v.push(Option::Some((20, 22)))
      first = v[0]
      r = match first
        Some(t) => t.0 + t.1
        None => -1
      end
      assert_eq(r, 42)
    end
  end

  describe("Vec<Option<(Int, Int)>> as a STRUCT FIELD — niche construct/read parity") do ->
    # The historical SIGSEGV shape (6.4b, String at cce7ef78): a `field.push(None)`
    # where the receiver is a struct FIELD, not a local var. The niche_expected
    # threading for collection-insert is type-agnostic, so a tuple payload SHOULD
    # round-trip through the field seam exactly as String/struct does. Prove it.
    it("field.push(Some) then push(None) reads back Some/None correctly") do ->
      var h = PairHolder { pairs: new_pair_vec() }
      h.pairs.push(Option::Some((3, 4)))
      h.pairs.push(none_pair())
      assert_eq(h.pairs.size, 2)
      assert_eq(h.pairs[0] is Some, 1)
      t = h.pairs[0].unwrap()
      assert_eq(t.0, 3)
      assert_eq(t.1, 4)
      assert_eq(h.pairs[1] is None, 1)
    end
    it("match over a field element fires the None arm (no spill-box leak)") do ->
      var h = PairHolder { pairs: new_pair_vec() }
      h.pairs.push(none_pair())
      r = match h.pairs[0]
        Some(t) => t.0 + t.1
        None => -7
      end
      assert_eq(r, -7)
    end
    it("field[i] = None preserves None after a Some was stored") do ->
      var h = PairHolder { pairs: new_pair_vec() }
      h.pairs.push(Option::Some((9, 9)))
      h.pairs[0] = none_pair()
      assert_eq(h.pairs[0] is None, 1)
    end
    it("field.push(Some((0, 0))) stays Some (non-null box, never None)") do ->
      var h = PairHolder { pairs: new_pair_vec() }
      h.pairs.push(Option::Some((0, 0)))
      assert_eq(h.pairs[0] is Some, 1)
      assert_eq(h.pairs[0] is None, 0)
    end
  end

  describe("direct Option<(Int, Int)> field assign — niche construct/read parity") do ->
    # `obj.opt_pair = Option::None` on a niche-eligible Option<(Int, Int)> field
    # must construct the niche None (0), not a spill box — the String SIGSEGV site.
    it("obj.opt_pair = Some reads back the payload tuple") do ->
      var b = PairBox { opt_pair: none_pair() }
      b.opt_pair = Option::Some((5, 6))
      assert_eq(b.opt_pair is Some, 1)
      t = b.opt_pair.unwrap()
      assert_eq(t.0, 5)
      assert_eq(t.1, 6)
    end
    it("obj.opt_pair = None reads back as None after a Some") do ->
      var b = PairBox { opt_pair: Option::Some((5, 6)) }
      b.opt_pair = Option::None
      assert_eq(b.opt_pair is None, 1)
    end
    it("match over a field-loaded tuple-option binds both elements") do ->
      var b = PairBox { opt_pair: Option::Some((40, 2)) }
      r = match b.opt_pair
        Some(t) => t.0 + t.1
        None => -1
      end
      assert_eq(r, 42)
    end
    it("obj.opt_pair = Some((0, 0)) is Some, not None") do ->
      var b = PairBox { opt_pair: none_pair() }
      b.opt_pair = Option::Some((0, 0))
      assert_eq(b.opt_pair is Some, 1)
      assert_eq(b.opt_pair is None, 0)
    end
  end

  return qspec_main()
end

# Builds an empty Vec<Option<(Int, Int)>> — the `vec_new<Option<(Int, Int)>>()`
# explicit-type-arg form does not parse (nested tuple in the angle brackets), so
# the typed-return annotation on this helper supplies the element type.
def new_pair_vec(): Vec<Option<(Int, Int)>>
  return vec_new()
end

struct PairHolder
  pairs: Vec<Option<(Int, Int)>>
end

struct PairBox
  opt_pair: Option<(Int, Int)>
end

def none_pair(): Option<(Int, Int)>
  return Option::None
end

def none_mixed(): Option<(Int, String)>
  return Option::None
end

def rt_pair(o: Option<(Int, Int)>): Option<(Int, Int)>
  return o
end

# Discriminant helper: 0 for None, 1 for Some — used to assert None != any Some.
def disc(o: Option<(Int, Int)>): Int
  return match o
    Some(t) => 1
    None => 0
  end
end

def op_some_none(): Option<Option<(Int, Int)>>
  return Option::Some(none_pair())
end

def op_outer_none(): Option<Option<(Int, Int)>>
  return Option::None
end

def op_some_some(): Option<Option<(Int, Int)>>
  return Option::Some(Option::Some((3, 4)))
end
