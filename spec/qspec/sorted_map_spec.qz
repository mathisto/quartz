## Sorted Map Tests
##
## Contract:
##   1. New: `sorted_map_new` creates empty map with size 0.
##   2. Set/get: stores and retrieves values by key.
##   3. Overwrite: setting same key updates value.
##   4. Missing: get on missing key returns 0.
##   5. Has: checks key existence.
##   6. Delete: removes a key, size decreases.
##   7. Min/max: returns min and max keys.
##   8. Sorted: maintains sorted key order.
##   9. Size: size tracks set/delete.
##   10. Delete non-existent: no crash, size unchanged.
import * from qspec
import * from collections/sorted_map

def main(): Int
  describe("sorted_map_new") do ->
    it("creates an empty map") do ->
      var m = sorted_map_new()
      assert_eq(m.size(), 0)
      assert_eq(m.is_empty(), 1)
      m.free()
    end
  end

  describe("set and get") do ->
    it("stores and retrieves values") do ->
      assert_eq(sm_set_get_test(), 1)
    end

    it("overwrites existing keys") do ->
      assert_eq(sm_overwrite_test(), 1)
    end

    it("returns 0 for missing keys") do ->
      var m = sorted_map_new()
      assert_eq(m.get(42), 0)
      m.free()
    end
  end

  describe("has") do ->
    it("checks key existence") do ->
      assert_eq(sm_has_test(), 1)
    end
  end

  describe("delete") do ->
    it("removes a key") do ->
      assert_eq(sm_delete_test(), 1)
    end
  end

  describe("min_key / max_key") do ->
    it("returns min and max keys") do ->
      assert_eq(sm_min_max_test(), 1)
    end
  end

  describe("sorted order") do ->
    it("maintains sorted key order") do ->
      assert_eq(sm_sorted_test(), 1)
    end
  end

  describe("size tracking") do ->
    it("size tracks set and delete") do ->
      var m = sorted_map_new()
      m.set(1, 10)
      assert_eq(m.size(), 1)
      m.set(2, 20)
      assert_eq(m.size(), 2)
      m.delete(1)
      assert_eq(m.size(), 1)
      m.free()
    end

    it("delete non-existent key does not crash") do ->
      var m = sorted_map_new()
      m.set(1, 10)
      m.delete(99)
      assert_eq(m.size(), 1)
      m.free()
    end
  end

  return qspec_main()
end

def sm_set_get_test(): Int
  var m = sorted_map_new()
  m.set(3, 30)
  m.set(1, 10)
  m.set(2, 20)
  var a = m.get(1)
  var b = m.get(2)
  var c = m.get(3)
  m.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def sm_overwrite_test(): Int
  var m = sorted_map_new()
  m.set(1, 10)
  m.set(1, 99)
  var val = m.get(1)
  m.free()
  if val == 99
    return 1
  end
  return 0
end

def sm_has_test(): Int
  var m = sorted_map_new()
  m.set(5, 50)
  var has_5 = m.has(5)
  var has_6 = m.has(6)
  m.free()
  if has_5
    if not has_6
      return 1
    end
  end
  return 0
end

def sm_delete_test(): Int
  var m = sorted_map_new()
  m.set(1, 10)
  m.set(2, 20)
  m.set(3, 30)
  m.delete(2)
  var sz = m.size()
  var has_2 = m.has(2)
  m.free()
  if sz == 2
    if not has_2
      return 1
    end
  end
  return 0
end

def sm_min_max_test(): Int
  var m = sorted_map_new()
  m.set(50, 500)
  m.set(10, 100)
  m.set(30, 300)
  var mn = m.min_key()
  var mx = m.max_key()
  m.free()
  if mn == 10
    if mx == 50
      return 1
    end
  end
  return 0
end

def sm_sorted_test(): Int
  var m = sorted_map_new()
  m.set(5, 50)
  m.set(1, 10)
  m.set(3, 30)
  m.set(4, 40)
  m.set(2, 20)
  # Keys should be in order: 1, 2, 3, 4, 5
  # Check via min/max and size
  var ok = 1
  if m.size() != 5
    ok = 0
  end
  if m.min_key() != 1
    ok = 0
  end
  if m.max_key() != 5
    ok = 0
  end
  if m.get(3) != 30
    ok = 0
  end
  m.free()
  return ok
end
