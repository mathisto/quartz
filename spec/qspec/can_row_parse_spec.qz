## can-Row Parse Suffix (Operation Piezoelectric Effects, Milestone A)
##
## Verifies function signatures accept a trailing `can Row` clause.
## Milestone A parses the row and discards it — the function compiles and
## runs as if `can` were absent. Later milestones wire the row into
## TcRegistry for effect-row inference.

import * from qspec

def piezo_can_pure(x: Int): Int = x

def piezo_can_single(x: Int): Int can Log = x + 1

def piezo_can_multi(x: Int): Int can FileIo, NetIo = x + 2

def piezo_can_parameterized(x: Int): Int can Throws<Int> = x + 3

def piezo_can_tail(x: Int): Int can Log | e = x + 4

def main(): Int
  describe("can-row parses on function signatures") do ->
    it("pure function (no can) still compiles") do ->
      assert_eq(piezo_can_pure(10), 10)
    end

    it("single label accepted") do ->
      assert_eq(piezo_can_single(10), 11)
    end

    it("multiple comma-separated labels accepted") do ->
      assert_eq(piezo_can_multi(10), 12)
    end

    it("parameterized label accepted") do ->
      assert_eq(piezo_can_parameterized(10), 13)
    end

    it("tail-variable polymorphism accepted") do ->
      assert_eq(piezo_can_tail(10), 14)
    end
  end
  return qspec_main()
end
