## Same-module wildcard-vs-qualified import dedup — regression for the
## resolver bug closed 2026-05-23.
##
## Failure mode: when one module imports M via wildcard
## (`import * from M`) and another module separately imports M
## qualified (`import M`, then `M::func()`), `resolve_process_imports`
## was mode-blind on the second visit — it saw M already loaded and
## skipped collecting funcs again under the new prefix. `M$func` was
## never registered, qualified call sites tripped QZ0401 (or the
## inverse for qualified-first + bare-second).
##
## Fix: re-collect against the cached AST when a re-import asks for a
## (prefix, is_wildcard) combination not yet registered for that module.
## Surfaced via std/terminal.qz wildcarding std/ffi/socket while
## std/net/tcp.qz qualified-imported the same module.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("same-module wildcard + qualified import") do ->
    it("wildcard-first then qualified-second resolves both surfaces") do ->
      var files: Vec = vec_new()
      files.push(as_int("lex.qz"))
      files.push(as_int("def foo(): Int = 42"))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from lex
        def shout(): Int = foo()
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import lex
        def quiet(): Int = lex::foo()
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import qual
        def main(): Int = wild::shout() + qual::quiet()
        """))
      assert_multi_run_exits(files, 3, 84)
    end

    it("qualified-first then wildcard-second resolves both surfaces") do ->
      var files: Vec = vec_new()
      files.push(as_int("lex.qz"))
      files.push(as_int("def foo(): Int = 7"))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from lex
        def shout(): Int = foo()
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import lex
        def quiet(): Int = lex::foo()
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import qual
        import wild
        def main(): Int = wild::shout() + qual::quiet()
        """))
      assert_multi_run_exits(files, 3, 14)
    end

    it("multi-function module: both bare and prefixed lookups resolve") do ->
      var files: Vec = vec_new()
      files.push(as_int("mathx.qz"))
      vec_push(files, as_int("""
        def add(a: Int, b: Int): Int = a + b
        def mul(a: Int, b: Int): Int = a * b
        """))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from mathx
        def w(): Int = add(3, 4)
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import mathx
        def q(): Int = mathx::mul(3, 4)
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import qual
        def main(): Int = wild::w() + qual::q()
        """))
      # 7 + 12 = 19
      assert_multi_run_exits(files, 3, 19)
    end

    it("aliased qualified import after wildcard registers under alias") do ->
      var files: Vec = vec_new()
      files.push(as_int("util.qz"))
      files.push(as_int("def pick(): Int = 11"))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from util
        def w(): Int = pick()
        """))
      files.push(as_int("aliased.qz"))
      vec_push(files, as_int("""
        import util as u
        def a(): Int = u::pick()
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import aliased
        def main(): Int = wild::w() + aliased::a()
        """))
      assert_multi_run_exits(files, 3, 22)
    end

    it("repeat qualified import of the same module is a no-op") do ->
      var files: Vec = vec_new()
      files.push(as_int("dup.qz"))
      files.push(as_int("def fetch(): Int = 13"))
      files.push(as_int("c1.qz"))
      vec_push(files, as_int("""
        import dup
        def f(): Int = dup::fetch()
        """))
      files.push(as_int("c2.qz"))
      vec_push(files, as_int("""
        import dup
        def g(): Int = dup::fetch()
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import c1
        import c2
        def main(): Int = c1::f() + c2::g()
        """))
      assert_multi_run_exits(files, 3, 26)
    end

    it("const decl: wildcard-first then qualified-second resolves both sides") do ->
      var files: Vec = vec_new()
      files.push(as_int("cm.qz"))
      vec_push(files, as_int("""
        const FORTY = 40
        const TWO = 2
        """))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from cm
        def w(): Int = FORTY + TWO
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import cm
        def q(): Int = cm::FORTY + cm::TWO
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import qual
        def main(): Int = wild::w() + qual::q()
        """))
      assert_multi_run_exits(files, 3, 84)
    end

    it("const decl: qualified-first then wildcard-second resolves both sides") do ->
      var files: Vec = vec_new()
      files.push(as_int("cm.qz"))
      vec_push(files, as_int("""
        const TEN = 10
        const THREE = 3
        """))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from cm
        def w(): Int = TEN + THREE
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import cm
        def q(): Int = cm::TEN + cm::THREE
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import qual
        import wild
        def main(): Int = wild::w() + qual::q()
        """))
      assert_multi_run_exits(files, 3, 26)
    end

    # Global var via wildcard + qualified — shared storage through LLVM
    # alias. Writes through either name visible to reads through the other.
    it("global var: shared storage via LLVM alias") do ->
      var files: Vec = vec_new()
      files.push(as_int("gm.qz"))
      vec_push(files, as_int("""
        var COUNTER: Int = 0

        def bump(): Int
          COUNTER = COUNTER + 1
          return COUNTER
        end

        def peek(): Int = COUNTER
        """))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from gm
        def w_bump(): Int = bump()
        def w_peek(): Int = peek()
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import gm
        def q_bump(): Int = gm::bump()
        def q_peek(): Int = gm::peek()
        def q_direct(): Int = gm::COUNTER
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import qual
        def main(): Int
          var a = wild::w_bump()    # COUNTER=1, returns 1
          var b = qual::q_bump()    # COUNTER=2, returns 2
          var c = wild::w_peek()    # returns 2 (shared storage)
          var d = qual::q_peek()    # returns 2
          var e = qual::q_direct()  # returns 2 — direct gm::COUNTER access
          return a + b + c + d + e  # 1 + 2 + 2 + 2 + 2 = 9
        end
        """))
      assert_multi_run_exits(files, 3, 9)
    end

    # Mixed function + const access — both kinds routed correctly.
    # Values chosen to fit in the 8-bit Unix exit code (sum < 256).
    it("function + const mix: wildcard-first / qualified-second") do ->
      var files: Vec = vec_new()
      files.push(as_int("mix.qz"))
      vec_push(files, as_int("""
        const BASE = 50
        def bump(n: Int): Int = n + BASE
        """))
      files.push(as_int("wild.qz"))
      vec_push(files, as_int("""
        import * from mix
        def w(): Int = bump(5)
        """))
      files.push(as_int("qual.qz"))
      vec_push(files, as_int("""
        import mix
        def q(): Int = mix::bump(7) + mix::BASE
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import wild
        import qual
        def main(): Int = wild::w() + qual::q()
        """))
      # wild::w() = bump(5) = 5 + 50 = 55
      # qual::q() = bump(7) + BASE = (7+50) + 50 = 107
      # total = 162
      assert_multi_run_exits(files, 3, 162)
    end
  end

  return qspec_main()
end
