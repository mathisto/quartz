## FIX.6 Phase 4: Let-Polymorphism Tests
##
## Contract:
##   1. Identity function used at multiple types works.
##   2. Const lambda can be reused at different types.
##   3. Closures capturing values work polymorphically.
##   4. Value restriction: var bindings are monomorphic (but still work due to erasure).

import * from qspec

# Helper: apply an Int→Int function
def apply_int(f: Fn(Int): Int, x: Int): Int = f(x)

# Helper: apply a String→String function
def apply_str(f: Fn(String): String, s: String): String = f(s)

def print_poly_int(): Void
  identity = x -> x
  var a = apply_int(identity, 42)
  puts(str_from_int(a))
end

def print_poly_str(): Void
  identity = x -> x
  var b = apply_str(identity, "hello")
  puts(b)
end

def print_poly_both(): Void
  identity = x -> x
  var a = apply_int(identity, 42)
  var b = apply_str(identity, "world")
  puts(str_from_int(a))
  puts(b)
end

def print_const_reuse(): Void
  double = x -> x * 2
  var a = apply_int(double, 5)
  var b = apply_int(double, 10)
  puts(str_from_int(a))
  puts(str_from_int(b))
end

def print_closure_capture(): Void
  offset = 100
  add_offset = x -> x + offset
  var a = apply_int(add_offset, 5)
  var b = apply_int(add_offset, 10)
  puts(str_from_int(a))
  puts(str_from_int(b))
end

def main(): Int
  describe("let-polymorphism") do ->
    it("identity used as Int function") do ->
      assert_output("42\n", print_poly_int)
    end

    it("identity used as String function") do ->
      assert_output("hello\n", print_poly_str)
    end

    it("identity used at both types in same function") do ->
      assert_output("42\nworld\n", print_poly_both)
    end

    it("const lambda reused with same type") do ->
      assert_output("10\n20\n", print_const_reuse)
    end

    it("closure with captured value") do ->
      assert_output("105\n110\n", print_closure_capture)
    end
  end

  return qspec_main()
end
