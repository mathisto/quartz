## Variadic Extern Tests
##
## Contract:
##   1. Ir declares variadic extern.
##   2. Non-variadic extern does not.
##   3. Two variadic externs compile.
##   4. Variadic and non-variadic externs.
##   5. Variadic extern compiles successfully.
##   6. Variadic extern ir uses.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Variadic Extern") do ->
    it("IR declares variadic extern correctly") do ->
      assert_ir_contains("""
        extern "C" def printf(fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """, "declare i64 @printf(ptr, ...)")
    end

    it("variadic extern compiles successfully") do ->
      assert_compile_succeeds("""
        extern "C" def printf(fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("variadic extern with def keyword compiles") do ->
      assert_compile_succeeds("""
        extern "C" def printf(fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("variadic extern with no fixed params is error") do ->
      assert_compile_error("""
        extern "C" def variadic_only(...): Int
        def main(): Int
          return 0
        end
      """, "error")
    end

    it("variadic extern with multiple fixed params compiles") do ->
      assert_compile_succeeds("""
        extern "C" def fprintf(stream: CPtr, fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("variadic extern with Void return compiles") do ->
      assert_compile_succeeds("""
        extern "C" def my_log(fmt: CPtr, ...): Void
        def main(): Int
          return 0
        end
      """)
    end

    it("variadic extern with CInt return compiles") do ->
      assert_compile_succeeds("""
        extern "C" def snprintf(buf: CPtr, size: Int, fmt: CPtr, ...): CInt
        def main(): Int
          return 0
        end
      """)
    end

    it("two variadic externs compile together") do ->
      assert_compile_succeeds("""
        extern "C" def printf(fmt: CPtr, ...): Int
        extern "C" def fprintf(stream: CPtr, fmt: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("variadic extern IR uses correct calling convention") do ->
      assert_ir_contains("""
        extern "C" def my_variadic_fn(fmt: CPtr, n: Int, ...): Int
        def main(): Int
          return 0
        end
      """, "declare i64 @my_variadic_fn(ptr, i64, ...)")
    end

    it("variadic extern with single CPtr param compiles") do ->
      assert_compile_succeeds("""
        extern "C" def puts_like(s: CPtr, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("non-variadic extern does not have ... in IR") do ->
      assert_ir_contains("""
        extern "C" def abs(x: Int): Int
        def main(): Int
          return abs(-1)
        end
      """, "declare i64 @abs(i64)")
    end

    it("variadic and non-variadic externs coexist") do ->
      assert_compile_succeeds("""
        extern "C" def abs(x: Int): Int
        extern "C" def printf(fmt: CPtr, ...): Int
        def main(): Int
          return abs(-1)
        end
      """)
    end

    it("variadic extern with Int first param compiles") do ->
      assert_compile_succeeds("""
        extern "C" def ioctl(fd: Int, request: Int, ...): Int
        def main(): Int
          return 0
        end
      """)
    end

    it("calling variadic extern with actual varargs") do ->
      assert_run_stdout_eq("""
        extern "C" def snprintf(buf: CPtr, size: Int, fmt: CPtr, ...): Int
        def main(): Int
          var buf = mem_alloc(64)
          snprintf(buf, 64, "%d + %d = %d", 10, 20, 30)
          puts(as_string(buf))
          return 0
        end
        """, "10 + 20 = 30\n")
    end

    it("variadic extern with struct parameters compiles") do ->
      assert_compile_succeeds("""
        @value
        struct Point
          x: Int
          y: Int
        end
        extern "C" def custom_print(fmt: CPtr, ...): Int
        def main(): Int
          var p = Point { x: 1, y: 2 }
          return p.x + p.y
        end
      """)
    end
  end

  return qspec_main()
end

