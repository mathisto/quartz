## Macro Parsing Tests
##
## Contract:
##   1. Macro definitions.
##   2. Macro calls.
##   3. Quote blocks.
##   4. Error cases.
##   5. Macro hygiene.
##   6. Variadic macro arguments.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("macro definitions") do ->
    it("parses a simple macro definition with string template") do ->
      assert_run_stdout_eq(mp_simple_template_src(), "10\n")
    end
    it("parses a macro with multiple parameters") do ->
      assert_run_stdout_eq(mp_multi_param_src(), "6\n")
    end
    it("parses a macro with no parameters") do ->
      assert_run_exits(mp_no_param_src(), 0)
    end
  end

  describe("macro calls") do ->
    it("parses a macro call with dollar prefix") do ->
      assert_run_stdout_eq(mp_dollar_prefix_src(), "10\n")
    end
    it("parses a macro call with expression argument") do ->
      assert_run_exits(mp_expr_arg_src(), 0)
    end
    it("parses multiple macro calls") do ->
      assert_run_stdout_eq(mp_multi_calls_src(), "first\nsecond\n")
    end
  end

  describe("quote blocks") do ->
    it("parses quote block with expression") do ->
      assert_run_exits(mp_quote_expr_src(), 0)
    end
    it("expands quote macro with unquote substitution") do ->
      assert_run_stdout_eq(mp_quote_unquote_src(), "42\n")
    end
    it("expands quote macro to correct computation") do ->
      assert_run_stdout_eq(mp_quote_compute_src(), "49\n")
    end
  end

  describe("error cases") do ->
    it("rejects macro call without dollar prefix as regular function call") do ->
      assert_compile_error(mp_no_dollar_src(), "ndefined")
    end
  end

  describe("macro hygiene") do ->
    it("preserves user identifiers passed via unquote") do ->
      assert_run_stdout_eq(mp_hygiene_preserve_src(), "11\n")
    end
    it("hygiene context is initialized per macro expansion") do ->
      assert_run_stdout_eq(mp_hygiene_per_expansion_src(), "6\n")
    end
  end

  describe("macro composition") do ->
    it("macro result used as argument to another macro") do ->
      assert_run_stdout_eq(mp_nested_macro_src(), "20\n")
    end

    it("macro with arithmetic expression in template") do ->
      assert_run_stdout_eq(mp_arith_template_src(), "15\n")
    end

    it("macro expands in variable initializer") do ->
      assert_run_stdout_eq(mp_var_init_src(), "7\n")
    end
  end

  describe("variadic macro arguments") do ->
    it("parses a variadic macro definition with ... suffix") do ->
      assert_run_exits(mp_variadic_def_src(), 0)
    end
    it("accepts variable number of arguments to variadic macro") do ->
      assert_run_stdout_eq(mp_variadic_args_src(), "42\n42\n42\n")
    end
    it("variadic can be called with zero variadic args") do ->
      assert_run_exits(mp_variadic_zero_src(), 0)
    end
    it("supports mixed regular and variadic parameters") do ->
      assert_run_stdout_eq(mp_mixed_variadic_src(), "1\n")
    end
    it("variadic parameter must be last") do ->
      assert_compile_error(mp_variadic_last_src(), "ariadic")
    end
  end

  return qspec_main()
end

# --- Source helpers ---

def mp_simple_template_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  print_int($double(5))
  return 0
end
"""
end

def mp_multi_param_src(): String
  return """
macro add3(a, b, c) do
  quote do
    unquote(a) + unquote(b) + unquote(c)
  end
end

def main(): Int
  print_int($add3(1, 2, 3))
  return 0
end
"""
end

def mp_no_param_src(): String
  return """
macro noop() do
  quote do
    0
  end
end

def main(): Int
  $noop()
  return 0
end
"""
end

def mp_dollar_prefix_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  var y = $double(5)
  print_int(y)
  return 0
end
"""
end

def mp_expr_arg_src(): String
  return """
macro check(cond) do
  quote do
    unquote(cond)
  end
end

def main(): Int
  var x = 10
  $check(x > 0)
  return 0
end
"""
end

def mp_multi_calls_src(): String
  return """
macro say(msg) do
  quote do
    puts(unquote(msg))
  end
end

def main(): Int
  $say("first")
  $say("second")
  return 0
end
"""
end

def mp_quote_expr_src(): String
  return """
macro make_zero() do
  quote do
    0
  end
end

def main(): Int
  return $make_zero()
end
"""
end

def mp_quote_unquote_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  print_int($double(21))
  return 0
end
"""
end

def mp_quote_compute_src(): String
  return """
macro square(n) do
  quote do
    unquote(n) * unquote(n)
  end
end

def main(): Int
  print_int($square(7))
  return 0
end
"""
end

def mp_no_dollar_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  var y = double(5)
  return 0
end
"""
end

def mp_hygiene_preserve_src(): String
  return """
macro increment(var_ref) do
  quote do
    unquote(var_ref) + 1
  end
end

def main(): Int
  var x = 10
  print_int($increment(x))
  return 0
end
"""
end

def mp_hygiene_per_expansion_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  var a = $double(1)
  var b = $double(2)
  print_int(a + b)
  return 0
end
"""
end

def mp_variadic_def_src(): String
  return """
macro debug(values...) do
  quote do
    42
  end
end

def main(): Int
  return 0
end
"""
end

def mp_variadic_args_src(): String
  return """
macro print_all(values...) do
  quote do
    42
  end
end

def main(): Int
  var a = $print_all(1)
  var b = $print_all(1, 2, 3)
  var c = $print_all(1, 2, 3, 4, 5)
  print_int(a)
  print_int(b)
  print_int(c)
  return 0
end
"""
end

def mp_variadic_zero_src(): String
  return """
macro maybe(values...) do
  quote do
    0
  end
end

def main(): Int
  return $maybe()
end
"""
end

def mp_mixed_variadic_src(): String
  return """
macro log(level, messages...) do
  quote do
    unquote(level)
  end
end

def main(): Int
  print_int($log(1, "a", "b", "c"))
  return 0
end
"""
end

def mp_variadic_last_src(): String
  return """
macro bad(values..., extra) do
  quote do
    0
  end
end

def main(): Int
  return 0
end
"""
end

def mp_nested_macro_src(): String
  return """
macro double(x) do
  quote do
    unquote(x) + unquote(x)
  end
end

def main(): Int
  var a = $double(5)
  print_int($double(a))
  return 0
end
"""
end

def mp_arith_template_src(): String
  return """
macro triple(x) do
  quote do
    unquote(x) + unquote(x) + unquote(x)
  end
end

def main(): Int
  print_int($triple(5))
  return 0
end
"""
end

def mp_var_init_src(): String
  return """
macro add_one(x) do
  quote do
    unquote(x) + 1
  end
end

def main(): Int
  var result = $add_one(6)
  print_int(result)
  return 0
end
"""
end
