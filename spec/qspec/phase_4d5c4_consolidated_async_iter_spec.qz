## Phase 4D.5c.4 — Consolidate `lower_async_gen_iteration{,_indirect}` into
## `lower_stream_async_iteration(is_indirect: Bool)` + upgrade park branch
## to `mir_emit_async_suspend_point_raw` for dynamic rv propagation.
##
## Pre-4D.5c.4: two thin wrappers (`lower_async_gen_iteration`,
## `lower_async_gen_iteration_indirect`) each forwarded to a private
## `_lower_async_gen_iter_impl`. The shared impl's park branch called
## `mir_emit_async_suspend_point(ctx, -1, poll_block)` — which encoded
## `ret i64 0` regardless of the inner $poll's actual return value.
## Result: a park encoding (≤ -2 — fd registration) flowing up through
## the inner $poll was COLLAPSED to a yield-style park (0), losing the
## fd/timer info the scheduler needed to wake the consumer correctly.
##
## Post-4D.5c.4: one helper. Its park branch now calls
## `mir_emit_async_suspend_point_raw(ctx, status, poll_block, "park_resume")`.
## The dynamic SSA register `status` (the rv from the inner $poll) flows
## through unchanged as the consumer's outer $poll's return value, so the
## scheduler registers on the same fd/timer the inner $poll asked for.
##
## What this spec verifies:
## 1-4. End-to-end regression: NODE_CALL direct, NODE_IDENT-typed indirect,
##      NODE_FOR_AWAIT direct, NODE_FOR_AWAIT indirect — all four entry
##      points still compile + run after the helper consolidation.
## 5.   Composition: an async generator consuming another async generator
##      (consumer's for-in lowering inside an async caller's $poll body)
##      emits a `park_resume` block — concrete witness that the park
##      branch is now routed through `mir_emit_async_suspend_point_raw`
##      (the only emitter of that label inside the async-iter helper).
## 6.   Multi-yield runtime: the consolidated helper's POLL_SUSPENDED →
##      got_yield → body → re-poll loop carries multiple values out
##      correctly across both direct and indirect entry points.
##
## See docs/design/PHASE_4D_5C_CONSUMER_MERGE.md §"Architectural correction"
## (Path B) and §4D.5c.4 in the revised phase plan.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.5c.4 — consolidated lower_stream_async_iteration") do ->

    it("NODE_CALL direct: for v in async_gen() still works post-consolidation") do ->
      assert_run_exits("""
def src(): impl Iterator<Int> can Async
  yield 5
  yield 7
  yield 11
end

def main(): Int
  var total = 0
  for v in src()
    total = total + v
  end
  return total
end
""", 23)
    end

    it("NODE_IDENT-typed indirect: var s = async_gen(); for v in s still works") do ->
      assert_run_exits("""
def src(): impl Iterator<Int> can Async
  yield 13
  yield 17
end

def main(): Int
  var s = src()
  var total = 0
  for v in s
    total = total + v
  end
  return total
end
""", 30)
    end

    it("NODE_FOR_AWAIT direct: for await v in async_gen() compiles + runs") do ->
      assert_run_exits("""
def src(): impl Iterator<Int> can Async
  yield 2
  yield 3
end

def main(): Int
  var total = 0
  for await v in src()
    total = total + v
  end
  return total
end
""", 5)
    end

    it("NODE_FOR_AWAIT indirect: var s = async_gen(); for await v in s compiles + runs") do ->
      assert_run_exits("""
def src(): impl Iterator<Int> can Async
  yield 8
  yield 9
end

def main(): Int
  var s = src()
  var total = 0
  for await v in s
    total = total + v
  end
  return total
end
""", 17)
    end

    it("park_resume block emitted when consumer is inside an async caller's $poll") do ->
      # Composition: outer's $poll body contains a for-in over an async
      # generator. The consolidated helper's park branch now lives inside
      # outer's state machine and emits its resume block via
      # mir_emit_async_suspend_point_raw with label "park_resume".
      # Pre-4D.5c.4 the label was "yield_resume" (the legacy
      # mir_emit_async_suspend_point fd<0 path).
      assert_ir_contains("""
def inner(): impl Iterator<Int> can Async
  yield 1
end

def outer(): impl Iterator<Int> can Async
  for x in inner()
    yield x
  end
end

def main(): Int
  for v in outer()
    return v
  end
  return 0
end
""", "park_resume")
    end

    it("multi-yield via NODE_IDENT indirect carries all values out") do ->
      assert_run_exits("""
def src(): impl Iterator<Int> can Async
  yield 1
  yield 2
  yield 4
  yield 8
  yield 16
end

def main(): Int
  var s = src()
  var total = 0
  for v in s
    total = total + v
  end
  return total
end
""", 31)
    end

  end

  return qspec_main()
end
