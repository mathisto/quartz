## Packed Arrays Tests
##
## Contract:
##   1. Backward compat: regular vec.
##   2. Creates and gets one.
##   3. Dot product of two.
##   4. Element-wise scale loop.
##   5. Gets element by index.
##   6. Grows beyond initial capacity.
import * from qspec

def main(): Int
  describe("packed arrays (F32 vec)") do ->
    it("creates and gets one element") do ->
      assert_eq(pa_create_one(), 1)
    end
    it("pushes multiple elements and tracks length") do ->
      assert_eq(pa_push_multi(), 5)
    end
    it("gets element by index") do ->
      assert_eq(pa_get_by_index(), 20)
    end
    it("sets element by index") do ->
      assert_eq(pa_set_by_index(), 99)
    end
    it("grows beyond initial capacity") do ->
      assert_eq(pa_grow(), 20)
    end
    it("stores values with float precision") do ->
      assert_eq(pa_float_precision(), 3)
    end
    it("backward compat: regular vec still works") do ->
      assert_eq(pa_regular_vec(), 141)
    end
    it("sum reduction loop") do ->
      assert_eq(pa_sum_reduction(), 30)
    end
    it("element-wise scale loop") do ->
      assert_eq(pa_scale_loop(), 10)
    end
    it("dot product of two packed vectors") do ->
      assert_eq(pa_dot_product(), 32)
    end
    it("LLVM recognizes packed float memory access (IR test)") do ->
      assert_ir_contains("""
def main(): Int
  var v = vec_new<F32>()
  v.push(1.0)
  return 0
end
""", "fptrunc double")
    end
  end
  return qspec_main()
end

def pa_create_one(): Int
  var v = vec_new<F32>()
  v.push(3.14)
  return v.size
end

def pa_push_multi(): Int
  var v = vec_new<F32>()
  v.push(1.0)
  v.push(2.0)
  v.push(3.0)
  v.push(4.0)
  v.push(5.0)
  return v.size
end

def pa_get_by_index(): Int
  var v = vec_new<F32>()
  v.push(10.0)
  v.push(20.0)
  v.push(30.0)
  var val = v[1]
  return to_int(val)
end

def pa_set_by_index(): Int
  var v = vec_new<F32>()
  v.push(1.0)
  v.push(2.0)
  v.push(3.0)
  v.set(1, 99.0)
  var val = v[1]
  return to_int(val)
end

def pa_grow(): Int
  var v = vec_new<F32>()
  var i = 0
  while i < 20
    v.push(1.0)
    i += 1
  end
  return v.size
end

def pa_float_precision(): Int
  var v = vec_new<F32>()
  v.push(1.5)
  var val = v[0]
  var doubled = val * to_f32(2)
  return to_int(doubled)
end

def pa_regular_vec(): Int
  var v = vec_new()
  v.push(42)
  v.push(99)
  return v[0] + v[1]
end

def pa_sum_reduction(): Int
  var v = vec_new<F32>()
  var i = 0
  while i < 10
    v.push(3.0)
    i += 1
  end
  var sum: F32 = to_f32(0)
  var j = 0
  while j < 10
    var val = v[j]
    sum += val
    j += 1
  end
  return to_int(to_f64(sum))
end

def pa_scale_loop(): Int
  var v = vec_new<F32>()
  v.push(2.0)
  v.push(4.0)
  v.push(6.0)
  v.push(8.0)
  var i = 0
  while i < 4
    var val = v[i]
    v.set(i, val * to_f32(1) / to_f32(2))
    i += 1
  end
  var sum: F32 = to_f32(0)
  var j = 0
  while j < 4
    sum += v[j]
    j += 1
  end
  return to_int(to_f64(sum))
end

def pa_dot_product(): Int
  var a = vec_new<F32>()
  var b = vec_new<F32>()
  a.push(1.0)
  a.push(2.0)
  a.push(3.0)
  b.push(4.0)
  b.push(5.0)
  b.push(6.0)
  var sum: F32 = to_f32(0)
  var i = 0
  while i < 3
    var av = a[i]
    var product = av * b[i]
    sum += product
    i += 1
  end
  return to_int(to_f64(sum))
end

