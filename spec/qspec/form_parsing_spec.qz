## Form Parsing Spec — Tests for request_form with Content-Type validation

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers
# =============================================================================

def make_form_request(body: String, content_type: String): Request
  var hkeys = vec_new<String>()
  var hvals = vec_new<String>()
  if str_byte_len(content_type) > 0
    hkeys.push("Content-Type")
    hvals.push(content_type)
  end
  return Request {
    method: "POST", path: "/submit", query_string: "", body: body,
    raw_path: "/submit",
    header_keys: hkeys, header_vals: hvals,
    params: map_new(), query: map_new(), context: map_new()
  }
end

# =============================================================================
# Test helpers
# =============================================================================

def print_basic_form(): Void
  var req = make_form_request("name=alice&age=30", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => {
      match form.get("name")
        Some(v) => puts(v)
        _ => puts("missing")
      end
      match form.get("age")
        Some(v) => puts(v)
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

def print_wrong_content_type(): Void
  var req = make_form_request("name=alice", "application/json")
  match request_form(req)
    Ok(form) => puts("ok")
    Err(e) => puts("error")
  end
end

def print_missing_content_type(): Void
  var req = make_form_request("name=alice", "")
  match request_form(req)
    Ok(form) => puts("ok")
    Err(e) => puts("error")
  end
end

def print_empty_body(): Void
  var req = make_form_request("", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => puts("ok")
    Err(e) => puts("error")
  end
end

def print_charset_variant(): Void
  var req = make_form_request("x=1", "application/x-www-form-urlencoded; charset=UTF-8")
  match request_form(req)
    Ok(form) => {
      match form.get("x")
        Some(v) => puts(v)
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

def print_url_decoded(): Void
  var req = make_form_request("msg=hello%20world", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => {
      match form.get("msg")
        Some(v) => puts(v)
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

def print_plus_as_space(): Void
  var req = make_form_request("q=hello+world", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => {
      match form.get("q")
        Some(v) => puts(v)
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

def print_first_wins(): Void
  var req = make_form_request("color=red&color=blue", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => {
      match form.get("color")
        Some(v) => puts(v)
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

def print_key_no_value(): Void
  var req = make_form_request("flag&name=bob", "application/x-www-form-urlencoded")
  match request_form(req)
    Ok(form) => {
      match form.get("flag")
        Some(v) =>
          if str_byte_len(v) == 0
            puts("empty")
          else
            puts(v)
          end
        _ => puts("missing")
      end
    }
    Err(e) => puts("error")
  end
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("request_form") do ->
    it("parses basic form data") do ->
      assert_output("alice\n30\n", print_basic_form)
    end

    it("rejects wrong Content-Type") do ->
      assert_output("error\n", print_wrong_content_type)
    end

    it("rejects missing Content-Type") do ->
      assert_output("error\n", print_missing_content_type)
    end

    it("rejects empty body") do ->
      assert_output("error\n", print_empty_body)
    end

    it("accepts charset variant") do ->
      assert_output("1\n", print_charset_variant)
    end

    it("URL-decodes values") do ->
      assert_output("hello world\n", print_url_decoded)
    end

    it("decodes plus as space") do ->
      assert_output("hello world\n", print_plus_as_space)
    end

    it("first value wins for duplicate keys") do ->
      assert_output("red\n", print_first_wins)
    end

    it("handles keys without values") do ->
      assert_output("empty\n", print_key_no_value)
    end
  end

  return qspec_main()
end
