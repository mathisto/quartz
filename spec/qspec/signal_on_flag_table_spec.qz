## Per-signum signal_on_flag table behaviour tests.
##
## Covers the runtime's signal trampoline now keying flags by signum,
## not by single global slot. Tests use SIGUSR1 (30 on macOS, 10 on
## Linux) and SIGUSR2 (31 on macOS, 12 on Linux) — both safely raised
## without disturbing the test host.
##
## @since 5.28.x

import * from qspec

extern "C" def raise(sig: Int): Int

@cfg(os: "macos")
def _SIGUSR1(): Int = 30
@cfg(os: "linux")
def _SIGUSR1(): Int = 10

@cfg(os: "macos")
def _SIGUSR2(): Int = 31
@cfg(os: "linux")
def _SIGUSR2(): Int = 12

# Module-level flags: signal handlers need stable addresses, and the
# trampoline persists across tests within a process. Tests reset these
# explicitly at the top of each case.
var _flag_a = atomic_new(0)
var _flag_b = atomic_new(0)
var _flag_shared = atomic_new(0)

def _reset_flags(): Void
  atomic_store(_flag_a, 0)
  atomic_store(_flag_b, 0)
  atomic_store(_flag_shared, 0)
end

# ============================================================
# Cases
# ============================================================

def test_single_signal_sets_its_flag(): Void
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_a)
  raise(_SIGUSR1())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_a), 1)
end

def test_signal_does_not_set_other_signums_flag(): Void
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_a)
  signal_on_flag(_SIGUSR2(), _flag_b)
  raise(_SIGUSR1())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_b), 0)
end

def test_two_signals_route_to_distinct_flags(): Void
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_a)
  signal_on_flag(_SIGUSR2(), _flag_b)

  raise(_SIGUSR1())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_a), 1)
  assert_eq(atomic_load(_flag_b), 0)

  atomic_store(_flag_a, 0)
  raise(_SIGUSR2())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_a), 0)
  assert_eq(atomic_load(_flag_b), 1)
end

def test_two_signals_can_share_one_flag(): Void
  ## http_server pattern: SIGTERM and SIGINT both trigger the same
  ## shutdown flag.
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_shared)
  signal_on_flag(_SIGUSR2(), _flag_shared)

  raise(_SIGUSR1())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_shared), 1)

  atomic_store(_flag_shared, 0)
  raise(_SIGUSR2())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_shared), 1)
end

def test_re_install_same_signum_redirects_to_new_flag(): Void
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_a)
  signal_on_flag(_SIGUSR1(), _flag_b)

  raise(_SIGUSR1())
  sleep_ms(50)
  ## After re-install, only the most recent flag should be set.
  assert_eq(atomic_load(_flag_a), 0)
  assert_eq(atomic_load(_flag_b), 1)
end

def test_uninstalled_signum_leaves_flags_untouched(): Void
  ## SIGCHLD is not installed; the trampoline scans the table, finds
  ## no match, and does nothing. (We don't raise() it directly here —
  ## SIGCHLD has no test value; instead we just confirm that after
  ## installing _SIGUSR1, _flag_b is not touched by an unrelated raise.)
  _reset_flags()
  signal_on_flag(_SIGUSR1(), _flag_a)
  raise(_SIGUSR1())
  sleep_ms(50)
  assert_eq(atomic_load(_flag_b), 0)
end

# ============================================================
# Driver
# ============================================================

def main(): Int
  describe("per-signum signal_on_flag routing") do ->
    it("sets its own flag on signal delivery") do ->
      test_single_signal_sets_its_flag()
    end
    it("does not set other signums' flags") do ->
      test_signal_does_not_set_other_signums_flag()
    end
    it("routes distinct signals to distinct flags") do ->
      test_two_signals_route_to_distinct_flags()
    end
    it("allows two signals to share one flag (http_server pattern)") do ->
      test_two_signals_can_share_one_flag()
    end
    it("re-install of same signum redirects to the new flag") do ->
      test_re_install_same_signum_redirects_to_new_flag()
    end
    it("uninstalled signums leave their flag slot untouched") do ->
      test_uninstalled_signum_leaves_flags_untouched()
    end
  end
  return qspec_main()
end
