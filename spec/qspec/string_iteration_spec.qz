## String Iteration Tests
## Tests `for c in string` which desugars to `for c in str_chars(s)`.
## Each element is an Int codepoint value.

import * from qspec

def collect_chars(s: String): Vec<Int>
  var result = vec_new()
  for c in s
    result.push(c)
  end
  return result
end

def print_empty_chars(): Void
  for c in ""
    puts("should not print")
  end
  puts("done")
end

def print_break_at_l(): Void
  for c in "hello"
    if c == 'l'
      break
    end
    puts(c.to_s())
  end
  puts("done")
end

def print_continue_skip_l(): Void
  for c in "hello"
    if c == 'l'
      continue
    end
    puts(c.to_s())
  end
end

def main(): Int
  describe("string iteration") do ->
    it("iterates over ASCII string codepoints") do ->
      chars = collect_chars("hello")
      assert_eq(chars.size, 5)
      assert_eq(chars[0], 'h')
      assert_eq(chars[1], 'e')
      assert_eq(chars[2], 'l')
      assert_eq(chars[3], 'l')
      assert_eq(chars[4], 'o')
    end

    it("empty string produces zero iterations") do ->
      assert_output("done\n", print_empty_chars)
    end

    it("codepoints are Int values") do ->
      chars = collect_chars("A")
      assert_eq(chars[0], 65)
    end

    it("supports break") do ->
      assert_output("104\n101\ndone\n", print_break_at_l)
    end

    it("supports continue") do ->
      assert_output("104\n101\n111\n", print_continue_skip_l)
    end

    it("works with string variable") do ->
      var s = "abc"
      var count = 0
      for c in s
        count += 1
      end
      assert_eq(count, 3)
    end
  end

  return qspec_main()
end
