## Option Smart Narrowing Tests
##
## Contract:
##   1. After `if opt is Some`, opt! in then-block skips redundant tag check.
##   2. After `if opt is None`, opt! in else-block skips tag check.
##   3. Narrowing works for is-with-bindings: `if opt is Some(v)`.
##   4. Nested narrowing: both variables narrowed simultaneously.
##   5. Re-assignment invalidates narrowing (behavioral correctness, not IR test).
##   6. Result narrowing: `if r is Ok` / `if r is Err`.
import * from qspec

def narrow_some_unwrap(): Int
  opt = Option::Some(42)
  if opt is Some
    return opt!
  end
  return -1
end

def narrow_none_else_unwrap(): Int
  opt = Option::Some(99)
  if opt is None
    return -1
  else
    return opt!
  end
end

def narrow_is_some_binding(): Int
  opt = Option::Some(7)
  if opt is Some(v)
    return v + opt!
  end
  return -1
end

def narrow_nested(): Int
  a = Option::Some(10)
  b = Option::Some(20)
  if a is Some
    if b is Some
      return a! + b!
    end
  end
  return -1
end

def narrow_result_ok(): Int
  r = Result::Ok(55)
  if r is Ok
    return r.unwrap()
  end
  return -1
end

def narrow_result_err_else(): Int
  r = Result::Ok(77)
  if r is Err
    return -1
  else
    return r.unwrap()
  end
end

def narrow_expr_context(): Int
  opt = Option::Some(100)
  val = if opt is Some then opt! else 0 end
  return val
end

def main(): Int
  describe("option smart narrowing") do ->
    it("unwrap after is Some skips tag check") do ->
      assert_eq(narrow_some_unwrap(), 42)
    end

    it("unwrap in else after is None") do ->
      assert_eq(narrow_none_else_unwrap(), 99)
    end

    it("unwrap after is Some with binding") do ->
      assert_eq(narrow_is_some_binding(), 14)
    end

    it("nested narrowing of two variables") do ->
      assert_eq(narrow_nested(), 30)
    end

    it("Result::Ok narrowing") do ->
      assert_eq(narrow_result_ok(), 55)
    end

    it("Result else-block narrowing") do ->
      assert_eq(narrow_result_err_else(), 77)
    end

    it("narrowing in expression context") do ->
      assert_eq(narrow_expr_context(), 100)
    end
  end

  return qspec_main()
end
