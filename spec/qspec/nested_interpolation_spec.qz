## Nested String Interpolation Tests
## Tests that strings inside #{...} expressions work at arbitrary depth.

import * from qspec

def wrap(s: String): String = "<<#{s}>>"
def get_val(): String = "world"

def test_basic_nested(): Void
  result = "hello #{wrap("inner")}"
  puts(result)
end

def test_nested_method_call(): Void
  var m = map_new()
  m.set("key", "value")
  result = "got: #{m.get("key").unwrap_or("none")}"
  puts(result)
end

def test_double_nested(): Void
  result = "outer #{wrap("mid #{get_val()}")}"
  puts(result)
end

def test_simple_interp_still_works(): Void
  x = 42
  puts("value: #{x}")
end

def main(): Int
  describe("nested string interpolation") do ->
    it("handles string arg inside interpolation") do ->
      assert_output("hello <<inner>>\n", test_basic_nested)
    end

    it("handles method call with string arg") do ->
      assert_output("got: value\n", test_nested_method_call)
    end

    it("handles double-nested interpolation") do ->
      assert_output("outer <<mid world>>\n", test_double_nested)
    end

    it("simple interpolation still works") do ->
      assert_output("value: 42\n", test_simple_interp_still_works)
    end
  end

  return qspec_main()
end
