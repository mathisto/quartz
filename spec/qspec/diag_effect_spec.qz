## std/diag — Diag effect acceptance spec.
##
## Operation Piezoelectric Effects, Phase 5, Milestone 5.1.
##
## Verifies the Diag effect declared in std/diag.qz: error/warn ops
## are kind=1 (function-kind), the handler ABI is the standard
## (op_name, argc, argv) shape, and a user handler can capture the
## emitted msg/line/col tuple. Non-blessed: a perform without a
## with-block must raise QZ0610 at compile time.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("std/diag — Diag effect (piezo 5.1)") do ->
    it("error handler captures msg/line/col") do ->
      assert_run_stdout_eq("""
import std/diag

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  var line = load(argv, 1)
  var col = load(argv, 2)
  puts("ERROR " + msg + " @ " + line.to_s() + ":" + col.to_s())
  return 0
end

def main(): Int
  with Diag { error: cap, warn: cap } do ->
    error("bad token", 12, 5)
  end
  return 0
end
""", "ERROR bad token @ 12:5\n")
    end

    it("warn handler captures msg/line/col") do ->
      assert_run_stdout_eq("""
import std/diag

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  var line = load(argv, 1)
  var col = load(argv, 2)
  puts("WARN " + msg + " @ " + line.to_s() + ":" + col.to_s())
  return 0
end

def main(): Int
  with Diag { error: cap, warn: cap } do ->
    warn("unused var", 7, 1)
  end
  return 0
end
""", "WARN unused var @ 7:1\n")
    end

    it("multiple errors accumulate via repeated handler calls") do ->
      assert_run_stdout_eq("""
import std/diag

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts(msg)
  return 0
end

def main(): Int
  with Diag { error: cap, warn: cap } do ->
    error("first", 1, 1)
    error("second", 2, 1)
    warn("third", 3, 1)
  end
  return 0
end
""", "first\nsecond\nthird\n")
    end

    it("can-rowed intermediate caller threads Diag through") do ->
      assert_run_stdout_eq("""
import std/diag

def validate(x: Int): Int can Diag
  if x < 0
    error("negative", 10, 2)
  end
  return x
end

def cap(op_name: Int, argc: Int, argv: Int): Int
  var msg = as_string(load(argv, 0))
  puts(msg)
  return 0
end

def main(): Int
  with Diag { error: cap, warn: cap } do ->
    validate(-1)
  end
  return 0
end
""", "negative\n")
    end

    it("perform outside with-block fails typecheck (QZ0611, non-blessed)") do ->
      assert_compile_error("""
import std/diag

def main(): Int
  error("no handler", 1, 1)
  return 0
end
""", "QZ0611")
    end
  end
  return qspec_main()
end
