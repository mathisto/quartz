## Tuple Destructuring Tests
## Tests `var (a, b) = expr` syntax — NODE_LET_DESTRUCTURE.

import * from qspec

def make_pair(): (Int, Int)
  return (10, 20)
end

def make_triple(): (Int, Int, Int)
  return (1, 2, 3)
end

def main(): Int
  describe("tuple destructuring") do ->
    it("basic pair destructuring") do ->
      var (a, b) = make_pair()
      assert_eq(a, 10)
      assert_eq(b, 20)
    end

    it("triple destructuring") do ->
      var (x, y, z) = make_triple()
      assert_eq(x, 1)
      assert_eq(y, 2)
      assert_eq(z, 3)
    end

    it("inline tuple literal destructuring") do ->
      var (a, b) = (42, 99)
      assert_eq(a, 42)
      assert_eq(b, 99)
    end

    it("destructure function return") do ->
      var (a, b) = make_pair()
      var (x, y, z) = make_triple()
      assert_eq(a + b, 30)
      assert_eq(x + y + z, 6)
    end
  end

  return qspec_main()
end
