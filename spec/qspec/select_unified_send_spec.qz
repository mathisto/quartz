## C.13 Phase 5 — SendSelectable round-trip through real Selectable
## trait dispatch. Mirrors select_unified_recv_spec.qz on the send
## side. Exercises:
##   - Parser op_kind=5 fall-through for `case _ = sendable(ch, v) => ...`
##   - Typecheck `Selectable` impl lookup + struct-name stamp
##   - MIR-lower op_kind=5: try_poll → option_is_some → complete +
##     bind from option payload (always 0 for SendSelectable)
##   - std/sync/communication/channel.qz `SendSelectable` impl + `sendable(ch, v)` factory

import * from qspec
import * from std/sync/communication/channel

def test_sendable_fires_on_channel_with_space(): Int
  var ch = channel_new(2)
  var fired = 0
  select
    case _ = sendable(ch, 99) => fired = 1
    default => fired = 2
  end
  return fired
end

def test_sendable_value_lands_in_channel(): Int
  var ch = channel_new(2)
  select
    case _ = sendable(ch, 777) => 0
    default => 0
  end
  return recv(ch)
end

def test_sendable_default_when_full(): Int
  var ch = channel_new(1)
  send(ch, 1)  # fill the only slot
  var fired = 0
  select
    case _ = sendable(ch, 2) => fired = 1
    default => fired = 99
  end
  return fired
end

def test_sendable_full_doesnt_overwrite(): Int
  var ch = channel_new(1)
  send(ch, 41)
  select
    case _ = sendable(ch, 42) => 0
    default => 0
  end
  return recv(ch)
end

def test_sendable_binding_zero(): Int
  var ch = channel_new(1)
  var bound = -1
  select
    case x = sendable(ch, 7) => bound = x
    default => bound = 99
  end
  return bound
end

def test_recv_after_sendable_chains(): Int
  var ch = channel_new(2)
  select
    case _ = sendable(ch, 10) => 0
    default => 0
  end
  select
    case _ = sendable(ch, 20) => 0
    default => 0
  end
  var a = recv(ch)
  var b = recv(ch)
  return a * 100 + b
end

def main(): Int
  describe("select unified — SendSelectable trait dispatch") do ->
    it("sendable arm fires when channel has space") do ->
      assert_eq(test_sendable_fires_on_channel_with_space(), 1)
    end
    it("sendable arm pushes value into channel buffer") do ->
      assert_eq(test_sendable_value_lands_in_channel(), 777)
    end
    it("default arm fires when channel is full") do ->
      assert_eq(test_sendable_default_when_full(), 99)
    end
    it("sendable failure does not overwrite buffered value") do ->
      assert_eq(test_sendable_full_doesnt_overwrite(), 41)
    end
    it("sendable arm binding is the placeholder 0") do ->
      assert_eq(test_sendable_binding_zero(), 0)
    end
    it("two sequential sendable selects buffer two values") do ->
      assert_eq(test_recv_after_sendable_chains(), 1020)
    end
  end
  return qspec_main()
end
