## Value-Struct Vec first()/last() Tests (item 50)
##
## Contract:
##   first()/last() over a Vec of INLINE value-layout @value elements must return
##   the element interior BY ADDRESS (like vec_get / indexing), so a consumer
##   `.field` read resolves against the struct layout instead of inttoptr-ing
##   field 0's raw word as a struct pointer (SEGV). first/last are panic-on-empty
##   and return T directly (NOT Option), matching vec_get.
##
##   Before item 50: Vec$first/Vec$last were hardcoded TYPE_INT (Vec<Int>), so
##   over a @value element they returned the field-0 word and `.a` SEGV'd.
import * from qspec

@value
struct Pt
  a: Int
  b: Int
end

# -- Test helpers --

def test_first_inline_2field(): Void
  var v = vec_new<Pt>()
  v.push(Pt { a: 10, b: 20 })
  v.push(Pt { a: 30, b: 40 })
  var f = v.first()
  assert_eq(f.a, 10)
  assert_eq(f.b, 20)
end

def test_last_inline_2field(): Void
  var v = vec_new<Pt>()
  v.push(Pt { a: 10, b: 20 })
  v.push(Pt { a: 30, b: 40 })
  var l = v.last()
  assert_eq(l.a, 30)
  assert_eq(l.b, 40)
end

def test_first_last_single_element(): Void
  var v = vec_new<Pt>()
  v.push(Pt { a: 7, b: 8 })
  var f = v.first()
  var l = v.last()
  assert_eq(f.a, 7)
  assert_eq(f.b, 8)
  assert_eq(l.a, 7)
  assert_eq(l.b, 8)
end

def test_first_last_match_index(): Void
  var v = vec_new<Pt>()
  v.push(Pt { a: 1, b: 2 })
  v.push(Pt { a: 3, b: 4 })
  v.push(Pt { a: 5, b: 6 })
  var f = v.first()
  var l = v.last()
  var x0 = v[0]
  var x2 = v[2]
  # first == v[0], last == v[size-1]
  assert_eq(f.a, x0.a)
  assert_eq(f.b, x0.b)
  assert_eq(l.a, x2.a)
  assert_eq(l.b, x2.b)
end

def test_first_last_scalar_int(): Void
  # Vec<Int> first/last stay on the legacy scalar load path (byte-identical).
  var v = vec_new<Int>()
  v.push(11)
  v.push(22)
  v.push(33)
  assert_eq(v.first(), 11)
  assert_eq(v.last(), 33)
end

def main(): Int
  describe("value-struct Vec first/last") do ->
    it("first() over inline 2-field @value reads fields by-address") do ->
      test_first_inline_2field()
    end

    it("last() over inline 2-field @value reads fields by-address") do ->
      test_last_inline_2field()
    end

    it("first/last over single-element @value Vec") do ->
      test_first_last_single_element()
    end

    it("first==v[0] and last==v[size-1] for @value elements") do ->
      test_first_last_match_index()
    end

    it("first/last over scalar Vec<Int> is unchanged") do ->
      test_first_last_scalar_int()
    end
  end

  return qspec_main()
end
