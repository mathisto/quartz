## Match Guard Clauses Tests
##
## Contract:
##   1. Basic guard conditions.
##   2. Guards with enum payloads.
##   3. Guards with multiple bindings.
##   4. Guards with do blocks.
##   5. Guards with complex expressions.
##   6. Wildcard with guard.

import * from qspec

enum MGResult
  Ok(value: Int)
  Err(code: Int)
end

def main(): Int
  describe("basic guard conditions") do ->
    it("matches arm with passing guard") do ->
      assert_eq(classify_gt5(10), 1)
    end

    it("skips arm when guard fails") do ->
      assert_eq(classify_gt5(3), 0)
    end

    it("tries next arm when guard fails") do ->
      assert_eq(classify_multi(5), 2)
    end
  end

  describe("guards with enum payloads") do ->
    it("uses extracted payload in guard") do ->
      assert_eq(guard_payload(MGResult::Ok(42)), 42)
    end

    it("falls through when payload guard fails") do ->
      assert_eq(guard_payload(MGResult::Ok(5)), 0)
      assert_eq(guard_payload(MGResult::Err(1)), -1)
    end
  end

  describe("guards with multiple bindings") do ->
    it("can use multiple bindings in guard (multi-binding enum IR bug)") do ->
      assert_eq(multi_bind_guard(MGResult::Ok(42)), 42)
    end
  end

  describe("guards with do blocks") do ->
    it("works with multi-statement arms") do ->
      assert_eq(classify_do_guard(15), 30)
      assert_eq(classify_do_guard(3), 0)
    end
  end

  describe("guards with complex expressions") do ->
    it("supports function calls in guards") do ->
      assert_eq(classify_even(8), 1)
      assert_eq(classify_even(7), 0)
    end

    it("supports logical operators in guards") do ->
      assert_eq(classify_range(15), 1)
      assert_eq(classify_range(25), 0)
    end
  end

  describe("wildcard with guard") do ->
    it("matches wildcard only when guard passes") do ->
      assert_eq(classify_wildcard_guard(15), 1)
      assert_eq(classify_wildcard_guard(8), 2)
      assert_eq(classify_wildcard_guard(2), 3)
    end
  end

  return qspec_main()
end

def classify_gt5(x: Int): Int
  match x
    n if n > 5 => return 1
    _ => return 0
  end
  return 99
end

def classify_multi(x: Int): Int
  match x
    n if n > 10 => return 1
    n if n > 3 => return 2
    n if n > 0 => return 3
    _ => return 4
  end
  return 99
end

def classify_even(x: Int): Int
  match x
    n if is_even(n) => return 1
    _ => return 0
  end
  return 99
end

def classify_range(x: Int): Int
  match x
    n if n > 10 and n < 20 => return 1
    _ => return 0
  end
  return 99
end

def classify_wildcard_guard(x: Int): Int
  match x
    _ if x > 10 => return 1
    _ if x > 5 => return 2
    _ => return 3
  end
  return 99
end

def classify_do_guard(x: Int): Int
  match x
    n if n > 10 =>
      var doubled = n * 2
      return doubled
    _ => return 0
  end
  return 99
end

def guard_payload(r: Int): Int
  match r
    MGResult::Ok(v) if v > 10 => return v
    Ok(v) => return 0
    _ => return -1
  end
  return 99
end

def is_even(n: Int): Int
  return n % 2 == 0
end

def multi_bind_guard(r: Int): Int
  match r
    MGResult::Ok(v) if v > 10 => return v
    Ok(v) => return 0
    _ => return -1
  end
  return 99
end
