## io_suspend_timeout intrinsic — scheduler-aware I/O timeouts

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("io_suspend_timeout") do ->
    it("timeout fires on idle fd") do ->
      assert_run_exits_timeout(timeout_fires_src(), 0)
    end
    it("non-async fallback does not crash") do ->
      assert_run_exits_timeout(non_async_fallback_src(), 0)
    end
    it("zero timeout behaves like io_suspend") do ->
      assert_run_exits_timeout(zero_timeout_src(), 0)
    end
    it("multiple concurrent timeouts via scheduler") do ->
      assert_run_exits_timeout(concurrent_timeouts_src(), 0)
    end
    it("I/O ready before timeout wakes immediately") do ->
      assert_run_exits_timeout(io_ready_before_timeout_src(), 0)
    end
  end
  return qspec_main()
end

def timeout_fires_src(): String = """
  import * from ffi/socket
  def waiter(rfd: Int): Int
    var t0 = time_mono_ns()
    io_suspend_timeout(rfd, 200, 1)
    var t1 = time_mono_ns()
    var elapsed_ms = (t1 - t0) / 1000000
    if elapsed_ms >= 100
      return 0
    end
    return 1
  end
  def main(): Int
    var fds = pipe_create()
    if fds.size < 2
      return 2
    end
    var rfd = fds[0]
    var wfd = fds[1]
    sched_init(2)
    var t = async waiter(rfd)
    sched_spawn(t)
    var r = await t
    sched_shutdown()
    close(rfd)
    close(wfd)
    return r
  end
  """

def non_async_fallback_src(): String = """
  import * from ffi/socket
  def main(): Int
    var fds = pipe_create()
    if fds.size < 2
      return 1
    end
    var rfd = fds[0]
    var wfd = fds[1]
    io_suspend_timeout(rfd, 50, 1)
    close(rfd)
    close(wfd)
    return 0
  end
  """

def zero_timeout_src(): String = """
  import * from ffi/socket
  def waiter(rfd: Int): Int
    io_suspend_timeout(rfd, 0, 1)
    return 0
  end
  def main(): Int
    var fds = pipe_create()
    if fds.size < 2
      return 2
    end
    var rfd = fds[0]
    var wfd = fds[1]
    close(wfd)
    sched_init(2)
    var t = async waiter(rfd)
    sched_spawn(t)
    var r = await t
    sched_shutdown()
    close(rfd)
    return r
  end
  """

def concurrent_timeouts_src(): String = """
  import * from ffi/socket
  def waiter(rfd: Int): Int
    io_suspend_timeout(rfd, 200, 1)
    return 0
  end
  def main(): Int
    var f1 = pipe_create()
    var f2 = pipe_create()
    var f3 = pipe_create()
    if f1.size < 2 or f2.size < 2 or f3.size < 2
      return 2
    end
    sched_init(2)
    var t1 = async waiter(f1[0])
    sched_spawn(t1)
    var t2 = async waiter(f2[0])
    sched_spawn(t2)
    var t3 = async waiter(f3[0])
    sched_spawn(t3)
    var e1 = await t1
    var e2 = await t2
    var e3 = await t3
    sched_shutdown()
    close(f1[0])
    close(f1[1])
    close(f2[0])
    close(f2[1])
    close(f3[0])
    close(f3[1])
    if e1 == 0 and e2 == 0 and e3 == 0
      return 0
    end
    return 1
  end
  """

def io_ready_before_timeout_src(): String = """
  import * from ffi/socket
  def waiter(rfd: Int): Int
    var t0 = time_mono_ns()
    io_suspend_timeout(rfd, 5000, 1)
    var t1 = time_mono_ns()
    var elapsed_ms = (t1 - t0) / 1000000
    if elapsed_ms < 3000
      return 0
    end
    return 1
  end
  def main(): Int
    var fds = pipe_create()
    if fds.size < 2
      return 2
    end
    var rfd = fds[0]
    var wfd = fds[1]
    close(wfd)
    sched_init(2)
    var t = async waiter(rfd)
    sched_spawn(t)
    var r = await t
    sched_shutdown()
    close(rfd)
    return r
  end
  """
