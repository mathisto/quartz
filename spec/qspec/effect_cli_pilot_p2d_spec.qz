## CLI pilot — Phase 2 Milestone P2.d acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone P2.d.
##
## Proves the `examples/cli_effects.qz` pilot's effect-driven argv
## processing behaves correctly end-to-end: State<Int> cursor advances
## monotonically, Reader<Int> verbosity gates Log output, subcommand
## dispatch routes through a single `with` frame.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("CLI pilot — State<ArgCursor> + Reader<Verbosity> + gated Log") do ->
    it("default verbosity: sum subcommand totals the args silently") do ->
      # sum 10 20 30 — no --verbose, so gated_log_handler stays quiet,
      # only the final total prints. Confirms `ask()` inside the Log
      # handler reads the Reader<Int> frame correctly across dispatch.
      assert_run_stdout_eq("""
import std/state
import std/reader
import std/log

const VERBOSE_DEBUG = 2

def gated_log_handler(op: Int, argc: Int, argv: Int): Int can Reader
  if ask() >= VERBOSE_DEBUG
    puts(as_string(load(argv, 0)))
  end
  return 0
end

def sum_step(total: Int, a: Int): Int = total + a

def main(): Int
  var r = with Log { emit: gated_log_handler }, Reader(1), State(0) do ->
    log::info("start")
    var total = 0
    while get() < 3
      log::info("step")
      total = sum_step(total, get() + 10)
      set(get() + 1)
    end
    total
  end
  puts("total: " + r.to_s())
  return 0
end
""", "total: 33\n")
    end

    it("verbose: same code path shows progress lines") do ->
      # Same program with Reader(2) instead of Reader(1) — identical
      # logic, log output now surfaces. Shows Reader as a config-level
      # knob.
      assert_run_stdout_eq("""
import std/state
import std/reader
import std/log

const VERBOSE_DEBUG = 2

def gated_log_handler(op: Int, argc: Int, argv: Int): Int can Reader
  if ask() >= VERBOSE_DEBUG
    puts(as_string(load(argv, 0)))
  end
  return 0
end

def main(): Int
  var r = with Log { emit: gated_log_handler }, Reader(2), State(0) do ->
    log::info("start")
    while get() < 2
      log::info("iter")
      set(get() + 1)
    end
    get()
  end
  puts("count: " + r.to_s())
  return 0
end
""", "[INFO] start\n[INFO] iter\n[INFO] iter\ncount: 2\n")
    end

    it("State cursor survives method calls inside with-body") do ->
      # Helper sees the cursor via `can State` — same slot as the
      # enclosing with's install. Validates the Phase 2 story: no param
      # threading needed.
      assert_run_stdout_eq("""
import std/state

def advance(): Int can State
  var i = get()
  set(i + 1)
  return i
end

def run(n: Int): Int can State
  var last = 0
  while get() < n
    last = advance()
  end
  return last
end

def main(): Int
  var r = with State(10) do ->
    run(15)
  end
  puts(r.to_s())
  return 0
end
""", "14\n")
    end

    it("switching dispatch via config: same handler set, different Reader") do ->
      # Simulates a CLI that picks a different code path per config.
      # Reader<Int> carries the "mode" (1 = add, 2 = multiply); the
      # dispatch reads it once and branches. Demonstrates Reader's
      # value as an ambient dispatch switch.
      assert_run_stdout_eq("""
import std/state
import std/reader

def compute(): Int can State, Reader
  var acc = 0
  if ask() == 1
    acc = get() + get()
  else
    acc = get() * get()
  end
  return acc
end

def main(): Int
  var add_result = with Reader(1), State(7) do ->
    compute()
  end
  var mul_result = with Reader(2), State(7) do ->
    compute()
  end
  puts(add_result.to_s())
  puts(mul_result.to_s())
  return 0
end
""", "14\n49\n")
    end
  end

  return qspec_main()
end
