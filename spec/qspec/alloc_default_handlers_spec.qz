## QSpec coverage for the Alloc default handlers (Phase A.2).
##
## Locks in the stdlib-side default handler API in `std/alloc.qz`:
##   - `default_alloc_handler` calls `mem_alloc(load(argv, 0))`.
##   - `default_dealloc_handler` calls `mem_free(load(argv, 0))`.
##
## These are user-callable convenience handlers — Phase A.3 ships the
## runtime-blessed inline LLVM IR handler in the main prelude (so
## `alloc(...)` / `dealloc(...)` outside any `with` block becomes valid
## without user-side install). Until A.3 lands these tests confirm that
## explicit install of the stdlib defaults works and behaves identically
## to direct `mem_alloc` / `mem_free`.
##
## Out of scope (defer to A.6 — full spec coverage):
##   - Default-handler interception of internal `mem_alloc` calls in
##     `vec_new`, `Vec.push`, `String.concat` etc. — that requires the
##     A.3 TLS-pointer hook.
##   - Nested handlers, isolation between installs.
##   - Recursion-bypass for handlers that themselves allocate.
##   - Throw-on-deny composition with std/throws.

import * from qspec
import std/alloc

# --- Test 1: default_alloc_handler + default_dealloc_handler installed
#     explicitly produce identical behavior to direct mem_alloc/mem_free.

def t1_use(): Int can Alloc
  # A.3.c byte-semantics: 24 bytes = three i64 slots.
  var p = alloc(24)
  store(p, 0, 11)
  store(p, 1, 22)
  store(p, 2, 33)
  var sum = load(p, 0) + load(p, 1) + load(p, 2)
  dealloc(p)
  return sum
end

def t1_run(): Void
  with Alloc { alloc: default_alloc_handler, dealloc: default_dealloc_handler } do ->
    var s = t1_use()
    puts("sum=#{s}")
  end
end

# --- Test 2: default handlers compose with custom handlers (mixed install).
#     Custom alloc that prefixes a marker; default dealloc.

var _t2_alloc_calls = 0

def t2_custom_alloc(op_name: Int, argc: Int, argv: Int): Int
  _t2_alloc_calls = _t2_alloc_calls + 1
  return default_alloc_handler(op_name, argc, argv)
end

def t2_use(): Int can Alloc
  # A.3.c byte-semantics: 8 bytes = one i64 slot.
  var p1 = alloc(8)
  var p2 = alloc(8)
  store(p1, 0, 7)
  store(p2, 0, 8)
  var sum = load(p1, 0) + load(p2, 0)
  dealloc(p1)
  dealloc(p2)
  return sum
end

var _t2_sum = 0

def t2_run(): Void
  _t2_alloc_calls = 0
  with Alloc { alloc: t2_custom_alloc, dealloc: default_dealloc_handler } do ->
    _t2_sum = t2_use()
  end
  # puts() is OUTSIDE the with-block so its internal str_from_int/concat
  # allocations route through the blessed default, not the t2 custom
  # handler — _t2_alloc_calls counts only user-visible alloc() calls.
  puts("sum=#{_t2_sum} calls=#{_t2_alloc_calls}")
end

# --- Test 3: many small allocations through the defaults stay correct.

def t3_use(): Int can Alloc
  var i = 0
  var total = 0
  while i < 8
    # A.3.c byte-semantics: 8 bytes = one i64 slot.
    var p = alloc(8)
    store(p, 0, i + 1)
    total = total + load(p, 0)
    dealloc(p)
    i = i + 1
  end
  return total
end

def t3_run(): Void
  with Alloc { alloc: default_alloc_handler, dealloc: default_dealloc_handler } do ->
    var t = t3_use()
    puts("total=#{t}")
  end
end

def main(): Int
  describe("Alloc default handlers (A.2)") do ->
    it("default handlers passthrough to mem_alloc/mem_free") do ->
      assert_output("sum=66\n", t1_run)
    end

    it("default handlers compose with custom handlers") do ->
      assert_output("sum=15 calls=2\n", t2_run)
    end

    it("default handlers handle many sequential allocations") do ->
      assert_output("total=36\n", t3_run)
    end
  end
  return qspec_main()
end
