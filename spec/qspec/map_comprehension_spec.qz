## Map Comprehension Tests
##
## Contract:
##   1. Allows function calls in.
##   2. Creates empty map from.
##   3. Creates empty map when.
##   4. Creates map from range.
##   5. Creates map with computed.
##   6. Filters based on computed.
import * from qspec

def mc_from_range(): Int
  m = {i => i * 10 for i in 0..5}
  return m.get(0).unwrap() + m.get(2).unwrap() + m.get(4).unwrap()
end

def mc_computed_keys(): Int
  m = {i * 2 => i for i in 0..4}
  return m.get(4).unwrap() + m.get(6).unwrap()
end

def mc_filter_even(): Int
  m = {i => i * 10 for i in 0..6 if i % 2 == 0}
  return m.get(2).unwrap() + m.get(4).unwrap()
end

def mc_filter_value(): Int
  m = {i => i * i for i in 0..5 if i * i > 5}
  return m.get(3).unwrap() + m.get(4).unwrap()
end

def mc_vec_iter(): Int
  var v = vec_new()
  v.push(100)
  v.push(200)
  v.push(300)
  m = {i => v[i] for i in 0..3}
  return m.get(1).unwrap()
end

def mc_filter_excludes_all(): Int
  m = {i => i for i in 0..3 if i > 100}
  return unwrap_or(m.get(0), 0) + unwrap_or(m.get(1), 0) + unwrap_or(m.get(2), 0)
end

def mc_empty_range(): Int
  m = {i => i * 10 for i in 0..0}
  return unwrap_or(m.get(0), 0)
end

def mc_double(x: Int): Int = x * 2
def mc_square(x: Int): Int = x * x

def mc_func_calls(): Int
  m = {mc_double(i) => mc_square(i) for i in 1..4}
  return m.get(4).unwrap() + m.get(6).unwrap()
end

def mc_nested_expr(): Int
  m = {i => (i + 1) * (i + 2) for i in 0..3}
  return m.get(2).unwrap()
end

def mc_type_infer(): Int
  m = {i => i + 1 for i in 0..3}
  a = m.get(0).unwrap()
  b = m.get(1).unwrap()
  c = m.get(2).unwrap()
  return a + b + c
end

def main(): Int
  describe("map comprehensions") do ->
    it("creates map from range") do ->
      assert_eq(mc_from_range(), 60)
    end

    it("creates map with computed keys") do ->
      assert_eq(mc_computed_keys(), 5)
    end

    it("filters entries with if clause") do ->
      assert_eq(mc_filter_even(), 60)
    end

    it("filters based on computed value") do ->
      assert_eq(mc_filter_value(), 25)
    end

    it("iterates over vec elements") do ->
      assert_eq(mc_vec_iter(), 200)
    end

    it("creates empty map when filter excludes all") do ->
      assert_eq(mc_filter_excludes_all(), 0)
    end

    it("creates empty map from empty range") do ->
      assert_eq(mc_empty_range(), 0)
    end

    it("allows function calls in key and value") do ->
      assert_eq(mc_func_calls(), 13)
    end

    it("handles nested expressions") do ->
      assert_eq(mc_nested_expr(), 12)
    end

    it("infers Map<Int, Int> type") do ->
      assert_eq(mc_type_infer(), 6)
    end
  end
  return qspec_main()
end
