## Effect-Row Substitution + Occurs Check — B.5 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone B (chunk B.5).
## Verifies the standalone substitution and occurs-check helpers added
## next to tc_row_unify (B.4 already covers the same-tail-var occurs
## case inline; B.5 ships the explicit `tc_row_substitute` and
## `tc_row_occurs_check` API surface as their own primitives).
##
## Cases run via `--test-row-subst`, which constructs a fresh
## TypecheckState and prints `ROW_SUBST <slug>: PASS|FAIL` per case.

import * from qspec
import * from qspec/subprocess

extern "C" def system(cmd: CString): CInt

def _run_subst_tests(): SubResult
  _sub_init()
  var compiler = getenv("QUARTZ_COMPILER")
  if str_byte_len(compiler) == 0
    return SubResult { exit_code: -1, stdout_content: "", stderr_content: "QUARTZ_COMPILER not set" }
  end
  var sb = sb_new()
  sb.append(compiler)
  sb.append(" --test-row-subst > /tmp/_qspec_row_subst.out 2> /tmp/_qspec_row_subst.err")
  var raw = system(sb.to_string())
  var exit_code = band(shr(raw, 8), 255)
  return SubResult {
    exit_code: exit_code,
    stdout_content: read_file("/tmp/_qspec_row_subst.out"),
    stderr_content: read_file("/tmp/_qspec_row_subst.err")
  }
end

def _assert_pass(stderr: String, slug: String): Void
  _inc_assertions()
  var needle = "ROW_SUBST #{slug}: PASS"
  if not str_contains(stderr, needle)
    var sb = sb_new()
    sb.append("Expected '#{needle}' in stderr but got: ")
    sb.append(stderr)
    _record_failure(sb.to_string())
  end
end

def main(): Int
  describe("tc_row_substitute + tc_row_occurs_check") do ->
    var r = _run_subst_tests()

    it("subst is a no-op when var_id never appears in the chain") do ->
      _assert_pass(r.stderr_content, "noop_when_var_absent")
    end

    it("subst replaces the tail directly when row's tail equals var_id") do ->
      _assert_pass(r.stderr_content, "subst_replaces_tail")
    end

    it("subst follows nested erv bindings to find target var_id") do ->
      _assert_pass(r.stderr_content, "subst_nested_row_var")
    end

    it("occurs check detects direct cycle ([L | ρ] contains ρ)") do ->
      _assert_pass(r.stderr_content, "occurs_direct_tail")
    end
  end
  return qspec_main()
end
