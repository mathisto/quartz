## Move Semantics Tests — QZ1212, QZ1214, QZ1215
##
## Contract:
##   1. Type classification: Drop → move-tracked. Copy → not tracked.
##      linear → tracked (QZ1203). Primitive → not tracked.
##      Copy + Drop = QZ1215. Copy + linear = QZ1215.
##   2. Assignment moves: `var b = a` marks `a` as Moved. Use after = QZ1212.
##      Double move = QZ1212.
##   3. Function call moves: pass by value = move. Borrow (&/&mut) = not a move.
##      Temporary in call = OK.
##   4. Return moves: `return d` transfers ownership.
##   5. Conditional moves: both branches consume = OK. If-without-else = QZ1214.
##      One branch only = QZ1214.
##   6. Drop integration: moved value NOT double-dropped. Consumed-by-call not
##      dropped at caller. Borrowed value IS dropped. Chain: only final owner dropped.
##   7. Re-initialization: reassignment after move restores Live state.
##   8. Loop body moves: moving inside while/for body = QZ1212.
##      Same for list comprehensions.
##   9. Borrow of moved value: &moved_var = QZ1212.
##  10. Move while borrowed: moving a borrowed binding = QZ1212.
##  11. Match moves: match on ident of moveable type moves the subject.
##  12. Error messages: QZ1212 contains variable + target. --explain works.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Phase 0: Type classification
  # ===========================================================================
  describe("move semantics: type classification") do ->
    it("struct with Drop is move-tracked (use after move = QZ1212)") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def use_res(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          var b = a
          use_res(a)
          return 0
        end
        """, "QZ1212")
    end

    it("struct without Drop is NOT move-tracked") do ->
      assert_run_exits("""
        struct Plain
          x: Int
        end
        def main(): Int
          var a = Plain { x: 1 }
          var b = a
          return a.x + b.x
        end
        """, 2)
    end

    it("linear struct uses existing QZ1203 system") do ->
      assert_compile_error("""
        linear struct LH
          fd: Int
        end
        def consume_lh(h: LH): Int = h.fd
        def main(): Int
          h = LH { fd: 1 }
          consume_lh(h)
          consume_lh(h)
          return 0
        end
        """, "QZ1203")
    end

    it("primitive types are not move-tracked") do ->
      assert_run_exits("""
        def main(): Int
          var x = 42
          var y = x
          return x + y
        end
        """, 84)
    end
  end

  # ===========================================================================
  # Phase 6: Copy trait
  # ===========================================================================
  describe("move semantics: Copy trait") do ->
    it("Copy type is freely copyable after assignment") do ->
      assert_run_exits("""
        trait Copy
        end
        struct Point
          x: Int
          y: Int
        end
        extend Point with Copy
        end
        def main(): Int
          var a = Point { x: 1, y: 2 }
          var b = a
          return a.x + b.y
        end
        """, 3)
    end

    it("Copy + Drop = QZ1215") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        trait Copy
        end
        struct Bad
          x: Int
        end
        extend Bad with Drop
          def drop(self: Int): Void
            return
          end
        end
        extend Bad with Copy
        end
        def main(): Int = 0
        """, "QZ1215")
    end

    it("Copy + linear = QZ1215") do ->
      assert_compile_error("""
        trait Copy
        end
        linear struct LBad
          x: Int
        end
        extend LBad with Copy
        end
        def main(): Int = 0
        """, "QZ1215")
    end

    it("Copy type used after 'move' has no error") do ->
      assert_run_exits("""
        trait Copy
        end
        struct Val
          x: Int
        end
        extend Val with Copy
        end
        def eat(v: Val): Int = v.x
        def main(): Int
          var a = Val { x: 42 }
          eat(a)
          return a.x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Phase 1: Assignment moves
  # ===========================================================================
  describe("move semantics: assignment moves") do ->
    it("var b = a moves a, b is usable") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 42 }
          var b = a
          return b.fd
        end
        """, 42)
    end

    it("use after assignment move = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 42 }
          var b = a
          return a.fd
        end
        """, "QZ1212")
    end

    it("double move = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 42 }
          var b = a
          var c = a
          return 0
        end
        """, "QZ1212")
    end

    it("non-Drop struct: use after assignment is OK") do ->
      assert_run_exits("""
        struct Plain
          x: Int
        end
        def main(): Int
          var a = Plain { x: 42 }
          var b = a
          return a.x
        end
        """, 42)
    end

    it("live value used without move is OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 42 }
          return a.fd
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Phase 2: Function call moves
  # ===========================================================================
  describe("move semantics: function call moves") do ->
    it("consume(d) then use(d) = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          consume(d)
          return d.x
        end
        """, "QZ1212")
    end

    it("borrow (&d) does NOT move") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def peek(r: &Res): Int = r.x
        def main(): Int
          var d = Res { x: 42 }
          peek(&d)
          return d.x
        end
        """, 42)
    end

    it("&mut borrow does NOT move") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def mutate(r: &mut Res): Void
          r.x = 99
        end
        def main(): Int
          var d = Res { x: 42 }
          mutate(&mut d)
          return d.x
        end
        """, 99)
    end

    it("temporary in call is OK (no binding to invalidate)") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int = consume(Res { x: 42 })
        """, 42)
    end
  end

  # ===========================================================================
  # Phase 3: Return moves
  # ===========================================================================
  describe("move semantics: return moves") do ->
    it("return d transfers ownership (OK)") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def make(): Res = Res { x: 42 }
        def main(): Int
          var r = make()
          return r.x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Phase 5: MIR drop integration
  # ===========================================================================
  describe("move semantics: drop integration") do ->
    it("moved value is NOT double-dropped") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def main(): Int
          var a = Tracked { x: 1 }
          var b = a
          return 0
        end
        """, "dropped\n")
    end

    it("consumed-by-call value is NOT dropped at caller scope") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def consume(t: Tracked): Int = t.x
        def main(): Int
          var a = Tracked { x: 1 }
          consume(a)
          puts("after")
          return 0
        end
        """, "dropped\nafter\n")
    end

    it("borrowed value IS still dropped at scope exit") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def peek(t: &Tracked): Int = t.x
        def main(): Int
          var a = Tracked { x: 1 }
          peek(&a)
          puts("alive")
          return 0
        end
        """, "alive\ndropped\n")
    end

    it("chain of moves: only final owner is dropped") do ->
      assert_run_stdout_eq("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Tracked
          x: Int
        end
        extend Tracked with Drop
          def drop(self: Int): Void
            puts("dropped")
          end
        end
        def main(): Int
          var a = Tracked { x: 1 }
          var b = a
          var c = b
          return 0
        end
        """, "dropped\n")
    end
  end

  # ===========================================================================
  # Phase 4: Conditional moves
  # ===========================================================================
  describe("move semantics: conditional moves") do ->
    it("both branches consume = OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          if 1
            consume(d)
          else
            consume(d)
          end
          return 0
        end
        """, 0)
    end

    it("if-without-else moves value = QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          if 1
            consume(d)
          end
          return 0
        end
        """, "QZ1214")
    end

    it("one branch moves, other uses = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def use_res(r: &Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          if 1
            consume(d)
          else
            use_res(&d)
          end
          return d.x
        end
        """, "QZ121")
    end
  end

  # ===========================================================================
  # Phase 7: Match moves
  # ===========================================================================
  describe("move semantics: match moves") do ->
    it("match on droppable consumes the subject") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var d = Res { x: 1 }
          match d.x
            1 => return 42
            _ => return 0
          end
          return d.x
        end
        """, 42)
    end

    it("temporary in match is OK") do ->
      assert_run_exits("""
        def main(): Int
          match 42
            42 => return 42
            _ => return 0
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Phase 9: Error messages
  # ===========================================================================
  describe("move semantics: error messages") do ->
    it("QZ1212 message contains moved and target") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 42 }
          var b = a
          return a.fd
        end
        """, "moved")
    end

    it("--explain QZ1212 returns documentation") do ->
      assert_explain_output("QZ1212", "Use of Moved Value")
    end

    it("--explain QZ1215 returns documentation") do ->
      assert_explain_output("QZ1215", "Cannot Implement Both Copy and Drop")
    end
  end

  # ===========================================================================
  # Phase 10: Re-initialization after move
  # ===========================================================================
  describe("move semantics: re-initialization") do ->
    it("reassignment after move restores usability") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 1 }
          var b = a
          a = Conn { fd: 2 }
          return a.fd
        end
        """)
    end

    it("re-init after move produces correct value at runtime") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Conn
          fd: Int
        end
        extend Conn with Drop
          def drop(self: Int): Void
            return
          end
        end
        def main(): Int
          var a = Conn { fd: 1 }
          var b = a
          a = Conn { fd: 99 }
          return a.fd
        end
        """, 99)
    end
  end

  # ===========================================================================
  # Phase 11: Loop body moves
  # ===========================================================================
  describe("move semantics: loop body moves") do ->
    it("move inside while loop = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          var i = 0
          while i < 3
            consume(d)
            i = i + 1
          end
          return 0
        end
        """, "QZ1212")
    end

    it("move inside for loop = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          for i in 0..3
            consume(d)
          end
          return 0
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Phase 12: Borrow interactions
  # ===========================================================================
  describe("move semantics: borrow interactions") do ->
    it("borrow of moved value = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def peek(r: &Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var b = a
          peek(&a)
          return 0
        end
        """, "QZ1212")
    end

    it("move while borrowed = QZ1212") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var p = &a
          consume(a)
          return 0
        end
        """, "QZ1212")
    end
  end

  # ===========================================================================
  # Phase 13: Conditional move edge cases
  # ===========================================================================
  describe("move semantics: conditional edge cases") do ->
    it("both branches consume, no use after — compiles OK") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 1 }
          if 1
            consume(d)
          else
            consume(d)
          end
          return 0
        end
        """)
    end

    it("neither branch moves — variable stays live") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var d = Res { x: 42 }
          if 0
            var x = 1
          else
            var x = 2
          end
          return consume(d)
        end
        """, 42)
    end
  end

  return qspec_main()
end

## Helper: check that --explain output contains expected text
def assert_explain_output(code: String, expected: String): Void
  _inc_assertions()
  var flags = "--explain " + code
  var r = subprocess_compile_with_flags("def main(): Int = 0\n", flags)
  if not str_contains(r.stdout_content, expected)
    var sb = sb_new()
    sb_append(sb, "Expected --explain ")
    sb_append(sb, code)
    sb_append(sb, " to contain '")
    sb_append(sb, expected)
    sb_append(sb, "' but got: ")
    sb_append(sb, r.stdout_content)
    _record_failure(sb_to_string(sb))
  end
end
