## P3.F.4 — std/streams combinators are callback-row-polymorphic.
##
## Demonstrates that a single `stream_map<e>` and `stream_filter<e>` accept
## both pure (`Fn(Int): Int`) and async (`Fn(Int): Int can Async`) callbacks
## at the typecheck level. Full async-stream runtime exercise is in
## async_iterator_spec (pre-existing, flaky on some configurations); this
## spec is a compile-level assertion that the polymorphic signatures work.
##
## The source iterator is still `impl AsyncIterator<Int>` (F.3c will widen
## this to `impl Iterator<T, e>` for source-polymorphism too). What ships
## here: callbacks carry `can e`, and the return row propagates e.

import * from qspec
import * from streams

def _numbers(): impl AsyncIterator<Int>
  yield 1
  yield 2
  yield 3
end

def _pure_dbl(x: Int): Int = x * 2
def _async_dbl(x: Int): Int can Async = x * 2

def _pure_gt1(x: Int): Bool = x > 1
def _async_gt1(x: Int): Bool can Async = x > 1

def _consume_map_pure(): Int can Async
  var s = stream_map(_numbers(), _pure_dbl)
  return 0
end

def _consume_map_async(): Int can Async
  var s = stream_map(_numbers(), _async_dbl)
  return 0
end

def _consume_filter_pure(): Int can Async
  var s = stream_filter(_numbers(), _pure_gt1)
  return 0
end

def _consume_filter_async(): Int can Async
  var s = stream_filter(_numbers(), _async_gt1)
  return 0
end

def _consume_composed(): Int can Async
  var s = stream_map(stream_filter(_numbers(), _pure_gt1), _async_dbl)
  return 0
end

def main(): Int
  describe("std/streams combinators are callback-row-polymorphic") do ->
    it("stream_map accepts pure callback") do ->
      assert_eq(_consume_map_pure(), 0)
    end

    it("stream_map accepts async callback") do ->
      assert_eq(_consume_map_async(), 0)
    end

    it("stream_filter accepts pure predicate") do ->
      assert_eq(_consume_filter_pure(), 0)
    end

    it("stream_filter accepts async predicate") do ->
      assert_eq(_consume_filter_async(), 0)
    end

    it("composition — stream_map(stream_filter(...)) mixes pure + async callbacks") do ->
      assert_eq(_consume_composed(), 0)
    end
  end
  return qspec_main()
end
