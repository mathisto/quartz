## Task Group Tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("basic task_group") do ->
    it("empty task_group completes without error") do ->
      assert_run_exits(tg_empty_src(), 0)
    end
    it("single task completes") do ->
      assert_run_exits(tg_single_src(), 0)
    end
    it("multiple tasks all complete before end") do ->
      assert_run_exits(tg_multi_src(), 0)
    end
    it("supports g.spawn() UFCS syntax") do ->
      assert_run_exits(tg_ufcs_spawn_src(), 0)
    end
  end

  describe("result collection") do ->
    it("collects results in spawn order") do ->
      assert_run_exits(tg_collect_src(), 0)
    end
    it("collects results from compute-heavy tasks") do ->
      assert_run_exits(tg_collect_heavy_src(), 0)
    end
  end

  describe("concurrency") do ->
    it("tasks run in parallel with shared atomic counter") do ->
      assert_run_exits(tg_parallel_counter_src(), 0)
    end
  end

  describe("cancellation") do ->
    it("is_cancelled returns 0 outside task_group") do ->
      assert_run_exits(tg_iscancelled_src(), 0)
    end
  end

  describe("scaling") do ->
    it("handles more tasks than CPU cores") do ->
      assert_run_exits(tg_many_tasks_src(), 0)
    end
  end

  describe("task_group as expression") do ->
    it("returns body last expression value") do ->
      assert_run_exits(tg_expr_src(), 42)
    end
  end

  return qspec_main()
end

def tg_empty_src(): String = """
  def main(): Int
    task_group |g|
      0
    end
    return 0
  end
  """

def tg_single_src(): String = """
  def worker(): Int = 42
  def main(): Int
    var done = 0
    task_group |g|
      taskgroup_spawn(g, -> worker())
      done = 1
    end
    return done - 1
  end
  """

def tg_multi_src(): String = """
  def add_one(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    task_group |g|
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 3
      return 0
    end
    return 1
  end
  """

def tg_collect_src(): String = """
  def compute(n: Int): Int = n * 10
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> compute(1))
      taskgroup_spawn(g, -> compute(2))
      taskgroup_spawn(g, -> compute(3))
      taskgroup_collect(g)
    end
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    c = vec_get(results, 2)
    if a == 10 and b == 20 and c == 30
      return 0
    end
    return 1
  end
  """

def tg_collect_heavy_src(): String = """
  def heavy(n: Int): Int
    var sum = 0
    var idx = 0
    while idx < 1000
      sum += n
      idx += 1
    end
    return sum
  end
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> heavy(1))
      taskgroup_spawn(g, -> heavy(2))
      taskgroup_collect(g)
    end
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    if a == 1000 and b == 2000
      return 0
    end
    return 1
  end
  """

def tg_parallel_counter_src(): String = """
  def add_one(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    task_group |g|
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 5
      return 0
    end
    return 1
  end
  """

def tg_many_tasks_src(): String = """
  def add_one(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    task_group |g|
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 8
      return 0
    end
    return 1
  end
  """

def tg_expr_src(): String = """
  def compute(): Int = 42
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> compute())
      taskgroup_collect(g)
    end
    return vec_get(results, 0)
  end
  """

def tg_ufcs_spawn_src(): String = """
  def worker(): Int = 42
  def main(): Int
    var done = 0
    task_group |g|
      g.spawn(-> worker())
      done = 1
    end
    return done - 1
  end
  """

def tg_iscancelled_src(): String = """
  def worker(): Int = 1
  def main(): Int
    task_group |g|
      taskgroup_spawn(g, -> worker())
    end
    return is_cancelled()
  end
  """
