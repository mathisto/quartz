## Deque Tests
##
## Contract:
##   1. New: `deque_new` creates empty deque with size 0.
##   2. FIFO: push_back + pop_front maintains FIFO order.
##   3. LIFO: push_front + pop_back maintains LIFO order.
##   4. Mixed: interleaved push/pop produces correct order.
##   5. Empty: pop on empty deque returns None.
##   6. Index: get/set by logical index.
##   7. Wrap-around: ring buffer wrap-around handled.
##   8. Growth: capacity exceeded triggers growth.
##   9. Size: size tracks push/pop correctly.
##   10. Front-front: push_front then pop_front is LIFO.
import * from qspec
import * from collections/deque

def main(): Int
  describe("deque_new") do ->
    it("creates an empty deque") do ->
      var d = deque_new()
      assert_eq(d.size(), 0)
      assert_eq(d.is_empty(), 1)
      d.free()
    end
  end

  describe("push_back and pop_front") do ->
    it("maintains FIFO order") do ->
      assert_eq(deque_fifo_test(), 1)
    end
  end

  describe("push_front and pop_back") do ->
    it("maintains LIFO-like order") do ->
      assert_eq(deque_lifo_test(), 1)
    end
  end

  describe("mixed operations") do ->
    it("handles interleaved push/pop") do ->
      assert_eq(deque_mixed_test(), 1)
    end

    it("returns None on empty pop") do ->
      var d = deque_new()
      assert(d.pop_front().none?)
      assert(d.pop_back().none?)
      d.free()
    end
  end

  describe("get and set") do ->
    it("accesses by logical index") do ->
      assert_eq(deque_index_test(), 1)
    end
  end

  describe("wrap-around") do ->
    it("handles ring buffer wrap-around") do ->
      assert_eq(deque_wrap_test(), 1)
    end
  end

  describe("growth") do ->
    it("grows when capacity exceeded") do ->
      assert_eq(deque_growth_test(), 1)
    end
  end

  describe("size tracking") do ->
    it("size tracks push and pop") do ->
      var d = deque_new()
      d.push_back(1)
      assert_eq(d.size(), 1)
      d.push_back(2)
      assert_eq(d.size(), 2)
      d.pop_front()
      assert_eq(d.size(), 1)
      d.free()
    end

    it("push_front then pop_front is LIFO") do ->
      var d = deque_new()
      d.push_front(10)
      d.push_front(20)
      d.push_front(30)
      var val = 0
      match d.pop_front()
        Some(v) => val = v
        _ => val = -1
      end
      assert_eq(val, 30)
      d.free()
    end
  end

  return qspec_main()
end

def deque_fifo_test(): Int
  var d = deque_new()
  d.push_back(10)
  d.push_back(20)
  d.push_back(30)
  var a = 0
  var b = 0
  var c = 0
  match d.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  d.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def deque_lifo_test(): Int
  var d = deque_new()
  d.push_front(10)
  d.push_front(20)
  d.push_front(30)
  var a = 0
  var b = 0
  var c = 0
  match d.pop_back()
    Some(v) => a = v
    _ => return 0
  end
  match d.pop_back()
    Some(v) => b = v
    _ => return 0
  end
  match d.pop_back()
    Some(v) => c = v
    _ => return 0
  end
  d.free()
  if a == 10
    if b == 20
      if c == 30
        return 1
      end
    end
  end
  return 0
end

def deque_mixed_test(): Int
  var d = deque_new()
  d.push_back(1)
  d.push_front(0)
  d.push_back(2)
  # order: 0, 1, 2
  var a = 0
  var b = 0
  var c = 0
  match d.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  d.free()
  if a == 0
    if b == 1
      if c == 2
        return 1
      end
    end
  end
  return 0
end

def deque_index_test(): Int
  var d = deque_new()
  d.push_back(10)
  d.push_back(20)
  d.push_back(30)
  var a = d.get(0)
  var b = d.get(1)
  var c = d.get(2)
  d.set(1, 99)
  var d2 = d.get(1)
  d.free()
  if a == 10
    if b == 20
      if c == 30
        if d2 == 99
          return 1
        end
      end
    end
  end
  return 0
end

def deque_wrap_test(): Int
  # Use a small-capacity deque so we can force wrap-around
  var d = deque_new_with_capacity(4)
  d.push_back(1)
  d.push_back(2)
  d.push_back(3)
  d.pop_front()  # head moves to 1
  d.pop_front()  # head moves to 2
  d.push_back(4) # wraps around to slot 0
  d.push_back(5) # wraps around to slot 1
  # logical: 3, 4, 5
  var a = 0
  var b = 0
  var c = 0
  match d.pop_front()
    Some(v) => a = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => b = v
    _ => return 0
  end
  match d.pop_front()
    Some(v) => c = v
    _ => return 0
  end
  d.free()
  if a == 3
    if b == 4
      if c == 5
        return 1
      end
    end
  end
  return 0
end

def deque_growth_test(): Int
  var d = deque_new_with_capacity(2)
  d.push_back(1)
  d.push_back(2)
  d.push_back(3)  # triggers growth
  d.push_back(4)
  var ok = 1
  if d.size() != 4
    ok = 0
  end
  match d.pop_front()
    Some(v) => {
      if v != 1
        ok = 0
      end
    }
    _ => ok = 0
  end
  match d.pop_front()
    Some(v) => {
      if v != 2
        ok = 0
      end
    }
    _ => ok = 0
  end
  match d.pop_front()
    Some(v) => {
      if v != 3
        ok = 0
      end
    }
    _ => ok = 0
  end
  match d.pop_front()
    Some(v) => {
      if v != 4
        ok = 0
      end
    }
    _ => ok = 0
  end
  d.free()
  return ok
end
