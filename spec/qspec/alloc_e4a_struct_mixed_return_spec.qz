## QSpec coverage for Phase E.4.a slice 3.b — mixed-field struct
## returns from goroutines via `arena_promote_struct_mixed`.
##
## Slice 3.a (committed earlier in Phase E.4.a) handled
## **uniform-value-field** structs — every field is value-typed, no
## narrow-fixed-width — via raw slot-by-slot copy
## (`arena_promote_struct_value`). Slice 3.b extends to **mixed-field**
## structs containing at least one `String` or one nested
## uniform-value-field struct field. Each field is promoted according
## to its kind in a runtime-constructed descriptor passed to
## `arena_promote_struct_mixed`.
##
## Per-field kinds in the descriptor:
##   0 = value-typed i64 (Int/Bool/Char/Float/...) — copy verbatim
##   2 = String — call arena_promote_string per field
##   4 = uniform-value-field nested struct — call
##       arena_promote_struct_value(field, slot_count)
##
## Rejected (gate falls through to libc-heap fallback):
##   - any narrow-fixed-width field (I8/I16/I32/U8/U16/U32/CInt/CChar)
##   - any Vec<T> field (deferred — same as_vec blocker as slice 4)
##   - any mixed-nested struct field (recursive slice 3.b deferred)
##   - Map/Option/Result/Future/function-pointer/enum-with-payload
##
## What these tests prove:
##
##   E4a.s3b.a — Struct { String + Int } promoted; await reads both
##               fields with correct content (verifies String slot
##               promote + Int slot pass-through).
##   E4a.s3b.b — Struct { String + String + Int } — multiple String
##               fields each promoted independently. (Field named
##               `count` rather than `size` to dodge the pre-existing
##               `p.size` → `vec_size(p)` typechecker collision
##               documented in `feedback_quartz_module_quirks.md`.)
##   E4a.s3b.c — Struct { UniformInner + Int } — nested uniform-struct
##               field promoted via slice-3.a's helper called from
##               slice-3.b's per-field dispatch.
##   E4a.s3b.d — Multi-worker sched_init(0) parallel mixed-struct
##               returns.

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# E4a.s3b.a — Doc { title: String, count: Int }
# -----------------------------------------------------------------------------

var _DOC: String = """import * from std/sync/composition/go
import * from std/alloc

struct Doc
  title: String
  count: Int
end

def make_doc(): Doc
  return Doc { title: \"hello-world\", count: 42 }
end

def main(): Int
  sched_init(1)
  var fut = go make_doc()
  var d = await fut
  if d.title == \"hello-world\" and d.count == 42
    puts(\"doc-ok\")
  else
    puts(\"failed:title=\" + d.title + \",count=\" + str_from_int(d.count))
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3b.b — multi-String struct, each promoted independently.
# -----------------------------------------------------------------------------

var _MULTI_STRING: String = """import * from std/sync/composition/go
import * from std/alloc

struct Pair
  first: String
  second: String
  count: Int
end

def make_pair(): Pair
  var a = \"alpha-\" + str_from_int(1)
  var b = \"beta-\" + str_from_int(2)
  return Pair { first: a, second: b, count: 7 }
end

def main(): Int
  sched_init(1)
  var fut = go make_pair()
  var p = await fut
  if p.first == \"alpha-1\" and p.second == \"beta-2\" and p.count == 7
    puts(\"pair-ok\")
  else
    puts(\"failed\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3b.c — Struct with nested uniform-struct field.
# -----------------------------------------------------------------------------

var _NESTED_UNIFORM: String = """import * from std/sync/composition/go
import * from std/alloc

struct Inner
  x: Int
  y: Int
end

struct Outer
  inner: Inner
  tag: Int
end

def make_outer(): Outer
  return Outer { inner: Inner { x: 11, y: 22 }, tag: 99 }
end

def main(): Int
  sched_init(1)
  var fut = go make_outer()
  var o = await fut
  if o.inner.x == 11 and o.inner.y == 22 and o.tag == 99
    puts(\"nested-ok\")
  else
    puts(\"failed\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3b.d — Multi-worker parallel mixed-struct returns.
# -----------------------------------------------------------------------------

var _PARALLEL: String = """import * from std/sync/composition/go
import * from std/alloc

struct Doc
  title: String
  count: Int
end

def make_doc(n: Int): Doc
  return Doc { title: \"task-\" + str_from_int(n), count: n }
end

def main(): Int
  sched_init(0)
  var f1 = go make_doc(1)
  var f2 = go make_doc(2)
  var f3 = go make_doc(3)
  var d1 = await f1
  var d2 = await f2
  var d3 = await f3
  if d1.title == \"task-1\" and d2.title == \"task-2\" and d3.title == \"task-3\" and d1.count == 1 and d2.count == 2 and d3.count == 3
    puts(\"parallel-ok\")
  else
    puts(\"failed\")
  end
  sched_shutdown()
  return 0
end
"""

def main(): Int
  describe("Phase E.4.a slice 3.b — mixed-field struct returns from goroutines via arena_promote_struct_mixed") do ->
    it("Doc { title: String, count: Int } — String + Int field promote") do ->
      assert_run_stdout_eq(_DOC, "doc-ok\n")
    end

    it("Pair { first: String, second: String, count: Int } — multiple Strings + Int") do ->
      assert_run_stdout_eq(_MULTI_STRING, "pair-ok\n")
    end

    it("Outer { inner: UniformInner, tag: Int } — nested uniform-struct field promoted via slice-3.a helper") do ->
      assert_run_stdout_eq(_NESTED_UNIFORM, "nested-ok\n")
    end

    it("parallel mixed-struct goroutines under multi-worker scheduler (sched_init(0))") do ->
      assert_run_stdout_eq(_PARALLEL, "parallel-ok\n")
    end
  end
  return qspec_main()
end
