## Fn Type Annotation Tests
##
## Contract:
##   1. Fn(args): ret syntax.
##   2. Lambdas with fn types.
##   3. Closures with fn types.
##   4. Higher-order function patterns.

import * from qspec

def main(): Int
  describe("Fn(Args): Ret syntax") do ->
    it("allows Fn(Int): Int as parameter type") do ->
      assert_eq(fta_apply(fta_double, 21), 42)
    end

    it("allows multiple Fn parameters") do ->
      assert_eq(fta_compose(fta_double, fta_add_one, 20), 42)
    end

    it("allows multi-argument Fn types") do ->
      assert_eq(fta_apply_binary(fta_add, 20, 22), 42)
    end
  end

  describe("lambdas with Fn types") do ->
    it("allows lambda where Fn(Int): Int expected") do ->
      assert_eq(fta_apply(n -> n * 3, 14), 42)
    end

    it("allows multi-arg lambda with Fn type") do ->
      assert_eq(fta_apply_binary((x, y) -> x * y, 6, 7), 42)
    end
  end

  describe("closures with Fn types") do ->
    it("allows closure capturing local variable") do ->
      multiplier = 6
      assert_eq(fta_apply(n -> n * multiplier, 7), 42)
    end

    it("allows closure capturing multiple variables") do ->
      a = 10
      b = 20
      assert_eq(fta_apply(n -> n + a + b, 12), 42)
    end
  end

  describe("Fn type aliases (HB-DOG.3a)") do ->
    it("allows a named function through a Fn-alias parameter") do ->
      assert_eq(fta_apply_alias(fta_double, 21), 42)
    end

    it("allows a lambda through a Fn-alias parameter") do ->
      # Pre-fix: a `type X = Fn(...)` alias used as a parameter type
      # mis-resolved the lambda-arity check to 0 → QZ0200 "Lambda has 1
      # parameter(s) but FtaIntFn expects 0". The arity check now
      # resolves the alias before counting parameters.
      assert_eq(fta_apply_alias(n -> n * 3, 14), 42)
    end
  end

  describe("bidirectional lambda-param inference through Fn-alias (HB-DOG.3b)") do ->
    it("infers multi-param lambda types when the body relies on them") do ->
      # Pre-fix: bidir-inject path read the literal stored annotation
      # ("FtaFourFn") which `tc_fn_annotation_nth_param_str` couldn't
      # parse → params left as tv-vars → `b + d` defaulted to `Int + Int`
      # → "Lambda return type mismatch: expected String but got Int".
      assert_eq_str(fta_apply_four((a, b, c, d) -> b + d, 1, "X", 2, "Y"), "XY")
    end

    it("infers single-param lambda via alias when body needs the type") do ->
      # Without bidir, `n` defaults to Int; here multiplication still
      # typechecks, but the test pins the resolved-type path.
      assert_eq(fta_apply_alias(n -> n + 100, 23), 123)
    end

    it("infers via alias when the lambda body uses methods on the inferred type") do ->
      # Pre-fix: alias-blind nth_param_str left `o`/`nv` un-annotated →
      # `o.num + nv.num` worked by accident (struct-field inference can
      # recover when only one struct in scope has `.num: Int`), but
      # method-call dispatch was at the mercy of resolution order.
      # The fix makes the bidir path explicit so the body's `.num`
      # dispatch fires through the injected struct type.
      v1 = FtaHVal { num: 7 }
      v2 = FtaHVal { num: 35 }
      assert_eq(fta_attach_obs((o, nv) -> o.num + nv.num, v1, v2), 42)
    end
  end

  describe("Fn-typed field call through alias (HB-DOG.3c)") do ->
    it("allows obj.field(args) when the field is typed via Fn-alias") do ->
      # Pre-fix: the field-call dispatch site gated on
      # `ann.starts_with("Fn(")` and skipped alias-typed fields, so
      # `b.cb("...")` fell through to method-lookup → "Type 'Box' has no
      # method 'cb'".
      b = FtaAliasBox { cb: fta_double }
      assert_eq(b.cb(21), 42)
    end
  end

  describe("bidirectional lambda-param inference from let-binding annotation (BIDIR_LAMBDA_LET)") do ->
    it("infers multi-param lambda types when the body relies on them (let-position)") do ->
      # Pre-fix: the FIX.6 Phase 2 bidir-inject fired only at the call
      # site. A `var f: Fn(...) = (a, b) -> body` binding ran tc_expr on
      # the lambda BEFORE the LHS annotation was consulted, so params
      # defaulted to tv-vars → existential-erased to Int → `b + d`
      # typechecked as `Int + Int` (pointer add). The function compiled
      # but returned an arbitrary integer reinterpreted as a String
      # pointer at the call site → empty string / UB.
      var let_obs: Fn(Int, String, Int, String): String = (a, b, c, d) -> b + d
      assert_eq_str(let_obs(1, "AB", 2, "CD"), "ABCD")
    end

    it("infers via alias on a let-binding (alias-transparent)") do ->
      # Layer-2 of HB-DOG.3(b): the alias-transparent
      # `_tc_is_fn_ann` + `tc_fn_annotation_nth_param_str` make
      # `var f: Mapper = ...` work the same as the inline-Fn form.
      var let_alias: FtaFourFn = (a, b, c, d) -> b + d
      assert_eq_str(let_alias(0, "hello, ", 0, "world"), "hello, world")
    end

    it("infers struct types via alias for downstream method/field dispatch") do ->
      # Mirror of the HB-DOG.3(b) bidir-method-dispatch case at let
      # position. Pre-fix: `o`/`nv` un-annotated → `.num` dispatch by
      # accident only; with the fix the struct type is injected
      # explicitly before the body walks.
      var v1 = FtaHVal { num: 7 }
      var v2 = FtaHVal { num: 35 }
      var let_attach: FtaHObserver = (o, nv) -> o.num + nv.num
      assert_eq(let_attach(v1, v2), 42)
    end

    it("preserves explicit per-param annotations (no regression)") do ->
      # If the lambda already carries its own param annotations, the
      # injection must skip — the lambda handler reads str2 and the
      # injector gates on `str_byte_len(existing) == 0`.
      var let_explicit: Fn(Int, String): String = (n: Int, s: String) -> "#{n}-#{s}"
      assert_eq_str(let_explicit(3, "hi"), "3-hi")
    end

    it("single-param alias-typed let-binding infers param type") do ->
      var let_single: FtaIntFn = n -> n + 100
      assert_eq(let_single(23), 123)
    end
  end

  describe("higher-order function patterns") do ->
    it("allows Fn as return type") do ->
      f = fta_get_doubler()
      assert_eq(f(21), 42)
    end

    it("allows Fn in struct field via dot syntax") do ->
      cb = FtaCallback { f: fta_double }
      assert_eq(cb.f(21), 42)
    end
  end

  return qspec_main()
end

def fta_double(n: Int): Int
  return n * 2
end

def fta_add_one(n: Int): Int
  return n + 1
end

def fta_add(x: Int, y: Int): Int
  return x + y
end

def fta_apply(f: Fn(Int): Int, x: Int): Int
  return f(x)
end

def fta_compose(f: Fn(Int): Int, g: Fn(Int): Int, x: Int): Int
  return f(g(x))
end

def fta_apply_binary(f: Fn(Int, Int): Int, a: Int, b: Int): Int
  return f(a, b)
end

def fta_get_doubler(): Fn(Int): Int
  return fta_double
end

struct FtaCallback
  f: Fn(Int): Int
end

type FtaIntFn = Fn(Int): Int

def fta_apply_alias(f: FtaIntFn, x: Int): Int
  return f(x)
end

# HB-DOG.3(b) regression — multi-arg alias with mixed param types so that
# bidir inference is load-bearing (`b + d` is String+String only if `b`/`d`
# are inferred as Strings; otherwise it parses as Int+Int and fails to
# unify with the expected String return).
type FtaFourFn = Fn(Int, String, Int, String): String

def fta_apply_four(f: FtaFourFn, a: Int, b: String, c: Int, d: String): String
  return f(a, b, c, d)
end

# HB-DOG.3(c) regression — Fn-typed field reached through an alias, so the
# field-call dispatch path must resolve the alias before deciding whether
# `b.cb(arg)` is a Fn-call vs a method-lookup.
struct FtaAliasBox
  cb: FtaIntFn
end

# HB-DOG.3(b) bidir-method-dispatch regression — observer signature uses
# struct types, body calls `.num`. Bidir inference must inject the struct
# type into the lambda params for downstream method/field dispatch to fire.
struct FtaHVal
  num: Int
end

type FtaHObserver = Fn(FtaHVal, FtaHVal): Int

def fta_attach_obs(o: FtaHObserver, v1: FtaHVal, v2: FtaHVal): Int
  return o(v1, v2)
end

