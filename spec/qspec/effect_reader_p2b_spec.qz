## Reader<R> — Phase 2 Milestone P2.b acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone P2.b.
##
## Covers:
##   * `with Reader(v) do ... end` call-form handler shorthand.
##   * `ask()` op routes through the default Reader handler and reads the
##     current install's evidence slot.
##   * Nested `with Reader(a) do with Reader(b) do ask() end end` — inner
##     shadow, outer unchanged on scope exit.
##   * `local(f, body)` combinator shadows the ambient for `body` only.
##   * Cross-function perform via `can Reader` signature + dynamic
##     dispatch.
##
## Note: helpers use explicit `: Int can Reader` return types —
## `def helper() can Reader = ...` without explicit `: Int` triggers a
## pre-existing type inference bug (see
## `docs/bugs/IMPLICIT_RETURN_TYPE_WITH_CAN_ROW.md`).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Reader<R> — ambient-value effect") do ->
    it("ask() reads the initial Reader value") do ->
      assert_run_stdout_eq("""
import std/reader

def main(): Int
  var r = with Reader(42) do ->
    ask()
  end
  puts(r.to_s())
  return 0
end
""", "42\n")
    end

    it("ask() composes in arithmetic expressions") do ->
      assert_run_stdout_eq("""
import std/reader

def double_ask(): Int can Reader = ask() * 2

def main(): Int
  var r = with Reader(21) do ->
    double_ask()
  end
  puts(r.to_s())
  return 0
end
""", "42\n")
    end

    it("nested Reader: inner shadows outer, outer unchanged on exit") do ->
      assert_run_stdout_eq("""
import std/reader

def main(): Int
  var r = with Reader(1) do ->
    var inner = with Reader(2) do ->
      ask()
    end
    inner + ask()
  end
  puts(r.to_s())
  return 0
end
""", "3\n")
    end

    it("local(f, body) shadows ambient for body via f(ask())") do ->
      assert_run_stdout_eq("""
import std/reader

def main(): Int
  var r = with Reader(5) do ->
    local(x -> x + 100, () -> ask())
  end
  puts(r.to_s())
  return 0
end
""", "105\n")
    end

    it("local body's return is the with-expression value; outer Reader restored") do ->
      assert_run_stdout_eq("""
import std/reader

def main(): Int
  var r = with Reader(10) do ->
    var inside = local(x -> x * 3, () -> ask())
    var outside = ask()
    inside + outside
  end
  puts(r.to_s())
  return 0
end
""", "40\n")
    end

    it("cross-function can-Reader routes through dynamic dispatch") do ->
      assert_run_stdout_eq("""
import std/reader

def sum_with_ambient(n: Int): Int can Reader
  var total = 0
  var i = 0
  while i < n
    total = total + ask()
    i = i + 1
  end
  return total
end

def main(): Int
  var r = with Reader(7) do ->
    sum_with_ambient(3)
  end
  puts(r.to_s())
  return 0
end
""", "21\n")
    end

    it("Reader composes with State on the same with-stack") do ->
      assert_run_stdout_eq("""
import std/reader
import std/state

def main(): Int
  var r = with Reader(10) do ->
    with State(0) do ->
      set(ask() + get())
      set(ask() + get())
      get()
    end
  end
  puts(r.to_s())
  return 0
end
""", "20\n")
    end
  end

  return qspec_main()
end
