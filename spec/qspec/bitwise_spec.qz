## Bitwise Operations Tests
##
## Contract:
##   1. Bor (bitwise or).
##   2. Band (bitwise and).
##   3. Bxor (bitwise xor).
##   4. Bnot (bitwise not).
##   5. ~ unary operator.
##   6. Combined operations.
##   7. Bitwise properties.
import * from qspec
import * from qspec/property

def main(): Int
  describe("bor (bitwise OR)") do ->
    it("performs bitwise OR") do ->
      assert_eq(bor(5, 3), 7)
    end

    it("works with zero") do ->
      assert_eq(bor(42, 0), 42)
    end
  end

  describe("band (bitwise AND)") do ->
    it("performs bitwise AND") do ->
      assert_eq(band(7, 3), 3)
    end

    it("masks bits correctly") do ->
      assert_eq(band(255, 15), 15)
    end
  end

  describe("bxor (bitwise XOR)") do ->
    it("performs bitwise XOR") do ->
      assert_eq(bxor(5, 3), 6)
    end

    it("self-XOR yields zero") do ->
      assert_eq(bxor(42, 42), 0)
    end
  end

  describe("bnot (bitwise NOT)") do ->
    it("inverts all bits") do ->
      var x = bnot(0)
      var y = band(x, 1)
      assert_eq(y, 1)
    end

    it("double NOT returns original") do ->
      assert_eq(bnot(bnot(42)), 42)
    end
  end

  describe("~ unary operator") do ->
    it("inverts bits of zero") do ->
      assert_eq(~0, -1)
    end

    it("double ~ returns original") do ->
      assert_eq(~~42, 42)
    end

    it("agrees with bnot intrinsic") do ->
      assert_eq(~255, bnot(255))
    end

    it("works on variables") do ->
      var x = 15
      assert_eq(~x, bnot(15))
    end

    it("works in expressions") do ->
      assert_eq(band(~0, 255), 255)
    end
  end

  describe("combined operations") do ->
    it("works with pipeline operator") do ->
      result = 5 |> bor(3)
      assert_eq(result, 7)
    end

    it("masks and shifts for flag extraction") do ->
      var flags = bor(bor(1, 4), 16)
      var has_flag_4 = band(flags, 4)
      assert_eq(has_flag_4, 4)
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("bitwise properties") do ->
    property_commutative("bor is commutative", bw_bor)
    property_commutative("band is commutative", bw_band)
    property_commutative("bxor is commutative", bw_bxor)

    forall_i("double NOT is identity: ~~x == x") do x: Int ->
      assert_eq(bnot(bnot(x)), x)
    end

    forall_i("XOR self-inverse: x ^ x == 0") do x: Int ->
      assert_eq(bxor(x, x), 0)
    end

    forall_i("OR with zero is identity: x | 0 == x") do x: Int ->
      assert_eq(bor(x, 0), x)
    end

    forall_i("AND with zero is annihilator: x & 0 == 0") do x: Int ->
      assert_eq(band(x, 0), 0)
    end

    forall_ii("XOR triple inverse: (a ^ b) ^ b == a") do a: Int, b: Int ->
      assert_eq(bxor(bxor(a, b), b), a)
    end
  end

  return qspec_main()
end

def bw_bor(a: Int, b: Int): Int = bor(a, b)
def bw_band(a: Int, b: Int): Int = band(a, b)
def bw_bxor(a: Int, b: Int): Int = bxor(a, b)
