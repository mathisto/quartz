## Route Groups Spec — Tests for prefix-based route grouping

import * from qspec
import std/net/http_server

# =============================================================================
# Test helpers
# =============================================================================

def print_group_adds_route(): Void
  var r = router_new()
  var api = router_group(r, "/api/v1")
  api.group_get("/users", req: Request -> text_response("users"))
  # The route should be registered on the router
  puts(str_from_int(r.routes.size))
end

def print_group_pattern(): Void
  var r = router_new()
  var api = router_group(r, "/api")
  api.group_get("/items", req: Request -> text_response("items"))
  # Check that the pattern has the prefix
  puts(r.routes[0].pattern)
end

def print_group_matches(): Void
  var r = router_new()
  var api = router_group(r, "/api/v1")
  api.group_get("/hello", req: Request -> text_response("hello from group"))
  var handler = router_handler(r)
  var req = Request {
    method: "GET", path: "/api/v1/hello", query_string: "", body: "",
    raw_path: "/api/v1/hello",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var resp = handler(req)
  puts(resp.body)
end

def print_group_post(): Void
  var r = router_new()
  var api = router_group(r, "/api")
  api.group_post("/create", req: Request -> created("{\"ok\":true}"))
  puts(r.routes[0].method)
  puts(r.routes[0].pattern)
end

def print_group_multiple_routes(): Void
  var r = router_new()
  var api = router_group(r, "/api")
  api.group_get("/a", req: Request -> text_response("a"))
  api.group_get("/b", req: Request -> text_response("b"))
  api.group_post("/c", req: Request -> text_response("c"))
  puts(str_from_int(r.routes.size))
end

def print_group_with_params(): Void
  var r = router_new()
  var api = router_group(r, "/api")
  api.group_get("/users/:id", req: Request -> text_response(path_param(req, "id")))
  var handler = router_handler(r)
  var req = Request {
    method: "GET", path: "/api/users/42", query_string: "", body: "",
    raw_path: "/api/users/42",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var resp = handler(req)
  puts(resp.body)
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("router_group") do ->
    it("adds routes to the underlying router") do ->
      assert_output("1\n", print_group_adds_route)
    end

    it("prepends prefix to pattern") do ->
      assert_output("/api/items\n", print_group_pattern)
    end

    it("routes match with prefix") do ->
      assert_output("hello from group\n", print_group_matches)
    end

    it("supports POST method") do ->
      assert_output("POST\n/api/create\n", print_group_post)
    end

    it("supports multiple routes in group") do ->
      assert_output("3\n", print_group_multiple_routes)
    end

    it("supports path params in grouped routes") do ->
      assert_output("42\n", print_group_with_params)
    end
  end

  return qspec_main()
end
