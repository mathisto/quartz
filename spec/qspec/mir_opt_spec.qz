## MIR Optimizer Tests
##
## Contract:
##   1. Constant folding.
##   2. Algebraic identity.
##   3. Annihilator.
##   4. Copy propagation.
##   5. Cse.
##   6. Correctness with complex programs.
##   7. Ir verification.

import * from qspec

def mo_fold_add(): Void
  var x = 3 + 5
  print_int(x)
end

def mo_fold_sub(): Void
  var x = 10 - 3
  print_int(x)
end

def mo_fold_mul(): Void
  var x = 6 * 7
  print_int(x)
end

def mo_fold_div(): Void
  var x = 100 / 4
  print_int(x)
end

def mo_fold_mod(): Void
  var x = 17 % 5
  print_int(x)
end

def mo_fold_cmp(): Void
  if 3 < 5
    print_int(1)
  else
    print_int(0)
  end
  if 5 == 5
    print_int(1)
  else
    print_int(0)
  end
  if 3 > 5
    print_int(1)
  else
    print_int(0)
  end
end

def mo_fold_chained(): Void
  var x = (2 + 3) * (4 + 6)
  print_int(x)
end

def mo_fold_bitwise(): Void
  var x = band(15, 9)
  var y = bor(6, 3)
  print_int(x)
  print_int(y)
end

def mo_fold_shift(): Void
  var x = shl(1, 4)
  var y = shr(32, 2)
  print_int(x)
  print_int(y)
end

def mo_id_add0(n: Int): Int = n + 0
def mo_id_0add(n: Int): Int = 0 + n
def mo_id_sub0(n: Int): Int = n - 0
def mo_id_mul1(n: Int): Int = n * 1
def mo_id_1mul(n: Int): Int = 1 * n
def mo_id_div1(n: Int): Int = n / 1
def mo_id_or0(n: Int): Int = bor(n, 0)

def mo_ann_mul0(n: Int): Int = n * 0
def mo_ann_0mul(n: Int): Int = 0 * n
def mo_ann_sub_self(n: Int): Int = n - n

def mo_copy_prop(): Void
  var x = 42
  var y = x
  var z = y
  print_int(z)
end

def mo_side_effect(n: Int): Int = n
def mo_copy_across_call(): Void
  var x = 10
  var y = mo_side_effect(x)
  print_int(x + y)
end

def mo_cse(): Void
  var a = 5
  var b = 3
  var x = a + b
  var y = a + b
  print_int(x + y)
end

def mo_fib(n: Int): Int
  if n <= 1
    return n
  end
  return mo_fib(n - 1) + mo_fib(n - 2)
end

def mo_fib_prints(): Void
  print_int(mo_fib(10))
end

def mo_loop_acc(): Void
  var sum = 0
  for i in 0..10
    sum += i
  end
  print_int(sum)
end

def mo_add(a: Int, b: Int): Int = a + b
def mo_mul(a: Int, b: Int): Int = a * b
def mo_nested_calls(): Void
  var x = mo_add(3, 4)
  var y = mo_mul(x, 6)
  print_int(y)
end

def mo_str_ops(): Void
  var s = "hello"
  var t = s + " world"
  puts(t)
end

def mo_compute(x: Int): Int
  var out = match x
    1 => 10
    2 => 20
    _ => 99
  end
  return out
end

def mo_match_prints(): Void
  print_int(mo_compute(1))
  print_int(mo_compute(2))
  print_int(mo_compute(3))
end

def mo_shift_id(): Void
  var x = 42
  var y = shl(x, 0)
  var z = shr(x, 0)
  print_int(y)
  print_int(z)
end

def main(): Int
  describe("constant folding") do ->
    it("folds addition of two constants") do ->
      assert_output("8\n", mo_fold_add)
    end

    it("folds subtraction of two constants") do ->
      assert_output("7\n", mo_fold_sub)
    end

    it("folds multiplication of two constants") do ->
      assert_output("42\n", mo_fold_mul)
    end

    it("folds division of two constants") do ->
      assert_output("25\n", mo_fold_div)
    end

    it("folds modulo of two constants") do ->
      assert_output("2\n", mo_fold_mod)
    end

    it("folds comparison operators") do ->
      assert_output("1\n1\n0\n", mo_fold_cmp)
    end

    it("folds chained constant expressions") do ->
      assert_output("50\n", mo_fold_chained)
    end

    it("folds bitwise operations") do ->
      assert_output("9\n7\n", mo_fold_bitwise)
    end

    it("folds shift operations") do ->
      assert_output("16\n8\n", mo_fold_shift)
    end
  end

  describe("algebraic identity") do ->
    it("simplifies x + 0") do ->
      assert_eq(mo_id_add0(42), 42)
    end

    it("simplifies 0 + x") do ->
      assert_eq(mo_id_0add(42), 42)
    end

    it("simplifies x - 0") do ->
      assert_eq(mo_id_sub0(99), 99)
    end

    it("simplifies x * 1") do ->
      assert_eq(mo_id_mul1(77), 77)
    end

    it("simplifies 1 * x") do ->
      assert_eq(mo_id_1mul(55), 55)
    end

    it("simplifies x / 1") do ->
      assert_eq(mo_id_div1(33), 33)
    end

    it("simplifies x | 0") do ->
      assert_eq(mo_id_or0(88), 88)
    end

    it("simplifies x << 0 and x >> 0") do ->
      assert_output("42\n42\n", mo_shift_id)
    end
  end

  describe("annihilator") do ->
    it("simplifies x * 0") do ->
      assert_eq(mo_ann_mul0(999), 0)
    end

    it("simplifies 0 * x") do ->
      assert_eq(mo_ann_0mul(999), 0)
    end

    it("simplifies x - x") do ->
      assert_eq(mo_ann_sub_self(42), 0)
    end
  end

  describe("copy propagation") do ->
    it("propagates simple variable copies") do ->
      assert_output("42\n", mo_copy_prop)
    end

    it("does not propagate across function calls") do ->
      assert_output("20\n", mo_copy_across_call)
    end
  end

  describe("CSE") do ->
    it("deduplicates repeated binary expressions") do ->
      assert_output("16\n", mo_cse)
    end
  end

  describe("correctness with complex programs") do ->
    it("fibonacci works correctly") do ->
      assert_output("55\n", mo_fib_prints)
    end

    it("loops with accumulator work correctly") do ->
      assert_output("45\n", mo_loop_acc)
    end

    it("nested function calls work correctly") do ->
      assert_output("42\n", mo_nested_calls)
    end

    it("string operations work correctly") do ->
      assert_output("hello world\n", mo_str_ops)
    end

    it("match expressions work correctly") do ->
      assert_output("10\n20\n99\n", mo_match_prints)
    end
  end

  describe("IR verification") do ->
    # A.30: mir_opt::mir_optimize is wired into the default pipeline
    # (quartz.qz Phase 5.5) and its shared forward-map operand resolution is
    # now exhaustive, so CONST + CONST folds deterministically.
    it("constant folds 3 + 5 to 8 in generated IR") do ->
      assert_ir_contains("def fold_test(): Int = 3 + 5\ndef main(): Int\n  return fold_test()\nend\n", "add i64 0, 8")
    end
  end

  return qspec_main()
end
