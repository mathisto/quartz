## String Interpolation Tests
##
## Contract:
##   1. Basic interpolation.
##   2. Integer interpolation.
##   3. Expression interpolation.
##   4. Edge cases.
##   5. Return value.

import * from qspec

def main(): Int
  describe("basic interpolation") do ->
    it("interpolates a single variable") do ->
      x = "world"
      assert_eq_str(interp_single(x), "hello world")
    end

    it("interpolates at the start of string") do ->
      name = "Alice"
      assert_eq_str(interp_start(name), "Alice says hi")
    end

    it("interpolates at the end of string") do ->
      thing = "Quartz"
      assert_eq_str(interp_end(thing), "I love Quartz")
    end

    it("handles string with only interpolation") do ->
      val = "hello"
      result = "#{val}"
      assert_eq_str(result, "hello")
    end
  end

  describe("integer interpolation") do ->
    it("converts integer to string") do ->
      n = 42
      assert_eq_str(interp_int(n), "value is 42")
    end

    it("converts zero") do ->
      n = 0
      assert_eq_str(interp_int(n), "value is 0")
    end

    it("mixes strings and integers") do ->
      assert_eq_str(interp_mix(), "x=10 y=20")
    end
  end

  describe("expression interpolation") do ->
    it("evaluates arithmetic in interpolation") do ->
      assert_eq_str(interp_arith(), "result is 42")
    end

    it("calls functions in interpolation") do ->
      assert_eq_str(interp_fn_call(), "double of 5 is 10")
    end
  end

  describe("edge cases") do ->
    it("works with plain strings (no interpolation)") do ->
      result = "no interpolation here"
      assert_eq_str(result, "no interpolation here")
    end
  end

  describe("return value") do ->
    it("returns interpolated string from function") do ->
      result = greet("World")
      assert_eq_str(result, "Hello, World!")
    end
  end

  # ===========================================================================
  # Advanced interpolation (TEST.2 Phase 6)
  # ===========================================================================
  describe("advanced interpolation") do ->
    it("interpolation with complex arithmetic expression") do ->
      assert_eq_str("val=#{(2 + 3) * 4}", "val=20")
    end

    it("adjacent interpolations") do ->
      a = 1
      b = 2
      assert_eq_str("#{a}#{b}", "12")
    end

    it("interpolation with zero and negative") do ->
      assert_eq_str("#{0} #{-1}", "0 -1")
    end
  end

  return qspec_main()
end

def interp_single(x: String): String
  return "hello #{x}"
end

def interp_start(name: String): String
  return "#{name} says hi"
end

def interp_end(thing: String): String
  return "I love #{thing}"
end

def interp_int(n: Int): String
  return "value is #{n}"
end

def interp_mix(): String
  x = 10
  y = 20
  return "x=#{x} y=#{y}"
end

def interp_arith(): String
  return "result is #{6 * 7}"
end

def double(n: Int): Int
  return n * 2
end

def interp_fn_call(): String
  return "double of 5 is #{double(5)}"
end

def greet(name: String): String
  return "Hello, #{name}!"
end
