## qzmod_format — header serialization + path derivation + output-hash discipline.
##
## Phase 1.0 acceptance: format primitives round-trip cleanly in isolation,
## without touching compile() integration. Validates the on-disk vocabulary
## (header.txt format, path derivation, section file canonical order, hashing
## determinism) before emit/load wire up.

import * from qspec
import qzmod_format

# =============================================================================
# Helpers (named per CLAUDE.md feedback_bool_to_int_in_qspec_lambdas.md —
# assert_output / named helpers vs. inline closures).
# =============================================================================

def qmf_safe_name_simple(): String = qzmod_format::qzmod_module_safe_name("foo")
def qmf_safe_name_nested(): String = qzmod_format::qzmod_module_safe_name("std/sync/channel")
def qmf_safe_name_deep(): String = qzmod_format::qzmod_module_safe_name("a/b/c/d/e")

def qmf_compiler_shard_short(): String = qzmod_format::qzmod_compiler_shard("abc123def4567890")
def qmf_compiler_shard_long(): String = qzmod_format::qzmod_compiler_shard("abc123def4567890XXXXXXXX")

def qmf_module_dir_typical(): String
  return qzmod_format::qzmod_module_dir("/projects/quartz", "abc123def4567890", "std/sync/channel")
end

def qmf_module_dir_no_root(): String
  return qzmod_format::qzmod_module_dir("", "abc123def4567890", "foo")
end

# Build a header, format it, parse it, return is_valid * 10 + n_deps.
def qmf_roundtrip_basic(): Int
  var dep_names = vec_new<String>()
  var dep_hashes = vec_new<String>()
  dep_names.push("std/io")
  dep_hashes.push("aaaaaaaaaaaaaaaa")
  dep_names.push("std/string")
  dep_hashes.push("bbbbbbbbbbbbbbbb")

  var content = qzmod_format::qzmod_header_format(
    "1111111111111111", "2222222222222222", "3333333333333333", "4444444444444444",
    dep_names, dep_hashes
  )
  var hdr = qzmod_format::qzmod_header_parse(content)
  return hdr.is_valid * 10 + hdr.dep_names.size
end

# Round-trip + cross-check that every field survives.
def qmf_roundtrip_compiler_hash(): String
  var deps = vec_new<String>()
  var hashes = vec_new<String>()
  var content = qzmod_format::qzmod_header_format(
    "deadbeefdeadbeef", "1111111111111111", "2222222222222222", "3333333333333333",
    deps, hashes
  )
  var hdr = qzmod_format::qzmod_header_parse(content)
  return hdr.compiler_hash
end

def qmf_roundtrip_dep_lookup(): String
  var deps = vec_new<String>()
  var hashes = vec_new<String>()
  deps.push("std/log")
  hashes.push("cafebabe12345678")
  var content = qzmod_format::qzmod_header_format(
    "1111111111111111", "2222222222222222", "3333333333333333", "4444444444444444",
    deps, hashes
  )
  var hdr = qzmod_format::qzmod_header_parse(content)
  if hdr.dep_names.size == 0
    return ""
  end
  return "#{hdr.dep_names[0]}|#{hdr.dep_iface_hashes[0]}"
end

# Empty input must parse to is_valid=0, never crash.
def qmf_parse_empty_is_invalid(): Int
  var hdr = qzmod_format::qzmod_header_parse("")
  return hdr.is_valid
end

# Wrong magic must parse to is_valid=0.
def qmf_parse_wrong_magic_is_invalid(): Int
  var content = "NOTQZMOD\n1\n0\n0\nh1\nh2\nh3\nh4\n0\n"
  var hdr = qzmod_format::qzmod_header_parse(content)
  return hdr.is_valid
end

# MAJOR mismatch must parse to is_valid=0 (reader cannot handle).
def qmf_parse_major_mismatch_is_invalid(): Int
  var content = "QZMOD-V1\n999\n0\n0\nh1\nh2\nh3\nh4\n0\n"
  var hdr = qzmod_format::qzmod_header_parse(content)
  return hdr.is_valid
end

# Canonical flags hash format — same inputs hash to same string.
def qmf_canonical_flags_determinism(): Int
  var a = qzmod_format::qzmod_canonical_flags("arm64-apple-macosx14.0.0", 1, 0, 1)
  var b = qzmod_format::qzmod_canonical_flags("arm64-apple-macosx14.0.0", 1, 0, 1)
  if a.eq(b)
    return 1
  end
  return 0
end

# Different flags hash to different strings.
def qmf_canonical_flags_differ(): Int
  var a = qzmod_format::qzmod_canonical_flags("arm64-apple-macosx14.0.0", 1, 0, 1)
  var b = qzmod_format::qzmod_canonical_flags("arm64-apple-macosx14.0.0", 0, 0, 1)
  if a.eq(b)
    return 0
  end
  return 1
end

# Section files canonical order is non-empty and deterministic.
def qmf_section_files_count(): Int
  var a = qzmod_format::qzmod_section_files_canonical()
  return a.size
end

def qmf_section_files_deterministic(): Int
  var a = qzmod_format::qzmod_section_files_canonical()
  var b = qzmod_format::qzmod_section_files_canonical()
  if a.size != b.size
    return 0
  end
  for i in 0..a.size
    if not a[i].eq(b[i])
      return 0
    end
  end
  return 1
end

def main(): Int
  describe("qzmod_format module path helpers") do ->
    it("module_safe_name preserves single segment") do ->
      assert_eq_str(qmf_safe_name_simple(), "foo")
    end

    it("module_safe_name replaces / with __") do ->
      assert_eq_str(qmf_safe_name_nested(), "std__sync__channel")
    end

    it("module_safe_name handles deep nesting") do ->
      assert_eq_str(qmf_safe_name_deep(), "a__b__c__d__e")
    end

    it("compiler_shard passes 16-char input through") do ->
      assert_eq_str(qmf_compiler_shard_short(), "abc123def4567890")
    end

    it("compiler_shard truncates longer input to 16 chars") do ->
      assert_eq_str(qmf_compiler_shard_long(), "abc123def4567890")
    end

    it("module_dir composes project_root + shard + safe_name") do ->
      assert_eq_str(qmf_module_dir_typical(), "/projects/quartz/.quartz-cache/abc123def4567890/std__sync__channel")
    end

    it("module_dir handles empty project_root with relative root") do ->
      assert_eq_str(qmf_module_dir_no_root(), ".quartz-cache/abc123def4567890/foo")
    end
  end

  describe("qzmod_format header round-trip") do ->
    it("basic header with two deps round-trips") do ->
      # is_valid=1, n_deps=2 → 12
      assert_eq(qmf_roundtrip_basic(), 12)
    end

    it("compiler_hash survives round-trip") do ->
      assert_eq_str(qmf_roundtrip_compiler_hash(), "deadbeefdeadbeef")
    end

    it("dep name + iface_hash survive round-trip") do ->
      assert_eq_str(qmf_roundtrip_dep_lookup(), "std/log|cafebabe12345678")
    end
  end

  describe("qzmod_format header parse failure modes") do ->
    it("empty content is invalid") do ->
      assert_eq(qmf_parse_empty_is_invalid(), 0)
    end

    it("wrong magic is invalid") do ->
      assert_eq(qmf_parse_wrong_magic_is_invalid(), 0)
    end

    it("MAJOR mismatch is invalid") do ->
      assert_eq(qmf_parse_major_mismatch_is_invalid(), 0)
    end
  end

  describe("qzmod_format canonical encoding") do ->
    it("canonical_flags is deterministic for same inputs") do ->
      assert_eq(qmf_canonical_flags_determinism(), 1)
    end

    it("canonical_flags differs for different inputs") do ->
      assert_eq(qmf_canonical_flags_differ(), 1)
    end

    it("section_files_canonical is non-empty") do ->
      # Phase 1 ships >= 25 section files; allow growth but fail on regression.
      var n = qmf_section_files_count()
      var ok = 0
      if n >= 25
        ok = 1
      end
      assert_eq(ok, 1)
    end

    it("section_files_canonical is deterministic across calls") do ->
      assert_eq(qmf_section_files_deterministic(), 1)
    end
  end

  return qspec_main()
end
