## STRESS: Type Inference Limits
##
## Adversarial tests probing inference edge cases:
## long chains, generic containers, match arms, lambda arguments,
## UFCS chains, and inference with complex expressions.
##
## Contract:
##   1. Inference: long chains.
##   2. Inference: generic containers.
##   3. Inference: match arms.
##   4. Inference: lambdas.
##   5. Inference: UFCS chains.
##   6. Inference: complex scenarios.
##   7. Inference: additional edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Long Inference Chains
  # ===========================================================================
  describe("inference: long chains") do ->
    it("inference through 5-variable chain") do ->
      assert_run_exits("""
        def main(): Int
          a = 42
          b = a
          c = b
          d = c
          e = d
          return e
        end
        """, 42)
    end

    it("inference through arithmetic chain") do ->
      assert_run_exits("""
        def main(): Int
          a = 10
          b = a + 5
          c = b * 2
          d = c + 2
          e = d - 10
          return e + 20
        end
        """, 42)
    end

    it("inference through function return chain") do ->
      assert_run_exits("""
        def f1(): Int = 10
        def f2(): Int = f1() + 10
        def f3(): Int = f2() + 10
        def f4(): Int = f3() + 12
        def main(): Int
          return f4()
        end
        """, 42)
    end

    it("inferred var then reassigned") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          x = 42
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Inference Through Generic Containers
  # ===========================================================================
  describe("inference: generic containers") do ->
    it("vec type inferred from push") do ->
      assert_run_exits("""
        def main(): Int
          var v = vec_new()
          v.push(42)
          return v[0]
        end
        """, 42)
    end

    it("inferred vec with UFCS") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          return v[0]
        end
        """, 42)
    end

    it("inference from vec_get result") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          x = v[0]
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: Inference Through Match Arms
  # ===========================================================================
  describe("inference: match arms") do ->
    it("match returning consistent Int type") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          result = match x
            1 => 10
            2 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match with computation in arms") do ->
      assert_run_exits("""
        def main(): Int
          x = 3
          result = match x
            1 => 10 + 1
            2 => 20 + 2
            3 => 40 + 2
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match result used in subsequent computation") do ->
      assert_run_exits("""
        def main(): Int
          x = 1
          base = match x
            1 => 20
            _ => 0
          end
          return base + 22
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category D: Inference With Lambdas
  # ===========================================================================
  describe("inference: lambdas") do ->
    it("lambda type inferred from assignment") do ->
      assert_run_exits("""
        def main(): Int
          f = (x: Int) -> x * 2
          return f(21)
        end
        """, 42)
    end

    it("lambda passed to typed function parameter") do ->
      assert_run_exits("""
        def apply(f: Fn(Int): Int, x: Int): Int = f(x)
        def main(): Int
          return apply(x -> x + 1, 41)
        end
        """, 42)
    end

    it("nullary lambda inferred as Fn(): Int") do ->
      assert_run_exits("""
        def invoke_fn(f: Fn(): Int): Int = f()
        def main(): Int
          return invoke_fn(-> 42)
        end
        """, 42)
    end

    it("lambda result used in arithmetic") do ->
      assert_run_exits("""
        def main(): Int
          f = (x: Int) -> x + 10
          g = (x: Int) -> x + 12
          return f(10) + g(10)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: Inference With UFCS Chains
  # ===========================================================================
  describe("inference: UFCS chains") do ->
    it("string UFCS size inferred") do ->
      assert_run_exits("""
        def main(): Int
          s = "hello world!"
          n = s.size
          return n + 30
        end
        """, 42)
    end

    it("chained UFCS on Vec") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(42)
          n = v.size
          return v[0] + n - 1
        end
        """, 42)
    end

    it("UFCS result in conditional") do ->
      assert_run_exits("""
        def main(): Int
          s = "test"
          if s.size == 4
            return 42
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Complex Inference Scenarios
  # ===========================================================================
  describe("inference: complex scenarios") do ->
    it("inference with nested function calls") do ->
      assert_run_exits("""
        def add(a: Int, b: Int): Int = a + b
        def mul(a: Int, b: Int): Int = a * b
        def main(): Int
          result = add(mul(2, 3), mul(6, 6))
          return result
        end
        """, 42)
    end

    ## FIXED: parser now accepts `then` keyword after if-condition
    it("if-then-else as inline expression in block-style function") do ->
      assert_run_exits("""
        def pick(x: Int): Int
          if x == 1 then 42 else 0 end
        end
        def main(): Int = pick(1)
        """, 42)
    end

    it("if-then-else on same line as block if") do ->
      assert_run_exits("""
        def main(): Int
          var x = 1
          if x == 1 then
            return 42
          else
            return 0
          end
        end
        """, 42)
    end

    it("if-then-elsif-then-else chain") do ->
      assert_run_exits("""
        def classify(n: Int): Int
          if n > 100 then
            return 3
          elsif n > 10 then
            return 2
          elsif n > 0 then
            return 1
          else
            return 0
          end
        end
        def main(): Int = classify(50)
        """, 2)
    end

    it("inference through struct field") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def main(): Int
          p = Point { x: 20, y: 22 }
          result = p.x + p.y
          return result
        end
        """, 42)
    end

    it("inference with compound assignment") do ->
      assert_run_exits("""
        def main(): Int
          var x = 10
          x += 32
          return x
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Additional Inference Edge Cases
  # ===========================================================================
  describe("inference: additional edge cases") do ->
    it("inference through nested generic function calls") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          result = id(id(id(42)))
          return result
        end
        """, 42)
    end

    it("inference through loop-carried variable") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0..7
            sum += i
          end
          return sum + 21
        end
        """, 42)
    end

    it("inference with ternary as last expression") do ->
      assert_run_exits("""
        def pick(x: Int): Int
          if x == 1 then 42 else 0 end
        end
        def main(): Int
          return pick(1)
        end
        """, 42)
    end

    it("inference through multiple struct fields") do ->
      assert_run_exits("""
        struct Pair
          a: Int
          b: Int
        end
        struct Triple
          x: Int
          y: Int
          z: Int
        end
        def main(): Int
          p = Pair { a: 10, b: 12 }
          t = Triple { x: p.a, y: p.b, z: 20 }
          return t.x + t.y + t.z
        end
        """, 42)
    end

    it("inference with while loop counter") do ->
      assert_run_exits("""
        def main(): Int
          var n = 0
          var i = 1
          while i <= 6
            n = n + i
            i += 1
          end
          return n + 21
        end
        """, 42)
    end

    it("inference through match with block arms") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          result = match x
            1 =>
              var a = 10
              a + 5
            2 =>
              var b = 20
              b + 22
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  return qspec_main()
end
