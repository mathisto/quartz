## Regression spec for the three-layer type-arg leak that surfaced as
## "match-arm payload struct identity erased" — closed `4c6ecb7c` 2026-05-05.
##
## Each shape below failed pre-fix because at least one of the three
## layers leaked the type-arg through:
##
##   1. Var-binding scope ann stamped raw `Box<I>` (with leaked tp-name)
##      instead of substituted `Box<X>` from the call's inferred type args.
##   2. User-enum ptype `Ev<S>` was built with arg1 = bare TYPE_STRUCT,
##      losing S's struct identity.
##   3. Match-arm pattern binding had no path to recover struct identity
##      from a bare TYPE_STRUCT resolved type — bound payload as
##      kind-only with no struct_name, breaking field access.
##
## The cards example dogfood (examples/tui/widgets/cards/main.qz) is the
## end-to-end smoke; this spec locks in each layer's fix in isolation.

import * from qspec

struct GP_Item
  name: String
  cost: Int
end

struct GP_Box<I>
  item: I
end

enum GP_Ev<T>
  GP_Idle
  GP_Sel(item: T)
end

def gp_box_new<I>(x: I): GP_Box<I> = GP_Box { item: x }

def gp_box_to_ev<I>(b: GP_Box<I>): GP_Ev<I>
  return GP_Ev::GP_Sel(b.item)
end

def gp_inferred_var_binding(): String
  # Layer 1 trigger: `var b = gp_box_new<GP_Item>(...)` — pre-fix, b's
  # scope annotation was `GP_Box<I>` (leaked), so the next call's
  # unifier bound `I_outer := "I"` literally and the chain collapsed.
  var b = gp_box_new<GP_Item>(GP_Item { name: "Strike", cost: 1 })
  var ev = gp_box_to_ev(b)
  match ev
    GP_Idle      => return "idle"
    GP_Sel(card) =>
      # Layers 2+3 trigger: card's binding type was bare TYPE_STRUCT
      # with no struct_name, so card.name returned TYPE_INT and the
      # field access mis-resolved.
      return card.name
  end
  return "fallthrough"
end

def gp_explicit_type_args(): String
  # Sanity check — explicit type args at the call site take a different
  # path that didn't leak pre-fix. Locking it in to catch any
  # over-eager generalization that breaks the explicit form.
  var ev = gp_box_to_ev<GP_Item>(gp_box_new<GP_Item>(GP_Item { name: "Bash", cost: 2 }))
  match ev
    GP_Idle      => return "idle"
    GP_Sel(card) => return card.name
  end
  return "fallthrough"
end

def gp_inferred_call_no_var(): String
  # Inline the call chain — no intermediate var. Goes through a
  # different sub-path of layer 1 (init expression directly in the
  # match scrutinee position).
  match gp_box_to_ev(gp_box_new<GP_Item>(GP_Item { name: "Cleave", cost: 1 }))
    GP_Idle      => return "idle"
    GP_Sel(card) => return card.name
  end
  return "fallthrough"
end

# 3-tuple return mirroring list_update<I, M>: this is the exact shape
# the cards example uses end-to-end. Two type params, generic enum at
# position [2] of a tuple, both bound via inferred wrapped-param args.
def gp_box_triple<I, M>(b: GP_Box<I>, mark: M): (GP_Box<I>, M, GP_Ev<I>)
  return (b, mark, GP_Ev::GP_Sel(b.item))
end

def gp_three_tuple_inferred(): String
  var b = gp_box_new<GP_Item>(GP_Item { name: "Defend", cost: 1 })
  var triple = gp_box_triple(b, 42)
  var ev = triple.2
  match ev
    GP_Idle      => return "idle"
    GP_Sel(card) => return card.name
  end
  return "fallthrough"
end

# Payload typed as String (primitive, not struct) — verifies layer 3's
# bare-kind recovery doesn't accidentally collapse non-struct primitives.
def gp_string_payload_inferred(): String
  var b = gp_box_new<String>("Inflame")
  var ev = gp_box_to_ev(b)
  match ev
    GP_Idle      => return "idle"
    GP_Sel(s)    => return s
  end
  return "fallthrough"
end

def main(): Int
  describe("generic call → payload field access (three-layer leak)") do ->

    it("inferred var binding preserves struct payload identity") do ->
      assert_eq_str(gp_inferred_var_binding(), "Strike")
    end

    it("explicit type args still work end-to-end") do ->
      assert_eq_str(gp_explicit_type_args(), "Bash")
    end

    it("inferred call inline (no var indirection)") do ->
      assert_eq_str(gp_inferred_call_no_var(), "Cleave")
    end

    it("3-tuple return with generic enum at position [2] (cards shape)") do ->
      assert_eq_str(gp_three_tuple_inferred(), "Defend")
    end

    it("primitive String payload via inferred wrapped-param call") do ->
      assert_eq_str(gp_string_payload_inferred(), "Inflame")
    end

  end
  return qspec_main()
end
