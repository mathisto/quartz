## Posix Intrinsics Tests
##
## Contract:
##   1. Getcwd.
##   2. Chdir.
##   3. Setenv.
##   4. Rename.
##   5. Mkdir / rmdir.
import * from qspec

def main(): Int
  describe("getcwd") do ->
    it("returns a non-empty path starting with /") do ->
      assert_eq(test_getcwd(), 1)
    end
  end

  describe("chdir") do ->
    it("changes to /tmp and back") do ->
      assert_eq(test_chdir(), 1)
    end

    it("returns non-zero for nonexistent directory") do ->
      assert_eq(test_chdir_fail(), 1)
    end
  end

  describe("setenv") do ->
    it("sets and reads an environment variable") do ->
      assert_eq(test_setenv(), 1)
    end

    it("overwrites existing value") do ->
      assert_eq(test_setenv_overwrite(), 1)
    end
  end

  describe("rename") do ->
    it("renames a file") do ->
      assert_eq(test_rename(), 1)
    end

    it("returns non-zero for nonexistent source") do ->
      assert_eq(test_rename_fail(), 1)
    end
  end

  describe("mkdir / rmdir") do ->
    it("creates and removes a directory") do ->
      assert_eq(test_mkdir_rmdir(), 1)
    end

    it("rmdir returns non-zero for nonexistent directory") do ->
      assert_eq(test_rmdir_fail(), 1)
    end
  end

  describe("file_mtime") do ->
    it("returns a positive epoch time for an existing file") do ->
      assert_eq(test_file_mtime(), 1)
    end

    it("returns -1 for a nonexistent file") do ->
      assert_eq(file_mtime("/tmp/qz_nonexistent_mtime_xyz.txt"), -1)
    end
  end

  return qspec_main()
end

def test_getcwd(): Int
  var cwd = getcwd()
  if cwd.size == 0
    return 0
  end
  # Path should start with '/'
  if str_byte_at(cwd, 0) != '/'
    return 0
  end
  return 1
end

def test_chdir(): Int
  var original = getcwd()
  var result = chdir("/tmp")
  if result != 0
    return 0
  end
  var new_cwd = getcwd()
  # Verify we moved (on macOS /tmp -> /private/tmp)
  if not str_contains(new_cwd, "tmp")
    chdir(original)
    return 0
  end
  # Change back
  chdir(original)
  return 1
end

def test_chdir_fail(): Int
  var result = chdir("/nonexistent_qz_test_dir_xyz")
  if result != 0
    return 1
  end
  return 0
end

def test_setenv(): Int
  var result = setenv("QZ_TEST_POSIX_INTRINSIC", "hello_quake")
  if result != 0
    return 0
  end
  var val = getenv("QZ_TEST_POSIX_INTRINSIC")
  if val == "hello_quake"
    return 1
  end
  return 0
end

def test_setenv_overwrite(): Int
  setenv("QZ_TEST_POSIX_OVERWRITE", "first")
  setenv("QZ_TEST_POSIX_OVERWRITE", "second")
  var val = getenv("QZ_TEST_POSIX_OVERWRITE")
  if val == "second"
    return 1
  end
  return 0
end

def test_rename(): Int
  write_file("/tmp/qz_rename_src.txt", "rename me")
  var result = rename("/tmp/qz_rename_src.txt", "/tmp/qz_rename_dst.txt")
  if result != 0
    return 0
  end
  # Source should not exist
  if file_exists("/tmp/qz_rename_src.txt") != 0
    file_delete("/tmp/qz_rename_dst.txt")
    return 0
  end
  # Destination should have the content
  var content = read_file("/tmp/qz_rename_dst.txt")
  file_delete("/tmp/qz_rename_dst.txt")
  if content == "rename me"
    return 1
  end
  return 0
end

def test_rename_fail(): Int
  var result = rename("/tmp/qz_nonexistent_xyz.txt", "/tmp/qz_dst.txt")
  if result != 0
    return 1
  end
  return 0
end

def test_mkdir_rmdir(): Int
  var path = "/tmp/qz_test_rmdir_xyz"
  mkdir(path)
  var result = rmdir(path)
  if result == 0
    return 1
  end
  return 0
end

def test_rmdir_fail(): Int
  var result = rmdir("/tmp/qz_nonexistent_dir_xyz")
  if result != 0
    return 1
  end
  return 0
end

def test_file_mtime(): Int
  write_file("/tmp/qz_mtime_test.txt", "watch me")
  var mt = file_mtime("/tmp/qz_mtime_test.txt")
  file_delete("/tmp/qz_mtime_test.txt")
  # A real file's mtime is a positive epoch second count (well past 2020).
  if mt > 1577836800
    return 1
  end
  return 0
end
