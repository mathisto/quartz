## Standalone Implicit It Tests
##
## Contract:
##   1. { it * 2 } creates a lambda with implicit `it` parameter.
##   2. Set literals {1, 2, 3} still work (not confused with implicit it).
##   3. Map literals {:a => 1} still work.
##   4. Explicit arrow { x -> expr } still works.
import * from qspec

def main(): Int
  describe("standalone implicit it") do ->
    it("creates a lambda with { it * 2 }") do ->
      var f = { it * 2 }
      assert_eq(f(21), 42)
    end

    it("creates a predicate with { it > 0 }") do ->
      var pred = { it > 0 }
      assert_eq(pred(5), 1)
      assert_eq(pred(-1), 0)
    end

    it("works as non-trailing argument") do ->
      assert_eq(apply_fn(21, { it * 2 }), 42)
    end

    it("works in array literal") do ->
      var fns = [{ it * 2 }, { it + 10 }]
      assert_eq(invoke_fn(fns[0], 5), 10)
      assert_eq(invoke_fn(fns[1], 5), 15)
    end

    it("set literal still works") do ->
      var s = {1, 2, 3}
      assert_eq(set_size(s), 3)
    end

    it("map literal still works") do ->
      var m = {:a => 1, :b => 2}
      assert_eq(m.size(), 2)
    end

    it("explicit arrow still works") do ->
      var f = { x -> x * 3 }
      assert_eq(f(7), 21)
    end

    it("nullary arrow still works") do ->
      var f = { -> 42 }
      assert_eq(f(), 42)
    end
  end

  return qspec_main()
end

def apply_fn(x: Int, f: Fn(Int): Int): Int = f(x)
def invoke_fn(f: Fn(Int): Int, x: Int): Int = f(x)
