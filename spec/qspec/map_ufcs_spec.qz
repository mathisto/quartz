## Map UFCS Tests
##
## Contract: Map supports dot-syntax for all operations.
## v5.27: m.get(k) returns Option<Int>

import * from qspec

def main(): Int
  describe("Map UFCS") do ->
    it("m.set and m.get") do ->
      var m = map_new<Int, Int>()
      m.set(10, 100)
      m.set(20, 200)
      assert_eq(m.get(10).unwrap(), 100)
      assert_eq(m.get(20).unwrap(), 200)
    end

    it("m.get returns None for missing keys") do ->
      var m = map_new<Int, Int>()
      m.set(1, 10)
      result = m.get(999)
      assert(result.none?)
    end

    it("m.has checks membership") do ->
      var m = map_new<Int, Int>()
      m.set(5, 50)
      assert_eq(m.has(5), true)
      assert_eq(m.has(99), false)
    end

    it("m.delete removes key") do ->
      var m = map_new<Int, Int>()
      m.set(7, 70)
      m.delete(7)
      assert_eq(m.has(7), false)
    end

    it("m.size tracks entries") do ->
      var m = map_new<Int, Int>()
      assert_eq(m.size(), 0)
      m.set(1, 10)
      m.set(2, 20)
      assert_eq(m.size(), 2)
    end

    it("m.keys and m.values") do ->
      var m = map_new<Int, Int>()
      m.set(100, 10)
      m.set(200, 20)
      m.set(300, 30)
      var ks = m.keys()
      var vs = m.values()
      assert_eq(ks.size, 3)
      assert_eq(vs.size, 3)
    end

    it("m.clear empties map") do ->
      var m = map_new<Int, Int>()
      m.set(1, 10)
      m.set(2, 20)
      m.clear()
      assert_eq(m.size(), 0)
    end

    it("m.free does not crash") do ->
      var m = map_new<Int, Int>()
      m.set(1, 10)
      m.free()
      assert_eq(0, 0)
    end
  end

  return qspec_main()
end
