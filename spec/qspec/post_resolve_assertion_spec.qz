## C4 guardrail regression / canary spec for POST-RESOLVE-IDENT-ASSERTION.
##
## The C4 guardrail in `self-hosted/backend/mir_lower.qz` upgrades
## unresolved PascalCase NODE_IDENT at MIR lowering entry to a hard
## `QZ9501: internal compiler error`. Previously such identifiers
## silently fell through to `mir_emit_load_var`, producing `%<name> undef`
## IR that llc rejected downstream. Root-caused as the mechanism behind
## OPTION-CTOR-IN-IMPL-BODY class bugs (resolver scope-push omissions
## leaking bare enum variants through to codegen).
##
## The narrowed check only fires on PascalCase names — lowercase names
## (match pattern bindings, closure captures, generator locals, etc.)
## have legitimate late-bound resolution paths at codegen and are
## deliberately NOT asserted.
##
## These tests are POSITIVE regressions for the common PascalCase
## patterns that MUST continue to compile cleanly. If any of them start
## firing QZ9501, the guardrail's resolution check needs broadening —
## do not suppress the assertion, investigate the missing resolution
## path instead.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("C4 guardrail (QZ9501 post-resolve ident assertion)") do ->

    it("qualified enum variant constructor compiles") do ->
      assert_run_exits("""
        def main(): Int
          var v = Option::Some(42)
          return 0 if v is Some
          return 1
        end
        """, 0)
    end

    it("unqualified variant in match arm compiles") do ->
      assert_run_exits("""
        def main(): Int
          var v = Option::Some(42)
          var result = match v
            Some(x) => x
            None => 0
          end
          return 0 if result == 42
          return 1
        end
        """, 0)
    end

    it("bare Some/None inside impl method compiles (OPTION-CTOR-IN-IMPL-BODY)") do ->
      assert_run_exits("""
        struct Box
          n: Int
        end
        extend Box
          def first(self): Option<Int>
            return Option::Some(@n)
          end
          def empty(self): Option<Int>
            return Option::None
          end
        end
        def main(): Int
          var b = Box { n: 7 }
          var f = b.first()
          var e = b.empty()
          if f is Some and e is None
            return 0
          end
          return 1
        end
        """, 0)
    end

    it("struct constructor with PascalCase type name compiles") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def make(): Point = Point { x: 3, y: 4 }
        def main(): Int
          var p = make()
          return 0 if p.x + p.y == 7
          return 1
        end
        """, 0)
    end

    it("user enum variant used in expression compiles") do ->
      assert_run_exits("""
        enum Color
          Red
          Green
          Blue
        end
        def main(): Int
          var c = Color::Green
          var result = match c
            Red => 1
            Green => 2
            Blue => 3
          end
          return 0 if result == 2
          return 1
        end
        """, 0)
    end

  end
  return qspec_main()
end
