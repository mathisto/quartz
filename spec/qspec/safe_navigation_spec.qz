## Safe Navigation Operator Tests (TEST.2 Phase 1)

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("safe navigation happy path") do ->
    it("?. on Some returns wrapped field value") do ->
      assert_run_exits("""
        struct User
          age: Int
        end
        def main(): Int
          var u = option_some(User { age: 42 })
          return u?.age ?? 0
        end
        """, 42)
    end

    it("?. on None returns None") do ->
      assert_run_exits("""
        struct User
          age: Int
        end
        def main(): Int
          var u = option_none()
          return u?.age ?? 99
        end
        """, 99)
    end

    it("?. result is Option — can use ?? to unwrap") do ->
      assert_run_exits("""
        struct Pt
          x: Int
        end
        def main(): Int
          var p = option_some(Pt { x: 7 })
          result = p?.x ?? 0
          return result
        end
        """, 7)
    end
  end

  describe("safe navigation edge cases") do ->
    it("unwrap with ?? then access nested field") do ->
      assert_run_exits("""
        struct Inner
          val: Int
        end
        struct Outer
          inner: Inner
        end
        def get_inner_val(o: Outer): Int = o.inner.val
        def main(): Int
          var o = option_some(Outer { inner: Inner { val: 55 } })
          return get_inner_val(o ?? Outer { inner: Inner { val: 0 } })
        end
        """, 55)
    end

    it("?. with ?? on Some returns field value") do ->
      assert_run_exits("""
        struct Cfg
          port: Int
        end
        def main(): Int
          var c = option_some(Cfg { port: 88 })
          return c?.port ?? 0
        end
        """, 88)
    end

    it("?. on first field of multi-field struct") do ->
      assert_run_exits("""
        struct Pair
          a: Int
          b: Int
        end
        def main(): Int
          var p = option_some(Pair { a: 10, b: 20 })
          return p?.a ?? 0
        end
        """, 10)
    end

    it("?. on second field of multi-field struct") do ->
      assert_run_exits("""
        struct Pair
          a: Int
          b: Int
        end
        def main(): Int
          var p = option_some(Pair { a: 10, b: 20 })
          return p?.b ?? 0
        end
        """, 20)
    end

    it("?. preserves None through the chain") do ->
      assert_run_exits("""
        struct A
          x: Int
        end
        def main(): Int
          var a = option_none()
          r = a?.x ?? 77
          return r
        end
        """, 77)
    end
  end

  describe("safe navigation adversarial") do ->
    it("?. with deeply nested Some value") do ->
      assert_run_exits("""
        struct D
          val: Int
        end
        def main(): Int
          var d = option_some(D { val: 42 })
          return d?.val ?? 0
        end
        """, 42)
    end

    it("?. on None with side-effect-free default") do ->
      assert_run_exits("""
        struct S
          x: Int
        end
        def main(): Int
          var s = option_none()
          return s?.x ?? 0
        end
        """, 0)
    end
  end

  describe("safe navigation cross-feature") do ->
    it("?. result used in arithmetic") do ->
      assert_run_exits("""
        struct Val
          n: Int
        end
        def main(): Int
          var v = option_some(Val { n: 20 })
          return (v?.n ?? 0) + 1
        end
        """, 21)
    end

    it("?. on result of option_some constructed inline") do ->
      assert_run_exits("""
        struct Item
          id: Int
        end
        def main(): Int
          var x = option_some(Item { id: 42 })
          return x?.id ?? 0
        end
        """, 42)
    end

    it("?. combined with ?? in variable binding") do ->
      assert_run_exits("""
        struct Cfg
          val: Int
        end
        def main(): Int
          var c = option_some(Cfg { val: 33 })
          result = c?.val ?? 99
          return result
        end
        """, 33)
    end
  end

  describe("safe navigation errors") do ->
    it("?. on non-Option type produces error") do ->
      assert_compile_error("""
        struct Pt
          x: Int
        end
        def main(): Int
          p = Pt { x: 1 }
          return p?.x ?? 0
        end
        """, "Option")
    end

    it("?. with nonexistent field errors") do ->
      assert_compile_error("""
        struct Pt
          x: Int
        end
        def maybe_pt(): Option<Pt>
          return Option::Some(Pt { x: 1 })
        end
        def main(): Int
          return maybe_pt()?.nonexistent ?? 0
        end
        """, "Unknown field")
    end
  end

  return qspec_main()
end
