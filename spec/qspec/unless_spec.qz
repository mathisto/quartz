## Unless Statement Tests
##
## Contract:
##   1. Basic unless.
##   2. Unless-else.
##   3. Nested unless.
##   4. Unless with complex conditions.
import * from qspec

def main(): Int
  describe("basic unless") do ->
    it("executes body when condition is false") do ->
      assert_eq(unless_false_cond(), 1)
    end

    it("skips body when condition is true") do ->
      assert_eq(unless_true_cond(), 2)
    end

    it("works with expressions") do ->
      assert_eq(unless_expr_cond(), 1)
    end
  end

  describe("unless-else") do ->
    it("executes else when condition is true") do ->
      assert_eq(unless_else_true(), 2)
    end

    it("executes body when condition is false") do ->
      assert_eq(unless_else_false(), 1)
    end
  end

  describe("nested unless") do ->
    it("works with nested unless statements") do ->
      assert_eq(unless_nested(), 1)
    end

    it("works with unless inside if") do ->
      assert_eq(unless_in_if(), 1)
    end
  end

  describe("unless with complex conditions") do ->
    it("works with and operator") do ->
      assert_eq(unless_and(), 1)
    end

    it("works with or operator") do ->
      assert_eq(unless_or(), 1)
    end

    it("works with not operator") do ->
      assert_eq(unless_not(), 1)
    end
  end

  return qspec_main()
end

def unless_false_cond(): Int
  var x = false
  unless x
    return 1
  end
  return 0
end

def unless_true_cond(): Int
  var x = true
  unless x
    return 1
  end
  return 2
end

def unless_expr_cond(): Int
  var x = 5
  unless x > 10
    return 1
  end
  return 0
end

def unless_else_true(): Int
  var x = true
  unless x
    return 1
  else
    return 2
  end
end

def unless_else_false(): Int
  var x = false
  unless x
    return 1
  else
    return 2
  end
end

def unless_nested(): Int
  var a = false
  var b = false
  unless a
    unless b
      return 1
    end
  end
  return 0
end

def unless_in_if(): Int
  var a = true
  var b = false
  if a
    unless b
      return 1
    end
  end
  return 0
end

def unless_and(): Int
  var a = false
  var b = true
  unless a and b
    return 1
  end
  return 0
end

def unless_or(): Int
  var a = false
  var b = false
  unless a or b
    return 1
  end
  return 0
end

def unless_not(): Int
  var a = true
  unless not a
    return 1
  end
  return 0
end
