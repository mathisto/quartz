## SURF.FLOW A4 — refutable-bind SUBJECT narrowing for Result and user-enums.
##
## `if Var(v) = x` binds the payload `v` (already worked for Option/Result/enum via
## is_binding_spec) AND narrows the SUBJECT `x` to the proven variant so a *bare read
## of x itself* in the then-branch reads as the variant's inner payload. Before A4
## this subject-narrow fired for Option `Some` only; A4 generalizes it to Result
## `Ok`/`Err` and single-payload user-enum variants via tc_try_narrow_variant.
##
## Behavioral signal (same technique as flow_narrow_p2_spec.qz:120): a NARROWED read
## of the subject extracts the real inner payload; an UN-narrowed read passes the raw
## boxed word (a large garbage-ish integer, NOT the payload). We observe the SUBJECT
## narrow specifically by reading the *subject* `r`/`e`/`o` (not the bound `v`) where
## the inner payload type is required, and asserting the determinate inner value plus
## the bound `v` — so the test fails on the golden (subject un-narrowed) and passes on
## the A4 binary.
##
## A/B repro (one-liner): `r: Result<Int,Int> = Result::Ok(42); if Ok(v) = r; use r as
## Int + v; end` — golden does NOT narrow the subject `r` (garbage word), A4 does (42).
import * from qspec

# Read a value that the narrowed subject must present as its inner Int payload.
def use_int_raw(x: Int): Int = x

enum Box
  Full(n: Int)
end

# --- Result: `if Ok(v) = r` narrows the SUBJECT r to Ok (inner Int) ---
def refut_ok_subject(): Int
  r: Result<Int, Int> = Result::Ok(42)
  var out = 0
  if Ok(v) = r
    # both the bound v AND a bare read of the SUBJECT r read as inner Int
    out = use_int_raw(r) + v
  end
  return out
end

# --- Result: `if Err(e) = r` narrows the SUBJECT r to Err (inner Int) ---
def refut_err_subject(): Int
  r: Result<Int, Int> = Result::Err(7)
  var out = 0
  if Err(e) = r
    # bound e AND bare subject r both read as the Err inner Int
    out = use_int_raw(r) + e
  end
  return out
end

# --- single-payload user enum: `if Full(x) = b` narrows the SUBJECT b to Full ---
def refut_enum_subject(): Int
  b: Box = Box::Full(30)
  var out = 0
  if Full(x) = b
    # bound x AND bare subject b both read as the Full inner Int
    out = use_int_raw(b) + x
  end
  return out
end

# --- CONTROL (regression): Option `if Some(v) = o` subject-narrow still fires ---
def refut_some_subject(): Int
  o: Option<Int> = option_some(21)
  var out = 0
  if Some(v) = o
    out = use_int_raw(o) + v
  end
  return out
end

def main(): Int
  describe("SURF.FLOW A4 — refutable-bind subject narrow (Result / user-enum)") do ->
    it("narrows the SUBJECT r in `if Ok(v) = r` to Ok inner Int") do ->
      # subject r narrowed to 42 + bound v 42 = 84
      assert_eq(refut_ok_subject(), 84)
    end

    it("narrows the SUBJECT r in `if Err(e) = r` to Err inner Int") do ->
      # subject r narrowed to 7 + bound e 7 = 14
      assert_eq(refut_err_subject(), 14)
    end

    it("narrows the SUBJECT b in `if Full(x) = b` (single-payload user enum)") do ->
      # subject b narrowed to 30 + bound x 30 = 60
      assert_eq(refut_enum_subject(), 60)
    end

    it("CONTROL: Option `if Some(v) = o` subject-narrow still fires (regression)") do ->
      # subject o narrowed to 21 + bound v 21 = 42
      assert_eq(refut_some_subject(), 42)
    end
  end

  return qspec_main()
end
