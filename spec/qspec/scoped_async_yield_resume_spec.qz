## Phase 2d Bug 4 regression spec — `with Scoped do v -> body` inside
## an `async fn` body whose body contains a yield point.
##
## The bug:
##   `__Future_X$poll` state-machine emits multiple re-entry blocks
##   (poll_start / yield_resume* / k3_perform_resume*) that branch
##   INTO the middle of the function. The Scoped wrapper's handler
##   value, defined only on the initial entry path, doesn't dominate
##   release sites reached via yield-resume. LLVM verifier rejects
##   with "Instruction does not dominate all uses!" — the broken IR
##   never reaches a runnable binary.
##
## The fix: spill the handler value to a stack slot at the with-block
## prelude, load at every release/drain site. Mirrors the existing
## scoped_v_slot_names mechanism that already protects the acquire-
## return value from the same shape.
##
## This spec is the structural regression check: if mir_lower_with_scoped
## ever reverts to storing the handler as an SSA register, the spec's
## compile step fails llc verification.
##
## The shape is intentionally minimal: one `with`, one yield in the body,
## verify that release fires exactly once on natural exit.

import * from qspec
import * from std/scoped

var g_released = 0
var g_acquired = 0

struct YieldGuard
  tag: Int
end

extend YieldGuard with Scoped
  def acquire(self): Int
    g_acquired = g_acquired + 1
    return @tag
  end
  def release(self, value: Int): Void
    g_released = g_released + 1
  end
  def release_on_throw(self, value: Int, exc_msg: String): Void
    g_released = g_released + 1
  end
end

def yield_guard(tag: Int): YieldGuard
  return YieldGuard { tag: tag }
end

## The shape that used to break before the handler-spill fix:
## function called via `async f()` so the compiler synthesizes
## `__Future_f$poll` around it. The body has a `with Scoped` block
## whose body suspends via sched_yield. The future wrapper emits
## yield_resume re-entry blocks; without the spill, the handler-expr
## SSA reg doesn't dominate the release site that's reached after
## yield-resume.
def with_scoped_yielding(): Int
  with yield_guard(42) do tag ->
    var i = 0
    while i < 3
      sched_yield()
      i = i + 1
    end
  end
  return 7
end

def drive_with_scoped(): Int
  sched_init(0)
  var t = async with_scoped_yielding()
  sched_spawn(t)
  sched_shutdown()
  return 0
end

def main(): Int
  describe("Phase 2d Bug 4 — Scoped handle survives async yield/resume") do ->
    it("acquire fires before body, release fires after natural exit") do ->
      g_acquired = 0
      g_released = 0
      var rc = drive_with_scoped()
      assert_eq(rc, 0)
      assert_eq(g_acquired, 1)
      assert_eq(g_released, 1)
    end
  end
  return qspec_main()
end
