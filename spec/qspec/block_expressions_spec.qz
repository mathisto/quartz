## Block Expressions Tests
##
## Contract:
##   1. do...end block: returns value of last expression.
##   2. Side effects: mutations visible, last expression is value.
##   3. Local bindings: variables inside block scoped to block.
##   4. Nesting: blocks inside blocks.
##   5. Curly brace: `{ ... }` as block expression equivalent.
##   6. Curly + control flow: if/for inside curly block.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("do...end block expression") do ->
    it("returns the value of the last expression") do ->
      assert_run_exits(be_last_expr_src(), 42)
    end

    it("evaluates side effects and returns last expression") do ->
      assert_run_exits(be_side_effect_src(), 30)
    end

    it("supports local bindings inside the block") do ->
      assert_run_exits(be_local_binding_src(), 25)
    end

    it("supports nested block expressions") do ->
      assert_run_exits(be_nested_src(), 4)
    end
  end

  describe("curly brace block expression") do ->
    it("parses { var ... } as a block expression") do ->
      assert_run_exits(be_curly_var_src(), 15)
    end

    it("returns value of last expression (curly with if keyword)") do ->
      assert_run_exits(be_curly_if_src(), 42)
    end

    it("evaluates side effects via for loop in curly block") do ->
      assert_run_exits(be_curly_for_src(), 10)
    end

    it("supports const bindings inside curly block") do ->
      assert_run_exits(be_curly_binding_src(), 25)
    end

    it("supports nested curly block expressions") do ->
      assert_run_exits(be_curly_nested_src(), 4)
    end
  end

  describe("inline if-expression without `then` (HB-DOG.4)") do ->
    it("parses a no-`then` inline if as an assignment RHS") do ->
      assert_run_exits(be_inline_if_rhs_src(), 7)
    end

    it("parses a no-`then` inline if when parenthesized") do ->
      assert_run_exits(be_inline_if_paren_src(), 9)
    end

    it("parses a no-`then` inline if with an inline elsif arm") do ->
      assert_run_exits(be_inline_if_elsif_src(), 5)
    end
  end

  return qspec_main()
end

def be_inline_if_rhs_src(): String = """
  def main(): Int
    b = true
    x = if b 7 else 0 end
    return x
  end
  """

def be_inline_if_paren_src(): String = """
  def main(): Int
    b = false
    return (if b 0 else 9 end)
  end
  """

def be_inline_if_elsif_src(): String = """
  def main(): Int
    n = 2
    x = if n == 1 1 elsif n == 2 5 else 0 end
    return x
  end
  """

def be_last_expr_src(): String = """
  def main(): Int
    x = do
      42
    end
    return x
  end
  """

def be_side_effect_src(): String = """
  def main(): Int
    x = do
      10 + 20
    end
    return x
  end
  """

def be_local_binding_src(): String = """
  def main(): Int
    x = do
      tmp = 5
      tmp * tmp
    end
    return x
  end
  """

def be_nested_src(): String = """
  def main(): Int
    x = do
      y = do
        3
      end
      y + 1
    end
    return x
  end
  """

def be_curly_var_src(): String = """
  def main(): Int
    x = {
      var tmp = 10
      tmp += 5
      tmp
    }
    return x
  end
  """

def be_curly_if_src(): String = """
  def main(): Int
    x = {
      if 1 == 1
        42
      else
        0
      end
    }
    return x
  end
  """

def be_curly_for_src(): String = """
  def main(): Int
    x = {
      var sum = 0
      for i in 0..5
        sum += 2
      end
      sum
    }
    return x
  end
  """

def be_curly_binding_src(): String = """
  def main(): Int
    x = {
      tmp = 5
      tmp * tmp
    }
    return x
  end
  """

def be_curly_nested_src(): String = """
  def main(): Int
    x = {
      y = {
        var a = 3
        a
      }
      y + 1
    }
    return x
  end
  """
