## Fn-typed struct field call tests
## Tests calling function-typed fields via dot syntax: obj.f(args)
##
## Contract:
##   1. Fn(Int):Int field: `obj.f(arg)` dispatches to stored function.
##   2. Fn():Int field: zero-arg function field callable via dot.
##   3. Fn(Int,Int):Int field: multi-arg function field callable.
##   4. Lambda assignment: lambda stored in Fn field callable.
##   5. Two-step workaround: extract field then call still works.

import * from qspec

def main(): Int
  describe("Fn field call via dot syntax") do ->
    it("calls Fn(Int): Int field") do ->
      cb = FnFieldCb { f: fnf_double }
      assert_eq(cb.f(21), 42)
    end

    it("calls Fn(): Int field with no args") do ->
      g = FnFieldGetter { get: fnf_forty_two }
      assert_eq(g.get(), 42)
    end

    it("calls Fn(Int, Int): Int field with two args") do ->
      op = FnFieldBinOp { apply: fnf_add }
      assert_eq(op.apply(20, 22), 42)
    end

    it("calls Fn field assigned from lambda") do ->
      cb = FnFieldCb { f: x -> x * 3 }
      assert_eq(cb.f(14), 42)
    end

    it("two-step workaround still works") do ->
      cb = FnFieldCb { f: fnf_double }
      func = cb.f
      assert_eq(func(21), 42)
    end

    it("fn field can be reassigned to different function") do ->
      var cb = FnFieldCb { f: fnf_double }
      assert_eq(cb.f(10), 20)
      cb.f = fnf_triple
      assert_eq(cb.f(10), 30)
    end

    it("fn field result used in arithmetic") do ->
      op = FnFieldBinOp { apply: fnf_add }
      result = op.apply(10, 11) + op.apply(10, 11)
      assert_eq(result, 42)
    end
  end

  return qspec_main()
end

def fnf_double(x: Int): Int = x * 2
def fnf_triple(x: Int): Int = x * 3
def fnf_forty_two(): Int = 42
def fnf_add(a: Int, b: Int): Int = a + b

struct FnFieldCb
  f: Fn(Int): Int
end

struct FnFieldGetter
  get: Fn(): Int
end

struct FnFieldBinOp
  apply: Fn(Int, Int): Int
end
