import * from qspec
import * from style

# Cache-ro regression: UFCS method chain with type-name receiver at chain root.
#
# Style.new() — receiver is the type name `Style` (NODE_IDENT for struct
# type, not a variable). Subsequent calls in the chain have call-result
# receivers (each `.X()` returns Style, fed to the next `.Y()`).
#
# Under `--cache-ro`, std/style.qz is cached; body-TC is skipped for it.
# But mir_lower for THIS spec module still needs to resolve all four call
# sites correctly: `new`, `bold`, `fg`, `render_at` must each mangle to
# `Style$new`, `Style$bold`, etc. The mangling depends on knowing the
# receiver type:
#
# - `Style.new()`: receiver IDENT `Style` → need to recognize type name.
# - `.bold()`: receiver is the result of `Style.new()` → need to know
#   `Style$new` returns `Style`.
# - `.fg(...)`: receiver is the result of `.bold()` → need to know
#   `Style$bold` returns `Style`.
# - `.render_at(...)`: similar.
#
# Pre-fix (Phase 1+2): `mir_infer_expr_type(NODE_IDENT for type name)`
# returns "" (no var binding); Path A's UFCS fallback bails. The chain
# leaf isn't resolved, so neither are the outer calls. Output: bare names
# in IR, llc rejects.
#
# Post-fix: mir_infer_expr_type recognizes struct/enum/alias type-name
# IDENT receivers, returns the type name as a string. Path A then resolves
# `Style.new()` to `Style$new`, mutates AST str1. Outer call's
# `mir_infer_expr_type(arg_nodes[0])` sees the resolved `Style$new` call,
# looks up its return type via registry, returns "Style". Chain cascades.

def main(): Int
  describe("cache-ro UFCS method chain") do ->
    it("Style.new().bold().fg(Cyan()).render_at(...) produces non-empty styled string") do ->
      var out = Style.new().bold().fg(Cyan()).render_at("hello", 256)
      assert_eq(str_byte_len(out) > 0, true)
    end

    it("chain with 3 fluent calls works") do ->
      var out = Style.new().bold().render_at("x", 256)
      assert_eq(str_byte_len(out) > 0, true)
    end

    it("chain through Style.error preset") do ->
      var out = Style.error().render_at("err", 256)
      assert_eq(str_byte_len(out) > 0, true)
    end

    it("depth=0 chain returns input unchanged") do ->
      var out = Style.new().bold().fg(Red()).render_at("plain", 0)
      assert_eq_str(out, "plain")
    end
  end
  return qspec_main()
end
