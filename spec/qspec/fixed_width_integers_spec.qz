## Fixed Width Integers Tests
##
## Contract:
##   1. 0b1010 binary literal.
##   2. 0b101010 binary literal.
##   3. 0x2a hex literal.
##   4. 0xff hex literal.
##   5. 100_i16 literal suffix.
##   6. 42_u8 literal suffix.
import * from qspec
import * from qspec/subprocess

struct Packet
  tag: U8
  len: U16
  value: I32
end

def main(): Int
  describe("fixed-width integers") do ->
    it("I8 as return type") do ->
      assert_eq(fw_i8_ret(), 42)
    end
    it("I16 as return type") do ->
      assert_eq(fw_i16_ret(), 100)
    end
    it("I32 as return type") do ->
      assert_eq(fw_i32_ret(), 77)
    end
    it("U8 as return type") do ->
      assert_eq(fw_u8_ret(), 200)
    end
    it("U16 as return type") do ->
      assert_eq(fw_u16_ret(), 50)
    end
    it("U32 as return type") do ->
      assert_eq(fw_u32_ret(), 99)
    end
    it("U64 as return type") do ->
      assert_eq(fw_u64_ret(), 42)
    end
    it("I64 as return type") do ->
      assert_eq(fw_i64_ret(), 99)
    end
    it("I8 parameter") do ->
      assert_eq(fw_i8_identity(42), 42)
    end
    it("U16 parameter") do ->
      assert_eq(fw_u16_identity(99), 99)
    end
    it("I32 parameter") do ->
      assert_eq(fw_i32_identity(77), 77)
    end
    it("I8 local variable") do ->
      assert_eq(fw_i8_local(), 42)
    end
    it("U32 local variable") do ->
      assert_eq(fw_u32_local(), 88)
    end
    it("struct with fixed-width fields") do ->
      p = Packet { tag: 1, len: 256, value: 42 }
      assert_eq(p.value, 42)
    end
    it("42_u8 literal suffix") do ->
      assert_run_exits("""
        def main(): Int
          x = 42_u8
          return x
        end
        """, 42)
    end
    it("100_i16 literal suffix") do ->
      assert_run_exits("""
        def main(): Int
          x = 100_i16
          return x
        end
        """, 100)
    end
    it("77_i32 literal suffix") do ->
      assert_run_exits("""
        def main(): Int
          x = 77_i32
          return x
        end
        """, 77)
    end
    it("55_u64 literal suffix") do ->
      assert_run_exits("""
        def main(): Int
          x = 55_u64
          return x
        end
        """, 55)
    end
    it("0xFF hex literal") do ->
      assert_eq(fw_hex_ff(), 255)
    end
    it("0x2A hex literal") do ->
      assert_eq(fw_hex_2a(), 42)
    end
    it("0b1010 binary literal") do ->
      assert_eq(fw_bin_1010(), 10)
    end
    it("0b101010 binary literal") do ->
      assert_eq(fw_bin_101010(), 42)
    end
    it("U8 addition wraps at 256") do ->
      assert_eq(fw_u8_add(200, 100), 44)
    end
    it("U8 subtraction wraps below 0") do ->
      assert_eq(fw_u8_sub(10, 20), 246)
    end
    it("U8 multiplication wraps") do ->
      assert_eq(fw_u8_mul(20, 20), 144)
    end
    it("wrapped U8 add then divide") do ->
      ## (200 + 100) wraps to 44 in U8, then 44 / 3 = 14
      assert_eq(fw_u8_chain_add_div(200, 100, 3), 14)
    end
    it("wrapped U8 mul then divide") do ->
      ## (20 * 20) wraps to 144 in U8, then 144 / 3 = 48
      assert_eq(fw_u8_chain_mul_div(20, 20, 3), 48)
    end
    it("U8 division uses unsigned semantics") do ->
      assert_eq(fw_u8_div(200, 2), 100)
    end
    it("U8 modulo uses unsigned semantics") do ->
      assert_eq(fw_u8_mod(200, 3), 2)
    end
    it("U8 greater-than uses unsigned semantics") do ->
      assert_eq(fw_u8_gt(200, 100), 1)
    end
    it("U8 less-than uses unsigned semantics") do ->
      assert_eq(fw_u8_lt(50, 200), 1)
    end
    it("U8 add within range") do ->
      assert_eq(fw_u8_add(100, 50), 150)
    end
    it("U16 add within range") do ->
      assert_eq(fw_u16_add(100, 50), 150)
    end
    it("I32 add within range") do ->
      assert_eq(fw_i32_add(30, 12), 42)
    end
    it("to_u8 truncates to 8 bits") do ->
      assert_eq(to_u8(300), 44)
    end
    it("to_u8 in-range is identity") do ->
      assert_eq(to_u8(200), 200)
    end
    it("to_i32 in-range preserves value") do ->
      assert_eq(to_i32(42), 42)
    end
    it("to_u8 reinterprets negative as unsigned") do ->
      assert_eq(to_u8(-1), 255)
    end
    it("to_u8 result participates in U8 arithmetic") do ->
      assert_eq(fw_u8_arith_conv(), 44)
    end
    it("to_i8 prints") do ->
      assert_output("-56\n", fw_to_i8_print)
    end
    it("to_u16 prints") do ->
      assert_output("4464\n", fw_to_u16_print)
    end
    it("to_i16 prints") do ->
      assert_output("-25536\n", fw_to_i16_print)
    end
    it("to_u32 prints") do ->
      assert_output("705032704\n", fw_to_u32_print)
    end
    it("to_i32 truncates prints") do ->
      assert_output("-1294967296\n", fw_to_i32_print)
    end
    it("to_u64 is identity for positive") do ->
      assert_output("42\n", fw_to_u64_print)
    end
    it("to_i8 255 as signed") do ->
      assert_output("-1\n", fw_to_i8_255_print)
    end
    it("to_u16 reinterprets negative") do ->
      assert_output("65535\n", fw_to_u16_neg_print)
    end
    it("underscores in decimal (1_000)") do ->
      assert_eq(fw_underscore_dec(), 1000)
    end
    it("underscores in hex (0xDE_AD)") do ->
      assert_eq(fw_underscore_hex(), 57005)
    end
    it("underscores in binary (0b1111_0000)") do ->
      assert_eq(fw_underscore_bin(), 240)
    end

    it("I8 return emits i8 LLVM type") do ->
      assert_ir_contains("""
def get_byte(): I8 = 42
def main(): Int
  x = get_byte()
  return x
end
""", "define i8")
    end

    it("I32 return emits i32 LLVM type") do ->
      assert_ir_contains("""
def get_int32(): I32 = 42
def main(): Int
  x = get_int32()
  return x
end
""", "define i32")
    end

    it("U16 return emits i16 LLVM type") do ->
      assert_ir_contains("""
def get_u16(): U16 = 42
def main(): Int
  x = get_u16()
  return x
end
""", "i16")
    end

    it("@repr(C) struct emits LLVM struct type") do ->
      assert_ir_contains("""
@repr(C)
struct Point
  x: CInt
  y: CInt
end
def main(): Int
  return 0
end
""", "%struct.Point = type")
    end

    it("@repr(C) struct with mixed CInt fields (IR test)") do ->
      assert_ir_contains("""
@repr(C)
struct Packet
  tag: U8
  len: U16
  value: I32
end
def main(): Int
  return 0
end
""", "%struct.Packet = type")
    end
    it("field_offset returns correct offsets (repr(C) + generic intrinsic)") do ->
      assert_run_exits("""
        @repr(C)
        struct Pair
          x: I32
          y: I32
        end
        def main(): Int
          var off0 = field_offset<Pair>(0)
          var off1 = field_offset<Pair>(1)
          if off0 == 0
            if off1 == 4
              return 42
            end
          end
          return 1
        end
        """, 42)
    end
    it("@repr(C) struct stores/loads values (repr(C) QSpec)") do ->
      assert_run_exits("""
        @repr(C)
        struct Point
          x: I32
          y: I32
        end
        def main(): Int
          var p = Point { x: 10, y: 32 }
          return p.x + p.y
        end
        """, 42)
    end
    ## Permanent pending: htons() is a macro/inline function on most platforms.
    ## lli cannot resolve it at runtime. Resolution requires native binary QSpec runner.
    it("htons byte-swaps port number") do ->
      assert_run_exits("""
        def htons(port: Int): Int = bor(shl(band(port, 255), 8), band(shr(port, 8), 255))
        def main(): Int
          var port = 8080
          var net = htons(port)
          var back = htons(net)
          if back == port
            return 0
          end
          return 1
        end
        """, 0)
    end
  end
  return qspec_main()
end

def fw_u64_ret(): U64 = 42
def fw_i64_ret(): I64 = 99
def fw_i8_ret(): I8 = 42
def fw_i16_ret(): I16 = 100
def fw_i32_ret(): I32 = 77
def fw_u8_ret(): U8 = 200
def fw_u16_ret(): U16 = 50
def fw_u32_ret(): U32 = 99
def fw_i8_identity(x: I8): I8 = x
def fw_u16_identity(x: U16): U16 = x
def fw_i32_identity(x: I32): I32 = x
def fw_i8_local(): Int
  x: I8 = 42
  return x
end
def fw_u32_local(): Int
  x: U32 = 88
  return x
end
def fw_hex_ff(): Int = 0xFF
def fw_hex_2a(): Int = 0x2A
def fw_u8_add(a: U8, b: U8): U8 = a + b
def fw_u8_sub(a: U8, b: U8): U8 = a - b
def fw_u8_mul(a: U8, b: U8): U8 = a * b
def fw_u8_chain_add_div(a: U8, b: U8, c: U8): U8 = (a + b) / c
def fw_u8_chain_mul_div(a: U8, b: U8, c: U8): U8 = (a * b) / c
def fw_u8_div(a: U8, b: U8): U8 = a / b
def fw_u8_mod(a: U8, b: U8): U8 = a % b
def fw_u8_gt(a: U8, b: U8): Int
  if a > b
    return 1
  end
  return 0
end
def fw_u8_lt(a: U8, b: U8): Int
  if a < b
    return 1
  end
  return 0
end
def fw_u16_add(a: U16, b: U16): U16 = a + b
def fw_i32_add(a: I32, b: I32): I32 = a + b
def fw_to_i8_print(): Void = print_int(to_i8(200))
def fw_to_u16_print(): Void = print_int(to_u16(70000))
def fw_to_i16_print(): Void = print_int(to_i16(40000))
def fw_to_u32_print(): Void = print_int(to_u32(5000000000))
def fw_to_i32_print(): Void = print_int(to_i32(3000000000))
def fw_to_u64_print(): Void = print_int(to_u64(42))
def fw_to_i8_255_print(): Void = print_int(to_i8(255))
def fw_to_u16_neg_print(): Void = print_int(to_u16(-1))
def fw_u8_arith_conv(): Int = fw_u8_add(to_u8(200), to_u8(100))
def fw_bin_1010(): Int = 0b1010
def fw_bin_101010(): Int = 0b101010
def fw_underscore_dec(): Int = 1_000
def fw_underscore_hex(): Int = 0xDE_AD
def fw_underscore_bin(): Int = 0b1111_0000

