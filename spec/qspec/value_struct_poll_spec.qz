## @value struct pointer safety across $poll suspension

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("@value struct in $poll") do ->
    it("struct fields survive channel send suspension") do ->
      assert_run_exits(struct_survives_send_src(), 0)
    end
    it("multiple structs survive suspension") do ->
      assert_run_exits(multi_struct_survives_src(), 0)
    end
    it("struct created before suspension, accessed after") do ->
      assert_run_exits(struct_before_suspend_src(), 0)
    end
  end
  return qspec_main()
end

def struct_survives_send_src(): String = """
  @value
  struct Pair
    x: Int
    y: Int
  end
  def make_pair(a: Int, b: Int): Pair
    return Pair { x: a, y: b }
  end
  def handler(ch: Int): Int
    var p = make_pair(42, 99)
    send(ch, p.x)
    if p.x != 42
      return 1
    end
    if p.y != 99
      return 2
    end
    return 0
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    var f = go handler(ch)
    recv(ch)
    sched_shutdown()
    return load(f, 1)
  end
  """

def multi_struct_survives_src(): String = """
  @value
  struct Vec2
    x: Int
    y: Int
  end
  def make_v2(a: Int, b: Int): Vec2
    return Vec2 { x: a, y: b }
  end
  def handler(ch: Int): Int
    var a = make_v2(10, 20)
    var b = make_v2(30, 40)
    send(ch, 1)
    if a.x != 10 or a.y != 20
      return 1
    end
    if b.x != 30 or b.y != 40
      return 2
    end
    return 0
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    var f = go handler(ch)
    recv(ch)
    sched_shutdown()
    return load(f, 1)
  end
  """

def struct_before_suspend_src(): String = """
  @value
  struct Triple
    a: Int
    b: Int
    c: Int
  end
  def make_triple(x: Int, y: Int, z: Int): Triple
    return Triple { a: x, b: y, c: z }
  end
  def handler(ch: Int): Int
    var t = make_triple(11, 22, 33)
    var before = t.a + t.b + t.c
    send(ch, before)
    var after = t.a + t.b + t.c
    if after != 66
      return 1
    end
    return 0
  end
  def main(): Int
    sched_init(2)
    var ch = channel_new(4)
    var f = go handler(ch)
    var v = recv(ch)
    sched_shutdown()
    if v != 66
      return 2
    end
    return load(f, 1)
  end
  """
