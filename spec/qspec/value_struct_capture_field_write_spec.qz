import * from qspec

# WS2 — field/index-write persistence through a captured value-layout struct.
#
# WS1b made a WHOLE-VAR reassignment (`a = Struct{…}`) of a captured value-layout
# struct persist by taking the capture by-reference. WS2 extends by-ref to
# FIELD/INDEX writes (`p.x = …`, `p[i] = …`) on a captured VALUE-LAYOUT base.
#
# Mechanism (no new lowering): the capture is now taken by-reference (mode 2 in
# mir_classify_capture_modes, gated on a value-layout base in the eligibility loop).
# The field-assign lowering reads the object via mir_emit_load_var, which for a
# ref-var derefs the caller's one-word handle slot to the shared buffer; the write
# (COW make-unique + shifted store for >16B, offset store for ≤16B) lands in the
# caller's buffer and PERSISTS. A heap/pointer base (Vec/Map/firewall-mixed struct)
# is NOT value-layout, so it stays by-value — its element/field write already
# persists through the shared pointer (regression floor below).

# --- ≤16B value-struct field write: must PERSIST ---

@value
struct P
  x: Int
  y: Int
end

def field_write_le16_persists(): Void
  var p = P { x: 0, y: 0 }
  [1].each { p.x = 5 }
  print(p.x.to_s())
  print("\n")
end

# --- ≤16B accumulate: closure READS and FIELD-WRITES the captured value ---

@value
struct Acc
  t: Int
  u: Int
end

def field_accumulate_persists(): Void
  var acc = Acc { t: 0, u: 0 }
  [10, 20].each { acc.t = acc.t + it }
  print(acc.t.to_s())
  print("\n")
end

# --- >16B value-struct (String field → CoW buffer, touches handle+8): must PERSIST ---

@value
struct Big
  a: Int
  b: Int
  c: Int
  name: String
end

def field_write_gt16_persists(): Void
  var g = Big { a: 0, b: 0, c: 0, name: "init" }
  [1].each { g.a = 9 }
  print(g.a.to_s())
  print("\n")
end

# --- >16B accumulate across two elements ---

def big_field_accumulate_persists(): Void
  var g = Big { a: 0, b: 0, c: 0, name: "init" }
  [3, 4].each { g.a = g.a + it }
  print(g.a.to_s())
  print("\n")
end

# --- REGRESSION: Vec index-write through a captured Vec still persists ---
# A Vec is a reference handle (NOT value-layout), so the capture stays BY-VALUE
# (shared pointer) and the element write already lands in the caller's Vec. This
# guards that the WS2 index-assign classification did not wrongly by-ref (relayout)
# a heap capture.

def vec_index_write_persists(): Void
  var v = [1, 2, 3]
  [0].each { v[1] = 42 }
  print(v[1].to_s())
  print("\n")
end

def main(): Int
  describe("value-struct captured field/index write (WS2)") do ->
    it("≤16B value-struct field write persists") do ->
      assert_output("5\n", field_write_le16_persists)
    end

    it("≤16B value-struct field accumulate persists") do ->
      assert_output("30\n", field_accumulate_persists)
    end

    it(">16B value-struct (String field) field write persists") do ->
      assert_output("9\n", field_write_gt16_persists)
    end

    it(">16B value-struct field accumulate persists") do ->
      assert_output("7\n", big_field_accumulate_persists)
    end

    it("Vec index-write through a captured Vec still persists (regression)") do ->
      assert_output("42\n", vec_index_write_persists)
    end
  end

  return qspec_main()
end
