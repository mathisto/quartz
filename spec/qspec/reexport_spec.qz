## Re-Export Chain Tests - Verifies wildcard re-export and transitive import resolution
## Tests for Bug 2 (re-export chain closure resolution)
##
## Contract:
##   1. Wildcard re-export chain (Bug 2).
##   2. Mixed import patterns.
##   3. Re-export edge cases.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("wildcard re-export chain (Bug 2)") do ->
    it("simple wildcard re-export chain") do ->
      var files: Vec = vec_new()
      files.push(as_int("helpers.qz"))
      files.push(as_int("def helper_add(a: Int, b: Int): Int = a + b"))
      files.push(as_int("lib.qz"))
      vec_push(files, as_int("""
        import * from helpers
        def lib_compute(x: Int): Int
          return helper_add(x, 10)
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import lib
        def main(): Int
          return lib::lib_compute(5)
        end
        """))
      assert_multi_run_exits(files, 2, 15)
    end

    it("re-export generates call not closure load") do ->
      var files: Vec = vec_new()
      files.push(as_int("base.qz"))
      files.push(as_int("def base_val(): Int = 42"))
      files.push(as_int("mid.qz"))
      vec_push(files, as_int("""
        import * from base
        def mid_fn(): Int
          return base_val()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import mid
        def main(): Int
          return mid::mid_fn()
        end
        """))
      var r = subprocess_compile_multi(files, 2)
      _inc_assertions()
      if str_contains(r.stdout_content, "load i64, i64* %base_val")
        _record_failure("Found closure load for base_val - should be a direct call")
      end
    end

    it("deep re-export chain: A -> B -> C") do ->
      var files: Vec = vec_new()
      files.push(as_int("deep_c.qz"))
      files.push(as_int("def deep_val(): Int = 99"))
      files.push(as_int("deep_b.qz"))
      vec_push(files, as_int("""
        import * from deep_c
        def b_call(): Int
          return deep_val()
        end
        """))
      files.push(as_int("deep_a.qz"))
      vec_push(files, as_int("""
        import * from deep_b
        def a_call(): Int
          return b_call()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import deep_a
        def main(): Int
          return deep_a::a_call()
        end
        """))
      assert_multi_run_exits(files, 3, 99)
    end

    it("wildcard import with multiple functions") do ->
      var files: Vec = vec_new()
      files.push(as_int("mathlib.qz"))
      vec_push(files, as_int("""
        def ml_add(a: Int, b: Int): Int = a + b
        def ml_mul(a: Int, b: Int): Int = a * b
        """))
      files.push(as_int("calc.qz"))
      vec_push(files, as_int("""
        import * from mathlib
        def compute(x: Int): Int
          return ml_add(ml_mul(x, 2), 3)
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import calc
        def main(): Int
          return calc::compute(5)
        end
        """))
      assert_multi_run_exits(files, 2, 13)
    end
  end

  describe("mixed import patterns") do ->
    it("qualified and wildcard imports in same file") do ->
      var files: Vec = vec_new()
      files.push(as_int("utils.qz"))
      files.push(as_int("def util_id(x: Int): Int = x"))
      files.push(as_int("extras.qz"))
      files.push(as_int("def extra_double(x: Int): Int = x * 2"))
      files.push(as_int("app.qz"))
      vec_push(files, as_int("""
        import utils
        import * from extras
        def app_fn(x: Int): Int
          return extra_double(utils::util_id(x))
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import app
        def main(): Int
          return app::app_fn(7)
        end
        """))
      assert_multi_run_exits(files, 3, 14)
    end

    it("multiple wildcard imports") do ->
      var files: Vec = vec_new()
      files.push(as_int("alpha.qz"))
      files.push(as_int("def alpha_val(): Int = 10"))
      files.push(as_int("beta.qz"))
      files.push(as_int("def beta_val(): Int = 20"))
      files.push(as_int("gamma.qz"))
      vec_push(files, as_int("""
        import * from alpha
        import * from beta
        def gamma_sum(): Int
          return alpha_val() + beta_val()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import gamma
        def main(): Int
          return gamma::gamma_sum()
        end
        """))
      assert_multi_run_exits(files, 3, 30)
    end
  end

  describe("re-export edge cases") do ->
    it("diamond import: A->B->D + A->C->D") do ->
      var files: Vec = vec_new()
      files.push(as_int("shared.qz"))
      files.push(as_int("def shared_val(): Int = 5"))
      files.push(as_int("left.qz"))
      vec_push(files, as_int("""
        import * from shared
        def left_fn(): Int
          return shared_val() + 1
        end
        """))
      files.push(as_int("right.qz"))
      vec_push(files, as_int("""
        import * from shared
        def right_fn(): Int
          return shared_val() + 2
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import left
        import right
        def main(): Int
          return left::left_fn() + right::right_fn()
        end
        """))
      assert_multi_run_exits(files, 3, 13)
    end

    it("re-exported fn not confused with local") do ->
      var files: Vec = vec_new()
      files.push(as_int("provider.qz"))
      files.push(as_int("def provided(): Int = 30"))
      files.push(as_int("consumer.qz"))
      vec_push(files, as_int("""
        import * from provider
        def local_fn(): Int = 50
        def use_both(): Int
          return provided() + local_fn()
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import consumer
        def main(): Int
          return consumer::use_both()
        end
        """))
      assert_multi_run_exits(files, 2, 80)
    end

    it("pub import makes imported symbols available downstream") do ->
      var files: Vec = vec_new()
      files.push(as_int("origin.qz"))
      files.push(as_int("def origin_val(): Int = 7"))
      files.push(as_int("relay.qz"))
      vec_push(files, as_int("""
        pub import * from origin
        def relay_own(): Int = 3
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from relay
        def main(): Int
          return origin_val() + relay_own()
        end
        """))
      assert_multi_run_exits(files, 2, 10)
    end
    it("pub import does NOT re-export private functions") do ->
      var files: Vec = vec_new()
      files.push(as_int("origin.qz"))
      vec_push(files, as_int("""
        def origin_pub(): Int = 42
        priv
        def origin_priv(): Int = 99
        """))
      files.push(as_int("relay.qz"))
      vec_push(files, as_int("""
        pub import * from origin
        def relay_fn(): Int = origin_pub()
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import * from relay
        def main(): Int
          return origin_priv()
        end
        """))
      assert_multi_compile_error(files, 2, "Undefined function")
    end
  end

  return qspec_main()
end
