## Concurrency Tests
##
## Contract:
##   1. Thread spawn.
##   2. Thread join.
##   3. Atomic operations.
##   4. Parallel iteration.
##   5. Spawn with arguments.
##   6. Channels.
##   7. Mutex.
##   8. Select statement.
##   9. Channel iteration.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("thread spawn") do ->
    it("spawns thread with function") do ->
      assert_eq(cs_spawn_fn(), 42)
    end

    it("spawns multiple threads") do ->
      assert_eq(cs_multi_spawn(), 42)
    end

    it("spawns thread with lambda") do ->
      assert_run_exits(cs_lambda_spawn_src(), 42)
    end
    it("spawns thread with closure capturing values") do ->
      assert_run_exits(cs_closure_capture_src(), 42)
    end
    it("spawns multiple closures with different captures") do ->
      assert_run_exits(cs_multi_closure_src(), 42)
    end
    it("thread executes concurrently with main") do ->
      assert_run_exits(cs_concurrent_src(), 0)
    end
  end

  describe("thread join") do ->
    it("waits for thread to complete") do ->
      assert_eq(cs_join(), 42)
    end

    it("returns value from thread") do ->
      assert_eq(cs_return_val(), 99)
    end

    it("joins multiple threads") do ->
      assert_eq(cs_multi_join(), 60)
    end

    it("join on already-completed thread returns immediately") do ->
      assert_run_exits(cs_join_completed_src(), 42)
    end
  end

  describe("atomic operations") do ->
    it("atomic load reads value") do ->
      var a = atomic_new(42)
      assert_eq(atomic_load(a), 42)
    end

    it("atomic store writes value") do ->
      var a = atomic_new(0)
      atomic_store(a, 99)
      assert_eq(atomic_load(a), 99)
    end

    it("atomic add increments atomically") do ->
      var a = atomic_new(10)
      old = atomic_add(a, 5)
      assert_eq(old, 10)
      assert_eq(atomic_load(a), 15)
    end

    it("atomic sub decrements atomically") do ->
      var a = atomic_new(20)
      old = atomic_sub(a, 7)
      assert_eq(old, 20)
      assert_eq(atomic_load(a), 13)
    end

    it("atomic compare_exchange succeeds on match") do ->
      var a = atomic_new(42)
      result = atomic_cas(a, 42, 99)
      assert_eq(result, 1)
      assert_eq(atomic_load(a), 99)
    end

    it("atomic compare_exchange fails on mismatch") do ->
      var a = atomic_new(42)
      result = atomic_cas(a, 99, 0)
      assert_eq(result, 0)
      assert_eq(atomic_load(a), 42)
    end

    it("atomic operations prevent data races") do ->
      assert_run_exits(cs_atomic_race_src(), 0)
    end
  end

  describe("parallel iteration") do ->
    it("parallel_map applies function to each element") do ->
      assert_run_exits(cs_pmap_apply_src(), 0)
    end

    it("parallel_map returns results in order") do ->
      assert_run_exits(cs_pmap_order_src(), 0)
    end

    it("parallel_for executes side effects") do ->
      assert_run_exits(cs_pfor_src(), 0)
    end

    it("parallel_reduce combines results") do ->
      assert_run_exits(cs_preduce_src(), 0)
    end
  end

  describe("spawn with arguments") do ->
    it("allows spawning nullary function") do ->
      assert_eq(cs_nullary(), 42)
    end

    it("passes Int argument to spawned function") do ->
      assert_eq(cs_one_arg(), 84)
    end

    it("passes struct argument to spawned function") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        def get_sum(p: Point): Int = p.x + p.y
        def main(): Int
          p = Point { x: 20, y: 22 }
          h = go get_sum(p)
          return await h
        end
        """, 42)
    end

    it("passes multiple Int arguments to spawned function") do ->
      assert_eq(cs_two_args(), 42)
    end

    it("passes three arguments to spawned function") do ->
      assert_eq(cs_three_args(), 60)
    end
  end

  describe("channels") do ->
    it("creates a channel") do ->
      assert_eq(cs_ch_create(), 1)
    end
    it("sends and receives between threads") do ->
      assert_eq(cs_ch_cross_thread(), 42)
    end
    it("passes computed value through channel") do ->
      assert_eq(cs_ch_compute(), 42)
    end
    it("try_send succeeds when channel is empty") do ->
      assert_eq(cs_ch_try_send_ok(), 1)
    end
    it("try_send fails when channel is full") do ->
      assert_eq(cs_ch_try_send_full(), 0)
    end
    it("try_recv returns None when channel is empty") do ->
      assert_eq(cs_ch_try_recv_empty_tag(), 1)
    end
    it("try_recv returns Some(value) when channel has data") do ->
      assert_eq(cs_ch_try_recv_data_val(), 42)
    end
    it("try_recv correctly receives value 0") do ->
      assert_eq(cs_ch_try_recv_zero_tag(), 1)
    end
    it("creates a buffered channel with capacity") do ->
      assert_eq(cs_ch_buffered(), 1)
    end
    it("sends multiple values without blocking") do ->
      assert_eq(cs_ch_multi_send(), 3)
    end
    it("receives values in FIFO order") do ->
      assert_eq(cs_ch_fifo(), 1230)
    end
    it("blocks send when buffer is full") do ->
      assert_run_exits(cs_blocking_send_src(), 60)
    end
    it("channel_size returns current buffer count") do ->
      assert_eq(cs_ch_len(), 2)
    end
    it("channel_size decreases after recv") do ->
      assert_eq(cs_ch_len_dec(), 1)
    end
    it("unbuffered channel has capacity 0") do ->
      assert_run_exits("""
        def main(): Int
          ch = channel_new(0)
          if ch != 0
            return 0
          end
          return 1
        end
        """, 0)
    end
    it("unbuffered channel blocks send until recv") do ->
      assert_run_exits("""
        def sender(ch: Int): Int
          send(ch, 42)
          return 0
        end
        def main(): Int
          ch = channel_new(1)
          h = go sender(ch)
          val = recv(ch)
          await h
          return val
        end
        """, 42)
    end
  end

  describe("mutex") do ->
    it("creates a mutex with initial value") do ->
      assert_eq(cs_mx_create(), 42)
    end
    it("updates protected value") do ->
      assert_eq(cs_mx_update(), 99)
    end
    it("protects concurrent increments") do ->
      assert_run_exits(cs_mutex_concurrent_src(), 0)
    end
    it("try_lock succeeds when mutex is free") do ->
      assert_eq(cs_mx_try_lock(), 42)
    end
  end

  describe("select statement") do ->
    it("receives from ready channel") do ->
      assert_eq(cs_select_recv(), 42)
    end
    it("receives from one of multiple channels") do ->
      assert_eq(cs_select_multi_recv(), 99)
    end
    it("sends to ready channel") do ->
      assert_eq(cs_select_send(), 42)
    end
    it("executes default when no channels ready") do ->
      assert_eq(cs_select_default(), 7)
    end
    it("multiplexes producer channels") do ->
      assert_run_exits(cs_select_multiplex_src(), 0)
    end
  end

  describe("channel iteration") do ->
    it("channel_closed returns false for open channel") do ->
      assert_eq(cs_ch_not_closed(), 0)
    end
    it("channel_closed returns true after channel_close") do ->
      assert_eq(cs_ch_is_closed(), 1)
    end
    it("recv returns 0 on closed empty channel") do ->
      assert_eq(cs_ch_recv_closed(), 0)
    end
    it("recv returns buffered value from closed channel") do ->
      assert_eq(cs_ch_recv_closed_buf(), 77)
    end
    it("producer-consumer with channel_close terminates") do ->
      assert_eq(cs_ch_producer_consumer(), 60)
    end
    it("for x in channel iterates until closed") do ->
      assert_run_exits("""
        def producer(ch: Int): Int
          send(ch, 10)
          send(ch, 20)
          send(ch, 30)
          channel_close(ch)
          return 0
        end
        def main(): Int
          ch = channel_new(1)
          h = go producer(ch)
          var sum = 0
          var done = 0
          while done == 0
            val = recv(ch)
            if val == 0 and channel_closed(ch)
              done = 1
            else
              sum = sum + val
            end
          end
          await h
          return sum
        end
        """, 60)
    end
  end

  return qspec_main()
end

## Helper functions for spawn/await tests

def cs_work42(): Int = 42

def cs_spawn_fn(): Int
  h = go cs_work42()
  return await h
end

def cs_work20(): Int = 20
def cs_work22(): Int = 22

def cs_multi_spawn(): Int
  h1 = go cs_work20()
  h2 = go cs_work22()
  return await h1 + await h2
end

def cs_join(): Int
  h = go cs_work42()
  return await h
end

def cs_work99(): Int = 99

def cs_return_val(): Int
  h = go cs_work99()
  return await h
end

def cs_work_n(n: Int): Int = n * 2

def cs_multi_join(): Int
  h1 = go cs_work_n(10)
  h2 = go cs_work_n(10)
  h3 = go cs_work_n(10)
  return await h1 + await h2 + await h3
end

def cs_nullary(): Int
  h = go cs_work42()
  return await h
end

def cs_double(x: Int): Int = x * 2

def cs_one_arg(): Int
  h = go cs_double(42)
  return await h
end

def cs_add(a: Int, b: Int): Int = a + b

def cs_two_args(): Int
  h = go cs_add(20, 22)
  return await h
end

def cs_sum3(a: Int, b: Int, c: Int): Int = a + b + c

def cs_three_args(): Int
  h = go cs_sum3(10, 20, 30)
  return await h
end

## Channel helper functions

def cs_ch_create(): Int
  ch = channel_new(1)
  if ch != 0
    return 1
  end
  return 0
end

def cs_ch_try_send_ok(): Int
  ch = channel_new(1)
  return try_send(ch, 42)
end

def cs_ch_try_send_full(): Int
  ch = channel_new(1)
  try_send(ch, 42)
  return try_send(ch, 99)
end

def cs_ch_try_recv_empty_tag(): Int
  ch = channel_new(1)
  opt = try_recv(ch)
  return load(opt, 0)
end

def cs_ch_try_recv_data_val(): Int
  ch = channel_new(1)
  try_send(ch, 42)
  opt = try_recv(ch)
  tag = load(opt, 0)
  if tag == 0
    return load(opt, 1)
  end
  return -1
end

def cs_ch_try_recv_zero_tag(): Int
  ch = channel_new(1)
  try_send(ch, 0)
  opt = try_recv(ch)
  tag = load(opt, 0)
  if tag == 0
    return 1
  end
  return 0
end

def cs_ch_buffered(): Int
  ch = channel_new(5)
  if ch != 0
    return 1
  end
  return 0
end

def cs_ch_multi_send(): Int
  ch = channel_new(3)
  a = try_send(ch, 10)
  b = try_send(ch, 20)
  c = try_send(ch, 30)
  return a + b + c
end

def cs_ch_fifo(): Int
  ch = channel_new(3)
  try_send(ch, 10)
  try_send(ch, 20)
  try_send(ch, 30)
  opt1 = try_recv(ch)
  r1 = load(opt1, 1)
  opt2 = try_recv(ch)
  r2 = load(opt2, 1)
  opt3 = try_recv(ch)
  r3 = load(opt3, 1)
  return r1 * 100 + r2 * 10 + r3
end

def cs_ch_len(): Int
  ch = channel_new(5)
  try_send(ch, 10)
  try_send(ch, 20)
  return channel_size(ch)
end

def cs_ch_len_dec(): Int
  ch = channel_new(5)
  try_send(ch, 10)
  try_send(ch, 20)
  try_recv(ch)
  return channel_size(ch)
end

def cs_ch_not_closed(): Int
  ch = channel_new(1)
  return channel_closed(ch)
end

def cs_ch_is_closed(): Int
  ch = channel_new(1)
  channel_close(ch)
  return channel_closed(ch)
end

## Blocking channel helpers (need send/recv intrinsic fix)

def cs_ch_sender(ch: Int): Int
  send(ch, 42)
  return 0
end

def cs_ch_cross_thread(): Int
  ch = channel_new(1)
  h = go cs_ch_sender(ch)
  val = recv(ch)
  await h
  return val
end

def cs_ch_compute_sender(ch: Int): Int
  send(ch, 6 * 7)
  return 0
end

def cs_ch_compute(): Int
  ch = channel_new(1)
  h = go cs_ch_compute_sender(ch)
  val = recv(ch)
  await h
  return val
end

def cs_ch_recv_closed(): Int
  ch = channel_new(1)
  channel_close(ch)
  return recv(ch)
end

def cs_ch_recv_closed_buf(): Int
  ch = channel_new(1)
  try_send(ch, 77)
  channel_close(ch)
  return recv(ch)
end

## Mutex helper functions

def cs_mx_create(): Int
  m = mutex_new(42)
  val = mutex_lock(m)
  mutex_unlock(m, val)
  return val
end

def cs_mx_update(): Int
  m = mutex_new(42)
  val = mutex_lock(m)
  mutex_unlock(m, 99)
  val2 = mutex_lock(m)
  mutex_unlock(m, val2)
  return val2
end

def cs_mx_try_lock(): Int
  m = mutex_new(42)
  val = mutex_try_lock(m)
  if val != -1
    mutex_unlock(m, val)
  end
  return val
end

## Select statement helper functions

def cs_select_recv(): Int
  ch = channel_new(1)
  send(ch, 42)
  var result = 0
  select
    case v = recv(ch) => result = v
  end
  return result
end

def cs_select_multi_recv(): Int
  ch1 = channel_new(1)
  ch2 = channel_new(1)
  send(ch2, 99)
  var result = 0
  select
    case v = recv(ch1) => result = v
    case v = recv(ch2) => result = v
  end
  return result
end

def cs_select_send(): Int
  ch = channel_new(1)
  select
    case _ = send(ch, 42) => 0
  end
  return recv(ch)
end

def cs_select_default(): Int
  ch = channel_new(1)
  var result = 0
  select
    case v = recv(ch) => result = v
    default => result = 7
  end
  return result
end

## Producer-consumer with channel_close

def cs_ch_producer(ch: Int): Int
  send(ch, 10)
  send(ch, 20)
  send(ch, 30)
  channel_close(ch)
  return 0
end

def cs_ch_producer_consumer(): Int
  ch = channel_new(1)
  h = go cs_ch_producer(ch)
  var sum = 0
  var done = 0
  while done == 0
    val = recv(ch)
    if val == 0 and channel_closed(ch)
      done = 1
    else
      sum = sum + val
    end
  end
  await h
  return sum
end

def cs_concurrent_src(): String = """
  def worker(atom: Int): Int
    atomic_add(atom, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    h = go worker(atom)
    atomic_add(atom, 1)
    await h
    result = atomic_load(atom)
    if result == 2
      return 0
    end
    return 1
  end
  """

def cs_join_completed_src(): String = """
  def work(): Int = 42
  def main(): Int
    h = go work()
    var count = 0
    while count < 10000
      count += 1
    end
    return await h
  end
  """

def cs_atomic_race_src(): String = """
  def adder(atom: Int): Int
    var idx = 0
    while idx < 1000
      atomic_add(atom, 1)
      idx += 1
    end
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    h1 = go adder(atom)
    h2 = go adder(atom)
    h3 = go adder(atom)
    await h1
    await h2
    await h3
    result = atomic_load(atom)
    if result == 3000
      return 0
    end
    return 1
  end
  """

def cs_blocking_send_src(): String = """
  def sender(ch: Int): Int
    send(ch, 10)
    send(ch, 20)
    send(ch, 30)
    return 0
  end
  def main(): Int
    ch = channel_new(1)
    h = go sender(ch)
    a = recv(ch)
    b = recv(ch)
    c = recv(ch)
    await h
    return a + b + c
  end
  """

def cs_mutex_concurrent_src(): String = """
  def incrementer(mx: Int): Int
    var idx = 0
    while idx < 100
      val = mutex_lock(mx)
      mutex_unlock(mx, val + 1)
      idx += 1
    end
    return 0
  end
  def main(): Int
    mx = mutex_new(0)
    h1 = go incrementer(mx)
    h2 = go incrementer(mx)
    h3 = go incrementer(mx)
    await h1
    await h2
    await h3
    final = mutex_lock(mx)
    mutex_unlock(mx, final)
    if final == 300
      return 0
    end
    return 1
  end
  """

def cs_select_multiplex_src(): String = """
  def prod1(ch: Int): Int
    send(ch, 10)
    send(ch, 20)
    return 0
  end
  def prod2(ch: Int): Int
    send(ch, 100)
    send(ch, 200)
    return 0
  end
  def main(): Int
    ch1 = channel_new(2)
    ch2 = channel_new(2)
    h1 = go prod1(ch1)
    h2 = go prod2(ch2)
    var total = 0
    var count = 0
    while count < 4
      select
        case val = recv(ch1) => total += val
        case val = recv(ch2) => total += val
      end
      count += 1
    end
    await h1
    await h2
    if total == 330
      return 0
    end
    return 1
  end
  """

def cs_pmap_apply_src(): String = """
  def double(n: Int): Int = n * 2
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> double(1))
      taskgroup_spawn(g, -> double(2))
      taskgroup_spawn(g, -> double(3))
      taskgroup_collect(g)
    end
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    c = vec_get(results, 2)
    if a == 2 and b == 4 and c == 6
      return 0
    end
    return 1
  end
  """

def cs_pmap_order_src(): String = """
  def identity(n: Int): Int = n
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> identity(10))
      taskgroup_spawn(g, -> identity(20))
      taskgroup_spawn(g, -> identity(30))
      taskgroup_collect(g)
    end
    a = vec_get(results, 0)
    b = vec_get(results, 1)
    c = vec_get(results, 2)
    if a == 10 and b == 20 and c == 30
      return 0
    end
    return 1
  end
  """

def cs_pfor_src(): String = """
  def add_one(a: Int): Int
    atomic_add(a, 1)
    return 0
  end
  def main(): Int
    atom = atomic_new(0)
    task_group |g|
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
      taskgroup_spawn(g, -> add_one(atom))
    end
    result = atomic_load(atom)
    if result == 4
      return 0
    end
    return 1
  end
  """

def cs_preduce_src(): String = """
  def compute(n: Int): Int = n * 10
  def main(): Int
    results = task_group |g|
      taskgroup_spawn(g, -> compute(1))
      taskgroup_spawn(g, -> compute(2))
      taskgroup_spawn(g, -> compute(3))
      taskgroup_collect(g)
    end
    var sum = 0
    sum += vec_get(results, 0)
    sum += vec_get(results, 1)
    sum += vec_get(results, 2)
    if sum == 60
      return 0
    end
    return 1
  end
  """

def cs_lambda_spawn_src(): String = """
  def main(): Int
    h = go (-> 42)
    return await h
  end
  """

def cs_closure_capture_src(): String = """
  def main(): Int
    var x = 10
    h = go (-> x + 32)
    return await h
  end
  """

def cs_multi_closure_src(): String = """
  def main(): Int
    var a = 20
    var b = 22
    h1 = go (-> a)
    h2 = go (-> b)
    return await h1 + await h2
  end
  """
