## Enum-access constructor payload type-safety (enum-niche tail, item 2)
##
## Contract:
##   `Option::Some(x)` / `Result::Ok(x)` / `Result::Err(x)` carry a CONCRETE
##   payload type instead of the erased bare `Option`/`Result`. There are no
##   result_ok/result_err builtins — Result is built ONLY via this enum-access
##   path — so this carry covers all variants. Closes holes 15 + 16.
##
## Refinement shape:
##   Option::Some(x)  ->  Option<typeof x>
##   Result::Ok(x)    ->  Result<typeof x, UNKNOWN>   (Err arg necessarily unknown)
##   Result::Err(x)   ->  Result<UNKNOWN, typeof x>   (Ok arg necessarily unknown)
##
## Tightening fix — the risk is OVER-tightening (rejecting valid programs).
## A TYPE_UNKNOWN wildcard in tc_elem_type_matches keeps the UNKNOWN slot loose
## so `Result<Int,String> = Result::Ok(5)` accepts (item 15's parked control).
## Bare aggregate-base payloads (struct literals) stay loose (item 14 OUT).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("enum-access payload — mismatched element rejected") do ->
    it("rejects Option::Some(Int) into Vec<Option<String>>") do ->
      assert_compile_error(
        "def main(): Int\n  var v: Vec<Option<String>> = vec_new<Option<String>>()\n  v.push(Option::Some(42))\n  return 0\nend\n",
        "expected element type")
    end

    it("rejects Option::Some(String) into Vec<Option<Int>>") do ->
      assert_compile_error(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  v.push(Option::Some(\"s\"))\n  return 0\nend\n",
        "expected element type")
    end

    it("rejects Result::Ok(String) returned from Result<Int,String> fn (Ok tight-mismatch survives wildcard)") do ->
      assert_compile_error(
        "def f(): Result<Int, String>\n  return Result::Ok(\"s\")\nend\ndef main(): Int\n  return 0\nend\n",
        "Return type mismatch")
    end

    it("rejects Result::Err(Int) from Result<Int,String> fn (Err Int-vs-String)") do ->
      assert_compile_error(
        "def f(): Result<Int, String>\n  return Result::Err(42)\nend\ndef main(): Int\n  return 0\nend\n",
        "Return type mismatch")
    end
  end

  describe("enum-access payload — matching element accepted (no over-tighten)") do ->
    it("accepts Option::Some(Int) into Vec<Option<Int>>") do ->
      assert_compile_succeeds(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  v.push(Option::Some(42))\n  return 0\nend\n")
    end

    it("accepts Result::Ok(5) from Result<Int,String> fn (Err=UNKNOWN wildcard — item 15 control)") do ->
      assert_compile_succeeds(
        "def f(): Result<Int, String>\n  return Result::Ok(5)\nend\ndef main(): Int\n  return 0\nend\n")
    end

    it("accepts Result::Err(\"boom\") from Result<Int,String> fn") do ->
      assert_compile_succeeds(
        "def g(): Result<Int, String>\n  return Result::Err(\"boom\")\nend\ndef main(): Int\n  return 0\nend\n")
    end

    it("accepts i64-compatible Bool payload into Vec<Option<Int>>") do ->
      assert_compile_succeeds(
        "def main(): Int\n  var v: Vec<Option<Int>> = vec_new<Option<Int>>()\n  var b = true\n  v.push(Option::Some(b))\n  return 0\nend\n")
    end

    it("accepts Result::Ok struct-literal payload (item 14 OUT non-regression — stays loose)") do ->
      assert_compile_succeeds(
        "struct Cfg\n  port: Int\nend\ndef f(): Result<Cfg, String>\n  return Result::Ok(Cfg { port: 8080 })\nend\ndef main(): Int\n  return 0\nend\n")
    end
  end

  describe("enum-access payload — unannotated inference / niche read") do ->
    it("narrows var r = Result::Ok(5) and computes r.unwrap() + 1") do ->
      var r = Result::Ok(5)
      assert_eq(r.unwrap() + 1, 6)
    end

    it("un-annotated struct-literal Option::Some payload still reads field (niche non-regression)") do ->
      var u = Option::Some(EapBox { age: 42 })
      assert_eq(u.unwrap().age, 42)
    end
  end

  return qspec_main()
end

struct EapBox
  age: Int
end
