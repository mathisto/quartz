## std/file_io — FileIo effect acceptance spec.
##
## Operation Piezoelectric Effects, Phase 5, Milestone 5.4.a.
##
## Verifies the FileIo effect declared in std/file_io.qz: the four
## flat ops (fio_read/fio_write/fio_exists/fio_list_dir) route through
## a user-installed handler when wrapped in `with FileIo { … }`, and
## fall through to the libc-forwarding default handlers otherwise.
## Also proves the testability win: a mock handler lets a caller
## satisfy fs reads from an in-memory table.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("std/file_io — FileIo effect (piezo 5.4.a)") do ->
    it("fio_read dispatches to installed handler") do ->
      assert_run_stdout_eq("""
import std/file_io

def mock_read(op_name: Int, argc: Int, argv: Int): Int
  return as_int("MOCKED PAYLOAD")
end

def do_read(path: String): String can FileIo
  return fio_read(path)
end

def main(): Int
  with FileIo { fio_read: mock_read } do ->
    var src = do_read("anything.qz")
    puts(src)
  end
  return 0
end
""", "MOCKED PAYLOAD\n")
    end

    it("mock handler can branch on path argument") do ->
      assert_run_stdout_eq("""
import std/file_io

def mock_read(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  if path == "foo.qz"
    return as_int("FOO CONTENT")
  end
  if path == "bar.qz"
    return as_int("BAR CONTENT")
  end
  return as_int("")
end

def do_read(path: String): String can FileIo
  return fio_read(path)
end

def main(): Int
  with FileIo { fio_read: mock_read } do ->
    puts(do_read("foo.qz"))
    puts(do_read("bar.qz"))
    puts(do_read("missing.qz"))
  end
  return 0
end
""", "FOO CONTENT\nBAR CONTENT\n\n")
    end

    it("default handler forwards fio_read to read_file intrinsic") do ->
      assert_run_stdout_eq("""
import std/file_io

def do_read(path: String): String can FileIo
  return fio_read(path)
end

def main(): Int
  with FileIo { fio_read: file_io::fio_default_read } do ->
    var src = do_read("VERSION")
    # VERSION file exists at repo root — default handler reads it via read_file.
    # We just check it's non-empty to avoid brittle version-string coupling.
    if str_byte_len(src) > 0
      puts("READ OK")
    else
      puts("READ FAILED")
    end
  end
  return 0
end
""", "READ OK\n")
    end

    it("fio_exists dispatches to installed handler") do ->
      assert_run_stdout_eq("""
import std/file_io

def mock_exists(op_name: Int, argc: Int, argv: Int): Int
  var path = as_string(load(argv, 0))
  if path == "exists.qz"
    return 1
  end
  return 0
end

def check(path: String): Bool can FileIo
  return fio_exists(path)
end

def main(): Int
  with FileIo { fio_exists: mock_exists } do ->
    if check("exists.qz") then puts("yes") else puts("no") end
    if check("missing.qz") then puts("yes") else puts("no") end
  end
  return 0
end
""", "yes\nno\n")
    end

    it("can-rowed intermediate caller threads FileIo through") do ->
      assert_run_stdout_eq("""
import std/file_io

def outer_caller(p: String): String can FileIo
  return inner_caller(p)
end

def inner_caller(p: String): String can FileIo
  return fio_read(p)
end

def mock_read(op_name: Int, argc: Int, argv: Int): Int
  return as_int("THROUGH TWO HOPS")
end

def main(): Int
  with FileIo { fio_read: mock_read } do ->
    puts(outer_caller("x"))
  end
  return 0
end
""", "THROUGH TWO HOPS\n")
    end
  end
  return qspec_main()
end
