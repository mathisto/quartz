## QSpec coverage for Phase E.4.a slice 3.a — uniform-value-field struct
## returns from goroutines.
##
## Slice 3.a covers structs whose fields are all 8-byte value-typed and
## NONE narrow-fixed-width (no I8/I16/I32/U8/U16/U32/CInt/CChar fields).
## Such structs have a uniform i64-slot heap layout, so a slot-by-slot
## copy via `arena_promote_struct_value(src, slot_count)` correctly
## deep-copies the heap block.
##
## Slice 3.a does NOT cover:
##   - Mixed-field structs (any String/Vec/struct field) — slice 3.b
##     emits a per-struct walker. Falls through gate to libc fallback.
##   - Narrow-field structs (any I8/I16/I32/U8/U16/U32/CInt/CChar field)
##     — width-specialized layout would corrupt under uniform i64 copy.
##     Falls through gate to libc fallback.
##   - @value structs — stack-allocated, not heap-routed; the async
##     return path copies them by value already. Gate rejects (returns 0)
##     so existing behavior is preserved.
##
## What these tests prove:
##
##   E4a.s3a.a — `go fn(): Point { x: Int, y: Int }`: per-task arena absorbs
##               the struct's heap allocation; promote at task-end deep-copies
##               into the parent's heap; field values survive.
##   E4a.s3a.b — Multi-worker (sched_init(0)): parallel struct-returning
##               goroutines, each in its own per-task arena, results correct.
##   E4a.s3a.c — Larger struct (5 Int fields): slot count > 2 still works.
##   E4a.s3a.d — Mixed-field struct (String field): gate skips, falls through
##               to libc; user-observable behavior unchanged.

import * from qspec
import * from qspec/subprocess

# -----------------------------------------------------------------------------
# E4a.s3a.a — basic 2-field struct (Int, Int).
# -----------------------------------------------------------------------------

var _STRUCT_BASIC: String = """import * from std/sync/composition/go
import * from std/alloc

struct Point
  x: Int
  y: Int
end

def origin(): Point
  return Point { x: 11, y: 22 }
end

def main(): Int
  sched_init(1)
  var fut = go origin()
  var p = await fut
  if p.x == 11 and p.y == 22
    puts(\"struct-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3a.b — parallel struct-returning goroutines on multi-worker.
# -----------------------------------------------------------------------------

var _STRUCT_PARALLEL: String = """import * from std/sync/composition/go
import * from std/alloc

struct Pair
  a: Int
  b: Int
end

def labeled(n: Int): Pair
  return Pair { a: n, b: n * n }
end

def main(): Int
  sched_init(0)
  var f1 = go labeled(3)
  var f2 = go labeled(5)
  var f3 = go labeled(7)
  var p1 = await f1
  var p2 = await f2
  var p3 = await f3
  if p1.a == 3 and p1.b == 9 and p2.a == 5 and p2.b == 25 and p3.a == 7 and p3.b == 49
    puts(\"struct-parallel-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3a.c — larger struct (5 fields) verifies slot-count handling.
# -----------------------------------------------------------------------------

var _STRUCT_WIDE: String = """import * from std/sync/composition/go
import * from std/alloc

struct Stats
  count: Int
  sum: Int
  min: Int
  max: Int
  avg: Int
end

def make_stats(): Stats
  return Stats { count: 10, sum: 100, min: 1, max: 19, avg: 10 }
end

def main(): Int
  sched_init(1)
  var fut = go make_stats()
  var s = await fut
  if s.count == 10 and s.sum == 100 and s.min == 1 and s.max == 19 and s.avg == 10
    puts(\"struct-wide-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3a.d — mixed-field struct (String field) — gate must skip, libc fallback.
# Regression check that the gate correctly rejects non-uniform structs.
# -----------------------------------------------------------------------------

var _STRUCT_MIXED_SKIP: String = """import * from std/sync/composition/go
import * from std/alloc

struct Person
  name: String
  age: Int
end

def make_person(): Person
  return Person { name: \"alice\", age: 30 }
end

def main(): Int
  sched_init(1)
  var fut = go make_person()
  var p = await fut
  if p.name == \"alice\" and p.age == 30
    puts(\"mixed-skip-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

# -----------------------------------------------------------------------------
# E4a.s3a.e — item 37 regression: a >16B (3-field, COW-layout) @value struct
# returned through `await` must read its fields at the right offsets.
#
# A >16B value-layout struct is built as a heap COW buffer
# [refcount@word0, f0@word1, f1@word2, f2@word3]. When the value is returned
# through a future and bound by `var v = await fut`, `v` must be marked with the
# payload struct type so the field-read COW +1 shift fires — otherwise `v.x`
# reads word0 (the refcount = 1) and every field is shifted by one slot.
# Pre-fix this printed x=1 / y=111 / z=222 instead of 111 / 222 / 333.
# (Exercises the bug at gate 0 via an explicit @value struct — no flip needed.)
# -----------------------------------------------------------------------------

var _STRUCT_VALUE_COW: String = """import * from std/sync/composition/go
import * from std/alloc

@value
struct V3
  x: Int
  y: Int
  z: Int
end

def make_v3(): V3
  return V3 { x: 111, y: 222, z: 333 }
end

def main(): Int
  sched_init(1)
  var fut = go make_v3()
  var v = await fut
  if v.x == 111 and v.y == 222 and v.z == 333
    puts(\"value-cow-ok\")
  else
    puts(\"FAIL\")
  end
  sched_shutdown()
  return 0
end
"""

def main(): Int
  describe("Phase E.4.a slice 3.a — uniform-value-field struct returns from goroutines via per-task arena + promote") do ->
    it("2-field struct (Point { x: Int, y: Int }) survives await with correct values") do ->
      assert_run_stdout_eq(_STRUCT_BASIC, "struct-ok\n")
    end

    it("parallel struct-returning goroutines under multi-worker scheduler (sched_init(0))") do ->
      assert_run_stdout_eq(_STRUCT_PARALLEL, "struct-parallel-ok\n")
    end

    it("5-field struct exercises slot_count > 2 in the slot-by-slot copy") do ->
      assert_run_stdout_eq(_STRUCT_WIDE, "struct-wide-ok\n")
    end

    it("mixed-field struct (String + Int) correctly skips gate, falls through to libc") do ->
      assert_run_stdout_eq(_STRUCT_MIXED_SKIP, "mixed-skip-ok\n")
    end

    it("item 37: >16B @value (COW) struct via await reads fields past the refcount header") do ->
      assert_run_stdout_eq(_STRUCT_VALUE_COW, "value-cow-ok\n")
    end
  end
  return qspec_main()
end
