## Module-level `const` of non-integer type (string / float).
##
## Regression: a module-level string or float `const` used to route through the
## integer-only `mir_const_eval_full`, which `puts`-ed "unsupported node kind" to
## STDOUT — corrupting the emitted `.ll` (stdout is the IR channel) and exiting 0,
## so `llc` then failed with `expected top-level entity`. The evaluator now falls
## back silently and the const is lowered via the string-literal global path
## (NODE_STRING_LIT) or the runtime-init global path (the same lowering a
## module-level `var` uses). Integer/derived consts keep the compile-time fold.

import * from qspec

const MC_VERSION = "1.0.3"
const MC_GREETING = "hello"
const MC_PI = 3.14
const MC_HALF = 0.5
const MC_MAX = 64
const MC_DERIVED = MC_MAX + 1

def main(): Int
  describe("module-level non-integer consts") do ->
    it("supports a string const") do ->
      assert_eq_str(MC_VERSION, "1.0.3")
    end

    it("supports a string const in interpolation/output") do ->
      assert_output("hello\n", mc_print_greeting)
    end

    it("supports a float const (shortest round-trip)") do ->
      assert_eq_str("#{MC_PI}", "3.14")
    end

    it("supports a float const in arithmetic") do ->
      assert_eq(to_int(MC_HALF * 8.0), 4)
    end

    it("still folds integer consts at compile time") do ->
      assert_eq(MC_MAX, 64)
    end

    it("still folds derived integer consts (const references const)") do ->
      assert_eq(MC_DERIVED, 65)
    end
  end

  return qspec_main()
end

def mc_print_greeting(): Void = puts(MC_GREETING)
