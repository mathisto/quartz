## JSON Float Parsing Tests
##
## Contract:
##   1. Float literal: `3.14` parsed to correct value.
##   2. Negative float: `-2.5` parsed correctly.
##   3. Scientific: `1.5e2` parsed (non-null).
##   4. Object float: float in `{"pi":3.14}` accessible.
##   5. Int vs float: integers vs floats distinguished.
##   6. Float in array: `[1.5]` accessible.
##   7. Zero float: `0.0` parsed correctly.
import * from qspec
import * from json

def jf_ok_value(source: String): JsonValue
  var result = json_parse(source)
  match result
    Ok(val) => return val
    _ => return json_null()
  end
end

def main(): Int
  describe("JSON float parsing") do ->
    it("parses a float value") do ->
      var fval = jf_ok_value("3.14")
      assert_eq_str(json_stringify(fval), "3.14")
    end

    it("parses a negative float") do ->
      var fval = jf_ok_value("-2.5")
      assert_eq_str(json_stringify(fval), "-2.5")
    end

    it("parses scientific notation") do ->
      var fval = jf_ok_value("1.5e2")
      assert_eq(json_is_null(fval), false)
    end

    it("parses float in object") do ->
      var fval = jf_ok_value("{\"pi\":3.14}")
      assert_eq(json_is_object(fval), true)
      assert_eq_str(json_stringify(json_object_get(fval, "pi")), "3.14")
    end

    it("distinguishes integers from floats") do ->
      var int_v = jf_ok_value("42")
      var float_v = jf_ok_value("3.14")
      assert_eq(json_is_number(int_v), true)
      assert_eq(json_is_number(float_v), false)
    end

    it("parses float in array") do ->
      var arr = jf_ok_value("[1.5, 2.5]")
      assert_eq(json_is_array(arr), true)
    end

    it("parses zero float") do ->
      var fval = jf_ok_value("0.0")
      assert_eq(json_is_null(fval), false)
    end
  end

  return qspec_main()
end
