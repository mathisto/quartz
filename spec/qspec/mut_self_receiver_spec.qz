import * from qspec

# item-20 Phase 7 (WS4-a) — the EXPLICIT `&mut self` / `&self` receiver SURFACE.
#
# Phases 1-6 built the borrow-receiver ABI and drive it by INFERENCE: a value-
# struct method whose body stores `self.<field>` (or transitively calls a self
# method) gets a cached `mutates_self_field` bit, and every downstream borrow
# decision (decompose-suppression, retain/release-skip, make-unique-skip) gates on
# that bit. WS4-a adds the explicit SURFACE without a new ABI:
#
#   * `&mut self` at the receiver position lowers to the SAME `self` param (the
#     borrow ABI predicate requires params[0]=="self") and SETS the SAME
#     `mutates_self_field` verdict inference computes. So annotating an already-
#     mutating method with `&mut self` is byte-identical to leaving it inferred.
#   * `&self` is the explicit read-borrow: it desugars to bare `self`, sets NO
#     flag, and is byte-identical to a bare-`self` receiver.
#
# These use `@value` structs so the value-layout gate is LIVE at gate 0 (the
# `@value`-at-gate-0 oracle): the `&mut self` mutation is really routed through the
# borrow ABI and observed by the caller — no throwaway flip=1 build needed.
#
# NOTE (enforcement): QZ0407 (reject an undeclared mutating method) is the LATER
# stage (WS4-b) + stdlib migration; it is NOT emitted here. This stage only makes
# `&mut self` / `&self` PARSE and wires the flag.

# --- ≤16B @value: explicit `&mut self` mutation persists ---

@value
struct EMCounter
  cur: Int
  hi: Int
end

extend EMCounter
  def bump(&mut self): Void
    self.cur = self.cur + 1
  end
  def total(&self): Int
    return self.cur + self.hi
  end
end

def em_mut_persists(): Void
  var c = EMCounter { cur: 1, hi: 10 }
  c.bump()
  c.bump()
  # the write to self.cur (via `&mut self`) is observed by the caller's slot
  print(c.cur.to_s())
  print("\n")
end

def em_read_self_unaffected(): Void
  var c = EMCounter { cur: 3, hi: 4 }
  # `&self` read-borrow: reads both fields, leaves the receiver intact
  var t = c.total()
  print(t.to_s())
  print("\n")
  print(c.cur.to_s())
  print("\n")
end

# --- >16B @value COW: explicit `&mut self` in-place mutation persists ---

@value
struct EMBig
  a: Int
  b: Int
  c: Int
end

extend EMBig
  def bump(&mut self): Void
    self.a = self.a + 1
  end
  def sum3(&self): Int
    return self.a + self.b + self.c
  end
end

def embig_mut_persists(): Void
  # COW (>16B): the in-place `&mut self` mutation must persist across calls.
  var c = EMBig { a: 0, b: 10, c: 20 }
  c.bump()
  c.bump()
  c.bump()
  print(c.a.to_s())
  print("\n")
end

def embig_read_self_unaffected(): Void
  var c = EMBig { a: 1, b: 2, c: 3 }
  var t = c.sum3()
  print(t.to_s())
  print("\n")
  print(c.a.to_s())
  print("\n")
end

# --- COW @value iterator with an explicit `&mut self` advance ---

@value
struct EMIter
  cursor: Int
  limit: Int
  pad: Int
end

extend EMIter
  def step(&mut self): Option<Int>
    if self.cursor >= self.limit
      return option_none()
    end
    var v = self.cursor
    self.cursor = self.cursor + 1
    return option_some(v)
  end
end

def emiter_advances(): Void
  # a COW @value iterator's `&mut self` step advances the cursor in place. 0..4 = 10.
  var c = EMIter { cursor: 0, limit: 5, pad: 99 }
  var sum = 0
  var done = 0
  while done == 0
    var r = c.step()
    if r is Some(v)
      sum = sum + v
    else
      done = 1
    end
  end
  print(sum.to_s())
  print("\n")
end

def main(): Int
  describe("explicit &mut self / &self surface — ≤16B @value (WS4-a)") do ->
    it("&mut self mutation persists into the caller's receiver slot") do ->
      assert_output("3\n", em_mut_persists)
    end

    it("&self read-borrow reads the receiver without disturbing it") do ->
      assert_output("7\n3\n", em_read_self_unaffected)
    end
  end

  describe("explicit &mut self surface — COW >16B @value (WS4-a)") do ->
    it("&mut self mutation persists in place across repeated calls") do ->
      assert_output("3\n", embig_mut_persists)
    end

    it("&self read-borrow leaves the COW receiver intact") do ->
      assert_output("6\n1\n", embig_read_self_unaffected)
    end

    it("&mut self iterator advances its cursor in place (no loss/hang)") do ->
      assert_output("10\n", emiter_advances)
    end
  end

  return qspec_main()
end
