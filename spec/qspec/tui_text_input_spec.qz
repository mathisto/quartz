## v0.3.2 Step 3 — TextInput behavior tests
##
## Coverage axes:
##   - Edit semantics: insert, backspace, delete, word-delete, line-delete
##   - Cursor movement: left, right, home, end, clamping
##   - Validation: Never / OnChange / OnSubmit / OnBlur
##   - Submit: passes validator → Submitted; fails → Changed + last_error
##   - max_length enforcement
##   - View: placeholder vs value, focused vs unfocused, cursor position
##   - State setters: set_value_unchecked clears error, clear resets all
##   - UTF-8: multibyte / wide chars in value (codepoint indexing)

import * from qspec
import std/tui/runtime as tui
import std/terminal
import std/tui/widgets/text_input as ti
import std/tui/layout as ly

# Spec-local app msg enum so we have a concrete M for FrameMsg<M>.
enum SpecMsg
  Noop
end

# Helper — drive a key event through update; return the next TextInput.
def feed_key(t: ti::TextInput, code: Int): ti::TextInput
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = ti::text_input_update(t, msg)
  return triple.0
end

# Helper — drive a printable character codepoint.
def feed_char(t: ti::TextInput, c: Int): ti::TextInput = feed_key(t, c)

# Helper — feed a string codepoint by codepoint.
def feed_string(t: ti::TextInput, s: String): ti::TextInput
  var i = 0
  var len = str_byte_len(s)
  var out = t
  while i < len
    var cp = str_codepoint_at(s, i)
    out = feed_char(out, cp)
    i = i + str_codepoint_byte_len(s, i)
  end
  return out
end

# Helper — get the event from an update result.
def feed_event(t: ti::TextInput, code: Int): ti::TextInputEvent
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: code, modifiers: 0 })
  var triple = ti::text_input_update(t, msg)
  return triple.2
end

# Bool→Int conversion helper. Don't name `to_int` (intrinsic shadow!).
def _b2i(b: Bool): Int
  if b
    return 1
  end
  return 0
end

# ============================================================
# Insert
# ============================================================

def test_insert_ascii(): Void
  var t = ti::text_input_new()
  t = feed_char(t, 'a')
  t = feed_char(t, 'b')
  t = feed_char(t, 'c')
  assert_eq_str(ti::text_input_value(t), "abc")
  assert_eq(ti::text_input_cursor(t), 3)
end

def test_insert_event_is_changed(): Void
  var t = ti::text_input_new()
  var ev = feed_event(t, 'a')
  if ev is Changed
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_insert_multibyte(): Void
  # é (U+00E9) — 2 bytes, 1 codepoint
  var t = ti::text_input_new()
  t = feed_string(t, "café")
  assert_eq_str(ti::text_input_value(t), "café")
  assert_eq(ti::text_input_size(t), 4)
end

def test_insert_wide_cjk(): Void
  # 中 (U+4E2D) — 3 bytes, 1 codepoint, 2 cells
  var t = ti::text_input_new()
  t = feed_string(t, "中文")
  assert_eq_str(ti::text_input_value(t), "中文")
  assert_eq(ti::text_input_size(t), 2)
  assert_eq(ti::text_input_cursor(t), 2)
end

def test_insert_at_cursor_middle(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_LEFT())  # cursor=2
  t = feed_char(t, 'X')                   # insert at 2
  assert_eq_str(ti::text_input_value(t), "abXc")
  assert_eq(ti::text_input_cursor(t), 3)
end

# ============================================================
# Backspace
# ============================================================

def test_backspace_at_end(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_BACKSPACE())
  assert_eq_str(ti::text_input_value(t), "ab")
  assert_eq(ti::text_input_cursor(t), 2)
end

def test_backspace_at_start_is_noop(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_HOME())   # cursor=0
  t = feed_key(t, terminal::KEY_BACKSPACE())
  assert_eq_str(ti::text_input_value(t), "abc")
  assert_eq(ti::text_input_cursor(t), 0)
end

def test_backspace_multibyte(): Void
  # Backspace through é (2-byte codepoint) leaves "caf"
  var t = ti::text_input_new()
  t = feed_string(t, "café")
  t = feed_key(t, terminal::KEY_BACKSPACE())
  assert_eq_str(ti::text_input_value(t), "caf")
  assert_eq(ti::text_input_cursor(t), 3)
end

# ============================================================
# Forward delete
# ============================================================

def test_delete_at_cursor(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_HOME())
  t = feed_key(t, terminal::KEY_DELETE())  # delete 'a'
  assert_eq_str(ti::text_input_value(t), "bc")
  assert_eq(ti::text_input_cursor(t), 0)
end

def test_delete_at_end_is_noop(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_DELETE())
  assert_eq_str(ti::text_input_value(t), "abc")
end

# ============================================================
# Cursor movement
# ============================================================

def test_left_clamps_at_zero(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "ab")
  t = feed_key(t, terminal::KEY_LEFT())
  t = feed_key(t, terminal::KEY_LEFT())
  t = feed_key(t, terminal::KEY_LEFT())   # tries past 0
  assert_eq(ti::text_input_cursor(t), 0)
end

def test_right_clamps_at_size(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "ab")
  t = feed_key(t, terminal::KEY_RIGHT())  # already at end
  assert_eq(ti::text_input_cursor(t), 2)
end

def test_home_jumps_to_zero(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_HOME())
  assert_eq(ti::text_input_cursor(t), 0)
end

def test_end_jumps_to_size(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_HOME())
  t = feed_key(t, terminal::KEY_END())
  assert_eq(ti::text_input_cursor(t), 3)
end

def test_left_emits_event_none(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  var ev = feed_event(t, terminal::KEY_LEFT())
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# Word delete (Ctrl-W)
# ============================================================

def test_word_delete_simple(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "hello world")
  t = feed_key(t, terminal::KEY_CTRL_W())
  assert_eq_str(ti::text_input_value(t), "hello ")
  assert_eq(ti::text_input_cursor(t), 6)
end

def test_word_delete_trailing_spaces(): Void
  # "hello   " → ctrl-w → "" (consumes spaces + word)
  var t = ti::text_input_new()
  t = feed_string(t, "hello   ")
  t = feed_key(t, terminal::KEY_CTRL_W())
  assert_eq_str(ti::text_input_value(t), "")
  assert_eq(ti::text_input_cursor(t), 0)
end

def test_word_delete_at_start_is_noop(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "hello")
  t = feed_key(t, terminal::KEY_HOME())
  t = feed_key(t, terminal::KEY_CTRL_W())
  assert_eq_str(ti::text_input_value(t), "hello")
end

# ============================================================
# Delete to start (Ctrl-U)
# ============================================================

def test_ctrl_u_clears_to_start(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abcdef")
  t = feed_key(t, terminal::KEY_LEFT())
  t = feed_key(t, terminal::KEY_LEFT())
  t = feed_key(t, terminal::KEY_CTRL_U())
  assert_eq_str(ti::text_input_value(t), "ef")
  assert_eq(ti::text_input_cursor(t), 0)
end

# ============================================================
# Submit / validate
# ============================================================

def validator_min3(v: String): Option<String>
  if v.size < 3
    return Option::Some("at least 3 chars required")
  end
  return Option::None
end

def test_enter_emits_submitted_no_validator(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::Never)
  t = feed_string(t, "hi")
  var ev = feed_event(t, terminal::KEY_ENTER())
  if ev is Submitted
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_enter_on_submit_passes_validator(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::OnSubmit)
  t = feed_string(t, "hello")
  var ev = feed_event(t, terminal::KEY_ENTER())
  if ev is Submitted
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_enter_on_submit_fails_validator_emits_changed(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::OnSubmit)
  t = feed_string(t, "hi")
  var msg: tui::FrameMsg<SpecMsg> = tui::FrameMsg::Key(tui::KeyEvent { code: terminal::KEY_ENTER(), modifiers: 0 })
  var triple = ti::text_input_update(t, msg)
  var next = triple.0
  var ev = triple.2
  if ev is Changed
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  # last_error populated
  if ti::text_input_last_error(next) is Some
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_on_change_runs_validator_each_keypress(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::OnChange)
  t = feed_char(t, 'a')  # value="a" — fails validator
  if ti::text_input_last_error(t) is Some
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  t = feed_char(t, 'b')
  t = feed_char(t, 'c')  # value="abc" — passes
  if ti::text_input_last_error(t) is None
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_never_skips_validator(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::Never)
  t = feed_char(t, 'a')
  if ti::text_input_last_error(t) is None
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def test_on_blur_runs_validator(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::OnBlur)
  t = feed_char(t, 'a')
  # last_error should NOT be set yet (OnBlur, not OnChange)
  if ti::text_input_last_error(t) is None
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  var pair = ti::text_input_blur(t)
  var blurred = pair.0
  var ev = pair.1
  if ev is Blurred
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  if ti::text_input_last_error(blurred) is Some
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

# ============================================================
# max_length
# ============================================================

def test_max_length_drops_overflow_inserts(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_max_length(t, 3)
  t = feed_char(t, 'a')
  t = feed_char(t, 'b')
  t = feed_char(t, 'c')
  t = feed_char(t, 'd')   # dropped
  assert_eq_str(ti::text_input_value(t), "abc")
  assert_eq(ti::text_input_cursor(t), 3)
end

# ============================================================
# State setters
# ============================================================

def test_set_value_unchecked_clears_error(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_validator(t, validator_min3)
  t = ti::text_input_with_validate_on(t, ti::ValidateOn::OnChange)
  t = feed_char(t, 'x')   # last_error populated
  t = ti::text_input_set_value_unchecked(t, "preset")
  if ti::text_input_last_error(t) is None
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
  assert_eq_str(ti::text_input_value(t), "preset")
end

def test_clear_resets_all(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = ti::text_input_clear(t)
  assert_eq_str(ti::text_input_value(t), "")
  assert_eq(ti::text_input_cursor(t), 0)
end

# ============================================================
# View — placeholder vs focused vs cursor rendering
# ============================================================

def test_view_unfocused_empty_shows_placeholder(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_prompt(t, "> ")
  t = ti::text_input_with_placeholder(t, "type something")
  var view = ti::text_input_view(t, false)
  var stripped = ly::strip_styles(view)
  assert_eq_str(stripped, "> type something")
end

def test_view_focused_empty_shows_cursor_block(): Void
  # Focused + empty value: placeholder hidden, cursor block (space) shown.
  var t = ti::text_input_new()
  t = ti::text_input_with_placeholder(t, "type")
  var view = ti::text_input_view(t, true)
  var stripped = ly::strip_styles(view)
  assert_eq_str(stripped, " ")
end

def test_view_focused_with_value_shows_value(): Void
  var t = ti::text_input_new()
  t = ti::text_input_with_prompt(t, "> ")
  t = feed_string(t, "hello")
  # cursor is past "hello" → end-of-value cursor block (one space)
  var stripped = ly::strip_styles(ti::text_input_view(t, true))
  assert_eq_str(stripped, "> hello ")
end

def test_view_unfocused_with_value_shows_value_no_cursor(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "hello")
  var stripped = ly::strip_styles(ti::text_input_view(t, false))
  assert_eq_str(stripped, "hello")
end

def test_view_cursor_in_middle_shows_inline_block(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_LEFT())  # cursor=2
  var stripped = ly::strip_styles(ti::text_input_view(t, true))
  # "ab" + cursor-styled "c" → stripped is "abc"
  assert_eq_str(stripped, "abc")
end

# ============================================================
# Other keys are no-ops
# ============================================================

def test_tab_is_noop(): Void
  var t = ti::text_input_new()
  t = feed_string(t, "abc")
  t = feed_key(t, terminal::KEY_TAB())
  assert_eq_str(ti::text_input_value(t), "abc")
  var ev = feed_event(t, terminal::KEY_TAB())
  if ev is Idle
    assert_eq(1, 1)
  else
    assert_eq(0, 1)
  end
end

def main(): Int
  describe("insert") do ->
    it("inserts ASCII chars at cursor") do ->
      test_insert_ascii()
    end
    it("emits Changed event") do ->
      test_insert_event_is_changed()
    end
    it("handles multibyte codepoints") do ->
      test_insert_multibyte()
    end
    it("counts wide CJK as one cursor stop") do ->
      test_insert_wide_cjk()
    end
    it("inserts at cursor position, not always at end") do ->
      test_insert_at_cursor_middle()
    end
  end

  describe("backspace") do ->
    it("removes codepoint at end") do ->
      test_backspace_at_end()
    end
    it("at cursor 0 is no-op") do ->
      test_backspace_at_start_is_noop()
    end
    it("crosses multibyte boundaries cleanly") do ->
      test_backspace_multibyte()
    end
  end

  describe("forward delete") do ->
    it("removes codepoint at cursor") do ->
      test_delete_at_cursor()
    end
    it("at end-of-value is no-op") do ->
      test_delete_at_end_is_noop()
    end
  end

  describe("cursor movement") do ->
    it("Left clamps at 0") do ->
      test_left_clamps_at_zero()
    end
    it("Right clamps at size") do ->
      test_right_clamps_at_size()
    end
    it("Home jumps to 0") do ->
      test_home_jumps_to_zero()
    end
    it("End jumps to size") do ->
      test_end_jumps_to_size()
    end
    it("emits None event") do ->
      test_left_emits_event_none()
    end
  end

  describe("word delete (Ctrl-W)") do ->
    it("deletes the word before cursor") do ->
      test_word_delete_simple()
    end
    it("consumes trailing whitespace then a word") do ->
      test_word_delete_trailing_spaces()
    end
    it("at cursor 0 is no-op") do ->
      test_word_delete_at_start_is_noop()
    end
  end

  describe("delete to start (Ctrl-U)") do ->
    it("clears from cursor to start") do ->
      test_ctrl_u_clears_to_start()
    end
  end

  describe("submit / validate") do ->
    it("Enter emits Submitted with no validator") do ->
      test_enter_emits_submitted_no_validator()
    end
    it("Enter passes OnSubmit validator → Submitted") do ->
      test_enter_on_submit_passes_validator()
    end
    it("Enter fails OnSubmit validator → Changed + last_error") do ->
      test_enter_on_submit_fails_validator_emits_changed()
    end
    it("OnChange runs validator each keypress") do ->
      test_on_change_runs_validator_each_keypress()
    end
    it("Never skips validator") do ->
      test_never_skips_validator()
    end
    it("OnBlur runs validator on text_input_blur") do ->
      test_on_blur_runs_validator()
    end
  end

  describe("max_length") do ->
    it("drops overflow inserts silently") do ->
      test_max_length_drops_overflow_inserts()
    end
  end

  describe("state setters") do ->
    it("set_value_unchecked clears last_error") do ->
      test_set_value_unchecked_clears_error()
    end
    it("clear resets value + cursor") do ->
      test_clear_resets_all()
    end
  end

  describe("view") do ->
    it("unfocused + empty renders placeholder") do ->
      test_view_unfocused_empty_shows_placeholder()
    end
    it("focused + empty renders just cursor block") do ->
      test_view_focused_empty_shows_cursor_block()
    end
    it("focused + value renders value with end-cursor block") do ->
      test_view_focused_with_value_shows_value()
    end
    it("unfocused + value renders value without cursor") do ->
      test_view_unfocused_with_value_shows_value_no_cursor()
    end
    it("focused with cursor in middle renders inline cursor block") do ->
      test_view_cursor_in_middle_shows_inline_block()
    end
  end

  describe("other keys") do ->
    it("Tab is a no-op") do ->
      test_tab_is_noop()
    end
  end

  return qspec_main()
end
