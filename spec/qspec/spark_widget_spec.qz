## Smoke spec for std/tui/widgets/spark — validates construction,
## push semantics, scale resolution, and view rendering shape.

import * from qspec
import std/tui/widgets/spark as sp
import std/tui/octant as oc

def main(): Int
  describe("spark widget construction") do ->
    it("clamps width and height to >= 1") do ->
      var s = sp::spark_new(0, 0)
      assert_eq(s.width_cells,  1)
      assert_eq(s.height_cells, 1)
    end

    it("defaults capacity to width * 2 (subpixel density)") do ->
      var s = sp::spark_new(10, 2)
      assert_eq(s.capacity, 20)
    end

    it("starts empty and auto-scaled") do ->
      var s = sp::spark_new(8, 1)
      assert_eq(sp::spark_size(s), 0)
      assert_eq(s.auto_scale, true)
    end
  end

  describe("spark push semantics") do ->
    it("retains all samples below capacity") do ->
      var s = sp::spark_new(4, 1)
      s = sp::spark_push(s, 10)
      s = sp::spark_push(s, 20)
      s = sp::spark_push(s, 30)
      assert_eq(sp::spark_size(s), 3)
      assert_eq(sp::spark_latest_or(s, -1), 30)
    end

    it("drops oldest at capacity") do ->
      var s = sp::spark_with_capacity(sp::spark_new(4, 1), 3)
      s = sp::spark_push(s, 1)
      s = sp::spark_push(s, 2)
      s = sp::spark_push(s, 3)
      s = sp::spark_push(s, 4)
      assert_eq(sp::spark_size(s), 3)
      assert_eq(sp::spark_min(s), 2)
      assert_eq(sp::spark_max(s), 4)
    end

    it("clears keeps configuration") do ->
      var s = sp::spark_with_range(sp::spark_new(8, 2), 0, 100)
      s = sp::spark_push(s, 50)
      var c = sp::spark_clear(s)
      assert_eq(sp::spark_size(c), 0)
      assert_eq(c.fixed_max, 100)
      assert_eq(c.auto_scale, false)
    end
  end

  describe("spark view rendering") do ->
    it("returns height_cells lines (line count)") do ->
      var s = sp::spark_new(4, 2)
      s = sp::spark_push(s, 50)
      var v = sp::spark_view(s)
      # Two height_cells → exactly one \n separator
      var nl = 0
      var i = 0
      while i < v.size
        if v[i] == 10  # '\n'
          nl += 1
        end
        i += 1
      end
      assert_eq(nl, 1)
    end

    it("empty buffer renders all-spaces") do ->
      var s = sp::spark_new(3, 1)
      var v = sp::spark_view(s)
      # ASCII quality forced — "   " (3 spaces)
      var ascii = sp::spark_with_quality(s, oc::OctantQuality::Ascii)
      var av = sp::spark_view(ascii)
      assert_eq_str(av, "   ")
    end

    it("chunky-capacity ascii fills every cell") do ->
      # capacity == width_cells → 1 sample per cell (both pixel cols
      # of each cell stamped). 3 samples in 3 cells → all '#'.
      var s = sp::spark_with_capacity(sp::spark_new(3, 1), 3)
      s = sp::spark_with_range(s, 0, 100)
      s = sp::spark_with_quality(s, oc::OctantQuality::Ascii)
      s = sp::spark_push(s, 50)
      s = sp::spark_push(s, 75)
      s = sp::spark_push(s, 100)
      assert_eq_str(sp::spark_view(s), "###")
    end

    it("default-capacity (subpixel) right-aligns when partial") do ->
      # capacity = width * 2 = 6, count = 3 → only rightmost 3 pixel
      # columns filled. Cells span (px 0,1) (px 2,3) (px 4,5):
      # cell 0 empty, cell 1 has px 3 lit, cell 2 has px 4,5 lit.
      var s = sp::spark_new(3, 1)
      s = sp::spark_with_range(s, 0, 100)
      s = sp::spark_with_quality(s, oc::OctantQuality::Ascii)
      s = sp::spark_push(s, 50)
      s = sp::spark_push(s, 75)
      s = sp::spark_push(s, 100)
      assert_eq_str(sp::spark_view(s), " ##")
    end

    it("range pinning disables auto-scale") do ->
      var s = sp::spark_with_range(sp::spark_new(4, 1), 0, 200)
      assert_eq(s.auto_scale, false)
      assert_eq(s.fixed_min, 0)
      assert_eq(s.fixed_max, 200)
    end
  end

  describe("spark_percentile") do ->
    it("returns 0 for empty buffer") do ->
      var s = sp::spark_new(4, 1)
      assert_eq(sp::spark_percentile(s, 50), 0)
    end

    it("p50 of [10,20,30,40,50] = 30") do ->
      var s = sp::spark_new(8, 1)
      s = sp::spark_push(s, 10)
      s = sp::spark_push(s, 20)
      s = sp::spark_push(s, 30)
      s = sp::spark_push(s, 40)
      s = sp::spark_push(s, 50)
      assert_eq(sp::spark_percentile(s, 50), 30)
    end

    it("p95 of [1..100] = 95 (idx-floor convention)") do ->
      var s = sp::spark_with_capacity(sp::spark_new(50, 1), 100)
      var i = 1
      while i <= 100
        s = sp::spark_push(s, i)
        i += 1
      end
      # idx = 95 * (100-1) / 100 = 9405/100 = 94, values[94] = 95
      assert_eq(sp::spark_percentile(s, 95), 95)
    end

    it("clamps p to [0,100]") do ->
      var s = sp::spark_push(sp::spark_new(4, 1), 42)
      assert_eq(sp::spark_percentile(s, 200), 42)
      assert_eq(sp::spark_percentile(s, -10), 42)
    end
  end

  return qspec_main()
end
