## Nested Generics Tests
##
## Contract:
##   1. CPtr<Vec<Int>>: nested generic in function parameters.
##   2. Three levels: `Vec<Vec<Vec<Int>>>` parses.
##   3. Declaration: `Vec<Vec<Int>>` in var.
##   4. Push/get: nested Vec with operations.
##   5. Parameter: `Vec<Vec<Int>>` as parameter type.
##   6. Return type: `Vec<Vec<Int>>` as return type.
##   7. Multiple rows: push multiple inner vecs.
##   8. Nested size: size of outer vec with nested inner.
import * from qspec

def main(): Int
  describe("nested generics") do ->
    it("parses Vec<Vec<Int>> in var declarations") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      assert_eq(outer.size, 0)
    end
    it("uses nested Vec with push and get") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var inner: Vec<Int> = vec_new()
      inner.push(10)
      inner.push(20)
      outer.push(inner)
      row = outer[0]
      assert_eq(row[1], 20)
    end
    it("parses three levels Vec<Vec<Vec<Int>>>") do ->
      var deep: Vec<Vec<Vec<Int>>> = vec_new()
      assert_eq(deep.size, 0)
    end
    it("CPtr<Vec<Int>> in function parameters") do ->
      assert_eq(ng_cptr_test(), 42)
    end
    it("Vec<Vec<Int>> as parameter type") do ->
      var m: Vec<Vec<Int>> = vec_new()
      assert_eq(ng_count_rows(m), 0)
    end
    it("Vec<Vec<Int>> as return type") do ->
      m = ng_make_matrix()
      assert_eq(m.size, 0)
    end
    it("push multiple inner vecs and access") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      var row1: Vec<Int> = vec_new()
      row1.push(10)
      var row2: Vec<Int> = vec_new()
      row2.push(20)
      outer.push(row1)
      outer.push(row2)
      r2 = outer[1]
      assert_eq(r2[0], 20)
    end
    it("nested vec outer size reflects pushes") do ->
      var outer: Vec<Vec<Int>> = vec_new()
      outer.push(vec_new())
      outer.push(vec_new())
      outer.push(vec_new())
      assert_eq(outer.size, 3)
    end
  end
  return qspec_main()
end
def ng_process_cptr(p: CPtr<Vec<Int>>): Int = 42
def ng_cptr_test(): Int = 42
def ng_count_rows(matrix: Vec<Vec<Int>>): Int = matrix.size
def ng_make_matrix(): Vec<Vec<Int>> = vec_new()
