import * from qspec

# ============================================================================
# Backpressure Protocol — Phase 12
#
# TOCTOU-free, compiler-integrated backpressure intrinsics.
# channel_pressure (0-100), channel_remaining, try_send_pressure (-1 or 0-100).
# ============================================================================

def test_empty_pressure(): Int
  var ch = channel_new(10)
  var pr = channel_pressure(ch)
  var rm = channel_remaining(ch)
  # channel_new(10) rounds up to capacity=16
  if pr == 0 and rm == 16
    return 1
  end
  return 0
end

def test_half_full(): Int
  var ch = channel_new(10)
  for i in 0..5
    send(ch, i)
  end
  var pr = channel_pressure(ch)
  var rm = channel_remaining(ch)
  # capacity=16, 5 items: pressure=5*100/16=31, remaining=16-5=11
  if pr == 31 and rm == 11
    return 1
  end
  return 0
end

def test_full_channel(): Int
  var ch = channel_new(10)
  for i in 0..16
    send(ch, i)
  end
  var pr = channel_pressure(ch)
  var rm = channel_remaining(ch)
  # capacity=16, 16 items: pressure=100, remaining=0
  if pr == 100 and rm == 0
    return 1
  end
  return 0
end

def test_try_send_pressure_full(): Int
  var ch = channel_new(5)
  # channel_new(5) rounds up to capacity=8, fill all 8 slots
  for i in 0..8
    send(ch, i)
  end
  var result = try_send_pressure(ch, 99)
  if result == -1
    return 1
  end
  return 0
end

def test_try_send_pressure_success(): Int
  var ch = channel_new(10)
  for i in 0..7
    send(ch, i)
  end
  # capacity=16, 7 items. After sending one more: 8/16*100=50
  var result = try_send_pressure(ch, 42)
  if result == 50
    return 1
  end
  return 0
end

def test_monotonic_increase(): Int
  var ch = channel_new(10)
  var prev = 0
  for i in 0..10
    send(ch, i)
    var pr = channel_pressure(ch)
    if pr < prev
      return 0
    end
    prev = pr
  end
  return 1
end

def test_pressure_decreases_after_recv(): Int
  var ch = channel_new(10)
  # capacity=16, fill completely
  for i in 0..16
    send(ch, i)
  end
  var pr_full = channel_pressure(ch)
  recv(ch)
  recv(ch)
  recv(ch)
  var pr_after = channel_pressure(ch)
  # 16/16=100, then recv 3 → 13/16*100=81
  if pr_full == 100 and pr_after == 81
    return 1
  end
  return 0
end

def main(): Int
  describe("backpressure protocol") do ->
    it("empty channel: pressure=0, remaining=16") do ->
      assert_eq(test_empty_pressure(), 1)
    end

    it("5 items in cap-16: pressure=31, remaining=11") do ->
      assert_eq(test_half_full(), 1)
    end

    it("full channel: pressure=100, remaining=0") do ->
      assert_eq(test_full_channel(), 1)
    end

    it("try_send_pressure on full cap-8: returns -1") do ->
      assert_eq(test_try_send_pressure_full(), 1)
    end

    it("try_send_pressure on 7/16: returns 50 after send") do ->
      assert_eq(test_try_send_pressure_success(), 1)
    end

    it("pressure increases monotonically as items added") do ->
      assert_eq(test_monotonic_increase(), 1)
    end

    it("pressure decreases after recv: 100 -> 81") do ->
      assert_eq(test_pressure_decreases_after_recv(), 1)
    end
  end

  return qspec_main()
end
