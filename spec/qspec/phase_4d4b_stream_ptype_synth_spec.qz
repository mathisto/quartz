## Phase 4D.4b — Stream<T, body_row> ptype synthesis (substrate).
##
## Verifies that `tc_function` upgrades a generator function's registered
## return type from the bare `TYPE_STRUCT` sentinel that the parser
## produces for `impl Trait<...>` annotations to a synthesized
## `Stream<T, body_row>` ptype carrying the body's effect row. The
## synthesis is purely substrate at this phase — consumer wiring (Stream.next
## call-site row binding, F.3c folding) lands in 4D.4c. The tests below
## are regression guards: every existing surface form must continue to
## compile + run unchanged. The synthesis is queryable via
## `tc_get_func_return_type` but does not yet drive caller widening.
##
## What this pins down (regression):
##
##   1. Pure `def gen(): impl Iterator<Int>` still returns a Stream<T> at
##      runtime; .next() round-trips Some(v) ... None.
##   2. The same generator is still consumable via `for v in gen()`.
##   3. `def gen(): impl AsyncIterator<Int>` still routes through the
##      async-gen MIR path (`lower_async_gen_iteration`); for-await
##      iteration produces the yielded values.
##   4. The 4D.3 row-poly form `def gen(): impl Iterator<Int> can Async`
##      still typechecks + lowers without duplicate `__Future_*$poll`.
##   5. Generator-from-generator composition still works (synthesized
##      Stream-typed return doesn't trip the inner `for v in inner()`
##      loop).
##
## Out of scope (covered by 4D.4c+):
##
##   - Caller-row widening via Stream.next's `can e`. Today, calling
##     .next() on an async-typed Stream from a pure caller does NOT emit
##     QZ0610 — the synthesized body_row is not yet bound to Stream.next's
##     fresh `e` erv at the call site. 4D.4c wires the binding.
##   - Async-gen constructor wrapping in Stream<T> (4D.5b — needed before
##     direct `.next()` on async generators is sound at runtime).
##   - F.3c typecheck deletion (4D.4d, after .next() routing covers the
##     for-in case).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.4b — Stream<T, body_row> ptype synthesis") do ->
    it("pure impl Iterator<T> still drives .next() Some/None round-trip") do ->
      assert_run_stdout_eq("""
def three(): impl Iterator<Int>
  yield 10
  yield 20
  yield 30
end

def main(): Int
  var s = three()
  var a = s.next()
  var b = s.next()
  var c = s.next()
  var d = s.next()
  if a is Some
    puts(str_from_int(a.unwrap()))
  end
  if b is Some
    puts(str_from_int(b.unwrap()))
  end
  if c is Some
    puts(str_from_int(c.unwrap()))
  end
  if d is None
    puts("done")
  end
  return 0
end
""", "10\n20\n30\ndone\n")
    end

    it("pure impl Iterator<T> still drives for-in") do ->
      assert_run_stdout_eq("""
def evens(): impl Iterator<Int>
  yield 2
  yield 4
  yield 6
end

def main(): Int
  var total = 0
  for x in evens()
    total += x
  end
  puts(str_from_int(total))
  return 0
end
""", "12\n")
    end

    it("explicit impl AsyncIterator<T> still routes through async-gen MIR path") do ->
      # Async generator consumed via for-await — uses lower_async_gen_iteration
      # (frame[1] reader). Synthesis added Stream<Int, {Async}> as the registered
      # return type but doesn't change MIR dispatch for this surface form.
      assert_run_stdout_eq("""
def async_pair(): impl AsyncIterator<Int>
  yield 100
  yield 200
end

def main(): Int
  for await v in async_pair()
    puts(str_from_int(v))
  end
  return 0
end
""", "100\n200\n")
    end

    it("4D.3 row-poly form `impl Iterator<T> can Async` still typechecks + lowers") do ->
      # The synthesis fires on this form too (body_row carries Async), but at
      # this slice the synthesized ptype isn't yet consumed; the str2 stamp
      # rewrite from 4D.3 still drives MIR dispatch identically to the
      # explicit AsyncIterator form. No duplicate __Future_*$poll.
      assert_run_stdout_eq("""
def async_one(): impl Iterator<Int> can Async
  yield 7
end

def main(): Int
  puts("compiled")
  return 0
end
""", "compiled\n")
    end

    it("generator-from-generator composition still works") do ->
      # A generator's body iterates another generator via for-in — the synthesized
      # Stream-typed return on the inner generator must not perturb the for-in
      # lowering or the outer generator's state-machine.
      assert_run_stdout_eq("""
def inner(): impl Iterator<Int>
  yield 1
  yield 2
end

def outer(): impl Iterator<Int>
  for x in inner()
    yield x * 10
  end
  yield 99
end

def main(): Int
  for y in outer()
    puts(str_from_int(y))
  end
  return 0
end
""", "10\n20\n99\n")
    end
  end

  return qspec_main()
end
