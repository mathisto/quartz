## Lint Safety & Dead Code Rule Tests (Phase 5)
##
## Tests QZ7301 (unreachable code), QZ7302 (empty match arm),
## QZ7401 (unused param), QZ7402 (empty block), QZ7403 (constant condition).

import * from qspec
import * from qspec/subprocess

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint safety (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("QZ7301: Unreachable code") do ->

    it("detects code after return") do ->
      src = "def main(): Int\n  return 0\n  puts(\"hi\")\n  return 1\nend\n"
      assert_lint_warns(src, "QZ7301")
    end

    it("no warning when return is last") do ->
      src = "def main(): Int\n  puts(\"hi\")\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7301")
        _record_failure("QZ7301 should not fire when return is last stmt")
      end
    end

    it("detects code after break in loop") do ->
      src = "def main(): Int\n  while true\n    break\n    puts(\"unreachable\")\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7301")
    end

    it("detects unreachable in if branch") do ->
      src = "def main(): Int\n  if true\n    return 1\n    puts(\"dead\")\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7301")
    end
  end

  describe("QZ7401: Unused parameter") do ->

    it("detects unused parameter") do ->
      src = "def foo(x: Int, y: Int): Int\n  return x\nend\n"
      assert_lint_warns(src, "QZ7401")
    end

    it("no warning when all params used") do ->
      src = "def add(a: Int, b: Int): Int\n  return a + b\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7401")
        _record_failure("QZ7401 should not fire when all params used")
      end
    end

    it("ignores _prefixed params") do ->
      src = "def foo(_x: Int): Int\n  return 42\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7401")
        _record_failure("QZ7401 should not fire on _prefixed param")
      end
    end

    it("ignores self param") do ->
      src = "def foo(self: Int): Int\n  return 42\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7401")
        _record_failure("QZ7401 should not fire on self param")
      end
    end
  end

  describe("QZ7402: Empty block body") do ->

    it("detects empty if body") do ->
      src = "def main(): Int\n  if true\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7402")
    end

    it("detects empty while body") do ->
      src = "def main(): Int\n  while false\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7402")
    end

    it("no warning with non-empty body") do ->
      src = "def main(): Int\n  if true\n    return 1\n  end\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7402")
        _record_failure("QZ7402 should not fire on non-empty body")
      end
    end
  end

  describe("QZ7403: Constant condition") do ->

    it("detects while true") do ->
      src = "def main(): Int\n  while true\n    break\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7403")
    end

    it("detects if true") do ->
      src = "def main(): Int\n  if true\n    return 1\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7403")
    end

    it("detects if false") do ->
      src = "def main(): Int\n  if false\n    return 1\n  end\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7403")
    end

    it("no warning for variable condition") do ->
      src = "def foo(x: Bool): Int\n  if x\n    return 1\n  end\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7403")
        _record_failure("QZ7403 should not fire on variable condition")
      end
    end
  end

  return qspec_main()
end
