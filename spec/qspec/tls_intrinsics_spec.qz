## TLS Intrinsics Tests (EPIC SYS.1 item 7)
##
## Contract:
##   1. `tls_read_gs(offset)` emits a load from `ptr addrspace(256)`
##      at the given offset. On x86_64, LLVM lowers this to a
##      `%gs:offset` segment-prefixed `movq`. Used by kernels for
##      per-CPU variable access.
##   2. `tls_read_fs(offset)` does the same with `addrspace(257)` /
##      `%fs:offset`. Used for userspace TLS on x86_64 ELF.
##   3. `tls_write_gs(offset, val)` / `tls_write_fs(offset, val)`
##      emit the corresponding `store` with the same address spaces.
##      Return Void — a dummy i64 result is still allocated because
##      Quartz's intrinsic dispatch always produces an SSA value.
##   4. All four intrinsics operate on i64-sized slots. Narrower
##      (u8/u16/u32) accesses would need additional intrinsics; not
##      in this slice.
##
## NOTE: Quartz targets arm64 natively on this host, so the emitted
## `addrspace(256/257)` pointers won't produce x86 segment prefixes
## here — LLVM's arm64 backend will either treat them as generic
## pointers or emit a selector error. That's fine: this slice ships
## the IR emission, and the actual `%gs`/`%fs` lowering happens when
## the program is compiled against an x86_64 triple. The IR-level
## assertions in this spec are cross-target.
import * from qspec

def main(): Int
  describe("x86 TLS intrinsics (SYS.1 item 7)") do ->
    it("tls_read_gs emits load from addrspace(256)") do ->
      assert_ir_contains("""
def main(): Int
  var v = tls_read_gs(0)
  return v
end
""", "load i64, ptr addrspace(256)")
    end

    it("tls_read_fs emits load from addrspace(257)") do ->
      assert_ir_contains("""
def main(): Int
  var v = tls_read_fs(0)
  return v
end
""", "load i64, ptr addrspace(257)")
    end

    it("tls_write_gs emits store to addrspace(256)") do ->
      assert_ir_contains("""
def main(): Int
  tls_write_gs(0, 42)
  return 0
end
""", "store i64 %v")
    end

    it("tls_write_gs uses addrspace(256) for the store pointer") do ->
      assert_ir_contains("""
def main(): Int
  tls_write_gs(0, 42)
  return 0
end
""", "ptr addrspace(256)")
    end

    it("tls_write_fs uses addrspace(257) for the store pointer") do ->
      assert_ir_contains("""
def main(): Int
  tls_write_fs(0, 42)
  return 0
end
""", "ptr addrspace(257)")
    end

    it("tls_read_gs and tls_read_fs use distinct address spaces") do ->
      # Regression check — swap in codegen would silently compile
      # but emit the wrong segment prefix. Verify gs path does NOT
      # contain addrspace(257).
      assert_ir_not_contains("""
def main(): Int
  var v = tls_read_gs(0)
  return v
end
""", "addrspace(257)")
    end
  end

  return qspec_main()
end
