## IMPL-TRAIT-RPITIT bounded-generic dispatch.
##
## Closes the last hole in the impl-Trait sprint. Phase 11 RPITIT shipped
## per-impl concrete-return tracking for trait methods declared as `def
## m(self): impl OtherTrait`, with direct-receiver dispatch routing through
## the impl-specific concrete via the impl-return registry.
##
## Bounded-generic dispatch was filed BLOCKED on `NESTED-MONO-UFCS-TYPE-PARAM`
## (closed Apr 13). Re-checking the bounded-generic path post-fix exposed a
## SEPARATE bug in the let-init type tracker:
##
##   def sum_until_neg<C: RpIterable>(c: C): Int
##     var it = c.iter()    # A8 emits AMyList$iter(c) correctly...
##     var n = it.next()    # ...but `it`'s tracked type was AStackIter
##                          # (alphabetically-first $iter in all_funcs),
##                          # so it.next() dispatched to AStackIter$next.
##   end
##
## Root cause: `mir_lower_stmt_handlers.qz` NODE_LET path resolved the
## init's call function via `mir_resolve_func_name(call_func_name)`, which
## suffix-matches `$iter` against all_funcs and returns the alphabetically-
## first hit. The emit path (A8 in `mir_lower_expr_handlers.qz`) correctly
## consults the receiver's spec_param_type / var_type for receiver-aware
## dispatch — but the type-tracker didn't, so the two diverged.
##
## Fix: new helper `mir_resolve_method_call_receiver_aware` mirrors A8's
## receiver lookup. The let-init path tries it first; falls back to bare
## resolution when not in a spec body or when no Type$method is registered.
##
## What this spec exercises: a multi-impl trait with two concrete impls
## (`AMyStack`/`AStackIter` returning values directly; `AMyList`/`AListIter`
## returning values *2 — distinguishable). A bounded-generic consumer
## `sum_until_neg<C: RpIterable>` is called with both. Each call must
## dispatch through ITS OWN impl's `iter().next()` chain, summing
## different totals.
##
## NOTE: extend-method bodies must NOT include an explicit `self` param
## here — the resolver auto-injects it. Writing `def next(self): Int`
## inside `extend AStackIter` causes the resolver to inject a SECOND
## self, producing arity-2 methods that fail with QZ0200 at call sites.

import * from qspec

trait RpIter
  def next(self): Int
end

trait RpIterable
  def iter(self): impl RpIter
end

# === Two concrete iters (distinguishable behavior) ===

struct AStackIter
  values: Vec<Int>
  cur: Int
end

extend AStackIter
  def next(&mut self): Int
    if @cur >= @values.size
      return -1
    end
    var v = @values[@cur]
    @cur = @cur + 1
    return v
  end
end

extend AStackIter with RpIter end

struct AListIter
  values: Vec<Int>
  cur: Int
end

extend AListIter
  def next(&mut self): Int
    if @cur >= @values.size
      return -1
    end
    # Distinguishable: ListIter doubles each value.
    var v = @values[@cur] * 2
    @cur = @cur + 1
    return v
  end
end

extend AListIter with RpIter end

# === Two collections that satisfy RpIterable ===

struct AMyStack
  v: Vec<Int>
end

extend AMyStack
  def iter(): AStackIter
    return AStackIter { values: @v, cur: 0 }
  end
end

extend AMyStack with RpIterable end

struct AMyList
  v: Vec<Int>
end

extend AMyList
  def iter(): AListIter
    return AListIter { values: @v, cur: 0 }
  end
end

extend AMyList with RpIterable end

# === The bounded-generic consumer ===

def sum_until_neg<C: RpIterable>(c: C): Int
  var it = c.iter()
  var total = 0
  loop
    var n = it.next()
    if n < 0
      break
    end
    total = total + n
  end
  return total
end

def test_stack_dispatch(): Void
  var s = AMyStack { v: vec_new<Int>() }
  s.v.push(10)
  s.v.push(20)
  s.v.push(30)
  # AStackIter returns values directly: 10 + 20 + 30 = 60.
  assert_eq(sum_until_neg(s), 60)
end

def test_list_dispatch(): Void
  var l = AMyList { v: vec_new<Int>() }
  l.v.push(1)
  l.v.push(2)
  l.v.push(3)
  l.v.push(4)
  # AListIter doubles each value: 2 + 4 + 6 + 8 = 20. Pre-fix, this
  # returned 10 (1+2+3+4) because it.next() dispatched to AStackIter$next.
  assert_eq(sum_until_neg(l), 20)
end

def test_both_in_same_program(): Void
  # The two monomorphizations of sum_until_neg coexist; neither
  # poisons the other's dispatch.
  var s = AMyStack { v: vec_new<Int>() }
  s.v.push(5)
  s.v.push(7)
  var l = AMyList { v: vec_new<Int>() }
  l.v.push(3)
  l.v.push(11)
  assert_eq(sum_until_neg(s), 12)   # 5 + 7 = 12 (StackIter)
  assert_eq(sum_until_neg(l), 28)   # 6 + 22 = 28 (ListIter doubles)
end

def main(): Int
  describe("IMPL-TRAIT-RPITIT bounded-generic dispatch") do ->
    it("sum_until_neg<C: RpIterable> dispatches through AMyStack's StackIter") do ->
      test_stack_dispatch()
    end

    it("sum_until_neg<C: RpIterable> dispatches through AMyList's ListIter") do ->
      test_list_dispatch()
    end

    it("two monomorphizations coexist without cross-talk") do ->
      test_both_in_same_program()
    end
  end
  return qspec_main()
end
