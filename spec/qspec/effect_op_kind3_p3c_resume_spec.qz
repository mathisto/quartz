## Effect `resume(v)` runtime kind dispatch — P3.0c-resume acceptance.
##
## Operation Piezoelectric Effects, Phase 3, Milestone P3.0 (chunk
## P3.0c-resume). Builds on P3.0a (TLS install_idx + resumed array),
## P3.0b (classifier kind=3 tag), P3.0c-runtime (perform stashes kind
## into TLS).
##
## What this locks in:
##
##   - Every `resume(v)` in a user handler body compiles to a runtime
##     branch on @__qz_effect_current_kind (via the helper
##     @__qz_effect_get_current_kind).
##   - kind<3 → ret i64 %v  (F.3a early return from handler).
##   - kind=3 → tail call @__qz_effect_resume_cont(i64 %v); ret i64 %body_rv
##     (kind=3 continuation dispatch — next chunk P3.0c-perform wires
##      up the caller-side frame-capture so this path becomes fully
##      end-to-end live).
##
## Behavioral invariant (verified at runtime): existing kind=2 ops
## (Throws.throw etc.) continue to unwind correctly — the runtime-
## dispatched branch into `resume_ret` falls through to `ret i64 %v`
## which matches the pre-P3.0c codegen byte-for-byte in its effect.
## All 28 pre-P3.0c effect specs regression-green.
##
## What this does NOT cover (P3.0c-perform scope):
##
##   - kind=3 continuation actually running. That needs caller-side
##     $poll lowering + cont_frame capture. Until P3.0c-perform ships,
##     @__qz_effect_resume_cont reads an undefined TLS/bufs slot on
##     kind=3 dispatch; the classifier promotes user op bodies to
##     kind=3 but invocations of those ops don't yet resolve to real
##     continuation invocation. P3.0c-spec (the end-to-end spec) lands
##     alongside P3.0c-perform.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect resume(v) runtime kind dispatch (piezo P3.0c-resume)") do ->
    it("IR calls @__qz_effect_get_current_kind at every resume site") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "call i64 @__qz_effect_get_current_kind()")
    end

    it("IR branches between resume_cont and resume_ret") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "br i1")
    end

    it("IR emits a resume_ret block terminating in ret i64") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "resume_ret")
    end

    it("IR emits a resume_cont block calling __qz_effect_resume_cont") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "call i64 @__qz_effect_resume_cont")
    end

    it("IR defines the __qz_effect_resume_cont runtime helper") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "@__qz_effect_resume_cont(i64 %v)")
    end

    it("IR defines the __qz_effect_get_current_kind runtime helper") do ->
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "@__qz_effect_get_current_kind()")
    end

    it("__qz_effect_resume_cont reads cont_frame from TLS (P3.0c-resume-guard)") do ->
      # The helper's body — TLS-sourced caller-frame pointer. Null
      # guard short-circuits to `ret %v` when no caller has captured
      # a frame (non-$poll caller OR P3.0c-perform not yet wired).
      # On kind=3 invocation from a $poll caller that DOES store
      # cont_frame, the helper reads frame[2] for poll_fn and invokes
      # the continuation.
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "@__qz_effect_current_cont_frame")
    end

    it("__qz_effect_resume_cont null-guards against missing cont_frame") do ->
      # Ensures the helper emits the fallback path. Without this
      # guard, a kind=3 handler invoked when no $poll caller has
      # populated cont_frame would segfault dereferencing a 0-ptr as
      # frame. The fallback returns %v (F.3a semantics), making the
      # classifier's kind=3 tag safe even without P3.0c-perform.
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "icmp eq i64 %cont_i64, 0")
    end

    it("__qz_effect_resume_cont sets stack_resumed to 1") do ->
      # The resumed flag is the P3.0a signal that P3.0c-perform's
      # with-block teardown will read to decide "body's return wins"
      # (resumed==1) vs "handler's return wins" (resumed==0).
      assert_ir_contains("""
effect E
  def op(x: Int): Int
end

def h(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with E { op: h } do ->
    op(7)
  end
  return 0
end
""", "@__qz_effect_stack_resumed")
    end

    it("kind=2 behavior unchanged: existing throw/unwind handlers still work") do ->
      # Regression guard: the new runtime-dispatched branch at the
      # resume site MUST NOT change observable behavior for kind=2
      # ops. At runtime, kind=2 < 3 so the branch falls into
      # resume_ret which does `ret i64 %v` — identical to pre-P3.0c.
      assert_run_stdout_eq("""
effect Throws
  def throw(msg: Int): Int
end

def my_throw(op_name: Int, argc: Int, argv: Int): Int
  resume(99)
end

def main(): Int
  with Throws { throw: my_throw } do ->
    puts(str_from_int(throw(1)))
  end
  return 0
end
""", "99\n")
    end

    it("kind<3 resume value is still observable at the op call site") do ->
      # Two handlers — one with `return v`, one with `resume(v)`.
      # Identical output proves the new branch hits `resume_ret` at
      # runtime for kind<3 handlers (the common case today).
      assert_run_stdout_eq("""
effect Echo
  def echo(x: Int): Int
end

def h_return(op_name: Int, argc: Int, argv: Int): Int
  return load(argv, 0) + 1
end

def h_resume(op_name: Int, argc: Int, argv: Int): Int
  resume(load(argv, 0) + 1)
end

def main(): Int
  with Echo { echo: h_return } do ->
    puts(str_from_int(echo(10)))
  end
  with Echo { echo: h_resume } do ->
    puts(str_from_int(echo(10)))
  end
  return 0
end
""", "11\n11\n")
    end

    it("kind=3 handler from a non-$poll caller safely returns resume value") do ->
      # Classifier tags `pause` as kind=3 (resume not at tail); user
      # handler calls `resume(77)` expecting the caller's continuation
      # to run. Since main() isn't $poll-lowered, TLS cont_frame is 0.
      # The null guard in __qz_effect_resume_cont kicks in, returning
      # %v to the handler, which then falls through to its own body.
      # Behavior matches kind<3 (F.3a early return): op() yields 77.
      assert_run_stdout_eq("""
effect Yieldy
  def pause(): Int
    do_nothing()
    resume(0)
    return 0
  end
end

def do_nothing(): Int = 0

def my_pause(op_name: Int, argc: Int, argv: Int): Int
  resume(77)
  return 99
end

def main(): Int
  var r = with Yieldy { pause: my_pause } do ->
    pause()
  end
  puts(str_from_int(r))
  return 0
end
""", "77\n")
    end

    # kind=3 continuation firing is tested end-to-end in
    # effect_op_kind3_p3c_perform_spec.qz (P3.0c-perform — shipped).
  end
  return qspec_main()
end
