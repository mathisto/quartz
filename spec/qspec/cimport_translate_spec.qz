## @cImport clang-JSON → Quartz-source translator (B.11b, P3.6a).
##
## Unit tests for the PURE translator (no clang, no I/O): canned clang
## AST-dump JSON → parsed JsonValue → cimport_translate → assert the emitted
## Quartz source. Cache-independent (no compiler binary A/B), so immune to the
## cache-ro golden-fooling class of flakiness.
##
## Contract:
##   1. Named-tag struct (struct Tag / typedef struct Tag {} Tag) → @repr(C).
##   2. C scalar/pointer types map to the right Quartz C-FFI types.
##   3. Functions → extern "C" def with mapped return + param types.
##   4. Struct-by-value params/returns reference the @repr(C) mirror by name.
##   5. Implicit builtins are skipped; decls from other files are filtered out
##      (loc.file carry-forward).
##   6. Unsupported field/return/param types and variadics are surfaced as
##      `# cimport:` comments, never silently emitted.

import * from qspec
import * from json
import * from cimport_gen

# Substring containment as Int (qspec asserts on Int).
def has(hay: String, needle: String): Int
  if __str_contains(hay, needle)
    return 1
  end
  return 0
end

# Canonical header: two structs (typedef'd-tag + plain-tag), four functions,
# one implicit builtin, one decl from another file (must be filtered).
def canon_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"__int128_t\", \"isImplicit\": true, \"loc\": {}, \"type\": {\"qualType\": \"__int128\"} },"
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Point\", \"tagUsed\": \"struct\", \"loc\": {\"file\": \"probe.h\"}, \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"x\", \"type\": {\"qualType\": \"int\"}},"
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"y\", \"type\": {\"qualType\": \"int\"}} ] },"
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Vec2f\", \"tagUsed\": \"struct\", \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"fx\", \"type\": {\"qualType\": \"float\"}},"
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"fy\", \"type\": {\"qualType\": \"float\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"add\", \"type\": {\"qualType\": \"int (int, int)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"a\", \"type\": {\"qualType\": \"int\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"b\", \"type\": {\"qualType\": \"int\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"make_point\", \"type\": {\"qualType\": \"Point (int, int)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"x\", \"type\": {\"qualType\": \"int\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"y\", \"type\": {\"qualType\": \"int\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"vadd\", \"type\": {\"qualType\": \"struct Vec2f (struct Vec2f, struct Vec2f)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"a\", \"type\": {\"qualType\": \"struct Vec2f\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"b\", \"type\": {\"qualType\": \"struct Vec2f\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"noop\", \"type\": {\"qualType\": \"void (void)\"} },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"elsewhere\", \"loc\": {\"file\": \"other.h\"}, \"type\": {\"qualType\": \"int (void)\"} }"
  s = s + "] }"
  return s
end

def tr_canon(): String
  return cimport_translate(json_parse_or_null(canon_json()), "probe.h")
end

# Header exercising the type map across scalar widths + pointers.
def types_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"widths\", \"loc\": {\"file\": \"t.h\"}, \"type\": {\"qualType\": \"void (unsigned char, short, unsigned long, double, const char *, size_t)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"a\", \"type\": {\"qualType\": \"unsigned char\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"b\", \"type\": {\"qualType\": \"short\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"c\", \"type\": {\"qualType\": \"unsigned long\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"d\", \"type\": {\"qualType\": \"double\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"e\", \"type\": {\"qualType\": \"const char *\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"f\", \"type\": {\"qualType\": \"size_t\"}} ] }"
  s = s + "] }"
  return s
end

# Header exercising the unsupported-surfacing path (no silent wrong bindings).
def bad_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Bad\", \"tagUsed\": \"struct\", \"loc\": {\"file\": \"b.h\"}, \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"q\", \"type\": {\"qualType\": \"long double\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"printf\", \"type\": {\"qualType\": \"int (const char *, ...)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"fmt\", \"type\": {\"qualType\": \"const char *\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"weird\", \"type\": {\"qualType\": \"long double (int)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"n\", \"type\": {\"qualType\": \"int\"}} ] }"
  s = s + "] }"
  return s
end

# Header exercising enums: a named enum (explicit + implicit values) and a
# typedef'd anonymous enum, plus functions taking/returning the enum types.
# Mirrors clang's shape: EnumConstantDecl with an explicit init carries a
# ConstantExpr child whose folded `value` is a decimal string; implicit
# enumerators have no inner. loc.file carry-forward is exercised (only the
# first EnumDecl carries a file).
def enum_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"EnumDecl\", \"name\": \"Color\", \"loc\": {\"file\": \"e.h\"}, \"inner\": ["
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"RED\"},"
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"GREEN\", \"inner\": [{\"kind\": \"ConstantExpr\", \"value\": \"5\"}]},"
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"BLUE\"} ] },"
  s = s + "{ \"kind\": \"EnumDecl\", \"inner\": ["
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"MODE_A\"},"
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"MODE_B\", \"inner\": [{\"kind\": \"ConstantExpr\", \"value\": \"16\"}]},"
  s = s + "  {\"kind\": \"EnumConstantDecl\", \"name\": \"MODE_C\"} ] },"
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"Mode\", \"type\": {\"qualType\": \"enum Mode\"} },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"set_color\", \"type\": {\"qualType\": \"void (enum Color)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"c\", \"type\": {\"qualType\": \"enum Color\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"get_mode\", \"type\": {\"qualType\": \"Mode (void)\"} }"
  s = s + "] }"
  return s
end

def tr_enum(): String
  return cimport_translate(json_parse_or_null(enum_json()), "e.h")
end

# A `clang -dM -E` dump of a header exercising the macro classifier: simple
# decimal/hex/negative ints, a string, a float, a C-suffixed int, plus the
# rejected forms (function-like, expression, empty, char) and two builtins that
# must be dropped via the baseline diff.
def macros_full_dm(): String
  var s = "#define MAX_CONN 64\n"
  s = s + "#define HEX_FLAG 0x20\n"
  s = s + "#define NEG_ONE -1\n"
  s = s + "#define GREETING \"hello\"\n"
  s = s + "#define CONCAT_STR \"a\" \"b\"\n"
  s = s + "#define QUOTED \"a\\\"b\"\n"
  s = s + "#define PI 3.14\n"
  s = s + "#define UL_VAL 100UL\n"
  s = s + "#define SQUARE(x) ((x)*(x))\n"
  s = s + "#define COMBINED (MAX_CONN + 1)\n"
  s = s + "#define EMPTY_DEF \n"
  s = s + "#define LETTER 'A'\n"
  s = s + "#define __STDC__ 1\n"
  s = s + "#define TARGET_OS_MAC 1\n"
  return s
end

# The empty-input baseline: the builtins that must be subtracted.
def macros_base_dm(): String
  return "#define __STDC__ 1\n#define TARGET_OS_MAC 1\n"
end

def tr_macros(): String
  return cimport_emit_macros(macros_full_dm(), macros_base_dm(), "")
end

# Header exercising typedef aliases: scalar aliases (`Uint32`, `MyInt`), a
# pointer alias (`CString`), an alias-of-alias chain (`Handle` -> `Uint32`), used
# in struct fields, function params, and a function return (no desugar field for
# returns, so the alias map is the only resolution path there).
def alias_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"Uint32\", \"loc\": {\"file\": \"a.h\"}, \"type\": {\"qualType\": \"unsigned int\"} },"
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"MyInt\", \"type\": {\"qualType\": \"int\"} },"
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"CString\", \"type\": {\"qualType\": \"char *\"} },"
  s = s + "{ \"kind\": \"TypedefDecl\", \"name\": \"Handle\", \"type\": {\"qualType\": \"Uint32\"} },"
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Holder\", \"tagUsed\": \"struct\", \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"v\", \"type\": {\"qualType\": \"MyInt\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"mix\", \"type\": {\"qualType\": \"Uint32 (Uint32, MyInt)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"a\", \"type\": {\"qualType\": \"Uint32\"}},"
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"b\", \"type\": {\"qualType\": \"MyInt\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"getname\", \"type\": {\"qualType\": \"CString (void)\"} },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"useh\", \"type\": {\"qualType\": \"void (Handle)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"h\", \"type\": {\"qualType\": \"Handle\"}} ] }"
  s = s + "] }"
  return s
end

def tr_alias(): String
  return cimport_translate(json_parse_or_null(alias_json()), "a.h")
end

# Header exercising POINTER struct fields (P3.6c-ptrfields): a struct mixing a
# pointer field (`int *`) with a narrow int, an all-pointer struct, and a function
# taking/returning a pointer-bearing struct by value. A pointer maps to `CPtr` (an
# 8-byte INTEGER eightbyte) and IS now packable, so the struct is emitted (not
# skipped). `const`/`**`/typedef'd-pointer forms all collapse to CPtr.
def ptr_json(): String
  var s = "{ \"kind\": \"TranslationUnitDecl\", \"inner\": ["
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Span\", \"tagUsed\": \"struct\", \"loc\": {\"file\": \"p.h\"}, \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"data\", \"type\": {\"qualType\": \"int *\"}},"
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"len\", \"type\": {\"qualType\": \"int\"}} ] },"
  s = s + "{ \"kind\": \"RecordDecl\", \"name\": \"Pair2p\", \"tagUsed\": \"struct\", \"inner\": ["
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"a\", \"type\": {\"qualType\": \"const char *\"}},"
  s = s + "  {\"kind\": \"FieldDecl\", \"name\": \"b\", \"type\": {\"qualType\": \"void **\"}} ] },"
  s = s + "{ \"kind\": \"FunctionDecl\", \"name\": \"span_sum\", \"type\": {\"qualType\": \"int (struct Span)\"}, \"inner\": ["
  s = s + "  {\"kind\": \"ParmVarDecl\", \"name\": \"s\", \"type\": {\"qualType\": \"struct Span\"}} ] }"
  s = s + "] }"
  return s
end

def tr_ptr(): String
  return cimport_translate(json_parse_or_null(ptr_json()), "p.h")
end

def main(): Int
  describe("cimport_translate: structs") do ->
    it("emits @value @repr(C) for a named-tag struct with I32 fields") do ->
      assert_eq(has(tr_canon(), "@value @repr(C) struct Point\n  x: I32\n  y: I32\nend"), 1)
    end

    it("maps float fields to F32") do ->
      assert_eq(has(tr_canon(), "@value @repr(C) struct Vec2f\n  fx: F32\n  fy: F32\nend"), 1)
    end

    it("emits a struct with a pointer field (P3.6c-ptrfields), not skipped") do ->
      assert_eq(has(tr_ptr(), "@value @repr(C) struct Span\n  data: CPtr\n  len: I32\nend"), 1)
    end

    it("emits an all-pointer struct (const/double-pointer both → CPtr)") do ->
      assert_eq(has(tr_ptr(), "@value @repr(C) struct Pair2p\n  a: CPtr\n  b: CPtr\nend"), 1)
    end

    it("emits a function taking a pointer-bearing struct by value") do ->
      assert_eq(has(tr_ptr(), "extern \"C\" def span_sum(s: Span): I32"), 1)
    end
  end

  describe("cimport_translate: functions") do ->
    it("emits extern \"C\" def with mapped scalar types") do ->
      assert_eq(has(tr_canon(), "extern \"C\" def add(a: I32, b: I32): I32"), 1)
    end

    it("references the struct mirror for a typedef'd-tag return") do ->
      assert_eq(has(tr_canon(), "extern \"C\" def make_point(x: I32, y: I32): Point"), 1)
    end

    it("handles struct-by-value params and return") do ->
      assert_eq(has(tr_canon(), "extern \"C\" def vadd(a: Vec2f, b: Vec2f): Vec2f"), 1)
    end

    it("emits a zero-arg void function") do ->
      assert_eq(has(tr_canon(), "extern \"C\" def noop(): Void"), 1)
    end
  end

  describe("cimport_translate: filtering") do ->
    it("skips implicit builtins") do ->
      assert_eq(has(tr_canon(), "__int128"), 0)
    end

    it("filters declarations from other files via loc.file carry-forward") do ->
      assert_eq(has(tr_canon(), "elsewhere"), 0)
    end
  end

  describe("cimport_translate: type map") do ->
    it("maps narrow/wide/float/pointer/size_t correctly") do ->
      var out = cimport_translate(json_parse_or_null(types_json()), "t.h")
      assert_eq(has(out, "a: U8"), 1)
      assert_eq(has(out, "b: I16"), 1)
      assert_eq(has(out, "c: U64"), 1)
      assert_eq(has(out, "d: F64"), 1)
      assert_eq(has(out, "e: CPtr"), 1)
      assert_eq(has(out, "f: U64"), 1)
    end
  end

  describe("cimport_translate: enums") do ->
    it("emits the first enumerator as const = 0") do ->
      assert_eq(has(tr_enum(), "const RED = 0"), 1)
    end

    it("emits an explicit enumerator value verbatim") do ->
      assert_eq(has(tr_enum(), "const GREEN = 5"), 1)
    end

    it("emits an implicit enumerator as previous + 1") do ->
      assert_eq(has(tr_enum(), "const BLUE = GREEN + 1"), 1)
    end

    it("emits constants of a typedef'd anonymous enum") do ->
      assert_eq(has(tr_enum(), "const MODE_A = 0"), 1)
      assert_eq(has(tr_enum(), "const MODE_B = 16"), 1)
      assert_eq(has(tr_enum(), "const MODE_C = MODE_B + 1"), 1)
    end

    it("maps an `enum Tag` parameter/return to I32") do ->
      assert_eq(has(tr_enum(), "extern \"C\" def set_color(c: I32): Void"), 1)
    end

    it("maps a bare typedef'd enum name to I32") do ->
      assert_eq(has(tr_enum(), "extern \"C\" def get_mode(): I32"), 1)
    end
  end

  describe("cimport_emit_macros: #define constants") do ->
    it("emits a simple decimal integer const") do ->
      assert_eq(has(tr_macros(), "const MAX_CONN = 64"), 1)
    end

    it("keeps a hex literal verbatim") do ->
      assert_eq(has(tr_macros(), "const HEX_FLAG = 0x20"), 1)
    end

    it("emits a negative integer") do ->
      assert_eq(has(tr_macros(), "const NEG_ONE = -1"), 1)
    end

    it("emits a string macro as a string const (module string consts now compile)") do ->
      assert_eq(has(tr_macros(), "const GREETING = \"hello\""), 1)
    end

    it("rejects adjacent-string concatenation, surfaces a comment") do ->
      assert_eq(has(tr_macros(), "# cimport: skipped macro CONCAT_STR"), 1)
      assert_eq(has(tr_macros(), "const CONCAT_STR"), 0)
    end

    it("keeps a string with an escaped quote intact") do ->
      assert_eq(has(tr_macros(), "const QUOTED = \"a\\\"b\""), 1)
    end

    it("emits a float const") do ->
      assert_eq(has(tr_macros(), "const PI = 3.14"), 1)
    end

    it("strips C integer suffixes (Quartz rejects 100UL)") do ->
      assert_eq(has(tr_macros(), "const UL_VAL = 100\n"), 1)
    end

    it("drops compiler/platform builtins via the baseline diff") do ->
      assert_eq(has(tr_macros(), "TARGET_OS_MAC"), 0)
      assert_eq(has(tr_macros(), "__STDC__"), 0)
    end

    it("skips function-like macros silently (not a const, no comment churn)") do ->
      assert_eq(has(tr_macros(), "SQUARE"), 0)
    end

    it("surfaces an expression macro as a comment, never a wrong const") do ->
      assert_eq(has(tr_macros(), "# cimport: skipped macro COMBINED"), 1)
      assert_eq(has(tr_macros(), "const COMBINED"), 0)
    end

    it("surfaces a char-literal macro as a comment") do ->
      assert_eq(has(tr_macros(), "# cimport: skipped macro LETTER"), 1)
    end

    it("skips an empty-body macro") do ->
      assert_eq(has(tr_macros(), "EMPTY_DEF"), 0)
    end

    it("skips a macro whose name collides with prior generated source") do ->
      var out = cimport_emit_macros(macros_full_dm(), macros_base_dm(), "const MAX_CONN = 5\n")
      assert_eq(has(out, "const MAX_CONN = 64"), 0)
    end
  end

  describe("cimport_translate: typedef aliases") do ->
    it("resolves scalar aliases in function params and return") do ->
      assert_eq(has(tr_alias(), "extern \"C\" def mix(a: U32, b: I32): U32"), 1)
    end

    it("resolves a pointer alias (CString -> char * -> CPtr) in a return") do ->
      assert_eq(has(tr_alias(), "extern \"C\" def getname(): CPtr"), 1)
    end

    it("resolves an alias in a struct field") do ->
      assert_eq(has(tr_alias(), "@value @repr(C) struct Holder\n  v: I32\nend"), 1)
    end

    it("resolves an alias-of-alias chain (Handle -> Uint32 -> unsigned int)") do ->
      assert_eq(has(tr_alias(), "extern \"C\" def useh(h: U32): Void"), 1)
    end
  end

  describe("cimport_translate: unsupported surfacing (D5)") do ->
    it("comments out a struct with an unsupported field, never emits it") do ->
      var out = cimport_translate(json_parse_or_null(bad_json()), "b.h")
      assert_eq(has(out, "# cimport: skipped struct Bad"), 1)
      assert_eq(has(out, "struct Bad\n"), 0)
    end

    it("skips variadic functions") do ->
      var out = cimport_translate(json_parse_or_null(bad_json()), "b.h")
      assert_eq(has(out, "# cimport: skipped fn printf"), 1)
    end

    it("skips a function with an unsupported return type") do ->
      var out = cimport_translate(json_parse_or_null(bad_json()), "b.h")
      assert_eq(has(out, "# cimport: skipped fn weird"), 1)
    end
  end

  return qspec_main()
end
