## Phase 19: AsyncIterator/Streams tests

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("AsyncIterator") do ->
    it("sync generator yields values (baseline)") do ->
      var src = """
        def numbers(): impl Iterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def main(): Int
          for n in numbers()
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("basic async generator yields values via direct call") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def main(): Int
          for await n in numbers()
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("async generator with computation between yields") do ->
      var src = """
        def computed(): impl AsyncIterator<Int>
          var x = 10
          yield x
          var y = x + 20
          yield y
          yield x + y
        end
        def main(): Int
          for await v in computed()
            puts(v.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n30\n40\n")
    end

    it("async generator early break") do ->
      var src = """
        def counting(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
        end
        def main(): Int
          var sum = 0
          for await n in counting()
            sum = sum + n
            if n == 3
              break
            end
          end
          puts(sum.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "6\n")
    end

    it("async generator with parameters") do ->
      var src = """
        def range_gen(start: Int, count: Int): impl AsyncIterator<Int>
          var i = 0
          while i < count
            yield start + i
            i = i + 1
          end
        end
        def main(): Int
          for await n in range_gen(10, 3)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n11\n12\n")
    end

    it("async generator yields zero values") do ->
      var src = """
        def empty_gen(): impl AsyncIterator<Int>
        end
        def main(): Int
          var count = 0
          for await n in empty_gen()
            count = count + 1
          end
          puts(count.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "0\n")
    end

    it("async generator single yield") do ->
      var src = """
        def single(): impl AsyncIterator<Int>
          yield 42
        end
        def main(): Int
          for await n in single()
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "42\n")
    end

    it("for-in also works with async generators") do ->
      var src = """
        def nums(): impl AsyncIterator<Int>
          yield 10
          yield 20
        end
        def main(): Int
          for n in nums()
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n20\n")
    end

    it("async generator via variable (indirect poll)") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def main(): Int
          var iter = numbers()
          for await n in iter
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("async generator as parameter (stream combinator pattern)") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def doubled(src: impl AsyncIterator<Int>): impl AsyncIterator<Int>
          for await n in src
            yield n * 2
          end
        end
        def main(): Int
          for await n in doubled(numbers())
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "2\n4\n6\n")
    end

    it("stream filter pattern") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
        end
        def evens(src: impl AsyncIterator<Int>): impl AsyncIterator<Int>
          for await n in src
            if n % 2 == 0
              yield n
            end
          end
        end
        def main(): Int
          for await n in evens(numbers())
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "2\n4\n")
    end

    it("stream take_first(n) from finite source") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
        end
        def take_first(src: impl AsyncIterator<Int>, n: Int): impl AsyncIterator<Int>
          var count = 0
          for await v in src
            if count < n
              yield v
            end
            count = count + 1
          end
        end
        def main(): Int
          for await n in take_first(numbers(), 3)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("chained stream combinators") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
          yield 6
        end
        def doubled(src: impl AsyncIterator<Int>): impl AsyncIterator<Int>
          for await n in src
            yield n * 2
          end
        end
        def evens(src: impl AsyncIterator<Int>): impl AsyncIterator<Int>
          for await n in src
            if n % 4 == 0
              yield n
            end
          end
        end
        def main(): Int
          for await n in evens(doubled(numbers()))
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "4\n8\n12\n")
    end

    it("for await still works with channels") do ->
      var src = """
        def main(): Int
          var ch = channel_new(3)
          send(ch, 1)
          send(ch, 2)
          send(ch, 3)
          channel_close(ch)
          for await n in ch
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("stdlib stream_map") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def main(): Int
          for await n in stream_map(numbers(), x -> x * 10)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n20\n30\n")
    end

    it("stdlib stream_filter") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
          yield 6
        end
        def main(): Int
          for await n in stream_filter(numbers(), x -> x % 2 == 0)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "2\n4\n6\n")
    end

    it("stdlib stream_take_first") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 10
          yield 20
          yield 30
          yield 40
          yield 50
        end
        def main(): Int
          for await n in stream_take_first(numbers(), 3)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "10\n20\n30\n")
    end

    it("stdlib stream_collect") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
        end
        def main(): Int
          var v = stream_collect(numbers())
          puts(v.size.to_s())
          puts(v[0].to_s())
          puts(v[2].to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "3\n1\n3\n")
    end

    it("stdlib chained: filter then map") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
        end
        def main(): Int
          for await n in stream_map(stream_filter(numbers(), x -> x > 2), x -> x * 100)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "300\n400\n")
    end

    it("stdlib stream_sum") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 10
          yield 20
          yield 30
        end
        def main(): Int
          var total = stream_sum(numbers())
          puts(total.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "60\n")
    end

    it("stdlib stream_count") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
        end
        def main(): Int
          var c = stream_count(numbers())
          puts(c.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "5\n")
    end

    it("stdlib stream_skip") do ->
      var src = """
        import * from streams
        def numbers(): impl AsyncIterator<Int>
          yield 10
          yield 20
          yield 30
          yield 40
          yield 50
        end
        def main(): Int
          for await n in stream_skip(numbers(), 3)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "40\n50\n")
    end

    it("stdlib stream_take_while") do ->
      var src = """
        import * from streams
        def counting(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 10
          yield 20
        end
        def main(): Int
          for await n in stream_take_while(counting(), x -> x < 5)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "1\n2\n3\n")
    end

    it("stdlib stream_skip_while") do ->
      var src = """
        import * from streams
        def counting(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 10
          yield 20
        end
        def main(): Int
          for await n in stream_skip_while(counting(), x -> x < 3)
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "3\n10\n20\n")
    end

    it("stdlib stream_enumerate") do ->
      var src = """
        import * from streams
        def letters(): impl AsyncIterator<Int>
          yield 65
          yield 66
          yield 67
        end
        def main(): Int
          for await encoded in stream_enumerate(letters())
            var idx = encoded / 1000000
            var val = encoded % 1000000
            puts(idx.to_s())
            puts(val.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "0\n65\n1\n66\n2\n67\n")
    end

    it("for-in works with async iter variable (gap fix)") do ->
      var src = """
        def numbers(): impl AsyncIterator<Int>
          yield 7
          yield 8
          yield 9
        end
        def main(): Int
          var iter = numbers()
          for n in iter
            puts(n.to_s())
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "7\n8\n9\n")
    end

    it("3-deep combinator chain") do ->
      var src = """
        import * from streams
        def counting(): impl AsyncIterator<Int>
          yield 1
          yield 2
          yield 3
          yield 4
          yield 5
          yield 6
          yield 7
          yield 8
        end
        def main(): Int
          var result = stream_collect(stream_map(stream_filter(counting(), x -> x % 2 == 0), x -> x * x))
          puts(result.size.to_s())
          puts(result[0].to_s())
          puts(result[1].to_s())
          puts(result[2].to_s())
          puts(result[3].to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "4\n4\n16\n36\n64\n")
    end
  end
  return qspec_main()
end
