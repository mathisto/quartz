## Wildcard Pattern Tests
##
## Contract:
##   1. Wildcard `_` discards payload in variant match.
##   2. Named binding extracts payload value.
##   3. Mixed: named on one arm, wildcard on other.
##   4. Works with Result::Ok, Result::Err, Option::Some, Option::None.
import * from qspec

def main(): Int
  describe("wildcard pattern in match") do ->
    it("matches Ok variant with _ discarding payload") do ->
      r = Result::Ok(42)
      v = match r
        Ok(_) => 1
        Err(_) => 2
      end
      assert_eq(v, 1)
    end

    it("matches Err variant with _ wildcard") do ->
      r = Result::Err(99)
      v = match r
        Ok(_) => 1
        Err(_) => 2
      end
      assert_eq(v, 2)
    end

    it("matches Some with _ discarding payload") do ->
      opt = Option::Some(42)
      v = match opt
        Some(_) => 1
        None => 0
      end
      assert_eq(v, 1)
    end

    it("uses named binding on one arm and wildcard on another") do ->
      opt = Option::Some(75)
      v = match opt
        Some(r) => r
        None => 0
      end
      assert_eq(v, 75)
    end

    it("matches enum with named binding on Ok") do ->
      r = Result::Ok(42)
      v = match r
        Ok(val) => val
        Err(_) => 0
      end
      assert_eq(v, 42)
    end

    it("matches enum with named binding on Err") do ->
      r = Result::Err(7)
      v = match r
        Ok(_) => 0
        Err(e) => e
      end
      assert_eq(v, 7)
    end

    it("Option::None matches without payload") do ->
      opt = Option::None
      v = match opt
        Some(_) => 1
        None => 0
      end
      assert_eq(v, 0)
    end

    it("wildcards in all arms") do ->
      r = Result::Ok(99)
      v = match r
        Ok(_) => 10
        Err(_) => 20
      end
      assert_eq(v, 10)
    end

    it("named binding extracts Ok value for computation") do ->
      r = Result::Ok(21)
      v = match r
        Ok(val) => val * 2
        Err(_) => 0
      end
      assert_eq(v, 42)
    end
  end

  return qspec_main()
end
