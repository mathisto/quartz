## Colors Tests
##
## Contract:
##   1. Bg applies arbitrary background.
##   2. Black wraps text in.
##   3. Blue wraps text in.
##   4. Bold applies bold style.
##   5. Bright_green uses code 92.
##   6. Bright_red uses code 91.
import * from qspec
import * from colors

## Build expected ANSI-wrapped string: ESC[CODEmtextESC[0m
def make_ansi(text: String, code: Int): String
  var esc = str_from_char(27)
  var open = esc + "[" + "#{code}" + "m"
  var close = esc + "[" + "0m"
  return open + text + close
end

def main(): Int
  describe("colors stdlib") do ->
    it("red wraps text in red ANSI codes") do ->
      assert_eq_str(red("hello"), make_ansi("hello", 31))
    end

    it("green wraps text in green ANSI codes") do ->
      assert_eq_str(green("hello"), make_ansi("hello", 32))
    end

    it("yellow wraps text in yellow ANSI codes") do ->
      assert_eq_str(yellow("hello"), make_ansi("hello", 33))
    end

    it("blue wraps text in blue ANSI codes") do ->
      assert_eq_str(blue("hello"), make_ansi("hello", 34))
    end

    it("magenta wraps text in magenta ANSI codes") do ->
      assert_eq_str(magenta("hello"), make_ansi("hello", 35))
    end

    it("cyan wraps text in cyan ANSI codes") do ->
      assert_eq_str(cyan("hello"), make_ansi("hello", 36))
    end

    it("white wraps text in white ANSI codes") do ->
      assert_eq_str(white("hello"), make_ansi("hello", 37))
    end

    it("black wraps text in black ANSI codes") do ->
      assert_eq_str(black("hello"), make_ansi("hello", 30))
    end

    it("bright_red uses code 91") do ->
      assert_eq_str(bright_red("hi"), make_ansi("hi", 91))
    end

    it("bright_green uses code 92") do ->
      assert_eq_str(bright_green("hi"), make_ansi("hi", 92))
    end

    it("bold applies bold style") do ->
      assert_eq_str(bold("hi"), make_ansi("hi", 1))
    end

    it("dim applies dim style") do ->
      assert_eq_str(dim("hi"), make_ansi("hi", 2))
    end

    it("italic applies italic style") do ->
      assert_eq_str(italic("hi"), make_ansi("hi", 3))
    end

    it("underline applies underline style") do ->
      assert_eq_str(underline("hi"), make_ansi("hi", 4))
    end

    it("strikethrough applies style") do ->
      assert_eq_str(strikethrough("hi"), make_ansi("hi", 9))
    end

    it("on_red sets red background") do ->
      assert_eq_str(on_red("hi"), make_ansi("hi", 41))
    end

    it("on_green sets green background") do ->
      assert_eq_str(on_green("hi"), make_ansi("hi", 42))
    end

    it("fg applies arbitrary foreground code") do ->
      assert_eq_str(fg("hi", 95), make_ansi("hi", 95))
    end

    it("bg applies arbitrary background code") do ->
      assert_eq_str(bg("hi", 45), make_ansi("hi", 45))
    end

    it("strip_ansi removes all ANSI codes") do ->
      var colored = red("hello")
      assert_eq_str(strip_ansi(colored), "hello")
    end

    it("visible_len returns length excluding ANSI") do ->
      var colored = green("world")
      assert_eq(visible_len(colored), 5)
    end

    it("pad_right pads to visible width") do ->
      var padded = pad_right("hi", 5)
      assert_eq_str(padded, "hi   ")
    end

    it("pad_left pads to visible width") do ->
      var padded = pad_left("hi", 5)
      assert_eq_str(padded, "   hi")
    end

    it("pad_center centers to visible width") do ->
      var padded = pad_center("hi", 6)
      assert_eq_str(padded, "  hi  ")
    end

    it("colors can be nested") do ->
      var result = bold(red("hi"))
      assert_eq_str(strip_ansi(result), "hi")
    end

    it("colors can be concatenated") do ->
      var result = red("a") + blue("b")
      assert_eq_str(strip_ansi(result), "ab")
    end

    it("colors_enabled returns true by default") do ->
      assert_eq(colors_enabled(), 1)
    end

    it("colors_disable turns off color output") do ->
      colors_disable()
      assert_eq_str(red("hi"), "hi")
      colors_enable()
    end

    it("colors_enable turns on color output") do ->
      colors_disable()
      colors_enable()
      assert_eq_str(red("hi"), make_ansi("hi", 31))
    end
  end
  return qspec_main()
end
