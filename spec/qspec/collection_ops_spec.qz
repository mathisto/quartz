## Collection Ops Tests
##
## Contract:
##   1. Collection ops.
##   2. Collection properties.
##   3. Str_find returns Option<Int>.
##   4. Map_get returns Option<T>.
##   5. Vec_pop returns Option<T>.
import * from qspec
import * from qspec/property

def main(): Int
  describe("collection ops") do ->
    it("vec_contains returns 1 when present") do ->
      var v = [10, 20, 30]
      assert_eq(vec_contains(v, 20), 1)
    end
    it("vec_contains returns 0 when not present") do ->
      var v = [10, 20, 30]
      assert_eq(vec_contains(v, 99), 0)
    end
    it("vec_index_of returns Some(index) when found") do ->
      var v = [10, 20, 30]
      var result = vec_index_of(v, 20)
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 1)
        _ => assert_eq(0, 1)
      end
    end
    it("vec_index_of returns None when not found") do ->
      var v = [10, 20, 30]
      var result = vec_index_of(v, 99)
      assert(result.none?)
    end
    it("vec_reverse reverses a vector") do ->
      assert_output("3\n2\n1\n", co_reverse_test)
    end
    it("vec_insert inserts at index") do ->
      assert_output("1\n2\n3\n", co_insert_test)
    end
  end
  describe("collection properties") do ->
    forall_i("vec_contains finds pushed element") do x: Int ->
      var v = vec_new()
      v.push(x)
      assert_eq(vec_contains(v, x), 1)
    end

    forall_i("vec_index_of finds pushed element at 0") do x: Int ->
      var v = vec_new()
      v.push(x)
      var result = vec_index_of(v, x)
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
    end

    forall_i("vec_contains returns 0 for empty vec") do x: Int ->
      var v = vec_new()
      assert_eq(vec_contains(v, x), 0)
    end
  end

  describe("str_find returns Option<Int>") do ->
    it("str_find returns Some(index) when found") do ->
      var result = str_find("hello world", "world")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 6)
        _ => assert_eq(0, 1)
      end
    end
    it("str_find returns None when not found") do ->
      var result = str_find("hello", "xyz")
      assert(result.none?)
    end
    it("str_find returns Some(0) for prefix match") do ->
      var result = str_find("hello", "hel")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
    end
  end

  describe("map_get returns Option<T>") do ->
    it("map_get returns Some(value) when found") do ->
      var m = map_new()
      m.set("key", 42)
      var result = m.get("key")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
    end
    it("map_get returns None when not found") do ->
      var m = map_new()
      var result = m.get("missing")
      assert(result.none?)
    end
    it("map_get returns Some(0) for zero values") do ->
      var m = map_new()
      m.set("zero", 0)
      var result = m.get("zero")
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
    end
  end

  describe("vec_pop returns Option<T>") do ->
    it("vec_pop returns Some(last) when non-empty") do ->
      var v = [10, 20, 30]
      var result = v.pop()
      assert(result.some?)
      match result
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
    end
    it("vec_pop returns None when empty") do ->
      var v = vec_new()
      var result = v.pop()
      assert(result.none?)
    end
    it("vec_pop decrements size") do ->
      var v = [1, 2, 3]
      v.pop()
      assert_eq(v.size, 2)
    end
  end

  return qspec_main()
end
def co_reverse_test(): Void
  var v = [1, 2, 3]
  vec_reverse(v)
  print_int(v[0])
  print_int(v[1])
  print_int(v[2])
end
def co_insert_test(): Void
  var v = [1, 3]
  vec_insert(v, 1, 2)
  print_int(v[0])
  print_int(v[1])
  print_int(v[2])
end
