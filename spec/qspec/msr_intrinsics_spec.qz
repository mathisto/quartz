## x86 MSR (Model-Specific Register) Intrinsics Tests
##
## Contract: `wrmsr(msr, val)` and `rdmsr(msr)` lower to LLVM inline
## asm with the hard-register constraints `{ecx},{eax},{edx}` (write)
## and `={eax},={edx},{ecx}` (read) respectively. The `@c` ABI's
## generic `=r/r` constraints can't express this — wrmsr/rdmsr
## physically require ECX to hold the MSR index and EDX:EAX to hold
## the 64-bit value.
##
## Usage: kernel access to IA32_APIC_BASE (0x1B), IA32_EFER
## (0xC0000080), IA32_GS_BASE (0xC0000101), IA32_KERNEL_GS_BASE
## (0xC0000102), SYSCALL STAR/LSTAR/FMASK, perf counters.

import * from qspec

def main(): Int
  describe("x86 MSR intrinsics") do ->
    it("wrmsr emits hard-register constraints {ecx},{eax},{edx}") do ->
      var src = """
        def main(): Int
          wrmsr(0xC0000080, 0x500)
          return 0
        end
      """
      assert_ir_contains(src, "call void asm sideeffect \"wrmsr\"")
      assert_ir_contains(src, "{ecx},{eax},{edx}")
    end

    it("wrmsr splits 64-bit value into high/low i32 halves") do ->
      # wrmsr consumes EDX:EAX — low 32 bits from EAX, high 32 from EDX.
      # Compiler splits via trunc + lshr+trunc.
      var src = """
        def main(): Int
          wrmsr(0xC0000080, 0x1122334455667788)
          return 0
        end
      """
      assert_ir_contains(src, "trunc i64")
      assert_ir_contains(src, "lshr i64")
    end

    it("rdmsr emits hard-register constraints ={eax},={edx},{ecx}") do ->
      var src = """
        def main(): Int
          return rdmsr(0xC0000080)
        end
      """
      assert_ir_contains(src, "asm sideeffect \"rdmsr\"")
      assert_ir_contains(src, "={eax},={edx},{ecx}")
    end

    it("rdmsr reassembles { i32, i32 } pair into i64") do ->
      var src = """
        def main(): Int
          return rdmsr(0x1B)
        end
      """
      # Multi-output asm returns LLVM struct; we extractvalue + zext + shl + or.
      assert_ir_contains(src, "extractvalue { i32, i32 }")
      assert_ir_contains(src, "shl i64")
      assert_ir_contains(src, "or i64")
    end

    it("freestanding x86_64 compile lowers to real wrmsr/rdmsr opcodes") do ->
      # Sanity: the intrinsics survive the freestanding target path
      # that kernels actually use. baremetal/hello_x86.qz can call
      # these in the APIC-init path once PIC/APIC lands.
      var flags = "--target x86_64-unknown-none-elf"
      var src = """
        def main(): Int
          wrmsr(0xC0000080, 0x500)
          return rdmsr(0xC0000080)
        end
      """
      assert_ir_contains_with_flags(src, "wrmsr", flags)
      assert_ir_contains_with_flags(src, "rdmsr", flags)
    end
  end

  return qspec_main()
end
