## Type Display Tests — R2.1 Phase 0
##
## Contract: verify that diagnostics render Union, Record, and Intersection
## types by their actual member/field lists (e.g. "Int | String", "{ x: Int }")
## instead of the stub strings "Union" / "Record" that tc_type_name_full
## returned before R2.1 Phase 0.
##
## Strategy: push an F64 into a Vec whose element type is the union/record
## type under test. The vec_push typecheck path renders the element type via
## tc_type_name_full, so the compile error must contain the rendered shape.
## (ptype element args are NOT subject to the PF3 as_int(struct) erasure that
## collapses struct/union/record-typed parameters and return types to Int, so
## the type ID reaching tc_type_name_full is the real registered union/record
## id, not the erased sentinel.)
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("union type display") do ->
    it("renders a two-member union as 'A | B'") do ->
      assert_compile_error(td_two_member_src(), "expected element type Int | String")
    end
    it("renders a three-member union as 'A | B | C'") do ->
      assert_compile_error(td_three_member_src(), "expected element type Int | String | Bool")
    end
    it("renders a union with Nil as 'Int | Nil'") do ->
      assert_compile_error(td_nil_member_src(), "expected element type Int | Nil")
    end
    it("renders the union inside the Vec<> receiver type") do ->
      assert_compile_error(td_two_member_src(), "from Vec<Int | String>")
    end
  end

  describe("record type display") do ->
    it("renders a single-field record as '{ x: Int }'") do ->
      assert_compile_error(td_one_field_src(), "expected element type { x: Int }")
    end
    it("renders a multi-field record as '{ x: Int, y: String }'") do ->
      assert_compile_error(td_multi_field_src(), "expected element type { x: Int, y: String }")
    end
    it("renders the record inside the Vec<> receiver type") do ->
      assert_compile_error(td_one_field_src(), "from Vec<{ x: Int }>")
    end
    it("renders an open record with the ' | ..' row-var suffix") do ->
      assert_compile_error(td_open_record_src(), "expected element type { x: Int | .. }")
    end
    it("renders the open record inside the Vec<> receiver type") do ->
      assert_compile_error(td_open_record_src(), "from Vec<{ x: Int | .. }>")
    end
  end

  return qspec_main()
end

def td_two_member_src(): String = """
  def main(): Int
    var v: Vec<Int | String> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """

def td_three_member_src(): String = """
  def main(): Int
    var v: Vec<Int | String | Bool> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """

def td_nil_member_src(): String = """
  def main(): Int
    var v: Vec<Int | Nil> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """

def td_one_field_src(): String = """
  def main(): Int
    var v: Vec<{ x: Int }> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """

def td_multi_field_src(): String = """
  def main(): Int
    var v: Vec<{ x: Int, y: String }> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """

def td_open_record_src(): String = """
  def main(): Int
    var v: Vec<{ x: Int | .. }> = vec_new()
    vec_push(v, 3.14)
    return 0
  end
  """
