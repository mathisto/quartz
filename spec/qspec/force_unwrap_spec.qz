## Force Unwrap Tests
##
## Contract:
##   1. $unwrap: extracts value from Some(v).
##   2. $unwrap: panics on None with message.
##   3. Chains: function results, expression context.
##   4. Nested: unwrap of unwrapped function call.
import * from qspec

def fu_get_value(): Int = Option::Some(17)
def fu_double(x: Int): Int = Option::Some(x * 2)

def main(): Int
  describe("force unwrap") do ->
    it("unwraps Some(v) to v") do ->
      x = Option::Some(42)
      assert_eq($unwrap(x), 42)
    end

    it("unwraps function result") do ->
      assert_eq($unwrap(fu_get_value()), 17)
    end

    it("chains with function calls") do ->
      assert_eq($unwrap(fu_double(10)), 20)
    end

    it("unwraps in expression context") do ->
      opt = Option::Some(5)
      assert_eq($unwrap(opt) + 1, 6)
    end

    it("panics when unwrapping None") do ->
      assert_run_panics("""
def main(): Int
  opt = Option::None
  x = $unwrap(opt)
  print_int(x)
  return 0
end
""", "unwrap")
    end

    it("nested unwrap of function return") do ->
      assert_eq($unwrap(fu_double($unwrap(fu_get_value()))), 34)
    end

    it("unwrap in arithmetic expression") do ->
      a = Option::Some(20)
      b = Option::Some(22)
      assert_eq($unwrap(a) + $unwrap(b), 42)
    end

    it("unwrap Result::Ok value") do ->
      r = Result::Ok(42)
      assert_eq($unwrap(r), 42)
    end
  end

  return qspec_main()
end
