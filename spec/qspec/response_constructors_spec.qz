## Response Constructors Spec — Tests for bad_request, unauthorized, forbidden, no_content, created

import * from qspec
import std/net/http_server

# =============================================================================
# Test helpers
# =============================================================================

def print_bad_request_status(): Void
  var resp = bad_request("invalid email")
  puts(str_from_int(resp.status))
end

def print_bad_request_body(): Void
  var resp = bad_request("invalid email")
  puts(resp.body)
end

def print_unauthorized_status(): Void
  var resp = unauthorized()
  puts(str_from_int(resp.status))
end

def print_unauthorized_body(): Void
  var resp = unauthorized()
  puts(resp.body)
end

def print_forbidden_status(): Void
  var resp = forbidden()
  puts(str_from_int(resp.status))
end

def print_forbidden_body(): Void
  var resp = forbidden()
  puts(resp.body)
end

def print_no_content_status(): Void
  var resp = no_content()
  puts(str_from_int(resp.status))
end

def print_no_content_body(): Void
  var resp = no_content()
  if str_byte_len(resp.body) == 0
    puts("empty")
  else
    puts(resp.body)
  end
end

def print_created_status(): Void
  var resp = created("{\"id\": 1}")
  puts(str_from_int(resp.status))
end

def print_created_body(): Void
  var resp = created("{\"id\": 1}")
  puts(resp.body)
end

def print_created_content_type(): Void
  var resp = created("{\"id\": 1}")
  puts(resp.content_type)
end

# bytes_response — D.11 multi-region body extension. Verifies the
# constructor sets body_ptr/body_len from arguments and leaves the
# String body empty, plus the corresponding paths in the legacy
# String constructors leave body_ptr at 0.
def _br_buf(): Int
  var buf = malloc(8)
  var i = 0
  while i < 8
    ptr_write_byte(ptr_add(buf, i), 65 + i)
    i = i + 1
  end
  return buf
end

def print_bytes_response_status(): Void
  var buf = _br_buf()
  var resp = bytes_response("application/octet-stream", buf, 8)
  puts(str_from_int(resp.status))
  mem_free(buf)
end

def print_bytes_response_content_type(): Void
  var buf = _br_buf()
  var resp = bytes_response("application/octet-stream", buf, 8)
  puts(resp.content_type)
  mem_free(buf)
end

def print_bytes_response_body_len(): Void
  var buf = _br_buf()
  var resp = bytes_response("application/octet-stream", buf, 8)
  puts(str_from_int(resp.body_len))
  mem_free(buf)
end

def print_bytes_response_string_body_empty(): Void
  var buf = _br_buf()
  var resp = bytes_response("application/octet-stream", buf, 8)
  puts(str_from_int(str_byte_len(resp.body)))
  mem_free(buf)
end

def print_bytes_response_ptr_matches(): Void
  var buf = _br_buf()
  var resp = bytes_response("application/octet-stream", buf, 8)
  if resp.body_ptr == buf
    puts("match")
  else
    puts("mismatch")
  end
  mem_free(buf)
end

def print_text_response_body_ptr_zero(): Void
  var r = text_response("hello")
  puts(str_from_int(r.body_ptr))
end

def print_html_response_body_ptr_zero(): Void
  var r = html_response("<p>x</p>")
  puts(str_from_int(r.body_ptr))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("bad_request") do ->
    it("returns 400 status") do ->
      assert_output("400\n", print_bad_request_status)
    end

    it("includes message in body") do ->
      assert_output("400 Bad Request: invalid email\n", print_bad_request_body)
    end
  end

  describe("unauthorized") do ->
    it("returns 401 status") do ->
      assert_output("401\n", print_unauthorized_status)
    end

    it("returns descriptive body") do ->
      assert_output("401 Unauthorized\n", print_unauthorized_body)
    end
  end

  describe("forbidden") do ->
    it("returns 403 status") do ->
      assert_output("403\n", print_forbidden_status)
    end

    it("returns descriptive body") do ->
      assert_output("403 Forbidden\n", print_forbidden_body)
    end
  end

  describe("no_content") do ->
    it("returns 204 status") do ->
      assert_output("204\n", print_no_content_status)
    end

    it("has empty body") do ->
      assert_output("empty\n", print_no_content_body)
    end
  end

  describe("created") do ->
    it("returns 201 status") do ->
      assert_output("201\n", print_created_status)
    end

    it("returns the provided body") do ->
      assert_output("{\"id\": 1}\n", print_created_body)
    end

    it("defaults to application/json content type") do ->
      assert_output("application/json\n", print_created_content_type)
    end
  end

  describe("bytes_response — D.11 multi-region body") do ->
    it("returns 200 status") do ->
      assert_output("200\n", print_bytes_response_status)
    end

    it("sets the requested content type") do ->
      assert_output("application/octet-stream\n", print_bytes_response_content_type)
    end

    it("records body_len from the len argument") do ->
      assert_output("8\n", print_bytes_response_body_len)
    end

    it("leaves the String body empty") do ->
      assert_output("0\n", print_bytes_response_string_body_empty)
    end

    it("stores the raw ptr in body_ptr") do ->
      assert_output("match\n", print_bytes_response_ptr_matches)
    end

    it("text_response leaves body_ptr at 0") do ->
      assert_output("0\n", print_text_response_body_ptr_zero)
    end

    it("html_response leaves body_ptr at 0") do ->
      assert_output("0\n", print_html_response_body_ptr_zero)
    end
  end

  return qspec_main()
end
