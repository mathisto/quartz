## Phase 6.1.a — http_server.qz puts→log migration acceptance spec.
##
## Operation Piezoelectric Effects, Phase 6 (user-tool dogfooding),
## subphase 6.1.a.
##
## Validates the migration of 41 `puts()` sites in std/net/http_server.qz
## to severity-prefixed `log::info` / `log::error` / `log::raw` calls
## routed through the `Log` effect declared in std/log.qz.
##
## Migration semantics:
## - Banner messages (server starting on port X) → `log::info(...)` →
##   "[INFO] Quartz HTTP server listening on port N (kqueue)" via emit.
## - Init failures (Failed to bind / listen / load cert / etc.) →
##   `log::error(...)` → "[ERROR] Failed to bind to port N".
## - Pre-formatted access-log lines and request/response middleware
##   arrows → `log::raw(...)` → message emitted with no prefix.
##
## With no user `with Log {...}` install, all calls fall through to the
## blessed runtime default handler (Phase 6.1.a-prep, e2dfbc2f), which
## now writes the actual message to stderr instead of a fixed
## "default log fired" placeholder. With a custom `with Log { emit:
## capture } do -> http_serve(...) end` install, the user's handler
## sees each emit in dispatch order — this is the test-isolation /
## structured-logging hook Phase 6.1 set out to deliver.
##
## What this spec does NOT cover (filed for follow-on):
## - Per-request effect-frame isolation (1000-fiber stress) — Phase 6.1.c.
## - Actual server bind + curl integration (subprocess + port allocation
##   makes this fragile; smoke-tested manually at migration time, see
##   commit message). Filed as a Tier 4 integration spec.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("http_server log effect migration (Phase 6.1.a)") do ->

    it("std/net/http_server compiles with std/log dependency") do ->
      # Empty main that imports http_server. If the migration broke
      # the import graph (missing std/log, name collision, etc.), this
      # would fail to compile. Exit 0 = the import + module init runs
      # cleanly, including std/log's effect declaration registration.
      assert_run_exits("""
import std/net/http_server

def main(): Int
  return 0
end
""", 0)
    end

    it("log::info inside http_server-using main routes through default handler") do ->
      # Log effect's default handler writes actual message to stderr.
      # If http_server.qz's import of std/log is wired correctly, the
      # caller can use log::info directly and watch stderr.
      assert_run_stderr_contains("""
import std/net/http_server
import std/log

def main(): Int
  log::info("server boot")
  return 0
end
""", "[INFO] server boot")
    end

    it("log::error inside http_server-using main routes through default handler") do ->
      assert_run_stderr_contains("""
import std/net/http_server
import std/log

def main(): Int
  log::error("bind failed")
  return 0
end
""", "[ERROR] bind failed")
    end

    it("custom `with Log` overrides the default — handler captures the emit") do ->
      # The whole point of the migration: substituting handlers without
      # editing http_server.qz. Here the user installs a stdout-printing
      # handler; the default stderr handler is shadowed; the captured
      # message reaches stdout with the [INFO] prefix already applied
      # by log::info.
      assert_run_stdout_eq("""
import std/net/http_server
import std/log

def cap(op_name: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  return 0
end

def main(): Int
  with Log { emit: cap } do ->
    log::info("captured banner")
  end
  return 0
end
""", "[INFO] captured banner\n")
    end

    it("log::raw emits with no severity prefix (used by access-log lines)") do ->
      # The access-log line at line 2474 of http_server.qz is already
      # pre-formatted with timestamp + status code; log::raw passes
      # it through with no extra prefix.
      assert_run_stderr_contains("""
import std/net/http_server
import std/log

def main(): Int
  log::raw("GET / HTTP/1.1 200 12")
  return 0
end
""", "GET / HTTP/1.1 200 12")
    end
  end
  return qspec_main()
end
