## Iterable<T> Trait Tests (Phase 4 of impl Trait sprint)
##
## `trait Iterable<T> { def iter(self): impl Iterator<T> }` is the first
## real stdlib RPITIT (Return-position impl Trait in trait method) trait.
## Each std collection auto-satisfies it through its inherent `iter()`
## whose concrete return type implements `Iterator<T>`.
##
## Coverage strategy: direct-receiver tests only. Bounded-generic dispatch
## `def sum_all<C: Iterable<Int>>(c: C): Int = ...` is BLOCKED on
## NESTED-MONO-UFCS-TYPE-PARAM and tracked as a follow-up. Each test below
## uses a known concrete collection type so the dispatch resolves at the
## call site. The point is to prove that `impl Iterable<Int> for X end`
## (a) compiles via auto-satisfaction and (b) does not regress the existing
## inherent-method dispatch for the six stdlib collections.
##
## NOTE: this file deliberately lives apart from `impl_trait_spec.qz`
## because mixing `import * from qspec/subprocess` with the collection
## imports triggers the PSQ-4 Vec<T> element-type-loss compiler quirk —
## `def push(val: Int)` from collections/stack collides with Vec.push in
## the typecheck of `pipe_create()` (transitively reachable through the
## subprocess module) and emits a closure-call against a non-existent
## %push local. Splitting the file dodges the collision.
import * from qspec
import collections/stack
import collections/queue
import collections/deque
import collections/linked_list
import collections/priority_queue
import collections/sorted_map
import iter

def test_iterable_stack(): Void
  var s = stack_new()
  s.push(10)
  s.push(20)
  s.push(30)
  # Stack iterates bottom-to-top: 10 + 20 + 30 = 60.
  var it = s.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 60)
  s.free()
end

def test_iterable_queue(): Void
  var q = queue_new()
  q.enqueue(1)
  q.enqueue(2)
  q.enqueue(3)
  q.enqueue(4)
  var it = q.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 10)
  q.free()
end

def test_iterable_deque(): Void
  var d = deque_new()
  d.push_back(5)
  d.push_back(7)
  d.push_back(11)
  var it = d.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 23)
  d.free()
end

def test_iterable_linked_list(): Void
  var ll = linked_list_new()
  ll.push_back(2)
  ll.push_back(4)
  ll.push_back(6)
  ll.push_back(8)
  var it = ll.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 20)
  ll.free()
end

def test_iterable_priority_queue(): Void
  var pq = pq_new()
  pq.push(3)
  pq.push(1)
  pq.push(2)
  # pq.iter() walks the underlying heap array in heap order, not sorted
  # order. Sum verifies all three elements are visited once.
  var it = pq.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 6)
  pq.free()
end

def test_iterable_sorted_map(): Void
  var sm = sorted_map_new()
  sm.set(3, 30)
  sm.set(1, 10)
  sm.set(2, 20)
  # sm.iter() yields keys in sorted order: 1 + 2 + 3 = 6.
  var it = sm.iter()
  var total = iter_sum(-> it.next())
  assert_eq(total, 6)
  sm.free()
end

def main(): Int
  describe("Iterable<T> — RPITIT in std collections") do ->
    it("Stack auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_stack()
    end

    it("Queue auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_queue()
    end

    it("Deque auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_deque()
    end

    it("LinkedList auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_linked_list()
    end

    it("PriorityQueue auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_priority_queue()
    end

    it("SortedMap auto-satisfies Iterable<Int> via inherent iter()") do ->
      test_iterable_sorted_map()
    end
  end

  return qspec_main()
end
