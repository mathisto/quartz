## Char Literal Tests
##
## Contract:
##   1. ASCII: 'a'=97, '0'=48, 'A'=65, ' '=32.
##   2. Escape: '\n'=10, '\t'=9, '\\'=92.
##   3. Arithmetic: char literal in subtraction.
##   4. Comparison: char literal in range check.
import * from qspec

def main(): Int
  describe("basic char literal") do ->
    it("'a' returns ASCII 97") do ->
      assert_eq(char_a(), 97)
    end

    it("'0' returns ASCII 48") do ->
      assert_eq(char_zero(), 48)
    end

    it("'A' returns ASCII 65") do ->
      assert_eq(char_upper_a(), 65)
    end

    it("' ' (space) returns ASCII 32") do ->
      assert_eq(char_space(), 32)
    end
  end

  describe("escape sequences") do ->
    it("newline escape returns 10") do ->
      assert_eq(char_newline(), 10)
    end

    it("tab escape returns 9") do ->
      assert_eq(char_tab(), 9)
    end

    it("backslash escape returns 92") do ->
      assert_eq(char_backslash(), 92)
    end
  end

  describe("char in expressions") do ->
    it("char literal in arithmetic") do ->
      assert_eq(char_arithmetic(), 0)
    end

    it("char literal in comparison") do ->
      assert_eq(char_comparison(), 1)
    end
  end

  return qspec_main()
end

def char_a(): Int
  return 'a'
end

def char_zero(): Int
  return '0'
end

def char_upper_a(): Int
  return 'A'
end

def char_space(): Int
  return ' '
end

def char_newline(): Int
  return '\n'
end

def char_tab(): Int
  return '\t'
end

def char_backslash(): Int
  return '\\'
end

def char_arithmetic(): Int
  var c = 'a'
  return c - 'a'
end

def char_comparison(): Int
  var c = 'z'
  if c >= 'a'
    if c <= 'z'
      return 1
    end
  end
  return 0
end
