## Doc Strings Tests
##
## Contract:
##   1. Function doc: `##` on functions parsed without affecting code.
##   2. Multi-line: consecutive `##` lines preserved.
##   3. Struct doc: struct definition works with `##`.
##   4. Enum doc: enum definition works with `##`.
##   5. Empty doc: no-content `##` accepted.
##   6. Special chars: special characters in `##` preserved.
##   7. Impl doc: `##` on impl method works.
##   8. Inline function doc: `##` on single-line function works.
import * from qspec

## A documented struct
struct DSPoint
  x: Int
  y: Int
end

## Color enum
enum DSColor
  Red
  Green
  Blue
end

def main(): Int
  describe("doc comments ##") do ->
    it("parses ## as doc comment on function") do ->
      assert_eq(ds_documented(), 42)
    end

    it("parses multiple consecutive ## lines") do ->
      assert_eq(ds_multi_doc(), 42)
    end

    it("parses doc comments on structs") do ->
      p = DSPoint { x: 10, y: 20 }
      assert_eq(p.x + p.y, 30)
    end

    it("parses doc comments on enums") do ->
      c = DSColor::Red
      v = match c
        DSColor::Red => 42
        DSColor::Green => 0
        DSColor::Blue => 0
      end
      assert_eq(v, 42)
    end

    it("handles empty doc comments") do ->
      assert_eq(ds_empty_doc(), 42)
    end

    it("preserves special characters in doc comments") do ->
      assert_eq(ds_special_chars(), 42)
    end

    it("doc comment on impl method") do ->
      p = DSPoint { x: 10, y: 20 }
      assert_eq(p.ds_sum(), 30)
    end

    it("doc comment on inline function") do ->
      assert_eq(ds_inline_doc(), 99)
    end
  end

  return qspec_main()
end

## This function returns 42
def ds_documented(): Int = 42

## This function has
## multiple doc lines
## describing its behavior
def ds_multi_doc(): Int = 42

##
def ds_empty_doc(): Int = 42

## Returns *42* => the answer (check parens)
def ds_special_chars(): Int = 42

extend DSPoint
  ## Returns the sum of x and y
  def ds_sum(): Int
    return @x + @y
  end
end

## Inline documented function
def ds_inline_doc(): Int = 99
