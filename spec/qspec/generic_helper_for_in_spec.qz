## Generic helpers may use for-in over `Vec<T>` (or `Map<K,V>`, `Slice<T>`)
## with the loop variable visible inside the body, even when the element
## type is an unresolved generic type parameter.
##
## Pre-fix bug: `tc_parse_type("T")` for a bare type parameter returns
## `TYPE_ERROR` (12), and the for-in handler in `typecheck_walk.qz`
## extracted that via `tc_ptype_arg1(Vec<T>)` and bound the loop variable
## with `type_kind = TYPE_ERROR`. The body's `tc_expr` lookup then read
## the binding's type as `TYPE_ERROR`, treated it as "not found"
## (since `TYPE_ERROR` is the same sentinel scope-lookup returns for
## absent names), and emitted `QZ0403: Undefined variable: x`.
##
## `tc_function`'s parameter-binding code (lines 3992-3997) already had
## the same TYPE_ERROR → TYPE_INT fallback; the for-in iter binding was
## just missing it. Filed in `docs/bugs/GENERIC_HELPER_FOR_IN_SCOPE.md`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic helper for-in scope") do ->

    it("for x in Vec<T> with body referencing x — plain Void return") do ->
      assert_run_stdout_eq("""
def emit_each<T>(items: Vec<T>): Void
  for x in items
    var y = x
  end
end

def main(): Int
  var v: Vec<Int> = vec_new()
  v.push(1)
  v.push(2)
  emit_each(v)
  puts("done")
  return 0
end
""", "done\n")
    end

    it("for x in Vec<T> with `can Yield<T>` — bug doc canonical repro") do ->
      assert_run_stdout_eq("""
def emit_each<T>(items: Vec<T>): Void can Yield<T>
  for x in items
    yield x
  end
end

def gen_from_vec(): impl Iterator<Int>
  var v: Vec<Int> = vec_new()
  v.push(10)
  v.push(20)
  emit_each(v)
end

def main(): Int
  for x in gen_from_vec()
    puts(x.to_s())
  end
  return 0
end
""", "10\n20\n")
    end

    it("for x in Vec<T> with reassignment x = x") do ->
      assert_run_stdout_eq("""
def loop_through<T>(items: Vec<T>): Void
  for x in items
    x = x
  end
end

def main(): Int
  var v: Vec<Int> = vec_new()
  v.push(1)
  loop_through(v)
  puts("ok")
  return 0
end
""", "ok\n")
    end

    it("for x in alias of Vec<T> — local-var indirection still works") do ->
      assert_run_stdout_eq("""
def loop_alias<T>(items: Vec<T>): Void
  var alias = items
  for x in alias
    var y = x
  end
end

def main(): Int
  var v: Vec<Int> = vec_new()
  v.push(7)
  loop_alias(v)
  puts("via-alias")
  return 0
end
""", "via-alias\n")
    end

    # NOTE: a `for k in Map<K,V>` test was tried here but the compiler
    # crashes much earlier — `def f<K, V>(m: Map<K, V>)` alone (without any
    # body) triggers `unhandled effect op called` deep in typecheck. Filed
    # as a separate pre-existing bug in `MAP_KV_GENERIC_PARAM_CRASH.md`.
    # The for-in fix would also unblock Map<K,V> for-in once the parsing
    # crash is fixed; the same TYPE_ERROR fallback applies uniformly to
    # the MAP branch in `tc_for_in`.

    it("regression guard — concrete Vec<Int> still works") do ->
      assert_run_stdout_eq("""
def emit_int(items: Vec<Int>): Void
  for x in items
    var y = x + 1
  end
end

def main(): Int
  var v: Vec<Int> = vec_new()
  v.push(5)
  emit_int(v)
  puts("concrete-ok")
  return 0
end
""", "concrete-ok\n")
    end

    it("regression guard — for-in over range in generic function") do ->
      assert_run_stdout_eq("""
def loop_range<T>(items: Vec<T>): Int
  var n = 0
  for i in 0..items.size
    n = n + 1
  end
  return n
end

def main(): Int
  var v: Vec<Int> = vec_new()
  v.push(1)
  v.push(2)
  v.push(3)
  puts(loop_range(v).to_s())
  return 0
end
""", "3\n")
    end

  end
  return qspec_main()
end
