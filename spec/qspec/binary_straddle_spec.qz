## Binary DSL — Phase 1.5 STEP 2: straddling sub-byte fields.
##
## Fields whose bit_in_byte + width > 8 span two or more bytes MSB-first.
## Canonical example: IPv4 frag_off: u13be at bit 51 (byte 6 bit 3 +
## byte 7 all). STEP 2 closes this gap in the encode/decode emitters.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — straddling sub-byte fields (STEP 2)") do ->

    it("u3 + u13be at byte 6/7 round-trips (IPv4 flags + frag_off shape)") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type FragHdr = binary {
          pad:       u48        # 6 bytes of header before the straddle
          flags:     u3
          frag_off:  u13be
        }
        def main(): Int
          var h = FragHdr { pad: 0xaabbccddeeff, flags: 0b010, frag_off: 0x1abc }
          var b = h.encode()
          return 90 if b.size() != 8
          # byte 6 (MSB-first): flags=0b010 at bits 0-2, frag_off high 5 bits at bits 3-7.
          # frag_off = 0x1abc = 0b1_1010_1011_1100, high 5 bits = 0b11010.
          # byte 6 = 010_11010 = 0b01011010 = 90.
          return 91 if b.get(6) != 90
          # byte 7 = frag_off low 8 bits = 0b10111100 = 0xbc = 188.
          return 92 if b.get(7) != 0xbc
          match FragHdr.decode(b)
            Ok(h2) => {
              return 1 if h2.pad != 0xaabbccddeeff
              return 2 if h2.flags != 2
              return 3 if h2.frag_off != 0x1abc
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("u24be straddling 3 bytes at bit offset 4 round-trips") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Straddle24 = binary {
          lead:  u4
          wide:  u24be
          tail:  u4
        }
        def main(): Int
          var h = Straddle24 { lead: 0x5, wide: 0xabcdef, tail: 0x9 }
          var b = h.encode()
          return 90 if b.size() != 4
          # byte 0: lead=5 at bits 0-3 (MSB), wide high 4 bits = 0xa (0b1010) at bits 4-7.
          # byte 0 = 0101_1010 = 0x5a = 90.
          return 91 if b.get(0) != 0x5a
          # byte 1: wide bits 19..12 = 0xbc = 188
          return 92 if b.get(1) != 0xbc
          # byte 2: wide bits 11..4 = 0xde = 222
          return 93 if b.get(2) != 0xde
          # byte 3: wide bits 3..0 = 0xf at bits 0-3, tail=9 at bits 4-7.
          # byte 3 = 0b11111001 = 0xf9 = 249.
          return 94 if b.get(3) != 0xf9
          match Straddle24.decode(b)
            Ok(h2) => {
              return 1 if h2.lead != 0x5
              return 2 if h2.wide != 0xabcdef
              return 3 if h2.tail != 0x9
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("u9be spanning 2 bytes at bit offset 3 round-trips") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Span9 = binary {
          lead:  u3
          v:     u9be
          pad:   u4
        }
        def main(): Int
          var h = Span9 { lead: 0b101, v: 0x1a3, pad: 0 }
          var b = h.encode()
          return 90 if b.size() != 2
          # byte 0: lead=0b101 at bits 0-2 (MSB), v high 5 bits = 0x1a3 >> 4 = 0x1a = 0b11010 at bits 3-7.
          # byte 0 = 101_11010 = 0b10111010 = 0xba = 186
          return 91 if b.get(0) != 0xba
          # byte 1: v low 4 bits = 0x3 at bits 0-3 (MSB), pad=0 at bits 4-7.
          # byte 1 = 0011_0000 = 0x30 = 48
          return 92 if b.get(1) != 0x30
          match Span9.decode(b)
            Ok(h2) => {
              return 1 if h2.lead != 0b101
              return 2 if h2.v != 0x1a3
              return 3 if h2.pad != 0
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

  end

  return qspec_main()
end
