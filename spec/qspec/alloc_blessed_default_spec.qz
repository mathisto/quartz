## QSpec coverage for the runtime-blessed Alloc default handler (Phase A.3.a).
##
## Locks in the prelude install + typecheck blessed-relaxation:
##   - `alloc(N)` and `dealloc(p)` work at module level WITHOUT explicit
##     `with Alloc do ... end` ceremony or `can Alloc` annotation —
##     analogous to FileIo's `fio_read` blessed default.
##   - The runtime default forwards to `@malloc`/`@free` (same backing
##     allocator as `mem_alloc`/`mem_free`).
##   - User `with Alloc { alloc: h, dealloc: h2 } do body end` still
##     overrides the default (top-down handler-stack scan).
##
## Out of scope (covered by sibling specs):
##   - `Vec.push` / `String.concat` / `vec_new` internal allocations
##     intercepted by user Alloc handlers — covered by
##     `alloc_intercept_a3b_spec.qz` and `alloc_a6_coverage_spec.qz`.
##   - Reentrancy bypass when a user handler itself allocates — covered
##     by `alloc_a6_coverage_spec.qz` Group B.

import * from qspec
import std/alloc

# --- Test 1: module-level alloc/dealloc work without with-block.

def t1_use(): Int
  # A.3.c byte-semantics: 16 bytes = two i64 slots.
  var p = alloc(16)
  store(p, 0, 17)
  store(p, 1, 25)
  var sum = load(p, 0) + load(p, 1)
  dealloc(p)
  return sum
end

def t1_run(): Void
  puts("sum=#{t1_use()}")
end

# --- Test 2: user `with Alloc { alloc, dealloc } do body end` overrides
#     the prelude default. The handler counts calls and forwards via the
#     stdlib defaults so allocation still succeeds.

var _t2_alloc_calls = 0
var _t2_dealloc_calls = 0

def t2_counted_alloc(op_name: Int, argc: Int, argv: Int): Int
  _t2_alloc_calls = _t2_alloc_calls + 1
  return default_alloc_handler(op_name, argc, argv)
end

def t2_counted_dealloc(op_name: Int, argc: Int, argv: Int): Int
  _t2_dealloc_calls = _t2_dealloc_calls + 1
  return default_dealloc_handler(op_name, argc, argv)
end

def t2_use(): Int can Alloc
  # A.3.c byte-semantics: 8 bytes = one i64 slot.
  var p1 = alloc(8)
  var p2 = alloc(8)
  store(p1, 0, 5)
  store(p2, 0, 7)
  var s = load(p1, 0) + load(p2, 0)
  dealloc(p1)
  dealloc(p2)
  return s
end

var _t2_sum = 0

def t2_run(): Void
  _t2_alloc_calls = 0
  _t2_dealloc_calls = 0
  with Alloc { alloc: t2_counted_alloc, dealloc: t2_counted_dealloc } do ->
    _t2_sum = t2_use()
  end
  # puts() is OUTSIDE the with-block so str_from_int/concat allocations
  # route through the blessed default and don't bump the counters.
  puts("sum=#{_t2_sum} a=#{_t2_alloc_calls} d=#{_t2_dealloc_calls}")
end

# --- Test 3: post-with calls return to the prelude default (handler-stack
#     pop semantics). After the wrap exits, the counters do NOT advance.

def t3_run(): Void
  _t2_alloc_calls = 0
  _t2_dealloc_calls = 0
  with Alloc { alloc: t2_counted_alloc, dealloc: t2_counted_dealloc } do ->
    var p = alloc(8)
    store(p, 0, 99)
    dealloc(p)
  end
  # Outside the wrap — should hit the prelude default, not the counter.
  var p2 = alloc(8)
  store(p2, 0, 42)
  var v = load(p2, 0)
  dealloc(p2)
  puts("v=#{v} a=#{_t2_alloc_calls} d=#{_t2_dealloc_calls}")
end

def main(): Int
  describe("Alloc blessed-default install (A.3.a)") do ->
    it("alloc/dealloc work at module level without with-block") do ->
      assert_output("sum=42\n", t1_run)
    end

    it("user with Alloc handlers override the prelude default") do ->
      assert_output("sum=12 a=2 d=2\n", t2_run)
    end

    it("post-with calls fall through to the prelude default") do ->
      assert_output("v=42 a=1 d=1\n", t3_run)
    end
  end
  return qspec_main()
end
