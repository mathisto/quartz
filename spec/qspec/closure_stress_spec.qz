## Closure Stress Tests
## Verifies compiler handles large closure counts, deep nesting, captures,
## and #{} interpolation at scale. All tests use subprocess isolation.
##
## Contract:
##   1. Closure stress: sequential count.
##   2. Closure stress: nesting depth.
##   3. Closure stress: captures at scale.
##   4. Closure stress: interpolation at scale.
##   5. Closure stress: large function count + closures.

import * from qspec
import * from qspec/subprocess

def hb(): String = "#" + "{"
def hbe(): String = "}"

## Generate program with N sequential closures, each adding a constant
def gen_seq(n: Int): String
  var s = "def apply(f: Fn(Int): Int, x: Int): Int = f(x)\n"
  s = s + "def main(): Int\n  var sum = 0\n"
  for i in 0..n
    var v = i + 1
    s = s + "  sum = sum + apply(x -> x + " + str_from_int(v) + ", 0)\n"
  end
  var expected = n * (n + 1) / 2
  s = s + "  if sum == " + str_from_int(expected) + "\n    return 0\n  end\n  return 1\nend\n"
  return s
end

## Generate program with N levels of chained closure captures (f_i captures f_{i-1})
def gen_nested(depth: Int): String
  var s = "def main(): Int\n"
  s = s + "  var f0 = (x: Int) -> x + 1\n"
  for i in 1..depth
    s = s + "  var f" + str_from_int(i) + " = (x: Int) -> f" + str_from_int(i - 1) + "(x) + 1\n"
  end
  var last = depth - 1
  s = s + "  if f" + str_from_int(last) + "(0) == " + str_from_int(depth) + "\n"
  s = s + "    return 0\n  end\n  return 1\nend\n"
  return s
end

## Generate program with N closures each capturing a unique variable
def gen_captures(n: Int): String
  var s = "def apply(f: Fn(Int): Int, x: Int): Int = f(x)\n"
  s = s + "def main(): Int\n  var sum = 0\n"
  for i in 0..n
    var v = i + 1
    s = s + "  var c" + str_from_int(v) + " = " + str_from_int(v) + "\n"
    s = s + "  sum = sum + apply(x -> x + c" + str_from_int(v) + ", 0)\n"
  end
  var expected = n * (n + 1) / 2
  s = s + "  if sum == " + str_from_int(expected) + "\n    return 0\n  end\n  return 1\nend\n"
  return s
end

## Generate program with N closures using #{} string interpolation
def gen_interp(n: Int): String
  var s = "def apply_str(f: Fn(Int): String, x: Int): String = f(x)\n"
  s = s + "def main(): Int\n"
  s = s + "  var result = \"\"\n"
  for i in 0..n
    var v = i + 1
    s = s + "  result = apply_str(x -> \"v: " + hb() + "x" + hbe() + "\", " + str_from_int(v) + ")\n"
  end
  s = s + "  if result == \"v: " + str_from_int(n) + "\"\n"
  s = s + "    return 0\n  end\n  return 1\nend\n"
  return s
end

## Generate program with many function definitions + closures calling them
def gen_large_module(n_fns: Int, n_closures: Int): String
  var s = ""
  for i in 0..n_fns
    s = s + "def helper" + str_from_int(i) + "(x: Int): Int = x + " + str_from_int(i) + "\n"
  end
  s = s + "def apply(f: Fn(Int): Int, x: Int): Int = f(x)\n"
  s = s + "def main(): Int\n  var sum = 0\n"
  for i in 0..n_closures
    var fn_idx = i - (i / n_fns) * n_fns
    s = s + "  sum = sum + apply(x -> helper" + str_from_int(fn_idx) + "(x), " + str_from_int(i + 1) + ")\n"
  end
  s = s + "  return 0\nend\n"
  return s
end

def main(): Int
  describe("closure stress: sequential count") do ->
    it("handles 20 sequential closures") do ->
      assert_run_exits(gen_seq(20), 0)
    end

    it("handles 50 sequential closures") do ->
      assert_run_exits(gen_seq(50), 0)
    end

    it("handles 100 sequential closures") do ->
      assert_run_exits(gen_seq(100), 0)
    end
  end

  describe("closure stress: nesting depth") do ->
    it("handles 5 levels of nested closure captures") do ->
      assert_run_exits(gen_nested(5), 0)
    end

    it("handles 10 levels of nested closure captures") do ->
      assert_run_exits(gen_nested(10), 0)
    end

    it("handles 15 levels of nested closure captures") do ->
      assert_run_exits(gen_nested(15), 0)
    end
  end

  describe("closure stress: captures at scale") do ->
    it("50 closures each capturing a unique variable") do ->
      assert_run_exits(gen_captures(50), 0)
    end
  end

  describe("closure stress: interpolation at scale") do ->
    it("50 closures with string interpolation") do ->
      assert_run_exits(gen_interp(50), 0)
    end
  end

  describe("closure stress: large function count + closures") do ->
    it("30 functions + 20 closures referencing them") do ->
      assert_run_exits(gen_large_module(30, 20), 0)
    end
  end

  return qspec_main()
end
