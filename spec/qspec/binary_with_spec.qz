## Binary DSL — Sub-phase 1.4 STEP 5: `.with { ... }` immutable update
## for packed structs.
##
## `value.with { field = expr; other = expr }` derives a new packed-struct
## value with only the listed fields replaced; unnamed fields are copied
## from the receiver. Compiles to a struct clone with per-field load-or-
## override stores.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — .with { ... } immutable update (STEP 5)") do ->

    it("overrides one field, copies the rest") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 10, w: 3 }
          var g = f.with { v = 5 }
          return 1 if g.v != 5
          return 2 if g.w != 3
          # Original untouched
          return 3 if f.v != 10
          return 4 if f.w != 3
          return 0
        end
        """, 0)
    end

    it("overrides multiple fields in one block") do ->
      assert_run_exits("""
        packed struct(u32) GpioModer
          pin0_mode:  2
          pin1_mode:  2
          pin2_mode:  2
          pin3_mode:  2
          pin4_mode:  2
          pin5_mode:  2
          pin6_mode:  2
          pin7_mode:  2
          pin8_mode:  2
          pin9_mode:  2
          pin10_mode: 2
          pin11_mode: 2
          pin12_mode: 2
          pin13_mode: 2
          pin14_mode: 2
          pin15_mode: 2
        end
        def main(): Int
          var base = GpioModer {
            pin0_mode: 0, pin1_mode: 0, pin2_mode: 0, pin3_mode: 0,
            pin4_mode: 0, pin5_mode: 0, pin6_mode: 0, pin7_mode: 0,
            pin8_mode: 0, pin9_mode: 0, pin10_mode: 0, pin11_mode: 0,
            pin12_mode: 0, pin13_mode: 0, pin14_mode: 0, pin15_mode: 0,
          }
          var configured = base.with { pin5_mode = 1, pin6_mode = 2 }
          return 1 if configured.pin5_mode != 1
          return 2 if configured.pin6_mode != 2
          return 3 if configured.pin0_mode != 0
          return 4 if configured.pin15_mode != 0
          # Base unchanged
          return 5 if base.pin5_mode != 0
          return 0
        end
        """, 0)
    end

    it(".with chains (derived from derived)") do ->
      assert_run_exits("""
        packed struct(u8) Flags
          v: 4
          w: 4
        end
        def main(): Int
          var f = Flags { v: 1, w: 2 }
          var g = f.with { v = 7 }
          var h = g.with { w = 9 }
          return 1 if h.v != 7
          return 2 if h.w != 9
          return 3 if g.w != 2
          return 4 if f.v != 1
          return 0
        end
        """, 0)
    end
  end

  return qspec_main()
end
