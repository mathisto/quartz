## State<S> — Phase 2 Milestone P2.a acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone P2.a.
##
## Covers the core P2.a deliverables:
##   * `with State(v) do ... end` call-form handler: lowers to install of
##     `__qz_default_state_handler` with the initial value seeded into
##     `@__qz_effect_stack_state_slots[pretop]`.
##   * `get()` / `set(v)` route through the default handler and read/
##     write the current install's slot.
##   * Nested `with State(a) do with State(b) do ... end ... end` keeps
##     independent slots per install — inner writes don't leak to outer.
##   * Cross-function performs (callee with `can State`) go through the
##     dynamic perform path, which also sets `current_install_idx`.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("State<S> — call-form handler with evidence slots") do ->
    it("get() after State(v) returns the initial value") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(42) do ->
    get()
  end
  puts(r.to_s())
  return 0
end
""", "42\n")
    end

    it("get() + literal combines the slot read into an expression") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(42) do ->
    get() + 1
  end
  puts(r.to_s())
  return 0
end
""", "43\n")
    end

    it("set(v) then get() reflects the write") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(0) do ->
    set(7)
    get()
  end
  puts(r.to_s())
  return 0
end
""", "7\n")
    end

    it("nested with-State: inner slot does not leak to outer") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(1) do ->
    var inner = with State(2) do ->
      get()
    end
    inner + get()
  end
  puts(r.to_s())
  return 0
end
""", "3\n")
    end

    it("nested with-State: inner set does not mutate outer") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(10) do ->
    with State(99) do ->
      set(100)
    end
    get()
  end
  puts(r.to_s())
  return 0
end
""", "10\n")
    end

    it("cross-function perform via `can State` routes through dynamic scan") do ->
      assert_run_stdout_eq("""
import std/state

def increment() can State
  set(get() + 1)
end

def main(): Int
  var r = with State(10) do ->
    increment()
    increment()
    increment()
    get()
  end
  puts(r.to_s())
  return 0
end
""", "13\n")
    end

    it("State slot survives a handler-resolved perform inside a `with Log` block") do ->
      # Interleaving State<Int> with another effect on the same with-stack:
      # the install indices differ per effect, so State's slot stays stable
      # across Log performs. Dynamic dispatch on Log; static (G.2) on State.
      assert_run_stdout_eq("""
import std/state
import std/log

def main(): Int
  var r = with State(5) do ->
    log::info("step")
    set(get() * 2)
    log::info("step")
    get()
  end
  puts(r.to_s())
  return 0
end
""", "10\n")
    end

    it("three-level nesting with writes at each level") do ->
      assert_run_stdout_eq("""
import std/state

def main(): Int
  var r = with State(1) do ->
    set(get() + 10)
    var mid = with State(2) do ->
      set(get() + 20)
      var inner = with State(3) do ->
        set(get() + 30)
        get()
      end
      inner + get()
    end
    mid + get()
  end
  puts(r.to_s())
  return 0
end
""", "66\n")
    end
  end

  return qspec_main()
end
