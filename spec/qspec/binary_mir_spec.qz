## Binary DSL — Sub-phase 1.3 MIR + codegen coverage.
##
## Verifies:
##   1. Every NODE_BINARY_BLOCK and NODE_PACKED_STRUCT at top level is
##      registered in the MIR program's binary layout registry, with
##      a stable layout_id assigned in source order.
##   2. The registry surfaces in emitted IR as a `; binary_layout[N] = Name`
##      comment manifest — the observable handle tests assert against
##      until sub-phase 1.4 ships real pack/unpack codegen.
##
## Real `.encode()` / `.decode()` / `as` codegen lands in 1.4. Nothing in
## this phase makes those callable from Quartz code yet — the MIR opcodes
## (MIR_BINARY_PACK / MIR_BINARY_UNPACK / MIR_PACKED_BITCAST) exist but
## are only emitted by the stub dispatcher, which is a safety net.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — MIR layout registry") do ->

    it("emits a manifest comment for a registered binary {} block") do ->
      assert_ir_contains("""
        type IPv4Header = binary {
          version:    u4
          ihl:        u4
          tos:        u8
          total:      u16be
          id:         u16be
          flags:      u3
          frag_off:   u13be
          ttl:        u8
          proto:      u8
          checksum:   u16be
          src:        u32be
          dst:        u32be
          payload:    bytes
        }
        def main(): Int = 0
        """, "binary_layout[0] = IPv4Header (binary")
    end

    it("reports correct field count for binary blocks") do ->
      assert_ir_contains("""
        type Hdr = binary {
          a: u4
          b: u4
        }
        def main(): Int = 0
        """, "fields=2")
    end

    it("reports correct fixed_bits for byte-aligned binary blocks") do ->
      assert_ir_contains("""
        type Hdr = binary {
          a: u32be
          b: u32be
        }
        def main(): Int = 0
        """, "fixed_bits=64")
    end

    it("tags packed struct with backing width") do ->
      assert_ir_contains("""
        packed struct(u32) GpioModer
          a: 2
          b: 2
          c: 2
          d: 2
          e: 2
          f: 2
          g: 2
          h: 2
          i: 2
          j: 2
          k: 2
          l: 2
          m: 2
          n: 2
          o: 2
          p: 2
        end
        def main(): Int = 0
        """, "GpioModer (packed, backing=u32")
    end

    it("assigns layout ids in source order") do ->
      assert_ir_contains("""
        type First = binary {
          a: u8
        }
        packed struct(u8) Second
          a: 4
          b: 4
        end
        type Third = binary {
          a: u8
          b: u8
        }
        def main(): Int = 0
        """, "binary_layout[2] = Third")
    end

    it("skips the manifest when no binary/packed types are declared") do ->
      assert_ir_not_contains("""
        def main(): Int = 0
        """, "Binary DSL Layouts")
    end

    it("registers sub-byte bit widths") do ->
      # u3 + u13be = 16 bits — both sub-byte-style, both registered.
      assert_ir_contains("""
        type Frag = binary {
          flags:    u3
          frag_off: u13be
        }
        def main(): Int = 0
        """, "fixed_bits=16")
    end

    it("manifests the IntMapHeader dogfood layout cleanly") do ->
      assert_ir_contains("""
        type IntMapHeader = binary {
          cap:  u64le
          len:  u64le
          keys: u64le
          vals: u64le
          used: u64le
        }
        def main(): Int = 0
        """, "IntMapHeader (binary, fields=5, fixed_bits=320)")
    end
  end

  describe("binary DSL — end-to-end sanity") do ->

    it("layout registration does not break regular struct compilation") do ->
      assert_run_exits("""
        struct Point
          x: Int
          y: Int
        end
        type Header = binary {
          a: u8
        }
        def main(): Int
          var p = Point { x: 3, y: 4 }
          return p.x + p.y - 7
        end
        """, 0)
    end

    it("mixed binary + packed + normal struct compiles and runs") do ->
      assert_run_exits("""
        type Hdr = binary {
          magic: u32be
        }
        packed struct(u8) Flags
          a: 4
          b: 4
        end
        struct User
          id: Int
          role: Int
        end
        def main(): Int
          var u = User { id: 42, role: 1 }
          return u.id - 42
        end
        """, 0)
    end
  end

  return qspec_main()
end
