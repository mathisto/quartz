## Linear Types Tests
##
## Contract:
##   1. Basic linear struct.
##   2. Move semantics.
##   3. Drop integration.
##   4. Error: not consumed.
##   5. Error: use after move.
##   6. Error: double consume.
##   7. Borrow syntax.
##   8. Control flow.
##   9. Backward compatibility.

import * from qspec
import * from qspec/subprocess

linear struct LTHandle
  fd: Int
end

linear struct LTResource
  id: Int
end

struct LTPoint
  x: Int
  y: Int
end

linear struct LTToken
  val: Int
end

linear struct LTAutoClose
  fd: Int
end

extend LTAutoClose with Drop
  def drop(self): Void
  end
end

linear struct LTFile
  fd: Int
end

extend LTFile with Drop
  def drop(self): Void
  end
end

linear struct LTResource2
  id: Int
end

extend LTResource2 with Drop
  def drop(self): Void
  end
end

def main(): Int
  describe("basic linear struct") do ->
    it("parses linear struct syntax") do ->
      assert_eq(lt_basic_handle(), 42)
    end

    it("allows linear struct with attributes") do ->
      assert_eq(lt_resource_id(), 7)
    end

    it("allows non-linear structs to work as before") do ->
      assert_eq(lt_non_linear_point(), 6)
    end
  end

  describe("move semantics") do ->
    it("moves linear value on assignment") do ->
      assert_eq(lt_move_token(), 10)
    end
  end

  describe("Drop integration") do ->
    it("auto-consumes linear struct with Drop at scope exit") do ->
      assert_eq(lt_auto_close(), 99)
    end
  end

  describe("error: not consumed") do ->
    it("reports QZ1201 when linear value not consumed and no Drop") do ->
      assert_compile_error("""
        linear struct LTFoo
          val: Int
        end
        def main(): Int
          f = LTFoo { val: 42 }
          return 0
        end
        """, "QZ1201")
    end
  end

  describe("error: use after move") do ->
    it("reports QZ1203 when using consumed linear value") do ->
      assert_compile_error("""
        linear struct LTBar
          val: Int
        end
        def lt_take(r: LTBar): Int = r.val
        def main(): Int
          var f = LTBar { val: 42 }
          lt_take(f)
          lt_take(f)
          return 0
        end
        """, "QZ1203")
    end
  end

  describe("error: double consume") do ->
    it("reports QZ1202 when linear value consumed twice") do ->
      assert_compile_error("""
        linear struct LTBaz
          val: Int
        end
        def main(): Int
          var f = LTBaz { val: 42 }
          var g = f
          var h = f
          return 0
        end
        """, "QZ1202")
    end
  end

  describe("borrow syntax") do ->
    it("allows borrowing linear value with &") do ->
      assert_eq(lt_borrow_file(), 42)
    end
  end

  describe("control flow") do ->
    it("linear value consumed in if/else consistently works") do ->
      assert_eq(lt_control_flow(), 10)
    end
  end

  describe("backward compatibility") do ->
    it("& still works as function reference") do ->
      assert_eq(lt_func_ref(), 42)
    end
  end

  return qspec_main()
end

def lt_consume_handle(h: LTHandle): Int
  return h.fd
end

def lt_basic_handle(): Int
  var h = LTHandle { fd: 42 }
  return lt_consume_handle(h)
end

def lt_take_resource(r: LTResource): Int
  return r.id
end

def lt_resource_id(): Int
  var r = LTResource { id: 7 }
  return lt_take_resource(r)
end

def lt_non_linear_point(): Int
  p = LTPoint { x: 3, y: 4 }
  a = p.x
  b = p.x
  return a + b
end

def lt_consume_token(t: LTToken): Int
  return t.val
end

def lt_move_token(): Int
  var a = LTToken { val: 10 }
  var b = a
  return lt_consume_token(b)
end

def lt_auto_close(): Int
  var x = LTAutoClose { fd: 99 }
  return x.fd
end

def lt_read_fd(f: &LTFile): Int
  return f.fd
end

def lt_close_file(f: LTFile): Int
  return f.fd
end

def lt_borrow_file(): Int
  var f = LTFile { fd: 42 }
  var data = lt_read_fd(&f)
  lt_close_file(f)
  return data
end

def lt_release(r: LTResource2): Int
  return r.id
end

def lt_control_flow(): Int
  var r = LTResource2 { id: 10 }
  var x = 1
  if x
    return lt_release(r)
  else
    return lt_release(r)
  end
end

def lt_double(x: Int): Int = x * 2

def lt_apply(f: Fn(Int): Int, x: Int): Int = f(x)

def lt_func_ref(): Int
  return lt_apply(&lt_double, 21)
end
