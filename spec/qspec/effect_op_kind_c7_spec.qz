## Op kind classification — C.7 acceptance spec.
##
## Operation Piezoelectric Effects, Phase 1, Milestone C (chunk C.7).
##
## Verifies that each declared effect op is classified by kind during
## typecheck Phase 1.4 based on its signature shape:
##
##     kind=0  value     — zero params     (e.g. `def now(): Int`)
##     kind=1  function  — has params      (e.g. `def throw(msg: String)`)
##     kind=2  operation — resumable (reserved, unused — parser discards
##                        op bodies today, so we cannot detect
##                        continuation-taking shapes yet)
##
## The classification is exposed by the new `--dump-effect-decls` flag
## which prints one `EFFECT_DECL effect=<E> op=<X> kind=<N>` line per
## (effect, op) pair to stderr, post-typecheck. Subprocess tests inspect
## stderr to assert the classified kind without needing to synthesize a
## runnable program.
##
## Notes for future maintainers:
## - Kind 2 (operation) is reserved. When the parser starts retaining
##   op bodies (likely Milestone D), body-shape analysis can upgrade
##   function → operation when the body calls the continuation.
## - Kind classification does not affect typecheck outcome today —
##   it's purely informational. C.5's evidence vtable may route kind=0
##   ops through a fast-path (no-arg + memoized), but that's downstream.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("effect-op kind classification (piezo C.7)") do ->
    it("zero-param op classifies as kind=0 (value)") do ->
      var src = """
effect Pure
  def now(): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Pure op=now kind=0")
        _record_failure(str_concat("Expected kind=0 for zero-param op; stderr: ", r.stderr_content))
      end
    end

    it("single-param op classifies as kind=1 (function)") do ->
      var src = """
effect Throws
  def throw(msg: String): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Throws op=throw kind=1")
        _record_failure(str_concat("Expected kind=1 for single-param op; stderr: ", r.stderr_content))
      end
    end

    it("multi-param op classifies as kind=1 (function)") do ->
      var src = """
effect Rpc
  def call(target: String, payload: Int): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Rpc op=call kind=1")
        _record_failure(str_concat("Expected kind=1 for multi-param op; stderr: ", r.stderr_content))
      end
    end

    it("mixed-kind ops within one effect classify independently") do ->
      var src = """
effect Clock
  def now(): Int
  def sleep(ms: Int): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Clock op=now kind=0")
        _record_failure(str_concat("Expected kind=0 for now(); stderr: ", r.stderr_content))
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Clock op=sleep kind=1")
        _record_failure(str_concat("Expected kind=1 for sleep(ms); stderr: ", r.stderr_content))
      end
    end

    it("multiple effects each classify their ops independently") do ->
      var src = """
effect Throws
  def throw(msg: String): Int
end
effect Pure
  def get(): Int
end
effect Log
  def emit(s: String): Int
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Throws op=throw kind=1")
        _record_failure("Expected Throws.throw kind=1")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Pure op=get kind=0")
        _record_failure("Expected Pure.get kind=0")
        return
      end
      if not str_contains(r.stderr_content, "EFFECT_DECL effect=Log op=emit kind=1")
        _record_failure("Expected Log.emit kind=1")
      end
    end

    it("empty effect (no ops) produces no EFFECT_DECL lines") do ->
      var src = """
effect Marker
end

def main(): Int = 0
"""
      var r = subprocess_compile_with_flags(src, "--dump-effect-decls")
      if str_contains(r.stderr_content, "EFFECT_DECL effect=Marker")
        _record_failure(str_concat("Expected no EFFECT_DECL lines for empty effect; stderr: ", r.stderr_content))
      end
    end
  end
  return qspec_main()
end
