## Phase 4D.2 — Stream<T, e> row-polymorphic redesign.
##
## Verifies that `std/gen.qz`'s Stream gained a row-var slot and that
## `Stream.next<T, e>(self: Stream<T, e>): Option<T> can e` typechecks
## and runs across the existing sync consumer-drive path. The row var
## `e` is unconstrained at this phase: 4D.3 wires its binding source
## via generator-fn return-type inference. Here we just prove the new
## struct + method shape compose without regressing the 4.B.4.b /
## 4.B.5 surface.
##
## What this pins down:
##
##   1. `struct Stream<T, e>` registers with one type-param and one
##      row-var (uses 4D.1's lowercase-first detection).
##   2. `def Stream.next<T, e>(self: Stream<T, e>): Option<T> can e`
##      type-checks: the row-var `e` resolves through P3.F.1's
##      function-level row-var env, the body's `with Yield { ... }`
##      install discharges the kind=3 yield, and `can e` subsumes
##      against an empty body row.
##   3. A pure `def gen(): impl Iterator<Int>` constructor still
##      returns a Stream value whose `.next()` method round-trips
##      Some(v) ... None.
##   4. The constructor + `.next()` chain still drives a `for v in
##      gen()` loop end-to-end, including generator-from-generator
##      composition.
##
## Out of scope (covered by 4D.3+):
##
##   - Async generator `Stream<T, {Async}>` row binding. The fresh
##     erv allocated at each `.next()` call site doesn't yet flow
##     from the constructor's static return type; F.3c's syntactic
##     `impl AsyncIterator<` widen still carries the async path.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.2 — Stream<T, e> row-polymorphic redesign") do ->
    it("pure generator + Stream.next<T, e> round-trips Some/None") do ->
      assert_run_stdout_eq("""
def three(): impl Iterator<Int>
  yield 1
  yield 2
  yield 3
end

def main(): Int
  var s = three()
  var a = s.next()
  var b = s.next()
  var c = s.next()
  var d = s.next()
  if a is Some
    puts(str_from_int(a.unwrap()))
  end
  if b is Some
    puts(str_from_int(b.unwrap()))
  end
  if c is Some
    puts(str_from_int(c.unwrap()))
  end
  if d is None
    puts("done")
  end
  return 0
end
""", "1\n2\n3\ndone\n")
    end

    it("pure generator + for-in via Stream.next end-to-end") do ->
      assert_run_stdout_eq("""
def evens(): impl Iterator<Int>
  yield 2
  yield 4
  yield 6
end

def main(): Int
  var total = 0
  for x in evens()
    total += x
  end
  puts(str_from_int(total))
  return 0
end
""", "12\n")
    end

    it("multi-yield generator with mixed branches still works") do ->
      assert_run_stdout_eq("""
def maybe(emit_two: Bool): impl Iterator<Int>
  yield 10
  if emit_two
    yield 20
  end
  yield 30
end

def main(): Int
  var sum1 = 0
  for v in maybe(true)
    sum1 += v
  end
  puts(str_from_int(sum1))

  var sum2 = 0
  for v in maybe(false)
    sum2 += v
  end
  puts(str_from_int(sum2))
  return 0
end
""", "60\n40\n")
    end

    it("Stream.next can be called from inside another generator (composition)") do ->
      assert_run_stdout_eq("""
def small(): impl Iterator<Int>
  yield 1
  yield 2
end

def doubled(): impl Iterator<Int>
  for x in small()
    yield x * 10
  end
end

def main(): Int
  for v in doubled()
    puts(str_from_int(v))
  end
  return 0
end
""", "10\n20\n")
    end
  end

  return qspec_main()
end
