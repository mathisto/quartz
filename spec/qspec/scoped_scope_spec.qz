## Scoped ScopeGuard — B.8 Phase 5 (current_scope push/pop + cancel-on-exit).
##
## Contract:
##   1. `with scope_owned(s) do bound_s -> body end` pushes s as the
##      current_scope() on entry; restores parent on exit. The bound
##      bound_s == s.
##   2. On normal block exit, the wrapped scope is cancelled — subsequent
##      `scope_is_cancelled(s)` returns true.
##   3. On throw inside the body, the same restoration + cancel fires
##      (release_on_throw == release for ScopeGuard).
##   4. After exit, `current_scope()` reads the pre-block value (the
##      parent / root scope, depending on nesting depth).

import * from qspec
import * from std/sync/composition/scope
import * from std/throws

# --- Test 1: current_scope() inside the block == the wrapped scope. -----

def b8_scope_pushes_current(): Int
  var root = scope_root()
  var s = scope_with_cancel(root)
  var observed = 0
  with scope_owned(s) do bound ->
    if current_scope() == s
      observed = 1
    end
  end
  # After exit, current_scope() should be back to whatever it was.
  return observed
end

# --- Test 2: scope is cancelled after normal-exit release. --------------

def b8_scope_cancelled_on_normal_exit(): Int
  var root = scope_root()
  var s = scope_with_cancel(root)
  with scope_owned(s) do bound ->
    var x = 1
  end
  if scope_is_cancelled(s)
    return 1
  end
  return 0
end

# --- Test 3: current_scope() restored to parent after exit. -------------

def b8_scope_restore_parent(): Int
  var root = scope_root()
  var prev = current_scope()
  var s = scope_with_cancel(root)
  with scope_owned(s) do bound ->
    var x = 1
  end
  if current_scope() == prev
    return 1
  end
  return 0
end

# --- Test 4: nested scope_owned LIFO push/pop. --------------------------

def b8_scope_nested_lifo(): Int
  var root = scope_root()
  var s1 = scope_with_cancel(root)
  var s2 = scope_with_cancel(s1)
  var inner_match = 0
  var middle_match = 0
  with scope_owned(s1) do b1 ->
    if current_scope() == s1
      middle_match = 1
    end
    with scope_owned(s2) do b2 ->
      if current_scope() == s2
        inner_match = 1
      end
    end
    # After inner exit, current_scope should be back to s1.
    if current_scope() != s1
      middle_match = 0
    end
  end
  # Both must match.
  return inner_match + middle_match
end

# --- Phase 4b throw-safety tests ----------------------------------------

var b8_scope_caught = 0

def b8_scope_capture_throw(op_name: Int, argc: Int, argv: Int): Int
  b8_scope_caught += 1
  return 0
end

# --- Test 5: throw inside scope_owned cancels scope + restores parent. --

def b8_scope_throw_cancels(): Int
  var root = scope_root()
  var s = scope_with_cancel(root)
  var prev = current_scope()
  with Throws { throw: b8_scope_capture_throw } do ->
    with scope_owned(s) do bound ->
      throw("scope-boom")
    end
    0
  end
  # Scope should be cancelled, current_scope restored.
  var cancel_ok = 0
  var restore_ok = 0
  if scope_is_cancelled(s)
    cancel_ok = 1
  end
  if current_scope() == prev
    restore_ok = 1
  end
  return cancel_ok + restore_ok
end

# --- Test 6: panic inside scope_owned cancels scope + restores parent. --

def b8_scope_panic_cancels(): Int
  var root = scope_root()
  var s = scope_with_cancel(root)
  var prev = current_scope()
  with Throws { throw: b8_scope_capture_throw } do ->
    with scope_owned(s) do bound ->
      panic("scope-kaboom")
    end
    0
  end
  var cancel_ok = 0
  var restore_ok = 0
  if scope_is_cancelled(s)
    cancel_ok = 1
  end
  if current_scope() == prev
    restore_ok = 1
  end
  return cancel_ok + restore_ok
end

def main(): Int
  describe("Scoped ScopeGuard — B.8 Phase 5") do ->
    it("current_scope() inside block equals the wrapped scope") do ->
      assert_eq(b8_scope_pushes_current(), 1)
    end

    it("normal exit cancels the wrapped scope") do ->
      assert_eq(b8_scope_cancelled_on_normal_exit(), 1)
    end

    it("normal exit restores current_scope to parent") do ->
      assert_eq(b8_scope_restore_parent(), 1)
    end

    it("nested scope_owned LIFO push/pop is correct") do ->
      assert_eq(b8_scope_nested_lifo(), 2)
    end

    it("throw inside scope_owned cancels + restores parent") do ->
      assert_eq(b8_scope_throw_cancels(), 2)
    end

    it("panic inside scope_owned cancels + restores parent") do ->
      assert_eq(b8_scope_panic_cancels(), 2)
    end
  end

  return qspec_main()
end
