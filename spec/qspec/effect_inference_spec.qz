import * from qspec

# --- Helper functions with known effects ---

@pure
def pure_add(a: Int, b: Int): Int = a + b

def pure_multiply(x: Int): Int = x * x

def io_hello(): Void = puts("hello")

def alloc_vec(): Int = vec_new().size

def combined_io_alloc(): Void
  var v = vec_new()
  puts(to_str(v.size))
end

def transitive_io(): Void = io_hello()

def transitive_alloc(): Int = alloc_vec()

def deeply_nested(): Void
  transitive_io()
end

# --- Test output helpers ---

def print_pure_add(): Void
  puts(to_str(pure_add(2, 3)))
end

def print_io_hello(): Void
  io_hello()
end

def print_alloc_vec(): Void
  puts(to_str(alloc_vec()))
end

def print_combined(): Void
  combined_io_alloc()
end

def print_transitive_io(): Void
  transitive_io()
end

def print_transitive_alloc(): Void
  puts(to_str(transitive_alloc()))
end

def print_deeply_nested(): Void
  deeply_nested()
end

def main(): Int
  describe("effect inference") do ->

    it("pure function: arithmetic only") do ->
      assert_eq(pure_add(2, 3), 5)
    end

    it("pure function: no annotation needed") do ->
      assert_eq(pure_multiply(7), 49)
    end

    it("IO effect: puts") do ->
      assert_output("hello\n", print_io_hello)
    end

    it("Alloc effect: vec_new") do ->
      assert_eq(alloc_vec(), 0)
    end

    it("combined IO + Alloc") do ->
      assert_output("0\n", print_combined)
    end

    it("transitive IO propagation") do ->
      assert_output("hello\n", print_transitive_io)
    end

    it("transitive Alloc propagation") do ->
      assert_output("0\n", print_transitive_alloc)
    end

    it("deeply nested effect propagation") do ->
      assert_output("hello\n", print_deeply_nested)
    end

    it("effect inference preserves correct behavior") do ->
      assert_output("5\n", print_pure_add)
    end

    it("effect bound syntax: Fn(Int): Int @pure accepted") do ->
      # Fn type with @pure effect bound can be used in type annotations
      assert_eq(apply_pure(pure_add_one, 5), 6)
    end

    it("effect variable: Fn(Int): Int @E accepts any effect") do ->
      # Effect variable @E accepts both pure and impure functions
      assert_eq(apply_any(pure_add_one, 5), 6)
    end

  end

  return qspec_main()
end

@pure
def pure_add_one(x: Int): Int = x + 1

def apply_pure(f: Fn(Int): Int @pure, x: Int): Int = f(x)
def apply_any(f: Fn(Int): Int @E, x: Int): Int = f(x)
