## QSpec coverage for the runtime-blessed Random default handler
## (Phase A.8 Pass 1).
##
## Locks in the prelude install + typecheck blessed-relaxation:
##   - `rand_seed_op`, `rand_int_op`, `rand_range_op`, `rand_crypto_op`
##     work at module level WITHOUT explicit `with Random do ... end`
##     ceremony or `can Random` annotation — analogous to Cache /
##     Profile blessed defaults.
##   - The runtime default forwards to the existing `qz_rand_*` runtime
##     helpers: deterministic xoshiro256** for seed/int/range, OS
##     CSPRNG (arc4random_buf or getrandom) for crypto.
##   - User `with Random { rand_int_op: h } do body end` still
##     overrides the default (top-down handler-stack scan).
##   - Seeded determinism is preserved — `rand_seed_op(42)` followed by
##     `rand_range_op(0, 100)` gives a reproducible value.
##
## Out of scope:
##   - Mock crypto handlers: `rand_crypto_op` calls into OS-level
##     entropy and is not deterministic; we only assert it returns a
##     value and the override path works.

import * from qspec
import std/random

# --- Test 1: module-level rand_int_op works without with-block.
#     Seeded with 42; result is xoshiro256** state-1 mixed via
#     rotl(s1*5, 7)*9 — a fixed value we don't pin (it changes with
#     PRNG impl); we just assert it's deterministic across two calls.

var _t1_a = 0
var _t1_b = 0

def t1_run(): Void
  rand_seed_op(42)
  _t1_a = rand_int_op()
  rand_seed_op(42)
  _t1_b = rand_int_op()
  if _t1_a == _t1_b
    puts("deterministic")
  else
    puts("a=#{_t1_a} b=#{_t1_b}")
  end
end

# --- Test 2: rand_range_op respects [lo, hi) bounds. Seeded; check 100
#     samples all fall in the range.

def t2_run(): Void
  rand_seed_op(7)
  var ok = 1
  for i in 0..100
    var n = rand_range_op(10, 20)
    if n < 10 or n >= 20
      ok = 0
    end
  end
  if ok == 1
    puts("range_ok")
  else
    puts("range_violated")
  end
end

# --- Test 3: user `with Random { rand_int_op: h } do body end`
#     overrides the prelude default. The mock returns a sentinel.

var _t3_calls = 0

def t3_mock_int(op_name: Int, argc: Int, argv: Int): Int
  _t3_calls = _t3_calls + 1
  return 12345
end

var _t3_result = 0

def t3_run(): Void
  _t3_calls = 0
  with Random { rand_int_op: t3_mock_int } do ->
    _t3_result = rand_int_op()
  end
  puts("result=#{_t3_result} calls=#{_t3_calls}")
end

# --- Test 4: post-with calls return to the prelude default. After the
#     wrap exits, the mock counter does NOT advance and rand_int_op
#     returns to forwarding to qz_rand_int.

def t4_run(): Void
  rand_seed_op(99)
  _t3_calls = 0
  var before = rand_int_op()
  with Random { rand_int_op: t3_mock_int } do ->
    var inside = rand_int_op()
    puts("inside=#{inside}")
  end
  var after = rand_int_op()
  if before != after and _t3_calls == 1
    puts("post_with_ok")
  else
    puts("before=#{before} after=#{after} calls=#{_t3_calls}")
  end
end

# --- Test 5: rand_seed_op is a Void op; returns 0 from the handler ABI
#     but the user surface is Void. Just assert it doesn't crash.

def t5_run(): Void
  rand_seed_op(0)
  rand_seed_op(-1)
  rand_seed_op(9223372036854775807)
  puts("seed_ok")
end

# --- Test 6: rand_crypto_op returns SOME value; we don't pin it (not
#     deterministic), just assert two calls are non-equal with high
#     probability (1 in 2^64 collision).

var _t6_a = 0
var _t6_b = 0

def t6_run(): Void
  _t6_a = rand_crypto_op()
  _t6_b = rand_crypto_op()
  if _t6_a != _t6_b
    puts("crypto_diff")
  else
    puts("crypto_collision")
  end
end

# --- Test 7: rand_range_op override returns sentinel.

def t7_mock_range(op_name: Int, argc: Int, argv: Int): Int
  return 777
end

var _t7_result = 0

def t7_run(): Void
  with Random { rand_range_op: t7_mock_range } do ->
    _t7_result = rand_range_op(0, 1000000)
  end
  puts("result=#{_t7_result}")
end

def main(): Int
  describe("Random blessed-default install (A.8 Pass 1)") do ->
    it("rand_int_op is deterministic under same seed") do ->
      assert_output("deterministic\n", t1_run)
    end

    it("rand_range_op respects [lo, hi) bounds") do ->
      assert_output("range_ok\n", t2_run)
    end

    it("user with Random handlers override the prelude default") do ->
      assert_output("result=12345 calls=1\n", t3_run)
    end

    it("post-with calls fall through to the prelude default") do ->
      assert_output("inside=12345\npost_with_ok\n", t4_run)
    end

    it("rand_seed_op is callable at module level") do ->
      assert_output("seed_ok\n", t5_run)
    end

    it("rand_crypto_op returns non-trivial entropy") do ->
      assert_output("crypto_diff\n", t6_run)
    end

    it("rand_range_op override returns sentinel") do ->
      assert_output("result=777\n", t7_run)
    end
  end
  return qspec_main()
end
