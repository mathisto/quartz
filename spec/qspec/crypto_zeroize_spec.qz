## zeroize — secure buffer zeroing via volatile_store<U8>.

import * from qspec
import * from qspec/subprocess
import std/core/crypto/zeroize

def main(): Int
  describe("zeroize") do ->
    it("clears every byte in the range") do ->
      var p = ptr_alloc(2)  # 16 bytes
      var i = 0
      while i < 16
        ptr_write_byte(p + i, 200 + (i & 7))
        i += 1
      end
      zeroize(p, 16)
      i = 0
      while i < 16
        assert_eq(ptr_read_byte(p + i), 0)
        i += 1
      end
    end

    it("leaves bytes outside the range untouched") do ->
      var p = ptr_alloc(2)  # 16 bytes
      var i = 0
      while i < 16
        ptr_write_byte(p + i, 99)
        i += 1
      end
      zeroize(p, 8)
      # First 8 zeroed, last 8 untouched.
      i = 0
      while i < 8
        assert_eq(ptr_read_byte(p + i), 0)
        i += 1
      end
      while i < 16
        assert_eq(ptr_read_byte(p + i), 99)
        i += 1
      end
    end

    it("is a no-op when len is 0") do ->
      var p = ptr_alloc(1)
      ptr_write_byte(p, 77)
      zeroize(p, 0)
      assert_eq(ptr_read_byte(p), 77)
    end
  end

  describe("zeroize codegen") do ->
    it("emits store volatile i8 in the IR") do ->
      assert_ir_contains("""
        import std/core/crypto/zeroize
        def main(): Int
          var p = ptr_alloc(1)
          zeroize(p, 8)
          return 0
        end
      """, "store volatile i8")
    end

    it("emits noinline on the zeroize define") do ->
      assert_ir_contains("""
        import std/core/crypto/zeroize
        def main(): Int
          var p = ptr_alloc(1)
          zeroize(p, 8)
          return 0
        end
      """, "noinline")
    end
  end

  return qspec_main()
end
