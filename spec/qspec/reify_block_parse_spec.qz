## reify Block Parse (Operation Piezoelectric Effects, Milestone A)
##
## Verifies `reify { expr }` syntax parses. Milestone A is parse-only:
## the inner expression is returned directly. Milestone D wraps this in
## a handler that converts throws to `Err(e)` and returns to `Ok(v)`.

import * from qspec

def piezo_reify_int(): Int
  return reify { 42 }
end

def piezo_reify_expr(a: Int, b: Int): Int
  return reify { a * b + 1 }
end

def piezo_reify_nested(): Int
  return reify {
    piezo_reify_int() + 1
  }
end

def main(): Int
  describe("reify { } block (piezo)") do ->
    it("returns inner literal") do ->
      assert_eq(piezo_reify_int(), 42)
    end

    it("returns inner expression result") do ->
      assert_eq(piezo_reify_expr(3, 4), 13)
    end

    it("supports multi-line inner body") do ->
      assert_eq(piezo_reify_nested(), 43)
    end
  end
  return qspec_main()
end
