## Variables Tests
##
## Contract:
##   1. Let declarations.
##   2. Variable reassignment.
##   3. Variable scope.
##   4. Variables with comparison operations.
##   5. Variables with boolean operations.
##   6. Variable declaration patterns.
##   7. Edge cases.

import * from qspec

def main(): Int
  # ==========================================================================
  # Let declarations
  # ==========================================================================

  describe("let declarations") do ->
    it("declares and uses a variable") do ->
      x = 42
      assert_eq(x, 42)
    end

    it("declares multiple variables") do ->
      a = 10
      b = 20
      c = 12
      assert_eq(a + b + c, 42)
    end

    it("initializes with expression") do ->
      x = 6 * 7
      assert_eq(x, 42)
    end

    it("initializes from another variable") do ->
      x = 42
      y = x
      assert_eq(y, 42)
    end

    it("initializes from function call") do ->
      x = answer()
      assert_eq(x, 42)
    end

    it("uses variables in complex expression") do ->
      a = 2
      b = 3
      c = 4
      assert_eq(a * b * c + a + b + c + (a + b) * c, 53)
    end
  end

  # ==========================================================================
  # Variable reassignment
  # ==========================================================================

  describe("variable reassignment") do ->
    it("reassigns a variable") do ->
      var x = 10
      x = 42
      assert_eq(x, 42)
    end

    it("reassigns multiple times") do ->
      var x = 1
      x = 2
      x = 3
      x = 42
      assert_eq(x, 42)
    end

    it("reassigns with expression") do ->
      var x = 10
      x = x + 32
      assert_eq(x, 42)
    end

    it("compound assignment pattern") do ->
      var x = 0
      x = x + 10
      x = x + 20
      x = x + 12
      assert_eq(x, 42)
    end

    it("compound += operator") do ->
      var x = 30
      x += 12
      assert_eq(x, 42)
    end

    it("compound -= operator") do ->
      var x = 50
      x -= 8
      assert_eq(x, 42)
    end

    it("compound *= operator") do ->
      var x = 6
      x *= 7
      assert_eq(x, 42)
    end

    it("compound /= operator") do ->
      var x = 84
      x /= 2
      assert_eq(x, 42)
    end

    it("compound %= operator") do ->
      var x = 47
      x %= 5
      assert_eq(x, 2)
    end

    it("chained compound operators") do ->
      var x = 10
      x += 5
      x -= 3
      x *= 2
      x /= 4
      assert_eq(x, 6)
    end

    it("compound with expression rhs") do ->
      var x = 10
      y = 8
      x += y * 4
      assert_eq(x, 42)
    end

    it("reassigns from function result") do ->
      var x = 10
      x = compute(21)
      assert_eq(x, 42)
    end

    it("swap pattern") do ->
      var a = 1
      var b = 42
      temp = a
      a = b
      b = temp
      assert_eq(a, 42)
    end
  end

  # ==========================================================================
  # Variable scope
  # ==========================================================================

  describe("variable scope") do ->
    it("function parameters shadow nothing (own scope)") do ->
      x = 42
      assert_eq(use_val(x), 42)
    end

    it("local variables are separate across functions") do ->
      x = 42
      other()
      assert_eq(x, 42)
    end

    it("variables in if blocks") do ->
      var x = 0
      if 1
        y = 42
        x = y
      end
      assert_eq(x, 42)
    end

    it("variables in while loops") do ->
      var sum = 0
      var i = 0
      while i < 5
        contribution = i * 2
        sum = sum + contribution
        i = i + 1
      end
      assert_eq(sum, 20)
    end

    it("reassigns outer variable from if block") do ->
      var x = 0
      if 1
        x = 42
      end
      assert_eq(x, 42)
    end

    it("reassigns outer variable from loop") do ->
      var result = 0
      var i = 0
      while i < 42
        result = result + 1
        i = i + 1
      end
      assert_eq(result, 42)
    end
  end

  # ==========================================================================
  # Variables with comparison operations
  # ==========================================================================

  describe("variables with comparison operations") do ->
    it("stores comparison result") do ->
      cmp = 10 > 5
      if cmp
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("updates based on comparison") do ->
      var x = 10
      is_big = x > 5
      if is_big
        x = 42
      end
      assert_eq(x, 42)
    end
  end

  # ==========================================================================
  # Variables with boolean operations
  # ==========================================================================

  describe("variables with boolean operations") do ->
    it("stores and result") do ->
      both = 1 and 1
      if both
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end

    it("stores or result (normalized to 1)") do ->
      either = 0 or 42
      assert_eq(either + 41, 42)
    end
  end

  # ==========================================================================
  # Variable declaration patterns
  # ==========================================================================

  describe("variable declaration patterns") do ->
    it("declares at different points in function") do ->
      a = 10
      b = a + 5
      c = a + b
      d = a + b + c
      assert_eq(d, 50)
    end

    it("many variables") do ->
      a = 1
      b = 2
      c = 3
      d = 4
      e = 5
      f = 6
      g = 7
      h = 8
      assert_eq(a + b + c + d + e + f + g + h, 36)
    end
  end

  # ==========================================================================
  # Edge cases
  # ==========================================================================

  describe("edge cases") do ->
    it("variable initialized to zero") do ->
      x = 0
      assert_eq(x + 42, 42)
    end

    it("variable shadows function parameter") do ->
      assert_eq(var_f(10), 42)
    end

    it("unused variable does not affect result") do ->
      unused = 999
      assert_eq(42, 42)
    end

    it("variable used only in condition") do ->
      flag = 1
      if flag
        assert_eq(42, 42)
      else
        assert_eq(0, 42)
      end
    end
  end

  return qspec_main()
end

def answer(): Int
  return 42
end

def compute(n: Int): Int
  return n * 2
end

def use_val(x: Int): Int
  return x
end

def other(): Int
  x = 99
  return x
end

def var_f(y: Int): Int
  x = y + 32
  return x
end
