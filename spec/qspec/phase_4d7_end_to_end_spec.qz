## Phase 4D.7 — End-to-end spec for the row-polymorphic Stream arc.
##
## Operation Piezoelectric Effects, Phase 4D, closing spec.
##
## The 4D arc shipped 13 commits (4D.1 `8cae398d` … 4D.5c.5 `07885700`,
## bracketing 4D.6 `90fd9a5a`). Per design memo §4D.7 (~0.3 quartz-day),
## this spec consolidates the cross-arc invariants no individual phase
## spec captures alone:
##
##   1. Multi-consumer parity (sync) — pure generator drives identical
##      results through `.next()` + `for v in src` (Stream<T, {}>).
##   2. Multi-consumer parity (async) — async generator drives identical
##      results through `.next()` + `for v in src` + `for await v in src`
##      from a `can Async` caller (Stream<T, {Async}>).
##   3. Regularization parity (sync) — generator-from-generator wraps
##      cleanly with row `{}`.
##   4. Regularization parity (async) — generator-from-generator wraps
##      cleanly with row `{Async}`.
##   5. Mixed-mode helper interleaving — async generator body yielding
##      via a sync `can Yield<Int>` helper interleaves correctly. This
##      is the case `PHASE_4_GENERATORS_RETRO.md` §4 originally flagged
##      as broken pre-4D.5b.
##   6. Row-poly enforcement (negative) — `for v in async_gen()` from a
##      pure caller (no `can Async`) is rejected with QZ0610. Confirms
##      that `Stream<Int, {}>` and `Stream<Int, {Async}>` are distinct
##      typecheck-side, even though both compile to the same i64 ABI.
##   7. F.3c-missed NODE_CALL form parity — bare `for v in async_gen()`
##      and `for await v in async_gen()` from a `can Async` caller
##      produce identical output. The 4D.4d type-driven path replaced
##      F.3c's NODE_IDENT-only annotation-string scan; both consumer
##      keywords now route through the same lowering.
##   8. Row-poly surface-form parity — `def gen(): impl Iterator<T> can
##      Async` (4D.3 row-poly form) and `def gen(): impl AsyncIterator<T>`
##      (legacy async surface) produce equivalent runtime behavior.
##
## Out-of-band invariants (verified outside the unit-spec layer):
##
##   - `_async_gen_func_names` + `_generator_func_names` registries
##     deleted (4D.5b.0 `07c0b4d1`). Verified by grep on
##     self-hosted/backend/*.qz: zero occurrences.
##   - `tc.reserved[0]` generator-context cache deleted (4D.6
##     `90fd9a5a`). Verified by grep on self-hosted/middle/*.qz: zero
##     occurrences.
##   - `mir_lower_async_generator` + `lower_async_gen_iteration{,_indirect}`
##     deleted (4D.5c.4 + 4D.5c.5). Verified by grep + by net function-
##     count delta in fixpoint: 2342 functions post-4D.5c.5.
##   - F.3c MIR fast-path + typecheck fallback deleted (4D.4 `01e6203f`
##     + 4D.4d `cb1db464`). Verified by grep on `typecheck_walk.qz`:
##     no `impl AsyncIterator<` annotation-string scan in the for-in
##     handler.
##   - Fixpoint byte-identical at every 4D commit. Verified by `quake
##     guard` at each commit; no commit in the arc skipped guard.
##   - Memory equivalence (alloc rate of 6-slot frame vs pre-4D 6-slot
##     frame): no change. The 4D arc lifted Stream<T> to Stream<T, e>
##     at the type level only — frame layout unchanged. No benchmark
##     run because no allocation site was touched.
##
## See `docs/design/PHASE_4D_ROW_POLY_STREAM.md` §4D.7 for the design
## memo. See `docs/design/PHASE_4D_5C_CONSUMER_MERGE.md` for the
## consumer-merge subarc that closed within 4D.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("4D.7 — row-polymorphic Stream end-to-end") do ->

    it("multi-consumer parity (sync): .next() and for-in agree on Stream<T, {}>") do ->
      assert_run_stdout_eq("""
def nums(): impl Iterator<Int>
  yield 2
  yield 3
  yield 5
end

def main(): Int
  var s1 = nums()
  var via_next = 0
  loop
    var o = s1.next()
    if o is None
      break
    end
    via_next = via_next + o.unwrap()
  end

  var via_for = 0
  for v in nums()
    via_for = via_for + v
  end

  puts(str_from_int(via_next))
  puts(str_from_int(via_for))
  return 0
end
""", "10\n10\n")
    end

    it("multi-consumer parity (async): for-in and for-await agree on Stream<T, {Async}>") do ->
      # `.next()` from inside the async caller is the third consumer
      # path. Phase 4D.5c "Path B" leaves explicit `.next()` from async
      # callers as a documented limitation (it can mishandle park
      # encodings without Stream.next inlining); covered by Phase 4D.5d
      # if it ever ships. Here we exercise the two for-in paths that DO
      # share the same lowering.
      assert_run_stdout_eq("""
def anums(): impl Iterator<Int> can Async
  yield 7
  yield 11
  yield 13
end

def main(): Int
  var via_for = 0
  for v in anums()
    via_for = via_for + v
  end

  var via_await = 0
  for await v in anums()
    via_await = via_await + v
  end

  puts(str_from_int(via_for))
  puts(str_from_int(via_await))
  return 0
end
""", "31\n31\n")
    end

    it("regularization parity (sync): generator-from-generator wraps Stream<T, {}>") do ->
      assert_run_stdout_eq("""
def base(): impl Iterator<Int>
  yield 1
  yield 2
  yield 3
end

def doubled(): impl Iterator<Int>
  for x in base()
    yield x * 2
  end
end

def main(): Int
  for v in doubled()
    puts(str_from_int(v))
  end
  return 0
end
""", "2\n4\n6\n")
    end

    it("regularization parity (async): generator-from-generator wraps Stream<T, {Async}>") do ->
      assert_run_stdout_eq("""
def abase(): impl Iterator<Int> can Async
  yield 1
  yield 2
  yield 3
end

def adoubled(): impl Iterator<Int> can Async
  for x in abase()
    yield x * 2
  end
end

def main(): Int
  for await v in adoubled()
    puts(str_from_int(v))
  end
  return 0
end
""", "2\n4\n6\n")
    end

    it("mixed-mode helper interleaving: async-gen yields via sync can Yield<Int> helper") do ->
      # PHASE_4_GENERATORS_RETRO.md §4 originally flagged this case as
      # broken pre-4D.5b. The producer-side $poll merge unblocked it.
      # 4D.5b spec covers the all-async-helper variant; this test pins
      # down the SYNC-helper-from-async-gen direction.
      assert_run_stdout_eq("""
def emit_pair(a: Int, b: Int): Void can Yield<Int>
  yield a
  yield b
end

def gen(): impl Iterator<Int> can Async
  emit_pair(10, 20)
  yield 30
  emit_pair(40, 50)
end

def main(): Int
  var sum = 0
  for await v in gen()
    sum = sum + v
  end
  puts(str_from_int(sum))
  return 0
end
""", "150\n")
    end

    it("row-poly enforcement (negative): caller with explicit non-Async row is rejected") do ->
      # Stream<Int, {}> and Stream<Int, {Async}> are distinct types at
      # the typechecker level. A caller declaring an explicit `can` row
      # that does NOT subsume {Async} cannot consume an async source via
      # for-in: the type-driven 4D.4d widening tries to widen the
      # caller's row by {Async}, which fails QZ0610 against the explicit
      # `can Throws` annotation.
      #
      # Note: a caller with no `can` annotation has its row inferred
      # bottom-up and silently picks up Async from the for-in widening;
      # that's correct row-poly behavior, not a type-distinction
      # violation. The negative case requires an explicit incompatible
      # row, mirroring phase_4d4d_for_in_stream_row_spec.qz it #5.
      assert_compile_error("""
def asrc(): impl Iterator<Int> can Async
  yield 1
end

def consumer() can Throws
  var n = 0
  for v in asrc()
    n = n + v
  end
end

def main(): Int
  return 0
end
""", "QZ0610")
    end

    it("F.3c-missed NODE_CALL form: for v in async_gen() and for await give identical output") do ->
      # Pre-4D.4d, F.3c's annotation-string scan (typecheck_walk.qz:3411
      # at the time) only fired for NODE_IDENT iter sources. The
      # NODE_CALL form `for v in async_gen()` was the case it missed —
      # 4D.4d's type-driven widening picks it up. This regression test
      # asserts that bare `for` and `for await` over an async-gen call
      # form produce byte-identical output.
      assert_run_stdout_eq("""
def asrc(): impl Iterator<Int> can Async
  yield 100
  yield 200
end

def main() can Async
  for v in asrc()
    puts(str_from_int(v))
  end
  for await v in asrc()
    puts(str_from_int(v))
  end
end
""", "100\n200\n100\n200\n")
    end

    it("row-poly surface-form parity: impl Iterator<T> can Async ≡ impl AsyncIterator<T>") do ->
      # 4D.3's row-poly form `impl Iterator<T> can Async` rewrites str2
      # to `impl AsyncIterator<T>` in tc_function before MIR runs, so
      # both surface forms route through the same dispatcher branch in
      # mir_lower_function_with_name (4D.5c.5). Same runtime behavior
      # is the user-visible payoff.
      assert_run_stdout_eq("""
def rowpoly(): impl Iterator<Int> can Async
  yield 1
  yield 2
end

def legacy(): impl AsyncIterator<Int>
  yield 1
  yield 2
end

def main(): Int
  var rp_sum = 0
  for await v in rowpoly()
    rp_sum = rp_sum + v
  end

  var lg_sum = 0
  for await v in legacy()
    lg_sum = lg_sum + v
  end

  puts(str_from_int(rp_sum))
  puts(str_from_int(lg_sum))
  return 0
end
""", "3\n3\n")
    end

  end

  return qspec_main()
end
