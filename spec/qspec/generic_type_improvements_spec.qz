## Generic Type Improvements Tests (Phase F.2)
## Tests for Map<K,V> return type propagation, extend blocks on generic types,
## and type parameter propagation through closures.
##
## Contract:
##   1. Map<K,V> return type propagation.
##   2. Extend blocks on generic structs.
##   3. Type params through closures.
##   4. Generic struct field type propagation.

import * from qspec
import * from qspec/subprocess

def main(): Int
  ## =========================================================================
  ## 1. Map<K,V> return type propagation
  ## =========================================================================
  describe("Map<K,V> return type propagation") do ->
    it("map_get returns V type for typed Map") do ->
      ## When Map<String, Int> is declared, map_get should return Int
      assert_run_exits(gti_hm_typed_get_src(), 42)
    end

    it("map_get return flows through variable assignment") do ->
      ## val = m.get(key) should propagate the V type to val
      assert_run_exits(gti_hm_assign_chain_src(), 42)
    end

    it("map_get return flows into function argument") do ->
      ## Passing map_get result directly to a function expecting Int
      assert_run_exits(gti_hm_pass_to_fn_src(), 42)
    end

    it("map_keys returns Vec<K> type") do ->
      ## map_keys on Map<String, Int> should return Vec<String>
      assert_run_exits(gti_hm_keys_type_src(), 2)
    end

    it("map_values returns Vec<V> type") do ->
      ## map_values on Map<String, Int> should return Vec<Int>
      assert_run_exits(gti_hm_values_type_src(), 42)
    end

    it("nested Map<String, Vec<Int>> propagates inner type") do ->
      ## map_get on nested container should return Vec<Int>
      assert_run_exits(gti_hm_nested_type_src(), 99)
    end
  end

  ## =========================================================================
  ## 2. Extend blocks on generic structs
  ## =========================================================================
  describe("extend blocks on generic structs") do ->
    it("extend on non-generic struct works (baseline)") do ->
      assert_run_exits(gti_extend_non_generic_src(), 42)
    end

    it("extend GBox<T> with method returning T") do ->
      assert_run_exits(gti_extend_generic_return_src(), 42)
    end

    it("extend GBox<T> with method taking T parameter") do ->
      assert_run_exits(gti_extend_generic_param_src(), 42)
    end

    it("extend GBox<T> method accessible via UFCS dot syntax") do ->
      assert_run_exits(gti_extend_generic_ufcs_src(), 42)
    end
  end

  ## =========================================================================
  ## 3. Type parameter propagation through closures
  ## =========================================================================
  describe("type params through closures") do ->
    it("closure captures concrete type from generic function") do ->
      ## A generic function creates a closure using the type param
      assert_run_exits(gti_closure_generic_capture_src(), 42)
    end

    it("lambda with typed param inside generic function") do ->
      ## Lambda parameter matches the generic type T
      assert_run_exits(gti_lambda_typed_in_generic_src(), 42)
    end

    it("closure returned from generic function preserves type") do ->
      ## Return a closure that uses the type parameter
      assert_run_exits(gti_closure_return_from_generic_src(), 42)
    end

    it("higher-order generic function passes type through") do ->
      ## map-like pattern: apply a function to each element
      assert_run_exits(gti_higher_order_generic_src(), 6)
    end
  end

  ## =========================================================================
  ## 4. Generic struct field access type propagation
  ## =========================================================================
  describe("generic struct field type propagation") do ->
    it("field access on Box<Int> returns Int") do ->
      assert_run_exits(gti_box_field_access_src(), 42)
    end

    it("field access on Pair<Int, String> returns correct types") do ->
      assert_run_exits(gti_pair_field_access_src(), 10)
    end

    it("generic struct passed to function preserves field types") do ->
      assert_run_exits(gti_generic_struct_param_src(), 42)
    end
  end

  return qspec_main()
end

## =============================================================================
## Helper source generators
## =============================================================================

## -- Map return type propagation --

def gti_hm_typed_get_src(): String = """
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "x", 42)
    match map_get(m, "x")
      Some(v) => return v
      _ => return 0
    end
  end
  """

def gti_hm_assign_chain_src(): String = """
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "x", 42)
    var val = 0
    match map_get(m, "x")
      Some(v) => val = v
      _ => return 0
    end
    result = val
    return result
  end
  """

def gti_hm_pass_to_fn_src(): String = """
  def double(n: Int): Int = n * 2
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "x", 21)
    var val = 0
    match map_get(m, "x")
      Some(v) => val = v
      _ => return 0
    end
    return double(val)
  end
  """

def gti_hm_keys_type_src(): String = """
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "a", 1)
    map_set(m, "b", 2)
    var keys = m.keys()
    return vec_size(keys)
  end
  """

def gti_hm_values_type_src(): String = """
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "x", 42)
    var vals = m.values()
    return vec_get(vals, 0)
  end
  """

def gti_hm_nested_type_src(): String = """
  def main(): Int
    var m: Map<String, Int> = map_new()
    map_set(m, "x", 99)
    match map_get(m, "x")
      Some(inner) => return inner
      _ => return 0
    end
  end
  """

## -- Extend blocks on generic structs --

def gti_extend_non_generic_src(): String = """
  struct Point
    x: Int
    y: Int
  end
  extend Point {
    def sum(): Int = self.x + self.y
  }
  def main(): Int
    p = Point { x: 10, y: 32 }
    return p.sum()
  end
  """

def gti_extend_generic_return_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def get(): T = self.value
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return GBox::get(b)
  end
  """

def gti_extend_generic_param_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def extract(other: T): T = other
  }
  def main(): Int
    b = GBox<Int> { value: 10 }
    return GBox::extract(b, 42)
  end
  """

def gti_extend_generic_ufcs_src(): String = """
  struct GBox<T>
    value: T
  end
  extend GBox<T> {
    def get(): T = self.value
  }
  def main(): Int
    b = GBox<Int> { value: 42 }
    return b.get()
  end
  """

## -- Closures with type parameters --

def gti_closure_generic_capture_src(): String = """
  def make_adder<T>(base: T): Fn(T): T
    return (x: T) -> x + base
  end
  def main(): Int
    f = make_adder(2)
    return f(40)
  end
  """

def gti_lambda_typed_in_generic_src(): String = """
  def apply_fn<T>(f: Fn(T): T, x: T): T = f(x)
  def main(): Int
    return apply_fn((n: Int) -> n * 2, 21)
  end
  """

def gti_closure_return_from_generic_src(): String = """
  def make_const<T>(val: T): Fn(): T
    return -> val
  end
  def main(): Int
    f = make_const(42)
    return f()
  end
  """

def gti_higher_order_generic_src(): String = """
  def apply<T>(f: Fn(T): T, x: T): T = f(x)
  def main(): Int
    a = apply((n: Int) -> n * 2, 3)
    return a
  end
  """

## -- Generic struct field access --

def gti_box_field_access_src(): String = """
  struct Box<T>
    value: T
  end
  def main(): Int
    b = Box<Int> { value: 42 }
    return b.value
  end
  """

def gti_pair_field_access_src(): String = """
  struct Pair<A, B>
    first: A
    second: B
  end
  def main(): Int
    p = Pair<Int, Int> { first: 10, second: 20 }
    return p.first
  end
  """

def gti_generic_struct_param_src(): String = """
  struct Box<T>
    value: T
  end
  def unbox(b: Box<Int>): Int = b.value
  def main(): Int
    b = Box<Int> { value: 42 }
    return unbox(b)
  end
  """
