## Phase 17: True Unbounded Channel Tests
##
## Tests for channel_new_unbounded() — linked-list queue with no capacity limit.
## send never blocks, recv blocks when empty. Nodes freed on dequeue.

import * from qspec

def main(): Int
  describe("unbounded channels") do ->
    it("basic send and recv") do ->
      var ch = channel_new_unbounded()
      send(ch, 42)
      assert_eq(recv(ch), 42)
    end

    it("FIFO ordering") do ->
      assert_output("1\n2\n3\n", test_fifo)
    end

    it("large fill without blocking") do ->
      var ch = channel_new_unbounded()
      var i = 0
      while i < 10000
        send(ch, i)
        i = i + 1
      end
      assert_eq(channel_size(ch), 10000)
      var first = recv(ch)
      assert_eq(first, 0)
      i = 1
      while i < 9999
        recv(ch)
        i = i + 1
      end
      var last = recv(ch)
      assert_eq(last, 9999)
      assert_eq(channel_size(ch), 0)
    end

    it("close semantics") do ->
      var ch = channel_new_unbounded()
      send(ch, 100)
      var v1 = recv(ch)
      assert_eq(v1, 100)
      channel_close(ch)
      var v2 = recv(ch)
      assert_eq(v2, 0)
    end

    it("try_send always succeeds") do ->
      var ch = channel_new_unbounded()
      var r1 = try_send(ch, 10)
      var r2 = try_send(ch, 20)
      var r3 = try_send(ch, 30)
      assert_eq(r1, 1)
      assert_eq(r2, 1)
      assert_eq(r3, 1)
      assert_eq(channel_size(ch), 3)
    end

    it("try_recv on empty returns None") do ->
      var ch = channel_new_unbounded()
      var opt = try_recv(ch)
      assert_eq(option_is_some(opt), 0)
      send(ch, 77)
      var opt2 = try_recv(ch)
      assert_eq(option_is_some(opt2), 1)
      assert_eq(load(opt2, 1), 77)
    end

    it("channel_pressure always returns 0") do ->
      var ch = channel_new_unbounded()
      assert_eq(channel_pressure(ch), 0)
      send(ch, 1)
      send(ch, 2)
      send(ch, 3)
      assert_eq(channel_pressure(ch), 0)
    end

    it("channel_remaining returns large number") do ->
      var ch = channel_new_unbounded()
      var rem = channel_remaining(ch)
      assert_eq(rem > 1000000, 1)
    end
  end

  return qspec_main()
end

def test_fifo(): Void
  var ch = channel_new_unbounded()
  send(ch, 1)
  send(ch, 2)
  send(ch, 3)
  puts(to_str(recv(ch)))
  puts(to_str(recv(ch)))
  puts(to_str(recv(ch)))
end
