## Default Args Tests
##
## Contract:
##   1. Default value used when argument omitted.
##   2. Explicit argument overrides default.
##   3. Multiple defaults: all or partial override.
##   4. Mixed required + default parameters.
##   5. Expression defaults: computed values.
##   6. Zero as default: distinguishable from "no argument".

import * from qspec

def main(): Int
  describe("basic defaults") do ->
    it("uses default when argument not provided") do ->
      assert_eq(da_greet(), 1)
    end

    it("overrides default when argument provided") do ->
      assert_eq(da_greet(5), 5)
    end

    it("works with multiple parameters") do ->
      assert_eq(da_add(), 30)
    end

    it("allows partial override") do ->
      assert_eq(da_add(5), 25)
    end
  end

  describe("mixed required and default parameters") do ->
    it("works with required before default") do ->
      assert_eq(da_compute(5), 15)
    end

    it("allows override of default after required") do ->
      assert_eq(da_compute2(5, 3), 8)
    end
  end

  describe("default with expressions") do ->
    it("supports literal expressions") do ->
      assert_eq(da_scale(5), 30)
    end
  end

  # ===========================================================================
  # Additional default args tests
  # ===========================================================================
  describe("default args edge cases") do ->
    it("overrides all defaults") do ->
      assert_eq(da_add(1, 2), 3)
    end

    it("zero as default value") do ->
      assert_eq(da_with_zero(), 0)
      assert_eq(da_with_zero(42), 42)
    end

    it("default in nested call") do ->
      assert_eq(da_greet() + da_greet(41), 42)
    end

    it("all defaults produce expected result") do ->
      assert_eq(da_add(), 30)
    end
  end

  return qspec_main()
end

def da_greet(times: Int = 1): Int
  return times
end

def da_add(a: Int = 10, b: Int = 20): Int
  return a + b
end

def da_compute(x: Int, y: Int = 10): Int
  return x + y
end

def da_compute2(x: Int, y: Int = 10): Int
  return x + y
end

def da_scale(n: Int, factor: Int = 2 * 3): Int
  return n * factor
end

def da_with_zero(x: Int = 0): Int
  return x
end
