## Direct Vec Push Tests
##
## Contract:
##   1. UFCS push: `.push(str)` for Vec<String> appends.
##   2. UFCS get: pushes via UFCS, retrieves with vec_get.
##   3. Parity: UFCS push and vec_get produce same results.
##   4. Typed get: vec_get returns correct type for Vec<String>.
##   5. Int vec: vec_push with unparameterized Int vectors.
##   6. Type error: .push() of wrong type rejected.
##   7. Multi-push: multiple pushes tracked correctly.

import * from qspec
import * from qspec/subprocess

def dvp_push_count(): Int
  var names: Vec<String> = vec_new()
  names.push("hello")
  names.push("world")
  return names.size
end

def dvp_push_and_get(): Int
  var names: Vec<String> = vec_new()
  names.push("hello")
  s = names[0]
  if s == "hello"
    return 42
  end
  return 0
end

def dvp_parity(): Int
  var a: Vec<String> = vec_new()
  a.push("one")
  a.push("two")

  var b: Vec<String> = vec_new()
  b.push("one")
  b.push("two")

  if a.size == b.size
    s1 = a[0]
    s2 = b[0]
    if s1 == s2
      return 1
    end
  end
  return 0
end

def dvp_get_str_size(): Int
  var items: Vec<String> = vec_new()
  items.push("test")
  s = items[0]
  return s.size
end

def dvp_int_vec(): Int
  var nums = vec_new()
  nums.push(10)
  nums.push(20)
  nums.push(30)
  return nums[1]
end

def main(): Int
  describe("vec_push with Vec<String> via UFCS") do ->
    it("accepts .push(str) for Vec<String>") do ->
      assert_eq(dvp_push_count(), 2)
    end

    it("pushes via UFCS and retrieves with direct vec_get") do ->
      assert_eq(dvp_push_and_get(), 42)
    end
  end

  describe("vec_push parity with UFCS") do ->
    it("UFCS .push() and direct vec_get produce correct results") do ->
      assert_eq(dvp_parity(), 1)
    end
  end

  describe("vec_get on typed vector") do ->
    it("direct vec_get returns correct type for Vec<String>") do ->
      assert_eq(dvp_get_str_size(), 4)
    end
  end

  describe("vec_push with Vec<Int>") do ->
    it("still works with unparameterized Int vectors") do ->
      assert_eq(dvp_int_vec(), 20)
    end
  end

  describe("type mismatch detection") do ->
    it("rejects .push() of wrong type for Vec<String>") do ->
      assert_compile_error(dvp_wrong_push_src(), "vec_push: expected element type")
    end
  end

  describe("multiple pushes") do ->
    it("multiple int pushes tracked correctly") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      assert_eq(v.size, 5)
      assert_eq(v[4], 5)
    end
  end

  return qspec_main()
end

def dvp_wrong_push_src(): String
  return "def main(): Int\n  var names: Vec<String> = vec_new()\n  names.push(42)\n  return 0\nend\n"
end
