# Compile-fail coverage for B.10 Phase 4 N2 — NonZero's two safety walls.
#
# (1) The NOMINAL wall (QZ0201): a bare Int — including `0` and `nil` (both Int)
#     — cannot be assigned to a NonZero slot. This is what keeps `0` out of a
#     NonZero, so `Option<NonZero>`'s niche None=0 can never collide with a real
#     NonZero. The only producers are nonzero_new / nonzero_new_unchecked.
# (2) The ERASED-BOUNDARY wall (QZ0212): a niche `Option<NonZero>` (a bare scalar)
#     passed into a user generic `f<T>(Option<T>)` would have the erased body read
#     it via the boxed layout → crash. Hard compile error instead.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("NonZero compile-fail walls (B.10 §14 N2)") do ->
    it("QZ0201: rejects `let nz: NonZero = 0` (the unsound zero literal)") do ->
      var src = """
        def main(): Int
          nz: NonZero = 0
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0201"), true)
      assert_eq(str_contains(r.stderr_content, "NonZero"), true)
    end

    it("QZ0201: rejects `let nz: NonZero = 5` (any bare Int — must use nonzero_new)") do ->
      var src = """
        def main(): Int
          nz: NonZero = 5
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0201"), true)
    end

    it("QZ0201: rejects `let nz: NonZero = some_int_var`") do ->
      var src = """
        def main(): Int
          k = 7
          nz: NonZero = k
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0201"), true)
    end

    it("QZ0212: rejects a niche Option<NonZero> into a user generic Option<T>") do ->
      var src = """
        def takes_opt<T>(o: Option<T>): Int
          return 1 if o.is_some()
          return 0
        end

        def main(): Int
          a: Option<NonZero> = nonzero_new(5)
          return takes_opt(a)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0212"), true)
    end

    it("ACCEPTS a concrete Option<NonZero> parameter (zero false-positive)") do ->
      var src = """
        def takes_nz(o: Option<NonZero>): Int
          return 1 if o.is_some()
          return 0
        end

        def main(): Int
          a: Option<NonZero> = nonzero_new(5)
          return takes_nz(a)
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code, 0)
    end
  end

  return qspec_main()
end
