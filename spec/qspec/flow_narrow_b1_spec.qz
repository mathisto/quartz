## SURF.FLOW B1 — aliased-condition narrowing.
##
## A CONST local bound to a narrowing-guard boolean (`c = x.some?`) used as an `if`
## condition (`if c`) narrows the subject `x` inside the branch exactly as
## `if x.some?` would. B1 follows the const alias back to its defining guard
## expression and re-classifies against that. Double const gate: the alias `c`
## AND the narrowed subject `x` must both be const (const-by-default), else no
## narrowing fires (the user falls back to explicit unwrap).
##
## POSITIVE: const alias over const Option / Result subject narrows in the then-branch.
## ELSE / guard-style: a `none?` alias narrows the subject to Some after an early return.
## NEGATIVE (soundness, must NOT narrow, verified by the wide `.unwrap()` path compiling):
##   - var alias      (`var c = opt.some?`)
##   - var subject     (`c = vo.some?` where `vo` is var)
##   - no leak past `end`.
import * from qspec

# --- Positive: const alias over a const subject narrows the then-branch ---

## Option via a const alias `c = o.some?` — narrowed `o` reads as inner Int (42).
def alias_some_narrows(): Int
  o: Option<Int> = option_some(42)
  c = o.some?
  var r = 0
  if c
    r = use_int_b1(o)
  end
  return r
end

## Result via a const alias `k = res.ok?` — narrowed `res` reads as inner Int (5).
def alias_ok_narrows(): Int
  res: Result<Int, String> = Result::Ok(5)
  k = res.ok?
  var r = 0
  if k
    r = use_int_raw_b1(res)
  end
  return r
end

## Guard-style / else: a const alias `c = o.none?` proves `o` is Some AFTER an
## early return in the none-branch — narrowed bare read reaches inner Int.
def alias_none_guard_style(): Int
  o: Option<Int> = option_some(11)
  c = o.none?
  if c
    return 0
  end
  # here `o` is proven Some (else-of-none) — reads as inner Int.
  return use_int_raw_b1(o)
end

# --- Negative / soundness boundary ---

## A `var` alias is NEVER recorded, so `if vc` does not narrow — the present value
## is reached only via explicit `.unwrap()`. If B1 wrongly narrowed here, the bare
## read would be inner T and `.unwrap()` would trip QZ0406 (compile failure).
def var_alias_not_narrowed(): Int
  o: Option<Int> = option_some(9)
  var vc = o.some?
  var r = 0
  if vc
    r = o.unwrap()
  end
  return r
end

## A var SUBJECT refuses alias narrowing even with a const alias — the subject could
## be reassigned to a different variant between the alias bind and the use while the
## alias boolean stays true. Read via explicit `.unwrap()` (compiles because `vo`
## stays wide Option).
def var_subject_not_narrowed(): Int
  var vo: Option<Int> = option_some(8)
  c = vo.some?
  var r = 0
  if c
    r = vo.unwrap()
  end
  return r
end

## Narrowing does not leak past the `if`'s `end` — after the branch, `o` is wide
## Option again and the value is reached via explicit `.unwrap()`.
def alias_no_leak_after_if(): Int
  o: Option<Int> = option_some(7)
  c = o.some?
  if c
    # in-branch: narrowed
  end
  return o.unwrap()
end

def use_int_b1(x: Int): Int = x + 100
def use_int_raw_b1(x: Int): Int = x

def main(): Int
  describe("SURF.FLOW B1 — aliased-condition narrowing (positive)") do ->
    it("narrows a const Option subject through a const alias") do ->
      assert_eq(alias_some_narrows(), 142)
    end

    it("narrows a const Result subject through a const alias") do ->
      assert_eq(alias_ok_narrows(), 5)
    end

    it("narrows via a none? alias on the guard-style else path") do ->
      assert_eq(alias_none_guard_style(), 11)
    end
  end

  describe("SURF.FLOW B1 — soundness boundary (must not narrow)") do ->
    it("does not narrow through a var alias") do ->
      assert_eq(var_alias_not_narrowed(), 9)
    end

    it("does not narrow a var subject through a const alias") do ->
      assert_eq(var_subject_not_narrowed(), 8)
    end

    it("does not leak alias narrowing past the if's end") do ->
      assert_eq(alias_no_leak_after_if(), 7)
    end
  end

  return qspec_main()
end
