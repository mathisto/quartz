## Global Variables Tests
##
## Contract:
##   1. Basic global var declaration.
##   2. Global var with function calls.
##   3. Global var with compound assignment.
##   4. Global var lazy initialization pattern.
##   5. Global var scope interactions.
##   6. Global const (immutable).
##   7. Global var with complex types.

import * from qspec

var g_count = 0
var g_value = 10
var g_a = 10
var g_b = 20
var g_c = 12
var g_counter = 0
var g_base = 40
var g_sum = 0
var g_val = 0
var g_cache = 0
var g_map: Map<Int, Int> = map_new<Int, Int>()
var g_result = 0
var g_vec: Vec<Int> = vec_new<Int>()
var g_imap: Map<Int, Int> = map_new<Int, Int>()
var g_map_initialized = 0

## A.45 ii (L2) — a typed `Vec<Struct>` module-global constructed with
## `vec_new<GvB>()` (type-arg, no `: Vec<...>` annotation) must propagate its
## element type cross-function so a `g_struct_vec[i].field` access in ANOTHER
## function resolves the field offset from the CONCRETE element struct — not the
## GLOBAL field-name table, which picks the wrong offset on a field-name
## collision. GvA.tag (offset 3) collides with GvB.tag (offset 0): an untracked
## global would read offset 0 (GvB) and return the padding, not 99.
struct GvB
  tag: Int
  other: Int
end

struct GvA
  pad0: Int
  pad1: Int
  pad2: Int
  tag: Int
end

var g_struct_vec = vec_new<GvA>()

def main(): Int
  describe("basic global var declaration") do ->
    it("declares and initializes a global var with integer") do ->
      assert_eq(g_count, 0)
    end

    it("declares global var and modifies it") do ->
      g_value = 42
      assert_eq(g_value, 42)
    end

    it("declares multiple global vars") do ->
      assert_eq(g_a + g_b + g_c, 42)
    end
  end

  describe("global var with function calls") do ->
    it("modifies global from function") do ->
      g_counter = 0
      gv_increment()
      gv_increment()
      gv_increment()
      assert_eq(g_counter, 3)
    end

    it("reads global from multiple functions") do ->
      g_base = 40
      assert_eq(gv_add_two(), 42)
    end

    it("accumulator pattern") do ->
      g_sum = 0
      gv_add(10)
      gv_add(20)
      gv_add(12)
      assert_eq(g_sum, 42)
    end
  end

  describe("global var with compound assignment") do ->
    it("uses += on global") do ->
      g_val = 30
      g_val += 12
      assert_eq(g_val, 42)
    end

    it("uses -= on global") do ->
      g_val = 50
      g_val -= 8
      assert_eq(g_val, 42)
    end

    it("uses *= on global") do ->
      g_val = 6
      g_val *= 7
      assert_eq(g_val, 42)
    end
  end

  describe("global var lazy initialization pattern") do ->
    it("initializes global on first use") do ->
      g_cache = 0
      assert_eq(gv_get_cache(), 42)
    end

    it("singleton pattern with map") do ->
      g_map_initialized = 0
      m = gv_get_map()
      assert_eq(m.get(1).unwrap(), 42)
    end
  end

  describe("global var scope interactions") do ->
    it("local does not conflict with global of different name") do ->
      x = 42
      assert_eq(x, 42)
    end

    it("global accessible after local goes out of scope") do ->
      g_result = 0
      gv_helper()
      assert_eq(g_result, 42)
    end
  end

  describe("global const (immutable)") do ->
    it("declares immutable global") do ->
      assert_eq(gv_const_val, 42)
    end

    it("rejects assignment to immutable global") do ->
      assert_compile_error("""
x = 42
def main(): Int
  x = 99
  return x
end
""", "Cannot assign to immutable")
    end
  end

  describe("global var with complex types") do ->
    it("global vec") do ->
      g_vec.clear()
      gv_init_vec()
      assert_eq(g_vec[0] + g_vec[1] + g_vec[2], 42)
    end

    it("global map") do ->
      g_imap.clear()
      gv_init_imap()
      assert_eq(g_imap.get(100).unwrap(), 42)
    end

    it("typed Vec<Struct> global element field access cross-function (A.45 ii L2)") do ->
      g_struct_vec.clear()
      gv_init_struct_vec()
      assert_eq(gv_read_struct_tag(), 99)
    end
  end

  return qspec_main()
end

gv_const_val = 42

def gv_increment(): Void
  g_counter = g_counter + 1
end

def gv_add_two(): Int
  return g_base + 2
end

def gv_add(n: Int): Void
  g_sum = g_sum + n
end

def gv_get_cache(): Int
  if g_cache == 0
    g_cache = 42
  end
  return g_cache
end

def gv_get_map(): Map<Int, Int>
  if g_map_initialized == 0
    g_map.set(1, 42)
    g_map_initialized = 1
  end
  return g_map
end

def gv_helper(): Void
  local = 42
  g_result = local
end

def gv_init_vec(): Void
  g_vec.push(10)
  g_vec.push(20)
  g_vec.push(12)
end

def gv_init_imap(): Void
  g_imap.set(100, 42)
end

def gv_init_struct_vec(): Void
  g_struct_vec.push(GvA { pad0: 0, pad1: 0, pad2: 0, tag: 99 })
end

def gv_read_struct_tag(): Int
  return g_struct_vec[0].tag
end
