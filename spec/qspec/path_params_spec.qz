## Path Params Spec — Tests for path parameter extraction
##
## Tests path_param and _extract_params using manually constructed
## Request structs and known patterns.

import * from qspec
import std/net/http_server

# =============================================================================
# Helpers
# =============================================================================

def extract_and_get(pattern: String, path: String, name: String): String
  var params = map_new()
  _extract_params(pattern, path, params)
  match params.get(name)
    Some(v) => return v
    _ => return ""
  end
end

# =============================================================================
# Test helpers
# =============================================================================

def print_single_param(): Void
  puts(extract_and_get("/users/:id", "/users/42", "id"))
end

def print_two_params(): Void
  var params = map_new()
  _extract_params("/users/:id/posts/:pid", "/users/42/posts/99", params)
  match params.get("id")
    Some(v) => puts(v)
    _ => puts("")
  end
  match params.get("pid")
    Some(v) => puts(v)
    _ => puts("")
  end
end

def print_param_with_text(): Void
  puts(extract_and_get("/api/v1/items/:slug", "/api/v1/items/my-item", "slug"))
end

def print_encoded_param(): Void
  puts(extract_and_get("/search/:query", "/search/hello%20world", "query"))
end

def print_missing_param(): Void
  var result = extract_and_get("/users/:id", "/users/42", "name")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_path_param_api(): Void
  var req = Request {
    method: "GET", path: "/users/alice", query_string: "", body: "",
    raw_path: "/users/alice",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  _extract_params("/users/:name", "/users/alice", req.params)
  puts(path_param(req, "name"))
end

def print_path_param_missing(): Void
  var req = Request {
    method: "GET", path: "/users/alice", query_string: "", body: "",
    raw_path: "/users/alice",
    header_keys: vec_new<String>(), header_vals: vec_new<String>(),
    params: map_new(), query: map_new(), context: map_new()
  }
  var result = path_param(req, "missing")
  if str_byte_len(result) == 0
    puts("empty")
  else
    puts(result)
  end
end

def print_no_params(): Void
  var params = map_new()
  _extract_params("/static/path", "/static/path", params)
  var keys = params.keys()
  puts(str_from_int(keys.size))
end

# =============================================================================
# Tests
# =============================================================================

def main(): Int
  describe("_extract_params") do ->
    it("extracts single path param") do ->
      assert_output("42\n", print_single_param)
    end

    it("extracts multiple path params") do ->
      assert_output("42\n99\n", print_two_params)
    end

    it("handles params with surrounding text") do ->
      assert_output("my-item\n", print_param_with_text)
    end

    it("URL-decodes path param values") do ->
      assert_output("hello world\n", print_encoded_param)
    end

    it("returns empty for non-existent param name") do ->
      assert_output("empty\n", print_missing_param)
    end

    it("extracts nothing for static patterns") do ->
      assert_output("0\n", print_no_params)
    end
  end

  describe("path_param API") do ->
    it("gets param from request") do ->
      assert_output("alice\n", print_path_param_api)
    end

    it("returns empty for missing param") do ->
      assert_output("empty\n", print_path_param_missing)
    end
  end

  return qspec_main()
end
