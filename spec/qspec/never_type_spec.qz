## Never Type Tests
##
## Contract:
##   1. If-else divergence: one branch returns value, other panics → OK.
##   2. Match arm divergence: one arm value, other arm panics → OK.
##   3. Explicit Never return type: `def f(): Never` must diverge.
##   4. Nested conditionals: multiple divergent paths composable.
##   5. Option unwrap: match with panic on None.
##   6. exit() returns Never: usable in value context.
##   7. panic() returns Never: usable in value context.
##   8. unreachable() returns Never: type-compatible with Int.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("never type") do ->
    it("if branch returns Int, else branch panics") do ->
      assert_eq(nt_check_positive(42), 42)
    end
    it("match arm returns Int, other arm panics") do ->
      opt = Option::Some(42)
      v = match opt
        Some(x) => x
        None => panic("expected Some")
      end
      assert_eq(v, 42)
    end
    it("function with explicit never return type") do ->
      assert_run_exits("def never_fn(): Never\n  panic(\"oops\")\nend\ndef main(): Int\n  return 42\nend\n", 42)
    end
    it("nested conditionals with divergent paths") do ->
      assert_eq(nt_classify(42), 1)
    end
    it("unwrap_or with fallback") do ->
      a = nt_unwrap_or(Option::Some(42), 0)
      b = nt_unwrap_or(Option::None, 99)
      assert_eq(a, 42)
      assert_eq(b, 99)
    end
    it("exit returns never type") do ->
      assert_run_exits("""
def main(): Int
  if true
    exit(42)
  end
  return 0
end
""", 42)
    end

    it("panic returns never type") do ->
      assert_run_panics("""
def main(): Int
  if true
    panic("never returns")
  end
  return 0
end
""", "never returns")
    end

    it("unreachable returns never type (compiles in Int context)") do ->
      assert_run_exits(nt_unreachable_src(), 42)
    end

    it("panic in deeply nested function call") do ->
      assert_run_exits("""
        def must_be_positive(x: Int): Int
          if x > 0
            return x
          else
            panic("not positive")
          end
          return 0
        end
        def double_positive(x: Int): Int
          return must_be_positive(x) * 2
        end
        def main(): Int
          return double_positive(21)
        end
        """, 42)
    end

    it("exit with computed value") do ->
      assert_run_exits("""
        def compute(): Int
          return 42
        end
        def main(): Int
          exit(compute())
          return 0
        end
        """, 42)
    end

    it("never type in let binding context") do ->
      assert_run_exits("""
        def get_or_die(opt: Int): Int
          return match opt
            Some(x) => x
            None => panic("was None")
            _ => panic("impossible")
          end
        end
        def main(): Int
          return get_or_die(Option::Some(42))
        end
        """, 42)
    end
  end
  return qspec_main()
end
def nt_check_positive(x: Int): Int
  if x > 0
    return x
  else
    panic("must be positive")
  end
  return 0
end
def nt_classify(x: Int): Int
  if x < 0
    panic("negative")
  end
  if x > 100
    panic("too big")
  end
  if x > 10
    return 1
  end
  return 2
end
def nt_unwrap_or(opt: Int, fallback: Int): Int
  return match opt
    Some(x) => x
    None => fallback
    _ => fallback
  end
end
def nt_unreachable_src(): String
  var s = "def main(): Int\n"
  s = s + "  if true\n"
  s = s + "    return 42\n"
  s = s + "  end\n"
  s = s + "  unreachable()\n"
  s = s + "end\n"
  return s
end
