## Match Arm Move Tracking Tests (STR2-5)
##
## Contract:
##   1. Arm isolation: each arm starts from the same baseline. Arm 2 does NOT
##      see arm 1's move.
##   2. Consistent all-arm moves: if ALL arms move a binding, it is Moved after
##      the match. Use after = QZ1212.
##   3. Consistent all-arm moves with no use after: compiles OK.
##   4. Inconsistent moves: moved in SOME but not ALL arms = QZ1214.
##   5. No-arm moves: variable stays live after match.
##   6. N-way merge: works correctly with 3+ arms, not just binary.
##   7. Return in arms: `return` divergently transfers ownership.
##   8. Re-init after match move: reassignment restores Live.
##   9. Guard expressions: guards don't affect move tracking.
##  10. Borrow in arm vs move in arm: inconsistency detected.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category 1: Consistent moves across all arms
  # ===========================================================================
  describe("match arms: consistent moves") do ->
    it("move in all arms — variable is moved after match") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          match 1
            1 => consume(a)
            _ => consume(a)
          end
          return a.x
        end
        """, "QZ1212")
    end

    it("move in all arms, no use after — compiles OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var result = 0
          match 1
            1 => result = consume(a)
            _ => result = consume(a)
          end
          return result
        end
        """, 42)
    end

    it("return in all arms transfers ownership") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          match 1
            1 => return consume(a)
            _ => return consume(a)
          end
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category 2: Inconsistent moves (QZ1214)
  # ===========================================================================
  describe("match arms: inconsistent moves") do ->
    it("move in one arm only — QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end

    it("move in first arm, not in second — QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 2
            1 => consume(a)
            2 => 99
            _ => consume(a)
          end
          return 0
        end
        """, "QZ1214")
    end
  end

  # ===========================================================================
  # Category 3: No moves — variable stays live
  # ===========================================================================
  describe("match arms: no moves") do ->
    it("no move in any arm — variable usable after match") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          match 1
            1 => 10
            _ => 20
          end
          return consume(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category 4: Arm isolation (arms don't see each other's moves)
  # ===========================================================================
  describe("match arms: isolation") do ->
    it("two arms both move same var — no double-move error") do ->
      ## Each arm starts from the same baseline. If arm isolation is broken,
      ## arm 2 would see arm 1's move and emit QZ1212 (use of moved value).
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var result = 0
          match 1
            1 => result = consume(a)
            2 => result = consume(a)
            _ => result = consume(a)
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category 5: Subject consumption + arm moves
  # ===========================================================================
  describe("match arms: subject + body moves") do ->
    it("match subject consumed, separate var moved in arms") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          var b = Res { x: 2 }
          match a.x
            1 => consume(b)
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end
  end

  # ===========================================================================
  # Category 6: Re-initialization after match move
  # ===========================================================================
  describe("match arms: re-init after move") do ->
    it("re-init after all-arm move restores usability") do ->
      assert_compile_succeeds("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          match 1
            1 => consume(a)
            _ => consume(a)
          end
          a = Res { x: 99 }
          return a.x
        end
        """)
    end
  end

  # ===========================================================================
  # Category 7: N-way merge with 4+ arms
  # ===========================================================================
  describe("match arms: N-way merge") do ->
    it("4 arms all move — no use after = OK") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          var result = 0
          match 1
            1 => result = consume(a)
            2 => result = consume(a)
            3 => result = consume(a)
            _ => result = consume(a)
          end
          return result
        end
        """, 42)
    end

    it("3 of 4 arms move = QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            2 => consume(a)
            3 => 0
            _ => consume(a)
          end
          return 0
        end
        """, "QZ1214")
    end
  end

  # ===========================================================================
  # Category 8: Borrow vs move across arms
  # ===========================================================================
  describe("match arms: borrow vs move") do ->
    it("all arms borrow — variable stays live") do ->
      assert_run_exits("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def peek(r: &Res): Int = r.x
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 42 }
          match 1
            1 => peek(&a)
            _ => peek(&a)
          end
          return consume(a)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category 9: Nested match
  # ===========================================================================
  describe("match arms: nested match") do ->
    it("inner match moves in all arms, outer match partial = QZ1214") do ->
      assert_compile_error("""
        trait Drop
          def drop(self: Int): Void
            return
          end
        end
        struct Res
          x: Int
        end
        extend Res with Drop
          def drop(self: Int): Void
            return
          end
        end
        def consume(r: Res): Int = r.x
        def main(): Int
          var a = Res { x: 1 }
          match 1
            1 => consume(a)
            2 =>
              match 3
                3 => consume(a)
                _ => consume(a)
              end
            _ => 0
          end
          return 0
        end
        """, "QZ1214")
    end
  end

  return qspec_main()
end
