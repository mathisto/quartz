## Defer Statement Tests
##
## Contract:
##   1. Basic defer: runs at end of function.
##   2. Defer before return: fires before function exit.
##   3. Early return: defer fires even on early return.
##   4. LIFO ordering: multiple defers execute in reverse order.
##   5. Function calls: defer with arguments.
##   6. Late evaluation: arguments evaluated at defer execution time.
##   7. Loop defer: fires each iteration at loop body exit.
##   8. Break: loop defer fires before break, outer defer at function exit.
##   9. If block: defer in if fires at block exit.
##  10. Nested scopes: defers fire at each scope exit.
##  11. Resource management: simulated open/close pairs.
##  12. Compound expressions: defer with global state.
##  13. $try error path: defer fires on error return.
##  14. Continue: loop defer fires before continue.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("defer statement") do ->
    it("executes defer at end of function") do ->
      assert_output("working\ncleanup\n", defer_basic)
    end
    it("executes defer before return") do ->
      assert_output("before return\ndefer ran\n", defer_before_return)
    end
    it("executes defer on early return") do ->
      assert_output("defer ran\n", defer_early_return)
    end
    it("LIFO ordering") do ->
      assert_output("working\nthird\nsecond\nfirst\n", defer_lifo)
    end
    it("LIFO across early return") do ->
      assert_output("third\nsecond\nfirst\n", defer_lifo_early_return)
    end
    it("defers function calls with arguments") do ->
      assert_output("using resource\nresource freed\n", defer_fn_args)
    end
    it("evaluates arguments at execution time") do ->
      assert_output("20\n", defer_late_eval)
    end
    it("defers in loop each iteration") do ->
      assert_output("loop defer\nloop defer\nloop defer\nafter loop\n", defer_loop)
    end
    it("break exits loop then defer at function exit") do ->
      assert_output("after loop\nouter defer\n", defer_break)
    end
    it("defer in if block at block exit") do ->
      assert_output("in if\ninner\nafter if\nouter\n", defer_if_block)
    end
    it("multiple nested scopes") do ->
      assert_output("innermost\n3\nmiddle\n2\nouter\n1\n", defer_nested_scopes)
    end
    it("pairs with file operations (simulated)") do ->
      assert_output("opening file\nprocessing file\nclosing file\n", defer_file_sim)
    end
    it("handles multiple resources") do ->
      assert_output("acquire A\nacquire B\nacquire C\nworking\nrelease C\nrelease B\nrelease A\n", defer_multi_resource)
    end
    it("compound expressions with global var") do ->
      assert_output("3\n", defer_compound)
    end
    it("fires defer on $try error path") do ->
      assert_run_stdout_eq("""
        import result
        def failing(): Result<Int, Int> = Result::Err(99)
        def work(): Result<Int, Int>
          defer puts("cleanup")
          var x = try failing()
          puts("unreachable")
          return Result::Ok(x)
        end
        def main(): Int
          work()
          puts("done")
          return 0
        end
        """, "cleanup\ndone\n")
    end
    it("fires defer inside loop on break") do ->
      assert_output("iter 0\nloop cleanup\nafter\nouter cleanup\n", defer_break_inner)
    end
    it("fires defer inside loop on continue") do ->
      assert_output("iter 0\nloop cleanup\niter 1\nloop cleanup\niter 2\nloop cleanup\nafter\nouter cleanup\n", defer_continue_inner)
    end
  end
  return qspec_main()
end

def defer_basic(): Void
  defer puts("cleanup")
  puts("working")
end

def defer_before_return(): Void
  defer puts("defer ran")
  puts("before return")
end

def defer_lifo(): Void
  defer puts("first")
  defer puts("second")
  defer puts("third")
  puts("working")
end

def defer_cleanup(msg: String): Void = puts(msg)

def defer_fn_args(): Void
  defer defer_cleanup("resource freed")
  puts("using resource")
end

def defer_log(n: Int): Void = print_int(n)

def defer_late_eval(): Void
  var x = 10
  defer defer_log(x)
  x = 20
end

def defer_loop(): Void
  var i = 0
  while i < 3
    defer puts("loop defer")
    i += 1
  end
  puts("after loop")
end

def defer_break(): Void
  defer puts("outer defer")
  var i = 0
  while i < 5
    if i == 2
      break
    end
    i += 1
  end
  puts("after loop")
end

def defer_if_block(): Void
  defer puts("outer")
  if true
    defer puts("inner")
    puts("in if")
  end
  puts("after if")
end

def defer_nested_scopes(): Void
  defer puts("1")
  if true
    defer puts("2")
    if true
      defer puts("3")
      puts("innermost")
    end
    puts("middle")
  end
  puts("outer")
end

def defer_file_open(path: String): Int
  puts("opening file")
  return 42
end

def defer_file_close(handle: Int): Void = puts("closing file")

def defer_file_sim(): Void
  var f = defer_file_open("test.txt")
  defer defer_file_close(f)
  puts("processing file")
end

def defer_acquire(name: String): Int
  puts("acquire " + name)
  return 1
end

def defer_release(name: String): Void
  puts("release " + name)
end

def defer_multi_resource(): Void
  var a = defer_acquire("A")
  defer defer_release("A")
  var b = defer_acquire("B")
  defer defer_release("B")
  var c = defer_acquire("C")
  defer defer_release("C")
  puts("working")
end

var defer_counter = 0

def defer_inc(): Int
  defer_counter += 1
  return defer_counter
end

def defer_show(): Void = print_int(defer_counter)

def defer_compound(): Void
  defer defer_show()
  var x = defer_inc()
  var y = defer_inc()
  var z = defer_inc()
end

def defer_early_return(): Void
  defer puts("defer ran")
  if true
    return
  end
  puts("should not print")
end

def defer_lifo_early_return(): Void
  defer puts("first")
  defer puts("second")
  defer puts("third")
  if true
    return
  end
  puts("should not print")
end

def defer_break_inner(): Void
  defer puts("outer cleanup")
  var i = 0
  while i < 5
    defer puts("loop cleanup")
    puts("iter " + "#{i}")
    if i == 0
      break
    end
    i += 1
  end
  puts("after")
end

def defer_continue_inner(): Void
  defer puts("outer cleanup")
  var i = 0
  while i < 3
    defer puts("loop cleanup")
    puts("iter " + "#{i}")
    i += 1
    continue
  end
  puts("after")
end
