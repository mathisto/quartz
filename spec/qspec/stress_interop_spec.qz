## STRESS: Feature Interactions
##
## Adversarial tests probing cross-feature interactions:
## generics+closures+moves, pattern matching on UFCS results,
## for-in with moves, string interpolation with complex exprs,
## @derive on generic structs, closures in match arms.
##
## Contract:
##   1. Interop: generics + closures + structs.
##   2. Interop: match on function results.
##   3. Interop: for-in + collections.
##   4. Interop: string operations.
##   5. Interop: @derive + traits.
##   6. Interop: closures in match arms.
##   7. Interop: enum + struct.

import * from qspec
import * from qspec/subprocess

def main(): Int
  # ===========================================================================
  # Category A: Generics + Closures + Structs
  # ===========================================================================
  describe("interop: generics + closures + structs") do ->
    it("generic struct returned, field used in closure") do ->
      assert_run_exits("""
        struct Box<T>
          value: T
        end
        def main(): Int
          b = Box<Int> { value: 42 }
          f = -> b.value
          return f()
        end
        """, 42)
    end

    it("closure captures generic function result") do ->
      assert_run_exits("""
        def id<T>(x: T): T = x
        def main(): Int
          val = id(42)
          f = -> val
          return f()
        end
        """, 42)
    end

    it("generic function applied via UFCS inside closure") do ->
      assert_run_exits("""
        def inc<T>(x: T): T = x + 1
        def main(): Int
          f = -> 41.inc()
          return f()
        end
        """, 42)
    end

    it("struct with closure field, closure captures outer") do ->
      assert_run_exits("""
        struct Handler
          action: Fn(Int): Int
        end
        def main(): Int
          offset = 20
          h = Handler { action: (x: Int) -> x + offset }
          return h.action(22)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category B: Pattern Matching + Function Results
  # ===========================================================================
  describe("interop: match on function results") do ->
    it("match on function return value") do ->
      assert_run_exits("""
        def classify(x: Int): Int
          if x > 10
            return 1
          end
          return 0
        end
        def main(): Int
          result = match classify(42)
            1 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match on Vec size") do ->
      assert_run_exits("""
        def main(): Int
          var v: Vec<Int> = vec_new()
          v.push(1)
          v.push(2)
          v.push(3)
          result = match v.size
            3 => 42
            _ => 0
          end
          return result
        end
        """, 42)
    end

    it("match result passed to function") do ->
      assert_run_exits("""
        def double(x: Int): Int = x * 2
        def main(): Int
          x = 2
          val = match x
            1 => 10
            2 => 21
            _ => 0
          end
          return double(val)
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category C: For-In Loops + Collections
  # ===========================================================================
  describe("interop: for-in + collections") do ->
    it("for-in range with accumulator") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0..7
            sum = sum + i
          end
          return sum + 21
        end
        """, 42)
    end

    it("for-in range with break condition") do ->
      assert_run_exits("""
        def main(): Int
          var sum = 0
          for i in 0..100
            sum = sum + i
            if sum > 40
              return sum
            end
          end
          return 0
        end
        """, 45)
    end

    it("nested for-in ranges") do ->
      assert_run_exits("""
        def main(): Int
          var count = 0
          for i in 0..3
            for j in 0..3
              count += 1
            end
          end
          return count + 33
        end
        """, 42)
    end
  end

  ## NOTE: Cannot use #{...} in heredoc strings - it gets parsed by outer
  ## compiler. Use str_concat or str_from_int workarounds instead.
  describe("interop: string operations") do ->
    it("str_concat builds string") do ->
      assert_run_exits("""
        def main(): Int
          s = str_concat("hello", " world")
          if s.size == 11
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("str_from_int used in concat") do ->
      assert_run_exits("""
        def main(): Int
          s = str_concat("val: ", str_from_int(42))
          if s.size > 3
            return 42
          end
          return 0
        end
        """, 42)
    end

    it("multiple str_concat chain") do ->
      assert_run_exits("""
        def main(): Int
          a = str_from_int(10)
          b = str_from_int(20)
          s = str_concat(str_concat(a, " and "), b)
          if s.size > 5
            return 42
          end
          return 0
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category E: @derive + Traits
  # ===========================================================================
  describe("interop: @derive + traits") do ->
    it("@derive(Eq) on struct, equality tested") do ->
      assert_run_exits("""
        import traits
        @derive(Eq)
        struct Val
          n: Int
        end
        def main(): Int
          a = Val { n: 42 }
          b = Val { n: 42 }
          if Val::op_eq(a, b)
            return a.n
          end
          return 0
        end
        """, 42)
    end

    it("@derive(Clone) and clone used") do ->
      assert_run_exits("""
        import traits
        @derive(Clone)
        struct Val
          n: Int
        end
        def main(): Int
          a = Val { n: 42 }
          b = Val::clone(a)
          return b.n
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category F: Closures in Match Arms
  # ===========================================================================
  describe("interop: closures in match arms") do ->
    it("lambda selected via match, then called") do ->
      assert_run_exits("""
        def main(): Int
          x = 2
          f = match x
            1 => (n: Int) -> n + 10
            2 => (n: Int) -> n * 2
            _ => (n: Int) -> n
          end
          return f(21)
        end
        """, 42)
    end

    it("closure capturing outer var, selected via match") do ->
      assert_run_exits("""
        def main(): Int
          base = 20
          x = 1
          f = match x
            1 => -> base + 22
            _ => -> 0
          end
          return f()
        end
        """, 42)
    end

    it("match arm calls closure immediately") do ->
      assert_run_exits("""
        def make_adder(n: Int): Fn(Int): Int
          return (x: Int) -> x + n
        end
        def main(): Int
          f = make_adder(22)
          x = 1
          result = match x
            1 => f(20)
            _ => 0
          end
          return result
        end
        """, 42)
    end
  end

  # ===========================================================================
  # Category G: Enum + Struct Interaction
  # ===========================================================================
  describe("interop: enum + struct") do ->
    it("struct inside enum variant") do ->
      assert_run_exits("""
        struct Config
          value: Int
        end
        enum Setting
          Active(cfg: Config)
          Inactive
        end
        def main(): Int
          s = Setting::Active(Config { value: 42 })
          match s
            Setting::Active(c) => return c.value
            Setting::Inactive => return 0
          end
        end
        """, 42)
    end

    it("function returns enum, matched by caller") do ->
      assert_run_exits("""
        enum Status
          Ok(value: Int)
          Error
        end
        def compute(x: Int): Status
          if x > 0
            return Status::Ok(x)
          end
          return Status::Error
        end
        def main(): Int
          match compute(42)
            Status::Ok(v) => return v
            Status::Error => return 0
          end
        end
        """, 42)
    end
  end

  return qspec_main()
end
