## std/effects helpers — Milestone I acceptance spec.
##
## Operation Piezoelectric Effects, Phase 2, Milestone I.
##
## Verifies effect_arg_int and effect_arg_string decode positional
## op args identically to the raw `load(argv, i)` / `as_string(load(argv, i))`
## patterns used throughout the pilot specs. Shape = one multi-arg op,
## one handler, assertions on the decoded values.

import * from qspec
import std/effects

def main(): Int
  describe("std/effects helpers (piezo I)") do ->
    it("effect_arg_int decodes positional Int arg") do ->
      assert_eq(effect_arg_int_via_handler(), 42)
    end

    it("effect_arg_string decodes positional String arg") do ->
      assert_output("hello from handler\n", run_string_handler)
    end

    it("handlers combining int + string args decode both cleanly") do ->
      assert_output("line=5 col=7 msg=bad token\n", run_mixed_handler)
    end
  end
  return qspec_main()
end

# --- Integer-only op --------------------------------------------------------

effect TagInt
  def tag_int(x: Int): Int
end

def tag_int_capture(op_name: Int, argc: Int, argv: Int): Int
  # Using effect_arg_int rather than the raw load(argv, 0) form.
  return effects::effect_arg_int(argv, 0)
end

# Uses ctx wrapper so the spec body can call it.
def effect_arg_int_via_handler(): Int
  var r = with TagInt { tag_int: tag_int_capture } do ->
    tag_int(42)
  end
  return r
end

# --- Single String op -------------------------------------------------------

effect TagStr
  def tag_str(s: String): Int
end

def tag_str_print(op_name: Int, argc: Int, argv: Int): Int
  puts(effects::effect_arg_string(argv, 0))
  return 0
end

def run_string_handler(): Void
  with TagStr { tag_str: tag_str_print } do ->
    tag_str("hello from handler")
  end
end

# --- Mixed Int + Int + String op ------------------------------------------

effect TagMix
  def tag_mix(line: Int, col: Int, msg: String): Int
end

def tag_mix_print(op_name: Int, argc: Int, argv: Int): Int
  var line = effects::effect_arg_int(argv, 0)
  var col = effects::effect_arg_int(argv, 1)
  var msg = effects::effect_arg_string(argv, 2)
  puts("line=" + line.to_s() + " col=" + col.to_s() + " msg=" + msg)
  return 0
end

def run_mixed_handler(): Void
  with TagMix { tag_mix: tag_mix_print } do ->
    tag_mix(5, 7, "bad token")
  end
end
