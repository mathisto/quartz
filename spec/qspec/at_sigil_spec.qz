## @x Sigil Tests
##
## Contract:
##   1. @field read: `@x` accesses struct field via implicit self in impl.
##   2. @field write: `@count = expr` assigns to field via implicit self.
##   3. Single @field: works for single-field structs.
##   4. Error outside impl: `@x` in non-impl function is compile error.
##   5. Expression: `@width * @height` evaluates correctly.
##   6. Conditional: @field used in if condition.
##   7. Computed: @field used in method returning computed value.
##   8. Chained mutation: multiple @field writes in sequence.
##   9. Method chain: @field used across multiple method calls.
##  10. @field in nested control flow (if, for).
##  11. @field in lambda/closure within method.

import * from qspec

struct APoint
  x: Int
  y: Int
end

extend APoint
  def sum(): Int
    return @x + @y
  end
end

struct ACounter
  count: Int
end

extend ACounter
  def increment(&mut self): Int
    @count = @count + 1
    return @count
  end
end

struct Wrapper
  value: Int
end

extend Wrapper
  def get_value(): Int
    return @value
  end
end

struct ARect
  width: Int
  height: Int
end

extend ARect
  def area(): Int
    return @width * @height
  end

  def conditional_area(): Int
    if @width > 0
      return @width * @height
    end
    return 0
  end

  def sum_heights(n: Int): Int
    var total = 0
    for i in 0..n
      total = total + @height
    end
    return total
  end

  def apply_to_width(f: Fn(Int): Int): Int
    return f(@width)
  end

  def width_plus_via_lambda(): Int
    var adder = x: Int -> x + @height
    return adder(@width)
  end
end

def main(): Int
  describe("@x sigil for implicit self") do ->
    it("accesses fields with @x in extend method") do ->
      p = APoint { x: 10, y: 20 }
      assert_eq(p.sum(), 30)
    end
    it("assigns to fields with @x in extend method") do ->
      var c = ACounter { count: 0 }
      c.increment()
      c.increment()
      assert_eq(c.increment(), 3)
    end
    it("@field access works for single field") do ->
      w = Wrapper { value: 42 }
      assert_eq(w.get_value(), 42)
    end
    it("@x not rewritten outside extend block") do ->
      assert_compile_fails("def main(): Int\n  return @x\nend\n")
    end
    it("multiple @field accesses in expression") do ->
      r = ARect { width: 7, height: 8 }
      assert_eq(r.area(), 56)
    end
    it("@field used in conditional logic") do ->
      var c = ACounter { count: 5 }
      c.increment()
      assert_eq(c.increment(), 7)
    end
    it("@field returns computed value from multiple fields") do ->
      p = APoint { x: 3, y: 4 }
      assert_eq(p.sum(), 7)
    end
    it("multiple @field writes in sequence") do ->
      var c = ACounter { count: 0 }
      c.increment()
      c.increment()
      c.increment()
      c.increment()
      assert_eq(c.increment(), 5)
    end
    it("@field across multiple method calls on same struct") do ->
      var r = ARect { width: 3, height: 4 }
      assert_eq(r.area(), 12)
      var r2 = ARect { width: 10, height: 10 }
      assert_eq(r2.area(), 100)
    end
    it("@field in nested if condition and body") do ->
      r = ARect { width: 5, height: 6 }
      assert_eq(r.conditional_area(), 30)
    end
    it("@field in for-loop body") do ->
      r = ARect { width: 3, height: 7 }
      assert_eq(r.sum_heights(4), 28)
    end
    it("@field passed to lambda parameter") do ->
      r = ARect { width: 8, height: 2 }
      assert_eq(r.apply_to_width(x: Int -> x * 3), 24)
    end
    it("@field captured in lambda within method") do ->
      r = ARect { width: 5, height: 10 }
      assert_eq(r.width_plus_via_lambda(), 15)
    end
  end

  return qspec_main()
end
