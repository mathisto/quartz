## Dominator Tree Tests
##
## Contract:
##   1. Trivial cfg.
##   2. Branching cfg.
##   3. Loop cfg.
##   4. Complex cfg.

import * from qspec

def dt_single_block(): Int = 42

def dt_linear(): Int
  var x = 10
  x = x + 1
  x = x + 1
  return x
end

def dt_diamond(): Int
  var x = 5
  if x > 3
    x = x + 10
  else
    x = x + 20
  end
  return x
end

def dt_nested_diamond(): Int
  var x = 10
  if x > 5
    if x > 8
      x = x + 1
    else
      x = x + 2
    end
  else
    x = x + 100
  end
  return x
end

def dt_while_loop(): Int
  var sum = 0
  var i = 0
  while i < 10
    sum = sum + i
    i = i + 1
  end
  return sum
end

def dt_nested_loops(): Int
  var total = 0
  var i = 0
  while i < 3
    var j = 0
    while j < 4
      total += 1
      j += 1
    end
    i = i + 1
  end
  return total
end

def dt_search(target: Int): Int
  var i = 0
  while i < 100
    if i == target
      return i
    end
    i = i + 1
  end
  return -1
end

def dt_classify(x: Int): Int
  if x > 0
    return 1
  else
    return 0
  end
end

def dt_break_loop(): Int
  var i = 0
  while true
    if i == 7
      break
    end
    i = i + 1
  end
  return i
end

def dt_continue_loop(): Int
  var sum = 0
  var i = 0
  while i < 10
    i = i + 1
    if i % 2 == 0
      continue
    end
    sum = sum + i
  end
  return sum
end

def dt_match_expr(): Int
  var x = 3
  var y = match x
    1 => 10
    2 => 20
    3 => 30
    _ => 0
  end
  return y
end

def dt_for_range(): Int
  var sum = 0
  for i in 1..6
    sum = sum + i
  end
  return sum
end

def dt_deeply_nested(): Int
  var x = 0
  var i = 0
  while i < 5
    if i > 2
      if i == 4
        x = x + 100
      else
        x = x + 10
      end
    else
      x = x + 1
    end
    i = i + 1
  end
  return x
end

def dt_diamond_fn(x: Int): Int
  if x > 0
    return x * 2
  else
    return x * 3
  end
end

def dt_loop_sum(n: Int): Int
  var s = 0
  var i = 0
  while i < n
    s = s + dt_diamond_fn(i)
    i = i + 1
  end
  return s
end

def dt_short_circuit(): Int
  var i = 0
  var count = 0
  while i < 20 and count < 5
    count += 1
    i = i + 3
  end
  return count
end

def main(): Int
  describe("trivial CFG") do ->
    it("handles single block") do ->
      assert_eq(dt_single_block(), 42)
    end

    it("handles linear chain") do ->
      assert_eq(dt_linear(), 12)
    end
  end

  describe("branching CFG") do ->
    it("handles diamond CFG (if/else merge)") do ->
      assert_eq(dt_diamond(), 15)
    end

    it("handles nested diamond CFG") do ->
      assert_eq(dt_nested_diamond(), 11)
    end

    it("handles if/else with return in both arms") do ->
      assert_eq(dt_classify(5), 1)
    end

    it("handles match expression (multi-way branch)") do ->
      assert_eq(dt_match_expr(), 30)
    end
  end

  describe("loop CFG") do ->
    it("handles while loop (back edge)") do ->
      assert_eq(dt_while_loop(), 45)
    end

    it("handles nested while loops") do ->
      assert_eq(dt_nested_loops(), 12)
    end

    it("handles loop with early return") do ->
      assert_eq(dt_search(42), 42)
    end

    it("handles loop with break") do ->
      assert_eq(dt_break_loop(), 7)
    end

    it("handles loop with continue") do ->
      assert_eq(dt_continue_loop(), 25)
    end

    it("handles for-in range loop") do ->
      assert_eq(dt_for_range(), 15)
    end
  end

  describe("complex CFG") do ->
    it("handles deeply nested control flow") do ->
      assert_eq(dt_deeply_nested(), 113)
    end

    it("handles function calls across different CFG shapes") do ->
      assert_eq(dt_loop_sum(5), 20)
    end

    it("handles short-circuit and/or in loop condition") do ->
      assert_eq(dt_short_circuit(), 5)
    end
  end

  return qspec_main()
end
