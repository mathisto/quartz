## Multi-effect composition stress — Phase 2 Milestone P2.c.
##
## Operation Piezoelectric Effects, Phase 2, Milestone P2.c.
##
## Covers:
##   * Comma-list `with E1(...), E2(...), ... do ... end` syntax sugar for
##     nested with-blocks (parser desugar in ps_parse_handler_block).
##   * Functions declaring 3+ effects on their `can` row.
##   * Rémy-style row merging across multi-label rows — State + Reader
##     + Log + Throws in a single row unify with outer installs.
##   * Interaction of stateful (State, Reader — evidence-slot carriers)
##     with non-stateful effects (Log, Throws — record-dispatch only).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("Multi-effect composition — comma-list with + 3+ effect rows") do ->
    it("comma-list `with Reader(cfg), State(0)` desugars to nested installs") do ->
      assert_run_stdout_eq("""
import std/state
import std/reader

def main(): Int
  var r = with Reader(10), State(0) do ->
    set(ask())
    set(get() + ask())
    get()
  end
  puts(r.to_s())
  return 0
end
""", "20\n")
    end

    it("3-way comma-list: Reader + State + Log") do ->
      assert_run_stdout_eq("""
import std/state
import std/reader
import std/log

def my_emit(op: Int, argc: Int, argv: Int): Int
  puts("log: " + as_string(load(argv, 0)))
  0
end

def main(): Int
  var r = with Log { emit: my_emit }, Reader(7), State(1) do ->
    log::info("start")
    set(get() * ask())
    set(get() + ask())
    get()
  end
  puts(r.to_s())
  return 0
end
""", "log: [INFO] start\n14\n")
    end

    it("function with `can State, Reader, Log` row — all performs routed") do ->
      assert_run_stdout_eq("""
import std/state
import std/reader
import std/log

def process(): Int can State, Reader, Log
  log::info("pre")
  set(get() + ask())
  log::info("post")
  return get()
end

def captured_emit(op: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  0
end

def main(): Int
  var r = with Log { emit: captured_emit }, Reader(100), State(5) do ->
    process()
  end
  puts(r.to_s())
  return 0
end
""", "[INFO] pre\n[INFO] post\n105\n")
    end

    it("comma-list with Throws unwinds through outer state scope") do ->
      # `with Throws { throw: h }, State(v)` — throw from body longjmps
      # past State's install. State's slot is pushed+popped via normal
      # install discipline; the unwind pops it correctly.
      assert_run_stdout_eq("""
import std/state

effect Throws
  def throw(msg: String): Int = operation
end

def h_throw(op: Int, argc: Int, argv: Int): Int
  puts("caught: " + as_string(load(argv, 0)))
  return 99
end

def main(): Int
  var r = with Throws { throw: h_throw }, State(7) do ->
    set(get() + 1)
    throw("boom")
    get()
  end
  puts(r.to_s())
  return 0
end
""", "caught: boom\n99\n")
    end

    it("nested State + outer Reader read back original after inner set") do ->
      # Inner State mutations must not leak to outer scope. Reader is
      # unaffected because it's read-only. Outer can observe its own
      # Reader value after inner scope exits.
      assert_run_stdout_eq("""
import std/state
import std/reader

def main(): Int
  var r = with Reader(100), State(1) do ->
    set(ask())
    var inner = with State(50) do ->
      set(get() * 2)
      get()
    end
    inner + get()
  end
  puts(r.to_s())
  return 0
end
""", "200\n")
    end

    it("4-effect row: State + Reader + Log + Throws — composed stack") do ->
      # Real use case: a parser-like subsystem that reads ambient config,
      # mutates parse state, logs progress, and can abort on error.
      # `step` returns early via Throws unwind when state exceeds reader.
      assert_run_stdout_eq("""
import std/state
import std/reader
import std/log

effect MyThrows
  def my_throw(msg: String): Int = operation
end

def h_throw(op: Int, argc: Int, argv: Int): Int
  puts("abort")
  return -1
end

def my_log(op: Int, argc: Int, argv: Int): Int
  puts(as_string(load(argv, 0)))
  0
end

def step(): Int can State, Reader, Log, MyThrows
  log::info("step")
  if get() >= ask()
    my_throw("overflow")
  end
  set(get() + 1)
  return get()
end

def main(): Int
  var r = with MyThrows { my_throw: h_throw }, Log { emit: my_log }, Reader(2), State(0) do ->
    step()
    step()
    step()
    step()
  end
  puts(r.to_s())
  return 0
end
""", "[INFO] step\n[INFO] step\n[INFO] step\nabort\n-1\n")
    end
  end

  return qspec_main()
end
