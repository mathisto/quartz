## QSpec coverage for the three test-handler factories shipped in
## `std/cache.qz` Phase A.3 Phase 3:
##
##   - cache_in_memory_handler   — module-level state for hermetic tests
##   - cache_disabled_handler    — every op returns sentinel-miss
##   - cache_tracing_handler     — append (op, args) to log + forward to default
##
## 3 handlers × 6 ops = 18 tests. Each handler is bound to ALL 6 ops via
## the `with Cache { ... } do ... end` block so any op call inside the
## block routes through the handler under test.
##
## In-memory handler tests pair save+load to validate round-trip semantics
## per op; cross-key isolation is implicit (each test uses its own
## (module, hash) tuple).
##
## Tracing handler tests bind all 6 ops to cache_tracing_handler and
## assert the trace log captures one entry per call, with the expected
## op-name + key-args summary.

import * from qspec
import std/cache
import ast

# ============================================================
# Group 1: cache_disabled_handler — sentinel-miss for every op.
# ============================================================

def t_disabled_lookup(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var r = cache_op_lookup("any.qz", "anyhash")
    if r.eq("")
      puts("miss")
    else
      puts("hit=#{r}")
    end
  end
end

def t_disabled_store(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var r = cache_op_store("any.qz", "anyhash", "; ir")
    puts("r=#{r}")
  end
end

def t_disabled_save_pool(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var pool = vec_new<String>()
    pool.push("a")
    pool.push("b")
    var r = cache_op_save_pool(pool)
    puts("r=#{r}")
  end
end

def t_disabled_load_pool(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var loaded = cache_op_load_pool()
    puts("size=#{loaded.size}")
  end
end

def t_disabled_save_ast(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var s = ast::ast_new_storage()
    var r = cache_op_save_ast("m.qz", "h", s, 0)
    puts("r=#{r}")
  end
end

def t_disabled_load_ast(): Void
  with Cache {
    cache_op_lookup: cache_disabled_handler,
    cache_op_store: cache_disabled_handler,
    cache_op_save_pool: cache_disabled_handler,
    cache_op_load_pool: cache_disabled_handler,
    cache_op_save_ast: cache_disabled_handler,
    cache_op_load_ast: cache_disabled_handler
  } do ->
    var v = cache_op_load_ast("m.qz", "h")
    puts("size=#{v.size}")
  end
end

# ============================================================
# Group 2: cache_in_memory_handler — round-trip via module state.
# ============================================================

def t_inmem_lookup(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    # Fresh state — empty lookup returns ""
    var miss = cache_op_lookup("foo.qz", "abc")
    if miss.eq("")
      puts("miss=ok")
    else
      puts("miss=BROKEN got #{miss}")
    end
  end
end

def t_inmem_store(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    var sr = cache_op_store("foo.qz", "abc", "; ir for foo")
    puts("sr=#{sr}")
    # Round-trip: lookup after store returns the stored ir
    var hit = cache_op_lookup("foo.qz", "abc")
    puts("hit=#{hit}")
    # Cross-key isolation — different hash returns ""
    var miss = cache_op_lookup("foo.qz", "different_hash")
    if miss.eq("")
      puts("isolation=ok")
    else
      puts("isolation=BROKEN got #{miss}")
    end
  end
end

def t_inmem_save_pool(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    var pool = vec_new<String>()
    pool.push("alpha")
    pool.push("beta")
    pool.push("gamma")
    var r = cache_op_save_pool(pool)
    puts("r=#{r}")
    # Verify the pool was stashed by reading it back
    var reloaded = cache_op_load_pool()
    puts("reloaded_size=#{reloaded.size}")
  end
end

def t_inmem_load_pool(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    # Empty before any save
    var pre = cache_op_load_pool()
    puts("pre=#{pre.size}")
    var pool = vec_new<String>()
    pool.push("first")
    pool.push("second")
    var sr = cache_op_save_pool(pool)
    puts("sr=#{sr}")
    var post = cache_op_load_pool()
    puts("post=#{post.size}")
    puts("post_first=#{post[0]}")
  end
end

def t_inmem_save_ast(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    var storage = ast::ast_new_storage()
    var root = 99
    var sr = cache_op_save_ast("lex.qz", "h1", storage, root)
    puts("sr=#{sr}")
    # Round-trip — load returns stashed storage handle + root
    var loaded = cache_op_load_ast("lex.qz", "h1")
    puts("size=#{loaded.size}")
    if loaded[1] == root
      puts("root_ok")
    else
      puts("root_BROKEN got #{loaded[1]}")
    end
  end
end

def t_inmem_load_ast(): Void
  cache_in_memory_reset()
  with Cache {
    cache_op_lookup: cache_in_memory_handler,
    cache_op_store: cache_in_memory_handler,
    cache_op_save_pool: cache_in_memory_handler,
    cache_op_load_pool: cache_in_memory_handler,
    cache_op_save_ast: cache_in_memory_handler,
    cache_op_load_ast: cache_in_memory_handler
  } do ->
    # Empty before any save — vec_new() returns Vec with size 0
    var miss = cache_op_load_ast("never.qz", "never")
    puts("miss_size=#{miss.size}")
    # After save, load returns 2-element Vec
    var s = ast::ast_new_storage()
    var sr = cache_op_save_ast("z.qz", "z1", s, 7)
    puts("sr=#{sr}")
    var hit = cache_op_load_ast("z.qz", "z1")
    puts("hit_size=#{hit.size} root=#{hit[1]}")
  end
end

# ============================================================
# Group 3: cache_tracing_handler — log + forward.
# ============================================================

def t_trace_lookup(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var _r = cache_op_lookup("trace.qz", "h1")
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def t_trace_store(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var _r = cache_op_store("trace.qz", "h2", "; body")
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def t_trace_save_pool(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var pool = vec_new<String>()
    pool.push("x")
    pool.push("y")
    pool.push("z")
    var _r = cache_op_save_pool(pool)
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def t_trace_load_pool(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var _r = cache_op_load_pool()
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def t_trace_save_ast(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var s = ast::ast_new_storage()
    var _r = cache_op_save_ast("trace.qz", "h3", s, 5)
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def t_trace_load_ast(): Void
  cache_tracing_reset()
  with Cache {
    cache_op_lookup: cache_tracing_handler,
    cache_op_store: cache_tracing_handler,
    cache_op_save_pool: cache_tracing_handler,
    cache_op_load_pool: cache_tracing_handler,
    cache_op_save_ast: cache_tracing_handler,
    cache_op_load_ast: cache_tracing_handler
  } do ->
    var _r = cache_op_load_ast("trace.qz", "h4")
  end
  var log = cache_tracing_log()
  puts("entries=#{log.size}")
  puts("0=#{log[0]}")
end

def main(): Int
  describe("Cache effect: test-handler factories (A.3 Phase 3)") do ->

    # Group 1: cache_disabled_handler — every op returns sentinel-miss
    it("cache_disabled: cache_op_lookup returns empty string (miss)") do ->
      assert_output("miss\n", t_disabled_lookup)
    end
    it("cache_disabled: cache_op_store returns 0 (silent no-op)") do ->
      assert_output("r=0\n", t_disabled_store)
    end
    it("cache_disabled: cache_op_save_pool returns 0 (silent no-op)") do ->
      assert_output("r=0\n", t_disabled_save_pool)
    end
    it("cache_disabled: cache_op_load_pool returns empty Vec") do ->
      assert_output("size=0\n", t_disabled_load_pool)
    end
    it("cache_disabled: cache_op_save_ast returns 0 (silent no-op)") do ->
      assert_output("r=0\n", t_disabled_save_ast)
    end
    it("cache_disabled: cache_op_load_ast returns empty Vec") do ->
      assert_output("size=0\n", t_disabled_load_ast)
    end

    # Group 2: cache_in_memory_handler — round-trip via module state
    it("cache_in_memory: cache_op_lookup returns empty before any store") do ->
      assert_output("miss=ok\n", t_inmem_lookup)
    end
    it("cache_in_memory: store-then-lookup round-trip + cross-key isolation") do ->
      assert_output("sr=0\nhit=; ir for foo\nisolation=ok\n", t_inmem_store)
    end
    it("cache_in_memory: cache_op_save_pool stashes the Vec") do ->
      assert_output("r=0\nreloaded_size=3\n", t_inmem_save_pool)
    end
    it("cache_in_memory: cache_op_load_pool returns last-saved Vec") do ->
      assert_output("pre=0\nsr=0\npost=2\npost_first=first\n", t_inmem_load_pool)
    end
    it("cache_in_memory: cache_op_save_ast stashes (storage, root)") do ->
      assert_output("sr=0\nsize=2\nroot_ok\n", t_inmem_save_ast)
    end
    it("cache_in_memory: cache_op_load_ast returns empty before save, 2-element after") do ->
      assert_output("miss_size=0\nsr=0\nhit_size=2 root=7\n", t_inmem_load_ast)
    end

    # Group 3: cache_tracing_handler — append to log + forward to default
    it("cache_tracing: cache_op_lookup logs op + (module, hash)") do ->
      assert_output("entries=1\n0=lookup trace.qz|h1\n", t_trace_lookup)
    end
    it("cache_tracing: cache_op_store logs op + (module, hash)") do ->
      assert_output("entries=1\n0=store trace.qz|h2\n", t_trace_store)
    end
    it("cache_tracing: cache_op_save_pool logs op + Vec size") do ->
      assert_output("entries=1\n0=save_pool size=3\n", t_trace_save_pool)
    end
    it("cache_tracing: cache_op_load_pool logs the op name") do ->
      assert_output("entries=1\n0=load_pool\n", t_trace_load_pool)
    end
    it("cache_tracing: cache_op_save_ast logs op + (module, hash)") do ->
      assert_output("entries=1\n0=save_ast trace.qz|h3\n", t_trace_save_ast)
    end
    it("cache_tracing: cache_op_load_ast logs op + (module, hash)") do ->
      assert_output("entries=1\n0=load_ast trace.qz|h4\n", t_trace_load_ast)
    end
  end
  return qspec_main()
end
