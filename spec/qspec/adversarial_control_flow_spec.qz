## Adversarial Control Flow Tests (TEST.2 Phase 2)
##
## Contract: Stress-testing of control flow constructs.
##   1. Deeply nested if/else.
##   2. Match with many arms.
##   3. For-in over empty ranges.
##   4. While with immediate break.
##   5. Return from deep nesting.
##   6. Complex control flow combinations.

import * from qspec

def main(): Int
  # ==========================================================================
  # Deeply Nested If/Else
  # ==========================================================================
  describe("deeply nested if/else") do ->
    it("10 levels of nested if produces correct result") do ->
      assert_eq(nested_if_10(1), 10)
    end

    it("nested if with alternating branches") do ->
      assert_eq(nested_alternating(5), 5)
    end

    it("deeply nested if with early return") do ->
      assert_eq(nested_early_return(1), 42)
      assert_eq(nested_early_return(0), 0)
    end
  end

  # ==========================================================================
  # Match with Many Arms
  # ==========================================================================
  describe("match with many arms") do ->
    it("match with 10 integer arms") do ->
      assert_eq(match_ten_arms(0), 100)
      assert_eq(match_ten_arms(5), 105)
      assert_eq(match_ten_arms(9), 109)
      assert_eq(match_ten_arms(99), -1)
    end

    it("match with wildcard catches remaining") do ->
      assert_eq(match_with_wildcard(42), -1)
      assert_eq(match_with_wildcard(1), 1)
    end

    it("match result used in arithmetic") do ->
      result = match_ten_arms(3) + match_ten_arms(7)
      assert_eq(result, 210)
    end
  end

  # ==========================================================================
  # For-In Edge Cases
  # ==========================================================================
  describe("for-in edge cases") do ->
    it("for-in over empty range 0..0 executes zero times") do ->
      var count = 0
      for i in 0..0
        count += 1
      end
      assert_eq(count, 0)
    end

    it("for-in over range 0..1 executes once") do ->
      var count = 0
      for i in 0..1
        count += 1
      end
      assert_eq(count, 1)
    end

    it("for-in accumulates correctly over large range") do ->
      var sum = 0
      for i in 0..100
        sum += i
      end
      # Sum of 0..99 = 99*100/2 = 4950
      assert_eq(sum, 4950)
    end

    it("nested for-in loops") do ->
      var count = 0
      for i in 0..10
        for j in 0..10
          count += 1
        end
      end
      assert_eq(count, 100)
    end
  end

  # ==========================================================================
  # While Loop Edge Cases
  # ==========================================================================
  describe("while loop edge cases") do ->
    it("while with immediate false condition never executes") do ->
      var count = 0
      while false
        count += 1
      end
      assert_eq(count, 0)
    end

    it("while with break on first iteration") do ->
      var count = 0
      while true
        count += 1
        break
      end
      assert_eq(count, 1)
    end

    it("while counting down to zero") do ->
      var n = 10
      var count = 0
      while n > 0
        n -= 1
        count += 1
      end
      assert_eq(count, 10)
    end

    it("while with continue skips body") do ->
      var sum = 0
      var i = 0
      while i < 10
        i += 1
        if i % 2 == 0
          continue
        end
        sum += i
      end
      # Sum of odd numbers 1..9 = 1+3+5+7+9 = 25
      assert_eq(sum, 25)
    end
  end

  # ==========================================================================
  # Return from Deep Nesting
  # ==========================================================================
  describe("return from deep nesting") do ->
    it("return from inside match inside if") do ->
      assert_eq(deep_return(1, 1), 42)
      assert_eq(deep_return(1, 0), 10)
      assert_eq(deep_return(0, 1), 0)
    end

    it("return from inside while inside for") do ->
      assert_eq(return_from_nested_loops(), 15)
    end
  end

  # ==========================================================================
  # Complex Combinations
  # ==========================================================================
  describe("complex control flow combinations") do ->
    it("if inside for inside while") do ->
      assert_eq(complex_nesting(), 50)
    end

    it("match with computation in each arm") do ->
      assert_eq(match_with_computation(1), 2)
      assert_eq(match_with_computation(2), 6)
      assert_eq(match_with_computation(3), 12)
    end
  end

  return qspec_main()
end

# --- Helper functions ---

def nested_if_10(x: Int): Int
  if x > 0
    if x > 0
      if x > 0
        if x > 0
          if x > 0
            if x > 0
              if x > 0
                if x > 0
                  if x > 0
                    if x > 0
                      return 10
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  return 0
end

def nested_alternating(x: Int): Int
  var result = 0
  if x > 0
    result += 1
    if x > 1
      result += 1
      if x > 2
        result += 1
        if x > 3
          result += 1
          if x > 4
            result += 1
          end
        end
      end
    end
  end
  return result
end

def nested_early_return(x: Int): Int
  if x > 0
    if x > 0
      if x > 0
        return 42
      end
    end
  end
  return 0
end

def match_ten_arms(x: Int): Int
  return match x
    0 => 100
    1 => 101
    2 => 102
    3 => 103
    4 => 104
    5 => 105
    6 => 106
    7 => 107
    8 => 108
    9 => 109
    _ => -1
  end
end

def match_with_wildcard(x: Int): Int
  return match x
    1 => 1
    2 => 2
    3 => 3
    _ => -1
  end
end

def deep_return(a: Int, b: Int): Int
  if a > 0
    result = match b
      1 => 42
      _ => 10
    end
    return result
  end
  return 0
end

def return_from_nested_loops(): Int
  var sum = 0
  for i in 0..10
    var j = 0
    while j < 5
      sum += 1
      j += 1
      if sum >= 15
        return sum
      end
    end
  end
  return sum
end

def complex_nesting(): Int
  var result = 0
  var i = 0
  while i < 5
    for j in 0..10
      if j % 2 == 0
        result += 1
      end
      if j % 2 == 1
        result += 1
      end
    end
    i += 1
  end
  return result
end

def match_with_computation(x: Int): Int
  return match x
    1 => 1 + 1
    2 => 2 * 3
    3 => 3 * 4
    _ => 0
  end
end
