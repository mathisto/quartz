## QZ0210 — sched_park() outside async context is a compile error.
##
## Regression-locks the Phase 4 rejection and the Apr 15 widening.
## Phase 4 (narrow): direct calls from main() were rejected.
## Widened: any non-async-target function calling sched_park is rejected.
## The PASS 0.98 pre-scan populates `_async_func_names` before PASS 1, so
## legitimate go-target plain bodies are exempt.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("QZ0210 sched_park outside async") do ->
    it("rejects sched_park() called directly from main()") do ->
      var src = """
        def main(): Int
          sched_park()
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0210"), true)
      assert_eq(str_contains(r.stderr_content, "async-only primitive"), true)
    end

    it("rejects sched_park() from a helper function called plainly") do ->
      # parker() is never spawned via go, so its plain body is the live path.
      # sched_park() here is genuine misuse — reject it.
      var src = """
        def parker(): Int
          sched_park()
          return 0
        end

        def main(): Int
          parker()
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "QZ0210"), true)
      assert_eq(str_contains(r.stderr_content, "parker"), true)
    end

    it("error includes actionable hint about go spawning") do ->
      var src = """
        def main(): Int
          sched_park()
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      assert_eq(str_contains(r.stderr_content, "go fn()"), true)
      assert_eq(str_contains(r.stderr_content, "sched_wake"), true)
    end

    it("accepts sched_park() inside a function spawned via go") do ->
      # This is the correct usage: parker() is a go target, so its body is
      # lowered as a $poll state machine where sched_park is legal.
      # The plain body is also emitted (as dead code) but QZ0210 exempts it
      # via the PASS 0.98 pre-scanned _async_func_names registry.
      var src = """
        def parker(): Int
          sched_park()
          return 0
        end

        def main(): Int
          var h = go parker()
          sched_wake(as_int_generic(h))
          await h
          return 0
        end
        """
      var r = subprocess_compile(src)
      # Compile must succeed — exit_code 0 and no QZ0210 in stderr.
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stderr_content, "QZ0210"), false)
    end
  end

  return qspec_main()
end
