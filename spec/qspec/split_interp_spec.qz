## Split-Token Interpolation Tests
## Verifies the mode-stack lexer emits correct split tokens for string
## interpolation (STRING_START/PART/INTERP_START/END/STRING_END).

import * from qspec

def print_simple(): Void
  x = "world"
  puts("hello #{x}!")
end

def print_expr(): Void
  puts("result: #{2 + 3 * 4}")
end

def print_multi(): Void
  a = "one"
  b = "two"
  puts("#{a} and #{b} done")
end

def print_adjacent(): Void
  puts("#{1}#{2}#{3}")
end

def print_nested_string(): Void
  puts("got #{str_byte_len("hello")} chars")
end

def helper(s: String): String = "<<#{s}>>"

def print_nested_interp(): Void
  puts("wrap: #{helper("inner")}")
end

def print_braces_in_expr(): Void
  var v = vec_new()
  v.push(42)
  puts("val: #{v[0]}")
end

def print_escaped_hash(): Void
  puts("literal \#{not interp}")
end

def print_only_interp(): Void
  x = 99
  puts("#{x}")
end

def print_empty_parts(): Void
  x = "hi"
  puts("#{x}!")
end

def print_char_in_expr(): Void
  puts("char: #{65}")
end

def print_no_interp(): Void
  puts("plain string")
end

def main(): Int
  describe("split-token interpolation") do ->
    it("simple variable interpolation") do ->
      assert_output("hello world!\n", print_simple)
    end

    it("expression in interpolation") do ->
      assert_output("result: 14\n", print_expr)
    end

    it("multiple interpolations") do ->
      assert_output("one and two done\n", print_multi)
    end

    it("adjacent interpolations with no literal between") do ->
      assert_output("123\n", print_adjacent)
    end

    it("nested string inside interpolation") do ->
      assert_output("got 5 chars\n", print_nested_string)
    end

    it("nested interpolation via function call") do ->
      assert_output("wrap: <<inner>>\n", print_nested_interp)
    end

    it("braces inside interpolation expr (vec index)") do ->
      assert_output("val: 42\n", print_braces_in_expr)
    end

    it("escaped hash is literal") do ->
      assert_output("literal \#{not interp}\n", print_escaped_hash)
    end

    it("string with only interpolation, no literal parts") do ->
      assert_output("99\n", print_only_interp)
    end

    it("empty leading part before interpolation") do ->
      assert_output("hi!\n", print_empty_parts)
    end

    it("integer literal in interpolation") do ->
      assert_output("char: 65\n", print_char_in_expr)
    end

    it("plain string unchanged by mode stack") do ->
      assert_output("plain string\n", print_no_interp)
    end
  end

  return qspec_main()
end
