# Runtime round-trip coverage for B.10 Phase 4 N1 — niche-layout `Option<Bool>`.
# niche_spec.qz tests the pure decision core (niche.qz); THIS spec proves the
# wired codegen: a niche `Option<Bool>` (the value flows as a bare i64 — `0`/`1`
# for Some, `2` for None — with no heap box) constructs and reads back correctly
# across every discriminant form. Helpers are top-level named functions so the
# constructions exercise the let-init, return, and expression-body niche paths
# (not a qspec-lambda context). See MEMORY_MODEL_V3 §14.5.

import * from qspec

# --- construction surfaces ---
def mk_some_true_expr(): Option<Bool> = Option::Some(true)
def mk_some_false_expr(): Option<Bool> = Option::Some(false)
def mk_none_expr(): Option<Bool> = Option::None        # expression-body None
def mk_none_ret(): Option<Bool>                         # block-return None
  return Option::None
end

# --- read surfaces (each takes Option<Bool> by value = the niche scalar) ---
def via_match(o: Option<Bool>): Int
  match o
    Option::Some(b) => { return 1 if b; return 0 }
    Option::None => { return -1 }
  end
end

def via_iflet(o: Option<Bool>): Int
  if Option::Some(b) = o
    return 1 if b
    return 0
  end
  return -1
end

def via_is_some(o: Option<Bool>): Int
  return 1 if o is Some
  return 0
end

def some_pred(o: Option<Bool>): Int
  return 1 if o.some?
  return 0
end

def none_pred(o: Option<Bool>): Int
  return 1 if o.none?
  return 0
end

def is_some_method(o: Option<Bool>): Int
  return 1 if o.is_some()
  return 0
end

def unwrap_to_int(o: Option<Bool>): Int
  return 1 if o.unwrap()
  return 0
end

def main(): Int
  describe("niche Option<Bool> round-trip (B.10 §14 N1)") do ->
    it("match: Some(true)/Some(false)/None") do ->
      assert_eq(via_match(mk_some_true_expr()), 1)
      assert_eq(via_match(mk_some_false_expr()), 0)
      assert_eq(via_match(mk_none_expr()), -1)
      assert_eq(via_match(mk_none_ret()), -1)
    end

    it("if-let binds the niche payload") do ->
      assert_eq(via_iflet(mk_some_true_expr()), 1)
      assert_eq(via_iflet(mk_some_false_expr()), 0)
      assert_eq(via_iflet(mk_none_expr()), -1)
    end

    it("is-predicate") do ->
      assert_eq(via_is_some(mk_some_true_expr()), 1)
      assert_eq(via_is_some(mk_none_expr()), 0)
    end

    it("some? / none? predicates") do ->
      assert_eq(some_pred(mk_some_true_expr()), 1)
      assert_eq(some_pred(mk_none_expr()), 0)
      assert_eq(none_pred(mk_some_true_expr()), 0)
      assert_eq(none_pred(mk_none_expr()), 1)
    end

    it("is_some() method (prelude wrapper) is niche-aware") do ->
      assert_eq(is_some_method(mk_some_true_expr()), 1)
      assert_eq(is_some_method(mk_none_expr()), 0)
    end

    it("unwrap returns the bare payload (identity)") do ->
      assert_eq(unwrap_to_int(mk_some_true_expr()), 1)
      assert_eq(unwrap_to_int(mk_some_false_expr()), 0)
    end
  end

  return qspec_main()
end
