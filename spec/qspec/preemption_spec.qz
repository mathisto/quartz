## Preemption Tests — T3b.2
## Validates that CPU-bound async tasks are preempted at loop back-edges,
## allowing concurrent tasks to make progress.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("preemption") do ->
    it("CPU-bound task yields to fast tasks") do ->
      assert_run_exits_timeout(preempt_basic_src(), 0)
    end

    it("all tasks complete despite busy loop") do ->
      assert_run_exits_timeout(preempt_all_complete_src(), 10)
    end
  end

  return qspec_main()
end

def preempt_basic_src(): String = """
  def busy(): Int
    var i = 0
    while i < 10000
      i += 1
    end
    return 42
  end
  def fast(): Int
    return 1
  end
  def main(): Int
    sched_init(2)
    var t1 = async busy()
    sched_spawn(t1)
    var t2 = async fast()
    sched_spawn(t2)
    var r1 = await t1
    var r2 = await t2
    sched_shutdown()
    if r1 == 42 and r2 == 1
      return 0
    end
    return 1
  end
  """

def preempt_all_complete_src(): String = """
  def busy(): Int
    var i = 0
    while i < 100000
      i += 1
    end
    return 0
  end
  def fast(val: Int): Int
    return val
  end
  def main(): Int
    sched_init(2)
    var t0 = async busy()
    sched_spawn(t0)
    var sum = 0
    var t1 = async fast(1)
    sched_spawn(t1)
    var t2 = async fast(1)
    sched_spawn(t2)
    var t3 = async fast(1)
    sched_spawn(t3)
    var t4 = async fast(1)
    sched_spawn(t4)
    var t5 = async fast(1)
    sched_spawn(t5)
    var t6 = async fast(1)
    sched_spawn(t6)
    var t7 = async fast(1)
    sched_spawn(t7)
    var t8 = async fast(1)
    sched_spawn(t8)
    var t9 = async fast(1)
    sched_spawn(t9)
    var t10 = async fast(1)
    sched_spawn(t10)
    sum += await t1
    sum += await t2
    sum += await t3
    sum += await t4
    sum += await t5
    sum += await t6
    sum += await t7
    sum += await t8
    sum += await t9
    sum += await t10
    await t0
    sched_shutdown()
    return sum
  end
  """
