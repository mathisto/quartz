## Newtypes Tests
##
## Contract:
##   1. Basic newtypes.
##   2. Newtype with variables.
##   3. Multiple newtypes.
##   4. Cross-module newtypes.
##   5. Type safety.

import * from qspec
import * from qspec/subprocess

newtype NtUserId = Int
newtype NtProductId = Int
newtype NtFlag = Int
newtype NtName = String

def nt_get_id(): NtUserId
  return 42
end

def nt_process_id(id: NtUserId): Int
  return id
end

def nt_check_flag(f: NtFlag): Int
  if f
    return 1
  end
  return 0
end

def nt_get_name(): NtName
  return "hello"
end

def nt_name_len(n: NtName): Int
  return str_size(n)
end

def nt_get_user(): NtUserId
  return 100
end

def nt_get_product(): NtProductId
  return 200
end

def main(): Int
  describe("basic newtypes") do ->
    it("creates a distinct wrapper type") do ->
      assert_eq(0, 0)
    end

    it("allows newtype in function return type") do ->
      id = nt_get_id()
      assert_eq(id, 42)
    end

    it("allows newtype in function parameter") do ->
      assert_eq(nt_process_id(42), 42)
    end

    it("wraps String type") do ->
      var name = nt_get_name()
      assert_eq(nt_name_len(name), 5)
    end

    it("wraps Bool-like type") do ->
      assert_eq(nt_check_flag(1), 1)
    end
  end

  describe("newtype with variables") do ->
    it("stores newtype values in mutable variables") do ->
      var c = 10
      c = c + 5
      assert_eq(c, 15)
    end
  end

  describe("multiple newtypes") do ->
    it("allows multiple distinct newtypes") do ->
      user = nt_get_user()
      product = nt_get_product()
      assert_eq(user + product, 300)
    end
  end

  describe("cross-module newtypes") do ->
    it("uses newtype defined in another module (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("nt_mod.qz"))
      vec_push(files, as_int("""
        newtype NtModId = Int
        def nt_mod_make(): NtModId
          return 42
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import nt_mod
        def main(): Int
          return nt_mod::nt_mod_make()
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end

    it("calls function returning imported newtype (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("nt_ret.qz"))
      vec_push(files, as_int("""
        newtype NtRetId = Int
        def nt_ret_get(): NtRetId
          return 99
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import nt_ret
        def main(): Int
          id = nt_ret::nt_ret_get()
          return id
        end
        """))
      assert_multi_run_exits(files, 1, 99)
    end

    it("passes imported newtype as function parameter (multi-file test)") do ->
      var files: Vec = vec_new()
      files.push(as_int("nt_param.qz"))
      vec_push(files, as_int("""
        newtype NtParamId = Int
        def nt_param_process(id: NtParamId): Int
          return id + 1
        end
        """))
      files.push(as_int("main.qz"))
      vec_push(files, as_int("""
        import nt_param
        def main(): Int
          return nt_param::nt_param_process(41)
        end
        """))
      assert_multi_run_exits(files, 1, 42)
    end
  end

  describe("type safety") do ->
    it("prevents direct assignment between different newtypes (compile-error test)") do ->
      assert_compile_error("""
        newtype UserId = Int
        newtype ProductId = Int
        def takes_user(id: UserId): Int
          return id
        end
        def main(): Int
          var p: ProductId = 200
          return takes_user(p)
        end
        """, "Type mismatch")
    end
  end

  # ===========================================================================
  # Newtype advanced patterns (TEST.2 Phase 6)
  # ===========================================================================
  describe("newtype advanced patterns") do ->
    it("newtype used as function parameter and return") do ->
      id = nt_get_id()
      result = nt_process_id(id)
      assert_eq(result, 42)
    end

    it("newtype wraps and unwraps Int correctly") do ->
      var uid: NtUserId = 99
      assert_eq(uid, 99)
    end

    it("newtype in arithmetic expression") do ->
      a = nt_get_user()
      b = nt_get_product()
      # Both are Int underneath
      assert_eq(a + b, 300)
    end
  end

  return qspec_main()
end
