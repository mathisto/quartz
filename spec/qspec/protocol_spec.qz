import * from qspec

# --- Protocol definitions ---

protocol PingPong
  send Int
  recv Int
end

protocol OneWay
  send Int
end

protocol ThreeStep
  send Int
  recv Int
  send Int
end

# --- Choice protocol: branching session types ---
# Branches must have distinct first operations (deterministic DFA).

protocol RequestResponse
  choice
    send Int
    recv Int
  or
    recv Int
  end
end

# --- Loop protocol: repeating send/recv ---
# Loop creates a back-edge in the DFA. The loop start is also the accept state,
# so protocols can exit the loop at any iteration boundary.

protocol LoopStream
  loop
    send Int
    recv Int
  end
end

# --- Sequential protocol (used alongside loop tests) ---

protocol StreamProto
  send Int
  recv Int
end

# --- Generic protocol: type parameter substitution ---

protocol Echo<T>
  send T
  recv T
end

# --- Test helpers ---

def test_correct_order(): Void
  var ch: Channel<PingPong> = channel_new(1)
  send(ch, 42)
  var val = recv(ch)
  puts(to_str(val))
  channel_close(ch)
end

def test_one_way(): Void
  var ch: Channel<OneWay> = channel_new(1)
  send(ch, 99)
  puts("one-way sent")
  channel_close(ch)
end

def test_three_step(): Void
  var ch: Channel<ThreeStep> = channel_new(1)
  send(ch, 1)
  var r = recv(ch)
  send(ch, r + 1)
  puts(to_str(r))
  channel_close(ch)
end

def test_plain_channel(): Void
  # Bare channel (no protocol) — should work without protocol checking
  var ch = channel_new(1)
  send(ch, 77)
  var val = recv(ch)
  puts(to_str(val))
  channel_close(ch)
end

def test_choice_branch_a(): Void
  # Use the first branch of the choice: send Int, recv Int
  var ch: Channel<RequestResponse> = channel_new(1)
  send(ch, 10)
  var r = recv(ch)
  puts(to_str(r))
  channel_close(ch)
end

def test_choice_branch_b(): Void
  # Use the second branch of the choice: recv Int only
  var ch: Channel<RequestResponse> = channel_new(1)
  send(ch, 0)
  var r = recv(ch)
  puts(to_str(r))
  channel_close(ch)
end

def test_sequential_stream(): Void
  # StreamProto: send Int, recv Int — simple 2-step protocol
  var ch: Channel<StreamProto> = channel_new(1)
  send(ch, 1)
  var r = recv(ch)
  puts(to_str(r))
  channel_close(ch)
end

def test_loop_zero_iterations(): Void
  # Loop protocol with zero iterations — immediately at accept state
  var ch: Channel<LoopStream> = channel_new(1)
  # No send/recv — loop body never executed, protocol is satisfied
  puts("loop-zero ok")
  channel_close(ch)
end

def test_loop_one_iteration(): Void
  # Loop protocol with one full iteration
  var ch: Channel<LoopStream> = channel_new(1)
  send(ch, 42)
  var r = recv(ch)
  puts(to_str(r))
  channel_close(ch)
end

def test_loop_two_iterations(): Void
  # Loop protocol with two full iterations
  var ch: Channel<LoopStream> = channel_new(1)
  send(ch, 1)
  var r1 = recv(ch)
  send(ch, 2)
  var r2 = recv(ch)
  puts("#{to_str(r1)},#{to_str(r2)}")
  channel_close(ch)
end

def test_generic_echo(): Void
  var ch: Channel<Echo<Int>> = channel_new(1)
  send(ch, 42)
  var r = recv(ch)
  puts(to_str(r))
  channel_close(ch)
end

def main(): Int
  describe("protocol types (session types)") do ->

    it("correct send/recv order compiles and runs") do ->
      assert_output("42\n", test_correct_order)
    end

    it("one-way protocol (send only)") do ->
      assert_output("one-way sent\n", test_one_way)
    end

    it("three-step protocol") do ->
      assert_output("1\n", test_three_step)
    end

    it("plain channels work without protocols") do ->
      assert_output("77\n", test_plain_channel)
    end

    it("choice protocol — branch A (send+recv)") do ->
      assert_output("10\n", test_choice_branch_a)
    end

    it("choice protocol — branch B (recv only)") do ->
      assert_output("0\n", test_choice_branch_b)
    end

    it("sequential stream protocol (send+recv)") do ->
      assert_output("1\n", test_sequential_stream)
    end

    it("loop protocol — zero iterations (immediate accept)") do ->
      assert_output("loop-zero ok\n", test_loop_zero_iterations)
    end

    it("loop protocol — one full iteration") do ->
      assert_output("42\n", test_loop_one_iteration)
    end

    it("loop protocol — two full iterations") do ->
      assert_output("1,2\n", test_loop_two_iterations)
    end

    it("generic protocol — Echo<Int> send/recv") do ->
      assert_output("42\n", test_generic_echo)
    end

  end

  return qspec_main()
end
