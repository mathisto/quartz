## Macro Fragment Tests
##
## Contract:
##   1. Explicit expr: explicit `expr` fragment accepts expression.
##   2. Default expr: expr fragment (default) accepts any expression.
##   3. Ident ok: ident fragment accepts identifier.
##   4. Ident bad: ident fragment rejects expression.
##   5. No specifier: no specifier defaults to expr.
##   6. Tt: tt fragment accepts any token.
##   7. Multi-param: macro with two ident params.
##   8. String param: macro with string literal argument.
import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("macro fragment specifiers") do ->
    it("ident fragment accepts identifier") do ->
      assert_run_stdout_eq(frag_ident_ok_src(), "hello\n")
    end

    it("ident fragment rejects expression") do ->
      assert_compile_error(frag_ident_bad_src(), "expects ident")
    end

    it("expr fragment (default) accepts any expression") do ->
      assert_run_stdout_eq(frag_expr_src(), "42\n")
    end

    it("explicit expr fragment accepts expression") do ->
      assert_run_stdout_eq(frag_explicit_expr_src(), "10\n")
    end

    it("tt fragment accepts any token") do ->
      assert_run_stdout_eq(frag_tt_src(), "7\n")
    end

    it("no specifier defaults to expr") do ->
      assert_run_stdout_eq(frag_no_spec_src(), "20\n")
    end

    it("macro with two ident params") do ->
      assert_run_stdout_eq(frag_two_ident_src(), "hello\n")
    end

    it("macro with string literal argument") do ->
      assert_run_stdout_eq(frag_string_literal_src(), "world\n")
    end
  end

  return qspec_main()
end

def frag_ident_ok_src(): String
  return """
    macro greet(name: ident) do
      quote do
        puts("hello")
      end
    end

    def main(): Int
      var x = 1
      $greet(x)
      return 0
    end
  """
end

def frag_ident_bad_src(): String
  return """
    macro greet(name: ident) do
      quote do
        puts("hello")
      end
    end

    def main(): Int
      $greet(1 + 2)
      return 0
    end
  """
end

def frag_expr_src(): String
  return """
    macro show(val: expr) do
      quote do
        print_int(unquote(val))
      end
    end

    def main(): Int
      $show(40 + 2)
      return 0
    end
  """
end

def frag_explicit_expr_src(): String
  return """
    macro double(x: expr) do
      quote do
        unquote(x) + unquote(x)
      end
    end

    def main(): Int
      print_int($double(5))
      return 0
    end
  """
end

def frag_tt_src(): String
  return """
    macro pass(x: tt) do
      quote do
        unquote(x)
      end
    end

    def main(): Int
      print_int($pass(7))
      return 0
    end
  """
end

def frag_no_spec_src(): String
  return """
    macro add(a, b) do
      quote do
        unquote(a) + unquote(b)
      end
    end

    def main(): Int
      print_int($add(8, 12))
      return 0
    end
  """
end

def frag_two_ident_src(): String
  return """
    macro greet2(a: ident, b: ident) do
      quote do
        puts("hello")
      end
    end

    def main(): Int
      var x = 1
      var y = 2
      $greet2(x, y)
      return 0
    end
  """
end

def frag_string_literal_src(): String
  return """
    macro say(msg: expr) do
      quote do
        puts(unquote(msg))
      end
    end

    def main(): Int
      $say("world")
      return 0
    end
  """
end
