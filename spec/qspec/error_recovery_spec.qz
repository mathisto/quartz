## Error Recovery & Diagnostic Quality Tests
## Tests for Phase 1-6: multi-error recovery, contextual help, cascade prevention,
## fuzzy matching, --explain, JSON output.

import * from qspec
import * from qspec/subprocess

def _trivial_src(): String = """
  def main(): Int
    return 0
  end
  """

def main(): Int
  describe("Phase 1: parser multi-error recovery") do ->
    it("reports two syntax errors in one file") do ->
      var src = """
        )
        )
        def main(): Int
          return 0
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      var stderr = r.stderr_content
      assert_eq(str_contains(stderr, "Expected declaration"), true)
      match str_byte_find(stderr, "Expected declaration")
        Some(first_idx) => {
          var rest = stderr.byte_slice(first_idx + 20, stderr.size)
          assert_eq(str_contains(rest, "Expected declaration"), true)
        }
        _ => assert_eq(0, 1)
      end
    end

    it("recovery does not cascade into valid code") do ->
      var src = """
        )
        def main(): Int
          return 42
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      var stderr = r.stderr_content
      var count = 0
      var pos = 0
      while pos < stderr.size
        match str_byte_find(stderr.byte_slice(pos, stderr.size), "error[")
          Some(idx) => {
            count += 1
            pos = pos + idx + 6
          }
          _ => break
        end
      end
      assert_eq(count, 1)
    end

    it("existing single-error behavior preserved") do ->
      assert_compile_error("""
        )
        def main(): Int
          return 0
        end
        """, "Expected declaration")
    end
  end

  describe("Phase 2: contextual help messages") do ->
    it("shows var help for immutability error") do ->
      var src = """
        def main(): Int
          x = 5
          x = 10
          return 0
        end
        """
      assert_compile_error(src, "help: declare with")
    end

    it("shows QZ0106 code for immutability") do ->
      var src = """
        def main(): Int
          x = 5
          x = 10
          return 0
        end
        """
      assert_compile_error(src, "QZ0106")
    end
  end

  describe("Phase 3: cascade prevention") do ->
    it("duplicate error at same location is suppressed") do ->
      var src = """
        def main(): Int
          return unknown_var
        end
        """
      var r = subprocess_compile(src)
      assert_eq(r.exit_code != 0, true)
      var stderr = r.stderr_content
      var count = 0
      var pos = 0
      while pos < stderr.size
        match str_byte_find(stderr.byte_slice(pos, stderr.size), "error[")
          Some(idx) => {
            count += 1
            pos = pos + idx + 6
          }
          _ => break
        end
      end
      assert_eq(count, 1)
    end
  end

  describe("Phase 5: --explain") do ->
    it("explains QZ1205 error code") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ1205")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Conflicting"), true)
    end

    it("shows unknown code message for invalid code") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ9999")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Unknown error code"), true)
    end

    it("explains QZ0106 immutability code") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ0106")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Immutable"), true)
    end

    it("explains QZ0107 non-exhaustive match") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ0107")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Exhaustive"), true)
    end

    it("explains QZ0501 unquote outside quote") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ0501")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Unquote"), true)
    end

    it("explains QZ0550 circular dependency") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ0550")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Circular"), true)
    end

    it("explains QZ0601 non-const function") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ0601")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Const"), true)
    end

    it("explains QZ1202 linear consumed twice") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ1202")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Consumed"), true)
    end

    it("explains QZ1206 conflicting borrows") do ->
      var r = subprocess_compile_with_flags(_trivial_src(), "--explain QZ1206")
      assert_eq(r.exit_code, 0)
      assert_eq(str_contains(r.stdout_content, "Conflicting"), true)
    end
  end

  describe("Phase 6: JSON error output") do ->
    it("emits JSON when --error-format=json") do ->
      var r = subprocess_compile_with_flags("""
        )
        def main(): Int
          return 0
        end
        """, "--error-format=json")
      assert_eq(r.exit_code != 0, true)
      var stderr = r.stderr_content
      assert_eq(str_contains(stderr, "\"severity\""), true)
      assert_eq(str_contains(stderr, "\"code\""), true)
      assert_eq(str_contains(stderr, "QZ0101"), true)
    end

    it("JSON has correct line number") do ->
      var r = subprocess_compile_with_flags("""
        )
        def main(): Int
          return 0
        end
        """, "--error-format=json")
      assert_eq(r.exit_code != 0, true)
      var stderr = r.stderr_content
      assert_eq(str_contains(stderr, "\"line\":1"), true)
    end
  end

  return qspec_main()
end
