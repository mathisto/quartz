## Char Predicates Tests
##
## Contract:
##   1. .digit?: true for '0'-'9', false otherwise.
##   2. .alpha?: true for 'A'-'Z'/'a'-'z', false for digits.
##   3. .alnum?: true for digits or letters, false for symbols.
##   4. .whitespace?: true for space/newline/tab, false for letters.

import * from qspec

def main(): Int
  describe("c.digit?") do ->
    it("returns true for digit 0") do ->
      c = 48
      assert_eq(c.digit?, 1)
    end
    it("returns true for digit 9") do ->
      c = 57
      assert_eq(c.digit?, 1)
    end
    it("returns false for non-digit A") do ->
      c = 65
      assert_eq(c.digit?, 0)
    end
  end

  describe("c.alpha?") do ->
    it("returns true for uppercase A") do ->
      c = 65
      assert_eq(c.alpha?, 1)
    end
    it("returns true for lowercase z") do ->
      c = 122
      assert_eq(c.alpha?, 1)
    end
    it("returns false for digit 0") do ->
      c = 48
      assert_eq(c.alpha?, 0)
    end
  end

  describe("c.alnum?") do ->
    it("returns true for digit 9") do ->
      c = 57
      assert_eq(c.alnum?, 1)
    end
    it("returns true for letter M") do ->
      c = 77
      assert_eq(c.alnum?, 1)
    end
    it("returns false for @") do ->
      c = 64
      assert_eq(c.alnum?, 0)
    end
  end

  describe("c.whitespace?") do ->
    it("returns true for space") do ->
      c = 32
      assert_eq(c.whitespace?, 1)
    end
    it("returns true for newline") do ->
      c = 10
      assert_eq(c.whitespace?, 1)
    end
    it("returns true for tab") do ->
      c = 9
      assert_eq(c.whitespace?, 1)
    end
    it("returns false for letter A") do ->
      c = 65
      assert_eq(c.whitespace?, 0)
    end
  end

  return qspec_main()
end
