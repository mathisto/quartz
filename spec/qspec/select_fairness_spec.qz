import * from qspec

def test_fairness(): Int
  var ch1 = channel_new(100)
  var ch2 = channel_new(100)
  var i = 0
  while i < 50
    send(ch1, 1)
    send(ch2, 2)
    i = i + 1
  end
  var c1 = 0
  var c2 = 0
  i = 0
  while i < 100
    select
      case v = recv(ch1) => c1 = c1 + 1
      case v = recv(ch2) => c2 = c2 + 1
    end
    i = i + 1
  end
  if c1 > 0 and c2 > 0
    return 1
  end
  return 0
end

def test_closed_terminates(): Int
  var ch = channel_new(1)
  channel_close(ch)
  select
    case v = recv(ch) => return v
  end
  return 0
end

def test_closed_with_open(): Int
  # Both arms are "ready" (closed channel succeeds with 0, open channel has data).
  # With Fisher-Yates shuffle, either may be selected.
  # Go semantics: recv from closed channel returns zero value.
  var ch1 = channel_new(1)
  var ch2 = channel_new(1)
  channel_close(ch1)
  send(ch2, 42)
  var result = -1
  select
    case v = recv(ch1) => result = v
    case v = recv(ch2) => result = v
  end
  # Result is either 0 (closed channel) or 42 (open channel) — both valid
  if result == 0 or result == 42
    return 1
  end
  return 0
end

def test_closed_with_default(): Int
  # Go semantics: recv from closed channel succeeds with zero value.
  # The recv arm fires (not default) because it "succeeds."
  var ch = channel_new(1)
  channel_close(ch)
  var result = -1
  select
    case v = recv(ch) => result = v
    default => result = 99
  end
  return result
end

def test_strong_fairness(): Int
  # 3 channels, 300 messages each, 300 select iterations.
  # With Fisher-Yates shuffle, each channel gets ~33%.
  # Threshold: each must get >= 15% (45/300).
  var ch1 = channel_new(400)
  var ch2 = channel_new(400)
  var ch3 = channel_new(400)
  var i = 0
  while i < 300
    send(ch1, 1)
    send(ch2, 2)
    send(ch3, 3)
    i = i + 1
  end
  var c1 = 0
  var c2 = 0
  var c3 = 0
  i = 0
  while i < 300
    select
      case v = recv(ch1) => c1 = c1 + 1
      case v = recv(ch2) => c2 = c2 + 1
      case v = recv(ch3) => c3 = c3 + 1
    end
    i = i + 1
  end
  if c1 >= 45 and c2 >= 45 and c3 >= 45
    return 1
  end
  return 0
end

def test_default_always_last(): Int
  # Default is FIRST in source order but should fire LAST (Go semantics).
  # Channel has data, so recv should win regardless of default position.
  var ch = channel_new(1)
  send(ch, 42)
  var result = 0
  select
    default => result = -1
    case v = recv(ch) => result = v
  end
  return result
end

def main(): Int
  describe("select fairness + closed") do ->

    it("both channels get selected (statistical fairness)") do ->
      assert_eq(test_fairness(), 1)
    end

    it("3-channel strong fairness: each >= 15%") do ->
      assert_eq(test_strong_fairness(), 1)
    end

    it("select on closed channel terminates") do ->
      assert_eq(test_closed_terminates(), 0)
    end

    it("one closed + one open: either fires (Go semantics)") do ->
      assert_eq(test_closed_with_open(), 1)
    end

    it("closed channel with default: recv fires with zero (Go semantics)") do ->
      assert_eq(test_closed_with_default(), 0)
    end

    it("default always last: recv wins over default in source order") do ->
      assert_eq(test_default_always_last(), 42)
    end

  end

  return qspec_main()
end
