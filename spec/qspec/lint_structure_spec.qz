## Lint Structure & Import Rule Tests (Phase 6)
##
## Tests QZ7501 (duplicate imports), QZ7502 (wildcard imports).

import * from qspec
import * from qspec/subprocess

def main(): Int
  # A.28: the default qspec suite compiler is built without `--feature lint`,
  # so `quartz lint` stubs out. Self-gate to it_pending; a feature-enabled
  # CI lane provides real coverage.
  if qspec_feature_lint() == false
    describe("lint structure (A.28: suite compiler lacks --feature lint)") do ->
      it_pending("`quartz lint` unavailable in the default lane — feature-enabled lane covers it")
    end
    return qspec_main()
  end

  describe("QZ7501: Duplicate imports") do ->

    it("detects duplicate import") do ->
      src = "import foo\nimport foo\ndef main(): Int\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7501")
    end

    it("no warning for different imports") do ->
      src = "import foo\nimport bar\ndef main(): Int\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7501")
        _record_failure("QZ7501 should not fire for different imports")
      end
    end
  end

  describe("QZ7502: Wildcard imports") do ->

    it("detects wildcard import") do ->
      src = "import * from somelib\ndef main(): Int\n  return 0\nend\n"
      assert_lint_warns(src, "QZ7502")
    end

    it("allows qspec wildcard import") do ->
      src = "import * from qspec\ndef main(): Int\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7502")
        _record_failure("QZ7502 should not fire on qspec wildcard")
      end
    end

    it("allows qspec/subprocess wildcard import") do ->
      src = "import * from qspec/subprocess\ndef main(): Int\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7502")
        _record_failure("QZ7502 should not fire on qspec/* wildcard")
      end
    end

    it("no warning for non-wildcard import") do ->
      src = "import somelib\ndef main(): Int\n  return 0\nend\n"
      r = subprocess_lint(src)
      if str_contains(r.stderr_content, "QZ7502")
        _record_failure("QZ7502 should not fire on non-wildcard import")
      end
    end
  end

  return qspec_main()
end
