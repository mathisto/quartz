## Implicit `it` Parameter Tests
##
## Contract:
##   1. Trailing curly blocks without -> inject implicit `it` parameter.
##   2. Trailing do blocks without -> inject implicit `it` parameter.
##   3. UFCS method calls without parens support trailing blocks with implicit `it`.
##   4. Explicit -> arrow still works (no implicit `it`).
##   5. Multi-statement blocks with implicit `it` work correctly.
import * from qspec

def apply_i(x: Int, f: Fn(Int): Int): Int = f(x)
def apply_v(f: Fn(): Int): Int = f()

def test_filter_ufcs(): Void
  var items = [1, 2, 3, 4, 5]
  var evens = items.filter { it % 2 == 0 }
  assert_eq(evens.size, 2)
  assert_eq(evens[0], 2)
  assert_eq(evens[1], 4)
end

def test_map_ufcs(): Void
  var items = [1, 2, 3]
  var doubled = items.map { it * 2 }
  assert_eq(doubled.size, 3)
  assert_eq(doubled[0], 2)
  assert_eq(doubled[1], 4)
  assert_eq(doubled[2], 6)
end

def test_any_ufcs(): Void
  var items = [1, 2, 3]
  assert_eq(items.any? { it == 2 }, 1)
  assert_eq(items.any? { it == 99 }, 0)
end

def test_curly_basic(): Void
  var result = apply_i(21) { it * 2 }
  assert_eq(result, 42)
end

def test_do_basic(): Void
  var result = apply_i(10) do
    it * 3
  end
  assert_eq(result, 30)
end

def test_explicit_arrow_zero_arg(): Void
  var result = apply_v() do ->
    42
  end
  assert_eq(result, 42)
end

def test_explicit_arrow_curly(): Void
  var result = apply_v() { -> 99 }
  assert_eq(result, 99)
end

def test_explicit_param(): Void
  var result = apply_i(5) { x -> x + 10 }
  assert_eq(result, 15)
end

def test_multiline_curly(): Void
  var items = [10, 20, 30, 5, 15]
  var big = items.filter {
    var threshold = 12
    it > threshold
  }
  assert_eq(big.size, 3)
  assert_eq(big[0], 20)
  assert_eq(big[1], 30)
  assert_eq(big[2], 15)
end

def print_each_item(): Void
  var items = [10, 20, 30]
  items.each { puts(str_from_int(it)) }
end

def test_each_ufcs(): Void
  assert_output("10\n20\n30\n", print_each_item)
end

def test_chained(): Void
  var items = [1, 2, 3, 4, 5, 6]
  var result = items.filter { it % 2 == 0 }.map { it * 10 }
  assert_eq(result.size, 3)
  assert_eq(result[0], 20)
  assert_eq(result[1], 40)
  assert_eq(result[2], 60)
end

def main(): Int
  describe("implicit it parameter") do ->
    it("works with filter via UFCS trailing block") do ->
      test_filter_ufcs()
    end
    it("works with map via UFCS trailing block") do ->
      test_map_ufcs()
    end
    it("works with any via UFCS trailing block") do ->
      test_any_ufcs()
    end
    it("works with curly block on direct call") do ->
      test_curly_basic()
    end
    it("works with do...end block on direct call") do ->
      test_do_basic()
    end
    it("explicit -> arrow creates zero-arg lambda") do ->
      test_explicit_arrow_zero_arg()
    end
    it("explicit -> arrow with curly creates zero-arg lambda") do ->
      test_explicit_arrow_curly()
    end
    it("explicit param still works") do ->
      test_explicit_param()
    end
    it("multi-statement block with implicit it") do ->
      test_multiline_curly()
    end
    it("works with each via UFCS trailing block") do ->
      test_each_ufcs()
    end
    it("chains with mixed explicit and implicit params") do ->
      test_chained()
    end
  end

  return qspec_main()
end
