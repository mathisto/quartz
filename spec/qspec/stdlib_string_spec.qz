## Standard Library: String Processing Tests
## Uses subprocess assert_run_exits to avoid closure-count segfault
##
## Contract:
##   1. Str_contains and str_count.
##   2. Str_join basic.
##   3. Str_repeat, str_reverse, str_pad, str_substr.
##   4. Str_replace basic.
##   5. Str_split basic.
##   6. Str_split consecutive delimiters produce.

import * from qspec

def main(): Int
  describe("string module") do ->
    it("str_split basic") do ->
      assert_run_exits("import string\ndef main(): Int\n  var parts = str_split(\"a,b,c\", \",\")\n  if parts.size != 3\n    return 1\n  end\n  if parts[0] != \"a\"\n    return 2\n  end\n  if parts[2] != \"c\"\n    return 3\n  end\n  return 0\nend\n", 0)
    end

    it("str_join basic") do ->
      assert_run_exits("import string\ndef main(): Int\n  var parts = vec_new<String>()\n  parts.push(\"a\")\n  parts.push(\"b\")\n  var joined = str_join(parts, \"-\")\n  if joined != \"a-b\"\n    return 1\n  end\n  return 0\nend\n", 0)
    end

    it("str_trim basic") do ->
      assert_run_exits("import string\ndef main(): Int\n  if str_trim(\"  hello  \") != \"hello\"\n    return 1\n  end\n  if str_trim_left(\"  hi\") != \"hi\"\n    return 2\n  end\n  if str_trim_right(\"hi  \") != \"hi\"\n    return 3\n  end\n  return 0\nend\n", 0)
    end

    it("str_replace basic") do ->
      assert_run_exits("import string\ndef main(): Int\n  if str_replace(\"hello world\", \"world\", \"x\") != \"hello x\"\n    return 1\n  end\n  if str_replace(\"abab\", \"ab\", \"x\") != \"xx\"\n    return 2\n  end\n  return 0\nend\n", 0)
    end

    it("str_starts_with and str_ends_with") do ->
      assert_run_exits("import string\ndef main(): Int\n  if not str_starts_with(\"hello world\", \"hello\")\n    return 1\n  end\n  if not str_ends_with(\"hello world\", \"world\")\n    return 2\n  end\n  if str_starts_with(\"hello\", \"world\")\n    return 3\n  end\n  return 0\nend\n", 0)
    end

    it("str_to_upper and str_to_lower") do ->
      assert_run_exits("import string\ndef main(): Int\n  if str_to_upper(\"hello\") != \"HELLO\"\n    return 1\n  end\n  if str_to_lower(\"HELLO\") != \"hello\"\n    return 2\n  end\n  return 0\nend\n", 0)
    end

    it("str_contains and str_count") do ->
      assert_run_exits("import string\ndef main(): Int\n  if not str_contains(\"hello world\", \"world\")\n    return 1\n  end\n  if str_count(\"banana\", \"an\") != 2\n    return 2\n  end\n  return 0\nend\n", 0)
    end

    it("str_repeat, str_reverse, str_pad, str_substr") do ->
      assert_run_exits("import string\ndef main(): Int\n  if str_repeat(\"ab\", 3) != \"ababab\"\n    return 1\n  end\n  if str_reverse(\"hello\") != \"olleh\"\n    return 2\n  end\n  if str_pad_left(\"42\", 5, \"0\") != \"00042\"\n    return 3\n  end\n  if str_substr(\"hello world\", 6, 5) != \"world\"\n    return 4\n  end\n  return 0\nend\n", 0)
    end

    it("str_split trailing delimiter preserves empty token") do ->
      assert_run_exits("""
        def main(): Int
          var parts = str_split("a,b,", ",")
          if parts.size != 3
            return 1
          end
          if parts[2] != ""
            return 2
          end
          return 0
        end
        """, 0)
    end

    it("str_split consecutive delimiters produce empty tokens") do ->
      assert_run_exits("""
        def main(): Int
          var parts = str_split("a,,b", ",")
          if parts.size != 3
            return 1
          end
          if parts[1] != ""
            return 2
          end
          return 0
        end
        """, 0)
    end

    it("str_split leading delimiter produces empty token") do ->
      assert_run_exits("""
        def main(): Int
          var parts = str_split(",a,b", ",")
          if parts.size != 3
            return 1
          end
          if parts[0] != ""
            return 2
          end
          return 0
        end
        """, 0)
    end

    it("str_split no delimiter found returns whole string") do ->
      assert_run_exits("""
        def main(): Int
          var parts = str_split("hello", ",")
          if parts.size != 1
            return 1
          end
          if parts[0] != "hello"
            return 2
          end
          return 0
        end
        """, 0)
    end
  end

  return qspec_main()
end
