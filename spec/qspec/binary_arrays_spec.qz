## Binary DSL — Phase 2 Track C: array fields.
##
## Surface forms:
##   - [T; N]     — fixed literal count.
##   - [T; field] — count from a prior struct field.
##   - [T]        — rest-of-stream (remaining_bytes / elem_bytes).
##
## First-pass semantics (primitives only):
##   - Struct field presents as Vec<Int>.
##   - Encode: iterate the Vec, emit `elem_bytes` per element with the
##     element type's endianness.
##   - Decode: determine element count from the count source, allocate
##     Vec<Int>, loop reading `elem_bytes` per element.
##   - Encode uses the user's Vec size (caller is responsible for keeping
##     count fields consistent — Phase 2 Track A computed fields are the
##     idiomatic way to do that).

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("binary DSL — array fields (Phase 2 Track C)") do ->

    it("[u8; N] fixed-length byte array round-trips") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type UuidSlot = binary {
          uuid: [u8; 16]
        }
        def main(): Int
          var v = vec_new()
          var i = 0
          while i < 16
            v.push(i + 1)
            i = i + 1
          end
          var u = UuidSlot { uuid: v }
          var b = u.encode()
          return 90 if b.size() != 16
          return 91 if b.get(0) != 1
          return 92 if b.get(15) != 16
          match UuidSlot.decode(b)
            Ok(u2) => {
              return 1 if u2.uuid.size != 16
              return 2 if u2.uuid[0] != 1
              return 3 if u2.uuid[15] != 16
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("[u16be; N] fixed array encodes with big-endian element width") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Pair = binary {
          pair: [u16be; 2]
        }
        def main(): Int
          var v = vec_new()
          v.push(0xcafe)
          v.push(0xbabe)
          var p = Pair { pair: v }
          var b = p.encode()
          return 90 if b.size() != 4
          return 91 if b.get(0) != 0xca
          return 92 if b.get(1) != 0xfe
          return 93 if b.get(2) != 0xba
          return 94 if b.get(3) != 0xbe
          match Pair.decode(b)
            Ok(p2) => {
              return 1 if p2.pair.size != 2
              return 2 if p2.pair[0] != 0xcafe
              return 3 if p2.pair[1] != 0xbabe
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("[T; field] takes its count from a prior u16be field") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Questions = binary {
          qdcount:   u16be
          questions: [u8; qdcount]
        }
        def main(): Int
          var v = vec_new()
          v.push(0xaa)
          v.push(0xbb)
          v.push(0xcc)
          var q = Questions { qdcount: 3, questions: v }
          var b = q.encode()
          return 90 if b.size() != 5
          return 91 if b.get(0) != 0
          return 92 if b.get(1) != 3
          return 93 if b.get(2) != 0xaa
          return 94 if b.get(4) != 0xcc
          match Questions.decode(b)
            Ok(q2) => {
              return 1 if q2.qdcount != 3
              return 2 if q2.questions.size != 3
              return 3 if q2.questions[0] != 0xaa
              return 4 if q2.questions[2] != 0xcc
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("[T] rest-of-stream consumes all remaining bytes on decode") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Trailer = binary {
          hdr:  u16be
          tail: [u8]
        }
        def main(): Int
          var v = vec_new()
          v.push(0x11)
          v.push(0x22)
          v.push(0x33)
          v.push(0x44)
          var t = Trailer { hdr: 0xbeef, tail: v }
          var b = t.encode()
          return 90 if b.size() != 6
          return 91 if b.get(0) != 0xbe
          return 92 if b.get(1) != 0xef
          return 93 if b.get(2) != 0x11
          return 94 if b.get(5) != 0x44
          match Trailer.decode(b)
            Ok(t2) => {
              return 1 if t2.hdr != 0xbeef
              return 2 if t2.tail.size != 4
              return 3 if t2.tail[0] != 0x11
              return 4 if t2.tail[3] != 0x44
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("[u32le] rest-of-stream with 4-byte little-endian elements") do ->
      assert_run_exits("""
        import * from binary
        import * from bytes
        type U32Tail = binary {
          magic: u16be
          nums:  [u32le]
        }
        def main(): Int
          var v = vec_new()
          v.push(0x01020304)
          v.push(0xdeadbeef)
          var t = U32Tail { magic: 0xfeed, nums: v }
          var b = t.encode()
          return 90 if b.size() != 10
          return 91 if b.get(0) != 0xfe
          return 92 if b.get(1) != 0xed
          return 93 if b.get(2) != 0x04
          return 94 if b.get(3) != 0x03
          return 95 if b.get(4) != 0x02
          return 96 if b.get(5) != 0x01
          return 97 if b.get(6) != 0xef
          return 98 if b.get(9) != 0xde
          match U32Tail.decode(b)
            Ok(t2) => {
              return 1 if t2.magic != 0xfeed
              return 2 if t2.nums.size != 2
              return 3 if t2.nums[0] != 0x01020304
              return 4 if t2.nums[1] != 0xdeadbeef
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("self.field.size in a computed count drives a [T; field] tail") do ->
      # Track A compute expressions resolve member access on non-primitive
      # fields because the MIR struct registry now carries the runtime
      # annotation (e.g. Vec<Int>) from the binary field spec. This was
      # filed as TA-F5; fix landed alongside the UFCS dot form test.
      assert_run_exits("""
        import * from binary
        import * from bytes
        type Vlen = binary {
          count:   u16be = self.payload.size
          payload: [u8; count]
        }
        def main(): Int
          var v = vec_new()
          v.push(0x77)
          v.push(0x88)
          v.push(0x99)
          v.push(0xaa)
          v.push(0xbb)
          var h = Vlen { count: 0, payload: v }
          var b = h.encode()
          return 90 if b.size() != 7
          return 91 if b.get(0) != 0
          return 92 if b.get(1) != 5
          return 93 if b.get(2) != 0x77
          return 94 if b.get(6) != 0xbb
          match Vlen.decode(b)
            Ok(h2) => {
              return 1 if h2.count != 5
              return 2 if h2.payload.size != 5
              return 3 if h2.payload[0] != 0x77
              return 4 if h2.payload[4] != 0xbb
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

    it("computed scalar field alongside a [T] array tail") do ->
      # Exercises Track A + Track C together: a computed scalar field
      # followed by a rest-of-stream array tail. Counterpart to the
      # preceding `self.payload.size` test for pure integer arithmetic
      # in a compute expression.
      assert_run_exits("""
        import * from binary
        import * from bytes
        type TaggedTail = binary {
          kind:    u8
          doubled: u8 = self.kind * 2
          tail:    [u8]
        }
        def main(): Int
          var v = vec_new()
          v.push(0xaa)
          v.push(0xbb)
          var h = TaggedTail { kind: 9, doubled: 0, tail: v }
          var b = h.encode()
          return 90 if b.size() != 4
          return 91 if b.get(0) != 9
          return 92 if b.get(1) != 18
          return 93 if b.get(2) != 0xaa
          return 94 if b.get(3) != 0xbb
          match TaggedTail.decode(b)
            Ok(h2) => {
              return 1 if h2.kind != 9
              return 2 if h2.doubled != 18
              return 3 if h2.tail.size != 2
              return 4 if h2.tail[1] != 0xbb
              return 0
            }
            Err(_) => return 99
          end
        end
        """, 0)
    end

  end

  return qspec_main()
end
