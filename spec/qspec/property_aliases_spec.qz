## Property Aliases Tests
##
## Contract:
##   1. .size for empty map.
##   2. .size for empty string.
##   3. .size for empty vec.
##   4. .size for map after.
##   5. .size for map size.
##   6. .size for map with.
import * from qspec

def main(): Int
  describe("property aliases") do ->
    it(".size for string length") do ->
      var s = "hello"
      assert_eq(s.size, 5)
    end
    it(".size for vec length") do ->
      var v = [10, 20, 30]
      assert_eq(v.size, 3)
    end
    it(".size for map size") do ->
      var m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      assert_eq(m.size, 2)
    end

    it(".size for empty string") do ->
      var s = ""
      assert_eq(s.size, 0)
    end

    it(".size for single char string") do ->
      var s = "x"
      assert_eq(s.size, 1)
    end

    it(".size for long string") do ->
      var s = "abcdefghijklmnopqrstuvwxyz"
      assert_eq(s.size, 26)
    end

    it(".size for empty vec") do ->
      var v = vec_new()
      assert_eq(v.size, 0)
    end

    it(".size for vec after push") do ->
      var v = vec_new()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      assert_eq(v.size, 5)
    end

    it(".size for vec after pop") do ->
      var v = [10, 20, 30]
      v.pop()
      assert_eq(v.size, 2)
    end

    it(".size for empty map") do ->
      var m = map_new()
      assert_eq(m.size, 0)
    end

    it(".size for map after overwrite") do ->
      var m = map_new()
      m.set("key", 1)
      m.set("key", 2)
      assert_eq(m.size, 1)
    end

    it(".size for map with many entries") do ->
      var m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      m.set("c", 3)
      m.set("d", 4)
      m.set("e", 5)
      assert_eq(m.size, 5)
    end

  end
  return qspec_main()
end

