## FIX.6 Phase 2: Bidirectional Closure Parameter Inference Tests
##
## Contract:
##   1. Lambda params infer types from callee's Fn parameter signature.
##   2. Explicit annotations still work (backward compatible).
##   3. Multi-param closures with inference work.
##   4. Return type contexts (Bool, String) work.

import * from qspec

# Helper: apply a function to a value
def apply_int(f: Fn(Int): Int, x: Int): Int = f(x)

# Helper: transform with predicate
def transform(val: Int, f: Fn(Int): Int): Int = f(val)

# Helper: takes two-param closure
def combine(a: Int, b: Int, f: Fn(Int, Int): Int): Int = f(a, b)

# Helper: takes closure returning Bool
def check(val: Int, pred: Fn(Int): Bool): Bool = pred(val)

# Helper: takes closure returning String
def label(val: Int, fmt: Fn(Int): String): String = fmt(val)

def main(): Int
  describe("basic closure param inference") do ->
    it("infers Int param from Fn(Int): Int") do ->
      var result = apply_int(x -> x * 2, 21)
      assert_eq(result, 42)
    end

    it("infers param when closure is second arg") do ->
      var result = transform(10, x -> x + 5)
      assert_eq(result, 15)
    end

    it("infers two params from Fn(Int, Int): Int") do ->
      var result = combine(3, 4, (a, b) -> a + b)
      assert_eq(result, 7)
    end

    it("infers param with Bool return") do ->
      var result = check(42, x -> x > 0)
      assert_eq(result, true)
    end

    it("infers param with String return") do ->
      var result = label(42, x -> "value: #{x}")
      assert_eq_str(result, "value: 42")
    end
  end

  describe("explicit annotations still work") do ->
    it("explicit annotation on closure param") do ->
      var result = apply_int(x: Int -> x * 3, 10)
      assert_eq(result, 30)
    end

    it("explicit matches expected type") do ->
      var result = combine(5, 6, (a: Int, b: Int) -> a * b)
      assert_eq(result, 30)
    end
  end

  describe("closure param inference edge cases") do ->
    it("nested apply with inference") do ->
      var r = apply_int(x -> apply_int(y -> y + 1, x), 10)
      assert_eq(r, 11)
    end

    it("multiply in inferred closure") do ->
      var result = combine(5, 7, (a, b) -> a * b)
      assert_eq(result, 35)
    end
  end

  return qspec_main()
end
