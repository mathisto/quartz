## Packed Structs Tests
##
## Contract:
##   1. Combined: `@repr(C) @packed` on struct.
##   2. Non-packed padding: non-packed repr(C) has alignment padding.
##   3. Read/write: packed struct field read/write works.
##   4. First field: first field offset is 0.
##   5. No padding: packed struct has no padding.
##   6. Second field: second field at correct byte offset.
##   7. Mutation: packed struct field mutation works.
##   8. Three fields: packed struct with three Int fields.
import * from qspec
import * from qspec/subprocess

@packed
struct PackedSimple
  a: Int
  b: Int
end

def main(): Int
  describe("packed structs") do ->
    it("packed struct field read/write works") do ->
      var s = PackedSimple { a: 10, b: 32 }
      assert_eq(s.a + s.b, 42)
    end
    it("packed struct has no padding in field_offset (@repr(C) + CChar/CInt)") do ->
      assert_run_exits("""
        @repr(C)
        @packed
        struct PackedMixed
          a: U8
          b: I32
        end
        def main(): Int
          return field_offset<PackedMixed>(1)
        end
        """, 1)
    end
    it("non-packed repr(C) struct has padding (@repr(C) + CChar/CInt)") do ->
      assert_run_exits("""
        @repr(C)
        struct ReprC
          tag: U8
          value: I32
        end
        def main(): Int
          return field_offset<ReprC>(1)
        end
        """, 4)
    end
    it("@repr(C) @packed combined (@repr(C) + CChar/CInt)") do ->
      assert_run_exits("""
        @repr(C)
        @packed
        struct PackedHeader
          tag: U8
          len: U16
          value: I32
        end
        def main(): Int
          var h = PackedHeader { tag: 1, len: 256, value: 42 }
          return h.value
        end
        """, 42)
    end
    it("packed struct first field offset is 0 (@repr(C) + field_offset)") do ->
      assert_run_exits("""
        @repr(C)
        struct Point
          x: I32
          y: I32
        end
        def main(): Int
          return field_offset<Point>(0)
        end
        """, 0)
    end
    it("packed struct second field at byte 1 (@repr(C) + field_offset)") do ->
      assert_run_exits("""
        @repr(C)
        struct Header
          tag: U8
          len: U16
          value: I32
        end
        def main(): Int
          return field_offset<Header>(1)
        end
        """, 2)
    end
    it("packed struct field mutation") do ->
      var s = PackedSimple { a: 10, b: 20 }
      s.a = 30
      assert_eq(s.a + s.b, 50)
    end
    it("packed struct with three Int fields") do ->
      var s = PackedSimple { a: 5, b: 7 }
      assert_eq(s.a * s.b, 35)
    end
  end
  return qspec_main()
end
