## Map Tests
##
## Contract:
##   1. Map_new and map_free.
##   2. Map_set and map_get.
##   3. Map_has.
##   4. Map_delete.
##   5. Collision handling.
##   6. Resizing.
##   7. Map literal syntax.
##   8. Map properties.

import * from qspec
import * from qspec/property

def main(): Int
  describe("map_new and map_free") do ->
    it("creates and frees an empty map") do ->
      m = map_new()
      m.free()
      assert_eq(0, 0)
    end
  end

  describe("map_set and map_get") do ->
    it("stores and retrieves a single value") do ->
      m = map_new()
      m.set("key", 42)
      match m.get("key")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("stores and retrieves multiple values") do ->
      m = map_new()
      m.set("a", 1)
      m.set("b", 2)
      m.set("c", 3)
      var sum = 0
      match m.get("a")
        Some(v) => sum = sum + v
        _ => assert_eq(0, 1)
      end
      match m.get("b")
        Some(v) => sum = sum + v
        _ => assert_eq(0, 1)
      end
      match m.get("c")
        Some(v) => sum = sum + v
        _ => assert_eq(0, 1)
      end
      m.free()
      assert_eq(sum, 6)
    end

    it("returns None for missing key") do ->
      m = map_new()
      m.set("exists", 99)
      v = m.get("missing")
      m.free()
      assert(v.none?)
    end

    it("overwrites existing key") do ->
      m = map_new()
      m.set("key", 10)
      m.set("key", 20)
      match m.get("key")
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      m.free()
    end
  end

  describe("map_has") do ->
    it("returns true for existing key") do ->
      m = map_new()
      m.set("key", 42)
      exists = m.has("key")
      m.free()
      if exists
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
    end

    it("returns false for missing key") do ->
      m = map_new()
      m.set("other", 42)
      exists = m.has("missing")
      m.free()
      if exists
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end
  end

  describe("map_delete") do ->
    it("removes a key") do ->
      m = map_new()
      m.set("key", 42)
      m.delete("key")
      exists = m.has("key")
      m.free()
      if exists
        assert_eq(1, 0)
      else
        assert_eq(0, 0)
      end
    end

    it("handles delete of non-existent key") do ->
      m = map_new()
      m.delete("missing")
      m.free()
      assert_eq(0, 0)
    end
  end

  describe("collision handling") do ->
    it("handles many keys correctly") do ->
      m = map_new()
      m.set("key1", 1)
      m.set("key2", 2)
      m.set("key3", 3)
      m.set("key4", 4)
      m.set("key5", 5)
      m.set("key6", 6)
      m.set("key7", 7)
      m.set("key8", 8)
      var sum = 0
      match m.get("key1")
        Some(v) => sum = sum + v
        _ => assert_eq(0, 1)
      end
      match m.get("key8")
        Some(v) => sum = sum + v
        _ => assert_eq(0, 1)
      end
      m.free()
      assert_eq(sum, 9)
    end
  end

  describe("resizing") do ->
    it("grows when load factor exceeds threshold") do ->
      m = map_new()
      for i in 0..50
        m.set("key_" + to_str(i), i)
      end
      match m.get("key_0")
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
      match m.get("key_49")
        Some(v) => assert_eq(v, 49)
        _ => assert_eq(0, 1)
      end
      m.free()
    end
  end

  describe("map literal syntax") do ->
    it("creates map with {:key => val} syntax") do ->
      m = {:name => 42, :age => 10}
      match m.get("name")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
      match m.get("age")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("creates map with {key: val} syntax") do ->
      m = {name: 42, age: 10}
      match m.get("name")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
      match m.get("age")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("allows expression values in map literal") do ->
      m = {total: 5 + 5, product: 3 * 7}
      match m.get("total")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match m.get("product")
        Some(v) => assert_eq(v, 21)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("allows trailing comma in map literal") do ->
      m = {x: 10, y: 20,}
      match m.get("y")
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("allows mixing shorthand and explicit symbol keys") do ->
      m = {name: 42, :age => 10}
      match m.get("name")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
      match m.get("age")
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    it("creates empty map with {}") do ->
      m = {}
      m.set("x", 42)
      match m.get("x")
        Some(v) => assert_eq(v, 42)
        _ => assert_eq(0, 1)
      end
      m.free()
    end
  end

  # ==========================================================================
  # Property Tests
  # ==========================================================================

  describe("map properties") do ->
    forall_i("set/get roundtrip") do x: Int ->
      var m = map_new()
      var key = "#{x}"
      m.set(key, x)
      match m.get(key)
        Some(v) => assert_eq(v, x)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    forall_i("has returns true after set") do x: Int ->
      var m = map_new()
      m.set("#{x}", x)
      if m.has("#{x}")
        assert_eq(1, 1)
      else
        assert_eq(0, 1)
      end
      m.free()
    end

    forall_i("overwrite preserves last value") do x: Int ->
      var m = map_new()
      var key = "#{x}"
      m.set(key, x)
      m.set(key, x + 1)
      match m.get(key)
        Some(v) => assert_eq(v, x + 1)
        _ => assert_eq(0, 1)
      end
      m.free()
    end

    forall_i("del removes key") do x: Int ->
      var m = map_new()
      var key = "#{x}"
      m.set(key, x)
      m.delete(key)
      if m.has(key)
        assert_eq(0, 1)
      else
        assert_eq(1, 1)
      end
      m.free()
    end
  end

  return qspec_main()
end
