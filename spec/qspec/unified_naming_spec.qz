## Unified Naming Tests
##
## Contract:
##   1. Queue: push/shift/first aliases work.
##   2. Deque: push/pop/unshift/shift/first/last aliases work.
##   3. Linked list: push/pop/unshift/shift/first/last aliases work.
##   4. Priority queue min: min-heap created by default.
##   5. Priority queue max: max-heap via `_new_max`.
##   6. Queue empty: empty queue shift returns None.
##   7. Deque interleaved: interleaved push/shift/pop sequence.
import * from qspec
import * from collections/queue
import * from collections/deque
import * from collections/linked_list
import * from collections/priority_queue

def main(): Int
  describe("queue canonical aliases") do ->
    it("push/shift/first work like enqueue/dequeue/peek") do ->
      var q = queue_new()
      q.push(10)
      q.push(20)
      q.push(30)
      match q.first()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match q.shift()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
      match q.shift()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      assert_eq(q.size(), 1)
    end
  end

  describe("deque canonical aliases") do ->
    it("push/pop/unshift/shift/first/last work") do ->
      var d = deque_new()
      d.push(1)
      d.push(2)
      d.unshift(0)
      match d.first()
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
      match d.last()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match d.shift()
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
      match d.pop()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      assert_eq(d.size(), 1)
    end
  end

  describe("linked_list canonical aliases") do ->
    it("push/pop/unshift/shift/first/last work") do ->
      var ll = linked_list_new()
      ll.push(1)
      ll.push(2)
      ll.unshift(0)
      match ll.first()
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
      match ll.last()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      match ll.shift()
        Some(v) => assert_eq(v, 0)
        _ => assert_eq(0, 1)
      end
      match ll.pop()
        Some(v) => assert_eq(v, 2)
        _ => assert_eq(0, 1)
      end
      assert_eq(ll.size(), 1)
    end
  end

  describe("priority_queue constructor aliases") do ->
    it("priority_queue_new creates min-heap") do ->
      var pq = priority_queue_new()
      pq.push(30)
      pq.push(10)
      pq.push(20)
      match pq.pop()
        Some(v) => assert_eq(v, 10)
        _ => assert_eq(0, 1)
      end
    end

    it("priority_queue_new_max creates max-heap") do ->
      var pq = priority_queue_new_max()
      pq.push(30)
      pq.push(10)
      pq.push(20)
      match pq.pop()
        Some(v) => assert_eq(v, 30)
        _ => assert_eq(0, 1)
      end
    end
  end

  describe("queue edge cases") do ->
    it("shift on empty queue returns None") do ->
      var q = queue_new()
      match q.shift()
        Some(_) => assert_eq(0, 1)
        None => assert_eq(1, 1)
      end
    end
  end

  describe("deque interleaved operations") do ->
    it("interleaved push/shift/pop sequence") do ->
      var d = deque_new()
      d.push(10)
      d.push(20)
      d.unshift(5)
      match d.shift()
        Some(v) => assert_eq(v, 5)
        _ => assert_eq(0, 1)
      end
      match d.pop()
        Some(v) => assert_eq(v, 20)
        _ => assert_eq(0, 1)
      end
      assert_eq(d.size(), 1)
    end
  end

  return qspec_main()
end
