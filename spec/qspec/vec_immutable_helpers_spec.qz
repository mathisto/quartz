## Immutable-interface Vec helpers — vec_remove_at, vec_concat,
## vec_pop_n_from_end. These are the clone-then-mutate generic
## wrappers in std/vec.qz that the deckbuilder + widget consumers use
## in place of hand-rolled type-specialized helpers.
##
## Coverage axis:
##   - Vec<Int>            — primitive, works against the in-place mutators directly
##   - Vec<String>         — boxed value, exercises the i64-handle existential model
##   - Vec<UserStruct>     — user-allocated struct, mirrors the deckbuilder's Vec<Card>
##
## Each helper is tested for: correct output, source-unmutated invariant,
## and edge cases (empty, oob, n > size).

import * from qspec
import * from std/vec

struct Card
  name: String
  cost: Int
end

def card_new(name: String, cost: Int): Card
  return Card { name: name, cost: cost }
end

def main(): Int
  describe("vec_remove_at") do ->
    it("removes the element at idx (Vec<Int>)") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      v.push(30)
      var out = vec_remove_at(v, 1)
      assert_eq(out.size, 2)
      assert_eq(out[0], 10)
      assert_eq(out[1], 30)
    end

    it("does not mutate the source") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var ignored = vec_remove_at(v, 0)
      assert_eq(v.size, 3)
      assert_eq(v[0], 1)
      assert_eq(ignored.size, 2)
    end

    it("removes from Vec<String>") do ->
      var v = vec_new<String>()
      v.push("alpha")
      v.push("beta")
      v.push("gamma")
      var out = vec_remove_at(v, 1)
      assert_eq(out.size, 2)
      assert_eq_str(out[0], "alpha")
      assert_eq_str(out[1], "gamma")
    end

    it("removes from Vec<UserStruct>") do ->
      var v = vec_new<Card>()
      v.push(card_new("Strike", 1))
      v.push(card_new("Defend", 1))
      v.push(card_new("Bash", 2))
      var out = vec_remove_at(v, 0)
      assert_eq(out.size, 2)
      assert_eq_str(out[0].name, "Defend")
      assert_eq_str(out[1].name, "Bash")
    end

    it("clamps oob idx to no-op (idx < 0)") do ->
      var v = vec_new<Int>()
      v.push(7)
      var out = vec_remove_at(v, -1)
      assert_eq(out.size, 1)
      assert_eq(out[0], 7)
    end

    it("clamps oob idx to no-op (idx >= size)") do ->
      var v = vec_new<Int>()
      v.push(9)
      var out = vec_remove_at(v, 5)
      assert_eq(out.size, 1)
      assert_eq(out[0], 9)
    end

    it("removing from empty returns empty") do ->
      var v = vec_new<Int>()
      var out = vec_remove_at(v, 0)
      assert_eq(out.size, 0)
    end
  end

  describe("vec_concat") do ->
    it("concatenates two Vec<Int>") do ->
      var a = vec_new<Int>()
      a.push(1)
      a.push(2)
      var b = vec_new<Int>()
      b.push(3)
      b.push(4)
      var out = vec_concat(a, b)
      assert_eq(out.size, 4)
      assert_eq(out[0], 1)
      assert_eq(out[3], 4)
    end

    it("does not mutate either source") do ->
      var a = vec_new<Int>()
      a.push(1)
      var b = vec_new<Int>()
      b.push(2)
      var ignored = vec_concat(a, b)
      assert_eq(a.size, 1)
      assert_eq(b.size, 1)
      assert_eq(ignored.size, 2)
    end

    it("empty + non-empty returns clone of right") do ->
      var a = vec_new<Int>()
      var b = vec_new<Int>()
      b.push(99)
      var out = vec_concat(a, b)
      assert_eq(out.size, 1)
      assert_eq(out[0], 99)
    end

    it("non-empty + empty returns clone of left") do ->
      var a = vec_new<Int>()
      a.push(7)
      var b = vec_new<Int>()
      var out = vec_concat(a, b)
      assert_eq(out.size, 1)
      assert_eq(out[0], 7)
    end

    it("empty + empty returns empty") do ->
      var a = vec_new<Int>()
      var b = vec_new<Int>()
      var out = vec_concat(a, b)
      assert_eq(out.size, 0)
    end

    it("concatenates Vec<String>") do ->
      var a = vec_new<String>()
      a.push("hi")
      var b = vec_new<String>()
      b.push("there")
      b.push("world")
      var out = vec_concat(a, b)
      assert_eq(out.size, 3)
      assert_eq_str(out[0], "hi")
      assert_eq_str(out[2], "world")
    end

    it("concatenates Vec<UserStruct>") do ->
      var a = vec_new<Card>()
      a.push(card_new("Strike", 1))
      var b = vec_new<Card>()
      b.push(card_new("Defend", 1))
      var out = vec_concat(a, b)
      assert_eq(out.size, 2)
      assert_eq_str(out[0].name, "Strike")
      assert_eq_str(out[1].name, "Defend")
    end
  end

  describe("vec_pop_n_from_end") do ->
    it("pops n from the end of a Vec<Int>") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      v.push(4)
      v.push(5)
      var pair = vec_pop_n_from_end(v, 2)
      var drawn = pair.0
      var remaining = pair.1
      assert_eq(drawn.size, 2)
      assert_eq(drawn[0], 5)
      assert_eq(drawn[1], 4)
      assert_eq(remaining.size, 3)
      assert_eq(remaining[0], 1)
      assert_eq(remaining[2], 3)
    end

    it("does not mutate the source") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      v.push(3)
      var ignored = vec_pop_n_from_end(v, 2)
      assert_eq(v.size, 3)
      assert_eq(v[0], 1)
      assert_eq(v[2], 3)
      assert_eq(ignored.0.size, 2)
    end

    it("n > size draws all, remaining is empty") do ->
      var v = vec_new<Int>()
      v.push(10)
      v.push(20)
      var pair = vec_pop_n_from_end(v, 5)
      var drawn = pair.0
      var remaining = pair.1
      assert_eq(drawn.size, 2)
      assert_eq(drawn[0], 20)
      assert_eq(drawn[1], 10)
      assert_eq(remaining.size, 0)
    end

    it("n = 0 draws nothing, remaining is full clone") do ->
      var v = vec_new<Int>()
      v.push(1)
      v.push(2)
      var pair = vec_pop_n_from_end(v, 0)
      var drawn = pair.0
      var remaining = pair.1
      assert_eq(drawn.size, 0)
      assert_eq(remaining.size, 2)
      assert_eq(remaining[0], 1)
    end

    it("pops from empty source — both empty") do ->
      var v = vec_new<Int>()
      var pair = vec_pop_n_from_end(v, 3)
      assert_eq(pair.0.size, 0)
      assert_eq(pair.1.size, 0)
    end

    it("pops from Vec<String>") do ->
      var v = vec_new<String>()
      v.push("a")
      v.push("b")
      v.push("c")
      var pair = vec_pop_n_from_end(v, 2)
      var drawn = pair.0
      var remaining = pair.1
      assert_eq(drawn.size, 2)
      assert_eq_str(drawn[0], "c")
      assert_eq_str(drawn[1], "b")
      assert_eq(remaining.size, 1)
      assert_eq_str(remaining[0], "a")
    end

    it("pops from Vec<UserStruct> (deckbuilder draw shape)") do ->
      var deck = vec_new<Card>()
      deck.push(card_new("Strike", 1))
      deck.push(card_new("Defend", 1))
      deck.push(card_new("Bash", 2))
      deck.push(card_new("Cleave", 1))
      deck.push(card_new("Heavy Blade", 2))
      var pair = vec_pop_n_from_end(deck, 5)
      var drawn = pair.0
      var remaining = pair.1
      assert_eq(drawn.size, 5)
      assert_eq_str(drawn[0].name, "Heavy Blade")
      assert_eq_str(drawn[4].name, "Strike")
      assert_eq(remaining.size, 0)
    end
  end

  return qspec_main()
end
