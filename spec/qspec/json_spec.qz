## Json Tests
##
## Contract:
##   1. Json value constructors.
##   2. Json parsing.
##   3. Json stringify.
##   4. Json float parsing.
##   5. Json pretty printing.
import * from qspec
import * from json

def json_ok_value(source: String): JsonValue
  var result = json_parse(source)
  match result
    Ok(v) => return v
    _ => return json_null()
  end
end

def main(): Int
  describe("json value constructors") do ->
    it("json_null creation") do ->
      var v = json_null()
      assert_eq(json_is_null(v), true)
    end

    it("json_bool creation") do ->
      var t = json_bool(1)
      var f = json_bool(0)
      assert_eq(json_is_bool(t), true)
      assert_eq(json_as_bool(t), 1)
      assert_eq(json_as_bool(f), 0)
    end

    it("json_number creation") do ->
      var n = json_number(42)
      assert_eq(json_is_number(n), true)
      assert_eq(json_as_number(n), 42)
    end
  end

  describe("json parsing") do ->
    it("parses JSON string") do ->
      var v = json_ok_value("\"hello\"")
      assert_eq(json_is_string(v), true)
      assert_eq_str(json_as_string(v), "hello")
    end

    it("parses JSON array") do ->
      var v = json_ok_value("[1,2,3]")
      assert_eq(json_is_array(v), true)
      assert_eq(json_array_size(v), 3)
      assert_eq(json_as_number(json_array_get(v, 0)), 1)
      assert_eq(json_as_number(json_array_get(v, 2)), 3)
    end

    it("parses JSON object") do ->
      var v = json_ok_value("{\"name\":\"test\",\"age\":42}")
      assert_eq(json_is_object(v), true)
      assert_eq_str(json_as_string(json_object_get(v, "name")), "test")
      assert_eq(json_as_number(json_object_get(v, "age")), 42)
    end

    it("returns Result::Err on invalid input") do ->
      var result = json_parse("not valid json")
      assert_eq(is_err(result), true)
    end

    it("ParseError has line and column") do ->
      var result = json_parse("{bad}")
      match result
        Err(e) => do
          assert_eq(e.line() > 0, true)
          assert_eq(e.message().size > 0, true)
        end
        _ => panic("expected error")
      end
    end
  end

  describe("json stringify") do ->
    it("stringifies values") do ->
      assert_eq_str(json_stringify(json_null()), "null")
      assert_eq_str(json_stringify(json_bool(1)), "true")
      assert_eq_str(json_stringify(json_bool(0)), "false")
      assert_eq_str(json_stringify(json_number(42)), "42")
      assert_eq_str(json_stringify(json_string("hello")), "\"hello\"")
    end
  end

  describe("json float parsing") do ->
    it("parses a float value") do ->
      var v = json_ok_value("3.14")
      assert_eq_str(json_stringify(v), "3.14")
    end

    it("parses a negative float") do ->
      var v = json_ok_value("-2.5")
      assert_eq_str(json_stringify(v), "-2.5")
    end

    it("parses scientific notation") do ->
      var v = json_ok_value("1.5e2")
      assert_eq(json_is_null(v), false)
    end

    it("parses float in object") do ->
      var v = json_ok_value("{\"pi\":3.14}")
      assert_eq(json_is_object(v), true)
      assert_eq_str(json_stringify(json_object_get(v, "pi")), "3.14")
    end

    it("distinguishes integers from floats") do ->
      var int_v = json_ok_value("42")
      var float_v = json_ok_value("3.14")
      assert_eq(json_is_number(int_v), true)
      assert_eq(json_is_number(float_v), false)
    end
  end

  describe("json pretty printing") do ->
    it("pretty prints empty object") do ->
      assert_eq_str(json_stringify_pretty(json_object(), 2), "{}")
    end

    it("pretty prints empty array") do ->
      assert_eq_str(json_stringify_pretty(json_array(), 2), "[]")
    end

    it("pretty prints simple object") do ->
      var obj = json_object()
      json_object_set(obj, "name", json_string("test"))
      var result = json_stringify_pretty(obj, 2)
      assert_eq(str_contains(result, "\"name\""), true)
      assert_eq(str_contains(result, "\"test\""), true)
    end

    it("pretty prints simple values") do ->
      assert_eq_str(json_stringify_pretty(json_null(), 2), "null")
      assert_eq_str(json_stringify_pretty(json_bool(1), 2), "true")
      assert_eq_str(json_stringify_pretty(json_number(99), 2), "99")
    end
  end

  return qspec_main()
end
