## Chained `v.pop().unwrap().field` on a niche-struct-element Vec (item 11, enum-niche tail).
##
## The sibling READ-INFERENCE hole that 5b fixed for map_get. `v.pop()` inferred bare
## "Option" (T erased), so the chained-unwrap niche binder couldn't thread T and
## `.field` fell through to the GLOBAL field-name→offset table. With a struct element
## type that shares a field name with another struct (here `a`), the global table
## resolves `.a` to the WRONG struct's offset → wrong value read (a CORRECTNESS bug,
## masked whenever the field name is unique because the global table happens to pick
## the only entry).
##
## The fix flips vec_pop's INFERENCE (→ Option<T>) and CONSTRUCTION
## (→ __vec_pop_raw_sentinel raw-niche word) ATOMICALLY for niche-eligible T, so the
## chained unwrap reads the bare value word as the struct pointer and resolves
## `.field` against the concrete T. Under the niche layout vec_pop returns the raw
## word directly (Some=ptr on ok, None=0 on empty); the read identity-binds it.
import * from qspec

struct Other
  zzz: Int
  a: Int
end

struct SomeStruct
  a: Int
  b: Int
end

def main(): Int
  describe("chained v.pop().unwrap().field on niche struct Vec") do ->
    it("reads correct field offset (was Other.a offset — the bug)") do ->
      var v: Vec<SomeStruct> = vec_new<SomeStruct>()
      v.push(SomeStruct { a: 22, b: 7 })
      var s = v.pop().unwrap()
      assert_eq(s.a, 22)
      assert_eq(s.b, 7)
    end

    it("Other resolves its own .a") do ->
      var o: Vec<Other> = vec_new<Other>()
      o.push(Other { zzz: 9, a: 5 })
      assert_eq(o.pop().unwrap().a, 5)
    end

    it("multi-pop returns elements in LIFO order with correct fields") do ->
      var v: Vec<SomeStruct> = vec_new<SomeStruct>()
      v.push(SomeStruct { a: 1, b: 10 })
      v.push(SomeStruct { a: 2, b: 20 })
      var top = v.pop().unwrap()
      assert_eq(top.a, 2)
      assert_eq(top.b, 20)
      var next = v.pop().unwrap()
      assert_eq(next.a, 1)
      assert_eq(next.b, 10)
    end

    it("empty pop is None") do ->
      var v: Vec<SomeStruct> = vec_new<SomeStruct>()
      v.push(SomeStruct { a: 3, b: 4 })
      var first = v.pop()
      assert_eq(first is Some, 1)
      var empty = v.pop()
      assert_eq(empty is None, 1)
    end

    it("Vec<Int> spill round-trips (stays tagged, non-niche elem)") do ->
      var v: Vec<Int> = vec_new<Int>()
      v.push(42)
      var got = v.pop()
      assert_eq(got.unwrap(), 42)
      var none = v.pop()
      assert_eq(none is None, 1)
    end

    it("Vec<Option<Int>> double-Option stays tagged (spill path)") do ->
      var v: Vec<Option<Int>> = vec_new<Option<Int>>()
      v.push(Option::Some(99))
      var inner: Option<Int> = v.pop().unwrap()
      assert_eq(inner.unwrap(), 99)
    end
  end

  return qspec_main()
end
