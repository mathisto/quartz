## Async-aware subprocess wrappers in std/process.qz
##
## These helpers yield to the M:N scheduler while waiting for child output
## or exit, unlike std/shell.qz's blocking pipe_open + fread loop. The
## tests below verify (1) functional correctness, (2) cooperative yield
## (an idle hook fires during the wait), (3) multiple concurrent
## subprocesses complete in parallel, and (4) line streaming preserves
## byte ordering.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("process async") do ->
    it("sh_capture_async captures stdout") do ->
      var src = """
        import * from process
        def main(): Int
          var task = go sh_capture_async("echo captured_hi")
          var out = await task
          puts(out)
          return 0
        end
        """
      assert_run_stdout_eq(src, "captured_hi\n\n")
    end

    it("sh_run_async returns decoded exit code") do ->
      var src = """
        import * from process
        def main(): Int
          var ok_task = go sh_run_async("sh -c 'exit 0'")
          var fail_task = go sh_run_async("sh -c 'exit 7'")
          var ok = await ok_task
          var fail = await fail_task
          puts("ok=" + ok.to_s() + " fail=" + fail.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "ok=0 fail=7\n")
    end

    it("idle hook fires during async subprocess wait") do ->
      var src = """
        import * from process
        var _hook_count: Int = 0
        def bump(): Void can Sched
          _hook_count = _hook_count + 1
        end
        def main(): Int
          sched_idle_hook_set(bump)
          var task = go sh_capture_async("sh -c 'sleep 0.15'")
          var out = await task
          sched_idle_hook_clear()
          if _hook_count > 10
            puts("many")
          else
            if _hook_count > 0
              puts("few")
            else
              puts("zero")
            end
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "many\n")
    end

    it("two concurrent sh_run_async tasks run in parallel") do ->
      var src = """
        import * from process
        def main(): Int
          var t0 = time_mono_ns()
          var a = go sh_run_async("sh -c 'sleep 0.15'")
          var b = go sh_run_async("sh -c 'sleep 0.15'")
          var ra = await a
          var rb = await b
          var elapsed_ms = (time_mono_ns() - t0) / 1000000
          if elapsed_ms < 250
            puts("parallel")
          else
            puts("serial")
          end
          return 0
        end
        """
      assert_run_stdout_eq(src, "parallel\n")
    end

    it("sh_stream_lines_async streams stdout line-by-line") do ->
      var src = """
        import * from process
        var _lines: Int = 0
        def on_line(line: String): Void
          _lines = _lines + 1
        end
        def main(): Int
          var task = go sh_stream_lines_async("printf 'a\\nb\\nc\\n'", on_line)
          var rc = await task
          puts("lines=" + _lines.to_s() + " rc=" + rc.to_s())
          return 0
        end
        """
      assert_run_stdout_eq(src, "lines=3 rc=0\n")
    end
  end

  return qspec_main()
end
