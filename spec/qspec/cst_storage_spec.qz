## CST storage data-model tests (Formatter M1.2)
##
## Exercises the lossless CST arena defined in frontend/cst.qz:
##   - node allocation + kind/byte-span readback across several kinds
##   - n-ary children round-trip in insertion order
##   - trivia attachment (leading + trailing) with the Roslyn EOL split
##     representable (same-line comment = trailing; own-line comment = leading)
##   - trailing-comma author-signal flag round-trip (D4)
##   - verbatim CST_TOKEN leaf: span + lexeme readback
##
## The module is NOT yet wired into the compiler (that is M1.3); this spec is
## its standalone validation oracle.
##
## NOTE: test bodies live in NAMED top-level functions called from thin `it`
## closures. Quartz's compiler scales superlinearly when complex Vec/generic
## bodies are inlined inside many `do ->` closures (a single `main` with ~12
## such closures times out at >250s); delegating to named functions keeps the
## same spec sub-second to compile. This mirrors the CLAUDE.md guidance to use
## named helpers rather than inline closures.

import * from qspec
import cst

# ---- node allocation & spans ---------------------------------------------

def check_sentinel(): Void
  var s = cst_new_storage()
  # Only the sentinel exists initially (count includes it).
  assert_eq(cst_node_count(s), 1)
  assert_eq(cst_trivia_count(s), 1)
end

def check_alloc_kinds_spans(): Void
  var s = cst_new_storage()
  var int_h = cst_alloc(s, 3, 10, 12, 1, 1)   # CST_INT_LIT = 3
  var id_h = cst_alloc(s, 15, 13, 16, 1, 4)   # CST_IDENT = 15
  var bin_h = cst_alloc(s, 19, 10, 16, 1, 1)  # CST_BINARY = 19

  assert_eq(cst_get_kind(s, int_h), 3)
  assert_eq(cst_get_byte_start(s, int_h), 10)
  assert_eq(cst_get_byte_end(s, int_h), 12)

  assert_eq(cst_get_kind(s, id_h), 15)
  assert_eq(cst_get_byte_start(s, id_h), 13)
  assert_eq(cst_get_byte_end(s, id_h), 16)

  assert_eq(cst_get_kind(s, bin_h), 19)
  assert_eq(cst_get_byte_start(s, bin_h), 10)
  assert_eq(cst_get_byte_end(s, bin_h), 16)
end

def check_handle_order(): Void
  var s = cst_new_storage()
  var a = cst_alloc(s, 3, 0, 1, 1, 1)
  var b = cst_alloc(s, 3, 1, 2, 1, 2)
  var c = cst_alloc(s, 3, 2, 3, 1, 3)
  assert_eq(a, 1)
  assert_eq(b, 2)
  assert_eq(c, 3)
end

def check_token_leaf(): Void
  var s = cst_new_storage()
  var t = cst_token(s, "foo", 5, 8, 2, 3)
  assert_eq(cst_get_kind(s, t), 1)  # CST_TOKEN = 1
  assert_eq(cst_get_byte_start(s, t), 5)
  assert_eq(cst_get_byte_end(s, t), 8)
  assert_eq_str(cst_get_str1(s, t), "foo")
end

def check_op_roundtrip(): Void
  var s = cst_new_storage()
  var bin_h = cst_alloc(s, 19, 0, 5, 1, 1)
  cst_set_op(s, bin_h, 1)  # CST_OP_ADD = 1
  assert_eq(cst_get_op(s, bin_h), 1)
end

# ---- n-ary children -------------------------------------------------------

def check_children_order(): Void
  var s = cst_new_storage()
  var list_h = cst_alloc(s, 119, 0, 9, 1, 1)  # CST_ARG_LIST = 119
  var a = cst_alloc(s, 3, 1, 2, 1, 2)
  var b = cst_alloc(s, 3, 4, 5, 1, 5)
  var c = cst_alloc(s, 3, 7, 8, 1, 8)
  cst_push_child(s, list_h, a)
  cst_push_child(s, list_h, b)
  cst_push_child(s, list_h, c)

  assert_eq(cst_child_count(s, list_h), 3)
  var kids = cst_get_children(s, list_h)
  assert_eq(kids[0], a)
  assert_eq(kids[1], b)
  assert_eq(kids[2], c)
  assert_eq(cst_get_child(s, list_h, 0), a)
  assert_eq(cst_get_child(s, list_h, 1), b)
  assert_eq(cst_get_child(s, list_h, 2), c)
end

def check_no_children(): Void
  var s = cst_new_storage()
  var h = cst_alloc(s, 15, 0, 3, 1, 1)
  assert_eq(cst_child_count(s, h), 0)
  assert_eq(cst_get_children(s, h).size, 0)
  assert_eq(cst_get_child(s, h, 0), 0)  # out-of-range -> null sentinel
end

# ---- trivia (Roslyn EOL rule) --------------------------------------------

# Source model:
#   x = 1  # inline        (comment trails `1` -> trailing trivia of `1`)
#   # standalone           (own-line comment -> leading trivia of next token)
#                          (blank-line run -> also leading trivia of next token)
#   y = 2
def check_trivia_split(): Void
  var s = cst_new_storage()
  var one_h = cst_alloc(s, 3, 4, 5, 1, 5)   # the literal `1`
  var y_h = cst_alloc(s, 15, 30, 31, 4, 1)  # the ident `y`

  var inline_c = cst_alloc_trivia(s, 1, 7, 15)  # TRIVIA_LINE_COMMENT = 1
  cst_attach_trailing_trivia(s, one_h, inline_c)

  var standalone_c = cst_alloc_trivia(s, 1, 16, 28)
  var blanks = cst_alloc_trivia(s, 5, 28, 30)   # TRIVIA_BLANK_LINES = 5
  cst_attach_leading_trivia(s, y_h, standalone_c)
  cst_attach_leading_trivia(s, y_h, blanks)

  # trailing of `1`
  assert_eq(cst_trailing_trivia_count(s, one_h), 1)
  var tr = cst_get_trailing_trivia(s, one_h)
  assert_eq(cst_trivia_kind(s, tr[0]), 1)        # LINE_COMMENT
  assert_eq(cst_trivia_byte_start(s, tr[0]), 7)
  assert_eq(cst_trivia_byte_end(s, tr[0]), 15)

  # leading of `y` in source order: comment, then blanks
  assert_eq(cst_leading_trivia_count(s, y_h), 2)
  var ld = cst_get_leading_trivia(s, y_h)
  assert_eq(cst_trivia_kind(s, ld[0]), 1)        # LINE_COMMENT
  assert_eq(cst_trivia_kind(s, ld[1]), 5)        # BLANK_LINES
  assert_eq(cst_trivia_byte_start(s, ld[1]), 28)
  assert_eq(cst_trivia_byte_end(s, ld[1]), 30)
end

def check_no_trivia(): Void
  var s = cst_new_storage()
  var h = cst_alloc(s, 15, 0, 1, 1, 1)
  assert_eq(cst_leading_trivia_count(s, h), 0)
  assert_eq(cst_trailing_trivia_count(s, h), 0)
  assert_eq(cst_get_leading_trivia(s, h).size, 0)
  assert_eq(cst_get_trailing_trivia(s, h).size, 0)
end

def check_doc_roundtrip(): Void
  var s = cst_new_storage()
  var fn_h = cst_alloc(s, 83, 0, 20, 1, 1)  # CST_FUNCTION_BLOCK = 83
  cst_set_doc(s, fn_h, "## does a thing")
  assert_eq_str(cst_get_doc(s, fn_h), "## does a thing")
end

# ---- trailing-comma signal (D4) ------------------------------------------

def check_tc_default_false(): Void
  var s = cst_new_storage()
  var list_h = cst_alloc(s, 119, 0, 9, 1, 1)  # CST_ARG_LIST
  assert_eq(cst_has_trailing_comma(s, list_h), 0)
end

def check_tc_roundtrip(): Void
  var s = cst_new_storage()
  var list_h = cst_alloc(s, 119, 0, 9, 1, 1)
  cst_set_trailing_comma(s, list_h, 1)
  assert_eq(cst_has_trailing_comma(s, list_h), 1)
  cst_set_trailing_comma(s, list_h, 1)  # idempotent
  assert_eq(cst_has_trailing_comma(s, list_h), 1)
  cst_set_trailing_comma(s, list_h, 0)
  assert_eq(cst_has_trailing_comma(s, list_h), 0)
end

def check_tc_independent(): Void
  var s = cst_new_storage()
  var with_comma = cst_alloc(s, 87, 0, 5, 1, 1)  # CST_PARAM_LIST = 87
  var no_comma = cst_alloc(s, 87, 6, 11, 2, 1)
  cst_set_trailing_comma(s, with_comma, 1)
  assert_eq(cst_has_trailing_comma(s, with_comma), 1)
  assert_eq(cst_has_trailing_comma(s, no_comma), 0)
end

def main(): Int
  describe("CstStorage — allocation & spans") do ->
    it("reserves handle 0 as the null sentinel") do ->
      check_sentinel()
    end
    it("allocates nodes of several kinds; reads back kind + byte span") do ->
      check_alloc_kinds_spans()
    end
    it("handles are assigned in append order starting at 1") do ->
      check_handle_order()
    end
    it("CST_TOKEN leaf round-trips lexeme + span") do ->
      check_token_leaf()
    end
    it("op discriminant round-trips on a binary node") do ->
      check_op_roundtrip()
    end
  end

  describe("CstStorage — n-ary children") do ->
    it("builds an n-ary node; children read back in insertion order") do ->
      check_children_order()
    end
    it("a node with no children reports count 0 and an empty Vec") do ->
      check_no_children()
    end
  end

  describe("CstStorage — trivia (Roslyn EOL rule)") do ->
    it("trailing (same line) vs leading (own line) trivia round-trip in order") do ->
      check_trivia_split()
    end
    it("a node with no trivia reports zero counts and empty Vecs") do ->
      check_no_trivia()
    end
    it("doc-comment text attaches and round-trips") do ->
      check_doc_roundtrip()
    end
  end

  describe("CstStorage — trailing-comma signal (D4)") do ->
    it("defaults to false on a fresh list node") do ->
      check_tc_default_false()
    end
    it("set true then read back true; set false then read back false") do ->
      check_tc_roundtrip()
    end
    it("trailing-comma flag is independent across nodes") do ->
      check_tc_independent()
    end
  end

  return qspec_main()
end
