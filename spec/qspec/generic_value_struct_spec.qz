## Generic-over-@value struct field inlining — B.10 §12.9
##
## Validates selective generic-over-@value monomorphization: a generic struct
## instantiated at a @value-layout type stores that type's fields INLINE (single
## indirection), instead of heap-boxing the field and double-chasing a pointer.
##
## Contract:
##   1. Box<@value P>: construct + read b.item.x / b.item.y inline.
##   2. Generic struct with TWO fields, one @value — both at index 0 and 1, with
##      the scalar field landing at its real (shifted) byte offset.
##   3. Boxed paths unchanged: Box<Int> and Box<String> still box correctly.
##
## The inline path is gated to fire ONLY when a type-arg is a registered @value
## struct; every other instantiation keeps the byte-identical Boxed layout.

import * from qspec

@value
struct GVPoint
  x: Int
  y: Int
end

struct GVBox<T>
  item: T
end

struct GVPair<A, B>
  first: A
  second: B
end

struct GVHeap
  a: Int
  b: Int
end

# === Inline @value field (index 0) ===

def gvs_box_x(): Int
  var b = GVBox<GVPoint> { item: GVPoint { x: 11, y: 22 } }
  return b.item.x  # 11
end

def gvs_box_y(): Int
  var b = GVBox<GVPoint> { item: GVPoint { x: 11, y: 22 } }
  return b.item.y  # 22
end

def gvs_box_sum(): Int
  var b = GVBox<GVPoint> { item: GVPoint { x: 100, y: 250 } }
  return b.item.x + b.item.y  # 350
end

# === Two-field generic, @value at index 1 (scalar before) ===

def gvs_pair_int_p_first(): Int
  var q = GVPair<Int, GVPoint> { first: 7, second: GVPoint { x: 3, y: 4 } }
  return q.first  # 7
end

def gvs_pair_int_p_inline(): Int
  var q = GVPair<Int, GVPoint> { first: 7, second: GVPoint { x: 3, y: 4 } }
  return q.second.x + q.second.y  # 7
end

# === Two-field generic, @value at index 0 (scalar after — exercises the
#     byte-offset shift of the trailing scalar past the inline struct) ===

def gvs_pair_p_int_inline(): Int
  var r = GVPair<GVPoint, Int> { first: GVPoint { x: 5, y: 6 }, second: 8 }
  return r.first.x + r.first.y  # 11
end

def gvs_pair_p_int_scalar(): Int
  var r = GVPair<GVPoint, Int> { first: GVPoint { x: 5, y: 6 }, second: 8 }
  return r.second  # 8 — must NOT alias the embedded struct's tail
end

# === Boxed paths unchanged ===

def gvs_box_int(): Int
  var bi = GVBox<Int> { item: 42 }
  return bi.item  # 42
end

def gvs_box_boxed_struct(): Int
  var bs = GVPair<GVHeap, Int> { first: GVHeap { a: 100, b: 200 }, second: 30 }
  return bs.first.a + bs.first.b + bs.second  # 330
end

def gvs_print_box_string(): Void
  var bs = GVBox<String> { item: "hello" }
  puts(bs.item)
end

# === item 39 — @value-marked generic pair, scalar field whose type-arg name
#     is a SUFFIX of the synthesized inline-value spec name. At gate-0 these
#     structs ARE value-layout (explicit @value), so this exercises the §12.9
#     read/construct branch directly.
#
#     Pre-fix: mir_resolve_struct_name suffix-matched the primitive type-arg name
#     against the spec → mir_is_value_layout_type("<prim>")==1 → the scalar field
#     was constructed by a wild word-copy and read back as a FIELD_ADDR → segfault.
#     The primitive guard (mir_is_scalar_field_type) forces the load/store path.
#
#     NOTE: the scalar field type here is Bool ON PURPOSE. mir_resolve_struct_name
#     returns the FIRST registry entry whose name ends with `$<prim>`, so a `$Int`
#     trailing scalar would be SHADOWED by the non-@value GVPair$GVPoint$Int spec
#     instantiated above (registration-order masking) and the bug would NOT fire
#     at gate-0. `GVVPair$GVVPoint$Bool` is the ONLY `$Bool`-ending spec in this
#     file, so it is not shadowed and reliably discriminates fixed vs. broken. ===

@value
struct GVVPoint
  x: Int
  y: Int
end

@value
struct GVVPair<A, B>
  first: A
  second: B
end

def gvs_value_pair_p_bool_scalar(): Int
  var r = GVVPair<GVVPoint, Bool> { first: GVVPoint { x: 5, y: 6 }, second: true }
  return 8 if r.second  # 8 — must LOAD the scalar bool, not return the tail addr
  return 0
end

def gvs_value_pair_p_bool_inline(): Int
  var r = GVVPair<GVVPoint, Bool> { first: GVVPoint { x: 5, y: 6 }, second: true }
  return r.first.x + r.first.y  # 11 — embedded @value field still inline
end

def main(): Int
  describe("generic struct over @value field") do ->
    it("reads inline @value field x") do ->
      assert_eq(gvs_box_x(), 11)
    end

    it("reads inline @value field y") do ->
      assert_eq(gvs_box_y(), 22)
    end

    it("sums both inline @value fields") do ->
      assert_eq(gvs_box_sum(), 350)
    end
  end

  describe("two-field generic with one @value field") do ->
    it("reads the leading scalar field (value at index 1)") do ->
      assert_eq(gvs_pair_int_p_first(), 7)
    end

    it("reads the inline @value field (value at index 1)") do ->
      assert_eq(gvs_pair_int_p_inline(), 7)
    end

    it("reads the inline @value field (value at index 0)") do ->
      assert_eq(gvs_pair_p_int_inline(), 11)
    end

    it("reads the trailing scalar past the inline struct (value at index 0)") do ->
      assert_eq(gvs_pair_p_int_scalar(), 8)
    end
  end

  describe("boxed generic paths unchanged") do ->
    it("Box<Int> still boxes and reads correctly") do ->
      assert_eq(gvs_box_int(), 42)
    end

    it("generic over a boxed struct still works") do ->
      assert_eq(gvs_box_boxed_struct(), 330)
    end

    it("Box<String> still boxes and reads correctly") do ->
      assert_output("hello\n", gvs_print_box_string)
    end
  end

  describe("item 39 — @value generic pair, primitive-suffix scalar field") do ->
    it("loads the trailing scalar (type-arg name suffix-matches the spec)") do ->
      assert_eq(gvs_value_pair_p_bool_scalar(), 8)
    end

    it("still reads the embedded @value field inline") do ->
      assert_eq(gvs_value_pair_p_bool_inline(), 11)
    end
  end

  return qspec_main()
end
