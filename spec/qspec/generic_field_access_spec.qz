## Generic struct field access tests (F.2 Gap #3)
## Verifies that field access on generic struct instances works correctly,
## including inline field access on function call results.
##
## Contract:
##   1. Inline field access on generic call result.
##   2. Multi-field generic struct (Pair<T>).
##   3. Single-field generic struct via let binding.

import * from qspec
import * from qspec/subprocess

def main(): Int
  describe("generic struct field access") do ->
    it("field access on generic struct from let binding") do ->
      assert_run_exits(gfa_let_binding_src(), 42)
    end

    it("inline field access on function call result") do ->
      assert_run_exits(gfa_inline_src(), 42)
    end

    it("nested generic struct field access") do ->
      assert_run_exits(gfa_nested_src(), 99)
    end

    it("multi-field generic struct") do ->
      assert_run_exits(gfa_multi_field_src(), 42)
    end

    it("single-field generic struct via let binding") do ->
      assert_run_exits(gfa_single_field_src(), 42)
    end
  end
  return qspec_main()
end

def gfa_let_binding_src(): String
  return """
struct GBox<T>
  value: T
end
def wrap(x: Int): GBox<Int>
  return GBox<Int> { value: x }
end
def main(): Int
  var b = wrap(42)
  return b.value
end
"""
end

def gfa_inline_src(): String
  return """
struct GBox<T>
  value: T
end
def wrap(x: Int): GBox<Int>
  return GBox<Int> { value: x }
end
def main(): Int
  return wrap(42).value
end
"""
end

def gfa_nested_src(): String
  return """
struct Inner<T>
  data: T
end
struct Outer<T>
  inner: T
end
def make_inner(x: Int): Inner<Int>
  return Inner<Int> { data: x }
end
def main(): Int
  var i = make_inner(99)
  return i.data
end
"""
end

def gfa_multi_field_src(): String
  return """
struct Pair<T>
  first: T
  second: T
end
def make_pair(a: Int, b: Int): Pair<Int>
  return Pair<Int> { first: a, second: b }
end
def main(): Int
  return make_pair(20, 22).first + make_pair(20, 22).second
end
"""
end

def gfa_single_field_src(): String
  return """
struct Box<T>
  val: T
end
def make_box(x: Int): Box<Int>
  return Box<Int> { val: x }
end
def main(): Int
  return make_box(42).val
end
"""
end
